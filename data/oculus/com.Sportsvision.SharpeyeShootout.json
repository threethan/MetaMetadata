0_AQQqLJgPFu0E32-9cAV-t9NEzZZ1i20I6b0zu3Kt0jpqvw&oe=6AFDBB76"}, "display_name": "Sharpeye Shootout", "keywords": [], "long_description": "Sharpeye Shootout combines drone shooting and ring-flight challenges in VR. Its challenges emphasize visual tracking, color matching, aim and timing.\n\nDRONE SHOOTING\nDefend a Martian frontier town with a blue pistol in your left hand and a red pistol in your right. Match your shots to the drones and line up special targets. Play Wave Mode for successive enemy waves or race the clock in Time Trial. Choose lives, flicker settings and enemy types, and replay the shooting tutorial.\n\nHYPER ARROW\nGuide your flight through ring courses in Forest, Neon City and Cave. Each world offers 15 tracks in each of three modes:\n- Score: pass rings and reach the finish.\n- Race: compete against three AI rivals.\n- Arcade: keep flying through looping courses as the speed increases.\n\nThat is 135 world, mode and track combinations. The Arrow tutorial introduces steering, rings, boost and recovery. View your results and stats, and adjust audio and flight comfort options in Settings.", "short_description": "Take on color-matched drone shooting and Hyper Arrow flight challenges in VR. Defend a Martian frontier town with two pistols in Wave Mode and Time Trial, or fly through ring courses in Forest, Neon City, and Cave. Choose Score, Race, or Arcade and explore 15 tracks per world and mode, with tutorials and adjustable gameplay settings."}]}, "developer_name": "Deadeye Gaming Inc.", "developer_privacy_policy_url": "https://sharpeyegame.com/privacypolicy.html", "developer_terms_of_service_url": "https://sharpeyegame.com/terms.html", "publisher_name": "Deadeye Gaming Inc", "support_website_url": null, "website_url": "https://sharpeyegame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29145065775114912"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391991_1405451360470052_2401963515702542778_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e7SQSRvo-IsQ7kNvwEc4Twk&_nc_oc=AdowyQlwHL2D7BBmBoFsOzONXxGTu7yTflqE19z-m97Bol0DfBxGis_saTtflLGfzGo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTF3cg4GrDcIrilKwczZHQKPssu2Ps7owtIMDX9V3TLJQ&oe=6AFDC63E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Sharpeye Shootout", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Action", "id": "459781504968480"}], "release_date": 1707344684, "lastRevision": {"nodes": [{"id": "7130419273672878", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "7130419250339547", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "346393128288957"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "cover square.png", "id": "1800505807118635", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572929_1800505810451968_6242618786759238237_n
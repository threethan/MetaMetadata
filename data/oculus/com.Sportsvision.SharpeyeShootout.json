b=1-7&_nc_sid=6e7a0a&_nc_ohc=ZelFGeEPtM8Q7kNvwGxMrvu&_nc_oc=AdoAjO83465nVmMbHRyuhRHDLv4NVsEJVkFa-E3hCSxSFqHvzabDW2esFezEBQnti4E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPUshvK4B_n4lAjCOHfND5-IB1q2xxskxpi1F_qoer2A&oe=6AFDB0A5"}, "display_name": "Sharpeye Shootout", "keywords": [], "long_description": "Dive into Sharpeye Shootout and experience the thrilling blend of action-packed gameplay and sports vision training. As the hero of a frontier town, you're tasked with defending against a barrage of clever drones. Armed with dual pistols, engage in a battle that tests your reflexes and sharpens your sports vision. With play, your reaction time improves as your vision improves against diverse drone types.\n\nSharpeye Shootout is more than just a game; it's a tool for enhancing your visual acuity and decision-making speed. Whether you're facing the clock in time trial mode or surviving waves of drone attacks, each challenge is a step toward becomin.\n\nThis VR experience is not only captivating but also beneficial, offering a unique way to boost cognitive skills and reaction time. Join the Martian battle in Sharpeye Shootout, where every shot not only counts towards victory but also contributes to your personal development as a gamer and an athlete.", "short_description": "Dive into Sharpeye Shootout, blending heart-pounding action and sports vision training on Mars! Defend your town against drones while reducing your reaction time and improving your sports vision. Dual pistols, wicked drones, and a twist await you in this Martian frontier town. Join the battle, where every shot sharpens your vision and reflexes!"}]}, "developer_name": "Deadeye Gaming Inc.", "developer_privacy_policy_url": "https://sharpeyegame.com/privacypolicy.html", "developer_terms_of_service_url": "https://sharpeyegame.com/terms.html", "publisher_name": "Deadeye Gaming Inc", "support_website_url": null, "website_url": "https://sharpeyegame.com/", "category": null, "comfort_
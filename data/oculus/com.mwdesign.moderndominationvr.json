{"file_name": "screenshot-3-world.png", "id": "1691297952330702", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823757_1691297955664035_8563074049230591534_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=50-Y3_As8_oQ7kNvwGD5C7D&_nc_oc=AdrjKuNPeSkNEyemPAySFSU8mrqSEJmFgYcFYt2o2UKZpLHF1i7E4leV8GQda-5-RLY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVlmuQsiGEkGOwY5zHVWpgvVQrFhdUQ1GnmGDpm32jPuw&oe=6B0F0331"}, {"file_name": "screenshot-4-attack.png", "id": "1707862557593289", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824318_1707862560926622_7386050554047854927_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BwMK8j0ncj0Q7kNvwHg2qm2&_nc_oc=AdrlFn6CkOo-aVo7eCPnikhrmsSMatRhzQRxjBrc7QavmkH9q3wWaKChGxiJ8wpbKyY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW62xir0Zbchym0JpgxndNB6GZ3vTdAJOPfelffDNOwxw&oe=6B0EF634"}, {"file_name": "screenshot-5-lobby.png", "id": "1171214878923869", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821716_1171214885590535_6421262192482978864_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TeytUMAbjBIQ7kNvwHKy9FB&_nc_oc=AdoCiN7AiMMUi07-CuMEVAjw4JCX-4cn-Yi6hzcqG_mV3w-10JTuCmGjRNslGNK2Ncw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW3LAWYmgMN6ZF0CfkfYEgB7Ul3hKDgw9ZoT49a-qWOnA&oe=6B0F064C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-2560x1440.png", "id": "1409201104532959", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823812_1409201111199625_735380134551263271_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7YB7j7-hMMYQ7kNvwEHQexO&_nc_oc=AdrqROUAPtZYxe2Yk1sE-ulv0iMzhouftKsvVoYZjdCTdUnQ_pGrd1tlCUtIFXegnn8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUEGZ9_VkQjOlVPZZZwCPQwq9dymq1e4m6eTsgvYNlwvw&oe=6B0F1D77"}, "display_name": "Modern Domination - Future Warfare", "keywords": ["strategy", "conquest", "war", "risk", "boardgame"], "long_description": "Step into the war room. A 3D map of the world fills the table in front of you, and every territory is yours to take.\n\nModern Domination - Future Warfare is turn-based world conquest built for Meta Quest. Deploy your armies, attack your neighbours and hold whole continents while live battle footage rolls on the war room's video wall.\n\n\u2022 Six theatres: Classic World, Europe, Africa, Asia, the Americas and the British Isles, with mountains, deserts, forests and rivers to lean in and look at.\n\u2022 Tanks, drones and cruise missiles: trade spare armies for heavy hardware and break a stalemate.\n\u2022 Three CPU generals, each set to Easy, Medium or Hard.\n\u2022 Eight ways to start, from the map's own scenario to random deals and a 300-army sandbox.\n\u2022 Multiplayer for up to four headsets, on the same Wi-Fi or online. Pick your colour in the lobby; CPUs fill the empty seats and take over if someone drops out.\n\u2022 Pass and play: four commanders share one headset.\n\u2022 Two war rooms, a concrete command bunker or a near-future operations centre, or bring the table into your own room in mixed reality.\n\u2022 Seated or standing, no locomotion.\n\u2022 No ads.", "short_description": "Command a glowing war table in your own VR war room. Conquer six theatres of war with tanks, drones and cruise missiles against cunning CPU generals, or take on up to three friends on the same Wi-Fi or online."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mikewickens.github.io/modern-domination-vr/#privacy", "developer_terms_of_service_url": null, "publisher_name": "MW Design", "support_website_url": null, "website_url": "https://mikewickens.github.io/modern-domination-vr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210
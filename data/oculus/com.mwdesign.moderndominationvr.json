{"file_name": "screenshot-3-world.png", "id": "1691297952330702", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823757_1691297955664035_8563074049230591534_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nvGE6UoYuwoQ7kNvwGvG7P5&_nc_oc=Adpj_9malt8gQRqXcVNvWQJEhVP3RtQns3nzYh7RLH80nz4AHkq5mv9FkfyJs88aFQg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSkMPkOC3gUN-CIiDA5vIwyj23phhsV4CztVtTyWBxKSQ&oe=6B0C6031"}, {"file_name": "screenshot-4-attack.png", "id": "1707862557593289", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824318_1707862560926622_7386050554047854927_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I_nBvfwE__wQ7kNvwF_rz-_&_nc_oc=Adr5LekEjqN3YTH7kcMBmATBXQ81plqpu8mlD5YbEsnNexWiQo4FnXL-HBSErVxW5U8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSQt647XXzlwx7WasfxvhgrbgOX2qCLM8kpZBZ-b-ragg&oe=6B0C5334"}, {"file_name": "screenshot-5-lobby.png", "id": "1171214878923869", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821716_1171214885590535_6421262192482978864_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wUTByspB7zgQ7kNvwFGrHkb&_nc_oc=Ado_qKnRzWZyAlxacxFNHKBedSLcHxcnKVYlLBuUQH1OBilJO_fjj5Dv9Q50dgC-x_I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTqz0sS4DLTvQyY3kW9K0HXu9UPEQorhZAROTACetYLdw&oe=6B0C634C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-2560x1440.png", "id": "1409201104532959", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823812_1409201111199625_735380134551263271_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jf5SuiXhnH4Q7kNvwFn3aAw&_nc_oc=Adq5Sc-Vp0y4bwoZ1P0gnVimVWPOqe9z8p5FqVY3wQLOHQy-z6MXbitcOT3TcT4ddv8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSmemP_pwCRBCf1zIzI-9A_YMAZVZjlROYD71JSgpw7gA&oe=6B0C7A77"}, "display_name": "Modern Domination - Future Warfare", "keywords": ["strategy", "conquest", "war", "risk", "boardgame"], "long_description": "Step into the war room. A 3D map of the world fills the table in front of you, and every territory is yours to take.\n\nModern Domination - Future Warfare is turn-based world conquest built for Meta Quest. Deploy your armies, attack your neighbours and hold whole continents while live battle footage rolls on the war room's video wall.\n\n\u2022 Six theatres: Classic World, Europe, Africa, Asia, the Americas and the British Isles, with mountains, deserts, forests and rivers to lean in and look at.\n\u2022 Tanks, drones and cruise missiles: trade spare armies for heavy hardware and break a stalemate.\n\u2022 Three CPU generals, each set to Easy, Medium or Hard.\n\u2022 Eight ways to start, from the map's own scenario to random deals and a 300-army sandbox.\n\u2022 Multiplayer for up to four headsets, on the same Wi-Fi or online. Pick your colour in the lobby; CPUs fill the empty seats and take over if someone drops out.\n\u2022 Pass and play: four commanders share one headset.\n\u2022 Two war rooms, a concrete command bunker or a near-future operations centre, or bring the table into your own room in mixed reality.\n\u2022 Seated or standing, no locomotion.\n\u2022 No ads.", "short_description": "Command a glowing war table in your own VR war room. Conquer six theatres of war with tanks, drones and cruise missiles against cunning CPU generals, or take on up to three friends on the same Wi-Fi or online."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mikewickens.github.io/modern-domination-vr/#privacy", "developer_terms_of_service_url": null, "publisher_name": "MW Design", "support_website_url": null, "website_url": "https://mikewickens.github.io/modern-domination-vr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210
_nc_sid=6e7a0a&_nc_ohc=UL9V2KQ_l8kQ7kNvwHzEbVC&_nc_oc=AdohgwXdF7KsDR3V5WeglVkx1BO0oI2Mp5Q1USCw_ZL9dRtiuh09T2joRwbYPHI3zLw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSeKEpB_XxgMElYeqEaxiScnaeWdThGdnVnQvelLRYDWg&oe=6B0C5F12"}, {"file_name": "iss_ep01_screenshot_cs17a010.png", "id": "1146687285760300", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75404379_1146687289093633_3781181271845513600_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xWL6FTWDkakQ7kNvwEYt2O0&_nc_oc=AdrFiuJBRw_rFGs9E_IXynBcxsaF1u9jIWBmQgARO9UjbvAmwfvhWJLWw2xYvCsDTbY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQyVmXtOMaiEKfdarK7F9pP2GLVt-kwrj_liP6kwy7X1g&oe=6B0C5A7E"}, {"file_name": "iss_evs_screenshot_ert002010_2560x1440_v001.png", "id": "509338210507938", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035315_509338213841271_8778727941359250472_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zCGuZDD84E0Q7kNvwGTirZk&_nc_oc=AdqVCe0jfF5sIE5RH7qEKud2FY0Ei0kuZqfcWUfupoYEiOsGuiklc1BJxJ8LU9aF2Ws&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTda80-_Ew5-phIAttv0Y5LSwZoELiEYdi_LC88ky_l_Q&oe=6B0C7B5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "spaceexplorers_spacewalkers_landscape_2560x1440_v006.png", "id": "991099421947530", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031653_991099425280863_2836907019511808209_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ymXDrjBlMSQQ7kNvwFcTt0P&_nc_oc=AdpE6P52oqUVZN-Zq4ikP0xtwGlJfSdp4PRQ4-Tk8jFQhtkdfJHRBZo1SyG9B4b9CYA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQQ0o07NF2jDh-svDvV9os0C4JOQR0FRLWXr3kN-Dw8OQ&oe=6B0C695D"}, "display_name": "Space Explorers Legacy Edition", "keywords": ["Space", "Explorers", "Nasa", "Astronaut", "Felix"], "long_description": "\ud83d\ude80 Dear Space Explorer,\n\nThank you for your patience and support! We know you've been waiting for updates on the Space Explorers app on Meta Quest, and we truly appreciate your understanding.\n\n\ud83c\udf0c Exciting news: A brand-new Space Explorers Mixed Reality app is launching later this spring for Meta Quest 3 and Meta Quest 3S audiences! \n\nLook for our new and updated product page coming soon, where you will be able to download the improved experience. We will no longer be supporting and updating the current (legacy) app, but our improved version will have much more to offer.\n\nGet ready to experience:\n\n\ud83c\udfa5 Upgraded Cinematic VR: Your favorite content is now in stunning 8K resolution, offering unmatched clarity, presence, and realism.\n\n\ud83e\ude90 Mixed Reality Features: Unlock artifacts, such as models of the ISS and Saturn V Spacecraft, and see them come to life in zero-gravity within your own home.\n\n\ud83c\udf15 Exclusive New Content: Discover the latest chapter in the Space Explorers series, Mission to the Moon, chronicling humanity\u2019s ambitious return to the lunar surface through the Artemis missions.\n\n\ud83d\udcc5 Mark your calendar! Our Coming Soon campaign begins during Space Week in early May. Stay tuned for details and add the new app to your wish list to be the first to experience this groundbreaking adventure!\n\nAnd remember, the Space Explorers cinematic VR content is always free on Meta Quest TV.\n\nWe can\u2019t wait for you to experience the new Space Explorers MR app!\n\nWith gratitude,\nThe Felix & Paul Studios Team \ud83c\udf20", "short_description": "\ud83c\udf0c Exciting news: A brand-new Space Explorers Mixed Reality app is launching later this spring for Meta Quest 3 and Meta Quest 3S audiences! \n\nLook for our new and updated product page coming soon, where you will be able to download the improved experience. We will no longer be supporting and updating the current (legacy) app, but our improved version will have much more to offer."}]}, "developer_name": "Felix & Paul Studi
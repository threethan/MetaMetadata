_nc_sid=6e7a0a&_nc_ohc=jKtp8F8wAAwQ7kNvwHukNSK&_nc_oc=AdrSqkkKA5jPlDrD1qKt8qLjkinbQqYC74CKDknuUBYZprM188ZUfCAUj9t5CPF5FW0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXTRzNqQHplQojNJc6nzsdKJYankn2iCnw23Ypd0dd_uA&oe=6B0F0212"}, {"file_name": "iss_ep01_screenshot_cs17a010.png", "id": "1146687285760300", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75404379_1146687289093633_3781181271845513600_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GIsZ3mLzgzwQ7kNvwF6eptE&_nc_oc=Adrm8AHEodXyMRmOvoVIqCIFhPQexeZDgWisfU4X-Jw9L3rTFt8CpRZOQ4Jtjz56V3Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUbp9CEWS4hBFo1t6xXGkkdNe1pQpswzdj3l5Ynh4zmsw&oe=6B0EFD7E"}, {"file_name": "iss_evs_screenshot_ert002010_2560x1440_v001.png", "id": "509338210507938", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035315_509338213841271_8778727941359250472_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zCGuZDD84E0Q7kNvwEc4lQq&_nc_oc=Adoi7u51yC2eumT6pi1jnjQp-CMlac7qj0qJ5KQvCT2F_OuayUADXu86vQduCDhmR3A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXEBesYLx6Lvpf6H7G5pv6YjVsmAermYPrW5CILTV7tXw&oe=6B0F1E5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "spaceexplorers_spacewalkers_landscape_2560x1440_v006.png", "id": "991099421947530", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031653_991099425280863_2836907019511808209_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W3pEO2gIG_0Q7kNvwF4Mv2K&_nc_oc=Adp2zUN7x93etlMm0FeoO-R3VC6SuZN27s7nYE6LFORMnG2BeFYWd3tPb3jTAFsAkaE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXFp_RY5uCDvWNGy4zqglgGZCxAUY7HQzH93ZOdTkRWzg&oe=6B0F0C5D"}, "display_name": "Space Explorers Legacy Edition", "keywords": ["Space", "Explorers", "Nasa", "Astronaut", "Felix"], "long_description": "\ud83d\ude80 Dear Space Explorer,\n\nThank you for your patience and support! We know you've been waiting for updates on the Space Explorers app on Meta Quest, and we truly appreciate your understanding.\n\n\ud83c\udf0c Exciting news: A brand-new Space Explorers Mixed Reality app is launching later this spring for Meta Quest 3 and Meta Quest 3S audiences! \n\nLook for our new and updated product page coming soon, where you will be able to download the improved experience. We will no longer be supporting and updating the current (legacy) app, but our improved version will have much more to offer.\n\nGet ready to experience:\n\n\ud83c\udfa5 Upgraded Cinematic VR: Your favorite content is now in stunning 8K resolution, offering unmatched clarity, presence, and realism.\n\n\ud83e\ude90 Mixed Reality Features: Unlock artifacts, such as models of the ISS and Saturn V Spacecraft, and see them come to life in zero-gravity within your own home.\n\n\ud83c\udf15 Exclusive New Content: Discover the latest chapter in the Space Explorers series, Mission to the Moon, chronicling humanity\u2019s ambitious return to the lunar surface through the Artemis missions.\n\n\ud83d\udcc5 Mark your calendar! Our Coming Soon campaign begins during Space Week in early May. Stay tuned for details and add the new app to your wish list to be the first to experience this groundbreaking adventure!\n\nAnd remember, the Space Explorers cinematic VR content is always free on Meta Quest TV.\n\nWe can\u2019t wait for you to experience the new Space Explorers MR app!\n\nWith gratitude,\nThe Felix & Paul Studios Team \ud83c\udf20", "short_description": "\ud83c\udf0c Exciting news: A brand-new Space Explorers Mixed Reality app is launching later this spring for Meta Quest 3 and Meta Quest 3S audiences! \n\nLook for our new and updated product page coming soon, where you will be able to download the improved experience. We will no longer be supporting and updating the current (legacy) app, but our improved version will have much more to offer."}]}, "developer_name": "Felix & Paul Studi
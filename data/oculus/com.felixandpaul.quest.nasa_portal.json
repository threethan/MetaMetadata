_nc_sid=6e7a0a&_nc_ohc=UL9V2KQ_l8kQ7kNvwEY-R2K&_nc_oc=Ado8Rl-1VV6gZUaIM45HU3uWQld-cOlOxn-2d0AVf58RHW837IsEzba8gBC6_hFCQvE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQZk6Prj4QIEbzwgItZw7qTEF3AoXrnJcqQjiI77gw0Lg&oe=6B0B45D2"}, {"file_name": "iss_ep01_screenshot_cs17a010.png", "id": "1146687285760300", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75404379_1146687289093633_3781181271845513600_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xWL6FTWDkakQ7kNvwH2HnME&_nc_oc=Ado6ojOxb1dyLR9g9Ra9_n5sAWtneZXK8AYI6Y3CTZcqhBFHPLSSpS8nc7r6Sz7iaJs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTDxAtCg3XzRaUfX4IGevAYgOwhaiKp_kWPzJFyzcZyHg&oe=6B0B413E"}, {"file_name": "iss_evs_screenshot_ert002010_2560x1440_v001.png", "id": "509338210507938", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035315_509338213841271_8778727941359250472_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U3eJdodwWKYQ7kNvwFi42ys&_nc_oc=AdpOMtbNV439ZJ-oVNZvGTpK1sbLVOPzDm-G3NBjtNYiomdXcAKw5Li5ZibYzhi9d1U&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ-gWoZe9W39jrCQjNLq7cIMdjHC8L1eiQMdtfOQJ1kUg&oe=6B0B29DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "spaceexplorers_spacewalkers_landscape_2560x1440_v006.png", "id": "991099421947530", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031653_991099425280863_2836907019511808209_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ymXDrjBlMSQQ7kNvwFHJJiX&_nc_oc=AdpFwx3u14q906K5d-D3N0gUz60UVYR7ZQ0qDxpPxtF6HlodKrhEqOpKp6Z7HzbhrYs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQAuCpCLwzMvQWlLY7QpDBaAp_W-v5p_0Iyf7Q1myovOg&oe=6B0B17DD"}, "display_name": "Space Explorers Legacy Edition", "keywords": ["Space", "Explorers", "Nasa", "Astronaut", "Felix"], "long_description": "\ud83d\ude80 Dear Space Explorer,\n\nThank you for your patience and support! We know you've been waiting for updates on the Space Explorers app on Meta Quest, and we truly appreciate your understanding.\n\n\ud83c\udf0c Exciting news: A brand-new Space Explorers Mixed Reality app is launching later this spring for Meta Quest 3 and Meta Quest 3S audiences! \n\nLook for our new and updated product page coming soon, where you will be able to download the improved experience. We will no longer be supporting and updating the current (legacy) app, but our improved version will have much more to offer.\n\nGet ready to experience:\n\n\ud83c\udfa5 Upgraded Cinematic VR: Your favorite content is now in stunning 8K resolution, offering unmatched clarity, presence, and realism.\n\n\ud83e\ude90 Mixed Reality Features: Unlock artifacts, such as models of the ISS and Saturn V Spacecraft, and see them come to life in zero-gravity within your own home.\n\n\ud83c\udf15 Exclusive New Content: Discover the latest chapter in the Space Explorers series, Mission to the Moon, chronicling humanity\u2019s ambitious return to the lunar surface through the Artemis missions.\n\n\ud83d\udcc5 Mark your calendar! Our Coming Soon campaign begins during Space Week in early May. Stay tuned for details and add the new app to your wish list to be the first to experience this groundbreaking adventure!\n\nAnd remember, the Space Explorers cinematic VR content is always free on Meta Quest TV.\n\nWe can\u2019t wait for you to experience the new Space Explorers MR app!\n\nWith gratitude,\nThe Felix & Paul Studios Team \ud83c\udf20", "short_description": "\ud83c\udf0c Exciting news: A brand-new Space Explorers Mixed Reality app is launching later this spring for Meta Quest 3 and Meta Quest 3S audiences! \n\nLook for our new and updated product page coming soon, where you will be able to download the improved experience. We will no longer be supporting and updating the current (legacy) app, but our improved version will have much more to offer."}]}, "developer_name": "Felix & Paul Studi
_nc_sid=6e7a0a&_nc_ohc=bX2SFLkRidMQ7kNvwE_aL52&_nc_oc=Adp4I8vgnyoFYiqbgraD5hEN4fpPcHsWcX3-wlwKye9gfKHjp9O1unUbkO3-6Njw2ZU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfaJx788oarIeoKJeFR9XLx8-zKRV27TfHu2UOhP4Kqg&oe=6B086A92"}, {"file_name": "iss_ep01_screenshot_cs17a010.png", "id": "1146687285760300", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75404379_1146687289093633_3781181271845513600_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kmbGkvKyppAQ7kNvwEMiRaF&_nc_oc=Adq5xFK6iBI8yp2EdV0w1HRh_rnaqFmrlBxOyDRBJQvmhztz6Go0-oA1Jr3jAuB6vhc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxBlcXNv20Cxb0ePo_ZqzyfWU9_kfdij9KcDr-6DeeJQ&oe=6B0865FE"}, {"file_name": "iss_evs_screenshot_ert002010_2560x1440_v001.png", "id": "509338210507938", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/39035315_509338213841271_8778727941359250472_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U3eJdodwWKYQ7kNvwGgBd-W&_nc_oc=AdqI-ZBzhXQIkPPdKRPM6x-mzBn-Hd0jSSCorjQU360N2y_dxGYGn-nY_MdBkYNOzZo&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJM1XVZL0NPQdwPG01titxU36KZOIQSlKIlM_E9mrWIw&oe=6B084E9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "spaceexplorers_spacewalkers_landscape_2560x1440_v006.png", "id": "991099421947530", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031653_991099425280863_2836907019511808209_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ElBO7WnY7JEQ7kNvwG7kCa_&_nc_oc=Adp5-EyBHPNDWpLbfgfHY89WlvZzJkeYkNq_n-gE7ALNj-uis0vTRfBYo12Dx9OMlFc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSiEFKcNRoDdZUzwUzaHryqrnT8wi1Sc0j5KmQPVvK3KQ&oe=6B0874DD"}, "display_name": "Space Explorers Legacy Edition", "keywords": ["Space", "Explorers", "Nasa", "Astronaut", "Felix"], "long_description": "\ud83d\ude80 Dear Space Explorer,\n\nThank you for your patience and support! We know you've been waiting for updates on the Space Explorers app on Meta Quest, and we truly appreciate your understanding.\n\n\ud83c\udf0c Exciting news: A brand-new Space Explorers Mixed Reality app is launching later this spring for Meta Quest 3 and Meta Quest 3S audiences! \n\nLook for our new and updated product page coming soon, where you will be able to download the improved experience. We will no longer be supporting and updating the current (legacy) app, but our improved version will have much more to offer.\n\nGet ready to experience:\n\n\ud83c\udfa5 Upgraded Cinematic VR: Your favorite content is now in stunning 8K resolution, offering unmatched clarity, presence, and realism.\n\n\ud83e\ude90 Mixed Reality Features: Unlock artifacts, such as models of the ISS and Saturn V Spacecraft, and see them come to life in zero-gravity within your own home.\n\n\ud83c\udf15 Exclusive New Content: Discover the latest chapter in the Space Explorers series, Mission to the Moon, chronicling humanity\u2019s ambitious return to the lunar surface through the Artemis missions.\n\n\ud83d\udcc5 Mark your calendar! Our Coming Soon campaign begins during Space Week in early May. Stay tuned for details and add the new app to your wish list to be the first to experience this groundbreaking adventure!\n\nAnd remember, the Space Explorers cinematic VR content is always free on Meta Quest TV.\n\nWe can\u2019t wait for you to experience the new Space Explorers MR app!\n\nWith gratitude,\nThe Felix & Paul Studios Team \ud83c\udf20", "short_description": "\ud83c\udf0c Exciting news: A brand-new Space Explorers Mixed Reality app is launching later this spring for Meta Quest 3 and Meta Quest 3S audiences! \n\nLook for our new and updated product page coming soon, where you will be able to download the improved experience. We will no longer be supporting and updating the current (legacy) app, but our improved version will have much more to offer."}]}, "developer_name": "Felix & Paul Studi
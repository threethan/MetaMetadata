a9QMz&_nc_oc=Adqb14GZFuggFRQhw4Zg5wD4f05gDsGH1YH4rQri2MhYJILkNPpJ2gvTJwa1XwlPmE8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwqe73AVd334QDjR2g0uzAdHfHqafPK7YAVllmrDoZe5w&oe=69C53517"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cNolvt8WprUQ7kNvwGyhbZq&_nc_oc=Adq5njp59qV9VjVXYiXuJXi9gDEMJTOoJqd4Q1OaMLfmpEq3kTFPWPACmXzLtG8Igbg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwbXSOXHkeplELCDWCOwRMuZ0fOZ2y71l-Svt_jxmPZbg&oe=69C5441D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=erSjbl0fUjIQ7kNvwGj9f3C&_nc_oc=AdrqAnldNZ1qsbwmcDAYZmMPLvcDjP8fkkmeBijIzNAV6Wbqw57GYGU9UN9qnYeqVfw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwZ4o5YxzQw9pqKQnjcExQRfQZIEOd1WwLf9mE8TVHBOg&oe=69C520C4"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UykCgPEOMnYQ7kNvwEusZN_&_nc_oc=AdoSSygXoE6FsirMkHvnVPRc4KzupyrkcfrG7YNOO0CWGp6d0ydPrSyvFstk6rdpDnM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwWwdFavsk-g-W4IcaXm5wjyyivETc_jR4wFu4tG4bLsw&oe=69C51D10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JOna-gBOFpwQ7kNvwEpZ03W&_nc_oc=AdpNJY3_04gSe5Y_fv-jnkplbWUR4XVfxxvNU-OQ3c3jOsvm-vaDdALVax53EkEk3hg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyQg6ikE0ebd2DT12wz06XbHVluxxzKhNM9IeP4jqgrXg&oe=69C534BC"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Experience profound emotional transformation through the rhythmic power of trance. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url":
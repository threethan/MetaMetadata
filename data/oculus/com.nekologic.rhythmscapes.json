Ehdi_&_nc_oc=AdpgY6D_ZjgG5ZPUXjqWonkC8yzYHr9hC06jZTJ34ToPM7iM8LKCjEqv3qzoWJKmVlw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA7lKSLYX6FpHFDZlvlDEsqSC-8c9aHm4mpr-ZlUBcvvg&oe=6A4BAE17"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mk6svwTFCRAQ7kNvwHbUHum&_nc_oc=AdoellKyMNBP_dLMwuPVVWiineAfrSKX8TmbtPApWgFpAfmJNzXI6vUYOwVITZyHsm0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCfW32YVoIQt6OjY27oN7fB5tRe7cHAa-X98Nv7CGjbVg&oe=6A4BBD1D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LdXMzhXBLmUQ7kNvwHaaTHK&_nc_oc=AdrloNMtZkeD5ig5-Mm38NsL9iWZST2qQSPvKblOr5OGQyLrGr4EMJI8Xwq_VzvrFb0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDUo1lhkcae8zLpl6Fa07_Ve3JWXlneaxWolkq0hmKZ9w&oe=6A4B99C4"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HDLbiC3reOcQ7kNvwHzJOhB&_nc_oc=Adpsg1l0q0bjZRBO4jzpOMxKPxluHedDuhCmLinPb-2eLjWCxxiOH_BpLfd2h6Z4tPI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDqWoFmEOJi4aj5H7lYcKx88cDnP8-5ziVpsktLnHeC5Q&oe=6A4BCE50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WSdOsY51eZAQ7kNvwHatuAT&_nc_oc=AdoBUs1FXldM0m3B0AWqKcY9txRFtmJnrKgip4NVA1uhut6-3g5OQtwTbI01EV8EK98&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA5PBMOa--6QB9Dqx_T7fFBNz08C7xLGA2ydwY0pJJxtw&oe=6A4BADBC"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Experience profound emotional transformation through the rhythmic power of trance. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url":
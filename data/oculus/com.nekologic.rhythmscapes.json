stZCP&_nc_oc=AdqwohuFZc1I0qhhFpMK6TXtlI1KOD7NGwTt_xt7FMgHAF3ar8Gy38K-sTN_fbnNTzo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9g4lWqiT7XatWhanD7WwycYHIvJlKvXHqGeLae8YG1LQ&oe=6A354497"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZBddD1IhyjsQ7kNvwGrb2WM&_nc_oc=AdrepGN5W55VTZD5WtrC6U33lARcLPycgidMggFJWugXFmDXeJxCtIpari-OELXIWpM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Due4EokjD-8v_oEOBkU_DP5Yj84-HdWkK--fpPpBQ-g&oe=6A35539D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=719kdRqyfYAQ7kNvwEARvw-&_nc_oc=Adr4QFsU1cBE8XW4U-AZuFs6cFNR3WaccBkK8cVQSs_TfbZ925OhOHTUmQuQd5uhrtY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9JXNAGfC0xk-OJWOYwFFIbAYbEvKitWjUfFkx7gakgDg&oe=6A356884"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3U-ArF9HaQAQ7kNvwFl9-AQ&_nc_oc=AdokqWfcf9UYpA9UrHKGvPUpVHd3GdJG8ctjGeKfcWmXIXVOIlPFHsdZl8xEQFOaaPw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_cDHFkyoa_V6GZF_i-WEZ_AmiYCHCys5-onA9faMsjug&oe=6A3564D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vCwH9wTsc5QQ7kNvwGFiTQb&_nc_oc=Adp_Cet2cOiuJkcZPA52H0OVBWq4Ab8XxidVORqWpsxhCKNv6DuVzezhQpZmh5-2Gws&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9f5YTDdB2OtCqxReDBegRSJIIgZ2B4VutzYqB47SJ1jw&oe=6A35443C"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Experience profound emotional transformation through the rhythmic power of trance. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url":
kicLJ&_nc_oc=AdphJSFCpWU2X7sLWc-FEp_7oHK_mTP1ezzFxEjcboxMTMO3P-fr-O8r8XZ_V03iZHo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIflc35vEAIOOB5sckU3GtDsbV7U_uiXQ796zrw-UhQ8Q&oe=6ABD0F17"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-b_10HaGXOYQ7kNvwHOacMa&_nc_oc=Adq-_i42FWRi9-vIR6LMMwwJOdWMKp8HMcFlLnfiJadEdui3neld_6ytEX-ZEHku-9c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWVPEH5WuGbbzEueJRZ5PsVvMU9dWYFRc6FHA5srKBEg&oe=6ABD1E1D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AHLqsaVv6sUQ7kNvwHUfjAE&_nc_oc=AdrfK0csm8tkWtsCT5czkJnOsPBvqfwvpKZp5X_19AyFcA6iBzET-xKNx-zmQ01yS40&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYPUqTRmNpMJ31Fv_QIVApw4Eb4qcwhtQJ7XG-kd8O9Q&oe=6ABD3304"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G3wIY_uumlYQ7kNvwFefLgn&_nc_oc=AdrS84TM2IL_5Vmw_pLJjLkO7GtaVBKnoh39JzFakbvzMgyA5-Y0BA1e3YbXNbNbXjA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUrVmqrBN5dPE82DXiAScSMB6H4hdRlFaQawVxMKad8Q&oe=6ABD2F50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7rpwIxEI7cEQ7kNvwHzdDOB&_nc_oc=Adpq4JyuXlxdvTeUCjovIh1TNE0S3FZGCWVc5x3FB5l9pmCOIL1G7wQtsmSn2Zb-B1k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIn6U0zne_19AhWwN_YCcSwMEvz04-mhr7XF-C9yysOYw&oe=6ABD0EBC"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Experience profound emotional transformation through the rhythmic power of trance. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url":
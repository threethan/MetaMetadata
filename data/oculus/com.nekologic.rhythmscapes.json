DaSHa&_nc_oc=AdrYetuznHN0OJLi_4dI7qknb10vJ3LmdRnP-ttEfDGjSqUT0HHAkpak6xDLbsexSJA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMuPiIv9AkQ7KcXU7JWIYhV_7Z5N896_HtTc-lBfSMD7g&oe=6AC4F817"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k7mNNKbNNIUQ7kNvwEIx6wi&_nc_oc=AdqDGKT4zC5KCMgwCoPp91VJbMeNEBkT9PEAeVSV0jt9eG7cDnVIONVdNQGD7qMRPps&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOeHHAfzD4so7IJHZllomcyuKFPoCW0CQF7b7-rfbEn4g&oe=6AC5071D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MU_aA_XrGd4Q7kNvwGCcWA9&_nc_oc=Adq5dKTUORYnbYGg-z_AL9zOvsR2DzAXOjM9X2skDhYaoSpHxSnl1Kd9qiV5u_efwF8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOzFgvKu9xPAsIYJAsWNAiazoDWK-diioO_SDr1PMZ2bQ&oe=6AC51C04"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K18yHUzBR6cQ7kNvwHyr9eo&_nc_oc=AdpykV2vVGTjCTsA9Lm80Iq4-wojLSNPH8OdB1KRkC_3PckcAVSosGEtsfSatXKWrWs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPhB18zfC90OIU20QFApYNVIhf4nIbJriPf_ZjHml6F8Q&oe=6AC51850"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uqZ4DdYCZXIQ7kNvwGEHm87&_nc_oc=Adrq26WsnydglnSM7LOcE71JK0CXadBbOE8KJPMbwOjtX4elzMg6wdFbf5LH5OvtOnA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMHprMSOD8KeDnxo69BimFWgsxmgKAlnMRXu_T2vLwJfQ&oe=6AC4F7BC"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Experience profound emotional transformation through the rhythmic power of trance. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url":
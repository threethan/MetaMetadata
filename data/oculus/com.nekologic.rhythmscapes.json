oFNuptpR3MPj3erS6qSZkG3sP0UOApTNzSQdWYkoD4920yCRONmdBuY8WifUHmg&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4EkOPwv09pgSAbaofK-bqQfont57YQEneHo8mGDUnWA&oe=6A918D97"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eeePMi1Z6WAQ7kNvwFZGxOJ&_nc_oc=AdrZ1t2X1tCHzIcjeBVQ7ZFFIdKf7jH15wcnQXZBSNi072b1uTQD62nTPYX-ZWWjMoI&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFivWIrJLZXQkGOEgQe452MYZSNDRLC7zSF2ZlTNReAFQ&oe=6A91645D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gK5anh8jk5YQ7kNvwFbshq8&_nc_oc=Adqrl0Lw0UoxMav46rWg22MjgxM_wgSG0JuLwcKHRYtT1v7zVyP3Gb7svBTUIQDZb2Y&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHmj295LZJ7yEBBsKe99SK-m0dHmA1mTkURQOEyJGSyng&oe=6A917944"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uoXe8f7Q1sAQ7kNvwG8LxKT&_nc_oc=Adp3QcFjOhu5p5881XDJxhVgAdEK4rvZ0vgmSTIsftTkVxevq5pQUOckwPrDDD58hV4&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEkGCqr9yzwCc3gUzbZDbxZeUBwdNmhmfgatpNvrMxD9w&oe=6A917590"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gm7eBhr03vMQ7kNvwEdhgxE&_nc_oc=AdoydTyLQI5SfP72J9_UnCypajeiNfaDPrar_rXxtiEDwTFSPm4v1uh19IIXTqhTzyw&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGWNInQ3ukdW9tH7rPzCl6d2xGWBtNeWg-IHDytjSXUnA&oe=6A918D3C"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Get into your rhythmic zone with Rhythmscapes. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url": null, "website_url": "https://rhythmscapesvr.com/", 
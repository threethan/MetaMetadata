vwGYiXrY&_nc_oc=AdqGJyOkgFRxlehnlv1InmvAegTykovEGO8wjG8jsbEiT0E27nWaEANfvyU2ahLoja8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Ti7a54h3Q2I3TTvYmZbXQYe_ziXjFDPQQdCBA4F_3wA&oe=6A22CF97"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QmEfv3Jpdn0Q7kNvwFwsZZd&_nc_oc=Ado1Kfk5OJamDrk4J2U5axzV_tK1OXcUf9mg43LpP1_Lbc4pXMzY7jnkT0ocExRjoJE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af824a_LFNaYavMz-wu20dtPrlSuPLOOBF_SGTV3h8N4KQ&oe=6A22DE9D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HX2JjmckGGMQ7kNvwHZTr3Q&_nc_oc=AdoUU4Meru1V4-X48ETD3wIsFVLjJ5VaCxdkyRyD0x244YSYW2tWfnmFBQJ_-50RKns&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-bILVu--KEDL0H8JnuXuW0UvvqPRV5L1d7CsalWISRCQ&oe=6A22F384"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aQUyeIWJIe8Q7kNvwGbvcq-&_nc_oc=AdpjsRa3mds4Fyt_KtKSwBW1gSag2d2MWmhh14MqJqtViqWeUWVY7cybOcPgkxWDHoU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-EHKfRk1Bk5qedzYwmP1_DN_Kx9B1lLnx5YZIglpcn2w&oe=6A22EFD0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_YSbyEFgFGMQ7kNvwHLSWli&_nc_oc=Adp0VFJOVl1kIpkrGnM2ZoGOFb3E_wdN1pubMxiCtVfNJJjC3WTWgYwUcbV12Tn7Kqc&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-lloHHqgJ_xA8507vt8G5thm97PfWG3nOqO5Du03fs7Q&oe=6A22CF3C"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Get into your rhythmic zone with Rhythmscapes. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url": null, "website_url": "https:
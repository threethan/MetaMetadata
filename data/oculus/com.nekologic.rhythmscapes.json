bSWZo&_nc_oc=AdrLZsG-Zxd3nuvVMh9XnT3m7kLW42B29p9IHuciGzIyXPxbVNdyEVMrb6LlBdw_yIM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMVEbIFZB5Dpez7scQBMdpk20nzKagLkbwVWfRAhhH5SQ&oe=6ACA7657"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1yyUvAtiUUMQ7kNvwF8b5Fk&_nc_oc=Adr-a_VJm6qHVJOY7pFU_owTWPv60jcFnMj0Es7FLZQG9rsYENMBMAXElbKeW33u6UQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN-nzrfCTb22zhPFlhDmB5F9k1pxibZPj9lcM4GctyqiA&oe=6ACA4D1D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GzYeU9TbTN4Q7kNvwFcEUfP&_nc_oc=AdoRzC7G1iGdz0f2X31IgAOcI-Byr9DlKrblQU_CRFgfv9yTJ004hqFufpnbrmI8V2A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNN9K-8wPqTe3jzw7BAaHol0ey8NGpKIFs7PDSHaMukMg&oe=6ACA6204"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hGgz0m_bj20Q7kNvwGtyJRV&_nc_oc=Adp1WlTszE_B986fydg8oa6hcYS-MThbKPqt2ghM8oawa35TEUKaLvSNkgQzNYlCs8Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOVo1ccvxqI4YW1fWve1SgOOMniOl4HDpu77GbenKHQgg&oe=6ACA5E50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q5C3ZcVvt9QQ7kNvwHW20xn&_nc_oc=AdrVyUHJbhaEK4O5ePA2V10p2_dI1aeI3MujnvuafV326bkffCDS7erVtiFFVcIosEU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPFQORqtAsg4a83dUPQ2IClJ_HdYc_0bskaRs6lb5myIQ&oe=6ACA75FC"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Experience profound emotional transformation through the rhythmic power of trance. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url":
gfCRyK59mb9uFFL9a1N3OEXcE7pzK62TN95yOeieVpqk2zaQgcuwM_GtHm9W3Mo&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1v0-g_Lc8xDsfm7qfksKZSn2vJFPWaYLmC3sfBoLU4Uw&oe=69E23617"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5WVvziC0ozgQ7kNvwE9C8C0&_nc_oc=AdpISCgRRcaBFRfSDAGwVCxFP_MDG3GTh6MSJKvcpEz14twEbd9uLRt6807lcQEz_S4&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0k07aO_fpThf5GomehTk_lKJGODzJcjpEU3ZadTUrTWg&oe=69E2451D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ANFIXtIoIC0Q7kNvwFPHWa3&_nc_oc=AdqueO4suJUfl8Sa8nVKR4oZbpHvdSbDO63dUSNmY3OMZ7SNWYGTwHbKLJRR0_A8yKE&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af33LjAzIiVQAzjTasxT6XBXPYi5-NhHdGnqoUucdMTezg&oe=69E221C4"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jk4qeQTpAHkQ7kNvwFK5mry&_nc_oc=AdqvEJfTtG2G7ffpUa6URTg59xcoCODne8orANS0Zvocmduag4Fp5ZkErIHyl_-gB_s&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0GF40N8r7GFtwO3u6p5oKhPleFedHMOeC0wUCW1QjUTg&oe=69E21E10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L00Suzhh6qMQ7kNvwGnswZo&_nc_oc=AdqJ1DVrK_Q_XEN7Ia68Xjlj-3ZdOgte1sn3fWBzt-5HFK_6fCP0tv1H3MKS3vRjgJY&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af13JBtStX-j8HFX_3pv0kDVCfigqp1MqITLL32pnKZ8uQ&oe=69E235BC"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Get into your rhythmic zone with Rhythmscapes. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url": null, "website_url": "https://rhythmscapesvr.com/", 
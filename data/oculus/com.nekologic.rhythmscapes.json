jooFc&_nc_oc=AdqF6JEsIz30DuyFaVsU8lyvlpAND5VNi3R0nhr2fwfhuC_vlD-fnBz1_U34DMNwOxM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-XdXLm-uyKkrTEEulRgT0r_IkrsIHbsTxOqa3RIrDBWw&oe=6A33F317"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZBddD1IhyjsQ7kNvwHjDJ8S&_nc_oc=AdrBvf2OoS-NEEkywrnjY-YMRUoEJWS_Krfub-Ck4zIMaY7UTD9u0_-MqyUr1Vcu3Os&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_LIEq1AuMO7d8iEoegxwp9Q_5D8Z-kvN-wqMaPziKX8A&oe=6A34021D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ehHd6WtalhIQ7kNvwFXbzh0&_nc_oc=AdrTy2X8pDgTdpTa_oS5zEbok5u7pYWRNlXlKk9hqtbUyoZWz_YO2O4aoYQ27krRNNY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9B_CtquCOOsfN3K5_46i-qhXR6Z18q-Xsmiq88yJ1tkg&oe=6A341704"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3U-ArF9HaQAQ7kNvwHGTL-z&_nc_oc=Adok54TgDINS62b4BY-dIW_GnVXvSC-hD8s8dGXzb5xllCFFB28GeRlVyb9fCozi-7I&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gZWfau3mx_iY0ggiLjeG_X9kZI-qy-wSgvD4Wm5-nng&oe=6A341350"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vCwH9wTsc5QQ7kNvwGBIRNw&_nc_oc=AdqI4lfgzlCN5tc1tj0wVicHllci76qd6zFEGUJ1nce3zTPlCbIMB8iJbd0fzeN6SoI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Smr8gka9b-bVqbB-4kjmK-0sCWr_w-O1J2gW6PBwiHw&oe=6A33F2BC"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Experience profound emotional transformation through the rhythmic power of trance. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url":
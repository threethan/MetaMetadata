LUyWR&_nc_oc=Adrr45eJ5vSXtzcaSkFbNT3gGTqHKs4wSWfdG4hytl4R3MLfpeci_DPidmTY6ua-6jc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70_WaIlZeHW1tnpTWgl4WmsfY9a32YmZ4jczmmi_QxGQ&oe=6A12FD97"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=so9rz01aV-IQ7kNvwHfPL9I&_nc_oc=AdpKxM6ZiSpKaCJj4vDa_mOC6v1eihzMo-v6Kpkh8p7L273NxKVmq_TTTslLRrBRRVY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af73oX_x2QKB_4n27MZqq9jlKcN85m-bOdkP8DFv1cIqoQ&oe=6A130C9D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yKhXbS3PDyYQ7kNvwEGWQoz&_nc_oc=AdriQVGb5yf4r3hR32Ijn8jW6eBLrId0bRqe2JgV2heYT3hZF_VHBVcme7ViwQbfJgc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68i7bSja8-GZFGKAJMXvejpr6nmvaZF8brmrfL6WfN4g&oe=6A132184"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Zu9etGTfUcQ7kNvwELx1Sz&_nc_oc=AdqaYyK892czPW-LK_8EMBahFsx1p9_RmZLFBCEbwTd09dZgr3RGOT3SNJXH4wvGBIY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6nwBpRFkrt60NvifKZ9IWEXCKOab_OK3RgRBsf3bfqzw&oe=6A131DD0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=48ZY2BByTmMQ7kNvwGTxZhX&_nc_oc=AdpdSdPXfde2Ygd9YgdN-JQBOwyq5IELfUM4kSv3xbKtKGHQKShH8mvjdRPZpyjNnX0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Rf-B9UUwjMzQqqmbbxU4xWuRXWYEmc6D2pWGEAmoiTQ&oe=6A12FD3C"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Experience profound emotional transformation through the rhythmic power of trance. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url":
Mijcq&_nc_oc=Adof4AwoxWHX4NiHaso1ENm_qokDH6L0rcTgMRp2-r9p6rTeD8ViNSvMKvkn4LpjTx0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ85GHIQDHkHp9cp0nOEaVhO_3huy2DMLvpb2oi28HCxw&oe=6AF9EC57"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=52444hVlpI0Q7kNvwGY5bLV&_nc_oc=AdomxF7TNg8r5xfZrk-up8WoHoK4P1F8bmjQI9yhhN2BDaS23ieGki5z9afJRQMRQXw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWfpBzhplJZo_flZpeC0QNir1MZdEcX2OAA2UmKJ-Bjg&oe=6AF9C31D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XG80ywkkMHoQ7kNvwEPNeHE&_nc_oc=AdqTMzRYth7lHgBWUL37mPlkUMlz0HsJ1xSZxcrAXUYzBwkU6RfK8wZJbZlU97FN7QY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmXjbCSwPYA5diUbdFWTy85RVUf-6-hAqnrcsfyb0xNQ&oe=6AF9D804"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wciIHVK5LJAQ7kNvwH6Q5ZF&_nc_oc=AdpNcT3BeoyUUa4oZE4FBqOsTRyg-ooplab9H9nSB9qGo3pQ-Wjf7bR8Mp54fyW-wh0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtF40bYDMIZr8PVoQ1COQP4J8RGxvUhpOayFgP1BYMWw&oe=6AF9D450"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w8HQG5cEEAwQ7kNvwE8arfo&_nc_oc=AdqdL8NOiPyohKaphjrQkH2ALt0uHoJ94Xca1ssw47-eRP2vfOhbSVNCFbG-DCpxJCI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKCcG4-6udSXR1GhnNKDZv-RQCCdVNB8pV-9LPzT6XJg&oe=6AF9EBFC"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Experience profound emotional transformation through the rhythmic power of trance. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url":
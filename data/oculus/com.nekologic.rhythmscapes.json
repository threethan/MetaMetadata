lFNL4&_nc_oc=AdpUMLOIm-ZcYZgfabGA-xal7o0cXntuEVPFLjJl54VTpgKVvCmFAjvEDrhuEcqme4k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIATRcnLxuNqydMzotSN0qUx6zbizcEewkW6D3BaYXJVA&oe=6A9D6B17"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_mRvSDeTJtMQ7kNvwEzkljq&_nc_oc=Adq3mP3zGUD9XZwTv8iAyhogahGh0r5P45jauF42G5ZvRnllaw70Ek8kq1C9_XyM0Sw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKyt_G_7MbY_IvY4lURvA60UCIj4L98sXRBtHkLih5Pvg&oe=6A9D7A1D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V9QlXruMl0MQ7kNvwHoUsgo&_nc_oc=AdrTk90TKEf58ZskV_B5fWef0Et_v9a2zsR9RXYIewTNqV_wyBZxcw_ObLVgHBaP6i8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6Es7Xp-snPZwpueVMFZjUsZp9L_2loSbA_SDbi7wUjQ&oe=6A9D56C4"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zi0Ji-dKNvQQ7kNvwF1VCle&_nc_oc=AdqKFKtG5hH73FuTOCxYOfW3Lkp2uAuY1GfkCiPQL4r3YJQkWKNmzIrwM1LsccQpMf8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmeqJ1A0Io2CBhnwaAPfTxCF3A8EWWA29RSnaqv4oCbQ&oe=6A9D8B50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E84LKTZRC9gQ7kNvwE6bCW5&_nc_oc=Adrpa6YGeKbkiHgM9iSfh-b1H7x5bJgb81-Oouh16_vBTD_jPAcfcd4h6WiSHcCWZrc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDbe3TI7yBp6VAIpHygZEabwij-KRBoYxaWXgOYB4U6Q&oe=6A9D6ABC"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Experience profound emotional transformation through the rhythmic power of trance. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url":
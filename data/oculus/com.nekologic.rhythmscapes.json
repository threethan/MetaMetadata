oaYYg7F9VEbTiryurRr1N_9nrmSjCl0T--drO2UABLjsDd5FavOn7I3c1EtPSVw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOasv0-C_ZEYg5UB-HPyS1MKjgnbKvbFDw5sjmVmAGAQ&oe=6AF20357"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0jVUmD35_QMQ7kNvwE6Z1f_&_nc_oc=Adq38lGKcHwJYUaXdjHH5pJ82R6KHVaHbv5MU5r2kGO-ybIrGZXTctWdxw3TTFpl3M4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQY4wCMJyKpmr5KBgSiBlyCIkyI-jQtAqUHSq-BTtg9Vw&oe=6AF1DA1D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5PMd7tVv414Q7kNvwFJV0a0&_nc_oc=Adpd29hlEsm_2YqcB-qj6f-f7rHImQRF9pTfPubJT3s64Ii1IwazNw73ieIp0b2fPWs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThsUSOdfmoS_puhv1Wr8qZ7Fu6U7F9twK5wRTu8APwTw&oe=6AF1EF04"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nbkIhKqa7GgQ7kNvwGEJX_p&_nc_oc=AdpLSnTlpblt4q-naqno-tP6LA_whg9-8Ja_2Q9TgeVqw8RzTZvZJzJhce9vysDE2qc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPsGCgB-ejNI6IMVCnNCY_yLDCp3nO9o06rm-JnxfJeQ&oe=6AF1EB50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KNcWGFV1VBAQ7kNvwEGRrFr&_nc_oc=AdpIB9GIn3IC-yox1EgoqSHQenadFCpEhXoStpl1lItwRmWJcwb8p5WvTfKo_krKOXU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSm_r53ASfd_SQAGGiQF3fwKqXDgiLgbZTm-vKf4hilAQ&oe=6AF202FC"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Get into your rhythmic zone with Rhythmscapes. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url": null, "website_url": "https://rhythmscapesvr.com/", 
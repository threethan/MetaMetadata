jul_SFXISUrTeyiDZMRVELMEkatGoGTQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfywISR0wejYnWiX7L5csWoYes-P-L98teHyRJx3IppglA&oe=69BE9D97"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ps-i1Rtmwy8Q7kNvwG_FqQ2&_nc_oc=Adn9tKZEZ_rUbP1h1dZ2dhjiFLF4NvmchJ0bRichrkq4J3gmkp3YOFXJFpp3HRBuoPQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz-m0DAnaCu4iCNG3Kp30P-HFeqbogEfRl6vMELUsEVkQ&oe=69BE745D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iU51MhPMUCAQ7kNvwGNzT1t&_nc_oc=AdnlTRFqI8SCHHuqUaUKylf20UMqubFwntM8cMl03LUzqx4BVTn1tpBZpYDBV3yVZ9E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afzz1RxW9aYyq4gzgrrN79_w98h29KWZNH-j5qWGQm9cVQ&oe=69BE8944"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eIJ0APBKHBYQ7kNvwHRfSZ0&_nc_oc=AdnypXfFIpST_wxtLpHtsO1oLB7gn8cyQGRCgNXKiVqpmDTm_v5kIlZ6r1xWw3bDEmg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwZP3LGBgJBi7tyECtC-n5NpZ5EFEMAOZTKrd8ztLlaQw&oe=69BE8590"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8GcfUyMqoq4Q7kNvwEccSX3&_nc_oc=AdmvbZw6Pk_k1LGQ7J7UGeZL440RMo40jcK4cDltmyCcetqm5e7WZZfe3Pw4nxIoIjo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afwxn2g-FVFyeVTTVA_R2oqGCuNnv9vQnk7vhJmE_Texkw&oe=69BE9D3C"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Experience profound emotional transformation through the rhythmic power of trance. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url": null, "website_url": "https://rhythmscapesvr.com/", "category": nul
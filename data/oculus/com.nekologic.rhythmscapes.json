QgqIV&_nc_oc=AdplG1SU8pnTeBYUZuMmFb8znIHB7hDFzBnYRHv5ZnJvr9mVyt5PgxVojBkPw8Tq_JE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5dLZIB7OhSru5ZkG0Sv1lzNuXz2jTBu9eSyMjqeeHroQ&oe=6A09C317"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V6es0hnNDyoQ7kNvwEaS59t&_nc_oc=AdqFV3nuq_tngULOx6apGDurbSWPyugALmsfOmonZthYcqKA_B3H_qIgJRMtGxwnxDg&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7zFrmdEWPonaukc9Wcn2ukXX_lQ8D-of2cdwPlLbuJkQ&oe=6A09D21D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oF_lKHvKsPgQ7kNvwGur37b&_nc_oc=AdrLdfixosFrsEMj9MebsnQM8cCbbiNDWoRFko03oPBBndtP6xw-gQDKGTnXDZgGjJ0&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70LKAXtwacOE8jzgf8BPSPF2Uu4vQ0svq8gg2mZT8dHQ&oe=6A09AEC4"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OxSID1UVHE0Q7kNvwGbyqcb&_nc_oc=Adoza77rNndywjl7crZf76n36JpEknBKMdowj_NdGJj5PLGO0FFv8fVDha6LrRykt6k&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Op0EWTTk-Lp0gNU2gUkT66JT2cPCJTtKcYPZL-VPU4w&oe=6A09E350"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vr70tNn1zA0Q7kNvwEYF-y5&_nc_oc=AdojJ6IZ-Kw24NTUWAEc82Ukl4db5C1iVdphTMj0ayZYBwwnioYSodXpvmVWrp6meJ0&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7PHbUsK_c7pkj_-YP35xbIZlHXjVmz9ZGeIjPsofleVQ&oe=6A09C2BC"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Experience profound emotional transformation through the rhythmic power of trance. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url":
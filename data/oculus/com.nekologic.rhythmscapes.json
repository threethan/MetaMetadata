tCrd4&_nc_oc=Adp6Nn-V23bkXgV8os_qPD26GufqQRx3bkxQ2DfynAz4aHIwmYB4H8rUXXtEGoJIXos&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3yFpdH2GfUwrZPXBzGJfjv7CzKYs8NS0F8QsUu-_fMXA&oe=69F35997"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l871kaMXMcsQ7kNvwHGbnYO&_nc_oc=AdpyE1HVlcLW6aJPpGOyGtcMGwGFWH_BJ3peZAffdf5wSu0a-JZ_eB0RxIfLHKA7kZc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0U_GgsTRfxpl474Kv8wnDmTBVThvD4J4L9RogfDZal6w&oe=69F3689D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=daWTDDviDCAQ7kNvwGT3vO9&_nc_oc=AdohrE45DxNy2SEz22ZIBDpml96Ww-67yYMIwWgTi5b3IfGQBwlT2qWeIxt9NdNYhdM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3FDrRU5kaTwp_CkpXXf_5AsTfXBbCvMdc7Pvu3PWlNOw&oe=69F34544"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kyu_mxNeO44Q7kNvwEE2sM4&_nc_oc=AdrdJiX6v41IgDuS54sAIWqy6A0uzse2h-gnYvJ0rVPHIdTkhEz32hA1Kjnk2UOR8AY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0pauWjJUJQdi0_kPZrDFlPS0YDbQsMzvsXAXEUCniPYg&oe=69F34190"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MnpRJa5jd6EQ7kNvwGrwGRE&_nc_oc=AdrPXPKXPz1WLgtEx085WMJDG2-fiimW-Vjp6vuafPaRsjs5ccACCNWH_jVyUQmVCBE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af17GJaczCW58qyrTDW_Z15hesZ3UHWVd9J0MS9cQbrWfg&oe=69F3593C"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Experience profound emotional transformation through the rhythmic power of trance. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url":
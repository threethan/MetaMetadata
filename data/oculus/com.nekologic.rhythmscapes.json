YlJ4J&_nc_oc=Adqoxt8frL9ROvBeHO2zGADU8ROknYPtLgxtSLtZNGh5siZa6o6-yweHD81srBP-iHA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7WL_jXVlPPFgdZk9nsLtOPNB8B1IZRHe4a54yWDFcsXg&oe=6A184397"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-jjwTtsossQQ7kNvwEOeOv-&_nc_oc=AdpqJxgjJR3UsGrGSrQ-5Qnrl330VVn06XPKo4TUcyAcDD9gJiDkmhVppS1upW7fkk0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7cnd3_zGKEn0HfnJasZkoVBCMeaFYdolxKKcsXbkRpDA&oe=6A18529D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Vit8Y56EHgQ7kNvwExq5vA&_nc_oc=AdoTBNoE2AtZVuozOPMIc_C8C8vbaUDhNjuU6W_Vdj9uC6p266S3N2C-ZdgMXytxqq8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4xyNK6_yAr9yqW9ZXJsnAsan9ZFZjSiR-LriFyyd7jcQ&oe=6A186784"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AMnYk2ETiQwQ7kNvwHzd92w&_nc_oc=AdrZBVaSteWimmUVZTaKZeiNSGkWrzMiI-2lWNlDdPgAoZEyZje_wXgeb2sEGd-RtiE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4EXER-rpYp1o1-vQNlN72B-FTK9P1bkupG-FMqDDYCyQ&oe=6A1863D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1UPnIN2ZNJkQ7kNvwHQO_n7&_nc_oc=Ado3G5K-2xf7wha5soArTorcpvgduEoW3kwdyNsjutrtMDhAPBiCwsswEUMzdlQULsw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Be_MmDTnhtFuWx_W0YbBj2cScBQ-QV03IQb__jzCXyg&oe=6A18433C"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Experience profound emotional transformation through the rhythmic power of trance. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url":
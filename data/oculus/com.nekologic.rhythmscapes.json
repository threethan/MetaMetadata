YmE3G&_nc_oc=Ado7zuCeo3xH9igA9HgzWQaa2M07wNw-jK4nlZ4mJSJoKpxC3Iob9bzVJpyiUbqbnl4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af31WvYBk3f4f3yVYTHGHMm78X-M8UeRmosSS62lX08l8g&oe=69D50717"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SDvCogg83boQ7kNvwFI7Cfl&_nc_oc=AdoVol0BMYDfYPlmprfSP6WSR-f2kYqSgRyB3JB2OKeOzFQczTovml9Q5fkPCF0-s8I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0qghHlzQzIoB5qshI3LjHCbQcRB3pHXUAT5MZAD1Y5OA&oe=69D5161D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gOoQ-G5saEwQ7kNvwEKzkKc&_nc_oc=AdpmCbhTrmAnFTJY-2ghBclRj3NtVDcIdEHLwuJ_8JRdS7vF4jinYdMxhWklDRPzxvY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3emiD_ga2o20vNJd5SXlzYsuHXw0demmtnvTDNahgMlA&oe=69D4F2C4"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Ht71BC0DzEQ7kNvwHUUCZC&_nc_oc=Adqd8bvUMNcGxYAAv9oOCZB2AJu_ZgxK5Wy3qvKDidaRxrLN_RWmouhG03Ph0AHjXgQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1yxyLBbFCN6mK6cT_FwecKZBcl9dlOqbskJkboL1qA3A&oe=69D4EF10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eruzU_3ZVs0Q7kNvwHOTefW&_nc_oc=AdowOgXPLmwmBMIU2ejpZhWF0mlrfxwSzYXyvaUy78dgggPd3YFjC159hpbLXEAvr2A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af07ivyMxicpgpTYpnqIsX4L84bl7FD98srKuCOjxex_NA&oe=69D506BC"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Experience profound emotional transformation through the rhythmic power of trance. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url":
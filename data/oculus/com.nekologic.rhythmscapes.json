WdcM8&_nc_oc=AdqU3mfcvyFw6gVbWiFSTIFvWojkPOM76fmYv6bA8u6aIi0elFeyKrfouc0VcieRwnE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-wSKBaFeE-_YXTOCEKs6JdWM_PrOH-SZ6C6IrYsu8BpQ&oe=6A3BDC17"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xmBbO3d2HjYQ7kNvwHYd0M_&_nc_oc=AdqIIQmrM6j5mVpYlTW-QVNswhBvYD5PXbgP4CdrvNPaL6dVkaKt8FPeqK8znCJel38&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8krtD0hkGK3x2KDjAz-q6cjV9lS6vjYgmT_v9DWwRtfw&oe=6A3BEB1D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cW5cexqXlO0Q7kNvwGCLcX7&_nc_oc=AdrZy0GQRPvr2wV5t5-53f8ON6YuUdmzFMQLabLCPBQEPG_qxdWtYgZ8JR-b3V-10A4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zbbXgW0I8JC1Erd_sJI6TU-j4djMyJC6FjaOiLCLViw&oe=6A3C0004"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wPawdjbCgcMQ7kNvwFs3xvX&_nc_oc=AdoCFb_fln5y8deDYbdkW4ehxAX3j5qsB4biN0l1K2Bgjol2pDsWfByPp7KRVhr8Lpg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-tJ3MqrTpUJW_cPCjtNeZZHHLmFkbHHQqXpR54po4j7g&oe=6A3BFC50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CL7LSVfYv_EQ7kNvwHczVY5&_nc_oc=AdrAz5lO3NZSNpCyu25Wg7kg0OAKzgq_QBf8PCd58c5TzH7hhk3narRw9DrgvLP2Lt4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Eh7jqfeCMND7G_OSfXhS-t-T10BEyFm0YcpxA7mD3aw&oe=6A3BDBBC"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Experience profound emotional transformation through the rhythmic power of trance. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url":
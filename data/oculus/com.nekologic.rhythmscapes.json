Et6eR&_nc_oc=AdqpsE4b_2RsBBxoRaz8aMaq92lCajP7l4DRhGALxul88fghw1dDGCw3fFqKGeqbPDk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCeapOgigAHjLsnp4cRJmNO4WzdwhWF4xg7AwiX5edPGQ&oe=6A4FA297"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0VotygHY8n0Q7kNvwE-1UFI&_nc_oc=AdrsTcPjV3p-DvNe7XgA6iN-jk7nN6Loho1qhxbxzUN7mWLndKrb9JSofhRFFhbs874&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDCmc4v-zW5C0y2SeaY1EuJ3raLT5WPzq4xaZqGTrB_lQ&oe=6A4FB19D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y-ARg-uzCdkQ7kNvwG_UjDv&_nc_oc=AdolIAWpTvQO19lf5XFA7Xk-nFATITb-56gM16G2XaiVvWYfgBFzE9kGiD5ZBqDuIGI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQABzhT_PcnEK8_d3ZMjj0p7PWR4r-AMH48SEnvrPdMfSw&oe=6A4F8E44"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cgJ-iyFBjRIQ7kNvwGbGIhQ&_nc_oc=AdqLgcMmgZ8xWCFN3jCtu7BmIkODVy-tWinM4J5JtES1yAqkAh4kJoaUG4Qm1qxE5bM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC3rdJgLXtIAqs_-aqaLhX6l-BSp3qAojoiIQVZxOsQig&oe=6A4FC2D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a4RojBXZ_iUQ7kNvwEUHdpl&_nc_oc=Adpany9BncphYCtrb7VDyDBa2G8FlKOJtln9Z8Ua8GKkk4nUZoXUH8Fyx5yiiuvwX7A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCUKqaYkzfF-XznuwL2921sooklB1aVo7W0RtztxT4M_Q&oe=6A4FA23C"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Experience profound emotional transformation through the rhythmic power of trance. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url":
8Q7kNvwE2LAaa&_nc_oc=Adpv9OhuhKMSfX3NB0titoNFDU9ksnFIOnfk0_jT6uad2OUea_vkX36FQypI3kqHhRc&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9HB13_wlOPVY30tAQUzCXeDoBP17yudV5-jCMedsuvrQ&oe=6A466817"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hEV0dw4V1xQQ7kNvwEH3PGb&_nc_oc=AdrVEe8GNeug7d3AFnwGm0KoUtsEmJjoLYs5NE2QkaCzTNKRcfIsdX2iObbllyvAhrU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8t_C3WA6-MmgVd3JYKMZMpJuBiJqZJXhlAaeiH3XPgkg&oe=6A46771D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JaDAGMyDOBAQ7kNvwE_Lyzh&_nc_oc=Adq-POAI8EdaRn9KmK1IpG0J_4B0QrZjvyYxRL6pd2fG04qmXmgd-F8rJcYk0NxOC6o&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_H0VmDpc-I256lU8YsJiglF6jlyZw3ZxmH2Okp0DN6jw&oe=6A468C04"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d7yf7WAeyb8Q7kNvwG-qaOJ&_nc_oc=AdoOv7oWvz7UM5dK--U3oaxwwZwD2mexZswC8NHQ3rFw2Fdk4Dqm1h-tRBQhj6vnvgM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-i3mfCtAUmc-4Ihrsx--isVbuUavz_FFTUikr585tsgw&oe=6A468850"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v6FyORL3a78Q7kNvwGzAqqs&_nc_oc=AdouqwNdrxJhLtQmBIlCSucJpbk32shkvlqQvCEd7qi6AEhJv8piNngYf6xcO_GCJ_E&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_JywbhfICj5QsYRLRkcxAMTLT7sHw5atzJe1hnjmbrWQ&oe=6A4667BC"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Experience profound emotional transformation through the rhythmic power of trance. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_w
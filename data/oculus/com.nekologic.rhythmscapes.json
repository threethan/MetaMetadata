wPep9xFeQzTqb44mcsBYexKt4XEb_Ln30Xm1x6dyXF0csIKpBqAe_tHnWe2HNxY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAIeENdSEVePbRuSo0uhF4zJXm0dG4sj8FR-lg9wEGXtg&oe=6A621797"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mVh-7gug11IQ7kNvwGZLsQn&_nc_oc=Ado1qFTMp94Si5NsKD3BMnXoFl2XiHurYyZ_FwzhPtwB4hu_axd9f_Q2qKGyKldjsqI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCpDC2QK-zk4NhGZMuAvoHTiH901TMADyEZalx9WrybfA&oe=6A62269D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EKbnRuIc3QgQ7kNvwEXodle&_nc_oc=AdrdvO-NGuBQD6kzhPlzYapO1kJ3V5x9s1D0c86t4HA95k4jFNA0ygI5NI6Z7Mpiogg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDCG2EDZcjYYC2vJCM0qSxBzkhNmYK_JgmaiXc_mXsqug&oe=6A620344"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TgYjjwfw3k0Q7kNvwEey86c&_nc_oc=Ado7p6t9wYpNbkhoMHWj4_q1eahUOqgYk1SlkPu07Tl1l1oaZ0_BbN2JvEzab0oVBew&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC5GpBgc5bhoE_eK0o9WrE--YD4mzKBSkTaM1oPKodQ2g&oe=6A61FF90"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AglmiTbeHM8Q7kNvwF-GsPU&_nc_oc=AdqmlPRWJBQxK9PAKAElrM6JIXfkLWzEjxul5xWp889tos91SRDY_16vEVqen-juLRg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDj7twUdQk3bEW4nF85cIoiNol41kXIoLBtpH3glQ9-cw&oe=6A62173C"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Get into your rhythmic zone with Rhythmscapes. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url": null, "website_url": "https://rhythmscapesvr.com/", 
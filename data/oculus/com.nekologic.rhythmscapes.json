2KlIg&_nc_oc=AdpXDmBuRw4JVlo639G3fh1XMkJf6JYFXziMIwOg7dzYuyRKD-nLmfeO9Dzyhd_5PSw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9X314ic4jkJogdJ6YihpBIS9XLRgOO9IHHTxoiaWrkMw&oe=6A26C417"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VOfSDerZOGAQ7kNvwGeJ9F1&_nc_oc=AdohZ30V0ThG3vAEz9M9fEWkw0E8PRvWSFeWyXA9bDOhPAr6t_hbybutvUqRCzCqjg0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vN17yC47OUWisa_K2nklPOGVB-Du2V-oShonSXWxG-w&oe=6A26D31D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h4BSJZ3BXYwQ7kNvwFr8dHw&_nc_oc=Adrs9arWD8Kd7R2GLeQtD8_rmgTc0cAHbpq_qJcTuEVSww6EJIbVlS7kT6T_SCx-cag&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8bipJl83ZY2aoWta5xDV7N1LWHwHMRAXYGW1t-OOHKcQ&oe=6A26E804"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WIpQlXfT304Q7kNvwE6QPav&_nc_oc=Adq9NleTScmktTLuSOtbvcf-TlX3EaMVpYAXy4GcywyADBuEkcY2QITQYrLcqsG4KGY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Q6htGUwa_mgkSUIxKsRKZKRU4HUpbQgvgccq_Wt_TJQ&oe=6A26E450"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XigWoUc588wQ7kNvwE2Q-Jw&_nc_oc=AdrYwDe_il4aK1AJVfoiGzy_2CD6kFYwFuJelikdrySHoaT8Vj2sbARGb9av8Hkk44E&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Ta8k8WD9LNqL5Nn7xsUOYc-a2PCnOEbDEd9VOYebMZg&oe=6A26C3BC"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Experience profound emotional transformation through the rhythmic power of trance. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url":
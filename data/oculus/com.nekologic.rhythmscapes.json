h=00_AfxH7nIjO2-poUYBHZzD58mYUUbwPm9yzL9xMtijbDq8EQ&oe=69C14097"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bHzn-v0rX14Q7kNvwG-0rNh&_nc_oc=AdoTvYGpKRN-_IOv6qpUgV34VzdfkQ7bDxpxK827Ua3D23Gu16OCCUFbBGKr3mabgwc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afzqwlb5p5LtDpHne-v5XN5T27LUkcUsOoymwJ_AeSSJPg&oe=69C14F9D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iU51MhPMUCAQ7kNvwG-LvrN&_nc_oc=AdqXoSx79fIKQzeeFXj7AG2c7NV_GW8Fl2VIc2gSI_1y4z02SPiXZ11HG6SczmMsrU4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxnQR1RgAyokfRjwNzw5JLJyI-xkGLVEGMRUZdZN9wCFA&oe=69C12C44"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vOZZPFzkZ70Q7kNvwGOF6pt&_nc_oc=AdrfFF9j6u14kQeRGuO659KNuucmWKClUrArHCH_F3QyOGx0D1eGhhblF03S-MTZE7w&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afw6-LCuiTtW8KpCbaNcLvXvfHkEjnRGzH0L1NvG1q-AuA&oe=69C12890"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O7fKC9jqUvoQ7kNvwGg1oaE&_nc_oc=AdoftnkW0zYBGUakqEHHeOJhcw9doBg8iJDRThERyJQGD-1GTAnCArZIOuRT5PyMIgg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyapzlGj5ClkoqWHvgkeAA7BgSlPnasMdHvCymH2roKHQ&oe=69C1403C"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Get into your rhythmic zone with Rhythmscapes. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url": null, "website_url": "https://rhythmscapesvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_cate
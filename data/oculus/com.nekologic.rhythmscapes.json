A-sGPhRahHM6ZYC4KBNOLOe5M-SuGypiphxZnPMLKfcmR48DUw6Y3tlFl8uNtuY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIkl3ni4V2hQ-9xG0g22ETZZku0fr6aaUouImWio1Idyg&oe=6A9C1997"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rM6AS0hA9zEQ7kNvwGOWOQo&_nc_oc=AdpRmpIAtPn0kAjh0SOOp3VLNLYQezofHwZpVEp-LYeWlMQBqdg3U_bFkvwTKTLGe_8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5nK7UnCuhGoJ3FUbiqV57cMSil1v0u0rU4u2zYOiiYQ&oe=6A9C289D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V9QlXruMl0MQ7kNvwEFEl7w&_nc_oc=AdrKyMz442CkLbzBvT52li5knoSzMVyRCMY_l4sODNe8aqtzMeJTMT9V6rTgho3IPRI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKB0eIInay1KF9jPtTB9aoEfNi4J1BIkqmGZ1w2ymAWvg&oe=6A9C3D84"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wXwGz1_K2MQQ7kNvwERtqzY&_nc_oc=AdrhzY2zfk86_acRC35YfrsRwVMX2ubINs4u9GUDfsJR5ZUoebbe3TCbirMtWzGlwCA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIS84gMMJ28-XkDJ_EmCLfxo0nejeUP9WYK22xxoCyHbA&oe=6A9C39D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E84LKTZRC9gQ7kNvwGDpq5s&_nc_oc=AdpvY0YV6EJbLRs4Zhael4_iAXMt3HGgl6q894HM9d2PaywmBhvd9RtCDwFK3PnuJW8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJrR5SIJSMCGxQ2PwpUvlxGV5U0Kkwmp9-kFzvFZhW4tQ&oe=6A9C193C"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Get into your rhythmic zone with Rhythmscapes. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url": null, "website_url": "https://rhythmscapesvr.com/", 
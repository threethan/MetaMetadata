cLvqZ&_nc_oc=AdqiIWfB-oJMtfkgurj2lzzw9h2fdeSJogoJGeBcAD7TtNlUdHoK4PrQDMjQdnyggKM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNREnj9nU_b70fcTuyvG910RnLu1EQDjDuTFtI5SMNKjA&oe=6ADCB317"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WGRrgyChKwQQ7kNvwEztaGN&_nc_oc=Adr6X6Q5OmdCBc2sLqgB01rJFW7lk7wUPgKIPjQV-Xj3rDAmol9vroIAfNnSo0H-mco&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMGBuftQBNWwvdEf8LmTPL0I_Dsnyd449O7Nl7b4gAdPA&oe=6ADCC21D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YCyN9RKceEsQ7kNvwGCdLeV&_nc_oc=AdpkCwTY5iRRCgJjqFMpQrnUpXYS7QjLG0shIP0gaAsVd64b2INs5J9B-02dSksCtT4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN2CHvWhc5W0bkSjO34Cw-blMrgnn1tFwoCr_Bm7SY1HQ&oe=6ADCD704"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xmHjGlmHuzEQ7kNvwF08y2A&_nc_oc=Adr42Eim8ld1TgEDQayZOi0XMMIa6IsZ2qseImAQokyL2VM4ziLRHV3inybLPeg9tNI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP66H-S5tUnduGZfWTTydgzgcU_PICHpbb398QypEaDWw&oe=6ADCD350"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y2CCJuEZZBEQ7kNvwHt8Svs&_nc_oc=Adqhdf3YnihAfSW9WaClhXFxEZJ0Ws8hOyOXnMHrA3wKUFp1VWu0lFPRSpumD05l5w4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPq3XkSwRZXbkssQF_tm1mn42UXo7gKBLrEcMkPm9pVdg&oe=6ADCB2BC"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Experience profound emotional transformation through the rhythmic power of trance. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url":
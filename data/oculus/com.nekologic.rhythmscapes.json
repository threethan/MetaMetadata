UQ7kNvwG7QixR&_nc_oc=AdrBTa8UcDfFuThdy9v6Bj7BKjGdez7Ueqe4fwNqmBKZqnM7xElrldFiVJ8sLGRrcdA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4k87uwQ4AzLzmvj9nZvEZz-QVW4L86GZ1zGz94E31r0w&oe=6A11AC17"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tJnjiD61jKEQ7kNvwGhJhnQ&_nc_oc=AdrICHXPCyRVO_wgfhkzJ7mfDaT9-AZvOc3rAdonPmabP39KXSWbMJTANzbsCcjZ37A&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4168qkuNJ_DGT9Zhsz52WQ9KpYr5lm9kzjkZLhSqmsdQ&oe=6A11BB1D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yKhXbS3PDyYQ7kNvwHd8fFW&_nc_oc=AdrrihTMmMYemUmNJaZe5rpvuKmeUigek7Srl84IiYrgdtHHrCvWoSMcfXRqPiJsCPQ&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5dr7uRBKM-nuLz_XpO3KTLthqfQ5LuDtYXQGdbNcKXwg&oe=6A11D004"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XZFajza6yYUQ7kNvwHMRT4j&_nc_oc=AdomVBBkE-VUQigo22a4olLQuoZTiUt8tXaCuHmB7IUtHyi2qRcugH0myENqNNzAgHM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af671gQwMdn0XIiELiiBDH1QHBNQeNlOQCyjCjITXwiw9Q&oe=6A11CC50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=48ZY2BByTmMQ7kNvwEZjhHq&_nc_oc=Adpt63NeC0Xr1-h1n5CGwzkqGXCMNxd_19ljjpzrsm_42fpPsxh7At9hDWAXsJ0K_yg&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7VIBrHwcIIIUxRdHl4NigibN4FElQASVuEE7cnZE05VA&oe=6A11ABBC"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Experience profound emotional transformation through the rhythmic power of trance. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_w
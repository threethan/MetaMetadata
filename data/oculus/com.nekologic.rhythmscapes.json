FpmYR&_nc_oc=AdpMSqYdnSaqdQAbBKGCDZAaSvlzfteEBC2hdU8CNTqnF71YTlGJjkF91JlwgdbVt0w&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxY0-ZSwWAWyBQB-n49wkVLa7jsojsMJuItEDX2IQJZZg&oe=69C29217"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bHzn-v0rX14Q7kNvwH_Y9Ui&_nc_oc=AdoCbXVgzeQHEesnbbyD4r2CBsZXOW6mYYLxKsVmU1t3drbdADb8LyP0Ic3C2BaLweQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwJ7xjy2JdMfQ5e3wNeJWE5fS0vzsw2kLaCGuTcTQcV2g&oe=69C268DD"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=erSjbl0fUjIQ7kNvwGa1832&_nc_oc=AdoiXozbJJBOwUyxMSt9iS3j0tOby7pBHVbYgDpeSnl6tVsldc0rhaS5tZWL_flamK4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxeB9fJDUz8yCYBcRrI73gar1Wj-ZU5jEqm1ciy6OQgew&oe=69C27DC4"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vOZZPFzkZ70Q7kNvwE9Z2qI&_nc_oc=AdquqJCycFfeKE-b-Rc2ljVJV1OROhABNMR_6Pvlb7kAXDWFQ0bkA6-ZaaGObC1JPGk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzXnMplsTpU-ViBjglmJwx46gDksvh7dXF964NF9VB0iQ&oe=69C27A10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O7fKC9jqUvoQ7kNvwFD5w4M&_nc_oc=Adrhvz-9w9cWzJU4wG8Eb1JSQ5KLX_bYNLyPSTxKWnm_7TAmrDOXpu-NJ2aKdWmmQ1Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxCk4UZBmkL10HH3VdhBe4W9eIfEK8QJiDdrCrTydA41g&oe=69C291BC"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Experience profound emotional transformation through the rhythmic power of trance. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url":
I3Mk3&_nc_oc=Adrz7iRnzj_8VKRFr7lV-UvdfxIc5GQcCgtjKpBpOHyqje8PznrYhuuCbkDFpgKGk2g&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2sgrg1cDdSEBT5FvXOCJ4F62V3wuHMLidaLWp6E5_lNA&oe=69D7AA17"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q_FXxZbeihoQ7kNvwHKp27w&_nc_oc=AdrFOC3q5_GPJ9z0a_hX3k1N1wqDS3SuEsIw-QmNEBEUIKjwjCogcIzErRVpSok_790&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3EBlcUfpq4-R7-235c90D9vTUh2nWPJuNTQnnbyX0G5w&oe=69D7B91D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nfCmGk74kn8Q7kNvwEHlRrp&_nc_oc=AdrIZUBWqHQVQpNX-n5VmX4DTP6_-1cxYwkBr2xaCLE2h6HzSp7EsZIkPakXZAI6U-g&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ntGwBkqok0P7DLJEvdClpnSuNZ9bvOp4aTCWzEsGShg&oe=69D795C4"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CsgDj2kFVxwQ7kNvwFEYMbc&_nc_oc=Adp9CGbHxz919X5bKz9Z0r-0Y_zYZ9UryaCnIruYaEpFqgcj9JgBe0Kx4O7cnZeeyTU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0zWiS23gRMHdUACei8RDabHkdmPW12ptfTZrAxde9i-g&oe=69D79210"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eruzU_3ZVs0Q7kNvwEjJLv4&_nc_oc=AdqeNjjksL3BYiKH_-rSuJt_GyeNto1FX0gl8-leFllWVSMsfHlK4lfFbu5N902M3mY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0qnvOqiVddgajAgW6B3c-Las2fCfShM4MhoAKTFHlzFA&oe=69D7A9BC"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Experience profound emotional transformation through the rhythmic power of trance. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url":
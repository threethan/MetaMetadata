cZP-B&_nc_oc=AdpijjQ1R9gwJ_K9GOYqJwub92K2R3CokpPwvyVF_RN0Ms75CHlaLqiWi9KlDo0IdNs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2bQ4yOQRvAGVcIKwN6nuArNClRX8Ju5XrvHfRkBekbw&oe=6ADE0497"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WGRrgyChKwQQ7kNvwEYBReg&_nc_oc=AdrCTf8p6lVIYCTAnik1R2LC14b-7BsBJ0YXbMEWYmQdexRbGZ6b9JH2iiLNiBENLV4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNpUrKHyPr1ADVBC2YcCfutkDXV0tJZkIzIfv7uDQ0PQw&oe=6ADE139D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YCyN9RKceEsQ7kNvwFDXrRF&_nc_oc=AdpZnpaiJ-g0zjiW-duLQ8qlNd4lAdMN1-SnDVFZB2Cr_JsSY4Kh4vyVlEadnovyWqM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP8mJKHFEFJMWDechcYcVfhDj2QqhVuVRypd92yBrd5_w&oe=6ADE2884"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xmHjGlmHuzEQ7kNvwFlviN7&_nc_oc=Ado0Xpbbf7cYBfDnEdXQnspd7kmn4gAkI902jE9X-YbbCHBPE6z8wY_hblPUnHjnyLY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPXmvyx-Jfradn3frSXNyd70IJlPP-gCXmIHeDSkhY1bQ&oe=6ADE24D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yTM6vYSkkT4Q7kNvwG2j6Lg&_nc_oc=Adr8NBKIUBnwGi070SQGngAeb3xePmyuYKyduADWqn4SZ-R7L2OODbwBxnZ0N0rSYmI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFLO16uvkpqpNAq0d4Q6g30ixj8tQXXziKNGeZnSbknw&oe=6ADE043C"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Experience profound emotional transformation through the rhythmic power of trance. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url":
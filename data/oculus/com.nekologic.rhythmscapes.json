Q3bQs&_nc_oc=Adph83rv6y3uU6aner7ilDkBx7wnlpfM4U-ZLuKox80WKurwXrNH08ozwSHcTwCzb7c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6lQjksJdtk1iWLYZZ6D1_faF9He33wnbKqUTyX0HSU7Q&oe=6A0DB797"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j99DrP_6k-EQ7kNvwE-cx6M&_nc_oc=AdreSPF42ShrNpjSdbKNNIyTdqyvhSvQR8dJ-NirztiYshSdysOX5DYtI5EFZ8VLIgQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-FeW5FGFui245g8xX-ykNqbREW_Exd2eAl60l2FdOkA&oe=6A0DC69D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EI6nWlGtB4UQ7kNvwH6o09S&_nc_oc=AdqosZK-CcUz2d04HET6q-agrYN6CYEELtgJYZIF8qWTSDL2k4AphX9RAH7VxaslIHs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_s8cWYyj0Bf_TfFoC160U_tsQC8-zYBxTI59tBkRW5Q&oe=6A0DA344"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uBLXgqlSyOYQ7kNvwH8lTTw&_nc_oc=AdoQOg-D_YarQWmwZ2nfAI1Ph5yerhTFy-ugeZ-xs_vSUfCS2Jy8M4bMcKrH9E2ffMU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5137_uDWW5PYKaGhjiHGG28Osorx-ywMLKhrLw_7Yvjw&oe=6A0D9F90"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0OK_5tItbVIQ7kNvwGvKFg8&_nc_oc=Adq01ecSp9b-tCqssPZ3krYD3CxGKuaMTgeXbeEf0dEmQ1Bo29zkg5tETrkppmEYYoI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7iTNAxY0pgVAgTWFKEGHFDzDnRwqTNsvIfaOc2Kmz0jw&oe=6A0DB73C"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Experience profound emotional transformation through the rhythmic power of trance. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url":
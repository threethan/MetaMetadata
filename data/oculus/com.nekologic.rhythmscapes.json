w2azt&_nc_oc=AdpWs3KoOqK17vqlVUTV4FBNQPkZmsw4LLrgmDIxiAy8wA4o2gF6h4BOFCqjJl-HvcY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwfsULa_yOoeNWSdr1hiKwKpeT8ac5s2rRzccKRNL8dTA&oe=69CE6F97"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U_aL4Ty-I50Q7kNvwGJHPxH&_nc_oc=AdoigvX7fhGmB9oJ6IkmTsT05HAieZTuMRwiTSOYTdkCwF0o9Fmm0qIeXhq_yr0XtbY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfytJBwmDdFJw8WYFoi_ZbcvFEWFgShsmD84mhplaCpqFQ&oe=69CE7E9D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IJwurmgH_s8Q7kNvwEI48Pe&_nc_oc=AdrNrxu2kUDoLDchVOI74vEKABYgl_8BB4WY1Qx5sBiLXBvnpRmApI_WL4QGoHe3Ztk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzARxHaCnwCze1UtBBG35zJIiCUIsIqHa0pT6wFRUBUDA&oe=69CE5B44"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j3u18v3BQwUQ7kNvwHvNiVq&_nc_oc=AdrShZQ-r2cahTAETrfhLbYv_dSFZqs852Fnj7uh7TiNkb5h0dPt6EtlIPpX8xPI-Y8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwxU43MBMABrYzSsIwIdVJv8foFgdJNIQkbMtLwIWj1cg&oe=69CE5790"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ls4Sdzw-W3EQ7kNvwFM4QTv&_nc_oc=AdrEf6UWcgded1U7HSieYtTZ-9PH5ChRG1yQQ_EPB_cTYab28BSxGl0aKF2uJfEaq2Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxPNYgsfdmIqiiR4B3W5Oc6iqJ3gCRjZRRrnBd6_PKvjQ&oe=69CE6F3C"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Experience profound emotional transformation through the rhythmic power of trance. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url":
itT-1&_nc_oc=AdqayisjxVpZ0-zydeuNzlT7kf6YIsvaeCVuHRNoYnUWSkjVrSA80K1d6VVnJ8wYQrw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC4c4c00VLLSoGCRNFvtdyWQdD2xWw7yaAWUaQ_Cz6h1A&oe=6A5CD197"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B4HceTfVFEEQ7kNvwH-68KR&_nc_oc=AdrAhswkrEEXTiS_K8jOwLN5mUmPtexxrDQUHqlWuJBtlZSh0IbE6afqCMAPhelYTVM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBVhgpjjjKm8_YWUZDnJAuLIQX-Q3WOVEfsQ8lhNku_6Q&oe=6A5CE09D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ynC-UC0L3xMQ7kNvwGdeS89&_nc_oc=Ado4ejPm6RwSFtpdOdnBXxYWfaYinSwYVMFaEUb3_zHvwGVRKhdgK9HD-K4tystMrHs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDyg3Vn6uskIgPGbaS7NR6doleOTrEKom6Ge0QNYkS8Ew&oe=6A5CBD44"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gXuhyTkYlekQ7kNvwGyRipn&_nc_oc=AdpcnWqdF9QShv1pIn7uIkEtzlPunuNjhY3hyDwIUMOMQFs-6BDQXlQ0wkFNfc3YHBU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZwb1bE_A-eYMHKJas6ikb4TvM_QWAHcS6j--_-drKJw&oe=6A5CB990"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N3isAE_Fm0IQ7kNvwFP2c9n&_nc_oc=AdrhjNEJb6x6mLmeta0kpr5-Y9SU12EYo3_PYpOlN2El9_hSZUf5HBtel40iB_lJ6YU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC_UD0HWIlB3FTaaYwBiSOsasAN7tqr3ivSZ15E4X_cKA&oe=6A5CD13C"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Experience profound emotional transformation through the rhythmic power of trance. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url":
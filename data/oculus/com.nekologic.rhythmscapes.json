I3IDf&_nc_oc=AdoUZhng4xr0fz8A6QlpYOLmUGm3OMjzjVvdJPBdG6hEcQ-x3tfcFnH8WFfAWvsjMz4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af896Nh04viAHnQNASAOCvAHxJfOFTRydjIWunryNJJqDQ&oe=6A3A8A97"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xmBbO3d2HjYQ7kNvwEs5wSh&_nc_oc=AdqtXTMgpyDg8LM9pHPEKiy5Pl6veLjb8svmv4T_MrXfmRtjB5A7b3-dl1VUXgGYCAA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-r7DUq9euAov3DdPmcb90ucdONpMF77ty0ZE-Hjj2FGA&oe=6A3A999D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cW5cexqXlO0Q7kNvwEeRyb4&_nc_oc=AdpZ31MkBzd6XB5i6E-dX4F-DMh9-b3vtRC30xV9lg1HTgy_9At8PqpEfvBicXhzoyw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-O44W03KO_C-NC0I0iX_RTYIY9GWlaqcYNkTzBehMAbA&oe=6A3AAE84"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wPawdjbCgcMQ7kNvwF1se-1&_nc_oc=Adqo_sMtbvOQ6zikzOJj7rojdaT6VXer_wM1gI1cPstRFOf62UtywhubCbUQJV0AZW4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wt1MgXC0U3T3LSxHmtykOjZDGjeEIIhBdEx3myThyAw&oe=6A3AAAD0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vIKpn0cmSiAQ7kNvwFNaLeW&_nc_oc=AdrAff9FdVh41hAkqUT6b7Fij8ht_lS2YsPrTUk1i0YZhtj3bmrQpAXIr8T1R2xelfI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9U1aLOX4U15wmyDiY5kbGSMgCFobYbfMwGeOt_RB0H9Q&oe=6A3A8A3C"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Experience profound emotional transformation through the rhythmic power of trance. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url":
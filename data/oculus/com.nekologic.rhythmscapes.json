E0wo4&_nc_oc=Adr-_K9iWJWN5Y8y7kO3_cCTdW1cGDVvKFxmbsDx-FI1xramARlUj4GhLg4FFe0sDwg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE9PpoGlRH6DpQYRZKZrkaHrtR_whJZo3Ryqa18lZtQdA&oe=6A830D17"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bUe02dqDFdYQ7kNvwEHcSM5&_nc_oc=AdrGhwKlU3ZxPqT0lc1cKFQNSstG5eKuxRUx2NbosmCOCqg75jtzqY7S9E7aQiXtw6U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQ5y6Qpz7xMaOUGAdJ0V_6zOvTXnzG5QImoIRswZJeVQ&oe=6A82E3DD"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JoJzZB3yjjwQ7kNvwHc5j0W&_nc_oc=Adr4wSP68UQGKl3lV---URSe3gQuhAD3J-a6fL4KEJZ7RvgKNLi-JMQ_hblIDQhdpiM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdlEC6q8YDjBnVu31_hv21kpQcS79MDjQ2X2OrNe7jjg&oe=6A82F8C4"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rG08Ea0cHPgQ7kNvwH72jyc&_nc_oc=Adq_q2wAptBon3hEXNHjACTs7cSVQFV90_azXAkMmDpgnLtWgx_K_FmgJFwfnBCG9uM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFwi9pBuvwqlRSrg9jH2csN_W9M8BxuTL4trT7idMkgqw&oe=6A82F510"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=60lK4c0txwoQ7kNvwE6kR5Q&_nc_oc=AdrYtPs7BckiJhQNWcxTOiLGrCyDuI_SRIIQ0sDOne569AcFyHRK4mybaJsuJxdoUKo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFiM8E-tkWC5VuKiG6ZmwjHEshSEYR1D_BIPZ5hWfxHsA&oe=6A830CBC"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Experience profound emotional transformation through the rhythmic power of trance. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url":
qcMv9&_nc_oc=AdodbZizULQuf1vSeR3DfiJjhs84o-FCps4aQsNkXtUbfS59HEHlpK8lYxQJppffZSo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMkQGn8q_noWpVwYbzfZOZv_V3byX83_7SzAAgidRDY3w&oe=6ADF5617"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WGRrgyChKwQQ7kNvwGeBqAs&_nc_oc=AdqkbsboYT8Tpo8sZAkqS6myYI3bU2FzUAkGex3s5seKSRPTErPiHEALmVH8O4GYDRY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNG0x-y8-OshdBHDh8go-5P6wjpdI-_QDCUouSz4v7W_A&oe=6ADF651D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DjcdgSKDm7sQ7kNvwHh__wI&_nc_oc=Adrhu8mU6EDtRbDe1f514XyRe3BeU9u9pPG_EOcE8K8oYKUWGQ1JoZHTatOiBHSuAE8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOz68RN__19GeNudsJh7DQGLxHDyiy8yTL_R2KbbPKbQg&oe=6ADF7A04"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xmHjGlmHuzEQ7kNvwHob-I_&_nc_oc=AdpR7Y2XwOxpvn2_PiExfaNS5-ARLiNTJg4_N_dAdTRpASC33uMKO_u3yvDWJ-M0R8g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMUxANsO-JgabsKFnERo2F-tx42evqEHNxap9sdx61yOg&oe=6ADF7650"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yTM6vYSkkT4Q7kNvwFz-h6_&_nc_oc=AdrNnIojnxSGoya9XS0nqSeRkpmu1AD1z3YJTRISSnkIO4zRK9CbB04v-7v7NKiLUKo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO3LCLr79J_f_VDDU3D0dFw8EJPuBaMs2u6V5_4WIUFKw&oe=6ADF55BC"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Experience profound emotional transformation through the rhythmic power of trance. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url":
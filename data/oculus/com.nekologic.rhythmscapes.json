ixiqi&_nc_oc=Adop62G4Xt0ij7GQOo9zysremPdrNdcm6S-opLuUQX0ak3zPpBA1xRO_gLLRHoHs8ZQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2HmnFIHIcEJyE9Zxt4_Hs2K-Ip6YcOvxRaGalrObvhJQ&oe=69E38797"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MVa3dUEuxbcQ7kNvwEWeV0q&_nc_oc=AdrOghvkRMsWTMMUTV9dwF-h01y1ZRzaQdFaVBSNOSpeInUQ9ZpJeSh0wxd9aSi40MQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3aCCgjef7Ahh7H2xTm0fDG2C93xdjz8hMCZvhKqlcxPQ&oe=69E3969D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ANFIXtIoIC0Q7kNvwHP6YH8&_nc_oc=AdqOxflMPTYdcLN22ueiDauMJg1hy6FYPIr836tx8M2H2eLFKswWQPzMh1WwPb2ZPTQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2sUFIbnPofQnSewSFZkq4JLnTJ0Pb4bsrn5mDq09r0LQ&oe=69E37344"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NJDJgdE8sLQQ7kNvwEHHN2p&_nc_oc=AdqeSXi0Y-fvkNh_qIwi2lFrKlNP2czWIz53DVis5V8Ce6oSFGjdiCE8QRnHRA9VNoM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af36vsHV59NLTHKkw8t_g9bXXWhYPtrojAiH9e2iNZoFrg&oe=69E36F90"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L00Suzhh6qMQ7kNvwGqMRIX&_nc_oc=AdosCim24ENoSXK8frt8opMfSmBIoQ7jvRe7n-Tz6mgZ7_HSfuPpu1snVicMCEvNAGw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0feJusRDS3Nv78yiCliNYQjaHp9HdRaq88HrZAo5gucg&oe=69E3873C"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Experience profound emotional transformation through the rhythmic power of trance. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url":
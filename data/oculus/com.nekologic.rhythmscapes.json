csCl_&_nc_oc=AdrjRp2PJZCe2K9Ea7GNDz0peZ1FyOGW2c7wxxaroYpO6mMLqPdMYpP7KcdIupOXu4w&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4CJlW5MnKzqFnRBQR8QxoG42pcpVKHvU9QceRig8MZJA&oe=6A16F217"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-jjwTtsossQQ7kNvwGJZQNj&_nc_oc=AdrdZ2iBJjICiYNHV5yblLmXrH6i7-rtFh92jwHuqyMzunFtU798SLBUIC18B9ypLN4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6JaFs5LAiGUa7-QuR6BJGnKPjHhqwJgR0rg15Bkr-VgA&oe=6A17011D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Vit8Y56EHgQ7kNvwE6gGD8&_nc_oc=AdroW4eson8Lk-Ui_UmW4z5YLvfKmGnGf2bTt1CpHs0-EfEa5gkWwPTxeEW7CqsskZw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ctrm8t-5Bp7ru62qJxUurIVeNV9JggFQ5_IouoVXItg&oe=6A16DDC4"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AMnYk2ETiQwQ7kNvwFCfvKD&_nc_oc=AdqHjTYhsnpSM7E15K7YWg-KWtk_CPqj6X4BVNE6YdfV2Yr46nxFPVhQpSQxo3ChCBc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7xNs2EQDaHlLU_GCvMYvt4ngyKb4-bKWDN0iG_Gx_Mag&oe=6A16DA10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b-wwv7_xEmIQ7kNvwGC3_e0&_nc_oc=AdpilVQics_x1WD5lPsyPJi0yBX3d1-Va36cz--IctbfoozqkNUOjIbkJFonLSRgGbI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af67HDoJGGOccvX0eusyICPaCnGUZ_YV7CvYjG1MVIr1wg&oe=6A16F1BC"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Experience profound emotional transformation through the rhythmic power of trance. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url":
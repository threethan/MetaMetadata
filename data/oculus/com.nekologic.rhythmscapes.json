c_ohc=xmL4pF3vHlwQ7kNvwH2-fC0&_nc_oc=AdpZQlAzv1Q6gbEBEZ8HgI_hO8qFlQDWUJsH5NKOZAtB7gm9cQK-3YyEFEdyNxrjyzI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEEKlg7NpM_tOv_0p_p6Wpdzj9Q1T8uVmgxlsMbGfJxiA&oe=6A8577D7"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R2lGwYKtOoIQ7kNvwHGqlaQ&_nc_oc=Adp2SRA1ed1Cb7KtYexIrwOm_7ZmzQO5tlCv0fjIEZeE4l6vZTdvi3BlmKgKIf7YEUs&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_AivdrVlFDNq-45IvBvhoYRyNSnMug13vF9D1gtuPVA&oe=6A8586DD"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l5-luiNahKwQ7kNvwH7wWXU&_nc_oc=Adr7CQnQDIu8qD2ulhK_VDQE3Zslg4pxIkrJl-fniHWI5kC-PeAXhSPbI08MJ1S1H2M&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEK7De9x_2hiRJJMLyTCvOk-VAzAM3fsSlX9fJIk-Rxbg&oe=6A859BC4"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rG08Ea0cHPgQ7kNvwGfnUoj&_nc_oc=AdrjAn-AIl0F2L_GdboQ2v-17uGA2fS6FyTkbNOjLkuohH5QFd5QOR4-YpyryuuRNp0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5en34JuGzpXm36ylnkRsv6MbahBMCI4rmrA1ASDHODg&oe=6A859810"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=60lK4c0txwoQ7kNvwFLxbNn&_nc_oc=Adq0Fm0r1z4-Gk1I-tF0nerupZmJMX5oa0bzAzvO0JL5LMBPA0wtOD9L8_yjt2eFsoE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG09NF-nv0TyXSCdXWn1LR1WkogerYRSVeQea_ihwsBIA&oe=6A85AFBC"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Get into your rhythmic zone with Rhythmscapes. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url": null, 
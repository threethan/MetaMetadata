hidIMKqnmy3vQIScM_ydFdVjUgWFc2Q55Y-jQVreN6RBzZhi7o8d1V2Lz2FjABc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMOCEhC5jwKmhK7Ra-_NF-b5EpZXf5dWl745LWbWOtD5g&oe=6AE1F917"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E3Isfv5EauUQ7kNvwHS5_-Y&_nc_oc=AdofSOdhhhedAwd9W02N7nJcxdCgMD5BJYnyhltDUKI1nTFtCpAObNc6FlwmUt9Ptsk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMCQ8um38grZTsZArG5jqQ7aW5mdjWv83s026YXMF3eZQ&oe=6AE2081D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DjcdgSKDm7sQ7kNvwEmkpci&_nc_oc=Ado_hjIhyhKpc0Xyf4NLFZ2Mkc0P2y9VNPh-P-tzdMZkKgItsI54CIiD0pGpGEMh1e8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMhzYl1F7ZPQZezXBomsdcmM7Wl_itla3UNtNzC3yMg1Q&oe=6AE21D04"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sXitfVas5JsQ7kNvwHeNwV1&_nc_oc=AdokQXqkb4uq50leMRVVPnKg0dWC-SGRJh5uKAjLJNKwTZRch_-Oue3SQA10hFwvFrw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOLfzs4LYcy7sJ3Ie9SRb6wXQmFWf757eKwmJ31FDGh_Q&oe=6AE21950"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OXoQnxy2NBoQ7kNvwEEAuJW&_nc_oc=AdpFTb2OIfxfH57CG9rHfB8AL2W3j1Wq5Vpm_wsM6EyEqjlQWbZs9bjZHN66qvLrXnw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOcYwzzJPR9ekscR6QtTTXRWYHIp42A1-utsYyYf_Mmgw&oe=6AE1F8BC"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Get into your rhythmic zone with Rhythmscapes. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url": null, "website_url": "https://rhythmscapesvr.com/", 
PdSFU&_nc_oc=Adoa2eSlVHmxZCA-58cTkL34fGrperKamhKI8ZBmyo90IbDlBIQ28d-vBpWhcTIUHsM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEI12TNGNjjcHq8uXdWIAABCtU8Rpi8aOFxlAXuoBe1PA&oe=6A7C7597"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wqWcFu-OwysQ7kNvwGx9uTW&_nc_oc=AdrdQJNjPq5VMZIv0oUK7DCYTQh8rh1mwa5nwys_BwC4EdbBYjR9Gbe-uZZI-YD4v1M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQ7TILlklXH5Iei5WMrYw4_CinoW_R3Dsjdgg0dhb61g&oe=6A7C4C5D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Ssa3dpabDUQ7kNvwG84K42&_nc_oc=Adq1X8o3JZ9GWZQR7mK1GC3KJP01JzBEb0zb6BvK4pcCf2_sDEMBXsXVrqnV2z4VRto&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGw7wnmtJa2kluAVXH5AtrXJ98j_LWr9xueUENZv7OWDw&oe=6A7C6144"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yzwf8NguauIQ7kNvwFFQGZ2&_nc_oc=AdrNtlEo-wx83j2a6L91gBGnfU7tcyU1Iy5irPeMlpwhjaX7eWD96yaO-j5-Nm_Y4VI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7DKi1QZWs0qKdKGN6IDOvXrBUZWzd4c6na8jpIebahA&oe=6A7C5D90"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pfGVo9QfeGoQ7kNvwFYWDLB&_nc_oc=AdqaPbzpkToMXeC04mN3ozKFecVyJFIGHlbfFds077Gckg_0dprLBr6Gfl7YauIS598&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFNkNacOc8xG5u2g2yc8giRbSwBqNGr8Ilm9Z8YoNJcbg&oe=6A7C753C"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Experience profound emotional transformation through the rhythmic power of trance. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url":
i_H94&_nc_oc=AdpkazSaPlvaDF3udWBiitNynT38kjTnCkKUED6KyONZOCAZ7amBSLYD5oqWY0eHcP0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6yJJrlsUV5akSuvjgJq8ECLXrnIvRaAPamPeR4VYcrQ&oe=6AAD3D17"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MfYFMUFGnX4Q7kNvwE2LL53&_nc_oc=Adr1p1rVjDcA4LU9NvwSEGLF8L3MYip3HNe5QlSzgMw2K0nXiJoDe7H4YVumYdLT040&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLeo7fFJolibHdHQnrFPPYB59c_6NbUz5JI0Px1X-mMYg&oe=6AAD4C1D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zVbD8NUz-fkQ7kNvwH-XZZT&_nc_oc=AdqhjviFULYo1MGOoE381ms73YBO6mwNXpqDcBZv7YvWQXjNaWUeDM7G5jOhGffkqw4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBzTn-eQ1fLdcipFHSqt7fwtW1IjM_89N29ODodp6Svw&oe=6AAD6104"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kxNIB0-1bg4Q7kNvwEm4urg&_nc_oc=Adpr6XG49fbXlvPaAReSvpnG586NTuvVAlrvhGb2_O7p-cqo-vhUUeSuMPAlVEWw8QM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIg2jFhSs7cG2TE6xCvEUTxsd6jYioSWaVDI2ONzuD1Rg&oe=6AAD5D50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YXVKGO076SYQ7kNvwGdo6d-&_nc_oc=AdojZn3okolbfneY2zASdLOCOLvoh-darwPu_M2AloPzKUn7Tmv9iu7AZ28Nyck_d5k&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLMScEM54KO-SKSAY92Mg-Dnf8lPdKRvO-eDdKuJly_Hg&oe=6AAD3CBC"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Experience profound emotional transformation through the rhythmic power of trance. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url":
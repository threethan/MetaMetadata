nhiDe0bimXDQxoFKGL91qHmpk6wBwad8_qvKKFlOA6H9wblV19Z8trVAQFAw7sY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDkK-W6IDvuWAMl2ZmTaQR_POQ9MP7sEofSSFtCWEvvSw&oe=6A5F7497"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X15O7c3dR_sQ7kNvwEc9lua&_nc_oc=AdqXQcX9xCEb2oHy6O7-f3UkxwVI5EahBif3bGbY_YcCZuET3dgdzIxLAqhQhga5vHY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD320ALjP0AMYtuysELV65RQ60RNyughQ8cDFOITcd7xg&oe=6A5F839D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ynC-UC0L3xMQ7kNvwF7dfpW&_nc_oc=AdoiK0aCsNy1-SNgVilsdlKHPtdt4UbyyfmhbiQTZetacflUkG1OMa-fBlZ9B1Ah2CI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBvT2N24ZK3kOoPPPwGFw73WHu9I40t2q6cFleYeGgd1Q&oe=6A5F6044"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LdgEiMAFs8gQ7kNvwH76H94&_nc_oc=AdoVnle_zYAhVJOOygzcSHHOHcydRqdZJEYrkmzW8De7wH3-Y7bVPkQQyIaGWGmN2L8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBeFYoCNHGeDREDUmmy9LrzcJSJsPgfLcR5LHZrCyGNeA&oe=6A5F5C90"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AglmiTbeHM8Q7kNvwGMvIc6&_nc_oc=AdrHKIgZT_kIk3h9HpwdsdxVRxGLB_yN7utQ8dyjr6VdpXQtWptNa8vcuYlpLWfllc0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDK4B097u1QTxbC1zvEk38iFHkNGaNj-UqMV2vonuBczQ&oe=6A5F743C"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Get into your rhythmic zone with Rhythmscapes. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url": null, "website_url": "https://rhythmscapesvr.com/", 
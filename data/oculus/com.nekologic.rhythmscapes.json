&_nc_ohc=qq-JzNDcjrkQ7kNvwE08WTm&_nc_oc=Adlm66-3goqH0BEjjjM1XFo4gKaq2PSgFil7xMTliwhHf-LUsWLLwG4mDNEcDaz7l4A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvuJAAZQ3BA81P6e3OqyMpyEmQn0y086nyNECY1bxh6Jg&oe=69A6B95D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vf52Va-byYYQ7kNvwFSfFfy&_nc_oc=AdnlrCzby79fVIUUfhl95Sd1gU0SefzuOeCRGQNJSSEVnQf1H11dJ_GYCfl3kr8EZm8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftGIITSg9wiJry6cACnXpPMW75xWcRNnDyMZhp5Tyk61w&oe=69A6CE44"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i3b0ppvKFKMQ7kNvwFMmJDJ&_nc_oc=Adkh2feV30wDHhe62kcRFRB2Y58xrwmVahI_5EQizgyraP7pcMlpAEgmC6C2p7GTNcU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft6pRob0Rfl1sfLR47CCUAYgeQVP2SlT8oVe_G-v12w6Q&oe=69A6CA90"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cwBl3jbbrSYQ7kNvwHqopYp&_nc_oc=AdkmXx5cyvoVAogx_tJ0B_W9HCaWe3hqVWcr9JPRz3r3LY42075JBpeF6b5PL2SPSRY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs9fZ1KGSfWiiY9M9jNdZ5FN4qbY2AqmhGQFGAG0oYPXQ&oe=69A6E23C"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Get into your rhythmic zone with Rhythmscapes. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url": null, "website_url": "https://rhythmscapesvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "suppor
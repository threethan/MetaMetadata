sO6TW&_nc_oc=AdruG6NmplJmA5FQJajwI8UCxxSpimb5RJULkz_x6RgSWskROh25myf7FmjUB7dIgg8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7GfalWTdU5FA4LOSMhkVua0djcxS4VxCvFG3Bx_glmqg&oe=6A0C6617"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j99DrP_6k-EQ7kNvwGzDGmg&_nc_oc=AdoRZ0OeLVYcUMWFpDQ5K-PG9e9gYXkAUTTsPo8kb0zrNR2-HfKuv01e1x95nsfOZ5M&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5M4ZQcoDvupVFUE8dRF658fQggVTe0RZoUZuXXKkxYDg&oe=6A0C751D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oF_lKHvKsPgQ7kNvwGQDyze&_nc_oc=AdpbUEvbRB_2rR9defZJqN0jZN6pNYmWzMoKJx8M4kT4NnZYmYfHkdUidLFIlN0Mjg4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5kkAYg9-na5nfq2UuLnMDLXKLofTbl8XLchIGpSc_7NA&oe=6A0C8A04"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uBLXgqlSyOYQ7kNvwHLK2_z&_nc_oc=Adq6V0nW9Dtz0fNz5cOhRaAyDeOCCywlnL13-yJVpoKbqm9gNO28vO5799V80QwgAXE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5yaQinO_FO1u7aMKI-wbGUgXQG78s-r5Ymdp-bh5428Q&oe=6A0C8650"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0OK_5tItbVIQ7kNvwH9YLr2&_nc_oc=AdqUNbWQw9AaJVQnySi1tMcrzGgM4oNtZu5HKE410De-jfjYa6Lbo5zvTprF8qXXw_M&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5QidS__xSt7ocAfx5PFxXAorijWyJL4e2kHHfUG2S6OQ&oe=6A0C65BC"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Experience profound emotional transformation through the rhythmic power of trance. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url":
LXbjZ2BBDAftH1hp8EyLhkA_VvwaW8Uw05-LkOea0jrB7iBUrN_p2msctbA8N4I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOumWyEHnmyXRGO8bGvwYU5A5-zQQQANmf-I1hUshxFUQ&oe=6ABFB217"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-b_10HaGXOYQ7kNvwEtGO73&_nc_oc=Adqv5eqDhN6mcGYTPo8NI4C_5dPIPgTCQMG-PfKy0zkgaFyWLvA8XxyBNYuMlQZOiIc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNqDM2tekQ15J6ClBNGFn7bCXm0PBQeKA9tqqQ2QNkv0Q&oe=6ABFC11D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AXjo34frybwQ7kNvwEfnAsN&_nc_oc=AdqkLKU6u7jijQIXvA0-kzfrToOaGNEnJKR5snfqMlnRy813ef3k16pDnPSWbAIS5Zc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZmWCWZVTvpLlk0A8fW3cWs8LvWOtkiT_sacVKZTn2HQ&oe=6ABFD604"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G3wIY_uumlYQ7kNvwEQqMVf&_nc_oc=AdrMiQQcAVzD03f7INh5bXL9oWmhKItZTYB2AfQmCv4do6jZql6SO-JNOGquDCA58R8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMlr2yY8nbiSs7jtCXlyoU77lFo4zBu_goytaVrngm1wQ&oe=6ABFD250"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Df0PC_cPIyIQ7kNvwGsuavW&_nc_oc=AdrjKAM5RSMyU7-5MzCOOyq7DJwSg_13NgmItuEXUsZ28fHORAEYbm3QmoWvVAuXwcY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMdKsK5ZbSOxBPA4GeIxLYri1tHMJX9Zs-Qncba-UEOMA&oe=6ABFB1BC"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Get into your rhythmic zone with Rhythmscapes. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url": null, "website_url": "https://rhythmscapesvr.com/", 
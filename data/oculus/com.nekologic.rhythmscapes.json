v9eRE&_nc_oc=AdqdRqoUWE0HY3Q7a4bD0558Pv8NI_-g5TgNX3uFpwrM9DlUej4xSQJSkBUf1XtHnqo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPd-JiwFNyA-4EpsOLjqW1Oaft_nqxUxJ4X-LEfa9pk4w&oe=6AE5ED97"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Y5C1zFNOB4Q7kNvwHKCaJ6&_nc_oc=AdqLW8UIIVIswYbBu_rV_VUSqoriS_G9URQ3_EPlW2NvNoSJAMnYaq5aPQ0Cq3aAikE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMGqM9RidWaJjZb4eZ_kKXbOQU2D4sORmdGCKIoTwTDVw&oe=6AE5FC9D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AQ4OxEiCdoYQ7kNvwG50IXi&_nc_oc=AdoCnz7VvOh32RiXGj-bNAqFS-C-3QqLBqIhbLVPRt6LENXtNDzOZBe_OrOjAY2dBVs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPfz-sagCCRp1znkPuXKUupWNPItMU6cpQiSYe4EwQQIw&oe=6AE61184"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QCflYTk22TIQ7kNvwGYwUW_&_nc_oc=AdqD2WTRtVyWJ1DUzNQdbOhqOXmkoZXZSCaVolDf6TuUpV7aBmKCSzd6oqLk-oru82c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOmHD6JBq9P0Wfr-Iu7zi15NtLIutzy99msCqzXGgPjcw&oe=6AE60DD0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OA13HRvSed0Q7kNvwG6moSv&_nc_oc=AdqymzHQqnXDD0C4Cbi295q0hk5VxjhFODZz0TQBcQjAl6CNydAA-5s2CXr2Q9yIXFQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMd6EnRK2du0FrlrYiv9uFYFk4-QDIghNDj8vZj3WVbrw&oe=6AE5ED3C"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Experience profound emotional transformation through the rhythmic power of trance. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url":
N5AYgfAZnB1NS0LuIllBkTX6-9i-H6B5bw4yX4Qn1PHoL7gANEcBonRv2pXaRAs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6IqGqotoYUopWB_K8awYcD8W4PTY4-hcP1l1OgTqKtw&oe=6AEF6057"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SCTVGCrcLyYQ7kNvwFkCEBZ&_nc_oc=AdqZU9AwQdYU_IplZ84R6KXkDE58LxKqzPN5auI3pqnwmtISilehtAFQMd0Y_jPtoxU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdXFvOqOS9PX1I3a89UWehw_xFyVPu4ke9xXP-3Xv0Ig&oe=6AEF371D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5PMd7tVv414Q7kNvwEj095d&_nc_oc=AdoSMex4Gtvl8RbBXF_J8lrj76m4vXwaPfkH2wtB-n2fo1W8i8zG4R2bUcB9Z8JEkJ8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSeqbL-UFMReNHguOdcmM0MJpRfF_MPe16zsjfAQCo9mA&oe=6AEF4C04"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wM1JjFmJ-O0Q7kNvwHkqiY0&_nc_oc=AdoUBQFWl9Gpv6q9mZbgnmCOMpCEvQLNiUCsfI6ksqsKzQD_D7iR57gKvcttAwelBTs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSy-0SHzozAjnJhn2vSevwb7cHjxUfdpBpwTWsSACC6NQ&oe=6AEF4850"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ygq9ZNNK5o4Q7kNvwFAa-KF&_nc_oc=AdpJdlr4B_Dx2MW5jiAJztyg1Wd_mKRdfiLbpwJbi1J1P6nT47Xw5UJhSe3Uu_xP0ZQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBLCjPnR-w15mGhuyfvoOLxHlUL0iOCggHsT56JWYmGQ&oe=6AEF5FFC"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Get into your rhythmic zone with Rhythmscapes. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url": null, "website_url": "https://rhythmscapesvr.com/", 
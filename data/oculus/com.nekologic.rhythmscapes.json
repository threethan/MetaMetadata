BBvFD&_nc_oc=AdoLWNE-XNCA8_TRB9hsO0q7QcI-8JkOv41jp7b7OUQt6O8EgCDR-Ga0oe_a-fQnG0I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5lmWef_DPneTus3tk2U6CfcbcC515yuoBzvhDl0wQDNA&oe=6A1EDB17"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P-F0loL3c74Q7kNvwEKZXWQ&_nc_oc=AdpyxKefdih9Imxtil1l2DOFwM0rMTNCy9HSaqAfwyD5k0ySBlpBKOMV4XP027dPbkU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6X_gkCq-x8iyLgCJ2IqvTKW9iU3tnXwamRRYfjvFjWAA&oe=6A1EEA1D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C0lde8MWTaUQ7kNvwE_Bx9_&_nc_oc=AdoF3Hwzk9gOsGf5brpKwApS3Izni5LSK7DZZFkStK0Be2_WyvyWduarU6nIMyK5RCw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4YYvoIhTsV62SlJr0BkDA2hnmQZDbllzhQExmG1-m4eQ&oe=6A1EFF04"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ByNcKQbws-4Q7kNvwHBNJ0t&_nc_oc=AdoFNHN390tbFb31-SQYk63glValRjZXMS_pCPHu1Pzh9lp_NeIdemU3JEF0OH7kvjE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7kDKLsb0NePNHwazkO7q5OZQtpEVip_XOo2GH3PHmTzQ&oe=6A1EFB50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Ri0JrPX_1oQ7kNvwETZESu&_nc_oc=AdpE9WE81zqRRVDRzT7CoFtJJD50aCCTVfBiIN0cFgMRF0TmtC7TQNtm9-iZ-qOLLZ8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6m8kB9l6Kz2hsXx3Qt6neqIyiGu9xzIY8gs5xYx1ostw&oe=6A1EDABC"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Experience profound emotional transformation through the rhythmic power of trance. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url":
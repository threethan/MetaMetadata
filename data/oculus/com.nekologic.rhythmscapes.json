c_ohc=ly1a2H_ufU4Q7kNvwEx4CRK&_nc_oc=AdolL-BZffFKVY3avhU0NeVtmIak1VYU3NtSuifJyyTaUS8iub_e5Pu6zIG9pdirTXo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEUFrwqy27NgDhAuKPAoqjbs0A9FKtVPX_DToiq6RnDEg&oe=6A8D9917"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OVUElsNTLRQQ7kNvwEnnMVO&_nc_oc=Adqu2t5ww_H8WqrNKv3o2Mu-_UE3803M37NJ_xJT6atvLrksYKmmh5-vtm4nPjn_e4o&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE7MoV6kSLexXK_-s36Fz-NOH3zC7wlWV4d8NRuivl0Ow&oe=6A8D6FDD"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qnGhdzztppkQ7kNvwGSjuN9&_nc_oc=AdpYirXol8t4o7ztaFEtN7aSA60QCRnasRAuecSZ9iObgRhkavySVzUKX3zSIFT7-Oc&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBSxB2BYBFwNuAN8Vxa4AkIFjmOBieetItQW_KeJAFSg&oe=6A8D84C4"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uEPYmxDTHSoQ7kNvwFL1jcj&_nc_oc=AdpZoE5XOWMXu9xURwfT0eLp_cLnn5A3XKICWqgHatEQD4KO5uL4xBazTwi8y2nP4lg&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6nu6Zj2DT1mMYjinxC99HhWXqdTUR0nPAcfeovhwMLQ&oe=6A8D8110"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E7FBasCvYJcQ7kNvwGv_U6q&_nc_oc=AdrEEAaloef9_lkSBiu7FnOxSx5SvScCK223JMT5egjD8oGo9W4rL_c473c_jlhKE24&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7yOVlx-T3MY7vcicLGC9cXP8JMwtspMr1YssonRL5qA&oe=6A8D98BC"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Get into your rhythmic zone with Rhythmscapes. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url": null, 
X8ZDS&_nc_oc=Ado3KowKLb42WOlhzOuFZC9pS01-rPShLibLdP1ELSSBndV4OHwOOUPs6GldjsJDxt4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXGRX7q-Qg1wAt6rG_ppYoziMgI2MuNuIfaa-YXO1Ihg&oe=6A54E897"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P4o5JKvjOvkQ7kNvwGB4hZ_&_nc_oc=AdoTDCuNkIqhLzxpYPQgMbpr0VSe7Y0su49O44M_tpGepHawA3GestyxcQfyzSvP9zs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQACkHFAfouLvlYCtFjziFcpgow9EglUBkCjAghzXfm8SA&oe=6A54F79D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CT68CCjIF4MQ7kNvwGFOe16&_nc_oc=AdpJtCIexk9nqrJveTAcvn6MTb5RqoAj69WcKajYqgGcCjkJQRtXNp424VAo3QiI-ms&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD72IEE1Pou6Oz8WrqK3CA6Uv4NouKFAZ0O10xfDvLW-w&oe=6A54D444"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZGJGnw2rzYAQ7kNvwHqQblB&_nc_oc=AdrO_-s6KOCPUxMXuZUpQFqHRhNRnrKszwfFHx8xpd97F2dKKiP6PtfF-6bQNKfPMk0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDvruz54aEhdKUl8cdDWnviwQZXMCTIU6HboghB08sQLg&oe=6A5508D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tpccbSG7ax4Q7kNvwE9WcrS&_nc_oc=AdreHj_n-rBF386KJWpFlxe6HFg0wRdbWCkkejXx6S9F8VX2Nhf2RKuOsVFtxpCFA6Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBgDNEjHEKcDp746yXwT9ClrKI3kPXhQ47R8qmnN1Yjsw&oe=6A54E83C"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Experience profound emotional transformation through the rhythmic power of trance. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url":
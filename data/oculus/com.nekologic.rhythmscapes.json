kyJ_v&_nc_oc=AdpN7sJacKmqi1sxw56wUqb4k6TlOEQXFDAxz6j01JsRmpt77euHt-AMfx4AtNldf4w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Xuj_WGrNCqW4i6FVxf1IxZzI2AEaGSdoqWKWILU_WqA&oe=69FC9417"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ASQD-3ndbiYQ7kNvwEDYb_t&_nc_oc=Adp34TMP6wCM0x5eLO-907lFWyTlGC1OnRrk63GuKoU2EOh2Q2hWKJdPWDyy_7s7RGg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Gr-leSXd_UhBGKx7vpgPoK1z1gAo-KJLYuBwJ8OUfYA&oe=69FCA31D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SGGq5_9w9gAQ7kNvwE66vvc&_nc_oc=AdqyrE0tMdvjbrtxNrTD6fIX1z4Rg8Ju1ulKQqy2F3qg20tuL2kohTXOf19efl3X10w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Q-vUnqEs1CMbJ_pkyFRIeNEs2VFLZScUSI4PAfXlBNw&oe=69FC7FC4"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ABd8NTEVxmcQ7kNvwH7xX4F&_nc_oc=AdrXannWHrHjxArjUBCjyJ1R5WgiUU4f6NnKlO2swGsKZEcK9xYKS7BxZIkXxwiVVwo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af65rv_vT6-b5SdJ8ia7EUNQqNmBZJEJ3_T3zPZRSCvStQ&oe=69FCB450"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2MpS_BlQVzkQ7kNvwFSk4zB&_nc_oc=AdqfIYLkgH4SNHXjuCDPKooXrviDq8N_Z98eKFQ662xeyPsLzYwZwFAC2Mrjso-RJ_g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7SkqOsC26_SDX9Ovv4Rh-65YFEfZGy4On8hlxC3-m9mg&oe=69FC93BC"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Experience profound emotional transformation through the rhythmic power of trance. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url":
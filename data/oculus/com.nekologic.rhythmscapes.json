NYak4WdBV6-bUkDMF8P3LSvcxijCXqboYqRpDEKJiJQIe_pFOj4BXLDLMym8vGk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWet-iXvZrl5JMiA2T_K51Y6aCwqkboSDvfS-KkW-JdA&oe=6A71E997"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hwGqaazhe24Q7kNvwEZjTaX&_nc_oc=AdqIqQBhsNA6MUgeIa7tt72YWKCNvjV8NpP07OlkfrrgdhCmtO4lTgIUdszZFrwwmnw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEfIvRXgLTpKmUY_fZvyKn_5VEPWVnuKYdLg_Ere5jTKg&oe=6A71F89D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZiWscMiw9VAQ7kNvwEOEIfk&_nc_oc=AdrQXccc5ndEpmFnP5xka-XNYKZFXVPbj2oNJwxW3aYOA5ssYNhj8CPi8QlTZpUawZE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7OptR2yJfkjqUZLF9vQYzAFd6flV6LkrKXY9Fc-WhqQ&oe=6A71D544"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IFZ6gYc8QDkQ7kNvwFnNFM1&_nc_oc=AdpwSbaexk35djDq5UORpIce73Av5ZhRoYbbd_kR9shjoUiMLTcr1aDk2tlvFE_lwz0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFde76y0Q9ChlbRJv3oTa99wpdpQst0TKWVwEaHzFiWKA&oe=6A71D190"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=af_NQpy1htoQ7kNvwFMXzg1&_nc_oc=Adqliaww95w21FZl19Vh59AE0ufv2s74-YKmgnk3nruvFl_ehR60aF9-GtLbLJAaGBM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQENe_FjOwJoMaeL0Lg4V7inmPWz8YunMmYAycw2X0YqcQ&oe=6A71E93C"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Get into your rhythmic zone with Rhythmscapes. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url": null, "website_url": "https://rhythmscapesvr.com/", 
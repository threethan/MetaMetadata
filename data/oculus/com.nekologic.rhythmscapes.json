Kn_gx&_nc_oc=Adpuc67GaSabwjf9vhQuxObpBEPIGQ2Gsl7uutynmr7zFBBGIkHe1ZChYsD6HxPMflE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6KeGLuirvk8yqsEaY-Nlu9VIjJfRrvZiy-nFTD_mo_Eg&oe=6A05CE97"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zb0ljVu4XAsQ7kNvwFNZYHR&_nc_oc=Adq6Xhm9NjS7fpgpstvzxFpg2af9nGs4NhznRV3ortSAP_-4FK8QDjpBmhE3g2cg2-o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7lAEEryQggllAkMm7LmkGge6S0pEeMsglN-wwtMqwyMg&oe=6A05DD9D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ot0JzenbGNUQ7kNvwEQpUg1&_nc_oc=Adp3A-TJadMuyxYtRA7SM3VEA64jhX4r43QAaAczTi0r-iwNURloWZS8SLvds1QZ7wg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6V56sL1tOpS8qKZYmY-dcEoki0O8jiYYZ0YyYVPYACDw&oe=6A05BA44"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f6VovLFRxhsQ7kNvwFJVH_K&_nc_oc=AdrmAWuS4XwL9Wp1I64G6L-5Cj1RA0UoPf0uP5LzTNH6LXg3HJssTCpepSK7ot_88M4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af47MImxbOCAhutT7so7kMxFNozVqg_RJMBVDEgxRsHUlg&oe=6A05EED0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LePPRAAqJsQQ7kNvwEp05C2&_nc_oc=AdqkMLNH7zGWqZy_WTwJ1TgSpuGer5LHSwGRBT2wBQPO7NriWNF3TBP0Y_WmsxyNPXo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4lVKQXU7DSLQZj6psEb4lS1ZlFH-rcot7TD57hK5LykQ&oe=6A05CE3C"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Experience profound emotional transformation through the rhythmic power of trance. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url":
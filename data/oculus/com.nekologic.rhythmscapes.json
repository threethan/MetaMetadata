c_ohc=ly1a2H_ufU4Q7kNvwELQP9D&_nc_oc=AdoKyws-Z23J7ZYIe94Li4SeJuB22d7ClpD6MQlBChZbSXjqabW7nxjALxtI9Fnpl9k&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFMl64zFFdR8dWChogBmSuAUrykYOD8DQcb1jR3cImzHQ&oe=6A8EEA97"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OVUElsNTLRQQ7kNvwEzpACG&_nc_oc=AdptsiIO9-bkmf0F6cetfw17wm2Z3auu8RjooHCTP1KCJSYjRluJk-CbxqzFRl3LS74&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFILI4i2jQAUR_8Fwrs92lrBsU81vfMyE1oCvefNEXFOQ&oe=6A8EC15D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qnGhdzztppkQ7kNvwHU_xlX&_nc_oc=AdoruvBIRDL0d8j6XfviZaG7yj5ZBVQ9kPJ5Ck8m58w7gumUIZS3uSt9XheLa8V1cZQ&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGBKIXjiSxhb51qwyCO1jlLjg-pjLqQdRlhSExpfA0qFg&oe=6A8ED644"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uoXe8f7Q1sAQ7kNvwEru-lm&_nc_oc=AdoXqDmPjQZYzCdZtm5_TdS-M_RmuSt3ePyqZJ9VnHecY-5JIFeb8_BqDqtegaE1dJ0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFInkuUjKJR5c2dg9iHBI3gWMa8lGrjILnEFGvXNPkXKQ&oe=6A8ED290"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gm7eBhr03vMQ7kNvwG2XeTQ&_nc_oc=Adp_0I6WYlZvGQeUQ2fb5mm6A0VN-YLQFjmVzDlrcRvTSHX9YCNNfyvOb7XFaebJ7CE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOdb7lGvt305BUwOcDDn789NAsXX_rulvLY_57AQPUSw&oe=6A8EEA3C"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Get into your rhythmic zone with Rhythmscapes. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url": null, 
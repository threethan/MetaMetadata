M6nOE&_nc_oc=AdrjBy9RHO9NgbHXsunjgNsP2d1kYZ1pIxdXXZXCETMvU5XqbKK79YXzEFFznyhSUIQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKDYfNGLNtMhpUs1_LXprTygGf8c5gR87iJEF3xZBxeYg&oe=6AA55417"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bSgftQUWluAQ7kNvwHoEo66&_nc_oc=AdrzMPc3r_hBp3B2Dc5JLB_oO_4qqezY2N-k2xGuYBXv3sLxR9B96PIEU6vaETJSYEI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIsPW8JiTgBXZtEiR5-gjIE91UVa8nl2mdDcpQJrIq0Ug&oe=6AA5631D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EEIkIeLYATsQ7kNvwHPfHTN&_nc_oc=AdpQwt4KxXTtU7D5uhugcNZ0Cfm9e0zx9VXQRy7J-Zu9Snu8aVA3GKXx4kKX3mKaZOc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLlWFXRPfTq0hC-ZOhv0ctKaOZd924yktEXQwhAXcFMUQ&oe=6AA53FC4"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yTi9Al_ti1UQ7kNvwE_7Y8d&_nc_oc=AdqbtNT-KQe9w4AvsqUWQ90PqQFqJRGkam0EutcjMpz3OyyRbnuiI_XQWkEzeCRCPYQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFbx4IWIzCdY2N6pPNhL4UICWzKKA1sDXHpPdS9fNz6w&oe=6AA57450"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XFYRxAqS_PQQ7kNvwEXquG4&_nc_oc=AdpFUCJTbVTOrnYDyTgQr6QxuLAowHdF-UgoVdZlum9uwK1SXYf9c2p6_J6ho6hNZRg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLMoqy7faw5aHn2lkyq-u3Bmi66uduz5GFm9zwSwq4plA&oe=6AA553BC"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Experience profound emotional transformation through the rhythmic power of trance. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url":
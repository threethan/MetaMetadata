tMtYv&_nc_oc=Ado33DoRtBksov0zVqiNZHHWp71a2npHsxEu-WdGNhU5rFrF9QfSYEHY4VuCp-F7IbQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx8d6LLlY6o-VW_Xo2VxuVEReKIuExLC-YTFk0aG9IKOA&oe=69CD1E17"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U_aL4Ty-I50Q7kNvwEn1wUB&_nc_oc=Adpoq29j_wVFE6qJ3qhg-xLaiuS6Tp8npPGL1PpOrff_GcFEOnHg7wpnh7M_RD4KxL4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzD9L3pRVntHM6aiknmGOe_BpAmlZGYhYzSAkhl8378gw&oe=69CD2D1D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bCbgtnhUt4kQ7kNvwF3O2d5&_nc_oc=AdpQhxPlpdJeFTX9q3oCf0EcgDybs4HhYAaG0HuhsnXdAeGMr_s0s9SFCaMdvkexgPI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwCsSluVASGPUWEjEyCbyI2jKPXKSo-imw-4TqyCtn5BQ&oe=69CD09C4"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j3u18v3BQwUQ7kNvwHYimD7&_nc_oc=Adpklvl_dEbrA0YtFSFHgVm1S30AseMfP91yaKOgoiWbOK9GmL-6eJFdPx1zEUPp8jc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxOQvTOIOIho-HMqOvqPIG4pWlsY3TdupFJ-pA7ao7JPQ&oe=69CD0610"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ls4Sdzw-W3EQ7kNvwEhYY67&_nc_oc=Adr7Mf3BItFtrmY7p_owXIrUz85-0Ruva7Juv9BM9UAI6GpaDbqz4SHdvGcrLqBN3FU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyIzIjmRxHbCRt_qE6tJlbwztx7qE-qc8h4ymB6EfuH8Q&oe=69CD1DBC"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Experience profound emotional transformation through the rhythmic power of trance. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url":
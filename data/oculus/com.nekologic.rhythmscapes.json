8t5ti&_nc_oc=AdoA1g22zims1sK79iBEhEDZXLfGTzcaDCNP6zGlM8pR5LKshjU40tTfVWmTNG0RYhU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEz5fG1iYH9B8C6GbyRLee2z5rR4k8vmMiNDnbzJ7T6zQ&oe=6A748C97"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hwGqaazhe24Q7kNvwGgrFsV&_nc_oc=AdqSH8lGZw45_Hk87o0a7Nh3aDoxWCt6y29ecwBQ9yQ3FvYeDxteO5tX6l3DfkDRhrc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEIkVxcOZYhgqHKEMQDl3WdA-SCxNw-_1OnPi6Jkt9lFA&oe=6A749B9D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eCTkkOU9WB0Q7kNvwGda8c2&_nc_oc=Adq5lgZxZPxf29FkbIBaZboyMzrafOVXfb7ZyZ_TslQ8TEwGw5LTU5iNNMrmPkxnp-E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGsEKcDfyjeN3qGPmACyrK2ET-lRkLmluJ8cHyPj8EYLQ&oe=6A747844"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IFZ6gYc8QDkQ7kNvwHOIyi2&_nc_oc=AdqFT7-Nzoi1ZYMaiR6-TYxsWBIEz5VZyTi97zQnTc6LljUNoVM5FwMZyoXE2_plkCA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG8a3aCqcikm77uDbvSb6ImPZKKHeO5xC1w_QESON7M-A&oe=6A747490"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-oHzzQLk7uQQ7kNvwHxRFd-&_nc_oc=AdosNgC95teGT0JOVuhM_vI6PLlviDF05iV_hnUeOieA_maGtWEM12_WUT4Uv6ipDOI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2ecEgEzPTzHytwd9e9AeR1ABe-YRUY0byWKZuUA98uQ&oe=6A748C3C"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Experience profound emotional transformation through the rhythmic power of trance. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url":
k-1cs&_nc_oc=AdqnXygJb2C7V1iulD0rbhu2OqGLTNDQl-9bxPTuRhafYUjcRtmEhr0_YZCQRHR7seM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8a0fQnXvbvQkTaHEalieC5mEAQpPHeWo2Kn-quWRKv3g&oe=6A257297"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QmEfv3Jpdn0Q7kNvwEYnnUR&_nc_oc=AdqcCXlznYapTr2k6yFHXVzpy5HbRFJyjf1t-yHVnLq7WbqWz6D8XJ9RygLoCR0sh_8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8hGWQDloHRqns35mS1dh7kbNaggm1diuQLmxMBj7qPjg&oe=6A25819D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h4BSJZ3BXYwQ7kNvwEvVrRQ&_nc_oc=AdpmpnDyHeBIEJgRLIwGPKByhg5ImOjsljczIEoxoiIzbyJDocYtIbaq8nlqm2UXUMA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_OTdMjThya5g3c8P1waGy-UBxDLUoPgHqNcYrKDeOldw&oe=6A259684"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aQUyeIWJIe8Q7kNvwGw0976&_nc_oc=AdqeqAyYVo9_l6m9lPYQ4tykWfMgua7lsrmxQS8dFnsC42Pa69F18rVzzeC08LnzT-I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mimXAaBhmpKkjCCCjXqdk86jLpL0dEQk8Q3UTWmIXyg&oe=6A2592D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XigWoUc588wQ7kNvwG-mXma&_nc_oc=Adqsu3EHoGFb34s4733nKxeEulvWxANbH4p-dWOHuU7pi7YKGCT_JCbeJhyYa03eGQ0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_cWILRNSLONi4YaYKJt5AyVsJnRx4qAvQx4Bkz6YVGnQ&oe=6A25723C"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Experience profound emotional transformation through the rhythmic power of trance. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url":
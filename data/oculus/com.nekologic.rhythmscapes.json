-71CuEv9RCYfV0dwdtm9XAHoE1QPyF68qAYyNr-8Ynn1xXDGBMpFKjpT7ud2ep0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOrZARhOZ_pXDiVzsuwH0-xgiowqpf06rIZmosGGNsh2w&oe=6ACD1957"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zs2B8XKAoQsQ7kNvwExGQS4&_nc_oc=Ado_r6VOLpzFlSPjgLuOR33d1t2VL1ApxFXXRy7dxqJWUdzM-GDVrhIjFq0smjIZzvc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNfelViz9ZkNpxuUrFnHKARDQAzozlI6ZRDkpDwGkRRXQ&oe=6ACCF01D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EV4uuaG3vuMQ7kNvwEI3MOF&_nc_oc=AdpxxDG-D9L8SCOmSqSUCQEjWZe3B4eGmKOin-PxVbFLaKfD9tA_OLhoTd5BEW8bmI0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdxk4E9p1qakmAl0SNhJAASEHE03RkEXoQLLV-V4UIjw&oe=6ACD0504"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=URfJzUazw1kQ7kNvwHAmHZ0&_nc_oc=AdoF2n_qGG6k-oLcStEraf3rb2aEw7Y7_x1AG1Xmh1lbMKIZxm7mw2EMVRoBcp-E7kQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOjUQmCVj5UPYSHH457NBxZwZxydp7WpCe2Rw6feFHK4Q&oe=6ACD0150"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q5C3ZcVvt9QQ7kNvwHojWqk&_nc_oc=Adoy2JFv5jGW_ybIJQ-y_NDNKCdFJnTslWx6LstA0PdqYv8bWCxdn8pt6W5quj-AeFM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNYf1e6Q4d9HS5_ju1sskTISfDlIfvO0sU3iY6oxbpz7A&oe=6ACD18FC"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Get into your rhythmic zone with Rhythmscapes. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url": null, "website_url": "https://rhythmscapesvr.com/", 
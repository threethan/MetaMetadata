n1voKfMzNC1dbfkuTdLbdHhFLkURQ_SdZ5tF8tQ4HZwSJ_rPFbT1gx8KTOtjN8s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Js9UMm2q4xPSyCXhTS5SZHjdsbw-07RwGTRSQVDMELg&oe=69FF3717"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yoUtLPq_TYUQ7kNvwFJP3b5&_nc_oc=Adr8ASdqWVnUiLpyt-f9wtNGUI9BLSZAKS6PVRe7V66szJCZPh6IV1OutaVD1AduN9c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6vQDlE8UBXcjwp_hqZXtgHdt7hRNriZ-OtCEG2UDQFLg&oe=69FF461D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dVTOl77bWbkQ7kNvwHArzgC&_nc_oc=Adok1Lb7GFJ37KOSHz4Z6rhnrWbvBovgXpzATWQLGaxFx9y0QWTtXId1vaPLK_ed2MY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af439zIiOdUUcBpFglGbho5NXLbvPV2syIYGkRDyLkxeAA&oe=69FF22C4"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aPOAonVpCtAQ7kNvwHIqPxF&_nc_oc=AdqlCyoytpHZ3ImNiaM_QTxHOlbSZxtZm2-iZd82p_pPahACX5L6gP0MIhrQucdD10Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7heP3sz0CH2G2vJg4LP-P9wK3JQFIk2PUJRraoYyMFhQ&oe=69FF1F10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2MpS_BlQVzkQ7kNvwHhYHao&_nc_oc=AdoD4Ho_R1gYydvIM4rE-pc4wtpS_8hP23y2fbm8MWN6-35faHRDi5TK27dXNdaKE0E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Rtda-LZmWSBbA0k9d4Gyio4nTxRhv8QcXnGiYJXaMeg&oe=69FF36BC"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Get into your rhythmic zone with Rhythmscapes. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url": null, "website_url": "https://rhythmscapesvr.com/", 
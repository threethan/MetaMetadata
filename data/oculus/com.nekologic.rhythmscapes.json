0f&oh=00_AQRfiHeJq_VBg9fjUCxsjezoyytDpDH7qU0PyPBs3viwqg&oe=6AFDB628"}, {"file_name": "Rhythmscapes_screen2.png", "id": "2505250019672482", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031466_2505250023005815_4528446742983552236_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iigy5feWtd8Q7kNvwGarTXj&_nc_oc=AdqKEkf7xSjp6k-EpmwwInk-BuW0cg5DecJ6G9LUoiUzHw5il7UKfn2ugfYTVUHykSI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTT2hKayA118aA8q2nHgHBsIqhGErf4ncb8UBmDOOiGhw&oe=6AFDE0D7"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AmM_GdtLGUAQ7kNvwHtfLo5&_nc_oc=AdqEsAC2a4U9Nc0Bk7qnPbl3xELUKIM3T-_1f2CPPKHWtXBhOhitLgGR9tnCkOIyIg4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZ6xwh1lySgUOsZNB_N6Ev2BKeU0yYvBXuSvJB81I-7w&oe=6AFDB79D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kUnKew_j-UsQ7kNvwHh6kEC&_nc_oc=AdpT_uHwc_dWZ66kJulv-FeuUsgokU9HI2JGIeOAXAcD1WUKs1WzhkVz9PPm1cGEvPA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEfdWDVmLDkZ8eevMLTROxdT67YV9Puq-ByY3G4EFjAQ&oe=6AFDCC84"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tc-AQDDtJhgQ7kNvwHnq2aq&_nc_oc=AdoTrLCW0bh6zvtjcMqGdS6qPDWgRei2ZXiO_kD-bDD_aTZlTxKK_giMafKQkGchxs0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSqyY6hDTKLMhLRsgi2yf37-SnFwo3eU8sUIFE7VXfHaQ&oe=6AFDC8D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2T-wuX51jcIQ7kNvwEQqGsz&_nc_oc=Adp0EoTDe2Eoje81Xu3LrzQf8ohNLU41Btbg4Bb0uBTu38TB7ybKSor9qecbWWBnesY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScO0PVqKxy-j3WccEe2Wf8JDsUMmbZWXh1nRWCfn7XSQ&oe=6AFDE07C"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Experience profound emotional transformation through the rhythmic power of trance. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url": null, "website_url": "https://rhythmscapesvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27040574462255000"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86621379_2707225349453785_8060006403237666338_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FoU5Wl0XM-YQ7kNvwEXUeCH&_nc_oc=AdqqF1UgXuL_3sXGvgjELHEEcGhgQerKROroQv0uU9r-iXOXVlv-kU-zDu4VtKaJ71Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUycgQ_Q-hN7my2QZnJOluEqnA8TKXFEyUT8g6P-eJ0A&oe=6AFDBDCA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Rhythmscapes", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Rhythm", "id": "1672577396871977"}], "release_date": 1729842720, "lastRevision": {"nodes": [{"id": "
SCY14&_nc_oc=AdrPNYDZcB4bm9VK6CBd-ifkn8mTIwAry891EaYeZsnEnT6CIjXr4jyYEbxQ8qUpTwg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af771kOiNBeVYorZ5LGvUMbxTPCD7TeW5-DuOIsjs0_yJw&oe=6A144F17"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=so9rz01aV-IQ7kNvwGsMbHI&_nc_oc=AdqN9TWU_oUsJ8QzJQuYM-kRwTv9Ockggbv71xvC-6kIyiEjyQc3w-9DAaBJvYxmBNg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af77Uq_cUMQ1LlCRDj-iJ0Vo9y_AfMiH-xM1fYSKSX3JIw&oe=6A145E1D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yKhXbS3PDyYQ7kNvwFzilJe&_nc_oc=AdqV95_x1jsImfbhQ9OjttDuo8nUZncn8f_iRdX3nLc8FhZZwWJ135zV7xSbb5G0WjE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xjVd58AzvTTx7GXtEgWpUYeednSq6TnYLViGterZfzw&oe=6A147304"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Zu9etGTfUcQ7kNvwFMR0TM&_nc_oc=Adr3L2uCU5qtFbkc5cGuqQZF_Ecmjoy3Fhar8c8ZBGRcybJLuvLKq4jTUSVHd9nehOE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6wB81vbSApFZYyCAuEcK-FOsyZcQ0PRnV6IHtK2VOWsA&oe=6A146F50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b-wwv7_xEmIQ7kNvwFsoQIs&_nc_oc=AdpRqfHkwNMJLmdKtgtnl4XOewBj8Ex-2Gphr36IeKMuDo1hooFOfb7lh8kH0U-ZVbU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af78Qwu-p5tl20zgKBDC5QDrVMPQnuhl8ixqWavybpMDIw&oe=6A144EBC"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Experience profound emotional transformation through the rhythmic power of trance. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url":
bzk9B&_nc_oc=AdqeGfRhe6Kdfubd0wuelH0_nhO-bhu_uJolqS3mV-0r8uY9GWC5C623Q7GQlE224AY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3s8zroJcRJ7w_f6LrBtECBTOgh_YebVY8xUsRGhiXWGw&oe=69D8FB97"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q_FXxZbeihoQ7kNvwH7Q8_S&_nc_oc=AdreqEqIV8iVFxJZRb_L0VMkveFEvghfkN4-7vhpc6bAfVaIpiZJdsHAw1wQa5b4dfU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3yrZLX87ArFOWKhsm8VrAk3dvNyxKpRrR3cJpPH5E-kw&oe=69D90A9D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nfCmGk74kn8Q7kNvwGp6I8M&_nc_oc=Adrxyxn81ZzRyj6MHXJ_b2APL4fUYVRZ5b1CgKWDs2S2ArL6OrucEU8SvG4VuOvyvcI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2PN5cq4KuR5kLZmSEW5zSszXQj2yz-XhcnXEhfLPAqKg&oe=69D8E744"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CsgDj2kFVxwQ7kNvwHyI0lu&_nc_oc=AdrkQpWOuGQ1dgAVmQA04_hElcTPkpOrVOacaWFe2vawaz54GDmhfgoby4UrZA4UW14&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1kZoE8kUrvu2-msNV6ZXuhCqNQ3fDe7t5R49RMKyLe3w&oe=69D8E390"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8uqMBUJpIRUQ7kNvwGvoe0z&_nc_oc=AdoEPLXvDdm8D4w9nOlLl4HMgTS2wTXxTb36gYVpA389i-uuH1eoNBIFP2YgCsbio8k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af207clQX6_jC62wFFz7p61NLRze5-Y8SP6kAMSpJNgBCg&oe=69D8FB3C"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Experience profound emotional transformation through the rhythmic power of trance. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url":
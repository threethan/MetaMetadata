RbuFN4UbeaQleBusaPk7GPOVilA0ly5fk0R7FvWaVO4V_8Gt7ZwomirYUa6yqUs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNpSRSom8sM8xKIyJk4EtYue9TqxL-Hkmy7-GJUujhWSA&oe=6AD3B0D7"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zSaGUM-cNloQ7kNvwGF1bIu&_nc_oc=AdreLw7rQyH5zj9KAIJLIYNGzVlO7NQRPzx2L9HKVJqkjpPovDHYnbgWIU3bKUppnOo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOaIzgVTU2t2V1uJxflzknIo_Sei_2GC09yuWY27p2uiQ&oe=6AD3879D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xlr2Q0VfowYQ7kNvwEZqOgw&_nc_oc=AdqyKY70pljVmJI3rMtc91q2Ht2-9EigvZaYX8T646Bs386zQjtZo_eEWxU3iZI2qmQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMhXr5AuBBXm1Q-jnaUKGvnYmagWcapbjrcbmyJbYlWHA&oe=6AD39C84"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KkXCPuQOHbEQ7kNvwECegnV&_nc_oc=AdoCbj8Sn0gQLLL9LWYGId0HoIR3OkVN3e7oX3trIHKrLCzda0L6CbUKY-wyZtTpD0U&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSC-De1aon3gvdgDbkcfSsdW_2yNzHgDMgxDeOWje_pw&oe=6AD398D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0gtpuM67tekQ7kNvwFhEhM-&_nc_oc=AdoIxXnfRKpruuA-OfUc_drkhCqDaVlTebIpmpuYma7Oxd1SiXjT-nj_KchEekWZ4og&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNon-s9v_2otJ24EKy4qVCwRvaXm5sxl1NYgozs8wviEA&oe=6AD3B07C"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Get into your rhythmic zone with Rhythmscapes. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url": null, "website_url": "https://rhythmscapesvr.com/", 
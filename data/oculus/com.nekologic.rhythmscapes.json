vwEXLrRA&_nc_oc=Adr8cFD2jJo5QEWmfwX9aZiIDCBvBwCkjODhJ2DvYwnd7UMSKIaM4w8kfSDIsasZzB8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGlH9RGWYurqkTuQX9-9TSW96MJkbcGC6ZlamX6QsL4eA&oe=6A7DC717"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sv1I1GnUHA8Q7kNvwHfzLSk&_nc_oc=AdrS2qbO5RgaP5EZ3A-w2Sx1CWRbGxFboCvRva1mkMGUNj-4-pF4yIrPOvlEjIz-aKY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHlOpBYddJ3OwZCo2KxkBlUGqom4IDX7Rm5TmCOyjJfNQ&oe=6A7D9DDD"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Ssa3dpabDUQ7kNvwEYgLBx&_nc_oc=AdoDjI49vC4OnP9tHcNHOCHe_YwctortWbqhs8tIlJGHg_O3B9In2GZNU95GGQp_HEc&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRYY040r5Qbo5cQTb18V5jxDXk-HT1YWNDUwqYnAWGzg&oe=6A7DB2C4"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yzwf8NguauIQ7kNvwErpAUU&_nc_oc=Adr9uQlxI06fgmQJ3lDuYMUMIhL27KbOipegDM5Tyv3eUM5wSvSSTyheBh3T477rDIk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGH7ulNs1hsy3jJY2q8frHF2PKmvzwaXAa6KzzDMbSV4Q&oe=6A7DAF10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pfGVo9QfeGoQ7kNvwH3TsAT&_nc_oc=Ado6LAtpn4dkklQI8091FnSAP5Rs7h21ZKl5xliSmJLVzngzJO1CwZzdIfCdOKOsJO8&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEC_D5cPbrE51negQTD5ir1XFs0gWvLMxyuuUii6HLFUA&oe=6A7DC6BC"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Get into your rhythmic zone with Rhythmscapes. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url": null, "website_url": "https:
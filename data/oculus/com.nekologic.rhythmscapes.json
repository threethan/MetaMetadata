_-Y7VtrwOS0dbr49l3W04iV6CZopdKlACRoUcmK5XTNSwh4bYq0FeA51vAOgXS4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCvJ1KaiBJ6GHa6WeoMLu7pwEYlWMlSYhLqAU2ub5nAMw&oe=6A58DD17"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NNgYgAzVEg0Q7kNvwEUDuyt&_nc_oc=Adrc71A8MGTdDeTWr6Totrkoft8y3-sZHVh6iHaz7m5DjrwXVp50DdVOpF3z9fNLkB0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDdJkBpLmxbD_GXAScKs7ykUu41zfXt0x-gNfQmFTuqcA&oe=6A58EC1D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GSCxnNyFAo0Q7kNvwEqbDU1&_nc_oc=Adrdg80F_bHA5Vgvi346SEixSIYHvNgUh5KZBui6ssBXn8LOZXb97sUwRC7GvKNgmFo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4DRxLbhxhM7Asd_HEKWfeB8ZI_m9WkFHq5ajs8yfHjQ&oe=6A58C8C4"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UCMmnwUgITsQ7kNvwGxqdRz&_nc_oc=Adq1Y7YrA7BIVAfX7ZgxZEH2VWMq7eXEtMjma7TW491D-wj0tt7c10rciiHKt1lFjpc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDyiyYTNr_gwDzSGfDW3wB65LXVjoREUrSpP6J6ZK-kCQ&oe=6A58C510"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tn59iGo3d5sQ7kNvwEaoKvt&_nc_oc=Adr3FU3W96BrgxWJ97_SCII_zAQuDIUQS7EgB3HewW8wfpV2LCq0V2PWG5QPxl45OYA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDeTR0e9ndGg3FbF5VR4wzvB0qU_UH254SC1CTxZuqRXw&oe=6A58DCBC"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Get into your rhythmic zone with Rhythmscapes. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url": null, "website_url": "https://rhythmscapesvr.com/", 
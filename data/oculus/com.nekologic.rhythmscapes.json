MRUxlDPDejVpfS1FX611WOxVPB5PgaKrUeFjhNlgwBVFzECiK3L0vJagcFYPDGE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0oNbWPdAuU5RUUlgCEKcw2SgdZZc0FIDW3uqQ-nwHc-A&oe=69EF6517"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VGZ_0rQ1rU0Q7kNvwH4ufni&_nc_oc=Adr07Bs0Kelws-AgC4diUMR2_VvM-kF2j7RlxDGXJT5ZOXMI2D1kSx-pozZo_1IzQK0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3gA1bFXpVnS3N-h8592WYVJAzmWMx1rra665bdVqBmAg&oe=69EF741D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6l5NwqAStJIQ7kNvwFjsVi0&_nc_oc=AdoMOof0pvyQTOIe7IwITT-KQPg3csZeIRsEUq7C0KwigkStfz6Z8O7qUbPKPyHlf0c&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3zC707wJPjYj_aoVtoiZPsmoWc8xfnCxKsee1ZPM5ejg&oe=69EF50C4"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JVPQMqMvQ-IQ7kNvwEPwM2C&_nc_oc=AdqVtlN84NME7zRzacMKE8Kcr8fuWFSqrOWlbSUud9oHy6HH339tqSzq6bHqmzQKOrE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af13zd_v3OHET3LfCGJ5Lwh0kd2b7AUxtjJ0fUVFm4VEZw&oe=69EF4D10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V5l3jFZx9lAQ7kNvwFbUTDR&_nc_oc=AdoWvYs8YcjKjcAI45vd2E6Rpn7gvQblG6tIVTa8k5ZvuSyOk1bRyxTIKJD5QVxwK_Y&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1vYSlNu3Y3uUbco22vzmlX7U3O74rLPvRyl1hY3VOFhw&oe=69EF64BC"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Get into your rhythmic zone with Rhythmscapes. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url": null, "website_url": "https://rhythmscapesvr.com/", 
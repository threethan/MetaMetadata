Xl4kw&_nc_oc=Ado9WAfK2msTDvwuCNIyJhv4cCRvGzWJFDjheLXSNlh3pVcZ0Jc0s4wIzv-Gll7aQXY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3d2mwSGzLRN-l7lb5nUZlyIDzOac4gnKaglqogu9KM9A&oe=69D3B597"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SDvCogg83boQ7kNvwFk1m4O&_nc_oc=AdozqZXj7ZA8s8Jauxm_PxBAwPrQToISB9Pv0RHicDY7oPUMplfKzMJLkGWWC5a-09E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0lcXBxmfF011iL557RBKJHTqjTNEQDMBZxOW5i8wVQaw&oe=69D3C49D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gOoQ-G5saEwQ7kNvwHaIO7g&_nc_oc=AdonAy_4e64ODjKumjemjNzOCqZOyWGThsZaYeXqItup2crG86LV31iMrPPhumNz-Ak&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af05657ZuczRpYR2huMyBisPx5IMrTR6pCh_TNpW5Ik_og&oe=69D3A144"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Ht71BC0DzEQ7kNvwHpwDfv&_nc_oc=AdoJ9xBak6iJMWdCfHCf2sVRXD_eP0CE9qi0q1gBTjGkYla7EjIAVpvoLLV8ejPigyE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af04dDavDK3GHH1HAMqv0cJ_WS-ok2svDsaXQ_WnbXF9aQ&oe=69D39D90"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e3GZfmJS82wQ7kNvwEEeFBv&_nc_oc=Adrjhc7C4nz6Dcy-tiZuOyXCmIrZBz-eYY9y8WRMv0_GqLqrEbMqmdWrIIWvLhyGObQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1k4hPpeBMtwPKkeWHPf-qKemAlcvU6q8MSpGaSetQHsg&oe=69D3B53C"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Experience profound emotional transformation through the rhythmic power of trance. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url":
&_nc_ohc=7ztXv3O2GUcQ7kNvwGEXLcf&_nc_oc=AdlhBKLPcDbVqL5UtBr1IWAEmZMlxJ-RNmp9iNbdSz8f1U9e8Ax55Uo33udcuQ9VR48&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfumDGamfjCnsGpOIgB4K8RElro1srQIYY9F7uCrZ33zxw&oe=699F089D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1yiHkRPBwX8Q7kNvwH86EpX&_nc_oc=AdmAtgNRy3Ku0_LLMJpOPc8vJvhB_9-Pl45XpdJioMz_HqOFp69_yTzXuuNSIEOoHLA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aft-W3-lRxpPKeglsdubN9Sp3FIaedVEePGeSERs_TAEjg&oe=699EE544"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pk67rhtJrTYQ7kNvwFG_igL&_nc_oc=AdmqzF9syPbMI55CXaBLVr9rqt4N33BPDhwfaCW58bLoYj6Kh0jteLsHN1FqUlTjdAw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuW9E0zNKQ6ih2DQxT-JzZp3Ks5v1aHjDlIdoD5Pn4VRg&oe=699EE190"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QvfZAnsGeEAQ7kNvwF7UnTU&_nc_oc=AdktNdu_TENdMCzeWtVMsPlE4v_fjKJ9QISy5DKd5y6WQ9ynvNzXGqvKPO0hxS-Fq3c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuX0qF1ByoPqZZIzjqgNkoeWX9W-2pQxpYC-RxEPToumw&oe=699EF93C"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Get into your rhythmic zone with Rhythmscapes. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url": null, "website_url": "https://rhythmscapesvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "suppor
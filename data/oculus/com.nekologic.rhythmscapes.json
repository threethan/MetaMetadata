jl__H&_nc_oc=Adpe0zpKTP53Ex6qwxeSTM6zm8SdLi_W1k9Z_4bcWnoFo7O4YE0pV2KPiF-5catXNc4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7iRTzA5bUqSE3HoSPYF4RNV6G7h0RSzu2nSm9OhfpfYA&oe=6A1AE697"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NR4PlJkjiWoQ7kNvwFa7x2e&_nc_oc=AdrvU6cTVvLPBpZvQQSnjymI_J9mqUQ6JRyoZ7G3WSncGYyKwy4bakwJlk3wr5pb3_4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af766o75m--zMoqOfBNldOPGoS6uF-5E7noIU1aRmvA8EA&oe=6A1AF59D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fGrfNyCd6UgQ7kNvwFi8ZSb&_nc_oc=AdoWalYSa2V0UDXrYfC8i8-MNUK-80JM_gMhIl_IJ6naUE2UA00C2Pnabet9ah6vDmU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af47U6j7Gsezo7oTkO38yqD3Jf8NTLAUdKln7WSvY_m3QQ&oe=6A1B0A84"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z25spFZ41y4Q7kNvwH9v9B4&_nc_oc=AdqBre_p9Rhg88Z278SgSfugxPzLYMzWAXPSTMXFr_4kS-vBpclzc9dtdaKsJy2plWQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6FaEL4dL91EuLMqSv17scMNgJAnOGv-QMaFxOSUzSy5w&oe=6A1B06D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1UPnIN2ZNJkQ7kNvwFmtm3o&_nc_oc=Adr9IuWHKiN-diLQE5oIr6FiomAY3EJFIMQXDfFLVO3Aduw58Z1z33pRonWm3qMiCuo&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jGJpasOGADe9GQFIZQiMggxoNf-c03Xigat5lr48SJA&oe=6A1AE63C"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Experience profound emotional transformation through the rhythmic power of trance. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url":
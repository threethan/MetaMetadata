qtL4V&_nc_oc=AdqzqQO168HoB0C65PH8-7hPPSHGPM9OBLo_hv57f_s7pxmpiJHk9hg3NtZFNocsHOk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9xjsc-MVlEXW-Nlui_uIhUU9rSZF6io2xNFcm3Wow5fg&oe=6A315017"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dj2-AW61ek4Q7kNvwEBuWZT&_nc_oc=AdoCpbF0ILTAPmysKP464KuASoC68y8am5QIbCPTefAneHqCk1FIa27ip8HZE2bO_Zo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_F7nuBzz300sCULBPdznaOSo0G6kDsk15-WSJjyE-U5Q&oe=6A315F1D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ehHd6WtalhIQ7kNvwEIzhs_&_nc_oc=AdoVz2iAr0P1bX1nRdGSQKWILpQ2MTmfPsMlBUZgQHVv_CjKrvKxVFfBt33Gky2IeFA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-4DkbuIrqsxKFWl2W_p_42_Of2s8CNuvOHkcdn7tIO_A&oe=6A317404"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uQtx5ovdiTcQ7kNvwEURLdp&_nc_oc=Adp_85__opwa0hbmFUh1eQStYHsJnk85Md4QEgS9f1_ndE4k34knP6VJA6sKukCGbRE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8awIcMd8KiJLwNGaqCI2l9ytMeEdY95oT9aU8LrPbBrg&oe=6A317050"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7E4zAkMqhNQQ7kNvwGywKVx&_nc_oc=AdogVsDKEnXG6uBo8_d1KCfUaBmCbnWTUa8zKQ2o4lA0pmkFHirtlojUQcQPZriMiEw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-GoutSWiOKoBVtWAwK6h-Wp9QWRYVtddA68I4dvrchdA&oe=6A314FBC"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Experience profound emotional transformation through the rhythmic power of trance. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url":
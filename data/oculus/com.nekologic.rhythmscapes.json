A5ux2&_nc_oc=Adrdj41cQKdWfHkAxBZuFEIwMAaewzMaEttI0I5xeOpGnkRSIYcUtQAbtKZ8pjjygTs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDuP4SeKiGnMcZQalNRcIN9Qpuqp3mktRUUdoB9Qkjqng&oe=6A64BA97"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mVh-7gug11IQ7kNvwE2HWjm&_nc_oc=Adq-txpH--o1oRs6_hOOSypIHklXJcYsh-fCXzCLsYClTb_jYbnfQ_48K7YhV6JcrCc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBfq3p_l3qZRHVVWhaa-EUb3TRb4PZyxkIzDSTUfX394Q&oe=6A64C99D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mHBTEHHlcbgQ7kNvwGpQaM3&_nc_oc=AdobtgDBukrOR93_tlydJ53aoWQ7UatPLGeBIjBbqnlsGIYl80ULLiLPAGe9PR6kyiM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDxmF2FMTsV6cxbItEOPm32mcMVOx9lyhgND6X_xU2lCA&oe=6A64A644"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TgYjjwfw3k0Q7kNvwFojnyi&_nc_oc=AdpcVlEIN8jcsXMyiQ73XQ7uyNg5wZ0swouYWuApEm-tEi7hVteLvByTKWJI19x86lg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCUXHVgymuZzdRJ45eTt3ifSo_naR0dqSjr9RAg770ScQ&oe=6A64A290"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dg8Ni-2v7sYQ7kNvwGwr-Du&_nc_oc=AdpdLnG2FvvaWH6o6uSc_Y9bkU9Bg4cFKpImLiCbutKjSAzjbh6yClRu-GE6FzBir3w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC2Ep4tlNw_hxlLgb--XwFubPve3b0vSCaSHgtEbA8i-w&oe=6A64BA3C"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Experience profound emotional transformation through the rhythmic power of trance. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url":
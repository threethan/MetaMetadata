P5nfRtAbzR7XDm46fUuQhjuhLTRRsRBgGOCONZlOYaCAW33iE87Fl1zGbtkLsfw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkWrgnZHfvIZ_sWwSrxrQWf3dl1rCLw7N1EiYIaJtXdg&oe=6AF46E17"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ebb44EwaPeMQ7kNvwFiyqX-&_nc_oc=AdrhOT0dlhml5YIzalmLs_V6CB16aW8ijLID8A-irLAqQ8OHFuhv5d8hsJbmGRKL6zw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgo4Zw2axiMNVSjRd9-Hzr94yuKl_TT64IUduFycfqlw&oe=6AF47D1D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XOg7c4VCAmMQ7kNvwFqwOxD&_nc_oc=Adocud5rgK6bvI_I3FLB6CKXLtKmprUgJszUpw5FhfwIDQzn03kQoMAGVb17qSJcUao&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVL3zD6T1A4_rnKP1bMO7MvXGki4NaQuUfKLROySS6lQ&oe=6AF49204"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rYz0dQBe4yoQ7kNvwHerr5i&_nc_oc=AdpaMEYvBwauh-fZc19M6gj8LWWYIFWQe57SPY0w2qJT82who2O6YobRYaKSXXkdteQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMfh0-c-1w3qAturVx5Ya2DLvt-Rv7qEJQHPTIolAbzg&oe=6AF48E50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KNcWGFV1VBAQ7kNvwF0bcOW&_nc_oc=Adr7ZBfapgK6iJxchD5LOnyylmva0CvcVYNjEyR4Lqx4N3sX4r4IFW8DS19BG2Y7Khk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT02DfhLyqy6y1Km2YRJP9g-nzSIwEO72WatjQWCLpgcA&oe=6AF46DBC"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Get into your rhythmic zone with Rhythmscapes. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url": null, "website_url": "https://rhythmscapesvr.com/", 
v15kW&_nc_oc=AdoNapjmtUGEF573uBmH2zDd5pF-YjqljQBg4UEmeA2JUI5ubgpWETqjbnru9bZiooE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9BjxT43-D6nH-l1DQq-wcQK4eCqPINVAocXOQThRywLA&oe=6A451697"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8YSCn9NEw8sQ7kNvwHVqXna&_nc_oc=AdrhjBi-5gYMKnNeqpKNCxZeRSsbW09toC3CEGw8gDQZMgOYZ1Aoa9VF9jS_aZmeOrw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8AKgbwK0rBXnIrBe8cUy-Tb44_-ZzhU0ABQ_bSYey_iQ&oe=6A45259D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JaDAGMyDOBAQ7kNvwE53YVb&_nc_oc=Adp9GBNlCQy2MMxGDbIer9diXLFjeLnYlMIA8rpDNoAuy3k4AwL67QYJWEuPiYKCy84&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84vaHNgkFgBBBx9Ze3zsJKXggG4XpZ7FK6TR_lkwowPw&oe=6A450244"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oY4Fq2BoE9AQ7kNvwFxgCgN&_nc_oc=Adp7ONn7Jv8UgtrS1OHB91Z6PXG0W0lob76TDvDZpcyL3Iw2SABz_xLpN_V6OS29rWk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9fYocshyUlAuu_cEYvhVtwuryumdDa7Hp8fO2ceqYjgA&oe=6A4536D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v6FyORL3a78Q7kNvwHk5Lw0&_nc_oc=AdrniXQWorRO29C_YsEgd-qCV2ggMkNLIB822dnDBGm9DxeNiSq8hP7HWVxLnoCyQvQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_TtreF8BJ4JZCGKtkkjbPy5XJhEOvuPzlPjVvkRA7wXg&oe=6A45163C"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Experience profound emotional transformation through the rhythmic power of trance. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url":
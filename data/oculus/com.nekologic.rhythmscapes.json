PuZT3DU8r-UpgHlrK0TGCAI6Hf4S_691Ii4UE_Cqeowksx__zX8yUwtmqX4q4FA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEz10vGwXp9ycxX4yKevGOR_CALUmx4hMofRJ9sKv2S_Q&oe=6A881AD7"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R2lGwYKtOoIQ7kNvwEQiugX&_nc_oc=AdoornV73VS1IiemQW_p7Wo8VSYt75xqWjOehGIonbutAmuKIFK2BSKmtSGVepw0e-U&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHkoBnJAQia3xVEeutMQNQtT1mHoqw_AmUoet0kw9_9hQ&oe=6A8829DD"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UJXf7kvjwQcQ7kNvwGxB4Mi&_nc_oc=AdpeLazevpCiLsdjJ2JU0EHJFXgnvLVosrR-CfuJ8CVxg7hJlLKbsmveE-3QZlLtHmw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGOsDMvrgFVscQnIAsrkGbXAvCshKOSxjzn9B21VthmMg&oe=6A883EC4"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FAnaIQT9tk0Q7kNvwHEA5_D&_nc_oc=AdqHsljkFcfwDbPGo6owsKnVwJHruutoI2wR-JkiCXLs36kEeV1jcUe-wo7xF9wKTUw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-TfSMjYxLQKgmm7OthLPKHVRFy8xfcoWo6nPuTm7M3g&oe=6A883B10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BUx9XmxcSlMQ7kNvwGXUA-A&_nc_oc=AdqgAhNKWbRuqrdMoYq9Xq3leyBcDkP4wkuh8915GFO2L51rl0wbtGjDHPN606BV4R4&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGbWj5j6hIC05bPfp6SH329XkqydT25LYiIMlw4zoxiFA&oe=6A8852BC"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Get into your rhythmic zone with Rhythmscapes. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url": null, "website_url": "https://rhythmscapesvr.com/", 
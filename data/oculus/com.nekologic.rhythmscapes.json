b8SsEQ8wq7SedaDh6KSEhxXD1qKVQHtIooTEfCAqX__GuEXg8tpLFxX4Hr6t0gk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3oOF7Ko3mpwi9pPJTPutWfTOzwI0t7h9BurzLrJYuN8g&oe=69E77C17"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MLapHEVOzQ0Q7kNvwEsily-&_nc_oc=Adoo2ekoEX6kEWGCvuEAVrKdqtDAACrp05y_c2Wvrj80VsynBaq7_KWA0FBDtWgXR5k&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1tMb663N-geC44HzAhWC46NvCAz0xJo0oTv8Dvrj5Iiw&oe=69E78B1D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qszFacm3pJgQ7kNvwHoUFz8&_nc_oc=Adrfh0kOo4FsG57RBhUgRMTMtYpgVUcOGaJ-n4hcgKAW7m6eP1k0AnbSRuPM_PeYtyw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0CcEgpqicIZhJad_oY1OSVvNvt-8b9P08MzM3WG6FzFw&oe=69E767C4"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oAdAFQFTFr8Q7kNvwEd1yl9&_nc_oc=Adqz0tFXp2FVZwClwf_4jXhM9uG8q7ziUXInuvBPnCaNPGWwG_lHqqNLhcgRkFwDWgA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0kowrQYelnltzH1EMSz4lt__ym30mZbS2e5zi6MACjFQ&oe=69E76410"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xi3aWr8s2aEQ7kNvwFXkpFk&_nc_oc=AdrG6hVGZifewU5UUysSXOGkZoHyE3qXHPWjaAbNaud2NBVfkCDbkaAicE34tgGvKxA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af079IR5oj6Yh5UO5bgn69SoTCwYc24IlRPsqsPur8pDFA&oe=69E77BBC"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Get into your rhythmic zone with Rhythmscapes. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url": null, "website_url": "https://rhythmscapesvr.com/", 
pr29hiuLoMYMKpcJIclhlK6-OVabZw3LWMsf0DwvTYtCrwu3SKuTHPs4vbwp_0U&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5U1tnEPyWykpcthr0pXhdpCxd9MbRAxWKf06kEiARAw&oe=6AB67797"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XDZoND_YGf0Q7kNvwFZxjKv&_nc_oc=AdpmkUqra9v8-jpX12zEA88HRsMW_sahNGB7IYPSk77BS7tCZrpwsDDICSMkVOTnoTM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5WSe3cfeOLDven7-lSUTxu8Iuntj0bN6LyOoo6s-qEA&oe=6AB6869D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1K9G7gnCJYcQ7kNvwGnWvoH&_nc_oc=Adps4LjlE7VwSguS_rx2CRp1kKrchcfDyQBr0f_UO5PKa1tIfMl3U59u9IaGj_CKRsI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYLsLwFaexDpl7Ad6sZeArzXjGHZ9exKCunLTtcBvZCg&oe=6AB69B84"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HvmV8j_PJa8Q7kNvwFlla12&_nc_oc=AdoqR0PGgGkx4XHaJsjN3aM7EIROVcKA1bDoxdrn96OJCZYpZk2ZVC5srNNLRthpQPY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1FQAr6nTAYPxFsY3bYI6dvCug6IgeTCSPkEZHPPWWnQ&oe=6AB697D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w0hdt5PoUfcQ7kNvwG_Mbbi&_nc_oc=AdobDtINWmScMoYSA6qrjD869bLUGs1VEVvxhHURPT0Mt0DiVzROWGnQ4-NusdCeFQQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLW6mMhMEwDPsYwu5liXBK0exXRMYGMNlp8jSTW_dlSEw&oe=6AB6773C"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Get into your rhythmic zone with Rhythmscapes. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url": null, "website_url": "https://rhythmscapesvr.com/", 
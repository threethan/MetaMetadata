3FRv6f0dTpxXfIfzy2ldvj6S8PsVWBQf8ufF-AW4ZEVxCf_vUaYOTocsUibFBpA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCu9Wt0JOXw4X31vXvqpdK_ss9tTZWqJ-7_0jHeEgHm2g&oe=6A563A17"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NNgYgAzVEg0Q7kNvwFNQFgV&_nc_oc=Adpx0URgBjCVFPr9EY3CoS590pIQ6LJmHzD8DR3J_iWIHVKyfbdnpiF5lIXTkrMw6bQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDXvp_e9s4mNf4zXrvQILsDhYxEsqyrUD86JGfNVfNk-A&oe=6A56491D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CT68CCjIF4MQ7kNvwHj62yv&_nc_oc=Adq_S-iK5kAzU7yMawmkH0Bp5VJN6sWSp_5q2A1GETIS00be6Ec-otiKdnGX5AE_VFA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTIrGLClJxz_QXjxwJ3hpkdkJ10-SM-aq9rhsbJnsZOQ&oe=6A5625C4"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UCMmnwUgITsQ7kNvwGaKqok&_nc_oc=Adp6Sh0qR3_zRjz9EqdxPb9SG9HKEDmtwNz6QJDYo8P8cUsjXbQ_xPOWv-rao-geYaE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbZ9x_nZF2_rAKbGLgGj7e-pbLyLqrnvLQydcrWAlalg&oe=6A565A50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tpccbSG7ax4Q7kNvwGfslUA&_nc_oc=AdpaPKDLAf31sK_Enfry01VnOBwuq-6RiEMFhMqCVAnMZyWsm1YemCKQME6cLcJSyTY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBKDGIVnV9Oq1eYoFhLRqn6imYLPhzIFS2AQU5e6qbFVg&oe=6A5639BC"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Get into your rhythmic zone with Rhythmscapes. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url": null, "website_url": "https://rhythmscapesvr.com/", 
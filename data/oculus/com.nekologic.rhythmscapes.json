GXu7v&_nc_oc=Adp_gU8s4MgYjVR5SXY2-70FZM-4-_k8CpR193M5wNWUapB_fziYj5ELIJmJvozfJ7o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAQCPQxKVGDMhImNEjBuLrqDpNvi5PTAU57LhCdoMsbUw&oe=6A50F417"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0VotygHY8n0Q7kNvwErHlJV&_nc_oc=AdpPjlvzQ-IwUl8iJgkx7rL8AiRhqMKZBWcJ4QBNPZZwI_2JvKor8fTZvTR8dkVlodQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8-ua5oCDD0kOcIwvGspT178152SYeke_0NQNRjUaILg&oe=6A51031D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GAlXqmY3sh0Q7kNvwF5AHjF&_nc_oc=AdpXA4-GGg3qNA45Uq0m5ootoiYSyr31fO65Yig3wUGUEsbDd25iysFtUav5ZvkQokc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA8ZdnEbyiTnRCLmDMi7fHS-fXvfzXJnMyw3GEuDiiC_Q&oe=6A511804"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cgJ-iyFBjRIQ7kNvwE1fXum&_nc_oc=AdpTd9Q9VAFf0l_1Pkc_yYwyWtuD9MmTx9LcQRd8k8SiBD81r3Ob0WWJ6CTD0GH5KbI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC38tD0As4Jrsf7Ya-SjeReNlxs5t05VsQbGdP2wNbCtw&oe=6A511450"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a4RojBXZ_iUQ7kNvwFOK0u5&_nc_oc=Adqs5epLHM3FPuKysxZlYXSiZqpirQsA9_-kBAl0zOkGYIOE9W6yH61CakQ5eF6fqfo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAgPTnWIw-pJ51D4b6gQIpFa7sxvAUZ-O5hfc7ateYeWg&oe=6A50F3BC"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Experience profound emotional transformation through the rhythmic power of trance. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url":
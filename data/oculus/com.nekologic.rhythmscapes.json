FG2ZD&_nc_oc=Adrdq8mFYYScmuDLOPAMYIFqrlawb5BwXYZEUZ7haWW_qur0QQfbaWY1KBpkMdfFvfI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmVZ2TRw1bkzU49wfa8DRO8TEP5BeoOu3upnAa0hEIDw&oe=6A79D297"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wqWcFu-OwysQ7kNvwGo1Jzu&_nc_oc=Adp3AtV0OrOzkj2mU3zqNZhD8N3rZaIVpdAL76Jz8FbpAruCEyIZg8-7fUKhqCGBooQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4WC3zEYzqvSE-ArjXvxKW9dWsGONpKMUlTW_PRo9jRw&oe=6A79E19D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WVdbpSytAqkQ7kNvwH6UQog&_nc_oc=AdpaTp_030Yq-2lElFepakU-o-RK6pFE2oV6PGSgoptTxVqQZzvgUaQXWy-loc07Lwk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnDXm4xbR0g6C1tlx4Z-FfCbcsl-I4Gj8HberLT6nEfQ&oe=6A79BE44"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yzwf8NguauIQ7kNvwEUQ7un&_nc_oc=AdpkEVc325F_tDUacrbnCDEx-_HLZoTNZyhK3LAHGNSQ6PWQSawQmpJP0pCZWJIc2Qc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDU9eL4NQV3V7t0q61_CpUN46BUANdGjsi01Rf0tgLdg&oe=6A79BA90"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cU3NnEdjvScQ7kNvwEOak7d&_nc_oc=Adof31kaFAjUpIdpONwZL0StncGPXaAOx1rsYDxWieoFf-GB6Nfs1lcyRF9qDwHsRIs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHTAb7V5dRhSDxs9ywY4TP4HntHWmKqLOFpcAqtboqeNg&oe=6A79D23C"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Experience profound emotional transformation through the rhythmic power of trance. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url":
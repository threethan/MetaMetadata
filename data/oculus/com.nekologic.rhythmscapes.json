IrdcN&_nc_oc=AdogcXEHb7hf-N3bGpeko_mCSaJBvag2Ounc18DHX5NeGB0__P5kII557HvQLKH8yLU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMwY5rU6JB2wRjm2WhDdrCYw6WON6zfdGvHlyddPiwyng&oe=6ACF8417"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zs2B8XKAoQsQ7kNvwHx20ms&_nc_oc=AdoRpe2Wq5_BzDVYEngwmYJo0HJccqjJpqdIZV-LMkAaqv6irFO_EX0nrNLO2EYS4YY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNrAj7zHm_Fr-2nZ3UkcYYKNA67FyxPLyAqLtf3J1sHdw&oe=6ACF931D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IBg45pM4N50Q7kNvwG3vuur&_nc_oc=Adr0qc4PANej8C2Wc2T7ennsUu8bvhoiNoCJnxeNn9swkKTnHXD8bgtue_F0est4K9w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMujYhdWl3c_7mNGewOJ4xQ3tmKVasut1EZXqfUaMQ4bg&oe=6ACFA804"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=URfJzUazw1kQ7kNvwHp7D8h&_nc_oc=AdrHYz7NyYhl3oTtxsOiU9Bnrlo5-KrJQtVNKD8JeUPYulbgYIGo0MyhvchhLcePRbM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNhOZSukUvej6uw0RweEwTV1NsyvnK-R0O7Vn__erFeVA&oe=6ACFA450"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3CpnZVj2QrkQ7kNvwEGBHd1&_nc_oc=AdqgKXjlz-C_XozqooYE5WciRAa8CdGKYp3e80BnZW6bJ4TvZLsjvj7K_4aM7pfDsQE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQODYR5a9d6LUnA1okizbVX85F5eubCuQV-OecMZh6FQiw&oe=6ACF83BC"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Experience profound emotional transformation through the rhythmic power of trance. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url":
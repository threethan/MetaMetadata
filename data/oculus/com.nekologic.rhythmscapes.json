uDm9L0aY9QHdQLG53HdaqcyOG_o06qPF4z5baSr1KL8CHkssHgQVBAqZCgeTxac&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMc4bjlp8L6ICGDzfA2tBnpEQwT6-VwNlu8d-ECq71IpA&oe=6AE34A97"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E3Isfv5EauUQ7kNvwENqHNY&_nc_oc=Ado0KFQWu4Xnz2gDggbnmoz1wdDXqhrCwcLKGJM_Htc3rCw62xVlVfF4fhEgPexY-i0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNVxEZciBD5JmB2LWKvM6fnPCGq7pM18eQTj7B_rUNF-A&oe=6AE3599D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AQ4OxEiCdoYQ7kNvwGsCsgS&_nc_oc=Adqg0VYdO-TnXTuOB4dYUQG3Z9jKwJdrpreY-oiXYF26tty48bld2R-Jd90tZxRM6GA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNEt2xtS6ES_aEMH9VHIcDu9B1My_4Zp-H56p8dV-oJ2Q&oe=6AE36E84"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sXitfVas5JsQ7kNvwErt1dh&_nc_oc=AdoOyYkguEs_5iQsGFLrtAheGQ37WIMu4A4X_I8lJ-3bzrWWKAJ0heNtJy463nKE6OY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO9eKvdLPEoC3sNzmeRwXqY-ExpicHE7oH70dG3765Mtw&oe=6AE36AD0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OXoQnxy2NBoQ7kNvwGsM8JC&_nc_oc=AdpFKWDeMODccz78-0gW0YuA3gk7GXUXzJ1LO24ILNsloAlFDejVK0P9LdWU2Lt-hzU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJCF9zCfMOTF3hbH97ettqFRcj3J-yNgX9Ho7Rx0Aflw&oe=6AE34A3C"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Get into your rhythmic zone with Rhythmscapes. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url": null, "website_url": "https://rhythmscapesvr.com/", 
mDMSk&_nc_oc=Adokt1w4XYET3XZSh0ADKtpmg_V_m9NlvN0eV3T-6dykLmsUVsEg2cLh1G3O1kDKx60&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGfWEkrgbq1DyYO8bgPlqtmVV7nJ4S1xwOuDSS0-GLm6g&oe=6A95BA57"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xqmxlRF5oOoQ7kNvwGDqdUh&_nc_oc=Adq5Pf99bW-4OEm3L5vBd7G5jv6otr4ykwjScwmquDSSiys1wsaNp-SNcrJDT-L5-Sw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEVnQ7MPabLcfr5spvMOYDEQlA2hDMUBXTS7mGOistNNw&oe=6A95C95D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ue7zaJSCZ7gQ7kNvwESHdNH&_nc_oc=AdrJDMiTZS8wQr46ka3O5MJB7cPpQynEM0H9LCieIVWarhdQydBGjBJMS5SGJvbkXqA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvA4g2x_d05Niwth5CXYhJGAg4GlkskOgsy81sR6KrFg&oe=6A95DE44"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pRZc1t7nxYwQ7kNvwEbh4cn&_nc_oc=Ado9mNC2sZcJyPBiVbTUGAxH_2ffde4OjSFj3rVJ6hThaCxFEpujrIR5rep7E10r1FI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvSc-hYnEsavJ3jeRXTB2DdeJ13vwRwMw50H9sLjS7KQ&oe=6A95DA90"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9HfrSv5vGAAQ7kNvwEvf6s7&_nc_oc=AdoaWLk-bNl-c-DrS7uzYq4DZ5xuBpjUBrP3D2kxmuFlmrT4RqvWIKecNd6tRCy3G5E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFk02iB__KNxSUBtK6mlKfdNIcYv0d6T5n32MRkbpAYUQ&oe=6A95B9FC"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Experience profound emotional transformation through the rhythmic power of trance. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url":
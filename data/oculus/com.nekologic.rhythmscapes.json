_LeJ1rioRH5PZVUfIQ-G2vA&oe=69A2EE17"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UKP9lpHuoaUQ7kNvwHSdCtP&_nc_oc=AdlnlAgsHJQFpHENRpJtBlUjyHpyxVNvEnsg0NsVQVe7mMtT5H_Aw5xM_DhGnwnkGoc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuWSjETUgbjTcduTJk7tpmjaDd-ph0t-nNI0fiQLV0Vpw&oe=69A2FD1D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TMihV9-205AQ7kNvwFPgvnF&_nc_oc=AdnJaFMLXHPGQDoPy0rr6qaFWfR1hTHByPuVMDy0Yjmxe6_Ty-KveJ6k7S4KcT_r0Ng&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfthhTMaL-NSKJqoX1kCYwckX_amg67uS51FlpaK9lIlYg&oe=69A2D9C4"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hBmeLpTxMhIQ7kNvwHFVsQT&_nc_oc=Adnqt8BhHF3-4mzlRJgAtqaZnD6FPOFqTgv_HyBGStoxzJQ4SzpfzWurLyknsGgIKVs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsYVRcIDHFmEry3CG_Yj4f2pascTuyphNNZhjmsAatXXg&oe=69A2D610"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BBhQ0Oy8wikQ7kNvwGc5RSt&_nc_oc=AdnDYShoIGNXEYDxDcxkvL_mNYvgX-nejGKNssYENY9j7x8trDOVFWdWUaunNZRaVUw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv9SYTe5CHGyC2SrJrUY1QBmo2gQZToBp_QI3s-8OCjHw&oe=69A2EDBC"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Experience profound emotional transformation through the rhythmic power of trance. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url": null, "website_url": "https://rhythmscapesvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_to
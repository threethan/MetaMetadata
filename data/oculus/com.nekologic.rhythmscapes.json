wFLny&_nc_oc=AdrVjASvIXwFyuVTaHHfwzM8EbnvAk13ChYuqf2WOJv0gZAQM_yq33NtQRlJ2ueA0C4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEviu94z5uWgT3MpRHn_XLp1npGG9RjTEK5_a7XixZnDQ&oe=6A903C17"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OVUElsNTLRQQ7kNvwEih5Yi&_nc_oc=AdrNPSrW3wSw9ilHsGfaZw2jrEvosWj7l8mIoXxKD5c-T7fCTXTJrpIXTmqKlHXZfNA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEoHTIH2JkPqidzrneN1P-aHAw1FTdfch3fZFds6tcMkA&oe=6A9012DD"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gK5anh8jk5YQ7kNvwGvfQBU&_nc_oc=AdriFOwS7lR7DDf4olhfvU-02dDLjjbNlcQmRsi6IeaIeL0DdPLYfrk2deVxFnKq6Z0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEo6cLWXQmm8sG1dDxIEFsLv7ADOD-BkA4C3XrNtMRCKQ&oe=6A9027C4"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uoXe8f7Q1sAQ7kNvwFpji4q&_nc_oc=AdoLf7us0ikXUOmc2gS3W1QbuBQhmUlwcdfkwnYaNHAVW6SysoxaETHpgmnEubRHCEc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHg4HDTQpELhzul5s6VbZdfeQCkoJh5Q_rBc4g7BITL_g&oe=6A902410"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gm7eBhr03vMQ7kNvwEG9gVW&_nc_oc=Adpkkjxr9f7T0l6uXn8eTJWd28S3Y52SCXTI1HY-6rp54lHVs9qAr6MgV013jNSGm0E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFlXyA8sQu84k2at9-RBmvsxAKgCKLzHjNaIFN98iH6Zg&oe=6A903BBC"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Experience profound emotional transformation through the rhythmic power of trance. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url":
sd5_c&_nc_oc=AdqXft53F2YtF8lL1pGv84pZAY8sXeL6x1vU58Cony6RUQDToskmbLaae8Brv_x5z5c&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_VWyJ_4EqKGjaH8a6VyhGYimqGaKhu2ef23ZxjJs2jOQ&oe=6A2FFE97"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dj2-AW61ek4Q7kNvwEAXVSH&_nc_oc=AdoTrJPj5rq64z_DZ5BOXx0V8RMUJaTt0bE_MBv70PNJgdbvOQlFy-ivau_FNtkJPzc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9JioPjdw8tXGSECVv5tVp_dmgzl7PdrZTFneb--aipmw&oe=6A300D9D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dpSZBd1_60gQ7kNvwH2Ib22&_nc_oc=AdpcEI5BkHLZsvg5o-SBGpN5C6F_mBqFbDxIWUzBHMofpCi7jrhhRA3ptET8s4FsTPw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-oatYW1lqS065lvVa_ASaxcJ70GVTR_M91I5CCY0TCRQ&oe=6A302284"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uQtx5ovdiTcQ7kNvwE99Dog&_nc_oc=AdomEhCjyI4IUA42CYdYM8Abs3cQXfywLjDuLfd3ivPQ28U0CM9rEFyyY2NUOuUxirs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-tSIkUmv-tqOhpKZkBZ0Cxt8M1Ugx5IgCPv2SrgxwPiw&oe=6A301ED0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7E4zAkMqhNQQ7kNvwHGa91w&_nc_oc=Adp_8KHLOytc7SX9YWZADgbMZNgVuvjiHbrT_tPSr3OnEvXtupIATPIPlNQSzcJUMMQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-DSRlDVuuU6fncZPd647EMWTen1Z1giEh_T5v9SQd90Q&oe=6A2FFE3C"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Experience profound emotional transformation through the rhythmic power of trance. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url":
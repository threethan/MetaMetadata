QWeoT&_nc_oc=Adr-beAqblSwF4-JxZgsdbcQRMTwCa1OhFAKUedWXKxXryLcbzCGt1Sjz2u7EFwivFs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxaVN7YQaDvxeFQe7QH-DdkQIcM1IMvZROz2bQn_aqyjQ&oe=69CFC117"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7GYPAEQ0XZAQ7kNvwF-lk0q&_nc_oc=AdoVlzOEnWzd7iiJIKZFrS4amuZWVlDuqmTF3aj4t4gtS06qI5XaefncTALRWSpnzZA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxOvh3gMXdBXbTaei5Rp3JB-Q5FICGW3aP7V-ZJBPRuuA&oe=69CFD01D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IJwurmgH_s8Q7kNvwHkfJfY&_nc_oc=AdqfE1hL70UMo59V8Ve9mLeo99KFfpl-trNcvvBBkDqMphNPe-mXIh2TJijbMQeB66I&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwnBXLQ5gD1l_Jsl8kX9ZfRAgQD3jQ_fBIa7tAqfromKg&oe=69CFACC4"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c-SXQ_gDAYgQ7kNvwE7Fjn7&_nc_oc=Adp1O7UZaDpK784WohjpNWybDoPVXkwKulnOzSMzMQmVjFY7c_rqtPGfmJ59lrNYO1w&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzpOfp2eDm497dDsnujIU269O6B1L0a3a9kKXkwZ4Sl7A&oe=69CFA910"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ls4Sdzw-W3EQ7kNvwFNulUv&_nc_oc=AdoT2sGlF9li4EV-qebxXqSAzT1sueI3-kR22m4prGknBV21bZjM7d77F0QsWF0HJSg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxC4rHQ8dLn-BUmnCVP66NuLzHLH_D5mGpfL8QMBETuyg&oe=69CFC0BC"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Experience profound emotional transformation through the rhythmic power of trance. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url":
Oz8LB&_nc_oc=AdovUMXT-m_SmkLW3XrMeG1cTVIoZZWpc7B2SIGlaNbhunRc8ZS-BWYWchhNEwKAuhw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8cqsxDHuRGWGEjUEGStfVLVycR8mWBmK2GcxhonvS_8Q&oe=6A3FD097"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wuPVqqpNtqoQ7kNvwGqxrhA&_nc_oc=Adrj4RTCEpWNMhiFNYWcqa6fHgFHsnCaQT6L4oR0x6Ofj78nIjKRqwGcRmCUKh5Hi4I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9wSIh56O599u3bM9kMHjVmfquQgj-29FdTXyIwJboyCA&oe=6A3FDF9D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EZNuKWub-HgQ7kNvwHqV14p&_nc_oc=AdpaA63ibKeI1Aesz68028SEQyfdGkarfhZxP_HZdsqjNRId2E_Z8AaSQaxzGgfrvL4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_e8dNHu3RzN2fZUYu9E4qptAjNNEn7VCBVRyBQqKwjIw&oe=6A3FBC44"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IyeRJHHOlucQ7kNvwFpwczg&_nc_oc=Adq0EZFpjpy-j4coaCxd0Tq4QHQwG_MRTowJaFQyvgKRJZqjlRh4LrF0Rk5-Xw8MlGU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-eVzF9REkmUY3zeVEzHCdiHJVjd0Y02atCi3aAMsuWcA&oe=6A3FF0D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gCwJZclGDR8Q7kNvwGJ9NAr&_nc_oc=AdqbbPuAAua3YZy4kjurhxwkMU48-jSrm-j85-mwbNx6D4ruj58c0oF15lTzAwX-re0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9NccvnhsLO2NTMmv-oZEPv8OpzyiiDQL49GDlFNuFoZg&oe=6A3FD03C"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Experience profound emotional transformation through the rhythmic power of trance. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url":
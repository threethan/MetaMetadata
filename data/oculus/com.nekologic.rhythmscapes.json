ZQ3ma&_nc_oc=AdoogcrMSHmB_VgGEqpBq-FMpIo4XeJpd1Vw84o7LWoyawObKMUbVV3DaVHDdNpWSQo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTxT6Orvv8-wy4oRcl5GwmD3gVJW0fZR16SRyT1mqiGQ&oe=6AF0B1D7"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0jVUmD35_QMQ7kNvwG0DLIF&_nc_oc=AdqMpS2NOYY59-6MQT0WIjXbrJcEZE2nd_kbD6Kr9m357RAmcvn7h-I_PMYTKnHt6EM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmDuT7AYfTzgNbduS1n0L_Cx4BLIEFnvep2TLgh5xHbA&oe=6AF0889D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5PMd7tVv414Q7kNvwFGWSTp&_nc_oc=Ado9cLtle8uwtfxe6cQx9NfL2f9EmknRRQt9oYR5bVVAocf2D1gm0a1QLxfS0d6zbC4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjlxI6SptNfA6f0WILe_QrSDh8wybn-EythG-UAY4GeA&oe=6AF09D84"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nbkIhKqa7GgQ7kNvwHqVtS9&_nc_oc=AdpMlMYRLdcnjeZtS3ja60nbBu2ZsvCwXJbVwIHUe4oEp_RiPIg37YDINxdtDncoFf8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7AKznhGlzGcIKWCoILEl5JZbPNR6ykWcJ3JEyz63b3w&oe=6AF099D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ygq9ZNNK5o4Q7kNvwEvNYHh&_nc_oc=Adr0BK9qnKwlQU_zB49PtPY09KTDq5biDhWx_no9j2ZCy8sEegzKG95nldnVHPVY2UQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnbhxKhd5K-NmYrZReF23HVhMJhveuE1z0aHqrCSKRJw&oe=6AF0B17C"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Experience profound emotional transformation through the rhythmic power of trance. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url":
UPzoqe83mF_-z_CmD-t7iOVLRE0JAtc0exTt_qK7UR-z7xTaZU_TTR3HaYiiriw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0si-DrGyRa2qrA4Qm8e_8DNc0e-OgG3ntjbE7WT8gfzQ&oe=69EE1397"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WX34Q9yLDMIQ7kNvwGAHleR&_nc_oc=AdrhEiO1twStMDRm8cERbHFgrB05WSad8UbR9aNf4Jzh3yXT4OIKofKwEfy2RO94mxU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3zKZbujFpzAbUAX5pXOcuWXLmBO9ZZl4ZInOuPokdI3A&oe=69EE229D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6l5NwqAStJIQ7kNvwFe9XfL&_nc_oc=AdpAazP4tJMy8Ssp0IivuNHUqTXnogXKTgU41y75nz0Z3LgGltPcXgMbRpvnGmdy2lY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2hN9Kqq8zM3ya-r0-u7_JtO1Jtaiq1Bb95TGrNl7YmSg&oe=69EDFF44"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nVUwc4BBXrcQ7kNvwHT4Hyg&_nc_oc=Adr5XsEe67dzwVBnKX7uAGT5VBp-4-e_6Bh-L2FHX-npQMjMoHOfstfvY0vHzXfl9jg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1WYd_e4-tSCwskmyU0c7pOnBtVBOU9CkAlFbYb1GECKA&oe=69EDFB90"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V5l3jFZx9lAQ7kNvwEV9Xjw&_nc_oc=AdqIB6zPtFvA8-LLbKZ37WO8PfJRbpsMbtRJO_NLmVp5lGwf-Sh5Y16KChgZh9Xv96o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3NDNIYO_b-8YmN5f67Hcwq4gh7wTniQlUnFGG7YZn1xQ&oe=69EE133C"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Get into your rhythmic zone with Rhythmscapes. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url": null, "website_url": "https://rhythmscapesvr.com/", 
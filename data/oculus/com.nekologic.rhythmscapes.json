LXRuN&_nc_oc=AdpONrBcqzJ0JrCMJTcOZ8EFsrhmjOWkIt7-EwmdpRCuCuGlKLdPq79WzXbBVYM8tPU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ieF2o0hXmyvuX_Jnt5GRYRsGd43T-Tcd7rtSOF4qbzw&oe=6A008897"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yoUtLPq_TYUQ7kNvwGWHV3I&_nc_oc=AdqYtTnAWlrEMFOFf9miT2i75yojnRzyiJYBDydO2X4ODiX18ucuQOMRpGMfurjsxR8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5MhIb0n2tNDofb7ir8QrYTllAE2LJ9H0e9ZB64wkD1uQ&oe=6A00979D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dVTOl77bWbkQ7kNvwEsnmMI&_nc_oc=AdqIwiGazoHHVpNWTI1UkdCpPaLOWlWldq7yDi_Zaa_mbFSfnTK0pnZUoUfE7Kcmg0c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60ZaH7T8DSgM0kNmShqQogKfgX-q8ybfqEfrjTWwHOGw&oe=6A007444"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aPOAonVpCtAQ7kNvwEAc6qH&_nc_oc=Adr2RsWWLmlqjUVJ1-ZauR1xzfkJu28Qh_LmUNy3vxxuOKEUYWxIEpXuqZF9sObpsos&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af77APxAy5XbeMzmpF5B68P8_kbpf8uUveBovZAjlpbXyQ&oe=6A007090"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QtwzC2NJJdYQ7kNvwHgvVB-&_nc_oc=AdouuWTWvFYPNO7dlOMOcX8Sw9t2D7TI-7vyrv-C6R_msqtW0kIPfQ2odgLT1k_Nk3g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_rGQAviOH70C5sFFWqj6KPcU2O036vWAFyTA3vfe2Lw&oe=6A00883C"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Experience profound emotional transformation through the rhythmic power of trance. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url":
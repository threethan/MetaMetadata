t-atl3-1.oculuscdn.com&oh=00_Af2BeVQZB_OG-wSmhIOTrnZzsFyGEQtR_jP3zhAEBg72SA&oe=69F20817"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VGZ_0rQ1rU0Q7kNvwEnMhJN&_nc_oc=AdrQPiS1-XshF7saobglz10jnzUp0cuiBih1jCBolpaxwjRun5LWijSNjIS-igxe8vg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2To5WrJuZjPnGRnjJy9yaBNah-24qYu9-yqvrFruk27g&oe=69F2171D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=daWTDDviDCAQ7kNvwHj1ELG&_nc_oc=Adp8r4Sznak6d4Q4yX7yS179lHiA5qQjp0PtYKoB449mrutR7T8JzemB7bzaIkht_sE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af299bT5493bZfmlVskvQ4RLRr3e13iDzoUYUIFYchOlEA&oe=69F1F3C4"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JVPQMqMvQ-IQ7kNvwFPIn-W&_nc_oc=Adplm-pl257qCsHj4-tkdXFdvogVldTWJfr9jIki1quI1KdAS3KZT7S4zDzSPWp0uQg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af39_Yn-dbZhtK57c1gGZFtY6WImARhLGTdzW__47zsD5g&oe=69F1F010"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MnpRJa5jd6EQ7kNvwEmp_Vc&_nc_oc=AdosntkY4OLtIAn1i7UA8U8YCxOJqtPHZhM9DDDHuf_NDjMB8neTGdMLhZYIcd6opTs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af01VRaAc5SOIQBT-_eheuO84rWiPINoBEOHG_fwNs8CCQ&oe=69F207BC"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Experience profound emotional transformation through the rhythmic power of trance. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url": null, "website_url": "https://rhythmscapesvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [
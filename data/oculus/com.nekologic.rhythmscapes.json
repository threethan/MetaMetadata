M9bpYaA4H__7W3qd4XQ66PwAyGRd77f65QR-nxCG26Ldx5hlJxURuGXW2b9rQJ8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8GFPjvWv8es9cODDLTaND9eAV9VEnuJmwiACx9t-8iCQ&oe=6A3D2D97"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xmBbO3d2HjYQ7kNvwElctUU&_nc_oc=AdppFB77blROEYQy6GCYcmgPST1rCkuVgS04jX8TZzdlTSv2OlG4RjVNYM1x3dg4nTU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_WOyY1Qf5WFv44-9feor-480k5HMQLlegBhNgbvd-vnA&oe=6A3D3C9D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EZNuKWub-HgQ7kNvwGUeEZF&_nc_oc=Ado04FXnIlTSdEilwhKMZcIi1JgRJI08pelLtkwYYx7w_DblRm951KcA1kF5d5JMPOw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9k5cy_x0bps2ofMoBem09lBNABtd6QJakNUShVJeRqxA&oe=6A3D5184"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wPawdjbCgcMQ7kNvwEUtkk5&_nc_oc=AdpbFmqDDtLtNrSgzeJzZhuBPIpPqSPApszjq8U1e68GEgqowlP3hpGVWH1o31o-pLY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-QHcU4K3ioTCxbVHH-bD_VdYcxa9obsBeWFo2wDUjUew&oe=6A3D4DD0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CL7LSVfYv_EQ7kNvwGzpeMg&_nc_oc=AdoKE1JZzGbPzYkCbSg64_LIjdE5pK1Zln7EpQpXNVaszOblDS8vPlQOntqXz0uCHc4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_h1Np_CVY1Pw2zKm1remQGRubXA3MUp7KUwXnr8PuqLw&oe=6A3D2D3C"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Get into your rhythmic zone with Rhythmscapes. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url": null, "website_url": "https://rhythmscapesvr.com/", 
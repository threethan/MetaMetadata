tm-DP&_nc_oc=AdqOE6_ZD3MQjR1xDzkLNDHd2kuKnJsW57uHIN7gJ9TWTxWfJdksUiQveVfLk1xRI-E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8dIkoCGlfowdlRHCftlQLKDJyrkf9Mu2fqW9oIp6z_iA&oe=6A2EAD17"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dj2-AW61ek4Q7kNvwHhWuo_&_nc_oc=Ado-zIBQ5yM6oP6Ip1xazreYT4U2V1tsAGYKuusk3mWnP8ECvt0XUJZb6UVgksnH0Ow&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-VUl6o-esV3hRlZ0Ho_GSPRwdIuzlR1oXeRGJZku7D1Q&oe=6A2EBC1D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dpSZBd1_60gQ7kNvwFYlIMr&_nc_oc=Adq2OdjaJUKP48DwuVllbRfj6bbtXdZlnikBqavw9FYN0ND55IA6kiEVDAkovj2GoDA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9EqrSLLtbKF5_oJfG_M4a5RIk1zjgOF6UJ8sgeZHURWw&oe=6A2ED104"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uQtx5ovdiTcQ7kNvwH_3KlD&_nc_oc=Ado9QfdlJ9k_oyxc-vfj5-f5pWuBo2gO7Is4nIiJim9hcHFO37nwQQLm5P63WYv6u94&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_GkGvd3Xk5QAARvPRgSP23CXGHkWnp_3qOkGEzhL-SKg&oe=6A2ECD50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CTtAdujYKuQQ7kNvwGTuz5p&_nc_oc=Adp4F6RnrFj1cAytzbsUtjK727C3wJBwfhh6ypS_HWb31Roz4onUyGdtynCslX4XgP4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-mFerQu6SqK_adG3dEkbSGMMgiWIGOUbMPj_IK2Y7NJg&oe=6A2EACBC"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Experience profound emotional transformation through the rhythmic power of trance. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url":
ErzBhMkCKIOFqigN10EeBU2T6FFAKa0pI-AGkAqmGPIoX4hVlzmNkiCaug6XosE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH17eDh_Ec7gYvRHOPMvYIHlt5GUOm9Yc7IyUPlFK373A&oe=6A806A17"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sv1I1GnUHA8Q7kNvwE1yw9e&_nc_oc=Adr-LfoK_LhUk_G1p4ybyGxKODCo_X21ZLg--LEE3UjyFjsg1ETm0b0j8LNWntb2Yz0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDjW8VpiHSe1faNS6rk0ay2687q19raDi_KRhYgyIduw&oe=6A8040DD"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JoJzZB3yjjwQ7kNvwEAv4Ek&_nc_oc=Adq6kYaIkchOx08gBPy3ooTskhhWQ8RdB2dRIwRAM19EN7E57cXc0c6qLle5x8jX-pE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFI1nFZXuc_7YJHH2OgI0bXsftmTd18NMNfSOamLnS53Q&oe=6A8055C4"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZKm4Bz6hk9UQ7kNvwEuyK63&_nc_oc=AdobfCliBbvUcbtgUif-ITyG1qodKImqnYM7DxNlK4WSvdTN-J4FVWFo3Fo6Nq2wF0g&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHjNJ6iaTmYil6wKYVztoHs4YqhCMYekqTw3x_pelrM4A&oe=6A805210"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4yAP-U1NFVAQ7kNvwEDVg3w&_nc_oc=Adol4ioYY_eLOpJj2dJVLlvFjsZoPV7FjoQRwugj30BkA-iH0I_kGU4UdDJ8MyedLeQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHrz8ZDHG2Ob3KuSdMiOtxGqtIty0gDZ-KkOuj-yO3KIg&oe=6A8069BC"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Get into your rhythmic zone with Rhythmscapes. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url": null, "website_url": "https://rhythmscapesvr.com/", 
kQ7kNvwEagenB&_nc_oc=AdphOoHf77hPLDVDrOKiHDl7e-vr3nwT-t9bERU2w6XVCO5fK2iuOj56s46jVrQY94k&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83MchOb2_u4QAivAyuRcJx0BbG2qZZ4XNo8vi_v-2PlA&oe=6A369617"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S24zmTms2BMQ7kNvwHW7-Od&_nc_oc=AdqYmIyBfYDPFzc7EKBAnvtLTFdkorYsCaSd_ypYZjc1ArySqN0cDfEYleqhhItrVS4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rExuEIddZOo1pBDMtIlRwj9Py38GohiJcAr4KS2TwjA&oe=6A36A51D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=719kdRqyfYAQ7kNvwFuQAyp&_nc_oc=AdqwyFi59aGx-pTLwIS6qN8qVvyhVDAZZFlSau0P7lg5tGRgVCUJ6LujbdeTMBZwY7U&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9VE2_heel9VoTMSRm0G6SMDJscy9Fiph50wUT2G9BM9g&oe=6A36BA04"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p8IuAEEVaCQQ7kNvwH6S9xN&_nc_oc=AdqflrTzz7gb8ASh9aaqQjowFEbmnteI1XNGQXIFc7511fvMdx9TUCyJUAb_Aa9y9Jw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85v7zwF2V5hbDU6_NuT4khUcHO4IvQlVxAYeED-E7BRg&oe=6A36B650"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vCwH9wTsc5QQ7kNvwHAywTE&_nc_oc=AdrlM2Zi2q_X987iwsL7di6mNfa4bD7jhFzjKO3RKgaY5wEkpf1HjGy6tJOBkP-wWds&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8lh53CWYvRMTR67PephpjwwVA4Rchy8FF_N8b0KbhpqA&oe=6A3695BC"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Experience profound emotional transformation through the rhythmic power of trance. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_w
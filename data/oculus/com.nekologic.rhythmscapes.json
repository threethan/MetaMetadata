CrPCs&_nc_oc=AdpHCUxdZ-XhHHpOqov2XxXEYxzM4aOSKfumuKnhiJizMqBA-zygLlrdYY8qHPvc970&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4hr81aOQYAi5Mvn7KJrP3_BIVog_oVi6Is7gmZTXHIQw&oe=6A0B1497"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j99DrP_6k-EQ7kNvwHOMrOu&_nc_oc=AdpQCgoFEMbt7CzwksGZW-UdosB_v74TA_UZ3Eg_XV4sh8nqST6oyJ3XjdG6gaPdAWA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4WUXv-4Ze-dEDL-XX7B4bvTHjN9dxMlOEeEnCdtyGVdA&oe=6A0B239D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oF_lKHvKsPgQ7kNvwHwN7hV&_nc_oc=Ado3eFPhlsC8afYwy6hf6V6pzXAFM0dteHVlBVSiZRK1ggrJH2KpHHiJ_5fsuwRcbsM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5sWE-G-Xo2zqUzfdU8vdK4aIujWeqrq5RPUh_yZUJmow&oe=6A0B0044"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uBLXgqlSyOYQ7kNvwF2BZIH&_nc_oc=AdrlwfCD19nfmQwZ8YACLNx_ZMrCxsoqG5a2kGiNqMgnb9eY4G9Uw05xirHLTz41nH4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-ossoG2DhchY5qdK59GJAoC-H1ADzNkEbVbkCChwG8A&oe=6A0B34D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vr70tNn1zA0Q7kNvwFqZc2o&_nc_oc=Ado2GdKxTiIT6iLP-zJTOmfZZcz0h-ui3FMhHynKohZDJgWzZyRUvMz6_c68-Ybplxo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4QgKf_YHlpTH3QRqkQgIRDAmkDpfrFgqFVuO8Mk3opQg&oe=6A0B143C"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Experience profound emotional transformation through the rhythmic power of trance. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url":
MQ7kNvwEwOsxl&_nc_oc=Adongsh71N6O5uRWeZ-yJYQOddsmuUGmg3qpds56aHWNBDjRG9Nmm0Il_Fo2kcqNVVI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKytXrjwjlIdV-7RWVox-gNwqRK5IhExzLWuLX1LGDOBw&oe=6AA94897"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2EyLImQpohIQ7kNvwFbrOZO&_nc_oc=AdqbLKuc1UJZUG4Uhm4lIA4Xkt3o7_SFeU4CiFTb_rIPwo4jmwm8PRRcB0l8_D-RxIM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJaKFnuzzM8FeWHXVrKEo39T-P2RiRMzit-mVe8CsVTg&oe=6AA9579D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t_OKlUTaOwwQ7kNvwGtA5QB&_nc_oc=AdqwFNhAqkvApvuh1GXaK-zaOuF52dIqjVtO2DKSNr3l0pFxesshFC3V12pVb1PQ6Sw&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKOnlKW3qByGdD58O9NzJnGiuus4cjASbvdaiLSoAtmYg&oe=6AA93444"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hsXH9tB7mN4Q7kNvwGIi6Gc&_nc_oc=AdqG_WNgUpnoAZxozTEGqakrQGFFa40JANVEoregrTbe7Wg9t8uK5nIfhikNU6H-uMI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKKwVDPHrrTnYO_bM6Fnl-GoweV7pJPtdVC8HD3nAT0DA&oe=6AA968D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fFr-qDd7QswQ7kNvwHmslq8&_nc_oc=Adpdk47XyiOa6CzI17c9MWpr0jE0l6PUEAo5WzQ_AukKKYY8tV21sRT5KvLIhQli5YM&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJwLly7LqZEHSYhTF8i4sZFCwcEXQnZ5ZdhStIBTxr1lg&oe=6AA9483C"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Experience profound emotional transformation through the rhythmic power of trance. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_w
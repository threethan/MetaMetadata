CQkP2IBBMnGYF5R0g2HkvZUDjX4WcA1y_cecLgwbGPY_pyKYw9BMJvlT9l3mEYM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-MRksB-spZJJgOJHQ4oBpvpSBZAj4jfRuAFNoyXNzRLg&oe=6A296717"}, {"file_name": "Rhythmscapes_screen3.png", "id": "519539870457888", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031466_519539873791221_1378693013483089961_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VOfSDerZOGAQ7kNvwHfcwpU&_nc_oc=AdrnAqVSu9yMHMVkgbkINjLxUmeLSNFb7q5CSIdTl3cPeiF9Uirwjqna17eS-vMpkHo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ChVncF6xrB7nMxByggYdaK6P9fuwwmD_6r6panmRcuw&oe=6A29761D"}, {"file_name": "Rhythmscapes_screen4.png", "id": "1238341174287306", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031390_1238341177620639_4671604069270433708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gd72FE5cplIQ7kNvwGHJM7w&_nc_oc=AdoFkm7kiLZ8Xlbifrh5VmnpEhRg1NzON7BHRTlNLZBF4AXiJbc3aS_uLI_YhM6AF1k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8aB5vs7xP5ATs4rvOp0Q7OahWE0yiMdjz7otBKCRRTQ&oe=6A2952C4"}, {"file_name": "Rhythmscapes_screen5.png", "id": "1050606736637639", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974452_1050606739970972_7100767552545007328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WIpQlXfT304Q7kNvwFeBjW2&_nc_oc=AdpK-Ce0SskZTUYdgyl3rZg6Ob9w_hscWlhebT8R-lqGfhWcSwl8yecKiMpFupXzIJc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9BKFJkbv5Le2oIi-a93OUpmhl7TBGaySGifKsfzjJMsg&oe=6A298750"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "3302404503227771", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974839_3302404509894437_4663117853999815641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WkVm6D0pWSwQ7kNvwF3FpIb&_nc_oc=Adr9oh_OKJG7rAJ1OZvKdjWx9BORwctLumYbtBEvX8N7sm7wIJt1UwpHJmDZbrGken0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9h3ptnOktRZ9yAid6nHHxsimOHLKanky_l2miRMDiDwQ&oe=6A2966BC"}, "display_name": "Rhythmscapes", "keywords": ["rhythm", "music", "mindfulness", "meditation", "drums"], "long_description": "Guided by an inner-rhythm spirit, take part in rhythm practices set within immersive visual environments. Enhance your focus and coordination while discovering the essence of your rhythm. Engage in drumming sessions driven by the science of human emotions - all of this achieved with just your bare hands, no controllers needed.\n\nRhythmscapes makes a groundbreaking leap, synthesising mindfulness and rhythm-based game mechanics into a single therapeutic experience within immersive VR.\n \n# Key Features:\n\n# - Music\n{1223000628904143}\nAt the heart of the experience are music sessions where the player must follow a rhythm pattern. These patterns begin with simple beats and become increasingly complex as the session progresses.\n\n\n\n# - Visualisation\n{526455803109312}\nPlayers ascend through increasingly immersive visualisations, culminating in an epic climax that delivers unmatched emotional satisfaction.\n\n\n\n# - Guidance\n{827710486113571}\nPlayers are guided by synchronised visual effects that help them stay in rhythm. The visual intensity increases with better performance, making each success even more rewarding.\n\n-\n\nIn this Early Access version, the app consist of five sessions in one environment. With future free updates you will receive more environments and sessions.\n\n\n\n\n", "short_description": "Get into your rhythmic zone with Rhythmscapes. Enter a rhythmic trance and use your focus and coordination to embark on a spiritual and emotional journey through a myriad of landscapes of sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "developer_terms_of_service_url": "https://rhythmscapesvr.com/privacy.php?n=Rhythmscapes", "publisher_name": "Nekologic", "support_website_url": null, "website_url": "https://rhythmscapesvr.com/", 
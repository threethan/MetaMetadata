1590472512860797", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499628446_1590472516194130_3945621239128227422_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ibPXsdJ9mXQQ7kNvwE8gjMa&_nc_oc=AdpzueNv2csQ4Imy_YFrilqcDrY7NZQFZdwjhk7sNyic7MQjUZhEoi_DtAcBJiUTLac&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjFt3iBSfiUVGOS4-PmizLQ7YDa8y-cgbEfBni2vtHEQ&oe=6AB916C2"}, {"file_name": "WorkAtHeight.png", "id": "2456365731556437", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593849888_2456365738223103_3536772861173196285_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O8nxVR5P_qIQ7kNvwGzf1kG&_nc_oc=AdpANHelsu8jYAExtoY698onJji5NYJbK9_EsxAqy0F0DrbELbFcAN2Y8HVm2qz7rAA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLa2up2XdM1_ZQ-GS92f5Sz-Ph8u526jK7L9zUUsluwxg&oe=6AB91DCF"}, {"file_name": "Welding.png", "id": "1709485223472393", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622192_1709485226805726_8857022345157011711_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rfKj26KwC58Q7kNvwFB5Ouf&_nc_oc=Adp9oPpaBvrfsc5hJUV1HcIDG_PGg1TQhEL4sutQ8-6FRoau-4Td485EDlI_ZG7oJt8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI84_mzJwxxV_YUlZ53GR5TtpT2XFnN1MNnnjzhB-PXkw&oe=6AB908FF"}, {"file_name": "ConveyorBelt.png", "id": "1096501572762526", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499626728_1096501576095859_5317470007211136617_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mnQWT7iipJ0Q7kNvwG4Fp8u&_nc_oc=Adre8sZMUI6K3fqjTIuQqTYW6DLtb-0hCW_7yrqQbM8DgofjJokvlml9QI4WuCADdyQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxLyJPZo4pynqihk74vRhbcc3Tm4en4_Ek7GIFhp9bFg&oe=6AB91B71"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverTrailer.png", "id": "2883603278677462", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620384_2883603282010795_5274140725570196003_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=txzfDaStSSgQ7kNvwHSE6Ce&_nc_oc=AdpWpB9s2-dDmKJTN5Iq0C30o72L5ltK93ujpPdIF1u1E_Kg5vhRyY9ifUybTw3z-xU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBLnOkjFwF-dSoFtXqVZaBW5P48FyNC6kmuZ7cLbsbxg&oe=6AB91E0E"}, "display_name": "AutoVRse - Standard Industry Modules", "keywords": ["training", "industrial", "safety", "industry", "autovrse"], "long_description": "AutoVRse builds VR training for industrial workforces. This app opens up a set of those modules so you can try them yourself.\n\nEach one is a real procedure rebuilt in VR. The equipment behaves the way it does on the floor, the steps follow an actual work instruction, and you learn by doing rather than watching a video.\n\nWHAT YOU CAN TRY\n\nSteel plant: carry out a furnace lancing operation in a live shop floor environment\nWarehouse logistics: diagnose and replace a flat belt on a package sorting line\nManufacturing: assemble a radiator unit on a production line\nPharmaceutical: operate sterile packaging equipment inside a cleanroom\nAviation ground operations: load cargo containers from warehouse to aircraft\n\nBUILT FOR FIRST TIMERS\n\nHand tracking or controllers, whichever you prefer\nVoice guidance and visual prompts at every step\nGetting it wrong is safe. The module corrects you and carries on\nMost sessions run 5 to 15 minutes\n\nEvery module here was made with VRseBuilder, AutoVRse's open source Unity SDK for building VR training. If you are weighing up VR for your own workforce, this is the quickest way to feel what a finished module is actually like.\n\nMore modules will be added over time.", "short_description": "Step onto an industrial shop floor without leaving your room.\n\nThis app collects sample VR training modules built by AutoVRse for heavy industry, manufacturing, logistics and pharma. Run a furnace lancing operation, replace a conveyor belt on a sorting line, assemble a unit on a production line, and more.\n\nHands or controllers. Guided step by step. No VR experience needed."}]}, 
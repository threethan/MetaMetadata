1590472512860797", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499628446_1590472516194130_3945621239128227422_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zm8_OEl-L-UQ7kNvwHe6xrM&_nc_oc=Adp6NuDcWoEIFCWFNtTIsfdTni-qDRNcjniHz6cUgV4Zx72ouuVfhPAyvBlI_CHlLYI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLLzlynGkKc3bcFZp6__7Dc0UuIj_0m98i8Zr19Cu9Raw&oe=6ABBB9C2"}, {"file_name": "WorkAtHeight.png", "id": "2456365731556437", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593849888_2456365738223103_3536772861173196285_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2v5-bmoWElAQ7kNvwHzXa7N&_nc_oc=AdqlumW_-5n5ObgHfBjLNyAPWCimVBnHl9vqf0PwoDJun4LnHjpNdQ0CaBriWfGYqzc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLrdrMdx5DRparcX5Pn67JXdhpipUiafUceOWgwh2xHbg&oe=6ABBC0CF"}, {"file_name": "Welding.png", "id": "1709485223472393", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622192_1709485226805726_8857022345157011711_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6N5f678Ooz4Q7kNvwEZ75J9&_nc_oc=Adop1gpfWars0uuIDrYu9Re926D3zAbWV1LuDrWL37w7UKNb2rLDfkkCQmbVe5ToYMI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLpOT1m_SsOYkeGI4F6TWCwa4LClmlN_vjP07H6zx4edQ&oe=6ABBE43F"}, {"file_name": "ConveyorBelt.png", "id": "1096501572762526", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499626728_1096501576095859_5317470007211136617_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Oc6GvZzfuAQ7kNvwHatPmi&_nc_oc=Ado0xlehIuRTBvPOnzXRXbLubherCSS_GccY6RxqXtNHgALczC1Z19GUoZ6TzM_fclQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKi_ftHTaYEFRGpM9P4FIiONlRLZ0mjlEKToOW3GtDglA&oe=6ABBBE71"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverTrailer.png", "id": "2883603278677462", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620384_2883603282010795_5274140725570196003_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=txzfDaStSSgQ7kNvwGlcD-y&_nc_oc=Adrq0mEl9APL_rQ67yezW5PsgLV7DiRgvu3RlVCZXYCk_huXlKZfHvVVOnEcLQkyUjI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-nZ67Lhr_HzvsbGllNAMZsTLTvMS35IE69ank9je5Zw&oe=6ABBC10E"}, "display_name": "AutoVRse - Standard Industry Modules", "keywords": ["training", "industrial", "safety", "industry", "autovrse"], "long_description": "AutoVRse builds VR training for industrial workforces. This app opens up a set of those modules so you can try them yourself.\n\nEach one is a real procedure rebuilt in VR. The equipment behaves the way it does on the floor, the steps follow an actual work instruction, and you learn by doing rather than watching a video.\n\nWHAT YOU CAN TRY\n\nSteel plant: carry out a furnace lancing operation in a live shop floor environment\nWarehouse logistics: diagnose and replace a flat belt on a package sorting line\nManufacturing: assemble a radiator unit on a production line\nPharmaceutical: operate sterile packaging equipment inside a cleanroom\nAviation ground operations: load cargo containers from warehouse to aircraft\n\nBUILT FOR FIRST TIMERS\n\nHand tracking or controllers, whichever you prefer\nVoice guidance and visual prompts at every step\nGetting it wrong is safe. The module corrects you and carries on\nMost sessions run 5 to 15 minutes\n\nEvery module here was made with VRseBuilder, AutoVRse's open source Unity SDK for building VR training. If you are weighing up VR for your own workforce, this is the quickest way to feel what a finished module is actually like.\n\nMore modules will be added over time.", "short_description": "Step onto an industrial shop floor without leaving your room.\n\nThis app collects sample VR training modules built by AutoVRse for heavy industry, manufacturing, logistics and pharma. Run a furnace lancing operation, replace a conveyor belt on a sorting line, assemble a unit on a production line, and more.\n\nHands or controllers. Guided step by step. No VR experience needed."}]}, 
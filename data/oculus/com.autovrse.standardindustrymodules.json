1590472512860797", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499628446_1590472516194130_3945621239128227422_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dpUf2xu-ygMQ7kNvwF3AzSu&_nc_oc=AdqoKwj_iQiJjMRlyneebaemwVjbEoKbleAfjXzHZnFBE2iy14HP-AdhLH34chNlwCI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKt3oXQFf_6zmk1gUqAfx4p3zGuq16IguckJXsEPzYVw&oe=6AB52242"}, {"file_name": "WorkAtHeight.png", "id": "2456365731556437", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/593849888_2456365738223103_3536772861173196285_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fE5ItEvQks8Q7kNvwFoxSoy&_nc_oc=Adrak2QZ3OOAci7Ms5NVnl3gfyTZFUCFYzkwzmUxhk4t_WO_V3lGbj2CHaBB3t212Cc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2TzDsK2AGy7ICB6_g_CIV--oswkvgQ2IoWh2PfthfKA&oe=6AB5294F"}, {"file_name": "Welding.png", "id": "1709485223472393", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622192_1709485226805726_8857022345157011711_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4fAk0DtiE-8Q7kNvwGY4OvM&_nc_oc=AdrsNT76ihsAuh_D8NlhbFjUWQyMY4G-AzxuTkUvDYNdOqSKvXmcZxRS8B6XZ0S349c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKH1weQe9sUHqtlZso4VwN8XK-tRqop66tQcpU0kmFKAA&oe=6AB54CBF"}, {"file_name": "ConveyorBelt.png", "id": "1096501572762526", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499626728_1096501576095859_5317470007211136617_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pG9S8l7UG8cQ7kNvwEUbSv_&_nc_oc=Adpa47adWen6r2_28_MhEQiJEl1b_wc0cXO-IOEYRFZWNZrZS6zPlECu4gYD6Ox-VMw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMwHh0PSBmXlKNFupKSmus9zsNRq4eQl8QrP52_js8Zw&oe=6AB526F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverTrailer.png", "id": "2883603278677462", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620384_2883603282010795_5274140725570196003_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o_zVoYF8r7sQ7kNvwEU2y8S&_nc_oc=AdpTxqkWVoxMakPW4s5BDKiyAW1KnZXs8kpeSb13HZOF1zMPWdmdxMHQlSEhAqSO5MY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLAAigjrvW1MHO3KK6fS9goJCrPFKAY7SsFUPYIJqMgsw&oe=6AB5298E"}, "display_name": "AutoVRse - Standard Industry Modules", "keywords": ["training", "industrial", "safety", "industry", "autovrse"], "long_description": "AutoVRse builds VR training for industrial workforces. This app opens up a set of those modules so you can try them yourself.\n\nEach one is a real procedure rebuilt in VR. The equipment behaves the way it does on the floor, the steps follow an actual work instruction, and you learn by doing rather than watching a video.\n\nWHAT YOU CAN TRY\n\nSteel plant: carry out a furnace lancing operation in a live shop floor environment\nWarehouse logistics: diagnose and replace a flat belt on a package sorting line\nManufacturing: assemble a radiator unit on a production line\nPharmaceutical: operate sterile packaging equipment inside a cleanroom\nAviation ground operations: load cargo containers from warehouse to aircraft\n\nBUILT FOR FIRST TIMERS\n\nHand tracking or controllers, whichever you prefer\nVoice guidance and visual prompts at every step\nGetting it wrong is safe. The module corrects you and carries on\nMost sessions run 5 to 15 minutes\n\nEvery module here was made with VRseBuilder, AutoVRse's open source Unity SDK for building VR training. If you are weighing up VR for your own workforce, this is the quickest way to feel what a finished module is actually like.\n\nMore modules will be added over time.", "short_description": "Step onto an industrial shop floor without leaving your room.\n\nThis app collects sample VR training modules built by AutoVRse for heavy industry, manufacturing, logistics and pharma. Run a furnace lancing operation, replace a conveyor belt on a sorting line, assemble a unit on a production line, and more.\n\nHands or controllers. Guided step by step. No VR experience needed."}]}, 
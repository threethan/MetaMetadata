1590472512860797", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499628446_1590472516194130_3945621239128227422_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dpUf2xu-ygMQ7kNvwEnea2R&_nc_oc=AdpEQZ1ZPItN8c7b_LBPt9gtM1Ie2JfLiutOuM0fuoKpQTXKmP28tEZavlpHArPjhT4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJaD8x7t5JLoYSY0zE2Qs3ilxYvnptr9xPt6XIrsMHz9w&oe=6AB3D0C2"}, {"file_name": "WorkAtHeight.png", "id": "2456365731556437", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593849888_2456365738223103_3536772861173196285_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fE5ItEvQks8Q7kNvwG9kULh&_nc_oc=AdqQKxLIeBAX7k9ojrT0LACblBDwSm72L8xjnfK8SD1D4lbUBfAKw702H0WM5swtFL0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLgAbnyfKjk7XHwlW8GLoAWnhpkBxaTydPthLw-GqR8Xg&oe=6AB3D7CF"}, {"file_name": "Welding.png", "id": "1709485223472393", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622192_1709485226805726_8857022345157011711_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4fAk0DtiE-8Q7kNvwHJebvu&_nc_oc=Adoamm3ph3Z9UuKVCjWc8w3hT4E88RRU55r3w6bj-Dgr0wrx7AM6vfLwMS8S1o1WmJ4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIC-87AP6LgaVdDVWfQFeDE7ZTfudLvJw1-Tv9HO4WRA&oe=6AB3C2FF"}, {"file_name": "ConveyorBelt.png", "id": "1096501572762526", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499626728_1096501576095859_5317470007211136617_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pG9S8l7UG8cQ7kNvwHnqNnc&_nc_oc=AdpGmxi1CjTLOhGBu9Ny1V_rEpuaw7pxuApWFUQHY1oYpOr9qv6NK7jZpdVL6bJ58K0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFLtpsApUlyHdFRKPMtV3_swZQ6MI7AtkcTsopjj2P_A&oe=6AB3D571"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverTrailer.png", "id": "2883603278677462", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620384_2883603282010795_5274140725570196003_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HwsaHdz010sQ7kNvwFDYd63&_nc_oc=AdpByheOrEIWK2eK4IcRim2dMP5NcatN391PCinK7I4kYlVBZJ_r7AatcNW9KcezNRc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmeY_nxDu7C7aqyFi8DY5qB-RNSSwg5w9G6FwkQ6oN5Q&oe=6AB3D80E"}, "display_name": "AutoVRse - Standard Industry Modules", "keywords": ["training", "industrial", "safety", "industry", "autovrse"], "long_description": "AutoVRse builds VR training for industrial workforces. This app opens up a set of those modules so you can try them yourself.\n\nEach one is a real procedure rebuilt in VR. The equipment behaves the way it does on the floor, the steps follow an actual work instruction, and you learn by doing rather than watching a video.\n\nWHAT YOU CAN TRY\n\nSteel plant: carry out a furnace lancing operation in a live shop floor environment\nWarehouse logistics: diagnose and replace a flat belt on a package sorting line\nManufacturing: assemble a radiator unit on a production line\nPharmaceutical: operate sterile packaging equipment inside a cleanroom\nAviation ground operations: load cargo containers from warehouse to aircraft\n\nBUILT FOR FIRST TIMERS\n\nHand tracking or controllers, whichever you prefer\nVoice guidance and visual prompts at every step\nGetting it wrong is safe. The module corrects you and carries on\nMost sessions run 5 to 15 minutes\n\nEvery module here was made with VRseBuilder, AutoVRse's open source Unity SDK for building VR training. If you are weighing up VR for your own workforce, this is the quickest way to feel what a finished module is actually like.\n\nMore modules will be added over time.", "short_description": "Step onto an industrial shop floor without leaving your room.\n\nThis app collects sample VR training modules built by AutoVRse for heavy industry, manufacturing, logistics and pharma. Run a furnace lancing operation, replace a conveyor belt on a sorting line, assemble a unit on a production line, and more.\n\nHands or controllers. Guided step by step. No VR experience needed."}]}, 
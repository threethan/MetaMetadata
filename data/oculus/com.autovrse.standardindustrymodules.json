1590472512860797", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499628446_1590472516194130_3945621239128227422_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tnMDA2gOFCIQ7kNvwGGob67&_nc_oc=Adq1og5ljub6UGvfo-XUbTEU9rj2Pb5hx8t48aRZX9ycJqx6QjiO8fz5PsRRlD-gK2Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLk0lwqDAIKB02lFAVMnqFMa1bzRuQkgXjfJtpxxNQXzA&oe=6AB27F42"}, {"file_name": "WorkAtHeight.png", "id": "2456365731556437", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/593849888_2456365738223103_3536772861173196285_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fE5ItEvQks8Q7kNvwFQpZ5s&_nc_oc=AdrtIwq5S8KTRaUJNpj2s--5QRf6_Zoiy6YAJcg_tM3IqeA7r9rOlJF_DfTRavEt9x0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLRSL0RxWr78My7vp5T9fMIKoR-i63t1EwyPQ27Uc81GQ&oe=6AB2864F"}, {"file_name": "Welding.png", "id": "1709485223472393", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622192_1709485226805726_8857022345157011711_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4fAk0DtiE-8Q7kNvwFMswLr&_nc_oc=AdrXI5FnHsZQowXbjhCcW8VE1mTNjuVcw4o6qqRxySw29xJv-q_ptfORHPEfaPZceMw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFZVZR23aBLmW-3N4onryTQaKn_tMSTB_T0e_BEEu3hA&oe=6AB2717F"}, {"file_name": "ConveyorBelt.png", "id": "1096501572762526", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499626728_1096501576095859_5317470007211136617_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mmZTeqXuL5wQ7kNvwHp0dD6&_nc_oc=AdoRoGEkUKSYeS88pBCiOMzAKNcoKJ_R7LF3ZD22haKT0aDs9RsgAoyDZ43M4blQ8yU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBPgFGJ-apyZvAKTRn_6tgY7oqdlSirbiVj92Ou2BgkA&oe=6AB283F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverTrailer.png", "id": "2883603278677462", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620384_2883603282010795_5274140725570196003_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HwsaHdz010sQ7kNvwHzz_YO&_nc_oc=Adr5ECem7eDMGDm3jfQk6LMORmP_J8KyVMD-nIaJWUuH5HukN5muC88A4hh2a5tT7vY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJULdv-ofy7BWbkL4pDjAdNrqQHUQumqKy2954_oYTw8w&oe=6AB2868E"}, "display_name": "AutoVRse - Standard Industry Modules", "keywords": ["training", "industrial", "safety", "industry", "autovrse"], "long_description": "AutoVRse builds VR training for industrial workforces. This app opens up a set of those modules so you can try them yourself.\n\nEach one is a real procedure rebuilt in VR. The equipment behaves the way it does on the floor, the steps follow an actual work instruction, and you learn by doing rather than watching a video.\n\nWHAT YOU CAN TRY\n\nSteel plant: carry out a furnace lancing operation in a live shop floor environment\nWarehouse logistics: diagnose and replace a flat belt on a package sorting line\nManufacturing: assemble a radiator unit on a production line\nPharmaceutical: operate sterile packaging equipment inside a cleanroom\nAviation ground operations: load cargo containers from warehouse to aircraft\n\nBUILT FOR FIRST TIMERS\n\nHand tracking or controllers, whichever you prefer\nVoice guidance and visual prompts at every step\nGetting it wrong is safe. The module corrects you and carries on\nMost sessions run 5 to 15 minutes\n\nEvery module here was made with VRseBuilder, AutoVRse's open source Unity SDK for building VR training. If you are weighing up VR for your own workforce, this is the quickest way to feel what a finished module is actually like.\n\nMore modules will be added over time.", "short_description": "Step onto an industrial shop floor without leaving your room.\n\nThis app collects sample VR training modules built by AutoVRse for heavy industry, manufacturing, logistics and pharma. Run a furnace lancing operation, replace a conveyor belt on a sorting line, assemble a unit on a production line, and more.\n\nHands or controllers. Guided step by step. No VR experience needed."}]}, 
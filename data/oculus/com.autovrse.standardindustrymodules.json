1590472512860797", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499628446_1590472516194130_3945621239128227422_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tnMDA2gOFCIQ7kNvwEzSCIl&_nc_oc=AdpQJwQvFy15aOOJ9aTmo_OmVA7hrBrVt13hFUf7n9J7zxWGcUeqqnwlLxGGDSF0PNc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLmsUlDO8wrgqzh-WucFIKo7uR1ZEdxUwjdN2lcwpyAKA&oe=6AB12DC2"}, {"file_name": "WorkAtHeight.png", "id": "2456365731556437", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/593849888_2456365738223103_3536772861173196285_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OdVvLUz_MaUQ7kNvwEn1Gki&_nc_oc=AdqasMe4lsCNg40mEkL9YfLckQ4vIOI6Hg34G-WjRtiHUbY-X3hMDJG6qWELc7t0Edg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpPF5SLzKlAFSuJoDpbRHLix8UvxpNGc2Jmd_kJKnz7g&oe=6AB134CF"}, {"file_name": "Welding.png", "id": "1709485223472393", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622192_1709485226805726_8857022345157011711_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6F8gVtIjwiQQ7kNvwEa7BVU&_nc_oc=AdrUS5OLLIlrpvB8HRe8ViG-XszE4XEgORhezdjazx75NCA6sVkCF-yHhABJwyZDeGY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbBknHcKc_faCRD-hJtq05OA5RGJkM1N4brHP93bujow&oe=6AB1583F"}, {"file_name": "ConveyorBelt.png", "id": "1096501572762526", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499626728_1096501576095859_5317470007211136617_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mmZTeqXuL5wQ7kNvwEFi0T2&_nc_oc=AdpATaic905vtTGJrLERiF2PIU1md1Dl_wmhUqU09M3vvE4mC9tc9n-FZ_K7o6q2qk4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5xup9_AD-Ah6OznfRtgdYjRqGSDjTUwt8C7zI2IAxkw&oe=6AB13271"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverTrailer.png", "id": "2883603278677462", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620384_2883603282010795_5274140725570196003_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HwsaHdz010sQ7kNvwHK6Qsr&_nc_oc=Adpt-v44b-f-vsVkbu254-vjNozbQvJEEKPOEX34LIO4zp0_jync_N6A1_MsmXt8zr0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdirVfTFIU1ddHnGGnd7U21wq4L22x54EDQ0a-DKmMaw&oe=6AB1350E"}, "display_name": "AutoVRse - Standard Industry Modules", "keywords": ["training", "industrial", "safety", "industry", "autovrse"], "long_description": "AutoVRse builds VR training for industrial workforces. This app opens up a set of those modules so you can try them yourself.\n\nEach one is a real procedure rebuilt in VR. The equipment behaves the way it does on the floor, the steps follow an actual work instruction, and you learn by doing rather than watching a video.\n\nWHAT YOU CAN TRY\n\nSteel plant: carry out a furnace lancing operation in a live shop floor environment\nWarehouse logistics: diagnose and replace a flat belt on a package sorting line\nManufacturing: assemble a radiator unit on a production line\nPharmaceutical: operate sterile packaging equipment inside a cleanroom\nAviation ground operations: load cargo containers from warehouse to aircraft\n\nBUILT FOR FIRST TIMERS\n\nHand tracking or controllers, whichever you prefer\nVoice guidance and visual prompts at every step\nGetting it wrong is safe. The module corrects you and carries on\nMost sessions run 5 to 15 minutes\n\nEvery module here was made with VRseBuilder, AutoVRse's open source Unity SDK for building VR training. If you are weighing up VR for your own workforce, this is the quickest way to feel what a finished module is actually like.\n\nMore modules will be added over time.", "short_description": "Step onto an industrial shop floor without leaving your room.\n\nThis app collects sample VR training modules built by AutoVRse for heavy industry, manufacturing, logistics and pharma. Run a furnace lancing operation, replace a conveyor belt on a sorting line, assemble a unit on a production line, and more.\n\nHands or controllers. Guided step by step. No VR experience needed."}]}, 
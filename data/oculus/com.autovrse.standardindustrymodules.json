n.com/v/t64.5771-25/499626728_1096501576095859_5317470007211136617_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mMUwB6xPsbcQ7kNvwH7EuS9&_nc_oc=AdoA7-PKchqmmzv8vC_nCULI7m-rrFu1GqcUSq75_qN1nH5RiY_IVLX1vvAtcvticKM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOUZXTBo7jz3pfiBxuk0J3-Tg5sOsHWws50xclb5nPImQ&oe=6ACD1A31"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverTrailer.png", "id": "2883603278677462", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620384_2883603282010795_5274140725570196003_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UMutFqQmMtQQ7kNvwE5_uCc&_nc_oc=AdrWIkGJu4yRAFLc5c2p-5uDzyZpB3ejH8z5mAmsJMlKNPQMQULJ2qyE8WSnMa6qXSE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNgMmlBGIxyqOG76XqoqaBpQGgAr8Tl8O0gIqYvHVb7wQ&oe=6ACCE48E"}, "display_name": "AutoVRse - Standard Industry Modules", "keywords": ["training", "industrial", "safety", "industry", "autovrse"], "long_description": "AutoVRse builds VR training for industrial workforces. This app opens up a set of those modules so you can try them yourself.\n\nEach one is a real procedure rebuilt in VR. The equipment behaves the way it does on the floor, the steps follow an actual work instruction, and you learn by doing rather than watching a video.\n\nFREE MODULES\n\nLOTO Basics: Mechanical Safety \u2014 lock out and tag out mechanical equipment safely before maintenance\nPPE Fundamentals \u2014 select and wear the right protective equipment for the job\n\nPAID MODULES\n\nLOTO Basics: Electrical Safety \u2014 de-energize and lock out electrical systems before working on them\nGas Cutting \u2014 set up and operate oxy-fuel cutting equipment safely\nWelding Safety \u2014 spot hazards and follow safe practice during arc welding\nConveyor Belt \u2014 diagnose and replace a flat belt on a sorting line\nWorking at Height \u2014 use fall protection correctly for elevated work\nElectrical Safety \u2014 handle live electrical systems and equipment without incident\nConfined Spaces \u2014 run entry checks and controls before confined space work\nDefensive Driving \u2014 drive industrial and site vehicles safely\nFire Safety \u2014 recognize fire hazards and respond correctly in an emergency\nForklift Safety \u2014 operate a forklift and handle loads safely on the shop floor\n\nBUILT FOR FIRST TIMERS\n\nHand tracking or controllers, whichever you prefer\nVoice guidance and visual prompts at every step\nGetting it wrong is safe. The module corrects you and carries on\nMost sessions run 5 to 15 minute", "short_description": "Step onto an industrial shop floor without leaving your room.\n\nThis app collects sample VR training modules built by AutoVRse for heavy industry, manufacturing, logistics and pharma. Run a furnace lancing operation, replace a conveyor belt on a sorting line, assemble a unit on a production line, and more.\n\nHands or controllers. Guided step by step. No VR experience needed."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs-vrsebuilder.autovrse.app/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "AutoVRse", "support_website_url": null, "website_url": "https://autovrse.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1097948869386375"}, "review_messages": []}]}, "cover_
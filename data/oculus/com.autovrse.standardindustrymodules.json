1590472512860797", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499628446_1590472516194130_3945621239128227422_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qirI88FjggkQ7kNvwHB5vFM&_nc_oc=Ado-_pNC7CrPba1ixvfU6E-pspHgcvvWtMupDJk2B6VwI4FRBw283eSEVkwWubPsITc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOmKUwP0Y4TFxZ2mAka6o8n5RAukSUiR6yTkbl3H5Ub5Q&oe=6ABFAE42"}, {"file_name": "WorkAtHeight.png", "id": "2456365731556437", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593849888_2456365738223103_3536772861173196285_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FZRaZwFi_u8Q7kNvwEvoceS&_nc_oc=AdrIKdTr6esWifHrQ-pKRnSP9m_OVHPmGUY9eHzs6POvVacn9qcTWRA8pEN80MWJTYY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOfuG-Q-0Zgk8WgbYT1s3M2IVjHx2je3mcI1_AFlVPoqQ&oe=6ABFB54F"}, {"file_name": "Welding.png", "id": "1709485223472393", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622192_1709485226805726_8857022345157011711_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ph_LJiyxU-IQ7kNvwFphHAi&_nc_oc=AdomBiRU6hD8zCjjaYbK1Wmpxz8_Jg_sRK9IOaR0AbxwFAWyvdeR7t59JqCiHHfNKJY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOqXXSXjS089yzmq_9McMM_QIFXEcIuWkeRn3QDYgW_5Q&oe=6ABFD8BF"}, {"file_name": "ConveyorBelt.png", "id": "1096501572762526", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499626728_1096501576095859_5317470007211136617_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W2wf3uJmQ84Q7kNvwGrdekC&_nc_oc=AdoXDIznjRhjSldTGSSh8s3idV10asSx3iWT8xTmjdaZMlgH3xHh6FoqXvBDgJF9Lac&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPoZXRCxUmWn0MJCXXtH9VJfmLX8BP_Az5k5UlMLRpZ3g&oe=6ABFB2F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverTrailer.png", "id": "2883603278677462", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620384_2883603282010795_5274140725570196003_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KvsVqeDoWmkQ7kNvwH2WuNy&_nc_oc=AdqesHNvuqR4QbfGlJMtFI7VIYQamHK13h75Sfk0K0GamKNYV0YUz2i1MlrtaAPxXws&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOo4IVHSDne_K4htGBwTPkm2zcBgONY6_ErzQq3257yvQ&oe=6ABFB58E"}, "display_name": "AutoVRse - Standard Industry Modules", "keywords": ["training", "industrial", "safety", "industry", "autovrse"], "long_description": "AutoVRse builds VR training for industrial workforces. This app opens up a set of those modules so you can try them yourself.\n\nEach one is a real procedure rebuilt in VR. The equipment behaves the way it does on the floor, the steps follow an actual work instruction, and you learn by doing rather than watching a video.\n\nWHAT YOU CAN TRY\n\nSteel plant: carry out a furnace lancing operation in a live shop floor environment\nWarehouse logistics: diagnose and replace a flat belt on a package sorting line\nManufacturing: assemble a radiator unit on a production line\nPharmaceutical: operate sterile packaging equipment inside a cleanroom\nAviation ground operations: load cargo containers from warehouse to aircraft\n\nBUILT FOR FIRST TIMERS\n\nHand tracking or controllers, whichever you prefer\nVoice guidance and visual prompts at every step\nGetting it wrong is safe. The module corrects you and carries on\nMost sessions run 5 to 15 minutes\n\nEvery module here was made with VRseBuilder, AutoVRse's open source Unity SDK for building VR training. If you are weighing up VR for your own workforce, this is the quickest way to feel what a finished module is actually like.\n\nMore modules will be added over time.", "short_description": "Step onto an industrial shop floor without leaving your room.\n\nThis app collects sample VR training modules built by AutoVRse for heavy industry, manufacturing, logistics and pharma. Run a furnace lancing operation, replace a conveyor belt on a sorting line, assemble a unit on a production line, and more.\n\nHands or controllers. Guided step by step. No VR experience needed."}]}, 
1590472512860797", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499628446_1590472516194130_3945621239128227422_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ibPXsdJ9mXQQ7kNvwH3KE_j&_nc_oc=AdpPkJ7xbpnnOhmqLJBJt7zjfE0SN65fVvSjaLtft2FIehn-ciVaXbpiFzkxYQE_J18&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIwr5nboon3QDwnsQtdaJDbWCa0YwY-eiqoanhGR3h5cA&oe=6ABA6842"}, {"file_name": "WorkAtHeight.png", "id": "2456365731556437", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/593849888_2456365738223103_3536772861173196285_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2v5-bmoWElAQ7kNvwFBOWFD&_nc_oc=AdrISmGQQcSrKK6l6eAFENIcJp2XOJNn5YRCrYyvqo1bJe_aL5y5kw5OVgkF6wrxBpc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKM3-tBbYEyoj-Pk-WiZoc2wLzGLUw_sKyMOX6lln_ABA&oe=6ABA6F4F"}, {"file_name": "Welding.png", "id": "1709485223472393", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622192_1709485226805726_8857022345157011711_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6N5f678Ooz4Q7kNvwGK8vsE&_nc_oc=AdqiMZ5Cjx80NCqHK-oxacubiSo5Mn69tmB1ZUP0HiFIqXLEpjY-xfR-tuNxfHQpqTk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKyA5nAcf8jYf_2hF4xiSfwu5XU70WxjSY-4_SQir4ZrQ&oe=6ABA5A7F"}, {"file_name": "ConveyorBelt.png", "id": "1096501572762526", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499626728_1096501576095859_5317470007211136617_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mnQWT7iipJ0Q7kNvwG_PbJX&_nc_oc=AdqbQqhNczmjYQeeTqbjUazaTwLinvJxZp2jMlLUKmR2qn9S5F2x_U54us1jPVD_QSM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJea85duMBu9uQsHkgAbbPEkqpUuYsJPpLYnjShtL2Zcw&oe=6ABA6CF1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverTrailer.png", "id": "2883603278677462", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620384_2883603282010795_5274140725570196003_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=txzfDaStSSgQ7kNvwGEiy2o&_nc_oc=AdpqcPc8aktTj0k1J3QL5NreSLLwFPeOttZMH_XnU2PeIlZzo_hSkpbI6NZd8gB5-k8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLf_dyYfLzgs_CEyWGlmg57PfpOWHi5P7_U8MwwOW9hDg&oe=6ABA6F8E"}, "display_name": "AutoVRse - Standard Industry Modules", "keywords": ["training", "industrial", "safety", "industry", "autovrse"], "long_description": "AutoVRse builds VR training for industrial workforces. This app opens up a set of those modules so you can try them yourself.\n\nEach one is a real procedure rebuilt in VR. The equipment behaves the way it does on the floor, the steps follow an actual work instruction, and you learn by doing rather than watching a video.\n\nWHAT YOU CAN TRY\n\nSteel plant: carry out a furnace lancing operation in a live shop floor environment\nWarehouse logistics: diagnose and replace a flat belt on a package sorting line\nManufacturing: assemble a radiator unit on a production line\nPharmaceutical: operate sterile packaging equipment inside a cleanroom\nAviation ground operations: load cargo containers from warehouse to aircraft\n\nBUILT FOR FIRST TIMERS\n\nHand tracking or controllers, whichever you prefer\nVoice guidance and visual prompts at every step\nGetting it wrong is safe. The module corrects you and carries on\nMost sessions run 5 to 15 minutes\n\nEvery module here was made with VRseBuilder, AutoVRse's open source Unity SDK for building VR training. If you are weighing up VR for your own workforce, this is the quickest way to feel what a finished module is actually like.\n\nMore modules will be added over time.", "short_description": "Step onto an industrial shop floor without leaving your room.\n\nThis app collects sample VR training modules built by AutoVRse for heavy industry, manufacturing, logistics and pharma. Run a furnace lancing operation, replace a conveyor belt on a sorting line, assemble a unit on a production line, and more.\n\nHands or controllers. Guided step by step. No VR experience needed."}]}, 
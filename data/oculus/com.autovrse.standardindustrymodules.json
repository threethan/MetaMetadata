FC2"}, {"file_name": "WorkAtHeight.png", "id": "2456365731556437", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593849888_2456365738223103_3536772861173196285_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FZRaZwFi_u8Q7kNvwH8KXT-&_nc_oc=AdpfKqUdDy3G0e8z0GbcUNfLfgKEwXh3wRd7uSF7Qa9wutCjQoq5NTCu-O9UHW96q8M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPEXcvjbng2AJCnHrI0aLH63XkkiYl5IdN7QmwFJDtzlA&oe=6AC106CF"}, {"file_name": "Welding.png", "id": "1709485223472393", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622192_1709485226805726_8857022345157011711_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ph_LJiyxU-IQ7kNvwH8S2kZ&_nc_oc=AdoT1F1Yy2HyxzpGFSnLKJ1pL0NIZnvh3f6QopDYrkRaKOZ1N6fT8I6pY9u-G7J1a-I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMupWYV7P7R6KWEmL11rTi6d6b2NMacqob7QImAw4xaIQ&oe=6AC12A3F"}, {"file_name": "ConveyorBelt.png", "id": "1096501572762526", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499626728_1096501576095859_5317470007211136617_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W2wf3uJmQ84Q7kNvwE9sqdG&_nc_oc=AdqtBw1WzU7WjfRVnSWpwWgSzRBAZToW9sSQmLfjSDYTTBNSvQwA_JrSL6Ko05N0hRM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMCVxP2lMEx6_pPckqeti1OtCCGWueua1J3MOAf09XViw&oe=6AC10471"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverTrailer.png", "id": "2883603278677462", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620384_2883603282010795_5274140725570196003_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UELJavntqN4Q7kNvwHpgYFN&_nc_oc=AdrlVU-SZx4B4r3nVt0fHVOlOQE4aha9u33VKt-l_jo_9O_EWp7tcqwxg5wphkCrZFM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOIh3I65x6LhxZS0DGlRQTMRTeV6oOA8DVUYqEzelfefA&oe=6AC1070E"}, "display_name": "AutoVRse - Standard Industry Modules", "keywords": ["training", "industrial", "safety", "industry", "autovrse"], "long_description": "AutoVRse builds VR training for industrial workforces. This app opens up a set of those modules so you can try them yourself.\n\nEach one is a real procedure rebuilt in VR. The equipment behaves the way it does on the floor, the steps follow an actual work instruction, and you learn by doing rather than watching a video.\n\nWHAT YOU CAN TRY\n\nSteel plant: carry out a furnace lancing operation in a live shop floor environment\nWarehouse logistics: diagnose and replace a flat belt on a package sorting line\nManufacturing: assemble a radiator unit on a production line\nPharmaceutical: operate sterile packaging equipment inside a cleanroom\nAviation ground operations: load cargo containers from warehouse to aircraft\n\nBUILT FOR FIRST TIMERS\n\nHand tracking or controllers, whichever you prefer\nVoice guidance and visual prompts at every step\nGetting it wrong is safe. The module corrects you and carries on\nMost sessions run 5 to 15 minutes\n\nEvery module here was made with VRseBuilder, AutoVRse's open source Unity SDK for building VR training. If you are weighing up VR for your own workforce, this is the quickest way to feel what a finished module is actually like.\n\nMore modules will be added over time.", "short_description": "Step onto an industrial shop floor without leaving your room.\n\nThis app collects sample VR training modules built by AutoVRse for heavy industry, manufacturing, logistics and pharma. Run a furnace lancing operation, replace a conveyor belt on a sorting line, assemble a unit on a production line, and more.\n\nHands or controllers. Guided step by step. No VR experience needed."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs-vrsebuilder.autovrse.app/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "AutoVRse", "support_website_url": null, "website_url": "https://autovrse.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category
! This immersive virtual reality experience lets you take control of a fully interactive kitchen, where you can slice, dice, saut\u00e9, and plate your way to culinary perfection.\n\nMaster a variety of recipes, from simple comfort food to gourmet masterpieces. Play solo or challenge friends in competitive cooking modes. With realistic physics, time-based challenges, and an ever-expanding menu of dishes, Master Chef VR brings the thrill of a professional kitchen to your fingertips. Are you ready to become the ultimate virtual chef?", "short_description": "Step into the ultimate VR kitchen in Master Chef VR! Chop, cook, and serve dishes like a real chef in this immersive cooking experience. Compete against the clock, master new recipes, and rise to the top of the culinary world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tulipapps.com/meta-quest-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tulip Apps", "support_website_url": null, "website_url": "https://www.tulipapps.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9070327036412245"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392005_1164461551528230_3374536817324051771_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jxYeL
=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNScXpMnSqbkILK8Fkj75BOzQjH-GWH2XBq-hOuh-B7bQ&oe=6AC13073"}, {"file_name": "screenshot4.png", "id": "2569596350122628", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307346_2569596353455961_2524643812661871146_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rq2bR_9hPIUQ7kNvwETh6zg&_nc_oc=AdoZrsplgp7aC8iR4y38HNLo8ZckBFYb5IoyoZnk1gQStIsoT6kRPwHSlb5SXJICC90&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOHR5MSRB_Bl9b1EcPWr5rrY_uqD1mr9xuZRD4LOr0Ysw&oe=6AC10238"}, {"file_name": "screenshot5.png", "id": "26625088943770968", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499300678_26625088947104301_8864685217833472890_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8AS8Ak1h7koQ7kNvwGLKMjE&_nc_oc=AdrPN-6zkggZenPeLfZHQF1V7TlJHXzb0dOY0WWndXKq4ERYjUOEouhQ39iTw37xiQg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNqhJjnEtGEpRu0qFkYVhyjQu9tUBpa1yoJDeWHaupRgw&oe=6AC11984"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SPL1T RUNNERS", "keywords": ["Fun"], "long_description": "SPL1T RUNNERS is a fan-made experience inspired by Gorilla Tag that brings players together in a fun, social environment with exciting seasonal themes. Use fast and creative movement to run, climb, and explore unique maps while hanging out with friends and meeting new players.\n\nThe game focuses on social fun, smooth movement, and a constantly changing seasonal atmosphere. Each environment is designed to feel lively and different, giving players new places to explore and enjoy.\n\nPlayers can join lobbies, interact with others, and customize their look with different cosmetics while experiencing the playful chaos that makes movement-based games so entertaining.\n\nWhether you're exploring maps, messing around with friends, or just enjoying the vibe, project spec is all about community, creativity, and fun.", "short_description": "SPL1T RUNNERS is a fan-made game inspired by Gorilla Tag where players can run, climb, and explore seasonal maps with friends. Hang out in social lobbies, discover fun cosmetics, and enjoy fast-paced movement in a fresh seasonal world."}]}, "developer_name": "FROZO", "developer_privacy_policy_url": "https://sites.google.com/view/spl1trunners/home", "developer_terms_of_service_url": null, "publisher_name": "FROZO", "support_website_url": null, "website_url": "https://sites.google.com/view/spl1t-runners/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "26590197737239494"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26611335355125732", "version": "1.1.1"}, "id": "1546496563115894", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26544261655166436", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26611335355125732"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1546496563115894"}]}, "change_lo
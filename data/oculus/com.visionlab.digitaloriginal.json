slgU9w&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9gj_XL9mhs52Oyc8UdP5MXGrnw-iv6gxp-La4kNhwKGA&oe=6A36BEB9"}, {"file_name": "3.png", "id": "4320279514913426", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491823949_4320279518246759_2478925597764088414_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cr3cpQbHEwcQ7kNvwGqNpPY&_nc_oc=Adpt91LYnlFy7lG8hXkPIz8ulk3-8fnRVjjYc4aI2t229UuikfvozSOAtcB-kmf94sk&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8yNobzlE2v_lkvwWgQu9JuTTh5uWFRJoQQOkpY-GgWZg&oe=6A36B012"}, {"file_name": "1.png", "id": "3314700085357264", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491821702_3314700088690597_2815337253995025837_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D0-UOSBJdNkQ7kNvwEOSBRd&_nc_oc=AdqggP6YLStz7Ax8EIIutBPCsPqO0qKljLAx31siz7-UwYyv_lFjHS-qGZDuIUYDSrY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9656rIsmdMM1yOXkPoeCRarK9enW5RPAGy2l6nLoqjHQ&oe=6A36A767"}, {"file_name": "lobby.png", "id": "921882360670001", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491818852_921882367336667_9140196840640448046_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JwhWG2tVpWcQ7kNvwGzHRwi&_nc_oc=AdrW3wuM9reuTp9AgNTYSAJg8BdTF-TbWudYNG90o8K9rD-3m-H2pIeX3ig44inam4I&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9oSJGnXfpLmIYuhaQztagHvlk-09_grwOJuo8wddzUYQ&oe=6A36B56E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DO XR", "keywords": ["art", "vrart", "gallery", "exhibition", "digital"], "long_description": "Our app may display streaming videos, which require a good internet connection and may not be available at all times.\n\nDigital Original is an immersive art viewer for Meta Quest that transforms how you experience digital and contemporary art.\n\nUnlike traditional virtual galleries, Digital Original is built around presence, quality, and scale. As you move closer to an artwork, you reveal its details \u2014 just like in a real exhibition.\n\nExperience art beyond the screen\n\nEnter curated VR spaces or bring artworks into your real environment using XR. Place pieces on your walls, walk around them, and explore them in full scale.\n\nAll artworks are XR-ready, uploaded by artists and galleries for intentional spatial presentation.\n\nDiscover and access art instantly\n\nScan QR codes from Digital Original Stores to open artworks in XR. Build your own space and create a personal exhibition anywhere.\n\nView solo or together\n\nExplore art alone or with others:\n\t\u2022\tJoin public VR rooms\n\t\u2022\tCreate private rooms and invite friends\n\t\u2022\tTalk and explore with built-in voice chat\n\nDesigned for a real art experience\n\t\u2022\tHigh-resolution images and video\n\t\u2022\tTrue sense of scale and proximity\n\t\u2022\tCurated environments, not chaotic feeds\n\nDigital Original is a new way to experience digital art \u2014 with presence, context, and space.", "short_description": "Digital Original is an immersive XR & VR art experience to explore, curate, and share digital and contemporary art in virtual and real spaces. Enter curated exhibitions or create your own rooms, place artworks on your walls, and invite others. Experience art with real depth and presence \u2014 not as content, but as space."}]}, "developer_name": "Vision Lab", "developer_privacy_policy_url": "https://digitaloriginal.app/xr-privacy-policy", "developer_terms_of_service_url": "https://digitaloriginal.app/xr-terms-of-use", "publisher_name": "Digital Original", "support_website_url": null, "website_url": "https://digitaloriginal.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1819021644882647"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "intern
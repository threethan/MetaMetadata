52097282_45259345311995333_n.png", "id": "1043165513555079", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57568677_1043165516888412_8365579769165241008_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EoqJh6n3xTcQ7kNvwHp2isf&_nc_oc=AdmCLM53FTwUFG2lcLHftflF4uev0nYn4-9V60YiaQqQePEs3tPudjPJaumJ4PYYf0s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy5rI-160dUW8loBmjnZS0nfGtu2MvNqbJ3RSChJIIkBQ&oe=69AEA4D6"}, "display_name": "EduVenture-Meta", "keywords": [], "long_description": "A must have e-learning tool for 21st century learning and teaching.\n\nBased on the EduVenture outdoor learning system. EduVenture-Meta is an ultimate solution for teachers to carry out VR learning in a classroom.\n\nComposing VR learning materials via the web-based authoring tools is fun and effortless. Teacher can distribute the VR content seamlessly via the EduVenture-VR App to their students.", "short_description": "EduVenture-Meta is an ultimate solution for teachers to carry out VR learning in a classroom."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ev-cuhk.net/agreement/ev-meta_privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Centre for Learning Sciences and Technologies", "support_website_url": null, "website_url": "https://clst.fed.cuhk.edu.hk/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "710586
zcuLE8_52nYzRcW_VuGxx3hW7Jw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU4l5VWp4EToT0vFrID94uypf3wwprB5sx20IBYH9YpuQ&oe=6B0EFB45"}, {"file_name": "SantasGiftToss_Screenshot_02_2560x1440.png", "id": "30429916333264604", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908887012_30429916353264602_6047564940431403963_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K8SUEh4DRBMQ7kNvwHlXCsd&_nc_oc=Adrnm8OHV9IVWSEP-fN4F5dcN5jJfebaYJqVjbJ3L6lwz49kLCC8Jz1BS51bGLs_hd4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWp6tvoolIyOCnAzoyH4fqul3p_1yBoF8L9ihOsMcx7bQ&oe=6B0F0F3F"}, {"file_name": "SantasGiftToss_Screenshot_03_2560x1440.png", "id": "1688126713023477", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/908839735_1688126716356810_5319717041641409849_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f69lu_uMR_oQ7kNvwGVpXDq&_nc_oc=AdoC9nUWbsqF2N75W6kr4zxTKBCB9pTTqlKKI4F6QLr-fTOkJh39kioR_k_cOLY6Nl8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWyCfcBT8n1Es6NvvtRF7xiBw1fhKhrtB21-e1uIaT8lg&oe=6B0F17AE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SantasGiftToss_Cover_Landscape_2560x1440.png", "id": "1704318687766002", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/908839685_1704318694432668_8165031779887577695_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qcXnMO9J8MIQ7kNvwEPhjKf&_nc_oc=AdoiZ3MNa6R8jOMU9hFvk85rks7TTv8JEvt95IN52spdqTUA-_gyTBQu_FLQ_nLE38A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUQTdDSR3HqTczxyTmN5_811QI_N6F9KyNegIJhJAnG7Q&oe=6B0F02C4"}, "display_name": "Santa's Gift Toss", "keywords": ["christmas", "arcade", "physics", "throwing", "family"], "long_description": "Step alongside Santa's sleigh in a **100% hands-on VR holiday physics arcade!** Whether you have five minutes for a quick score chase or want to 3-star every snowy rooftop, **Santa's Gift Toss** puts magical presents, crisp throwing physics, and instant festive fun right in your hands.\n\n{1875265950341263}\n\n* **Tactile VR Throwing:** Grab, aim, and toss with responsive controller haptics, smart arc guidance, and dynamic crosswinds that reward true skill.\n* **4 Tactical Gift Types:** Score big and add bonus time with **Golden Gifts**, lock fast targets in place with **Freeze Gifts**, and dodge combo-breaking **Naughty Coal**!\n* **5 Dynamic Targets:** Hit static, moving, flying, sparkling Bling, and rare **Golden Stockings**.\n\n{1875566267226767}\n\nTravel through **8 Story Campaign levels (24 Stars)** across **5 picturesque village stops**\u2014from *Tree Plaza* and *Pond Square* to *Blizzard Ridge*\u2014with multi-stage transitions and **5 dynamic moods** (Sunny Day, Golden Afternoon, Sunset, Starry Night, and Howling Blizzard).\n\n{1492650222790351}\n\n* **Endless Wave Arcade:** Unlimited gifts, escalating target speeds, shifting snowstorm crosswinds, and **2X Score Fever Mode** triggered by 5-hit streaks or Golden Stockings.\n* **Unlockable Gift Trails:** Earn stars and high scores to equip **6 glowing mid-air ribbon trails**, including *Northern Aurora*, *Golden Sleigh*, and *Santa's Rainbow*.\n* **VR Comfort Ready:** Play **seated or standing** with zero motion sickness, guided Santa voice tutorial, and instant pass-and-play fun for the whole family!", "short_description": "Step alongside Santa\u2019s sleigh in the ultimate VR holiday physics arcade! Grab, aim, and toss magical presents into moving stockings across a snowy winter village. Master mid-air wind gusts, freeze flying targets with Frost Gifts, dodge combo-breaking Coal, and trigger 2X Fever Mode! Conquer 8 multi-stage Campaign levels for 24 Stars, survive Endless Waves, and unlock glowing ribbon trails. Easy to pick up, endlessly fun to master for all ages!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/seivr/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jone Sei", "support_website_url": null, "website_url": "https://sites.google.com/view/seivr/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25529871629941553"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/908839715_1171611219138450_5525180585874541797_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FEPfYFVThnsQ7kNvwFyoCbB&_nc_oc=AdrfMuiXSY1OHwV308zRwDvGkG7RaIZIX3ka61UY_S_4rssmB_Ie49dtOMMIB4iwcLA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXyj0Bo94TOdxbKwRxhjWOnmFpwCYvjNmJgWPbfuvOsTw&oe=6B0F210D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Santa's Gift Toss", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Arcade", "id": "1592192974313489"}, {"topic_name": "Action", "id": "459781504968480"}], "release_date": 1736386800, "lastRevision": {"nodes": [{"id": "8896002543755057", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "8896002513755060", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "
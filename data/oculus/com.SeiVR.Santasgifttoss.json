76579185150927_3412366430155324682_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bina-_GzRkIQ7kNvwGVX78Z&_nc_oc=AdpqX-FVgg_0oW5rakLMObRzFfdAexmySCyJQvUMeArH8JxFTzJjQ6qUq5hRUXOR5So&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ynts-34mxwmJtFkdticwahe-rGvjd01At5iKtg3X91g&oe=69E8BAAC"}, {"file_name": "s5.png", "id": "1000046105274522", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974719_1000046108607855_2336721725053216415_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0x2ilNUXunsQ7kNvwFm0fSC&_nc_oc=AdoELaAMVYqycvVD_pJ56WjYXJobFBiCq10XbkneEhb7h6qO2yg4o9WyVmLF7VeTidI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af00s5qzj2QcXHC9ugFlxnduk83B5-Da-Dwge509Rh_R9g&oe=69E8D401"}, {"file_name": "s2.png", "id": "1125799312536770", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031584_1125799315870103_6617510981775345797_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SIu0DFk7vbQQ7kNvwGB8vMK&_nc_oc=Adr3B37uQp-uLMzellVSz1LcDuBqvu007gEPiZuvmwheDP5Suo5iHquvbbapTJfisrY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1JCAhhfNwJiXAbsiz6X3b-MJiNe8jhDSwrUS--l4tvUg&oe=69E8BCE0"}, {"file_name": "s1.png", "id": "959909006016960", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974526_959909009350293_7437404938336637750_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aLy_USSgHw0Q7kNvwHHmXo3&_nc_oc=AdrgF-x9WVfW98UiAOrEprw42S-wMPoHsfNk5jQwtRKznPA5hDX05x8qR4Qp3G0tbaI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0RMmE_Cuz8rMDsgrnwFPlzakmiE-y1mCuz6zuFm6-J4w&oe=69E8CFF0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Santa's Gift Tooss", "keywords": ["SantaClaus", "ChristmasVRgame", "Gifttossinggame", "Tossing", "throw"], "long_description": "Become Santa Claus: Transform into the legendary gift-giver in this enchanting VR experience on Meta Quest. Feel the magic as you take on Santa's role during Christmas Eve.\n\nDeliver Joy to every one: Your mission is to toss presents into chimneys, ensuring every one wakes up to the excitement of Christmas morning. Precision and timing are key to spreading holiday cheer!\n\nRide the Sleigh: Glide through snowy landscapes atop Santa\u2019s sleigh, pulled by faithful reindeer. Soar across rooftops, navigating through festive winter scenes that bring the holiday spirit to life.\n\nOvercome Challenges: Watch out for obstacles like blizzards and cheeky snowbirds that can disrupt your deliveries. Stay focused to ensure no child is left without a gift!\n\nEarn Points and Rewards: Every successful gift delivery earns you points. Aim for high scores as you master the art of Santa\u2019s gift toss and unlock festive surprises along the way.\n\nFestive Atmosphere: Immerse yourself in a world of dazzling visuals, cheerful holiday music, and intuitive VR controls, making this a magical.\n\nPerfect for Family Fun: Whether playing solo or sharing the joy with friends and family, Santa's Gift Toss is the ultimate holiday VR game to celebrate the Christmas spirit.", "short_description": "Santa's Gift Tooss is a delightful VR game on Meta Quest where you become Santa Claus. Your mission is to deliver gifts to every one by tossing presents into chimneys on Christmas Eve."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacypolicyforsantasgifttoos/trang-ch%E1%BB%A7", "developer_terms_of_service_url": null, "publisher_name": "Jone Sei", "support_website_url": null, "website_url": "https://sites.google.com/view/sei-vr-santasgifttoss/trang-ch%E1%BB%A7", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "re
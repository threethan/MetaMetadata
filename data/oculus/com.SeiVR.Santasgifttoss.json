M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNbkrtXCjTLUZ_eLENrovwU9mLDOA_sC__JBxyZ8dXKsQ&oe=6ACCEE37"}, {"file_name": "s3.png", "id": "576579181817594", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974521_576579185150927_3412366430155324682_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G8rznXLq1RAQ7kNvwEBpUdd&_nc_oc=AdrUf7mFtSULqaBsGFduksXCqLCLoFZuSlan8Q1ANAmDz2dnxDpBA20wg2gBAzIPZOk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPCsKZZJ0N1rui0kNgBsqbtvKfA_3NRxkkSSgnnuOSxaw&oe=6ACD066C"}, {"file_name": "s5.png", "id": "1000046105274522", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974719_1000046108607855_2336721725053216415_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bC3ekemiKtcQ7kNvwFNbNYh&_nc_oc=AdrPmzfofnuox8lld_AzRZjDEBKvHgTbYUvJJNDVqZ9DeegdtganjmN4QM4dT8u5bYI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP7r0sFXw08sm-hFIGDw9bOarsMVNWBB3Oy36IM3ARhGA&oe=6ACCE781"}, {"file_name": "s2.png", "id": "1125799312536770", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031584_1125799315870103_6617510981775345797_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zcGKGZmU4kQQ7kNvwHyyWbi&_nc_oc=AdoR-kvabeovyXcsX_UJFCXQnb0f16xqE0q3ELNYSeYnF4L204GpquDccs3XWqUULPY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIpapIjwYVAsNBzJzFAq0zOxfrYY1fvPHNreb3N436wg&oe=6ACD08A0"}, {"file_name": "s1.png", "id": "959909006016960", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974526_959909009350293_7437404938336637750_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SSVT1ni2JP4Q7kNvwGRPJdc&_nc_oc=Adoy3ReDzQDAhfx2scX-iQW-UFZLRXlxchpoVkBcvg6tLjuHO6pHwDeRPwLa4-RlW2Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQUWEMdBCSkxdkf9jZP9ovZNV-1fxsJsiC222N33ir0Q&oe=6ACCE370"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Santa's Gift Tooss", "keywords": ["SantaClaus", "ChristmasVRgame", "Gifttossinggame", "Tossing", "throw"], "long_description": "Become Santa Claus: Transform into the legendary gift-giver in this enchanting VR experience on Meta Quest. Feel the magic as you take on Santa's role during Christmas Eve.\n\nDeliver Joy to every one: Your mission is to toss presents into chimneys, ensuring every one wakes up to the excitement of Christmas morning. Precision and timing are key to spreading holiday cheer!\n\nRide the Sleigh: Glide through snowy landscapes atop Santa\u2019s sleigh, pulled by faithful reindeer. Soar across rooftops, navigating through festive winter scenes that bring the holiday spirit to life.\n\nOvercome Challenges: Watch out for obstacles like blizzards and cheeky snowbirds that can disrupt your deliveries. Stay focused to ensure no child is left without a gift!\n\nEarn Points and Rewards: Every successful gift delivery earns you points. Aim for high scores as you master the art of Santa\u2019s gift toss and unlock festive surprises along the way.\n\nFestive Atmosphere: Immerse yourself in a world of dazzling visuals, cheerful holiday music, and intuitive VR controls, making this a magical.\n\nPerfect for Family Fun: Whether playing solo or sharing the joy with friends and family, Santa's Gift Toss is the ultimate holiday VR game to celebrate the Christmas spirit.", "short_description": "Santa's Gift Tooss is a delightful VR game on Meta Quest where you become Santa Claus. Your mission is to deliver gifts to every one by tossing presents into chimneys on Christmas Eve."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacypolicyforsantasgifttoos/trang-ch%E1%BB%A7", "developer_terms_of_service_url": null, "publisher_name": "Jone Sei", "support_website_url": null, "website_url": "https://sites.google.com/view/sei-vr-santasgifttoss/trang-ch%E1%BB%A7", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
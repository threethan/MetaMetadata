7"}, {"file_name": "s3.png", "id": "576579181817594", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974521_576579185150927_3412366430155324682_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8DDAanEttycQ7kNvwE5OB5Y&_nc_oc=AdpoXUZP94sRPaAWn8yLGy6A59Yj_KRw1BAQSq-vplk2F8OSYmmrWjIRugmFW6rnCno&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIiByDINV4_JetNkkOEDRCfMxBlRFBEkpdxyjjZk72dWA&oe=6A9C3EEC"}, {"file_name": "s5.png", "id": "1000046105274522", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974719_1000046108607855_2336721725053216415_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_BD70ZmBsY8Q7kNvwEvSBOT&_nc_oc=Ado__MfwVdnDscY7bEcUarv77Pr2tEZ1YTtk74xX_8HM9D7SswCYvjwHgm44WvbZkvM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKoUe5HRnMoZSDoPgw1J9HR-6o5sLukJ-aYCm5Qpxubzw&oe=6A9C2001"}, {"file_name": "s2.png", "id": "1125799312536770", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031584_1125799315870103_6617510981775345797_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cl8E7lTT2BEQ7kNvwFY8XPr&_nc_oc=AdqVwauJZRNZU1QXSOV5TMWPRA5TLoo8BzM5i7Vo36RN9ZHdfi-3omnoRSut7Oq1CtM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKuRxcwDTYnryI5QcWRFPlXcCRbrsHrPwul0hmIWppQxQ&oe=6A9C4120"}, {"file_name": "s1.png", "id": "959909006016960", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974526_959909009350293_7437404938336637750_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dFqOoQCJzhMQ7kNvwFAZrly&_nc_oc=AdpCyLteYknjc2aXLmL0WOOPYblZYln73deUDpEV0IZIk4pmyx-ilGewqlUMEHkZ_Eg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI76ai5h_h5vw636IOa7ZY7pFK0Y_KmXhOiQJEf50kFug&oe=6A9C1BF0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Santa's Gift Tooss", "keywords": ["SantaClaus", "ChristmasVRgame", "Gifttossinggame", "Tossing", "throw"], "long_description": "Become Santa Claus: Transform into the legendary gift-giver in this enchanting VR experience on Meta Quest. Feel the magic as you take on Santa's role during Christmas Eve.\n\nDeliver Joy to every one: Your mission is to toss presents into chimneys, ensuring every one wakes up to the excitement of Christmas morning. Precision and timing are key to spreading holiday cheer!\n\nRide the Sleigh: Glide through snowy landscapes atop Santa\u2019s sleigh, pulled by faithful reindeer. Soar across rooftops, navigating through festive winter scenes that bring the holiday spirit to life.\n\nOvercome Challenges: Watch out for obstacles like blizzards and cheeky snowbirds that can disrupt your deliveries. Stay focused to ensure no child is left without a gift!\n\nEarn Points and Rewards: Every successful gift delivery earns you points. Aim for high scores as you master the art of Santa\u2019s gift toss and unlock festive surprises along the way.\n\nFestive Atmosphere: Immerse yourself in a world of dazzling visuals, cheerful holiday music, and intuitive VR controls, making this a magical.\n\nPerfect for Family Fun: Whether playing solo or sharing the joy with friends and family, Santa's Gift Toss is the ultimate holiday VR game to celebrate the Christmas spirit.", "short_description": "Santa's Gift Tooss is a delightful VR game on Meta Quest where you become Santa Claus. Your mission is to deliver gifts to every one by tossing presents into chimneys on Christmas Eve."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacypolicyforsantasgifttoos/trang-ch%E1%BB%A7", "developer_terms_of_service_url": null, "publisher_name": "Jone Sei", "support_website_url": null, "website_url": "https://sites.google.com/view/sei-vr-santasgifttoss/trang-ch%E1%BB%A7", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], 
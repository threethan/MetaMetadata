7"}, {"file_name": "s3.png", "id": "576579181817594", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974521_576579185150927_3412366430155324682_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xz_uhUwL1nEQ7kNvwGQubq6&_nc_oc=Adry50gdRRTup20glPibPuARmXxxwmaYQwcWiR-55KsxvzysApPDh79xoDMY2eNogBQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIiKriSC6dbXL3zgNILH3e-DYQjnLjPUDnYUKV8FmLTww&oe=6A9FFB2C"}, {"file_name": "s5.png", "id": "1000046105274522", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974719_1000046108607855_2336721725053216415_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zlbm8KRAx-wQ7kNvwGTPvRv&_nc_oc=Adq07wnsIEU9CiuGRjjyv3TTwGjzIDeeCtdsKwEqEfzxSszkKIRVDneTcoNC058rbbc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLeovS_XAZ7sxGxBdoAjgesDJ98XoRbgpf7rMfmkdhUmA&oe=6AA01481"}, {"file_name": "s2.png", "id": "1125799312536770", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031584_1125799315870103_6617510981775345797_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=REJ9M_RR_b0Q7kNvwFYWbcT&_nc_oc=Adql1rC3hz_eQdqOt1qs1kSoypmwVApnKBv9JD7zdPep47ukXmlRyqS_NelY3FTHou0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJL1PrYLmDxLO4FYA4g2Hbrw1rXc-nkgBvFR41zluQLtw&oe=6A9FFD60"}, {"file_name": "s1.png", "id": "959909006016960", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974526_959909009350293_7437404938336637750_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NbO6MgGc0VsQ7kNvwFbyoE1&_nc_oc=AdoYX1Czd_rmqPYIHlr8SXO2dhXupQf31bqXvSSSF_JJSgA3onHYwAf2X-gyH4EZRXw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLT-BScDanzTvYfp1fmv_Scr4fkgys1FOVEWCZyoZewjw&oe=6AA01070"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Santa's Gift Tooss", "keywords": ["SantaClaus", "ChristmasVRgame", "Gifttossinggame", "Tossing", "throw"], "long_description": "Become Santa Claus: Transform into the legendary gift-giver in this enchanting VR experience on Meta Quest. Feel the magic as you take on Santa's role during Christmas Eve.\n\nDeliver Joy to every one: Your mission is to toss presents into chimneys, ensuring every one wakes up to the excitement of Christmas morning. Precision and timing are key to spreading holiday cheer!\n\nRide the Sleigh: Glide through snowy landscapes atop Santa\u2019s sleigh, pulled by faithful reindeer. Soar across rooftops, navigating through festive winter scenes that bring the holiday spirit to life.\n\nOvercome Challenges: Watch out for obstacles like blizzards and cheeky snowbirds that can disrupt your deliveries. Stay focused to ensure no child is left without a gift!\n\nEarn Points and Rewards: Every successful gift delivery earns you points. Aim for high scores as you master the art of Santa\u2019s gift toss and unlock festive surprises along the way.\n\nFestive Atmosphere: Immerse yourself in a world of dazzling visuals, cheerful holiday music, and intuitive VR controls, making this a magical.\n\nPerfect for Family Fun: Whether playing solo or sharing the joy with friends and family, Santa's Gift Toss is the ultimate holiday VR game to celebrate the Christmas spirit.", "short_description": "Santa's Gift Tooss is a delightful VR game on Meta Quest where you become Santa Claus. Your mission is to deliver gifts to every one by tossing presents into chimneys on Christmas Eve."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacypolicyforsantasgifttoos/trang-ch%E1%BB%A7", "developer_terms_of_service_url": null, "publisher_name": "Jone Sei", "support_website_url": null, "website_url": "https://sites.google.com/view/sei-vr-santasgifttoss/trang-ch%E1%BB%A7", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], 
k&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOeyQnb-rrc4zCmS_w0iETu6bWU-te-riOsnmu60HHr5A&oe=6AD0E2B7"}, {"file_name": "s3.png", "id": "576579181817594", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974521_576579185150927_3412366430155324682_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mrNvEu8LyeoQ7kNvwHTS8K9&_nc_oc=AdpO81Nllp88k8YqJprTzNQrL4ULwApU28le-6rpPqey2-S5DRKPLbs5mKTBqzWeRZo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7hCcs1KRamK1x9xOKn8WZOKrn58Yg5eQRZgy552ue4A&oe=6AD0FAEC"}, {"file_name": "s5.png", "id": "1000046105274522", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974719_1000046108607855_2336721725053216415_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jLguH-reGjoQ7kNvwENuIZA&_nc_oc=AdofMx_9K_8xx86qlndblvUmKgU_lduuyqILntU48kC2eEFuMX6CWVxNJitiM4x_7lg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_CFugT7R1iR1_76akGzp50FZ1Q_CSy1r0T_hl_lDxww&oe=6AD0DC01"}, {"file_name": "s2.png", "id": "1125799312536770", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031584_1125799315870103_6617510981775345797_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fjg4yI0Hti8Q7kNvwESdb1P&_nc_oc=Adp5GnTY0Dy32wdU7lo4en3lD6yfvQsAKqoptbByzuuPaCIPkPygUvkIUodkR5_rY-I&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPDrU14uV46ItRJe35iEgmTdYYHzw-m7gKq-Pk3gvM3oA&oe=6AD0FD20"}, {"file_name": "s1.png", "id": "959909006016960", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974526_959909009350293_7437404938336637750_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mbp3bXfCGtUQ7kNvwEG8swo&_nc_oc=AdqGZELK-blYPRQ5qe0iQkeXyFy3GFzKVVp5Y6pO92eijuHgPk1H0sMGlDPc7lscCMQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPMU4vimNX9-L10omFDZiWEHMOwTfHfir-12vr9vess4w&oe=6AD0D7F0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Santa's Gift Tooss", "keywords": ["SantaClaus", "ChristmasVRgame", "Gifttossinggame", "Tossing", "throw"], "long_description": "Become Santa Claus: Transform into the legendary gift-giver in this enchanting VR experience on Meta Quest. Feel the magic as you take on Santa's role during Christmas Eve.\n\nDeliver Joy to every one: Your mission is to toss presents into chimneys, ensuring every one wakes up to the excitement of Christmas morning. Precision and timing are key to spreading holiday cheer!\n\nRide the Sleigh: Glide through snowy landscapes atop Santa\u2019s sleigh, pulled by faithful reindeer. Soar across rooftops, navigating through festive winter scenes that bring the holiday spirit to life.\n\nOvercome Challenges: Watch out for obstacles like blizzards and cheeky snowbirds that can disrupt your deliveries. Stay focused to ensure no child is left without a gift!\n\nEarn Points and Rewards: Every successful gift delivery earns you points. Aim for high scores as you master the art of Santa\u2019s gift toss and unlock festive surprises along the way.\n\nFestive Atmosphere: Immerse yourself in a world of dazzling visuals, cheerful holiday music, and intuitive VR controls, making this a magical.\n\nPerfect for Family Fun: Whether playing solo or sharing the joy with friends and family, Santa's Gift Toss is the ultimate holiday VR game to celebrate the Christmas spirit.", "short_description": "Santa's Gift Tooss is a delightful VR game on Meta Quest where you become Santa Claus. Your mission is to deliver gifts to every one by tossing presents into chimneys on Christmas Eve."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacypolicyforsantasgifttoos/trang-ch%E1%BB%A7", "developer_terms_of_service_url": null, "publisher_name": "Jone Sei", "support_website_url": null, "website_url": "https://sites.google.com/view/sei-vr-santasgifttoss/trang-ch%E1%BB%A7", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
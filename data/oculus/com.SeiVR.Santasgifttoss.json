B6FfLYXOGdO3cYKYsle0nP5JWCPjIVJxoh63Jw&oe=69984F2C"}, {"file_name": "s5.png", "id": "1000046105274522", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974719_1000046108607855_2336721725053216415_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mYOxW59M2xUQ7kNvwHRoobr&_nc_oc=AdminE4bJWvQQdsMofGMAq-vHH90CTkONmkMFhVJ9Fve3jBiHga6ocaH5bZvT7qv8rI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Aftxs9CS19L4AOfKBoeFhe4ml6P2YZe3fodbACQfCOkFuA&oe=69986881"}, {"file_name": "s2.png", "id": "1125799312536770", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031584_1125799315870103_6617510981775345797_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qOvf4yVNRmAQ7kNvwFeO2AI&_nc_oc=AdkL6FrlxXPr32v2GIeA2CWN1Quu6oqBDu6LiPJXdIXkyPyEXxYVZE0wGkzqB_p0-YY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afu3cDycvInAK0OPcfz6yZPJbk7uCKYJqR7_lT7e88sjLw&oe=69985160"}, {"file_name": "s1.png", "id": "959909006016960", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974526_959909009350293_7437404938336637750_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4vXc-AzViJEQ7kNvwGzr6Fy&_nc_oc=AdmTds33YM6qL5jOeilq8MJe9cYwfnyAFNgK-LROIdVt_csS1awRv34J0njITbKoxmM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afuf0psuCcevojRSEnof5tSe7dLbCc1MrXaNksb9eWbtcQ&oe=69986470"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Santa's Gift Tooss", "keywords": ["SantaClaus", "ChristmasVRgame", "Gifttossinggame", "Tossing", "throw"], "long_description": "Become Santa Claus: Transform into the legendary gift-giver in this enchanting VR experience on Meta Quest. Feel the magic as you take on Santa's role during Christmas Eve.\n\nDeliver Joy to every one: Your mission is to toss presents into chimneys, ensuring every one wakes up to the excitement of Christmas morning. Precision and timing are key to spreading holiday cheer!\n\nRide the Sleigh: Glide through snowy landscapes atop Santa\u2019s sleigh, pulled by faithful reindeer. Soar across rooftops, navigating through festive winter scenes that bring the holiday spirit to life.\n\nOvercome Challenges: Watch out for obstacles like blizzards and cheeky snowbirds that can disrupt your deliveries. Stay focused to ensure no child is left without a gift!\n\nEarn Points and Rewards: Every successful gift delivery earns you points. Aim for high scores as you master the art of Santa\u2019s gift toss and unlock festive surprises along the way.\n\nFestive Atmosphere: Immerse yourself in a world of dazzling visuals, cheerful holiday music, and intuitive VR controls, making this a magical.\n\nPerfect for Family Fun: Whether playing solo or sharing the joy with friends and family, Santa's Gift Toss is the ultimate holiday VR game to celebrate the Christmas spirit.", "short_description": "Santa's Gift Tooss is a delightful VR game on Meta Quest where you become Santa Claus. Your mission is to deliver gifts to every one by tossing presents into chimneys on Christmas Eve."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacypolicyforsantasgifttoos/trang-ch%E1%BB%A7", "developer_terms_of_service_url": null, "publisher_name": "Jone Sei", "support_website_url": null, "website_url": "https://sites.google.com/view/sei-vr-santasgifttoss/trang-ch%E1%BB%A7", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "913509
7"}, {"file_name": "s3.png", "id": "576579181817594", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974521_576579185150927_3412366430155324682_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qazzb4BiffEQ7kNvwEaY2VY&_nc_oc=AdpdoARq6uCGxhxxsvScy98hG3s9g5OEH-t7hQl97FZiFUzgfzbLGSs4s7SDsSZ2kpw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMKSsS3zhVX7VeH-c_rmubvsCsrsJAN1aYUBnRZa6HTEQ&oe=6AC128EC"}, {"file_name": "s5.png", "id": "1000046105274522", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974719_1000046108607855_2336721725053216415_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yH9oxsRGb5MQ7kNvwEgZtuH&_nc_oc=AdruiEIlGalTg3uKTs5UvnWL76NnfcDet0iSD6a-mg6__MNJ5KdoRccxL4WCnTadZEM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOW3NLBUALhQq9Sv5xiwF5TI9U03KJpSUltos6Awtr4Dw&oe=6AC10A01"}, {"file_name": "s2.png", "id": "1125799312536770", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031584_1125799315870103_6617510981775345797_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4tlqVQpFCMQQ7kNvwHa21JQ&_nc_oc=Adp-xD0C8xAt4GJ1sHU3w-EJNw1y5lOU8g6L4miZF3vjkkwjY7Ca6QvbAokcUwjrIlg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOo1oXtnSqi0xXs7HnG3Q9aqB6uHmxh-OCsQ1kRbCLvIw&oe=6AC12B20"}, {"file_name": "s1.png", "id": "959909006016960", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974526_959909009350293_7437404938336637750_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jk4vcxV8bckQ7kNvwF94nn_&_nc_oc=AdpgadaUlt5d0Tq-fKgylDQlGUCIkmmzVhXgYm4Cse1nEPXQLJ-qEn9bLaWQuFHbkTM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPsi1PkyPH0apW21nH0hwRU-Z3Io_q55l4LJo1Y5kbr8g&oe=6AC105F0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Santa's Gift Tooss", "keywords": ["SantaClaus", "ChristmasVRgame", "Gifttossinggame", "Tossing", "throw"], "long_description": "Become Santa Claus: Transform into the legendary gift-giver in this enchanting VR experience on Meta Quest. Feel the magic as you take on Santa's role during Christmas Eve.\n\nDeliver Joy to every one: Your mission is to toss presents into chimneys, ensuring every one wakes up to the excitement of Christmas morning. Precision and timing are key to spreading holiday cheer!\n\nRide the Sleigh: Glide through snowy landscapes atop Santa\u2019s sleigh, pulled by faithful reindeer. Soar across rooftops, navigating through festive winter scenes that bring the holiday spirit to life.\n\nOvercome Challenges: Watch out for obstacles like blizzards and cheeky snowbirds that can disrupt your deliveries. Stay focused to ensure no child is left without a gift!\n\nEarn Points and Rewards: Every successful gift delivery earns you points. Aim for high scores as you master the art of Santa\u2019s gift toss and unlock festive surprises along the way.\n\nFestive Atmosphere: Immerse yourself in a world of dazzling visuals, cheerful holiday music, and intuitive VR controls, making this a magical.\n\nPerfect for Family Fun: Whether playing solo or sharing the joy with friends and family, Santa's Gift Toss is the ultimate holiday VR game to celebrate the Christmas spirit.", "short_description": "Santa's Gift Tooss is a delightful VR game on Meta Quest where you become Santa Claus. Your mission is to deliver gifts to every one by tossing presents into chimneys on Christmas Eve."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacypolicyforsantasgifttoos/trang-ch%E1%BB%A7", "developer_terms_of_service_url": null, "publisher_name": "Jone Sei", "support_website_url": null, "website_url": "https://sites.google.com/view/sei-vr-santasgifttoss/trang-ch%E1%BB%A7", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], 
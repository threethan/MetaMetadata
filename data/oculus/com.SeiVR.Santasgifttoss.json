o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTvwqJVav51t_vEPY5CoUcql6KyXC3imchnuTmdhTiMw&oe=6AEB40B7"}, {"file_name": "s3.png", "id": "576579181817594", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974521_576579185150927_3412366430155324682_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yv8lbrX0ig4Q7kNvwG7KdUl&_nc_oc=Adpeax-R8jPY0EG2MYpPDDj6Rn5N3v_TTKxUa39-lQR0Tipe3nDgswfjOI-8KdiTQBM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDPeuRF4qCi1L8sLf1WfuahPy1kuA8-VHK0yDNIvVc8A&oe=6AEB58EC"}, {"file_name": "s5.png", "id": "1000046105274522", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974719_1000046108607855_2336721725053216415_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wmUJxOKT3XEQ7kNvwGXjT7m&_nc_oc=Adp59_ltRFAzANNW_VzsliLNmaRgknt329TWGkF4-vCyrGFMDXzZDqeKI9cEXrkLczg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQReabQQinkZiNk2XH8HjiXoL-_5Hq_VA3F639J1eWCiDw&oe=6AEB3A01"}, {"file_name": "s2.png", "id": "1125799312536770", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031584_1125799315870103_6617510981775345797_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_9XRg6NB0O0Q7kNvwFwrf-t&_nc_oc=AdopCeSi1fTX7zaKAdodzeSvYHmxwJNtWz771MK3ycY3OEMP13XvUN6Kpn-Tb6DBiow&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpgBn3EyKOK9xKO6ltsVt9hGrWFeMqVDG9eL3xpqdE1Q&oe=6AEB5B20"}, {"file_name": "s1.png", "id": "959909006016960", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974526_959909009350293_7437404938336637750_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QojzQpsmVUYQ7kNvwHbg9vw&_nc_oc=Adp3uF3dLC_9gyjYYtJmRArfC41PNeqxgz4Ywh3qNV4xfyB2qjnN-SKK4BaEyoeCBvA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJyTVaZxKynfpPEBKDV6UgZfVjbvzZU2gk7JGpikoOFA&oe=6AEB35F0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Santa's Gift Tooss", "keywords": ["SantaClaus", "ChristmasVRgame", "Gifttossinggame", "Tossing", "throw"], "long_description": "Become Santa Claus: Transform into the legendary gift-giver in this enchanting VR experience on Meta Quest. Feel the magic as you take on Santa's role during Christmas Eve.\n\nDeliver Joy to every one: Your mission is to toss presents into chimneys, ensuring every one wakes up to the excitement of Christmas morning. Precision and timing are key to spreading holiday cheer!\n\nRide the Sleigh: Glide through snowy landscapes atop Santa\u2019s sleigh, pulled by faithful reindeer. Soar across rooftops, navigating through festive winter scenes that bring the holiday spirit to life.\n\nOvercome Challenges: Watch out for obstacles like blizzards and cheeky snowbirds that can disrupt your deliveries. Stay focused to ensure no child is left without a gift!\n\nEarn Points and Rewards: Every successful gift delivery earns you points. Aim for high scores as you master the art of Santa\u2019s gift toss and unlock festive surprises along the way.\n\nFestive Atmosphere: Immerse yourself in a world of dazzling visuals, cheerful holiday music, and intuitive VR controls, making this a magical.\n\nPerfect for Family Fun: Whether playing solo or sharing the joy with friends and family, Santa's Gift Toss is the ultimate holiday VR game to celebrate the Christmas spirit.", "short_description": "Santa's Gift Tooss is a delightful VR game on Meta Quest where you become Santa Claus. Your mission is to deliver gifts to every one by tossing presents into chimneys on Christmas Eve."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacypolicyforsantasgifttoos/trang-ch%E1%BB%A7", "developer_terms_of_service_url": null, "publisher_name": "Jone Sei", "support_website_url": null, "website_url": "https://sites.google.com/view/sei-vr-santasgifttoss/trang-ch%E1%BB%A7", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
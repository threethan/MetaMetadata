A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2CClE5TgGS15l7SeO-IYpvOUv7-6nrQmvsJ6F3pQGRg&oe=6AF086B7"}, {"file_name": "s3.png", "id": "576579181817594", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974521_576579185150927_3412366430155324682_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hIN_xA1ID84Q7kNvwFzGfP7&_nc_oc=AdoW7OIDQFoaPBpVwLmJ59UdYSkIa80Ura-Nn9PnNQYrspNwAqsR9djctPXpisVuPM4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMMwBSB5G10vz96GRn8TVWhOP4coKeWX70RGs9279ISQ&oe=6AF09EEC"}, {"file_name": "s5.png", "id": "1000046105274522", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974719_1000046108607855_2336721725053216415_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p-hF4wfPYykQ7kNvwF3yIej&_nc_oc=AdrgcA0P-YOlCvhsnVknemp-w1RcYXvZGOGspxjNXGf2PPPe5XgcQt7RyQMqsfbp2OA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPyO_Kv8XVFUHXPD0lonZmwEsY1YE33JIOIrxuUzWIYA&oe=6AF08001"}, {"file_name": "s2.png", "id": "1125799312536770", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031584_1125799315870103_6617510981775345797_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fZzmAEeK0iYQ7kNvwHR8Kjz&_nc_oc=Adom4AwKmJ304gCz8pe5mqQaf8PbceSqk2P7i_taRNWB5bUaRTWhDNsZ56uMxDHcb6g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTb-N_T8qux61MMpQ9QGO9hzGYTEBmyMykplKsPSr8XOA&oe=6AF0A120"}, {"file_name": "s1.png", "id": "959909006016960", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974526_959909009350293_7437404938336637750_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gLGnMj8cciMQ7kNvwF2EaeQ&_nc_oc=AdrxRRG3natH8Dz2CeeCnZTIZdyZ9Ah_SsYl0P_JxufeL_1F_pbsd8MIf_foEVzeULk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSiWivGQf9EqD4WPe-GE0_bUo9iLOiOZG2uq_53x0JFMg&oe=6AF0B430"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Santa's Gift Tooss", "keywords": ["SantaClaus", "ChristmasVRgame", "Gifttossinggame", "Tossing", "throw"], "long_description": "Become Santa Claus: Transform into the legendary gift-giver in this enchanting VR experience on Meta Quest. Feel the magic as you take on Santa's role during Christmas Eve.\n\nDeliver Joy to every one: Your mission is to toss presents into chimneys, ensuring every one wakes up to the excitement of Christmas morning. Precision and timing are key to spreading holiday cheer!\n\nRide the Sleigh: Glide through snowy landscapes atop Santa\u2019s sleigh, pulled by faithful reindeer. Soar across rooftops, navigating through festive winter scenes that bring the holiday spirit to life.\n\nOvercome Challenges: Watch out for obstacles like blizzards and cheeky snowbirds that can disrupt your deliveries. Stay focused to ensure no child is left without a gift!\n\nEarn Points and Rewards: Every successful gift delivery earns you points. Aim for high scores as you master the art of Santa\u2019s gift toss and unlock festive surprises along the way.\n\nFestive Atmosphere: Immerse yourself in a world of dazzling visuals, cheerful holiday music, and intuitive VR controls, making this a magical.\n\nPerfect for Family Fun: Whether playing solo or sharing the joy with friends and family, Santa's Gift Toss is the ultimate holiday VR game to celebrate the Christmas spirit.", "short_description": "Santa's Gift Tooss is a delightful VR game on Meta Quest where you become Santa Claus. Your mission is to deliver gifts to every one by tossing presents into chimneys on Christmas Eve."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacypolicyforsantasgifttoos/trang-ch%E1%BB%A7", "developer_terms_of_service_url": null, "publisher_name": "Jone Sei", "support_website_url": null, "website_url": "https://sites.google.com/view/sei-vr-santasgifttoss/trang-ch%E1%BB%A7", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
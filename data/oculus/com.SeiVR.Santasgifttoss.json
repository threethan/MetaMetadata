76579185150927_3412366430155324682_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zBJF0i0xBZ4Q7kNvwFNzz0F&_nc_oc=AdqexKPrRngoOoVkHepiq0qJLrE_rsZkwpvml2K_X81Ibg1VjI0eoEvTxGfjDDTR01I&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVAihEgSUrpiW8bgalRL1Wl9c9p84p42nbMSbi_5uvdg&oe=6A71D6AC"}, {"file_name": "s5.png", "id": "1000046105274522", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974719_1000046108607855_2336721725053216415_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7I-qmJZSrJIQ7kNvwG8tHxw&_nc_oc=AdpdSgNljBzWe1pR0Dr6Zf2sBAH9TUywqKPD9HduqmrJPKRJmJhiTBSvpV9Y6Z5iB7E&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGtZ7tOYkG9QMxy_9Ow54IGSen-71AJsrRp4yHCIa2kwg&oe=6A71F001"}, {"file_name": "s2.png", "id": "1125799312536770", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031584_1125799315870103_6617510981775345797_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AnPlF9nFpQkQ7kNvwEU5imb&_nc_oc=AdoFMerUhkRnUDStJeJTj6POlcJl3SI1MKoWVYhKgWVDx8RWCkePaN8vqw3LeAHpEl0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFwqeQNMW3aSRYgnX0pRvopM_es8mXcpZ6DilNn92pSXQ&oe=6A71D8E0"}, {"file_name": "s1.png", "id": "959909006016960", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974526_959909009350293_7437404938336637750_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LUWSd05mH1QQ7kNvwESw27h&_nc_oc=Adoc1LmhtoIhjqf5Y8gkEgceSNZkyrbrK1DSIlQiAO2g4XBzTumQhzm1_7sHV--N7qo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGyRYgf_g6skooC4cyZGNQZ6PRQ62ZEExTN4JvsQWVViw&oe=6A71EBF0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Santa's Gift Tooss", "keywords": ["SantaClaus", "ChristmasVRgame", "Gifttossinggame", "Tossing", "throw"], "long_description": "Become Santa Claus: Transform into the legendary gift-giver in this enchanting VR experience on Meta Quest. Feel the magic as you take on Santa's role during Christmas Eve.\n\nDeliver Joy to every one: Your mission is to toss presents into chimneys, ensuring every one wakes up to the excitement of Christmas morning. Precision and timing are key to spreading holiday cheer!\n\nRide the Sleigh: Glide through snowy landscapes atop Santa\u2019s sleigh, pulled by faithful reindeer. Soar across rooftops, navigating through festive winter scenes that bring the holiday spirit to life.\n\nOvercome Challenges: Watch out for obstacles like blizzards and cheeky snowbirds that can disrupt your deliveries. Stay focused to ensure no child is left without a gift!\n\nEarn Points and Rewards: Every successful gift delivery earns you points. Aim for high scores as you master the art of Santa\u2019s gift toss and unlock festive surprises along the way.\n\nFestive Atmosphere: Immerse yourself in a world of dazzling visuals, cheerful holiday music, and intuitive VR controls, making this a magical.\n\nPerfect for Family Fun: Whether playing solo or sharing the joy with friends and family, Santa's Gift Toss is the ultimate holiday VR game to celebrate the Christmas spirit.", "short_description": "Santa's Gift Tooss is a delightful VR game on Meta Quest where you become Santa Claus. Your mission is to deliver gifts to every one by tossing presents into chimneys on Christmas Eve."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacypolicyforsantasgifttoos/trang-ch%E1%BB%A7", "developer_terms_of_service_url": null, "publisher_name": "Jone Sei", "support_website_url": null, "website_url": "https://sites.google.com/view/sei-vr-santasgifttoss/trang-ch%E1%BB%A7", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "re
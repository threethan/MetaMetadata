76579185150927_3412366430155324682_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eBm2BCA4XbMQ7kNvwE3ebZo&_nc_oc=Adrd2c2XjytDJ-XSdMWjV6m2s8z5Vo58go0m9mHMkxQAyh_IgolGURPUc7n_-XNJ45I&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ug1lbDpgnzffVYckI1OJyoe-4JcMoXG-aW6aqwfZx0g&oe=6A32C6EC"}, {"file_name": "s5.png", "id": "1000046105274522", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974719_1000046108607855_2336721725053216415_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ibAHrRuzI-YQ7kNvwHww1xL&_nc_oc=AdoFmZ1Axv9074xETpf5hJw6HVq9XTsNuXMVw6qE86G1A2tAH8qSH7VCxlRqT7tjMlw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9bzI0TKZak92IxOWzyTb0V5MpFs0KaDNqSIrX2P8PaBQ&oe=6A32A801"}, {"file_name": "s2.png", "id": "1125799312536770", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031584_1125799315870103_6617510981775345797_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m8hNBmWgD_8Q7kNvwGwE7SE&_nc_oc=Adq-x4upyrtQVh818bbi5GPDPQb0a-6c_hIyDLzI_4ceQ6X4dW3Ucg8zYrPaTyNSJ58&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8YfczEDeSibHnWi4vcWWV_u-qAjZR-Rj_p6KnuzCDoHw&oe=6A3290E0"}, {"file_name": "s1.png", "id": "959909006016960", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974526_959909009350293_7437404938336637750_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D2ZUaGDIWyQQ7kNvwGczmME&_nc_oc=Adr08XQdtyJj6ytdob3w2dQZb9XCb4vZArEXjbOwgeUk0tq9WBta5y3rHsvBts0MY5c&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af94lcpOXLxcaaNmUowPp95MLcCEFb7toyvpRPtgh0HSaQ&oe=6A32A3F0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Santa's Gift Tooss", "keywords": ["SantaClaus", "ChristmasVRgame", "Gifttossinggame", "Tossing", "throw"], "long_description": "Become Santa Claus: Transform into the legendary gift-giver in this enchanting VR experience on Meta Quest. Feel the magic as you take on Santa's role during Christmas Eve.\n\nDeliver Joy to every one: Your mission is to toss presents into chimneys, ensuring every one wakes up to the excitement of Christmas morning. Precision and timing are key to spreading holiday cheer!\n\nRide the Sleigh: Glide through snowy landscapes atop Santa\u2019s sleigh, pulled by faithful reindeer. Soar across rooftops, navigating through festive winter scenes that bring the holiday spirit to life.\n\nOvercome Challenges: Watch out for obstacles like blizzards and cheeky snowbirds that can disrupt your deliveries. Stay focused to ensure no child is left without a gift!\n\nEarn Points and Rewards: Every successful gift delivery earns you points. Aim for high scores as you master the art of Santa\u2019s gift toss and unlock festive surprises along the way.\n\nFestive Atmosphere: Immerse yourself in a world of dazzling visuals, cheerful holiday music, and intuitive VR controls, making this a magical.\n\nPerfect for Family Fun: Whether playing solo or sharing the joy with friends and family, Santa's Gift Toss is the ultimate holiday VR game to celebrate the Christmas spirit.", "short_description": "Santa's Gift Tooss is a delightful VR game on Meta Quest where you become Santa Claus. Your mission is to deliver gifts to every one by tossing presents into chimneys on Christmas Eve."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacypolicyforsantasgifttoos/trang-ch%E1%BB%A7", "developer_terms_of_service_url": null, "publisher_name": "Jone Sei", "support_website_url": null, "website_url": "https://sites.google.com/view/sei-vr-santasgifttoss/trang-ch%E1%BB%A7", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "re
rub04E3LRVXU6dF9YvhP0iu24Nd00WkHUItAvpCKsQpxg7OlQC8rLQieWBEs4ppaE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af250y7p-dPwrKL_VluG-yiN79QLP1MFANky5hR7xrQBrg&oe=69F0A3AC"}, {"file_name": "s5.png", "id": "1000046105274522", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974719_1000046108607855_2336721725053216415_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=726eiruJXcUQ7kNvwHejWq8&_nc_oc=Ado_cGNyIT3QEOaIi5CdyF2_BGuZ2j7-TKge8ECcL-ScBfIOBHIx7WZtJ8jxoQV2_nk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1_KTRkS8v0_w2AotwJ9HyL2PtADf62I0wkxuDusvDBMw&oe=69F0BD01"}, {"file_name": "s2.png", "id": "1125799312536770", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031584_1125799315870103_6617510981775345797_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fLGRydlF6hIQ7kNvwHVYryH&_nc_oc=AdqmTRSPt5LQsFBWfaf31QsUTkXoNRDmmH4obgF16gpN31WaHcoaEtvMwAaf689H0tI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af3E94uPhB9ef0tBjZZVlBOWnVBuMv5LQQ4Zwx59MmdXrw&oe=69F0A5E0"}, {"file_name": "s1.png", "id": "959909006016960", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974526_959909009350293_7437404938336637750_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gd42qxIK83YQ7kNvwFtHeVM&_nc_oc=Adoax9owFPbHbN3zEqQnX7CCbIjHp7Isx_TS4F3v4jXO1JnqTzO6DpUIGK-e5oZC5Qw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0L1W1B9K5CjX551EZ4292C-cAfG5xqfAQZjTCtakRv5A&oe=69F0B8F0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Santa's Gift Tooss", "keywords": ["SantaClaus", "ChristmasVRgame", "Gifttossinggame", "Tossing", "throw"], "long_description": "Become Santa Claus: Transform into the legendary gift-giver in this enchanting VR experience on Meta Quest. Feel the magic as you take on Santa's role during Christmas Eve.\n\nDeliver Joy to every one: Your mission is to toss presents into chimneys, ensuring every one wakes up to the excitement of Christmas morning. Precision and timing are key to spreading holiday cheer!\n\nRide the Sleigh: Glide through snowy landscapes atop Santa\u2019s sleigh, pulled by faithful reindeer. Soar across rooftops, navigating through festive winter scenes that bring the holiday spirit to life.\n\nOvercome Challenges: Watch out for obstacles like blizzards and cheeky snowbirds that can disrupt your deliveries. Stay focused to ensure no child is left without a gift!\n\nEarn Points and Rewards: Every successful gift delivery earns you points. Aim for high scores as you master the art of Santa\u2019s gift toss and unlock festive surprises along the way.\n\nFestive Atmosphere: Immerse yourself in a world of dazzling visuals, cheerful holiday music, and intuitive VR controls, making this a magical.\n\nPerfect for Family Fun: Whether playing solo or sharing the joy with friends and family, Santa's Gift Toss is the ultimate holiday VR game to celebrate the Christmas spirit.", "short_description": "Santa's Gift Tooss is a delightful VR game on Meta Quest where you become Santa Claus. Your mission is to deliver gifts to every one by tossing presents into chimneys on Christmas Eve."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacypolicyforsantasgifttoos/trang-ch%E1%BB%A7", "developer_terms_of_service_url": null, "publisher_name": "Jone Sei", "support_website_url": null, "website_url": "https://sites.google.com/view/sei-vr-santasgifttoss/trang-ch%E1%BB%A7", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": [
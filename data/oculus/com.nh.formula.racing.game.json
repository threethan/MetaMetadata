uluscdn.com/v/t64.5771-25/491823905_1082182211421478_7214508785817806073_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ZZE5UeAcS0Q7kNvwEwCynL&_nc_oc=AdryAQZNudEJw5GxM8tbfqYyYyiZQqj8076e9W3zwAZ_ze-dHLxwAPjfJ5HFrGKlLU0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2WMRST2iAvK15xT_fLz5yjsPy3nU9WI57VGvXmJowxA&oe=6A75E984"}, {"file_name": "5.png", "id": "1530681885421045", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823930_1530681888754378_931705104224885383_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VuQ19OZZ3SIQ7kNvwH3FPM0&_nc_oc=Adpk5mZ6YZ74uawGRO75IW_DEKUtMv0uTpY0ti3qFiH-xEPGOaX9wuW7BsWCR4jyj70&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE7R54PV267Qh5wj26ekz4tn9JKoyxOrogAV2t2fph0Aw&oe=6A75C33D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "6.png", "id": "993900340364663", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825345_993900343697996_2537315475868427991_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9GWCHchvr_gQ7kNvwFeP-E_&_nc_oc=Adqtum_H-Fv_a3Xa0C-QRGQWXhG8Cn2ojACGxxGf3ornqOD-4Halv4YiNVy3xTt2oN0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3GsxGbcDLuYy4kBfZrwPUtFIAzYgzm0DBRDkbzn_fZw&oe=6A75DDD8"}, "display_name": "F1 Racing Game FormulaX Car Racing VR", "keywords": ["cargame", "racinggame", "trackracing", "formularacing"], "long_description": "Formula Car Racing VR is an exciting and immersive car racing game that brings high-speed Formula-style racing into virtual reality. Take control of powerful race cars and compete in thrilling races designed for speed, precision, and skill.\n\nRace through multiple environments including city racing, desert racing, and snow racing tracks. Each track offers unique challenges, from tight corners to long high-speed straights, making every race intense and rewarding.\n\nThis car racing game features smooth controls, responsive handling, and competitive AI opponents that push you to improve 
\nThis car racing game features smooth controls, responsive handling, and competitive AI opponents that push you to improve your driving skills. Whether you're aiming for the fastest lap or battling for first place, every race delivers adrenaline-filled action.\n\nPerfect for fans of fast driving and competitive gameplay, this VR car racing game offers an engaging experience for all racing enthusiasts.", "short_description": "A fast-paced VR car racing game featuring Formula-style cars, intense tracks, and high-speed competition."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/neonhorizons/privacy-policy/privacy-policy-meta-quest", "developer_terms_of_service_url": null, "publisher_name": "Neon Horizon", "support_website_url": null, "website_url": "https://sites.google.com/view/neonhorizons/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27260067710361456"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822307_1668813540909662_414748132873897852_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_rIJUyL1vpYQ7kNvwGPXUPy&_nc_oc=Ado9OVXVh0wGlCtds16vm7ioqM8K3ClDEUYRn_R99M2BFa8HOEr3rCIFysnWaP5UyeE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDHkg1-RLUPvXB-0v2N4y6tanvGaeolgw6zQ_Gel75Eiw&oe=6A69EC6B
uluscdn.com/v/t64.5771-25/491823905_1082182211421478_7214508785817806073_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ZZE5UeAcS0Q7kNvwE4v8ab&_nc_oc=AdrKVi38g8jA8VFHGGXK8CQpBD8cdQCVaZ4RUb_rSdf6TQq653W1Wf5HRF4gJ0BL3og&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGGuOBZ77zvJe3x4N7TpGAf7Qpj5ZqppyG3lCD3S6DhqQ&oe=6A749804"}, {"file_name": "5.png", "id": "1530681885421045", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823930_1530681888754378_931705104224885383_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VuQ19OZZ3SIQ7kNvwFXBblw&_nc_oc=Adr27x5QDSlGyq12hd61tZdZHh3Fxi7Ykw3OY0j5WoyYWYddVFm68uT_VAe5JomX9qI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRIllWfHikEKETpnJ9YMZ0TIwNdB3FPhcnhXA6RNpxsw&oe=6A7471BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "6.png", "id": "993900340364663", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825345_993900343697996_2537315475868427991_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9GWCHchvr_gQ7kNvwH5UwKR&_nc_oc=AdpfAN4P4hhXWFdjRSUuS9Dme8Kaq8rfi6JzlZSmQTwxNiyYRZObHvFOJhGYYLJb-KE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH99a1YzMwwoRRlYE1qusfwdYZGCmzSvoa98wrNlNEOqA&oe=6A748C58"}, "display_name": "F1 Racing Game FormulaX Car Racing VR", "keywords": ["cargame", "racinggame", "trackracing", "formularacing"], "long_description": "Formula Car Racing VR is an exciting and immersive car racing game that brings high-speed Formula-style racing into virtual reality. Take control of powerful race cars and compete in thrilling races designed for speed, precision, and skill.\n\nRace through multiple environments including city racing, desert racing, and snow racing tracks. Each track offers unique challenges, from tight corners to long high-speed straights, making every race intense and rewarding.\n\nThis car racing game features smooth controls, responsive handling, and competitive AI opponents that push you to improve 
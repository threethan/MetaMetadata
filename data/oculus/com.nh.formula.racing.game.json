ponsive handling, and competitive AI opponents that push you to improve your driving skills. Whether you're aiming for the fastest lap or battling for first place, every race delivers adrenaline-filled action.\n\nPerfect for fans of fast driving and competitive gameplay, this VR car racing game offers an engaging experience for all racing enthusiasts.", "short_description": "A fast-paced VR car racing game featuring Formula-style cars, intense tracks, and high-speed competition."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/neonhorizons/privacy-policy/privacy-policy-meta-quest", "developer_terms_of_service_url": null, "publisher_name": "Neon Horizon", "support_website_url": null, "website_url": "https://sites.google.com/view/neonhorizons/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26469426006092301"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "822916853808426"}]}, "baseline_offer": {"id": "822916853808426"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1778782620, "status": "PUBLISHED", "id": "822916853808426"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26983747497993480", "version": "1.0.4"}, "id": "1522978982717602", "channe
uluscdn.com/v/t64.5771-25/491823905_1082182211421478_7214508785817806073_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XIolLeQ5QtAQ7kNvwGlUiis&_nc_oc=Adp6ILnHn5t3Sy_Vz8IyrzU4cwKH8vXrQHSJPz7GP1Afb6U5cuXw8JTJwBneZWYD2g4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGbDw1_ZOcDCc6cm_7JyLMZOcc_EiSSa5hYDEb7HrnE4A&oe=6A7B2F84"}, {"file_name": "5.png", "id": "1530681885421045", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823930_1530681888754378_931705104224885383_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uyAWSfYTsHsQ7kNvwHXoXMa&_nc_oc=AdrXcNHrzwMIZ36y4yXMeXxf9TK8CL2v5UQrXlTPHUP4q7AyXFCGIEEVHakvjWiuFWU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUlhmeg5XYYDA-huYqqdE1YVtIQJq0dg0Sf0KBPbLlUQ&oe=6A7B093D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "6.png", "id": "993900340364663", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825345_993900343697996_2537315475868427991_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yv9uD6trNX8Q7kNvwGYREDG&_nc_oc=Adp8Fv-cXu2xMrdLaM5VSNE0kuNBy__Dil6xgUnQSqm9NPv2FnBhOR1ezgD6s6sTo_0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE1Y1391KerCDAH_sRC-oZT-1a1k1qA0pZ-f1QvStwB_Q&oe=6A7B23D8"}, "display_name": "F1 Racing Game FormulaX Car Racing VR", "keywords": ["cargame", "racinggame", "trackracing", "formularacing"], "long_description": "Formula Car Racing VR is an exciting and immersive car racing game that brings high-speed Formula-style racing into virtual reality. Take control of powerful race cars and compete in thrilling races designed for speed, precision, and skill.\n\nRace through multiple environments including city racing, desert racing, and snow racing tracks. Each track offers unique challenges, from tight corners to long high-speed straights, making every race intense and rewarding.\n\nThis car racing game features smooth controls, responsive handling, and competitive AI opponents that push you to improve 
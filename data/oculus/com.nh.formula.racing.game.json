&_nc_sid=6e7a0a&_nc_ohc=vlTMqQbFjcEQ7kNvwFIAChd&_nc_oc=Adq7ljM_M-e7w_vJd7qgQZuyfrLPVAj4boCGboxvslztTaPl4sCCMT5yBmApywmsza8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9o5-WNsq6zT6vltz2l2D61kLxbtai5SOvbx-CufhrwqA&oe=6A296291"}, {"file_name": "4.png", "id": "2220991781975295", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819239_2220991785308628_7410222194769413318_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hR-HK4NacFQQ7kNvwHzm7C2&_nc_oc=AdrCGm-wg1_CEVHagtlg4si6NWkg6Xe9iA36OAMGwYa5r-c0yxXj3f4WD9U_lRXsF9I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-J4rjFpy2l_IvU0m9v0G2aR8uD9DlFL_DPhRJTbyxElw&oe=6A296109"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "F1 Racing Game FormulaX Car Racing VR", "keywords": ["cargame", "racinggame", "trackracing", "formularacing"], "long_description": "Formula Car Racing VR is an exciting and immersive car racing game that brings high-speed Formula-style racing into virtual reality. Take control of powerful race cars and compete in thrilling races designed for speed, precision, and skill.\n\nRace through multiple environments including city racing, desert racing, and snow racing tracks. Each track offers unique challenges, from tight corners to long high-speed straights, making every race intense and rewarding.\n\nThis car racing game features smooth controls, responsive handling, and competitive AI opponents that push you to improve your driving skills. Whether you're aiming for the fastest lap or battling for first place, every race delivers adrenaline-filled action.\n\nPerfect for fans of fast driving and competitive gameplay, this VR car racing game offers an engaging experience for all racing enthusiasts.", "short_description": "A fast-paced VR car racing game featuring Formula-style cars, intense tracks, and high-speed competition."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/neonhorizons/pri
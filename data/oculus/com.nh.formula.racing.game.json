uluscdn.com/v/t64.5771-25/499310646_2031190180828087_4411526309332667398_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hJdqVc9iIZwQ7kNvwEtw-8o&_nc_oc=AdqcRMntbra5CaDouFry6m4KBy9z3VciYROYpMHyEB1H0fi5GdsB7JtS70rif_GZuXo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHhL4ryDG-dYW6pMPffET74HVJKzcFUCu7UeLWXpCEC-Q&oe=6A8456CC"}, {"file_name": "5.png", "id": "2982429281965825", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499314351_2982429285299158_3558721884471705471_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EkkNWfnapKYQ7kNvwHcZzVC&_nc_oc=AdrEZDZ9k91ROem4by4oiO1nlaXdmTlya-gkmJjvfn8yxrNDzKCeUtKAKodk78rJiT4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEoXZe4Y72GvtYCmk7jklJZ5zpk1AaMQZaJKIuv0sIHpg&oe=6A846748"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "6.png", "id": "993900340364663", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825345_993900343697996_2537315475868427991_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-N1aLMRoQJ8Q7kNvwFyTBF7&_nc_oc=AdrTktmZKAlBUCgzuiqlNLW9a0dc3KWins3aNxUPqkRlwe-pqdVFhpkm-JKRdr5uyRg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE9cw2e3OPMqkVdCb-uGQKlzWzX08yfIzEw3fPUXjB80A&oe=6A845E58"}, "display_name": "F1 Racing Game FormulaX Car Racing VR", "keywords": ["cargame", "racinggame", "trackracing", "formularacing"], "long_description": "Experience the thrill of Formula racing in virtual reality. Step into the cockpit of a high-speed Formula car and race on challenging circuits with realistic handling, immersive physics, and intense competition.\n\nDrive like a professional racer, master every corner, and push your skills to the limit in this Formula racing simulator designed for virtual reality.\n\nFeatures\n\ud83c\udfce\ufe0f Realistic Formula car driving\n\ud83c\udfc1 High-speed Grand Prix racing\n\ud83c\udfae Immersive virtual reality cockpit experience\n\ud83c\udf0d Multiple racing circuits\n\u26a1 Smooth controls and realistic physics\n\ud83c\udfc6 Time Trial and Championship gameplay\n\ud83d\udea5 Fast-paced single-seater racing\n\ud83d\udd25 Challenging AI opponents\n\ud83c\udfaf Designed for Formula racing fans\n\nWhether you're a fan of Formula racing, racing simulators, Grand Prix racing, or open-wheel motorsport, this game delivers the speed, precision, and excitement of professional racing in virtual reality.\n\nDownload now and become the ultimate Formula racing champion!", "short_description": "Experience the thrill of VR Formula racing! Drive high-speed Formula cars, master challenging circuits, and become the ultimate Grand Prix champion in an immersive virtual reality racing simulator."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/neonhorizons/privacy-policy/privacy-policy-meta-quest", "developer_terms_of_service_url": null, "publisher_name": "Neon Horizon", "support_website_url": null, "website_url": "https://sites.google.com/view/neonhorizons/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27326717910363102"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822307_1668813540909662_414748132873897852_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8R1xhZFDjaEQ7kNvwErbrU7&_nc_oc=Ador29NE17BW86m86hRTsPfNyFvh
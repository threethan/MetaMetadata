rjZZ0k47ojOSWzN_p7Rf1NN6g&oe=6A6CC2B9"}, {"file_name": "4.png", "id": "1082182208088145", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823905_1082182211421478_7214508785817806073_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XLehoeAftckQ7kNvwFXh6h4&_nc_oc=AdpVF5NRFjTGOQzIZknNC-Tf9_ElJa8uAZoZdtoW-LQZ5WtRiGnRpq0y8kl_-zwynh8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBzVtYwzYsVgrrE_6Rz7JnxHSmTPug7TmIxIp9qgioicw&oe=6A6CAF04"}, {"file_name": "5.png", "id": "1530681885421045", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823930_1530681888754378_931705104224885383_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sHDKAjN6QTMQ7kNvwEUrYEY&_nc_oc=AdrzAIfHovONucZMbUCNW13q_Swl5ksuwkkqeU30wKODAfMkJ928NK57MPYE1P4B85k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAvBM_-kj3x33QiVrY-wftiHh66w3FGi-8hLYKlv7veoQ&oe=6A6CC0FD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "6.png", "id": "993900340364663", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825345_993900343697996_2537315475868427991_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9kFZ2NgChV8Q7kNvwGkXYXL&_nc_oc=AdqbWwPwKUKq55iyPUyC68DDVWw9OPcgCiawPzth16ZoLlAI9vn657rFSylnMto1X1E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBqDLsg6rgwiTXaLAeT95ifSopDnfj_iicr4X4VQ5hQug&oe=6A6CA358"}, "display_name": "F1 Racing Game FormulaX Car Racing VR", "keywords": ["cargame", "racinggame", "trackracing", "formularacing"], "long_description": "Formula Car Racing VR is an exciting and immersive car racing game that brings high-speed Formula-style racing into virtual reality. Take control of powerful race cars and compete in thrilling races designed for speed, precision, and skill.\n\nRace through multiple environments including city racing, desert racing, and snow racing tracks. Each track offers unique challenges, from tight corners to long high-speed straights, making every race intense and rewarding.\n\nThis car racing game features smooth controls, responsive handling, and competitive AI opponents that push you to improve your driving skills. Whether you're aiming for the fastest lap or battling for first place, every race delivers adrenaline-filled action.\n\nPerfect for fans of fast driving and competitive gameplay, this VR car racing game offers an engaging experience for all racing enthusiasts.", "short_description": "A fast-paced VR car racing game featuring Formula-style cars, intense tracks, and high-speed competition."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/neonhorizons/privacy-policy/privacy-policy-meta-quest", "developer_terms_of_service_url": null, "publisher_name": "Neon Horizon", "support_website_url": null, "website_url": "https://sites.google.com/view/neonhorizons/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27260067710361456"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822307_1668813540909662_414748132873897852_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DuY_udZ2F5kQ7kNvwEjIU5y&_nc_oc=AdrnfB55s5M6J25mHS_lrNMY42xjduK8bYl31if-w6wKfKxkHB8dLaj_qpSLKeUZcrk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBWD1PVEfcEOuKHiRh3g61juXoywoRkMlBDpg6UVEtBSw&oe=6A6C8F6B
_ptoQCXjo7OMTmA6jMklFQlSzBJtodUGqXWg&oe=6A85A71B"}, {"file_name": "1.png", "id": "2031190177494754", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499310646_2031190180828087_4411526309332667398_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UjEICFn6dm0Q7kNvwEJ7Pty&_nc_oc=AdrYxTR4d8Se6R5m7IWnJV54gjcq0fgoUu4td4h-fcMz2LCkLNE3bjMn21OKzh1o7HE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJiS0m4B8nXMpb1BhiWNOzFw5PVfrA2W4NF8suTyVYHg&oe=6A85A84C"}, {"file_name": "5.png", "id": "2982429281965825", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499314351_2982429285299158_3558721884471705471_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p0SgZR7tw4cQ7kNvwHqt_Wy&_nc_oc=AdrMwIdTxvMc3HVIx7eVDzqs4D2EUz0TPLZcH7puC353hhaoxRmzWnuq8pgNYBCO0QA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHEe9eXwYvbhvjQxvoujctegVjyby4qsVyGxs22HFGgOg&oe=6A858088"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "6.png", "id": "993900340364663", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491825345_993900343697996_2537315475868427991_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-N1aLMRoQJ8Q7kNvwFxRYYT&_nc_oc=AdqNX52rTh6P1moUoRn3VKJOYLbz_1qCUvDfYw6nmYjIR5AOeqg3FNUZWHOUpaHACvI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG89E1dePeCaqdLauQAqNV1_A3zeGQAHRYtClTVCs5XkQ&oe=6A85AFD8"}, "display_name": "F1 Racing Game FormulaX Car Racing VR", "keywords": ["cargame", "racinggame", "trackracing", "formularacing"], "long_description": "Experience the thrill of Formula racing in virtual reality. Step into the cockpit of a high-speed Formula car and race on challenging circuits with realistic handling, immersive physics, and intense competition.\n\nDrive like a professional racer, master every corner, and push your skills to the limit in this Formula racing simulator designed for virtual reality.\n\nFeatures\n\ud83c\udfce\ufe0f Realistic Formula car driving\n\ud83c\udfc1 High-speed Grand Prix racing\n\ud83c\udfae Immersive virtual reality cockpit experience\n\ud83c\udf0d Multiple racing circuits\n\u26a1 Smooth controls and realistic physics\n\ud83c\udfc6 Time Trial and Championship gameplay\n\ud83d\udea5 Fast-paced single-seater racing\n\ud83d\udd25 Challenging AI opponents\n\ud83c\udfaf Designed for Formula racing fans\n\nWhether you're a fan of Formula racing, racing simulators, Grand Prix racing, or open-wheel motorsport, this game delivers the speed, precision, and excitement of professional racing in virtual reality.\n\nDownload now and become the ultimate Formula racing champion!", "short_description": "Experience the thrill of VR Formula racing! Drive high-speed Formula cars, master challenging circuits, and become the ultimate Grand Prix champion in an immersive virtual reality racing simulator."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/neonhorizons/privacy-policy/privacy-policy-meta-quest", "developer_terms_of_service_url": null, "publisher_name": "Neon Horizon", "support_website_url": null, "website_url": "https://sites.google.com/view/neonhorizons/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27326717910363102"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491822307_1668813540909662_414748
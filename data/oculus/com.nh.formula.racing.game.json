uluscdn.com/v/t64.5771-25/491823905_1082182211421478_7214508785817806073_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=55mYBlhfXpoQ7kNvwGGX9X0&_nc_oc=AdrQkDtbevw7tcmg5_3xksS55mtO3Xn-Fln5srmIXHNwQ31gTiNt7nCNu1v5HLa2smg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE7ezTfThDFzNYCKwh1F_gxk4MnPDFTTmBOA6qsEDFIcQ&oe=6A788C84"}, {"file_name": "5.png", "id": "1530681885421045", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823930_1530681888754378_931705104224885383_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uyAWSfYTsHsQ7kNvwFuhTVj&_nc_oc=AdpuN9a_z-ezIuUOtuMdiFDU2l5TGrd9cMwf8XZl548QSv8ALrKJXyWORCAu4Sfio_Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFTPxNU_grncHd9CZTfrqKBjaybQWvJPP843nvn6_mpkg&oe=6A78663D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "6.png", "id": "993900340364663", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825345_993900343697996_2537315475868427991_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FceQVb2OQr0Q7kNvwHmkHAB&_nc_oc=AdqupSPDQWrd2X9tbUOVP-Ocr62OXuC9aI7X64KzfCrfJq2yaYY1vyBERGDt1qyVJHU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPpumvR_DjmxNgHeNWc7XCj7Di5tlfez2BYw04sA-UTg&oe=6A7880D8"}, "display_name": "F1 Racing Game FormulaX Car Racing VR", "keywords": ["cargame", "racinggame", "trackracing", "formularacing"], "long_description": "Formula Car Racing VR is an exciting and immersive car racing game that brings high-speed Formula-style racing into virtual reality. Take control of powerful race cars and compete in thrilling races designed for speed, precision, and skill.\n\nRace through multiple environments including city racing, desert racing, and snow racing tracks. Each track offers unique challenges, from tight corners to long high-speed straights, making every race intense and rewarding.\n\nThis car racing game features smooth controls, responsive handling, and competitive AI opponents that push you to improve 
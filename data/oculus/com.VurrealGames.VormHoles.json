m hordes of snake like creatures.  The snakes come from another dimension with one aim in mind, to destroy temples and harness the energy of your world. But these creatures have a weakness, fireworks! \nDefend 14 levels spanning a variety of landscapes from mist covered mountain tops, snowy peaks, and exotic waterfalls. Be treated with your personal firework show as each level is cleared."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.vurrealgames.com/", "developer_terms_of_service_url": "http://www.vurrealgames.com/", "publisher_name": "Vurreal Games", "support_website_url": null, "website_url": "http://www.vormholes.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "309178907917720"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974644_348590852636656_7169743818093232128_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_p2yFiCTiC8Q7kNvwGa0Z8Q&_nc_oc=Adk12ajTGxM10mzDt037RFU9N7kt8K8qLG_5LhSGoa09E_58XSvw1zGL1oDg9pUH6kk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afvl1uuKqHdwHYsrYZGuoAorVu2O2TbCxQY30Ztz-pZ46w&oe=69A6C949"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VormHoles", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1518026400, "lastRevision": {"nodes": [{"id": "2035145556717948", "release_type": "SCHEDU
60207104_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8DtEFM-yONwQ7kNvwEmTrdD&_nc_oc=AdrbFMnz7MorWoEqleR-5zzQU64RiReJZi7LRsV-F5xMoEd8mr8wAXEXtz7UY56XTGw&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFf8weWRKZwobD3OiEC8-O9k2Pe7seQ_x77kiYydmgeqw&oe=6A8D8760"}, {"file_name": "migrated_image.png", "id": "582163982644285", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/11162716_298551073985277_7663704274479611904_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SBpMporrJl8Q7kNvwG71MAf&_nc_oc=Adpcokk-6EPAGkU8t4LTyUjeZDas20kswl3n0gAd-M5ckl7R3ZZXEbeyhNuqZTGDTag&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3DYMk9MC5OPLlyYL_Xh9N3OdJZ5uz33AbSLsucAWsmQ&oe=6A8D87DB"}, {"file_name": "migrated_image.png", "id": "528525218044344", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/11162702_1526273280788371_2161103964253192192_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TssTp7l4Y_EQ7kNvwELFAth&_nc_oc=AdoqEZxQMiuCXCZUDSxXCEZEhQ01q1qMXEpiW2LqIVyQGnu5RB3epM-T6tbeZ1Q-61I&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3Y_qREL3k_T9dhBJZ_SiGL0QAkrnkY0BgXSz4k6nsuw&oe=6A8D8C14"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VormHoles", "keywords": ["Shooter", "Firework", "Snake", "Defend", "Temples"], "long_description": "Armed with a firework rocket launcher, you must defend your temples from hordes of snake like creatures.  The snakes come from another dimension with one aim in mind, to destroy temples and harness the energy of your world. But these creatures have a weakness, fireworks!\n \nDefend 14 levels spanning a variety of landscapes from mist covered mountain tops, snowy peaks, and exotic waterfalls. Be treated with your personal firework show as each level is cleared.\nChoose the right firework for the job. Match the firework color with the snake color and inflict a chain reaction of damage. Motion comfort can be tweaked to your liking. Teleportation can be immediate or movement can be experienced as you travel from point to point.", "short_description": "Armed with a firework rocket launcher, you must defend your temples from hordes of snake like creatures.  The snakes come from another dimension with one aim in mind, to destroy temples and harness the energy of your world. But these creatures have a weakness, fireworks! \nDefend 14 levels spanning a variety of landscapes from mist covered mountain tops, snowy peaks, and exotic waterfalls. Be treated with your personal firework show as each level is cleared."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.vurrealgames.com/", "developer_terms_of_service_url": "http://www.vurrealgames.com/", "publisher_name": "Vurreal Games", "support_website_url": null, "website_url": "http://www.vormholes.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "309178907917720"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974644_348590852636656_7169743818093232128_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eu43Dw7n7HoQ7kNvwFxJQGd&_nc_oc=Adra8S5efYvvYzpDwgb_r3xi7aqLcVgXpya2i1QE5Ds1wKw0SjksNq5LUxWSc8UVwB8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHW8viokOaBK5IysfSG9chLJUI0FClu4qQjRamuckKYsQ&oe=6A8D7FC9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "V
60207104_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qr3ujzKgAhUQ7kNvwFq7TIz&_nc_oc=AdrhpDFfFPxkqeuRGs5EUNMrZnGAoeOsGQ1oFZWeieNntKcpf2GrA6P_kRzBbBu2txc&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEIZpPPUmDBSzD0t4qAbMVrNWGOPs8YBr7W_6mggA_2sA&oe=6A859E60"}, {"file_name": "migrated_image.png", "id": "582163982644285", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/11162716_298551073985277_7663704274479611904_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v37txjR-_hIQ7kNvwHicbag&_nc_oc=AdotdL5NntTRLdtZWfGEAc6co8aNh7VdTXCohPdHV_4PRficxPt73s1mqKkJo_w5KS8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFrMFPduuQ6lW4ozzFCeo5JnoSpPlLeB-QM95KObBI_WQ&oe=6A859EDB"}, {"file_name": "migrated_image.png", "id": "528525218044344", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/11162702_1526273280788371_2161103964253192192_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UH6uNpWi_wQQ7kNvwGQ-dze&_nc_oc=AdrXjtl8RMKJeWvBsBHx4SLRhGUFYlrGFPOp-CTDQnqK6MLPr055KxhvSHVE1LpT9is&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFfXMP2WH4eQ_lF924YZJqfAnkZLgwAkcP5MuxBwbV7rQ&oe=6A85A314"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VormHoles", "keywords": ["Shooter", "Firework", "Snake", "Defend", "Temples"], "long_description": "Armed with a firework rocket launcher, you must defend your temples from hordes of snake like creatures.  The snakes come from another dimension with one aim in mind, to destroy temples and harness the energy of your world. But these creatures have a weakness, fireworks!\n \nDefend 14 levels spanning a variety of landscapes from mist covered mountain tops, snowy peaks, and exotic waterfalls. Be treated with your personal firework show as each level is cleared.\nChoose the right firework for the job. Match the firework color with the snake color and inflict a chain reaction of damage. Motion comfort can be tweaked to your liking. Teleportation can be immediate or movement can be experienced as you travel from point to point.", "short_description": "Armed with a firework rocket launcher, you must defend your temples from hordes of snake like creatures.  The snakes come from another dimension with one aim in mind, to destroy temples and harness the energy of your world. But these creatures have a weakness, fireworks! \nDefend 14 levels spanning a variety of landscapes from mist covered mountain tops, snowy peaks, and exotic waterfalls. Be treated with your personal firework show as each level is cleared."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.vurrealgames.com/", "developer_terms_of_service_url": "http://www.vurrealgames.com/", "publisher_name": "Vurreal Games", "support_website_url": null, "website_url": "http://www.vormholes.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "309178907917720"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974644_348590852636656_7169743818093232128_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0lUzGnGlwIEQ7kNvwFeZf_i&_nc_oc=AdrkVB66TcWinl_BfSiobRdASNGN_6zwjqlXubjEKZ0kSDgsa-gFlkorSH0jM9c17kg&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHEkMcDY1xpZHJJxkqCaikQJy5qLfCDCG025CmrIJ6heQ&oe=6A8596C9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "V
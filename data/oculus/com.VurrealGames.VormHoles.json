04_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ybjY8CigFKgQ7kNvwEuoh38&_nc_oc=Adp_-KcKnG6-6X6vp40kLFKBHW3-9ZcHSbD0qPse03Ofy3FjN1owaChPdZjZrofo2ug&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQ-XRfE80r3hOXb6DaGQkuion8rTNz282Czas1ZFS1Gw&oe=6AA3F0E0"}, {"file_name": "migrated_image.png", "id": "582163982644285", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/11162716_298551073985277_7663704274479611904_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kdtYPMtlhA0Q7kNvwEyC0YP&_nc_oc=AdrXVRyCXYsrzQsu_HQDG8XzSOlQ_c3-RnTyaIjS7lVG2du3Ns-yG-KA_1Z92rWjRyU&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZMD5t0kSQTLEDJimm1aJjl6Q5L23MGri0uXBeSbiVhw&oe=6AA3F15B"}, {"file_name": "migrated_image.png", "id": "528525218044344", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/11162702_1526273280788371_2161103964253192192_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_OxEJ_PODssQ7kNvwHYQsBl&_nc_oc=Adp3p96rN1HbYPYfOrHe4bkBQwJnJHvT2XzDXP4ugI8pX3C89F_Gr9UcR0OBw_PAvqo&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkdNqNK_FZugGRKUJBugTcoBtw0ZhFCtKVQxtgwF7UKQ&oe=6AA3F594"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VormHoles", "keywords": ["Shooter", "Firework", "Snake", "Defend", "Temples"], "long_description": "Armed with a firework rocket launcher, you must defend your temples from hordes of snake like creatures.  The snakes come from another dimension with one aim in mind, to destroy temples and harness the energy of your world. But these creatures have a weakness, fireworks!\n \nDefend 14 levels spanning a variety of landscapes from mist covered mountain tops, snowy peaks, and exotic waterfalls. Be treated with your personal firework show as each level is cleared.\nChoose the right firework for the job. Match the firework color with the snake color and inflict a chain reaction of damage. Motion comfort can be tweaked to your liking. Teleportation can be immediate or movement can be experienced as you travel from point to point.", "short_description": "Armed with a firework rocket launcher, you must defend your temples from hordes of snake like creatures.  The snakes come from another dimension with one aim in mind, to destroy temples and harness the energy of your world. But these creatures have a weakness, fireworks! \nDefend 14 levels spanning a variety of landscapes from mist covered mountain tops, snowy peaks, and exotic waterfalls. Be treated with your personal firework show as each level is cleared."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.vurrealgames.com/", "developer_terms_of_service_url": "http://www.vurrealgames.com/", "publisher_name": "Vurreal Games", "support_website_url": null, "website_url": "http://www.vormholes.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "309178907917720"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974644_348590852636656_7169743818093232128_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=km-CGRLvnX0Q7kNvwHpJRwG&_nc_oc=AdoDf9hKIJZw3NqbAAJtHNeZYSPwb1ddtLCe2xyF0-G-7WBiSgdydBv5XtheAFctrCI&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJhyCiSlI51do7BfGiVFma12bJhXbOMaUZ3KHk-7QB-SA&oe=6AA42189"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VormHoles",
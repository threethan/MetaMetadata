11_6510405933737181184_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xYysZCNM460Q7kNvwGOuEcP&_nc_oc=Ado-rFiX7MIEUl_ujEP9X8Q9iC12pzEPPKOAF3LDoJPkCNq5nGI78cTQCk4ZL_HbfgU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9QkqYd4dGBKZo_LgTzxay9qwIoEhCZTAsCJUoyCVcWA&oe=6B05B4C8"}, {"file_name": "migrated_image.png", "id": "270317497305134", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162702_940843752723071_7966005332860207104_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kah30f5LNlYQ7kNvwHcwghY&_nc_oc=AdqjOnUGAGi8OA_P1XpiTnspRsAMfsIf1UWFC0HXnfx9tmbZ6M6kgBFtc8RhNCeyNn0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJjd1rqA43v7pXNkx92p0D67L640lcLfIm_FecMieFfg&oe=6B05B820"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VormHoles_video_cover2.png", "id": "2065375087074430", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427574_2065375090407763_3185419854366638080_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WShMwpaiSOgQ7kNvwF4RaeQ&_nc_oc=Adq6tqeD92pe04WqMuOcKUE_j3cgdzRtfVMZ50WwZSh5WBFFxcqriKqvmDQ9CexzMcY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRS6ARI7HCdnHZRfI4F2mjr7Mz6XqW_Cn8fYC5YD2yppA&oe=6B05D42F"}, "display_name": "VormHoles", "keywords": ["Shooter", "Firework", "Snake", "Defend", "Temples"], "long_description": "Armed with a firework rocket launcher, you must defend your temples from hordes of snake like creatures.  The snakes come from another dimension with one aim in mind, to destroy temples and harness the energy of your world. But these creatures have a weakness, fireworks!\n \nDefend 14 levels spanning a variety of landscapes from mist covered mountain tops, snowy peaks, and exotic waterfalls. Be treated with your personal firework show as each level is cleared.\nChoose the right firework for the job. Match the firework color with the snake color and inflict a chain reaction of damage. Motion comfort can be tweaked to your liking. Teleportation can be immediate or movement can be experienced as you travel from point to point.", "short_description": "Armed with a firework rocket launcher, you must defend your temples from hordes of snake like creatures.  The snakes come from another dimension with one aim in mind, to destroy temples and harness the energy of your world. But these creatures have a weakness, fireworks! \nDefend 14 levels spanning a variety of landscapes from mist covered mountain tops, snowy peaks, and exotic waterfalls. Be treated with your personal firework show as each level is cleared."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.vurrealgames.com/", "developer_terms_of_service_url": "http://www.vurrealgames.com/", "publisher_name": "Vurreal Games", "support_website_url": null, "website_url": "http://www.vormholes.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "620737212527482"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "217015029081182"}, {"status": "PUBLISHED", "id": "314444179289479"}, {"status": "PUBLISHED", "id": "512590812470850"}, {"status": "PUBLISHED", "id": "2009973905884661"}, {"status": "PUBLISHED", "id": "466958030427093"}]}, "baseline_offer": {"id": "2009973905884661"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1528354800, "status": "PUBLISHED", "id": "2170150290811
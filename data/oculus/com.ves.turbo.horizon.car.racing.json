://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/596168449_4437581396558494_6857594523971801084_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YYegHDxxC0gQ7kNvwHIv9jV&_nc_oc=AdqYWd7oP7OQgvFJ_zWBlxheD-CFfsyDqBPcMVl2ZyPILgxcwaEVqfnCjynpBcV-FKg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWYyl3ErNdeCm4eFL-nfAzybQ5CKKunMEIHpye3Vz7UwA&oe=6B104FD5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Turbo Horizon: Car Racing VR", "keywords": ["turbohorizon", "carracing", "speedx", "racinggame", "cargame"], "long_description": "Get ready for high-speed VR car racing! Turbo Horizon puts you behind the wheel for an immersive racing experience packed with fast cars, exciting tracks, intense competition, and adrenaline-fueled driving.\n\nChoose from 10 different racing cars and race across 5 exciting tracks. Accelerate, overtake rivals, master sharp corners, and push your speedometer to the limit as you chase the finish line.\n\n\ud83e\udd7d Immersive VR Racing\nExperience car racing from an engaging driver's perspective. Look around, feel closer to the action, and enjoy the thrill of driving in virtual reality.\n\n\ud83c\udfce\ufe0f 10 Racing Cars\nPick your favorite car and discover the excitement of high-speed driving. Find the car that matches your racing style and push it to the limit.\n\n\ud83d\udee3\ufe0f 5 Exciting Tracks\nRace through unique environments and challenging roads. Learn every corner, improve your racing line, and aim for faster finish times.\n\n\u26a1 High-Speed Action\nHit the accelerator and watch your speedometer climb. Overtake opponents, take corners at speed, and fight your way to the finish.\n\nFeatures\n\n\u2022 VR car racing experience\n\u2022 10 racing cars\n\u2022 5 exciting tracks\n\u2022 High-speed racing action\n\u2022 In-game speedometer\n\u2022 Immersive VR driving\n\u2022 Exciting racing environments\n\u2022 Fast-paced competitive gameplay\n\nChoose your car. Hit the accelerator. Own the Horizon.\n\n\ud83d\udd25 Pre-order Turbo Horizon: Car Racing VR and get ready to race!", "short_description": "Pre-order Turbo Horizon: Car Racing VR! Get ready for high-speed VR racing with 10 cars, 5 exciting tracks, immersive driving, and intense speedometer action.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vision-edge-studio/home/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Vision Edge Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vision-edge-studio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1345717565272116"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PENDING", "id": "1005336385381486"}, {"status": "PUBLISHED", "id": "2522405511564954"}, {"status": "PUBLISHED", "id": "2410354116121252"}]}, "baseline_offer": {"id": "2522405511564954"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 0, "status": "PENDING", "id": "1005336385381486"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1381721185005087", "version": "1.3"}, "id": "1591239212459604", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary":
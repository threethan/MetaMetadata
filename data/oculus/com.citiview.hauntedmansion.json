33627970635039354_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ccqboWNfxhwQ7kNvwFeeUNY&_nc_oc=AdqwqS2sVUso4YDlGVnL8uu7ySPXCRlGcjQPlGkiY6VS1hUqrRwUOrFIqi8hcpYOWfo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2JopGgsG3GMi0HFK9dXQigL8Rvrfv35kA6hJ4jTiK4w&oe=6AFDBB5C"}, {"file_name": "screenshot_3.png", "id": "2594125857721075", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830441_2594125861054408_2296750272863366485_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Iuct6aJqHwQ7kNvwFbTXtV&_nc_oc=AdoJ_RPOlYMIEJtlG_i80brOJWD-qjAHW4ucZNxaa3alN3XueJ6n_KSZ7btwI1e4ABw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRd5m7Y8_7DsXJp66cJi_vtcoTXP5TYUe2UfThfKwzPQ&oe=6AFDB042"}, {"file_name": "screenshot_4.png", "id": "38651682991144468", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/596061819_38651683014477799_7684749312391594220_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FoAIz1ExcJ4Q7kNvwFdOJQO&_nc_oc=AdprreQEiKlc_mWJkdv3Go7L7ftSnGpTTbjVHhsEEWBaIDCcTmNcXo2_yuUeGYBgDH8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTe4Dl7cwfB1CPqUO0bjom46zyKHUARyKgv_7NVTBDPTQ&oe=6AFDC4A1"}, {"file_name": "screenshot_5.png", "id": "1364679168981229", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491831569_1364679172314562_7721130806589057626_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=flTehhMUCUkQ7kNvwHiw0rd&_nc_oc=Adph3zR_ULVpEh3-PdV1Py4ExmGh-7-lcW3EwobfBye5jSdfHNN-7rFx9T7LUUoiKiU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQil8nMRrBI8q-kvf168oj_3xFSL4-ahDy8kCbCwwGXHw&oe=6AFDD194"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1912705790113339", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/595119480_1912705793446672_4946183754663356082_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rYnTQfL0b7kQ7kNvwHtRtXu&_nc_oc=Adq0JPwNuWmuH0S4mN_dHYT0Ek14DBNbavbIrESJVOKaB59mlLIhjnqfMjLGCc578jY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQafxXMeEh8JoEp_vNb3PQvDgPleddFAEtu1cRwm5Rndg&oe=6AFDE136"}, "display_name": "Haunted Mansion", "keywords": ["horror", "zombies", "mansion", "haunted", "survival"], "long_description": "Blackmoor Hall has stood empty for a hundred years. The candles still burn, the moon still fills the great arched window, and something still walks the halls. Step inside.\n\nA WHOLE MANSION TO EXPLORE\nWalk through a chequered grand foyer with a double staircase and a gallery above, a two-storey library with a crackling fire, a long candle-lit dining hall, the red-panelled west wing, the bedrooms upstairs, the kitchens and the brick-vaulted wine cellar. Walk through any doorway and the house carries you on to the next wing. And somewhere in the foyer there is a door that does not belong.\n\nTHE DEAD WALK HERE\nZombies shuffle, stagger and run through the house, and they always come from somewhere you are not looking. Hold your ground, watch the doorways, and keep them off you - five bites and your night is over.\n\nPISTOL, AUTOMATIC OR TORCH\nPress B and a wheel opens in front of you. Point and pull the trigger to pick the pistol, the long-magazine automatic, or a torch to light up the dark corners.\n\nCHASE THE HIGH SCORE\nEvery run keeps count. Press A to check your score and your best, press Y to switch the music, and see how long you can survive in Blackmoor Hall.\n\nControls: left stick to move, right stick to turn, B for the weapon wheel, trigger to fire, A for the score card, Y for the music.", "short_description": "Explore a candle-lit Victorian mansion in VR while the dead wander its halls. Pick your pistol or torch and see how long you last."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/hauntedmansion/privacy.html", "developer_terms_of_service_
0a&_nc_ohc=FruPukcWTlMQ7kNvwHhCQjk&_nc_oc=Adp7RKPRb2wSLdohrN-PfnkK1BiA4i0mjqDq1YeRA-I5HlpCLvUuw5TtAwZNT2Ap4gQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQw3A7J4w843b5szRR7wCO5mmKDOK1mO2XNBsglElPzRQ&oe=6B01C9F0"}, {"file_name": "5.png", "id": "24298744506412818", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822723_24298744516412817_307210405990550523_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YQ9gKJFaSWQQ7kNvwETNYGK&_nc_oc=AdoQodgWJfe5mMpycrvh4sNdLchWAzp62z8qfyWtinSUUftNxDKRGyef6aINoi__pI0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7R9_ZrvifxKpPd8qFARtvbSWqjkw6BIBTA_i88VvdOw&oe=6B01D4C2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Offroad Legends VR: Car Racing Game", "keywords": ["car", "racing", "driving", "simulation", "offroad"], "long_description": "Strap in and hit the dirt with Offroad Legends VR: Car Racing Game \u2014 a thrilling offroad simulation built for Meta Quest!\n\nTake control of rugged 4x4 vehicles and race through challenging environments like rocky mountains, muddy trails, steep hills, and more. With full VR immersion, realistic vehicle physics, and dynamic terrain, this is the ultimate test of your driving skill and focus.\n\nChoose from a variety of jeeps and offroad trucks, customize your ride, and explore open-world maps or push your limits in time-based racing challenges. Whether you're a casual driver or a hardcore offroad enthusiast, this game delivers adrenaline-pumping fun with every turn.\n\nKey Features:\nRealistic offroad driving physics in full VR\nMultiple vehicles with customizable options\nFree roam and mission-based gameplay\nDynamic environments: mud, hills, rocks, and rivers\nWeather effects and day-night cycles\nIntuitive VR controls for immersive driving", "short_description": "Experience the thrill of real offroad racing in full VR! Offroad Legends VR: Car Racing Game puts you behind the wheel of powerful 4x4 vehicles as you conquer rough terrain, steep hills, mud, and more. Choose from multiple jeeps and trucks, explore open environments, and take on exciting challenges. With realistic physics, dynamic weather, and immersive controls, this is the ultimate offroad adventure  car driving game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/noob-gamers/privacy-policy/meta-quest-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Examob", "support_website_url": null, "website_url": "https://sites.google.com/view/noob-gamers/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": [], "id": "24453726574282113"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24104605445860896", "version": "1.5"}, "id": "1371331937360933", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9220955201319165", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "24104605445860896"}, "release_status": "RELEASE
, "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822723_24298744516412817_307210405990550523_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FA9vBDMDFBoQ7kNvwEug0_w&_nc_oc=AdoIPs1qZ997oem4G3wESIbGc7LzS2VfCMZnMcxIjpSFzLYVvH4K9MJrqeF1TtJcSrE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLprW0Gcc9w2vpXf7aD2A6e90Gm_uldp1wcS6gxWw3Jjg&oe=6AB91A02"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Offroad Legends VR: Car Racing Game", "keywords": ["car", "racing", "driving", "simulation", "offroad"], "long_description": "Strap in and hit the dirt with Offroad Legends VR: Car Racing Game \u2014 a thrilling offroad simulation built for Meta Quest!\n\nTake control of rugged 4x4 vehicles and race through challenging environments like rocky mountains, muddy trails, steep hills, and more. With full VR immersion, realistic vehicle physics, and dynamic terrain, this is the ultimate test of your driving skill and focus.\n\nChoose from a variety of jeeps and offroad trucks, customize your ride, and explore open-world maps or push your limits in time-based racing challenges. Whether you're a casual driver or a hardcore offroad enthusiast, this game delivers adrenaline-pumping fun with every turn.\n\nKey Features:\nRealistic offroad driving physics in full VR\nMultiple vehicles with customizable options\nFree roam and mission-based gameplay\nDynamic environments: mud, hills, rocks, and rivers\nWeather effects and day-night cycles\nIntuitive VR controls for immersive driving", "short_description": "Experience the thrill of real offroad racing in full VR! Offroad Legends VR: Car Racing Game puts you behind the wheel of powerful 4x4 vehicles as you conquer rough terrain, steep hills, mud, and more. Choose from multiple jeeps and trucks, explore open environments, and take on exciting challenges. With realistic physics, dynamic weather, and immersive controls, this is the ultimate offroad adventure  car driving game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/noob-gamers/privacy-policy/meta-quest-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Examob", "support_website_url": null, "website_url": "https://sites.google.com/view/noob-gamers/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": [], "id": "24453726574282113"}}]}, "scheduled_offers": {"count": 12, "nodes": [{"status": "PUBLISHED", "id": "1811641827131004"}, {"status": "PUBLISHED", "id": "1060035516518285"}, {"status": "PUBLISHED", "id": "1331032631853052"}, {"status": "PUBLISHED", "id": "939076545503577"}, {"status": "PUBLISHED", "id": "950657413966278"}, {"status": "PUBLISHED", "id": "2351278171963447"}, {"status": "PUBLISHED", "id": "1576272093424403"}, {"status": "PUBLISHED", "id": "1985917085582804"}, {"status": "PUBLISHED", "id": "1396364188882500"}, {"status": "PUBLISHED", "id": "1131408125578588"}, {"status": "CANCELLED", "id": "1870688630463101"}, {"status": "PUBLISHED", "id": "1148287210342447"}]}, "baseline_offer": {"id": "1985917085582804"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792774800, "status": "PUBLISHED", "id": "1811641827131004"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24104605445860896", "version": "1.5"}, 
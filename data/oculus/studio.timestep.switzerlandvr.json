g?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6NyJfstvBOQQ7kNvwHxBSUj&_nc_oc=Adrx5XZYbM9iae-6hFkkHbXkBeY8Cq-3YEiNpcKj0VGEZZDPLc65mIzag6-_52cUH4Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZIJcpg28e_mhkcZj5K_X58IFkN6cTJTIO3QVpWk6aUA&oe=6B072619"}, {"file_name": "5_diorama.png", "id": "1733047451129401", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823812_1733047454462734_7686882705544687629_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EwIk7O1rIx4Q7kNvwF6cXhG&_nc_oc=AdreN9xIdhYwy7OPhWVbor7Dt6j1l7lHoeH9s55QKyfyJggkUP2edBaxPZopywr8mvc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSk5DCpTDsqkdQzMMfPx95Ubb3ji8cE9xYqKDzZz_YBzg&oe=6B0722BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SwitzerlandVR_landscape.png", "id": "1077941591959236", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821796_1077941595292569_2597953678146585348_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ko9xELro2ssQ7kNvwH-JJqu&_nc_oc=Adr5NgVG0V5Uy_oJEx50eNdHMRPPoi45tagpEIRmzab5RYCuX82g7x3FAKx49pW-H6w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2ElCWoYBoyXicWbrL5IwZyhf0hlkUHbRB8NesOMqo3g&oe=6B07121F"}, "display_name": "SwitzerlandVR", "keywords": ["map", "travel", "hiking", "geography", "switzerland"], "long_description": "SwitzerlandVR places a relief model of Switzerland and its surroundings in front of you at table height. Move, zoom and turn it with your hands.\n\n\u2013 Aerial photo or shaded relief\n\u2013 Towns, peaks, lakes and cantons with key figures\n\u2013 Hiking trails and SchweizMobil routes when zoomed in\n- Swiss trains moving on their real timetable\n\u2013 German and English\n\nTerrain, aerial imagery, place names, borders and hiking trails come from official swisstopo data (\u00a9 swisstopo). Hiking routes come from SchweizMobil (Federal Roads Office, cantons, SchweizMobil).  Train timetables come from opentransportdata.swiss, and the rail network from the Federal Office of Transport (FOT).\n\nRequires hand tracking.", "short_description": "Switzerland as a 3D relief model in front of you. Explore the terrain, towns, peaks, lakes, cantons and hiking trails, built from official swisstopo data (\u00a9 swisstopo). Hand tracking only."}]}, "developer_name": null, "developer_privacy_policy_url": "https://timestep.studio/privacy_policy_switzerlandvr.html", "developer_terms_of_service_url": null, "publisher_name": "Timestep Studio", "support_website_url": null, "website_url": "https://timestep.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2076807229656812"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823746_1793965408894988_6657759749575785237_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FKm3I5TWHNkQ7kNvwGkakuB&_nc_oc=AdqcltW2qelWtiglHfe9dyy1SObl084gh31uUd-zICzh_MA1ChETHYgLpZuA49M7RqE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdpWKr-QEs6DPwr97MyyLwd0OK_4kSTfCPe1UauBKG_A&oe=6B071A4B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "SwitzerlandVR", "platform": "ANDROID_6DOF", "context_category
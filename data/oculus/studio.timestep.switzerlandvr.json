g?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RvSMJnQ7hL4Q7kNvwEM8Azs&_nc_oc=Adqv6tYZiNoDApw404rlwrG99HCEeffqzl1h8m9PdZTOY3oUMNcPx1zZr_yWd0st_aA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSq4V4Rjee4kkJ_OgLg8w7xXwSCyUvADCWkmNjy5mSJww&oe=6B033199"}, {"file_name": "5_diorama.png", "id": "1733047451129401", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823812_1733047454462734_7686882705544687629_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jsH9sFQYDwQQ7kNvwEWbKuR&_nc_oc=Adp2-wSUxbZPoP4NhUkBHSwJ6IaG3C8f7lbg6k-pqYEXVFtmIRbwuIFK5kFmwoj_Ogs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKs-UCJqqKbCwwYT0bjrvHQFRZLdGBOYAsLb_e2D_MIQ&oe=6B032E3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SwitzerlandVR_landscape.png", "id": "1077941591959236", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821796_1077941595292569_2597953678146585348_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9XM8iII6-PkQ7kNvwHM_vg7&_nc_oc=Adp03eXYL6E9q08mlOtr2j1PgUg06nSPtVxstRP09nB_AImr6zgEY54nDirXawdArjk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5Pj5eWhKGoRr8FThk0WexqqSyXNCPcuqF_oLvOMEA6Q&oe=6B031D9F"}, "display_name": "SwitzerlandVR", "keywords": ["map", "travel", "hiking", "geography", "switzerland"], "long_description": "SwitzerlandVR places a relief model of Switzerland and its surroundings in front of you at table height. Move, zoom and turn it with your hands.\n\n\u2013 Aerial photo or shaded relief\n\u2013 Towns, peaks, lakes and cantons with key figures\n\u2013 Hiking trails and SchweizMobil routes when zoomed in\n- Swiss trains moving on their real timetable\n\u2013 German and English\n\nTerrain, aerial imagery, place names, borders and hiking trails come from official swisstopo data (\u00a9 swisstopo). Hiking routes come from SchweizMobil (Federal Roads Office, cantons, SchweizMobil).  Train timetables come from opentransportdata.swiss, and the rail network from the Federal Office of Transport (FOT).\n\nRequires hand tracking.", "short_description": "Switzerland as a 3D relief model in front of you. Explore the terrain, towns, peaks, lakes, cantons and hiking trails, built from official swisstopo data (\u00a9 swisstopo). Hand tracking only."}]}, "developer_name": null, "developer_privacy_policy_url": "https://timestep.studio/privacy_policy_switzerlandvr.html", "developer_terms_of_service_url": null, "publisher_name": "Timestep Studio", "support_website_url": null, "website_url": "https://timestep.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2076807229656812"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823746_1793965408894988_6657759749575785237_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4jfev8z1xjsQ7kNvwGWsFe9&_nc_oc=Adr7RCKeOyjU4KTgZskMiqbEm0-DUv7ci-RbH7dqgpt9X99nT60_0CDxqX1mAeS1tHg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRV1mUXtHMrXpraz7aAJXY7W_q9aBdDUiAlsAhAXIjAcA&oe=6B0325CB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "SwitzerlandVR", "platform": "ANDROID_6DOF", "context_category
g?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lfzbBXrycPoQ7kNvwGtwpCN&_nc_oc=Adrr8ynE_3wWrFu-SZYud_7Hp8p4ftbMhqoOKri7g3fyFoOnjLT2wycPijm2wmcEbPQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxrBVH7pcNdW1HBkfUvWKW48tOnYdUAkGnJu05I3bPhg&oe=6B01E019"}, {"file_name": "5_diorama.png", "id": "1733047451129401", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823812_1733047454462734_7686882705544687629_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mmF1Jga2rPkQ7kNvwF0e474&_nc_oc=Adp233bb-DXB9EUaWNqYobtFl8brgnJ95uxov0drbsG8Bm3J6UJtCZ9DegDrfJQm5u4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSqH8b0M2nSofwa56-m4v6Bh00vSbqdQtcAfvfWRLiPeA&oe=6B01DCBB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SwitzerlandVR_landscape.png", "id": "1077941591959236", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821796_1077941595292569_2597953678146585348_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9XM8iII6-PkQ7kNvwFdy1Xi&_nc_oc=Adpn4HfnyR2NqHfkFroKhNQVxoXaL0QysevOp-Xo_LQugOlpCYQsuX8jTMTAyvdDhOk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTthbcETDcMGcpKv1DYmRDJvQPwU8NughTSqc5d-j3lHQ&oe=6B01CC1F"}, "display_name": "SwitzerlandVR", "keywords": ["map", "travel", "hiking", "geography", "switzerland"], "long_description": "SwitzerlandVR places a relief model of Switzerland and its surroundings in front of you at table height. Move, zoom and turn it with your hands.\n\n\u2013 Aerial photo or shaded relief\n\u2013 Towns, peaks, lakes and cantons with key figures\n\u2013 Hiking trails and SchweizMobil routes when zoomed in\n- Swiss trains moving on their real timetable\n\u2013 German and English\n\nTerrain, aerial imagery, place names, borders and hiking trails come from official swisstopo data (\u00a9 swisstopo). Hiking routes come from SchweizMobil (Federal Roads Office, cantons, SchweizMobil).  Train timetables come from opentransportdata.swiss, and the rail network from the Federal Office of Transport (FOT).\n\nRequires hand tracking.", "short_description": "Switzerland as a 3D relief model in front of you. Explore the terrain, towns, peaks, lakes, cantons and hiking trails, built from official swisstopo data (\u00a9 swisstopo). Hand tracking only."}]}, "developer_name": null, "developer_privacy_policy_url": "https://timestep.studio/privacy_policy_switzerlandvr.html", "developer_terms_of_service_url": null, "publisher_name": "Timestep Studio", "support_website_url": null, "website_url": "https://timestep.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2076807229656812"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823746_1793965408894988_6657759749575785237_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4UwIv3O1Y6oQ7kNvwH-fK_K&_nc_oc=AdpvcNgJk57ILqkiTx-WJp89N8l-zoxaFj53UsT_AWHodKjtPspa1KBG_7OVShMLAJQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5xxnSOI_joCtHEULKimtcdJoxZPXhD7t5ayZOr0-NzA&oe=6B01D44B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "SwitzerlandVR", "platform": "ANDROID_6DOF", "context_category
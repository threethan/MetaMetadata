g?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6NyJfstvBOQQ7kNvwH7H22d&_nc_oc=Adpuriipyl68ww-VdennXlHnqVV4eCuJqpwBRcAVOXNFygNd5TRacoI2JUaUyzCV8bI&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUfUekjwTaLSEzcLyXh7mbno4Z8Cy0HQBu7mU6cj61kg&oe=6B09C919"}, {"file_name": "5_diorama.png", "id": "1733047451129401", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491823812_1733047454462734_7686882705544687629_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EwIk7O1rIx4Q7kNvwFqpzfc&_nc_oc=AdoVjCDteo-AnlhRZxpAduPuYBoa6sJeGhJXbooRuIdhAxHq1dy4HGGnUta9Tl2GKSE&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbHBifMECOLvX3oMBO0aHF3LlEUmRn-YedD_eVmNLmEw&oe=6B09C5BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SwitzerlandVR_landscape.png", "id": "1077941591959236", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821796_1077941595292569_2597953678146585348_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c7FGoq8qnrAQ7kNvwHYu3s6&_nc_oc=AdozRaJqOWY1NTNnLdYA0RG78uk-EGQjPu24rBD1MgYASuhVl3UEejM_xvOM7OZ_dQE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6K6G9LSNJ7jruS2yXqYjUb3U1VZvVsy5BI8CpNdwdRQ&oe=6B09B51F"}, "display_name": "SwitzerlandVR", "keywords": ["map", "travel", "hiking", "geography", "switzerland"], "long_description": "SwitzerlandVR places a relief model of Switzerland and its surroundings in front of you at table height. Move, zoom and turn it with your hands.\n\n\u2013 Aerial photo or shaded relief\n\u2013 Towns, peaks, lakes and cantons with key figures\n\u2013 Hiking trails and SchweizMobil routes when zoomed in\n- Swiss trains moving on their real timetable\n\u2013 German and English\n\nTerrain, aerial imagery, place names, borders and hiking trails come from official swisstopo data (\u00a9 swisstopo). Hiking routes come from SchweizMobil (Federal Roads Office, cantons, SchweizMobil).  Train timetables come from opentransportdata.swiss, and the rail network from the Federal Office of Transport (FOT).\n\nRequires hand tracking.", "short_description": "Switzerland as a 3D relief model in front of you. Explore the terrain, towns, peaks, lakes, cantons and hiking trails, built from official swisstopo data (\u00a9 swisstopo). Hand tracking only."}]}, "developer_name": null, "developer_privacy_policy_url": "https://timestep.studio/privacy_policy_switzerlandvr.html", "developer_terms_of_service_url": null, "publisher_name": "Timestep Studio", "support_website_url": null, "website_url": "https://timestep.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2076807229656812"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823746_1793965408894988_6657759749575785237_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FKm3I5TWHNkQ7kNvwHZBCct&_nc_oc=AdplyoMa33Dq9i1Zgls6eCGuRttRH4cn57SWKcbwKnvxsmklLEuIqOBoPH9uKwEBo7Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGi6heHMCTQvV6bDdDtEKOpvwelhZbAgdvFrhp-iJvYg&oe=6B09BD4B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "SwitzerlandVR", "platform": "ANDROID_6DOF", "context_category
: null, "video_trailer_thumbnail": {"file_name": "Strawberry Sprint XR.png", "id": "4723185498004869", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491827960_4723185501338202_5052620277054848932_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c3lwNW9y6qIQ7kNvwHZOm5q&_nc_oc=AdrOv1ZOueuwi7HLAQnu9ex1K4Hy1inU9b7Gj0SpXkzsrG4bdz6QyDbHDkPC00TLi6k&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS2peP0FD9psKQZ-F2hhoz7bPDvEl2lYKnzvuA2BSkTxg&oe=6B0B261A"}, "display_name": "Strawberry Sprint XR", "keywords": ["strawberries", "MixedReality", "Games", "simulation", "Archade"], "long_description": "Strawberry Sprint is the first immersive mixed-reality greenhouse agricultural simulation in the world, developed by Digi Fuzz Verse in the Food Valley (Wageningen, Netherlands). Designed for intuitive spatial play, it lets you cultivate real strawberry varieties right inside your physical space using natural hand and controller interactions. Plant your seeds, fine-tune temperature, humidity, soil moisture, and light intensity, and watch your strawberry canopies and fruit respond in real time through dynamic digital twins.\n\nEach round teaches the core environmental principles behind precision horticulture, turning complex biological and climate dynamics into hands\u2011on spatial learning. Strawberry Sprint offers a vibrant, tactile, science\u2011driven experience that blends agricultural education with playful discovery, perfect for anyone curious about sustainable farming, climate control, or cutting\u2011edge mixed\u2011reality design.", "short_description": "Strawberry Sprint is the world\u2019s first mixed-reality strawberry greenhouse simulation, developed by Digi Fuzz Verse in Wageningen's Food Valley. Plant seeds in your physical space, fine-tune climate sliders like temperature and soil moisture, and watch your strawberry canopies and fruit respond in real time. Blending hands-on XR interaction with real agricultural science, it offers an immersive, tactile way to master precision farming and climate control."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/DigiFuzzVerse/Strawberry-Sprint-XR-/blob/main/PRIVACY_POLICY.md", "developer_terms_of_service_url": "https://github.com/DigiFuzzVerse/Strawberry-Sprint-XR-/blob/main/TERMS_OF_SERVICE.md", "publisher_name": "DigiFuzzVerse", "support_website_url": "https://github.com/DigiFuzzVerse/Strawberry-Sprint-XR-", "website_url": "https://www.digifuzzverse.nl/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1450676928120498"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491824700_992756633892461_5560408552878472515_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kSziRJENnsUQ7kNvwEO38KY&_nc_oc=Adoi73JltnVpKXZQCPfsYV6qj4bxeynd_pRI9fD5amNdbLs6rW3I7du4q8hLEX1oW-4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSu4qp5I2XQeW4HkGERq8Bc-fMadAA6w7d3idMpEamjHg&oe=6B0B31DB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Strawberry Sprint XR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}], "relea
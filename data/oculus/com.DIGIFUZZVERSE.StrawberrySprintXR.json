18920_954789125126080179_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zzQ7ENxQa9IQ7kNvwHl49wg&_nc_oc=AdoHGlM5WGFcVy3jh9vHUZpqR8vMo8yWG4HR9Hc1YDHauFSwpGUbFDt0KlsyiVGKsao&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPIQmGSKEZyok1X7RPZiID-ESEyFDBp4TN8I5OSNCXog&oe=6B008633"}, {"file_name": "com.DefaultCompany.MixedRealityTemplate-20261027-132846.png", "id": "1603803690804519", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821704_1603803697471185_2442078090819377030_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SBc0bkBlNXgQ7kNvwEF8Iwp&_nc_oc=Adqj2oRXkn65JAS52s7huqqI3YrMvvTfMnQ9MuTuYyUGm4YNlpkRWnZaAsk6vVhu1CA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpNr589uzUSahrJks4LkEzTfLR_37c9q7_qj3H-vVl6g&oe=6B006FFC"}, {"file_name": "com.DefaultCompany.MixedRealityTemplate-20261027-132727.png", "id": "4460311837555738", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823940_4460311840889071_6882716751986618818_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z7hPwWrLdosQ7kNvwHPFu-W&_nc_oc=AdqJMwiAM6hEV7RAys2ILIYG-K2Hab9dunMDQCD52nOIf2nO66QO3rrQ_LuULVsB3cs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSko_6t9SWd1JP5sEFogL4fo746NPO3koHpR0RPF9cxbw&oe=6B0054B9"}, {"file_name": "com.DefaultCompany.MixedRealityTemplate-20261027-133330.png", "id": "1972925656721185", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823837_1972925660054518_6406851986969992738_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ladnmj3TQvMQ7kNvwEQIFR4&_nc_oc=Adqm5V43ic-m6n103J2cGltr-9Z8qs3GAoX9LZzQZHKg-IxqAFEK_qp8BP3DCsiake0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3VTW4g4VpKEp9g7aDOGfx6ySoIchmp95xfHfkM-uZew&oe=6B006B18"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Strawberry Sprint XR.png", "id": "4723185498004869", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827960_4723185501338202_5052620277054848932_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qowIx9-yAHkQ7kNvwGCc3ar&_nc_oc=AdrzwhwzlQgXJy9p8_mZwRmnmj8_-E5RmsXWxQ4nzlVKDTd9j0JidAhgNnFNcblT86E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7-lVvMAJTpXKdC_Ky-DnHdXx117bAVv79VcwWT3TzRg&oe=6B0061DA"}, "display_name": "Strawberry Sprint XR", "keywords": ["strawberries", "MixedReality", "Games", "simulation", "Archade"], "long_description": "Strawberry Sprint is the first immersive mixed-reality greenhouse agricultural simulation in the world, developed by Digi Fuzz Verse in the Food Valley (Wageningen, Netherlands). Designed for intuitive spatial play, it lets you cultivate real strawberry varieties right inside your physical space using natural hand and controller interactions. Plant your seeds, fine-tune temperature, humidity, soil moisture, and light intensity, and watch your strawberry canopies and fruit respond in real time through dynamic digital twins.\n\nEach round teaches the core environmental principles behind precision horticulture, turning complex biological and climate dynamics into hands\u2011on spatial learning. Strawberry Sprint offers a vibrant, tactile, science\u2011driven experience that blends agricultural education with playful discovery, perfect for anyone curious about sustainable farming, climate control, or cutting\u2011edge mixed\u2011reality design.", "short_description": "Strawberry Sprint is the world\u2019s first mixed-reality strawberry greenhouse simulation, developed by Digi Fuzz Verse in Wageningen's Food Valley. Plant seeds in your physical space, fine-tune climate sliders like temperature and soil moisture, and watch your strawberry canopies and fruit respond in real time. Blending hands-on XR interaction with real agricultural science, it offers an immersive, tactile way to master precision farming and climate control."}]}, "developer_name": null, 
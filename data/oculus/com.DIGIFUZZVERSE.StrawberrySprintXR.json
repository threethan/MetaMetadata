18920_954789125126080179_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TtwyINXNWAIQ7kNvwFN2q-a&_nc_oc=Adren_GMyJb5G6BvajkUEXYKFXJ0FSN0YQpdY_4Q9jx7s8uRun4dTkY0Xu_n1OhmEDk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMHTAr7aOJUerRfMeDPn0uZ-4-e_gmMMpyPQsroGp3Hw&oe=6AFC91B3"}, {"file_name": "com.DefaultCompany.MixedRealityTemplate-20261027-132846.png", "id": "1603803690804519", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491821704_1603803697471185_2442078090819377030_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s2zKIPxlnpUQ7kNvwGkRB13&_nc_oc=Adq5B2eDRKeFZnMqmdCM4OvmNjtXJXgK-tU3Z9IMuSSeNP7GwId2xVxjyTvHCbmDIKo&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQrXP-uDWaiK-2fKXo_qWpT8aH4YqaF1I049eMpZT2trg&oe=6AFC7B7C"}, {"file_name": "com.DefaultCompany.MixedRealityTemplate-20261027-132727.png", "id": "4460311837555738", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823940_4460311840889071_6882716751986618818_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hU6yTc-Fj9MQ7kNvwFxzZxA&_nc_oc=AdphJomGzJy19NzxrgNYWYbcsLoTkSW6FyiigqtAL-sduhsUinzL4MUBjoG7Q-mAih8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPkPnzDCJAigLdN1n-2VMpq8qnFFch_175r2yCa0-PPQ&oe=6AFC6039"}, {"file_name": "com.DefaultCompany.MixedRealityTemplate-20261027-133330.png", "id": "1972925656721185", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823837_1972925660054518_6406851986969992738_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DuZKGDQ_sAEQ7kNvwFGPcdj&_nc_oc=Adq1a6GGzDF9Zzeq_fFjN2WBJNSAyCWKx7ZZtxy6_SwBZyz9xyKg2JGP2ng1tCgVEuA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTf473z1TswOSQotn4qaUon9qmbtYLg1RZ0nEvh0D60Aw&oe=6AFC7698"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Strawberry Sprint XR.png", "id": "4723185498004869", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827960_4723185501338202_5052620277054848932_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lJId4f2yHlEQ7kNvwHQ_LAM&_nc_oc=Adodvq7tmKsMAo5i9BiI2Tg6Vg32vgHricjqHjp9u3i51VySR56jHGEp9GG4OyhzVLc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOhlVsnckUswuBgNAXiP28f3w9yIGLvZR34BDP1zd3tw&oe=6AFC6D5A"}, "display_name": "Strawberry Sprint XR", "keywords": ["strawberries", "MixedReality", "Games", "simulation", "Archade"], "long_description": "Strawberry Sprint is the first immersive mixed-reality greenhouse agricultural simulation in the world, developed by Digi Fuzz Verse in the Food Valley (Wageningen, Netherlands). Designed for intuitive spatial play, it lets you cultivate real strawberry varieties right inside your physical space using natural hand and controller interactions. Plant your seeds, fine-tune temperature, humidity, soil moisture, and light intensity, and watch your strawberry canopies and fruit respond in real time through dynamic digital twins.\n\nEach round teaches the core environmental principles behind precision horticulture, turning complex biological and climate dynamics into hands\u2011on spatial learning. Strawberry Sprint offers a vibrant, tactile, science\u2011driven experience that blends agricultural education with playful discovery, perfect for anyone curious about sustainable farming, climate control, or cutting\u2011edge mixed\u2011reality design.", "short_description": "Strawberry Sprint is the world\u2019s first mixed-reality strawberry greenhouse simulation, developed by Digi Fuzz Verse in Wageningen's Food Valley. Plant seeds in your physical space, fine-tune climate sliders like temperature and soil moisture, and watch your strawberry canopies and fruit respond in real time. Blending hands-on XR interaction with real agricultural science, it offers an immersive, tactile way to master precision farming and climate control."}]}, "developer_name": null, 
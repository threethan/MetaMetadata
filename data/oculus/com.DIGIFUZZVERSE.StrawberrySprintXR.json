e=6AEDD8F3"}, {"file_name": "com.DefaultCompany.MixedRealityTemplate-20261027-132846.png", "id": "1603803690804519", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821704_1603803697471185_2442078090819377030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K2T8PUBUBPUQ7kNvwE30ujv&_nc_oc=Adp1jfYw85J7dRBotWwQO7XPToeSJRhsyryDc6CbU_bBwVVJUfeC8HTTM8TAaEH1x_g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRkl8wxWiL27kBz-9Fn64Uv50Dco_HAs_qCTb6FkkIAA&oe=6AEDFAFC"}, {"file_name": "com.DefaultCompany.MixedRealityTemplate-20261027-132727.png", "id": "4460311837555738", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823940_4460311840889071_6882716751986618818_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JqRid_1gx4wQ7kNvwG2tLdK&_nc_oc=Adq4bpnY6REAaGAikOXKKcqBU6IBOQKA6-hqXBBTgDXR07NhStvUDom-V0UBin4xuts&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSh_fx2N3waNhBYFyJ4iWfm6xePD8j7gRNi3eCjV-Qeaw&oe=6AEDDFB9"}, {"file_name": "com.DefaultCompany.MixedRealityTemplate-20261027-133330.png", "id": "1972925656721185", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823837_1972925660054518_6406851986969992738_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_w1qV4cgvHgQ7kNvwHHS2EX&_nc_oc=AdpIjz4w0c7nuGTp-Al3DdhCZsdlo6woALQw3JBVfwP1XxoAP4wBh9Hh4K4aB8mR97c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSv-kHN4QCPqBVM0lvZkH3EpEQjGrVM8SIV7YjqBv0gGg&oe=6AEDF618"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Strawberry Sprint XR.png", "id": "4723185498004869", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827960_4723185501338202_5052620277054848932_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R_24Ewb35loQ7kNvwG6k2HD&_nc_oc=AdrTWzEJtG1d8ynfHOgSzjHpNCyV7niecD-x-SjbZ0OW81A4tBLcE3Ey3QUDGYP_omM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9ns0bKCx7UHc5pHMiMbfH4kAaf3TBB1VU6QlHxh9fAQ&oe=6AEDECDA"}, "display_name": "Strawberry Sprint XR", "keywords": ["strawberries", "MixedReality", "Games", "simulation", "Archade"], "long_description": "Strawberry Sprint is the first immersive mixed-reality greenhouse agricultural simulation in the world, developed by Digi Fuzz Verse in the Food Valley (Wageningen, Netherlands). Designed for intuitive spatial play, it lets you cultivate real strawberry varieties right inside your physical space using natural hand and controller interactions. Plant your seeds, fine-tune temperature, humidity, soil moisture, and light intensity, and watch your strawberry canopies and fruit respond in real time through dynamic digital twins.\n\nEach round teaches the core environmental principles behind precision horticulture, turning complex biological and climate dynamics into hands\u2011on spatial learning. Strawberry Sprint offers a vibrant, tactile, science\u2011driven experience that blends agricultural education with playful discovery, perfect for anyone curious about sustainable farming, climate control, or cutting\u2011edge mixed\u2011reality design.", "short_description": "Strawberry Sprint is the world\u2019s first mixed-reality strawberry greenhouse simulation, developed by Digi Fuzz Verse in Wageningen's Food Valley. Plant seeds in your physical space, fine-tune climate sliders like temperature and soil moisture, and watch your strawberry canopies and fruit respond in real time. Blending hands-on XR interaction with real agricultural science, it offers an immersive, tactile way to master precision farming and climate control."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/DigiFuzzVerse/Strawberry-Sprint-XR-/blob/main/PRIVACY_POLICY.md", "developer_terms_of_service_url": "https://github.com/DigiFuzzVerse/Strawberry-Sprint-XR-/blob/main/TERMS_OF_SERVICE.md", "publisher_name": "DigiFuzzVerse", "support_website_url": "https://github.com/DigiFuzzVerse/Strawberry-Sprint-XR-", "website_url": "https://www.digifuzzverse.nl/", "category": 
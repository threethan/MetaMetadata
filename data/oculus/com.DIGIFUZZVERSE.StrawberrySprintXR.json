18920_954789125126080179_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sfx5iGoPhPQQ7kNvwGqdRuL&_nc_oc=AdpN_TUeKREb71eNU_4e96ZqIkN8mqy-idZQs-uqDKnyQGpopkds43ycUsgMV962_1U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQf3BE7kkVD-BRQcvSJs-E48ZpWwMvDSRkYslfsW_yFpg&oe=6B05CC33"}, {"file_name": "com.DefaultCompany.MixedRealityTemplate-20261027-132846.png", "id": "1603803690804519", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821704_1603803697471185_2442078090819377030_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZNGK1F4aMT4Q7kNvwHUz9tA&_nc_oc=AdrAkVzNhXilytf5W-DxxNsBSh7qlEJ4a6pBljFNkOc52jfgF1ZT_tqtRuaOQMqh2mI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFUihyezAkSnX26gSBU-PKX1iBx19u9Yr_kHjstQqVKw&oe=6B05B5FC"}, {"file_name": "com.DefaultCompany.MixedRealityTemplate-20261027-132727.png", "id": "4460311837555738", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823940_4460311840889071_6882716751986618818_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M-s7KAJsxLwQ7kNvwGCx3Re&_nc_oc=AdpsqMWEpK-Ju17lGTZ8kpLMgBw9KrMCVhqeAFoe2HTXsY49hJQloGh5QFvZHDTjs4I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtHUwqU4DZcAytPKndIOC7b_dSVQ5uASXvbDTGLp5UZQ&oe=6B05D2F9"}, {"file_name": "com.DefaultCompany.MixedRealityTemplate-20261027-133330.png", "id": "1972925656721185", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823837_1972925660054518_6406851986969992738_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=akZNqM_6u84Q7kNvwF9QWic&_nc_oc=Adpa2hQMcn2IUMa0AEA70QK287qKmbXY-nIDDG79qHPsUA-H-kPekJBQUVzC8DtG-2o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQm9G_qjtv1bn_Rx9AB02fCggJL4iIYbsHtBFm02O4kXw&oe=6B05B118"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Strawberry Sprint XR.png", "id": "4723185498004869", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827960_4723185501338202_5052620277054848932_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=egotzrNZ5nwQ7kNvwEZgnKB&_nc_oc=AdonS3aUP5elA3pgn0aWiInOWrc0Q9I7HSVXLafngwwXJfEhOQhL_6h6gwSHXF7jqS4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhQP0559ANwBQpqMfq9is_kiuWEY3GsfIX6_nczAX7NQ&oe=6B05A7DA"}, "display_name": "Strawberry Sprint XR", "keywords": ["strawberries", "MixedReality", "Games", "simulation", "Archade"], "long_description": "Strawberry Sprint is the first immersive mixed-reality greenhouse agricultural simulation in the world, developed by Digi Fuzz Verse in the Food Valley (Wageningen, Netherlands). Designed for intuitive spatial play, it lets you cultivate real strawberry varieties right inside your physical space using natural hand and controller interactions. Plant your seeds, fine-tune temperature, humidity, soil moisture, and light intensity, and watch your strawberry canopies and fruit respond in real time through dynamic digital twins.\n\nEach round teaches the core environmental principles behind precision horticulture, turning complex biological and climate dynamics into hands\u2011on spatial learning. Strawberry Sprint offers a vibrant, tactile, science\u2011driven experience that blends agricultural education with playful discovery, perfect for anyone curious about sustainable farming, climate control, or cutting\u2011edge mixed\u2011reality design.", "short_description": "Strawberry Sprint is the world\u2019s first mixed-reality strawberry greenhouse simulation, developed by Digi Fuzz Verse in Wageningen's Food Valley. Plant seeds in your physical space, fine-tune climate sliders like temperature and soil moisture, and watch your strawberry canopies and fruit respond in real time. Blending hands-on XR interaction with real agricultural science, it offers an immersive, tactile way to master precision farming and climate control."}]}, "developer_name": null, 
18920_954789125126080179_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TtwyINXNWAIQ7kNvwF174tc&_nc_oc=AdoJLzfRilP_e87KGknaIGiChRhWkVVFYfXJj9kxK4Qk0oxjLGGtVORaW_ZwCPPi-t4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbScioVd53ZpAxRA24fnK95mcE_qzCzjqH3Ki1BtlUoQ&oe=6AFDE333"}, {"file_name": "com.DefaultCompany.MixedRealityTemplate-20261027-132846.png", "id": "1603803690804519", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821704_1603803697471185_2442078090819377030_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s2zKIPxlnpUQ7kNvwHvzBBM&_nc_oc=AdrVQl4zuzLODEQMlIoZy6CA-Nd6fM99bIQCL1nP3pf8rkg2UaaPwVb0AJHwTN7YwYY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTM7a-AE8wcgeknatPzegpc5U1TLpDxEznq0U7tJaN_ng&oe=6AFDCCFC"}, {"file_name": "com.DefaultCompany.MixedRealityTemplate-20261027-132727.png", "id": "4460311837555738", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823940_4460311840889071_6882716751986618818_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z7hPwWrLdosQ7kNvwH1J_Zq&_nc_oc=Ado144wUZ0K5V05SlrMHKpJnpd83WLP-V6ivHK-32MP4Tu63m5o5Amsfwe6FBZVe4iU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCzFy5o_4yDK_UawkVyM4QulKt6it_75_oD1IQWUWI3A&oe=6AFDB1B9"}, {"file_name": "com.DefaultCompany.MixedRealityTemplate-20261027-133330.png", "id": "1972925656721185", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823837_1972925660054518_6406851986969992738_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DuZKGDQ_sAEQ7kNvwGvUjDO&_nc_oc=AdqxQGAMXEKXWj_FxEPtdxTU-Q9wD6ijxpQk77IZVeuixdapoc9rJeum7yzIojLrWqs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXF6AthoWEROEl6Fa07A0Un6BHfKBrESVa_SUB9gKEPA&oe=6AFDC818"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Strawberry Sprint XR.png", "id": "4723185498004869", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827960_4723185501338202_5052620277054848932_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lJId4f2yHlEQ7kNvwEX2Lja&_nc_oc=Adq-I1Pm6bl_D36QiMBpjmTVGBJUePOJotk0MUa9003aPR6Y54oqvPF4ZnBXyLpQvA8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxNGrfiDRckpuckJx8CIO2EKlr0LXF6FXcI2dT1m5b_w&oe=6AFDBEDA"}, "display_name": "Strawberry Sprint XR", "keywords": ["strawberries", "MixedReality", "Games", "simulation", "Archade"], "long_description": "Strawberry Sprint is the first immersive mixed-reality greenhouse agricultural simulation in the world, developed by Digi Fuzz Verse in the Food Valley (Wageningen, Netherlands). Designed for intuitive spatial play, it lets you cultivate real strawberry varieties right inside your physical space using natural hand and controller interactions. Plant your seeds, fine-tune temperature, humidity, soil moisture, and light intensity, and watch your strawberry canopies and fruit respond in real time through dynamic digital twins.\n\nEach round teaches the core environmental principles behind precision horticulture, turning complex biological and climate dynamics into hands\u2011on spatial learning. Strawberry Sprint offers a vibrant, tactile, science\u2011driven experience that blends agricultural education with playful discovery, perfect for anyone curious about sustainable farming, climate control, or cutting\u2011edge mixed\u2011reality design.", "short_description": "Strawberry Sprint is the world\u2019s first mixed-reality strawberry greenhouse simulation, developed by Digi Fuzz Verse in Wageningen's Food Valley. Plant seeds in your physical space, fine-tune climate sliders like temperature and soil moisture, and watch your strawberry canopies and fruit respond in real time. Blending hands-on XR interaction with real agricultural science, it offers an immersive, tactile way to master precision farming and climate control."}]}, "developer_name": null, 
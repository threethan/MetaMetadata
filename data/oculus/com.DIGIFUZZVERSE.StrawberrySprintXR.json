1-25/491821704_1603803697471185_2442078090819377030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=22FTio8XS48Q7kNvwF38kx_&_nc_oc=AdogJ6_8UlBYsinJwEvCVtr2eAvt2rOAk0MjKeEIPa8zXxJcwa1SmWxhngbt0NKDJGs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBbU-IlnS3zqfnlJJgUknB8lrXpbu5KFuIB4G_GbVbvA&oe=6AF5E3FC"}, {"file_name": "com.DefaultCompany.MixedRealityTemplate-20261027-132727.png", "id": "4460311837555738", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823940_4460311840889071_6882716751986618818_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aezGlcb6tzAQ7kNvwEorPUT&_nc_oc=Adqa437lqaKGNM0SuopIdjfjQdrySZ69k-rBghpVX7rzUeskYq8qOy7bO4gAt11mN1E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStHm4IJCb_VPIXOnoWrNirNf2vtP6-lXe76tn5HNlevA&oe=6AF5C8B9"}, {"file_name": "com.DefaultCompany.MixedRealityTemplate-20261027-133330.png", "id": "1972925656721185", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823837_1972925660054518_6406851986969992738_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ad38LxYOQesQ7kNvwG-QLrl&_nc_oc=AdooWAY5gmHDLCYMbiCt_TxKjCtH5I3r_OS6lxtkq4mUNakTwbb7_gI6QRNPfoVqQQc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQolY7lF1ZNENc2o2PVJGq39H7-uLQ01CNM9QtVAgytBQ&oe=6AF5DF18"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Strawberry Sprint XR.png", "id": "4723185498004869", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827960_4723185501338202_5052620277054848932_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gQ-F-omuHk0Q7kNvwEKsW4F&_nc_oc=Adq0OZN5x1Q1sBwlOWmvhiVtZ0wIID8oje79UghtPhB_c7kFapxY-oLxtnNDZQrarYs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFcD5mFuoTGX1UeDCWiJK0Gx-raunoVIn--9ddQLfcvQ&oe=6AF5D5DA"}, "display_name": "Strawberry Sprint XR", "keywords": ["strawberries", "MixedReality", "Games", "simulation", "Archade"], "long_description": "Strawberry Sprint is the first immersive mixed-reality greenhouse agricultural simulation in the world, developed by Digi Fuzz Verse in the Food Valley (Wageningen, Netherlands). Designed for intuitive spatial play, it lets you cultivate real strawberry varieties right inside your physical space using natural hand and controller interactions. Plant your seeds, fine-tune temperature, humidity, soil moisture, and light intensity, and watch your strawberry canopies and fruit respond in real time through dynamic digital twins.\n\nEach round teaches the core environmental principles behind precision horticulture, turning complex biological and climate dynamics into hands\u2011on spatial learning. Strawberry Sprint offers a vibrant, tactile, science\u2011driven experience that blends agricultural education with playful discovery, perfect for anyone curious about sustainable farming, climate control, or cutting\u2011edge mixed\u2011reality design.", "short_description": "Strawberry Sprint is the world\u2019s first mixed-reality strawberry greenhouse simulation, developed by Digi Fuzz Verse in Wageningen's Food Valley. Plant seeds in your physical space, fine-tune climate sliders like temperature and soil moisture, and watch your strawberry canopies and fruit respond in real time. Blending hands-on XR interaction with real agricultural science, it offers an immersive, tactile way to master precision farming and climate control."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/DigiFuzzVerse/Strawberry-Sprint-XR-/blob/main/PRIVACY_POLICY.md", "developer_terms_of_service_url": "https://github.com/DigiFuzzVerse/Strawberry-Sprint-XR-/blob/main/TERMS_OF_SERVICE.md", "publisher_name": "DigiFuzzVerse", "support_website_url": "https://github.com/DigiFuzzVerse/Strawberry-Sprint-XR-", "website_url": "https://www.digifuzzverse.nl/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "104
18920_954789125126080179_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sfx5iGoPhPQQ7kNvwEhDeq0&_nc_oc=Ado8c6jXKdl1s0fa48EgFJAZu6e5QG78i40_HbjtBHUHdMFkNjyojL43Wi_rxzIwJpY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThR-Mac4rQXTMwwSRiojS6i9kt9P246BgR93PE6sxUOg&oe=6B032933"}, {"file_name": "com.DefaultCompany.MixedRealityTemplate-20261027-132846.png", "id": "1603803690804519", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821704_1603803697471185_2442078090819377030_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SBc0bkBlNXgQ7kNvwGuG5JG&_nc_oc=AdpcTUgRnr3rxlSIvCBr-1QBGLFLTt8BT2q0xhrGXNVwCpFkIYYZ8OYOzKDLNED6CAY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlis8lL5FjjfhY-iJrKWDVmjp2LASqhKVo3_kIPcxgrA&oe=6B0312FC"}, {"file_name": "com.DefaultCompany.MixedRealityTemplate-20261027-132727.png", "id": "4460311837555738", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823940_4460311840889071_6882716751986618818_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-hHye1akq04Q7kNvwFclgy-&_nc_oc=AdqLrqHIn3Cew1EkaJjGKXFkfIsdoQG3LFs6yNyKUMzJEkG6KMuxvZs4TPA6i7rgJ60&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYhyJ_EJeg3KfqlJnWDnNOsA8PBGbV8FF6iL-fdlzgMQ&oe=6B032FF9"}, {"file_name": "com.DefaultCompany.MixedRealityTemplate-20261027-133330.png", "id": "1972925656721185", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823837_1972925660054518_6406851986969992738_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ladnmj3TQvMQ7kNvwGHRVIP&_nc_oc=AdoBJtetpBmFj96CA4yl0rZRbH-A8S6sm_ePn99Fl5q1WDVDCgZwqYSuDsXMhMatJsM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUY-AkelehA0kETrayr1IMZjwlJPRlS0TQT_SjXbOb3Q&oe=6B030E18"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Strawberry Sprint XR.png", "id": "4723185498004869", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827960_4723185501338202_5052620277054848932_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=egotzrNZ5nwQ7kNvwGupfW1&_nc_oc=AdpFKNE7LqmnQ5SU_A80VA3fn4LvvN1febhhnARAv-tus4uT5axmRPKeP0T67yVIfd0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwkH_YCZCHh1G_tnRZ3zVUCz9fRoMQ0qdICv-dh9iR5Q&oe=6B0304DA"}, "display_name": "Strawberry Sprint XR", "keywords": ["strawberries", "MixedReality", "Games", "simulation", "Archade"], "long_description": "Strawberry Sprint is the first immersive mixed-reality greenhouse agricultural simulation in the world, developed by Digi Fuzz Verse in the Food Valley (Wageningen, Netherlands). Designed for intuitive spatial play, it lets you cultivate real strawberry varieties right inside your physical space using natural hand and controller interactions. Plant your seeds, fine-tune temperature, humidity, soil moisture, and light intensity, and watch your strawberry canopies and fruit respond in real time through dynamic digital twins.\n\nEach round teaches the core environmental principles behind precision horticulture, turning complex biological and climate dynamics into hands\u2011on spatial learning. Strawberry Sprint offers a vibrant, tactile, science\u2011driven experience that blends agricultural education with playful discovery, perfect for anyone curious about sustainable farming, climate control, or cutting\u2011edge mixed\u2011reality design.", "short_description": "Strawberry Sprint is the world\u2019s first mixed-reality strawberry greenhouse simulation, developed by Digi Fuzz Verse in Wageningen's Food Valley. Plant seeds in your physical space, fine-tune climate sliders like temperature and soil moisture, and watch your strawberry canopies and fruit respond in real time. Blending hands-on XR interaction with real agricultural science, it offers an immersive, tactile way to master precision farming and climate control."}]}, "developer_name": null, 
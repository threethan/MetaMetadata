e=6AF74BB3"}, {"file_name": "com.DefaultCompany.MixedRealityTemplate-20261027-132846.png", "id": "1603803690804519", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821704_1603803697471185_2442078090819377030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=22FTio8XS48Q7kNvwFLvsMV&_nc_oc=Adq_5wH7KtlysX5iw1wOx6YdN7nWn4elkw9y_z_k-vcT11XdeNU0rXC9k85eaBGA_Hg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxmKLIeDNvDeRx5JkfniHbI5yoLTjP0XBQ3ex_PefVDg&oe=6AF7357C"}, {"file_name": "com.DefaultCompany.MixedRealityTemplate-20261027-132727.png", "id": "4460311837555738", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823940_4460311840889071_6882716751986618818_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aezGlcb6tzAQ7kNvwGkvWUh&_nc_oc=AdpN10sMqvSXAjqMqu6iXzvpuOzB5GQFPxph-JkTHAEXz4jHvMKE9aRQx89H1pEiqw4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnQGAD7MK_1OfHkZmxIDBbLuANfnOHOC_J82kTQ5sJHw&oe=6AF71A39"}, {"file_name": "com.DefaultCompany.MixedRealityTemplate-20261027-133330.png", "id": "1972925656721185", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823837_1972925660054518_6406851986969992738_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ad38LxYOQesQ7kNvwFC7prI&_nc_oc=Adq1Ta6OyzPmygMwcJYZbla_VBg9jmRpM0ZCu01_sRLVWfllTuOG5tz13zNWn9XtfQA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQiaXYOOBypokthVDbGjN_1-PnNPYUpTP2ae3Sl7hbzg&oe=6AF73098"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Strawberry Sprint XR.png", "id": "4723185498004869", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827960_4723185501338202_5052620277054848932_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oTH76tBRWzsQ7kNvwGODqUX&_nc_oc=Adpeyh8khHdysPHsTj4sHCEoaLOdmWNQGUCt1QSnkRvDK1Md67JLcwVrnX8pQcbftV8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRC1uHyJ3_gCdfGxa--Ys5B1EwVUCcnnkPYybvAWRBT_g&oe=6AF7275A"}, "display_name": "Strawberry Sprint XR", "keywords": ["strawberries", "MixedReality", "Games", "simulation", "Archade"], "long_description": "Strawberry Sprint is the first immersive mixed-reality greenhouse agricultural simulation in the world, developed by Digi Fuzz Verse in the Food Valley (Wageningen, Netherlands). Designed for intuitive spatial play, it lets you cultivate real strawberry varieties right inside your physical space using natural hand and controller interactions. Plant your seeds, fine-tune temperature, humidity, soil moisture, and light intensity, and watch your strawberry canopies and fruit respond in real time through dynamic digital twins.\n\nEach round teaches the core environmental principles behind precision horticulture, turning complex biological and climate dynamics into hands\u2011on spatial learning. Strawberry Sprint offers a vibrant, tactile, science\u2011driven experience that blends agricultural education with playful discovery, perfect for anyone curious about sustainable farming, climate control, or cutting\u2011edge mixed\u2011reality design.", "short_description": "Strawberry Sprint is the world\u2019s first mixed-reality strawberry greenhouse simulation, developed by Digi Fuzz Verse in Wageningen's Food Valley. Plant seeds in your physical space, fine-tune climate sliders like temperature and soil moisture, and watch your strawberry canopies and fruit respond in real time. Blending hands-on XR interaction with real agricultural science, it offers an immersive, tactile way to master precision farming and climate control."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/DigiFuzzVerse/Strawberry-Sprint-XR-/blob/main/PRIVACY_POLICY.md", "developer_terms_of_service_url": "https://github.com/DigiFuzzVerse/Strawberry-Sprint-XR-/blob/main/TERMS_OF_SERVICE.md", "publisher_name": "DigiFuzzVerse", "support_website_url": "https://github.com/DigiFuzzVerse/Strawberry-Sprint-XR-", "website_url": "https://www.digifuzzverse.nl/", "category": 
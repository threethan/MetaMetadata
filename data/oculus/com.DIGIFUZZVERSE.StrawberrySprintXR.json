e=6AF35733"}, {"file_name": "com.DefaultCompany.MixedRealityTemplate-20261027-132846.png", "id": "1603803690804519", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821704_1603803697471185_2442078090819377030_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ibwpO5gRr_0Q7kNvwGnRvI7&_nc_oc=AdrJ8_DBzpVZ15e_iaMYwAGHx10XVSi2Sx1WkMUsMArM-m6d1Q67ADRm-J84aoIfc1g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-8eZyQeJQTzy3bDoWvlsWo3M-K5wO4io9fYSgRF48TA&oe=6AF340FC"}, {"file_name": "com.DefaultCompany.MixedRealityTemplate-20261027-132727.png", "id": "4460311837555738", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823940_4460311840889071_6882716751986618818_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9VSzN9nBH0kQ7kNvwEAkkSF&_nc_oc=AdrW_Y8aVKIx57KVWcilcz7qi90hl-zIqNeYBoD5fFFJ6wjGoA14gy59NnosaAY9GdA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIv1PdWqrYmGDl-QeiTSXbojZWmDiE-Lcr0AWACHkZ6Q&oe=6AF325B9"}, {"file_name": "com.DefaultCompany.MixedRealityTemplate-20261027-133330.png", "id": "1972925656721185", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823837_1972925660054518_6406851986969992738_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M2GNRpB6KVMQ7kNvwF0OXt8&_nc_oc=AdrXwvSGQy0XNShOG48vPwBc60KRrldvPhHH4kGA8CdVo5PNoIbwcQ6pAauv7uaKg7Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4FS-mLYJlTqaE8XKvX19gakIY1_pz5LXanOSwic16KQ&oe=6AF33C18"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Strawberry Sprint XR.png", "id": "4723185498004869", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827960_4723185501338202_5052620277054848932_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gQ-F-omuHk0Q7kNvwEgqFYG&_nc_oc=AdqQVvbwIOahQca9Ddbp3azECXKmSIU8j5UH3DDzE5_e99ppHMY-2LmsvzIxwsse2qw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQeTGTNhxWD-yGwaJUAtx6T_GSm5Bs--hb6jHk5vFNjtA&oe=6AF332DA"}, "display_name": "Strawberry Sprint XR", "keywords": ["strawberries", "MixedReality", "Games", "simulation", "Archade"], "long_description": "Strawberry Sprint is the first immersive mixed-reality greenhouse agricultural simulation in the world, developed by Digi Fuzz Verse in the Food Valley (Wageningen, Netherlands). Designed for intuitive spatial play, it lets you cultivate real strawberry varieties right inside your physical space using natural hand and controller interactions. Plant your seeds, fine-tune temperature, humidity, soil moisture, and light intensity, and watch your strawberry canopies and fruit respond in real time through dynamic digital twins.\n\nEach round teaches the core environmental principles behind precision horticulture, turning complex biological and climate dynamics into hands\u2011on spatial learning. Strawberry Sprint offers a vibrant, tactile, science\u2011driven experience that blends agricultural education with playful discovery, perfect for anyone curious about sustainable farming, climate control, or cutting\u2011edge mixed\u2011reality design.", "short_description": "Strawberry Sprint is the world\u2019s first mixed-reality strawberry greenhouse simulation, developed by Digi Fuzz Verse in Wageningen's Food Valley. Plant seeds in your physical space, fine-tune climate sliders like temperature and soil moisture, and watch your strawberry canopies and fruit respond in real time. Blending hands-on XR interaction with real agricultural science, it offers an immersive, tactile way to master precision farming and climate control."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/DigiFuzzVerse/Strawberry-Sprint-XR-/blob/main/PRIVACY_POLICY.md", "developer_terms_of_service_url": "https://github.com/DigiFuzzVerse/Strawberry-Sprint-XR-/blob/main/TERMS_OF_SERVICE.md", "publisher_name": "DigiFuzzVerse", "support_website_url": "https://github.com/DigiFuzzVerse/Strawberry-Sprint-XR-", "website_url": "https://www.digifuzzverse.nl/", "category": 
E&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGlLLjFrnIPFMr7ih-_N6mTdqDFgVu8GYEEpSs5pp6zg&oe=6AFB2518"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Strawberry Sprint XR.png", "id": "4723185498004869", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491827960_4723185501338202_5052620277054848932_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lJId4f2yHlEQ7kNvwG2s6Hc&_nc_oc=AdpbGBWMI7VSEnyKc8QJSWclUOdRRIE3x5OfZYZntWpzV6o_wcuq6hrXZkf0r0jGBps&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRt5OiAAUquSs0imheJEdGS78DehYd64HXhqh23XJXfew&oe=6AFB1BDA"}, "display_name": "Strawberry Sprint XR", "keywords": ["strawberries", "MixedReality", "Games", "simulation", "Archade"], "long_description": "Strawberry Sprint is the first immersive mixed-reality greenhouse agricultural simulation in the world, developed by Digi Fuzz Verse in the Food Valley (Wageningen, Netherlands). Designed for intuitive spatial play, it lets you cultivate real strawberry varieties right inside your physical space using natural hand and controller interactions. Plant your seeds, fine-tune temperature, humidity, soil moisture, and light intensity, and watch your strawberry canopies and fruit respond in real time through dynamic digital twins.\n\nEach round teaches the core environmental principles behind precision horticulture, turning complex biological and climate dynamics into hands\u2011on spatial learning. Strawberry Sprint offers a vibrant, tactile, science\u2011driven experience that blends agricultural education with playful discovery, perfect for anyone curious about sustainable farming, climate control, or cutting\u2011edge mixed\u2011reality design.", "short_description": "Strawberry Sprint is the world\u2019s first mixed-reality strawberry greenhouse simulation, developed by Digi Fuzz Verse in Wageningen's Food Valley. Plant seeds in your physical space, fine-tune climate sliders like temperature and soil moisture, and watch your strawberry canopies and fruit respond in real time. Blending hands-on XR interaction with real agricultural science, it offers an immersive, tactile way to master precision farming and climate control."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/DigiFuzzVerse/Strawberry-Sprint-XR-/blob/main/PRIVACY_POLICY.md", "developer_terms_of_service_url": "https://github.com/DigiFuzzVerse/Strawberry-Sprint-XR-/blob/main/TERMS_OF_SERVICE.md", "publisher_name": "DigiFuzzVerse", "support_website_url": "https://github.com/DigiFuzzVerse/Strawberry-Sprint-XR-", "website_url": "https://www.digifuzzverse.nl/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1450676928120498"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1663517382164282"}]}, "baseline_offer": {"id": "1663517382164282"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793371380, "status": "PUBLISHED", "id": "1663517382164282"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1458313597356831", "version": "4.0"}, "id": "2524474018061765", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "b
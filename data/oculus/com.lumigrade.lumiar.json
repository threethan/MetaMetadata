7SzyGf52Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTc-H9J3afb2rD6pR9L3jPO7EmgxxTJ9EPMtZo0e-J9Yw&oe=6B0DA822"}, {"file_name": "screenshot_05_life_size_2560x1440.png", "id": "1119451747415291", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593716858_1119451750748624_5392488968181398861_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YaMJdykhHvwQ7kNvwGoR0jj&_nc_oc=AdoulEAw6RU2CzsJb5XMR-3s_T2aBhLbcOHF4FO5v25QPegwuNGTtnjvjLqkHzXSjVo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR5aN3OzuOCh6lNERPPGwwUqrbuIURysfgdB91VhAqqug&oe=6B0DAD48"}, {"file_name": "screenshot_04_face_to_face_2560x1440.png", "id": "4556689117985037", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620559_4556689121318370_4813090087603111538_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jdqv9QhIrA8Q7kNvwENPsnF&_nc_oc=AdqBQl-E32R-eEIu-dxjE-tVVoDDjkXHedb0W5xIhEyvDwXzl5aMyxNQoLJ8y3dd10M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTtYoTn-7KO2nL0AfFu959ZV6JWXll0UfTEAq0iokWAhQ&oe=6B0DC5B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "1217649917242565", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623512_1217649920575898_5538717207085894023_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2jjtKDE3gzgQ7kNvwHQbN9V&_nc_oc=AdqKOCL2731dbHucvITkQ6IIruzNghIu4WonntIfqzzH3CE5GYTWm7KMAhkzQEQqyR4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQnhvRBXhWz8Tz-CIqk52zbk3NvPUGmFDOoHKHL6WBDmA&oe=6B0DBC48"}, "display_name": "LumiAR", "keywords": ["4DGS", "GaussianSplatting", "EWA", "4DScanLab", "LumiGrade"], "long_description": "Explore reality in 4D.\n\nLumiAR brings the 4DScanLab volumetric archive to Meta Quest. Every performance is captured on a 60-camera rig in our Saigon studio: real people, in motion, recorded as true 3D over time. It is not a flat video. It is a moment, kept whole.\n\nPut on your headset and the performer stands on your floor, in your own room, through passthrough. Walk around her. Lean in. Look from behind. Every angle is real.\n\nHOW IT WORKS\n- The first performance comes with the app, with its music. More appear in the gallery as the archive grows.\n- Use your hands (point and pinch) or Touch controllers.\n- Grab the green circle at her feet to move her, turn her or change her size.\n- A soft shadow grounds her on your floor.\n- Press the left stick, or look at your left palm and pinch, to pause and open the gallery. Press outside the gallery to close it and carry on.\n\nTHE ARCHIVE\nDance and Vietnamese heritage performances captured in the 4DScanLab studio.\n\nGOOD TO KNOW\n- No account, no ads, no tracking.\n- Performances you download stay on your headset and replay offline.\n- Made for Meta Quest 3 and Quest 3S.\n\nLumiAR is made by 4DScanLab. 4dscanlab.com", "short_description": "Real performers, captured whole in 4D, standing life-size in your room. LumiAR plays volumetric captures from the 4DScanLab studio right on your Quest, in passthrough. Walk around a dancer, look from any angle, move her with your hands or controllers, and listen to the music she was captured with. No account, no ads."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lumigrade.com/privacy/quest/", "developer_terms_of_service_url": null, "publisher_name": "LumiGrade | 4DScanLab", "support_website_url": null, "website_url": "https://www.lumigrade.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
ZGehH7LF-7O2fRx9twNzQo478vsQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRXHwpwJe4ZW1bFrUQzxt64_27K17xChyTCkwpHOgdkYA&oe=6B0DAE86"}, {"file_name": "screenshot_06_princess_2560x1440.png", "id": "2775021696248574", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/908839707_2775021699581907_4250286287506829955_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NevLV2j51_YQ7kNvwEaf1Dy&_nc_oc=AdpN4KsYwHby02d_gNUO-9alWgg9AdX9Ix2gkEk0k7SrsB5DiFT1hlf-0LPp4UwuFwM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSzQpVtarFZc-_2Sn_BGPKwVO95usMUbv8hbfWNy02OVA&oe=6B0D9F01"}, {"file_name": "screenshot_07_street_dance_2560x1440.png", "id": "1665459201632927", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/908839703_1665459204966260_325105615738496301_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5qIpWeBH3SQQ7kNvwGPBCDV&_nc_oc=AdqIgbQpcS6FQ4UyAXhkrfbYk2IOVsbtQzIM60vvG7gv2PN6mcdTXkV4tg33-Nfy1cs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS8xooOKiarYgzRJqJVFIEls7M9H7oFBfMIVQCB89UVxw&oe=6B0DBD24"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "4647082562248006", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/908839723_4647082565581339_7720114345300429362_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QgBOKbJqOB0Q7kNvwEUk6Du&_nc_oc=AdovQkCUOpgztp8EICs6KMnDXUZDnE2Vg59wvfUrxZ18sOkmjkaQhHfOLqMvaBL-TFg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQoEhHIZDksZqr_t3271mMyqIchrqOps3kDIkNFG8qC3w&oe=6B0DB022"}, "display_name": "LumiAR", "keywords": ["4DGS", "GaussianSplatting", "EWA", "4DScanLab", "LumiGrade"], "long_description": "LumiAR brings real performers into your room. Each performance was captured by the 4DScanLab studio in Saigon with 60 cameras and rebuilt in moving 3D, life-size, so you can walk around it and see it from every side. Choose from 45 performances, each with its own music coming from the performer. One is built in and plays offline; the rest stream over the internet and start in seconds.\n\nWITH CONTROLLERS\nRight grip or press left stick: open or close the gallery\nTrigger: choose in the gallery\nLeft grip: play / pause\nLeft stick: move the performer\nRight stick: up / down to resize, left / right to turn\nRight trigger: change the room brightness\nLeft trigger: add a copy of the performer\nLeft grip + left trigger: clear the copies\n\nWITH HANDS\nRaise one open hand, palm out, and hold: open the gallery\nAim and pinch: choose in the gallery\nPinch outside the gallery: close it\nPinch inside the green circle and drag: move\nPinch the edge of the circle and drag: turn\nPinch the circle with both hands, then pull apart or push together: resize\nAim at the performer and pinch: play / pause\n\nNo account, no ads. LumiAR collects no personal data. The performances are shown with the artists' agreement.", "short_description": "Real performers, captured whole in 4D, standing life-size in your room. LumiAR plays volumetric performances from the 4DScanLab studio right on your Quest, in passthrough. Walk around a dancer, look from any angle, and hear the music come from the performer. Pick from 45 performances in the gallery. No account, no ads."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lumigrade.com/privacy/quest/", "developer_terms_of_service_url": null, "publisher_name": "LumiGrade | 4DScanLab", "support_website_url": null, "website_url": "https://www.lumigrade.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommende
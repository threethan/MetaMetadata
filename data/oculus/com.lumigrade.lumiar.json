291", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/593716858_1119451750748624_5392488968181398861_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IBjcPdG-SmcQ7kNvwFfszeL&_nc_oc=AdrpO54GnYYS-ivO9losO0CEZtcdMET-RuVV98xX-o5Evt7kTIPsV1z0KC0xVIeTU6k&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-B8R95zW24WL55GiMi77hgMzCK0OegMSvD3lCz-PXTA&oe=6AD10848"}, {"file_name": "screenshot_04_face_to_face_2560x1440.png", "id": "4556689117985037", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499620559_4556689121318370_4813090087603111538_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1IYuYvNJn8YQ7kNvwHYJyjO&_nc_oc=AdrAMUmVkGCLqB_yd5hcHDsjFCEwQ2HnGFfXvjjaOZULS6YQUT8RwN4YubwdJpUoo7M&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM5CGpAhmzLCPR6evtZ6ASsDxxNPqM57MfUqiHMAcSMUQ&oe=6AD0E872"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "1217649917242565", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499623512_1217649920575898_5538717207085894023_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ZniEMSwDIYQ7kNvwGSkEcL&_nc_oc=AdqCKlxrOX3cYZupNuPWWoOzkzkOP-RY43A8py0MS0XMDi07neCNdRUyBT77mJHuKU4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMfRuZYIqWyuSri-CHJMkJ52Udo25oxB6BV7RvJ0OJf9w&oe=6AD0DF08"}, "display_name": "LumiAR", "keywords": ["4DGS", "GaussianSplatting", "EWA", "4DScanLab", "LumiGrade"], "long_description": "Explore reality in 4D.\n\nLumiAR brings the 4DScanLab volumetric archive to Meta Quest. Every performance is captured on a 60-camera rig in our Saigon studio: real people, in motion, recorded as true 3D over time. It is not a flat video. It is a moment, kept whole.\n\nPut on your headset and the performer stands on your floor, in your own room, through passthrough. Walk around her. Lean in. Look from behind. Every angle is real.\n\nHOW IT WORKS\n- The first performance comes with the app, with its music. More appear in the gallery as the archive grows.\n- Use your hands (point and pinch) or Touch controllers.\n- Grab the green circle at her feet to move her, turn her or change her size.\n- A soft shadow grounds her on your floor.\n- Press the left stick, or look at your left palm and pinch, to pause and open the gallery. Press outside the gallery to close it and carry on.\n\nTHE ARCHIVE\nDance and Vietnamese heritage performances captured in the 4DScanLab studio.\n\nGOOD TO KNOW\n- No account, no ads, no tracking.\n- Performances you download stay on your headset and replay offline.\n- Made for Meta Quest 3 and Quest 3S.\n\nLumiAR is made by 4DScanLab. 4dscanlab.com", "short_description": "Real performers, captured whole in 4D, standing life-size in your room. LumiAR plays volumetric captures from the 4DScanLab studio right on your Quest, in passthrough. Walk around a dancer, look from any angle, move her with your hands or controllers, and listen to the music she was captured with. No account, no ads."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lumigrade.com/privacy/quest/", "developer_terms_of_service_url": null, "publisher_name": "LumiGrade | 4DScanLab", "support_website_url": null, "website_url": "https://www.lumigrade.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1430209740164780"}}]}, "scheduled_offers":
ther things? I made that into a Quest game! \n\nBreak bottles, teapots, plates, and more in your own room! There is a VR training range, and an AR mode where you can aim at targets anchored in the real world. \n\nHave fun smashing!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.justindpnt.com/Privacy-Policy-for-Break-Room.pdf", "developer_terms_of_service_url": null, "publisher_name": "Justin DuPont", "support_website_url": null, "website_url": "https://www.justindpnt.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34557181773896518"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974575_1166100944390403_1371141400977819670_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Mkb3rPPCzUQ7kNvwFI4Y2A&_nc_oc=AdrqP9xRDJ9x8HCCydlhS_XQ39r4HHol3lENuBmAiGA-oR2U_4cVtoztJk0vtAPiguo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvbwyHcYjNQ8Vfe-KikuE58RzaEeP0zhnGan2ChFysIQ&oe=6AFB2F39"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Break Room", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 171588342
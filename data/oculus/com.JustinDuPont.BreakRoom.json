CaCCaw&oe=69B7EEE6"}, "display_name": "Break Room", "keywords": [], "long_description": "Break bottles, teapots, plates, and more in Break Room! Based on the \"Rage Rooms\" seen in real life, this recreates that experience on the Meta Quest!\n\nThere is a VR training range, and an AR mode where you can aim at targets anchored in the real world. How many targets can you hit in 60 seconds?\n\nHave fun smashing!", "short_description": "You know those real life \u201cRage Rooms\u201d, where you pay to throw bottles and other things? I made that into a Quest game! \n\nBreak bottles, teapots, plates, and more in your own room! There is a VR training range, and an AR mode where you can aim at targets anchored in the real world. \n\nHave fun smashing!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.justindpnt.com/s/Privacy-Policy-for-Break-Room.pdf", "developer_terms_of_service_url": null, "publisher_name": "Justin DuPont", "support_website_url": null, "website_url": "https://www.justindpnt.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25559034743711311"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974575_1166100944390403_1371141400977819670_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sSBFnkHkFggQ7kNvwHiLesR&_nc_oc=AdmXI4mQ41wXbSxCqt4
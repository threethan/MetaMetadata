sid=6e7a0a&_nc_ohc=dq_MrImbaW8Q7kNvwEldDn2&_nc_oc=AdqryX-pjPpHgFAmnLNWXFsLS0EQ1d1KskuxZudoljTugyGYh8OcPM5cF7xfyI_K-do&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIhEsEiJBnIiXl2S4khE6hWV-45ciZ6R9yCp2G_aV7cOA&oe=6A998EDE"}, {"file_name": "1.png", "id": "1290779156285510", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823790_1290779162952176_6013017190192177570_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5eeJgmUYJDAQ7kNvwG461OJ&_nc_oc=AdpyIxcl9SOekWvqyc2K6ZC72qzKi7IIwFwI56GaMTWHCYXtC8hcG5kIGe0p_wUQ5eQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-3li2Gz2uILdIREGmWgw43YHG-RSV-jGScqkToEoyeg&oe=6A997CE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Break Room Landscape 2k version.png", "id": "1432162101795247", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303971_1432162111795246_5617127363738507988_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OFMf5X66M14Q7kNvwFMw-8B&_nc_oc=Adorh3RwA0cmfPbdKUYuWocK-7y9wHXOBEFUf7fyE7PM4Rmt7Butj9e4eqP7hCD0QKw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZq6h1fE7JivcZrQF2nKjrBnsGFzMsG5FQbGPLB-U7qw&oe=6A9995E8"}, "display_name": "Break Room", "keywords": [], "long_description": "Break bottles, teapots, plates, and more in Break Room! Based on the \"Rage Rooms\" seen in real life, this recreates that experience on the Meta Quest!\n\nThere is a VR training range, and an AR mode where you can aim at targets anchored in the real world. How many targets can you hit in 60 seconds?\n\nHave fun smashing!", "short_description": "You know those real life \u201cRage Rooms\u201d, where you pay to throw bottles and other things? I made that into a Quest game! \n\nBreak bottles, teapots, plates, and more in your own room! There is a VR training range, and an AR mode where you can aim at targets anchored in the real world. \n\nHave fun smashing!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.justin
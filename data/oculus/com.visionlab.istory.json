_ohc=X7JIqXGlgSIQ7kNvwGMh8zz&_nc_oc=AdoDUEXRP598a48A4HkIMXbace4QlXrBsiHH4zoF703tRzWsEec8qdybCDIj_AkDEqs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTc2stnoHYowMVBuQdBq0EwFbIGoDDJ5aBJhkKUDVewTg&oe=6B0479D1"}, "display_name": "iStory", "keywords": [], "long_description": "iStory specially design for children\u2019s storytelling in VR experience. Virtual Reality helps students to strengthen their thoughts visually and put in plain words abstract concepts more concretely. It improves digital literacy and empowers different learning types. The iStory platform provides the most interesting VR storytelling for kids. iStory Platform delivers excellent learning experiences that inspire kids to learn. They have a dedicated team of VR developers, 3D artists, designers, and researchers to deliver immersive experiences that inspire kids to watch and learn.\nAre you looking for the best yet inexpensive storytelling, 3D VR (Virtual Reality) platform with interactivity actions? If so, the iStory can be your one-stop for the same. Stories are unique to express reality and adore from teachers and parents to kids.", "short_description": "Well said, \u201cStorytelling is our requirement to the next age group.\u201d iStory VR Storytelling helps kids to learn with  more fun. "}]}, "developer_name": "VisionLab", "developer_privacy_policy_url": "https://istory.co.in/privacy-policy", "developer_terms_of_service_url": "https://istory.co.in/terms-of-service", "publisher_name": "iStory", "support_website_url": "https://istory.co.in/contact/", "website_url": "https://istory.co.in/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages"
chers and parents to kids.", "short_description": "Well said, \u201cStorytelling is our requirement to the next age group.\u201d iStory VR Storytelling helps kids to learn with  more fun. "}]}, "developer_name": "VisionLab", "developer_privacy_policy_url": "https://istory.co.in/privacy-policy", "developer_terms_of_service_url": "https://istory.co.in/terms-of-service", "publisher_name": "iStory", "support_website_url": "https://istory.co.in/contact/", "website_url": "https://istory.co.in/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "979286346304989"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "3771485516268769", "version": "1.1"}, "id": "176469484239021", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3673379869412668", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "3771485516268769"}, "release_status": "SCHEDULED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "176469484239021"}]}, "change_log": "Permission issue fixed", "created_date": 1615617177, "id": "3771485516268769", "version": "1.1", "versio
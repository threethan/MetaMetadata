_sid=6e7a0a&_nc_ohc=HLPjqWbKOD0Q7kNvwG3bjuT&_nc_oc=AdrwK-g1JWOv2gCCjB8lvD89-Fm-kvgw5LDzUVrV8jnrTCKW3iYegbCEsrSXHrg3XRc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFWs5V2GOAKL_6UO_nv64tcr90Dz-1jYl1k7GuHn03tw&oe=6A95CCB3"}, {"file_name": "UPSCALE Screen 2-gigapixel-standard v2-2560w.png", "id": "1029208442908549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821704_1029208449575215_691282506501914928_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4gn23ZWyHscQ7kNvwF_G7b6&_nc_oc=AdqyB8C2hesrE7VtZpD5F51BZlK6Ht9ppQjYavf23zVR2jDdvlBdlWwczR0sOUTQY5A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrJvtQwxqJ4o0GnfSqmNXgYqI1mvYRPcylvako1d58bw&oe=6A95B68A"}, {"file_name": "UPSCALE Screenshot 1-gigapixel-standard v2-2560w.png", "id": "2853124811703454", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830467_2853124815036787_1222495693122616059_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3aodwP7DpcEQ7kNvwGZsQ5L&_nc_oc=AdpBAOClkoU-5tjGAfE0YGqOg9PhjSGJO8RBi2dles_7M9_GBchH562x5pM9CIcC8fs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH04O1PH13p5GhfVg_JJwuqTKtl2sE610NhzEOjaC09qg&oe=6A95AE55"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "2454882965014284", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/585819904_2454882968347617_7083605668578611091_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cf7jCKrRoOcQ7kNvwHbw_SQ&_nc_oc=AdooJ9BoCztmrURb2koLg83LO0wLg5__eOtmtTwVb-oP8yEQ9yocwmFuq-ES8tP5X-A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGTiYWKCemtpdQAnNSdazfunrGrWrED3K5i15omtf5OPA&oe=6A95DBED"}, "display_name": "VUSE XR", "keywords": ["Enterprise", "Training", "Showcase", "Education", "Onboarding"], "long_description": "VUSE XR brings your products to life in mixed reality.\nView immersive 3D experiences on your Meta Quest: from hands-on training to detailed product showcases. Follow clear, step-by-step guides that show you how to operate, service, and maintain complex devices, with animations, explosion views, and interactions that make every step easy to understand.\n\nThis app is built for viewing experiences created on the VUSE XR Hub. Open an experience shared with you and explore it in XR, at your own pace.\n\nWhat you can do:\n\n- Play through interactive trainings and product showcases\n- Follow guided, step-by-step instructions\n- Explore 3D models with animations, explosion views and more\n- Learn by doing, in a fully immersive environment\n\nIdeal for companies training teams on complex products, and for educators bringing 3D learning into the classroom.\n\nCraft your reality.", "short_description": "Step inside mixed reality with VUSE XR. View interactive 3D experiences built for your products and follow step-by-step guides to learn how to operate, service and maintain complex devices. Explore product showcases and immersive trainings on realistic virtual twins of your devices. Craft your reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vuse-xr.de/terms-conditions", "developer_terms_of_service_url": null, "publisher_name": "VUSE XR GmbH", "support_website_url": null, "website_url": "https://www.vuse-xr.de/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "539527055410505"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1182789628
_sid=6e7a0a&_nc_ohc=NhZludxVuPwQ7kNvwEorgm4&_nc_oc=AdryorNgim9Ift1RlQLBjNLLzcX0rULRPG9cCKeXbyDqVvi-KkDWmbjZPiZG1PjMSGY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPP-XMByUrvrPI2VumZ3s4Qm8jllEYlfA_SbpKTJ3ZYmA&oe=6AC26773"}, {"file_name": "UPSCALE Screen 2-gigapixel-standard v2-2560w.png", "id": "1029208442908549", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821704_1029208449575215_691282506501914928_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RcTSsz0P7G4Q7kNvwGGct9Z&_nc_oc=AdqBol_Jt55aM3hiAKiGRRUHa879kelX5p0G6MPMAHBSlyaITc6qflghHI6D6OQfPrg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFnYBXAUraeRMnvQG5NYEjNRABeuiYSd1X6ZHJHmdSrg&oe=6AC2514A"}, {"file_name": "UPSCALE Screenshot 1-gigapixel-standard v2-2560w.png", "id": "2853124811703454", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830467_2853124815036787_1222495693122616059_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9J0ONfMxZdQQ7kNvwGeMq-R&_nc_oc=AdpqaObPb1Fu1AYRk_bE9qKQBNUgQuff4_eKg_8zgyhZgeBzVoD8NSxWnIqsulQsGqY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNcI0AqkklgAV7-C87TjzLlbgOYxTSxlHpHXyhzUydb-w&oe=6AC28155"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "2454882965014284", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/585819904_2454882968347617_7083605668578611091_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6PWDvqssfdUQ7kNvwHYc146&_nc_oc=AdpNfYPumHvuIpDn_TLB542e4LEYHgoBzyGDsFnC1wfACbwUQBUVLh0tffHijH4CuM8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOu5K1iGJtheuSuxl0iu1C9Qyp_QCrtqnNBZt9jCdsAfQ&oe=6AC276AD"}, "display_name": "VUSE XR", "keywords": ["Enterprise", "Training", "Showcase", "Education", "Onboarding"], "long_description": "VUSE XR brings your products to life in mixed reality.\nView immersive 3D experiences on your Meta Quest: from hands-on training to detailed product showcases. Follow clear, step-by-step guides that show you how to operate, service, and maintain complex devices, with animations, explosion views, and interactions that make every step easy to understand.\n\nThis app is built for viewing experiences created on the VUSE XR Hub. Open an experience shared with you and explore it in XR, at your own pace.\n\nWhat you can do:\n\n- Play through interactive trainings and product showcases\n- Follow guided, step-by-step instructions\n- Explore 3D models with animations, explosion views and more\n- Learn by doing, in a fully immersive environment\n\nIdeal for companies training teams on complex products, and for educators bringing 3D learning into the classroom.\n\nCraft your reality.", "short_description": "Step inside mixed reality with VUSE XR. View interactive 3D experiences built for your products and follow step-by-step guides to learn how to operate, service and maintain complex devices. Explore product showcases and immersive trainings on realistic virtual twins of your devices. Craft your reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vuse-xr.de/terms-conditions", "developer_terms_of_service_url": null, "publisher_name": "VUSE XR GmbH", "support_website_url": null, "website_url": "https://www.vuse-xr.de/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "539527055410505"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1182789628
 {"file_name": "Screenshot 5.png", "id": "1810353826592630", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824741_1810353833259296_637533489625558316_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nReTFcGp14YQ7kNvwFdXTgj&_nc_oc=AdrjVtAz8aShjWXRpaXY57CX1vqrzllmrS7eXGKsb6Wuf5GQk9J3r0V2z6gseFpe5yE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB5YSzw8upRIy5Tds1C9ZpETYRnRaWoYgsNdffwEpqmVw&oe=6A5257F3"}, {"file_name": "UPSCALE Screen 2-gigapixel-standard v2-2560w.png", "id": "1029208442908549", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821704_1029208449575215_691282506501914928_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WBaeFH_HyiAQ7kNvwGgnIF_&_nc_oc=Adqi70BA-nCqRV__Uqc9CL5OBoGtLGH0nJZpInLpFrAxJJ5Dikh3x7_5EcO9gOz9Cx0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBbEd4wZPPjv4JkVkbyxFe8O5Fqc1ZFtaqxKZOx1ongnA&oe=6A5241CA"}, {"file_name": "UPSCALE Screenshot 1-gigapixel-standard v2-2560w.png", "id": "2853124811703454", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491830467_2853124815036787_1222495693122616059_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r-p0PegZ7-UQ7kNvwHiftQp&_nc_oc=Adr3jqNZu48E4oMlYUbJ0ctZGGYgYVhzpfTRtim6GdAt-iFCJInMdtOtj_U2vBqt3mQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDL1t2ZBzeOg_eoJkXrfSDuy22YVJAvKBpE0U4gtqZlRw&oe=6A523995"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "2454882965014284", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/585819904_2454882968347617_7083605668578611091_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s0VhEWmzmbYQ7kNvwHuMQbN&_nc_oc=AdooOjAMTAIOOhEMQd5E3Ru3OJEtrchLMYDVlYHfl62GdpE7AmHifeuRP4K-U-S5g1w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCzF7xixKWCNtiHLymbmVbwRp8Xq0trZDSZXNryb29LaQ&oe=6A522EED"}, "display_name": "VUSE XR", "keywords": ["Enterprise", "Training", "Showcase", "Education", "Onboarding"], "long_description": "VUSE XR brings your products to life in mixed reality.\nView immersive 3D experiences on your Meta Quest: from hands-on training to detailed product showcases. Follow clear, step-by-step guides that show you how to operate, service, and maintain complex devices, with animations, explosion views, and interactions that make every step easy to understand.\n\nThis app is built for viewing experiences created on the VUSE XR Hub. Open an experience shared with you and explore it in XR, at your own pace.\n\nWhat you can do:\n\n- Play through interactive trainings and product showcases\n- Follow guided, step-by-step instructions\n- Explore 3D models with animations, explosion views and more\n- Learn by doing, in a fully immersive environment\n\nIdeal for companies training teams on complex products, and for educators bringing 3D learning into the classroom.\n\nCraft your reality.", "short_description": "Step inside mixed reality with VUSE XR. View interactive 3D experiences built for your products and follow step-by-step guides to learn how to operate, service and maintain complex devices. Explore product showcases and immersive trainings on realistic virtual twins of your devices. Craft your reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vuse-xr.de/terms-conditions", "developer_terms_of_service_url": null, "publisher_name": "VUSE XR GmbH", "support_website_url": null, "website_url": "https://www.vuse-xr.de/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "539527055410505"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_i
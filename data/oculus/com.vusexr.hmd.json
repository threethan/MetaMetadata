0g8PVyZvMYwRD3VY7T1YTY8cUbq7Omg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBoegA_b0MiKOqQ9GzrNUDqC1tj9peORCvI-1QAdAP2kA&oe=6A53934A"}, {"file_name": "UPSCALE Screenshot 1-gigapixel-standard v2-2560w.png", "id": "2853124811703454", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830467_2853124815036787_1222495693122616059_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r-p0PegZ7-UQ7kNvwHVfeG4&_nc_oc=AdrQnMjDtxz75uO0s1JFpcaI4714Nl4Y_hG83u_D5jP8cu_jDZ5TkKlctZK7qgA95P8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDyAmjJcfy6L_ONYSDZGBf6nUm8Tp4WhTOzJM8AF22K0w&oe=6A538B15"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "2454882965014284", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/585819904_2454882968347617_7083605668578611091_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s0VhEWmzmbYQ7kNvwF7hPNp&_nc_oc=Adr3htbWcMiLwgBfBWw4S_ArQ8k91ndpGd8SHkiBOePIl8t55k3u8xpzPD_mu4p_mdo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCA6LnU10Lye08hEfmlBfm-d6qaJySUdIsd4W_mZ2X13A&oe=6A53806D"}, "display_name": "VUSE XR", "keywords": ["Enterprise", "Training", "Showcase", "Education", "Onboarding"], "long_description": "VUSE XR brings your products to life in mixed reality.\nView immersive 3D experiences on your Meta Quest: from hands-on training to detailed product showcases. Follow clear, step-by-step guides that show you how to operate, service, and maintain complex devices, with animations, explosion views, and interactions that make every step easy to understand.\n\nThis app is built for viewing experiences created on the VUSE XR Hub. Open an experience shared with you and explore it in XR, at your own pace.\n\nWhat you can do:\n\n- Play through interactive trainings and product showcases\n- Follow guided, step-by-step instructions\n- Explore 3D models with animations, explosion views and more\n- Learn by doing, in a fully immersive environment\n\nIdeal for companies training teams on complex products, and for educators bringing 3D learning into the classroom.\n\nCraft your reality.", "short_description": "Step inside mixed reality with VUSE XR. View interactive 3D experiences built for your products and follow step-by-step guides to learn how to operate, service and maintain complex devices. Explore product showcases and immersive trainings on realistic virtual twins of your devices. Craft your reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vuse-xr.de/terms-conditions", "developer_terms_of_service_url": null, "publisher_name": "VUSE XR GmbH", "support_website_url": null, "website_url": "https://www.vuse-xr.de/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "539527055410505"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1182789628242705"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824700_843446821916638_19278399267476669_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BVQR5y9IYm0Q7kNvwGifNRB&_nc_oc=AdpiShnnoudUe98hR3ZnHxwO1tK47A5gDsZ_tcbEeHTJ1epRCAT6nPRwUcJkeNHKZgA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCi2hygwbXyb1vXU7mTIGzxVXPYc1H92yHql0BfB3MwJg&oe=6A5392D5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VUSE XR", "pla
c_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dCGHcMxf5EkQ7kNvwFG_ZtW&_nc_oc=Adq3pTXnUS8IGvEfux7BmDhRARoVAXiIa9lbKeB3MOrWi5E0sAZ6r8q7u-U1S-9kBzI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEy25S1Xlrcsm4T_yaHrABjOGvPHcoHISNiqcGfS59EXQ&oe=6A8D7333"}, {"file_name": "UPSCALE Screen 2-gigapixel-standard v2-2560w.png", "id": "1029208442908549", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491821704_1029208449575215_691282506501914928_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yGiggq3J958Q7kNvwGR_x4M&_nc_oc=AdpJeTlWa0ZuUSbsj1SQ-YsfVM5XcxPXhN4R87x2ZjS9T4lhnT0UEM9_dmmaUQDP4b0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGhCoN0j3g-3CIhztaB9kGsLBWkqEDo6rZBN5MCw-ldHg&oe=6A8D954A"}, {"file_name": "UPSCALE Screenshot 1-gigapixel-standard v2-2560w.png", "id": "2853124811703454", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491830467_2853124815036787_1222495693122616059_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VX9TesG6dG4Q7kNvwE67pf-&_nc_oc=AdpfBf3EivLcB2plgfkda3tPNs4EVjOxMlqZUXLCyjHVG9Z9t-ZDD0yyh3-ZjVyUhb8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUylmJgqirBLE1Z7ayUUkLTX5wDtuS3g7--ahx92fpHQ&oe=6A8D8D15"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "2454882965014284", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/585819904_2454882968347617_7083605668578611091_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f4u2WfUD3OEQ7kNvwFESjS3&_nc_oc=Adp68-SYt04QYA_2mAORpnpViIEizW2FltPxkBLFVmTFqpa0uW5gtj8Efvag9MsQnSs&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFowD8UjdtMBAJOXIK5j-wc6EMjMUmWtjGysz9F9_VT0A&oe=6A8D826D"}, "display_name": "VUSE XR", "keywords": ["Enterprise", "Training", "Showcase", "Education", "Onboarding"], "long_description": "VUSE XR brings your products to life in mixed reality.\nView immersive 3D experiences on your Meta Quest: from hands-on training to detailed product showcases. Follow clear, step-by-step guides that show you how to operate, service, and maintain complex devices, with animations, explosion views, and interactions that make every step easy to understand.\n\nThis app is built for viewing experiences created on the VUSE XR Hub. Open an experience shared with you and explore it in XR, at your own pace.\n\nWhat you can do:\n\n- Play through interactive trainings and product showcases\n- Follow guided, step-by-step instructions\n- Explore 3D models with animations, explosion views and more\n- Learn by doing, in a fully immersive environment\n\nIdeal for companies training teams on complex products, and for educators bringing 3D learning into the classroom.\n\nCraft your reality.", "short_description": "Step inside mixed reality with VUSE XR. View interactive 3D experiences built for your products and follow step-by-step guides to learn how to operate, service and maintain complex devices. Explore product showcases and immersive trainings on realistic virtual twins of your devices. Craft your reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vuse-xr.de/terms-conditions", "developer_terms_of_service_url": null, "publisher_name": "VUSE XR GmbH", "support_website_url": null, "website_url": "https://www.vuse-xr.de/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "539527055410505"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SING
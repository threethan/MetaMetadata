310_1302705481941197_8591203868576903760_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qyjbe2V5rb8Q7kNvwEyuJFm&_nc_oc=Adp-mNSpi7-IFPCOm8DFQ-zQPKcVKE6RzXCT3UUW8jBYoIPYguBCiaQD9mh_Btf47eA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-0VbOUWkLmHe46pE7rrferYeSdckV775HMoAPgFrWsw&oe=6AAA9163"}, {"file_name": "ReVeil-Screenshot-5.png", "id": "1621904329646989", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499311597_1621904332980322_2455360977566584194_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TdGDIRoL9FwQ7kNvwH6OirA&_nc_oc=Adrqbpjm6OL3ySE3Y_IkUZpYPb6p7SbFwgR8iX8fF37T7keXV3DZT0_sa60rlWh28-M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzkKV-d_XnzAWXgIr0l-7nVnZqagJR5m_ekV3c-DuN2Q&oe=6AAAA150"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ReVeil", "keywords": ["wedding", "memories", "anniversary", "video", "immersive"], "long_description": "Your wedding day passes in a blur. ReVeil lets you go back.\n\nReVeil transforms the films from your wedding into a private, immersive estate \u2014 a place in VR where your day lives on. Cinematic 360\u00b0 films put you back inside each moment, right where it happened: beside the altar for the vows, in the middle of the tent for the father-daughter dance, in the library while the toasts are told.\n\nMove through the day scene by scene \u2014 getting ready, ceremony, golden hour, reception \u2014 each chapter with its own films and covers. Follow the wedding timeline in order, or wander wherever the evening pulls you.\n\nFeatures:\n\u2022 Cinematic 360\u00b0 wedding films, anchored where each moment happened\n\u2022 Scene-by-scene browsing with a timeline of the whole day\n\u2022 An elegant estate environment to explore between films\n\u2022 Comfortable, stationary viewing \u2014 best experienced seated or standing, no locomotion required\n\nReVeil is made for couples, families, and guests who want more than a highlight reel: a way to be there again, on every anniversary.\n\nExplore the featured wedding included with the app. If ReVeil filmed your wedding, your own estate arrives with your collection.", "short_description": "Relive your wedding day. ReVeil turns your wedding films into an immersive estate you can step inside \u2014 the ceremony, the toasts, the first dance, in cinematic 360\u00b0 right where each moment happened. Wander the venue, browse the day scene by scene, and be there again."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.reveilmedia.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ReVeil Media", "support_website_url": null, "website_url": "https://www.reveilmedia.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "2687655338230691"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1237296276139001"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/507832394_1647912110263525_9108014321030707372_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wWREunGRTpcQ7kNvwHIGRyU&_nc_oc=AdpfrfrSUngHTrl_m_Isexy33tMsphJhuhEtOWfjPxB3_mtQEeNkL2sQfevnlkNjDvE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfG2M97ekgoGBLWYQKfwJMh-FZTrNo_hn2yJilybXrsQ&oe=6AAAA1CA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "ReVeil", "platf
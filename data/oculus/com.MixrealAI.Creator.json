ile_name": "CapturaMenNuevo.png", "id": "1587078949312608", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819281_1587078952645941_1237253964784356107_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pA8lRd61qWQQ7kNvwGpToN-&_nc_oc=AdpRBddM492y8H1xoMhEgqhUrBb4mpw3PWpWUgWToyafCqI27xlSIduTgjKIMh1Hxas&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3VZjdPEqgRan1AOkLa_mmISDBPZGmY0_LacH-M3I-s8A&oe=69F74130"}, {"file_name": "CapturaRatonNueva.png", "id": "1328479655493107", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823901_1328479662159773_1818035943479173708_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OiawAeQ-FnkQ7kNvwFniebr&_nc_oc=Adqa-bxj-A1pxD55Q9Ur0HwPQVwXyUcxYRNRzrGuyVI-uahZ3S2sQUjKbW9FrlffKSA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2VyB8nLtnORGGicfufXlh4QbCuTqii5zMgXAM5QfSazQ&oe=69F73D9C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mixreal AI", "keywords": ["Mixreal", "CreacionDeMundos", "RealidadMixta", "RealidadVirtual", "Inmersivo"], "long_description": "MixReal  es una innovadora plataforma dise\u00f1ada para transformar la forma en que las personas crean y experimentan espacios virtuales.\n\nCon MixReal, los usuarios pueden construir entornos personalizados de manera sencilla, a\u00f1adiendo modelos 3D e im\u00e1genes para configurar salas virtuales adaptadas a sus necesidades. Estas creaciones se pueden explorar tanto en realidad virtual (VR) como en realidad mixta (MR), ofreciendo una experiencia envolvente y multiplataforma.\n\nEspecialmente enfocada en los sectores de la educaci\u00f3n y el marketing, MixReal permite a educadores, marcas y creadores de contenido dise\u00f1ar espacios interactivos que impulsan el aprendizaje, la colaboraci\u00f3n y la conexi\u00f3n emocional con sus audiencias. Desde aulas virtuales hasta showrooms de productos, la herramienta facilita la creaci\u00f3n de experiencias inmersivas sin necesidad de conocimientos t\u00e9cnicos avanzados.\n\nGracias a su interfaz intuitiva y su flexibilidad, MixReal  es la soluci\u00f3n ideal para quienes buscan innovar en la comunicaci\u00f3n, la formaci\u00f3n o el marketing de manera impactante y efectiva.", "short_description": "MixReal Creator es una potente herramienta que permite a los usuarios crear espacios virtuales personalizados a\u00f1adiendo modelos 3D e im\u00e1genes. Dise\u00f1ada para el sector educativo y el marketing, ofrece experiencias inmersivas accesibles tanto en realidad virtual como en realidad mixta."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mixreal.com/terms-of-service", "developer_terms_of_service_url": null, "publisher_name": "Mixreal", "support_website_url": "https://mixreal.com/contacto", "website_url": "https://mixreal.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["es"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24510847748595113"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830443_1889025765247314_2828124137533460920_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l_BMIO1jRpEQ7kNvwGSJwEU&_nc_oc=Adq63kd8R1InY0CY2uX2ahPZE9IZrJ26c2chYYxYYV8kqYbNePrvTAWkoy6snvJy3kU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0Rz6QYQl0sGEWsFyWkaWqayz9NrgnqqjmhsI_9kyRPEQ&oe=
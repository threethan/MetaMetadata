ile_name": "CapturaMenNuevo.png", "id": "1587078949312608", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819281_1587078952645941_1237253964784356107_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tItcygVr5EAQ7kNvwFROLEr&_nc_oc=AdoGaFDs1pTtfBGNKn-iIBBng0cCvfljAHwA8azqnMcyRfsONyx4vn4JOj-_fnB2WrU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZ0uMAUarCm6SGACzWo7kN2DADkNF8Q1aJ3WiyvBGfDA&oe=6A86F4B0"}, {"file_name": "CapturaRatonNueva.png", "id": "1328479655493107", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823901_1328479662159773_1818035943479173708_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H6U9n4RSxfUQ7kNvwFGFjak&_nc_oc=AdoCc-4ejWiI7gmkoeNeaPy8f-4qIGoKpszLJDEnOUpDjaefW18ZzC1AiPGnbbWDqJw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2CEuLZLXOtj8CIAuruHfNhG4awiuxw5GbIGovoWHqMA&oe=6A86F11C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mixreal AI", "keywords": ["Mixreal", "CreacionDeMundos", "RealidadMixta", "RealidadVirtual", "Inmersivo"], "long_description": "MixReal  es una innovadora plataforma dise\u00f1ada para transformar la forma en que las personas crean y experimentan espacios virtuales.\n\nCon MixReal, los usuarios pueden construir entornos personalizados de manera sencilla, a\u00f1adiendo modelos 3D e im\u00e1genes para configurar salas virtuales adaptadas a sus necesidades. Estas creaciones se pueden explorar tanto en realidad virtual (VR) como en realidad mixta (MR), ofreciendo una experiencia envolvente y multiplataforma.\n\nEspecialmente enfocada en los sectores de la educaci\u00f3n y el marketing, MixReal permite a educadores, marcas y creadores de contenido dise\u00f1ar espacios interactivos que impulsan el aprendizaje, la colaboraci\u00f3n y la conexi\u00f3n emocional con sus audiencias. Desde aulas virtuales hasta showrooms de productos, la herramienta facilita la creaci\u00f3n de experiencias inmersivas sin necesidad de conocimientos t\u00e9cnicos avanzados.\n\nGracias a su interfaz intuitiva y su flexibilidad, MixReal  es la soluci\u00f3n ideal para quienes buscan innovar en la comunicaci\u00f3n, la formaci\u00f3n o el marketing de manera impactante y efectiva.", "short_description": "MixReal Creator es una potente herramienta que permite a los usuarios crear espacios virtuales personalizados a\u00f1adiendo modelos 3D e im\u00e1genes. Dise\u00f1ada para el sector educativo y el marketing, ofrece experiencias inmersivas accesibles tanto en realidad virtual como en realidad mixta."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mixreal.com/terms-of-service", "developer_terms_of_service_url": null, "publisher_name": "Mixreal", "support_website_url": "https://mixreal.com/contacto", "website_url": "https://mixreal.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["es"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24510847748595113"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491830443_1889025765247314_2828124137533460920_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FmIrcuzVOuwQ7kNvwH4Pm7o&_nc_oc=Adqgp4xAoqBtaSNBNsQFNU-cyuG7e2fI3g8yz5acURzEigLKbLEGN46EkLk0KqXPbIc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJCb8GiPLUsBsrfdGg_6VjQlX2Y9cbiutodE_LrY1LnQ&oe=
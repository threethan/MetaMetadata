84_123993829622586_3071525568216661453_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E-taQ1s1-FoQ7kNvwGsWJcm&_nc_oc=Adr_aWcexDcZuwO7lAi6w8GuQOK70v8aige6qV5MgPSI_9oW1IuwWsTZc28mfXucPsA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSklZ0UqrlSoMATZwfl4pEks4qxOscI5vU-r584uWMSag&oe=6AE74AF7"}, {"file_name": "quest_store_ss5.png", "id": "451607189360258", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974738_451607192693591_5264901383228771667_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nAbDm13TjPUQ7kNvwFcNNxi&_nc_oc=AdpM8fBDtzQdt4USR6W4MTl7xE2L0usxMMkTkw00SFOJigy4sRFpkh7JsfVto5dsYOY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbZ9MZZd9xAuj5dB1f-bmof5zELI7KWbUpK7DnQWgmuA&oe=6AE75016"}, {"file_name": "quest_store_ss1.png", "id": "1061720087646878", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974908_1061720090980211_61566680048714381_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Z1ZlovQ0mEQ7kNvwHlct9n&_nc_oc=Adok23sfAAywD7-yiNvb8HnfaPoQA3-Y6N1cT5DkGEl-3W0dJIi4Jm-MotdzW3HIZZQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQnxMHCalTn5QcyZ_wqeUu1-sceV6BqiVcCMNX416xbw&oe=6AE7415E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "quest_store_promo_cover.png", "id": "417340956009330", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031495_417340959342663_8025418479443864112_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9xCA8Xhb-hIQ7kNvwErl4kn&_nc_oc=AdrU7IjJRAo4PAUho291PnlG8MrE4EmFZfwVxpa94Vi9xbK3aVkej1tornM1B0-3Vqg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7sBhGJuZz9GXM4-cdFwQy7zD7G7sZRryZsNG5pAztuw&oe=6AE76725"}, "display_name": "Verto Studio VR", "keywords": ["3d", "modeling", "Creator", "art", "editor"], "long_description": "VertoStudio VR is a fully-capable 3D modeling studio designed to run entirely in VR!  You can use it to import FBX, OBJ, DAE (and more) directly in front of you, then configure every aspect of the visual display of these scenes directly down to the individual polygons. \n\nWhether you are mocking up a quick VR workflow, or designing production VR environments, this tool eliminates all of the pipeline complexity involved with getting 3D assets and content into VR quickly. Using Verto Studio, there is no more guesswork in designing for VR. ", "short_description": "VertoStudio VR is a fully-capable 3D modeling studio designed to run entirely in VR!  You can use it to import FBX, OBJ, DAE (and more) directly in front of you, then configure every aspect of the visual display of these scenes directly down to the individual polygons. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://vertostudio.com/pub/legal_and_priv_policy_holo.pdf", "developer_terms_of_service_url": null, "publisher_name": "VERTO STUDIO LLC", "support_website_url": null, "website_url": "https://vertostudio.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY", "EDUCATIONAL", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8365527463494815"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75622016_1000402328502792_7424357689205527073_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wLA-aM0BiaIQ7kNvwGYl6Pj&_nc_oc=AdqCElZpGH_6pXMoHtkcECTKLM-8ZB69jzzNRBOIxmsF438XXFxzBEdLJYFSNIFyj-Y&_nc_
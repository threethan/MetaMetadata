84_123993829622586_3071525568216661453_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3529dQk0vEQQ7kNvwEZOw7I&_nc_oc=AdokL1z64JzgG8Uov600yldGF91w6z-sOAJDHOaT88J7ixxnXNNsbc4_F-Etu8daRNA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFwcfkImT7073WlVT2AmcNyBSoeExwKV1iPLcAdpWOYQ&oe=6AF5CB77"}, {"file_name": "quest_store_ss5.png", "id": "451607189360258", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974738_451607192693591_5264901383228771667_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mx6fUJjjl6sQ7kNvwEhpdZ6&_nc_oc=AdoS0_29Imvb-5EKMNhYHgzKJ4cx_NTQEyVWtDmUwX3WVVh1PL_Bjt71-6o6tsz4cSQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgqDxzQHjuW3zJvS-Ks-A8D6y2_ZuFV-JOD-ZE-SgvQg&oe=6AF5D096"}, {"file_name": "quest_store_ss1.png", "id": "1061720087646878", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974908_1061720090980211_61566680048714381_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_oRRGf-jEJ0Q7kNvwE32wO6&_nc_oc=AdrS1Ppoo5ujhc1smoUy7sI90VmTIzq3SHYQMkz2M96uQpCMgEvq0vnCVRqJipIlC7c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbon3N5uPQ7okqhEu7UYgg6SxgWQGRnPmc3cpFsehv_w&oe=6AF5C1DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "quest_store_promo_cover.png", "id": "417340956009330", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031495_417340959342663_8025418479443864112_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zatXg40tZ5sQ7kNvwGwPrAR&_nc_oc=Adr00ZdWVXlcB2rTtvNSt5ihagUTtj3F5rgO_nZof1324o6R6U9SWTWGOwAS0IBcPh0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGiduoJ67OG04WOQ2aaAa_AbOm-ifZyDeyMY5w89g9MQ&oe=6AF5E7A5"}, "display_name": "Verto Studio VR", "keywords": ["3d", "modeling", "Creator", "art", "editor"], "long_description": "VertoStudio VR is a fully-capable 3D modeling studio designed to run entirely in VR!  You can use it to import FBX, OBJ, DAE (and more) directly in front of you, then configure every aspect of the visual display of these scenes directly down to the individual polygons. \n\nWhether you are mocking up a quick VR workflow, or designing production VR environments, this tool eliminates all of the pipeline complexity involved with getting 3D assets and content into VR quickly. Using Verto Studio, there is no more guesswork in designing for VR. ", "short_description": "VertoStudio VR is a fully-capable 3D modeling studio designed to run entirely in VR!  You can use it to import FBX, OBJ, DAE (and more) directly in front of you, then configure every aspect of the visual display of these scenes directly down to the individual polygons. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://vertostudio.com/pub/legal_and_priv_policy_holo.pdf", "developer_terms_of_service_url": null, "publisher_name": "VERTO STUDIO LLC", "support_website_url": null, "website_url": "https://vertostudio.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY", "EDUCATIONAL", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8365527463494815"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75622016_1000402328502792_7424357689205527073_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qjOnmPe4v98Q7kNvwGVecw1&_nc_oc=Adr2pLrIOZcjZOnaEHO5ZwuvNoYF3O2alxvf3g5sSWQiHT71MgWl5O3wGdgBR7BP5KQ&_nc_
84_123993829622586_3071525568216661453_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zijWnD885dYQ7kNvwE_-rV5&_nc_oc=AdrffSbRQplEAEP-xoMbvDWglH-XGXPSX_X8Y3tq82OwpSlwWVqEf06Wa_igNh6eYJ0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0iVMtlbqY63ZCqjR8yZl9jyjL_48p0kgP-1o-eJ5xRw&oe=6A32AD77"}, {"file_name": "quest_store_ss5.png", "id": "451607189360258", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974738_451607192693591_5264901383228771667_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=syXU-4llwNYQ7kNvwGzNMPt&_nc_oc=Adrzu4frwLptZeWabLLS1rnQaC0GbMFXIbyhx9OUC1hJCqYUcAJlYLDTnHQYNtwH8zY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3K49weqQBI34Rm7iOLV7kIhWAICesyECOO9SWe0N_RQ&oe=6A32B296"}, {"file_name": "quest_store_ss1.png", "id": "1061720087646878", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974908_1061720090980211_61566680048714381_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ayFHrzR1itsQ7kNvwFa8_u7&_nc_oc=AdoHszS2ZJ8Tk6D5-5Nvh_ITmdZpWR4irpu1-rtJSAQ187UjVHDqZwateBKa6YuMTZo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9rlUsf1GXCtb4z7gW5Nez4UTgXXilU5ddIZqc8HfVIuQ&oe=6A32A3DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "quest_store_promo_cover.png", "id": "417340956009330", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031495_417340959342663_8025418479443864112_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=295wg31KSA8Q7kNvwFdEFWd&_nc_oc=AdrJ82NKQI9YShQIcnF9lJbwN6RYrsGKXH-dhmeaGMJ1_xgA0Gzl89sZ0sOPiXLoi-E&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af87UywvzNdD1AAX3FePNiICkrPSv3mJTb_k8KSNSj4Nxw&oe=6A329165"}, "display_name": "Verto Studio VR", "keywords": ["3d", "modeling", "Creator", "art", "editor"], "long_description": "VertoStudio VR is a fully-capable 3D modeling studio designed to run entirely in VR!  You can use it to import FBX, OBJ, DAE (and more) directly in front of you, then configure every aspect of the visual display of these scenes directly down to the individual polygons. \n\nWhether you are mocking up a quick VR workflow, or designing production VR environments, this tool eliminates all of the pipeline complexity involved with getting 3D assets and content into VR quickly. Using Verto Studio, there is no more guesswork in designing for VR. ", "short_description": "VertoStudio VR is a fully-capable 3D modeling studio designed to run entirely in VR!  You can use it to import FBX, OBJ, DAE (and more) directly in front of you, then configure every aspect of the visual display of these scenes directly down to the individual polygons. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://vertostudio.com/pub/legal_and_priv_policy_holo.pdf", "developer_terms_of_service_url": null, "publisher_name": "VERTO STUDIO LLC", "support_website_url": null, "website_url": "https://vertostudio.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY", "EDUCATIONAL", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8365527463494815"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75622016_1000402328502792_7424357689205527073_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W4nRCS35LIAQ7kNvwHT1jkO&_nc_oc=AdpfAVmDK-vgVMtg4OkW_5xy0hRIuSR47SHIaFnsE-pHzVy6lUrJhUTF9gF8urVROIw&_nc_
84_123993829622586_3071525568216661453_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yV_WJ8Zry6UQ7kNvwF9CwP8&_nc_oc=Adr-NHM1Ncpro9L1Cvpq21P7_0guokrLfHHe4QjwhwGH8AR9poaWISNRMOScKsiQrOs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNM9veqsTBeYJ5iWLv62P28yNsGCBJeRwyfUz3LQOe7YA&oe=6AC65577"}, {"file_name": "quest_store_ss5.png", "id": "451607189360258", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974738_451607192693591_5264901383228771667_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OkZudsfQXPoQ7kNvwGxN3Zx&_nc_oc=AdqVZ_AqDrBgoDwfuOGfGD0RNBlNNxIqTiBHxP4jFCjLz7Ypp7HlVTBXedXCTWBas-o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOD7DYmtzhE5FY55CiJOD5BM_la5riNhrCi0Phqhb2vQQ&oe=6AC65A96"}, {"file_name": "quest_store_ss1.png", "id": "1061720087646878", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974908_1061720090980211_61566680048714381_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m4IBo8QPtAgQ7kNvwHhxo6i&_nc_oc=AdoST49RBvpegdk-5bvLbZLwzp8Mow9GP37p6EWMVdkzHGzBoA1kBama1OMkGWqF22g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO9M_B8jk1lamLxf_wh9LH7WataUdq56vXLNJl_CxOPew&oe=6AC64BDE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "quest_store_promo_cover.png", "id": "417340956009330", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031495_417340959342663_8025418479443864112_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=64C8qC6YJMgQ7kNvwH-RyJK&_nc_oc=AdqVqvw91ZtJdC_AbzqOn3QhB84okzdvDTS-Fp_K-7yLORXr50fIXdxj9tBj9Wcbzqs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOXKSpmDqEqcYekWOEAK5zG_RpbMzyJa6aGLVQkAiu_hA&oe=6AC671A5"}, "display_name": "Verto Studio VR", "keywords": ["3d", "modeling", "Creator", "art", "editor"], "long_description": "VertoStudio VR is a fully-capable 3D modeling studio designed to run entirely in VR!  You can use it to import FBX, OBJ, DAE (and more) directly in front of you, then configure every aspect of the visual display of these scenes directly down to the individual polygons. \n\nWhether you are mocking up a quick VR workflow, or designing production VR environments, this tool eliminates all of the pipeline complexity involved with getting 3D assets and content into VR quickly. Using Verto Studio, there is no more guesswork in designing for VR. ", "short_description": "VertoStudio VR is a fully-capable 3D modeling studio designed to run entirely in VR!  You can use it to import FBX, OBJ, DAE (and more) directly in front of you, then configure every aspect of the visual display of these scenes directly down to the individual polygons. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://vertostudio.com/pub/legal_and_priv_policy_holo.pdf", "developer_terms_of_service_url": null, "publisher_name": "VERTO STUDIO LLC", "support_website_url": null, "website_url": "https://vertostudio.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY", "EDUCATIONAL", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8365527463494815"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75622016_1000402328502792_7424357689205527073_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ccWMQzL2LhIQ7kNvwF42klD&_nc_oc=Adrwq6aumMai9KWahxW5UfgLPrwRVEok1U5nFuPfIYiKmwkam_nDlfpM_199YIHk5Dw&_nc_
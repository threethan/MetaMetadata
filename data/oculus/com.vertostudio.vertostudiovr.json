84_123993829622586_3071525568216661453_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=inUH2EDR9cIQ7kNvwHbCJP8&_nc_oc=Adrx13hf48Z3OOMZ6SSdurNQwqDzw6YhpiSzEt600dM793pkBI4yB9CyxM-p6eFb3VU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_TqjQAuO5JE19Ea2YJsEMua-K63gBeMikA4bwZr-6z3A&oe=6A43D0F7"}, {"file_name": "quest_store_ss5.png", "id": "451607189360258", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974738_451607192693591_5264901383228771667_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v3vDwf3bLqYQ7kNvwEeu4wh&_nc_oc=AdrFtVEDHgSOiU77vg5Vars2qYYYwDqS4jP838WgvrExJ7rCC20w8C-kWxBgpRwKORY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9W_0Ap63tGLunsReEKYQLgz3CY6xnr5Wx_w9mE6gszNQ&oe=6A43D616"}, {"file_name": "quest_store_ss1.png", "id": "1061720087646878", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974908_1061720090980211_61566680048714381_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ND2SDDuMl0QQ7kNvwFjmduc&_nc_oc=AdreJQcXT80s9oeUCOLal68Wqjeb4Smv-F5PLgmb31wFoZVCdTzBU7gLfoRVZ05xHQI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-b5uRGDitJgDq5hHiwksLSgkIuhPgFhccSTZYah_qx-A&oe=6A43C75E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "quest_store_promo_cover.png", "id": "417340956009330", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031495_417340959342663_8025418479443864112_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_4rjZMFH9l8Q7kNvwE-JhLB&_nc_oc=Ado9APIy9J927l13qiKtJlt_d7BMb6-BYx9cvZ17RF6MqNT0QmybIX1AB9p82roU11s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9SIORnhqWtV0WH5Wt6dmCQf3T5F4sDEmpRFOwh3jViXg&oe=6A43ED25"}, "display_name": "Verto Studio VR", "keywords": ["3d", "modeling", "Creator", "art", "editor"], "long_description": "VertoStudio VR is a fully-capable 3D modeling studio designed to run entirely in VR!  You can use it to import FBX, OBJ, DAE (and more) directly in front of you, then configure every aspect of the visual display of these scenes directly down to the individual polygons. \n\nWhether you are mocking up a quick VR workflow, or designing production VR environments, this tool eliminates all of the pipeline complexity involved with getting 3D assets and content into VR quickly. Using Verto Studio, there is no more guesswork in designing for VR. ", "short_description": "VertoStudio VR is a fully-capable 3D modeling studio designed to run entirely in VR!  You can use it to import FBX, OBJ, DAE (and more) directly in front of you, then configure every aspect of the visual display of these scenes directly down to the individual polygons. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://vertostudio.com/pub/legal_and_priv_policy_holo.pdf", "developer_terms_of_service_url": null, "publisher_name": "VERTO STUDIO LLC", "support_website_url": null, "website_url": "https://vertostudio.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY", "EDUCATIONAL", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8365527463494815"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75622016_1000402328502792_7424357689205527073_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JxUmHao4RAMQ7kNvwEbwrd8&_nc_oc=AdqausfYXGBurB3G09_5zSs0Q1lIT3lqkd7ySyH-aKgJIh_2Hoyigc29ffvxlz7gc5I&_nc_
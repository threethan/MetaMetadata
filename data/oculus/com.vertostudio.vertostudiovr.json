84_123993829622586_3071525568216661453_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CI8DypGWSsAQ7kNvwE7bP4X&_nc_oc=Adoln7x_c2yzpe6zUDVNU34BYFzqj3ZmFiLHzvRXB00ku7n2GaYhip0ovSbNVH2fB6o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxYLsu-U12ebr2JlGlKvjafVhoNAY-Jp25NBju98d5RA&oe=6AAAA5F7"}, {"file_name": "quest_store_ss5.png", "id": "451607189360258", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974738_451607192693591_5264901383228771667_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y5HoCbXf6lAQ7kNvwEoHRy-&_nc_oc=AdoT6RA2d1vREjKqtPo-EZiKbcH5cVkjFtHOyu2zzTlxaHzarCiLDKf1Cw6_7-2fhzk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9rsttf_hvDol-v_swKqupagB8Gfif53eegJSfJg1Ccw&oe=6AAAAB16"}, {"file_name": "quest_store_ss1.png", "id": "1061720087646878", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974908_1061720090980211_61566680048714381_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uzLsA3bsXysQ7kNvwE5Qsds&_nc_oc=Adp6fNpa5BbpSQ_CLKywiffeh8cvx3bn0dBmEkD9uS7ANq2TB5pykieatfl0vEX5vfs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXnuG7g1rwPH_TN7qnqqKlyvanvCAK1Azf4pRn4qfd8A&oe=6AAA9C5E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "quest_store_promo_cover.png", "id": "417340956009330", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031495_417340959342663_8025418479443864112_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bsG0z36TA9UQ7kNvwHA2BE0&_nc_oc=AdpaEtvBGSWBz_CdAd1dnMQNFKzCn9QVVQwwx-pWN2gpK7mcIfxBacTf1pz0E3xlo6E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJmn_uQcVhi-uo0gn6p5vK6qXW0CcFHZLX0reJICvL7MA&oe=6AAA89E5"}, "display_name": "Verto Studio VR", "keywords": ["3d", "modeling", "Creator", "art", "editor"], "long_description": "VertoStudio VR is a fully-capable 3D modeling studio designed to run entirely in VR!  You can use it to import FBX, OBJ, DAE (and more) directly in front of you, then configure every aspect of the visual display of these scenes directly down to the individual polygons. \n\nWhether you are mocking up a quick VR workflow, or designing production VR environments, this tool eliminates all of the pipeline complexity involved with getting 3D assets and content into VR quickly. Using Verto Studio, there is no more guesswork in designing for VR. ", "short_description": "VertoStudio VR is a fully-capable 3D modeling studio designed to run entirely in VR!  You can use it to import FBX, OBJ, DAE (and more) directly in front of you, then configure every aspect of the visual display of these scenes directly down to the individual polygons. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://vertostudio.com/pub/legal_and_priv_policy_holo.pdf", "developer_terms_of_service_url": null, "publisher_name": "VERTO STUDIO LLC", "support_website_url": null, "website_url": "https://vertostudio.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY", "EDUCATIONAL", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8365527463494815"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75622016_1000402328502792_7424357689205527073_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ubDIksh_iXEQ7kNvwE98nz3&_nc_oc=AdqyHA20CN9VvIkMCVOy-LTrB6DsZPN90osn-t_XeWQCgMWe1NvW2hWvls1q-2wBz5U&_nc_
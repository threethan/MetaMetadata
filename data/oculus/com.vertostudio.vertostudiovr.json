t_store_ss1.png", "id": "1061720087646878", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974908_1061720090980211_61566680048714381_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cF5yXzbNBxIQ7kNvwEXLID8&_nc_oc=AdkcOlw0_f0UiHI2HCbScgiQ2T-LdB-CY7htAr7f23QGR0xQZcIDzd84wQWwB3Zfwhk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwZnoHzCSGrhMD-wE6vcwhfh5fgvv3PjDnxufSqLuuoJQ&oe=69BD4E5E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "quest_store_promo_cover.png", "id": "417340956009330", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031495_417340959342663_8025418479443864112_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=04w3eBQaSyAQ7kNvwH0GPkw&_nc_oc=AdnTZAfcCnZVDnQDrXLhBW1S9Pkr99SQiFjl40QdOJfKACv_xHsXDzGBXhlgqdT_Lps&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfweEfuEV6HsFf1vPCGimxCLeDSwYt0WbjLpP6mbvs-7xQ&oe=69BD3BE5"}, "display_name": "Verto Studio VR", "keywords": [], "long_description": "VertoStudio VR is a fully-capable 3D modeling studio designed to run entirely in VR!  You can use it to import FBX, OBJ, DAE (and more) directly in front of you, then configure every aspect of the visual display of these scenes directly down to the individual polygons. \n\nWhether you are mocking up a quick VR workflow, or designing production VR environments, this tool eliminates all of the pipeline complexity involved with getting 3D assets and content into VR quickly. Using Verto Studio, there is no more guesswork in designing for VR. ", "short_description": "VertoStudio VR is a fully-capable 3D modeling studio designed to run entirely in VR!  You can use it to import FBX, OBJ, DAE (and more) directly in front of you, then configure every aspect of the visual display of these scenes directly down to the individual polygons. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://vertostudio.com/pub/legal_and_priv_policy_holo.pdf", "developer_terms_of_service_url": null, "publishe
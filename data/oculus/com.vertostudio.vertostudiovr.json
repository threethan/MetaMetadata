84_123993829622586_3071525568216661453_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-5HcC3eJaH4Q7kNvwFnL6Uf&_nc_oc=AdpVdoy0fZURKcFReGI4IZUcD23lMC-_46gkH0zA9Wncv-0jNU8LGDaUZbCPgH7AXAA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9zxmxQ7UNnzowX1bSn1ZpI_SgUcAgEKOgfh2bbhyyPag&oe=6A47C577"}, {"file_name": "quest_store_ss5.png", "id": "451607189360258", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974738_451607192693591_5264901383228771667_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cmx-vwRfIjsQ7kNvwHcx4e2&_nc_oc=Adrg4tyI7J56b6YDdmYHu-YFbZyR-l0_GhiFDJsqzvCPEQgurBC4zUVlrAkDV3iAoWM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ZNEJ53gPw87bZmwLJtoUBAuf4pTqkddnwoGWkJvN9UA&oe=6A47CA96"}, {"file_name": "quest_store_ss1.png", "id": "1061720087646878", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974908_1061720090980211_61566680048714381_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0xs0yklHIcEQ7kNvwFX--Q6&_nc_oc=AdqXHDdq9UOheO5aySnSRpv8rODQzqNFaynow1eAbN1oH_L3E-LZ4jSX1WvcQxtsJ6Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-vzcDp8VFIGiDEDhjBrZjmk6HijtYY25WypQMEmwtD4w&oe=6A47BBDE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "quest_store_promo_cover.png", "id": "417340956009330", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031495_417340959342663_8025418479443864112_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bFdQEIlQPqgQ7kNvwHWyEWk&_nc_oc=AdrFqdh1Jxsb7kBNNzRCzlXLfARkhxUxA7w-kZfkX3rZk44SJDgQnaYV1sLwe_iRLSc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_j8UutzZp4Y5nxV_0Nhmr5mRNJy011TmwuzbkDhgU9yg&oe=6A47E1A5"}, "display_name": "Verto Studio VR", "keywords": ["3d", "modeling", "Creator", "art", "editor"], "long_description": "VertoStudio VR is a fully-capable 3D modeling studio designed to run entirely in VR!  You can use it to import FBX, OBJ, DAE (and more) directly in front of you, then configure every aspect of the visual display of these scenes directly down to the individual polygons. \n\nWhether you are mocking up a quick VR workflow, or designing production VR environments, this tool eliminates all of the pipeline complexity involved with getting 3D assets and content into VR quickly. Using Verto Studio, there is no more guesswork in designing for VR. ", "short_description": "VertoStudio VR is a fully-capable 3D modeling studio designed to run entirely in VR!  You can use it to import FBX, OBJ, DAE (and more) directly in front of you, then configure every aspect of the visual display of these scenes directly down to the individual polygons. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://vertostudio.com/pub/legal_and_priv_policy_holo.pdf", "developer_terms_of_service_url": null, "publisher_name": "VERTO STUDIO LLC", "support_website_url": null, "website_url": "https://vertostudio.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY", "EDUCATIONAL", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8365527463494815"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75622016_1000402328502792_7424357689205527073_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bCXynG2GQ7MQ7kNvwHRAPEs&_nc_oc=AdrVeShiFLV_ZUKtsw1WvoG1JT8-ZayvxiqW1ssS6XyQvlJ32q-dOoiIV_f8G2AZ-f8&_nc_
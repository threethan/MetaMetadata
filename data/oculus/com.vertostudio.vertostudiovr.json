84_123993829622586_3071525568216661453_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uS1cb6kH4JsQ7kNvwHiQb3X&_nc_oc=AdrtjKwEN6mtLkJQF1T0L_hc_fXwPAdo5yp9QeNcg3NLqhDAOGf08_7fEHY67o3l0kk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxNmDO70ithliPGv2pjhOyRzMFnm5LN9DdYYWzthBpiVw&oe=69C69277"}, {"file_name": "quest_store_ss5.png", "id": "451607189360258", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974738_451607192693591_5264901383228771667_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7DAIZnpkBbgQ7kNvwEZUJ-B&_nc_oc=Adpum9qnym8vWxPO8L5BiJ41dO1znmojQA-XlVbBbdpJW38Iex_ukvBl1qGNSBdE1A0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzIzM9Jofo1C1mM6cUz9hut3Jrc1kKk8vI-oiSlufyIXA&oe=69C69796"}, {"file_name": "quest_store_ss1.png", "id": "1061720087646878", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974908_1061720090980211_61566680048714381_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=odThoYPePV8Q7kNvwFaGU5r&_nc_oc=AdrRVFUBkAHLdmmkD5gh7gxkB_AgAqoxCMjBiD2Lr5dLKnxEud_4LZUjRdTCIbvG6kk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxECUf1hna2OQZ4hBbTvXovTKDQp0T9VKe9G7YzNe-uUA&oe=69C688DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "quest_store_promo_cover.png", "id": "417340956009330", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031495_417340959342663_8025418479443864112_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=90p9WGDG7VAQ7kNvwENcM-a&_nc_oc=AdrankEkNN2khxe4sTCCmENpDMNz9jqxIrjNpd5SDr0hrnkCoTd1A9VsDXHEtEIb684&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxp6rgQ9F8sazRJ5nHZm2jctGQZ6eBdER98fNUQmaHpuw&oe=69C67665"}, "display_name": "Verto Studio VR", "keywords": ["3d", "modeling", "Creator", "art", "editor"], "long_description": "VertoStudio VR is a fully-capable 3D modeling studio designed to run entirely in VR!  You can use it to import FBX, OBJ, DAE (and more) directly in front of you, then configure every aspect of the visual display of these scenes directly down to the individual polygons. \n\nWhether you are mocking up a quick VR workflow, or designing production VR environments, this tool eliminates all of the pipeline complexity involved with getting 3D assets and content into VR quickly. Using Verto Studio, there is no more guesswork in designing for VR. ", "short_description": "VertoStudio VR is a fully-capable 3D modeling studio designed to run entirely in VR!  You can use it to import FBX, OBJ, DAE (and more) directly in front of you, then configure every aspect of the visual display of these scenes directly down to the individual polygons. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://vertostudio.com/pub/legal_and_priv_policy_holo.pdf", "developer_terms_of_service_url": null, "publisher_name": "VERTO STUDIO LLC", "support_website_url": null, "website_url": "https://vertostudio.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY", "EDUCATIONAL", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8365527463494815"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75622016_1000402328502792_7424357689205527073_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gcuDah6pQOkQ7kNvwFvR6hT&_nc_oc=Adr8cLJrIG7xlkc_oFRemfTfgT2oNWSR9psxvzzq0nbDEaQzM3AWJnhwzyQ_hejL7Vk&_nc_
84_123993829622586_3071525568216661453_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lNAw78rqI44Q7kNvwHAv4IQ&_nc_oc=AdoziEEqkzRXQzX8h-UVIw-WmJTK4NLqypb4KqhMaW9LuUYIiRpUgrX-z6-6NQTer3k&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2IOdp5lfcTgF1yXxzZp_RZBS1SBl4yllfuh5lUe2TagQ&oe=69F36577"}, {"file_name": "quest_store_ss5.png", "id": "451607189360258", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974738_451607192693591_5264901383228771667_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lvtFlBZgkvkQ7kNvwEJ7zJe&_nc_oc=AdrBYsTpzWDePuGdcKAsqkcoB3mxAiSYLhY8Va-o8vEmWvzPL53MUC2Fgnv1CF3Traw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1ruj6Suyan9pv-r7SjQXmwe2DLBBE9cU2xd80nWh6IGw&oe=69F36A96"}, {"file_name": "quest_store_ss1.png", "id": "1061720087646878", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974908_1061720090980211_61566680048714381_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1DwQIB7XqJcQ7kNvwHPG-Ng&_nc_oc=AdoS82fs-Uu--zQGaV5gYNo97VorcFaAoGklzIz9AYyh104E6NsN2IsogEuXfB6iNOg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3qNrY7I7XpiXETh7npgQiFwc2QJGpqUrfSeloTu69V0A&oe=69F35BDE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "quest_store_promo_cover.png", "id": "417340956009330", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031495_417340959342663_8025418479443864112_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LAJXT9f2DVoQ7kNvwE0CGX0&_nc_oc=AdrnubSrNz0ucBi4o2msm5QVpW_MtIbollhH7dXlpwE4K1odNMZpm1bbiozoDOuvAG0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1lzZj1EZsaMJGfneC7ruNvN6hze4wM1XTR9a0TdVPo7Q&oe=69F34965"}, "display_name": "Verto Studio VR", "keywords": ["3d", "modeling", "Creator", "art", "editor"], "long_description": "VertoStudio VR is a fully-capable 3D modeling studio designed to run entirely in VR!  You can use it to import FBX, OBJ, DAE (and more) directly in front of you, then configure every aspect of the visual display of these scenes directly down to the individual polygons. \n\nWhether you are mocking up a quick VR workflow, or designing production VR environments, this tool eliminates all of the pipeline complexity involved with getting 3D assets and content into VR quickly. Using Verto Studio, there is no more guesswork in designing for VR. ", "short_description": "VertoStudio VR is a fully-capable 3D modeling studio designed to run entirely in VR!  You can use it to import FBX, OBJ, DAE (and more) directly in front of you, then configure every aspect of the visual display of these scenes directly down to the individual polygons. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://vertostudio.com/pub/legal_and_priv_policy_holo.pdf", "developer_terms_of_service_url": null, "publisher_name": "VERTO STUDIO LLC", "support_website_url": null, "website_url": "https://vertostudio.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY", "EDUCATIONAL", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8365527463494815"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75622016_1000402328502792_7424357689205527073_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u4AJrgzoG4MQ7kNvwHKfJOk&_nc_oc=AdoSYpc-7Jcv8jBHGAgeEDOTn_Il05Pa78ForyyPG8tIRDG_GAIvI6rk9DSFTPGN97o&_nc_
84_123993829622586_3071525568216661453_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c85_czsNm3AQ7kNvwH0nwNY&_nc_oc=AdoeCidZicyUUIx78s-8mTwRMVmCPqcGt4X1l6_C7Y0I3htO-oO6vsIIDdANnHabVHE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD1PMRoF-yAW_6tA45nrJdrUuTcoa9wYzKnIXkuyX0_Rw&oe=6A53A2F7"}, {"file_name": "quest_store_ss5.png", "id": "451607189360258", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974738_451607192693591_5264901383228771667_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yerMW8V_HW0Q7kNvwH5LlLv&_nc_oc=AdpOt3DT-GB6eqEER-e0pCwNh7egPQmgM4MKwQTQvI0IGBHM3leenorZQW3iiS8EPEs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDRKVH0T7oLCIqXIv1vl_n9b9JsyTH8Yj4TC873NUeUPg&oe=6A53A816"}, {"file_name": "quest_store_ss1.png", "id": "1061720087646878", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974908_1061720090980211_61566680048714381_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KObFb_kIFKsQ7kNvwGcahZ4&_nc_oc=AdrFXl5TPiLM1GpD16y-A8Cinr8ptOFtaSNKe8p5mv818mLlCc00j-z0LMK9lTxWnX0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBbbDzTGroo7QaHTLcTpSkDxtH9hhhF9QTmL43PR-T-CQ&oe=6A53995E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "quest_store_promo_cover.png", "id": "417340956009330", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031495_417340959342663_8025418479443864112_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ABgVuMqqtGcQ7kNvwGkEB_J&_nc_oc=AdoAO_iKMVf9r__hvRANQC4QnR_6cxzEzQwjiaubxP99hVkK2a_VZ4qlZZdvJjPlMK4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBz1OPp2wLVWfKndlhVYInKhtZH6jUqcZSCGMbLypo1nA&oe=6A5386E5"}, "display_name": "Verto Studio VR", "keywords": ["3d", "modeling", "Creator", "art", "editor"], "long_description": "VertoStudio VR is a fully-capable 3D modeling studio designed to run entirely in VR!  You can use it to import FBX, OBJ, DAE (and more) directly in front of you, then configure every aspect of the visual display of these scenes directly down to the individual polygons. \n\nWhether you are mocking up a quick VR workflow, or designing production VR environments, this tool eliminates all of the pipeline complexity involved with getting 3D assets and content into VR quickly. Using Verto Studio, there is no more guesswork in designing for VR. ", "short_description": "VertoStudio VR is a fully-capable 3D modeling studio designed to run entirely in VR!  You can use it to import FBX, OBJ, DAE (and more) directly in front of you, then configure every aspect of the visual display of these scenes directly down to the individual polygons. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://vertostudio.com/pub/legal_and_priv_policy_holo.pdf", "developer_terms_of_service_url": null, "publisher_name": "VERTO STUDIO LLC", "support_website_url": null, "website_url": "https://vertostudio.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY", "EDUCATIONAL", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8365527463494815"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75622016_1000402328502792_7424357689205527073_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gsz53MWNcFkQ7kNvwEjmy1U&_nc_oc=AdpJQzXR3FZMW4Z4JxqpgkH98-iUkWL73NmIHR0SYNAB_PBLzT0fz5t4YaREoFSMFcQ&_nc_
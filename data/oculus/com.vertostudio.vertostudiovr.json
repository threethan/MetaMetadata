84_123993829622586_3071525568216661453_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cqYbjglqoxkQ7kNvwECMQk-&_nc_oc=AdrKL4MCbiBat_1mcCU_he7EViXWiuSE7y78yrIzH2RXyhv60Lt2scrNGPy_VOXMWj8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0Y8wePGp140eyykvP7lttlJ4KDX64s0jY0xhr6sJMw5g&oe=69F8AB77"}, {"file_name": "quest_store_ss5.png", "id": "451607189360258", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974738_451607192693591_5264901383228771667_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WLH4OYf-vMUQ7kNvwFyPRSC&_nc_oc=AdoTQL9cnD5p10Q_i05hVuoQ3bBFYTHH9I2g5DgUAgRdK2DGigv1ivmPdDBFZoRiYs4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3NSdqxC1sQ4oIvfgTM5_rJnl_u8ZPcOy5TCZsr0RzW0w&oe=69F8B096"}, {"file_name": "quest_store_ss1.png", "id": "1061720087646878", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974908_1061720090980211_61566680048714381_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nhv0J7ygBk4Q7kNvwHFOthL&_nc_oc=Adrj3U431NwVa16BcxnYKI1e5tKkeAZY9quSnQwkS-QgPoxRYth-eC8Fr8nmFp9d4Zs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2_rqHy3sLUzUiATXJxazTJw0V4oT2NunDK8vK3vslq6g&oe=69F8A1DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "quest_store_promo_cover.png", "id": "417340956009330", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031495_417340959342663_8025418479443864112_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RtPCLzXdJL8Q7kNvwEIZp_4&_nc_oc=AdruISaNb8syqB92BtGtZzvDqAgt-SX8UeFIcP0Pebf5x1j9gQ5HagL_oXGcRNh1Wd8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0e_SPeHf36u-jXPY721qgUdLkP98wtNDuBccOfga9i5g&oe=69F88F65"}, "display_name": "Verto Studio VR", "keywords": ["3d", "modeling", "Creator", "art", "editor"], "long_description": "VertoStudio VR is a fully-capable 3D modeling studio designed to run entirely in VR!  You can use it to import FBX, OBJ, DAE (and more) directly in front of you, then configure every aspect of the visual display of these scenes directly down to the individual polygons. \n\nWhether you are mocking up a quick VR workflow, or designing production VR environments, this tool eliminates all of the pipeline complexity involved with getting 3D assets and content into VR quickly. Using Verto Studio, there is no more guesswork in designing for VR. ", "short_description": "VertoStudio VR is a fully-capable 3D modeling studio designed to run entirely in VR!  You can use it to import FBX, OBJ, DAE (and more) directly in front of you, then configure every aspect of the visual display of these scenes directly down to the individual polygons. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://vertostudio.com/pub/legal_and_priv_policy_holo.pdf", "developer_terms_of_service_url": null, "publisher_name": "VERTO STUDIO LLC", "support_website_url": null, "website_url": "https://vertostudio.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY", "EDUCATIONAL", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8365527463494815"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75622016_1000402328502792_7424357689205527073_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EfwUY0RCrHgQ7kNvwHwNYmF&_nc_oc=Adrt3IL9uqArVdNE_IvT5-hkUSw_OrKmsl3izM9YavT2O5Lm4ZoI3SMACLITPgignlQ&_nc_
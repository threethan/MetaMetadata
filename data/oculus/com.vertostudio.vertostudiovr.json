84_123993829622586_3071525568216661453_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v6LtyzXzgG0Q7kNvwHOBYTf&_nc_oc=AdoOl6qaJ_YgS4uTN-nNOQMjX0f35Vry1jpmgzf25eUI2ElawcGcw9hJqh0D0jNsKoU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH75hr2V3hOnOiVTOCOzE3ssGvGZT6UgygYZY7KIiwdtA&oe=6A803DB7"}, {"file_name": "quest_store_ss5.png", "id": "451607189360258", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974738_451607192693591_5264901383228771667_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PQ0VWmZS3FIQ7kNvwGstkNz&_nc_oc=Adqms2v2HNVHzIDDo9BfRnazgV2hUc7b-zNWYZ2rT_-WNkPco341kRfY0dnzMpaiELM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6N2zjWxo6ztgKdRefwZKw65yx9joL8Hmb92B81EhVsg&oe=6A8042D6"}, {"file_name": "quest_store_ss1.png", "id": "1061720087646878", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974908_1061720090980211_61566680048714381_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YzLtmxHWoj4Q7kNvwEgqQp_&_nc_oc=AdoHfHrv-Cn9x64Rk2mfRk-3oKXo-5T4RH6quncBTNWG6JohYWw3BzVPIGtkqJPuLdk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEUqMoR_v5E2MBQyq3ffjhAfpYMfQHk-Y8aTt-XxCkZQQ&oe=6A806C5E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "quest_store_promo_cover.png", "id": "417340956009330", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031495_417340959342663_8025418479443864112_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-vfUY3EguJUQ7kNvwGztVW5&_nc_oc=AdoCa7sdARL_-3lsJRl-MRFvthhfABm8PdkcV4ENgpvoF2bc9ZdHmWZjmPqIANCReh4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgOaQDFGIW2PyOzTgEaW3XcfnYTZKjfR-0EHdiakx6qA&oe=6A8059E5"}, "display_name": "Verto Studio VR", "keywords": ["3d", "modeling", "Creator", "art", "editor"], "long_description": "VertoStudio VR is a fully-capable 3D modeling studio designed to run entirely in VR!  You can use it to import FBX, OBJ, DAE (and more) directly in front of you, then configure every aspect of the visual display of these scenes directly down to the individual polygons. \n\nWhether you are mocking up a quick VR workflow, or designing production VR environments, this tool eliminates all of the pipeline complexity involved with getting 3D assets and content into VR quickly. Using Verto Studio, there is no more guesswork in designing for VR. ", "short_description": "VertoStudio VR is a fully-capable 3D modeling studio designed to run entirely in VR!  You can use it to import FBX, OBJ, DAE (and more) directly in front of you, then configure every aspect of the visual display of these scenes directly down to the individual polygons. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://vertostudio.com/pub/legal_and_priv_policy_holo.pdf", "developer_terms_of_service_url": null, "publisher_name": "VERTO STUDIO LLC", "support_website_url": null, "website_url": "https://vertostudio.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY", "EDUCATIONAL", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8365527463494815"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75622016_1000402328502792_7424357689205527073_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WRaQaqLisnkQ7kNvwEaM2HW&_nc_oc=AdriT0_Rje6fahVPiCiM1bknFxn4tX9kez0N1a4ymf8UUVj8UUBYsd5NnnvdT85tCG0&_nc_
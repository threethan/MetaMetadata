84_123993829622586_3071525568216661453_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s56u0sklq5oQ7kNvwH8nuo0&_nc_oc=AdpSwruuk0_5ldm0GgXGW8KWisRVoI47PHOchpQ4x15xudlBMlbsgMBv0Kry7Rq-FaE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9M9WHuM-F4nDv6kN1AbraAA5ydebdY_tRqDBbJZMnmDA&oe=6A3A9677"}, {"file_name": "quest_store_ss5.png", "id": "451607189360258", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974738_451607192693591_5264901383228771667_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=flYYuLdaUl0Q7kNvwHayutN&_nc_oc=Adp9PLCTaDjnH5J8DIRaiChrTumlw4avRRQsTm-oQKmfGZoPjYmpwdz6qasiquYbQdQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_AiRGIvOis_cEEWI8jfqDBcGz1NGqb6N6q3dQXkmfyxw&oe=6A3A9B96"}, {"file_name": "quest_store_ss1.png", "id": "1061720087646878", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974908_1061720090980211_61566680048714381_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XZpu_QX2L64Q7kNvwG5ZXl9&_nc_oc=Adr68TYksrCGlzsSHmtd3wJHUmUEssF_ATV23v6rbfdrdKYpSBLZ303G4kYhJ19r1go&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__sM2A7SfMDO2QiUg5tFPpaRV4YcFjp2sVMYT06IaHTQ&oe=6A3A8CDE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "quest_store_promo_cover.png", "id": "417340956009330", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031495_417340959342663_8025418479443864112_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b5zy1rAlGIMQ7kNvwEocRAQ&_nc_oc=AdrLOxBuuWfgF0xtjDQe28tx_NwOMWZTzCgRx4dEb0n98-5L5Cyh2d8iRjuuoU38818&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80K15ApxMfuMrwNNM7XHmS_iRxQb4t33jqfDytvd-gSw&oe=6A3AB2A5"}, "display_name": "Verto Studio VR", "keywords": ["3d", "modeling", "Creator", "art", "editor"], "long_description": "VertoStudio VR is a fully-capable 3D modeling studio designed to run entirely in VR!  You can use it to import FBX, OBJ, DAE (and more) directly in front of you, then configure every aspect of the visual display of these scenes directly down to the individual polygons. \n\nWhether you are mocking up a quick VR workflow, or designing production VR environments, this tool eliminates all of the pipeline complexity involved with getting 3D assets and content into VR quickly. Using Verto Studio, there is no more guesswork in designing for VR. ", "short_description": "VertoStudio VR is a fully-capable 3D modeling studio designed to run entirely in VR!  You can use it to import FBX, OBJ, DAE (and more) directly in front of you, then configure every aspect of the visual display of these scenes directly down to the individual polygons. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://vertostudio.com/pub/legal_and_priv_policy_holo.pdf", "developer_terms_of_service_url": null, "publisher_name": "VERTO STUDIO LLC", "support_website_url": null, "website_url": "https://vertostudio.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY", "EDUCATIONAL", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8365527463494815"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75622016_1000402328502792_7424357689205527073_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I4bk9mdMZz8Q7kNvwGFXina&_nc_oc=AdqiJYcpU9OhBXmOqW8y1LNcU_GBCRISEZ_5bEQUTOR4BOo3i1sAozZGe3dFxnmnbnc&_nc_
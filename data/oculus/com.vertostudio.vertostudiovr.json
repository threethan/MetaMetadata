84_123993829622586_3071525568216661453_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T2YJWqoA0jIQ7kNvwELf6Xa&_nc_oc=Ador8Idjwc8PllbbNoVRknNOpAvNR1N4tqQAvvHMfytuuXEPMn6prAoSM3S25mLcGJY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKg5fxAgW1EAVM83AZvWvNQK7FPmTluCajHD5ckMPeCxA&oe=6AA55FF7"}, {"file_name": "quest_store_ss5.png", "id": "451607189360258", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974738_451607192693591_5264901383228771667_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9XloxqrtomUQ7kNvwFtbO5e&_nc_oc=AdqN15F8V3WXatD-DUivPgtBfVHny-YSZqbHIIqlZe1xpqRJ47AgYqKMlWDSM2JKhDk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLO4LHBm_pjBiRQulpo_3zOo9oIj-Z7l-mgnVFcxbFPEw&oe=6AA56516"}, {"file_name": "quest_store_ss1.png", "id": "1061720087646878", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974908_1061720090980211_61566680048714381_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LTNvFptuYZ4Q7kNvwF_S9MO&_nc_oc=AdroNqH_d0bK9jGkb56bd0kvJ9j2S_Pr2ypkpRSs1Fkpe8M-dtTOdhK0r5CoPuFhPuQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9BDGysprmFGrmJOiwGFdHjTkoCN3x4GdH8dXuZ00NoA&oe=6AA5565E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "quest_store_promo_cover.png", "id": "417340956009330", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031495_417340959342663_8025418479443864112_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5kPR0utZDl8Q7kNvwGlQvv9&_nc_oc=AdrYi3aOy-qT2uhNU31tjOdrP6MDfDlTNEZnZLQU6H57Jkf8fBi-dxNEl20l74RRD9Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJaA_m3TuW5TH0_mj-LGVSjtjE27dfNGh6xA9N8LlyDLg&oe=6AA543E5"}, "display_name": "Verto Studio VR", "keywords": ["3d", "modeling", "Creator", "art", "editor"], "long_description": "VertoStudio VR is a fully-capable 3D modeling studio designed to run entirely in VR!  You can use it to import FBX, OBJ, DAE (and more) directly in front of you, then configure every aspect of the visual display of these scenes directly down to the individual polygons. \n\nWhether you are mocking up a quick VR workflow, or designing production VR environments, this tool eliminates all of the pipeline complexity involved with getting 3D assets and content into VR quickly. Using Verto Studio, there is no more guesswork in designing for VR. ", "short_description": "VertoStudio VR is a fully-capable 3D modeling studio designed to run entirely in VR!  You can use it to import FBX, OBJ, DAE (and more) directly in front of you, then configure every aspect of the visual display of these scenes directly down to the individual polygons. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://vertostudio.com/pub/legal_and_priv_policy_holo.pdf", "developer_terms_of_service_url": null, "publisher_name": "VERTO STUDIO LLC", "support_website_url": null, "website_url": "https://vertostudio.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY", "EDUCATIONAL", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8365527463494815"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75622016_1000402328502792_7424357689205527073_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n2xiHnWUcGMQ7kNvwGAXOuH&_nc_oc=AdrZsITYxGh83MAjI-KSD_vXVMYKOJpiZJL-AbkNJ7x_99Paa8lfdcGl2DbXQU26q6I&_nc_
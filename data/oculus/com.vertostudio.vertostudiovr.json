84_123993829622586_3071525568216661453_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ktB0flvOPxgQ7kNvwF2Oh07&_nc_oc=Adphq1pUQb6GjYInQZ9A4vqpuRO5Q0e8L-Ncs4boSadJ9JqPd0imY6LTpaZYbxg8ss0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzvUZTpkaeykvuFMZZt5sxRATG1D_5vcSWsUS1rBe6xQ&oe=6AF9BFF7"}, {"file_name": "quest_store_ss5.png", "id": "451607189360258", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974738_451607192693591_5264901383228771667_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sjeLtDF94cIQ7kNvwF38S8-&_nc_oc=AdruTLAD2-7-mJYcGoaCyYxPWYBrSQJu5bZmPOVnmr9Qy1SYKib1qEaHmP4UEatjvkM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8owMnw4EzaKbvNMoDqX51-OROTAMJY0nQHzksrBvWnQ&oe=6AF9C516"}, {"file_name": "quest_store_ss1.png", "id": "1061720087646878", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974908_1061720090980211_61566680048714381_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tUkrkkwUpL8Q7kNvwGTqlep&_nc_oc=Adp5mz_-Fj8iI8gXHXLLWQfmC4lyDgJSEipAGXZiCy-KHVA2wHO8ErksvCSjBwo9VcU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR21xZf3aNQZXePNzmFiy0fECaJXjiko-xxi78pb7T7Vg&oe=6AF9B65E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "quest_store_promo_cover.png", "id": "417340956009330", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031495_417340959342663_8025418479443864112_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hFDHU2pj4-wQ7kNvwFiCYtu&_nc_oc=AdrR4bQ-lVHyQuAP4OEtAuW2UMeycUUZPuH4qif49i2FcPbig0D8VX-h8w3zNIrBjis&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWNXWm4ddyNQesdlGXtlPSC_Dy1LbUgXXITnfPgocCDQ&oe=6AF9DC25"}, "display_name": "Verto Studio VR", "keywords": ["3d", "modeling", "Creator", "art", "editor"], "long_description": "VertoStudio VR is a fully-capable 3D modeling studio designed to run entirely in VR!  You can use it to import FBX, OBJ, DAE (and more) directly in front of you, then configure every aspect of the visual display of these scenes directly down to the individual polygons. \n\nWhether you are mocking up a quick VR workflow, or designing production VR environments, this tool eliminates all of the pipeline complexity involved with getting 3D assets and content into VR quickly. Using Verto Studio, there is no more guesswork in designing for VR. ", "short_description": "VertoStudio VR is a fully-capable 3D modeling studio designed to run entirely in VR!  You can use it to import FBX, OBJ, DAE (and more) directly in front of you, then configure every aspect of the visual display of these scenes directly down to the individual polygons. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://vertostudio.com/pub/legal_and_priv_policy_holo.pdf", "developer_terms_of_service_url": null, "publisher_name": "VERTO STUDIO LLC", "support_website_url": null, "website_url": "https://vertostudio.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY", "EDUCATIONAL", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8365527463494815"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75622016_1000402328502792_7424357689205527073_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZLDYKC-Pe0wQ7kNvwFH8Iyh&_nc_oc=Adq9_h6lHGMQUHAMWHGIyT8yR1UBBAGfnvari0Vhl5qtw_SlkoCYejdS4G5crAtKuEU&_nc_
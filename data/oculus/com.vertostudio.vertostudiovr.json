84_123993829622586_3071525568216661453_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=osRIqT5pbVQQ7kNvwHpeAX5&_nc_oc=Adrhh7oGXKoT_grSUkcbm99iyAY9Wn-rNFVEC66VT8WTmyWKqyOBp0E9DAPWGmm3Bu4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9q87qkv1j5qljvMZJR6NvWaYRr72mTG07r-5hFihhplg&oe=6A3D3977"}, {"file_name": "quest_store_ss5.png", "id": "451607189360258", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974738_451607192693591_5264901383228771667_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=flYYuLdaUl0Q7kNvwEFr_wy&_nc_oc=AdpHX352vTTqypSVkPhbtpLndaBLLN_61g7u1o0WklB3jWFUqzNII8t6Py_RwqyXDfA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af87VjqfqUBR0zYbNV9Ad5rECWXsS6SrhcuKRNCs374uVA&oe=6A3D3E96"}, {"file_name": "quest_store_ss1.png", "id": "1061720087646878", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974908_1061720090980211_61566680048714381_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XZpu_QX2L64Q7kNvwF7gT8k&_nc_oc=AdpMSYEwxqNhoOEUqCueCKbQec7EGPyJMvMyy3sk7v3x6RDr1m0zkwwHT9z-OfJzCr0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jMbQZm_JXiDsLNI0y6FtxrHXeq34vbFLV64jCDbbjTg&oe=6A3D2FDE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "quest_store_promo_cover.png", "id": "417340956009330", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031495_417340959342663_8025418479443864112_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mIHI27W0Cy0Q7kNvwE2EpWu&_nc_oc=AdrLx2wCJ5uOZnJ8BMgf_n1ql0FSHeU_eb50L2NZfA9hOIcH0IolH9YG-YVt5gxzdu8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_OyCU5k9vvYn9bn4GztDoS1QZHmQZoO6flRWOffSW-7g&oe=6A3D55A5"}, "display_name": "Verto Studio VR", "keywords": ["3d", "modeling", "Creator", "art", "editor"], "long_description": "VertoStudio VR is a fully-capable 3D modeling studio designed to run entirely in VR!  You can use it to import FBX, OBJ, DAE (and more) directly in front of you, then configure every aspect of the visual display of these scenes directly down to the individual polygons. \n\nWhether you are mocking up a quick VR workflow, or designing production VR environments, this tool eliminates all of the pipeline complexity involved with getting 3D assets and content into VR quickly. Using Verto Studio, there is no more guesswork in designing for VR. ", "short_description": "VertoStudio VR is a fully-capable 3D modeling studio designed to run entirely in VR!  You can use it to import FBX, OBJ, DAE (and more) directly in front of you, then configure every aspect of the visual display of these scenes directly down to the individual polygons. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://vertostudio.com/pub/legal_and_priv_policy_holo.pdf", "developer_terms_of_service_url": null, "publisher_name": "VERTO STUDIO LLC", "support_website_url": null, "website_url": "https://vertostudio.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY", "EDUCATIONAL", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8365527463494815"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75622016_1000402328502792_7424357689205527073_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5VaYlKPN0nUQ7kNvwHl7CLE&_nc_oc=AdqTs_-pzh-MxibtoVoqT2Ar8Y64scL6XMvMnHXxP0kGT8t6ScmGPpIT0foxVRnYQgc&_nc_
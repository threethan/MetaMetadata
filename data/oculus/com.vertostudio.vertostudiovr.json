84_123993829622586_3071525568216661453_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Gy2ei6UxKEQ7kNvwHrLui5&_nc_oc=Adr6qw3_WKF4TFBZMg44ZX5NcJwIzKTCZBCk8oGOn8oppuFlQXsv62EsHt4QXEhhh6c&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5eHQQ-qjb5O_jI_NKUyXUveFGak4lGz_lJaIr-O0lrA&oe=6A974FF7"}, {"file_name": "quest_store_ss5.png", "id": "451607189360258", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974738_451607192693591_5264901383228771667_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iDtxjMGDh3MQ7kNvwGCbgED&_nc_oc=AdpsA246TD4_KqqjnlBZo4k084ln4kXB4D16I00Sef4YdW2547mYoRMy1imbdHooQkU&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFl6H4oMTeKUBvBge4EX2noMX-OF9I4EpdMfdSjhyJxaQ&oe=6A971CD6"}, {"file_name": "quest_store_ss1.png", "id": "1061720087646878", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974908_1061720090980211_61566680048714381_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_rswU89lvPcQ7kNvwH6EK2C&_nc_oc=Adq_vU0-St7debZL7yO2pxNEA5aj6FXJNIVzm_p7-CzW0sYb6vgWjHA1StUR-HfH4AY&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZFllnUVUI5qxe0yoC_IQM0H9hf39auOE_-YzG4ERpyg&oe=6A97465E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "quest_store_promo_cover.png", "id": "417340956009330", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39031495_417340959342663_8025418479443864112_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bDCVruV2Cf4Q7kNvwEAh4jm&_nc_oc=AdpB-fUyUkX42NwNHOhwYYZL4riiIPLkBdOEddJ8HYqGA38eg8OT6ymryB6QZckByNU&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6S2dUH9E4OtPzxIAozBOZ8ifNMmcQpfdRrQCgeJOxPg&oe=6A9733E5"}, "display_name": "Verto Studio VR", "keywords": ["3d", "modeling", "Creator", "art", "editor"], "long_description": "VertoStudio VR is a fully-capable 3D modeling studio designed to run entirely in VR!  You can use it to import FBX, OBJ, DAE (and more) directly in front of you, then configure every aspect of the visual display of these scenes directly down to the individual polygons. \n\nWhether you are mocking up a quick VR workflow, or designing production VR environments, this tool eliminates all of the pipeline complexity involved with getting 3D assets and content into VR quickly. Using Verto Studio, there is no more guesswork in designing for VR. ", "short_description": "VertoStudio VR is a fully-capable 3D modeling studio designed to run entirely in VR!  You can use it to import FBX, OBJ, DAE (and more) directly in front of you, then configure every aspect of the visual display of these scenes directly down to the individual polygons. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://vertostudio.com/pub/legal_and_priv_policy_holo.pdf", "developer_terms_of_service_url": null, "publisher_name": "VERTO STUDIO LLC", "support_website_url": null, "website_url": "https://vertostudio.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY", "EDUCATIONAL", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8365527463494815"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75622016_1000402328502792_7424357689205527073_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TdKUmcvnA5kQ7kNvwG0w0S6&_nc_oc=AdoqNB4qWAwHkmv7enPsvSeNmuTLiLnYj0CQeaft5_aGD3XDoXhSrTDTa7QLMfJ0434&_nc_
.com/v/t64.5771-25/38974769_2082709388701116_172541845736259584_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lCJvPJ_Mc4sQ7kNvwESc9pF&_nc_oc=AdnGScNKuGzSEXIZSSKr4Y9b4rQ9JWQ5TLAuIRKdmoIvVoI-Rd8IhwMtX4OA9jcERjY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwX7o5W-tJn38fY_3-fQFBLHlH1enXDjSJP0N9tNpN7Sw&oe=69BD4943"}, {"file_name": "migrated_image.png", "id": "656313315146310", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031581_2438837036345527_8452694246405701632_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=faJqviyXsPAQ7kNvwFuEEOu&_nc_oc=Admo-Z1dOPxXgD-I97bRfa2dU4I9X8n6Emno8StkymD2ZjzQnXHJuaWyllxpPUxaRu0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyjS2caS3O3euCYxl8lQnewJwdQ2EvqD3u-onupr3RDTA&oe=69BD28D1"}, {"file_name": "migrated_image.png", "id": "144944603554928", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974923_2286004728319041_840837365424455680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XUYM49ZmcnoQ7kNvwFquL1p&_nc_oc=Adkjrc8J2oPahz5VFoGHPnnExirlM_5ZbvaM2ScE6akkm1Ad12WRr8_NNYcTS3R0Roo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzxCQwNyI0MPFxgiuE2l1U8nLOZZaptIMN0CmeMYtPcMw&oe=69BD304B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/6nIlwd", "id": "352817115411667", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982580_352817118745000_2755083974056345600_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wsBVGjRoVbgQ7kNvwFC4r5D&_nc_oc=AdkwbfC9FuecvnYpWeykdcIIbPj2I89fWgL-_vpVCbSBDfrbkC2yTfrZewNCkD0KctE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxF6C2DI6UBMATUEVt_RtoZdCg4MZKJ4sivgRTWusy44w&oe=69BD2E4F"}, "display_name": "Sea Level Rise Explorer: Turner Station", "keywords": ["environment", "nature", "conservancy", "sea", "climate"], "long_description": "As coastal communities contend with sea level rise, coastal erosion, and other impacts of climate change, public education has become a critical piece of the puzzle., Virtual Planet Technologies produces highly creative and insightful experiences VR experiences that communities can use to better understand the impacts of climate change and explore emerging adaptation solutions. Our team has a range of expertise from climate scientists, city planners, communications experts, filmmakers, 3D animators, and Unity (software) developers. In our Sea Level Rise Explorer, users interact with 3D models and can raise sea levels to observe potential flooding in real time. Adaptation scenarios can also be displayed.", "short_description": "Virtual Planet\u2019s Sea Level Rise Explorer is a virtual reality experience that communities around the world can use to visualize the impacts from sea level rise and explore adaptation scenarios. Through powerful immersive digital experiences, our aim is to educate, drive action and inspire hope in the future of our planet. Our team has a range of expertise from climate scientists to digital artists and Unity developers."}]}, "developer_name": "Virtual Planet Technologies LLC", "developer_privacy_policy_url": "https://www.virtualplanet.tech/privacy-policy", "developer_terms_of_service_url": "http://virtualplanet.tech/", "publisher_name": "Virtual Planet Technologies LLC", "support_website_url": "http://virtualplanet.tech/", "website_url": "http://virtualplanet.tech/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "631290991418114"}}]}
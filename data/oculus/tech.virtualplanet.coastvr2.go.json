e_name": "migrated_image.png", "id": "801226080365272", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974526_459006321583559_2965587184591044608_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3NJuAQMa8dcQ7kNvwE5puLI&_nc_oc=AdnFustwNfCI8asr4on4rCX8pAPtO-efkf1cqFVDukhIBE9WvHo27BX1t3PYKjCEBuw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxo_ubn7krh70MMM_joA6uSBs_R8cSPEs5XrLvqm17JIw&oe=69BE8037"}, {"file_name": "migrated_image.png", "id": "786573695164536", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974769_2082709388701116_172541845736259584_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lCJvPJ_Mc4sQ7kNvwHHO-cY&_nc_oc=AdmfyS5CsEi2wAN4C-usSXLn63A8Uby1Zt1dHQdtXQUqlhk4zANcWCAS72T0PbXoc6Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxQNQnPvkOZ6qSpdzWwEVucZZH6_Zc1RgEdG2VWn6F1VQ&oe=69BE9AC3"}, {"file_name": "migrated_image.png", "id": "656313315146310", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031581_2438837036345527_8452694246405701632_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=faJqviyXsPAQ7kNvwHhdr7n&_nc_oc=AdkIySylBK5_J403pUomo86tcE63KZjTgWhhCYekqkFvTUq7V8oPcMHC9yFqtP5H0dw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz8m3ty0_t3u1flEfosmsC3X9dWvEA3vxCPqoNEicYTig&oe=69BE7A51"}, {"file_name": "migrated_image.png", "id": "144944603554928", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974923_2286004728319041_840837365424455680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3UtK_Ux5cnIQ7kNvwH9etpk&_nc_oc=AdkkK7auKmhOY39I8x5havzKpFOpKLgC-y76kXtLLBVxCrNzT71IF3SwMU_x3JlaxwU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwwbyAefdrikJeTDv1tsU1niFWxugGY2eh8KHtGR8jWlA&oe=69BE81CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/6nIlwd", "id": "352817115411667", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982580_352817118745000_2755083974056345600_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=atXRRfuhNFUQ7kNvwGG74RD&_nc_oc=Adn4W1EMms7tcLncoF1UxuY7xb8KOtmlQ2jOMv0L6v-YpfFM3NLlP3Mq2rKpufe8Bx4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwZgXa0sES1cl9xGjMJ-zmNwQ0WOSJFvVs3DY4LHXYrVA&oe=69BE7FCF"}, "display_name": "Sea Level Rise Explorer: Turner Station", "keywords": ["environment", "nature", "conservancy", "sea", "climate"], "long_description": "As coastal communities contend with sea level rise, coastal erosion, and other impacts of climate change, public education has become a critical piece of the puzzle., Virtual Planet Technologies produces highly creative and insightful experiences VR experiences that communities can use to better understand the impacts of climate change and explore emerging adaptation solutions. Our team has a range of expertise from climate scientists, city planners, communications experts, filmmakers, 3D animators, and Unity (software) developers. In our Sea Level Rise Explorer, users interact with 3D models and can raise sea levels to observe potential flooding in real time. Adaptation scenarios can also be displayed.", "short_description": "Virtual Planet\u2019s Sea Level Rise Explorer is a virtual reality experience that communities around the world can use to visualize the impacts from sea level rise and explore adaptation scenarios. Through powerful immersive digital experiences, our aim is to educate, drive action and inspire hope in the future of our planet. Our team has a range of expertise from climate scientists to digital artists and Unity developers."}]}, "developer_name": "Virtual Planet Technologies LLC", "developer_privacy_policy_url": "https://www.virtualplanet.tech/privacy-policy", "developer_terms_of_service_url": "http://virtualplanet.tech/", "publisher_name": "Virtual Planet Technologies LLC", "support_website_url": "http://virtualplanet.tech/", "website_url": "http://virtualplanet.tech/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": nu
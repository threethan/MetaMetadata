e": "migrated_image.png", "id": "786573695164536", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974769_2082709388701116_172541845736259584_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UsP5mKNz1WkQ7kNvwGoyy9h&_nc_oc=AdrW4uf0trgOK_W6ZxtBAz4KCZWqGW19MjvHRB_W-8mytozTKhqN4i6227jb-lvE2IU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-o7hK7e2JWijEYjrKU93Ov_ZOvJ0TeEKPsHzQBJ8gDZg&oe=6A241E43"}, {"file_name": "migrated_image.png", "id": "656313315146310", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031581_2438837036345527_8452694246405701632_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XxaayPvVxdkQ7kNvwGOQdGl&_nc_oc=AdoXR-aFt5Z5UtUeTdZkKun2yOyqQD2LhUnK3Rl49UPJM5tpWJ9WSDxcYrzsKMWSPjs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1vEwBXb_pr5OGfMni_x4TVCy3wBDBh9vlluHKoXVKzQ&oe=6A243611"}, {"file_name": "migrated_image.png", "id": "144944603554928", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974923_2286004728319041_840837365424455680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RPGvJ7z5KTwQ7kNvwH21iTy&_nc_oc=AdrutkHwb8QQ2Zzuby_mQWwOe8V0rfb3sCictZ63fmgIPdQqMW0F7uLDgMq4VmjNzfQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_lSHt3ls88AZ-4pS2Ma9KUHN4hDXpQPo-0BNKIC6saTg&oe=6A243D8B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/6nIlwd", "id": "352817115411667", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982580_352817118745000_2755083974056345600_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_a0VrWuif1sQ7kNvwFg4v9E&_nc_oc=Adq5bPNA8FLt0Py2UQNYHLdGn8WhRImDtGrqMIjcW5AoqeRpjFJwr80eQI0e1ZI0ZVI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8fMua68wBj5T4EEQ1EQExMNwN4E7W2WfwlG4RmlJ_pjw&oe=6A243B8F"}, "display_name": "Sea Level Rise Explorer: Turner Station", "keywords": ["environment", "nature", "conservancy", "sea", "climate"], "long_description": "As coastal communities contend with sea level rise, coastal erosion, and other impacts of climate change, public education has become a critical piece of the puzzle., Virtual Planet Technologies produces highly creative and insightful experiences VR experiences that communities can use to better understand the impacts of climate change and explore emerging adaptation solutions. Our team has a range of expertise from climate scientists, city planners, communications experts, filmmakers, 3D animators, and Unity (software) developers. In our Sea Level Rise Explorer, users interact with 3D models and can raise sea levels to observe potential flooding in real time. Adaptation scenarios can also be displayed.", "short_description": "Virtual Planet\u2019s Sea Level Rise Explorer is a virtual reality experience that communities around the world can use to visualize the impacts from sea level rise and explore adaptation scenarios. Through powerful immersive digital experiences, our aim is to educate, drive action and inspire hope in the future of our planet. Our team has a range of expertise from climate scientists to digital artists and Unity developers."}]}, "developer_name": "Virtual Planet Technologies LLC", "developer_privacy_policy_url": "https://www.virtualplanet.tech/privacy-policy", "developer_terms_of_service_url": "http://virtualplanet.tech/", "publisher_name": "Virtual Planet Technologies LLC", "support_website_url": "http://virtualplanet.tech/", "website_url": "http://virtualplanet.tech/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes"
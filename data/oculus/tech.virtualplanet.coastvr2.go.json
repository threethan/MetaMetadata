6B0DC7D1"}, {"file_name": "migrated_image.png", "id": "144944603554928", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974923_2286004728319041_840837365424455680_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VBz62j7li0YQ7kNvwE0EwNN&_nc_oc=Adrq-4iDxLKUR7bnXg4EB-Mr6DM9T3O8i4xIF-QAYRadZDOZS314S223Z3Vf0FNe-R0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQxcPSW2Cc3QMR-GQAa-Vwr9uGSFw2yx0JFtOZtuhNttw&oe=6B0DCF4B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/6nIlwd", "id": "352817115411667", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982580_352817118745000_2755083974056345600_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vr89frqxCkAQ7kNvwG1G5s1&_nc_oc=AdrygrefvZ0m3bbQyIjpr4A7AZSGFoPZrEh4Raynh3cHvpChETfZrwvPRFehEkGRrwU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTygoSCqNZ5B-Nyrvrubsx0geyr-XUyx7eL-VZEHbjccQ&oe=6B0DCD4F"}, "display_name": "Sea Level Rise Explorer: Turner Station", "keywords": ["environment", "nature", "conservancy", "sea", "climate"], "long_description": "As coastal communities contend with sea level rise, coastal erosion, and other impacts of climate change, public education has become a critical piece of the puzzle., Virtual Planet Technologies produces highly creative and insightful experiences VR experiences that communities can use to better understand the impacts of climate change and explore emerging adaptation solutions. Our team has a range of expertise from climate scientists, city planners, communications experts, filmmakers, 3D animators, and Unity (software) developers. In our Sea Level Rise Explorer, users interact with 3D models and can raise sea levels to observe potential flooding in real time. Adaptation scenarios can also be displayed.", "short_description": "Virtual Planet\u2019s Sea Level Rise Explorer is a virtual reality experience that communities around the world can use t
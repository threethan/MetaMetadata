e_name": "migrated_image.png", "id": "801226080365272", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974526_459006321583559_2965587184591044608_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3NJuAQMa8dcQ7kNvwEEha5l&_nc_oc=AdkpvhV45tbcfSqkHzK_WZ2WHCTkgVC-81ptg8uFNBlzmiiFhdVBGfjpOmay5EZjKZI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afy_Q2PQl11naRs1ypBL7Yf2ACkSI2bqRPwso0nV-QGsZg&oe=69BFD1B7"}, {"file_name": "migrated_image.png", "id": "786573695164536", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974769_2082709388701116_172541845736259584_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X0MmLkFbt2MQ7kNvwF_ZFNa&_nc_oc=AdmnWRGWrp7KniR1Ma0mOgfkZxxhvAgKL9wCRXsRuhl0REM-znvs9vcZtaOPX4Ma0Ls&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwrJPl-RliIqlZY98ZTHcbq1wJNZjrXqmEnpQu030mamw&oe=69BFEC43"}, {"file_name": "migrated_image.png", "id": "656313315146310", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031581_2438837036345527_8452694246405701632_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ujrHXVlE18Q7kNvwE9njAN&_nc_oc=AdmT9BXuuboYAPKak9hQASvj4E-E1aFnDoMxJlJVVQ2rgoJrMKyTGt7ABInmfzOPObM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz723osHW-azepnolPNsVtwX_PW8t-JTZ2KyNcHICSMww&oe=69BFCBD1"}, {"file_name": "migrated_image.png", "id": "144944603554928", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974923_2286004728319041_840837365424455680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3UtK_Ux5cnIQ7kNvwEyeWWR&_nc_oc=Adm_hXY9MwJ_Tve9eUt516SzG-jTu3uy5wN2kR10gxoFOnZ9DebJ4Q7g0jsGDYJihBE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxFTInX5CxG2NQ8A06eqBEkEfz528euCYs4VWyPQou38g&oe=69BFD34B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/6nIlwd", "id": "352817115411667", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982580_352817118745000_2755083974056345600_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=atXRRfuhNFUQ7kNvwFcDo8r&_nc_oc=AdnwJAwJF65o12NLIjALvJKSG4OAw5EmOLtrQjSog9oxk7DELTmN8DEVXROTZjUR11Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwcxLKSVHqr6qDCcfMYwPPXp3y9Og-Pmtd7AQHgnbdkxw&oe=69BFD14F"}, "display_name": "Sea Level Rise Explorer: Turner Station", "keywords": ["environment", "nature", "conservancy", "sea", "climate"], "long_description": "As coastal communities contend with sea level rise, coastal erosion, and other impacts of climate change, public education has become a critical piece of the puzzle., Virtual Planet Technologies produces highly creative and insightful experiences VR experiences that communities can use to better understand the impacts of climate change and explore emerging adaptation solutions. Our team has a range of expertise from climate scientists, city planners, communications experts, filmmakers, 3D animators, and Unity (software) developers. In our Sea Level Rise Explorer, users interact with 3D models and can raise sea levels to observe potential flooding in real time. Adaptation scenarios can also be displayed.", "short_description": "Virtual Planet\u2019s Sea Level Rise Explorer is a virtual reality experience that communities around the world can use to visualize the impacts from sea level rise and explore adaptation scenarios. Through powerful immersive digital experiences, our aim is to educate, drive action and inspire hope in the future of our planet. Our team has a range of expertise from climate scientists to digital artists and Unity developers."}]}, "developer_name": "Virtual Planet Technologies LLC", "developer_privacy_policy_url": "https://www.virtualplanet.tech/privacy-policy", "developer_terms_of_service_url": "http://virtualplanet.tech/", "publisher_name": "Virtual Planet Technologies LLC", "support_website_url": "http://virtualplanet.tech/", "website_url": "http://virtualplanet.tech/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": nu
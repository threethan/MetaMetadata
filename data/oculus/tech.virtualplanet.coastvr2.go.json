scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974526_459006321583559_2965587184591044608_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o8Y10KvzdoQQ7kNvwHM9OXb&_nc_oc=AdlL6v84Qs8zXqCKQ9coMJhSZUz7WtlN9A8EUQHfHQuPiHgL9TE06mvVR0JjdY7WA-8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfupcCzQ9HQc_pqSGRjp2ROKyQ8WKs-ahYc54hu0dtFClA&oe=69A42237"}, {"file_name": "migrated_image.png", "id": "786573695164536", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974769_2082709388701116_172541845736259584_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6HVpSfsKVu4Q7kNvwHPgDB9&_nc_oc=AdmhRMEm1lR2px9p51sJKwpgxiTSrSxPr9z1syPPCbq3QMw3P9Cgr7Wfk30NrDXDqHU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afv2Rz9O_nNqKbkbij6uwXA8eCp5jsIjEm2QHlYFRSlsGw&oe=69A43CC3"}, {"file_name": "migrated_image.png", "id": "656313315146310", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031581_2438837036345527_8452694246405701632_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DtoEQYLUd2kQ7kNvwGlAZ-T&_nc_oc=Adnb_vk9rp-xuC8ULq2ic7iw-2lgm0aVNDKsdlj0mGxqqCxT3BZus_0F9uJa6SWe4do&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afs_ET34fvCDHzl8LNz2LrFA-HSSF7BlwbVMQcRz02_kpA&oe=69A41C51"}, {"file_name": "migrated_image.png", "id": "144944603554928", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974923_2286004728319041_840837365424455680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7uvdVop-ldQQ7kNvwGerjHr&_nc_oc=AdmO1_tJgWeAJK4bT7NGpY6HXKG8R-P_Ff7tj5SKH9o49rj-GKRKMYq4VesxstRVSBM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftbowJe1gKxNhejCIgq1sZHmUHs7PaxdlERaw2rYTj9SA&oe=69A423CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/6nIlwd", "id": "352817115411667", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982580_352817118745000_2755083974056345600_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PLtlwYGgaWoQ7kNvwE7HlOc&_nc_oc=AdnOvnyQlYNFEgZ8l-MeUuQtzGrcqiM02jNg3sEzesmBF1e3aa-lIzqGMJtwCueAPpU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Aft_rkPZhRaxV6JmTCvx3MkvpTPLY--7zazRrVAh2iSBPQ&oe=69A421CF"}, "display_name": "Sea Level Rise Explorer: Turner Station", "keywords": ["environment", "nature", "conservancy", "sea", "climate"], "long_description": "As coastal communities contend with sea level rise, coastal erosion, and other impacts of climate change, public education has become a critical piece of the puzzle., Virtual Planet Technologies produces highly creative and insightful experiences VR experiences that communities can use to better understand the impacts of climate change and explore emerging adaptation solutions. Our team has a range of expertise from climate scientists, city planners, communications experts, filmmakers, 3D animators, and Unity (software) developers. In our Sea Level Rise Explorer, users interact with 3D models and can raise sea levels to observe potential flooding in real time. Adaptation scenarios can also be displayed.", "short_description": "Virtual Planet\u2019s Sea Level Rise Explorer is a virtual reality experience that communities around the world can use to visualize the impacts from sea level rise and explore adaptation scenarios. Through powerful immersive digital experiences, our aim is to educate, drive action and inspire hope in the future of our planet. Our team has a range of expertise from climate scientists to digital artists and Unity developers."}]}, "developer_name": "Virtual Planet Technologies LLC", "developer_privacy_policy_url": "https://www.virtualplanet.tech/privacy-policy", "developer_terms_of_service_url": "http://virtualplanet.tech/", "publisher_name": "Virtual Planet Technologies LLC", "support_website_url": "http://virtualplanet.tech/", "website_url": "http://virtualplanet.tech/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON
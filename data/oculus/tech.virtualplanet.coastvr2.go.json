e": "migrated_image.png", "id": "786573695164536", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974769_2082709388701116_172541845736259584_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ly6oNcHkuDUQ7kNvwFTVQm0&_nc_oc=Adq-FxBC6l09c6PW3NBFjbqdWoo2K0rZaZJWUfT2tP0zDH8wMxRsG-yeFDHaOMH2UmY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40sGLY9R0u6i5L9zsjIPVFYY3VpQaabqqwqn4GHFkKXg&oe=6A1D86C3"}, {"file_name": "migrated_image.png", "id": "656313315146310", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031581_2438837036345527_8452694246405701632_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jjJO-4nZXyYQ7kNvwH0saqh&_nc_oc=AdqpQ0x0Hc12wwo-2tpgDrsEo3padMsrvLBatVgZMumz6M4YSyNXgnXfXjd6a2qAX30&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af48tgpn_N_2ceHlv98McXFAWkEm6h5rdu7WRR7qbIlw1A&oe=6A1D9E91"}, {"file_name": "migrated_image.png", "id": "144944603554928", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974923_2286004728319041_840837365424455680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FJ67ecHM0rUQ7kNvwEGwiC3&_nc_oc=AdpRJIWTl_Ur1B-zpBs_RlIBwJKG0Kde1SkCA80n05OGgveNJ1qLjPAThZi6c1mebLU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5M_MmfYEeklC9RkpqFQHoUOdf1XpGuyaPdLJXwae-rkQ&oe=6A1DA60B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/6nIlwd", "id": "352817115411667", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982580_352817118745000_2755083974056345600_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G4ITFX_uanQQ7kNvwFcpP65&_nc_oc=AdoX4MuCaYFhOEcgMZxtIbZikAhzS_MPuQh0iTze223my8o1orYNf-Co14pGs7aKPKc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6snbU6VOgv0z8x1TFwMHqacBdFACzOVUJ2-6cFW6hCCg&oe=6A1DA40F"}, "display_name": "Sea Level Rise Explorer: Turner Station", "keywords": ["environment", "nature", "conservancy", "sea", "climate"], "long_description": "As coastal communities contend with sea level rise, coastal erosion, and other impacts of climate change, public education has become a critical piece of the puzzle., Virtual Planet Technologies produces highly creative and insightful experiences VR experiences that communities can use to better understand the impacts of climate change and explore emerging adaptation solutions. Our team has a range of expertise from climate scientists, city planners, communications experts, filmmakers, 3D animators, and Unity (software) developers. In our Sea Level Rise Explorer, users interact with 3D models and can raise sea levels to observe potential flooding in real time. Adaptation scenarios can also be displayed.", "short_description": "Virtual Planet\u2019s Sea Level Rise Explorer is a virtual reality experience that communities around the world can use to visualize the impacts from sea level rise and explore adaptation scenarios. Through powerful immersive digital experiences, our aim is to educate, drive action and inspire hope in the future of our planet. Our team has a range of expertise from climate scientists to digital artists and Unity developers."}]}, "developer_name": "Virtual Planet Technologies LLC", "developer_privacy_policy_url": "https://www.virtualplanet.tech/privacy-policy", "developer_terms_of_service_url": "http://virtualplanet.tech/", "publisher_name": "Virtual Planet Technologies LLC", "support_website_url": "http://virtualplanet.tech/", "website_url": "http://virtualplanet.tech/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes"
.com/v/t64.5771-25/38974769_2082709388701116_172541845736259584_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EBDppc5vdxkQ7kNvwGwJmC2&_nc_oc=AdnU_kB6mYTo2l54ucyO-Rfy_ljv5gM1ORVZU8D9fKb3WqoSN-Orlp0TmptjlM4bLnU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AftaE8PGwbLGih3q7-MwaLDhLCuVCK6MvIp_1FJIs_00WA&oe=69A982C3"}, {"file_name": "migrated_image.png", "id": "656313315146310", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031581_2438837036345527_8452694246405701632_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qROKJszTABwQ7kNvwEOSRy_&_nc_oc=AdlnOHQP5mZvhaVzMkIiYsmd07gEbOlcxq1OfhMiy0sxpR9KcezVejy1xICGd0rOzg8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfuwsTOlTM4OsJ-WK-ZKxjlCzz_UKf-syEPQa1y-5PUfow&oe=69A96251"}, {"file_name": "migrated_image.png", "id": "144944603554928", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974923_2286004728319041_840837365424455680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jHErKJ5co3EQ7kNvwF9YPDw&_nc_oc=AdkvjECCVQyN2sJ6URq5nNzoAC8Ot4jGlxRrKBjEiUKx67GyYu2w2UcRe9Q1-xBd_p4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvJflgKmiYhOXeTI0EQ21UjEj4M5A78YuQ3N3xQM36qwA&oe=69A969CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/6nIlwd", "id": "352817115411667", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982580_352817118745000_2755083974056345600_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KCjfG9UZ11wQ7kNvwGkzMzn&_nc_oc=AdlAsxiB1YMJoZLlgB7S5kcB-TIwc1cW2BKmvmQVHIf08OdLzI2SVQsKr4zq3f81lPE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afs_-UOEWw0s46d02_0jctiVUVcsL-NOiLTs_gZ1c_HITw&oe=69A967CF"}, "display_name": "Sea Level Rise Explorer: Turner Station", "keywords": ["environment", "nature", "conservancy", "sea", "climate"], "long_description": "As coastal communities contend with sea level rise, coastal erosion, and other impacts of climate change, public education has become a critical piece of the puzzle., Virtual Planet Technologies produces highly creative and insightful experiences VR experiences that communities can use to better understand the impacts of climate change and explore emerging adaptation solutions. Our team has a range of expertise from climate scientists, city planners, communications experts, filmmakers, 3D animators, and Unity (software) developers. In our Sea Level Rise Explorer, users interact with 3D models and can raise sea levels to observe potential flooding in real time. Adaptation scenarios can also be displayed.", "short_description": "Virtual Planet\u2019s Sea Level Rise Explorer is a virtual reality experience that communities around the world can use to visualize the impacts from sea level rise and explore adaptation scenarios. Through powerful immersive digital experiences, our aim is to educate, drive action and inspire hope in the future of our planet. Our team has a range of expertise from climate scientists to digital artists and Unity developers."}]}, "developer_name": "Virtual Planet Technologies LLC", "developer_privacy_policy_url": "https://www.virtualplanet.tech/privacy-policy", "developer_terms_of_service_url": "http://virtualplanet.tech/", "publisher_name": "Virtual Planet Technologies LLC", "support_website_url": "http://virtualplanet.tech/", "website_url": "http://virtualplanet.tech/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "631290991418114"}}]}
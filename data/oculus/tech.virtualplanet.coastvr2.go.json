tPeo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu8jMxrR13y-F6oB2-4VGbtjh-3VvxYt5eTg9HUugMYBA&oe=69A6DFC3"}, {"file_name": "migrated_image.png", "id": "656313315146310", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031581_2438837036345527_8452694246405701632_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DtoEQYLUd2kQ7kNvwELYFLs&_nc_oc=AdlOrcQuvGZtvpHGBe_5UQnLgaO178snAd6_7FWgz3EHAcO5KsOj4bLT9mPLT3uJmoI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvGgGglbqMdu1p_VcHARLKqTY9at7uiUFPOAGeNj4lvxw&oe=69A6BF51"}, {"file_name": "migrated_image.png", "id": "144944603554928", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974923_2286004728319041_840837365424455680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jHErKJ5co3EQ7kNvwHKZlfE&_nc_oc=AdlADLhwAgQp8dQ7sVT0k6rb9G_pTxDszyePoWwER9a0HDy4QilNBukAmBy7Up6jLIc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvgcyPSR2XcnfCy2xEDFCEzDefYyfdS8B-ZugTLElnhNw&oe=69A6C6CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/6nIlwd", "id": "352817115411667", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982580_352817118745000_2755083974056345600_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KCjfG9UZ11wQ7kNvwG5Q6og&_nc_oc=AdmjHQv3iSRGyi2E0DVhqyk_QXwipPij6MGoLr107N-7okbR2AJjozd-N8ru3pahphc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftonRIuo8zkncl0CII0Z67WhEYBvl-tOST70BicdDyfXQ&oe=69A6C4CF"}, "display_name": "Sea Level Rise Explorer: Turner Station", "keywords": ["environment", "nature", "conservancy", "sea", "climate"], "long_description": "As coastal communities contend with sea level rise, coastal erosion, and other impacts of climate change, public education has become a critical piece of the puzzle., Virtual Planet Technologies produces highly creative and insightful experiences VR experiences that communities can use to better understand the impacts of climate change and explore emerging adaptation solutions. Our team has a range of expertise from climate scientists, city planners, communications experts, filmmakers, 3D animators, and Unity (software) developers. In our Sea Level Rise Explorer, users interact with 3D models and can raise sea levels to observe potential flooding in real time. Adaptation scenarios can also be displayed.", "short_description": "Virtual Planet\u2019s Sea Level Rise Explorer is a virtual reality experience that communities around the world can use to visualize the impacts from sea level rise and explore adaptation scenarios. Through powerful immersive digital experiences, our aim is to educate, drive action and inspire hope in the future of our planet. Our team has a range of expertise from climate scientists to digital artists and Unity developers."}]}, "developer_name": "Virtual Planet Technologies LLC", "developer_privacy_policy_url": "https://www.virtualplanet.tech/privacy-policy", "developer_terms_of_service_url": "http://virtualplanet.tech/", "publisher_name": "Virtual Planet Technologies LLC", "support_website_url": "http://virtualplanet.tech/", "website_url": "http://virtualplanet.tech/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "631290991418114"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "587114808485171"}]}, "baseline_offer": {"id": "587114808485171"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1564678800, "status": "PUBLISHED", "id":
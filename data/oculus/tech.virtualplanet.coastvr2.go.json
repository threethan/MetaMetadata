e_name": "migrated_image.png", "id": "801226080365272", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974526_459006321583559_2965587184591044608_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Puy6ckxGxEQ7kNvwGYRppq&_nc_oc=AdmLaUSGy-z9x3Jnf-IAJGfvfNHLqcnVcA85Ph7xxQ4kx6NgCbYT5OHptXStGAODcIQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyUuQYMtrFTZRwP7GJj-5fHF6IrU-RD5Ja8CYzRPN3rCw&oe=69BA8BB7"}, {"file_name": "migrated_image.png", "id": "786573695164536", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974769_2082709388701116_172541845736259584_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EWITAPTzKvoQ7kNvwFMAJ6C&_nc_oc=Adnr4v6yCNK_CdjufzVytGqCwAUrGWtYg-OJyf0gidXTrNep_0JaualK2yyZ8ZnrvWU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwvLQaaTPl2IUca-bpgqBVdsDtpjpEKh1XIz_l860YQnQ&oe=69BAA643"}, {"file_name": "migrated_image.png", "id": "656313315146310", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031581_2438837036345527_8452694246405701632_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JbXwMVGgjLUQ7kNvwGlBuAZ&_nc_oc=AdnPVgflU4czXpa87V-0DZXcTge5BzJRV2-EVueKAlaQwbd9DZ795HyIr9_cwmczSwA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afym8VaE39rc8iP9Bfx7LzaQ9azCXL4wJzlLxLqKCL_m5g&oe=69BA85D1"}, {"file_name": "migrated_image.png", "id": "144944603554928", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974923_2286004728319041_840837365424455680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XUYM49ZmcnoQ7kNvwEqVYEy&_nc_oc=Adk5OlW6hIxGOkh8uLvgw9cGFrpy7PuqkxjfZxb-JPxjv42cOGIs88I3j91lRvQ_i1Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afzs7P-u4W818ayceg7t-SSrc8okeMhrJH0-dku-ab--nA&oe=69BA8D4B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/6nIlwd", "id": "352817115411667", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982580_352817118745000_2755083974056345600_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wsBVGjRoVbgQ7kNvwGoOBqT&_nc_oc=AdmV9l5bJc7AjXeEBgsqMW4QPqUXlJH_zeV7BYl2iaseYM6szKpJv-ALh3IPaOfLFlI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwHDyzR_WJQPQ3yATO5YL-CNJvVMzWkqrXRYUU24ztchA&oe=69BA8B4F"}, "display_name": "Sea Level Rise Explorer: Turner Station", "keywords": ["environment", "nature", "conservancy", "sea", "climate"], "long_description": "As coastal communities contend with sea level rise, coastal erosion, and other impacts of climate change, public education has become a critical piece of the puzzle., Virtual Planet Technologies produces highly creative and insightful experiences VR experiences that communities can use to better understand the impacts of climate change and explore emerging adaptation solutions. Our team has a range of expertise from climate scientists, city planners, communications experts, filmmakers, 3D animators, and Unity (software) developers. In our Sea Level Rise Explorer, users interact with 3D models and can raise sea levels to observe potential flooding in real time. Adaptation scenarios can also be displayed.", "short_description": "Virtual Planet\u2019s Sea Level Rise Explorer is a virtual reality experience that communities around the world can use to visualize the impacts from sea level rise and explore adaptation scenarios. Through powerful immersive digital experiences, our aim is to educate, drive action and inspire hope in the future of our planet. Our team has a range of expertise from climate scientists to digital artists and Unity developers."}]}, "developer_name": "Virtual Planet Technologies LLC", "developer_privacy_policy_url": "https://www.virtualplanet.tech/privacy-policy", "developer_terms_of_service_url": "http://virtualplanet.tech/", "publisher_name": "Virtual Planet Technologies LLC", "support_website_url": "http://virtualplanet.tech/", "website_url": "http://virtualplanet.tech/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": nu
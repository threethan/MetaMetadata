xgkYkwU1B-N7qN47P65mdLJIKoM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBAiB2JPjJJAZ6hT9G7ZHQpa2m6Cw9ctOt8UMtzOXdFg&oe=6AFB456B"}, {"file_name": "BeatDown_4_KAPOW.png", "id": "1088677597099348", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/604385997_1088677600432681_6418798289006078669_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0lCYU5mcbSYQ7kNvwGirEbI&_nc_oc=AdosN5gCFhUDsWhmipIFpFuZn40QLqUEz3LxaPXDDUtsaWT0dkc6OzA_dwsqf34BELU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYK8VfH6IqpECpO1_eu2h4wifSQcNQY4YndgcyJS9Rwg&oe=6AFB2DFB"}, {"file_name": "BeatDown_3_BAM.png", "id": "1891016868732804", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/595129854_1891016872066137_7531017348618294367_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TMsBkA-HlhsQ7kNvwHSW1_w&_nc_oc=AdoHQzyXBtSceLR0mSa68OXE_q224F_nv2HW7XIBY9z9N-QzcGNht-_2_VUKl-amf-8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnKDAcp0xl49Kpwi_HopK8XjVx9Nruak7MVaIR8eEwzQ&oe=6AFB2C0D"}, {"file_name": "BeatDown_1_POW.png", "id": "1637795577689396", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/596068480_1637795581022729_7412639765720507823_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cKMIcLmRWo0Q7kNvwFBMIpM&_nc_oc=Adre0wDHF8yDQbV-WjcBRRV1vEIqgQruU3p2m8Gun3jcs7sUXdKOL35SzB5rz_OZ1vQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzm9SAzOFTADZ7TWVEzkZo7pAd5RZp2Uk2ohdTrjgw7Q&oe=6AFB2471"}, {"file_name": "BeatDown_5_KRAK.png", "id": "1841376967033445", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/604347072_1841376970366778_8761105806029834_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ziiBNts4bigQ7kNvwHY589C&_nc_oc=AdoG7hNX9QTnUqzisKgqtoheUVUyGA3nZiDFZ9V5i2SvBSKpC1RWrwJsX_3I-vYq66c&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOV9d378tFS_GjMYmrEKXU4pgBi4oWwSnXycTGuIJJhQ&oe=6AFB3FA1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "A_Knockout_Landscape_2560x1440.png", "id": "1643296224124738", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499302344_1643296227458071_749025559989567746_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HEpdr6S1b08Q7kNvwHpghxq&_nc_oc=AdooLCEsGITcoyh-ndam6GTXMdYXp6d-tmq6RUzKezh8JNvdXrakdC1iU2DBL1sRmKw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIHk_TqC7qi2XrYXiYR69XBy0DLa5lmTfN-js4gwv4BQ&oe=6AFB3EA2"}, "display_name": "BeatDown", "keywords": ["boxing", "rhythm", "fitness", "music", "fighting"], "long_description": "# Every song is a round. Every beat is a punch.\n\nBeatDown puts you toe-to-toe with an opponent who fights to the music. Read the cues, dodge the swing, and hit back on the beat. Chain your hits to build your multiplier, then end the song with a finisher combo that sends your opponent flying.\n\n## Fight to the music\nTargets and dodges land on the beat of every track. The harder you swing, the bigger the hit, from a weak **PFFT** to a full **KAPOW**.\n\n## Arenas that move with the song\nEvery arena reacts to the beat:\n\n- A castle gate\n- A pirate deck under cannon fire\n- A nightclub\n- A collapsing construction platform 40 metres up\n- A snowy Christmas yard\n- The roof of a big rig in a highway chase\n\n**More arenas are on the way.**\n\n## Pick your fighter\nChoose your opponent and your own body from a roster of fighters.\n\n## 50+ original songs\nBrowse a library of original songs across many genres. Search, filter, and preview before you fight.\n\n## Play your way\n- Multiple difficulty levels\n- Roomscale or Stationary play\n- Grades, high scores, and a results screen after every fight\n\n**Put your gloves up. The beat is about to drop.**", "short_description": "Punch to the beat. BeatDown is a VR boxing rhythm game where every song is a fight. Slip punches, land combos on the beat, and launch your opponent with a finishing blow across wild arenas, from a castle gate to the roof of a speeding truck."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/sweetandsourgames/private-policy", "developer_terms_of_service_url": null, "publisher_name": "Sweet And Sour Games", "support_website_url": "https://sites.google.com/view/sweetandsourgames/", "website_url": "https://sites.google.com/view/sweetandsourgames/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1413129701874849"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2207221000150251"}]}, "baseline_offer": {"id": "2207221000150251"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793211420, "status": "PUBLISHED", "id": "2207221000150251"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1480646115123207", "version": "1.0.0"}, "id": "1811755149977152", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1413129698541516", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1480646115123207"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1811755149977152"}]}, "change_log": "Power-up (fist bump)\r\n\r\nActivated by a deliberate knuckle bump.\r\nLasts 8\u201316 seconds. He circles you and slips your punches at normal human speed, throwing the occasional single punch.\r\nEnds with a knockdown and a gold point total.\r\nHands: blue while filling, gold throb once per beat when ready, twice per beat when maxed.\r\nHe turns green while it\u2019s on. Points rack up on him and the view edges glow.\r\nMultiplier x6. Each punch scores 10% more than the last, with a climbing bell sound.\r\n\r\nHis rage\r\n\r\nOne rage per song. His flurry alternates blocks and dodges.\r\nHis whole body turns red.\r\nx5 score bonus, with a running total over his head.\r\n\r\nBlock + parry\r\n\r\nA blue cue on about 1 in 3 of his punches means block. Either glove on the dot counts.\r\nEvery 3rd PERFECT block is a parry, which gives you a counter target. A missed block lands as a hit on you.\r\n\r\nKnockdown break\r\n\r\nIn the quietest middle part of the song, he gets slammed onto his back about 1 m away, gets up and walks back in.\r\nThe slam has a thud and a dust ring.\r\n\r\nTutorial\r\n\r\n6 parts: HIT, DODGE, BLOCK, MIX IT UP, POWER UP, RAGE, then free practice.\r\nJump to any part from the pause menu.\r\nEvery part needs 5.\r\nRings start at full size, and he doesn\u2019t step in before targets.\r\n\r\nOther\r\n\r\nFinisher: a dazed looping animation before the last hit.\r\nMusic: constant volume, no ducking.\r\nFree hits: punches outside a target don\u2019t bounce him while a target is up.\r\nRest beats: he circles you.\r\nCues: a target or block cue on screen always plays out.\r\nResults screen: any button skips the animation.\r\nReplays: blocks show up in them.\r\nRemoved: his glove guard and head slips, red swing-path lines, and the combo turn-back.", "created_date": 1793829176, "id": "1480646115123207", "version": "1.0.0", "ve
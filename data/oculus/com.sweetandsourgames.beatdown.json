ga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTneIhKoZh3PxGt1ljjafnsiAsgrYZKJVeTA1aZiiFD0Q&oe=6AFB3E01"}, {"file_name": "BeatDown_FirstPerson_5.png", "id": "4673140549584816", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491827626_4673140552918149_2983329966060303102_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_U_3c4c5xGYQ7kNvwHy1_GE&_nc_oc=AdpBzc3vrDgcpvvF6ubTm6hl_ku6yezAk4AA3nD9tWr43poEt8SSawny1hU2jmt--Q8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvcBNVHstlAM4Xcqc_HZO2W-QBOXpOxD_IROaaz1x0Pw&oe=6AFB42EF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BeatDown_Meta_Universal_Basic_Asset_2560x1440_NoStretch (1).png", "id": "1665906011820692", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491825546_1665906015154025_5991326908361962415_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qaZ3r1F7WXYQ7kNvwEyw2vh&_nc_oc=AdoJrq3diY91puwkSiV9tkKRFlPvD-X2J0pRB-E1nEv11NEEHmVwIc94EKwPuuRQvRA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTU7QF_i3qaGSLErqvq7qafkMYW66JT1Ry7XZgx5ewHRg&oe=6AFB269B"}, "display_name": "BeatDown", "keywords": ["boxing", "rhythm", "fitness", "music", "fighting"], "long_description": "# Every song is a round. Every beat is a punch.\n\nBeatDown puts you toe-to-toe with an opponent who fights to the music. Read the cues, dodge the swing, and hit back on the beat. Chain your hits to build your multiplier, then end the song with a finisher combo that sends your opponent flying.\n\n## Fight to the music\nTargets and dodges land on the beat of every track. The harder you swing, the bigger the hit, from a weak **PFFT** to a full **KAPOW**.\n\n## Arenas that move with the song\nEvery arena reacts to the beat:\n\n- A castle gate\n- A pirate deck under cannon fire\n- A nightclub\n- A collapsing construction platform\n- A snowy Christmas yard\n- The roof of a big rig in a highway chase\n\n**More arenas are on the way.**\n\n## Pick your fighter\nChoose your opponent and your own body from a roster of fighters.\n\n## 50+ original songs\nBrowse a library of original songs across many genres. Search, filter, and preview before you fight.\n\n## Play your way\n- Multiple difficulty levels\n- Roomscale or Stationary play\n- Grades, high scores, and a results screen after every fight\n\n**Put your gloves up. The beat is about to drop.**", "short_description": "Punch to the beat. BeatDown is a VR boxing rhythm game where every song is a fight. Slip punches, land combos on the beat, and launch your opponent with a finishing blow across wild arenas, from a castle gate to the roof of a speeding truck."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/sweetandsourgames/private-policy", "developer_terms_of_service_url": null, "publisher_name": "Sweet And Sour Games", "support_website_url": "https://sites.google.com/view/sweetandsourgames/", "website_url": "https://sites.google.com/view/sweetandsourgames/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1463036916884127"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/673759338_1904718914230776_9138861286215812399_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7bK
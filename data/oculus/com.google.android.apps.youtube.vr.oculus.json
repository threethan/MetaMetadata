Wf2wuvjPxChfKyh7Jme2HPf419dMCdk9g&oe=6B0B42B3"}, {"file_name": "migrated_image.png", "id": "203725571041915", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031419_378855902902202_2923253023394234368_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eZsBQ_IK3hcQ7kNvwH2yYLa&_nc_oc=AdonGJKH7aXc2WqBKb9nrIt8Y8IcIoJWXM2IymYcyTeEUczbNmQ3ojkWKDVbaAjn_qo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTuFOaSkHAJLETlDarZikiB6lDiTJg9p5U0saIjIWTYgQ&oe=6B0B27FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/TunwOS", "id": "2122998087992373", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974626_2122998091325706_4820008635411202048_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2E9urh2z4kQQ7kNvwHrN7LF&_nc_oc=AdqAAwrAFpaYXf46WZbF0-vrRrYoKCVFA2ZFEBH2CROa2o_q0s-0o9UeWHmBZvjoX7c&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSPOxwzrRZ7nGtsMKc-Ck3YNSNIjHO4qXSlrngBxUd-hA&oe=6B0B1383"}, "display_name": "YouTube VR", "keywords": ["Video", "Movies", "Shows", "TV", "Live"], "long_description": "Experience your favorite YouTube channels, videos and creators in virtual reality.\n\nThe YouTube VR app turns every video on the platform into your own virtual reality experience and reimagines YouTube as a 3D world you can explore from the inside. \n\nExperience YouTube like never before\n\u2022 Explore every video on YouTube, from 3D 360 videos to standard rectangular videos\n\u2022 Get the full, signed-in experience that lets you view subscriptions, playlists, watch history and more\n\u2022 Choose to co-watch videos with others, talk about them live, and enjoy a shared experience all in the same virtual room\n\nSee and hear it all\n\u2022 Immerse yourself in full 360-degree videos that put you at the center of the action\n\u2022 Experience spatial audio, where depth and distance play a role depending on where you look\n\u2022 Switch between voice and keyboard controls to browse and search with ease\n\n\nPermission Notice\n\u2022 Microphone: Needed to allow searching for YouTube content with your voice and social communication", "short_description": "Experience your favorite YouTube channels, videos and creators in virtual reality.\n\nThe YouTube VR app turns every video on the platform into your own virtual reality experience and reimagines YouTube as a 3D world you can explore from the inside"}]}, "developer_name": "Google LLC", "developer_privacy_policy_url": "https://support.google.com/youtube/answer/7671399?hl=en", "developer_terms_of_service_url": "https://www.youtube.com/static?template=terms", "publisher_name": "Google LLC", "support_website_url": null, "website_url": "https://www.youtube.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["CASUAL", "EXPERIENCE_360_NON_GAME", "MOVIE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD_VIA_TOUCH", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "275917671310632"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2055628267881344"}]}, "baseline_offer": {"id": "2055628267881344"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1557965785, "status": "PUBLISHED", "id": "2055628267881344"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29575039555515330", "version": "1.92.11"}, "id": "545
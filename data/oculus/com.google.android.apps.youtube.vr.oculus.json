=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CxCn5PkGhKYQ7kNvwGrFFv7&_nc_oc=AdolKEZH3k99p5fBTySbP-ANisLDZvUnGNFCZG5LoaF6WKGBilLix6KZaemzEaC2F2E&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLrASE5rRjP038c5JM9TRRKHXBOwwSEsHSNlnbISy71pQ&oe=6AA93309"}, {"file_name": "migrated_image.png", "id": "138789750885094", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/12331069_1692938717459161_6286521335979966464_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n5dJjYlJ-CAQ7kNvwFdO6mV&_nc_oc=AdofNacPuwdYlVPVNXOANcehTfnUOi9Veiv7noSDezLulZ4ImlNo9IiT-20HkyOewBo&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJCpx6l5Rd4CqybizxNW8Xe4r5ZYrysydsQkbaH7mDKkQ&oe=6AA95711"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail.png", "id": "173833590106093", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/12410407_173833593439426_6561057990592430080_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-i1nrCTT3egQ7kNvwGywL9T&_nc_oc=AdqM6703eWrr52v3pn2LL5H92yqm33VMN3bb-ZBFp6kbKLsOvnrGcgDnSs8-1JtTHpY&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJN74SFwx4SqPfx6slBQ0X5oi3tTNp7mgJr3GXRkPCs_g&oe=6AA9668B"}, "display_name": "YouTube VR", "keywords": ["Video", "Movies", "Shows", "TV", "Live"], "long_description": "Experience your favorite YouTube channels, videos and creators in virtual reality.\n\nThe YouTube VR app turns every video on the platform into your own virtual reality experience and reimagines YouTube as a 3D world you can explore from the inside. \n\nExperience YouTube like never before\n\u2022 Explore every video on YouTube, from 3D 360 videos to standard rectangular videos\n\u2022 Get the full, signed-in experience that lets you view subscriptions, playlists, watch history and more\n\u2022 Choose to co-watch videos with others, talk about them live, and enjoy a shared experience all in the same virtual room\n\nSee and hear it all\n\u2022 Immerse yourself in full 360-degree videos that put you at the center of the action\n\u2022 Experience spatial audio, where depth and distance play a role depending on where you look\n\u2022 Switch between voice and keyboard controls to browse and search with ease\n\n\nPermission Notice\n\u2022 Microphone: Needed to allow searching for YouTube content with your voice and social communication", "short_description": "Experience your favorite YouTube channels, videos and creators in virtual reality.\n\nThe YouTube VR app turns every video on the platform into your own virtual reality experience and reimagines YouTube as a 3D world you can explore from the inside"}]}, "developer_name": "Google LLC", "developer_privacy_policy_url": "https://support.google.com/youtube/answer/7671399?hl=en", "developer_terms_of_service_url": "https://www.youtube.com/static?template=terms", "publisher_name": "Google LLC", "support_website_url": null, "website_url": "https://www.youtube.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["EXPERIENCE_360_NON_GAME", "MOVIE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "342812797850561"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "246017572788808"}, {"status": "PUBLISHED", "id": "1930617233897992"}, {"status": "PUBLISHED", "id": "1465206833578825"}]}, "baseline_offer": {"id": "246017572788808"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1533142800, "status": "PUBLISHED", "id": "246017572788808"}]}, "liveChannel": {"nodes": [{"latest_supported_bi
IIHIg&oe=6B0EFEF3"}, {"file_name": "migrated_image.png", "id": "203725571041915", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031419_378855902902202_2923253023394234368_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QN_wPn1o4mkQ7kNvwHs4ucb&_nc_oc=AdpdBWnvj2KaO1Th5B7HNStuBk_B8q7_ohA63L6he0KKjUS2eF2QCMuxrnzTHGQ0xVY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV2q885edpJcu9aNX_YlhIpXVmbtKgXxTGN-uqQUtvEZg&oe=6B0F1C7B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/TunwOS", "id": "2122998087992373", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974626_2122998091325706_4820008635411202048_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wd3iGAitGhAQ7kNvwGQx2Xe&_nc_oc=AdqnM5Ub48t6Qi3A1198bgJbDl1yERQGrgtxRuCVzbUvR-Q9h3Gq0R-xvt1TQlXWZTc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUvRgpIJMFYb4TXT_uivxEvjqoY2Lt1FlBAX5c5JmhgxQ&oe=6B0F0803"}, "display_name": "YouTube VR", "keywords": ["Video", "Movies", "Shows", "TV", "Live"], "long_description": "Experience your favorite YouTube channels, videos and creators in virtual reality.\n\nThe YouTube VR app turns every video on the platform into your own virtual reality experience and reimagines YouTube as a 3D world you can explore from the inside. \n\nExperience YouTube like never before\n\u2022 Explore every video on YouTube, from 3D 360 videos to standard rectangular videos\n\u2022 Get the full, signed-in experience that lets you view subscriptions, playlists, watch history and more\n\u2022 Choose to co-watch videos with others, talk about them live, and enjoy a shared experience all in the same virtual room\n\nSee and hear it all\n\u2022 Immerse yourself in full 360-degree videos that put you at the center of the action\n\u2022 Experience spatial audio, where depth and distance play a role depending on where you look\n\u2022 Switch between voice and keyboard controls to browse and search with ease\n\n\nPermission Notice\n\u2022 Microphone: Needed to allow searching for YouTube content with your voice and social communication", "short_description": "Experience your favorite YouTube channels, videos and creators in virtual reality.\n\nThe YouTube VR app turns every video on the platform into your own virtual reality experience and reimagines YouTube as a 3D world you can explore from the inside"}]}, "developer_name": "Google LLC", "developer_privacy_policy_url": "https://support.google.com/youtube/answer/7671399?hl=en", "developer_terms_of_service_url": "https://www.youtube.com/static?template=terms", "publisher_name": "Google LLC", "support_website_url": null, "website_url": "https://www.youtube.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["CASUAL", "EXPERIENCE_360_NON_GAME", "MOVIE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD_VIA_TOUCH", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "275917671310632"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2055628267881344"}]}, "baseline_offer": {"id": "2055628267881344"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1557965785, "status": "PUBLISHED", "id": "2055628267881344"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29575039555515330", "version": "1.92.11"}, "id": "545256815955045", "channel_name
pIU9J2KiQmnKKRT2iIspSL6wFwlGDyJCPdRjQ_wrMDzPGDgswSeg8gErlY9tyQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTd97EnpqTyLdQ6h0ph_mNqogYjeKKgKxRPw4wEnEgV7g&oe=6B007AD8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "getaway new full image.png", "id": "1006225440735697", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75622007_1006225444069030_6959868370288440985_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u8vrXS4ILW0Q7kNvwH13TX8&_nc_oc=Adp0cCsS-WhFB3q3ul34A_ba7xUfaIRKNau0-SM8HhudvVWASzPIiiRpQW-u7euV2eI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRU5gR2FY4wcU1PSfCXDjWe_hC1X15YBF1B0C2dvJUgGA&oe=6B007F55"}, "display_name": "GetaWay", "keywords": [], "long_description": "GetaWay is a thrilling VR monkey game where players embark on an adventure through different worlds. They can swing through either a water filled poolrooms or a lush green rainforest. The game offers both solo gameplay and the opportunity to enjoy casual lobbies with friends. In these lobbies, players can team up to solve puzzles, navigate mazes, and compete in friendly challenges. With intuitive controls, players can climb, swing, and interact with the dynamic environments. As they progress, they can earn coins to customize their monkey avatars. GetaWay provides an immersive VR experience filled with excitement, exploration, and cooperative play.", "short_description": "GetaWay is an immersive VR monkey game that lets players embark on thrilling adventures across two diverse worlds, swinging through rainforests and exploring fantastical realms. With the option to join casual lobbies, players can team up with friends, play games, and engage in exciting challenges, creating a social and immersive experience in virtual reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/d692c747-89e3-42e4-a474-a48d80682b8f", "developer_terms_of_service_url": nu
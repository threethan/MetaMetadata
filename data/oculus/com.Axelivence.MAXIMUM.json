QH1aDDdwBRY4Xv8WUclX2ER5BTV8TjQIPPGLc70APRLN-EQU46eS2UNO5BC6h0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTjM1bo_pOj2-NBQiSXquG7c-mlqDyq9DxzLmrDbOxuxw&oe=6B0C5858"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "getaway new full image.png", "id": "1006225440735697", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75622007_1006225444069030_6959868370288440985_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k7R1uYSrGWwQ7kNvwHkNXCJ&_nc_oc=AdquyX1yDDpGFde2FE-UPukhMdx-NH3bVm3iXaS7IbYZXuE2iNK012BspA_EV1IuyGs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTb5qQr11-jx75ek1yGQZhlIkzuEMtqx_T69d3AdEx2tQ&oe=6B0C5CD5"}, "display_name": "GetaWay", "keywords": [], "long_description": "GetaWay is a thrilling VR monkey game where players embark on an adventure through different worlds. They can swing through either a water filled poolrooms or a lush green rainforest. The game offers both solo gameplay and the opportunity to enjoy casual lobbies with friends. In these lobbies, players can team up to solve puzzles, navigate mazes, and compete in friendly challenges. With intuitive controls, players can climb, swing, and interact with the dynamic environments. As they progress, they can earn coins to customize their monkey avatars. GetaWay provides an immersive VR experience filled with excitement, exploration, and cooperative play.", "short_description": "GetaWay is an immersive VR monkey game that lets players embark on thrilling adventures across two diverse worlds, swinging through rainforests and exploring fantastical realms. With the option to join casual lobbies, players can team up with friends, play games, and engage in exciting challenges, creating a social and immersive experience in virtual reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/d692c747-89e3-42e4-a474-a48d80682b8f", "developer_terms_of_service_url": nu
c=CcixBomR_koQ7kNvwE4ySSR&_nc_oc=AdrtybZx7ONcwLXJEOo6TE0QTjVCbPdqMmS5Xr1ZzyWyzpxPf-BzJbKqUfyxKqp4ZSo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQr95r7CzBwP6VKixM9WK_YrNIvo81rnjB7lPWv_nHM3A&oe=6B072467"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "getaway proper size.png", "id": "1072877827496264", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031344_1072877830829597_6894386261276344440_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8jclr0GDreEQ7kNvwFvsmgy&_nc_oc=AdpDSs6qkq3dmsit4JhPrm-WNDlApgMScRfrscOIJROXP2QZdyEewkXhU_-WZd4Hn6c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtaFzhxAtREve7szpGmmwYwOH-z3Xp5rfni1b7q8SgwA&oe=6B071E94"}, "display_name": "GetaWay", "keywords": [], "long_description": "GetaWay is a thrilling VR monkey game where players embark on an adventure through different worlds. They can swing through either a water filled poolrooms or a lush green rainforest. The game offers both solo gameplay and the opportunity to enjoy casual lobbies with friends. In these lobbies, players can team up to solve puzzles, navigate mazes, and compete in friendly challenges. With intuitive controls, players can climb, swing, and interact with the dynamic environments. As they progress, they can earn coins to customize their monkey avatars. GetaWay provides an immersive VR experience filled with excitement, exploration, and cooperative play.", "short_description": "GetaWay is an immersive VR monkey game that lets players embark on thrilling adventures across two diverse worlds, swinging through rainforests and exploring fantastical realms. With the option to join casual lobbies, players can team up with friends, play games, and engage in exciting challenges, creating a social and immersive experience in virtual reality."}]}, "developer_name": "Edivence", "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/d692c747-89e3-42e4-a474-a48d80682b
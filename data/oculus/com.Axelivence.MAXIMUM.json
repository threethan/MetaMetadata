&oh=00_Af4pshTj5JqRuoE2F-mjckLFX7ZJtzG9v6Zr94jsED1_Ig&oe=6A146376"}, {"file_name": "getaway WOW real.png", "id": "531963575639201", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031334_531963578972534_6694258313021792586_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WpdvP4EgtI8Q7kNvwE6j132&_nc_oc=AdrF0fHNa7yl-KlpsHC2U14XzFNkO-Ry8e_Cjsi4wVnYNDJBgTU-i_RmosTr0cDX3BU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7n_RTrcR1M153KnDwkCVbCbXDfXTkBL5DcVsANB_tH-Q&oe=6A145E32"}, {"file_name": "stack up.png", "id": "3435252863395908", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031334_3435252866729241_8620672043527745219_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hMLXP0OB_dUQ7kNvwH7xCeT&_nc_oc=Adq6qYWziRpFkZF-dEriG9sa9jwHXZqf1INqQn64Tftrzfn-_smxoVG2Ys8aTcpqKOw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af532whh4QQZhTDdPzkkdQtcCrDVOeWEerhZe7UsEGmQPg&oe=6A144295"}, {"file_name": "bow down now.png", "id": "247640237958516", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036603_247640244625182_1174945132156076176_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K1EM_v5r2lcQ7kNvwG0geHe&_nc_oc=AdpA1gb7mV4ajfP7UiJCyOlgFzHJmoc_vzXEp8LwlwzTbLEIVK92to1yUGAOHT56EcA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7AQ7HbOm-KFzNSxM1ylH89QCNO_zgAzDZp5Yq1_wEgdg&oe=6A144618"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "getaway new full image.png", "id": "1006225440735697", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75622007_1006225444069030_6959868370288440985_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AmeYt-rHhRQQ7kNvwE2JGXN&_nc_oc=Adremp6JrK9lE17v_c2Nm_TK4WtylC_dp2Ubw1VqZh8xGyhJIVvbDozYo91kmBHbLhs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71VQfmqc3zgXFTUFxe19NblAoMkgLmOm_6RgAmY0GRvw&oe=6A144A95"}, "display_name": "GetaWay", "keywords": [], "long_description": "GetaWay is a thrilling VR monkey game where players embark on an adventure through different worlds. They can swing through either a water filled poolrooms or a lush green rainforest. The game offers both solo gameplay and the opportunity to enjoy casual lobbies with friends. In these lobbies, players can team up to solve puzzles, navigate mazes, and compete in friendly challenges. With intuitive controls, players can climb, swing, and interact with the dynamic environments. As they progress, they can earn coins to customize their monkey avatars. GetaWay provides an immersive VR experience filled with excitement, exploration, and cooperative play.", "short_description": "GetaWay is an immersive VR monkey game that lets players embark on thrilling adventures across two diverse worlds, swinging through rainforests and exploring fantastical realms. With the option to join casual lobbies, players can team up with friends, play games, and engage in exciting challenges, creating a social and immersive experience in virtual reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/d692c747-89e3-42e4-a474-a48d80682b8f", "developer_terms_of_service_url": null, "publisher_name": "Axelvence", "support_website_url": null, "website_url": "https://getaway7.godaddysites.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1412224
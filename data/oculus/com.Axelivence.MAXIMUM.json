c=1e7taDFSBDIQ7kNvwHFgxwI&_nc_oc=Adr8rHVnmZZfLnHQnbLSNGF_546OF73XzoR97hr_5PqNySTF59zS_Z5MvAEqMg811uM&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3SZZy_g5Wr7C1Z_3-_vNwNJD9Pfyb6nYWdG7mfXPprg&oe=6AFC6027"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "getaway proper size.png", "id": "1072877827496264", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031344_1072877830829597_6894386261276344440_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cs8WV2tiFzgQ7kNvwESYILO&_nc_oc=AdoBTK0-tFw7MELYyBpIh6-cl_6lbaFBGxZdh0beWmwnfrGQ9I59iY7BhY_ryfRMF6U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR17FSXcX-CV4F1d3d8K9R_nxQb2p1d2Sfh12kTTHtwVw&oe=6AFC9294"}, "display_name": "GetaWay", "keywords": [], "long_description": "GetaWay is a thrilling VR monkey game where players embark on an adventure through different worlds. They can swing through either a water filled poolrooms or a lush green rainforest. The game offers both solo gameplay and the opportunity to enjoy casual lobbies with friends. In these lobbies, players can team up to solve puzzles, navigate mazes, and compete in friendly challenges. With intuitive controls, players can climb, swing, and interact with the dynamic environments. As they progress, they can earn coins to customize their monkey avatars. GetaWay provides an immersive VR experience filled with excitement, exploration, and cooperative play.", "short_description": "GetaWay is an immersive VR monkey game that lets players embark on thrilling adventures across two diverse worlds, swinging through rainforests and exploring fantastical realms. With the option to join casual lobbies, players can team up with friends, play games, and engage in exciting challenges, creating a social and immersive experience in virtual reality."}]}, "developer_name": "Edivence", "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/d692c747-89e3-42e4-a474-a48d80682b
kNvwFXgoj4&_nc_oc=AdkWapsJe4jdBY1eh1yRE738GWZzDEpCSuExQQwHP6u2eTW2RezG1f4hYKjuQMkHev0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuL-Yrn8mRYoV97o2phlYWQivwzUX5J2Su9hPp8nRh9Yg&oe=699F08B2"}, {"file_name": "stack up.png", "id": "3435252863395908", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031334_3435252866729241_8620672043527745219_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W9hoXvHn-wsQ7kNvwGUi2TU&_nc_oc=AdmxXZyb_OOp9cl8u4rqg0895Jkh4jfO1KYCIq0Xx0l79fsjAJhoc7hspl2eWMQSzhE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aftm51XNl-f8x5spJxwirGRbg81U_sWRG6dwctEVysifvw&oe=699EED15"}, {"file_name": "bow down now.png", "id": "247640237958516", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036603_247640244625182_1174945132156076176_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d5dVdtmBEu8Q7kNvwFwq6L4&_nc_oc=AdmkYXOqk17M1ZWXT4q2VSEp8mZ1pZc9fTbtvLCR3COuSFYXG_I0GTlW7dGSiYdOq20&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsemHNO13yu5Ehx9KzBej62OzSAy6wsdcCeu6gwZJJk3g&oe=699EF098"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "getaway new full image.png", "id": "1006225440735697", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75622007_1006225444069030_6959868370288440985_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7CUNIM4GMbEQ7kNvwEzC9f4&_nc_oc=Adm9q-LxorsxEyA1S6vunINeUTeiL3ien6zXlRzh0aZd2zzsz2mVaKMb3iqh0aRsth0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvdvFSx45p561Txj0BaNqjt6A6nqEHi0VsjO4lCMnEqtA&oe=699EF515"}, "display_name": "GetaWay", "keywords": [], "long_description": "GetaWay is a thrilling VR monkey game where players embark on an adventure through different worlds. They can swing through either a water filled poolrooms or a lush green rainforest. The game offers both solo gameplay and the opportunity to enjoy casual lobbies with friends. In these lobbies, players can team up to solve puzzles, navigate mazes, and compete in friendly challenges. With intuitive controls, players can climb, swing, and interact with the dynamic environments. As they progress, they can earn coins to customize their monkey avatars. GetaWay provides an immersive VR experience filled with excitement, exploration, and cooperative play.", "short_description": "GetaWay is an immersive VR monkey game that lets players embark on thrilling adventures across two diverse worlds, swinging through rainforests and exploring fantastical realms. With the option to join casual lobbies, players can team up with friends, play games, and engage in exciting challenges, creating a social and immersive experience in virtual reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/d692c747-89e3-42e4-a474-a48d80682b8f", "developer_terms_of_service_url": null, "publisher_name": "Axelvence", "support_website_url": null, "website_url": "https://getaway7.godaddysites.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1412224932876804"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "740729421390413"}]}, "baseline_offer": {"id": "740729421390413"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1686329436, "status": "PUBLISHED", "id": "740729421390413"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "A
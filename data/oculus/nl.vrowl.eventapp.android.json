fect for events.\n\nLook & Play supports\n- Stereoscopic video playback and images\n- Monoscopic video playback and images\n- 2D video playback and images\n- TBE audio files\n- Custom branding\n- Various playback settings like pausing or restarting the video when the headset is taken off", "short_description": "Show VR Video's in a controlled environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrowl.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "VR Owl Solutions", "support_website_url": "https://www.lookandplay.io/", "website_url": "https://www.lookandplay.io/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "246641760982813"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1469894314067350"}, {"status": "PUBLISHED", "id": "570180544156173"}]}, "baseline_offer": {"id": "1469894314067350"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1758296520, "status": "PUBLISHED", "id": "1469894314067350"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25680780818176293", "version": "6.0.0"}, "id": "310463370574711", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary",
xq1Emri6U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2aeKD7P7L6DEfNk1jWa1kp0-LdBz09aDdv95TeKeqVg&oe=6A84335A"}, {"file_name": "Screen4.png", "id": "695718848533854", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75485574_695718855200520_1737588928327606534_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LEbfYn0NpdgQ7kNvwG9td58&_nc_oc=AdoHzFX6MJGxRziOB3MYv0Od6zeO5-Ue0TzI7PNQpDKQWcXzwTQorfxUuzuGJysrROo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvc95GJV3oe93r3uhTrIgG3M_PoH2PAKT_9rh0TO6uEQ&oe=6A8466A5"}, {"file_name": "Screen5.png", "id": "1157321061877632", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86840883_1157321065210965_6574959355805866250_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gN1Mzi1e9lgQ7kNvwGkRMDq&_nc_oc=AdqWaTlZX94Yy_mJXSXJLL0C1wE__MgB5A-cqfI7GzrwG8jmUbKFDTLUSTAtaTXXJfg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-2CeuoLvXW1QeM-DvFCJWbeFIhI0UeYE7xo7dQANfEg&oe=6A844260"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerImage.png", "id": "3242698369329072", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75530714_3242698372662405_5347729674535911183_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t2e-cr2TA70Q7kNvwFabc-2&_nc_oc=AdrpTftBD6JnCo5SWmfQ8zGnnQdOLWYTkPtOblbJMnJio5Q7xj0nXEv1rrB1pXlD1NU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7betM5-iZDT4Fjy6M0g8EuIk-ODf_TB2G-hYZSaQxIw&oe=6A8466A7"}, "display_name": "Bible Quest", "keywords": [], "long_description": "Welcome to Bible Quest, an immersive journey through different passages of the bible for believers and unbelievers alike. This game aims to put the users in virtual worlds according to biblical descriptions. The designed environments in this game are not meant to accurately replicate real life but instead a re-imaging of these locations and time to send the user to an unforgettable journey each time. \n\nThe game presents the user with the option to play the mini game in each environment which is a mini quiz on the passage being narrated. The user will have only one shot at the quiz and upon failing will need to restart the passage. \n\nAbout this game: The game will be updated often with more and more passages and added quiz game for the user's leisure and spiritual joy. Users can check monthly on this app for new updates or visit our website.", "short_description": "An immersive virtual journey to different biblical passages with added narration."}]}, "developer_name": "TRAINDZ LLC", "developer_privacy_policy_url": "https://www.traindz.com/biblequest", "developer_terms_of_service_url": null, "publisher_name": "TRAINDZ LLC", "support_website_url": null, "website_url": "https://www.traindz.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "DOCUMENTARY_HISTORY", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "659211902279004"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75404375_1752116878498648_5651937616097928577_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sgvtxqjxXWcQ7kNvwE9_iBt&_nc_oc=Adq7cWLOATdwhZHUesxiO0aZzYoVZayub-OKs40NQBoG6bCRWJiJM1_4pRP0moP8XK0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGWX89HkkRNxd4fkVZDsw8w38CYQaxccJ7TR3tl0XElyg&oe=6A845E93"}, "is_concept": f
=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4mU43bbmVtsQ7kNvwFA1Q2L&_nc_oc=AdrcwMLIIQTm1x6cQc5B761OjI4AJrlu_4qwrHLH8WIxu2I3mTqX2FUQzrwJjrK3IlU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6u-Hn6zfAMXoU0ryvuWs1uy3FR3ekxcrzmalmeT53d6w&oe=69FF441A"}, {"file_name": "Screen4.png", "id": "695718848533854", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75485574_695718855200520_1737588928327606534_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZbRmleYgTxQQ7kNvwFL5iGC&_nc_oc=AdptT7qsLltA_8xli7-o4wBusKU__l4xg-1MpMr_YIavXsFhG0NrcZyPOa9NzzAbJkY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5FsNNhS6t0FR-OHpxcDTsyBw-TbAD3KHXpIapnEAz9kw&oe=69FF3F25"}, {"file_name": "Screen5.png", "id": "1157321061877632", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86840883_1157321065210965_6574959355805866250_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NoZFopUUVIEQ7kNvwGDwZpV&_nc_oc=AdoGHQEAxJNheZxhCibPlKK2T-l-9IZ3_ixV37hRUYjKUquIn64eRrwwpHUIyZ9L14w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af56Z3JX7Px0p-kxV1vYl3XEM3_j9_7vIs3s1_SCeQIrZQ&oe=69FF5320"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerImage.png", "id": "3242698369329072", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75530714_3242698372662405_5347729674535911183_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TucbeeOytAkQ7kNvwF-xyKX&_nc_oc=AdraCh8nbLdJfpBfC3GNGK6X9XCKCSgRZZsb-iX4mfqZM5bK3eIR-kv9MEgL8uSboAE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7scTup8o-xSpPB7uD1jLFl5RoHBscMHlwc7RTkMRYd6g&oe=69FF3F27"}, "display_name": "Bible Quest", "keywords": [], "long_description": "Welcome to Bible Quest, an immersive journey through different passages of the bible for believers and unbelievers alike. This game aims to put the users in virtual worlds according to biblical descriptions. The designed environments in this game are not meant to accurately replicate real life but instead a re-imaging of these locations and time to send the user to an unforgettable journey each time. \n\nThe game presents the user with the option to play the mini game in each environment which is a mini quiz on the passage being narrated. The user will have only one shot at the quiz and upon failing will need to restart the passage. \n\nAbout this game: The game will be updated often with more and more passages and added quiz game for the user's leisure and spiritual joy. Users can check monthly on this app for new updates or visit our website.", "short_description": "An immersive virtual journey to different biblical passages with added narration."}]}, "developer_name": "TRAINDZ LLC", "developer_privacy_policy_url": "https://www.traindz.com/biblequest", "developer_terms_of_service_url": null, "publisher_name": "TRAINDZ LLC", "support_website_url": null, "website_url": "https://www.traindz.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "DOCUMENTARY_HISTORY", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "659211902279004"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75404375_1752116878498648_5651937616097928577_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4R_ktvE3CK4Q7kNvwEeosF9&_nc_oc=AdopJw2EHbwCneQPoMucYANpm9bv3KDra0HK-Sx4guuNqSylRVFCJ_7hV-55XkqQSNE&_nc_zt=3&_nc_ht=s
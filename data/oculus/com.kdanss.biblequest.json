=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fIDouyFzRtsQ7kNvwHxjsBY&_nc_oc=Adp9W1pRvtzuKc1Pp9z7gdOsK73PNHLwsg9W7udG4Kb1RhKqeKQjaCMk_czsI8MT-Bc&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7peM45HxdNeC2wyb8WT8eptI8n9iaQ9OMYpoO-KVEhJA&oe=6A09D01A"}, {"file_name": "Screen4.png", "id": "695718848533854", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75485574_695718855200520_1737588928327606534_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yy4KZ6aJnRMQ7kNvwHQ8Jgd&_nc_oc=AdpFswV84_yGlAdjKSegR7vGQXzeeGfAU7uwfimLoqWXnLxSeTENIV_t44DTDtBMu8Y&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7OsLCsLIbPBRP-VbnFlpqDRgGLpDzRzfrovOAJtWt6tg&oe=6A09CB25"}, {"file_name": "Screen5.png", "id": "1157321061877632", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/86840883_1157321065210965_6574959355805866250_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cQRN_M79MhAQ7kNvwFLQ7ZD&_nc_oc=AdqNHTSboI79t_ew_8r9ks5KdKjpb2nOYmIGUHakRcjkVivy3cPD0GhQ9Pou0PDJ_P0&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4TKHc2pSh3GYorynZLdheumZQ1d15DJrn0MK3Gb_xCEQ&oe=6A09DF20"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerImage.png", "id": "3242698369329072", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75530714_3242698372662405_5347729674535911183_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M_0tGotAgu8Q7kNvwF6hmJg&_nc_oc=Adr-JmydeDR7fRYoAOYjULqVr93oXb9_ys91UcgItCFRIpZBG_u1m-suIJg5l1b3s1Y&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ydvL-1jWNg671H7IApe1ENcoWlOYfQgV581_C3X7QZw&oe=6A09CB27"}, "display_name": "Bible Quest", "keywords": [], "long_description": "Welcome to Bible Quest, an immersive journey through different passages of the bible for believers and unbelievers alike. This game aims to put the users in virtual worlds according to biblical descriptions. The designed environments in this game are not meant to accurately replicate real life but instead a re-imaging of these locations and time to send the user to an unforgettable journey each time. \n\nThe game presents the user with the option to play the mini game in each environment which is a mini quiz on the passage being narrated. The user will have only one shot at the quiz and upon failing will need to restart the passage. \n\nAbout this game: The game will be updated often with more and more passages and added quiz game for the user's leisure and spiritual joy. Users can check monthly on this app for new updates or visit our website.", "short_description": "An immersive virtual journey to different biblical passages with added narration."}]}, "developer_name": "TRAINDZ LLC", "developer_privacy_policy_url": "https://www.traindz.com/biblequest", "developer_terms_of_service_url": null, "publisher_name": "TRAINDZ LLC", "support_website_url": null, "website_url": "https://www.traindz.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "DOCUMENTARY_HISTORY", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "659211902279004"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75404375_1752116878498648_5651937616097928577_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M3D4gfwnxLEQ7kNvwG5i0Jv&_nc_oc=AdoStCyacz6FDdMCo_HKDGaPJEWEt-JGvuGthblKG1IslwzC27ca3aHFgAx0DvF3P94&_nc_zt=3&_nc_ht=s
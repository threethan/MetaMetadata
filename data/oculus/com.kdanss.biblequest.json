VwOgo9HIHJ9TzhhZs&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1DZOGWo2JE_phD5XkXGsNsPdoSPkWmf0_SuqLNd6xSQ&oe=6AA40F9A"}, {"file_name": "Screen4.png", "id": "695718848533854", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75485574_695718855200520_1737588928327606534_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x-zCMXlK7eMQ7kNvwFlJJFR&_nc_oc=AdrgUOnUyj03HXODP6fyPNs0X19R8DlazSis99tq44OASmNXO0wZ2ZKsfUdBJ8XPzqs&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzM57A5ECR_-W8UILKr9UzTDvMDsE86hlpgGkDoqXULA&oe=6AA40AA5"}, {"file_name": "Screen5.png", "id": "1157321061877632", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/86840883_1157321065210965_6574959355805866250_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ovVi9dIrfXsQ7kNvwEH-43T&_nc_oc=AdoHiE75XHALq6-jKUDn6DvheUcEicHwA35evVX-P3Q8g4X2e5Agwye-kEe7wqGBEcU&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJe_QDH5RT-I23CKwqySeIy3gDjf78ZWWpNNAspzzKXdw&oe=6AA41EA0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerImage.png", "id": "3242698369329072", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75530714_3242698372662405_5347729674535911183_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6s9eMoy5KmwQ7kNvwFnfscO&_nc_oc=Ado1LjWUrLIyDEVKUbMt_hmZqEj6KTSemQF5J5xbDWrSuLyOvMxDEuWEWEEDsEiF6n4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9cSUFLPL7iS4TjOTppcMRalnS5tEEp6S4zqiyrbQzbw&oe=6AA40AA7"}, "display_name": "Bible Quest", "keywords": [], "long_description": "Welcome to Bible Quest, an immersive journey through different passages of the bible for believers and unbelievers alike. This game aims to put the users in virtual worlds according to biblical descriptions. The designed environments in this game are not meant to accurately replicate real life but instead a re-imaging of these locations and time to send the user to an unforgettable journey each time. \n\nThe game presents the user with the option to play the mini game in each environment which is a mini quiz on the passage being narrated. The user will have only one shot at the quiz and upon failing will need to restart the passage. \n\nAbout this game: The game will be updated often with more and more passages and added quiz game for the user's leisure and spiritual joy. Users can check monthly on this app for new updates or visit our website.", "short_description": "An immersive virtual journey to different biblical passages with added narration."}]}, "developer_name": "TRAINDZ LLC", "developer_privacy_policy_url": "https://www.traindz.com/biblequest", "developer_terms_of_service_url": null, "publisher_name": "TRAINDZ LLC", "support_website_url": null, "website_url": "https://www.traindz.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "DOCUMENTARY_HISTORY", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "659211902279004"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75404375_1752116878498648_5651937616097928577_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=umGvGkbsyTsQ7kNvwHAYt_h&_nc_oc=Adoe2lug7KtRPd77_xDSwcFen_Tq8Qig7KOBFVTofLbHtmjSIQciS1lTWkRkHYdsjZI&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0ljoS6Z9vBB2bGt1VWB1bEYaG-_WiONna4JNQPUDgpQ&oe=6AA40293"}, "is_c
Yi7jJHjixBCvVlyaw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKGCnH6_rfOoP_EMP8u4-2ZVUoBBgwzT8bnrt0vZoIxTA&oe=6AAE9B9A"}, {"file_name": "Screen4.png", "id": "695718848533854", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75485574_695718855200520_1737588928327606534_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GmpFu3y1rAcQ7kNvwEoY0Iq&_nc_oc=AdoPAQoq8XSDCtIvHnc6CbBhs4ka4WVwCvj0qZyuHAvp2YaCu16vocwkYmAb65Lq8Iw&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0ZURuY-bFaxE-VjC9P6sIbBxQG_Vnl9PRU6SrdtbWUg&oe=6AAE96A5"}, {"file_name": "Screen5.png", "id": "1157321061877632", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/86840883_1157321065210965_6574959355805866250_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NVKsm7iBygQQ7kNvwFeZ2Tr&_nc_oc=AdpkNIjV5T2GzF5bJXeMZOmRinXnrStIrviNXmQD9iDdiv-7Wn3I--hEuEgq598YjAE&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJImnlXgIqwu7t6z8KZBstXkm1mbjQXYoyko3zGQ-oCVA&oe=6AAEAAA0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerImage.png", "id": "3242698369329072", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75530714_3242698372662405_5347729674535911183_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NZqKs47cUEoQ7kNvwF-FSlj&_nc_oc=Adqk6UiWZp9cZ7SaMke1Or-5Bc4qrPkWI39Aa6CBBOIzkA57E8Rr2AufK2ZuZgQpMcM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5MnrkojEnt9hj9lqFNhI18E9NOJQq3esY8dhjyPkuAg&oe=6AAE96A7"}, "display_name": "Bible Quest", "keywords": [], "long_description": "Welcome to Bible Quest, an immersive journey through different passages of the bible for believers and unbelievers alike. This game aims to put the users in virtual worlds according to biblical descriptions. The designed environments in this game are not meant to accurately replicate real life but instead a re-imaging of these locations and time to send the user to an unforgettable journey each time. \n\nThe game presents the user with the option to play the mini game in each environment which is a mini quiz on the passage being narrated. The user will have only one shot at the quiz and upon failing will need to restart the passage. \n\nAbout this game: The game will be updated often with more and more passages and added quiz game for the user's leisure and spiritual joy. Users can check monthly on this app for new updates or visit our website.", "short_description": "An immersive virtual journey to different biblical passages with added narration."}]}, "developer_name": "TRAINDZ LLC", "developer_privacy_policy_url": "https://www.traindz.com/biblequest", "developer_terms_of_service_url": null, "publisher_name": "TRAINDZ LLC", "support_website_url": null, "website_url": "https://www.traindz.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "DOCUMENTARY_HISTORY", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "659211902279004"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75404375_1752116878498648_5651937616097928577_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=34Cni9nzsRAQ7kNvwFFOMy9&_nc_oc=Ado2VjKxdyQfz6YKh_B8wSDMrYZ4_4p1YDrG-vNsWnImcsUq4hsQ0FBg5CX1mNmClik&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPmgjUZ2u4v_LYHdCkypve5YV1LrzlT-Tk1jub-fLi_A&oe=6AAE8E93"}, "is_c
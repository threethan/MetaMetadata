5fsm4P73bpSruXBntYBW2G3qlno&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3afCofOZVnceNS87HSxBSHnemnmttj9TFydRTnDM86zw&oe=69F0D2A0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerImage.png", "id": "3242698369329072", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75530714_3242698372662405_5347729674535911183_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0mV3pqcV3o0Q7kNvwF8ktCn&_nc_oc=Adpm5tvCjIhLBZ3qSughm4zeiqXhSthpO0H9XAJbg4DwsVxM4SNEXaiBafLAS80fb5M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1z8Ngu-r20PhyPAqWmPuprCCod7CCf-NOMqI3TPjrbJQ&oe=69F0BEA7"}, "display_name": "Bible Quest", "keywords": [], "long_description": "Welcome to Bible Quest, an immersive journey through different passages of the bible for believers and unbelievers alike. This game aims to put the users in virtual worlds according to biblical descriptions. The designed environments in this game are not meant to accurately replicate real life but instead a re-imaging of these locations and time to send the user to an unforgettable journey each time. \n\nThe game presents the user with the option to play the mini game in each environment which is a mini quiz on the passage being narrated. The user will have only one shot at the quiz and upon failing will need to restart the passage. \n\nAbout this game: The game will be updated often with more and more passages and added quiz game for the user's leisure and spiritual joy. Users can check monthly on this app for new updates or visit our website.", "short_description": "An immersive virtual journey to different biblical passages with added narration."}]}, "developer_name": "TRAINDZ LLC", "developer_privacy_policy_url": "https://www.traindz.com/biblequest", "developer_terms_of_service_url": null, "publisher_name": "TRAINDZ LLC", "support_website_url": null, "website_url": "https://www.traindz.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"i
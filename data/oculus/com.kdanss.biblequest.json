JLi8UDb7U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMTPoS3CcwJrMHs7Vlj3vc72xxk6I8llqjfu63cXwANg&oe=6AC2621A"}, {"file_name": "Screen4.png", "id": "695718848533854", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75485574_695718855200520_1737588928327606534_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yCuLh0vtAJYQ7kNvwFpqA-B&_nc_oc=AdoCg4nySdT4xiWcZXfR0cEQ_Iya_OtJDIfooSTvtYVjve0Pnyl2hl8HTThsHFYd8XU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPAXImneaqSy0FTgy4FGM50xf_HSljTgsbD2PGT8fsvmg&oe=6AC25D25"}, {"file_name": "Screen5.png", "id": "1157321061877632", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86840883_1157321065210965_6574959355805866250_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CIN6JXKVAuYQ7kNvwFfUirV&_nc_oc=AdodtzlMHvv9vCgXKN-4lbX2QYr9YEyBKpEaGx9s14Efco7RhNaQwOVCV0Al83I_Hcw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNsNo_QDT8mas55ZefPws6K9yWJnaLRRTAUORliBcjSJA&oe=6AC27120"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerImage.png", "id": "3242698369329072", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75530714_3242698372662405_5347729674535911183_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xtvza-9h24AQ7kNvwEqUQIi&_nc_oc=AdovgKcKA2Wyq6aAvOJiPJNWZ6YxtH3a8RKOtRJAcdLqSW5oY3wVW6U0CO0u7g5hhwA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPz7jj2vM1Rv8B9bSb_wtlBkN83y9lLLY4cjbBxCfA_qA&oe=6AC25D27"}, "display_name": "Bible Quest", "keywords": [], "long_description": "Welcome to Bible Quest, an immersive journey through different passages of the bible for believers and unbelievers alike. This game aims to put the users in virtual worlds according to biblical descriptions. The designed environments in this game are not meant to accurately replicate real life but instead a re-imaging of these locations and time to send the user to an unforgettable journey each time. \n\nThe game presents the user with the option to play the mini game in each environment which is a mini quiz on the passage being narrated. The user will have only one shot at the quiz and upon failing will need to restart the passage. \n\nAbout this game: The game will be updated often with more and more passages and added quiz game for the user's leisure and spiritual joy. Users can check monthly on this app for new updates or visit our website.", "short_description": "An immersive virtual journey to different biblical passages with added narration."}]}, "developer_name": "TRAINDZ LLC", "developer_privacy_policy_url": "https://www.traindz.com/biblequest", "developer_terms_of_service_url": null, "publisher_name": "TRAINDZ LLC", "support_website_url": null, "website_url": "https://www.traindz.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "DOCUMENTARY_HISTORY", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "659211902279004"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75404375_1752116878498648_5651937616097928577_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sXz4xUJYzOEQ7kNvwFhL-ks&_nc_oc=AdpPv0Z319EnXIAyLx4_w6Htv1XSmCKglIzyw5V2lsgI-iEz3Kfno_DK6zWYsmiTavE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOR9OEy8Whn7rmyjvO_YRcBCv8uB9IaY5vLG8KZjkA9fA&oe=6AC25513"}, "is_concept": f
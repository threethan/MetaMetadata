b=1-7&_nc_sid=6e7a0a&_nc_ohc=2PX128kCmJQQ7kNvwFrxUFn&_nc_oc=AdkNPXJIdLOsN90iW0flHv9uPbfEf8QUGVfGFQx7cHI5Qo01YVjFhXGEWuSgmNz2jc0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwGB9Izdz8D1wmoTVm2aRtOXsDiZ-lt5tLhTDTkaEii2Q&oe=69B93B60"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerImage.png", "id": "3242698369329072", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75530714_3242698372662405_5347729674535911183_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=te4C2MqNcfkQ7kNvwEkMhql&_nc_oc=AdkmgBcsipeJI35f16gZ9MbzqI6bMDjeroH8EgDSQAeFocH5MdD-BMcRA943LBpeE1o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzU81paqcn_uKb6KsQx-AoG1Falx2bKrKONFA81mFfZdA&oe=69B95FA7"}, "display_name": "Bible Quest", "keywords": [], "long_description": "Welcome to Bible Quest, an immersive journey through different passages of the bible for believers and unbelievers alike. This game aims to put the users in virtual worlds according to biblical descriptions. The designed environments in this game are not meant to accurately replicate real life but instead a re-imaging of these locations and time to send the user to an unforgettable journey each time. \n\nThe game presents the user with the option to play the mini game in each environment which is a mini quiz on the passage being narrated. The user will have only one shot at the quiz and upon failing will need to restart the passage. \n\nAbout this game: The game will be updated often with more and more passages and added quiz game for the user's leisure and spiritual joy. Users can check monthly on this app for new updates or visit our website.", "short_description": "An immersive virtual journey to different biblical passages with added narration."}]}, "developer_name": "TRAINDZ LLC", "developer_privacy_policy_url": "https://www.traindz.com/biblequest", "developer_terms_of_service_url": null, "publisher_name": "TRAINDZ LLC", "support_website_url": null, "website_url": "http
b=1-7&_nc_sid=6e7a0a&_nc_ohc=TV-P25Z0fI8Q7kNvwG6z6Cd&_nc_oc=AdkDCi8e9vpy4THE3GygyrVY_Ua4M28vo5B4dWu9Zt4KOHDc7pOTUbzKJESyUCtP1jg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afttgm0GjivDZG5qkTr1U-0a1TtbXdoSBJuvOpTGu903RQ&oe=69A96960"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerImage.png", "id": "3242698369329072", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75530714_3242698372662405_5347729674535911183_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NP_6geoTXhUQ7kNvwEkQL_J&_nc_oc=AdlvYpHJA4rJ6sZnK37kyhvF2t2FZhyd5hVk4inoXJPR3LT3SF2fxbMdYSQYcRJCEL4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfspiOlb5GPCNGirYrCKFJeE74BFzvsHatHrdt-PP_gFNQ&oe=69A98DA7"}, "display_name": "Bible Quest", "keywords": [], "long_description": "Welcome to Bible Quest, an immersive journey through different passages of the bible for believers and unbelievers alike. This game aims to put the users in virtual worlds according to biblical descriptions. The designed environments in this game are not meant to accurately replicate real life but instead a re-imaging of these locations and time to send the user to an unforgettable journey each time. \n\nThe game presents the user with the option to play the mini game in each environment which is a mini quiz on the passage being narrated. The user will have only one shot at the quiz and upon failing will need to restart the passage. \n\nAbout this game: The game will be updated often with more and more passages and added quiz game for the user's leisure and spiritual joy. Users can check monthly on this app for new updates or visit our website.", "short_description": "An immersive virtual journey to different biblical passages with added narration."}]}, "developer_name": "TRAINDZ LLC", "developer_privacy_policy_url": "https://www.traindz.com/biblequest", "developer_terms_of_service_url": null, "publisher_name": "TRAINDZ LLC", "support_website_url": null, "website_url": "http
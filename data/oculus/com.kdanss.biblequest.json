rd5-2.oculuscdn.com/v/t64.5771-25/86840883_1157321065210965_6574959355805866250_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jMn-8hv4JFMQ7kNvwGjWZ2q&_nc_oc=AdomeG0-n3b_us8Qv9bF5hGR9gLPQDcldKE9eQ_z_h61fqRF2wg4COWk6G67ir-hL_8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRHm9UhnPd3WdErCMZEy-HK1kMmzzBJx_rBFEcqHalxg&oe=6AF72D20"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerImage.png", "id": "3242698369329072", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75530714_3242698372662405_5347729674535911183_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AYnt5wvbKlAQ7kNvwHqB3Tt&_nc_oc=AdrR8j5RyNKkS5XsLe2-TMvj-lnI1uB8afYZcB-Oqrxp-ReL-JGaNH__9FpJGASsJqQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzMg39Ne_sHiJVsCyxPZt0Pfiw3aI5PiQwRRt5_CVUpg&oe=6AF71927"}, "display_name": "Bible Quest", "keywords": [], "long_description": "Welcome to Bible Quest, an immersive journey through different passages of the bible for believers and unbelievers alike. This game aims to put the users in virtual worlds according to biblical descriptions. The designed environments in this game are not meant to accurately replicate real life but instead a re-imaging of these locations and time to send the user to an unforgettable journey each time. \n\nThe game presents the user with the option to play the mini game in each environment which is a mini quiz on the passage being narrated. The user will have only one shot at the quiz and upon failing will need to restart the passage. \n\nAbout this game: The game will be updated often with more and more passages and added quiz game for the user's leisure and spiritual joy. Users can check monthly on this app for new updates or visit our website.", "short_description": "An immersive virtual journey to different biblical passages with added narration."}]}, "developer_name": "TRAINDZ LLC", "developer_privacy_policy_url": "https://www.traindz.com/biblequest", "developer_ter
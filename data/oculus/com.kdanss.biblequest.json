b=1-7&_nc_sid=6e7a0a&_nc_ohc=ACbhhACrvQYQ7kNvwFHlz0M&_nc_oc=AdnroY_zmWp66Qp-XxLm3QI5BUfieQcCIRbu065GOZSh9WtGHIvyVVTrxOmX-I9tGSs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwoiWlYGrF4_OPxS3T7ZSZ9NPQj90FjGSJliT5tk2S0xA&oe=69B15260"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerImage.png", "id": "3242698369329072", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75530714_3242698372662405_5347729674535911183_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TXjPWFnlvRYQ7kNvwFA8ONs&_nc_oc=Adla-kS_P9Kik9LglKRsJ9CGZiiVwH7ZVT__tQklybtSabfDFd-Ntb-u2KV41doeAGc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy7Q6zAju3SAdo9129GJpPBsf19c_CIc7Lz7QtSdgB0gQ&oe=69B176A7"}, "display_name": "Bible Quest", "keywords": [], "long_description": "Welcome to Bible Quest, an immersive journey through different passages of the bible for believers and unbelievers alike. This game aims to put the users in virtual worlds according to biblical descriptions. The designed environments in this game are not meant to accurately replicate real life but instead a re-imaging of these locations and time to send the user to an unforgettable journey each time. \n\nThe game presents the user with the option to play the mini game in each environment which is a mini quiz on the passage being narrated. The user will have only one shot at the quiz and upon failing will need to restart the passage. \n\nAbout this game: The game will be updated often with more and more passages and added quiz game for the user's leisure and spiritual joy. Users can check monthly on this app for new updates or visit our website.", "short_description": "An immersive virtual journey to different biblical passages with added narration."}]}, "developer_name": "TRAINDZ LLC", "developer_privacy_policy_url": "https://www.traindz.com/biblequest", "developer_terms_of_service_url": null, "publisher_name": "TRAINDZ LLC", "support_website_url": null, "website_url": "http
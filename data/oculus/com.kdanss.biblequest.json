=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D3dM7e4X3d0Q7kNvwGqYdl6&_nc_oc=AdqnVLSdWHEkyBrCx0imOB6YY3IFHfhsxFlSIk9BX8ZlQOdZbOoiaysiWP0291eBUfc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5jnqxq02OwmoWNc__MGW3T1KdNlM1G5Sv53iHxXEEA0g&oe=69F9FE1A"}, {"file_name": "Screen4.png", "id": "695718848533854", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75485574_695718855200520_1737588928327606534_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U5sHhQ2FoJIQ7kNvwGND-HJ&_nc_oc=AdruKEOAdjqgm1ILaFGuWBc6jxCZyWcy94nR4IYoYfduL_vu0lKzY008dAOtKqmFt80&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ZdqI-CQqC3Uu9a9CFPH4Na13pukdxvie8DoOr_s52bg&oe=69F9F925"}, {"file_name": "Screen5.png", "id": "1157321061877632", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86840883_1157321065210965_6574959355805866250_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h9qgueCWJ4oQ7kNvwHpyVqb&_nc_oc=Adps8c9vnIIW0-lwO2-pFS_Cs3OAtacMKou5mjmyMH_qu-iaOfbn6S0wXW0i7GQse40&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4riZy61-Fqk7_5f-qB4CSdMz7v3b1-tKhVWmr89NUfnA&oe=69FA0D20"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerImage.png", "id": "3242698369329072", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75530714_3242698372662405_5347729674535911183_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IWzd0BYyW-UQ7kNvwEd4SfJ&_nc_oc=AdoC5VLcA1_z-S_cOFhf6oZ-ONa_S8z7-p4iOcH4lHnG2cYOyR0TD2wpjmLDPS9qsxQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7MGnQPTHvlRB7zXUf3FJ4GxTb4kOfG6ukmkF1ARElyhw&oe=69F9F927"}, "display_name": "Bible Quest", "keywords": [], "long_description": "Welcome to Bible Quest, an immersive journey through different passages of the bible for believers and unbelievers alike. This game aims to put the users in virtual worlds according to biblical descriptions. The designed environments in this game are not meant to accurately replicate real life but instead a re-imaging of these locations and time to send the user to an unforgettable journey each time. \n\nThe game presents the user with the option to play the mini game in each environment which is a mini quiz on the passage being narrated. The user will have only one shot at the quiz and upon failing will need to restart the passage. \n\nAbout this game: The game will be updated often with more and more passages and added quiz game for the user's leisure and spiritual joy. Users can check monthly on this app for new updates or visit our website.", "short_description": "An immersive virtual journey to different biblical passages with added narration."}]}, "developer_name": "TRAINDZ LLC", "developer_privacy_policy_url": "https://www.traindz.com/biblequest", "developer_terms_of_service_url": null, "publisher_name": "TRAINDZ LLC", "support_website_url": null, "website_url": "https://www.traindz.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "DOCUMENTARY_HISTORY", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "659211902279004"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75404375_1752116878498648_5651937616097928577_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w4pEwKxiUiQQ7kNvwFFm765&_nc_oc=AdocwCioYm9CRombKQg0lD0i7YOkrwY8TKz2x4Ga47b8ipOa7IFjaC6qEzHnumUHnxo&_nc_zt=3&_nc_ht=s
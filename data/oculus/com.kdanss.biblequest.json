51A"}, {"file_name": "Screen4.png", "id": "695718848533854", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75485574_695718855200520_1737588928327606534_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rjpvRj8LeZIQ7kNvwEG_i2M&_nc_oc=Adm4RZSy9G69DTMPWcxC755xbr78H0o8fm_y4bPJZI4_bddWx-lW0pnjxdaaQcMXVME&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv_O2WfOUWbxt5obuo7rmlbYvRVP7fxwK_v5InomfrO_g&oe=699DB025"}, {"file_name": "Screen5.png", "id": "1157321061877632", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86840883_1157321065210965_6574959355805866250_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XtJ9_xrpGSsQ7kNvwE06yIw&_nc_oc=AdnEItav74KrMUdJ2kDbbCTn0-Ah81O5uLpOIBrx3TLnklDoGmq6VhcG-rjXnw6PyaE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsYuHOllSX2h1RBx1E_Bp13m3lJKUMLGQEmceKqb8R_bQ&oe=699D8BE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerImage.png", "id": "3242698369329072", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75530714_3242698372662405_5347729674535911183_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0VK5Ul9_L8oQ7kNvwE53TrI&_nc_oc=AdkafOxJyfcYyFnW3x654VvdbZjg-OA5AbSxtxPlKGQ1_vSC8w3wXoN_SMpI9ZjbdgA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuwjnmbK6P1be3ONiAUoNGMuYLJziaXCG4RmOafR3YHSg&oe=699DB027"}, "display_name": "Bible Quest", "keywords": [], "long_description": "Welcome to Bible Quest, an immersive journey through different passages of the bible for believers and unbelievers alike. This game aims to put the users in virtual worlds according to biblical descriptions. The designed environments in this game are not meant to accurately replicate real life but instead a re-imaging of these locations and time to send the user to an unforgettable journey each time. \n\nThe game presents the user with the option to play the mini game in each environment which is a mini quiz on the passage being narrated. The user will have only one shot at the quiz and upon failing will need to restart the passage. \n\nAbout this game: The game will be updated often with more and more passages and added quiz game for the user's leisure and spiritual joy. Users can check monthly on this app for new updates or visit our website.", "short_description": "An immersive virtual journey to different biblical passages with added narration."}]}, "developer_name": "TRAINDZ LLC", "developer_privacy_policy_url": "https://www.traindz.com/biblequest", "developer_terms_of_service_url": null, "publisher_name": "TRAINDZ LLC", "support_website_url": null, "website_url": "https://www.traindz.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "DOCUMENTARY_HISTORY", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "659211902279004"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75404375_1752116878498648_5651937616097928577_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D7VBh8zV7EgQ7kNvwHb2r5z&_nc_oc=AdlMgqHajnrysvGf-VPco5LJO_uKY5gSIiZ9afxhfQKQfX8O4WUnv5OzF3tyFf7wA5o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsxSVf7eyFew24jIRlcJAidzFdO6zdcrOtz-hECcGB85Q&oe=699DA813"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Bible Quest", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "27433260359
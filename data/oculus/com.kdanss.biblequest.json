SwsoGXv_s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_mKE89JVu_2XUNl5umIIlB8iK7mEnj8hqKGyS_sxYKw&oe=6A3D3A9A"}, {"file_name": "Screen4.png", "id": "695718848533854", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75485574_695718855200520_1737588928327606534_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DIW7BiXtkLYQ7kNvwE-9gHK&_nc_oc=Adoi7nJAYblvGk0VefZ-8n40jFGcllUwlFISvba8oKDmo-PQd8ZSqMimx0tLQ7BVFM4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_JS0nfs26Z4mliUIiVgUFZ9AyrpXTXAJtakR18kxrM9g&oe=6A3D35A5"}, {"file_name": "Screen5.png", "id": "1157321061877632", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/86840883_1157321065210965_6574959355805866250_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DfMbKowMOZMQ7kNvwHOmnKW&_nc_oc=Adpi9u482X1i-TCzKl_0-ZkmR3XMeuOxzHnu4fmT9cSGi_SN6aBqWR0LC1x9Ow2K_eQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-HvE5xjkiM1Tp0VZaggj7sXoDuXzPNKobMHYRky6LKUw&oe=6A3D49A0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerImage.png", "id": "3242698369329072", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75530714_3242698372662405_5347729674535911183_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UafeVVKeKmgQ7kNvwG3ubPB&_nc_oc=AdrwRFk1tLnNlBsm_1xX4-dGClZ7DFsMl1ywy0j-1SaZiH5P2XNIFyifCy9q_npfFyQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8QSvEzrwA9gKFj-QgRRZrus6jDA-QFOa2ph41WhoPp-A&oe=6A3D35A7"}, "display_name": "Bible Quest", "keywords": [], "long_description": "Welcome to Bible Quest, an immersive journey through different passages of the bible for believers and unbelievers alike. This game aims to put the users in virtual worlds according to biblical descriptions. The designed environments in this game are not meant to accurately replicate real life but instead a re-imaging of these locations and time to send the user to an unforgettable journey each time. \n\nThe game presents the user with the option to play the mini game in each environment which is a mini quiz on the passage being narrated. The user will have only one shot at the quiz and upon failing will need to restart the passage. \n\nAbout this game: The game will be updated often with more and more passages and added quiz game for the user's leisure and spiritual joy. Users can check monthly on this app for new updates or visit our website.", "short_description": "An immersive virtual journey to different biblical passages with added narration."}]}, "developer_name": "TRAINDZ LLC", "developer_privacy_policy_url": "https://www.traindz.com/biblequest", "developer_terms_of_service_url": null, "publisher_name": "TRAINDZ LLC", "support_website_url": null, "website_url": "https://www.traindz.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "DOCUMENTARY_HISTORY", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "659211902279004"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75404375_1752116878498648_5651937616097928577_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=51QR2r916HcQ7kNvwHPY0GW&_nc_oc=AdplUt7FxhR5iiGZ89n9KBsiRMBqJ0tv0GsY4ypFDSo5mrW5v-5YJIjy3fFRcxwxg2U&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_x2XR7Oz9MzVyDloUBQ8rosASiulcNs55Oeu60StQ-5g&oe=6A3D2D93"}, "is_concept": f
lfKbFyK_o&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDkSEhnrqX__wbHV2gMqTISzvZhFvXdTKdYop7M03-UPQ&oe=6A5A3B9A"}, {"file_name": "Screen4.png", "id": "695718848533854", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75485574_695718855200520_1737588928327606534_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_4zzUvqUQdYQ7kNvwGimmgH&_nc_oc=AdqlpImM6ITPSCKaXzVTNkgqxZurz04KPvFAs4rqTr89ftjuVzdUCf__eEC0_OM9ks4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDC97cX6S9pLt1lrTFGsAT8_gH1QdIOoMv1U2pHoGuIjw&oe=6A5A36A5"}, {"file_name": "Screen5.png", "id": "1157321061877632", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/86840883_1157321065210965_6574959355805866250_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RTcuFJsNiTIQ7kNvwEzGOgf&_nc_oc=AdooceC2qQOCrReyknOhT_dOltzWWywO_qx1TfAvuS-uc37sQ6ll0jtzwet_Fu_NtEw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD1La82Mmv8pYvIqaXN4j8RWr62jYtamVp9y6db9GJ2ww&oe=6A5A1260"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerImage.png", "id": "3242698369329072", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75530714_3242698372662405_5347729674535911183_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o_wwX5vwj3IQ7kNvwFs8MpS&_nc_oc=Adp1mea0CUX-bSQshnySQxSbMv1Rs6NMtBm28t5fDre8FcyhXOYQx3qcpWeIvTHkjEY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAbqgx1mbyRvvCg84UIZcO2LLrZM71pKF-rwPR9UnZcdQ&oe=6A5A36A7"}, "display_name": "Bible Quest", "keywords": [], "long_description": "Welcome to Bible Quest, an immersive journey through different passages of the bible for believers and unbelievers alike. This game aims to put the users in virtual worlds according to biblical descriptions. The designed environments in this game are not meant to accurately replicate real life but instead a re-imaging of these locations and time to send the user to an unforgettable journey each time. \n\nThe game presents the user with the option to play the mini game in each environment which is a mini quiz on the passage being narrated. The user will have only one shot at the quiz and upon failing will need to restart the passage. \n\nAbout this game: The game will be updated often with more and more passages and added quiz game for the user's leisure and spiritual joy. Users can check monthly on this app for new updates or visit our website.", "short_description": "An immersive virtual journey to different biblical passages with added narration."}]}, "developer_name": "TRAINDZ LLC", "developer_privacy_policy_url": "https://www.traindz.com/biblequest", "developer_terms_of_service_url": null, "publisher_name": "TRAINDZ LLC", "support_website_url": null, "website_url": "https://www.traindz.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "DOCUMENTARY_HISTORY", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "659211902279004"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75404375_1752116878498648_5651937616097928577_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SWYNb-8vs1wQ7kNvwEV7vfB&_nc_oc=AdqpSk_arEwdGRCw-2NocxADpNVtywHGjRrdDIdC3DRwBnrPWSjl3SnTIZGFLv1FMb8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBpt253jO_e6-rq1076518d2EALkjwL7vXN-VPG6WjCXQ&oe=6A5A2E93"}, "is_concept": f
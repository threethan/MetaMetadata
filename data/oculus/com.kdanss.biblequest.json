SaEC0svoA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMtyRFX3B3gsqMAVDS-DfjMcttjteNxZuyFG7vyXe2dwA&oe=6AD2341A"}, {"file_name": "Screen4.png", "id": "695718848533854", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75485574_695718855200520_1737588928327606534_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_BrxEj4b7jIQ7kNvwEXpYJa&_nc_oc=AdrO6Pced12dxbWQCQVrSt-4_DbWtPH6xYg3WuPXc8EV-ZLc8wOe3oogJXnb5AZJHAE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMEpDFrPx7icjgxRCJIr89w-7OXg6dBOyy1lrUVvkqHLw&oe=6AD22F25"}, {"file_name": "Screen5.png", "id": "1157321061877632", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86840883_1157321065210965_6574959355805866250_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pkh1B1q0xOIQ7kNvwHr7gyj&_nc_oc=Adp1oou4IMNTn3dcYRi-jv0tJIGPvVkBnXVD5Lj06_vc61w5c7IJTwoHKjUZNcD7jNQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOOBFBV5CvbbO6p-X0ApJNUu2BicOU6wZ1PyMulqfftRg&oe=6AD24320"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerImage.png", "id": "3242698369329072", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75530714_3242698372662405_5347729674535911183_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JTNYfEaQXaUQ7kNvwGCunVW&_nc_oc=Adq7nF0mK7iwCrB9F8rMbs3nGu5JTgLo5lSyHoB41OPWDxHexoHFZvw_D8yWOoyRnQs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3ecxKkd7y-XbCtpeojqvYz8VEgGamzneWfQQra8-3vQ&oe=6AD22F27"}, "display_name": "Bible Quest", "keywords": [], "long_description": "Welcome to Bible Quest, an immersive journey through different passages of the bible for believers and unbelievers alike. This game aims to put the users in virtual worlds according to biblical descriptions. The designed environments in this game are not meant to accurately replicate real life but instead a re-imaging of these locations and time to send the user to an unforgettable journey each time. \n\nThe game presents the user with the option to play the mini game in each environment which is a mini quiz on the passage being narrated. The user will have only one shot at the quiz and upon failing will need to restart the passage. \n\nAbout this game: The game will be updated often with more and more passages and added quiz game for the user's leisure and spiritual joy. Users can check monthly on this app for new updates or visit our website.", "short_description": "An immersive virtual journey to different biblical passages with added narration."}]}, "developer_name": "TRAINDZ LLC", "developer_privacy_policy_url": "https://www.traindz.com/biblequest", "developer_terms_of_service_url": null, "publisher_name": "TRAINDZ LLC", "support_website_url": null, "website_url": "https://www.traindz.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "DOCUMENTARY_HISTORY", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "659211902279004"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75404375_1752116878498648_5651937616097928577_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TRfUAbzDgn4Q7kNvwEmwtAg&_nc_oc=AdpXLRGNbVMBWF_8Hm3luMsFOxjwugC-gj0DHg6QX-neat7mv6Ig9g8Cwo1cwLV2SOg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPKhf68syBoDouF2azTMUYMWJoNjTHKjsaKWtPstuCmvw&oe=6AD22713"}, "is_concept": f
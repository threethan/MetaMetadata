zzdYSIwds&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFcOyy0WeDqf4Oq7tDdKa2mLKWiCkbjilLOV9yMpZ-6w&oe=6A95C75A"}, {"file_name": "Screen4.png", "id": "695718848533854", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75485574_695718855200520_1737588928327606534_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4B3T1AiDi_wQ7kNvwFicQ6U&_nc_oc=AdovHzW4DEA0Hm0f0fnoSCXAOUyW1ywb6gL6Yta0rucVdZueFn854z9YXxXFWhpxBsA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH24et-Q10DUw_wp1gDrpyhefuol3w-_pw6ajHmt3Kypw&oe=6A95C265"}, {"file_name": "Screen5.png", "id": "1157321061877632", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86840883_1157321065210965_6574959355805866250_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=33xllhdxF3YQ7kNvwH6fRx4&_nc_oc=Adqb-bGLzRZrohgt-SS7kgCPa5VB2xBTz3ejMrx_wV-drPa-eRdDYzsFhSDzxLVE3kI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5aNsJ_eow5XZi-DAjzgJ4jrchL_GUqy3-2USoKAl4fA&oe=6A95D660"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerImage.png", "id": "3242698369329072", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75530714_3242698372662405_5347729674535911183_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xN57kmpcHPMQ7kNvwEnmnoY&_nc_oc=Adr2hzZ0PzTHj2Ina38xD79sZUNLQ-7dpejfPb_vBJU2dFc0qg60vWFpl-tGs4Mz5GQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2BUOO8t5BJWSY30EL75S_2WjtrXjO-6gYGTI9AvAn0g&oe=6A95C267"}, "display_name": "Bible Quest", "keywords": [], "long_description": "Welcome to Bible Quest, an immersive journey through different passages of the bible for believers and unbelievers alike. This game aims to put the users in virtual worlds according to biblical descriptions. The designed environments in this game are not meant to accurately replicate real life but instead a re-imaging of these locations and time to send the user to an unforgettable journey each time. \n\nThe game presents the user with the option to play the mini game in each environment which is a mini quiz on the passage being narrated. The user will have only one shot at the quiz and upon failing will need to restart the passage. \n\nAbout this game: The game will be updated often with more and more passages and added quiz game for the user's leisure and spiritual joy. Users can check monthly on this app for new updates or visit our website.", "short_description": "An immersive virtual journey to different biblical passages with added narration."}]}, "developer_name": "TRAINDZ LLC", "developer_privacy_policy_url": "https://www.traindz.com/biblequest", "developer_terms_of_service_url": null, "publisher_name": "TRAINDZ LLC", "support_website_url": null, "website_url": "https://www.traindz.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "DOCUMENTARY_HISTORY", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "659211902279004"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75404375_1752116878498648_5651937616097928577_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5d62jeQq0HIQ7kNvwEJnL1F&_nc_oc=AdpfRAF0KNspcS2kPOpf1DXyT7pST7DLut480UH0JAwOAM8jKTa06WE9klYYQechdtE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHzFumg8sZllB1q7MeZCeRUUNdUYB3MEUsfVWRv4DtTHg&oe=6A95BA53"}, "is_concept": f
=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=toTzQaIpd7wQ7kNvwGvoOzo&_nc_oc=Adrmntg9BeR8s5sAoyh7I6fAgzxoFw8jqHeiJ22hmrEQqULE5EwYfcZ8u5B0q-K1nEg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vVM_lq-fX9AQkBVG0SrI6QzXhndbU40w9vnGzjMixRg&oe=6A242E1A"}, {"file_name": "Screen4.png", "id": "695718848533854", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75485574_695718855200520_1737588928327606534_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kBUiRPnoLxsQ7kNvwE6J7Bf&_nc_oc=Ado6C-bjxuy0uvwY2BvYb8f5uKrSsrVvpSq3fv-5ec0cNDgjndm3hPJa6zKQjXI3qds&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_C_3TvE8AAHUghat06LzxOQOukvJWFCagGY86OO1T_8Q&oe=6A242925"}, {"file_name": "Screen5.png", "id": "1157321061877632", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/86840883_1157321065210965_6574959355805866250_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YR5JQb3ROToQ7kNvwH7EIr_&_nc_oc=Adpvh6o1WX1ZsrMg7Vry9l3XB47Cs-hrkyqbZpKwNeB7Efu_Mq9bSsnJNg3f_b19nDU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8NZpP_877XzYm6pNEw6QVNHgO-QKGUYIBWoO_u7Jrm2g&oe=6A243D20"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerImage.png", "id": "3242698369329072", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75530714_3242698372662405_5347729674535911183_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JsijJHcVs3UQ7kNvwFbFDCW&_nc_oc=AdoTzUbsS1tqYJz04aJeFUUrfEX_UOFQJ7Jki8o5PX3sNL7tIeNqbaG3o6uS7oVuzCU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Y5_a0mEEFkMnlGbaga8UJjhbFbD1FC5gY0JBPRJouFw&oe=6A242927"}, "display_name": "Bible Quest", "keywords": [], "long_description": "Welcome to Bible Quest, an immersive journey through different passages of the bible for believers and unbelievers alike. This game aims to put the users in virtual worlds according to biblical descriptions. The designed environments in this game are not meant to accurately replicate real life but instead a re-imaging of these locations and time to send the user to an unforgettable journey each time. \n\nThe game presents the user with the option to play the mini game in each environment which is a mini quiz on the passage being narrated. The user will have only one shot at the quiz and upon failing will need to restart the passage. \n\nAbout this game: The game will be updated often with more and more passages and added quiz game for the user's leisure and spiritual joy. Users can check monthly on this app for new updates or visit our website.", "short_description": "An immersive virtual journey to different biblical passages with added narration."}]}, "developer_name": "TRAINDZ LLC", "developer_privacy_policy_url": "https://www.traindz.com/biblequest", "developer_terms_of_service_url": null, "publisher_name": "TRAINDZ LLC", "support_website_url": null, "website_url": "https://www.traindz.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "DOCUMENTARY_HISTORY", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "659211902279004"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75404375_1752116878498648_5651937616097928577_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rm37PczOM-cQ7kNvwHKJ7nP&_nc_oc=AdoI_t3Zp3HL9FGlbxCVHt64Zn53VOItIf9KBff-N3wNlRez3PNFVP4u04qQHAHxNaY&_nc_zt=3&_nc_ht=s
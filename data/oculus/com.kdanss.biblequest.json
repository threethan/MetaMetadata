=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DBdpSAy4DywQ7kNvwGGp8Fa&_nc_oc=Adr-Y9znnoZzxGfSfTBNoGUL1HNU2DCL3uAb2-Koe1GU9Bov8y6Fc0RwyaKa0rvfcQM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2liM_SoFcrsxw65g7FYHdNJWv8NAK4GDTIYWr4jtIiag&oe=69EE209A"}, {"file_name": "Screen4.png", "id": "695718848533854", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75485574_695718855200520_1737588928327606534_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mSRV4sVqmH0Q7kNvwFuvFdl&_nc_oc=Adq9nq4cSka_cxJgy6ltCa-SI3GWXSAURPkord2aTDBxXZrDq-HSdmSxc3hNi0Zx-m4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af02HA5_JdqIiJe-NcX09gMTq2sC7c6S_mDEJK6Wqhxelg&oe=69EE1BA5"}, {"file_name": "Screen5.png", "id": "1157321061877632", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86840883_1157321065210965_6574959355805866250_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B4dJ3IeFynYQ7kNvwHxMNAt&_nc_oc=AdptSyK71PsUC7ugxcRPAVC0d5QOG9_cchEhE4ZXOWJaH9jXlRvziS1a6Sni0bvGCJo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2p5Q_dNvNyK96_j0PvCIaCm1U7YdAG7Y2rX-wqFYbBeg&oe=69EDF760"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerImage.png", "id": "3242698369329072", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75530714_3242698372662405_5347729674535911183_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0mV3pqcV3o0Q7kNvwHGH2Ms&_nc_oc=Adol7H8R7NFYLYZBYnqGtDsfvTxojGVIItpos9BkGQ6_cjqdwgUAnmmPwiHAHsbnh-U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af227F2pEEjOcpEPq1epWywkDGHa72nnqYYpsg040toRiw&oe=69EE1BA7"}, "display_name": "Bible Quest", "keywords": [], "long_description": "Welcome to Bible Quest, an immersive journey through different passages of the bible for believers and unbelievers alike. This game aims to put the users in virtual worlds according to biblical descriptions. The designed environments in this game are not meant to accurately replicate real life but instead a re-imaging of these locations and time to send the user to an unforgettable journey each time. \n\nThe game presents the user with the option to play the mini game in each environment which is a mini quiz on the passage being narrated. The user will have only one shot at the quiz and upon failing will need to restart the passage. \n\nAbout this game: The game will be updated often with more and more passages and added quiz game for the user's leisure and spiritual joy. Users can check monthly on this app for new updates or visit our website.", "short_description": "An immersive virtual journey to different biblical passages with added narration."}]}, "developer_name": "TRAINDZ LLC", "developer_privacy_policy_url": "https://www.traindz.com/biblequest", "developer_terms_of_service_url": null, "publisher_name": "TRAINDZ LLC", "support_website_url": null, "website_url": "https://www.traindz.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "DOCUMENTARY_HISTORY", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "659211902279004"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75404375_1752116878498648_5651937616097928577_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2LvGZVdR7TsQ7kNvwFwfW9-&_nc_oc=AdrKOFdqEiIRLIfe_TPSJ4FiDvdiMQ_a-5vE8uDf6nYA_jgK2vpwhN9W_rMMLQvW1U8&_nc_zt=3&_nc_ht=s
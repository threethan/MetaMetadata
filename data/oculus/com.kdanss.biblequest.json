=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D3dM7e4X3d0Q7kNvwHCWdfx&_nc_oc=AdpWlEhZROIDdy0zv0IvPx8PbLFJvoT_kLBmQIfxfYYmbORbWePu7cdTtPbl7JzJI7E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6m0-ezl4vjb8qO6JlJx6o4SBwnZnYpqY196XY9uvt7ZA&oe=69FB4F9A"}, {"file_name": "Screen4.png", "id": "695718848533854", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75485574_695718855200520_1737588928327606534_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U5sHhQ2FoJIQ7kNvwEBwDMu&_nc_oc=Adrm6Vpxn_4pRlZt1Q3EodnkawW3lBLb146HIP8VvwnJPffsCMjHI-54y1xhG_x4Ri0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5bg6wePp22km-DahGcS0pzYwkp-6ckX0MzQ9bIH8xfQg&oe=69FB4AA5"}, {"file_name": "Screen5.png", "id": "1157321061877632", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86840883_1157321065210965_6574959355805866250_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h9qgueCWJ4oQ7kNvwHcLOMQ&_nc_oc=Adokf3ru8w0lU9QsPwsWBHQmPAABqSZIpy8pO5wPFwOnA8WHPypgeIh3CP0b8dzKcuc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ie9vpgvVBncAwwdnOiMVrbm2w3prVQ2BcQ1j5MemThg&oe=69FB5EA0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerImage.png", "id": "3242698369329072", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75530714_3242698372662405_5347729674535911183_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IWzd0BYyW-UQ7kNvwGxbd11&_nc_oc=AdoQvZmAIH1-QZaZ2QpPvBRKOiAsCka31VhvnYLXjGEy1Cfo17_KU1JYo_kzRPl51TM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4q7_2WYqchuDvrZWNhI3phohPmFZOnXOiO6MGBDunNhw&oe=69FB4AA7"}, "display_name": "Bible Quest", "keywords": [], "long_description": "Welcome to Bible Quest, an immersive journey through different passages of the bible for believers and unbelievers alike. This game aims to put the users in virtual worlds according to biblical descriptions. The designed environments in this game are not meant to accurately replicate real life but instead a re-imaging of these locations and time to send the user to an unforgettable journey each time. \n\nThe game presents the user with the option to play the mini game in each environment which is a mini quiz on the passage being narrated. The user will have only one shot at the quiz and upon failing will need to restart the passage. \n\nAbout this game: The game will be updated often with more and more passages and added quiz game for the user's leisure and spiritual joy. Users can check monthly on this app for new updates or visit our website.", "short_description": "An immersive virtual journey to different biblical passages with added narration."}]}, "developer_name": "TRAINDZ LLC", "developer_privacy_policy_url": "https://www.traindz.com/biblequest", "developer_terms_of_service_url": null, "publisher_name": "TRAINDZ LLC", "support_website_url": null, "website_url": "https://www.traindz.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "DOCUMENTARY_HISTORY", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "659211902279004"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75404375_1752116878498648_5651937616097928577_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w4pEwKxiUiQQ7kNvwFwIWK4&_nc_oc=Adq2ShMd6SiklMTzOJgIxHqryWijQ_1s1twtkVkWGXAoVIWLpSgtW4KhqyUk9q_QOtE&_nc_zt=3&_nc_ht=s
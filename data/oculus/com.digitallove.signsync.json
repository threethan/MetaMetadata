qk92ALArpoIDmkQXSzsVkJ1HzsLmARTUWnzbH9fWXg3JozApnw55gU3dcyAm-nA1E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2lQLG5tOMU6wNtNbiImcrKkRp_IjnVYU6_fF0PFfvpMg&oe=69F09D85"}, {"file_name": "Screenshot 3.png", "id": "2030520227679685", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820887_2030520231013018_5579373603812150964_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GLLor9HB5FUQ7kNvwF0cE0D&_nc_oc=AdqU0B_rrO96qrslx3EJu6g54Z02StPGJ4tceb5IU8XaygluzETICs8kdLpoXJVic6Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1oaTP6s4TEwgeqplAFo-uVJgn_LBQSSpuWFlKRzyqigA&oe=69F0B7B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Hero Cover - Landscape.png", "id": "987485880607853", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499301053_987485883941186_5506142798775602524_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tco6UYeyeVQQ7kNvwFOzZq4&_nc_oc=AdpnzNuJTyxNJX_Gg8SWZWa4tONJ67WpFFn5LnPtcb3yn6gvZ0uauW-L6if-LHd4Eu0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1JKDp12u3qvFQ_m7Jp98usNJu_dC0uZQ78hQ_XOPh0Eg&oe=69F0B85C"}, "display_name": "Sign'n'Sync", "keywords": ["handtracking", "mixedreality", "rhythm", "music", "controllerfree"], "long_description": "Experience the next evolution of **Quest Hand Tracking**. Sign\u2019n\u2019Sync is a high-energy rhythm experience where your hands are the controller. Forget the buttons\u2014use 4 intuitive hand signs to interact with a digital world that glitches, pulses, and dissolves to the beat.\n\n### **CURRENT FEATURES**\n\n*   **Pure Hand Tracking:** Built from the ground up for a controller-free experience.\n    \n*   **Glitch-Dissolve Aesthetic:** Watch the environment react to your performance with unique real-time shaders.\n    \n*   **Two High-Energy Tracks:** Glitch-Pop Energy & Afro-Electronic Groove.\n        \n*   **Studio Mode:** Perfect for seated or standing play in any environment.\n    \n\n### **HOW TO PLAY**\n\nAs the rhythmic gates approach, match the 4 specific hand signs to the beat. Precision is key\u2014the better your timing, higher the score.\n\n### **ROADMAP**\n\nSign\u2019n\u2019Sync is a living project. We are starting with our core \"Studio Mode\" to ensure the Hand Tracking feels perfect. Coming soon in future updates:\n\n*   **\"Sync me to da Club\":** Transform your actual room into a reactive venue using Spatial Data.\n    \n*   **Expanded Setlist:** More tracks ranging from Lo-Fi to Hardcore Electronic.\n    \n*   **Complex Signs:** New gestures to master as the BPM rises.\n    \n\n**Sync up. Sign on. Start the beat.**", "short_description": "Sync your hands. Master the rhythm. Welcome to Sign\u2019n\u2019Sync. Experience the next level of Quest hand-tracking with a unique glitch-dissolve aesthetic. \n\nUse 4 intuitive signs to interact with a digital landscape that pulses to the beat of high-energy electronic tracks. Launching with two energetic launch tracks (128 & 140 BPM). \n\nController-free, immersive, and built for the flow. More tracks and 'Club Mode' coming soon!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/signsync-privacypolicy/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Digital Love", "support_website_url": null, "website_url": "https://sites.google.com/view/digital-love-landing-page/contact-us", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26417277697911703"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821725_1213275393988793_3449148976761924237_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kAGNZfTx0GYQ7kNvwG4rbhi&_nc_oc=AdrNolX0O_xKjixjAwz2DwNs7Lkputy8OZzg90j1DCXg8sWMbHQ7c6km1frdYcOWFq0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3F2hg0ZPH6GYtyO6RVZ8N0Iz_hcVQxxdS1KCpTfJBDAA&oe=69F09D2C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Sign'n'Sync", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Rhythm", "id": "1672577396871977"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1775672580, "lastRevision": {"nodes": [{"id": "26386454184327388", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "26386454114327395", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "2694042864302426"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "Hero Cover - Portrait.png", "id": "26586096970986641", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820387_26586096990986639_8299550698488727252_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mjx3BB1elUUQ7kNvwHShx-1&_nc_oc=Adqcu1ua40_JgsL9CHwIzyAbPH8wRIURvDs1Fb8JVvhbaippatrknUwGe0oYraPIaiY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2JJv-2oBBz3CniAED3hxoOLTpJs3m7IOh5E8FVGa-zwg&oe=69F0C30C"}, {"file_name": "Icon fadsaf.png", "id": "2040529896819116", "image_type": "APP_IMG_ICON", "uri": "https://sc
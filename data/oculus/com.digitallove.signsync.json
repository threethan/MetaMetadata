43148672188_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kit3YZO9bVcQ7kNvwEJMk4b&_nc_oc=AdoCpHNsSLfB_dMSPsdJkCJGsVNe_KlTMUzeUYOb_lrL6ByYDQmQMcU2MIvMynFo_s8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af59jJcP1Qpi2D9GA6QcbOCjnzC46sh3V7o7HvzNOYSs2Q&oe=6A006F85"}, {"file_name": "Screenshot 3.png", "id": "2030520227679685", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820887_2030520231013018_5579373603812150964_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n2pnvBz0QKoQ7kNvwGBLMJx&_nc_oc=Ado08lm6cLjGyye4CZA7Z_KkotsBgC_gY5ploJhq794i7zzfvK-30yMh9xXS0cRb5WI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6s6nUcvoTpSkIdBakRGo-ghDWeBwgrpYgekEcSPIuQ0w&oe=6A0089B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Hero Cover - Landscape.png", "id": "4582158552045108", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499305050_4582158555378441_1009529458867220250_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r-0Jl8JpumwQ7kNvwEkuk-V&_nc_oc=AdrhfTcfgUcbwHMSG4KeuWl-lyzyeDrKOOxMuqpYuqdcOuaKoTAvnGGk_QdlQuhlp1g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7cK2DXJ9WTW29YkbfoTVqyxKxijYLVEb_qlG3MrJODnw&oe=6A00903F"}, "display_name": "Sign'n'Sync", "keywords": ["handtracking", "mixedreality", "rhythm", "music", "controllerfree"], "long_description": "Experience the next evolution of **Quest Hand Tracking**. Sign\u2019n\u2019Sync is a high-energy rhythm experience where your hands are the controller. Forget the buttons\u2014use 4 intuitive hand signs to interact with a digital world that glitches, pulses, and dissolves to the beat.\n\n### **CURRENT FEATURES**\n\n*   **Pure Hand Tracking:** Built from the ground up for a controller-free experience.\n    \n*   **Glitch-Dissolve Aesthetic:** Watch the environment react to your performance with unique real-time shaders.\n    \n*   **Two High-Energy Tracks:** Glitch-Pop Energy & Afro-Electronic Groove.\n        \n*   **Studio Mode:** Perfect for seated or standing play in any environment.\n    \n\n### **HOW TO PLAY**\n\nAs the rhythmic gates approach, match the 4 specific hand signs to the beat. Precision is key\u2014the better your timing, higher the score.\n\n### **ROADMAP**\n\nSign\u2019n\u2019Sync is a living project. We are starting with our core \"Studio Mode\" to ensure the Hand Tracking feels perfect. Coming soon in future updates:\n\n*   **\"Sync me to da Club\":** Transform your actual room into a reactive venue using Spatial Data.\n    \n*   **Expanded Setlist:** More tracks ranging from Lo-Fi to Hardcore Electronic.\n    \n*   **Complex Signs:** New gestures to master as the BPM rises.\n    \n\n**Sync up. Sign on. Start the beat.**", "short_description": "Sync your hands. Master the rhythm. Welcome to Sign\u2019n\u2019Sync. Experience the next level of Quest hand-tracking with a unique glitch-dissolve aesthetic. \n\nUse 4 intuitive signs to interact with a digital landscape that pulses to the beat of high-energy electronic tracks. Launching with two energetic launch tracks (128 & 140 BPM). \n\nController-free, immersive, and built for the flow. More tracks and 'Club Mode' coming soon!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/signsync-privacypolicy/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Digital Love", "support_website_url": null, "website_url": "https://sites.google.com/view/digital-love-landing-page/contact-us", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proces
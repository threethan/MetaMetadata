0_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PMsHRrGVquoQ7kNvwG-Q2tl&_nc_oc=AdqxkuFleXnLqwTAOmI_xTQDOFunQ7P0pAcyscoQVm0FkGB-mv46gUEMe4yTOQ6zDp4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlkSpSdI5jEpOvgH6bPwmkY03LI5JYKb7j4X5tWt1ofQ&oe=6B06F702"}, {"file_name": "Screenshot 2.png", "id": "4492670527670916", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307433_4492670531004249_3892191243148672188_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PKSKEnR1WE0Q7kNvwGBnKeB&_nc_oc=AdpDr3mIlmtHv9jhAdhngnPWqF5u_H1i4OuI4OL7TIg_gp2BZspekv58dlK61_nMZhw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUSLopLtlUlDj5jEV1sneeBf074DfvkXhOvY7cXA6MWw&oe=6B070245"}, {"file_name": "Screenshot 3.png", "id": "2030520227679685", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820887_2030520231013018_5579373603812150964_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YULYdLj22QoQ7kNvwHcxlzJ&_nc_oc=Adp5SokfQWEj71GUrwORQLxHmZJiDgtGYRXZVsbFCo7dAo3el93ZGYWGWKeJdK2DIYM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjRX7f3nNEg6acAQMS46r7ARaxZ2nIOe65tWjnn6Z5gg&oe=6B071C70"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Hero Cover - Landscape.png", "id": "4582158552045108", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499305050_4582158555378441_1009529458867220250_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V8VJd1QeBR0Q7kNvwGEAVDN&_nc_oc=AdqxmaE6-hmFH7Sok9KnZtl7VIGQgdAtFXbQYCClNXMS0zch7rVnPjBv8xU2ebjLaVI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMGz2NZS_Orhtt7YXZlkC07fmHRgQW7A5MgdIqeGE9rQ&oe=6B0722FF"}, "display_name": "Sign'n'Sync", "keywords": ["handtracking", "mixedreality", "rhythm", "music", "controllerfree"], "long_description": "Experience the next evolution of **Quest Hand Tracking**. Sign\u2019n\u2019Sync is a high-energy rhythm experience where your hands are the controller. Forget the buttons\u2014use 4 intuitive hand signs to interact with a digital world that glitches, pulses, and dissolves to the beat.\n\n### **CURRENT FEATURES**\n\n*   **Pure Hand Tracking:** Built from the ground up for a controller-free experience.\n    \n*   **Glitch-Dissolve Aesthetic:** Watch the environment react to your performance with unique real-time shaders.\n    \n*   **Two High-Energy Tracks:** Glitch-Pop Energy & Afro-Electronic Groove.\n        \n*   **Studio Mode:** Perfect for seated or standing play in any environment.\n    \n\n### **HOW TO PLAY**\n\nAs the rhythmic gates approach, match the 4 specific hand signs to the beat. Precision is key\u2014the better your timing, higher the score.\n\n### **ROADMAP**\n\nSign\u2019n\u2019Sync is a living project. We are starting with our core \"Studio Mode\" to ensure the Hand Tracking feels perfect. Coming soon in future updates:\n\n*   **\"Sync me to da Club\":** Transform your actual room into a reactive venue using Spatial Data.\n    \n*   **Expanded Setlist:** More tracks ranging from Lo-Fi to Hardcore Electronic.\n    \n*   **Complex Signs:** New gestures to master as the BPM rises.\n    \n\n**Sync up. Sign on. Start the beat.**", "short_description": "Sync your hands. Master the rhythm. Welcome to Sign\u2019n\u2019Sync. Experience the next level of Quest hand-tracking with a unique glitch-dissolve aesthetic. \n\nUse 4 intuitive signs to interact with a digital landscape that pulses to the beat of high-energy electronic tracks. Launching with two energetic launch tracks (128 & 140 BPM). \n\nController-free, immersive, and built for the flow. More tracks and 'Club Mode' coming soon!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/signsync-privacypolicy/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Digital Love", "support_website_url": null, "website_url": "https://sites.google.com/view/digital-love-landing-page/contact-us", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26607797558859715"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307931_1959218801627172_8119164278277319101_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CgAGQkyCN2AQ7kNvwF3veAA&_nc_oc=AdoRzMYlIMr2c-fS5MOBbaPuh1h9_5fwORwXF5EsmI9xshhWYzIJZJ40AG2SGsBVFcc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZ2zIOxdr222GdhwrimrF3oMkTdsY0bPYpjaeBVazLXg&oe=6B071052"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Sign'n'Sync", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Rhythm", "id": "1672577396871977"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1775672580, "lastRevision": {"nodes": [{"id": "26386454184327388", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "26386454114327395", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "
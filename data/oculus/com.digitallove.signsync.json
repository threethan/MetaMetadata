Jojv0aR76rPR0s7KRqCssnBIRGk4Bdjv-w&oe=6AF1EA45"}, {"file_name": "Screenshot 3.png", "id": "2030520227679685", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820887_2030520231013018_5579373603812150964_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pb6IqZdLs90Q7kNvwGYf0jH&_nc_oc=AdogkyB8hDcnqmrHk7z-hkqVKHEnmJgqHnt-qetqEyjKKMc7dckg-UTMpulp9_jUhj0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDBlfvFpjdj6jZFQzdRpXwLTm7fNZ3q8WKsdvDKFLIuA&oe=6AF20470"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Hero Cover - Landscape.png", "id": "987485880607853", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499301053_987485883941186_5506142798775602524_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i6OKFOyVjWoQ7kNvwGu9ByB&_nc_oc=AdptYC8ALoQ019SKg6x2P0l5T9H7FspP6suX2XGTNX9_S6n78a6jXlVjijK6fPCB9WQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYeqQpJENZQZ7kXRbSK3dJv0oO9ICzj7xMJKVzA-2oOA&oe=6AF2051C"}, "display_name": "Sign'n'Sync", "keywords": ["handtracking", "mixedreality", "rhythm", "music", "controllerfree"], "long_description": "Experience the next evolution of **Quest Hand Tracking**. Sign\u2019n\u2019Sync is a high-energy rhythm experience where your hands are the controller. Forget the buttons\u2014use 4 intuitive hand signs to interact with a digital world that glitches, pulses, and dissolves to the beat.\n\n### **CURRENT FEATURES**\n\n*   **Pure Hand Tracking:** Built from the ground up for a controller-free experience.\n    \n*   **Glitch-Dissolve Aesthetic:** Watch the environment react to your performance with unique real-time shaders.\n    \n*   **Two High-Energy Tracks:** Glitch-Pop Energy & Afro-Electronic Groove.\n        \n*   **Studio Mode:** Perfect for seated or standing play in any environment.\n    \n\n### **HOW TO PLAY**\n\nAs the rhythmic gates approach, match the 4 specific hand signs to the beat. Precision is key\u2014the better your timing, higher the score.\n\n### **ROADMAP**\n\nSign\u2019n\u2019Sync is a living project. We are starting with our core \"Studio Mode\" to ensure the Hand Tracking feels perfect. Coming soon in future updates:\n\n*   **\"Sync me to da Club\":** Transform your actual room into a reactive venue using Spatial Data.\n    \n*   **Expanded Setlist:** More tracks ranging from Lo-Fi to Hardcore Electronic.\n    \n*   **Complex Signs:** New gestures to master as the BPM rises.\n    \n\n**Sync up. Sign on. Start the beat.**", "short_description": "Sync your hands. Master the rhythm. Welcome to Sign\u2019n\u2019Sync. Experience the next level of Quest hand-tracking with a unique glitch-dissolve aesthetic. \n\nUse 4 intuitive signs to interact with a digital landscape that pulses to the beat of high-energy electronic tracks. Launching with two energetic launch tracks (128 & 140 BPM). \n\nController-free, immersive, and built for the flow. More tracks and 'Club Mode' coming soon!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/signsync-privacypolicy/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Digital Love", "support_website_url": null, "website_url": "https://sites.google.com/view/digital-love-landing-page/contact-us", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26386454154327391"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2976836359155417"}]}, "baseline_offer": {"id": "2976836359155417"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1775672580, "status": "PUBLISHED", "id": "2976836359155417"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26559818296990975", "version": "1.0.4"}, "id": "1496705005414469", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26386454114327395", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26559818296990975"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1496705005414469"}]}, "change_log": null, "created_date": 1776968405, "id": "26559818296990975", "version": "1.0.4", "version_code": 4, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26386454114327395", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26559818296990975"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1496705005414469"}]}, "change_log": null, "created_date": 1776354174, "id": "26484030284569777", "version": "1.0.3", "version_code": 3, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {
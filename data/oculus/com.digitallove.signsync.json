oculuscdn.com&_nc_ss=7f20f&oh=00_AQOVuLb9Stsc6NrToZyLjO3ahtPeYaixRJgQoHjm6OV4bQ&oe=6ADF6A02"}, {"file_name": "Screenshot 2.png", "id": "4492670527670916", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307433_4492670531004249_3892191243148672188_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O8bUaimEevMQ7kNvwGXV0NR&_nc_oc=AdoeZk_9LmeZ51BNS6uY6jYrdqfg2_ulDVrEv1u9L1NAUhXUV1UIjJ_J7NMReO2RA7U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMmFIDyI6W-2rqK4vTUCzP87AFca1gaghALvFOKM4mkwA&oe=6ADF7545"}, {"file_name": "Screenshot 3.png", "id": "2030520227679685", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820887_2030520231013018_5579373603812150964_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cfHBtGOwJAAQ7kNvwH2lGPe&_nc_oc=AdoRJbTljqLNpwIXlRGfC_cm-4fDlDTCz1J9TyjVGcYx7THxXHdHPsl163YYYGpTkrs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPfpADi5eVvpZLqZqC34bUVw6CZn1FE-Wxfesu86T_62Q&oe=6ADF5730"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Hero Cover - Landscape.png", "id": "4582158552045108", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499305050_4582158555378441_1009529458867220250_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gwbtf3StGLEQ7kNvwHiQpEZ&_nc_oc=AdpsXTgPg5tn7I2TkDWJBoJ0G_0FVwDAEVIF0MDL9K7gKh5sHQG5b_EeVSl0J30gf9Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN_A9XrtsQE_GVvoYEnwPjtB5XuZ1eAqd310oJfdZ1Kjg&oe=6ADF5DBF"}, "display_name": "Sign'n'Sync", "keywords": ["handtracking", "mixedreality", "rhythm", "music", "controllerfree"], "long_description": "Experience the next evolution of **Quest Hand Tracking**. Sign\u2019n\u2019Sync is a high-energy rhythm experience where your hands are the controller. Forget the buttons\u2014use 4 intuitive hand signs to interact with a digital world that glitches, pulses, and dissolves to the beat.\n\n### **CURRENT FEATURES**\n\n*   **Pure Hand Tracking:** Built from the ground up for a controller-free experience.\n    \n*   **Glitch-Dissolve Aesthetic:** Watch the environment react to your performance with unique real-time shaders.\n    \n*   **Two High-Energy Tracks:** Glitch-Pop Energy & Afro-Electronic Groove.\n        \n*   **Studio Mode:** Perfect for seated or standing play in any environment.\n    \n\n### **HOW TO PLAY**\n\nAs the rhythmic gates approach, match the 4 specific hand signs to the beat. Precision is key\u2014the better your timing, higher the score.\n\n### **ROADMAP**\n\nSign\u2019n\u2019Sync is a living project. We are starting with our core \"Studio Mode\" to ensure the Hand Tracking feels perfect. Coming soon in future updates:\n\n*   **\"Sync me to da Club\":** Transform your actual room into a reactive venue using Spatial Data.\n    \n*   **Expanded Setlist:** More tracks ranging from Lo-Fi to Hardcore Electronic.\n    \n*   **Complex Signs:** New gestures to master as the BPM rises.\n    \n\n**Sync up. Sign on. Start the beat.**", "short_description": "Sync your hands. Master the rhythm. Welcome to Sign\u2019n\u2019Sync. Experience the next level of Quest hand-tracking with a unique glitch-dissolve aesthetic. \n\nUse 4 intuitive signs to interact with a digital landscape that pulses to the beat of high-energy electronic tracks. Launching with two energetic launch tracks (128 & 140 BPM). \n\nController-free, immersive, and built for the flow. More tracks and 'Club Mode' coming soon!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/signsync-privacypolicy/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Digital Love", "support_website_url": null, "website_url": "https://sites.google.com/view/digital-love-landing-page/contact-us", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id":
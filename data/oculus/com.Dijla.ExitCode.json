idden Island Escape, a free treat The Architect left just for you. Use your voice, hands, and intuition to feel and think your way out. "}]}, "developer_name": "Dijla Ventures LLC", "developer_privacy_policy_url": "https://www.dijla.ventures/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Dijla Ventures LLC", "support_website_url": null, "website_url": "https://www.dijla.ventures/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9938439599593284"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1796058941318434"}]}, "baseline_offer": {"id": "1796058941318434"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1754068920, "status": "PUBLISHED", "id": "1796058941318434"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25318807787796549", "version": "1.1.5"}, "id": "2111861009293518", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9567798609990720", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25318807787796549"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"
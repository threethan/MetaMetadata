syIttgP5anD1vCCB7XpDJrJ0g&oe=69AD6E04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "1361975021541760", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617801_1361975024875093_3526377026769404734_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9SFE9PC8_VAQ7kNvwG1NQEC&_nc_oc=Adl6BvATXeXqHeVVLSMG5HVcN4vFwksxfFEQvsBuVViE2S_F-dQJpcz-QwYBzjCYfwg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx4nY2VdQm-JG5rgrE74SLNM9vp2fDj3pmhUVQNCNIZbg&oe=69AD7272"}, "display_name": "Exit Code: Immersive Escape Rooms", "keywords": ["puzzle", "escape", "room", "brain", "teaser"], "long_description": "Stuck or hit a bug? Join the Discord! \u27a1\ufe0fhttps://discord.gg/Ww8B8zWwC9\u2b05\ufe0f\n# Prepare to escape with more than just your mind.\n\nSolve mind-bending, tactile puzzles in immersive VR escape rooms like The Windmill and The Spaceship\u2014and uncover the hidden Island Escape, a free treat The Architect left just for you. Use your voice, hands, and intuition to find your way out.\n\nEach experience is built to make you feel the room around you\u2014not just observe it. Whether you're whispering secret codes, aligning reflections, or decoding abstract clues, every moment keeps you immersed, engaged, and thinking on your feet.\n\n{1749594695952331}", "short_description": "Solve mind-bending, tactile puzzles in immersive VR escape rooms like The Windmill and The Spaceship\u2014and uncover the hidden Island Escape, a free treat The Architect left just for you. Use your voice, hands, and intuition to feel and think your way out. "}]}, "developer_name": "Dijla Ventures LLC", "developer_privacy_policy_url": "https://www.dijla.ventures/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Dijla Ventures LLC", "support_website_url": null, "website_url": "https://www.dijla.ventures/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id"
&oe=6B0C671A"}, {"file_name": "Screenshots3.png", "id": "757429350350024", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307451_757429353683357_2736947763179735928_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xffC6vUQ_IYQ7kNvwEc0hLI&_nc_oc=AdoiTEVoagSbyWl66gfmb1Id0KHc-y1_sOPVtt1-6zvQEROvOkwc1HQn-4wO9ePZBZs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQLLNOgznitSGUfluRBQWucWFkTkPZn07oZuEGFC7oJXA&oe=6B0C69F6"}, {"file_name": "Screenshots4.png", "id": "714584334632615", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307339_714584337965948_756089193903700206_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=58Fm26rEizYQ7kNvwGbBmyk&_nc_oc=AdoSuSnGIP2lMAaeSDMb0VJELD4r9GjelOnYV9NMUi88ew-6rCBeeXUg7t02KEFR6e8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRAxA5LBKq9aoB-H_2kN2RlMEa9inprn5gFWooQq8oXZg&oe=6B0C6E5D"}, {"file_name": "Screenshots5.png", "id": "1692606038051890", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499294609_1692606041385223_7311663872795730471_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IJYAM_Pvlv0Q7kNvwErK_Y3&_nc_oc=Adrz-JjWl9vqZCVuEg91TAeIlYUESBv0qDDGMSVQFZtUZjzygzqe8qGSFZYqCYBX5uU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQStSdIRPjexKxJ3V9yToJdfUA2z32HBnWHfvisbW-oUTA&oe=6B0C56EA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Music Player", "keywords": ["music", "musica"], "long_description": "**Introduction:** To start using the Music Player app, you must first create a folder named \"Music\" in your Meta Quest device's storage. Add all your music files to this folder; the app will automatically detect and load your music library from this location. Make sure your audio files are in supported formats for an optimal playback experience.\n\n**Supported Formats:** \n\nMP3, AAC, M4A, FLAC, WAV, OGG, Opus, AIFF, ALAC, WMA, MP4, 3GP, AMR\n\nThis music player is designed specifically for Meta Quest devices, offering an intuitive interface that feels natural in virtual reality. Navigate your music collection using hand gestures, with all UI elements positioned for comfortable viewing and interaction. The interface adapts perfectly to both Quest models, maintaining fluid performance.\n\n**Key Features:** The app offers high-quality audio playback, accessibility options including adjustable text size and contrast, and comprehensive playback controls. It has local notifications that keep you informed about the playback status.", "short_description": "2D app to play music."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1hOutoFiRGNYRfc_vhdgDf0BcgeGzC8tQKl0RhOLaN1g/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Pop Software Developer", "support_website_url": null, "website_url": "https://sites.google.com/d/1CE3OA7Yibm3NwSC2rzVwwqlIwO83JeWo/p/16X8NfTUO3M-jyfPMH6t4G9NnoENQcHXs/edit", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24083912824538283"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "710634561926063"}]}, "baseline_offer": {"id": "710634561926063"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1751323080, "status": "PUBLISHED", "id": "7106345619260
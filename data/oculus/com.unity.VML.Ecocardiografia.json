82683536363_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ag70ZxlEG4wQ7kNvwH9utMm&_nc_oc=Adphkv2Em83RldoZD50W1Kr4NH2oksa7cgfhviq8ccrx2iBUwBGA37cUmNnPEs_RSjs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA7R0DqJDXXFQj57Bliyf30nqQeX6ug2Qnn-1_Zk2CBQA&oe=6A68930E"}, {"file_name": "ecocardio-Screenshot-003.png", "id": "663923902976794", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393984_663923906310127_5574735863383485136_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VbxWY37A5bsQ7kNvwGBPsDk&_nc_oc=AdoKmFSp2t6m8VTFss576-i6_avT7s-qeJTKKhY1HhEndLegiZ4McqlidLWVFx3tdhM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBRft_t1h4H4CpIQ4xV6TjLbPDC9VUN9tiOzMNCuRSyGg&oe=6A689B99"}, {"file_name": "ecocardio-Screenshot-005.png", "id": "590596830460245", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391890_590596833793578_6307124770371399137_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mCXSVWbLdtIQ7kNvwFgccs1&_nc_oc=AdpVHOnbd6sD4E2nAPumd-rq2UEYfTVwpfFUIwQ0b5lTlwI8RbZ1_04Xwq91VuLgWnk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDz2igILIGlMOBdjFEopfZGzst6S5Z3k5CTIr1v1EKeog&oe=6A68B5CB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Echocardiography VR - VML", "keywords": ["Echography", "POCUS", "Medical", "Ultrasound", "Healthcare"], "long_description": "**Echocardiography VR**, by VML, is a virtual reality simulation that transforms how medical students and healthcare professionals learn cardiac ultrasound.\n\nStep into a simulation room where you'll master transducer positioning, orientation, and anatomical recognition through hands-on practice. Place the probe on your virtual patient, adjust it to find the correct windows, and activate **X-ray mode** to see how your transducer intersects the heart in real-time.\n\nThe machine offers three learning modes:\n- **2D Mode**: real echocardiography footage as you scan\n- **Freeze Mode**: anatomical illustrations where you identify each structure\n- **3D Mode**: slice through an interactive heart with a special probe and switch to ultrasound-style materials\n\n**Egbot**, your android guide, walks you through a complete tutorial to get the most out of each mode.\n\nWhether you're a student or healthcare professional, this simulation gives you a safe environment to build confidence before scanning real patients!", "short_description": "Improve your echocardiography skills with this immersive VR simulation! Step into the operating room to scan your virtual patient. Learn to identify different cardiac structures through interactive visualizations: see through the chest as if using X-rays, dissect a 3D heart to understand each structure, and more. All guided by Egbot, your virtual tutor."}, {"images": {"nodes": [{"file_name": "Cover Landscape_FULL_ES.png", "id": "2558894087837590", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491822968_2558894094504256_5404181423913633795_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TWqpROm252wQ7kNvwEjfVzr&_nc_oc=AdrJzY79sAllv9brlXP-yZv77FOQ2IxY7G1ICSM3jOjdr0vyoDbi8M477wyXaZrazGw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDKdmfSqnE7nvpw5mDPt46ntInaVwjrtrGzhLJPes-0Fg&oe=6A68B16E"}, {"file_name": "Cover Landscape_FULL_ES.png", "id": "1971181917156082", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830888_1971181920489415_1647681755962022117_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aZq8NeN3xtsQ7kNvwFYkidw&_nc_oc=Adq8HMSgW6JIzVDCqXZcYL7p-AREJuzc4Q4Pqeet6kszvfd3zpbDTgM-Gh2rR2EaX-w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDrRZ_XNkJ9GYO3LlRK5q7Ldslvr9gn-mJ8CJzgT3J2dg&oe=6A68A7E9"}, {"file_name": "Cover Square_FULL_ES-1.png", "id": "1912394656053179", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823893_1912394659386512_7066665920184004452_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F4ifZv6Ho8kQ7kNvwH8holI&_nc_oc=Ado9dRVqnO_NJ_WXhiDgFIQ9iA7HGFYGSVfh_tIT43DLousN6FbJdXCrsGwgDrzc8R4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQApOy3yZqXWdvwCvSx02o1rz1-VC58l4dTooVrKTGXOUw&oe=6A68B8CC"}, {"file_name": "Cover Portrait_FULL_ES.png", "id": "1822870681733204", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491827703_1822870685066537_4560401566713579284_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CM8Ky0Qo_WwQ7kNvwHJJpOt&_nc_oc=AdotKCYUXh9kvrrhnzdGiYxdLhTM9Cxz2bV_ISQ2F-6gujF4F8SNFF9yg2LDScB7hvA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCfnPUnXOBHWNesG0e4-KGaN_CdCr-rcypE3FPzmKg9DQ&oe=6A68C02C"}, {"file_name": "ECHO-DEMO-SQUARE-3.png", "id": "1465068948371145", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491827725_1465068951704478_8306382549700619272_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FqEMoxT9Q8gQ7kNvwFnlOH6&_nc_oc=AdrrNji8eiiw-WkmE93MenZxr011iElOCUbbvQdJcLQuKhVPy_95LqVGGfsOQVHlaF8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC_8vimlXpn66H2-wZVpPkxCL7vtYRtGiirAxUnqeQoNQ&oe=6A68B146"}]}, "id": "1234561742089673", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ecocardiograf\u00eda VR - VML", "keywords": ["Medicina", "Ultrasonido", "POCUS", "Ecografia", "Salud"], "long_description": "**Ecocardiograf\u00eda VR**, de VML, es una simulaci\u00f3n de realidad virtual que transforma c\u00f3mo estudiantes de medicina y profesionales de la salud aprenden ultrasonido card\u00edaco.\n\nEntra a una sala de simulaci\u00f3n donde dominar\u00e1s el posicionamiento del transductor, su orientaci\u00f3n y el reconocimiento anat\u00f3mico mediante pr\u00e1ctica activa. Coloca la sonda en tu paciente virtual, aj\u00fastala para encontrar las ventanas correctas, y activa el **modo rayos X** para ver c\u00f3mo tu transductor intersecta el coraz\u00f3n en tiempo real.\n\nLa m\u00e1quina ofrece tres modos de aprendizaje:\n- **Modo 2D**: videos reales de ecocardiograf\u00eda mientras escaneas\n- **Modo Congelado**: ilustraciones anat\u00f3micas donde identificas cada estructura\n- **Modo 3D**: corta un coraz\u00f3n interactivo con una sonda especial y cambia a materiales estilo ultrasonido\n\n**Egbot**, tu gu\u00eda androide, te acompa\u00f1a con un tutorial completo para aprovechar cada modo.\n\nYa seas estudiante o profesional de la salud, esta simulaci\u00f3n te da un ambiente seguro para ganar confianza antes de escanear pacientes reales.", "short_description": "Mejora tus habilidades de ecocardiograf\u00eda con esta simulaci\u00f3n inmersiva en VR. Ad\u00e9ntrate al quir\u00f3fano para escanear a tu paciente virtual con videos reales de ultrasonido, y aprende a identificar las estructuras card\u00edacas mediante visualizaciones interactivas: ve a trav\u00e9s del t\u00f3rax como si usaras rayos X, disecciona un coraz\u00f3n 3D, y m\u00e1s. Todo esto guiado por Egbot, tu tutor virtual."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vml.solutions/privacy-echocardiography-vr-vml", "developer_terms_of_service_url": null, "publisher_name": "Virtual Medical Learning", "support_website_url": null, "website_url": "https://vml.solutions/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["es_MX", "en"], "supported_input_devices": ["OCULUS_TOUCH"], "suppor
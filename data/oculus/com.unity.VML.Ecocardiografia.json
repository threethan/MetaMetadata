ps://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619836_1237132168326387_2183731442049155847_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QCjwlw9mUBMQ7kNvwHXhnk6&_nc_oc=AdoOVpAJrl6kiPuWs7RsBlbZjItkbas0bdID6VUnmkSeA8Ed3jVqrdTw4aZM0TBMPJ4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6maJIX3OwbNK2GwSymaLWloU7b8ECv_UF4kdEPJpUXbg&oe=6A20250F"}, {"file_name": "Cover Landscape_FULL_ENG.png", "id": "884644501207363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823893_884644504540696_1379382285860789409_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ptWgtbLM8Z4Q7kNvwGstXqB&_nc_oc=AdqiY47m46ZjFkwKeJTmcht-sZ_VLG-WAUCbWUUjNPYTuFfKQFzBDqqO9G6O7Oy3JV8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ouT2LY0c8lAlnFn6G0CGG0vw-Vp7WiRBJhkCxCPGemw&oe=6A2049FE"}]}, "id": "2481659452294539", "locale": "en_US", "screenshots": [{"file_name": "ecocardio-Screenshot-001.png", "id": "1204174037792977", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473400248_1204174041126310_5851841347649338254_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n1vdv8LQ8t4Q7kNvwHedhfr&_nc_oc=AdqllGgi5YXiJWAyWGdLVEyIoQ8dEYc0bAI8Iw1pBhjCrcYZsx7iwAuL79_Kb6vF-C4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4BuMPlwSYHdKubFuJSaMcFDNQFr43yh7Tbs0ZNu_MFXw&oe=6A202BE1"}, {"file_name": "ecocardio-Screenshot-002.png", "id": "1683364999261437", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391911_1683365002594770_6182534077774161018_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xn7xQhvuBGcQ7kNvwFTPFbL&_nc_oc=AdoTY2WVmtmH9h_tvJ3yOCAHhRAAWOYGA1ttfWWbmjIdGoocVJl-SgbFCvmHVdbwZHc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5OgE8xQMXFc2FvWVOMkMmKVmay0iMjMnExFW5R0SMglA&oe=6A202E3F"}, {"file_name": "ecocardio-Screenshot-004.png", "id": "645259521197957", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391893_645259524531290_1221040782683536363_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AFMq2FPJNEgQ7kNvwEtU1YF&_nc_oc=AdpYttjUxLkW7q1bc6Py76-y8ly7fyAIkPobaKrZT0nP9-KYmF4gDvytIPL8RhC3s88&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af73UDKbPbRERDrBHrZJ_iy_wRc4u2mUXAC15SLg8FMHsA&oe=6A2048CE"}, {"file_name": "ecocardio-Screenshot-003.png", "id": "663923902976794", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393984_663923906310127_5574735863383485136_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=43YKLBQNu3oQ7kNvwHdHc80&_nc_oc=AdrtR2o_boDfhu83YlBt-mw2jzSvgWaAx2AVng3IQ9zPhP6nhTvmjeN0y9MpBeUVUPM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5I6kxvBLYMdOpVtChRtIxWhC79UoEMYuRJjq8D0q8vlw&oe=6A201919"}, {"file_name": "ecocardio-Screenshot-005.png", "id": "590596830460245", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391890_590596833793578_6307124770371399137_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wcg6hlPxf5MQ7kNvwG41r53&_nc_oc=AdqvWYlgs43aXkP5mGqz-91Xe_y7w5OlXWtb-_9Ri-544iPfFVpC8nrH7ld9af2ufmA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7yxxBpJ4Yj8s0OSQ1dbP3UqHr7fa_72RCfbWYqD-rl2g&oe=6A20334B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Echocardiography VR - VML", "keywords": ["Echography", "POCUS", "Medical", "Ultrasound", "Healthcare"], "long_description": "**Echocardiography VR**, by VML, is a virtual reality simulation that transforms how medical students and healthcare professionals learn cardiac ultrasound.\n\nStep into a simulation room where you'll master transducer positioning, orientation, and anatomical recognition through hands-on practice. Place the probe on your virtual patient, adjust it to find the correct windows, and activate **X-ray mode** to see how your transducer intersects the heart in real-time.\n\nThe machine offers three learning modes:\n- **2D Mode**: real echocardiography footage as you scan\n- **Freeze Mode**: anatomical illustrations where you identify each structure\n- **3D Mode**: slice through an interactive heart with a special probe and switch to ultrasound-style materials\n\n**Egbot**, your android guide, walks you through a complete tutorial to get the most out of each mode.\n\nWhether you're a student or healthcare professional, this simulation gives you a safe environment to build confidence before scanning real patients!", "short_description": "Improve your echocardiography skills with this immersive VR simulation! Step into the operating room to scan your virtual patient. Learn to identify different cardiac structures through interactive visualizations: see through the chest as if using X-rays, dissect a 3D heart to understand each structure, and more. All guided by Egbot, your virtual tutor."}, {"images": {"nodes": [{"file_name": "Cover Landscape_FULL_ES.png", "id": "2558894087837590", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822968_2558894094504256_5404181423913633795_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qgOBag2kTy8Q7kNvwGRyUIi&_nc_oc=AdoxX9KJxCi9Ab9va8mo841V9zGz_Eg9OXGmp7bcDgAbnOmW82JHuKg7I1wiX9k9_A4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7TYRETo_9qz1JnWUKaf4PHLIduLt2reip0H8v4_xG7Uw&oe=6A202EEE"}, {"file_name": "Cover Landscape_FULL_ES.png", "id": "1971181917156082", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491830888_1971181920489415_1647681755962022117_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZXUo9owQBrYQ7kNvwERQOd7&_nc_oc=Adq7WcZKDLQE5Vs1HXPZI5-zzaiCsods-RRz5vmUP28D_tjw2IsBqYWIzz0zz5Unfkc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6x2orE_GtP9ylfQJXN46SYADVkGnXRzE8KL2WON69txA&oe=6A202569"}, {"file_name": "Cover Square_FULL_ES-1.png", "id": "1912394656053179", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823893_1912394659386512_7066665920184004452_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YFKWfZT7LD0Q7kNvwGynfOQ&_nc_oc=AdoM6rQdi9LmmwRcc7X9txpopGEByRptnJRwkN065RTIcWOwAvlPMfIGVrm7jbnVFaI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7pxYfOHAw8AZjuCkkxhrbW5sAKQE4N3EcPIjNKzLx17Q&oe=6A20364C"}, {"file_name": "Cover Portrait_FULL_ES.png", "id": "1822870681733204", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491827703_1822870685066537_4560401566713579284_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s8orntdS8K4Q7kNvwFIc-Jz&_nc_oc=Adq_yJQ_d8nXvAEqaMB1Jk9bn5kpwGDQdzwHBynkOJJG6mWBYd5LqrDcJHmhspqkA1Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6y9uRePyGs40RArq0AcnYrmg34Il7ZOLErRv_esTUBbQ&oe=6A203DAC"}, {"file_name": "ECHO-DEMO-SQUARE-3.png", "id": "1465068948371145", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827725_1465068951704478_8306382549700619272_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gt4BcT2CvrkQ7kNvwFc98_T&_nc_oc=AdpEDBpHKhJ0dYBJairCqO2oIKwfn0iJgw0ZQrjaxTMRCOfle-kFS6dOmzQii7zzfZY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af41aXZdufNzoLS3P7Rs2UWL9hrfbOMMOGTFWtHopYlFsg&oe=6A202EC6"}]}, "id": "1234561742089673", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ecocardiograf\u00eda VR - VML", "keywords": ["Medicina", "Ultrasonido", "POCUS", "Ecografia", "Salud"], "long_description": "**Ecocardiograf\u00eda VR**, de VML, es una simulaci\u00f3n de realidad virtual que transforma c\u00f3mo estudiantes de medicina y profesionales de la salud aprenden ultrasonido card\u00edaco.\n\nEntra a una sala de simulaci\u00f3n donde dominar\u00e1s el posicionamiento del transductor, su orientaci\u00f3n y el reconocimiento anat\u00f3mico mediante pr\u00e1ctica activa. Coloca la sonda en tu paciente virtual, aj\u00fastala para encontrar las ventanas correctas, y activa el **modo rayos X** para ver c\u00f3mo tu transductor intersecta el coraz\u00f3n en tiempo real.\n\nLa m\u00e1quina ofrece tres modos de aprendizaje:\n- **Modo 2D**: videos reales de ecocardiograf\u00eda mientras escaneas\n- **Modo Congelado**: ilustraciones anat\u00f3micas donde identificas cada estructura\n- **Modo 3D**: corta un coraz\u00f3n interactivo con una sonda especial y cambia a materiales estilo ultrasonido\n\n**Egbot**, tu gu\u00eda androide, te acompa\u00f1a con un tutorial completo para aprovechar cada modo.\n\nYa seas estudiante o profesional de la salud, esta simulaci\u00f3n te da un ambiente seguro para ganar confianza antes de escanear pacientes reales.", "short_description": "Mejora tus habilidades de ecocardiograf\u00eda con esta simulaci\u00f3n inmersiva en VR. Ad\u00e9ntrate al quir\u00f3fano para escanear a tu paciente virtual con videos reales de ultrasonido, y aprende a identificar las estructuras card\u00edacas mediante visualizaciones interactivas: ve a trav\u00e9s del t\u00f3rax como si usaras rayos X, disecciona un coraz\u00f3n 3D, y m\u00e1s. Todo esto guiado por Egbot, tu tutor virtual."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vml.solutions/privacy-echocardiography-vr-vml", "developer_terms_of_service_url": null, "publisher_name": "Virtual Medical Learning", "support_website_url": null, "website_url": "https://vml.solutions/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["es_MX", "en"], "supported_input_devices": ["OCULUS_TOUCH"], "suppor
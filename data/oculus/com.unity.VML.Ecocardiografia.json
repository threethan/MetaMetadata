=6B00857F"}, {"file_name": "ecocardio-Screenshot-004.png", "id": "645259521197957", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391893_645259524531290_1221040782683536363_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0AsQp8J4ZSMQ7kNvwFKB5JM&_nc_oc=AdrmDlnf-AdnSoHhREmOGDm6dVKHU6FAVCcYMm9z5dPhAtjmYYYnHpRuoGMMRs7bWzM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8qok-OcR9ZfhUTMVrWySu2biDP4ukdgzz46337GLqeQ&oe=6B0067CE"}, {"file_name": "ecocardio-Screenshot-003.png", "id": "663923902976794", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393984_663923906310127_5574735863383485136_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E45PlW7wo9AQ7kNvwGw40Xx&_nc_oc=AdpRInOttwi4oXOtVwnOKveKP-tmoU9fRdsPNB7tSY2iakpnB70aLuRx1aPEe3SFXwE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNfeRdvJWWOGHaP90Di8A07FU9sN9jzlNLaqkBlM0EWA&oe=6B007059"}, {"file_name": "ecocardio-Screenshot-005.png", "id": "590596830460245", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391890_590596833793578_6307124770371399137_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ak39r7g5fuUQ7kNvwEbWs8P&_nc_oc=AdoHiE0ShEGTnX4svGFJ2k_CUtWMTo6ZUsaWlf7MGEGGvar6UN_0myEMVrX9RDWQTMg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWxpGEz20kLghB0p3a8dW7QXpTQKbdNB0XgplP0EezvQ&oe=6B00524B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Echocardiography VR - VML", "keywords": ["Echography", "POCUS", "Medical", "Ultrasound", "Healthcare"], "long_description": "**Echocardiography VR**, by VML, is a virtual reality simulation that transforms how medical students and healthcare professionals learn cardiac ultrasound.\n\nStep into a simulation room where you'll master transducer positioning, orientation, and anatomical recognition through hands-on practice. Place the probe on your virtual patient, adjust it to find the correct windows, and activate **X-ray mode** to see how your transducer intersects the heart in real-time.\n\nThe machine offers three learning modes:\n- **2D Mode**: real echocardiography footage as you scan\n- **Freeze Mode**: anatomical illustrations where you identify each structure\n- **3D Mode**: slice through an interactive heart with a special probe and switch to ultrasound-style materials\n\n**Egbot**, your android guide, walks you through a complete tutorial to get the most out of each mode.\n\nWhether you're a student or healthcare professional, this simulation gives you a safe environment to build confidence before scanning real patients!", "short_description": "Improve your echocardiography skills with this immersive VR simulation! Step into the operating room to scan your virtual patient. Learn to identify different cardiac structures through interactive visualizations: see through the chest as if using X-rays, dissect a 3D heart to understand each structure, and more. All guided by Egbot, your virtual tutor."}, {"images": {"nodes": [{"file_name": "Cover Landscape_FULL_ES.png", "id": "2558894087837590", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822968_2558894094504256_5404181423913633795_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CXIoTZPCqNMQ7kNvwHKTC2B&_nc_oc=AdoUkQnGSvcLJLxUhnoWPUOKsHBAgKkLlQd8s90HHTcTiiXPljWB9dXl7BgeacfeMxA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9K0sotNpSq5D2dupnrjMvz_ENU04G5Jf6GRiqdSsteg&oe=6B00862E"}, {"file_name": "Cover Landscape_FULL_ES.png", "id": "1971181917156082", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830888_1971181920489415_1647681755962022117_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9DxSyWPPWmcQ7kNvwEI0fu-&_nc_oc=Adr49Kfg6Ip9_BIPFtqfaK2ueZYtFXES5hxvoM0OJkJ1fXajNFvrf53R6bKyun9iFjs&_nc_zt=3&_nc_ht=scontent-i
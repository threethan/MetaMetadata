ps://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619836_1237132168326387_2183731442049155847_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YIhqrOTIXYYQ7kNvwEC4nia&_nc_oc=AdraRFv4RYR5ACBL7htjFtbwDs9OWzLcoHNN48Y3JPm3od-mcqxBHdnwR07_vYlORgk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDL5S__L3za_Eu3bNZrnNIPCPXkT8xmPtq4V2VfJvRSQ&oe=6AA0068F"}, {"file_name": "Cover Landscape_FULL_ENG.png", "id": "884644501207363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823893_884644504540696_1379382285860789409_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vJ6EWZM2UAEQ7kNvwEqVW2t&_nc_oc=Adpi2ebrOUroB2M4wSIdvPYt_VZstzTMRvdhMrf8gb_FtUpdHw1_bhKOw55tHFSW0rY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfNexKe2CmLGfIXg6S7c-7B6C5NhwJwJIC5p8hHKb16g&oe=6AA02B7E"}]}, "id": "2481659452294539", "locale": "en_US", "screenshots": [{"file_name": "ecocardio-Screenshot-001.png", "id": "1204174037792977", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473400248_1204174041126310_5851841347649338254_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HDkZOFyXgvoQ7kNvwEnoomn&_nc_oc=AdoaXJf9pwxCkRj2lV03bjCV71ztf5h0KpLJNwUtUCNXteM6qjqAKSNTS2w3KYka-2U&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjtVFnVYnj0RxpcFkLhqDPtA42OXgb9THC5ptQXR0MIg&oe=6AA00D61"}, {"file_name": "ecocardio-Screenshot-002.png", "id": "1683364999261437", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391911_1683365002594770_6182534077774161018_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ZcNNSoPdAkQ7kNvwEMg1U1&_nc_oc=AdoTIGH7mIQBdrik2YwyA7526Knl0HIiQ3HklRUDgLCaWesruOUAAlSY8gX2ppLhdhE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1OUSZN85ZnB_0lZTW0ElDaNA1fT40Zbd90Klj9mTMlA&oe=6AA00FBF"}, {"file_name": "ecocardio-Screenshot-004.png", "id": "645259521197957", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391893_645259524531290_1221040782683536363_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0HSj84akwBkQ7kNvwFg-aCa&_nc_oc=Adqr4HdGbU_mGP-Z5lU932ba-RXEUJ7Qnwt13Wx9VKj1HXM1KJEb2KSXBynAyh9_0Y0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ436Y-FAdUa_IIKSvY_32uxj7LnA3w0DbWY89PS4eMSA&oe=6AA02A4E"}, {"file_name": "ecocardio-Screenshot-003.png", "id": "663923902976794", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393984_663923906310127_5574735863383485136_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=34yMHCTP85kQ7kNvwGAmTfh&_nc_oc=AdomoXR58ylCIXb8XaCeS6-eOC9Txn1p2EjAqy48Upz3WV5757Sjq60il_FaswHDHL8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKEUht9IvmTQu4a9qbCk1xLp913qXLfTEpwVUcRv5rMOQ&oe=6A9FFA99"}, {"file_name": "ecocardio-Screenshot-005.png", "id": "590596830460245", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391890_590596833793578_6307124770371399137_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KJx3Gj546nYQ7kNvwFEagTd&_nc_oc=Adoi90jGRm2sk1a9gWmHrGAxOxoB8Zo2Yw5ujTjMy-n2kA-kAOKafshhLhujsjpw21w&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjnJckgNGM5lcoc-rkfOL1awX4PDn-p8JDRpJUZpexYA&oe=6AA014CB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Echocardiography VR - VML", "keywords": ["Echography", "POCUS", "Medical", "Ultrasound", "Healthcare"], "long_description": "**Echocardiography VR**, by VML, is a virtual reality simulation that transforms how medical students and healthcare professionals learn cardiac ultrasound.\n\nStep into a simulation room where you'll master transducer positioning, orientation, and anatomical recognition through hands-on practice. Place the probe on your virtual patient, adjust it to find the correct windows, and activate **X-ray mode** to see how your transducer intersects the heart in real-time.\n\nThe machine offers three learning modes:\n- **2D Mode**: real echocardiography footage as you scan\n- **Freeze Mode**: anatomical illustrations where you identify each structure\n- **3D Mode**: slice through an interactive heart with a special probe and switch to ultrasound-style materials\n\n**Egbot**, your android guide, walks you through a complete tutorial to get the most out of each mode.\n\nWhether you're a student or healthcare professional, this simulation gives you a safe environment to build confidence before scanning real patients!", "short_description": "Improve your echocardiography skills with this immersive VR simulation! Step into the operating room to scan your virtual patient. Learn to identify different cardiac structures through interactive visualizations: see through the chest as if using X-rays, dissect a 3D heart to understand each structure, and more. All guided by Egbot, your virtual tutor."}, {"images": {"nodes": [{"file_name": "Cover Landscape_FULL_ES.png", "id": "2558894087837590", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491822968_2558894094504256_5404181423913633795_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZSlHf83w76cQ7kNvwHkuQNH&_nc_oc=Adr-V4D1lQ8yJnnxb6BPWSkb6FH_uyoqzr1nm9qtdD1_SZaDI9fCCCSUsRvmzhspj9g&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJE6fJ4mdS53KFcd6I8q0daOq7nrYCALE1BoPbBIlpcpw&oe=6AA0106E"}, {"file_name": "Cover Landscape_FULL_ES.png", "id": "1971181917156082", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491830888_1971181920489415_1647681755962022117_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JVaBbQ2OtW4Q7kNvwFqJFZ0&_nc_oc=AdoZh6wN1mtPzm9OqB9LyEIpPjDr2Nyw0t8m-ygw9I_dxxORF_bmtpM6eyVlL_JYSjM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_C5H8pryWGSex5w07YQ_W_luJnrBr4zmIuLP-kN7-Pg&oe=6AA006E9"}, {"file_name": "Cover Square_FULL_ES-1.png", "id": "1912394656053179", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823893_1912394659386512_7066665920184004452_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Bd8mI4LvxoQ7kNvwEROQfs&_nc_oc=AdrjKsmCVnmOAcbzkU2JEOn8XShKnPQhgarv4a2W3jjgfVMPUjnkLoxscuk1mUMLEBQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdWjHPgxu-82JFPUHYJu0fTA5H2yfWNJb_tILkUI8SgQ&oe=6AA017CC"}, {"file_name": "Cover Portrait_FULL_ES.png", "id": "1822870681733204", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491827703_1822870685066537_4560401566713579284_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hqUuMMJcxfgQ7kNvwED7hNX&_nc_oc=Ado6bu63B_ZHdnByRH2a2yp7i60DZrHoJwV57aHlMZaZU8B5vwrfm3hw16N790QLdDI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPgwXvD6Dxh2EUE5xLmq5l_9_Kc3tiLqhWSfprKVznAw&oe=6AA01F2C"}, {"file_name": "ECHO-DEMO-SQUARE-3.png", "id": "1465068948371145", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491827725_1465068951704478_8306382549700619272_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I4Rd4Om7GCgQ7kNvwF03w7o&_nc_oc=Adobh1zPWlOHdZUveTj6cMOcJ9CPFOuO9vKWqA6aAwexppPA8K_9Jt1SPi_c2q7lee0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFn3iYcsxzg3gV8TCHt4JdHCNa_V5rjtDv6BW6cdRfTA&oe=6AA01046"}]}, "id": "1234561742089673", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ecocardiograf\u00eda VR - VML", "keywords": ["Medicina", "Ultrasonido", "POCUS", "Ecografia", "Salud"], "long_description": "**Ecocardiograf\u00eda VR**, de VML, es una simulaci\u00f3n de realidad virtual que transforma c\u00f3mo estudiantes de medicina y profesionales de la salud aprenden ultrasonido card\u00edaco.\n\nEntra a una sala de simulaci\u00f3n donde dominar\u00e1s el posicionamiento del transductor, su orientaci\u00f3n y el reconocimiento anat\u00f3mico mediante pr\u00e1ctica activa. Coloca la sonda en tu paciente virtual, aj\u00fastala para encontrar las ventanas correctas, y activa el **modo rayos X** para ver c\u00f3mo tu transductor intersecta el coraz\u00f3n en tiempo real.\n\nLa m\u00e1quina ofrece tres modos de aprendizaje:\n- **Modo 2D**: videos reales de ecocardiograf\u00eda mientras escaneas\n- **Modo Congelado**: ilustraciones anat\u00f3micas donde identificas cada estructura\n- **Modo 3D**: corta un coraz\u00f3n interactivo con una sonda especial y cambia a materiales estilo ultrasonido\n\n**Egbot**, tu gu\u00eda androide, te acompa\u00f1a con un tutorial completo para aprovechar cada modo.\n\nYa seas estudiante o profesional de la salud, esta simulaci\u00f3n te da un ambiente seguro para ganar confianza antes de escanear pacientes reales.", "short_description": "Mejora tus habilidades de ecocardiograf\u00eda con esta simulaci\u00f3n inmersiva en VR. Ad\u00e9ntrate al quir\u00f3fano para escanear a tu paciente virtual con videos reales de ultrasonido, y aprende a identificar las estructuras card\u00edacas mediante visualizaciones interactivas: ve a trav\u00e9s del t\u00f3rax como si usaras rayos X, disecciona un coraz\u00f3n 3D, y m\u00e1s. Todo esto guiado por Egbot, tu tutor virtual."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vml.solutions/privacy-echocardiography-vr-vml", "developer_terms_of_service_url": null, "publisher_name": "Virtual Medical Learning", "support_website_url": null, "website_url": "https://vml.solutions/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["es_MX", "en"], "supported_input_devices": ["OCULUS_TOUCH"], "suppor
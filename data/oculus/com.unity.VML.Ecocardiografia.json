ps://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619836_1237132168326387_2183731442049155847_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fK6w_rypECUQ7kNvwHIUiKr&_nc_oc=AdomCvxCzQDQvKwcg4YS3f51iXAjWTGDEP6lsizoF5BxaDy3AAFBuj4i3lXvb9436iI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMsTGXdTvNKe712_ZVpnxwC0ZoW3Q4hvTamTMmZw0-MrQ&oe=6AE3430F"}, {"file_name": "Cover Landscape_FULL_ENG.png", "id": "884644501207363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823893_884644504540696_1379382285860789409_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J2pPmzqca7oQ7kNvwEddVlq&_nc_oc=AdoGpRV5Bpu1M2us_Lyv5-3_QHfdx9zQ1ftNjkpDMh1ZEeYwahUCO06JdyJbx9PGCLQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNilfhSXgIYcPNqqHXCU2HwPzntLj9M1ZwQ15QChG9l0Q&oe=6AE367FE"}]}, "id": "2481659452294539", "locale": "en_US", "screenshots": [{"file_name": "ecocardio-Screenshot-001.png", "id": "1204174037792977", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473400248_1204174041126310_5851841347649338254_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HFdSVNoP_jgQ7kNvwG9KUQA&_nc_oc=Adqe90OWMqBmHOVrrfO54YZtvqH4zrltMZrWRRyWxls8Ekp0S3T828g778DpFMg9E0Q&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNs18OF_2xcpDW4ILRdcB7I90IR3jIpOHbYjbT7wiU2rA&oe=6AE349E1"}, {"file_name": "ecocardio-Screenshot-002.png", "id": "1683364999261437", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391911_1683365002594770_6182534077774161018_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kCcM7AhR_PcQ7kNvwGJyMYv&_nc_oc=AdqJYSdP_lu50cYHi6T5Vzssyad0C8d66JdDU3hQaNjn3i1v6HeiWm0n5HhGzS0GiCs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPLkkvNC_00RQmumgellcUqpT8VDc3qTs96mK0JSj-7sw&oe=6AE34C3F"}, {"file_name": "ecocardio-Screenshot-004.png", "id": "645259521197957", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473391893_645259524531290_1221040782683536363_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VzWbRT8IkR4Q7kNvwE3ErQ1&_nc_oc=AdrfkkYsGM8BUEGjO3PVME3EvnL_w0IJjDqntI9BI21eG6G_6j8k51us3dxpo0dB0Xo&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4y-xpndZX-Hj_sIq5e4ebzniwQot6jP441-PMh54lbg&oe=6AE366CE"}, {"file_name": "ecocardio-Screenshot-003.png", "id": "663923902976794", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393984_663923906310127_5574735863383485136_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zkJPemto8uMQ7kNvwESjC8c&_nc_oc=Adr5ak4kPGugWvQYi5sL77kj2hdDhNo2b24KSlW1s9SM6Q7ms-7HJVRt723kEhULxQQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFv1fpF-Aw8HwBcRePWgibzrVVQNeba4m7pipEeLhd2Q&oe=6AE33719"}, {"file_name": "ecocardio-Screenshot-005.png", "id": "590596830460245", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391890_590596833793578_6307124770371399137_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nZgxP-JBCv0Q7kNvwHd-VQy&_nc_oc=AdpdnioTwO10zaWRpY7A6VNyR29MRebe5UbovzcFZwivhskgAI925NuwawwOGblcHG4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOdOTV3QFpjoapValvwP01QHTuXP4DwXtn49ITneoteLQ&oe=6AE3514B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Echocardiography VR - VML", "keywords": ["Echography", "POCUS", "Medical", "Ultrasound", "Healthcare"], "long_description": "**Echocardiography VR**, by VML, is a virtual reality simulation that transforms how medical students and healthcare professionals learn cardiac ultrasound.\n\nStep into a simulation room where you'll master transducer positioning, orientation, and anatomical recognition through hands-on practice. Place the probe on your virtual patient, adjust it to find the correct windows, and activate **X-ray mode** to see how your transducer intersects the heart in real-time.\n\nThe machine offers three learning modes:\n- **2D Mode**: real echocardiography footage as you scan\n- **Freeze Mode**: anatomical illustrations where you identify each structure\n- **3D Mode**: slice through an interactive heart with a special probe and switch to ultrasound-style materials\n\n**Egbot**, your android guide, walks you through a complete tutorial to get the most out of each mode.\n\nWhether you're a student or healthcare professional, this simulation gives you a safe environment to build confidence before scanning real patients!", "short_description": "Improve your echocardiography skills with this immersive VR simulation! Step into the operating room to scan your virtual patient. Learn to identify different cardiac structures through interactive visualizations: see through the chest as if using X-rays, dissect a 3D heart to understand each structure, and more. All guided by Egbot, your virtual tutor."}, {"images": {"nodes": [{"file_name": "Cover Landscape_FULL_ES.png", "id": "2558894087837590", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491822968_2558894094504256_5404181423913633795_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vXtFGQs2CpoQ7kNvwGj5ihv&_nc_oc=AdogTRuvdEPVsSDBKAX3LEIBZOBNu51hcAv-8um6lkb62LO5NH6sbiEbA_rNFg0mTnc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOe7zFHJWPGV5h7lx2wx5vqbVO-EfFKQr5D7ayucKxVtQ&oe=6AE34CEE"}, {"file_name": "Cover Landscape_FULL_ES.png", "id": "1971181917156082", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491830888_1971181920489415_1647681755962022117_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s1HvcpL5qiIQ7kNvwEpOKs5&_nc_oc=AdrHJ4AvUp0WJDhDBw7F0I3t-yvXRw0rS2ezC3SP7XPuJFfSB8w9Sykj-U-pjw7D3zk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6nvmbYAUQxKiZLtYu6rSOXAOgLWM5Ek3e9S881CW98g&oe=6AE34369"}, {"file_name": "Cover Square_FULL_ES-1.png", "id": "1912394656053179", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823893_1912394659386512_7066665920184004452_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HLf7p7VSKg8Q7kNvwHOy3Za&_nc_oc=AdreFnlxNyfJyA9MlEMPfcZzcihjyoY6piE9tFnaKH-eEswDUVb9NbXR4BS0iZeHEU4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPmMXNtk8YwSLURVyfPTK5YjRewL_IlGMTsu-j26dHSrA&oe=6AE3544C"}, {"file_name": "Cover Portrait_FULL_ES.png", "id": "1822870681733204", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491827703_1822870685066537_4560401566713579284_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dCWWKSYPNn0Q7kNvwEwdSCT&_nc_oc=AdqR1oQHPBl7k4WoWODw2ai386TeSVu-ZS6Hq1xRIzvHmp8nyw_L_pVgL8_bkkY2-Fg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOyukCoMTfr1ayram2H-H8txdzdZQ3JCsl702r0pSsJTA&oe=6AE35BAC"}, {"file_name": "ECHO-DEMO-SQUARE-3.png", "id": "1465068948371145", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491827725_1465068951704478_8306382549700619272_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=acHbdA58seoQ7kNvwEtcmeW&_nc_oc=Adqy4JJo9FPVD-fGgUJxbdmlfAZldsZBd6kKtU2vBO6Aif1pwDAlYj2PbAFmHjVeHs8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN69P8GcSpCmlA30iL4jm9V7HpO2uJemmLGypcJWnCJ6g&oe=6AE34CC6"}]}, "id": "1234561742089673", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ecocardiograf\u00eda VR - VML", "keywords": ["Medicina", "Ultrasonido", "POCUS", "Ecografia", "Salud"], "long_description": "**Ecocardiograf\u00eda VR**, de VML, es una simulaci\u00f3n de realidad virtual que transforma c\u00f3mo estudiantes de medicina y profesionales de la salud aprenden ultrasonido card\u00edaco.\n\nEntra a una sala de simulaci\u00f3n donde dominar\u00e1s el posicionamiento del transductor, su orientaci\u00f3n y el reconocimiento anat\u00f3mico mediante pr\u00e1ctica activa. Coloca la sonda en tu paciente virtual, aj\u00fastala para encontrar las ventanas correctas, y activa el **modo rayos X** para ver c\u00f3mo tu transductor intersecta el coraz\u00f3n en tiempo real.\n\nLa m\u00e1quina ofrece tres modos de aprendizaje:\n- **Modo 2D**: videos reales de ecocardiograf\u00eda mientras escaneas\n- **Modo Congelado**: ilustraciones anat\u00f3micas donde identificas cada estructura\n- **Modo 3D**: corta un coraz\u00f3n interactivo con una sonda especial y cambia a materiales estilo ultrasonido\n\n**Egbot**, tu gu\u00eda androide, te acompa\u00f1a con un tutorial completo para aprovechar cada modo.\n\nYa seas estudiante o profesional de la salud, esta simulaci\u00f3n te da un ambiente seguro para ganar confianza antes de escanear pacientes reales.", "short_description": "Mejora tus habilidades de ecocardiograf\u00eda con esta simulaci\u00f3n inmersiva en VR. Ad\u00e9ntrate al quir\u00f3fano para escanear a tu paciente virtual con videos reales de ultrasonido, y aprende a identificar las estructuras card\u00edacas mediante visualizaciones interactivas: ve a trav\u00e9s del t\u00f3rax como si usaras rayos X, disecciona un coraz\u00f3n 3D, y m\u00e1s. Todo esto guiado por Egbot, tu tutor virtual."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vml.solutions/privacy-echocardiography-vr-vml", "developer_terms_of_service_url": null, "publisher_name": "Virtual Medical Learning", "support_website_url": null, "website_url": "https://vml.solutions/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["es_MX", "en"], "supported_input_devices": ["OCULUS_TOUCH"], "suppor
ANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823893_884644504540696_1379382285860789409_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P5PzuLOIftwQ7kNvwE0kzcK&_nc_oc=AdoAFMHktLaCTLSi2pslXy-JvqmhH3R4ayH1Lj2x5YqqmRChds6XK8_N8KBa7i8FLvM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNK1dmCVdpfvs0ZGMEK_19WmfGxmBkbnOF3GWlFS_zfhQ&oe=6AC666FE"}]}, "id": "2481659452294539", "locale": "en_US", "screenshots": [{"file_name": "ecocardio-Screenshot-001.png", "id": "1204174037792977", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473400248_1204174041126310_5851841347649338254_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FlV0K3KH3U0Q7kNvwGSGOy3&_nc_oc=AdqQNykXDCMdTABJnXAmES3SaBs25tCxkRtK7o6pes9GIvgOAD_Eb6raRoCh0_IgVtU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNOOJ0a92uJ-R5dU73BT5EyL568KtCV3ZyLs40Q9p15NA&oe=6AC648E1"}, {"file_name": "ecocardio-Screenshot-002.png", "id": "1683364999261437", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391911_1683365002594770_6182534077774161018_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-pzkRapeRAQQ7kNvwG5NwP3&_nc_oc=AdrsJ6HZs2GPFrfZnYQEDfcT3-D_yfz4bxGNouoy-zuEOz4GJRaaOaCleUGOQhMvggg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOYGDOx1P2NDec80eou18buI4FzHFiH-dUw3LHxtSJwpg&oe=6AC64B3F"}, {"file_name": "ecocardio-Screenshot-004.png", "id": "645259521197957", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391893_645259524531290_1221040782683536363_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UOJ272RsT8cQ7kNvwFrq_Bn&_nc_oc=AdrYOjk03qvrGvHa0wJGpj0MxhOEuXycIeiA6hDvakIvDKMrdN4Uus1M5OGkTzFLp-Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP1Wkm04mT2jY8Vb7HzJQu-xsRJIIOMYmmAhNcnyzZQ_g&oe=6AC665CE"}, {"file_name": "ecocardio-Screenshot-003.png", "id": "663923902976794", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393984_663923906310127_5574735863383485136_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aZ7aP-dvn4gQ7kNvwHWpsJn&_nc_oc=AdoL-KEm3dmXJZ9VTr77MWsJoYesfgrnVLns1Lqx0GT_4uvnQj3627ot67ZaS3Zoem4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNr_qZ2wRYq9IORbzWfT8V91TpdR_ymdRxAYyLr_Wnrtg&oe=6AC66E59"}, {"file_name": "ecocardio-Screenshot-005.png", "id": "590596830460245", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391890_590596833793578_6307124770371399137_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=98wBTZyKxPEQ7kNvwG_M8p6&_nc_oc=Adr90eIMGDEID4cNQzA4n8gAL5nZKoF0YPeHLHMvS76VjGtsnhMUS5X9F0Vsm7jNTDM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOUHz_IVveYUWC0P5nKKUkbCHG3QZbhh_nhr6OvTdleEQ&oe=6AC6504B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Echocardiography VR - VML", "keywords": ["Echography", "POCUS", "Medical", "Ultrasound", "Healthcare"], "long_description": "**Echocardiography VR**, by VML, is a virtual reality simulation that transforms how medical students and healthcare professionals learn cardiac ultrasound.\n\nStep into a simulation room where you'll master transducer positioning, orientation, and anatomical recognition through hands-on practice. Place the probe on your virtual patient, adjust it to find the correct windows, and activate **X-ray mode** to see how your transducer intersects the heart in real-time.\n\nThe machine offers three learning modes:\n- **2D Mode**: real echocardiography footage as you scan\n- **Freeze Mode**: anatomical illustrations where you identify each structure\n- **3D Mode**: slice through an interactive heart with a special probe and switch to ultrasound-style materials\n\n**Egbot**, your android guide, walks you through a complete tutorial to get the most out of each mode.\n\nWhether you're a student or healthcare professional, this simulation gives you a safe environment to build confidence before scanning real patients!", "short_description": "Improve your echocardiography skills with this immersive VR simulation! Step into the operating room to scan your virtual patient. Learn to identify different cardiac structures through interactive visualizations: see through the chest as if using X-rays, dissect a 3D heart to understand each structure, and more. All guided by Egbot, your virtual tutor."}, {"images": {"nodes": [{"file_name": "Cover Landscape_FULL_ES.png", "id": "2558894087837590", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822968_2558894094504256_5404181423913633795_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nJcPSiY7UkcQ7kNvwFOJXn7&_nc_oc=Adp0GdNRA7gF4713mSiSFK_Zfb5JXAnVtpVradJUSCdy5P6JtY54rPUM8His22EI6OM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMpdILuFRLdSbxb6GPNwrG_ONaiHR70w8mL67-Go1L4XQ&oe=6AC64BEE"}, {"file_name": "Cover Landscape_FULL_ES.png", "id": "1971181917156082", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830888_1971181920489415_1647681755962022117_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m3fvq8I7q-oQ7kNvwH7WIhn&_nc_oc=AdpJIScKQAgjGccow5VlzwEEv187v2dbPEL1x0TU3MjNCmfbgSyPWfB0qcmbNjqXyXo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMCF0wLrG79D9hGYYByHms02XiBsZz6F2nW6cXd3JEhJQ&oe=6AC64269"}, {"file_name": "Cover Square_FULL_ES-1.png", "id": "1912394656053179", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823893_1912394659386512_7066665920184004452_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yGPqCwOt_hUQ7kNvwHHYveJ&_nc_oc=Adrr06X8bNW-7GP-TG13ur2M3Nt3fRrL04q53z4sm9gR9ktqVMQL9WM_jS1S-P0KkYs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMm2s-dkjr4yun-fTj1JSSwzEf2R4ljS0RivNAwfSqBbg&oe=6AC6534C"}, {"file_name": "Cover Portrait_FULL_ES.png", "id": "1822870681733204", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827703_1822870685066537_4560401566713579284_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g-F6BJPZVuEQ7kNvwE57KuQ&_nc_oc=Adr3A3YHMhW3dLireoDewhpcUk8TTt2WnL0zVl9EL-Fxjr46jq0zhPND_FChfWq-c6U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOWo3IAw4KEiiliFh_0lWDQDYfE841sHNVnAEX_dOmtXw&oe=6AC65AAC"}, {"file_name": "ECHO-DEMO-SQUARE-3.png", "id": "1465068948371145", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827725_1465068951704478_8306382549700619272_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e0eCWGgW5BIQ7kNvwF7kTF2&_nc_oc=AdoJJWqKMg46zPjmrUqXdyWTaDs-n7ok2xDzmFyN5anWou_1PMmOzMvXmhroO1J5BnY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMs_eFdY03q0bCPGjv5uF3GaauzRCEqvjwq7ifdxexkoA&oe=6AC64BC6"}]}, "id": "1234561742089673", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ecocardiograf\u00eda VR - VML", "keywords": ["Medicina", "Ultrasonido", "POCUS", "Ecografia", "Salud"], "long_description": "**Ecocardiograf\u00eda VR**, de VML, es una simulaci\u00f3n de realidad virtual que transforma c\u00f3mo estudiantes de medicina y profesionales de la salud aprenden ultrasonido card\u00edaco.\n\nEntra a una sala de simulaci\u00f3n donde dominar\u00e1s el posicionamiento del transductor, su orientaci\u00f3n y el reconocimiento anat\u00f3mico mediante pr\u00e1ctica activa. Coloca la sonda en tu paciente virtual, aj\u00fastala para encontrar las ventanas correctas, y activa el **modo rayos X** para ver c\u00f3mo tu transductor intersecta el coraz\u00f3n en tiempo real.\n\nLa m\u00e1quina ofrece tres modos de aprendizaje:\n- **Modo 2D**: videos reales de ecocardiograf\u00eda mientras escaneas\n- **Modo Congelado**: ilustraciones anat\u00f3micas donde identificas cada estructura\n- **Modo 3D**: corta un coraz\u00f3n interactivo con una sonda especial y cambia a materiales estilo ultrasonido\n\n**Egbot**, tu gu\u00eda androide, te acompa\u00f1a con un tutorial completo para aprovechar cada modo.\n\nYa seas estudiante o profesional de la salud, esta simulaci\u00f3n te da un ambiente seguro para ganar confianza antes de escanear pacientes reales.", "short_description": "Mejora tus habilidades de ecocardiograf\u00eda con esta simulaci\u00f3n inmersiva en VR. Ad\u00e9ntrate al quir\u00f3fano para escanear a tu paciente virtual con videos reales de ultrasonido, y aprende a identificar las estructuras card\u00edacas mediante visualizaciones interactivas: ve a trav\u00e9s del t\u00f3rax como si usaras rayos X, disecciona un coraz\u00f3n 3D, y m\u00e1s. Todo esto guiado por Egbot, tu tutor virtual."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vml.solutions/privacy-echocardiography-vr-vml", "developer_terms_of_service_url": null, "publisher_name": "Virtual Medical Learning", "support_website_url": null, "website_url": "https://vml.solutions/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["es_MX", "en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26816677961307902"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "933036372544152"}]}, "baseline_offer": {"id": "933036372544152"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1778171280, "status": "PUBLISHED", "id": "933036372544152"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {
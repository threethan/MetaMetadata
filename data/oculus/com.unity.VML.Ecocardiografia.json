=6B0F05FF"}, {"file_name": "ecocardio-Screenshot-004.png", "id": "645259521197957", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391893_645259524531290_1221040782683536363_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XVKYdtnlCM0Q7kNvwGWKIdy&_nc_oc=AdpXdwQ-CsZ2ecj3-e7MJ7jjI0zqgDxJRZAjd75RSGW6q5hslH9m78I2pqQuOkYNl_w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXNwhm7MpdbRh4aTuWrJaRRtReG8uecavg-qZbye7iPkQ&oe=6B0F208E"}, {"file_name": "ecocardio-Screenshot-003.png", "id": "663923902976794", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393984_663923906310127_5574735863383485136_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ODlpTypMDzoQ7kNvwG_bKOQ&_nc_oc=AdqXQ0n52nO1upaxLzUdL0JR2R_bsA-MEQUS0_aOCSnM10T5F7ZnBHjQG-g4cDLocwU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUZEOIpmSctbLoeHRlZNqAgwIU-zT9xm0zm4U4MGu0BGw&oe=6B0EF0D9"}, {"file_name": "ecocardio-Screenshot-005.png", "id": "590596830460245", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391890_590596833793578_6307124770371399137_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sM2LcQzTSMcQ7kNvwFESGmj&_nc_oc=Ado5QiKKqSBg_EBN1YlH3_FBk2dskLIjB4AozBPD0NK24nnPOw98vpT3xnnSOo1gVHA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVb1TOggaL6_u5KoAJ6wSRqTDBKfGUwIP8AZpJ5CHaEgw&oe=6B0F0B0B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Echocardiography VR - VML", "keywords": ["Echography", "POCUS", "Medical", "Ultrasound", "Healthcare"], "long_description": "**Echocardiography VR**, by VML, is a virtual reality simulation that transforms how medical students and healthcare professionals learn cardiac ultrasound.\n\nStep into a simulation room where you'll master transducer positioning, orientation, and anatomical recognition through hands-on practice. Place the probe on your virtual patient, adjust it to find the correct windows, and activate **X-ray mode** to see how your transducer intersects the heart in real-time.\n\nThe machine offers three learning modes:\n- **2D Mode**: real echocardiography footage as you scan\n- **Freeze Mode**: anatomical illustrations where you identify each structure\n- **3D Mode**: slice through an interactive heart with a special probe and switch to ultrasound-style materials\n\n**Egbot**, your android guide, walks you through a complete tutorial to get the most out of each mode.\n\nWhether you're a student or healthcare professional, this simulation gives you a safe environment to build confidence before scanning real patients!", "short_description": "Improve your echocardiography skills with this immersive VR simulation! Step into the operating room to scan your virtual patient. Learn to identify different cardiac structures through interactive visualizations: see through the chest as if using X-rays, dissect a 3D heart to understand each structure, and more. All guided by Egbot, your virtual tutor."}, {"images": {"nodes": [{"file_name": "Cover Landscape_FULL_ES.png", "id": "2558894087837590", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822968_2558894094504256_5404181423913633795_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JFHxtRzkE0oQ7kNvwFBsFPJ&_nc_oc=AdotD_B-SFXPEYXUZ99i1YogFIDiI1VgFrWvfz2sJLvTHCRIGY2ws70q-xD2Q_zlcvk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWUK5Wa2jznUbDnNd28NvwGsFIXjQkwxSWyHNIZcQ-v2g&oe=6B0F06AE"}, {"file_name": "Cover Landscape_FULL_ES.png", "id": "1971181917156082", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830888_1971181920489415_1647681755962022117_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TfjW8SchOAkQ7kNvwGcTZfr&_nc_oc=AdoRuUGBkYBYDa7VkT-XsOkUHmNNzhLgYqGFexdZqhHE0AHBYSJL9MMRCkyI-MyPdpc&_nc_zt=3&_nc_ht=scontent-i
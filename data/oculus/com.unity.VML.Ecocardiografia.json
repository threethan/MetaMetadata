ps://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619836_1237132168326387_2183731442049155847_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IK4ElYBy6bEQ7kNvwEkxaNt&_nc_oc=Ado5Kp1qwRMvTUH0yhxbbFS45-pvr-WvBrMUUVtlrScpWQu0K8V0acb47hLSJBPafgM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMg1kApx5R9BXUWZ6g5aflBNtCSoAgLPbEdlDZIffD6JQ&oe=6ACFB4CF"}, {"file_name": "Cover Landscape_FULL_ENG.png", "id": "884644501207363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823893_884644504540696_1379382285860789409_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NUtRXesypn0Q7kNvwGg-T1v&_nc_oc=AdqTahU67t6qj93xVzm3-PcjRRenwrxkfRiQwl0VCxyD89pVcMKQfxMEFphh6FvrMI8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPauaqwZ3TDkmPcbBBXc9edEN-KyrSa6QajfUBkQSQipA&oe=6ACFA17E"}]}, "id": "2481659452294539", "locale": "en_US", "screenshots": [{"file_name": "ecocardio-Screenshot-001.png", "id": "1204174037792977", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473400248_1204174041126310_5851841347649338254_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dh7K5UfFcT4Q7kNvwE8YlBi&_nc_oc=Adoo8HTaUbvKIzqbjKOOyFZZnJtXCt6JhOqNR4xOrRW4uYh_LhVfAjURDb1i8X5RMQY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPK-R4Tuvi5rck0mxHOjVn9H84X5ibMOz_gkHMt72qqyA&oe=6ACF8361"}, {"file_name": "ecocardio-Screenshot-002.png", "id": "1683364999261437", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391911_1683365002594770_6182534077774161018_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b5kQYGxzBJsQ7kNvwG9Cmpe&_nc_oc=AdoDNscnsPC-cvUXCS5X4wouFTPpAiOXqMx3UWHkBzZDylxdKJBf-3uYLm2WBNBNC3I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM18RM4o8ci3S_C6qDN_3nHWLarSJDHBUwrB3fAwLu4Kg&oe=6ACF85BF"}, {"file_name": "ecocardio-Screenshot-004.png", "id": "645259521197957", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391893_645259524531290_1221040782683536363_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fjb_BUdAzgkQ7kNvwEPCchv&_nc_oc=AdrnloPeSRuX2_W4XD3J33BGMBoGGMtQsaDX-yi5zMrxxIZAR82ry2cm8gUW6jUcEVo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOA5_s5oOiTabT-FtaVAdoi6_l0VBhBfms5dw10fqVvTQ&oe=6ACFA04E"}, {"file_name": "ecocardio-Screenshot-003.png", "id": "663923902976794", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393984_663923906310127_5574735863383485136_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d2HcIvkJUqsQ7kNvwH0tTdf&_nc_oc=AdrIJ4K-9Yf89G8PgSOeV0I1HyxsD2zabw0F0gkyi23sS02SmCgn0WRTbgBcFmD6thI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZet6jjcjE3f5OJxRZPJ8lcRDBoxe552XFf0QpeiNKNw&oe=6ACFA8D9"}, {"file_name": "ecocardio-Screenshot-005.png", "id": "590596830460245", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391890_590596833793578_6307124770371399137_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ddrjda_oqJ8Q7kNvwGuaKzW&_nc_oc=Adq9VRPABw63qBWE7xd2bnpdyd64goOfUok7mjZQF6JzS68xqzN2U892XhXtdEfdA9U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPh_Kfk79Z5COgQIYKMjHVwPcuflc4KpcNUfWu091nifg&oe=6ACF8ACB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Echocardiography VR - VML", "keywords": ["Echography", "POCUS", "Medical", "Ultrasound", "Healthcare"], "long_description": "**Echocardiography VR**, by VML, is a virtual reality simulation that transforms how medical students and healthcare professionals learn cardiac ultrasound.\n\nStep into a simulation room where you'll master transducer positioning, orientation, and anatomical recognition through hands-on practice. Place the probe on your virtual patient, adjust it to find the correct windows, and activate **X-ray mode** to see how your transducer intersects the heart in real-time.\n\nThe machine offers three learning modes:\n- **2D Mode**: real echocardiography footage as you scan\n- **Freeze Mode**: anatomical illustrations where you identify each structure\n- **3D Mode**: slice through an interactive heart with a special probe and switch to ultrasound-style materials\n\n**Egbot**, your android guide, walks you through a complete tutorial to get the most out of each mode.\n\nWhether you're a student or healthcare professional, this simulation gives you a safe environment to build confidence before scanning real patients!", "short_description": "Improve your echocardiography skills with this immersive VR simulation! Step into the operating room to scan your virtual patient. Learn to identify different cardiac structures through interactive visualizations: see through the chest as if using X-rays, dissect a 3D heart to understand each structure, and more. All guided by Egbot, your virtual tutor."}, {"images": {"nodes": [{"file_name": "Cover Landscape_FULL_ES.png", "id": "2558894087837590", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822968_2558894094504256_5404181423913633795_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8dS6b8Xz6joQ7kNvwFbxGO4&_nc_oc=Ado2QMV-g9MP4p2oBuxianVuk75wP0hzhSOCXJykCXBRvC7T1psshKXszt6zKzBB6pQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPSIbnymE4HbDPldNS4BETc3O2VoJzOFTeioi5N7cYBRg&oe=6ACF866E"}, {"file_name": "Cover Landscape_FULL_ES.png", "id": "1971181917156082", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491830888_1971181920489415_1647681755962022117_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cOYhEd6em14Q7kNvwGXUNGn&_nc_oc=AdrqYjGfMCePFpD1pgF3bDs0j7hv8knJWM_Kf5HzdydrhtX0GHa7WlSXIt5JDaq6ozE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPOQyxuDQeA3dTlizgywaRM4ZxIVuFRkEMLyEP62ng5Zg&oe=6ACFB529"}, {"file_name": "Cover Square_FULL_ES-1.png", "id": "1912394656053179", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823893_1912394659386512_7066665920184004452_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Int4lF4amDUQ7kNvwFt3nj_&_nc_oc=AdoH2w_VUFiJdyATAO5ha4gM-zQduunveI_rxKEgq6pVBxfdMq0X0fFBQZnnnjDUONA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPAQ8ySPgPCcWsOIwTKllAgseyGCdF0wI5TX9Q5tug0dg&oe=6ACF8DCC"}, {"file_name": "Cover Portrait_FULL_ES.png", "id": "1822870681733204", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491827703_1822870685066537_4560401566713579284_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9__cyWkHJNQQ7kNvwHkB71w&_nc_oc=AdqbKViZSuP2VFsQNo2ASKX7YZcJvDyEHv-k9oYoINr7R90bgA0CcRP2W58kS8vsygE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZweguoNm_qwdD1P3aoDoDfeTnFaho-iXfqZVsD7pH2A&oe=6ACF952C"}, {"file_name": "ECHO-DEMO-SQUARE-3.png", "id": "1465068948371145", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827725_1465068951704478_8306382549700619272_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cE5g6l7_0KIQ7kNvwG12ZIz&_nc_oc=AdrImNfF75KdPoEtZaS4E9w3hHjkOViX0lReNGLNiepP7fAoCl_Sreu5ISjiytR4OQg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOS4S9IUhTqipcAXqkLFOlZ9HzzI6grc1Ytx6_mRNyWtg&oe=6ACF8646"}]}, "id": "1234561742089673", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ecocardiograf\u00eda VR - VML", "keywords": ["Medicina", "Ultrasonido", "POCUS", "Ecografia", "Salud"], "long_description": "**Ecocardiograf\u00eda VR**, de VML, es una simulaci\u00f3n de realidad virtual que transforma c\u00f3mo estudiantes de medicina y profesionales de la salud aprenden ultrasonido card\u00edaco.\n\nEntra a una sala de simulaci\u00f3n donde dominar\u00e1s el posicionamiento del transductor, su orientaci\u00f3n y el reconocimiento anat\u00f3mico mediante pr\u00e1ctica activa. Coloca la sonda en tu paciente virtual, aj\u00fastala para encontrar las ventanas correctas, y activa el **modo rayos X** para ver c\u00f3mo tu transductor intersecta el coraz\u00f3n en tiempo real.\n\nLa m\u00e1quina ofrece tres modos de aprendizaje:\n- **Modo 2D**: videos reales de ecocardiograf\u00eda mientras escaneas\n- **Modo Congelado**: ilustraciones anat\u00f3micas donde identificas cada estructura\n- **Modo 3D**: corta un coraz\u00f3n interactivo con una sonda especial y cambia a materiales estilo ultrasonido\n\n**Egbot**, tu gu\u00eda androide, te acompa\u00f1a con un tutorial completo para aprovechar cada modo.\n\nYa seas estudiante o profesional de la salud, esta simulaci\u00f3n te da un ambiente seguro para ganar confianza antes de escanear pacientes reales.", "short_description": "Mejora tus habilidades de ecocardiograf\u00eda con esta simulaci\u00f3n inmersiva en VR. Ad\u00e9ntrate al quir\u00f3fano para escanear a tu paciente virtual con videos reales de ultrasonido, y aprende a identificar las estructuras card\u00edacas mediante visualizaciones interactivas: ve a trav\u00e9s del t\u00f3rax como si usaras rayos X, disecciona un coraz\u00f3n 3D, y m\u00e1s. Todo esto guiado por Egbot, tu tutor virtual."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vml.solutions/privacy-echocardiography-vr-vml", "developer_terms_of_service_url": null, "publisher_name": "Virtual Medical Learning", "support_website_url": null, "website_url": "https://vml.solutions/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["es_MX", "en"], "supported_input_devices": ["OCULUS_TOUCH"], "suppor
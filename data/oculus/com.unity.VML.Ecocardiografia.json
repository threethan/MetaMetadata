=6AFB3F7F"}, {"file_name": "ecocardio-Screenshot-004.png", "id": "645259521197957", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391893_645259524531290_1221040782683536363_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eL1tADHyXlkQ7kNvwFmFRag&_nc_oc=Ado4uG37u9JcfWTOTf-_Eqo-3uWzcIumZpZtaYnwS1UlG3IidXOCX2c5SlBO4mA4gac&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRuR8z8FvD-2bYtU5TMj0DrdWZIVNC1q5GGs6dMv8ak_Q&oe=6AFB21CE"}, {"file_name": "ecocardio-Screenshot-003.png", "id": "663923902976794", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473393984_663923906310127_5574735863383485136_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-BvlUIUT_sgQ7kNvwExDuEL&_nc_oc=AdoUsBUuve3DoSuTVFaonmGbSqWyM_k1qNeJnCw1X--JhOrR5thI87acQifMVG0KaoY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTB2mWqk6thsvgp98M551sO92Hu2c8T-fwq1vfDoLl8qg&oe=6AFB2A59"}, {"file_name": "ecocardio-Screenshot-005.png", "id": "590596830460245", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391890_590596833793578_6307124770371399137_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2GqLgs5dibEQ7kNvwG0OfQ5&_nc_oc=AdqOhDFPV10zRoZOMKxFKaJorRWToE8w7VqFER-BF7hu8L9AKMkk4zYPBnhfGGAlVYQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQ0t1tVPrr504gWN0wjQaMzXeY25ijzc2CEaZFHQuNlw&oe=6AFB448B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Echocardiography VR - VML", "keywords": ["Echography", "POCUS", "Medical", "Ultrasound", "Healthcare"], "long_description": "**Echocardiography VR**, by VML, is a virtual reality simulation that transforms how medical students and healthcare professionals learn cardiac ultrasound.\n\nStep into a simulation room where you'll master transducer positioning, orientation, and anatomical recognition through hands-on practice. Place the probe on your virtual patient, adjust it to find the correct windows, and activate **X-ray mode** to see how your transducer intersects the heart in real-time.\n\nThe machine offers three learning modes:\n- **2D Mode**: real echocardiography footage as you scan\n- **Freeze Mode**: anatomical illustrations where you identify each structure\n- **3D Mode**: slice through an interactive heart with a special probe and switch to ultrasound-style materials\n\n**Egbot**, your android guide, walks you through a complete tutorial to get the most out of each mode.\n\nWhether you're a student or healthcare professional, this simulation gives you a safe environment to build confidence before scanning real patients!", "short_description": "Improve your echocardiography skills with this immersive VR simulation! Step into the operating room to scan your virtual patient. Learn to identify different cardiac structures through interactive visualizations: see through the chest as if using X-rays, dissect a 3D heart to understand each structure, and more. All guided by Egbot, your virtual tutor."}, {"images": {"nodes": [{"file_name": "Cover Landscape_FULL_ES.png", "id": "2558894087837590", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491822968_2558894094504256_5404181423913633795_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DFeP2i5h5P0Q7kNvwG42E1W&_nc_oc=AdqI9xTojiJA5kqLyPUUr9bktRN7kYdYDtmiIaPqOHojdoUxCFm2IuWT8iSp13qLJ-I&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTp_oCXTxTckJFsI14h1Um9PRaNGdvX-2JvTi2cgmw5dg&oe=6AFB402E"}, {"file_name": "Cover Landscape_FULL_ES.png", "id": "1971181917156082", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491830888_1971181920489415_1647681755962022117_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d0J09Tm3p1wQ7kNvwE1W8g0&_nc_oc=AdoTos1Rex5i0GZjv3ekTuKkMa6dPO_YSqSCUI86PGD-vl3U92HEwgA9qjhsj8kDHfY&_nc_zt=3&_nc_ht=scontent-l
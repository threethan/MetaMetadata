=6B05CB7F"}, {"file_name": "ecocardio-Screenshot-004.png", "id": "645259521197957", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391893_645259524531290_1221040782683536363_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BqZ2Wuyj1t0Q7kNvwFaq4Lu&_nc_oc=AdoYHrPMWyU4qiBpZjHGisBL8vLZafxCel-NEX44mnfIdz9fk1gbvp1lH5KHRwdj4Hc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYjdvRjw7iDhyeuxGGsa5gOG-LDz4KZmOdLiZ88jHZ9w&oe=6B05ADCE"}, {"file_name": "ecocardio-Screenshot-003.png", "id": "663923902976794", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393984_663923906310127_5574735863383485136_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RkJBVoVw5bsQ7kNvwHcp3k3&_nc_oc=AdrIVEVMoQ6CUMauT36CucqMeBnFxAkClT_Po744KnHSSpnW98hSHyI_A7i9h1cjfGU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9BRblVVAC4qo_jAyNIDWa4vgVoWm64a0AYPgjoSdiqQ&oe=6B05B659"}, {"file_name": "ecocardio-Screenshot-005.png", "id": "590596830460245", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391890_590596833793578_6307124770371399137_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RQb9LwOV-n8Q7kNvwGcGwaW&_nc_oc=AdqiyGlySnPPUP1i7EBuIbN4Y-iXcpW73fxJV0j-jEp6tHDlSV-LIw0-Knc5drAZEjY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKzBl5ga9dxueBhyj86zj8TmRJt-g4iNoECwATlf24Eg&oe=6B05D08B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Echocardiography VR - VML", "keywords": ["Echography", "POCUS", "Medical", "Ultrasound", "Healthcare"], "long_description": "**Echocardiography VR**, by VML, is a virtual reality simulation that transforms how medical students and healthcare professionals learn cardiac ultrasound.\n\nStep into a simulation room where you'll master transducer positioning, orientation, and anatomical recognition through hands-on practice. Place the probe on your virtual patient, adjust it to find the correct windows, and activate **X-ray mode** to see how your transducer intersects the heart in real-time.\n\nThe machine offers three learning modes:\n- **2D Mode**: real echocardiography footage as you scan\n- **Freeze Mode**: anatomical illustrations where you identify each structure\n- **3D Mode**: slice through an interactive heart with a special probe and switch to ultrasound-style materials\n\n**Egbot**, your android guide, walks you through a complete tutorial to get the most out of each mode.\n\nWhether you're a student or healthcare professional, this simulation gives you a safe environment to build confidence before scanning real patients!", "short_description": "Improve your echocardiography skills with this immersive VR simulation! Step into the operating room to scan your virtual patient. Learn to identify different cardiac structures through interactive visualizations: see through the chest as if using X-rays, dissect a 3D heart to understand each structure, and more. All guided by Egbot, your virtual tutor."}, {"images": {"nodes": [{"file_name": "Cover Landscape_FULL_ES.png", "id": "2558894087837590", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822968_2558894094504256_5404181423913633795_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tLSF-X8nfIoQ7kNvwG6uKUP&_nc_oc=AdpBGcmjqNyaW49OSfoRlv4G687g-ZVA9SyxWkgvy8xt47CwF0erPRx2cvnpfTsw9mY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDoI8V65eLLhwY450w2-3ybvpoOiDUd217M1UCpyh4fA&oe=6B05CC2E"}, {"file_name": "Cover Landscape_FULL_ES.png", "id": "1971181917156082", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830888_1971181920489415_1647681755962022117_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ynSWHVbiltQQ7kNvwHAx2B6&_nc_oc=AdrKxjWokqKUZHCGlmPlt8qaElbsWdyYIHNXkx0t3eIxWEVTa2z9503Z76rPecuVqe0&_nc_zt=3&_nc_ht=scontent-i
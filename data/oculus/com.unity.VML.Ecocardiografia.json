ANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823893_884644504540696_1379382285860789409_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vooimw-NmA0Q7kNvwHgNO8j&_nc_oc=AdpDyoQi3qiuACVVjA86RGfrTFbzedjXhw0KqcSQ91Wmi8fxFxhZW1sNYyhDAKE_58Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7N359rUA5l-qSQXx4R3L4kWU8yZuEcEYOBZgTtwZr6cQ&oe=6A0348FE"}]}, "id": "2481659452294539", "locale": "en_US", "screenshots": [{"file_name": "ecocardio-Screenshot-001.png", "id": "1204174037792977", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473400248_1204174041126310_5851841347649338254_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aIgBtNZwu1cQ7kNvwE2HZr8&_nc_oc=AdprDYDPTgxuV3ZkbRs40y02q1o7sBUG6YcrUfhejDwD9Ft-uuazcR1mlK7aorw8zKY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6mrNa0CiNnThMNjKuS1XhIW5Du4NKvMtlE0GAs8TyNDQ&oe=6A032AE1"}, {"file_name": "ecocardio-Screenshot-002.png", "id": "1683364999261437", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391911_1683365002594770_6182534077774161018_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cPf9IDdgbyIQ7kNvwFJ5b3G&_nc_oc=Adr_vRBvzOmct3fxcQT8cNtysIHTYM8RZuxK3mj9gQ6rjhP21hEGgUH5N7nzFlnrySE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5TOEswjDRvvjPo8wUtvQTouMwzO52n4oL02oRc3_-xAQ&oe=6A032D3F"}, {"file_name": "ecocardio-Screenshot-004.png", "id": "645259521197957", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391893_645259524531290_1221040782683536363_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W7Wh-o5Vq9MQ7kNvwHKrhGN&_nc_oc=AdrJBExH4Cx31k9gT5EmlHGSnXbDA3lYtiwaNUSWdSeYuU7A_iS_WS98wvFhTaFJtRw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7BXu7m-_hlfsw3ATwIOrAATrOsZu_EWTQWHE0e_AOJkA&oe=6A0347CE"}, {"file_name": "ecocardio-Screenshot-003.png", "id": "663923902976794", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393984_663923906310127_5574735863383485136_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VwT4Z_i6p2AQ7kNvwHgvuA3&_nc_oc=Adq1sofN5SVyLp__diNuM49nT7t89YOlzoHX8mVq2qLZaXkAWY0ISa1HpNdeMyX5axE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5bMRITQLzseVwXCV8zKOO1WxyMprDkMLuzypPaz_bykQ&oe=6A031819"}, {"file_name": "ecocardio-Screenshot-005.png", "id": "590596830460245", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391890_590596833793578_6307124770371399137_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gjp0j5JacZQQ7kNvwG3shga&_nc_oc=AdqaX9nxH2khHrvUGrTAUnn1U7cyjpMyHtTPXUnTfpAKpS_Y0R9fx8p4GXwqO-CGTSw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6sbNQ4WF8q-SEuqUbUSmba87jNo629t7LUD1oUcfEN2Q&oe=6A03324B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Echocardiography VR - VML", "keywords": ["Echography", "POCUS", "Medical", "Ultrasound", "Healthcare"], "long_description": "**Echocardiography VR**, by VML, is a virtual reality simulation that transforms how medical students and healthcare professionals learn cardiac ultrasound.\n\nStep into a simulation room where you'll master transducer positioning, orientation, and anatomical recognition through hands-on practice. Place the probe on your virtual patient, adjust it to find the correct windows, and activate **X-ray mode** to see how your transducer intersects the heart in real-time.\n\nThe machine offers three learning modes:\n- **2D Mode**: real echocardiography footage as you scan\n- **Freeze Mode**: anatomical illustrations where you identify each structure\n- **3D Mode**: slice through an interactive heart with a special probe and switch to ultrasound-style materials\n\n**Egbot**, your android guide, walks you through a complete tutorial to get the most out of each mode.\n\nWhether you're a student or healthcare professional, this simulation gives you a safe environment to build confidence before scanning real patients!", "short_description": "Improve your echocardiography skills with this immersive VR simulation! Step into the operating room to scan your virtual patient. Learn to identify different cardiac structures through interactive visualizations: see through the chest as if using X-rays, dissect a 3D heart to understand each structure, and more. All guided by Egbot, your virtual tutor."}, {"images": {"nodes": [{"file_name": "Cover Landscape_FULL_ES.png", "id": "2558894087837590", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822968_2558894094504256_5404181423913633795_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VIItaKJ8eMoQ7kNvwFoGdbC&_nc_oc=AdpRLIYGA05M4WJ-CUwSuu_zft0QFtNg1-x6whFh1-jq2SnsMXw3X83AhbTkg74-Ge4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Cae-ZmRpML2D4F6jcicv8pgdY-4zFOGXq9DNj7Pl-0w&oe=6A032DEE"}, {"file_name": "Cover Landscape_FULL_ES.png", "id": "1971181917156082", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830888_1971181920489415_1647681755962022117_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1BE4CScLkbUQ7kNvwHAZjku&_nc_oc=Adq7uA51dQCPI3R1sYnTxDY-jnX4th28b2CqvM1SDQZoeizvytZTOiuqQK5LQrjo9Rw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WiNt4uIc1idu19TxYItbEgLc8gmecBG-D1VKm_8-SeA&oe=6A032469"}, {"file_name": "Cover Square_FULL_ES-1.png", "id": "1912394656053179", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823893_1912394659386512_7066665920184004452_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w7X6AAY62k0Q7kNvwGfIT7I&_nc_oc=AdohjMkFhSdXxALS2kSFGIonSf5lFplqM557GrgD3TfkUnOBrpTQ19G8Zzn-W5Sw1Bc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4lsaJMGlDBr40VFfZG-rX2H34tCQkd8ibMEDGLqbw6Bw&oe=6A03354C"}, {"file_name": "Cover Portrait_FULL_ES.png", "id": "1822870681733204", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491827703_1822870685066537_4560401566713579284_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SanZoUeyFwgQ7kNvwGHDccy&_nc_oc=AdqIz8L18N-I5P-nxoLb7VfErHvxs8YHSLRn4ptItxNOzJzSLadzyQ_dDGFoUjsuIg8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7x__qIhyL3gu5utFjuDNfiy3EbkQXuAs-qjf1_62IF_w&oe=6A033CAC"}, {"file_name": "ECHO-DEMO-SQUARE-3.png", "id": "1465068948371145", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491827725_1465068951704478_8306382549700619272_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RWyW61VDU48Q7kNvwGtYnU6&_nc_oc=Adr_zsmhlzxGN5l1NZDG_rIoUadr0D2DrJGNYyv3zrx8QCse3U9aS3um9m2dfhMFnUo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af67_f780v3s7YJrpY0TAP01iAfwa6vCkt06NC7zkDYqIw&oe=6A032DC6"}]}, "id": "1234561742089673", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ecocardiograf\u00eda VR - VML", "keywords": ["Medicina", "Ultrasonido", "POCUS", "Ecografia", "Salud"], "long_description": "**Ecocardiograf\u00eda VR**, de VML, es una simulaci\u00f3n de realidad virtual que transforma c\u00f3mo estudiantes de medicina y profesionales de la salud aprenden ultrasonido card\u00edaco.\n\nEntra a una sala de simulaci\u00f3n donde dominar\u00e1s el posicionamiento del transductor, su orientaci\u00f3n y el reconocimiento anat\u00f3mico mediante pr\u00e1ctica activa. Coloca la sonda en tu paciente virtual, aj\u00fastala para encontrar las ventanas correctas, y activa el **modo rayos X** para ver c\u00f3mo tu transductor intersecta el coraz\u00f3n en tiempo real.\n\nLa m\u00e1quina ofrece tres modos de aprendizaje:\n- **Modo 2D**: videos reales de ecocardiograf\u00eda mientras escaneas\n- **Modo Congelado**: ilustraciones anat\u00f3micas donde identificas cada estructura\n- **Modo 3D**: corta un coraz\u00f3n interactivo con una sonda especial y cambia a materiales estilo ultrasonido\n\n**Egbot**, tu gu\u00eda androide, te acompa\u00f1a con un tutorial completo para aprovechar cada modo.\n\nYa seas estudiante o profesional de la salud, esta simulaci\u00f3n te da un ambiente seguro para ganar confianza antes de escanear pacientes reales.", "short_description": "Mejora tus habilidades de ecocardiograf\u00eda con esta simulaci\u00f3n inmersiva en VR. Ad\u00e9ntrate al quir\u00f3fano para escanear a tu paciente virtual con videos reales de ultrasonido, y aprende a identificar las estructuras card\u00edacas mediante visualizaciones interactivas: ve a trav\u00e9s del t\u00f3rax como si usaras rayos X, disecciona un coraz\u00f3n 3D, y m\u00e1s. Todo esto guiado por Egbot, tu tutor virtual."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vml.solutions/privacy-echocardiography-vr-vml", "developer_terms_of_service_url": null, "publisher_name": "Virtual Medical Learning", "support_website_url": null, "website_url": "https://vml.solutions/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["es_MX", "en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26816677961307902"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "933036372544152"}]}, "baseline_offer": {"id": "933036372544152"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1778171280, "status": "PUBLISHED", "id": "933036372544152"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {
=6B086E7F"}, {"file_name": "ecocardio-Screenshot-004.png", "id": "645259521197957", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/473391893_645259524531290_1221040782683536363_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PqpeAxCkEuAQ7kNvwFLJBtD&_nc_oc=AdrgCg7suhFq657wtXRb-jKxLWo61srFaWSABiG5myY2zIhR6yCEOX9Mi-GPx_6cfDw&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWA62py2XwNZsj8H7lnl1zGDWOO6j8Slh4cCf9uH_3IA&oe=6B0850CE"}, {"file_name": "ecocardio-Screenshot-003.png", "id": "663923902976794", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393984_663923906310127_5574735863383485136_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RkJBVoVw5bsQ7kNvwGG_WWs&_nc_oc=Adp-wNW4B8L8pwizXv6-Q5srV9IIqZvlNdEYuCsUYqlbciPgwK4PvZtQvCEBvx5yT9A&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS08dmXGCCjSrFwCgBzM5KvTJ-IQ37JxTEI1dxEzrqYMQ&oe=6B085959"}, {"file_name": "ecocardio-Screenshot-005.png", "id": "590596830460245", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391890_590596833793578_6307124770371399137_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GW1VmFp4k18Q7kNvwGxARWg&_nc_oc=Adr_bnQH5etKUGfThAXtQG4QIdNFtjm9T4stpd_qubQ87FiZIG1O1jO75PHgcD_cnuA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYPhTqvXXehi8PXpBDv77WxUv8_u0vu7H77w9f4HDh-Q&oe=6B083B4B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Echocardiography VR - VML", "keywords": ["Echography", "POCUS", "Medical", "Ultrasound", "Healthcare"], "long_description": "**Echocardiography VR**, by VML, is a virtual reality simulation that transforms how medical students and healthcare professionals learn cardiac ultrasound.\n\nStep into a simulation room where you'll master transducer positioning, orientation, and anatomical recognition through hands-on practice. Place the probe on your virtual patient, adjust it to find the correct windows, and activate **X-ray mode** to see how your transducer intersects the heart in real-time.\n\nThe machine offers three learning modes:\n- **2D Mode**: real echocardiography footage as you scan\n- **Freeze Mode**: anatomical illustrations where you identify each structure\n- **3D Mode**: slice through an interactive heart with a special probe and switch to ultrasound-style materials\n\n**Egbot**, your android guide, walks you through a complete tutorial to get the most out of each mode.\n\nWhether you're a student or healthcare professional, this simulation gives you a safe environment to build confidence before scanning real patients!", "short_description": "Improve your echocardiography skills with this immersive VR simulation! Step into the operating room to scan your virtual patient. Learn to identify different cardiac structures through interactive visualizations: see through the chest as if using X-rays, dissect a 3D heart to understand each structure, and more. All guided by Egbot, your virtual tutor."}, {"images": {"nodes": [{"file_name": "Cover Landscape_FULL_ES.png", "id": "2558894087837590", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491822968_2558894094504256_5404181423913633795_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kL32mP9bSx8Q7kNvwFKLxW4&_nc_oc=Ado_xkX8yaJDJGh0z4VsR2uiXDOfM2I8g3BU1Gt1fzT1jb18FYvS2USZ2sf-NY4Ay9o&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTe8MU2uCw4RKwBvF247lRqlP5o9kYFpXzWKVvcoDnM0A&oe=6B086F2E"}, {"file_name": "Cover Landscape_FULL_ES.png", "id": "1971181917156082", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491830888_1971181920489415_1647681755962022117_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vk5R_z-uRiAQ7kNvwFwBTdp&_nc_oc=Adq1M5URlc2B7NWfHOjghbbc6y0pkrZSZjPJTNo8H8qAUmJbXLmpuZThPd_rd3CgJ-8&_nc_zt=3&_nc_ht=scontent-d
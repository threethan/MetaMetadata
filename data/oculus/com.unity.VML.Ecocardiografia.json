ps://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619836_1237132168326387_2183731442049155847_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ujwd_JuIdGUQ7kNvwE6_WlD&_nc_oc=AdobB0HNYfHNfatNT1JS68OqJulTltP8otVJmHJyWMAGgPou7j0LI3QSdIDpMKYEw8o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBiYj7wrApwy9JpcvT0UtNtq3wMvFlt_7y_jJp0JeWjg&oe=6A9855CF"}, {"file_name": "Cover Landscape_FULL_ENG.png", "id": "884644501207363", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823893_884644504540696_1379382285860789409_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cZKzU32iAosQ7kNvwHb400H&_nc_oc=AdrnKrp9Y0M5YinMvzUqaRcwIxoykYWziJhGmrdjMJ67j6aisVmjOdI_0XOQhtEhH3U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2rvM_IG1HNi7gtrwx8Wf70zIMleG_U8yJkRXGTWQ_Tg&oe=6A98427E"}]}, "id": "2481659452294539", "locale": "en_US", "screenshots": [{"file_name": "ecocardio-Screenshot-001.png", "id": "1204174037792977", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473400248_1204174041126310_5851841347649338254_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MutASutI2jMQ7kNvwGBBHNC&_nc_oc=AdqH8GERcqGid6ZxV9iKRGtFPHAk1AJ-JioFxCQhtlk0jLUZmkVVCWDkK4TUb7CRxEI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJczQLT1W89JJZWljpKyicyH3azvJf9crDeACPuhsRVQQ&oe=6A985CA1"}, {"file_name": "ecocardio-Screenshot-002.png", "id": "1683364999261437", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391911_1683365002594770_6182534077774161018_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VbFCx7-ZXH0Q7kNvwEnuVuG&_nc_oc=AdqVtXDPDVWdP7UgsHEpFQDxfZ6LVwAJV0DiTnMcT84AuJ4cRmYA393xo64MCs8YO3M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0CY-gUMZWhbw8TIyCl0IG1xpjHUJor5e24b3qKaA2QQ&oe=6A985EFF"}, {"file_name": "ecocardio-Screenshot-004.png", "id": "645259521197957", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391893_645259524531290_1221040782683536363_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Ps_XTaJ0JcQ7kNvwEN2FP6&_nc_oc=AdpRUabGRt_IgLPLPT1wy4WbyLksIJXQrPUshHAJaV527YuhteIVJrpv0rrRMrnmw-Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL25805y0Zd-BtkFNGOKEmnxBjNMlYXcLJafvutSxNaEw&oe=6A98414E"}, {"file_name": "ecocardio-Screenshot-003.png", "id": "663923902976794", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393984_663923906310127_5574735863383485136_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OFSOr8TyPPwQ7kNvwHfWn3X&_nc_oc=Adr4eiqbBKzcGPrk3W5aKG7LjvTsvrISSLz9yWATCsT5zxFXkl3-lsJ5M7lxsnFg7fo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2Yb3zGBJYqhcGsubTUywnf_t6B69mVAp3hg8qLcypIA&oe=6A9849D9"}, {"file_name": "ecocardio-Screenshot-005.png", "id": "590596830460245", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391890_590596833793578_6307124770371399137_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jq2KLJ4TqpMQ7kNvwHID7Ye&_nc_oc=AdqEAZldkfr34fkEvN1Si8bMRxzs9ckdZmAk-rEpIVLDgAwazj9qzAC_6jYa1rAT3Ds&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4oLl8Xoap1zyM14ux2xWc-Kh88XHZDs21W9JpdtZBvg&oe=6A98640B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Echocardiography VR - VML", "keywords": ["Echography", "POCUS", "Medical", "Ultrasound", "Healthcare"], "long_description": "**Echocardiography VR**, by VML, is a virtual reality simulation that transforms how medical students and healthcare professionals learn cardiac ultrasound.\n\nStep into a simulation room where you'll master transducer positioning, orientation, and anatomical recognition through hands-on practice. Place the probe on your virtual patient, adjust it to find the correct windows, and activate **X-ray mode** to see how your transducer intersects the heart in real-time.\n\nThe machine offers three learning modes:\n- **2D Mode**: real echocardiography footage as you scan\n- **Freeze Mode**: anatomical illustrations where you identify each structure\n- **3D Mode**: slice through an interactive heart with a special probe and switch to ultrasound-style materials\n\n**Egbot**, your android guide, walks you through a complete tutorial to get the most out of each mode.\n\nWhether you're a student or healthcare professional, this simulation gives you a safe environment to build confidence before scanning real patients!", "short_description": "Improve your echocardiography skills with this immersive VR simulation! Step into the operating room to scan your virtual patient. Learn to identify different cardiac structures through interactive visualizations: see through the chest as if using X-rays, dissect a 3D heart to understand each structure, and more. All guided by Egbot, your virtual tutor."}, {"images": {"nodes": [{"file_name": "Cover Landscape_FULL_ES.png", "id": "2558894087837590", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822968_2558894094504256_5404181423913633795_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4T3JAYiknrcQ7kNvwGkDSt3&_nc_oc=Adr2uTdvmNDeUN61QN5iNIjPxKxTWoqBUb9hGgp_SVvHVJ2KSjYfFjBSOCgShBblUUA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZ078Bkqj-3uTKAV8VTB-30hS2qWOwYhIkzPXCd3-l0Q&oe=6A985FAE"}, {"file_name": "Cover Landscape_FULL_ES.png", "id": "1971181917156082", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830888_1971181920489415_1647681755962022117_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ahXmeii-kGQQ7kNvwEO-5MX&_nc_oc=Adp-AV_x7HgQzG_vNsaGq9RMdTwzIFVO2GlBEeu82ANOgtcgPA8w6rBtciUzsdy9n0g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKw7s3fWHBN-w0T0Lxtr2R1fMuvompMXRJhnPP8D5SaWA&oe=6A985629"}, {"file_name": "Cover Square_FULL_ES-1.png", "id": "1912394656053179", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823893_1912394659386512_7066665920184004452_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mv1DRUjBstgQ7kNvwGea_kd&_nc_oc=AdrPZyqBq9cmqiB-KTyUNf4tiU3HtbmAntoEDGWP481J-2pdX-PXfzlen9kw7EaTUQk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLrH9NuLCk0spmtLqmGEe8BizX_0IujsK2a8mQS0n8jwA&oe=6A98670C"}, {"file_name": "Cover Portrait_FULL_ES.png", "id": "1822870681733204", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827703_1822870685066537_4560401566713579284_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2RjC-so0OPAQ7kNvwHVoy9P&_nc_oc=AdqOAIRG38Q_7KO849yXWsGQAsh87aTw8KumqfyhNe7n5Sh_2bQe9wvP-rnC2_8MdIU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKi9Unyv4lnRGKKnC38H_K6cWwb5nMdTNUQXW3qAVVWNw&oe=6A98362C"}, {"file_name": "ECHO-DEMO-SQUARE-3.png", "id": "1465068948371145", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827725_1465068951704478_8306382549700619272_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zIiMF0kYxnsQ7kNvwGH950b&_nc_oc=Adr_7T6X-4NRh4ApGsK2zOpY9MrpSRulfqn-Q6sWwImaazGd2GGrVMJdoKNjdROswag&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIASi02AjJakV46wT7YJrX6Vp_WjR3QifwBpD4tivmdVQ&oe=6A985F86"}]}, "id": "1234561742089673", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ecocardiograf\u00eda VR - VML", "keywords": ["Medicina", "Ultrasonido", "POCUS", "Ecografia", "Salud"], "long_description": "**Ecocardiograf\u00eda VR**, de VML, es una simulaci\u00f3n de realidad virtual que transforma c\u00f3mo estudiantes de medicina y profesionales de la salud aprenden ultrasonido card\u00edaco.\n\nEntra a una sala de simulaci\u00f3n donde dominar\u00e1s el posicionamiento del transductor, su orientaci\u00f3n y el reconocimiento anat\u00f3mico mediante pr\u00e1ctica activa. Coloca la sonda en tu paciente virtual, aj\u00fastala para encontrar las ventanas correctas, y activa el **modo rayos X** para ver c\u00f3mo tu transductor intersecta el coraz\u00f3n en tiempo real.\n\nLa m\u00e1quina ofrece tres modos de aprendizaje:\n- **Modo 2D**: videos reales de ecocardiograf\u00eda mientras escaneas\n- **Modo Congelado**: ilustraciones anat\u00f3micas donde identificas cada estructura\n- **Modo 3D**: corta un coraz\u00f3n interactivo con una sonda especial y cambia a materiales estilo ultrasonido\n\n**Egbot**, tu gu\u00eda androide, te acompa\u00f1a con un tutorial completo para aprovechar cada modo.\n\nYa seas estudiante o profesional de la salud, esta simulaci\u00f3n te da un ambiente seguro para ganar confianza antes de escanear pacientes reales.", "short_description": "Mejora tus habilidades de ecocardiograf\u00eda con esta simulaci\u00f3n inmersiva en VR. Ad\u00e9ntrate al quir\u00f3fano para escanear a tu paciente virtual con videos reales de ultrasonido, y aprende a identificar las estructuras card\u00edacas mediante visualizaciones interactivas: ve a trav\u00e9s del t\u00f3rax como si usaras rayos X, disecciona un coraz\u00f3n 3D, y m\u00e1s. Todo esto guiado por Egbot, tu tutor virtual."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vml.solutions/privacy-echocardiography-vr-vml", "developer_terms_of_service_url": null, "publisher_name": "Virtual Medical Learning", "support_website_url": null, "website_url": "https://vml.solutions/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["es_MX", "en"], "supported_input_devices": ["OCULUS_TOUCH"], "suppor
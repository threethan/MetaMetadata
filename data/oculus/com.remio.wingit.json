97781816389", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982584_926297785149722_4227410942138075850_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0NXBXBfyD_gQ7kNvwFz4G46&_nc_oc=AdnfNp4ML1b6w5j8Lkepd8HziN_9BuLZqDWiirp-Z4uDT7yR5saixVFtUyZ5WFTjeQk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afw3V6ycDz7Ithb2HfkRTAyEEYklR99hH0Nazl-WnYTkUg&oe=69BFEEA6"}, {"file_name": "5.png", "id": "673317157978047", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001732_673317161311380_6367319820395155286_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LHIRM3RvK4UQ7kNvwFevtxq&_nc_oc=AdmSjYZQu7G5DKcIMYIXGHiBEefkcvwH1QKc4bUFEJZ_cRSwc2ahgZHgsUP6fvoEu0c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxGql-GNpOdPTOKPZ1nIYyVu8zIUAGY191UzFNcFBrX9w&oe=69BFEFF3"}, {"file_name": "Screenshot (447).png", "id": "628875279216230", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566698_628875282549563_4913645439909033743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cN6mFsuI5yIQ7kNvwFwPMEI&_nc_oc=AdlB_Ymuinehi4uCoHLJWr4RkXlCw6BLM0bNNS-F1DG9weEfYukjAZP0bWA2mGV2VRA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy_p0yX3E_jfqE24zKE5PSVsEPn4eLXjdTe0PQrdFPkqg&oe=69BFE25B"}, {"file_name": "3.png", "id": "3187958854840290", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974513_3187958858173623_2630061441027911886_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l9xGHPyHIeIQ7kNvwG-hbnF&_nc_oc=AdnZUFcQZoX8XXdh6pdPfJBjrOozk9D5wxKItcYRkITMjXLc4gXYRYD3DRqfgqgYUYo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzQD2zK5RWx9y5DsrvjTkQUIl6YoxX8Q1yLidf5cOVdZg&oe=69BFF98F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (4).png", "id": "941214970482404", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031643_941214973815737_2432176783600565336_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vRs7Bzae3CAQ7kNvwECt901&_nc_oc=AdkIBJh4FgMlb8_JzSTTUHgeXxi8Vbkq1PsGXA74Y0e8-tHWpKobKxwlF1tuDQpitik&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwqx7fNDjtnSPIHiiT2ZZK6MflnQSJ2y5PJ08hB17dU0w&oe=69BFF872"}, "display_name": "Wingit", "keywords": [], "long_description": "Unleash Your Inner Bird in Aerial Dogfights and Races.\n\nEver dreamed of soaring through the skies as a majestic bird, engaging in thrilling air-to-air challenges, or participating in high-speed tag races?\n\nWe\u2019ve been developing a unique bird flapping and gliding mechanic that brings this experience to life in our upcoming multiplayer game, currently dubbed \u201cWingit\u201d.\n\nWe\u2019ve created a basic block-out map and implemented an infection game mode for testing purposes. However, we\u2019re eager to explore more game modes and perfect the overall experience.\n\nDepending on how you choose to fly, this game can be quite a lot of exercise :)\n\nWatch the attached video for a glimpse into the heart-pounding action and join our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN", "short_description": "Flap, glide, swoop, dip and flap to soar like a bird. Hang out with your friends or play a game of Tag, Hunt or make it up as you go."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Remio", "support_website_url": null, "website_url": "https://remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_d
ingit_Render_1.png", "id": "926297781816389", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982584_926297785149722_4227410942138075850_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-DLX7Uk0EOYQ7kNvwF1Rlsd&_nc_oc=AdpSeQhLfsaHUnpmA7-w0lXoEKBoWOZz_9DWtqME81tyyQh7BjVTWLjwYgC48xhgj7M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGni__c2gDb6wx5KSQ1XFaUy5uTZb_st9pO7k7q47Rzyg&oe=6A8C4726"}, {"file_name": "5.png", "id": "673317157978047", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001732_673317161311380_6367319820395155286_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CPByYv4D0vEQ7kNvwEujcJX&_nc_oc=AdrQ_9PD2ESNGtDD_DSG08xkK6lnKZ5HxHsgmjvR2wljtODsWAdEMgacmJq2_d4GGkk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG0Nq8xDZ_VQsy0EPmVjY5S6BxPO_kVV3EKN_Eppwa8hA&oe=6A8C1033"}, {"file_name": "Screenshot (447).png", "id": "628875279216230", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566698_628875282549563_4913645439909033743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OxqySNrI598Q7kNvwGe6iZr&_nc_oc=AdpUQmLGSjP0niym8xkq474wMqntBZ5JRLlCkekVot3ViOBnn_gpyjOU8GWc5IEKE3U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBUKkCluTFpcMonqSCAxcTupLGlnMRwT2e1kx6Todp6g&oe=6A8C3ADB"}, {"file_name": "3.png", "id": "3187958854840290", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974513_3187958858173623_2630061441027911886_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PFXFWstP6ZkQ7kNvwFD2XpO&_nc_oc=Adp09pouHfCJC3Kf9wO_wDLtL4CRdIPCJhKFUMWXNhwIOihRCu7jMiKJXxepKiaFXzc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFEtS3A73epaHjd-4pqzEfcLLz1pAO7V_hPYyt_pfey8g&oe=6A8C19CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (4).png", "id": "941214970482404", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031643_941214973815737_2432176783600565336_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UN6IAPiPAGUQ7kNvwFRMc3A&_nc_oc=AdoAyzlwb4Pq0M2z4XpQZ0wd-pMgVNGLRSdKQfI7JM0p6RTgZUQvcGMSqinrVZErc0Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFOpvQlNmgvsDRmsaWbJo0G6vXv1EH4YyCbWeo0bMB7BQ&oe=6A8C18B2"}, "display_name": "Wingit", "keywords": [], "long_description": "Unleash Your Inner Bird in Aerial Dogfights and Races.\n\nEver dreamed of soaring through the skies as a majestic bird, engaging in thrilling air-to-air challenges, or participating in high-speed tag races?\n\nWe\u2019ve been developing a unique bird flapping and gliding mechanic that brings this experience to life in our upcoming multiplayer game, currently dubbed \u201cWingit\u201d.\n\nWe\u2019ve created a basic block-out map and implemented an infection game mode for testing purposes. However, we\u2019re eager to explore more game modes and perfect the overall experience.\n\nDepending on how you choose to fly, this game can be quite a lot of exercise :)\n\nWatch the attached video for a glimpse into the heart-pounding action and join our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN", "short_description": "Flap, glide, swoop, dip and flap to soar like a bird. Hang out with your friends or play a game of Tag, Hunt or make it up as you go."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Remio", "support_website_url": null, "website_url": "https://remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "sup
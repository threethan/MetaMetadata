ingit_Render_1.png", "id": "926297781816389", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38982584_926297785149722_4227410942138075850_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bHruQJ5Thu4Q7kNvwGVmZR6&_nc_oc=AdozdY7UzOETCtqzbfMMRkPC849zRpRs2LlzBbDdtuqr7oNxzjW-sLPchwdSt8Paqcg&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2DTGvJH6Qgg3qgwiH7qQ2KvnT4ZJ84Rbe2B-tobwZMOA&oe=69E235A6"}, {"file_name": "5.png", "id": "673317157978047", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39001732_673317161311380_6367319820395155286_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OoHkN4virQMQ7kNvwGza0s2&_nc_oc=Adq7SolGL33sIUc6HQMyXaB-DPPRy-o81IzXZybed5XTpQYofMewywJBRAybj7RU3lM&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3_n4rRnhzCG4_bOm4-nP6zZDfRgTCr3z9Zr54AGCYh1Q&oe=69E236F3"}, {"file_name": "Screenshot (447).png", "id": "628875279216230", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/57566698_628875282549563_4913645439909033743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zb7LxomJ_rEQ7kNvwF4p4mi&_nc_oc=AdpLhkDfC9DUjvuNZe0Wd3S4q6oomqTRQtqAbpdbc7dsN2lvkcUe0Rb_Z4joW1O0k6U&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ByW6gU7xb8w0TnpkwjicFhwTBioWsb-6kEMjusvXaoQ&oe=69E2295B"}, {"file_name": "3.png", "id": "3187958854840290", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974513_3187958858173623_2630061441027911886_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YqdMw15sL_YQ7kNvwFzOCz6&_nc_oc=AdpzG7BpwN2qaEqrq4T3IXZVIjU7cwbnJwMx1wzh4u96KXh99mPhVmxtt0ue3n4FYDM&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1wNYQxoGqvhUPzGkPNVk8Ah2ZIPIPWYbE--ETSFvJS5g&oe=69E2408F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (4).png", "id": "941214970482404", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/39031643_941214973815737_2432176783600565336_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kfpVGTrH6yoQ7kNvwHiblMc&_nc_oc=AdpJVQUtnlpCdhZLXs70e6PqZYIxcxiNi5hwhCsWshKKLzeYxPvs3nWWbHmG-Evd404&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2X6HGbeBqcCHHQq6a3s0CS-bqIcJJjokEODMzkqB1qbQ&oe=69E23F72"}, "display_name": "Wingit", "keywords": [], "long_description": "Unleash Your Inner Bird in Aerial Dogfights and Races.\n\nEver dreamed of soaring through the skies as a majestic bird, engaging in thrilling air-to-air challenges, or participating in high-speed tag races?\n\nWe\u2019ve been developing a unique bird flapping and gliding mechanic that brings this experience to life in our upcoming multiplayer game, currently dubbed \u201cWingit\u201d.\n\nWe\u2019ve created a basic block-out map and implemented an infection game mode for testing purposes. However, we\u2019re eager to explore more game modes and perfect the overall experience.\n\nDepending on how you choose to fly, this game can be quite a lot of exercise :)\n\nWatch the attached video for a glimpse into the heart-pounding action and join our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN", "short_description": "Flap, glide, swoop, dip and flap to soar like a bird. Hang out with your friends or play a game of Tag, Hunt or make it up as you go."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Remio", "support_website_url": null, "website_url": "https://remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "sup
97781816389", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982584_926297785149722_4227410942138075850_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KNrC0ZXMhhsQ7kNvwHE_gqh&_nc_oc=AdlEwirCGgYD3zF8chbF5cC7AMaA8RwnruYjEYhL6J3nDjcTOY4rF37aWoxXrbIEKtQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afvs_qcUh28JYBjufEpzRX6-qILlW33prqI9DnrcXr2cUg&oe=69A833A6"}, {"file_name": "5.png", "id": "673317157978047", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001732_673317161311380_6367319820395155286_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rCcORApJcYUQ7kNvwFZMdJz&_nc_oc=Adks56Hx4_dLBX2iYiUKjZ7Tx69Dve5mzHXg4uqUzAl9VD15R3SmBYWg_QIH7JTd7jY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afu-z_a8JW8rekeyGxvrMmOkxNNckcQo75zVNk8wvhn2kg&oe=69A834F3"}, {"file_name": "Screenshot (447).png", "id": "628875279216230", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57566698_628875282549563_4913645439909033743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xM-KkiRdA8kQ7kNvwHsrWYb&_nc_oc=Adn6eV5F1y5JOTVzkv6YVMdQuGF05xxlsAOeT86obJZ40OSfGXJDVgGNIhEbSefMwcw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsooQcWcgjiYiIJKifysD8yB9jLq5EFp6__OalIXJMHyQ&oe=69A8275B"}, {"file_name": "3.png", "id": "3187958854840290", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974513_3187958858173623_2630061441027911886_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AoPic46EAhcQ7kNvwHzknwI&_nc_oc=AdnrEvT0LbUNrVrUglxOHy39vpbHpgI2Ta9bvg5yhlcaC_ZDacZ-FPb2DlvRNupk_rw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftU78ZqPjkwAW-1baAen3D-r8iMLpFNw_JOMAQ_-COWXA&oe=69A8064F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (4).png", "id": "941214970482404", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031643_941214973815737_2432176783600565336_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=il3SPjcI9MgQ7kNvwGfhdnj&_nc_oc=AdngCORxP4-BDd8UDtQdbBP5tbZLACUhAFrJZyk9rD1Z2XFHTigLZT8wcYyi319g-xs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afs-T12U_V8DZGgSfPFj3fsqPTXsgHudCq1dwGB3w9qGmQ&oe=69A83D72"}, "display_name": "Wingit", "keywords": [], "long_description": "Unleash Your Inner Bird in Aerial Dogfights and Races.\n\nEver dreamed of soaring through the skies as a majestic bird, engaging in thrilling air-to-air challenges, or participating in high-speed tag races?\n\nWe\u2019ve been developing a unique bird flapping and gliding mechanic that brings this experience to life in our upcoming multiplayer game, currently dubbed \u201cWingit\u201d.\n\nWe\u2019ve created a basic block-out map and implemented an infection game mode for testing purposes. However, we\u2019re eager to explore more game modes and perfect the overall experience.\n\nDepending on how you choose to fly, this game can be quite a lot of exercise :)\n\nWatch the attached video for a glimpse into the heart-pounding action and join our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN", "short_description": "Flap, glide, swoop, dip and flap to soar like a bird. Hang out with your friends or play a game of Tag, Hunt or make it up as you go."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Remio", "support_website_url": null, "website_url": "https://remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_d
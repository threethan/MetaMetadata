ingit_Render_1.png", "id": "926297781816389", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982584_926297785149722_4227410942138075850_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HydCL9vTtbEQ7kNvwEVjpYw&_nc_oc=AdomqLxpmIDLtC5dTjMYpsZPoLFLPk-huaGDr5jA4Jof_SapUm9Lhwmjly8O5cBMW8c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-ZEavSegGh-6_J92QEtuEExVPlmip1eP_47wBgV-aiw&oe=69FF36A6"}, {"file_name": "5.png", "id": "673317157978047", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001732_673317161311380_6367319820395155286_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=shGuCdr6M50Q7kNvwGBwsbf&_nc_oc=AdrUw8zrAscTMbki-U7QndbC91ViPmmqUFFsdsKHPVr7oEX6ERfQfZesyJvlY0dg_fo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7voiFuYavXlLp16Gm3O1-S69iKWgI8oVUc6NxoGaVHKw&oe=69FF37F3"}, {"file_name": "Screenshot (447).png", "id": "628875279216230", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566698_628875282549563_4913645439909033743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HYneHqOKExsQ7kNvwFW55Iu&_nc_oc=Adrg-OQ5Z3mfOYecgTxmMkldyIOu1NW9W-3q-eaGprIMf8S4ok5Km18GgRh5Xr819zo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7RHy3wh_43bIA616PEoiNzlmzyy1Drs_82ASDDBsd3Ow&oe=69FF2A5B"}, {"file_name": "3.png", "id": "3187958854840290", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974513_3187958858173623_2630061441027911886_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dFDQJY8HGm0Q7kNvwG_EcWa&_nc_oc=AdpDL_Ppn0S31YYbL7HB3dOeb0OGsavZegfFXFCZxT0AF7k7ymJLUN8NNKQ_mCFIG4s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4e4DgkguG6zZrubJtUmRNDfvN4m1fjG0QF-3jOdWUY4Q&oe=69FF418F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (4).png", "id": "941214970482404", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031643_941214973815737_2432176783600565336_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xpnFYONKqi4Q7kNvwG9KtfR&_nc_oc=AdqgjbbEHZWhLKFRm7Vuz30aVCG4FLbJoEQvxHk3inO0k11OnxaEwHrl5gfYcJk1KQY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7df3Lkac9RIluS69lUOg6YeDkjEa4DpBNPjSERwwgP-A&oe=69FF4072"}, "display_name": "Wingit", "keywords": [], "long_description": "Unleash Your Inner Bird in Aerial Dogfights and Races.\n\nEver dreamed of soaring through the skies as a majestic bird, engaging in thrilling air-to-air challenges, or participating in high-speed tag races?\n\nWe\u2019ve been developing a unique bird flapping and gliding mechanic that brings this experience to life in our upcoming multiplayer game, currently dubbed \u201cWingit\u201d.\n\nWe\u2019ve created a basic block-out map and implemented an infection game mode for testing purposes. However, we\u2019re eager to explore more game modes and perfect the overall experience.\n\nDepending on how you choose to fly, this game can be quite a lot of exercise :)\n\nWatch the attached video for a glimpse into the heart-pounding action and join our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN", "short_description": "Flap, glide, swoop, dip and flap to soar like a bird. Hang out with your friends or play a game of Tag, Hunt or make it up as you go."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Remio", "support_website_url": null, "website_url": "https://remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "sup
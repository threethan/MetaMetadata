ingit_Render_1.png", "id": "926297781816389", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982584_926297785149722_4227410942138075850_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pkNLSdgud2oQ7kNvwEo4RhT&_nc_oc=AdpBbnjVN8t-7MVxb8K_PAYcRVls8KM4dg_u0tmBYCJ7oM4YZW7-si1fAG97fLLyINU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzXpr4QWv1VqzZWZzNx6WddA2iMl6H3QIzFFEPoHGnZWw&oe=69CBCC26"}, {"file_name": "5.png", "id": "673317157978047", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001732_673317161311380_6367319820395155286_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EPixkk5ZUg4Q7kNvwFjBVo4&_nc_oc=Adpg7CPfS-F8gLtb1rOTIj6T6wca_LJo8LY5RqEP3FPB992wRHxuazpsp4xKmyM07a4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzPWsukPIZJnGP51m3Ksu_WobOrw-7LCqwZirSuYjSAMQ&oe=69CBCD73"}, {"file_name": "Screenshot (447).png", "id": "628875279216230", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57566698_628875282549563_4913645439909033743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fuWnTFahJ5AQ7kNvwHQDHdg&_nc_oc=Adpmmnpn0NPxtqoorPHW4pqjWBXACONOBT_YPTjYeNrrIV4Hv3EAgZBgvMpYD5BaiBo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxY6iRt4TA0wJ3AQYEt2j3dudgVMBOn5Th_PpQ_Ix42hg&oe=69CBBFDB"}, {"file_name": "3.png", "id": "3187958854840290", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974513_3187958858173623_2630061441027911886_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ogWjruTuN0wQ7kNvwFTHUbu&_nc_oc=AdoIH41zyqlT_v3zjzKpb9BXPfCSZqjx6PbylCnqTirv2qxZyiW0C0EcaijkZEQFlak&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz91OALa6SkcYGlwFf38llWCOvvUKc7i-2jnyUQDuI7kQ&oe=69CBD70F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (4).png", "id": "941214970482404", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031643_941214973815737_2432176783600565336_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vi5XZkIfdrIQ7kNvwEKB8wD&_nc_oc=AdoJYqMgewV2RrbdpQ5Df6UVzIabvWpvkigy3WtECySj0lzRL2wLOl_vhYZwYpjqPJs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzdbf3uYwCLh8yoAE7qaSRtcUkwCtr-pzCl9edgZBABcQ&oe=69CBD5F2"}, "display_name": "Wingit", "keywords": [], "long_description": "Unleash Your Inner Bird in Aerial Dogfights and Races.\n\nEver dreamed of soaring through the skies as a majestic bird, engaging in thrilling air-to-air challenges, or participating in high-speed tag races?\n\nWe\u2019ve been developing a unique bird flapping and gliding mechanic that brings this experience to life in our upcoming multiplayer game, currently dubbed \u201cWingit\u201d.\n\nWe\u2019ve created a basic block-out map and implemented an infection game mode for testing purposes. However, we\u2019re eager to explore more game modes and perfect the overall experience.\n\nDepending on how you choose to fly, this game can be quite a lot of exercise :)\n\nWatch the attached video for a glimpse into the heart-pounding action and join our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN", "short_description": "Flap, glide, swoop, dip and flap to soar like a bird. Hang out with your friends or play a game of Tag, Hunt or make it up as you go."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Remio", "support_website_url": null, "website_url": "https://remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "sup
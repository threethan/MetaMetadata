ingit_Render_1.png", "id": "926297781816389", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982584_926297785149722_4227410942138075850_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j4yq2PXIIbUQ7kNvwH9SVEJ&_nc_oc=AdqSvYQWKxiGLYw_dtNIX3xEnKlu7UxFlBMdiH33ITWU5ahYN2dtsu4cQfJlr363Fek&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6kBeOo2vg8I2pTWUVxK30d3Fklu4pUGZ3tubi7SeBh6A&oe=6A0F08A6"}, {"file_name": "5.png", "id": "673317157978047", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001732_673317161311380_6367319820395155286_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0m534ahcXfcQ7kNvwEbsg1Z&_nc_oc=AdrQpigbBIV6sBhkyd-MrDmdYPnJoqHk1CakW74kU6zR1Fdh1Aeq1spdbJHQEfnNsYo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-_o4PLISnHuBb-fBAl9_M9OVGisYQp97YqGr6E53khw&oe=6A0F09F3"}, {"file_name": "Screenshot (447).png", "id": "628875279216230", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57566698_628875282549563_4913645439909033743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SBp-FWrUzY8Q7kNvwHcRp0q&_nc_oc=AdrY9U3oBT0EVdNy7rRfCdxVqeNiJvAul1aVJsR3vp_GOD_0NMtTEIicHf39H0fhJY8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4H5GkZEQuacehqHFZTuTHvZmj56yp_4bIfCgeTYmmTbQ&oe=6A0EFC5B"}, {"file_name": "3.png", "id": "3187958854840290", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974513_3187958858173623_2630061441027911886_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9l9IGM-YbtAQ7kNvwHFK1PE&_nc_oc=AdonEx3j2k0GCzBNWKaNNC4j0uKvWqtfJSG6FnaehFLS1qXPX5guYe6NFd0odRwqkZQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4iLht6752RlLHR75LSgbIYdSkf7qpIfJSJ5gXQaECXng&oe=6A0F138F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (4).png", "id": "941214970482404", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031643_941214973815737_2432176783600565336_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z1o8onoovKgQ7kNvwEzaKF1&_nc_oc=AdoeQAIv41MXuQyF62Umwg4YwQbDBDAIvbcPWuP8mPKmC4PxFLFhxkxYUowdxKS7l7Y&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4g28ZlQxD8X5K-EariM0QJvzT89HFLiCP_FwdL9SHNzQ&oe=6A0F1272"}, "display_name": "Wingit", "keywords": [], "long_description": "Unleash Your Inner Bird in Aerial Dogfights and Races.\n\nEver dreamed of soaring through the skies as a majestic bird, engaging in thrilling air-to-air challenges, or participating in high-speed tag races?\n\nWe\u2019ve been developing a unique bird flapping and gliding mechanic that brings this experience to life in our upcoming multiplayer game, currently dubbed \u201cWingit\u201d.\n\nWe\u2019ve created a basic block-out map and implemented an infection game mode for testing purposes. However, we\u2019re eager to explore more game modes and perfect the overall experience.\n\nDepending on how you choose to fly, this game can be quite a lot of exercise :)\n\nWatch the attached video for a glimpse into the heart-pounding action and join our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN", "short_description": "Flap, glide, swoop, dip and flap to soar like a bird. Hang out with your friends or play a game of Tag, Hunt or make it up as you go."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Remio", "support_website_url": null, "website_url": "https://remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "sup
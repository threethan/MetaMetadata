09_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wop3SMW5bL4Q7kNvwHIT26X&_nc_oc=AdrAM_iOcLLoI3sEWxAOYWKrXH05b5ZcDQmcWHu_Kkt48iq7vwMFKZ4OqKw7jpNC93o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNHmRzzEzARaOH87FtnCGUO7p4MNHt_IcR0qNGQyaZatg&oe=6AE0CA9B"}, {"file_name": "3.png", "id": "1178829089457402", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035408_1178829092790735_4177157206921738101_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oib1VgW0tZ8Q7kNvwGSz2Hs&_nc_oc=AdqCQz-WTQYKFsTFQsgqNgk6dLPrY2NpAGOzuDi0cpz0HXWj6K9XAepoX3HEZ3nxaao&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPz6Dusz4Gc2bZtimgU6C-981BgBWEl1hhBfVVnoyBpdA&oe=6AE0A79F"}, {"file_name": "5.png", "id": "191014460539420", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75221326_191014463872753_8085014165971567389_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XujXcII0jvMQ7kNvwH3rF76&_nc_oc=Adp6bYJ7CbEWO580_BPbsTY8mK3t6LGJmfjcd1YvAPgMLkHQ8QIFkPAWqSePAlPPXS0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNkHhT-nKbJCP1mB2WGqHDZpjOVNSR35zjzcZGsBRB6yA&oe=6AE0B6C5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YT cover.png", "id": "795036341841578", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75221326_795036345174911_8871026441229388364_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q_QsOCxJrGAQ7kNvwG-QbFq&_nc_oc=Adr2LuASSSRRpq7hMFT8clnmFrgV2jbU9bkLJgjCIknGELKJU66n7hVPJjVIJI6pPkM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNvYqKJueczF4HSbMW4r-0N_WRGoCllT1oqcj9wbY837g&oe=6AE0CB04"}, "display_name": "Wingit", "keywords": [], "long_description": "Unleash Your Inner Bird in Aerial Dogfights and Races.\n\nEver dreamed of soaring through the skies as a majestic bird, engaging in thrilling air-to-air challenges, or participating in high-speed tag races?\n\nWe\u2019ve been developing a unique bird flapping and gliding mechanic that brings this experience to life in our upcoming multiplayer game, currently dubbed \u201cWingit\u201d.\n\nWe\u2019ve created a basic block-out map and implemented an infection game mode for testing purposes. However, we\u2019re eager to explore more game modes and perfect the overall experience.\n\nDepending on how you choose to fly, this game can be quite a lot of exercise :)\n\nWatch the attached video for a glimpse into the heart-pounding action and join our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN", "short_description": "Flap, glide, swoop, dip and flap to soar like a bird. Hang out with your friends or play a game of Tag, Hunt or make it up as you go."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Remio", "support_website_url": null, "website_url": "https://remiovr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "604415144974293"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28985488061065157", "version": "2.139"}, "id": "1169779027757091", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": 
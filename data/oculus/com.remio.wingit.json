ingit_Render_1.png", "id": "926297781816389", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982584_926297785149722_4227410942138075850_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_qgi9zU2osUQ7kNvwFiiQyl&_nc_oc=AdrvUTIBOIwuXSJSlA5MFtsbjNbsaqIQmaqvT6udQ9PBYC9JRNTM-9aCTwp7z2NCBlM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af06gx7t5dC9x_-Yix5ko785YuG4tsNQy_9LzXF3M6D3-w&oe=69D506A6"}, {"file_name": "5.png", "id": "673317157978047", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001732_673317161311380_6367319820395155286_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MqWsQXT012YQ7kNvwHZMPo-&_nc_oc=AdrFXA-7EsO7_-_8tnbO34ChBQO6kADBkQvli4CxOAWA0Ozp8AyPNMuS0K6u8STgIr0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2WcGFa3EH5iE0T273fHc0jTlw9J84UPm2dDbpkQT_siA&oe=69D507F3"}, {"file_name": "Screenshot (447).png", "id": "628875279216230", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57566698_628875282549563_4913645439909033743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E8tvjqp8jAsQ7kNvwGVOOj3&_nc_oc=AdqZs-u0aezxGVTvq7i1HmWqNsaAX4JCaWq2RU5OceFegUt4jJDgMsg_Keb2DuFdO3o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3-NRGfN01nj30ijc7jHS1OCjiyJzshMC3gocHVKoFxRg&oe=69D4FA5B"}, {"file_name": "3.png", "id": "3187958854840290", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974513_3187958858173623_2630061441027911886_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ID_MjyjRLYQ7kNvwG-HFfm&_nc_oc=AdpbzCeK22LDKpcsr8WQqr2h0luNqfB3rOBBp3se-2gjiK3vSEw6ZUim86MhOAm5YtA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af23gCFQcBTXSr4xyZly_FZfPVwiIb72oEMkkcWfbuaVrw&oe=69D5118F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (4).png", "id": "941214970482404", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031643_941214973815737_2432176783600565336_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MJTwZ4LGDYoQ7kNvwER-9IJ&_nc_oc=AdpBNKdIU3Q1TxjeA9myTsAveaOo2RiGtt0G1c2L3Jc5QfjyHC2yPEnZhuDifhUC4Pk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Yp_fMsnuzuP-GIz7u37ibD6MNHONHQ2IkvSkitXhkxA&oe=69D51072"}, "display_name": "Wingit", "keywords": [], "long_description": "Unleash Your Inner Bird in Aerial Dogfights and Races.\n\nEver dreamed of soaring through the skies as a majestic bird, engaging in thrilling air-to-air challenges, or participating in high-speed tag races?\n\nWe\u2019ve been developing a unique bird flapping and gliding mechanic that brings this experience to life in our upcoming multiplayer game, currently dubbed \u201cWingit\u201d.\n\nWe\u2019ve created a basic block-out map and implemented an infection game mode for testing purposes. However, we\u2019re eager to explore more game modes and perfect the overall experience.\n\nDepending on how you choose to fly, this game can be quite a lot of exercise :)\n\nWatch the attached video for a glimpse into the heart-pounding action and join our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN", "short_description": "Flap, glide, swoop, dip and flap to soar like a bird. Hang out with your friends or play a game of Tag, Hunt or make it up as you go."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Remio", "support_website_url": null, "website_url": "https://remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "sup
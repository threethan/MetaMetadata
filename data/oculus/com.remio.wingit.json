97781816389", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982584_926297785149722_4227410942138075850_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vSRP3eLMSHEQ7kNvwHNYS8q&_nc_oc=AdlxeTqp116OtLxlcASajH3fTu2nSSHv-Wofnj8167-6PZ2vmxN6cYpNFA3gjGugky0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyG3JRogrUV4cone1b8isu3RmqT_PTROhPcBFQlBEEr4g&oe=69BE9D26"}, {"file_name": "5.png", "id": "673317157978047", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001732_673317161311380_6367319820395155286_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1SC7ntdJfmwQ7kNvwGjDkoC&_nc_oc=AdloGlKeuRqC07UPG9RsKpwTXPI5s7UjUvwTTT0QQ_p0bEJu2x3L8HQkw27sirVPNOA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyBsq4YBjk6z3qswVCyq18lrb_mNumJ5WKGEuZ168QpdQ&oe=69BE9E73"}, {"file_name": "Screenshot (447).png", "id": "628875279216230", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566698_628875282549563_4913645439909033743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GzzhD0hUlDEQ7kNvwH0XgQp&_nc_oc=AdlnSjnXd4qIyKRaHhlvRd3HWOY33tdiJC5t_nHBsajZE3LjXAHk4Scsg0gKtKfMppM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afyxo1ZM9kyUt-T4itwCA6rOP89tKFhjJTY84y4UDLTgtg&oe=69BE90DB"}, {"file_name": "3.png", "id": "3187958854840290", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974513_3187958858173623_2630061441027911886_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l9xGHPyHIeIQ7kNvwGv4rcg&_nc_oc=AdlQazD_rSiO1LSFvlKXocSWtB6RrrIK0N6cCF2UbLyRc6n5SiyZKvoBqoRjOi1hmog&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzXR1lXtlU5jL8Fc1Jq8NKUdaZ9mPC10if_TlPudz-uDA&oe=69BEA80F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (4).png", "id": "941214970482404", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031643_941214973815737_2432176783600565336_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vRs7Bzae3CAQ7kNvwFChrCH&_nc_oc=Adkh2XaoV6jbVxKHdXAoiFkkHRplzmfsv7NqreuU5h8Ui-ObeNkOliSCKpnQfaPLWqc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afwv2gz53f1Ex5p2rVYmLRYoWhvEVA_Ys02jSyHj-nwzmg&oe=69BEA6F2"}, "display_name": "Wingit", "keywords": [], "long_description": "Unleash Your Inner Bird in Aerial Dogfights and Races.\n\nEver dreamed of soaring through the skies as a majestic bird, engaging in thrilling air-to-air challenges, or participating in high-speed tag races?\n\nWe\u2019ve been developing a unique bird flapping and gliding mechanic that brings this experience to life in our upcoming multiplayer game, currently dubbed \u201cWingit\u201d.\n\nWe\u2019ve created a basic block-out map and implemented an infection game mode for testing purposes. However, we\u2019re eager to explore more game modes and perfect the overall experience.\n\nDepending on how you choose to fly, this game can be quite a lot of exercise :)\n\nWatch the attached video for a glimpse into the heart-pounding action and join our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN", "short_description": "Flap, glide, swoop, dip and flap to soar like a bird. Hang out with your friends or play a game of Tag, Hunt or make it up as you go."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Remio", "support_website_url": null, "website_url": "https://remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_d
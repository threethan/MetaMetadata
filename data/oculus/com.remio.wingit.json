ingit_Render_1.png", "id": "926297781816389", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982584_926297785149722_4227410942138075850_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G45ifsuCICIQ7kNvwFc_eEX&_nc_oc=Adpc3sztF30kATkGIedx3PTdSZ8cxRi6RRgvYe7F0V3wIsqYW3IVUQnQnsMqRaPDMmo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmxHUZz-glJNzYiS4quI6DnhgBBo4vLmyDKsE0DYs70g&oe=6A5639A6"}, {"file_name": "5.png", "id": "673317157978047", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39001732_673317161311380_6367319820395155286_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KJYL_MnrDEQQ7kNvwEcduQw&_nc_oc=AdpglBOv_xXf61j4Y1XPFjxw66-cPGBWZ7Y29ogTPuRlAmJzQ2TGoM8av5ZDzabveUk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBiEpfPxk4VF5IG3Inv2LzgWNa0y5PtF8UspUZ-wLu-gw&oe=6A563AF3"}, {"file_name": "Screenshot (447).png", "id": "628875279216230", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/57566698_628875282549563_4913645439909033743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CyyL275weUEQ7kNvwGX5M_0&_nc_oc=AdqkVSFnw3qBxfj4nSlUIueBkUY89R1WNeIcFqezZ8VitAowCGLW4bZ8snPW_sQWPnY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD3Nly18wc6cDXXDVNcjRq7LpuqXAveLW35xCp4lieZcg&oe=6A562D5B"}, {"file_name": "3.png", "id": "3187958854840290", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974513_3187958858173623_2630061441027911886_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J5gBGwPtwqcQ7kNvwHf3czH&_nc_oc=AdqSQ7HklnT4v3dt9w6n3qhvYr4jVNikyY-kyl2W750Usw-mXt-grfuGBMyEHZ0HiNw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBvZjYf0Pl6zCX6UtdlpSigYDzKIJEcR_z5UQz_TqmvPw&oe=6A56448F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (4).png", "id": "941214970482404", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031643_941214973815737_2432176783600565336_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WcB1kFjiSCEQ7kNvwFxKf2G&_nc_oc=AdpS8X-R5vMIh1IgPeXM0R6fP9CPHRf9Ui5P5IKJ4C3kOVIZhZXUMpPLULSFZG-eZSk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA65JVs1R3TOGVb8aKgtkg2V74FlCz6csnz74txqOWMjg&oe=6A564372"}, "display_name": "Wingit", "keywords": [], "long_description": "Unleash Your Inner Bird in Aerial Dogfights and Races.\n\nEver dreamed of soaring through the skies as a majestic bird, engaging in thrilling air-to-air challenges, or participating in high-speed tag races?\n\nWe\u2019ve been developing a unique bird flapping and gliding mechanic that brings this experience to life in our upcoming multiplayer game, currently dubbed \u201cWingit\u201d.\n\nWe\u2019ve created a basic block-out map and implemented an infection game mode for testing purposes. However, we\u2019re eager to explore more game modes and perfect the overall experience.\n\nDepending on how you choose to fly, this game can be quite a lot of exercise :)\n\nWatch the attached video for a glimpse into the heart-pounding action and join our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN", "short_description": "Flap, glide, swoop, dip and flap to soar like a bird. Hang out with your friends or play a game of Tag, Hunt or make it up as you go."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Remio", "support_website_url": null, "website_url": "https://remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "sup
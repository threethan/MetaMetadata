ingit_Render_1.png", "id": "926297781816389", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982584_926297785149722_4227410942138075850_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yuqAJ2xzQjsQ7kNvwGsJw3T&_nc_oc=AdpDdBnbsznQy31nuZk9wjEfJFjLRNsgyVdt7ynpiwtJsxM4T9bVyAS-scUV364sblQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEzUmlIt0d9-E92eTwojj3WY2ZPXjd88CSYm3y13tKOhg&oe=6A81BB26"}, {"file_name": "5.png", "id": "673317157978047", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39001732_673317161311380_6367319820395155286_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DgUcHvhA2KkQ7kNvwEAvZE3&_nc_oc=Adr8XigsO3NPpPO8Jv4mLOXWWIUQI1AGK4JMPqTP8MCYdB1TWeFuYySJYK0mTzNqV6o&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6fC2c5q1TgKsXog27J-8M9h4P_5ZwTPItRGw4rSycDQ&oe=6A81BC73"}, {"file_name": "Screenshot (447).png", "id": "628875279216230", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/57566698_628875282549563_4913645439909033743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-4896FHKjTUQ7kNvwE0niaq&_nc_oc=AdqKZiFGu_YfmCo8ZtqETzbv3DgXp5z-XHhQX3eBGkoamFkpv-xkQNwP08ptG6VvHA4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGki_TuJ4SXRtFZE0PTXuWyn-o4D0o30k9Z60k0arLTNQ&oe=6A81AEDB"}, {"file_name": "3.png", "id": "3187958854840290", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974513_3187958858173623_2630061441027911886_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZT4bEY7MnBYQ7kNvwG1De8E&_nc_oc=AdrX33MxP5qj-ccvJpzNk40g6rUKpwNAs0c37G2sUxO8wX5EN78Fi_RRgNR2y0_BSjM&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLqn9lPxPx9oKGdCZLhrMQtjpAIxuaza0zQmg6e28xEw&oe=6A81C60F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (4).png", "id": "941214970482404", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031643_941214973815737_2432176783600565336_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SwKTgzOrgGwQ7kNvwESzBVk&_nc_oc=Adoga-ZmBWeYY9YK1vWaHnv0QSGPMnYzB3DJ7PCmDPbOvHeNy0gzoVFju5y9gfT1Dec&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGpV8q1ozlSyt8cLkcN8uYX8da1dF4iE7qxHP7JvGXuyQ&oe=6A81C4F2"}, "display_name": "Wingit", "keywords": [], "long_description": "Unleash Your Inner Bird in Aerial Dogfights and Races.\n\nEver dreamed of soaring through the skies as a majestic bird, engaging in thrilling air-to-air challenges, or participating in high-speed tag races?\n\nWe\u2019ve been developing a unique bird flapping and gliding mechanic that brings this experience to life in our upcoming multiplayer game, currently dubbed \u201cWingit\u201d.\n\nWe\u2019ve created a basic block-out map and implemented an infection game mode for testing purposes. However, we\u2019re eager to explore more game modes and perfect the overall experience.\n\nDepending on how you choose to fly, this game can be quite a lot of exercise :)\n\nWatch the attached video for a glimpse into the heart-pounding action and join our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN", "short_description": "Flap, glide, swoop, dip and flap to soar like a bird. Hang out with your friends or play a game of Tag, Hunt or make it up as you go."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Remio", "support_website_url": null, "website_url": "https://remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "sup
97781816389", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982584_926297785149722_4227410942138075850_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-5uE5cBgLYUQ7kNvwHMIcXf&_nc_oc=AdnxqIJ0sbTcpstVJMpM-dVf-u20WLBzOCb1kjTdw9bCc5oBuAtlOWuP56-WmZaXi4k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwjhHIm4wkHAd0fv8jsiX-mLZ0GKXt21eRcWydCdsD-bg&oe=69AECB26"}, {"file_name": "5.png", "id": "673317157978047", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001732_673317161311380_6367319820395155286_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vayl5DjOx0IQ7kNvwHmZaT3&_nc_oc=AdmgI0_V7qs6Bfq0qdNA72wr058x6VDtl-1ZcZDBybsUHVE7tbXMFH-VrS7s79s-cCQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy_W9xvJNP_zBG3coPJovJMK4Qkfqo68_boCbhjB-xDMQ&oe=69AECC73"}, {"file_name": "Screenshot (447).png", "id": "628875279216230", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57566698_628875282549563_4913645439909033743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cpPGTINeIGQQ7kNvwH_D6ZI&_nc_oc=AdnxouKO3vZAg_JzAWzAeBYTqsWW9deWKOwCeMH53tkJpRWd8aADuAg7QuIutRtuHhM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx-k-MfZlhDrxNdVV_bNHeIG8-WMr36cCm2FgA69ZHtwg&oe=69AEBEDB"}, {"file_name": "3.png", "id": "3187958854840290", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974513_3187958858173623_2630061441027911886_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fCD5dmuVLdgQ7kNvwFjKKCX&_nc_oc=AdmQkQzEiNf294Si9Kj-heQCYotgVuNnZPI6KIWcVaCb75OgekuMNFSLt4nBEMWcnOE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy4pt7alkPeKMywQrV-qNneTY-q54npPnXEpGZjnEuaCw&oe=69AED60F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (4).png", "id": "941214970482404", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031643_941214973815737_2432176783600565336_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hVjW9dmg-zgQ7kNvwE3WtLi&_nc_oc=AdmXi_Aq56cmvTZeAc2VKsA0uhLSY35lZJcME1L_rNZPDjblnoe0j7iz3CWhGGBtf8I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyQeE00tBjiL2ccnX_tm3-o6AcU9wI-wq8EcDgEBUZM_w&oe=69AED4F2"}, "display_name": "Wingit", "keywords": [], "long_description": "Unleash Your Inner Bird in Aerial Dogfights and Races.\n\nEver dreamed of soaring through the skies as a majestic bird, engaging in thrilling air-to-air challenges, or participating in high-speed tag races?\n\nWe\u2019ve been developing a unique bird flapping and gliding mechanic that brings this experience to life in our upcoming multiplayer game, currently dubbed \u201cWingit\u201d.\n\nWe\u2019ve created a basic block-out map and implemented an infection game mode for testing purposes. However, we\u2019re eager to explore more game modes and perfect the overall experience.\n\nDepending on how you choose to fly, this game can be quite a lot of exercise :)\n\nWatch the attached video for a glimpse into the heart-pounding action and join our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN", "short_description": "Flap, glide, swoop, dip and flap to soar like a bird. Hang out with your friends or play a game of Tag, Hunt or make it up as you go."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Remio", "support_website_url": null, "website_url": "https://remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_d
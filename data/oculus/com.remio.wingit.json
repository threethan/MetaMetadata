97781816389", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982584_926297785149722_4227410942138075850_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-5uE5cBgLYUQ7kNvwFF9YmR&_nc_oc=AdlDKA7RvTcFxO7Xi1J4XShjezNYtAGJx5fmi-nsm02bFIU26-0TNW-YHcHKL64Y-Jw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx3jUuEXJMIBHgVxdlPdwo492Et5xYFiqZSl40JrUQYDQ&oe=69AC2826"}, {"file_name": "5.png", "id": "673317157978047", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001732_673317161311380_6367319820395155286_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vayl5DjOx0IQ7kNvwEMe0gl&_nc_oc=Admedc0qd4nCzYt_W9bOBn0PZp7sgXAWN40YZMOw4rJbv-YHnADI7zuTL7VwcFRme9o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afznt94g1JIiOXbvPLbCJywWjGuuYov9h3fqG6HKqsprfw&oe=69AC2973"}, {"file_name": "Screenshot (447).png", "id": "628875279216230", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57566698_628875282549563_4913645439909033743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cpPGTINeIGQQ7kNvwG2OE3w&_nc_oc=Adlu-Lg_R3z2v5KKqAJMT6x49XVQ5Lbfs3sxU1nGQRoai7FBRaMYU-azj1w69mE2DY8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyVq6fev0i87hFoKuzCE_C4g-7nBAQAkg5K31pMxd06Bg&oe=69AC1BDB"}, {"file_name": "3.png", "id": "3187958854840290", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974513_3187958858173623_2630061441027911886_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1fLh6kbIZcQQ7kNvwEQdy_d&_nc_oc=Adk6qSOOc_QFPtW4M_ur7CJkVAkh2ygMkbmgwR5QK-QAGwm1KVIYZJRsdZTWzHr3HbI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afyjc5MWWZnmbHJoHHj7Ts3jGbbFllKTLaOfmdbWyKTEVg&oe=69AC330F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (4).png", "id": "941214970482404", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031643_941214973815737_2432176783600565336_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jUu5BqgtNLEQ7kNvwFjYU34&_nc_oc=Admr4Ql_bXFZlU1bnF1Lt-LFyKE43LiDA2M7uCSmupTB1gnKH_VcOj3lU23ezAcyQJ8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxhvONr5y5aPQnGqosA1rZ7aXrNJ1GsWt6hEZo7lkE72A&oe=69AC31F2"}, "display_name": "Wingit", "keywords": [], "long_description": "Unleash Your Inner Bird in Aerial Dogfights and Races.\n\nEver dreamed of soaring through the skies as a majestic bird, engaging in thrilling air-to-air challenges, or participating in high-speed tag races?\n\nWe\u2019ve been developing a unique bird flapping and gliding mechanic that brings this experience to life in our upcoming multiplayer game, currently dubbed \u201cWingit\u201d.\n\nWe\u2019ve created a basic block-out map and implemented an infection game mode for testing purposes. However, we\u2019re eager to explore more game modes and perfect the overall experience.\n\nDepending on how you choose to fly, this game can be quite a lot of exercise :)\n\nWatch the attached video for a glimpse into the heart-pounding action and join our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN", "short_description": "Flap, glide, swoop, dip and flap to soar like a bird. Hang out with your friends or play a game of Tag, Hunt or make it up as you go."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Remio", "support_website_url": null, "website_url": "https://remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_d
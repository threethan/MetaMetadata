ingit_Render_1.png", "id": "926297781816389", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982584_926297785149722_4227410942138075850_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KV1agGdqpHAQ7kNvwFjiTiN&_nc_oc=Ado8KzgXSQ8WczrWfpYqgWTMgWpMGIhq_ILeHQlTbTvM4aspc7BolRj3R95fd3YKbpc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx_zkreUGxW-zta152UOtVGOp2pFEYp6Mjld0cOFkHOSA&oe=69C7D7A6"}, {"file_name": "5.png", "id": "673317157978047", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39001732_673317161311380_6367319820395155286_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rAEvHmImBbAQ7kNvwHOmnbY&_nc_oc=AdroWuGxuMgu7Xm0sNFgVaIyhytONTXS43uaDN1CvbIRhoPxUBGjoHx9ttZMRVnbxvg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy5w6I1NedioyF3C1mFsOJHJPPpff-hKCOcjuOE1TsfpQ&oe=69C7D8F3"}, {"file_name": "Screenshot (447).png", "id": "628875279216230", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/57566698_628875282549563_4913645439909033743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=40Bn5aLeElYQ7kNvwEI-N0o&_nc_oc=Adr3HTo-S4xIotlg5JGlnrRuHtd0q3IKl_mOKLPagwigBPXBM7Gx38upP4ebnLdn8A8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw40Ck5jelAna2XInOlGB9fb3vChfNdFhSAhSx4dZ5qtQ&oe=69C7CB5B"}, {"file_name": "3.png", "id": "3187958854840290", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974513_3187958858173623_2630061441027911886_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UCjPRI2jx-4Q7kNvwE5hLbQ&_nc_oc=AdojWHAi2b2RJD2MShgNn4eaGwzDMpXBD1f5kOOuXiodAR2P-Idb5BWq4vebsLVNfMs&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz6Ym7wCndrF7tsigfT6QqpISrcacyhAaaUek9cHsD-lQ&oe=69C7E28F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (4).png", "id": "941214970482404", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031643_941214973815737_2432176783600565336_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9lrumtgwtjAQ7kNvwHCg1zT&_nc_oc=AdqtzfJgOvO0X7GBWh_TCIaXNIV4VZSgEupnaQ-fcVqtYh-WUADd6JoFhBJf8dE4MyY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyaZZZxrKj8NyUZE9T0OStYomTJroiuJ4eMb1gK_AQKgg&oe=69C7E172"}, "display_name": "Wingit", "keywords": [], "long_description": "Unleash Your Inner Bird in Aerial Dogfights and Races.\n\nEver dreamed of soaring through the skies as a majestic bird, engaging in thrilling air-to-air challenges, or participating in high-speed tag races?\n\nWe\u2019ve been developing a unique bird flapping and gliding mechanic that brings this experience to life in our upcoming multiplayer game, currently dubbed \u201cWingit\u201d.\n\nWe\u2019ve created a basic block-out map and implemented an infection game mode for testing purposes. However, we\u2019re eager to explore more game modes and perfect the overall experience.\n\nDepending on how you choose to fly, this game can be quite a lot of exercise :)\n\nWatch the attached video for a glimpse into the heart-pounding action and join our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN", "short_description": "Flap, glide, swoop, dip and flap to soar like a bird. Hang out with your friends or play a game of Tag, Hunt or make it up as you go."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Remio", "support_website_url": null, "website_url": "https://remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "sup
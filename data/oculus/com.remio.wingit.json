ingit_Render_1.png", "id": "926297781816389", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982584_926297785149722_4227410942138075850_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ebq33NO-xmEQ7kNvwENXRPg&_nc_oc=AdpqGPqz_0w8CR0n50Vsmt8AxFAA0RR6Jardpj2Et3PCkk77BB82YfIEBkCNLsUGLrg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-8dLBFzyN3OMi7CHYARfzMs9pdXciUQFoLhSyB42jMjQ&oe=6A26C3A6"}, {"file_name": "5.png", "id": "673317157978047", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001732_673317161311380_6367319820395155286_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tURHzbjwqqEQ7kNvwFzmjkf&_nc_oc=Adri-3Wa-F-ux2N-eqZH6f-90RPGqBK78SE_tFObR30lcmvHn6UUnzUm3T0XAebXhH4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UGAHBE26i3Jn9SNBQ9snP9_Now4mRrWTf0JM6HXaqMQ&oe=6A26C4F3"}, {"file_name": "Screenshot (447).png", "id": "628875279216230", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57566698_628875282549563_4913645439909033743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kunIr9R-XvIQ7kNvwEeXS3q&_nc_oc=AdrJyrymut4a9T9mWEdjq6GhHOA5bGSXJwnGoeOHTpIzx6dRxes5lDCWoSM8wC1K4ro&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af867Gn286H88rSxAKHrO33vtkcWamdnlecL8bR_ivzcnw&oe=6A26EF9B"}, {"file_name": "3.png", "id": "3187958854840290", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974513_3187958858173623_2630061441027911886_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1JH_gPjohGUQ7kNvwFUQ_NH&_nc_oc=Adq4Po5c8fCMn0yRb2AyXKd6EonE7NkjcPDDEbh82V4uy5PG9ErF-s-qaad1BstgmLE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-90d8i9270GaLtZjGw_0G_-lSE9aIzegTAB2i67NuE2A&oe=6A26CE8F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (4).png", "id": "941214970482404", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031643_941214973815737_2432176783600565336_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_gpzQ_l6RwAQ7kNvwEdaYTn&_nc_oc=AdqgEx46CvLYbuxQugTWsM2OmOZzEYNC-4cn1Tgs-v3v3RIUbE1FVtY6GiqV5GrjmhY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9xO6cyvv9pgCVKd8VqEca79hV1DYOdh5aoIfvTfJrpKw&oe=6A26CD72"}, "display_name": "Wingit", "keywords": [], "long_description": "Unleash Your Inner Bird in Aerial Dogfights and Races.\n\nEver dreamed of soaring through the skies as a majestic bird, engaging in thrilling air-to-air challenges, or participating in high-speed tag races?\n\nWe\u2019ve been developing a unique bird flapping and gliding mechanic that brings this experience to life in our upcoming multiplayer game, currently dubbed \u201cWingit\u201d.\n\nWe\u2019ve created a basic block-out map and implemented an infection game mode for testing purposes. However, we\u2019re eager to explore more game modes and perfect the overall experience.\n\nDepending on how you choose to fly, this game can be quite a lot of exercise :)\n\nWatch the attached video for a glimpse into the heart-pounding action and join our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN", "short_description": "Flap, glide, swoop, dip and flap to soar like a bird. Hang out with your friends or play a game of Tag, Hunt or make it up as you go."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Remio", "support_website_url": null, "website_url": "https://remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "sup
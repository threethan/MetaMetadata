ingit_Render_1.png", "id": "926297781816389", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982584_926297785149722_4227410942138075850_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2PaddHqLaKsQ7kNvwGSmwN-&_nc_oc=AdpPQMVbkot4-dCrG5e0vI3XQa18sJ7X9Ztnvm8ciKiarGWeR8VN6uwSC1kkxKK9F3I&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4cCGq3vSFmt9GooqcTACKt7-zHZKkq3RYbFkXNfcMg8g&oe=69FDE526"}, {"file_name": "5.png", "id": "673317157978047", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001732_673317161311380_6367319820395155286_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v9ilaclPvCAQ7kNvwHQUCY_&_nc_oc=AdqK-siiV5lEIuVB_YzxWuZXAmB6sAzHc-YPzwec5FlomDh3iOrIGThtuz9ACU8hrL4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4I5SrZub2edMRR9UCuBHg0h9dI3eMVN4F1IbOeAZurMw&oe=69FDE673"}, {"file_name": "Screenshot (447).png", "id": "628875279216230", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57566698_628875282549563_4913645439909033743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sum2b0x9Kr4Q7kNvwHEaLjc&_nc_oc=AdrnhcgmLRCrlH5at38b5jafAMtIyXdDw2koyIRHXE4m8gwrXHz1ODtRMK2hFrNvCV4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4UQRfjJhBfQQkSzARhnMtqEy_5BgJhrQD7opJZ-cy4_w&oe=69FDD8DB"}, {"file_name": "3.png", "id": "3187958854840290", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974513_3187958858173623_2630061441027911886_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dFDQJY8HGm0Q7kNvwFle6Ik&_nc_oc=Adpoab0dLYcYW7NbP-IfcndKm4JiIYkcJrtWYKfbdZDsJPgjUZ3QkdFb96Y_huab1W4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Xharm3Q4Mcn8XcjKMTXYcFEvlsnBLvk9ZEjBcDchR8Q&oe=69FDF00F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (4).png", "id": "941214970482404", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031643_941214973815737_2432176783600565336_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xpnFYONKqi4Q7kNvwG9BKmT&_nc_oc=AdpwU3b-hWE67XpiS-PSifMtcX4phfhDZ6X3_R-ANxrcFUCTFFue-uVAWpw8yn4qvgQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4J_eHeFpzxPfFsUxUM0jZC8D7srlN4gMC6Lisj16cMIg&oe=69FDEEF2"}, "display_name": "Wingit", "keywords": [], "long_description": "Unleash Your Inner Bird in Aerial Dogfights and Races.\n\nEver dreamed of soaring through the skies as a majestic bird, engaging in thrilling air-to-air challenges, or participating in high-speed tag races?\n\nWe\u2019ve been developing a unique bird flapping and gliding mechanic that brings this experience to life in our upcoming multiplayer game, currently dubbed \u201cWingit\u201d.\n\nWe\u2019ve created a basic block-out map and implemented an infection game mode for testing purposes. However, we\u2019re eager to explore more game modes and perfect the overall experience.\n\nDepending on how you choose to fly, this game can be quite a lot of exercise :)\n\nWatch the attached video for a glimpse into the heart-pounding action and join our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN", "short_description": "Flap, glide, swoop, dip and flap to soar like a bird. Hang out with your friends or play a game of Tag, Hunt or make it up as you go."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Remio", "support_website_url": null, "website_url": "https://remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "sup
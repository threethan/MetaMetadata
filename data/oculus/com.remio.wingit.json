ingit_Render_1.png", "id": "926297781816389", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982584_926297785149722_4227410942138075850_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0YKe6kifsfwQ7kNvwG3oZNy&_nc_oc=AdoIOetoe_LenQbh-gqB0ncbsItzwy5IUHovs_JtItEMLIReWabWuXiI-7RSpotojPE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKyiz4kkJsw_TNYIip6ivR7C-lD_aB-LW_RYMDD8rsUEQ&oe=6AB3D426"}, {"file_name": "5.png", "id": "673317157978047", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001732_673317161311380_6367319820395155286_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z9NDZt4NWPoQ7kNvwGdZ0VW&_nc_oc=Adr4ieFX-B-QJfOZ5sWnvyVhki3EwAIzYJDW7dT5soUQV8mZ32y9h1rNGsAHXxZ2ezY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfbO0pS9gRKVWEfm32Ft493O8XCrUHaa35O1i3GKn-dg&oe=6AB3D573"}, {"file_name": "Screenshot (447).png", "id": "628875279216230", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566698_628875282549563_4913645439909033743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hg_BCUnYxKUQ7kNvwGIoB1e&_nc_oc=Adp0-TC4btC0Bb91DDc1iYpKJkK8iCojirFfIjoQqFK8l816CoceilFnuWxl5GmrzwA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzPRemWi8Zg648ytFpkjMNHfTyAq6_2oPtZGgJwffu_A&oe=6AB3C7DB"}, {"file_name": "3.png", "id": "3187958854840290", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974513_3187958858173623_2630061441027911886_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5GU5a_tk3gAQ7kNvwHgtMWE&_nc_oc=AdoltLSEg9NOp93pobJJPJH5WWN7t3N-a1-bA3hu3tP2LYQSxlkBNMNd7RMXaTkK-CA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIf8e43gSaG3HkoOmfOFcKLiuqj2FYh_TxfwC5BwS4InA&oe=6AB3DF0F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (4).png", "id": "941214970482404", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031643_941214973815737_2432176783600565336_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mGUzHVa67j4Q7kNvwHME2jr&_nc_oc=AdofRXGVSWfbStAoqBUr92gBv7wKLSpivVmmqhmnoYRc2U3Kb-5RShEst9atl4-dq3M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvJQri9NkGbtNDNFsZ4A3jRCNYOiNmYA6QJ-N8yqgyxQ&oe=6AB3DDF2"}, "display_name": "Wingit", "keywords": [], "long_description": "Unleash Your Inner Bird in Aerial Dogfights and Races.\n\nEver dreamed of soaring through the skies as a majestic bird, engaging in thrilling air-to-air challenges, or participating in high-speed tag races?\n\nWe\u2019ve been developing a unique bird flapping and gliding mechanic that brings this experience to life in our upcoming multiplayer game, currently dubbed \u201cWingit\u201d.\n\nWe\u2019ve created a basic block-out map and implemented an infection game mode for testing purposes. However, we\u2019re eager to explore more game modes and perfect the overall experience.\n\nDepending on how you choose to fly, this game can be quite a lot of exercise :)\n\nWatch the attached video for a glimpse into the heart-pounding action and join our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN", "short_description": "Flap, glide, swoop, dip and flap to soar like a bird. Hang out with your friends or play a game of Tag, Hunt or make it up as you go."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Remio", "support_website_url": null, "website_url": "https://remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "sup
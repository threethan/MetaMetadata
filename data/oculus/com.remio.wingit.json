97781816389", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982584_926297785149722_4227410942138075850_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vSRP3eLMSHEQ7kNvwElexdA&_nc_oc=AdmeAFaE2f81hrWazl_yWM041SyVa5VOa-cEfbu9xHNdC9CKIcirNMJMVUKoBfI0CP0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyOsFnNgIUESF6j7ArOo2Euh3_j2n6B7D10kAcykjoLfw&oe=69BD4BA6"}, {"file_name": "5.png", "id": "673317157978047", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001732_673317161311380_6367319820395155286_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1SC7ntdJfmwQ7kNvwH9r90t&_nc_oc=AdndTieF_-mYxOQqmDcTwMYxw8DrpiIK5J6p37fczpd810iZZ-8Qf3y3u0yJlN29Np0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afz4AeagJnTIIzeayt2-l_rTU0CvZj3US31quE3CULOXYg&oe=69BD4CF3"}, {"file_name": "Screenshot (447).png", "id": "628875279216230", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57566698_628875282549563_4913645439909033743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GzzhD0hUlDEQ7kNvwEyEZIU&_nc_oc=AdlNJTkuj4W0zSRF-q073PhjugwjAWiNd7w_5VmlmjY2wCB1l87ebUUCXaZH-9zT1QA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzDsMTA0i1hIFybutunZC24tRskbdIzRonacvSy3x_XkQ&oe=69BD3F5B"}, {"file_name": "3.png", "id": "3187958854840290", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974513_3187958858173623_2630061441027911886_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hNMuFrUlGL8Q7kNvwHdCcnK&_nc_oc=AdnROZDtN7-ts8Fk6esg-ZTPbK99KGPd9-Gy_71E1hL-F9KjFusbzxY5vor5bKWadIA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxGxIq41i7Mc0AQ0a-eNj4azl4gX01ZX9EmaWVM14FWpQ&oe=69BD568F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (4).png", "id": "941214970482404", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031643_941214973815737_2432176783600565336_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eh8Hd-ZFzwIQ7kNvwHkwauw&_nc_oc=Adko1krkjunyfQliPXVkL7QxsOn3TLLHy2q8tG6buHNR1i8ueAPZ4L4F9NHCAGxC9oI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzfcSXl8xg7o2PlCKWq-rOUIPAOlylttcCn3IVCyoWjmg&oe=69BD5572"}, "display_name": "Wingit", "keywords": [], "long_description": "Unleash Your Inner Bird in Aerial Dogfights and Races.\n\nEver dreamed of soaring through the skies as a majestic bird, engaging in thrilling air-to-air challenges, or participating in high-speed tag races?\n\nWe\u2019ve been developing a unique bird flapping and gliding mechanic that brings this experience to life in our upcoming multiplayer game, currently dubbed \u201cWingit\u201d.\n\nWe\u2019ve created a basic block-out map and implemented an infection game mode for testing purposes. However, we\u2019re eager to explore more game modes and perfect the overall experience.\n\nDepending on how you choose to fly, this game can be quite a lot of exercise :)\n\nWatch the attached video for a glimpse into the heart-pounding action and join our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN", "short_description": "Flap, glide, swoop, dip and flap to soar like a bird. Hang out with your friends or play a game of Tag, Hunt or make it up as you go."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Remio", "support_website_url": null, "website_url": "https://remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_d
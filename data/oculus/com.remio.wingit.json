ingit_Render_1.png", "id": "926297781816389", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982584_926297785149722_4227410942138075850_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_qgi9zU2osUQ7kNvwHymw53&_nc_oc=AdrksNpxgguhff6swELg9lLUMNS8MJYVR1POjXx9slgpu4rSO-RXW5jKYNFzkr1uqfM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af17okA5E-1IPQgazcs_bnSER4MJwi1wJt2qyMYomuDatw&oe=69D3B526"}, {"file_name": "5.png", "id": "673317157978047", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001732_673317161311380_6367319820395155286_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MqWsQXT012YQ7kNvwEn2Mwb&_nc_oc=Adog9pLe173uJDB_rWLb9LaKs8Q6_m8ZlrLKpTGObLFT50Oqfbym_LFcvUf2Xz_1krk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2WKsw_Yti-wr12C6-8pVbN93dcV_t6ol87RVvdtE8hpw&oe=69D3B673"}, {"file_name": "Screenshot (447).png", "id": "628875279216230", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57566698_628875282549563_4913645439909033743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E8tvjqp8jAsQ7kNvwHlLMXA&_nc_oc=AdoT-iNBI62bhE7HtG0rA5r_qmJU1Ffn_0zoqs4ia-T9s_6v3vSGnV9cTmMFXeRCXCs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Am8R-vojC_mOiPrvV0nnvTromHJeT-Ilurd4W3l3T-w&oe=69D3A8DB"}, {"file_name": "3.png", "id": "3187958854840290", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974513_3187958858173623_2630061441027911886_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ID_MjyjRLYQ7kNvwGhSt36&_nc_oc=Adr0kQVHgeYQV4ykBzXZp451gHfL_hczY3hXLj9wtUlRvUEQnG2zPZTiGnmXXfkQgaA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0uYUQ1o7G0iF_LGcEUBLJriz937ec4ZHO12QahdoNaFQ&oe=69D3C00F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (4).png", "id": "941214970482404", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031643_941214973815737_2432176783600565336_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MJTwZ4LGDYoQ7kNvwHK1-AX&_nc_oc=Adrx7wFbmNrSke0jAG0xL1qyYOWvKL-RscFBTjSYoAd9ud931304Ub4Zv5ttvwoDA10&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2XJqAncDuBkcMgavAbWBidfExKWLbud1nvlKh2BD76vw&oe=69D3BEF2"}, "display_name": "Wingit", "keywords": [], "long_description": "Unleash Your Inner Bird in Aerial Dogfights and Races.\n\nEver dreamed of soaring through the skies as a majestic bird, engaging in thrilling air-to-air challenges, or participating in high-speed tag races?\n\nWe\u2019ve been developing a unique bird flapping and gliding mechanic that brings this experience to life in our upcoming multiplayer game, currently dubbed \u201cWingit\u201d.\n\nWe\u2019ve created a basic block-out map and implemented an infection game mode for testing purposes. However, we\u2019re eager to explore more game modes and perfect the overall experience.\n\nDepending on how you choose to fly, this game can be quite a lot of exercise :)\n\nWatch the attached video for a glimpse into the heart-pounding action and join our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN", "short_description": "Flap, glide, swoop, dip and flap to soar like a bird. Hang out with your friends or play a game of Tag, Hunt or make it up as you go."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Remio", "support_website_url": null, "website_url": "https://remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "sup
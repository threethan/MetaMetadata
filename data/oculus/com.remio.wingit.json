ingit_Render_1.png", "id": "926297781816389", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982584_926297785149722_4227410942138075850_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NQwXT8XvSGoQ7kNvwGFPHip&_nc_oc=Adrq2s9VnFgoJ8vk2SeYLOcJLMpo2CA4ANrNsig9RjxXS7HfVUSRM-Ei1ehc2fmmL6c&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNlrFmjeSR4IfoGi9NQ-nLWRDWoz09UuDgml6baYwe-xA&oe=6AC79AA6"}, {"file_name": "5.png", "id": "673317157978047", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001732_673317161311380_6367319820395155286_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6DilBIsGCUIQ7kNvwHkDcY6&_nc_oc=AdppV6_ivKLuQ7Wtet-BUQLTLVW-bLmJafXBtPeItX17ZnF_lpU-hUgOscM7zqI_Pew&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN7Bx29poKgksNXba0-qF-lZ4l7ZKjgq6hi1jbQJPCHcg&oe=6AC79BF3"}, {"file_name": "Screenshot (447).png", "id": "628875279216230", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57566698_628875282549563_4913645439909033743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cD7ZY9k8iTAQ7kNvwEs8ULK&_nc_oc=Adoi4jzo0-LHEYTybIo_Gnk6yeKtPuDWDEGJ9prpXTP1Rs4pb-J073xseB-XAZF1abc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPSQvkg0EVjwn2uTa_z78vx8zhO9DJlaCB-Jfp_j9R-Ug&oe=6AC7C69B"}, {"file_name": "3.png", "id": "3187958854840290", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974513_3187958858173623_2630061441027911886_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AIcskuu6mT0Q7kNvwGPbJh1&_nc_oc=AdqRmdNCi-VYDQNb_HKVm_TdrP7C-Is31Zc7UurPO9q8lZJc4n8CAs0y8CZ-Gal23tw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN-RrbXxFq2cAZ-9Hdq6V66c98XQ7jiIrRiJKWTL6uYXQ&oe=6AC7A58F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (4).png", "id": "941214970482404", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031643_941214973815737_2432176783600565336_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KgfLyOHcNw8Q7kNvwGBPrKG&_nc_oc=AdqTvZsfHm--_pALpmAhPPLxSYTIU_5xV0N-4-QUJO8cTZJXeTXGmLz74ISGoOENKlk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNMDFe_GOMxSSmdWW3Rt0tdFoLoHUVkNOIBAAzdy5e5Xw&oe=6AC7A472"}, "display_name": "Wingit", "keywords": [], "long_description": "Unleash Your Inner Bird in Aerial Dogfights and Races.\n\nEver dreamed of soaring through the skies as a majestic bird, engaging in thrilling air-to-air challenges, or participating in high-speed tag races?\n\nWe\u2019ve been developing a unique bird flapping and gliding mechanic that brings this experience to life in our upcoming multiplayer game, currently dubbed \u201cWingit\u201d.\n\nWe\u2019ve created a basic block-out map and implemented an infection game mode for testing purposes. However, we\u2019re eager to explore more game modes and perfect the overall experience.\n\nDepending on how you choose to fly, this game can be quite a lot of exercise :)\n\nWatch the attached video for a glimpse into the heart-pounding action and join our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN", "short_description": "Flap, glide, swoop, dip and flap to soar like a bird. Hang out with your friends or play a game of Tag, Hunt or make it up as you go."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Remio", "support_website_url": null, "website_url": "https://remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "sup
ingit_Render_1.png", "id": "926297781816389", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982584_926297785149722_4227410942138075850_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nn5cWrTCKDgQ7kNvwHqpIqN&_nc_oc=AdrnOxgu7BHWR-EvegFgCZ79CmOJasQK5SGoKa-TRVti18V0EScVStKYAbMlOIKQ4rc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44K6K0TQiH8OViYbMfERdfeiow1yfmC-6jb0hg8Im_bQ&oe=6A1EDAA6"}, {"file_name": "5.png", "id": "673317157978047", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001732_673317161311380_6367319820395155286_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=98DaExJz8MIQ7kNvwFsGoC7&_nc_oc=AdqTnMkbpLSvaAv6GT0Jq7SvWxByPDF6jtZkrRfVFVQnHoARjU9wFo-o0KD6rJg8mnM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5b-BWYUGfUEAhV0cYeKEHf34eZ3KI-egzO9diFAbeOyQ&oe=6A1EDBF3"}, {"file_name": "Screenshot (447).png", "id": "628875279216230", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566698_628875282549563_4913645439909033743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J1-G3Bq6mWcQ7kNvwGUnLaq&_nc_oc=AdoaeuA7GyKdPukUM6g2aYAvT_oFHiYnwYmIx9yMkq2xOx5a9VW5Mxk0jSYi6puLPMI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4C9ygaRrnoVHzcLYMXJZSg0ECJQgPSRkbL6CU-IUxOjw&oe=6A1ECE5B"}, {"file_name": "3.png", "id": "3187958854840290", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974513_3187958858173623_2630061441027911886_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nMeyj9pPRzQQ7kNvwFFZ8kb&_nc_oc=AdrQAmtOptBmpePEqpYEHq0LLUR3TpOXqAYkQ9HzK1GKE_VLutNfmWmVfDJn6d6SZps&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7MgwmZ5i4V24oPVzNQs6uQcFSADmRhJ8MUmJlNwHjfQA&oe=6A1EE58F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (4).png", "id": "941214970482404", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031643_941214973815737_2432176783600565336_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_cldcIFXLEQQ7kNvwHlSNM-&_nc_oc=AdoZ2hxzjz0vVefCv4HcEfEXiPVT6N0JiCGjtIEE0xYjC76_A3cAGH4kBMFgSEvsHYU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4VgjgZvARlUcwNhvZzoRbl6p5eLfdZTcv7gesCr_GePA&oe=6A1EE472"}, "display_name": "Wingit", "keywords": [], "long_description": "Unleash Your Inner Bird in Aerial Dogfights and Races.\n\nEver dreamed of soaring through the skies as a majestic bird, engaging in thrilling air-to-air challenges, or participating in high-speed tag races?\n\nWe\u2019ve been developing a unique bird flapping and gliding mechanic that brings this experience to life in our upcoming multiplayer game, currently dubbed \u201cWingit\u201d.\n\nWe\u2019ve created a basic block-out map and implemented an infection game mode for testing purposes. However, we\u2019re eager to explore more game modes and perfect the overall experience.\n\nDepending on how you choose to fly, this game can be quite a lot of exercise :)\n\nWatch the attached video for a glimpse into the heart-pounding action and join our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN", "short_description": "Flap, glide, swoop, dip and flap to soar like a bird. Hang out with your friends or play a game of Tag, Hunt or make it up as you go."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Remio", "support_website_url": null, "website_url": "https://remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "sup
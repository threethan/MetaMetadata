ingit_Render_1.png", "id": "926297781816389", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982584_926297785149722_4227410942138075850_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zwBUP-ddazwQ7kNvwHf2RoA&_nc_oc=AdpLOg5-Ie-EloN8_JWJVGCUtgDYIqziSj8kGFf5NmVjILEfdFraSG4oLbJk_uUSZJY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6o8fARnJk3dutx7cKa5ODPyofvwWURewG7OZ_98svM2w&oe=6A047CA6"}, {"file_name": "5.png", "id": "673317157978047", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001732_673317161311380_6367319820395155286_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xwib1gD2TYwQ7kNvwGU0D2l&_nc_oc=AdrkoTnPP3baj8XRby1XGRmdUb7u95NDSPik9TKP1d7Z2omDCc71d6WcUx-Gfbb0w8U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4t69AObmdrI5Mi0IaM3I429NRoRWl1MRkjLfDK35aOyg&oe=6A047DF3"}, {"file_name": "Screenshot (447).png", "id": "628875279216230", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566698_628875282549563_4913645439909033743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zj-5pe7Al2oQ7kNvwEw-dvw&_nc_oc=Adpu3keJSczumuwyTtrv2Oy8EuvoG_-FTl57sGWxIM16xSdr7cBwDhuuKLlmzFT6D50&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5luRN5eum7-z5nAgEald7Bnb-XtcbRJ834G6UUm6C2XA&oe=6A04705B"}, {"file_name": "3.png", "id": "3187958854840290", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974513_3187958858173623_2630061441027911886_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xJDxlyrOmZIQ7kNvwFNxsD1&_nc_oc=AdqmrXX1c-H93G70O-_51LlxWuZ1xPWnDwkq-xf0xag4J5lZvESUjHvDYRbjevVdd9w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7YDNpiKTkLn461laPhf04AeDVmDBoyu8hV2KQT7CPhvg&oe=6A04878F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (4).png", "id": "941214970482404", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031643_941214973815737_2432176783600565336_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MuGoBoX_wfEQ7kNvwGjJrJz&_nc_oc=Ado9iG1I_fNXTaCwu9ScLFzL08CcMr4l7DwGybQUl_14-tO0anKHRPIGcuoI_fRaB6c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5PpkuSrk-gHj3AR_0bgDOLc4td9XbsUygoGVc0IYp1hQ&oe=6A048672"}, "display_name": "Wingit", "keywords": [], "long_description": "Unleash Your Inner Bird in Aerial Dogfights and Races.\n\nEver dreamed of soaring through the skies as a majestic bird, engaging in thrilling air-to-air challenges, or participating in high-speed tag races?\n\nWe\u2019ve been developing a unique bird flapping and gliding mechanic that brings this experience to life in our upcoming multiplayer game, currently dubbed \u201cWingit\u201d.\n\nWe\u2019ve created a basic block-out map and implemented an infection game mode for testing purposes. However, we\u2019re eager to explore more game modes and perfect the overall experience.\n\nDepending on how you choose to fly, this game can be quite a lot of exercise :)\n\nWatch the attached video for a glimpse into the heart-pounding action and join our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN", "short_description": "Flap, glide, swoop, dip and flap to soar like a bird. Hang out with your friends or play a game of Tag, Hunt or make it up as you go."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Remio", "support_website_url": null, "website_url": "https://remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "sup
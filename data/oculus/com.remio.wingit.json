ingit_Render_1.png", "id": "926297781816389", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982584_926297785149722_4227410942138075850_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZOoCvytB1koQ7kNvwGg2tcR&_nc_oc=Adp-6tP1uMdb9ZYC3hQB4UdcWfFqXX_S7J1Iln0fmM1rAHT9uTlNM3iePoDIgEU5Tq4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0hQtdnqV0xWdFDUZcUprr8XSDzDgh1osGSRIYz7_nXXQ&oe=69F5FC26"}, {"file_name": "5.png", "id": "673317157978047", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39001732_673317161311380_6367319820395155286_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dAmEC4bsszoQ7kNvwFku4Y2&_nc_oc=AdqPNeCgn3Lg50i3p6uAiNG78YbALzVTkXCj0hbkGluFK4MU_RBxqfUT6zok4sLwH4g&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1Y5GkDaINLcuoSOz3OFAgO4BMtps2JoaR-uLLeSV3NTg&oe=69F5FD73"}, {"file_name": "Screenshot (447).png", "id": "628875279216230", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/57566698_628875282549563_4913645439909033743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WfYK8PtbuxAQ7kNvwGJ8v0_&_nc_oc=AdrBVibS7g0wXbFTpsZGTS4W4IOyLeexd6H15cLcxrONgwtonsJFLISjn01UlyC4cO0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2d5LJEAkxP3bcM9qQ0ETXyZpcU64kBdOBx4R1wqUeokQ&oe=69F5EFDB"}, {"file_name": "3.png", "id": "3187958854840290", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974513_3187958858173623_2630061441027911886_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rrWM59lHZm4Q7kNvwHlLCxS&_nc_oc=AdptoznICtmrceVrU0D0vxZOLRKf9edg293vNMuBRgPFqX-Wu8fV1Z46clzK82PPLmo&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3qm0jKmqBocO_mPr12pJ1oRXT72SkS5ZQMlbZb4Rr3Ug&oe=69F6070F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (4).png", "id": "941214970482404", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031643_941214973815737_2432176783600565336_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=piblimdXEIYQ7kNvwGDj39s&_nc_oc=AdpcJ_Se3zGw78Ye48vytFFRxv-Djw1CFXFje_VdHHVpqyBHFUbb-qBzk1WQ36v4bTU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1F8X2M0wu0a0-TosV-z3z64boF-BMKpWXJZS72I_eRWw&oe=69F605F2"}, "display_name": "Wingit", "keywords": [], "long_description": "Unleash Your Inner Bird in Aerial Dogfights and Races.\n\nEver dreamed of soaring through the skies as a majestic bird, engaging in thrilling air-to-air challenges, or participating in high-speed tag races?\n\nWe\u2019ve been developing a unique bird flapping and gliding mechanic that brings this experience to life in our upcoming multiplayer game, currently dubbed \u201cWingit\u201d.\n\nWe\u2019ve created a basic block-out map and implemented an infection game mode for testing purposes. However, we\u2019re eager to explore more game modes and perfect the overall experience.\n\nDepending on how you choose to fly, this game can be quite a lot of exercise :)\n\nWatch the attached video for a glimpse into the heart-pounding action and join our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN", "short_description": "Flap, glide, swoop, dip and flap to soar like a bird. Hang out with your friends or play a game of Tag, Hunt or make it up as you go."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Remio", "support_website_url": null, "website_url": "https://remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "sup
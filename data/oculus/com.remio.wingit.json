ingit_Render_1.png", "id": "926297781816389", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982584_926297785149722_4227410942138075850_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cm4dQ7xcn6UQ7kNvwGS_jMd&_nc_oc=AdoYpI8uabeS-i5Lrr62Cz3Ym-oZ_SBWqpDRJydCjvf70WgaRjBYkkJnmxULUYEVO1k&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHjVFKroOVs9AYFMJDLHy7ZGnyZtiblyK3IudNALT-Ijw&oe=6A92DEA6"}, {"file_name": "5.png", "id": "673317157978047", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001732_673317161311380_6367319820395155286_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yDyz9NMzklEQ7kNvwGlUbQT&_nc_oc=AdriiGEXyLgX0VhBz02drmgcS28KGSn8-dbW4SmU8cmIZPO45aiRqP5bPpnIQ4XZbCY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFIBoKre57z3_Ou2-Yqj_OZt5x6DMt1UxB14DpNGsZKhA&oe=6A92DFF3"}, {"file_name": "Screenshot (447).png", "id": "628875279216230", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57566698_628875282549563_4913645439909033743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=09GnwLAfBiQQ7kNvwHKGCc5&_nc_oc=Adrl2iI3g7mG_puLU1mzRUC3CLEbOYF18O7BPaALq0Rnnmt-pQemYcoW120gyf7kdzU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxfHjk5FtIQ4-kbNQnisEXCSQdeZZJsfw8SyCfv97f-w&oe=6A92D25B"}, {"file_name": "3.png", "id": "3187958854840290", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974513_3187958858173623_2630061441027911886_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bsy6eA2EfhYQ7kNvwEVz8Q7&_nc_oc=Adqf0a9YtjANAP11p5K9wFjoSgnFYenmkELJtDPS29a-FsNF7Cz8L3Q1zc-0axtelEo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEfhMYaID98wBMIBqe4xytasNaDQjchYZodhpXIzoM_eg&oe=6A92B14F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (4).png", "id": "941214970482404", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031643_941214973815737_2432176783600565336_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o9UxCA58fwIQ7kNvwEPOzXj&_nc_oc=Adp_Wou6DR7HKANZqH-AnGzQZ385_Ewch_YMROG0AS3p7lRgcZtev9xpTCbyQxRLF-I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmhP7tacIE2RPchChqjuljQowtR5gy0EQ54k0MPn82Ng&oe=6A92B032"}, "display_name": "Wingit", "keywords": [], "long_description": "Unleash Your Inner Bird in Aerial Dogfights and Races.\n\nEver dreamed of soaring through the skies as a majestic bird, engaging in thrilling air-to-air challenges, or participating in high-speed tag races?\n\nWe\u2019ve been developing a unique bird flapping and gliding mechanic that brings this experience to life in our upcoming multiplayer game, currently dubbed \u201cWingit\u201d.\n\nWe\u2019ve created a basic block-out map and implemented an infection game mode for testing purposes. However, we\u2019re eager to explore more game modes and perfect the overall experience.\n\nDepending on how you choose to fly, this game can be quite a lot of exercise :)\n\nWatch the attached video for a glimpse into the heart-pounding action and join our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN", "short_description": "Flap, glide, swoop, dip and flap to soar like a bird. Hang out with your friends or play a game of Tag, Hunt or make it up as you go."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Remio", "support_website_url": null, "website_url": "https://remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "sup
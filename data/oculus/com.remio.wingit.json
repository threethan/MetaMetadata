5/38982584_926297785149722_4227410942138075850_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s2bPQ08QLl4Q7kNvwGQndyz&_nc_oc=AdlffnXXjZ1gTNEIUSwPH4MMCKNsXaZmOZV5MHh7ncJNcHzl5tiQfd5-PuUMxNsePiM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AftaW2VAtAlihG1eVnQ70Pgpltlf-m7h8TBqS5xxFPOCww&oe=69A590A6"}, {"file_name": "5.png", "id": "673317157978047", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001732_673317161311380_6367319820395155286_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SqC4bzzcyWUQ7kNvwFDdqei&_nc_oc=Adl0jdISySxZ-gGavmLuQFPgYshJ8TVo2hhwg_iRFTxWiHCdLNC5LuxU9cSk5zoNWtU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfvaZmj7n8lKnRurn-JaaewuP9Z2wq9CgBjHAefuJMu6ig&oe=69A591F3"}, {"file_name": "Screenshot (447).png", "id": "628875279216230", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57566698_628875282549563_4913645439909033743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y6-cfr0kuV4Q7kNvwGBufrr&_nc_oc=Adk8tTPLXTcmdOTg3iKb7rRAa-F_AfUeuxi1NwwjXkVrS3Tw4BWPzkwTOV7OFs1A8qw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfsNY29csGkKMgLvW5oC1B2_7l4sxJIocNYYjtVXDSDOhQ&oe=69A5845B"}, {"file_name": "3.png", "id": "3187958854840290", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974513_3187958858173623_2630061441027911886_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-_NNjvsfuBgQ7kNvwF0sxIF&_nc_oc=AdmnRwDaOzjIkTc9uRlqXFlZ1O-9JaOQYg98PvU_a7NN7P720MKbvZJbW-7vXh_Dj5w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftMZ_Xm_q_yE1ry-8H1MZiEF80v71N56bjLJJLbOaKdtw&oe=69A59B8F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (4).png", "id": "941214970482404", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031643_941214973815737_2432176783600565336_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OzldfhtQ1sgQ7kNvwGL3whq&_nc_oc=AdnSbccNo1mhxeciQjZ5vUC1s6hKBGq4TX-jjDKYvb1P6zHmeoFRQ8YH9-dS7M9ZzPE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afs_GyQO6nMD-EU5Uc2y0-yXoS0s1Ajt5i2vqUQwLpcnwA&oe=69A59A72"}, "display_name": "Wingit", "keywords": [], "long_description": "Unleash Your Inner Bird in Aerial Dogfights and Races.\n\nEver dreamed of soaring through the skies as a majestic bird, engaging in thrilling air-to-air challenges, or participating in high-speed tag races?\n\nWe\u2019ve been developing a unique bird flapping and gliding mechanic that brings this experience to life in our upcoming multiplayer game, currently dubbed \u201cWingit\u201d.\n\nWe\u2019ve created a basic block-out map and implemented an infection game mode for testing purposes. However, we\u2019re eager to explore more game modes and perfect the overall experience.\n\nDepending on how you choose to fly, this game can be quite a lot of exercise :)\n\nWatch the attached video for a glimpse into the heart-pounding action and join our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN", "short_description": "Flap, glide, swoop, dip and flap to soar like a bird. Hang out with your friends or play a game of Tag, Hunt or make it up as you go."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Remio", "support_website_url": null, "website_url": "https://remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_
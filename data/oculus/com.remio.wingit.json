ingit_Render_1.png", "id": "926297781816389", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982584_926297785149722_4227410942138075850_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1F8M5xSsblUQ7kNvwG3VKYA&_nc_oc=AdoKZhWWblrLxHq0Rtvy-SEhD5PCKD9jWUuu0QSIVwOAtDnAWgzZBOImNWA-rSOIt1s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIDX9yrqOJSGZP0Jn2Vt3R2XhKA3lkmA2VfTaR-a_iJ8w&oe=6AB525A6"}, {"file_name": "5.png", "id": "673317157978047", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001732_673317161311380_6367319820395155286_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wwx6JbGgViEQ7kNvwHsIzb0&_nc_oc=AdrIRU_fbZyBTJOrMu6F1xeRVrZCC39gHX9bUXAToVI0ZRiXNreyTBSX5KvHgw6fvmw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLq2q987ZJvbu-tjB-DMC1VeUT--w_nrPOA65HWLV3VXA&oe=6AB526F3"}, {"file_name": "Screenshot (447).png", "id": "628875279216230", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566698_628875282549563_4913645439909033743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NHd8N9fjKTYQ7kNvwHtg2qP&_nc_oc=AdpLgOih409ngvflbAtKM2Ro4G1kSaXPnSz14b1MOl_DmqaASFXH35wdd8BkbM_yuQs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6zH-gyYVJdBWbSSluQ1dyQX3L1w8I7UcAyWZzFzIp1Q&oe=6AB5195B"}, {"file_name": "3.png", "id": "3187958854840290", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974513_3187958858173623_2630061441027911886_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5GU5a_tk3gAQ7kNvwGXtii_&_nc_oc=AdqVrTgy6jL7EB-6Tf5Q3NGXBIg2oIui4m3gLoDpaegOVsVjgxn5qjVb9-lTSUS8mzI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1-Cn9DHCTX3JHMs_45l3PojBtmr25IbNBspvLMUGVAQ&oe=6AB5308F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (4).png", "id": "941214970482404", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031643_941214973815737_2432176783600565336_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mGUzHVa67j4Q7kNvwHtwIpH&_nc_oc=AdpDkDlACc-KG3SqRtL_H0wNsVuVH_aKNl_ggtvUnDcTKKolg6bWICjcrnXmXkNRKqA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLBjo9aRb4iUaHFNs-T89ZsHHKJ1XZMv8jHuGV-R921hA&oe=6AB52F72"}, "display_name": "Wingit", "keywords": [], "long_description": "Unleash Your Inner Bird in Aerial Dogfights and Races.\n\nEver dreamed of soaring through the skies as a majestic bird, engaging in thrilling air-to-air challenges, or participating in high-speed tag races?\n\nWe\u2019ve been developing a unique bird flapping and gliding mechanic that brings this experience to life in our upcoming multiplayer game, currently dubbed \u201cWingit\u201d.\n\nWe\u2019ve created a basic block-out map and implemented an infection game mode for testing purposes. However, we\u2019re eager to explore more game modes and perfect the overall experience.\n\nDepending on how you choose to fly, this game can be quite a lot of exercise :)\n\nWatch the attached video for a glimpse into the heart-pounding action and join our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN", "short_description": "Flap, glide, swoop, dip and flap to soar like a bird. Hang out with your friends or play a game of Tag, Hunt or make it up as you go."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Remio", "support_website_url": null, "website_url": "https://remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "sup
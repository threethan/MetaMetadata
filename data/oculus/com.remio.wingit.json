ingit_Render_1.png", "id": "926297781816389", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982584_926297785149722_4227410942138075850_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j2WbrDVF-3sQ7kNvwHbh3cG&_nc_oc=Adrkwmg5nD66bI-oGIskZXgdkWv5PuCTJTyDe05jC6KAWXQKsi-5k2yoOF67wrEOAd8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_07HdhBbSJeTQd4O-HZQDU92ruIslWm2QhdPRTeIQkQ&oe=6AC10326"}, {"file_name": "5.png", "id": "673317157978047", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001732_673317161311380_6367319820395155286_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7v-j032slyoQ7kNvwE6FUoE&_nc_oc=AdpuqMkQUZXXHmsJtpuClkUBJio3j893q6Hy4wdD0bCtmcrcA3tR2_eoWi0f0lchFfk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPEaQIm4-LTraBhuO0nLX7l9ygjxyvaF44ZJiaqMiIkvw&oe=6AC10473"}, {"file_name": "Screenshot (447).png", "id": "628875279216230", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566698_628875282549563_4913645439909033743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=864fUH-leYoQ7kNvwEzyC6V&_nc_oc=AdrM1273v1nCubkrmlGYzOqkdBZVTXCMD_Jvf3K0Nj-piztB41R78q5_FGLKpn0-gMA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNmE4jfQUGA3Lx7tH_X5A8evHxHLpvq4PkAnfG4dxmJgg&oe=6AC12F1B"}, {"file_name": "3.png", "id": "3187958854840290", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974513_3187958858173623_2630061441027911886_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0jlqOdzcgKwQ7kNvwEmN5-z&_nc_oc=AdoNr9zeK1_aWoHQygMEdr8CDGBOH6wbRbgmkWzuQsQm7NxSD8sOqHZbXdqXhQ1kyAc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNHSUFqMOFf6wmZSdF_aCazIGZRhow-3FXZcW0Y3onmQA&oe=6AC10E0F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (4).png", "id": "941214970482404", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031643_941214973815737_2432176783600565336_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dmVaxaXpBDIQ7kNvwFvYm4N&_nc_oc=AdpMYD5x6-s4EVkU5ahUeDdEV6XmG61_4Bpq3Q_RyySh4C2SLmAqBYki-T3M9xuWIVA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOAbfkyFZayuMDTYKX4UpW1dsi_N9WEwdS4FRaxz9E66Q&oe=6AC10CF2"}, "display_name": "Wingit", "keywords": [], "long_description": "Unleash Your Inner Bird in Aerial Dogfights and Races.\n\nEver dreamed of soaring through the skies as a majestic bird, engaging in thrilling air-to-air challenges, or participating in high-speed tag races?\n\nWe\u2019ve been developing a unique bird flapping and gliding mechanic that brings this experience to life in our upcoming multiplayer game, currently dubbed \u201cWingit\u201d.\n\nWe\u2019ve created a basic block-out map and implemented an infection game mode for testing purposes. However, we\u2019re eager to explore more game modes and perfect the overall experience.\n\nDepending on how you choose to fly, this game can be quite a lot of exercise :)\n\nWatch the attached video for a glimpse into the heart-pounding action and join our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN", "short_description": "Flap, glide, swoop, dip and flap to soar like a bird. Hang out with your friends or play a game of Tag, Hunt or make it up as you go."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Remio", "support_website_url": null, "website_url": "https://remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "sup
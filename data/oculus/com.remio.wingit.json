ingit_Render_1.png", "id": "926297781816389", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982584_926297785149722_4227410942138075850_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C_IxSQnKAG0Q7kNvwHmbbRG&_nc_oc=AdqU1oroCmUZJIZRMcwK-yURp5XS8QjkFpzZfb-1cPpEVccEhHlfnfFbcgLDyOgsqzQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5m9LostcihX_ocCmYG9KcK6aa-6T9dwzVJpPyi1zwezw&oe=6A0DB726"}, {"file_name": "5.png", "id": "673317157978047", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001732_673317161311380_6367319820395155286_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=20pOhnUfN20Q7kNvwEXf9i5&_nc_oc=AdrQlM2L9H1GXDSyw4kbeWRt0he9c8U0MXr1PF9UwTMIUBiiuzcWG_XUFVOVZqk_DQk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qlSbmBsxngid92ZeKMdq_sRmX-kbC474WaZCvDwOZWA&oe=6A0DB873"}, {"file_name": "Screenshot (447).png", "id": "628875279216230", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566698_628875282549563_4913645439909033743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ID3ZHUhxyJ0Q7kNvwG7FtPg&_nc_oc=AdqmNnvmZDIJ_ow9GjpgciZDnBjZIoWJGw9Rj-Y4I4n4qr3nH0IzDsxmx0e-lxhj0qY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7iJUwO28g9E6ZCJbF4qhq9u-hIrkaMcYp6lX25KrCLLg&oe=6A0DAADB"}, {"file_name": "3.png", "id": "3187958854840290", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974513_3187958858173623_2630061441027911886_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9l9IGM-YbtAQ7kNvwHcMtlz&_nc_oc=AdoqooODrWtwnm7fcWA9gkHt4p7Ffblr_BKRpnX_mt4EuV0tLssfZq8ohNZQ5ny65sE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4SubWEOwlfJEvqSk28pqr2elVFaJbkYPnFm3Ua_UlN2w&oe=6A0DC20F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (4).png", "id": "941214970482404", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031643_941214973815737_2432176783600565336_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z1o8onoovKgQ7kNvwG443GO&_nc_oc=AdoaAnlid-fOb5fehMNTMgXT7hY1M6eziepNvpIPmaE_XkOt7cJaLUCg2eY0EBCOsHk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71I8GVLCGB01518xjeOj5JTtn113H8ygWZoVNkugsIdA&oe=6A0DC0F2"}, "display_name": "Wingit", "keywords": [], "long_description": "Unleash Your Inner Bird in Aerial Dogfights and Races.\n\nEver dreamed of soaring through the skies as a majestic bird, engaging in thrilling air-to-air challenges, or participating in high-speed tag races?\n\nWe\u2019ve been developing a unique bird flapping and gliding mechanic that brings this experience to life in our upcoming multiplayer game, currently dubbed \u201cWingit\u201d.\n\nWe\u2019ve created a basic block-out map and implemented an infection game mode for testing purposes. However, we\u2019re eager to explore more game modes and perfect the overall experience.\n\nDepending on how you choose to fly, this game can be quite a lot of exercise :)\n\nWatch the attached video for a glimpse into the heart-pounding action and join our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN", "short_description": "Flap, glide, swoop, dip and flap to soar like a bird. Hang out with your friends or play a game of Tag, Hunt or make it up as you go."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Remio", "support_website_url": null, "website_url": "https://remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "sup
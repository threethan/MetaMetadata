ingit_Render_1.png", "id": "926297781816389", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982584_926297785149722_4227410942138075850_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dEawOHDk40UQ7kNvwFTEb-Y&_nc_oc=AdqooqEDna57ICSIXrnvlHG5l4SBIdH8THVjLQGbIz5ehgAhPwaQgGO2Dg5ohwXiQhY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDH9tXYVCYemeJsgGy4efM4iG5dJGxjiXxdiz3-rQ1iYQ&oe=6A5B7FA6"}, {"file_name": "5.png", "id": "673317157978047", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001732_673317161311380_6367319820395155286_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ap5IaV0XFvMQ7kNvwEnHwev&_nc_oc=AdrPL5s2E_Tsl1XJhiHOZVs6Hc_40m8bunNxEgJDrj_uldZhQ1pnWTTdJNvLorzf8-I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA8LmByuwN92UvCQPNpoZ-AU3mYH6tiKJWFvY3CV3CE6Q&oe=6A5B80F3"}, {"file_name": "Screenshot (447).png", "id": "628875279216230", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566698_628875282549563_4913645439909033743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1rDr2uQ_NQkQ7kNvwFNTEem&_nc_oc=Adrw1eySxHd2bUUuCwwbJEPUuYVpjLdISbWd5Popc9ff-TaZmJv6BJg7ypsXqCmITYk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBBBijJzwW4iapX0xmKob1cVUwTcwSnP_UwxgFSoIw1Wg&oe=6A5B735B"}, {"file_name": "3.png", "id": "3187958854840290", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974513_3187958858173623_2630061441027911886_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nn1n0FtNmjIQ7kNvwGfZEog&_nc_oc=Adr12348S2at9c3Y8tdXup-cPpG0zdjBo2oiSM-q6TLC5Tut5VFfRlWPvmLUnpoJ8Wk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD99syx0JUtVY2RuV9zGrRXDSrKy2J0vnxgdP9K4saCTQ&oe=6A5B8A8F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (4).png", "id": "941214970482404", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031643_941214973815737_2432176783600565336_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qc6abJmPolMQ7kNvwE8WSgt&_nc_oc=AdrLKDedms2nx3_BVYgyNvgruDLrmgpj0MHKLyw4e-RHYU7Xs6G-ry9ahl2Meoe_HO8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAskiKclJHqMCnCkGt8TdOEN6EJBRNIyZecs22tL7u3_A&oe=6A5B8972"}, "display_name": "Wingit", "keywords": [], "long_description": "Unleash Your Inner Bird in Aerial Dogfights and Races.\n\nEver dreamed of soaring through the skies as a majestic bird, engaging in thrilling air-to-air challenges, or participating in high-speed tag races?\n\nWe\u2019ve been developing a unique bird flapping and gliding mechanic that brings this experience to life in our upcoming multiplayer game, currently dubbed \u201cWingit\u201d.\n\nWe\u2019ve created a basic block-out map and implemented an infection game mode for testing purposes. However, we\u2019re eager to explore more game modes and perfect the overall experience.\n\nDepending on how you choose to fly, this game can be quite a lot of exercise :)\n\nWatch the attached video for a glimpse into the heart-pounding action and join our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN", "short_description": "Flap, glide, swoop, dip and flap to soar like a bird. Hang out with your friends or play a game of Tag, Hunt or make it up as you go."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Remio", "support_website_url": null, "website_url": "https://remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "sup
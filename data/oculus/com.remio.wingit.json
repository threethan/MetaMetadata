ingit_Render_1.png", "id": "926297781816389", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38982584_926297785149722_4227410942138075850_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cm4dQ7xcn6UQ7kNvwGNjLww&_nc_oc=AdoGPIs_vTALQJHMczZAkC7u1mkO38Mrcpn5ki_mafiPt6fQjJQ20mf06XK6j7KxA4Y&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQjFk8qCf_RYIfZfO5dADasl9jiG-JVkKSj6nIc9Y7TQ&oe=6A918D26"}, {"file_name": "5.png", "id": "673317157978047", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39001732_673317161311380_6367319820395155286_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yDyz9NMzklEQ7kNvwGfUQgQ&_nc_oc=Adpd1EEMRSZSw9WS7-JHQPg2LQ7OM1_2MOfc8ps6PBq7Uo9KGyhg6BBn_OR1RoBRNos&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWsQDGoO2XbFWs6Tyud4egyN2hyAgK-rIYVkURIwmBQg&oe=6A918E73"}, {"file_name": "Screenshot (447).png", "id": "628875279216230", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/57566698_628875282549563_4913645439909033743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=09GnwLAfBiQQ7kNvwFPFCXx&_nc_oc=AdpxeMU2c4ERBdKEcdZarMpRtYhaeRozPAp5mKFHFPPEblMRQgdrCMmKyc36sTqXYWs&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6o2A3lflnb5wXh6X-D58Nm5d7nkhL2VEgCBqXi2z5qA&oe=6A9180DB"}, {"file_name": "3.png", "id": "3187958854840290", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/38974513_3187958858173623_2630061441027911886_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bsy6eA2EfhYQ7kNvwE4G2nC&_nc_oc=AdoH9NSKlwCHn-JPWqEFppNMxhsX_F4Fwu3ScNcF5moSca6d9t6Vo8LnJWjvFTkV7OI&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_QvdKdzsL47f1vYI1UJv1OosHnwerjxA49PY-f-AePQ&oe=6A915FCF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (4).png", "id": "941214970482404", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39031643_941214973815737_2432176783600565336_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o9UxCA58fwIQ7kNvwFOut53&_nc_oc=AdrGhBP4jFDPttni5jjfqWISszd_qbtKL_PoRK_g0NNAeKI4QjLX5DyBUFCO7XMX6Jw&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYq58CLmt0t_5_szLkGE-9pUC73MMMzKSRkD-d32pHIg&oe=6A915EB2"}, "display_name": "Wingit", "keywords": [], "long_description": "Unleash Your Inner Bird in Aerial Dogfights and Races.\n\nEver dreamed of soaring through the skies as a majestic bird, engaging in thrilling air-to-air challenges, or participating in high-speed tag races?\n\nWe\u2019ve been developing a unique bird flapping and gliding mechanic that brings this experience to life in our upcoming multiplayer game, currently dubbed \u201cWingit\u201d.\n\nWe\u2019ve created a basic block-out map and implemented an infection game mode for testing purposes. However, we\u2019re eager to explore more game modes and perfect the overall experience.\n\nDepending on how you choose to fly, this game can be quite a lot of exercise :)\n\nWatch the attached video for a glimpse into the heart-pounding action and join our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN", "short_description": "Flap, glide, swoop, dip and flap to soar like a bird. Hang out with your friends or play a game of Tag, Hunt or make it up as you go."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Remio", "support_website_url": null, "website_url": "https://remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "sup
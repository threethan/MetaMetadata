ingit_Render_1.png", "id": "926297781816389", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982584_926297785149722_4227410942138075850_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vp3-Pa-N6RcQ7kNvwEj3-Cg&_nc_oc=AdoBQ3dNU_Ny2IaDdtTx3s-Ir9CqlsIBqEoXjK6nQzo9cRSKxk2AHIFnsdtQRD3Gyno&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqJA8nrqd_4wLgJ3baN903jNaYdxuSp9FFOcSEINpQxQ&oe=6A9743A6"}, {"file_name": "5.png", "id": "673317157978047", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39001732_673317161311380_6367319820395155286_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3avUc7-5JNYQ7kNvwHH_N5h&_nc_oc=Adoli0AZDgDdnbylTfHtkF_onS3Jjl194DWB3gZ8hv8Yn2TCIUbPIWbH3rSjgIwOq54&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHaRdleIp90-zN8kmjV1bBBs7c3ViZ7lkVD2yorNdFFhA&oe=6A9744F3"}, {"file_name": "Screenshot (447).png", "id": "628875279216230", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/57566698_628875282549563_4913645439909033743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_GBH2-oB8UMQ7kNvwEYsqm4&_nc_oc=AdpliKEvtoNoAIwxPPsJYHS9d4QqyGEBBNYr_9W7mX4vloQirECUW-h1y6QNCVp_IIg&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGpz1xCgu0VtxyZgea2dnagOrW65E0E9LnbFzwBmwacaA&oe=6A97375B"}, {"file_name": "3.png", "id": "3187958854840290", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974513_3187958858173623_2630061441027911886_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZNhUUWpx2uwQ7kNvwHt3nhs&_nc_oc=Adr1VA_MTeXghRB-Nv0BOSqiJpe-8m9DTD6tbci5jn_ZBxvNFcNtK4vZZ6V5d_jCwpY&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmCbIVrGTvP0D9JpFygMr-TuJ3L7YgX538zEM4l9isNQ&oe=6A974E8F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (4).png", "id": "941214970482404", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39031643_941214973815737_2432176783600565336_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JO-pQ01v_hEQ7kNvwGWlZa5&_nc_oc=AdpZ_vgDU7duEP-Lnr2oUqzyruBMimcaxpInUnlgnuLEvYDZ7QNPK1AkIHqNuuAODvQ&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvsd2nC8yahZhPvWa2VNI9yr6ti6KqX44iVH8zE_D0Gw&oe=6A974D72"}, "display_name": "Wingit", "keywords": [], "long_description": "Unleash Your Inner Bird in Aerial Dogfights and Races.\n\nEver dreamed of soaring through the skies as a majestic bird, engaging in thrilling air-to-air challenges, or participating in high-speed tag races?\n\nWe\u2019ve been developing a unique bird flapping and gliding mechanic that brings this experience to life in our upcoming multiplayer game, currently dubbed \u201cWingit\u201d.\n\nWe\u2019ve created a basic block-out map and implemented an infection game mode for testing purposes. However, we\u2019re eager to explore more game modes and perfect the overall experience.\n\nDepending on how you choose to fly, this game can be quite a lot of exercise :)\n\nWatch the attached video for a glimpse into the heart-pounding action and join our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN", "short_description": "Flap, glide, swoop, dip and flap to soar like a bird. Hang out with your friends or play a game of Tag, Hunt or make it up as you go."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Remio", "support_website_url": null, "website_url": "https://remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "sup
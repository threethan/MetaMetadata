5/38982584_926297785149722_4227410942138075850_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A_Ma8AjY1qoQ7kNvwGyrCyc&_nc_oc=AdnA5a8EXqxo_7xe0mAgc0El__d4WiB5VCa1bSJdB0cj7LOmtCR2uRll30sFtC4nE44&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aftw7eBkjmQH9nTIYDUXAQqDT25ExLokqjjnr_CmHx1uig&oe=699B04A6"}, {"file_name": "5.png", "id": "673317157978047", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001732_673317161311380_6367319820395155286_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nDF3iAzX68sQ7kNvwE0PFMU&_nc_oc=AdlcqQ-L3XRypBfhjMlR6HSqrqfKtliZecf6V1igTpU3MTj-_sBfWyB-0FGpoEabMFo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afu3U0NZJgYAMwNMy3nKt-R28nDaB1pFpEIkWgMr2MeQew&oe=699B05F3"}, {"file_name": "Screenshot (447).png", "id": "628875279216230", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57566698_628875282549563_4913645439909033743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8uoRifF172wQ7kNvwHVer6s&_nc_oc=AdlmssDKfkzYXKScFz5wqVXL-_B66ptTRzGkCg8WfkkfNHVoFjw-Xs0u7bd6mDmIXzQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftPLaB22drS2OfUrejKh1ct_q0i2Apm4TBJ4gsuhA8WBw&oe=699AF85B"}, {"file_name": "3.png", "id": "3187958854840290", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974513_3187958858173623_2630061441027911886_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DfJYcWykla0Q7kNvwFP1r1b&_nc_oc=AdlYSejq_jg_M01r-4sx33FGVlqjD-rAf7kU4ezSY1FAc85WB7Vg6z0pl0KPb3E4qR8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvAq-fWaO5IQV6KTS0-um_EEt9Jcn9lutKsrnxIh9C8wQ&oe=699B0F8F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (4).png", "id": "941214970482404", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031643_941214973815737_2432176783600565336_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RmymLQO2CIoQ7kNvwHBq5pO&_nc_oc=AdnaOw2NO6BXdDFZY1Wim7_ZjCo5YRPXM4AF4pt0dsI0xZljZ7AhLgVD3MBbpxOdxbs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfspsOUYaxpV4XzB0j3V3bKmhlAVUo3VRdWVfV1Xnw8lTA&oe=699B0E72"}, "display_name": "Wingit", "keywords": [], "long_description": "Unleash Your Inner Bird in Aerial Dogfights and Races.\n\nEver dreamed of soaring through the skies as a majestic bird, engaging in thrilling air-to-air challenges, or participating in high-speed tag races?\n\nWe\u2019ve been developing a unique bird flapping and gliding mechanic that brings this experience to life in our upcoming multiplayer game, currently dubbed \u201cWingit\u201d.\n\nWe\u2019ve created a basic block-out map and implemented an infection game mode for testing purposes. However, we\u2019re eager to explore more game modes and perfect the overall experience.\n\nDepending on how you choose to fly, this game can be quite a lot of exercise :)\n\nWatch the attached video for a glimpse into the heart-pounding action and join our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN", "short_description": "Flap, glide, swoop, dip and flap to soar like a bird. Hang out with your friends or play a game of Tag, Hunt or make it up as you go."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Remio", "support_website_url": null, "website_url": "https://remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_
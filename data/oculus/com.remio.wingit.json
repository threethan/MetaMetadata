ingit_Render_1.png", "id": "926297781816389", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982584_926297785149722_4227410942138075850_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d9z9acEZGKAQ7kNvwHdo7NW&_nc_oc=AdrbqUCu4LgfL0wdjoHU1qMXluPq_sFGOExTe0w3mzDlEvgvQ9EYwI0SVRBNtbm3JAk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_T5DViqeIXrslES8DgWKeQErlLn8Y1cBZj-HlaFi9Luw&oe=6A451626"}, {"file_name": "5.png", "id": "673317157978047", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001732_673317161311380_6367319820395155286_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SwuTgHgBgcMQ7kNvwEDTSSO&_nc_oc=AdpB53mR10LNJzDjXbjN6eJQH-_XnguAJf1Uv5750gu3RS2yPCPclBkfEkpHdZqKFfM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8XmeDQnr5rC3gv17lFNB3mFC7V_Lc_5wffhSJWdY8zWw&oe=6A451773"}, {"file_name": "Screenshot (447).png", "id": "628875279216230", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57566698_628875282549563_4913645439909033743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BpXwsaGRAygQ7kNvwFfX5UC&_nc_oc=Adoxa5AFPXcSgnfDvumu0YkjY2Whdr-W48IyYCnfrylnw6hsxLbFvSWkXbWiEg6iXQo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9DzV64p68y1s7f-d5FvrZs3MzD025Oa1RlBp047AFwyw&oe=6A4509DB"}, {"file_name": "3.png", "id": "3187958854840290", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974513_3187958858173623_2630061441027911886_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YnruC9jJ-7wQ7kNvwFZ3KZy&_nc_oc=AdoVSyw3OnlLCvVZGhkojMRjfAyyQce5PUZmHasg5u080ZLq_ZL7Shwze8jqBhAqbF0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8l0dH2qgr001XOFjQr4YhFhn0znrZn-5EovH63AiAqSA&oe=6A45210F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (4).png", "id": "941214970482404", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031643_941214973815737_2432176783600565336_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tbjG5pxfq6sQ7kNvwFcDoxB&_nc_oc=Adp09nC6h7PPvaNMXY6MdGgNfN3Uo3IfsCmdtkMiPzVpOxddmTqiqhQfYNUqfmQXepY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-QiDmOlDnV9mOBO1lvpFZcUlUoAy4qoLIaOQXnX3fd9Q&oe=6A451FF2"}, "display_name": "Wingit", "keywords": [], "long_description": "Unleash Your Inner Bird in Aerial Dogfights and Races.\n\nEver dreamed of soaring through the skies as a majestic bird, engaging in thrilling air-to-air challenges, or participating in high-speed tag races?\n\nWe\u2019ve been developing a unique bird flapping and gliding mechanic that brings this experience to life in our upcoming multiplayer game, currently dubbed \u201cWingit\u201d.\n\nWe\u2019ve created a basic block-out map and implemented an infection game mode for testing purposes. However, we\u2019re eager to explore more game modes and perfect the overall experience.\n\nDepending on how you choose to fly, this game can be quite a lot of exercise :)\n\nWatch the attached video for a glimpse into the heart-pounding action and join our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN", "short_description": "Flap, glide, swoop, dip and flap to soar like a bird. Hang out with your friends or play a game of Tag, Hunt or make it up as you go."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Remio", "support_website_url": null, "website_url": "https://remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "sup
ingit_Render_1.png", "id": "926297781816389", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982584_926297785149722_4227410942138075850_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YaSMWHj6WWQQ7kNvwGBKoLd&_nc_oc=AdrlmgYufM1RReCQT7VMd1__RQIP01o1rxdK8ZzS_nWpvJ1XQrLU4piIzr3oF8neVvI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-cJv4WfCUP2hNnX13sml_amsPwTwHir7zeejcAo-7c-w&oe=6A3E7EA6"}, {"file_name": "5.png", "id": "673317157978047", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001732_673317161311380_6367319820395155286_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TqPcryKusN8Q7kNvwFv-YQa&_nc_oc=Adp1AUiRBkPFsmg8gaU7LEb2p3FuH7M_ezdHaIOP272Bi1FTeCkfWbxt6CYGxbGzMYg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Kd361enMt1ImFEsI0DweeMgZDV0gjHMJkn1KmrGDmdA&oe=6A3E7FF3"}, {"file_name": "Screenshot (447).png", "id": "628875279216230", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57566698_628875282549563_4913645439909033743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4j_Y0TRSyP4Q7kNvwGWGTRD&_nc_oc=Adr9VocI-cFqqsXhWqF14Tdz4EXItNlxOhrm4RdBJyf9r1RpVqPNeTAqAaWX_Spy5FU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MiTySsmOYqAtJqR2oqrWKZGrI5LRM_LuWEb3FvEUl8g&oe=6A3EAA9B"}, {"file_name": "3.png", "id": "3187958854840290", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974513_3187958858173623_2630061441027911886_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2VF7eV43JzIQ7kNvwEt7Nsy&_nc_oc=AdqF4wvv_sq1Vc1Wp_q_x0c0c6tTi1WcrG8EJI5UywunJMmAEBbUksrxHouUOr__C_w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-PJKV1BKoOf8ABNUkNTu4nfKZFPKjRYEC6euNK8mOINg&oe=6A3E898F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (4).png", "id": "941214970482404", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031643_941214973815737_2432176783600565336_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cyx4vyNDW60Q7kNvwGRUnQF&_nc_oc=AdrtR5ZTjg9Hgk8np9CzUFchBqL-xMHLeeyYzgN0i0rnn-ZXZ-VHsRO5mGjA3fYsmys&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8KNnxy3P2u_Kww4mcw8rKlFK-UqeXeMHqeqkvr_I8LLg&oe=6A3E8872"}, "display_name": "Wingit", "keywords": [], "long_description": "Unleash Your Inner Bird in Aerial Dogfights and Races.\n\nEver dreamed of soaring through the skies as a majestic bird, engaging in thrilling air-to-air challenges, or participating in high-speed tag races?\n\nWe\u2019ve been developing a unique bird flapping and gliding mechanic that brings this experience to life in our upcoming multiplayer game, currently dubbed \u201cWingit\u201d.\n\nWe\u2019ve created a basic block-out map and implemented an infection game mode for testing purposes. However, we\u2019re eager to explore more game modes and perfect the overall experience.\n\nDepending on how you choose to fly, this game can be quite a lot of exercise :)\n\nWatch the attached video for a glimpse into the heart-pounding action and join our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN", "short_description": "Flap, glide, swoop, dip and flap to soar like a bird. Hang out with your friends or play a game of Tag, Hunt or make it up as you go."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Remio", "support_website_url": null, "website_url": "https://remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "sup
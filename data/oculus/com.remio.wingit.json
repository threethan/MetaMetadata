ingit_Render_1.png", "id": "926297781816389", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982584_926297785149722_4227410942138075850_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XT4RAM3NCHEQ7kNvwF52JW6&_nc_oc=AdrHobwYZ4BMyxFzDD7pvQ9rUD3g5uSjtqm6ZbvZq6e2gPESjX4jxrgDKtrlL-0QJOk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD57-uFpQAu5Eszc-K-HNmDrJrKJ3xPZjrADuTghTIOhg&oe=6A4E50A6"}, {"file_name": "5.png", "id": "673317157978047", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001732_673317161311380_6367319820395155286_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IOzkYz4P1gsQ7kNvwGaECHf&_nc_oc=AdoOQU3FDcJtd33QcfMOpBWa2NqE5HYe3JgmOLJXbFGc-vyXV1Az4ovP-ihCP4BlgQE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAhEGhv-W7LlUjeDa3ZYSYHrDRLmv8jPi0cJsxcCifbEA&oe=6A4E51F3"}, {"file_name": "Screenshot (447).png", "id": "628875279216230", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57566698_628875282549563_4913645439909033743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EIBYtgYUtkUQ7kNvwGmlrkF&_nc_oc=AdoqB1E_l76UT3KimlEx0IURt6sqv7Wx-7x4AlIVWT5nAG0iT_Uupszz6nJKXpyszxY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDI17iTstlaaK8cXH09nulI2_-ATGkLexnIZbPCIku0qw&oe=6A4E445B"}, {"file_name": "3.png", "id": "3187958854840290", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974513_3187958858173623_2630061441027911886_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LfvEgCu5hOEQ7kNvwGsYwnc&_nc_oc=Ado7xhcFxv4ArtQdopTW4cE09q2yLDNmDgaDyS5TSsG35yGxG24Jv5AYjJmazPqhpic&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALWLBueWl6QcBbMumEO64Vaz4o-QF0Dr1fy6IARIoB0w&oe=6A4E5B8F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (4).png", "id": "941214970482404", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031643_941214973815737_2432176783600565336_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8AiXAGOcLD8Q7kNvwFLrIds&_nc_oc=Adqu8mmHVhhfzVQUfYiz_UOgpPn2v1Z7iWQtk-uepYILRa2Sm6OJU7k8qE_c4O7qKaE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDvi8jUgzCjMxx-JN_QhNNXibEtomKQW42zhrocblRTZg&oe=6A4E5A72"}, "display_name": "Wingit", "keywords": [], "long_description": "Unleash Your Inner Bird in Aerial Dogfights and Races.\n\nEver dreamed of soaring through the skies as a majestic bird, engaging in thrilling air-to-air challenges, or participating in high-speed tag races?\n\nWe\u2019ve been developing a unique bird flapping and gliding mechanic that brings this experience to life in our upcoming multiplayer game, currently dubbed \u201cWingit\u201d.\n\nWe\u2019ve created a basic block-out map and implemented an infection game mode for testing purposes. However, we\u2019re eager to explore more game modes and perfect the overall experience.\n\nDepending on how you choose to fly, this game can be quite a lot of exercise :)\n\nWatch the attached video for a glimpse into the heart-pounding action and join our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN", "short_description": "Flap, glide, swoop, dip and flap to soar like a bird. Hang out with your friends or play a game of Tag, Hunt or make it up as you go."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Remio", "support_website_url": null, "website_url": "https://remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "sup
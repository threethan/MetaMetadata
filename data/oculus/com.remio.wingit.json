ingit_Render_1.png", "id": "926297781816389", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982584_926297785149722_4227410942138075850_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F9eU_0T_ypsQ7kNvwEv4qtf&_nc_oc=AdqC2u2O3INWRQyXF-4IG4ptftU8JyR7LsOwPhj8orh3uFGh4OJ28kRXRqVhYteVuEU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJENqVV55B2T9gEfc495H6AVZ-zbG7gGFdTcFh3Y3XQ-w&oe=6AAA99A6"}, {"file_name": "5.png", "id": "673317157978047", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001732_673317161311380_6367319820395155286_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q9jnBwJ6oW8Q7kNvwF6aIHU&_nc_oc=AdrlBW3-HJJhjlJnb5TG8DYZ1xBY1n_-9QTAj6vvoG9A0Ffj5zoduKYrdNtGzWXatYE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKsWmLHO3SUy6L44K9jRlP5ZrrnBNabOmtf1lNqK6t9SQ&oe=6AAA9AF3"}, {"file_name": "Screenshot (447).png", "id": "628875279216230", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566698_628875282549563_4913645439909033743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HWT08Uy-ZpUQ7kNvwEE_bh8&_nc_oc=Adpn3x7OS3FDwzzO0RGV12nJgrsBa8IZnGA97hXbvu03-s5Z3-Oaos286WmEQwop2bQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKeC3OlNVi-iG_0g0dI-zfIQ57o3Gt2sOswhXsQX6vj9Q&oe=6AAA8D5B"}, {"file_name": "3.png", "id": "3187958854840290", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974513_3187958858173623_2630061441027911886_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JCvHRGj7bsAQ7kNvwEA2vut&_nc_oc=AdqQNHVlWHaMmcUcPpSUmJ5DAs8DIjc1ZknjwX0V5xL9QkLi1dytNqImNuzKbg3KCpw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxPZAbzin_4j72FVoID3lePPq1Dl_4szzDVDRTR9HY4A&oe=6AAAA48F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (4).png", "id": "941214970482404", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031643_941214973815737_2432176783600565336_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ieOkVyoeBCsQ7kNvwEX9roK&_nc_oc=AdpDsVxAh-9TSCsJn7Dl2OLXNE4xFg09GUAWVtuwS8bgZV6gc_BDlefqPqL25v8DGGQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjMZqzVUu--m6VA5_6UuPGyJDW9CH8sxu6zDIlC2ZDZw&oe=6AAAA372"}, "display_name": "Wingit", "keywords": [], "long_description": "Unleash Your Inner Bird in Aerial Dogfights and Races.\n\nEver dreamed of soaring through the skies as a majestic bird, engaging in thrilling air-to-air challenges, or participating in high-speed tag races?\n\nWe\u2019ve been developing a unique bird flapping and gliding mechanic that brings this experience to life in our upcoming multiplayer game, currently dubbed \u201cWingit\u201d.\n\nWe\u2019ve created a basic block-out map and implemented an infection game mode for testing purposes. However, we\u2019re eager to explore more game modes and perfect the overall experience.\n\nDepending on how you choose to fly, this game can be quite a lot of exercise :)\n\nWatch the attached video for a glimpse into the heart-pounding action and join our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN", "short_description": "Flap, glide, swoop, dip and flap to soar like a bird. Hang out with your friends or play a game of Tag, Hunt or make it up as you go."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Remio", "support_website_url": null, "website_url": "https://remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "sup
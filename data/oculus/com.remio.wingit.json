5/38982584_926297785149722_4227410942138075850_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JfnRgVFxFyYQ7kNvwGLL3Wt&_nc_oc=Adlhr9U7keI5Ir25gMjKXTPQ5JSDk7KyNCCltlca2a2jlcO9KpWqoAHVf6kvaJBMrK4&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfudJi2HMGsWvcM58tpIA9Q2lEr9GIxDOatzN38CWs0C8w&oe=69A19C26"}, {"file_name": "5.png", "id": "673317157978047", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39001732_673317161311380_6367319820395155286_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c_RmP_85Tq4Q7kNvwEJoH7W&_nc_oc=AdnlcwEbH43moo_rX4JSUkZXH-SnOFvVudXuU-MEdmupWrPrqdLP9wF_e6OHutu1nKM&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfvbPFKPXtWoG7jmZdUmb2KHznAoH7i36MHema9GX9qzLA&oe=69A19D73"}, {"file_name": "Screenshot (447).png", "id": "628875279216230", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/57566698_628875282549563_4913645439909033743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OWqiQRE3edYQ7kNvwE4QmUD&_nc_oc=Admzb9JfBx99AorZCvVtJVpy2vdsVGNHqbR-KRDAm4WJkdO1DmxnnU3VFFOwchLRLm4&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfsgfgDDmccm4kypj6jxIDHuz7nD9pbK0WaWPUk-JJDIVQ&oe=69A18FDB"}, {"file_name": "3.png", "id": "3187958854840290", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/38974513_3187958858173623_2630061441027911886_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=utVKGYSZjysQ7kNvwE-UuS2&_nc_oc=AdkwIR1MZ_ec3VPBvCcYYETmGZSc97lF8-BShzDsGbnYkr8swhkNZMBDe_dlDnNt1pQ&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_Afveqxl5gW9QG_YtwwTm0pM6OkIWCWcWWYU_rv4VAQgLYw&oe=69A1A70F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (4).png", "id": "941214970482404", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39031643_941214973815737_2432176783600565336_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YEhSlqOVpKcQ7kNvwFr2MnB&_nc_oc=Adm7bSQMK4iLV8ZvU9m9izAeqVW9CWemqz3qFvswyVKnk76L5fTuuxmJZEMUI0_u7_I&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afs5Xv4B_rAisQO8JbxA-k_22h-Ixfzubv5tJA6C6H8kMQ&oe=69A1A5F2"}, "display_name": "Wingit", "keywords": [], "long_description": "Unleash Your Inner Bird in Aerial Dogfights and Races.\n\nEver dreamed of soaring through the skies as a majestic bird, engaging in thrilling air-to-air challenges, or participating in high-speed tag races?\n\nWe\u2019ve been developing a unique bird flapping and gliding mechanic that brings this experience to life in our upcoming multiplayer game, currently dubbed \u201cWingit\u201d.\n\nWe\u2019ve created a basic block-out map and implemented an infection game mode for testing purposes. However, we\u2019re eager to explore more game modes and perfect the overall experience.\n\nDepending on how you choose to fly, this game can be quite a lot of exercise :)\n\nWatch the attached video for a glimpse into the heart-pounding action and join our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN", "short_description": "Flap, glide, swoop, dip and flap to soar like a bird. Hang out with your friends or play a game of Tag, Hunt or make it up as you go."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Remio", "support_website_url": null, "website_url": "https://remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_
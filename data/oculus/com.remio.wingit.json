ingit_Render_1.png", "id": "926297781816389", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982584_926297785149722_4227410942138075850_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oHjd-RFxk3UQ7kNvwGmV2f9&_nc_oc=AdqF1toAY9MrxloYMmvckOfuTw01n1pb9Niw2VGAEC4mZ0VyNqsZOubOCuT2xg1_t28&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ZHAFGTM51qnIT3guJBjqUsZ2UohlknOExK8awdsCtug&oe=69F9F0A6"}, {"file_name": "5.png", "id": "673317157978047", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001732_673317161311380_6367319820395155286_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VSPZWHpPf3YQ7kNvwFKsMks&_nc_oc=Adog0HK9xEc5G9WZfjJse7-LfNpbwVe8iqzFuVo8h7g8TdDQT9O3nbbDmy2Jic3_hl8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4GoALFkO-4e8zCf9CTwQoEdFpH15aGXAvLWMzOdYyfVw&oe=69F9F1F3"}, {"file_name": "Screenshot (447).png", "id": "628875279216230", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57566698_628875282549563_4913645439909033743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7jveUI1vp9IQ7kNvwH1FS3V&_nc_oc=AdqO2NTBSaL2Nfv7PEkW49yctAAdty930_WKqmNkhkMQtve7evPYK4rlOcCNA2zcuKM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6tCskCvDeFrKl3KnfxcMYc1wKNCcVAklpyF3YtFf4aTA&oe=69F9E45B"}, {"file_name": "3.png", "id": "3187958854840290", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974513_3187958858173623_2630061441027911886_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8WCwy25Q-RoQ7kNvwEj4laY&_nc_oc=Adp0mEYSwr2ZOXk6r1I_o9MNrMbCpOsm9kNQ5ifRGSsVH8mC-SurHxlH9wrijMwSATo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7RQXRpqK-61yBYJvZltZwO3RaaJ9fMlB_XCzkTRuNLUA&oe=69F9FB8F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (4).png", "id": "941214970482404", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031643_941214973815737_2432176783600565336_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FLTt3naHZVsQ7kNvwHrn0Gk&_nc_oc=AdrRWTdvNtCfAecXKzysrcBgWAIHvE7BkT2-Hzx4h7VQh8euy4uGl3CQOtr7mbAkbjQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5KMkx9KmVY4L_f2MTCl3CrWFfiI0Whu42-OBgdD4StLw&oe=69F9FA72"}, "display_name": "Wingit", "keywords": [], "long_description": "Unleash Your Inner Bird in Aerial Dogfights and Races.\n\nEver dreamed of soaring through the skies as a majestic bird, engaging in thrilling air-to-air challenges, or participating in high-speed tag races?\n\nWe\u2019ve been developing a unique bird flapping and gliding mechanic that brings this experience to life in our upcoming multiplayer game, currently dubbed \u201cWingit\u201d.\n\nWe\u2019ve created a basic block-out map and implemented an infection game mode for testing purposes. However, we\u2019re eager to explore more game modes and perfect the overall experience.\n\nDepending on how you choose to fly, this game can be quite a lot of exercise :)\n\nWatch the attached video for a glimpse into the heart-pounding action and join our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN", "short_description": "Flap, glide, swoop, dip and flap to soar like a bird. Hang out with your friends or play a game of Tag, Hunt or make it up as you go."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Remio", "support_website_url": null, "website_url": "https://remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "sup
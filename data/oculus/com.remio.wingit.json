_name": "Wingit_Render_1.png", "id": "926297781816389", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982584_926297785149722_4227410942138075850_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yRP-JDPjeLkQ7kNvwG9grcw&_nc_oc=AdqXvYICkdMLgOeV0CRdogG-2tJRd6SXDJAjGRdziIMzkJtjNbkwOeAyP8loUlXTICw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQER4S787bdHow1nirkPed_q5_iOQjjn034Vm9QOOd6cOw&oe=6A8EEA26"}, {"file_name": "5.png", "id": "673317157978047", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39001732_673317161311380_6367319820395155286_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V5alCyf7YTAQ7kNvwGJrmI0&_nc_oc=AdqtxmSEPep6IWt5AednUOygoeUl-_Po8bFfd2TXCLjT9iSo4YOpUPj1r0icMcVX49k&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGlY4HtuKxK6oAPhCs3AvlJtf6XA4P4X4njwmEchGkFWA&oe=6A8EEB73"}, {"file_name": "Screenshot (447).png", "id": "628875279216230", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/57566698_628875282549563_4913645439909033743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kj9E-3hFassQ7kNvwFqCrNY&_nc_oc=AdqeLNcOA0ybj6CZYdNLF7u3Hgk_xvfslSFj8vK3z_Hr7AA2p0dCNpIgCm59JhQMrDc&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEERcgnR9cfIdCMS_F9lXUd2vfQYqHK0HysQSsPnMgi6w&oe=6A8EDDDB"}, {"file_name": "3.png", "id": "3187958854840290", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974513_3187958858173623_2630061441027911886_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PFXFWstP6ZkQ7kNvwHPk2X0&_nc_oc=AdqgN3OCZd94xuI8sxcWpCAbQSCCJEEyL4pCbIjOdexXBRUakZ9txyC9VCcUesTkNuk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEqGBmwvK7i6cGXIWqWdBmqV9aoZS6L4GHEFY3RcpQM9A&oe=6A8EBCCF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (4).png", "id": "941214970482404", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031643_941214973815737_2432176783600565336_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UN6IAPiPAGUQ7kNvwEsHm5M&_nc_oc=AdqB9umJOP7D4S4dUW-j7Fn7RmyrZelu5aEAF6Xe9R8cjHbgjZ93CUINYSGiXW-Kdmo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGePR16RRdYFxYMbj3mOSKYq8m5SmDjrEUNo3mod0L_8A&oe=6A8EBBB2"}, "display_name": "Wingit", "keywords": [], "long_description": "Unleash Your Inner Bird in Aerial Dogfights and Races.\n\nEver dreamed of soaring through the skies as a majestic bird, engaging in thrilling air-to-air challenges, or participating in high-speed tag races?\n\nWe\u2019ve been developing a unique bird flapping and gliding mechanic that brings this experience to life in our upcoming multiplayer game, currently dubbed \u201cWingit\u201d.\n\nWe\u2019ve created a basic block-out map and implemented an infection game mode for testing purposes. However, we\u2019re eager to explore more game modes and perfect the overall experience.\n\nDepending on how you choose to fly, this game can be quite a lot of exercise :)\n\nWatch the attached video for a glimpse into the heart-pounding action and join our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN", "short_description": "Flap, glide, swoop, dip and flap to soar like a bird. Hang out with your friends or play a game of Tag, Hunt or make it up as you go."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Remio", "support_website_url": null, "website_url": "https://remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proces
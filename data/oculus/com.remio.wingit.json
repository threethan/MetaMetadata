_name": "Wingit_Render_1.png", "id": "926297781816389", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982584_926297785149722_4227410942138075850_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yRP-JDPjeLkQ7kNvwE78awe&_nc_oc=Adp06osrmQsCyfWXDjksyhTYzzl5Oxm9hCg35O4SiA0MQ5UgPgjoLO_Y4RKs1MGa_bQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGlHzwY6azQJ_9wnZrVcaef-TU1eAqn9oPy2sUTXDWX2Q&oe=6A8D98A6"}, {"file_name": "5.png", "id": "673317157978047", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39001732_673317161311380_6367319820395155286_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V5alCyf7YTAQ7kNvwF30Ui2&_nc_oc=AdoFI1lHpdsIrSwsS8mVyrl1ps2eVG_T17tkJbqBByNgNSu9JBUyT22hsTf2HqQtmvc&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEo24D6LYqrvCtwpCFfQVQ5SuQYWS6ZEm6XpRUb6wsDJA&oe=6A8D99F3"}, {"file_name": "Screenshot (447).png", "id": "628875279216230", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/57566698_628875282549563_4913645439909033743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kj9E-3hFassQ7kNvwHeh5Tz&_nc_oc=Adp4Ul39EFPYSuZSOuBkKLqkPiT-HTA8YifhVdvZgBfILdEtuFNiIhn3I0wW5Ev8bSw&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGPVZ7bTgIu5MVsp8wn6TelhSKwRbdYVmuIoVr2OlqfJw&oe=6A8D8C5B"}, {"file_name": "3.png", "id": "3187958854840290", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974513_3187958858173623_2630061441027911886_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PFXFWstP6ZkQ7kNvwEzyefV&_nc_oc=AdqS5quIlKlHfe_kFkuqZmB0pS4FQGvtqGJDNSPREBQ7EYCfZua2sGDFdoqrpvC6WYU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmk940kWZ7kWdndxyGQcIf1eJVlgnqcxeKX56F7jUQgg&oe=6A8D6B4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (4).png", "id": "941214970482404", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031643_941214973815737_2432176783600565336_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UN6IAPiPAGUQ7kNvwHtIZkw&_nc_oc=Adq8ThW2jJsWPK3VGRcy_h7kMuQ6o288X1tb1fZASDu67EVY_TflaHgYfQsqCy72TyU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFot5i8acQNbhL_P7NJtD0w7mpqpP9apqiwTCmE22CFrw&oe=6A8D6A32"}, "display_name": "Wingit", "keywords": [], "long_description": "Unleash Your Inner Bird in Aerial Dogfights and Races.\n\nEver dreamed of soaring through the skies as a majestic bird, engaging in thrilling air-to-air challenges, or participating in high-speed tag races?\n\nWe\u2019ve been developing a unique bird flapping and gliding mechanic that brings this experience to life in our upcoming multiplayer game, currently dubbed \u201cWingit\u201d.\n\nWe\u2019ve created a basic block-out map and implemented an infection game mode for testing purposes. However, we\u2019re eager to explore more game modes and perfect the overall experience.\n\nDepending on how you choose to fly, this game can be quite a lot of exercise :)\n\nWatch the attached video for a glimpse into the heart-pounding action and join our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN", "short_description": "Flap, glide, swoop, dip and flap to soar like a bird. Hang out with your friends or play a game of Tag, Hunt or make it up as you go."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Remio", "support_website_url": null, "website_url": "https://remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proces
ingit_Render_1.png", "id": "926297781816389", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982584_926297785149722_4227410942138075850_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oHjd-RFxk3UQ7kNvwE3wScS&_nc_oc=AdpKJUcLX3EsBSdirsV8I4i2_X1XYQiCa2U1GRhk_Bo1yWlkGFmX1ap00OiOJhi2zaI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0m-qTzLeEwu1dOfIJ0tV3_3jHQMTCOL36LXJLj3_8dZw&oe=69F89F26"}, {"file_name": "5.png", "id": "673317157978047", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001732_673317161311380_6367319820395155286_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VSPZWHpPf3YQ7kNvwG_cB47&_nc_oc=AdoMPqbA7qXT8i7sgDVq08jxnNg_ILtfKanVpciQDQQZ084y86CNPh2KyPT3ppv8lG4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2ErgadkiJWTGZvt1Wljbr8bUFejWsGNkE_Bc1TmwzcPg&oe=69F8A073"}, {"file_name": "Screenshot (447).png", "id": "628875279216230", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566698_628875282549563_4913645439909033743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7jveUI1vp9IQ7kNvwHxqSr0&_nc_oc=AdpTr6SlAUxPhJAS97G-QwqcwCyu6tT1RHY4rsrwXGfg33JNWZtcfwUU51ffl6kdizw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2tahe3rjfOUMzzTcOB7PCZcjb4T_SVpmLqnEmLafbjrw&oe=69F892DB"}, {"file_name": "3.png", "id": "3187958854840290", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974513_3187958858173623_2630061441027911886_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rrWM59lHZm4Q7kNvwHd81jK&_nc_oc=Adrxg_U3i6E5LSXm5jHsAajLlEEnEjpiiNmBOppM9G7CVoO0Gix5Y1mvxWLK2WJKXAQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1jqIXPirfvnpLTz3jfb2WvS3EVvwTdXCvGKM8c_JXSgA&oe=69F8AA0F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (4).png", "id": "941214970482404", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031643_941214973815737_2432176783600565336_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=piblimdXEIYQ7kNvwEXDNRx&_nc_oc=AdqI-rMDi7X9BgA1ChQANpq0jixrQTsR6ntdqInEqOF4wICeps63lvmaf9yV7Rk6edE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0t3vHp9g1ln5xkuAOGFXAdNxclDhB1-vC78wa6dbKYfA&oe=69F8A8F2"}, "display_name": "Wingit", "keywords": [], "long_description": "Unleash Your Inner Bird in Aerial Dogfights and Races.\n\nEver dreamed of soaring through the skies as a majestic bird, engaging in thrilling air-to-air challenges, or participating in high-speed tag races?\n\nWe\u2019ve been developing a unique bird flapping and gliding mechanic that brings this experience to life in our upcoming multiplayer game, currently dubbed \u201cWingit\u201d.\n\nWe\u2019ve created a basic block-out map and implemented an infection game mode for testing purposes. However, we\u2019re eager to explore more game modes and perfect the overall experience.\n\nDepending on how you choose to fly, this game can be quite a lot of exercise :)\n\nWatch the attached video for a glimpse into the heart-pounding action and join our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN", "short_description": "Flap, glide, swoop, dip and flap to soar like a bird. Hang out with your friends or play a game of Tag, Hunt or make it up as you go."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Remio", "support_website_url": null, "website_url": "https://remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "sup
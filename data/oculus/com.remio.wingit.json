ingit_Render_1.png", "id": "926297781816389", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982584_926297785149722_4227410942138075850_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0eRcqAatFzQQ7kNvwHYFy1b&_nc_oc=AdpUdG4exc_kBZGyp98YbTmtbFCsftXyIywJolbdkEnDWjqiFA8x07j9a1aZ6YuA1OQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0O3VJfWil5EB87ksVZO4G-6VM02Ga4kObYRDm9SdZ5Gw&oe=69ECC1A6"}, {"file_name": "5.png", "id": "673317157978047", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001732_673317161311380_6367319820395155286_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RAuV1pEnCL8Q7kNvwEtTVsJ&_nc_oc=AdoXto9zaD29q98VMpOMI58XF6PEUHaG0NcSrqdT46k32Roh0Osh1GIsCglC_5IUlCg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ay6RWRZSEc3CdFoT6yXp4_39PN6swm9DlkXOid1bO9A&oe=69ECC2F3"}, {"file_name": "Screenshot (447).png", "id": "628875279216230", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566698_628875282549563_4913645439909033743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eoYS2k-pQ8AQ7kNvwHwQhoW&_nc_oc=Adp59pYHnfdAvJSz8tIt5niboJGJl1gW7rnt3Ri7qUHnce5tUMwEI2Cam0Rg-Txc4zQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0f-lwChltUKnIb1KvA62dSDhEcPntX4yuuhidZJ4rjgQ&oe=69ECB55B"}, {"file_name": "3.png", "id": "3187958854840290", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974513_3187958858173623_2630061441027911886_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U_8c1BiL90UQ7kNvwHXvvZa&_nc_oc=AdrSVWuQfhmH8xK4WhCK1rrzuGEA_0pdRNZXZT3so-kOktv1hnu7affxrF-HRXNZxWI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0w_f4H_PnmIas7Q-ZErAc6tD3QFuHcabVBTP_-zktKgQ&oe=69ECCC8F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (4).png", "id": "941214970482404", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031643_941214973815737_2432176783600565336_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KR71UxGisgkQ7kNvwEw3nwh&_nc_oc=Adrfp3KDI8n4_H8zrnLbZKFBAGDCUbrzXIr38Vz8tlcmP1Bi6HO0Jeq83dXOI6JI4n4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af08wa3Ug2Xdj8xQvACpZlOtVOusmxqM8i_YCwakwhqCcQ&oe=69ECCB72"}, "display_name": "Wingit", "keywords": [], "long_description": "Unleash Your Inner Bird in Aerial Dogfights and Races.\n\nEver dreamed of soaring through the skies as a majestic bird, engaging in thrilling air-to-air challenges, or participating in high-speed tag races?\n\nWe\u2019ve been developing a unique bird flapping and gliding mechanic that brings this experience to life in our upcoming multiplayer game, currently dubbed \u201cWingit\u201d.\n\nWe\u2019ve created a basic block-out map and implemented an infection game mode for testing purposes. However, we\u2019re eager to explore more game modes and perfect the overall experience.\n\nDepending on how you choose to fly, this game can be quite a lot of exercise :)\n\nWatch the attached video for a glimpse into the heart-pounding action and join our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN", "short_description": "Flap, glide, swoop, dip and flap to soar like a bird. Hang out with your friends or play a game of Tag, Hunt or make it up as you go."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Remio", "support_website_url": null, "website_url": "https://remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "sup
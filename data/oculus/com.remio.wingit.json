ingit_Render_1.png", "id": "926297781816389", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982584_926297785149722_4227410942138075850_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5tBZZciVmuYQ7kNvwFKyHpp&_nc_oc=AdrZSK6yW7ZZ-gzLwnWn6-rth6v9D_sp0VQectfxkZuP2PfJH6YO_pVMiN1q4yYQY6Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH2_X-iKHF2NGb9upZxsLNcs6I_-wGVTZbZQM_rrC_1iQ&oe=6A748C26"}, {"file_name": "5.png", "id": "673317157978047", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001732_673317161311380_6367319820395155286_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-U9BPljV2twQ7kNvwGGXRdT&_nc_oc=Ado_my8LK-vdGrFDnhOUtVXG59IB5WwgkU6zsRdCK_Aln9Dm9Cc_u9DK65CRrb4MIh4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHXrVuOi2nhqlLqu6XK9lgYEnhPuRoVs8GRHsuGaZZQw&oe=6A748D73"}, {"file_name": "Screenshot (447).png", "id": "628875279216230", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566698_628875282549563_4913645439909033743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NK2PfhJF9ugQ7kNvwEY5mPA&_nc_oc=AdoQtluR5rk7r5dtJHKOixNfrA4nD_VGRKjUtyVtF4R1JOyr8wlJzAFaBsRO_dSPvPs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGFdkDkzTH4H4AlGmULdq3d1JaXfjV-TW4FSAjMHilgQg&oe=6A747FDB"}, {"file_name": "3.png", "id": "3187958854840290", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974513_3187958858173623_2630061441027911886_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xybVBwHKKeoQ7kNvwEbce4P&_nc_oc=Adqj8dU_tv0vIlYZ-bLiz0cyGkRy8kDQ3Jx9mx6QZlxmEWlDeK3ytXwtcm0U16ZHGMM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyZ9eRQY-yOD7iqoDLNCOTuD1gpMhWKXE2-avue6xswA&oe=6A74970F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (4).png", "id": "941214970482404", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031643_941214973815737_2432176783600565336_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T6rQuOHdWY4Q7kNvwHodQz0&_nc_oc=Adrp2eCtf-nC2W35t16Hc1hhvHp16d9lglOlRMYFKMM5q8hKkXgRgcq-WlQ_4TWSJbw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEwuz05dAAGLpYw_vJwzk-oKAGyZcsHAZuM3flEf35moA&oe=6A7495F2"}, "display_name": "Wingit", "keywords": [], "long_description": "Unleash Your Inner Bird in Aerial Dogfights and Races.\n\nEver dreamed of soaring through the skies as a majestic bird, engaging in thrilling air-to-air challenges, or participating in high-speed tag races?\n\nWe\u2019ve been developing a unique bird flapping and gliding mechanic that brings this experience to life in our upcoming multiplayer game, currently dubbed \u201cWingit\u201d.\n\nWe\u2019ve created a basic block-out map and implemented an infection game mode for testing purposes. However, we\u2019re eager to explore more game modes and perfect the overall experience.\n\nDepending on how you choose to fly, this game can be quite a lot of exercise :)\n\nWatch the attached video for a glimpse into the heart-pounding action and join our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN", "short_description": "Flap, glide, swoop, dip and flap to soar like a bird. Hang out with your friends or play a game of Tag, Hunt or make it up as you go."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Remio", "support_website_url": null, "website_url": "https://remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "sup
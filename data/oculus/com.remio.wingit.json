ingit_Render_1.png", "id": "926297781816389", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982584_926297785149722_4227410942138075850_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PzAdoKHP8PQQ7kNvwEmx42O&_nc_oc=AdpsQMOqG2523AAA_Lu-tsGECW1eS5X3kcx_fJ4X2PC0LmT_Z8mc0clC_yMPap1nJHs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4J5ILf-U9V4oRGvbk_AfTqjgaG84SbXHiNnLU4tSkpvg&oe=6A1C37A6"}, {"file_name": "5.png", "id": "673317157978047", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39001732_673317161311380_6367319820395155286_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HnmFg-9a6tUQ7kNvwF-BD_r&_nc_oc=AdrxM8wPcnTs1Gi1hzjgUrQXxDfquanmK6DkC7zzikofSKyeMjIM32sMYDreFH1RpGw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7N8nBZOqKWvog0_hh68_ZT8EUNm6bmyVQuiCYjcFNbag&oe=6A1C38F3"}, {"file_name": "Screenshot (447).png", "id": "628875279216230", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/57566698_628875282549563_4913645439909033743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wQg7HzkxcMwQ7kNvwGDFc45&_nc_oc=Adqzm42GdBL3JWdHur5LBXxBvPS7S_F-05K12yINrCLnAShvORtyv-bvJM-B0dFkMxY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af77CLPFl0lN-6nkRtrj4UiU4LDkKS7U3LgIZ3Dpe_R0ZA&oe=6A1C2B5B"}, {"file_name": "3.png", "id": "3187958854840290", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974513_3187958858173623_2630061441027911886_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YdUTjmFaJxMQ7kNvwH-sV_6&_nc_oc=AdqNs1ZYMjkrFnnFAq8ul778l2pEfqP39QegQYwIiOVFE3M0T8jNaLsC8lNPjVSw9ZE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7HSIDR6BbWfQksSWbZcJwK-LM56xFIEh8d1yQuZS8u1w&oe=6A1C428F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (4).png", "id": "941214970482404", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031643_941214973815737_2432176783600565336_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=80Prw2SDQkIQ7kNvwHUV_tj&_nc_oc=AdorpKc722S_0FRS7vfC2XKN3S-AKSUZyFT3xcPTzDRFVrn_8z7JxLz7OhOVJw6KWGY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4OdjMaBhsXriV0_pqPiVh-Hmhl1ysx2qpveagzTTiPwA&oe=6A1C4172"}, "display_name": "Wingit", "keywords": [], "long_description": "Unleash Your Inner Bird in Aerial Dogfights and Races.\n\nEver dreamed of soaring through the skies as a majestic bird, engaging in thrilling air-to-air challenges, or participating in high-speed tag races?\n\nWe\u2019ve been developing a unique bird flapping and gliding mechanic that brings this experience to life in our upcoming multiplayer game, currently dubbed \u201cWingit\u201d.\n\nWe\u2019ve created a basic block-out map and implemented an infection game mode for testing purposes. However, we\u2019re eager to explore more game modes and perfect the overall experience.\n\nDepending on how you choose to fly, this game can be quite a lot of exercise :)\n\nWatch the attached video for a glimpse into the heart-pounding action and join our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN", "short_description": "Flap, glide, swoop, dip and flap to soar like a bird. Hang out with your friends or play a game of Tag, Hunt or make it up as you go."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Remio", "support_website_url": null, "website_url": "https://remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "sup
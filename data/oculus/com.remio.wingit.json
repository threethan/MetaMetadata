ingit_Render_1.png", "id": "926297781816389", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982584_926297785149722_4227410942138075850_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZOoCvytB1koQ7kNvwH22i7y&_nc_oc=Adqd1zZrHGB08GFDN8AONTvm84JY2FquHGEbDmBITi4rlTxKZ7MqTFbJU-YSQ9xGmAI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1S8Qd8J1ktXFfqPuePT736BkbQDdBhi0O8nxVIXyixRQ&oe=69F35926"}, {"file_name": "5.png", "id": "673317157978047", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001732_673317161311380_6367319820395155286_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dAmEC4bsszoQ7kNvwGmMGv2&_nc_oc=AdpXv8tF1Z_hzCWhLT6onL79FuUDkraHLCelQ6hu7BRnNKOKXOYd_iEU37TvL7D8-qg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0RiDpI3g_s8BAR4pBMOEthh5eU2M7faeN0R5BXVTcclA&oe=69F35A73"}, {"file_name": "Screenshot (447).png", "id": "628875279216230", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57566698_628875282549563_4913645439909033743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WfYK8PtbuxAQ7kNvwEBBNGh&_nc_oc=Adqvrre54OP0dMd0X18HNrB8IP1rkndOznj8MWpBSpy_oBOIqPkWoPp81a51vgp-ZSM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1_AZaUiRVUeoepoVWUCRthbLc6jPTXEXKNuSNO8BAULw&oe=69F34CDB"}, {"file_name": "3.png", "id": "3187958854840290", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974513_3187958858173623_2630061441027911886_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hH2DEVMXIK0Q7kNvwE0EGsF&_nc_oc=AdpPvkglmmDfR8jz74ch2Iz3z14nytfzATsj5lP2UtIMWWJqhVjtZbD5cJv_ftM813Y&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1hlcIEl4kfAJsgeOVgDsqSmTMuC2Q99naMEDDec2uYsg&oe=69F3640F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (4).png", "id": "941214970482404", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031643_941214973815737_2432176783600565336_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MIBXovuCwcgQ7kNvwFKJQTC&_nc_oc=AdqlJIP4rvUDxc3LbAydPrVfKHD5gY_ldIDcKdauV6Dvh-c1zGj2LVtIfSU_v8Xp0Mc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0EUR_59mEN5ubRaBuEF7X78Aj0RIpkDxupp8AUlUO-bQ&oe=69F362F2"}, "display_name": "Wingit", "keywords": [], "long_description": "Unleash Your Inner Bird in Aerial Dogfights and Races.\n\nEver dreamed of soaring through the skies as a majestic bird, engaging in thrilling air-to-air challenges, or participating in high-speed tag races?\n\nWe\u2019ve been developing a unique bird flapping and gliding mechanic that brings this experience to life in our upcoming multiplayer game, currently dubbed \u201cWingit\u201d.\n\nWe\u2019ve created a basic block-out map and implemented an infection game mode for testing purposes. However, we\u2019re eager to explore more game modes and perfect the overall experience.\n\nDepending on how you choose to fly, this game can be quite a lot of exercise :)\n\nWatch the attached video for a glimpse into the heart-pounding action and join our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN", "short_description": "Flap, glide, swoop, dip and flap to soar like a bird. Hang out with your friends or play a game of Tag, Hunt or make it up as you go."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Remio", "support_website_url": null, "website_url": "https://remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "sup
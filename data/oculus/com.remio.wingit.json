ingit_Render_1.png", "id": "926297781816389", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982584_926297785149722_4227410942138075850_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d9z9acEZGKAQ7kNvwFPXpya&_nc_oc=Ado2WwAdQqg7rkMnXi3eWqd9Jf2aJb1tsOBygQ1Gk0Fpw3eddD7zQ8FcSlhLOVbt8Zo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9lT_bZ5hf1a_zjgMjB1lHh5IagS129flocHB55bLOsxg&oe=6A43C4A6"}, {"file_name": "5.png", "id": "673317157978047", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001732_673317161311380_6367319820395155286_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SwuTgHgBgcMQ7kNvwEaDpHb&_nc_oc=AdoJpQ9-hjbJGKlJASIq4jkg4iq4IBUe5lghDI0Qd4y7dOiM1DA8DUhki_FyVwnqfmk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_tka_u157TOwqgDrciE1YImHAl1ysZxDBFnje-kzHaxw&oe=6A43C5F3"}, {"file_name": "Screenshot (447).png", "id": "628875279216230", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57566698_628875282549563_4913645439909033743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BpXwsaGRAygQ7kNvwGkrrPf&_nc_oc=AdpYRNB2uFm4R-mBnzzlBIfgHC144MoocYV7Q2oW6uwQAT03nmGRvFnKMgsfLIovEYk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af91s899EMF2AemJTC1VpyqcNB3Tjhv_mHHVFh4YSu0Chg&oe=6A43B85B"}, {"file_name": "3.png", "id": "3187958854840290", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974513_3187958858173623_2630061441027911886_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XOljoZLIQYwQ7kNvwHQuT1j&_nc_oc=Adq6xfRD7CVTeQBXeROdTcjZtyHp8K8BVKUnWoWolDzNyU5ZC7dDW3CRIVe7Q3Nufvg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9aN_bNcvz-32JiGID8YOHFzd6QIyHvsAUSzh-nlTfz2g&oe=6A43CF8F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (4).png", "id": "941214970482404", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031643_941214973815737_2432176783600565336_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZNnMBdIrZaYQ7kNvwHqj3se&_nc_oc=AdrGXPv0s4hIH6LkWMni8hzWSpePlu0qod_y_Sevi_6t8Lr8XYz-WvpU-4ww9JRCs2I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-FLkBXc1_w0QDHGlfn-KBpCd_iV23CJd1m7o-x8gXpMg&oe=6A43CE72"}, "display_name": "Wingit", "keywords": [], "long_description": "Unleash Your Inner Bird in Aerial Dogfights and Races.\n\nEver dreamed of soaring through the skies as a majestic bird, engaging in thrilling air-to-air challenges, or participating in high-speed tag races?\n\nWe\u2019ve been developing a unique bird flapping and gliding mechanic that brings this experience to life in our upcoming multiplayer game, currently dubbed \u201cWingit\u201d.\n\nWe\u2019ve created a basic block-out map and implemented an infection game mode for testing purposes. However, we\u2019re eager to explore more game modes and perfect the overall experience.\n\nDepending on how you choose to fly, this game can be quite a lot of exercise :)\n\nWatch the attached video for a glimpse into the heart-pounding action and join our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN", "short_description": "Flap, glide, swoop, dip and flap to soar like a bird. Hang out with your friends or play a game of Tag, Hunt or make it up as you go."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Remio", "support_website_url": null, "website_url": "https://remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "sup
ingit_Render_1.png", "id": "926297781816389", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982584_926297785149722_4227410942138075850_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C_IxSQnKAG0Q7kNvwFvgCzO&_nc_oc=Adoy9mWVSMLYSULyGacLEbkCg-wdMhYRlLsk7N8sUB_KQrkNu3F_qsuNYBOsUsJyIPM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6HFlpvKi1dPKp3KBWQALSMwvzybbEoUluWXv-SDBcypw&oe=6A0B1426"}, {"file_name": "5.png", "id": "673317157978047", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001732_673317161311380_6367319820395155286_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=20pOhnUfN20Q7kNvwGVtes3&_nc_oc=AdoD2CpvkZu-uYQLeUveIrNEglBeM495PIK4yasD0jdIriLZ2cIh78hBDmIhcjJMqes&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af46L3SPydPzHO1pTuDDabPi3IfZWvgQmKGkeKpE670fOg&oe=6A0B1573"}, {"file_name": "Screenshot (447).png", "id": "628875279216230", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57566698_628875282549563_4913645439909033743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ID3ZHUhxyJ0Q7kNvwEoSrSM&_nc_oc=Adp-Z37AfcQB6Civ1HCIxnSCqhxNZf5OHtxs5Eg38Ce5uRqVFkNrc8d1fVnmbaHN9Aw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7uhoA2D3pWVUMaQ9xuRMcB1HuvUv19V6uav9OOjoq2iQ&oe=6A0B07DB"}, {"file_name": "3.png", "id": "3187958854840290", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974513_3187958858173623_2630061441027911886_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FtNw_BDDccwQ7kNvwFwropH&_nc_oc=AdrfsWa6goLC-i7yx26qhUP7JWUei_i2MYFbKb6gtbxqMuonBWFev1n7yEnRrjDQ6go&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6AzvnpIrAWOfZSYekfZxBme1QYgRMYQJpfEFdzK4CCWw&oe=6A0B1F0F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (4).png", "id": "941214970482404", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031643_941214973815737_2432176783600565336_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HR947HFFKCcQ7kNvwENkF-y&_nc_oc=AdoGaPh_RTcYnjYDIapjJ9tFpmID-yFr4HBHRJMnF3-wnVTcHra4B4hr5fShd3rK9OQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af59giqiDTohZh1ex0BuEQL5t4G84TEv-WGV4ZG27aZDEw&oe=6A0B1DF2"}, "display_name": "Wingit", "keywords": [], "long_description": "Unleash Your Inner Bird in Aerial Dogfights and Races.\n\nEver dreamed of soaring through the skies as a majestic bird, engaging in thrilling air-to-air challenges, or participating in high-speed tag races?\n\nWe\u2019ve been developing a unique bird flapping and gliding mechanic that brings this experience to life in our upcoming multiplayer game, currently dubbed \u201cWingit\u201d.\n\nWe\u2019ve created a basic block-out map and implemented an infection game mode for testing purposes. However, we\u2019re eager to explore more game modes and perfect the overall experience.\n\nDepending on how you choose to fly, this game can be quite a lot of exercise :)\n\nWatch the attached video for a glimpse into the heart-pounding action and join our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN", "short_description": "Flap, glide, swoop, dip and flap to soar like a bird. Hang out with your friends or play a game of Tag, Hunt or make it up as you go."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Remio", "support_website_url": null, "website_url": "https://remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "sup
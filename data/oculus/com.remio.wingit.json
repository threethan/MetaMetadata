5/38982584_926297785149722_4227410942138075850_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F4kZcwEQCdwQ7kNvwH7YAhA&_nc_oc=AdmrIBVHS9iWaNle4XqLnzk3V0Tf81J-VeTG19uHeBvaoqEwNbwLJSTOLH7-fveCTWk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv9KsDT8rpoqog2E6MlaJ26-ySPMdvF1kq3TJ0MK3G64g&oe=699DA7A6"}, {"file_name": "5.png", "id": "673317157978047", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001732_673317161311380_6367319820395155286_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b6zDWkNafEEQ7kNvwGnGjEB&_nc_oc=Adm1mfA797oBKDE2vk5ze-rEhm6ZXKHAWrZeqImlzFKxWpW5IVggh1hgaAekjjjoVXE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvmvEaus4Du-pavyCqzxOh5OImRzyXMflHVdXVM8o1K3Q&oe=699DA8F3"}, {"file_name": "Screenshot (447).png", "id": "628875279216230", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566698_628875282549563_4913645439909033743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ue7gGYAXdAkQ7kNvwFdyZfI&_nc_oc=AdlwQN3zPAu1W2nFXw-OeBD5Tp517iO-wV56TrjCXAyKFVLbUnLPqVdznhVd-co6jIE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftk75QCVGcZlLy5bGoVXonVjmZC8UikIfjLOIV1hdYAGw&oe=699D9B5B"}, {"file_name": "3.png", "id": "3187958854840290", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974513_3187958858173623_2630061441027911886_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DfJYcWykla0Q7kNvwG-yVDy&_nc_oc=Adl4Z73z-M0AQ4cGfJko21nzj6bxxo-wmAjFj0N5GFfqA8EtjpdeDTHMo8ZogYuR6-E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvEzi1FZIOeCt98a2x22H_Awy726jl87LLg8FrufQezMA&oe=699DB28F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (4).png", "id": "941214970482404", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031643_941214973815737_2432176783600565336_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RmymLQO2CIoQ7kNvwGizR-4&_nc_oc=AdmUA48eRfkmZKtPFkFcm6J9XAyDGeSl6aLNL271VmIIYS_wH_4RMisugyo1P7t_q_0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuT5g6LRbttVdWSlHoQGmWdHb90J0CSE7Qw5cCbd0p7OA&oe=699DB172"}, "display_name": "Wingit", "keywords": [], "long_description": "Unleash Your Inner Bird in Aerial Dogfights and Races.\n\nEver dreamed of soaring through the skies as a majestic bird, engaging in thrilling air-to-air challenges, or participating in high-speed tag races?\n\nWe\u2019ve been developing a unique bird flapping and gliding mechanic that brings this experience to life in our upcoming multiplayer game, currently dubbed \u201cWingit\u201d.\n\nWe\u2019ve created a basic block-out map and implemented an infection game mode for testing purposes. However, we\u2019re eager to explore more game modes and perfect the overall experience.\n\nDepending on how you choose to fly, this game can be quite a lot of exercise :)\n\nWatch the attached video for a glimpse into the heart-pounding action and join our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN", "short_description": "Flap, glide, swoop, dip and flap to soar like a bird. Hang out with your friends or play a game of Tag, Hunt or make it up as you go."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Remio", "support_website_url": null, "website_url": "https://remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_
ingit_Render_1.png", "id": "926297781816389", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982584_926297785149722_4227410942138075850_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YwpKAfHp_74Q7kNvwFSWH5h&_nc_oc=AdodaAxyTCWhOWQ2m3z7Iu9EWNFBfYNwG3VKH5Hdu-SPEdiW0OPDicDNQzUsHLVovIo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA6YBy3Mn0wTAeh30-qEaGjv-ivMlQHnTr0lTUcWhaioA&oe=6A64BA26"}, {"file_name": "5.png", "id": "673317157978047", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001732_673317161311380_6367319820395155286_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vNICrrmrjqAQ7kNvwE5mdQG&_nc_oc=AdqqDwybj64eVwPqZyq7BwQRnzKpdtSAxrxtOeQwOT0ZVzjXh06tEK-nN6S1r0ilQZA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC43ATYNtRB2mMlmndjdRgpsonNTMoIXosSvDb5r_v01w&oe=6A64BB73"}, {"file_name": "Screenshot (447).png", "id": "628875279216230", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566698_628875282549563_4913645439909033743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F7Fc1IcPYy8Q7kNvwERmQwa&_nc_oc=Adq9fVr8cgfMlhA67p9cMj10Q_a4s4hUNEpRDlJGIfGIdY5GryyJVzf9n59D7DqmVPs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDdWNJAE3e4TBLMFyM6NyynPjW8PCxvEEqRUfyMd7wzIg&oe=6A64ADDB"}, {"file_name": "3.png", "id": "3187958854840290", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974513_3187958858173623_2630061441027911886_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oYNjuWHmfEoQ7kNvwFldPqC&_nc_oc=AdqHngPwCkm6VMvDUDn7pOk1M6UqTKzrAoNOyi7YbbDBVds1waRM4tJNq3xuwS-C3uE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCOkhwmtJY32tQYNgI5eFOqf9GGb2TR2VvBU6mcXr2EXQ&oe=6A64C50F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (4).png", "id": "941214970482404", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031643_941214973815737_2432176783600565336_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=74lAlkCCEzAQ7kNvwG9CciV&_nc_oc=AdpW2bGnhduCyXXKhlrDXKIHzlaoVRKyLE_TexT6R_inDTg24VDWwaavhlyw1xjsUtk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAxNqUpWNdSSQkAXcE4CJPvos4P7d1u4K5F3z9Jcia1qw&oe=6A64C3F2"}, "display_name": "Wingit", "keywords": [], "long_description": "Unleash Your Inner Bird in Aerial Dogfights and Races.\n\nEver dreamed of soaring through the skies as a majestic bird, engaging in thrilling air-to-air challenges, or participating in high-speed tag races?\n\nWe\u2019ve been developing a unique bird flapping and gliding mechanic that brings this experience to life in our upcoming multiplayer game, currently dubbed \u201cWingit\u201d.\n\nWe\u2019ve created a basic block-out map and implemented an infection game mode for testing purposes. However, we\u2019re eager to explore more game modes and perfect the overall experience.\n\nDepending on how you choose to fly, this game can be quite a lot of exercise :)\n\nWatch the attached video for a glimpse into the heart-pounding action and join our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN", "short_description": "Flap, glide, swoop, dip and flap to soar like a bird. Hang out with your friends or play a game of Tag, Hunt or make it up as you go."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Remio", "support_website_url": null, "website_url": "https://remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "sup
ingit_Render_1.png", "id": "926297781816389", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982584_926297785149722_4227410942138075850_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G45ifsuCICIQ7kNvwF3ncHS&_nc_oc=AdoTuwivOOqIBYfvhWWQVwuDR8MHpIh_2-5XCT4e8LGUMBHqe_AnGWjkCRTy7tCH5oo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAdlPGnYD1L6TRTvylLa5cr0LVgJkAmsCdG-s9JG_lGTg&oe=6A58DCA6"}, {"file_name": "5.png", "id": "673317157978047", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39001732_673317161311380_6367319820395155286_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KJYL_MnrDEQQ7kNvwH_Rxmt&_nc_oc=Adp3d_0YMwA4afmbDRL2uQgoCre4p6-1HXEZUo9vMG0wZ4U41BkiKSiJDAkbnLuEBEQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCU003orIsmeC92ioMaq10hXtMnRF0Gw58vrdcGpwez6g&oe=6A58DDF3"}, {"file_name": "Screenshot (447).png", "id": "628875279216230", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/57566698_628875282549563_4913645439909033743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CyyL275weUEQ7kNvwE-7atM&_nc_oc=Adq6Mfv1bjig2ynnWAGmUu3I7uMaGVuH62NWqNjpvVFQgwQVUoJn_6pSqdF2S4j5CjA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAWw4zJ1531TwS-BjAWsa8kIr-IHTo9nxL9hn9I6g5Lkg&oe=6A58D05B"}, {"file_name": "3.png", "id": "3187958854840290", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974513_3187958858173623_2630061441027911886_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nn1n0FtNmjIQ7kNvwFdku3e&_nc_oc=AdogDl6cUB4mdfvZR6dytyusnRQxj1fpuiFmX92d3zBvXSTR34uLDWE2PWh47LG9HOM&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCDRB666-jeoeH1pZHW3S-DRCxCWnMMVTML3DWvqBfNfw&oe=6A58E78F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (4).png", "id": "941214970482404", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031643_941214973815737_2432176783600565336_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qc6abJmPolMQ7kNvwF3OKj0&_nc_oc=AdosxElhE_pnz93l56Mp9OOMbHD4CGoand8EEWw3kcEX8WJbR0cmf3bIqzosTHqqtSA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDOLp4xF5aYYHLNvwFxEipDdSb0Qy5X-uSGMHAt5AtyPA&oe=6A58E672"}, "display_name": "Wingit", "keywords": [], "long_description": "Unleash Your Inner Bird in Aerial Dogfights and Races.\n\nEver dreamed of soaring through the skies as a majestic bird, engaging in thrilling air-to-air challenges, or participating in high-speed tag races?\n\nWe\u2019ve been developing a unique bird flapping and gliding mechanic that brings this experience to life in our upcoming multiplayer game, currently dubbed \u201cWingit\u201d.\n\nWe\u2019ve created a basic block-out map and implemented an infection game mode for testing purposes. However, we\u2019re eager to explore more game modes and perfect the overall experience.\n\nDepending on how you choose to fly, this game can be quite a lot of exercise :)\n\nWatch the attached video for a glimpse into the heart-pounding action and join our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN", "short_description": "Flap, glide, swoop, dip and flap to soar like a bird. Hang out with your friends or play a game of Tag, Hunt or make it up as you go."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Remio", "support_website_url": null, "website_url": "https://remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "sup
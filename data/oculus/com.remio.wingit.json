ingit_Render_1.png", "id": "926297781816389", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982584_926297785149722_4227410942138075850_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jJHyewtE870Q7kNvwE64KVH&_nc_oc=AdqblOumsYOET19zU784xDXkTHXbQpquKGTo4njCBYX1bZLRoa_ns60Wip-XR1eK3FM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5emNubGH2-TWTGizGVilcqMg7gYhfB91l357buDc15_g&oe=6A144EA6"}, {"file_name": "5.png", "id": "673317157978047", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001732_673317161311380_6367319820395155286_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tF4pibJUpp0Q7kNvwHwtvJb&_nc_oc=Ado5O3J2_8OCRXnkeo3SxbrFMMpuSfloStv8-QQ9wM8g889adTSuJ2QaQC6X4hQlCNU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7knfJEGbbb843OuS-hhcbkbq6FlMyAWRNU6Kb65UuHIQ&oe=6A144FF3"}, {"file_name": "Screenshot (447).png", "id": "628875279216230", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57566698_628875282549563_4913645439909033743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w9prNjtb9SgQ7kNvwFQa1Ev&_nc_oc=AdpGIEiXOy5tEN5n9zuxv5m_N9x9TeFES51j8Y_b-zHi0nLxSeoFgGcIicL5GdvuzOE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4K2Gb-tzbM28NBwT5V9SvDmuaJDMhGkMlGxHhIERyd3Q&oe=6A14425B"}, {"file_name": "3.png", "id": "3187958854840290", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974513_3187958858173623_2630061441027911886_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AWdYc7p50FsQ7kNvwEmtGLl&_nc_oc=Adr0QCgkEeXu7YXRDr_Lpbp_31WNKM_NJRjnSfQwJ9mBfivC9yrgy3_xYt1lJMiHb0Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5XZBfHOAmmi6iVObiS2Vqi9Jo2hBqmN7e3dM6D1VkNeQ&oe=6A14598F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (4).png", "id": "941214970482404", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031643_941214973815737_2432176783600565336_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c_UCTrt9d2UQ7kNvwFxm3Uv&_nc_oc=AdrmJAMGrQxA1qGlQgHK3YVkQk9PXC2goubwwRAXkdXbp6PBtyja4_WuhVqKQGNOaCY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4TtATklp9k7y5Vc_D3a4OmH8-WNYicBySF0bC2p_IzZw&oe=6A145872"}, "display_name": "Wingit", "keywords": [], "long_description": "Unleash Your Inner Bird in Aerial Dogfights and Races.\n\nEver dreamed of soaring through the skies as a majestic bird, engaging in thrilling air-to-air challenges, or participating in high-speed tag races?\n\nWe\u2019ve been developing a unique bird flapping and gliding mechanic that brings this experience to life in our upcoming multiplayer game, currently dubbed \u201cWingit\u201d.\n\nWe\u2019ve created a basic block-out map and implemented an infection game mode for testing purposes. However, we\u2019re eager to explore more game modes and perfect the overall experience.\n\nDepending on how you choose to fly, this game can be quite a lot of exercise :)\n\nWatch the attached video for a glimpse into the heart-pounding action and join our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN", "short_description": "Flap, glide, swoop, dip and flap to soar like a bird. Hang out with your friends or play a game of Tag, Hunt or make it up as you go."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Remio", "support_website_url": null, "website_url": "https://remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "sup
ingit_Render_1.png", "id": "926297781816389", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982584_926297785149722_4227410942138075850_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0eRcqAatFzQQ7kNvwG4CWo5&_nc_oc=Adq4MDhBPCh_9vckLzK56EfYeN7WkYL6nECzc8VNhvsHCuYHl6EuwcTEN0sSk-mjclA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2qNUbDvCG1IJp3OE91WL3c4L556peiRCnCrcArQrlvlQ&oe=69EB7026"}, {"file_name": "5.png", "id": "673317157978047", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001732_673317161311380_6367319820395155286_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RAuV1pEnCL8Q7kNvwGgsQu-&_nc_oc=AdrD2UAwh4D1MiHjDPsyYbCzRgV09CZtVdH_GUsvEokINB06-hhYsMbivZmVz1Br5Sw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af08IRpnstTzntpTWXFeWqh_C82D1nQxP4LF5s_ab1LSZA&oe=69EB7173"}, {"file_name": "Screenshot (447).png", "id": "628875279216230", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57566698_628875282549563_4913645439909033743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eoYS2k-pQ8AQ7kNvwHU4pq2&_nc_oc=Adr7cmgbJYF6Ca5DCZ7C8OLvrgumUOHb8u2xOlJYjO5GeEg6r_xXQ8LWozNqfQqYpcg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2mRTzT2IaJ8QDBvIq7PzcGgPvfGydUfczVXoiXHkRVyw&oe=69EB63DB"}, {"file_name": "3.png", "id": "3187958854840290", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974513_3187958858173623_2630061441027911886_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U_8c1BiL90UQ7kNvwELQ0nE&_nc_oc=AdrkOM_eo4ctvaPr1Gev5XCIZ4DAXL0sS9BV10sXfI9QuZ7FnkRJsShYK8fCQUo6Ulc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1IWUPkotzEt-5bcnDDCnHFeMyHkaM2et8mhGu4U-W28w&oe=69EB7B0F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (4).png", "id": "941214970482404", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031643_941214973815737_2432176783600565336_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KR71UxGisgkQ7kNvwEQB6sr&_nc_oc=AdouBvhxyx8CQ_sfQ8WOX0tEb7cEdx8dD89QkYUg8f7YWoAKMtMDot39IgmCJxuveUU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2oIe_GZonNdkhgiGTKB3X8Of20bcGflhorMubN6sxHoQ&oe=69EB79F2"}, "display_name": "Wingit", "keywords": [], "long_description": "Unleash Your Inner Bird in Aerial Dogfights and Races.\n\nEver dreamed of soaring through the skies as a majestic bird, engaging in thrilling air-to-air challenges, or participating in high-speed tag races?\n\nWe\u2019ve been developing a unique bird flapping and gliding mechanic that brings this experience to life in our upcoming multiplayer game, currently dubbed \u201cWingit\u201d.\n\nWe\u2019ve created a basic block-out map and implemented an infection game mode for testing purposes. However, we\u2019re eager to explore more game modes and perfect the overall experience.\n\nDepending on how you choose to fly, this game can be quite a lot of exercise :)\n\nWatch the attached video for a glimpse into the heart-pounding action and join our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN", "short_description": "Flap, glide, swoop, dip and flap to soar like a bird. Hang out with your friends or play a game of Tag, Hunt or make it up as you go."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Remio", "support_website_url": null, "website_url": "https://remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "sup
ingit_Render_1.png", "id": "926297781816389", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982584_926297785149722_4227410942138075850_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=euF2Pdzy8ToQ7kNvwEHagVD&_nc_oc=AdrD0xjIdliehMjG4KLuVv2z-KVK_i2QOpC3Y-gkTHS_2za3J3JkisuLk8tBKGEQSNg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1LOtPm6ly5uMq7y-hqlArVrBUSaG--y-Vdtwro7-Leng&oe=69DA4CA6"}, {"file_name": "5.png", "id": "673317157978047", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001732_673317161311380_6367319820395155286_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pgkdo6b-IqYQ7kNvwHkHeVA&_nc_oc=Adphn2xO5ghMib4wI3XFpNxFe9Y6MdttsLXUds9NBuhrMNg0npAVkjuPJ80Mt17_6jE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0u8O18Hx5kZ7SH8NGgUPFtMHTlrRthFX-ly2_2pmus-A&oe=69DA4DF3"}, {"file_name": "Screenshot (447).png", "id": "628875279216230", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57566698_628875282549563_4913645439909033743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lWamp77IZCYQ7kNvwHmskzH&_nc_oc=Adr_rgydstolpaDe9YoRh7a6Q23nyf1tGw4DrYQKcKWPUPuJDiuY61bfXAAijOZ9RS8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ncwzhy0qCSPuUVYlI-zgZQJ-zFfDFx2NUpHmrNYWYTg&oe=69DA405B"}, {"file_name": "3.png", "id": "3187958854840290", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974513_3187958858173623_2630061441027911886_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V4pJF7coGCAQ7kNvwF3Dtmw&_nc_oc=Adpd_aC55nFtcZliKspf6hhedqLywvycXn4Gi72kW7X-op8uDaBpCzbq9tUlezpEpQ0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af08BDvi-CbGyDrs-SHyu91cr9SRQJRdG5z_TB9jytdoMw&oe=69DA578F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (4).png", "id": "941214970482404", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031643_941214973815737_2432176783600565336_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ANVdY9Fw3zIQ7kNvwEDw6m4&_nc_oc=AdpPNf-Bfus5cK4VXwBtC0SnhHLizBptxzg17H-DGiRpRi4XCeTgTZoSBAF1a1soaco&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3laXQkPmJ0D3LF0nNQZaCHpxHDifplCK7j5liZN7KJtw&oe=69DA5672"}, "display_name": "Wingit", "keywords": [], "long_description": "Unleash Your Inner Bird in Aerial Dogfights and Races.\n\nEver dreamed of soaring through the skies as a majestic bird, engaging in thrilling air-to-air challenges, or participating in high-speed tag races?\n\nWe\u2019ve been developing a unique bird flapping and gliding mechanic that brings this experience to life in our upcoming multiplayer game, currently dubbed \u201cWingit\u201d.\n\nWe\u2019ve created a basic block-out map and implemented an infection game mode for testing purposes. However, we\u2019re eager to explore more game modes and perfect the overall experience.\n\nDepending on how you choose to fly, this game can be quite a lot of exercise :)\n\nWatch the attached video for a glimpse into the heart-pounding action and join our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN", "short_description": "Flap, glide, swoop, dip and flap to soar like a bird. Hang out with your friends or play a game of Tag, Hunt or make it up as you go."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Remio", "support_website_url": null, "website_url": "https://remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "sup
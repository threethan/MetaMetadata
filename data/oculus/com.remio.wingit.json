ingit_Render_1.png", "id": "926297781816389", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982584_926297785149722_4227410942138075850_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hcBECDnjpZMQ7kNvwGcaAnr&_nc_oc=AdpJfMUYwN-hRZLYHx9TXzPKdukgi7kuSVdBeQg8u9pwFe4y0PF5tpEWcZ2e577YLcA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3k5jDd2KMMeA-KJrny-VW3dvoAMP6DMkhHERx7fVcMNg&oe=69EA1EA6"}, {"file_name": "5.png", "id": "673317157978047", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001732_673317161311380_6367319820395155286_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iuu0dEQLrj8Q7kNvwFgBakw&_nc_oc=AdpPcWy0QCORmRwi0DmyjAwYsqgoX_jO5B7DtSgWxgkE3L5LS8x3pYNNzh-6kfkYZ6k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3yMFJBjfO_B9PFWwddtpE5JcdrxZ7O8l-Fr7MAjQLiYQ&oe=69EA1FF3"}, {"file_name": "Screenshot (447).png", "id": "628875279216230", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57566698_628875282549563_4913645439909033743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Je_8F2Y5uH8Q7kNvwEXQF99&_nc_oc=Adq_WqSJsVWUuqcMuCIwIVTcexdq8ESXiN_29ekYY4-zBLKFHDJtc4-8TCNrgXg8lJ4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3bsxUjARDbdgA2KdLjXop6rBG9o8xxqFFukzn1S5SBvw&oe=69EA125B"}, {"file_name": "3.png", "id": "3187958854840290", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974513_3187958858173623_2630061441027911886_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U_8c1BiL90UQ7kNvwHie01_&_nc_oc=AdqNq7Jzr0SgT4UvKRROiDbzRUppPLQEbKk5tr8oaakVMqfT_8LHyEjJzcEZsCA2PTw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2nW0zkWPaPNtP9E3-N1ZlVO7XVMr3P3YGmp5tQo3Aa4w&oe=69EA298F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (4).png", "id": "941214970482404", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031643_941214973815737_2432176783600565336_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KR71UxGisgkQ7kNvwHkjPnP&_nc_oc=Adr0Ct4bkJYH1CYK8YaWakPcL2pIwMXnWWvW1vMtOGXkejUH09DI_Q01UCH3pKnWUCc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3WTq14nc-OXGa8eiBbK1USjjHrzAcjASSsv-sG4OA2Cg&oe=69EA2872"}, "display_name": "Wingit", "keywords": [], "long_description": "Unleash Your Inner Bird in Aerial Dogfights and Races.\n\nEver dreamed of soaring through the skies as a majestic bird, engaging in thrilling air-to-air challenges, or participating in high-speed tag races?\n\nWe\u2019ve been developing a unique bird flapping and gliding mechanic that brings this experience to life in our upcoming multiplayer game, currently dubbed \u201cWingit\u201d.\n\nWe\u2019ve created a basic block-out map and implemented an infection game mode for testing purposes. However, we\u2019re eager to explore more game modes and perfect the overall experience.\n\nDepending on how you choose to fly, this game can be quite a lot of exercise :)\n\nWatch the attached video for a glimpse into the heart-pounding action and join our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN", "short_description": "Flap, glide, swoop, dip and flap to soar like a bird. Hang out with your friends or play a game of Tag, Hunt or make it up as you go."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Remio", "support_website_url": null, "website_url": "https://remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "sup
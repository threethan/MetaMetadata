ingit_Render_1.png", "id": "926297781816389", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982584_926297785149722_4227410942138075850_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ABONxAJiGUQ7kNvwFVLtpJ&_nc_oc=AdrZnhZ3Vqr0DXCrksc0R1qGzhUS6WcYc6a8-cGocMEbecrejZjCyZBKWkGloDDjS3U&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxxhaVBl8DSPcADG_G8uRlMRaXpltwwTy9IZkcwV_w_sg&oe=69C3E326"}, {"file_name": "5.png", "id": "673317157978047", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001732_673317161311380_6367319820395155286_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a2ijU7-GkfQQ7kNvwHoZ5Bp&_nc_oc=Adr_xtkG5yQGXEO5PfY9FULq24ltJEHjEhqaxJubp4AY3BbVXZu_f7BLjZrPCI8fzaU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxyjDi6viM4gySl18J_Nwv_uw68BSB6oJ2oeBPA_clIFA&oe=69C3E473"}, {"file_name": "Screenshot (447).png", "id": "628875279216230", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57566698_628875282549563_4913645439909033743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yl9F7GM2HigQ7kNvwEJE-by&_nc_oc=Adp860aaX2wDEMqsJcIGJtkVdzn4eIit3kSwUDUIpbRUu6_IL2RaczYM6D9RZeN4i-M&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzyK4_cfg6gKW2Es3BnO3kF120-_1815kbnu4bkw1yZ7Q&oe=69C3D6DB"}, {"file_name": "3.png", "id": "3187958854840290", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974513_3187958858173623_2630061441027911886_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ynBKFERdwgkQ7kNvwFM0j9F&_nc_oc=Adow28rrVzZvAgnthRe9ItERi3zdebqZKu0lIRciijJg1gaJJwj1n5OBWygIPuZ3ZkA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx-9f4ozRc0ugSt_y__PsAipsCbH0GZ2Tc3Tm9Zs_x4FQ&oe=69C3EE0F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (4).png", "id": "941214970482404", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031643_941214973815737_2432176783600565336_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ghG_Sy9XFPYQ7kNvwFSJnmu&_nc_oc=AdozpfRbDZ57NAwGOXQGqDuluh7WAm1U12xV63_dXj1NeGdghGweo6DyvY45_MynIwY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwsNP5VsGlYY60yDy_z-Eps_FFL0LxWH2J-QJMA1MnaIA&oe=69C3ECF2"}, "display_name": "Wingit", "keywords": [], "long_description": "Unleash Your Inner Bird in Aerial Dogfights and Races.\n\nEver dreamed of soaring through the skies as a majestic bird, engaging in thrilling air-to-air challenges, or participating in high-speed tag races?\n\nWe\u2019ve been developing a unique bird flapping and gliding mechanic that brings this experience to life in our upcoming multiplayer game, currently dubbed \u201cWingit\u201d.\n\nWe\u2019ve created a basic block-out map and implemented an infection game mode for testing purposes. However, we\u2019re eager to explore more game modes and perfect the overall experience.\n\nDepending on how you choose to fly, this game can be quite a lot of exercise :)\n\nWatch the attached video for a glimpse into the heart-pounding action and join our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN", "short_description": "Flap, glide, swoop, dip and flap to soar like a bird. Hang out with your friends or play a game of Tag, Hunt or make it up as you go."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Remio", "support_website_url": null, "website_url": "https://remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "sup
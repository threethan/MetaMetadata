97781816389", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982584_926297785149722_4227410942138075850_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EtInpiOvNOAQ7kNvwFAAkxH&_nc_oc=Adl7Fk_-3yae9ch_BTnKSvBU9Q9wadZKSNAp9lTyZIqU6EKAfS_ab6-l1ZFVRGmebUU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxirCy6VI1mFJraNIFoqumsN0nvIFgGqfUs8uGVEddiYg&oe=69B41126"}, {"file_name": "5.png", "id": "673317157978047", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001732_673317161311380_6367319820395155286_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mbpNjLQPbKoQ7kNvwFUumFy&_nc_oc=Adl5jl68kbvNDAK3D1qndVp5-5G_YHepkGO8SwMo6xlNgFD86fFJQM6y0oHwAcuKZuA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfximQQQ-1fg_cVq9YO4s6lPi_xz5VwQLt1bjeOwx04PoQ&oe=69B41273"}, {"file_name": "Screenshot (447).png", "id": "628875279216230", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57566698_628875282549563_4913645439909033743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dPr8iPjUDR0Q7kNvwFUMarR&_nc_oc=Adk_3-dzFR9xOZpqy9APKYhwWPhgbrqCaJ1q-hnbd06WclvPkfwlXQmoZO2gMyi4Rs0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxlvjzxaGf7m_y0Z5D_tsHFyFIuqLxVmMeHln8VgVDMfQ&oe=69B404DB"}, {"file_name": "3.png", "id": "3187958854840290", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974513_3187958858173623_2630061441027911886_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h4ONV3Ocl2YQ7kNvwHecttB&_nc_oc=AdnhsmR4HlSn7V5esnFB0w9-SiMungq2jxt6ui1Np9jwMtSRa6uSAa3vOa9VoUjCoNs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy_NcR7BImM5d6Bko9tTeNfdSzqteQCqa2-4Wzas6c6iQ&oe=69B41C0F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (4).png", "id": "941214970482404", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031643_941214973815737_2432176783600565336_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QqTPit-kAZkQ7kNvwEvFixD&_nc_oc=AdlHcgwPFF_U5aQLzwnTGkcOMkBqbJajp10rK8vsKAg95COFO5Im9zNRBhweWqU9od0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy0ik-7W7EbGdktNK3dhDq-uIl54A4eScia2o9ZYrJY1Q&oe=69B41AF2"}, "display_name": "Wingit", "keywords": [], "long_description": "Unleash Your Inner Bird in Aerial Dogfights and Races.\n\nEver dreamed of soaring through the skies as a majestic bird, engaging in thrilling air-to-air challenges, or participating in high-speed tag races?\n\nWe\u2019ve been developing a unique bird flapping and gliding mechanic that brings this experience to life in our upcoming multiplayer game, currently dubbed \u201cWingit\u201d.\n\nWe\u2019ve created a basic block-out map and implemented an infection game mode for testing purposes. However, we\u2019re eager to explore more game modes and perfect the overall experience.\n\nDepending on how you choose to fly, this game can be quite a lot of exercise :)\n\nWatch the attached video for a glimpse into the heart-pounding action and join our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN", "short_description": "Flap, glide, swoop, dip and flap to soar like a bird. Hang out with your friends or play a game of Tag, Hunt or make it up as you go."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Remio", "support_website_url": null, "website_url": "https://remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_d
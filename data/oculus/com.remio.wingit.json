ingit_Render_1.png", "id": "926297781816389", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982584_926297785149722_4227410942138075850_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XT4RAM3NCHEQ7kNvwHwYnTf&_nc_oc=Adp6-9UMkBmz8JAFassQ-jbTcS6bPiDLTzgNF4FZoEg0ep_ktQgV7QQ3gPEDQ3eSMj4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBzXLMhi7OYBThOReJwlYB4p6pq4E62fmC85Q5gp3O6MQ&oe=6A4FA226"}, {"file_name": "5.png", "id": "673317157978047", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001732_673317161311380_6367319820395155286_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IOzkYz4P1gsQ7kNvwGs4fEo&_nc_oc=AdqNQ7uH4UmytlmYCKJ3mfARS6LsEN9IDSlw020gY-JJ3qX5d5LiNcP4azNSBiYi4zM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-Xydo4x4g4nhIoTge9bRYmE96Csb1dvVeS0Rdgg8rJQ&oe=6A4FA373"}, {"file_name": "Screenshot (447).png", "id": "628875279216230", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566698_628875282549563_4913645439909033743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EIBYtgYUtkUQ7kNvwHHB_g6&_nc_oc=Adr5FlOxeekbxJ-XU6wOTzSIWYNeN7gsvdTJHCrKav9ZPLV-m215Lfq11e8MC5ELrZs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBGbnsMuws7btdxvEyRKHyaD81XM0rTXjReP2QrV43shQ&oe=6A4F95DB"}, {"file_name": "3.png", "id": "3187958854840290", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974513_3187958858173623_2630061441027911886_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LfvEgCu5hOEQ7kNvwF4daL_&_nc_oc=AdoWjrlB0fU2AhktYHRQ9rtiTMvnkj1M9IE9Ths2OgXiLEAZ-2dLvmaZgb_h2PdozJE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8Q4vrL6XMaBTmARrFwaWznp0DzcGSPL3RPEcU1_LgOA&oe=6A4FAD0F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (4).png", "id": "941214970482404", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031643_941214973815737_2432176783600565336_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8AiXAGOcLD8Q7kNvwFcM5eL&_nc_oc=AdryZwT795BiY9LhKdULt50EsR-yIBUXtoO6ZCGWmU8KO85GPqqS2z9kgV2LJ2cB-SM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAjFSp-7Q8hk224YoPy7sRrsuvADJQauNqhq_DVGh6SYg&oe=6A4FABF2"}, "display_name": "Wingit", "keywords": [], "long_description": "Unleash Your Inner Bird in Aerial Dogfights and Races.\n\nEver dreamed of soaring through the skies as a majestic bird, engaging in thrilling air-to-air challenges, or participating in high-speed tag races?\n\nWe\u2019ve been developing a unique bird flapping and gliding mechanic that brings this experience to life in our upcoming multiplayer game, currently dubbed \u201cWingit\u201d.\n\nWe\u2019ve created a basic block-out map and implemented an infection game mode for testing purposes. However, we\u2019re eager to explore more game modes and perfect the overall experience.\n\nDepending on how you choose to fly, this game can be quite a lot of exercise :)\n\nWatch the attached video for a glimpse into the heart-pounding action and join our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN", "short_description": "Flap, glide, swoop, dip and flap to soar like a bird. Hang out with your friends or play a game of Tag, Hunt or make it up as you go."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Remio", "support_website_url": null, "website_url": "https://remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "sup
ingit_Render_1.png", "id": "926297781816389", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982584_926297785149722_4227410942138075850_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7epz-6zqjwgQ7kNvwHHUIow&_nc_oc=AdpsvGKZJZa_SKu5zYz3S6meJAn0eKyUgoaUflyRquOjbBi_QHaoI9yOeLkdZvmGSfo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81CN7-aRvlwqzVqlkdmOchoHmBaGlj5LGqLuhwl8pz9A&oe=6A2C09A6"}, {"file_name": "5.png", "id": "673317157978047", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39001732_673317161311380_6367319820395155286_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PGhFf69hn4IQ7kNvwF2qsyZ&_nc_oc=Adoy-eqT3T3VY-F_ap_vC80xE9Qn0Ns52f5RS2sL1Lh44sEcIY6UvFnd7peWKMmP7Hc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_xz-xPeuE_Bbn1GCYQjJ2b44zr1q5x9oUPQQP3i8KGRQ&oe=6A2C0AF3"}, {"file_name": "Screenshot (447).png", "id": "628875279216230", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/57566698_628875282549563_4913645439909033743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8M421RPwn38Q7kNvwFxqYxJ&_nc_oc=AdpunNsNDGIDU186SVwjMoE7a6BK_zthjeNvrUbEGndczZg56dh3i1Udd8PWf7covIc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-dT7i_wAMxdLj_LFGGcyNUk05QnN5WssqZx8wOgwgVeQ&oe=6A2BFD5B"}, {"file_name": "3.png", "id": "3187958854840290", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974513_3187958858173623_2630061441027911886_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ECnyXoYvu3kQ7kNvwEJZfuT&_nc_oc=Adpvs_w3UEYAtGC6J4EW0jL-KAPjfFfZ73FMmwnPrw0HqcOO6USYR0oUjoIoKCA6148&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-GY5msUa1-Ofu_5F4OC8z0XWNLTmVENlI8lyLDDCWAuw&oe=6A2C148F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (4).png", "id": "941214970482404", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031643_941214973815737_2432176783600565336_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2e4Mc1fgtLYQ7kNvwGQTfVW&_nc_oc=AdrDKSRs7hLu6aM0RLT7QphaZZ5A4gwrPfD3yOVnmdvm-tOaSHDpwtAkDUn6YPEQxUk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_n4sC3FXflusOGKSPfgQYrS59qKeUbi1oMen2d9eJerw&oe=6A2C1372"}, "display_name": "Wingit", "keywords": [], "long_description": "Unleash Your Inner Bird in Aerial Dogfights and Races.\n\nEver dreamed of soaring through the skies as a majestic bird, engaging in thrilling air-to-air challenges, or participating in high-speed tag races?\n\nWe\u2019ve been developing a unique bird flapping and gliding mechanic that brings this experience to life in our upcoming multiplayer game, currently dubbed \u201cWingit\u201d.\n\nWe\u2019ve created a basic block-out map and implemented an infection game mode for testing purposes. However, we\u2019re eager to explore more game modes and perfect the overall experience.\n\nDepending on how you choose to fly, this game can be quite a lot of exercise :)\n\nWatch the attached video for a glimpse into the heart-pounding action and join our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN", "short_description": "Flap, glide, swoop, dip and flap to soar like a bird. Hang out with your friends or play a game of Tag, Hunt or make it up as you go."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Remio", "support_website_url": null, "website_url": "https://remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "sup
ingit_Render_1.png", "id": "926297781816389", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982584_926297785149722_4227410942138075850_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Ju87vU9jyoQ7kNvwFqjroQ&_nc_oc=AdqT3wART_5R-JUq6ATnO2djDKbVwqPXte2Uu_Z6GmfnmFDesZP64TL0S9ZX9tH5mZE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9KkiOpi9NTRY1sAbA7VFZ191fGY2wDPnKHxjQjTKztSg&oe=6A37E726"}, {"file_name": "5.png", "id": "673317157978047", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001732_673317161311380_6367319820395155286_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y3dhjG7iXCEQ7kNvwF_neF9&_nc_oc=AdpJ4aKcq4lI3lteEBJRiuAZxSNAHHMDd1YIFNc2XkztUv_8p_hwZnUV8-HDLMHdtPA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0DLiYWb2dzZz3k1_I_e3Jwuitkb58SJfnXdWxEzlyTQ&oe=6A37E873"}, {"file_name": "Screenshot (447).png", "id": "628875279216230", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566698_628875282549563_4913645439909033743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PQr7ZmHVxxQQ7kNvwEbJjXc&_nc_oc=AdrMUYDTgtVNGq-NDUCqilR_cZdwr3rJ4TaMy5WWKpi_XmZqGYyRN6TjVZNdwXAKvOE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9CNL3xM41MlwilqSZzqAM1P9pKCisFGj3LoKGxnlvi7w&oe=6A38131B"}, {"file_name": "3.png", "id": "3187958854840290", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974513_3187958858173623_2630061441027911886_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2LcZLAMd1NMQ7kNvwFm5p5-&_nc_oc=AdrkE7h1Sqkhk35t_VjbJGKsCXLEqwTkC64RJonn8rkHdnTKZHwZhaoFaqghsD1EQFg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Xv3BJsv8ImzNQ4uqe6riRrkF0WT031Ze6fVazN4rpJA&oe=6A37F20F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (4).png", "id": "941214970482404", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031643_941214973815737_2432176783600565336_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9E8Bq5HJoDoQ7kNvwG-_BPD&_nc_oc=AdoZHikjw2aTgtQyfNb1YKajTqdcY6l7PYjT1jkcrecLYTkmPkWvsGMTmfIpJGgH67U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wUnWicohkT8WDmuyUUtYIXfdCuqYo3HrWvhXmwzJRxg&oe=6A37F0F2"}, "display_name": "Wingit", "keywords": [], "long_description": "Unleash Your Inner Bird in Aerial Dogfights and Races.\n\nEver dreamed of soaring through the skies as a majestic bird, engaging in thrilling air-to-air challenges, or participating in high-speed tag races?\n\nWe\u2019ve been developing a unique bird flapping and gliding mechanic that brings this experience to life in our upcoming multiplayer game, currently dubbed \u201cWingit\u201d.\n\nWe\u2019ve created a basic block-out map and implemented an infection game mode for testing purposes. However, we\u2019re eager to explore more game modes and perfect the overall experience.\n\nDepending on how you choose to fly, this game can be quite a lot of exercise :)\n\nWatch the attached video for a glimpse into the heart-pounding action and join our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN", "short_description": "Flap, glide, swoop, dip and flap to soar like a bird. Hang out with your friends or play a game of Tag, Hunt or make it up as you go."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Remio", "support_website_url": null, "website_url": "https://remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "sup
ingit_Render_1.png", "id": "926297781816389", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982584_926297785149722_4227410942138075850_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0lEf8wsCP0AQ7kNvwHeiwTy&_nc_oc=AdptCw03dbeX_DqA2xsPT2WS_igW8ep2P9VKnd0xyl2SgOHkAGjr-HjmCeCOhH1sGWg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3EEr0Y3dyLfemFmsPGQwnxpsdLC5FqNm26zYDUzmr9Q&oe=6ACA75E6"}, {"file_name": "5.png", "id": "673317157978047", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001732_673317161311380_6367319820395155286_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MW4hA_HctlIQ7kNvwHPNbPV&_nc_oc=Adrmj4ao8Zd9i-ORxeLcPs3K0wXuIzj2u98Ddw64sjmmOt0m0pas8k74ZJaXNC1_zp0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPCW0hYepH97Ok0_h3uOA94Pe-SXpJHOqaR0Ye-e0DQ7A&oe=6ACA7733"}, {"file_name": "Screenshot (447).png", "id": "628875279216230", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566698_628875282549563_4913645439909033743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=py--3mbOY5wQ7kNvwGxfiQn&_nc_oc=AdpJzHbFuw9ixmHOG2T4hXgU-kcA_6AmmdoLXAf2PnDIalesnibySFtyE9CtRJ5abIg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNyzz8mUGeYJfXN0Koh00L04ui70gZF9gOPaT62WJuQwA&oe=6ACA699B"}, {"file_name": "3.png", "id": "3187958854840290", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974513_3187958858173623_2630061441027911886_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AIcskuu6mT0Q7kNvwFl5bBf&_nc_oc=AdpwSYUd-6tJrsbVZ_057cCkL6WZADI53ZFOioTny61KBdWa2r9i_COYaavvUMrqB6Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNgyEbfNOAK2155tyQa8mptkQdNJZjTeijBT6hKGQ9K_w&oe=6ACA488F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (4).png", "id": "941214970482404", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031643_941214973815737_2432176783600565336_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KgfLyOHcNw8Q7kNvwGMoxKE&_nc_oc=AdoJDY5SbDgrIlkdzqi20kIGS3huXkZKxKyo-6dE4dVq3GyO8UR1aT52mZZw5uBCW3c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNE9twJP2R9KmzO3xbjrGIPOi9zH5UnmHMyPLe4d2xCvg&oe=6ACA4772"}, "display_name": "Wingit", "keywords": [], "long_description": "Unleash Your Inner Bird in Aerial Dogfights and Races.\n\nEver dreamed of soaring through the skies as a majestic bird, engaging in thrilling air-to-air challenges, or participating in high-speed tag races?\n\nWe\u2019ve been developing a unique bird flapping and gliding mechanic that brings this experience to life in our upcoming multiplayer game, currently dubbed \u201cWingit\u201d.\n\nWe\u2019ve created a basic block-out map and implemented an infection game mode for testing purposes. However, we\u2019re eager to explore more game modes and perfect the overall experience.\n\nDepending on how you choose to fly, this game can be quite a lot of exercise :)\n\nWatch the attached video for a glimpse into the heart-pounding action and join our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN", "short_description": "Flap, glide, swoop, dip and flap to soar like a bird. Hang out with your friends or play a game of Tag, Hunt or make it up as you go."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Remio", "support_website_url": null, "website_url": "https://remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "sup
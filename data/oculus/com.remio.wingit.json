926297781816389", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982584_926297785149722_4227410942138075850_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KNrC0ZXMhhsQ7kNvwFWjGJG&_nc_oc=AdnBQz3NoRXm50zX8lTOQjQgiKVZ9Riy-5VorDGNmsdZeUUxBSMwRDAmeD9xKDnphQo&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfzT33_pCzTwedODVj-iLr9yFVlnM6ewxLHCiuDIjQgr4w&oe=69AAD6A6"}, {"file_name": "5.png", "id": "673317157978047", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39001732_673317161311380_6367319820395155286_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rCcORApJcYUQ7kNvwF_NuHe&_nc_oc=Adkdj5yjYu4UUB7E2vsyab3Mr8FQi3gbY3leeGZyYOyzDxRXvO2JzfIkNRUQ-NDcr94&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_AfzDoq5q_pPI57FEa7Tm-7bid4n2hsWLFpMxB20QWkmVNw&oe=69AAD7F3"}, {"file_name": "Screenshot (447).png", "id": "628875279216230", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/57566698_628875282549563_4913645439909033743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xM-KkiRdA8kQ7kNvwG98wVd&_nc_oc=Adllg570hk-n-0CypRmvDvhYqDbNTeCbgW4Mu1SEgXKy169IQCqLXvIGzNz3SVPJAw4&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_Afz7a7Hne-MeE-17cxDaIeLVWOSyny8a5C7foO1HbaLceQ&oe=69AACA5B"}, {"file_name": "3.png", "id": "3187958854840290", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974513_3187958858173623_2630061441027911886_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1fLh6kbIZcQQ7kNvwH5H0FF&_nc_oc=AdmGhCM7tG1TFmOws4cpf815C5LT42mbRxOuSCmFY6b-ctkaLAQfX-lp3an_xR67-qE&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxBoPOQoMhlwcxvJgOHVDrstFYjuVp1MLEU-6VXw9eRCA&oe=69AAE18F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (4).png", "id": "941214970482404", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39031643_941214973815737_2432176783600565336_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jUu5BqgtNLEQ7kNvwGOOXqv&_nc_oc=Adn9cdLTyRnK4dXFtahclNsO40GGeQDX3X81Q-EKw9_4SB0ysVbyvfWJIXVugY7ZoUw&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_Afw2gCZ2ih47Dr8hg4xPaPnQonCnaSRUwxCZk-uPFL-uYw&oe=69AAE072"}, "display_name": "Wingit", "keywords": [], "long_description": "Unleash Your Inner Bird in Aerial Dogfights and Races.\n\nEver dreamed of soaring through the skies as a majestic bird, engaging in thrilling air-to-air challenges, or participating in high-speed tag races?\n\nWe\u2019ve been developing a unique bird flapping and gliding mechanic that brings this experience to life in our upcoming multiplayer game, currently dubbed \u201cWingit\u201d.\n\nWe\u2019ve created a basic block-out map and implemented an infection game mode for testing purposes. However, we\u2019re eager to explore more game modes and perfect the overall experience.\n\nDepending on how you choose to fly, this game can be quite a lot of exercise :)\n\nWatch the attached video for a glimpse into the heart-pounding action and join our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN", "short_description": "Flap, glide, swoop, dip and flap to soar like a bird. Hang out with your friends or play a game of Tag, Hunt or make it up as you go."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Remio", "support_website_url": null, "website_url": "https://remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_inp
ingit_Render_1.png", "id": "926297781816389", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982584_926297785149722_4227410942138075850_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eblET8Rwet0Q7kNvwFy3rzp&_nc_oc=AdrJZfRBc6lTBF-BLN7ltroWUKmX2rgGKN5cWEsgRRkbZtgspvVCBXIhKCvFz-mJl7s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8G0B2-9LZvwfIqdfGYFT2EMjEyxWyJDcT8BYgrgDCQjA&oe=6A3BDBA6"}, {"file_name": "5.png", "id": "673317157978047", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001732_673317161311380_6367319820395155286_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MxhSY6XfIYcQ7kNvwEC-aVr&_nc_oc=Adp32hiM0x61Stb-7ghJNgNmidjzCRMaBdB9l5ZC-ywRyb9Xfh_DAUF8PNQ92iif9Cc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_O_vt1dF4Kdh2LRtVy8b-AxN1lIV_sQ3OTse3277dZAw&oe=6A3BDCF3"}, {"file_name": "Screenshot (447).png", "id": "628875279216230", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566698_628875282549563_4913645439909033743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zAGSmRp69SIQ7kNvwGQaows&_nc_oc=AdqPmg7UQHV6EEChOZPleLAvd1b2-81nZ91XBgBoApDzuzikBptD4CzG-W7HE-IqJhE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af893zgwuYBP1xlHzuNwuCZCP3SZ952ETIQbNKrsxi4uCw&oe=6A3BCF5B"}, {"file_name": "3.png", "id": "3187958854840290", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974513_3187958858173623_2630061441027911886_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q6NbJxdWzesQ7kNvwHZL8HF&_nc_oc=AdqRyUoxYHFjn-exPW3nNliiWIw0bby4Td0DXeGrFKpnVnY17_Zi_LrhPg2V_PmSbm4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af99a0REZDkgl_iHRTcfWNaZHhoQZlkY4LGIla2srsGUIQ&oe=6A3BE68F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (4).png", "id": "941214970482404", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031643_941214973815737_2432176783600565336_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VIxMDMKRhxUQ7kNvwHd0t4L&_nc_oc=Adr3dpVh_TxUydjMorxGw9Fg_Ougyj9pIJa-_0jTqV57DprduZljMRAVFPnTVPl-4Rw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-CVI6K2RZuIcl66Y1dtGPNtr-IpS3-4MZQ_1r7_nLvAQ&oe=6A3BE572"}, "display_name": "Wingit", "keywords": [], "long_description": "Unleash Your Inner Bird in Aerial Dogfights and Races.\n\nEver dreamed of soaring through the skies as a majestic bird, engaging in thrilling air-to-air challenges, or participating in high-speed tag races?\n\nWe\u2019ve been developing a unique bird flapping and gliding mechanic that brings this experience to life in our upcoming multiplayer game, currently dubbed \u201cWingit\u201d.\n\nWe\u2019ve created a basic block-out map and implemented an infection game mode for testing purposes. However, we\u2019re eager to explore more game modes and perfect the overall experience.\n\nDepending on how you choose to fly, this game can be quite a lot of exercise :)\n\nWatch the attached video for a glimpse into the heart-pounding action and join our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN", "short_description": "Flap, glide, swoop, dip and flap to soar like a bird. Hang out with your friends or play a game of Tag, Hunt or make it up as you go."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Remio", "support_website_url": null, "website_url": "https://remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "sup
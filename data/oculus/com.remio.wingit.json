ingit_Render_1.png", "id": "926297781816389", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982584_926297785149722_4227410942138075850_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eYgYHvsrOL8Q7kNvwFV8Q4m&_nc_oc=Adqyfaf3cAh5r7DqgLjTuQeSLyjZdJxme8v1czgfN6gd0bcFHSYJBt1tnLJWpwt4Hvc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-a457-FrK_zWq8S0AUqIBzUrUDGVl7PCMbwGN503oSRg&oe=6A32A126"}, {"file_name": "5.png", "id": "673317157978047", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39001732_673317161311380_6367319820395155286_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sVwZsLZfNnEQ7kNvwGi8-bU&_nc_oc=Adr9QJz_SJuDAgWtkoI4IGZUYQae6A0ffSLrvY1K63YbNsCZaC0hB8v6wYJInbPQVWo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ARKFh9OLXTzWg45lwYMGuiC2HySYhcqPyWISzwevK8w&oe=6A32A273"}, {"file_name": "Screenshot (447).png", "id": "628875279216230", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/57566698_628875282549563_4913645439909033743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VJ-AbVKAMFEQ7kNvwELKYEA&_nc_oc=AdoqLXu2kfSm7GxPob2hREcMIOumMl8NhnK0vIWjP6HaE-slu7aA8wtWsS8YqtwfSAw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_UvITmW8UXzNF3D4jHuBQSDqoI0Ux9oexbJU3E1qmIRg&oe=6A3294DB"}, {"file_name": "3.png", "id": "3187958854840290", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974513_3187958858173623_2630061441027911886_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f2UQC9QFzTkQ7kNvwFsBhiV&_nc_oc=Adqk096vreJ5J2j7GPs5lNrLcRr0VuIf8vjHSHrxbgKyJqxe2rlUmgQsHFaFC25ofRg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-OfICOloCSZ0j4EHJoO8acmIOyx3JGLGqZePPgTjSCoA&oe=6A32AC0F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (4).png", "id": "941214970482404", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031643_941214973815737_2432176783600565336_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LbiSE0tBa3AQ7kNvwFhG2z6&_nc_oc=Adrrnvo49HoOBi22M4YCwhGeHVhukDrz9mQ4waz6343RhQgta8jxwslMJs84YBC6djQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8zo5Z1vTZgJGOao4YspNJE_BkdJ2wIh-OcfUyIi7-W7Q&oe=6A32AAF2"}, "display_name": "Wingit", "keywords": [], "long_description": "Unleash Your Inner Bird in Aerial Dogfights and Races.\n\nEver dreamed of soaring through the skies as a majestic bird, engaging in thrilling air-to-air challenges, or participating in high-speed tag races?\n\nWe\u2019ve been developing a unique bird flapping and gliding mechanic that brings this experience to life in our upcoming multiplayer game, currently dubbed \u201cWingit\u201d.\n\nWe\u2019ve created a basic block-out map and implemented an infection game mode for testing purposes. However, we\u2019re eager to explore more game modes and perfect the overall experience.\n\nDepending on how you choose to fly, this game can be quite a lot of exercise :)\n\nWatch the attached video for a glimpse into the heart-pounding action and join our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN", "short_description": "Flap, glide, swoop, dip and flap to soar like a bird. Hang out with your friends or play a game of Tag, Hunt or make it up as you go."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Remio", "support_website_url": null, "website_url": "https://remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "sup
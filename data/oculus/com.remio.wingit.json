97781816389", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982584_926297785149722_4227410942138075850_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uiDnmOAoo0UQ7kNvwHnwaxV&_nc_oc=AdkyojGZGVRH3uFPII3aBtMEYZyEJt_udJz-3A1ejNxlVlHBdQM439BM07oCPVjc2K8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy4XFvhFu1Gq37sv7kPM0SPO4cnmRnyr9iKlbDNtxTSNw&oe=69B805A6"}, {"file_name": "5.png", "id": "673317157978047", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001732_673317161311380_6367319820395155286_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vITXavO4eKoQ7kNvwEYf6j0&_nc_oc=Adm6VB-4unlK4ky_C9lctQ3C6uQiSSceHc0gkgJaehiuFhxDQqOwVb2Aq56I1aRCyE0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyuslOQOI-SfP5Zyka2H_cu-6-Yh1fIJPlBE4sYwdGDyw&oe=69B806F3"}, {"file_name": "Screenshot (447).png", "id": "628875279216230", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57566698_628875282549563_4913645439909033743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wVYvZseDNgEQ7kNvwES1kiH&_nc_oc=AdlJa5igsBGcKgF1_hgpf3BU9niLHZwSwsKD0T4jX0jb0ZCrmWfVg4_-7uB9sXk_nJA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwApzn5efGGWhlpZF4TKlwK2xWxHy2v0Qh8buXFpsHerw&oe=69B7F95B"}, {"file_name": "3.png", "id": "3187958854840290", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974513_3187958858173623_2630061441027911886_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HqgPM2vvWFwQ7kNvwFPGfNF&_nc_oc=Adl7Opg4DybAFlW17z2oegWTFt1iYCJXPYWcSHKIsxa3UBdBUgaMWtIg5-y7y4ID2M8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afx24EKIaXjYK4bdJbEnJJ8xNiYyItYzdaRb8ao4qsQ9UA&oe=69B8108F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (4).png", "id": "941214970482404", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031643_941214973815737_2432176783600565336_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VKd5k6O9WsoQ7kNvwG3ue8Y&_nc_oc=AdncFzggMwm4SRTgsSpPsEaEn3u8DCmST0MG8mPdLFfhfU0Dl9ibv7Zy_D7IcjHrRas&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy0jjB79SteXbsr854NAUgv0euu9nechDOeZvbDNc27Zw&oe=69B80F72"}, "display_name": "Wingit", "keywords": [], "long_description": "Unleash Your Inner Bird in Aerial Dogfights and Races.\n\nEver dreamed of soaring through the skies as a majestic bird, engaging in thrilling air-to-air challenges, or participating in high-speed tag races?\n\nWe\u2019ve been developing a unique bird flapping and gliding mechanic that brings this experience to life in our upcoming multiplayer game, currently dubbed \u201cWingit\u201d.\n\nWe\u2019ve created a basic block-out map and implemented an infection game mode for testing purposes. However, we\u2019re eager to explore more game modes and perfect the overall experience.\n\nDepending on how you choose to fly, this game can be quite a lot of exercise :)\n\nWatch the attached video for a glimpse into the heart-pounding action and join our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN", "short_description": "Flap, glide, swoop, dip and flap to soar like a bird. Hang out with your friends or play a game of Tag, Hunt or make it up as you go."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Remio", "support_website_url": null, "website_url": "https://remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_d
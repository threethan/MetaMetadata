ingit_Render_1.png", "id": "926297781816389", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982584_926297785149722_4227410942138075850_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BLEHisLvzDUQ7kNvwEyDR-o&_nc_oc=Ado1QWnhefsP08wPby33WOvBZ_uKax31POp_CO6l4RrL_RAL_z5WBWa3VPYi_HjME7o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnGmYxK85A4QKUeJKInGjkRIvbyBu97Y5H3ARRZ1n9_Q&oe=6A9D6AA6"}, {"file_name": "5.png", "id": "673317157978047", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001732_673317161311380_6367319820395155286_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nrjp1mRdb54Q7kNvwG3F4TJ&_nc_oc=AdpJvzK_XRJ4jCE6bPPVD0OmEwqpF15V5fGtisc9V6ng2VFgEwDQtwsWBJfHSthIjiw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2uzzIQvvh_ix1W8FE4oqcQ_WYgDHOqA9-TTyWTpbuBg&oe=6A9D6BF3"}, {"file_name": "Screenshot (447).png", "id": "628875279216230", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566698_628875282549563_4913645439909033743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mUSzv6UodskQ7kNvwFLEG1U&_nc_oc=Adq1EhM-7w3ySk1FZHgQXjyzu5qNPvxEuCpssUF8GwZjx6Jty2m0umG2wTN-IzU89Vk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIez4ioSneeo8rSRJqwBtjXEgfQ1H9eXG2JcbOtBBSTzA&oe=6A9D5E5B"}, {"file_name": "3.png", "id": "3187958854840290", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974513_3187958858173623_2630061441027911886_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qFyWzkXp508Q7kNvwG9Q3uD&_nc_oc=Adq10db8hrpA4EkShSf8phpWjcqtx2XgUxa_HoChSyuw5QkSepsL-gHpaAeURUtDcTw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKU1OurPq7Y-xZd1EhDJbRI4jZydiSNWkZyLEzaCl1rhw&oe=6A9D758F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (4).png", "id": "941214970482404", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031643_941214973815737_2432176783600565336_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mEFbm2DG_0AQ7kNvwGtJrnO&_nc_oc=AdqniBP9Q4OQbdUE-v_HhRl6oeB6oMuDJPxSzeCbpCW8IUvbZkAgtQbcSM8F90Ofb7k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWwu4JOYpA3EIqkuo45xuWxr_Q01v7bpx9ck0tRQvWRQ&oe=6A9D7472"}, "display_name": "Wingit", "keywords": [], "long_description": "Unleash Your Inner Bird in Aerial Dogfights and Races.\n\nEver dreamed of soaring through the skies as a majestic bird, engaging in thrilling air-to-air challenges, or participating in high-speed tag races?\n\nWe\u2019ve been developing a unique bird flapping and gliding mechanic that brings this experience to life in our upcoming multiplayer game, currently dubbed \u201cWingit\u201d.\n\nWe\u2019ve created a basic block-out map and implemented an infection game mode for testing purposes. However, we\u2019re eager to explore more game modes and perfect the overall experience.\n\nDepending on how you choose to fly, this game can be quite a lot of exercise :)\n\nWatch the attached video for a glimpse into the heart-pounding action and join our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN", "short_description": "Flap, glide, swoop, dip and flap to soar like a bird. Hang out with your friends or play a game of Tag, Hunt or make it up as you go."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Remio", "support_website_url": null, "website_url": "https://remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "sup
ingit_Render_1.png", "id": "926297781816389", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982584_926297785149722_4227410942138075850_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r8mUY1F2rXsQ7kNvwES_fvW&_nc_oc=Ado_8__LO6DCgw7Rbd5tNgBkM3vypxwsSfPAhpkAy6xitISUKDNgf2rMTVnOHVxgi0c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2YoNWhospmFkH5EjVpCoOWBM1oTCqRzZvr9NPFArkXAw&oe=69DE4126"}, {"file_name": "5.png", "id": "673317157978047", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001732_673317161311380_6367319820395155286_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pbzzxEwnbV0Q7kNvwHjns8V&_nc_oc=AdrD5MJCxjSdR3qFSz6TGvb3mvdIWbQN9pkyKOMeK-Kfg3NC3uYqTKeRTmFUiOH64gI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3GvJMQow-6xduPtDbYGJFB9TZbGoxZK5impkdxPIKVCg&oe=69DE4273"}, {"file_name": "Screenshot (447).png", "id": "628875279216230", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57566698_628875282549563_4913645439909033743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B_peDtzuMfYQ7kNvwGWGM5c&_nc_oc=Adpn3IifREnRF1zoPOup5OKr6jm4bfoe5HWD0b0OHOpSThwuFHp4Ih2_bQwlARoQt6Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af38ioufFc03bvQWDJtN9wpHiYRj5SSE4052O6vYgI6cQQ&oe=69DE34DB"}, {"file_name": "3.png", "id": "3187958854840290", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974513_3187958858173623_2630061441027911886_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FUb3slrMBxUQ7kNvwEgQRpR&_nc_oc=AdpdlLtXBbe78psHihWVjauUZy4ZiEnQ6bRYnQZuBMmizBhpO6zzL139BVchOqzaTRY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0diFQhbvoqmPZnE0YKm87gHFaXqtU_nZqK9jM1E4tXSw&oe=69DE4C0F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (4).png", "id": "941214970482404", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031643_941214973815737_2432176783600565336_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LJZsNm6CoNAQ7kNvwEAY2K6&_nc_oc=AdqmohgVJpLgfJ95ycBqUJFjZkSnXNkxmN7b_GHIGa1ovAdtW74UGK5lXhYy355ZiBc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1hhDhwhXNOBGlwxB8vqJakLgJV_aMpku5DZc0zYQgdoA&oe=69DE4AF2"}, "display_name": "Wingit", "keywords": [], "long_description": "Unleash Your Inner Bird in Aerial Dogfights and Races.\n\nEver dreamed of soaring through the skies as a majestic bird, engaging in thrilling air-to-air challenges, or participating in high-speed tag races?\n\nWe\u2019ve been developing a unique bird flapping and gliding mechanic that brings this experience to life in our upcoming multiplayer game, currently dubbed \u201cWingit\u201d.\n\nWe\u2019ve created a basic block-out map and implemented an infection game mode for testing purposes. However, we\u2019re eager to explore more game modes and perfect the overall experience.\n\nDepending on how you choose to fly, this game can be quite a lot of exercise :)\n\nWatch the attached video for a glimpse into the heart-pounding action and join our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN", "short_description": "Flap, glide, swoop, dip and flap to soar like a bird. Hang out with your friends or play a game of Tag, Hunt or make it up as you go."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Remio", "support_website_url": null, "website_url": "https://remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "sup
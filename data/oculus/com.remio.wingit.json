ingit_Render_1.png", "id": "926297781816389", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982584_926297785149722_4227410942138075850_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vp3-Pa-N6RcQ7kNvwHLZhK9&_nc_oc=AdpaCGIm1zS-m-5hJsOBJyDTmdJx7gSZ7dVen0JzgRLscVTlBEtoK8r4D4LQL89ND-Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHw5eeqd9E8Xy2H4VC_79ppjrGtY1Ii9xWL8w7TuTJ1BA&oe=6A95B9E6"}, {"file_name": "5.png", "id": "673317157978047", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001732_673317161311380_6367319820395155286_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3avUc7-5JNYQ7kNvwFsCJCh&_nc_oc=AdqDt0J8I4sIaoSAf3SY-BChPiCtg1JZKQzSL1RxeVAKRsTjMt7KG9Sa7qFLZ1OXYrw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRtlIyrnseBVn5fY8A-oG3mfKz-2X3yp9ZUhDSaRgZgA&oe=6A95BB33"}, {"file_name": "Screenshot (447).png", "id": "628875279216230", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566698_628875282549563_4913645439909033743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_GBH2-oB8UMQ7kNvwEUyQaJ&_nc_oc=Adpt_9HfR-xm6byH1J44VBV90mPaYbaJpn1j1fzqbzd_B-1Rs2C_BCOCei8QUvQ0wvc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQxwNI5x8nRg2CPbnx1WSLpyIiae0_fb5VFzHHFJHDtw&oe=6A95E5DB"}, {"file_name": "3.png", "id": "3187958854840290", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974513_3187958858173623_2630061441027911886_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KGbt2LsJ59wQ7kNvwFyuohR&_nc_oc=AdpqfHxvtnUfGaeP0oZaknFKknp_Ioq62KXMHkMj1WIQAtZOIYjRDazFWOoUR0uICjQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHkuEqxt_xiHTt0IEAXUuaV88DnjXwEcqd-tafnkuOOJw&oe=6A95C4CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (4).png", "id": "941214970482404", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031643_941214973815737_2432176783600565336_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zWaQP0Bfj4oQ7kNvwGlZ28T&_nc_oc=AdoQnwwMxarpTYrdgL067CZ5zjZZT7RxTffjR1gKh2dgLUpB8-NdcdLWWcAXxLrNhMc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSUdc2JgKa-bGiDoB_cc_-9Gzw62AkIiOvL0D0lB2_0Q&oe=6A95C3B2"}, "display_name": "Wingit", "keywords": [], "long_description": "Unleash Your Inner Bird in Aerial Dogfights and Races.\n\nEver dreamed of soaring through the skies as a majestic bird, engaging in thrilling air-to-air challenges, or participating in high-speed tag races?\n\nWe\u2019ve been developing a unique bird flapping and gliding mechanic that brings this experience to life in our upcoming multiplayer game, currently dubbed \u201cWingit\u201d.\n\nWe\u2019ve created a basic block-out map and implemented an infection game mode for testing purposes. However, we\u2019re eager to explore more game modes and perfect the overall experience.\n\nDepending on how you choose to fly, this game can be quite a lot of exercise :)\n\nWatch the attached video for a glimpse into the heart-pounding action and join our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN", "short_description": "Flap, glide, swoop, dip and flap to soar like a bird. Hang out with your friends or play a game of Tag, Hunt or make it up as you go."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Remio", "support_website_url": null, "website_url": "https://remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "sup
5/38982584_926297785149722_4227410942138075850_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m7uXCKfgW64Q7kNvwENM-Sk&_nc_oc=AdrjLq567zscxFXc-vX2PMvQdXPsw830JFentXyD75ZJG1GVFM1zk18h77k41lOltmk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3XviEIHYWoJRoW0LsKNiU5RPzLy2jSvjnTkqwyTAJjLw&oe=69F0B626"}, {"file_name": "5.png", "id": "673317157978047", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001732_673317161311380_6367319820395155286_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lf-w8QTVfrEQ7kNvwHcwCgu&_nc_oc=AdoO8P9m1W3uGBM3Am9RAaSzJbU33SiaqVs7Jpmi5h57bneAtzeyAsBeN7_DHdsNZzg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1D3o8MDm1IEmXYLV92TX4MKfdQFVMEzsEitY6kNT2HVg&oe=69F0B773"}, {"file_name": "Screenshot (447).png", "id": "628875279216230", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566698_628875282549563_4913645439909033743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vR4_DZKwzvMQ7kNvwHHvI7r&_nc_oc=AdpIX22tbgyGqLQzxWCPyI339TstWUtYQAkRmb1eY7rZZelWELA0vHV_M9DFjgX4t2g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af31JZCvliHCvw93KySwf0KCUBqr813dep8uhooBNTjmzA&oe=69F0A9DB"}, {"file_name": "3.png", "id": "3187958854840290", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974513_3187958858173623_2630061441027911886_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LhIHyUNS92kQ7kNvwGNX-8I&_nc_oc=AdrqybwbUsTWgOPThxG4_TlsPKSv7EkFaUNRxFqCMiapg75lKweIzXcwSFIibEHg9nQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0XiZqbzrNj2nDIKb9uWYjof6_MGhsOfBpfVUtTi_jCYw&oe=69F0C10F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (4).png", "id": "941214970482404", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031643_941214973815737_2432176783600565336_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YYvMJ8cmHnMQ7kNvwH5tXYu&_nc_oc=AdrR5l0Jm6IO0WKVXIV7_HuScB2I74lnY_oRiPIZJQJtvAdZ-R92E2H5EJMLr0CaxDY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0VpgAqvVfei4IsNgLNIEyPde1x1lAxBMjx5pFjPD3jLQ&oe=69F0BFF2"}, "display_name": "Wingit", "keywords": [], "long_description": "Unleash Your Inner Bird in Aerial Dogfights and Races.\n\nEver dreamed of soaring through the skies as a majestic bird, engaging in thrilling air-to-air challenges, or participating in high-speed tag races?\n\nWe\u2019ve been developing a unique bird flapping and gliding mechanic that brings this experience to life in our upcoming multiplayer game, currently dubbed \u201cWingit\u201d.\n\nWe\u2019ve created a basic block-out map and implemented an infection game mode for testing purposes. However, we\u2019re eager to explore more game modes and perfect the overall experience.\n\nDepending on how you choose to fly, this game can be quite a lot of exercise :)\n\nWatch the attached video for a glimpse into the heart-pounding action and join our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN", "short_description": "Flap, glide, swoop, dip and flap to soar like a bird. Hang out with your friends or play a game of Tag, Hunt or make it up as you go."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Remio", "support_website_url": null, "website_url": "https://remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_
97781816389", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982584_926297785149722_4227410942138075850_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wsRVvOjP818Q7kNvwECFYh5&_nc_oc=Adkkegd40y9fqNEc1C9ckaMHtbH51bPwSWvnP6M3jimnHI-vQQAPqgx_yosUBbjpRGo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afyz5nAyIz4qQ4opv4AWgzrLTCnhOnwR0p87XYylxOGpHg&oe=69B01CA6"}, {"file_name": "5.png", "id": "673317157978047", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001732_673317161311380_6367319820395155286_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cii4nNWQLVkQ7kNvwFK7spt&_nc_oc=AdkkxR4WjztPZl46owhXV93uUSdnH62CBmzbgAROpK9D6bLw4pl_L5CokNG_bzKf8qE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyeK2AnRdqsfyfJNnPm0o8VaDBLRirjJkfVVSsEzQ87Tw&oe=69B01DF3"}, {"file_name": "Screenshot (447).png", "id": "628875279216230", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57566698_628875282549563_4913645439909033743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W1VLXKlXRAYQ7kNvwHXySNN&_nc_oc=AdmgeXeH4PwMaY9aI1Pk8LQk9PdK2DuZLbXMJWp0PVF5TNmlJLTI8gLwmG0dalBS0bs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afyq9b46zGnkqQ4aTBOsLVGHExn9ZP97RAwgLp3uQDgg6Q&oe=69B0105B"}, {"file_name": "3.png", "id": "3187958854840290", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974513_3187958858173623_2630061441027911886_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fCD5dmuVLdgQ7kNvwGlZ1Fd&_nc_oc=AdneQJ77n2eYV990GiFOXpka7aVmwQnl4z2YkX6tOBzvrm19G8iGJL84MOQhznI11wI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzs6p1lbZiYQZ3NqGfpU3ehfZPAa_9Wsr4mbh7NhemvCQ&oe=69B0278F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (4).png", "id": "941214970482404", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031643_941214973815737_2432176783600565336_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hVjW9dmg-zgQ7kNvwF-HXAV&_nc_oc=AdnUvve3f6iEs0Q6MATAVSJmi2LYC9KsFJp_rgmdlVDrFnvS8-XygLRsQsCf4XMkiCg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzev5xg_nz1wl9R1Sw6w1gn-gLAgN95IXCkQnNfQ_lCtQ&oe=69B02672"}, "display_name": "Wingit", "keywords": [], "long_description": "Unleash Your Inner Bird in Aerial Dogfights and Races.\n\nEver dreamed of soaring through the skies as a majestic bird, engaging in thrilling air-to-air challenges, or participating in high-speed tag races?\n\nWe\u2019ve been developing a unique bird flapping and gliding mechanic that brings this experience to life in our upcoming multiplayer game, currently dubbed \u201cWingit\u201d.\n\nWe\u2019ve created a basic block-out map and implemented an infection game mode for testing purposes. However, we\u2019re eager to explore more game modes and perfect the overall experience.\n\nDepending on how you choose to fly, this game can be quite a lot of exercise :)\n\nWatch the attached video for a glimpse into the heart-pounding action and join our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN", "short_description": "Flap, glide, swoop, dip and flap to soar like a bird. Hang out with your friends or play a game of Tag, Hunt or make it up as you go."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Remio", "support_website_url": null, "website_url": "https://remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_d
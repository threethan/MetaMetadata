ingit_Render_1.png", "id": "926297781816389", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982584_926297785149722_4227410942138075850_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m7uXCKfgW64Q7kNvwHUnOWj&_nc_oc=AdpK2R4dW3RMlQ2CN8uIIMilY-aJ4XhZUQP_nyGAl-YTtXlO236o7Pb609xURxr_uMY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3xKcjbcW9L48wbyBdXUw24mx9MTuktwDkUdCCYWhHXTQ&oe=69EF64A6"}, {"file_name": "5.png", "id": "673317157978047", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001732_673317161311380_6367319820395155286_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lf-w8QTVfrEQ7kNvwHNTlIk&_nc_oc=AdoXt5X5SbQG_Slvd-dcvOaqTaZ2MqP0bJtOjaR2tJ2os4s0TH4xN4llzuep35yO44g&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af282JPMTw14_TQawY0NuUsFBlV59JPR_Zgwd0Rhdv5azA&oe=69EF65F3"}, {"file_name": "Screenshot (447).png", "id": "628875279216230", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57566698_628875282549563_4913645439909033743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vR4_DZKwzvMQ7kNvwGuL9wu&_nc_oc=AdqFpRzRVxjJImslpS-Z-r9ZvZ0X-3BkgZVznitMgMOHgIkFzOvxNsDgoMrmAw89jqw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1jhoYxOC7lG8H6c1wFVF-c3zKf2HU_RBk72Wava-MrrA&oe=69EF585B"}, {"file_name": "3.png", "id": "3187958854840290", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974513_3187958858173623_2630061441027911886_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LhIHyUNS92kQ7kNvwEDprBM&_nc_oc=AdpiFgBQdn0G9wH5qWjv54BQ-UTQmSEg6AacNLBp0Kg64Top0nhhBRyuWu-qEU__3oI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af03IklOBrlfCsI8ng63QREbxIb6S6mvZeWdp-YRxGNLmg&oe=69EF6F8F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (4).png", "id": "941214970482404", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031643_941214973815737_2432176783600565336_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YYvMJ8cmHnMQ7kNvwEHpkIB&_nc_oc=AdpRoTX2Vm5YU9CdkaTKifTt8MK2ZLzpLjU8eOCCDpBm5-RHvwOGlVWa7E6Tu5hSYYc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2EA-F51EwnF_C3haU_DJUU7yAepDpGw2BksOzGhD1ipg&oe=69EF6E72"}, "display_name": "Wingit", "keywords": [], "long_description": "Unleash Your Inner Bird in Aerial Dogfights and Races.\n\nEver dreamed of soaring through the skies as a majestic bird, engaging in thrilling air-to-air challenges, or participating in high-speed tag races?\n\nWe\u2019ve been developing a unique bird flapping and gliding mechanic that brings this experience to life in our upcoming multiplayer game, currently dubbed \u201cWingit\u201d.\n\nWe\u2019ve created a basic block-out map and implemented an infection game mode for testing purposes. However, we\u2019re eager to explore more game modes and perfect the overall experience.\n\nDepending on how you choose to fly, this game can be quite a lot of exercise :)\n\nWatch the attached video for a glimpse into the heart-pounding action and join our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN", "short_description": "Flap, glide, swoop, dip and flap to soar like a bird. Hang out with your friends or play a game of Tag, Hunt or make it up as you go."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Remio", "support_website_url": null, "website_url": "https://remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "sup
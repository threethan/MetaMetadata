ingit_Render_1.png", "id": "926297781816389", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982584_926297785149722_4227410942138075850_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1KLlUrzJtT8Q7kNvwEKDUeg&_nc_oc=AdoPCY64lagPbQJZe5OYAm7_a1-RkipzgjHNKs2XWlyctkX2VslXkR_lSlTv3G4C_0k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0-6NMYg-GytPDt-_-hRzTdW_c1RXgv2D4CNljilYhsxQ&oe=69D263A6"}, {"file_name": "5.png", "id": "673317157978047", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001732_673317161311380_6367319820395155286_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mhHB66UVK74Q7kNvwG_MOE-&_nc_oc=Adqm2OaHGDS_7ryttVRSVvBS7SNRreWg-AqsMT2E6DjsmfTPPDiNPgA-o3lobgGAIDc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0-Rdm3qQnwGMcKPfCyCG485YTGtQu6O14Tc-zv0v1rjQ&oe=69D264F3"}, {"file_name": "Screenshot (447).png", "id": "628875279216230", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57566698_628875282549563_4913645439909033743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l07E4TrK9zUQ7kNvwGeqxWC&_nc_oc=AdrGGY6ElqoklB6xiWidqu3mxGelK_m_3KxwpSLBAoEPfDxCRe5-79jlZNhwkUfeVTs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0FBK5kh7iytz1DAkTefK2KJ1zlCFNWgZEUl2OOXXkBZg&oe=69D2575B"}, {"file_name": "3.png", "id": "3187958854840290", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974513_3187958858173623_2630061441027911886_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ID_MjyjRLYQ7kNvwEwfrDx&_nc_oc=AdrQATfrXUEwDqBLwoVSlVOKJekSp_lLwokdmTWV4W5bUauJmm-_OA8I7IDHFWCQnU8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af02m0ZGtYRtuAzpsI_N_IHIOP8FYSFgWSP63JjS97NzKA&oe=69D26E8F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (4).png", "id": "941214970482404", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031643_941214973815737_2432176783600565336_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MJTwZ4LGDYoQ7kNvwGngw5u&_nc_oc=Adp9JESEvQmLq4Y8X4b4xvkWiZ17R-TYrPkZoixqkQMj3xLHzeqctxFviPXiA8BhFJo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2MRsaoybPUYB0MoSVb0zawNWpGesDTPUAkkn9N6d4LYQ&oe=69D26D72"}, "display_name": "Wingit", "keywords": [], "long_description": "Unleash Your Inner Bird in Aerial Dogfights and Races.\n\nEver dreamed of soaring through the skies as a majestic bird, engaging in thrilling air-to-air challenges, or participating in high-speed tag races?\n\nWe\u2019ve been developing a unique bird flapping and gliding mechanic that brings this experience to life in our upcoming multiplayer game, currently dubbed \u201cWingit\u201d.\n\nWe\u2019ve created a basic block-out map and implemented an infection game mode for testing purposes. However, we\u2019re eager to explore more game modes and perfect the overall experience.\n\nDepending on how you choose to fly, this game can be quite a lot of exercise :)\n\nWatch the attached video for a glimpse into the heart-pounding action and join our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN", "short_description": "Flap, glide, swoop, dip and flap to soar like a bird. Hang out with your friends or play a game of Tag, Hunt or make it up as you go."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Remio", "support_website_url": null, "website_url": "https://remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "sup
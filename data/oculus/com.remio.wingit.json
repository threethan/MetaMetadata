ingit_Render_1.png", "id": "926297781816389", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982584_926297785149722_4227410942138075850_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-0TqdlBPrzEQ7kNvwHRN_LQ&_nc_oc=AdqdcAgu7O3rvAcD3vPNGjSE90XiXnTKAVMFrGoyEgwE1uAu-61FMcWSFS_IvgZc9Fc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAtyU_8mXBdvjR8oCRQJe5hextmvUgDwJ8F3YsuvLOIkw&oe=6A5396A6"}, {"file_name": "5.png", "id": "673317157978047", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001732_673317161311380_6367319820395155286_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q-osMaDlznEQ7kNvwFwddhC&_nc_oc=AdqrwmzGJMXfKLZ-dJ0stEpIEwjHaq3GT04jw4K9sYk9bwUtIpHJQOXomdRcmAKpI94&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8omBTJQgHtJJoVnSuE0dRGW_Q9DJjM36jw3DYskaOxw&oe=6A5397F3"}, {"file_name": "Screenshot (447).png", "id": "628875279216230", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57566698_628875282549563_4913645439909033743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9jchF88uYxYQ7kNvwFEbtKN&_nc_oc=AdrTvCGxRKCFCRFa_by5cKpbT-xxkL28qZeOQnJLjD2v8hYig300_XoFwe5mAiJNHL8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-DfHKkaySjZ027NRZexmooOFYq2CGOAJmwRveX-4ZUw&oe=6A538A5B"}, {"file_name": "3.png", "id": "3187958854840290", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974513_3187958858173623_2630061441027911886_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wMthyRk1iPAQ7kNvwEKOhvu&_nc_oc=AdoYGazvT_oWhMLQXJj0MDED8jyFJCssW5oBjMlPebtkYCumgg9gFR3qAdFTgqJCtfA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCvyoJoYZlLJhHgjVXVlCe81SbYP_20aYZZ9Uou-LGOWA&oe=6A53A18F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (4).png", "id": "941214970482404", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031643_941214973815737_2432176783600565336_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Um49egdC2x8Q7kNvwFZx_0p&_nc_oc=Adr4oAYCVTk2IJPZkwNGUFMW-UhugiMtlcJ4QPJPfQP2-EU5K7uJ536qwMRUtBSgnsw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCbQ0uKnhiklEMQkylp7GfzPUijueisr2A8xvUxHzxskg&oe=6A53A072"}, "display_name": "Wingit", "keywords": [], "long_description": "Unleash Your Inner Bird in Aerial Dogfights and Races.\n\nEver dreamed of soaring through the skies as a majestic bird, engaging in thrilling air-to-air challenges, or participating in high-speed tag races?\n\nWe\u2019ve been developing a unique bird flapping and gliding mechanic that brings this experience to life in our upcoming multiplayer game, currently dubbed \u201cWingit\u201d.\n\nWe\u2019ve created a basic block-out map and implemented an infection game mode for testing purposes. However, we\u2019re eager to explore more game modes and perfect the overall experience.\n\nDepending on how you choose to fly, this game can be quite a lot of exercise :)\n\nWatch the attached video for a glimpse into the heart-pounding action and join our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN", "short_description": "Flap, glide, swoop, dip and flap to soar like a bird. Hang out with your friends or play a game of Tag, Hunt or make it up as you go."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Remio", "support_website_url": null, "website_url": "https://remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "sup
ingit_Render_1.png", "id": "926297781816389", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982584_926297785149722_4227410942138075850_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uU7EM8JVle8Q7kNvwFUx27s&_nc_oc=Adq_qVn1460PAsexURRX6mMW5Czis_E92tdCB_02Wm3cl0jIGaKGsABElC8-qtpAh0c&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL27L1_N76CHDYYYgE7udFsdbufLrcafnRj7wCIRygIaA&oe=6AA15F26"}, {"file_name": "5.png", "id": "673317157978047", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001732_673317161311380_6367319820395155286_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DzedfXAoRE0Q7kNvwHqBpoo&_nc_oc=AdqTkHrHOlsGuoPPT68gos46j9nuCtX8kiqhTb_oZAMBvWjPOVNJRd1YAtjfiVcm3ts&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJugu922IiUXoznSm34xZet0A2QINJyXs2m1evq4TDL6w&oe=6AA16073"}, {"file_name": "Screenshot (447).png", "id": "628875279216230", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57566698_628875282549563_4913645439909033743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cIJuu4GCKYUQ7kNvwE3GTXX&_nc_oc=Adq1bJxAPPW5x6vIl6YVr0b6khU0mnYCmafCxGQP2aghTZ6lCQhE0hpUvzQilZsGc4M&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqt9S7GZXW-6j2CFzfWx0RmULMhwR1wKL-xg0iRAwXHw&oe=6AA152DB"}, {"file_name": "3.png", "id": "3187958854840290", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974513_3187958858173623_2630061441027911886_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wYXETmukKeMQ7kNvwGYNs8H&_nc_oc=AdrktVI9qsdOt-m9aIim12KBeZu52pwGUy8pH7lX3oR_VKHhHu9n1YBy6PPQPIDUE8M&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKGIa5GespqymcyYh1mjN9ZMfdEgdleKwtohs3U_bC-_g&oe=6AA16A0F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (4).png", "id": "941214970482404", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031643_941214973815737_2432176783600565336_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uhqaVi-c00sQ7kNvwGlxWfE&_nc_oc=Adoj_GM_QWe3CfG9nrJ1d8UtwHXiAskPU1C_dN_fgUTsfOj6n1f0HgsNUk2voP5M6aQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKKkndA95G2g-dnzDSQM1rsgYXDa6BhEv5nKQhoDAgChQ&oe=6AA168F2"}, "display_name": "Wingit", "keywords": [], "long_description": "Unleash Your Inner Bird in Aerial Dogfights and Races.\n\nEver dreamed of soaring through the skies as a majestic bird, engaging in thrilling air-to-air challenges, or participating in high-speed tag races?\n\nWe\u2019ve been developing a unique bird flapping and gliding mechanic that brings this experience to life in our upcoming multiplayer game, currently dubbed \u201cWingit\u201d.\n\nWe\u2019ve created a basic block-out map and implemented an infection game mode for testing purposes. However, we\u2019re eager to explore more game modes and perfect the overall experience.\n\nDepending on how you choose to fly, this game can be quite a lot of exercise :)\n\nWatch the attached video for a glimpse into the heart-pounding action and join our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN", "short_description": "Flap, glide, swoop, dip and flap to soar like a bird. Hang out with your friends or play a game of Tag, Hunt or make it up as you go."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Remio", "support_website_url": null, "website_url": "https://remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "sup
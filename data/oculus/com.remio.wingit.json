ingit_Render_1.png", "id": "926297781816389", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982584_926297785149722_4227410942138075850_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ouqyn3NeVYcQ7kNvwGMn-WD&_nc_oc=Adp_zG_DWGNnJsGr8E5Ur553_WP3wzwgqdP94GUFbzqiX-ZOsbJuK-ASIfBUhmHCCAI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5YZyGlMTm7CnHYyulFeixbY-D5_fOo2vlT-q4WGjSVHQ&oe=6A1994A6"}, {"file_name": "5.png", "id": "673317157978047", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001732_673317161311380_6367319820395155286_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TfuYf0yqX9IQ7kNvwECat0X&_nc_oc=Adp3SRhWmwQF-ia6bT9OEBC8p3RHtXuk8ZXY6-i3MFo2tdPQMccpqdyjK6-EW4fpZd8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af442JdleuJGnV_-uy-gfGHL3GuOoyxj-kIbAkqMotVAPg&oe=6A1995F3"}, {"file_name": "Screenshot (447).png", "id": "628875279216230", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57566698_628875282549563_4913645439909033743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9SYLqj6XDPIQ7kNvwHMr-w3&_nc_oc=Adr0N5vJvNPeFQ5FLkgYntydO1ym9oluK7QRR3tQgP8CN7NWxLi-5KIx2F6ZdQUpB_A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RTu8AJJ5828-XTzLYR917YRGD0HjD9UOQ4__v-pZUXA&oe=6A19885B"}, {"file_name": "3.png", "id": "3187958854840290", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974513_3187958858173623_2630061441027911886_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YdUTjmFaJxMQ7kNvwGfDmrO&_nc_oc=AdrLERxd3LTkmEvhZxFPizcbRovclyvsvYynJadzg7mWnKqKLtKGcxnhehuW6QG73DU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6R8gi7TdOetscdbWFC4VCKq8iFERRKKcNI-5Jcy3EiJw&oe=6A199F8F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (4).png", "id": "941214970482404", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031643_941214973815737_2432176783600565336_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=80Prw2SDQkIQ7kNvwEx77B-&_nc_oc=AdpIZ_n28E-sRzkfY7w-jr0Vz0744uXOK7l6xBUn_Zt0yA8-1zAqTl4fk-cEGfQ-nJ0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ntmyn1pkjRqGCqU1P7axRi-QOsq2mfpU4Cb83_eCwtQ&oe=6A199E72"}, "display_name": "Wingit", "keywords": [], "long_description": "Unleash Your Inner Bird in Aerial Dogfights and Races.\n\nEver dreamed of soaring through the skies as a majestic bird, engaging in thrilling air-to-air challenges, or participating in high-speed tag races?\n\nWe\u2019ve been developing a unique bird flapping and gliding mechanic that brings this experience to life in our upcoming multiplayer game, currently dubbed \u201cWingit\u201d.\n\nWe\u2019ve created a basic block-out map and implemented an infection game mode for testing purposes. However, we\u2019re eager to explore more game modes and perfect the overall experience.\n\nDepending on how you choose to fly, this game can be quite a lot of exercise :)\n\nWatch the attached video for a glimpse into the heart-pounding action and join our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN", "short_description": "Flap, glide, swoop, dip and flap to soar like a bird. Hang out with your friends or play a game of Tag, Hunt or make it up as you go."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Remio", "support_website_url": null, "website_url": "https://remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "sup
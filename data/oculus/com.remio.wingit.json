97781816389", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982584_926297785149722_4227410942138075850_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uiDnmOAoo0UQ7kNvwG7uIAH&_nc_oc=AdnB7aTf5TvFqz7nyAQ_zG3SL3oL6Yzb7aF6uCNXjTuS92003ew7wi3l3vvk1h9unDU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxB5e7WJGzcG_ULW29fl3_vlqzTKtr0srDXQyzKJYQc9w&oe=69BAA8A6"}, {"file_name": "5.png", "id": "673317157978047", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001732_673317161311380_6367319820395155286_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vITXavO4eKoQ7kNvwHcTjxV&_nc_oc=AdkhjMWyrTJOe8iPvJzk8BZVhzt0mmU_8DupZLcv-kR29vpOi0oHJdI--DMrEd7P2Ak&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzH3eCB9gHslJGBnoPBPHRcO8Ag1OjcJFSLYbTnA0CNCQ&oe=69BAA9F3"}, {"file_name": "Screenshot (447).png", "id": "628875279216230", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57566698_628875282549563_4913645439909033743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wVYvZseDNgEQ7kNvwGb7E9X&_nc_oc=AdkxhH-Rzk_B8RG8mKrXEW5U5c-7VAP_2W5hc66Sl3UKskDK334nTWuFjeQFHPw5gT4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfycU6FUMDQjPHdtmJiaHXqQ7oOgGkwxWyt_6nX1js60Lw&oe=69BA9C5B"}, {"file_name": "3.png", "id": "3187958854840290", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974513_3187958858173623_2630061441027911886_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hNMuFrUlGL8Q7kNvwGNXgiA&_nc_oc=Adly3o5gXCUO6mEj-aEk1HHNxNrr422pIG4oIIJQKeTYsmLqqTfuF89N62syPdaGNtk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxRJJa82wViG9pOF3Wm3VtsYDo0eqFBbyAslYbaddkavA&oe=69BAB38F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (4).png", "id": "941214970482404", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031643_941214973815737_2432176783600565336_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eh8Hd-ZFzwIQ7kNvwEUfLmc&_nc_oc=AdmbJ5lFc4vM4oOT6iJxzdHMqC9Dbz70tqlpUt0l1uwsFFP_HoxNh96XJ4bnTXppHWg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyYyXmHjVpBUG4kj5tZ2sXxl-k2rrQWHArMzbGbKke8_w&oe=69BAB272"}, "display_name": "Wingit", "keywords": [], "long_description": "Unleash Your Inner Bird in Aerial Dogfights and Races.\n\nEver dreamed of soaring through the skies as a majestic bird, engaging in thrilling air-to-air challenges, or participating in high-speed tag races?\n\nWe\u2019ve been developing a unique bird flapping and gliding mechanic that brings this experience to life in our upcoming multiplayer game, currently dubbed \u201cWingit\u201d.\n\nWe\u2019ve created a basic block-out map and implemented an infection game mode for testing purposes. However, we\u2019re eager to explore more game modes and perfect the overall experience.\n\nDepending on how you choose to fly, this game can be quite a lot of exercise :)\n\nWatch the attached video for a glimpse into the heart-pounding action and join our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN", "short_description": "Flap, glide, swoop, dip and flap to soar like a bird. Hang out with your friends or play a game of Tag, Hunt or make it up as you go."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Remio", "support_website_url": null, "website_url": "https://remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_d
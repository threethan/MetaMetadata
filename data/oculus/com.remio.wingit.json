ingit_Render_1.png", "id": "926297781816389", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982584_926297785149722_4227410942138075850_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-0TqdlBPrzEQ7kNvwGXusZg&_nc_oc=Adq5s_-Jy_dwoZ4BF18wgLl--B5W6DlJf3movGSR3m4AXO1tyMyVIgxTA1afQBubV7k&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZFqag7QLjr54vnWNLpTHtW-Hpoj6QiTIsKZ4-u1idCw&oe=6A54E826"}, {"file_name": "5.png", "id": "673317157978047", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001732_673317161311380_6367319820395155286_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q-osMaDlznEQ7kNvwHi8HfA&_nc_oc=AdoyhtPTk8s-TLSim1rrvGFce5rd5Ls9p3q8SJJcpRLnBtuMVMVvqH91SUPI0VnYLNU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCFvNO5-TMHsxp4M7Y4NILfOfk-pI4BYbD91rAV7DOPVQ&oe=6A54E973"}, {"file_name": "Screenshot (447).png", "id": "628875279216230", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57566698_628875282549563_4913645439909033743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9jchF88uYxYQ7kNvwELwmUo&_nc_oc=Adq_04y2KW-SYwBy7IZXKQo6DF63GjckVQ8XmCHAbH8PGfUR4LLGuzAbZ3cnrKcPzj8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAQryOpVhpXSa24i6ziWREkyB-a9BVKkhnBcvccdEXZ_g&oe=6A54DBDB"}, {"file_name": "3.png", "id": "3187958854840290", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974513_3187958858173623_2630061441027911886_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J5gBGwPtwqcQ7kNvwFQRVqc&_nc_oc=Adpr7EuWR2G3K-i2O5ReLaEpWxX8pa6Mk7bdWFZ3sPNptyDMM5ot7BBQzM0hO6fvXhY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAl74gkJYZUUuRofz7L-lqU5p3tX4CunBxYZVPV6985hw&oe=6A54F30F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (4).png", "id": "941214970482404", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031643_941214973815737_2432176783600565336_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WcB1kFjiSCEQ7kNvwFSgCQu&_nc_oc=Adq7qTSzCtNrzn3O4wUocEKUKRDzOTu-7Fchp5-ZL0WBU9DM42GiKxMQ-pwommPD_v4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDUscJnATEWdBzdyovuKZmPeJS4VzPUhDWxSKmaOsMxBg&oe=6A54F1F2"}, "display_name": "Wingit", "keywords": [], "long_description": "Unleash Your Inner Bird in Aerial Dogfights and Races.\n\nEver dreamed of soaring through the skies as a majestic bird, engaging in thrilling air-to-air challenges, or participating in high-speed tag races?\n\nWe\u2019ve been developing a unique bird flapping and gliding mechanic that brings this experience to life in our upcoming multiplayer game, currently dubbed \u201cWingit\u201d.\n\nWe\u2019ve created a basic block-out map and implemented an infection game mode for testing purposes. However, we\u2019re eager to explore more game modes and perfect the overall experience.\n\nDepending on how you choose to fly, this game can be quite a lot of exercise :)\n\nWatch the attached video for a glimpse into the heart-pounding action and join our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN", "short_description": "Flap, glide, swoop, dip and flap to soar like a bird. Hang out with your friends or play a game of Tag, Hunt or make it up as you go."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Remio", "support_website_url": null, "website_url": "https://remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "sup
ingit_Render_1.png", "id": "926297781816389", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982584_926297785149722_4227410942138075850_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5tBZZciVmuYQ7kNvwHIB3qq&_nc_oc=AdpPmm44rk_0gosoPSUgjgjqK-uYX833v7raQoGUzAAQCAJMQfWnw-ZePn8ms_qzgW0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGxzvomijGchdqJwaV_-xBjSPa2-aDXJLS338_YhhZXCA&oe=6A71E926"}, {"file_name": "5.png", "id": "673317157978047", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001732_673317161311380_6367319820395155286_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-U9BPljV2twQ7kNvwFiqBhI&_nc_oc=AdrIvUMsNbnUaEhS82WnEhLEXfQHijgNFZZkoUIAym1nCQ1hyLDqVrhsFF0WpIuTtTM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzXI8QFcziaO6oegWIK2wpZOrp-xOPGd3HWT6uAvLj9w&oe=6A71EA73"}, {"file_name": "Screenshot (447).png", "id": "628875279216230", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57566698_628875282549563_4913645439909033743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NK2PfhJF9ugQ7kNvwFlk4xq&_nc_oc=AdqCTxzrsuk-fudlMExmL7RJ1OaohQdMt4SXd1b5pHSORLq_BLPG1bluiydDfZNidIY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFxQpPFtcbPeqlnm47s1pcsYXJB8Ey9uG5WsZ2YfDSenw&oe=6A71DCDB"}, {"file_name": "3.png", "id": "3187958854840290", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974513_3187958858173623_2630061441027911886_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6w0IpiM3uqwQ7kNvwFr5jgq&_nc_oc=AdrsUS5_xEidRvXwJZdJwFA3WgBs5Os5U_JrTOU_vaEG0E-q24MVKsYofvVwQdvfCaY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqq52_Z-XdikEzfzxuAd9kCQ0upmG5oOLkAEzvS7Er_g&oe=6A71F40F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (4).png", "id": "941214970482404", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031643_941214973815737_2432176783600565336_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jXPk7AKXyvMQ7kNvwFYyAkM&_nc_oc=AdqR8GTGKr9Z1L6t4Tds5iGQwNWv7vHlzrf2wZddKe9zpBbe2Xyc_j1XL2Hm6K_DafI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEx60Q4eeW6OA8Ft90lyzMcGXnN9yFrJAG8qA-K745-4w&oe=6A71F2F2"}, "display_name": "Wingit", "keywords": [], "long_description": "Unleash Your Inner Bird in Aerial Dogfights and Races.\n\nEver dreamed of soaring through the skies as a majestic bird, engaging in thrilling air-to-air challenges, or participating in high-speed tag races?\n\nWe\u2019ve been developing a unique bird flapping and gliding mechanic that brings this experience to life in our upcoming multiplayer game, currently dubbed \u201cWingit\u201d.\n\nWe\u2019ve created a basic block-out map and implemented an infection game mode for testing purposes. However, we\u2019re eager to explore more game modes and perfect the overall experience.\n\nDepending on how you choose to fly, this game can be quite a lot of exercise :)\n\nWatch the attached video for a glimpse into the heart-pounding action and join our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN", "short_description": "Flap, glide, swoop, dip and flap to soar like a bird. Hang out with your friends or play a game of Tag, Hunt or make it up as you go."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.remiovr.com/privacy-policy", "developer_terms_of_service_url": "https://www.remiovr.com/terms-of-use", "publisher_name": "Remio", "support_website_url": null, "website_url": "https://remiovr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "sup
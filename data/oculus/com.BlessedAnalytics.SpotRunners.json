71-25/491825481_3414115468755742_3120240674586148925_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tz-k-FkCHf4Q7kNvwHTeH0c&_nc_oc=AdqpyASOzxkygFILvPPOSNSSvJPFiePs3oEMLhwCd9FaDbB-N785A5OvOfzraWk9A94&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZzDKJ2P-vmdRBXoYiFsNmje-OmoP65Ckb_TL91QUc-Q&oe=6AAFF679"}, {"file_name": "SpotRunnersNew_1440p_10.05.2026_15-22-49.png", "id": "959263916956965", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821796_959263920290298_8924066043555900867_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J-ip_FdV29gQ7kNvwFmk2J4&_nc_oc=Adod95NcEWL_71lqd0zkIeDcOP5-r8ZsH-nMpPgOHL0cU0sENYA2l8qvFnaz9rxcCbY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLg_So3WN5btVXrBiilokQGDVknCcQGnRJGeszC7vsaWw&oe=6AAFEB88"}, {"file_name": "SpotRunnersNew_1440p_10.05.2026_15-24-25.png", "id": "2727290510979996", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819854_2727290514313329_4639278692662495992_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1_nUhCTGMCkQ7kNvwEBKNNz&_nc_oc=Adrd5W1-LVZsB3RwoLs0b_iEit7IR9CTEyb0mXF2OyGplHFSp2IuerJt6et-2_3llBE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQICPIuSfa0pvoBuO9_CghZdQQYk8DZreDB-tBK4NV_f8w&oe=6AAFF2D4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Spot Runners (Down For Haitus)", "keywords": ["spot", "runners"], "long_description": "Welcome to Spot Runners! A Gorilla Tag Inspired game that uses your hands to move.\n\nShop (Mall) \ud83d\udecd\ufe0f\n- Buy Cosmetics with Spotty Coins!\n- Check out Sales and Limited-Time Bundles & Packs!\n- Make a Unique Style to show off to Friends!\n\nGames \ud83c\udfae\n- Zero Gravity | Float around in Space!\n- Spot Battles | Fight other Spots with swords while avoiding lava!\n- Nextbots | Get chased around by memes!\n- Colour Game | Stand on the right colour tile before it gets too late!\n\nNews \ud83d\udcf0\n- Get regular updates from Blessed Analytics!\n- Stay up-to-date to what's happening!\n\nThere is so many more stuff to explore in this game. What are you wating for?", "short_description": "Become a Spot"}]}, "developer_name": "Blessed Analytics", "developer_privacy_policy_url": "https://docs.google.com/document/d/1h-TiPEj091YizguawIzMY2qS-U_sFa4k5o59AMJUUOQ/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "BLESS!", "support_website_url": null, "website_url": "https://sites.google.com/view/spot-runners-meta/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27493640140328383"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825470_1671029384047392_2680774296347937269_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z51N4fRuIegQ7kNvwGC_G_4&_nc_oc=Adqn042bQ_fil2Hd5aU1K_7ty8PfeXoKu75RN5TkhgVp_IPO-uWBPKsrhtUv-mARiKU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIDVLPNM3wTXXeK0eNiBK3MhVaRqWHIFQpTV1BbH5ndSA&oe=6AB002FD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Spot Runners (Down For Haitus)", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Platformer", "id": "528142316460358"}], "re
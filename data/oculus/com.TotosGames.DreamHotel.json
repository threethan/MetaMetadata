19208906160492429_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PFx4E3IqrwsQ7kNvwHjXrbr&_nc_oc=AdqV4sgcHkN0bB2cm9APom37Fd5hBnR6RDro_Hqws8YGI4sN02GYOmjGxbrMa9f53Is&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRw4VIb3rI3-DGGd1_oRfGy9byik34SH5sovV8ZSPi_VQ&oe=6B085B0B"}, {"file_name": "05_cleaners.png", "id": "1831720024489794", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491824318_1831720031156460_8875312198280334940_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EDYFoOAeEMUQ7kNvwHzB58c&_nc_oc=Adr4TgHU0QcRmdbGF6Ouonl2WcYsBq4hW5y3mtPqlEVlCWsamY07DozINWSkXP5Y3aI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5QifzBQaMbyxUZx0qtoahN7zl0HPyfwHI6ehw94AXRQ&oe=6B0860D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover_2560x1440.png", "id": "1735530630863620", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823837_1735530634196953_1796277862825909178_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IsLZpwDK1wkQ7kNvwEdLLlx&_nc_oc=Adq7TA5sTNedfrBtOR9AIEaiweArdUxZNIDl2d7OvKfJKourhHLL5fXEoToq9xKMFMg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQQyY0Gm0tGzWQAdckl7QZ14JS4OXFNXURRlHKkgTfJw&oe=6B08531A"}, "display_name": "Dream Hotel", "keywords": ["Hotel", "Game", "Room", "Manage", "Upgrade"], "long_description": "Welcome to Dream Hotel VR, the ultimate hotel management experience! Immerse yourself in the exciting world of hospitality as you take charge of your very own hotel. Hire maids to keep your rooms spotless, employ receptionists to welcome guests with a smile, and upgrade your facilities to attract more visitors. Expand your hotel empire by developing new rooms and enhancing guest satisfaction. Are you ready to turn your hotel into a luxurious getaway and build the business of your dreams? The journey to becoming a hotel tycoon starts here!\n\nNew in this update:\n\u2
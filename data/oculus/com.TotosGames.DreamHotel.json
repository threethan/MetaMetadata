89EDC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Dream_Hotel_Cover_Landscape.png", "id": "959519448922242", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391775_959519452255575_7586123362154553298_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X0WXeNh13LIQ7kNvwFGsJsR&_nc_oc=AdoFLonjynZSzKwF2Ub0VXp5O1eafBoDL-9v1-7QAp9-0f-2nCwz8KYRP-AhHd1Dxuw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlGAx2XxRG6BjB-az1qkC8BigmKfKjvRMkmapelIBQ2A&oe=6AF88554"}, "display_name": "Dream Hotel", "keywords": ["Hotel", "Game", "Room", "Manage", "Upgrade"], "long_description": "Welcome to Dream Hotel VR, the ultimate hotel management experience! Immerse yourself in the exciting world of hospitality as you take charge of your very own hotel. Hire maids to keep your rooms spotless, employ receptionists to welcome guests with a smile, and upgrade your facilities to attract more visitors. Expand your hotel empire by developing new rooms and enhancing guest satisfaction. Are you ready to turn your hotel into a luxurious getaway and build the business of your dreams? The journey to becoming a hotel tycoon starts here!", "short_description": "Step into the world of hotel management with Dream Hotel VR! Hire staff, upgrade rooms, and expand your dream hotel to become the ultimate hospitality tycoon."}]}, "developer_name": null, "developer_privacy_policy_url": "https://totosgames.com/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Totos Games", "support_website_url": null, "website_url": "https://totosgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "528142316460358"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "
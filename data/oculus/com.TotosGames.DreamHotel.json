19208906160492429_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PFx4E3IqrwsQ7kNvwG3keiT&_nc_oc=Ado_eNT9sQ2zcW5mBYKZw4kKFXJSirESKXoEa9z7CxxT24_Vtny-xlpYZM5no_VYj7A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQg9YsviuxgRL8_rYM4MS4otPtFbYjzFHxVfDOwBxcOGw&oe=6B05B80B"}, {"file_name": "05_cleaners.png", "id": "1831720024489794", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824318_1831720031156460_8875312198280334940_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EDYFoOAeEMUQ7kNvwG7QUVg&_nc_oc=Adq7kWsDq3D-XZ1QfU4pLFoHkrTyZ8syT1YQMOfpx-hDgz7IIjbZeGkCCJmSNg7mwew&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7PlmTzr3RVqYGGLsmgvkmy00B0xAHwZTjn43N2m8f7Q&oe=6B05BDD6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover_2560x1440.png", "id": "1735530630863620", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823837_1735530634196953_1796277862825909178_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q_bvwoqKGLMQ7kNvwEJQZTC&_nc_oc=Adpy1WT3yrrdEzu4cGr-aNLzJTVzNYsucx_KpPQQ0T6PbkmKdYlvKnPipXuLSG5l9SI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYjOCaSfkFe8jt9gqRGZRwEAqzuoEOKlus0wjGpNSkEQ&oe=6B05B01A"}, "display_name": "Dream Hotel", "keywords": ["Hotel", "Game", "Room", "Manage", "Upgrade"], "long_description": "Welcome to Dream Hotel VR, the ultimate hotel management experience! Immerse yourself in the exciting world of hospitality as you take charge of your very own hotel. Hire maids to keep your rooms spotless, employ receptionists to welcome guests with a smile, and upgrade your facilities to attract more visitors. Expand your hotel empire by developing new rooms and enhancing guest satisfaction. Are you ready to turn your hotel into a luxurious getaway and build the business of your dreams? The journey to becoming a hotel tycoon starts here!\n\nNew in this update:\n\u2
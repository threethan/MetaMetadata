_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOTxAvpfoL-GRxXdY0Jyw6QfPmdXdwNQsEGUT5BSh9VbQ&oe=6ADF4A16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover_2560x1440.png", "id": "1735530630863620", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823837_1735530634196953_1796277862825909178_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8DogR_uAaaUQ7kNvwGJ97bf&_nc_oc=AdqNZh2WB6xeMw03zTjdl7kMlvIJ7z0Gk1-FLvlkIIFcdzTzr0Blo6laVnVSc6s8RbU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOADkpPwfiuzhpTrrZ40qQFCOC2V0aHerOlCltHb9vBLw&oe=6ADF749A"}, "display_name": "Dream Hotel", "keywords": ["Hotel", "Game", "Room", "Manage", "Upgrade"], "long_description": "Welcome to Dream Hotel VR, the ultimate hotel management experience! Immerse yourself in the exciting world of hospitality as you take charge of your very own hotel. Hire maids to keep your rooms spotless, employ receptionists to welcome guests with a smile, and upgrade your facilities to attract more visitors. Expand your hotel empire by developing new rooms and enhancing guest satisfaction. Are you ready to turn your hotel into a luxurious getaway and build the business of your dreams? The journey to becoming a hotel tycoon starts here!\n\nNew in this update:\n\u2022 Rooms that really grow: upgrade a room to add a private bathroom, then open it up into a luxury suite with a jacuzzi, TV and lounge.\n\u2022 Bigger rooms host more guests, and every guest pays for the stay.\n\u2022 Hire up to three cleaners for every area of your hotel.\n\u2022 A rebalanced economy and more music to build by.", "short_description": "Step into the world of hotel management with Dream Hotel VR! Hire staff, upgrade rooms, and expand your dream hotel to become the ultimate hospitality tycoon."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tolgakalaycioglu.com/totosgame/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_
_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q6MlYOKelXMQ7kNvwEf74wM&_nc_oc=AdoE_qCueMESehltXOOGPefJnpGjkWxM4LHzVRrT0zChU-AtOosLmU8rZEmBHmnQjq4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7-g3peYVZ9kH7I7cN6V-YN2NQoiValyiaK5sOtGGKMg&oe=6AFC8574"}, "display_name": "Jigsaw Puzzle VR", "keywords": [], "long_description": "-Procedurally generate puzzles from ANY image!\n-Never have to clean off the table before you do a puzzle again.\n-Turn off gravity to assemble puzzles in mid-air.\n-Never worry about missing puzzle pieces.\n-A no stress, high comfort, completely chill game - perfect for playing while listening to podcasts or audiobooks.\n-Comes with 30 puzzles.  Users may add any PNG or JPG images using image URLs found on the web.\n-Go to the JigsawPuzzleVR subreddit to make bug reports or feature requests!", "short_description": "Turn any image into a jigsaw puzzle!  No lost pieces!  No need to clear off the table!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.reddit.com/r/JigsawPuzzleVR/comments/jq6gy5/jigsaw_puzzle_vr_privacy_policy/", "developer_terms_of_service_url": null, "publisher_name": "Marrs.biz", "support_website_url": null, "website_url": "https://www.reddit.com/r/JigsawPuzzleVR/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "CASUAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "97628553045
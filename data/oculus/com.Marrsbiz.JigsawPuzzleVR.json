mble puzzles in mid-air.\n-Never worry about missing puzzle pieces.\n-A no stress, high comfort, completely chill game - perfect for playing while listening to podcasts or audiobooks.\n-Comes with 30 puzzles.  Users may add any PNG or JPG images using image URLs found on the web.\n-Go to the JigsawPuzzleVR subreddit to make bug reports or feature requests!", "short_description": "Turn any image into a jigsaw puzzle!  No lost pieces!  No need to clear off the table!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.reddit.com/r/JigsawPuzzleVR/comments/jq6gy5/jigsaw_puzzle_vr_privacy_policy/", "developer_terms_of_service_url": null, "publisher_name": "Marrs.biz", "support_website_url": null, "website_url": "https://www.reddit.com/r/JigsawPuzzleVR/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "CASUAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "976285530455884"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974444_775063703437366_1562930008131815224_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qvQlUvndy38Q7kNvwH7y_yU&_nc_oc=AdljiEM0-SdqedBXegY2DHXNFHY3VuL0WBEWKgnYb2fwoJFYJsg_1CtgR2xCHM6RWtw&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Afu470w94nnqLWQUaOzsdIoEPog2w9qHLoQLhEn-aPSd_Q&oe=69A1A0AF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid":
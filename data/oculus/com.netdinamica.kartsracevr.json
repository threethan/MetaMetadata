uscdn.com&_nc_ss=7f20f&oh=00_Af4bFCWksJLCwwnC_8MmN4s2Xntsn3axRKagGNzCdyhpaw&oe=6A11BB6E"}, {"file_name": "migrated_image.png", "id": "222359855549706", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/11162680_947274328746084_1587586441368567808_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O1eyyvUWhGsQ7kNvwFW2MB_&_nc_oc=Adr15vgqQddWK1Ua89eSLezHGlGbxCoP-Pzu7pO4etxbwxD0qbMkMnZ8wx4leU_vRUg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7vxd3mgD3kwO-v7pTXKfochookTYJ4-n3h2sKsQgvD2A&oe=6A11C757"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Karts Race VR", "keywords": ["karts", "kart", "race", "sprint", "run"], "long_description": "Get in the driver's seat and race with you kart.\nFell the sensation of three different racing environment.\n\nThree different environment\n-Farm, racing at farm, trees, corn lot to see and feel.\n-Fantasy, beautiful environment with giants mushroom, trees, bleachers and more.\n-Desert Dunes, running and going up and down between the dunes, this a exciting race. \n\nYou can play with touchpad, no gamepad required.\nAlso is compatible with gamepad and gear vr controller\n\nCustomize your cart, pilot, music and level of challenge\nThis is fun for everybody\nLets race and have lots of fun!", "short_description": "Get in the driver's seat and race with you kart.\nFell the sensation of three different racing environment.\n\nYou can play with touchpad, no gamepad required.\nAlso is compatible with gamepad and gear vr controller\n\nThree different environment\nFarm, Fantasy and Desert Dunes\n\nCustomize your cart, pilot and level of challenge\nThis is fun for everybody\nLets race and have lots of fun!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.netdinamica.com.br/games/kartsracevr/privacy.html", "developer_terms_of_service_url": "http://www.netdinamica.com.br/games/kartsracevr/terms.html", "publisher_name": "NetDinamica", "support_website_url": null, "website
BFtZbWEXebVMkbH2raILFcFG8S2xucNuHZ7d3gj-zl_EyHY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxxPR-JJ9KBsQBtaOhwHtxUhOKfc6_Btr6MWrbnU972g&oe=6A986402"}, {"file_name": "SampleScene_Custom..._25.07.2025_16-32-56.png", "id": "518693184637290", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827703_518693191303956_7839205231068648033_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PHB3dEU4Lf4Q7kNvwGIQ1RF&_nc_oc=Adp1LhQpAOXwjENfWZ63VsbYFDnQrLOmvkgDKPZAmGbLjrRK8L4YjucFFMKq6f4avl8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJRkr3Lbrt1xNX6acX8GQy03p93yTQoDbTuc9PUDndP9A&oe=6A985B37"}, {"file_name": "SampleScene_Custom..._25.07.2025_16-32-46.png", "id": "1488589808821368", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499308103_1488589812154701_8150588946096799521_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pbce21qaGq0Q7kNvwFsRrOO&_nc_oc=Adq_gAqMaiEF_bLgrpgi82IJObxoB451CZIXdL5BTNFcrsjmg_BQ_bWyQPGmZCbdemE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIaacEwhE_TfKbPstpU6NElXy1NIalWY-aU4Wmv-Kwuzw&oe=6A984C52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SampleScene_Custom..._25.07.2025_16-34-11.png", "id": "1072763951665134", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830888_1072763954998467_5587248318482055014_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UbweZRSlh20Q7kNvwGYCkKI&_nc_oc=Ado3zvOpnzoK3p0QHUwJE7iUCsGL6tPIkOOV1o6q0armIiybBl8HBuNeR0KbkcwX4c0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUGrMEqgcWrDxAGMRsvreX-KRGOOxQkUGhTsVK9bus0w&oe=6A9862E5"}, "display_name": "Gorillium", "keywords": ["tag", "Locomotion", "infection"], "long_description": "Gorillium is an immersive VR experience that lets you unleash your inner gorilla in a high-energy world of climbing, swinging, and exploration. Navigate through a massive treetop playground built with intricate wooden platforms, tall trees, and hidden routes \u2014 all designed to test your agility and creativity.\n\nWith intuitive movement controls that mimic real climbing, you'll feel the thrill of parkour-like traversal as you jump from branch to branch. But Gorillium is more than just movement \u2014 express your style with a variety of fun hats, body gear, and holdable items from the in-game customization room.\n\nWhether you're exploring solo or hanging out with friends, Gorillium offers an unforgettable blend of physical challenge, freedom, and fun. No buttons \u2014 just your hands, your skills, and a jungle of possibilities.\n\n", "short_description": "Welcome to Gorillium \u2014 a thrilling VR experience where you climb, swing, and explore a treetop world. Customize your look and unleash your inner gorilla!"}]}, "developer_name": "AnotherVine", "developer_privacy_policy_url": "https://sites.google.com/view/gorillium-privacy-policy/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Wiggo", "support_website_url": null, "website_url": "https://sites.google.com/view/gorillium-privacy-policy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24292702137062995"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_re
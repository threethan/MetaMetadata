xq3&_nc_oc=Ado-vuIJro830dw7Qt5OwhFMAAWH4Du561-TR0V1jJrDISG2kl_P5xBvyTwapI2DEcc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUvFEAMziIgw4PitFWEtdxBcD5abs6Qhu91qi3nzR3I6A&oe=6B0EF352"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SampleScene_Custom..._25.07.2025_16-34-11.png", "id": "1072763951665134", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830888_1072763954998467_5587248318482055014_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZNfKkFmtmUIQ7kNvwGku1Rm&_nc_oc=Adr91vQ0vjxNhz023Xtbh_aqWyyG2aZRDTCFqUrRCiCHLPps3lnu5h9I-n5w3IoskrQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWj1yMzVIf9So6ldno9ZYk7DCN6cqvE8whmqyr2cYVZpw&oe=6B0F09E5"}, "display_name": "Gorillium", "keywords": ["tag", "Locomotion", "infection"], "long_description": "Gorillium is an immersive VR experience that lets you unleash your inner gorilla in a high-energy world of climbing, swinging, and exploration. Navigate through a massive treetop playground built with intricate wooden platforms, tall trees, and hidden routes \u2014 all designed to test your agility and creativity.\n\nWith intuitive movement controls that mimic real climbing, you'll feel the thrill of parkour-like traversal as you jump from branch to branch. But Gorillium is more than just movement \u2014 express your style with a variety of fun hats, body gear, and holdable items from the in-game customization room.\n\nWhether you're exploring solo or hanging out with friends, Gorillium offers an unforgettable blend of physical challenge, freedom, and fun. No buttons \u2014 just your hands, your skills, and a jungle of possibilities.\n\n", "short_description": "Welcome to Gorillium \u2014 a thrilling VR experience where you climb, swing, and explore a treetop world. Customize your look and unleash your inner gorilla!"}]}, "developer_name": "AnotherVine", "developer_privacy_policy_url": "https://sites.google.com/view/gorillium-privacy-policy/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Wiggo", "support_website_url": null, "website_url": "https://sites.google.com/view/gorillium-privacy-policy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24292702137062995"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617806_1753255961956951_108218352872719932_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IZPtZRAn_hAQ7kNvwEG3ibT&_nc_oc=AdrV6u2AHauPcJazp-sqQLb2prwcS4TDy8EpCxZYQlEfdsKEOsDTNdq2ZtEKBcSALpM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUTiZdaZfKv8dIEECQJH15QUW0uObtmq10oE0-F-g3l0w&oe=6B0F2105"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Gorillium", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}], "release_date": 1754318340, "lastRevision": {"nodes": [{"id": "24236474456019097", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "24236474412685768", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"i
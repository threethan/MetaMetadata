shHlMgsrov83-hgUloXpeM8RymLSQUE94SuGgPEg1k8YzTY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7GnfXZvOYA7k648QFoXxQ7MFSMd9QYysUF82J05C7hg&oe=6AE89742"}, {"file_name": "SampleScene_Custom..._25.07.2025_16-32-56.png", "id": "518693184637290", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491827703_518693191303956_7839205231068648033_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E28fD1U_JpIQ7kNvwE0QmBY&_nc_oc=AdplZWxVHCymrwjPo4J7eXCKn7Q_AbSxMAVnAjYN-Bll3ZJEWqnN47-19PTRUgn-1Sk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDcaFadcTd0MbT_SfQeuNHjHLSMD-7XdH24ROPnbUwBg&oe=6AE88E77"}, {"file_name": "SampleScene_Custom..._25.07.2025_16-32-46.png", "id": "1488589808821368", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499308103_1488589812154701_8150588946096799521_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_2HMr_qUQO0Q7kNvwHCe3rr&_nc_oc=AdrgKgP4LWqn6UbCrB_Q0t8tbyzKYVA1Zgn-7ywMFjG_yiiasNpb3aeNFThiIgFRNxA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkfnoMMBmWpZ7uGLu05anI73epbFiRbD0vlyEqn02psg&oe=6AE8B7D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SampleScene_Custom..._25.07.2025_16-34-11.png", "id": "1072763951665134", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491830888_1072763954998467_5587248318482055014_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3W8ZQzM5S0oQ7kNvwHqruUp&_nc_oc=Adr2ShxBpt08XM3uoLmP9aF5xPF7qUV3dc_VweK4aul9mnxpx44CMp4jn_15X7Zc7Os&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjsPVjK6nTx_oTi_QsJQZIf4Hh2uBy2Bzzt3EF77oMQA&oe=6AE89625"}, "display_name": "Gorillium", "keywords": ["tag", "Locomotion", "infection"], "long_description": "Gorillium is an immersive VR experience that lets you unleash your inner gorilla in a high-energy world of climbing, swinging, and exploration. Navigate through a massive treetop playground built with intricate wooden platforms, tall trees, and hidden routes \u2014 all designed to test your agility and creativity.\n\nWith intuitive movement controls that mimic real climbing, you'll feel the thrill of parkour-like traversal as you jump from branch to branch. But Gorillium is more than just movement \u2014 express your style with a variety of fun hats, body gear, and holdable items from the in-game customization room.\n\nWhether you're exploring solo or hanging out with friends, Gorillium offers an unforgettable blend of physical challenge, freedom, and fun. No buttons \u2014 just your hands, your skills, and a jungle of possibilities.\n\n", "short_description": "Welcome to Gorillium \u2014 a thrilling VR experience where you climb, swing, and explore a treetop world. Customize your look and unleash your inner gorilla!"}]}, "developer_name": "AnotherVine", "developer_privacy_policy_url": "https://sites.google.com/view/gorillium-privacy-policy/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Wiggo", "support_website_url": null, "website_url": "https://sites.google.com/view/gorillium-privacy-policy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24292702137062995"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_re
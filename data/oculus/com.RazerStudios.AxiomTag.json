and gameplay features. The goal of Axiom Tag is to create a fun, competitive, and constantly evolving experience where players can explore new environments and master their movement skills.\n\nWhether you're practicing your routes in the forest or playing with friends, Axiom Tag is just getting started. Stay tuned for major updates as the game continues to grow and improve.", "short_description": "Axiom Tag is a up and coming game which may not have lots now, but will be sure to EXPAND massively during the coming months."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/17Ig4CRCUupWGdLq9aWGqzIgHkJT-GAnkml3jJQiWcCU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "RazerStudios", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1fpCn_T5HrSdVZPOrUfy76_KB7R5zaTEHz6cRiDO9pb0/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26890511340550144"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307339_828421230270400_3245126999713195702_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fy1s0fy8yz0Q7kNvwHUQCl5&_nc_oc=Adrm4yDUdq5V_L3LijJ5ErbWJDEnUQkr1lfwrEruDhpmyBR9BsYUF3_REaZHiAAh2OI&_nc_zt=3&_
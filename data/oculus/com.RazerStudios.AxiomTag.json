w&oe=69EE241C"}, {"file_name": "4.png", "id": "1229641606030491", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303971_1229641609363824_3989616577216463363_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WtGomqQ72IoQ7kNvwGs3MYH&_nc_oc=AdptuYC0s-oL5HdBmvmFxcf9Wnyrjs2fypQMBMdo9RBi3QGP5-yqXjeXdZn_YYl0PTs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0J4_o246a8ynEMUdL69JW-GC-3ZpXUrRe2r9GNrpr5QA&oe=69EE15B0"}, {"file_name": "5.png", "id": "3622765287863243", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298502_3622765291196576_8154575508714963384_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zTZnREyyEvsQ7kNvwFrAtjp&_nc_oc=Adr9dPm13I29dMucKNZHrE4OFlMaH8DBZW1JdFQTJYHah88mK36dnDv9R8u5Dw_JNlI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af24iWaFD5nTAdtao7SBPfGf32GceOnxzTwuEpQOKgZtSg&oe=69EE1A78"}, {"file_name": "2.png", "id": "908131141928218", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499308050_908131145261551_5351273903887444646_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i7VEoG5cauoQ7kNvwHewtH7&_nc_oc=AdoDlRbHkew4tk0hEartkahRigk7r-695HBSjKemwXE10gQdLeOw8qv0IsH9Zsv5SKY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0tlpxgnUfsGhVg098lICNu15CJQBCS5srmQsmtc-BaMQ&oe=69EDF69B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Axiom Tag", "keywords": ["ATAG", "AxiomTag", "Monke", "Tag"], "long_description": "Axiom Tag is an up-and-coming movement-based multiplayer game inspired by the fast-paced fun of Gorilla Tag. While the game is still in its early stages of development, it already features a forest environment where players can run, climb, and chase each other using smooth locomotion mechanics.\n\nRight now the world of Axiom Tag may seem simple, but this is only the beginning. The game is actively being developed and will expand massively over the coming months with new maps, mechanics, cosmetics, and gameplay features. The goal of Axiom Tag is to create a fun, competitive, and constantly evolving experience where players can explore new environments and master their movement skills.\n\nWhether you're practicing your routes in the forest or playing with friends, Axiom Tag is just getting started. Stay tuned for major updates as the game continues to grow and improve.", "short_description": "Axiom Tag is a up and coming game which may not have lots now, but will be sure to EXPAND massively during the coming months."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/17Ig4CRCUupWGdLq9aWGqzIgHkJT-GAnkml3jJQiWcCU/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "RazerStudios", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1fpCn_T5HrSdVZPOrUfy76_KB7R5zaTEHz6cRiDO9pb0/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26890511340550144"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1546981846365328"}]}, "baseline_offer": {"id": "1546981846365328"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773252840, "status": "PUBLISHED", "id": "1546981846365328"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []
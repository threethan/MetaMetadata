1702769_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yolYJ70budEQ7kNvwGR--ql&_nc_oc=AdpStBRESc0hml8p0tl2y65UiZ7Sk4JAM0rcI01SkCzyp8NiLrqlnTEtrzdjpAmBQR8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzWVk4uB1BKU8v6_BWjN1NF8fj0MV7ROpiUoN4qCV_8Q&oe=6AAC0445"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hexa Taggering", "keywords": [], "long_description": "Hexa Taggering is an exciting game that offers players a unique blend of fun and competitive gameplay. With four engaging game modes, players can enjoy a variety of experiences, all while showcasing their agility and teamwork skills in a vibrant, monkey-themed environment.\nDive into the world of Hexa Taggering and experience the thrill of monkeying around with friends and players from around the globe! Whether you prefer casual play or intense competition, there's something for everyone in this dynamic fangame.", "short_description": "A new interesting Game where you move with hand."}]}, "developer_name": "JustieVR1", "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vTMxeqMt-v65OZCYSWIlETWc4qOQ_oUYXRt5qdDCby2qdVnrhpVFAYppY_YlkadD3uxAXP84uWyIbea/pub", "developer_terms_of_service_url": null, "publisher_name": "JustieVR1", "support_website_url": null, "website_url": "https://docs.google.com/document/d/e/2PACX-1vTSsxBIoHIyTIxmDqba6leNjdk0HdO9A3tOeALwGDnzishwRKJTHsaGbGKpBPDmsFxhHVKAZCR3yS4-/pub", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"]
X2qe7uQnrK7N3y3k12l0fomtIU9u1VAm1ve5wAw&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfudeIgHO0_IBsky-dKJdrl9dHPNlMeJM6peL_DvIRnkfQ&oe=69A1817E"}, {"file_name": "Untitled design (4).png", "id": "634600899299950", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/473393432_634600912633282_886284553765769839_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FsxpI7efd2IQ7kNvwHoqkDE&_nc_oc=AdmY_3D3SNRF2lTWaVF50tVEQ6Eo6if3h8gNZzpdSeu6dDckf28h2nY7jq-0Be1_i5g&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_AfvIOtNZfT-VBT_R3nu0hFOxqT9h2suntf4IcJJifJ8dfw&oe=69A18883"}, {"file_name": "Untitled design (5).png", "id": "599929739698149", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/473391986_599929746364815_4596362304971124303_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xwIie_6oA_AQ7kNvwHeglR9&_nc_oc=Adk2Z33aR9T7GahN1qItKggM20CtD_RtGyESPNzlDl8JcJFIWPOrwhwiTxe6J0y2shw&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfsErUJMUiK7jU37vd7WX7n9V-ScBq9ivLjxVBghRfCbbw&oe=69A18DAA"}, {"file_name": "Untitled design (6).png", "id": "551028238001682", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/473393507_551028241335015_5004598522662507686_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N1jT0AGUAHkQ7kNvwGJn_DV&_nc_oc=Adll31anCNZ3ZsoCgDr8jJAtxcmdmTaF5C8pdcNTvpXHYZPg9Mp_eBwspa3gB-q2PIM&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfssQCdkUQOdvTsFjGGlWnF2eRW06stOsvRqzOR7b_pwJg&oe=69A19BC4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hope", "keywords": [], "long_description": "Hope is an innovative VR movement-based game that puts you in full control of your mobility. Using only your hands, you\u2019ll run, jump, climb, and swing through dynamic environments with intuitive locomotion mechanics designed for high-speed action and precise control. Whether you're scaling towering obstacles, racing through complex courses, or competing in intense multiplayer modes, every movement feels fluid and immersive. With a focus on freedom and creativity, Hope offers a unique gameplay experience where skill and strategy define your success. Challenge your friends, master your movement, and explore ever-expanding worlds in this thrilling VR adventure. Are you ready to move?", "short_description": "Hope is a fast-paced VR movement game where players use hand-based locomotion to run, jump, and climb through immersive environments. Master fluid movement, compete with others, and explore a dynamic world in this thrilling multiplayer experience."}]}, "developer_name": "Aetheria", "developer_privacy_policy_url": "https://sites.google.com/view/aetheria-hope/privacy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/aetheria-hope/tos", "publisher_name": "Tom", "support_website_url": null, "website_url": "https://sites.google.com/view/aetheria-hope/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP", "SINGLE_USER"], "id": "8649771261790211"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/473391959_505137809057326_336463633148730664_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1niwtNxKyIYQ7kNvwG3uSw5&_nc_oc=Adkv4GeJUjTz_7kju79slM_w-gYS-2zO7gyC8fl612T8A9XEzx36KOxL5tjSsLaHatI&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfuvNb209YYS2clAh4WxjRhopZsDuFZozGM_A-Yan4wwfA&oe=69A18585
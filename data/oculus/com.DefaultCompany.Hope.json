5_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GWZxEsxGtWEQ7kNvwHnCCy9&_nc_oc=AdpXh8wTDG1P-f3YHtC2ryDA24HN97jpQWm-K050rJLWBz5dyzkdpPkgV2UDVvxb960&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Fm3MaOk2-2kK8vLJ7QStZOe-Kopoq44XRrPNqYQunhA&oe=6A36B33E"}, {"file_name": "Untitled design (4).png", "id": "634600899299950", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/473393432_634600912633282_886284553765769839_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xaeznx05nlkQ7kNvwFZSBdx&_nc_oc=Adph-1eqMQoO2laXYwVLhayBWvKUqOgAuGekC3zYqpqRMhRUv3pnN3MLHoRMDB8VHZE&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__gS3-ro4gZpu_nliqwQd8yFxVKOXbTOWdPmyCACd18A&oe=6A36BA43"}, {"file_name": "Untitled design (5).png", "id": "599929739698149", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473391986_599929746364815_4596362304971124303_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s1tJo9meI10Q7kNvwH_X_s_&_nc_oc=Adp45IclejtUEhOiZgPwGyHIrf-4W1Quq2pZm_nIvn30hkuJhc5JuVvIKQqhUOVhfLc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9pOS1-iBgE3B-ZV2lm1m8HWpl2JrqJYBbwpxbCRkUI2w&oe=6A36BF6A"}, {"file_name": "Untitled design (6).png", "id": "551028238001682", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/473393507_551028241335015_5004598522662507686_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PdaKXiri9tgQ7kNvwEvYxq5&_nc_oc=AdoKr6fHgPkLCOoep0tuVPMz_kHYhqNfc8qECO2qZxjdhpkutA7vaa-wEvIrH4MZeys&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-BH5XpIVKpvthd3WUFuEo3BcUIrYKH-j40t2Id-LcNwQ&oe=6A369544"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hope", "keywords": [], "long_description": "Hope is an innovative VR movement-based game that puts you in full control of your mobility. Using only your hands, you\u2019ll run, jump, climb, and swing through dynamic environments with intuitive locomotion mechanics designed for high-speed action and precise control. Whether you're scaling towering obstacles, racing through complex courses, or competing in intense multiplayer modes, every movement feels fluid and immersive. With a focus on freedom and creativity, Hope offers a unique gameplay experience where skill and strategy define your success. Challenge your friends, master your movement, and explore ever-expanding worlds in this thrilling VR adventure. Are you ready to move?", "short_description": "Hope is a fast-paced VR movement game where players use hand-based locomotion to run, jump, and climb through immersive environments. Master fluid movement, compete with others, and explore a dynamic world in this thrilling multiplayer experience."}]}, "developer_name": "Aetheria", "developer_privacy_policy_url": "https://sites.google.com/view/aetheria-hope/privacy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/aetheria-hope/tos", "publisher_name": "Tom", "support_website_url": null, "website_url": "https://sites.google.com/view/aetheria-hope/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP", "SINGLE_USER"], "id": "8649771261790211"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/473391959_505137809057326_336463633148730664_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CQuYI0RmAPwQ7kNvwGqGhsG&_nc_oc=AdrCYNALAeB0HL
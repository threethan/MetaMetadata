g?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qaUs2jZpGlAQ7kNvwGQh5jx&_nc_oc=AdqQt6PxyIignPvm-oBaIUr5s7ZJBgmYlpiTtA1xXJgTpTl7H-3wuy27MrDPrTlur98&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBIX7IP9JmKrTTU95XYEORHH4oC99e1x7Xf9aVF5uSgmQ&oe=6A65F0FE"}, {"file_name": "Untitled design (4).png", "id": "634600899299950", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393432_634600912633282_886284553765769839_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t3MyhIhOSUUQ7kNvwGeJ9sP&_nc_oc=AdqBM6WQYkwTjq52afdqHIAWhndNJNzuFW1IxNEg9GyJksnZ-PUvbFb-TUlI2BVjxIc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBzenBCc3eea_mNJ6HHpX8VBBEnQe-h8ZYxvMi3UoYDow&oe=6A65F803"}, {"file_name": "Untitled design (5).png", "id": "599929739698149", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391986_599929746364815_4596362304971124303_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QwSLvL7s2MEQ7kNvwEUeqpO&_nc_oc=Ado41dI6xY65oIG7LZemWzex6u173-OV7tHMlkETWL_q2yHsHwE-wdM6Daej237ZLVg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAwggupJqnMb7KEpoO88f-ilZe9E1Ml7520MQYcwBZosg&oe=6A65FD2A"}, {"file_name": "Untitled design (6).png", "id": "551028238001682", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393507_551028241335015_5004598522662507686_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cLomlB56y8AQ7kNvwGasLDq&_nc_oc=AdqS5mNiBmIK1qnfhPywsm1FGXdp654k6bPAmXkoJ79eCxgW_MQRfqSMCv_x_M4KApk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-OVReHmDhTmf5IOol7P_rythzf1AwKgPoOhZGqWFonQ&oe=6A660B44"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hope", "keywords": [], "long_description": "Hope is an innovative VR movement-based game that puts you in full control of your mobility. Using only your hands, you\u2019ll run, jump, climb, and swing through dynamic environments with intuitive locomotion mechanics designed for high-speed action and precise control. Whether you're scaling towering obstacles, racing through complex courses, or competing in intense multiplayer modes, every movement feels fluid and immersive. With a focus on freedom and creativity, Hope offers a unique gameplay experience where skill and strategy define your success. Challenge your friends, master your movement, and explore ever-expanding worlds in this thrilling VR adventure. Are you ready to move?", "short_description": "Hope is a fast-paced VR movement game where players use hand-based locomotion to run, jump, and climb through immersive environments. Master fluid movement, compete with others, and explore a dynamic world in this thrilling multiplayer experience."}]}, "developer_name": "Aetheria", "developer_privacy_policy_url": "https://sites.google.com/view/aetheria-hope/privacy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/aetheria-hope/tos", "publisher_name": "Tom", "support_website_url": null, "website_url": "https://sites.google.com/view/aetheria-hope/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP", "SINGLE_USER"], "id": "8649771261790211"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391959_505137809057326_336463633148730664_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JExZuysXhAAQ7kNvwGranFD&_nc_oc=Adqi6Np-Y1KeoRt57z8L2R
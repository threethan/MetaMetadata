g?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yDZ_79jpFY8Q7kNvwEhnXBY&_nc_oc=AdrWDEkUTfyX-TUzEOFZqGUQEjvf8-IAaSP82MliOKGxy4IqzVz4BZDPxIEG3rxFi6w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5sROGW2_KE6QEmsOFTAA-qFBNiJF3J5Lc6waVcqITWBQ&oe=6A01F73E"}, {"file_name": "Untitled design (4).png", "id": "634600899299950", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393432_634600912633282_886284553765769839_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U9lN7_bzPuQQ7kNvwEd8C39&_nc_oc=AdqgI0pUBXPrCrClh_YadFckNMT8iwH_r6oWDNJ4z-F5tTqINKhy4-42DLGX4XO-O_o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4V8ITf4EwA3xwZ5f-BpsXVOCBH2NuDsIMVMWZN5S4yfA&oe=6A01C603"}, {"file_name": "Untitled design (5).png", "id": "599929739698149", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391986_599929746364815_4596362304971124303_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cy2gYf3qoVoQ7kNvwHURic9&_nc_oc=AdrPWBfa-01fbika3qaGJbtCl2k__GYn2Cq0q5NTrZgR-Tg0AkZNwuDRiInh97EzcnI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6w3J0BzgnRDC7t-kIsK_th86OXHJ4e6k6iApyenV23Vw&oe=6A01CB2A"}, {"file_name": "Untitled design (6).png", "id": "551028238001682", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393507_551028241335015_5004598522662507686_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VXxFUUDWi6oQ7kNvwHErRxY&_nc_oc=AdoDYl3Xy0X4TD6bLZBlyOZOxURtJAo6rXNMz7mkPNjdaaTtPy7FR0M9aimKD61ZF0c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6dRMXdUAjbubisb8ql6iXWo5X5cdC4zIN2JcFds_jfKQ&oe=6A01D944"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hope", "keywords": [], "long_description": "Hope is an innovative VR movement-based game that puts you in full control of your mobility. Using only your hands, you\u2019ll run, jump, climb, and swing through dynamic environments with intuitive locomotion mechanics designed for high-speed action and precise control. Whether you're scaling towering obstacles, racing through complex courses, or competing in intense multiplayer modes, every movement feels fluid and immersive. With a focus on freedom and creativity, Hope offers a unique gameplay experience where skill and strategy define your success. Challenge your friends, master your movement, and explore ever-expanding worlds in this thrilling VR adventure. Are you ready to move?", "short_description": "Hope is a fast-paced VR movement game where players use hand-based locomotion to run, jump, and climb through immersive environments. Master fluid movement, compete with others, and explore a dynamic world in this thrilling multiplayer experience."}]}, "developer_name": "Aetheria", "developer_privacy_policy_url": "https://sites.google.com/view/aetheria-hope/privacy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/aetheria-hope/tos", "publisher_name": "Tom", "support_website_url": null, "website_url": "https://sites.google.com/view/aetheria-hope/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP", "SINGLE_USER"], "id": "8649771261790211"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391959_505137809057326_336463633148730664_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PT3_kukN5LMQ7kNvwE4UFW0&_nc_oc=Adqc7KTVc4RzEWvdk1Ha_P
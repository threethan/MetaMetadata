275_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tS_mwSAg8mEQ7kNvwHmM_zx&_nc_oc=AdrQxR3u4VN8rspySw0G57RNs3AOUfwA5mTH_IXCWpzJkzY6LdSyk2WCdF7P2B5f-8Y&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFHHH3iQSLGRumYgVlH3qJ8G6UjDFb-hrILhu5C2EU9kA&oe=6A8D7DFE"}, {"file_name": "Untitled design (4).png", "id": "634600899299950", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473393432_634600912633282_886284553765769839_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gb2oMyGYdcwQ7kNvwFI7HmO&_nc_oc=AdrRaogSq6I5CzttUqhvsUh-WoTDjQGdGyj5DwXA7XcO7HNGIoTSgHz9GvU-U9AXiWs&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHsGqaO5vwJnw9NBWwsjkAL8JybhFFLPVbDx-yPaXIwEw&oe=6A8D8503"}, {"file_name": "Untitled design (5).png", "id": "599929739698149", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473391986_599929746364815_4596362304971124303_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dtyv5i9k_yAQ7kNvwHZqsFz&_nc_oc=AdqMV9Var25dQCa9Gr5mwx9_Nz0WqFWEhH18QBJzte7PTQ85zvVVT964jvUpxVrC0Z8&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3iW-4dk7_rT9_cIzRboXhYY_DvAPkx9q9c3nBgSFSxw&oe=6A8D8A2A"}, {"file_name": "Untitled design (6).png", "id": "551028238001682", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473393507_551028241335015_5004598522662507686_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TmfskhitZG0Q7kNvwEJOxiN&_nc_oc=AdpxuRkj4UssZrxEGIxOjhkJXObDRRJVedcje1GEC5OyAAgRx2ViWiG9t8zL9ljJXAo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyt00iQ-ELtM4yJ_4XsuizSX8jKmb_GZWaYYc6VvY2KA&oe=6A8D9844"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hope", "keywords": [], "long_description": "Hope is an innovative VR movement-based game that puts you in full control of your mobility. Using only your hands, you\u2019ll run, jump, climb, and swing through dynamic environments with intuitive locomotion mechanics designed for high-speed action and precise control. Whether you're scaling towering obstacles, racing through complex courses, or competing in intense multiplayer modes, every movement feels fluid and immersive. With a focus on freedom and creativity, Hope offers a unique gameplay experience where skill and strategy define your success. Challenge your friends, master your movement, and explore ever-expanding worlds in this thrilling VR adventure. Are you ready to move?", "short_description": "Hope is a fast-paced VR movement game where players use hand-based locomotion to run, jump, and climb through immersive environments. Master fluid movement, compete with others, and explore a dynamic world in this thrilling multiplayer experience."}]}, "developer_name": "Aetheria", "developer_privacy_policy_url": "https://sites.google.com/view/aetheria-hope/privacy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/aetheria-hope/tos", "publisher_name": "Tom", "support_website_url": null, "website_url": "https://sites.google.com/view/aetheria-hope/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP", "SINGLE_USER"], "id": "8649771261790211"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473391959_505137809057326_336463633148730664_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tdOCHv1GDBEQ7kNvwFZ8RtW&_nc_oc=Adof9tbeW8
0yCBRceAo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJEtOMROIOoeRgRaLg8QeVZT5tEetGnC817wOv5oj7smQ&oe=6A999FEA"}, {"file_name": "Untitled design (6).png", "id": "551028238001682", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393507_551028241335015_5004598522662507686_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cGmD28EESzkQ7kNvwEcCOkT&_nc_oc=Adp2ilyJ5XS42ZerfvXm0SyPUXXclFenlrXN-eqVz2aSbQfz0L4tLwjyvECnFoQc1x0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIcvx7LiBGXjtsXJ7NrugOTUsccca3_49o5HdE5Prs0VA&oe=6A9975C4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hope", "keywords": [], "long_description": "Hope is an innovative VR movement-based game that puts you in full control of your mobility. Using only your hands, you\u2019ll run, jump, climb, and swing through dynamic environments with intuitive locomotion mechanics designed for high-speed action and precise control. Whether you're scaling towering obstacles, racing through complex courses, or competing in intense multiplayer modes, every movement feels fluid and immersive. With a focus on freedom and creativity, Hope offers a unique gameplay experience where skill and strategy define your success. Challenge your friends, master your movement, and explore ever-expanding worlds in this thrilling VR adventure. Are you ready to move?", "short_description": "Hope is a fast-paced VR movement game where players use hand-based locomotion to run, jump, and climb through immersive environments. Master fluid movement, compete with others, and explore a dynamic world in this thrilling multiplayer experience."}]}, "developer_name": "Aetheria", "developer_privacy_policy_url": "https://sites.google.com/view/aetheria-hope/privacy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/aetheria-hope/tos", "publisher_name": "Tom", "support_website_url": null, "website_url": "https://sites.google.com/view/aetheria-hope/hom
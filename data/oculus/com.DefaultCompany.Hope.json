g?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gAH-M-YB01IQ7kNvwGUtA-n&_nc_oc=Ado8uwAggXWJl81g7kHF3Ibai7qdbDMbjwArC1C2M_cMsbpx5viI0AjnviaFpDxACnI&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Thvda9NzGYPqLtxvhdwRJOrn0Ouyh_aiIca_KoSvZ2w&oe=6A1C553E"}, {"file_name": "Untitled design (4).png", "id": "634600899299950", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/473393432_634600912633282_886284553765769839_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pIVHzsoiGv8Q7kNvwHczTVB&_nc_oc=AdpjP34uXY0NNtBT9hdrowz4tLflwW1ers3C10Amct1YpAucti4_8QOqRxJ2cqZOcmc&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4syNhu4DR9T5m2HSCIVGzvWDmoCO4I1OAe1cDNjJ5IgQ&oe=6A1C5C43"}, {"file_name": "Untitled design (5).png", "id": "599929739698149", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473391986_599929746364815_4596362304971124303_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oRk_sfS53NQQ7kNvwHvCtwQ&_nc_oc=Ado2uFYW5-u1pdYUD0ASFM4QMpez-_5qe4jq7Lji-0mZKrB46HfsszsnTzpdd2SEtDc&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4J-kyS_ofG6jT8SEhIaaoSIR8qySPImVFT6VVBT4Ekjw&oe=6A1C292A"}, {"file_name": "Untitled design (6).png", "id": "551028238001682", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/473393507_551028241335015_5004598522662507686_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MJ6__5Vo9yYQ7kNvwEBoHVB&_nc_oc=Adr802vH6dS0OVsqlC4vSRnHI9wGOCF8ckTBI-3n9RXekn7sAH50waU6eali3R6Ggi8&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5UDbqOiMprklwC6np-HK0IAkd5thBsmbde106b2Tks4w&oe=6A1C3744"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hope", "keywords": [], "long_description": "Hope is an innovative VR movement-based game that puts you in full control of your mobility. Using only your hands, you\u2019ll run, jump, climb, and swing through dynamic environments with intuitive locomotion mechanics designed for high-speed action and precise control. Whether you're scaling towering obstacles, racing through complex courses, or competing in intense multiplayer modes, every movement feels fluid and immersive. With a focus on freedom and creativity, Hope offers a unique gameplay experience where skill and strategy define your success. Challenge your friends, master your movement, and explore ever-expanding worlds in this thrilling VR adventure. Are you ready to move?", "short_description": "Hope is a fast-paced VR movement game where players use hand-based locomotion to run, jump, and climb through immersive environments. Master fluid movement, compete with others, and explore a dynamic world in this thrilling multiplayer experience."}]}, "developer_name": "Aetheria", "developer_privacy_policy_url": "https://sites.google.com/view/aetheria-hope/privacy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/aetheria-hope/tos", "publisher_name": "Tom", "support_website_url": null, "website_url": "https://sites.google.com/view/aetheria-hope/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP", "SINGLE_USER"], "id": "8649771261790211"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/473391959_505137809057326_336463633148730664_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GsTilLZA14oQ7kNvwFJYtSn&_nc_oc=AdogMHenyIlCAxVTcAdm5p
g?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N-QjxgY1QIUQ7kNvwH45lX8&_nc_oc=AdqG441okDtSSNjpWm24hfRuVzeifjgYppIjfFQZ2Paj-0fbjgC814QeiwYncWD9csM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8P7L0_byRYIVUzOhWO8sk5NFFW4ZbOUOwMMhVG-3jpWw&oe=6A2AD5BE"}, {"file_name": "Untitled design (4).png", "id": "634600899299950", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393432_634600912633282_886284553765769839_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mdKY--z8p-UQ7kNvwHSkoUh&_nc_oc=AdoHcVlBR3t7kWmGhpf792NowC6Gty7Mya0WcHhWOYZFOWlGt9ik_B1n7H4_iTub_CU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9OeEz4mMglM3g6XYdH0aukLIzcm4jtj5i4VSjFsA4ZJw&oe=6A2ADCC3"}, {"file_name": "Untitled design (5).png", "id": "599929739698149", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391986_599929746364815_4596362304971124303_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ab07iNFmMaYQ7kNvwEr4MjP&_nc_oc=Ado_X8YiJpYAbFQkA12IkgC3t5sZq7FkMBjgcSh_5GdVe2FVNyfu8utKvAHy6GD8vjg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_vqoEux9Bl8ej-JSMjZj8HO9cmGP_KeS57Ez8rKpseWg&oe=6A2AE1EA"}, {"file_name": "Untitled design (6).png", "id": "551028238001682", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393507_551028241335015_5004598522662507686_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tfwcw4ehcC0Q7kNvwGW27eT&_nc_oc=Adrqh0ijvG_7QGRa-NrUSNa3UTeMl17u_KH9H7ZcK-kyjHCqWjHSq6ryM36QIgSmNK0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af94MePJ4-x2yG-EwCGD1J-YQs7jlZTjNqMm1FGKWfgOGw&oe=6A2AB7C4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hope", "keywords": [], "long_description": "Hope is an innovative VR movement-based game that puts you in full control of your mobility. Using only your hands, you\u2019ll run, jump, climb, and swing through dynamic environments with intuitive locomotion mechanics designed for high-speed action and precise control. Whether you're scaling towering obstacles, racing through complex courses, or competing in intense multiplayer modes, every movement feels fluid and immersive. With a focus on freedom and creativity, Hope offers a unique gameplay experience where skill and strategy define your success. Challenge your friends, master your movement, and explore ever-expanding worlds in this thrilling VR adventure. Are you ready to move?", "short_description": "Hope is a fast-paced VR movement game where players use hand-based locomotion to run, jump, and climb through immersive environments. Master fluid movement, compete with others, and explore a dynamic world in this thrilling multiplayer experience."}]}, "developer_name": "Aetheria", "developer_privacy_policy_url": "https://sites.google.com/view/aetheria-hope/privacy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/aetheria-hope/tos", "publisher_name": "Tom", "support_website_url": null, "website_url": "https://sites.google.com/view/aetheria-hope/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP", "SINGLE_USER"], "id": "8649771261790211"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391959_505137809057326_336463633148730664_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ddwi25irQYQ7kNvwFip2-L&_nc_oc=Adp55ETqus9ZoEOxS461i5
7a0a&_nc_ohc=v1DRLQTbzHkQ7kNvwHTO8wW&_nc_oc=AdlrvJRhs09Uk2Kw2CGB3GEhnSSoqRVB-fTSXfbMy_tVTP1T4t0lnLjpiRo45mR1vCo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afyeej-c8Umbxz4OlqLdXoUGRNiQ_R2DA9_RKz4WZvMyMg&oe=69AC0D7E"}, {"file_name": "Untitled design (4).png", "id": "634600899299950", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393432_634600912633282_886284553765769839_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mmY4JfYa5pUQ7kNvwEzStdn&_nc_oc=AdkGGkA1-zQL5h0AVCqJQSj96CDK6dTezVM_-zBRe2u5QOBNxpGtuweBNnvhtJ-Bdk0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxPrhbbw7fSuDL1_f4FqHlrOj0zdYd7dS8jiBAKJlBx2A&oe=69AC1483"}, {"file_name": "Untitled design (5).png", "id": "599929739698149", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391986_599929746364815_4596362304971124303_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a9eJBmElQQoQ7kNvwFb3wxt&_nc_oc=AdkzIzTo3TSQJjLMe7TueLrsJ0MPe-MdCW59XcOgFn3HermFVyV28n4dPFqLCMXcueE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afwpread2hVoqEtJl5mo-nTsM8AoJml9vDDonzBhaLQrCg&oe=69AC19AA"}, {"file_name": "Untitled design (6).png", "id": "551028238001682", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393507_551028241335015_5004598522662507686_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z7SF2Ad3zb0Q7kNvwH8Dk9I&_nc_oc=AdlJ5ovJFDwgMMHHzV999onBvsgbuDNA7pCubwV0BHNSis5PCGhDPtglgnDX3C7Quo8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwrMzni15AmXOGIVT5PuYdJ_rrRqr4HDY_Cd97mmOXNWw&oe=69AC27C4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hope", "keywords": [], "long_description": "Hope is an innovative VR movement-based game that puts you in full control of your mobility. Using only your hands, you\u2019ll run, jump, climb, and swing through dynamic environments with intuitive locomotion mechanics designed for high-speed action and precise control. Whether you're scaling towering obstacles, racing through complex courses, or competing in intense multiplayer modes, every movement feels fluid and immersive. With a focus on freedom and creativity, Hope offers a unique gameplay experience where skill and strategy define your success. Challenge your friends, master your movement, and explore ever-expanding worlds in this thrilling VR adventure. Are you ready to move?", "short_description": "Hope is a fast-paced VR movement game where players use hand-based locomotion to run, jump, and climb through immersive environments. Master fluid movement, compete with others, and explore a dynamic world in this thrilling multiplayer experience."}]}, "developer_name": "Aetheria", "developer_privacy_policy_url": "https://sites.google.com/view/aetheria-hope/privacy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/aetheria-hope/tos", "publisher_name": "Tom", "support_website_url": null, "website_url": "https://sites.google.com/view/aetheria-hope/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP", "SINGLE_USER"], "id": "8649771261790211"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391959_505137809057326_336463633148730664_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xfdN54cJFEsQ7kNvwFPyt2n&_nc_oc=AdnY-o44QdLEn8onjBfDaaLAV2syo_uTVwM17Ed9K4aLoYj5WOCS8tVjXfB8q_hqfUI&_n
unURM4f4BYnV53Jf4XyCgnLtgoQ7Tu9Et0cG_Bc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuZxenYTq5POQHUtrf5pB2emrvHKrUR3tMRC8mhU4dK7Q&oe=6999987E"}, {"file_name": "Untitled design (4).png", "id": "634600899299950", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393432_634600912633282_886284553765769839_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nmcgjG-GdbUQ7kNvwFEeW_v&_nc_oc=AdmfIP0ce-hVFRJvJ4i0wRfHBTkseJGhGKi-oyneU8eMcKozCulR2vkvMCEvg3WCAeQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afuqgzazam4FBGcq0Pz7oXAKh-vzZtrptmB809FkaTNlKA&oe=69999F83"}, {"file_name": "Untitled design (5).png", "id": "599929739698149", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391986_599929746364815_4596362304971124303_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kwbrsLkdEEUQ7kNvwF6Wek_&_nc_oc=AdmLyBvo-3glBBaCWn-3mQstpwcYF0n_tOYOo6e7eXRKFOBoObkbk1Z9TdDPO84KUe8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuHxRwYDkv87KPjcifs7AHRx44gILkqbVmzFouPLizkLg&oe=6999A4AA"}, {"file_name": "Untitled design (6).png", "id": "551028238001682", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393507_551028241335015_5004598522662507686_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dkzFbXAQR68Q7kNvwFP2TXf&_nc_oc=AdmiwjKoRX2d1fXd0wcitFHnskKghZxciynWBZYTqQXCKuYJjD8q-LzdRHdQlarIIa0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afug5q7vTTAbiwnpOhwie5DcbqoEsdjnkWlIy0WY2N3Hyg&oe=6999B2C4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hope", "keywords": [], "long_description": "Hope is an innovative VR movement-based game that puts you in full control of your mobility. Using only your hands, you\u2019ll run, jump, climb, and swing through dynamic environments with intuitive locomotion mechanics designed for high-speed action and precise control. Whether you're scaling towering obstacles, racing through complex courses, or competing in intense multiplayer modes, every movement feels fluid and immersive. With a focus on freedom and creativity, Hope offers a unique gameplay experience where skill and strategy define your success. Challenge your friends, master your movement, and explore ever-expanding worlds in this thrilling VR adventure. Are you ready to move?", "short_description": "Hope is a fast-paced VR movement game where players use hand-based locomotion to run, jump, and climb through immersive environments. Master fluid movement, compete with others, and explore a dynamic world in this thrilling multiplayer experience."}]}, "developer_name": "Aetheria", "developer_privacy_policy_url": "https://sites.google.com/view/aetheria-hope/privacy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/aetheria-hope/tos", "publisher_name": "Tom", "support_website_url": null, "website_url": "https://sites.google.com/view/aetheria-hope/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP", "SINGLE_USER"], "id": "8649771261790211"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391959_505137809057326_336463633148730664_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KWZvnX-Hlb0Q7kNvwFZ_uQR&_nc_oc=AdlK8qCTGzD7w8mStR2vzmqWfcMNpcPLrIXMSI8t5rMofum5WLqGmIe8eKiyEHf3IOg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftWdFyLEFEBT78AU9BIDJwuY1-IdkBM_A-d0cB9_0Q0tw&oe=69999C85
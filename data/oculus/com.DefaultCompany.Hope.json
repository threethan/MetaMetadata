g?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tS_mwSAg8mEQ7kNvwEPtIBy&_nc_oc=Adqc730NRNtjY4rHhqVX7cT7_OQgHv0_1X_BXQI2Vx4JvAicEm7WIQwJX7VT2PYKC5g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFs_H9Eyg2MMGKpbK66k6GkNtxVLWYnWIkGyR9Etqy3ew&oe=6A8C2C7E"}, {"file_name": "Untitled design (4).png", "id": "634600899299950", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393432_634600912633282_886284553765769839_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gb2oMyGYdcwQ7kNvwFSm5ij&_nc_oc=AdoEGfNJzpZ-Yjsx52RdCfuBmLWwVBbdMLMKCJphTzb4W1BebhBiTtdL6Vxqadeddw8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEyjYuUpN7JSvQZ4zJN0xMEdvtPk7Zu7pUmtc8yTnvaBg&oe=6A8C3383"}, {"file_name": "Untitled design (5).png", "id": "599929739698149", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391986_599929746364815_4596362304971124303_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3P9gPezGe08Q7kNvwFxKoPc&_nc_oc=AdpAHV5hlvrUImGCU8qqQLVgPIWuaXSlv35EZlqK5pg_N5YiueYqhGZh6kx6uiFR4QQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGUtCIgLRNpCYb7XuIRtyb6xuhxJOeHRfOC1Hb4XQkpbQ&oe=6A8C38AA"}, {"file_name": "Untitled design (6).png", "id": "551028238001682", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393507_551028241335015_5004598522662507686_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TmfskhitZG0Q7kNvwExGGUz&_nc_oc=AdrVVP2F5WREAtGGJEDU2W3Vs6-3MmmbOIfLNRzzObKOEhSZFOo5JIibntG7Ce4Yqsg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUGfDIbEHhdm_zZSGwxeR4O83uVg0EeEqYoop0nqg-Vg&oe=6A8C46C4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hope", "keywords": [], "long_description": "Hope is an innovative VR movement-based game that puts you in full control of your mobility. Using only your hands, you\u2019ll run, jump, climb, and swing through dynamic environments with intuitive locomotion mechanics designed for high-speed action and precise control. Whether you're scaling towering obstacles, racing through complex courses, or competing in intense multiplayer modes, every movement feels fluid and immersive. With a focus on freedom and creativity, Hope offers a unique gameplay experience where skill and strategy define your success. Challenge your friends, master your movement, and explore ever-expanding worlds in this thrilling VR adventure. Are you ready to move?", "short_description": "Hope is a fast-paced VR movement game where players use hand-based locomotion to run, jump, and climb through immersive environments. Master fluid movement, compete with others, and explore a dynamic world in this thrilling multiplayer experience."}]}, "developer_name": "Aetheria", "developer_privacy_policy_url": "https://sites.google.com/view/aetheria-hope/privacy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/aetheria-hope/tos", "publisher_name": "Tom", "support_website_url": null, "website_url": "https://sites.google.com/view/aetheria-hope/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP", "SINGLE_USER"], "id": "8649771261790211"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391959_505137809057326_336463633148730664_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tdOCHv1GDBEQ7kNvwHNmWrQ&_nc_oc=AdpsBdMugG51Vz0fcVtJdX
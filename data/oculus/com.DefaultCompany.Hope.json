g?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A5qOqG7BGFEQ7kNvwFkpBm-&_nc_oc=Ado7qQFThaT7q2XtuVnCf_1b61NwiuHx3aHQqg1aZM-BtfJ1P6JIjhoWjQOSFN7HEbA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHSw7GlTIapNI5xmxhM4L0xE0AHP1w7sxzD9oSdMOwYAA&oe=6A7865FE"}, {"file_name": "Untitled design (4).png", "id": "634600899299950", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393432_634600912633282_886284553765769839_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LKtTI5vNSgMQ7kNvwH9Rb1U&_nc_oc=AdqwPhHnvwRkrf6vm-xO-jSgIba5vKdOx1O1YbP4YJzYHasV3NHN8Pfx-W6SVeN40FI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH37PJYVEtKAU3TiqO7eg5JGel-QFCU6oxz4XVKf5jPQA&oe=6A786D03"}, {"file_name": "Untitled design (5).png", "id": "599929739698149", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391986_599929746364815_4596362304971124303_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ju-FVd06GtcQ7kNvwEOCAXK&_nc_oc=AdqbYnqCTD3V6Wws-ltI_qImyLwoHlgcA4wFJFzbY5pxvahs9FysLp83pNmfuofjvtU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFPse6TVz1MBLzccSOizi1JepD3O7AL59LBM7QD3t_0w&oe=6A78722A"}, {"file_name": "Untitled design (6).png", "id": "551028238001682", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393507_551028241335015_5004598522662507686_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=saQRYbfKov8Q7kNvwGly6tF&_nc_oc=AdoHHl1Fp-h2QZqn1HZAS5UU5cak-lr-hA7AjR4rmg3n0Md32Dbz9e0736Y-qv-6apw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJ8XSW7Gd2hWCVSdA1Zs9UKd7jhePumo0TMET6UgbjUg&oe=6A788044"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hope", "keywords": [], "long_description": "Hope is an innovative VR movement-based game that puts you in full control of your mobility. Using only your hands, you\u2019ll run, jump, climb, and swing through dynamic environments with intuitive locomotion mechanics designed for high-speed action and precise control. Whether you're scaling towering obstacles, racing through complex courses, or competing in intense multiplayer modes, every movement feels fluid and immersive. With a focus on freedom and creativity, Hope offers a unique gameplay experience where skill and strategy define your success. Challenge your friends, master your movement, and explore ever-expanding worlds in this thrilling VR adventure. Are you ready to move?", "short_description": "Hope is a fast-paced VR movement game where players use hand-based locomotion to run, jump, and climb through immersive environments. Master fluid movement, compete with others, and explore a dynamic world in this thrilling multiplayer experience."}]}, "developer_name": "Aetheria", "developer_privacy_policy_url": "https://sites.google.com/view/aetheria-hope/privacy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/aetheria-hope/tos", "publisher_name": "Tom", "support_website_url": null, "website_url": "https://sites.google.com/view/aetheria-hope/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP", "SINGLE_USER"], "id": "8649771261790211"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391959_505137809057326_336463633148730664_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w3beXlTCaaUQ7kNvwFxY6oC&_nc_oc=Adp561iWelFfiTbyJKE1g8
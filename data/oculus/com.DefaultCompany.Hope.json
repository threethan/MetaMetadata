g?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3NYFRgDkXVAQ7kNvwE3_Z4D&_nc_oc=Adp5rxR9hIYRbkGMGRqdetQfodRY7_3W3Mizod7N5q54o2DxrqpU4_-a4mceUTjr7KM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMpGmb8FJSlOqIJcYz8oOI8cSxCPxmKnYhovyQB6P2yGA&oe=6AC909BE"}, {"file_name": "Untitled design (4).png", "id": "634600899299950", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473393432_634600912633282_886284553765769839_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dH-Xa4PKW1EQ7kNvwHdp6mu&_nc_oc=AdrShtqiRK31SPzns56n-IkyMbcfLjs8M3LL5XWkjpyPggafSW03i0fXzAw1Cj8jER0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNulJOpe9W8mrMf4P0eIwImpRjYKrH0aKzXUFGkf3qoWA&oe=6AC910C3"}, {"file_name": "Untitled design (5).png", "id": "599929739698149", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391986_599929746364815_4596362304971124303_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hrCfJjZM4SsQ7kNvwFQN7np&_nc_oc=Adp1wrmIyfuDcr4aDGq8SJMxs0d5upM1QZYWw8IwFW4Tx4UBIRAunoxWv0JvBAkFKCE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgDgiT2UNXuWAR2gDh9-v4ySXqBt7Dj6DBws8BzNm0gA&oe=6AC915EA"}, {"file_name": "Untitled design (6).png", "id": "551028238001682", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393507_551028241335015_5004598522662507686_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5zFzkquJxBIQ7kNvwEwOGOQ&_nc_oc=Adp1EdteeLocqeo3bedNly_HhxgNw6vtM6JWWlyNOfah1gvfZJnkVFVxMfpr4Kq4uWk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPfPA_Z-K7zS-y8WL-S8Ls0ngz_vX6i1FwxiHrNoANydw&oe=6AC8EBC4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hope", "keywords": [], "long_description": "Hope is an innovative VR movement-based game that puts you in full control of your mobility. Using only your hands, you\u2019ll run, jump, climb, and swing through dynamic environments with intuitive locomotion mechanics designed for high-speed action and precise control. Whether you're scaling towering obstacles, racing through complex courses, or competing in intense multiplayer modes, every movement feels fluid and immersive. With a focus on freedom and creativity, Hope offers a unique gameplay experience where skill and strategy define your success. Challenge your friends, master your movement, and explore ever-expanding worlds in this thrilling VR adventure. Are you ready to move?", "short_description": "Hope is a fast-paced VR movement game where players use hand-based locomotion to run, jump, and climb through immersive environments. Master fluid movement, compete with others, and explore a dynamic world in this thrilling multiplayer experience."}]}, "developer_name": "Aetheria", "developer_privacy_policy_url": "https://sites.google.com/view/aetheria-hope/privacy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/aetheria-hope/tos", "publisher_name": "Tom", "support_website_url": null, "website_url": "https://sites.google.com/view/aetheria-hope/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP", "SINGLE_USER"], "id": "8649771261790211"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391959_505137809057326_336463633148730664_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=92mzyBOI08oQ7kNvwEYwUjP&_nc_oc=Ado-1HsO4v7j8C2w5wOA4t
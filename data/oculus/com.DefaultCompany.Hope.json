5_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EO4L_pxlfdQQ7kNvwGDaUYI&_nc_oc=AdrqlgaBsfFKuY_Y5zgA7oO2Z2Vso7eexG6Z5iFhMXTPObtDN0Ds8SVbGKwFAiGg11E&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9w7TOLTkrNtO4WeJANVzlNi4YEGirwHegSRvT2xHw4ZQ&oe=6A39563E"}, {"file_name": "Untitled design (4).png", "id": "634600899299950", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/473393432_634600912633282_886284553765769839_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L5ejm6JWx60Q7kNvwEkMPpW&_nc_oc=AdqGx-4WKxhiJC0WFrCS9MqdRYmtwgWHG50UIercXrJxGHJU-nPgFe3OwnXxZu55IMU&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9PznfGrb7H0pbJAmw-4ee6fztSjUnf77EoYL3gkDTDqQ&oe=6A395D43"}, {"file_name": "Untitled design (5).png", "id": "599929739698149", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473391986_599929746364815_4596362304971124303_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s1tJo9meI10Q7kNvwHHFaSF&_nc_oc=AdrzAZk-J4IMXfqnTxxvV5mHu4c_3pGPaHjnpIqSVHMqI3xRmg_FU_H73v1ikhu-F5k&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-u7RDvrmF-a1ITTuXTfb4-aRRCHvrQp1WzG-nj_DVzGg&oe=6A39626A"}, {"file_name": "Untitled design (6).png", "id": "551028238001682", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/473393507_551028241335015_5004598522662507686_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HqxaC52HMOAQ7kNvwHfAU9I&_nc_oc=AdpvEL-kTkGMOb5TPBF23KVv4G6ioL5AMN14lOZTAEj9S9xhRym8fCrzgh15l_fU06Y&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9aJgohdA5HGbANnXy__udximMSpZqwQ5GK-zfRj9lh3w&oe=6A393844"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hope", "keywords": [], "long_description": "Hope is an innovative VR movement-based game that puts you in full control of your mobility. Using only your hands, you\u2019ll run, jump, climb, and swing through dynamic environments with intuitive locomotion mechanics designed for high-speed action and precise control. Whether you're scaling towering obstacles, racing through complex courses, or competing in intense multiplayer modes, every movement feels fluid and immersive. With a focus on freedom and creativity, Hope offers a unique gameplay experience where skill and strategy define your success. Challenge your friends, master your movement, and explore ever-expanding worlds in this thrilling VR adventure. Are you ready to move?", "short_description": "Hope is a fast-paced VR movement game where players use hand-based locomotion to run, jump, and climb through immersive environments. Master fluid movement, compete with others, and explore a dynamic world in this thrilling multiplayer experience."}]}, "developer_name": "Aetheria", "developer_privacy_policy_url": "https://sites.google.com/view/aetheria-hope/privacy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/aetheria-hope/tos", "publisher_name": "Tom", "support_website_url": null, "website_url": "https://sites.google.com/view/aetheria-hope/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP", "SINGLE_USER"], "id": "8649771261790211"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/473391959_505137809057326_336463633148730664_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9-5E6W1DvJYQ7kNvwE15rgn&_nc_oc=AdpYIv4rHpoUX1
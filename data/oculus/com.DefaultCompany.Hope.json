g?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TbN3_Uv8zNUQ7kNvwHM5wMf&_nc_oc=AdpAQu188JV_VAaPF1nXOy78me0Ue2E4BtmxGggpB2igGsZngGFPZjo2L-aaBdZea4s&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMxjUe_P5JtV05y6_ErNjVZDDzVj4TYR4NHacgmWrsV0g&oe=6AD395BE"}, {"file_name": "Untitled design (4).png", "id": "634600899299950", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393432_634600912633282_886284553765769839_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8qL0_1jEZM4Q7kNvwHrbB__&_nc_oc=AdrPUUm6Pz6uoRY2QvoNJm3_1_NeUEAgGl5lLkkhrEam0BlWqf4zGkg_pSuyL0qaAb4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNgFWQ4TUYwD8QhM-xa84bwN2q8GRvtcb-H6lxz9F8x0A&oe=6AD39CC3"}, {"file_name": "Untitled design (5).png", "id": "599929739698149", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391986_599929746364815_4596362304971124303_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xb5jmRU_tGEQ7kNvwHR-sAh&_nc_oc=AdpR8HwW9UEqN4nreLqRDFx7_NnUiCgT5rlNUam7DQh9wxyKxKXl9GlmusroxU-tHlo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMmlVo725WinMb0x5OySCrYkut8r-bzXoZoLW1SqZRBaA&oe=6AD3A1EA"}, {"file_name": "Untitled design (6).png", "id": "551028238001682", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393507_551028241335015_5004598522662507686_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3I1IvaBEHmQQ7kNvwEUFfjS&_nc_oc=AdoqmX2_mQEZtn-WfiufpZDRnKUearDHDnnFQOQBH58t9VDFEqP1YWjUnssPewLp6F0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP0a3OOKjJVEMWrmaqSdTSinqWOG5y5sPMf-hkdijKu1w&oe=6AD3B004"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hope", "keywords": [], "long_description": "Hope is an innovative VR movement-based game that puts you in full control of your mobility. Using only your hands, you\u2019ll run, jump, climb, and swing through dynamic environments with intuitive locomotion mechanics designed for high-speed action and precise control. Whether you're scaling towering obstacles, racing through complex courses, or competing in intense multiplayer modes, every movement feels fluid and immersive. With a focus on freedom and creativity, Hope offers a unique gameplay experience where skill and strategy define your success. Challenge your friends, master your movement, and explore ever-expanding worlds in this thrilling VR adventure. Are you ready to move?", "short_description": "Hope is a fast-paced VR movement game where players use hand-based locomotion to run, jump, and climb through immersive environments. Master fluid movement, compete with others, and explore a dynamic world in this thrilling multiplayer experience."}]}, "developer_name": "Aetheria", "developer_privacy_policy_url": "https://sites.google.com/view/aetheria-hope/privacy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/aetheria-hope/tos", "publisher_name": "Tom", "support_website_url": null, "website_url": "https://sites.google.com/view/aetheria-hope/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP", "SINGLE_USER"], "id": "8649771261790211"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391959_505137809057326_336463633148730664_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cM9Khdvv9CkQ7kNvwHGgMot&_nc_oc=AdqV8hSunNFAD5DxDiDZEh
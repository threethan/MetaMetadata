7a0a&_nc_ohc=y6AgN80OsDEQ7kNvwHpXuBl&_nc_oc=Adr2etXfhuhWMM337ZgykgZjCup7RSQxFH41rjDOqv3nqq2OBDCCweYwn4JuRquFkXM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx9vha4l_85fALmBuGnkLvxj17sh08_CwvFk2Va5s1j6A&oe=69C1257E"}, {"file_name": "Untitled design (4).png", "id": "634600899299950", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393432_634600912633282_886284553765769839_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_3ogRZ8tde8Q7kNvwGswJkh&_nc_oc=Adr1hvXvef2g5KtdQSX3Fkkw61pFUuSW1OdzP0Hyj15XhWBqDMLO48vcJs9EXUtUb5k&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxxaYaswEde8NVcPHlJ7f0peLnUw6f3_Mntz9dbA3sDsw&oe=69C12C83"}, {"file_name": "Untitled design (5).png", "id": "599929739698149", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391986_599929746364815_4596362304971124303_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TYFG42dp0skQ7kNvwFQ_uxB&_nc_oc=Adq5m15dHv8TgJzl84xkFz096HuJgiAEV_0uP48_bMYJoZdt7BoSH1o6nBo6eaRM1Y0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzGtp_KAKzGe1fQWqlcLvjVhU9M606wIFRyZQY7RCjI4Q&oe=69C131AA"}, {"file_name": "Untitled design (6).png", "id": "551028238001682", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393507_551028241335015_5004598522662507686_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_bk0QnGmZZgQ7kNvwGp8HZ0&_nc_oc=AdqGO6BJW6gy_ylQ_bHPP9yc78vCkcbMPMmyzBoXE_FBWKOnflQInEeAUxN7-H548j0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwpD6BMI-byPPp94HXHykrIEcDGdnQmp5nd631EA-X9Jw&oe=69C13FC4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hope", "keywords": [], "long_description": "Hope is an innovative VR movement-based game that puts you in full control of your mobility. Using only your hands, you\u2019ll run, jump, climb, and swing through dynamic environments with intuitive locomotion mechanics designed for high-speed action and precise control. Whether you're scaling towering obstacles, racing through complex courses, or competing in intense multiplayer modes, every movement feels fluid and immersive. With a focus on freedom and creativity, Hope offers a unique gameplay experience where skill and strategy define your success. Challenge your friends, master your movement, and explore ever-expanding worlds in this thrilling VR adventure. Are you ready to move?", "short_description": "Hope is a fast-paced VR movement game where players use hand-based locomotion to run, jump, and climb through immersive environments. Master fluid movement, compete with others, and explore a dynamic world in this thrilling multiplayer experience."}]}, "developer_name": "Aetheria", "developer_privacy_policy_url": "https://sites.google.com/view/aetheria-hope/privacy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/aetheria-hope/tos", "publisher_name": "Tom", "support_website_url": null, "website_url": "https://sites.google.com/view/aetheria-hope/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP", "SINGLE_USER"], "id": "8649771261790211"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391959_505137809057326_336463633148730664_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ckVzj4CdMxcQ7kNvwHhHG7k&_nc_oc=AdocbpKHx5O5ZZ7zlckZT47xt1JpCbfqAKrbaQFjmcQB0T6eIi-0JdloUkinBDTglgQ&_n
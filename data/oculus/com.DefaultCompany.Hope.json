Ggjb__jMvM_uXTt_e4vfVAzGiiDLw_6Kc79lQR4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftil9LAe87HgLvaRyfngEsgyCpZ4XWpKv-cjH4y8dZ10w&oe=69A2D2FE"}, {"file_name": "Untitled design (4).png", "id": "634600899299950", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393432_634600912633282_886284553765769839_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G3EfTzdZ09IQ7kNvwFen5Yv&_nc_oc=AdkDJWbf1gvL3i-9QcMVo34tnwiZnxPInvxPYuukFgZdR47uwD_9v7Qy36H1TH5iQAc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuoN_IFLDUZ8qHMheGaEhwbr_Jo2pf9DwWV4w3gLXz85A&oe=69A2DA03"}, {"file_name": "Untitled design (5).png", "id": "599929739698149", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391986_599929746364815_4596362304971124303_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xwIie_6oA_AQ7kNvwEGd1PJ&_nc_oc=AdkJk4YdacjZx4U2vn_aPi-q73q40JNziwq6ZHsEXROADTyRltKjs3tG6sN9X6thudI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv1XS0Pp0YOMnRmZOHhFPAfkZOfjDbI1KP-BP63f8COBw&oe=69A2DF2A"}, {"file_name": "Untitled design (6).png", "id": "551028238001682", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393507_551028241335015_5004598522662507686_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eIRhfJb6D44Q7kNvwH9gyTm&_nc_oc=AdmHJW7aZmvysrymzvabD71DufZ5aXzhUHH6b39mLqepa4-JUwJHEFHW1am6P5dtXIw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsvqf420JFvaDVe297tIarI2_bYr_L1YuM-XKaE-z2Ksw&oe=69A2ED44"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hope", "keywords": [], "long_description": "Hope is an innovative VR movement-based game that puts you in full control of your mobility. Using only your hands, you\u2019ll run, jump, climb, and swing through dynamic environments with intuitive locomotion mechanics designed for high-speed action and precise control. Whether you're scaling towering obstacles, racing through complex courses, or competing in intense multiplayer modes, every movement feels fluid and immersive. With a focus on freedom and creativity, Hope offers a unique gameplay experience where skill and strategy define your success. Challenge your friends, master your movement, and explore ever-expanding worlds in this thrilling VR adventure. Are you ready to move?", "short_description": "Hope is a fast-paced VR movement game where players use hand-based locomotion to run, jump, and climb through immersive environments. Master fluid movement, compete with others, and explore a dynamic world in this thrilling multiplayer experience."}]}, "developer_name": "Aetheria", "developer_privacy_policy_url": "https://sites.google.com/view/aetheria-hope/privacy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/aetheria-hope/tos", "publisher_name": "Tom", "support_website_url": null, "website_url": "https://sites.google.com/view/aetheria-hope/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP", "SINGLE_USER"], "id": "8649771261790211"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391959_505137809057326_336463633148730664_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CBFljLXuERYQ7kNvwENwJcV&_nc_oc=Adm4iGb2-M8HN5UDjdL8UBiPPsJV8W6_OKgQCrAVpyJYIARTrCqkdOcZ0xhte6ULVnY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftmTBnU-k-vbfDclLoTfwosMAQ01D8Mpv3Vb2cs_DSW-Q&oe=69A2D705
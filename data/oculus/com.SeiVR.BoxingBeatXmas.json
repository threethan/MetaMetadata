.5771-25/491828849_1300527485157409_5306759442547023783_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IY9MJxjjxe8Q7kNvwFE4aW1&_nc_oc=AdotB65_DVUU75qd-v7zs2Qc4qPXFAtiiR39ietFOYe7sNlvdaAZnFy-bXlQhVLWtJA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKBWE1s1h7ruxhlwao-b2FYBY_Asz67Dkm7M2Rp6Jl0w&oe=6AAFF879"}, "display_name": "Boxing Beat Xmas", "keywords": ["vrboxing", "rhythmboxing", "christmasvr", "boxingworkout", "vrfitness"], "long_description": "Step into Boxing Beat Xmas, a cozy rhythm boxing experience set on an outdoor snow-covered ring beneath twinkling lights and gentle snowfall. Time your punches to festive remixes, feel satisfying impact with Vibrate, and enjoy crisp visuals with High Quality mode \u2014 all tuned for Meta Quest. \n\nWhat you\u2019ll do\n\nPunch on beat to stack combos and chase perfect streaks.\n\nMaster three difficulties \u2014 Easy, Medium, Hard \u2014 each with tighter timing windows and denser patterns.\n\nStart fast with a streamlined Tutorial and jump straight into holiday action. \n\nThe vibe\n\nOpen-air Christmas arena: red ring dusted with snow, warm lights, and sparkling accents.\n\nWarm & Cozy UI: floating panels, big readable buttons designed for VR comfort.\n\nFestive feedback: snowy particle bursts and gentle chimes when you land hits on time. \n\nWhy it\u2019s fun\n\nRhythm-first boxing: simple to pick up, rewarding to master.\n\nComfortable in VR: Clean targets, and cozy lighting for long play sessions.\n\nJoin the holiday fight, ride the groove, and unleash that merry uppercut. Boxing Beat Xmas is where beat meets blizzard \u2014 see you on the snowy canvas.", "short_description": "Step into Boxing Beat Xmas\u2014a cozy rhythm boxing showdown on an outdoor snow-covered ring. Punch on beat, stack combos, unlock festive skins, and climb the leaderboard across Easy/Medium/Hard with a quick Tutorial to get you started. Feel the hits with Vibrate and keep visuals crisp with High Quality mode. Join the holiday hype."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/seivr/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jone Sei", "support_website_url": null, "website_url": "https://sites.google.com/view/seivr/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26063981859871879"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "3086493221554841"}, {"status": "PUBLISHED", "id": "968361079286644"}, {"status": "PUBLISHED", "id": "969410792189947"}, {"status": "PUBLISHED", "id": "1353687263457557"}, {"status": "PUBLISHED", "id": "880168944915919"}, {"status": "PUBLISHED", "id": "1217122617022265"}, {"status": "PUBLISHED", "id": "25089567430745569"}, {"status": "PUBLISHED", "id": "836399652694865"}, {"status": "PUBLISHED", "id": "5115238268701965"}, {"status": "PUBLISHED", "id": "1145852261016852"}]}, "baseline_offer": {"id": "1145852261016852"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784566800, "status": "PUBLISHED", "id": "3086493221554841"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26045628325040566", "version": ".1"}, "id": "1271772681301693", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_bi
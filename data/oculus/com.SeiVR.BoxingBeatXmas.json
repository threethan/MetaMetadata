: "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620429_1181429367241136_8909148263206441379_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6P6yGOwqDrUQ7kNvwE_t559&_nc_oc=AdqMwlVoNycDsaPW2vGKlQ7UuME_c4KytpbN1PuAe7Y4qhklOdKiBUtA3t8jw_FPfi4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK2wKQ5Hx5d7A8pfJr55bfhwKU3dWmqCQdUAqjlbTDJ4A&oe=6AAFD6FA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "lands.png", "id": "1805399173515214", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618064_1805399176848547_5820272199495308041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iu12n6CdztwQ7kNvwHPxT12&_nc_oc=AdpvWaIdleSs0ngFFZiE39SZZfBXuQ3YZlQneK4BxeL7Jx3qbK8jbeixBv015FOjyOo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLyZlcOIUEaGemAozbBykLlxRhHRuTxTjG0bMiBO7VJkg&oe=6AAFE759"}, "display_name": "Boxing Beat  VR: XMAS", "keywords": ["vrboxing", "rhythmboxing", "christmasvr", "boxingworkout", "vrfitness"], "long_description": "Step into Boxing Beat  VR: XMAS, a cozy rhythm boxing experience set on an outdoor snow-covered ring beneath twinkling lights and gentle snowfall. Time your punches to festive remixes, feel satisfying impact with Vibrate, and enjoy crisp visuals with High Quality mode \u2014 all tuned for Meta Quest. \n\nWhat you\u2019ll do\n\nPunch on beat to stack combos and chase perfect streaks.\n\nMaster three difficulties \u2014 Easy, Medium, Hard \u2014 each with tighter timing windows and denser patterns.\n\nStart fast with a streamlined Tutorial and jump straight into holiday action. \n\nThe vibe\n\nOpen-air Christmas arena: red ring dusted with snow, warm lights, and sparkling accents.\n\nWarm & Cozy UI: floating panels, big readable buttons designed for VR comfort.\n\nFestive feedback: snowy particle bursts and gentle chimes when you land hits on time. \n\nWhy it\u2019s fun\n\nRhythm-first boxing: simple to pick up, rewarding to master.\n\nComfortable in VR: Clean targets, and cozy lighting for long play sessions.\n\nJoin the holiday fight, ride the groove, and unleash that merry uppercut. Boxing Beat Xmas is where beat meets blizzard \u2014 see you on the snowy canvas.", "short_description": "Step into Boxing Beat  VR: XMAS\u2014a cozy rhythm boxing showdown on an outdoor snow-covered ring. Punch on beat, stack combos, unlock festive skins, and climb the leaderboard across Easy/Medium/Hard with a quick Tutorial to get you started. Feel the hits with Vibrate and keep visuals crisp with High Quality mode. Join the holiday hype."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/seivr/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jone Sei", "support_website_url": null, "website_url": "https://sites.google.com/view/seivr/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26193955360207861"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619697_1193139336010572_2562092630225751489_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WItrUV7mwK8Q7kNvwE24FGQ&_nc_oc=Adrs2DeFyvjrb6ikSz6H2Lt8bak9fj9i0GnZA1nHk6uTX3JY1SzkPz5lKJ_neEr1-24&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLydC1ZjqQOQe7RBf_TkZAbzI4dQ_yd4N6u7fSWv6261Q&oe=6AAFF8B
-25/38982585_1602316283689448_3663155992257283383_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BeX8I2bjwGkQ7kNvwGpb_ze&_nc_oc=AdrYg0o5v3Y6akBCE2wELl3e2u5DD-tOBGVmsdfv9oH_1ehvV9VBY2rPUTELhPsHRUA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3g9tSpGFwP4tHYX27Ma68lrK8zjwXYZ-wvM-jHN25pBQ&oe=69D5146E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kongle", "keywords": [], "long_description": "Kongle is an exhilarating fan-made spin-off of the popular VR game Gorilla Tag, but with a wild twist. Set in vibrant jungle environments, players embody playful and agile gorillas, swinging from trees, bouncing off rocks, and scaling cliffs, all while trying to outwit their opponents. With an emphasis on movement, teamwork, and pure fun, Kongle brings a fresh take to the dynamic tag-style gameplay that made Gorilla Tag a sensation, blending in new features, game modes, and mechanics that keep players on their toes.", "short_description": "Kongle is an exhilarating fan-made spin-off of the popular VR game Gorilla Tag, but with a wild twist. Set in vibrant jungle environments, players embody playful and agile gorillas, swinging from trees, bouncing off rocks, and scaling cliffs, all while trying to outwit their opponents. With an emphasis on movement, teamwork, and pure fun, Kongle brings a fresh take to the dynamic tag-style gameplay that made Gorilla Tag a sensation, blending in new features, game modes, and mechanics that keep p"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/kongleprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "PUMPKIN PRODUCTIONS LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/kongle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1023770785722
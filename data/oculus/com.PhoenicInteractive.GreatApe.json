", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491820574_973602254700785_6037398430338364697_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dk309q-EhCoQ7kNvwFMFbXm&_nc_oc=AdoN8hKxMic_BbujGCEmY4PZ2huGd41CZC4nfU_AcWaEUCymWtti3FSvJm178q6wvCQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UFiJXpZk5DG8xcffuAYsdLRxX5lACZVADt_flufg1nQ&oe=6A22E1E9"}, {"file_name": "Screenshot 2025-06-11 134444.png", "id": "1259497545772079", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499305403_1259497549105412_4034038312616964136_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AE5VObBN-G0Q7kNvwGt-0fZ&_nc_oc=AdqkEGM86jr7SnTe0XfsA6Gxw8VruwoFJeiCOuA9_7UKKXQW30-K3mf38-qWqeVKRK0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_yJrWsdKTIB9PJbpta-vufCWs_-0Pu7m21NcQIqyo2g&oe=6A22F0EC"}, {"file_name": "Screenshot 2025-06-11 134438.png", "id": "1279009813739879", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499295562_1279009817073212_7133662711727504668_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2xcH92_NdVkQ7kNvwEak4bc&_nc_oc=Adpua0Z432DhlJCnXueS2ljrx5BkZztIbp0REu7yBtayrVzgeyOIKhYEGsrDXIXpDeM&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ZJ_oU9l_6830WfZVqeks2BMcTjDtGb4tSUArWDPZIsg&oe=6A22D4C7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Great Ape", "keywords": ["cat", "chasers", "chase"], "long_description": "This is a game about apes. Big, small, silly, chill. You\u2019ll explore fun maps, meet other players, and hang out. Everyone\u2019s an ape here, and everyone\u2019s welcome.\n\nGet or Collect cool cosmetics to show off your style, discover hidden spots in the world, and maybe even become a mod if you're active in the community. Got art skills? Your fanart could show up right in the game.\n\nGreat Ape is all about the community, the creativity, and having a good time. Jump in and be part of it!", "short_description": "This is a game about apes. Big, small, silly, chill. You\u2019ll explore fun maps, meet other players, and hang out. Everyone\u2019s an ape here, and everyone\u2019s welcome.\n\nGet or Collect cool cosmetics to show off your style, discover hidden spots in the world, and maybe even become a mod if you're active in the community. Got art skills? Your fanart could show up right in the game.\n\nGreat Ape is all about the community, the creativity, and having a good time. Jump in and be part of it!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/great-ape/privacy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/great-ape/terms-of-service", "publisher_name": "Phoenic Interactive", "support_website_url": "https://sites.google.com/view/great-ape/contact-us", "website_url": "https://sites.google.com/view/great-ape/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "24151824097770168"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499307434_2572121236462920_7070377893387168767_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vG4JUwQOq6EQ7kNvwH8tGxH&_nc_oc=AdoaFFIFkY1CZ_0XL0V5SInHwcbUfi8D2CkPphLzr_FUBMYYUs9caByGhrQMvnTxOnk&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af833iEiBU6jZp7myn9JO7xaDmoSuNS3SCe6Daa6rKZ57Q&oe=6A22
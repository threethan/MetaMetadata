 silly, chill. You\u2019ll explore fun maps, meet other players, and hang out. Everyone\u2019s an ape here, and everyone\u2019s welcome.\n\nGet or Collect cool cosmetics to show off your style, discover hidden spots in the world, and maybe even become a mod if you're active in the community. Got art skills? Your fanart could show up right in the game.\n\nGreat Ape is all about the community, the creativity, and having a good time. Jump in and be part of it!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/great-ape/privacy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/great-ape/terms-of-service", "publisher_name": "Phoenic Interactive", "support_website_url": "https://sites.google.com/view/great-ape/contact-us", "website_url": "https://sites.google.com/view/great-ape/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "24151824097770168"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499307434_2572121236462920_7070377893387168767_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uUROhZChS6UQ7kNvwESz5ZB&_nc_oc=AdrMgo3BsnXAd5codepyC2edXN0ShmZVAYDwqYVXdyLKxGASYkPL4GhcYa-6y7g1laE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBgQMWtn8pTZbCzNASuFSci__-Co7IddIgAfi9HV9yihw&oe=6A56459E"}, "is_
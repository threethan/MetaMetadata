", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491820574_973602254700785_6037398430338364697_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dFV_O4FzP-MQ7kNvwGc2db0&_nc_oc=Adp6isKm7yPrafuNhF7tW3cGacZdxiw9o-mwYr0slDjASvQaNqbi77BV8lDiIf3SWWM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLcDWI-eD52xOL6WnjEquO3oFouiZy6d2b8GLJBlf-sDA&oe=6AA414E9"}, {"file_name": "Screenshot 2025-06-11 134444.png", "id": "1259497545772079", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499305403_1259497549105412_4034038312616964136_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wjPm0IGfCiMQ7kNvwGi5hOk&_nc_oc=Adqlfm2efKta_iCeH5Ir_80qp_7vk8t-UIdp-y7RWh-5aEKp7jfmKGxE2b3W0prnxU0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9jX51tKiL11cHutPXvojTAblRDtN6PeuaJB31WMz-DQ&oe=6AA423EC"}, {"file_name": "Screenshot 2025-06-11 134438.png", "id": "1279009813739879", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499295562_1279009817073212_7133662711727504668_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mYb5qscGPtQQ7kNvwEer0Zn&_nc_oc=AdrfvoFq9gdveJ4rFFiqgSLtSyVxZNAcFHozdM1KkIZEiuIWxp3W7jRHDjQwNYHN02Q&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJgX694isZRASI6d2Z3hCcyFISZEXpqtq6jYmDmRVcNZA&oe=6AA407C7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Great Ape", "keywords": ["cat", "chasers", "chase"], "long_description": "This is a game about apes. Big, small, silly, chill. You\u2019ll explore fun maps, meet other players, and hang out. Everyone\u2019s an ape here, and everyone\u2019s welcome.\n\nGet or Collect cool cosmetics to show off your style, discover hidden spots in the world, and maybe even become a mod if you're active in the community. Got art skills? Your fanart could show up right in the game.\n\nGreat Ape is all about the community, the creativity, and having a good time. Jump in and be part of it!", "short_description": "This is a game about apes. Big, small, silly, chill. You\u2019ll explore fun maps, meet other players, and hang out. Everyone\u2019s an ape here, and everyone\u2019s welcome.\n\nGet or Collect cool cosmetics to show off your style, discover hidden spots in the world, and maybe even become a mod if you're active in the community. Got art skills? Your fanart could show up right in the game.\n\nGreat Ape is all about the community, the creativity, and having a good time. Jump in and be part of it!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/great-ape/privacy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/great-ape/terms-of-service", "publisher_name": "Phoenic Interactive", "support_website_url": "https://sites.google.com/view/great-ape/contact-us", "website_url": "https://sites.google.com/view/great-ape/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "24151824097770168"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499307434_2572121236462920_7070377893387168767_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ito7qIfyiP0Q7kNvwEX7xS5&_nc_oc=AdrAe0DZnJtn5F5iPJqG15ZASvoibK-Ce9ZKfzjm3agZVxVuhTC9U6v14J_oL7YqbGw&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvaUjwi-7pQLFIhYm77pScZTTVsAos46wEAAshiRq8ag&oe=6AA4
om/v/t64.5771-25/491820574_973602254700785_6037398430338364697_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zm1DFa3a8y8Q7kNvwHUCZ7O&_nc_oc=AdmT-5TItV_T3aGMdSF9vaBnSxreVp5ofkI3CluFctyE-p-rQkrQBE2suZ63gnxLwqM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxlNJQNTFinSz21k_HfiAW1agJJ1nX4rFmYo5eLSfE3mw&oe=69AD5429"}, {"file_name": "Screenshot 2025-06-11 134444.png", "id": "1259497545772079", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499305403_1259497549105412_4034038312616964136_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5oKA88sKl-AQ7kNvwEQo9ry&_nc_oc=AdlEoWT1BjMKj-Fg8n0JgArMfssOHIJj5P0ghjLgp_5H8z8pVMV8P1ZqioGW-PP_FNY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy57GPagWK5IGMN9cvsQMMoQiPpkxKLnKVU8yz0hObxog&oe=69AD632C"}, {"file_name": "Screenshot 2025-06-11 134438.png", "id": "1279009813739879", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499295562_1279009817073212_7133662711727504668_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o04L4IwLwUEQ7kNvwFd4Rn8&_nc_oc=AdnO9wo1dSeMbOFT5PSwPa8VI-oljD7iG_G3FLYACHQ_v0OlcOXiB8SaMPXU9twEtkM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afys4BsP3ypTfKlU0F-6ICf0dl_vG-LpT--JItBcjI8MCQ&oe=69AD7F47"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Great Ape", "keywords": ["cat", "chasers", "chase"], "long_description": "This is a game about apes. Big, small, silly, chill. You\u2019ll explore fun maps, meet other players, and hang out. Everyone\u2019s an ape here, and everyone\u2019s welcome.\n\nGet or Collect cool cosmetics to show off your style, discover hidden spots in the world, and maybe even become a mod if you're active in the community. Got art skills? Your fanart could show up right in the game.\n\nGreat Ape is all about the community, the creativity, and having a good time. Jump in and be part of it!", "short_description": "This is a game about apes. Big, small, silly, chill. You\u2019ll explore fun maps, meet other players, and hang out. Everyone\u2019s an ape here, and everyone\u2019s welcome.\n\nGet or Collect cool cosmetics to show off your style, discover hidden spots in the world, and maybe even become a mod if you're active in the community. Got art skills? Your fanart could show up right in the game.\n\nGreat Ape is all about the community, the creativity, and having a good time. Jump in and be part of it!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/great-ape/privacy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/great-ape/terms-of-service", "publisher_name": "Phoenic Interactive", "support_website_url": "https://sites.google.com/view/great-ape/contact-us", "website_url": "https://sites.google.com/view/great-ape/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "24151824097770168"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307434_2572121236462920_7070377893387168767_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R0wZZVmyvq4Q7kNvwEHKLCj&_nc_oc=AdklcYZdUYuctQaw6Gqnid1GDZADPvxyE61n7jMohabESpIN9qQ9yxMbzplVIUsgwzc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyiEkly5VnvgAOKF39PSC9Xbimfv7nLL1Uyush214KTrQ&oe=69AD859E"}, "is_concept": false, "is_test": false, "is_trial_offer_v
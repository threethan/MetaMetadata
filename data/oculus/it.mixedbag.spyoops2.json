LH4Rwrcu-yfpWD8_CfPZcXLIbibd8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwhhBfnqwi1DXurzO7c5zetgzprP_mxWIr2o0fEfZ5FNQ&oe=69CD0CAD"}, {"file_name": "Agent-OOPS-11.png", "id": "1851855702141526", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818885_1851855708808192_7109213106539395430_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_JdAGVFoP90Q7kNvwEAz2cG&_nc_oc=AdrEUC4pKBKngzVzjcI8if_IUiXBP4kC9Fmuk2YX-uYsq2gykHhCy2L2RoiVaDfKkb0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfywXi9eGa_jRV6mU9s07JO1wmi-SCHKJv-PKaVvwsFuMw&oe=69CD2469"}, {"file_name": "Agent-OOPS-12.png", "id": "862642416805930", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822307_862642420139263_6489118943996793648_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XVC98uocvYYQ7kNvwEFEKiL&_nc_oc=Adrjydt-npErB7j_EeY1msqdWH6__DudVcl26EEGtz9j5q2TcO_TvySpQJ0vvH7Vtns&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzq6mf1AcNiD8bx820VDLdAGbCX7vkdGzOdoUoqGcga9A&oe=69CD0E08"}, {"file_name": "Agent-OOPS-15.png", "id": "852848177809780", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827567_852848181143113_5115784917974691756_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OBrPoizBrFMQ7kNvwFq4xiF&_nc_oc=AdovULTaNsxRBN3MbzAlHiDMjuwaLvyTK9v0mtC2tVF7rHGB_FykT-zF8shilkqsT4s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx2weagSs0KsC5xy1phrv-4dWe2YleERo7hZi8SUa424A&oe=69CD00AA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Agent Oops!", "keywords": [], "long_description": "Agent Oops! is the cooperative Mixed Reality party game for 1-4 players that redefines how we play together! Charles is known as \u201cthe world\u2019s greatest spy\u201d... but only because you\u2019re there to save him: without your help, he wouldn't last five minutes! \n{2319338888471603}\nUse the Spymatic 5000 in your room, which becomes an active part of the action! Deactivate deadly traps and lasers, avoid dangers, and use spy tools to help Charles: use a giant hair dryer to defrost devices, slice through obstacles with a katana, or use the X-Ray device to see through a storm! Crouch down to avoid detection or move to dodge a geyser: your body is part of the mission!\n{1230664015846964}\n\ud83d\udc65 1-4 player co-op: Playable solo, online, or in local co-location (same room) for a revolutionary experience.\n\n\ud83d\udd90\ufe0f Hands Enhanced Gameplay: Play without controllers! Includes unique mechanics and interactions thanks to  hand tracking.\n\n\ud83d\udee0\ufe0f Level Editor: Create, share and play your own custom levels.\n\n\ud83c\udfe0 Spy Base: Build and customize your headquarters between missions.\n{678892018640110}\nWith 11 worlds to explore, over 180 unique levels, and the ability to create your own missions, Agent Oops! is a dynamic, chaotic, and social experience. Can you make the world believe that Charles is a true legend?", "short_description": "Agent Oops! is the cooperative Mixed Reality party game for 1-4 players that redefines how we play together! Collaborate with your friends to help Charles, the world\u2019s clumsiest spy, by deactivating deadly traps, avoiding security cameras and using crazy spy tools. Featuring 11 worlds to explore, over 180 unique levels and the ability to create your own missions, Agent Oops! is a dynamic, chaotic, and social experience. Can you make the world believe that Charles is a true legend?"}]}, "developer_name": "Memorable Games", "developer_privacy_policy_url": "https://memorable.games/agentoops_privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Memorable Games", "support_website_url": null, "website_url": "https://memorable.games/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "459781504968480"}, {"
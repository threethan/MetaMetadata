{"data": {"node": {"__typename": "Application", "id": "9349410855149756", "organization": {"id": "1062035423913969", "viewer_permissions": [], "application_groupings": {"nodes": [{"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "9349410855149756"}]}, "id": "1176984790701753"}]}}, "firstRevision": {"nodes": [{"application": {"id": "9349410855149756", "release_date": 1773939600, "is_concept": false, "platform": "ANDROID_6DOF", "scheduled_offers": {"count": 2}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26288356494161927"}, "id": "9610503472313362"}]}}, "binary": null, "live_binary": null, "created_date": 1773866467, "id": "26281857464811830", "is_initial_release": false, "name_with_fallback": "v2", "pdp_metadata_with_fallback": {"version": 2, "application": {"is_concept": false, "latest_released_pdp_metadata": {"id": "26282154844782092"}, "release_status": "RELEASED", "id": "9349410855149756"}, "id": "26282154844782092", "release_status": "RELEASED", "status": "APPROVED"}, "release_date": null, "administration_status": "APPROVED", "is_first": false, "release_status": "RELEASED", "release_type": "SCHEDULED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "9349410855149756", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1596167624929766"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "2787999618228899", "locale": "it_IT", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Agent Oops!", "keywords": [], "long_description": "Agent Oops! \u00e8 il party game cooperativo in Mixed Reality per 1-4 giocatori che ridefinisce il modo di giocare insieme! Charles \u00e8 considerato \u201cla pi\u00f9 grande spia del mondo\u201d... ma solo perch\u00e9 siete voi a salvarlo: senza il vostro aiuto non sopravviverebbe nemmeno cinque minuti! \n{932785072571236}\nUtilizza lo Spymatic 5000 nella tua stanza, che diventa parte attiva dell\u2019azione! Disattiva trappole e laser mortali, evita i pericoli e usa gli strumenti da spia per aiutare Charles: usa un phon gigante per scongelare meccanismi, affetta ostacoli con la katana o usa il congegno X-Ray per vedere attraverso una tempesta! Abbassati per non farti rilevare o spostati per schivare un geyser: il tuo corpo \u00e8 parte della missione!\n{1423115036232258}\n\ud83d\udc65 Co-op da 1 a 4 giocatori: Giocabile in solo, online o in co-location locale (stessa stanza), per un'esperienza rivoluzionaria.\n\n\ud83d\udd90\ufe0f Hands Enhanced Gameplay: Gioca senza controller! Include meccaniche dedicate come battimani e punchball grazie al tracciamento delle mani.\n\n\ud83d\udee0\ufe0f Level Editor: Crea, gioca e condividi i tuoi livelli personalizzati.\n\n\ud83c\udfe0 Spy Base: Costruisci e personalizza il tuo quartier generale tra una missione e l\u2019altra.\n{2432118533920021}\nCon 11 mondi da esplorare, oltre 180 livelli unici e la possibilit\u00e0 di creare le tue missioni, Agent Oops! \u00e8 un\u2019esperienza dinamica, caotica e sociale. Riuscirete a far credere al mondo che Charles sia un vero mito?", "short_description": "Agent Oops! \u00e8 il party game in Mixed Reality per 1-4 giocatori che ridefinisce il modo di giocare insieme! Collabora con i tuoi amici per aiutare Charles, la spia pi\u00f9 maldestra del mondo, disattivando trappole mortali, utilizzando gadget folli ed evitando telecamere di sicurezza. Con 11 mondi da esplorare, oltre 180 livelli unici e la possibilit\u00e0 di creare le tue missioni, Agent Oops! \u00e8 un\u2019esperienza dinamica, caotica e sociale. Riuscirete a far credere al mondo che Charles sia un vero mito?"}, {"images": {"nodes": [{"file_name": "META_Banner_Square_WithCharles.png", "id": "2051513815607093", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-
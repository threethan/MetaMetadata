cdn.com/v/t64.5771-25/491821115_8464038217054205_1891297688631955910_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7q017rSTLD8Q7kNvwEuHJyL&_nc_oc=AdrX36OEGAoWI85fxs7iZ1wikDvCgXjfuTF1xPmloIoFfdSFvS65twBs9rzDfoo5s3A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNv9L9Ro9hQVtsLeJPILGpsrJnexdeR65ab5_FkzoLjBQ&oe=6AC663FC"}, {"file_name": "4.1.png", "id": "1455808792517113", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819323_1455808795850446_2619027289177886412_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x30r0qtc8esQ7kNvwGEXKJ0&_nc_oc=AdpM6WN_1xBEwpv7JquXBwQkvjnnZ3SW_ZMJIcsqEKgQyYc8664qciSDXXI4m4K_A0w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMH2UMjOhLhTqMA3HrBjUwNDImXPJfIjNkdmXAHh3ecBw&oe=6AC66CA4"}, {"file_name": "8.png", "id": "668248229368270", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823343_668248232701603_7422950020516075715_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=89A20-nlNakQ7kNvwH_TWmo&_nc_oc=AdpAi3LP6a2nJv5Vqs2KEzeiBWjJ9FoPv8uvRzKYNJxHqNy_9tRWQMRL7GwfjYjYjY8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPxph7eYagufU71Yo2hwbkCftkA3DcTr9kw0dUVBVTrGg&oe=6AC6515A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "6.png", "id": "1043468724516956", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820512_1043468731183622_3507501700877445676_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gI7FxYTyH_oQ7kNvwGxbjjX&_nc_oc=Adr5vLvG-7NF8GLyWyVDfTk9zlq3MN6tK5qHYIYQ8ECnQc8Z4fI1ZX0Yd_BgsbbuvF8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOcQ3A8Av6qTIMhtjKcA9Ek20N99-LAK9OioETKXwm8YQ&oe=6AC651C2"}, "display_name": "Dinosaur Prehistoric Hunter VR", "keywords": ["dinosaurHuntingVR", "vrDinosaurShooter", "realisticDinoHunt", "vrBowAndArrow", "dinosaurKillerVR"], "long_description": "Step into a fully immersive VR world where survival meets prehistoric danger. In Dinosaur Prehistoric Hunter VR, you\u2019ll explore a beautifully crafted ancient jungle filled with nine deadly dinosaur species including the legendary T-Rex. Armed with powerful weapons like the MP5, shotgun, handgun, bow and arrow, and even a sword, you'll experience intense, heart-pounding action with every encounter.\n\nEvery dinosaur is designed with lifelike animations and intelligent behavior, making each hunt feel thrilling and unpredictable. Stunning realistic graphics, dynamic environments, and immersive 3D sound effects make you feel like you're really there. Whether you're sneaking through the underbrush or taking down a raptor mid-charge, every moment is packed with tension and realism.\n\nWith multiple game modes, including survival and free hunt, and intuitive VR controls built for Meta Quest, this game delivers a top-tier action adventure for fans of dinosaur games, hunting sims, and VR shooting experiences.\n\n", "short_description": "Step into a breathtaking prehistoric world where you become the hunter. In Dinosaur Prehistoric Hunter VR, you\u2019ll face off against nine unique dinosaur species, including the legendary T-Rex. Use a variety of weapons like the MP5, shotgun, handgun, bow and arrow, or even a sword to survive intense encounters. Designed with highly realistic graphics and immersive sound, this VR experience brings the thrill of dinosaur hunting to life like never before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abdurrehmanmma12327.github.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Ab Dur Rehman", "support_website_url": null, "website_url": "https://abdurrehmanmma12327.github.io/privacy-policy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "intern
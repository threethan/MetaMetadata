054206", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491821115_8464038217054205_1891297688631955910_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jH14qJPPMWYQ7kNvwHUM61p&_nc_oc=AdlY23tt6KTuOtqJYngKFIVRj5frxVq7N_rSTEtF7Hoq3Idex4JgrOCodh_Hl-aSfSI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy2_Q7HcTTexA4_t1d_l56vVswreQdZ55mLBvdkylFA6w&oe=69BD2E3C"}, {"file_name": "4.1.png", "id": "1455808792517113", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491819323_1455808795850446_2619027289177886412_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hp5qs88VOFUQ7kNvwF8ptjk&_nc_oc=AdmmoiIsjyPQpo-7SO1FqlJAcPcrnESdeDyO4TjXHqo8a3kSV7KZF3j8af8eFA68N2M&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz-r5nm2u3ehyHFiDioSOki05nr3z-9_K6Qwl9fdnmlcA&oe=69BD36E4"}, {"file_name": "8.png", "id": "668248229368270", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823343_668248232701603_7422950020516075715_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iv1n8izgi54Q7kNvwHuwBdl&_nc_oc=AdmJY4YWOjKWwrMKaz7BwewQxuL2Y8AwmxZQPjlQhn0REic5Lq2-vTyhnWhVUeZh5hk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwMgSinyp_q-__oPPiVtRqNjnWB41o5FurzbScF9QWlpA&oe=69BD53DA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "6.png", "id": "1043468724516956", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491820512_1043468731183622_3507501700877445676_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OUTfxft2FfIQ7kNvwFe8jm9&_nc_oc=AdnCBQQwE1FmWAu9RZgOEZJCh6ourLVb3QQv1aFH6wETA9oIP3aWsF2GpCHIMOfZezY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzxDN66bn5ERj3w0COqoN9CygVG18Hi8Zxbw26Ek2ycXQ&oe=69BD5442"}, "display_name": "Dinosaur Prehistoric Hunter VR", "keywords": ["dinosaurHuntingVR", "vrDinosaurShooter", "realisticDinoHunt", "vrBowAndArrow", "dinosaurKillerVR"], "long_description": "Step into a fully immersive VR world where survival meets prehistoric danger. In Dinosaur Prehistoric Hunter VR, you\u2019ll explore a beautifully crafted ancient jungle filled with nine deadly dinosaur species including the legendary T-Rex. Armed with powerful weapons like the MP5, shotgun, handgun, bow and arrow, and even a sword, you'll experience intense, heart-pounding action with every encounter.\n\nEvery dinosaur is designed with lifelike animations and intelligent behavior, making each hunt feel thrilling and unpredictable. Stunning realistic graphics, dynamic environments, and immersive 3D sound effects make you feel like you're really there. Whether you're sneaking through the underbrush or taking down a raptor mid-charge, every moment is packed with tension and realism.\n\nWith multiple game modes, including survival and free hunt, and intuitive VR controls built for Meta Quest, this game delivers a top-tier action adventure for fans of dinosaur games, hunting sims, and VR shooting experiences.\n\n", "short_description": "Step into a breathtaking prehistoric world where you become the hunter. In Dinosaur Prehistoric Hunter VR, you\u2019ll face off against nine unique dinosaur species, including the legendary T-Rex. Use a variety of weapons like the MP5, shotgun, handgun, bow and arrow, or even a sword to survive intense encounters. Designed with highly realistic graphics and immersive sound, this VR experience brings the thrill of dinosaur hunting to life like never before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abdurrehmanmma12327.github.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Ab Dur Rehman", "support_website_url": null, "website_url": "https://abdurrehmanmma12327.github.io/privacy-policy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], 
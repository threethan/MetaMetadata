296901125233_94077424496935004_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iW_FSP4N4jMQ7kNvwGsX5hP&_nc_oc=AdrOqY_1g0Lzd1G4BpeYpYTyDpJpIx_cVrxf6JpHMFUr1CAeyW_PAOrrqieIjsX_HFI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGhStt_35494bpmcjmOeHKD7OmO9hSmo2VIt9Xgr9A8bw&oe=6A7C7CD8"}, {"file_name": "3.2.png", "id": "8464038207054206", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821115_8464038217054205_1891297688631955910_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gaJ9RL1UKuAQ7kNvwFjN4Hq&_nc_oc=AdoLgXL1YR2IL6fZYPgANiQhZMBOiSh89dYTOFnETyGe-QOELEibmKB9VeElnE1QYls&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHrWY-xFbBlr2DWvbjUlFD5JdM2_RkqJPDlVEfYDS51FA&oe=6A7C57BC"}, {"file_name": "4.1.png", "id": "1455808792517113", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819323_1455808795850446_2619027289177886412_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=52oXyjQfFCYQ7kNvwFmmBe2&_nc_oc=Ado-_uJaHEpXHru_GuMVyEiaZ3Cen18TtVOxTiUOtXIbwlZcVZYHZV8DLfGhDw-Evrg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_vdPrC5L5ScAPFNAIbiCHm6LHyFQdVxzwYdt4y8R7eA&oe=6A7C6064"}, {"file_name": "8.png", "id": "668248229368270", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823343_668248232701603_7422950020516075715_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xQsk7Dt3ySgQ7kNvwEXfaI3&_nc_oc=AdrwdgH2vh0BUW_JTQUsaYTH_QRuiuWT7prRhd_ieanEMXduy7Ic9j57nHnp3iurL3A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGPMspzkSgadzO2O49N6F9cxSaEumCve1dHwto2kpGxHw&oe=6A7C7D5A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "6.png", "id": "1043468724516956", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820512_1043468731183622_3507501700877445676_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xqfa8jRYCwcQ7kNvwGbA4UC&_nc_oc=AdqDwLKNLAR_XUNkfi_HfklBlZ-IQFPqfac6fmMh8dElz9bf3atMUUT_5BhftB-dTAM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3_mFavpGQYtCPV-v8bvTuf87YNYzLx0bkudd9enIZyA&oe=6A7C7DC2"}, "display_name": "Dinosaur Prehistoric Hunter VR", "keywords": ["dinosaurHuntingVR", "vrDinosaurShooter", "realisticDinoHunt", "vrBowAndArrow", "dinosaurKillerVR"], "long_description": "Step into a fully immersive VR world where survival meets prehistoric danger. In Dinosaur Prehistoric Hunter VR, you\u2019ll explore a beautifully crafted ancient jungle filled with nine deadly dinosaur species including the legendary T-Rex. Armed with powerful weapons like the MP5, shotgun, handgun, bow and arrow, and even a sword, you'll experience intense, heart-pounding action with every encounter.\n\nEvery dinosaur is designed with lifelike animations and intelligent behavior, making each hunt feel thrilling and unpredictable. Stunning realistic graphics, dynamic environments, and immersive 3D sound effects make you feel like you're really there. Whether you're sneaking through the underbrush or taking down a raptor mid-charge, every moment is packed with tension and realism.\n\nWith multiple game modes, including survival and free hunt, and intuitive VR controls built for Meta Quest, this game delivers a top-tier action adventure for fans of dinosaur games, hunting sims, and VR shooting experiences.\n\n", "short_description": "Step into a breathtaking prehistoric world where you become the hunter. In Dinosaur Prehistoric Hunter VR, you\u2019ll face off against nine unique dinosaur species, including the legendary T-Rex. Use a variety of weapons like the MP5, shotgun, handgun, bow and arrow, or even a sword to survive intense encounters. Designed with highly realistic graphics and immersive sound, this VR experience brings the thrill of dinosaur hunting to life like never before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abdurrehmanmma12327.github.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Ab Dur Rehman", "support_website_url": null, 
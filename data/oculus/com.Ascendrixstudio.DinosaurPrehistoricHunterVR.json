296901125233_94077424496935004_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZIvxFGE00hAQ7kNvwHaCXH1&_nc_oc=AdrAQL0p2rcmBInkOzqZpq3wMYld0A_bE6QxnTcPbprMWh3E104XLMKhXjQ1PhnNSkY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAYok2BrwCBVakvBS_Z6-LuQV6RaiFir0Mv9WrSXT9lfA&oe=6A6A07D8"}, {"file_name": "3.2.png", "id": "8464038207054206", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821115_8464038217054205_1891297688631955910_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=shlwQJBCQocQ7kNvwEB8oTq&_nc_oc=Adom97IuWrXAJ02T3plCDPz3dDp72thc-NGUiOgS-WA99OqzRmM3G9fF0G2QrCCF5RI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDemWhHK0y_m-nTNP4zTOln6QiWehWkbpogbXYSwdX3lg&oe=6A69E2BC"}, {"file_name": "4.1.png", "id": "1455808792517113", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819323_1455808795850446_2619027289177886412_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RDdfkMRLNxAQ7kNvwHsCxlP&_nc_oc=AdpzT7RETeV7OZMbjE07PcM6JLb5OkNsasgDOo9TlMFbg77C5PjI5F7IBCjJAnS6Kko&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDRFavASsY9gdllmVzXEWbLzRFEclwjjrvDI8XyXzUa1g&oe=6A69EB64"}, {"file_name": "8.png", "id": "668248229368270", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823343_668248232701603_7422950020516075715_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=900KvHQGEc0Q7kNvwHfxnPe&_nc_oc=Ado-S6LmwR4O4UvmdvXzK-PJDdI_I_v0TzTl6gYgZ059Xw-nATnAXdpl2dpKSzgUNXo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmPmoGvXbHjQim7xuelO3HSOYakDm6FlXpL8hpgrH9CA&oe=6A6A085A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "6.png", "id": "1043468724516956", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820512_1043468731183622_3507501700877445676_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NcTxVn1f6_QQ7kNvwFCmA21&_nc_oc=AdqlEYuBbTObyML9x9iqjV-LRUElrw7rFJRjKZYupF2mvJOGC2u3wQcIlhRRc5U5qkE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAIdf-onysnSVcYxmdu6tFIPFSZXELXS7YQCUZuVWbBsw&oe=6A6A08C2"}, "display_name": "Dinosaur Prehistoric Hunter VR", "keywords": ["dinosaurHuntingVR", "vrDinosaurShooter", "realisticDinoHunt", "vrBowAndArrow", "dinosaurKillerVR"], "long_description": "Step into a fully immersive VR world where survival meets prehistoric danger. In Dinosaur Prehistoric Hunter VR, you\u2019ll explore a beautifully crafted ancient jungle filled with nine deadly dinosaur species including the legendary T-Rex. Armed with powerful weapons like the MP5, shotgun, handgun, bow and arrow, and even a sword, you'll experience intense, heart-pounding action with every encounter.\n\nEvery dinosaur is designed with lifelike animations and intelligent behavior, making each hunt feel thrilling and unpredictable. Stunning realistic graphics, dynamic environments, and immersive 3D sound effects make you feel like you're really there. Whether you're sneaking through the underbrush or taking down a raptor mid-charge, every moment is packed with tension and realism.\n\nWith multiple game modes, including survival and free hunt, and intuitive VR controls built for Meta Quest, this game delivers a top-tier action adventure for fans of dinosaur games, hunting sims, and VR shooting experiences.\n\n", "short_description": "Step into a breathtaking prehistoric world where you become the hunter. In Dinosaur Prehistoric Hunter VR, you\u2019ll face off against nine unique dinosaur species, including the legendary T-Rex. Use a variety of weapons like the MP5, shotgun, handgun, bow and arrow, or even a sword to survive intense encounters. Designed with highly realistic graphics and immersive sound, this VR experience brings the thrill of dinosaur hunting to life like never before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abdurrehmanmma12327.github.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Ab Dur Rehman", "support_website_url": null, 
1820940_1798296901125233_94077424496935004_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q4W-8ozDynIQ7kNvwHpUqjE&_nc_oc=Adrps-DKIk9TFS9zfKKj8VAyuigtd1IxjvaJDfJua19pIyhdPZ_YCNDA4UyORDhzLPY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFlHds9bW3EmPd7DiB-j_3FPV92lUBIGYmTgQr8TiAY_Q&oe=6A8D6818"}, {"file_name": "3.2.png", "id": "8464038207054206", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491821115_8464038217054205_1891297688631955910_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cxcdRRM7XuQQ7kNvwGGhn-N&_nc_oc=AdrJHHGoBaTL19BpIHAU18cXhXcZ4tQCIxKWIp1Z-4NolBJiK5QFNGe-RYZF9hTGIgw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEKlo_Fk--oUf57wS5meK0xpsnEmOPYaZGU9EpCCnmG9Q&oe=6A8D7B3C"}, {"file_name": "4.1.png", "id": "1455808792517113", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491819323_1455808795850446_2619027289177886412_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qpL9FvNHAZYQ7kNvwGpUglw&_nc_oc=Adp0d5Ljb9IPbM8hZilxmqd_y6ob8AoP3EmoF7onN3AxgZqDFwYxZTAMrAY5Tk08DvI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_JEL0QepAJRE1kJZ1My9CHQwFe58ivVD08UzGqA391g&oe=6A8D83E4"}, {"file_name": "8.png", "id": "668248229368270", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491823343_668248232701603_7422950020516075715_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U5GOqk203c4Q7kNvwEevbam&_nc_oc=AdrVXkwO-10gIxEXYH4wTC9LbOxWQpmkKRvbdJkRT1aj1MTDpW4Dvnlx96RDLsCEFFI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFoET6NtEbfoMg--BiU1BfZZQbc0PhecYdDcFbIEAsF_Q&oe=6A8D689A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "6.png", "id": "1043468724516956", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491820512_1043468731183622_3507501700877445676_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DyohIdh633EQ7kNvwFT_Fd7&_nc_oc=AdrLhRTZkFsYXxdAvXNyB88qvCImVCpUggreZzK2YBjrAuxb3EVnWMxZtR0WvGHWIfc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEU2Ek_vXqfGpIZ2Itoe2sx_owCIHHhVlCMl2elccgO2A&oe=6A8D6902"}, "display_name": "Dinosaur Prehistoric Hunter VR", "keywords": ["dinosaurHuntingVR", "vrDinosaurShooter", "realisticDinoHunt", "vrBowAndArrow", "dinosaurKillerVR"], "long_description": "Step into a fully immersive VR world where survival meets prehistoric danger. In Dinosaur Prehistoric Hunter VR, you\u2019ll explore a beautifully crafted ancient jungle filled with nine deadly dinosaur species including the legendary T-Rex. Armed with powerful weapons like the MP5, shotgun, handgun, bow and arrow, and even a sword, you'll experience intense, heart-pounding action with every encounter.\n\nEvery dinosaur is designed with lifelike animations and intelligent behavior, making each hunt feel thrilling and unpredictable. Stunning realistic graphics, dynamic environments, and immersive 3D sound effects make you feel like you're really there. Whether you're sneaking through the underbrush or taking down a raptor mid-charge, every moment is packed with tension and realism.\n\nWith multiple game modes, including survival and free hunt, and intuitive VR controls built for Meta Quest, this game delivers a top-tier action adventure for fans of dinosaur games, hunting sims, and VR shooting experiences.\n\n", "short_description": "Step into a breathtaking prehistoric world where you become the hunter. In Dinosaur Prehistoric Hunter VR, you\u2019ll face off against nine unique dinosaur species, including the legendary T-Rex. Use a variety of weapons like the MP5, shotgun, handgun, bow and arrow, or even a sword to survive intense encounters. Designed with highly realistic graphics and immersive sound, this VR experience brings the thrill of dinosaur hunting to life like never before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abdurrehmanmma12327.github.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Ab Dur Rehman", "support_
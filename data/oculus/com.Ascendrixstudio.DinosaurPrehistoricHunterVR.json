296901125233_94077424496935004_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gb2pXw6T97gQ7kNvwEBQ1Ls&_nc_oc=AdoH9FebcXO5s7-7Vf6bIFcMaYp6_fRIYjpduCGlcobbvaZ5tPXudVWqNFHINkW0_DM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPnY4IA-LXU7ySBveH3G4fVOoz91iXIbhP4aant5k9nOw&oe=6ADCBA58"}, {"file_name": "3.2.png", "id": "8464038207054206", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491821115_8464038217054205_1891297688631955910_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yoA9HTECf7MQ7kNvwG0DXvC&_nc_oc=Adp3zmBXebXgNe3KbbYamLn7cJOQhj_Hv9ny1mSlBnLfFZFBRwB5uIHA10wEwSOi1YI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2rhu9jW812pR2-8MlbKJzFwOAAmdPW9HccmFJtno3GQ&oe=6ADCCD7C"}, {"file_name": "4.1.png", "id": "1455808792517113", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491819323_1455808795850446_2619027289177886412_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_cI418HdkRsQ7kNvwGvlR9h&_nc_oc=Ado1rPTZAspK4pqK9iU2u4gFFEOGfKiuQmIv2W9Xehc_EAGLxTfzg-On75imhp6lvRc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPFMfawpfP0LyTKACaEMGTwqflbSvAoBHVDWCEdWQFEjQ&oe=6ADCD624"}, {"file_name": "8.png", "id": "668248229368270", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823343_668248232701603_7422950020516075715_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X7gyZXlK61IQ7kNvwFxV0TK&_nc_oc=AdrLvU_zMD50EViwJeIZzxQpOn-FG92zsQ8uGnnc0ELWnWwuiwy2NZgTNlyOinZ_4Tk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPA6YS2bpG6nfG8ls5lJm3RmXIZ5Qg8CwCjSReVi1PfjA&oe=6ADCBADA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "6.png", "id": "1043468724516956", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491820512_1043468731183622_3507501700877445676_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sLbupiH0yVEQ7kNvwG-SB1E&_nc_oc=Adp8Lyouqkx5e21sR0L8GLOdx7iJ9QIcwZxWmb4y46IEmj183JoG5w1z0WcpyYkl3o8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMRIMGGmIRM25WR8U_ltOn4ckxBT1jpemnT3aHZGlQCMw&oe=6ADCBB42"}, "display_name": "Dinosaur Prehistoric Hunter VR", "keywords": ["dinosaurHuntingVR", "vrDinosaurShooter", "realisticDinoHunt", "vrBowAndArrow", "dinosaurKillerVR"], "long_description": "Step into a fully immersive VR world where survival meets prehistoric danger. In Dinosaur Prehistoric Hunter VR, you\u2019ll explore a beautifully crafted ancient jungle filled with nine deadly dinosaur species including the legendary T-Rex. Armed with powerful weapons like the MP5, shotgun, handgun, bow and arrow, and even a sword, you'll experience intense, heart-pounding action with every encounter.\n\nEvery dinosaur is designed with lifelike animations and intelligent behavior, making each hunt feel thrilling and unpredictable. Stunning realistic graphics, dynamic environments, and immersive 3D sound effects make you feel like you're really there. Whether you're sneaking through the underbrush or taking down a raptor mid-charge, every moment is packed with tension and realism.\n\nWith multiple game modes, including survival and free hunt, and intuitive VR controls built for Meta Quest, this game delivers a top-tier action adventure for fans of dinosaur games, hunting sims, and VR shooting experiences.\n\n", "short_description": "Step into a breathtaking prehistoric world where you become the hunter. In Dinosaur Prehistoric Hunter VR, you\u2019ll face off against nine unique dinosaur species, including the legendary T-Rex. Use a variety of weapons like the MP5, shotgun, handgun, bow and arrow, or even a sword to survive intense encounters. Designed with highly realistic graphics and immersive sound, this VR experience brings the thrill of dinosaur hunting to life like never before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abdurrehmanmma12327.github.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Ab Dur Rehman", "support_website_url": null, 
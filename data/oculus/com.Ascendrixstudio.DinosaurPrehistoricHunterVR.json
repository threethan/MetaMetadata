fclnkWLr92k1OP9OJMOTLNzkHKRwBpWu8oJvgmwkYMmgIG1Q0Tbvo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCsk6uFhJRVfv0HPARr6qrhaEl5ZlmPlUhsEIQeM4Y_sw&oe=6A491258"}, {"file_name": "3.2.png", "id": "8464038207054206", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821115_8464038217054205_1891297688631955910_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TDLFxUHnSncQ7kNvwEm40aa&_nc_oc=AdoKh4NumItzrP7KjVNQ7vzkE_fhbZzLd2QfClfAJYV5iSIZdWmZC7CjOlfs3zDs8Mc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBLSeRPW1XOwceqU2rEGPsrgKUnJ__Ybs7nRTSMtmuSyg&oe=6A49257C"}, {"file_name": "4.1.png", "id": "1455808792517113", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819323_1455808795850446_2619027289177886412_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gyYSx1jv7JgQ7kNvwHELL_6&_nc_oc=AdqsReyLYAGf1Xwu1f5dRXZD4chd7tVSl9krTVErUV73k4I1sjg-dMljQXy1sCJ8BeE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCLvkoxna9ObkLXPRnJQULIUwzvO1Gh8N36TbQA25W20A&oe=6A492E24"}, {"file_name": "8.png", "id": "668248229368270", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823343_668248232701603_7422950020516075715_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HD3KheCSRTkQ7kNvwGY5Pwv&_nc_oc=AdrYM3MICKO2ZwOixf9xuJ6JqjxQazfiPCnRcKM6PW28rhQQ-rUBEd9sgpljWmGX7n0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD80ES6_IEZCXc5s20TY1cu6uN5z-3wNuWEQ6YF7Eebzw&oe=6A4912DA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "6.png", "id": "1043468724516956", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820512_1043468731183622_3507501700877445676_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ux8blDWzBzQQ7kNvwGkz9Yr&_nc_oc=AdpX4EBBpbnhBF3iXrv-lqcBA4q5PwDSE_rdpfMvqL_x7vE19iH26CKwVJCYvvA0wJM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAj9g-zXA83M00J81bSFcjlLrdW8k3B791oFbCoezWA-g&oe=6A491342"}, "display_name": "Dinosaur Prehistoric Hunter VR", "keywords": ["dinosaurHuntingVR", "vrDinosaurShooter", "realisticDinoHunt", "vrBowAndArrow", "dinosaurKillerVR"], "long_description": "Step into a fully immersive VR world where survival meets prehistoric danger. In Dinosaur Prehistoric Hunter VR, you\u2019ll explore a beautifully crafted ancient jungle filled with nine deadly dinosaur species including the legendary T-Rex. Armed with powerful weapons like the MP5, shotgun, handgun, bow and arrow, and even a sword, you'll experience intense, heart-pounding action with every encounter.\n\nEvery dinosaur is designed with lifelike animations and intelligent behavior, making each hunt feel thrilling and unpredictable. Stunning realistic graphics, dynamic environments, and immersive 3D sound effects make you feel like you're really there. Whether you're sneaking through the underbrush or taking down a raptor mid-charge, every moment is packed with tension and realism.\n\nWith multiple game modes, including survival and free hunt, and intuitive VR controls built for Meta Quest, this game delivers a top-tier action adventure for fans of dinosaur games, hunting sims, and VR shooting experiences.\n\n", "short_description": "Step into a breathtaking prehistoric world where you become the hunter. In Dinosaur Prehistoric Hunter VR, you\u2019ll face off against nine unique dinosaur species, including the legendary T-Rex. Use a variety of weapons like the MP5, shotgun, handgun, bow and arrow, or even a sword to survive intense encounters. Designed with highly realistic graphics and immersive sound, this VR experience brings the thrill of dinosaur hunting to life like never before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abdurrehmanmma12327.github.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Ab Dur Rehman", "support_website_url": null, "website_url": "https://abdurrehmanmma12327.github.io/privacy-policy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_
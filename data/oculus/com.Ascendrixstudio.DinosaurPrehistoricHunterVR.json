CcC5YAo2oAaOrL8Ecp07bWdQapiJgzrPXMuXZjR441tjwRo_k5uBE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAcCH9HCVE4NybTi5Y4C8ocBdyQsr882epWC3FIEihBwg&oe=6A54EFD8"}, {"file_name": "3.2.png", "id": "8464038207054206", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491821115_8464038217054205_1891297688631955910_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MlVtebzvxdkQ7kNvwH4wX7C&_nc_oc=AdrFPrtGvpXHjPGXqmqSoh3LpG18TRCopeeCVVLk8aHLOWqKztRyVNMkte1OvESgwvw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDPjrkbiiE75ekrwgcmuh4ipj40d0YwYGE6aWY7gSWVmg&oe=6A5502FC"}, {"file_name": "4.1.png", "id": "1455808792517113", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819323_1455808795850446_2619027289177886412_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a8KCYOVIrdQQ7kNvwHaIQr_&_nc_oc=AdofKcYzzr1xXxHdsjiksyB5dUZ6MdU-I_Gd18x_t3Yn9LV5rBDyp-bmE-Bk13PQddc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZq6aoSyVOOoA133bNv2NmfBXl1yF7amJSZQaQbAMylA&oe=6A54D364"}, {"file_name": "8.png", "id": "668248229368270", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491823343_668248232701603_7422950020516075715_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xa1fsnqPF10Q7kNvwFp5H-b&_nc_oc=AdoW6myfkBeCV0fm-HbeqFrWY31K_DonLPLvjz-xs5sG0t-mUBJWiZhf5GiCW-BjkkE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDB1EUOLUFPGQcvQr0xbzbCDO5d2RD-6GIaDL6hQLbP_Q&oe=6A54F05A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "6.png", "id": "1043468724516956", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820512_1043468731183622_3507501700877445676_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PUidsC7sinQQ7kNvwFPC2I7&_nc_oc=AdprtQkirOnMqI9skIZpD9ROLa2YBxhj9Edv3FnwfAgPe3clUWIDG8UeiLCip-i4tLs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDYORoRqi8ygIQtQ29XJMaJfB-XO3Mtm8cNCZAacS3xBA&oe=6A54F0C2"}, "display_name": "Dinosaur Prehistoric Hunter VR", "keywords": ["dinosaurHuntingVR", "vrDinosaurShooter", "realisticDinoHunt", "vrBowAndArrow", "dinosaurKillerVR"], "long_description": "Step into a fully immersive VR world where survival meets prehistoric danger. In Dinosaur Prehistoric Hunter VR, you\u2019ll explore a beautifully crafted ancient jungle filled with nine deadly dinosaur species including the legendary T-Rex. Armed with powerful weapons like the MP5, shotgun, handgun, bow and arrow, and even a sword, you'll experience intense, heart-pounding action with every encounter.\n\nEvery dinosaur is designed with lifelike animations and intelligent behavior, making each hunt feel thrilling and unpredictable. Stunning realistic graphics, dynamic environments, and immersive 3D sound effects make you feel like you're really there. Whether you're sneaking through the underbrush or taking down a raptor mid-charge, every moment is packed with tension and realism.\n\nWith multiple game modes, including survival and free hunt, and intuitive VR controls built for Meta Quest, this game delivers a top-tier action adventure for fans of dinosaur games, hunting sims, and VR shooting experiences.\n\n", "short_description": "Step into a breathtaking prehistoric world where you become the hunter. In Dinosaur Prehistoric Hunter VR, you\u2019ll face off against nine unique dinosaur species, including the legendary T-Rex. Use a variety of weapons like the MP5, shotgun, handgun, bow and arrow, or even a sword to survive intense encounters. Designed with highly realistic graphics and immersive sound, this VR experience brings the thrill of dinosaur hunting to life like never before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abdurrehmanmma12327.github.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Ab Dur Rehman", "support_website_url": null, "website_url": "https://abdurrehmanmma12327.github.io/privacy-policy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_
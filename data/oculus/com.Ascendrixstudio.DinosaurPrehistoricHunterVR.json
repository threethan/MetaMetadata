xgc7jSV0IfiFrcbI5Dt6KjVb5orssI-ZK4kYpasiCZdgdBUs9K0mo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBbudPJ0lWDqdBr5OvoQaCIWIEoxajUL4KyL5jQ3IG7tA&oe=6A5CD8D8"}, {"file_name": "3.2.png", "id": "8464038207054206", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821115_8464038217054205_1891297688631955910_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bJlCLy3E-IQQ7kNvwEDoE8X&_nc_oc=AdrGlA021jF-97oX9ZDNO-shqSH72baW-keKaSUHM7nIFHENBC3SOp1J_KfHQk0jai4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBvL412Wwcir8G2r4zKD2kTR4QQNfrm1YNfCpFjuALhKw&oe=6A5CB3BC"}, {"file_name": "4.1.png", "id": "1455808792517113", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819323_1455808795850446_2619027289177886412_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-CaAQ_vce4EQ7kNvwHG4qWK&_nc_oc=Adqac3vrnJWhiPXOIZBVv985o4j-pwnBpiQrWDU3QkKsYZDp_nXkIjZIrTHoFiUtAnw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9a1aIsyGUEOyjv6RDCNQZoxr9YhJ9711uEPDiwH9bCQ&oe=6A5CBC64"}, {"file_name": "8.png", "id": "668248229368270", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823343_668248232701603_7422950020516075715_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6u1ZHugaWEoQ7kNvwFsmgBJ&_nc_oc=Adqh2uTxwrV81OYqq6cbYKm42I-NlGV3D3KItK_TPOfj5uzdD2evWUqdEegf1Zd00vY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAYpOu2MTwfAKMbpRHe9GJDBxa8AiuaDwj9giqdhsBxvQ&oe=6A5CD95A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "6.png", "id": "1043468724516956", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820512_1043468731183622_3507501700877445676_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pOhw3RYJkp4Q7kNvwHKZXnP&_nc_oc=AdqS8OryBuq-B0xY5MdcnFOkekYYTrwa2VDVOX2yz-NQQY7TKJW986dgP-fausDCDjs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAv05o7zpVA3UdOn3ithr4rZiagqxdu16Tqtud56OpO_g&oe=6A5CD9C2"}, "display_name": "Dinosaur Prehistoric Hunter VR", "keywords": ["dinosaurHuntingVR", "vrDinosaurShooter", "realisticDinoHunt", "vrBowAndArrow", "dinosaurKillerVR"], "long_description": "Step into a fully immersive VR world where survival meets prehistoric danger. In Dinosaur Prehistoric Hunter VR, you\u2019ll explore a beautifully crafted ancient jungle filled with nine deadly dinosaur species including the legendary T-Rex. Armed with powerful weapons like the MP5, shotgun, handgun, bow and arrow, and even a sword, you'll experience intense, heart-pounding action with every encounter.\n\nEvery dinosaur is designed with lifelike animations and intelligent behavior, making each hunt feel thrilling and unpredictable. Stunning realistic graphics, dynamic environments, and immersive 3D sound effects make you feel like you're really there. Whether you're sneaking through the underbrush or taking down a raptor mid-charge, every moment is packed with tension and realism.\n\nWith multiple game modes, including survival and free hunt, and intuitive VR controls built for Meta Quest, this game delivers a top-tier action adventure for fans of dinosaur games, hunting sims, and VR shooting experiences.\n\n", "short_description": "Step into a breathtaking prehistoric world where you become the hunter. In Dinosaur Prehistoric Hunter VR, you\u2019ll face off against nine unique dinosaur species, including the legendary T-Rex. Use a variety of weapons like the MP5, shotgun, handgun, bow and arrow, or even a sword to survive intense encounters. Designed with highly realistic graphics and immersive sound, this VR experience brings the thrill of dinosaur hunting to life like never before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abdurrehmanmma12327.github.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Ab Dur Rehman", "support_website_url": null, "website_url": "https://abdurrehmanmma12327.github.io/privacy-policy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_
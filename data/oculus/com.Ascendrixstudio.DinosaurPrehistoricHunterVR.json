296901125233_94077424496935004_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iW_FSP4N4jMQ7kNvwGv4PbR&_nc_oc=AdqwGn_IZZp_re71mdfBVNh3sedh-ih6B0Vfo_6o7u16GZ0fvxnO39nfzEgfzpvuMSo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEkcWpi4KL1DjpU6r96mfBxhxs1pxElS_79kJFNp0uphw&oe=6A7B2B58"}, {"file_name": "3.2.png", "id": "8464038207054206", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821115_8464038217054205_1891297688631955910_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6TEsm1Ai2vYQ7kNvwFQJ-dM&_nc_oc=AdpIFwI5Bqlqn5wtv8yGaIYsaoJWEBnIhvyjm5tYJmDqTmHZ5GRtvmPmsF7i6-1aQ_A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGnY3faca4y0rT5tHu4z9FrrPlKWu-2gLhu7c3Py8IOYQ&oe=6A7B063C"}, {"file_name": "4.1.png", "id": "1455808792517113", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819323_1455808795850446_2619027289177886412_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=52oXyjQfFCYQ7kNvwHydc1V&_nc_oc=AdoyxXfUdkGVia5zBD5hQ8CJXc1t4_PBqXPBfSSxxwSoC0NtbbyLAM2sry8PhjBVOkE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdMGs5J8qcM2VTaQoOOsJHxvIm-aukzkunTYEkcPA1dA&oe=6A7B0EE4"}, {"file_name": "8.png", "id": "668248229368270", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823343_668248232701603_7422950020516075715_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xQsk7Dt3ySgQ7kNvwHlsuYR&_nc_oc=Adrq_QXOlUe0VTzVhl5uUoFKWw5hTown54XHApCd8TUca_wLr2kXDSx69fAPg4p_Rwc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF22owQbshuTBgMEh4Pys4PAGrk0OXV25_WsJOTi61fyA&oe=6A7B2BDA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "6.png", "id": "1043468724516956", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820512_1043468731183622_3507501700877445676_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xqfa8jRYCwcQ7kNvwGcTCpZ&_nc_oc=AdqxiqX3gt9eY4yM4fuhjilNUxV0oreaGcvhZBUPH7GPNbQXvU8868okbBv_-Gv3Hqo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEwUv_MqRUgw7TdWbjVWEf7a914TmG5AmIrG3N_lJJ9Eg&oe=6A7B2C42"}, "display_name": "Dinosaur Prehistoric Hunter VR", "keywords": ["dinosaurHuntingVR", "vrDinosaurShooter", "realisticDinoHunt", "vrBowAndArrow", "dinosaurKillerVR"], "long_description": "Step into a fully immersive VR world where survival meets prehistoric danger. In Dinosaur Prehistoric Hunter VR, you\u2019ll explore a beautifully crafted ancient jungle filled with nine deadly dinosaur species including the legendary T-Rex. Armed with powerful weapons like the MP5, shotgun, handgun, bow and arrow, and even a sword, you'll experience intense, heart-pounding action with every encounter.\n\nEvery dinosaur is designed with lifelike animations and intelligent behavior, making each hunt feel thrilling and unpredictable. Stunning realistic graphics, dynamic environments, and immersive 3D sound effects make you feel like you're really there. Whether you're sneaking through the underbrush or taking down a raptor mid-charge, every moment is packed with tension and realism.\n\nWith multiple game modes, including survival and free hunt, and intuitive VR controls built for Meta Quest, this game delivers a top-tier action adventure for fans of dinosaur games, hunting sims, and VR shooting experiences.\n\n", "short_description": "Step into a breathtaking prehistoric world where you become the hunter. In Dinosaur Prehistoric Hunter VR, you\u2019ll face off against nine unique dinosaur species, including the legendary T-Rex. Use a variety of weapons like the MP5, shotgun, handgun, bow and arrow, or even a sword to survive intense encounters. Designed with highly realistic graphics and immersive sound, this VR experience brings the thrill of dinosaur hunting to life like never before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abdurrehmanmma12327.github.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Ab Dur Rehman", "support_website_url": null, 
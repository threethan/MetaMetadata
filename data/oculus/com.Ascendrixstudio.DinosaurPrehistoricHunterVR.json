054206", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491821115_8464038217054205_1891297688631955910_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=76NlprGyPJ4Q7kNvwG7dQdL&_nc_oc=AdrMx48FG-rc5lXkTKJ38iVCjsi80qAMCMwv4uzB3l6Fn2-wkaFs9D2eqVyp1riyd44&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwAtx8dbvn_p4mc56BrNfKKUNSiVAUbDFyk3RxAMmYPfw&oe=69C122BC"}, {"file_name": "4.1.png", "id": "1455808792517113", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819323_1455808795850446_2619027289177886412_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1EP_CRFlK2AQ7kNvwGMaq_D&_nc_oc=AdqTZ3fpLJ_Qrxwt7MNWz8-RS8r_CkmSUXAZTXNKt5kMRPBp6tEgdGjwsGdbqd5d1NM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwroTC3UGNMUpS8GVWKyKn5K-q9DY-1OHvd0NbEjMO1Uw&oe=69C12B64"}, {"file_name": "8.png", "id": "668248229368270", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823343_668248232701603_7422950020516075715_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cCUl1cOu-OgQ7kNvwGcGaOw&_nc_oc=AdoamIa8NfvL0J9TRZLswFUAohun8i2MtNO6vUFsce53yDv57O2lqqeWHFLZzTGLfBo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyTTgW_jLIC4sqthkZ7PrHNOFVQ20_ftNyzGzKLFOBASA&oe=69C1485A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "6.png", "id": "1043468724516956", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491820512_1043468731183622_3507501700877445676_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nrtdu-HrjrcQ7kNvwGqSYbR&_nc_oc=AdoNkHbC_TtGZp_y4CLtoWmfTLHbv4j1dRh4qUKUN3yvqH5SV2r17LJl9P95uK-YjMA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afz_NRR04mMg4UEEXAx6LApfPE69RWe7iacNKbTAqDotcQ&oe=69C148C2"}, "display_name": "Dinosaur Prehistoric Hunter VR", "keywords": ["dinosaurHuntingVR", "vrDinosaurShooter", "realisticDinoHunt", "vrBowAndArrow", "dinosaurKillerVR"], "long_description": "Step into a fully immersive VR world where survival meets prehistoric danger. In Dinosaur Prehistoric Hunter VR, you\u2019ll explore a beautifully crafted ancient jungle filled with nine deadly dinosaur species including the legendary T-Rex. Armed with powerful weapons like the MP5, shotgun, handgun, bow and arrow, and even a sword, you'll experience intense, heart-pounding action with every encounter.\n\nEvery dinosaur is designed with lifelike animations and intelligent behavior, making each hunt feel thrilling and unpredictable. Stunning realistic graphics, dynamic environments, and immersive 3D sound effects make you feel like you're really there. Whether you're sneaking through the underbrush or taking down a raptor mid-charge, every moment is packed with tension and realism.\n\nWith multiple game modes, including survival and free hunt, and intuitive VR controls built for Meta Quest, this game delivers a top-tier action adventure for fans of dinosaur games, hunting sims, and VR shooting experiences.\n\n", "short_description": "Step into a breathtaking prehistoric world where you become the hunter. In Dinosaur Prehistoric Hunter VR, you\u2019ll face off against nine unique dinosaur species, including the legendary T-Rex. Use a variety of weapons like the MP5, shotgun, handgun, bow and arrow, or even a sword to survive intense encounters. Designed with highly realistic graphics and immersive sound, this VR experience brings the thrill of dinosaur hunting to life like never before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abdurrehmanmma12327.github.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Ab Dur Rehman", "support_website_url": null, "website_url": "https://abdurrehmanmma12327.github.io/privacy-policy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], 
296901125233_94077424496935004_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AAY4cStds00Q7kNvwH9oVn2&_nc_oc=AdpCJ5TMoXszYm6xo0CQxgxh7u017YC5bEGSpNCm8p4TKzBNO37soD8imClg04EL3rM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_UkaI_9aOxq92mNMp_1HJebjUpya4rlidrcaZajNABQ&oe=6A8AC518"}, {"file_name": "3.2.png", "id": "8464038207054206", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491821115_8464038217054205_1891297688631955910_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fHwFAyKMxfkQ7kNvwE_B9IA&_nc_oc=AdrpwXkdZ9q5of2Jxmm-f0l4MyFFN5ZQ-m4UTMHjgMi6RB71EqFbaJcFehYcpVm-LC0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGl9SK7IxFWaqRco5E1mReV_4uK20lTe1L_Qi5gEqbDgg&oe=6A8AD83C"}, {"file_name": "4.1.png", "id": "1455808792517113", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491819323_1455808795850446_2619027289177886412_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qpL9FvNHAZYQ7kNvwGJ4iyY&_nc_oc=AdrfHSKeMrc8RG0Aa829tbZ3UyHbrRI2d-UoOv4lgzLYpR-wx_wy4yif1N9uweoSDqU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7_jSUzzMwDJXXmfzGmM6JwGXwGZDwMCMtCCXxwtTT8Q&oe=6A8AE0E4"}, {"file_name": "8.png", "id": "668248229368270", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823343_668248232701603_7422950020516075715_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KfxTAMUYdgUQ7kNvwF0gaiT&_nc_oc=AdpyNi0FmFh-ysB6RLgqoG6vXb54tQQDr02tOINSqsN3XW6KxsFjS1sb9U6-EE5suT8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGdJgVRz-5LZaosevbiSZE0R8sTq7tVMaNpnlavFlSV4w&oe=6A8AC59A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "6.png", "id": "1043468724516956", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491820512_1043468731183622_3507501700877445676_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7nzXeevQ_fsQ7kNvwFlscN-&_nc_oc=Adr5EufhX1VaF1WOLP5G2iYTghwD5NhcnY70FfroN5-tQuzXAoyYJxOVg0pnD7dFbTA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNkahAoVmjbYGyP8mcihado5q3171W5oD5aUkuLPZiMQ&oe=6A8AC602"}, "display_name": "Dinosaur Prehistoric Hunter VR", "keywords": ["dinosaurHuntingVR", "vrDinosaurShooter", "realisticDinoHunt", "vrBowAndArrow", "dinosaurKillerVR"], "long_description": "Step into a fully immersive VR world where survival meets prehistoric danger. In Dinosaur Prehistoric Hunter VR, you\u2019ll explore a beautifully crafted ancient jungle filled with nine deadly dinosaur species including the legendary T-Rex. Armed with powerful weapons like the MP5, shotgun, handgun, bow and arrow, and even a sword, you'll experience intense, heart-pounding action with every encounter.\n\nEvery dinosaur is designed with lifelike animations and intelligent behavior, making each hunt feel thrilling and unpredictable. Stunning realistic graphics, dynamic environments, and immersive 3D sound effects make you feel like you're really there. Whether you're sneaking through the underbrush or taking down a raptor mid-charge, every moment is packed with tension and realism.\n\nWith multiple game modes, including survival and free hunt, and intuitive VR controls built for Meta Quest, this game delivers a top-tier action adventure for fans of dinosaur games, hunting sims, and VR shooting experiences.\n\n", "short_description": "Step into a breathtaking prehistoric world where you become the hunter. In Dinosaur Prehistoric Hunter VR, you\u2019ll face off against nine unique dinosaur species, including the legendary T-Rex. Use a variety of weapons like the MP5, shotgun, handgun, bow and arrow, or even a sword to survive intense encounters. Designed with highly realistic graphics and immersive sound, this VR experience brings the thrill of dinosaur hunting to life like never before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abdurrehmanmma12327.github.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Ab Dur Rehman", "support_website_url": null, 
296901125233_94077424496935004_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZoK2-SNJdCcQ7kNvwHHJl-L&_nc_oc=Ado8UxuRFg2yf0kT6NVB-YF2yo57S32k-uyLgDTt1j-oN0BBZMZG6ABgwtkQPItSo3U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPI2zZpNnuRS0_aBqMIJeeKPU2Fz3ir4rFbhtjArX2CyQ&oe=6ACE39D8"}, {"file_name": "3.2.png", "id": "8464038207054206", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821115_8464038217054205_1891297688631955910_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AZyzlvNcoM8Q7kNvwGT9vew&_nc_oc=Adpc8y3s54JaFa0_XrZjLwC0k2cqBaR_ly1Qfk6xGlW_AkI0PbESQeO8rcyUm3Uuf_A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN0MVRP3-5yP_u1_8cr3h79W337TckcZiKtU7weC_xPbQ&oe=6ACE4CFC"}, {"file_name": "4.1.png", "id": "1455808792517113", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819323_1455808795850446_2619027289177886412_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X6i6ne7eJloQ7kNvwHsZ4-X&_nc_oc=AdpnUi4R_b9zdhdRh4WAUQfJFYneQ26RRfXuJJayAwIlMfRsZK_fv04fieqaTyRfPkA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOmCDQif3ja-2GWXq9QlarikJIRkjvtduCTCzsvtdljeQ&oe=6ACE55A4"}, {"file_name": "8.png", "id": "668248229368270", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823343_668248232701603_7422950020516075715_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8dA7KnC3y-IQ7kNvwH0PCVQ&_nc_oc=AdriqN7tqsC4DfG0mwdiyTpeW_pWie4o7uhIFCd1UVMrBaMXpNlTHPdz5CC4b70m9JE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN9TmxCUgvuJA8B1OD_Ry7mAmm8ZwQU4fit6asHOhqLAA&oe=6ACE3A5A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "6.png", "id": "1043468724516956", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820512_1043468731183622_3507501700877445676_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ivkaCsrW3kQ7kNvwGmS1Rf&_nc_oc=Ado8PC_HSpNVwahVYISRztmNzBPiyt0GMJrYId-63GNVAQmVkZN47cg2PEd-xetb5gE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPURNqBK6mHqToacrz6oq-dk0EndZKacqnjgymFzt8vCQ&oe=6ACE3AC2"}, "display_name": "Dinosaur Prehistoric Hunter VR", "keywords": ["dinosaurHuntingVR", "vrDinosaurShooter", "realisticDinoHunt", "vrBowAndArrow", "dinosaurKillerVR"], "long_description": "Step into a fully immersive VR world where survival meets prehistoric danger. In Dinosaur Prehistoric Hunter VR, you\u2019ll explore a beautifully crafted ancient jungle filled with nine deadly dinosaur species including the legendary T-Rex. Armed with powerful weapons like the MP5, shotgun, handgun, bow and arrow, and even a sword, you'll experience intense, heart-pounding action with every encounter.\n\nEvery dinosaur is designed with lifelike animations and intelligent behavior, making each hunt feel thrilling and unpredictable. Stunning realistic graphics, dynamic environments, and immersive 3D sound effects make you feel like you're really there. Whether you're sneaking through the underbrush or taking down a raptor mid-charge, every moment is packed with tension and realism.\n\nWith multiple game modes, including survival and free hunt, and intuitive VR controls built for Meta Quest, this game delivers a top-tier action adventure for fans of dinosaur games, hunting sims, and VR shooting experiences.\n\n", "short_description": "Step into a breathtaking prehistoric world where you become the hunter. In Dinosaur Prehistoric Hunter VR, you\u2019ll face off against nine unique dinosaur species, including the legendary T-Rex. Use a variety of weapons like the MP5, shotgun, handgun, bow and arrow, or even a sword to survive intense encounters. Designed with highly realistic graphics and immersive sound, this VR experience brings the thrill of dinosaur hunting to life like never before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abdurrehmanmma12327.github.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Ab Dur Rehman", "support_website_url": null, 
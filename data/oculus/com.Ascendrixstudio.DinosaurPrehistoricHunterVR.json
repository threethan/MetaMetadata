c_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NjXbO8Qq2AgQ7kNvwHngdDV&_nc_oc=Adrg13Lb3GpYiQFPrLswwdCdRtDuFQVNRo9Pad-j1xdbkFJA3St_7FkDclROvajLcaU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKHjEMNk-1zTq5taXDb459wLrPM_o5q4Ck1eVKf0eyLQ&oe=6B032E18"}, {"file_name": "3.2.png", "id": "8464038207054206", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821115_8464038217054205_1891297688631955910_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mRUTA1dlw5QQ7kNvwG4pElS&_nc_oc=AdrQskOLHB1cNool1WoHUGg8mr2T0n-Lp_voSQLmTALnihUjiDHobU0_5G0lf6MewTM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIG9B0NZJvDFLOaIHb4XSciz2JO4NCWDDk9DweOA181w&oe=6B0308FC"}, {"file_name": "4.1.png", "id": "1455808792517113", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819323_1455808795850446_2619027289177886412_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EMV5l-eC2Q0Q7kNvwERoOE1&_nc_oc=AdrOe6zK0uWVNVBmpqG2U0_WuTeJ_tLRz6-0-kbRRD0QA5Ilc8ZalTELL2riqbYFwkg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3QVVcP5toZEa18u0clykDtWF3br94ENnNTkM5eP5tDA&oe=6B0311A4"}, {"file_name": "8.png", "id": "668248229368270", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823343_668248232701603_7422950020516075715_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kB8XjTbGcYQQ7kNvwGeX72S&_nc_oc=Adpw5W8iQyi2xDJKBkWQ-5ksFPD-Npt_zoqHo4lN_HeYnNA5MVT3VT1vBNItUAopJZc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8Xy9U1ebteercgU0yXV4NCwaQy7VjBq_6xJxuEksxCA&oe=6B032E9A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 3.png", "id": "2294093891432643", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825575_2294093894765976_8767928679296993054_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sOVXuwh2MHcQ7kNvwGjdn9k&_nc_oc=AdoT1Uuzhem5OpdxKdMwGq8vg9yWhA2bUosi1kvIRUATcenpVaX8tz5-Bpd85wfPteo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuM7jkGqnnOXUozX2vZdEepVhqRhkt-7MvXl8aOIXbyA&oe=6B0317D3"}, "display_name": "Dinosaur Prehistoric Hunter VR", "keywords": [], "long_description": "Step into a dangerous prehistoric VR world where survival means hunting or being hunted. In Dinosaur Prehistoric Hunter VR, you explore a dense jungle packed with 9 deadly dinosaur species, including the legendary T-Rex and fast, aggressive raptors. Every creature has lifelike animations and smart AI that can chase, attack, and corner you.\n\nArm yourself with a powerful MP5, shotgun, handgun, bow & arrow, or sword and choose your combat style. Go loud in intense firefights, pick off enemies from a distance, or take the close-range path and slash through the danger with a sword. With survival tension, free-hunt exploration, and nonstop dinosaur action, every session feels different.\n\nBuilt for Meta Quest, the game features immersive 3D sound, detailed environments, intuitive VR controls, and optimized performance for a smooth headset experience.", "short_description": "Enter a thrilling prehistoric VR survival hunt where every encounter can turn deadly. Fight 9 dinosaur species, including T-Rex and raptors, using MP5, shotgun, handgun, bow & arrow, or sword. Explore a dense jungle, survive intense close-range combat, and enjoy realistic graphics, immersive 3D audio, and smooth Meta Quest controls."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abdurrehmanmma12327.github.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Ab Dur Rehman", "support_website_url": null, "website_url": "https://abdurrehmanmma12327.github.io/privacy-policy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "2710
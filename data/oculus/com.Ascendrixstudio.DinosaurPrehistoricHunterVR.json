cdn.com/v/t64.5771-25/491821115_8464038217054205_1891297688631955910_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FI-hmOoO3pEQ7kNvwHbtuH6&_nc_oc=AdpGPeh980SmzSNRQqPbyBz_pMn7dEqsKOh4PuCZ-YofPUBAAk_GB111uO3c35vLLGw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWrztA4_fngeWUnv3LJxpRveO16dvWBlgiOBY7wKBy9A&oe=6AA0287C"}, {"file_name": "4.1.png", "id": "1455808792517113", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491819323_1455808795850446_2619027289177886412_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i9GHI3ugOvwQ7kNvwHghgcd&_nc_oc=Adqhaz9yrncPzYIAXynpWOJhRgkNyBWT3AndErJ9kiY6iCejYjVRSthscSDOPalmoew&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLoOStHooXg6ZFo5NNdLuy0vF9lTYwQrQQOkfWOehaAtQ&oe=6A9FF8E4"}, {"file_name": "8.png", "id": "668248229368270", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823343_668248232701603_7422950020516075715_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pdqFr7Ckq6sQ7kNvwEVbauI&_nc_oc=AdqJAf5S3Mqmi6e2Wvg6hBV7Bicc5ZhImgjWn3PJYl0FG6TeFwT9GmwwuPitTpncjjk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIHIEe1aaTex9LIM6Lc0Jqq4Q6EZ3tILZ-CPUZIel-tqA&oe=6AA015DA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "6.png", "id": "1043468724516956", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491820512_1043468731183622_3507501700877445676_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N-LgunnoZ1sQ7kNvwH8gmfo&_nc_oc=AdqQ-CPmvhfSZ7ykP6uj9R3rXQPzUyy6pHXyvEnPlAQ-RSJI5vO2BnT7FmUORirMTN4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKI2mvbK0pyNWO4HnVhkHnDGVA3ZGZVYXv9anwlivOAiA&oe=6AA01642"}, "display_name": "Dinosaur Prehistoric Hunter VR", "keywords": ["dinosaurHuntingVR", "vrDinosaurShooter", "realisticDinoHunt", "vrBowAndArrow", "dinosaurKillerVR"], "long_description": "Step into a fully immersive VR world where survival meets prehistoric danger. In Dinosaur Prehistoric Hunter VR, you\u2019ll explore a beautifully crafted ancient jungle filled with nine deadly dinosaur species including the legendary T-Rex. Armed with powerful weapons like the MP5, shotgun, handgun, bow and arrow, and even a sword, you'll experience intense, heart-pounding action with every encounter.\n\nEvery dinosaur is designed with lifelike animations and intelligent behavior, making each hunt feel thrilling and unpredictable. Stunning realistic graphics, dynamic environments, and immersive 3D sound effects make you feel like you're really there. Whether you're sneaking through the underbrush or taking down a raptor mid-charge, every moment is packed with tension and realism.\n\nWith multiple game modes, including survival and free hunt, and intuitive VR controls built for Meta Quest, this game delivers a top-tier action adventure for fans of dinosaur games, hunting sims, and VR shooting experiences.\n\n", "short_description": "Step into a breathtaking prehistoric world where you become the hunter. In Dinosaur Prehistoric Hunter VR, you\u2019ll face off against nine unique dinosaur species, including the legendary T-Rex. Use a variety of weapons like the MP5, shotgun, handgun, bow and arrow, or even a sword to survive intense encounters. Designed with highly realistic graphics and immersive sound, this VR experience brings the thrill of dinosaur hunting to life like never before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abdurrehmanmma12327.github.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Ab Dur Rehman", "support_website_url": null, "website_url": "https://abdurrehmanmma12327.github.io/privacy-policy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "intern
c_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9vnwCnOHipUQ7kNvwHEuJLf&_nc_oc=AdreBupb97yutnQdhvnRGJFNZZD_Und-BYkHMq3nCq7PiUPoA0UW2bWHm5UGzyFQDJk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQThgxzAKPPn-NL6PbcRks0BcDfMTRf6mJ4npLQHhDDDdw&oe=6B0B1718"}, {"file_name": "3.2.png", "id": "8464038207054206", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491821115_8464038217054205_1891297688631955910_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8AJEyp2bwY4Q7kNvwFrmGlr&_nc_oc=AdqGvcMSbEPxWRE9xah3UXLI10KnIs_FKM6JrBo8TJImp4EGutOPcZszaPqtjS_vzQg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSX_iOzuyuykQ37Kjq6aNgBK00CWxCW_ieuxEAMneUiAA&oe=6B0B2A3C"}, {"file_name": "4.1.png", "id": "1455808792517113", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491819323_1455808795850446_2619027289177886412_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PlGqXEwEdu4Q7kNvwGPq9tE&_nc_oc=AdrGcebvoGv2zyRia7kzvN7xo5FYOe1Se0QaWsoiYpFyDMx4Zp5L7t11y-rd22LUhLI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQDwyj2K3OOodLi3J-8CEo8Vkpstr3031FwutvHvKAqsg&oe=6B0B32E4"}, {"file_name": "8.png", "id": "668248229368270", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823343_668248232701603_7422950020516075715_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fTpIxoQQnJ4Q7kNvwFUh9yg&_nc_oc=AdrCC9KDM3luEIm-cyZrVdwc4nN3rh9omj6YCDPaKpHuT_VNrD48i0SavtysenUA86E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRrVxCAsx2ALFFgixVVywj_ZdqhmUSaitXAxvFOMdmBPA&oe=6B0B179A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 3.png", "id": "2294093891432643", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491825575_2294093894765976_8767928679296993054_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oUrYszTcl5QQ7kNvwFB8JyP&_nc_oc=AdrA8mdjOMpIRD1l4J7OYS5xbUyH70hYJjfBYkGUbR5MdsylX8HcN90-N0knXQfcbQg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQGj5P17RPwO7wkSeIEAU0dfoDOH2cZHhSI58hGAq0Pvw&oe=6B0B3913"}, "display_name": "Dinosaur Prehistoric Hunter VR", "keywords": [], "long_description": "Step into a dangerous prehistoric VR world where survival means hunting or being hunted. In Dinosaur Prehistoric Hunter VR, you explore a dense jungle packed with 9 deadly dinosaur species, including the legendary T-Rex and fast, aggressive raptors. Every creature has lifelike animations and smart AI that can chase, attack, and corner you.\n\nArm yourself with a powerful MP5, shotgun, handgun, bow & arrow, or sword and choose your combat style. Go loud in intense firefights, pick off enemies from a distance, or take the close-range path and slash through the danger with a sword. With survival tension, free-hunt exploration, and nonstop dinosaur action, every session feels different.\n\nBuilt for Meta Quest, the game features immersive 3D sound, detailed environments, intuitive VR controls, and optimized performance for a smooth headset experience.", "short_description": "Enter a thrilling prehistoric VR survival hunt where every encounter can turn deadly. Fight 9 dinosaur species, including T-Rex and raptors, using MP5, shotgun, handgun, bow & arrow, or sword. Explore a dense jungle, survive intense close-range combat, and enjoy realistic graphics, immersive 3D audio, and smooth Meta Quest controls."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abdurrehmanmma12327.github.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Ab Dur Rehman", "support_website_url": null, "website_url": "https://abdurrehmanmma12327.github.io/privacy-policy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "2710
296901125233_94077424496935004_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AAY4cStds00Q7kNvwHClujp&_nc_oc=AdrlhNJLP3q5W6CUOrQRL4ZKNT-d6mQYp_1OAZyt78xzhKhudHnpARQZ5WwJMyJFn-4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4rZxU7MewsxZhg67lxCvL73-tFxl_bsu0BHiqYvdafA&oe=6A897398"}, {"file_name": "3.2.png", "id": "8464038207054206", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821115_8464038217054205_1891297688631955910_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fHwFAyKMxfkQ7kNvwGoUd03&_nc_oc=AdodXSE1JCq7Ne9R9L7bnSI6sclY99OWRzdfIvI-WBAjG1qqdtj-m-R6ks-eFuCdS0A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHv3lRJ2tkCk4u8S2tN5T6QtYqsEWIAQB18F_IqnUNuvw&oe=6A8986BC"}, {"file_name": "4.1.png", "id": "1455808792517113", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819323_1455808795850446_2619027289177886412_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GY47Cv-nkUQQ7kNvwFVGMB1&_nc_oc=Adq3sDrymkV4h0amb6EpQH1-c2-LPkRRoNw2c7LXArvE4zW9xwBoLvC7rtmoahfK2QU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHGpTDZ5emslQpGwXWk5zNMrkykmlgMX-hVGURKjz12SQ&oe=6A898F64"}, {"file_name": "8.png", "id": "668248229368270", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823343_668248232701603_7422950020516075715_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KfxTAMUYdgUQ7kNvwGDdoJK&_nc_oc=AdqqSoGWP8lK36tp7csY81bhWreGox5bZno2PSs1xkpYP7tZ7lQG7asGETPqUqFs3U4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhWGePXyfv2rj8FIPqmz_b6nyWx7K-2NEok-ldHwoFTg&oe=6A89741A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "6.png", "id": "1043468724516956", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820512_1043468731183622_3507501700877445676_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7nzXeevQ_fsQ7kNvwHqSy3b&_nc_oc=AdpCyYXSP01904hshGpq1ygGGYoTqRj6lZM-W8ObCLUy4FLE6TRzlXQmxRwU7QscvM0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdFbMcfdFsAOtEy4bNLqeuPz8dg13QZ9Lqp262bVb0hQ&oe=6A897482"}, "display_name": "Dinosaur Prehistoric Hunter VR", "keywords": ["dinosaurHuntingVR", "vrDinosaurShooter", "realisticDinoHunt", "vrBowAndArrow", "dinosaurKillerVR"], "long_description": "Step into a fully immersive VR world where survival meets prehistoric danger. In Dinosaur Prehistoric Hunter VR, you\u2019ll explore a beautifully crafted ancient jungle filled with nine deadly dinosaur species including the legendary T-Rex. Armed with powerful weapons like the MP5, shotgun, handgun, bow and arrow, and even a sword, you'll experience intense, heart-pounding action with every encounter.\n\nEvery dinosaur is designed with lifelike animations and intelligent behavior, making each hunt feel thrilling and unpredictable. Stunning realistic graphics, dynamic environments, and immersive 3D sound effects make you feel like you're really there. Whether you're sneaking through the underbrush or taking down a raptor mid-charge, every moment is packed with tension and realism.\n\nWith multiple game modes, including survival and free hunt, and intuitive VR controls built for Meta Quest, this game delivers a top-tier action adventure for fans of dinosaur games, hunting sims, and VR shooting experiences.\n\n", "short_description": "Step into a breathtaking prehistoric world where you become the hunter. In Dinosaur Prehistoric Hunter VR, you\u2019ll face off against nine unique dinosaur species, including the legendary T-Rex. Use a variety of weapons like the MP5, shotgun, handgun, bow and arrow, or even a sword to survive intense encounters. Designed with highly realistic graphics and immersive sound, this VR experience brings the thrill of dinosaur hunting to life like never before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abdurrehmanmma12327.github.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Ab Dur Rehman", "support_website_url": null, 
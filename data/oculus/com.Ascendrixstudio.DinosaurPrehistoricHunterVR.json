20f&oh=00_Af4yOvGq8fnbUiFCstDTQhb6QSeypLUq3UN2_zySBtDJ9g&oe=6A0C6D58"}, {"file_name": "3.2.png", "id": "8464038207054206", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491821115_8464038217054205_1891297688631955910_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HS1NROQWzN0Q7kNvwGYcFFJ&_nc_oc=AdrVRvc0ffQZKc-jOUMsCklc0mEFFsMZ6Dj2Uw-hcar4Jl-09XiK7kkyl2krhYU-twU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ZOU0W91iLsSQEBnS9XHb54uko4x8IO3tseaoJwGLFrA&oe=6A0C807C"}, {"file_name": "4.1.png", "id": "1455808792517113", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491819323_1455808795850446_2619027289177886412_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6T5g_ahld60Q7kNvwFW2A3J&_nc_oc=AdrQjycyPFr3s_n7z4Z9hIOce2QFqyp2KucJMgKtzmqM_kJkePJsGrIqoSaKZU_3RfU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4kbGpWSfpcXfFJ2agdfvAxvjUx8aK_DE3DGhlPGETV5w&oe=6A0C8924"}, {"file_name": "8.png", "id": "668248229368270", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823343_668248232701603_7422950020516075715_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N1egWeRIj4sQ7kNvwENGbhF&_nc_oc=AdrwnAZAYEO4J9ZTJVvlLdsv32deXV2HKPK0G7Ip08lE-Ur86b1O0Y974QqAnftp7cQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5nSK_Gig592eBaqCXOKptHoXsPRWSFx8qrp2FJCgBGZw&oe=6A0C6DDA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "2089009528581997", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491818885_2089009531915330_2772183187679478567_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h5FhVuGzOv8Q7kNvwGy81V6&_nc_oc=AdqRa82c9_I8OnH8FbsStBppCUPHospnP4UE_34htgvlYTBeXOQ-GqYAO8SU2DY2Qac&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ZWFQN_7CgfrlmQwv1oqtRm8MHymuVXYt0ViqwJkcrIw&oe=6A0C7C7F"}, "display_name": "Dinosaur Prehistoric Hunter VR", "keywords": ["dinosaurHuntingVR", "vrDinosaurShooter", "realisticDinoHunt", "survivalvr", "adventurevr"], "long_description": "Step into a dangerous prehistoric VR world where survival means hunting or being hunted. In Dinosaur Prehistoric Hunter VR, you explore a dense jungle packed with 9 deadly dinosaur species, including the legendary T-Rex and fast, aggressive raptors. Every creature has lifelike animations and smart AI that can chase, attack, and corner you.\n\nArm yourself with a powerful MP5, shotgun, handgun, bow & arrow, or sword and choose your combat style. Go loud in intense firefights, pick off enemies from a distance, or take the close-range path and slash through the danger with a sword. With survival tension, free-hunt exploration, and nonstop dinosaur action, every session feels different.\n\nBuilt for Meta Quest, the game features immersive 3D sound, detailed environments, intuitive VR controls, and optimized performance for a smooth headset experience.", "short_description": "Enter a thrilling prehistoric VR survival hunt where every encounter can turn deadly. Fight 9 dinosaur species, including T-Rex and raptors, using MP5, shotgun, handgun, bow & arrow, or sword. Explore a dense jungle, survive intense close-range combat, and enjoy realistic graphics, immersive 3D audio, and smooth Meta Quest controls."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abdurrehmanmma12327.github.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Ab Dur Rehman", "support_website_url": null, "website_url": "https://abdurrehmanmma12327.github.io/privacy-policy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2710427532541308"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graph
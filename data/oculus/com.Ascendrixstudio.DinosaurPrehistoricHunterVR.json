296901125233_94077424496935004_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IyqPdrOwDqYQ7kNvwHbUJju&_nc_oc=AdolwOGBmh_yGYmaTEhtmu04LiHrLfPhd2AbZpfPAQnGoxLhNfrEooq2nmN6Y2gqNU4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyxEXFioB4XContHUeyefNgeIaAThhpzFMEpproycbGg&oe=6A75E558"}, {"file_name": "3.2.png", "id": "8464038207054206", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821115_8464038217054205_1891297688631955910_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aXgOEr9Qz88Q7kNvwE-FWY9&_nc_oc=AdrqaMc1r-x26xVX34d_5Bo4CeQWnFzp4OGwkOn60oi0eUeIiDgJBnO51h7bNyS7LlE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGaz-GjHGKPofIL7YwSsdmtrq_Ixbno-H4u_7zzFITQXg&oe=6A75F87C"}, {"file_name": "4.1.png", "id": "1455808792517113", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819323_1455808795850446_2619027289177886412_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CdRBGZG1VDMQ7kNvwEfUFOU&_nc_oc=AdoH474-AE9oaGcDdr5qAjuCnN_sxdMOUpKQlk0TD-AxKMuOm-scnYvO486K13AGPJU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGuUICe4PmdtnDSr8N7F0UzZ6nN9Z6_ZgJQ--DUfHLC6w&oe=6A75C8E4"}, {"file_name": "8.png", "id": "668248229368270", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823343_668248232701603_7422950020516075715_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wSwnuWB3eSwQ7kNvwF3UxFz&_nc_oc=AdqJZ7ffrdwCYauvLWz9hofa6Cid9jqaOofmUJJit7dG6LTlLijb4rjt3SrmFMONClQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFngDtVIRKAMYPGQQX0BBMNoGTApr9t0tWCBNJoHxKQpA&oe=6A75E5DA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "6.png", "id": "1043468724516956", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820512_1043468731183622_3507501700877445676_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pEFMrYrcW_EQ7kNvwG4J3jt&_nc_oc=AdoYhtaUT325R_CkU-Ks7YP8MEjlUv91Jxoi0Xawci1gW_5A01Ymu0X5I9_h47sxanY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpfwQBnkKNwlAe5rtZPjEpI9eCEW0ts_WYPKBDWPZYvg&oe=6A75E642"}, "display_name": "Dinosaur Prehistoric Hunter VR", "keywords": ["dinosaurHuntingVR", "vrDinosaurShooter", "realisticDinoHunt", "vrBowAndArrow", "dinosaurKillerVR"], "long_description": "Step into a fully immersive VR world where survival meets prehistoric danger. In Dinosaur Prehistoric Hunter VR, you\u2019ll explore a beautifully crafted ancient jungle filled with nine deadly dinosaur species including the legendary T-Rex. Armed with powerful weapons like the MP5, shotgun, handgun, bow and arrow, and even a sword, you'll experience intense, heart-pounding action with every encounter.\n\nEvery dinosaur is designed with lifelike animations and intelligent behavior, making each hunt feel thrilling and unpredictable. Stunning realistic graphics, dynamic environments, and immersive 3D sound effects make you feel like you're really there. Whether you're sneaking through the underbrush or taking down a raptor mid-charge, every moment is packed with tension and realism.\n\nWith multiple game modes, including survival and free hunt, and intuitive VR controls built for Meta Quest, this game delivers a top-tier action adventure for fans of dinosaur games, hunting sims, and VR shooting experiences.\n\n", "short_description": "Step into a breathtaking prehistoric world where you become the hunter. In Dinosaur Prehistoric Hunter VR, you\u2019ll face off against nine unique dinosaur species, including the legendary T-Rex. Use a variety of weapons like the MP5, shotgun, handgun, bow and arrow, or even a sword to survive intense encounters. Designed with highly realistic graphics and immersive sound, this VR experience brings the thrill of dinosaur hunting to life like never before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abdurrehmanmma12327.github.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Ab Dur Rehman", "support_website_url": null, 
054206", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821115_8464038217054205_1891297688631955910_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RGdwsnRogswQ7kNvwEZzh8r&_nc_oc=Adnan1sc4AhhKfUswpEdMbZyYCf3bzcA482GphngQPFZ5aYWZ9uzUVxQ2Ufw0vU2Q2s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afyhup9WUp6PwIlpp5oi7rstcPCvjhuxhWf61bd6ZbMOqw&oe=69B696BC"}, {"file_name": "4.1.png", "id": "1455808792517113", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819323_1455808795850446_2619027289177886412_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fcRh6WpozR8Q7kNvwGfvint&_nc_oc=AdmF1Kb7zBU2-KJGEza_fYAJ2lZHV4Xqpl-d20L287vCB9OiPnxJFBElxaCo0tLxz7U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxLNQy6P6qdTTX0oYT05fCDilB2jKnC6686fGkVf32t9w&oe=69B69F64"}, {"file_name": "8.png", "id": "668248229368270", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823343_668248232701603_7422950020516075715_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wzzwjlhKzCAQ7kNvwEWtxjZ&_nc_oc=Adkee5-LzYa6CXBgMzV3Ah4GR9frvIgttfbqrS1nVnszkJPppJwMqYVklH0Ms76uPwE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwR621TNpPxwzBIhPhZ_4wYWOPpLKq9Na4uts1TZqbkkw&oe=69B6BC5A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "6.png", "id": "1043468724516956", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820512_1043468731183622_3507501700877445676_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CMip5ReNrJwQ7kNvwFL9-Kq&_nc_oc=AdkuefqpVWyMJGRoQBv7ETdDJFD90dU1Zd6dnaJW6IZdQgC9HQpd1mncSeLN-YffiV4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyNXgypx17Yp9s9613zooqY1FD6D1ET0UvU8FvlwmYBdg&oe=69B6BCC2"}, "display_name": "Dinosaur Prehistoric Hunter VR", "keywords": ["dinosaurHuntingVR", "vrDinosaurShooter", "realisticDinoHunt", "vrBowAndArrow", "dinosaurKillerVR"], "long_description": "Step into a fully immersive VR world where survival meets prehistoric danger. In Dinosaur Prehistoric Hunter VR, you\u2019ll explore a beautifully crafted ancient jungle filled with nine deadly dinosaur species including the legendary T-Rex. Armed with powerful weapons like the MP5, shotgun, handgun, bow and arrow, and even a sword, you'll experience intense, heart-pounding action with every encounter.\n\nEvery dinosaur is designed with lifelike animations and intelligent behavior, making each hunt feel thrilling and unpredictable. Stunning realistic graphics, dynamic environments, and immersive 3D sound effects make you feel like you're really there. Whether you're sneaking through the underbrush or taking down a raptor mid-charge, every moment is packed with tension and realism.\n\nWith multiple game modes, including survival and free hunt, and intuitive VR controls built for Meta Quest, this game delivers a top-tier action adventure for fans of dinosaur games, hunting sims, and VR shooting experiences.\n\n", "short_description": "Step into a breathtaking prehistoric world where you become the hunter. In Dinosaur Prehistoric Hunter VR, you\u2019ll face off against nine unique dinosaur species, including the legendary T-Rex. Use a variety of weapons like the MP5, shotgun, handgun, bow and arrow, or even a sword to survive intense encounters. Designed with highly realistic graphics and immersive sound, this VR experience brings the thrill of dinosaur hunting to life like never before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abdurrehmanmma12327.github.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Ab Dur Rehman", "support_website_url": null, "website_url": "https://abdurrehmanmma12327.github.io/privacy-policy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], 
054206", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821115_8464038217054205_1891297688631955910_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jH14qJPPMWYQ7kNvwHA8v4V&_nc_oc=AdkAhFUq_QZEnv2lOXGZZPv9BLyn8meIesORzAZz0B36ZDXhGVlADIRd-7ZYLMhkZmg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwMloM73SwIa0FlIKZoFFJJuKRZW2xM3KUBfmi52VA7UQ&oe=69BBDCBC"}, {"file_name": "4.1.png", "id": "1455808792517113", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819323_1455808795850446_2619027289177886412_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hp5qs88VOFUQ7kNvwFx455C&_nc_oc=Adk0uHo2eeXPqjbcvA_v1IGwQ5gLnBFfMsSq-hP5ZfCVxwQlnjW0n9-9B4q4BRdYm5E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxcUBYFwFfWXJE7NDZerH4C6G94r_OEl04LXmvfjDVXlQ&oe=69BBE564"}, {"file_name": "8.png", "id": "668248229368270", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823343_668248232701603_7422950020516075715_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iv1n8izgi54Q7kNvwGlvZ4e&_nc_oc=Adkpz7nTrd5r_xL4NLHMi15sB0xCPuOY9-cdOQBB8Fs1rhN1xW-5nK4iehnd52rXL3Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxFk19HfFpfpX4dDqdSc2b_8szkQ42qfG5Gy8rkitk8Lw&oe=69BC025A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "6.png", "id": "1043468724516956", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820512_1043468731183622_3507501700877445676_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OUTfxft2FfIQ7kNvwGyAyXV&_nc_oc=AdlooagPUkrnn_Frl4ezbtV27-WPz6Doga-q4casCcKKQtv1l5qbdyDDNLHcHIQW2OQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afxn0RWYI_xCyj308gc-jWmFnExulAJWpw18FHamiwDHhg&oe=69BC02C2"}, "display_name": "Dinosaur Prehistoric Hunter VR", "keywords": ["dinosaurHuntingVR", "vrDinosaurShooter", "realisticDinoHunt", "vrBowAndArrow", "dinosaurKillerVR"], "long_description": "Step into a fully immersive VR world where survival meets prehistoric danger. In Dinosaur Prehistoric Hunter VR, you\u2019ll explore a beautifully crafted ancient jungle filled with nine deadly dinosaur species including the legendary T-Rex. Armed with powerful weapons like the MP5, shotgun, handgun, bow and arrow, and even a sword, you'll experience intense, heart-pounding action with every encounter.\n\nEvery dinosaur is designed with lifelike animations and intelligent behavior, making each hunt feel thrilling and unpredictable. Stunning realistic graphics, dynamic environments, and immersive 3D sound effects make you feel like you're really there. Whether you're sneaking through the underbrush or taking down a raptor mid-charge, every moment is packed with tension and realism.\n\nWith multiple game modes, including survival and free hunt, and intuitive VR controls built for Meta Quest, this game delivers a top-tier action adventure for fans of dinosaur games, hunting sims, and VR shooting experiences.\n\n", "short_description": "Step into a breathtaking prehistoric world where you become the hunter. In Dinosaur Prehistoric Hunter VR, you\u2019ll face off against nine unique dinosaur species, including the legendary T-Rex. Use a variety of weapons like the MP5, shotgun, handgun, bow and arrow, or even a sword to survive intense encounters. Designed with highly realistic graphics and immersive sound, this VR experience brings the thrill of dinosaur hunting to life like never before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abdurrehmanmma12327.github.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Ab Dur Rehman", "support_website_url": null, "website_url": "https://abdurrehmanmma12327.github.io/privacy-policy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], 
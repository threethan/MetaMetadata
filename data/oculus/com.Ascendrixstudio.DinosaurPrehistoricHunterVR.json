296901125233_94077424496935004_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GCGgGdS9_4IQ7kNvwGF2lB1&_nc_oc=AdrFGQbIRJXKeLuB664DeUekQxh7-KIVYvy8ApIFZNfSKs2W6GF1NnM5W3gTPufarwo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIdbKaqXleka4O8YlYytHzDKiJt8PI7D-wGQtn_GCsrMQ&oe=6A986498"}, {"file_name": "3.2.png", "id": "8464038207054206", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821115_8464038217054205_1891297688631955910_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EM69ZX3WQHMQ7kNvwHTS0R_&_nc_oc=Adoec0vXXoN4Uym9TZVvPOE1gbP9gCeiV0TMvlB1O6Aeq1XMGqGHamG4XC2NrugLqpw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqRHrKUUyLXvS_lfhXIgNVMQVtChdrVBt_wKK5f4fxYw&oe=6A983F7C"}, {"file_name": "4.1.png", "id": "1455808792517113", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819323_1455808795850446_2619027289177886412_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LjXocxsZwlwQ7kNvwFO7Io8&_nc_oc=Adp2YAAFoZV4kYglkyBjjgoq072BsQ9LxT8hpvoNySfxBO1RguFHhOdn3V3OneFlrkY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKl3PKi3NBblWh1ZeIe53pre2RH5ONQ--3oz9cno18HaQ&oe=6A984824"}, {"file_name": "8.png", "id": "668248229368270", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823343_668248232701603_7422950020516075715_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sqRhRsrLPG4Q7kNvwGvp9wa&_nc_oc=Ado3bFBpcxrlVTd6lv1kScovA_zvJg0xDw30hst_Ca4JYiBe1Aq0UfaJQodChMjQ-QY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIL_NGcmFd1ZapNrDH4gVMGrgxkg_c0ATbVs43OGpP46g&oe=6A98651A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "6.png", "id": "1043468724516956", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820512_1043468731183622_3507501700877445676_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VxHWjD08b9wQ7kNvwEiFiYa&_nc_oc=AdouQdg3pvLJ1nsjX4FBEAyTpC6ge1RpNo-4KG9bMG_zbWjypMnyo9wg_qWanPPB3Ro&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYFDJOoaToRU6nMbeNkXsE4ZOhZeyKsuEOlXz7Vq4iOw&oe=6A986582"}, "display_name": "Dinosaur Prehistoric Hunter VR", "keywords": ["dinosaurHuntingVR", "vrDinosaurShooter", "realisticDinoHunt", "vrBowAndArrow", "dinosaurKillerVR"], "long_description": "Step into a fully immersive VR world where survival meets prehistoric danger. In Dinosaur Prehistoric Hunter VR, you\u2019ll explore a beautifully crafted ancient jungle filled with nine deadly dinosaur species including the legendary T-Rex. Armed with powerful weapons like the MP5, shotgun, handgun, bow and arrow, and even a sword, you'll experience intense, heart-pounding action with every encounter.\n\nEvery dinosaur is designed with lifelike animations and intelligent behavior, making each hunt feel thrilling and unpredictable. Stunning realistic graphics, dynamic environments, and immersive 3D sound effects make you feel like you're really there. Whether you're sneaking through the underbrush or taking down a raptor mid-charge, every moment is packed with tension and realism.\n\nWith multiple game modes, including survival and free hunt, and intuitive VR controls built for Meta Quest, this game delivers a top-tier action adventure for fans of dinosaur games, hunting sims, and VR shooting experiences.\n\n", "short_description": "Step into a breathtaking prehistoric world where you become the hunter. In Dinosaur Prehistoric Hunter VR, you\u2019ll face off against nine unique dinosaur species, including the legendary T-Rex. Use a variety of weapons like the MP5, shotgun, handgun, bow and arrow, or even a sword to survive intense encounters. Designed with highly realistic graphics and immersive sound, this VR experience brings the thrill of dinosaur hunting to life like never before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abdurrehmanmma12327.github.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Ab Dur Rehman", "support_website_url": null, 
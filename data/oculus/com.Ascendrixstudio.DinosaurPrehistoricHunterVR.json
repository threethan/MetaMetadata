296901125233_94077424496935004_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O37Il03XbiQQ7kNvwHcTUx1&_nc_oc=AdpndcN7rTlzJ5PAvTZ80lbdL1Oo8tuE2DkjQaubAFtTwfMbPoqKusTvgDLk-12nsIc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDIYIuJL0jcAaKlHNWsOCatTV7aQrq3Y6vLBURTJWfptA&oe=6A621ED8"}, {"file_name": "3.2.png", "id": "8464038207054206", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821115_8464038217054205_1891297688631955910_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y9FY5EwbDCQQ7kNvwEC_cDq&_nc_oc=AdpC_U-d6QRubPKgy8S1L1lzRJAF7ETlRlroBRUKRrkTGNHPtS7wTGWjR4el1-NKHmo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQByTNBezNd8AdrY7dEuT0S5gOKLdp5CYbKzBSP5jem9UQ&oe=6A6231FC"}, {"file_name": "4.1.png", "id": "1455808792517113", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819323_1455808795850446_2619027289177886412_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HkK1jKJoiGUQ7kNvwH6O5XL&_nc_oc=Adp4d_rBmEhnYmwqqOMgq_vPosZI3u3McRYhT9kJ45Fhy3BCnfE7bKwDctwzrb39IBg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB1A34PgMbym0W2xp90zuK4eq47sDQ1a-mKmHDnea5E2Q&oe=6A620264"}, {"file_name": "8.png", "id": "668248229368270", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823343_668248232701603_7422950020516075715_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sDX4r1_Fhz8Q7kNvwFw_fL9&_nc_oc=Adq_qKcjjLHOfqVQ6H_meKF-J5-sx64qdLyLBo8kg_zS4oVRUmpwz077MOqycENdbOs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB4CFZW_1jIGqaKUoDh-TwRylj5czte-8twtrGmdhKtYA&oe=6A621F5A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "6.png", "id": "1043468724516956", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820512_1043468731183622_3507501700877445676_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XxBY_upk-IcQ7kNvwFuxPFD&_nc_oc=AdoZokkiLLJs7oeKIXzYdmLqdgGIcT0grff5pITKS00lXGlg9jbyPXj49nL39BJpxTY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXlXeIZwtj49DkQswUzxLJgHIn71lg7rCOShKJBOtkyw&oe=6A621FC2"}, "display_name": "Dinosaur Prehistoric Hunter VR", "keywords": ["dinosaurHuntingVR", "vrDinosaurShooter", "realisticDinoHunt", "vrBowAndArrow", "dinosaurKillerVR"], "long_description": "Step into a fully immersive VR world where survival meets prehistoric danger. In Dinosaur Prehistoric Hunter VR, you\u2019ll explore a beautifully crafted ancient jungle filled with nine deadly dinosaur species including the legendary T-Rex. Armed with powerful weapons like the MP5, shotgun, handgun, bow and arrow, and even a sword, you'll experience intense, heart-pounding action with every encounter.\n\nEvery dinosaur is designed with lifelike animations and intelligent behavior, making each hunt feel thrilling and unpredictable. Stunning realistic graphics, dynamic environments, and immersive 3D sound effects make you feel like you're really there. Whether you're sneaking through the underbrush or taking down a raptor mid-charge, every moment is packed with tension and realism.\n\nWith multiple game modes, including survival and free hunt, and intuitive VR controls built for Meta Quest, this game delivers a top-tier action adventure for fans of dinosaur games, hunting sims, and VR shooting experiences.\n\n", "short_description": "Step into a breathtaking prehistoric world where you become the hunter. In Dinosaur Prehistoric Hunter VR, you\u2019ll face off against nine unique dinosaur species, including the legendary T-Rex. Use a variety of weapons like the MP5, shotgun, handgun, bow and arrow, or even a sword to survive intense encounters. Designed with highly realistic graphics and immersive sound, this VR experience brings the thrill of dinosaur hunting to life like never before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abdurrehmanmma12327.github.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Ab Dur Rehman", "support_website_url": null, 
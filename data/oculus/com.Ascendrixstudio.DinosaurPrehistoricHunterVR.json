file_name": "3.2.png", "id": "8464038207054206", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491821115_8464038217054205_1891297688631955910_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2MWtsnBrgiQQ7kNvwEHOZG2&_nc_oc=AdoZqn_-_lnefyXdIpwtLN7HB6x5CWFrAgGAXQ8eWk60xY7D4RCV3Pl7KQy1nqzHv_8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwRyly4ov9mfykZXbNlmDI9edzv9_EGMQSPsaejF0Uj5Q&oe=69C5173C"}, {"file_name": "4.1.png", "id": "1455808792517113", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491819323_1455808795850446_2619027289177886412_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BQ3-moSonewQ7kNvwEeedYX&_nc_oc=AdoFdE4B7fC1d3GY6wW7tkbxIxrzwLXYPrkaD2lKGImVBv4sdZv3fvx6Ex_rnAGf-qA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyQQD-Fgzxi7JiNIB9iksmBCCXaUBlU-K6uJV_EGqaEZQ&oe=69C51FE4"}, {"file_name": "8.png", "id": "668248229368270", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823343_668248232701603_7422950020516075715_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7nFnN4Zul-cQ7kNvwFOAp2J&_nc_oc=Adqg5bGNI08C16_oE9gD50XWsKMLSX3T-0B_TZxGUBZvaDlinq0ELKykLAKPxVG4q-M&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwGObFFcKgsga6-pPaZVuLEEkFPS8hvHohbA009W9sRqw&oe=69C53CDA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "6.png", "id": "1043468724516956", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491820512_1043468731183622_3507501700877445676_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NK-5GUlHev4Q7kNvwG-EhdC&_nc_oc=AdpYA96Jwv_OebEkRVu8SmZ3gNX4MUE9IzVvTYYucNIkMaTHgyOhWWYe22rQHrbaSeQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwnQWT7LCM9MBc878vYESj232zMVxx8qpmSY74cRbYSOA&oe=69C53D42"}, "display_name": "Dinosaur Prehistoric Hunter VR", "keywords": ["dinosaurHuntingVR", "vrDinosaurShooter", "realisticDinoHunt", "vrBowAndArrow", "dinosaurKillerVR"], "long_description": "Step into a fully immersive VR world where survival meets prehistoric danger. In Dinosaur Prehistoric Hunter VR, you\u2019ll explore a beautifully crafted ancient jungle filled with nine deadly dinosaur species including the legendary T-Rex. Armed with powerful weapons like the MP5, shotgun, handgun, bow and arrow, and even a sword, you'll experience intense, heart-pounding action with every encounter.\n\nEvery dinosaur is designed with lifelike animations and intelligent behavior, making each hunt feel thrilling and unpredictable. Stunning realistic graphics, dynamic environments, and immersive 3D sound effects make you feel like you're really there. Whether you're sneaking through the underbrush or taking down a raptor mid-charge, every moment is packed with tension and realism.\n\nWith multiple game modes, including survival and free hunt, and intuitive VR controls built for Meta Quest, this game delivers a top-tier action adventure for fans of dinosaur games, hunting sims, and VR shooting experiences.\n\n", "short_description": "Step into a breathtaking prehistoric world where you become the hunter. In Dinosaur Prehistoric Hunter VR, you\u2019ll face off against nine unique dinosaur species, including the legendary T-Rex. Use a variety of weapons like the MP5, shotgun, handgun, bow and arrow, or even a sword to survive intense encounters. Designed with highly realistic graphics and immersive sound, this VR experience brings the thrill of dinosaur hunting to life like never before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abdurrehmanmma12327.github.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Ab Dur Rehman", "support_website_url": null, "website_url": "https://abdurrehmanmma12327.github.io/privacy-policy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "ext
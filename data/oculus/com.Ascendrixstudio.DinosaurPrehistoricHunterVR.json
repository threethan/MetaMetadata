296901125233_94077424496935004_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vJ7Q9ilOJ8QQ7kNvwHzM3Zk&_nc_oc=Adr_4JhB52FBrzOKEu_qbDyYzgdEPGlOe5zoXB0YgsEsylbXLV17jieV_jqb8lYFYx0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFk6hI-QPmiNhsGZL2Prdj85mq0rSoVf2j12WdKbVkiKw&oe=6A882218"}, {"file_name": "3.2.png", "id": "8464038207054206", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491821115_8464038217054205_1891297688631955910_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fHwFAyKMxfkQ7kNvwHwK10s&_nc_oc=Adokkk1yiaLNw7A-PczVfW7sIa7VEraphK8xr46T6VURNrzihXtWP3p4SLF079rZlcQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4PZ2m4qro_6-7LCYhLaip18uWmGpAfsNCa8Wt0fIvNQ&oe=6A88353C"}, {"file_name": "4.1.png", "id": "1455808792517113", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491819323_1455808795850446_2619027289177886412_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GY47Cv-nkUQQ7kNvwFYBTY1&_nc_oc=AdqVXeX2xWmlpwWgTLdOQvN9k4HaPOL3q2Ey3oDLEe3nl6hSLsCA9r4bARhkjkeIwHw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHO2pBKHgl-2LgE28KagYUhLmMTf3PWSYLtJ0LRWifhdA&oe=6A883DE4"}, {"file_name": "8.png", "id": "668248229368270", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491823343_668248232701603_7422950020516075715_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l7SIgovDtrIQ7kNvwEMkVP6&_nc_oc=AdpdWIidK9NkMm9TgcmmTSoIuW028SFLBXUM-GFUbwqSTllNIYercJ9DJ41BbwElehg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFl73qpGiLmgeelqs1MjCTzlWyuJa4jfWKr4XwEyfOouw&oe=6A88229A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "6.png", "id": "1043468724516956", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491820512_1043468731183622_3507501700877445676_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qlLSWJZteeYQ7kNvwHqHDKc&_nc_oc=Adrarkf4DKk6fAlHauRIWqH2G6OK3C67BWYbNOWImxL2pFHX7sgYuFdN_w-cCyBOPkQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH1qSon9oZIlomstNDEm925XBF9GrchWDco3hRW1LRSQQ&oe=6A882302"}, "display_name": "Dinosaur Prehistoric Hunter VR", "keywords": ["dinosaurHuntingVR", "vrDinosaurShooter", "realisticDinoHunt", "vrBowAndArrow", "dinosaurKillerVR"], "long_description": "Step into a fully immersive VR world where survival meets prehistoric danger. In Dinosaur Prehistoric Hunter VR, you\u2019ll explore a beautifully crafted ancient jungle filled with nine deadly dinosaur species including the legendary T-Rex. Armed with powerful weapons like the MP5, shotgun, handgun, bow and arrow, and even a sword, you'll experience intense, heart-pounding action with every encounter.\n\nEvery dinosaur is designed with lifelike animations and intelligent behavior, making each hunt feel thrilling and unpredictable. Stunning realistic graphics, dynamic environments, and immersive 3D sound effects make you feel like you're really there. Whether you're sneaking through the underbrush or taking down a raptor mid-charge, every moment is packed with tension and realism.\n\nWith multiple game modes, including survival and free hunt, and intuitive VR controls built for Meta Quest, this game delivers a top-tier action adventure for fans of dinosaur games, hunting sims, and VR shooting experiences.\n\n", "short_description": "Step into a breathtaking prehistoric world where you become the hunter. In Dinosaur Prehistoric Hunter VR, you\u2019ll face off against nine unique dinosaur species, including the legendary T-Rex. Use a variety of weapons like the MP5, shotgun, handgun, bow and arrow, or even a sword to survive intense encounters. Designed with highly realistic graphics and immersive sound, this VR experience brings the thrill of dinosaur hunting to life like never before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abdurrehmanmma12327.github.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Ab Dur Rehman", "support_website_url": null, 
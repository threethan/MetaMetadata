296901125233_94077424496935004_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gb2pXw6T97gQ7kNvwFEXWGz&_nc_oc=Adp_IpAK9v-hysUoKxTDwJMoo3D_LhYHVdiWxx7ETVOrUMxH8hdY9LnekMb-pB8HnMA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP4ZUK-gpouJLjGn-D4QOvpTztk8CimL8Z-fA52iL1DVQ&oe=6ADF5D58"}, {"file_name": "3.2.png", "id": "8464038207054206", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821115_8464038217054205_1891297688631955910_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tul9G7eFjKMQ7kNvwEz9PjT&_nc_oc=AdoRz5WyKrLxPXQcv6W_zMytZuDETLauQS7kFFDgUEOmAYBxH5_u74vLdy1WjUEbex8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMF2RtU625XUWmtNvtIpGI71zwJ1GcHa8aYxTXtGJdzhw&oe=6ADF707C"}, {"file_name": "4.1.png", "id": "1455808792517113", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819323_1455808795850446_2619027289177886412_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_cI418HdkRsQ7kNvwH4UiLa&_nc_oc=AdpLB3PYEBW6rib8veE6d0QCTTEHomyVvgyx3VX0T3fADUdOKy8ONoGFtMaVpF5PpcE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP8vrZUV2DT8iXJO5MkfT77Q9N1O3rfmBH9KUlIVA8ITQ&oe=6ADF7924"}, {"file_name": "8.png", "id": "668248229368270", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823343_668248232701603_7422950020516075715_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bPh03EDP8WMQ7kNvwE0bD--&_nc_oc=AdrwqbepqrNwjFo1QyDtUgGA89S_e3R5TbmonYjHLQ5fjHzTaw54v9rdJg1pXEZ77Ws&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMe7st6Rx5jMc9UczNHGyx_N1CZaz1g2vZHctAvplvokA&oe=6ADF5DDA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "6.png", "id": "1043468724516956", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820512_1043468731183622_3507501700877445676_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sLbupiH0yVEQ7kNvwEJ599x&_nc_oc=AdqcNP0AR-EeuWvbKLdcRWHxjvhFYzAvz8XuuBzFMtU7P8R78g5b4ObtILDPN1lUgg0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7848qH6y3N6Rpw7MyQgplSzsI6_u1mN7pOL92o18ywQ&oe=6ADF5E42"}, "display_name": "Dinosaur Prehistoric Hunter VR", "keywords": ["dinosaurHuntingVR", "vrDinosaurShooter", "realisticDinoHunt", "vrBowAndArrow", "dinosaurKillerVR"], "long_description": "Step into a fully immersive VR world where survival meets prehistoric danger. In Dinosaur Prehistoric Hunter VR, you\u2019ll explore a beautifully crafted ancient jungle filled with nine deadly dinosaur species including the legendary T-Rex. Armed with powerful weapons like the MP5, shotgun, handgun, bow and arrow, and even a sword, you'll experience intense, heart-pounding action with every encounter.\n\nEvery dinosaur is designed with lifelike animations and intelligent behavior, making each hunt feel thrilling and unpredictable. Stunning realistic graphics, dynamic environments, and immersive 3D sound effects make you feel like you're really there. Whether you're sneaking through the underbrush or taking down a raptor mid-charge, every moment is packed with tension and realism.\n\nWith multiple game modes, including survival and free hunt, and intuitive VR controls built for Meta Quest, this game delivers a top-tier action adventure for fans of dinosaur games, hunting sims, and VR shooting experiences.\n\n", "short_description": "Step into a breathtaking prehistoric world where you become the hunter. In Dinosaur Prehistoric Hunter VR, you\u2019ll face off against nine unique dinosaur species, including the legendary T-Rex. Use a variety of weapons like the MP5, shotgun, handgun, bow and arrow, or even a sword to survive intense encounters. Designed with highly realistic graphics and immersive sound, this VR experience brings the thrill of dinosaur hunting to life like never before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abdurrehmanmma12327.github.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Ab Dur Rehman", "support_website_url": null, 
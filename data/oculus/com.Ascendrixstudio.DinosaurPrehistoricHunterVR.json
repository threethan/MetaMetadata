296901125233_94077424496935004_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NxmLfijV0l4Q7kNvwEuLN4s&_nc_oc=Adov_4r7gOStlzzuPzIv5mJSfTsFSaj_wB0qXNDYxRG1g1UFK7-mZMsGZXiD0x9KFz4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAOQZHtPkU6gr6zbw3huU9GasDhQ69Lh1ghlAUkAeH1BA&oe=6A60CD58"}, {"file_name": "3.2.png", "id": "8464038207054206", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821115_8464038217054205_1891297688631955910_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y9FY5EwbDCQQ7kNvwF8WGM_&_nc_oc=AdrBCHHFs0qwcbXF2Nr9lp6CTMm4XyC2g95h5PCt_-naU640E2QkRMT0GFq_lTv5cUo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCazboLN276V1dZQztFnQenJSuPET-gJVKYd3BSfJP-Ug&oe=6A60A83C"}, {"file_name": "4.1.png", "id": "1455808792517113", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819323_1455808795850446_2619027289177886412_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kIAju2FY27EQ7kNvwGmXBnU&_nc_oc=AdoQOTA7uOx6DS7vnMOu-pJzg9aMr6SfkK3DLujcJZNQPe2pcdkyXk__hJ5ZkoJVBTg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDgy0XrW9vIwSGnxeMaz0fU3MtMZca6364WnKKi8tS2Ng&oe=6A60B0E4"}, {"file_name": "8.png", "id": "668248229368270", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823343_668248232701603_7422950020516075715_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sDX4r1_Fhz8Q7kNvwEXvTdC&_nc_oc=Adqdsjku1tT9OK0stjeQnS2ZuHLuTpETOMhP8uY9Ifc_UGi5W0WFR_xSwEYudofjr8E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQChUR31TtnN94QUG8RuIempG-EYDb1fvZqt49J9oXkQRg&oe=6A60CDDA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "6.png", "id": "1043468724516956", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820512_1043468731183622_3507501700877445676_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HHrF8TOJsi4Q7kNvwHzGwAk&_nc_oc=Adr7lEnx_RGNddNpY_8BwXxXX00sWMVgn8U7C2QtUUcCRNBZXp7UxW7TWSHi3SmwpxE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-GkHWNw4pT12UuM4lPaAGF_Dmq0x04pl-HrwnnoGX6Q&oe=6A60CE42"}, "display_name": "Dinosaur Prehistoric Hunter VR", "keywords": ["dinosaurHuntingVR", "vrDinosaurShooter", "realisticDinoHunt", "vrBowAndArrow", "dinosaurKillerVR"], "long_description": "Step into a fully immersive VR world where survival meets prehistoric danger. In Dinosaur Prehistoric Hunter VR, you\u2019ll explore a beautifully crafted ancient jungle filled with nine deadly dinosaur species including the legendary T-Rex. Armed with powerful weapons like the MP5, shotgun, handgun, bow and arrow, and even a sword, you'll experience intense, heart-pounding action with every encounter.\n\nEvery dinosaur is designed with lifelike animations and intelligent behavior, making each hunt feel thrilling and unpredictable. Stunning realistic graphics, dynamic environments, and immersive 3D sound effects make you feel like you're really there. Whether you're sneaking through the underbrush or taking down a raptor mid-charge, every moment is packed with tension and realism.\n\nWith multiple game modes, including survival and free hunt, and intuitive VR controls built for Meta Quest, this game delivers a top-tier action adventure for fans of dinosaur games, hunting sims, and VR shooting experiences.\n\n", "short_description": "Step into a breathtaking prehistoric world where you become the hunter. In Dinosaur Prehistoric Hunter VR, you\u2019ll face off against nine unique dinosaur species, including the legendary T-Rex. Use a variety of weapons like the MP5, shotgun, handgun, bow and arrow, or even a sword to survive intense encounters. Designed with highly realistic graphics and immersive sound, this VR experience brings the thrill of dinosaur hunting to life like never before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abdurrehmanmma12327.github.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Ab Dur Rehman", "support_website_url": null, 
296901125233_94077424496935004_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AAY4cStds00Q7kNvwFWqlSa&_nc_oc=AdqnWTqPCkxQ8rKkFBXjKwwT7q44y-UWRKkRAkU4a5tv215uH3CJFme9ZeBVEn-5cBg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHN13QyxpiNgSzfDXmYGfl43PRLF44HgFWy93OU8y6sTw&oe=6A8C1698"}, {"file_name": "3.2.png", "id": "8464038207054206", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821115_8464038217054205_1891297688631955910_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cxcdRRM7XuQQ7kNvwHuSMHM&_nc_oc=AdqicQuAmQXL4ZKsU7k0SuNmQVdI2PEd6_x27o8y-wxUqT4_40t5kAcdnKP6IZg7Uxc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEgyDJmXQ4DrMOzMW4NwDSXmHbL63DCNCSw1d4-loheFg&oe=6A8C29BC"}, {"file_name": "4.1.png", "id": "1455808792517113", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819323_1455808795850446_2619027289177886412_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qpL9FvNHAZYQ7kNvwHh53dt&_nc_oc=Adoail8lDMgttwDjRPHAbFib0dc7NmXayt2v_O5PChd000tgGjld5Xt2neeQAxOhJA4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH56tBGc49wNYbiohUzPLZsFwUqmkKdq-59EvAYDJBtDw&oe=6A8C3264"}, {"file_name": "8.png", "id": "668248229368270", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823343_668248232701603_7422950020516075715_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KfxTAMUYdgUQ7kNvwF_BSjU&_nc_oc=AdppUjaMqG576v07AElLj2Wtkxq5GC-eCsJp24FpKnqV34yfmZ7gGorDQJ--174ywz0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGoxexnhDKYAldnvG1uWpPDDoqg0N953LzFOUb8_WKi1w&oe=6A8C171A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "6.png", "id": "1043468724516956", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820512_1043468731183622_3507501700877445676_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7nzXeevQ_fsQ7kNvwFh5Ooe&_nc_oc=AdqzK0apVCYVvzcsXvDrYlCpqLrunH5oxRGwNzYiOUFGvMYt3s3bu4lHBowaYSfQjyY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFX8eDVhv9ffZSX9M5NyaPYyP5sQ0yaPUXE0-aV6iJJeQ&oe=6A8C1782"}, "display_name": "Dinosaur Prehistoric Hunter VR", "keywords": ["dinosaurHuntingVR", "vrDinosaurShooter", "realisticDinoHunt", "vrBowAndArrow", "dinosaurKillerVR"], "long_description": "Step into a fully immersive VR world where survival meets prehistoric danger. In Dinosaur Prehistoric Hunter VR, you\u2019ll explore a beautifully crafted ancient jungle filled with nine deadly dinosaur species including the legendary T-Rex. Armed with powerful weapons like the MP5, shotgun, handgun, bow and arrow, and even a sword, you'll experience intense, heart-pounding action with every encounter.\n\nEvery dinosaur is designed with lifelike animations and intelligent behavior, making each hunt feel thrilling and unpredictable. Stunning realistic graphics, dynamic environments, and immersive 3D sound effects make you feel like you're really there. Whether you're sneaking through the underbrush or taking down a raptor mid-charge, every moment is packed with tension and realism.\n\nWith multiple game modes, including survival and free hunt, and intuitive VR controls built for Meta Quest, this game delivers a top-tier action adventure for fans of dinosaur games, hunting sims, and VR shooting experiences.\n\n", "short_description": "Step into a breathtaking prehistoric world where you become the hunter. In Dinosaur Prehistoric Hunter VR, you\u2019ll face off against nine unique dinosaur species, including the legendary T-Rex. Use a variety of weapons like the MP5, shotgun, handgun, bow and arrow, or even a sword to survive intense encounters. Designed with highly realistic graphics and immersive sound, this VR experience brings the thrill of dinosaur hunting to life like never before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abdurrehmanmma12327.github.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Ab Dur Rehman", "support_website_url": null, 
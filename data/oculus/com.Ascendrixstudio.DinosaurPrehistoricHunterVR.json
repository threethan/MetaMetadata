SqFEMT8j4fgayiEyvbNMoW-mBPC8QkoRX58mpjzniqfQeqYBzGnKE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBdnmqV0z5r98Ze9pykvz-GJDkK07F8RTlW2BqEEFPi2w&oe=6A4A63D8"}, {"file_name": "3.2.png", "id": "8464038207054206", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821115_8464038217054205_1891297688631955910_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TDLFxUHnSncQ7kNvwGUCVoN&_nc_oc=Adpb9OsQbDieOpRJXodYtUDyzCKd3rFXv90eHU-33SdH4sGkHSR1bBbrrRUkJRSWMFM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDH3jqzblA2_7moLcPAyU9s1LhwzGB7weaz4gNRUfeRog&oe=6A4A76FC"}, {"file_name": "4.1.png", "id": "1455808792517113", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819323_1455808795850446_2619027289177886412_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T6tTaPNYa_4Q7kNvwGnG7ae&_nc_oc=AdoHOx3zOBusd17IufUPHQkh-e6RvaSpuwxgP8y5RJL5Y3uEkFy9C4Y0RTEJcgRB3tQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCE56wn2T_lIAb7-FJmtexQJHBzTPYHlrOBENQWSqwvZQ&oe=6A4A7FA4"}, {"file_name": "8.png", "id": "668248229368270", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823343_668248232701603_7422950020516075715_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HD3KheCSRTkQ7kNvwEK1s_e&_nc_oc=AdruCq_v0Wh3ZIGjeqVDMm5-B9EZWx3x3gUS9MIlRU6hyn0wwj8WLEk52j7MsfJ0ZD4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA4kr5Kqtj491VlDNSsCCcEPp7dgJCRNWRHD2vFCZXvPg&oe=6A4A645A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "6.png", "id": "1043468724516956", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820512_1043468731183622_3507501700877445676_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9MDlReIOYKgQ7kNvwGG5W3V&_nc_oc=Ado_ZdPrYupQsiux-m-iKJ2M4W5OyDC4CwbNlbRt3UxH_sk3bAKjiXt1M-L8CKg6g5E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBCPBxoz98UtffYjpuv6VhhEel8HVpRrhn9FtOkkskZEA&oe=6A4A64C2"}, "display_name": "Dinosaur Prehistoric Hunter VR", "keywords": ["dinosaurHuntingVR", "vrDinosaurShooter", "realisticDinoHunt", "vrBowAndArrow", "dinosaurKillerVR"], "long_description": "Step into a fully immersive VR world where survival meets prehistoric danger. In Dinosaur Prehistoric Hunter VR, you\u2019ll explore a beautifully crafted ancient jungle filled with nine deadly dinosaur species including the legendary T-Rex. Armed with powerful weapons like the MP5, shotgun, handgun, bow and arrow, and even a sword, you'll experience intense, heart-pounding action with every encounter.\n\nEvery dinosaur is designed with lifelike animations and intelligent behavior, making each hunt feel thrilling and unpredictable. Stunning realistic graphics, dynamic environments, and immersive 3D sound effects make you feel like you're really there. Whether you're sneaking through the underbrush or taking down a raptor mid-charge, every moment is packed with tension and realism.\n\nWith multiple game modes, including survival and free hunt, and intuitive VR controls built for Meta Quest, this game delivers a top-tier action adventure for fans of dinosaur games, hunting sims, and VR shooting experiences.\n\n", "short_description": "Step into a breathtaking prehistoric world where you become the hunter. In Dinosaur Prehistoric Hunter VR, you\u2019ll face off against nine unique dinosaur species, including the legendary T-Rex. Use a variety of weapons like the MP5, shotgun, handgun, bow and arrow, or even a sword to survive intense encounters. Designed with highly realistic graphics and immersive sound, this VR experience brings the thrill of dinosaur hunting to life like never before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abdurrehmanmma12327.github.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Ab Dur Rehman", "support_website_url": null, "website_url": "https://abdurrehmanmma12327.github.io/privacy-policy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_
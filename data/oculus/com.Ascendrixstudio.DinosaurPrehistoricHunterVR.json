20f&oh=00_Af5_B7uYSsf3qk0JgPcAVhFIYmYiO91tPImAMch8ZZa1Hw&oe=6A0B1BD8"}, {"file_name": "3.2.png", "id": "8464038207054206", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821115_8464038217054205_1891297688631955910_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HS1NROQWzN0Q7kNvwEsOCVj&_nc_oc=Adqsv8W1MPn9akg7wXH0FuttciWnsEcV3rlMP0ZC552ZL4vXFn6y_dgO-McplsDy9mo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af65F6TWziieCto51HeeS_Ai6-xd42PhkX7mT_PsiymCBg&oe=6A0B2EFC"}, {"file_name": "4.1.png", "id": "1455808792517113", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819323_1455808795850446_2619027289177886412_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6T5g_ahld60Q7kNvwHn8e4k&_nc_oc=Adojjml9_zzbvprcL2PoPQ7DuY36Cl5bPpfFbzRDcGsg8zTlTt50N9RmtueFqwsyQkQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6pmN3VzxeP5f0uehw3ofLnGjMEPu6JMWdolQky9-dMFA&oe=6A0B37A4"}, {"file_name": "8.png", "id": "668248229368270", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823343_668248232701603_7422950020516075715_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N1egWeRIj4sQ7kNvwGXtQ-E&_nc_oc=Adr9l7FGbmyaU_CmH2yLiPXgdjWHSj4pUBWTmks7HCoND1a1Aa2apuIAjR1nqLNeUZE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4PzW8AlKggn7IAB4c79GZDUFgmrrgZVm0msxxmCvQy-g&oe=6A0B1C5A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "2089009528581997", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491818885_2089009531915330_2772183187679478567_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZUILo8KHUdkQ7kNvwGNIrUk&_nc_oc=AdpE6zvCLXpO4tmvzDB7vCsAu6sQ_iSlTwwRrtM4ch7lgDDCXQEWtbR0nlDG29-Tw4E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af41P5YDxsqlRaXZXSAGo80WezFAF1U06ZQVbZAuXOh08A&oe=6A0B2AFF"}, "display_name": "Dinosaur Prehistoric Hunter VR", "keywords": ["dinosaurHuntingVR", "vrDinosaurShooter", "realisticDinoHunt", "survivalvr", "adventurevr"], "long_description": "Step into a dangerous prehistoric VR world where survival means hunting or being hunted. In Dinosaur Prehistoric Hunter VR, you explore a dense jungle packed with 9 deadly dinosaur species, including the legendary T-Rex and fast, aggressive raptors. Every creature has lifelike animations and smart AI that can chase, attack, and corner you.\n\nArm yourself with a powerful MP5, shotgun, handgun, bow & arrow, or sword and choose your combat style. Go loud in intense firefights, pick off enemies from a distance, or take the close-range path and slash through the danger with a sword. With survival tension, free-hunt exploration, and nonstop dinosaur action, every session feels different.\n\nBuilt for Meta Quest, the game features immersive 3D sound, detailed environments, intuitive VR controls, and optimized performance for a smooth headset experience.", "short_description": "Enter a thrilling prehistoric VR survival hunt where every encounter can turn deadly. Fight 9 dinosaur species, including T-Rex and raptors, using MP5, shotgun, handgun, bow & arrow, or sword. Explore a dense jungle, survive intense close-range combat, and enjoy realistic graphics, immersive 3D audio, and smooth Meta Quest controls."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abdurrehmanmma12327.github.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Ab Dur Rehman", "support_website_url": null, "website_url": "https://abdurrehmanmma12327.github.io/privacy-policy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2710427532541308"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graph
296901125233_94077424496935004_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GCGgGdS9_4IQ7kNvwGmEq9E&_nc_oc=AdpmWmcRb1JN_Pv3U5nSEw60RYGP2dnlbR8vNXYLR90jSPXJ4OoXM_nyng5ujXKVByw&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHcFgjaX7uU2fHz6ZyZkh83Hxh4uWKR-forxmyTa83iMw&oe=6A974B58"}, {"file_name": "3.2.png", "id": "8464038207054206", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491821115_8464038217054205_1891297688631955910_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Le05Iy1TK0Q7kNvwH87fmg&_nc_oc=AdpZw5XrOrPfZq45c0FuK4TFtv-gZG6ccYcVH22cinYruWTBCSYeXimFo8Fgoc4XLrQ&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFLQOby8Ob4gwtCB1MT7S63Uy03oAS16RIsNSbQ1uJdw&oe=6A97263C"}, {"file_name": "4.1.png", "id": "1455808792517113", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/491819323_1455808795850446_2619027289177886412_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LjXocxsZwlwQ7kNvwFHFEYW&_nc_oc=Ado-GE2OnEx0uu4F55UmXpcYtR62TGKdmccMMaygI1TkQ9eYuHnS4q57Qtj2d4L78ME&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGam_TS2M9O5mLvo4KnHCahpxbfRr03qv3FkRBf8eU1ow&oe=6A972EE4"}, {"file_name": "8.png", "id": "668248229368270", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491823343_668248232701603_7422950020516075715_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Lov_iSoevsQ7kNvwEGDSUx&_nc_oc=AdrkMNppXNM1Dj9AmoDCOZa5OesV0j7EHjxRSh2obEjavT2ZnoY8Obg7w42w_zX4fUg&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHzcu0pGYcInHaG7ZUBBGWG_ozwI4hGb9IyZY_H9vzytg&oe=6A974BDA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "6.png", "id": "1043468724516956", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/491820512_1043468731183622_3507501700877445676_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VxHWjD08b9wQ7kNvwHtBdD-&_nc_oc=AdpHJZGpNaKpnBZnSglmLdQo7oG46t2_PQt2wXtX63QwXaUbPQVKqVKAO92ij-ZWRBg&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEcXJjlqFRfcDAITkZrOzC1EKn-MYvlHrdkTlUaSfi3FQ&oe=6A974C42"}, "display_name": "Dinosaur Prehistoric Hunter VR", "keywords": ["dinosaurHuntingVR", "vrDinosaurShooter", "realisticDinoHunt", "vrBowAndArrow", "dinosaurKillerVR"], "long_description": "Step into a fully immersive VR world where survival meets prehistoric danger. In Dinosaur Prehistoric Hunter VR, you\u2019ll explore a beautifully crafted ancient jungle filled with nine deadly dinosaur species including the legendary T-Rex. Armed with powerful weapons like the MP5, shotgun, handgun, bow and arrow, and even a sword, you'll experience intense, heart-pounding action with every encounter.\n\nEvery dinosaur is designed with lifelike animations and intelligent behavior, making each hunt feel thrilling and unpredictable. Stunning realistic graphics, dynamic environments, and immersive 3D sound effects make you feel like you're really there. Whether you're sneaking through the underbrush or taking down a raptor mid-charge, every moment is packed with tension and realism.\n\nWith multiple game modes, including survival and free hunt, and intuitive VR controls built for Meta Quest, this game delivers a top-tier action adventure for fans of dinosaur games, hunting sims, and VR shooting experiences.\n\n", "short_description": "Step into a breathtaking prehistoric world where you become the hunter. In Dinosaur Prehistoric Hunter VR, you\u2019ll face off against nine unique dinosaur species, including the legendary T-Rex. Use a variety of weapons like the MP5, shotgun, handgun, bow and arrow, or even a sword to survive intense encounters. Designed with highly realistic graphics and immersive sound, this VR experience brings the thrill of dinosaur hunting to life like never before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abdurrehmanmma12327.github.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Ab Dur Rehman", "support_website_url": null, 
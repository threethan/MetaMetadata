4205_1891297688631955910_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qszWUdjh_4MQ7kNvwG8OCCv&_nc_oc=AdpA84WuDQsUavPd_r5uMzlhkCVrXcMsVGWUK8v-5bzl3MOaxXpOR0E54dbP2VSyXAI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5eDA4AN5cO4PCuKcUNDX6_MUM5gXAlOTek99xwhHKTXg&oe=6A04977C"}, {"file_name": "4.1.png", "id": "1455808792517113", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819323_1455808795850446_2619027289177886412_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4suVV7Sb8V0Q7kNvwGjCmcU&_nc_oc=AdoQ4QRnaX6yuo-a8w7vqyfMTAmBxWwaXos9LuPgiI4e5rWS679RrFlKAcFiIfBtkK4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6gElpdD6fguvdk6enENtAabA12TpNd7nSXLCZtT45MLQ&oe=6A0467E4"}, {"file_name": "8.png", "id": "668248229368270", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823343_668248232701603_7422950020516075715_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tZfIcC2W8M8Q7kNvwFSbLXt&_nc_oc=Adq6LeJjCViRe49Cz5TtlxulXY8rcY-QI7iJ7UY2fXrJwl7jD-8fpC2CVzJl65MBFTA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JwuqbYTlzFtYDaI6tP76f3vqxWYqbzeMLAx7Oi_RpvA&oe=6A0484DA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "6.png", "id": "1043468724516956", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820512_1043468731183622_3507501700877445676_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vedSWTdJiyoQ7kNvwEMsaPO&_nc_oc=AdrsIMO0UXNVcTbRU4DVsYh1ogCasYE7tibMPfQK4lRmjDfoIK6xxhuX81RwaRqEsQk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_dv0shQgQJaHcyqmeF4jpy8fqdsvNm_XVWhdS2NTlxg&oe=6A048542"}, "display_name": "Dinosaur Prehistoric Hunter VR", "keywords": ["dinosaurHuntingVR", "vrDinosaurShooter", "realisticDinoHunt", "vrBowAndArrow", "dinosaurKillerVR"], "long_description": "Step into a fully immersive VR world where survival meets prehistoric danger. In Dinosaur Prehistoric Hunter VR, you\u2019ll explore a beautifully crafted ancient jungle filled with nine deadly dinosaur species including the legendary T-Rex. Armed with powerful weapons like the MP5, shotgun, handgun, bow and arrow, and even a sword, you'll experience intense, heart-pounding action with every encounter.\n\nEvery dinosaur is designed with lifelike animations and intelligent behavior, making each hunt feel thrilling and unpredictable. Stunning realistic graphics, dynamic environments, and immersive 3D sound effects make you feel like you're really there. Whether you're sneaking through the underbrush or taking down a raptor mid-charge, every moment is packed with tension and realism.\n\nWith multiple game modes, including survival and free hunt, and intuitive VR controls built for Meta Quest, this game delivers a top-tier action adventure for fans of dinosaur games, hunting sims, and VR shooting experiences.\n\n", "short_description": "Step into a breathtaking prehistoric world where you become the hunter. In Dinosaur Prehistoric Hunter VR, you\u2019ll face off against nine unique dinosaur species, including the legendary T-Rex. Use a variety of weapons like the MP5, shotgun, handgun, bow and arrow, or even a sword to survive intense encounters. Designed with highly realistic graphics and immersive sound, this VR experience brings the thrill of dinosaur hunting to life like never before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abdurrehmanmma12327.github.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Ab Dur Rehman", "support_website_url": null, "website_url": "https://abdurrehmanmma12327.github.io/privacy-policy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area":
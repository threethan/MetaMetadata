YWOHa9OH4uTDGYexGXywszIOBRitoDTd2B-YhgYMBQJoIdKMIq38o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZo2fP6qDgYhe882HMJDQf1okE306qg6Wo48Jz2Q9m5g&oe=6A4FA9D8"}, {"file_name": "3.2.png", "id": "8464038207054206", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821115_8464038217054205_1891297688631955910_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lm3aGLAY8ycQ7kNvwGvQETo&_nc_oc=AdrCKYrJcqtedpz3285tEkp4eza-00m0Ptzg3ykBBNwlwRwp33ZpVUvHlkis8wqU4DM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDzhEWrNJS4KxgXNFMz2178r0-V5FwhDEs-dEqFGk0Uxw&oe=6A4FBCFC"}, {"file_name": "4.1.png", "id": "1455808792517113", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819323_1455808795850446_2619027289177886412_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N-3zW40IY0cQ7kNvwF1uea0&_nc_oc=AdoNfPPveKcHovp1qXPmmf4tgiGMN1KTT991QMfblVVhwxUZlrXEaDbv5qZVtgnQhCE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCHIFi7h1n3N6-cao7MuW7JTVba_Cjx2wspaBhqEfsXiA&oe=6A4F8D64"}, {"file_name": "8.png", "id": "668248229368270", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823343_668248232701603_7422950020516075715_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0yErgH6Zs-IQ7kNvwGIkq-L&_nc_oc=AdobmE3xwCZ6ol4RKr42LOCiHaIFOEDJsSAmEDDWQDy2k_D9W-wspnDZ1ATWujDLHDI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0zqDaFDMfBkjB9DJY6Sdgpn912n7RX2jgUB_qf_lMCg&oe=6A4FAA5A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "6.png", "id": "1043468724516956", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820512_1043468731183622_3507501700877445676_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jh36qvJvu_EQ7kNvwHbFGyj&_nc_oc=Adrpg_QTh4WMWewRpplGKJ6wFnZ9NRplUXhEJz6P12h2_6KMF4MNh0YgSBSg3vObgu4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCWVItIatPo1iCSEehEG3AqnLc84s2y6FvxjEn9hzjD2w&oe=6A4FAAC2"}, "display_name": "Dinosaur Prehistoric Hunter VR", "keywords": ["dinosaurHuntingVR", "vrDinosaurShooter", "realisticDinoHunt", "vrBowAndArrow", "dinosaurKillerVR"], "long_description": "Step into a fully immersive VR world where survival meets prehistoric danger. In Dinosaur Prehistoric Hunter VR, you\u2019ll explore a beautifully crafted ancient jungle filled with nine deadly dinosaur species including the legendary T-Rex. Armed with powerful weapons like the MP5, shotgun, handgun, bow and arrow, and even a sword, you'll experience intense, heart-pounding action with every encounter.\n\nEvery dinosaur is designed with lifelike animations and intelligent behavior, making each hunt feel thrilling and unpredictable. Stunning realistic graphics, dynamic environments, and immersive 3D sound effects make you feel like you're really there. Whether you're sneaking through the underbrush or taking down a raptor mid-charge, every moment is packed with tension and realism.\n\nWith multiple game modes, including survival and free hunt, and intuitive VR controls built for Meta Quest, this game delivers a top-tier action adventure for fans of dinosaur games, hunting sims, and VR shooting experiences.\n\n", "short_description": "Step into a breathtaking prehistoric world where you become the hunter. In Dinosaur Prehistoric Hunter VR, you\u2019ll face off against nine unique dinosaur species, including the legendary T-Rex. Use a variety of weapons like the MP5, shotgun, handgun, bow and arrow, or even a sword to survive intense encounters. Designed with highly realistic graphics and immersive sound, this VR experience brings the thrill of dinosaur hunting to life like never before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abdurrehmanmma12327.github.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Ab Dur Rehman", "support_website_url": null, "website_url": "https://abdurrehmanmma12327.github.io/privacy-policy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_
nw_50AH81Wv6FzGrmM--9kDdJ2jQ&oe=6A1DA3FC"}, {"file_name": "4.1.png", "id": "1455808792517113", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819323_1455808795850446_2619027289177886412_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Wktl6Dgza8Q7kNvwEFcgMx&_nc_oc=Adrf-Xp4BIAJsbEVJX2gMqHiPJ1FvOcdGcsQYK2wDU4mYH_WMSCM3MYIvH3gCthwf6Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4eMrTTtb017Zbrlzdgcut89narkLq51MDIT_elL7vTIQ&oe=6A1DACA4"}, {"file_name": "8.png", "id": "668248229368270", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823343_668248232701603_7422950020516075715_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dQ0NWJT7oCcQ7kNvwENSCbu&_nc_oc=AdrSTmNclIiAdPtN_mYM5fGyHr9BIk_vtVItkPtJQNF6AR7l6hZWDMhJVyLlGBNvzOU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4D8Ks_0zcnNWB12F0a0oIFga7boC2qpU8hmMRfe8MDng&oe=6A1D915A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x 1440x.png", "id": "1437905051708858", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499304106_1437905055042191_7913237296487105373_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2nVJZ6b-c9AQ7kNvwHa0IkL&_nc_oc=AdrxMVQqaJT02TkBynHP3-wqEAfjvL3pomxMDvKWS7Q_IHtJGJFDHl15McBzYwfLNA4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7JhQnT-6CE1bKXMUqcEhvOQ3_M93sNdwRYRfJOtxnvFg&oe=6A1D9C04"}, "display_name": "Dinosaur Prehistoric Hunter VR", "keywords": ["dinosaurHuntingVR", "vrDinosaurShooter", "realisticDinoHunt", "survivalvr", "adventurevr"], "long_description": "Step into a dangerous prehistoric VR world where survival means hunting or being hunted. In Dinosaur Prehistoric Hunter VR, you explore a dense jungle packed with 9 deadly dinosaur species, including the legendary T-Rex and fast, aggressive raptors. Every creature has lifelike animations and smart AI that can chase, attack, and corner you.\n\nArm yourself with a powerful MP5, shotgun, handgun, bow & arrow, or sword and choose your combat style. Go loud in intense firefights, pick off enemies from a distance, or take the close-range path and slash through the danger with a sword. With survival tension, free-hunt exploration, and nonstop dinosaur action, every session feels different.\n\nBuilt for Meta Quest, the game features immersive 3D sound, detailed environments, intuitive VR controls, and optimized performance for a smooth headset experience.", "short_description": "Enter a thrilling prehistoric VR survival hunt where every encounter can turn deadly. Fight 9 dinosaur species, including T-Rex and raptors, using MP5, shotgun, handgun, bow & arrow, or sword. Explore a dense jungle, survive intense close-range combat, and enjoy realistic graphics, immersive 3D audio, and smooth Meta Quest controls."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abdurrehmanmma12327.github.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Ab Dur Rehman", "support_website_url": null, "website_url": "https://abdurrehmanmma12327.github.io/privacy-policy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "2710427532541308"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26761157793540577"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619751_272070337622271
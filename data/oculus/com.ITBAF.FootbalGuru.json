111124127933013_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xQ28mOO618oQ7kNvwG0n6fo&_nc_oc=AdpFvEkZgxmi-2bL6vph2L_eRB0bq-1aroKG7vcyOjGWVBxncxdZHs4Gj-41_vwWVBA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHOb-E0cChFUgR_YaprDjc3cz-3Mth1iL0xpHGay0Tow&oe=6AEDD978"}]}, "id": "1320039603528991", "locale": "en_US", "screenshots": [{"file_name": "SS5.png", "id": "1280906564113879", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819356_1280906570780545_4249318822798510746_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PBOy3s27muYQ7kNvwFkJElt&_nc_oc=AdrE30Y0TokDTYjbOOu4MwYX9WqvttlyVMwfYMsglLR_l0GfM0a7m0j3bXWvAsaKcrE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8i8roxhc0AvIqN3AdBIObp3PwCcfUH3C_MFKO04tsog&oe=6AEDE50B"}, {"file_name": "SS2.png", "id": "1506219391176821", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821696_1506219394510154_2487401207454887292_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QKVzOpjwoysQ7kNvwEzbvMs&_nc_oc=AdrfjuB-nVnKA_ZXdNYG_XanETaXFWA7K7IRpU4Ca7OilxjxnO9RSbNUQi2jmwG25mA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAkI9P7ecK_VJnhJDrj1gEGAfz5O59w1Y-WokUeZEFPg&oe=6AEDED5F"}, {"file_name": "SS3.png", "id": "2181921189249811", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823783_2181921192583144_8744472015256948115_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8gLNcaEw7soQ7kNvwHBXqwA&_nc_oc=AdpSWm_UYvR8G1sUhP72wVCm1WTBOThXBfDA7OfWHHA1_aOXM3-3mPvvf7ag0BncF8c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_fIdRg9HHf20vJboMLEXZdcp0gtg93LCVFHeCrUCrJg&oe=6AEE02A2"}, {"file_name": "SS1.png", "id": "971915291879896", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824671_971915298546562_8886183350158453239_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BrMYjWBkA1oQ7kNvwHF3moG&_nc_oc=AdpPnEafy7cUyPMKA4e3nICgw0wMuAJIh7wGROhYjDRkmzazr8BVhrRaV6_OLB2UKI8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTXojtx-_aU8WXCyhvxJ7x0oUUXvcdGYOdGDLvBPiz3g&oe=6AEE0A8C"}, {"file_name": "SS4.png", "id": "1335145861826819", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818852_1335145865160152_3227708020367008123_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fdj7IdMiyrUQ7kNvwGyvDf6&_nc_oc=AdopI-EmlbZqixQtigI_M6AfsTNR-kMVVfMVObZP9fYDAR0yWx0VYq2rAYxcwI29f6A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtoAyHmyClmNEosYT5KzWPGVc5i5OWPgkh4AEOjucC8A&oe=6AEDFC97"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Football Guru VR", "keywords": ["football", "soccer", "sport", "sports"], "long_description": "FOOTBALL GURU is the ultimate VR penalty kick experience built for players who crave real pressure, real precision, and real skill.\n\nStep into a packed stadium. Hear the crowd. Feel the tension. It\u2019s just you, the ball, and the goalkeeper staring you down.\n\nIn FOOTBALL GURU, every shot is fully physics-driven and controlled by your real movement. Aim, adjust your angle, control your power, and strike naturally using intuitive VR controls. Curve it into the top corner. Smash it down the middle. Fake the keeper and slot it home with ice-cold confidence.\n\nBut this isn\u2019t just about kicking hard.\n\nYou\u2019ll face increasingly intelligent goalkeepers who study your patterns and adapt to your play style. Mix up your strategy. Control your nerves. Outthink the keeper before you outshoot him.\n\nFeatures:\n\nRealistic, physics-based penalty kicks\n\nImmersive stadium environments with dynamic atmosphere\n\nProgressive difficulty with smarter, faster goalkeepers\n\nScore challenges and competitive leaderboards\n\nSkill-based gameplay with no gimmicks, no randomness\n\nWhether you\u2019re chasing the perfect top-corner strike or grinding to dominate the leaderboard, FOOTBALL GURU rewards mastery, consistency, and mental toughness.\n\nPressure creates legends.\n\nStep up. Strike true. Become the Guru.", "short_description": "FOOTBALL GURU puts you on the spot in the ultimate VR penalty kick challenge. Step up, lock in, and strike like a pro as you face increasingly skilled goalkeepers in immersive stadium environments.\n\nMaster precision, timing, and mind games to outsmart the keeper and climb the global leaderboards.\n\nNo shortcuts. No gimmicks. Just you, the ball, and the pressure.\n\nDo you have what it takes to become the Guru?"}]}, "developer_name": "The Lonely Developer", "developer_privacy_policy_url": "https://thelonelydeveloper.net/football-guru-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ITBAF", "support_website_url": null, "website_url": "https://planeta.guru/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_MX"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27491985077069520"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1636955567348302"}]}, "baseline_offer": {"id": "1636955567348302"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1779137640, "status": "PUBLISHED", "id": "1636955567348302"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28204803595787661", "version": "22"}, "id": "845497571864982", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [
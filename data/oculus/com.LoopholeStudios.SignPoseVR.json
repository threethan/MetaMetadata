774240632", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820923_1368357777573965_8772703982224419391_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H2S_7T8I5oMQ7kNvwFhsGqo&_nc_oc=AdqUDGcudzhUeGMoU7e3GJBc-ujebQIBM5b9vcSrmI87s-6GNjrDHc29mbBafpeVydU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYXhN8TUiBthDdiXG-ZytTLjV48usM3UDlVWy98qFs5w&oe=6B09B54B"}, {"file_name": "screenshot4.png", "id": "1945694769517551", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491819318_1945694776184217_8057859631288695309_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=thlspRKZjDEQ7kNvwHH3Rqg&_nc_oc=AdqYi_1qbZSqfFB2M1o2OwhXJGk39zWwSdqFU_xZ2Tf_fKGx_pfo815C1Goq3-Pgrdk&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTor0qgbG_VV00WNa3_FBQuuIrSW_AIRiS_gFMN7VIOKw&oe=6B09B6CD"}, {"file_name": "screenshot3.png", "id": "1563239901302430", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821674_1563239904635763_4247353696748607300_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rdVNuUMdEosQ7kNvwEnT1Oq&_nc_oc=AdozAKTozKttLhiMefxyVvQ6NHuGRcLvtmaZM6HgwdcbOFBs3LxsYfXV-PBGMkn_2Is&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgNZK747YLTYzCJMjYfS0bC6HfbzrSucTRbN81tMI4VA&oe=6B09C63C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Sign Pose VR", "keywords": ["americansignlanguage", "signlanguage", "sign", "language"], "long_description": "SignPose VR is a learning tool that helps you learn American Sign Language in VR using intuitive hand tracking. \n\nMade for complete beginners, get immediate feedback with a focus on sign accuracy and retention.\n\nFeatures:\n\n- Hand tracking: perform signs with your hands and get immediate feedback; no controller needed.\n- Two modes: In 'Learn mode', understand how to perform each sing properly. In 'Quiz mode', test yourself and get a high score.\n-Intui
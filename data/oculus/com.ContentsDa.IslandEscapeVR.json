t-ams2-1.oculuscdn.com/v/t64.5771-25/499618432_1251403049672668_4341407743166008675_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5aZisRvChjYQ7kNvwEpniCs&_nc_oc=AdlP-HR2q5Zv-2fTZMm95gkOHFKPEFnla26LgmYjVTSlnEurrictyVAxvAe6DCOGFMY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfszkFtTuEspnP6iXh4PB-mEz4mQo751S9f9dhaIxv4r-w&oe=699EF153"}, {"file_name": "ApplicationFrameHost_s7007fMNpv.png", "id": "2185779231854729", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618920_2185779235188062_5942856644727983798_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mVP0qBW_ZqkQ7kNvwEHWpFW&_nc_oc=AdlLXtWovA05pdNihF9wft3YeZ-kr6MgB2IrgvFJWLkMQJoGLhtpLf7S42GYLql78PE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsRcvcHEFzspzanaoMPVAiSaC7uCPNyY-zACOnBP1AP9A&oe=699EF084"}, {"file_name": "ApplicationFrameHost_x3W1pDc9xl.png", "id": "1625212631680898", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619742_1625212635014231_6054231191579707641_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nbfek4u6p_QQ7kNvwGp8OWc&_nc_oc=AdkzMnFDNGxuCnmOIrl-XHeVvsmtc3NJ0pSg_2sehoByMv598A9q_1UqMhycw4PLq8s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftlwbpGDFVOZXqSD-MuSsS_b4yutmn-UGhU75KM684XAA&oe=699EFC33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Island Escape_Landscape.png", "id": "1515471865898190", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974668_1515471869231523_4510089248881648284_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZtGPcU_ufTMQ7kNvwHoUfKt&_nc_oc=AdldCeBTLHG7C0eZSY5CCdMKEkL8SU80Fa3qh54LUIfS4m6Nnu0BZxmue-aEuSXJSvs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftR2kJMyHqwONqszAFXyV2S2Jr-QPaOeKL8q09fRPEQwg&oe=699ED560"}, "display_name": "Island Escape VR - ContentsDa Science Experiment", "keywords": ["story", "island", "escape", "science", "contentsda"], "long_description": "1. Secure: From the airplane door, use the axe to take a leafless tree to make firewood, then place it in the marked location.\n2. Build a fire: Use the newspaper to place on top of the firewood and use the tinder to light it.\n3. Build a shelter: Find a nearby cave and build your own house to provide a safe space from animals.\n4. Repel mosquitoes: Use plastic bottles and a knife to make mosquito repellent and place it around your home to protect it from mosquitoes.\n5. Secure drinking water: Collect seawater in a pot and use it with cups to boil over a campfire.\n6. Gather food: Use the axe to follow the red light into the forest to gather fruit and fish.\n7. Salt making: Use water from the ocean to make salt to preserve food. \n8. Sending a distress signal: Send an international distress signal by creating a triangle signal and SOS letters in marked locations by lighting a fire.\n9. Generate electricity: Make light bulbs to light up your home and survive in challenging environments.\n10. Raft building: Chop down a tree with an axe, use rope to build a raft, and row across the ocean for a successful escape.\n11. Sea Rescue: Hone your survival skills in environments like Antarctica while waiting for rescue, and take on new challenges to escape.", "short_description": "Immerse yourself in a virtual reality adventure on a deserted island. Solve puzzles and learn survival skills in this interactive and educational experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support_website_url": null, "website_url": "https://training.contentsda.kr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT",
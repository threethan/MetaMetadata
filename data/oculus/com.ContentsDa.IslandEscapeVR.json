id": "2185779231854729", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618920_2185779235188062_5942856644727983798_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fk4DSdN7q84Q7kNvwEwOSbk&_nc_oc=AdkXgw4-bvMtllSPTM8XPrP2k7Nad0rwwG7SUwLnEo-TVLaZczu371B8DRUxXqkecaw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzTI5N86SJh1TjaNTJ-G3PzrN7wC9CmA2sSwmGTuwOr_Q&oe=69AC1F84"}, {"file_name": "ApplicationFrameHost_x3W1pDc9xl.png", "id": "1625212631680898", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619742_1625212635014231_6054231191579707641_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1LLdBudnqjEQ7kNvwEMXMeZ&_nc_oc=Adlra4I7fCM7ehM8BPDVXS-bFREAiQlyVkgoxrQ2kzWWukzLOsXG-fJj4EqraqnTPNI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz_NuvnWLgFn1yy2pxmDpx2y-DXVs8_oIU6hQASd6bmFA&oe=69AC2B33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Island Escape_Landscape.png", "id": "1515471865898190", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974668_1515471869231523_4510089248881648284_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8kE-51Dze2UQ7kNvwE43irL&_nc_oc=Adl9GxjK4QZz-ctv_mgJOGOzrmEfcKq0j-XcGdRzOuc2NVufqSlgZhBMEBW2Ou0cSeQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy5RKKuHbIJlfUKZShoK8ARXrC27Brcr0h9_WBh2I6Pqw&oe=69AC0460"}, "display_name": "Island Escape VR - ContentsDa Science Experiment", "keywords": ["story", "island", "escape", "science", "contentsda"], "long_description": "1. Secure: From the airplane door, use the axe to take a leafless tree to make firewood, then place it in the marked location.\n2. Build a fire: Use the newspaper to place on top of the firewood and use the tinder to light it.\n3. Build a shelter: Find a nearby cave and build your own house to provide a safe space from animals.\n4. Repel mosquitoes: Use plastic bottles and a knife to make mosquito repellent and place it around your home to protect it from mosquitoes.\n5. Secure drinking water: Collect seawater in a pot and use it with cups to boil over a campfire.\n6. Gather food: Use the axe to follow the red light into the forest to gather fruit and fish.\n7. Salt making: Use water from the ocean to make salt to preserve food. \n8. Sending a distress signal: Send an international distress signal by creating a triangle signal and SOS letters in marked locations by lighting a fire.\n9. Generate electricity: Make light bulbs to light up your home and survive in challenging environments.\n10. Raft building: Chop down a tree with an axe, use rope to build a raft, and row across the ocean for a successful escape.\n11. Sea Rescue: Hone your survival skills in environments like Antarctica while waiting for rescue, and take on new challenges to escape.", "short_description": "Immerse yourself in a virtual reality adventure on a deserted island. Solve puzzles and learn survival skills in this interactive and educational experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support_website_url": null, "website_url": "https://training.contentsda.kr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9789337644507452"}, "review_messages": []}]}, "cover_sq
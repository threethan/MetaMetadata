7_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AgGNU3KsCNgQ7kNvwEHYEia&_nc_oc=Adl9RZ26a3S_mNFxaj4zu3X1rqbgPDUtC9nPcV1JsIkUgFgRmYd99o8CIb5y9D_0ttk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsaM-eq8xGSvcqsvPfA3-oSQp7XGYZzBAzseCJyizi0AQ&oe=699870AA"}, {"file_name": "ApplicationFrameHost_S6KbBSfMw8.png", "id": "1251403046339335", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618432_1251403049672668_4341407743166008675_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4m1UC3qLrk4Q7kNvwGl380P&_nc_oc=AdnLUKGc81D765vEemBXCPd3_DO05asxSWf9iTEjhxHP5GFnCx3DAbXwYVpBdSxujYQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftcWICvr63WdCdWUTULe99oqmzHn0Emx5BkVVvMGqbRtA&oe=699859D3"}, {"file_name": "ApplicationFrameHost_s7007fMNpv.png", "id": "2185779231854729", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618920_2185779235188062_5942856644727983798_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HCZZIyYuYOEQ7kNvwGHKKvo&_nc_oc=AdmPf-ws4OhXeToK4lfX_XLHJMOuae_26UQKBxIoV_pf2lQuwlG5YOL_7PVHsDkQm-0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvDRj1aqMl3epIAZrF0STX8W1_0Sns_WEhRl-zzeEoNZA&oe=69985904"}, {"file_name": "ApplicationFrameHost_x3W1pDc9xl.png", "id": "1625212631680898", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619742_1625212635014231_6054231191579707641_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NxaNEoulXlMQ7kNvwHmnH0F&_nc_oc=AdnFWU79uFkA6-UVF2WFcGnxz3Wu58IMvLf-aUwU1Vj_2xlc761gdOjOIVJ8ivO4r_w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfuZlHSW6nJ83h6UcczzzaOOQmmH7lOKgbJunPZ9J-TjAg&oe=699864B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Island Escape_Landscape.png", "id": "1515471865898190", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974668_1515471869231523_4510089248881648284_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3rC3IAHALWkQ7kNvwGOGK5m&_nc_oc=Adl3QB5_g-NDzZmCLCgMh3WRubBQ7BFDonpYG9hAAehA7aC4DEESz9stvXACjR2Vu2Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftvASNtGkBsXgtKa7GjP17SZp_Mo0H6bRA_YJK4t2FQoA&oe=69983DE0"}, "display_name": "Island Escape VR - ContentsDa Science Experiment", "keywords": ["story", "island", "escape", "science", "contentsda"], "long_description": "1. Secure: From the airplane door, use the axe to take a leafless tree to make firewood, then place it in the marked location.\n2. Build a fire: Use the newspaper to place on top of the firewood and use the tinder to light it.\n3. Build a shelter: Find a nearby cave and build your own house to provide a safe space from animals.\n4. Repel mosquitoes: Use plastic bottles and a knife to make mosquito repellent and place it around your home to protect it from mosquitoes.\n5. Secure drinking water: Collect seawater in a pot and use it with cups to boil over a campfire.\n6. Gather food: Use the axe to follow the red light into the forest to gather fruit and fish.\n7. Salt making: Use water from the ocean to make salt to preserve food. \n8. Sending a distress signal: Send an international distress signal by creating a triangle signal and SOS letters in marked locations by lighting a fire.\n9. Generate electricity: Make light bulbs to light up your home and survive in challenging environments.\n10. Raft building: Chop down a tree with an axe, use rope to build a raft, and row across the ocean for a successful escape.\n11. Sea Rescue: Hone your survival skills in environments like Antarctica while waiting for rescue, and take on new challenges to escape.", "short_description": "Immerse yourself in a virtual reality adventure on a deserted island. Solve puzzles and learn survival skills in this interactive and educational experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support_website_url": null, "website_url": "https://t
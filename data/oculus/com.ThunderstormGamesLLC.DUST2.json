5771-25/499298387_1933726704220904_8651334656463140062_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k7T-uif8y9oQ7kNvwE3lzsj&_nc_oc=AdrkVpjcAMwz47dukmAyGWmfv1fG_E0_L8W3JkM4s1m6bb1cwlFeLnxy3y18WcEeCzM&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH68n2Bz5uarC_CLdI4i4Wak--JsitRf3Nv_HtpRIBQvA&oe=6A9170AB"}, {"file_name": "499303971_1122560476517558_6487819381519805991_n.png", "id": "1451322636603086", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/491824611_1451322639936419_2675846120480425939_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jqIjIboLy7IQ7kNvwHzECh0&_nc_oc=AdpH0cvF0pLjVhrR-PnqzBjo1_pF51kQlraHWkpiKLeg-JDp05nE1YnvwWd_hDCwLPI&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH94iGvZ3_YFLgmdKVYa7Iwrf-13KTlYaZZOdquTA2CPA&oe=6A918EB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DUUSTTRAILER.png", "id": "1380664073741656", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/491825050_1380664077074989_2464061339514971721_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X7SQ2EUH5pYQ7kNvwHRxb6O&_nc_oc=AdoLwXyhGbssgvoQ6R14TLzOmFTJspW2-nnPb1d3TcGC0dfAXBdUnymyVkX6DWWEtD8&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMq0lKCrtCABp6f4lRTHwPT9wt5YYUgZtzGQr8LwUMkA&oe=6A9172CB"}, "display_name": "DUST II | The Infinite Zero Point", "keywords": ["sandbox", "story", "physics", "playground", "slomo"], "long_description": "(EA) Welcome to DUST II. Set in 2025, you and your crew must locate the Zero Point. If you're daring enough, venture alone and face the consequences of your choice. The path is yours. Choose your own fate.\n\n{1403629178087416}**DUST's story is based on the Fortnite storyline.**\n\nYou are The Visitor, One Of The SEVEN. After Earth went to hell because of the war against the IO and the seven, the Zero Point decided to escape and hide. Your mission is to locate the Zero Point and control it, but it won't be easy. Every hallway, every room, there are IO guards waiting for you; they are ready to kill you in any way. But you have a trick up your sleeve, you can clone yourself until your suit overheats!\n\n{845195935057493}\nDon't like Story games? Play Sandbox! Your imagination is your limit.. and some other things.\n\n**Explore The Maps**\n\nWe have a variety of maps to choose from.\n\n* GUN PLAYGROUND\n\n* PIER HOUSE\n\n* EMPTY TESTING SITE\n\n**Don't like the weather? Alternate the map!**\n\nChoose from Spring, Winter, and much more!\n\n**WEAPONS**\n\nTest out a handful of weapons on dummies, crates, or gas tanks.\n\nOr just blow yourself up and everything around with a grenade.\n\n\n\n{2076518246483876}**Similar to BONEWORKS, BONELAB, GARRY'S MOD, and HARD BULLET.**\n\nYour world is a physical mess. Use a crowbar's Curved ends to hold multiple objects at the same time, or use a clipboard to fling yourself into a building, or put a ladder at your feet and pick it up and make it launch you into the sun, or even pick up a car with your own fists! And yourself? Well, maybe someday you will become a physics object.", "short_description": "The year is 2025. You are The Visitor, one of the Seven. Your mission is to locate the Zero Point and stabilize it before it\u2019s too late. Fail, and it will be THE END for all realities."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/thunderstormgamesprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Shotgun Studios", "support_website_url": null, "website_url": "https://thunderstormgames.godaddysites.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED"
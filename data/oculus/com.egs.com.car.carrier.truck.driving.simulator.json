UTjGgGBwa8O_Ikumm_dN-F3WICfVfn9D3sgYc9lOA&oe=6B0DBF2A"}, {"file_name": "2.png", "id": "1992623104619213", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604328314_1992623107952546_216558759112861572_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oRKuNLlUPfoQ7kNvwHWLM0z&_nc_oc=AdrYxTBaSnMryQJG_AOtXbSLeJItqAYVvqL4GK3xNK3GWZtbzpa3EmFIPl-KMAZK5qg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQkMxwCihuVMX8_RqS9B7YytjlnKsjdTei4f75lT6yfTQ&oe=6B0DA5E7"}, {"file_name": "3.png", "id": "951034071382469", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831279_951034074715802_5157619558291095154_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qa2DtcRqbh0Q7kNvwG3PIA2&_nc_oc=Adq4tTxsvvLxYJ337aNF0L8Mu2Trd1hIjU5ilMr2bBkieTBGUs2YDF831A2UmnrX_mc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTDlsx4l0jG0w8cfCBDWrV7CAxCUlSla-odOq567ZbOMg&oe=6B0DC3E1"}, {"file_name": "Car_Carrier_5_2560x1440.png", "id": "1855949455780254", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/789889603_1855949459113587_7497412030053257730_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nC4Yi4J6axcQ7kNvwGYee_b&_nc_oc=AdpxPjYodXBI47PA0RqBdv--wJU7TIqgGkX1dE7vSpP63hQkQaAYmRHDSqltCXl2FM4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTZan50-PHms67DmJsHSA6-TD2DakGbuwsGh2NinaDzfg&oe=6B0DAAE6"}, {"file_name": "4.png", "id": "1623515039146132", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/596068480_1623515042479465_1418174059802864775_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m__V2Zsw0AcQ7kNvwHT2yBc&_nc_oc=Adr5wIpvf_VRs7aU9tYrfBeq-A4gr9ufCxSxvwFC48yKbPmevDy4ntVao62tAl309xA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQSevYFz4QWGD1xQ6XsSHD_IFeGRbQ5YJSivS7Z-KXN7g&oe=6B0DC2E5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Car Carrier: Truck Driving Simulator", "keywords": ["driving", "transport", "cargo", "delivery", "parking"], "long_description": "\n# Drive the Cars. Load the Carrier.\n\nTake on the complete vehicle transport job in **Car Carrier: Truck Driving Simulator**.\n\nStart behind the wheel of different cars. Drive each vehicle onto the carrier and position it for transport. Once the cars are loaded, switch to the heavy truck and head for your delivery destination.\n\n# Take the Wheel of the Transporter\n\nFollow route guides and destination markers as you deliver cars to showrooms, stores, and customers. Move from positioning individual cars to controlling a large loaded carrier, handling the job from loading to final delivery.\n\n# Key Features\n\n- Drive different cars before transporting them\n- Load and position vehicles on a heavy car-carrier truck\n- Switch from car driving to heavy-truck driving\n- Follow guided routes to marked delivery destinations\n- Deliver cars to showrooms, stores, and customers\n\nEnjoy car driving and truck simulators? Put both skills to work in a complete car delivery experience. Start the engine, load your carrier, and take on the next transport job.\n", "short_description": "Drive different cars onto a heavy car-carrier truck, then take the wheel of the loaded transporter. Follow guided routes and deliver vehicles to showrooms, stores, and customers. Handle the complete job from loading to delivery."}]}, "developer_name": null, "developer_privacy_policy_url": "https://engaginggamesstudio.com/privacy.htm", "developer_terms_of_service_url": null, "publisher_name": "Engaging Games Studios", "support_website_url": null, "website_url": "https://engaginggamesstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_
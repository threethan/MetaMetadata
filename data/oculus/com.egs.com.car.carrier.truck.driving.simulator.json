mxcK1rd3hiAvV9V4ESaoaclBcm0XF9AP1ndrQwxNQ&oe=6B0484AA"}, {"file_name": "2.png", "id": "1992623104619213", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604328314_1992623107952546_216558759112861572_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zgWideU4tsoQ7kNvwGjahwO&_nc_oc=AdpwAtAx0CDWQm7sUD71FFcmL5Hl9ISSji8J44GCEzZxo_agKiF6anYYBGOnfdI6Ck8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXU8nJ_t4n2pcyaRHvCb2ivke6_QXHXOykNaQ5HJX8uA&oe=6B046B67"}, {"file_name": "3.png", "id": "951034071382469", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831279_951034074715802_5157619558291095154_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D5-TTxOm51IQ7kNvwF63cul&_nc_oc=AdocOZt8qr7aRtSYH-YfW_ffBEPXRsnSbvuT-Bf_pj1WCRFW8accbZw2IHToeEb-bAA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-_7MzdK-ZFdqd_7EyanMH0UW5fIG08JbhOOD2qvEHGw&oe=6B048961"}, {"file_name": "Car_Carrier_5_2560x1440.png", "id": "1855949455780254", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/789889603_1855949459113587_7497412030053257730_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5uGwbsQnvvsQ7kNvwHnS9_c&_nc_oc=AdoxaLXfUben7ECSSOuT-euR0IrINExkkmexAAnGj4XZbLv3ii0qkB9RJrcKJXlD1FM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQrr16UT2LNY4ob_bf49jW8LnY6_1C8NFd0q6VbmzrhAA&oe=6B047066"}, {"file_name": "4.png", "id": "1623515039146132", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/596068480_1623515042479465_1418174059802864775_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PE7knpim_iAQ7kNvwH47dpv&_nc_oc=AdpuD9X1L8C1zlYa_v26vtCLRfDeYFUHu36Hlpn7C9YzujzHxnAtF6fegzVaKX67dWA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCrts0Xvi_a8LQsSBD3x7r0PeyWsf1Z_79s4sqXJT-qw&oe=6B048865"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Car Carrier: Truck Driving Simulator", "keywords": ["driving", "transport", "cargo", "delivery", "parking"], "long_description": "\n# Drive the Cars. Load the Carrier.\n\nTake on the complete vehicle transport job in **Car Carrier: Truck Driving Simulator**.\n\nStart behind the wheel of different cars. Drive each vehicle onto the carrier and position it for transport. Once the cars are loaded, switch to the heavy truck and head for your delivery destination.\n\n# Take the Wheel of the Transporter\n\nFollow route guides and destination markers as you deliver cars to showrooms, stores, and customers. Move from positioning individual cars to controlling a large loaded carrier, handling the job from loading to final delivery.\n\n# Key Features\n\n- Drive different cars before transporting them\n- Load and position vehicles on a heavy car-carrier truck\n- Switch from car driving to heavy-truck driving\n- Follow guided routes to marked delivery destinations\n- Deliver cars to showrooms, stores, and customers\n\nEnjoy car driving and truck simulators? Put both skills to work in a complete car delivery experience. Start the engine, load your carrier, and take on the next transport job.\n", "short_description": "Drive different cars onto a heavy car-carrier truck, then take the wheel of the loaded transporter. Follow guided routes and deliver vehicles to showrooms, stores, and customers. Handle the complete job from loading to delivery."}]}, "developer_name": null, "developer_privacy_policy_url": "https://engaginggamesstudio.com/privacy.htm", "developer_terms_of_service_url": null, "publisher_name": "Engaging Games Studios", "support_website_url": null, "website_url": "https://engaginggamesstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_
&_nc_sid=6e7a0a&_nc_ohc=GO-U8vGuh4EQ7kNvwGHFNmB&_nc_oc=AdotuxScDknyJiGarnmFF6iCqsqPstnuB4uJff1WG54LiowPXmyC2A4ZCyeTVoQDDpI&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLDQLced-51ZB_Rxapgr1Xyh44okKHnoDnOZy--XMb1g&oe=6B09B666"}, {"file_name": "4.png", "id": "1623515039146132", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/596068480_1623515042479465_1418174059802864775_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-rEI5uL-GAUQ7kNvwHxIVY3&_nc_oc=AdpP4am5k4o76sw0r5Ly2fbUWlNfyzkDifBDgw1diUniepity_OMh2WJxIK8REonbMo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJxwTFlH4gVSDw9ZHFtWhaH0Vmyf48pUb3Q_MB6TT8Cg&oe=6B09CE65"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Car Carrier: Truck Driving Simulator", "keywords": ["driving", "transport", "cargo", "delivery", "parking"], "long_description": "\n# Drive the Cars. Load the Carrier.\n\nTake on the complete vehicle transport job in **Car Carrier: Truck Driving Simulator**.\n\nStart behind the wheel of different cars. Drive each vehicle onto the carrier and position it for transport. Once the cars are loaded, switch to the heavy truck and head for your delivery destination.\n\n# Take the Wheel of the Transporter\n\nFollow route guides and destination markers as you deliver cars to showrooms, stores, and customers. Move from positioning individual cars to controlling a large loaded carrier, handling the job from loading to final delivery.\n\n# Key Features\n\n- Drive different cars before transporting them\n- Load and position vehicles on a heavy car-carrier truck\n- Switch from car driving to heavy-truck driving\n- Follow guided routes to marked delivery destinations\n- Deliver cars to showrooms, stores, and customers\n\nEnjoy car driving and truck simulators? Put both skills to work in a complete car delivery experience. Start the engine, load your carrier, and take on the next transport job.\n", "short_description": "Drive different cars onto a heavy car-carrier truck, then take the wheel of the loaded transporter. Follow guided routes and deliver vehicles to showrooms, stores, and customers. Handle the complete job from loading to delivery."}]}, "developer_name": null, "developer_privacy_policy_url": "https://engaginggamesstudio.com/privacy.htm", "developer_terms_of_service_url": null, "publisher_name": "Engaging Games Studios", "support_website_url": null, "website_url": "https://engaginggamesstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1267458226458441"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1794245541885710"}]}, "baseline_offer": {"id": "1794245541885710"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790614380, "status": "PUBLISHED", "id": "1794245541885710"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1329566413580955", "version": "1.4"}, "id": "1623574039332433", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1239367905934140", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1329566413580955"}, "release_status":
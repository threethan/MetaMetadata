FpW_VpCrs872q0ZDnFCbuoh2Xi5FdvNhnQR1ESPnlYUbP8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1bTsYnBpayJBXnAtA4TNRR5c5ixAY4OL4tm2d9RcqbCA&oe=69E4E0BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "title_2560x1440_2021-07-15_14-43-19.png", "id": "373849930858399", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974813_373849934191732_5524922920908616826_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S53TeQJUY84Q7kNvwGrmjLz&_nc_oc=AdqlMK1JVvaLBFZhhnD5ks4SCRb-H6R6UghfZbnAIrmG1ovcnD_k2tCyl9ULXbr3utM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1LfrHHHlBvFa8Nr3xWdselps2zNWQHR_XcPloGujBO9g&oe=69E4C0DC"}, "display_name": "Starfighter Arduxim", "keywords": [], "long_description": "Strap into the cockpit of your Arduxim starfighter and take on enemy starships in this first-person tactical space shooter. Navigate through dangerous ice crystal fields, travel through hyper gates to other systems, take on enormous capital ships and more.\n\nControl your ship using Touch controllers, a gamepad, or hand tracking. Players can use the thumb sticks on a physical controller, or for a more immersive experience grab virtual cockpit controls using the Touch controllers or your bare hands.\n\nIncludes:\n* A fourteen mission story based campaign covering your first tour of duty on the front lines\n* Multiplayer to test your skills against other pilots\n* Survival/horde challenge mode with online leader board\n* Tutorial\n* Practice mode", "short_description": "Strap into the cockpit of your Arduxim starfighter and take on enemy starships in this first-person tactical space shooter. Navigate through dangerous ice crystal fields, travel through hyper gates to other systems, take on enormous capital ships and more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fulby.tech/privacy-policy", "developer_terms_of_service_url": "https://s3.amazonaws.com/arduxim.com/terms.txt", "publisher_name
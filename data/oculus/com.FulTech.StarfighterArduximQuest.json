6TKXYmlpVNzs2KdcW4sMOqWAxmeboqxpPN_9CNCLrZ5dxE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxwCwoWCJF95Suw3plQ5JbHWvzhP29vcws5P5Q78krKrg&oe=69C299BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "title_2560x1440_2021-07-15_14-43-19.png", "id": "373849930858399", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974813_373849934191732_5524922920908616826_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1u-v6JNFOikQ7kNvwHPPxdl&_nc_oc=Adq4k9q2dtksTOvK7J9zrcpAZlBpxD77z4wmBZ2SPoJMZsAhks89uOQnrFplZtpU6Gg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzntbtlikOjT3RC9VtB0kB8VrCPE2UeHZ74eiR8tJyo6g&oe=69C279DC"}, "display_name": "Starfighter Arduxim", "keywords": [], "long_description": "Strap into the cockpit of your Arduxim starfighter and take on enemy starships in this first-person tactical space shooter. Navigate through dangerous ice crystal fields, travel through hyper gates to other systems, take on enormous capital ships and more.\n\nControl your ship using Touch controllers, a gamepad, or hand tracking. Players can use the thumb sticks on a physical controller, or for a more immersive experience grab virtual cockpit controls using the Touch controllers or your bare hands.\n\nIncludes:\n* A fourteen mission story based campaign covering your first tour of duty on the front lines\n* Multiplayer to test your skills against other pilots\n* Survival/horde challenge mode with online leader board\n* Tutorial\n* Practice mode", "short_description": "Strap into the cockpit of your Arduxim starfighter and take on enemy starships in this first-person tactical space shooter. Navigate through dangerous ice crystal fields, travel through hyper gates to other systems, take on enormous capital ships and more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fulby.tech/privacy-policy", "developer_terms_of_service_url": "https://s3.amazonaws.com/arduxim.com/terms.txt", "publisher_name
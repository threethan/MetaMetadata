ntent-dfw6-2.oculuscdn.com/v/t64.5771-25/491821099_26348787124759853_1981439846652809661_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=raRsrkRI1hcQ7kNvwE5wUWM&_nc_oc=AdoLn9lzc-MlcAH8wJdBOl3pGvWTNoV6jqrtGs6EkDQZXHWnk23Zj4Zn-IFA8QkLSJk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJkylU_ee0O4ZWtsT3Rj4L4INTvHglpgntmNYjSojL6A&oe=6A661DCA"}, {"file_name": "Screenshot 2026-02-17 233122 (1).png", "id": "2209156856557927", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491821099_2209156866557926_3951397251920902395_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DCrFiFn1ms8Q7kNvwH8n-6t&_nc_oc=AdoL_N0oJWVG3M2b2sqmtAe5kAP1WvT2OpWwXNxf1yJ_du8Hqr9E7Uv7eiorQM98pcA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAbHvkYTuKguMmVtjM62O4T2zFgzUG-BGlzPnjJsPM7qA&oe=6A65FF97"}, {"file_name": "Screenshot 2026-02-20 174451.png", "id": "925165673319014", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491818885_925165679985680_4952629056887321804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DknAFMMWOAwQ7kNvwH9Lw5c&_nc_oc=AdqKu7B4FiYZ7y2VdsCUYecv8jPJFZd9pXkluowHjfkfmKSm1S_lQ2XIWbONlZIoAXQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtSdLo88KRnDdR0Mwt9Dkbk0LrYzwcjQLrKpc2lyWLTg&oe=6A65F9FE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Sammy's Gorilla Tag Horror", "keywords": ["horror", "gorilla", "tag", "Sammy", "Sam"], "long_description": "Step into a fast-paced VR horror experience built around full arm-based locomotion. There are no buttons to save you \u2014 only your movement skills.\n\nExplore dark, abandoned environments where every sound matters. Climb, crawl, and launch yourself through tight spaces as something stalks you from the shadows. The better your movement, the better your chances of surviving.\n\nThis game blends skill-based gorilla-style locomotion with tense horror atmosphere, creating moments where panic and precision collide.\n\nFeatures:\n\nArm-based VR movement\n\nImmersive horror environments\n\nIntelligent enemy AI\n\nIntense chase sequences\n\nDesigned for standalone Quest\n\nYou are not trapped.\nYou are not safe.\nAnd it hears everything.", "short_description": "A terrifying VR horror experience using full arm-based movement. Run, climb, and escape through dark environments while something hunts you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/Estherhalkyard-boop/tree_climberss-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "sammy9095", "support_website_url": null, "website_url": "https://github.com/Estherhalkyard-boop/tree_climberss-privacy-policy", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26185085604464851"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "3787887918174748"}]}, "baseline_offer": {"id": "3787887918174748"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1772036100, "status": "PUBLISHED", "id": "3787887918174748"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26213781101595301", "version": "6"}, "id": "936248208788887", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"no
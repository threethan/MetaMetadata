or standalone Quest\n\nYou are not trapped.\nYou are not safe.\nAnd it hears everything.", "short_description": "A terrifying VR horror experience using full arm-based movement. Run, climb, and escape through dark environments while something hunts you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/Estherhalkyard-boop/tree_climberss-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "sammy9095", "support_website_url": null, "website_url": "https://github.com/Estherhalkyard-boop/tree_climberss-privacy-policy", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26185085604464851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821682_25646811608351742_1153066600292908174_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qNn-TbWq-hMQ7kNvwFc2PKI&_nc_oc=AdpX2S-wCWiWh3hcQ4_V0Z3XwC3DsiEk6PIYZy-uQWL1pHeFZ2teucQ2x--EVDETm10&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIFUdFbNu5ujWoQpVkg35EB4j7PKWMkBl1-xkGG7RZhw&oe=6B04836B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Sammy's Gorilla Tag Horror", "platform": "ANDROID_6DOF", "context_category": {"context_category": "
.png", "id": "879184397658124", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031508_879184400991457_3956335973008078823_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LVo8iEdhUWAQ7kNvwHx9nDA&_nc_oc=Adpa1XtgZN5FDgjTOMCQtD26jg4qflIo11-tT_LUIG3QR8T06ItJUY51zK72SVndTz4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_WW4lkNRK8yMaFkt1m_vdhC_dXFnRzQRp1xleJ30f2w&oe=6A01D2FF"}, {"file_name": "Pesquet_1080x360_ENG.png", "id": "875318777440495", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031608_875318780773828_2284843673583641735_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tmM_VXvTcqEQ7kNvwHNBm_d&_nc_oc=AdrfO371K8xZ3FNQmw1M9aYmJWjrgS63x0ROct9PAYVgym9H640XXe0DU7lfZQZ4rqM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7VDyjUKwd8kZlx8izhoKF7UR2tMqHKyvoP0aeqepwDQA&oe=6A01F1CE"}]}, "id": "583979444497089", "locale": "en_US", "screenshots": [{"file_name": "Pesquet_2560x1440_SCREENSHOT.png", "id": "732031702397160", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974450_732031705730493_5342781296539986497_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q2Bx5JHgU4cQ7kNvwGNlj4p&_nc_oc=AdoiMJ9zCeZ80AGHuxwgSHcDEAU4d50s4U9MHRWotagXYBFpcsPukb-wD9rkhSEFtRw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af76BI9iS9hqAoiem1_9zS2WhGsPJ6j3ZeaJMj4OpIHP1A&oe=6A01C786"}, {"file_name": "Pesquet_2560x1440_SCREENSHOT4.png", "id": "892024476110437", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974783_892024479443770_4791118796329511831_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mvJj4JeMHUgQ7kNvwErSqPJ&_nc_oc=AdpOeSb3Yu8cvAEfR--926NGgczpOeLyZrKxLKKNYCe1bBsi5YGIJZTjU4T-pvsNN1E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6QQ_cxWFZHM6-TsTVE7QNTnmDbmVbx476fwcF_OMQMgQ&oe=6A01C6D4"}, {"file_name": "Pesquet_2560x1440_SCREENSHOT2.png", "id": "1239004950628610", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974439_1239004953961943_2889293322071432452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CO7B48Ukyc4Q7kNvwFXpH-o&_nc_oc=Adp0HqsMDsQDZ-RuGN5VUQE8_cWd9Se5QxdzqlWmswxTO8XCuvhl69cg5Ghsc7PGcM8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ICgvPRUxGvExlrc4zf_EgVstZZNVrOS_z7-FUiHLqSg&oe=6A01CC45"}, {"file_name": "Pesquet_2560x1440_SCREENSHOT3.png", "id": "1062208108646798", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982687_1062208115313464_8001165291027202430_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yns51Q-9GkYQ7kNvwH0Cxcv&_nc_oc=AdosS5Do3f2YpSpT2IKKvDT31rePSdr3i-a8_9jYZg3K6tzycCi9rc4XBRdemYZVo8k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70iHWfAl9_Nx99_ar4kWmLb8KzYYhXJ4YiDHO2zm7-sg&oe=6A01DFE0"}, {"file_name": "Pesquet_2560x1440_SCREENSHOT5.png", "id": "496646209647193", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974450_496646212980526_8980009219719461363_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LWTMAHWvuzwQ7kNvwHHxiQn&_nc_oc=AdoWE1-qjO7D-A1t7-_mX8E_C_M4RJYwCAB7ShO3L_Sgmbh7xZJ7xNn8pf4NOXyY1zc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5eQnN8s25Xycg7IbOWF0AvpSYQhGNZJGyYT2CHr9xBmw&oe=6A01CA27"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Being an Astronaut", "keywords": ["pesquet", "space", "film", "360"], "long_description": "**PART 1 - TRAINING**\n\nExperience the astronaut preparation tests alongside Thomas Pesquet: the centrifuge experience in Cologne, the exercise simulations in the Soyuz in Moscow or even diving into NASA's gigantic pool in Houston intended for spacewalk simulations.\n\n**PART 2 - THE MISSION**\n\nExperience the Soyuz rocket takeoff, the capsule docking with the space station and, thanks to the first images filmed in space in 360\u00b0, the daily life in zero gravity. They will admire the Earth from the Cupola before taking a spacewalk and an extraordinary journey into the cosmos.\n\n# CREDITS #\n- Directed by: Pierre-Emmanuel Le Goff and J\u00fcrgen Hansen\n- Nationality : French\n- \u200bGenre: Docu-Fiction\n- \u200bDuration: 15 min + 17 min / 22 min / 5 min\n- Production: La Vingt-Cinqui\u00e8me-Heure, Prospect TV and DV Group and France TV New Writings.\n\n\u200bWith the support of the Normandy Region and the Medienboard.\n\n\u200bIn partnership with ESA and NASA.", "short_description": "Discover Thomas Pesquet\u2019s adventure in space in two 360\u00b0 virtual reality 15 minutes films. Follow the French astronaut and American Peggy Whitson from their training on Earth all the way to spacewalk thanks to the first virtual reality images ever shot in space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.25eheure.com/thomaspesquetvr-confidentialite", "developer_terms_of_service_url": null, "publisher_name": "25eHeure", "support_website_url": null, "website_url": "https://www.25eheure.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "2687655338230691"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "fr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9005121362882289"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031508_879184400991457_3956335973008078823_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LVo8iEdhUWAQ7kNvwHx9nDA&_nc_oc=Ad
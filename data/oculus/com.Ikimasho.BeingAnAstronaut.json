.png", "id": "879184397658124", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031508_879184400991457_3956335973008078823_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LVo8iEdhUWAQ7kNvwGoPV2_&_nc_oc=AdqfUJuwJvrg6ymUxtv0kiCI3SNM4OS4R3BKjMuISXvO1wO9qsgzupBA49cIUWwu3KY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7lEbYy4ke7CqhSSdmi5_TaR9kkkqCF40hXgt0yoiRfbQ&oe=6A03247F"}, {"file_name": "Pesquet_1080x360_ENG.png", "id": "875318777440495", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031608_875318780773828_2284843673583641735_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tmM_VXvTcqEQ7kNvwG2xS5O&_nc_oc=Adr5AE95-2CykWw7oFq5x0RFXiVbrk0I_mWbnVrW7x1r7ensigHPt-ofuOhY6YxFhag&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4SMMq6vrekf2TdIkPMMBXs0doJADJnejWkUALo82bXCA&oe=6A03434E"}]}, "id": "583979444497089", "locale": "en_US", "screenshots": [{"file_name": "Pesquet_2560x1440_SCREENSHOT.png", "id": "732031702397160", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974450_732031705730493_5342781296539986497_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bnAO2kBWDMwQ7kNvwG2H8cb&_nc_oc=AdqHDJEzrQu1T870fqPAec1xLN-Bdxhdm5ZpalUWv418AWMbxklRchujDeQKZoMP5bU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5UC6AmqlTrQPL5-OZAMqb5wqtg3RlNbxjZ4SEZSQjZNA&oe=6A031906"}, {"file_name": "Pesquet_2560x1440_SCREENSHOT4.png", "id": "892024476110437", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974783_892024479443770_4791118796329511831_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mvJj4JeMHUgQ7kNvwE-fHcp&_nc_oc=AdresOQGTCigN_ejV0ydVmt5cVl47wVp3ixd3yvji-Wq25DEp8xgMa2uLHzoDcjq2hs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Lil2H08PhHqNB9-XR3yFR43yvBCnFoCZ0XJ3X-eCl5g&oe=6A031854"}, {"file_name": "Pesquet_2560x1440_SCREENSHOT2.png", "id": "1239004950628610", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974439_1239004953961943_2889293322071432452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CO7B48Ukyc4Q7kNvwHBYj3X&_nc_oc=Adr__ZG37Zj2VRTbigBX_ERKVtcnAAXnc-fWTRB38TsZjj1DcEeBY7jqEj0yNwDELLg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5rMie2s4H2s-f9xlJNOIGJ7UwNmkEb9n4Wb_zCILnT_w&oe=6A031DC5"}, {"file_name": "Pesquet_2560x1440_SCREENSHOT3.png", "id": "1062208108646798", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982687_1062208115313464_8001165291027202430_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yns51Q-9GkYQ7kNvwENc4Ra&_nc_oc=AdqkggELeWaGpg9nfOxf745BFC7oaeOGyglzSahDYWz2SbJ85gZqrjrdBtJLxpLVS_U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4p23u3uw785Kf_0TTank96APVVgY6R99RUB02ommSBHw&oe=6A033160"}, {"file_name": "Pesquet_2560x1440_SCREENSHOT5.png", "id": "496646209647193", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974450_496646212980526_8980009219719461363_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LWTMAHWvuzwQ7kNvwEg1U2W&_nc_oc=AdrxaTL7ZUONAFgMPsPLI2Y8lDdtIr1ZUGNc-Q3ulya90jns6gp4UM6eiKZ_doTw_Bk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61ww821IqVPFv2gkI3GKU3swdQ6ZVFi5hH4YzBpPxFRw&oe=6A031BA7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Being an Astronaut", "keywords": ["pesquet", "space", "film", "360"], "long_description": "**PART 1 - TRAINING**\n\nExperience the astronaut preparation tests alongside Thomas Pesquet: the centrifuge experience in Cologne, the exercise simulations in the Soyuz in Moscow or even diving into NASA's gigantic pool in Houston intended for spacewalk simulations.\n\n**PART 2 - THE MISSION**\n\nExperience the Soyuz rocket takeoff, the capsule docking with the space station and, thanks to the first images filmed in space in 360\u00b0, the daily life in zero gravity. They will admire the Earth from the Cupola before taking a spacewalk and an extraordinary journey into the cosmos.\n\n# CREDITS #\n- Directed by: Pierre-Emmanuel Le Goff and J\u00fcrgen Hansen\n- Nationality : French\n- \u200bGenre: Docu-Fiction\n- \u200bDuration: 15 min + 17 min / 22 min / 5 min\n- Production: La Vingt-Cinqui\u00e8me-Heure, Prospect TV and DV Group and France TV New Writings.\n\n\u200bWith the support of the Normandy Region and the Medienboard.\n\n\u200bIn partnership with ESA and NASA.", "short_description": "Discover Thomas Pesquet\u2019s adventure in space in two 360\u00b0 virtual reality 15 minutes films. Follow the French astronaut and American Peggy Whitson from their training on Earth all the way to spacewalk thanks to the first virtual reality images ever shot in space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.25eheure.com/thomaspesquetvr-confidentialite", "developer_terms_of_service_url": null, "publisher_name": "25eHeure", "support_website_url": null, "website_url": "https://www.25eheure.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "2687655338230691"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "fr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9005121362882289"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031508_879184400991457_3956335973008078823_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LVo8iEdhUWAQ7kNvwGoPV2_&_nc_oc=Ad
.png", "id": "879184397658124", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031508_879184400991457_3956335973008078823_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9zx9vs80VF4Q7kNvwEzr5Ec&_nc_oc=Adq8D9T0YbL3CfRYMhI7T7i5iD4YNv2-IB9f3Gi79iuWZSCIzUwFuVZ04aWUVC5pLoM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9IHKCWW8xQP47qj8hlV7eCJMtpPwP4ai6UxVotzMzoQg&oe=6A3148FF"}, {"file_name": "Pesquet_1080x360_ENG.png", "id": "875318777440495", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031608_875318780773828_2284843673583641735_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3_guM7GmLHcQ7kNvwGmEpy9&_nc_oc=AdpHxdnJobuSyOAeZ7fLJdidxfcWkOPiygy1CbXi_3vU1ollIlAbq4jJ7VZcvwBmRjk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9iDJ7KWkwfxxqi7GYZ2ZsmUrcqy3PcRK6PgumJuNabEA&oe=6A3167CE"}]}, "id": "583979444497089", "locale": "en_US", "screenshots": [{"file_name": "Pesquet_2560x1440_SCREENSHOT.png", "id": "732031702397160", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974450_732031705730493_5342781296539986497_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pcdhUsLGNjcQ7kNvwGzsite&_nc_oc=AdoONiqKbpr_tiptyiyDOimlGwUFx8KPjJwretb7sa3sz8wqqlZGGNhMa__gktJNF_c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8XQtzkbQwR5fxCV_vveogC8MRkUMbzYO6eEj-xyYlXEA&oe=6A3175C6"}, {"file_name": "Pesquet_2560x1440_SCREENSHOT4.png", "id": "892024476110437", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974783_892024479443770_4791118796329511831_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hag12E8uw-0Q7kNvwEOGxVp&_nc_oc=AdrSGoVtOtRJN2O3idFD9k7ZjNGntW0L0MwxxyD3-2KyRFglbWR40qjwLiQ9H_Czcu4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8M7EV9uZSUjbYjFDE4V14OjMTN4LGN9CGwvbxITSRamw&oe=6A317514"}, {"file_name": "Pesquet_2560x1440_SCREENSHOT2.png", "id": "1239004950628610", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974439_1239004953961943_2889293322071432452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vU8sIdODkUgQ7kNvwF1xx0Y&_nc_oc=Adqi6Nf2PBqWE3Q8bG6nJRAiTA2_FooP1iGe-X0CD5pHz8JM2impB5ymE7-sFtC3Rag&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Ca13zUoyAGgWKCKXHvEDvjJk4QG4U6CDo5UMAK754eg&oe=6A317A85"}, {"file_name": "Pesquet_2560x1440_SCREENSHOT3.png", "id": "1062208108646798", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982687_1062208115313464_8001165291027202430_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c8ny-heaBLIQ7kNvwFcsm-g&_nc_oc=AdrXF41MsqJyn9bJrl_vGtGbNch4KIOxTvVSrpRl78h0mFxXMGUjX5kJzLBrwyWE7TE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9SXKDdZ-aazxpYRpTJlFkuICp1uWla1aLZdP_AYRKg0Q&oe=6A3155E0"}, {"file_name": "Pesquet_2560x1440_SCREENSHOT5.png", "id": "496646209647193", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974450_496646212980526_8980009219719461363_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VLUUd_gtXewQ7kNvwFlIoTh&_nc_oc=AdoID9fCYWOkeY1G_MOzRWtwZMlW-8IkaUYjNgc6FBP7Ai7bmhvwsiC7Mo8RDw8OEIQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93tq6RfJkSnaG23X7VMYUJkJAuLmX8QTLR7VLpcXKa6g&oe=6A317867"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Being an Astronaut", "keywords": ["pesquet", "space", "film", "360"], "long_description": "**PART 1 - TRAINING**\n\nExperience the astronaut preparation tests alongside Thomas Pesquet: the centrifuge experience in Cologne, the exercise simulations in the Soyuz in Moscow or even diving into NASA's gigantic pool in Houston intended for spacewalk simulations.\n\n**PART 2 - THE MISSION**\n\nExperience the Soyuz rocket takeoff, the capsule docking with the space station and, thanks to the first images filmed in space in 360\u00b0, the daily life in zero gravity. They will admire the Earth from the Cupola before taking a spacewalk and an extraordinary journey into the cosmos.\n\n# CREDITS #\n- Directed by: Pierre-Emmanuel Le Goff and J\u00fcrgen Hansen\n- Nationality : French\n- \u200bGenre: Docu-Fiction\n- \u200bDuration: 15 min + 17 min / 22 min / 5 min\n- Production: La Vingt-Cinqui\u00e8me-Heure, Prospect TV and DV Group and France TV New Writings.\n\n\u200bWith the support of the Normandy Region and the Medienboard.\n\n\u200bIn partnership with ESA and NASA.", "short_description": "Discover Thomas Pesquet\u2019s adventure in space in two 360\u00b0 virtual reality 15 minutes films. Follow the French astronaut and American Peggy Whitson from their training on Earth all the way to spacewalk thanks to the first virtual reality images ever shot in space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.25eheure.com/thomaspesquetvr-confidentialite", "developer_terms_of_service_url": null, "publisher_name": "25eHeure", "support_website_url": null, "website_url": "https://www.25eheure.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "2687655338230691"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "fr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9005121362882289"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031508_879184400991457_3956335973008078823_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9zx9vs80VF4Q7kNvwEzr5Ec&_nc_oc=Ad
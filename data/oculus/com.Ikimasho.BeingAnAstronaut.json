.png", "id": "879184397658124", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031508_879184400991457_3956335973008078823_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jfdF-9TV6MsQ7kNvwGqsn-D&_nc_oc=AdrSXiFAjKaSUErYxY7KEw7KJxqJBoaIGOAHLGa3psNtLqI11mNqtpsCQCoUrt-4q28&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDWYCwM0NneBSu3EknKYgTE5hGXmJri2mpOXpl580WJvQ&oe=6A54E17F"}, {"file_name": "Pesquet_1080x360_ENG.png", "id": "875318777440495", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031608_875318780773828_2284843673583641735_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mlpzg7dkGEYQ7kNvwEbsd_W&_nc_oc=Adq04kc0xYg0HOhwd4gH3ad2Ar-o7cK-reP7obURdgRZBA-cVCYr8iW8vqRWFig3V9Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCN67DuW9Eozmjgj0SlTpxrKvttn9JKe5tmNbk7TlpAaw&oe=6A55004E"}]}, "id": "583979444497089", "locale": "en_US", "screenshots": [{"file_name": "Pesquet_2560x1440_SCREENSHOT.png", "id": "732031702397160", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974450_732031705730493_5342781296539986497_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=khLUfEB65D4Q7kNvwH94n6n&_nc_oc=Adpglv7HDopUr86YkyQl2Y5cXRVXBuXEF3k00hId-NbaY6gVLDXjR-lQXYMgVEVhEMg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBqLkQcpV0x3Rck3IgMdmOPk11eJTW1AJqWgiCmtIi7Dg&oe=6A54D606"}, {"file_name": "Pesquet_2560x1440_SCREENSHOT4.png", "id": "892024476110437", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974783_892024479443770_4791118796329511831_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Tirm16TSC0Q7kNvwFXNQjD&_nc_oc=AdqGUiWXkoyMupOHVLMPyctnSa02auGMSIYD5L60NXOXxxhXfFg9XTNOvITGVKRdj-4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBWUmniEG3Y3I1A74H3NOryZ2ju3vErAf5HtnRsL4KTcg&oe=6A54D554"}, {"file_name": "Pesquet_2560x1440_SCREENSHOT2.png", "id": "1239004950628610", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974439_1239004953961943_2889293322071432452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xN8rfr6CRF8Q7kNvwHsFdwa&_nc_oc=AdpVGJbS4lR9xU1I3TDyyd3C_RvNoeAvMPnoa4K__-JwEDc2Ntsbkz25qvWLZKnlh0c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZweGzTnMeeEciHbpCpIsVj-hctLuPVNCUvqXHxDMUlg&oe=6A54DAC5"}, {"file_name": "Pesquet_2560x1440_SCREENSHOT3.png", "id": "1062208108646798", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982687_1062208115313464_8001165291027202430_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mxfx-CXS6PkQ7kNvwFbA12j&_nc_oc=AdqvPS4MWMFOlKzIeVmkAcligXuejpQEoVrmw5spw5JL1-_r93kB8cSNPf4q0yZtkgI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDFwEXR9X80NoTo2dUpjOB0vtpb_QfaPbZXRe-wq8UKsw&oe=6A54EE60"}, {"file_name": "Pesquet_2560x1440_SCREENSHOT5.png", "id": "496646209647193", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974450_496646212980526_8980009219719461363_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XuegC7ixgGUQ7kNvwGfyec0&_nc_oc=AdoTepGZeWjL--SjXPP-E1748Uz-4LHc6HIM0rp1BsbGj7141oQ7XcewZz7U3gQXhww&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD2ocOl0NcM_WsE58G1XuBkmS5Y_BP7Iw3uMZLF-B8-vA&oe=6A54D8A7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Being an Astronaut", "keywords": ["pesquet", "space", "film", "360"], "long_description": "**PART 1 - TRAINING**\n\nExperience the astronaut preparation tests alongside Thomas Pesquet: the centrifuge experience in Cologne, the exercise simulations in the Soyuz in Moscow or even diving into NASA's gigantic pool in Houston intended for spacewalk simulations.\n\n**PART 2 - THE MISSION**\n\nExperience the Soyuz rocket takeoff, the capsule docking with the space station and, thanks to the first images filmed in space in 360\u00b0, the daily life in zero gravity. They will admire the Earth from the Cupola before taking a spacewalk and an extraordinary journey into the cosmos.\n\n# CREDITS #\n- Directed by: Pierre-Emmanuel Le Goff and J\u00fcrgen Hansen\n- Nationality : French\n- \u200bGenre: Docu-Fiction\n- \u200bDuration: 15 min + 17 min / 22 min / 5 min\n- Production: La Vingt-Cinqui\u00e8me-Heure, Prospect TV and DV Group and France TV New Writings.\n\n\u200bWith the support of the Normandy Region and the Medienboard.\n\n\u200bIn partnership with ESA and NASA.", "short_description": "Discover Thomas Pesquet\u2019s adventure in space in two 360\u00b0 virtual reality 15 minutes films. Follow the French astronaut and American Peggy Whitson from their training on Earth all the way to spacewalk thanks to the first virtual reality images ever shot in space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.25eheure.com/thomaspesquetvr-confidentialite", "developer_terms_of_service_url": null, "publisher_name": "25eHeure", "support_website_url": null, "website_url": "https://www.25eheure.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "2687655338230691"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "fr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9005121362882289"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031508_879184400991457_3956335973008078823_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jfdF-9TV6MsQ7kNvwGqsn-D&_nc_oc=Ad
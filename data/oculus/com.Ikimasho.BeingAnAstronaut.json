s://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974439_1239004953961943_2889293322071432452_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Agcnlb4eYv4Q7kNvwHkSBlL&_nc_oc=Adr2Yv0j9ZCxhCj3X1eutgTRhQJiezAXIEs6axOeYeWGV43odh9jHdsmRkduCR6ZW44&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDlsogl66R-8gu6tHsHaNuoal-D2wUiBpjnmthRxWen5w&oe=6A6DE745"}, {"file_name": "Pesquet_2560x1440_SCREENSHOT3.png", "id": "1062208108646798", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982687_1062208115313464_8001165291027202430_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tumXvPAAUcwQ7kNvwEH7RzC&_nc_oc=AdpC_xFCJYXaqCMD5vJJm_TEGU8aOONo_pJywSAPAJCOsn1VY77nwNTizboSu6LO8OQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQACagBlUKZltkNfyczGnvIB6j22sUlCVTSzobMChr0K5Q&oe=6A6DFAE0"}, {"file_name": "Pesquet_2560x1440_SCREENSHOT5.png", "id": "496646209647193", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974450_496646212980526_8980009219719461363_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7TLYNX43io8Q7kNvwGa5sch&_nc_oc=AdpS5enNjo62jAVmByt5qJ6_6KR0nCe9Uhlm8X_qa5IOVelVWGgqiUnm62lQSu8-8N8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAt8_S9mMmHaynRqI0qfTVPFTK9f9jpIOS4-UrEDFRsNQ&oe=6A6DE527"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Being an Astronaut", "keywords": ["pesquet", "space", "film", "360"], "long_description": "**PART 1 - TRAINING**\n\nExperience the astronaut preparation tests alongside Thomas Pesquet: the centrifuge experience in Cologne, the exercise simulations in the Soyuz in Moscow or even diving into NASA's gigantic pool in Houston intended for spacewalk simulations.\n\n**PART 2 - THE MISSION**\n\nExperience the Soyuz rocket takeoff, the capsule docking with the space station and, thanks to the first images filmed in space in 360\u00b0, the daily life in zero gravity. They will admire the Earth from the Cupola before taking a spacewalk and an extraordinary journey into the cosmos.\n\n# CREDITS #\n- Directed by: Pierre-Emmanuel Le Goff and J\u00fcrgen Hansen\n- Nationality : French\n- \u200bGenre: Docu-Fiction\n- \u200bDuration: 15 min + 17 min / 22 min / 5 min\n- Production: La Vingt-Cinqui\u00e8me-Heure, Prospect TV and DV Group and France TV New Writings.\n\n\u200bWith the support of the Normandy Region and the Medienboard.\n\n\u200bIn partnership with ESA and NASA.", "short_description": "Discover Thomas Pesquet\u2019s adventure in space in two 360\u00b0 virtual reality 15 minutes films. Follow the French astronaut and American Peggy Whitson from their training on Earth all the way to spacewalk thanks to the first virtual reality images ever shot in space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.25eheure.com/thomaspesquetvr-confidentialite", "developer_terms_of_service_url": null, "publisher_name": "25eHeure", "support_website_url": null, "website_url": "https://www.25eheure.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "2687655338230691"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "fr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9005121362882289"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031508_879184400991457_3956335973008078823_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y5Gazvu74p8Q7kNvwGEHpV2&_nc_oc=Ad
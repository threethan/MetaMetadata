99965301691", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312306_1077699968635024_7907328851816414206_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=83p6uCp5FBsQ7kNvwFnL-nu&_nc_oc=AdpyZOCqk91INJwzBNSAXMQ6b8-EN22Xdc7QsXSsEmj-bU8OWm3kNlna0eSbhuAUBVI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhPRmdA0Zrv64Q0tFpfR9KDhZ7cwjZnPGlMOcMvPLTVA&oe=6B072369"}, {"file_name": "quest_screenshot_4.png", "id": "1439569657762647", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830904_1439569661095980_3163792598607838745_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=psSHF4s7Bp8Q7kNvwGgZh6y&_nc_oc=Adp4x_sCQT4cn8LUZhdVwPPTKKBEk0lgoWGPDgYMNB_Rn73oa3EaFDm1TGnVir0RHug&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2GEIKHYT5s22cqPIVOMGSgjQcE1m6Ev0KN5xAblQExg&oe=6B0703BA"}, {"file_name": "quest_screenshot_3.png", "id": "1653140659784826", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312267_1653140663118159_6943126906707515921_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4koI_ziavYAQ7kNvwEKtQjR&_nc_oc=AdptRnt0frHX5I6B_mhIqEZlpnsrSZ7eDVtiTe6rOiRtaJyIXnJK8255TBtamzzXL_4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRl56oVaHrZvJTNmi6cXkTd3qxQSKpFwn-LxpHxoWKEkA&oe=6B070100"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "1129929283268766", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/604317775_1129929289935432_5338757029302048496_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aRwXwCLsF1kQ7kNvwFtu1gG&_nc_oc=Adpx7lUu1BP_dPcxa3qw5TnVzTTSysbauYw19MR4O8NReWp9LpL3erfIoVU4f0a9nrw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHhGf2staULpDe5zhXHqaO8Q6uXrob_R5N6_8ZHM1mhQ&oe=6B07054C"}, "display_name": "HandymanAI", "keywords": ["training", "electrician", "hvac", "plumbing", "handyman"], "long_description": "HandymanAI brings trade training and an AI assistant into your space. Panels float over your room in passthrough, so you can learn and ask questions while you look at the real equipment.\n\nTraining\n\u2022 22 lessons across electrical, HVAC, plumbing and cleaning, with quizzes.\n\u2022 Turn 3D equipment in front of you: a pole-mount transformer, a substation, an outdoor heat pump, a gas furnace, a water heater, a conduit bend and a P-trap.\n\u2022 Calculators for conduit bends, drain slope, superheat, duct sizing and water heater sizing.\n\u2022 Voltmeter and Restroom & Kitchen Sanitation are free for everyone.\n\nAsk Bob\n\u2022 Ask by voice about repairs, troubleshooting and code references.\n\u2022 Point the headset camera at something and ask what you're looking at.\n\u2022 Report an issue with notes and photos.\n\nAlready use HandymanAI on your phone?\nChoose \"Sign in with your phone\", then enter the 6-digit code on your phone under Account \u2192 Link a headset. The headset uses the same account, so your Elite plan and training access carry over.\n\nWorks in English, Spanish, French, German, Italian, Portuguese, Japanese and Chinese.\n\nSafety: HandymanAI gives AI-generated guidance that can be wrong. Check it against local codes and manufacturer instructions, and use a licensed professional for hazardous or regulated work.", "short_description": "Learn electrical, HVAC, plumbing and cleaning with 3D equipment, and ask Bob, your AI trade assistant, anything while you work."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.my.canva.site/privacy-policy-for-handymanai", "developer_terms_of_service_url": "https://artisanreality.com/terms", "publisher_name": "Artisan Reality", "support_website_url": null, "website_url": "https://handymanai.ai/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "conte
467_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PA83Enb9ZugQ7kNvwEIYGsW&_nc_oc=Ado415tKfUzMOZAcvAKN8FQSLor4zN-nmDkl_OFAiGDen4acLMzwjLhRWRd9ymJXWsU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLaMNuM0KvcNZTkBcYd1vhL5-H5_f5KwH9fnWa2vwb00g&oe=6A9EAF95"}, {"file_name": "Screenshot4FIX.png", "id": "1369860934216429", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391798_1369860937549762_4902722443043180840_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hti7EFbhNx0Q7kNvwGm4NdU&_nc_oc=AdrDu4dJ8ws7YYtho8WlBMQmEdMcYTAAiKVBGHAWg_nvXU8Ugf26HJs4wbdvPQYAMo8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLIz-1KxeP4XDye7ivjiIc2rNnToOSaOh0PVYOO8kH4PA&oe=6A9ED6A9"}, {"file_name": "Screenshot5FIX.png", "id": "1445710466398959", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391817_1445710473065625_29208629481560585_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7SkKCSI2YGgQ7kNvwEhVI7U&_nc_oc=Adro-NoXUei2vBYo2IxC4icNwcNekPyM7aVmDKa89mWMS_zYcSA7Zv5qX_R_DvtLGOE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKny5mOhKiKqJJxVeTQbjWzzZXJpF1VB8liB_Z-Z45Oaw&oe=6A9ED811"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Roxy!", "keywords": [], "long_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget traditional locomotion\u2014utilizing the Gorilla Movement System, you'll glide, climb, and race through serene landscapes with the grace and agility of a tag master. Whether you're chasing or finding inner peace, this is an experience like no other, combining mindful tag gameplay with an immersive style of movement.", "short_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget
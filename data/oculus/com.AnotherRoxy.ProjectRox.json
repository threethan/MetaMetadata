467_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kq4IM7a851IQ7kNvwGIbIO0&_nc_oc=AdpCfAJ6PbhvNtR7qwl4CufIoWEtqx3IcWabWOKhiebHje3LpwDyznGygCSItUUzHm8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQobY7N3ffLjkcEe3bX1zFAOb7tidaacTey8H9p7uioqg&oe=6AE8BBD5"}, {"file_name": "Screenshot4FIX.png", "id": "1369860934216429", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391798_1369860937549762_4902722443043180840_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=26uFweqJCv8Q7kNvwErB9ZC&_nc_oc=AdpA19G0gYqpKJ6A6WNPBV1S9DxX3E4hj15BciJkAs3miY0Axi8W3viv0vvyLSMoHlw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZb2c4wYPsfoDhnfe56B0iFWfXZNIw47qJ7ovlvWE_jw&oe=6AE8AAA9"}, {"file_name": "Screenshot5FIX.png", "id": "1445710466398959", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391817_1445710473065625_29208629481560585_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=70ibnfOTekQQ7kNvwG7Y1ZK&_nc_oc=AdongAVlj4RiJYYNJtSG9_l_Tdv3eP_-79FY5WQm7U10DVyH63K5h1x8BeophetGB-U&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjfjkP-0DLKjDbyc30BcbRKDITGSZjGs5QYxdoYQQ1Og&oe=6AE8AC11"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Roxy!", "keywords": [], "long_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget traditional locomotion\u2014utilizing the Gorilla Movement System, you'll glide, climb, and race through serene landscapes with the grace and agility of a tag master. Whether you're chasing or finding inner peace, this is an experience like no other, combining mindful tag gameplay with an immersive style of movement.", "short_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget
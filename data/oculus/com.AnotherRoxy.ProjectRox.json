467_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5j9jFaO76EsQ7kNvwFWjGWR&_nc_oc=AdrhdO2C-1AOIDlXL2ibUKVcBh6mvI8VfOt3STWeF3j__bhlJxUTJoFwKv4sdON6DEY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDNEC9DlAJs-T8iv3vW-8zusgqSE7GkxDgPJC0V5hQLMg&oe=6A58D015"}, {"file_name": "Screenshot4FIX.png", "id": "1369860934216429", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391798_1369860937549762_4902722443043180840_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=93ElLJSSFdoQ7kNvwHt1EYQ&_nc_oc=Adp9msaJbz4ULAJU5V3WdqJoNyjBgr03_BlF3vgllAVGmLMhPwgwbpNPDYV7rJHedCk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4j6uVl4ZiTqKTwQrNbHdN1Q0ZcQ6PZ0mdJe8ZIUweHg&oe=6A58F729"}, {"file_name": "Screenshot5FIX.png", "id": "1445710466398959", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473391817_1445710473065625_29208629481560585_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k5XR4qA6jnsQ7kNvwH8lFUg&_nc_oc=AdrDo3soNCQtygJLbfNBcXDmIRXIzyb40DE_nY4_68lssn81G4dsV3EDSbS_wfTb80M&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAjPtKLGlxYqbnBe425-4Jjxar4iya0JajAJNsueHdr0w&oe=6A58F891"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Roxy!", "keywords": [], "long_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget traditional locomotion\u2014utilizing the Gorilla Movement System, you'll glide, climb, and race through serene landscapes with the grace and agility of a tag master. Whether you're chasing or finding inner peace, this is an experience like no other, combining mindful tag gameplay with an immersive style of movement.", "short_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget traditional locomotion\u2014utilizing the Gorilla Movement System, you'll glide, climb, and race through serene landscapes with the grace and agility of a tag master. Whether you're chasing or finding inner peace, this is an experience like no other, combining mindful tag gameplay with an immersive style of movement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacypolicyprojectroxy", "developer_terms_of_service_url": null, "publisher_name": "SplashVRxRoxy132", "support_website_url": null, "website_url": "https://sites.google.com/view/projectroxyfrr", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "29205368785774822"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473393608_1447875643285615_4970143688525545979_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d7A9mlRcwlUQ7kNvwExnD04&_nc_oc=AdpSod2FsyIHDp6Shp4Yfs37SZM46GNXvBq9cgsfyBKsJrsGUxUxSS6dQZiWlShHJ00&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCXQJg941mayaYjzbZu3OV-V-DOZkgerNKUkRYFFioKFg&oe=6A58F54D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Project Roxy!", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "45978150496848
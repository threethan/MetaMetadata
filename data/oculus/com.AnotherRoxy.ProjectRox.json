467_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fz_9WJWT6hsQ7kNvwEz877B&_nc_oc=AdoBPrgEvpFW2xbGgx_2zGFjVSDWaYaX-G1-5Sz8o2LjDqF-uFCgKCTALkkvteWc0Vc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-XhhR-LgYw43XpcXx11Zcth1nRltXtC0ASmiW84PXGA&oe=69FF2A15"}, {"file_name": "Screenshot4FIX.png", "id": "1369860934216429", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391798_1369860937549762_4902722443043180840_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=03kUISvb-f8Q7kNvwHQFu79&_nc_oc=Adqale5WcGg4J2P1T9XNT4wsMmYRXU2QFUllzmC4Z6ert4bvaXlPLYnSDCPZW6RfsS8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af67fdKdVjnXOgaA_vOgpNIByXVMKjuNOnfmk4RWdG4iqQ&oe=69FF5129"}, {"file_name": "Screenshot5FIX.png", "id": "1445710466398959", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391817_1445710473065625_29208629481560585_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xA9GpNrVaV0Q7kNvwH_ePeB&_nc_oc=AdoH5VxUpMi7DMRCfGh1gYIgDlILZXcLkI8aV2062KdIUy2eZoEzp-uGIdN46Sxkvgo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4vdBdAcDRWCnRZEnDRFEfSniD4cFEhA1diIS6QBeZKpQ&oe=69FF5291"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Roxy!", "keywords": [], "long_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget traditional locomotion\u2014utilizing the Gorilla Movement System, you'll glide, climb, and race through serene landscapes with the grace and agility of a tag master. Whether you're chasing or finding inner peace, this is an experience like no other, combining mindful tag gameplay with an immersive style of movement.", "short_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget
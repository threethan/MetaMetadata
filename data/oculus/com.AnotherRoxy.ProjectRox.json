467_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XeD0hUHEfqsQ7kNvwGfkUAr&_nc_oc=AdpkC2DpNa1xxQeuemLSXjM1feI_20OtNDBDxsGkLJhNqyky4rJtXSkxnHEkLTwXrEM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPvnTW4oOGnWYnIdZT0G9RQtvTPzMGPXxrXVJFfdi-_-Q&oe=6AE09A95"}, {"file_name": "Screenshot4FIX.png", "id": "1369860934216429", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391798_1369860937549762_4902722443043180840_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-gVHwGvUjJEQ7kNvwEo-Cjx&_nc_oc=AdopxvTU5wO9yvcrJQZOEXui58LRCvuZGpmfG7XNtOe00Z3FWk01c8_Y9OTkKW8-PK0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP97HITdmKOC2lF0Bt2Sx0_dwn4jY5AM8qvurU4Q8yQMQ&oe=6AE0C1A9"}, {"file_name": "Screenshot5FIX.png", "id": "1445710466398959", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391817_1445710473065625_29208629481560585_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QDndvlD5aiUQ7kNvwGN5_eD&_nc_oc=AdrMNYPypm52tNj52-_y_HzBNpXR2Y249Hqfj743FWvq8izsYPSFyeAwzRMTIB2e7-0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMfKVdXub3MbxpomjND11J8GLGZWqlsFpUH72lfai4ljg&oe=6AE0C311"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Roxy!", "keywords": [], "long_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget traditional locomotion\u2014utilizing the Gorilla Movement System, you'll glide, climb, and race through serene landscapes with the grace and agility of a tag master. Whether you're chasing or finding inner peace, this is an experience like no other, combining mindful tag gameplay with an immersive style of movement.", "short_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget
467_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=72COZQ5Hfz8Q7kNvwHCheMf&_nc_oc=AdpeJ1Muvac5LoMFtCOikkCfiUelE4zQtPtfmHH_3f7_Htqd7OuH3g6VQkMh2v_hf48&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxGGBoxhO7vrPkeb6pLIAXJzbCp405ZShXhAzRa6LUbg&oe=6AD3A3D5"}, {"file_name": "Screenshot4FIX.png", "id": "1369860934216429", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391798_1369860937549762_4902722443043180840_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RJ-WBnr6lqAQ7kNvwFKXyEo&_nc_oc=AdruEbOf2kV7obeiTYVk5qjrs3HKD845m3h17JzjuKtmpNwSVWu-oAnJT1fAD_aeX9E&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3CR8j00fmUXkd9M9UeIdRfE_iCZtbqtmkDV3dVl6DhQ&oe=6AD392A9"}, {"file_name": "Screenshot5FIX.png", "id": "1445710466398959", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391817_1445710473065625_29208629481560585_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aDzMiU45RiEQ7kNvwFHsFIy&_nc_oc=AdrIVnwfkt0FaFQZ-ao7s5xGymRx1Mp5plm3Rhijv3nadebG18rIYXz-Exl3IKWyZds&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKcGMqA6zIAEinFLGXyYc5pQNkY5KSprBo8doGJWEIdw&oe=6AD39411"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Roxy!", "keywords": [], "long_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget traditional locomotion\u2014utilizing the Gorilla Movement System, you'll glide, climb, and race through serene landscapes with the grace and agility of a tag master. Whether you're chasing or finding inner peace, this is an experience like no other, combining mindful tag gameplay with an immersive style of movement.", "short_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget
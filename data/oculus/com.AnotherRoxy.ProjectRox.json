467_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jR1SQMl5_cwQ7kNvwErlpMy&_nc_oc=AdqO3KkHZeEQy0LxUacDffKfc4CAkl07wpHxM_jUROg1pUMw5u8hUALZ2M3se-x9hd0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5imuVrVp0MfFLrgcBZjYUdlM-tQeTkKHyFp6uBXXHqw&oe=6A86F495"}, {"file_name": "Screenshot4FIX.png", "id": "1369860934216429", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391798_1369860937549762_4902722443043180840_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Zm-k-9_rwAQ7kNvwE-rktO&_nc_oc=AdoxiH8dyY0OKzbuFEJKmsZGEefZdolzyLxRioA719B0IoytWcJkEB-dOKljsvMcw1Q&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhMlrHGg-I9B59P1ufOl7OV9cQj5ibuKljFrXeArmLgw&oe=6A86E369"}, {"file_name": "Screenshot5FIX.png", "id": "1445710466398959", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391817_1445710473065625_29208629481560585_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mP1aeHrP3KAQ7kNvwGcpLc3&_nc_oc=Adp93p8AHftPGNA8Q5o12z-imhN8ig-IN8xCvC-i96eyiUqOHOxU66T3j1yUXaKZoRU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGyHRsi1H9BJxyhG5yBJXzYdt2YfYfbI48brlA16T3m0Q&oe=6A86E4D1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Roxy!", "keywords": [], "long_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget traditional locomotion\u2014utilizing the Gorilla Movement System, you'll glide, climb, and race through serene landscapes with the grace and agility of a tag master. Whether you're chasing or finding inner peace, this is an experience like no other, combining mindful tag gameplay with an immersive style of movement.", "short_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget
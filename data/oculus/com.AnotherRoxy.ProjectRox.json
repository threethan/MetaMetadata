467_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SkD1nsgo50MQ7kNvwFH_XcH&_nc_oc=AdrhY_csUaT8U3yNAujwK0cGtiJb9CkitsYNnMIm7mWim6yNbjTRL0At3w7d7NHSTEA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIU_kHxgXB9cgjxvouX9Fv_hYcd8xKuirEZSGDI36N9sg&oe=6AB12495"}, {"file_name": "Screenshot4FIX.png", "id": "1369860934216429", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391798_1369860937549762_4902722443043180840_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UFUK-wrFrXoQ7kNvwEXMorV&_nc_oc=AdqO6nbQxutMmDrvseeLFBhRsOGWCA51mT0LyCwIMKD0UfsM2dh9Ea0x3OXUejpH4wU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKU69C_Qp83d6ELao0VopcU2e7Z7u6IKDME1n1pVlMEiw&oe=6AB14BA9"}, {"file_name": "Screenshot5FIX.png", "id": "1445710466398959", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391817_1445710473065625_29208629481560585_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2m3Rerm7DDMQ7kNvwGI9Dhc&_nc_oc=AdobardY_FO82RAaK4fNF3o7o3ybMfQktb1F1J2yIQas1a090KdISX23HhKf7w3BXJg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGUxqN79ElMYzsVymrmDiPMXWt-2i26IFuYzq3BCn6zw&oe=6AB14D11"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Roxy!", "keywords": [], "long_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget traditional locomotion\u2014utilizing the Gorilla Movement System, you'll glide, climb, and race through serene landscapes with the grace and agility of a tag master. Whether you're chasing or finding inner peace, this is an experience like no other, combining mindful tag gameplay with an immersive style of movement.", "short_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget
467_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bxIaEe0MYI0Q7kNvwEt1Qwt&_nc_oc=Adru6Hk2ABSfShL2n5D-flGu9gaH81BxjkCwF-NCjUCOqX3VXMqkNuOhMs8OO4Kg7I8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Il-LF8yYvti6EK04L5q2ytvZQHDtklN5vQgnMvNP0UA&oe=69DF8615"}, {"file_name": "Screenshot4FIX.png", "id": "1369860934216429", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391798_1369860937549762_4902722443043180840_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fOASk9SqJNQQ7kNvwEa1Eod&_nc_oc=AdqmBG0Je2hYgAWqBdd5kM9zaJNGKjTn-kVwHaGNJGe_qdAdZrJO5VgMad79uoKe8Ww&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2xeAv18gGJiSfvqW6cP4KFmZ8c-EJK7zolFljnepY9pA&oe=69DF74E9"}, {"file_name": "Screenshot5FIX.png", "id": "1445710466398959", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391817_1445710473065625_29208629481560585_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H8GVyAaYl_IQ7kNvwEZQclc&_nc_oc=Adryspd3n7Wd1E1mBm6_LPxTGoZ7FLM2g6IPQIo1ENImMRHMvtzqwUvBIhYVKlw3jro&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2iVWtWNLmZ0rGabPwFBYewhY1C32kWtqYN1c9b3FAg0A&oe=69DF7651"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Roxy!", "keywords": [], "long_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget traditional locomotion\u2014utilizing the Gorilla Movement System, you'll glide, climb, and race through serene landscapes with the grace and agility of a tag master. Whether you're chasing or finding inner peace, this is an experience like no other, combining mindful tag gameplay with an immersive style of movement.", "short_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget
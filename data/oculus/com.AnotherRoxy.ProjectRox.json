467_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XD-OX3CW8k0Q7kNvwEitMts&_nc_oc=AdrMuClGqSwSPzkV7Ey8lrUDL9WfDQNvTYHNYKux_tH4Q2U7_JS9btTijTP6fUaVI7Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_PtGUhUs9qf5ofNE30z5mupTWPWZ6R11RnLr9gYGyDEQ&oe=6A3BCF15"}, {"file_name": "Screenshot4FIX.png", "id": "1369860934216429", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391798_1369860937549762_4902722443043180840_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ho9uQoruxWUQ7kNvwGF-0PC&_nc_oc=AdoEIS0_Spy_sIlvEMAwEXS0MNnstVb9JfsrYK3NKwWJsceNi9kqDSX1dhHPe6XlPxo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_L6RJc2Ex_oIryaZxFYY5ca74qT3xwrccUek3s7PV4fg&oe=6A3BF629"}, {"file_name": "Screenshot5FIX.png", "id": "1445710466398959", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391817_1445710473065625_29208629481560585_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wbkq_T8sdZUQ7kNvwGOWA1q&_nc_oc=AdqeqwZHTmCg-499p9O261zlQNpS9KEh1UpU6JxE8yFjUvWe6gygNqemZFB6TIQIm10&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Vm302qiD4ws5HunZlCbiOtx5gjcSoSjv2yaqYcXC8Wg&oe=6A3BF791"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Roxy!", "keywords": [], "long_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget traditional locomotion\u2014utilizing the Gorilla Movement System, you'll glide, climb, and race through serene landscapes with the grace and agility of a tag master. Whether you're chasing or finding inner peace, this is an experience like no other, combining mindful tag gameplay with an immersive style of movement.", "short_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget
467_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=klV3HwiKhLEQ7kNvwFM2Qgj&_nc_oc=Adq_q_aU7TXHWlP6a1wzXt994nrfUdSBe2RMRhoeNGXTTTcmePAJY77b3UWCfVj8KsM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3YpUA5AMNriIE8SMV3J3cYVEKg2tvvl-rxMwgNzu_iQ&oe=6A92D215"}, {"file_name": "Screenshot4FIX.png", "id": "1369860934216429", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391798_1369860937549762_4902722443043180840_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KZVByq_gZHoQ7kNvwF7S50m&_nc_oc=AdrGeL9WMYj0Izdw55Awd-uNJmLwHVwLU-Cq0Qz1rGV1ztl0sECxBC6UReQmoDZpSgw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhciqIatHwdDhgDUB0A2Yl-QagcB8aBlHWmZgEM1cJvA&oe=6A92C0E9"}, {"file_name": "Screenshot5FIX.png", "id": "1445710466398959", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391817_1445710473065625_29208629481560585_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PGcbfrAZe98Q7kNvwF-GMSi&_nc_oc=AdqV5Wgj7QinazNg2YzXzAKQ4rOyG3lrC2ysL-v62nmObTRVfvTitoMdakGPGqkkGRo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFtC7pUA3PhSHhB-XKP5ngT0OuxrhV4R4S7wsptC8SY9g&oe=6A92C251"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Roxy!", "keywords": [], "long_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget traditional locomotion\u2014utilizing the Gorilla Movement System, you'll glide, climb, and race through serene landscapes with the grace and agility of a tag master. Whether you're chasing or finding inner peace, this is an experience like no other, combining mindful tag gameplay with an immersive style of movement.", "short_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget
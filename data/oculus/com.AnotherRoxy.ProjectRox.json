467_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zCYfj3CzRq8Q7kNvwHvQHuY&_nc_oc=AdqVy9P-oCTfyFKpqTiNMvQFmr8mGU8eNiZYQ25fqDufG49cFDnoiw7aRUkTH3pGVLc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLIIm8c9N6-V4rtFZ-CHVTzezPQxmAdgH6CTuu2XVplEg&oe=6ABA5F15"}, {"file_name": "Screenshot4FIX.png", "id": "1369860934216429", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391798_1369860937549762_4902722443043180840_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6hfkjQqbspcQ7kNvwGVzExI&_nc_oc=AdoO2eP881-15lxqGIOpha13CjuHE0t60WCRUSTXv9sC4Vhdg_EXt_5U_eSRIw7nxEM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6Z20dkwzu16-__GCqtg0SLxFF6GpwGgIwMtLq_MiQ4Q&oe=6ABA8629"}, {"file_name": "Screenshot5FIX.png", "id": "1445710466398959", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391817_1445710473065625_29208629481560585_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=exHVmh4AATEQ7kNvwGHiyiL&_nc_oc=Adpg2qQiSoGxt7yxaVFAldce-eP7T37xGG6oKapchjp196CnLdZ_BeKJJiz2PpaUVMs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-1eqO3psj5rU8lbkSBPuwx-jPogvQYlX4PU1g4CNg2A&oe=6ABA8791"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Roxy!", "keywords": [], "long_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget traditional locomotion\u2014utilizing the Gorilla Movement System, you'll glide, climb, and race through serene landscapes with the grace and agility of a tag master. Whether you're chasing or finding inner peace, this is an experience like no other, combining mindful tag gameplay with an immersive style of movement.", "short_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget
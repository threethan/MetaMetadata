467_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sqPtxeeuPOoQ7kNvwHsRW9R&_nc_oc=Adq3paavnMu5ONzZbAK028tMsamWGnMMOC8JGGTSRqqE5rzYkCfeFUEfJhMdma8THXc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHb95BA_K57XGFZhWks-kKdZA4MhHpIj4zs3KT5IzC1ig&oe=6A708B15"}, {"file_name": "Screenshot4FIX.png", "id": "1369860934216429", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391798_1369860937549762_4902722443043180840_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Rpm2ONuzcQQ7kNvwHU6-8X&_nc_oc=AdrBrmTqM5lI-YrhpfpJJOoqbmAajyf0FypVFq0mcOmKV4TiqhGjzO8gJKg_AZRQa3U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYrZaiCg8Bu5n4RZ5-4S1U0ad1CQTPymNsqJCEwUN0xw&oe=6A7079E9"}, {"file_name": "Screenshot5FIX.png", "id": "1445710466398959", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391817_1445710473065625_29208629481560585_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H6o-wRRfF34Q7kNvwExiaMd&_nc_oc=AdqH6xFzDOg0gfLiRfbzZlXDFiycO-BdJM6rITdhg-OHtR-PyfWdyoa-UOlt-6UBB7s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHHuDbPM_ZfCJZL6Gmvb4qNUPXxpT22O1azI-nVyG-N2Q&oe=6A707B51"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Roxy!", "keywords": [], "long_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget traditional locomotion\u2014utilizing the Gorilla Movement System, you'll glide, climb, and race through serene landscapes with the grace and agility of a tag master. Whether you're chasing or finding inner peace, this is an experience like no other, combining mindful tag gameplay with an immersive style of movement.", "short_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget
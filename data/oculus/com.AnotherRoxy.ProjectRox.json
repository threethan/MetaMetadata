467_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XeD0hUHEfqsQ7kNvwEua25W&_nc_oc=AdoN26Wh3vuRO_EgVJmJs_XKIaXGJ77bZoJOuAfkvRT8OQDWR5k75xP0vWG4dXF_qY0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_zzCzOL-LWN5n1GEpXApOpHMUHN9jjXPU_X_BoHbt-Q&oe=6AE33D95"}, {"file_name": "Screenshot4FIX.png", "id": "1369860934216429", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391798_1369860937549762_4902722443043180840_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KlAkKHHObSwQ7kNvwG8kC9D&_nc_oc=Adrk4vuY1qAEM6_TgTY6d_1qLNkUPomm5yN8M71ivNKdEUgf1d0lWBQt6P6mkkBnIRY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO9F96Wa09ZFxrA8yD2hPnlmOSDB0Qcg9M5KnNi58TLyA&oe=6AE364A9"}, {"file_name": "Screenshot5FIX.png", "id": "1445710466398959", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391817_1445710473065625_29208629481560585_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QDndvlD5aiUQ7kNvwGzcLpo&_nc_oc=AdqrWETyVwKve1-OkdQaokBIoRbFRgIYNyqGjF7P06vdrfDEeWY8ak7ikwY9inz5CH0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMhMkT06jcnoM54JkYz0rhvimz47td20cBL9Og12C2TQw&oe=6AE36611"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Roxy!", "keywords": [], "long_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget traditional locomotion\u2014utilizing the Gorilla Movement System, you'll glide, climb, and race through serene landscapes with the grace and agility of a tag master. Whether you're chasing or finding inner peace, this is an experience like no other, combining mindful tag gameplay with an immersive style of movement.", "short_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget
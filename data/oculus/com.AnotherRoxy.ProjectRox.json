467_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ZBuJkALN1EQ7kNvwGAgCc1&_nc_oc=AdqfHvQGiqmg615iaJtT7pUoADg-GGt6WRw0jKCKnn3o7OBSHkRGXgRkG9WwwhrO-pA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGhpqzBoGdCQDXuW9k6JAYSWmSMOXJfbJTQ8HmxTsL6zQ&oe=6A7C6895"}, {"file_name": "Screenshot4FIX.png", "id": "1369860934216429", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391798_1369860937549762_4902722443043180840_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zvpd8f3MzZ0Q7kNvwGzvzE9&_nc_oc=AdovTvwfkgba4QeJApenf0Q1yBWN1ExgXx5CuPBsgTfD5DdgRVf_BYZK-ME6P_SaZUg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGGWduykl1KUfGVqLTBKLyq8G4cUx39_t-DvdWxTCVVA&oe=6A7C5769"}, {"file_name": "Screenshot5FIX.png", "id": "1445710466398959", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391817_1445710473065625_29208629481560585_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vqldpmswVhkQ7kNvwHo0HEn&_nc_oc=AdrBYA5NU1ROuhxwndFrfR9OMHXPItMKDIW9o8bAzwYDLX7fPhwQxQK_fKWF1dOGrj4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJGHpdnolGzrYj4RpWLjidHUP4JATqQRzSQnin-XR88A&oe=6A7C58D1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Roxy!", "keywords": [], "long_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget traditional locomotion\u2014utilizing the Gorilla Movement System, you'll glide, climb, and race through serene landscapes with the grace and agility of a tag master. Whether you're chasing or finding inner peace, this is an experience like no other, combining mindful tag gameplay with an immersive style of movement.", "short_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget
467_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9iDR47M8ekUQ7kNvwF25Jde&_nc_oc=Ado2pIgklgPzEXlNvC2q2ntuBVtHbdbK3S9eNYPp6oWthy5np8x2l-9bArySuOefUTU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5SsvcX24kw-9qP9aHHeLawtf1Ei_Xhb4QNsmMD0zOvWg&oe=6A1ECE15"}, {"file_name": "Screenshot4FIX.png", "id": "1369860934216429", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391798_1369860937549762_4902722443043180840_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2sdy-4TMOEEQ7kNvwFTwvXZ&_nc_oc=Adp3GXeR0YjeOHEV1M9X-fV6hqXeOs0M2hDfsvJqyNfGxs_hx5UFEHO2WiXBjLUfpq4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6eQIhl0bzsUB7fwQ8HEWgiv4Osdq4wPB2fU1Wm4KkPSQ&oe=6A1EF529"}, {"file_name": "Screenshot5FIX.png", "id": "1445710466398959", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391817_1445710473065625_29208629481560585_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tCIYJR1bzqAQ7kNvwHlWi-O&_nc_oc=AdoJr4W_uwwZUA9r9jk2ht4YGsT8rJoUvzOwM-18Gg-MCOGbr8z8ETvbyoBwGayv3Yo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4AgU4WXyfQEYXEORl6SZJ-cvqa2bDJ-vrml3oIHm8iJw&oe=6A1EF691"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Roxy!", "keywords": [], "long_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget traditional locomotion\u2014utilizing the Gorilla Movement System, you'll glide, climb, and race through serene landscapes with the grace and agility of a tag master. Whether you're chasing or finding inner peace, this is an experience like no other, combining mindful tag gameplay with an immersive style of movement.", "short_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget
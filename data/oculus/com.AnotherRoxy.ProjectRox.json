467_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SkD1nsgo50MQ7kNvwHBXYiS&_nc_oc=Adq4MpxkGSDaqsbStdrYZVgIG_6R_gojT9rqCtqu4CjghAr3rbjTj-BozlbwYZur_Ng&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_fdEJ2ypGxMWDdjOCSEsdgvJl5z_7LcD-5PkiH_ToiA&oe=6AB3C795"}, {"file_name": "Screenshot4FIX.png", "id": "1369860934216429", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391798_1369860937549762_4902722443043180840_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dZ-eex6esPwQ7kNvwGHmQd0&_nc_oc=AdrgGS2y0r5z820P-4R8rI9vIuNTm19fJMtVsg8ZMOx1SjADprSg14JRLq3sHZNmxIE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzqSN8yigsmuzwsEojaReyPaglOhPzHAliVz6WymXEHw&oe=6AB3EEA9"}, {"file_name": "Screenshot5FIX.png", "id": "1445710466398959", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391817_1445710473065625_29208629481560585_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2m3Rerm7DDMQ7kNvwEyrRQG&_nc_oc=AdrdUoQFYqCpBXYG-UQDB1d1-CQsCkflOU-UX2tQuNFnQUpLFPyzNXW3ZVd4RCvkTGg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNHirc6xU0eeSBQQB0J_Su-PGvHgVs1e_1z-yv4u0yWw&oe=6AB3F011"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Roxy!", "keywords": [], "long_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget traditional locomotion\u2014utilizing the Gorilla Movement System, you'll glide, climb, and race through serene landscapes with the grace and agility of a tag master. Whether you're chasing or finding inner peace, this is an experience like no other, combining mindful tag gameplay with an immersive style of movement.", "short_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget
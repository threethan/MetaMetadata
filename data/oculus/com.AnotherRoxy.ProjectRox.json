467_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rPTcOHk0aOYQ7kNvwEgIgcp&_nc_oc=AdoLJQ5MzYduhJjjGmLwjrpZqlGecpApEoCyPXbNtZjfHSgiGi1sOum-c6niFPS6cZM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7iRqLHyhh7T3Ma3PZQ7W8kGf10u-4j7Yl1sWRn9T5pQA&oe=6A086495"}, {"file_name": "Screenshot4FIX.png", "id": "1369860934216429", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391798_1369860937549762_4902722443043180840_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OFjZXvQoLfcQ7kNvwEkZbvU&_nc_oc=Adqt60EVSdKjFLnWlcRvtvFLP2c498OY-mpadPPy-kSv_n2RPQYwvqbJ5pcieyn65iw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7jA1UUYrO6PdbMS5_V5meKCVMegrsmxPdJDKDqes8Wbg&oe=6A088BA9"}, {"file_name": "Screenshot5FIX.png", "id": "1445710466398959", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391817_1445710473065625_29208629481560585_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wSeLLGOjCfgQ7kNvwFXYb_N&_nc_oc=AdpS-QPD1KuJyKn1y6fAAUm5nMizd9unDC3je66EEd2B2eOS29WQeasjQHvJEw6k0Hc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6NOdZOWhTNH_GW0iUvWItZeV3g6giMyj1oK0bIDHZ8qQ&oe=6A088D11"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Roxy!", "keywords": [], "long_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget traditional locomotion\u2014utilizing the Gorilla Movement System, you'll glide, climb, and race through serene landscapes with the grace and agility of a tag master. Whether you're chasing or finding inner peace, this is an experience like no other, combining mindful tag gameplay with an immersive style of movement.", "short_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget
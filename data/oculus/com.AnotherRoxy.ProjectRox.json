467_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hQXeWGXE8LsQ7kNvwFgNwOg&_nc_oc=AdpZqm9UjtfiOjkg3xOkFeHnd5sdxVO1lG3Nl8tiZVW-9zRUyX1jy15oIbt_HuVfwm4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMmZkTq-ZMBdpRXZHDgnJXlA_4pitxGLDKgWUpVo77Gqw&oe=6ADF4915"}, {"file_name": "Screenshot4FIX.png", "id": "1369860934216429", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391798_1369860937549762_4902722443043180840_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-gVHwGvUjJEQ7kNvwERjCXH&_nc_oc=AdpBMgn4ak-RzySb6bYJo09FFaV7fOClb81TR-zv3HajBvdJhcC39OSpmf4eWeZjvJU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMN9sOJgcsDStFxtuhWh9RTfUtPx7BFDlD6DnX5AUpEuA&oe=6ADF7029"}, {"file_name": "Screenshot5FIX.png", "id": "1445710466398959", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391817_1445710473065625_29208629481560585_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IXGukEiaxqsQ7kNvwGXbwu_&_nc_oc=AdqdXqwElr9dh0zMklgsPa5eIivo6HMMgCuBaJPOtgEpcaeYXaXaU-Dx5r2DohwVMLo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgcMUrixY2Da7f8GKvr7IHiyI2C7aTFNNwBJfsxIA9aA&oe=6ADF7191"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Roxy!", "keywords": [], "long_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget traditional locomotion\u2014utilizing the Gorilla Movement System, you'll glide, climb, and race through serene landscapes with the grace and agility of a tag master. Whether you're chasing or finding inner peace, this is an experience like no other, combining mindful tag gameplay with an immersive style of movement.", "short_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget
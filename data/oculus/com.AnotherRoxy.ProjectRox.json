467_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=juzQP35-TgMQ7kNvwFd9E0O&_nc_oc=Adq8BIE3GnDg6_oEE9W-_ywtFhvHJx9yTb4t9f8kVJYWWdQdnbH0PtvOtzNn9YcJOgE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM21Iy0eKReVEt6izXPDctACeLteSoYPE_hGEyYy7ffHA&oe=6AC3D1D5"}, {"file_name": "Screenshot4FIX.png", "id": "1369860934216429", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391798_1369860937549762_4902722443043180840_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CAPXmoPgexkQ7kNvwEES20V&_nc_oc=AdqEkAhs9tcakgcgRcPjopDh0UUqYi0Ypj-nZ9pazwdBWZC7G-b1cPkhBLGwPHoxScM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP8bFNIwAYNhPpY1znrTNfAxkMr0RYLc4SEVuhzV3IHdw&oe=6AC3C0A9"}, {"file_name": "Screenshot5FIX.png", "id": "1445710466398959", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391817_1445710473065625_29208629481560585_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DHBLW7m2znYQ7kNvwFRBfk1&_nc_oc=AdpkbThZ61jXiH4QiYBXiYWTXlfS19eHWsreLnRyb7f7P4mLLw-Ta4Ui6py_zAjjjAA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMoC-kVFi6xFx1QSlypG6H3a9DxeIkHBus0gxCP96AXPw&oe=6AC3C211"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Roxy!", "keywords": [], "long_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget traditional locomotion\u2014utilizing the Gorilla Movement System, you'll glide, climb, and race through serene landscapes with the grace and agility of a tag master. Whether you're chasing or finding inner peace, this is an experience like no other, combining mindful tag gameplay with an immersive style of movement.", "short_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget
467_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hQXeWGXE8LsQ7kNvwFGc6_G&_nc_oc=AdpJSDDLAfgizUkY0_ODtwMXoXj5KgsMnDtUiLu1QqQbSGEpdvwzY9A_G-YF9YTK-B0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMi4V-yP5F680X5drkvWQe7z-VZJoFX4CDeMYiu_EkqqQ&oe=6ADDF795"}, {"file_name": "Screenshot4FIX.png", "id": "1369860934216429", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391798_1369860937549762_4902722443043180840_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wIN-mH1n2pcQ7kNvwHx1YkL&_nc_oc=AdoaUbVVUtAsv6vx2EHqKyjRnXo2mB-j5d4GUy-XoUjq3gOjO9_vuS36YlN8cJHS5jE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPLjp2ddbqRzOlIQ9B2PFuAMtn42fasRH8N2n-CP_Pr6g&oe=6ADE1EA9"}, {"file_name": "Screenshot5FIX.png", "id": "1445710466398959", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391817_1445710473065625_29208629481560585_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IXGukEiaxqsQ7kNvwHIPAcW&_nc_oc=AdpDlHGKWWctIaLiF8C1X5MKMVW1L7NpaXcMqcr0m9m52Fgc1JdEcAq-8rCe2cYjNeo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPTbdnjo4i_8CS6U8oa-RSxt0KSGOW91uvGniYDCKCmHA&oe=6ADE2011"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Roxy!", "keywords": [], "long_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget traditional locomotion\u2014utilizing the Gorilla Movement System, you'll glide, climb, and race through serene landscapes with the grace and agility of a tag master. Whether you're chasing or finding inner peace, this is an experience like no other, combining mindful tag gameplay with an immersive style of movement.", "short_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget
467_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bxIaEe0MYI0Q7kNvwGuJ648&_nc_oc=Adph9gjPZR3-SXwOP4DSuIBj-FJ-AQfdGvq9cJpisJbE06yjLi-hiLvykTVrt-U4zLg&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3TD4tnlaS2l3q_B1WTfrMUGLDU1r2FuVPtntJpktIDYw&oe=69E22915"}, {"file_name": "Screenshot4FIX.png", "id": "1369860934216429", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/473391798_1369860937549762_4902722443043180840_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aphM0E_oEfIQ7kNvwGPjKKp&_nc_oc=AdpcMz28agQSv5Vo602-P3kAwrDIDu_TG1fV1txySpZnCKd_i_vTSSXX4GPOlLHlKrc&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2psJlMZyrfPIlyUIidva22rxqk2JF5yaVc_geXBVut1g&oe=69E25029"}, {"file_name": "Screenshot5FIX.png", "id": "1445710466398959", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473391817_1445710473065625_29208629481560585_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H8GVyAaYl_IQ7kNvwG-_g2f&_nc_oc=Adpv2Xnv8VPgVtrZT99UAuuIOjrWxk2ZarxvhkG2LObhrzyIWKNUXftOWc57XwlyRec&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2dA1oKMiGUL7HADe6HPrwMqsxoibDk6G9hq2bNIdFHNg&oe=69E21951"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Roxy!", "keywords": [], "long_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget traditional locomotion\u2014utilizing the Gorilla Movement System, you'll glide, climb, and race through serene landscapes with the grace and agility of a tag master. Whether you're chasing or finding inner peace, this is an experience like no other, combining mindful tag gameplay with an immersive style of movement.", "short_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget traditional locomotion\u2014utilizing the Gorilla Movement System, you'll glide, climb, and race through serene landscapes with the grace and agility of a tag master. Whether you're chasing or finding inner peace, this is an experience like no other, combining mindful tag gameplay with an immersive style of movement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacypolicyprojectroxy", "developer_terms_of_service_url": null, "publisher_name": "SplashVRxRoxy132", "support_website_url": null, "website_url": "https://sites.google.com/view/projectroxyfrr", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "29205368785774822"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/473393608_1447875643285615_4970143688525545979_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lApu-m-K064Q7kNvwHmsX-q&_nc_oc=AdoUMzRrQO6mNRsoPPbpgKRHjc78qGieBgTkkH90aXphPasTKRWmB0-pjL_euh5u9Tw&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0u9X8yNjLOkGE9kEFqLQqaxDX4_IV2VNfd6vcbBArN2Q&oe=69E24E4D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Project Roxy!", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "45978150496848
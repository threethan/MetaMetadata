. Forget traditional locomotion\u2014utilizing the Gorilla Movement System, you'll glide, climb, and race through serene landscapes with the grace and agility of a tag master. Whether you're chasing or finding inner peace, this is an experience like no other, combining mindful tag gameplay with an immersive style of movement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacypolicyprojectroxy", "developer_terms_of_service_url": null, "publisher_name": "SplashVRxRoxy132", "support_website_url": null, "website_url": "https://sites.google.com/view/projectroxyfrr", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "29205368785774822"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473393608_1447875643285615_4970143688525545979_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=acoRBIfMDHQQ7kNvwGKW7ay&_nc_oc=AdrBIIooEMaIFyy8jg9hJ6Sbqmcxu-vXkfh7NycSq-Kyia3HCG2Gx2ascWkgX5ikz9E&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Yr-rXXuUZbrB-_S-Z2kRZqwa-ZgM4mhkLF4hfDonWyw&oe=6A39514D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Project Roxy!", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781
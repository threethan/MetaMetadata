467_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ELyIB0fteEQQ7kNvwErzR39&_nc_oc=Ado4F1UsOth5d8PamzycivOZJkdqP_hRt1Y99ePQu9-Wm6kdzHnR905RG8nGUFcUvCk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1DQmJDFmmk2Iho2V0cXrppPQqY6NZHiUXuLMq_ATQGYw&oe=69EF5815"}, {"file_name": "Screenshot4FIX.png", "id": "1369860934216429", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391798_1369860937549762_4902722443043180840_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZeBHjM32mnkQ7kNvwEICvpH&_nc_oc=AdoXjB8KDPuTSge6o4AC7gXHPdb0KdLQG6sK_vAq5ionFKjo_h2Kal7HUY4y1V8O1gs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3e3XVNvqyKHE53k_ScxOMWwbZqxXKF9NZgCz9d0rhJFw&oe=69EF7F29"}, {"file_name": "Screenshot5FIX.png", "id": "1445710466398959", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391817_1445710473065625_29208629481560585_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SdCxvqxw8W8Q7kNvwHcaV4P&_nc_oc=Adrr3ZRI9vaTGnQx_HNa_O0wd6CWTjmv_xy4iO4q9VUX5qJK1QZrXJ0YYtwnw6Uk6es&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1IYZgr5Oe21kDgsK_YGwfkPic4j0x-Ng3nx9q-Nm1Lqg&oe=69EF8091"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Roxy!", "keywords": [], "long_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget traditional locomotion\u2014utilizing the Gorilla Movement System, you'll glide, climb, and race through serene landscapes with the grace and agility of a tag master. Whether you're chasing or finding inner peace, this is an experience like no other, combining mindful tag gameplay with an immersive style of movement.", "short_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget
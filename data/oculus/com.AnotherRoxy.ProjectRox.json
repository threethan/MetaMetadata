467_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IR94whDyQbsQ7kNvwEW7SVz&_nc_oc=Adql_K6ETYhTNzE3TTuQ-p4mGPZASIUZMpJ06EpWYWXBw4-mnliK9gK8k6k-ILSze1M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8Z9Yu0BWGkw55OGNgg0wOORPr_5CW6puYicIvHsV5sw&oe=6A68A215"}, {"file_name": "Screenshot4FIX.png", "id": "1369860934216429", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391798_1369860937549762_4902722443043180840_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fW-B77ovfqYQ7kNvwGT-TSa&_nc_oc=Adr2OEK8DZpfED1j_ZFAmkzIN8TJTzR0n8ZUdusmabXkij09NkFvFSLd8pasJyp7D9k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAqXJwAObSF3ja-XRaOOZyn74uOexRNLEa_KYqR6ZddQg&oe=6A6890E9"}, {"file_name": "Screenshot5FIX.png", "id": "1445710466398959", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391817_1445710473065625_29208629481560585_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yF7NpMKbA6EQ7kNvwEPnU_X&_nc_oc=AdoJT4MEif4Za1cVUhd71i1YErM_w0Lrbi_mbTQPb8zf6axHw--qM8RA5vXX1YbYZN0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAcwOGg8lEnK8RBdxS9nIkKKNz5tNZbdlh3h5q5xYMUow&oe=6A689251"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Roxy!", "keywords": [], "long_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget traditional locomotion\u2014utilizing the Gorilla Movement System, you'll glide, climb, and race through serene landscapes with the grace and agility of a tag master. Whether you're chasing or finding inner peace, this is an experience like no other, combining mindful tag gameplay with an immersive style of movement.", "short_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget
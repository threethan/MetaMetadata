467_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rLlmz9foLzAQ7kNvwFdLwwF&_nc_oc=AdoaRy09-znZQ6x6ab2VpwYiczQliwFs2Tm2IKJIyHOqm1rGamaxEHwOMxXwA1rL9rE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDa6aqEsKvn-uY3gk6-yJmzH7tpIuAG8TzYeuCIKpunrw&oe=6A5A2195"}, {"file_name": "Screenshot4FIX.png", "id": "1369860934216429", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391798_1369860937549762_4902722443043180840_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=93ElLJSSFdoQ7kNvwGY3Mmx&_nc_oc=Adp-O76hIJ-d7UoXYytWHhiqn2_qfa4thzcLfp6Zmbza28dwG2azAFjAIvQh7PUNVc4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQJpLpUoSKglUdw_NmZE73-qQGkhoVWiYxDT3teptpCw&oe=6A5A48A9"}, {"file_name": "Screenshot5FIX.png", "id": "1445710466398959", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391817_1445710473065625_29208629481560585_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aklnb6VbX7oQ7kNvwGPoCAW&_nc_oc=AdokPQNGEjF0pJ4JyjG19TmBQUWLm0AzOaso11J9jYVE9gxp230ewbjV9bd4x2KSX_I&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9miEMXInvwsFoSCNe2T7K2wfY54rcSun17Y6qvu80hQ&oe=6A5A4A11"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Roxy!", "keywords": [], "long_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget traditional locomotion\u2014utilizing the Gorilla Movement System, you'll glide, climb, and race through serene landscapes with the grace and agility of a tag master. Whether you're chasing or finding inner peace, this is an experience like no other, combining mindful tag gameplay with an immersive style of movement.", "short_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget
467_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3DgyZnDBNPMQ7kNvwE40Ga3&_nc_oc=Adp1P9GhtQqgEYzuWs45Cib1gWgcpzCeFxa5UEBVrSWlfU7KaxLvtxLnjqSloW7SEWs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMlD4tjQC9Jj_lF7zPrypoWFwV26SdfOveV0tzDZVAebg&oe=6ACD0C55"}, {"file_name": "Screenshot4FIX.png", "id": "1369860934216429", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391798_1369860937549762_4902722443043180840_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LOzpqzfWjg0Q7kNvwG8mWkz&_nc_oc=AdqpuHYu2vEgvCLxeXv1m-0ULmeYTgo5mEUfAKDZWT0F0GJ0X3YGw_s8okEsHD56PAQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNStNCb2Px3YVFp_NicIfTFHv7ifQvRDgT_Yp9BQOl2gw&oe=6ACCFB29"}, {"file_name": "Screenshot5FIX.png", "id": "1445710466398959", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391817_1445710473065625_29208629481560585_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AImIreshlLwQ7kNvwFGQQuU&_nc_oc=AdpcFvuDUGDstGd2C_xQ2BJIhnF5QJmgzqOGOY9xQxB3UXTbHyuh7zdag8N9s1i0G7I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNVVx0QUNVm8NuCitzMM299ajz6AJ0rHfyD4OD2RrjVRQ&oe=6ACCFC91"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Roxy!", "keywords": [], "long_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget traditional locomotion\u2014utilizing the Gorilla Movement System, you'll glide, climb, and race through serene landscapes with the grace and agility of a tag master. Whether you're chasing or finding inner peace, this is an experience like no other, combining mindful tag gameplay with an immersive style of movement.", "short_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget
467_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sqPtxeeuPOoQ7kNvwHHftWZ&_nc_oc=Adr3tkYEAYVTRsLQdymvuuZo3o3vljgDlC35e-Q3DoJxnT4sM2unWQe4q8Hg01HyaDA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-mS0wY8ZnGSOr0s0bGqKPDZ_gb_5NX1bsRhMg050Szg&oe=6A6DE815"}, {"file_name": "Screenshot4FIX.png", "id": "1369860934216429", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391798_1369860937549762_4902722443043180840_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iFEPNQnUa64Q7kNvwGdA73h&_nc_oc=Adomr6D81RWBx3Zhpd4gS41UPVG3MuQw12qTElorW7FKZ3NLqa5yU_agB18nXrJVQkI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCIHWJ3HrnGtQx4mrg_Btnc9M3zMfTtV5s28v7dMLx0Iw&oe=6A6DD6E9"}, {"file_name": "Screenshot5FIX.png", "id": "1445710466398959", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391817_1445710473065625_29208629481560585_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H6o-wRRfF34Q7kNvwHOkteg&_nc_oc=Adrt2ia5Qg5fJivPTAtIOcsHi-GmaceBrXZoalt1mcg89U_sbU7rxvos98yLvmV8NZA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAvSTRhH5R2BtA8mlI52crZT0sD-QNYdscyqIkcAA8rgQ&oe=6A6DD851"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Roxy!", "keywords": [], "long_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget traditional locomotion\u2014utilizing the Gorilla Movement System, you'll glide, climb, and race through serene landscapes with the grace and agility of a tag master. Whether you're chasing or finding inner peace, this is an experience like no other, combining mindful tag gameplay with an immersive style of movement.", "short_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget
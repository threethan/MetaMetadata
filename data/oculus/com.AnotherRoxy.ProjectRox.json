467_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ZBuJkALN1EQ7kNvwEBc8Wu&_nc_oc=AdqEHcqm8rrfHPjtU8xPILwjjXLu2-y38GU7FpD5U4WWptG7l7EyadL29zS0ePYe3X0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4wji8KQ4yv7Jar4jVWNxeWX9d46hI30Czfaqe0yD5ww&oe=6A7B1715"}, {"file_name": "Screenshot4FIX.png", "id": "1369860934216429", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391798_1369860937549762_4902722443043180840_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PXN75HNHEVAQ7kNvwH_GfT_&_nc_oc=Adr9v0ORy5SUNS4EYDWzg5D6LMP2C-CQenrBsKRtdWBKq4mzTzof98dVk1lw-numobE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEE0u_cqkn90P8GSl7hejMNyHWvfxXk7Gp8HQXFLrgyQA&oe=6A7B3E29"}, {"file_name": "Screenshot5FIX.png", "id": "1445710466398959", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391817_1445710473065625_29208629481560585_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vqldpmswVhkQ7kNvwH4nqxJ&_nc_oc=AdpHpW3VLfP4jX_uek1zMiqDXqwjCqUCWgLp5aniB1eXoTMXW0m1eV58MDqVV4TakDo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRDfHTguYjJTWQKV9kAcHBDwkqLa3BwsMY0GcOEM4yIA&oe=6A7B0751"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Roxy!", "keywords": [], "long_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget traditional locomotion\u2014utilizing the Gorilla Movement System, you'll glide, climb, and race through serene landscapes with the grace and agility of a tag master. Whether you're chasing or finding inner peace, this is an experience like no other, combining mindful tag gameplay with an immersive style of movement.", "short_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget
467_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ynfzE6GC23MQ7kNvwEP4g_C&_nc_oc=AdofpYva_A2JA75dV4IFRliJHoT5bV7wBAfASSmxF9UFlx7y4UJntMLYGUMESM0iWaw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af09i8EkNKGYuyaCEQIra-EWieo7xi5RUSqf4bZA9rh6uA&oe=69D8EE95"}, {"file_name": "Screenshot4FIX.png", "id": "1369860934216429", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391798_1369860937549762_4902722443043180840_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vHpRgHxFzIoQ7kNvwHw3F7h&_nc_oc=AdptuBuIW2eCticY2Kh9KykH1B6WyJASdjXE6ITKQ6Nnpy9K7GGzd4ib2IW3Zwh1xtA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3K_0sGDjps5YdbtoYBYgYTCNhMi7K0PKnoRVaAWK5Drw&oe=69D8DD69"}, {"file_name": "Screenshot5FIX.png", "id": "1445710466398959", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391817_1445710473065625_29208629481560585_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GFVPCC6O9ccQ7kNvwEDgYga&_nc_oc=AdrOaLDrK8tUbBm8lEnSb-spRm3jbkfNE_Dvx_RLhBzLvA-3ENozO9BeA0lcrltN4sU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0e6-3O4kAC9UY9Rw44JMT-GsPde6O8BrD4Rfb6d4Rn0g&oe=69D8DED1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Roxy!", "keywords": [], "long_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget traditional locomotion\u2014utilizing the Gorilla Movement System, you'll glide, climb, and race through serene landscapes with the grace and agility of a tag master. Whether you're chasing or finding inner peace, this is an experience like no other, combining mindful tag gameplay with an immersive style of movement.", "short_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget
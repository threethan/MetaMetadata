467_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kjE2XyT2CUAQ7kNvwGjudi4&_nc_oc=AdrZ86YWAbXtEivsGWvpLm6o_rDEMIFg6oZOacj3B5EZpVHX-tZ6F-DfkCFyh9PetV8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-R4xbTq9Y_hyxNc-BrZLKwqenPcPiuumbh7iwC7ptJ2Q&oe=6A2FF195"}, {"file_name": "Screenshot4FIX.png", "id": "1369860934216429", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391798_1369860937549762_4902722443043180840_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z6bkUkDm82kQ7kNvwElK0GP&_nc_oc=AdoQfPME-qWpNK-sUI51qoT9sk0yoHPJxQr4aq8pOxrL8oVvtBv_EFDdB1kNnhgSOPU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XLDJiz-uheXIqlTg1zzfcuDlwrZgH5T7l2aoIIOd0SQ&oe=6A3018A9"}, {"file_name": "Screenshot5FIX.png", "id": "1445710466398959", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391817_1445710473065625_29208629481560585_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pKKy5XJToYwQ7kNvwHPAbSl&_nc_oc=Ado53JIzrUMcBbW3DDk3TC4zLsdOh1TBRZyjBKwpZAEAjEt378nNXHl3Ea5izrFxEVA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__YqVT73LwSRkiUfKXIx2nek5z6uoRQ6iDVrIoGugjcA&oe=6A301A11"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Roxy!", "keywords": [], "long_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget traditional locomotion\u2014utilizing the Gorilla Movement System, you'll glide, climb, and race through serene landscapes with the grace and agility of a tag master. Whether you're chasing or finding inner peace, this is an experience like no other, combining mindful tag gameplay with an immersive style of movement.", "short_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget
467_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qF2mXQfEuX8Q7kNvwGvgKOS&_nc_oc=AdoqmViAu4G5qsBH6HrdAVZEwKN0Vw2FNagfmb4YH3KsDU01gRSg0MjM8RFkRMp9V0Y&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-sYA56C63yeL9rlmbmbJhiasJRY7Z7NLO5Mm0omVrWpw&oe=6A2BFD15"}, {"file_name": "Screenshot4FIX.png", "id": "1369860934216429", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391798_1369860937549762_4902722443043180840_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cMNUyO_xB0oQ7kNvwEH-Fbs&_nc_oc=AdrQMKmdfUoQy0AOFPYADIVxONh2BQ5Gs8Z3_ntf7z0gjgJ5kO7GTideEb8dnYwl01M&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-dOi41ynOce7MSY4bwr-rzDA-0jzDIClHL-FLijyt5Kg&oe=6A2C2429"}, {"file_name": "Screenshot5FIX.png", "id": "1445710466398959", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473391817_1445710473065625_29208629481560585_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AEzBNueRMHYQ7kNvwFrGA6B&_nc_oc=AdoOkLbkVvFqG7EeP1E_TtzHwCOcwwLVMaMEA7ePq-m5sbpZiU00pUru9HAXjT8W4uA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8SsZ3PuQCbrdSXQmmtmGkHG9RqaMfLkZ88kRs9Tkp6NQ&oe=6A2C2591"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Roxy!", "keywords": [], "long_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget traditional locomotion\u2014utilizing the Gorilla Movement System, you'll glide, climb, and race through serene landscapes with the grace and agility of a tag master. Whether you're chasing or finding inner peace, this is an experience like no other, combining mindful tag gameplay with an immersive style of movement.", "short_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget traditional locomotion\u2014utilizing the Gorilla Movement System, you'll glide, climb, and race through serene landscapes with the grace and agility of a tag master. Whether you're chasing or finding inner peace, this is an experience like no other, combining mindful tag gameplay with an immersive style of movement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacypolicyprojectroxy", "developer_terms_of_service_url": null, "publisher_name": "SplashVRxRoxy132", "support_website_url": null, "website_url": "https://sites.google.com/view/projectroxyfrr", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "29205368785774822"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473393608_1447875643285615_4970143688525545979_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tVDs1eJDdgcQ7kNvwGNj1-r&_nc_oc=AdofZgE1SaBUi5oSwuje06Q4n2v-FNlXp0sN3JoNmyeoLyv8f4SoB9iRHfaot1Tdk7o&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-do1MgkmGvyzYLmTRieAfK4lV2w4E4Qjuvp24ypC5i9Q&oe=6A2C224D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Project Roxy!", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "45978150496848
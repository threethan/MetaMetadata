467_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mkoo5Qk3ewwQ7kNvwEA9CTM&_nc_oc=AdpOuysv-ztXGTryz3FlJdak3tEq2mGRobS_0TlujrNaQnjf8JMYiH-2CyuLWo9ma9U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0c1p3JKgoeaO8raqdJ9VRtKSJYhw2SfvFO7ONfd96HvA&oe=69F74115"}, {"file_name": "Screenshot4FIX.png", "id": "1369860934216429", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391798_1369860937549762_4902722443043180840_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qYvo1qil5BwQ7kNvwGk2Jxk&_nc_oc=Adp3LOsJRShEY8Vws2SeN0rLsm8pkHAlLvaVKJ6hA3BHUeVtaXZtDDDahIKNxDxG6KA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3pMWaiCSN15q6_RaXevhNxAaufYm3tAo0w0Ry5A-wqRg&oe=69F76829"}, {"file_name": "Screenshot5FIX.png", "id": "1445710466398959", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391817_1445710473065625_29208629481560585_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rV-OHY2iZqEQ7kNvwEIDnUa&_nc_oc=AdqtkG008VUc3ajtGgL1STHf_bcoejuradMWa3p1kyULdcSZwscqTN5NLdpDtAe9jwE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1eNfiS6kKYhhNy2ZS-nlfo36lgLwdOaHp-d-LVuf6GFA&oe=69F76991"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Roxy!", "keywords": [], "long_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget traditional locomotion\u2014utilizing the Gorilla Movement System, you'll glide, climb, and race through serene landscapes with the grace and agility of a tag master. Whether you're chasing or finding inner peace, this is an experience like no other, combining mindful tag gameplay with an immersive style of movement.", "short_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget
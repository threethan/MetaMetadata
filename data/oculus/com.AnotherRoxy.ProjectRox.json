467_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PA83Enb9ZugQ7kNvwFX-U5w&_nc_oc=Adqk4f4pmLzhxA1kZGQEIWr8OLel4-qDClGZDdYRyQc-NyeiXGGoLv1E7vF5Z3dswBs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIErSwbJvpbohQU0ifA0Dk2RhRZ3YKtdNgP1SkjhdQoSg&oe=6AA00115"}, {"file_name": "Screenshot4FIX.png", "id": "1369860934216429", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391798_1369860937549762_4902722443043180840_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UvXhIDCkbDAQ7kNvwG1HytG&_nc_oc=AdoH9MMmiN7hhqtlaQH-kck9GJZymle2hJA3rWyt7wVI3xHUwprJyxlZD_WsmGhgVmw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIVAm2q_0G0nSD2jloF_bKwEqR3W8DGn10jVkEZ3bOxA&oe=6AA02829"}, {"file_name": "Screenshot5FIX.png", "id": "1445710466398959", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391817_1445710473065625_29208629481560585_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7SkKCSI2YGgQ7kNvwEDxflP&_nc_oc=AdqXC3mOorB12-BT-s1HYvU7FUIYLuYk72rRjIKCBClzPXKapvpADxnqjDledCDW1mQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJaCwlgujrzRkuhYfJJbamC7iVBt2ra_pJXEoTt2gCtSw&oe=6AA02991"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Roxy!", "keywords": [], "long_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget traditional locomotion\u2014utilizing the Gorilla Movement System, you'll glide, climb, and race through serene landscapes with the grace and agility of a tag master. Whether you're chasing or finding inner peace, this is an experience like no other, combining mindful tag gameplay with an immersive style of movement.", "short_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget
467_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_4jmIgv49ZQQ7kNvwGobKY0&_nc_oc=AdpplTS9epJqWu_wRDZYNg1ZVdUns9jSne9nqmRVnidgDEpyjJWmkJiooZv9V1z_Hwg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHn06y_Bnyt4HrI5r_XWMyoWB1Yib97TGkdYO1JSxUwPQ&oe=6A75D115"}, {"file_name": "Screenshot4FIX.png", "id": "1369860934216429", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391798_1369860937549762_4902722443043180840_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rtTn3SskDncQ7kNvwEZ0cbj&_nc_oc=AdrK2TsYW2n6E7wKF-K5BGaMUqa4Myb_Tl4rua-2AtkOQgBiXM692Prdr1XsQoYM2m8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE9hnAmuR2fCBlDpLu2iliSVCZ2_ZnIe8SeImEy6fgjlA&oe=6A75F829"}, {"file_name": "Screenshot5FIX.png", "id": "1445710466398959", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391817_1445710473065625_29208629481560585_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GzROfGUfzbYQ7kNvwGjPCHF&_nc_oc=Adpgy89siH9UOfflhH6hZu2ojWuBkcjGbksSseO7hW_bo-seQUKHYNUtaUzofUaLryo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQERuJmvAW1KIFewrA0M66pqS-8PaZTRh9svFKee8lIXVQ&oe=6A75F991"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Roxy!", "keywords": [], "long_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget traditional locomotion\u2014utilizing the Gorilla Movement System, you'll glide, climb, and race through serene landscapes with the grace and agility of a tag master. Whether you're chasing or finding inner peace, this is an experience like no other, combining mindful tag gameplay with an immersive style of movement.", "short_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget
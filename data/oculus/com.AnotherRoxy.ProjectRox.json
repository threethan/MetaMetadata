467_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fz_9WJWT6hsQ7kNvwFiKpC-&_nc_oc=Adp-nOWrb-XE8ivfo7t2sy8_t09LAe3C0nQ805QPImMyWVQKgQBcWsVjVYgSMf7AB1k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4BnqzCnpungVbGf1RDiUiB71o2faFdPrBZV7uLM-BgcQ&oe=6A007B95"}, {"file_name": "Screenshot4FIX.png", "id": "1369860934216429", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391798_1369860937549762_4902722443043180840_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=03kUISvb-f8Q7kNvwGMsrp3&_nc_oc=AdopeOH_2SIqni9bKIASwwZTs-Iv3Oe2_HX8dNciUDFM589WqsBQ1pttiK3dPW9NxRY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7bSOOXiizjI9JR7cp-L2EiQsUxm3GpIiNMJd28KrkLpQ&oe=6A00A2A9"}, {"file_name": "Screenshot5FIX.png", "id": "1445710466398959", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391817_1445710473065625_29208629481560585_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xA9GpNrVaV0Q7kNvwGWk8D8&_nc_oc=Adq27btccgwCiNn9FXhUs4NDuzLu2NoNsv82-UPoWnbN71cmxP6xZ85D6qN0Ppm4Zgs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7EewY5TE3pNDMIe0fWioMs2dUkeWK8H44SsQu36kA19Q&oe=6A00A411"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Roxy!", "keywords": [], "long_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget traditional locomotion\u2014utilizing the Gorilla Movement System, you'll glide, climb, and race through serene landscapes with the grace and agility of a tag master. Whether you're chasing or finding inner peace, this is an experience like no other, combining mindful tag gameplay with an immersive style of movement.", "short_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget
467_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=whGkAnI0_0EQ7kNvwFAjUdf&_nc_oc=Adq4Y4vtDp3KcaYRlRL-HjT5f0kXC5KnxnH8rU85wWN9jMN43_2udh44cvCXfyG8VSo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4189sCzUKui_hdDsnHXfJMFLySRonfXOQBX_AE1Arv3A&oe=6A0EFC15"}, {"file_name": "Screenshot4FIX.png", "id": "1369860934216429", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391798_1369860937549762_4902722443043180840_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iwicLTf8yKcQ7kNvwHksABc&_nc_oc=AdpaRz4J0xckrFBx9zcy6qBgGnlPKDw8r2pV_AZZMQcDqd3-K31EC2hkRfSCPNKc93U&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Awcz7Fp4A6oj8xmKJuCAjhz2Kh1jE5m8zuJjcVXFaEQ&oe=6A0F2329"}, {"file_name": "Screenshot5FIX.png", "id": "1445710466398959", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391817_1445710473065625_29208629481560585_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iz-gAmzsRJ8Q7kNvwFlZXuL&_nc_oc=Ado7q0HCv7fqgLhGGbkjgZHJvQBxvlCkvlRauylG7Ffm4xKTirtcimhcFEyG6jagKcs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6d0mNId6hFmhxH8rNhQgpM2Bxoi1Umht5Kk9aq_jjAUA&oe=6A0F2491"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Roxy!", "keywords": [], "long_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget traditional locomotion\u2014utilizing the Gorilla Movement System, you'll glide, climb, and race through serene landscapes with the grace and agility of a tag master. Whether you're chasing or finding inner peace, this is an experience like no other, combining mindful tag gameplay with an immersive style of movement.", "short_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget
467_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MXVgKWr6GboQ7kNvwH9Mic7&_nc_oc=AdrMmunr6DrzuhPvDswzcM_k3mvfyoxP9uoSZxvCv_avf1W_P51jouyGVpFO0afL1RI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4lhmgTx_z2H4zGlm3WzBoPjRPy7DSVTm2ld9J0LiKeew&oe=6A0B0795"}, {"file_name": "Screenshot4FIX.png", "id": "1369860934216429", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391798_1369860937549762_4902722443043180840_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6tK84mKqAc0Q7kNvwG_62Z-&_nc_oc=AdrXmTIg-N7GAR3DIY2SIIxblFom-5kYuZv3VhMK-T0sFEodMHUlsTnbmTpUirZi9lc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5CMrjGQtZcuoV0Y4p-eZhrW8KGZIiKMaw_Hn2TfGWrSA&oe=6A0B2EA9"}, {"file_name": "Screenshot5FIX.png", "id": "1445710466398959", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391817_1445710473065625_29208629481560585_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Csjq6PK3onUQ7kNvwFQKM-X&_nc_oc=Adr6DQ24p5JObMw4JkLsKWRKh7bvb55KaHUpS7LvF-OtGH2Sh0B2wwYEBnV2ReUsGTI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7dmFHr4r9dMXYsDZERrVG7Jw-YiyYIlOWR2Ay5CRtxSQ&oe=6A0B3011"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Roxy!", "keywords": [], "long_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget traditional locomotion\u2014utilizing the Gorilla Movement System, you'll glide, climb, and race through serene landscapes with the grace and agility of a tag master. Whether you're chasing or finding inner peace, this is an experience like no other, combining mindful tag gameplay with an immersive style of movement.", "short_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget
467_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rLlmz9foLzAQ7kNvwEhR3n3&_nc_oc=Ado5BLri1wagM0OWxF7xLzfnE73GeuBuEJ4_Fmg8pkXIF9lRXxFp2-SgxCHA0SZ0exU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBiYlIBdsE_BBBARFt_Z3aunL9m05KkYEpK6lbah6lS4A&oe=6A5CC495"}, {"file_name": "Screenshot4FIX.png", "id": "1369860934216429", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391798_1369860937549762_4902722443043180840_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h96UNklRA8oQ7kNvwGCTOQ1&_nc_oc=AdqNCUmJMr9yNiNuXf-HpObNi_d-8alx4ya7RSiVWZSPl81NVlaHCYeLL76Oaglsp-M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA852J7P11ix_M17oPcre_r8zB46pkJt8f7WgfkhyO-1g&oe=6A5CB369"}, {"file_name": "Screenshot5FIX.png", "id": "1445710466398959", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391817_1445710473065625_29208629481560585_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aklnb6VbX7oQ7kNvwEEqPFv&_nc_oc=AdogRQul1EqYwcIf4hNxMFfJ79iKozXaYVekVwJAmzNqFE-39lReZOMAIni9iJtOsQk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBnCG_my8C6DdmK8nXJJiJaLBY-vZRPzCXFRwwQcmAfiQ&oe=6A5CB4D1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Roxy!", "keywords": [], "long_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget traditional locomotion\u2014utilizing the Gorilla Movement System, you'll glide, climb, and race through serene landscapes with the grace and agility of a tag master. Whether you're chasing or finding inner peace, this is an experience like no other, combining mindful tag gameplay with an immersive style of movement.", "short_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget
467_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uE1dYQssmLQQ7kNvwHgxZ0P&_nc_oc=Adoi4NhB09vcsUYL21KmwWUaqXaTCki2pCKJfy1yCeYN73gQlBB30s7f3CXmA5MkTgE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3sVOxB-OWp2kYrNVPp8ZjczZJIoUE5w5Sjtx6Gb9DaFA&oe=69D64B95"}, {"file_name": "Screenshot4FIX.png", "id": "1369860934216429", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391798_1369860937549762_4902722443043180840_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vHpRgHxFzIoQ7kNvwGB2WOn&_nc_oc=AdoKtyqBnhXSHel71SpP-XJUv6PILHHk6iiZtOr-LK6A8zSC7LFjhdTp5frnLPeP864&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2f7flO7Nyb8DG09b6OrBfVA0y5cqp1M0-CgtWlaZcrlQ&oe=69D63A69"}, {"file_name": "Screenshot5FIX.png", "id": "1445710466398959", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391817_1445710473065625_29208629481560585_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YUQvxzo7q1IQ7kNvwFhpjxi&_nc_oc=Ado0ZGyeu0kWMrdJckYmp-uN6HTM1aE1mtRFmLP6cMq4ChzAOo-VHZBOLNIaWjB77sE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1_sKvtQPpn_iNgd6ekgLu73EJMG6R5rkqOfOAbGMjY8w&oe=69D63BD1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Roxy!", "keywords": [], "long_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget traditional locomotion\u2014utilizing the Gorilla Movement System, you'll glide, climb, and race through serene landscapes with the grace and agility of a tag master. Whether you're chasing or finding inner peace, this is an experience like no other, combining mindful tag gameplay with an immersive style of movement.", "short_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget traditional locomotion\u2014utilizing the Gorilla Movement System, you'll glide, climb, and race through serene landscapes with the grace and agility of a tag master. Whether you're chasing or finding inner peace, this is an experience like no other, combining mindful tag gameplay with an immersive style of movement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacypolicyprojectroxy", "developer_terms_of_service_url": null, "publisher_name": "SplashVRxRoxy132", "support_website_url": null, "website_url": "https://sites.google.com/view/projectroxyfrr", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "29205368785774822"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393608_1447875643285615_4970143688525545979_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2k2HVhup-5YQ7kNvwGw446W&_nc_oc=AdqEU0K6mKBx7y9Hy-eAsUxbvi3YkC8s0iEqMKA_SG07IUWufYn9we8xHyg6mnpJFzQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1LjwKtlJNwSe0dzy5hSoKFlyoD5S2ctKzFofSonMCZWA&oe=69D6388D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Project Roxy!", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "45978150496848
467_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=njjTa5EIdtwQ7kNvwHuZ92Z&_nc_oc=Adq-Dl-zF798NOk__KWpTJvi7fIz50TEGXX3tKg8XHpL23fVifTlBn3MHHbTGgBs8OY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2clWOJAwM9M_nytfSfVLVyfos3UhYspfxHTlwxMXwHuA&oe=69EB6395"}, {"file_name": "Screenshot4FIX.png", "id": "1369860934216429", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391798_1369860937549762_4902722443043180840_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W2n_RPeM7-kQ7kNvwGGtTNI&_nc_oc=AdrpA0IfGR_NcyG-FX3YNgOs0qnTc5ict9niXSEF9arsha5WISzj2UCzXAKqamjBVd8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1E4jZ1XWztT-SBUuo7BL-VdwLhedbkSG0nJPKCfBMfwQ&oe=69EB8AA9"}, {"file_name": "Screenshot5FIX.png", "id": "1445710466398959", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391817_1445710473065625_29208629481560585_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FZFBttNfsFAQ7kNvwEcDfWk&_nc_oc=AdoYP-D-Rnb-CNGQCIFoj0K2uK-CO2WZyC6Jz8-Pkd9rsPTjLBbX9ZtJzLRAJNLBfMw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2yzP7v71ZiviWHTJn2Yxv-3G4B7-JbF2pCdcYejCkTSQ&oe=69EB8C11"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Roxy!", "keywords": [], "long_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget traditional locomotion\u2014utilizing the Gorilla Movement System, you'll glide, climb, and race through serene landscapes with the grace and agility of a tag master. Whether you're chasing or finding inner peace, this is an experience like no other, combining mindful tag gameplay with an immersive style of movement.", "short_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget
467_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mkoo5Qk3ewwQ7kNvwG80xCg&_nc_oc=AdrsTIPAEippKRMS4dWjMXxjffG4WW_1prZCjEfYOxb7kt-DC1xT-gH484aFqbe9MOo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Z9iUgwM5byBpCWePJDU2Qtql-JB4gH-siAE7_7v65WQ&oe=69F9E415"}, {"file_name": "Screenshot4FIX.png", "id": "1369860934216429", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391798_1369860937549762_4902722443043180840_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iQ18bDk53NgQ7kNvwEIStsN&_nc_oc=AdqjoAkndAoQaG6fByFLwjc2MRox_mW-bmYk4m2C8V-xCULyFIQWSH_WPQpuwnt_M84&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7rtyhOmu4J2R5g_Pnc3Wema3HX49txa7Cgqp0Yk8uVpw&oe=69FA0B29"}, {"file_name": "Screenshot5FIX.png", "id": "1445710466398959", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391817_1445710473065625_29208629481560585_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rV-OHY2iZqEQ7kNvwE4Nakr&_nc_oc=AdrdYOC8j1k54Y3CuGYWTUHvDCoVc896Qc9zv_w2cRq6XYakWYx4GjeOw6qE4DQTh6g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43g3wLO_OwViaj5ZNziTi5Ou2q3uCj0nM1Kew7vYhTRw&oe=69FA0C91"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Roxy!", "keywords": [], "long_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget traditional locomotion\u2014utilizing the Gorilla Movement System, you'll glide, climb, and race through serene landscapes with the grace and agility of a tag master. Whether you're chasing or finding inner peace, this is an experience like no other, combining mindful tag gameplay with an immersive style of movement.", "short_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget
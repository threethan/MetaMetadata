467_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PA83Enb9ZugQ7kNvwET4HPF&_nc_oc=AdqU4prU9PYwC_wC75PktPQQXmLXMWxTZd45Nnjhk4WdjDH3oZXuS2YrnNBvRGeoYIs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL89xfviUJlUf84WJZqJ13VrYTrpGgvbyUD5KdTRo6O9g&oe=6A9D5E15"}, {"file_name": "Screenshot4FIX.png", "id": "1369860934216429", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391798_1369860937549762_4902722443043180840_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hti7EFbhNx0Q7kNvwHFz_iG&_nc_oc=AdpE3hd9FiJVn9gdFzU7zlrQ486iVCLIZ8Hfmq3vCuLlQfUaVeKo35rXvR_wOJRt1jw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLo8OkOf_M2mU5VRyvBXV2rzLpScgQMURG1Fct3XYpNfg&oe=6A9D8529"}, {"file_name": "Screenshot5FIX.png", "id": "1445710466398959", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391817_1445710473065625_29208629481560585_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7SkKCSI2YGgQ7kNvwEBkfNY&_nc_oc=AdqghvjGpFg1raM-qpDbw1ATF4zAquKzZreLRkYEhqxeczTEJ8l18Czzbtqb6bdqycs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLgeNnGBjlv2FXm_zUmxJBmyj1wbs2cL2mfwFx6Ps-JDw&oe=6A9D8691"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Roxy!", "keywords": [], "long_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget traditional locomotion\u2014utilizing the Gorilla Movement System, you'll glide, climb, and race through serene landscapes with the grace and agility of a tag master. Whether you're chasing or finding inner peace, this is an experience like no other, combining mindful tag gameplay with an immersive style of movement.", "short_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget
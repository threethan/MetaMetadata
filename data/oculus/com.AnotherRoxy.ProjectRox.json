467_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=50Lcko9TUP0Q7kNvwE_dZX0&_nc_oc=AdrG1bq28D6NWVNbnaY57AtQbK06JU5DiOKfg2sY-yiEqKUpyrfyhQZHJZKGvr8QeCk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qYJUPPxbOrOeCGrLt-DtxkHplhTPlJwLWGMnYDli2og&oe=6A1AD995"}, {"file_name": "Screenshot4FIX.png", "id": "1369860934216429", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391798_1369860937549762_4902722443043180840_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5KmYds_oDzIQ7kNvwGdG2lM&_nc_oc=AdqZMgQ0vNOojgNMi7JQh9QTgShDXHjDiJmdZBzQYjgaCrDpDEHewTGzIYe_KAYcBBE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5roRnG4aO_X0hFF048yB7M3-IA_8N4F94j2Nnw8R3YgA&oe=6A1B00A9"}, {"file_name": "Screenshot5FIX.png", "id": "1445710466398959", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473391817_1445710473065625_29208629481560585_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z0Cj3KQvpjMQ7kNvwH-TfO8&_nc_oc=Adr0VBmxvvNbL5zx0cLr4IGKWgFi003qi5aR7kowJZ5u51yqMX7yzG9f2mXYpnm4zeQ&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5YTydKH4RZUsTRTWB--P6BaqnolDDCYRPT543zHwYI4g&oe=6A1B0211"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Roxy!", "keywords": [], "long_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget traditional locomotion\u2014utilizing the Gorilla Movement System, you'll glide, climb, and race through serene landscapes with the grace and agility of a tag master. Whether you're chasing or finding inner peace, this is an experience like no other, combining mindful tag gameplay with an immersive style of movement.", "short_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget
467_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KQfnz4LyI0wQ7kNvwG6cDKY&_nc_oc=AdogPFTLxFQm_z7LYk6QrAM1qLfSTTGsCkU_AK-9obFBQkOnlZ9tq3lCL_16Q4ryICs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzo89izc6tNyWEkDH8KclaqjG9cW1_3zE5IkMsTxwETVg&oe=69C91C95"}, {"file_name": "Screenshot4FIX.png", "id": "1369860934216429", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391798_1369860937549762_4902722443043180840_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RJG8Pvl-cH4Q7kNvwFK5mQy&_nc_oc=AdqLMgK6jONG5k2weNQ9TozpF8lJuCqEws-YQxvGo143y4CHe7MTkUzdP1nFliY_iYU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzer7QEW31S-hmMqwQG2-r8AiUk8-XafLatuug6xycizQ&oe=69C90B69"}, {"file_name": "Screenshot5FIX.png", "id": "1445710466398959", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391817_1445710473065625_29208629481560585_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TmcEQzew870Q7kNvwF3VKV4&_nc_oc=Adod4Dnqap35C4ewKokjPWER6RgGXah9R0-nmOq6upSRd_OyNngpcE4gStiKobSCP3g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwXIvN3K38NY1pMt4FcCpp-UJMwq4KrCWfszoOtYh2VRw&oe=69C90CD1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Roxy!", "keywords": [], "long_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget traditional locomotion\u2014utilizing the Gorilla Movement System, you'll glide, climb, and race through serene landscapes with the grace and agility of a tag master. Whether you're chasing or finding inner peace, this is an experience like no other, combining mindful tag gameplay with an immersive style of movement.", "short_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget
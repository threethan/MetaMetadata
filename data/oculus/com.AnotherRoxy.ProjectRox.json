467_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=whGkAnI0_0EQ7kNvwHGhrrq&_nc_oc=Adq0hKDT48mV2SUlFVqYiMICAtTM4f-Aal7HRlRlNXV7ZyJ3s0haz1Dh-C9iXXcOZ1U&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af62sP4A6oaeYPrvP6INW2dwv4OI1Ok9y_5vDnnb3q5C-w&oe=6A104D95"}, {"file_name": "Screenshot4FIX.png", "id": "1369860934216429", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/473391798_1369860937549762_4902722443043180840_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iwicLTf8yKcQ7kNvwF6huWz&_nc_oc=Adqbb-52OJ_e3YB_9QQ3dY-t6cFPSx5eMw56Hy8nC-wAVTZ397aRWBxQlrlSrGzrUWk&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Wc2o4Idtgn2ztBF7Tk_RG-14hiEqq5ToDUgZKtCTIzA&oe=6A1074A9"}, {"file_name": "Screenshot5FIX.png", "id": "1445710466398959", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473391817_1445710473065625_29208629481560585_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iz-gAmzsRJ8Q7kNvwHRurwq&_nc_oc=Adptaw3ElKuNgfbOIOaEKeE3v5UULmnHHiKHDvDfBnHZiSZShJTTtrZLLDrSDPWSQMU&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6nNwWsk-SRBwCZUZmCZEVvuCep9v1ToMrMtU25R9ejcw&oe=6A107611"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Roxy!", "keywords": [], "long_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget traditional locomotion\u2014utilizing the Gorilla Movement System, you'll glide, climb, and race through serene landscapes with the grace and agility of a tag master. Whether you're chasing or finding inner peace, this is an experience like no other, combining mindful tag gameplay with an immersive style of movement.", "short_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget
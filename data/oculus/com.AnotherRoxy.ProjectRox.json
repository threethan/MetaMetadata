467_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3DgyZnDBNPMQ7kNvwHKfYSq&_nc_oc=AdrIESTVoKo7Vg-FnbsPITIbMUqDQst_JdilRPfU8Cq7x7Md8zToIYpeiadcRnmJ97Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSs8FnISWrXnC4cuRTgp7pomS4LJ2zAvzW55Tn3i7exA&oe=6ACFAF55"}, {"file_name": "Screenshot4FIX.png", "id": "1369860934216429", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391798_1369860937549762_4902722443043180840_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yp8URR3vJTkQ7kNvwH5IJAt&_nc_oc=AdpokFG7g60xsaGd5O7nPnY1cO1XSu1A26_05wARjN1Fb1YdVS40uD-DlnXGM-KrKqY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM5weSJ9aqhUrBYgo1cpUKTxK1G66k39n2D-t5ywA76Fg&oe=6ACF9E29"}, {"file_name": "Screenshot5FIX.png", "id": "1445710466398959", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391817_1445710473065625_29208629481560585_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nWKg9Gj1o-QQ7kNvwGkHmVh&_nc_oc=AdrUs--EkRlmh-9ckoBAKvyP4stBkRhj8uXjH5Vee4qSS5M_e_lVZ9CaWfEQMWIyrgI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMrr1HU88vwwBbSDFFQyqSFf3xLzvyiMgBd0c-k2lY0GQ&oe=6ACF9F91"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Roxy!", "keywords": [], "long_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget traditional locomotion\u2014utilizing the Gorilla Movement System, you'll glide, climb, and race through serene landscapes with the grace and agility of a tag master. Whether you're chasing or finding inner peace, this is an experience like no other, combining mindful tag gameplay with an immersive style of movement.", "short_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget traditional locomotion\u2014utilizing the Gorilla Movement System, you'll glide, climb, and race through serene landscapes with the grace and agility of a tag master. Whether you're chasing or finding inner peace, this is an experience like no other, combining mindful tag gameplay with an immersive style of movement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacypolicyprojectroxy", "developer_terms_of_service_url": null, "publisher_name": "SplashVRxRoxy132", "support_website_url": null, "website_url": "https://sites.google.com/view/projectroxyfrr", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "29205368785774822"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393608_1447875643285615_4970143688525545979_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hvt1jouu80wQ7kNvwHbKOGZ&_nc_oc=AdolpNFYUZa6hqul-Fu88EWvLonDc_zcawt-0wwknM6VfqKpaAUGHi3mAbdWJ14Pc48&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgz8U8tf7108230wq0Wff0SuZlslZ5AUU4DKULF7T0mg&oe=6ACF9C4D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Project Roxy!", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "45978150496848
467_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kaVQPz3VNcoQ7kNvwH4i0At&_nc_oc=AdovYvITriNh4cEyDDDvppPHv4jtPwGVxFXc89tTf9FxPuBwh8a_V75UqScIDf2_rY8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9L4641Wimsfo0sMoxB7VrBqF2JaAPJAJVPiBJjV9_8A&oe=6A3EAA55"}, {"file_name": "Screenshot4FIX.png", "id": "1369860934216429", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391798_1369860937549762_4902722443043180840_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OiOwGCdO7hkQ7kNvwGf8GDs&_nc_oc=AdqMyvuBgENZ5jb4R2N9toGwUlt6nAQt4K84doI5lU_x0ypw80rxYtIh1XESgPLHmyY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9dnrrg6lp9Qkad4GYhF5hKy8ChhCRpM8L7t2ZbcU2Mow&oe=6A3E9929"}, {"file_name": "Screenshot5FIX.png", "id": "1445710466398959", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391817_1445710473065625_29208629481560585_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Begkms6HE94Q7kNvwEAMd0U&_nc_oc=AdqwYMGkM10QrMcfgzb_0KPUy1RJlOqSjyXaUxPd21PCIZHrum2BIdLhd9sckyHwD5s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_nFz8Rih_rNxlrmNQQVhom1FuhBamzS7gC9x1R_8DwYg&oe=6A3E9A91"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Roxy!", "keywords": [], "long_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget traditional locomotion\u2014utilizing the Gorilla Movement System, you'll glide, climb, and race through serene landscapes with the grace and agility of a tag master. Whether you're chasing or finding inner peace, this is an experience like no other, combining mindful tag gameplay with an immersive style of movement.", "short_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget
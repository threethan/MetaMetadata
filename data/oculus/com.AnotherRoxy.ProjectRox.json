467_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kq4IM7a851IQ7kNvwH-QI65&_nc_oc=Ador6Z_0UReaznOqqoxi-ConMK6RLu-BOR2yhhEZRmos55cyL9k3NicTydK7LealfmI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_K1s8Tied3_DXwY4jeaNCs1mgJDVeUJ7YnmVktbBw_w&oe=6AEB5ED5"}, {"file_name": "Screenshot4FIX.png", "id": "1369860934216429", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391798_1369860937549762_4902722443043180840_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0U3Z4CmcrdgQ7kNvwEjHuTF&_nc_oc=Adq2E_OPtXZCwo6IYDWDgKpPpwZY4IGpmyf1zkPf5vp1P0a5qBVWeoGntRcrRh9ib1g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsad_cGsH-1W4W8IGnUrez4ruRsR89P4MZ_J06ahH5SQ&oe=6AEB4DA9"}, {"file_name": "Screenshot5FIX.png", "id": "1445710466398959", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391817_1445710473065625_29208629481560585_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y3gMbWSeexUQ7kNvwFhE_cD&_nc_oc=AdrQWBIgtfbqZMgxdb-6gflxkdtH0jtboHxPn2-sF8YuR0edtbclk25una3vSLc4nHU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnXdXDBp4fQsT1QeuMxrA7HUYx4SpMtRAqaNaLY08xqw&oe=6AEB4F11"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Roxy!", "keywords": [], "long_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget traditional locomotion\u2014utilizing the Gorilla Movement System, you'll glide, climb, and race through serene landscapes with the grace and agility of a tag master. Whether you're chasing or finding inner peace, this is an experience like no other, combining mindful tag gameplay with an immersive style of movement.", "short_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget
467_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=50Lcko9TUP0Q7kNvwEQEOAk&_nc_oc=Adr2ezI-8joFyKncxTvMJXLoDH-5rFncUd3LJ0kFRib4FuRIGk6XWsriJRmortWXtFQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4hZ8bLtsCOWByC_QEzOw0PmvhhYr2Qf-pxS7xyL47iRQ&oe=6A1D7C95"}, {"file_name": "Screenshot4FIX.png", "id": "1369860934216429", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391798_1369860937549762_4902722443043180840_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2sdy-4TMOEEQ7kNvwHSmEMB&_nc_oc=AdpvmcZbUE6UQM3V96CQMVoz4gzHD4_psbHynw0GrnFnZLfPZyfVr3h7A2BuBFgUsuM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7gMd1GtdEUIwRKqOESHBWh1FnhkUE658wJJflhm98kyQ&oe=6A1DA3A9"}, {"file_name": "Screenshot5FIX.png", "id": "1445710466398959", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391817_1445710473065625_29208629481560585_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z0Cj3KQvpjMQ7kNvwGOK5ja&_nc_oc=AdoHts9UAbjQIiK_q1zL6QYDhBbKJONlaExPiHRcu6BkLlh_PS1cyF0VGC3dBLWDHgI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6oWEkNtpLbLu8g5GpqTSj9wk6WF8MK0QK0F6xi10QddA&oe=6A1DA511"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Roxy!", "keywords": [], "long_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget traditional locomotion\u2014utilizing the Gorilla Movement System, you'll glide, climb, and race through serene landscapes with the grace and agility of a tag master. Whether you're chasing or finding inner peace, this is an experience like no other, combining mindful tag gameplay with an immersive style of movement.", "short_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget
467_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eimfQGQMtTwQ7kNvwH1Y4sR&_nc_oc=AdphBxKCYQuGO69HDJZp9HLHeUhwaBwmgK0xtYePmyMnvXyPhHyJnPI9371g_eDBv5o&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2KYOQkigb3g1QwwkH1S1W9KDjrGoaO3bRpC3aizT9cIg&oe=69E76F15"}, {"file_name": "Screenshot4FIX.png", "id": "1369860934216429", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391798_1369860937549762_4902722443043180840_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KLPfp5cGS38Q7kNvwGy39a_&_nc_oc=Adpq_Ex0wiJ0H90daxWWPChxo_PQPrZq1z-TAljfRIg6Q0ljh8_FHnCTsWs5vv406DM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3GgL9eAMQHmo0H0xRAqVFAX1RyzwNNpgsd9_seRJvQNQ&oe=69E75DE9"}, {"file_name": "Screenshot5FIX.png", "id": "1445710466398959", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391817_1445710473065625_29208629481560585_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h0KKzS_5lL4Q7kNvwELC7cb&_nc_oc=AdpvxrifmF39lz170qMOqg_NyAUzNvwlo8o2eYkHiK2IlOATFz1x2m5a-bJqTJ4qN1A&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0BZxeWIkk6fvvixMKwtIND_cqt4EgN8zicmqRuBdDIuw&oe=69E75F51"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Roxy!", "keywords": [], "long_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget traditional locomotion\u2014utilizing the Gorilla Movement System, you'll glide, climb, and race through serene landscapes with the grace and agility of a tag master. Whether you're chasing or finding inner peace, this is an experience like no other, combining mindful tag gameplay with an immersive style of movement.", "short_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget
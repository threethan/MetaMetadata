467_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vrqEwblKkxQQ7kNvwGH2X6i&_nc_oc=AdqiJcUqXDDWq2CDCmVsP47oM1AdCeO_4r0wpdgjy5avTYESJ6vbCXjXmgDD9AiPvG8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJtvpdS0x5-YeBBiS5wLYhBxZiZb0Rq_Rlqm5Qy7C1j7Q&oe=6A9C0C95"}, {"file_name": "Screenshot4FIX.png", "id": "1369860934216429", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391798_1369860937549762_4902722443043180840_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hti7EFbhNx0Q7kNvwGkxrhZ&_nc_oc=AdoDDccxP1-_q_U_y-P0s1qtllGrejX6JX-wUvl7IIfEBVuQs7eWTClii8JBEQ_LVWA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQItpCOlc4HeZ78THRsQ2pK5ioEuI7JyROxREQymq8OSYw&oe=6A9C33A9"}, {"file_name": "Screenshot5FIX.png", "id": "1445710466398959", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391817_1445710473065625_29208629481560585_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7SkKCSI2YGgQ7kNvwEhIjg8&_nc_oc=Adr0OK50Bt4nohmj7Fyyn-Sqw8NxLOgE32RFT_RZcA2dxCfb1jx6vGPOfFGW8t9dOag&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQJc5VyB20Ip0QL6ooT1FLhv34cKOM1eYreGJVeVi6cA&oe=6A9C3511"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Roxy!", "keywords": [], "long_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget traditional locomotion\u2014utilizing the Gorilla Movement System, you'll glide, climb, and race through serene landscapes with the grace and agility of a tag master. Whether you're chasing or finding inner peace, this is an experience like no other, combining mindful tag gameplay with an immersive style of movement.", "short_description": "Welcome to Project Roxy! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget
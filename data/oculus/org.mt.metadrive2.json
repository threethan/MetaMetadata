1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6mr52fUtUlqpLIjxMKHaalBDn5MNwAmNI3u6C1ypWupA&oe=69FF3157"}, {"file_name": "ss2.png", "id": "922318810221679", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620497_922318813555012_8609403965105406819_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jTOVllx9LsoQ7kNvwE25Hvv&_nc_oc=AdporyGYrgpLKBSLpAQAMxpgpt1jTaMUd-srC3GRNyL2cyGMtHPn8vmtIAcg7qa5Cgg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54MpgDpRC6ugDlGbwVShzk0pBmAzIcW_ZYEo6HiJFBcg&oe=69FF3781"}, {"file_name": "ss3.png", "id": "1456696899411441", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619096_1456696902744774_937299224940435376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OOBvkN9_iWQQ7kNvwFSdK8D&_nc_oc=AdqfWPhSijYeEW8IYZxQOWkdjhxUZTy8U7QO3x3EHlTx2DZBD6xT609JCa5thXM7oGQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7S6o_iPwSzhOwrb169J4AYrULtoymg7kgqYZkcLHZlZA&oe=69FF275F"}, {"file_name": "ss7.png", "id": "884722664110459", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619096_884722667443792_1699510270030591549_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jk5dXJGuBLQQ7kNvwGOjUPP&_nc_oc=AdoxhsLFeMZFN3aSHDpq7sJu_V3TwQZFh8cCgxtNx5i_B2sjeUzTAKxgnQGsgMGlCvw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6mOxCjFUlkrZxjmhnIixPbjFQvgxEGHsTnCLRaxQAzyA&oe=69FF4142"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "herocoverithlabel.png", "id": "3027866350749908", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619715_3027866354083241_4983471968494675087_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MdnYHDCdoAIQ7kNvwGd5OKk&_nc_oc=AdqvxDTOEAWG_HodyJ0zVqxmo9zMMI_hhhd2M3PQdK3jUBAwgkQB6AV2mWJyyP5FZzs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4SKW-QG44Y6l_hkVbzU8YHEN_ZduHI0MUF_T6VvZCv1w&oe=69FF54A9"}, "display_name": "MetaJourney - Long Way Home", "keywords": ["realistic", "driving", "journey", "mission", "tasks"], "long_description": "This game is designed as a purpose-driven driving experience. Players take on passenger pickup and drop-off missions, with each journey offering new routes, challenges, and objectives. The focus is not on racing, but on thoughtful driving, patience, and making the right decisions on the road.\nThe world is built with carefully crafted environments, featuring colorful landscapes, foggy mornings, and varied terrain. Some missions require climbing steep hills, navigating uneven roads, or reaching remote pickup points, making gear selection an important part of successful driving. Knowing when to shift and choosing the right gear directly affects vehicle performance and control.\nDriving mechanics emphasize realism, with authentic vehicle physics and a manual gear shifting system tuned with realistic gear ratios. Players who understand manual transmission driving will find the experience more intuitive and rewarding, while others can gradually learn through practice as they progress.\n\nAn important emotional layer comes from the game\u2019s original, custom-made soundtrack, created specifically to match the mood of each journey. The music, combined with visual atmosphere and purposeful gameplay, aims to create a reflective and emotionally engaging driving experience.\n\nFeatured Original Tracks\n\nWin You Again\nI Will Never Walk Away\nWe Are on the Long Way Home\nWe Just Know\nThe Morning Breaks\nMiles to You\nAnd I Drive\nDriving Through the Autumn\nDown These Country Miles\n\n", "short_description": "A calm, purpose-driven driving experience. Pick up and drop off passengers across colorful levels, foggy mornings, and thoughtfully crafted environments, accompanied by custom-made music. Each trip offers new objectives and moments of reflection. The game features realistic vehicle physics and manual gear shifting. PLAYERS SHOULD KNOW HOW TO USE MANUAL GEAR SHIFTING TO PLAY THE GAME WELL, while others can learn through practice."}]}, "developer_name": null, "developer_privacy_policy_url": "https://maddytroupe.github.io/games-github.io/tspp5", "developer_terms_of_service_url": null, "publisher_name": "Maddy Troupe", "support_website_url": null, "website_url": "https://maddytroupe.github.io/games-github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33037563672558453"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619078_4228022547436537_7646277495757020650_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ljcfQWEJZsQ7kNvwGQD16n&_nc_oc=AdojiUFBlvr_e4Wzmdh-cWyN3MSTLFF3MKdPaVjgbq6gtBJzedsAp0Y2XtchenIWq9g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5QleYRqeJADiBDPwjLmFnoZebIrw7OU1BcygPyxw4Dfw&oe=69FF2656"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MetaJourney - Long Way Home", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1767209520, "lastRevision": {"nodes": [{"id": "32753232380991585", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "
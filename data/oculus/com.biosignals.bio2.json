[{"file_name": "WhatsApp Image 2026-05-25 at 07.47.27 (5).png", "id": "1518142623433828", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491830467_1518142626767161_5137172985598120036_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QF5uKTChUHcQ7kNvwH7HtIK&_nc_oc=Ado5eHTGsQ18uSCgbG-rZ3S658yEgQDat5SGiGcVnwvMfAbTBdlDtmmCLSD4RhvHzrg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEum4rabxjPRI_j3rMjOnSLtCM5C16E1WIq6CoQb3P5sw&oe=6A883859"}, {"file_name": "WhatsApp Image 2026-05-25 at 07.47.27 (2).png", "id": "1704749920659947", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491823259_1704749923993280_5133670849246007793_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HtEMBOAjjB8Q7kNvwF2qqNa&_nc_oc=Adp0j2pkREleLk8ZFQkQWy3XMqt1ls4gDZo0iRsqRRVFbY0u2FHoPyxRUysehKIOMys&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGpF241IyNqqn1En4XPcGCf4RQV6WHWcAKrzS407AvxRg&oe=6A883994"}, {"file_name": "WhatsApp Image 2026-05-25 at 07.47.27 (1).png", "id": "1538127844598395", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491824307_1538127851265061_1901966329140354459_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=he6zV2OEpfYQ7kNvwFFoxZ_&_nc_oc=AdrLxf95yZQLmWZfpJnrkRGRUoMAwz-4LgiAqDzA6Z2_CTucIPRk_AC6wOFm7OG1Vkc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEiHJf154cCdiroM_H5GGIZV0lWNZQXEUcSGMVGeKKP8A&oe=6A885073"}, {"file_name": "WhatsApp Image 2026-05-25 at 07.47.27 (3).png", "id": "1722313502246695", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491825503_1722313505580028_2476327391695792236_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qyBApLgI4SYQ7kNvwHEi5Zq&_nc_oc=AdqNfF0FkoscN8ViwyrlykNK_pfhPH85EW74ZJkCxlNG2EIppu2hy6C20945GipO5yg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQk2fWKo9ULc_O5knf096vemIr5nDL6sHyYrnD3NWgNw&oe=6A883098"}, {"file_name": "WhatsApp Image 2026-05-25 at 07.47.27 (4).png", "id": "1745046990199300", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/585819904_1745046993532633_9080284300547824683_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g9WrtPCexX4Q7kNvwHZ-BYN&_nc_oc=AdoOGjufVmZxDetct2Ma8CBAVMWAi0n1OKYov9tzazLtgjLMn695t7XW6dmcZGxOK2c&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGACaPuh2MzjylsgSbUnod0GW2uXrIahxzT_bafdsVoMA&oe=6A88429C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BioSignals", "keywords": ["biofeedback", "BioSignals", "Eldad", "Wasserman", "BioHackingh"], "long_description": "BioSignals for Meta Quest is an immersive biofeedback training application that brings physiological awareness, relaxation training, and emotional self-regulation into virtual reality.\n\nThe app works with compatible BioSignals sensors to display real-time body responses such as heart activity, HRV, skin conductance, breathing, and stress-related changes. Instead of showing only numbers, BioSignals transforms physiological activity into interactive VR feedback, helping users understand body responses during training.\n\nUsers enter calming virtual environments and practice guided breathing, relaxation, focus, recovery, and self-control exercises. As the user becomes calmer and more regulated, the VR experience can respond visually and dynamically, creating a connection between body, mind, and environment.\n\nThe app exports real-time raw body-signal data and analysis data locally through WebSocket at localhost:8080. Quest app developers can easily read these live signals from the local port and use them for research, integration, visualization, education, or new VR experiences that respond to the user\u2019s physiological state.\n\nBioSignals is suitable for wellness training, stress management, education, research demos, and biofeedback practice. It can be used at home or by therapists, coaches, clinics, and training centers as part of guided training.\n\nBioSignals does not replace medical diagnosis or treatment. It is intended for biofeedback training, wellness, research, and education.", "short_description": "BioSignals for Meta Quest turns biofeedback training into an immersive VR experience. Connect compatible BioSignals sensors to view guided relaxation, breathing, focus, and self-regulation feedback. The app streams real-time raw body signals and analysis data locally via WebSocket at localhost:8080. Quest app developers can easily read these live signals from the local port and use them for research, integrations, visualization, or new VR experiences.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.biosignalsedu.com/privacy-policy/index.html", "developer_terms_of_service_url": null, "publisher_name": "BIO SIGNALS ISRAEL LTD", "support_website_url": null, "website_url": "https://www.biosignals.co.il/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26532031263137446"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/604382710_1334377811947598_4543165768448355941_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=50BwefV-YqEQ7kNvwE564Dg&_nc_oc=Adox3kFnlqnX4h5XP0Q-z3nw4LSVUTElHGDpwA58QNrqs6KP6ldgGmXy6BqeFD9OBik&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmqOPdc1pKddWkAT6nyq6w2nzYoSX3_hrRakuNvqNHDw&oe=6A8825B0"}, "is_concept": fals
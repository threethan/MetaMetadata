9wAGlr0Q7kNvwFvMbUB&_nc_oc=AdpEwh-Ua7E6cC6K6UAFp5JovHR7d46XeALJBq2AbrrQj7tLWYwWSK7qem3iEdLT3io&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNb55P4r9BuIucd1X4_xHLChII89EKhLyxXEpM1q8-kMw&oe=6ADE00EA"}, {"file_name": "home_20261011_164159.png", "id": "1607629787474195", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499628447_1607629790807528_653734221722531984_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1E6HCMctxkIQ7kNvwHhnG6h&_nc_oc=Ador_DB16Ov_RFwQ_KZc-Yo7jJGUE_lKrL3mhWvnK9GwgtL_HRyOHr94ZIvmAfMzjdc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOBow4yVjgxILDc0_rUXPIuxPUl3O2sAkYgInfvlsWvUg&oe=6ADE144D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DepthPlayer", "keywords": ["3D", "video", "player", "movies", "photos"], "long_description": "Turn your everyday 2D videos and photos into immersive 3D - converted in real time, entirely on your Meta Quest. No PC, no cloud, no uploads: everything runs on your headset, and your media stays on your device and your own network. No account, no ads, no tracking.\n\nBring your whole library. Browse files stored on your headset, or stream from your own NAS or home server over SMB, WebDAV or DLNA - movies, shows, home videos and photos all work, and standard formats like MP4 and MKV play as-is. The 3D is generated live, frame by frame, so your files are never modified and never duplicated.\n\nFine-tune the experience while you watch: adjust the 3D depth strength to taste, switch between Standard and Pop-out 3D, or toggle 3D on and off instantly to compare. Enjoy full subtitle and multi-audio-track support, and pick up right where you left off with playback history.\n\nPhotos get the same treatment - open any image and step into it, then swipe through an entire folder, one 3D scene after another.\n\nDepthPlayer is built for privacy and simplicity: no sign-in, no accounts, no telemetry, and no internet connection required for the core experience. Optimized for Meta Quest 3 and Quest 3S. Try it before you buy.", "short_description": "DepthPlayer turns your everyday 2D videos and photos into immersive 3D - converted in real time, entirely on your Meta Quest. No PC, no cloud, no uploads: everything runs on your headset, and your library stays yours. Stream from local storage or your own NAS over SMB, WebDAV or DLNA, adjust 3D depth to taste, and toggle 3D on and off anytime. No account, no ads, no tracking. Try it before you buy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mydtx.github.io/depthplayer/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "MYDTX", "support_website_url": null, "website_url": "https://mydtx.github.io/depthplayer/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_TW", "zh_HK", "zh_CN"], "supported_input_devices": ["GAMEPAD", "HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3731850093621209"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/593734382_28826564440309935_5843426475210372104_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NoiEleZAwkgQ7kNvwFRiyVA&_nc_oc=AdpBcVO77iuVy227k6ET737QtUAyZykvqzXl18MGVJXEDFbAu_HYy7xwZiTNFFZS4RA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMooe-I_0lJX0HscI6vd0CHiG3da4To_6tXcgrRvpBFag&oe=6ADE0F6F"}, "is_concept": false, "is_test": false, "is_trial_offer_vali
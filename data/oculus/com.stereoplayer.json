yTCx_XI6E_w&oe=6AFB3CA7"}, {"file_name": "05_cloud_drives.png", "id": "2608843539561952", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/593801605_2608843542895285_5250470013456843260_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7FIu6Uu0msEQ7kNvwGRYI14&_nc_oc=AdqQi3ni_oF1Q46e57VvOgE8CXI82EjaQSOaYld4bIXvGvADJVFLdozKWpP3AVYqXEw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNzBK-_l5TQqGlzlZWCbrvsfzECYmw6dWwTWiECMIm8w&oe=6AFB41E7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DepthPlayer", "keywords": ["3D", "video", "player", "movies", "photos"], "long_description": "Turn your everyday 2D videos and photos into immersive 3D - converted in real time, entirely on your Meta Quest. No PC, no cloud, no uploads: everything runs on your headset, and your media stays on your device and your own network. No account, no ads, no tracking.\n\nBring your whole library. Browse files stored on your headset, or stream from your own NAS or home server over SMB, WebDAV or DLNA - movies, shows, home videos and photos all work, and standard formats like MP4 and MKV play as-is. The 3D is generated live, frame by frame, so your files are never modified and never duplicated.\n\nFine-tune the experience while you watch: adjust the 3D depth strength to taste, switch between Standard and Pop-out 3D, or toggle 3D on and off instantly to compare. Enjoy full subtitle and multi-audio-track support, and pick up right where you left off with playback history.\n\nPhotos get the same treatment - open any image and step into it, then swipe through an entire folder, one 3D scene after another.\n\nDepthPlayer is built for privacy and simplicity: no sign-in, no accounts, no telemetry, and no internet connection required for the core experience. Optimized for Meta Quest 3 and Quest 3S. Try it before you buy.", "short_description": "DepthPlayer turns your everyday 2D videos and photos into immersive 3D - converted in real time, entirely on your Meta Quest. No PC, no cloud, no uploads: everything runs on your headset, and your library stays yours. Stream from local storage or your own NAS over SMB, WebDAV or DLNA, adjust 3D depth to taste, and toggle 3D on and off anytime. No account, no ads, no tracking. Try it before you buy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://depthplayer.app/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "MYDTX", "support_website_url": null, "website_url": "https://depthplayer.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_TW", "zh_HK", "zh_CN"], "supported_input_devices": ["GAMEPAD", "HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3766815353458016"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/593734382_1450943280339439_1964694441213895477_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EVCLVNfvf6cQ7kNvwEPUECF&_nc_oc=Ado3fz5mZK7yV2N5PdyTFm41TlHVhpMdzE-u6bAa8vP-b_qWmeeaZ1AduqmEORUREeM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSnEmw2Kh1Z7JdZj0cOXCA6u1CEOF2tqqT7tuAC1U2Yw&oe=6AFB17EE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "DepthPlayer", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_
0f&oh=00_AQQBGkoJ44bKsJ40Ie0yAe61NYXjWd7UyWIz1itqZbTJWg&oe=6AFB2C73"}, {"file_name": "home_20261011_163737.png", "id": "2203953857143188", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/593872736_2203953863809854_1428461755083669806_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u0WL2p8xcsUQ7kNvwE2oBQa&_nc_oc=AdphRZXhPkqoIKQjus_vBRpHgclTLmImcLnrc_KQNWnnqJZlbahKOoCpvoE9q7msqMo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRmO20bgHD-Jj-8et9TS3f32GIdRw1YWqcWpawojJtuQ&oe=6AFB359F"}, {"file_name": "home_20261011_163951.png", "id": "1603444311527543", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/593853621_1603444314860876_3799381909118524046_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hH11-UC1GG8Q7kNvwFvjitP&_nc_oc=AdrKGBBNj995oJka4O9R6xYVVcmvgFVX5SwB1xxusRqOGouEFaZLqdAwxJdXGc7gcps&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNudkl-zOxJtp5Ucg2-IN9WPaWgMAPfZIsz96SvjSsXw&oe=6AFB3A2A"}, {"file_name": "home_20261011_164159.png", "id": "1607629787474195", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499628447_1607629790807528_653734221722531984_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9O9O1ZhQYqcQ7kNvwGy-re7&_nc_oc=AdrlAeAuTXmxnLri8FwCmK9Uedi0CBF96E7yVy98DOw4SbAQiqYMWKrxAHf5EeUp-jk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSg90dQMeubUV0LDI541WdxD6C2PDRdBCc8h8WFen6Psw&oe=6AFB154D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DepthPlayer", "keywords": ["3D", "video", "player", "movies", "photos"], "long_description": "Turn your everyday 2D videos and photos into immersive 3D - converted in real time, entirely on your Meta Quest. No PC, no cloud, no uploads: everything runs on your headset, and your media stays on your device and your own network. No account, no ads, no tracking.\n\nBring your whole library. Browse files stored on your headset, or stream from your own NAS or home server over SMB, WebDAV or DLNA - movies, shows, home videos and photos all work, and standard formats like MP4 and MKV play as-is. The 3D is generated live, frame by frame, so your files are never modified and never duplicated.\n\nFine-tune the experience while you watch: adjust the 3D depth strength to taste, switch between Standard and Pop-out 3D, or toggle 3D on and off instantly to compare. Enjoy full subtitle and multi-audio-track support, and pick up right where you left off with playback history.\n\nPhotos get the same treatment - open any image and step into it, then swipe through an entire folder, one 3D scene after another.\n\nDepthPlayer is built for privacy and simplicity: no sign-in, no accounts, no telemetry, and no internet connection required for the core experience. Optimized for Meta Quest 3 and Quest 3S. Try it before you buy.", "short_description": "DepthPlayer turns your everyday 2D videos and photos into immersive 3D - converted in real time, entirely on your Meta Quest. No PC, no cloud, no uploads: everything runs on your headset, and your library stays yours. Stream from local storage or your own NAS over SMB, WebDAV or DLNA, adjust 3D depth to taste, and toggle 3D on and off anytime. No account, no ads, no tracking. Try it before you buy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mydtx.github.io/depthplayer/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "MYDTX", "support_website_url": null, "website_url": "https://mydtx.github.io/depthplayer/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_TW", "zh_HK", "zh_CN"], "supported_input_devices": ["GAMEPAD", "HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3731850093621209"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1961827888436648"}, {"status": "PUBLISHED", "id": "1308777642327195"}]}, "baseline_offer": {"id": "1308777642327195"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "1961827888436648"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "3767983560007862", "version": "1.4.1"}, "id": "1432557379020429", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3731850090287876", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "3767983560007862"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1432557379020429"}]}, "change_log": "A fresh new look, a faster and sharper 3D conversion, and playback-history previews.\r\n\r\n- Redesigned interface: a new home screen with Continue Watching, cleaner library and settings pages, and refreshed player controls.\r\n- Faster, sharper 3D: the on-device depth conversion updates more frequently and follows head motion more closely, with cleaner object edges.\r\n- Playback history now shows a preview frame from the exact moment you stopped watching, so you can jump back into the right scene instantly.\r\n- Fixed: on network shares (SMB), folders could be listed but not opened in the release build.", "created_date": 1794110794, "id": "3767983560007862", "version": "1.4.1", "version_code": 12, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3731850090287876", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "3767983560007862"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1432557379020429"}]}, "change_log": "A fresh new look and a faster, sharper 3D conversion.\r\n\r\n- Redesigned interface: a new home screen with Continue Watching, cleaner library and settings pages, and refreshed player controls.\r\n- Faster, sharper 3D: the on-device depth conversion now updates more frequently and follows head motion more closely, with cleaner object edges and silhouettes.\r\n- Playback history now shows a preview frame from the exact moment you stopped watching, so you can jump back into the right scene instantly.", "created_date": 1794019679, "id": "3766522630153955", "version": "1.4.0", "version_code": 11, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3731850090287876", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "3767983560007862"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1432557379020429"}]}, "change_log": "Playback history now shows a preview frame: each entry displays a still from\r\nthe exact point where you stopped watching, together with its progress and\r\ntime, so you can see at a glance what you were in the middle of and resume\r\nright there.", "created_date": 1793891824, "id": "3764444383695113", "version": "1.3.0", "version_code": 10, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3731850090287876", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "3767983560007862"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1432557379020429"}]}, "change_log": "Optional diagnostic report: Settings now has \"Report a problem\". It shows you exactly what will be sent - device model, system and app versions, display and decoder information, recent logs and any crash trace - before anything leaves your headset. Nothing is uploaded unless you tap Send, and reports never include file names, account emails or access tokens.", "created_date": 1793790954, "id": "3762804347192450", "version": "1.2.1", "version_code": 9, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3731850090287876", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "3767983560007862"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1432557379020429"}]}, "change_log": "1.2.0\r\n\u2022 Connect your OneDrive and stream your cloud library directly in DepthPlayer.\r\n\u2022 Cloud accounts are optional and can be removed at any time.\r\n\u2022 Playback stability improvements.", "created_date": 1792825376, "id": "3748145178658367", "version": "1.2.0", "version_code": 8, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
A&oe=6A9ED7C8"}, {"file_name": "shot4_result.png", "id": "1677415553509023", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619704_1677415556842356_5121906156636518218_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Na8w5NSjfBoQ7kNvwGQkZKQ&_nc_oc=Adr9s1B8BvU5TbgSTf8KnFiWLtkIIVNt0vAR9WH5rUPMOmyAkJ_iuPN5GOdN2GYwIjs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKTO64p6Q2Se09oLfQlXptgMJ3hVzWpkAHZ-9A17mYzAg&oe=6A9EE052"}, {"file_name": "shot1_action.png", "id": "1493376888772966", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619187_1493376895439632_1023077915713755267_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a-nFcMY-F3MQ7kNvwGm-mZn&_nc_oc=AdpEUsbwqyiMqwo3fRkLM2BFtVRGGiLcmeTuUJ7xtVjRWsPB1XkZ9dTz1CqLiFni-jA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI17eONzS0l9Vt86XAzeiKShymc5YqiXSjmXBx0n84ovA&oe=6A9EAD99"}, {"file_name": "shot3_menu.png", "id": "1532772041905256", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499303455_1532772045238589_7173531441927282786_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ReZYo9h79aIQ7kNvwG9iZmF&_nc_oc=AdoLHptZZPKwUEiYTgBjk8U-jCabL5oJ3svxkRCrzb-xtXEkjr9jJ0A2JicLeaWZfBk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHNJBzoO17xHAoaJTNd2hBv1-myIzJwJhW67rWR8zOOg&oe=6A9EC5D0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pulse Blade VR", "keywords": [], "long_description": "Pulse Blade VR is a fast, neon rhythm slasher for Meta Quest. Wield an energy blade in each hand and carve through streams of glowing notes in time with the music \u2014 red notes for your left blade, blue for your right \u2014 slicing in the direction the arrows point while you dodge the bombs.\n\nEvery clean cut builds your combo multiplier (x1 to x8) and lights up the arena. String together full-combo runs, chase precision \"Perfect\" cuts for bonus points, and survive as your energy gauge drains on every miss.\n\nFEATURES\n- Two-handed energy-blade slashing with directional cuts and precision scoring\n- Three difficulties (Easy / Normal / Hard) from gentle warm-ups to dense, bomb-laced charts\n- A dark neon arena: Tron-style grid, glowing gateway, pure-black void\n- Combo multipliers, an energy/fail meter, and a per-track high-score chase\n- Earn coins as you play and grow your run\n- Built natively for Meta Quest with smooth, comfortable, stationary play\n\nGrab the blades, feel the pulse, and slash to the beat.", "short_description": "Slash to the beat in VR. Carve glowing notes with two energy blades as the music drives every strike \u2014 build huge combos, dodge bombs, and climb the leaderboards. A neon rhythm slasher built for Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://pulse-blade-privacy.pages.dev/", "developer_terms_of_service_url": null, "publisher_name": "NVR Labs", "support_website_url": null, "website_url": "https://pulse-blade-website.pages.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1225275267332810"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308046_1328835486069270_2528067177620320663_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ISjKaonXKZwQ7kNvwEwSlSX&_nc_oc=Adp4ST2iQwAOgMM_XO
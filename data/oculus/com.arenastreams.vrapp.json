&_nc_ohc=HCdXJ7sa9ZwQ7kNvwH1id5S&_nc_oc=AdqNt5N7u6XB_-db-91SQ2ihlmqQfsDonf9E58fDGO9FrJ4Hkj5Mf2osMoaXK-q1LKY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDzvoZWw_0ubOBcpGDxCw92PyF3mZk40lrBf17b9PBkA&oe=6AE74F50"}, {"file_name": "Corda Arena - ArenaStreams - Posters 2 (landscape).png", "id": "1064036452653481", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830576_1064036455986814_3507810251832423772_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8c-GMwRpGEYQ7kNvwHDbyMw&_nc_oc=AdrlRKx-aLsptgEjpoD4aqefTW99bDjS3Q7XfQ0fWm_BAuyXFY-3wWjKsFFUwg6EMko&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdOJR7_KVaRF63ghlB3PtyQmIUnTjdgqZUmAtaypZnyg&oe=6AE73EFB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ArenaStreams VR", "keywords": ["virtualreality", "liveevents", "immersivestreaming", "networking", "vod"], "long_description": "Experience Corda Arena. Wherever you are.\n\nArenaStreams VR is the official VR app of Corda Arena, bringing live events from the physical venue into an immersive virtual environment.\n\nStep inside the virtual Corda Arena, explore the Lobby and meet other visitors before the event begins. Connect with friends, network with other attendees at the virtual bar and experience the social side of an event \u2014 all from within VR.\n\nWhen the event starts, head to the first floor and experience live content through 180\u00b0 stereoscopic streaming, creating a sense of depth and presence that brings you closer to actually being there.\n\nWith multicamera streaming, ArenaStreams lets you experience events from different perspectives, creating a new way to watch conferences, talks, shows and other live experiences at Corda Arena.\n\nArenaStreams goes beyond live events. With Video on Demand, Arena users can revisit available event recordings and discover inspiring and innovative content whenever they want.\n\nBy bringing together immersive technology, live content and human connection, ArenaStreams extends Corda Arena beyond the physical venue.\n\nOne Arena. A whole new perspective.", "short_description": "ArenaStreams VR is the official VR app of Corda Arena. Step inside the virtual venue, meet and network with other visitors, and experience live events through immersive 180\u00b0 stereoscopic multicam streaming. Revisit events and discover inspiring content with Video on Demand. ArenaStreams brings together live content, immersive technology and human connection \u2014 wherever you are."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.corda-arena.com/privacy-policy", "developer_terms_of_service_url": "https://www.corda-arena.com/end-user-license-agreement-arenastreams", "publisher_name": "Corda Campus 2.0 NV", "support_website_url": "https://www.corda-arena.com/contact", "website_url": "https://www.corda-arena.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2687655338230691"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1409688525552711"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827601_2472050533290659_7338510305820777106_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=blFvGxhNlWQQ7kNvwG5qek2&_nc_oc=AdrEcNkLOTrP4Wppy74tsa2Ap3E-x2B68HAUY56UOtXHi3SdXsn52Yy-uf1c8Xs2q2k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRD_HQ8o2pMK0h5xWB7qVIC53zVBZiAyC
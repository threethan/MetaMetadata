95917163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FYgCWupOvzwQ7kNvwF-rNT7&_nc_oc=AdryFA7HgmnPRFHt5gvk0M-xKl3DsJF90ot27pnVXFEDaW1R64DDfg3Q4FtXLqPk6Fk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNDaKy7BIlgxBk1srWcqcL7NaADIRENz4UHIon1yPdIUw&oe=6AD2474C"}, {"file_name": "ScreenShot04_2560x1440.png", "id": "1270074803649292", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974514_1270074806982625_5335865005242226290_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R330IaeXb0EQ7kNvwGeJmOF&_nc_oc=Adob_BGABeLevS-QuHqoPts_vWX455rZ2jZpxsLtqWibZC4YZ2SUg8-XTQpyUpaTFKA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMczsqZl-TuGjE3M930gL7BqPnXQran6oydO5pui4J8kQ&oe=6AD23391"}, {"file_name": "ScreenShot02_2560x1440.png", "id": "813144287027038", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036623_813144293693704_3049302096086576569_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4lHIpDhracgQ7kNvwGBXjlc&_nc_oc=AdrVxrd6QSAbHbwHsXgM7rx9a0OnCKAlqe39lkFe_AKXXcf-Pu5byjscXjBYX-QkDF0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMOjuX2p-DNGz70N6BWUtBWQWIlRvlw5w2BgP4uBgcIMw&oe=6AD24259"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Movie2560x1440.png", "id": "230455106575015", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974884_230455109908348_2198088300040870805_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h8WLsCezn7YQ7kNvwFsLLhR&_nc_oc=AdqWMVzKqPtUyufDmouZBfav250o1RLwAz7L5ZXjlvZYz6WiLU7XFgu9pEFhQeeVyPI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPKVxH2Cm9hfKjpnjefWoAFgpFW6Vt_aNB1yQZL6MidnA&oe=6AD252E5"}, "display_name": "Angry Maze VR", "keywords": [], "long_description": "The maze is angry. While playthings have evolved from paper and pencils to VR, maze gameplay has remained unchanged. Mazes have been underestimated and labeled as old-fashioned because their play methods haven't evolved. It's not that mazes themselves are outdated, but rather that their gameplay hasn't been updated. Could this be the reason why mazes are no longer played as much? That's where \"Angry Maze VR\" comes in, aiming to evolve mazes in sync with VR. Give it a go and experience the evolved maze in VR.", "short_description": "The maze is angry. You know what? It's not the maze that's old, it's us humans who can't evolve it. But fear not, because the maze is evolving with VR. Can you play in the evolved maze? Or are you stuck with the same old maze?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dmaze2020.wixsite.com/angry-mazes-vr/post/privacy-policy", "developer_terms_of_service_url": "https://3dmaze2020.wixsite.com/angry-mazes-vr/post/terms-of-service", "publisher_name": "https://twitter.com/3DMazeXR", "support_website_url": null, "website_url": "https://3dmaze2020.wixsite.com/angry-mazes-vr", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "155425400763364"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "651311846810497"}]}, "baseline_offer": {"id": "651311846810497"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1689622320, "status": "PUBLISHED", "id": "651311846810497"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9765195246935139", "versio
40.png", "id": "806023557568838", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39036671_806023560902171_1298265399802487151_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ffRPT7mxk4IQ7kNvwH6gQN1&_nc_oc=AdkUi11aqZrvE3sLyDpGHhO8e-iX0ZbDv-_EYITOzH5meGqrOazrvNBwui_DeLArWzI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afu-sglVXnc4hGfIhx8n360c9P7YcvAy8ipG8OEsZj-fFA&oe=69A57A55"}, {"file_name": "ScreenShot05_2560x1440.png", "id": "3444230189153102", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974914_3444230192486435_762526293595917163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LOKAVQSYrBkQ7kNvwEHEUg3&_nc_oc=AdlT7fkGikoHJmdAfhAoqy1l-5KuocflCyGgMrXh3lS7WgLFwZwxEXjqSkd1AWQC448&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfvGsKiMgvcaB7VSUqA8OjQTtMLigm9dGwgFpuC8nPZSfw&oe=69A5790C"}, {"file_name": "ScreenShot04_2560x1440.png", "id": "1270074803649292", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974514_1270074806982625_5335865005242226290_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ClkdS0oyf0IQ7kNvwHn2wil&_nc_oc=Adkqp4vITuigUf9NxifWgPkA1i-UNQsD2yUHkN1fZqGRZTXzAW2-QcVraHtb-baleoQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftwvPiiCYg_NLZSmme4n-jpCznV3_CIikfkyh_5P4206Q&oe=69A59D91"}, {"file_name": "ScreenShot02_2560x1440.png", "id": "813144287027038", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39036623_813144293693704_3049302096086576569_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JGiYL6eSuDgQ7kNvwEZVdeR&_nc_oc=Adm4_CbIW406vZfShCS8uBBQBWDx-byXI5mZtdDb89yAkhy47Tba63ixsBSqn8SZpRg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftX5dVFPTkMEoIDJwHg9mF_XcF0_3iG_vuOY1yTCFHdiA&oe=69A57419"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Movie2560x1440.png", "id": "230455106575015", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974884_230455109908348_2198088300040870805_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hEgAGgdgWbAQ7kNvwGpy7Iq&_nc_oc=AdkHlFwQeXC_QsBtAW5p0a4zs3uUrqGzevl4uQKH71xLMw9OrlKfeT2rUIR2dtAC4AE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afs7jn0oX9k_OpPtmbAJBTnvn6Ckm_0V9m7eTaDRtc63KA&oe=69A584A5"}, "display_name": "Angry Mazes VR", "keywords": [], "long_description": "The maze is angry. While playthings have evolved from paper and pencils to VR, maze gameplay has remained unchanged. Mazes have been underestimated and labeled as old-fashioned because their play methods haven't evolved. It's not that mazes themselves are outdated, but rather that their gameplay hasn't been updated. Could this be the reason why mazes are no longer played as much? That's where \"Angry Mazes VR\" comes in, aiming to evolve mazes in sync with VR. Give it a go and experience the evolved maze in VR.", "short_description": "The maze is angry. You know what? It's not the maze that's old, it's us humans who can't evolve it. But fear not, because the maze is evolving with VR. Can you play in the evolved maze? Or are you stuck with the same old maze?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dmaze2020.wixsite.com/angry-mazes-vr/post/privacy-policy", "developer_terms_of_service_url": "https://3dmaze2020.wixsite.com/angry-mazes-vr/post/terms-of-service", "publisher_name": "https://twitter.com/3DMazeXR", "support_website_url": null, "website_url": "https://3dmaze2020.wixsite.com/angry-mazes-vr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"
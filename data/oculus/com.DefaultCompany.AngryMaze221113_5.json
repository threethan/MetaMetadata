&oh=00_AQOGs6kzmuPKZhZcqquW2VB1iswW45OTpMPHbALctn18yg&oe=6ADCDB60"}, {"file_name": "ScreenShot01_2560x1440.png", "id": "806023557568838", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036671_806023560902171_1298265399802487151_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DD-uSL1TJxkQ7kNvwHP5eXh&_nc_oc=Adq1GALC3Q2PnSHFekDJe-jEo53PalXrQS88jbsDpmAliM4PcMx59nqyLOFOHMdPmpc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNSTiONBZ1zyRPaNmRJ3QX7PMA-dbnAMHfM92hWdQ244g&oe=6ADCD495"}, {"file_name": "ScreenShot05_2560x1440.png", "id": "3444230189153102", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974914_3444230192486435_762526293595917163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UZeOxrCyiS8Q7kNvwFjgmxs&_nc_oc=AdpvHAUOprnKhM3OpY6Z5VKDp4K52H0CYe73JfhCTbQOLYeidJF4OkC3RxDg9IAAqMw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFDpy2w4GPyc5CnmkMRn3o9lawuVIgAct3iEex0URolg&oe=6ADCD34C"}, {"file_name": "ScreenShot04_2560x1440.png", "id": "1270074803649292", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974514_1270074806982625_5335865005242226290_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p7ejMFbrSSUQ7kNvwHTAagd&_nc_oc=Adqw-ajYxzpXDTfcQTSp8cytibD267fZ3dYaPrJHUqBYJZx-ATlZf0EebIS6Q6-js_Q&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNioh6zYPoB_9BfpmGWlzmLzTYKdnHMylN__qX5R1VjUg&oe=6ADCBF91"}, {"file_name": "ScreenShot02_2560x1440.png", "id": "813144287027038", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036623_813144293693704_3049302096086576569_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b_phCfrGyrMQ7kNvwEZaZU8&_nc_oc=AdqnAOABCB8xAmAWpERpqGL7-lyLevi3ZWx-CN3ghO8YB3Nga9BJ3IPX3F5adk59iCM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNMG57Yb35iEI2Fvz3tBBh_Vh5CrvO1faLnZaS0MRGGAA&oe=6ADCCE59"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Movie2560x1440.png", "id": "230455106575015", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974884_230455109908348_2198088300040870805_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9COMECGR3LQQ7kNvwFj5PCJ&_nc_oc=Adqt8HzR42-pVdBMja_U_fXvDXyaaR-TVWu3dyeDNNzQGP4A3yTCSakL7N7XneRF5K8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN5ckywyQYH5YyMRgTsl8pHrdQr1FW4pE2qJ0XGNtK0rA&oe=6ADCA6A5"}, "display_name": "Angry Mazes VR", "keywords": [], "long_description": "The maze is angry. While playthings have evolved from paper and pencils to VR, maze gameplay has remained unchanged. Mazes have been underestimated and labeled as old-fashioned because their play methods haven't evolved. It's not that mazes themselves are outdated, but rather that their gameplay hasn't been updated. Could this be the reason why mazes are no longer played as much? That's where \"Angry Mazes VR\" comes in, aiming to evolve mazes in sync with VR. Give it a go and experience the evolved maze in VR.", "short_description": "The maze is angry. You know what? It's not the maze that's old, it's us humans who can't evolve it. But fear not, because the maze is evolving with VR. Can you play in the evolved maze? Or are you stuck with the same old maze?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dmaze2020.wixsite.com/angry-mazes-vr/post/privacy-policy", "developer_terms_of_service_url": "https://3dmaze2020.wixsite.com/angry-mazes-vr/post/terms-of-service", "publisher_name": "https://twitter.com/3DMazeXR", "support_website_url": null, "website_url": "https://3dmaze2020.wixsite.com/angry-mazes-vr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_
95917163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=znSmZpFMUuoQ7kNvwHkkPuG&_nc_oc=Adq7xkPCPQ8bSHLcBxVAU6uJHjtCV5rCPMHRMnnhAKLpBG1ZUiHKjPD8snSGJA8IV5M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGkBEgnnQZx8bh5-QqnE6yy8qGp0nm1nHACgyvnwaYd6w&oe=6A7B0C0C"}, {"file_name": "ScreenShot04_2560x1440.png", "id": "1270074803649292", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974514_1270074806982625_5335865005242226290_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DkTB8hWwdfMQ7kNvwGxpOJi&_nc_oc=AdoNuYJ-xllhd7W_D2jMc_j9SDdFe3UPBModZ7zwPzV54AnwP4VInucVJcZMNpmhDEk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHLSd1HvIusUj0WofJNhbJfgH5hfIcSYteBPEMC6NNWOA&oe=6A7B3091"}, {"file_name": "ScreenShot02_2560x1440.png", "id": "813144287027038", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036623_813144293693704_3049302096086576569_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zHR7Vhtyc28Q7kNvwHwjUfX&_nc_oc=AdqkkxxZ8O5MVzik1gN-YP1mjdnAlqkAjaktJ40kKjv4VOPRqRzhv2xCCOpNXxb0M4U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMlcMy2I1BI_Uu8etGtcxjhVdx19lWIh0sDwpq-NwQnw&oe=6A7B0719"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Movie2560x1440.png", "id": "230455106575015", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974884_230455109908348_2198088300040870805_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cAD2kylptPkQ7kNvwHKB8Wz&_nc_oc=Adpw84cl7RM6EaTP0MaRJgvvLUZ8qRdBmV6dDy74LAjPhaO8DKtR9g73FdIgVisWUlQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFwzRhHUKHqEjNmK4MPdQQ90A4RexPbeyLX-OWs8DTH6Q&oe=6A7B17A5"}, "display_name": "Angry Maze VR", "keywords": [], "long_description": "The maze is angry. While playthings have evolved from paper and pencils to VR, maze gameplay has remained unchanged. Mazes have been underestimated and labeled as old-fashioned because their play methods haven't evolved. It's not that mazes themselves are outdated, but rather that their gameplay hasn't been updated. Could this be the reason why mazes are no longer played as much? That's where \"Angry Maze VR\" comes in, aiming to evolve mazes in sync with VR. Give it a go and experience the evolved maze in VR.", "short_description": "The maze is angry. You know what? It's not the maze that's old, it's us humans who can't evolve it. But fear not, because the maze is evolving with VR. Can you play in the evolved maze? Or are you stuck with the same old maze?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dmaze2020.wixsite.com/angry-mazes-vr/post/privacy-policy", "developer_terms_of_service_url": "https://3dmaze2020.wixsite.com/angry-mazes-vr/post/terms-of-service", "publisher_name": "https://twitter.com/3DMazeXR", "support_website_url": null, "website_url": "https://3dmaze2020.wixsite.com/angry-mazes-vr", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "155425400763364"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "651311846810497"}]}, "baseline_offer": {"id": "651311846810497"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1689622320, "status": "PUBLISHED", "id": "651311846810497"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9765195246935139", "versio
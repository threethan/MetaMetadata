40.png", "id": "806023557568838", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036671_806023560902171_1298265399802487151_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ffRPT7mxk4IQ7kNvwHCvisD&_nc_oc=AdlmhCLqUSD0dYTTDU3lIFfcMbHIaMHAeXvg5v-WGfPL-jJO6hPgwYnN3E92GBr3eeI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftILtfZMmaWaeOvP-LMPRI0sorCyxpTiv6Akkoyvm4P8A&oe=69A428D5"}, {"file_name": "ScreenShot05_2560x1440.png", "id": "3444230189153102", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974914_3444230192486435_762526293595917163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LOKAVQSYrBkQ7kNvwFnlNOX&_nc_oc=AdmbJ_PsEBpgBQJfFoLZTpSq9QgTp1sIt7aSTSV1Rg4gkXC5MWsyAVEuL5ckdUbLs5E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuyxqPvMWgb0W_xeOBCeWM7w9i3OEZck2E2NGiAKBiu9g&oe=69A4278C"}, {"file_name": "ScreenShot04_2560x1440.png", "id": "1270074803649292", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974514_1270074806982625_5335865005242226290_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mzkscwZumLsQ7kNvwFmp94X&_nc_oc=AdmFfpN0K7aaCjzo8wo65oTMCk7dEgReMosA4WiSeiVEy6LTdmmUjh8sLsNCrgjNDZc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afs35kuvU7TgXtf6-PQjJ3i4sJyaHjVyq5Tuj9WwYIbFYA&oe=69A44C11"}, {"file_name": "ScreenShot02_2560x1440.png", "id": "813144287027038", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036623_813144293693704_3049302096086576569_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JGiYL6eSuDgQ7kNvwFH_m6s&_nc_oc=AdlA1BS_3_Jt0J-jbfCxl4Is3GWnF4yEmWim08NS_ObtK_dPmVelsmMwT_KAEsH42JY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftLg1TXECresfdl9ssfmlfXT6xiCynDEmTAIm6JUP0pNw&oe=69A42299"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Movie2560x1440.png", "id": "230455106575015", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974884_230455109908348_2198088300040870805_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hEgAGgdgWbAQ7kNvwFDKgMn&_nc_oc=AdmpT_idiEGmBTJT6d6s4qnrSi0Amei3fmeuVgjTUscRTd2BGqkB-1e5oVQmM5aLg8U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuglqQbe_ImI3XJMfQZRnPph6mmh8ZtSoSBkYLzasgHew&oe=69A43325"}, "display_name": "Angry Mazes VR", "keywords": [], "long_description": "The maze is angry. While playthings have evolved from paper and pencils to VR, maze gameplay has remained unchanged. Mazes have been underestimated and labeled as old-fashioned because their play methods haven't evolved. It's not that mazes themselves are outdated, but rather that their gameplay hasn't been updated. Could this be the reason why mazes are no longer played as much? That's where \"Angry Mazes VR\" comes in, aiming to evolve mazes in sync with VR. Give it a go and experience the evolved maze in VR.", "short_description": "The maze is angry. You know what? It's not the maze that's old, it's us humans who can't evolve it. But fear not, because the maze is evolving with VR. Can you play in the evolved maze? Or are you stuck with the same old maze?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dmaze2020.wixsite.com/angry-mazes-vr/post/privacy-policy", "developer_terms_of_service_url": "https://3dmaze2020.wixsite.com/angry-mazes-vr/post/terms-of-service", "publisher_name": "https://twitter.com/3DMazeXR", "support_website_url": null, "website_url": "https://3dmaze2020.wixsite.com/angry-mazes-vr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"
&oh=00_Af-LxNDUFXi0cyddenOotkhcqMrzcHHcovX_L3M-Cb5jZA&oe=6A295720"}, {"file_name": "ScreenShot01_2560x1440.png", "id": "806023557568838", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036671_806023560902171_1298265399802487151_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DFuiNGuhmqUQ7kNvwGRek_e&_nc_oc=AdojqMRhUoezm-LrRNMXRFrZBVjudcRxEH6zxX-Y2Xwy-MwOfpKJbWXpKvLJuRjqOa8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_lmZTy24IQuz6aBVWhtBXx4136EOuShV4r3XUNE2aanA&oe=6A298895"}, {"file_name": "ScreenShot05_2560x1440.png", "id": "3444230189153102", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974914_3444230192486435_762526293595917163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L1sOk8yLKNcQ7kNvwHCXYvF&_nc_oc=AdrI0pCsUEhC9Hagiyz6V5F6D9sHgShka_1BfaOUaEC9qYH3aG-WbdqV1IqULlZBTj0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_rS5y0chylYh-703cnlbg1ESt4HCj2eaL0tjRNYqcg2g&oe=6A29874C"}, {"file_name": "ScreenShot04_2560x1440.png", "id": "1270074803649292", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974514_1270074806982625_5335865005242226290_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9IM6vdURBdoQ7kNvwHhBHf4&_nc_oc=Adpk9lAMSmynwNWBcCTGe9dQUt-zSqW6dgcWisevQjpqrqglkgjYqx9sTqOspA1EASk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Pw23P0r9BYkujfUK8vWALNpk1lHRZoDE5e77GRj2qig&oe=6A297391"}, {"file_name": "ScreenShot02_2560x1440.png", "id": "813144287027038", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036623_813144293693704_3049302096086576569_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jcUbsOQUtUEQ7kNvwFSqFow&_nc_oc=AdpnestWC0ral9UnqBpTBnTEez9KZGBktEQLostwp4Dpg1yVB-ChsV3hMVuPhRmyPNo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82LnYXpyyrCmkZoYs0IS20O-MQTYDJceOlRulg4L9P7w&oe=6A298259"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Movie2560x1440.png", "id": "230455106575015", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974884_230455109908348_2198088300040870805_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LDvHrLjDJ8cQ7kNvwH0U4Xg&_nc_oc=AdpODedaudUnibx2xt8pVgLPX_V1F4HwrYEfSAkk0t82wJg17Cf_fbC-uTubMYmarME&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1KpS9Rjhu3jyo-gPuzR4ImDO_OF9PGDNLPo-044C2EA&oe=6A295AA5"}, "display_name": "Angry Mazes VR", "keywords": [], "long_description": "The maze is angry. While playthings have evolved from paper and pencils to VR, maze gameplay has remained unchanged. Mazes have been underestimated and labeled as old-fashioned because their play methods haven't evolved. It's not that mazes themselves are outdated, but rather that their gameplay hasn't been updated. Could this be the reason why mazes are no longer played as much? That's where \"Angry Mazes VR\" comes in, aiming to evolve mazes in sync with VR. Give it a go and experience the evolved maze in VR.", "short_description": "The maze is angry. You know what? It's not the maze that's old, it's us humans who can't evolve it. But fear not, because the maze is evolving with VR. Can you play in the evolved maze? Or are you stuck with the same old maze?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dmaze2020.wixsite.com/angry-mazes-vr/post/privacy-policy", "developer_terms_of_service_url": "https://3dmaze2020.wixsite.com/angry-mazes-vr/post/terms-of-service", "publisher_name": "https://twitter.com/3DMazeXR", "support_website_url": null, "website_url": "https://3dmaze2020.wixsite.com/angry-mazes-vr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_
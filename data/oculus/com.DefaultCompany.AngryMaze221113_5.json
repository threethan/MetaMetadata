40.png", "id": "806023557568838", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036671_806023560902171_1298265399802487151_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f7OrTpAoAfAQ7kNvwEQZ0qj&_nc_oc=AdkzkPOkKLe5jzc4G3z_cANr11oghDc37d7NkfnEeVofpEEaAVQfnItb1f3DWql0ycM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsZD1aZgHb4OcEpw0mwcewONAuULoU4DVN2792Og9w8oQ&oe=699AEE55"}, {"file_name": "ScreenShot05_2560x1440.png", "id": "3444230189153102", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974914_3444230192486435_762526293595917163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Feynxvn-kkwQ7kNvwEBzeMA&_nc_oc=AdlxLxVGrLMaMMO3nikZTevmd1qqDu0h6KoJ6sCGPgcWKxmPzXKgGxG5TjSqKw04e0U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfssVLYjmM3pS_xkT05vK7fB5fqMRdssn1D2Aw9jwGfkuQ&oe=699AED0C"}, {"file_name": "ScreenShot04_2560x1440.png", "id": "1270074803649292", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974514_1270074806982625_5335865005242226290_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RtArq0IFlxcQ7kNvwHhd63f&_nc_oc=AdmDcMl_MhF3R1D-0ETwwVZ6kMIqleOzD0fB3rMau4X5ZKpSO7XeL9vu1lYiib6VQyI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aftrv_IDLaknP8tHeENMA8ngaJtuuCpcy3TPNVArimaq8w&oe=699B1191"}, {"file_name": "ScreenShot02_2560x1440.png", "id": "813144287027038", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036623_813144293693704_3049302096086576569_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pavuQR8anDUQ7kNvwGQwD7l&_nc_oc=AdktLM4WO7prxByWuGdtzZxhbPgwnJ4fa64saJU0NJGnxhj5zBWcg1GkP5JOrmY1qBE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aft3wOv5PdXYhTF8tMSkFiaIUDJcH50J8vkyjTvS7Lr9ig&oe=699AE819"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Movie2560x1440.png", "id": "230455106575015", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974884_230455109908348_2198088300040870805_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CxGT1J_9AmkQ7kNvwE_0yAJ&_nc_oc=Adnf6_3z5Mc3C-IvMB4yMS3XOotng5RRObh-6gF40drkCHnx3I5BWRfwdkxedPKpLO8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsOEv7aWzh6XB8S6hr-XZtumCbqcxldiDVH0vz6t6lD0g&oe=699AF8A5"}, "display_name": "Angry Mazes VR", "keywords": [], "long_description": "The maze is angry. While playthings have evolved from paper and pencils to VR, maze gameplay has remained unchanged. Mazes have been underestimated and labeled as old-fashioned because their play methods haven't evolved. It's not that mazes themselves are outdated, but rather that their gameplay hasn't been updated. Could this be the reason why mazes are no longer played as much? That's where \"Angry Mazes VR\" comes in, aiming to evolve mazes in sync with VR. Give it a go and experience the evolved maze in VR.", "short_description": "The maze is angry. You know what? It's not the maze that's old, it's us humans who can't evolve it. But fear not, because the maze is evolving with VR. Can you play in the evolved maze? Or are you stuck with the same old maze?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dmaze2020.wixsite.com/angry-mazes-vr/post/privacy-policy", "developer_terms_of_service_url": "https://3dmaze2020.wixsite.com/angry-mazes-vr/post/terms-of-service", "publisher_name": "https://twitter.com/3DMazeXR", "support_website_url": null, "website_url": "https://3dmaze2020.wixsite.com/angry-mazes-vr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"
40.png", "id": "806023557568838", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036671_806023560902171_1298265399802487151_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WvsqY9qEEAsQ7kNvwEy7sNq&_nc_oc=Adl67C9Ba0Lw0d1sUkjvG8fFtCLyKmRgri_xdm0qJiyo7hG_SnwrQRoRL9CZ5YTPB8c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvP0bVdD8V_twNPqGSSZGrw_Lp2y1CZYknGW7MelwX5OA&oe=699C3FD5"}, {"file_name": "ScreenShot05_2560x1440.png", "id": "3444230189153102", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974914_3444230192486435_762526293595917163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Feynxvn-kkwQ7kNvwGpmhFe&_nc_oc=AdnGeJ2KQ9I7kvpFdIKGfb2kn62kp31nNaqODTH6FsAPx4uGBmLpzkkd49JwezdLoW8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvxBnvqqej0K0zErVTg8ZpF0qlFbtnjcAIC8aYYT9z-7w&oe=699C3E8C"}, {"file_name": "ScreenShot04_2560x1440.png", "id": "1270074803649292", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974514_1270074806982625_5335865005242226290_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RtArq0IFlxcQ7kNvwG3sooA&_nc_oc=AdkP3FwRzhBscrb-0KDCmmhVp8emm4g5VJ0xknevQMC3pW4PfQs6Ugdp7M2-58JDXwg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afv3Oa4N2n3_HV13THwKoe1fX2BT4MsRh2-tvKZV2ZskLg&oe=699C6311"}, {"file_name": "ScreenShot02_2560x1440.png", "id": "813144287027038", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036623_813144293693704_3049302096086576569_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bQ_NfkjJ7iQQ7kNvwGmK55Q&_nc_oc=Admj_npRUXECSR1s14dpoAH6CW2a4uxRPdooGfFuVLVGZiRzJn69g6qA0y90CrVTiM0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afu1_z0lSFT2QNWOFjwMacgisHfdRAkM8A_8r33Phjyxdg&oe=699C3999"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Movie2560x1440.png", "id": "230455106575015", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974884_230455109908348_2198088300040870805_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NCJM4uFUg9gQ7kNvwHZHyJ2&_nc_oc=AdnOnLOEvXecjIRMP07AYlgE_OZ_fPPGwgetEZg5xFi2UyFwzEbO07RrSA8Xxa2WG_Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvPZXEoEudL0BT9WSTAgfK93BxmVDGIYCl70ldw8ZMwOA&oe=699C4A25"}, "display_name": "Angry Mazes VR", "keywords": [], "long_description": "The maze is angry. While playthings have evolved from paper and pencils to VR, maze gameplay has remained unchanged. Mazes have been underestimated and labeled as old-fashioned because their play methods haven't evolved. It's not that mazes themselves are outdated, but rather that their gameplay hasn't been updated. Could this be the reason why mazes are no longer played as much? That's where \"Angry Mazes VR\" comes in, aiming to evolve mazes in sync with VR. Give it a go and experience the evolved maze in VR.", "short_description": "The maze is angry. You know what? It's not the maze that's old, it's us humans who can't evolve it. But fear not, because the maze is evolving with VR. Can you play in the evolved maze? Or are you stuck with the same old maze?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dmaze2020.wixsite.com/angry-mazes-vr/post/privacy-policy", "developer_terms_of_service_url": "https://3dmaze2020.wixsite.com/angry-mazes-vr/post/terms-of-service", "publisher_name": "https://twitter.com/3DMazeXR", "support_website_url": null, "website_url": "https://3dmaze2020.wixsite.com/angry-mazes-vr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"
40.png", "id": "806023557568838", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/39036671_806023560902171_1298265399802487151_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GUoeKDz0iSUQ7kNvwE_InzW&_nc_oc=AdlaJEQKwDPUELw91cGuKEOG7FOWMoM6BTyaN5NPZROqWD16MZQ6xcf_s4vk_KaJP98&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_AfvBQ71RQ3eg5T00EHesSG95Uvj6lBfgV6quULvSyGZevQ&oe=69A185D5"}, {"file_name": "ScreenShot05_2560x1440.png", "id": "3444230189153102", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974914_3444230192486435_762526293595917163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gx39BqAmzmEQ7kNvwEwYCna&_nc_oc=Adm-gCWrFQQXDv-wcoHK8v2oPRfMtIgF1oUmWwp-cHhIR-nGEQobqaF59q8CPD_ZH6U&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afu6iuXDK01uWC1J6I8L-VDi9CJxUuS9VLWD5iTktV0ftA&oe=69A1848C"}, {"file_name": "ScreenShot04_2560x1440.png", "id": "1270074803649292", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974514_1270074806982625_5335865005242226290_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mzkscwZumLsQ7kNvwGVjtgf&_nc_oc=Adk_Gdmvx2MxcNxoyRf2oNdxYexDjyLVInRQ-2kRX494mABrE9Sg_fNQaKAK4dduO2s&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftdLcxXp-PaC2NrKlFtISB-LNQNFjeMEG53imRors0D0Q&oe=69A1A911"}, {"file_name": "ScreenShot02_2560x1440.png", "id": "813144287027038", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39036623_813144293693704_3049302096086576569_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jIzu8opjLfkQ7kNvwGFWhfr&_nc_oc=AdlXTuT5Q_UNRTlobii-f8mv36_LckQ6DsQ6dDGN1kJdqrWcW9aPQTcJpgSvgzyzelw&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Aftz-QZ47RPZuEi-LRsy9AvEDnir-ByEPMQEOnkqDiI27Q&oe=69A17F99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Movie2560x1440.png", "id": "230455106575015", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974884_230455109908348_2198088300040870805_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XAU0uAf6oXIQ7kNvwFA--UF&_nc_oc=Adn7mQvxv0zcDwsR-PUfs2YY0Egys-5-j88Ya5wPZILZOboIiF-etMEjvtgMIDvwOjU&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfuoYm4R12pfolDbmY70C1SWktU33B7dFyuJm6_iUwbS3w&oe=69A19025"}, "display_name": "Angry Mazes VR", "keywords": [], "long_description": "The maze is angry. While playthings have evolved from paper and pencils to VR, maze gameplay has remained unchanged. Mazes have been underestimated and labeled as old-fashioned because their play methods haven't evolved. It's not that mazes themselves are outdated, but rather that their gameplay hasn't been updated. Could this be the reason why mazes are no longer played as much? That's where \"Angry Mazes VR\" comes in, aiming to evolve mazes in sync with VR. Give it a go and experience the evolved maze in VR.", "short_description": "The maze is angry. You know what? It's not the maze that's old, it's us humans who can't evolve it. But fear not, because the maze is evolving with VR. Can you play in the evolved maze? Or are you stuck with the same old maze?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dmaze2020.wixsite.com/angry-mazes-vr/post/privacy-policy", "developer_terms_of_service_url": "https://3dmaze2020.wixsite.com/angry-mazes-vr/post/terms-of-service", "publisher_name": "https://twitter.com/3DMazeXR", "support_website_url": null, "website_url": "https://3dmaze2020.wixsite.com/angry-mazes-vr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"
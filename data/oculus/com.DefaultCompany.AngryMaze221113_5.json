JvMOC3GkPsHO8-SmsSlqRdh6pmvjjz6GK6RAWdrVhLv7-qnQiHJBO49ebzfnbYoc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxh66zsEklitllbs_RVFb3MO5e2KnbTMRUdh_BEl4RZqQ&oe=69B0050C"}, {"file_name": "ScreenShot04_2560x1440.png", "id": "1270074803649292", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974514_1270074806982625_5335865005242226290_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=23ZkcDEAEEUQ7kNvwFQL_w8&_nc_oc=AdkHy3VW4qEXGTnwf7JPGq4PPK1p1zrmhOM5uMnF-HNoXKuraG4pV5QEYu-Wdr8Fbsg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy7eHqBtvgkz_xkqgxXA5S-8WA0ZeXWXajzeJAJgmAQ5Q&oe=69B02991"}, {"file_name": "ScreenShot02_2560x1440.png", "id": "813144287027038", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036623_813144293693704_3049302096086576569_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PNAqKV4XkhcQ7kNvwFBohjO&_nc_oc=AdmH8_LIP_J1oJIYeQu64Zx5Qnqw-349oWcuHdXDoXFYcFKqUniR75KdEIkLoPwIpVM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afyrkh7P9lm-HGudt7k3FTzWfi-KoGwA1E-Rut8Q2ejatA&oe=69B00019"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Movie2560x1440.png", "id": "230455106575015", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974884_230455109908348_2198088300040870805_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G2cTyu009LQQ7kNvwEpWjiD&_nc_oc=AdkiKQJ0sPf0tQi6JERSOVpErMEirNrjXCLA05ZsLx-x_bzO5cPIyBy2hiacKPnJ3aQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy8wNPxy-2RkBfjq7tnS3Pzx3t3qrj6y5z6cPhhnp1CJA&oe=69B010A5"}, "display_name": "Angry Maze VR", "keywords": [], "long_description": "The maze is angry. While playthings have evolved from paper and pencils to VR, maze gameplay has remained unchanged. Mazes have been underestimated and labeled as old-fashioned because their play methods haven't evolved. It's not that mazes themselves are outdated, but rather that their gameplay hasn't been updated. Could this be the reason why mazes are no longer played as much? That's where \"Angry Maze VR\" comes in, aiming to evolve mazes in sync with VR. Give it a go and experience the evolved maze in VR.", "short_description": "The maze is angry. You know what? It's not the maze that's old, it's us humans who can't evolve it. But fear not, because the maze is evolving with VR. Can you play in the evolved maze? Or are you stuck with the same old maze?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dmaze2020.wixsite.com/angry-mazes-vr/post/privacy-policy", "developer_terms_of_service_url": "https://3dmaze2020.wixsite.com/angry-mazes-vr/post/terms-of-service", "publisher_name": "https://twitter.com/3DMazeXR", "support_website_url": null, "website_url": "https://3dmaze2020.wixsite.com/angry-mazes-vr", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "155425400763364"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "651311846810497"}]}, "baseline_offer": {"id": "651311846810497"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1689622320, "status": "PUBLISHED", "id": "651311846810497"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9765195246935139", "version": "1.0"}, "id": "256889466669714", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_b
&oh=00_AQIhlzW-Q8ow65DWgnF-niUPML9Hj54eWCNtdXYl6PgezA&oe=6AA695A0"}, {"file_name": "ScreenShot01_2560x1440.png", "id": "806023557568838", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036671_806023560902171_1298265399802487151_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aM3fyEDCO9kQ7kNvwE3WwmJ&_nc_oc=AdqnlPSRy6imM_YJb_Ny37Emw2aLz6wWlqqALkWDa553ahO_SmkjeLUv-VfO3wLh8Bo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQkmQKOtqW0udukQvUQT4u20IU0Q1romKwQhm9dEYmhQ&oe=6AA6C715"}, {"file_name": "ScreenShot05_2560x1440.png", "id": "3444230189153102", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974914_3444230192486435_762526293595917163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-uOGMU8khScQ7kNvwEBHNbg&_nc_oc=Adq2fmLd5xTK6itHqMGhcQLXi6ePhV5i9-sZ59Gr4gUpMCbyfVE4dEX-axQsoNV_ZSg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLC2uopFfd2xYX4EVw0N0igcizMm0zdcb9gzH062pRVeQ&oe=6AA6C5CC"}, {"file_name": "ScreenShot04_2560x1440.png", "id": "1270074803649292", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974514_1270074806982625_5335865005242226290_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BYrxBh8-wzcQ7kNvwEH4Nmd&_nc_oc=AdpZRW5L-H48PZdXg306jIjKcX8LSBw8zLKEvaSCPp62kiDFPFXjI_fGSnSGahTzFmQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLooSw6KTXYaOGbDLKqT3BJd5ZSvEkfYaodSZeQjSVjyQ&oe=6AA6B211"}, {"file_name": "ScreenShot02_2560x1440.png", "id": "813144287027038", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036623_813144293693704_3049302096086576569_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fwShNWBHHTUQ7kNvwGYdaDK&_nc_oc=AdoSCEeH4Yr0WH67tiFERC2gCc2y_zDPHATAcOJe5u1mQM99BM3UvFoNRXWGPqGVwjg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI12QoWB6aPqCWAm-uode0GQyf7AY1VDAtDNsJD1460dQ&oe=6AA6C0D9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Movie2560x1440.png", "id": "230455106575015", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974884_230455109908348_2198088300040870805_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l8_V9OHt3DgQ7kNvwEu_MJ2&_nc_oc=AdoRmsZWhpT1hlNq5Hlx3R5ztCfbqiMPGdsWW6nOp2V3siCnZMwZehirAA-R_keAHjE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLGileOdMpJJ7bfmA3PwqmUmu-bB5Dq5aaYc8CsAZy2lA&oe=6AA69925"}, "display_name": "Angry Mazes VR", "keywords": [], "long_description": "The maze is angry. While playthings have evolved from paper and pencils to VR, maze gameplay has remained unchanged. Mazes have been underestimated and labeled as old-fashioned because their play methods haven't evolved. It's not that mazes themselves are outdated, but rather that their gameplay hasn't been updated. Could this be the reason why mazes are no longer played as much? That's where \"Angry Mazes VR\" comes in, aiming to evolve mazes in sync with VR. Give it a go and experience the evolved maze in VR.", "short_description": "The maze is angry. You know what? It's not the maze that's old, it's us humans who can't evolve it. But fear not, because the maze is evolving with VR. Can you play in the evolved maze? Or are you stuck with the same old maze?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dmaze2020.wixsite.com/angry-mazes-vr/post/privacy-policy", "developer_terms_of_service_url": "https://3dmaze2020.wixsite.com/angry-mazes-vr/post/terms-of-service", "publisher_name": "https://twitter.com/3DMazeXR", "support_website_url": null, "website_url": "https://3dmaze2020.wixsite.com/angry-mazes-vr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_
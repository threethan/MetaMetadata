yNfB9ZpGZKpauooWFXqG5QCn2DrYNxpzjexFucgWwARonuss0VCY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9ii4SNBvhsSjj1n4RoTTk2Ru6xy8dGXVFRky5B70z2g&oe=6AFC7259"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Movie2560x1440.png", "id": "230455106575015", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974884_230455109908348_2198088300040870805_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XZZmpyXi4ToQ7kNvwFQh3q_&_nc_oc=AdpsbpRUjiBPkzhtZLG7reZRTqs_NuHK51o2C-nM83XuPeq0lY-vWquoF4UibjSIECg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsum6ut1KvGzLAIxlSv86EH9w8u0atMuHXV55fZnSU-A&oe=6AFC82E5"}, "display_name": "Angry Mazes VR", "keywords": [], "long_description": "The maze is angry. While playthings have evolved from paper and pencils to VR, maze gameplay has remained unchanged. Mazes have been underestimated and labeled as old-fashioned because their play methods haven't evolved. It's not that mazes themselves are outdated, but rather that their gameplay hasn't been updated. Could this be the reason why mazes are no longer played as much? That's where \"Angry Mazes VR\" comes in, aiming to evolve mazes in sync with VR. Give it a go and experience the evolved maze in VR.", "short_description": "The maze is angry. You know what? It's not the maze that's old, it's us humans who can't evolve it. But fear not, because the maze is evolving with VR. Can you play in the evolved maze? Or are you stuck with the same old maze?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dmaze2020.wixsite.com/angry-mazes-vr/post/privacy-policy", "developer_terms_of_service_url": "https://3dmaze2020.wixsite.com/angry-mazes-vr/post/terms-of-service", "publisher_name": "https://twitter.com/3DMazeXR", "support_website_url": null, "website_url": "https://3dmaze2020.wixsite.com/angry-mazes-vr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "cont
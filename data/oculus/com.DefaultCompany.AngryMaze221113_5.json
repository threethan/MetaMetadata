40.png", "id": "806023557568838", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036671_806023560902171_1298265399802487151_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ffRPT7mxk4IQ7kNvwED2O5X&_nc_oc=Adn33XpvOrWxH3gHaIxBz1TmFGAJ8bOWAftGYl9jdNzC_dNi6zeENBGB80d11oR8Du0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv3FiuqXe0q3lsL6luRrJgfiTtL2QLT7DnIMoBLIkY1og&oe=69A6CBD5"}, {"file_name": "ScreenShot05_2560x1440.png", "id": "3444230189153102", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974914_3444230192486435_762526293595917163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tnyklhIFgmEQ7kNvwFDNvRD&_nc_oc=AdmQ_zB-R4hs8k6xc7ngfzZ6H-5DqJ71rXJ9Gy4aqhMIHJ3H75CDLfADH6M3ZnoM5kg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsONTHlEQxJcoSJiKLefUus_jcjLu9iNWOGqLKqhktEbw&oe=69A6CA8C"}, {"file_name": "ScreenShot04_2560x1440.png", "id": "1270074803649292", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974514_1270074806982625_5335865005242226290_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ClkdS0oyf0IQ7kNvwFS_Uqs&_nc_oc=Adnj6-Xle3tW5ljMwjM_HSSM85jx36bFzd1ID4QrA_1rBVykYgNxBFgi6jkL5wCJ9tk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvgd4gyjcPfcKssSdPGOtih-c9thAxXMJypjsWQv63ZUA&oe=69A6EF11"}, {"file_name": "ScreenShot02_2560x1440.png", "id": "813144287027038", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036623_813144293693704_3049302096086576569_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JGiYL6eSuDgQ7kNvwGBc3wH&_nc_oc=AdmW34Zoj_3CKWj6B6O77-iNDUJxNkbTiOaxascAA6imHgiD1LVyXm57oC7dkaUZgPs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftqnLzzDo5ABOEvI8Htgu1JyjvNq8jM0GRXDsgc06r67g&oe=69A6C599"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Movie2560x1440.png", "id": "230455106575015", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974884_230455109908348_2198088300040870805_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hEgAGgdgWbAQ7kNvwGVzCMh&_nc_oc=AdmcrajIL8QFrMkV6I_C3-ZssBV1by9tUgrIKKNRJkROBmPsQ5YO2a7Wvbkr06IueMM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvcCXrKtmV3lGJzf0mSvXI8gsAnfKcna1k2J49qHrVmeg&oe=69A6D625"}, "display_name": "Angry Mazes VR", "keywords": [], "long_description": "The maze is angry. While playthings have evolved from paper and pencils to VR, maze gameplay has remained unchanged. Mazes have been underestimated and labeled as old-fashioned because their play methods haven't evolved. It's not that mazes themselves are outdated, but rather that their gameplay hasn't been updated. Could this be the reason why mazes are no longer played as much? That's where \"Angry Mazes VR\" comes in, aiming to evolve mazes in sync with VR. Give it a go and experience the evolved maze in VR.", "short_description": "The maze is angry. You know what? It's not the maze that's old, it's us humans who can't evolve it. But fear not, because the maze is evolving with VR. Can you play in the evolved maze? Or are you stuck with the same old maze?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dmaze2020.wixsite.com/angry-mazes-vr/post/privacy-policy", "developer_terms_of_service_url": "https://3dmaze2020.wixsite.com/angry-mazes-vr/post/terms-of-service", "publisher_name": "https://twitter.com/3DMazeXR", "support_website_url": null, "website_url": "https://3dmaze2020.wixsite.com/angry-mazes-vr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"
40.png", "id": "806023557568838", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036671_806023560902171_1298265399802487151_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WvsqY9qEEAsQ7kNvwHTMrOH&_nc_oc=AdmINecDwOVPCppQFGHuGxJOLfiL7s1UGF_0DndMshAkh65FHTT-Mz73cAafo1Dh8P4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvrqGOym3boxyf_WIuFFOHrz3zHoZFhbXF4IaaJXi08lQ&oe=699EE2D5"}, {"file_name": "ScreenShot05_2560x1440.png", "id": "3444230189153102", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974914_3444230192486435_762526293595917163_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gx39BqAmzmEQ7kNvwEBjVSq&_nc_oc=AdlBii4PcFA22kGj4tZPaB7kq0wfT485gyUjxOwp5ewws0Qvcm2gY7C6OHldg3JV-rw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afvql5s0cphq5yxcG6uwcDd9baCe68mgCLAyIzvoD0Waow&oe=699EE18C"}, {"file_name": "ScreenShot04_2560x1440.png", "id": "1270074803649292", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974514_1270074806982625_5335865005242226290_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fCmgooH9eHQQ7kNvwH7gSJx&_nc_oc=AdnBgO8Wd-tTDTqKKyOB1-vJN6xLcV_AGrBEOMYuBfsRAglEesUebxyV30uf32v0bDc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsW1YQrsLgyXoMSycwtIHI1ngoD4tUfSwjvDe9KHfjrDg&oe=699F0611"}, {"file_name": "ScreenShot02_2560x1440.png", "id": "813144287027038", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036623_813144293693704_3049302096086576569_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bQ_NfkjJ7iQQ7kNvwGraKK_&_nc_oc=Adk4h-PwENkm-MmWY6PnOonH7KUYghYc5P3_qesdtWgoorNcCvkNT8wdQHRBYWyrB1U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aft0bExQn23AmUJY0GpwHfiVkx2yln92IFPzqSdO4B5uGA&oe=699EDC99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Movie2560x1440.png", "id": "230455106575015", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974884_230455109908348_2198088300040870805_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NCJM4uFUg9gQ7kNvwHNLgn6&_nc_oc=AdlrEw-P6Z5jfctfL3UhZuEtn1HloxjPMbPPCyDGdVmQNrXEt9f6oQRkkBv6bivdiCE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsF2gIa8CGdpf5m7Tfdc54aAi9xjENLhM61dxv1YzeN3A&oe=699EED25"}, "display_name": "Angry Mazes VR", "keywords": [], "long_description": "The maze is angry. While playthings have evolved from paper and pencils to VR, maze gameplay has remained unchanged. Mazes have been underestimated and labeled as old-fashioned because their play methods haven't evolved. It's not that mazes themselves are outdated, but rather that their gameplay hasn't been updated. Could this be the reason why mazes are no longer played as much? That's where \"Angry Mazes VR\" comes in, aiming to evolve mazes in sync with VR. Give it a go and experience the evolved maze in VR.", "short_description": "The maze is angry. You know what? It's not the maze that's old, it's us humans who can't evolve it. But fear not, because the maze is evolving with VR. Can you play in the evolved maze? Or are you stuck with the same old maze?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dmaze2020.wixsite.com/angry-mazes-vr/post/privacy-policy", "developer_terms_of_service_url": "https://3dmaze2020.wixsite.com/angry-mazes-vr/post/terms-of-service", "publisher_name": "https://twitter.com/3DMazeXR", "support_website_url": null, "website_url": "https://3dmaze2020.wixsite.com/angry-mazes-vr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"
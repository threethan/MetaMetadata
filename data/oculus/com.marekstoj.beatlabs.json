-7&_nc_sid=6e7a0a&_nc_ohc=riG3pTEjBfMQ7kNvwH_hV9d&_nc_oc=AdmYUYTARHuhnoDBaMXE0rzblpX1gYceFGvPgP_ZiTypzc5uM0WQ6UsEDFI4fA-U0h0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afy_yeC0ovsufVScXO8hHbZQZ3fjjLfPnAzVmlo6cQaCdw&oe=69BFCDD2"}, {"file_name": "beat-labs-screenshot-015.png", "id": "3789020674702234", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57570301_3789020681368900_1650858440561341903_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1r7RAQrXRuUQ7kNvwG-IXEC&_nc_oc=AdmSH81Xv9qLA-v_SNUlNc-1krJoH0MEvNI9_xFF18qpb_RVFeTYan7TGY0xQV76WIM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxdtatjpQVm6Tq1wC1gN8WIRYT3jr9gQR2WnA43i3VNUQ&oe=69BFFBBA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video-cover.png", "id": "884824413657931", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982593_884824416991264_168865580567711985_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pr7V9yi3I_oQ7kNvwHBBh_L&_nc_oc=AdnmFUZQexo00Avb4eCHOMv2u5ZqSzm7f-pnxHUkf72B3EBUfq2epRBuZ3hiMM9SIK8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxWA8G4-D07hfJNbpJOw1ltDLAu99fPunflQJD50DB09Q&oe=69BFD59B"}, "display_name": "Beat Labs", "keywords": [], "long_description": "Beat Labs is an open, free-to-play and cross-platform **sandbox for rhythm games** in Virtual and Mixed Reality (VR/XR). It\u2019s powered by a database of over 100 000 community-made song beatmaps for Beat Saber.\n\nBeat Labs aims to become something more than Beat Saber though, by providing **a platform for immersive experiences** rather than being a single game. A platform for music and rhythm-based mini-games, powered by content created by us, **the community of players** and AI (Artificial Intelligence).\n\nOne of the biggest selling points of Beat Labs is the **sheer number and variety of songs** the players can choose from. There's tens of thousands of beatmaps (levels) created by Beat Saber community that we tap into.\n\nBeat Labs is **highly customizable** to cater to various players preferences. This includes the ability to choose the type of gameplay, an environment in which the game takes place, custom models of weapons and destructible objects and more.\n\nThe customizations described above are part of what makes Beat Labs an **extensible platform**. The content that the community creates may even introduce novel gameplay mechanics that we haven't yet thought of. This approach is similar to other, highly popular and profitable platforms, like Fortnite, Minecraft or Roblox.", "short_description": "Beat Labs is an open, free-to-play and cross-platform sandbox for rhythm games in Virtual and Mixed Reality (VR/XR). It\u2019s powered by a database of over 100 000 community-made song beatmaps for Beat Saber."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bodymindgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Body Mind Games", "support_website_url": null, "website_url": "https://www.bodymindgames.com/beat-labs", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1990104051447093"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7758623554158209"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PUBLISHED", "id": "850287361391595"}, {"status": "CANCELLED", "id": "1382441799768454"}, {"status": "PUBLISHED", "id": "1342513734575440"}, {"status": "PUBLISHED", "id": "1546179
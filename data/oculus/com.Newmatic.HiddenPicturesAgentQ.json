_screenshot_03.png", "id": "518149367241248", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75254874_518149370574581_4702766907042417380_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yC6Nqr-IrycQ7kNvwEwOlZJ&_nc_oc=AdqRaAIgOnbDpKLcUmkW4BZVT_Mzh-sxWydXO_lXdzkHnFdbNvkb4Lqj3S1rodNKUlA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-xYNOiJIeaVYuHvckd9wFPlN3K0C9yhJeN4UdVq1frQ&oe=6AA2C34A"}, {"file_name": "pdp_screenshot_04.png", "id": "1031604961683263", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75412000_1031604965016596_6165048486914216958_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iUXxQUQ7_FkQ7kNvwFAujg0&_nc_oc=Adp4g4eWz65AqPGv4zRgcnVHy5vAVJZ2kQuv-h9oCJ2f3fxyOlxo6Es74gXS8fWT8zE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI6xoz8mpmxd_eqgGn3K7_9bUKGtxsW2OF1HKTglj6_qA&oe=6AA2AF8E"}, {"file_name": "pdp_screenshot_05.png", "id": "2000161337067525", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75245824_2000161340400858_6409577600250441625_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nlXPSWVZsToQ7kNvwGm7iWg&_nc_oc=Adra1iiXV9AHBzy9A6QkEoaTgO2uBJvv-DFl2E2i3m1Kfzv9grINQB9UQDhEqTPSCrY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKR6DuO2TMM2omx5NYzaQPGIhQUaYg1ArDO4VJOw2l2Q&oe=6AA29DF5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PDP_cover_HP_title02.png", "id": "1485445182344139", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86620687_1485445185677472_544453335770100455_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r5EbI65AJw0Q7kNvwHroUm7&_nc_oc=Adpu1R_KAUBptZ9YpgU_XY6KZfXKM9v0mbFGZ4awIHbRglF2ouZLvoW5EKXbvi6hyQU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqbVGT0dMkYu-9y-1CxrktS-GdnfSVS52ZjlJTdMvIhQ&oe=6AA2AA7F"}, "display_name": "Hidden Pictures : Agent Q", "keywords": [], "long_description": "# Become an agent of a secret agency and arrest the alien Tumai hiding among the cute miniatures and humans!\n\n\nExplore the miniature world and catch the alien race Tumai from\nanother dimension.\n\n\nUse the controllers and buttons to freely explore the cute stages\nwhere they are hiding.\nCollect various clues, solve puzzles, track down Tumai, and arrest\nthem!\n\n\n{1029407875564528}\n1. Meet unique themes and characters in cute miniatures.\n\n\nYou can meet various miniature worlds with distinct themes\nMuseum, Western, Megacity, Halloween, etc. and characters.\nYou will fall in love with their unique charm.\n{420052001060625}\n2. Three game modes that offer a variety of play experiences\n\n\n- Adventure Mode : Explore the miniature world and chase Tumai.\n- Puzzle Mode : Solve puzzles to help a fellow agent complete missions \n- Boss Mode : You can meet the giant Tumai boss and fight against them.\n\n\n{1223537098681367}\n3. Move and explore the stages freely and comfortably.\n\n\nWith levels and user interface optimized for motion sickness\nreduction and mixed reality, you can freely explore the world\nand play the game comfortably for a long time.", "short_description": "Become a secret agent and find the troublemaking aliens Tumai hidden in the miniature world!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newmatic.kr/en/privacy_policy/privacy_policy.php", "developer_terms_of_service_url": null, "publisher_name": "Newmatic Co., Ltd.", "support_website_url": null, "website_url": "https://newmatic.kr/?locale=en_US", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_langu
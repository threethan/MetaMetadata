_screenshot_03.png", "id": "518149367241248", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75254874_518149370574581_4702766907042417380_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H5iAIo2lVAEQ7kNvwF9jIrc&_nc_oc=Adq_ITyJbzbTSky65cOP1fF1XsPqtvHZH3OLsLZpukZO-xBK4c6gxXiNiWXjDpAasIM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMCDQqaSlzXK2jT3HyX_Jgln-R9FNiFW9p2fUBIZVlYZQ&oe=6AD38ACA"}, {"file_name": "pdp_screenshot_04.png", "id": "1031604961683263", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75412000_1031604965016596_6165048486914216958_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d1geEKJcIj8Q7kNvwHzafbp&_nc_oc=Adr4FIlZ4MSIvr9yKlORluCT7WKdfxJNh8Go1U6MhlPBoYwLBfYlTDpFe4aMj8HF77U&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-kRnHu5gb-1TF6e9J5tcs-Ws5Bz3e5JYiHNzDadfQBg&oe=6AD3AF4E"}, {"file_name": "pdp_screenshot_05.png", "id": "2000161337067525", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75245824_2000161340400858_6409577600250441625_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8hz7L_uTHLMQ7kNvwHTKbHy&_nc_oc=AdqjG5nff63y_5wJr_CSbTPdFvEEiRgLxc69vIcTv0egmL1-lkehsDDLcl-2Loa_J4s&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOA3sFroSIeddptCdanuoMGdQAQ4B7DbRjvRaKsVm-0SQ&oe=6AD39DB5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PDP_cover_HP_title02.png", "id": "1485445182344139", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86620687_1485445185677472_544453335770100455_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ktt2AspSp2YQ7kNvwF35kEF&_nc_oc=Adrp52D9DAIwBQYNZKLq7neeUYFZcJbP6oLJYVrfG4tLZrV3tG14WLG3k9kNKRxKlY8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNAcwsypBqcwKYmytSEJsYjuBaLY1ITkJMObNVJbayYBA&oe=6AD3AA3F"}, "display_name": "Hidden Pictures : Agent Q", "keywords": [], "long_description": "# Become an agent of a secret agency and arrest the alien Tumai hiding among the cute miniatures and humans!\n\n\nExplore the miniature world and catch the alien race Tumai from\nanother dimension.\n\n\nUse the controllers and buttons to freely explore the cute stages\nwhere they are hiding.\nCollect various clues, solve puzzles, track down Tumai, and arrest\nthem!\n\n\n{1029407875564528}\n1. Meet unique themes and characters in cute miniatures.\n\n\nYou can meet various miniature worlds with distinct themes\nMuseum, Western, Megacity, Halloween, etc. and characters.\nYou will fall in love with their unique charm.\n{420052001060625}\n2. Three game modes that offer a variety of play experiences\n\n\n- Adventure Mode : Explore the miniature world and chase Tumai.\n- Puzzle Mode : Solve puzzles to help a fellow agent complete missions \n- Boss Mode : You can meet the giant Tumai boss and fight against them.\n\n\n{1223537098681367}\n3. Move and explore the stages freely and comfortably.\n\n\nWith levels and user interface optimized for motion sickness\nreduction and mixed reality, you can freely explore the world\nand play the game comfortably for a long time.", "short_description": "Become a secret agent and find the troublemaking aliens Tumai hidden in the miniature world!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newmatic.kr/en/privacy_policy/privacy_policy.php", "developer_terms_of_service_url": null, "publisher_name": "Newmatic Co., Ltd.", "support_website_url": null, "website_url": "https://newmatic.kr/?locale=en_US", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_langu
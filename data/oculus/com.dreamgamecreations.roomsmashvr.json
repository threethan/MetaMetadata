i": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/908842204_4631680550390172_8431961661946216773_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=84r8yJYh5jcQ7kNvwFvmN9N&_nc_oc=AdooI3HL8yFBd08cJGxc9rQp2BcCYAT9tCTPV-UpdpVRajNu3n2lRyti0JytomVw0Do&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRpPo2bGaeehRj6mX4S3hq0CgUIZaqJR1SEIASrXxzsGA&oe=6B0C792C"}, {"file_name": "Screenshot_05_Kitchen_2560x1440.png", "id": "1892133088772204", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491831299_1892133092105537_7016278270582527738_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DopH1_P05BIQ7kNvwGSKBto&_nc_oc=AdrMhFrQ7N5QGhp7gAZaNEDqv8oJogPw7d7k1SbrJRZTkNsTOQi8UvJEfC3cwtKBZU4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT2KdlJLFGv0LZs-M-NwXX_MInHsNjUciyYYfCgUsqrHg&oe=6B0C6CC5"}, {"file_name": "Screenshot_03_Office_2560x1440.png", "id": "4713634915632809", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/673723566_4713634918966142_8812393871129205853_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f8GO8WEES7QQ7kNvwGCM0hf&_nc_oc=AdoyVAgWcW_5tLpfcrxzeUgnP0Ta2IOt6e_JBo0wsR5SkQmxHGLtXsxEo7D7iVrunP8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSOTBZVG1IlnymrKNOFUIstNwp7xgu3JxLtDhiwC58vGA&oe=6B0C6054"}, {"file_name": "Screenshot_07_Kitchen_2560x1440.png", "id": "1918608725775066", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/908842246_1918608729108399_5344358896398329132_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D9toTsDbakoQ7kNvwH4vH_l&_nc_oc=Adp8vMXXLfjqCJp_TBypmUjEMk3TyRy9yU4kk8EuQmsYJjJMfW-OQRp_dmPEUCSd1OA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRvdpZAYIuE57VPW8ccXv_v4cqXVB_gfNFVWecPq8itXQ&oe=6B0C703C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover_2560x1440.png", "id": "1123586590563268", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908771270_1123586593896601_8935798109676887088_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OTiYRXS_tHwQ7kNvwGfkQDz&_nc_oc=AdpSjfzhVOfaxbCkpyFMjg4iX1c0XJWwzocrMQZEQWALrj52SzJd8myXXC2HxLzauwg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSCCWPCbpdlsO07kF1qdW52Q6ZzinxpBxscJe82C9QWuA&oe=6B0C4FB5"}, "display_name": "Room Smash VR", "keywords": ["smash", "destruction", "break", "glass", "simulator"], "long_description": "Had a rough day? Pick up a sledgehammer and let it out.\n\nRoom Smash VR is a realistic rage room for Meta Quest. Walk into a gritty smash room, grab a real-feeling tool from the wall rack and destroy anything you can reach. Every object breaks apart with physics: glass shatters into shards, plates crack, CRT TVs burst, monitors split and wood splinters. Debris piles up on the floor and stays there until you hit the big red RESET button.\n\nFEATURES\n\u2022 4 rooms to wreck: the Rage Room, a dingy Office, an old apartment Kitchen and a cluttered Garage\n\u2022 8 tools: claw hammer, baseball bat, sledgehammer, crowbar, golf club, frying pan, pipe wrench and fire axe\n\u2022 50+ breakable objects, from bottles, jars and plates to TVs, printers, keyboards, chairs and glass panes\n\u2022 Swing harder to hit harder. Damage depends on your swing speed and the weight of the tool\n\u2022 Slow motion kicks in on monster hits\n\u2022 Loud, punchy impact and shatter sounds, plus a radio you can turn up (or smash)\n\u2022 4 modes: Free Smash, a 90-second Timed Challenge, Target List and a relaxed Zen mode\n\u2022 Earn XP to unlock new tools and new rooms, then chase your high scores\n\u2022 Instant reset: rebuild the room and smash it all again\n\nCOMFORT\nDesigned for standing or seated play in a small space (about 2 \u00d7 2 m). Snap turning by default, with optional smooth movement. Left- and right-handed play supported.\n\nNo internet connection needed. No ads. Single player.\n\nBreak everything. No clean-up.", "short_description": "Step into a gritty rage room and smash everything in sight. Grab a hammer, bat, sledgehammer or fire axe and destroy bottles, plates, TVs, monitors, glass panes and more, all with realistic physics. Glass shatters, debris piles up and big hits drop into slow motion. Four rooms, eight tools, zero clean-up."}]}, "developer_name": null, "developer_privacy_policy_url": "https://roomsmashvr.blogspot.com/2026/11/room-smash-vr-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Dream Game Creation", "support_website_url": null, "website_url": "https://dreamgamecreations.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1436974146171820"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1165216699301162"}]}, "baseline_offer": {"id": "1165216699301162"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1795147740, "status": "PUBLISHED", "id": "1165216699301162"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1437062029496365", "version": "1.0.0"}, "id": "4669410396620924", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "Androi
luscdn.com&_nc_ss=7f20f&oh=00_AQQdEayZpLuq0U-kq4qiDTkvlfZ68AtWs6HTgrU_bWChbA&oe=6B09C43B"}, {"file_name": "Untitled design (13).png", "id": "1708329903600694", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491830904_1708329910267360_6342305261724315622_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WxDb_PyodVkQ7kNvwHih-h7&_nc_oc=Adp4HI2s2i7DiaDPcO_Zoh8y7pcHkBkHYv-4nSAFvq5N-gLkRfVv3v8F7_UFtpqeiUA&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQarjuLkbYtVDZrv8DzRtLw6-EL4GScemIeBK5tAZEp5Q&oe=6B099B75"}, {"file_name": "Untitled design (15).png", "id": "1396102832733933", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604328314_1396102836067266_2318903953583504501_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zgTcJUi91-4Q7kNvwGEk6-u&_nc_oc=Adp6Kx6_R_TgCJ_muodzkRNqnaeGCUmQs9gxbwzU8q3LrFJ0SZljK9pNv9ZLUTiIXMU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6uLA05MKlgidlXSPB0YoSt2F3y4451mG5wSSA3TtJXA&oe=6B099FAF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Trails V2", "keywords": ["VRHorror", "MultiplayerHorror", "Survival", "Adventure", "Exploration"], "long_description": "In The Trails V2, players are thrust into a chilling virtual reality experience that transports them deep into the heart of a forbidding forest shrouded in mystery and dread. As they step into the shoes of an intrepid explorer, they find themselves navigating through dense thickets and winding trails that seem to twist and contort with a malevolent will of their own.\n\nThe atmosphere is thick with an oppressive sense of foreboding, amplified by the haunting sounds of rustling leaves and distant whispers that seem to emanate from the very depths of the forest. Every step forward is fraught with tension, as players never know what horrors may lie just beyond the next bend in the path.\n\nAs they delve deeper into the wilderness, players encounter a series of increasingly sinister phenomena. Strange symbols carved into ancient trees, mysterious altars hidden in secluded clearings, and the remnants of long-forgotten rituals all hint at a dark and ancient presence that lurks within the forest's depths.\n\nBut the true terror of \"The Trails V2\" lies in the encounters with its otherworldly inhabitants. From shadowy figures that stalk players from the periphery of their vision to grotesque creatures that lurk in the shadows, every encounter is a heart-pounding battle for survival.", "short_description": "The Trails V2 is a heart-pounding horror VR game set in the dense, eerie forests of a forgotten wilderness. Players embark on a terrifying journey through winding trails, encountering sinister entities and unraveling dark mysteries lurking within the shadows. With immersive VR mechanics, spine-chilling ambiance, and psychological terror at every turn, \"The Trails V2\" delivers a gripping experience that will haunt players long after they remove their headsets."}]}, "developer_name": "Will", "developer_privacy_policy_url": "https://sites.google.com/view/thetrailsprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Will", "support_website_url": null, "website_url": "https://sites.google.com/view/the-trails/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [
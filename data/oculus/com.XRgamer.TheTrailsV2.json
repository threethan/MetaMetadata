KYJHDQraIieOxz2vB7JHjR0Je0bbF48Qc6SGi29pPDUdYsIHdYxdDhYko9PLE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvp9sFfsAZ0vZgXn9nrP6xlg_EEL6TYnQe06Q_a5XWVw&oe=6B09C8E5"}, {"file_name": "Screenshot_07_subject25_2560x1440.png", "id": "1811614099782602", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823341_1811614106449268_2041691221619462842_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wrSsQbw6hzoQ7kNvwGBJ2Qb&_nc_oc=Adp1K7VcR6xr1Kjxb_04Rut8mBC4W2wNARVTDUlvSNzRaBxO6LSegifr4W1CsN5eE-4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKeUCxRTwQpaKFHrfOoin_-Jq-noOpYKVme8SG3R_Huw&oe=6B09C0D4"}, {"file_name": "Screenshot_04_basketball_2560x1440.png", "id": "1562504289244975", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820433_1562504299244974_1076011937646317466_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kaVJHjFOqCEQ7kNvwEg75Z9&_nc_oc=Adq5JIUPzwMjqxOpEXutKyQKN7pzGylQMbghvOloIJXdn_e7oy8DU1HtalEgY-21n9E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxsBUoYuosbA-VKaDENNwPbDpFLZaSDDIGvOxOVceMsw&oe=6B09C475"}, {"file_name": "Screenshot_05_portal_2560x1440.png", "id": "1698234958528216", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823341_1698234961861549_5839290240989485455_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=re5MjoItT4QQ7kNvwHxGesy&_nc_oc=AdqTw-XaPWNJsXiEiIrjnQG17PqGNFECUXPFKbiFV2F5zh3fNEMHgCCwRSLXJnxWp28&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAPg1GvpjAv7sSwetpMSYMMP1JAllprvuGDfXg5k1sxw&oe=6B09AC25"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover_2560x1440.png", "id": "2202433460696163", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824307_2202433464029496_5772660949719465864_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IsVxHyGgcWAQ7kNvwGHBX0R&_nc_oc=AdqwxeduRsb-myDVMT-HL0aeo8nLgNhNrjJhku75kImUB4vQJb0R6H7BbdJ5H2o0q38&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQo4iqul8FbXeh4R1n3ptdKlRfn_HNaeNnIwOwofxzspQ&oe=6B099ABB"}, "display_name": "The Trails V2", "keywords": ["MonkeyHorror", "GorillaHorror", "MultiplayerHorror", "Monke", "Scary"], "long_description": "Grab on and swing. The Trails V2 is a VR monkey game you play with your arms: climb, jump and launch yourself around a big underground facility with friends.\n\nHANG OUT\nMeet up in the hub, play a game of basketball on the practice court, or step through the portal into the combat arena.\n\nDRESS UP\nCollect cosmetics from the boutique: hats, face gear, outfits and things to hold. Show them off in your wardrobe and swap your look whenever you like.\n\nTHEN GO DEEPER\nThe tunnels under the facility aren't empty. Something lives down there. It hunts by sight and hears anyone moving nearby, so sometimes the only way to survive is to stand still and stay hidden.\n\nPast the tunnels are the labs, where Subject 25 was kept. It's loose, and it's coming.\n\nLevel 3 is sealed for now. More is coming soon.\n\nFEATURES\n- Arm-swing monkey movement: climb, jump and fling yourself around\n- Multiplayer hangouts with friends\n- Basketball court and a combat arena\n- Cosmetics shop and wardrobe\n- Two horror levels with different creatures hunting you\n- Carry a lantern or flashlight into the dark", "short_description": "Swing through a monkey hangout with your friends, then go down into the tunnels and labs where something is hunting you. A VR monkey horror game."}]}, "developer_name": "Will", "developer_privacy_policy_url": "https://sites.google.com/view/thetrailsprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Will", "support_website_url": null, "website_url": "https://sites.google.com/view/the-trails/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": [], "id": "29177107241951768"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823940_1161672323101275_311878072043602489_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ZCxUPhzxjIQ7kNvwF68PmA&_nc_oc=Adq1AmoBsxUXViKHFrzJm5Eaq_KifF9DPUfbdnzjVHjWtgVb1H7rg49XLjDLyiw_Cwc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5WT8XIlOaG-qet2aGYrV8kQOGZCsdIcUuSxnVrMU4Tg&oe=6B09A760"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Trails V2", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Survival", "id": "644354873106712"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1790090760, "lastRevision": {"nodes": [{"id": "25867338566262002", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "25867338519595340", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1033517349067671"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {
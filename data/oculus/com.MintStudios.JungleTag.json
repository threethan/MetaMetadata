w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRnKtFjxqF1OABdmp7VU2HTc1U0iq-oL71vkjUgr21Tuw&oe=6AF8AB44"}, {"file_name": "SampleScene_Custom..._17.01.2026_22-36-21.png", "id": "1828369857834839", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619697_1828369861168172_3064102469974592328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zyN-GkGs9QcQ7kNvwGmchUq&_nc_oc=AdomtHiwkiupVJ9mM76Aspq_xVr1dG9BYpd1W73ppx7MAYq2dWtUQwOq3mMDsbw3nEs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpxm6KS5Hl0jRQBFdGbCDckW0KDeZ0o-sd10711cd1ww&oe=6AF89FEA"}, {"file_name": "SampleScene_1080p_18.01.2026_22-19-50.png", "id": "1555979412330377", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619078_1555979418997043_884299107177534126_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rp8ORvXfMrAQ7kNvwHH2mD5&_nc_oc=AdpBLnp6Jc-GViNVZBebT96-VHtej4Vb6z6TXLAcotabjV7GNMTqkUw9dstn0M_Vn7k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6YkT4Aey5SjBwVZzrtcRVpJlYCSWvpKp1N4TCYTn2oA&oe=6AF891C3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Jungle Tag VR", "keywords": ["Tag", "JungleTag"], "long_description": "**Jungle Tag VR** is an early access multiplayer VR game all about movement, momentum, and chaos in the jungle.\n\nSwing, climb, and launch yourself through trees, vines, ruins, and platforms using only your arms. There are no joysticks for movement; how fast you go depends entirely on your skill. Chasing players through the treetops or barely escaping a tag at the last second is what the game is all about.\n\nThis game is still in development, which means things will change over time. New maps, features, and improvements are planned, and bugs may still exist. Early access lets you play the game early, give feedback, and help shape its future.\n\nWhether you are playing with friends or meeting new players, Jungle Tag VR focuses on fun, fast-paced matches, simple mechanics, and social VR moments that feel different every time you play.\n\nThanks for supporting the game early;  your feedback helps make Jungle Tag VR better with every update.\n", "short_description": "Jungle Tag is a Gorilla Tag fan game with all sorts of features to try!"}]}, "developer_name": "MintManVR", "developer_privacy_policy_url": "https://mintmanbusiness.wixsite.com/minttag", "developer_terms_of_service_url": null, "publisher_name": "MintManVR", "support_website_url": null, "website_url": "https://mintmanbusiness.wixsite.com/minttag", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "26624552167133996"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27139405892315285", "version": "4.1"}, "id": "2240780996448632", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26606618868927326", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27139405892315285"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"cha
scdn.com/v/t64.5771-25/499619697_1828369861168172_3064102469974592328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-WUWHC-9B2AQ7kNvwGLIWBS&_nc_oc=AdpzQaQAa5cfCVLie98SmTuoMeutsyv7xrZkOjTUKP0IT0LMuQxIGkk6u5buuZZJdmc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwKYT4rN2S4zBksjfK71MXJY5mtnZOFnr1dIus4I5Fb0A&oe=69CD232A"}, {"file_name": "SampleScene_1080p_18.01.2026_22-19-50.png", "id": "1555979412330377", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619078_1555979418997043_884299107177534126_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MDWUs0xI43UQ7kNvwG_QmTb&_nc_oc=AdoH5uZU3GDBtdY7Y0M6_hqfp73xlpurVy_cOonkQ9RbaEVtVMF0RIP-zmdeXJiV5bA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwg5Q2DYPsv8u23D7VM2RidK1cNrUTsFNF4djeekgrdgw&oe=69CD1503"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Jungle Tag VR", "keywords": ["Tag", "JungleTag"], "long_description": "**Jungle Tag VR** is an early access multiplayer VR game all about movement, momentum, and chaos in the jungle.\n\nSwing, climb, and launch yourself through trees, vines, ruins, and platforms using only your arms. There are no joysticks for movement; how fast you go depends entirely on your skill. Chasing players through the treetops or barely escaping a tag at the last second is what the game is all about.\n\nThis game is still in development, which means things will change over time. New maps, features, and improvements are planned, and bugs may still exist. Early access lets you play the game early, give feedback, and help shape its future.\n\nWhether you are playing with friends or meeting new players, Jungle Tag VR focuses on fun, fast-paced matches, simple mechanics, and social VR moments that feel different every time you play.\n\nThanks for supporting the game early;  your feedback helps make Jungle Tag VR better with every update.\n", "short_description": "Jungle Tag is a Gorilla Tag fan game with all sorts of features 
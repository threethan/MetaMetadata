-1.oculuscdn.com&oh=00_Afso4ZCnmeljoBMUjdiiaLsQ9F7FPeFbPRCxgt_3nW0U5A&oe=69A0502A"}, {"file_name": "SampleScene_1080p_18.01.2026_22-19-50.png", "id": "1555979412330377", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619078_1555979418997043_884299107177534126_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1WS9euouPj4Q7kNvwHtl9F4&_nc_oc=Adn6A-9by_RCHBd76uzitWeoGnSXo6RGbxoxJdm4sql0-qBkDtsj3KcJ6kyiY6JTNso&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvm0jeVSkXfZHAXTJDbW4BOHfkOmjdlI6V-ZVQblsznPg&oe=69A04203"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Jungle Tag VR", "keywords": ["Tag", "JungleTag"], "long_description": "**Jungle Tag VR** is an early access multiplayer VR game all about movement, momentum, and chaos in the jungle.\n\nSwing, climb, and launch yourself through trees, vines, ruins, and platforms using only your arms. There are no joysticks for movement; how fast you go depends entirely on your skill. Chasing players through the treetops or barely escaping a tag at the last second is what the game is all about.\n\nThis game is still in development, which means things will change over time. New maps, features, and improvements are planned, and bugs may still exist. Early access lets you play the game early, give feedback, and help shape its future.\n\nWhether you are playing with friends or meeting new players, Jungle Tag VR focuses on fun, fast-paced matches, simple mechanics, and social VR moments that feel different every time you play.\n\nThanks for supporting the game early;  your feedback helps make Jungle Tag VR better with every update.\n", "short_description": "Jungle Tag is a Gorilla Tag fan game with all sorts of features to try!"}]}, "developer_name": "MintManVR", "developer_privacy_policy_url": "https://mintmanbusiness.wixsite.com/minttag", "developer_terms_of_service_url": null, "publisher_name": "MintManVR", "support_website_url": null, "website_url": "https://mintmanbusiness.wixsite.co
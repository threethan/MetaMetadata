l0SYDmHezQHKcaCK4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKerKCbFRqz3xiTm7YLCm30wWqAUEoRNZS6kfzfWtF_g&oe=6ACFB261"}, {"file_name": "SampleScene_Custom..._02.09.2026_18-48-39.png", "id": "2748768155466563", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622325_2748768158799896_4458841522695665931_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IJagI2h8vCYQ7kNvwHhPn9G&_nc_oc=AdpJ3aAyYnSBYwcIpXj2ifSSXW_ok-c4nxZQYiCGxSm-uEHfhwXf-xfjX0sa0_wVco0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP9aOjGDGVxs5KMKUCI4j1VPZEHMp7B7oH5hoW0OFa0cg&oe=6ACFA8A1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Jungle Tag VR", "keywords": ["Tag", "JungleTag"], "long_description": "**Jungle Tag VR** is an early access multiplayer VR game all about movement, momentum, and chaos in the jungle.\n\nSwing, climb, and launch yourself through trees, vines, ruins, and platforms using only your arms. There are no joysticks for movement; how fast you go depends entirely on your skill. Chasing players through the treetops or barely escaping a tag at the last second is what the game is all about.\n\nThis game is still in development, which means things will change over time. New maps, features, and improvements are planned, and bugs may still exist. Early access lets you play the game early, give feedback, and help shape its future.\n\nWhether you are playing with friends or meeting new players, Jungle Tag VR focuses on fun, fast-paced matches, simple mechanics, and social VR moments that feel different every time you play.\n\nThanks for supporting the game early;  your feedback helps make Jungle Tag VR better with every update.\n", "short_description": "Jungle Tag is a Gorilla Tag fan game with all sorts of features to try!"}]}, "developer_name": "MintManVR", "developer_privacy_policy_url": "https://mintmanbusiness.wixsite.com/jungletag", "developer_terms_of_service_url": null, "publisher_name": "MintManVR",
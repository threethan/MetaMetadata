h all sorts of features to try!"}]}, "developer_name": "MintManVR", "developer_privacy_policy_url": "https://mintmanbusiness.wixsite.com/minttag", "developer_terms_of_service_url": null, "publisher_name": "MintManVR", "support_website_url": null, "website_url": "https://mintmanbusiness.wixsite.com/minttag", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "26624552167133996"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27139405892315285", "version": "4.1"}, "id": "2240780996448632", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26606618868927326", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27139405892315285"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2240780996448632"}]}, "change_log": null, "created_date": 1773544324, "id": "27139405892315285", "version": "4.1", "version_code": 30, "release_status": "RELEASED", "status": "APPROVED", "binary_test_resu
0337F7"}, {"file_name": "SampleScene_Custom..._02.09.2026_18-47-28.png", "id": "885681677650585", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618284_885681680983918_5530505999950360418_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dpv3G8kQofQQ7kNvwFDGIYI&_nc_oc=AdoLXKueGWSDX0H04JedlsYulCGEjg0-eOJmN2v5xD6llVzEvtsjHkw295i2djOFsys&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTih_CPGe6JHzyYy0Mh47b-40fDFvcnvtoZseFxMCcR6Q&oe=6B031CE1"}, {"file_name": "SampleScene_Custom..._02.09.2026_18-48-39.png", "id": "2748768155466563", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499622325_2748768158799896_4458841522695665931_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mvpmlT_mECcQ7kNvwHB3C3e&_nc_oc=Adq5J1JP6cBbpg-rVgvKbbUy4US8AXSwAnivXhGNEaqdAAfiywiDyEPM7PsS8O0CRq4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0QzEauHch8F2zK7y0XiOzszjjqN_18m88G9JA5zPZ9g&oe=6B031321"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Jungle Tag VR", "keywords": ["Tag", "JungleTag"], "long_description": "**Jungle Tag VR** is an early access multiplayer VR game all about movement, momentum, and chaos in the jungle.\n\nSwing, climb, and launch yourself through trees, vines, ruins, and platforms using only your arms. There are no joysticks for movement; how fast you go depends entirely on your skill. Chasing players through the treetops or barely escaping a tag at the last second is what the game is all about.\n\nThis game is still in development, which means things will change over time. New maps, features, and improvements are planned, and bugs may still exist. Early access lets you play the game early, give feedback, and help shape its future.\n\nWhether you are playing with friends or meeting new players, Jungle Tag VR focuses on fun, fast-paced matches, simple mechanics, and social VR moments that feel different every time you play.\n\nThanks for supporting the game early;  your feedback helps make Jungle Tag VR better with every update.\n", "short_description": "Jungle Tag is a Gorilla Tag fan game with all sorts of features to try!"}]}, "developer_name": "MintManVR", "developer_privacy_policy_url": "https://mintmanbusiness.wixsite.com/jungletag", "developer_terms_of_service_url": null, "publisher_name": "MintManVR", "support_website_url": null, "website_url": "https://mintmanbusiness.wixsite.com/jungletag", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "29495367426719108"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618910_1935753037325092_6931728319453272864_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xra30-PGgXcQ7kNvwGVYWTQ&_nc_oc=AdqWbFENqFBu-U260rSGWyglWmvB7fF5TqXYGX0m7D6Y6zIKX42n2lwbsFRZ83Fqs5Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfQplAz6k2l1XXuAtFQvpHOX0hPKUdyQ0ZtAARIVATDA&oe=6B031A4B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Jungle Tag VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Hangout", "id": "102377078
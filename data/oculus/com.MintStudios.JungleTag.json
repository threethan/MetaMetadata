scdn.com/v/t64.5771-25/499619697_1828369861168172_3064102469974592328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3BYjTW0MS3AQ7kNvwEVsKZ_&_nc_oc=Ado6QkVWtJamGxUIdt8PQXyYRwxZlNbATHoJaJzjQcUUg3LI_ETAtfugCkKODry6SC4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4PULxODhfiKccZKEkL_krD_uPNHIShd6xE0CWCEQWm3w&oe=69FB47AA"}, {"file_name": "SampleScene_1080p_18.01.2026_22-19-50.png", "id": "1555979412330377", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619078_1555979418997043_884299107177534126_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VBTiu07OzlgQ7kNvwHjmtiz&_nc_oc=AdrGwUzso3bojWl8oEjahkZ2DopcEzx6MUSHWLHXuSzKCN-TzUSsLMCWGvp-k7hetNg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5nr1-2Zpm0_m_zxwtjz51Nnl0jtxIf5LM2vCuU22l9wA&oe=69FB3983"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Jungle Tag VR", "keywords": ["Tag", "JungleTag"], "long_description": "**Jungle Tag VR** is an early access multiplayer VR game all about movement, momentum, and chaos in the jungle.\n\nSwing, climb, and launch yourself through trees, vines, ruins, and platforms using only your arms. There are no joysticks for movement; how fast you go depends entirely on your skill. Chasing players through the treetops or barely escaping a tag at the last second is what the game is all about.\n\nThis game is still in development, which means things will change over time. New maps, features, and improvements are planned, and bugs may still exist. Early access lets you play the game early, give feedback, and help shape its future.\n\nWhether you are playing with friends or meeting new players, Jungle Tag VR focuses on fun, fast-paced matches, simple mechanics, and social VR moments that feel different every time you play.\n\nThanks for supporting the game early;  your feedback helps make Jungle Tag VR better with every update.\n", "short_description": "Jungle Tag is a Gorilla Tag fan game with all sorts of features 
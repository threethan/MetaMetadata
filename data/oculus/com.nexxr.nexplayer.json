f1JWAIMeXle6HQ8fggBZ3y8wlNhEwaRXroEBPvNS4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0rL6CoFdzxWLFFwp4GnOK7NNtNtCxw_LWG4qim29bbQ&oe=6A899B48"}, "display_name": "NEX | 3D Video Player", "keywords": ["player", "videoplayer", "video", "movie", "3D"], "long_description": "NEX is a VR video player designed for immersive, distraction-free watching.\n\n# Video playback\n\n- Browse your library and continue playback inside the viewing environment\n- Play MVC videos in immersive 3D\n- Stream videos to NEX with NEX Link\n\n# AI-powered 3D\n\n- Convert 2D videos into immersive 3D with NEX Link\n- Choose between Fast and High Quality conversion modes\n- Available on PCs and Macs with M-series chips\n\n# Spatial controls\n\n- Use controls that maintain a consistent size at any distance\n- Customize the first layer with your most used shortcuts\n\n# Viewing environments\n\n- Watch in photorealistic spaces, including a cinema hall, a quiet lakeside, and a modern cabin\n\nNEX is free to download with a time-limited trial.\n\nUnlock the FULL version with a single purchase.\n\nJoin Discord: https://discord.gg/xdFpe3D3G6\n\nSupport: support@nexplayer.net", "short_description": "A VR video player that converts 2D videos into 3D, with lifelike cinema environments and a customizable spatial UI."}]}, "developer_name": "NEX", "developer_privacy_policy_url": "https://nexplayer.net/privacy", "developer_terms_of_service_url": null, "publisher_name": "NEX ", "support_website_url": null, "website_url": "https://nexplayer.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "393222478507326"}, {"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended
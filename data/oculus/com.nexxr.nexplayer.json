_6QDO3RwCZlPXxuGkVyWx4w1utrG48RIq5BqIrP8Xdd2ok&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzRijwphvLJM0zRE3b1fnt2pp6VxogkXglM-CAxDkzidw&oe=69B15CF2"}, {"file_name": "4.png", "id": "1894482524440207", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619677_1894482527773540_598577196358648871_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HmpK6rGOasQQ7kNvwEvi8L9&_nc_oc=AdkEtdvz_Uc3Wyd8yUX-UgPjpMPiHkdbRfBte2ikqK6kby7S6NNrCVQnBOrfwxR_v_Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxVNVtrj2j0xgO14b1SnQZj079Xh0R9Ab1HltN1-Hu5zQ&oe=69B16BF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videocover.png", "id": "913629467749336", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619113_913629471082669_227475960791542977_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sSOeYQ8qtREQ7kNvwFyLWR8&_nc_oc=AdmfNaB76qSjvhekfQsEZrM6UPfA8JWHJouv1GN3o-uEsAl4ax4P7T0hwvqtvz6xrTU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afyy2VxYfg9ghlNioWTcefnWwG7PqIfURO4wA5IyeONPyQ&oe=69B16548"}, "display_name": "NEX | NEXt-Gen Video Player", "keywords": ["player", "videoplayer", "video", "movie", "bigscreen"], "long_description": "NEX is a next-generation VR video player built for comfortable, uninterrupted watching.\n   \nEverything is designed to stay out of the way, so the video takes center stage.  \n\n# Start watching instantly\n\nNo waiting. No setup.\n\nWhen you enter NEX, you are already inside a ready-to-watch space.\n\nBrowse your library, switch videos, or continue playback without leaving the environment.\n{4168143183437241}\n\n# Controls that feel natural\n\nNEX rethinks video playback with a fully spatial control system built for VR.\n\nControl panels keep a consistent visual scale at different distances, and you can customize the first layer with the shortcuts you use most.\n\nInteraction feels direct and intuitive.\n{780994594568030}\n\n\n# Cinema spaces, reimagined\n\nChoose from thoughtfully designed viewing spaces, from grand theaters to calm, intimate settings.\n\nWatch in a cinema hall, a quiet lakeside, or a warm modern cabin.\n\nEach space is designed to support focused, comfortable viewing without distraction.\n{744273265415995}\n# AI-powered 3D depth (BETA)\n\nWith NEX Link on your PC, 2D videos can be converted into 3D with natural depth and spatial presence. \nCurrently supported on PCs equipped with NVIDIA GPUs.\n\n# Free to try, unlock once\n\nNEX is free to download with a time-limited trial.\n\nUnlock the full version to access all features, environments, and unlimited 3D conversion with a single purchase.\n{1548331379585413}\nNEX continues to evolve through updates and user feedback.\n\nJoin Discord: https://discord.gg/xdFpe3D3G6 \n\nSupport: support@nexplayer.net\n\n{925390286678384}\n\n\n\n\n", "short_description": "A VR video player with a reimagined, customizable UI, never-seen cinema environments, and the ability to convert any 2D video into 3D."}]}, "developer_name": "NEX", "developer_privacy_policy_url": "https://nexplayer.net/privacy", "developer_terms_of_service_url": null, "publisher_name": "NEX ", "support_website_url": null, "website_url": "https://nexplayer.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26387761400831084"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scon
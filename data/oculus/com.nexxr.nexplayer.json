NvwFFudun&_nc_oc=Ado9BJiNiC9yy4YUDQ7oicvbhKu0vCvf4aTEzEEcmG-pd86TxMRXmiLD4N2QmIYYFk4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3-IISYe2pIhod0wA5U2QDyIpb0hd68bnoFcVcz_O-bTg&oe=69D4E212"}, {"file_name": "4.png", "id": "1894482524440207", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619677_1894482527773540_598577196358648871_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ef2mpXfth78Q7kNvwEbhZlR&_nc_oc=AdpvGWF5UKwX7NL2BIj03FRvPkYKY1pIKY08QIBAbQbS9Gb2xvxVbCEjudTQC6EVBaQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3mDe2DsvQ1xy5sIfNy3bGV7u7ePI6uE-nBaSZp5UcLGA&oe=69D50473"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videocover.png", "id": "913629467749336", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619113_913629471082669_227475960791542977_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ndd3ge7v5woQ7kNvwExagde&_nc_oc=AdqhJ726HMNHlraGfuk5gKy4hrva7qB0VCHgzVZzmHFXjYwlQOatxWEQFeA95UKpNec&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Wk7S4Bi84PIO4bHkAeUzE8l7YhpLTCXmqDcsW7Btkzw&oe=69D4FDC8"}, "display_name": "NEX | NEXt-Gen Video Player", "keywords": ["player", "videoplayer", "video", "movie", "bigscreen"], "long_description": "NEX is a VR video player built for immersive, distraction-free watching.\n\nEverything is designed to stay out of the way, so the video takes center stage.\n\nWith NEX Link on your PC with an NVIDIA GPU, or on a Mac with an M-series chip, you can watch your 2D videos in immersive 3D.\n\n# Start watching instantly\n\nNo waiting. No setup.\n\nWhen you enter NEX, you are already in a ready-to-watch space.\n\nBrowse your library, switch videos, or continue playback without leaving the environment.\n{4168143183437241}\n\n# Controls that feel natural\n\nNEX rethinks video playback with a fully spatial control system.\n\nControl panels keep a consistent size at any distance, and you can customize the first layer with your most used shortcuts.\n\nInteraction feels direct and intuitive.\n{1420975549337390}\n\n# Cinema spaces, reimagined\n\nChoose from photorealistic environments.\n\nWatch in a cinema hall, a quiet lakeside, or a warm modern cabin.\n\nEach environment is designed for focused, comfortable viewing.\n{744273265415995}\n# AI-powered 3D depth\n\nWith NEX Link on your PC, 2D videos can be converted into 3D with natural depth and spatial presence.\nChoose between Fast or High Quality conversion modes.\nCurrently supported on PCs with NVIDIA GPUs, and on Macs with M-series chips.\n\n# Free to try, unlock once\n\nNEX is free to download with a time-limited trial.\n\nUnlock the FULL version to access all features, environments, and unlimited 3D conversion with a single purchase.\n{1548331379585413}\nNEX continues to evolve through updates and your feedback.\n\nJoin Discord: https://discord.gg/xdFpe3D3G6 \n\nSupport: support@nexplayer.net\n\n{925390286678384}\n", "short_description": "A VR video player that converts 2D videos into 3D, with lifelike cinema environments and a customizable spatial UI."}]}, "developer_name": "NEX", "developer_privacy_policy_url": "https://nexplayer.net/privacy", "developer_terms_of_service_url": null, "publisher_name": "NEX ", "support_website_url": null, "website_url": "https://nexplayer.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "
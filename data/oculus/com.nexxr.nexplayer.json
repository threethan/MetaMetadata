 "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499619098_2386439818491031_4561246184039729075_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ijedTtw8bI0Q7kNvwEJBMNt&_nc_oc=AdoIy1E3qx0WOKyyMmcYbc51EBPZWH0X64PjwF_84o8pT4dg7vr0SoPaBBPAhJToRLM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQxHymGp-3WW-Fh7BTveCIkO_ecX8BGD4D-ATotEeqSQ&oe=6A881ECB"}, {"file_name": "5.png", "id": "1890211658276814", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499619668_1890211664943480_6254373283882815530_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EcZxNra3U3cQ7kNvwH_3Pa1&_nc_oc=AdooOtymV1ENPU51SoKfMEfoDm8Naj1QYd1PYPMzge1LQJWicOTO3xTUCu58hVswDJg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFbbN0PKTDX8eKAlZzf9tXgxFFl1bvPo7jCtIn7rKrZ9w&oe=6A8837FF"}, {"file_name": "3.png", "id": "880936264688043", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499619646_880936268021376_4693875036684621953_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qN4nSH8orAoQ7kNvwHWShm9&_nc_oc=Adpa3IgMzUQ1SfP-h70VUj_24BCqouvYMtx6ZoPMM8Ax04Obl612RTXvxmMeRa5qK1E&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFbtW67rux_tTPDw4sP1ui66W2Z9lbvEOGTUU_TOtFEyw&oe=6A884172"}, {"file_name": "4.png", "id": "1894482524440207", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499619677_1894482527773540_598577196358648871_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vCjv8h-x7tAQ7kNvwHUd2ex&_nc_oc=Adrh_MmEV_H1zMmyh9jSG4iKcPuMOaFV5QJRN8TB4MwawCIOopn0p0bKm6jCF6v4Ajw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHnHJWY8hdumw_esl23RjKj8yXP0PLZ72FpA6Asobpfow&oe=6A885073"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videocover.png", "id": "913629467749336", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499619113_913629471082669_227475960791542977_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ko3CHNAPJNIQ7kNvwGcyAlz&_nc_oc=AdqOQevgbvR7XuWFxsMaY0_exDkOqpjp4K5w5zR6VYL6IE_mmehElKO-zFYUX0NGveU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8a6oErDvLvyfWwK-f41Rg3tpFS6oOHmz1qpijx4pktA&oe=6A8849C8"}, "display_name": "NEX | NEXt-Gen Video Player", "keywords": [], "long_description": "NEX is a next-generation VR video player built for comfortable, uninterrupted watching.\n   \nEverything is designed to stay out of the way, so the video takes center stage.  \n\n# Start watching instantly\n\nNo waiting. No setup.\n\nWhen you enter NEX, you are already inside a ready-to-watch space.\n\nBrowse your library, switch videos, or continue playback without leaving the environment.\n{4168143183437241}\n\n# Controls that feel natural\n\nNEX rethinks video playback with a fully spatial control system built for VR.\n\nControl panels keep a consistent visual scale at different distances, and you can customize the first layer with the shortcuts you use most.\n\nInteraction feels direct and intuitive.\n{780994594568030}\n\n\n# Cinema spaces, reimagined\n\nChoose from thoughtfully designed viewing spaces, from grand theaters to calm, intimate settings.\n\nWatch in a cinema hall, a quiet lakeside, or a warm modern cabin.\n\nEach space is designed to support focused, comfortable viewing without distraction.\n{744273265415995}\n# AI-powered 3D depth\n\nWith NEX Link on your PC, 2D videos can be converted into 3D with natural depth and spatial presence. \nCurrently supported on PCs equipped with NVIDIA GPUs.\n\n# Free to try, unlock once\n\nNEX is free to download with a time-limited trial.\n\nUnlock the full version to access all features, environments, and unlimited 3D conversion with a single purchase.\n{1548331379585413}\nNEX continues to evolve through updates and user feedback.\n\nJoin Discord: https://discord.gg/mtjkpXVXGW\n\nSupport: support@nexplayer.net\n\n{925390286678384}\n\n\n\n\n", "short_description": "A VR video player with a reimagined, customizable UI, never-seen cinema environments, and the ability to convert any 2D video into 3D."}]}, "developer_name": "NEX", "developer_privacy_policy_url": "https://nexplayer.net/privacy", "developer_terms_of_service_url": null, "publisher_name": "NEX ", "support_website_url": null, "website_url": "https://nexplayer.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26351840311089860"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1431891675091640"}]}, "baseline_offer": {"id": "1431891675091640"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1772419380, "status": "PUBLISHED", "id": "1431891675091640"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28075043222102885", "version": "1.2.0.0"}, "id": "4106763952900566", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25092971956976708", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28075043222102885"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "4106763952900566"}]}, "change_log": null, "created_date": 1785134646, "id": "28075043222102885", "version": "1.2.0.0", "version_code": 203, "r
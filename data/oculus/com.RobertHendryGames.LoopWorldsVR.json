g", "id": "284941672940228", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003242_284941676273561_7883752552368038035_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WbfGCwYERv4Q7kNvwEgZa4e&_nc_oc=Adm_wEfwtKe-NXObupMsrKmJ7YOV4g_FoQbFl1Ig0ViVI0Red5Q-s3v1wdxhIL8RxaE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxOIEZ72WEt13r_hR8XylxUBjEGCw79dRob1OCVYeRE6A&oe=69BD4FDD"}, {"file_name": "LWVRScreenshot3.png", "id": "421260138830206", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75196227_421260145496872_4801580291550141972_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oF044xoydzkQ7kNvwGv88wq&_nc_oc=Admt3nhtT5X9RMefmLIzECC-b0k0FOYGtj57oorlkNa609kG-h6_DY9ysvFQfBD-1BY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afyc8a1lV7hvuDLF4zB4JbNJlnrA8J_jX-i4mHELLdvAAA&oe=69BD4DA6"}, {"file_name": "LWVRScreenshot4.png", "id": "790515391766277", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035430_790515398432943_8849637006599992689_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w9jfOd55AHMQ7kNvwFyNRZB&_nc_oc=AdkhYB4W9vw58A9M9fNU4WFrcS5YjWF_tGOG3pFL4PWjSj8ivRrtqJCgRv3DeAOGI1I&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afw8MHII83xIefG5OfZ4cRqytu1WMa0GCgQpOWIv15gAkw&oe=69BD48A4"}, {"file_name": "LWVRScreenshot5.png", "id": "920379771814818", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031399_920379775148151_6130082779285979181_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yexro8fVs2UQ7kNvwFyEB3q&_nc_oc=Adltsaz_yI1p7dbGyTNlyebSGuF1Q0jqLK8W0Tx31lg19bPyJm-E-0O2pHZoEgcMB9U&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzHYcStplrQJRjDdp6vizSwYiUX88_-g0FXodR62BOiDw&oe=69BD5E92"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LoopWorlds", "keywords": ["logic", "puzzle", "brain", "create", "portal"], "long_description": "LoopWorlds is a game of difficult logic puzzles, with disco dance-floor graphics. \n\nAfter each stage of 8 levels, a new game mechanic will be added, including sliding ice blocks, button-activated walls, and portals.\n\nSwipe the touch pad to move the disco ball in that direction, and it will keep moving until it hits something. Also if the disco ball leaves a screen edge, it will loop back in again on the opposite side, making for a very interesting brain challenge. It gets pretty epic!\n\nYou can also create your own awesome levels and let your family try them out later.", "short_description": "LoopWorlds is a game of difficult logic puzzles, with disco dance-floor graphics. After each stage of 8 levels, a new game mechanic will be added, including sliding ice blocks, button-activated walls, and portals. It gets pretty epic!"}]}, "developer_name": "Robert Hendry Games", "developer_privacy_policy_url": "https://www.ultimateboostage.com/?page_id=150", "developer_terms_of_service_url": null, "publisher_name": "Robert Hendry Games", "support_website_url": "https://www.ultimateboostage.com/", "website_url": "https://www.ultimateboostage.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "PUZZLE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "694421564887297"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75210399_664937974098960_1674141396608285296_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Rn3NaDLDLoQ7kNvwFJCxnu&_nc_oc=AdnlXhWyt4mMtP7dm1azxBFqUXBL0V3yELzhSWKltEWKFk7431DFdb7i30bVS3hvXxQ&_nc_
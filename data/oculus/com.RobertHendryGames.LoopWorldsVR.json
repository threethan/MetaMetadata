g", "id": "284941672940228", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003242_284941676273561_7883752552368038035_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tQHgOOi1jWkQ7kNvwGNIi2K&_nc_oc=AdmsL-FUTUrg99NrMSljxGUhcUt-scrHX9PSBN0mVP_em2evPZn0yGybTBbPhE-JDC8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afwbtf4DyP0GhArvDfLiInwrfN8azD6apgpP_97L7mRmUA&oe=69B809DD"}, {"file_name": "LWVRScreenshot3.png", "id": "421260138830206", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75196227_421260145496872_4801580291550141972_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u-YYohcmCz8Q7kNvwENt6Sp&_nc_oc=AdkvdJIYkpKF0Bezzig2on9yYsomlzSDiE8kewy0ToDMb0RuP5fdnTV5zUcu30Z89E0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfynZy00TiBKzaqszFOZx2Sc4TrXoINjLnaCASG6qF0PZQ&oe=69B807A6"}, {"file_name": "LWVRScreenshot4.png", "id": "790515391766277", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035430_790515398432943_8849637006599992689_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fe4COu9i5ZwQ7kNvwHlXP21&_nc_oc=AdktgNLQ9iyOybGTbvK857qm95odlIjoHmGfQsyyUgpYYMAGOYCbVzNaX38NyBsqq1c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw9BtLjsGJv636g0J-4U5jvecGKbOFuhqUwwTU8D2IjQA&oe=69B802A4"}, {"file_name": "LWVRScreenshot5.png", "id": "920379771814818", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031399_920379775148151_6130082779285979181_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AIR-oHfLTOUQ7kNvwGoiI0V&_nc_oc=AdkhN14jUvNnvJUNAxOxFNnKRN5AbCCF9n3vWgQkpjd331z7aAUZdGZ1_2eNlXbBlLc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzTTiVAXUh0jnOQjpyttfIDm90P1sJiJ-KZmUGaidoKQA&oe=69B7E052"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LoopWorlds", "keywords": ["logic", "puzzle", "brain", "create", "portal"], "long_description": "LoopWorlds is a game of difficult logic puzzles, with disco dance-floor graphics. \n\nAfter each stage of 8 levels, a new game mechanic will be added, including sliding ice blocks, button-activated walls, and portals.\n\nSwipe the touch pad to move the disco ball in that direction, and it will keep moving until it hits something. Also if the disco ball leaves a screen edge, it will loop back in again on the opposite side, making for a very interesting brain challenge. It gets pretty epic!\n\nYou can also create your own awesome levels and let your family try them out later.", "short_description": "LoopWorlds is a game of difficult logic puzzles, with disco dance-floor graphics. After each stage of 8 levels, a new game mechanic will be added, including sliding ice blocks, button-activated walls, and portals. It gets pretty epic!"}]}, "developer_name": "Robert Hendry Games", "developer_privacy_policy_url": "https://www.ultimateboostage.com/?page_id=150", "developer_terms_of_service_url": null, "publisher_name": "Robert Hendry Games", "support_website_url": "https://www.ultimateboostage.com/", "website_url": "https://www.ultimateboostage.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "PUZZLE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "694421564887297"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75210399_664937974098960_1674141396608285296_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zllMWY9ZbecQ7kNvwFSCqWm&_nc_oc=AdkuUffMrkMC4WCe6-LlvZC9AXCVFz5p5jK8i8FsW7ZgiZ4RBKHZj4KaEEuJy2EMqgU&_nc_
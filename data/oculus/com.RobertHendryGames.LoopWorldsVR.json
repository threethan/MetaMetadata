g", "id": "284941672940228", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003242_284941676273561_7883752552368038035_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WbfGCwYERv4Q7kNvwFhZhaF&_nc_oc=AdlS_QR0hCL9pkRrPIyYYrkKJ97-T3Mc2zs0YDyAkUI7mUayE0IF8v__m1gSJaoODBM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwOxZMRTdRYrdKFE5YgpPtzzIkkL-kte1fk6_qt3dpqIQ&oe=69BEA15D"}, {"file_name": "LWVRScreenshot3.png", "id": "421260138830206", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75196227_421260145496872_4801580291550141972_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oF044xoydzkQ7kNvwF5391g&_nc_oc=AdmgrF9MYtnmiIPd-vbtMsPjbouWjIQEFBlwuMR68K0MnUIKKr9nk9Zll1oxCjs2tS0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwZWJNUy3FOvVijK9uqOoVm-V3vRG7GLIgQUa6AaUkDeg&oe=69BE9F26"}, {"file_name": "LWVRScreenshot4.png", "id": "790515391766277", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035430_790515398432943_8849637006599992689_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w9jfOd55AHMQ7kNvwEIUtxr&_nc_oc=AdkSxtUn87qyhnOk6372A-WXNKEpp15a7OA72pZW2JMgu8AgK_me2IuD6Va5Ev-lJJc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxE77A4zMJ9p8xpqNaeKKZS9cuwbEirp4tPJffdzDxq8g&oe=69BE9A24"}, {"file_name": "LWVRScreenshot5.png", "id": "920379771814818", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031399_920379775148151_6130082779285979181_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yexro8fVs2UQ7kNvwGvOCVf&_nc_oc=AdmOEXWV4Q7cA-t25AdRo--pX9MN1VQg4-eI4ynG49l12Ge6ZGuqszv86DWfE70h5hI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzeylAwaGPMTtChQJT_5v5RtUimtPv208ogRdud5xhr6g&oe=69BE77D2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LoopWorlds", "keywords": ["logic", "puzzle", "brain", "create", "portal"], "long_description": "LoopWorlds is a game of difficult logic puzzles, with disco dance-floor graphics. \n\nAfter each stage of 8 levels, a new game mechanic will be added, including sliding ice blocks, button-activated walls, and portals.\n\nSwipe the touch pad to move the disco ball in that direction, and it will keep moving until it hits something. Also if the disco ball leaves a screen edge, it will loop back in again on the opposite side, making for a very interesting brain challenge. It gets pretty epic!\n\nYou can also create your own awesome levels and let your family try them out later.", "short_description": "LoopWorlds is a game of difficult logic puzzles, with disco dance-floor graphics. After each stage of 8 levels, a new game mechanic will be added, including sliding ice blocks, button-activated walls, and portals. It gets pretty epic!"}]}, "developer_name": "Robert Hendry Games", "developer_privacy_policy_url": "https://www.ultimateboostage.com/?page_id=150", "developer_terms_of_service_url": null, "publisher_name": "Robert Hendry Games", "support_website_url": "https://www.ultimateboostage.com/", "website_url": "https://www.ultimateboostage.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "PUZZLE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "694421564887297"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75210399_664937974098960_1674141396608285296_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Rn3NaDLDLoQ7kNvwErFH0y&_nc_oc=AdnSnCSoXpsnvjf5XceZxL54m0Y23caI72hbGXMVfRJeppoqfVnZZKpovp7x9pUjfKg&_nc_
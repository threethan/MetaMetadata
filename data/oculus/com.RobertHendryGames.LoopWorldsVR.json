g", "id": "284941672940228", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003242_284941676273561_7883752552368038035_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rEibsSkP974Q7kNvwF2XYzN&_nc_oc=AdkYcorc3m8f4eI2mXzx6vncIwk7zz8p3UdVyu3SxsRR-t23WfTJW19AdSA3svauRQ4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyMv-aF0Bq19a9DJo64tT_XZRqSD4z320XjbGL2r9qbOw&oe=69BFF2DD"}, {"file_name": "LWVRScreenshot3.png", "id": "421260138830206", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75196227_421260145496872_4801580291550141972_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kuZflkEVGqcQ7kNvwFd8IPW&_nc_oc=Adkc67WiolZCTbm3LS2KhOYk3mYeDYCJLdsXfTVEmFEEs4VxKBP3wp1Iok__hnXA6aE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwiTYKMkDegYyqIKU_kzvN4yVGLaqogXiCARqbM2moNKA&oe=69BFF0A6"}, {"file_name": "LWVRScreenshot4.png", "id": "790515391766277", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035430_790515398432943_8849637006599992689_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w9jfOd55AHMQ7kNvwF5dVHl&_nc_oc=AdkdMZMdDj8QqJismdNBGDjItAHKdtDwDJ-QidwtHfL_blAJ-WC0qUCkutue4BhLlA4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxsHt5Ili9QRN5cww_rFcPw6b3bT00fiShzAEX0ejyy2Q&oe=69BFEBA4"}, {"file_name": "LWVRScreenshot5.png", "id": "920379771814818", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031399_920379775148151_6130082779285979181_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yexro8fVs2UQ7kNvwGXiD6u&_nc_oc=AdnPwdRcw0l1nvnL484jEdXt-FZGbiSx05oelvQk2LJL6emFJltdcC8B8mjHQfbjM_Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwKIjslSS_gPPCo9Y6r5TN3XtSr8ZWF-tvzbqmk5AsxZQ&oe=69C00192"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LoopWorlds", "keywords": ["logic", "puzzle", "brain", "create", "portal"], "long_description": "LoopWorlds is a game of difficult logic puzzles, with disco dance-floor graphics. \n\nAfter each stage of 8 levels, a new game mechanic will be added, including sliding ice blocks, button-activated walls, and portals.\n\nSwipe the touch pad to move the disco ball in that direction, and it will keep moving until it hits something. Also if the disco ball leaves a screen edge, it will loop back in again on the opposite side, making for a very interesting brain challenge. It gets pretty epic!\n\nYou can also create your own awesome levels and let your family try them out later.", "short_description": "LoopWorlds is a game of difficult logic puzzles, with disco dance-floor graphics. After each stage of 8 levels, a new game mechanic will be added, including sliding ice blocks, button-activated walls, and portals. It gets pretty epic!"}]}, "developer_name": "Robert Hendry Games", "developer_privacy_policy_url": "https://www.ultimateboostage.com/?page_id=150", "developer_terms_of_service_url": null, "publisher_name": "Robert Hendry Games", "support_website_url": "https://www.ultimateboostage.com/", "website_url": "https://www.ultimateboostage.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "PUZZLE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "694421564887297"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210399_664937974098960_1674141396608285296_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Rn3NaDLDLoQ7kNvwG6r2TO&_nc_oc=AdnvuPopCKNt5VgQKKAgDzTeWeYf3cxsytC3gGqVWjjODKxM_rqmdu5avWb6UJBmnNI&_nc_
g", "id": "284941672940228", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003242_284941676273561_7883752552368038035_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5gI4MVk_zK0Q7kNvwEAPeT7&_nc_oc=AdkGuMnTs5jv4rd3J22fDe5QHT97UCPPtbLoL_CNXu2-htsmvWtPZ1QoLrarP8OVvyk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwdfvxgclWee6zL3Wx3zyb6pK-hEwdKHhVl8pQrXXpD3Q&oe=69AC2C5D"}, {"file_name": "LWVRScreenshot3.png", "id": "421260138830206", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75196227_421260145496872_4801580291550141972_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ht7nqpHp3EYQ7kNvwGv-dIz&_nc_oc=Adl-C3zDPK6keuHUZR0v3cToRNEPxQ61xGMH-uldtPVFlK4QU3MRxG8FvYUShoYPInE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfytZ3P6aPFfOw2cobkkmpWrzKRGprZ09AQDF1dQC5uFbQ&oe=69AC2A26"}, {"file_name": "LWVRScreenshot4.png", "id": "790515391766277", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035430_790515398432943_8849637006599992689_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A6ZrlFYkgdgQ7kNvwGqkCPS&_nc_oc=Adnf5iaiWg9LUd4Lwn1ozLTKg28ij_ncdEGuORXug9sJE9UaamZF5dbJu2y4xTh39q8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyD3SHV5yDypdhfqnjjULPsQ8m22xOiRfCCcRIBn5kv6g&oe=69AC2524"}, {"file_name": "LWVRScreenshot5.png", "id": "920379771814818", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031399_920379775148151_6130082779285979181_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tm2WLXUDfCAQ7kNvwFKFtsP&_nc_oc=Adk9HuN0gJMndLnANzpzXT9SM8oyYrcC-0MBixm6wq94iL9zMVPrtlTpkUeOaHNkb6k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwE4d7wN4wkF5Ik1Lc70IiAj0DZ5TCWeTI-nrSsWoo1Kg&oe=69AC02D2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LoopWorlds", "keywords": ["logic", "puzzle", "brain", "create", "portal"], "long_description": "LoopWorlds is a game of difficult logic puzzles, with disco dance-floor graphics. \n\nAfter each stage of 8 levels, a new game mechanic will be added, including sliding ice blocks, button-activated walls, and portals.\n\nSwipe the touch pad to move the disco ball in that direction, and it will keep moving until it hits something. Also if the disco ball leaves a screen edge, it will loop back in again on the opposite side, making for a very interesting brain challenge. It gets pretty epic!\n\nYou can also create your own awesome levels and let your family try them out later.", "short_description": "LoopWorlds is a game of difficult logic puzzles, with disco dance-floor graphics. After each stage of 8 levels, a new game mechanic will be added, including sliding ice blocks, button-activated walls, and portals. It gets pretty epic!"}]}, "developer_name": "Robert Hendry Games", "developer_privacy_policy_url": "https://www.ultimateboostage.com/?page_id=150", "developer_terms_of_service_url": null, "publisher_name": "Robert Hendry Games", "support_website_url": "https://www.ultimateboostage.com/", "website_url": "https://www.ultimateboostage.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "PUZZLE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "694421564887297"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75210399_664937974098960_1674141396608285296_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mcX_SmMeIjsQ7kNvwHWDbbb&_nc_oc=AdlkNXwy_AQ7cZS39a9-Bo-T_OuDarclLcTE0OBl1da86i_ZRdZFveEHoNG8yr-Fv28&_nc_
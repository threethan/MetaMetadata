g", "id": "284941672940228", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003242_284941676273561_7883752552368038035_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WbfGCwYERv4Q7kNvwG22o3L&_nc_oc=AdkeNpsaGfPOF8Oc8r6NkT-FHNvPr1LDzEbQJHo3L5WGj6dyxX5fJYsnmU8BLt7RC4c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afz5X5z54ASXAOc9pY6qMxsO_f_2U_tkrplUtZSwTqM3vw&oe=69BBFE5D"}, {"file_name": "LWVRScreenshot3.png", "id": "421260138830206", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75196227_421260145496872_4801580291550141972_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oF044xoydzkQ7kNvwFgOEKD&_nc_oc=AdngINAFdUl3awea14skGKp4lxx_QTxTen21YDqG2dxH9aWRSfwBYf-8zCRhYx_XLBw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afxz6vhMqnYg8OSqvY2jAWieupwnsX_0aHeyi7md0l1UlA&oe=69BBFC26"}, {"file_name": "LWVRScreenshot4.png", "id": "790515391766277", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035430_790515398432943_8849637006599992689_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yLzBxUp8P7oQ7kNvwHTZz1j&_nc_oc=AdnVb4cqcufioxDwf6TN2Bll9IHPTr7_DNqvJDlZHrSpBmzJLLOn2dUAaeYKUwIP0qg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxE2OmVMfkliyVhzRKj2DCfBhYUZSy-cz4KIMmu3K05bQ&oe=69BBF724"}, {"file_name": "LWVRScreenshot5.png", "id": "920379771814818", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031399_920379775148151_6130082779285979181_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6beyqhTmZtwQ7kNvwE2OGwV&_nc_oc=AdnId_ViMN0wY6bvB_PCwknE8bawjOg2JpDhH3qJXCLr1kQ3Yz72abpq7JsCaoSnhns&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyYcabJ5b-NP8TecAju380KbPPjWaC2lmTYlEy4Loi6NA&oe=69BC0D12"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LoopWorlds", "keywords": ["logic", "puzzle", "brain", "create", "portal"], "long_description": "LoopWorlds is a game of difficult logic puzzles, with disco dance-floor graphics. \n\nAfter each stage of 8 levels, a new game mechanic will be added, including sliding ice blocks, button-activated walls, and portals.\n\nSwipe the touch pad to move the disco ball in that direction, and it will keep moving until it hits something. Also if the disco ball leaves a screen edge, it will loop back in again on the opposite side, making for a very interesting brain challenge. It gets pretty epic!\n\nYou can also create your own awesome levels and let your family try them out later.", "short_description": "LoopWorlds is a game of difficult logic puzzles, with disco dance-floor graphics. After each stage of 8 levels, a new game mechanic will be added, including sliding ice blocks, button-activated walls, and portals. It gets pretty epic!"}]}, "developer_name": "Robert Hendry Games", "developer_privacy_policy_url": "https://www.ultimateboostage.com/?page_id=150", "developer_terms_of_service_url": null, "publisher_name": "Robert Hendry Games", "support_website_url": "https://www.ultimateboostage.com/", "website_url": "https://www.ultimateboostage.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "PUZZLE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "694421564887297"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75210399_664937974098960_1674141396608285296_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kK9WV9PAZ6wQ7kNvwHqd7v-&_nc_oc=AdkwdIoBn6smCuOsTj6n5jqvNi_f43hP5WiexD9O64kIJJoI2UVH6qvD1YInRHethLk&_nc_
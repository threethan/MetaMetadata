g", "id": "284941672940228", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003242_284941676273561_7883752552368038035_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tQHgOOi1jWkQ7kNvwF2hWQC&_nc_oc=Adker2XCeNDi3XQxOMTzYbbaswGPabDfgf6zs6ROJVRSBp-00AY9NwQOfpLbPjT8J8Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwhITR4glKGSNAYXu4YiMtN6rvZ-JEPT-h9vd2FN0g8mQ&oe=69BAACDD"}, {"file_name": "LWVRScreenshot3.png", "id": "421260138830206", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75196227_421260145496872_4801580291550141972_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u-YYohcmCz8Q7kNvwGkAdnI&_nc_oc=AdlX6yw422nRnda0k5JW5Wr_FMg-vq0O8iA8lh-C478_FmzZukOLfnCWWjDT5V3QkTI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxaIZM80wczs0ULJ9Ymg34-_t-4k5J8uQc9fBvMPI5amQ&oe=69BAAAA6"}, {"file_name": "LWVRScreenshot4.png", "id": "790515391766277", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035430_790515398432943_8849637006599992689_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yLzBxUp8P7oQ7kNvwEsJyoO&_nc_oc=Adn81-CkzbsE-TYRWiF7znt2K76bYV3bIsFSr19SWsBCBUhKTVty1yCkKmMoN5rOBF8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxRhbN5XmKdNqDP_5NMD7JqGmNS25H-TyVmwDYC-xLrpw&oe=69BAA5A4"}, {"file_name": "LWVRScreenshot5.png", "id": "920379771814818", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031399_920379775148151_6130082779285979181_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6beyqhTmZtwQ7kNvwF7jn2a&_nc_oc=Adn8-aeLGA9n6MmyoDPFf3EzQ0XSDeeU4PI8x6Gxi4Qm1ExXxvRjTJeezZuNpMqg4v4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwiU440LDgQA_RzrlC79wwFghTeXYCH5ipoxBHS9F7_bg&oe=69BA8352"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LoopWorlds", "keywords": ["logic", "puzzle", "brain", "create", "portal"], "long_description": "LoopWorlds is a game of difficult logic puzzles, with disco dance-floor graphics. \n\nAfter each stage of 8 levels, a new game mechanic will be added, including sliding ice blocks, button-activated walls, and portals.\n\nSwipe the touch pad to move the disco ball in that direction, and it will keep moving until it hits something. Also if the disco ball leaves a screen edge, it will loop back in again on the opposite side, making for a very interesting brain challenge. It gets pretty epic!\n\nYou can also create your own awesome levels and let your family try them out later.", "short_description": "LoopWorlds is a game of difficult logic puzzles, with disco dance-floor graphics. After each stage of 8 levels, a new game mechanic will be added, including sliding ice blocks, button-activated walls, and portals. It gets pretty epic!"}]}, "developer_name": "Robert Hendry Games", "developer_privacy_policy_url": "https://www.ultimateboostage.com/?page_id=150", "developer_terms_of_service_url": null, "publisher_name": "Robert Hendry Games", "support_website_url": "https://www.ultimateboostage.com/", "website_url": "https://www.ultimateboostage.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "PUZZLE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "694421564887297"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75210399_664937974098960_1674141396608285296_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kK9WV9PAZ6wQ7kNvwEzd2Dd&_nc_oc=AdlcmIjwulF3x2uOWxmYFASunkzEECtlh-XVy9k3VDOEaxf9ZH3iAmHa1nNnkVdv5mM&_nc_
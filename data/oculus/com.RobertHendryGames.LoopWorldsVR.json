g", "id": "284941672940228", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003242_284941676273561_7883752552368038035_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9WBwadfD3bQQ7kNvwHX_RNR&_nc_oc=Admn6Ww-SSzryno6DL_1qufdw0qMdiDbOYSJRRTUQR2BpQ6_5O5NZJkQvYKj40XYRwk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx3hnhg8hzKIqD5Nbz9u9aoEDpTknjhosEfAVWM5vn-Wg&oe=69B020DD"}, {"file_name": "LWVRScreenshot3.png", "id": "421260138830206", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75196227_421260145496872_4801580291550141972_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EOELWFiBu-cQ7kNvwFQCFaU&_nc_oc=AdmoUdWg57Q98iBgeSCIKue6Psh2GkxcPFrJ4HMMGqTiOndiBaSmlYSzFZH7PzpDK2w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwb6nE2shk6h_mkfwHt84QKTIFt4n92JzWfWnHEX7GXuA&oe=69B01EA6"}, {"file_name": "LWVRScreenshot4.png", "id": "790515391766277", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035430_790515398432943_8849637006599992689_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BLDXDOktJogQ7kNvwFyOBAK&_nc_oc=AdmTx-Lseg78BUADaZvjgryVaKzpmMPIfkR-WnneI1OCjrDGDoi3xtNlWmESthNGncA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxIey08SAmxWkAIITyWlZk-VgHoEikTehWKk7zR8AbXkA&oe=69B019A4"}, {"file_name": "LWVRScreenshot5.png", "id": "920379771814818", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031399_920379775148151_6130082779285979181_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UkaFcsxLChoQ7kNvwEjKUW9&_nc_oc=AdnW-7AmO-GCQnpk3zW-MDCQRDqnoGtsS9P3PCDpGhLhmj-0MQgyJGNRskAWcmA--io&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyvJXG0p8o3z2c7PeeBoPboKgPHpnIQbYtWqe_Zw_ZlHw&oe=69AFF752"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LoopWorlds", "keywords": ["logic", "puzzle", "brain", "create", "portal"], "long_description": "LoopWorlds is a game of difficult logic puzzles, with disco dance-floor graphics. \n\nAfter each stage of 8 levels, a new game mechanic will be added, including sliding ice blocks, button-activated walls, and portals.\n\nSwipe the touch pad to move the disco ball in that direction, and it will keep moving until it hits something. Also if the disco ball leaves a screen edge, it will loop back in again on the opposite side, making for a very interesting brain challenge. It gets pretty epic!\n\nYou can also create your own awesome levels and let your family try them out later.", "short_description": "LoopWorlds is a game of difficult logic puzzles, with disco dance-floor graphics. After each stage of 8 levels, a new game mechanic will be added, including sliding ice blocks, button-activated walls, and portals. It gets pretty epic!"}]}, "developer_name": "Robert Hendry Games", "developer_privacy_policy_url": "https://www.ultimateboostage.com/?page_id=150", "developer_terms_of_service_url": null, "publisher_name": "Robert Hendry Games", "support_website_url": "https://www.ultimateboostage.com/", "website_url": "https://www.ultimateboostage.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "PUZZLE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "694421564887297"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75210399_664937974098960_1674141396608285296_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0NS1rf49gX8Q7kNvwEj8bc5&_nc_oc=AdkchNpDGH7AmG1ppAXIbxDZEkVCl8dHsO3dlZn6FI1UONjvH6dwaRb-ePFYANPWXrc&_nc_
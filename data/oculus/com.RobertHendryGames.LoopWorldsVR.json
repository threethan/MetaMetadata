g", "id": "284941672940228", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003242_284941676273561_7883752552368038035_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6oxtxNNBi-cQ7kNvwGr4a1b&_nc_oc=AdnE4W8S0cZpHZwO4tzt4b1slGERraDbl2dK2rFJF0uXH-zOyzOw1yXqJIKxLrPyQMY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwC6NpHwIzBxKKfr4Vu614qauXP8y0c8K5SZMx08K9O4A&oe=69B4155D"}, {"file_name": "LWVRScreenshot3.png", "id": "421260138830206", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75196227_421260145496872_4801580291550141972_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f5e-6zKtd8sQ7kNvwEB0W9t&_nc_oc=Adk7Z6W_gNESu06EUxUy3fi7uTFGyLF4NZk4OPw0RRp5WNbXeXqM-k7kMEbPax6bZ8k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy0rUppedtQ0H503yta0NHet9XA-spoV-7GbG5AG9Ks6w&oe=69B41326"}, {"file_name": "LWVRScreenshot4.png", "id": "790515391766277", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035430_790515398432943_8849637006599992689_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oXbyZWWqIpEQ7kNvwHKFQrS&_nc_oc=AdlJR-_gyruzkidosMHQpD06HfVWRR_T3pOxH8geabYz96C7KrDQkL10wPbOrryXYC4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy7Yc-TBxudFqnU8K54lAqroE0T2leR6StCvNnh9Vsy2w&oe=69B40E24"}, {"file_name": "LWVRScreenshot5.png", "id": "920379771814818", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031399_920379775148151_6130082779285979181_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P4mvHq7nw-oQ7kNvwEukPqF&_nc_oc=AdlPyEoUf2gMdcC4wr8DsJut5KWRwLG6iGhjadARPbENO1Oqh-uvc1hKmmzuLuMTZ58&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzCdf-DeaqovZRH6xvPNXPhgjiYqsIMkFdbjwsYppelLQ&oe=69B3EBD2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LoopWorlds", "keywords": ["logic", "puzzle", "brain", "create", "portal"], "long_description": "LoopWorlds is a game of difficult logic puzzles, with disco dance-floor graphics. \n\nAfter each stage of 8 levels, a new game mechanic will be added, including sliding ice blocks, button-activated walls, and portals.\n\nSwipe the touch pad to move the disco ball in that direction, and it will keep moving until it hits something. Also if the disco ball leaves a screen edge, it will loop back in again on the opposite side, making for a very interesting brain challenge. It gets pretty epic!\n\nYou can also create your own awesome levels and let your family try them out later.", "short_description": "LoopWorlds is a game of difficult logic puzzles, with disco dance-floor graphics. After each stage of 8 levels, a new game mechanic will be added, including sliding ice blocks, button-activated walls, and portals. It gets pretty epic!"}]}, "developer_name": "Robert Hendry Games", "developer_privacy_policy_url": "https://www.ultimateboostage.com/?page_id=150", "developer_terms_of_service_url": null, "publisher_name": "Robert Hendry Games", "support_website_url": "https://www.ultimateboostage.com/", "website_url": "https://www.ultimateboostage.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "PUZZLE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "694421564887297"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75210399_664937974098960_1674141396608285296_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hyQVNIj1I8wQ7kNvwHnsxsN&_nc_oc=AdmOR3Qd5ZaTByRi8L00kBDEhtpZ9SN8xmYgifNT-sWkjjCiTCK_3h-u8Y8iu29kv2k&_nc_
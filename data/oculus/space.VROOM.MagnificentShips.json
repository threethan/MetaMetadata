ntent-ord5-2.oculuscdn.com/v/t64.5771-25/473400793_633923109609015_8038197177680033568_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LHygcsuAJEYQ7kNvwF2gPjc&_nc_oc=AdoZg6ElfRJbWloYt3wccYw_V_VeC71mYr6cZhzjeC6GMYQOTytuhW71quUdOcAPHgI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ZnwPdMJ8osrr9q88j__mADvyuPOwT02X8NOO8gdorYw&oe=69EB8679"}, {"file_name": "Screenshot5.png", "id": "1236615407829870", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391949_1236615411163203_6793625200968117992_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TAZ7A004QN0Q7kNvwF-N20G&_nc_oc=AdojBrXeJ_gLPvbNdG61DFzuoe3pn1NFzKCzlzGtZ_B6q2zoU_B8qb4qv2X4kdysSZA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2DL2_X0rsSBrO89Hzq2gbZ1mIJwZFZ4Ug3GS_jRN8wSw&oe=69EB574B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "1167487215074082", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391883_1167487218407415_8367507673734608742_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vzBOEnay_4oQ7kNvwHdsuHy&_nc_oc=AdqQ4PPxbpgEQyOjZTbXY4TqFSpeP_CTq3CAdBQjfHbfL9sq4x7tMRXyUwIanb0iCCM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3K8E4OHActZ5G801tRUOt3ARI2rtGgoG47r9OzD_vCDw&oe=69EB55DE"}, "display_name": "Magnificent Ships", "keywords": [], "long_description": "Model ship lovers rejoice! This is a collection of six finely-detailed vessels for viewing at both model- and actual-size. Relax and enjoy the Zen-like experience that piloting small boats on liquid provides.  Pick them up for a closer look.  If you desire stimulation, try your hand at competing against a \"ghost-ship\" to capture the most buoys. For fun, try piloting them around inside a house, or even your own living-room via passthrough/mixed-reality.  Leisurely stroll their decks as they sail upon an ocean with dynamic day/night cycle. Each ship includes an \"action\" event while at sea, whereby mighty cannons fire, ship horns bellow, or the submarine dives.\n\nIncluded Ships:\n- Ocean liner: RMS Queen Mary\n- English \"race built\" galleon: The Mermaid (fictional)\n- Zumwalt class destroyer: USS Zumwalt (DDG-1000)\n- Iowa class battleship: USS Iowa (BB-61)\n- Research vessel: RV Calypso\n- German submarine: U-boat Type VII-C/41 (U-659)\n\nDesigned for use with a single controller:\n- Button A/X: change to next ship (long-press for previous)\n- Button B/Y: change to next environment (long-press for previous)\n- Trigger: move in direction controller is pointing.\n- Grip: (model-scale) grab ship , (full-scale) activate action.\n- Thumbstick: (model-scale) control ship, (full-scale) change-time & snap-turn\n- Thumb button: (ship model) double speed, (submarine model) hold to dive, tap to surface", "short_description": "Remote-control model ships in virtual or mixed-reality!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vroom.space/ships/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "VROOM.space", "support_website_url": null, "website_url": "https://vroom.space/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9025258787583549"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "2011071429753005"}, {"status": "PUBLISHED", "id": "1375766507569075"}, 
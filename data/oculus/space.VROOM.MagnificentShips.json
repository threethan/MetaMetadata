13951419450475_4779584993365986793_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kHXZCLvAH7wQ7kNvwFA0CDS&_nc_oc=AdoSlCVfb4XPaO_tbg7T8teG6h618fvQUb16o-CEaVsqLuVX5Ibaq-7-rND0HP7k7BY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrtSansdgiesB-qVhBPi4OGxniLna4hLufzxU9I8OXEg&oe=6AFB1E1F"}, {"file_name": "Screenshot4.png", "id": "633923102942349", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473400793_633923109609015_8038197177680033568_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SOhDPpRuFVkQ7kNvwG1R-_K&_nc_oc=AdrW0le819sR_Bov-5CRUBXrhk8ZMQpvJvnN5FCb1XsEmz8w4kaU7kBFJXqzvTjjQeM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQI7JCBqhYDanEdDHdQUawXCsLxU5pruGpfB37zIwiPtw&oe=6AFB1B79"}, {"file_name": "Screenshot5.png", "id": "1236615407829870", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391949_1236615411163203_6793625200968117992_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a-BOBrgSzC0Q7kNvwG2t7gq&_nc_oc=Ado0VYCemvUaLbbOiKG8zE8zNPiJrZZqdpkNlYAkhgT8X4-TJdl9A461XTUNNzz0Ang&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4CeWaivulLIX_I_RlCNWroi45WjNnYhcCidOIyb8icQ&oe=6AFB248B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "1167487215074082", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391883_1167487218407415_8367507673734608742_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GW41nmrNu4kQ7kNvwFqRNt0&_nc_oc=AdqAfDPepPGVo8kzvz8CWoQELxcy90sUb2aBozox6fhpWsTPEfpmxwZ1fd7IOakrDJk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEg5JgRip5Q3lQTNaFAKPILKeXaqwnyEYL3IrWkvqoKw&oe=6AFB231E"}, "display_name": "Magnificent Ships", "keywords": [], "long_description": "Model ship lovers rejoice! This is a collection of six finely-detailed vessels for viewing at both model- and actual-size. Relax and enjoy the Zen-like experience that piloting small boats on liquid provides.  Pick them up for a closer look.  If you desire stimulation, try your hand at competing against a \"ghost-ship\" to capture the most buoys. For fun, try piloting them around inside a house, or even your own living-room via passthrough/mixed-reality.  Leisurely stroll their decks as they sail upon an ocean with dynamic day/night cycle. Each ship includes an \"action\" event while at sea, whereby mighty cannons fire, ship horns bellow, or the submarine dives.\n\nIncluded Ships:\n- Ocean liner: RMS Queen Mary\n- English \"race built\" galleon: The Mermaid (fictional)\n- Zumwalt class destroyer: USS Zumwalt (DDG-1000)\n- Iowa class battleship: USS Iowa (BB-61)\n- Research vessel: RV Calypso\n- German submarine: U-boat Type VII-C/41 (U-659)\n\nDesigned for use with a single controller:\n- Button A/X: change to next ship (long-press for previous)\n- Button B/Y: change to next environment (long-press for previous)\n- Trigger: move in direction controller is pointing.\n- Grip: (model-scale) grab ship , (full-scale) activate action.\n- Thumbstick: (model-scale) control ship, (full-scale) change-time & snap-turn\n- Thumb button: (ship model) double speed, (submarine model) hold to dive, tap to surface", "short_description": "Remote-control model ships in virtual or mixed-reality!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vroom.space/ships/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "VROOM.space", "support_website_url": null, "website_url": "https://vroom.space/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9025258787583549"}}]}, "scheduled_offers": {"count": 16, "nodes": [{"status": "PUBLISHED", "id": "1836635650803781"}, {"status": "PUBLISHED", "id": "1443202398869339"}, {"status": "PUBLISHED", "id": "2029627474338808"}, {"status": "PUBLISHED", "id": "2133596290918162"}, {"status": "PUBLISHED", "id": "1390307286500894"}, {"status": "PUBLISHED", "id": "1272907051623772"}, {"status": "PUBLISHED", "id": "2011071429753005"}, {"status": "PUBLISHED", "id": "1375766507569075"}, {"status": "PUBLISHED", "id": "4211684925740530"}, {"status": "PUBLISHED", "id": "1405002918081508"}, {"status": "PUBLISHED", "id": "1821607738519949"}, {"status": "PUBLISHED", "id": "880528631403650"}, {"status": "PUBLISHED", "id": "1126976229650763"}, {"status": "PUBLISHED", "id": "654462774058233"}, {"status": "PUBLISHED", "id": "1039689808057872"}, {"status": "PUBLISHED", "id": "2762395950620231"}]}, "baseline_offer": {"id": "1443202398869339"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "1836635650803781"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28086150781067730", "version": "1.01"}, "id": "2087610815000761", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9025258774250217", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28086150781067730"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2087610815000761"}]}, "change_log": "v1.01:\n\u2022 Numerous performance optimizations for smoother rendering and gameplay.\n\u2022 Added spatialized audio.\n\u2022 Fixed missing engine sounds and disappearing surface sounds in ocean view.\n\u2022 Startup time reduced via better preload method for models/textures.\n\u2022 Rebuilt ocean to render faster and consume less CPU.\n\u2022 Ship placement when you change to ocean view is more accurate.\n\u2022 Improved ocean buoyancy.\n\u2022 Gave U-Boat VIIC a wetness shader that reacts to water level.\n\u2022 Fixed U-Boat VIIC's dive bubbles failing to work at times.\n\u2022 Switched to Open XR and Vulkan rendering.\n\u2022 Added an additional LOD level on Iowa's bofors.", "created_date": 1790781106, "id": "28086150781067730", "version": "1.01", "version_code": 200162, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9025258774250217", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28086150781067730"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2087610815000761"}]}, "change_log": null, "created_date": 1743397163, "id": "9094634427312651", "version": "1.00", "version_code": 200120, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9025258774250217", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28086150781067730"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2087610815000761"}]}, "change_log": null, "created_date": 1742963025, "id": "9065331843576243", "version": "1.00", "version_code": 200046, "release_status": "PENDING", "status": "CHANGES_REQUESTED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9025258774250217", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28086150781067730"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2087610815000761"}]}, "change_log": null, "created_date": 1742955388, "id": "9064810216961739", "version": "1.00", "version_code": 200045, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9025258774250217", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28086150781067730"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2087610815000761"}]}, "change_log": "Previous reviewer must be confused.  Game was thoroughly designed and tested for a seated position.  Using controller grip pulls ships toward player's hand and grabs them.  There are no other interactable objects/elements in the game, including UI.  \n\nPlayer movement is accomplished by pulling controller trigger to travel in pointed direction.  (In \"full scale\" ship view you may also snap-turn via thumbstick.)\n\nIf there is another reason \"seated play is unsupported\", please advise with specifics.", "created_date": 1742582088, "id": "9038034392972655", "version": "1.00", "version_code": 200010, "release_status": "PENDING", "status": "CHANGES_REQUESTED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
ntent-fra3-1.oculuscdn.com/v/t64.5771-25/473400793_633923109609015_8038197177680033568_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KcmFLnXVt-8Q7kNvwEA6Mn6&_nc_oc=AdrXPnyyn6QFUS2ZK2CBUsPfHvFn9_4h3H9E-IOvXFCLCTz-CZTGGOpUNwB7nfADgkM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0bsZ81zYrRe1hSjuTo9vjSQj0LL23OAEfnvQQHAGkRRQ&oe=69F61279"}, {"file_name": "Screenshot5.png", "id": "1236615407829870", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391949_1236615411163203_6793625200968117992_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XGsoFgF-2AAQ7kNvwHdomhE&_nc_oc=AdocWpmERtaWxpRiDp7uOVplY7jwL6r-oSfbY9ihyTnWhG7gYHaPyyq4iwQbzLT1Ask&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1lzbdbQHVj30YbgMlNti4bes_PmzxGAshi0sMU2Y6aCA&oe=69F61B8B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "1167487215074082", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391883_1167487218407415_8367507673734608742_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sxc0Ibb0CoEQ7kNvwEiyh91&_nc_oc=Adr4enjdZTu3KDwqZk8899COOOR5l7o3hQzjUoQn8mClAkJGLIeSdAVt5USGfCmftKk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1ArQ4RO9gMBxYjwu6d1wDpmHo4wKYvOZZ_eQg-CSUgYg&oe=69F61A1E"}, "display_name": "Magnificent Ships", "keywords": [], "long_description": "Model ship lovers rejoice! This is a collection of six finely-detailed vessels for viewing at both model- and actual-size. Relax and enjoy the Zen-like experience that piloting small boats on liquid provides.  Pick them up for a closer look.  If you desire stimulation, try your hand at competing against a \"ghost-ship\" to capture the most buoys. For fun, try piloting them around inside a house, or even your own living-room via passthrough/mixed-reality.  Leisurely stroll their decks as they sail upon an ocean with dynamic day/night cycle. Each ship includes an \"action\" event while at sea, whereby mighty cannons fire, ship horns bellow, or the submarine dives.\n\nIncluded Ships:\n- Ocean liner: RMS Queen Mary\n- English \"race built\" galleon: The Mermaid (fictional)\n- Zumwalt class destroyer: USS Zumwalt (DDG-1000)\n- Iowa class battleship: USS Iowa (BB-61)\n- Research vessel: RV Calypso\n- German submarine: U-boat Type VII-C/41 (U-659)\n\nDesigned for use with a single controller:\n- Button A/X: change to next ship (long-press for previous)\n- Button B/Y: change to next environment (long-press for previous)\n- Trigger: move in direction controller is pointing.\n- Grip: (model-scale) grab ship , (full-scale) activate action.\n- Thumbstick: (model-scale) control ship, (full-scale) change-time & snap-turn\n- Thumb button: (ship model) double speed, (submarine model) hold to dive, tap to surface", "short_description": "Remote-control model ships in virtual or mixed-reality!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vroom.space/ships/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "VROOM.space", "support_website_url": null, "website_url": "https://vroom.space/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9025258787583549"}}]}, "scheduled_offers": {"count": 11, "nodes": [{"status": "PUBLISHED", "id": "1272907051623772"}, {"status": "PUBLISHED", "id": "2011071429753005"}, 
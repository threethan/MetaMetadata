WUJ4N2n2SyylznM3hx2ep-Biap8k7BFlFKGja0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWzkQphx5VhsO2yuQHI86xdv9AY_0IozAcMlDjx6qD0hA&oe=6B103575"}, {"file_name": "Screenshot from 2025-06-02 17-22-05.png", "id": "1627075727996592", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499295542_1627075731329925_7916674432735920011_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q8lUaTUQ66YQ7kNvwFe_DM1&_nc_oc=AdqZV8NlifiuCW0_gr6CeVhLEjxrGHdfwr4EzuHW13ViV56KZ0l1i_H1Pc8yXPv3Szg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVKuUbAYfV3S5svb-I8GfZ_zB3qj4Iv-liGOUQ2lY6ftQ&oe=6B105666"}, {"file_name": "Screenshot from 2025-06-02 17-19-05.png", "id": "1887012221840398", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617729_1887012225173731_3802512596425516299_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5wNC7RWLwJsQ7kNvwG_q67B&_nc_oc=AdrQZlb5QjW2DH6qx3dIbmorS5NHVRIOPla6qTfaIoLzrp7un6rlmJ9wQHYL-YzAsYo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWnTitJPz63wPhpJSqNOr-9GlPkYEWlmBgU5K4qhqSTRA&oe=6B106787"}, {"file_name": "Screenshot from 2025-06-02 17-08.png", "id": "917121640539373", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618491_917121643872706_4249042767730245868_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cBJZWhshjXMQ7kNvwE6bDU3&_nc_oc=Ado-FrrTNwQOCK7QBZwQG6vWD6YIbsOnJwdjEkR3nWEK5hNeNEvx8wNG1ttbSY7rftw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXyFTzOkSnONSSoM7EZDabRFYK36zFRcaiQgANSG7VZhg&oe=6B103562"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorilla Game", "keywords": ["competitive", "social"], "long_description": "Step back to VR's early chaos with Gorilla Game! Immerse yourself in the addictively fun world of monke. Master unique hand-based locomotion, pushing off surfaces and swinging through blocks to become the ultimate gorilla.\n\nThis isn't just a game; it's a social sensation. Jump into public lobbies or create private rooms with friends, reliving the hilarious, chaotic energy of early VR social gaming. The social aspect is central, whether you're juking pursuers, coordinating with your team, or just chilling in the virtual forest.\n\nTest your monke instincts across fun game modes:\n\n    1v1: Competitive chases.\n    Infection: Spread the fun (and fear!).\n    Capture the Flag: Team-based flag snatching.\n    Fireball Monke: PvP with fireballs.\n    Bomb Tag: A high-stakes game of hot potato.\n\nGorilla Game focuses on the authentic 2020 experience: low-poly charm, blocky layouts, and pure, unadulterated fun. No complex menus, no overwhelming cosmetics \u2013 just pure gorilla action!", "short_description": "Swing through the simple monke world, mastering walls and obstacles. Chase, juke, and hang out with friends in chaotic multiplayer lobbies across a variety of game modes!"}]}, "developer_name": "enmity", "developer_privacy_policy_url": "https://gjax600.wixsite.com/website/home", "developer_terms_of_service_url": null, "publisher_name": "Volcanic Studios", "support_website_url": null, "website_url": "https://gjax600.wixsite.com/website", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "23972900755670907"}}]}, "scheduled_offers": {"c
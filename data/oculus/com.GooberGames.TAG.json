6767989696558", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499311582_1316767993029891_4705637181230336969_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BJ7kMdQE_X8Q7kNvwGYIIv-&_nc_oc=Adpcz8dZdp1CkY2XcqYn6QF8CjnqkTosRvqzPxtKrsoMurwDDg_EXs6cbA1w5HVTRLY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFxUolydUaEDa02gamHUJ6hICt8dm5TxbgZDYsjixd37g&oe=6A8EEA5A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491818860_908783172106325_4029656652719763094_n.png.png", "id": "1025157330261039", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499299772_1025157333594372_241466352877841963_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EEvb94n_zpsQ7kNvwHtmdEu&_nc_oc=AdqOQzYBjfu2FHqaZcbyLwc6jXDsGKreRIaFkVYPgSsSk4F6MBRmoiihUIQ4sdyvjaA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjSoxNLqtVL5z7jgB5auRVKLk5wyWC3W_K4TpH0OtovA&oe=6A8EE8DE"}, "display_name": "Gorilla Game", "keywords": ["tag", "social", "multiplayer", "sandbox", "gorilla"], "long_description": "# Ready to go full monke?\n\n**Gorilla Game** is a free multiplayer VR movement game built around the simple, chaotic fun that made old-school VR so special.\n\nNo overcomplicated stuff, just climb, swing, fling, juke, tag, and laugh with friends in fast social lobbies.\n\n# Play your way\n\n**Sandbox** - mess around, practice movement, and build your own fun\n\n**Infection** - classic run-and-tag survival chaos\n\n**Zone Ball** - a gravity-filled team mode where players fight to score\n\n**Fireball** - blast other monkes in fast PvP chaos\n\n**Challenges** - push your parkour skills to the limit\n\n**Custom Maps** - explore player-made worlds or create your own\n\nJump into public lobbies, make a private room with friends, or build your own chaos.\n\n**Simple, Social, Nostalgic, And Ridiculously fun.**\n{1537559831290651}", "short_description": "A free multiplayer VR movement game where you climb, swing, juke, tag, and hang out with friends. Play chaotic modes like Sandbox, Infection, Zone Ball, Fireball, Challenges, and Custom Maps."}]}, "developer_name": "enmity", "developer_privacy_policy_url": "https://gorillagamevr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Volcanic Studios", "support_website_url": null, "website_url": "https://gorillagamevr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "27956824957278447"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/585799753_1601760824840374_8339942753842831836_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rUoDFgFyFEwQ7kNvwHYpnZD&_nc_oc=Adp06x9QnHmHOJ6eU4RQlDx0rK_0615XXeubVhmROy0tA4mn3JbaIHpqSm9nzQj0uzg&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEEkPIbYRY-EsBb6RhTdlbKG-lPcBLvyDAqJTiOacgaJA&oe=6A8EC656"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Gorilla Game", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1749050160, "lastRevision": {"nodes": [{"id": "23971701272457522", "release_type": "SC
6_4731662983728359_4959210717928190708_n.png.png", "id": "1189904976584983", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619808_1189904979918316_8270575859881585029_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=15bXzwj8JlkQ7kNvwEiuwR_&_nc_oc=AdpKXvekOVsT9c9cHPPP37f76z21W6XCwsphwV2wFgj-lhmM1s1XqmU_tLXdpms-I2E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEarun0JDxZb3Cf9JIoUAL6HmqHD6nBfWaYx-OxYc2X7g&oe=6A8C1D18"}, {"file_name": "499623601_1322290942777998_6840678979716743435_n.png.png", "id": "2897132763969857", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619805_2897132767303190_2666423328393576972_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F3Apz7_IJJQQ7kNvwGzXwj_&_nc_oc=AdpSYpKzN_eBJlKFinj_-4biil9hci8fQyrGE1xBKABebsTiwwkxhaDFo4cPHTCh134&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGHdeVelQ5GoscI-PZpvX_Kfkkn6nIvqFKsx27rEGD8g&oe=6A8C251B"}, {"file_name": "Screenshot 2026-07-28 at 10.29.18\u202fPM.png", "id": "1061924336523658", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314657_1061924339856991_4036130126838360720_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vnti4txIPqMQ7kNvwExbAfA&_nc_oc=Adq7ruJruqgJ9Q_UW8Ee8KumaNsuNOgwGIQFfVcNBaxOQNAhEN5juSSpiqVUVn4yhI8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFaNzVXG6iQl41gr3msAVEa1_92t7tkhdm6sBQ5Mho32Q&oe=6A8C2525"}, {"file_name": "499622315_1515658520095783_7377216695539962293_n.png.png", "id": "969012482616177", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620875_969012485949510_3116027969992246549_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5H7q_-iSMPcQ7kNvwEbEuug&_nc_oc=AdqtKANf08hASbGi0wRzlpxhkFjstVpEWagcHK2Fb8AZdy7KB-FrVWYZ9jV68MGtJ5w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzoCL4uMO_UQnk-r6UGlhMZqp0NgF7cvK-jCZRSkhm9g&oe=6A8C3ED6"}, {"file_name": "499303788_1366073771832760_5313906244418783241_n (1) (1).png", "id": "1316767989696558", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499311582_1316767993029891_4705637181230336969_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BJ7kMdQE_X8Q7kNvwFMcnmO&_nc_oc=Adqkwvej3x3L0DsRwCTFw4EZ4R3mHljTLssENUQNCyiC3QkpyQ4F65sEAhUa_dtrynA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFsjJ8aMiWtI5gGKdgG2Xb60ixFWqMo7V08MiEcfplqBA&oe=6A8C475A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491818860_908783172106325_4029656652719763094_n.png.png", "id": "1025157330261039", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499299772_1025157333594372_241466352877841963_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EVvkrZA2lNUQ7kNvwFk88A2&_nc_oc=AdrcCwdYFuDvrdqfwf0gl1bteEYjlqaAauvvf8uQ50QJqO8drImhBDHVMcS7mAxJ7EE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJlNTIZaPH4kkCmMzCwBjc0mPiZJ0sh_3syqaVUsGL1g&oe=6A8C45DE"}, "display_name": "Gorilla Game", "keywords": ["tag", "social", "multiplayer", "sandbox", "gorilla"], "long_description": "# Ready to go full monke?\n\n**Gorilla Game** is a free multiplayer VR movement game built around the simple, chaotic fun that made old-school VR so special.\n\nNo overcomplicated stuff, just climb, swing, fling, juke, tag, and laugh with friends in fast social lobbies.\n\n# Play your way\n\n**Sandbox** - mess around, practice movement, and build your own fun\n\n**Infection** - classic run-and-tag survival chaos\n\n**Zone Ball** - a gravity-filled team mode where players fight to score\n\n**Fireball** - blast other monkes in fast PvP chaos\n\n**Challenges** - push your parkour skills to the limit\n\n**Custom Maps** - explore player-made worlds or create your own\n\nJump into public lobbies, make a private room with friends, or build your own chaos.\n\n**Simple, Social, Nostalgic, And Ridiculously fun.**\n{1537559831290651}", "short_description": "A free multiplayer VR movement game where you climb, swing, juke, tag, and hang out with friends. Play chaotic 
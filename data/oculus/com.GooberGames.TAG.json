nc_ohc=eWOV9FfAkrgQ7kNvwHokFqp&_nc_oc=AdqyFgPYcVblc_nhZ6DpGAKOhLVFgx06ycxgUlUkkKfl_d6fO_hHnmhdLkz7PQuMb5E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0q5sWVuAebT8aYrkz1xvfSOIEwvwz4so7obx7XRnepg&oe=6ABBD562"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorilla Game", "keywords": ["competitive", "social"], "long_description": "Step back to VR's early chaos with Gorilla Game! Immerse yourself in the addictively fun world of monke. Master unique hand-based locomotion, pushing off surfaces and swinging through blocks to become the ultimate gorilla.\n\nThis isn't just a game; it's a social sensation. Jump into public lobbies or create private rooms with friends, reliving the hilarious, chaotic energy of early VR social gaming. The social aspect is central, whether you're juking pursuers, coordinating with your team, or just chilling in the virtual forest.\n\nTest your monke instincts across fun game modes:\n\n    1v1: Competitive chases.\n    Infection: Spread the fun (and fear!).\n    Capture the Flag: Team-based flag snatching.\n    Fireball Monke: PvP with fireballs.\n    Bomb Tag: A high-stakes game of hot potato.\n\nGorilla Game focuses on the authentic 2020 experience: low-poly charm, blocky layouts, and pure, unadulterated fun. No complex menus, no overwhelming cosmetics \u2013 just pure gorilla action!", "short_description": "Swing through the simple monke world, mastering walls and obstacles. Chase, juke, and hang out with friends in chaotic multiplayer lobbies across a variety of game modes!"}]}, "developer_name": "enmity", "developer_privacy_policy_url": "https://gjax600.wixsite.com/website/home", "developer_terms_of_service_url": null, "publisher_name": "Volcanic Studios", "support_website_url": null, "website_url": "https://gjax600.wixsite.com/website", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"
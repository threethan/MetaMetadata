ent-atl3-1.oculuscdn.com/v/t64.5771-25/499309014_1734196027465395_1982197695476506657_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FGeh2AHzFXAQ7kNvwG0bY9_&_nc_oc=AdpXDvmXueiX6pNbtBJWcjIGq8f8CTl3duHl9Y_m12Fc2iye1yK3oM4oLw7NstNw8ak&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMo_zq4W_2pGMytU5-9UypZw827bIfaqnEaw0X8FRxUw&oe=6A71E159"}, {"file_name": "Screenshot from 2025-06-02 17-27-08.png", "id": "1412443463541735", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618274_1412443466875068_3499837648805682238_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=maVulx2TAjUQ7kNvwH-gP-r&_nc_oc=Adqr6XqNTZp1DPIFylw5elg9G7-apmJJiLW2tDwAiQNnHP6q4Qo0s0R6t96Ut9C7kBY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFn9PuN38TFANWEwe8_g9Vg23nyHYzZlYspGKH9cuVjoQ&oe=6A720175"}, {"file_name": "Screenshot from 2025-06-02 17-22-05.png", "id": "1627075727996592", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499295542_1627075731329925_7916674432735920011_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N3WizdZUgeQQ7kNvwGC9HHc&_nc_oc=AdqG2o0Amrod9qAxmG0_y3LW17jquXIzwyyMttzB2Hc6ttmiKw6X61X7DPohxZaRAfs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGv8hSRLPlL9a5zNWUi6qga7J-Vn3EudbdBilAkeN893g&oe=6A71EA26"}, {"file_name": "Screenshot from 2025-06-02 17-19-05.png", "id": "1887012221840398", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499617729_1887012225173731_3802512596425516299_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=56pBnRmO7_UQ7kNvwHCYX3T&_nc_oc=AdoofVA1HLLALeB1gGqIkaGThTT8pvOX3DfoJJ_EKUAZe41MfRtdCicnrDNZuuoyK8o&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFXKKK6NV_MUFB_BUiLweq2k1bq9lpGerb0BaLSzJatQA&oe=6A71FB47"}, {"file_name": "Screenshot from 2025-06-02 17-08.png", "id": "917121640539373", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618491_917121643872706_4249042767730245868_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zk3qY54BOf4Q7kNvwHxuVUF&_nc_oc=AdqLiYmzSIIbC-4LpD4y_2C3Je_iD-NugdGtTmXJNG6GgG5V56CMzHOjnQ0ZMzKEXNM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHwnOj01rAbX3dtPx84BPlF6AICOmZQOpD6UK3UsWxdTA&oe=6A720162"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorilla Game", "keywords": ["competitive", "social"], "long_description": "Step back to VR's early chaos with Gorilla Game! Immerse yourself in the addictively fun world of monke. Master unique hand-based locomotion, pushing off surfaces and swinging through blocks to become the ultimate gorilla.\n\nThis isn't just a game; it's a social sensation. Jump into public lobbies or create private rooms with friends, reliving the hilarious, chaotic energy of early VR social gaming. The social aspect is central, whether you're juking pursuers, coordinating with your team, or just chilling in the virtual forest.\n\nTest your monke instincts across fun game modes:\n\n    1v1: Competitive chases.\n    Infection: Spread the fun (and fear!).\n    Capture the Flag: Team-based flag snatching.\n    Fireball Monke: PvP with fireballs.\n    Bomb Tag: A high-stakes game of hot potato.\n\nGorilla Game focuses on the authentic 2020 experience: low-poly charm, blocky layouts, and pure, unadulterated fun. No complex menus, no overwhelming cosmetics \u2013 just pure gorilla action!", "short_description": "Swing through the simple monke world, mastering walls and obstacles. Chase, juke, and hang out with friends in chaotic multiplayer lobbies across a variety of game modes!"}]}, "developer_name": "enmity", "developer_privacy_policy_url": "https://gjax600.wixsite.com/website/home", "developer_terms_of_service_url": null, "publisher_name": "Volcanic Studios", "support_website_url": null, "website_url": "https://gjax600.wixsite.com/website", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topic
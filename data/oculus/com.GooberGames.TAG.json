ent-ord5-1.oculuscdn.com/v/t64.5771-25/499309014_1734196027465395_1982197695476506657_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v-PUWhws37gQ7kNvwHe6HjZ&_nc_oc=AdpA7Gju5pGRbHc43zD8IGN72ueEiY-B9fsvaLyUGP0OrrxJGieVwe6A3Dvwc8KbHiQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_VAcQNURyA4XUoufdHUi-J3gJfmSt0mWN7sAuKYrp9A&oe=6A5F6C59"}, {"file_name": "Screenshot from 2025-06-02 17-27-08.png", "id": "1412443463541735", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618274_1412443466875068_3499837648805682238_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lqvojdj3isYQ7kNvwHsJZgU&_nc_oc=Adqn9nwuuiusfatoRDAB53KZRPdWVI17Y4ZuSyrtXH5_Yt3Aq1s27FW3X9qRmRR2FbU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQfH8a1HKI6_PUVMFiORvNPnRDTp3vcXRTM0YEjajdoA&oe=6A5F5435"}, {"file_name": "Screenshot from 2025-06-02 17-22-05.png", "id": "1627075727996592", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499295542_1627075731329925_7916674432735920011_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=juMus2_HW28Q7kNvwHEUxSG&_nc_oc=AdpHWdQK9TRTXmM8XronFZErPqFnxRni20r71aVsq8lkuNAzNmShSrlQSDSqSuqX5HA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBEXMyEYBjo-nF_QBFdIrxY4cl9T1blsUE76C2S8ySCHA&oe=6A5F7526"}, {"file_name": "Screenshot from 2025-06-02 17-19-05.png", "id": "1887012221840398", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617729_1887012225173731_3802512596425516299_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j9F6vkx2DbEQ7kNvwGSjrMM&_nc_oc=AdrH5wFai6TgKY522fMBvs8JD9BDDlr0Gf5TnKXZFMbXW-6sdzRWqN5hiBS88cEXVrY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAio8cptM5jZ5GxPJP29eL4dT83fpcipyqQKLtI3XiK1Q&oe=6A5F8647"}, {"file_name": "Screenshot from 2025-06-02 17-08.png", "id": "917121640539373", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618491_917121643872706_4249042767730245868_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iH_ZldhRsZcQ7kNvwHyXPSk&_nc_oc=AdpF-qaDURNCa7GscFBwkEoZWEDzu6OqOz8hrWZHBv3-9eseM6RbGvnBYQe0oX0qHoY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAdXGBIzJsL4RhMTIY8-nrG5FimmhwDTV0z1N9GCLyEMQ&oe=6A5F5422"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorilla Game", "keywords": ["competitive", "social"], "long_description": "Step back to VR's early chaos with Gorilla Game! Immerse yourself in the addictively fun world of monke. Master unique hand-based locomotion, pushing off surfaces and swinging through blocks to become the ultimate gorilla.\n\nThis isn't just a game; it's a social sensation. Jump into public lobbies or create private rooms with friends, reliving the hilarious, chaotic energy of early VR social gaming. The social aspect is central, whether you're juking pursuers, coordinating with your team, or just chilling in the virtual forest.\n\nTest your monke instincts across fun game modes:\n\n    1v1: Competitive chases.\n    Infection: Spread the fun (and fear!).\n    Capture the Flag: Team-based flag snatching.\n    Fireball Monke: PvP with fireballs.\n    Bomb Tag: A high-stakes game of hot potato.\n\nGorilla Game focuses on the authentic 2020 experience: low-poly charm, blocky layouts, and pure, unadulterated fun. No complex menus, no overwhelming cosmetics \u2013 just pure gorilla action!", "short_description": "Swing through the simple monke world, mastering walls and obstacles. Chase, juke, and hang out with friends in chaotic multiplayer lobbies across a variety of game modes!"}]}, "developer_name": "enmity", "developer_privacy_policy_url": "https://gjax600.wixsite.com/website/home", "developer_terms_of_service_url": null, "publisher_name": "Volcanic Studios", "support_website_url": null, "website_url": "https://gjax600.wixsite.com/website", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topic
ps://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499300541_723828930046281_538832125416999599_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5DR_W-VwNIgQ7kNvwEWx_VP&_nc_oc=Adrfq5dz5HOPpi35hDaYThUsMr1QFM-dvFZLBC7FpvnR62IgblX4QuHI5p1dXxeQ1sg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmCR_DdJFXCtGSR_yQKIP5MW1H1gtjqS3588PLhsId0Q&oe=6A510057"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491818860_908783172106325_4029656652719763094_n-2.png", "id": "2262122437861426", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499623295_2262122441194759_7219074938641117356_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mUXeB5hG1AsQ7kNvwGrZsdV&_nc_oc=AdoUCZFsOcTEqdn4dDP8TdFT8_XOmM6piA9pNubUv9pAm0vCkeVTwnw62c8nEknRsYY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTMoDyzCFqxg2tE2zZILPHreAPsY_pNyq7dNnv-Xgptg&oe=6A5109D7"}, "display_name": "Gorilla Game", "keywords": ["tag", "social", "multiplayer", "monkey", "competitive"], "long_description": "# Ready to go full monke?\n\n**Gorilla Game** is a free multiplayer VR movement game built around the simple, chaotic fun that made old-school VR so special.\n\nNo overcomplicated stuff, just climb, swing, fling, juke, tag, and laugh with friends in fast social lobbies.\n\n# Play your way\n\n**Sandbox** - mess around, practice movement, and build your own fun\n\n**Infection** - classic run-and-tag survival chaos\n\n**Zone Ball** - a gravity-filled team mode where players fight to score\n\n**Fireball** - blast other monkes in fast PvP chaos\n\n**Challenges** - push your parkour skills to the limit\n\n**Custom Maps** - explore player-made worlds or create your own\n\nJump into public lobbies, make a private room with friends, or build your own chaos.\n\n**Simple, Social, Nostalgic, And Ridiculously fun.**\n{1537559831290651}", "short_description": "A free multiplayer VR movement game where you climb, swing, juke, tag, and hang out with friends. Play chaotic modes like Sandbox, Infection, Zone Ball, Fireball, Challenges, and Custom Maps."}]}, "developer_name": "enmity", "developer_privacy_policy_url": "https://gjax600.wixsite.com/website/home", "developer_terms_of_service_url": null, "publisher_name": "Volcanic Studios", "support_website_url": null, "website_url": "https://gjax600.wixsite.com/website", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP", "SINGLE_USER"], "id": "27589437774017169"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499303424_3767315660233368_5527659897675486330_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s_XLUHeYPdMQ7kNvwEq3368&_nc_oc=AdrUD3aQRVXPHEKcT9YCP3NlhKeQZkHDwIjG05IBqiiJS7JA1Ya3o0ThoqAe2fHpfmQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAcUWVXLoVixr3dzqAxsVNVlXZlSMfnDGzSZqXermPCvg&oe=6A511130"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Gorilla Game", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Platformer", "id": "528142316460358"}, {"topic_name": "Action", "id": "459781504968480"}], "release_date": 1749050160, "lastRevision": {"nodes": [{"id": "23971701272457522", "release_type": "SCHEDULED", "administratio
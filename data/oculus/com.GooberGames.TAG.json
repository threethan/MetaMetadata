ent-ord5-1.oculuscdn.com/v/t64.5771-25/499309014_1734196027465395_1982197695476506657_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4U2jvBRCdk4Q7kNvwGZdl3_&_nc_oc=AdomxAESVfVXf_rmnDe9Q89-qsnxxDP_nMswe0Ybhzi7uwBrySRf1OhW890Rcn41hUc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQATWqSRUy3-ZVXMad1N4ICpDn6r6LozN5s01vxdDGBhrw&oe=6A6360D9"}, {"file_name": "Screenshot from 2025-06-02 17-27-08.png", "id": "1412443463541735", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618274_1412443466875068_3499837648805682238_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Tzu-fn-B_EQ7kNvwECjzii&_nc_oc=Adogf0sh8I4ICrFtWFeV_Nwsk2JsGpMFpNMJoWgyizMjmtATH3ok6DGvQDuEwjeqVsc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDdLgRAmUybvABlAnSAOZDb5Fe_otvlL9xZh_1-3CO9aw&oe=6A6380F5"}, {"file_name": "Screenshot from 2025-06-02 17-22-05.png", "id": "1627075727996592", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499295542_1627075731329925_7916674432735920011_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8OA_0GktzXEQ7kNvwH7Vgux&_nc_oc=AdrsODziy-0prSWYB2AlQH3JUqh-_nmaphT7tSISqgHbTzV02-xlKRaUn_bTp9ndEBM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCz5hX_RjrghpFIF9b_0x8dAW5KWQyZSiJOiHgV1V1KXw&oe=6A6369A6"}, {"file_name": "Screenshot from 2025-06-02 17-19-05.png", "id": "1887012221840398", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617729_1887012225173731_3802512596425516299_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kXsUX7RpIqEQ7kNvwEN-_X_&_nc_oc=Adpsjl74G7XBbWxeEpJ7Qa2tVatJuZqjMsmFc_syAuAlngyQddNwOx26AXBvPziclMc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDQpU5RsVD7n7Lx_0G3iV1fLm9Jarvygnm8FaU-URW5qQ&oe=6A637AC7"}, {"file_name": "Screenshot from 2025-06-02 17-08.png", "id": "917121640539373", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618491_917121643872706_4249042767730245868_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xxRcBSpfbFsQ7kNvwENbpzI&_nc_oc=AdrE5GeSbF5LJ8N_xVemFJdcH8YunfV6kxch7_u-h0_Wb4ckOjtK_b_KUCorb20lHto&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCRHjkgnXuPt2j-5kHBWMN_582e2URPtQreqvXGhoY0fA&oe=6A6380E2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorilla Game", "keywords": ["competitive", "social"], "long_description": "Step back to VR's early chaos with Gorilla Game! Immerse yourself in the addictively fun world of monke. Master unique hand-based locomotion, pushing off surfaces and swinging through blocks to become the ultimate gorilla.\n\nThis isn't just a game; it's a social sensation. Jump into public lobbies or create private rooms with friends, reliving the hilarious, chaotic energy of early VR social gaming. The social aspect is central, whether you're juking pursuers, coordinating with your team, or just chilling in the virtual forest.\n\nTest your monke instincts across fun game modes:\n\n    1v1: Competitive chases.\n    Infection: Spread the fun (and fear!).\n    Capture the Flag: Team-based flag snatching.\n    Fireball Monke: PvP with fireballs.\n    Bomb Tag: A high-stakes game of hot potato.\n\nGorilla Game focuses on the authentic 2020 experience: low-poly charm, blocky layouts, and pure, unadulterated fun. No complex menus, no overwhelming cosmetics \u2013 just pure gorilla action!", "short_description": "Swing through the simple monke world, mastering walls and obstacles. Chase, juke, and hang out with friends in chaotic multiplayer lobbies across a variety of game modes!"}]}, "developer_name": "enmity", "developer_privacy_policy_url": "https://gjax600.wixsite.com/website/home", "developer_terms_of_service_url": null, "publisher_name": "Volcanic Studios", "support_website_url": null, "website_url": "https://gjax600.wixsite.com/website", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topic
t-sea1-1.oculuscdn.com/v/t64.5771-25/499309014_1734196027465395_1982197695476506657_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zKHZA938X2YQ7kNvwE2mNLZ&_nc_oc=AdoqfI-QfcRTPowUv_y5fmlwXHunbaslli20r5UKLhWmmUpuxTcAVxW1OUziqJVxa7Y&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-iud85ONnkL7JdCj1l2wWQQ3v0GgUhI5KO2zv8oCarg&oe=6A54E059"}, {"file_name": "Screenshot from 2025-06-02 17-27-08.png", "id": "1412443463541735", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618274_1412443466875068_3499837648805682238_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_0jj03PYR5UQ7kNvwEPbGHe&_nc_oc=Adq-nW0cbrJAjV9FP-qVcrlRhMfMf7--w3iB-_U02dSOXQ7VafLWJ4GbpsSkDU2vIJw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQClhp17kgARAHK5Bfk_LZdFsUdE0vsk7FTEea8OtU57lg&oe=6A550075"}, {"file_name": "Screenshot from 2025-06-02 17-22-05.png", "id": "1627075727996592", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499295542_1627075731329925_7916674432735920011_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OnaVIn8RQ8wQ7kNvwEogceM&_nc_oc=AdoE1bFhN-M0XVhTgluz9V-WODE9aq8hgr7Gps3PZ729-MZG2Fg78jy_TKH-08TKQKk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCtEKKOJCIvjHXKgUo4bxzcWDO2DbGngSyfkXJL0qWn0w&oe=6A54E926"}, {"file_name": "Screenshot from 2025-06-02 17-19-05.png", "id": "1887012221840398", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499617729_1887012225173731_3802512596425516299_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vGC8SdEw77oQ7kNvwG3eAzK&_nc_oc=AdpdwPDkR8WeRF6qjTF6IegeY7vW4BAnTDxKq2P_Y8XNtUnyY1Syb8ZS1UENe3Ibn80&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQARA0tI9P7Y-j4JWhhoX1odX_Kfwp8DKZp20EGN8n-KIw&oe=6A54FA47"}, {"file_name": "Screenshot from 2025-06-02 17-08.png", "id": "917121640539373", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499618491_917121643872706_4249042767730245868_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L3Tr23Oql4kQ7kNvwFF9Zo8&_nc_oc=Adq28NdtlNOz3YnDIJQ-7cwDcbG-qkwQlywocoF8DGm_eEBa6shqHBNEXFUrfGuYCW4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBCyYwR1OfU9Baw75VKaf0TbmVRphkBxkbdw5tEEAuMpA&oe=6A550062"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorilla Game", "keywords": ["competitive", "social"], "long_description": "Step back to VR's early chaos with Gorilla Game! Immerse yourself in the addictively fun world of monke. Master unique hand-based locomotion, pushing off surfaces and swinging through blocks to become the ultimate gorilla.\n\nThis isn't just a game; it's a social sensation. Jump into public lobbies or create private rooms with friends, reliving the hilarious, chaotic energy of early VR social gaming. The social aspect is central, whether you're juking pursuers, coordinating with your team, or just chilling in the virtual forest.\n\nTest your monke instincts across fun game modes:\n\n    1v1: Competitive chases.\n    Infection: Spread the fun (and fear!).\n    Capture the Flag: Team-based flag snatching.\n    Fireball Monke: PvP with fireballs.\n    Bomb Tag: A high-stakes game of hot potato.\n\nGorilla Game focuses on the authentic 2020 experience: low-poly charm, blocky layouts, and pure, unadulterated fun. No complex menus, no overwhelming cosmetics \u2013 just pure gorilla action!", "short_description": "Swing through the simple monke world, mastering walls and obstacles. Chase, juke, and hang out with friends in chaotic multiplayer lobbies across a variety of game modes!"}]}, "developer_name": "enmity", "developer_privacy_policy_url": "https://gjax600.wixsite.com/website/home", "developer_terms_of_service_url": null, "publisher_name": "Volcanic Studios", "support_website_url": null, "website_url": "https://gjax600.wixsite.com/website", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics"
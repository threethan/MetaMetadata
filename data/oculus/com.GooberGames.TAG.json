ent-sjc3-1.oculuscdn.com/v/t64.5771-25/499309014_1734196027465395_1982197695476506657_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ozdnZj3QYNcQ7kNvwGjdHr2&_nc_oc=AdqXgrtnsu_0JuY-7Vdo_DpZctGHynlTxijE68fEY0yWpvg-kx-6quJpeVacMTUuEC0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8Z94aRorml59NwgKEx7k9tVP8JUqOFOd3w1vjhwJ81Q&oe=6A5B77D9"}, {"file_name": "Screenshot from 2025-06-02 17-27-08.png", "id": "1412443463541735", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618274_1412443466875068_3499837648805682238_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ck4MSS9iZYQ7kNvwEI7oi2&_nc_oc=AdpX7ea6yc1f_s6y6RifFso5j8JZHzNGpAAwF5vs_TZ68m9A8yYPc8OZSyfOqkO3-Es&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBoYoZv7cyILstrCK09fMeWmDW1K5M2OYmB_uDRjzkNkw&oe=6A5B5FB5"}, {"file_name": "Screenshot from 2025-06-02 17-22-05.png", "id": "1627075727996592", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499295542_1627075731329925_7916674432735920011_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XO5apP64RLwQ7kNvwFiEnuY&_nc_oc=AdoDB0tvAXubr9sO-wWRW-sz02r12Rpo41uS3jcJGA2aZdGfn7LUgJ3qsANvlynQB98&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbmc5gfECoOKntag3hUBacsCyHWP-P-fee1ZavKkwRZQ&oe=6A5B80A6"}, {"file_name": "Screenshot from 2025-06-02 17-19-05.png", "id": "1887012221840398", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617729_1887012225173731_3802512596425516299_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3i7lc1w2xiIQ7kNvwGCEiif&_nc_oc=Ado8_H-XmdQHLp5hjpgKtVGYR1s6dkfpxmN1PbNuZVnSaFbeFA41kpaT4SdE6iOv8T4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQ35EJ9I4PEk-7ihYPGaXwMnCFeThLnxF2ihPLwSdCLQ&oe=6A5B91C7"}, {"file_name": "Screenshot from 2025-06-02 17-08.png", "id": "917121640539373", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618491_917121643872706_4249042767730245868_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3wuOT6MH70Q7kNvwGAhvil&_nc_oc=AdrQ4CZnCtHDVzFmyrvF4qg6yOn9M1umi2nVOhepdradpNupLlmAqftrBte2LNJeM2o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDUIeDpjR500b56pHzqlcHoCTd77RWKlZwwSB2SjElB3g&oe=6A5B5FA2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorilla Game", "keywords": ["competitive", "social"], "long_description": "Step back to VR's early chaos with Gorilla Game! Immerse yourself in the addictively fun world of monke. Master unique hand-based locomotion, pushing off surfaces and swinging through blocks to become the ultimate gorilla.\n\nThis isn't just a game; it's a social sensation. Jump into public lobbies or create private rooms with friends, reliving the hilarious, chaotic energy of early VR social gaming. The social aspect is central, whether you're juking pursuers, coordinating with your team, or just chilling in the virtual forest.\n\nTest your monke instincts across fun game modes:\n\n    1v1: Competitive chases.\n    Infection: Spread the fun (and fear!).\n    Capture the Flag: Team-based flag snatching.\n    Fireball Monke: PvP with fireballs.\n    Bomb Tag: A high-stakes game of hot potato.\n\nGorilla Game focuses on the authentic 2020 experience: low-poly charm, blocky layouts, and pure, unadulterated fun. No complex menus, no overwhelming cosmetics \u2013 just pure gorilla action!", "short_description": "Swing through the simple monke world, mastering walls and obstacles. Chase, juke, and hang out with friends in chaotic multiplayer lobbies across a variety of game modes!"}]}, "developer_name": "enmity", "developer_privacy_policy_url": "https://gjax600.wixsite.com/website/home", "developer_terms_of_service_url": null, "publisher_name": "Volcanic Studios", "support_website_url": null, "website_url": "https://gjax600.wixsite.com/website", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topic
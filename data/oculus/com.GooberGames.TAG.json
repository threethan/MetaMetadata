6_4731662983728359_4959210717928190708_n.png.png", "id": "1189904976584983", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619808_1189904979918316_8270575859881585029_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2WY1PDBiEVYQ7kNvwFBk_pq&_nc_oc=Adrb2USvEIM6zN4O3k_eAIBlW9r_H-UXo0FLirHw5F6G-7yY8P2pZpGKhGJNS_aYXx8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_BWOxTX7m1mABRV5s9UYrJhJvMr-8yRqLZQ8FhH5IxQ&oe=6AB290D8"}, {"file_name": "499623601_1322290942777998_6840678979716743435_n.png.png", "id": "2897132763969857", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619805_2897132767303190_2666423328393576972_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yGAOSqKN_DkQ7kNvwHGnCDi&_nc_oc=Adpou5iLL6CKuAUtuTWWKbLCradgHLq1Zclqm6o6NoL7wf0qWMBs7oQXjPTW2KF66ig&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbJ9PAecT7bwJxcWw3GzsdJ1mqPJDLF2Hce-QIQL7D2w&oe=6AB298DB"}, {"file_name": "Screenshot 2026-07-28 at 10.29.18\u202fPM.png", "id": "1061924336523658", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499314657_1061924339856991_4036130126838360720_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YVTsF8dIssgQ7kNvwF25Wc6&_nc_oc=AdpoQ77tIZI7Vbz0ACdWoATICazUVONxp5cyosuNgQnFwF5LAoFb3Frb6FzKISEu9yM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJsvMdUOWWlhNf6s8oFGquxLJPOI6IsMxN25bjXBOtepA&oe=6AB298E5"}, {"file_name": "499622315_1515658520095783_7377216695539962293_n.png.png", "id": "969012482616177", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620875_969012485949510_3116027969992246549_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J0JF3ZKksRoQ7kNvwHQF9Y4&_nc_oc=AdrPJWbButBKuhFFlpzI3pWxhbZzmE5bo-77fXk8Y-_EoSTdxYNP6A4WzC_P3iPCkYQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLz-BvTqeZcrLX6h-OhLCpgvdzvUXWukf6NjvmOgFB9YQ&oe=6AB27A56"}, {"file_name": "499303788_1366073771832760_5313906244418783241_n (1) (1).png", "id": "1316767989696558", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499311582_1316767993029891_4705637181230336969_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-X_hTlKHONcQ7kNvwG-3G_3&_nc_oc=AdqhxPk4kP_FYNtERNG1j9p_1VjqLMfsHc8nMRoSbefnKRpl1uGnR-UPYJ2oQrSTQ68&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIcLa08IQFLCkemiRfOODOpK5m3NXqIvEaf6PwUSr9_1w&oe=6AB282DA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491818860_908783172106325_4029656652719763094_n.png.png", "id": "1025157330261039", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499299772_1025157333594372_241466352877841963_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FrPpMAaMm38Q7kNvwH8cZx5&_nc_oc=AdosxgHLG0O-PTCGOw_66wTupBKuZC3yCEoHOd2D5YmVPxb5cNt3T9LehAYJEYXIMSE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFbfp_LYXMzqngh0wI4kpNhB9MvcIEAygPnPg36dI6Ew&oe=6AB2815E"}, "display_name": "Gorilla Game", "keywords": ["tag", "social", "multiplayer", "sandbox", "gorilla"], "long_description": "# Ready to go full monke?\n\n**Gorilla Game** is a free multiplayer VR movement game built around the simple, chaotic fun that made old-school VR so special.\n\nNo overcomplicated stuff, just climb, swing, fling, juke, tag, and laugh with friends in fast social lobbies.\n\n# Play your way\n\n**Sandbox** - mess around, practice movement, and build your own fun\n\n**Infection** - classic run-and-tag survival chaos\n\n**Zone Ball** - a gravity-filled team mode where players fight to score\n\n**Fireball** - blast other monkes in fast PvP chaos\n\n**Challenges** - push your parkour skills to the limit\n\n**Custom Maps** - explore player-made worlds or create your own\n\nJump into public lobbies, make a private room with friends, or build your own chaos.\n\n**Simple, Social, Nostalgic, And Ridiculously fun.**\n{1537559831290651}", "short_description": "A free multiplayer VR movement game where you climb, swing, juke, tag, and hang out with friends. Play chaotic 
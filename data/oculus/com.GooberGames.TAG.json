17-19-05.png", "id": "1887012221840398", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617729_1887012225173731_3802512596425516299_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-72itWi1j94Q7kNvwFsN0QV&_nc_oc=AdoOCKg7-Rqw96vVc5cE0H5-VSXoE1EGkjXYD-RfgVnNW6w9aOUf2KEwcVcNJ49DFSI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfKAN8HX0as5QR3G1EkvRJeWiDJ05TDd0ahvQcs1AqEg&oe=6B048A07"}, {"file_name": "Screenshot from 2025-06-02 17-08.png", "id": "917121640539373", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618491_917121643872706_4249042767730245868_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z9uiGnNIgukQ7kNvwGHTXMW&_nc_oc=AdpN98C5elUADKHhAXEmV4Igvf9x4gmj4r3fB9ose5gWgxWQVM3GKhOaX6WC7BB0AQU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpGbNIgxSLpbXH7Leqb2Mp1wKNgLQdMCO42ZCmzxc6bA&oe=6B0457E2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorilla Game", "keywords": ["competitive", "social"], "long_description": "Step back to VR's early chaos with Gorilla Game! Immerse yourself in the addictively fun world of monke. Master unique hand-based locomotion, pushing off surfaces and swinging through blocks to become the ultimate gorilla.\n\nThis isn't just a game; it's a social sensation. Jump into public lobbies or create private rooms with friends, reliving the hilarious, chaotic energy of early VR social gaming. The social aspect is central, whether you're juking pursuers, coordinating with your team, or just chilling in the virtual forest.\n\nTest your monke instincts across fun game modes:\n\n    1v1: Competitive chases.\n    Infection: Spread the fun (and fear!).\n    Capture the Flag: Team-based flag snatching.\n    Fireball Monke: PvP with fireballs.\n    Bomb Tag: A high-stakes game of hot potato.\n\nGorilla Game focuses on the authentic 2020 experience: low-poly charm, blocky layouts, and pure, unadulterated fun. No complex menus, no overwhelming cosmetics \u2013 just pure gorilla action!", "short_description": "Swing through the simple monke world, mastering walls and obstacles. Chase, juke, and hang out with friends in chaotic multiplayer lobbies across a variety of game modes!"}]}, "developer_name": "enmity", "developer_privacy_policy_url": "https://gjax600.wixsite.com/website/home", "developer_terms_of_service_url": null, "publisher_name": "Volcanic Studios", "support_website_url": null, "website_url": "https://gjax600.wixsite.com/website", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "23972900755670907"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1282504343350233"}]}, "baseline_offer": {"id": "1282504343350233"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1749050160, "status": "PUBLISHED", "id": "1282504343350233"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29312184675075795", "version": "4.28"}, "id": "1218091683445761", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "23971701229124193", "is_concept": false, 
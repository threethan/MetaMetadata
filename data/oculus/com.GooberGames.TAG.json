ent-fra5-2.oculuscdn.com/v/t64.5771-25/499309014_1734196027465395_1982197695476506657_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zKHZA938X2YQ7kNvwGgk-Tm&_nc_oc=Adq7VcyqhGwm6Xnxnx6hnlyRs6_0PnL4eq9eQzOg_sUo2pAXKnWLdYUMhOcZCstEZAA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmB-OMrJdeJ6h5gMooJTtHu0GvogIiFEiEo-DGeFaZUA&oe=6A5631D9"}, {"file_name": "Screenshot from 2025-06-02 17-27-08.png", "id": "1412443463541735", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499618274_1412443466875068_3499837648805682238_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_0jj03PYR5UQ7kNvwFFcOU5&_nc_oc=AdooqwYT3MamnIO0srvQU-e3QVWnWU18vM2cjqnmHfqOHbfD2-Ye2w-la_crs22DzeQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBxIGInZTLSQ_R34-aYxYG3OUINfRJQo60NM5GYYokZRQ&oe=6A5651F5"}, {"file_name": "Screenshot from 2025-06-02 17-22-05.png", "id": "1627075727996592", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499295542_1627075731329925_7916674432735920011_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OnaVIn8RQ8wQ7kNvwHhB_i5&_nc_oc=Ado8HWNJLxELFw7Qakp8Ek2K0yOPvVWoAgTuPabzHJzhcRM5qvDgBtz4S0JvtF-MZ44&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-1pyyDvFMmjdE8rHTC7vaE2luXkgkT5IHRxN4w723Xw&oe=6A563AA6"}, {"file_name": "Screenshot from 2025-06-02 17-19-05.png", "id": "1887012221840398", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499617729_1887012225173731_3802512596425516299_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sOPxxjJs6RgQ7kNvwF4kE59&_nc_oc=AdqlCgZ7PKPakUrzCW_L5XJizNCaae4UdBGTdb4T6T4I8b8-4UeD5n_VwgSEuHWeDCg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXNVUF-dNP1ZE6-3a_oSso7yyks2otY9EA75ZzvBW4qA&oe=6A564BC7"}, {"file_name": "Screenshot from 2025-06-02 17-08.png", "id": "917121640539373", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499618491_917121643872706_4249042767730245868_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L3Tr23Oql4kQ7kNvwEtshWK&_nc_oc=Adp4KAZn5QhtJu0fdeph363ZZlZGaQMU7dzwPZ9d_Kkf7RPJms-L6zMzaP9jjOwbcBY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAab-Hz7twD29H-XnZUfqhz5WeihSNyh4TH4aP043zV6w&oe=6A5651E2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorilla Game", "keywords": ["competitive", "social"], "long_description": "Step back to VR's early chaos with Gorilla Game! Immerse yourself in the addictively fun world of monke. Master unique hand-based locomotion, pushing off surfaces and swinging through blocks to become the ultimate gorilla.\n\nThis isn't just a game; it's a social sensation. Jump into public lobbies or create private rooms with friends, reliving the hilarious, chaotic energy of early VR social gaming. The social aspect is central, whether you're juking pursuers, coordinating with your team, or just chilling in the virtual forest.\n\nTest your monke instincts across fun game modes:\n\n    1v1: Competitive chases.\n    Infection: Spread the fun (and fear!).\n    Capture the Flag: Team-based flag snatching.\n    Fireball Monke: PvP with fireballs.\n    Bomb Tag: A high-stakes game of hot potato.\n\nGorilla Game focuses on the authentic 2020 experience: low-poly charm, blocky layouts, and pure, unadulterated fun. No complex menus, no overwhelming cosmetics \u2013 just pure gorilla action!", "short_description": "Swing through the simple monke world, mastering walls and obstacles. Chase, juke, and hang out with friends in chaotic multiplayer lobbies across a variety of game modes!"}]}, "developer_name": "enmity", "developer_privacy_policy_url": "https://gjax600.wixsite.com/website/home", "developer_terms_of_service_url": null, "publisher_name": "Volcanic Studios", "support_website_url": null, "website_url": "https://gjax600.wixsite.com/website", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topic
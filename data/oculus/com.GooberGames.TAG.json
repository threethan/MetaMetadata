T&_nc_oc=Adrgp3zAXaWwqPtzaP_XOZ44gexH1rGTFyFFqsum1psVbYvv59u7ywPTlo7YzGfqHVg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyOUqxxeAE_U0Kqp2enYkfTiT9iiVVMvbjZ0i3UMKEhQ&oe=6B09B596"}, {"file_name": "499303788_1366073771832760_5313906244418783241_n (1) (1).png", "id": "1316767989696558", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499311582_1316767993029891_4705637181230336969_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MeNSz_teqRYQ7kNvwHtIkQS&_nc_oc=Ado39L5x7cc8NIcSpPz1kpjxAvMxEfKgxoI3qWIaudYHT2MsBTxySYSsy16j67vWh6M&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTf9rYY1x9zXLqM6NKXUxqQQVoANoWsXJdO44By09i2Lw&oe=6B09BE1A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491818860_908783172106325_4029656652719763094_n.png.png", "id": "1025157330261039", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499299772_1025157333594372_241466352877841963_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J3GSHdyZR3AQ7kNvwEjAcTH&_nc_oc=Ado6UOe3ePMOhYH-cvFiEC1V-blpBgyZee5tm425SvmzzA1SCn5i9caJmv97tp0DcjQ&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRknQaONo4o9ZImr8oZJAJkJH7MvQJaziMC0gHpK60wHw&oe=6B09BC9E"}, "display_name": "Gorilla Game", "keywords": ["tag", "social", "multiplayer", "sandbox", "gorilla"], "long_description": "# Ready to go full monke?\n\n**Gorilla Game** is a free multiplayer VR movement game built around the simple, chaotic fun that made old-school VR so special.\n\nNo overcomplicated stuff, just climb, swing, fling, juke, tag, and laugh with friends in fast social lobbies.\n\n# Play your way\n\n**Sandbox** - mess around, practice movement, and build your own fun\n\n**Infection** - classic run-and-tag survival chaos\n\n**Zone Ball** - a gravity-filled team mode where players fight to score\n\n**Fireball** - blast other monkes in fast PvP chaos\n\n**Challenges** - push your parkour skills to the limit\n\n**Custom Maps** - explore player-made worlds or create your own\n\nJump into public lobbies, make a private room with friends, or build your own chaos.\n\n**Simple, Social, Nostalgic, And Ridiculously fun.**\n{1537559831290651}", "short_description": "A free multiplayer VR movement game where you climb, swing, juke, tag, and hang out with friends. Play chaotic modes like Sandbox, Infection, Zone Ball, Fireball, Challenges, and Custom Maps."}]}, "developer_name": "enmity", "developer_privacy_policy_url": "https://gorillagamevr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Volcanic Studios", "support_website_url": null, "website_url": "https://gorillagamevr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "29312793238348272"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/585799753_1601760824840374_8339942753842831836_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ffJlBz0s2AQ7kNvwHo3ISD&_nc_oc=Adq_GymqlofhShd0T5FIYhle_DgJuVpzySbjMnMhyPy6NOcfYlDxLm1A94rIzvgFXXM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_1-N84AUAtny-tYcN0KZ9SpH8B-G56lHUVoVur95QEA&oe=6B099A16"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "
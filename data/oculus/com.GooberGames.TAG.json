1-25/499311582_1316767993029891_4705637181230336969_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F2gEJr0m6RoQ7kNvwGeavXk&_nc_oc=AdpxX_imYfkt0jaUAHP_fF6BoAo3p15Znqr1Sb99IMvH0UY3Yb3PYUVdUuPKb7Uuvqg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQODOTVpJBw7WtUXTaVKWN0dfBn_mJDsLofCcdAj0G60aQ&oe=6ADCB2DA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image-1790724177371.png", "id": "1978712076154575", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499299772_1978712079487908_7788230909590140916_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VHo7iZpGsMgQ7kNvwESH75F&_nc_oc=AdratY1oTE-VI_fLLSA-kx_Ag5-FynRM_b2zI-XZPRHrVqYsMjYwPCegZSD1G-5dppY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMBNOBOyW_CtBRDeKg8tXmtms-WZhXOntqyAmSScQNz2w&oe=6ADCBC77"}, "display_name": "Gorilla Game", "keywords": ["tag", "social", "multiplayer", "sandbox", "gorilla"], "long_description": "# Ready to go full monke?\n\n**Gorilla Game** is a FREE multiplayer VR movement game with frequent updates.  Built around the simple, chaotic fun that made old-school VR so special.\n\nNothing overcomplicated. Just climb, swing, fling, juke, tag, and laugh with friends in fast social lobbies.\n\n# Play your way\n\n**Infection** - classic run-and-tag. Don't get caught, or you're the one chasing\n\n**Hunt** - track down your target while someone else hunts you. Get caught and come back as a ghost\n\n**Zone Ball** - a team game where you grab the ball, dodge the other team, and score\n\n**Custom Maps** - play worlds made by other players, or build your own right in the game\n\n**Challenges** - parkour courses that push your movement to the limit\n\n**Sandbox** - mess around, practice movement, and make your own fun\n\nJump into a public lobby, make a private room with friends, or build something wild together.\n\n**Simple, social, nostalgic, and ridiculously fun.**", "short_description": "A free multiplayer VR movement game where you climb, swing, juke, tag, and hang out with friends. Play chaotic modes like Sandbox, Infection, Zone Ball, Fireball, Challenges, and Custom Maps."}]}, "developer_name": "enmity", "developer_privacy_policy_url": "https://gorillagamevr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Volcanic Studios", "support_website_url": null, "website_url": "https://gorillagamevr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "28772043932423208"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499312439_1970748160552810_7136249976142691763_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=axUKN_tpnWkQ7kNvwEGdCvR&_nc_oc=Adq6NvJYmnYPg1ZxAOd9yE3NjtESFPDx-G0JflK63xARQ3DoXtqeFGHR13iV506yoEg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIrWmhJ--o08egRBsrOnwOW7QmPWnVciS2Ga-ZrchOOw&oe=6ADCCB3C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Gorilla Game", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Platformer", "id": "528142316460358"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Hangout", "id": "102377078572
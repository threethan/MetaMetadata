9622276_4731662983728359_4959210717928190708_n.png.png", "id": "1189904976584983", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499619808_1189904979918316_8270575859881585029_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=faMPLLXe6tYQ7kNvwHHQgzD&_nc_oc=AdppLiuHTiHyC2YzpGRe2jXA3PFdHh_cekrqoJCV-CehpdSTzxY0oXcceCfAOeIXrAY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_qgPLs5Y5_Ykyb25FJiNr28XnR3phVs5se8CCjhAuCw&oe=6A7D9C98"}, {"file_name": "499623601_1322290942777998_6840678979716743435_n.png.png", "id": "2897132763969857", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499619805_2897132767303190_2666423328393576972_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JKGnd7nN_EQQ7kNvwHR4x7G&_nc_oc=Adoj0xXF5p76VuBNhUAxL1gMaelRueGbRxdhCC4aYQfqKfgXLwYHs8yDqDSzGwlYnyM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHK1zlAbUmUU-RhuM0f9tPKNfbWPIAjAHKOkg2gufMdHA&oe=6A7DA49B"}, {"file_name": "Screenshot 2026-07-28 at 10.29.18\u202fPM.png", "id": "1061924336523658", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499314657_1061924339856991_4036130126838360720_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ERrcnKbkoNIQ7kNvwEMFbi-&_nc_oc=AdpYVQx-qPG3Qb0U0V6T0RyL9Njp96dlWpt4Qzc7m7OZBVt8yFGfUXlmiWUyRaTSB3Y&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgeKXZlJDUuDxXChP5X6LxeT75X-HtxUGyuB9-jvnneQ&oe=6A7DA4A5"}, {"file_name": "499622315_1515658520095783_7377216695539962293_n.png.png", "id": "969012482616177", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499620875_969012485949510_3116027969992246549_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WsWb5UElTSwQ7kNvwFJ3A1O&_nc_oc=Adq7xNnLWedRtDiFignftRfYSO6Bqsm1Aj-AU2Wftj9h4w2bwChBQ1elZ0LYVLv6v9s&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPZppfLc-VvgEKcDqB9o2vku_DLjxii3mfxLtfA9rfMA&oe=6A7DBE56"}, {"file_name": "499303788_1366073771832760_5313906244418783241_n (1) (1).png", "id": "1316767989696558", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499311582_1316767993029891_4705637181230336969_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y6IE8Ohot1IQ7kNvwFuSD2F&_nc_oc=AdpgEq5791vTSuWrp6CJNEOeOF7R2nEJostLoG_ijDmCA8D6I06v7xEktNLSRDfvf20&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHmylrU3i_7WXasQBs0-ZBCEjOKKXDi1nWglvrkrbICIQ&oe=6A7DC6DA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "491818860_908783172106325_4029656652719763094_n.png.png", "id": "1025157330261039", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499299772_1025157333594372_241466352877841963_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ufAQZtqbfogQ7kNvwGrewIg&_nc_oc=AdpOUcRNF3fqqgsr_MIxXqwVMuNkZSPGIlWHzTDF5aT8yoH7g8XygY_2aXN5pcWIZ_Q&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHyVPlnoj9FsWKPrFVtUa5TrlKBq1GbsEdllNGogSP-3g&oe=6A7DC55E"}, "display_name": "Gorilla Game", "keywords": ["tag", "social", "multiplayer", "sandbox", "gorilla"], "long_description": "# Ready to go full monke?\n\n**Gorilla Game** is a free multiplayer VR movement game built around the simple, chaotic fun that made old-school VR so special.\n\nNo overcomplicated stuff, just climb, swing, fling, juke, tag, and laugh with friends in fast social lobbies.\n\n# Play your way\n\n**Sandbox** - mess around, practice movement, and build your own fun\n\n**Infection** - classic run-and-tag survival chaos\n\n**Zone Ball** - a gravity-filled team mode where players fight to score\n\n**Fireball** - blast other monkes in fast PvP chaos\n\n**Challenges** - push your parkour skills to the limit\n\n**Custom Maps** - explore player-made worlds or create your own\n\nJump into public lobbies, make a private room with friends, or build your own chaos.\n\n**Simple, Social, Nostalgic, And Ridiculously fun.**\n{1537559831290651}", "short_description": "A free multiplayer VR movement game where you climb, swing, juke, tag, and hang out with friends. Play chaotic modes like Sandbox, Infection, Zone Ball, Fireball, Challenges, and Custom Maps."}]}, "developer_name": "enmity", "developer_privacy_policy_url": "https://gorillagamevr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Volcanic Studios", "support_website_url": null, "website_url": "https://gorillagamevr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "27956824957278447"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/585799753_1601760824840374_8339942753842831836_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rLWcV4nA_Q8Q7kNvwG7wuGn&_nc_oc=AdracqlOEDkA6p0Neih_1QSvWmWmq4mxPNV57XUGpmi3Ajfw_adHR-xGvVC8VzVIDLs&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGj4IhM5UI47btqqFg_QgNZQNXi6IkGWKCBE1Uzddft7Q&oe=6A7DA2D6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Gorilla Game", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1749050160, "lastRevision": {"nodes": [{"id": "23971701272457522", "release_type": "SCHEDULED", "admin
946_481274707902537_1683729006025844058_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PLIpXWbyBu4Q7kNvwE0IrIB&_nc_oc=AdpCNHw55dhbcBsn9wcXKNlSTk7dKHIr6xt7QhP0M3pFrB2Qi-tCGSb9iWgXXbyQML8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRm2XwsgKZ_0r2WyrEHgjFFLKPb2s4Hg6KE6rAKdMo1MQ&oe=6AFF173F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "file.png", "id": "3656800017907206", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982516_3656800021240539_5008511035473175295_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vbWJQWlVa5YQ7kNvwGX1KL_&_nc_oc=AdpjG71vs30OiynG0ySTI931lsiL5E5MxvuSnNpHxR-86omcXR_cPoMjkl5Y5W-Krqg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNRPnlHVqN0OqmAJKNAv2Q2RJjz5652Z07LhYLV-UQpQ&oe=6AFF09F4"}, "display_name": "Scary Descent", "keywords": [], "long_description": "As you descend deeper into the darkness, uncover the grim secrets of the company's past and confront the malevolent entities that still haunt its corridors. Time is of the essence, for every moment spent in the abyss brings you closer to an inevitable confrontation with unspeakable terror", "short_description": "WARNING: FLASHING LIGHTS AND INTENSE JUMPSCARES\n\nArmed only with your wits and a flickering flashlight, you'll navigate through eerie corridors, dimly lit offices, and long-forgotten research labs, each holding fragments of the company's dark history.\n\nDeveloper note ------- If anyone has a pico to test the pico apk it would be appreciated. This game is still under development Im open to feed-back ! trevorblyt"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/TrevorBlythe/ScaryDescentPrivacyPolicy/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "Trevor Blythe", "support_website_url": null, "website_url": "https://sidequestvr.com/app/34104/scary-descent", "category": null, "comfort_rating":
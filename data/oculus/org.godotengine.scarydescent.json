946_481274707902537_1683729006025844058_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ORXeV16zmsQ7kNvwGGcuNc&_nc_oc=Adp4Z-zrne1BKMDrCQW1twDI3f5BVglsDqCvkQ8ZqGLAiHaot5zjjR45JtADGJJ3fXQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQREPVDSW8FWlDj4Vr07xr0myjvH8JjkZjSy8PuUDwIxjA&oe=6B0DCFFF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "file.png", "id": "3656800017907206", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982516_3656800021240539_5008511035473175295_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FSBcynKmzc0Q7kNvwGSKEJZ&_nc_oc=AdpM_IU14Tchxeu0fDVR_dtYEHXxlBEmu2dlNBB1e8e-9I8Kgi70y2bdcGMBdUmOH8Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTYTyJ76L2ROB_aiTv0Ma-Yk1Grt4m8UrbUgMG61JQRhA&oe=6B0DC2B4"}, "display_name": "Scary Descent", "keywords": [], "long_description": "As you descend deeper into the darkness, uncover the grim secrets of the company's past and confront the malevolent entities that still haunt its corridors. Time is of the essence, for every moment spent in the abyss brings you closer to an inevitable confrontation with unspeakable terror", "short_description": "WARNING: FLASHING LIGHTS AND INTENSE JUMPSCARES\n\nArmed only with your wits and a flickering flashlight, you'll navigate through eerie corridors, dimly lit offices, and long-forgotten research labs, each holding fragments of the company's dark history.\n\nDeveloper note ------- If anyone has a pico to test the pico apk it would be appreciated. This game is still under development Im open to feed-back ! trevorblyt"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/TrevorBlythe/ScaryDescentPrivacyPolicy/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "Trevor Blythe", "support_website_url": null, "website_url": "https://sidequestvr.com/app/34104/scary-descent", "category": null, "comfort_rating":
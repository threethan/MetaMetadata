946_481274707902537_1683729006025844058_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3XGMwDyhfowQ7kNvwHdfNY3&_nc_oc=AdoMiP2cbTOEDH-5FyhyA1TozK1hvfknD3VIAHFeet1rxRNW_vgGMvpdaLeTSzK5tWs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9olypdchUsBCf1kPn1p4n_Syb8ECGgkPTOstSU9_QVA&oe=6AFDC5BF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "file.png", "id": "3656800017907206", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982516_3656800021240539_5008511035473175295_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vbWJQWlVa5YQ7kNvwGs7A0u&_nc_oc=Adob8J8JHKewwT-vK1zHUsHXOF0Y2PSkNsC7ioO-i5YSfvZ1e7eUg9ozuaGwW-Eja8I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTG5QQoY8F0IfTZ2gp0lVf5vIr4G8beW1uM46nyDgmD3g&oe=6AFDB874"}, "display_name": "Scary Descent", "keywords": [], "long_description": "As you descend deeper into the darkness, uncover the grim secrets of the company's past and confront the malevolent entities that still haunt its corridors. Time is of the essence, for every moment spent in the abyss brings you closer to an inevitable confrontation with unspeakable terror", "short_description": "WARNING: FLASHING LIGHTS AND INTENSE JUMPSCARES\n\nArmed only with your wits and a flickering flashlight, you'll navigate through eerie corridors, dimly lit offices, and long-forgotten research labs, each holding fragments of the company's dark history.\n\nDeveloper note ------- If anyone has a pico to test the pico apk it would be appreciated. This game is still under development Im open to feed-back ! trevorblyt"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/TrevorBlythe/ScaryDescentPrivacyPolicy/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "Trevor Blythe", "support_website_url": null, "website_url": "https://sidequestvr.com/app/34104/scary-descent", "category": null, "comfort_rating":
=6A46853F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "file.png", "id": "3656800017907206", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982516_3656800021240539_5008511035473175295_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iKu-9nkDLnAQ7kNvwH_0oBI&_nc_oc=AdrmSH-I_uDPaKSriVAgptDcScu2w51c97fMLiZteBFpM_I6hVMVO0sDq8EtZKLtC2s&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8a2fURTJQn61XGl3qLhtdT25ushap81Yb0Yq80stzSsg&oe=6A4677F4"}, "display_name": "Scary Descent", "keywords": [], "long_description": "As you descend deeper into the darkness, uncover the grim secrets of the company's past and confront the malevolent entities that still haunt its corridors. Time is of the essence, for every moment spent in the abyss brings you closer to an inevitable confrontation with unspeakable terror", "short_description": "WARNING: FLASHING LIGHTS AND INTENSE JUMPSCARES\n\nArmed only with your wits and a flickering flashlight, you'll navigate through eerie corridors, dimly lit offices, and long-forgotten research labs, each holding fragments of the company's dark history.\n\nDeveloper note ------- If anyone has a pico to test the pico apk it would be appreciated. This game is still under development Im open to feed-back ! trevorblyt"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/TrevorBlythe/ScaryDescentPrivacyPolicy/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "Trevor Blythe", "support_website_url": null, "website_url": "https://sidequestvr.com/app/34104/scary-descent", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb
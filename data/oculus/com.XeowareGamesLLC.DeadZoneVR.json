opics": [{"id": "644354873106712"}, {"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24499758919614717"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1260465329051812"}]}, "baseline_offer": {"id": "1260465329051812"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1746219600, "status": "PUBLISHED", "id": "1260465329051812"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24657030743887533", "version": "0.0.88"}, "id": "1524410378267251", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24484369457820330", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "24657030743887533"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1524410378267251"}]}, "change_log": "# DeadZone VR \ufffd  - v0.0.87\n\n**PATCH NOTES**\n\n** \ufffd SPAWN MENU \ufffd **\ntired of running out of ammo mid game? me to!\nnow you dont have to worry about that! spawn any amount of gun, and/or ammo you need to play!!\nWANRING!!! spam spawning will cause lag!! \n\n**\ufffd World At War \ufffd (Intro)**\nWorld At War is a new (in early works) game mode that puts you in real world maps from the past\nRight now, we only have one map, \"No Mans Land\"\nthe game mode may be buggy, but its still being worked on!\n \n**\ufffd Shooting Range\ufffd **\nSuck at aiming? (its ok i suck to lol)\ntest your aiming skills, and get better at shooting\nyou can also use the shooting range to test guns before you start the game!\n\n**\ufffd Slightly better Blood \ufffd **\nzombies now bleed normal red blood when shot and not green goop\nand as said for the shotgun, it turns zombies into bits\nblood/gore will change more later on :)\n\n**\ufffd PLAYGROUND MAP\ufffd **\nThe new playground map, it dont have much BUT its still pretty cool :)\n\n**OTHERS:**\n- Updated Credits\n- Added a dummy to spawn\n- Fixed Admin Gun\n- Removed joe", "created_date": 1747450366, "id": "24657030743887533", "version": "0.0.88", "version_code": 16, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24484369457820330", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "24657030743887533"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1747342470, "id": "24645722625018345", "version": "0.0.86", "version_code": 14, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24484369457820330", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "24657030743887533"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 174726
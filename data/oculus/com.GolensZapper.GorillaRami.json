wfH-xVe_o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU96ffcmC1f-uc8avPDLBucmLqVykMAZycVuqNb8D_3Sw&oe=6B10495F"}, {"file_name": "New Project (8).png", "id": "973166154428256", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393425_973166157761589_2137544379493982175_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Co-EPRVw-VwQ7kNvwElH-ZR&_nc_oc=AdpmQmhJj8pAMjo2gGfRPHnYZqHjYVcWhHcCa98l1Bjxp5fmIc3LnHxlWukNxy4WRBs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQURLlErSJxBn3J0MoYjJJuDBjxztgbs5ORmyvl18c833w&oe=6B103EE7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project (2).png", "id": "1032124405615852", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393444_1032124408949185_6584886606991333037_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gLplHqm7UP4Q7kNvwGTa76h&_nc_oc=AdpjdxOgEpIN7AmqOcLH8X9YddZp-W8mS_zqU5duih-cCe5zcs9XuoXVA7rg1_mFG40&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW25JnKjA1KeKi9pQWrFhESH_EVvVITs3uTHS2HxHM14w&oe=6B103E29"}, "display_name": "Gorilla Rami", "keywords": ["Gorilla", "Rami", "Scary", "Fun", "Monke"], "long_description": "Gorilla Rami is an exhilarating VR game that builds on the playful mechanics of Gorilla Tag while adding a thrilling, multi-dimensional twist. Players dive into a series of fantastical environments, each designed to push the boundaries of immersive gameplay. In the chilling Horror Maps, you'll navigate through eerie, atmospheric settings filled with unsettling sounds and shadows, demanding both stealth and quick reflexes to avoid the terrifying entities lurking in the darkness. The Zero Gravity area offer a mind-bending experience where you float and maneuver in three-dimensional space, mastering the art of weightless movement to outwit opponents and tackle unique challenges.\n\nIn contrast, the Lava Maps ramp up the intensity with their perilous platforms and flowing molten lava, creating a high-stakes environment where agility and strategy are crucial to avoid the searing heat. With its blend of playful movement and immersive scenarios, Gorilla Rami promises a wild, adrenaline-pumping adventure that challenges your coordination, creativity, and courage in ways you\u2019ve never experienced before.", "short_description": "Gorilla Rami is an exhilarating VR game that builds on the playful mechanics of Gorilla Tag while adding a thrilling, multi-dimensional twist. Players dive into a series of fantastical environments, each designed to push the boundaries of immersive gameplay. Gorilla Rami promises a wild, adrenaline-pumping adventure that challenges your coordination, creativity, and courage in ways you\u2019ve never experienced before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/gorilla-rami/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "GolensZapper", "support_website_url": null, "website_url": "https://sites.google.com/view/gorilla-rami/home?authuser=0", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9146270372158994"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes"
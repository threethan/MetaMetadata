KrTaBlDtQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXKqGMZmVXat89N2nCWyqIRzZRYu2X-0TbJDDLRFKHbA&oe=6AFB315F"}, {"file_name": "New Project (8).png", "id": "973166154428256", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393425_973166157761589_2137544379493982175_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uA_ZeRmS1Z4Q7kNvwFQ-Riz&_nc_oc=AdrT34LADteTtZ4VUXlOSORmsaX5Sc0qf81K1Ka7AJItbRDspSpYpKMRYRY9IDg2cIw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfCqfxqyxjmd655mg2v9-nHPgPXJyF_NkqE0BzvFgjpw&oe=6AFB26E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project (2).png", "id": "1032124405615852", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393444_1032124408949185_6584886606991333037_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7YQC3EQTytQQ7kNvwGvR5e-&_nc_oc=AdocHscId2v0UFGaSZSFNydjeBFcr9J3hFBClU_kQGUVJXSwkc3IWjs68FM3QcU10hQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzHoF8mbKjveA9U2nEF6Z98BhIu7GugVPGZb07y1dHFw&oe=6AFB2629"}, "display_name": "Gorilla Rami", "keywords": ["Gorilla", "Rami", "Scary", "Fun", "Monke"], "long_description": "Gorilla Rami is an exhilarating VR game that builds on the playful mechanics of Gorilla Tag while adding a thrilling, multi-dimensional twist. Players dive into a series of fantastical environments, each designed to push the boundaries of immersive gameplay. In the chilling Horror Maps, you'll navigate through eerie, atmospheric settings filled with unsettling sounds and shadows, demanding both stealth and quick reflexes to avoid the terrifying entities lurking in the darkness. The Zero Gravity area offer a mind-bending experience where you float and maneuver in three-dimensional space, mastering the art of weightless movement to outwit opponents and tackle unique challenges.\n\nIn contrast, the Lava Maps ramp up the intensity with their perilous platforms and flowing molten lava, creating a high-stakes environment where agility and strategy are crucial to avoid the searing heat. With its blend of playful movement and immersive scenarios, Gorilla Rami promises a wild, adrenaline-pumping adventure that challenges your coordination, creativity, and courage in ways you\u2019ve never experienced before.", "short_description": "Gorilla Rami is an exhilarating VR game that builds on the playful mechanics of Gorilla Tag while adding a thrilling, multi-dimensional twist. Players dive into a series of fantastical environments, each designed to push the boundaries of immersive gameplay. Gorilla Rami promises a wild, adrenaline-pumping adventure that challenges your coordination, creativity, and courage in ways you\u2019ve never experienced before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/gorilla-rami/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "GolensZapper", "support_website_url": null, "website_url": "https://sites.google.com/view/gorilla-rami/home?authuser=0", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9146270372158994"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes"
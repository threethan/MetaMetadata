m/v/t64.5771-25/499312369_9593390547429688_8166111264857507878_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dTozaZjchWQQ7kNvwE42GdI&_nc_oc=Adpi_bPfJyM1Rm2STNTBCLG5dV271PhLwwD16OS2lcBhwWYNxi5j2OlirTeFVz3pHoo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2PoswcViu-fx4lAS9rEi8-ctB7gbqEAun4BpSGt76GCg&oe=69DF869C"}, {"file_name": "Screenshot_2880x1600_bb214.png", "id": "1491688005511309", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499617698_1491688008844642_3070900357047742818_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UYlqgUxSAxUQ7kNvwHAU8TE&_nc_oc=AdocY1oUpLwtylEiS1LuxMGlnSrfBLTnGRgBGSvU6CHXokxLhJTxFxMXvsCDTPxIjlA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0QTG8GhN4UdkHzUgHB0o35wwCDCwEjhyB3AoxYr3NMgg&oe=69DF8F07"}, {"file_name": "Screenshot_2880x1600_9a28a.png", "id": "1469642171156277", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312263_1469642174489610_6238668177923789552_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jnczacHCuzkQ7kNvwEFPw1_&_nc_oc=Adrmo5b331fy256FOmITUixRRGvzA4arv45ESfK2zk4IruAkGvNuQGenImcUbJCe8sI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3DgQcOLv5f0K0uFm_TyqAV-A6S5AZhRMEI2KOLa19q2w&oe=69DF9117"}, {"file_name": "Screenshot_2880x1600_f099b.png", "id": "977395024410495", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619447_977395027743828_5773783047847037398_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K6VKvHOWHA8Q7kNvwEoFkA0&_nc_oc=AdoJf8YLvKEW3HGN3f_xcjmQ3fH2yRaGZfAK6LAzySyMU1iiFs2Bl2QSujzDkztGs-8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2dRfwYh99jV164KlGsMxDJk_VsfXkWyDHFaHy0Db9mhg&oe=69DF93C2"}, {"file_name": "Screenshot_2880x1600_f88cf.png", "id": "1867940793774393", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499617813_1867940797107726_5466069117076797571_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mNPvaS4zV00Q7kNvwHHvVHH&_nc_oc=AdpY74-H2SZMXStCAHnVUG7KjRy0m3QKpdYd9SxJgdocVemnr5QghpjA-ULU5BHo5-Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2MpVS9D7wVExm6_6kq-QXPURb08Ss3GATKlTSyvF8_rw&oe=69DF9B0A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Muvia Skiing", "keywords": ["games", "skiing", "rehab", "rehabilitation"], "long_description": "Muvia Skiing transforms rehabilitation into an immersive adventure - blending VR, AI, and real-world motion to restore movement and rebuild lives.\n\nMore than just a game, Muvia Skiing offers a unique fusion of gamified therapy and exhilarating sports experiences. Set in beautifully crafted winter landscapes, players ski through challenging slopes, practice balance, and engage in dynamic, full-body movements that stimulate both body and mind.\n\nDesigned for both home and clinical use, each session delivers real-time feedback and motion monitoring - supporting personalized progress for recreational users and those on a rehabilitation journey alike.\n\nWhether you're training, recovering, or just having fun, Muvia Skiing brings the thrill of the slopes - and real therapeutic results - right to you.", "short_description": "Experience the thrill of skiing while enhancing your movement and balance. Muvia Skiing combines immersive VR gameplay with therapeutic benefits and real-time feedback, bringing the excitement of winter adventures to everyone, anywhere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.muvia.ai/privacy", "developer_terms_of_service_url": "https://www.muvia.ai/terms", "publisher_name": "Muvia Inc. ", "support_website_url": null, "website_url": "https://www.muvia.ai/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "24023071587361790"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1868851117023257"}]}, "baseline_offer": {"id": "1868851117023257"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1753973580, "status": "PUBLISHED", "id": "1868851117023257"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26009917255343870", "version": "1.0.3"}, "id": "1092730666095258", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9866917830070403", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26009917255343870"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1092730666095258"}]}, "change_log": null, "created_date": 1773682392, "id": "26009917255343870", "version": "1.0.3", "version_code": 18, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9866917830070403", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26009917255343870"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1092730666095258"
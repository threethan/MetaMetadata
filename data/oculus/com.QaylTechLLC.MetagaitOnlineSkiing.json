SoXEAo6CZpLve3k787KuTxjpkaGR4vkU&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5eGAjtKCpqInTDFsbI25XWwX4DFu9eeTrwEIl3Pr7nhg&oe=6A10628A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Muvia Skiing", "keywords": ["games", "skiing", "rehab", "rehabilitation"], "long_description": "Muvia Skiing transforms rehabilitation into an immersive adventure - blending VR, AI, and real-world motion to restore movement and rebuild lives.\n\nMore than just a game, Muvia Skiing offers a unique fusion of gamified therapy and exhilarating sports experiences. Set in beautifully crafted winter landscapes, players ski through challenging slopes, practice balance, and engage in dynamic, full-body movements that stimulate both body and mind.\n\nDesigned for both home and clinical use, each session delivers real-time feedback and motion monitoring - supporting personalized progress for recreational users and those on a rehabilitation journey alike.\n\nWhether you're training, recovering, or just having fun, Muvia Skiing brings the thrill of the slopes - and real therapeutic results - right to you.", "short_description": "Experience the thrill of skiing while enhancing your movement and balance. Muvia Skiing combines immersive VR gameplay with therapeutic benefits and real-time feedback, bringing the excitement of winter adventures to everyone, anywhere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.muvia.ai/privacy", "developer_terms_of_service_url": "https://www.muvia.ai/terms", "publisher_name": "Muvia Inc. ", "support_website_url": null, "website_url": "https://www.muvia.ai/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "24023071587361790"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1868851117023257"}]}, "baseline_offer": {"id": "1868851117023257"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1753973580, "status": "PUBLISHED", "id": "1868851117023257"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26009917255343870", "version": "1.0.3"}, "id": "1092730666095258", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9866917830070403", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26009917255343870"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1092730666095258"}]}, "change_log": null, "created_date": 1773682392, "id": "26009917255343870", "version": "1.0.3", "version_code": 18, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9866917830070403", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26009917255343870"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1092730666095258"
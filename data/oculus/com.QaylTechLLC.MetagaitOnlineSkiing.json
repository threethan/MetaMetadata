vZBeU7D6e8ubFjBny2r5wfsOBZIsv3cr535ZZSw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_BXGSD5--0PCoeAa04wFSpO1EaTdAK6SP8GdiEKJfXdQ&oe=6A46700A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Muvia Skiing", "keywords": ["games", "skiing", "rehab", "rehabilitation"], "long_description": "Muvia Skiing transforms rehabilitation into an immersive adventure - blending VR, AI, and real-world motion to restore movement and rebuild lives.\n\nMore than just a game, Muvia Skiing offers a unique fusion of gamified therapy and exhilarating sports experiences. Set in beautifully crafted winter landscapes, players ski through challenging slopes, practice balance, and engage in dynamic, full-body movements that stimulate both body and mind.\n\nDesigned for both home and clinical use, each session delivers real-time feedback and motion monitoring - supporting personalized progress for recreational users and those on a rehabilitation journey alike.\n\nWhether you're training, recovering, or just having fun, Muvia Skiing brings the thrill of the slopes - and real therapeutic results - right to you.", "short_description": "Experience the thrill of skiing while enhancing your movement and balance. Muvia Skiing combines immersive VR gameplay with therapeutic benefits and real-time feedback, bringing the excitement of winter adventures to everyone, anywhere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.muvia.ai/privacy", "developer_terms_of_service_url": "https://www.muvia.ai/terms", "publisher_name": "Muvia Inc. ", "support_website_url": null, "website_url": "https://www.muvia.ai/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area
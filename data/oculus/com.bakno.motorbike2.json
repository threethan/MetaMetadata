c_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9gOGy_ulqmfOBfbND8e0emoSR-GxBPYgM83Cjx4YKJew&oe=6A26E4CB"}, {"file_name": "Screenshot 3.png", "id": "964747672646443", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491830794_964747675979776_8479199819504799833_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HXjtaGDbom4Q7kNvwGI__LP&_nc_oc=AdpxUmKRhqWbXeqQJ5EAdGCbua2Uf6PHt6hhhOliiigD6IwzC645ktxcy5N28GfDki4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7B-2Sd-kxeLlGZ2tNUd-XJouTMO152aAh8D5upmvyQw&oe=6A26BDA7"}, {"file_name": "Screenshot 4.png", "id": "1764434794941897", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499294644_1764434801608563_6147733179493568615_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p5Ak5QRiTQcQ7kNvwEUQCNc&_nc_oc=Adq8L9Z0ODU-sw_F4kqEUlv23iWGWm5Oit4JnpBLEINuzBnuF4_RsMMxqqOYuIZeaJA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Eh4bgBqu9YbGKE4Al5MAihJy28-5M4MdM_pvLBCKi2A&oe=6A26CE6D"}, {"file_name": "Screenshot 5.png", "id": "1422056305667258", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499294603_1422056309000591_2094452805767716466_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=ndf9RY8Wz2kQ7kNvwFtdg1w&_nc_oc=AdoqnjanTjZCXnQuIVwN3z2OJVBBHWrlR7tXqqpT-kJ-Y3zrr-LWUKRZedUoeZc244A&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8RO-qrzKt0H6bcKj6-aP1Fd2kwzEgNRU03RYLqlZgQlg&oe=6A26E211"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverVideo.png", "id": "744928845222021", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499304938_744928848555354_1187377408694993823_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y1vDzzdfAvYQ7kNvwEH6f51&_nc_oc=Adp3RnLMDB6DKAwLTRZhbRgKWMqNGyO2dwJ6xFYHQ6GDMLEJhKY3Ok-cQW0sGB5BgtM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--NBhZPqihKLhayJbTKABIInDYwwkKndj9FDy4UFiq6A&oe=6A26C29C"}, "display_name": "Motorbike", "keywords": [], "long_description": "Prepare for thrilling action and realistic physics dynamics in Motorbike, a captivating casual game that tests your bike skills. Immerse yourself in an adrenaline-fueled experience as you navigate through 100 original tracks, with thousands more available online. Unleash your creativity with the built-in track editor, allowing you to craft your own challenging tracks and share them with fellow players. Choose from a diverse selection of riders, bikes, and landscapes, customizing your experience to match your preferences. Engage in exciting multiplayer competitions, pitting your skills against other players for ultimate supremacy. While Motorbike offers easy-to-learn gameplay, it presents a significant challenge to master, providing a rewarding experience for those seeking skillful triumph. Get ready to embark on an exhilarating journey filled with action, creativity, and the pursuit of becoming a Motorbike legend.", "short_description": "A casual bike skills game full of action and real physics dynamics. Motorbike comes with 100 original tracks, thousands of online tracks and a track editor to create your own tracks and share with other players. Select from different riders, bikes and landscapes. Additionally, you can play Motorbike with another player locally. You will find Motorbike easy to play but hard to master."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bakno.com/Corporate/privacy.html", "developer_terms_of_service_url": "https://www.bakno.com/Corporate/license.html", "publisher_name": "baKno Games", "support_website_url": "https://www.bakno.com/Support/index.html", "website_url": "https://www.baknogames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genr
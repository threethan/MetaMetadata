&_nc_ohc=HlmG71tzJ-8Q7kNvwHwsDcw&_nc_oc=AdpO1j5trpCegPNnxq33GNJZ-4Q_-VT2299Q2WUdGgdmRG87e_gxPSOgxMN2wYI9_Wg&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGvezsKVgORWfuNrPtAayUCRsaFFUYip6LdCz_Rp5CJMQ&oe=6A8EE427"}, {"file_name": "Screenshot 4.png", "id": "1764434794941897", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499294644_1764434801608563_6147733179493568615_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2sXVGKRD4cEQ7kNvwEKOQ49&_nc_oc=AdorbH14LExQRrAYy1Ip1opZ1qWMcSH349wxkqHDG6eZyHq1ajd5EXAswznXDpuQIjM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6Sr9oMJzPg87xhNupsz-Er8ae9LB5iRfonmMKxIK7ig&oe=6A8EF4ED"}, {"file_name": "Screenshot 5.png", "id": "1422056305667258", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499294603_1422056309000591_2094452805767716466_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=lfVb401IgPQQ7kNvwFhv-IT&_nc_oc=AdrugCYO3N1UN_fz7OBVmWCX8c_ehHKhVx-AwxOj9l9Kt3xvT_F4U4qUitdNR-78A58&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2KH3ba-JBQ27ScDzKXIsqM35luwg8Zc7gOBcHsQHmPg&oe=6A8ED051"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverVideo.png", "id": "744928845222021", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499304938_744928848555354_1187377408694993823_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ZsdQ4M1O1oQ7kNvwGOWyms&_nc_oc=Ado3TFjpwjrp5MvM83SN5n8W9NP7FQNsFkxIAJINSUI0j5c-KT7y9ouXt2ewSSVDX_Q&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGa2ic4MviygAE_hLOMRBEv8rmKW5SvI5Qbj91ekrQuRg&oe=6A8EE91C"}, "display_name": "Motorbike", "keywords": [], "long_description": "Prepare for thrilling action and realistic physics dynamics in Motorbike, a captivating casual game that tests your bike skills. Immerse yourself in an adrenaline-fueled experience as you navigate through 100 original tracks, with thousands more available online. Unleash your creativity with the built-in track editor, allowing you to craft your own challenging tracks and share them with fellow players. Choose from a diverse selection of riders, bikes, and landscapes, customizing your experience to match your preferences. Engage in exciting multiplayer competitions, pitting your skills against other players for ultimate supremacy. While Motorbike offers easy-to-learn gameplay, it presents a significant challenge to master, providing a rewarding experience for those seeking skillful triumph. Get ready to embark on an exhilarating journey filled with action, creativity, and the pursuit of becoming a Motorbike legend.", "short_description": "A casual bike skills game full of action and real physics dynamics. Motorbike comes with 100 original tracks, thousands of online tracks and a track editor to create your own tracks and share with other players. Select from different riders, bikes and landscapes. Additionally, you can play Motorbike with another player locally. You will find Motorbike easy to play but hard to master."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bakno.com/Corporate/privacy.html", "developer_terms_of_service_url": "https://www.bakno.com/Corporate/license.html", "publisher_name": "baKno Games", "support_website_url": "https://www.bakno.com/Support/index.html", "website_url": "https://www.baknogames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar", "zh_CN", "zh_HK", "zh_TW", "en_US", "en_AU", "en_CA", "en_ZA", "en_GB", "fr_BE", "fr_CA", "fr", "
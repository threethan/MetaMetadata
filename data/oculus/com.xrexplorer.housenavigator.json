": "1351772993444024", "locale": "en_US", "screenshots": [{"file_name": "05-the-staircase.png", "id": "1406528590993095", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673645340_1406528594326428_1247716684943346737_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4eksaRFfSI8Q7kNvwFPbLRc&_nc_oc=AdrJA6Ji0DJD2184t798KRPyP18VgyiRBDr1NOLFaP-uuD9Eu9Qz4Ahmq7rWIvUc6GM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHUB2xVl1TEbgUNl09hlxI1Z27WDFHQNIdOVuv-s-QaA&oe=6AF32DAC"}, {"file_name": "01-the-street.png", "id": "1150683094285212", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673652249_1150683097618545_6078889216698908130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F6msJDPL_V8Q7kNvwG34v-S&_nc_oc=Adrl26EyisZgwKrSODtlRriaR2R18wF0SusuhmFW5-D9HDezxY1ybZOnISQ9cDg-IWo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaFvuRinNZLU1yryG1xTdoU9tjUwHwfEFu6l0f7SwIuQ&oe=6AF348CE"}, {"file_name": "03-palette-and-wheel.png", "id": "2573782103098030", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604370996_2573782106431363_7766205735850213310_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gi1p6DbNWzwQ7kNvwHd9e6v&_nc_oc=AdriUMAIvwCD9qO0Hn81T2-UuWXHjiGoi3n7-Q2DqsuRumO4pgl-yashtcuNSdttqgw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThAriTBFxKAHB0Z8F-_JmdvBDZXQUKQCc0e3BByZxSEg&oe=6AF34603"}, {"file_name": "04-garage-and-drive.png", "id": "2287560225340410", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830822_2287560228673743_2008849062667807620_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6b1cUs6XDZ0Q7kNvwF5nDUQ&_nc_oc=AdpsxT9fpQi5cE9HbMJrRmZDu_ka6tNc3ZSvecMWIuu5Zqrf1LoaJBuCbu6ZVIRjXtg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2vaNIgMsFnEJqVnfpnmAWxOFF-UgMXq04XZQF1MRuDw&oe=6AF34F58"}, {"file_name": "02-a-repainted-wall.png", "id": "4627326870835228", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604360590_4627326874168561_2812088831143185775_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o7F9ztjAz4cQ7kNvwEVc4Jy&_nc_oc=Adp5-W2Rys6fQGiNoUnZxpJUGU0S-bn_mRf4YiGzST55hlizf4gzO_Hxj7_8c8gXVyo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3zD4N_advIUk8qWfzZDF8etuGJEG30BmHcVoF4_PWPg&oe=6AF332CC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "xr-explorer", "keywords": [], "long_description": "XR Explorer turns a property into somewhere you can stand.\n\nInstead of judging a colour from a card under shop lighting, you walk into the room and paint the actual wall. Point, pull the trigger, and that surface changes \u2014 at full size, in the light it will actually sit in.\n\n**What you can do**\n\n- Walk freely through every room, upstairs and down\n- Repaint any single surface: walls, floors, ceilings, doors, roofs, even a garage\n- Pick from sixteen architectural colours, or mix any colour on an HSV wheel\n- Read the exact hex value of whatever you have chosen\n- Undo the last change, or revert a surface to how it started\n- Leave a house and return to find your colours still there\n\n**What is included**\n\n- A compact single-storey home, good for a first look\n- A two-storey house with a staircase, glazed windows and hung artwork\n- A community of ten houses along a street, in three designs, each with an attached two-car garage and driveway, and a map board at the entrance\n\nEvery house has real wall thickness, double-hung windows you can see daylight through, and pitched roofs, so a room reads as a room.\n\n**Who it is for**\n\nBuyers imagining a home as theirs, agents showing a property not yet built, and anyone who has held two near-identical paint samples against a wall and still not known.\n\n**Requirements**\n\nMeta Quest 3 or Quest 3S. Controllers required. Roomscale or standing. No account, no sign-in, and no internet connection needed \u2014 everything runs and saves on your headset.\n", "short_description": "Walk through a house at full size and repaint it while you are standing inside it.\n\nPoint at any wall, floor, or ceiling and change its colour \u2014 one surface at a time, seen at scale instead of guessed from a swatch card. Choose from sixteen architectural colours or mix your own on a colour wheel with live hex values.\n\nYour choices are saved for each house, so you can leave and come back to them. Explore a single home, or walk a whole ten-house street.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.xrexplorer.app/privacy", "developer_terms_of_service_url": null, "publisher_name": "Senior Nlinwe Ngenge", "support_website_url": null, "website_url": "https://www.xrexplorer.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1313452598521432"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1126183029948952"}]}, "baseline_offer": {"id": "1126183029948952"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1791218580, "status": "PUBLISHED", "id": "1126183029948952"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1334897329710292", "version": "1.0.0"}, "id": "1496800665589890", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "
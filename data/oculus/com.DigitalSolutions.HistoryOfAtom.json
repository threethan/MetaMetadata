t-iad6-1.oculuscdn.com/v/t64.5771-25/499628108_933766323126903_2863554142375177190_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GTjdMBPT2EMQ7kNvwGgZp2Z&_nc_oc=Adqv5FHXmKiQBqia3jaSsVmbp1JMj99FC07MgiBU9AJNSsUWDcsb2VV0gEj568xg8ec&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRf3sO5l5EEdvgYGrGGwuZs-WiBJbmfuzZx9ofrxWqyOg&oe=6B072458"}, {"file_name": "Screenshot3.png", "id": "1662064935272358", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499627477_1662064938605691_2041960940970475519_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nQmVHAvmZA8Q7kNvwH7gfhu&_nc_oc=AdogXt3U03oP8FeIaObdB3OZMbeZkPkt2BaF8AMPKcgGMa6U5fbJSJntYBzVGxZSlno&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-1rj6m0e9qw3T0qGhSj5M7N2vLzIMivuZRgJ3WB1g1g&oe=6B072506"}, {"file_name": "Screenshot2.png", "id": "1394433379521205", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622202_1394433382854538_1645354260844988722_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6KMuKUb88EQQ7kNvwH2O8kS&_nc_oc=Adq-5Yvhi_3FijEvjd9jVc14wfP0rFAJY47U9sXfQh7jGyBfG62uOSqtBh1g4ZgLR-0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ71qOMOSJFk086UTWl4eLBuUjUpgfwMOy8z26IJNGlDA&oe=6B06F581"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "348828104606192", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974548_348828107939525_4183982372861582271_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4BS_xqv8W5MQ7kNvwF-HCy3&_nc_oc=AdrNm-d1MVxDAPC0x5l5za9y6L819B1mzAiCRxdCrmelXLkbAZA7YpiCru80cy3d9G8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR93NBc4rhd3YCgRdBKsd55rEBw4chHAit-59WtEdxIng&oe=6B0720FA"}, "display_name": "History of Atom", "keywords": ["atom", "science", "history"], "long_description": "History of Atom is an immersive educational VR experience that transforms the story of atomic science into a journey you can explore, interact with, and discover for yourself. Travel across more than two thousand years of scientific discovery, from the ideas of ancient Greek philosopher Democritus to the groundbreaking atomic models of John Dalton, J. J. Thomson, Ernest Rutherford, and Niels Bohr. \n\nInstead of simply watching history, you become part of it. Enter historically inspired environments, handle virtual scientific equipment, make predictions, perform experiments, observe the results, and discover why scientists changed their understanding of the atom. Each chapter demonstrates an important idea at the heart of science: scientific models change when new evidence is discovered.\n\nDesigned as an engaging learning experience, History of Atom uses the unique possibilities of VR to make abstract scientific concepts visual, interactive, and memorable. Explore. Experiment. Question your predictions. Discover how humanity uncovered the hidden structure of matter.", "short_description": "Journey through the history of the atom in an interactive VR experience. Step into historic laboratories, recreate famous experiments, and discover how our understanding of atomic structure evolved through the work of Democritus, Dalton, Thomson, Rutherford, and Bohr."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null
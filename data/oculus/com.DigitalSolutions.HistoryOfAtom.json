WqNoXbnIhnn6IfyvjMLX6I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMzxvsZoR_oFHvtCL7XWMaO_qdDiPBjpnumTdip-9E7Rw&oe=6AC3AF98"}, {"file_name": "Screenshot3.png", "id": "1662064935272358", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499627477_1662064938605691_2041960940970475519_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PwOFWHQO1aEQ7kNvwFOFPJw&_nc_oc=AdrgjnZQZx10gQdWH_8piJ7N3-soxFndXE_7RtB_TOjfDnGX2cY71K3P3Ymh6GmfL88&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNcjhtrHUy5ACcYHnIG5M7RPoPp_AV_W0ogJGyg2w0bsw&oe=6AC3B046"}, {"file_name": "Screenshot2.png", "id": "1394433379521205", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622202_1394433382854538_1645354260844988722_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vK4ZJDyexEIQ7kNvwFty3fD&_nc_oc=Adry3v7GwIB_BzpRKgQuG6ewq3xNKZZbd0XMPQgyLK9cIa8j4GcIlMujR61mAPxd6as&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMV-sk7fnp5LFuYoDG7JdlMooym7YD4S_N5jN51VGyeyw&oe=6AC3B901"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "348828104606192", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974548_348828107939525_4183982372861582271_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WzS-WT6L0fcQ7kNvwHdljK0&_nc_oc=AdqVpYZxbCrbJ1cHfXT-m6Z3i0CIFBB_yWj7oLJAuGaf9aDhHdrymro8991gYyULdJ8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM9V71PZJ79ivoup_eI237TjuF3Jj0laBaCdhzLKfFZSw&oe=6AC3AC3A"}, "display_name": "History of Atom", "keywords": ["atom", "science", "history"], "long_description": "History of Atom is an immersive educational VR experience that transforms the story of atomic science into a journey you can explore, interact with, and discover for yourself. Travel across more than two thousand years of scientific discovery, from the ideas of ancient Greek philosopher Democritus to the groundbreaking atomic models of John Dalton, J. J. Thomson, Ernest Rutherford, and Niels Bohr. \n\nInstead of simply watching history, you become part of it. Enter historically inspired environments, handle virtual scientific equipment, make predictions, perform experiments, observe the results, and discover why scientists changed their understanding of the atom. Each chapter demonstrates an important idea at the heart of science: scientific models change when new evidence is discovered.\n\nDesigned as an engaging learning experience, History of Atom uses the unique possibilities of VR to make abstract scientific concepts visual, interactive, and memorable. Explore. Experiment. Question your predictions. Discover how humanity uncovered the hidden structure of matter.", "short_description": "Journey through the history of the atom in an interactive VR experience. Step into historic laboratories, recreate famous experiments, and discover how our understanding of atomic structure evolved through the work of Democritus, Dalton, Thomson, Rutherford, and Bohr."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["mn", "en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28901355456123278"}, "review_messages": []}]}, "cover_square_image": {"uri": "https:/
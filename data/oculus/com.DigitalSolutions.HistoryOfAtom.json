t-atl3-1.oculuscdn.com/v/t64.5771-25/499628108_933766323126903_2863554142375177190_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MxfUMIguMQIQ7kNvwFSVuLb&_nc_oc=Adr-oVXZQH6C05PxhJPiR8zRGyjQSDtnqCGGBiUnLS6Zk_uaWdhsCbsXXNSIGTEYwaY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRwvUEUpTK6kD6I-_8flYqgev2uYQGfNbYNp62QweWdWA&oe=6B0B18D8"}, {"file_name": "Screenshot3.png", "id": "1662064935272358", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499627477_1662064938605691_2041960940970475519_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uxOgmqTqjHYQ7kNvwG2cnz_&_nc_oc=AdoclwHDAlDw1K0ewEa9HLYTOpQMn2sr3BBtbgALW9frQVUU29l-QVjOO0N65E4FGok&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTmxM177I8HnGr7PiNOvvkyMbco2CK_SqrjI1Usj0ytvQ&oe=6B0B1986"}, {"file_name": "Screenshot2.png", "id": "1394433379521205", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499622202_1394433382854538_1645354260844988722_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CPyZZ__zfd4Q7kNvwFq10lq&_nc_oc=Adqs9S1W4ScJT4ok0TGutcSEynNj51TOOQaDrKoC7fmCsfEkNfgv5byOghVf0zzA2h8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSwKyVAdI8tD7ymzP7tavK5lveQuMLzBAYScBNQJve2dg&oe=6B0B2241"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "348828104606192", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974548_348828107939525_4183982372861582271_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WSDGfo15OZ0Q7kNvwH-8FLc&_nc_oc=Adqe6zDjN6cHHGo0t3F2rKMlP-pn8qGEf5owpXnXMRlL--cmxUoO59HA21PbnGpezGI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRzoWWjCFIjZU4sMYn9EQ_OpQCVm1uht9av69k777Rdmg&oe=6B0B157A"}, "display_name": "History of Atom", "keywords": ["atom", "science", "history"], "long_description": "History of Atom is an immersive educational VR experience that transforms the story of atomic science into a journey you can explore, interact with, and discover for yourself. Travel across more than two thousand years of scientific discovery, from the ideas of ancient Greek philosopher Democritus to the groundbreaking atomic models of John Dalton, J. J. Thomson, Ernest Rutherford, and Niels Bohr. \n\nInstead of simply watching history, you become part of it. Enter historically inspired environments, handle virtual scientific equipment, make predictions, perform experiments, observe the results, and discover why scientists changed their understanding of the atom. Each chapter demonstrates an important idea at the heart of science: scientific models change when new evidence is discovered.\n\nDesigned as an engaging learning experience, History of Atom uses the unique possibilities of VR to make abstract scientific concepts visual, interactive, and memorable. Explore. Experiment. Question your predictions. Discover how humanity uncovered the hidden structure of matter.", "short_description": "Journey through the history of the atom in an interactive VR experience. Step into historic laboratories, recreate famous experiments, and discover how our understanding of atomic structure evolved through the work of Democritus, Dalton, Thomson, Rutherford, and Bohr."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null
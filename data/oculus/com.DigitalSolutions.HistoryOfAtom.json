wfqSaoCloSIF_ds1WI-j5Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPxj5iv81pW8oeyl8DeU4IdLRFOHbpZXrrYyLiiPa5eeQ&oe=6ACB9898"}, {"file_name": "Screenshot3.png", "id": "1662064935272358", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499627477_1662064938605691_2041960940970475519_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HOz-l-L8UOkQ7kNvwFk7pLu&_nc_oc=AdqwAXmB-_rKyIMTvDYdHM0fkdy-WsQszQoLXn8SdAsN14QJiFFQiSf-rmjzJjsVpyI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMHhgyheJjqJ4kzjImV6et_9Zh2ApLAMvY9ah_vtH4rhg&oe=6ACB9946"}, {"file_name": "Screenshot2.png", "id": "1394433379521205", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622202_1394433382854538_1645354260844988722_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i781Y5OPAPMQ7kNvwGvRMxU&_nc_oc=AdoZMiqukEwt9QS1-t7ORcPVmsU37CaOiG1NaNtZpnowa5IA3UaM9uJgV1RLLD_dysY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNN0bCCst4UMa1Me4rEuWufW9Oceuh8vooIeIDVooELbA&oe=6ACBA201"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "348828104606192", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974548_348828107939525_4183982372861582271_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z125lD0afkwQ7kNvwHpcpHe&_nc_oc=AdqRNS9TcQV0TdQuLsagc9TRJ7qYVFQla0Saon8SEMpWXRqqreqjRyKEUvTaqivPlVE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOXfSHIWBdhEJx889YCgrxjchqw6Cqhpi6GF4lf_W0xlA&oe=6ACB953A"}, "display_name": "History of Atom", "keywords": ["atom", "science", "history"], "long_description": "History of Atom is an immersive educational VR experience that transforms the story of atomic science into a journey you can explore, interact with, and discover for yourself. Travel across more than two thousand years of scientific discovery, from the ideas of ancient Greek philosopher Democritus to the groundbreaking atomic models of John Dalton, J. J. Thomson, Ernest Rutherford, and Niels Bohr. \n\nInstead of simply watching history, you become part of it. Enter historically inspired environments, handle virtual scientific equipment, make predictions, perform experiments, observe the results, and discover why scientists changed their understanding of the atom. Each chapter demonstrates an important idea at the heart of science: scientific models change when new evidence is discovered.\n\nDesigned as an engaging learning experience, History of Atom uses the unique possibilities of VR to make abstract scientific concepts visual, interactive, and memorable. Explore. Experiment. Question your predictions. Discover how humanity uncovered the hidden structure of matter.", "short_description": "Journey through the history of the atom in an interactive VR experience. Step into historic laboratories, recreate famous experiments, and discover how our understanding of atomic structure evolved through the work of Democritus, Dalton, Thomson, Rutherford, and Bohr."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["mn", "en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28901355456123278"}, "review_messages": []}]}, "cover_square_image": {"uri": "https:/
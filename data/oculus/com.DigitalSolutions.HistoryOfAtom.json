t-sjc3-1.oculuscdn.com/v/t64.5771-25/499628108_933766323126903_2863554142375177190_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z_6Zd7blprcQ7kNvwE6iZoJ&_nc_oc=AdpsvdXGX4kluZKznvckR43VAZW6OksaV4Dr6F8ibDTvr7pcLj3BlKd5TMZ_0qvCun8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQ3H16JVxdY5rCcoqs9um53iCCCoV2Fk_pVPlwEF6O6w&oe=6B032FD8"}, {"file_name": "Screenshot3.png", "id": "1662064935272358", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499627477_1662064938605691_2041960940970475519_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6wy84mZqsw0Q7kNvwHCCa07&_nc_oc=Ado17o_XgRR5c-ah8y2lXF-UvbAbQR7jQ72EQDXZuMFK5i-jvyoIcjy4iOSge3RnK48&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfv9jCyGN4Em7IQAOl7apKNPaExFoIquN1N4RDLTGd9A&oe=6B033086"}, {"file_name": "Screenshot2.png", "id": "1394433379521205", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622202_1394433382854538_1645354260844988722_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=23T0RcoV1R4Q7kNvwF6DhDC&_nc_oc=AdqNjxKmrnSCc6omnSU0_9gILINOiVHZ3DDaBCBu-O_Kg9UupXlTgc4L_5QxF-nOrgo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAUsWOLicvEm1tC38yjxJGc5M3rkgLr1-g5Ieon3BRyg&oe=6B033941"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "348828104606192", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974548_348828107939525_4183982372861582271_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jsraL8X7cZYQ7kNvwGCEPRb&_nc_oc=AdoNue7y5kVSustzCtAYrSL3iPQJgWAl2xs62ECz7BLVJTo5xCZFiHwE_jyV85F3e0Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGb93mlAcp8nK7ZqBxCeoBo7j-TrwNJDHOb05BJhL9Ag&oe=6B032C7A"}, "display_name": "History of Atom", "keywords": ["atom", "science", "history"], "long_description": "History of Atom is an immersive educational VR experience that transforms the story of atomic science into a journey you can explore, interact with, and discover for yourself. Travel across more than two thousand years of scientific discovery, from the ideas of ancient Greek philosopher Democritus to the groundbreaking atomic models of John Dalton, J. J. Thomson, Ernest Rutherford, and Niels Bohr. \n\nInstead of simply watching history, you become part of it. Enter historically inspired environments, handle virtual scientific equipment, make predictions, perform experiments, observe the results, and discover why scientists changed their understanding of the atom. Each chapter demonstrates an important idea at the heart of science: scientific models change when new evidence is discovered.\n\nDesigned as an engaging learning experience, History of Atom uses the unique possibilities of VR to make abstract scientific concepts visual, interactive, and memorable. Explore. Experiment. Question your predictions. Discover how humanity uncovered the hidden structure of matter.", "short_description": "Journey through the history of the atom in an interactive VR experience. Step into historic laboratories, recreate famous experiments, and discover how our understanding of atomic structure evolved through the work of Democritus, Dalton, Thomson, Rutherford, and Bohr."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null
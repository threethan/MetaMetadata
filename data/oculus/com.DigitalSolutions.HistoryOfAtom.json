t-sea5-1.oculuscdn.com/v/t64.5771-25/499628108_933766323126903_2863554142375177190_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zM6vJje0NIIQ7kNvwGdv5hA&_nc_oc=Adq845QDcTwWY_CHScXy_ECbhNt-DdZmmg7UN9Rx9oYwiFFaRgoC2aJaQp5JJsLMcHk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTu14BZzVBWykSkGKXVP6Y7i6kV3PJlqHbyq2I4rx39pA&oe=6AFF0318"}, {"file_name": "Screenshot3.png", "id": "1662064935272358", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499627477_1662064938605691_2041960940970475519_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z4xWg-BbfqkQ7kNvwHEzFhc&_nc_oc=AdoKUN_RLL_RQ90O3PXMs4lEsY0MQQHeGBrJufxfgZaeHqioN_GNMn07KwfC1ZXoKDc&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRnrVaQvXSVWa02eOfqz0-52zT2cGfa_vdYs3VlTwqtA&oe=6AFF03C6"}, {"file_name": "Screenshot2.png", "id": "1394433379521205", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622202_1394433382854538_1645354260844988722_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nx8vLpRNqzkQ7kNvwE98vz9&_nc_oc=AdozyMWNgXIL3cDXqnU4jLQitFv4LvQLH-bPKM7waDLtEYgj414ncyU0BfrpDCqX_3I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjzSt9-1a3NRlc07g7GXbCRGBeHjm1PdZlW17CiCYcQQ&oe=6AFF0C81"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "348828104606192", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974548_348828107939525_4183982372861582271_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ref0M6h5ooUQ7kNvwHip2pM&_nc_oc=AdoPewULKi-5a-NCv0D1GCsf6XYD4e3s3zHC07TZBvXpS65y8SY4p-xJml5byAlEB0I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVpAMMCx56ASCrW2ZmHHtET7A0Z12KZzzZF-gS4Mr96w&oe=6AFEFFBA"}, "display_name": "History of Atom", "keywords": ["atom", "science", "history"], "long_description": "History of Atom is an immersive educational VR experience that transforms the story of atomic science into a journey you can explore, interact with, and discover for yourself. Travel across more than two thousand years of scientific discovery, from the ideas of ancient Greek philosopher Democritus to the groundbreaking atomic models of John Dalton, J. J. Thomson, Ernest Rutherford, and Niels Bohr. \n\nInstead of simply watching history, you become part of it. Enter historically inspired environments, handle virtual scientific equipment, make predictions, perform experiments, observe the results, and discover why scientists changed their understanding of the atom. Each chapter demonstrates an important idea at the heart of science: scientific models change when new evidence is discovered.\n\nDesigned as an engaging learning experience, History of Atom uses the unique possibilities of VR to make abstract scientific concepts visual, interactive, and memorable. Explore. Experiment. Question your predictions. Discover how humanity uncovered the hidden structure of matter.", "short_description": "Journey through the history of the atom in an interactive VR experience. Step into historic laboratories, recreate famous experiments, and discover how our understanding of atomic structure evolved through the work of Democritus, Dalton, Thomson, Rutherford, and Bohr."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null
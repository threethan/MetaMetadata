YHw&oe=6AFC8797"}, {"file_name": "230823165755.png", "id": "848193913551268", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035410_848193920217934_5852021513359262335_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L_IsfSOXlgAQ7kNvwGdx0yG&_nc_oc=AdqeqrZ8itV0SECDIryXYryzKsBxeNl28XcJ7HgQ4jK0HvUC296dHudG6NzuY7eWq9o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSoa8VJhcN57S7R9htR-eyCpfPxwWn6L2ZlKAV-D7D_ag&oe=6AFC9122"}, {"file_name": "230823165557.png", "id": "380417504758430", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75221322_380417508091763_3784107229769999007_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G0qOAp4XRCIQ7kNvwGZX4EE&_nc_oc=AdrwfxsZ-dK1oWw74WBWOa-0GXXlltSuNIdZgqVxMo7-4Tefa4z5wioL43VwWkNxuG0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEvxBFX208mc2YcGsMO-a2GFTazVYFiL-qY8UGWQoqvg&oe=6AFC6635"}, {"file_name": "230823165530.png", "id": "1012736133882182", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75303836_1012736137215515_1159597745498380348_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FVvJknPc0BAQ7kNvwHX3OKC&_nc_oc=AdqJUq5ZCh4TjK8j0yt8y7-rdbeaozzODi_D4druYldMMAM-wxsELCC1ZLO0pm8PSdU&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS63TUjoCKgvMKZEjOpbeHpcnEPIGTMUCjHcuPvfExcfg&oe=6AFC7085"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "513234611364089", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75221322_513234614697422_7535125650319054398_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JsDz9dtUQHcQ7kNvwEUYCr8&_nc_oc=Adp5HWE1IKlOVMUCXTKNgiB4AUkufcgG8SmhaNArWF3fmpaEAFlGOHL_bbyqFsCr4yU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYxI25oZdB1MQGFKaJRZA4XTv1xO3x7TUKRJc8ii-DnQ&oe=6AFC8E13"}, "display_name": "Beatrect", "keywords": ["music", "rhythm", "beat", "casual", "exercise"], "long_description": "# Welcome to Beatrect!\n\nWhere Music Meets Ray-Traced Graphics in VR!\n\n\n\n# \ud83c\udfb5 Pure Musical Freedom\n\nForget everything you know about rhythm games! No more stress about perfect timing or precise movements. Just feel the music and let your body flow naturally.\n\n\n# \u2728 Revolutionary Ray-Traced Visuals\n\nExperience rhythm action in a whole new light with our innovative ray-tracing technology. Every level brings you into a stunning visual environment that elevates your musical journey.\n\n\n\n# \ud83c\udfae Features That Set Us Apart\n\n**Pick Up and Play**\n\nJump right into the action - no tutorials needed\n-\nIntuitive controls that feel natural from the first beat\n-\nPerfect for both VR beginners and rhythm game veterans\n\n**Your Style, Your Way**\n\nFind your own rhythm and playing style\n-\nNo pressure for perfection - just pure enjoyment\n-\nPlay at your own pace and discover new techniques\n\n**Level Creator**\n\nDesign your own unique levels\n-\nShare your creations with the community\n-\nChance to be featured on our official levels page!\n\n\n**Visual Excellence**\n\nNext-gen ray-tracing graphics\n-\nUniquely designed visual environments\n-\nImmersive VR experience\n\n\n\nReady to experience a new kind of rhythm game?\n-\nDon't think, just feel - Let the music guide you in Beatrect!", "short_description": "Step into Beatrect's Ray-Traced Rhythm World!\nVR's most accessible rhythm game meets stunning visuals. No complicated rules - just slash, feel the beat, and enjoy the spectacle!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/77792f91-721d-441d-b29d-c505a4e07e86", "developer_terms_of_service_url": "https://ash-tulip-d32.notion.site/EULA-23d1bd1f5fb34fc3a9b69f9d2f0f926c?pvs=4", "publisher_name": "Farseer Co., Ltd.", "support_website_url": null, "website_url": "https://ash-tulip-d32.notion.site/f794e58b49eb440fa2c8eda3faa76259", "category": "GAMES",
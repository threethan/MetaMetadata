6vw&oe=6B086517"}, {"file_name": "230823165755.png", "id": "848193913551268", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/39035410_848193920217934_5852021513359262335_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3OvmLOt6SCQQ7kNvwGDmyf3&_nc_oc=AdrFuhOG6nD30RNpvgcdiGyNx77k0C9Bqrxqy1mz-xaU9JrtNNokhxYMJ8BGpGxBw_M&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtQv-comwWaomt9x4CQBKYj3cJkDIBjdo72vERHYFGLg&oe=6B086EA2"}, {"file_name": "230823165557.png", "id": "380417504758430", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75221322_380417508091763_3784107229769999007_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=27V73Kv8P7QQ7kNvwHLyWdi&_nc_oc=Adr-968cLxE3gcTRULpjzouPt-WE16Ard-dz8dmlV06-JuFj46pmsF7gRresAKtL4CI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1de5VfHUD-cFB75oYDTDby-k8tbBp-Enj5mxSuM20Lw&oe=6B0843B5"}, {"file_name": "230823165530.png", "id": "1012736133882182", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75303836_1012736137215515_1159597745498380348_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IzUcFI5vtwAQ7kNvwFZo419&_nc_oc=AdrwAhwHiob1GQ1RcywzGIG-ysDfTI64c628g5-u7wvYFImXkM34WXiH2CyecXPvnTY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1VYa53tb5yz--GKZcbZDaPeudIgZj2yEzfUBHpo2pMQ&oe=6B084E05"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "513234611364089", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75221322_513234614697422_7535125650319054398_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FBOrRxHMCwAQ7kNvwHdsT-h&_nc_oc=AdrwZ7f19XejhXRLjPSMCVF9Avh17-hxeTXpoZ9so8_kZxHl2G8BOo37cncMucbb4ZE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTutH0x21Sc9XEXCCsYt50fM3fyuSWe1xMztXy0cPYaIw&oe=6B086B93"}, "display_name": "Beatrect", "keywords": ["music", "rhythm", "beat", "casual", "exercise"], "long_description": "# Welcome to Beatrect!\n\nWhere Music Meets Ray-Traced Graphics in VR!\n\n\n\n# \ud83c\udfb5 Pure Musical Freedom\n\nForget everything you know about rhythm games! No more stress about perfect timing or precise movements. Just feel the music and let your body flow naturally.\n\n\n# \u2728 Revolutionary Ray-Traced Visuals\n\nExperience rhythm action in a whole new light with our innovative ray-tracing technology. Every level brings you into a stunning visual environment that elevates your musical journey.\n\n\n\n# \ud83c\udfae Features That Set Us Apart\n\n**Pick Up and Play**\n\nJump right into the action - no tutorials needed\n-\nIntuitive controls that feel natural from the first beat\n-\nPerfect for both VR beginners and rhythm game veterans\n\n**Your Style, Your Way**\n\nFind your own rhythm and playing style\n-\nNo pressure for perfection - just pure enjoyment\n-\nPlay at your own pace and discover new techniques\n\n**Level Creator**\n\nDesign your own unique levels\n-\nShare your creations with the community\n-\nChance to be featured on our official levels page!\n\n\n**Visual Excellence**\n\nNext-gen ray-tracing graphics\n-\nUniquely designed visual environments\n-\nImmersive VR experience\n\n\n\nReady to experience a new kind of rhythm game?\n-\nDon't think, just feel - Let the music guide you in Beatrect!", "short_description": "Step into Beatrect's Ray-Traced Rhythm World!\nVR's most accessible rhythm game meets stunning visuals. No complicated rules - just slash, feel the beat, and enjoy the spectacle!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/77792f91-721d-441d-b29d-c505a4e07e86", "developer_terms_of_service_url": "https://ash-tulip-d32.notion.site/EULA-23d1bd1f5fb34fc3a9b69f9d2f0f926c?pvs=4", "publisher_name": "Farseer Co., Ltd.", "support_website_url": null, "website_url": "https://ash-tulip-d32.notion.site/f794e58b49eb440fa2c8eda3faa76259", "category": "GAMES",
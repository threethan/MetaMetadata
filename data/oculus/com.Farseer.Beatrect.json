5oA&oe=6B031F17"}, {"file_name": "230823165755.png", "id": "848193913551268", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035410_848193920217934_5852021513359262335_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ob86sOuv9esQ7kNvwGLpTPF&_nc_oc=AdqNuTX6ykAeWeVG6BUwUmt9J4LXQCME8MtwYVg8P1sCSuDZeoqEUfA2f5CMe-r-5Jw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRD3exOyCo5ldtaQuruGvEWFJlGAgW0Enc0Z5ND_4aqtw&oe=6B0328A2"}, {"file_name": "230823165557.png", "id": "380417504758430", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75221322_380417508091763_3784107229769999007_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HKtdhsC50_gQ7kNvwHr7q1c&_nc_oc=Adr2NjseKQKJ3JNSnkOeBXogxOK5fX6XXG4hbYxMm6YDOZl3xi9oztssWaXj15FHUXw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2m2MHoCgTEGmZBgKv3UT_hJr0B4nBqmoH7nVqQMitZg&oe=6B0335F5"}, {"file_name": "230823165530.png", "id": "1012736133882182", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75303836_1012736137215515_1159597745498380348_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OHoQPmegjvYQ7kNvwGQBC15&_nc_oc=AdomFvTLILgXTrgN3SbolXwaj9kmXWsKQjxrdJFDUTu5YYiPddPFWbfU8trXxD8c08w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxfm5ekKyh0_AFTmUryC8awBEH3ZEsD72dP6Q4YQqXmA&oe=6B030805"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "513234611364089", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75221322_513234614697422_7535125650319054398_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wDeTeouGhiQQ7kNvwGt03jm&_nc_oc=AdqdQPPtIx9O8U4mQDg4acbB8MEhQI4HVPtKEPn5zIwN1k0J5RYJghpLeAu823Jsvi8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSci41_pezoODG1tzAKbUlxtQctFV3QFxVwwAgtzgiF7Q&oe=6B032593"}, "display_name": "Beatrect", "keywords": ["music", "rhythm", "beat", "casual", "exercise"], "long_description": "# Welcome to Beatrect!\n\nWhere Music Meets Ray-Traced Graphics in VR!\n\n\n\n# \ud83c\udfb5 Pure Musical Freedom\n\nForget everything you know about rhythm games! No more stress about perfect timing or precise movements. Just feel the music and let your body flow naturally.\n\n\n# \u2728 Revolutionary Ray-Traced Visuals\n\nExperience rhythm action in a whole new light with our innovative ray-tracing technology. Every level brings you into a stunning visual environment that elevates your musical journey.\n\n\n\n# \ud83c\udfae Features That Set Us Apart\n\n**Pick Up and Play**\n\nJump right into the action - no tutorials needed\n-\nIntuitive controls that feel natural from the first beat\n-\nPerfect for both VR beginners and rhythm game veterans\n\n**Your Style, Your Way**\n\nFind your own rhythm and playing style\n-\nNo pressure for perfection - just pure enjoyment\n-\nPlay at your own pace and discover new techniques\n\n**Level Creator**\n\nDesign your own unique levels\n-\nShare your creations with the community\n-\nChance to be featured on our official levels page!\n\n\n**Visual Excellence**\n\nNext-gen ray-tracing graphics\n-\nUniquely designed visual environments\n-\nImmersive VR experience\n\n\n\nReady to experience a new kind of rhythm game?\n-\nDon't think, just feel - Let the music guide you in Beatrect!", "short_description": "Step into Beatrect's Ray-Traced Rhythm World!\nVR's most accessible rhythm game meets stunning visuals. No complicated rules - just slash, feel the beat, and enjoy the spectacle!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/77792f91-721d-441d-b29d-c505a4e07e86", "developer_terms_of_service_url": "https://ash-tulip-d32.notion.site/EULA-23d1bd1f5fb34fc3a9b69f9d2f0f926c?pvs=4", "publisher_name": "Farseer Co., Ltd.", "support_website_url": null, "website_url": "https://ash-tulip-d32.notion.site/f794e58b49eb440fa2c8eda3faa76259", "category": "GAMES",
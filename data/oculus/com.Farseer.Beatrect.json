fkQ&oe=6B0B4057"}, {"file_name": "230823165755.png", "id": "848193913551268", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035410_848193920217934_5852021513359262335_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-8PSPspVUYkQ7kNvwF5Y49i&_nc_oc=Adpql6gdqrEW2k9cMib_3V_h4cOblcRDU878oI9Jv91XZIVdCdrL2hw9VHTIGDUWEPg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRkuUu3ZOW3LxFdrPo5flvXYU3czPI7qXYFA1u3uwKz7g&oe=6B0B11A2"}, {"file_name": "230823165557.png", "id": "380417504758430", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75221322_380417508091763_3784107229769999007_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EISvI_xOtdwQ7kNvwHy-m6N&_nc_oc=AdojXfvpLRmxFY-EhyYEuUGQwPWrlpunYylsCfJ-eq3-Z-dVKNeDl1JeeGsm90JHjJY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSvfgQ9MfhtBp1mPTQ5sd3CnnAVqDAglF88AQ0HGsTitw&oe=6B0B1EF5"}, {"file_name": "230823165530.png", "id": "1012736133882182", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75303836_1012736137215515_1159597745498380348_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L_b8HtUFdu4Q7kNvwG-iTsa&_nc_oc=Adqrp8AlPgr2l3R6EvtJnjhsOOQMUznVWw8a5Ite9eu4fM2BkdPgXeby7F0FeMs_6hY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS58Il72tZ_3f4VhtAC1qgTtopvIE_bVJ60GscWUTjdkg&oe=6B0B2945"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "513234611364089", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75221322_513234614697422_7535125650319054398_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FBOrRxHMCwAQ7kNvwH_tGd5&_nc_oc=AdriH6a2i2MRcrhS2vmTT46yPoVO9IFn9Ty_F-pLyi0O6ok-Ke70leTLumzgELh9ga4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTynUPLyUPCTiOPW2q_aNPXYVNs0us2uHrgP0_Z228KvA&oe=6B0B0E93"}, "display_name": "Beatrect", "keywords": ["music", "rhythm", "beat", "casual", "exercise"], "long_description": "# Welcome to Beatrect!\n\nWhere Music Meets Ray-Traced Graphics in VR!\n\n\n\n# \ud83c\udfb5 Pure Musical Freedom\n\nForget everything you know about rhythm games! No more stress about perfect timing or precise movements. Just feel the music and let your body flow naturally.\n\n\n# \u2728 Revolutionary Ray-Traced Visuals\n\nExperience rhythm action in a whole new light with our innovative ray-tracing technology. Every level brings you into a stunning visual environment that elevates your musical journey.\n\n\n\n# \ud83c\udfae Features That Set Us Apart\n\n**Pick Up and Play**\n\nJump right into the action - no tutorials needed\n-\nIntuitive controls that feel natural from the first beat\n-\nPerfect for both VR beginners and rhythm game veterans\n\n**Your Style, Your Way**\n\nFind your own rhythm and playing style\n-\nNo pressure for perfection - just pure enjoyment\n-\nPlay at your own pace and discover new techniques\n\n**Level Creator**\n\nDesign your own unique levels\n-\nShare your creations with the community\n-\nChance to be featured on our official levels page!\n\n\n**Visual Excellence**\n\nNext-gen ray-tracing graphics\n-\nUniquely designed visual environments\n-\nImmersive VR experience\n\n\n\nReady to experience a new kind of rhythm game?\n-\nDon't think, just feel - Let the music guide you in Beatrect!", "short_description": "Step into Beatrect's Ray-Traced Rhythm World!\nVR's most accessible rhythm game meets stunning visuals. No complicated rules - just slash, feel the beat, and enjoy the spectacle!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/77792f91-721d-441d-b29d-c505a4e07e86", "developer_terms_of_service_url": "https://ash-tulip-d32.notion.site/EULA-23d1bd1f5fb34fc3a9b69f9d2f0f926c?pvs=4", "publisher_name": "Farseer Co., Ltd.", "support_website_url": null, "website_url": "https://ash-tulip-d32.notion.site/f794e58b49eb440fa2c8eda3faa76259", "category": "GAMES",
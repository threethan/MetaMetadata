.png", "id": "589284580859267", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499296201_589284584192600_795498279430422155_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u6rsRfdSwEwQ7kNvwFOdpkX&_nc_oc=Adp-OJH2QPwiOLRJmQl0ymINE0BHn8UROfQ1htNDVOy13t2fh-GexpIJ8V1NNd_xbbc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxzxjjEoiF12QS3-HiXBbouAGDCq671awZ-9XG4w-qSaw&oe=69C679C2"}, {"file_name": "SC-03.png", "id": "659369923804000", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499308032_659369927137333_4257157460587091099_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gGsdHjZfm1MQ7kNvwG8o-xT&_nc_oc=AdofMTzTyr9beiwrxqgpNMw9oxKqZLvDbyzCV2uz_Z0w1dz4mCWymigEfzLJ-YDV-Dw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxfw_WiuO0YOx8-wBTXjCVpc2Ue8eKERO4z7_3fHdj_yA&oe=69C6791E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YER_Meta-Store_16x9_LandscapeCover.png", "id": "4144151239157768", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491822821_4144151242491101_6383591024137165307_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jK0Iiklrke0Q7kNvwHY8zhy&_nc_oc=AdrSxMwF-nh4mDLICDr_X6KudPvZvoMop2lv4Vl5aXjuwu64utvMa0lBGIXXdSR-xhQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyp-YPWqR4-c1AC69X8W4U89xn5myCFkHBC2ywCYma5mw&oe=69C67E09"}, "display_name": "Grit and Valor - 1949", "keywords": ["mechs", "strategy", "roguelite", "war", "warfare"], "long_description": "**Strategic Warfare elevated for VR by nDreams\u2019 immersion experts.**\n\nEurope is on its knees.  Axis forces dominate the region, and only you stand as humanity\u2019s final hope. Command what remains of The Resistance in tactile, tense and thrilling strategic combat. Can you turn the tide of war? \n\n**Become the Commander**\n\nImmerse yourself as a General. Direct and oversee from above the battlefield \u2013 the drama and impact of every tactile movement and choice amplified. \n\n\n**Take Control of the Battlefield**\n\nDeploy your mech squad and command them in real time with gesture-controlled precision to fight off the escalating Axis threat. \n\n \n**Campaign for Victory**\n\nWage a full rogue-lite campaign across an immersive alt-history World War II era Europe. Regroup, upgrade your units, and redeploy! ", "short_description": "Strategic Warfare elevated for VR by nDreams\u2019 immersion experts. \n\nEurope is on its knees.  Axis forces dominate the region, and only you stand as humanity\u2019s final hope. Command what remains of The Resistance in tactile, tense and thrilling strategic combat. Can you turn the tide of war? "}]}, "developer_name": "Milky Tea", "developer_privacy_policy_url": "https://ndreams.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "nDreams", "support_website_url": null, "website_url": "https://ndreams.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8898724530241697"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "2171429910298293"}, {"status": "PUBLISHED", "id": "1214315216971095"}, {"status": "PUBLISHED", "id": "1854932335138980"}, {"status": "PUBLISHED", "id": "2607691066272343"}, {"status": "PUBLISHED", "id": "799713616135414"}, {"status": "PUBLISHED", "id": "819786070733231"}, {"status": "PUBLISHED", "id": "729958670
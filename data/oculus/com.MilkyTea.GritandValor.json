, "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825034_1131545215459521_9147685755596973331_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f9OU9AWijGEQ7kNvwGMHB3x&_nc_oc=AdktjoYLOqzxza6hfETVCh74C60-v62VXKayOOiPnx0A7DCndWrI5uN44Xkw6_MF-MI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsgcqoYW99DdfWMdmjy_LLitaPb4ewS46hJhIV6DK5mrg&oe=69A04A14"}, {"file_name": "YER_Launch-SC_05.png", "id": "961148682803852", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831382_961148686137185_3060973868392972049_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SXRNPcf7FyQQ7kNvwGasUhk&_nc_oc=AdmrPJrEBEMaPzilnfEzXiW4JOnFiFY_S5-DQZiwKo8WbubAJG_osfIRairOuc7-tLU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft7kH3Q3nHb0TgKwHXoBBgMtxVnr9FHWtMRReJ928GWAw&oe=69A05A44"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "G&V_Meta-Store_16x9_LandscapeCover (1).png", "id": "2370836459998145", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303790_2370836463331478_73769619978152443_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=41ClLJIlr9UQ7kNvwGYSomO&_nc_oc=AdnbynFJl9_Fjwunn5vyrN-mzDmiVUEal-rof76dTez7Y9WSx_AadtxGlcqg-z61gPc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfspVJ27GZQg-_2um26vTqcUb0Qdj1ZQ9G6a4g7uembGWg&oe=69A04947"}, "display_name": "Grit and Valor - 1949", "keywords": ["mechs", "roguelite", "war", "tactics", "history"], "long_description": "**Strategic Warfare elevated especially for VR.**\n\nEurope is on its knees.  Axis forces dominate the region, and only you stand as humanity\u2019s final hope. Command what remains of The Resistance in tactile, tense and thrilling strategic combat. Can you turn the tide of war? \n\n**Become the Commander**\n\nImmerse yourself as a General. Direct and oversee from above the battlefield \u2013 the drama and impact of every tactile movement and choice amplified. \n\n\n**Take Control of the Battlefield**\n\nDeploy your mech squad and command them in real time with gesture-controlled precision to fight off the escalating Axis threat. \n\n \n**Campaign for Victory**\n\nWage a full rogue-lite campaign across an immersive alt-history World War II era Europe. Regroup, upgrade your units, and redeploy! ", "short_description": "Strategic Warfare elevated especially for VR.\n\nEurope is on its knees.  Axis forces dominate the region, and only you stand as humanity\u2019s final hope. Command what remains of The Resistance in tactile, tense and thrilling strategic combat. Can you turn the tide of war? "}]}, "developer_name": "Milky Tea", "developer_privacy_policy_url": "https://ndreams.com/grit-valor-1949-vr-privacy-notice", "developer_terms_of_service_url": null, "publisher_name": "nDreams", "support_website_url": null, "website_url": "https://ndreams.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25440985418922347"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820887_1388242333308213_2966978131340299365_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-AOsqBHrNQMQ7kNvwG-GcKS&_nc_oc=Adm9Mm2AMdPVRqJNuf3IUyiLnxKGq4phjjnBncSt3hDQA3o6EjdbwimLyKi77CuCIKs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfshHgjSpDZ9j278ixW2VVZL0sBeeRM3xR8Wa_xbfquNvQ&oe=69A04EEC"}, "is_conce
7WNQ&oe=69BE9FFB"}, {"file_name": "YER_Launch-SC_02.png", "id": "1131545212126188", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825034_1131545215459521_9147685755596973331_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JzdvsBX27aMQ7kNvwFGUr6Z&_nc_oc=AdkHufZfW7p3ceIkUflUsVu_oHIKCsvKGSadi4Nx3T_9SB0SRNphbQqJD1J3DVy31Z4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx1YHwNxYRP19xc9lHxB0PlYt9dbuYsou5cyEKhuIJ3sA&oe=69BE9C94"}, {"file_name": "YER_Launch-SC_05.png", "id": "961148682803852", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491831382_961148686137185_3060973868392972049_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PrgISd8AHsIQ7kNvwHkPUl9&_nc_oc=Adn6ZgViqMalSiEgExCqFztAukpY08oDibZomsvdE5yKh0m8JqvOHpf59owyrV_X20Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfznAnihJgiPRHDG27es1EwELPmbyNeB15muv64CW8uWMQ&oe=69BEACC4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "G&V_Meta-Store_16x9_LandscapeCover (1).png", "id": "2370836459998145", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499303790_2370836463331478_73769619978152443_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VL_zKBu2BDEQ7kNvwHXsnyR&_nc_oc=AdmELW6WEFPytJS1Hqucmh9DhWKLPfZty3fDqFIXVeVuAX7UM-hmmw_1U5ieB4Crv28&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afysu4Mi-5WQAm4C_bbqRYHx2AWwXdkmv1Hn1MVZ7jCHxg&oe=69BE9BC7"}, "display_name": "Grit and Valor - 1949", "keywords": ["mechs", "roguelite", "war", "tactics", "history"], "long_description": "**Strategic Warfare elevated especially for VR.**\n\nEurope is on its knees.  Axis forces dominate the region, and only you stand as humanity\u2019s final hope. Command what remains of The Resistance in tactile, tense and thrilling strategic combat. Can you turn the tide of war? \n\n**Become the Commander**\n\nImmerse yourself as a General. Direct and oversee from above the battlefield \u2013 the drama and impact of every tactile movement and choice amplified. \n\n\n**Take Control of the Battlefield**\n\nDeploy your mech squad and command them in real time with gesture-controlled precision to fight off the escalating Axis threat. \n\n \n**Campaign for Victory**\n\nWage a full rogue-lite campaign across an immersive alt-history World War II era Europe. Regroup, upgrade your units, and redeploy! ", "short_description": "Strategic Warfare elevated especially for VR.\n\nEurope is on its knees.  Axis forces dominate the region, and only you stand as humanity\u2019s final hope. Command what remains of The Resistance in tactile, tense and thrilling strategic combat. Can you turn the tide of war? "}]}, "developer_name": "Milky Tea", "developer_privacy_policy_url": "https://ndreams.com/grit-valor-1949-vr-privacy-notice", "developer_terms_of_service_url": null, "publisher_name": "nDreams", "support_website_url": null, "website_url": "https://ndreams.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25440985418922347"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820887_1388242333308213_2966978131340299365_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VsCFWolgEJgQ7kNvwFlB8iB&_nc_oc=Adm6Hsodi1PJSkhv9fEkgPtZuBVhwLI0Qcn-hbZn7wzObOFgE7ATC41aVcwQUlGTPQs&_nc_zt=3&_nc_h
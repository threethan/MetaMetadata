mersive alt-history World War II era Europe. Regroup, upgrade your units, and redeploy! ", "short_description": "Strategic Warfare elevated for VR by nDreams\u2019 immersion experts. \n\nEurope is on its knees.  Axis forces dominate the region, and only you stand as humanity\u2019s final hope. Command what remains of The Resistance in tactile, tense and thrilling strategic combat. Can you turn the tide of war? "}]}, "developer_name": "Milky Tea", "developer_privacy_policy_url": "https://ndreams.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "nDreams", "support_website_url": null, "website_url": "https://ndreams.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8898724530241697"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "2171429910298293"}, {"status": "PUBLISHED", "id": "1214315216971095"}, {"status": "PUBLISHED", "id": "1854932335138980"}, {"status": "PUBLISHED", "id": "2607691066272343"}, {"status": "PUBLISHED", "id": "799713616135414"}, {"status": "PUBLISHED", "id": "819786070733231"}, {"status": "PUBLISHED", "id": "729958670053008"}, {"status": "PUBLISHED", "id": "824937416866567"}, {"status": "PUBLISHED", "id": "1105742731512023"}, {"status": "PUBLISHED", "id": "1106819151495224"}]}, "baseline_offer": {"id": "1106819151495224"}, "is_approved": true
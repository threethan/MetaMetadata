eLw&oe=69B959FB"}, {"file_name": "YER_Launch-SC_02.png", "id": "1131545212126188", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491825034_1131545215459521_9147685755596973331_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F8oVCcjIPfkQ7kNvwFpOuc9&_nc_oc=AdlhkkVrBKtL1mXLwm8TrAFrOsno7Sh1DTS5W5Xk2d6LGte5NIlTQe3kgUMENkQ-J8k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxzjOOS7CPsfqifC0W1lZsuIbLvNiSpB4KjCgaJqvOYGw&oe=69B95694"}, {"file_name": "YER_Launch-SC_05.png", "id": "961148682803852", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491831382_961148686137185_3060973868392972049_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VMUlldIsX_0Q7kNvwHnRLJH&_nc_oc=AdlTCuGeW4Bgza2I4zuFVaUWv-kKZbGHSOX0VWJdU9F2cjf0Z77RiBupMlU3Ss3l3d0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzX4QRwg12Ug36zvy2aNXazAK4Z_U12Iu5J4OK1x5kUJQ&oe=69B92E84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "G&V_Meta-Store_16x9_LandscapeCover (1).png", "id": "2370836459998145", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303790_2370836463331478_73769619978152443_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q0KV3LU8VxMQ7kNvwFHaaNV&_nc_oc=AdlN0llZeMGRJGIITeK__m2iEA3mFgZtOeek_8wzWdL8hKoti07OEgBpqzvTXRGdbdE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy6l7ysa7f7LZ5Xbx5Ihx6SKSUzz7SrH_3uZ4h2NkhxYQ&oe=69B955C7"}, "display_name": "Grit and Valor - 1949", "keywords": ["mechs", "roguelite", "war", "tactics", "history"], "long_description": "**Strategic Warfare elevated especially for VR.**\n\nEurope is on its knees.  Axis forces dominate the region, and only you stand as humanity\u2019s final hope. Command what remains of The Resistance in tactile, tense and thrilling strategic combat. Can you turn the tide of war? \n\n**Become the Commander**\n\nImmerse yourself as a General. Direct and oversee from above the battlefield \u2013 the drama and impact of every tactile movement and choice amplified. \n\n\n**Take Control of the Battlefield**\n\nDeploy your mech squad and command them in real time with gesture-controlled precision to fight off the escalating Axis threat. \n\n \n**Campaign for Victory**\n\nWage a full rogue-lite campaign across an immersive alt-history World War II era Europe. Regroup, upgrade your units, and redeploy! ", "short_description": "Strategic Warfare elevated especially for VR.\n\nEurope is on its knees.  Axis forces dominate the region, and only you stand as humanity\u2019s final hope. Command what remains of The Resistance in tactile, tense and thrilling strategic combat. Can you turn the tide of war? "}]}, "developer_name": "Milky Tea", "developer_privacy_policy_url": "https://ndreams.com/grit-valor-1949-vr-privacy-notice", "developer_terms_of_service_url": null, "publisher_name": "nDreams", "support_website_url": null, "website_url": "https://ndreams.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25440985418922347"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820887_1388242333308213_2966978131340299365_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D5tcAW2KRKIQ7kNvwH00w2q&_nc_oc=AdkaMCegn-wh1Ko48B936yB1b7yZckeNTSPH_hq6qGq9fGEoRJJfdrGBSEYJblDURjY&_nc_zt=3&_nc_ht
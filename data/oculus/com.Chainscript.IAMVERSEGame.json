7f20f&oh=00_AQTK56Qf87rM4MyfnPJ30CmB5eeverowoZQ-rWgdFjohZg&oe=6B0317AB"}, {"file_name": "GAME_SCREEN_04.png", "id": "2182310922621099", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821704_2182310925954432_3365547515231424833_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Kcq599vaAgQ7kNvwFPErwa&_nc_oc=Adp-q3LZror6dNPFDFvD-SqNVWJ9wLAOcPjHaokUxCeQ3Vs5PMSFwRPRW4scE_CuEwk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSL2EQ6H8-kpSz9eCM9MeVy_3zoGnFjNZ3O0gyHlY_Ikg&oe=6B0325B9"}, {"file_name": "GAME_SCREEN_02.png", "id": "1735843294099853", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499296077_1735843300766519_6132172453314039792_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KQBh85Ae5pkQ7kNvwGE7PUK&_nc_oc=Adpil2f5v18-jBKgXOElSgvbtLOzDSlun0AZlezLnYsBCuVTRYovs602Z1UfnUFsmQo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ09OrZBA8SxafVIwRalPLEfqXVdouVP1dU64spU9iezw&oe=6B0328E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverPic.png", "id": "1451449180070517", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499620965_1451449183403850_5862113772242311672_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fyNiUjSULEIQ7kNvwEGOpV5&_nc_oc=AdrmQ6e5HRk3GrKuozDMynwZl2Y8SGfenkZbu07JpDPr-VhA___FPxFPStmDtgRv_vE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKYWnyvElDin9zxtFHW5HHOsSh97gFHybtj5g1Ozu5xA&oe=6B032748"}, "display_name": "SPACES by IAMVERSE", "keywords": ["SPACES", "Metaverse", "spaces", "iamverse", "IAMVERSE"], "long_description": "SPACES by IAMVERSE is a social VR world where people come together to connect, unwind, and share unforgettable moments. It's a place built for belonging \u2014 somewhere you can step away from the everyday and enjoy the company of others, wherever they may be.\n\nMake it yours Design an avatar that feels like you, then watch it come to life with natural, expressive movement that makes every interaction feel warm and genuine.\n\nConversations that feel real Immersive voice makes every friend sound close enough to touch. Gather your circle, introduce yourself to a stranger, and watch acquaintances blossom into lasting friendships.\n\nAlways something to discover Play through a world of interactive experiences, enjoy shared screens and live shows with friends, or step into vibrant gatherings and events hosted across stunning virtual venues.\n\nA stage for everyone SPACES makes hosting effortless. Welcome your guests, take the spotlight, and create an atmosphere where everyone feels included.\n\nYour space to belong Meet new people, build your community, and create memories that last. Step inside and discover where SPACES will take you \u2014 your next friendship is only a moment away.", "short_description": "SPACES by IAMVERSE is a social VR world where people come together to connect, unwind, and share unforgettable\n  moments. Design an avatar that feels like you, then explore beautifully crafted spaces with immersive voice that makes\n  every friend feel close. Make new friends, enjoy interactive experiences and live events, and find your place in a\n  community that's whatever you make it. This is your space to belong."}]}, "developer_name": null, "developer_privacy_policy_url": "https://iamverse-lounge.web.app/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "iamverse", "support_website_url": null, "website_url": "https://iamverse.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "2687655338230691"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "re
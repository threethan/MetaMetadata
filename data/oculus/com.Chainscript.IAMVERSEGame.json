3365547515231424833_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mhp8ipyjHZUQ7kNvwF0csIT&_nc_oc=AdqrprgoqXqsiVl3hgbJIdRo1edNIvCmvnJsKPvUDJl-0mo4v0s2v1vOF_rkpzWXUTQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-lXz2ZwJZNt9p593HlyojHz-jQMVMKo-8Y9hOEAeFZhg&oe=6A4666F9"}, {"file_name": "GAME_SCREEN_02.png", "id": "1735843294099853", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499296077_1735843300766519_6132172453314039792_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UcLOHh5mh1gQ7kNvwFGS9re&_nc_oc=AdqSppPGOCx5MVj6AFrRFXtnbKLnjd7FuO5JLIKGsNrz6rVEDEIQllkMK94H2Y0tJzs&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rlHn2GERdCRvgoYdQy1kUJYTomhw9pUei-7umbMRhwA&oe=6A466A29"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverPic.png", "id": "1451449180070517", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499620965_1451449183403850_5862113772242311672_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TbtXCODNMtAQ7kNvwExaVNq&_nc_oc=AdpOdyDYO0VEIAh5HQwutYhJh7DqrGBeGNcc0RMVnXpGf15sgWJovXBTyD9x9B7BG1A&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_UZ8t4er6wraWstGkaEXXf-otSmGQGfNtsSizwvIQN1w&oe=6A466888"}, "display_name": "SPACES by IAMVERSE", "keywords": ["SPACES", "Metaverse", "spaces", "iamverse", "IAMVERSE"], "long_description": "SPACES by IAMVERSE is a social VR world where people come together to connect, unwind, and share unforgettable moments. It's a place built for belonging \u2014 somewhere you can step away from the everyday and enjoy the company of others, wherever they may be.\n\nMake it yours Design an avatar that feels like you, then watch it come to life with natural, expressive movement that makes every interaction feel warm and genuine.\n\nConversations that feel real Immersive voice makes every friend sound close enough to touch. Gather your circle, introduce yourself to a stranger, and watch acquaintances blossom into lasting friendships.\n\nAlways something to discover Play through a world of interactive experiences, enjoy shared screens and live shows with friends, or step into vibrant gatherings and events hosted across stunning virtual venues.\n\nA stage for everyone SPACES makes hosting effortless. Welcome your guests, take the spotlight, and create an atmosphere where everyone feels included.\n\nYour space to belong Meet new people, build your community, and create memories that last. Step inside and discover where SPACES will take you \u2014 your next friendship is only a moment away.", "short_description": "SPACES by IAMVERSE is a social VR world where people come together to connect, unwind, and share unforgettable\n  moments. Design an avatar that feels like you, then explore beautifully crafted spaces with immersive voice that makes\n  every friend feel close. Make new friends, enjoy interactive experiences and live events, and find your place in a\n  community that's whatever you make it. This is your space to belong."}]}, "developer_name": null, "developer_privacy_policy_url": "https://iamverse-lounge.web.app/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "iamverse", "support_website_url": null, "website_url": "https://iamverse.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "2687655338230691"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "26478000285208265"}, "review_messages": []}]}, "cov
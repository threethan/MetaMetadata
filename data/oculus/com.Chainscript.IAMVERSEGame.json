31424833_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TErvmDnE6uYQ7kNvwHB1aSN&_nc_oc=Adojnsrxbr7-BU8VoLK7XUY2G2sDX3vQkRrH69CGWzPf6pUEcdf7RjTfXYPUE6uxTgM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJsr-M3b2poI_m0lXJlH2ligCpf8n-bGuHamaLHxpJwFA&oe=6AB91979"}, {"file_name": "GAME_SCREEN_02.png", "id": "1735843294099853", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499296077_1735843300766519_6132172453314039792_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rkgIVYI919cQ7kNvwHl3Sat&_nc_oc=AdqlKFBTkN5C8aYNo19vpQ57zHSAtMWqK22d_9tk8JILqFHofXjvJafSW_R7LfQIktE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4DvjKHA5yg_TNKV5LTe0AwjNqMSrguYfdunb3Bxtt3A&oe=6AB91CA9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverPic.png", "id": "1451449180070517", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620965_1451449183403850_5862113772242311672_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wRbXhGUL8YoQ7kNvwFq5pxb&_nc_oc=AdofG4wrv_72exZK79LpmAAALfAOLrSgyiU4pMp37CH_8RlkOteJcNOy1lRS_CoxzdU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLAfdBSrFXsWbT4JOzcl2FTJ-SnLXSwKIgL-s3kxixILg&oe=6AB91B08"}, "display_name": "SPACES by IAMVERSE", "keywords": ["SPACES", "Metaverse", "spaces", "iamverse", "IAMVERSE"], "long_description": "SPACES by IAMVERSE is a social VR world where people come together to connect, unwind, and share unforgettable moments. It's a place built for belonging \u2014 somewhere you can step away from the everyday and enjoy the company of others, wherever they may be.\n\nMake it yours Design an avatar that feels like you, then watch it come to life with natural, expressive movement that makes every interaction feel warm and genuine.\n\nConversations that feel real Immersive voice makes every friend sound close enough to touch. Gather your circle, introduce yourself to a stranger, and watch acquaintances blossom into lasting friendships.\n\nAlways something to discover Play through a world of interactive experiences, enjoy shared screens and live shows with friends, or step into vibrant gatherings and events hosted across stunning virtual venues.\n\nA stage for everyone SPACES makes hosting effortless. Welcome your guests, take the spotlight, and create an atmosphere where everyone feels included.\n\nYour space to belong Meet new people, build your community, and create memories that last. Step inside and discover where SPACES will take you \u2014 your next friendship is only a moment away.", "short_description": "SPACES by IAMVERSE is a social VR world where people come together to connect, unwind, and share unforgettable\n  moments. Design an avatar that feels like you, then explore beautifully crafted spaces with immersive voice that makes\n  every friend feel close. Make new friends, enjoy interactive experiences and live events, and find your place in a\n  community that's whatever you make it. This is your space to belong."}]}, "developer_name": null, "developer_privacy_policy_url": "https://iamverse-lounge.web.app/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "iamverse", "support_website_url": null, "website_url": "https://iamverse.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "2687655338230691"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "26478000285208265"}, "review_messages": []}]}, "cover_square_imag
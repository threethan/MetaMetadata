40.png", "id": "932849252464674", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499312470_932849255798007_6368816679821979047_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kFtbQm5NQr8Q7kNvwGh280c&_nc_oc=AdpcrcfTybTKkjAZed2nbH4jtH7Tl3lHZCRGu4zaLDCX4MTysiAXUN_XcV2F1Jfet_o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2TrgN_ZEWrqJcQYxPfig10Jf86-lt2QjFdwn2KRtPzdQ&oe=69DE5201"}]}, "id": "1524517359024061", "locale": "en_US", "screenshots": [{"file_name": "com.oculus5.png", "id": "3508791989296538", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499296119_3508791992629871_6494764766455520998_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HifYPEbi9hIQ7kNvwENBx-q&_nc_oc=AdorBKrhde-G7iMMmT0ViDvww6gkkKDRn34Jmcq5jL84XEXq6s6u-2UcHCBo6SZNmGo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3DStHrW7pc1Ta_P5KEmwkJA3qVAkqTYOwhB6E0hdEgwA&oe=69DE20F6"}, {"file_name": "com.oculus1.png", "id": "784464054714070", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499304938_784464058047403_1497329369777874963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cSNAmOiWU1sQ7kNvwF1y-pu&_nc_oc=AdryirOaowMumzWxUvNrrteF-MNxz58S2vjDcHctFzRRkKigYqIX_NzyF_Me35wbfxg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1mK4UVwm7wPALVXwrE_CK7afhrRvaUKkojomRyWT10_w&oe=69DE2676"}, {"file_name": "com.oculus3.png", "id": "1316921843546005", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499314643_1316921846879338_8860181415630945780_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UfIZA4qS2esQ7kNvwGVi_-P&_nc_oc=AdpgjQguQx7GOH6fv4HfS6I5D0OhmYvPRThDG5FiTPS83EwrzBQsnvjlt9dwGJV349M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Sv6-XOUKDGbICieZVh_w0gKEnUupQTZ2p2yxcvJLXlw&oe=69DE40D0"}, {"file_name": "com.oculus4.png", "id": "2065532447396766", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619145_2065532450730099_2258452130075315932_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5PCvDnhknK0Q7kNvwHZy78Z&_nc_oc=AdqxYkcccQLZdfDVrmK_bc0wVYo9wjRvMe4STL_gZDoMNzNZZ9cLkXA7ozKH1AZCr5Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af22mSjBLSDQ5m1OaEGZL4PdYMP1pToRw2VVjTxON5sZwQ&oe=69DE3B72"}, {"file_name": "com.oculus8.png", "id": "1456711675908615", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307339_1456711679241948_4217900797853834121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aGzwD_5x-McQ7kNvwExPEx4&_nc_oc=Adoe6Zwg3iZ3JCwREwad8nVzqI-2HOJbWmuud1J5qcK2rP7bym3C5XbSWZQGFQicGGc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1SxH0OV0ayKlckxHc_n7ppC4u8f7Hqj7YFpfTDQ4Fm_Q&oe=69DE54CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ba_dressup2560x1440.png", "id": "26349569391342780", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499303679_26349569401342779_3388996635250212912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l1e6c8KAQuoQ7kNvwHc5ITR&_nc_oc=AdoPQC7ApidK4tEJwp96FDBZPnnQ7KHM1e4nCPB8uGxeLgqFD2s-uXwyiOhvcV2bsN4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1TTY5MddVlhbdtK0Gf2R2MlcZSUlIw3wJzhWZv1-Sf9g&oe=69DE4C9C"}, "display_name": "Baby Adopter Dress Up", "keywords": ["babysitter", "dressup", "toddler", "nanny", "nursery"], "long_description": "Baby Adopter Dress Up is a babysitting and dress-up game where you take care of a child and watch him grow. \n\nEarn points by feeding and caring for your baby, going on egg hunts, and playing mini-games. Use those points to buy clothes, shoes, hats, toys, and decorations for different locations in the game.\n\nBaby Viewer lets you see your baby in full 3D. You can orbit and rotate the character in all directions with the controller and play animations such as idle, look around, walk, run, dance and gym exercise.\n\nDress up your baby with adorable costumes, including clothes, shoes, and hats. \n\nTake care of your baby by keeping him happy and healthy. Feed him when he is hungry, keep his energy above 30, and make sure he does not get sick.\n\nEarn and spend points as you play. Regular points can be used to buy items for the Baby Room, Bathroom, Playcenter, Summer, and Winter locations. Karma points track your experience and always accumulate, showing your long-term progress.\n\nGo on egg hunts in different locations and look for hidden eggs. Crack them open to hatch mini trophy creatures and work toward completing your collection.\n\nPlay the Egg Match mini-game, a classic match-3 puzzle where you swap eggs to form matches. Clear levels, score points, and earn extra points that can be spent back in the main game. You can also take a break with the Free Cell solitaire mini-game and earn additional points.", "short_description": "Baby Adopter Dress Up is a babysitting and dress-up game where you take care of a child, earn points, and spend them on clothes, toys, and room decorations. Feed your baby, keep his energy up, go on egg hunts. \n\nPlay the Egg Match mini-game and the Free Cell solitaire mini-game to earn extra points.\n\nBaby Viewer lets you see your baby in full 3D. You can orbit and rotate the character in all directions with the controller and play animations such as idle,  walk, run, dance and gym exercise."}]}, "developer_name": null, "developer_privacy_policy_url": "https://s3.amazonaws.com/generic.x2line.com/legal/privacy_policy_fb_badressup.html", "developer_terms_of_service_url": null, "publisher_name": "x2line", "support_website_url": "https://dboards.x2line.com/cat/baby-adopter-dress-up-feedback-support/", "website_url": "http://milkybaby.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "RE
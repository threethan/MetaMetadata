culuscdn.com/v/t64.5771-25/12504844_2105733453025313_8936161732615733248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rz1pvtqqds8Q7kNvwECq7fu&_nc_oc=AdoOugjM9HPzuet7d9cwKs9DAFBjDp_VIFPHzG0HWdqaRrYpoBIegPra1K5KjjHMTbc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1kZWn5LhBlVZaGjiL1eKnzfEyxcEVEt6ZPAx0pkYsoZA&oe=69F0C904"}, {"file_name": "migrated_image.png", "id": "570200873580495", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12504684_1830772370552289_7764688889867927552_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rOhTiHYU1ggQ7kNvwG2Yl8r&_nc_oc=AdrJACSMJes90X0X-_JVAega0MFmvNIoT41BuuOTM0WgDmUXM0KDoJ1tlwfRGyjO5QY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3wxJqxPvot6DedCExWGYH8fTeDGsZL5hWjMS0uRMb29Q&oe=69F0B05B"}, {"file_name": "migrated_image.png", "id": "529110084653372", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427628_2018543371727636_1353766519103815680_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C_JMhwQSj9oQ7kNvwHIhyWr&_nc_oc=AdqN9ddGpYunAa55KURbl0FNxUupci1CqgDl5cIqEyIHfTRD7lw-WcfahLdDMBPVLzQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2G4HuZhrAcc0Sv5cI75_MQHvII6GIn3vcuw9vyvMO07g&oe=69F0B0A6"}, {"file_name": "migrated_image.png", "id": "336715987294365", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12680484_548941498839373_7170827356737634304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RTByyMa04Q0Q7kNvwGYUfdP&_nc_oc=AdrUfJ_HCowv-L20_-Aa0RgfCQM2Z-wOlWKMbsAJwpFyYm-qgMj5jchz5KGud8YfyRk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0LP0RTFLxKex4knuFTpWIqIT3hdGM04OjQUsEXib3eHg&oe=69F0D167"}, {"file_name": "migrated_image.png", "id": "234957094297374", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12138999_175673583092453_2324535449915228160_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9GcQaRljcp4Q7kNvwEP1zCY&_nc_oc=AdokrZ-YqCTkE1zstZzlFkSaDxtnG5mqNhAAn35H_5ItouQAmaa-ptdiBAqKlWMp4wE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3N6EbjANUiDypl0kkFN-YWhA7m6kLQ3qE-phzshE7lBQ&oe=69F09D45"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Overflight", "keywords": ["plane", "dogfighter", "shooting", "simulator", "simulation"], "long_description": "Unveil the truth about unknown heroes fighting in the aftermath of World War II.\n\nThe war is finally over. Skilled pilots looking for new occupation have spread all over the world. You are one of them, a mercenary, smuggling a mysterious package for an unknown, powerful client. Things go south when you realize that the package contains fake documents for fleeing Nazis. \n\nOverflight Campaign will take you to the uncharted lands of South America to engage in a conflict that can define the final results of World War II. Immerse yourself in a unique story-driven VR experience with fully-fledged characters, intense dogfighting action and take part in the most breathtaking missions ever encountered on Mobile VR.\n\nAfter you save the world, enjoy Overflight for hours in the multiplayer mode. Here, the game changes into a semi-realistic VR dogfight with dynamic action and constant adrenaline rush. Play with your friends or challenge the community! \n\nSee you in the skies of Overflight!", "short_description": "Unveil the truth about unknown heroes fighting in the aftermath of World War II.\n\nThe war is finally over. Skilled pilots looking for new occupation have spread all over the world. You are one of them, a mercenary, smuggling a mysterious package for an unknown, powerful client. Things go south when you realize that the package contains fake documents for fleeing Nazis."}]}, "developer_name": "Gamedust", "developer_privacy_policy_url": "https://gamedust.co/news/privacy", "developer_terms_of_service_url": "https://gamedust.co/news/privacy", "publisher_name": "Gamedust Sp. z o.o.", "support_website_url": null, "website_url": "http://gamedust.co/overflight", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [
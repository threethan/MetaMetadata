scdn.com/v/t64.5771-25/38974721_421370969418490_2901128242355584_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fjMJJcm5Wl8Q7kNvwEaDilz&_nc_oc=Adp69mRR6oeiySm3OP1Wov4hcXcFn8f7vz3uHB_SXALjdzBASlogzPwW4gdcXRHddZ0&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4MKOgmuZR54uxmkCZSlupEOpYMINsPw43WHTZoUqRvTQ&oe=6A11B523"}, {"file_name": "(2).png", "id": "2946906865573502", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/227853519_2946906868906835_123201454245605538_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CPWUkPPDD-8Q7kNvwEFORsI&_nc_oc=AdrVPZh7bmCPmYKIS0uuqzve3cgiu0Tck58iE6b5AygN8tePUEGWX4SDYMtY_d_Jsc4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4UPqcrL3GXq0md8N77T_rqTIqZAs4Y3sr_mXejuvs0Rw&oe=6A11C948"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\uba54\uc778(\uc2dc\uc5482)2560_1440(211006).png", "id": "206259781628339", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75223477_206259791628338_3302313964703222542_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ptsDcojCiEQ7kNvwF6awXx&_nc_oc=AdoGHEmMS0jMynOvAuaGRgqNBfSxKxLwbMmFe5Ie3_Ai7LJ7G0iRlS7sGytZRJRsusA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6LOGSX-RNkjNOcj5JELAuIWzdLkwqNECW6Il4QiuS47Q&oe=6A11C9E6"}, "display_name": "The Client VR", "keywords": [], "long_description": "Save the slippers that are hanging in the maze of nightmares!\n\nAs you watch the maze,\nHe opened the way for them and knocked down a scary daemon.\nIt can help slippers get out of nightmares!\n\nKeep that in mind!\nSlippers sometimes get lost and sometimes stubborn as they learn how to walk.\nBut you'll be able to save all the slippers.\n\nA new concept of shooting puzzle game.\nIt is a shooting puzzle game that makes a way for AI characters wandering in a maze to move easily and safely.\n\n100 stages with various solutions.\nVarious maze shapes, slippers, objects, and daemons are combined, so each stage can be played differently each time.", "short_description": "Save the slippers that are hanging in the maze of nightmares!"}, {"images": {"nodes": [{"file_name": "\uba54\uc778(\uc2dc\uc5482)2560_1440(211029) \ud55c\uae00.png", "id": "627571058261409", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39036641_627571061594742_7128199620299863828_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q05UKXJZubYQ7kNvwHDP3uy&_nc_oc=AdoVuKhAEKMwylqIxeZX9bNbja2FmS-DnUUcscUV35mDs-CzaAvZAQvTkYwfMhF9A3M&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7KnWSkqAMn7-aKgHZ73FnkpHDdDVso6kUrqxuA5obPFA&oe=6A11AA07"}, {"file_name": "\ub85c\uace0(\ud55c\uae00).png", "id": "411411503991020", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/57568668_411411507324353_7968572270249004873_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zNt63hv5hRkQ7kNvwGajqNX&_nc_oc=Adom3xPNDOFo-5Y1FR4fKPgUsSCWl-aw9jAoKSy6BzX4gZ23LCjEyII16SEENvg-WRE&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4z5JR2K22ndSYMMd18nod-vYr3ha8hND2kEsSJLq2jug&oe=6A11BBE9"}, {"file_name": "\uba54\uc778(\uc2dc\uc5482)3000_900(211029) \ud55c\uae00.png", "id": "301964841514935", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39035322_301964844848268_3664860775004227112_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KC4KgLdtpfoQ7kNvwF8C7rb&_nc_oc=Ado6krMCzMDn8G_kHe3CROVENNr3hovw3dE2XNgOYFX43ImUtANllQDzgifN3O_qcww&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4aqaRm4Yp-RO-kBtrSirCxYqp796cM26ujqJ4HG7op3g&oe=6A119EDC"}, {"file_name": "\uba54\uc778(2)1440_1440(211029) \ud55c\uae00.png", "id": "843670026323221", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974680_843670029656554_4170918606599011011_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9BFLsZv42IsQ7kNvwFBZp39&_nc_oc=AdoDtZ_L95RiD9ycLz7-Av
scdn.com/v/t64.5771-25/38974721_421370969418490_2901128242355584_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bdLsNVkmkSsQ7kNvwEXaoK2&_nc_oc=AdpFn7t-kPQa0KN5BABl_mfn_dtoua5hhkO4N2LI8II2Z-cydaJcuusyfUuq5TgS0JY&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9h4ad8nGdoT43SMMG_KmzcOqbVNwV9rR7kTIA0I6PMCg&oe=6A394223"}, {"file_name": "(2).png", "id": "2946906865573502", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/227853519_2946906868906835_123201454245605538_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QGdvYeaXuFIQ7kNvwHVBhI6&_nc_oc=Ado-M3UiGglfNskJa0fnCTnPWkmN7Ab7m45FuM9TOsHa2m_6EdFIvs7MgSkfK_ImdKA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jgTnqo_KsZ5dJLlqzwi6xlMdW5DNy5JrULGkukrWgqA&oe=6A395648"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\uba54\uc778(\uc2dc\uc5482)2560_1440(211006).png", "id": "206259781628339", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75223477_206259791628338_3302313964703222542_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lNHzATJtbRkQ7kNvwETKEDx&_nc_oc=AdrvkhzDaTWxqbimxyTwT7Xg9jxHDHgMgwW_2sW64_jKQRTBkD5caZS9L1rVYkGnj2A&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9TZXElLZOcRLIt6HOO7s8o45OVRHtMWpseQyPPoP9hhg&oe=6A3956E6"}, "display_name": "The Client VR", "keywords": [], "long_description": "Save the slippers that are hanging in the maze of nightmares!\n\nAs you watch the maze,\nHe opened the way for them and knocked down a scary daemon.\nIt can help slippers get out of nightmares!\n\nKeep that in mind!\nSlippers sometimes get lost and sometimes stubborn as they learn how to walk.\nBut you'll be able to save all the slippers.\n\nA new concept of shooting puzzle game.\nIt is a shooting puzzle game that makes a way for AI characters wandering in a maze to move easily and safely.\n\n100 stages with various solutions.\nVarious maze shapes, slippers, objects, and daemons are combined, so each stage can be played differently each time.", "short_description": "Save the slippers that are hanging in the maze of nightmares!"}, {"images": {"nodes": [{"file_name": "\uba54\uc778(\uc2dc\uc5482)2560_1440(211029) \ud55c\uae00.png", "id": "627571058261409", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39036641_627571061594742_7128199620299863828_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mj44zsOYKAEQ7kNvwGZXk_g&_nc_oc=Adon24yXhspCtVaXJtWX2Y1scnNWXC0zbJtSDaNBfbDQvT5DTOzzZaUUK4YgREEuI1Y&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ZR6oj_yH6IB3PK4UQBPTUJn2DeUAeIpGjPDiseTA-qA&oe=6A393707"}, {"file_name": "\ub85c\uace0(\ud55c\uae00).png", "id": "411411503991020", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/57568668_411411507324353_7968572270249004873_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eo1jZJybI3kQ7kNvwFkEahY&_nc_oc=AdobXMBtZr4ODoPK0JCdSmjXw66oRMfpZLmP_sol_aGpD-1ZtMNP_tHql2MRhFOLA2E&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8217Fe_2yhE-KOssORBRq3-AfWQR5mLdJCuQRgbSkwQ&oe=6A3948E9"}, {"file_name": "\uba54\uc778(\uc2dc\uc5482)3000_900(211029) \ud55c\uae00.png", "id": "301964841514935", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39035322_301964844848268_3664860775004227112_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1x-dTwZq1zwQ7kNvwF1irjr&_nc_oc=AdrylamaQqJG72c4SvLNRrjmkkRMo_8kuurTTGRd4ol9W-i1IeHL_ryZly-t9nQGhQA&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8jomcHxudd4Qr8qK11fje-7051I3PIT1MQ3noOd32lSg&oe=6A392BDC"}, {"file_name": "\uba54\uc778(2)1440_1440(211029) \ud55c\uae00.png", "id": "843670026323221", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974680_843670029656554_4170918606599011011_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pfuag76YZDcQ7kNvwFx3WnW&_nc_oc=AdpIqbrARkWUfDhHSbCs3G
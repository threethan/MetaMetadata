scdn.com/v/t64.5771-25/38974721_421370969418490_2901128242355584_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XFmQhOs5u_cQ7kNvwEVTvgM&_nc_oc=Adqs_Au9lFd9uKjDuq806Jrt-S6sMzzzUAnjZdWh8ElVQ68ke5jlzjw5HuTlGtN3OFo&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKykvbHeoBeMzYjeF-7dd1kuS1LGujjWsHRx1aiVGHCyQ&oe=6AAE97A3"}, {"file_name": "(2).png", "id": "2946906865573502", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/227853519_2946906868906835_123201454245605538_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LscIR8Ib_3MQ7kNvwElkqT_&_nc_oc=AdrepxwuyE19iNsUST5-0Q6-qNGjfVgdYA-fu95NGhBGKNQgPx-3_HVb8kEud8swOZw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIyWkP0zUSRipjPya_UB-Rs9WTp7elXv9I4xKVHPwog0Q&oe=6AAEABC8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\uba54\uc778(\uc2dc\uc5482)2560_1440(211006).png", "id": "206259781628339", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75223477_206259791628338_3302313964703222542_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4_XZya0ssncQ7kNvwHe17d3&_nc_oc=AdoXso9b6cQRYAFA5LQfelzS8gLS4_rDhpbHZ552i8O7tnntgCtxCfRXBmPG2PVAkU4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQiGgbOT3CtvwiQ3viOZluq2Y5G0wf67A0KhLxWgqCZQ&oe=6AAEAC66"}, "display_name": "The Client VR", "keywords": [], "long_description": "Save the slippers that are hanging in the maze of nightmares!\n\nAs you watch the maze,\nHe opened the way for them and knocked down a scary daemon.\nIt can help slippers get out of nightmares!\n\nKeep that in mind!\nSlippers sometimes get lost and sometimes stubborn as they learn how to walk.\nBut you'll be able to save all the slippers.\n\nA new concept of shooting puzzle game.\nIt is a shooting puzzle game that makes a way for AI characters wandering in a maze to move easily and safely.\n\n100 stages with various solutions.\nVarious maze shapes, slippers, objects, and daemons are combined, so each stage can be played differently each time.", "short_description": "Save the slippers that are hanging in the maze of nightmares!"}, {"images": {"nodes": [{"file_name": "\uba54\uc778(\uc2dc\uc5482)2560_1440(211029) \ud55c\uae00.png", "id": "627571058261409", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39036641_627571061594742_7128199620299863828_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PVzXfQV4wHoQ7kNvwEDzGEe&_nc_oc=AdqdokGF2Fo_F2KKkyUkR1idbSkIuL6Q_HEX5qWleyK74V6IUoReHQ-gDU4bcK3YnYg&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLGraAOxG1npod4aJaBLiBHZIVxKdiO6LP0thO7x_-scA&oe=6AAE8C87"}, {"file_name": "\ub85c\uace0(\ud55c\uae00).png", "id": "411411503991020", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/57568668_411411507324353_7968572270249004873_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wFolynmN-Q4Q7kNvwGxzGnN&_nc_oc=AdplUIDUDXgrJMtriV2nvwIM48tvoCKAS_yNAvOcluU15d8DFKQ-503QfLRCafzuNh4&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKiuvRA2u1Xs63R6BtgFDGIQUfjsh_VAO-zRWQI7TP8nA&oe=6AAE9E69"}, {"file_name": "\uba54\uc778(\uc2dc\uc5482)3000_900(211029) \ud55c\uae00.png", "id": "301964841514935", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39035322_301964844848268_3664860775004227112_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=82ymaQNYhAYQ7kNvwGhJgHl&_nc_oc=AdoXu78-o1Uak7YwQWZfKEns4g33d5St0pdTyDJuhPG_juqJnIOaYWSxL-r_TO8HaHI&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYgkd1GwyoAIsSXJADKuxxQFvsrlk1dhKg6qMUpjFz3A&oe=6AAE815C"}, {"file_name": "\uba54\uc778(2)1440_1440(211029) \ud55c\uae00.png", "id": "843670026323221", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974680_843670029656554_4170918606599011011_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EwwOO01V_WEQ7kNvwFfIJye&_nc_oc=AdrmY_ryfiWJpvHmtOo1H1
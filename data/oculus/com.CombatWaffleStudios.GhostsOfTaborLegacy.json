586663_2386554115829803553_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mp2fy_pbHKQQ7kNvwFE7kdD&_nc_oc=AdpVOOcc7bB7Q1R-e8yS9Lk2QrkHDwKuwdxXVdPMDBXwFx9yLcW6NUQfYyibES-qRnY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPitVy9yCkkKPJUT-Y9XxBUxJZKofPwkpz6TCBg8Vq32g&oe=6ADCAA96"}, {"file_name": "12212.png", "id": "1525968011718042", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499622315_1525968015051375_630714522916242374_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b2WRaihGve8Q7kNvwE7AKdQ&_nc_oc=Adp0M776RBr4pkHCfAV9eFmDpuuYD9jLUCngpgAoIFjWptNkAybE8Fxzc8dk6HdxJyI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNz5b5lxdOwDPlZGQfQuMKa5GEx4ggQzizNpE2LLzQUiA&oe=6ADCCC14"}, {"file_name": "GoTMissileSilo (9).png", "id": "1324683365934457", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499620940_1324683369267790_7995430138841428275_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LOsmNzc5UDoQ7kNvwHwLgef&_nc_oc=AdpyldE5Z4I_6O0Cta7_PMPS_KGwiuwT0AgCWO6GHUD1Wxk8NNrR-v6LcVmMPRy6y1M&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOdCRyp_D-Nxw5iLBzEMUO4zzk6hFAGN4sJgHDDptR4pw&oe=6ADCB0D2"}, {"file_name": "75305882_720001616268708_3198313962964790066_n.png", "id": "1022980810275064", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619078_1022980816941730_6287858543691211342_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ocyeu_rtrfQQ7kNvwFLYt77&_nc_oc=Adr6lAjjESFGAdA-ybwiy51yuXClYYnbvdPVW05nDBW68P9-6Dxk9gMfWkeb6BtOec0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN9jN5AAG0cAB5Tg3OkB1QUuiNHaQIOOiaWgW_O265x3w&oe=6ADCCC1A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2491826437947344", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499620504_2491826441280677_3578900409130550168_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iTWcnhemuJQQ7kNvwFBcBnq&_nc_oc=AdpgJp3w2PwmqEg8y1bCMRDrMGlUQOPahOjpx3RffQGg_mgd1N-498jv4IDG222YkyE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPnM52clclYXYO8VlkZaSilSJUcIgcXFtglF04d54B3gg&oe=6ADCD093"}, "display_name": "Ghosts of Tabor: LEGACY", "keywords": [], "long_description": "# GHOSTS OF TABOR: LEGACY\n\n**You remember 2024. So do we.**\n\nGhosts of Tabor: Legacy is the 2024 version of the game, preserved for the players who were there for it. The maps you mastered. The feel you remember. This is your raid, the way it used to feel.\n\n## The Extraction You Remember\nA hardcore, VR-only extraction survival shooter where your wits and whatever you can carry keep you alive. Scavenge for gear, weapons, ammo and supplies, then fight your way out with your loot intact. PvPvE. Squad up or go it alone. Reaching extraction is all that counts.\n\n## The Maps You Know by Heart\n**Old Island** in its original form. The **Hex Bunker**. **Silo**. **Matka Miest** and its streets. The ground a generation of raiders cut their teeth on, right where you left it.\n\n## The Legacy Systems\nExactly as they ran in 2024:\n- **Backpacks with item collision:** physical bags where every item takes up real space.\n- **Neck snapping:** the close-quarters takedown the way it played back then.\n- **NPC behavior:** the AI you learned to read, flank, and outsmart.\n- **Damage system:** the original time-to-kill and damage model.\n\n## A Time Capsule, Kept Running\nLegacy will be **maintained** but will **not** receive new content. No new maps, no reworks. It's a snapshot of a moment in time, held there for the players who want to step back into it any time.\n\n**Welcome back to Tabor. It's just like you left it.**", "short_description": "Ghosts of Tabor: Legacy. The 2024 era, preserved exactly as you remember it. A brutal VR extraction shooter where every raid is a gamble and trust gets you killed. Scavenge, fight, extract. Make it out with your gear, or lose everything."}]}, "developer_name": "Combat Waffle Studios", 
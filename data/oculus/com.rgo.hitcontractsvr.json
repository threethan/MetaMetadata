m/v/t64.5771-25/39035434_753733695873749_802914084157609370_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CvDi_kdlY3wQ7kNvwFL2dth&_nc_oc=Adly6m7qYyuSgih95b-uRXmiuiIHEJ_nE4fLxytEeNwURWrsL7WvWiNxp88EN68V9QM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftFbcKGQS1UxOAVE-ejzzwub-pU2BNBntLcnwe79Oma5A&oe=699AF858"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "hit contracts logo.png", "id": "1362240134266160", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75330714_1362240137599493_6542733622171587273_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fc2857t3vHQQ7kNvwEldei3&_nc_oc=AdnGmrv6cAjYl1VJwRX5gsQkzceVXvPPduGJWhfl-iBEGpHDNAK4-7QiBB0nMxgI_ko&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aftw6BhGgH8YTYDG9DpFiQvO8xTo4Qt7zdrpLf6zRH5nTw&oe=699B0A07"}, "display_name": "Hit Contracts VR", "keywords": [], "long_description": "With the help of cutting edge physics, full-body kinematics this game lets you immerse yourself in to the role of a assassin for hire. You can either play in melee mode or regular mode. All the AI are active ragdoll you can punch, shoot, grab etc. There is also aim trainer in this game which can help you improve your aim in this game.\n\nThere are variety of weapons available in this game like bow, knife, guns, crowbar etc. Do you have what it takes to be the best assassin in the world?.", "short_description": "Hit Contracts VR is a action filled first person shooter that lets players take the role of a assasin and undertake missions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realitygamesonline.net/HitContracts/PrivacyPolicy.txt", "developer_terms_of_service_url": null, "publisher_name": "Reality Games Online", "support_website_url": null, "website_url": "https://realitygamesonline.net/HitContracts", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "37
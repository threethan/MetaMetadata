pRs7pmx4_A8V_Qvw1YekHB8P9b1IaGg&oe=6A4A7200"}, {"file_name": "hit contracts 3png.png", "id": "753733692540416", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035434_753733695873749_802914084157609370_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LzW8QDnXM5IQ7kNvwH6JJTo&_nc_oc=AdqIykHaxP7aRf0N7v976ed6w1ZpLB2E3LiHPBTiw4A1-DgOA5yJD5N2HqYJRWVUrRw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAzn2-t4SWVpR-WDqL5LzOJdtrI0uipX51_4lQLXnc2Xg&oe=6A4A4FD8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "hit contracts logo.png", "id": "1362240134266160", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75330714_1362240137599493_6542733622171587273_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GwJQDVD-ZUYQ7kNvwHVtbJ7&_nc_oc=AdrKqOB6k1y-anwEEGq6TVCDOdbHBtkhdFL20EO_ErTH-jS4BBUgU8Y-hlMWjwlNSeU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCcGtW2A4iNU_YUSqdtXoqyNiL0Bvtwos0D9snKf1xtxQ&oe=6A4A6187"}, "display_name": "Hit Contracts VR", "keywords": [], "long_description": "With the help of cutting edge physics, full-body kinematics this game lets you immerse yourself in to the role of a assassin for hire. You can either play in melee mode or regular mode. All the AI are active ragdoll you can punch, shoot, grab etc. There is also aim trainer in this game which can help you improve your aim in this game.\n\nThere are variety of weapons available in this game like bow, knife, guns, crowbar etc. Do you have what it takes to be the best assassin in the world?.", "short_description": "Hit Contracts VR is a action filled first person shooter that lets players take the role of a assasin and undertake missions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realitygamesonline.net/HitContracts/PrivacyPolicy.txt", "developer_terms_of_service_url": null, "publisher_name": "Reality Games Online", "support_website_url": null, "website_url": "https://realitygamesonline.net/HitContract
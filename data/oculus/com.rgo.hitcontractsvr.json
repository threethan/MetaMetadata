SEV9UiDDDlmgJGA32XNrrbHz5fvuWT-4m9kdUxAAhtA&oe=6A394E80"}, {"file_name": "hit contracts 3png.png", "id": "753733692540416", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39035434_753733695873749_802914084157609370_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JlhhNf2kD-8Q7kNvwF7_BOf&_nc_oc=Adq_gR-I4q7Pncsur5j2GXQPwaQa3kOou9t6gVQUTjHQg1l0ZNSc1Tn8qXQ72l2FfpY&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Y_Y-XgudZNK4HSsIc8l1nQQsno92t5WRTSypidH8sEg&oe=6A396498"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "hit contracts logo.png", "id": "1362240134266160", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75330714_1362240137599493_6542733622171587273_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wBxIczoqdI0Q7kNvwGAVKsG&_nc_oc=AdoAna1ebKPZ0AK9qvzxTR2QPdmjdr8vQx4ZkLgRLbcxTxxwzx6s46LCUpcO0utc-ws&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8oa_SRd7Okvd7jQMN3bKEvdhKaTx47GqygQbCX1nzSFw&oe=6A393E07"}, "display_name": "Hit Contracts VR", "keywords": [], "long_description": "With the help of cutting edge physics, full-body kinematics this game lets you immerse yourself in to the role of a assassin for hire. You can either play in melee mode or regular mode. All the AI are active ragdoll you can punch, shoot, grab etc. There is also aim trainer in this game which can help you improve your aim in this game.\n\nThere are variety of weapons available in this game like bow, knife, guns, crowbar etc. Do you have what it takes to be the best assassin in the world?.", "short_description": "Hit Contracts VR is a action filled first person shooter that lets players take the role of a assasin and undertake missions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realitygamesonline.net/HitContracts/PrivacyPolicy.txt", "developer_terms_of_service_url": null, "publisher_name": "Reality Games Online", "support_website_url": null, "website_url": "https://realitygamesonline.net
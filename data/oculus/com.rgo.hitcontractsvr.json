SE7so7Y01RSHSy_joU5VG5E93GWr2bLA6EWUh4uVE8g&oe=6A7DA440"}, {"file_name": "hit contracts 3png.png", "id": "753733692540416", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39035434_753733695873749_802914084157609370_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fjzz79mw0O0Q7kNvwEm-8Kg&_nc_oc=AdoaHDlWU-8EhIfTrcCbA_kzv7p3QdLJQqHCCHw1p68ZVv8v-a8KNIBX3M_NumiziJI&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0RT1CpN5DlhKAVlt_V1VHO5o6NNGZuqzkAu8DCP-15Q&oe=6A7DBA58"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "hit contracts logo.png", "id": "1362240134266160", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75330714_1362240137599493_6542733622171587273_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lu0d_Xd1P-AQ7kNvwGrZhtd&_nc_oc=AdruiZ8MLPblTy8wLTeJeB0YnUY4C_Jq3foQYklYwfy7kbOumh4O3cV7urx7d8H12q4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHS7K655VO5aBbwXQDRsh3NPPPhMNauNHdtzEXwN2xSNQ&oe=6A7DCC07"}, "display_name": "Hit Contracts VR", "keywords": [], "long_description": "With the help of cutting edge physics, full-body kinematics this game lets you immerse yourself in to the role of a assassin for hire. You can either play in melee mode or regular mode. All the AI are active ragdoll you can punch, shoot, grab etc. There is also aim trainer in this game which can help you improve your aim in this game.\n\nThere are variety of weapons available in this game like bow, knife, guns, crowbar etc. Do you have what it takes to be the best assassin in the world?.", "short_description": "Hit Contracts VR is a action filled first person shooter that lets players take the role of a assasin and undertake missions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realitygamesonline.net/HitContracts/PrivacyPolicy.txt", "developer_terms_of_service_url": null, "publisher_name": "Reality Games Online", "support_website_url": null, "website_url": "https://realitygamesonline.net
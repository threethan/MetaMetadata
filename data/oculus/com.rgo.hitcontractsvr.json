VdTSB-dycAPIjtynvDmjvQnWwzmQXvw&oe=6AC3BC00"}, {"file_name": "hit contracts 3png.png", "id": "753733692540416", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035434_753733695873749_802914084157609370_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=li6i-XC2V44Q7kNvwEIkvSm&_nc_oc=AdrOtxrFMU_gogqty89eVrkQpFCFG7lZ63t0skAJHwTcFAhDkNiQY3QgO8OORCrZCLY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNqvFohGLHGpSjXt7eQYcOIYSmmeRX0w9kyBViBWGTQGA&oe=6AC3D218"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "hit contracts logo.png", "id": "1362240134266160", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75330714_1362240137599493_6542733622171587273_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HGNMjCPQVLQQ7kNvwGKIw5J&_nc_oc=AdqfZ5R5tE4PAZxNza27RDtwN0gSy53U6xyWLwfl-dScxo3D7IyJc3eCCl8uBL9kPcg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOlJi_1dvvrRY7pBZz7L7EwUKV5qMBF2rZ4j3AIMColQA&oe=6AC3AB87"}, "display_name": "Hit Contracts VR", "keywords": [], "long_description": "With the help of cutting edge physics, full-body kinematics this game lets you immerse yourself in to the role of a assassin for hire. You can either play in melee mode or regular mode. All the AI are active ragdoll you can punch, shoot, grab etc. There is also aim trainer in this game which can help you improve your aim in this game.\n\nThere are variety of weapons available in this game like bow, knife, guns, crowbar etc. Do you have what it takes to be the best assassin in the world?.", "short_description": "Hit Contracts VR is a action filled first person shooter that lets players take the role of a assasin and undertake missions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realitygamesonline.net/HitContracts/PrivacyPolicy.txt", "developer_terms_of_service_url": null, "publisher_name": "Reality Games Online", "support_website_url": null, "website_url": "https://realitygamesonline.net/HitContract
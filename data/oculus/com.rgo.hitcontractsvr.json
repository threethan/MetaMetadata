wekZe6mP0xCZElG8tAXQ57g2KRMshBA&oe=6A9ADD80"}, {"file_name": "hit contracts 3png.png", "id": "753733692540416", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035434_753733695873749_802914084157609370_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LQ3edN6ARV8Q7kNvwHBgqyc&_nc_oc=AdpXn07etJmo-IpMN6KsFojipdWcOz-orG0xNOMO_5b-EQPuhkJ9L-u05sZRFa00ynM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLVAmmCrtFe3gq4CdgwAaV6w6AjqSkob41Fiz9Fvvf0Mg&oe=6A9AF398"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "hit contracts logo.png", "id": "1362240134266160", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75330714_1362240137599493_6542733622171587273_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UcZpq55k7QIQ7kNvwEGnAZ-&_nc_oc=AdreSYmv6y6xcTRikMtnLJQdBO9adtkA5Hr91ICCGudhKRocdSK9pR42BQejiXiALfM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKTwi6d1Dvh21LYng2ZeKmcio9cEwThCNzC_bpR9MLTvQ&oe=6A9ACD07"}, "display_name": "Hit Contracts VR", "keywords": [], "long_description": "With the help of cutting edge physics, full-body kinematics this game lets you immerse yourself in to the role of a assassin for hire. You can either play in melee mode or regular mode. All the AI are active ragdoll you can punch, shoot, grab etc. There is also aim trainer in this game which can help you improve your aim in this game.\n\nThere are variety of weapons available in this game like bow, knife, guns, crowbar etc. Do you have what it takes to be the best assassin in the world?.", "short_description": "Hit Contracts VR is a action filled first person shooter that lets players take the role of a assasin and undertake missions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realitygamesonline.net/HitContracts/PrivacyPolicy.txt", "developer_terms_of_service_url": null, "publisher_name": "Reality Games Online", "support_website_url": null, "website_url": "https://realitygamesonline.net/HitContract
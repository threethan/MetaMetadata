mcdx4nX5d5ygGOL4hfuEmj0MSP0_gdQ&oe=6A170780"}, {"file_name": "hit contracts 3png.png", "id": "753733692540416", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035434_753733695873749_802914084157609370_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xDXhSHJ3XQcQ7kNvwFMaLAh&_nc_oc=AdomzDEqRiQ3pBYQs2nBystz37c57rAQmShKU4Qs_U1hZHnkeGgVKCO5PFldNK0ogq0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Iy3681GI7hZRMnJVkjVIXEDyLjv3e-dIa_vMsKVVrfA&oe=6A16E558"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "hit contracts logo.png", "id": "1362240134266160", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75330714_1362240137599493_6542733622171587273_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7E3Ht8NiW3IQ7kNvwGtLHjM&_nc_oc=AdoWw4ashzaxV9eP7vyCXtLQKynSiLpUE0ZyKOUr8zmngHEq13mC2ToHlNWQ_lElPMw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6C0vr0POb0OSPL3QuyygKW1D5tj_eJ9CHXVLVqUsqhJg&oe=6A16F707"}, "display_name": "Hit Contracts VR", "keywords": [], "long_description": "With the help of cutting edge physics, full-body kinematics this game lets you immerse yourself in to the role of a assassin for hire. You can either play in melee mode or regular mode. All the AI are active ragdoll you can punch, shoot, grab etc. There is also aim trainer in this game which can help you improve your aim in this game.\n\nThere are variety of weapons available in this game like bow, knife, guns, crowbar etc. Do you have what it takes to be the best assassin in the world?.", "short_description": "Hit Contracts VR is a action filled first person shooter that lets players take the role of a assasin and undertake missions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realitygamesonline.net/HitContracts/PrivacyPolicy.txt", "developer_terms_of_service_url": null, "publisher_name": "Reality Games Online", "support_website_url": null, "website_url": "https://realitygamesonline.net/HitContract
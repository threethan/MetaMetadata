-FlyJFbA16ih7z-AmBcbdfsjtg2ThRg&oe=6A2D7100"}, {"file_name": "hit contracts 3png.png", "id": "753733692540416", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035434_753733695873749_802914084157609370_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cVAkmTEQmCEQ7kNvwGDPwPV&_nc_oc=AdoIRYWNVt6fteymY5SJkbZWVStEmXC_TTeW8cPNHL_SOwlJKXVs5tLiYUCzHwk7-qg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6fcvuxrbKG1cKdSm4iWdjH3REG5DHz6vS4c7FHl1gjA&oe=6A2D4ED8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "hit contracts logo.png", "id": "1362240134266160", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75330714_1362240137599493_6542733622171587273_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kCU_6uZLp2cQ7kNvwHOHe8W&_nc_oc=AdrwP9G4QjOcbJg6CCOgYhGOM8KPecC93y3Yd_sxNTJx-mpA722AaD4u_5Ajp6pH_QQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8JTlbjW-q9Nii6RAQafFXGzC23vNfZszj3fKz1Tt1nOQ&oe=6A2D6087"}, "display_name": "Hit Contracts VR", "keywords": [], "long_description": "With the help of cutting edge physics, full-body kinematics this game lets you immerse yourself in to the role of a assassin for hire. You can either play in melee mode or regular mode. All the AI are active ragdoll you can punch, shoot, grab etc. There is also aim trainer in this game which can help you improve your aim in this game.\n\nThere are variety of weapons available in this game like bow, knife, guns, crowbar etc. Do you have what it takes to be the best assassin in the world?.", "short_description": "Hit Contracts VR is a action filled first person shooter that lets players take the role of a assasin and undertake missions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://realitygamesonline.net/HitContracts/PrivacyPolicy.txt", "developer_terms_of_service_url": null, "publisher_name": "Reality Games Online", "support_website_url": null, "website_url": "https://realitygamesonline.net/HitContract
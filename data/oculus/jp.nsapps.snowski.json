qpRcOax4wWR-fFxqotsWcv0W9CpUJlDlp4XNv-5GoHDrALd-S6DM2fowPv0oLLNO0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHWPuY0PKnnFYX-g9kbNkYZD5tPUfty_yJhBIRqanx5zA&oe=6A95E3E6"}, {"file_name": "6.png", "id": "1348848407332868", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593767690_1348848410666201_7110931744345633665_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bt0TqZ7LR8UQ7kNvwH1BFA7&_nc_oc=AdoJmHMUVQmUt8-XjX3UMBj6seafEx0ipWqYaSSd0L5p1Bk1ox1eKjnuY80LGiNw3EY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgC2mGsWuipwU-v1V2jFsKgo6xx20xD8XP6R8_CjJbng&oe=6A95BE93"}, {"file_name": "7.png", "id": "1069848102159191", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622184_1069848108825857_2500118084751339947_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h3krJUQRh60Q7kNvwG7ytud&_nc_oc=AdrjB1MD7GtRKPvClNTMsKqitwhPpfI2HR1H3ID3bJB2UpXEkgP4cbMcg8bS68OKbqQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHlaPpY05vhT8Y9dkpGCDRL23H1-5SbLQKVxBE90e8Rsw&oe=6A95C0DD"}, {"file_name": "10.png", "id": "1765711347961682", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620384_1765711351295015_5740883328733560999_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i9lAAoAyVw4Q7kNvwFobF_u&_nc_oc=AdomG73Wm2Wi0RIYE84H4iULMFp0NmNeAn-t7OcORH7p28pA31ja-pKkPWYGfH44OzY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGa3ynCViX7Kd54VkNj3b7HrTYhk5GzejomyFn_ulrOIA&oe=6A95B0CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "4429212587290309", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623111_4429212593956975_1726955234157515027_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LIGWgYy4tMkQ7kNvwFFnw-C&_nc_oc=Adpv2-KfVJCDT16YAoLk01ncsT9QJkfSnCZeKo4bq6IOXD4tQiKLuXOVt4z4opQg14s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_8IPH0TvCwe8wlE_q78DNjeBX01xAkrAxfce0powdLA&oe=6A95D1D3"}, "display_name": "White Flow XR: VR Skiing", "keywords": ["Sports", "Casual", "Action", "Arcade", "Winter"], "long_description": "# Ski Farther and Aim for a New High Score! \u2744\ufe0f\nSki down an endless snowy course!\nWhite Flow XR is an easy-to-learn VR skiing game you can play without controllers. Lean to turn and stand up to jump using intuitive body movements.\nAvoid obstacles, jump onto rails, and pull off grinds as you ski farther with every run.\n\n# \ud83d\udd25 Key Features:\n**\ud83c\udfbf Controller-Free Body Controls:**\nPlay without controllers\u2014lean left or right to turn and stand up to jump.\n\n**\ud83c\udfd4\ufe0f Endless Skiing:**\nKeep moving down the mountain and see how far you can go.\n\n**\ud83d\udee4\ufe0f Rail Grinds:**\nJump onto rails and pull off grinds to boost your score.\n\n**\ud83c\udf05 Changing Snowy Scenery:**\nWatch the snowy scenery change from morning through afternoon, sunset, and night.\n\n**\ud83c\udfc6 High-Score Challenge:**\nTrack your distance, airtime, grinds, and near misses. Try again and beat your best score!\n\nReady to hit the slopes? No controllers needed\u2014just start skiing! \u2744\ufe0f\n", "short_description": "Endless VR skiing with intuitive body controls\u2014no controllers needed. Lean to turn and stand up to jump! \u2744\ufe0f"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended
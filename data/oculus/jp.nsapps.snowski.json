pXXUof99T53-mKkDzF_nfOuZXcVFX8CdQt1ST3lVVncO01HpvhKm_dZx5MjLYZ3oM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLs7W9Z97Ewh1O8mQ2dBThp0UAqBN4ZKVTYkrfO6Fii2Q&oe=6A99A026"}, {"file_name": "6.png", "id": "1348848407332868", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593767690_1348848410666201_7110931744345633665_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NBQosXVKIvMQ7kNvwF3tQrB&_nc_oc=AdooGYxV_txEmX9EcbHizKfb6S6n57AAnf4RKlyFs1Pk0fYnxYE7J24sgfL6k2G0-JE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSKaApww-v1AmUyI-T7wh1l98zWkTeqsp1EF1hbXFEKQ&oe=6A997AD3"}, {"file_name": "7.png", "id": "1069848102159191", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622184_1069848108825857_2500118084751339947_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wJyymrnQIAkQ7kNvwFhikCk&_nc_oc=Adp9ce6F-wxLZtWIEkwClps44xL-xZYy68DQ9WDn7xWxElUAOFPtvHvpeVks7SKB1Ds&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxYX66Uup-3HhBk1IND7QTQkfRIsJU_qvjsK_Dca574A&oe=6A997D1D"}, {"file_name": "10.png", "id": "1765711347961682", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620384_1765711351295015_5740883328733560999_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1SDHTKvpKOgQ7kNvwE1EPrD&_nc_oc=Adq3MyPbj0G2q-xlIzUVwwawUpGWI1ePSzX4pf-aY21xLDoBwYPXmIgFQNF7xKovdps&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7FdHnPNbm9mEDQQaGPVpkvf6IKS9B3lYuBFsP7PPhJA&oe=6A99A54F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "4429212587290309", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623111_4429212593956975_1726955234157515027_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UkZKlhY2ByoQ7kNvwFG1Yg3&_nc_oc=AdodkDHWgR-W1XmDx9Mi1t1XxXrmUiODz2rCJdGMtwWqjD-g9J3_sQ79UuM-DTP3Fi0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLRxe5o8NeMsw3--O_CF1_iFtHeb_1F-zoim2ABfFnkRA&oe=6A998E13"}, "display_name": "White Flow XR: VR Skiing", "keywords": ["Sports", "Casual", "Action", "Arcade", "Winter"], "long_description": "# Ski Farther and Aim for a New High Score! \u2744\ufe0f\nSki down an endless snowy course!\nWhite Flow XR is an easy-to-learn VR skiing game you can play without controllers. Lean to turn and stand up to jump using intuitive body movements.\nAvoid obstacles, jump onto rails, and pull off grinds as you ski farther with every run.\n\n# \ud83d\udd25 Key Features:\n**\ud83c\udfbf Controller-Free Body Controls:**\nPlay without controllers\u2014lean left or right to turn and stand up to jump.\n\n**\ud83c\udfd4\ufe0f Endless Skiing:**\nKeep moving down the mountain and see how far you can go.\n\n**\ud83d\udee4\ufe0f Rail Grinds:**\nJump onto rails and pull off grinds to boost your score.\n\n**\ud83c\udf05 Changing Snowy Scenery:**\nWatch the snowy scenery change from morning through afternoon, sunset, and night.\n\n**\ud83c\udfc6 High-Score Challenge:**\nTrack your distance, airtime, grinds, and near misses. Try again and beat your best score!\n\nReady to hit the slopes? No controllers needed\u2014just start skiing! \u2744\ufe0f\n", "short_description": "Endless VR skiing with intuitive body controls\u2014no controllers needed. Lean to turn and stand up to jump! \u2744\ufe0f"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended
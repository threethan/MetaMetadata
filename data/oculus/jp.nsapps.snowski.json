ps://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593767690_1348848410666201_7110931744345633665_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uFKYMDdRp64Q7kNvwHLnNLV&_nc_oc=Adr8RbBhm25nPUec2rP9g5FEb6ebH-XQKOpFvXe5V96017U2u3G_T0LFV-PmvZyNM5s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOHhs6MED00pwCHBkFH3UDE9ZlxkJyyJSsbBHnUks4Qmg&oe=6ACA4253"}, {"file_name": "7.png", "id": "1069848102159191", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622184_1069848108825857_2500118084751339947_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KDkq65LSC38Q7kNvwFbp5y7&_nc_oc=Adqvix2wLDY1as5Azq4-N-q3LYSWyKvP_5L_Qg08qxsGwXGo1Ru4Uvo7simw9nyoRRE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM5FxDLDSNI62iahZ4XT_nOBT8lqdJM3o-Z5r1F1ajJ0g&oe=6ACA449D"}, {"file_name": "10.png", "id": "1765711347961682", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620384_1765711351295015_5740883328733560999_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BI_jnn1a1NQQ7kNvwEOMho5&_nc_oc=Adrf_AHCcSzx7CbNIY4xsZxzvHehWJM7V7UcujxKTu_daD1ZRjkDxJZXSiN7ogxfyUs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPO2CEWkuozu78b5Plsa5IU94-HfwoUOF8D3ZZ1w8FhKg&oe=6ACA6CCF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Ski2.png", "id": "2554308035070245", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623115_2554308038403578_6547361238586464965_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zmWNA6o91B0Q7kNvwHH2Ci3&_nc_oc=AdpIWS2JS4Nih9nW7aamrB9Fxmp92AMyQxM5yJ3VeQIqYjwKvlPgssQzISr_Xpz6eY4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMslko28FT7CtwDwyP16a_XhTGl_1ck7k77itRLTAflLg&oe=6ACA5C4C"}, "display_name": "White Flow XR: VR Skiing", "keywords": ["Sports", "Casual", "Action", "Arcade", "Winter"], "long_description": "# Ski Farther and Aim for a New High Score! \u2744\ufe0f\nSki down an endless snowy course!\nWhite Flow XR is an easy-to-learn VR skiing game you can play without controllers. Lean to turn and stand up to jump using intuitive body movements.\nAvoid obstacles, jump onto rails, and pull off grinds as you ski farther with every run.\n\n# \ud83d\udd25 Key Features:\n**\ud83c\udfbf Controller-Free Body Controls:**\nPlay without controllers\u2014lean left or right to turn and stand up to jump.\n\n**\ud83c\udfd4\ufe0f Endless Skiing:**\nKeep moving down the mountain and see how far you can go.\n\n**\ud83d\udee4\ufe0f Rail Grinds:**\nJump onto rails and pull off grinds to boost your score.\n\n**\ud83c\udf05 Changing Snowy Scenery:**\nWatch the snowy scenery change from morning through afternoon, sunset, and night.\n\n**\ud83c\udfc6 High-Score Challenge:**\nTrack your distance, airtime, grinds, and near misses. Try again and beat your best score!\n\nReady to hit the slopes? No controllers needed\u2014just start skiing! \u2744\ufe0f\n", "short_description": "Endless VR skiing with intuitive body controls\u2014no controllers needed. Lean to turn and stand up to jump! \u2744\ufe0f"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "290439171
ntent-ord5-2.oculuscdn.com/v/t64.5771-25/593767690_1348848410666201_7110931744345633665_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GADdCQmtKy8Q7kNvwHNVubG&_nc_oc=AdqQP7VvAlgBYt_naZ2bSR8H1Vrr2q85OPjmW-5V-rMnBMCi-z1bNpEuloD0Xyl1o-Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmw2LQD7vhlWgg6XdPglmrPcg08ibk-Pv-AqENOAGebg&oe=6AB91ED3"}, {"file_name": "7.png", "id": "1069848102159191", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622184_1069848108825857_2500118084751339947_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=14wPMXP8WiAQ7kNvwEzs8Bu&_nc_oc=AdqjjoTCbmZ3UeTRkxbNO3hAPE1u9iFsqsZl7BcaKICQIXLFsfW1XiMz-PBiA3ct5NU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3ySxF6sQkZDuSWt598rtYaee7IF8yD8iRFLIDDAJ3VA&oe=6AB9211D"}, {"file_name": "10.png", "id": "1765711347961682", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620384_1765711351295015_5740883328733560999_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1iR4plygmrkQ7kNvwHacg99&_nc_oc=AdqKdt6_ohlTSJLRPW6Pqz_s3allguw6vnJWyMQ3jKPhORNjsLDH91Vw9Pu-29Ayh7g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUV9i2f3K3zYqM-1jyHTlb3ygyqaITOyAqdDXWna_8ng&oe=6AB9110F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Rc1.png", "id": "1342823492243872", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499624851_1342823495577205_4339024503663493061_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QWU8pd6GKecQ7kNvwHjx-fE&_nc_oc=AdpDBDIYoUwLtuH7h-m98T5alyCSSqmpdgDnE4u1LXvkw7OofOz7MTos26XOd-uiSrY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdn4hVvRxsnQ1gQG1i2aMmpdOvPxAlhluWUkSO1-6zFA&oe=6AB91DFD"}, "display_name": "White Flow XR: VR Skiing", "keywords": ["Sports", "Casual", "Action", "Arcade", "Winter"], "long_description": "# Ski Farther and Aim for a New High Score! \u2744\ufe0f\nSki down an endless snowy course!\nWhite Flow XR is an easy-to-learn VR skiing game you can play without controllers. Lean to turn and stand up to jump using intuitive body movements.\nAvoid obstacles, jump onto rails, and pull off grinds as you ski farther with every run.\n\n# \ud83d\udd25 Key Features:\n**\ud83c\udfbf Controller-Free Body Controls:**\nPlay without controllers\u2014lean left or right to turn and stand up to jump.\n\n**\ud83c\udfd4\ufe0f Endless Skiing:**\nKeep moving down the mountain and see how far you can go.\n\n**\ud83d\udee4\ufe0f Rail Grinds:**\nJump onto rails and pull off grinds to boost your score.\n\n**\ud83c\udf05 Changing Snowy Scenery:**\nWatch the snowy scenery change from morning through afternoon, sunset, and night.\n\n**\ud83c\udfc6 High-Score Challenge:**\nTrack your distance, airtime, grinds, and near misses. Try again and beat your best score!\n\nReady to hit the slopes? No controllers needed\u2014just start skiing! \u2744\ufe0f\n", "short_description": "Endless VR skiing with intuitive body controls\u2014no controllers needed. Lean to turn and stand up to jump! \u2744\ufe0f"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28784568927801721"
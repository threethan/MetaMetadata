=_IicJGhNgjAQ7kNvwE4zXek&_nc_oc=AdoxR3J45y5OtomxMNIgFv6goTq4Xy9IC9ZHiEdwmez0q2wq0fLM02Fic1ozMa-gyW8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSqHdSsHY9x9TuEdoWM5VDa8eCj6NI4w0WlCk5Gxs-vRg&oe=6B0DA426"}, {"file_name": "6.png", "id": "1348848407332868", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593767690_1348848410666201_7110931744345633665_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fPZgoSbOBjgQ7kNvwHyzJpW&_nc_oc=AdokIx2QbAybyn8TidR6wGzDp6BXvf2HRWfR8icvT9XiMkmbPpZh0X2PcUcxCrSaeHM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSbYbElZy-81O2gkdxZMx-O-uPkc5WxncP9WjdQ6Q2ywQ&oe=6B0DB713"}, {"file_name": "7.png", "id": "1069848102159191", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622184_1069848108825857_2500118084751339947_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1WiIXF5QYqMQ7kNvwFRpyn0&_nc_oc=AdqfGnYDE7k26tGB1gd8esb7wu5nOD-13PCBik9t3DLEDrWl0fqqOpDwb4wGLk1T0ok&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQADxb9Tb2A0U64SvCXUR-s8HYOTj1x25yD17Ak31D-hA&oe=6B0DB95D"}, {"file_name": "10.png", "id": "1765711347961682", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620384_1765711351295015_5740883328733560999_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ei2QO8hyEjkQ7kNvwGD26C1&_nc_oc=Adr-3MSZPpFRjINE01zYSkbXOYlAfIqdjj7DBQZCeIWmaOzVof0OBR0N44fqKr1pdAs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQEPIf1mwHk8VYyCVN6OEd2OVXsNlWumJIlA-MMhbI6CQ&oe=6B0DA94F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Ski2.png", "id": "2554308035070245", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623115_2554308038403578_6547361238586464965_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BTddSR9K3q0Q7kNvwEdtnHF&_nc_oc=Ado2S3AvZuFTbK3qqQCA8DDdFQAI0759Fr9FuYlhTd1ruHRBCtF6Nv0O-MTxx9nhs6g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR6GCRMtY_HLWMSpBYHlR58OC8PDVCkdm464vke8010XQ&oe=6B0DD10C"}, "display_name": "White Flow XR: VR Skiing", "keywords": ["Sports", "Casual", "Action", "Arcade", "Winter"], "long_description": "# Ski Farther and Aim for a New High Score! \u2744\ufe0f\nSki down an endless snowy course! \nWhite Flow XR is an easy-to-learn VR skiing game you can play without controllers. Lean to turn and stand up to jump using intuitive body movements.\nAvoid obstacles, jump onto rails, and pull off grinds as you ski farther with every run.\n\n# \ud83d\udd25 Key Features:\n**\ud83c\udfbf Controller-Free Body Controls:**\nPlay without controllers\u2014lean left or right to turn and stand up to jump.\n\n**\ud83c\udfd4\ufe0f Endless Skiing:**\nKeep moving down the mountain and see how far you can go.\n\n**\ud83d\udee4\ufe0f Rail Grinds:**\nJump onto rails and pull off grinds to boost your score.\n\n**\ud83c\udf05 Changing Snowy Scenery:**\nWatch the snowy scenery change from morning through afternoon, sunset, and night.\n\n**\ud83c\udfc6 High-Score Challenge:**\nTrack your distance, airtime, grinds, and near misses. Try again and beat your best score!\n\nReady to hit the slopes? No controllers needed\u2014just start skiing! \u2744\ufe0f\n", "short_description": "Endless VR skiing with intuitive body controls\u2014no controllers needed. Lean to turn and stand up to jump! \u2744\ufe0f\u3000"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads"
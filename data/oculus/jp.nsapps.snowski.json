28733560999_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1iR4plygmrkQ7kNvwHacg99&_nc_oc=AdqKdt6_ohlTSJLRPW6Pqz_s3allguw6vnJWyMQ3jKPhORNjsLDH91Vw9Pu-29Ayh7g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUV9i2f3K3zYqM-1jyHTlb3ygyqaITOyAqdDXWna_8ng&oe=6AB9110F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "4429212587290309", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623111_4429212593956975_1726955234157515027_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x164q6RqomkQ7kNvwH2PZHF&_nc_oc=AdrLtlaONI5v9LhjcnhbdvQxSHsxEKx8IEB8UM6LKIuAVUuCZ_Q9IOacHqErdwc0xr0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVkMrrMHLOlVcKr6PL5Aw9xjm1QszQkek_YrR4aQNCfQ&oe=6AB93213"}, "display_name": "White Flow XR: VR Skiing", "keywords": ["Sports", "Casual", "Action", "Arcade", "Winter"], "long_description": "# Ski Farther and Aim for a New High Score! \u2744\ufe0f\nSki down an endless snowy course!\nWhite Flow XR is an easy-to-learn VR skiing game you can play without controllers. Lean to turn and stand up to jump using intuitive body movements.\nAvoid obstacles, jump onto rails, and pull off grinds as you ski farther with every run.\n\n# \ud83d\udd25 Key Features:\n**\ud83c\udfbf Controller-Free Body Controls:**\nPlay without controllers\u2014lean left or right to turn and stand up to jump.\n\n**\ud83c\udfd4\ufe0f Endless Skiing:**\nKeep moving down the mountain and see how far you can go.\n\n**\ud83d\udee4\ufe0f Rail Grinds:**\nJump onto rails and pull off grinds to boost your score.\n\n**\ud83c\udf05 Changing Snowy Scenery:**\nWatch the snowy scenery change from morning through afternoon, sunset, and night.\n\n**\ud83c\udfc6 High-Score Challenge:**\nTrack your distance, airtime, grinds, and near misses. Try again and beat your best score!\n\nReady to hit the slopes? No controllers needed\u2014just start skiing! \u2744\ufe0f\n", "short_description": "Endless VR skiing with intuitive body controls\u2014no controllers needed. Lean to turn and stand up to jump! \u2744\ufe0f"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28347726868152598"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1881679363274969"}]}, "baseline_offer": {"id": "1881679363274969"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1787275080, "status": "PUBLISHED", "id": "1881679363274969"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28602849419307007", "version": "1.0"}, "id": "2185950331976329", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "28347726831485935", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28602849419307007"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2185950331976329"}]}, "chan
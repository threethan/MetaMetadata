ures include:**\n- Displaying lengths in metric or imperial system\n- Length measurements\n- Angle measurements\n\n**What I want to add in the future:**\n- Area and volume calculations\n- 3D model export of your measurements\n- Importing 3D models into the app to see how objects would fit into your space\n- Support for more languages", "short_description": "Measure distances and angles in mixed reality using either hand tracking or controllers."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gist.github.com/zZz-Theo-zZz/6b40b43f2fe0137ba3069c45adc0d873", "developer_terms_of_service_url": null, "publisher_name": "ZozimeCorp", "support_website_url": null, "website_url": "https://measure-app.carrd.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9374780449238060"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392309_1871238547012567_4961456800248992361_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F-BNiFyJ-xIQ7kNvwG2QVr8&_nc_oc=AdqLwshQoOBhHB-Xu1pDu2NSxoiOSlZINs4dfWmSYTAEyJoGfFIPtup3jOHEGOA7HOY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5eZGguVyRR6x2CVzuJWJqurV2koUlMmUhBb8DpQpPqIg&oe=69F9E6A4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Measure", "platform"
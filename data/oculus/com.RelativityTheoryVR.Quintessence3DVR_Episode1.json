dn.com&_nc_ss=7f20f&oh=00_AQTQBz0g3iFDE_Xj2d2--ciXOgTUfq9CxByeTiW0354kAw&oe=6AE89B56"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/tBp7rX", "id": "1203967376477760", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39036625_1203967379811093_4722099843672047616_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-aARQtJ7pBkQ7kNvwGrg47p&_nc_oc=AdqYG7xMNZP4-8wxkA7evdWljF-fM19ivnVhx1bCzZ8KvhsrOGeE93jdPXKJ5VSba70&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjfJzNTeWCU_8qnLBhzarBU1V3FHmV1-zd1mZkDHt-gw&oe=6AE8A7C3"}, "display_name": "Quintessence 3D VR Episode 1", "keywords": ["Quintessence", "Adventure", "Music", "SciFi", "Movie"], "long_description": "By the year 2043 high tech wars and environmental destruction left little life on Earth. Only a few pacifist scientists escaped by barricading themselves in deep bunkers underground and at the bottom of the deep ocean. There they worked on their solution for mankind. Within a few years they isolated the human gene for super energy perception. They discovered SE is a super force that is interconnected with, gives life, form, and sustenance to all things in the Universe. Some hailed it.. the \"God energy\u201d. But, all of these scientists believed that all living things evolve toward the super energy.. and if they could speed up this process humans could finally achieve enlightenment and peace. Now, after ongoing success with this revolutionary human genetic engineering.. it is the year 2085. All people have some SE capabilities, but there are a few that evolved beyond the others.\n\nQuintessence 3D VR was created using the latest state of the art in 3D 360 VR, and spacial audio technology.", "short_description": "A scripted sci-fi 3D 360 VR Cinema experience. An intriguing and captivating story of mankind's future in an original episodic VR series. Designed for 3D 360 VR as a super immersive and entertaining multidimensional virtual reality and spacial sound cinema experience, and metaphysical adventure of mankind's new found connection with Universal forces. \nEpisode1 begins the immersive adventure as signals are received from the Black Hole, and the supernauts prepare for their epic journey."}]}, "developer_name": "Relativity Theory VR", "developer_privacy_policy_url": null, "developer_terms_of_service_url": "http://relativitytheoryvr.com/termsofservice.html", "publisher_name": "Relatvity Theory VR", "support_website_url": "http://relativitytheoryvr.com/contact.html", "website_url": "http://relativitytheoryvr.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "ADVENTURE", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "682558269781291"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "640578486762085"}]}, "baseline_offer": {"id": "640578486762085"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1585846851, "status": "PUBLISHED", "id": "640578486762085"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "3474387259263039", "version": "1.1"}, "id": "2987786308112428", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2464167103618398", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", 
Q&_nc_oc=AdqG40pHl0r1AKcjWwJEdSioPWOEdmA42ztCvIYxz9ozgntDh4p_bZDWGDarbAKo8Vg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGMRzYSkSIOcf2jrWMKyGE9NB0YeTTZ4tmEBHTRWOsYiw&oe=6A707F73"}, {"file_name": "migrated_image.png", "id": "226214061910137", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162763_143678396273729_6482624053747122176_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q8XW-gdbYxQQ7kNvwH3g1Uw&_nc_oc=AdpPzBZStITyaS6EeU_0Ww2FjecdQcIdp3Wk--F0xp5_7KULV5tMtDn0zKJ2OrwY304&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHLv3QSJRdwq0ACfFcCi6CHaILcVMG392kdlaBD15IF7g&oe=6A7073AC"}, {"file_name": "migrated_image.png", "id": "212102596672796", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162707_138523736788646_2960305160795979776_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XC_S0Sm85TgQ7kNvwF2yozE&_nc_oc=AdpOw4Y52MbwpRbvBKNSoJUH97BdzpKAXWhD8-JeNEF942B18RtB6DDzr0FS3Mn7MaE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHngZU2Slqi8N6J5S3X2Erd06G3VlMNk5ugo-UEgOTloQ&oe=6A70A854"}, {"file_name": "migrated_image.png", "id": "208540827159608", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162702_124387201576475_5406613443337781248_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V3-ws4AlFy8Q7kNvwG-_o6u&_nc_oc=AdoQQgNelvWmTnYYq_raSpZH7mkVXVd1yy70_fdiy2wjZnifX4vSLPR_N4s8DeEuhns&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhUhnyG568FVJdNRbNAm83vEIajTgjgQRej8pOUybwgQ&oe=6A707DF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "2007762539505711", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162703_2007762542839044_612867755552538624_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iOtgbhwi42kQ7kNvwGokn7W&_nc_oc=Adq8actVF7HwexGqzLd7e6W6BFY7a8Lud31W3ayOQTb7035cIHgQ1iHDj79zvsKByss&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE7aESMD1iBTorhPY8lZNdlRr0Oaf9kBlkiWJ1oM2N_6g&oe=6A707E58"}, "display_name": "Metro-2: Project Kollie", "keywords": ["zombie", "coldwar", "spy", "undead", "execution"], "long_description": "Be part of an exciting cold war spy story.\n\nA secret Soviet project started in 1958. Its goal was to create the most effective super weapon. Doctors, scientists, engineers and soliders worked together to indite bio-robots for the Russian army. After many consecutive failures the Central Committee closed down the project in 1969 and all the information became classified. The KGB continued the research in an underground facility without the Comittee's knowledge and in 1982 the team had some primitive results. As a CIA agent you have to infiltrate into this facility and gather as much information as possible about the project.\nBut it won't be easy for you because this is one of the most guarded place in the world.\n\nFeatures: \n- fight against zombies and cyborgs\n- cold war story\n- unique execution system\n- exciting fps combat\n- amazing graphics", "short_description": "Be part of an exciting cold war spy story.\n\nAs a CIA agent you have to infiltrate into a soviet underground facility and gather as much information as possible about their secret project.\nBut it won't be easy for you because this is one of the most guarded place in the world."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "https://tech-tro.com/privacy-policy", "developer_terms_of_service_url": "http://metro2.tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "http://metro2.tech-tro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "CASUAL", "HORROR", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended
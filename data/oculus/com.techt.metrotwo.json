w&_nc_oc=AdoppSgB2AdT_v2k8hyqAOByJe4lwlLGEGyntlweUEf4pvxWvZiZxo1PCaDIL34KHT0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ojo_XvZfmpBSNdj5yyCXXzAfjeyaFTYrjvTvDKCjAmg&oe=69DA3473"}, {"file_name": "migrated_image.png", "id": "226214061910137", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162763_143678396273729_6482624053747122176_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RLM47QM05fYQ7kNvwEokbT_&_nc_oc=AdqAmZbg2-3dhf1quidz7bZHIE5liZ7RCcc9prRuefIIH2ZdJswOdYV0tro5aIp2nVk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2GMD884dg2UxG-Q-6ihmncWJQxBlnu607Q7sB7pkAoPg&oe=69DA60EC"}, {"file_name": "migrated_image.png", "id": "212102596672796", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162707_138523736788646_2960305160795979776_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HPub5-q9SGgQ7kNvwFmTpqh&_nc_oc=Ado261s802sxNOCaRiJmB5-hh6JVZiXTt8UF5hPeDWVdbowVsMVORSd7nto8uP4QqA8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3YwqRAFC-lJf8DoTZ6tEawo4ygFyv1WVp07-SJndW-Tg&oe=69DA5D54"}, {"file_name": "migrated_image.png", "id": "208540827159608", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162702_124387201576475_5406613443337781248_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gBxka4UD-48Q7kNvwFu-Rxs&_nc_oc=AdqmwPCUaZJV4SOrkdhJLeOdDCJiadWlgQ5nbXZNhKgXl6zuMQC2pqTqYT79JGOOnm4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0NWof-kelhE_bKGp-HimBEbhMg462rVzhNViKNnQNk5A&oe=69DA32F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "2007762539505711", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162703_2007762542839044_612867755552538624_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QFhhSE090RUQ7kNvwEaSJaU&_nc_oc=AdqSgn08YV2M5T4TUIm4tw_nTgeGShTaDshGwolrMaPuUJ4hEKJJhOS66zTwNkegFGs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1GJPTN3Ca4jGxqf5KXsiSkqEnFchMz1xVd2eaInXI3Gw&oe=69DA3358"}, "display_name": "Metro-2: Project Kollie", "keywords": ["zombie", "coldwar", "spy", "undead", "execution"], "long_description": "Be part of an exciting cold war spy story.\n\nA secret Soviet project started in 1958. Its goal was to create the most effective super weapon. Doctors, scientists, engineers and soliders worked together to indite bio-robots for the Russian army. After many consecutive failures the Central Committee closed down the project in 1969 and all the information became classified. The KGB continued the research in an underground facility without the Comittee's knowledge and in 1982 the team had some primitive results. As a CIA agent you have to infiltrate into this facility and gather as much information as possible about the project.\nBut it won't be easy for you because this is one of the most guarded place in the world.\n\nFeatures: \n- fight against zombies and cyborgs\n- cold war story\n- unique execution system\n- exciting fps combat\n- amazing graphics", "short_description": "Be part of an exciting cold war spy story.\n\nAs a CIA agent you have to infiltrate into a soviet underground facility and gather as much information as possible about their secret project.\nBut it won't be easy for you because this is one of the most guarded place in the world."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "https://tech-tro.com/privacy-policy", "developer_terms_of_service_url": "http://metro2.tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "http://metro2.tech-tro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "CASUAL", "HORROR", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended
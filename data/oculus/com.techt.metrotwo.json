X&_nc_oc=AdpYV2R-uXqD4heEbi4fbpm0TqZMM5UvBDj3bQbUTHuOJwzS7FA5BErNivih1qi422o&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMfQSc3lygKrjTvAKYZ4-lykf5X1bFHIXGPkyQYbPOlxw&oe=6AC90C33"}, {"file_name": "migrated_image.png", "id": "226214061910137", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162763_143678396273729_6482624053747122176_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EpiGT-lv4nwQ7kNvwF-yhXv&_nc_oc=AdpIxKduDXwInbYh5efnCsVJqVPaE89LFK4Xz3Bz4hE-Fh3x2DY3cGHuSTo-GRNrn4E&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3Pc8YAmd4ShI9W3X7GExxHB9hqTeJuS_MswgXHDcQNg&oe=6AC9006C"}, {"file_name": "migrated_image.png", "id": "212102596672796", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/11162707_138523736788646_2960305160795979776_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V39eXFeqOEMQ7kNvwGmUqRN&_nc_oc=AdrpuOXOEfaka4uufnHfKrSpF7yxtgF1F6R-e9pFHd52AKY2sqEDAhwGx9xVcB_UUt4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNeI1h8H3FKBkTXgdTa9393JhuZySK-W0NoqpdbSL9Kxw&oe=6AC8FCD4"}, {"file_name": "migrated_image.png", "id": "208540827159608", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162702_124387201576475_5406613443337781248_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UBg3w8jL6QQQ7kNvwE63Bcl&_nc_oc=AdpHaKq4zgfrgRMOwHC13eZ6vvW8D-ErGTwegpnmzw1RedimoQCWQnK-7b2xJfARJhc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-M7iXkxJl6Y7rivPbTc4wfhGyPwS2T4l9XeHQCicgIQ&oe=6AC90AB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "2007762539505711", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/11162703_2007762542839044_612867755552538624_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yc_HofmEvwwQ7kNvwFfCaaF&_nc_oc=Adrt5P39sB16INhhTleGDU5CtegK5A0rF29BisVzKut1U8tuc9UdZsauSN2MXKHlTec&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOfg5R0-MogVcgFNOtR6f7gR9WwbyiadF0XkCoI9nLLjw&oe=6AC90B18"}, "display_name": "Metro-2: Project Kollie", "keywords": ["zombie", "coldwar", "spy", "undead", "execution"], "long_description": "Be part of an exciting cold war spy story.\n\nA secret Soviet project started in 1958. Its goal was to create the most effective super weapon. Doctors, scientists, engineers and soliders worked together to indite bio-robots for the Russian army. After many consecutive failures the Central Committee closed down the project in 1969 and all the information became classified. The KGB continued the research in an underground facility without the Comittee's knowledge and in 1982 the team had some primitive results. As a CIA agent you have to infiltrate into this facility and gather as much information as possible about the project.\nBut it won't be easy for you because this is one of the most guarded place in the world.\n\nFeatures: \n- fight against zombies and cyborgs\n- cold war story\n- unique execution system\n- exciting fps combat\n- amazing graphics", "short_description": "Be part of an exciting cold war spy story.\n\nAs a CIA agent you have to infiltrate into a soviet underground facility and gather as much information as possible about their secret project.\nBut it won't be easy for you because this is one of the most guarded place in the world."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "https://tech-tro.com/privacy-policy", "developer_terms_of_service_url": "http://metro2.tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "http://metro2.tech-tro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "CASUAL", "HORROR", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended
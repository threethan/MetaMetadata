T&_nc_oc=AdqW77qUD6i0Ozb-Jz5e9y7NMVSIbciU-cckN9ta7fombEH-4uMkKEBk7pXOnamTvA4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKAYoqx3j-SWpvKRp4IXe5keI9PV7YIbVe0odusHko5Zg&oe=6AB545B3"}, {"file_name": "migrated_image.png", "id": "226214061910137", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162763_143678396273729_6482624053747122176_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TX9aqh_avgoQ7kNvwGzlBlc&_nc_oc=AdrauwfSQK65ZhIZyu852zo5ol-TyLE498Joqx6ZAuBwP8OKEkhYqxrLkZ45dJEarxA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNmVDlYHLlFGxySulYCC7PYY04fSDSjEo7oIzx9D30uw&oe=6AB539EC"}, {"file_name": "migrated_image.png", "id": "212102596672796", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162707_138523736788646_2960305160795979776_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b8CknEMoKV0Q7kNvwGYcNaM&_nc_oc=AdoJtL1gIlI3Rwe3mL1K5Neu1qTE1kOjfSukfGP_ck5iB7iY9jGdc6AFbRwMHFA5Jl8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLO1dRXdyf-utxECA_Upy2Ul21YMDrsqFyk1eGJHt7iVQ&oe=6AB53654"}, {"file_name": "migrated_image.png", "id": "208540827159608", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162702_124387201576475_5406613443337781248_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jM8LEbTTCg4Q7kNvwFBXUS-&_nc_oc=Adrnoakq-TlTpM5WFypKaZRZ8aibXqTQPLg0hqYl6GtSsskjarFKMdPx9h8Uoi37w1c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJXWiiAaow340-8Kna9w3Co9nVFTgKUgctTiW7rRQvFLw&oe=6AB54433"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "2007762539505711", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162703_2007762542839044_612867755552538624_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UmryFgC6wcoQ7kNvwFWzDNh&_nc_oc=Adp3aaTh7hfhKmqQhp93iXe5yZhH5gw76yxTqs94QaWU5beq-LV-oYevHUhsruzcCKM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCKXWLTiss2dkX1BbSbabi6_POccbiliWmNj6JRCaoug&oe=6AB54498"}, "display_name": "Metro-2: Project Kollie", "keywords": ["zombie", "coldwar", "spy", "undead", "execution"], "long_description": "Be part of an exciting cold war spy story.\n\nA secret Soviet project started in 1958. Its goal was to create the most effective super weapon. Doctors, scientists, engineers and soliders worked together to indite bio-robots for the Russian army. After many consecutive failures the Central Committee closed down the project in 1969 and all the information became classified. The KGB continued the research in an underground facility without the Comittee's knowledge and in 1982 the team had some primitive results. As a CIA agent you have to infiltrate into this facility and gather as much information as possible about the project.\nBut it won't be easy for you because this is one of the most guarded place in the world.\n\nFeatures: \n- fight against zombies and cyborgs\n- cold war story\n- unique execution system\n- exciting fps combat\n- amazing graphics", "short_description": "Be part of an exciting cold war spy story.\n\nAs a CIA agent you have to infiltrate into a soviet underground facility and gather as much information as possible about their secret project.\nBut it won't be easy for you because this is one of the most guarded place in the world."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "https://tech-tro.com/privacy-policy", "developer_terms_of_service_url": "http://metro2.tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "http://metro2.tech-tro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "CASUAL", "HORROR", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended
X&_nc_oc=AdrFu1hZqHgCBMr94HQoh_547I59M3yJUTy2qbK9BuVbphI6SK0fhwijlTgjk5QZQIw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXVfgoDe6Veff0Rk5k4_9_dZ6E4zgpHVhchR3Jx2Mx4w&oe=6A9AE7B3"}, {"file_name": "migrated_image.png", "id": "226214061910137", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162763_143678396273729_6482624053747122176_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=igPrsw-_IhEQ7kNvwFVCWgw&_nc_oc=Adp5Ya26mgroGA9XvqBe8Qgh7dIwKFR6D58J4Kiauemua4ha4zoP2RuoJL6l8HNh-hY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLppVMFtP9esKYKm-7s3WVegg3FaeSCH0p2oPFYFEY8Gg&oe=6A9ADBEC"}, {"file_name": "migrated_image.png", "id": "212102596672796", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162707_138523736788646_2960305160795979776_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fBocb7GKkkMQ7kNvwEKl3d-&_nc_oc=Adq6Z7WgNiSLaxqq0VUYr59Je7c1QiHp0V8P1u3afh0-ODbykox-bQbc5Fpuz-sSO5I&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQINThAn4k7MyQKR5y5_-aTIZPAxbqRpe5VVz05OkQ4w6w&oe=6A9AD854"}, {"file_name": "migrated_image.png", "id": "208540827159608", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162702_124387201576475_5406613443337781248_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cQAJ8JpObYYQ7kNvwFq8Cno&_nc_oc=Adp89yJOtSIvtVfa5nhY8qmwHD_gOpOW-TqL9nDFEeyym6SsG_LMNqWMfHDvTNx09pI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK713FCcFaMUWXLcjlULs2GyNLI2-xUOONoOGZzXg-pfg&oe=6A9AE633"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "2007762539505711", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162703_2007762542839044_612867755552538624_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E9s1TrHe-54Q7kNvwGLLY2p&_nc_oc=AdqXX01s3RSCHTEgKXI6XghiiXZtfVjNKvwYjnud4JhhA6vIHVJkctRFfcB2LFnSgG0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCqLl5SlprsTEFxus6jPD8Q5Hs-vJM8RbKeYAYR6jfjQ&oe=6A9AE698"}, "display_name": "Metro-2: Project Kollie", "keywords": ["zombie", "coldwar", "spy", "undead", "execution"], "long_description": "Be part of an exciting cold war spy story.\n\nA secret Soviet project started in 1958. Its goal was to create the most effective super weapon. Doctors, scientists, engineers and soliders worked together to indite bio-robots for the Russian army. After many consecutive failures the Central Committee closed down the project in 1969 and all the information became classified. The KGB continued the research in an underground facility without the Comittee's knowledge and in 1982 the team had some primitive results. As a CIA agent you have to infiltrate into this facility and gather as much information as possible about the project.\nBut it won't be easy for you because this is one of the most guarded place in the world.\n\nFeatures: \n- fight against zombies and cyborgs\n- cold war story\n- unique execution system\n- exciting fps combat\n- amazing graphics", "short_description": "Be part of an exciting cold war spy story.\n\nAs a CIA agent you have to infiltrate into a soviet underground facility and gather as much information as possible about their secret project.\nBut it won't be easy for you because this is one of the most guarded place in the world."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "https://tech-tro.com/privacy-policy", "developer_terms_of_service_url": "http://metro2.tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "http://metro2.tech-tro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "CASUAL", "HORROR", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended
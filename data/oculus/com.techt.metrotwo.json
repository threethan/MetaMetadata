5&_nc_oc=AdpozeY1nAYb_-QjZ9XP0mkwiLPuhUu81n_Mu6KBAfBs_L_TMKlwq7mWPSbffNE8cpc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRe7YzGW1szFx5Lyb2QWfRj15-7zmjvPyNwXq3X5QPhHQ&oe=6AF09933"}, {"file_name": "migrated_image.png", "id": "226214061910137", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162763_143678396273729_6482624053747122176_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FLoZYGnmJqUQ7kNvwHSW_FG&_nc_oc=AdqnwQRVupVsfmBRIyb34GGCCXq3QrVfXSgCQNDi7VTw8ufk8z2ru2bIyS0iysSJLSM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTubU9uAnp_u3-gWsd4C81fDM25HZMzXC3RX0vLm0d71g&oe=6AF08D6C"}, {"file_name": "migrated_image.png", "id": "212102596672796", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162707_138523736788646_2960305160795979776_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0kbH-1-0BH4Q7kNvwFtSKll&_nc_oc=AdrjSeHVEIy9T22iNXrdSEEHzi9XNCBhEog1uiSsKF3l5PeF_xapnaa8PGBP9N8_EVE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGhgF5t81wI2Swg84Z4ls26VEA5ceFu-7vWjBLUkerQQ&oe=6AF089D4"}, {"file_name": "migrated_image.png", "id": "208540827159608", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162702_124387201576475_5406613443337781248_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-fcNmBZyTqUQ7kNvwFmKebW&_nc_oc=AdoGxEqiiPrk27Wa8jLCmWlLJQV_oBx1e62lYk24UsusPn0cfcJbsbYknDRqwROOyQE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR46y8Ii8-prNAvhaua_1mJk3cMpQKWbKuzIOHHk9VeiA&oe=6AF097B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "2007762539505711", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162703_2007762542839044_612867755552538624_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w81GLym1CyoQ7kNvwFP93UT&_nc_oc=AdpqurmIqkyMwMqnk1qUiRlRMQNp_SKXt-bwAUy2p_fcV_OjF-TUSml6WdQW1pPud48&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRg4BV2nA8p7JiHBnObOHL_ddfgM7ryqCppJyUYy1gusw&oe=6AF09818"}, "display_name": "Metro-2: Project Kollie", "keywords": ["zombie", "coldwar", "spy", "undead", "execution"], "long_description": "Be part of an exciting cold war spy story.\n\nA secret Soviet project started in 1958. Its goal was to create the most effective super weapon. Doctors, scientists, engineers and soliders worked together to indite bio-robots for the Russian army. After many consecutive failures the Central Committee closed down the project in 1969 and all the information became classified. The KGB continued the research in an underground facility without the Comittee's knowledge and in 1982 the team had some primitive results. As a CIA agent you have to infiltrate into this facility and gather as much information as possible about the project.\nBut it won't be easy for you because this is one of the most guarded place in the world.\n\nFeatures: \n- fight against zombies and cyborgs\n- cold war story\n- unique execution system\n- exciting fps combat\n- amazing graphics", "short_description": "Be part of an exciting cold war spy story.\n\nAs a CIA agent you have to infiltrate into a soviet underground facility and gather as much information as possible about their secret project.\nBut it won't be easy for you because this is one of the most guarded place in the world."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "https://tech-tro.com/privacy-policy", "developer_terms_of_service_url": "http://metro2.tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "http://metro2.tech-tro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "CASUAL", "HORROR", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended
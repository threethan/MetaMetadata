H&_nc_oc=Adq-0nEyaefdiq7D5jSBPYLHfP0V14fwj59EKSqZZgEz6TZqAUZ0JD3KCqLiSEkAwYA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-X5OPB9NLOltMpn_55m_WTYTyRp7V5Kd70XObChq7diQ&oe=6A32C133"}, {"file_name": "migrated_image.png", "id": "226214061910137", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/11162763_143678396273729_6482624053747122176_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zebrpgyaYXsQ7kNvwF5R-Lh&_nc_oc=AdokG-2j7D8ucY9ruRL_Qr-f80A3VOwC_btr9VdxnqIwO7HaeHrBl17o3OsWdP44b6M&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_4pB6U4bMUNRMuYvU-5dpoTjZDU0Ay7vO0Q-4d9TJrHQ&oe=6A32B56C"}, {"file_name": "migrated_image.png", "id": "212102596672796", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/11162707_138523736788646_2960305160795979776_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hjP7TPQz-ykQ7kNvwESOYGK&_nc_oc=AdrE_CXUbAz7e2ySHKQslk16Sj03TXLyvwHWb9KU0BYBaIdqxKT_Gs6UZrcqdTG5K0k&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9pb7ovelhgq0v446CIKeLZ095aHigxQe8LkS6WvN5r4g&oe=6A32B1D4"}, {"file_name": "migrated_image.png", "id": "208540827159608", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/11162702_124387201576475_5406613443337781248_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VRHY_olmlXIQ7kNvwHTYqtt&_nc_oc=AdqSGs6S1e7ZJOzflqsUG42_TS00HFFBqgSMh39t6gnU2AGVRMWNuB8nffHdemhnHDI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_uDXv5IECux21ALZ3wqyJOPxtceKutCtvz2hWOS-QMSQ&oe=6A32BFB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "2007762539505711", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/11162703_2007762542839044_612867755552538624_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M5EN93e8XaEQ7kNvwHkkefv&_nc_oc=AdqPpOprGFMuEnCQzJYep2RZ-87sx-FN3QbrNB2RV4s7dk1Vj3xFjsznaEM4JamMcAs&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_WAjzHRaJ7-fa2BdqYkvnEqIRdQJp0o4J_Go2qUxESMg&oe=6A32C018"}, "display_name": "Metro-2: Project Kollie", "keywords": ["zombie", "coldwar", "spy", "undead", "execution"], "long_description": "Be part of an exciting cold war spy story.\n\nA secret Soviet project started in 1958. Its goal was to create the most effective super weapon. Doctors, scientists, engineers and soliders worked together to indite bio-robots for the Russian army. After many consecutive failures the Central Committee closed down the project in 1969 and all the information became classified. The KGB continued the research in an underground facility without the Comittee's knowledge and in 1982 the team had some primitive results. As a CIA agent you have to infiltrate into this facility and gather as much information as possible about the project.\nBut it won't be easy for you because this is one of the most guarded place in the world.\n\nFeatures: \n- fight against zombies and cyborgs\n- cold war story\n- unique execution system\n- exciting fps combat\n- amazing graphics", "short_description": "Be part of an exciting cold war spy story.\n\nAs a CIA agent you have to infiltrate into a soviet underground facility and gather as much information as possible about their secret project.\nBut it won't be easy for you because this is one of the most guarded place in the world."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "https://tech-tro.com/privacy-policy", "developer_terms_of_service_url": "http://metro2.tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "http://metro2.tech-tro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "CASUAL", "HORROR", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended
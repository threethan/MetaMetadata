Q&_nc_oc=Ado6ffUVV0Q18vUJGNLDlx9IgSihGy1H-VoLpcA8iqrlkRu0fu1IpIxpu3daGpo215M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwOvooP-IGtGJcv1Nq0vOWDPRowdkLI823dQxG0vZFXdg&oe=69D0F9F3"}, {"file_name": "migrated_image.png", "id": "226214061910137", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162763_143678396273729_6482624053747122176_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EudMjVJu_AgQ7kNvwExW0aP&_nc_oc=AdowWO4QxGp48XHxaMOkPkZ_l5hFfQx-kw6Db5ZVI_zQNmiyi9xmiJnGV2rb0LMZe9k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx9eiw9lBAsPOTOAnfVkqxpObwJr9ya1CDnuYHrDVCChw&oe=69D0EE2C"}, {"file_name": "migrated_image.png", "id": "212102596672796", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162707_138523736788646_2960305160795979776_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_jVXyA9OsaYQ7kNvwFxpf6Y&_nc_oc=AdrVyl4GH-d1ScRHc4KoyP86DjrZwhaA4S5XlQrVt2COd-R4EkHSJ9b5zf6OUra7Jko&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzEVK7mVjTjRvtH0XPsM_fvBujWVeJTDtPBKdfkKmyJMA&oe=69D122D4"}, {"file_name": "migrated_image.png", "id": "208540827159608", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162702_124387201576475_5406613443337781248_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1YokZHTnJNUQ7kNvwGzO9RK&_nc_oc=Adpsw6WRAaWI6-pmbi-fK1oDKe0wzO1QM3ukK_7hZBT3DXjyhOYGNHRk6KjqlzQMvtY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz3KrrZPiFZ5jCX0U1OX-smn-31kQlxmFxeDOaS-jhGJA&oe=69D0F873"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "2007762539505711", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162703_2007762542839044_612867755552538624_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GvYUydqWimsQ7kNvwHX4HPE&_nc_oc=Adov5rlgGRAAwB78CbvT121bnLCLPVZhAH6twtePStXLTQ3LRbZpcZlht7RsCntrOO8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyhXuSXSPT7JSsaF1KtP4KubOUEFPXcjG46F4poyr8cZw&oe=69D0F8D8"}, "display_name": "Metro-2: Project Kollie", "keywords": ["zombie", "coldwar", "spy", "undead", "execution"], "long_description": "Be part of an exciting cold war spy story.\n\nA secret Soviet project started in 1958. Its goal was to create the most effective super weapon. Doctors, scientists, engineers and soliders worked together to indite bio-robots for the Russian army. After many consecutive failures the Central Committee closed down the project in 1969 and all the information became classified. The KGB continued the research in an underground facility without the Comittee's knowledge and in 1982 the team had some primitive results. As a CIA agent you have to infiltrate into this facility and gather as much information as possible about the project.\nBut it won't be easy for you because this is one of the most guarded place in the world.\n\nFeatures: \n- fight against zombies and cyborgs\n- cold war story\n- unique execution system\n- exciting fps combat\n- amazing graphics", "short_description": "Be part of an exciting cold war spy story.\n\nAs a CIA agent you have to infiltrate into a soviet underground facility and gather as much information as possible about their secret project.\nBut it won't be easy for you because this is one of the most guarded place in the world."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "https://tech-tro.com/privacy-policy", "developer_terms_of_service_url": "http://metro2.tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "http://metro2.tech-tro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "CASUAL", "HORROR", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended
Z&_nc_oc=AdrSJmKampO_KSAo20PJnOMoJCp1fSDvRQshkpFrsHYXVb0arOEGHZihmIPq2BPK55o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5IB31FNz0lWTLP9L5yUE9gG7hfqZ1Y0RWyvJw9qewxCQ&oe=6A204C33"}, {"file_name": "migrated_image.png", "id": "226214061910137", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162763_143678396273729_6482624053747122176_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ABvfwNHBa30Q7kNvwHepQsz&_nc_oc=AdoGYsMBgIOaKS9sHRydDzuBLs1DqXSi9ssEEosYTDHjEprGaTeXAvcmMXGr-8BGNGQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6GnfrrcgZsm8Af55rYk7MFU2-Mn5jvsatPm9YqaUsA-Q&oe=6A20406C"}, {"file_name": "migrated_image.png", "id": "212102596672796", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162707_138523736788646_2960305160795979776_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9UylehWBmTcQ7kNvwF0cw4-&_nc_oc=Adr8jjF-OQsvHwyD2F_eZCqmPlcrC88eSffiWsBS51KF6bL7IOwaD8Pat4s_6R8d5Qk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7X5UmO_MEYPlFL2ziG7T5ys5itfy4We5a6lVa0GrVOfw&oe=6A203CD4"}, {"file_name": "migrated_image.png", "id": "208540827159608", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162702_124387201576475_5406613443337781248_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=32XYrwatEV8Q7kNvwEIq4OX&_nc_oc=AdoYpQWjuWUnyPJidTRA3ChmZbd5AZ9HlQut4ku1nF-MQhUTT7gBPlfHMaZzTTubNPY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5fABVQjfhTXV7WZBoTdxLD0ZewwCAwIK28LZjKRP111Q&oe=6A204AB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "2007762539505711", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162703_2007762542839044_612867755552538624_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jIWaPBYrd9YQ7kNvwGtkG6M&_nc_oc=Ado6-NVdmkMlE1zgNqxKvt8JAjXVbWrS284VShWcmANTcFX7OAiXHiiENAeXfTbenQM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7m7x4xy_xdk9VbKPJooLRP12hRxNDCNU-2EYbJe6bn_g&oe=6A204B18"}, "display_name": "Metro-2: Project Kollie", "keywords": ["zombie", "coldwar", "spy", "undead", "execution"], "long_description": "Be part of an exciting cold war spy story.\n\nA secret Soviet project started in 1958. Its goal was to create the most effective super weapon. Doctors, scientists, engineers and soliders worked together to indite bio-robots for the Russian army. After many consecutive failures the Central Committee closed down the project in 1969 and all the information became classified. The KGB continued the research in an underground facility without the Comittee's knowledge and in 1982 the team had some primitive results. As a CIA agent you have to infiltrate into this facility and gather as much information as possible about the project.\nBut it won't be easy for you because this is one of the most guarded place in the world.\n\nFeatures: \n- fight against zombies and cyborgs\n- cold war story\n- unique execution system\n- exciting fps combat\n- amazing graphics", "short_description": "Be part of an exciting cold war spy story.\n\nAs a CIA agent you have to infiltrate into a soviet underground facility and gather as much information as possible about their secret project.\nBut it won't be easy for you because this is one of the most guarded place in the world."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "https://tech-tro.com/privacy-policy", "developer_terms_of_service_url": "http://metro2.tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "http://metro2.tech-tro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "CASUAL", "HORROR", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended
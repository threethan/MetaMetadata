F&_nc_oc=Adpalbfde7nGIKSN-4TchO-L2pYWKc3AomXr99o4XX3RXJwG-WmmELf2O5M5FEvl3JM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZYyYG7APZKSnJp1L60ADtZtgzHgFa07JRKu4Qgxm-cA&oe=6ACD00B3"}, {"file_name": "migrated_image.png", "id": "226214061910137", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162763_143678396273729_6482624053747122176_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GvsQxGCNtawQ7kNvwFdG2UP&_nc_oc=Adpl-3Wtur1dyk_WxI47wkaqkPt5hEYl7ADP7MPQrgjXjsGmB2FoWMVoX5Ovztn2caA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMWyUssraWurV37Bw0XEXCQdqDS5h7hETOkbStPsiZ4XA&oe=6ACCF4EC"}, {"file_name": "migrated_image.png", "id": "212102596672796", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162707_138523736788646_2960305160795979776_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=98TTPa3DP00Q7kNvwED8OXZ&_nc_oc=Adoh_8SJjelQpwg0sfRCcCkieQkyRd7hRnZ0GWesUa3yUQVtbASagANvgICB-0TARhw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNC2i6qiFr-stU8d7DUvhhjgkhFAb5VPM96PUXJonZCHQ&oe=6ACCF154"}, {"file_name": "migrated_image.png", "id": "208540827159608", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162702_124387201576475_5406613443337781248_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GsBYSa4Ls8oQ7kNvwGok3tV&_nc_oc=Adr-qGn-Lbmo9a0vUQraBOOxKkCJw30mjCkMVjkBPwPmsAvJbEWSXWenXWJBZclNezE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOw81gIwrkoD0zdt35fMNEaRsFoL474wKDJWBGuvLaCHw&oe=6ACCFF33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "2007762539505711", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162703_2007762542839044_612867755552538624_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k-er9du5jgQQ7kNvwHDGTJ3&_nc_oc=Adr6OlXKi_QyQuOCk6KLUyWyOlh0jDNRhQz9E65C4pADS3ySo3eK6N958EIbbzbaW3w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQML-RIalu7jDNWdeAqp79JO01KxnbG9lBpVnEbcR423fA&oe=6ACCFF98"}, "display_name": "Metro-2: Project Kollie", "keywords": ["zombie", "coldwar", "spy", "undead", "execution"], "long_description": "Be part of an exciting cold war spy story.\n\nA secret Soviet project started in 1958. Its goal was to create the most effective super weapon. Doctors, scientists, engineers and soliders worked together to indite bio-robots for the Russian army. After many consecutive failures the Central Committee closed down the project in 1969 and all the information became classified. The KGB continued the research in an underground facility without the Comittee's knowledge and in 1982 the team had some primitive results. As a CIA agent you have to infiltrate into this facility and gather as much information as possible about the project.\nBut it won't be easy for you because this is one of the most guarded place in the world.\n\nFeatures: \n- fight against zombies and cyborgs\n- cold war story\n- unique execution system\n- exciting fps combat\n- amazing graphics", "short_description": "Be part of an exciting cold war spy story.\n\nAs a CIA agent you have to infiltrate into a soviet underground facility and gather as much information as possible about their secret project.\nBut it won't be easy for you because this is one of the most guarded place in the world."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "https://tech-tro.com/privacy-policy", "developer_terms_of_service_url": "http://metro2.tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "http://metro2.tech-tro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "CASUAL", "HORROR", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended
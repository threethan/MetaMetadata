7&_nc_oc=AdpTJtGPXVlwbJ3gdGav8Xd0pc5HPsjykO9U7mUWQo-ld1At8DebX_c0mM9npBJpFCc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_idMsMGi8ptSFScOPrKGCCaCN4VggJ-JphWtjMtqiBjQ&oe=6A3412B3"}, {"file_name": "migrated_image.png", "id": "226214061910137", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162763_143678396273729_6482624053747122176_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zebrpgyaYXsQ7kNvwFFBizT&_nc_oc=AdqVEsxJSjZF0t8DFoXzwM1AjQM7qHzBz28ssam3hZtHsHjdRxUSEhU6PdM0KS4lPH0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9yO-inI_wWumY2IEHhS4DUloWbhWP3qGYuia0PseHhAA&oe=6A3406EC"}, {"file_name": "migrated_image.png", "id": "212102596672796", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162707_138523736788646_2960305160795979776_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hjP7TPQz-ykQ7kNvwE0LgE0&_nc_oc=AdpfLoDIyxGBzzKTJKpin97VRS3qWtuhLKEdDv9BpKSn8fAbCjcKRT8bw_oydRR4ROc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-vSHFnRWzwMqtGSZvCk9T4rmTLxhHvCQDz0t1gEwPoHQ&oe=6A340354"}, {"file_name": "migrated_image.png", "id": "208540827159608", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162702_124387201576475_5406613443337781248_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VRHY_olmlXIQ7kNvwGjxyF8&_nc_oc=AdqG0T4WowetUy9dm98jKAbhTR5d0ZdY3fJ9TkG-uE9BkZv3uXXkrIlUBS-abacIemQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_VcMrUQuYNqw9yfM5xOQo56Ctjd1a1bIxzP8PeVsNgCw&oe=6A341133"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "2007762539505711", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162703_2007762542839044_612867755552538624_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M5EN93e8XaEQ7kNvwHlR9UM&_nc_oc=AdoqMRM6uUCoolQF-gB77xw9yrS8kzjUU8Eownom9joyB9dAJUkooiTe-OkHTHzCpkY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-EQkdojlEbYF5pNwRARAVyIS3G_ct6oHtQvyjUWuyUew&oe=6A341198"}, "display_name": "Metro-2: Project Kollie", "keywords": ["zombie", "coldwar", "spy", "undead", "execution"], "long_description": "Be part of an exciting cold war spy story.\n\nA secret Soviet project started in 1958. Its goal was to create the most effective super weapon. Doctors, scientists, engineers and soliders worked together to indite bio-robots for the Russian army. After many consecutive failures the Central Committee closed down the project in 1969 and all the information became classified. The KGB continued the research in an underground facility without the Comittee's knowledge and in 1982 the team had some primitive results. As a CIA agent you have to infiltrate into this facility and gather as much information as possible about the project.\nBut it won't be easy for you because this is one of the most guarded place in the world.\n\nFeatures: \n- fight against zombies and cyborgs\n- cold war story\n- unique execution system\n- exciting fps combat\n- amazing graphics", "short_description": "Be part of an exciting cold war spy story.\n\nAs a CIA agent you have to infiltrate into a soviet underground facility and gather as much information as possible about their secret project.\nBut it won't be easy for you because this is one of the most guarded place in the world."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "https://tech-tro.com/privacy-policy", "developer_terms_of_service_url": "http://metro2.tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "http://metro2.tech-tro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "CASUAL", "HORROR", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended
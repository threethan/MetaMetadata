O&_nc_oc=AdqQeKjASQxzttUVujQFEWd8VrB5SV_Jyhdx01KJ7OaWEI_X_WqAJR3H9eQ3mBebi2I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6YGcf9TcmXTBzwes5KGrc1nCYAGpQj4Ibmww1mlhBySA&oe=6A19B4B3"}, {"file_name": "migrated_image.png", "id": "226214061910137", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162763_143678396273729_6482624053747122176_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TGwxgCA0elYQ7kNvwFh3OBQ&_nc_oc=Adp-knAKWTZQiHea8JU8cYenoJlcku_Vmf6d0t0gDtLjMi0PLe1pg6d_wUrh45aXX8o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5toKyw-l0R0L6_8UkcofB_1JHSZxkKaPAGcbvlGkBGzA&oe=6A19A8EC"}, {"file_name": "migrated_image.png", "id": "212102596672796", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162707_138523736788646_2960305160795979776_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bHcIiJQ87MUQ7kNvwG7i4LQ&_nc_oc=Adr7MAzck6obSMDlRPFAQV5lWqNXkYJY-8BL_oRzi5ZtXDMLjrzVheAlVwyS7w317mg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7soGZCautcgOOhyFQ-PvRmVu4T1Eny-eCgxdyKq8GEkQ&oe=6A19A554"}, {"file_name": "migrated_image.png", "id": "208540827159608", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162702_124387201576475_5406613443337781248_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_IlxkLkK0_UQ7kNvwFtLO64&_nc_oc=AdqBQYhzB0agK_tc8FV6jj0ceZguiprsn0mwCbKonehJHZVZtJIHDx6N0-X0nVVPVaA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68AJLR1CQz0LNrG0rIrg_bHCcbt-5LT9TOxZl-CHoynQ&oe=6A19B333"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "2007762539505711", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162703_2007762542839044_612867755552538624_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_0nH493jL4sQ7kNvwHWt_cq&_nc_oc=AdrQKi949Rr5sEPV18SeltKvCr9h-oIPBbLOrkGDcitmn1BVuoK5pcWDEBirvJAvCV4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ytYwsFpaO7usL040p_i00eINlnUearA75E4BJwRQrlw&oe=6A19B398"}, "display_name": "Metro-2: Project Kollie", "keywords": ["zombie", "coldwar", "spy", "undead", "execution"], "long_description": "Be part of an exciting cold war spy story.\n\nA secret Soviet project started in 1958. Its goal was to create the most effective super weapon. Doctors, scientists, engineers and soliders worked together to indite bio-robots for the Russian army. After many consecutive failures the Central Committee closed down the project in 1969 and all the information became classified. The KGB continued the research in an underground facility without the Comittee's knowledge and in 1982 the team had some primitive results. As a CIA agent you have to infiltrate into this facility and gather as much information as possible about the project.\nBut it won't be easy for you because this is one of the most guarded place in the world.\n\nFeatures: \n- fight against zombies and cyborgs\n- cold war story\n- unique execution system\n- exciting fps combat\n- amazing graphics", "short_description": "Be part of an exciting cold war spy story.\n\nAs a CIA agent you have to infiltrate into a soviet underground facility and gather as much information as possible about their secret project.\nBut it won't be easy for you because this is one of the most guarded place in the world."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "https://tech-tro.com/privacy-policy", "developer_terms_of_service_url": "http://metro2.tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "http://metro2.tech-tro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "CASUAL", "HORROR", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended
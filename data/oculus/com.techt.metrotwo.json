z&_nc_oc=AdrXJMrfLPki4PWNUEv5OB92xKQOzwTRNpwKY2BtjStDrq911N2Z8o7W8A5Z1HNPALc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5OISJUA7i052lmjezDhHeYd5pZKvkR22zC7l0cV8Gx5A&oe=6A1B0633"}, {"file_name": "migrated_image.png", "id": "226214061910137", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/11162763_143678396273729_6482624053747122176_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LG0t-vZxUiUQ7kNvwEW9lff&_nc_oc=AdpdrlH3qzmlRanpSgHjCeb692QyZoDe0O2IBBOcImWYssEx5zPzACEbKmydrYW2JQM&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6pj4ySotR9w1rAAL8TJAn_32NS0f-5HHq5454eIuE8EQ&oe=6A1AFA6C"}, {"file_name": "migrated_image.png", "id": "212102596672796", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/11162707_138523736788646_2960305160795979776_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hMGDAOQBx5MQ7kNvwHVxqGS&_nc_oc=Adpuee1mH3ZRVIwFkS0QFAmGfUkYic_wyRjGonFRqkMR1RGT32DZfx1kf4tuiSY66fc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6CMDuF_RACr9zML96ggvhOmQCwj9GbwuusJPe-El0Wmg&oe=6A1AF6D4"}, {"file_name": "migrated_image.png", "id": "208540827159608", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/11162702_124387201576475_5406613443337781248_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_IlxkLkK0_UQ7kNvwFYgMpp&_nc_oc=AdrlXtHsgxw_PFcbLHDcu3KytU0olfAfwxg6oHORZDsdZwQ9gZC733JPXSCjGLYv5CE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6haOVtdLBwpAbl1dGKMhMZWzrvl-rf88-791WOStfdmQ&oe=6A1B04B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "2007762539505711", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/11162703_2007762542839044_612867755552538624_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eZK51dekstwQ7kNvwF-LglJ&_nc_oc=AdorxbZiv217ytci-IrGqiXOlVnWg8NDHe7DPveSXF7BFyBot2gnr89ksq2JJ_FySzY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7J4MvHVkkVlZY54savSqzaSW_3feSFTtmLPk9GLjNEVw&oe=6A1B0518"}, "display_name": "Metro-2: Project Kollie", "keywords": ["zombie", "coldwar", "spy", "undead", "execution"], "long_description": "Be part of an exciting cold war spy story.\n\nA secret Soviet project started in 1958. Its goal was to create the most effective super weapon. Doctors, scientists, engineers and soliders worked together to indite bio-robots for the Russian army. After many consecutive failures the Central Committee closed down the project in 1969 and all the information became classified. The KGB continued the research in an underground facility without the Comittee's knowledge and in 1982 the team had some primitive results. As a CIA agent you have to infiltrate into this facility and gather as much information as possible about the project.\nBut it won't be easy for you because this is one of the most guarded place in the world.\n\nFeatures: \n- fight against zombies and cyborgs\n- cold war story\n- unique execution system\n- exciting fps combat\n- amazing graphics", "short_description": "Be part of an exciting cold war spy story.\n\nAs a CIA agent you have to infiltrate into a soviet underground facility and gather as much information as possible about their secret project.\nBut it won't be easy for you because this is one of the most guarded place in the world."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "https://tech-tro.com/privacy-policy", "developer_terms_of_service_url": "http://metro2.tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "http://metro2.tech-tro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "CASUAL", "HORROR", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended
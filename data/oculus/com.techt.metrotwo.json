b&_nc_oc=Ado1ndhUd1p4C5cXVCO4dsWP0QrAMOm13LaYZai5iGzvi60KA4vuSVSEDpxeTM4OmD8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1N9af5RezpWSRLjU52lhByWkTCODIhU3nAK03jeO_pVw&oe=69F8BF33"}, {"file_name": "migrated_image.png", "id": "226214061910137", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162763_143678396273729_6482624053747122176_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UGOkBgo2b-wQ7kNvwHS8Sul&_nc_oc=Adqc3O9TgWp-QbAk9E2cayORKq_kgaOWUbn-TjWSlSvmcNr5wXdXudHIsRs6N2qrCTs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3jIAiBSEYRLVKgXPeodFHR5bFWNHecAk2FRluxQaonQw&oe=69F8B36C"}, {"file_name": "migrated_image.png", "id": "212102596672796", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162707_138523736788646_2960305160795979776_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CE6-Z_Li0MIQ7kNvwHYNTU1&_nc_oc=Adr5T9oNbDJLt3h5p1DIFfyemLbPXh8SsTs6ZNh_101WeUJjZ1hOqaUHDal81QNLLps&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2mnon1P-CeZgZILilEMzUw0y3cjHIQ4JdT1Ml2rymHIA&oe=69F8AFD4"}, {"file_name": "migrated_image.png", "id": "208540827159608", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162702_124387201576475_5406613443337781248_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b3OgOBjet34Q7kNvwFDfurs&_nc_oc=AdrYVOGmwqQWHh5tU_3BJxzJgnPC--eaPcNrhCmwiAKCUdWlPiyzD-Ni2xSgrmvicBw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0c4vT6FN_ROA3NZhYtk7IpHgVwUJvyyAj_PVN0VOgUkg&oe=69F8BDB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "2007762539505711", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162703_2007762542839044_612867755552538624_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DfExeBfFxfcQ7kNvwGzZsib&_nc_oc=AdprXIVI2BTd4exAIoFWUVtlEixNcSFb0uKdlOkdkEWjLE7eIf4_abcGxEYjdwvXkow&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0YLta5n9ZjpkosXu28vOL5nlTm-8TQ6-F3Zwy9EISmWA&oe=69F8BE18"}, "display_name": "Metro-2: Project Kollie", "keywords": ["zombie", "coldwar", "spy", "undead", "execution"], "long_description": "Be part of an exciting cold war spy story.\n\nA secret Soviet project started in 1958. Its goal was to create the most effective super weapon. Doctors, scientists, engineers and soliders worked together to indite bio-robots for the Russian army. After many consecutive failures the Central Committee closed down the project in 1969 and all the information became classified. The KGB continued the research in an underground facility without the Comittee's knowledge and in 1982 the team had some primitive results. As a CIA agent you have to infiltrate into this facility and gather as much information as possible about the project.\nBut it won't be easy for you because this is one of the most guarded place in the world.\n\nFeatures: \n- fight against zombies and cyborgs\n- cold war story\n- unique execution system\n- exciting fps combat\n- amazing graphics", "short_description": "Be part of an exciting cold war spy story.\n\nAs a CIA agent you have to infiltrate into a soviet underground facility and gather as much information as possible about their secret project.\nBut it won't be easy for you because this is one of the most guarded place in the world."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "https://tech-tro.com/privacy-policy", "developer_terms_of_service_url": "http://metro2.tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "http://metro2.tech-tro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "CASUAL", "HORROR", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended
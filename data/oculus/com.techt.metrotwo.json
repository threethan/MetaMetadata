o&_nc_oc=Adp9yOkT-9acjQNL_uPMOcqbGitdstA_YWXAz0yUj2DfxzZUYRHd6EGqu59V0yifVI8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-X3iJ5nMHuiuONfWPKrP192zvTtiECu6_u0KBZnGocdA&oe=6A301E33"}, {"file_name": "migrated_image.png", "id": "226214061910137", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162763_143678396273729_6482624053747122176_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KKY3BzAYBX0Q7kNvwHMtQHo&_nc_oc=AdoQiPG473vhAtmBT0rzFllrXwVz31TAKMdubFmuF2Z5n8NY_hCn3JDwPCjn84drvEQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_KEHAGVKDxWsr27vjEWwAZcuYotW39XMl_wlJmoQ05_w&oe=6A30126C"}, {"file_name": "migrated_image.png", "id": "212102596672796", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162707_138523736788646_2960305160795979776_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NaXnNOBr2TAQ7kNvwHSoR66&_nc_oc=AdouFntaFBLY1dDNNwxXgvU64EToDwvOHhC3BZwHxPZJaf4noKGPxxZlDigjVw5urRw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8DzmqeGCMkPWWLSv2KsE669rAQhzIV1rU3NrPrpRgWvw&oe=6A300ED4"}, {"file_name": "migrated_image.png", "id": "208540827159608", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162702_124387201576475_5406613443337781248_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iTaEU1thCxcQ7kNvwElXwu-&_nc_oc=Adom01uFimATLTHHNgDP-LhtxZ4BnYQ2RBjbV8R1pQXi4Jg4xBCMtjkcBm1u8Ucfjz4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Yjb0iF2zFahzLL0J4E4Ewgio7xhLdfT1rpTu64LV1uQ&oe=6A301CB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "2007762539505711", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162703_2007762542839044_612867755552538624_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Fvp3HLppwcQ7kNvwEKUu5u&_nc_oc=AdpRmh8YitRlkOAuxKRhZqsyanLvO-u8hAwN0_v7cWfg1fru0KNJvDJI0lN3HF3W-EU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ADiLi7_DL5XDNAcaeXK9UJhmM0obmX-L8LG1bWuES1w&oe=6A301D18"}, "display_name": "Metro-2: Project Kollie", "keywords": ["zombie", "coldwar", "spy", "undead", "execution"], "long_description": "Be part of an exciting cold war spy story.\n\nA secret Soviet project started in 1958. Its goal was to create the most effective super weapon. Doctors, scientists, engineers and soliders worked together to indite bio-robots for the Russian army. After many consecutive failures the Central Committee closed down the project in 1969 and all the information became classified. The KGB continued the research in an underground facility without the Comittee's knowledge and in 1982 the team had some primitive results. As a CIA agent you have to infiltrate into this facility and gather as much information as possible about the project.\nBut it won't be easy for you because this is one of the most guarded place in the world.\n\nFeatures: \n- fight against zombies and cyborgs\n- cold war story\n- unique execution system\n- exciting fps combat\n- amazing graphics", "short_description": "Be part of an exciting cold war spy story.\n\nAs a CIA agent you have to infiltrate into a soviet underground facility and gather as much information as possible about their secret project.\nBut it won't be easy for you because this is one of the most guarded place in the world."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "https://tech-tro.com/privacy-policy", "developer_terms_of_service_url": "http://metro2.tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "http://metro2.tech-tro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "CASUAL", "HORROR", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended
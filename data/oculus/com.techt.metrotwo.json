q&_nc_oc=Adqkha5O4bEVFGS7KEgwanlSYOTrEjn8iKybE4044pH6a12kFKSdVS-B6UeiwuxuusQ&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4bAPF3AQnXSnOo5gW0obdhXYNLPteheZmkGjd-OjXowg&oe=6A107A33"}, {"file_name": "migrated_image.png", "id": "226214061910137", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/11162763_143678396273729_6482624053747122176_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UWfffD5huE4Q7kNvwFilJ7w&_nc_oc=AdpgDevLT-23EhlbDE0gPMJBtA6bN94xIUiuvNHi0zZxsafa3R0RrQ7DDl1o155ePxw&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7JF5kobOUHsXtn1Cff05y4GPgIbf6Zug19Ltb0a8EYJg&oe=6A106E6C"}, {"file_name": "migrated_image.png", "id": "212102596672796", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/11162707_138523736788646_2960305160795979776_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BSSoUr25ikMQ7kNvwEbFwxK&_nc_oc=Adr3mwtR4QxysBwxn-L1h_WPbOYej4xdD6VT8ApB-y4-0T-0VL5IDy0lO8ncTuqmp-0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-RPqsoZgFpejsFWAl-oWNAmu2Eads9qDfQA0eZvyS-Q&oe=6A106AD4"}, {"file_name": "migrated_image.png", "id": "208540827159608", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/11162702_124387201576475_5406613443337781248_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ixk9xbnoyMcQ7kNvwHrgddi&_nc_oc=AdrHxw3HiwE43Zp8bCwfNbTKzmPKo6uMzxfCpbYXZbbHividveEu1jnA2TBQ0NId9Qc&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6QuIl2Q-U2wY1Zk7U_QiaXjoph_wHUGhPopc1vv-eKJQ&oe=6A1078B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "2007762539505711", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/11162703_2007762542839044_612867755552538624_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5xeEvZHIcHsQ7kNvwGkSVDN&_nc_oc=AdrQGO7PjZFjliTDxaPFSj5ztsArGJ375PSn4-snX5wokbS06TZhj1PUclKEwQpKoCk&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6P1Arm9YPzAJm6SchHPsqOhlKP_i6poxFcvdHBUP3jMw&oe=6A107918"}, "display_name": "Metro-2: Project Kollie", "keywords": ["zombie", "coldwar", "spy", "undead", "execution"], "long_description": "Be part of an exciting cold war spy story.\n\nA secret Soviet project started in 1958. Its goal was to create the most effective super weapon. Doctors, scientists, engineers and soliders worked together to indite bio-robots for the Russian army. After many consecutive failures the Central Committee closed down the project in 1969 and all the information became classified. The KGB continued the research in an underground facility without the Comittee's knowledge and in 1982 the team had some primitive results. As a CIA agent you have to infiltrate into this facility and gather as much information as possible about the project.\nBut it won't be easy for you because this is one of the most guarded place in the world.\n\nFeatures: \n- fight against zombies and cyborgs\n- cold war story\n- unique execution system\n- exciting fps combat\n- amazing graphics", "short_description": "Be part of an exciting cold war spy story.\n\nAs a CIA agent you have to infiltrate into a soviet underground facility and gather as much information as possible about their secret project.\nBut it won't be easy for you because this is one of the most guarded place in the world."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "https://tech-tro.com/privacy-policy", "developer_terms_of_service_url": "http://metro2.tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "http://metro2.tech-tro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "CASUAL", "HORROR", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended
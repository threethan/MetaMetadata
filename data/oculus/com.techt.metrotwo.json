z&_nc_oc=AdpVDnbRshvwaL7yKojUcVI2sq3LuZCbuMwsiFhwj8YXw3oLkphWD8DNWPCPJ-pw1PU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzrzD9NBxfiYegzPwIQrraZ9jbs0KDDDzkRVFEU-Ebt0Q&oe=69C910F3"}, {"file_name": "migrated_image.png", "id": "226214061910137", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162763_143678396273729_6482624053747122176_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iJhreLGbYBkQ7kNvwFPjBKU&_nc_oc=AdqKXlC_MIMOG-msMEQKoEBuZ2zQmwFGWucnScazJO6vKb5Dz50aICnKiW2K_a5Vf_4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw-WaFa0rgmYmQk_RI0sj2y3e8VEKhalm3nhN00ot-7NQ&oe=69C9052C"}, {"file_name": "migrated_image.png", "id": "212102596672796", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162707_138523736788646_2960305160795979776_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cZX4M95DE1kQ7kNvwEvZqUg&_nc_oc=Adp_DWfx1o8sTFChAvGL5-iFAWfSaxvP93I682-gIFqWY482t2sjC4OUbj_c2mexq88&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy_I7Ik0UgPtpwVGs7oy6nEmWPW4br-ZjrDa-avtGtshg&oe=69C939D4"}, {"file_name": "migrated_image.png", "id": "208540827159608", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162702_124387201576475_5406613443337781248_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QCgAaO9Ku74Q7kNvwEnpDxA&_nc_oc=Adrg90TNFBRh0EBhlrKGSXGV3kyo0F-Rjz6rEv_jODDGaUelMX-XtbE0k2do5hspq58&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw90wFxi4dG9sh7S8UAxlTlyZtD_Sgk371HisJhvFBR8A&oe=69C90F73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "2007762539505711", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162703_2007762542839044_612867755552538624_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qEKpY4w8Q8QQ7kNvwHiNRqe&_nc_oc=AdopwxK6HZd7BjQB9xPx7vIR59_BmjZ--a92lWFvq7vFL79fwXcNW_wfx7fvtKsQ6vI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzA1NZEwS8uCOLV1iEoVpgfJfAAKUxuGtif38j3UNITdg&oe=69C90FD8"}, "display_name": "Metro-2: Project Kollie", "keywords": ["zombie", "coldwar", "spy", "undead", "execution"], "long_description": "Be part of an exciting cold war spy story.\n\nA secret Soviet project started in 1958. Its goal was to create the most effective super weapon. Doctors, scientists, engineers and soliders worked together to indite bio-robots for the Russian army. After many consecutive failures the Central Committee closed down the project in 1969 and all the information became classified. The KGB continued the research in an underground facility without the Comittee's knowledge and in 1982 the team had some primitive results. As a CIA agent you have to infiltrate into this facility and gather as much information as possible about the project.\nBut it won't be easy for you because this is one of the most guarded place in the world.\n\nFeatures: \n- fight against zombies and cyborgs\n- cold war story\n- unique execution system\n- exciting fps combat\n- amazing graphics", "short_description": "Be part of an exciting cold war spy story.\n\nAs a CIA agent you have to infiltrate into a soviet underground facility and gather as much information as possible about their secret project.\nBut it won't be easy for you because this is one of the most guarded place in the world."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "https://tech-tro.com/privacy-policy", "developer_terms_of_service_url": "http://metro2.tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "http://metro2.tech-tro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "CASUAL", "HORROR", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended
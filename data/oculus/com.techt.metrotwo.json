z&_nc_oc=AdpThcPmgo8GxHzoyMn2umVSpLh7ErtgNDRQcSjH6SMZrVYBDs_i4zed99ls4z0ZRdE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPWYyobJn2seB3BxuDUHRi4Ehftd_bjmgM_F5tgGBHe-w&oe=6AD0F533"}, {"file_name": "migrated_image.png", "id": "226214061910137", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162763_143678396273729_6482624053747122176_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kCw955vg6BAQ7kNvwH5Q6CR&_nc_oc=Adrb1AljvncBTDJxxs3P_Fp81m7QVfUpYA-m3nbD15cC3hmkwSyIKvV8bktkLPhnA4s&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_A0JtsVsTaXm_cZyagidjsg4Z_1aA_BHnhIUoaA09Mw&oe=6AD0E96C"}, {"file_name": "migrated_image.png", "id": "212102596672796", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/11162707_138523736788646_2960305160795979776_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wHa9aCuDxPEQ7kNvwGCpASa&_nc_oc=AdrCIflIe5ehSUoc2Ag7ZlXtEIovF8SGAFgasrqiVC7YoFWsXml8lAi54KuDuUcfZ80&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM3rop9Mb63lhP9Tn_s-R15gx8_Cr1LnqAWIZeUFB5BQQ&oe=6AD0E5D4"}, {"file_name": "migrated_image.png", "id": "208540827159608", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162702_124387201576475_5406613443337781248_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tjEce524vZkQ7kNvwFPj-MG&_nc_oc=Adoj8RtyW7CZMbHWeR9Dfb5H0l9fyYDBhDGKT1ZepV0VFV643jeukpSkVFZJw0i-8OA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPa7Tc_HDXVyCy2_lR_a5HdOMwo-G8qfLm4p9f4wfmmkw&oe=6AD0F3B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "2007762539505711", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/11162703_2007762542839044_612867755552538624_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SwTrgIdgudUQ7kNvwEm6wsM&_nc_oc=Adr6jigF17cPcf0Sa26R46YBfF4wvGGKcw75pMJYdH2YA4HUNCr3AhdNJG8N5VzmfAo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOW2TSsSa-Su9zR27Mm7_lUmnGSJZ5n0TGW5x3WFn_43Q&oe=6AD0F418"}, "display_name": "Metro-2: Project Kollie", "keywords": ["zombie", "coldwar", "spy", "undead", "execution"], "long_description": "Be part of an exciting cold war spy story.\n\nA secret Soviet project started in 1958. Its goal was to create the most effective super weapon. Doctors, scientists, engineers and soliders worked together to indite bio-robots for the Russian army. After many consecutive failures the Central Committee closed down the project in 1969 and all the information became classified. The KGB continued the research in an underground facility without the Comittee's knowledge and in 1982 the team had some primitive results. As a CIA agent you have to infiltrate into this facility and gather as much information as possible about the project.\nBut it won't be easy for you because this is one of the most guarded place in the world.\n\nFeatures: \n- fight against zombies and cyborgs\n- cold war story\n- unique execution system\n- exciting fps combat\n- amazing graphics", "short_description": "Be part of an exciting cold war spy story.\n\nAs a CIA agent you have to infiltrate into a soviet underground facility and gather as much information as possible about their secret project.\nBut it won't be easy for you because this is one of the most guarded place in the world."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "https://tech-tro.com/privacy-policy", "developer_terms_of_service_url": "http://metro2.tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "http://metro2.tech-tro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "CASUAL", "HORROR", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended
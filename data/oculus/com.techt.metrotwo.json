5&_nc_oc=AdqOBJvUS9DVwATRsICyiIw0L7bjDGvXnDwGvchowOJVVRghpA1Gl4r5OevYGGQRHeQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2-MOIRXxFmB8xhseT4LHfT_13O-zkT9ma3bY8bqFzpRQ&oe=69ECA973"}, {"file_name": "migrated_image.png", "id": "226214061910137", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162763_143678396273729_6482624053747122176_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=daWkpJbEI1gQ7kNvwH8DFhX&_nc_oc=Adqj8SmL71TNV-fML443f4zLl0yCv7916m8tWD9xkSJSeFl3uil0rjfq1XRrNcxV-is&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Olvh504PrRacDCpoBBjlA_Ee2XKK2nnljj48UC8RWsQ&oe=69ECD5EC"}, {"file_name": "migrated_image.png", "id": "212102596672796", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162707_138523736788646_2960305160795979776_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R2MjVLurmcAQ7kNvwHD3ncG&_nc_oc=Adqlyc4bbn3DWDJKjnMvGQPwTE_ndx-r9Uo-46RQ1-uD9T0JHxMVYhSX8DSQoWUURJk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3qZqKiGLBYAalU_WK8YfG7zNqkQi73RU6oECu22smcgQ&oe=69ECD254"}, {"file_name": "migrated_image.png", "id": "208540827159608", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162702_124387201576475_5406613443337781248_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T8j4Dxk4AxsQ7kNvwFAIjwU&_nc_oc=Adocf86HTahXqwFGUhZuHaciuP5sWU7hruxe2SM0LSoE-m6Dya-Gp_ZFUc6wcoqCnR8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3gvUnujrf-LxRrM1FFs5XPWME7K6p7Kb0ti4u6SA2a-Q&oe=69ECA7F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "2007762539505711", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162703_2007762542839044_612867755552538624_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZVizCYh1gl8Q7kNvwF8XSA2&_nc_oc=AdoXSTJJBBRxs5szaV04cq8AMMejXvtKz6Mg2MQTCTQcxICdK5D9XRCAj-Cozrg-pIg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1LCMLFxu--OWPlG5rYJTsPOauvT8G1m4UaOtqGBgHtEw&oe=69ECA858"}, "display_name": "Metro-2: Project Kollie", "keywords": ["zombie", "coldwar", "spy", "undead", "execution"], "long_description": "Be part of an exciting cold war spy story.\n\nA secret Soviet project started in 1958. Its goal was to create the most effective super weapon. Doctors, scientists, engineers and soliders worked together to indite bio-robots for the Russian army. After many consecutive failures the Central Committee closed down the project in 1969 and all the information became classified. The KGB continued the research in an underground facility without the Comittee's knowledge and in 1982 the team had some primitive results. As a CIA agent you have to infiltrate into this facility and gather as much information as possible about the project.\nBut it won't be easy for you because this is one of the most guarded place in the world.\n\nFeatures: \n- fight against zombies and cyborgs\n- cold war story\n- unique execution system\n- exciting fps combat\n- amazing graphics", "short_description": "Be part of an exciting cold war spy story.\n\nAs a CIA agent you have to infiltrate into a soviet underground facility and gather as much information as possible about their secret project.\nBut it won't be easy for you because this is one of the most guarded place in the world."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "https://tech-tro.com/privacy-policy", "developer_terms_of_service_url": "http://metro2.tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "http://metro2.tech-tro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "CASUAL", "HORROR", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended
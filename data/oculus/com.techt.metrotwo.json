R&_nc_oc=AdqTrHLeFrVOKDSe7vZ_p9e0LO4LL_oOXjrBot60CYGZg8IBQ_X1Fo9JjQeaCcQXoI8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8VNzP2AdcGXnyBCcjSeuVu7zCtTBCv6bfgs4SApazbVA&oe=6A3E9EB3"}, {"file_name": "migrated_image.png", "id": "226214061910137", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162763_143678396273729_6482624053747122176_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HySSG0RJ6MwQ7kNvwFR-05w&_nc_oc=AdohOr8bf6siK9FrY-29u4M3pVJ5SIYge3k30NBG5J3qM6UsZoXoY0Auf-MhPfK_vx0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-VHlfb9KYgOSIkEEfRWK0HE-_RERCs7FFDSRU_Vcw-3w&oe=6A3E92EC"}, {"file_name": "migrated_image.png", "id": "212102596672796", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162707_138523736788646_2960305160795979776_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xz-mW1QZx-8Q7kNvwHuboST&_nc_oc=AdrokiPKlukomzVLH6EX7aPBaTcUB_8vMIVH5q8GhiCfPgjr9Vygm69RHSWFyuG5ado&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9onwa95wKAYyPi8qvedqloNCuZqmOnbyiDjn2OJ9MXTw&oe=6A3E8F54"}, {"file_name": "migrated_image.png", "id": "208540827159608", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162702_124387201576475_5406613443337781248_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pHOfOHr8RIAQ7kNvwGzgQRU&_nc_oc=AdrKYiCYMnA5D5o3Xxs-c0KPZ9ta6NqnjygKzXEbjrgHMYU5BylCafqSzZU_Xzf9W88&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90dtIgWoVkEYkC7CSHhicNYEP9LRxZhIQZ51NnH0d_ug&oe=6A3E9D33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "2007762539505711", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162703_2007762542839044_612867755552538624_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TbWiMYS74zMQ7kNvwGnvy8E&_nc_oc=AdqlQMaxqkLbQAw8QSTP1uLiay1-UIsvffWC9xJRW46qeAWPeHF5EvbCUAfmTNmvIE4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-e7xOnV6hlsD0F_V6W6Pb410B2hFL-n860jSZOHokenw&oe=6A3E9D98"}, "display_name": "Metro-2: Project Kollie", "keywords": ["zombie", "coldwar", "spy", "undead", "execution"], "long_description": "Be part of an exciting cold war spy story.\n\nA secret Soviet project started in 1958. Its goal was to create the most effective super weapon. Doctors, scientists, engineers and soliders worked together to indite bio-robots for the Russian army. After many consecutive failures the Central Committee closed down the project in 1969 and all the information became classified. The KGB continued the research in an underground facility without the Comittee's knowledge and in 1982 the team had some primitive results. As a CIA agent you have to infiltrate into this facility and gather as much information as possible about the project.\nBut it won't be easy for you because this is one of the most guarded place in the world.\n\nFeatures: \n- fight against zombies and cyborgs\n- cold war story\n- unique execution system\n- exciting fps combat\n- amazing graphics", "short_description": "Be part of an exciting cold war spy story.\n\nAs a CIA agent you have to infiltrate into a soviet underground facility and gather as much information as possible about their secret project.\nBut it won't be easy for you because this is one of the most guarded place in the world."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "https://tech-tro.com/privacy-policy", "developer_terms_of_service_url": "http://metro2.tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "http://metro2.tech-tro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "CASUAL", "HORROR", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended
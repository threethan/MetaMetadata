L&_nc_oc=AdrdtP0Y-SSPq7ip6HJhQaalbExfqutahcW2BsP_VYM7zp9DeQUnuZq2q9AeRv_ChtU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIh9N_RV2v7GrRFRrbhNaeK8q4TWSPCCSnrUy_DRAKrhA&oe=6ABA8BB3"}, {"file_name": "migrated_image.png", "id": "226214061910137", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162763_143678396273729_6482624053747122176_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W043nhFOxZEQ7kNvwFbYYrN&_nc_oc=Ado017jH56goMReipJ1TmMYXQqoPQxko0iZ2ACNhpReDG0rKVBEyMz1YV6ZBeDGTa20&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKYW9kng-U5-b3Wwm-vasJeKP2KvxOGzbY8p_MqnD1TVQ&oe=6ABA7FEC"}, {"file_name": "migrated_image.png", "id": "212102596672796", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162707_138523736788646_2960305160795979776_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dHKhqFgPuBgQ7kNvwGJIVor&_nc_oc=Adq5BYqbVuN3yZ9LBLxEWz777qLtZBHfIePwiB0rnSc1zVTaNtgTeOIek2vnKf7njr8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0_agmzFoNegOXfDaROILv32lpNqSgFDre-XQH--07jw&oe=6ABA7C54"}, {"file_name": "migrated_image.png", "id": "208540827159608", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162702_124387201576475_5406613443337781248_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XU4A0Bq_YHsQ7kNvwHnKLLz&_nc_oc=AdpKZS2TulzcY7hbTY14KUII-kzSnmdruqqG1WKf2-E0ndJBUzWdjGLVhACtzqsOyGo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLi1G9DNipZhGGOQ6EqSSwKZGaYHqP_vYOdRCnp6KV_YQ&oe=6ABA8A33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "2007762539505711", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162703_2007762542839044_612867755552538624_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R1UcdOI0wzkQ7kNvwFrq5kd&_nc_oc=AdoRJjaEHuS_Zx9uGtmY6zisbmPEt2yS56fbY1lg-AKvO8CqBYeg-6PtF7b2kbPiM4o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKL-2RlKY5iEXyyt9PaOlPyMR5_Sou03NH9fiNlU88blg&oe=6ABA8A98"}, "display_name": "Metro-2: Project Kollie", "keywords": ["zombie", "coldwar", "spy", "undead", "execution"], "long_description": "Be part of an exciting cold war spy story.\n\nA secret Soviet project started in 1958. Its goal was to create the most effective super weapon. Doctors, scientists, engineers and soliders worked together to indite bio-robots for the Russian army. After many consecutive failures the Central Committee closed down the project in 1969 and all the information became classified. The KGB continued the research in an underground facility without the Comittee's knowledge and in 1982 the team had some primitive results. As a CIA agent you have to infiltrate into this facility and gather as much information as possible about the project.\nBut it won't be easy for you because this is one of the most guarded place in the world.\n\nFeatures: \n- fight against zombies and cyborgs\n- cold war story\n- unique execution system\n- exciting fps combat\n- amazing graphics", "short_description": "Be part of an exciting cold war spy story.\n\nAs a CIA agent you have to infiltrate into a soviet underground facility and gather as much information as possible about their secret project.\nBut it won't be easy for you because this is one of the most guarded place in the world."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "https://tech-tro.com/privacy-policy", "developer_terms_of_service_url": "http://metro2.tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "http://metro2.tech-tro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "CASUAL", "HORROR", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended
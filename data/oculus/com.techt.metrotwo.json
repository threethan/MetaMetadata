y&_nc_oc=Adr5usrKr5xMR1hn3nQrsW9TeOg2g7qwKG56cAjZeH6AIe0Jvnx12qKQoNztXTNgvos&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDo84V53Ivato8ZZAbDrXBqrkNdnFH2ySkQ5Do_kLnBuQ&oe=6A677D33"}, {"file_name": "migrated_image.png", "id": "226214061910137", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162763_143678396273729_6482624053747122176_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JD9e-Ys8_dsQ7kNvwGbzIgL&_nc_oc=Adpk28XKX7VQh072mKiHXeYsZDPLE0V4lpIj8XtF-ypN_JH_9TJ2jC_IE3zvCuMRlRI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDPWxcXmolaOJgXY-Tmi8016aXgV5VO8igVMv1dR-chHQ&oe=6A67716C"}, {"file_name": "migrated_image.png", "id": "212102596672796", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162707_138523736788646_2960305160795979776_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6IbwAEAWpmUQ7kNvwHHGM2T&_nc_oc=Adpua3nKREC4bPalCnmncGExvSNfR9ZvDtjtM2HFbrr6iVmyPl2fNM2c7NZ7_Lan2HU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBKz82aToKA4RVoLBuwmGgWAbfFW3nemM-O05Cgz1s_rA&oe=6A676DD4"}, {"file_name": "migrated_image.png", "id": "208540827159608", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162702_124387201576475_5406613443337781248_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BfdorwLMs4oQ7kNvwH77Bjr&_nc_oc=AdqAcwNFKcRzNVSjo2yPsbwTXaR9kYV11B50qaZJbgXla6doRIrSxuOubyh5Z45hP0w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDnHZKiuWDwmayfD2zc0WKhxoDFYY8itnxVi26IIEsVLA&oe=6A677BB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "2007762539505711", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162703_2007762542839044_612867755552538624_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uxytO0Z-McoQ7kNvwFItMn7&_nc_oc=Adpn-vLiHQiH-XAFivDtRFhtBBaj1DFWrlVpuD0PPvtB-54X08-6p1tjCBzvIPGFz88&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBCTfhbSRfofJgVFC6N1kDKFddh_bh0VfYiMaPxtvwIwA&oe=6A677C18"}, "display_name": "Metro-2: Project Kollie", "keywords": ["zombie", "coldwar", "spy", "undead", "execution"], "long_description": "Be part of an exciting cold war spy story.\n\nA secret Soviet project started in 1958. Its goal was to create the most effective super weapon. Doctors, scientists, engineers and soliders worked together to indite bio-robots for the Russian army. After many consecutive failures the Central Committee closed down the project in 1969 and all the information became classified. The KGB continued the research in an underground facility without the Comittee's knowledge and in 1982 the team had some primitive results. As a CIA agent you have to infiltrate into this facility and gather as much information as possible about the project.\nBut it won't be easy for you because this is one of the most guarded place in the world.\n\nFeatures: \n- fight against zombies and cyborgs\n- cold war story\n- unique execution system\n- exciting fps combat\n- amazing graphics", "short_description": "Be part of an exciting cold war spy story.\n\nAs a CIA agent you have to infiltrate into a soviet underground facility and gather as much information as possible about their secret project.\nBut it won't be easy for you because this is one of the most guarded place in the world."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "https://tech-tro.com/privacy-policy", "developer_terms_of_service_url": "http://metro2.tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "http://metro2.tech-tro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "CASUAL", "HORROR", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended
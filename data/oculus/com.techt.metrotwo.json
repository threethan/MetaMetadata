2&_nc_oc=AdrdkFMH3DjZ3jFS8MYIK-enNQF_gBYzWJlTBI4FIR11sv_omvLs1SbUmE7OuDoVlNU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMRUL15BomK0S2Gm47a4PcULpM9GoKkwwFfMbyOS-TTXw&oe=6ACA5DB3"}, {"file_name": "migrated_image.png", "id": "226214061910137", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162763_143678396273729_6482624053747122176_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EpiGT-lv4nwQ7kNvwHC4tQH&_nc_oc=AdoRYlKfxz2eCTLeWow3hleVbFYqnUAhP7p_xTVr4m42gcvOT9ONKN1fMEXZB4f8Ats&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMPBVPIJ-k1dLTZOyIMBoUiqVbIcw3ckpPTVEDcB_mIig&oe=6ACA51EC"}, {"file_name": "migrated_image.png", "id": "212102596672796", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162707_138523736788646_2960305160795979776_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V39eXFeqOEMQ7kNvwFyloTy&_nc_oc=Adp2ONcrLIlccMyjQ9H_hlHvBQd2GrB5xReKgHL1xUlqDYKWQTHkgcvvYH23x46Pc5o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN7LIJk89Jm_ZIhXkeaYUvXzSI1yOM-nzhssboebTIzJg&oe=6ACA4E54"}, {"file_name": "migrated_image.png", "id": "208540827159608", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162702_124387201576475_5406613443337781248_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UBg3w8jL6QQQ7kNvwEn2DtX&_nc_oc=AdqMsmyKxHDZImzQbAdQ-vnAwwGql4LE9xnhbeOXD1Vs8wsIkIijylMctuZ_uXMPL_8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-rFokZoj6THKXUlTg76ceoHnVYRc4JrBPPEmVcF7VbA&oe=6ACA5C33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "2007762539505711", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162703_2007762542839044_612867755552538624_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yc_HofmEvwwQ7kNvwG3Rwz4&_nc_oc=AdpjvjUw56o-Mc9bN_wpYsr3haQdxcRUks9NTGo_P0BkqXfI0AzEcJoJWcRdk4Wo4RU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMx7yOegstv32NMzItljVZTccsnccL_X9GDMSBDmL0pbQ&oe=6ACA5C98"}, "display_name": "Metro-2: Project Kollie", "keywords": ["zombie", "coldwar", "spy", "undead", "execution"], "long_description": "Be part of an exciting cold war spy story.\n\nA secret Soviet project started in 1958. Its goal was to create the most effective super weapon. Doctors, scientists, engineers and soliders worked together to indite bio-robots for the Russian army. After many consecutive failures the Central Committee closed down the project in 1969 and all the information became classified. The KGB continued the research in an underground facility without the Comittee's knowledge and in 1982 the team had some primitive results. As a CIA agent you have to infiltrate into this facility and gather as much information as possible about the project.\nBut it won't be easy for you because this is one of the most guarded place in the world.\n\nFeatures: \n- fight against zombies and cyborgs\n- cold war story\n- unique execution system\n- exciting fps combat\n- amazing graphics", "short_description": "Be part of an exciting cold war spy story.\n\nAs a CIA agent you have to infiltrate into a soviet underground facility and gather as much information as possible about their secret project.\nBut it won't be easy for you because this is one of the most guarded place in the world."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "https://tech-tro.com/privacy-policy", "developer_terms_of_service_url": "http://metro2.tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "http://metro2.tech-tro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "CASUAL", "HORROR", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended
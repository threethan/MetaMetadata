4&_nc_oc=AdrJeRta-AP1ldFQiqT6dA6PH4dT16N5TaYecB0dDqo9XyUoZLbMzf5fKei3HnSliF0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPwp-hXO6L2xTS9dkthhTvvZIqvWt4BwFK3WpKvvIRzeA&oe=6AC12333"}, {"file_name": "migrated_image.png", "id": "226214061910137", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162763_143678396273729_6482624053747122176_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e_b4Ty6J6i8Q7kNvwG1HWig&_nc_oc=Ado9irR6sRF_BNBSh1NXU47mcoJEt9iWe35BzlmyecgAi_sV-rWA7pODxMM9ccJO8h4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMhkq8FWni-0wyRLaDr_JsJzUel6EhKDXgqf34r7x37gQ&oe=6AC1176C"}, {"file_name": "migrated_image.png", "id": "212102596672796", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162707_138523736788646_2960305160795979776_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fPX6fsxtCYMQ7kNvwGZMNaZ&_nc_oc=AdqRlOYheh_KhWNn_aTCfXA0ZxA4EjmJcX_NjyquUkyEoDB2cygXO371yHCi8LrIImo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP7cmuRknz34R5Po2Nq7aJuOifO95zbCuc6Qq8G-oIfAQ&oe=6AC113D4"}, {"file_name": "migrated_image.png", "id": "208540827159608", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162702_124387201576475_5406613443337781248_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eUX5H-qQWXoQ7kNvwFeB72p&_nc_oc=AdpBV_QMzXSHEW2bDtS4pjpw2dLw-9rM1R0cJ1WYC75h0PyzDGNbwOxs2lzYCnHi8EE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZ9Znuz9rrlX5coKuMUyiOFRc-43j-nh9Ya8zuKGQgig&oe=6AC121B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "2007762539505711", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162703_2007762542839044_612867755552538624_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=esmJfkGjqj8Q7kNvwFK_lRk&_nc_oc=AdrQ-XtZO49Kl8FdbNntX7dLvKVZZdHiYyvQDwpjmTeHREoMrcnLagtQQEd5_IJpEQI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMhubmq2hWwndfW24Gp9kmozbwws4qtk34X-G5HTrAKrg&oe=6AC12218"}, "display_name": "Metro-2: Project Kollie", "keywords": ["zombie", "coldwar", "spy", "undead", "execution"], "long_description": "Be part of an exciting cold war spy story.\n\nA secret Soviet project started in 1958. Its goal was to create the most effective super weapon. Doctors, scientists, engineers and soliders worked together to indite bio-robots for the Russian army. After many consecutive failures the Central Committee closed down the project in 1969 and all the information became classified. The KGB continued the research in an underground facility without the Comittee's knowledge and in 1982 the team had some primitive results. As a CIA agent you have to infiltrate into this facility and gather as much information as possible about the project.\nBut it won't be easy for you because this is one of the most guarded place in the world.\n\nFeatures: \n- fight against zombies and cyborgs\n- cold war story\n- unique execution system\n- exciting fps combat\n- amazing graphics", "short_description": "Be part of an exciting cold war spy story.\n\nAs a CIA agent you have to infiltrate into a soviet underground facility and gather as much information as possible about their secret project.\nBut it won't be easy for you because this is one of the most guarded place in the world."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "https://tech-tro.com/privacy-policy", "developer_terms_of_service_url": "http://metro2.tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "http://metro2.tech-tro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "CASUAL", "HORROR", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended
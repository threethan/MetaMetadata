F&_nc_oc=AdqoI3NzXMLV77viXcsvMMEzdoL0GCIZyPd9WHhRzKoU-PWgKFHN7ydv3Ha6p81eOVI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9koR1PaUfNjAZyeApQwEHeeyWXXOL_DtHAIMe-tBfZEQ&oe=6A47D933"}, {"file_name": "migrated_image.png", "id": "226214061910137", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162763_143678396273729_6482624053747122176_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2T3Vnxc0oooQ7kNvwHveCPL&_nc_oc=Adpb9Ml7xby0TqMynotXTwR9jGhMfjg7MgwmltS0hD2nAyCLBjEvsKUvuq8wTiK-XKY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8B062d1FwoaRabzBg6hbz8Ln60kQ3_HJwA3MJxOTEM_g&oe=6A47CD6C"}, {"file_name": "migrated_image.png", "id": "212102596672796", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162707_138523736788646_2960305160795979776_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bT-MyL2SsG0Q7kNvwGv3GsH&_nc_oc=AdqA5QnO3f8ehrXYXYkTmxbxRlOHoORBi-pTwOz00kBEEKUA3zc9ydhwWDL_EZvl92k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_oKG7oStJdgDNBav1xar7iVPqT35k39Xma5sVeRbrXfA&oe=6A47C9D4"}, {"file_name": "migrated_image.png", "id": "208540827159608", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162702_124387201576475_5406613443337781248_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qJQp4bkevxIQ7kNvwGuk_oW&_nc_oc=Adq_OClXNA2X1p5KIc8Ln9hGQAHFBk4fJnG_Q87RAL30PJ8O_X4gWN8AL1cKduFIyZA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_dzNP524Xm0m4LPu97b3IILSJxD3_ZACmc3DAzX-iqZg&oe=6A47D7B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "2007762539505711", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162703_2007762542839044_612867755552538624_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FnEieuPUrAAQ7kNvwEGchPo&_nc_oc=AdqPRUSPeNcbEq0E3VISYmzx3Inrgh5Ai7qgyU9I9fdIv8QP_wUYWnRKXWue2sI6i7c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8wVZyBDyZB39-eFXpZypxN6z0YoAl8ejOIoRgi_zK5tQ&oe=6A47D818"}, "display_name": "Metro-2: Project Kollie", "keywords": ["zombie", "coldwar", "spy", "undead", "execution"], "long_description": "Be part of an exciting cold war spy story.\n\nA secret Soviet project started in 1958. Its goal was to create the most effective super weapon. Doctors, scientists, engineers and soliders worked together to indite bio-robots for the Russian army. After many consecutive failures the Central Committee closed down the project in 1969 and all the information became classified. The KGB continued the research in an underground facility without the Comittee's knowledge and in 1982 the team had some primitive results. As a CIA agent you have to infiltrate into this facility and gather as much information as possible about the project.\nBut it won't be easy for you because this is one of the most guarded place in the world.\n\nFeatures: \n- fight against zombies and cyborgs\n- cold war story\n- unique execution system\n- exciting fps combat\n- amazing graphics", "short_description": "Be part of an exciting cold war spy story.\n\nAs a CIA agent you have to infiltrate into a soviet underground facility and gather as much information as possible about their secret project.\nBut it won't be easy for you because this is one of the most guarded place in the world."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "https://tech-tro.com/privacy-policy", "developer_terms_of_service_url": "http://metro2.tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "http://metro2.tech-tro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "CASUAL", "HORROR", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended
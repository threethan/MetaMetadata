U&_nc_oc=Adrq5Okpn6J7Cx-1mC0bp3fXGETz3IPGgbxNfFQiTghKxaQyGVBIffUPhxa3rU3XrY4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLrvtkBp3gUuT1DBvNS8mHVFDNz2tiZLRYAF-aH1pZRZw&oe=6AAD5CB3"}, {"file_name": "migrated_image.png", "id": "226214061910137", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162763_143678396273729_6482624053747122176_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Uzwy3DZ80AQ7kNvwGh0oFN&_nc_oc=AdqAj_4GK8f8joSpJmZ0iUZZ0f5AAgJhhmLq6rXEGSEs1xr_T94T7KasHxWwgrEsnnc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDXC2OEfoSWTA5JzwlpYmXFIbzvxSFdv7gLiyub6CD9A&oe=6AAD50EC"}, {"file_name": "migrated_image.png", "id": "212102596672796", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162707_138523736788646_2960305160795979776_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rrKNmTozSwsQ7kNvwEcY7SW&_nc_oc=Adqh9Zx69b70RycM5UO35Bq4xFTQhtoK_G5xdLOMC6-M6cNhMpnyNEdca9jYpy_G_UU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvQmieoHt4q3zJxPWSlUHakTB3g3UtaAvU3IBy8c9kcg&oe=6AAD4D54"}, {"file_name": "migrated_image.png", "id": "208540827159608", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162702_124387201576475_5406613443337781248_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mEQiW4VLVoAQ7kNvwEOwuad&_nc_oc=AdrwyWcLehtMhoKnt9j8dgJpRAE5EAq3nSYXm1MIgu3SSyEydGqeCsT1d2Atx6uPeFI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLMRbacX610qJxu8bqHpEtiUh-To9sgMTLTHPc8ylh5Bg&oe=6AAD5B33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "2007762539505711", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162703_2007762542839044_612867755552538624_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=djxxKg2HRhwQ7kNvwEm7lDi&_nc_oc=AdqahJry49vmowKYoMBN8id1CGTbHo2k18oeblzdFk-I0aJgKBWInTQ6EEkrNXp58w0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJlaKXD1F7YjTlzZ9P1E58QEhA9vllWHdZpBlZadmed7w&oe=6AAD5B98"}, "display_name": "Metro-2: Project Kollie", "keywords": ["zombie", "coldwar", "spy", "undead", "execution"], "long_description": "Be part of an exciting cold war spy story.\n\nA secret Soviet project started in 1958. Its goal was to create the most effective super weapon. Doctors, scientists, engineers and soliders worked together to indite bio-robots for the Russian army. After many consecutive failures the Central Committee closed down the project in 1969 and all the information became classified. The KGB continued the research in an underground facility without the Comittee's knowledge and in 1982 the team had some primitive results. As a CIA agent you have to infiltrate into this facility and gather as much information as possible about the project.\nBut it won't be easy for you because this is one of the most guarded place in the world.\n\nFeatures: \n- fight against zombies and cyborgs\n- cold war story\n- unique execution system\n- exciting fps combat\n- amazing graphics", "short_description": "Be part of an exciting cold war spy story.\n\nAs a CIA agent you have to infiltrate into a soviet underground facility and gather as much information as possible about their secret project.\nBut it won't be easy for you because this is one of the most guarded place in the world."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "https://tech-tro.com/privacy-policy", "developer_terms_of_service_url": "http://metro2.tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "http://metro2.tech-tro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "CASUAL", "HORROR", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended
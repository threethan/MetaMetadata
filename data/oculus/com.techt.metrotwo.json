2&_nc_oc=Adp-LOkuCQrgZBaIkb-AviKKwZXa3PzNo-ImUOSgTLPYL79rETiPEPqFdTWUKI9ywv0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4SMlpYDDEctbzoBNT18JrqbidUArYsDFw2y0zYOlSjnA&oe=6A186333"}, {"file_name": "migrated_image.png", "id": "226214061910137", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162763_143678396273729_6482624053747122176_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TGwxgCA0elYQ7kNvwEaNJDf&_nc_oc=Adrqh-iH5IhtbKKAkIFHme8FUZkKVKBwhX4YuJmEJsGmhuRx10gBN-xLU9mpZvP34S0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af73gACQUQ45OnisPfb0djsqMUiv1n9UFMJogFhVktHuhw&oe=6A18576C"}, {"file_name": "migrated_image.png", "id": "212102596672796", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162707_138523736788646_2960305160795979776_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bHcIiJQ87MUQ7kNvwE6EZkB&_nc_oc=Ado09xdkAz0HmPCwtOk7Dabd7SCwqsUN6IOIXqQTQB-KhJzxK0HZ6str9Pzwa_UxihQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4L5rCnGdcrJPlF_kQnc_-ACSEbV7VXYXknqhRJ6OT55A&oe=6A1853D4"}, {"file_name": "migrated_image.png", "id": "208540827159608", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162702_124387201576475_5406613443337781248_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bL_sPF5Ur5sQ7kNvwEm7Zcp&_nc_oc=AdqOxpRFufo_jdMvaWci625KczkTtWymNDMfsGmnrCCexPmqPajrgE3jyKRViH1rXQc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4mpeWzjkHUGjte825Kdz0NnTeOCMBZMaxGqmSMrQZBLw&oe=6A1861B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "2007762539505711", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162703_2007762542839044_612867755552538624_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_0nH493jL4sQ7kNvwEGY4Fo&_nc_oc=AdrpDBkrKlodKDq_euN6dRxe2f7W5b4cblTP_cpJPA2KOE7f2bsVov8PlNbFJgRfBhE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5eiPLE8mUw2Glh7gqMwghRGuacAWovBdPM0q7SI5bUcA&oe=6A186218"}, "display_name": "Metro-2: Project Kollie", "keywords": ["zombie", "coldwar", "spy", "undead", "execution"], "long_description": "Be part of an exciting cold war spy story.\n\nA secret Soviet project started in 1958. Its goal was to create the most effective super weapon. Doctors, scientists, engineers and soliders worked together to indite bio-robots for the Russian army. After many consecutive failures the Central Committee closed down the project in 1969 and all the information became classified. The KGB continued the research in an underground facility without the Comittee's knowledge and in 1982 the team had some primitive results. As a CIA agent you have to infiltrate into this facility and gather as much information as possible about the project.\nBut it won't be easy for you because this is one of the most guarded place in the world.\n\nFeatures: \n- fight against zombies and cyborgs\n- cold war story\n- unique execution system\n- exciting fps combat\n- amazing graphics", "short_description": "Be part of an exciting cold war spy story.\n\nAs a CIA agent you have to infiltrate into a soviet underground facility and gather as much information as possible about their secret project.\nBut it won't be easy for you because this is one of the most guarded place in the world."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "https://tech-tro.com/privacy-policy", "developer_terms_of_service_url": "http://metro2.tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "http://metro2.tech-tro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "CASUAL", "HORROR", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended
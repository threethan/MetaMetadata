Y&_nc_oc=AdrXPIAvoPEzgVXI5DZZL1f8pbKokc2ncHcUJ-AbnkRKFGtRtb9etYaoSbEALo1LyfQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2OCIhpfGT_y4ySStYmIpsEKyL9QcsyRZbtb-B6Mt7oyw&oe=69D63FF3"}, {"file_name": "migrated_image.png", "id": "226214061910137", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162763_143678396273729_6482624053747122176_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kwUDPnP3e-UQ7kNvwFVPVaC&_nc_oc=AdruMf8bqUXix26LEYFSTXjKDu2dg8Ae8E_1z32sLP761zUMyiECedGcMvZfwrUc0uA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af15W2w1j4B_nR_3oaBKIhYHQXPd0SgFqYQBxpMP0Uisvw&oe=69D6342C"}, {"file_name": "migrated_image.png", "id": "212102596672796", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162707_138523736788646_2960305160795979776_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xGEE_y0GKMUQ7kNvwEOJpnJ&_nc_oc=AdrA7RwV2022WULRh6zEASnDhu3BcEEEZ99dXv0rOKTnrmRFKV1lkqXWle-tX08PMvQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ELc3uyd54MbewWtfxxNV4mRk08wqQ_I08kIM5svjF7Q&oe=69D668D4"}, {"file_name": "migrated_image.png", "id": "208540827159608", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162702_124387201576475_5406613443337781248_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xwvCD-_4D0UQ7kNvwGqKdA0&_nc_oc=Adp6Gtg8eoXClpv9CDbuWfzeYe0EuP2eQtzCvygCcfCiNa9prQq6sYgUGGZJp03mQMY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af39nEI1Ez0ZAHPgx3VIWMSDafEATigdg6EC36mUP0Ts1Q&oe=69D63E73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "2007762539505711", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162703_2007762542839044_612867755552538624_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C3fE3MvYbCgQ7kNvwGVb7jr&_nc_oc=Adr0tz2yWsJ25XTxB0I6WJxjWvuWlHJzwCRJrGKOPOGwTeOLH4oMbV3IS9p6xX93aV4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af272tiAvGRfg-tAOkCyySRYnrdsH0ZpnTf882kP7iKpEA&oe=69D63ED8"}, "display_name": "Metro-2: Project Kollie", "keywords": ["zombie", "coldwar", "spy", "undead", "execution"], "long_description": "Be part of an exciting cold war spy story.\n\nA secret Soviet project started in 1958. Its goal was to create the most effective super weapon. Doctors, scientists, engineers and soliders worked together to indite bio-robots for the Russian army. After many consecutive failures the Central Committee closed down the project in 1969 and all the information became classified. The KGB continued the research in an underground facility without the Comittee's knowledge and in 1982 the team had some primitive results. As a CIA agent you have to infiltrate into this facility and gather as much information as possible about the project.\nBut it won't be easy for you because this is one of the most guarded place in the world.\n\nFeatures: \n- fight against zombies and cyborgs\n- cold war story\n- unique execution system\n- exciting fps combat\n- amazing graphics", "short_description": "Be part of an exciting cold war spy story.\n\nAs a CIA agent you have to infiltrate into a soviet underground facility and gather as much information as possible about their secret project.\nBut it won't be easy for you because this is one of the most guarded place in the world."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "https://tech-tro.com/privacy-policy", "developer_terms_of_service_url": "http://metro2.tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "http://metro2.tech-tro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "CASUAL", "HORROR", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended
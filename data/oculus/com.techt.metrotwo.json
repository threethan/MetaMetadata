Q&_nc_oc=Adp6lbg7Wx91rCfVxNL361BCohbIIzDmuEl9i9mKhqOQv9swday8dAHkUiMmrJMkwx0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWO56SOxHS1hIKTCXGnHBZXsLUzIom__IO9ueG3PTK0g&oe=6A8ADD73"}, {"file_name": "migrated_image.png", "id": "226214061910137", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162763_143678396273729_6482624053747122176_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BYO6yukIUxUQ7kNvwEWLdXC&_nc_oc=AdpQaCD4vv3iIOaqS2x_nBN5tebt7pIlaFfEwyol5zDhY0y2hzTd7BocIOj48Ok_ihg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGMHgbkZ289GD4hYiHJctpV8SxR5j4Y09Xn52BpYVkuGg&oe=6A8AD1AC"}, {"file_name": "migrated_image.png", "id": "212102596672796", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162707_138523736788646_2960305160795979776_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LYm6qhgk9zQQ7kNvwEUzX0N&_nc_oc=Adq08WGpkvqc4wuh2upveqgP3S_a00nerKRAID9TatU3aTMETThOukCmTpL7cz079GA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9clBCmXlTtIgPMJjJC0oMRPHxWuRbIyw-rTTqCJizVA&oe=6A8ACE14"}, {"file_name": "migrated_image.png", "id": "208540827159608", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/11162702_124387201576475_5406613443337781248_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H7e_khtoonIQ7kNvwHMz0nc&_nc_oc=AdrOUXsZ40Yz91DHXnMAfjYlkPCHXAsn38TIjjWC9TQKQKGGEJE0XXSErC4_CxxhPCs&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFUtnvGwMAOC7ePRNXpwu5ymPa6tHXmkCyejDrd9I61rA&oe=6A8ADBF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "2007762539505711", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162703_2007762542839044_612867755552538624_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V5bk5k7CgwUQ7kNvwGOXN1-&_nc_oc=Adq-aIyolThpL8m11Bk9W1KV9uTfbYZnQX5Fp6uuhtHldrmyfN-A35PX51fbu5kv_8k&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGxwqqjWXAtBew3gOJAL57gRpzAwxfM7TaNa-4cnr5Vaw&oe=6A8ADC58"}, "display_name": "Metro-2: Project Kollie", "keywords": ["zombie", "coldwar", "spy", "undead", "execution"], "long_description": "Be part of an exciting cold war spy story.\n\nA secret Soviet project started in 1958. Its goal was to create the most effective super weapon. Doctors, scientists, engineers and soliders worked together to indite bio-robots for the Russian army. After many consecutive failures the Central Committee closed down the project in 1969 and all the information became classified. The KGB continued the research in an underground facility without the Comittee's knowledge and in 1982 the team had some primitive results. As a CIA agent you have to infiltrate into this facility and gather as much information as possible about the project.\nBut it won't be easy for you because this is one of the most guarded place in the world.\n\nFeatures: \n- fight against zombies and cyborgs\n- cold war story\n- unique execution system\n- exciting fps combat\n- amazing graphics", "short_description": "Be part of an exciting cold war spy story.\n\nAs a CIA agent you have to infiltrate into a soviet underground facility and gather as much information as possible about their secret project.\nBut it won't be easy for you because this is one of the most guarded place in the world."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "https://tech-tro.com/privacy-policy", "developer_terms_of_service_url": "http://metro2.tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "http://metro2.tech-tro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "CASUAL", "HORROR", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended
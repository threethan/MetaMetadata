a&_nc_oc=AdoG75Ej2Nm-1C7hQlgo1wtBK4JEUWYBtlOuGNt4ixTB9qpkC_JbFnmS2s3LPK1EKDI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1RQpZuZv2gioO2f_haehObICVA8vRm0fT3TC6EHtscxg&oe=69F5E3F3"}, {"file_name": "migrated_image.png", "id": "226214061910137", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/11162763_143678396273729_6482624053747122176_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1U5z_1OuFrgQ7kNvwFqBvMS&_nc_oc=AdqwkP9D2wBAj0LcCITLolKSy3aPogkuHPFWZW0MyeuBi_ztPMdGKmM_97QdjewamGs&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Zb8WigEdFc-excVXD6HEDJ-LgQKJ5N4uLEO-Ami4u_Q&oe=69F6106C"}, {"file_name": "migrated_image.png", "id": "212102596672796", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/11162707_138523736788646_2960305160795979776_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Zj1P2sVFyEQ7kNvwF-qIYe&_nc_oc=Adr_Tm5vGuUCiw-5IFc8locvpzFgd4d4X8amsFvBsFM_iJQxRDKR2lCxh24EfN08ZtI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af38bf2diKfEoFDBcp-wS2SkMOW-hqVMAnTBYG1kUg7pWA&oe=69F60CD4"}, {"file_name": "migrated_image.png", "id": "208540827159608", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/11162702_124387201576475_5406613443337781248_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b3OgOBjet34Q7kNvwEsh2To&_nc_oc=AdrrDbVQCHc3nRmovbHCrVBR7LDOjL4CvZM68mZDTrhjFyCKfVLpHSrl1jt2TZyHnIs&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2fbjXlJMOvhwMmPTC9OtI8jJMSgeTPRBzBBDZi_rBJNA&oe=69F61AB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "2007762539505711", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/11162703_2007762542839044_612867755552538624_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RI5-ipdilTIQ7kNvwEdJ7gw&_nc_oc=Ado6lmhhhVZ3yusVqUuyuEkWIM_9wJB1xLSkgPsDvZrT63AjLlj2ejEfy5V4qYyWF_Y&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2KRJsKa2ou2gMKCS9V1GX889w1xpfHOa0UeCvrEFOnCg&oe=69F61B18"}, "display_name": "Metro-2: Project Kollie", "keywords": ["zombie", "coldwar", "spy", "undead", "execution"], "long_description": "Be part of an exciting cold war spy story.\n\nA secret Soviet project started in 1958. Its goal was to create the most effective super weapon. Doctors, scientists, engineers and soliders worked together to indite bio-robots for the Russian army. After many consecutive failures the Central Committee closed down the project in 1969 and all the information became classified. The KGB continued the research in an underground facility without the Comittee's knowledge and in 1982 the team had some primitive results. As a CIA agent you have to infiltrate into this facility and gather as much information as possible about the project.\nBut it won't be easy for you because this is one of the most guarded place in the world.\n\nFeatures: \n- fight against zombies and cyborgs\n- cold war story\n- unique execution system\n- exciting fps combat\n- amazing graphics", "short_description": "Be part of an exciting cold war spy story.\n\nAs a CIA agent you have to infiltrate into a soviet underground facility and gather as much information as possible about their secret project.\nBut it won't be easy for you because this is one of the most guarded place in the world."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "https://tech-tro.com/privacy-policy", "developer_terms_of_service_url": "http://metro2.tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "http://metro2.tech-tro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "CASUAL", "HORROR", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended
N&_nc_oc=Adowe9R4-D0YfskS8JJLuzXFfYvQW3UMm2tmU-6cLltINMxUu3P7MI-LhTp_pxWAWA4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8OJ8jhU_VvMqzx_0a5nVFjekQ1wBOWNmdDX9cAN_Fqqw&oe=6A2AD833"}, {"file_name": "migrated_image.png", "id": "226214061910137", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162763_143678396273729_6482624053747122176_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UjTcBX7Yu0MQ7kNvwEe6jrl&_nc_oc=AdpX0evc_SteS911r77usTyNTHFgavVfXdByszgFcMjp3Z1WkZkg-EDI-dgZ1e2Y7wE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8cBHAMKHqYD1RnOPliZTsDlYkQqe9TsyskH1wx4d3FKA&oe=6A2ACC6C"}, {"file_name": "migrated_image.png", "id": "212102596672796", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162707_138523736788646_2960305160795979776_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GYSttGm0tDoQ7kNvwHkwfsE&_nc_oc=AdrK7Tn_CGuHO2v5OuWYif-eO91kpF7N52UaMmJuUb5fSj6TzTNPOgfDrSlL0IzOpIY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Hx23Y00I1DP-VUlwsEc4oudU6GFNyyPZnOgFNeE2bJw&oe=6A2AC8D4"}, {"file_name": "migrated_image.png", "id": "208540827159608", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162702_124387201576475_5406613443337781248_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yxcNfzy2VvoQ7kNvwHbgmu7&_nc_oc=AdqfSBxCG8pG74UyoZ-k9wnHYxQBiqFB690y_aEtid2buqfJ8f1yEJ_kSIbgwubhTI8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3kL_iev0IvizkVytJl9w36pbahQpSIf0nJfYEJsFeZA&oe=6A2AD6B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "2007762539505711", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162703_2007762542839044_612867755552538624_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gcmiD_iWI9YQ7kNvwHau6qy&_nc_oc=Ado8kb-5z7AD9dvGBn_DJWhleF_EMjBr9-CzEiJDdqc_XC0PU4U5nTHF0-2eCMlDBvE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-baP0eIES8oYcG4TAnrpdfxxxhpofIr1BRMaaUtyUPAw&oe=6A2AD718"}, "display_name": "Metro-2: Project Kollie", "keywords": ["zombie", "coldwar", "spy", "undead", "execution"], "long_description": "Be part of an exciting cold war spy story.\n\nA secret Soviet project started in 1958. Its goal was to create the most effective super weapon. Doctors, scientists, engineers and soliders worked together to indite bio-robots for the Russian army. After many consecutive failures the Central Committee closed down the project in 1969 and all the information became classified. The KGB continued the research in an underground facility without the Comittee's knowledge and in 1982 the team had some primitive results. As a CIA agent you have to infiltrate into this facility and gather as much information as possible about the project.\nBut it won't be easy for you because this is one of the most guarded place in the world.\n\nFeatures: \n- fight against zombies and cyborgs\n- cold war story\n- unique execution system\n- exciting fps combat\n- amazing graphics", "short_description": "Be part of an exciting cold war spy story.\n\nAs a CIA agent you have to infiltrate into a soviet underground facility and gather as much information as possible about their secret project.\nBut it won't be easy for you because this is one of the most guarded place in the world."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "https://tech-tro.com/privacy-policy", "developer_terms_of_service_url": "http://metro2.tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "http://metro2.tech-tro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "CASUAL", "HORROR", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended
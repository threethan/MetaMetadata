D&_nc_oc=Adry8tpZkxEI9p6ZnlBUyrJdWIob6MsD69S5J3V0ULACp_d4CcdYCCXF3tZrdBQFvdo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3EbxRUpbhh4QNKIRQ7qC0By6nG0W5owzCJh9pm5eW60Q&oe=69E4C073"}, {"file_name": "migrated_image.png", "id": "226214061910137", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162763_143678396273729_6482624053747122176_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fm-S6CoCLxsQ7kNvwE-ArEX&_nc_oc=AdqPap2GS-C7fZwJiOxQztWr_A4CHE4cKjLTvaPesW1y1vAXDxV9t2GuExxjgEVTEYA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af14f_WZ3hUjjI9icuuSv5DgMdBh07NvV1ls_n_sqjgJHg&oe=69E4ECEC"}, {"file_name": "migrated_image.png", "id": "212102596672796", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162707_138523736788646_2960305160795979776_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RUmLQe_TRBIQ7kNvwG6tcwx&_nc_oc=Adr2q-yj2RcvoqTMHpgOa_QDdSzNfrrOmZ6QC0wHHLdGjCfXwRl8faT5XUlFZHcm2VQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0qACY8694YteyPFptewDPWw3fpiA-ZxFZTmIRPVsNsfw&oe=69E4E954"}, {"file_name": "migrated_image.png", "id": "208540827159608", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162702_124387201576475_5406613443337781248_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XhXQ4NxvRVMQ7kNvwE3Zxa_&_nc_oc=Ado4Q6y6jjh-boPbgb2KeTwZeTEcQOuINqKg-RzD5K2giPzxbBkTqhIwIhe7Nrbqrpc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af171QmoYLTFiiTjuelFEQv21aaAz860AtblowfyQ8yh5w&oe=69E4BEF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "2007762539505711", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162703_2007762542839044_612867755552538624_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lVkgYLOx_ogQ7kNvwHI9FkP&_nc_oc=AdoxnEICbLwjFyHpe9e0dKl_1aq0JgnMbwUAnAF9OkvX_UQ9sM3VtypJ8ONKqgNsFUA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1J5UxJDN_7K01Y9kV0e8ylDr_ZRbBcoP6OU87G1mBolw&oe=69E4BF58"}, "display_name": "Metro-2: Project Kollie", "keywords": ["zombie", "coldwar", "spy", "undead", "execution"], "long_description": "Be part of an exciting cold war spy story.\n\nA secret Soviet project started in 1958. Its goal was to create the most effective super weapon. Doctors, scientists, engineers and soliders worked together to indite bio-robots for the Russian army. After many consecutive failures the Central Committee closed down the project in 1969 and all the information became classified. The KGB continued the research in an underground facility without the Comittee's knowledge and in 1982 the team had some primitive results. As a CIA agent you have to infiltrate into this facility and gather as much information as possible about the project.\nBut it won't be easy for you because this is one of the most guarded place in the world.\n\nFeatures: \n- fight against zombies and cyborgs\n- cold war story\n- unique execution system\n- exciting fps combat\n- amazing graphics", "short_description": "Be part of an exciting cold war spy story.\n\nAs a CIA agent you have to infiltrate into a soviet underground facility and gather as much information as possible about their secret project.\nBut it won't be easy for you because this is one of the most guarded place in the world."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "https://tech-tro.com/privacy-policy", "developer_terms_of_service_url": "http://metro2.tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "http://metro2.tech-tro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "CASUAL", "HORROR", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended
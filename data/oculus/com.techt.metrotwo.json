F&_nc_oc=AdrAEOroK_MbGu-m9jo0oGKiTLgi075EhD8xd0kjU0vlQO23WL8goiaqbFuii89VZmw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMu4mObfq69PJJDqgr-x4TP2cpueEDCJGTpo0WF5iSaYw&oe=6ADE2433"}, {"file_name": "migrated_image.png", "id": "226214061910137", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162763_143678396273729_6482624053747122176_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KAnpb9-ipSYQ7kNvwHcZDh9&_nc_oc=Ado2LHwvGjT38rN7tbUu_wY1sVCsomazNVkPdpJDWglBES3Nc5SZCb9edPXIBR6ia18&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMpIwTL4WVL6yeFEahWhqdqM3E5N2yVcHlkmt4ssqsZkQ&oe=6ADE186C"}, {"file_name": "migrated_image.png", "id": "212102596672796", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162707_138523736788646_2960305160795979776_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M0t4346BRlUQ7kNvwHTLCNW&_nc_oc=AdowzHwIxACFwCeYMz_19JSUwartDVbr_Xc0QX19BlRkDAd8UW44bc7mD5AEdkGrPKU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP8iPtLXAPlpl7MQo2HIQ7_cQ-jHQHSDfjiL1f4QjMyxg&oe=6ADE14D4"}, {"file_name": "migrated_image.png", "id": "208540827159608", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162702_124387201576475_5406613443337781248_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QRWfLTxOyXgQ7kNvwEAEaCo&_nc_oc=AdpuF9Z9IZwhUTzTaDj4koeQ_-svMO7KfsaCO4-ivi1t6oAPSKajLVZvrhcARS2DQ90&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOU4Nkr1e2910LlueNuFA_8gp1gCKhNJCQ9WzpiDOxGpA&oe=6ADE22B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "2007762539505711", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162703_2007762542839044_612867755552538624_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z25m3dQMa84Q7kNvwGGF9Bv&_nc_oc=AdojoXRS0v3ql4z-ZsRbNV0zJrOoqMjNhIAvV5b7VDaxvoATGpCkyMX2fjP7Py-Bwjs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3RmDM6r0AaxpWaSsqkea-ii857zPgr4MMN_85DKtC0w&oe=6ADE2318"}, "display_name": "Metro-2: Project Kollie", "keywords": ["zombie", "coldwar", "spy", "undead", "execution"], "long_description": "Be part of an exciting cold war spy story.\n\nA secret Soviet project started in 1958. Its goal was to create the most effective super weapon. Doctors, scientists, engineers and soliders worked together to indite bio-robots for the Russian army. After many consecutive failures the Central Committee closed down the project in 1969 and all the information became classified. The KGB continued the research in an underground facility without the Comittee's knowledge and in 1982 the team had some primitive results. As a CIA agent you have to infiltrate into this facility and gather as much information as possible about the project.\nBut it won't be easy for you because this is one of the most guarded place in the world.\n\nFeatures: \n- fight against zombies and cyborgs\n- cold war story\n- unique execution system\n- exciting fps combat\n- amazing graphics", "short_description": "Be part of an exciting cold war spy story.\n\nAs a CIA agent you have to infiltrate into a soviet underground facility and gather as much information as possible about their secret project.\nBut it won't be easy for you because this is one of the most guarded place in the world."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "https://tech-tro.com/privacy-policy", "developer_terms_of_service_url": "http://metro2.tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "http://metro2.tech-tro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "CASUAL", "HORROR", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended
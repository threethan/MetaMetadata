9&_nc_oc=AdphusZoOlbuJl2wtHKf9uSb8wH2i_eohDne9SgTfNzBytmgkn3MCz-ulc5oUBuPg6w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ytjznNUcb1bkEKsjKVItgVB64HJE70lZIxBUQ0hXtGg&oe=6A3BFBB3"}, {"file_name": "migrated_image.png", "id": "226214061910137", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162763_143678396273729_6482624053747122176_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ay8kRNIg73EQ7kNvwE2VAzy&_nc_oc=AdoxGblpjSmq7SL7Ml_OKujfjOdoHQAz08xfz_bHIcU6mPCEIDBYCow0EXv5ALMCfA8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8KmnSeUB40Z5y1jSrxOlqX8qAnn96pT5UA-F1ozNTG8A&oe=6A3BEFEC"}, {"file_name": "migrated_image.png", "id": "212102596672796", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162707_138523736788646_2960305160795979776_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j_1dpiDs3zIQ7kNvwFY9g3v&_nc_oc=AdoMJVhKewGQwO_wev8hy59fDGqG4eqDxWjeX2DselhS4ReIFGkqZx66ZiNTgnVK830&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8FuhO3STgu6qEmcdkOyzEpUMEwEAJOnnBCLJsEoUEupQ&oe=6A3BEC54"}, {"file_name": "migrated_image.png", "id": "208540827159608", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162702_124387201576475_5406613443337781248_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ApfdWe8wBFEQ7kNvwFduPD6&_nc_oc=AdoXJB99lT1i0kaDiBwhTjPDBLiaumpB1COQKM6GTkFmlG0qwf_c24NWUtjzNfQ5b0c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-I7GFtQ3woQjNmRH8OJtU-f0GDJ9Q3PFnBtIdQOrADKg&oe=6A3BFA33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "2007762539505711", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162703_2007762542839044_612867755552538624_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JbF6FtjV75oQ7kNvwG_aK8D&_nc_oc=AdpsLtrSL2v7kCABDXaA7o-Rf0kKzGNAaL6aAGjFNs10lDruSZ-CRaVs1OeM0TdchKw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8wpmybui8jxyY2gQZoDtCSoX57ZsWTiZF-z6GkQTBbPg&oe=6A3BFA98"}, "display_name": "Metro-2: Project Kollie", "keywords": ["zombie", "coldwar", "spy", "undead", "execution"], "long_description": "Be part of an exciting cold war spy story.\n\nA secret Soviet project started in 1958. Its goal was to create the most effective super weapon. Doctors, scientists, engineers and soliders worked together to indite bio-robots for the Russian army. After many consecutive failures the Central Committee closed down the project in 1969 and all the information became classified. The KGB continued the research in an underground facility without the Comittee's knowledge and in 1982 the team had some primitive results. As a CIA agent you have to infiltrate into this facility and gather as much information as possible about the project.\nBut it won't be easy for you because this is one of the most guarded place in the world.\n\nFeatures: \n- fight against zombies and cyborgs\n- cold war story\n- unique execution system\n- exciting fps combat\n- amazing graphics", "short_description": "Be part of an exciting cold war spy story.\n\nAs a CIA agent you have to infiltrate into a soviet underground facility and gather as much information as possible about their secret project.\nBut it won't be easy for you because this is one of the most guarded place in the world."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "https://tech-tro.com/privacy-policy", "developer_terms_of_service_url": "http://metro2.tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "http://metro2.tech-tro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "CASUAL", "HORROR", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended
B&_nc_oc=AdrECwX8RNA-8nq70mgExM8sJ74oJIv6nlMv9pnp5Ubp9soo4XTexKPQh5_rk0IyawA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzSMtt3l5mv_GDh-MksBcws4iLCcNjeMUrdtjUJDa21w&oe=6AAFFFB3"}, {"file_name": "migrated_image.png", "id": "226214061910137", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162763_143678396273729_6482624053747122176_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Uzwy3DZ80AQ7kNvwGWMJev&_nc_oc=AdoDjmD5lWLxgwQqib5WR8XwdIvVGULR2JPiRfF8y6Lvu4taQOoHEaz1J_n7K-o0ZSA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjwK1IbqfvTU_ymVSBfzGp5e4SYzmroAMRGsNTciJhwA&oe=6AAFF3EC"}, {"file_name": "migrated_image.png", "id": "212102596672796", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162707_138523736788646_2960305160795979776_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rrKNmTozSwsQ7kNvwHrJD5i&_nc_oc=AdrRRulNivIRA5cLotEAF7ks4nPWYfKWzf4tFolrHbv8NJA0N96NpFcR2nupwIZten8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKwUVTT7zbTdZb743Ck-Bxd4st8wE2-SHG5yJXvD4KvIA&oe=6AAFF054"}, {"file_name": "migrated_image.png", "id": "208540827159608", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162702_124387201576475_5406613443337781248_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=af5CYnfn--kQ7kNvwFNv1Yd&_nc_oc=AdrapHUKGW4x7JkQptSvun5fyw5n0iY1XyNKMCQtHS5ug4yMwhy5aYHIT7ZZ8eeUEf0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7cRQgP133KrsQgbh0rLTyElhxV5ewyE6XYnqPqMmgMg&oe=6AAFFE33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "2007762539505711", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162703_2007762542839044_612867755552538624_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=djxxKg2HRhwQ7kNvwGqIozN&_nc_oc=Adp7B0xNxRxtrnVUaTZ-_A-hwvsdbF3Z30Sz8zoLZ66DlS4K6ORATYC_LLgwjtlBM_w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2aicOw35VjQb9jfg2KQppK70hS_M74GVOW3UTUQl_fQ&oe=6AAFFE98"}, "display_name": "Metro-2: Project Kollie", "keywords": ["zombie", "coldwar", "spy", "undead", "execution"], "long_description": "Be part of an exciting cold war spy story.\n\nA secret Soviet project started in 1958. Its goal was to create the most effective super weapon. Doctors, scientists, engineers and soliders worked together to indite bio-robots for the Russian army. After many consecutive failures the Central Committee closed down the project in 1969 and all the information became classified. The KGB continued the research in an underground facility without the Comittee's knowledge and in 1982 the team had some primitive results. As a CIA agent you have to infiltrate into this facility and gather as much information as possible about the project.\nBut it won't be easy for you because this is one of the most guarded place in the world.\n\nFeatures: \n- fight against zombies and cyborgs\n- cold war story\n- unique execution system\n- exciting fps combat\n- amazing graphics", "short_description": "Be part of an exciting cold war spy story.\n\nAs a CIA agent you have to infiltrate into a soviet underground facility and gather as much information as possible about their secret project.\nBut it won't be easy for you because this is one of the most guarded place in the world."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "https://tech-tro.com/privacy-policy", "developer_terms_of_service_url": "http://metro2.tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "http://metro2.tech-tro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "CASUAL", "HORROR", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended
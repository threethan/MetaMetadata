W&_nc_oc=AdqnlOyeAWl3jpr5n6Y_8AY8sBkrjxio5aWVTECQnyK6MTPzoZcJypUxAJmWo56-5kI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC6MHjduRRBvGYuOJhXk-OAfv_yeTpfHH59-Ml8wqSefA&oe=6A550833"}, {"file_name": "migrated_image.png", "id": "226214061910137", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162763_143678396273729_6482624053747122176_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=34PU0iYA63wQ7kNvwFrkNTK&_nc_oc=AdrxUtLo_lKilvcQcuNU-wZ7uApzGsYtxLUYHEyvW4kV3WE5obbwhx1wOAhYdA6H2cQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDaDNRRsoygqHlU2E7XcL6Lq6Fi9L2OAE6UMUeQwx22YA&oe=6A54FC6C"}, {"file_name": "migrated_image.png", "id": "212102596672796", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162707_138523736788646_2960305160795979776_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ib04_o-zPgQ7kNvwGo5Nj_&_nc_oc=AdrCcU3i4rfY-RQmwqenIm5XJXXusZWJa0w_N0WrbLPkgo0Qs1WiO_4s60C0OZkHKQ0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDk6iox2liIkZEUwToMtlCc6bViVhJzlViNGm7LhrsJJA&oe=6A54F8D4"}, {"file_name": "migrated_image.png", "id": "208540827159608", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162702_124387201576475_5406613443337781248_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bJS0lmRWHOUQ7kNvwFe9hN4&_nc_oc=AdqbnL1HyjwFg9g_y3dSBRMxo9rK1z38S-rfSIf7PgARH3K-WFnmT3tQtrhPLYkGebY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCztRPsxz6bugj16dlGpELRbS8KOB3peHNKBviWgm9Yvg&oe=6A5506B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "2007762539505711", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/11162703_2007762542839044_612867755552538624_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YeybwL6HAXQQ7kNvwEtaB4-&_nc_oc=AdplYsBzzZBhoCAYlilH8hbalDpVOMm8aUPpXTvCZA-eFkmnS_w2r7nd1R4G74j6NFc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDNyQUdD28xGNQcAGJH4D2eK2l7n-4CB8bDJdnyNaR04w&oe=6A550718"}, "display_name": "Metro-2: Project Kollie", "keywords": ["zombie", "coldwar", "spy", "undead", "execution"], "long_description": "Be part of an exciting cold war spy story.\n\nA secret Soviet project started in 1958. Its goal was to create the most effective super weapon. Doctors, scientists, engineers and soliders worked together to indite bio-robots for the Russian army. After many consecutive failures the Central Committee closed down the project in 1969 and all the information became classified. The KGB continued the research in an underground facility without the Comittee's knowledge and in 1982 the team had some primitive results. As a CIA agent you have to infiltrate into this facility and gather as much information as possible about the project.\nBut it won't be easy for you because this is one of the most guarded place in the world.\n\nFeatures: \n- fight against zombies and cyborgs\n- cold war story\n- unique execution system\n- exciting fps combat\n- amazing graphics", "short_description": "Be part of an exciting cold war spy story.\n\nAs a CIA agent you have to infiltrate into a soviet underground facility and gather as much information as possible about their secret project.\nBut it won't be easy for you because this is one of the most guarded place in the world."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "https://tech-tro.com/privacy-policy", "developer_terms_of_service_url": "http://metro2.tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "http://metro2.tech-tro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "CASUAL", "HORROR", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended
H&_nc_oc=Adpg5opNwTkfmCgqyZ5CBFVye_Uc8tbgb4bLcqxD25guC2TexiW4J05fhI8r5USKzFY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af04T2GhIUEUnyanOZD7JzYNTQRPqsi4BJRygXT4aNEs2g&oe=69DE28F3"}, {"file_name": "migrated_image.png", "id": "226214061910137", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162763_143678396273729_6482624053747122176_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3WpEA4_0Ih8Q7kNvwG-aAao&_nc_oc=Adr7-Z-icRlqpUWpqIVJSjX7-PS7aACgOeVpfDKjxKRVkBY87kxBiuZ4ZdxHdS5je_I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af37l20rMft0m0-VqwYn5et3au-2-3IDjdxiBwF1fpVgzA&oe=69DE556C"}, {"file_name": "migrated_image.png", "id": "212102596672796", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162707_138523736788646_2960305160795979776_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m3nTSNvD6fUQ7kNvwH1T_I1&_nc_oc=AdopoMMzSUHQV7Kb2aW1N0NvezifLnnDR84ez2GoiFNhYno47xTyY8brIZZRIKlkYa0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1wltpboup9J2zqc0zzAvhhIPbuuNdPgo8gu0hVs-LROw&oe=69DE51D4"}, {"file_name": "migrated_image.png", "id": "208540827159608", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162702_124387201576475_5406613443337781248_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uYKaoYHalY4Q7kNvwHF5SB3&_nc_oc=AdpyTF6dwtrhE9O-h_romV3tkYOWjEq19mkyDV2ASJpfro5TNwiut3I7erBImzUHzAs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2QoFt-XNbKTmyeLhyAOTsmyYJSIgYDwHC_SYgHS4onkA&oe=69DE2773"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "2007762539505711", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162703_2007762542839044_612867755552538624_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KZhB0B4pW1sQ7kNvwGxkARt&_nc_oc=Adoa30w_3oCDoiQgSFMMSs5oLvefDesi-tnp2ydmi3g25kUUDUZJ6pH5mxgiFaVv1dY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2_H1DKz2igKmmCdk9T5hoHs6qSWg8tDv16kJj6MfcxiQ&oe=69DE27D8"}, "display_name": "Metro-2: Project Kollie", "keywords": ["zombie", "coldwar", "spy", "undead", "execution"], "long_description": "Be part of an exciting cold war spy story.\n\nA secret Soviet project started in 1958. Its goal was to create the most effective super weapon. Doctors, scientists, engineers and soliders worked together to indite bio-robots for the Russian army. After many consecutive failures the Central Committee closed down the project in 1969 and all the information became classified. The KGB continued the research in an underground facility without the Comittee's knowledge and in 1982 the team had some primitive results. As a CIA agent you have to infiltrate into this facility and gather as much information as possible about the project.\nBut it won't be easy for you because this is one of the most guarded place in the world.\n\nFeatures: \n- fight against zombies and cyborgs\n- cold war story\n- unique execution system\n- exciting fps combat\n- amazing graphics", "short_description": "Be part of an exciting cold war spy story.\n\nAs a CIA agent you have to infiltrate into a soviet underground facility and gather as much information as possible about their secret project.\nBut it won't be easy for you because this is one of the most guarded place in the world."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "https://tech-tro.com/privacy-policy", "developer_terms_of_service_url": "http://metro2.tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "http://metro2.tech-tro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "CASUAL", "HORROR", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended
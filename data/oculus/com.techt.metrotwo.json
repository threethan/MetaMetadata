-8Q7kNvwGcRT5r&_nc_oc=AdqnQ3iudCc9887UgPcEB2595ww29BFajT_VmjX2XJWKlbAA-lkdtsoABl33Xqeni74&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88OqTKXTjrALCvAt26geiFeIOQxk_s5QAsUnVbf33WuA&oe=6A22EF33"}, {"file_name": "migrated_image.png", "id": "226214061910137", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/11162763_143678396273729_6482624053747122176_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MJ0styIb0BAQ7kNvwGhVR-9&_nc_oc=AdpvL-2Nv0qb9_6aGVBziIRCqAp06Z6yth2XzHkyyZX-bGVDS1u5xWSqIMqjmmQb-uc&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8o5eax4rXwEwRs3zG2GMCKyn_J4Ti_Nc-p1g9fJzwLiA&oe=6A22E36C"}, {"file_name": "migrated_image.png", "id": "212102596672796", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/11162707_138523736788646_2960305160795979776_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aX6A1t1VeIsQ7kNvwHm3KnY&_nc_oc=Adr9XB9T_JIDF82r1XnvUDh5csDwgRRMAy8ApJx8Xk832jhMfi83M41o8mU8-0RmALw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93GoGTM5JEaWFwAmnM9aGkr2JxLiJcc9cGntz5qaJB6Q&oe=6A22DFD4"}, {"file_name": "migrated_image.png", "id": "208540827159608", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/11162702_124387201576475_5406613443337781248_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tZF4HfxQPrcQ7kNvwEIhXaJ&_nc_oc=AdqjWZZr803YgjTCrrb0zTRdluKwTW9z72XFqQRgVVmD-9OvjqnWFG-BAySQ4AmKquA&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zVpn8yNFaQic9YuyYtmpmLE9U6bYvwosJAGVO2rSx5Q&oe=6A22EDB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "2007762539505711", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162703_2007762542839044_612867755552538624_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0eui2YNobPwQ7kNvwEWBLVM&_nc_oc=Adpy8Nt6y2MQr2vikTkjXpthsKj26C1aff1Awc-gAV6reDHabJTQTYPQO8Og57k62bY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Daj8RKA5hp55kFIG_Scw8A_7PuwWoiebc7IwboOPmXA&oe=6A22EE18"}, "display_name": "Metro-2: Project Kollie", "keywords": ["zombie", "coldwar", "spy", "undead", "execution"], "long_description": "Be part of an exciting cold war spy story.\n\nA secret Soviet project started in 1958. Its goal was to create the most effective super weapon. Doctors, scientists, engineers and soliders worked together to indite bio-robots for the Russian army. After many consecutive failures the Central Committee closed down the project in 1969 and all the information became classified. The KGB continued the research in an underground facility without the Comittee's knowledge and in 1982 the team had some primitive results. As a CIA agent you have to infiltrate into this facility and gather as much information as possible about the project.\nBut it won't be easy for you because this is one of the most guarded place in the world.\n\nFeatures: \n- fight against zombies and cyborgs\n- cold war story\n- unique execution system\n- exciting fps combat\n- amazing graphics", "short_description": "Be part of an exciting cold war spy story.\n\nAs a CIA agent you have to infiltrate into a soviet underground facility and gather as much information as possible about their secret project.\nBut it won't be easy for you because this is one of the most guarded place in the world."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "https://tech-tro.com/privacy-policy", "developer_terms_of_service_url": "http://metro2.tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "http://metro2.tech-tro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "CASUAL", "HORROR", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": nu
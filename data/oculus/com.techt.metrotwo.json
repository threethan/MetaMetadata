p&_nc_oc=Adon4Bam5C-ZZR-XQfABj2JX2eUg14tOgZZyXQXSuWUvJCLOgs-6jtJHB9KbKuEPlAI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxm-KkNJ9mfPCPgOna9ATmRoB2fhU_p8gjdpCoY-Sr5aw&oe=69C51C73"}, {"file_name": "migrated_image.png", "id": "226214061910137", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162763_143678396273729_6482624053747122176_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FZAPa0A1ibMQ7kNvwHLFgLo&_nc_oc=AdqNH-iFgtIBuGWiCQo3Y32zsPO0QL6cEe_82RdtZJlvxroqOGao0ChjN5FuAErv3Ic&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz2ZshDJF89Bes3BZO0bp8q200VbeICJp5UjNx2adeuvQ&oe=69C510AC"}, {"file_name": "migrated_image.png", "id": "212102596672796", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162707_138523736788646_2960305160795979776_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7qZ2eaPRy3wQ7kNvwGdWfZE&_nc_oc=AdqXCH4CSCPZupP-DPJU3emL30tLJhxKutSZvbu7TSFe4mQ2LQ8UvSy_wlb4gyHGZT8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxBg1ekLd4x0EN2PfEbojwp3bqryzXNRj7VZDb_6lfXyg&oe=69C54554"}, {"file_name": "migrated_image.png", "id": "208540827159608", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162702_124387201576475_5406613443337781248_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eQ_qiW7eOUUQ7kNvwEdHfHz&_nc_oc=AdqBio307q7W8BWa-j5-VxzXKTOiJIez_b7ItwgBClar7TLljmJy289H4eVmPNbWOQY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzVDz_Ir0ap7A0C-ngOO2alYoqFth5f_rrqCAS5GH2y5g&oe=69C51AF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "2007762539505711", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162703_2007762542839044_612867755552538624_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2JvOgiloig4Q7kNvwH6ML4Z&_nc_oc=AdpCrJjA22xEC1Z_q1l4sgyo5WTv1bxk8V5gw-IzpY98KLSrT34ZPaemgNEKPwaWIvY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwYnalCHD2Glqmh4foxnmsqiSCHP8j2z3s3qOKkvMD3zw&oe=69C51B58"}, "display_name": "Metro-2: Project Kollie", "keywords": ["zombie", "coldwar", "spy", "undead", "execution"], "long_description": "Be part of an exciting cold war spy story.\n\nA secret Soviet project started in 1958. Its goal was to create the most effective super weapon. Doctors, scientists, engineers and soliders worked together to indite bio-robots for the Russian army. After many consecutive failures the Central Committee closed down the project in 1969 and all the information became classified. The KGB continued the research in an underground facility without the Comittee's knowledge and in 1982 the team had some primitive results. As a CIA agent you have to infiltrate into this facility and gather as much information as possible about the project.\nBut it won't be easy for you because this is one of the most guarded place in the world.\n\nFeatures: \n- fight against zombies and cyborgs\n- cold war story\n- unique execution system\n- exciting fps combat\n- amazing graphics", "short_description": "Be part of an exciting cold war spy story.\n\nAs a CIA agent you have to infiltrate into a soviet underground facility and gather as much information as possible about their secret project.\nBut it won't be easy for you because this is one of the most guarded place in the world."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "https://tech-tro.com/privacy-policy", "developer_terms_of_service_url": "http://metro2.tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "http://metro2.tech-tro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "CASUAL", "HORROR", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended
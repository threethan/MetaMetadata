y&_nc_oc=AdpDKktR417wzLvmzHQt8iquPR2zwHNn2NwAiRZfJrueRCXPhhegunKK7_Q0OODLyWo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7VhEs4DbXzJpozLoUpLb7LrDXiRG0apXpgjJhfGrekkg&oe=6A1711B3"}, {"file_name": "migrated_image.png", "id": "226214061910137", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162763_143678396273729_6482624053747122176_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TGwxgCA0elYQ7kNvwFiWBG8&_nc_oc=Adppg02nnzjXGIXwJ0lcvfsJVBq4vsbvaRbZ0MUVsZrrMOQ8vxYpm_97iwJWxVhK5dU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5RQUANxhe-_OK7Mmr22aA4OqwV1C4Jp_HtXLj8lSDyRQ&oe=6A1705EC"}, {"file_name": "migrated_image.png", "id": "212102596672796", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162707_138523736788646_2960305160795979776_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bHcIiJQ87MUQ7kNvwGY4XEj&_nc_oc=AdrXvCTJ2pS51Oxha87sAv1YoHuxBVrg1YhEzKBYJl_zkFgH-QQUwSAobbMAr04J90o&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6muKlh0R9CQ6y_xsK4Zsv5su3v_eGTGs-mmBthw-X4zw&oe=6A170254"}, {"file_name": "migrated_image.png", "id": "208540827159608", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162702_124387201576475_5406613443337781248_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bL_sPF5Ur5sQ7kNvwEgyp_F&_nc_oc=Adp3t4Qzz3xNwdIi7chToyUTN9LxurlbG_jhy1n04a5CPc_A3d52uLkLdR9jLbPXFc4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af56R7_wrwHtgF3otn3z4uMhRdSGPp6svS-ax17U1UnBNA&oe=6A171033"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "2007762539505711", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162703_2007762542839044_612867755552538624_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_0nH493jL4sQ7kNvwGUn3Qd&_nc_oc=AdoXTf2bFqUDT-7dG9zhafjuzvBAOYqyE_PG3JTJoBeMP2mGXu4MuxGyUweqSrFmxpc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af642Y0-6AXcPF_5dX5c51puYGwLwmyfWfTy9bdflCt0WA&oe=6A171098"}, "display_name": "Metro-2: Project Kollie", "keywords": ["zombie", "coldwar", "spy", "undead", "execution"], "long_description": "Be part of an exciting cold war spy story.\n\nA secret Soviet project started in 1958. Its goal was to create the most effective super weapon. Doctors, scientists, engineers and soliders worked together to indite bio-robots for the Russian army. After many consecutive failures the Central Committee closed down the project in 1969 and all the information became classified. The KGB continued the research in an underground facility without the Comittee's knowledge and in 1982 the team had some primitive results. As a CIA agent you have to infiltrate into this facility and gather as much information as possible about the project.\nBut it won't be easy for you because this is one of the most guarded place in the world.\n\nFeatures: \n- fight against zombies and cyborgs\n- cold war story\n- unique execution system\n- exciting fps combat\n- amazing graphics", "short_description": "Be part of an exciting cold war spy story.\n\nAs a CIA agent you have to infiltrate into a soviet underground facility and gather as much information as possible about their secret project.\nBut it won't be easy for you because this is one of the most guarded place in the world."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "https://tech-tro.com/privacy-policy", "developer_terms_of_service_url": "http://metro2.tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "http://metro2.tech-tro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "CASUAL", "HORROR", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended
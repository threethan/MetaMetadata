k&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8VgfrUPBebLayQ9jPskmImooCLbyk07ZhxkcUfdN9KlA&oe=6A394CEC"}, {"file_name": "migrated_image.png", "id": "212102596672796", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/11162707_138523736788646_2960305160795979776_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4u8ZWYq5QG4Q7kNvwGmXjZj&_nc_oc=Adojn8HK3Gtlw828wZXSRLMHnq_OBnsCb9sac09m65z5hvY15BELyPK4IhJM-hTEaoc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ltzJ9YQxoaPSi_bXlwNG96HmG4uPyc7a-bJ4KII1ruQ&oe=6A394954"}, {"file_name": "migrated_image.png", "id": "208540827159608", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/11162702_124387201576475_5406613443337781248_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ApfdWe8wBFEQ7kNvwHgcJjE&_nc_oc=AdqC3Q2SnnkgKieftGyQBtbQX0pVgkNsZ4zVAzM4gzxAQSM-kXu9wRyEYrgaABoRdS8&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0xaI4Hpr9PVQe0JFx-U2hDpctvmLqdunozkj-QBsnXQ&oe=6A395733"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "2007762539505711", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162703_2007762542839044_612867755552538624_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IGLHFPcpSPoQ7kNvwE5KxH6&_nc_oc=AdpLMkGBpQegfSSv09hhJzTJWV1huqN8qJKV1V91RWFsa6pYGTakHfkejUbPycU9BPY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9zm2xXhuI0yZhlLpBgfUaTNY34NnCAP9aNb832Kb4neA&oe=6A395798"}, "display_name": "Metro-2: Project Kollie", "keywords": ["zombie", "coldwar", "spy", "undead", "execution"], "long_description": "Be part of an exciting cold war spy story.\n\nA secret Soviet project started in 1958. Its goal was to create the most effective super weapon. Doctors, scientists, engineers and soliders worked together to indite bio-robots for the Russian army. After many consecutive failures the Central Committee closed down the project in 1969 and all the information became classified. The KGB continued the research in an underground facility without the Comittee's knowledge and in 1982 the team had some primitive results. As a CIA agent you have to infiltrate into this facility and gather as much information as possible about the project.\nBut it won't be easy for you because this is one of the most guarded place in the world.\n\nFeatures: \n- fight against zombies and cyborgs\n- cold war story\n- unique execution system\n- exciting fps combat\n- amazing graphics", "short_description": "Be part of an exciting cold war spy story.\n\nAs a CIA agent you have to infiltrate into a soviet underground facility and gather as much information as possible about their secret project.\nBut it won't be easy for you because this is one of the most guarded place in the world."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "http://metro2.tech-tro.com/privacy-policy", "developer_terms_of_service_url": "http://metro2.tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "http://metro2.tech-tro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "CASUAL", "HORROR", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_GB"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "239421851718213"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"node
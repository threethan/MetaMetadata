t&_nc_oc=Ado0FIVLIUA1dO1DW_Zr5saAN5ezh4bzbX-KZWTRdNHl7tiJ5HW6-cyaUBdJd2GeSXU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9mS7wS4x_ktKiN2HkoaOrxeYKddIB0pv_HG1W-txfDjw&oe=6A2C29B3"}, {"file_name": "migrated_image.png", "id": "226214061910137", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/11162763_143678396273729_6482624053747122176_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UjTcBX7Yu0MQ7kNvwGHv1cJ&_nc_oc=Adokywm1yOxdR1awhObymkPzPRWM5dAAMEhnoGr0lG4AmqGcLQ5w19IBsHcOdQ0s3QE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-iwIBW2zty-n1xzzTmmlvRa7EPah4BENHI5GBDhvoFAg&oe=6A2C1DEC"}, {"file_name": "migrated_image.png", "id": "212102596672796", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/11162707_138523736788646_2960305160795979776_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GYSttGm0tDoQ7kNvwFpRHvS&_nc_oc=AdqozY8HTevtA84QIUGcHbyO7uu0H1_zUcxjjepfACqOjfnhNrS7w7blk2YPuFGj504&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-X_kalGK_f1vko9FOfWUNF7WDFJyDdtiONF9g3GdCAZg&oe=6A2C1A54"}, {"file_name": "migrated_image.png", "id": "208540827159608", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/11162702_124387201576475_5406613443337781248_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yxcNfzy2VvoQ7kNvwE_7_vP&_nc_oc=AdqmBCQ5ETxxy2DROe1xG-64w7rmW81Qy6DDWjeIV9atXLmby3eqWvfs2qFRvk-_9kk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-g2Ug05-pssp3TSN3-4LgMOJpSClhMDhydiQcteE01mA&oe=6A2C2833"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "2007762539505711", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/11162703_2007762542839044_612867755552538624_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gcmiD_iWI9YQ7kNvwE-9wHK&_nc_oc=AdohipybBemAoL4snuXNg2Obeaq8YLM3w7pQn9Kt-sVyC1G0l8Qg12femVaJhDp5iTc&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8FzQY8VhA-v8qxC6d6r76W0MsB0lx6PaUfotbDxbVv1g&oe=6A2C2898"}, "display_name": "Metro-2: Project Kollie", "keywords": ["zombie", "coldwar", "spy", "undead", "execution"], "long_description": "Be part of an exciting cold war spy story.\n\nA secret Soviet project started in 1958. Its goal was to create the most effective super weapon. Doctors, scientists, engineers and soliders worked together to indite bio-robots for the Russian army. After many consecutive failures the Central Committee closed down the project in 1969 and all the information became classified. The KGB continued the research in an underground facility without the Comittee's knowledge and in 1982 the team had some primitive results. As a CIA agent you have to infiltrate into this facility and gather as much information as possible about the project.\nBut it won't be easy for you because this is one of the most guarded place in the world.\n\nFeatures: \n- fight against zombies and cyborgs\n- cold war story\n- unique execution system\n- exciting fps combat\n- amazing graphics", "short_description": "Be part of an exciting cold war spy story.\n\nAs a CIA agent you have to infiltrate into a soviet underground facility and gather as much information as possible about their secret project.\nBut it won't be easy for you because this is one of the most guarded place in the world."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "https://tech-tro.com/privacy-policy", "developer_terms_of_service_url": "http://metro2.tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "http://metro2.tech-tro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "CASUAL", "HORROR", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended
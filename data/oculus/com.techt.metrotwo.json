L&_nc_oc=Adp-gEzvX0ChTgonhynSZZEVsB3WDrQvKqN3Y4KI5hniWvgLqVbhEOxxW8hre97_qek&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRl4K3LmpZE46Ec1bDOmFQi2ZNCWs1da-kR7_aKgqhZpw&oe=6AEDF633"}, {"file_name": "migrated_image.png", "id": "226214061910137", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162763_143678396273729_6482624053747122176_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-NIBjM5OoxMQ7kNvwFWiIU6&_nc_oc=AdqGVYltmDFPELi7LpGLF1CiUkURo3eEYAdb6u0iyk7ss8zh8duL6LkQYh-m4fmoDu4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQq1P7VFfSaALNgl8cMyCEOrXf85QR0i0YvYH-vcW-RVQ&oe=6AEDEA6C"}, {"file_name": "migrated_image.png", "id": "212102596672796", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162707_138523736788646_2960305160795979776_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ivWrZdSKdcQ7kNvwGKGV6v&_nc_oc=AdoSnCfE63N71-r7rOuC4woIfypf9T_4mxsxXSP3FkvLBQbVompNg2vCEJIwojIXPQs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgAjWCB8hIFkUOZ3fs8m4fpuyRnUBvcGl5I8ljwPokdw&oe=6AEDE6D4"}, {"file_name": "migrated_image.png", "id": "208540827159608", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162702_124387201576475_5406613443337781248_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1kXIiGoSiNIQ7kNvwHr1jFf&_nc_oc=AdqoeBtURxG2BMc775afIRnam4sqaLnRHCqFhSFqRKi8ClvC3F_jddqTpROQvc0MqaM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS84AgfideoLUHYTW2ZnU4v7kf3kaFsMezPA4aVmNXWfA&oe=6AEDF4B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "2007762539505711", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162703_2007762542839044_612867755552538624_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y6pMHLCyn8EQ7kNvwEuY9qf&_nc_oc=Adp8fqCLnAaQm24FgDvAoXJd_cHNDjYRFROQ8JR8FLfp7I7kLKMsNIOm8Bn-vPrTf1Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWESfRk0Sfwlu7mDz7oAW5vFcYIwRuVRulfZ74lwjy0A&oe=6AEDF518"}, "display_name": "Metro-2: Project Kollie", "keywords": ["zombie", "coldwar", "spy", "undead", "execution"], "long_description": "Be part of an exciting cold war spy story.\n\nA secret Soviet project started in 1958. Its goal was to create the most effective super weapon. Doctors, scientists, engineers and soliders worked together to indite bio-robots for the Russian army. After many consecutive failures the Central Committee closed down the project in 1969 and all the information became classified. The KGB continued the research in an underground facility without the Comittee's knowledge and in 1982 the team had some primitive results. As a CIA agent you have to infiltrate into this facility and gather as much information as possible about the project.\nBut it won't be easy for you because this is one of the most guarded place in the world.\n\nFeatures: \n- fight against zombies and cyborgs\n- cold war story\n- unique execution system\n- exciting fps combat\n- amazing graphics", "short_description": "Be part of an exciting cold war spy story.\n\nAs a CIA agent you have to infiltrate into a soviet underground facility and gather as much information as possible about their secret project.\nBut it won't be easy for you because this is one of the most guarded place in the world."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "https://tech-tro.com/privacy-policy", "developer_terms_of_service_url": "http://metro2.tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "http://metro2.tech-tro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "CASUAL", "HORROR", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended
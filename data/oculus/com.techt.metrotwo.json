8&_nc_oc=AdqEcjhQxy78D6GcUQScnvxxN_OFydTyEP4lnig1K1rdsAJvQpPoOIuoEPNU8Qp9Nt0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUWVCBOT0e_GZosVTN2uETV_X3GAUETZC4E7kIEbWVeQ&oe=6A4FC233"}, {"file_name": "migrated_image.png", "id": "226214061910137", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162763_143678396273729_6482624053747122176_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tvOFa3cUCCAQ7kNvwHKIV1K&_nc_oc=AdrY09nFc10-Hq8BxcaLqBCnxRzdSZC8qhufbqZcLQoFNPmvBBg2PSI1cUtyuemZGhc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDdiO31yiBToL1nOwKTqeR9idAyk4e1IQDFAG1Uf7Iw2g&oe=6A4FB66C"}, {"file_name": "migrated_image.png", "id": "212102596672796", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162707_138523736788646_2960305160795979776_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OTxE2SMIMfQQ7kNvwH0NnI_&_nc_oc=Adp4CjBsdbyXr-ZvovZywc3-xF_em-Ufgor2Zsab6vEMoaOm0zGb5C2c2yd7AYU0zZY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCgYMIZ1vVszGIAdwXgBGZewQmyUsWt4nXRUWwe9lQYuA&oe=6A4FB2D4"}, {"file_name": "migrated_image.png", "id": "208540827159608", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162702_124387201576475_5406613443337781248_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2WgxbufWG2cQ7kNvwHv49sf&_nc_oc=Adr4GFaOjZaMp9VSfFrS60CKHGpt_ude13Gdb0zI6lRnYOQUmERBQKDJlciJ9vcUGLY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBIY0omaPocrduc3MNwYoa99hmkFZ97cvzDUTdrHh4sKA&oe=6A4FC0B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "2007762539505711", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162703_2007762542839044_612867755552538624_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sr_pHETOMM4Q7kNvwFqFHVa&_nc_oc=AdossNmexHIPgNcnh0L2Wk4DCK6kcShMxRWEIZtWKz5-F9KyBK8XRcPRsUlE5FA3iW4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCkmm-_fNbHWQO0Msi-SzSGI-cpdAg9e_omlnK-_pGL3w&oe=6A4FC118"}, "display_name": "Metro-2: Project Kollie", "keywords": ["zombie", "coldwar", "spy", "undead", "execution"], "long_description": "Be part of an exciting cold war spy story.\n\nA secret Soviet project started in 1958. Its goal was to create the most effective super weapon. Doctors, scientists, engineers and soliders worked together to indite bio-robots for the Russian army. After many consecutive failures the Central Committee closed down the project in 1969 and all the information became classified. The KGB continued the research in an underground facility without the Comittee's knowledge and in 1982 the team had some primitive results. As a CIA agent you have to infiltrate into this facility and gather as much information as possible about the project.\nBut it won't be easy for you because this is one of the most guarded place in the world.\n\nFeatures: \n- fight against zombies and cyborgs\n- cold war story\n- unique execution system\n- exciting fps combat\n- amazing graphics", "short_description": "Be part of an exciting cold war spy story.\n\nAs a CIA agent you have to infiltrate into a soviet underground facility and gather as much information as possible about their secret project.\nBut it won't be easy for you because this is one of the most guarded place in the world."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "https://tech-tro.com/privacy-policy", "developer_terms_of_service_url": "http://metro2.tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "http://metro2.tech-tro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "CASUAL", "HORROR", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended
A&_nc_oc=AdpFxOsrQVfAK7otaehcU4jPZYqM6oEFh6uD4v5WW5m9TrhFtqPSOmZnDo690kJseJY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJXEre8dXg7tlKue9VBWepY4WQ7uV07duVSb22XOeTjDQ&oe=6AAAB9B3"}, {"file_name": "migrated_image.png", "id": "226214061910137", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162763_143678396273729_6482624053747122176_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8G_us1NM2bIQ7kNvwHoI2Fe&_nc_oc=Adr1FtVYan6yXdeEebLHmk9erC6Bs-aEyRgwW5Ij0gmdoMk-zLoWvLj3QjV_BqjcIqc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI8dk5IjLh-3m-oiU4EnwpbrPTsGUoVoY2tf2OTg27vzQ&oe=6AAAADEC"}, {"file_name": "migrated_image.png", "id": "212102596672796", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162707_138523736788646_2960305160795979776_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fq0LHw9_LG4Q7kNvwFi3Tuu&_nc_oc=Adpf5nAlPb9KWRvWbz30k_eX-TZW-QS7FS1Uea9XZkgKY2P4UW1WSPWxgM7NBshfNfM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIh03z0OibIGfuE1Bd2CAnYlrQOeyEgCs-ArkWbwdCFkQ&oe=6AAAAA54"}, {"file_name": "migrated_image.png", "id": "208540827159608", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162702_124387201576475_5406613443337781248_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uIC9BFGVMT8Q7kNvwG4X-N3&_nc_oc=Adp4c49F6PsWK0cjVUBTf9n1jyMpEXGosiKIG4pGCY8JQjMchp7cc6AB8DzJrTm_Tr0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIdh-WnG7zjFdq6guaQBUIdZ2C66TINcfTShoEFPNUrdg&oe=6AAAB833"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "2007762539505711", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162703_2007762542839044_612867755552538624_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eTP5E2VWCvwQ7kNvwHHhf8e&_nc_oc=AdrStDbD4zllXqSPU--CwfLuSOlUvM5SOYmzJxYvmHZR_iNpifTgyly2s7PXBio02Bc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLgdIe5zTPGrGLWZpjNbXxgqFdn9aUvGgoqjQDU6Kl4-Q&oe=6AAAB898"}, "display_name": "Metro-2: Project Kollie", "keywords": ["zombie", "coldwar", "spy", "undead", "execution"], "long_description": "Be part of an exciting cold war spy story.\n\nA secret Soviet project started in 1958. Its goal was to create the most effective super weapon. Doctors, scientists, engineers and soliders worked together to indite bio-robots for the Russian army. After many consecutive failures the Central Committee closed down the project in 1969 and all the information became classified. The KGB continued the research in an underground facility without the Comittee's knowledge and in 1982 the team had some primitive results. As a CIA agent you have to infiltrate into this facility and gather as much information as possible about the project.\nBut it won't be easy for you because this is one of the most guarded place in the world.\n\nFeatures: \n- fight against zombies and cyborgs\n- cold war story\n- unique execution system\n- exciting fps combat\n- amazing graphics", "short_description": "Be part of an exciting cold war spy story.\n\nAs a CIA agent you have to infiltrate into a soviet underground facility and gather as much information as possible about their secret project.\nBut it won't be easy for you because this is one of the most guarded place in the world."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "https://tech-tro.com/privacy-policy", "developer_terms_of_service_url": "http://metro2.tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "http://metro2.tech-tro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "CASUAL", "HORROR", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended
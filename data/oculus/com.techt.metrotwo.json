U&_nc_oc=AdpqJVI4GFHcjRMI0ngwraEKJlsi_bIkpbffqDzYQV3W2RWQWJQmio8ng81H_6XWY1M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQN8YjhrCUgkBP7_NSjzls3Lo3SvHoWLXIgbzlF84cZBw&oe=6AF88233"}, {"file_name": "migrated_image.png", "id": "226214061910137", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162763_143678396273729_6482624053747122176_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hdFb5MRJbNAQ7kNvwFnKKDr&_nc_oc=Ado5a9Ntlbc_LXgZlKR_vTcXWI8IObQcVTXAghWC-PDu8PmuJktoAmS2uoI-BjqMiIU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIJrVJrfdrbpbc2EAfzAiih1LMtaoQ1Kxq1yvVDNbuhw&oe=6AF8766C"}, {"file_name": "migrated_image.png", "id": "212102596672796", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162707_138523736788646_2960305160795979776_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f1NV4t-7ocIQ7kNvwHsyGkz&_nc_oc=AdrQJN09d57vj6qLCR9G1FhNKHLqETbdOZKQFFQSk492IgX4qNiivTIuHDFCDFqTeTo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9HNMLNxFxec44IJ6f4QRj5DSdsSpGvRG-ypwjWPweRA&oe=6AF8AB14"}, {"file_name": "migrated_image.png", "id": "208540827159608", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162702_124387201576475_5406613443337781248_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6T5hWT1G930Q7kNvwFqmPTm&_nc_oc=Adp6LvSXB3GsXcLxDcxc3GH1y6OSTyqr2khA6yXdh-ll6_9kfnF75lWj4MMGGJpIi_E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPOnU0IrJT1nPRsSbXT7Js_IVQmwvxk90pBosHY8BwFA&oe=6AF880B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "2007762539505711", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162703_2007762542839044_612867755552538624_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mptWaKe-fwoQ7kNvwFerkaq&_nc_oc=AdoG0twFd1vgSMLBZ3-WafRbuVSdg-p2hH6my2MpJ50rLwXoNpt7IVi30nKQ9NA-89Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSiRk9VQVWm0guTCnuuQGGzMLI1y0t68UNtWI6wFCZ06Q&oe=6AF88118"}, "display_name": "Metro-2: Project Kollie", "keywords": ["zombie", "coldwar", "spy", "undead", "execution"], "long_description": "Be part of an exciting cold war spy story.\n\nA secret Soviet project started in 1958. Its goal was to create the most effective super weapon. Doctors, scientists, engineers and soliders worked together to indite bio-robots for the Russian army. After many consecutive failures the Central Committee closed down the project in 1969 and all the information became classified. The KGB continued the research in an underground facility without the Comittee's knowledge and in 1982 the team had some primitive results. As a CIA agent you have to infiltrate into this facility and gather as much information as possible about the project.\nBut it won't be easy for you because this is one of the most guarded place in the world.\n\nFeatures: \n- fight against zombies and cyborgs\n- cold war story\n- unique execution system\n- exciting fps combat\n- amazing graphics", "short_description": "Be part of an exciting cold war spy story.\n\nAs a CIA agent you have to infiltrate into a soviet underground facility and gather as much information as possible about their secret project.\nBut it won't be easy for you because this is one of the most guarded place in the world."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "https://tech-tro.com/privacy-policy", "developer_terms_of_service_url": "http://metro2.tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "http://metro2.tech-tro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "CASUAL", "HORROR", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended
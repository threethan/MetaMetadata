B&_nc_oc=AdrQ1ucD2hyAV6ESJxlFiSMlB4G0Fl4z2cL1-gzCfvSvB974HsGX2aiWuRkJWT7IUVI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB4wh6b8VBKhowJmQttMBPwDV_ej6TQYkltPNSQlyC4pg&oe=6A5F5BF3"}, {"file_name": "migrated_image.png", "id": "226214061910137", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162763_143678396273729_6482624053747122176_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I36Zo3rkw7oQ7kNvwE3wwnV&_nc_oc=AdpNZEhgkPkwfqAYrEHXAWeGV7M3f8MmkbWejJ4ukXCtISeFEEbPKP194r3VJhPfB08&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBbKSXVfK_vDbKp3R889a8JcFlQkdxhZJuVtCUuUaGPJA&oe=6A5F886C"}, {"file_name": "migrated_image.png", "id": "212102596672796", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162707_138523736788646_2960305160795979776_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=50ITTnSFBvMQ7kNvwECoNlF&_nc_oc=AdooJglRQwK_pe9e-QAP8MWPcosmIw3hkV0l847EbyNYrqQXWi2PUbbFVHbS1_twmAY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDponFs8h_tRSgaA9H_DvQb2Ts2L7C7ukTP88HXo3Ypag&oe=6A5F84D4"}, {"file_name": "migrated_image.png", "id": "208540827159608", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162702_124387201576475_5406613443337781248_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y5gEmk-7hZAQ7kNvwGvcG8R&_nc_oc=Adpr1pIeO-4_kvg2Tjb5KHBDbTGJSusWdnutyhKbdjXs39dSgoTAei0kG64OC0th4ao&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAewdLYHCDVjIRu4KrhrQgx2L2TjZ1p0aDK5NXMoJuxxg&oe=6A5F5A73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "2007762539505711", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162703_2007762542839044_612867755552538624_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DLLzZFg2hUIQ7kNvwH_Ugnk&_nc_oc=AdoQoQ6M0md1gOXvSAraHZVJmfGMiFFX3zsfCwnqAXbDtzDqXu-aJl05TMrYReHhULc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDepfqrLCEXJxi0xabtmkemkBjGeqgYFn82F35Txeqa_A&oe=6A5F5AD8"}, "display_name": "Metro-2: Project Kollie", "keywords": ["zombie", "coldwar", "spy", "undead", "execution"], "long_description": "Be part of an exciting cold war spy story.\n\nA secret Soviet project started in 1958. Its goal was to create the most effective super weapon. Doctors, scientists, engineers and soliders worked together to indite bio-robots for the Russian army. After many consecutive failures the Central Committee closed down the project in 1969 and all the information became classified. The KGB continued the research in an underground facility without the Comittee's knowledge and in 1982 the team had some primitive results. As a CIA agent you have to infiltrate into this facility and gather as much information as possible about the project.\nBut it won't be easy for you because this is one of the most guarded place in the world.\n\nFeatures: \n- fight against zombies and cyborgs\n- cold war story\n- unique execution system\n- exciting fps combat\n- amazing graphics", "short_description": "Be part of an exciting cold war spy story.\n\nAs a CIA agent you have to infiltrate into a soviet underground facility and gather as much information as possible about their secret project.\nBut it won't be easy for you because this is one of the most guarded place in the world."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "https://tech-tro.com/privacy-policy", "developer_terms_of_service_url": "http://metro2.tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "http://metro2.tech-tro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "CASUAL", "HORROR", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended
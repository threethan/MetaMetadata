f&_nc_oc=AdpSQWD8uElTNxsjiPNPh1J9mWYMlZdseRk_bnt7OtIjCT2SrH7NghftY6-mjpxeXdk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCaRqwiGwNwnzRwuOo9X1L-6vWNcF5xppQbehVa4FIRZg&oe=6A5A15F3"}, {"file_name": "migrated_image.png", "id": "226214061910137", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162763_143678396273729_6482624053747122176_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xTP02KV4aicQ7kNvwEMmsks&_nc_oc=AdrxmDmLX1a2KG8MQ4bhs6X6ydGBybGj3vg6Acd-Avc1WE1grGXtA7oFplgqWzVLKOQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCVaGhii-ep3wrY-ziG10LNI3t46rD1Xus5jKHWwuUYRw&oe=6A5A426C"}, {"file_name": "migrated_image.png", "id": "212102596672796", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162707_138523736788646_2960305160795979776_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dFPGXv4A9boQ7kNvwFYnscE&_nc_oc=AdpKeSx5u22G_fExxOFEIElVWwbSLzsWS2xuMtjat8sdkA3M9zsuc_gin8caSnhzBTs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDoLiDxnL50dwCunax2f0KXbRfNqvdhXgS7sPk2DUpxcw&oe=6A5A3ED4"}, {"file_name": "migrated_image.png", "id": "208540827159608", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/11162702_124387201576475_5406613443337781248_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gt77Na5vYaEQ7kNvwEj128g&_nc_oc=Ado4H9pPtGjtGsjyWYmhj9l4MQp3pVOq3_qCWyKZ1mAlEafMp7GKP4OwEIjKSpwuTJ4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6gEka_2Em5X808XcLQBOO3R_R9IYD-Zyu88mQRqZ-XQ&oe=6A5A1473"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "2007762539505711", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162703_2007762542839044_612867755552538624_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0TyxmtnTOfYQ7kNvwHjhgW7&_nc_oc=AdqBvV5YMkS3OjAzaEShcnGPbLmdiUUkzlOFZCwZkjTdEviOmwGMmonfZ7o4F3Mb4Z0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCifk0gCaVb-bi31xwTCdI5OpxdeDBL_9lKzT9y78q4zA&oe=6A5A14D8"}, "display_name": "Metro-2: Project Kollie", "keywords": ["zombie", "coldwar", "spy", "undead", "execution"], "long_description": "Be part of an exciting cold war spy story.\n\nA secret Soviet project started in 1958. Its goal was to create the most effective super weapon. Doctors, scientists, engineers and soliders worked together to indite bio-robots for the Russian army. After many consecutive failures the Central Committee closed down the project in 1969 and all the information became classified. The KGB continued the research in an underground facility without the Comittee's knowledge and in 1982 the team had some primitive results. As a CIA agent you have to infiltrate into this facility and gather as much information as possible about the project.\nBut it won't be easy for you because this is one of the most guarded place in the world.\n\nFeatures: \n- fight against zombies and cyborgs\n- cold war story\n- unique execution system\n- exciting fps combat\n- amazing graphics", "short_description": "Be part of an exciting cold war spy story.\n\nAs a CIA agent you have to infiltrate into a soviet underground facility and gather as much information as possible about their secret project.\nBut it won't be easy for you because this is one of the most guarded place in the world."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "https://tech-tro.com/privacy-policy", "developer_terms_of_service_url": "http://metro2.tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "http://metro2.tech-tro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "CASUAL", "HORROR", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended
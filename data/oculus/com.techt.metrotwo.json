E&_nc_oc=Adp54net5hj5D9XwvkdTq4hOWodqPtTxh4ppD4TpOwE3rHJJcVMqsYccG1Rk_t4wbMY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAfVmXyf69KaJlwbil6EoqyvldLUAV81wIJIkAk2c-LQ&oe=6AE75EB3"}, {"file_name": "migrated_image.png", "id": "226214061910137", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162763_143678396273729_6482624053747122176_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TdDscw1mA6QQ7kNvwGneVju&_nc_oc=AdqGzwMx_TdaZ-NdQs9ICZhLMtXLQnq9WxER4Q0URkSWc5ULLDJqxsTiPBIjPnUCGFA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSw8Vwp_ojuGpQOrtwb-qVTcOjGOAdjzX4leZdJ8C1qRQ&oe=6AE752EC"}, {"file_name": "migrated_image.png", "id": "212102596672796", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162707_138523736788646_2960305160795979776_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CDvHEO_TnaEQ7kNvwFdPQhw&_nc_oc=AdpaOJNYze4OlWD2y0AbCtkavFvzukv3AeoxMQf_y7dy3G5SFKuYru34aFdwj2Jc1QE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIpr62_HBeUP4kiqUnsxO0Gmem9_SEm2ZK4tb1mxyEKQ&oe=6AE74F54"}, {"file_name": "migrated_image.png", "id": "208540827159608", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162702_124387201576475_5406613443337781248_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2sjYU13nqpAQ7kNvwHjlVon&_nc_oc=AdpdMgCOkhp_rMuUEv9EbGa3kSP7itAklwdy8AHZPERWNHyFen30voRMiqpHPwENA2U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQT3hEwvbHLJ1SNHA_D0SiZn-zfcfCn5FjSVbOlNsy7lA&oe=6AE75D33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "2007762539505711", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162703_2007762542839044_612867755552538624_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eKQaeIpyyxcQ7kNvwFtT7D_&_nc_oc=AdrZnWgx_r7Wy1vfkdcxfIE5hJ0m1NBlWUaeq4LlSOCNrgc9M2-weu24-3dr3l6Br4E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZBofOn1nkK-R5AJzGmUSb4dBe6fyPjlF-Ce68nAWbEA&oe=6AE75D98"}, "display_name": "Metro-2: Project Kollie", "keywords": ["zombie", "coldwar", "spy", "undead", "execution"], "long_description": "Be part of an exciting cold war spy story.\n\nA secret Soviet project started in 1958. Its goal was to create the most effective super weapon. Doctors, scientists, engineers and soliders worked together to indite bio-robots for the Russian army. After many consecutive failures the Central Committee closed down the project in 1969 and all the information became classified. The KGB continued the research in an underground facility without the Comittee's knowledge and in 1982 the team had some primitive results. As a CIA agent you have to infiltrate into this facility and gather as much information as possible about the project.\nBut it won't be easy for you because this is one of the most guarded place in the world.\n\nFeatures: \n- fight against zombies and cyborgs\n- cold war story\n- unique execution system\n- exciting fps combat\n- amazing graphics", "short_description": "Be part of an exciting cold war spy story.\n\nAs a CIA agent you have to infiltrate into a soviet underground facility and gather as much information as possible about their secret project.\nBut it won't be easy for you because this is one of the most guarded place in the world."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "https://tech-tro.com/privacy-policy", "developer_terms_of_service_url": "http://metro2.tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "http://metro2.tech-tro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "CASUAL", "HORROR", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended
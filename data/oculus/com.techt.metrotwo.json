Y&_nc_oc=AdrQ6zsS2kqalIbx2BL3CkCWvo2G01gizqlBTKfOfuFUEiYFuYoQtjMFNR--2kEK8Ws&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQp3q4cHMFAPjL6gZxKoi2LqNfhBGiXtMDmJTJtADQYoA&oe=6AF33C33"}, {"file_name": "migrated_image.png", "id": "226214061910137", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162763_143678396273729_6482624053747122176_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FLoZYGnmJqUQ7kNvwHyZ59u&_nc_oc=AdpY6hTR4Iw3tytAr2qh3Mn6N-PN-RYmzjF_UP3bNptCIWZy2lpUCzfgnDcvcUbboDI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDVtLnJlDVTpVouPwsaVNuhecfejAeZ7KLqIzoldFHZQ&oe=6AF3306C"}, {"file_name": "migrated_image.png", "id": "212102596672796", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162707_138523736788646_2960305160795979776_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0kbH-1-0BH4Q7kNvwHJ_YXi&_nc_oc=Adq85y_1cevMrBwnbTITxxZo0I2AFIRrG7zQSsYvr1iW0EtG6pfZuL5NtOmLS55ACHM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHa9Fe5rNkAHN8iTTJfQjV1eh7RknVGE1ysmmQBV1q2Q&oe=6AF32CD4"}, {"file_name": "migrated_image.png", "id": "208540827159608", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162702_124387201576475_5406613443337781248_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7JuVJCjQEcMQ7kNvwG2zYmj&_nc_oc=AdrrjwF68Zs3Ucf7YiHNGUs_z9HC0IblmuKbJtQz8bA-O4h4Fm_vRCeNYV0MkHXOn3Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5PQMTPbW6uaJK3HF3ngJ748BwZSqtPSTqpGhtTNm4lw&oe=6AF33AB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "2007762539505711", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162703_2007762542839044_612867755552538624_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w81GLym1CyoQ7kNvwG-rMLj&_nc_oc=AdpkxSvF72iAUC_pOm2jzTZvdZ1xyPp_J8pWyBCDixWMwpz24s1g_q9_V0kjSQT439g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYRwDh0RyoY-VSX7RyW6FHLQ81qSQtLhGq7a-qIFRoyw&oe=6AF33B18"}, "display_name": "Metro-2: Project Kollie", "keywords": ["zombie", "coldwar", "spy", "undead", "execution"], "long_description": "Be part of an exciting cold war spy story.\n\nA secret Soviet project started in 1958. Its goal was to create the most effective super weapon. Doctors, scientists, engineers and soliders worked together to indite bio-robots for the Russian army. After many consecutive failures the Central Committee closed down the project in 1969 and all the information became classified. The KGB continued the research in an underground facility without the Comittee's knowledge and in 1982 the team had some primitive results. As a CIA agent you have to infiltrate into this facility and gather as much information as possible about the project.\nBut it won't be easy for you because this is one of the most guarded place in the world.\n\nFeatures: \n- fight against zombies and cyborgs\n- cold war story\n- unique execution system\n- exciting fps combat\n- amazing graphics", "short_description": "Be part of an exciting cold war spy story.\n\nAs a CIA agent you have to infiltrate into a soviet underground facility and gather as much information as possible about their secret project.\nBut it won't be easy for you because this is one of the most guarded place in the world."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "https://tech-tro.com/privacy-policy", "developer_terms_of_service_url": "http://metro2.tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "http://metro2.tech-tro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "CASUAL", "HORROR", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended
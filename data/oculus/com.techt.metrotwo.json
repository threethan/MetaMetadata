k&_nc_oc=Adq5eXN7okXB2dYWLF0W6vrmB8m3wBZBNhfDgs0GOfo5KS06F4xN72yNQvoWLvN8TDE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44oyZj81JM5R2pYHZRQMsrzfY9VjAPL20DREx-MhwKGQ&oe=69FDCCF3"}, {"file_name": "migrated_image.png", "id": "226214061910137", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162763_143678396273729_6482624053747122176_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fi61Ktq26iwQ7kNvwEpLV1D&_nc_oc=Adp280O2nYsVEXtvNe8RW2jnMsIVEnandSI6skHOO_9cgXhwWWuapxmTSFaXJ1ch1zw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_hhcMuvo7D5ZEJXZ5RrVUsAM6u76OuMEPJ4j413PLXQ&oe=69FDF96C"}, {"file_name": "migrated_image.png", "id": "212102596672796", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162707_138523736788646_2960305160795979776_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cy6LH9qA8VkQ7kNvwGUi2Wb&_nc_oc=AdqvZ8BMSYDSUuh8q6GXjtwlgfglOCg87A5t1OCMclGY2Dq1fjhgfn8idBoKRp0gQh0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5NusraFWAmw3l5GkfWvIADSjm9W08e17v1-Ltb6kqi0Q&oe=69FDF5D4"}, {"file_name": "migrated_image.png", "id": "208540827159608", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162702_124387201576475_5406613443337781248_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qDJgvYOjk2IQ7kNvwGheCG1&_nc_oc=Adq8eCKCfAeObngGxoUF2BtqfsqI1_VLm3Q0CXWiM67MS0JV_DlCXArmXUkVCc9N1jE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Rx5ncRFw-IKfuGLCaEj3uFLZrnSvui8zFaruqNQv32A&oe=69FE03B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "2007762539505711", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162703_2007762542839044_612867755552538624_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DINXaheTn-wQ7kNvwHWIQhP&_nc_oc=AdrQZuuoCOgO8P9xLDX00ansmiiYarJ62_ekK9-9bDmJtp36t660uuSQMDTWeyNMyHY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6gUxNP0ty9gK-wlNgUE6WpIz9LhqXRUklQgBtXZziNZw&oe=69FE0418"}, "display_name": "Metro-2: Project Kollie", "keywords": ["zombie", "coldwar", "spy", "undead", "execution"], "long_description": "Be part of an exciting cold war spy story.\n\nA secret Soviet project started in 1958. Its goal was to create the most effective super weapon. Doctors, scientists, engineers and soliders worked together to indite bio-robots for the Russian army. After many consecutive failures the Central Committee closed down the project in 1969 and all the information became classified. The KGB continued the research in an underground facility without the Comittee's knowledge and in 1982 the team had some primitive results. As a CIA agent you have to infiltrate into this facility and gather as much information as possible about the project.\nBut it won't be easy for you because this is one of the most guarded place in the world.\n\nFeatures: \n- fight against zombies and cyborgs\n- cold war story\n- unique execution system\n- exciting fps combat\n- amazing graphics", "short_description": "Be part of an exciting cold war spy story.\n\nAs a CIA agent you have to infiltrate into a soviet underground facility and gather as much information as possible about their secret project.\nBut it won't be easy for you because this is one of the most guarded place in the world."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "https://tech-tro.com/privacy-policy", "developer_terms_of_service_url": "http://metro2.tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "http://metro2.tech-tro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "CASUAL", "HORROR", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended
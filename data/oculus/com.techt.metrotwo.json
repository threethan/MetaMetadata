f&_nc_oc=Ado7MgqLUaSDLLWCWPV0J4PZ1d7X2KR73tve8beqXgCnaveZ6_DTXCgIOMg42t5PaQY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0VEdBuwVoloCTZf8phs71Jpjs4jBr06RabdEA2swHMlg&oe=69D79173"}, {"file_name": "migrated_image.png", "id": "226214061910137", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/11162763_143678396273729_6482624053747122176_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RLM47QM05fYQ7kNvwGxBYpU&_nc_oc=AdoUQcS1FlnAF8BL_0bLVU3RXFwOX3WPp6cCfHt76IiP_4-lYAMqqEtJphM7UUSUQVo&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2uu0FemZpjD908xz6ycdb8jtaGwUhH0vPQ7q79FsF24A&oe=69D7BDEC"}, {"file_name": "migrated_image.png", "id": "212102596672796", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/11162707_138523736788646_2960305160795979776_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HPub5-q9SGgQ7kNvwHdBLNk&_nc_oc=Adr8id_QeYH7lgEV_C-3M1BVnK4kIoTcrwgqx7izO4T5EkIIr04QYXRc06yN91raBSY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2VdDIrUXJY8VZ_nKCZQf2yALEvo-C-ON-L2zSm0C28Dw&oe=69D7BA54"}, {"file_name": "migrated_image.png", "id": "208540827159608", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/11162702_124387201576475_5406613443337781248_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xwvCD-_4D0UQ7kNvwHW3BKS&_nc_oc=Adq_5v8UxbBE42dESNVGvxfvQ667IIB_LeBeJWODSTIxC9igYsnuYnsLbu8XnJKGFbY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2_u2CSr9uBndf35J34EN0J1mkYc4AEMYpoT3djN8gr2g&oe=69D78FF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "2007762539505711", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/11162703_2007762542839044_612867755552538624_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QFhhSE090RUQ7kNvwGYHuPo&_nc_oc=Adq36e7kH803iHmZDftD2vAxWAhJF6RQPIf91CubLddNgAjA3vn6JuAou4fIFenFogU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2DKSjAxP0pvaO2Cd2UlX-9c8Df814NzCK1i6H3fvmNQQ&oe=69D79058"}, "display_name": "Metro-2: Project Kollie", "keywords": ["zombie", "coldwar", "spy", "undead", "execution"], "long_description": "Be part of an exciting cold war spy story.\n\nA secret Soviet project started in 1958. Its goal was to create the most effective super weapon. Doctors, scientists, engineers and soliders worked together to indite bio-robots for the Russian army. After many consecutive failures the Central Committee closed down the project in 1969 and all the information became classified. The KGB continued the research in an underground facility without the Comittee's knowledge and in 1982 the team had some primitive results. As a CIA agent you have to infiltrate into this facility and gather as much information as possible about the project.\nBut it won't be easy for you because this is one of the most guarded place in the world.\n\nFeatures: \n- fight against zombies and cyborgs\n- cold war story\n- unique execution system\n- exciting fps combat\n- amazing graphics", "short_description": "Be part of an exciting cold war spy story.\n\nAs a CIA agent you have to infiltrate into a soviet underground facility and gather as much information as possible about their secret project.\nBut it won't be easy for you because this is one of the most guarded place in the world."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "https://tech-tro.com/privacy-policy", "developer_terms_of_service_url": "http://metro2.tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "http://metro2.tech-tro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "CASUAL", "HORROR", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended
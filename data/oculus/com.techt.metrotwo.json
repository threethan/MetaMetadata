r&_nc_oc=Adq8W5YCJskLCGT4FCOoO9zsmkBLaHr3b4oqo8Y96iqOiXoY2F3YQ61GtYCNvr0s4FI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7b8y893LYm_PHDdfWTwmmI7vc4Yca7tue4uqbkU01H4A&oe=69FC7B73"}, {"file_name": "migrated_image.png", "id": "226214061910137", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162763_143678396273729_6482624053747122176_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fi61Ktq26iwQ7kNvwHkhgmJ&_nc_oc=Adqj93Z82Hkm61oqYQpe_I7H4arkJM09QQSO5N1PuZzAUMGFpTPWedIKpDuwP7GJH2M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7LGIiezvZmqePDzbaqkGxVfn9lMPFHdsNaMwYqrsfteg&oe=69FCA7EC"}, {"file_name": "migrated_image.png", "id": "212102596672796", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162707_138523736788646_2960305160795979776_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cy6LH9qA8VkQ7kNvwGKQ0ox&_nc_oc=Adpxh_6BWBE_5WlOpHQyKRsFQgt3SSJvS-5EJuP8on5Pb02UT3DC30TZDqqgTuDTFLs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zQv4uDWsK7WMstYcbbU0s_ZX9jNyBr23fiXhhVOQYNw&oe=69FCA454"}, {"file_name": "migrated_image.png", "id": "208540827159608", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162702_124387201576475_5406613443337781248_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=amkR2fL9SA0Q7kNvwEqppl6&_nc_oc=AdpT7blVcduL1wOmPDHWhoICihF-ai8tC42zBpIl5-bLMLE2Mf8j7zIMaqBjnLzRQAE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6SfcQrRLEjwYYoUbrcWxWTNVAMmejKnFAJ-SldsE2S4g&oe=69FCB233"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "2007762539505711", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162703_2007762542839044_612867755552538624_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DINXaheTn-wQ7kNvwETdYj_&_nc_oc=Adr1bOmb-ff-GIlH_j13FU1dH3oQ3ke4QZ-uKk4Y2w1CwNAjh97WAGERV8L7ogeZAY4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Bln2hyATvyTg0s_4uzGKQs9p1SnXujegSH7d4KF_D6w&oe=69FCB298"}, "display_name": "Metro-2: Project Kollie", "keywords": ["zombie", "coldwar", "spy", "undead", "execution"], "long_description": "Be part of an exciting cold war spy story.\n\nA secret Soviet project started in 1958. Its goal was to create the most effective super weapon. Doctors, scientists, engineers and soliders worked together to indite bio-robots for the Russian army. After many consecutive failures the Central Committee closed down the project in 1969 and all the information became classified. The KGB continued the research in an underground facility without the Comittee's knowledge and in 1982 the team had some primitive results. As a CIA agent you have to infiltrate into this facility and gather as much information as possible about the project.\nBut it won't be easy for you because this is one of the most guarded place in the world.\n\nFeatures: \n- fight against zombies and cyborgs\n- cold war story\n- unique execution system\n- exciting fps combat\n- amazing graphics", "short_description": "Be part of an exciting cold war spy story.\n\nAs a CIA agent you have to infiltrate into a soviet underground facility and gather as much information as possible about their secret project.\nBut it won't be easy for you because this is one of the most guarded place in the world."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "https://tech-tro.com/privacy-policy", "developer_terms_of_service_url": "http://metro2.tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "http://metro2.tech-tro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "CASUAL", "HORROR", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended
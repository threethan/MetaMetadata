j&_nc_oc=AdoVYV__XeiFQefBPZ79w00tL8VaXO7ILe9L1zPtpiHkXG7wEywenSY1Rc9bUII_N9I&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA8R2_fQxc2Zv29CuJBRJuxARwKK31Ox4htLkqpGpS3kA&oe=6A4E70B3"}, {"file_name": "migrated_image.png", "id": "226214061910137", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162763_143678396273729_6482624053747122176_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tvOFa3cUCCAQ7kNvwHTZw1o&_nc_oc=AdoIKkL0XDfxnBuOx5dEdeoFq_RhbLqWD5b3sB77LZdTxsW_SzBF2Dfh9LVio251Zes&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDyYCYP2DomdaMsYw9UY4k6Rl5_20YQHpgNJWH8unSVkA&oe=6A4E64EC"}, {"file_name": "migrated_image.png", "id": "212102596672796", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/11162707_138523736788646_2960305160795979776_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OTxE2SMIMfQQ7kNvwEKdnx-&_nc_oc=AdpWSHqegT0Anpcqxb7t4eCsfQI6AwafQx448XLNXC3gMEyGrzt5dN5CjjF-xwJU0lc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD3UKm-YKSLvosW10GgpxKSgtIbljTqUyF359pIf4qnkw&oe=6A4E6154"}, {"file_name": "migrated_image.png", "id": "208540827159608", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162702_124387201576475_5406613443337781248_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2WgxbufWG2cQ7kNvwH3z4Yg&_nc_oc=Ado0Fs-e1x_CgJbq73v8AH4BGYvnnYUBo2TS_3HsKloiwn1V6XAE9Ql8KyQHKoQ1EE4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDqvjHVpNWZCi-UreURTmWRhE_UiT55MgoPXVNN6CVG8A&oe=6A4E6F33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "2007762539505711", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/11162703_2007762542839044_612867755552538624_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sr_pHETOMM4Q7kNvwEEkFvs&_nc_oc=AdoAU2IoSsnmbBMck21Acpetyh6A594pmuJxUcYXI5xVhzFunLA6kchbV8w4qavT2Os&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCryf2ubNbp3T5Q-JfZ9kGrUDShvsX7AIG8RujrQuzqzw&oe=6A4E6F98"}, "display_name": "Metro-2: Project Kollie", "keywords": ["zombie", "coldwar", "spy", "undead", "execution"], "long_description": "Be part of an exciting cold war spy story.\n\nA secret Soviet project started in 1958. Its goal was to create the most effective super weapon. Doctors, scientists, engineers and soliders worked together to indite bio-robots for the Russian army. After many consecutive failures the Central Committee closed down the project in 1969 and all the information became classified. The KGB continued the research in an underground facility without the Comittee's knowledge and in 1982 the team had some primitive results. As a CIA agent you have to infiltrate into this facility and gather as much information as possible about the project.\nBut it won't be easy for you because this is one of the most guarded place in the world.\n\nFeatures: \n- fight against zombies and cyborgs\n- cold war story\n- unique execution system\n- exciting fps combat\n- amazing graphics", "short_description": "Be part of an exciting cold war spy story.\n\nAs a CIA agent you have to infiltrate into a soviet underground facility and gather as much information as possible about their secret project.\nBut it won't be easy for you because this is one of the most guarded place in the world."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "https://tech-tro.com/privacy-policy", "developer_terms_of_service_url": "http://metro2.tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "http://metro2.tech-tro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "CASUAL", "HORROR", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended
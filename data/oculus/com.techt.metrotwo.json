R&_nc_oc=Adq0ZA5wmKWxFfCMTrjDKg2cy6hcXmnbZ3biGX38rJhOTbNFK0X5Ug0ZP3NVt8I3TGM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErfQdl_oSVzrbk28g2yV3sz6kRdR74B_u7FjrCslKsdA&oe=6A7473F3"}, {"file_name": "migrated_image.png", "id": "226214061910137", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162763_143678396273729_6482624053747122176_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=icmRJOdnClMQ7kNvwGlsrYS&_nc_oc=AdraSimuJ2-mPox-focBgz4-ir64DzQa7pSbu_sFEwcQM9d4n_wFskqduugoUUEuJEY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHrNkosw7POy4kPi8ce0TRLQ32-SRZriS12tItURMQOwQ&oe=6A74A06C"}, {"file_name": "migrated_image.png", "id": "212102596672796", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162707_138523736788646_2960305160795979776_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gaNhJiKQPMkQ7kNvwGNdGfW&_nc_oc=AdqaCsWQucdp1wUBisLWBnLD_mW64i3v6bK8oYIRPHBYze2_tFHFNvRwnee5kP6__kM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmM0OHcUmx5h6rvGrSZ6T9fV3bslG6QAmQGNSQAuwh4g&oe=6A749CD4"}, {"file_name": "migrated_image.png", "id": "208540827159608", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162702_124387201576475_5406613443337781248_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DbY6zjjlk1AQ7kNvwFFbwsd&_nc_oc=AdoLh-JXHVV2EpI0yPkCynHsBuyWRTfh4974mu0MwJTSIbiSycwnfqzwWty1CLAz_6M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6SOrxVUc01unxydiXw_PY_MTyp2w5hXeK9VGz1_5c5g&oe=6A74AAB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "2007762539505711", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162703_2007762542839044_612867755552538624_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ydUrSOUMl_oQ7kNvwFggYK7&_nc_oc=Adp2adnFTfPxEVuKaba6egOgn5CPBdJl6K4aNChlgNWS_dFCbIWRA-nXRN7mj3M1qjE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGFm91sSWlLGkZyp7Az5EoAnGoAYje9a14MSY_KzD9MhA&oe=6A7472D8"}, "display_name": "Metro-2: Project Kollie", "keywords": ["zombie", "coldwar", "spy", "undead", "execution"], "long_description": "Be part of an exciting cold war spy story.\n\nA secret Soviet project started in 1958. Its goal was to create the most effective super weapon. Doctors, scientists, engineers and soliders worked together to indite bio-robots for the Russian army. After many consecutive failures the Central Committee closed down the project in 1969 and all the information became classified. The KGB continued the research in an underground facility without the Comittee's knowledge and in 1982 the team had some primitive results. As a CIA agent you have to infiltrate into this facility and gather as much information as possible about the project.\nBut it won't be easy for you because this is one of the most guarded place in the world.\n\nFeatures: \n- fight against zombies and cyborgs\n- cold war story\n- unique execution system\n- exciting fps combat\n- amazing graphics", "short_description": "Be part of an exciting cold war spy story.\n\nAs a CIA agent you have to infiltrate into a soviet underground facility and gather as much information as possible about their secret project.\nBut it won't be easy for you because this is one of the most guarded place in the world."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "https://tech-tro.com/privacy-policy", "developer_terms_of_service_url": "http://metro2.tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "http://metro2.tech-tro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "CASUAL", "HORROR", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended
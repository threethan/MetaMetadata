i&_nc_oc=AdpbNAiwKZfpFr81yq1VERa-nz3d3AfDmGcdkP3OnR2VvU8-AtDZ4VGv3f4W_7mLOkQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_UnoyZGPu18zmBKoXCAI3rHvVQD_kJWZ_HznMnpoLdA&oe=6AA573B3"}, {"file_name": "migrated_image.png", "id": "226214061910137", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162763_143678396273729_6482624053747122176_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jh_GctTkx8UQ7kNvwFGO2OS&_nc_oc=Adq3NxOEAxjJ5TGhBH_8Ikb0L-8iw5w_9LP1FY4a88mOVaKeAL3SIH5aFnpoSl_FRUQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIyDSiWBQ6wZoTuCLmv59jmEoSEw7mbxVPJT9oRNpsvIg&oe=6AA567EC"}, {"file_name": "migrated_image.png", "id": "212102596672796", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162707_138523736788646_2960305160795979776_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_PlbEAWHSdIQ7kNvwE23qzK&_nc_oc=AdoDco6tZKn7TkIx0Z9czKDxxX2TN683vrc6vkY9E906BJfc9D8Nw4G31tLZLHcg2Vc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnLfM2RE_Asrwuv4QlcriFfg5ARisnw_uEzNgCho84Ag&oe=6AA56454"}, {"file_name": "migrated_image.png", "id": "208540827159608", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162702_124387201576475_5406613443337781248_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LmgdINbr73QQ7kNvwEJVYw5&_nc_oc=AdqXjAfpIIWplBJKf6iXh7qlxNiVGbVkiB0shPVisSVbTafVfcCDoY2Fo9HcA2jsvj0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIofsPE-MMxfHp82328BrN73XW7RWvYPNKf7wpb0pUVjA&oe=6AA57233"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "2007762539505711", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162703_2007762542839044_612867755552538624_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TMs4sJgWwrwQ7kNvwE2CRaD&_nc_oc=AdrQibmxuAIs6rz_LOsbQrasAxZXVrJy-yEXjlpIo1V2L9-uF59PqIY7lVeCS3xqHcw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZKv6KFnX_BmXkkQSDj-yMjNXfmPXo42KGeCWQBB5qpQ&oe=6AA57298"}, "display_name": "Metro-2: Project Kollie", "keywords": ["zombie", "coldwar", "spy", "undead", "execution"], "long_description": "Be part of an exciting cold war spy story.\n\nA secret Soviet project started in 1958. Its goal was to create the most effective super weapon. Doctors, scientists, engineers and soliders worked together to indite bio-robots for the Russian army. After many consecutive failures the Central Committee closed down the project in 1969 and all the information became classified. The KGB continued the research in an underground facility without the Comittee's knowledge and in 1982 the team had some primitive results. As a CIA agent you have to infiltrate into this facility and gather as much information as possible about the project.\nBut it won't be easy for you because this is one of the most guarded place in the world.\n\nFeatures: \n- fight against zombies and cyborgs\n- cold war story\n- unique execution system\n- exciting fps combat\n- amazing graphics", "short_description": "Be part of an exciting cold war spy story.\n\nAs a CIA agent you have to infiltrate into a soviet underground facility and gather as much information as possible about their secret project.\nBut it won't be easy for you because this is one of the most guarded place in the world."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "https://tech-tro.com/privacy-policy", "developer_terms_of_service_url": "http://metro2.tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "http://metro2.tech-tro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "CASUAL", "HORROR", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended
K&_nc_oc=AdqrBI5K4RXGE_Ap5g5KW1tvCIUzAFAsoESZFJ3VXlh51O20Pc6PMg8kzdQ6Cwa6P8k&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDG4wD0P8uSN0m-j46WrYzP_bZffGUPGtqPZsInJ65DpQ&oe=6A5659B3"}, {"file_name": "migrated_image.png", "id": "226214061910137", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/11162763_143678396273729_6482624053747122176_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4bANL9wei1wQ7kNvwF5m1H3&_nc_oc=Adq6phQ3m2txcQ5i8zZoxRVlAso6u6QAmimifdH0C5XFx4zw5BIFm6oLwRDOgxSBVTk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCo1g59pcjr4W7UoWg2c79-A-1zsEDhdJh_dPZBnNOfwA&oe=6A564DEC"}, {"file_name": "migrated_image.png", "id": "212102596672796", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/11162707_138523736788646_2960305160795979776_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BMbp2hNUkJsQ7kNvwFQIs9Y&_nc_oc=AdoWsB9rOCICRbQrgVfGuhefHSXBs8mSp1f5iT8xlLLvMtV04PIzyfTq3ItUCsttG34&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCgymYJbeLh4pywkgdhB3ht1MhbCPVolAYtgnUmDb_a8A&oe=6A564A54"}, {"file_name": "migrated_image.png", "id": "208540827159608", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/11162702_124387201576475_5406613443337781248_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bJS0lmRWHOUQ7kNvwGN6-bP&_nc_oc=AdotwwdUdBO4sZ0TMg93nEu1OWLmGOh5wH-m2z5Qt_Ke4ILNMuSi1pAJ5obA_kdTKzQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBu9Xb6qRh9Q1zk8o2teEKgB5QQLsLCrRozQkj4aO6bDg&oe=6A565833"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "2007762539505711", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/11162703_2007762542839044_612867755552538624_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9yoqYCQJSEoQ7kNvwFpP7DP&_nc_oc=AdpN5kzY0WFdh7gZp2xgPUxhv94ioJwPeX_7a94gm-RyF_oJelw-rVCS1haUMs3oiXY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBLV-aP2zEPrJOgVHqqMEVMIxi4tWeMscGLZ4rzEcLGNw&oe=6A565898"}, "display_name": "Metro-2: Project Kollie", "keywords": ["zombie", "coldwar", "spy", "undead", "execution"], "long_description": "Be part of an exciting cold war spy story.\n\nA secret Soviet project started in 1958. Its goal was to create the most effective super weapon. Doctors, scientists, engineers and soliders worked together to indite bio-robots for the Russian army. After many consecutive failures the Central Committee closed down the project in 1969 and all the information became classified. The KGB continued the research in an underground facility without the Comittee's knowledge and in 1982 the team had some primitive results. As a CIA agent you have to infiltrate into this facility and gather as much information as possible about the project.\nBut it won't be easy for you because this is one of the most guarded place in the world.\n\nFeatures: \n- fight against zombies and cyborgs\n- cold war story\n- unique execution system\n- exciting fps combat\n- amazing graphics", "short_description": "Be part of an exciting cold war spy story.\n\nAs a CIA agent you have to infiltrate into a soviet underground facility and gather as much information as possible about their secret project.\nBut it won't be easy for you because this is one of the most guarded place in the world."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "https://tech-tro.com/privacy-policy", "developer_terms_of_service_url": "http://metro2.tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "http://metro2.tech-tro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "CASUAL", "HORROR", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended
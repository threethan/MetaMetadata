oqsvi0p3J_zNcpbZQ&oe=69AAB2AC"}, {"file_name": "migrated_image.png", "id": "212102596672796", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/11162707_138523736788646_2960305160795979776_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eyYMceXIPd4Q7kNvwGmjqj6&_nc_oc=AdnyyRKBCwSCXDVaFJJFRK6sh-KYpeHvQ3xge6K5xhp9HBC3XWmL_RpSFAm03caka1Q&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyxlEs-gF7C4uPbxNOTQOQ9KwNe-UvYIPfP_YQMr6Bqcw&oe=69AAAF14"}, {"file_name": "migrated_image.png", "id": "208540827159608", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/11162702_124387201576475_5406613443337781248_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DAlvTa_u2ikQ7kNvwFIMnir&_nc_oc=AdkiCG2LhQXUFVhjIPX4jl5FjoKSZv_QsVPABCRA1QpkJOGtzzGbWYvlv9ZDKfyivQQ&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_AfweqVHlSberm9ZM_uZiuPMxzJQ6BA2mNySFXvFhdbdmGw&oe=69AABCF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "2007762539505711", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162703_2007762542839044_612867755552538624_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HWy3Kh1QP20Q7kNvwFGWKw0&_nc_oc=AdklOcxiHib8eY-butfwQB_KgfaZorCKcHyFWSwzVjvVupe18PozBP7qTwJY2Cg3pPw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfxlmOOaq7K9_j8qGFQE0x-96NeTWlJnRd7W0XCZhG9pgA&oe=69AABD58"}, "display_name": "Metro-2: Project Kollie", "keywords": ["zombie", "coldwar", "spy", "undead", "execution"], "long_description": "Be part of an exciting cold war spy story.\n\nA secret Soviet project started in 1958. Its goal was to create the most effective super weapon. Doctors, scientists, engineers and soliders worked together to indite bio-robots for the Russian army. After many consecutive failures the Central Committee closed down the project in 1969 and all the information became classified. The KGB continued the research in an underground facility without the Comittee's knowledge and in 1982 the team had some primitive results. As a CIA agent you have to infiltrate into this facility and gather as much information as possible about the project.\nBut it won't be easy for you because this is one of the most guarded place in the world.\n\nFeatures: \n- fight against zombies and cyborgs\n- cold war story\n- unique execution system\n- exciting fps combat\n- amazing graphics", "short_description": "Be part of an exciting cold war spy story.\n\nAs a CIA agent you have to infiltrate into a soviet underground facility and gather as much information as possible about their secret project.\nBut it won't be easy for you because this is one of the most guarded place in the world."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "http://metro2.tech-tro.com/privacy-policy", "developer_terms_of_service_url": "http://metro2.tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "http://metro2.tech-tro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "CASUAL", "HORROR", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_GB"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "239421851718213"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1909429469097909", "version": "1.003"}, "id": "108271096558905", "channel_name": "LIVE"}]}, 
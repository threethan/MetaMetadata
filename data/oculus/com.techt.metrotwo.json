5&_nc_oc=AdpUz8j8yGHoojf-th7ymXMgu-HI89CV7nxq118ntZkduGjk8dvmw532ydgExfXusw8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEqPA_4py4k1z7zbigZe-xuEwoQRaQ_xx_FMOX4CfP51A&oe=6A883A73"}, {"file_name": "migrated_image.png", "id": "226214061910137", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/11162763_143678396273729_6482624053747122176_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SyydabKEjXAQ7kNvwFg9uEb&_nc_oc=Adp4ERNMc3oLMoXmBo00cbClM2WNiPqlpeUdJ8vQyXWWvwk2tl7ZMsRiidAFwMiMQaM&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGEP6GTHPT-Ya-kH5G4kTTEWp4WOQe3cupeGoJrmDF3CQ&oe=6A882EAC"}, {"file_name": "migrated_image.png", "id": "212102596672796", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/11162707_138523736788646_2960305160795979776_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r2gHa68SZsYQ7kNvwGA6MKD&_nc_oc=AdpPgREnhCZItt_p1ENPzqcUUfDVwBvkveJRAMcxs7Be0OpPperj9qe47de7MRnHQGQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUVUeRumGQMY7Po12xeH4CuqANA07ZSMEl51bEW9YqjQ&oe=6A882B14"}, {"file_name": "migrated_image.png", "id": "208540827159608", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/11162702_124387201576475_5406613443337781248_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H7e_khtoonIQ7kNvwGdVbqy&_nc_oc=Adqib30Ms3ef-LqbbOoUC3-5QUgN6mlT4vZYKMoP7u3r6Hs3RDpkJ-mDT77yDoU3Puk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFTsJlG_iIHfMGgXHH6XFl0mJQKbOmGv4F9M13R6vKOVg&oe=6A8838F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "2007762539505711", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/11162703_2007762542839044_612867755552538624_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ELD9BUR80qAQ7kNvwE-O75G&_nc_oc=Adp4RD81UFXk9_NdMQSpHWGjwGjwSOtBbyg2RCJBAikoVAfnzTyZG3DAPDPlGHMtk2s&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG3wuFTlL8tkk41d3juh_HhJ2SEERqG9Z_38-0H7OuHrQ&oe=6A883958"}, "display_name": "Metro-2: Project Kollie", "keywords": ["zombie", "coldwar", "spy", "undead", "execution"], "long_description": "Be part of an exciting cold war spy story.\n\nA secret Soviet project started in 1958. Its goal was to create the most effective super weapon. Doctors, scientists, engineers and soliders worked together to indite bio-robots for the Russian army. After many consecutive failures the Central Committee closed down the project in 1969 and all the information became classified. The KGB continued the research in an underground facility without the Comittee's knowledge and in 1982 the team had some primitive results. As a CIA agent you have to infiltrate into this facility and gather as much information as possible about the project.\nBut it won't be easy for you because this is one of the most guarded place in the world.\n\nFeatures: \n- fight against zombies and cyborgs\n- cold war story\n- unique execution system\n- exciting fps combat\n- amazing graphics", "short_description": "Be part of an exciting cold war spy story.\n\nAs a CIA agent you have to infiltrate into a soviet underground facility and gather as much information as possible about their secret project.\nBut it won't be easy for you because this is one of the most guarded place in the world."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "https://tech-tro.com/privacy-policy", "developer_terms_of_service_url": "http://metro2.tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "http://metro2.tech-tro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "CASUAL", "HORROR", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended
y&_nc_oc=AdrIAnvsm952F_lLp4PO0Zk_D8k72djBh3POHZy9inWp_IIX1TpWRgIlUmCzxOMzf58&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDnMXYYcaEk-mIqwPCjGGBtPxIGZxLZnRWVn1vw9o8NUg&oe=6A492AB3"}, {"file_name": "migrated_image.png", "id": "226214061910137", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162763_143678396273729_6482624053747122176_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2T3Vnxc0oooQ7kNvwGQVH05&_nc_oc=Adq2T7I7wiCY99_zivozj0epUaDhVcIk08CQb_sdP6lwOhxWLlPPG-cjVo8Gp9GBKPQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBk3It2-JPW1nNuAuTN1ZSVUO48Rkct0Rl1v5qYAAvxAA&oe=6A491EEC"}, {"file_name": "migrated_image.png", "id": "212102596672796", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162707_138523736788646_2960305160795979776_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bT-MyL2SsG0Q7kNvwGIZW2m&_nc_oc=AdrcafgIE7brQsKB2KkmB5hDVWZv9KMwvBjfnJ8M48siYOM4sbssIuUxOYRscm7_-SI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCSWZ9QZlGPwt_7ptl1M2w8SlOo9i_apCwZrI8ZShfd7A&oe=6A491B54"}, {"file_name": "migrated_image.png", "id": "208540827159608", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162702_124387201576475_5406613443337781248_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yp_S_rw1wv8Q7kNvwHKQoS5&_nc_oc=AdqQ3o7LMG5odKdliure-jeRzDhmC6GFR3QEsVf2irban3Yg22UOdvRAFjMWGi0xNWU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAHLbEgc7puQA2V9rZOqbKRFziIa2Y8D9XYph_5EThbTw&oe=6A492933"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "2007762539505711", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162703_2007762542839044_612867755552538624_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FnEieuPUrAAQ7kNvwEYH7t0&_nc_oc=AdoFhQ3Sd-AY22HvZSarg74YyXHjR4J9DSWDnobZ-jhZnyHwlxvcQahiM1w670D3aao&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAfS24CPCUhnxttcCfYqb8v0TCxfHUwua2oahP5A0H36w&oe=6A492998"}, "display_name": "Metro-2: Project Kollie", "keywords": ["zombie", "coldwar", "spy", "undead", "execution"], "long_description": "Be part of an exciting cold war spy story.\n\nA secret Soviet project started in 1958. Its goal was to create the most effective super weapon. Doctors, scientists, engineers and soliders worked together to indite bio-robots for the Russian army. After many consecutive failures the Central Committee closed down the project in 1969 and all the information became classified. The KGB continued the research in an underground facility without the Comittee's knowledge and in 1982 the team had some primitive results. As a CIA agent you have to infiltrate into this facility and gather as much information as possible about the project.\nBut it won't be easy for you because this is one of the most guarded place in the world.\n\nFeatures: \n- fight against zombies and cyborgs\n- cold war story\n- unique execution system\n- exciting fps combat\n- amazing graphics", "short_description": "Be part of an exciting cold war spy story.\n\nAs a CIA agent you have to infiltrate into a soviet underground facility and gather as much information as possible about their secret project.\nBut it won't be easy for you because this is one of the most guarded place in the world."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "https://tech-tro.com/privacy-policy", "developer_terms_of_service_url": "http://metro2.tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "http://metro2.tech-tro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "CASUAL", "HORROR", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended
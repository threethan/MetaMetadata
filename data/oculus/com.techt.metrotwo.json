X&_nc_oc=AdoD_Ap2cwQZqPVNXXC9kbMTF2tTq85HmXSyUxwtCpN9b0WUFbq825vG__DT-vXwLA0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHholunkrCJkL-CLkF9SSVPRDEV0JCgCOmUfxT9gmyx_g&oe=6A7B0B73"}, {"file_name": "migrated_image.png", "id": "226214061910137", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162763_143678396273729_6482624053747122176_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wGBBczEufFoQ7kNvwFt06vO&_nc_oc=AdoWifP2j0r7-DExs_WMrUE4UUYri24AS2l1lzNqNin21hC_puQJiLqD_rwy-YBIRDY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHL6DmL1N1iC5bfW2dNt9rfJPeFLWbbMa57FBpTKhVRag&oe=6A7B37EC"}, {"file_name": "migrated_image.png", "id": "212102596672796", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162707_138523736788646_2960305160795979776_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ZQpQZVBqNYQ7kNvwE4ewG_&_nc_oc=Adov2k4gEDqIh_Rt3WwT-T-qqPo3K-u0oxRo-8b9itPhkFWbGfq_v8_O0S353nPxtVA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEruwlLTbd5I0Ev4HRAU3_SpWcN6lYkx3G072hpY_hxuA&oe=6A7B3454"}, {"file_name": "migrated_image.png", "id": "208540827159608", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162702_124387201576475_5406613443337781248_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G6JelvhpcnQQ7kNvwEzQE2M&_nc_oc=Ado5ystTVWpFVgDWPpFNryvS9wUJIDSQnEk910PD-axn7ESc4W9MRg6SvnF7opZn2Io&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEtpzwlYF_Q3Zwqtclt4yz4OWpO9ui1doHgheVoCMR0pw&oe=6A7B09F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "2007762539505711", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162703_2007762542839044_612867755552538624_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1r8eOQ3LDLcQ7kNvwH9xQn6&_nc_oc=Adr1u2cKg_G-zpLj9jzrwVqClKD-MFQWCBBj5mF8W3wbEql12JBsszwp8-d0ojjDkOM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGyO3XBUp4d0x8_X-iJRqxCU0MNNyLwSPDR9-wDWVV70A&oe=6A7B0A58"}, "display_name": "Metro-2: Project Kollie", "keywords": ["zombie", "coldwar", "spy", "undead", "execution"], "long_description": "Be part of an exciting cold war spy story.\n\nA secret Soviet project started in 1958. Its goal was to create the most effective super weapon. Doctors, scientists, engineers and soliders worked together to indite bio-robots for the Russian army. After many consecutive failures the Central Committee closed down the project in 1969 and all the information became classified. The KGB continued the research in an underground facility without the Comittee's knowledge and in 1982 the team had some primitive results. As a CIA agent you have to infiltrate into this facility and gather as much information as possible about the project.\nBut it won't be easy for you because this is one of the most guarded place in the world.\n\nFeatures: \n- fight against zombies and cyborgs\n- cold war story\n- unique execution system\n- exciting fps combat\n- amazing graphics", "short_description": "Be part of an exciting cold war spy story.\n\nAs a CIA agent you have to infiltrate into a soviet underground facility and gather as much information as possible about their secret project.\nBut it won't be easy for you because this is one of the most guarded place in the world."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "https://tech-tro.com/privacy-policy", "developer_terms_of_service_url": "http://metro2.tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "http://metro2.tech-tro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "CASUAL", "HORROR", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended
_&_nc_oc=AdpzV3JblxdpnPqN82jH9W3CASHxNWEpEkjUariklzjwSxZAf2DICeeNbmDTO_gIQfA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0fwnWqCObow-WzMR4PlTXKKQAD-Pm-OHDYMQZgVFpQw&oe=6A902373"}, {"file_name": "migrated_image.png", "id": "226214061910137", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162763_143678396273729_6482624053747122176_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IdgdyGPKy-MQ7kNvwHirw-L&_nc_oc=AdrjuaMDFGVKt8aiZv3rDori0hqIZM9nSUTRH9fNJ7oYtfMaFKOZzqXyN3HyNAUdetw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHhpP3ck52nzi97woEFMOqaOkrWZveZGL7fKQIWZnoM2g&oe=6A9017AC"}, {"file_name": "migrated_image.png", "id": "212102596672796", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162707_138523736788646_2960305160795979776_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ubViW2ZTJ8AQ7kNvwFfm6IP&_nc_oc=AdpPNPqTRfqZI50ZjrNWoS2RONlxTFS2qkCaXPB5DAvDDLg7qrEUqpALtYjuTggeMs4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLF9Z_GmQo6kxIwBZOACIVpzMkPxR-YFWqO2xWr7lA5g&oe=6A901414"}, {"file_name": "migrated_image.png", "id": "208540827159608", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162702_124387201576475_5406613443337781248_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RMJRuVxaBoAQ7kNvwGu3m2K&_nc_oc=Adq0KNZ_bXPp0aPTcanVD4MZEFyngvKIUBVzuowUzlUDXmkCwPPRmQt-ozk38tTSIYc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGMEFFhZIwwfXP-Fj0tgDZZs7vm52r1alIqkvWqQTrgjg&oe=6A9021F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "2007762539505711", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/11162703_2007762542839044_612867755552538624_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nqMEGx6QG5wQ7kNvwHsmNZz&_nc_oc=AdoaLE0I1N9v1p3q3nASqvY2dSpeRwtmbs4SsxwtpV3bvdR2tDT60ZCBwZE4NwHumfY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEjx42q2Yj8btwUfjIqU379vvb0tlnunZK528SxRbEj_g&oe=6A902258"}, "display_name": "Metro-2: Project Kollie", "keywords": ["zombie", "coldwar", "spy", "undead", "execution"], "long_description": "Be part of an exciting cold war spy story.\n\nA secret Soviet project started in 1958. Its goal was to create the most effective super weapon. Doctors, scientists, engineers and soliders worked together to indite bio-robots for the Russian army. After many consecutive failures the Central Committee closed down the project in 1969 and all the information became classified. The KGB continued the research in an underground facility without the Comittee's knowledge and in 1982 the team had some primitive results. As a CIA agent you have to infiltrate into this facility and gather as much information as possible about the project.\nBut it won't be easy for you because this is one of the most guarded place in the world.\n\nFeatures: \n- fight against zombies and cyborgs\n- cold war story\n- unique execution system\n- exciting fps combat\n- amazing graphics", "short_description": "Be part of an exciting cold war spy story.\n\nAs a CIA agent you have to infiltrate into a soviet underground facility and gather as much information as possible about their secret project.\nBut it won't be easy for you because this is one of the most guarded place in the world."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "https://tech-tro.com/privacy-policy", "developer_terms_of_service_url": "http://metro2.tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "http://metro2.tech-tro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "CASUAL", "HORROR", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended
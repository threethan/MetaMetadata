5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIlibyJ0-2jSLNd-G1d9QaavIybneKU8C-xlRhLBbSqaA&oe=6ABBD16C"}, {"file_name": "migrated_image.png", "id": "212102596672796", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162707_138523736788646_2960305160795979776_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dHKhqFgPuBgQ7kNvwHO4xT8&_nc_oc=AdrVvl0QF7yv9n11U4sJQShFd0ouKIKT54mTh9nGcx0qJ1ufvHghOnlVVKoM1E5bzTA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL50NYeXQxLdICVoHlzAfD-Nr3BqSEz_W0iPhgWoSqJjQ&oe=6ABBCDD4"}, {"file_name": "migrated_image.png", "id": "208540827159608", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162702_124387201576475_5406613443337781248_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7TUFwi3sqP8Q7kNvwFFfxKK&_nc_oc=Adqy_Mz35MaV6irZRIrwCE1wP8pevL7OooeAgagrhhUV6enkrABbwt1v9bpPeTbki6U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLcY66E6xbwdK3PoQe2-gz1q7NmcYUx0AwN5uRUeSlvsQ&oe=6ABBDBB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "2007762539505711", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162703_2007762542839044_612867755552538624_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R1UcdOI0wzkQ7kNvwHG5gCG&_nc_oc=Adp_XfNmP19LIA0hdNPIq-1bVtPGytTbIidXnuLr3AuNHjnXLcsqArkGJUDDRE89CpI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIn5gGbbqZZn5TuRAi4RZoBL-W-lwmzBcME5Xkhfux2sw&oe=6ABBDC18"}, "display_name": "Metro-2: Project Kollie", "keywords": ["zombie", "coldwar", "spy", "undead", "execution"], "long_description": "Be part of an exciting cold war spy story.\n\nA secret Soviet project started in 1958. Its goal was to create the most effective super weapon. Doctors, scientists, engineers and soliders worked together to indite bio-robots for the Russian army. After many consecutive failures the Central Committee closed down the project in 1969 and all the information became classified. The KGB continued the research in an underground facility without the Comittee's knowledge and in 1982 the team had some primitive results. As a CIA agent you have to infiltrate into this facility and gather as much information as possible about the project.\nBut it won't be easy for you because this is one of the most guarded place in the world.\n\nFeatures: \n- fight against zombies and cyborgs\n- cold war story\n- unique execution system\n- exciting fps combat\n- amazing graphics", "short_description": "Be part of an exciting cold war spy story.\n\nAs a CIA agent you have to infiltrate into a soviet underground facility and gather as much information as possible about their secret project.\nBut it won't be easy for you because this is one of the most guarded place in the world."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "http://metro2.tech-tro.com/privacy-policy", "developer_terms_of_service_url": "http://metro2.tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "http://metro2.tech-tro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "CASUAL", "HORROR", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_GB"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "239421851718213"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1909429469097909
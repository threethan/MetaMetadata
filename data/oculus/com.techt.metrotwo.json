q&_nc_oc=Adr3Wc9_6JxnuqN4xYQmfGNGHp0Tf7kDQQoyFApbqN78DNhOI8mWZPTFFllrPLk4C88&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO43sXqviAYxVwE-pxWqrOR5hY2DjmXxY6IVIhEX1rqbQ&oe=6AC274B3"}, {"file_name": "migrated_image.png", "id": "226214061910137", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162763_143678396273729_6482624053747122176_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e_b4Ty6J6i8Q7kNvwGXMkz6&_nc_oc=AdqtW3Co895HVRNGaQebZe2VxiFBgyDGFmxHep2RYlVsNXERnVSp6_8BgMOeVcoOnCY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMdbgcVWRhTruI1yitUKBn3ip33xI04u0aX9ZSAsKeF5g&oe=6AC268EC"}, {"file_name": "migrated_image.png", "id": "212102596672796", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162707_138523736788646_2960305160795979776_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fPX6fsxtCYMQ7kNvwE9mnAM&_nc_oc=AdqURZRrovgfj5J_g-jOLVzZGWXdjnWvDyALOhJFflvUUBrsO9zQHdQx7xZAi4AHLNc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPll-YzV5Wkwn7OpRDfPQV9_X5L4gGAWEfLULs7rvuFVQ&oe=6AC26554"}, {"file_name": "migrated_image.png", "id": "208540827159608", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162702_124387201576475_5406613443337781248_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eUX5H-qQWXoQ7kNvwFhBGAL&_nc_oc=AdpWCko6SdBLYKyv9pcwsBCO25-iya5yBLp4dOqMROIjLmXFwiPOCyECCa6MpzNs6Iw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNeUo1DCUqOIEsnu_2VXIKW9T1MPFvX1SjuYijQog_oKg&oe=6AC27333"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "2007762539505711", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162703_2007762542839044_612867755552538624_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=esmJfkGjqj8Q7kNvwH7tCXr&_nc_oc=AdpTX-bI5WLAwR_ulhcY4QtwXxFDnBneIbhlV9YJrvitQYqWjWsLXjT9m3nElw9yc2k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQONMKzmANFJmAXLTn4d9bnkdD8dklM8xCl_C7SsxrmZrQ&oe=6AC27398"}, "display_name": "Metro-2: Project Kollie", "keywords": ["zombie", "coldwar", "spy", "undead", "execution"], "long_description": "Be part of an exciting cold war spy story.\n\nA secret Soviet project started in 1958. Its goal was to create the most effective super weapon. Doctors, scientists, engineers and soliders worked together to indite bio-robots for the Russian army. After many consecutive failures the Central Committee closed down the project in 1969 and all the information became classified. The KGB continued the research in an underground facility without the Comittee's knowledge and in 1982 the team had some primitive results. As a CIA agent you have to infiltrate into this facility and gather as much information as possible about the project.\nBut it won't be easy for you because this is one of the most guarded place in the world.\n\nFeatures: \n- fight against zombies and cyborgs\n- cold war story\n- unique execution system\n- exciting fps combat\n- amazing graphics", "short_description": "Be part of an exciting cold war spy story.\n\nAs a CIA agent you have to infiltrate into a soviet underground facility and gather as much information as possible about their secret project.\nBut it won't be easy for you because this is one of the most guarded place in the world."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "https://tech-tro.com/privacy-policy", "developer_terms_of_service_url": "http://metro2.tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "http://metro2.tech-tro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "CASUAL", "HORROR", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended
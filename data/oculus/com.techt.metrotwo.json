G&_nc_oc=Ado-3tdyxtoGIx-8lwnX2QTZETZ5jywNyl7iQWkJtuaFhujQ4V6DSk6HN493QMv4c9w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7PnfZ3SgQSC9N1JOReBM3lRS-gc6--T1d9tSFLCuPa7w&oe=6A046473"}, {"file_name": "migrated_image.png", "id": "226214061910137", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162763_143678396273729_6482624053747122176_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kZ_UIspc1xIQ7kNvwEtf4Lh&_nc_oc=AdrDtSBBIFKaAoN9Qvrjw5oU0XF2jXzEyuWR2Wim9ud05Pj4baddaF8gq-z417nqAQ0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7fU81BpWEUrI-A543yvXWY0CKQ9H8cSMVg7BBNm4fANA&oe=6A0490EC"}, {"file_name": "migrated_image.png", "id": "212102596672796", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162707_138523736788646_2960305160795979776_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YW8TBoi_Sy4Q7kNvwH0uwTP&_nc_oc=AdrBZP8J9cc6_h23DayZxIOnW1qfRlecrkLJMcKPJpVS5_oIs5lyh_7dcD8NdJT0poo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Bl25iVAYJG5goqSE_QVRljCPacuWsAUvl92PXmbbGrg&oe=6A048D54"}, {"file_name": "migrated_image.png", "id": "208540827159608", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162702_124387201576475_5406613443337781248_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ft8u72-5p6oQ7kNvwGy4lil&_nc_oc=AdqyvDzCWWSwwnLtfwdoosRV2bCWEHaZpteK0OBoYECs3nmtdQRHl3trU_wzV2si11E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Kfh_jR1k1PToGTwhosZnRaDQ0rikvhgSmOc9qb6H0wg&oe=6A049B33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "2007762539505711", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162703_2007762542839044_612867755552538624_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UztGChCsG6cQ7kNvwGBjtGu&_nc_oc=Adqr-bFcaySS0KhnMejnonHs0Oy5mKXvyP9LYXEBz1gTrA-O4_YpABkvSrvAoIkrIXE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5t9NnVcAvLsEEaHHbqDS2zgjW55ffn9sIbbnD1OoFHeQ&oe=6A049B98"}, "display_name": "Metro-2: Project Kollie", "keywords": ["zombie", "coldwar", "spy", "undead", "execution"], "long_description": "Be part of an exciting cold war spy story.\n\nA secret Soviet project started in 1958. Its goal was to create the most effective super weapon. Doctors, scientists, engineers and soliders worked together to indite bio-robots for the Russian army. After many consecutive failures the Central Committee closed down the project in 1969 and all the information became classified. The KGB continued the research in an underground facility without the Comittee's knowledge and in 1982 the team had some primitive results. As a CIA agent you have to infiltrate into this facility and gather as much information as possible about the project.\nBut it won't be easy for you because this is one of the most guarded place in the world.\n\nFeatures: \n- fight against zombies and cyborgs\n- cold war story\n- unique execution system\n- exciting fps combat\n- amazing graphics", "short_description": "Be part of an exciting cold war spy story.\n\nAs a CIA agent you have to infiltrate into a soviet underground facility and gather as much information as possible about their secret project.\nBut it won't be easy for you because this is one of the most guarded place in the world."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "https://tech-tro.com/privacy-policy", "developer_terms_of_service_url": "http://metro2.tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "http://metro2.tech-tro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "CASUAL", "HORROR", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended
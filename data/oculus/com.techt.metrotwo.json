A&_nc_oc=AdqhimhBPOalsQrUorhA4BAYpmxsVAKYK-PahWXcbpHwYsreUIgsRR9onaIgQCEsQ-I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL68eJcrvDKW88TBeFlZBv8R1uMNz8odKY4ZXMX6wKqmA&oe=6A9844B3"}, {"file_name": "migrated_image.png", "id": "226214061910137", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162763_143678396273729_6482624053747122176_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e5g0dNzD1u4Q7kNvwHkl0Z4&_nc_oc=AdpMSQZ5mJN8lpmuLe3sR7MK8GTqsON_k_LYEAJfId-XbsEBFxZyIP-_CVrxSsA3zoM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9PQxoDrPzhf5cxKNmlmDcdASix9hWtm6pCEwCxo1nmA&oe=6A9838EC"}, {"file_name": "migrated_image.png", "id": "212102596672796", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162707_138523736788646_2960305160795979776_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JftFK8HU98IQ7kNvwHroKS_&_nc_oc=AdqPz_WpIw5ZMUP--JSRUuspMkaXvGF2vJrnlWLBxE3et1UUlQnt77SO4bzFHJohNSM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI74m1AU1nHR3XntkTCnOkpb0FW1hPWmhgWlZyRArJy-w&oe=6A983554"}, {"file_name": "migrated_image.png", "id": "208540827159608", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162702_124387201576475_5406613443337781248_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cQAJ8JpObYYQ7kNvwGDwNNC&_nc_oc=Ado0swfq24zPhI5TzQvoi3JrQT_SqWS76IMra17qUpzjM-rdcehIB1_HoHtRexY077s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHttXDi4EBrjnOckLpwaVmyno5hYCqO3B2UBpUBVeFtA&oe=6A984333"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "2007762539505711", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162703_2007762542839044_612867755552538624_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MAzRVywIHs8Q7kNvwGq1Daj&_nc_oc=Adq514yL1bARzx-a6_BVCkSAjI01GKN7swO5Wjwuodr7y4imBpHLrjBCO43VXeRbXsU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLaestq4EDXayirIhaqwB1AaSPqJe9Ql4fDRUvGEpQhA&oe=6A984398"}, "display_name": "Metro-2: Project Kollie", "keywords": ["zombie", "coldwar", "spy", "undead", "execution"], "long_description": "Be part of an exciting cold war spy story.\n\nA secret Soviet project started in 1958. Its goal was to create the most effective super weapon. Doctors, scientists, engineers and soliders worked together to indite bio-robots for the Russian army. After many consecutive failures the Central Committee closed down the project in 1969 and all the information became classified. The KGB continued the research in an underground facility without the Comittee's knowledge and in 1982 the team had some primitive results. As a CIA agent you have to infiltrate into this facility and gather as much information as possible about the project.\nBut it won't be easy for you because this is one of the most guarded place in the world.\n\nFeatures: \n- fight against zombies and cyborgs\n- cold war story\n- unique execution system\n- exciting fps combat\n- amazing graphics", "short_description": "Be part of an exciting cold war spy story.\n\nAs a CIA agent you have to infiltrate into a soviet underground facility and gather as much information as possible about their secret project.\nBut it won't be easy for you because this is one of the most guarded place in the world."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "https://tech-tro.com/privacy-policy", "developer_terms_of_service_url": "http://metro2.tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "http://metro2.tech-tro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "CASUAL", "HORROR", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended
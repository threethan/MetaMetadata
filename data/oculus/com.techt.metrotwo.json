J&_nc_oc=Adp9lbNOHr9onjn93FJBZ23jgjEzpa2joHqNbQ56LC-6kvOGWWlZGPOZZoNZxPJ-NoQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2FRZ1JZ7ljoCtycxtccLxR1r2en-to1y2q42kQ-lOhTw&oe=69F340F3"}, {"file_name": "migrated_image.png", "id": "226214061910137", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162763_143678396273729_6482624053747122176_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1U5z_1OuFrgQ7kNvwFUCWDK&_nc_oc=AdoySgARcyFE4K_LfKNecfa7BPLOHA_6aOIz_qHDdj585vZu6PwBAVWAl7SavnHc97Q&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0OIDtM-kS1Kq8MlO0w_Zp1GsLsVt7YbQoPngIpZtHadA&oe=69F36D6C"}, {"file_name": "migrated_image.png", "id": "212102596672796", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162707_138523736788646_2960305160795979776_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Zj1P2sVFyEQ7kNvwE3aoUn&_nc_oc=AdomqIdwehXKTx5tI5rffKLc8o2anauq0guGL_DeI15GmfWX8gI5TM9N7Am5YzBK1-Y&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1tGvvtT1NZtgCpBtJvJXkj2mkDZmGo85XP-p2UiYNNVQ&oe=69F369D4"}, {"file_name": "migrated_image.png", "id": "208540827159608", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162702_124387201576475_5406613443337781248_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5xijuOCL4MUQ7kNvwF9k8XU&_nc_oc=AdrQGwiNF21KEp9bj6kKN_9pc3Z_bpEbG4jjMUu2HIVUeG8jFDCP-EDmrdKzfnJlQmk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2GH3j5I6Bh8uBOxztu7hiJnGfuwQDmEVdJ3KjAuyjJNQ&oe=69F33F73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "2007762539505711", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162703_2007762542839044_612867755552538624_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RI5-ipdilTIQ7kNvwFpG9C1&_nc_oc=AdoS7e0bZ5dTy3Z5Q-_6oR3hTFb4hsNYxXobJmLU9CptLlTq5ZANql3RzK-lEndngus&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1gUC6nfAdHZ5vu2snAGxfk6Mg56qTuuUJniveMjE_Jeg&oe=69F33FD8"}, "display_name": "Metro-2: Project Kollie", "keywords": ["zombie", "coldwar", "spy", "undead", "execution"], "long_description": "Be part of an exciting cold war spy story.\n\nA secret Soviet project started in 1958. Its goal was to create the most effective super weapon. Doctors, scientists, engineers and soliders worked together to indite bio-robots for the Russian army. After many consecutive failures the Central Committee closed down the project in 1969 and all the information became classified. The KGB continued the research in an underground facility without the Comittee's knowledge and in 1982 the team had some primitive results. As a CIA agent you have to infiltrate into this facility and gather as much information as possible about the project.\nBut it won't be easy for you because this is one of the most guarded place in the world.\n\nFeatures: \n- fight against zombies and cyborgs\n- cold war story\n- unique execution system\n- exciting fps combat\n- amazing graphics", "short_description": "Be part of an exciting cold war spy story.\n\nAs a CIA agent you have to infiltrate into a soviet underground facility and gather as much information as possible about their secret project.\nBut it won't be easy for you because this is one of the most guarded place in the world."}]}, "developer_name": "Technical Troupers", "developer_privacy_policy_url": "https://tech-tro.com/privacy-policy", "developer_terms_of_service_url": "http://metro2.tech-tro.com/privacy-policy", "publisher_name": "Technical Troupers", "support_website_url": null, "website_url": "http://metro2.tech-tro.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "CASUAL", "HORROR", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended
n2-1.oculuscdn.com/v/t64.5771-25/39031445_1581974069062840_5221574835761467156_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VyUi5DKwUOsQ7kNvwE23g5H&_nc_oc=AdrWr70EYV5qUAZn4xZH2MDymwKA2otdkR9SHV_t7Pj5oxzHW3H5sCUhqdkjhathIlo&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-kbd-fQ1zfxyFJW3Lq_0zdj86Z9-_LT3Qol8G2dgpEDg&oe=6A392B52"}, {"file_name": "4.png", "id": "1196325794911717", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75334055_1196325798245050_53029869011175234_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w0aHsEqLU4IQ7kNvwH4e1kf&_nc_oc=AdqbfaScXjVrf9UMvUqz5G2C6_4peA6CdI6AA91mAgtgsMHMEJmVo-mijQ4Km9UkmeA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8o_6r7xk19Qc3c18nuyQUjprNpn6Xl47LQDXAg779LeA&oe=6A395AA5"}, {"file_name": "1.png", "id": "870693541233696", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974625_870693544567029_3948895896401260063_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hCWxwbfVamUQ7kNvwF8nxoA&_nc_oc=AdolQoHB8aQ6qnFfg5VZFmtB_Q2IyZog_M_y-WEMJ50_1nebcEhjw9AYUEf9H2nfKTw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-wUJfD6bxpjEh7HQnASfDVWPcv6NSvOGWw_DnatMoNEg&oe=6A395402"}, {"file_name": "2.png", "id": "1211563380169402", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974813_1211563383502735_4571933066383511449_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OcfWZ04K1R8Q7kNvwH8O8F_&_nc_oc=Adrit31Ck82sSEzbwbsh9SRyZEWKQQoJNfMvVROLc8fBoSyPTd4W7PWFclxOeyKhRsA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_rUVtQ9uz0b-bffCUMCmabsFp5SAkaJiaeOJc2tUpCwQ&oe=6A39425C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "3.png", "id": "1507909079834435", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39036645_1507909083167768_8472067086812261201_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EJtfv0qoAhoQ7kNvwFkbg6f&_nc_oc=AdqBRgqUP1ITTUZBDr1uIZxtpXdd7RS4A6VNgQR69J-cBWTKuqKBpK48EyUtq88S5p4&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_4LUDzY23gohbpoQN8zMi0ZgSEMJ9ClGYMVbqul5Z-Dw&oe=6A393F02"}, "display_name": "Parking Puzzle", "keywords": ["casual", "simple", "puzzle", "Strategy", "Fun"], "long_description": "Parking Puzzle is a captivating puzzle game designed to challenge your strategic thinking and problem-solving abilities. In this game, players must maneuver through intricate parking lots, filled with tight spaces and obstacles, to park cars in their designated spots without crashing into barriers or other vehicles. As the game progresses, each level becomes increasingly complex, introducing new obstacles like tightly packed cars, narrow lanes, and even moving objects, requiring precise planning and careful execution.\n\nThe game encourages you to develop thoughtful strategies to navigate the parking lot efficiently. Each move must be carefully calculated to avoid collisions and ensure all cars are parked in their correct spots. As the difficulty ramps up, so does the excitement, making Parking Puzzle a perfect blend of logic, skill, and patience.\n\nWith intuitive controls and simple mechanics, Parking Puzzle is accessible to a wide range of players. However, the increasing complexity ensures that even seasoned puzzle fans will find the game challenging. Offering various difficulty levels and a vast selection of puzzles, Parking Puzzle promises hours of entertainment and replayability. Whether you\u2019re a casual player looking to pass the time or a puzzle enthusiast seeking a challenge, Parking Puzzle delivers a rewarding and addictive experience that will keep you coming back for more.", "short_description": "Parking Puzzle is a fun puzzle game that tests your strategic thinking and problem-solving skills. Players must navigate complex parking lots and park cars without hitting obstacles or other vehicles. As the levels progress, new challenges arise, requiring careful planning and precision. With simple controls and varying difficulty levels, the game is accessible to a wide range of players. Parking Puzzle offers a fun, engaging, and addictive gameplay experience for all puzzle enthusiasts."}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1_l_GxTpD64zBNaY3TAnGXtCB1cmJE-E7/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.bilgiplatformu.net/post/parking-puzzle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8402637876468957"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PUBLISHED", "id": "2724259367938058"}, {"status": "PUBLISHED", "id": "678863105220864"}, {"status": "PUBLISHED", "id": "1920045721910686"}, {"status": "PUBLISHED", "id": "1875425819662496"}, {"status": "PUBLISHED", "id": "1042234481085489"}, {"status": "PUBLISHED", "id": "1675368256457818"}, {"status": "PUBLISHED", "id": "612124991468010"}, {"status": "PUBLISHED", "id": "1085445249871096"}, {"status": "PUBLISHED", "id": "2635943119919753"}]}, "baseline_offer": {"id": "1675368256457818"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1779303600, "status": "PUBLISHED", "id": "2724259367938058"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": [
n.com&_nc_ss=7f20f&oh=00_AQREWZ39ZJwbo6Sgg4m9gdUN-vr74d_FhSDtqMoWu-4EAQ&oe=6B032C72"}, "display_name": "Virtual EXPO 2025 JAPAN", "keywords": ["XR", "VR", "Metaverse", "EXPO", "MYAKUMYAKU"], "long_description": "Make your avatar\nCustomize your own personal avatar! Choose your favorite clothing and explore a virtual world in your own individual style. Get limited-edition items and avatar clothing by exploring the Virtual Expo site and joining events!\n\nInteract with people from all over the world\nIn a virtual world, you can interact in real time with people from all over the world! There are an amazing number of features to make communication fun, including voice chat, text chat with translation, stamps, and emotes. Transcend language barriers, and meet new friends and cultures!\n\nEnjoy the changes of Yumeshima Islands in the Sky\nThe nature and ecosystem of the virtual world will evolve gradually during the Expo! Discover the amazingness of the changing Yumeshima Islands in the Sky while observing their wide diversity, and seeing the new organisms appear. Also, there will be a special event where MYAKU-MYAKU and friends dance to music along with people from all over the world. Do not miss out on an experience only available now!\n\nJoin events\nThe virtual site will feature different events each day. Experience events held by different countries and enjoy the special sense of immersion that Virtual Expo provides! \n\nExpo 2025 Osaka, Kansai, Japan official X account\nhttps: //x.com/expo2025_japan\n\nThe official website for the virtual Expo: Virtual Site\nhttps: //www.expo2025.or.jp/future-index/virtual/virtual-site/", "short_description": "--- Expo 2025 Osaka, Kansai, Japan Virtual Expo App \nExperience a metaverse that recreates the Expo 2025 Osaka, Kansai, Japan site together with people from all over the world!\n\nExplore the pavilions\nExperience pavilions from over 160 countries, regions and international organizations virtually! There is a wealth of content only viewable here. Explore this virtual site on an app that lets you access the location at any time, from any place, and complete the pavilion field guide!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://contents.ssv.virtualexpo.expo2025.or.jp/app/privacy_policy.html", "developer_terms_of_service_url": "https://contents.ssv.virtualexpo.expo2025.or.jp/app/terms_of_use.html", "publisher_name": "NTT QONOQ", "support_website_url": null, "website_url": "https://www.nttqonoq.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2687655338230691"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "9075698052538499"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392124_640537225158380_7425740447885357775_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GXZAhvHd4ksQ7kNvwHnRsC_&_nc_oc=AdqhRu-9yvfaIIQBEDaZKISdKUI94jOwNQFofSDNTzPRUmYbNnJyUu--JD6SNX_xE74&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSreMoWpToAKqXdc-w-hExuix8GcrrtUgynr4oNc86x8g&oe=6B030615"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Virtual EXPO 2025 JAPAN", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Events", "id": "2687655338230691"}], "release_date":
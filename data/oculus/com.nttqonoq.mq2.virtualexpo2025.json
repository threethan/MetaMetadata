DAJPpq5Yi5YPsEeSfuo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwTl3LvCUDvUmNbKPXl_OrwsnlRay0jjngKQu-qd-N55Q&oe=69CA70CD"}, {"file_name": "08_JP.png", "id": "2643281805869376", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392113_2643281809202709_7300956640992534797_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YaCVczfSvU8Q7kNvwHHZ7Y-&_nc_oc=AdpSYQHenbqVXD8kQCw1TFvsl3-AcG6mQaWRafeSCYLrieEcTEZexx5SkJ9C-TNH0Vo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxBIdK7cFXlip1ulCpl_ARz--Lz0v12T3WQdzogor_0Gw&oe=69CA7C05"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30d0\u30fc\u753b\u50cf.png", "id": "1374281197041622", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393818_1374281203708288_6023862955341369061_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fNI557u-jdIQ7kNvwF5zNYr&_nc_oc=Ado4GiaxmN83_oMhg9okOylp5nt1WmFzgKlUegQEGpJ5cMprYwHJNaTs65uBrN3E_Uc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy2LlQ8i8REihE9qt0o7kvqdvnjwmqGWvNX64c6DqOZaQ&oe=69CA80B2"}, "display_name": "Virtual EXPO 2025 JAPAN", "keywords": ["XR", "VR", "Metaverse", "EXPO", "MYAKUMYAKU"], "long_description": "Make your avatar\nCustomize your own personal avatar! Choose your favorite clothing and explore a virtual world in your own individual style. Get limited-edition items and avatar clothing by exploring the Virtual Expo site and joining events!\n\nInteract with people from all over the world\nIn a virtual world, you can interact in real time with people from all over the world! There are an amazing number of features to make communication fun, including voice chat, text chat with translation, stamps, and emotes. Transcend language barriers, and meet new friends and cultures!\n\nEnjoy the changes of Yumeshima Islands in the Sky\nThe nature and ecosystem of the virtual world will evolve gradually during the Expo! Discover the amazingness of the changing Yumeshima Islands in the Sky while observing their wide diversity, and seeing the new organisms appear. Also, there will be a special event where MYAKU-MYAKU and friends dance to music along with people from all over the world. Do not miss out on an experience only available now!\n\nJoin events\nThe virtual site will feature different events each day. Experience events held by different countries and enjoy the special sense of immersion that Virtual Expo provides! \n\nExpo 2025 Osaka, Kansai, Japan official X account\nhttps: //x.com/expo2025_japan\n\nThe official website for the virtual Expo: Virtual Site\nhttps: //www.expo2025.or.jp/future-index/virtual/virtual-site/", "short_description": "--- Expo 2025 Osaka, Kansai, Japan Virtual Expo App \nExperience a metaverse that recreates the Expo 2025 Osaka, Kansai, Japan site together with people from all over the world!\n\nExplore the pavilions\nExperience pavilions from over 160 countries, regions and international organizations virtually! There is a wealth of content only viewable here. Explore this virtual site on an app that lets you access the location at any time, from any place, and complete the pavilion field guide!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://contents.ssv.virtualexpo.expo2025.or.jp/app/privacy_policy.html", "developer_terms_of_service_url": "https://contents.ssv.virtualexpo.expo2025.or.jp/app/terms_of_use.html", "publisher_name": "NTT QONOQ", "support_website_url": null, "website_url": "https://www.nttqonoq.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2687655338230691"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], 
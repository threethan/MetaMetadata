0438\u0442\u044c\u0441\u044f \u043e\u0442 \u0434\u043e\u0432\u043e\u043b\u044c\u043d\u043e\u0439 \u043f\u0443\u0431\u043b\u0438\u043a\u0438, \u0430 \u0434\u043b\u044f \u044d\u0442\u043e\u0433\u043e \u043d\u0443\u0436\u043d\u043e \u0443\u0433\u0430\u0434\u044b\u0432\u0430\u0442\u044c \u0435\u0435 \u0436\u0435\u043b\u0430\u043d\u0438\u044f. \u0427\u0435\u043c \u0431\u043e\u043b\u044c\u0448\u0435 \u0441\u0447\u0430\u0441\u0442\u043b\u0438\u0432\u044b\u0445 \u043b\u0438\u0446 \u0432 \u043a\u043b\u0443\u0431\u0435 \u2014 \u0442\u0435\u043c \u0431\u043e\u043b\u044c\u0448\u0435 \u043d\u043e\u0432\u043e\u0439 \u043c\u0443\u0437\u044b\u043a\u0438 \u0438 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u0435\u0439 \u0434\u043b\u044f \u0435\u0433\u043e \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044f \u0432\u044b \u043e\u0442\u043a\u0440\u043e\u0435\u0442\u0435!\n\n\u041a\u043b\u044e\u0447\u0435\u0432\u044b\u0435 \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e\u0441\u0442\u0438: \n- \u0423\u0441\u0442\u0440\u043e\u0439\u0442\u0435 \u044d\u043f\u0438\u0447\u043d\u044b\u0439 \u0440\u044d\u0439\u0432 \u0432 \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u043c VR-\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0435 \u043a\u043b\u0443\u0431\u0430\n- \u0421\u043b\u0435\u0434\u0438\u0442\u0435 \u0437\u0430 \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u0435\u043c \u0433\u043e\u0441\u0442\u0435\u0439 \u0438 \u0438\u0441\u043f\u043e\u043b\u043d\u044f\u0439\u0442\u0435 \u0438\u0445 \u0436\u0435\u043b\u0430\u043d\u0438\u044f\n- \u041f\u0443\u0431\u043b\u0438\u043a\u0430 \u0434\u0430\u0440\u0438\u0442 \u043b\u0430\u0439\u043a\u0438 \u0437\u0430 \u0430\u0442\u043c\u043e\u0441\u0444\u0435\u0440\u0443, \u0430 \u0432\u044b \u2013 \u0442\u0440\u0430\u0442\u0438\u0442\u0435 \u0438\u0445 \u043d\u0430 \u0437\u0432\u0443\u043a, \u0441\u0432\u0435\u0442 \u0438 \u0434\u0435\u043a\u043e\u0440\n- \u0420\u0430\u0437\u0432\u0438\u0432\u0430\u0439\u0442\u0435 \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u043e \u043a\u043b\u0443\u0431\u0430 \u043f\u0440\u044f\u043c\u043e \u0432 \u0440\u0430\u0437\u0433\u0430\u0440 \u0432\u044b\u0441\u0442\u0443\u043f\u043b\u0435\u043d\u0438\u044f \u0445\u0435\u0434\u043b\u0430\u0439\u043d\u0435\u0440\u043e\u0432\n- \u041e\u0442\u043a\u0440\u044b\u0432\u0430\u0439\u0442\u0435 \u043d\u043e\u0432\u044b\u0439 \u0442\u0440\u0435\u043a \u0438\u0437 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0435\u0433\u043e \u0430\u043b\u044c\u0431\u043e\u043c\u0430 \u043f\u043e\u043f\u0443\u043b\u044f\u0440\u043d\u043e\u0439 \u043c\u0443\u0437\u044b\u043a\u0430\u043b\u044c\u043d\u043e\u0439 \u0433\u0440\u0443\u043f\u043f\u044b \u00abCREAM SODA\u00bb \u0441 \u043a\u0430\u0436\u0434\u044b\u043c \u043d\u043e\u0432\u044b\u043c \u0443\u0440\u043e\u0432\u043d\u0435\u043c \u0438\u0433\u0440\u044b\n", "short_description": "\u0414\u043e\u0431\u0440\u043e \u043f\u043e\u0436\u0430\u043b\u043e\u0432\u0430\u0442\u044c \u0432 \u043c\u0438\u0440 \u0444\u0430\u043d\u0442\u0430\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0432\u0435\u0447\u0435\u0440\u0438\u043d\u043e\u043a \u0433\u0440\u0443\u043f\u043f\u044b CREAM SODA! \u0412 \u044d\u0442\u043e\u0439 \u0432\u0441\u0435\u043b\u0435\u043d\u043d\u043e\u0439, \u0441\u043e\u0431\u0440\u0430\u043d\u043d\u043e\u0439 \u0438\u0437 \u0438\u0434\u0435\u0439 \u0433\u0440\u0443\u043f\u043f\u044b, \u0432\u044b - \u043f\u0440\u043e\u043c\u043e\u0443\u0442\u0435\u0440 \u043a\u043b\u0443\u0431\u0430, \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u043c \u0438\u0434\u0435\u0442 \u043f\u0440\u0435\u043c\u044c\u0435\u0440\u0430 \u043d\u043e\u0432\u043e\u0433\u043e \u0430\u043b\u044c\u0431\u043e\u043c\u0430. \u0423\u0441\u043f\u0435\u0445 \u0432\u0435\u0447\u0435\u0440\u0438\u043d\u043a\u0438 \u0432 \u0432\u0430\u0448\u0438\u0445 \u0440\u0443\u043a\u0430\u0445 \u2014 \u0443\u0441\u0442\u0440\u043e\u0439\u0442\u0435 \u043f\u043e\u043b\u043d\u044b\u0439 \u0441\u043e\u043b\
"Space Chimps", "keywords": [], "long_description": "Space Apes is an exhilarating VR fan game inspired by Gorilla Tag, launching players into the depths of space for fast-paced, movement-based gameplay! As a futuristic ape, you'll sprint, climb, and swing through massive sci-fi environments, from high-tech space stations to mysterious alien landscapes. But you're not alone\u2014strange, lurking monsters prowl the shadows, adding an extra layer of danger to every match. Whether you're escaping from other players in intense multiplayer tag or surviving against terrifying creatures, Space Apes delivers a heart-pounding experience like no other. Customize your ape, explore uncharted worlds, and prove you have what it takes to survive in the ultimate space chase!", "short_description": "Space Apes is an exhilarating VR fan game inspired by Gorilla Tag, launching players into the depths of space for fast-paced, movement-based gameplay! As a futuristic ape, you'll sprint, climb, and swing through massive sci-fi environments, from high-tech space stations to mysterious alien landscapes. But you're not alone\u2014strange, lurking monsters prowl the shadows, adding an extra layer of danger to every lobby."}]}, "developer_name": "Space Chimp Studios", "developer_privacy_policy_url": "https://sites.google.com/view/hspacechimpsprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Gregory", "support_website_url": null, "website_url": "https://sites.google.com/view/spacechimpsstudioswebsite", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "1700921480735423"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": nul
uH-qY1Ak4JM9qPSA&oe=69FDD3DD"}, {"file_name": "resized_image_4 (1).png", "id": "1902504603892817", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391934_1902504607226150_1140289947409443593_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xUExHzOAOcIQ7kNvwGWl--t&_nc_oc=AdrO8hgZrRoZcnjsq5TVSWBOcauGFTZqYHYEQLBad9B1FPdfujPucOScWSY8ycUosFg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-4zQPFidGEZk8Zmf8c-a1EpU0Lhq2UXwWNQu0icjBVw&oe=69FDED3A"}, {"file_name": "resized_image_3 (1).png", "id": "622897393986724", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391934_622897400653390_3885650164589517839_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R-uwt1yb-EcQ7kNvwGq3441&_nc_oc=AdpR8qBVGWcUO3m9Z6epl3PwKWiuoJLKq-q4Jbt26KfvyJccy31nVPT6GVuA6sH0xCQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qvaRZRSCmbhspZvEPCNB7hzJ0_eELED-4dR_8EkaxJQ&oe=69FDFCFD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Space Chimps", "keywords": [], "long_description": "Space Apes is an exhilarating VR fan game inspired by Gorilla Tag, launching players into the depths of space for fast-paced, movement-based gameplay! As a futuristic ape, you'll sprint, climb, and swing through massive sci-fi environments, from high-tech space stations to mysterious alien landscapes. But you're not alone\u2014strange, lurking monsters prowl the shadows, adding an extra layer of danger to every match. Whether you're escaping from other players in intense multiplayer tag or surviving against terrifying creatures, Space Apes delivers a heart-pounding experience like no other. Customize your ape, explore uncharted worlds, and prove you have what it takes to survive in the ultimate space chase!", "short_description": "Space Apes is an exhilarating VR fan game inspired by Gorilla Tag, launching players into the depths of space for fast-paced, movement-based gameplay! As a futuristic ape, you'll sprint, climb, and swing t
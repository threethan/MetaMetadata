://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499308026_1913492370026085_6206571124893795221_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V2yRMuIIK_wQ7kNvwGoAMlD&_nc_oc=AdrLCJJv5n9sWIdEbJs-l5amUUjWUBtR5BZQrUz7D7hJP0A6r6uV6yw-EZeQqMBYw3Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQbUCofhm5fEGmkcyGubaDF_SXd75Va2RF-wisiiWYfxg&oe=6B0DB99B"}, {"file_name": "03_forest_2560x1440.png", "id": "3723187594502361", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499292232_3723187597835694_254519445993154816_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=etpehQU4a3MQ7kNvwGy_d63&_nc_oc=Adryjk9xPlUpuQUb4b_9dPJgkh-VD1THsmNzonVUqZj_ouN-oOegirc41hPR0ScDjYU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSPrfNW_xXMvTXUviNWZqu9EUeVOgU0q9bVuyGp-wdSSA&oe=6B0DBCBD"}, {"file_name": "08_garage_2560x1440.png", "id": "995925212972059", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/789212960_995925219638725_4509610052407293567_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XtX2XDM7wBEQ7kNvwE2BVG0&_nc_oc=AdqzDLVI5ZW6HV5E8FTSFHNtbo37WxkaWaXQWdmdBDw8GDrPgOoCC_6jGCxyLg6_LN8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRveagOpZAUXItdE2MyFvgdKdEofT7TN5Rh8K0kyr-JEA&oe=6B0DB853"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "2176002749664884", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499298219_2176002752998217_8419066963633766170_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NHVv6Q66jQgQ7kNvwGPw8sW&_nc_oc=Adrfp1ImBXETqOkWRUuUgHChXPWov63gRZ8GR0MfRIxpc75bK0W5s9Wuk2ZSnw3KXpU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQmT89mH_It9lKqVn3WpI4DQsPKdoLdx1k2A8FAktweDQ&oe=6B0DCBA8"}, "display_name": "Quad Squad", "keywords": [], "long_description": "Free to play: the Desert Canyon's seven tracks are free. Unlock all 28 tracks and the whole garage with one purchase.\n\nQuad Squad is a stunt racer on your table. Each track is a toy diorama in front of you, and the table follows your quad as you race. Drive it like a radio-controlled car: the right trigger is the gas, the left stick steers.\n\nJump barrels, logs and rocks, duck under beams and girders, and hold a trick off every ramp: the longer you hold it the bigger the score, but let go before you land. Grab nitro cans for a burst of speed, kick the rider beside you, and finish on the podium for three stars.\n\nFour worlds, 28 tracks:\n- Desert Canyon: ramps, red rock and gaps to jump.\n- Forest Trail: mud, fallen trees, creeks and a shortcut over a log bridge.\n- City Streets: boost pads, oil slicks and jumps between the piers.\n- Snow Pass: ice, snowdrifts and ski jumps.\n\nThree rivals race you on every track. Race a ghost of your best run, the world's #1, a friend or the racer just above you on the leaderboard. Pick your rider and your quad in the garage.\n\nGrab the table to move, turn, tilt or resize it; the race waits while you hold it. Your view never moves on its own. Play standing or seated, steer with the stick or by tilting the controller like a wheel.\n\nNo ads. No internet needed to race; leaderboards and online ghosts use your Meta account when you're online.", "short_description": "Free to play: unlock all 28 tracks with one purchase. Race chibi riders on off-road quads across a toy world on a table in front of you. Drive like a radio-controlled car: jump the barrels, duck the beams, fly off ramps into tricks, kick your rivals, light the nitro and race the ghosts of the world's fastest."}]}, "developer_name": "Guidry Games", "developer_privacy_policy_url": "https://guidrygames.com/privacy.html", "developer_terms_of_service_url": "https://guidrygames.com/terms.html", "publisher_name": "Guidry Games", "support_website_url": "https://guidrygames.com/support.html", "website_url": "https://guidrygames.com/games.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29705683915704744"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/654904853_2902710570127986_1272116231647937854_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oKQjJafWXfMQ7kNvwGh-62V&_nc_oc=Adp8IRGGe2-GyZJ9mkknv9EigyOiAIUOESH7--y-wMeJBfh4Pye7UTYTT4509MMY2f4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR0iWKe7hn_4UKvDDwmlskHj5shuqWyDHRsjtg7OXfzXw&oe=6B0DB2EC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Quad Squad", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Racing", "id": "673385183287495"}, {"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1795623120, "lastRevision": {"nodes": [{"id": "29705683965704739", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "29705683879038081", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "pla
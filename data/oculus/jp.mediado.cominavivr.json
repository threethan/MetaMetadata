nd proceed to purchase only if you agree with the above.\n\n--------------------------\nThe World's First Manga Platform for Enjoying Japanese Manga Comics in VR\n\nFeatures.\nThe position and size of the manga can be changed freely.\nYou can switch between various backgrounds in the reading space.\nYou can add new manga in the VR space.\nYou can add new comics in the VR space - Can be used offline (need to download comics in advance)\n\nCominavi account is required. For details, please check (https://mechacomi.jp/).", "short_description": "The provision of this app will cease on or around 22 December 2024.\nYou can continue to enjoy the DLed apps as long as the programmes that make up the apps run.\nHowever, re-downloads, version upgrades and support services will cease with the end of the provision of this application.\n--------------------------\n\n\u65e5\u672c\u306e\u30de\u30f3\u30ac\u30b3\u30df\u30c3\u30af\u3092VR\u3067\u697d\u3057\u3081\u308b\u4e16\u754c\u521d\u306e\u30de\u30f3\u30ac\u30fb\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\nThe World's First Manga Platform for Enjoying Japanese Manga Comics in VR"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mediado.jp/privacy/", "developer_terms_of_service_url": null, "publisher_name": "MEDIA DO Co., Ltd.", "support_website_url": null, "website_url": "https://mediado.jp/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "REQUIRED", "genres": ["ART_CREATIVITY", "EXPERIENCE_360_NON_GAME", "MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supp
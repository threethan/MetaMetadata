mechacomi.jp/).", "short_description": "The provision of this app will cease on or around 22 December 2024.\nYou can continue to enjoy the DLed apps as long as the programmes that make up the apps run.\nHowever, re-downloads, version upgrades and support services will cease with the end of the provision of this application.\n--------------------------\n\n\u65e5\u672c\u306e\u30de\u30f3\u30ac\u30b3\u30df\u30c3\u30af\u3092VR\u3067\u697d\u3057\u3081\u308b\u4e16\u754c\u521d\u306e\u30de\u30f3\u30ac\u30fb\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\nThe World's First Manga Platform for Enjoying Japanese Manga Comics in VR"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mediado.jp/privacy/", "developer_terms_of_service_url": null, "publisher_name": "MEDIA DO Co., Ltd.", "support_website_url": null, "website_url": "https://mediado.jp/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "REQUIRED", "genres": ["ART_CREATIVITY", "EXPERIENCE_360_NON_GAME", "MEDIA_PLAYER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8437220239736799"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982714_4326004294142188_6026504170693282834_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fiX39rF7j_kQ7kNvwGy8wp0&_nc_oc=AdnMv1XJkihyZ0TdENBhyfOg4QPVLy5zkqW33DIy1-50rKTPLh3LewbpkxjhEpjJ7VM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuSi0kY1xQ1TQ_R82Pi-3oCU9kz_6v5uC
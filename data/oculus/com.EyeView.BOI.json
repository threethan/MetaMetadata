0a&_nc_ohc=3xE5CCnb9x4Q7kNvwEq5NB3&_nc_oc=Adr7w3pZIsizCGBoFtHzFFqYalv70qK8S_meB3jEXLxg-_wZOplnRwSKtkchaFLxt9Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVgCWfrs8tHxPKTsiRLWFLEmktFe1GYjfVkisOTNLbN0w&oe=6B106A6D"}, {"file_name": "pt5.png", "id": "1645182046596625", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499299789_1645182049929958_4947210763828511572_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IjXIUA-lAfgQ7kNvwHLUjU4&_nc_oc=AdooSvE9mlNcGUBIIkDqwDRm5l3NQ9DmCOGT-Yah85DvG9yUUkF2orU4ZHBToirqfuY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVybWlvREjX-jj3OYL417rMzMWDxWGwOHvtLwIG6y4gmw&oe=6B106713"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BOI", "keywords": [], "long_description": "BOI is an early VR prototype built to test locomotion and basic movement inside a simple facility-style environment.\n\nThe current build uses placeholder geometry and a basic test map to evaluate player movement and interaction using a Gorilla Locomotion-based system.\n\nThis version is not a full game and does not include final gameplay systems, objectives, or polished environments. It is intended for testing core VR movement and framework functionality.\n\nFeatures:\n\u2022 VR locomotion testing\n\u2022 Simple facility-style test map\n\u2022 Placeholder geometry and assets\n\u2022 Basic interaction and movement systems\n\u2022 Early prototype build\n\nThis project is currently in development and will evolve over time as systems and content are expanded.", "short_description": "BOI is a VR locomotion prototype set in a simple facility test environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1zyt0mEAGF4ngWs6pTfnUpUr4_0hD4zpvU112YPStt_g/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "EyeView Studios", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1z
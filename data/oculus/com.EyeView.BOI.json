0_AQKgDIG48tnuc3f923cZdoJh9Coi-XLDfCmjMdegM9WaZw&oe=6ABA72F8"}, {"file_name": "pt4.png", "id": "936920689384392", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499314659_936920692717725_1204283558882830953_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZZkz7IKkMm0Q7kNvwHOwuKk&_nc_oc=AdqEqXJ1wUK_7dHTLvqHSqOIffydEl85676p4JM-rQjysCh5hUEdhqxqv8bUnGmLpKY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLl9omBEDo0zggyOOpCDJxxfhhnKXxILAB03_t9e1h0pw&oe=6ABA80AD"}, {"file_name": "pt5.png", "id": "1645182046596625", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499299789_1645182049929958_4947210763828511572_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d7yWFHA9TB4Q7kNvwFG_H8p&_nc_oc=AdqnJZ9roRfyDA8qJhkAwIIO2QCG9L9Vj-SFGP4EN_d8w2-3tu5AclH__7RjcmpjLUU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-Uk3Zs5cQUiemGexjvft3Ya8mxp58JV3xKhGIu3Sutg&oe=6ABA7D53"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BOI", "keywords": [], "long_description": "BOI is an early VR prototype built to test locomotion and basic movement inside a simple facility-style environment.\n\nThe current build uses placeholder geometry and a basic test map to evaluate player movement and interaction using a Gorilla Locomotion-based system.\n\nThis version is not a full game and does not include final gameplay systems, objectives, or polished environments. It is intended for testing core VR movement and framework functionality.\n\nFeatures:\n\u2022 VR locomotion testing\n\u2022 Simple facility-style test map\n\u2022 Placeholder geometry and assets\n\u2022 Basic interaction and movement systems\n\u2022 Early prototype build\n\nThis project is currently in development and will evolve over time as systems and content are expanded.", "short_description": "BOI is a VR locomotion prototype set in a simple facility test environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/do
=1-7&_nc_sid=6e7a0a&_nc_ohc=dDS73LyxMyQQ7kNvwEHf6ua&_nc_oc=AdrnMhFpz-b1FZ4z-EQUi9z7rTnBvP-11nzm-3JpryeKBH7b2dl_Dqr8VsM40FUZNV8&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8VFYKhcuDmY1d7C5JSYLJYGq3-8WPvHlQ6L1o5EJSKZQ&oe=6A467953"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BOI", "keywords": [], "long_description": "BOI is an early VR prototype built to test locomotion and basic movement inside a simple facility-style environment.\n\nThe current build uses placeholder geometry and a basic test map to evaluate player movement and interaction using a Gorilla Locomotion-based system.\n\nThis version is not a full game and does not include final gameplay systems, objectives, or polished environments. It is intended for testing core VR movement and framework functionality.\n\nFeatures:\n\u2022 VR locomotion testing\n\u2022 Simple facility-style test map\n\u2022 Placeholder geometry and assets\n\u2022 Basic interaction and movement systems\n\u2022 Early prototype build\n\nThis project is currently in development and will evolve over time as systems and content are expanded.", "short_description": "BOI is a VR locomotion prototype set in a simple facility test environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1zyt0mEAGF4ngWs6pTfnUpUr4_0hD4zpvU112YPStt_g/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "EyeView Studios", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1zyt0mEAGF4ngWs6pTfnUpUr4_0hD4zpvU112YPStt_g/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "reco
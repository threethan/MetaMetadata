0_AQMQCfxNDybKC8cJeyFgSikbk57BWn3bIFp97oT7tDhEYw&oe=6AC65078"}, {"file_name": "pt4.png", "id": "936920689384392", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499314659_936920692717725_1204283558882830953_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BamSyzo2SXsQ7kNvwEspPfG&_nc_oc=Adp9lXTWAr9uK-eI7B1f4_HxMYOhgiK5XWYEdUuZkyz3Bm7pFu0nO0U_bFtFEcf7k-Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3B4SC3CDrsyEUHl2Gof2fE45kNQ7eWp5OEDsS3i-izQ&oe=6AC65E2D"}, {"file_name": "pt5.png", "id": "1645182046596625", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499299789_1645182049929958_4947210763828511572_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lHP252S_7k8Q7kNvwEf19kp&_nc_oc=Adr-yhBme6J4DlkgcPBJBi-GvE-qMKchSKgEKQ9M9RCa_IFLrYjnfn6UTWxn3nFe9WU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP4ou_O76mMxHCxDQVzjB16n4GvmloeqnKiNM8dWjPJBA&oe=6AC65AD3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BOI", "keywords": [], "long_description": "BOI is an early VR prototype built to test locomotion and basic movement inside a simple facility-style environment.\n\nThe current build uses placeholder geometry and a basic test map to evaluate player movement and interaction using a Gorilla Locomotion-based system.\n\nThis version is not a full game and does not include final gameplay systems, objectives, or polished environments. It is intended for testing core VR movement and framework functionality.\n\nFeatures:\n\u2022 VR locomotion testing\n\u2022 Simple facility-style test map\n\u2022 Placeholder geometry and assets\n\u2022 Basic interaction and movement systems\n\u2022 Early prototype build\n\nThis project is currently in development and will evolve over time as systems and content are expanded.", "short_description": "BOI is a VR locomotion prototype set in a simple facility test environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/do
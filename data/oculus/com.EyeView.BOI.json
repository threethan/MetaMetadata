ps://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499314659_936920692717725_1204283558882830953_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m6YIUpneGIYQ7kNvwFLtEXd&_nc_oc=AdoG1wdpi0Z10jSRMgQ1iDNX4BSk52KrVEgMKpBAdSEdt1UiBiQF4ipiYLMet1x8TN0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBNGS8hBruAdtOU1d3fre7Aiav2QaukzuAfZv1KywMWnw&oe=6A5F892D"}, {"file_name": "pt5.png", "id": "1645182046596625", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499299789_1645182049929958_4947210763828511572_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cyVE4a4e_vcQ7kNvwFQivwS&_nc_oc=AdptfYS5sj0xNG2q8um7kGfeQHm7aj3SLEHM-C0sS2YHz-Z8FMsZstD58jZNYa8_Iws&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBxko96YZ0jJF5az54oR6qN-DHDAkrRm-2zXGNRgxBMiw&oe=6A5F85D3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BOI", "keywords": [], "long_description": "BOI is an early VR prototype built to test locomotion and basic movement inside a simple facility-style environment.\n\nThe current build uses placeholder geometry and a basic test map to evaluate player movement and interaction using a Gorilla Locomotion-based system.\n\nThis version is not a full game and does not include final gameplay systems, objectives, or polished environments. It is intended for testing core VR movement and framework functionality.\n\nFeatures:\n\u2022 VR locomotion testing\n\u2022 Simple facility-style test map\n\u2022 Placeholder geometry and assets\n\u2022 Basic interaction and movement systems\n\u2022 Early prototype build\n\nThis project is currently in development and will evolve over time as systems and content are expanded.", "short_description": "BOI is a VR locomotion prototype set in a simple facility test environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1zyt0mEAGF4ngWs6pTfnUpUr4_0hD4zpvU112YPStt_g/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_n
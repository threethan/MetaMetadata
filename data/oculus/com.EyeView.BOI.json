ps://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499314659_936920692717725_1204283558882830953_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0wwDQ9NM_G0Q7kNvwEIPs2T&_nc_oc=Adoa9sfC1H2x76gWnV_2bjZfyKH2hyD-5rk4ldRzIqFU3xIGdMwa_eWBr6YVGOuAD1Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6zkSVPSegkfKwiHKND1wJqqtJIhxxuwTYGKUDoLZ7qw&oe=6A6CB82D"}, {"file_name": "pt5.png", "id": "1645182046596625", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499299789_1645182049929958_4947210763828511572_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VeVKUEyRGbMQ7kNvwEyDkV7&_nc_oc=AdqOINL37crLPN2ufahz9pe8417mlIfbKqhf1HXhSBmg6Wv-F3IracU0LBZ3Xo2_2RA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCSP1yqNrQMebzDg8InXfP_Re9_dsFIeCNvJeoWm7T9_A&oe=6A6CB4D3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BOI", "keywords": [], "long_description": "BOI is an early VR prototype built to test locomotion and basic movement inside a simple facility-style environment.\n\nThe current build uses placeholder geometry and a basic test map to evaluate player movement and interaction using a Gorilla Locomotion-based system.\n\nThis version is not a full game and does not include final gameplay systems, objectives, or polished environments. It is intended for testing core VR movement and framework functionality.\n\nFeatures:\n\u2022 VR locomotion testing\n\u2022 Simple facility-style test map\n\u2022 Placeholder geometry and assets\n\u2022 Basic interaction and movement systems\n\u2022 Early prototype build\n\nThis project is currently in development and will evolve over time as systems and content are expanded.", "short_description": "BOI is a VR locomotion prototype set in a simple facility test environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1zyt0mEAGF4ngWs6pTfnUpUr4_0hD4zpvU112YPStt_g/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_n
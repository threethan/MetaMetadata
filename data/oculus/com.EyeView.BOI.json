ps://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499314659_936920692717725_1204283558882830953_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o4ZIwWgL7RgQ7kNvwFxAKR7&_nc_oc=Adp659DgSlIJ5mgGZ9F1ZyCxPopEqoDHxcjNxg3FoqrzTJsouOFTNHTCLnpQ9bXuQTQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGpKa2pE5nN6dYQvHpGWas3bmbo5S_NzlCbGjNe6Xy9xw&oe=6A7EF4ED"}, {"file_name": "pt5.png", "id": "1645182046596625", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499299789_1645182049929958_4947210763828511572_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k2YBuzG5gBUQ7kNvwF3QCuK&_nc_oc=AdoqrjsgBoWZHmzv1N_jlCn_-4tLsEsN5u5QBQOI4LKTL-kv0lUTYr8LRjLzuynMq6E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHvXVT8IZXJU7Jm3-5nLqR2-LPC04OZVuRds2MBjYNK1A&oe=6A7F29D3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BOI", "keywords": [], "long_description": "BOI is an early VR prototype built to test locomotion and basic movement inside a simple facility-style environment.\n\nThe current build uses placeholder geometry and a basic test map to evaluate player movement and interaction using a Gorilla Locomotion-based system.\n\nThis version is not a full game and does not include final gameplay systems, objectives, or polished environments. It is intended for testing core VR movement and framework functionality.\n\nFeatures:\n\u2022 VR locomotion testing\n\u2022 Simple facility-style test map\n\u2022 Placeholder geometry and assets\n\u2022 Basic interaction and movement systems\n\u2022 Early prototype build\n\nThis project is currently in development and will evolve over time as systems and content are expanded.", "short_description": "BOI is a VR locomotion prototype set in a simple facility test environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1zyt0mEAGF4ngWs6pTfnUpUr4_0hD4zpvU112YPStt_g/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_n
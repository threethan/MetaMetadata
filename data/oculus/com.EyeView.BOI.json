0_AQKkWLEIig2R2avMwwStxCqVNkSK4MQQVWCKLpDdmZhqcw&oe=6A9D71F8"}, {"file_name": "pt4.png", "id": "936920689384392", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499314659_936920692717725_1204283558882830953_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L8UwMem-Yp4Q7kNvwH6sdCV&_nc_oc=AdparmVo-y0V6OWXtUIUCL_F2Zl1_CQb2gLmo_7cFgqA6DoioFvbViWSkwq-gt_gAfs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJV1o6totY0VG1Buy7s2x8kjN9csfRSHHyNhHLGX0R2Pw&oe=6A9D7FAD"}, {"file_name": "pt5.png", "id": "1645182046596625", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499299789_1645182049929958_4947210763828511572_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IlomIUezT7AQ7kNvwG8UJnh&_nc_oc=AdrP6YPQkfNeklh-O3dJTFnQRB7S9Do9_Rm28BzZ0opSn-pyOY3vMWcrBUx9S98bHOc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIb2yxUftAsPTDPxcps1_G_Jgq5tDdaS9vEl6L83SunEA&oe=6A9D7C53"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BOI", "keywords": [], "long_description": "BOI is an early VR prototype built to test locomotion and basic movement inside a simple facility-style environment.\n\nThe current build uses placeholder geometry and a basic test map to evaluate player movement and interaction using a Gorilla Locomotion-based system.\n\nThis version is not a full game and does not include final gameplay systems, objectives, or polished environments. It is intended for testing core VR movement and framework functionality.\n\nFeatures:\n\u2022 VR locomotion testing\n\u2022 Simple facility-style test map\n\u2022 Placeholder geometry and assets\n\u2022 Basic interaction and movement systems\n\u2022 Early prototype build\n\nThis project is currently in development and will evolve over time as systems and content are expanded.", "short_description": "BOI is a VR locomotion prototype set in a simple facility test environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/do
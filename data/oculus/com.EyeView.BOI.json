0_AQK_pZLUszFSEqnFikXFPOD-cQzBd1WD127rdaliesy-Kw&oe=6AA55AF8"}, {"file_name": "pt4.png", "id": "936920689384392", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499314659_936920692717725_1204283558882830953_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BKgEZoxihekQ7kNvwFxZY_p&_nc_oc=Adq5K-MGBQ9BolLD1AfohJbzd96OJUUvBFlFmFxWKK-4Iy6R8LpNc5yxxGqMdqPwUYQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKv_RhtLq8z5VjKYwBoP3VkAbzBd8dFyyfug7iCRdv50g&oe=6AA568AD"}, {"file_name": "pt5.png", "id": "1645182046596625", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499299789_1645182049929958_4947210763828511572_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GQhK18F94FcQ7kNvwGj-J--&_nc_oc=Adq8rFUkzK9WQ0P42VFeHhoJIDKPsiduCRFeGT-BlsMhSgs1aEU7MP9FV3Rbiqr4kbg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-j1DnSfJQSA7I-wTloLuoqcCXj6F_JNJgJtOO_57Kgw&oe=6AA56553"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BOI", "keywords": [], "long_description": "BOI is an early VR prototype built to test locomotion and basic movement inside a simple facility-style environment.\n\nThe current build uses placeholder geometry and a basic test map to evaluate player movement and interaction using a Gorilla Locomotion-based system.\n\nThis version is not a full game and does not include final gameplay systems, objectives, or polished environments. It is intended for testing core VR movement and framework functionality.\n\nFeatures:\n\u2022 VR locomotion testing\n\u2022 Simple facility-style test map\n\u2022 Placeholder geometry and assets\n\u2022 Basic interaction and movement systems\n\u2022 Early prototype build\n\nThis project is currently in development and will evolve over time as systems and content are expanded.", "short_description": "BOI is a VR locomotion prototype set in a simple facility test environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/do
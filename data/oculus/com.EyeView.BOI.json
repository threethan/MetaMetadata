0_AQNXjTmyzcqkZZlC7-ASrHnXkZ35Rp1uCcySKiow2qHk2A&oe=6AC7A1F8"}, {"file_name": "pt4.png", "id": "936920689384392", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499314659_936920692717725_1204283558882830953_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BamSyzo2SXsQ7kNvwFrT7kE&_nc_oc=AdrFSV8hm0cxRezi-BTf2be--da-zv4pLUELSn7MXISUJD-6FbWBkFU6Xci3C_DfLss&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMvGuFqTm5U4O1VHOjvSwpDrVLlCxKLc-WDEwuTPPG2hQ&oe=6AC7AFAD"}, {"file_name": "pt5.png", "id": "1645182046596625", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499299789_1645182049929958_4947210763828511572_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lHP252S_7k8Q7kNvwEzEvOS&_nc_oc=Adpw6vgHWE3wovhnEitv-eX4soPpTWvxyCMVQcliCBaZcB6ALHVGvmSKGqO7z_W_43Q&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP9KnizWUU0_k_UGyWUwBh7vSlP754Ncvd56wWLG1dc8w&oe=6AC7AC53"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BOI", "keywords": [], "long_description": "BOI is an early VR prototype built to test locomotion and basic movement inside a simple facility-style environment.\n\nThe current build uses placeholder geometry and a basic test map to evaluate player movement and interaction using a Gorilla Locomotion-based system.\n\nThis version is not a full game and does not include final gameplay systems, objectives, or polished environments. It is intended for testing core VR movement and framework functionality.\n\nFeatures:\n\u2022 VR locomotion testing\n\u2022 Simple facility-style test map\n\u2022 Placeholder geometry and assets\n\u2022 Basic interaction and movement systems\n\u2022 Early prototype build\n\nThis project is currently in development and will evolve over time as systems and content are expanded.", "short_description": "BOI is a VR locomotion prototype set in a simple facility test environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/do
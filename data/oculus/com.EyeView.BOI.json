0_AQFspX9IXEnVtxC2l5MoseO6CcNl11SThtYJOmih1ou42g&oe=6A93FF38"}, {"file_name": "pt4.png", "id": "936920689384392", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499314659_936920692717725_1204283558882830953_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lY8_yv4jwR8Q7kNvwFXs6HT&_nc_oc=AdqvCmMEp6ptdZ_2dggL502TLMCSaBYWIWnQmmcX5T9w4M0noxNHVf6F6ZKmKrmnChs&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0-m76Fwt6mcb1gp9cTkHjSKCFrbQCA7I-JnOfyco9PA&oe=6A940CED"}, {"file_name": "pt5.png", "id": "1645182046596625", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499299789_1645182049929958_4947210763828511572_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XNK6Q31UyGoQ7kNvwFjoZQU&_nc_oc=Adqm7p8Vrhb4SdR7h-cpxDBVUmu6GaU4dluRLbui12QXRa279DPzcdu67WzUYisP_IA&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGyF3JYe2jW1GNaNPiatpUFkBJGbQpU_KIwKyjTyGrvEQ&oe=6A940993"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BOI", "keywords": [], "long_description": "BOI is an early VR prototype built to test locomotion and basic movement inside a simple facility-style environment.\n\nThe current build uses placeholder geometry and a basic test map to evaluate player movement and interaction using a Gorilla Locomotion-based system.\n\nThis version is not a full game and does not include final gameplay systems, objectives, or polished environments. It is intended for testing core VR movement and framework functionality.\n\nFeatures:\n\u2022 VR locomotion testing\n\u2022 Simple facility-style test map\n\u2022 Placeholder geometry and assets\n\u2022 Basic interaction and movement systems\n\u2022 Early prototype build\n\nThis project is currently in development and will evolve over time as systems and content are expanded.", "short_description": "BOI is a VR locomotion prototype set in a simple facility test environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/do
oh=00_AQJ-JAIRTskZarwab8etAioLmNE3neYLERi0VO8bq4b40Q&oe=6AA40978"}, {"file_name": "pt4.png", "id": "936920689384392", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499314659_936920692717725_1204283558882830953_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BKgEZoxihekQ7kNvwEyx_q6&_nc_oc=AdpjvApK0Ap4X8Xsv8EJ7OrN2Ajpnch2MPp6sf_ZYZtVhdhebjFQAsFl6un_IAc18cw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKXQaoRNbErtkTWL4oHe-hB4HuTyYUXOwHfQ8y6Qi2V2A&oe=6AA4172D"}, {"file_name": "pt5.png", "id": "1645182046596625", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499299789_1645182049929958_4947210763828511572_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QDw_b84D_XAQ7kNvwHak3mM&_nc_oc=AdrqrHPvruT6OL3U1YMuyDsH_SEZbQgbGmagqzlz504TSwqopyi-06UeFBGSTqSKu48&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7Cd4_gpjVX4oCG9ZB82aLkg5hREVjqe_OkSmn2zqvww&oe=6AA413D3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BOI", "keywords": [], "long_description": "BOI is an early VR prototype built to test locomotion and basic movement inside a simple facility-style environment.\n\nThe current build uses placeholder geometry and a basic test map to evaluate player movement and interaction using a Gorilla Locomotion-based system.\n\nThis version is not a full game and does not include final gameplay systems, objectives, or polished environments. It is intended for testing core VR movement and framework functionality.\n\nFeatures:\n\u2022 VR locomotion testing\n\u2022 Simple facility-style test map\n\u2022 Placeholder geometry and assets\n\u2022 Basic interaction and movement systems\n\u2022 Early prototype build\n\nThis project is currently in development and will evolve over time as systems and content are expanded.", "short_description": "BOI is a VR locomotion prototype set in a simple facility test environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.
0_AQKwUC_X7jKYDWSy3Ru9Kwnah4UE3eXK-R_VBb57_AMQGA&oe=6AA6AC78"}, {"file_name": "pt4.png", "id": "936920689384392", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499314659_936920692717725_1204283558882830953_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sPGk4LuGm-IQ7kNvwE4bHhz&_nc_oc=AdqljyvZlLBVFOXFLENQEmbwuS5wgctLemWQjT22iBobw6r7sBB0XCpZRyUaFPHSFAY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkoK84FJYIuTTpopuZLrmix4LFMITuX_RL859Q3idaKQ&oe=6AA6BA2D"}, {"file_name": "pt5.png", "id": "1645182046596625", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499299789_1645182049929958_4947210763828511572_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GQhK18F94FcQ7kNvwFt7Qmt&_nc_oc=AdouaHKks3EvEKQrSadWAsUr7e9Ki5G4x1yziiuvSMHlm8y5W82ADSmBmvVkTHmsLVI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5oTr8iIhEq1ZtmTFO2SCEbZ1QcAr6Ncb-UdX-6HkpUg&oe=6AA6B6D3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BOI", "keywords": [], "long_description": "BOI is an early VR prototype built to test locomotion and basic movement inside a simple facility-style environment.\n\nThe current build uses placeholder geometry and a basic test map to evaluate player movement and interaction using a Gorilla Locomotion-based system.\n\nThis version is not a full game and does not include final gameplay systems, objectives, or polished environments. It is intended for testing core VR movement and framework functionality.\n\nFeatures:\n\u2022 VR locomotion testing\n\u2022 Simple facility-style test map\n\u2022 Placeholder geometry and assets\n\u2022 Basic interaction and movement systems\n\u2022 Early prototype build\n\nThis project is currently in development and will evolve over time as systems and content are expanded.", "short_description": "BOI is a VR locomotion prototype set in a simple facility test environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/do
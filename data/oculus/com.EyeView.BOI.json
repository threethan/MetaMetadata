0_AQL1uWSL2qJlyM8KIUvERjLf_Pyb4Crg9HL9g1AVzKqpMg&oe=6A9ACEF8"}, {"file_name": "pt4.png", "id": "936920689384392", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499314659_936920692717725_1204283558882830953_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L8UwMem-Yp4Q7kNvwHnc32k&_nc_oc=AdqsWkTPrDcLjDtdCp5hnpP5ZS7i8XGj-BgHv4GHZBTUFCgIle77Zmf-q6obnZ5rk9k&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8aWksS_ras5NwnCbiNd1JArAwqxtd58Rm_RtoZsiW_g&oe=6A9ADCAD"}, {"file_name": "pt5.png", "id": "1645182046596625", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499299789_1645182049929958_4947210763828511572_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KX6RTcqsdRMQ7kNvwH99JAC&_nc_oc=Adr3ZnXc2FgANqx_rfjUiPDzEcTeGJEt8aT9NE_3Dyi3NR1OTOWpLOJ45ibf2_uz1sQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJv1uVnvW8xKlW2Ym8T3yI8SsjGNDGjMmoj5Rbl_R6p7g&oe=6A9AD953"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BOI", "keywords": [], "long_description": "BOI is an early VR prototype built to test locomotion and basic movement inside a simple facility-style environment.\n\nThe current build uses placeholder geometry and a basic test map to evaluate player movement and interaction using a Gorilla Locomotion-based system.\n\nThis version is not a full game and does not include final gameplay systems, objectives, or polished environments. It is intended for testing core VR movement and framework functionality.\n\nFeatures:\n\u2022 VR locomotion testing\n\u2022 Simple facility-style test map\n\u2022 Placeholder geometry and assets\n\u2022 Basic interaction and movement systems\n\u2022 Early prototype build\n\nThis project is currently in development and will evolve over time as systems and content are expanded.", "short_description": "BOI is a VR locomotion prototype set in a simple facility test environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/do
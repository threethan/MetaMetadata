ps://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499314659_936920692717725_1204283558882830953_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wSTT6jxRCSkQ7kNvwHIjKmi&_nc_oc=AdovjqhmQXUaE6hqR04JfIPISZjZzQGNCjqwAR4iPwMAlVDwszIyzkH9ErRQnQaNYNg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDp9WV-rr5z-N4nE_qP1DMou0VKHLaj-tee6FtNipxRzQ&oe=6A6F5B2D"}, {"file_name": "pt5.png", "id": "1645182046596625", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499299789_1645182049929958_4947210763828511572_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e4_HnfD8xSQQ7kNvwFyIaMB&_nc_oc=AdpcPKEZO8qBWRfWcBJ6PunIA_WArUT0xaxfyMP52-DAx3vpIqttb3x5EBF-8Dcncwo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-1N0jhneTJ2xivFJVL9L6V5v7qgbioboKJl7F8JQbEw&oe=6A6F57D3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BOI", "keywords": [], "long_description": "BOI is an early VR prototype built to test locomotion and basic movement inside a simple facility-style environment.\n\nThe current build uses placeholder geometry and a basic test map to evaluate player movement and interaction using a Gorilla Locomotion-based system.\n\nThis version is not a full game and does not include final gameplay systems, objectives, or polished environments. It is intended for testing core VR movement and framework functionality.\n\nFeatures:\n\u2022 VR locomotion testing\n\u2022 Simple facility-style test map\n\u2022 Placeholder geometry and assets\n\u2022 Basic interaction and movement systems\n\u2022 Early prototype build\n\nThis project is currently in development and will evolve over time as systems and content are expanded.", "short_description": "BOI is a VR locomotion prototype set in a simple facility test environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1zyt0mEAGF4ngWs6pTfnUpUr4_0hD4zpvU112YPStt_g/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_n
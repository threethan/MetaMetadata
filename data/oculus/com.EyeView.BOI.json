0_AQEAkMtAZsleRlkzwjvBTFHRbKixTP5AyEdGpt_fXi4Fgw&oe=6A900AB8"}, {"file_name": "pt4.png", "id": "936920689384392", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499314659_936920692717725_1204283558882830953_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TjXlqXa4J0EQ7kNvwG0ssbT&_nc_oc=AdozeEK6t0_JCBnYb-Q2kgbv5nnNved7cdLZtyh2dpw5WGcVqPzqMH2nljgE-HBcQAE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEVA7gPGWCoAT7rERWhCTW7vR16U3v0UODCLhf2G0Hb0g&oe=6A90186D"}, {"file_name": "pt5.png", "id": "1645182046596625", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499299789_1645182049929958_4947210763828511572_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EXOvU4a4vVYQ7kNvwHQsUxD&_nc_oc=AdpJl480wNGChp7_7Flk_4YBK02fN4g7dqOcTxNXhqLyuS6vR9P7u8sipUgWtYRaf8k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQRqkMut0Nr5qQqHtl16vgnMrv4dxM5orGtuEoWwjZmQ&oe=6A901513"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BOI", "keywords": [], "long_description": "BOI is an early VR prototype built to test locomotion and basic movement inside a simple facility-style environment.\n\nThe current build uses placeholder geometry and a basic test map to evaluate player movement and interaction using a Gorilla Locomotion-based system.\n\nThis version is not a full game and does not include final gameplay systems, objectives, or polished environments. It is intended for testing core VR movement and framework functionality.\n\nFeatures:\n\u2022 VR locomotion testing\n\u2022 Simple facility-style test map\n\u2022 Placeholder geometry and assets\n\u2022 Basic interaction and movement systems\n\u2022 Early prototype build\n\nThis project is currently in development and will evolve over time as systems and content are expanded.", "short_description": "BOI is a VR locomotion prototype set in a simple facility test environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/do
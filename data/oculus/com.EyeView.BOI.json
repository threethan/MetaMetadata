0_AQGWaXknU82koiCDwj6mc78UvHkxp3SGSJDp_Mkeb0k-PQ&oe=6A915C38"}, {"file_name": "pt4.png", "id": "936920689384392", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/499314659_936920692717725_1204283558882830953_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TjXlqXa4J0EQ7kNvwEyCqpA&_nc_oc=Adro3jLBtfXUyn7K6HdIQuJaePIv9VU6X5t-qc2f3pDhS4aLPH66OenOrYTdpKw2p-w&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQENDqqmCuGUcr-BgD6J0Xib3kw4EJ-10z03faCkOgBKhg&oe=6A9169ED"}, {"file_name": "pt5.png", "id": "1645182046596625", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499299789_1645182049929958_4947210763828511572_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XNK6Q31UyGoQ7kNvwHjdHsP&_nc_oc=AdoBzmJXpp7tW5GQ3kmbXn5Jv5Z0gsYxh1YQZ3F0UsqNWjsu6AxiVoXurcej_cQD8Mw&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOOXBbCDRPBiGFozZqs-OGPA1cd2JQTQwnYfh1weHF5w&oe=6A916693"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BOI", "keywords": [], "long_description": "BOI is an early VR prototype built to test locomotion and basic movement inside a simple facility-style environment.\n\nThe current build uses placeholder geometry and a basic test map to evaluate player movement and interaction using a Gorilla Locomotion-based system.\n\nThis version is not a full game and does not include final gameplay systems, objectives, or polished environments. It is intended for testing core VR movement and framework functionality.\n\nFeatures:\n\u2022 VR locomotion testing\n\u2022 Simple facility-style test map\n\u2022 Placeholder geometry and assets\n\u2022 Basic interaction and movement systems\n\u2022 Early prototype build\n\nThis project is currently in development and will evolve over time as systems and content are expanded.", "short_description": "BOI is a VR locomotion prototype set in a simple facility test environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/do
 journey today with NUSU.", "short_description": "Discover your inner musician with NUSU, the only VR game that teaches you how to make music as you play. No experience? No problem - NUSU guides you from the first note to creating your own songs, making music accessible to everyone. Unleash your potential and experience the joy of music like never before. It's not just about playing; it's about living music. Start your musical journey today with NUSU."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nusu.app/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Deliver Software", "support_website_url": null, "website_url": "https://nusu.app/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6696055303854894"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PUBLISHED", "id": "2087668418684050"}, {"status": "PUBLISHED", "id": "915698984327300"}, {"status": "PUBLISHED", "id": "514473595065437"}, {"status": "PUBLISHED", "id": "1803077620465793"}, {"status": "PUBLISHED", "id": "1701919737291317"}, {"status": "PUBLISHED", "id": "474396342231298"}, {"status": "PUBLISHED", "id": "497209106186883"}, {"status": "PUBLISHED", "id": "1002531571245754"}, {"status": "PUBLISHED", "id": "1138647953809753"}]}, "baseline_offer": {"id": "1701919737291317"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 
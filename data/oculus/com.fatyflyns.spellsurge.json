, "id": "1027136050255950", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499298900_1027136053589283_5263105638413750801_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hGj6qKJZ__UQ7kNvwHnNdSg&_nc_oc=AdpqtfqZQgbPLeHuH-BheYuUFUw8dmtUh6uuzYvaKva0XBwaXOjq-S5LfXo_xbYuEFo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNEzOyySymM9sLx67kxpeCdZ9NHsYJMDMS_6Pj_XcwFA&oe=6AAEA296"}]}, "id": "1027981200016595", "locale": "en_US", "screenshots": [{"file_name": "shot1a.png", "id": "2461438977684011", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499299922_2461438981017344_7105260811744361111_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zda09rBQni8Q7kNvwFIwPgU&_nc_oc=AdpT3HUP5endjprAz0qiZfTW0DJalytc8C74w60lXXvlyJJ0qlr9oIQzm6HpGCPMELo&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8wSNA8lUy7D_BAdODkU05bSO9uEyVN-vwXlADevVytQ&oe=6AAE9DF4"}, {"file_name": "shot2a.png", "id": "1684590669418793", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499622315_1684590672752126_2930686810692979826_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1CAfqQULBNoQ7kNvwEW6iL1&_nc_oc=AdpZ42iG1KENa0K8ICgKzti3JD__GqLzZJ8sVr351xr3mTGTFaQuAwj23xGn4rFxjQ0&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDoWZksTSCBwY2mJljoqhg0hJP7MGFeJrpQd3W2-M31A&oe=6AAE9FE6"}, {"file_name": "shot3a.png", "id": "1038895018557435", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499620429_1038895021890768_2747253276527277401_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1VcWTWE7fCQQ7kNvwEPBHaf&_nc_oc=AdqeyNBMZvCygUWwtOGt3gSQJl-CtGQ2m3kLTzB5Gd28n4Tc--kyqnlT2e5VJPMPULI&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzJV2EZsY63Ybp0VYpIMWnQ3Cb5pIdmA57CcTTTneOCw&oe=6AAEB01E"}, {"file_name": "shot4a.png", "id": "1494843658509158", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499312310_1494843661842491_6276036095143874018_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RabyoMHOaLgQ7kNvwHzNCof&_nc_oc=AdqIeuXT61-TWGeDHzP3Rtru6YkZ7nB3Ufh_2Ulk9fQS58RkXjwO80xvwptsXF4Aemg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1SNzq4sDVEHt_9HDCZELz5vUmTp1IePNWKAGpNaS8lg&oe=6AAEB4DB"}, {"file_name": "shot5a.png", "id": "1231464412329870", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499299845_1231464415663203_1475041192801398963_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ItXCqkP6-OYQ7kNvwGslJ6h&_nc_oc=AdoQP5hKOEkPyOSNwVwEIOsWwKpR-R6-WB-YvXwx8JhTQrNkiDFcikyk9EyH7kfwb1w&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKzhPMDUsakWpgFKznHjGe_jFlHwmnzVh7NqRTh_qWhTA&oe=6AAE97E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverlandscape.png", "id": "1298150056709701", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499299093_1298150060043034_126913031854862421_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jPM-69tvb_4Q7kNvwGgvMHD&_nc_oc=AdoSxkec-06jVhDl6wvDJLDpZrMD1lqGNrmJ5WXsl1KnDmqc0kYtntDCt9hPkK9Jwkc&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIuKzzkDdnGzPRQRnR-gEXIbSeyf7CaAm4kcGDtg9dkcQ&oe=6AAEAD3C"}, "display_name": "Spell Surge", "keywords": ["Magic", "Wizard", "MixedReality", "VoiceRecognition", "Multiplayer"], "long_description": "Transform your home into a magical battlefield where every room becomes part of the duel.\n\nWalk, dodge, and battle naturally through your own environment while casting powerful spells using your voice and controller movements.\n\nUsing local LAN multiplayer and shared-space calibration, every player experiences the same magical world perfectly aligned with the real environment.\n\nNo virtual joystick.\n\nNo artificial movement.\n\nJust real movement, real strategy, and real spell battles.\n\nFeatures\n\n\ud83e\ude84 Cast spells using voice commands.\n\n  \ud83d\udd25 Fireball \u2013 Explosive ranged attacks.\n\n  \u26a1 Lightning \u2013 Fast precision magic.\n\n   \ud83d\udee1 Shield \u2013 Defensive magical barriers.\n\n\ud83d\udee1 Create magical barriers.\n\n\ud83d\udc65 Local multiplayer with shared Mixed Reality.\n\n\ud83d\udccd Shared-space calibration.\n\n\ud83c\udfaf Team-based matches.\n\n\ud83c\udfae Full-body physical gameplay.\n\n\ud83c\udf10 LAN multiplayer.\n\n\ud83c\udfa4 Offline voice recognition.\n\n\u26a1 Fast-paced magical combat.\n\nEarly Access\n\nSpell Surge is in Early Access and will continue to evolve with new content and gameplay improvements.\n\nThe core gameplay experience is complete and fully playable.\n\nFuture updates will introduce:\n\n\u2022 New spells\n\n\u2022 More visual effects\n\n\u2022 Improved audio\n\n\u2022 Additional game modes\n\n\u2022 New gameplay features\n\nCommunity feedback will help shape the future of Spell Surge.\n\nThank you for supporting the project!", "short_description": "Turn your room into a magical battlefield. Cast spells with your own voice, dodge incoming attacks by moving through your real environment, and duel other wizards in shared Mixed Reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://squall054-ai.github.io/legal/privacy.html", "developer_terms_of_service_url": "https://squall054-ai.github.io/legal/terms.html", "publisher_name": "FatyFlynns Studios", "support_website_url": null, "website_url": "https://squall054-ai.github.io/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING",
scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1SNzq4sDVEHt_9HDCZELz5vUmTp1IePNWKAGpNaS8lg&oe=6AAEB4DB"}, {"file_name": "shot5a.png", "id": "1231464412329870", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499299845_1231464415663203_1475041192801398963_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ItXCqkP6-OYQ7kNvwGslJ6h&_nc_oc=AdoQP5hKOEkPyOSNwVwEIOsWwKpR-R6-WB-YvXwx8JhTQrNkiDFcikyk9EyH7kfwb1w&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKzhPMDUsakWpgFKznHjGe_jFlHwmnzVh7NqRTh_qWhTA&oe=6AAE97E1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Spell Surge", "keywords": ["Magic", "Wizard", "MixedReality", "VoiceRecognition", "Multiplayer"], "long_description": "Transform your home into a magical battlefield where every room becomes part of the duel.\n\nWalk, dodge, and battle naturally through your own environment while casting powerful spells using your voice and controller movements.\n\nUsing local LAN multiplayer and shared-space calibration, every player experiences the same magical world perfectly aligned with the real environment.\n\nNo virtual joystick.\n\nNo artificial movement.\n\nJust real movement, real strategy, and real spell battles.\n\nFeatures\n\n\ud83e\ude84 Cast spells using voice commands.\n\n  \ud83d\udd25 Fireball \u2013 Explosive ranged attacks.\n\n  \u26a1 Lightning \u2013 Fast precision magic.\n\n   \ud83d\udee1 Shield \u2013 Defensive magical barriers.\n\n\ud83d\udee1 Create magical barriers.\n\n\ud83d\udc65 Local multiplayer with shared Mixed Reality.\n\n\ud83d\udccd Shared-space calibration.\n\n\ud83c\udfaf Team-based matches.\n\n\ud83c\udfae Full-body physical gameplay.\n\n\ud83c\udf10 LAN multiplayer.\n\n\ud83c\udfa4 Offline voice recognition.\n\n\u26a1 Fast-paced magical combat.\n\nEarly Access\n\nSpell Surge is in Early Access and will continue to evolve with new content and gameplay improvements.\n\nThe core gameplay experience is complete and fully playable.\n\nFuture updates will introduce:\n\n\u2022 New spells\n\n\u2022 More visual effects\n\n\u2022 Improved audio\n\n\u2022 Additional game modes\n\n\u2022 New gameplay features\n\nCommunity feedback will help shape the future of Spell Surge.\n\nThank you for supporting the project!", "short_description": "Turn your room into a magical battlefield. Cast spells with your own voice, dodge incoming attacks by moving through your real environment, and duel other wizards in shared Mixed Reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://squall054-ai.github.io/legal/privacy.html", "developer_terms_of_service_url": "https://squall054-ai.github.io/legal/terms.html", "publisher_name": "FatyFlynns Studios", "support_website_url": null, "website_url": "https://squall054-ai.github.io/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER", "CO_OP", "MULTI_USER"], "id": "1791815238843591"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1008427718821526"}]}, "baseline_offer": {"id": "1008427718821526"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1783584180, "status": "PUBLISHED", "id": "1008427718821526"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1811739846851130", "version": "0.9.9"}, "id": "1416331836999858", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1791815235510258", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1811739846851130"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1416331836999858"}]}, "change_log": "Fixed Meta Shared Anchor multiplayer colocation.\r\nImproved shared-space synchronization between Quest headsets.\r\nFixed an issue where AprilTag settings could incorrectly affect colocation mode selection.\r\nImproved multiplayer session stability and spatial alignment.", "created_date": 1784864343, "id": "1811739846851130", "version": "0.9.9", "version_code": 13, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1791815235510258", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1811739846851130"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1416331836999858"}]}, "change_log": "New\r\nAdded a complete Health & Mana system.\r\nAdded a new Combat HUD displaying current Health and Mana.\r\nAdded an option in Settings to keep the Combat HUD always visible.\r\nScoreboard now awards 1 point per defeat for clearer match results.\r\nImprovements\r\nImproved combat flow and player feedback.\r\nImproved object placement workflow by automatically returning to the wand when leaving the Objects page.\r\nGeneral UI and usability improvements.\r\nFixes\r\nFixed multiple combat and HUD issues.\r\nImproved overall stability and reliability.\r\nGeneral bug fixes and performance improvements.", "created_date": 1784177358, "id": "1805279717497143", "version": "0.9.9", "version_code": 12, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1791815235510258", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1811739846851130"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1416331836999858"}]}, "change_log": "fix code", "created_date": 1784123642, "id": "1804737110884737", "version": "0.9.9", "version_code": 10, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1791815235510258", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1811739846851130"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1416331836999858"}]}, "change_log": "New\r\nAdded a redesigned in-game Settings menu.\r\nAdded configurable spell casting mode (Hands-Free / Hold Trigger).\r\nAdded in-game Debug Mode toggle for development and testing.\r\nAdded About page with links to the official website, Privacy Policy, Terms of Service, and Licenses.\r\nImprovements\r\nImproved menu navigation and overall UI.\r\nImproved multiplayer session management.\r\nImproved Mixed Reality initialization and AprilTag workflow.\r\nImproved stability of shared-space colocation.\r\nImproved in-game developer console and logging tools.\r\nGeneral performance and code quality improvements.\r\nFixes\r\nFixed multiple UI issues.\r\nFixed several networking and session state issues.\r\nFixed AprilTag detection regressions.\r\nFixed various bugs affecting gameplay and stability.", "created_date": 1784081567, "id": "1804312070927241", "version": "0.9.9", "version_code": 1, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1791815235510258", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1811739846851130"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1416331836999858"}]}, "change_log": "\ufffd New\r\nAdded Arcane Tips, a dynamic loading screen that provides gameplay tips, spell information, and helpful guidance while connecting to a match.\r\nImproved the main menu presentation with enhanced artwork and a more immersive visual style.\r\n\ufffd UI Improvements\r\nRefined menu visuals and background blending for a more polished magical atmosphere.\r\nImproved loading screen layout and readability.\r\nUpdated instructional graphics using the new Spell Surge holographic UI style.\r\nAdded new holographic controller illustrations and guidance elements.\r\n\ufffd Improvements\r\nGeneral UI polish and consistency improvements across the interface.\r\nImproved visual transitions and presentation quality.\r\n\ufffd Fixes\r\nVarious bug fixes and stability improvements.", "created_date": 1783661171, "id": "1800340617991053", "version": "0.9.8", "version_code": 9, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
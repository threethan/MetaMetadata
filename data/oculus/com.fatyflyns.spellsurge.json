.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtgxYNGeTgKlSZRezzDPOyFCpr1-XnANLX3VXE-0biVQ&oe=6AF342DB"}, {"file_name": "shot5a.png", "id": "1231464412329870", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499299845_1231464415663203_1475041192801398963_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5lEXUlc_0rYQ7kNvwFX72s7&_nc_oc=AdpEtCt17YCGLKQPreFWaj-fiCRXYfykqPsW1i9DHetJJut50RHB7jGVt1-FChQsi4Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUXIKTtB1dgpzRBb1EF-TDTG5dcDBptiuagIwjZZu2qQ&oe=6AF325E1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Spell Surge", "keywords": ["Magic", "Wizard", "MixedReality", "VoiceRecognition", "Multiplayer"], "long_description": "Transform your home into a magical battlefield where every room becomes part of the duel.\n\nWalk, dodge, and battle naturally through your own environment while casting powerful spells using your voice and controller movements.\n\nUsing local LAN multiplayer and shared-space calibration, every player experiences the same magical world perfectly aligned with the real environment.\n\nNo virtual joystick.\n\nNo artificial movement.\n\nJust real movement, real strategy, and real spell battles.\n\nFeatures\n\n\ud83e\ude84 Cast spells using voice commands.\n\n  \ud83d\udd25 Fireball \u2013 Explosive ranged attacks.\n\n  \u26a1 Lightning \u2013 Fast precision magic.\n\n   \ud83d\udee1 Shield \u2013 Defensive magical barriers.\n\n\ud83d\udee1 Create magical barriers.\n\n\ud83d\udc65 Local multiplayer with shared Mixed Reality.\n\n\ud83d\udccd Shared-space calibration.\n\n\ud83c\udfaf Team-based matches.\n\n\ud83c\udfae Full-body physical gameplay.\n\n\ud83c\udf10 LAN multiplayer.\n\n\ud83c\udfa4 Offline voice recognition.\n\n\u26a1 Fast-paced magical combat.\n\nEarly Access\n\nSpell Surge is in Early Access and will continue to evolve with new content and gameplay improvements.\n\nThe core gameplay experience is complete and fully playable.\n\nFuture updates will introduce:\n\n\u2022 New spells\n\n\u2022 More visual effects\n\n\u2022 Improved audio\n\n\u2022 Additional game modes\n\n\u2022 New gameplay features\n\nCommunity feedback will help shape the future of Spell Surge.\n\nThank you for supporting the project!", "short_description": "Turn your room into a magical battlefield. Cast spells with your own voice, dodge incoming attacks by moving through your real environment, and duel other wizards in shared Mixed Reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://squall054-ai.github.io/legal/privacy.html", "developer_terms_of_service_url": "https://squall054-ai.github.io/legal/terms.html", "publisher_name": "FatyFlynns Studios", "support_website_url": null, "website_url": "https://squall054-ai.github.io/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER", "CO_OP", "MULTI_USER"], "id": "1791815238843591"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1008427718821526"}]}, "baseline_offer": {"id": "1008427718821526"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1783584180, "status": "PUBLISHED", "id": "1008427718821526"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1904648820893565", "version": "0.9.9"}, "id": "141633
x44tHyg4s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3E0PWIKSyTjf0BC56RYD--5a5qPUriv7SZrKkZi9dxIg&oe=69F73CF0"}, {"file_name": "340e92db3c3a42e18f953b88cd28d6d5_2560x1440.png", "id": "26157444713916490", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499624447_26157444717249823_4400143618888700237_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WET_OUPHPjUQ7kNvwFIU-87&_nc_oc=Adrxa3vWbhm6ObyaUztE92Ov6VCIPSPLJYh144OhqNNxAWuSXTyM2vcrS3ldU8ioZf0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1AYC5iPB9NlHV4UWfxSdlxUVCwJcCnP1dUh39acyD2Ww&oe=69F74362"}, {"file_name": "350d8f731a5e4e56ac95e05a2ff955e7_2560x1440.png", "id": "892207243855247", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312332_892207247188580_1600766398821661984_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fa5VXEIOknEQ7kNvwE3MltQ&_nc_oc=AdpIQA8Z8WN8ZVlIqJnoiLIzaFIqnd8ykjjCbv8mKOIh2PuyIi7pTp0ws-HcTIvbPCE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0poNba5yN83_caN-R9PEbrnIH9I4ZsmuKpU2hK8S6KhQ&oe=69F7516A"}, {"file_name": "071be3f9b2fc4b5e9411c836e9f0c47a_2560x1440.png", "id": "2771481323214097", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499295661_2771481326547430_4918614980250761290_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gso0AHJ9LIgQ7kNvwGMLj-y&_nc_oc=Adq_Vz7toM768wX8IGWpHdY_eA3Viogg00sBve7zm9XQqm-guze5BLP6oYRYMjg1ENU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0BXqOSZS2cnYylukcDlXjYpBFop1ZxOx4YHxB3OIfIrA&oe=69F75BDC"}, {"file_name": "93efa758b30b42d9a3cf638c138b1103_2560x1440.png", "id": "2057249518153326", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499304106_2057249521486659_1440206641546912397_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j-QFC8aImSgQ7kNvwGkVBLr&_nc_oc=AdqWvz0-1-8Y-f7t6-u26WqD9pgGnoj40IhZKZBvfv3I3HqPAdMjwSeeK4tjFqHexyE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1Cm6aoB5a_2rt6Eo3QcxSZJbKg4Qqmf97th5sGQHObWw&oe=69F73C6B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pray the Rosary MR", "keywords": [], "long_description": "\nPray the Rosary MR is a guided mixed-reality prayer companion built for Meta Quest. It walks you through a full Rosary sequence with clear step-by-step navigation, including opening prayers, all mystery decades, and closing prayers. Each step displays the prayer text, mystery meditation, and related Scripture passage, with scrollable reading support for long prayers.\n\nAs you pray, the app visually highlights the matching rosary element in real time (crucifix, medal, bead, or chain link), helping you stay synchronized between prayer and physical flow. Mystery artwork is shown beside the panel in a framed display, paired with each mystery\u2019s meditation and Scripture context.\n\nThe experience is tuned for comfort and clarity in MR: large readable panel text, adjustable text size controls, bold text toggle, side-by-side rosary and artwork layout, and automatic day-based mystery scheduling on startup:\n- Monday/Saturday: Joyful  \n- Tuesday/Friday: Sorrowful  \n- Wednesday/Sunday: Glorious  \n- Thursday: Luminous\n\nYou can further customize the visual experience with built-in UI controls such as opacity toggle, passthrough toggle, and panel/audio options, plus additional environment settings for a calm devotional atmosphere. Designed for lightweight performance and smooth interaction, Pray the Rosary MR combines reverent structure, visual guidance, and practical accessibility in one immersive prayer app.\n{2664826890570826}", "short_description": "Pray the Rosary MR is a guided mixed-reality prayer experience for Meta Quest. Follow the complete Rosary prayer flow with step-by-step prayers, Scripture passages, mystery meditations, and sacred artwork. Visual cues highlight the matching rosary bead, chain, medal, or crucifix as you pray. Enjoy a calm low-poly environment, adjustable reading panel, and day-based mystery scheduling (Joyful, Sorrowful, Glorious, Luminous) on startup.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/BicentennialSoftware/pray_the_rosary_mr_site/blob/main/privacy-policy.md", "developer_terms_of_service_url": null, "publisher_name": "Bicentennial Software", "support_website_url": null, "website_url": "https://github.com/BicentennialSoftware/pray_the_rosary_mr_site/blob/main/README.md", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26314518914884142"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1663330304678320"}]}, "baseline_offer": {"id": "1663330304678320"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1777179600, "status": "PUBLISHED", "id": "1663330304678320"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26616082688061095", "version": "7"}, "id": "755985234261773", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26314518881550812", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26616082688061095"}, "release_status": "RELEASED"}, "bin
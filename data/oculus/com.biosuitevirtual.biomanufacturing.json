rtual. This short, immersive primer is not a full course on its own, but an on-ramp to hands-on biomanufacturing training. In one focused experience, it introduces the environments, concepts, terminology, and workflows used throughout BioSuite Virtual, helping the equipment and training tasks feel familiar before you begin.\n\n# How It Prepares You for BioSuite Virtual\n- Introduces the environment where your training will take place\n- Teaches the concepts and vocabulary used throughout BioSuite Virtual\n- Builds confidence so you are ready to start hands-on training", "short_description": "This immersive introduction prepares users for their upcoming BioSuite Virtual training by introducing the basics of working in a mixed reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://biosuitevirtual.com/privacy/world-of-biotech", "developer_terms_of_service_url": null, "publisher_name": "Prism Immersive", "support_website_url": null, "website_url": "https://biosuitevirtual.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1207090955828954"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313074_1010852451807907_8903650862777130693_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LaVphg73pQoQ7kNvwHUDsZR&_nc_oc=A
_960618073674132_4164489290624296768_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VhHMbLk3wm4Q7kNvwHBb_gO&_nc_oc=AdrNgqlHGzSkgbbodkt5ArDV6hRPfZydIl1aKpgslFQfFKRUmQABQUpyzzoV8XBAFaE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQObwoMKr5FG9KGtqJ-VC8Y7f6ZmOdRkXyEC1V93L6HI1g&oe=6AE60552"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BioSuite Virtual: The World of Biotech", "keywords": ["BioSuite", "Virtual", "Training", "Acedemic", "BioManufacturing"], "long_description": "# The World of Biomanufacturing\nTake your first step toward BioSuite Virtual. This short, immersive primer is not a full course on its own, but an on-ramp to hands-on biomanufacturing training. In one focused experience, it introduces the environments, concepts, terminology, and workflows used throughout BioSuite Virtual, helping the equipment and training tasks feel familiar before you begin.\n\n# How It Prepares You for BioSuite Virtual\n- Introduces the environment where your training will take place\n- Teaches the concepts and vocabulary used throughout BioSuite Virtual\n- Builds confidence so you are ready to start hands-on training", "short_description": "This immersive introduction prepares users for their upcoming BioSuite Virtual training by introducing the basics of working in a mixed reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://biosuitevirtual.com/privacy/world-of-biotech", "developer_terms_of_service_url": null, "publisher_name": "Prism Immersive", "support_website_url": null, "website_url": "https://biosuitevirtual.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT",
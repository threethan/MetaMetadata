9_1080618928009140_9167876484944534708_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AlEeCeUDtpEQ7kNvwFxRKH7&_nc_oc=Adqr3hSEF9HLpOOCY4GrgHX6ysZI5p3aLvyZubBquE0RS0IQoMjkL9asp9TTEwi89Ss&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqweuczBiqhXyBnx9h5Y5jUQhUhf63YQV_61WhU0hZ3A&oe=6AB933EC"}, {"file_name": "screenshot_21.png", "id": "1681709422921940", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499624656_1681709426255273_1572262595466382038_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tEFBFJPQoWQQ7kNvwHcGaFt&_nc_oc=AdpH-GtQHCt0UBok-k_bBS1iGkYI-7CBzcqxV7FTBGzau8A4sNy_zxEPuFvD4wrTveU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITpWkGmdsXFeg7miijdnLdD9-NOLZMKNseTCwje6SFlw&oe=6AB935AF"}, {"file_name": "screenshot_24.png", "id": "1801321804618177", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499628456_1801321807951510_754947562919542977_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X5wGAOZu-kgQ7kNvwFnyl6B&_nc_oc=Adq-EXhkaedABu6P7lSSeXkzR954MAjc8Wo1euwlcvoSi3qFWkpzJPsPxOxUsm0ncZ0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfVCYSkLnNRkdvv50vmQZR4vsJVo4do6Ch1EdEoY0vXA&oe=6AB930CB"}, {"file_name": "screenshot_25.png", "id": "1692023955232390", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620559_1692023958565723_8506211122184864608_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kd71lLVRDTUQ7kNvwHMXj6t&_nc_oc=AdpwJOj1KmFOBzvrS2UTt8bV-d_gcdnzDZuQp2y9wRSJc4imTTZ_x147wmASUwEQFxo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJV3KmQ9zP04bjlrw3WsPitxLROWIbi0cfrwP6f0qOLRw&oe=6AB93B5E"}, {"file_name": "screenshot_26.png", "id": "3393168994198951", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499627502_3393168997532284_4012274785949412253_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tvMKAX5O6xcQ7kNvwEiAjND&_nc_oc=AdrTRStEeVKLqhTAP-G4twn2wiIppLTb1tzS8R7XLOndskPJYV8FWGS6fQH6mehIZMI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIs-esAEbP4lazeKEhxDG3deq8P0yjLf6Ml0loG8q9xyA&oe=6AB932B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "title.png", "id": "1097778122900602", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593761155_1097778126233935_3172726427822974132_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4gOCCuxw7h0Q7kNvwFSD6dy&_nc_oc=AdpY9pMEnU05cJnzKNmJCh5S7v966hrH7k15yAJPvUagXn5GFM4c6BnED6NPPxH8GkY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILbZlkJHOn736GkCwKQyiB9x4Hyo3li_YmulyIBEQU2A&oe=6AB92B7E"}, "display_name": "Media Review", "keywords": ["creative", "review", "videos", "collaborative", "multiplayer"], "long_description": "**Media Review** is a collaborative VR video review tool for the Meta Quest. Watch footage together in real-time with frame-accurate synced playback across user headsets.\n\n## **FRAME .IO INTEGRATION**\nBrowse your Frame projects, download assets directly to your headset, and create shared review rooms. Post timestamped comments and draw annotations on-screen \u2014 all synced back to Frame.io.\n\n## **SYNCED MULTIPLAYER**\nUp to 16 participants watch simultaneously with sub-second sync. Hosts control playback and guest permissions. Built-in voice chat keeps the conversation going, and networked laser pointers let everyone point at what matters.\n\n## **PROFESSIONAL TRANSPORT**\nSingle-frame stepping, jog scrub via thumb stick, and three timecode formats (standard, frame count, SMPTE). Adjustable playback speed and playlist support with drag-to-reorder.\n\n## **STEREOSCOPIC PLAYBACK**\nSupports rectilinear, 180 and 360 (all in mono and stereo, both over under and side-by-side).", "short_description": "Review videos together in VR! Media Review syncs playback across all headsets so teams can watch, discuss, and annotate content simultaneously \u2014 whether streaming from Frame.io or playing local files.\n\n- Frame.io integration - downloads, comments and drawn annotations\n- Synced playback (for up to 20 users)\n- Image Controls - like color, convergence and crop controls\n- Frame-accurate transport with SMPTE timecode\n- Voice chat and networked laser pointer\n- Speech-to-text notes with timecode stamps"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.facebook.com/privacy/policy/", "developer_terms_of_service_url": null, "publisher_name": "Meta RLE", "support_website_url": null, "website_url": "https://watchparty.cf.metafb.cloud/site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP", "MULTI_USER", "MULTI_USER", "SINGLE_USER", "MULTI_USER"], "id": "35465330823115185"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/596068480_2159290284801075_3621950447675314003_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7H1nIrGX-MEQ7kNvwGLEfXl&_nc_oc=AdqYyNIC01kskeXrFr2V_Ohn-uDMAT84pbqXVyf-UpcldZABaawnoBw-eCuxUvNZwOk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJBeYryJzACFJ-ryd-GGFvua-OzkGVCg2yQZExuSB6vLw&oe=6AB90D29"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Media Review", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_
4.5771-25/756589809_1854770799221808_5220201105006514773_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VKg_SBS6HFMQ7kNvwHcyuN0&_nc_oc=AdpRQykJaoRRm_RZtf_hIXpsT-Q8YRvIMWyhlOmUD3rVKIxXaIMN12_dbhP3IT_X-Lg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSm-325TwfPBQDkBPW2uBDWrYwm2Ve3EjLpDfqyWRDk5Q&oe=6AF8A8F7"}, {"file_name": "void_01_00_02_17.png", "id": "1121422300419901", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/595129854_1121422303753234_6555510923288677606_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=huQoionEI6oQ7kNvwGfCEw9&_nc_oc=AdrC6drJcCEZraAxVaQndoUQSIzQ3Hyq7qT1Ue1_tTa5exGawVyQLD43UQMd36vg3po&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQs_ELxKt1GoGTpiSUDZ_wPJHKSeP6vuh5ZNJ-2wYcew&oe=6AF878E4"}, {"file_name": "com_00_01_12_19.png", "id": "1603985808130759", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673531334_1603985811464092_3861902782037551871_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S4jMaJanB5AQ7kNvwFeWJlB&_nc_oc=AdorZVEziyAPTdJzRv2UhlQrnXBV9t6MQjrv88l8DJWNDF4KuDt9O03RnqE9BzPQEPU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR14xQWv8tmK-cRTTC2m-lfUPeCzre_fb0yUyLBZ3HESA&oe=6AF8819D"}, {"file_name": "com_00_02_01_03.png", "id": "28493785020272581", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/595119480_28493785023605914_9081470104433155410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y-Qr2vGnLRkQ7kNvwHwFLOV&_nc_oc=AdoY7KeZrBvOUJCF2WQR8bwobh9Q0xJNwmSXgea8N-viO8EFIk1jFmCEUCCAMzwKVJo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjZL0zBzhxOrua-IWev8sFWjTP0sCOC8dNZNEfaZ6IYQ&oe=6AF87FEF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "title.png", "id": "1097778122900602", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593761155_1097778126233935_3172726427822974132_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AzkLxHWB8_cQ7kNvwH7GLtS&_nc_oc=Adq0cjHRlCFALoxwfzULrCi4HTc9DJ0r-CN-v9iz1-1jiKz74ya4oLVhWLJbSvVJsxc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_JNMjoNqbFZeQLJlaqBjlmKFl2ncyhTuqZCOUC8-o5w&oe=6AF8ABBE"}, "display_name": "Media Review", "keywords": ["creative", "review", "videos", "collaborative", "multiplayer"], "long_description": "**Media Review** is a collaborative VR video review tool for the Meta Quest. Watch footage together in real-time with frame-accurate synced playback across user headsets.\n\n## **FRAME .IO INTEGRATION**\nBrowse your Frame projects, download assets directly to your headset, and create shared review rooms. Post timestamped comments and draw annotations on-screen \u2014 all synced back to Frame.io.\n\n## **SYNCED MULTIPLAYER**\nUp to 16 participants watch simultaneously with sub-second sync. Hosts control playback and guest permissions. Built-in voice chat keeps the conversation going, and networked laser pointers let everyone point at what matters.\n\n## **PROFESSIONAL TRANSPORT**\nSingle-frame stepping, jog scrub via thumb stick, and three timecode formats (standard, frame count, SMPTE). Adjustable playback speed and playlist support with drag-to-reorder.\n\n## **STEREOSCOPIC PLAYBACK**\nSupports rectilinear, 180 and 360 (all in mono and stereo, both over under and side-by-side).\n\nMusic: New Life \u2014 Moire \u2014 uppbeat.io \u2014 ECTJR7ZBMUI8LTCZ", "short_description": "Review videos together in VR! Media Review syncs playback across all headsets so teams can watch, discuss, and annotate content simultaneously \u2014 whether streaming from Frame.io or playing local files.\n\n- Frame.io integration - downloads, comments and drawn annotations\n- Synced playback (for up to 20 users)\n- Image Controls - like color, convergence and crop controls\n- Frame-accurate transport with SMPTE timecode\n- Voice chat and networked laser pointer\n- Speech-to-text notes with timecode stamps"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.facebook.com/privacy/policy/", "de
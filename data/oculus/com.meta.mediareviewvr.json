4.5771-25/756589809_1854770799221808_5220201105006514773_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rPS3bKZQ-VIQ7kNvwEdFEYn&_nc_oc=AdrvltaEHKfHI4CvkqDIH7h8kmnqePQyVROqZ7RXUgit6_QgbU58Ovnc8ThVIlyCgZI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPBQ8qUQQAnbEKSSQ7DcQB5WIXtnNve7lfS7_N-N2Xo6Q&oe=6AD386B7"}, {"file_name": "void_01_00_02_17.png", "id": "1121422300419901", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/595129854_1121422303753234_6555510923288677606_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lXIBBMfy5eUQ7kNvwEbBmw1&_nc_oc=AdoQVfeMUMKoFmyq5cjxcJ5rRGAqr_jn06uT31t4JGWfCMaMFME8tyWOmjLOxQ-IEAM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMeojhWMlZ98dOgaTMZUv9laEheMLEOOWM4rUO3deb5mw&oe=6AD38EE4"}, {"file_name": "com_00_01_12_19.png", "id": "1603985808130759", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/673531334_1603985811464092_3861902782037551871_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jz9eANrUdNEQ7kNvwHDRVuM&_nc_oc=AdpGpC6Tky9mmDVBgUusKakMc7P9VWOeLl_d_0dYsm9ugsKWfj5OkJCZGN7SIvgZQQI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMalSL1zpFxmxKZlyvimUyk_KGIdRC9kcKJV9Tt5rM-ew&oe=6AD3979D"}, {"file_name": "com_00_02_01_03.png", "id": "28493785020272581", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/595119480_28493785023605914_9081470104433155410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JHcNKkq7flgQ7kNvwHhZMx2&_nc_oc=AdoN7RemudZ-Qu7epj88GwP9TH_jpkKjm7nAOpPQn2QIQ64yJxlRAuzSdPbQhpsaHQ4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN7wd87v_rV6tBEhYJ5sQVpT6juqY9wOKpo-80BLBQNKQ&oe=6AD395EF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "title.png", "id": "1097778122900602", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/593761155_1097778126233935_3172726427822974132_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RGRqr6njZkkQ7kNvwHKE6lY&_nc_oc=AdrF9Ke_4p72ud8fZTstHC0a6mxIlndxSxVKoMYPOHT7KmXNwXPzoCoi_iudx-ctRf4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOAd3_YSMaMHWL9xMZzIWZMGv77Sb-4_zmup-hc8HJFVA&oe=6AD3897E"}, "display_name": "Media Review", "keywords": ["creative", "review", "videos", "collaborative", "multiplayer"], "long_description": "**Media Review** is a collaborative VR video review tool for the Meta Quest. Watch footage together in real-time with frame-accurate synced playback across user headsets.\n\n## **FRAME .IO INTEGRATION**\nBrowse your Frame projects, download assets directly to your headset, and create shared review rooms. Post timestamped comments and draw annotations on-screen \u2014 all synced back to Frame.io.\n\n## **SYNCED MULTIPLAYER**\nUp to 16 participants watch simultaneously with sub-second sync. Hosts control playback and guest permissions. Built-in voice chat keeps the conversation going, and networked laser pointers let everyone point at what matters.\n\n## **PROFESSIONAL TRANSPORT**\nSingle-frame stepping, jog scrub via thumb stick, and three timecode formats (standard, frame count, SMPTE). Adjustable playback speed and playlist support with drag-to-reorder.\n\n## **STEREOSCOPIC PLAYBACK**\nSupports rectilinear, 180 and 360 (all in mono and stereo, both over under and side-by-side).\n\nMusic: New Life \u2014 Moire \u2014 uppbeat.io \u2014 ECTJR7ZBMUI8LTCZ", "short_description": "Review videos together in VR! Media Review syncs playback across all headsets so teams can watch, discuss, and annotate content simultaneously \u2014 whether streaming from Frame.io or playing local files.\n\n- Frame.io integration - downloads, comments and drawn annotations\n- Synced playback (for up to 20 users)\n- Image Controls - like color, convergence and crop controls\n- Frame-accurate transport with SMPTE timecode\n- Voice chat and networked laser pointer\n- Speech-to-text notes with timecode stamps"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.facebook.com/privacy/policy/", "de
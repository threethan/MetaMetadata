64.5771-25/756589809_1854770799221808_5220201105006514773_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5YKcaQl619MQ7kNvwEDOEeM&_nc_oc=AdrkHrBuuH-I0UNf0h7qLxUr9EScnmN9nHyFTe0LVRJPBlAX77gH1F3qy_58CaliKmA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN4gdj5EeRez1J-W_-Rbz2-wsJt3O9W2zjMkcP6PhLkDw&oe=6AC8FAB7"}, {"file_name": "void_01_00_02_17.png", "id": "1121422300419901", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/595129854_1121422303753234_6555510923288677606_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e4IV8u7EZjMQ7kNvwH0XqgX&_nc_oc=AdrdhLtk4FTZ5MFLUn4ybtg2V8Zq0zhOMnXlfTBLk_sBWQA2J-kHobwzSKk0wRQpjFA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMkjWh4Fl5e7f3vobYHQTiyRlYcWKs0yvPdAY5hmmdbpA&oe=6AC902E4"}, {"file_name": "com_00_01_12_19.png", "id": "1603985808130759", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/673531334_1603985811464092_3861902782037551871_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KfJfGfPndnYQ7kNvwF6GPNL&_nc_oc=Adq0OH4QmUmhF_HpLTHZDeazbklA3frKbiZbagJfP02He3HLOs0QZtlqCPTm5KfzqR8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOIITNLWxgZOrgGkR35cYweju44cRuCIZZQL4O_Xwkwug&oe=6AC90B9D"}, {"file_name": "com_00_02_01_03.png", "id": "28493785020272581", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/595119480_28493785023605914_9081470104433155410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WWXrGlHXxrMQ7kNvwFTOMzr&_nc_oc=AdrXYE1P-wmXup3yvj-gqrq9A_qBsPFo-SMMTiyXaaKjjZ0WeP21VHVxPDdK-Jc4fNc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOyPFATCiY_nnMGTwaBY-EXoT-xEiPlVeWX9yMxtGW2IA&oe=6AC909EF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "title.png", "id": "1097778122900602", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/593761155_1097778126233935_3172726427822974132_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-TZ-7MBjvXkQ7kNvwGQavTg&_nc_oc=Adq67ByqnRLnZ3Yhd9n7GV-EcsbnZAWAdYExDGRzwzeh_kwsXawI7X9gvqSUIvtDCZg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPWdhSRZ795k5oan6xE7kBcaTarSl5qu7qLslacxhMKIQ&oe=6AC8FD7E"}, "display_name": "Media Review", "keywords": ["creative", "review", "videos", "collaborative", "multiplayer"], "long_description": "**Media Review** is a collaborative VR video review tool for the Meta Quest. Watch footage together in real-time with frame-accurate synced playback across user headsets.\n\n## **FRAME .IO INTEGRATION**\nBrowse your Frame projects, download assets directly to your headset, and create shared review rooms. Post timestamped comments and draw annotations on-screen \u2014 all synced back to Frame.io.\n\n## **SYNCED MULTIPLAYER**\nUp to 16 participants watch simultaneously with sub-second sync. Hosts control playback and guest permissions. Built-in voice chat keeps the conversation going, and networked laser pointers let everyone point at what matters.\n\n## **PROFESSIONAL TRANSPORT**\nSingle-frame stepping, jog scrub via thumb stick, and three timecode formats (standard, frame count, SMPTE). Adjustable playback speed and playlist support with drag-to-reorder.\n\n## **STEREOSCOPIC PLAYBACK**\nSupports rectilinear, 180 and 360 (all in mono and stereo, both over under and side-by-side).", "short_description": "Review videos together in VR! Media Review syncs playback across all headsets so teams can watch, discuss, and annotate content simultaneously \u2014 whether streaming from Frame.io or playing local files.\n\n- Frame.io integration - downloads, comments and drawn annotations\n- Synced playback (for up to 20 users)\n- Image Controls - like color, convergence and crop controls\n- Frame-accurate transport with SMPTE timecode\n- Voice chat and networked laser pointer\n- Speech-to-text notes with timecode stamps"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.facebook.com/privacy/policy/", "developer_terms_of_service_url": null, "publisher_name": "Meta RLE", "suppo
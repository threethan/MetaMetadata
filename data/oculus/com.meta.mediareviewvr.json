958565723_8506211122184864608_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GXrwGf0XsPsQ7kNvwHKmX9Z&_nc_oc=Ado8QeHYnT2EMHCbWRf0D5XxgXI_7H3H-ynslizNYzmymiQQnzlIjwzN_IAEcp4aCPk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdg8C3hlY1fePiFr8EfNTpfWRJWuE80-Yugfgt4l3F6w&oe=6AB3F55E"}, {"file_name": "screenshot_26.png", "id": "3393168994198951", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499627502_3393168997532284_4012274785949412253_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DrYZM1cq2jUQ7kNvwEKLUEG&_nc_oc=AdqvPW8BzFf7kI-8NnmmLC7eJW_uE8pZazrDN9GoSEWiO1NztIn-U7WpNXRv6DNT_J0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIaopsfB6Gs21Di0g2oepvwki_rEWo10AH1O3BF_j8diA&oe=6AB3ECB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "title.png", "id": "1097778122900602", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593761155_1097778126233935_3172726427822974132_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WrGvqbhR1hkQ7kNvwGiRvf6&_nc_oc=Adpo7wOPVsbFgUJ3Tx_gXleu-pi7PMa5lbQAl9sa4xgUYn7yl4mTR3509_jwr8TWFPM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKznJ9dFjr1l66CE7HqskruNZXkZOdSaQIknRC506t3EQ&oe=6AB3E57E"}, "display_name": "Media Review", "keywords": ["creative", "review", "videos", "collaborative", "multiplayer"], "long_description": "**Media Review** is a collaborative VR video review tool for the Meta Quest. Watch footage together in real-time with frame-accurate synced playback across user headsets.\n\n## **FRAME .IO INTEGRATION**\nBrowse your Frame projects, download assets directly to your headset, and create shared review rooms. Post timestamped comments and draw annotations on-screen \u2014 all synced back to Frame.io.\n\n## **SYNCED MULTIPLAYER**\nUp to 16 participants watch simultaneously with sub-second sync. Hosts control playback and guest permissions. Built-in voice chat keeps the conversation going, and networked laser pointers let everyone point at what matters.\n\n## **PROFESSIONAL TRANSPORT**\nSingle-frame stepping, jog scrub via thumb stick, and three timecode formats (standard, frame count, SMPTE). Adjustable playback speed and playlist support with drag-to-reorder.\n\n## **STEREOSCOPIC PLAYBACK**\nSupports rectilinear, 180 and 360 (all in mono and stereo, both over under and side-by-side).", "short_description": "Review videos together in VR! Media Review syncs playback across all headsets so teams can watch, discuss, and annotate content simultaneously \u2014 whether streaming from Frame.io or playing local files.\n\n- Frame.io integration - downloads, comments and drawn annotations\n- Synced playback (for up to 20 users)\n- Image Controls - like color, convergence and crop controls\n- Frame-accurate transport with SMPTE timecode\n- Voice chat and networked laser pointer\n- Speech-to-text notes with timecode stamps"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.facebook.com/privacy/policy/", "developer_terms_of_service_url": null, "publisher_name": "Meta RLE", "support_website_url": null, "website_url": "https://watchparty.cf.metafb.cloud/site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP", "MULTI_USER", "MULTI_USER", "SINGLE_USER", "MULTI_USER"], "id": "35465330823115185"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "4591072211104835"}]}, "baseline_offer": {"id": "4591072211104835"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1789495200, "status": "PUBLISHED", "id": "4591072211104835"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "38597546099893626", "version": "1.1.0.4"}, "id": "1996623474293628", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "35465330793115188", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "38597546099893626"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1789770214, "id": "38598230183158551", "version": "1.1.0.4-dev", "version_code": 278, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "35465330793115188", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "38597546099893626"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1996623474293628"}]}, "change_log": "Media Review 1.1\n\nNew\n- Reviewers you invite by email can now leave comments and draw annotations! Their comments show up in the room straight away, but whoever created the review must approve them to have them post to the asset \u2014 new comment approval workflows are shown in app and on the Media Review website scheduler page.\n- Start a new review from one you have already run. It brings the same media across, so you do not have to pick it all again.\n- Downloads now show speed and an estimate of the time remaining.\n- Scheduled reviews can start on any minute, not just every fifth one.\n\nImproved\n- A Frame.io room now says when it is due to close.\n- Dictation no longer stops mid-sentence, and the panel stays open while the speech model\n  downloads.\n\nFixed\n- The scheduling picker often opened on a time that had already passed, showing the \"select a time in the future\" message.\n- Annotating flat video gave you no aim dot, so you were drawing blind.\n- Download UX flow and downloaded state accuracy for the speech-to-text model.", "created_date": 1789767422, "id": "38597546099893626", "version": "1.1.0.4", "version_code": 277, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "35465330793115188", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "38597546099893626"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1789767106, "id": "38597465319901704", "version": "1.1.0.4-beta", "version_code": 276, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "35465330793115188", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "38597546099893626"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 17897667
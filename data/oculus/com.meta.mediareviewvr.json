c=Ado6MphfTR4AhyWYoVFu6fgK2t9c2d5RX_PbLN1yCW6YkdsgCOLT06lasksS6ROCZvs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHiGblN0X54ieM1HHWGE6GR4pLkYtiLuzDlhFkIFhbww&oe=6AFDBECB"}, {"file_name": "screenshot_25.png", "id": "1692023955232390", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620559_1692023958565723_8506211122184864608_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CojrzAcW1xcQ7kNvwFji5KS&_nc_oc=AdpKTyLW1Fg6IgTOJ8UNfGfrgGJHQKCkmtKfkE6VCVM0GpaCsAgPS8xfQE6_5XG9mKg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHRNDMzPwHzQnRJn00GdJW64epD1x3-gfhf12gAopylA&oe=6AFDC95E"}, {"file_name": "screenshot_26.png", "id": "3393168994198951", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499627502_3393168997532284_4012274785949412253_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RhjQArsydrIQ7kNvwG2aw3Y&_nc_oc=Adpd6g4yPP_D7JBgjppMXUUj6Qxh7idn0VY01AejFNooB727BGuUvzEcLlW6vqJekVY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSw0zfQBFY2uPgoy2sXHbgy1bLWBlWWamDU2tPEUdiXoA&oe=6AFDC0B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "title.png", "id": "1097778122900602", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593761155_1097778126233935_3172726427822974132_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y8a20jl1_E4Q7kNvwEeHsF-&_nc_oc=AdoneciWl0zQ2hvYaoUm5hTljagXh6iTJCtXfFiP22ktVo2tUT5nugs9wAlDxY2mwZM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRO2FKQZtNwcnX93Z3I6kaJkNn_CvZKxJgTvovt3rykDA&oe=6AFDB97E"}, "display_name": "Media Review", "keywords": ["creative", "review", "videos", "collaborative", "multiplayer"], "long_description": "**Media Review** is a collaborative VR video review tool for the Meta Quest. Watch footage together in real-time with frame-accurate synced playback across user headsets.\n\n## **FRAME .IO INTEGRATION**\nBrowse your Frame projects, download assets directly to your headset, and create shared review rooms. Post timestamped comments and draw annotations on-screen \u2014 all synced back to Frame.io.\n\n## **SYNCED MULTIPLAYER**\nUp to 16 participants watch simultaneously with sub-second sync. Hosts control playback and guest permissions. Built-in voice chat keeps the conversation going, and networked laser pointers let everyone point at what matters.\n\n## **PROFESSIONAL TRANSPORT**\nSingle-frame stepping, jog scrub via thumb stick, and three timecode formats (standard, frame count, SMPTE). Adjustable playback speed and playlist support with drag-to-reorder.\n\n## **STEREOSCOPIC PLAYBACK**\nSupports rectilinear, 180 and 360 (all in mono and stereo, both over under and side-by-side).", "short_description": "Review videos together in VR! Media Review syncs playback across all headsets so teams can watch, discuss, and annotate content simultaneously \u2014 whether streaming from Frame.io or playing local files.\n\n- Frame.io integration - downloads, comments and drawn annotations\n- Synced playback (for up to 20 users)\n- Image Controls - like color, convergence and crop controls\n- Frame-accurate transport with SMPTE timecode\n- Voice chat and networked laser pointer\n- Speech-to-text notes with timecode stamps"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.facebook.com/privacy/policy/", "developer_terms_of_service_url": null, "publisher_name": "Meta RLE", "support_website_url": null, "website_url": "https://watchparty.cf.metafb.cloud/site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphi
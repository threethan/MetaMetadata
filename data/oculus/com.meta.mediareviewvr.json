4.5771-25/756589809_1854770799221808_5220201105006514773_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o2mdU4lBaFoQ7kNvwFkISDB&_nc_oc=AdpdtvykrL2ZdHgjVfYQpQ71HS8n9IBnSle-f6e_x96IGbJAfSqoecJ7iWyIaTzgAik&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZXc86CF5gsqa6O6FoIeKwXmhmFvQ9BjTrmBZ9Or5mSQ&oe=6ACB9DB7"}, {"file_name": "void_01_00_02_17.png", "id": "1121422300419901", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/595129854_1121422303753234_6555510923288677606_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EqhOGtMZe3YQ7kNvwGa4bOR&_nc_oc=Adp3XLaDj-yqlzX-_dJYJQ5T1BiYl0hlMwuNLgy0PKWmZv8iKMR4Noev63MKD43VT3Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMRXhbJ_Ne9U2ahW9TThVnGFSJ0Wf4IhZ_wHAXYbN5U4Q&oe=6ACBA5E4"}, {"file_name": "com_00_01_12_19.png", "id": "1603985808130759", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673531334_1603985811464092_3861902782037551871_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BBQCzxWQyV4Q7kNvwG4qhPH&_nc_oc=AdrGTs6u9_OVPpaG_VWgRNUGXwzKcNU0tIIE3w04nqIYX2qHgeyrWxYqPaX2ln-9fi4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjRmFKbH5I5vgksrIMRUYQgu4eyw1vOKlwctpGZdh8HA&oe=6ACBAE9D"}, {"file_name": "com_00_02_01_03.png", "id": "28493785020272581", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/595119480_28493785023605914_9081470104433155410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yEEBX7anD38Q7kNvwEna0nu&_nc_oc=AdoAMXVzFwp0U8l1FBV3V0i27_jiNELFWKMoKnZPpJfZalwuUqFGAHAQR6doAURmG-g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOHkwnPcgvRjexz-3CO0kAZTdUvchm-TCwJRRVLAtzKKg&oe=6ACBACEF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "title.png", "id": "1097778122900602", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593761155_1097778126233935_3172726427822974132_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gbKqPEVjUS8Q7kNvwGek4Ba&_nc_oc=AdpoY-1lmQ--UFfS5a_kMm7WPw1yYfttYD0gi926FdJfP1uEl3RzNoGFRwcW_M525lw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPALSSpBHmp6Xyb7M7PJguMOleyX4p13-P4Fkkua4z5hg&oe=6ACBA07E"}, "display_name": "Media Review", "keywords": ["creative", "review", "videos", "collaborative", "multiplayer"], "long_description": "**Media Review** is a collaborative VR video review tool for the Meta Quest. Watch footage together in real-time with frame-accurate synced playback across user headsets.\n\n## **FRAME .IO INTEGRATION**\nBrowse your Frame projects, download assets directly to your headset, and create shared review rooms. Post timestamped comments and draw annotations on-screen \u2014 all synced back to Frame.io.\n\n## **SYNCED MULTIPLAYER**\nUp to 16 participants watch simultaneously with sub-second sync. Hosts control playback and guest permissions. Built-in voice chat keeps the conversation going, and networked laser pointers let everyone point at what matters.\n\n## **PROFESSIONAL TRANSPORT**\nSingle-frame stepping, jog scrub via thumb stick, and three timecode formats (standard, frame count, SMPTE). Adjustable playback speed and playlist support with drag-to-reorder.\n\n## **STEREOSCOPIC PLAYBACK**\nSupports rectilinear, 180 and 360 (all in mono and stereo, both over under and side-by-side).\n\nMusic: New Life \u2014 Moire \u2014 uppbeat.io \u2014 ECTJR7ZBMUI8LTCZ", "short_description": "Review videos together in VR! Media Review syncs playback across all headsets so teams can watch, discuss, and annotate content simultaneously \u2014 whether streaming from Frame.io or playing local files.\n\n- Frame.io integration - downloads, comments and drawn annotations\n- Synced playback (for up to 20 users)\n- Image Controls - like color, convergence and crop controls\n- Frame-accurate transport with SMPTE timecode\n- Voice chat and networked laser pointer\n- Speech-to-text notes with timecode stamps"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.facebook.com/privacy/policy/", "de
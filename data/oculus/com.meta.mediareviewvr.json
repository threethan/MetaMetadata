4.5771-25/756589809_1854770799221808_5220201105006514773_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HMIHYKfuk0wQ7kNvwFZl7A6&_nc_oc=AdoNr-_ZugUBkUH0kXYrZfhb5VvHfla00mWFmicN91YlyH4W6VX2ht8Isdni35lqYi0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZ36aNaMDIj_3YQJxcaSOP57DrW9a6C_uV-32mssQ1fw&oe=6AEB41B7"}, {"file_name": "void_01_00_02_17.png", "id": "1121422300419901", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/595129854_1121422303753234_6555510923288677606_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pmLSmJYE5goQ7kNvwEviX90&_nc_oc=Adqq-m9ynZbgUhMRuo7ICmc7uW1peH121siJVi6H7vP55ZvwXV28WW1d67i2mXDYfUA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTV_PDLPRdarDdPQpyuKp5m7mvR4-bJuGMKLHojnTdBHg&oe=6AEB49E4"}, {"file_name": "com_00_01_12_19.png", "id": "1603985808130759", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/673531334_1603985811464092_3861902782037551871_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FTwLSLAqyu4Q7kNvwHgWU64&_nc_oc=AdoPNlUJ0Snb3Gx9xENqHY3MEZD2NC5kI17QzsgU2U6S-v4SYvGDixHAyZqGLWOWJ3A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwasMEI5g5JSHl-W5gFtLKUauRbGgVMcYsmBnp1-KQMA&oe=6AEB529D"}, {"file_name": "com_00_02_01_03.png", "id": "28493785020272581", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/595119480_28493785023605914_9081470104433155410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=umZzbifb7aMQ7kNvwGLJzoe&_nc_oc=AdoRZ2cvtPSbOsQlRtjivplhOonO4nI2A1ZXlC32XL0XfY8r2EB4cZ7CgGsuq4mk7Tc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrXz88h6J0lAr9d1bTAAbtM1AeSU2X6IDNlAaqDToGzg&oe=6AEB50EF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "title.png", "id": "1097778122900602", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/593761155_1097778126233935_3172726427822974132_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FHwfB0RweUsQ7kNvwFZcLNv&_nc_oc=AdqYF9nNIqW9NTOIJykN64fnkZICZgiLdK0j8l-vtsQmvGFRLw6dlU27TbmZps82mIM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDKsApTlZAjMVREJIoJIMDYgCKqgIn2XG3Wb_ZPkmZSA&oe=6AEB447E"}, "display_name": "Media Review", "keywords": ["creative", "review", "videos", "collaborative", "multiplayer"], "long_description": "**Media Review** is a collaborative VR video review tool for the Meta Quest. Watch footage together in real-time with frame-accurate synced playback across user headsets.\n\n## **FRAME .IO INTEGRATION**\nBrowse your Frame projects, download assets directly to your headset, and create shared review rooms. Post timestamped comments and draw annotations on-screen \u2014 all synced back to Frame.io.\n\n## **SYNCED MULTIPLAYER**\nUp to 16 participants watch simultaneously with sub-second sync. Hosts control playback and guest permissions. Built-in voice chat keeps the conversation going, and networked laser pointers let everyone point at what matters.\n\n## **PROFESSIONAL TRANSPORT**\nSingle-frame stepping, jog scrub via thumb stick, and three timecode formats (standard, frame count, SMPTE). Adjustable playback speed and playlist support with drag-to-reorder.\n\n## **STEREOSCOPIC PLAYBACK**\nSupports rectilinear, 180 and 360 (all in mono and stereo, both over under and side-by-side).\n\nMusic: New Life \u2014 Moire \u2014 uppbeat.io \u2014 ECTJR7ZBMUI8LTCZ", "short_description": "Review videos together in VR! Media Review syncs playback across all headsets so teams can watch, discuss, and annotate content simultaneously \u2014 whether streaming from Frame.io or playing local files.\n\n- Frame.io integration - downloads, comments and drawn annotations\n- Synced playback (for up to 20 users)\n- Image Controls - like color, convergence and crop controls\n- Frame-accurate transport with SMPTE timecode\n- Voice chat and networked laser pointer\n- Speech-to-text notes with timecode stamps"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.facebook.com/privacy/policy/", "de
4.5771-25/756589809_1854770799221808_5220201105006514773_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xOAUaDXkABIQ7kNvwEbuMB0&_nc_oc=AdqvP6yyW9iq4eiQd5Klm4Y7X9_Ol-bIKMK8lx6Nzp44ThONw3yFGZz_yNnQPUwtCxc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzeCTwdDr14abSlaHkZK0i6YwGfbyCzKGO4XULXMeqyA&oe=6AE89EB7"}, {"file_name": "void_01_00_02_17.png", "id": "1121422300419901", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/595129854_1121422303753234_6555510923288677606_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dj7j9-7u3tsQ7kNvwEBGz8Y&_nc_oc=Adqw24I6uNs5BYt3gPnmpg_gTWpPet7uLaWKaivk57Eui3ALzc8TgiQm5GxhkanI9c8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8QRZy0Feni7WrT808vYZdrbkiEuPoCSX6gn7x0BWxtw&oe=6AE8A6E4"}, {"file_name": "com_00_01_12_19.png", "id": "1603985808130759", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/673531334_1603985811464092_3861902782037551871_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TgJG-NPrgfgQ7kNvwGtTRP_&_nc_oc=AdpU2IY84qTyrMXiC8nuN2ipaEBI4m3GfbEpuDqoCMXfnlfEe-Zx1010VgETzaTQAlM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWjZnOCdIvdPteXD64-ngHrl6RINJ5y_nOy5zh9ZaZNA&oe=6AE8AF9D"}, {"file_name": "com_00_02_01_03.png", "id": "28493785020272581", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/595119480_28493785023605914_9081470104433155410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6m_J8GWY2DoQ7kNvwH6EXF-&_nc_oc=AdrC6QATJYPTC-a8xhBknNFjDkWvn3TDoyqjoOSsA1Zcdz1_dxJCMw9tknYDTCyOCA4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQyoUGL0grXvIohmkkalfgdmO8l2KcuNZNip5eD3YKVxA&oe=6AE8ADEF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "title.png", "id": "1097778122900602", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/593761155_1097778126233935_3172726427822974132_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KjF7tg9LHsYQ7kNvwHpNXc0&_nc_oc=AdpxvMK0uh3fd25XDQqfxYvaUlGJZQfK_cv-VS8IEWOjlA0iHPJqgbW44Gp3XNrh6Ps&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLgnlbXJkSY0bPVgjyDnmppB41ardYpIbiIzcvC6ETMg&oe=6AE8A17E"}, "display_name": "Media Review", "keywords": ["creative", "review", "videos", "collaborative", "multiplayer"], "long_description": "**Media Review** is a collaborative VR video review tool for the Meta Quest. Watch footage together in real-time with frame-accurate synced playback across user headsets.\n\n## **FRAME .IO INTEGRATION**\nBrowse your Frame projects, download assets directly to your headset, and create shared review rooms. Post timestamped comments and draw annotations on-screen \u2014 all synced back to Frame.io.\n\n## **SYNCED MULTIPLAYER**\nUp to 16 participants watch simultaneously with sub-second sync. Hosts control playback and guest permissions. Built-in voice chat keeps the conversation going, and networked laser pointers let everyone point at what matters.\n\n## **PROFESSIONAL TRANSPORT**\nSingle-frame stepping, jog scrub via thumb stick, and three timecode formats (standard, frame count, SMPTE). Adjustable playback speed and playlist support with drag-to-reorder.\n\n## **STEREOSCOPIC PLAYBACK**\nSupports rectilinear, 180 and 360 (all in mono and stereo, both over under and side-by-side).\n\nMusic: New Life \u2014 Moire \u2014 uppbeat.io \u2014 ECTJR7ZBMUI8LTCZ", "short_description": "Review videos together in VR! Media Review syncs playback across all headsets so teams can watch, discuss, and annotate content simultaneously \u2014 whether streaming from Frame.io or playing local files.\n\n- Frame.io integration - downloads, comments and drawn annotations\n- Synced playback (for up to 20 users)\n- Image Controls - like color, convergence and crop controls\n- Frame-accurate transport with SMPTE timecode\n- Voice chat and networked laser pointer\n- Speech-to-text notes with timecode stamps"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.facebook.com/privacy/policy/", "de
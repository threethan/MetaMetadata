4.5771-25/756589809_1854770799221808_5220201105006514773_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xOAUaDXkABIQ7kNvwG623fS&_nc_oc=AdoVRRBhFd316m9nLUGzfriTCeupnAfGzCXUO0uOoClM7BhZDk6UtwzNkPNoMiZ4pPA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvcQMHyjlfENzSBx0vwUhfi2yc1z7VQJdbcedr8rPbSQ&oe=6AE74D37"}, {"file_name": "void_01_00_02_17.png", "id": "1121422300419901", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/595129854_1121422303753234_6555510923288677606_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dj7j9-7u3tsQ7kNvwHBJi-X&_nc_oc=Adqt2G36hoV9nEAfROMbWAh3P6bAb4dCNiFwq8d82gooxs5CtePmUslWrxkdS_mi6Ww&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQeNnuQT1LfWZJ0BInaqu0019odkXGlPr-Lg3-YIfFU-Q&oe=6AE75564"}, {"file_name": "com_00_01_12_19.png", "id": "1603985808130759", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/673531334_1603985811464092_3861902782037551871_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TgJG-NPrgfgQ7kNvwEFfgIN&_nc_oc=AdpoogEs_NmRKjzRSzT5jSPxxI73uXWpjp9TqyBRcnjHyYieFs_V30WPefPZQqwvi40&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0nyY1MUOJLnkoUxmZi9arHrTR0m5KppNBmKG3QLYvRw&oe=6AE75E1D"}, {"file_name": "com_00_02_01_03.png", "id": "28493785020272581", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/595119480_28493785023605914_9081470104433155410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6m_J8GWY2DoQ7kNvwHdrdYf&_nc_oc=AdouMqZSA6PvCtf2A73W65RA6r4k3HyPuoPv4bNEaBzns8qilNMyOk-lyay8FuFrGc4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTekR7Rama5IWYIi3RwZBk44i97e-xfriMhOrgIO2GMew&oe=6AE75C6F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "title.png", "id": "1097778122900602", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/593761155_1097778126233935_3172726427822974132_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KjF7tg9LHsYQ7kNvwG2FWuB&_nc_oc=AdppTyQorfGGhBxbtCpNvCTveOruKRfck5NVAqPwcwIoss2ODGZ1oii1gLIyZ-rLbcs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQi7r1Z17GaoGhTthmyNkU2ED-lqNPEueGxDbry--pbNQ&oe=6AE74FFE"}, "display_name": "Media Review", "keywords": ["creative", "review", "videos", "collaborative", "multiplayer"], "long_description": "**Media Review** is a collaborative VR video review tool for the Meta Quest. Watch footage together in real-time with frame-accurate synced playback across user headsets.\n\n## **FRAME .IO INTEGRATION**\nBrowse your Frame projects, download assets directly to your headset, and create shared review rooms. Post timestamped comments and draw annotations on-screen \u2014 all synced back to Frame.io.\n\n## **SYNCED MULTIPLAYER**\nUp to 16 participants watch simultaneously with sub-second sync. Hosts control playback and guest permissions. Built-in voice chat keeps the conversation going, and networked laser pointers let everyone point at what matters.\n\n## **PROFESSIONAL TRANSPORT**\nSingle-frame stepping, jog scrub via thumb stick, and three timecode formats (standard, frame count, SMPTE). Adjustable playback speed and playlist support with drag-to-reorder.\n\n## **STEREOSCOPIC PLAYBACK**\nSupports rectilinear, 180 and 360 (all in mono and stereo, both over under and side-by-side).\n\nMusic: New Life \u2014 Moire \u2014 uppbeat.io \u2014 ECTJR7ZBMUI8LTCZ", "short_description": "Review videos together in VR! Media Review syncs playback across all headsets so teams can watch, discuss, and annotate content simultaneously \u2014 whether streaming from Frame.io or playing local files.\n\n- Frame.io integration - downloads, comments and drawn annotations\n- Synced playback (for up to 20 users)\n- Image Controls - like color, convergence and crop controls\n- Frame-accurate transport with SMPTE timecode\n- Voice chat and networked laser pointer\n- Speech-to-text notes with timecode stamps"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.facebook.com/privacy/policy/", "de
4.5771-25/756589809_1854770799221808_5220201105006514773_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YZaBC3ovSSgQ7kNvwFSUL3q&_nc_oc=Adr_MMPty_e-gs0ZHagBzYypTx0pXrnjqc9pmOJpJ4Y4s3_KYs11c_mtThMwXxI4fxI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTomZ4Y3GiI3MAc5_8u1byTbglMRgAgmwfFE0vY0sWzfg&oe=6AF32AB7"}, {"file_name": "void_01_00_02_17.png", "id": "1121422300419901", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/595129854_1121422303753234_6555510923288677606_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5jqif8LI-7oQ7kNvwEo7yzn&_nc_oc=AdpDsJ7jg3oZ5cGLcJVL5zF0r3N7G_-8YSlXmKuV0gOtmsGQU-VOCpauHaYdlPN_5Ak&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDZI4bY7fS76ICSO_G5ko4OK6q-69p8kvWVR5FjU24Sw&oe=6AF332E4"}, {"file_name": "com_00_01_12_19.png", "id": "1603985808130759", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673531334_1603985811464092_3861902782037551871_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z-C_0g5o7MgQ7kNvwG8RPb2&_nc_oc=Adr_KS_FLBlC9oiWF61yVPpU3JRwa8ye72gOLp5CUx7XQNMpXlWMf9HCg-Nw7l4tIc0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROApQIHgJCwisSb9h57EHqwEXOiJ46BBIVhWsxbWPi2w&oe=6AF33B9D"}, {"file_name": "com_00_02_01_03.png", "id": "28493785020272581", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/595119480_28493785023605914_9081470104433155410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KBt2Dc9IYdEQ7kNvwGFZ-S4&_nc_oc=Adp4bWFTX5I7TMIsjkfZb3tQIGSOBGrPrxptNPi62Z8ELfbPdTstwBEsTzGgRbPgmMk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_a_7M0u6w4x8jSQFBJwfYM1syOKOqWqTLBX9dKkJIAg&oe=6AF339EF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "title.png", "id": "1097778122900602", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/593761155_1097778126233935_3172726427822974132_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OpMRilgSkAEQ7kNvwEIHHVv&_nc_oc=AdpzQuhbl6s_HNqcXI-HGdJvVssp-QV-Q8m5QiRt-YQqsYyfM2DLMKWgh0qGl0vrDts&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTciZ_1CboNOH96tzPeGhNFuyp4Pi0H4L8K4gLz2l8XlQ&oe=6AF32D7E"}, "display_name": "Media Review", "keywords": ["creative", "review", "videos", "collaborative", "multiplayer"], "long_description": "**Media Review** is a collaborative VR video review tool for the Meta Quest. Watch footage together in real-time with frame-accurate synced playback across user headsets.\n\n## **FRAME .IO INTEGRATION**\nBrowse your Frame projects, download assets directly to your headset, and create shared review rooms. Post timestamped comments and draw annotations on-screen \u2014 all synced back to Frame.io.\n\n## **SYNCED MULTIPLAYER**\nUp to 16 participants watch simultaneously with sub-second sync. Hosts control playback and guest permissions. Built-in voice chat keeps the conversation going, and networked laser pointers let everyone point at what matters.\n\n## **PROFESSIONAL TRANSPORT**\nSingle-frame stepping, jog scrub via thumb stick, and three timecode formats (standard, frame count, SMPTE). Adjustable playback speed and playlist support with drag-to-reorder.\n\n## **STEREOSCOPIC PLAYBACK**\nSupports rectilinear, 180 and 360 (all in mono and stereo, both over under and side-by-side).\n\nMusic: New Life \u2014 Moire \u2014 uppbeat.io \u2014 ECTJR7ZBMUI8LTCZ", "short_description": "Review videos together in VR! Media Review syncs playback across all headsets so teams can watch, discuss, and annotate content simultaneously \u2014 whether streaming from Frame.io or playing local files.\n\n- Frame.io integration - downloads, comments and drawn annotations\n- Synced playback (for up to 20 users)\n- Image Controls - like color, convergence and crop controls\n- Frame-accurate transport with SMPTE timecode\n- Voice chat and networked laser pointer\n- Speech-to-text notes with timecode stamps"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.facebook.com/privacy/policy/", "de
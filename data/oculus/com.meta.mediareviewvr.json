4.5771-25/756589809_1854770799221808_5220201105006514773_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GA9kkXiNaDIQ7kNvwFnN8vE&_nc_oc=AdpzcbkcYs2AJzgth44VPkTfnowF3YYQsl6qRNr0kQg5d0NPUP6UIxTXumllFFhts4Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO6DazRA96RnkurBHT2R_FNwXnCgZd59DSRqygZqX8GdA&oe=6AE20737"}, {"file_name": "void_01_00_02_17.png", "id": "1121422300419901", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/595129854_1121422303753234_6555510923288677606_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pJ32BHPUaZgQ7kNvwG3X72Q&_nc_oc=AdoW1ER3KFtTv2Q0ik-lOOpDFltd8rnEOqtkLnzrXpI0HjcyS5dvA2b77oj6OxBtPqI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPKagnAVdoqUMu2Zeb4flwIVApmrHBg2UPPmGX7zagTQA&oe=6AE20F64"}, {"file_name": "com_00_01_12_19.png", "id": "1603985808130759", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673531334_1603985811464092_3861902782037551871_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jxlvoBnqG0QQ7kNvwFjHVkX&_nc_oc=AdrU-0LhWK49hsguSvea62idcT2ZJ88L2Ir2gioUpn9U9QESSBITFo4obspWiJ5fy1A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_FnnyucG1cd_eaJJKYZ1rAIHKaPCKX5wGlnbHrGVxgA&oe=6AE2181D"}, {"file_name": "com_00_02_01_03.png", "id": "28493785020272581", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/595119480_28493785023605914_9081470104433155410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=357_tIkyBekQ7kNvwHidfdt&_nc_oc=Adq2GP5ZRIECXU3iExuMHBGXJctlEBjH5Xoz1fDIz9Fsnb2Zgqrs1b97PQw3m22UoiE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOnBwHwOz4SQinTkhsn64wK594VAW0l6jDJdnXyhZDHJw&oe=6AE2166F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "title.png", "id": "1097778122900602", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/593761155_1097778126233935_3172726427822974132_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OD7RSzOKKHIQ7kNvwEx_U88&_nc_oc=AdpubvUim1_xhw4Nz2rFII0lpQT3QgcE2U6ADql_tc6aHyu6KRnniNZL63V6MS56yck&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMwpChlx0JYBBMrq14N3fcYEylDFupcvl1haPLwx-4Low&oe=6AE209FE"}, "display_name": "Media Review", "keywords": ["creative", "review", "videos", "collaborative", "multiplayer"], "long_description": "**Media Review** is a collaborative VR video review tool for the Meta Quest. Watch footage together in real-time with frame-accurate synced playback across user headsets.\n\n## **FRAME .IO INTEGRATION**\nBrowse your Frame projects, download assets directly to your headset, and create shared review rooms. Post timestamped comments and draw annotations on-screen \u2014 all synced back to Frame.io.\n\n## **SYNCED MULTIPLAYER**\nUp to 16 participants watch simultaneously with sub-second sync. Hosts control playback and guest permissions. Built-in voice chat keeps the conversation going, and networked laser pointers let everyone point at what matters.\n\n## **PROFESSIONAL TRANSPORT**\nSingle-frame stepping, jog scrub via thumb stick, and three timecode formats (standard, frame count, SMPTE). Adjustable playback speed and playlist support with drag-to-reorder.\n\n## **STEREOSCOPIC PLAYBACK**\nSupports rectilinear, 180 and 360 (all in mono and stereo, both over under and side-by-side).\n\nMusic: New Life \u2014 Moire \u2014 uppbeat.io \u2014 ECTJR7ZBMUI8LTCZ", "short_description": "Review videos together in VR! Media Review syncs playback across all headsets so teams can watch, discuss, and annotate content simultaneously \u2014 whether streaming from Frame.io or playing local files.\n\n- Frame.io integration - downloads, comments and drawn annotations\n- Synced playback (for up to 20 users)\n- Image Controls - like color, convergence and crop controls\n- Frame-accurate transport with SMPTE timecode\n- Voice chat and networked laser pointer\n- Speech-to-text notes with timecode stamps"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.facebook.com/privacy/policy/", "de
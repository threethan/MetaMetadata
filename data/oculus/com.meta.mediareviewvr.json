4.5771-25/756589809_1854770799221808_5220201105006514773_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o2mdU4lBaFoQ7kNvwG6oCHs&_nc_oc=AdrUUICRqMTz6jC2Jo7ICego_pVbMbLu3yLs2f5c5kLfep-Alki5KhvNm-NofeWe4es&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQ6-C8vgI9Y1VRBzEPFAhJR48awl3hVRMrp1EPxJyTKQ&oe=6ACCEF37"}, {"file_name": "void_01_00_02_17.png", "id": "1121422300419901", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/595129854_1121422303753234_6555510923288677606_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EqhOGtMZe3YQ7kNvwGzVhfG&_nc_oc=Adq67Jwq6Wig0QVLGajLSOpM056CMpQzWUjxTopxUqARwi7UAZI7_xl1tiPYxxdz45w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMK70YWReICmMTkTZjVBR3l3MauqV-EGYgFlA03tRxLZg&oe=6ACCF764"}, {"file_name": "com_00_01_12_19.png", "id": "1603985808130759", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/673531334_1603985811464092_3861902782037551871_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BBQCzxWQyV4Q7kNvwFI0rfo&_nc_oc=Adp_2vzh3IAgaz_ErtGN2t3GSknANA2ugMbKj_7zBTEYLigVaX-E5R-lCj43OSzL82k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN-AwkBxysXyT32mswcTgBuAJReUWVd6jewQVit1Jr5cA&oe=6ACD001D"}, {"file_name": "com_00_02_01_03.png", "id": "28493785020272581", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/595119480_28493785023605914_9081470104433155410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yEEBX7anD38Q7kNvwE3lVO6&_nc_oc=Adp_iugKAaVUsqsPLTvatMSE4nWmzvsqXW39RKx82IwGUDqx79sJV9Xm7KtZMC-Nvek&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQHKrNKu8-oucbHS1qS5lzQ4bb4He9p0LJIJsjbwowhg&oe=6ACCFE6F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "title.png", "id": "1097778122900602", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/593761155_1097778126233935_3172726427822974132_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gbKqPEVjUS8Q7kNvwFices-&_nc_oc=Adrbx3STGLQY_jukLsgZwnzCb9NgmArCON7mAZPmryVu3UahmH8su5MFGP0TF2jT-ME&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMxEg5sYoZLXK_9B_1GX9EWpXogq2JexYivwJ2UZz5Qw&oe=6ACCF1FE"}, "display_name": "Media Review", "keywords": ["creative", "review", "videos", "collaborative", "multiplayer"], "long_description": "**Media Review** is a collaborative VR video review tool for the Meta Quest. Watch footage together in real-time with frame-accurate synced playback across user headsets.\n\n## **FRAME .IO INTEGRATION**\nBrowse your Frame projects, download assets directly to your headset, and create shared review rooms. Post timestamped comments and draw annotations on-screen \u2014 all synced back to Frame.io.\n\n## **SYNCED MULTIPLAYER**\nUp to 16 participants watch simultaneously with sub-second sync. Hosts control playback and guest permissions. Built-in voice chat keeps the conversation going, and networked laser pointers let everyone point at what matters.\n\n## **PROFESSIONAL TRANSPORT**\nSingle-frame stepping, jog scrub via thumb stick, and three timecode formats (standard, frame count, SMPTE). Adjustable playback speed and playlist support with drag-to-reorder.\n\n## **STEREOSCOPIC PLAYBACK**\nSupports rectilinear, 180 and 360 (all in mono and stereo, both over under and side-by-side).\n\nMusic: New Life \u2014 Moire \u2014 uppbeat.io \u2014 ECTJR7ZBMUI8LTCZ", "short_description": "Review videos together in VR! Media Review syncs playback across all headsets so teams can watch, discuss, and annotate content simultaneously \u2014 whether streaming from Frame.io or playing local files.\n\n- Frame.io integration - downloads, comments and drawn annotations\n- Synced playback (for up to 20 users)\n- Image Controls - like color, convergence and crop controls\n- Frame-accurate transport with SMPTE timecode\n- Voice chat and networked laser pointer\n- Speech-to-text notes with timecode stamps"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.facebook.com/privacy/policy/", "de
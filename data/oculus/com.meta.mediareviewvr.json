4.5771-25/756589809_1854770799221808_5220201105006514773_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f1SdX4Sr6d4Q7kNvwHydDXN&_nc_oc=AdrKtMimnFarD2Ak6o4yNlw0d2u_FK0Thiol9-cg-2cKHeBD-pc4FgDSNoavNLIDMg0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNO8a8HyMrkq8QO2QXKGbC31xThpB0pkHJ9TxBmBChgmA&oe=6AD0E3B7"}, {"file_name": "void_01_00_02_17.png", "id": "1121422300419901", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/595129854_1121422303753234_6555510923288677606_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zXE0K_EHencQ7kNvwHk_cF6&_nc_oc=AdoEyn3miwJcK2C27CXbJsQzRuw36B9MlGKsQqwK1_IxzJlg5T611wvtZ7tAGId2NpI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxernYldM7eIcztUsRcGykhDIWbi06fMIWteGl49_nfA&oe=6AD0EBE4"}, {"file_name": "com_00_01_12_19.png", "id": "1603985808130759", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/673531334_1603985811464092_3861902782037551871_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nFtAtOpVXvAQ7kNvwHZDFAv&_nc_oc=AdrUKZCMFK6kr7mXKEhmL_hZC3dKtxx4DyTYkslua98P6CihfJ_PzcZis68TbEMXLe0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQObyF_6TC2r8_gz9Avf4YglgB-su86pmzaj_Ltv2Y8wng&oe=6AD0F49D"}, {"file_name": "com_00_02_01_03.png", "id": "28493785020272581", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/595119480_28493785023605914_9081470104433155410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0KLJVLjHvjgQ7kNvwG05avR&_nc_oc=Adp7Yw4o8wTB4GJN6LoaoyG3dF_T6meF9GlR3RdEIkSc-OUOqlEQ4d-Mcth-ZpPu2js&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNK2P2uiKXfms_7PfghGnPv9xI21DuNCiySFPx9v7k2zQ&oe=6AD0F2EF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "title.png", "id": "1097778122900602", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/593761155_1097778126233935_3172726427822974132_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ieCziJtaWb4Q7kNvwHdz24l&_nc_oc=AdpwtuUQcOe46c-hDM5TV59ORBcDNSuxbjyp6191AraKDKqSFdI8JYFUn9j8R7spW8w&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMat0Cvw63TAp8Mwq94bJ22_3qgj_UVI011FACjrzkXhw&oe=6AD0E67E"}, "display_name": "Media Review", "keywords": ["creative", "review", "videos", "collaborative", "multiplayer"], "long_description": "**Media Review** is a collaborative VR video review tool for the Meta Quest. Watch footage together in real-time with frame-accurate synced playback across user headsets.\n\n## **FRAME .IO INTEGRATION**\nBrowse your Frame projects, download assets directly to your headset, and create shared review rooms. Post timestamped comments and draw annotations on-screen \u2014 all synced back to Frame.io.\n\n## **SYNCED MULTIPLAYER**\nUp to 16 participants watch simultaneously with sub-second sync. Hosts control playback and guest permissions. Built-in voice chat keeps the conversation going, and networked laser pointers let everyone point at what matters.\n\n## **PROFESSIONAL TRANSPORT**\nSingle-frame stepping, jog scrub via thumb stick, and three timecode formats (standard, frame count, SMPTE). Adjustable playback speed and playlist support with drag-to-reorder.\n\n## **STEREOSCOPIC PLAYBACK**\nSupports rectilinear, 180 and 360 (all in mono and stereo, both over under and side-by-side).\n\nMusic: New Life \u2014 Moire \u2014 uppbeat.io \u2014 ECTJR7ZBMUI8LTCZ", "short_description": "Review videos together in VR! Media Review syncs playback across all headsets so teams can watch, discuss, and annotate content simultaneously \u2014 whether streaming from Frame.io or playing local files.\n\n- Frame.io integration - downloads, comments and drawn annotations\n- Synced playback (for up to 20 users)\n- Image Controls - like color, convergence and crop controls\n- Frame-accurate transport with SMPTE timecode\n- Voice chat and networked laser pointer\n- Speech-to-text notes with timecode stamps"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.facebook.com/privacy/policy/", "de
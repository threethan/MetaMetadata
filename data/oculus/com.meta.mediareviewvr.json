64.5771-25/756589809_1854770799221808_5220201105006514773_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PgW_wXNkkkIQ7kNvwEXwsZt&_nc_oc=AdplMkNJqtEBAkYWCZQM7UoOoFyGIzgH_0Kfty0_-I4dTHMv803VoE3Nk1JTgiTOmKw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOBf_2mrGWrjHvq3CbKHxAwi6oCgdevDSzrPtC9ZV2-kw&oe=6AC26337"}, {"file_name": "void_01_00_02_17.png", "id": "1121422300419901", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/595129854_1121422303753234_6555510923288677606_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nv8EhM-bOk0Q7kNvwEsDfaK&_nc_oc=AdoRnPeQy-WFEX69JfH7qRB9uNOO2-1vOckZcqqtBDlB2uZprfKocTSwLq-HAUzEwfs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOCADSxtwmbjtIFaNCtOAPlXnrZsNIeuh2LtQTJEU3QtA&oe=6AC26B64"}, {"file_name": "com_00_01_12_19.png", "id": "1603985808130759", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/673531334_1603985811464092_3861902782037551871_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yEIcARgyZEUQ7kNvwGA7aDA&_nc_oc=Adqqie1RzT0fpvkUkSkYRkD4NNgqSTf-oTXD8mf0TiPv74T8g03mg3vkroS9xrDb184&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMP2zjLeookzRFEBI990CS17gzvl_RG6C9-4go1FoMbCA&oe=6AC2741D"}, {"file_name": "com_00_02_01_03.png", "id": "28493785020272581", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/595119480_28493785023605914_9081470104433155410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mrSEYAFa8EIQ7kNvwE5i2rq&_nc_oc=AdpMbFxwBJLGiyIteJ3uF_9AfqlvNxnu55iEe-Xb2XrHcbI3QqbOr0qj9_4xov5x-Y8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMvKOWVi_ibWPPN35hnhK1-2Bi0XALYs7vtF9k0TYtWKQ&oe=6AC2726F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "title.png", "id": "1097778122900602", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/593761155_1097778126233935_3172726427822974132_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cEBkVHHfn2kQ7kNvwEJdWy5&_nc_oc=Adq5QeLObc3YLKLfydERnHBiOGpjDcrRd5JfygLhSzTPbaVAGvCLXuNODh16H52xigc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMjOD0FVd3SwL-BvI8WBVUy5b12Edaaw6GA64MH5erShA&oe=6AC265FE"}, "display_name": "Media Review", "keywords": ["creative", "review", "videos", "collaborative", "multiplayer"], "long_description": "**Media Review** is a collaborative VR video review tool for the Meta Quest. Watch footage together in real-time with frame-accurate synced playback across user headsets.\n\n## **FRAME .IO INTEGRATION**\nBrowse your Frame projects, download assets directly to your headset, and create shared review rooms. Post timestamped comments and draw annotations on-screen \u2014 all synced back to Frame.io.\n\n## **SYNCED MULTIPLAYER**\nUp to 16 participants watch simultaneously with sub-second sync. Hosts control playback and guest permissions. Built-in voice chat keeps the conversation going, and networked laser pointers let everyone point at what matters.\n\n## **PROFESSIONAL TRANSPORT**\nSingle-frame stepping, jog scrub via thumb stick, and three timecode formats (standard, frame count, SMPTE). Adjustable playback speed and playlist support with drag-to-reorder.\n\n## **STEREOSCOPIC PLAYBACK**\nSupports rectilinear, 180 and 360 (all in mono and stereo, both over under and side-by-side).", "short_description": "Review videos together in VR! Media Review syncs playback across all headsets so teams can watch, discuss, and annotate content simultaneously \u2014 whether streaming from Frame.io or playing local files.\n\n- Frame.io integration - downloads, comments and drawn annotations\n- Synced playback (for up to 20 users)\n- Image Controls - like color, convergence and crop controls\n- Frame-accurate transport with SMPTE timecode\n- Voice chat and networked laser pointer\n- Speech-to-text notes with timecode stamps"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.facebook.com/privacy/policy/", "developer_terms_of_service_url": null, "publisher_name": "Meta RLE", "suppo
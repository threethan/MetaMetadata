4.5771-25/756589809_1854770799221808_5220201105006514773_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xmDF1awqHPwQ7kNvwEf9x8M&_nc_oc=Adrr-y3PTXwEoc87W9W4fP3gPZRM25FMLJziwOT3t1pMpU-spP3CMRY7e-5KiQV9FME&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7gIc1wZ0IhUYwekr3iLDP3X3SRFt0joF7AproRRdZmQ&oe=6AF1D937"}, {"file_name": "void_01_00_02_17.png", "id": "1121422300419901", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/595129854_1121422303753234_6555510923288677606_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5jqif8LI-7oQ7kNvwF_v7pW&_nc_oc=AdpjdvHPU9F4RCkuYs0T59BgWns-8IccyAL-3vOfCD8X7CF-wzFjxXKlGCxaTEY9J08&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjaWQJWYvBYjUvP3jCx5zz8En0k69ReFfkv2CRoUipsg&oe=6AF1E164"}, {"file_name": "com_00_01_12_19.png", "id": "1603985808130759", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/673531334_1603985811464092_3861902782037551871_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ubyn61bmIu0Q7kNvwHbWeH_&_nc_oc=AdoGH4ZIhG1WhZWBAotHdHywKTIW-mkVRA6YLDBzCA50fFNFvFvGAogNjeKikS8x9os&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBYu67jI1drZJSYk7PVtySKPhK-51y2S6oepfGJhEpdg&oe=6AF1EA1D"}, {"file_name": "com_00_02_01_03.png", "id": "28493785020272581", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/595119480_28493785023605914_9081470104433155410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KBt2Dc9IYdEQ7kNvwHRVOY9&_nc_oc=Adp-2xDMmkxGna9-NiuN_u9_8EyYlggmADlHKdDFnGNhKsEKWcVUx60hcwUwM1iXA2s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTTE4aeHWQ74xE-15LxnkpHxCncwqrO4Of9nfXNSTevA&oe=6AF1E86F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "title.png", "id": "1097778122900602", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/593761155_1097778126233935_3172726427822974132_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OpMRilgSkAEQ7kNvwG-mTvg&_nc_oc=AdpVSZHK75EexnD7vPIe5OKo2YyKjXbRB070v2RU90OS_T4gU0Kupw6dJ5TonAi0BGw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAC8-0DPaGBtHeH_ChEU_Nk8mtbH5Y3W3HKNTQ5GcBAA&oe=6AF1DBFE"}, "display_name": "Media Review", "keywords": ["creative", "review", "videos", "collaborative", "multiplayer"], "long_description": "**Media Review** is a collaborative VR video review tool for the Meta Quest. Watch footage together in real-time with frame-accurate synced playback across user headsets.\n\n## **FRAME .IO INTEGRATION**\nBrowse your Frame projects, download assets directly to your headset, and create shared review rooms. Post timestamped comments and draw annotations on-screen \u2014 all synced back to Frame.io.\n\n## **SYNCED MULTIPLAYER**\nUp to 16 participants watch simultaneously with sub-second sync. Hosts control playback and guest permissions. Built-in voice chat keeps the conversation going, and networked laser pointers let everyone point at what matters.\n\n## **PROFESSIONAL TRANSPORT**\nSingle-frame stepping, jog scrub via thumb stick, and three timecode formats (standard, frame count, SMPTE). Adjustable playback speed and playlist support with drag-to-reorder.\n\n## **STEREOSCOPIC PLAYBACK**\nSupports rectilinear, 180 and 360 (all in mono and stereo, both over under and side-by-side).\n\nMusic: New Life \u2014 Moire \u2014 uppbeat.io \u2014 ECTJR7ZBMUI8LTCZ", "short_description": "Review videos together in VR! Media Review syncs playback across all headsets so teams can watch, discuss, and annotate content simultaneously \u2014 whether streaming from Frame.io or playing local files.\n\n- Frame.io integration - downloads, comments and drawn annotations\n- Synced playback (for up to 20 users)\n- Image Controls - like color, convergence and crop controls\n- Frame-accurate transport with SMPTE timecode\n- Voice chat and networked laser pointer\n- Speech-to-text notes with timecode stamps"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.facebook.com/privacy/policy/", "de
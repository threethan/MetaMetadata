c=AdouT0be4RI7FZms2a1bfJK1s2jurdz7pkp8CtFEQ8_M1zPGoUIBUcs4rKeHON3lRTQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTquo3KtK6CpRwImEaNYWRo2wbUWER6v8mfcM73UL5SkA&oe=6B04564B"}, {"file_name": "screenshot_25.png", "id": "1692023955232390", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620559_1692023958565723_8506211122184864608_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZXOeJErbn0MQ7kNvwEGqERp&_nc_oc=AdohyJjAkwd2_00sAyev8EVPWlhG20HsTAH5hM4EwnfMLaL7Jg8eM4h5cKWkiqYs8Qg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_OpYet0ujj4zMe4ad67WrUu1F69zyKLYDSRU8FqC3nA&oe=6B0460DE"}, {"file_name": "screenshot_26.png", "id": "3393168994198951", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499627502_3393168997532284_4012274785949412253_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VvRvfRRlyLQQ7kNvwGOEs08&_nc_oc=AdqY8kfseQuG86hIclhdUC6kuV2Qe8dG1fTQRo9eVUj_DthmIW7N968qGpCMAtiWnt0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQs2Be8UifhRkYFY-KhqtafXMl2emdt6GvRhfYDgr-uMQ&oe=6B045832"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "title.png", "id": "1097778122900602", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593761155_1097778126233935_3172726427822974132_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gz6d_g8K3U4Q7kNvwEaNCMl&_nc_oc=Adob0LfWIyZcaZTWyFqRbO-gn7C38dweAhkB9YX66YbtxVkdyJ0Ku9OpRJQ-97SqQy4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTosNrPdvH7RPVDrk-FBliWTb-kEDLP0_loB0dDtFaABg&oe=6B04893E"}, "display_name": "Media Review", "keywords": ["creative", "review", "videos", "collaborative", "multiplayer"], "long_description": "**Media Review** is a collaborative VR video review tool for the Meta Quest. Watch footage together in real-time with frame-accurate synced playback across user headsets.\n\n## **FRAME .IO INTEGRATION**\nBrowse your Frame projects, download assets directly to your headset, and create shared review rooms. Post timestamped comments and draw annotations on-screen \u2014 all synced back to Frame.io.\n\n## **SYNCED MULTIPLAYER**\nUp to 16 participants watch simultaneously with sub-second sync. Hosts control playback and guest permissions. Built-in voice chat keeps the conversation going, and networked laser pointers let everyone point at what matters.\n\n## **PROFESSIONAL TRANSPORT**\nSingle-frame stepping, jog scrub via thumb stick, and three timecode formats (standard, frame count, SMPTE). Adjustable playback speed and playlist support with drag-to-reorder.\n\n## **STEREOSCOPIC PLAYBACK**\nSupports rectilinear, 180 and 360 (all in mono and stereo, both over under and side-by-side).", "short_description": "Review videos together in VR! Media Review syncs playback across all headsets so teams can watch, discuss, and annotate content simultaneously \u2014 whether streaming from Frame.io or playing local files.\n\n- Frame.io integration - downloads, comments and drawn annotations\n- Synced playback (for up to 20 users)\n- Image Controls - like color, convergence and crop controls\n- Frame-accurate transport with SMPTE timecode\n- Voice chat and networked laser pointer\n- Speech-to-text notes with timecode stamps"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.facebook.com/privacy/policy/", "developer_terms_of_service_url": null, "publisher_name": "Meta RLE", "support_website_url": null, "website_url": "https://watchparty.cf.metafb.cloud/site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP", "MULTI_USER", "MULTI_USER", "SINGLE_USER", "MULTI_USER"], "id": "35465330823115185"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "4591072211104835"}]}, "baseline_offer": {"id": "4591072211104835"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1789495200, "status": "PUBLISHED", "id": "4591072211104835"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "40177638025217751", "version": "1.4.0-release"}, "id": "1996623474293628", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "35465330793115188", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "40177638025217751"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1795040660, "id": "40177774935204060", "version": "1.4.0-dev", "version_code": 415, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "35465330793115188", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "40177638025217751"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1795040461, "id": "40177714525210101", "version": "1.4.0-beta", "version_code": 414, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "35465330793115188", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "40177638025217751"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1996623474293628"}]}, "change_log": "Media Review 1.4.0\n\nNew\n- SDH and FULL subtitle deliveries (.xml) are listed in the Frame.io browser, and an SDH choice stays SDH on the next clip.\n- Attach a subtitle file in the video's folder that is not named after the video, by choosing it in the subtitle panel's track list.\n- Japanese vertical text, ruby, emphasis dots, numbers side by side and slant are drawn in every build, for files that use them.\n\nImproved\n- Save Copy and Upload Copy of an .xml delivery keep it an .xml, in its naming, with the next version number.\n- Subtitle files show a subtitle icon and label in the Frame.io browser and the playlist builder, and a file that can't be added says why.\n- The subtitle track list scrolls, and long file names show their end.\n- A vertical region's columns run its full height; ruby alignment is drawn; alignment set on a region applies to its subtitles.\n- Files in restricted Frame.io folders are greyed out.\n- The headset's settings list the app as Media Review.\n- Settings are kept when you update.\n- In the Void, the lobby turns to face you when you turn away from it.\n\nFixed\n- Subtitles stayed on screen one frame past a cut at 48 fps.\n- A see-through subtitle box showed the room instead of the picture in MR.\n- Offline rooms sent playback updates over the network.\n- A headset that couldn't be verified kept reconnecting.\n- The lobby jumped a moment after you put the headset on, even when you were already facing it.\n\nKnown\n- An .xml subtitle file copied onto the headset by cable is not seen. Rename it to .ttml.", "created_date": 1795040213, "id": "40177638025217751", "version": "1.4.0-release", "version_code": 413, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "35465330793115188", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "40177638025217751"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1996623474293628"}]}, "change_log": null, "created_date": 1795035868, "id": "40176389765342577", "version": "1.4.0-release", "version_code": 412, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "35465330793115188", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "40177638025217751"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1795030008, "id": "40174525142195706", "version": "1.4.0-alpha", "version_code": 410, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
4.5771-25/756589809_1854770799221808_5220201105006514773_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xmDF1awqHPwQ7kNvwGWU2D2&_nc_oc=AdqSykRN_Dbe01csj3JhHZ1MM7LYM2BG3qqTp8FClIxakz8l8dqMB1HyJXs_7orYxEw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGHIgprDTz9v35axrlMBg0TEXm1gQBMlmTBwtL3aqVMQ&oe=6AF087B7"}, {"file_name": "void_01_00_02_17.png", "id": "1121422300419901", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/595129854_1121422303753234_6555510923288677606_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CdH1P1jXbzYQ7kNvwHxTT3f&_nc_oc=Ado4d8_3bC57ntEmC_D4arr_QfgmuT49tXBIcalICrecYUHRa8z_vsvh1uK101cj2s0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNPopIVIeH6Do3l84NUKP3wAhaK1Wyv-LjHLcSz6Rm9w&oe=6AF08FE4"}, {"file_name": "com_00_01_12_19.png", "id": "1603985808130759", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673531334_1603985811464092_3861902782037551871_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ubyn61bmIu0Q7kNvwGwO43P&_nc_oc=AdoMv0fi4wT9vvCUCeczvqmtnzSZkpIy5AUSNv81uFEd5uUztR2uBtexRHeU6Nx68Qg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5MfQbYoR4PVi_JPSJ1wIgh95ASVqwTNT-rMJlcM39wA&oe=6AF0989D"}, {"file_name": "com_00_02_01_03.png", "id": "28493785020272581", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/595119480_28493785023605914_9081470104433155410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6E9Mr1OnJCMQ7kNvwGyYyvt&_nc_oc=AdquLwZnyJt67ai5_NjQR81Q6WxcIhije7yWxM8LbugbG1Ooj1vn-FNy7N1eSBeBBLQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVSO-2xh4e0qtnXB7HkI0mOdhMnKAzYtcohwCLNQiwdA&oe=6AF096EF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "title.png", "id": "1097778122900602", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/593761155_1097778126233935_3172726427822974132_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iinDbT3AikEQ7kNvwFICKVa&_nc_oc=AdpcURYsFN4idZC6EmKOPdrcvPtR4rAFVOdYlDx4_RUhE_NPX0zn9owPiRx62T93Z00&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZGzDiVkLCz_hK7ChYJYi9i2pwiaW1ucdRSAdxg0vovA&oe=6AF08A7E"}, "display_name": "Media Review", "keywords": ["creative", "review", "videos", "collaborative", "multiplayer"], "long_description": "**Media Review** is a collaborative VR video review tool for the Meta Quest. Watch footage together in real-time with frame-accurate synced playback across user headsets.\n\n## **FRAME .IO INTEGRATION**\nBrowse your Frame projects, download assets directly to your headset, and create shared review rooms. Post timestamped comments and draw annotations on-screen \u2014 all synced back to Frame.io.\n\n## **SYNCED MULTIPLAYER**\nUp to 16 participants watch simultaneously with sub-second sync. Hosts control playback and guest permissions. Built-in voice chat keeps the conversation going, and networked laser pointers let everyone point at what matters.\n\n## **PROFESSIONAL TRANSPORT**\nSingle-frame stepping, jog scrub via thumb stick, and three timecode formats (standard, frame count, SMPTE). Adjustable playback speed and playlist support with drag-to-reorder.\n\n## **STEREOSCOPIC PLAYBACK**\nSupports rectilinear, 180 and 360 (all in mono and stereo, both over under and side-by-side).\n\nMusic: New Life \u2014 Moire \u2014 uppbeat.io \u2014 ECTJR7ZBMUI8LTCZ", "short_description": "Review videos together in VR! Media Review syncs playback across all headsets so teams can watch, discuss, and annotate content simultaneously \u2014 whether streaming from Frame.io or playing local files.\n\n- Frame.io integration - downloads, comments and drawn annotations\n- Synced playback (for up to 20 users)\n- Image Controls - like color, convergence and crop controls\n- Frame-accurate transport with SMPTE timecode\n- Voice chat and networked laser pointer\n- Speech-to-text notes with timecode stamps"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.facebook.com/privacy/policy/", "de
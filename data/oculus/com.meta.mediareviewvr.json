64.5771-25/756589809_1854770799221808_5220201105006514773_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RWJw8m0ccE4Q7kNvwElbjpb&_nc_oc=AdpD6QEFEdvvTx8lmGT9dpEZUC1Rr5XytdN2G6s0ug5v2uDGnk6CAe3hOWo4R-MatvQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPTKLBBLKkaC6fUPpqQpSyeGxuxA8-dQaBkxr170GPRUw&oe=6AC50637"}, {"file_name": "void_01_00_02_17.png", "id": "1121422300419901", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/595129854_1121422303753234_6555510923288677606_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nv8EhM-bOk0Q7kNvwH9lF2R&_nc_oc=AdrFX3WvJPgnMMJwqNrT4eG2AZTu98S_hP_DX3SEJiCUDeVKYoXBf-q4D0D71TqdCAQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOw_jMrINrOOD1msv_BNWavJIpyxSnvOj1Ejx6x5GmyqQ&oe=6AC50E64"}, {"file_name": "com_00_01_12_19.png", "id": "1603985808130759", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/673531334_1603985811464092_3861902782037551871_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HyW8hH2YLjYQ7kNvwF0g3t2&_nc_oc=Adq_YWuj4pI_eajhaQWWqS4vbQpaaWMrFPYIdpKK54-dcvvpSZRWRs1y-8Jzq6QvgGA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIOyQJUHJQB4TThRvijW6lN4_lo1lmADuBv6JavCo0uw&oe=6AC5171D"}, {"file_name": "com_00_02_01_03.png", "id": "28493785020272581", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/595119480_28493785023605914_9081470104433155410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mrSEYAFa8EIQ7kNvwFzCay9&_nc_oc=AdppdnbNbVL460vLoF7oOh-Jg4zsw5JZP3doL05Uu5d3UnHvZhsROZzitSAGapEmMBc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPLoAZu4-78vB7U9YBlGJCuVjhtYOSgdE5OPIpwTuu1Ow&oe=6AC5156F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "title.png", "id": "1097778122900602", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/593761155_1097778126233935_3172726427822974132_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cEBkVHHfn2kQ7kNvwFhn6BQ&_nc_oc=AdpMFiGiayvntkYd4A5HlCxBacXb_Pik-UPklZ_-FOARdaHKq8hpowX-h2tfiDjNd_I&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMPyd0u2cxSHhqm00amRrNVxFQ8Y6NQN_1vPUbwRitItw&oe=6AC508FE"}, "display_name": "Media Review", "keywords": ["creative", "review", "videos", "collaborative", "multiplayer"], "long_description": "**Media Review** is a collaborative VR video review tool for the Meta Quest. Watch footage together in real-time with frame-accurate synced playback across user headsets.\n\n## **FRAME .IO INTEGRATION**\nBrowse your Frame projects, download assets directly to your headset, and create shared review rooms. Post timestamped comments and draw annotations on-screen \u2014 all synced back to Frame.io.\n\n## **SYNCED MULTIPLAYER**\nUp to 16 participants watch simultaneously with sub-second sync. Hosts control playback and guest permissions. Built-in voice chat keeps the conversation going, and networked laser pointers let everyone point at what matters.\n\n## **PROFESSIONAL TRANSPORT**\nSingle-frame stepping, jog scrub via thumb stick, and three timecode formats (standard, frame count, SMPTE). Adjustable playback speed and playlist support with drag-to-reorder.\n\n## **STEREOSCOPIC PLAYBACK**\nSupports rectilinear, 180 and 360 (all in mono and stereo, both over under and side-by-side).", "short_description": "Review videos together in VR! Media Review syncs playback across all headsets so teams can watch, discuss, and annotate content simultaneously \u2014 whether streaming from Frame.io or playing local files.\n\n- Frame.io integration - downloads, comments and drawn annotations\n- Synced playback (for up to 20 users)\n- Image Controls - like color, convergence and crop controls\n- Frame-accurate transport with SMPTE timecode\n- Voice chat and networked laser pointer\n- Speech-to-text notes with timecode stamps"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.facebook.com/privacy/policy/", "developer_terms_of_service_url": null, "publisher_name": "Meta RLE", "suppo
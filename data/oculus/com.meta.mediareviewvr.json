4.5771-25/756589809_1854770799221808_5220201105006514773_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f1SdX4Sr6d4Q7kNvwHPh8OI&_nc_oc=AdrvzkrPdoK5mSC6vsVNZy84fhxHhFE_ffCWfP3cR6UrMecSr-gGU3FTiO6f-v2lzBM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOWueF8AN1FFga8uvIFfkChqipz1iIzlCZi1EXmJgWzSw&oe=6AD23537"}, {"file_name": "void_01_00_02_17.png", "id": "1121422300419901", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/595129854_1121422303753234_6555510923288677606_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lXIBBMfy5eUQ7kNvwGHjLXe&_nc_oc=AdoABfUjC0eeMPyGQDflN9QKn6SY84RFWk71kXDPowdt3Jz5RBUIAz3Nyr8V05Upj9M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN9aGVhKX8HgaaV_1gk0y5AUpBBbghwwsZMgoI7qfdPBw&oe=6AD23D64"}, {"file_name": "com_00_01_12_19.png", "id": "1603985808130759", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/673531334_1603985811464092_3861902782037551871_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nFtAtOpVXvAQ7kNvwHqfSZc&_nc_oc=AdrQGwGKxZcbwV4-nkM-OyZX9aovCd-xJUlebzGR1BwC0GytMrPfvXRO_hyuKhOCu9w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP2VYtlCP5QoE5jtbIApuIo6ZMUr_AsyP7SKd28tYplXg&oe=6AD2461D"}, {"file_name": "com_00_02_01_03.png", "id": "28493785020272581", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/595119480_28493785023605914_9081470104433155410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JHcNKkq7flgQ7kNvwFqw2YA&_nc_oc=AdrkDasRxadm208ogrKKvv_ElCEUnG-wMJClJ_ie6QL2fAypCeKYRUxsTylKCxZlmx8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPbPemyHTXofGJwQiN1XVlSQJ63hdR105Qee_rWhksNGw&oe=6AD2446F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "title.png", "id": "1097778122900602", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/593761155_1097778126233935_3172726427822974132_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RGRqr6njZkkQ7kNvwGL0x-z&_nc_oc=AdrRHIugPu5w0JcmBm6CbWnrrZmXhS93RtGrzA4kvV7YIbBY20lF9XFDbNoYzzcL3VQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-em6UkGsqRpc9K8vIXfHC8rlwvCxpejSJM8b0il2vTA&oe=6AD237FE"}, "display_name": "Media Review", "keywords": ["creative", "review", "videos", "collaborative", "multiplayer"], "long_description": "**Media Review** is a collaborative VR video review tool for the Meta Quest. Watch footage together in real-time with frame-accurate synced playback across user headsets.\n\n## **FRAME .IO INTEGRATION**\nBrowse your Frame projects, download assets directly to your headset, and create shared review rooms. Post timestamped comments and draw annotations on-screen \u2014 all synced back to Frame.io.\n\n## **SYNCED MULTIPLAYER**\nUp to 16 participants watch simultaneously with sub-second sync. Hosts control playback and guest permissions. Built-in voice chat keeps the conversation going, and networked laser pointers let everyone point at what matters.\n\n## **PROFESSIONAL TRANSPORT**\nSingle-frame stepping, jog scrub via thumb stick, and three timecode formats (standard, frame count, SMPTE). Adjustable playback speed and playlist support with drag-to-reorder.\n\n## **STEREOSCOPIC PLAYBACK**\nSupports rectilinear, 180 and 360 (all in mono and stereo, both over under and side-by-side).\n\nMusic: New Life \u2014 Moire \u2014 uppbeat.io \u2014 ECTJR7ZBMUI8LTCZ", "short_description": "Review videos together in VR! Media Review syncs playback across all headsets so teams can watch, discuss, and annotate content simultaneously \u2014 whether streaming from Frame.io or playing local files.\n\n- Frame.io integration - downloads, comments and drawn annotations\n- Synced playback (for up to 20 users)\n- Image Controls - like color, convergence and crop controls\n- Frame-accurate transport with SMPTE timecode\n- Voice chat and networked laser pointer\n- Speech-to-text notes with timecode stamps"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.facebook.com/privacy/policy/", "de
4.5771-25/756589809_1854770799221808_5220201105006514773_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G8bjSBHVLaQQ7kNvwHyvGdV&_nc_oc=AdqKxbIke77HDI9O4QHFWgWkNTsLdrLGBv7Yb3bOgCgNgDNgRZ3zkf6i704GrcNwuVI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMbDB-fzf3lNfGYpIdc1NxvJ1y8O0WNlzp46T891tuSEw&oe=6ADCC137"}, {"file_name": "void_01_00_02_17.png", "id": "1121422300419901", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/595129854_1121422303753234_6555510923288677606_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vQnGgP0a61wQ7kNvwG-hEL3&_nc_oc=AdqyTRiIW_CflEQiFsdLuKTS66rTOyqetg1SZaI3EO4HXNZ28IOjNqDwpWgX240eGbc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNNHAGlMcUx1uswLChMILx7aO21gHgGIG_wq3l2E7bdQ&oe=6ADCC964"}, {"file_name": "com_00_01_12_19.png", "id": "1603985808130759", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/673531334_1603985811464092_3861902782037551871_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=luOcg7UuuG0Q7kNvwHsJyKY&_nc_oc=Adpd0H0eQKpMrLr-ApXE2aMbL6aa9HaFMBUihrCCe9yxBPEgCC6KMNT0GiQ0y_OA5b4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN-INKTzolWFaSfcS8GUM6XP_hFpPlQ6wvCbRuKkyPDZw&oe=6ADCD21D"}, {"file_name": "com_00_02_01_03.png", "id": "28493785020272581", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/595119480_28493785023605914_9081470104433155410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ocGg9_uz3tcQ7kNvwEtHu1i&_nc_oc=AdpcS0WHeMovdEydfeDgItb0DhVuo7gOvrYjlvw5p1Z5Wr537YhsMdc9Nu3c9_M_28c&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMcKIuAF-SPKxD9Fnr1eXktstRVKVet04XBfSxzZK3DSA&oe=6ADCD06F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "title.png", "id": "1097778122900602", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/593761155_1097778126233935_3172726427822974132_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7K5gtG3ZR7sQ7kNvwE5nQd0&_nc_oc=AdqD-_p_RScvNITpJPJrvgZPR7TkXdMyCZKhdwioREIqsDs6O9DlU2AfCPGJJ9zbcuw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP9HZGKwr-Ln3_NkT8z6Q4y_hAzp44OVkHw2XjtZ600Dg&oe=6ADCC3FE"}, "display_name": "Media Review", "keywords": ["creative", "review", "videos", "collaborative", "multiplayer"], "long_description": "**Media Review** is a collaborative VR video review tool for the Meta Quest. Watch footage together in real-time with frame-accurate synced playback across user headsets.\n\n## **FRAME .IO INTEGRATION**\nBrowse your Frame projects, download assets directly to your headset, and create shared review rooms. Post timestamped comments and draw annotations on-screen \u2014 all synced back to Frame.io.\n\n## **SYNCED MULTIPLAYER**\nUp to 16 participants watch simultaneously with sub-second sync. Hosts control playback and guest permissions. Built-in voice chat keeps the conversation going, and networked laser pointers let everyone point at what matters.\n\n## **PROFESSIONAL TRANSPORT**\nSingle-frame stepping, jog scrub via thumb stick, and three timecode formats (standard, frame count, SMPTE). Adjustable playback speed and playlist support with drag-to-reorder.\n\n## **STEREOSCOPIC PLAYBACK**\nSupports rectilinear, 180 and 360 (all in mono and stereo, both over under and side-by-side).\n\nMusic: New Life \u2014 Moire \u2014 uppbeat.io \u2014 ECTJR7ZBMUI8LTCZ", "short_description": "Review videos together in VR! Media Review syncs playback across all headsets so teams can watch, discuss, and annotate content simultaneously \u2014 whether streaming from Frame.io or playing local files.\n\n- Frame.io integration - downloads, comments and drawn annotations\n- Synced playback (for up to 20 users)\n- Image Controls - like color, convergence and crop controls\n- Frame-accurate transport with SMPTE timecode\n- Voice chat and networked laser pointer\n- Speech-to-text notes with timecode stamps"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.facebook.com/privacy/policy/", "de
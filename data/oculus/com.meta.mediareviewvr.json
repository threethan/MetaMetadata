4.5771-25/756589809_1854770799221808_5220201105006514773_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o2mdU4lBaFoQ7kNvwG9ycD6&_nc_oc=Adp3GEiIUB5u6fdChaigLCJgbN9OTewaEYCP5pWoQ0kSjo4t7-qytDFCtGIFfXNBOgo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO1T3-AezGHCH7e86sBcjtGZY2Srey-4T6DOqsxWM73Pg&oe=6ACE40B7"}, {"file_name": "void_01_00_02_17.png", "id": "1121422300419901", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/595129854_1121422303753234_6555510923288677606_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zXE0K_EHencQ7kNvwHXOtsc&_nc_oc=AdombAYgD4vcbQQ2jnuQpZMOFqpzlbNRWbVeUZqqHxByEraUkw4D2bg0kuKnRVvB1dw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMwj3txPp21TwUmPD4WbrrX8gX1CuLkRySZ98z-GB3GHw&oe=6ACE48E4"}, {"file_name": "com_00_01_12_19.png", "id": "1603985808130759", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673531334_1603985811464092_3861902782037551871_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BBQCzxWQyV4Q7kNvwG34zrY&_nc_oc=AdqvGs9jygteRm0ZtmMtbHp3k_-p0XFvzLv9XH-MSnMyxW4yjEUNggN5PlDCa4MCl90&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJvCyvmkB9vZV8ARQSeF3VUjThOLNx4jiceOD08WrFCQ&oe=6ACE519D"}, {"file_name": "com_00_02_01_03.png", "id": "28493785020272581", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/595119480_28493785023605914_9081470104433155410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0KLJVLjHvjgQ7kNvwHXq0h2&_nc_oc=Adp6pAF0SjkXzLa9qLknHPQR_6JTZIiSmERjjF4chWTwtQBSeUY-8oD7nvB_QRFvkAg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMl7u2qp3F13Mti5nHtSFPsl6J3ILa-1T4tgMA4TuKH5w&oe=6ACE4FEF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "title.png", "id": "1097778122900602", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593761155_1097778126233935_3172726427822974132_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ieCziJtaWb4Q7kNvwEqzkYv&_nc_oc=Adqj92ZTiuOC4gKMOCQqZbmMYoq18LAD9BBbsX7HrlCj6xnSPA3Si_JlazPmci1F82Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMmYeaMqI2kgYfUW4whu447_isp46xNANo16PZgLzgXWw&oe=6ACE437E"}, "display_name": "Media Review", "keywords": ["creative", "review", "videos", "collaborative", "multiplayer"], "long_description": "**Media Review** is a collaborative VR video review tool for the Meta Quest. Watch footage together in real-time with frame-accurate synced playback across user headsets.\n\n## **FRAME .IO INTEGRATION**\nBrowse your Frame projects, download assets directly to your headset, and create shared review rooms. Post timestamped comments and draw annotations on-screen \u2014 all synced back to Frame.io.\n\n## **SYNCED MULTIPLAYER**\nUp to 16 participants watch simultaneously with sub-second sync. Hosts control playback and guest permissions. Built-in voice chat keeps the conversation going, and networked laser pointers let everyone point at what matters.\n\n## **PROFESSIONAL TRANSPORT**\nSingle-frame stepping, jog scrub via thumb stick, and three timecode formats (standard, frame count, SMPTE). Adjustable playback speed and playlist support with drag-to-reorder.\n\n## **STEREOSCOPIC PLAYBACK**\nSupports rectilinear, 180 and 360 (all in mono and stereo, both over under and side-by-side).\n\nMusic: New Life \u2014 Moire \u2014 uppbeat.io \u2014 ECTJR7ZBMUI8LTCZ", "short_description": "Review videos together in VR! Media Review syncs playback across all headsets so teams can watch, discuss, and annotate content simultaneously \u2014 whether streaming from Frame.io or playing local files.\n\n- Frame.io integration - downloads, comments and drawn annotations\n- Synced playback (for up to 20 users)\n- Image Controls - like color, convergence and crop controls\n- Frame-accurate transport with SMPTE timecode\n- Voice chat and networked laser pointer\n- Speech-to-text notes with timecode stamps"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.facebook.com/privacy/policy/", "de
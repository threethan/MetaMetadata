4.5771-25/756589809_1854770799221808_5220201105006514773_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tpHN_xTAqcMQ7kNvwH-z9Tm&_nc_oc=Adpm35NLfU4xg8s_ir0f5akbNd9jzfUDwvSZQvkfk1UzmKmVc81sNz94Bh_BksOQWfY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNe1Bki5gjcEHNBwbeuroH-zdWme2bCyyrcIfc_1YTSUQ&oe=6AE4AA37"}, {"file_name": "void_01_00_02_17.png", "id": "1121422300419901", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/595129854_1121422303753234_6555510923288677606_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pJ32BHPUaZgQ7kNvwEHl6PO&_nc_oc=AdpHDb6gUxaTHPs9BH3KjNzmq3VIBvAdvfcuXuWjMNnKsjAQnB0slpOqk_h7K4e3sxE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNHvkKqU-9AoucqQu2XLMUyS9tUkhp4zd9Q2GNl3q0Hiw&oe=6AE4B264"}, {"file_name": "com_00_01_12_19.png", "id": "1603985808130759", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/673531334_1603985811464092_3861902782037551871_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ftMdCdPrD5EQ7kNvwEfFBlP&_nc_oc=Adq9Xt_5ngqZSeRSZxxSP3DxsVxHoncGj7BaawsqABfeudxbafzQiv1qSVI68CMXVKs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOm73ydHGsHwQ4lO_291EAxEd85CPWPnONK5LgFzr9-Lw&oe=6AE4BB1D"}, {"file_name": "com_00_02_01_03.png", "id": "28493785020272581", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/595119480_28493785023605914_9081470104433155410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=357_tIkyBekQ7kNvwHPU4CR&_nc_oc=AdqTq_o8stqKXomPAnM65-pee2hXpmNgCVzZwxo5cA2IQS_g72lZfOu-cgZQM7-RY1w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO6GB7EbRSPrl-l_4uib2CrMVEYDH9MMh9huE5WfVZ5Aw&oe=6AE4B96F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "title.png", "id": "1097778122900602", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/593761155_1097778126233935_3172726427822974132_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OD7RSzOKKHIQ7kNvwF2POoO&_nc_oc=Adr6yijTn3fFyfL4wnToNVKAwS3J4ZHxZZoeS5BJm4UibNx1qe4Gx2De4ybQUj-y3BY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOgifZ2fgmjsmbjZRaOznYUyIXItTO-VycTAzXG2QX02w&oe=6AE4ACFE"}, "display_name": "Media Review", "keywords": ["creative", "review", "videos", "collaborative", "multiplayer"], "long_description": "**Media Review** is a collaborative VR video review tool for the Meta Quest. Watch footage together in real-time with frame-accurate synced playback across user headsets.\n\n## **FRAME .IO INTEGRATION**\nBrowse your Frame projects, download assets directly to your headset, and create shared review rooms. Post timestamped comments and draw annotations on-screen \u2014 all synced back to Frame.io.\n\n## **SYNCED MULTIPLAYER**\nUp to 16 participants watch simultaneously with sub-second sync. Hosts control playback and guest permissions. Built-in voice chat keeps the conversation going, and networked laser pointers let everyone point at what matters.\n\n## **PROFESSIONAL TRANSPORT**\nSingle-frame stepping, jog scrub via thumb stick, and three timecode formats (standard, frame count, SMPTE). Adjustable playback speed and playlist support with drag-to-reorder.\n\n## **STEREOSCOPIC PLAYBACK**\nSupports rectilinear, 180 and 360 (all in mono and stereo, both over under and side-by-side).\n\nMusic: New Life \u2014 Moire \u2014 uppbeat.io \u2014 ECTJR7ZBMUI8LTCZ", "short_description": "Review videos together in VR! Media Review syncs playback across all headsets so teams can watch, discuss, and annotate content simultaneously \u2014 whether streaming from Frame.io or playing local files.\n\n- Frame.io integration - downloads, comments and drawn annotations\n- Synced playback (for up to 20 users)\n- Image Controls - like color, convergence and crop controls\n- Frame-accurate transport with SMPTE timecode\n- Voice chat and networked laser pointer\n- Speech-to-text notes with timecode stamps"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.facebook.com/privacy/policy/", "de
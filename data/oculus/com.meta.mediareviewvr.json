4.5771-25/756589809_1854770799221808_5220201105006514773_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f1SdX4Sr6d4Q7kNvwHIZIX3&_nc_oc=Ado9elW4MR7J62mjPaaJmWqVuJ85R87M0urRRzca8283jARcTMal_TCjlguEn_xWP9Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPM11h5CvjTjKcgTAqV-Zxh1DqfQKqWKP_dHSTQ78SlYA&oe=6ACF9237"}, {"file_name": "void_01_00_02_17.png", "id": "1121422300419901", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/595129854_1121422303753234_6555510923288677606_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zXE0K_EHencQ7kNvwETFYAf&_nc_oc=AdpFpGc2KqMFtWjtpy43YILTCWLgu8MRybtjl_Ln_BPvxs3Fj2giB6KhG6b-23lx8PI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOV2zdiXS14qPBe1RJxtlGj-dallJyot2Qqy7Cl07NCCg&oe=6ACF9A64"}, {"file_name": "com_00_01_12_19.png", "id": "1603985808130759", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/673531334_1603985811464092_3861902782037551871_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nFtAtOpVXvAQ7kNvwGoX44u&_nc_oc=AdoEQxnl9ZfA1dh55CqgGab9XVQTU-68anrX_gIe83PV1IUNrc1mSmoC6fZ8Lbk3fiA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPmsXR_fWWUa_9TGfNCwPQxsYsZggakXIygiCLgrvNA3w&oe=6ACFA31D"}, {"file_name": "com_00_02_01_03.png", "id": "28493785020272581", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/595119480_28493785023605914_9081470104433155410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0KLJVLjHvjgQ7kNvwFsNJ-2&_nc_oc=AdoCSF2gzGyiZfD7t5RE9te0y6_F_F7wLIn-8nrEN-okwmCcvXwylWQ4g1PF5FldF-I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOhIyLz2Hq3AkK6saE6Wa8t7z0f23wd8Jbv8MPxe09WsA&oe=6ACFA16F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "title.png", "id": "1097778122900602", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/593761155_1097778126233935_3172726427822974132_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ieCziJtaWb4Q7kNvwFr15OR&_nc_oc=Adr-SlQskLqyEXgqy1-8SjY4771-EFQ6LpTSbhC4mXWiJ-WnbzMIzP5WzruQgxZvf8E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMWOnGNw5y9-o-xdFnYP3wFccP9uEAnXTHwwz8W8MgJTA&oe=6ACF94FE"}, "display_name": "Media Review", "keywords": ["creative", "review", "videos", "collaborative", "multiplayer"], "long_description": "**Media Review** is a collaborative VR video review tool for the Meta Quest. Watch footage together in real-time with frame-accurate synced playback across user headsets.\n\n## **FRAME .IO INTEGRATION**\nBrowse your Frame projects, download assets directly to your headset, and create shared review rooms. Post timestamped comments and draw annotations on-screen \u2014 all synced back to Frame.io.\n\n## **SYNCED MULTIPLAYER**\nUp to 16 participants watch simultaneously with sub-second sync. Hosts control playback and guest permissions. Built-in voice chat keeps the conversation going, and networked laser pointers let everyone point at what matters.\n\n## **PROFESSIONAL TRANSPORT**\nSingle-frame stepping, jog scrub via thumb stick, and three timecode formats (standard, frame count, SMPTE). Adjustable playback speed and playlist support with drag-to-reorder.\n\n## **STEREOSCOPIC PLAYBACK**\nSupports rectilinear, 180 and 360 (all in mono and stereo, both over under and side-by-side).\n\nMusic: New Life \u2014 Moire \u2014 uppbeat.io \u2014 ECTJR7ZBMUI8LTCZ", "short_description": "Review videos together in VR! Media Review syncs playback across all headsets so teams can watch, discuss, and annotate content simultaneously \u2014 whether streaming from Frame.io or playing local files.\n\n- Frame.io integration - downloads, comments and drawn annotations\n- Synced playback (for up to 20 users)\n- Image Controls - like color, convergence and crop controls\n- Frame-accurate transport with SMPTE timecode\n- Voice chat and networked laser pointer\n- Speech-to-text notes with timecode stamps"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.facebook.com/privacy/policy/", "de
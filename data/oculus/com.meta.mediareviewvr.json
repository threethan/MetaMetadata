4.5771-25/756589809_1854770799221808_5220201105006514773_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G8bjSBHVLaQQ7kNvwF5cQE1&_nc_oc=Adpp6xzarU1iVoow6y_2D3wxH-VlYFqLmf1kQjNUSnG0befx9WQ8bbqZlpB84sqcRzQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJ-rpHuCyJgoFpOi-fmAvDgatIIsRcScLklTLko9dtIQ&oe=6ADE12B7"}, {"file_name": "void_01_00_02_17.png", "id": "1121422300419901", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/595129854_1121422303753234_6555510923288677606_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XH2ZR5a-_rUQ7kNvwHYQ6Ex&_nc_oc=AdraG4Idr74V2kceKrXodMhvjIS2lzGKMY8o4r7yYMOglFFdd6f4yhv2pjtMXlcuZ2M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZKsbsfQC5jEebOMrpf2ZGfOqXkSsSGM45gjETeP1d_g&oe=6ADE1AE4"}, {"file_name": "com_00_01_12_19.png", "id": "1603985808130759", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/673531334_1603985811464092_3861902782037551871_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=luOcg7UuuG0Q7kNvwH6tz62&_nc_oc=Adpw5Sdo_SDdTSxoxktW3hGnQ774QERewc3v_z4-ml8tJTncsDl4mRv7Xi9kQYxdp6I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOgNQ2XfSbEF34yHg3HtXivSK26dom-GcH8B5xr6Q3XQQ&oe=6ADE239D"}, {"file_name": "com_00_02_01_03.png", "id": "28493785020272581", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/595119480_28493785023605914_9081470104433155410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1emRenjajvMQ7kNvwGzp-gs&_nc_oc=Adqdfw6D3s3Vv0R_fmq5f8wONvfA-rNcTRScLM05Qvu17Q8MZyf3SNm1zTN0WAgMsro&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPXLzfGluYksUo8R7uVnf26x5updZAMFJSocmU3wQMsjQ&oe=6ADE21EF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "title.png", "id": "1097778122900602", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/593761155_1097778126233935_3172726427822974132_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fe9bXD7GLooQ7kNvwG93Pdf&_nc_oc=AdrixIXdtAP2TewHyMipPXBDf7xch6P3sAcDmgZLcG_8WQwQ-oUfj76ZKex6avsczMw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPcAmqyB2Iw2iwSXQDT4NjR8jGLX0TH-cvSN2ybZGJOyQ&oe=6ADE157E"}, "display_name": "Media Review", "keywords": ["creative", "review", "videos", "collaborative", "multiplayer"], "long_description": "**Media Review** is a collaborative VR video review tool for the Meta Quest. Watch footage together in real-time with frame-accurate synced playback across user headsets.\n\n## **FRAME .IO INTEGRATION**\nBrowse your Frame projects, download assets directly to your headset, and create shared review rooms. Post timestamped comments and draw annotations on-screen \u2014 all synced back to Frame.io.\n\n## **SYNCED MULTIPLAYER**\nUp to 16 participants watch simultaneously with sub-second sync. Hosts control playback and guest permissions. Built-in voice chat keeps the conversation going, and networked laser pointers let everyone point at what matters.\n\n## **PROFESSIONAL TRANSPORT**\nSingle-frame stepping, jog scrub via thumb stick, and three timecode formats (standard, frame count, SMPTE). Adjustable playback speed and playlist support with drag-to-reorder.\n\n## **STEREOSCOPIC PLAYBACK**\nSupports rectilinear, 180 and 360 (all in mono and stereo, both over under and side-by-side).\n\nMusic: New Life \u2014 Moire \u2014 uppbeat.io \u2014 ECTJR7ZBMUI8LTCZ", "short_description": "Review videos together in VR! Media Review syncs playback across all headsets so teams can watch, discuss, and annotate content simultaneously \u2014 whether streaming from Frame.io or playing local files.\n\n- Frame.io integration - downloads, comments and drawn annotations\n- Synced playback (for up to 20 users)\n- Image Controls - like color, convergence and crop controls\n- Frame-accurate transport with SMPTE timecode\n- Voice chat and networked laser pointer\n- Speech-to-text notes with timecode stamps"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.facebook.com/privacy/policy/", "de
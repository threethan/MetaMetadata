4.5771-25/756589809_1854770799221808_5220201105006514773_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GA9kkXiNaDIQ7kNvwHSXJMp&_nc_oc=AdqVuaAE5pkWAlOY3c3-SIjiHFq4j-Yk2ODkLE4a2mq7-gaEC0kKczNg1XmmZObCNPY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOgATdoRYu09oCqWgRHEEZdCUknuWaqmp60kNQLAHIuEQ&oe=6AE0B5B7"}, {"file_name": "void_01_00_02_17.png", "id": "1121422300419901", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/595129854_1121422303753234_6555510923288677606_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XH2ZR5a-_rUQ7kNvwFuaQx6&_nc_oc=AdqYZbk90BHehc-5-8Pds9ut_z1zOepw8A_q5z1Qql0BDx2PNn82c1jnnZq-Xl_7IKI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP1AYom52hrvaz39vUyp86rU3AQ1tLFTE_DhL3CWzIoAg&oe=6AE0BDE4"}, {"file_name": "com_00_01_12_19.png", "id": "1603985808130759", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/673531334_1603985811464092_3861902782037551871_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jxlvoBnqG0QQ7kNvwFRxfZw&_nc_oc=AdoeVO8kwGQKccy9aYPLiLHWholzsA0ph-osZ_S35Nk5iQSWkDBXh4bf_mLDoEfuhMo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPT1RGS3_uFw-BcDSU7S17CGHj1uxze998n80sgKaulqA&oe=6AE0C69D"}, {"file_name": "com_00_02_01_03.png", "id": "28493785020272581", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/595119480_28493785023605914_9081470104433155410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1emRenjajvMQ7kNvwHpZ5L-&_nc_oc=Adp88eQLQcemVUAqH2EKDfFwBXM7Z0Uj-x6AuY6HmHDm0WgvOydBdDbchoUZdW5Aw9Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPI4WCXiXz8gfBnA9Um8QKKQyZMkLqpiJuZcVF_92DcTg&oe=6AE0C4EF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "title.png", "id": "1097778122900602", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/593761155_1097778126233935_3172726427822974132_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fe9bXD7GLooQ7kNvwHDlkcY&_nc_oc=Ado-IiKCdCxlhKuzgL7HzS3Pl14BYro_HzbI4bJt26dt32lXCMmCIVJfD5NY6YHgqb8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM0MtvffLXEpSqDeJEFPW_XFSceTDAHT-s4DsJ1ib2xrw&oe=6AE0B87E"}, "display_name": "Media Review", "keywords": ["creative", "review", "videos", "collaborative", "multiplayer"], "long_description": "**Media Review** is a collaborative VR video review tool for the Meta Quest. Watch footage together in real-time with frame-accurate synced playback across user headsets.\n\n## **FRAME .IO INTEGRATION**\nBrowse your Frame projects, download assets directly to your headset, and create shared review rooms. Post timestamped comments and draw annotations on-screen \u2014 all synced back to Frame.io.\n\n## **SYNCED MULTIPLAYER**\nUp to 16 participants watch simultaneously with sub-second sync. Hosts control playback and guest permissions. Built-in voice chat keeps the conversation going, and networked laser pointers let everyone point at what matters.\n\n## **PROFESSIONAL TRANSPORT**\nSingle-frame stepping, jog scrub via thumb stick, and three timecode formats (standard, frame count, SMPTE). Adjustable playback speed and playlist support with drag-to-reorder.\n\n## **STEREOSCOPIC PLAYBACK**\nSupports rectilinear, 180 and 360 (all in mono and stereo, both over under and side-by-side).\n\nMusic: New Life \u2014 Moire \u2014 uppbeat.io \u2014 ECTJR7ZBMUI8LTCZ", "short_description": "Review videos together in VR! Media Review syncs playback across all headsets so teams can watch, discuss, and annotate content simultaneously \u2014 whether streaming from Frame.io or playing local files.\n\n- Frame.io integration - downloads, comments and drawn annotations\n- Synced playback (for up to 20 users)\n- Image Controls - like color, convergence and crop controls\n- Frame-accurate transport with SMPTE timecode\n- Voice chat and networked laser pointer\n- Speech-to-text notes with timecode stamps"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.facebook.com/privacy/policy/", "de
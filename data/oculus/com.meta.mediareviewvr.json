4.5771-25/756589809_1854770799221808_5220201105006514773_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VKg_SBS6HFMQ7kNvwEE2rTF&_nc_oc=AdqD7A_dXHQVI_2GVIVYYlwiNfg-Tt79nz1ph4b8O-j-8LX5WeCzGt-dD6rKsDhCN4g&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStZn0lbFRVdcKpeovrQw5QVt2T1Kh9Dm6Pp4PsTLq8aw&oe=6AF9C237"}, {"file_name": "void_01_00_02_17.png", "id": "1121422300419901", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/595129854_1121422303753234_6555510923288677606_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DbRdCndMp_YQ7kNvwEK6xst&_nc_oc=AdouUJir6eFDX_r2Dx4uxxiVwbYy_nM6Aj9Lg5TadQXaOqTHjUY9AsVyddtPhiKGQMw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXsYVc_M2jZ2iG0IEWzHEITGCPpB0-Jmho4iPVnLw33w&oe=6AF9CA64"}, {"file_name": "com_00_01_12_19.png", "id": "1603985808130759", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/673531334_1603985811464092_3861902782037551871_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S4jMaJanB5AQ7kNvwFonDNX&_nc_oc=AdqCHniCrRhBqwtKNxyu5use_lEuDIDCcgbKwrghcUual-v9rJDcjMt0Cxj7mFyWTMw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRr9DjjprtpeRyGhdDc9R2apF5lzZc5rXTPGnL0axDZQ&oe=6AF9D31D"}, {"file_name": "com_00_02_01_03.png", "id": "28493785020272581", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/595119480_28493785023605914_9081470104433155410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GFHWignl-s8Q7kNvwEGHYU1&_nc_oc=AdqyYaAXwUDHVkXPBKGlBgrnz1x7W3pmjfx_C63kPHofzacmRFs2U1mEN6qWLbgi3XU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMX5jyOZSV6lRYdx6QFA-L0zzrsVI6lh0CZPW67AThVA&oe=6AF9D16F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "title.png", "id": "1097778122900602", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/593761155_1097778126233935_3172726427822974132_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F5urPqcSc_8Q7kNvwHa4SEJ&_nc_oc=AdrulTtJL8R5tn3s44mnG1cFPgbZXaUotaXZKTSLZ5NY3va1-yJzypGAb12RsSdj0uQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTws4pJ2_EcXWhwcgHcX0GLZyQOtn12RvHtaKYd7GM7uQ&oe=6AF9C4FE"}, "display_name": "Media Review", "keywords": ["creative", "review", "videos", "collaborative", "multiplayer"], "long_description": "**Media Review** is a collaborative VR video review tool for the Meta Quest. Watch footage together in real-time with frame-accurate synced playback across user headsets.\n\n## **FRAME .IO INTEGRATION**\nBrowse your Frame projects, download assets directly to your headset, and create shared review rooms. Post timestamped comments and draw annotations on-screen \u2014 all synced back to Frame.io.\n\n## **SYNCED MULTIPLAYER**\nUp to 16 participants watch simultaneously with sub-second sync. Hosts control playback and guest permissions. Built-in voice chat keeps the conversation going, and networked laser pointers let everyone point at what matters.\n\n## **PROFESSIONAL TRANSPORT**\nSingle-frame stepping, jog scrub via thumb stick, and three timecode formats (standard, frame count, SMPTE). Adjustable playback speed and playlist support with drag-to-reorder.\n\n## **STEREOSCOPIC PLAYBACK**\nSupports rectilinear, 180 and 360 (all in mono and stereo, both over under and side-by-side).\n\nMusic: New Life \u2014 Moire \u2014 uppbeat.io \u2014 ECTJR7ZBMUI8LTCZ", "short_description": "Review videos together in VR! Media Review syncs playback across all headsets so teams can watch, discuss, and annotate content simultaneously \u2014 whether streaming from Frame.io or playing local files.\n\n- Frame.io integration - downloads, comments and drawn annotations\n- Synced playback (for up to 20 users)\n- Image Controls - like color, convergence and crop controls\n- Frame-accurate transport with SMPTE timecode\n- Voice chat and networked laser pointer\n- Speech-to-text notes with timecode stamps"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.facebook.com/privacy/policy/", "de
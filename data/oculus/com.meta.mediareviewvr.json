64.5771-25/756589809_1854770799221808_5220201105006514773_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5YKcaQl619MQ7kNvwFm0xLy&_nc_oc=AdptO0VTZ_2mqY69m9m4tRxQ1OFEI1AFozunTtuYuxlgFG9zmJsl1vxb8qfuO9jgs0E&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNt-0rIlKs2ISTsFfYEckO6tPc3Oy4g5SP6wcQ70y9x1g&oe=6AC7A937"}, {"file_name": "void_01_00_02_17.png", "id": "1121422300419901", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/595129854_1121422303753234_6555510923288677606_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e4IV8u7EZjMQ7kNvwFDbkr6&_nc_oc=Adr_8k0WQcFDcx-EMdB5oblyzp4-_TyvPPlu_BV1lc1wcob2AihkmnwPI6iDh3aRfv4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPKEz0bc0aqZiy1tNCoi4GnaekE2nPFgUYg97UadeQk3Q&oe=6AC7B164"}, {"file_name": "com_00_01_12_19.png", "id": "1603985808130759", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/673531334_1603985811464092_3861902782037551871_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KfJfGfPndnYQ7kNvwFlurXb&_nc_oc=AdoSasDV2YIwqgLoctOwRJfwvTCQu8W3oZpAcGvcQcyagnn1G_4249aXoRwPG3iEbRE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNO8m351ncZKIeiwiHviSKTCJSRaaT6tyHhIcZk99nvgg&oe=6AC7BA1D"}, {"file_name": "com_00_02_01_03.png", "id": "28493785020272581", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/595119480_28493785023605914_9081470104433155410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WWXrGlHXxrMQ7kNvwE_ditZ&_nc_oc=AdpZbQJLcXefaO3bWZnMoObRUSm2myR4XCeKF4SzmRbsEqwXPavw85QYJ3OWOSkH3Lw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPVIPs-wpot5bimqNwF7aapzX5IUMYPStl5cOkSwpUXdg&oe=6AC7B86F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "title.png", "id": "1097778122900602", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/593761155_1097778126233935_3172726427822974132_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-TZ-7MBjvXkQ7kNvwGgWNlU&_nc_oc=AdoOD6ncYbiOZevB1CNEuRubcEfHRBxROn-ebdJLlI5X85Jp_5Fe6gLetWtraj9Nd8g&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO1jEJv19f1se0nbu36vvqinLTwvRPPUcZvqPt5BPvsZA&oe=6AC7ABFE"}, "display_name": "Media Review", "keywords": ["creative", "review", "videos", "collaborative", "multiplayer"], "long_description": "**Media Review** is a collaborative VR video review tool for the Meta Quest. Watch footage together in real-time with frame-accurate synced playback across user headsets.\n\n## **FRAME .IO INTEGRATION**\nBrowse your Frame projects, download assets directly to your headset, and create shared review rooms. Post timestamped comments and draw annotations on-screen \u2014 all synced back to Frame.io.\n\n## **SYNCED MULTIPLAYER**\nUp to 16 participants watch simultaneously with sub-second sync. Hosts control playback and guest permissions. Built-in voice chat keeps the conversation going, and networked laser pointers let everyone point at what matters.\n\n## **PROFESSIONAL TRANSPORT**\nSingle-frame stepping, jog scrub via thumb stick, and three timecode formats (standard, frame count, SMPTE). Adjustable playback speed and playlist support with drag-to-reorder.\n\n## **STEREOSCOPIC PLAYBACK**\nSupports rectilinear, 180 and 360 (all in mono and stereo, both over under and side-by-side).", "short_description": "Review videos together in VR! Media Review syncs playback across all headsets so teams can watch, discuss, and annotate content simultaneously \u2014 whether streaming from Frame.io or playing local files.\n\n- Frame.io integration - downloads, comments and drawn annotations\n- Synced playback (for up to 20 users)\n- Image Controls - like color, convergence and crop controls\n- Frame-accurate transport with SMPTE timecode\n- Voice chat and networked laser pointer\n- Speech-to-text notes with timecode stamps"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.facebook.com/privacy/policy/", "developer_terms_of_service_url": null, "publisher_name": "Meta RLE", "suppo
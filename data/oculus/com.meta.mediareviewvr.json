958565723_8506211122184864608_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D8cAEVn5pO4Q7kNvwEP-QEo&_nc_oc=AdpoTras8uGwmZXSxgc_HDzPTJBOtP61lFLJ_kxuvWLGmNiwOyt1HNumWnTrG3TMC80&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKTLnzeekBFH6BffF5D9pIIevbI9dxoRiTkk8cY5JOLlg&oe=6AB000DE"}, {"file_name": "screenshot_26.png", "id": "3393168994198951", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499627502_3393168997532284_4012274785949412253_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NitmP5rBVjcQ7kNvwEVpvS2&_nc_oc=AdohodcAVyTgbkluopWNRJYQvtk3TnO3AxycTbf0jLbvMrZMKyz3aec7g3Pnr9h_-0c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6sXAdsntXVj1G9A2nsoc3UFLDHdU3qxGMa8GxhHEROA&oe=6AAFF832"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "title.png", "id": "1097778122900602", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593761155_1097778126233935_3172726427822974132_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h5sUER80RvcQ7kNvwECyqWm&_nc_oc=Adrzqd_TiAyQLX58EJOOQ7boXOMQ_y-oy4A9lDLMRvnpb8QHuGoGzxIsZXXVu5bcyaY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-P4SRaX_FqueYPMutYVmu0tu-gSxk7olrije3jxQ7Kw&oe=6AAFF0FE"}, "display_name": "Media Review", "keywords": ["creative", "review", "videos", "collaborative", "multiplayer"], "long_description": "**Media Review** is a collaborative VR video review tool for the Meta Quest. Watch footage together in real-time with frame-accurate synced playback across user headsets.\n\n## **FRAME .IO INTEGRATION**\nBrowse your Frame projects, download assets directly to your headset, and create shared review rooms. Post timestamped comments and draw annotations on-screen \u2014 all synced back to Frame.io.\n\n## **SYNCED MULTIPLAYER**\nUp to 16 participants watch simultaneously with sub-second sync. Hosts control playback and guest permissions. Built-in voice chat keeps the conversation going, and networked laser pointers let everyone point at what matters.\n\n## **PROFESSIONAL TRANSPORT**\nSingle-frame stepping, jog scrub via thumb stick, and three timecode formats (standard, frame count, SMPTE). Adjustable playback speed and playlist support with drag-to-reorder.\n\n## **STEREOSCOPIC PLAYBACK**\nSupports rectilinear, 180 and 360 (all in mono and stereo, both over under and side-by-side).", "short_description": "Review videos together in VR! Media Review syncs playback across all headsets so teams can watch, discuss, and annotate content simultaneously \u2014 whether streaming from Frame.io or playing local files.\n\n- Frame.io integration - downloads, comments and drawn annotations\n- Synced playback (for up to 20 users)\n- Image Controls - like color, convergence and crop controls\n- Frame-accurate transport with SMPTE timecode\n- Voice chat and networked laser pointer\n- Speech-to-text notes with timecode stamps"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.facebook.com/privacy/policy/", "developer_terms_of_service_url": null, "publisher_name": "Meta RLE", "support_website_url": null, "website_url": "https://watchparty.cf.metafb.cloud/site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP", "MULTI_USER", "MULTI_USER", "SINGLE_USER", "MULTI_USER"], "id": "35465330823115185"}}]}, "scheduled_offers"
64.5771-25/756589809_1854770799221808_5220201105006514773_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5YKcaQl619MQ7kNvwEleDAk&_nc_oc=AdreVb-VTiRiGyEat5tgfvePud2e7kwjNfaMi3iiZN-dQvkI8JrWS_LvRrYBVURQWqU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMaDk_7c1uuKqDs5qjwCHM0B3W_1tkAlQzDbsZ865AjoA&oe=6ACA4C37"}, {"file_name": "void_01_00_02_17.png", "id": "1121422300419901", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/595129854_1121422303753234_6555510923288677606_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EqhOGtMZe3YQ7kNvwHfAJN0&_nc_oc=AdrnhyT9-Ue5LxIQqim5EteFgMnyeTC2ZTGCsmxa7O5w_Sre2IclubbruuMPnCOiQno&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN4ob8Y1J-8Ue35TPDKCs-SWXHBtNE_My8x2E496ZPnAA&oe=6ACA5464"}, {"file_name": "com_00_01_12_19.png", "id": "1603985808130759", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673531334_1603985811464092_3861902782037551871_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KfJfGfPndnYQ7kNvwH5sHkY&_nc_oc=AdpV6tr25b1rsSekcCJKsfjaCbEh92OZzOXfGDoBWQe8ubRgqfE0k86QIjmu3VeKJAg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOjeEfz68UZaGjhUpJ-gB2bahApipGa16ALtWZ-PFjF2A&oe=6ACA5D1D"}, {"file_name": "com_00_02_01_03.png", "id": "28493785020272581", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/595119480_28493785023605914_9081470104433155410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yEEBX7anD38Q7kNvwGS0es4&_nc_oc=AdoFk18_uuz29NV7Bj83x2ThhgECgdx2RAzLXcEDE-EarY0Q4pMudx8C3hNIOCdUXVU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPRrR47n1rut7es6LidDs8LX8AtpZ9POLniJJSe7xG4ww&oe=6ACA5B6F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "title.png", "id": "1097778122900602", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593761155_1097778126233935_3172726427822974132_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gbKqPEVjUS8Q7kNvwEymVHD&_nc_oc=Ado3Sq1QS4poMZq5sfKRKUGe1tWVHJUbM1zsBfyzmeKQr2YB27A1dOfyVtmCJHPNUz0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM9f9shLfv76RbT0vl8cbMfyQcSxRsNxThDtzwjqh0mUg&oe=6ACA4EFE"}, "display_name": "Media Review", "keywords": ["creative", "review", "videos", "collaborative", "multiplayer"], "long_description": "**Media Review** is a collaborative VR video review tool for the Meta Quest. Watch footage together in real-time with frame-accurate synced playback across user headsets.\n\n## **FRAME .IO INTEGRATION**\nBrowse your Frame projects, download assets directly to your headset, and create shared review rooms. Post timestamped comments and draw annotations on-screen \u2014 all synced back to Frame.io.\n\n## **SYNCED MULTIPLAYER**\nUp to 16 participants watch simultaneously with sub-second sync. Hosts control playback and guest permissions. Built-in voice chat keeps the conversation going, and networked laser pointers let everyone point at what matters.\n\n## **PROFESSIONAL TRANSPORT**\nSingle-frame stepping, jog scrub via thumb stick, and three timecode formats (standard, frame count, SMPTE). Adjustable playback speed and playlist support with drag-to-reorder.\n\n## **STEREOSCOPIC PLAYBACK**\nSupports rectilinear, 180 and 360 (all in mono and stereo, both over under and side-by-side).", "short_description": "Review videos together in VR! Media Review syncs playback across all headsets so teams can watch, discuss, and annotate content simultaneously \u2014 whether streaming from Frame.io or playing local files.\n\n- Frame.io integration - downloads, comments and drawn annotations\n- Synced playback (for up to 20 users)\n- Image Controls - like color, convergence and crop controls\n- Frame-accurate transport with SMPTE timecode\n- Voice chat and networked laser pointer\n- Speech-to-text notes with timecode stamps"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.facebook.com/privacy/policy/", "developer_terms_of_service_url": null, "publisher_name": "Meta RLE", "suppo
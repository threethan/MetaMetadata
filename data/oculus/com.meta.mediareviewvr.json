9_1080618928009140_9167876484944534708_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TYlyc0eKy38Q7kNvwES0cQY&_nc_oc=AdpfGhch8TwNzXQ3dJr2BTeRVXXMKyN9yf28FiXERv1nX0c5F69g7Zo54hiNtUP7zLQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIThbjQlbRvbaQf2-w9I6j5Ojbf5VWN4JiKilDcXlv0xw&oe=6ABD286C"}, {"file_name": "screenshot_21.png", "id": "1681709422921940", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499624656_1681709426255273_1572262595466382038_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sW8ClopViGgQ7kNvwH4xIhZ&_nc_oc=AdqLqicsXz_ceI9lE_KGCdQYgI48cYGbC3x3jNj8nh2rtEBN-fjWodUgA_uFi_LVoik&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL32V_0TXjmT9BH5Mt3znvd9PAfKTCafu5oS-UzYJLpqg&oe=6ABD2A2F"}, {"file_name": "screenshot_24.png", "id": "1801321804618177", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499628456_1801321807951510_754947562919542977_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YcnuMsr9D10Q7kNvwHZvJ8M&_nc_oc=AdrAuSmkStCewHteR98LQoB4YaHDnN70A9gHmuKf52t-NufPC7K5ba8A6PMOddtUilo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJkUTaZuinkOttl3-koqHPmIgaK9MWnq1yikvbX3gxEg&oe=6ABD254B"}, {"file_name": "screenshot_25.png", "id": "1692023955232390", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499620559_1692023958565723_8506211122184864608_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CkZJ4-wGfwgQ7kNvwEAc2VF&_nc_oc=AdrWgmKZwDmmU8MgzUybt9sOT5oRp1HwAWM0phi69ZcYZ9_BsHmhKO6M29qXaHuyrJw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDhrWraQCpC-mE986d82xRdoA_m8VgsyaPYqxrL25CHA&oe=6ABD2FDE"}, {"file_name": "screenshot_26.png", "id": "3393168994198951", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499627502_3393168997532284_4012274785949412253_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6YkVwE2LSWoQ7kNvwG97grt&_nc_oc=AdrlQN5AcXpyGPT44OFArdjvfZ2CSRefJkFE_XRfFJzUiPjQn9wlnWMDiWFr29XX6Zs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJAKjOTPBcMfz71cTiF9OJRmoZAAz_dj3B0rfhJOPzOoA&oe=6ABD2732"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "title.png", "id": "1097778122900602", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/593761155_1097778126233935_3172726427822974132_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UvGVxW_8WDwQ7kNvwERxvHf&_nc_oc=AdrcCprs4RMzlqUO8CpN-VDn6E47GhzenmtQnHii0jVoLvwkkQr_kDPNVlcmLD1-ouc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLoKGXJ1RrKXIxc3MELr0DLL4ygLICrtfXfcZU-dQ3zQ&oe=6ABD1FFE"}, "display_name": "Media Review", "keywords": ["creative", "review", "videos", "collaborative", "multiplayer"], "long_description": "**Media Review** is a collaborative VR video review tool for the Meta Quest. Watch footage together in real-time with frame-accurate synced playback across user headsets.\n\n## **FRAME .IO INTEGRATION**\nBrowse your Frame projects, download assets directly to your headset, and create shared review rooms. Post timestamped comments and draw annotations on-screen \u2014 all synced back to Frame.io.\n\n## **SYNCED MULTIPLAYER**\nUp to 16 participants watch simultaneously with sub-second sync. Hosts control playback and guest permissions. Built-in voice chat keeps the conversation going, and networked laser pointers let everyone point at what matters.\n\n## **PROFESSIONAL TRANSPORT**\nSingle-frame stepping, jog scrub via thumb stick, and three timecode formats (standard, frame count, SMPTE). Adjustable playback speed and playlist support with drag-to-reorder.\n\n## **STEREOSCOPIC PLAYBACK**\nSupports rectilinear, 180 and 360 (all in mono and stereo, both over under and side-by-side).", "short_description": "Review videos together in VR! Media Review syncs playback across all headsets so teams can watch, discuss, and annotate content simultaneously \u2014 whether streaming from Frame.io or playing local files.\n\n- Frame.io integration - downloads, comments and drawn annotations\n- Synced playback (for up to 20 users)\n- Image Controls - like color, convergence and crop controls\n- Frame-accurate transport with SMPTE timecode\n- Voice chat and networked laser pointer\n- Speech-to-text notes with timecode stamps"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.facebook.com/privacy/policy/", "developer_terms_of_service_url": null, "publisher_name": "Meta RLE", "support_website_url": null, "website_url": "https://watchparty.cf.metafb.cloud/site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP", "MULTI_USER", "MULTI_USER", "SINGLE_USER", "MULTI_USER"], "id": "35465330823115185"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/596068480_2159290284801075_3621950447675314003_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=66sz9u3KjXoQ7kNvwEkplJt&_nc_oc=AdouQCmvJ6v6z4WltFDBGpYEO7OV9paBzjscCqS2-1TAiPmnk0urbze90UO4xS74KCg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKF4KMcrtQ5necpwGbRia3IbN2Dt830VM2bXJdW0R4_Fg&oe=6ABD01A9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Media Review", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_
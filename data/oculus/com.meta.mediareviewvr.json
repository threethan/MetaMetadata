64.5771-25/756589809_1854770799221808_5220201105006514773_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PgW_wXNkkkIQ7kNvwHyvNtP&_nc_oc=AdpfLyD6qy7qFoXRnotApKwsqh7FSFTh1t70SkqI-9wEfzJSrFSnp3mIK4k0svd6CNU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNm0me_A2tCDo4te9io_EwWbKUNefw2bsCNETe1HGRSPg&oe=6AC111B7"}, {"file_name": "void_01_00_02_17.png", "id": "1121422300419901", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/595129854_1121422303753234_6555510923288677606_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lol0KosSzhoQ7kNvwFHTX5T&_nc_oc=AdrEk7FMMBnNAlKRJhGgdJ3trDixH8S90RvK7Jk8o87Zgo-6yIfZV38mvbsGHDcyD-o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNrCg4WYcBTZQmsRRqGTAJGqxALggLp1x_cr17Dadf3ZA&oe=6AC119E4"}, {"file_name": "com_00_01_12_19.png", "id": "1603985808130759", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673531334_1603985811464092_3861902782037551871_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yEIcARgyZEUQ7kNvwFqghwg&_nc_oc=AdrlglNfyPyt1VgWR_GAGzfddJhzlqAs5Zknq8hlhg27K7f9DBerWWHRKp2an4EIzSQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN9D6rj0DKkpb9NFk60Zqc4n_oMLfKg1OCDTF6YqfVfSA&oe=6AC1229D"}, {"file_name": "com_00_02_01_03.png", "id": "28493785020272581", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/595119480_28493785023605914_9081470104433155410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TvDH7n4KxPQQ7kNvwH7Fu6G&_nc_oc=Ado9kLVUr3_SvU_N_3eSlbbz5xzrA0Dp3703iJftMpF_HTfZo89NPnGawNy4lCelrQo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOykzJw_ea9I7gWh9YYkUoAQlvfbvOiycmZ9_jogwdGHw&oe=6AC120EF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "title.png", "id": "1097778122900602", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593761155_1097778126233935_3172726427822974132_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4PYci4VHTQAQ7kNvwGWneUy&_nc_oc=AdrFudcmFaik2ak0ytVafyo0IXQHhW4znNr4y3rlgmePlm5YZuKyN5evEkNhnlVPB84&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMuyMwoBXXF40wNs8TR2JIJeFkZ5-laqp6_oUsSN8vCBQ&oe=6AC1147E"}, "display_name": "Media Review", "keywords": ["creative", "review", "videos", "collaborative", "multiplayer"], "long_description": "**Media Review** is a collaborative VR video review tool for the Meta Quest. Watch footage together in real-time with frame-accurate synced playback across user headsets.\n\n## **FRAME .IO INTEGRATION**\nBrowse your Frame projects, download assets directly to your headset, and create shared review rooms. Post timestamped comments and draw annotations on-screen \u2014 all synced back to Frame.io.\n\n## **SYNCED MULTIPLAYER**\nUp to 16 participants watch simultaneously with sub-second sync. Hosts control playback and guest permissions. Built-in voice chat keeps the conversation going, and networked laser pointers let everyone point at what matters.\n\n## **PROFESSIONAL TRANSPORT**\nSingle-frame stepping, jog scrub via thumb stick, and three timecode formats (standard, frame count, SMPTE). Adjustable playback speed and playlist support with drag-to-reorder.\n\n## **STEREOSCOPIC PLAYBACK**\nSupports rectilinear, 180 and 360 (all in mono and stereo, both over under and side-by-side).", "short_description": "Review videos together in VR! Media Review syncs playback across all headsets so teams can watch, discuss, and annotate content simultaneously \u2014 whether streaming from Frame.io or playing local files.\n\n- Frame.io integration - downloads, comments and drawn annotations\n- Synced playback (for up to 20 users)\n- Image Controls - like color, convergence and crop controls\n- Frame-accurate transport with SMPTE timecode\n- Voice chat and networked laser pointer\n- Speech-to-text notes with timecode stamps"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.facebook.com/privacy/policy/", "developer_terms_of_service_url": null, "publisher_name": "Meta RLE", "suppo
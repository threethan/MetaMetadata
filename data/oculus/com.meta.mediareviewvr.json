4.5771-25/756589809_1854770799221808_5220201105006514773_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VKg_SBS6HFMQ7kNvwEmdQq0&_nc_oc=AdqOXmaOT5Meo_xFMvElMZ0QdvzBGJ7r84MH01n_ZfrCeG8MoS-4iCq8nVUXV71Tfp0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVeVEvfzA3UxP0WtpNyKw7Ng4NJxIwyFicED7aIHWgFQ&oe=6AF71F37"}, {"file_name": "void_01_00_02_17.png", "id": "1121422300419901", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/595129854_1121422303753234_6555510923288677606_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=huQoionEI6oQ7kNvwENyhA4&_nc_oc=Ado3j81uNGlJ7Nfwn4OsAbxLLD-OyiIeAz0_0KyYO1sxYaP6K6-FEtzfTz_26cqRxm0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0d9_ZAlfJgwdXYYQi9WDald50v5NMxY4Wtay11XO1vw&oe=6AF72764"}, {"file_name": "com_00_01_12_19.png", "id": "1603985808130759", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673531334_1603985811464092_3861902782037551871_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S4jMaJanB5AQ7kNvwE348Lo&_nc_oc=Ado_lH2Y6LnCaOrGdaO4iV2L0-5vHdPwK5op2K7fe6RWY1-DdZQkWiQd_Tg911uk2Mc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-CXrlwMIZ8O4QV0Uv61yW-pxNhIilMkngPp_PnYpzWg&oe=6AF7301D"}, {"file_name": "com_00_02_01_03.png", "id": "28493785020272581", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/595119480_28493785023605914_9081470104433155410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y-Qr2vGnLRkQ7kNvwEW6c3Y&_nc_oc=AdoSBdNivwNXbMDzb46TppdQhglw0p8p4VCpBycORX7W_OGrWDS0gJT9D83Ou0a9OGI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLWgrajE85jiqNX924JWVDHR0HO357vsWfdkqJ72aQJg&oe=6AF72E6F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "title.png", "id": "1097778122900602", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593761155_1097778126233935_3172726427822974132_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AzkLxHWB8_cQ7kNvwF1JPQz&_nc_oc=AdoOq-u-rex3ZamA_BzeaaYp0dxL-NfZL0Pk8mGtFA_CO4KQH3Yc29eiicWv7jfukzQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS68W52xndKhr-RSr4vbUT1wvKQ4hVgsICzbmxt23aIOQ&oe=6AF721FE"}, "display_name": "Media Review", "keywords": ["creative", "review", "videos", "collaborative", "multiplayer"], "long_description": "**Media Review** is a collaborative VR video review tool for the Meta Quest. Watch footage together in real-time with frame-accurate synced playback across user headsets.\n\n## **FRAME .IO INTEGRATION**\nBrowse your Frame projects, download assets directly to your headset, and create shared review rooms. Post timestamped comments and draw annotations on-screen \u2014 all synced back to Frame.io.\n\n## **SYNCED MULTIPLAYER**\nUp to 16 participants watch simultaneously with sub-second sync. Hosts control playback and guest permissions. Built-in voice chat keeps the conversation going, and networked laser pointers let everyone point at what matters.\n\n## **PROFESSIONAL TRANSPORT**\nSingle-frame stepping, jog scrub via thumb stick, and three timecode formats (standard, frame count, SMPTE). Adjustable playback speed and playlist support with drag-to-reorder.\n\n## **STEREOSCOPIC PLAYBACK**\nSupports rectilinear, 180 and 360 (all in mono and stereo, both over under and side-by-side).\n\nMusic: New Life \u2014 Moire \u2014 uppbeat.io \u2014 ECTJR7ZBMUI8LTCZ", "short_description": "Review videos together in VR! Media Review syncs playback across all headsets so teams can watch, discuss, and annotate content simultaneously \u2014 whether streaming from Frame.io or playing local files.\n\n- Frame.io integration - downloads, comments and drawn annotations\n- Synced playback (for up to 20 users)\n- Image Controls - like color, convergence and crop controls\n- Frame-accurate transport with SMPTE timecode\n- Voice chat and networked laser pointer\n- Speech-to-text notes with timecode stamps"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.facebook.com/privacy/policy/", "de
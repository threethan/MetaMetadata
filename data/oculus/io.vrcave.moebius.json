lMHgFJ014o-CeGoRsLuMA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2QBwyg6ffyyeIrZR5ziNM1xHRBV_OEuygZKKw0-u6Xw&oe=6AF9CECC"}, {"file_name": "io.vrcave.moebius-20250801-141726 2.png", "id": "1160850929399899", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823893_1160850932733232_2097996787713791830_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=11f86i1oN5YQ7kNvwFasXoX&_nc_oc=AdoEeF31NskG8KOPju-DIHNfTOLEwwRvY6gNTZhCre0r13JQnhmGsN4jbvE9PgJ7zXc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7bCrnjJdb9T9Y3fOvs0nJ1TCDPvCCA324s3v-uE6ZPw&oe=6AF9CDFE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art Landscape.png", "id": "3976625399242448", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491827071_3976625402575781_2114632208145882970_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zI7gXvUAyeMQ7kNvwEfxs32&_nc_oc=Adr0HITMO4O6yTUpz7rnPrg9CKR7-HAYMUFcba3f9Y8BamnTKQ-_EK-jbiBJko4fqTo&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRaaLPY4sSCZBdvOCW501xbcZ-GioOUoFlAjCWdzTXOyQ&oe=6AF9D70C"}, "display_name": "Heroes Together VR", "keywords": ["multiplayer", "social", "team", "fighting", "class"], "long_description": "**BUILT FOR VR; MADE FOR FRIENDS**\n\nHEROES TOGETHER VR is a vibrant VR roguelite packed with co-op exploration, teamwork, and deadly challenges. \n\nThe world is broken and  Tetherfall stands alone as the last bastion of stability. Join your friends to protect it from the evil Lord Sunder \u2014 and just maybe find a way to fight back against the forces of chaos he unleashed.\n\n**UNITE AND FIGHT TOGETHER**\n\nChoose from four classes and master your abilities to delve deeper and deeper into an ever-changing world. Swing your sword, shoot your bow, cast spells or fight with your fists to traverse this treacherous world. Experiment and find the playstyle that's right for you \u2014 then level it up to unlock all its secrets. Every player brings something new to the team. \n\n**DYNAMIC PROCEDURAL GENERATION**\n\nEach run recombines rooms, encounters, combat, and loot in new ways. No session will ever be the same, meaning you have to be ready for anything! Drop in with friends or make new ones as you explore multiple intricate biomes together. Through every door lies a new challenge.\n\n**SOCIAL FIRST**\n\nDesigned from the ground up as a multiplayer dungeon crawler, Heroes Together VR is tightly balanced around groups of players exploring together. From boss fights to combat encounters to hanging out between sessions, Heroes Together VR is all about... being better together.\n\n**VR FOR ANYONE**\n\nTeam up with your friends for never-ending action and infinite replayability. Wishlist Heroes Together VR!", "short_description": "Gather your friends and dive into a world of magic and adventure in HEROES TOGETHER VR, a roguelite dungeon crawler designed for VR. Choose your hero, explore procedurally generated biomes, battle magical monsters, and master your skills together as a team in this epic co-op quest. \n\nSwing swords, shoot bows, cast spells, or fight with your fists as you battle dynamic encounters and discover powerful loot in a world that changes with every playthrough."}]}, "developer_name": "Basement Bunker Labs", "developer_privacy_policy_url": "https://heroestogethervr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Basement Bunker Labs", "support_website_url": null, "website_url": "https://heroestogethervr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": n
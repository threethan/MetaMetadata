rrZLNXqUaVEI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4vJ0yRTWux3XgrilINtUu-acDWGnz_BHGXArKerGFExw&oe=69FB2E62"}, {"file_name": "YES4.png", "id": "202891426223143", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036644_202891429556476_5958224221900062947_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ofvhciARN8wQ7kNvwHz_b5u&_nc_oc=AdqdOQE4goNatNWDEf2z_uFSot6xVQ-rw1VCGdFE5Lg33AZtb3iycXEGl_fc3tVU8OY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7WMFYJgawO4k9JW3UMGaIa3KrWY6Wxl97LKZSN01wPZA&oe=69FB2FE1"}, {"file_name": "YES5.png", "id": "305075042512480", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75282159_305075045845813_1741575113918231749_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mfbN2yVH-vcQ7kNvwEwG73O&_nc_oc=AdrXoYbIXMRzi4pIwAXUMRquS3FPRhQgb4QGv0vB9bjV-Ov1n5R0-fMbh1j6nr6YDeQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7CiCTEFo9375AwfbIAmGX8wd9I-DcpWVbYAAWrde2inA&oe=69FB3CFA"}, {"file_name": "YES2.png", "id": "763594575580277", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57566685_763594578913610_402822167131551651_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kC45uDGwiL4Q7kNvwHEKD-I&_nc_oc=Adpbigr0y9Dh-uNyYX1PN44vghSLEnEiXtuS-HfP1KATKPPKUtk61CG3hRzcH1pQimw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6iHe6iRbhHmesuQWsr92W4rv5rvic4PnH9WHUsGgS8zQ&oe=69FB5E0E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VR-Alien-Racing-Cover-Assets-01c.png", "id": "6977702768934253", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031457_6977702775600919_7356750813913174640_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NIa-UuAbcdoQ7kNvwFnHqHg&_nc_oc=Adrpm1-vV5Mdy1SMXv-rwstFUvG0FR1_GL6kaqwRxe0FYLI-SvD2Itms9rlybdXcV5o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-CUWESdbRZd8GJEnnSvoXt9airZ05H4CTdfkfnmUHDw&oe=69FB2C8D"}, "display_name": "Swivel", "keywords": [], "long_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, wonder, and excitement.\n\nIn this first-of-its-kind outer space experience, you swivel your way down a cosmic path straight to the dance floor. We recommend using a swivel chair to make those tricky turns a blast!\n\nWhile you\u2019re swiveling towards the dance floor, get ready for a hands-on party - drumming, popping bubbles, opening doors, high-fiving aliens, and collecting music notes.\n\nThe beats? Crafted by the legendary Barry Leitch, these tunes groove with the story and your every move. There's a variety of rides, each with its own style, and the first ride, 'Fly,' is on the house \u2013 your sneak peek into the game's vibe.\n\nSome rides are swivel-heavy, so be prepared for some serious spinning action. And guess what? There are also secret paths to up the fun factor!\n\nSwivel offers a one-of-a-kind immersive experience that our first players have described as part dance party, part thrill ride, and part workout. They felt all kinds of good after playing.\n\nCan you swivel your way to the dance floor while having the most fun possible?\n\nSwivel on and dance!\n\nJoin our Discord to share feedback, requests, and stay on top of what's new: https://discord.gg/HcAXnXXf", "short_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, wonder, and excitement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.swivelvr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Dimensional Dilemma", "support_website_url": null, "website_url": "http://www.swivelvr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_a
dW9LZWnnbWQI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af41QPYf2lVsGcYnPLuwKh9C2SOGjLZTSPK6eIn_d3dDUQ&oe=6A1EFF22"}, {"file_name": "YES4.png", "id": "202891426223143", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036644_202891429556476_5958224221900062947_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PqKBPooXf-0Q7kNvwE-Ymei&_nc_oc=Adp28LuNJMpwYWz7VtHPDYaEIXGQkvCS2kyIbtjMOzdl0rXX_ktepQKKUw1uXmZLXDs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Zu3aoE37OfR8sY1oD71Cbo2P0r9mgtAJAElrepJt1kw&oe=6A1F00A1"}, {"file_name": "YES5.png", "id": "305075042512480", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75282159_305075045845813_1741575113918231749_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DYEtJ4OBjyoQ7kNvwHZinnt&_nc_oc=AdrN-3dsbumcsLw48xdvYJi02oyCUpV5TtomOJlW6mVQSwG1q_K4KUS7mCWZYcR4D9A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5okQve-NQVfEbDrmZxdoi85f57ClP9uRwdA0F6ptrgkg&oe=6A1ED57A"}, {"file_name": "YES2.png", "id": "763594575580277", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566685_763594578913610_402822167131551651_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=va9bJ3AzDJMQ7kNvwG5e--8&_nc_oc=AdosJujImYv_7hwJVCpY9Cz8aNFjfVStFgYwjuXF5zIUIbn3tE4mf_4rqu0jKrw_k-4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4as68s5I0pOanP0-eD5yW6txk2Rn-c-1KZiPxB_qluRA&oe=6A1EF68E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VR-Alien-Racing-Cover-Assets-01c.png", "id": "6977702768934253", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031457_6977702775600919_7356750813913174640_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ckzVhxIXHEQ7kNvwEDu-lE&_nc_oc=AdpFsiI8CzSwRNpVGvMoKLS7Chq4DRfmxquqmGr3zSbDQruK0OaOZTxwoNrSiiGWu7s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4CUNjD43LF0edv-792FpmVWtEovgcHsqFjd7DefYUnZw&oe=6A1EFD4D"}, "display_name": "Swivel", "keywords": [], "long_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, wonder, and excitement.\n\nIn this first-of-its-kind outer space experience, you swivel your way down a cosmic path straight to the dance floor. We recommend using a swivel chair to make those tricky turns a blast!\n\nWhile you\u2019re swiveling towards the dance floor, get ready for a hands-on party - drumming, popping bubbles, opening doors, high-fiving aliens, and collecting music notes.\n\nThe beats? Crafted by the legendary Barry Leitch, these tunes groove with the story and your every move. There's a variety of rides, each with its own style, and the first ride, 'Fly,' is on the house \u2013 your sneak peek into the game's vibe.\n\nSome rides are swivel-heavy, so be prepared for some serious spinning action. And guess what? There are also secret paths to up the fun factor!\n\nSwivel offers a one-of-a-kind immersive experience that our first players have described as part dance party, part thrill ride, and part workout. They felt all kinds of good after playing.\n\nCan you swivel your way to the dance floor while having the most fun possible?\n\nSwivel on and dance!\n\nJoin our Discord to share feedback, requests, and stay on top of what's new: https://discord.gg/HcAXnXXf", "short_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, wonder, and excitement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.swivelvr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Dimensional Dilemma", "support_website_url": null, "website_url": "http://www.swivelvr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_a
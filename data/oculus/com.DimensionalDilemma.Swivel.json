_sid=6e7a0a&_nc_ohc=OT1fHkwSaCEQ7kNvwHoYIT0&_nc_oc=Adq5OiIj7KwYxh22vnQ0iX6Lx6Th8A7BnssCwStkesIh0Socy9_Z8WHvW0E1xOvr_FY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmH6SiVCmHxJ8e-TY5lRH1NtASyW4InS00KteDLMyoTw&oe=6B09A0E4"}, {"file_name": "YES3.png", "id": "1782958078873949", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75195906_1782958082207282_5459036329764607070_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xM7oawsO6IAQ7kNvwGJKjTL&_nc_oc=AdrQmdqRrGQi5RM9AJ7XI7zsAPtnCSbLRbzkA8y_689vDENPi6PWFiNhiSeXQGvTpJ0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtrkZfZzUmu1e_yfu8ndacyEG_REvb6IL6KxyG1HuF_w&oe=6B09C51E"}, {"file_name": "YES4.png", "id": "3605753746407518", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86658875_3605753749740851_5280311873928099391_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wGaK-L5GjzsQ7kNvwGqeE6W&_nc_oc=AdrviHwXRkvMe1qFD0ghklNHWygaH9Vdvl8SExkSX6NKSuogMgZf8pG0qaJJck-N8I0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnl-CfjU90N0OqjWVnC1iick9LYVM1Atnr3PxdjXy1tw&oe=6B09B950"}, {"file_name": "YES5.png", "id": "397310236287601", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031528_397310239620934_6959116179281752500_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tWTX1lihhlwQ7kNvwF0pXsp&_nc_oc=Ado3CqyVIzewLUZyxLR3FpmP5bQ_egi71DS4pYDTx_4Z0yPESbnKPEo13lbQPzLJG7M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwOg31pUflAmMbHETh2_vHrHPIT6Sjpvv61sQ7LdMd0Q&oe=6B09A9EE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Swivel_Creative_Landscape.png", "id": "700581638745125", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75348039_700581642078458_1915888512703558944_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8-XTVbVkfvkQ7kNvwEYDPcG&_nc_oc=AdpjpvWJnlmU2WALP82QW4s8oqo_0GDMaD1Rg5l40aoAK8Akv2f6A2RSPI_xT7yuk3k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR82A9Y-skou3Eussz0KYS7fSBGnAjua_O_rjw-FfBk8w&oe=6B09A11F"}, "display_name": "Swivel - With Demo", "keywords": ["ride", "swivel", "seated", "rhythm", "fitness"], "long_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, and excitement.\n\nIn this first-of-its-kind outer space experience, you swivel your way down a cosmic track straight to the dance floor. \n\nWhile you\u2019re swiveling, get ready for a hands-on party - drumming, popping bubbles, opening doors, high-fiving aliens, and collecting music notes.\n\nThe beats? Crafted by the legendary Barry Leitch, these tunes groove with the story and your every move. There are 8 tracks, each with its own style, and the first ride, 'Fly,' is on the house \u2013 your sneak peek into the game's vibe:\n- Fly - pop (free)\n- Love me and leave me- 50s soul\n- Sweet tooth - pop dance\n- Sputnik - dubstep\n- Spin - light metal\n- Winter - classical\n- Wally Beben - retro\n- Ennio Morricone - western\n\nSome rides are swivel-heavy, so be prepared for some serious spinning action. And guess what? There are also secret paths to up the fun factor!\n\n\u2013 Important note \u2013\nPlease take your time easing into the game. After a few days of play, our bodies adjust, and spinning becomes incredibly enjoyable \u2013 it's like tapping into our inner child. \n\n\u2013 Seated game with a minimum play space of 6.5 feet by 6.5 feet \u2013\nSwivel is a seated game that involves turning and making cool moves. Ensure you have at least 3.3ft (1m) of space in all directions.\n\nWe recommend using a \u2018swivel\u2019 chair to make those tricky turns a blast!\n", "short_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, and excitement.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.swivelvr.com/privacypolicy", "developer_terms_of_service_url
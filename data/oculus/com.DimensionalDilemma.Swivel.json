_sid=6e7a0a&_nc_ohc=woAS5uhPT6oQ7kNvwFQiXt4&_nc_oc=AdpVYDOIQWbyV5vIsIdAtGx_3ObrKuLZv0EYtTCZPpWc_38F4wxRZ-9lZxqDKsGLSdc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTndG5wIjBqOFo_0HrAIFPSfMzRFaff4IC_7FHLGWPTaQ&oe=6B030964"}, {"file_name": "YES3.png", "id": "1782958078873949", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75195906_1782958082207282_5459036329764607070_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MZI5bBJudrgQ7kNvwFfuZCI&_nc_oc=Adph5uO8PAlLfBq_y_0GgUXRwwrmURwW-qst6IaroPoeos8ZHMKFvKP4-DNWMx6Fa08&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLb4BQkpC7WmQbDpKjFTbxuLMdEpkwquti21OUm5pVtw&oe=6B032D9E"}, {"file_name": "YES4.png", "id": "3605753746407518", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86658875_3605753749740851_5280311873928099391_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s0FdurNqvioQ7kNvwHj-lk6&_nc_oc=AdpFCqvhrGu6oB_H8DHAtCuBfXDVRbWvQf0jJHmnGn_qLxVyH-iarUJSgHm8N7V_OOM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQeF6birA6mK_thIMwdIKWvKCvA2WQMvwy1ee06MjwtVw&oe=6B0321D0"}, {"file_name": "YES5.png", "id": "397310236287601", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031528_397310239620934_6959116179281752500_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zsydETTPmv8Q7kNvwEpy3Bu&_nc_oc=AdpCfJH7idFld6CN95cGuXykty0KpWzdZkfPJmkg3yDKW6sEP3IRxHtjHejOaxCgYeA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyn1FoAQXQbzBjCYOrnXWNMoDqF9OuIb-u-TUJHkYazg&oe=6B03126E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Swivel_Creative_Landscape.png", "id": "700581638745125", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75348039_700581642078458_1915888512703558944_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vQQadEXDZOoQ7kNvwEGPrRa&_nc_oc=AdqSYAtsZjVZyHnt1D-1-uX08fqj_f4ociBPQkHi0pTwwN_r_vppsMKAfBlsHWQ4oEY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzRAU2l07v8iQSqYmB1QQlReNvPGMjponaRC4t154WNw&oe=6B03099F"}, "display_name": "Swivel - With Demo", "keywords": ["ride", "swivel", "seated", "rhythm", "fitness"], "long_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, and excitement.\n\nIn this first-of-its-kind outer space experience, you swivel your way down a cosmic track straight to the dance floor. \n\nWhile you\u2019re swiveling, get ready for a hands-on party - drumming, popping bubbles, opening doors, high-fiving aliens, and collecting music notes.\n\nThe beats? Crafted by the legendary Barry Leitch, these tunes groove with the story and your every move. There are 8 tracks, each with its own style, and the first ride, 'Fly,' is on the house \u2013 your sneak peek into the game's vibe:\n- Fly - pop (free)\n- Love me and leave me- 50s soul\n- Sweet tooth - pop dance\n- Sputnik - dubstep\n- Spin - light metal\n- Winter - classical\n- Wally Beben - retro\n- Ennio Morricone - western\n\nSome rides are swivel-heavy, so be prepared for some serious spinning action. And guess what? There are also secret paths to up the fun factor!\n\n\u2013 Important note \u2013\nPlease take your time easing into the game. After a few days of play, our bodies adjust, and spinning becomes incredibly enjoyable \u2013 it's like tapping into our inner child. \n\n\u2013 Seated game with a minimum play space of 6.5 feet by 6.5 feet \u2013\nSwivel is a seated game that involves turning and making cool moves. Ensure you have at least 3.3ft (1m) of space in all directions.\n\nWe recommend using a \u2018swivel\u2019 chair to make those tricky turns a blast!\n", "short_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, and excitement.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.swivelvr.com/privacypolicy", "developer_terms_of_service_url
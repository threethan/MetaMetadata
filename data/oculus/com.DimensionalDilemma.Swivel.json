NI_EP_cer1Vo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmdwNTY1ztz1U-Ca33R5AaGcsbELbXa7brl9LUW6VKWw&oe=6A689AE2"}, {"file_name": "YES4.png", "id": "202891426223143", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036644_202891429556476_5958224221900062947_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_8ZYtJ-10AgQ7kNvwHowi20&_nc_oc=Adqc8EJBCcscST4-7yewDctZNlgkwH0sHzcRMSzOVXUuRaw4Kp12a5iZkvstP9RZGTs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZRNoX-3v7JVtoPOA4eMfEFKeQmzyGVnrPpAreg3oJKg&oe=6A689C61"}, {"file_name": "YES5.png", "id": "305075042512480", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75282159_305075045845813_1741575113918231749_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yb7irr1jn1QQ7kNvwF6HLWE&_nc_oc=Adq2fv_o1TpOqetWvSA35R2L0Calqd472BqRP5WDuDhOH3SQ5o5QK-EBlHMSQPDBy8Q&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDcMOIJ7lnBDTKUaL8ReAT_4bvmQlvzB-qr0blQzld69g&oe=6A68A97A"}, {"file_name": "YES2.png", "id": "763594575580277", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57566685_763594578913610_402822167131551651_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XSihdqhiC6wQ7kNvwG1AYcW&_nc_oc=AdoJzDt7AlCmCxiiZMn52F_6_Uasye_enYKF_uwm99Iu5AN6igTXE-pnEgdmcPUf39U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAIlQdupbKS8nL-jBGkg-yzvM7t9kY_MigJtkm9cTkk3g&oe=6A68924E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VR-Alien-Racing-Cover-Assets-01c.png", "id": "6977702768934253", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031457_6977702775600919_7356750813913174640_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6VJ22gN8HzoQ7kNvwH36n61&_nc_oc=Adp_BI_AwqPewC9cV20UPT9TN_2VYLV1Nqlm9eRMvaAGf0S7aT4U7oOrM-TXhCCppkA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBKGCz2yTc7zUyWWqaAGkOvzpF1Nfx7i4fUMsyF-rRPGw&oe=6A68990D"}, "display_name": "Swivel", "keywords": [], "long_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, wonder, and excitement.\n\nIn this first-of-its-kind outer space experience, you swivel your way down a cosmic path straight to the dance floor. We recommend using a swivel chair to make those tricky turns a blast!\n\nWhile you\u2019re swiveling towards the dance floor, get ready for a hands-on party - drumming, popping bubbles, opening doors, high-fiving aliens, and collecting music notes.\n\nThe beats? Crafted by the legendary Barry Leitch, these tunes groove with the story and your every move. There's a variety of rides, each with its own style, and the first ride, 'Fly,' is on the house \u2013 your sneak peek into the game's vibe.\n\nSome rides are swivel-heavy, so be prepared for some serious spinning action. And guess what? There are also secret paths to up the fun factor!\n\nSwivel offers a one-of-a-kind immersive experience that our first players have described as part dance party, part thrill ride, and part workout. They felt all kinds of good after playing.\n\nCan you swivel your way to the dance floor while having the most fun possible?\n\nSwivel on and dance!\n\nJoin our Discord to share feedback, requests, and stay on top of what's new: https://discord.gg/HcAXnXXf", "short_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, wonder, and excitement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.swivelvr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Dimensional Dilemma", "support_website_url": null, "website_url": "http://www.swivelvr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_a
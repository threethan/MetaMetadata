_sid=6e7a0a&_nc_ohc=OT1fHkwSaCEQ7kNvwG04XxZ&_nc_oc=AdrxYobnPzjwEeJRAgOXHrlWQYnwPGSQ2qKIrMopJeg5DEIhDAnRYJ4Sqr3TCNW_-Co&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-E0DbwXpxQsqTDovo-b_sx1FNkgJO9BI7n17XrNh92Q&oe=6B084F64"}, {"file_name": "YES3.png", "id": "1782958078873949", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75195906_1782958082207282_5459036329764607070_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jGO8mwN07uYQ7kNvwGZAtNt&_nc_oc=Adqb4ux6QI8MJ_7e2-Fy9IxHt-CUXVlFNJtycFKpqApKskRXpWHzodv-hGnd-HH5RJQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJ5eO4wxQ6OKBahow3sLCKfdGH9fZezlm5jDppNLOhsw&oe=6B08739E"}, {"file_name": "YES4.png", "id": "3605753746407518", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/86658875_3605753749740851_5280311873928099391_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wGaK-L5GjzsQ7kNvwH7LnaR&_nc_oc=AdryRNjtGPD0a9UqtHFoZsQ0vpnJwz60nSVFYoZnuBE0F04GYlqhDTU6hv_YHvM0LR0&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRuwm0V11mALYZCj_mGa5rZuBVGmSHHuEn3-vLFv75ZAQ&oe=6B0867D0"}, {"file_name": "YES5.png", "id": "397310236287601", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031528_397310239620934_6959116179281752500_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pG5jviWlICQQ7kNvwFHysi3&_nc_oc=AdpoDIo3xJBdygw5Aj9vmfcQZU6sbDtA_dh39xQpkBriu6x3Q-Bk1q8w__rcVHSVbUQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTW8z2yVy9PtifbJIvYaGOJcIS7PAOeSkvAYfZh9L_FUA&oe=6B08586E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Swivel_Creative_Landscape.png", "id": "700581638745125", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75348039_700581642078458_1915888512703558944_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8-XTVbVkfvkQ7kNvwFM0AOn&_nc_oc=Ado4Or93vTmwzzsR1s3ein8u_aYhOYUYidd9yeErfSIcZnW8888ybQDmDKK3Lz_3bWM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgZ27MTnnAbJimO4bxy_UHJNIIiBy_axX05oOVLJIXDA&oe=6B084F9F"}, "display_name": "Swivel - With Demo", "keywords": ["ride", "swivel", "seated", "rhythm", "fitness"], "long_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, and excitement.\n\nIn this first-of-its-kind outer space experience, you swivel your way down a cosmic track straight to the dance floor. \n\nWhile you\u2019re swiveling, get ready for a hands-on party - drumming, popping bubbles, opening doors, high-fiving aliens, and collecting music notes.\n\nThe beats? Crafted by the legendary Barry Leitch, these tunes groove with the story and your every move. There are 8 tracks, each with its own style, and the first ride, 'Fly,' is on the house \u2013 your sneak peek into the game's vibe:\n- Fly - pop (free)\n- Love me and leave me- 50s soul\n- Sweet tooth - pop dance\n- Sputnik - dubstep\n- Spin - light metal\n- Winter - classical\n- Wally Beben - retro\n- Ennio Morricone - western\n\nSome rides are swivel-heavy, so be prepared for some serious spinning action. And guess what? There are also secret paths to up the fun factor!\n\n\u2013 Important note \u2013\nPlease take your time easing into the game. After a few days of play, our bodies adjust, and spinning becomes incredibly enjoyable \u2013 it's like tapping into our inner child. \n\n\u2013 Seated game with a minimum play space of 6.5 feet by 6.5 feet \u2013\nSwivel is a seated game that involves turning and making cool moves. Ensure you have at least 3.3ft (1m) of space in all directions.\n\nWe recommend using a \u2018swivel\u2019 chair to make those tricky turns a blast!\n", "short_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, and excitement.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.swivelvr.com/privacypolicy", "developer_terms_of_service_url
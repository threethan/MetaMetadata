TaVoVU5BYkdWCPWnftU6LseAaalvW0Ug&oe=69B54EE2"}, {"file_name": "YES4.png", "id": "202891426223143", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036644_202891429556476_5958224221900062947_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=REo6NW07TxcQ7kNvwFTOpj-&_nc_oc=Adluz9yC60sz62wkd2KhyctFVoqIMBv0r4xt2M-xTqs15fq-oncBH6pS5qTaIsCo0NM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfygRkJOn7Kf9yKtXIp7lBHBhez9hNpRiUgBDGiHZrh3HA&oe=69B55061"}, {"file_name": "YES5.png", "id": "305075042512480", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75282159_305075045845813_1741575113918231749_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jEzXwIPLZjQQ7kNvwGr8Mtt&_nc_oc=Adkyl6qjHwA6uNAFlkfZfbs4lc7PIf4Tc_Iv3MowgGqexUz2Pl3AncxpdXlGay9rufg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyTcKGxjWllatTAOhnTUTWs84M_Y8RPlINCpvmIk4GKrQ&oe=69B55D7A"}, {"file_name": "YES2.png", "id": "763594575580277", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566685_763594578913610_402822167131551651_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ik9Zutbcu8Q7kNvwFsXlQd&_nc_oc=AdncO_KEuvohVvwi3iRJqBLojA-5Gk-LBfCryDt8T4XYDJx-ULuRNBtuRQM8-cWoGj8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwPn7N6Yk5LniYOgWxKugXDA11GjTlxQkUgGLE-7DJNwQ&oe=69B5464E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VR-Alien-Racing-Cover-Assets-01c.png", "id": "6977702768934253", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031457_6977702775600919_7356750813913174640_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wA4cDE6u9noQ7kNvwFiP8zz&_nc_oc=AdnyGy2M9mY5r5D2bwsgWu4X4ioZOcVr9wMhq_b1xEh3UWDIeci60F4kRX_A6a8lFYw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz24WkPR7Kj5EevGvv1ACeVgJ5lr3i9ep-NXbPGEWERwA&oe=69B54D0D"}, "display_name": "Swivel", "keywords": [], "long_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, wonder, and excitement.\n\nIn this first-of-its-kind outer space experience, you swivel your way down a cosmic path straight to the dance floor. We recommend using a swivel chair to make those tricky turns a blast!\n\nWhile you\u2019re swiveling towards the dance floor, get ready for a hands-on party - drumming, popping bubbles, opening doors, high-fiving aliens, and collecting music notes.\n\nThe beats? Crafted by the legendary Barry Leitch, these tunes groove with the story and your every move. There's a variety of rides, each with its own style, and the first ride, 'Fly,' is on the house \u2013 your sneak peek into the game's vibe.\n\nSome rides are swivel-heavy, so be prepared for some serious spinning action. And guess what? There are also secret paths to up the fun factor!\n\nSwivel offers a one-of-a-kind immersive experience that our first players have described as part dance party, part thrill ride, and part workout. They felt all kinds of good after playing.\n\nCan you swivel your way to the dance floor while having the most fun possible?\n\nSwivel on and dance!\n\nJoin our Discord to share feedback, requests, and stay on top of what's new: https://discord.gg/HcAXnXXf", "short_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, wonder, and excitement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.swivelvr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Dimensional Dilemma", "support_website_url": null, "website_url": "http://www.swivelvr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null
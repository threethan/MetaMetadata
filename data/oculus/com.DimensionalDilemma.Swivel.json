6A6891A4"}, {"file_name": "YES3.png", "id": "1782958078873949", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75195906_1782958082207282_5459036329764607070_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BksnJ0HeXzgQ7kNvwGXVJtq&_nc_oc=Ado7HVtZJf6caW1aVE2HccGQegMnkQu1JSCSbFFMV5gKeXr57FfG_wBd281lSR358aA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDLxA9QgYhO52WwE5thITsx5ZpWRKvzw43ARA9VA1hdtQ&oe=6A68B5DE"}, {"file_name": "YES4.png", "id": "3605753746407518", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86658875_3605753749740851_5280311873928099391_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ca8bs06w8AYQ7kNvwECEWj5&_nc_oc=AdqYrV5O11MBM1E9jfKI8Visw-HucBZTJdn7ZWC4IMNFl7OWoTPedABLpDzQtAE74j0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQABX9zkqBJIzG8s57iJzRmXhp59cSc-2mw11iAD5aS9dw&oe=6A68AA10"}, {"file_name": "YES5.png", "id": "397310236287601", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031528_397310239620934_6959116179281752500_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8dZrWR_o4hcQ7kNvwE2tvmS&_nc_oc=Adq-IBTg6K32SMeCxnVcOJeoEqzcSFu82bUz7DixoYApXwFZQ-vDQubL6yPNcJ_vJp0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCvBnqQpmvB64Xk6g2yY5tEhCgwNOGmUcdxCx2w3uIPXQ&oe=6A689AAE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Swivel_Creative_Landscape.png", "id": "700581638745125", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75348039_700581642078458_1915888512703558944_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o4riKJvxq_MQ7kNvwFFhZRH&_nc_oc=AdoO14bVciziJWzOu0aguL9dus_KZ6BekzHYXRRQlztL_5Z5e1gePLjxZG0yEQoaAUs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB0XUpDKclwkY5m2RVSEPa7Mcvq6J9BYxeN4iq-SIRjRw&oe=6A6891DF"}, "display_name": "Swivel - With Demo", "keywords": ["ride", "swivel", "seated", "rhythm", "fitness"], "long_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, and excitement.\n\nIn this first-of-its-kind outer space experience, you swivel your way down a cosmic track straight to the dance floor. \n\nWhile you\u2019re swiveling, get ready for a hands-on party - drumming, popping bubbles, opening doors, high-fiving aliens, and collecting music notes.\n\nThe beats? Crafted by the legendary Barry Leitch, these tunes groove with the story and your every move. There are 8 tracks, each with its own style, and the first ride, 'Fly,' is on the house \u2013 your sneak peek into the game's vibe:\n- Fly - pop (free)\n- Love me and leave me- 50s soul\n- Sweet tooth - pop dance\n- Sputnik - dubstep\n- Spin - light metal\n- Winter - classical\n- Wally Beben - retro\n- Ennio Morricone - western\n\nSome rides are swivel-heavy, so be prepared for some serious spinning action. And guess what? There are also secret paths to up the fun factor!\n\n\u2013 Important note \u2013\nPlease take your time easing into the game. After a few days of play, our bodies adjust, and spinning becomes incredibly enjoyable \u2013 it's like tapping into our inner child. \n\n\u2013 Seated game with a minimum play space of 6.5 feet by 6.5 feet \u2013\nSwivel is a seated game that involves turning and making cool moves. Ensure you have at least 3.3ft (1m) of space in all directions.\n\nWe recommend using a \u2018swivel\u2019 chair to make those tricky turns a blast!\n", "short_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, and excitement.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.swivelvr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Dimensional Dilemma", "support_website_url": "https://www.swivelvr.com/contact-us", "website_url": "http://www.swivelvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "
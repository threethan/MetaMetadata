qNbxszjt97aM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_3QC0IxtoqG2SqcRs6Ntz-aLKgYnrV99npIc1vbDmdA&oe=6A2839A2"}, {"file_name": "YES4.png", "id": "202891426223143", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036644_202891429556476_5958224221900062947_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=COm4eq5KFgYQ7kNvwGOWh6_&_nc_oc=AdrI9PvQ8c8G_x4lKz0iNB9zmPUL-3zHisURsedAVdlBTOS3Vq7dtQPwBMPIShAmhhw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9GfYa-RdyjCTkZANi2wov_3Pn4TPbdQmPC10qkRyBsqQ&oe=6A283B21"}, {"file_name": "YES5.png", "id": "305075042512480", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75282159_305075045845813_1741575113918231749_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eu-MDBuwT6EQ7kNvwFxUGI2&_nc_oc=AdoQfGry_XiGHAYmfPKKuc7rXWgwfH2ddzwFC1H7JGi3ESlboUoZB2UPk5Bv1bK-_20&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9PKj2mNx6Fj6xecIXt8wxNhhdlegiQq353KfyHsl2Sig&oe=6A280FFA"}, {"file_name": "YES2.png", "id": "763594575580277", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566685_763594578913610_402822167131551651_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EZL_lszwnz8Q7kNvwHATEVU&_nc_oc=AdocxwjJ69bMD3VtMpPuaAXT9eSx-MMPKuOOpTU953qzMnBFw874UNDPmkopW3sOZDc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-PCQRpucMqkuWNX2x-xOhjsOtZAEVH7EN4SLWU8v2_kg&oe=6A28310E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VR-Alien-Racing-Cover-Assets-01c.png", "id": "6977702768934253", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031457_6977702775600919_7356750813913174640_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XQJfLVrRkAQQ7kNvwGvP2Vs&_nc_oc=AdonLkjBT7WHdMs5p4M12HBvk18QSWU6l1WEEDHDIL4K-EsWLu8HlC_a6Rj-WVJceys&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_V5xKvx_Acv84TSYpXo6qsshX09HapS-GsCjrJ5iOE8w&oe=6A2837CD"}, "display_name": "Swivel", "keywords": [], "long_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, wonder, and excitement.\n\nIn this first-of-its-kind outer space experience, you swivel your way down a cosmic path straight to the dance floor. We recommend using a swivel chair to make those tricky turns a blast!\n\nWhile you\u2019re swiveling towards the dance floor, get ready for a hands-on party - drumming, popping bubbles, opening doors, high-fiving aliens, and collecting music notes.\n\nThe beats? Crafted by the legendary Barry Leitch, these tunes groove with the story and your every move. There's a variety of rides, each with its own style, and the first ride, 'Fly,' is on the house \u2013 your sneak peek into the game's vibe.\n\nSome rides are swivel-heavy, so be prepared for some serious spinning action. And guess what? There are also secret paths to up the fun factor!\n\nSwivel offers a one-of-a-kind immersive experience that our first players have described as part dance party, part thrill ride, and part workout. They felt all kinds of good after playing.\n\nCan you swivel your way to the dance floor while having the most fun possible?\n\nSwivel on and dance!\n\nJoin our Discord to share feedback, requests, and stay on top of what's new: https://discord.gg/HcAXnXXf", "short_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, wonder, and excitement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.swivelvr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Dimensional Dilemma", "support_website_url": null, "website_url": "http://www.swivelvr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_a
_sid=6e7a0a&_nc_ohc=T_ruuy9Y1hgQ7kNvwFUIuby&_nc_oc=AdoAWj3stbkp1zI8pyJFtHUnbWSkvdndeKd2C5p_ogYVbYC6TPBnSXNPD2fT9uVY9vk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQXzwoWhyM8xSTE6eOBBlv5Gtkr1aOPSxOyWvDp_0gkQ&oe=6AFDC364"}, {"file_name": "YES3.png", "id": "1782958078873949", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75195906_1782958082207282_5459036329764607070_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SI85Lwhnz4sQ7kNvwG8bDw4&_nc_oc=AdoL3qS3hqnRkW5fcWL3iOhB6AON34Df-Di4O5FzNGtEAetupg01QL-uyfERT0YQL5Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSuG5tzmMS6eUvC1gjOgBLASqmabbQI5Y-0zPT59Q0Rig&oe=6AFDAF5E"}, {"file_name": "YES4.png", "id": "3605753746407518", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86658875_3605753749740851_5280311873928099391_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rFytWa3EjMAQ7kNvwH4wJT8&_nc_oc=AdpZcrzQlzgt3bt5EFL_MFStcccwAhgKcnysLz1z4DaUHAaydpZ_0n2zmWx5RmOa7WU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzVaadeG1w7w4qxOIbo57SnACITHk9LG2Y2vbUs9yQtw&oe=6AFDDBD0"}, {"file_name": "YES5.png", "id": "397310236287601", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031528_397310239620934_6959116179281752500_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mJ6uElWFCtkQ7kNvwFwUe3e&_nc_oc=AdoDlBckQXSU2XkTMJITvTMJAfBpi_N6wtcR8YJaahlbCrPpMoSwLzudadfKyrhrFn8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjIoeWlSc5Qson28FeF4H9G3PJ7VDN9N_o-eDe5BaBAg&oe=6AFDCC6E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Swivel_Creative_Landscape.png", "id": "700581638745125", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75348039_700581642078458_1915888512703558944_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G1BGGVGbgFwQ7kNvwG2U9hA&_nc_oc=AdpjKDmMqyipJhsgyLMwLXSSrTRmEvUkLiagdbb4HLEUQG5gQwWIUPTljoxG23JGk5k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRT9D6lY84aBS7UdGlIpjaD_Iq4HUxJCOcnz7oVk7pakA&oe=6AFDC39F"}, "display_name": "Swivel - With Demo", "keywords": ["ride", "swivel", "seated", "rhythm", "fitness"], "long_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, and excitement.\n\nIn this first-of-its-kind outer space experience, you swivel your way down a cosmic track straight to the dance floor. \n\nWhile you\u2019re swiveling, get ready for a hands-on party - drumming, popping bubbles, opening doors, high-fiving aliens, and collecting music notes.\n\nThe beats? Crafted by the legendary Barry Leitch, these tunes groove with the story and your every move. There are 8 tracks, each with its own style, and the first ride, 'Fly,' is on the house \u2013 your sneak peek into the game's vibe:\n- Fly - pop (free)\n- Love me and leave me- 50s soul\n- Sweet tooth - pop dance\n- Sputnik - dubstep\n- Spin - light metal\n- Winter - classical\n- Wally Beben - retro\n- Ennio Morricone - western\n\nSome rides are swivel-heavy, so be prepared for some serious spinning action. And guess what? There are also secret paths to up the fun factor!\n\n\u2013 Important note \u2013\nPlease take your time easing into the game. After a few days of play, our bodies adjust, and spinning becomes incredibly enjoyable \u2013 it's like tapping into our inner child. \n\n\u2013 Seated game with a minimum play space of 6.5 feet by 6.5 feet \u2013\nSwivel is a seated game that involves turning and making cool moves. Ensure you have at least 3.3ft (1m) of space in all directions.\n\nWe recommend using a \u2018swivel\u2019 chair to make those tricky turns a blast!\n", "short_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, and excitement.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.swivelvr.com/privacypolicy", "developer_terms_of_service_url
EWzJ4XgzyuDc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7B_xFOwLloLPfsQEEr9G3_WJ5RxwSCOi8hVydAeCT8g&oe=6A899062"}, {"file_name": "YES4.png", "id": "202891426223143", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036644_202891429556476_5958224221900062947_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eV4iZvEWyWQQ7kNvwH3ngON&_nc_oc=AdqbppQsoib6QVW6BEaYQwdWmZ_3ZMTRu4Z_i4tqn_ja-_bkCC9DWTito9AYA63KrJo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEaY_6tFz-2HQEfKF2q35-NiwfSM2UA3fh_iCgKkSTehA&oe=6A8991E1"}, {"file_name": "YES5.png", "id": "305075042512480", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75282159_305075045845813_1741575113918231749_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EWj1oY-wjRQQ7kNvwGCXIt2&_nc_oc=AdowfiFDvg_daXECxL8O2vy_MAIHhvWhpB66rwYnr42BpNd-PYzmD2g08ESN5CH66Ws&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH2d1UnMIZnnVp4yNdsI6x475Gigf9oC0Nc7gRp_3-Rhg&oe=6A899EFA"}, {"file_name": "YES2.png", "id": "763594575580277", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566685_763594578913610_402822167131551651_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=02TAb5ISNukQ7kNvwFLz901&_nc_oc=Adq-8vT71_A9ZqOYg_G2AQzLYkMpnJcjMR6fDd8C3XKTeSw65NuJl3L2tqotHNlUgKY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEwmdAIKbvM2C999rLjaSS3iGuSiRVwTortIw_YNPkGdQ&oe=6A8987CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VR-Alien-Racing-Cover-Assets-01c.png", "id": "6977702768934253", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031457_6977702775600919_7356750813913174640_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YWwtQeq7w1wQ7kNvwFYEQN2&_nc_oc=Adp4oXJqh0OaFnta2-yuIXPKO1ddMRL4Kt6ZJdax2Em9TUOP3aVJgQy5lKuxqT_pevk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE9vIpxJ_l7IxoF4PQeC5WZBmZoesVrtINiUL_9NlIqnw&oe=6A898E8D"}, "display_name": "Swivel", "keywords": [], "long_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, wonder, and excitement.\n\nIn this first-of-its-kind outer space experience, you swivel your way down a cosmic path straight to the dance floor. We recommend using a swivel chair to make those tricky turns a blast!\n\nWhile you\u2019re swiveling towards the dance floor, get ready for a hands-on party - drumming, popping bubbles, opening doors, high-fiving aliens, and collecting music notes.\n\nThe beats? Crafted by the legendary Barry Leitch, these tunes groove with the story and your every move. There's a variety of rides, each with its own style, and the first ride, 'Fly,' is on the house \u2013 your sneak peek into the game's vibe.\n\nSome rides are swivel-heavy, so be prepared for some serious spinning action. And guess what? There are also secret paths to up the fun factor!\n\nSwivel offers a one-of-a-kind immersive experience that our first players have described as part dance party, part thrill ride, and part workout. They felt all kinds of good after playing.\n\nCan you swivel your way to the dance floor while having the most fun possible?\n\nSwivel on and dance!\n\nJoin our Discord to share feedback, requests, and stay on top of what's new: https://discord.gg/HcAXnXXf", "short_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, wonder, and excitement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.swivelvr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Dimensional Dilemma", "support_website_url": null, "website_url": "http://www.swivelvr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_a
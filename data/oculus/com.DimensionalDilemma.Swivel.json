_sid=6e7a0a&_nc_ohc=PJhEQLYbF-cQ7kNvwFYUrUd&_nc_oc=Adrb6vhHrE2Q-kTZJX4W_C7mLfUTrBG3qxfAmPvpbThC6Zq7LeU6THJ7HviE7nhCwXE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlA87PWqYW7QvSObxDzkDjbki6oE15lfm-oqjw2QXeHw&oe=6B045AE4"}, {"file_name": "YES3.png", "id": "1782958078873949", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195906_1782958082207282_5459036329764607070_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jGO8mwN07uYQ7kNvwEsoQd0&_nc_oc=AdpvTHZQe1EXu5aXOs6K9061KOmwqMZ2070YOIwodp-wF27IkeCVNNLg8vxCHi6J_iM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnsH5NAXF-K0yMy96_jfLttAHZqlIdIRUoVtSU4gISaA&oe=6B047F1E"}, {"file_name": "YES4.png", "id": "3605753746407518", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86658875_3605753749740851_5280311873928099391_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0xYM9ZwQP_MQ7kNvwGKhMxK&_nc_oc=AdpEmpBCxaCV7FakKI-ELWyrI5i_Ipia9qZwOaNs2jmMWvu1x58SdTj8OY-Smf7yOJ4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDrovJv3grzBtjh2--fS7nIxNZyWQsnkLGVCsFRQAz4A&oe=6B047350"}, {"file_name": "YES5.png", "id": "397310236287601", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031528_397310239620934_6959116179281752500_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zsydETTPmv8Q7kNvwEu-Jk8&_nc_oc=AdqJFW6DMkgAXJdZW9BoGwyfXm0qiz4stkxEVdmr5eP-w6Y-kigL8DH1rhB8Ul2ruPw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4Hw8YAC3bCj0VtAF8i97HxXj2EuZEuK01XEFH_kOA9w&oe=6B0463EE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Swivel_Creative_Landscape.png", "id": "700581638745125", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75348039_700581642078458_1915888512703558944_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G1Qx4r2iz0MQ7kNvwEQJu-_&_nc_oc=AdrAOTSUYoSU-Km4PCYo9sD4feAP_Dewan5HR-RqsRemAIcRbk9KaJJxYndGFiqLcWE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMTb36hJibjffAxRSMr5unsuQLyTtIsEWyJbxKqpxpww&oe=6B045B1F"}, "display_name": "Swivel - With Demo", "keywords": ["ride", "swivel", "seated", "rhythm", "fitness"], "long_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, and excitement.\n\nIn this first-of-its-kind outer space experience, you swivel your way down a cosmic track straight to the dance floor. \n\nWhile you\u2019re swiveling, get ready for a hands-on party - drumming, popping bubbles, opening doors, high-fiving aliens, and collecting music notes.\n\nThe beats? Crafted by the legendary Barry Leitch, these tunes groove with the story and your every move. There are 8 tracks, each with its own style, and the first ride, 'Fly,' is on the house \u2013 your sneak peek into the game's vibe:\n- Fly - pop (free)\n- Love me and leave me- 50s soul\n- Sweet tooth - pop dance\n- Sputnik - dubstep\n- Spin - light metal\n- Winter - classical\n- Wally Beben - retro\n- Ennio Morricone - western\n\nSome rides are swivel-heavy, so be prepared for some serious spinning action. And guess what? There are also secret paths to up the fun factor!\n\n\u2013 Important note \u2013\nPlease take your time easing into the game. After a few days of play, our bodies adjust, and spinning becomes incredibly enjoyable \u2013 it's like tapping into our inner child. \n\n\u2013 Seated game with a minimum play space of 6.5 feet by 6.5 feet \u2013\nSwivel is a seated game that involves turning and making cool moves. Ensure you have at least 3.3ft (1m) of space in all directions.\n\nWe recommend using a \u2018swivel\u2019 chair to make those tricky turns a blast!\n", "short_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, and excitement.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.swivelvr.com/privacypolicy", "developer_terms_of_service_url
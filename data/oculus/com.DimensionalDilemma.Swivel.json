_sid=6e7a0a&_nc_ohc=woAS5uhPT6oQ7kNvwGDn8t3&_nc_oc=AdqKVBZOXkVwQdwHzSjdFJT3fTEB-fhNre5toiYt5vawN5OfrhLnOoYyuy5PkDA06w8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1zBtYEQ8NU_pm4cSS_st3Tsbsw3p7c9GxVMCY4Jriww&oe=6B01F024"}, {"file_name": "YES3.png", "id": "1782958078873949", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195906_1782958082207282_5459036329764607070_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MZI5bBJudrgQ7kNvwHdNXuR&_nc_oc=AdqqYqhbVhu8I5Gp1hx16ILCmrsz5QDjZGnyxxx_EMnE98FOmNU7UvbaYxaLsM5gWLI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQiBLteIonPAQ4pNPUlHwQNTgz4TRyMuTD16scfoKNlCQ&oe=6B01DC1E"}, {"file_name": "YES4.png", "id": "3605753746407518", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86658875_3605753749740851_5280311873928099391_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s0FdurNqvioQ7kNvwGk56om&_nc_oc=Adphg60MYy1nKEZw8QXUAlPpPd_uaiDISD9fDApsmafoFAu27pkyNuvMpYh8yywoBAo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXCbNNOungoSgQlayZ7i6Z2cYfbGBxRsnw_A_JvV9luQ&oe=6B01D050"}, {"file_name": "YES5.png", "id": "397310236287601", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031528_397310239620934_6959116179281752500_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zsydETTPmv8Q7kNvwGnS2F-&_nc_oc=AdpzN24T86E_XgskA0y0IOrSkjrqvSmB_7Gwwoa2vhXkZ8-vaBXM_YI_-QMzbr0qwm0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtmBrUnZM-f9WiXQRMRpd_TDpnauLuyhKPXPguVOdYcw&oe=6B01C0EE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Swivel_Creative_Landscape.png", "id": "700581638745125", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75348039_700581642078458_1915888512703558944_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vQQadEXDZOoQ7kNvwHvUVDT&_nc_oc=AdpTqmNvf_4awd-UMr-TPxkKqhAKVEMymMaHSgo8WWC8m8AGZxlicPEWjM3hmkG8wf8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQr-_wBpD4c6PIdztgnMEsTY2b2dbykoJO3ElX6h9siKw&oe=6B01F05F"}, "display_name": "Swivel - With Demo", "keywords": ["ride", "swivel", "seated", "rhythm", "fitness"], "long_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, and excitement.\n\nIn this first-of-its-kind outer space experience, you swivel your way down a cosmic track straight to the dance floor. \n\nWhile you\u2019re swiveling, get ready for a hands-on party - drumming, popping bubbles, opening doors, high-fiving aliens, and collecting music notes.\n\nThe beats? Crafted by the legendary Barry Leitch, these tunes groove with the story and your every move. There are 8 tracks, each with its own style, and the first ride, 'Fly,' is on the house \u2013 your sneak peek into the game's vibe:\n- Fly - pop (free)\n- Love me and leave me- 50s soul\n- Sweet tooth - pop dance\n- Sputnik - dubstep\n- Spin - light metal\n- Winter - classical\n- Wally Beben - retro\n- Ennio Morricone - western\n\nSome rides are swivel-heavy, so be prepared for some serious spinning action. And guess what? There are also secret paths to up the fun factor!\n\n\u2013 Important note \u2013\nPlease take your time easing into the game. After a few days of play, our bodies adjust, and spinning becomes incredibly enjoyable \u2013 it's like tapping into our inner child. \n\n\u2013 Seated game with a minimum play space of 6.5 feet by 6.5 feet \u2013\nSwivel is a seated game that involves turning and making cool moves. Ensure you have at least 3.3ft (1m) of space in all directions.\n\nWe recommend using a \u2018swivel\u2019 chair to make those tricky turns a blast!\n", "short_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, and excitement.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.swivelvr.com/privacypolicy", "developer_terms_of_service_url
AUUhFZkKkDXQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-KkaSou_UKwrmPwdjS5718aidpx7Bqga9tFr4YTWZG6g&oe=6A410DE2"}, {"file_name": "YES4.png", "id": "202891426223143", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39036644_202891429556476_5958224221900062947_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AOXFi692kzcQ7kNvwEvhQEV&_nc_oc=AdqRoPqc2zLV5Y8nJEXgXH-lrLOaPZF0wZXMBkO6u8vX3109i0SLEga0xCK97zBQlXA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-mO5qw_oRnLp4GY9KvmDqCVbuLRstFavF-GiQ0ALmJYA&oe=6A410F61"}, {"file_name": "YES5.png", "id": "305075042512480", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75282159_305075045845813_1741575113918231749_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c9WP_hY-Z4kQ7kNvwH1CKcI&_nc_oc=AdqTDcr2WOIO61OxTiKU8Y5zBWo_VmxXXlZpw_mcZQwgH5WR5eJ1lRyyq_WO6yF_xhc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Om5-55DhEM0GFyW5npEhxlvqtYI4P-ameD64Gl6SP_w&oe=6A411C7A"}, {"file_name": "YES2.png", "id": "763594575580277", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57566685_763594578913610_402822167131551651_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_dWHW5U7c8sQ7kNvwGfUywe&_nc_oc=Adp-SMBNnOE0KuIm3hTYLpwTvp1ErutYPGT-Wqypjj97hGrg30wYv-i8s8rL0o5GLVM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_frxl-J1jYPuWQUytj7Bi6ZmlrNA3DmdvTUjyTmyORzA&oe=6A413D8E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VR-Alien-Racing-Cover-Assets-01c.png", "id": "6977702768934253", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031457_6977702775600919_7356750813913174640_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l55y_Lf6yB8Q7kNvwFKQUmQ&_nc_oc=Adrb52W6yOxjZLny6mG8Yeh96dB2Q8dluaSnjwsr8aepV0zCHW6rnLo-qBav02vVMq0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_roZ_NuPkzZdgUcN_mf_B0XHtP7Bbt36-RpJZlhgTMAQ&oe=6A41444D"}, "display_name": "Swivel", "keywords": [], "long_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, wonder, and excitement.\n\nIn this first-of-its-kind outer space experience, you swivel your way down a cosmic path straight to the dance floor. We recommend using a swivel chair to make those tricky turns a blast!\n\nWhile you\u2019re swiveling towards the dance floor, get ready for a hands-on party - drumming, popping bubbles, opening doors, high-fiving aliens, and collecting music notes.\n\nThe beats? Crafted by the legendary Barry Leitch, these tunes groove with the story and your every move. There's a variety of rides, each with its own style, and the first ride, 'Fly,' is on the house \u2013 your sneak peek into the game's vibe.\n\nSome rides are swivel-heavy, so be prepared for some serious spinning action. And guess what? There are also secret paths to up the fun factor!\n\nSwivel offers a one-of-a-kind immersive experience that our first players have described as part dance party, part thrill ride, and part workout. They felt all kinds of good after playing.\n\nCan you swivel your way to the dance floor while having the most fun possible?\n\nSwivel on and dance!\n\nJoin our Discord to share feedback, requests, and stay on top of what's new: https://discord.gg/HcAXnXXf", "short_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, wonder, and excitement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.swivelvr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Dimensional Dilemma", "support_website_url": null, "website_url": "http://www.swivelvr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_a
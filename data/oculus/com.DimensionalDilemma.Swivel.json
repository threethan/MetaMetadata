wDGzRMB52ZMI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3RhY-HAqLk49m1ehSJBZo1i5XrBT94JBwmjgDLwrxqTg&oe=69D24FE2"}, {"file_name": "YES4.png", "id": "202891426223143", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036644_202891429556476_5958224221900062947_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ozGfaxYwGo8Q7kNvwGSQRHr&_nc_oc=Adrl7-Kfct9c49Xcqx_KgaIglmi69VZYwumGpjb0yXl83W00t9nX_RNwWjSRFtvRLKI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2c0vbbc-jyHRe-E0oQfDpZqXeXiFFxjSU15UeONKg8-Q&oe=69D25161"}, {"file_name": "YES5.png", "id": "305075042512480", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75282159_305075045845813_1741575113918231749_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x5fsldvz4qgQ7kNvwE4zEsi&_nc_oc=AdpnRyptoc8nQ4LyT9ZIr6S40QP1iKYX45TLW6ZAjXYi2DtIze3lMoTNYJJPj4saPEQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0K0SU9gf5RBT3PVmR26k_-fdc-IjhRfX7YQF-WdxF4pw&oe=69D25E7A"}, {"file_name": "YES2.png", "id": "763594575580277", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57566685_763594578913610_402822167131551651_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XJR-6xihWCYQ7kNvwH0Djw9&_nc_oc=AdoYISMmGu5q-TpnJcvJAxXPoOoCtCrDTntKfo6TiKRY3AKAS51b7ROfuluZoNWHIus&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1yepUcE-YaRgca_3gVrAO19KeWFOOepFrFxy9l6Eufsw&oe=69D2474E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VR-Alien-Racing-Cover-Assets-01c.png", "id": "6977702768934253", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031457_6977702775600919_7356750813913174640_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X2dYb65IpdoQ7kNvwEMBz9A&_nc_oc=Adp1bcT7VCznbf9QGdqoby0zaPP1mP0HQzOcULbUHPZq_8SPiDTGKYisQLMa6Y7zZKg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af013Agm5aUckGOUti-XXMsSSmaCM_slS655VykA4aR5ZQ&oe=69D24E0D"}, "display_name": "Swivel", "keywords": [], "long_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, wonder, and excitement.\n\nIn this first-of-its-kind outer space experience, you swivel your way down a cosmic path straight to the dance floor. We recommend using a swivel chair to make those tricky turns a blast!\n\nWhile you\u2019re swiveling towards the dance floor, get ready for a hands-on party - drumming, popping bubbles, opening doors, high-fiving aliens, and collecting music notes.\n\nThe beats? Crafted by the legendary Barry Leitch, these tunes groove with the story and your every move. There's a variety of rides, each with its own style, and the first ride, 'Fly,' is on the house \u2013 your sneak peek into the game's vibe.\n\nSome rides are swivel-heavy, so be prepared for some serious spinning action. And guess what? There are also secret paths to up the fun factor!\n\nSwivel offers a one-of-a-kind immersive experience that our first players have described as part dance party, part thrill ride, and part workout. They felt all kinds of good after playing.\n\nCan you swivel your way to the dance floor while having the most fun possible?\n\nSwivel on and dance!\n\nJoin our Discord to share feedback, requests, and stay on top of what's new: https://discord.gg/HcAXnXXf", "short_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, wonder, and excitement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.swivelvr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Dimensional Dilemma", "support_website_url": null, "website_url": "http://www.swivelvr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_a
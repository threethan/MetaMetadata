_sid=6e7a0a&_nc_ohc=T_ruuy9Y1hgQ7kNvwFJrjZB&_nc_oc=AdplcIlGxRCfgqHPbjTrVuEZpUlmaw4bdOIsaduBVbJCuzJdVD29Kz2vok_ELGlJUrY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSH_Aev9IQhRgtKeZzR-SVOu1jwPojRcbg-8n7Kam0oA&oe=6AFC71E4"}, {"file_name": "YES3.png", "id": "1782958078873949", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75195906_1782958082207282_5459036329764607070_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kHMnWDwXL8MQ7kNvwHRL70S&_nc_oc=AdqiGb65t3xJs34g2FrRmAwA5uBE6BdnVxB7cSlFj__cCvrIVvtXB9jAENittzsTA3c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAbky7yCTeb2dta2BW-ek26j--dkR-__RtTokURGzFJA&oe=6AFC5DDE"}, {"file_name": "YES4.png", "id": "3605753746407518", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86658875_3605753749740851_5280311873928099391_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rFytWa3EjMAQ7kNvwGNPGAf&_nc_oc=AdpogE-68riSgQRyw_W5oLNsOxyk47n6Y-wglVIXCY36xsL4fKe1DOuraBIgXqfaQx8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHO923MuShohI0yqoX0YN21F9hyeYw9Ee9WaQi4Fq7XA&oe=6AFC8A50"}, {"file_name": "YES5.png", "id": "397310236287601", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031528_397310239620934_6959116179281752500_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5A8CRxI6-_4Q7kNvwFRditv&_nc_oc=AdpVBlRHP-2N7Z1m7-8t3gri5ko97C_9XcJlwMS2YtoscvZoMibaJsGeqIzdAGfsoIc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAmBL4LETcMKEyIy04Ywfl9269fMRvrX7wBAZ8mNt0qA&oe=6AFC7AEE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Swivel_Creative_Landscape.png", "id": "700581638745125", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75348039_700581642078458_1915888512703558944_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G1BGGVGbgFwQ7kNvwFt6aT2&_nc_oc=AdrceuZrVy8_O3RXLBsL_M1L7OdSmCECGGq0VD-0kCkyzqFz5tALIIUz1e96faapABY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWgoMluDwg_zIkkzRtyDceceryaFT9lqlQk4xkb3JCMA&oe=6AFC721F"}, "display_name": "Swivel - With Demo", "keywords": ["ride", "swivel", "seated", "rhythm", "fitness"], "long_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, and excitement.\n\nIn this first-of-its-kind outer space experience, you swivel your way down a cosmic track straight to the dance floor. \n\nWhile you\u2019re swiveling, get ready for a hands-on party - drumming, popping bubbles, opening doors, high-fiving aliens, and collecting music notes.\n\nThe beats? Crafted by the legendary Barry Leitch, these tunes groove with the story and your every move. There are 8 tracks, each with its own style, and the first ride, 'Fly,' is on the house \u2013 your sneak peek into the game's vibe:\n- Fly - pop (free)\n- Love me and leave me- 50s soul\n- Sweet tooth - pop dance\n- Sputnik - dubstep\n- Spin - light metal\n- Winter - classical\n- Wally Beben - retro\n- Ennio Morricone - western\n\nSome rides are swivel-heavy, so be prepared for some serious spinning action. And guess what? There are also secret paths to up the fun factor!\n\n\u2013 Important note \u2013\nPlease take your time easing into the game. After a few days of play, our bodies adjust, and spinning becomes incredibly enjoyable \u2013 it's like tapping into our inner child. \n\n\u2013 Seated game with a minimum play space of 6.5 feet by 6.5 feet \u2013\nSwivel is a seated game that involves turning and making cool moves. Ensure you have at least 3.3ft (1m) of space in all directions.\n\nWe recommend using a \u2018swivel\u2019 chair to make those tricky turns a blast!\n", "short_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, and excitement.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.swivelvr.com/privacypolicy", "developer_terms_of_service_url
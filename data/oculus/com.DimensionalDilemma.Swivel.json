2QPM_LZZNOMc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDAPgugfo-hF7_ZJ3qFy1df-HK3sMChzREhwjY8f2RwHw&oe=6A4B99E2"}, {"file_name": "YES4.png", "id": "202891426223143", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036644_202891429556476_5958224221900062947_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AVcsu9cQMyQQ7kNvwGeZny8&_nc_oc=Adp6rHkRey-NIZcfQ5DKCOBwajk8VpTlJMObAtv8-Ox3PXzETyPp2F0g_qyTfJBdVXA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBMwMSJ6tNZQj5Yyymu2jqBoDIls-vsGCxY5oy2m7Q20Q&oe=6A4B9B61"}, {"file_name": "YES5.png", "id": "305075042512480", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75282159_305075045845813_1741575113918231749_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4n_8tLzp6gEQ7kNvwEzSjLD&_nc_oc=Adp0c9PxYboRf9vCL-Cjo8ChdzxROq3svXkZXV5wxFg6CT2T58zbB_J0tN_mLb-GJas&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB630VtjQ69Gth9rkNg_cMd2FUTKwBLEewT93KZHTQYzw&oe=6A4BA87A"}, {"file_name": "YES2.png", "id": "763594575580277", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566685_763594578913610_402822167131551651_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B3aWKcI5HTMQ7kNvwGUy14z&_nc_oc=AdoPWM_C0YSvqFfZ2YwQRJByIv9PepP2G7CqZ1AY75P5tNo8poBPA2_S7r6adHrxdl0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC_ICdts9FzDgZ6xUUx5NBIBMpvG1XSHtE9fLza5jq6BQ&oe=6A4BC98E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VR-Alien-Racing-Cover-Assets-01c.png", "id": "6977702768934253", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031457_6977702775600919_7356750813913174640_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CVDO83DIrPoQ7kNvwHFpc_m&_nc_oc=AdpdpSbxfBMQ8bhfTxYdFy0s8TdygfgYm2YILjZ3S6J5fQTOTeKJCxzpctjtoi2IiKQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBah61-j5B1NoBpZIIt1CV28rYrkLzUhrvHz8XD0R27Ag&oe=6A4BD04D"}, "display_name": "Swivel", "keywords": [], "long_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, wonder, and excitement.\n\nIn this first-of-its-kind outer space experience, you swivel your way down a cosmic path straight to the dance floor. We recommend using a swivel chair to make those tricky turns a blast!\n\nWhile you\u2019re swiveling towards the dance floor, get ready for a hands-on party - drumming, popping bubbles, opening doors, high-fiving aliens, and collecting music notes.\n\nThe beats? Crafted by the legendary Barry Leitch, these tunes groove with the story and your every move. There's a variety of rides, each with its own style, and the first ride, 'Fly,' is on the house \u2013 your sneak peek into the game's vibe.\n\nSome rides are swivel-heavy, so be prepared for some serious spinning action. And guess what? There are also secret paths to up the fun factor!\n\nSwivel offers a one-of-a-kind immersive experience that our first players have described as part dance party, part thrill ride, and part workout. They felt all kinds of good after playing.\n\nCan you swivel your way to the dance floor while having the most fun possible?\n\nSwivel on and dance!\n\nJoin our Discord to share feedback, requests, and stay on top of what's new: https://discord.gg/HcAXnXXf", "short_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, wonder, and excitement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.swivelvr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Dimensional Dilemma", "support_website_url": null, "website_url": "http://www.swivelvr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_a
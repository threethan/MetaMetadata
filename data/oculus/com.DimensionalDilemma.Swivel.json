VxwN0wE3ToKDWU7fxKgWobbTvnzrAPJA&oe=69A97162"}, {"file_name": "YES4.png", "id": "202891426223143", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036644_202891429556476_5958224221900062947_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t5l0nOiwf8oQ7kNvwFhi1-2&_nc_oc=AdlAhkDSY5A2IbQUmacaCmc8WyKt-V_xsFq1ZWa7aSM4p_xp0DzHsro16X0yD2FWgx4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afutno8y0XCSERsMOJkQWBZ9Z-CUHDCT5OZ4vUR80NKs3Q&oe=69A972E1"}, {"file_name": "YES5.png", "id": "305075042512480", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75282159_305075045845813_1741575113918231749_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zVKfiGBVZREQ7kNvwH5TAJJ&_nc_oc=AdmKwbveLUoPZporHROY7lxt2-Ka3vg49AcyUn6V7IG_KVzYbBtQoP5sTRLLA7YfOc8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afutik2fn8-vuoM3YYvk4tgLcIRzLZHiOEo9WjS2JhqzmQ&oe=69A97FFA"}, {"file_name": "YES2.png", "id": "763594575580277", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566685_763594578913610_402822167131551651_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_pdB6Gc7ygEQ7kNvwHKtHAC&_nc_oc=AdkroYuhWCl8BAh0o_62pF7uuVRgiBecso9P500kRYgM3V-GgmrSX59L9B5SDc45vMU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsZao92__PGPN1oqizLUbv76R2l7UaRZj9j-X5nMcGxGw&oe=69A968CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VR-Alien-Racing-Cover-Assets-01c.png", "id": "6977702768934253", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031457_6977702775600919_7356750813913174640_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wRqaMf11ptwQ7kNvwFXv8sW&_nc_oc=Adl8mY8599MPewmE5kaeMw0hkgkCahnIjUD3GA6uW_XvWsx9_-RwSTajVYz_DMRfMZU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfshkC_HiseDHW1Im2pyYLGXzC2cyk9f-8fwbV5-KGu5EA&oe=69A96F8D"}, "display_name": "Swivel", "keywords": [], "long_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, wonder, and excitement.\n\nIn this first-of-its-kind outer space experience, you swivel your way down a cosmic path straight to the dance floor. We recommend using a swivel chair to make those tricky turns a blast!\n\nWhile you\u2019re swiveling towards the dance floor, get ready for a hands-on party - drumming, popping bubbles, opening doors, high-fiving aliens, and collecting music notes.\n\nThe beats? Crafted by the legendary Barry Leitch, these tunes groove with the story and your every move. There's a variety of rides, each with its own style, and the first ride, 'Fly,' is on the house \u2013 your sneak peek into the game's vibe.\n\nSome rides are swivel-heavy, so be prepared for some serious spinning action. And guess what? There are also secret paths to up the fun factor!\n\nSwivel offers a one-of-a-kind immersive experience that our first players have described as part dance party, part thrill ride, and part workout. They felt all kinds of good after playing.\n\nCan you swivel your way to the dance floor while having the most fun possible?\n\nSwivel on and dance!\n\nJoin our Discord to share feedback, requests, and stay on top of what's new: https://discord.gg/HcAXnXXf", "short_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, wonder, and excitement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.swivelvr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Dimensional Dilemma", "support_website_url": null, "website_url": "http://www.swivelvr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null
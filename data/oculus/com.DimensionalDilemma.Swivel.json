_sid=6e7a0a&_nc_ohc=sUkUnvYSmJ8Q7kNvwGhG4vU&_nc_oc=AdqEONTV4oqudKxOFWV_bN-H7QC_jxkwTWk02we-qxjNscdgV0uJ3tLyFCiD7bOZu6Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS418wGpyv2s6fWuJiSlJmRxmcHhBJVA1T0sKqaHCArLw&oe=6B0DCDA4"}, {"file_name": "YES3.png", "id": "1782958078873949", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75195906_1782958082207282_5459036329764607070_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XC2MiRpmx3AQ7kNvwHfSd_N&_nc_oc=Adp_YNKA-4i3FEJCuTEhV96yf45krYuPXCtqhxijW0_vhUOUavRv78tipapx-W6USqU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR1JON9jh7_GGVUkaIXE-vgX_9PaoTRY3UBbsLQCu4Klw&oe=6B0DB99E"}, {"file_name": "YES4.png", "id": "3605753746407518", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86658875_3605753749740851_5280311873928099391_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rRZED4EA3RgQ7kNvwGBuE-2&_nc_oc=AdowfXxz178GzczQa7v2UWvl3dQnCGzSso31fsHtvv2EFl2Th8hYZLPYFkZpaK-8gmA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS8Jx2ZXwafrAoib2rdtiUcP11XPx-1rtbusncIjYJKIw&oe=6B0DADD0"}, {"file_name": "YES5.png", "id": "397310236287601", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031528_397310239620934_6959116179281752500_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oCq8HIUNez0Q7kNvwFcLzdb&_nc_oc=AdrEchtAdYJnHqMArcB239cw0NlKFQJAcea7sCdxcoCR7-QOjdP4XmytEB1Tz_5hv5M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQWF6ADyVgMxSaeB_kqfCXAEfeJ7WY1RHC0_3HiCKD2uA&oe=6B0D9E6E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Swivel_Creative_Landscape.png", "id": "700581638745125", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75348039_700581642078458_1915888512703558944_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BWTPqU86A-oQ7kNvwF3_5Ok&_nc_oc=AdopkbpveDSQ5j5-xm7VnPtMgB9UMx2twfY2mhJ8c_qVR_JHjCosFrcUvVyH2pm_2SI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTMyuZDPfrqRPwLJ0uIcpUMdLEZC5Kxzt-fyoenx5wNJA&oe=6B0DCDDF"}, "display_name": "Swivel - With Demo", "keywords": ["ride", "swivel", "seated", "rhythm", "fitness"], "long_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, and excitement.\n\nIn this first-of-its-kind outer space experience, you swivel your way down a cosmic track straight to the dance floor. \n\nWhile you\u2019re swiveling, get ready for a hands-on party - drumming, popping bubbles, opening doors, high-fiving aliens, and collecting music notes.\n\nThe beats? Crafted by the legendary Barry Leitch, these tunes groove with the story and your every move. There are 8 tracks, each with its own style, and the first ride, 'Fly,' is on the house \u2013 your sneak peek into the game's vibe:\n- Fly - pop (free)\n- Love me and leave me- 50s soul\n- Sweet tooth - pop dance\n- Sputnik - dubstep\n- Spin - light metal\n- Winter - classical\n- Wally Beben - retro\n- Ennio Morricone - western\n\nSome rides are swivel-heavy, so be prepared for some serious spinning action. And guess what? There are also secret paths to up the fun factor!\n\n\u2013 Important note \u2013\nPlease take your time easing into the game. After a few days of play, our bodies adjust, and spinning becomes incredibly enjoyable \u2013 it's like tapping into our inner child. \n\n\u2013 Seated game with a minimum play space of 6.5 feet by 6.5 feet \u2013\nSwivel is a seated game that involves turning and making cool moves. Ensure you have at least 3.3ft (1m) of space in all directions.\n\nWe recommend using a \u2018swivel\u2019 chair to make those tricky turns a blast!\n", "short_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, and excitement.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.swivelvr.com/privacypolicy", "developer_terms_of_service_url
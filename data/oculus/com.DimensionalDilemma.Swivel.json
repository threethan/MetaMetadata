_sid=6e7a0a&_nc_ohc=J3YtF9W9W8kQ7kNvwEVsZG0&_nc_oc=AdrEo2E-vtugmp8cF2Z8NAmNN_CkP3uYAu-cn_ZliMme1M_g46z_IJkXxS9sxOGzjXM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_WZYvynLjGndsTpWqSALMs4Ts2rHZTxj5PTWECTAGgQ&oe=6AFB2064"}, {"file_name": "YES3.png", "id": "1782958078873949", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75195906_1782958082207282_5459036329764607070_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kHMnWDwXL8MQ7kNvwFG9xoT&_nc_oc=AdpSknHR_RNGIRwMfuNg3OsUoXQrUOWI9KKWjC6g_0zyZB7s9rKnEekgnC9NSQtEHMY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqu2yaPtPQkFQWWNz-3FuoMXMD-gS2ueJ8jxfSTkgClA&oe=6AFB449E"}, {"file_name": "YES4.png", "id": "3605753746407518", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/86658875_3605753749740851_5280311873928099391_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w8yGpsU1yEEQ7kNvwGDbVBl&_nc_oc=Adpwcbt2S4Go2dcjX5DvltgznB4s5OHAuQ6pzcoh9C7Y-Tzx6aEcO8BJZvMV27t2qmY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGyaR9KTla0cDYVENxXslFG8_njtcWTLPVPoMn4WaeFg&oe=6AFB38D0"}, {"file_name": "YES5.png", "id": "397310236287601", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031528_397310239620934_6959116179281752500_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5A8CRxI6-_4Q7kNvwGnuU7o&_nc_oc=AdrJqw-EATns4jzqckTZ5ts7GhsEU345cVtPp2uEuPU4cq-dOZ_JrjfFXwpZzRcmMvE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKhIUoP6VhAbDFSNwihCXtpE043XjmcV1KF_EVBu0psg&oe=6AFB296E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Swivel_Creative_Landscape.png", "id": "700581638745125", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75348039_700581642078458_1915888512703558944_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cqamXBGjvyYQ7kNvwG2KxT3&_nc_oc=AdrlJC0F8R3QJ1YPbf8brAeYIrZ-ZMEH65q2XGH1IE1pbKN14R54w4Q2d2rDow0LHOo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZDI4YX8e16sGHYGFzV3JQdhL8M6ylR9yK7BqC1go9rg&oe=6AFB209F"}, "display_name": "Swivel - With Demo", "keywords": ["ride", "swivel", "seated", "rhythm", "fitness"], "long_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, and excitement.\n\nIn this first-of-its-kind outer space experience, you swivel your way down a cosmic track straight to the dance floor. \n\nWhile you\u2019re swiveling, get ready for a hands-on party - drumming, popping bubbles, opening doors, high-fiving aliens, and collecting music notes.\n\nThe beats? Crafted by the legendary Barry Leitch, these tunes groove with the story and your every move. There are 8 tracks, each with its own style, and the first ride, 'Fly,' is on the house \u2013 your sneak peek into the game's vibe:\n- Fly - pop (free)\n- Love me and leave me- 50s soul\n- Sweet tooth - pop dance\n- Sputnik - dubstep\n- Spin - light metal\n- Winter - classical\n- Wally Beben - retro\n- Ennio Morricone - western\n\nSome rides are swivel-heavy, so be prepared for some serious spinning action. And guess what? There are also secret paths to up the fun factor!\n\n\u2013 Important note \u2013\nPlease take your time easing into the game. After a few days of play, our bodies adjust, and spinning becomes incredibly enjoyable \u2013 it's like tapping into our inner child. \n\n\u2013 Seated game with a minimum play space of 6.5 feet by 6.5 feet \u2013\nSwivel is a seated game that involves turning and making cool moves. Ensure you have at least 3.3ft (1m) of space in all directions.\n\nWe recommend using a \u2018swivel\u2019 chair to make those tricky turns a blast!\n", "short_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, and excitement.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.swivelvr.com/privacypolicy", "developer_terms_of_service_url
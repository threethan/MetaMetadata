iO-W99G4D2Ak&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzpyP48wqBbrnXz-RuOHx-PWxP_qvdFagP7eeqw4yQdw&oe=6AB2A722"}, {"file_name": "YES4.png", "id": "202891426223143", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036644_202891429556476_5958224221900062947_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A6xB_RjM5e4Q7kNvwF7Udlj&_nc_oc=AdpIUK8Q_A_W8hw-jlnuOP226b2G0yrLt65zh6ETS_35JbyxUY9F-DlJ7Bvb3uI7X60&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJwhEfhRKiswYo_cEkjB5vnlSuYUlbcYq9yHsi34KpU8A&oe=6AB27061"}, {"file_name": "YES5.png", "id": "305075042512480", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75282159_305075045845813_1741575113918231749_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xhSmxp29faYQ7kNvwG9ButD&_nc_oc=AdoLXd5kGQnQzD0Ll2YiJL9P68Sfo1l3UC2UYU0Tu5iIzZnm7g92RYdTt6ls2Ivnbbg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5VzJYCmWpL49fVQ4W7CBEK3qr3I8I8MMxGYzjx_Nc7g&oe=6AB27D7A"}, {"file_name": "YES2.png", "id": "763594575580277", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566685_763594578913610_402822167131551651_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TtHURHKmu1oQ7kNvwHZ5jWP&_nc_oc=AdodknBqjy6H9o0KcmqUV0e1c-7tGtj9MlMCfpNW62pmoFJafuzdyV2gw1nOt8H7Gjk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3bdIx7yEwYqiA9T0RTxL03V2e20tu6iPicCXuOfR5xg&oe=6AB29E8E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VR-Alien-Racing-Cover-Assets-01c.png", "id": "6977702768934253", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031457_6977702775600919_7356750813913174640_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tPbauOPWVGwQ7kNvwHUq-C-&_nc_oc=AdpW40uARk1XunuHMzAQTQ6cPVUwrAqXwhDkIb1HvlLsiUBn1b1CvwLqyuedb44Gd1s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLped9LtOTcSGudUyL0izOsjSWw3yUoum7Ok4cr7CcxVA&oe=6AB2A54D"}, "display_name": "Swivel", "keywords": [], "long_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, wonder, and excitement.\n\nIn this first-of-its-kind outer space experience, you swivel your way down a cosmic path straight to the dance floor. We recommend using a swivel chair to make those tricky turns a blast!\n\nWhile you\u2019re swiveling towards the dance floor, get ready for a hands-on party - drumming, popping bubbles, opening doors, high-fiving aliens, and collecting music notes.\n\nThe beats? Crafted by the legendary Barry Leitch, these tunes groove with the story and your every move. There's a variety of rides, each with its own style, and the first ride, 'Fly,' is on the house \u2013 your sneak peek into the game's vibe.\n\nSome rides are swivel-heavy, so be prepared for some serious spinning action. And guess what? There are also secret paths to up the fun factor!\n\nSwivel offers a one-of-a-kind immersive experience that our first players have described as part dance party, part thrill ride, and part workout. They felt all kinds of good after playing.\n\nCan you swivel your way to the dance floor while having the most fun possible?\n\nSwivel on and dance!\n\nJoin our Discord to share feedback, requests, and stay on top of what's new: https://discord.gg/HcAXnXXf", "short_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, wonder, and excitement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.swivelvr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Dimensional Dilemma", "support_website_url": null, "website_url": "http://www.swivelvr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_a
TZKPdm7QdLm8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGnh_l7uYADrB_Ru2Z93GAgHr4suHQ29Et9sTOg8EOHyg&oe=6A883EE2"}, {"file_name": "YES4.png", "id": "202891426223143", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39036644_202891429556476_5958224221900062947_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eV4iZvEWyWQQ7kNvwFakMaP&_nc_oc=AdrrrKfQeB-RB3m1CpYpDQFQ5B77VNXyVm9hTRST-ogSI9vRVKQtV4uP0bNfe4PIVjk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvbM_CD-RVrvACkE2hhZsMQDqIfN4dvnDHwua3wc2BBg&oe=6A884061"}, {"file_name": "YES5.png", "id": "305075042512480", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75282159_305075045845813_1741575113918231749_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EWj1oY-wjRQQ7kNvwEGOVuK&_nc_oc=AdroS12F5Ir_AdpfgZWk1NPdkukZMOOHddQe1lDOTQpJsSDlHKg4_AmX4upm4mO2sZc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDJlZ_Odg8OMAoYVv2GHwexYUd5zP4xITxiYsDtNXvRA&oe=6A884D7A"}, {"file_name": "YES2.png", "id": "763594575580277", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/57566685_763594578913610_402822167131551651_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=02TAb5ISNukQ7kNvwEmArUk&_nc_oc=AdqsCKFv05sKcwIVs0QsSvwSO02k3fIohtALZDjAFc7ePR0zj9UztQA0kWej08Mt6ug&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpNRKFrCuU6IV3Sj73AiXdIOiotrTHFY_VU-CnruIVEw&oe=6A88364E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VR-Alien-Racing-Cover-Assets-01c.png", "id": "6977702768934253", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031457_6977702775600919_7356750813913174640_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YWwtQeq7w1wQ7kNvwFQlH3k&_nc_oc=Adp1DCiye1lTl4F6FEQu3NJow5fjHzZV1Z4nMKR4hyAbpy0wFxNPLUBwYnat-Yta7_w&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0tm994osCRPZuleVKSrM3VLwNzsq-2GJ5oN4wJ4gMDQ&oe=6A883D0D"}, "display_name": "Swivel", "keywords": [], "long_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, wonder, and excitement.\n\nIn this first-of-its-kind outer space experience, you swivel your way down a cosmic path straight to the dance floor. We recommend using a swivel chair to make those tricky turns a blast!\n\nWhile you\u2019re swiveling towards the dance floor, get ready for a hands-on party - drumming, popping bubbles, opening doors, high-fiving aliens, and collecting music notes.\n\nThe beats? Crafted by the legendary Barry Leitch, these tunes groove with the story and your every move. There's a variety of rides, each with its own style, and the first ride, 'Fly,' is on the house \u2013 your sneak peek into the game's vibe.\n\nSome rides are swivel-heavy, so be prepared for some serious spinning action. And guess what? There are also secret paths to up the fun factor!\n\nSwivel offers a one-of-a-kind immersive experience that our first players have described as part dance party, part thrill ride, and part workout. They felt all kinds of good after playing.\n\nCan you swivel your way to the dance floor while having the most fun possible?\n\nSwivel on and dance!\n\nJoin our Discord to share feedback, requests, and stay on top of what's new: https://discord.gg/HcAXnXXf", "short_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, wonder, and excitement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.swivelvr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Dimensional Dilemma", "support_website_url": null, "website_url": "http://www.swivelvr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_a
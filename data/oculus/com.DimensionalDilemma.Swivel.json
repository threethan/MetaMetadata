PfdPP3GutO_E&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-EkDX_EsawRn_i1vXaMpvi-47ZD9mfbtZb5djPpm1jg&oe=6A8AE1E2"}, {"file_name": "YES4.png", "id": "202891426223143", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39036644_202891429556476_5958224221900062947_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3UZO7vEaziYQ7kNvwEZOA1g&_nc_oc=AdrQt4lE_Zryc_oJ9nwtw0zTCpvN6vwYQw9dsRWNBnF5SBM82HGc6K76SRs09IOXrMA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHyC3HtfA-sxUnMfQXOEfsMGuQBymA_GN1IJixqyGNegg&oe=6A8AE361"}, {"file_name": "YES5.png", "id": "305075042512480", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75282159_305075045845813_1741575113918231749_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YzvnInPtNuwQ7kNvwG-qoA8&_nc_oc=AdrKWjkT3h7y68ddbkfkISjXWLNG0iQJyi-nEg8_m35RobXEAYntgmVOYbPOuCe9eC8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6WSQfYvd9jRQY4hCOdbgMdeD2R49L-8jr4AUxw4nEsg&oe=6A8AF07A"}, {"file_name": "YES2.png", "id": "763594575580277", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/57566685_763594578913610_402822167131551651_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=02TAb5ISNukQ7kNvwG5d_xK&_nc_oc=AdrJ_zpR4slle_dne_BaanNih39PtL4TbmrPgx4ivHUBjLkZVFIDepgxwCt75ubgATQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEToq197A5J3lfp4fkhOh0kWX7wyy4GPqjvs23HN10ITQ&oe=6A8AD94E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VR-Alien-Racing-Cover-Assets-01c.png", "id": "6977702768934253", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031457_6977702775600919_7356750813913174640_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UeQclopkav4Q7kNvwFW25Yy&_nc_oc=AdpIViFGk1iMLGDNYQEf65zNdFOzlS5PLq0RAi50-QCFagbyrEUUmqSGBcDe0-WrLwM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEe-DAiJvTxvEtmaG8wS7H4QkHuhSNIICccgPmbgYN6Vg&oe=6A8AE00D"}, "display_name": "Swivel", "keywords": [], "long_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, wonder, and excitement.\n\nIn this first-of-its-kind outer space experience, you swivel your way down a cosmic path straight to the dance floor. We recommend using a swivel chair to make those tricky turns a blast!\n\nWhile you\u2019re swiveling towards the dance floor, get ready for a hands-on party - drumming, popping bubbles, opening doors, high-fiving aliens, and collecting music notes.\n\nThe beats? Crafted by the legendary Barry Leitch, these tunes groove with the story and your every move. There's a variety of rides, each with its own style, and the first ride, 'Fly,' is on the house \u2013 your sneak peek into the game's vibe.\n\nSome rides are swivel-heavy, so be prepared for some serious spinning action. And guess what? There are also secret paths to up the fun factor!\n\nSwivel offers a one-of-a-kind immersive experience that our first players have described as part dance party, part thrill ride, and part workout. They felt all kinds of good after playing.\n\nCan you swivel your way to the dance floor while having the most fun possible?\n\nSwivel on and dance!\n\nJoin our Discord to share feedback, requests, and stay on top of what's new: https://discord.gg/HcAXnXXf", "short_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, wonder, and excitement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.swivelvr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Dimensional Dilemma", "support_website_url": null, "website_url": "http://www.swivelvr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_a
_sid=6e7a0a&_nc_ohc=KW16XGL3ggAQ7kNvwExrGag&_nc_oc=AdrAP5Z3rf0QTf3oobbNVayD2lpsu4UXHTOVOdKqPueY1feYt4KljBGF3K7OcKnU57M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWSEL9BwTqT3EbVqUKRnCAT6vQNbvKzSZLvTf1g-KM66w&oe=6B103864"}, {"file_name": "YES3.png", "id": "1782958078873949", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195906_1782958082207282_5459036329764607070_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fgSNzis89n4Q7kNvwG7t6TZ&_nc_oc=AdolErSIqw_EJN14Nzl17dGdI5_3vCM6JmHHdulDjdDOXT8xZ2QzanooLaMvUNKsSGY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVO0po9UaBJmatMcE4SAmUiqbJUcxSORRLYolklf7HcDg&oe=6B105C9E"}, {"file_name": "YES4.png", "id": "3605753746407518", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86658875_3605753749740851_5280311873928099391_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qVWyukicEX0Q7kNvwE8_OrR&_nc_oc=AdqUD8i35E5fW4ISCznOCpMPToLfD6n6Q7k94ZEeYtL0MRqyqLNqwW7P-Uuj2nMuY7k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXms-U6E_eSalDNEV7WXGLUzK_G4Ael8pIDfCBt2TXFTQ&oe=6B1050D0"}, {"file_name": "YES5.png", "id": "397310236287601", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031528_397310239620934_6959116179281752500_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oCq8HIUNez0Q7kNvwEkPc8J&_nc_oc=AdqdCdfbpPGDMg9y-5DKtOGwv5mTCuh9pnrY6auIzFY30TwQ8CpiObEgzVY-XkraKd4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQULRF_OCZoC81niZlH3F3ZqQ-cQsSYwIc3MV7MyoB21vA&oe=6B10416E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Swivel_Creative_Landscape.png", "id": "700581638745125", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75348039_700581642078458_1915888512703558944_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YP-SbF8GBqYQ7kNvwFFwtgz&_nc_oc=Adr2xBTmGCuBd4-ifYsytoNk6MIUl-Zfq9UNtBUmsfw-YGfCcXpTN_-0Et0QOWXTE4g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWg7FxzUhDyMtoImB86hbnBF0nhPfx6YOA-Kvhx5zChWA&oe=6B10389F"}, "display_name": "Swivel - With Demo", "keywords": ["ride", "swivel", "seated", "rhythm", "fitness"], "long_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, and excitement.\n\nIn this first-of-its-kind outer space experience, you swivel your way down a cosmic track straight to the dance floor. \n\nWhile you\u2019re swiveling, get ready for a hands-on party - drumming, popping bubbles, opening doors, high-fiving aliens, and collecting music notes.\n\nThe beats? Crafted by the legendary Barry Leitch, these tunes groove with the story and your every move. There are 8 tracks, each with its own style, and the first ride, 'Fly,' is on the house \u2013 your sneak peek into the game's vibe:\n- Fly - pop (free)\n- Love me and leave me- 50s soul\n- Sweet tooth - pop dance\n- Sputnik - dubstep\n- Spin - light metal\n- Winter - classical\n- Wally Beben - retro\n- Ennio Morricone - western\n\nSome rides are swivel-heavy, so be prepared for some serious spinning action. And guess what? There are also secret paths to up the fun factor!\n\n\u2013 Important note \u2013\nPlease take your time easing into the game. After a few days of play, our bodies adjust, and spinning becomes incredibly enjoyable \u2013 it's like tapping into our inner child. \n\n\u2013 Seated game with a minimum play space of 6.5 feet by 6.5 feet \u2013\nSwivel is a seated game that involves turning and making cool moves. Ensure you have at least 3.3ft (1m) of space in all directions.\n\nWe recommend using a \u2018swivel\u2019 chair to make those tricky turns a blast!\n", "short_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, and excitement.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.swivelvr.com/privacypolicy", "developer_terms_of_service_url
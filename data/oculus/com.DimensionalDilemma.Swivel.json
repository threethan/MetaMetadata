c0Wzux7AlJVY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJeOQ74pRkb48qvhE7bM3z3dMLbdqz6im39zqiq3cRKw&oe=6A8055E2"}, {"file_name": "YES4.png", "id": "202891426223143", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39036644_202891429556476_5958224221900062947_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0lTQnBLa2o8Q7kNvwE1aWkH&_nc_oc=AdpGxE8oN0_N2x6pSSw8DBt0Ya7753RMjY6IMbTZJR8jGsZuFwkXgyhEWD77WW7eeDI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgB3RL6zcZWGFhq9LK3go20qf1eGUSvoB4C7bVrFo2Tw&oe=6A805761"}, {"file_name": "YES5.png", "id": "305075042512480", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75282159_305075045845813_1741575113918231749_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g8vo3_tTI98Q7kNvwHndhuf&_nc_oc=AdqnC21l2c711tUddHUujH2whzVQW7Szwpw8uxUzVCtSqyPNcCEjDAI7G6DqY7IkVPc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEspFmOVCBUE-0jGD3JJP_SGK12biPghPyXcTn475oUSQ&oe=6A80647A"}, {"file_name": "YES2.png", "id": "763594575580277", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57566685_763594578913610_402822167131551651_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WFtcjjFDvSQQ7kNvwHWVE8N&_nc_oc=Adrcsbx3n5Y8VtH0sPs0B8dQy722e5A7eiydgoqNC-mctLbpVDQm9XgRWm2FlYt1ljg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYJNreC-Lprqsxfa6SzOL4i8ignVvkc_Exl4ueZ_U0Vw&oe=6A804D4E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VR-Alien-Racing-Cover-Assets-01c.png", "id": "6977702768934253", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031457_6977702775600919_7356750813913174640_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5UXwuK6uLLUQ7kNvwErve59&_nc_oc=Adpu_aMWWnXM_qys6NGRJLYAL4OK8aRVKz0u_Jg-zIy8o4I7cnLlXq6C4aXEd-PVuec&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4EVCrV7nmD8ZElgpEqZplVdLYB7fEaffEm1Wu5q68kg&oe=6A80540D"}, "display_name": "Swivel", "keywords": [], "long_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, wonder, and excitement.\n\nIn this first-of-its-kind outer space experience, you swivel your way down a cosmic path straight to the dance floor. We recommend using a swivel chair to make those tricky turns a blast!\n\nWhile you\u2019re swiveling towards the dance floor, get ready for a hands-on party - drumming, popping bubbles, opening doors, high-fiving aliens, and collecting music notes.\n\nThe beats? Crafted by the legendary Barry Leitch, these tunes groove with the story and your every move. There's a variety of rides, each with its own style, and the first ride, 'Fly,' is on the house \u2013 your sneak peek into the game's vibe.\n\nSome rides are swivel-heavy, so be prepared for some serious spinning action. And guess what? There are also secret paths to up the fun factor!\n\nSwivel offers a one-of-a-kind immersive experience that our first players have described as part dance party, part thrill ride, and part workout. They felt all kinds of good after playing.\n\nCan you swivel your way to the dance floor while having the most fun possible?\n\nSwivel on and dance!\n\nJoin our Discord to share feedback, requests, and stay on top of what's new: https://discord.gg/HcAXnXXf", "short_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, wonder, and excitement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.swivelvr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Dimensional Dilemma", "support_website_url": null, "website_url": "http://www.swivelvr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_a
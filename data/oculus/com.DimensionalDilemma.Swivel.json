_sid=6e7a0a&_nc_ohc=sUkUnvYSmJ8Q7kNvwGklCKF&_nc_oc=Adr8MfmRW6QSDP5w_8xECjQA6ggwBMMwVLrEb9dYTsZauoyXqu6W2yAaekrela0LTy4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXaKRar-6Y_iE7GPhmQva8eydc-VgYTis1f2JZErM38dQ&oe=6B0F1F24"}, {"file_name": "YES3.png", "id": "1782958078873949", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195906_1782958082207282_5459036329764607070_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XC2MiRpmx3AQ7kNvwEbNPgt&_nc_oc=AdoDE2AgeaiqmqOY9hVOwFKeaL3x1qQF3ty_5vY5gu8ICCtsqcmCO_eBdCKS--bFpy4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVPKX1Orn-lJBIMFE0WgR2YJgN7JUyVnd4XGLOxKlSvpg&oe=6B0F0B1E"}, {"file_name": "YES4.png", "id": "3605753746407518", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86658875_3605753749740851_5280311873928099391_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rRZED4EA3RgQ7kNvwESywDJ&_nc_oc=AdqkO_gYO5Na18xjBrvBp2T_R6-kY3WMhn_IIlX5kHpX6Xy8mxBppfx7eISTkZfN82A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXkyCGBPHIyu2MmNdIHNcg6iBSK56B_0_UpsnkTHLNLMA&oe=6B0EFF50"}, {"file_name": "YES5.png", "id": "397310236287601", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031528_397310239620934_6959116179281752500_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oCq8HIUNez0Q7kNvwGBfrwV&_nc_oc=AdrbEn3Tq9YMgOhybxdt8JO9B0-jSvhlLO_x1WxaWYzJW-rwKMUvGmNUNSjWh0p4b-4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVB6D9gAKbAhJ2SEetehwI45QuboQJGu8GW22cajkdOug&oe=6B0EEFEE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Swivel_Creative_Landscape.png", "id": "700581638745125", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75348039_700581642078458_1915888512703558944_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BWTPqU86A-oQ7kNvwGoqMFj&_nc_oc=AdpMl4F1tg_OVTcfHoxjjB22yPpWLXfFtLFjIOKNlCWWCryb076To2c76gshe6Hbo58&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVZaSPNnRsesIqG7xwE4K4CMcki63AaKCwRiyU_IWjyNQ&oe=6B0F1F5F"}, "display_name": "Swivel - With Demo", "keywords": ["ride", "swivel", "seated", "rhythm", "fitness"], "long_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, and excitement.\n\nIn this first-of-its-kind outer space experience, you swivel your way down a cosmic track straight to the dance floor. \n\nWhile you\u2019re swiveling, get ready for a hands-on party - drumming, popping bubbles, opening doors, high-fiving aliens, and collecting music notes.\n\nThe beats? Crafted by the legendary Barry Leitch, these tunes groove with the story and your every move. There are 8 tracks, each with its own style, and the first ride, 'Fly,' is on the house \u2013 your sneak peek into the game's vibe:\n- Fly - pop (free)\n- Love me and leave me- 50s soul\n- Sweet tooth - pop dance\n- Sputnik - dubstep\n- Spin - light metal\n- Winter - classical\n- Wally Beben - retro\n- Ennio Morricone - western\n\nSome rides are swivel-heavy, so be prepared for some serious spinning action. And guess what? There are also secret paths to up the fun factor!\n\n\u2013 Important note \u2013\nPlease take your time easing into the game. After a few days of play, our bodies adjust, and spinning becomes incredibly enjoyable \u2013 it's like tapping into our inner child. \n\n\u2013 Seated game with a minimum play space of 6.5 feet by 6.5 feet \u2013\nSwivel is a seated game that involves turning and making cool moves. Ensure you have at least 3.3ft (1m) of space in all directions.\n\nWe recommend using a \u2018swivel\u2019 chair to make those tricky turns a blast!\n", "short_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, and excitement.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.swivelvr.com/privacypolicy", "developer_terms_of_service_url
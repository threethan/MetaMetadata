6AC512E4"}, {"file_name": "YES3.png", "id": "1782958078873949", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75195906_1782958082207282_5459036329764607070_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q2j_MZEJLlAQ7kNvwFHgSG4&_nc_oc=AdpZ3Lr8tz52ObgpKSXe2KY9CQD4_PfYrfhkGeo-dMM7kMym8RcU312WSPWzcgBCNF0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPNQhJ5fDizM6xWtS8krqXfzZQbw2pS98WPxMdRTuw_Uw&oe=6AC4FEDE"}, {"file_name": "YES4.png", "id": "3605753746407518", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/86658875_3605753749740851_5280311873928099391_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hr36Iwuk9-oQ7kNvwEJQbCH&_nc_oc=AdpVoUvebC362uIJA2KmDL5VdZDVEhnmJWnoX7072MZ5yJsC8n803JAJV7VcvmE5jHE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQONK3TwNvcKtMC-fWogBRyUngjXnNSHfP4pSdN4tTXB2Q&oe=6AC4F310"}, {"file_name": "YES5.png", "id": "397310236287601", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031528_397310239620934_6959116179281752500_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KWdVILwH100Q7kNvwG63lrh&_nc_oc=AdrLwcf6UsWlj9nmbkklvFhkJPR0D4DMhC18k38HGHPzpQJ5rJyUWz0WP9CqKvMBBm4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOHu5K9suZOHROxMWFG8DgBYuITUqNecIwKDxCzszp7uw&oe=6AC51BEE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Swivel_Creative_Landscape.png", "id": "700581638745125", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75348039_700581642078458_1915888512703558944_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RJAuMtoox0wQ7kNvwEzuMrn&_nc_oc=AdpbPrXC9VolkBS4-ZM3UuU7j9q8o2feYVHVFvxMNZG3tklN_P5W0Mi_BTKHzOJi51A&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOVQSqgZ-vrzGqa-AkrejB0mmwCy5Qwv2Sz-pn8EzwfLg&oe=6AC5131F"}, "display_name": "Swivel - With Demo", "keywords": ["ride", "swivel", "seated", "rhythm", "fitness"], "long_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, and excitement.\n\nIn this first-of-its-kind outer space experience, you swivel your way down a cosmic track straight to the dance floor. \n\nWhile you\u2019re swiveling, get ready for a hands-on party - drumming, popping bubbles, opening doors, high-fiving aliens, and collecting music notes.\n\nThe beats? Crafted by the legendary Barry Leitch, these tunes groove with the story and your every move. There are 8 tracks, each with its own style, and the first ride, 'Fly,' is on the house \u2013 your sneak peek into the game's vibe:\n- Fly - pop (free)\n- Love me and leave me- 50s soul\n- Sweet tooth - pop dance\n- Sputnik - dubstep\n- Spin - light metal\n- Winter - classical\n- Wally Beben - retro\n- Ennio Morricone - western\n\nSome rides are swivel-heavy, so be prepared for some serious spinning action. And guess what? There are also secret paths to up the fun factor!\n\n\u2013 Important note \u2013\nPlease take your time easing into the game. After a few days of play, our bodies adjust, and spinning becomes incredibly enjoyable \u2013 it's like tapping into our inner child. \n\n\u2013 Seated game with a minimum play space of 6.5 feet by 6.5 feet \u2013\nSwivel is a seated game that involves turning and making cool moves. Ensure you have at least 3.3ft (1m) of space in all directions.\n\nWe recommend using a \u2018swivel\u2019 chair to make those tricky turns a blast!\n", "short_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, and excitement.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.swivelvr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Dimensional Dilemma", "support_website_url": "https://www.swivelvr.com/contact-us", "website_url": "http://www.swivelvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "
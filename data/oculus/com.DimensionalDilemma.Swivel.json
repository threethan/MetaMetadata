_sid=6e7a0a&_nc_ohc=PJhEQLYbF-cQ7kNvwFR_6Be&_nc_oc=Ado11h4W5ZKw0Dz5LQyjtlRfndfyrjNZKHcz63BK3i0zVHuVaeayLdUK9ip7eVmKatQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTm44Y_phgOATQGklizDcwtOfwT_Xn47URL_7Zdrks1og&oe=6B06FDE4"}, {"file_name": "YES3.png", "id": "1782958078873949", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195906_1782958082207282_5459036329764607070_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jGO8mwN07uYQ7kNvwHrf1s8&_nc_oc=AdoH0ESgNO7HlBYBxm0mxQG95McBlc5Y6ojaPBBg2N3tY_V9z7IGdS8PQctNwAfbHFY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2BfM4uull8JJ59h3OvHqiE9KFryKx0CZye04cdai56w&oe=6B07221E"}, {"file_name": "YES4.png", "id": "3605753746407518", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86658875_3605753749740851_5280311873928099391_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0xYM9ZwQP_MQ7kNvwE7juZt&_nc_oc=AdqMqABYDGdQ39HTHt2gszNDgAex8U3wnfdqkbo59c6rWHbOZzvwuyrn1M8JKaISbNE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQm27QNkU2g-6k5Yq1KezZZw2b7NS-awbjMIBRMAD8eg&oe=6B071650"}, {"file_name": "YES5.png", "id": "397310236287601", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031528_397310239620934_6959116179281752500_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pG5jviWlICQQ7kNvwF48EjP&_nc_oc=AdpaYf56axcFjJnn3QA3VM6Ec-4glEo10vDfDaF_JpZN5hIZNVB_lNWWjZVP57WcTgw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSu4hUnbNew1bLIzO3QtsqCWKJuDgN7BwGq7Mv34zNl3Q&oe=6B0706EE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Swivel_Creative_Landscape.png", "id": "700581638745125", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75348039_700581642078458_1915888512703558944_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G1Qx4r2iz0MQ7kNvwEMVK6A&_nc_oc=AdoM5dFjFDhpudQcTxqQ64Mk3AzNRfGcGXzKppEU0JM1vs-qaTcs_B64j8sNRSN1CMs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXOv_htZUC_AH6wt8ETD1B_JN03qmfCC3jXn44qFlXEA&oe=6B06FE1F"}, "display_name": "Swivel - With Demo", "keywords": ["ride", "swivel", "seated", "rhythm", "fitness"], "long_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, and excitement.\n\nIn this first-of-its-kind outer space experience, you swivel your way down a cosmic track straight to the dance floor. \n\nWhile you\u2019re swiveling, get ready for a hands-on party - drumming, popping bubbles, opening doors, high-fiving aliens, and collecting music notes.\n\nThe beats? Crafted by the legendary Barry Leitch, these tunes groove with the story and your every move. There are 8 tracks, each with its own style, and the first ride, 'Fly,' is on the house \u2013 your sneak peek into the game's vibe:\n- Fly - pop (free)\n- Love me and leave me- 50s soul\n- Sweet tooth - pop dance\n- Sputnik - dubstep\n- Spin - light metal\n- Winter - classical\n- Wally Beben - retro\n- Ennio Morricone - western\n\nSome rides are swivel-heavy, so be prepared for some serious spinning action. And guess what? There are also secret paths to up the fun factor!\n\n\u2013 Important note \u2013\nPlease take your time easing into the game. After a few days of play, our bodies adjust, and spinning becomes incredibly enjoyable \u2013 it's like tapping into our inner child. \n\n\u2013 Seated game with a minimum play space of 6.5 feet by 6.5 feet \u2013\nSwivel is a seated game that involves turning and making cool moves. Ensure you have at least 3.3ft (1m) of space in all directions.\n\nWe recommend using a \u2018swivel\u2019 chair to make those tricky turns a blast!\n", "short_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, and excitement.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.swivelvr.com/privacypolicy", "developer_terms_of_service_url
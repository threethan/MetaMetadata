ci19zXllugw4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCs0-DdQhjGl_qTkpNes1QKY1lOu9UROejW9_0P0kL7XQ&oe=6A58C8E2"}, {"file_name": "YES4.png", "id": "202891426223143", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39036644_202891429556476_5958224221900062947_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vc_QkK2CQmMQ7kNvwG3fWxd&_nc_oc=Adoo0EfPqwWlNOLKlfNDkGED74hWH7lWBpqxMvTlVCd0nlBD72_pI_BCMpik2w78VVY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBfu2WEQwXWxodPo8E6slfRjQyQKgbaP6J3tlSWXRf6tg&oe=6A58CA61"}, {"file_name": "YES5.png", "id": "305075042512480", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75282159_305075045845813_1741575113918231749_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NVdOvBDEIjcQ7kNvwFlscDX&_nc_oc=AdqD0l7br2tuOVdP68xVe0Wgeh8N8Ue5BD9aynrNh9_2TZ8OPtRJ-Z7kNEjXKi-yob4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA5TMsw3CyrdH8sdoF48JqOjL6jVztvaOlQpMII8Qg6TA&oe=6A58D77A"}, {"file_name": "YES2.png", "id": "763594575580277", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/57566685_763594578913610_402822167131551651_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bw1_QEHm4hIQ7kNvwGdR9Xq&_nc_oc=AdrMDbKJVFZba3ptPXiUTcq-e3Ij46BpaQi_VvNqkvy4zCUWyrgxw5O0wOOhbUgjaB0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAkcmQ8g1DMbF5_MXPl-VXG77bb_0W4SEG65s9ijl4LNw&oe=6A58F88E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VR-Alien-Racing-Cover-Assets-01c.png", "id": "6977702768934253", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031457_6977702775600919_7356750813913174640_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r5mvPwUC8j4Q7kNvwHXK3Wq&_nc_oc=AdotWTIh-7ngDB_vM3fLRBjUiq9WJndkwYDYR1uq6QaZFM0d3dVOdIN1_VMjnjTaU4I&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCwoo5uh2sgPQ214oK5pWVg6ejKT9Gk_TcDLB3NYhjYrQ&oe=6A58C70D"}, "display_name": "Swivel", "keywords": [], "long_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, wonder, and excitement.\n\nIn this first-of-its-kind outer space experience, you swivel your way down a cosmic path straight to the dance floor. We recommend using a swivel chair to make those tricky turns a blast!\n\nWhile you\u2019re swiveling towards the dance floor, get ready for a hands-on party - drumming, popping bubbles, opening doors, high-fiving aliens, and collecting music notes.\n\nThe beats? Crafted by the legendary Barry Leitch, these tunes groove with the story and your every move. There's a variety of rides, each with its own style, and the first ride, 'Fly,' is on the house \u2013 your sneak peek into the game's vibe.\n\nSome rides are swivel-heavy, so be prepared for some serious spinning action. And guess what? There are also secret paths to up the fun factor!\n\nSwivel offers a one-of-a-kind immersive experience that our first players have described as part dance party, part thrill ride, and part workout. They felt all kinds of good after playing.\n\nCan you swivel your way to the dance floor while having the most fun possible?\n\nSwivel on and dance!\n\nJoin our Discord to share feedback, requests, and stay on top of what's new: https://discord.gg/HcAXnXXf", "short_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, wonder, and excitement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.swivelvr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Dimensional Dilemma", "support_website_url": null, "website_url": "http://www.swivelvr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_a
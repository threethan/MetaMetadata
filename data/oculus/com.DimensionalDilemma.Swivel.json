fVckF310Q2CNy4urjh2E_f9aAWAb0pRg&oe=69B008E2"}, {"file_name": "YES4.png", "id": "202891426223143", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036644_202891429556476_5958224221900062947_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IrRiivdrPJ0Q7kNvwExmzSj&_nc_oc=AdkShgI2FtTr5U-pDQ08cUsyuI43bvUx4F2xBX7dLCTNHpLGAffiL7pNwamT7yg1SK0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzAaSSa0Ci0SIRfVf3BkS6w4TGE9zhenvMszSuuIJYy2A&oe=69B00A61"}, {"file_name": "YES5.png", "id": "305075042512480", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75282159_305075045845813_1741575113918231749_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LzfU0ko7WjoQ7kNvwGzHACh&_nc_oc=AdkKYlvtXaa2xoMYfZmPB_GEnYd5HruQRUCuoAh2oM0viTaxyIVWfq9H2iZH7j6s97g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwT48nY2nANojZrUezGLkGhfSYrfjybpgcal3TDgh5Utg&oe=69B0177A"}, {"file_name": "YES2.png", "id": "763594575580277", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57566685_763594578913610_402822167131551651_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hrSRoxC2s7YQ7kNvwHuFWDE&_nc_oc=AdkAewGv_PgkJrEDWtUN6MqSX8Nl32bO1o9kVIj8Q74bny88-jkKO5ryg9PPUio2f0s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwlZD_uMR22jXl4OlHqp9ZlDT46S6A7fAk5lTPkhKIydg&oe=69B0004E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VR-Alien-Racing-Cover-Assets-01c.png", "id": "6977702768934253", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031457_6977702775600919_7356750813913174640_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v8WwlEUIxZQQ7kNvwFO_Hg9&_nc_oc=AdkAT3Mbkzgv-sbF4iUlqTH8pYzWgUvYWQs2gxFP991wS-HiYYjD1vwuFmC3F08D-9o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzgRlFhMXtHJPv-zMESfpxyoIokCoIlVZYUZPgb0roOiQ&oe=69B0070D"}, "display_name": "Swivel", "keywords": [], "long_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, wonder, and excitement.\n\nIn this first-of-its-kind outer space experience, you swivel your way down a cosmic path straight to the dance floor. We recommend using a swivel chair to make those tricky turns a blast!\n\nWhile you\u2019re swiveling towards the dance floor, get ready for a hands-on party - drumming, popping bubbles, opening doors, high-fiving aliens, and collecting music notes.\n\nThe beats? Crafted by the legendary Barry Leitch, these tunes groove with the story and your every move. There's a variety of rides, each with its own style, and the first ride, 'Fly,' is on the house \u2013 your sneak peek into the game's vibe.\n\nSome rides are swivel-heavy, so be prepared for some serious spinning action. And guess what? There are also secret paths to up the fun factor!\n\nSwivel offers a one-of-a-kind immersive experience that our first players have described as part dance party, part thrill ride, and part workout. They felt all kinds of good after playing.\n\nCan you swivel your way to the dance floor while having the most fun possible?\n\nSwivel on and dance!\n\nJoin our Discord to share feedback, requests, and stay on top of what's new: https://discord.gg/HcAXnXXf", "short_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, wonder, and excitement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.swivelvr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Dimensional Dilemma", "support_website_url": null, "website_url": "http://www.swivelvr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null
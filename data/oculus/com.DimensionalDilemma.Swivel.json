mjkSdByt_jXY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB3BF5SfmhGl48fCn-WgK3BdVMuWplmz9NbBk2DGgXK4Q&oe=6A523162"}, {"file_name": "YES4.png", "id": "202891426223143", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036644_202891429556476_5958224221900062947_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T32oJybehTYQ7kNvwETNXxF&_nc_oc=Adqv7Cct25sIYqwZjq0xzSrd52HkoMnA23HAgXm2ziAVS6d0gs0vn9O70r-L6jIvv-k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBnaay3drHk76aFW5uQnueyVo8NzTaS5wJ814Q83U3-sQ&oe=6A5232E1"}, {"file_name": "YES5.png", "id": "305075042512480", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75282159_305075045845813_1741575113918231749_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WEpRnH85q1oQ7kNvwF0Ak42&_nc_oc=Adq3lFI3VE0VN5dHm39t1TfRDY5MnjH67S0B_gU6LlQ05CD1RmW1YnBE-twhvk_vmBg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJqY-sigUx_XGbwKOSItSJPzARyxpzqfnxb0sJDcYukA&oe=6A523FFA"}, {"file_name": "YES2.png", "id": "763594575580277", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566685_763594578913610_402822167131551651_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4S7JYn1SrgIQ7kNvwHeNkHK&_nc_oc=AdrxRu-wd4hZvdTc8Atp-8VNsmN0Ey0ZAVDLol_toflM2Z_ZO7oGxOu3vuT0fWTC4vM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4j18AaIjJW3pI5OP8nnBQlpuKH6t0iUx0i4jLCDcb8A&oe=6A52610E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VR-Alien-Racing-Cover-Assets-01c.png", "id": "6977702768934253", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031457_6977702775600919_7356750813913174640_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5vEaV6dgMtgQ7kNvwH5ZKEe&_nc_oc=AdqZUJpM23WU5p04mwFIHV4K8ZKTlm209N0biJE8xuCBBUbiFneOylVEDz19Ti3wr_4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBRBYp2KhsfmdMFtdfCCk9WTLhS5O-z7myWDPDnO1c0fA&oe=6A5267CD"}, "display_name": "Swivel", "keywords": [], "long_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, wonder, and excitement.\n\nIn this first-of-its-kind outer space experience, you swivel your way down a cosmic path straight to the dance floor. We recommend using a swivel chair to make those tricky turns a blast!\n\nWhile you\u2019re swiveling towards the dance floor, get ready for a hands-on party - drumming, popping bubbles, opening doors, high-fiving aliens, and collecting music notes.\n\nThe beats? Crafted by the legendary Barry Leitch, these tunes groove with the story and your every move. There's a variety of rides, each with its own style, and the first ride, 'Fly,' is on the house \u2013 your sneak peek into the game's vibe.\n\nSome rides are swivel-heavy, so be prepared for some serious spinning action. And guess what? There are also secret paths to up the fun factor!\n\nSwivel offers a one-of-a-kind immersive experience that our first players have described as part dance party, part thrill ride, and part workout. They felt all kinds of good after playing.\n\nCan you swivel your way to the dance floor while having the most fun possible?\n\nSwivel on and dance!\n\nJoin our Discord to share feedback, requests, and stay on top of what's new: https://discord.gg/HcAXnXXf", "short_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, wonder, and excitement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.swivelvr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Dimensional Dilemma", "support_website_url": null, "website_url": "http://www.swivelvr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_a
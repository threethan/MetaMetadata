_sid=6e7a0a&_nc_ohc=OT1fHkwSaCEQ7kNvwGLvejL&_nc_oc=AdqSKDRJ3qh6Nm2R1swH6jsFbkLV22TGpSF9uI6izu4qVJlZAESQdUXbmEXg2R98Tt4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS9ZXD6XKazuCQYOD9ImnUNWCuyZUVn6AEILgbl9eGCXw&oe=6B0B2AA4"}, {"file_name": "YES3.png", "id": "1782958078873949", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75195906_1782958082207282_5459036329764607070_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xM7oawsO6IAQ7kNvwH_Tsa5&_nc_oc=AdpfskUA7prUkYI_zw7WZG_3wvl9Ncw3pi7GZs6NEWbqKbtvqoxiTV7ZWPmeBmXfdrw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSaA-CvwFBXQWJldjtBMfRLVe_FVt5NHdHAP_-EbZ_m_Q&oe=6B0B169E"}, {"file_name": "YES4.png", "id": "3605753746407518", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/86658875_3605753749740851_5280311873928099391_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wGaK-L5GjzsQ7kNvwEtXlUO&_nc_oc=AdpYUoDKh_Bv19hMGgEXzYID39j987E51lvFpHcDSJn2ANoyu_CN_Y24PEcGRNwyekA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS79b435PF2rI_vdZSywZLXhc3C8m6DqkTcnuI4F1k03w&oe=6B0B4310"}, {"file_name": "YES5.png", "id": "397310236287601", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031528_397310239620934_6959116179281752500_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tWTX1lihhlwQ7kNvwGdg74I&_nc_oc=AdrCjv5rSMO8G7Z1g75Br51qySZWJkgI2s0DM6bRfst5I3ZDq7cQFqAjhI8LvODp2l0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRO6ioa6K9rgiUgDCRlYXKMBlQM60OfiBr5Tajyv7D41Q&oe=6B0B33AE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Swivel_Creative_Landscape.png", "id": "700581638745125", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75348039_700581642078458_1915888512703558944_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8-XTVbVkfvkQ7kNvwEAKbVO&_nc_oc=AdqLvZMvnMlarEPby8SQWfZ5CYyGaQeaWqNGN7lG8_4I0g0oGURNfmuJwiBrVlaws78&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSHGJ9Vb_C6ZSY2JlTxqhFXHFenZNXKgAInKtBcMZhJrQ&oe=6B0B2ADF"}, "display_name": "Swivel - With Demo", "keywords": ["ride", "swivel", "seated", "rhythm", "fitness"], "long_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, and excitement.\n\nIn this first-of-its-kind outer space experience, you swivel your way down a cosmic track straight to the dance floor. \n\nWhile you\u2019re swiveling, get ready for a hands-on party - drumming, popping bubbles, opening doors, high-fiving aliens, and collecting music notes.\n\nThe beats? Crafted by the legendary Barry Leitch, these tunes groove with the story and your every move. There are 8 tracks, each with its own style, and the first ride, 'Fly,' is on the house \u2013 your sneak peek into the game's vibe:\n- Fly - pop (free)\n- Love me and leave me- 50s soul\n- Sweet tooth - pop dance\n- Sputnik - dubstep\n- Spin - light metal\n- Winter - classical\n- Wally Beben - retro\n- Ennio Morricone - western\n\nSome rides are swivel-heavy, so be prepared for some serious spinning action. And guess what? There are also secret paths to up the fun factor!\n\n\u2013 Important note \u2013\nPlease take your time easing into the game. After a few days of play, our bodies adjust, and spinning becomes incredibly enjoyable \u2013 it's like tapping into our inner child. \n\n\u2013 Seated game with a minimum play space of 6.5 feet by 6.5 feet \u2013\nSwivel is a seated game that involves turning and making cool moves. Ensure you have at least 3.3ft (1m) of space in all directions.\n\nWe recommend using a \u2018swivel\u2019 chair to make those tricky turns a blast!\n", "short_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, and excitement.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.swivelvr.com/privacypolicy", "developer_terms_of_service_url
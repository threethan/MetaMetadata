_sid=6e7a0a&_nc_ohc=PJhEQLYbF-cQ7kNvwHowQcy&_nc_oc=AdpcWLeoAI-SzAO3CAj2xx7FNC2Cd0gt6sBsVNzYYbX6PEcBsrqUO1mLUxI4h2EB6GQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSI8V-S-5bV-RaN_8bJnJvZDK39yXr9_UkGriEZmb_BjQ&oe=6B05AC64"}, {"file_name": "YES3.png", "id": "1782958078873949", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195906_1782958082207282_5459036329764607070_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jGO8mwN07uYQ7kNvwHh9Bt5&_nc_oc=AdpL4mT0XBByLR6VHzaMUCnvg35fyPwvJwkNjlJnZPgjbol22A1QxAgS3m1MZlXWawM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhrlUxAG1mpYblABkJabeFXK0WrTSgMs86QUXyDv9w2A&oe=6B05D09E"}, {"file_name": "YES4.png", "id": "3605753746407518", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86658875_3605753749740851_5280311873928099391_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0xYM9ZwQP_MQ7kNvwFgSk_p&_nc_oc=Adrfy2mqah_qn3ICtTffL1DkrXVS4uLsLARQgYQpKVb8uJu0ebA-4tIg5CetM3CRAvM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRI6dmmBnS_pC9QBhAVMiXeqspZnw5goMjTOMz9vVMiYg&oe=6B05C4D0"}, {"file_name": "YES5.png", "id": "397310236287601", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031528_397310239620934_6959116179281752500_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pG5jviWlICQQ7kNvwGaj2NG&_nc_oc=Adruu4ZBouU7tHAg6uroRw60dLnl6AVs5a-WtO3en8tFfJRcDcDB1S8NKl5VW5Pj5CA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQrlEdp1xZor6X793V0Qv5-FxrnCt5ERkNbtMKNJi5sYg&oe=6B05B56E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Swivel_Creative_Landscape.png", "id": "700581638745125", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75348039_700581642078458_1915888512703558944_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G1Qx4r2iz0MQ7kNvwEVaJdm&_nc_oc=AdpQSmhZRjtHh_19LLxef8eqiI-cM5OC0yW4zyiomQf8jwKcYKrz3EI6uSRLr_O5n7A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbdNWu_SzkejTefyc4yrG2Oi18cvAgMJMgC03vF9e8wA&oe=6B05AC9F"}, "display_name": "Swivel - With Demo", "keywords": ["ride", "swivel", "seated", "rhythm", "fitness"], "long_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, and excitement.\n\nIn this first-of-its-kind outer space experience, you swivel your way down a cosmic track straight to the dance floor. \n\nWhile you\u2019re swiveling, get ready for a hands-on party - drumming, popping bubbles, opening doors, high-fiving aliens, and collecting music notes.\n\nThe beats? Crafted by the legendary Barry Leitch, these tunes groove with the story and your every move. There are 8 tracks, each with its own style, and the first ride, 'Fly,' is on the house \u2013 your sneak peek into the game's vibe:\n- Fly - pop (free)\n- Love me and leave me- 50s soul\n- Sweet tooth - pop dance\n- Sputnik - dubstep\n- Spin - light metal\n- Winter - classical\n- Wally Beben - retro\n- Ennio Morricone - western\n\nSome rides are swivel-heavy, so be prepared for some serious spinning action. And guess what? There are also secret paths to up the fun factor!\n\n\u2013 Important note \u2013\nPlease take your time easing into the game. After a few days of play, our bodies adjust, and spinning becomes incredibly enjoyable \u2013 it's like tapping into our inner child. \n\n\u2013 Seated game with a minimum play space of 6.5 feet by 6.5 feet \u2013\nSwivel is a seated game that involves turning and making cool moves. Ensure you have at least 3.3ft (1m) of space in all directions.\n\nWe recommend using a \u2018swivel\u2019 chair to make those tricky turns a blast!\n", "short_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, and excitement.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.swivelvr.com/privacypolicy", "developer_terms_of_service_url
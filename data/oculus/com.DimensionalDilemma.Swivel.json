6AEF42E4"}, {"file_name": "YES3.png", "id": "1782958078873949", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75195906_1782958082207282_5459036329764607070_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zl3xfY1WTooQ7kNvwFuiPNA&_nc_oc=AdoavEX3L1xjTHcKCnvSZSMu3BU0SQl-F5TaCHdRmNk_JzaDfoYI7C6il4nBx9Hy5xo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlb7Q9VVl_Es5ENUHi7mR-bRF0dBAhMfDKIMf4VTdr5Q&oe=6AEF671E"}, {"file_name": "YES4.png", "id": "3605753746407518", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86658875_3605753749740851_5280311873928099391_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GJY8ISg31eQQ7kNvwFblYDS&_nc_oc=AdpO_XewsAEBn_f1cdblIcPhVaoMxIBqCArl91pElbJhnU0jp08SvJu-p2Jsg9w7Zgc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGP2JZDSou05GoRCTWdoPwGgfPZwDjB4sASrW93S0SNA&oe=6AEF5B50"}, {"file_name": "YES5.png", "id": "397310236287601", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031528_397310239620934_6959116179281752500_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mZHQtY7VtkQQ7kNvwGzfSKh&_nc_oc=AdpDBAvtL-9aNglUTtExkztjniYsB2cotTbfe4yJwNhVcFBgZwvYk786gQrH0YLRGY4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRejnjdVSViT80SGXJZva-SIkyuOrE-9IwAiAvO2kevDA&oe=6AEF4BEE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Swivel_Creative_Landscape.png", "id": "700581638745125", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75348039_700581642078458_1915888512703558944_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fAgYBVhJaAEQ7kNvwE62-wH&_nc_oc=AdqoymDjfiEPBwpQc3paPAyJKRHjLmcgK_g7ys9NzWTdJEqwOt6cK8GMATn6EOXLyuE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQToYTLCdk7AZwJUhzVabQPlmU8eiYPzYS8iit_VgHI8tw&oe=6AEF431F"}, "display_name": "Swivel - With Demo", "keywords": ["ride", "swivel", "seated", "rhythm", "fitness"], "long_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, and excitement.\n\nIn this first-of-its-kind outer space experience, you swivel your way down a cosmic track straight to the dance floor. \n\nWhile you\u2019re swiveling, get ready for a hands-on party - drumming, popping bubbles, opening doors, high-fiving aliens, and collecting music notes.\n\nThe beats? Crafted by the legendary Barry Leitch, these tunes groove with the story and your every move. There are 8 tracks, each with its own style, and the first ride, 'Fly,' is on the house \u2013 your sneak peek into the game's vibe:\n- Fly - pop (free)\n- Love me and leave me- 50s soul\n- Sweet tooth - pop dance\n- Sputnik - dubstep\n- Spin - light metal\n- Winter - classical\n- Wally Beben - retro\n- Ennio Morricone - western\n\nSome rides are swivel-heavy, so be prepared for some serious spinning action. And guess what? There are also secret paths to up the fun factor!\n\n\u2013 Important note \u2013\nPlease take your time easing into the game. After a few days of play, our bodies adjust, and spinning becomes incredibly enjoyable \u2013 it's like tapping into our inner child. \n\n\u2013 Seated game with a minimum play space of 6.5 feet by 6.5 feet \u2013\nSwivel is a seated game that involves turning and making cool moves. Ensure you have at least 3.3ft (1m) of space in all directions.\n\nWe recommend using a \u2018swivel\u2019 chair to make those tricky turns a blast!\n", "short_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, and excitement.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.swivelvr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Dimensional Dilemma", "support_website_url": "https://www.swivelvr.com/contact-us", "website_url": "http://www.swivelvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "
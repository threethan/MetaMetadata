5P7kxaYIvB0o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5amBTkeHxNqxUJ4AVryO7v1T7k6ibpReW1zqfJeROC6g&oe=6A031762"}, {"file_name": "YES4.png", "id": "202891426223143", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036644_202891429556476_5958224221900062947_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QKdsK1VOmCAQ7kNvwEGjR0S&_nc_oc=AdquKdd9ncAVo2WxHm18PYFXpUZjVn-E6ZX4pQPtpVn96-DobSRqa46fPOkSAMzznV0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4xvbQOIJnieOzG699jbSrkmmjf0Pvw4KcTaGI1DissxA&oe=6A0318E1"}, {"file_name": "YES5.png", "id": "305075042512480", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75282159_305075045845813_1741575113918231749_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=deaL__ED-5gQ7kNvwHiuuuB&_nc_oc=AdryRs8k-fJurU7QRE5Qoxkhg9rhB2mSLn9AHxluuXYtjX6JZZDS6GwQE92dcFjjki8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7AX9V36jzVi0r28LDEsMIgjeUtURjDqEhx1_WgAJDplw&oe=6A0325FA"}, {"file_name": "YES2.png", "id": "763594575580277", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566685_763594578913610_402822167131551651_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vz493bH8U1YQ7kNvwELLnW2&_nc_oc=AdoLgR_vQ_iljXLMceO31iDG8j0IvxAV7kZ3AZ9FONtYnG1twzUtx79TDiLsYxqI2I0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4E0XXuFMGOl3_hREEi7g21Etpv1zvdozmadTzF47n6NQ&oe=6A03470E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VR-Alien-Racing-Cover-Assets-01c.png", "id": "6977702768934253", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031457_6977702775600919_7356750813913174640_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zgSavUcgFRcQ7kNvwEvojsA&_nc_oc=AdptLLNQe2BrbbpxWXfd222KiNACrDP3ex45_jYLpl9FMGJ75t2Nv4h_0U_lTA4fnaE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4l4EsfzQqNr5F6i_eN3RS3OwS5hRF_ZXUPTRsIW2zdhg&oe=6A03158D"}, "display_name": "Swivel", "keywords": [], "long_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, wonder, and excitement.\n\nIn this first-of-its-kind outer space experience, you swivel your way down a cosmic path straight to the dance floor. We recommend using a swivel chair to make those tricky turns a blast!\n\nWhile you\u2019re swiveling towards the dance floor, get ready for a hands-on party - drumming, popping bubbles, opening doors, high-fiving aliens, and collecting music notes.\n\nThe beats? Crafted by the legendary Barry Leitch, these tunes groove with the story and your every move. There's a variety of rides, each with its own style, and the first ride, 'Fly,' is on the house \u2013 your sneak peek into the game's vibe.\n\nSome rides are swivel-heavy, so be prepared for some serious spinning action. And guess what? There are also secret paths to up the fun factor!\n\nSwivel offers a one-of-a-kind immersive experience that our first players have described as part dance party, part thrill ride, and part workout. They felt all kinds of good after playing.\n\nCan you swivel your way to the dance floor while having the most fun possible?\n\nSwivel on and dance!\n\nJoin our Discord to share feedback, requests, and stay on top of what's new: https://discord.gg/HcAXnXXf", "short_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, wonder, and excitement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.swivelvr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Dimensional Dilemma", "support_website_url": null, "website_url": "http://www.swivelvr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_a
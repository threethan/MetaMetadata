_sid=6e7a0a&_nc_ohc=woAS5uhPT6oQ7kNvwHCtqk6&_nc_oc=AdqyD6PwfY42omV4RektH-VHsPgIFvhQjQd4TI3GBU31LBROQ-B55KZP7_0_-huxkxs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_YPjeaqObHw-_mTKBtIEL0LRVSWA-_vgfPYfIRr_VUA&oe=6B006664"}, {"file_name": "YES3.png", "id": "1782958078873949", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195906_1782958082207282_5459036329764607070_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SI85Lwhnz4sQ7kNvwE_wDoG&_nc_oc=AdqcmdnsJgJjrd77NT2C7I3xdxq2bBCW_-cP2GkmE49THtzrk1rnFtbeG17GJdQH9jQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSb6pcA5Z1dnIu_RVZNyl-iZ7eSD3KfESf8HZ3CAnbsTg&oe=6B00525E"}, {"file_name": "YES4.png", "id": "3605753746407518", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86658875_3605753749740851_5280311873928099391_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s0FdurNqvioQ7kNvwHGuY8m&_nc_oc=AdrjERBPtusPBTGwN8isngeodOmUKrG2QYP5wWV5qUx3WHRzDF6G1I8fkrxKAyhzw04&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdJE6O4ru_ifDJ5Ca_iqUdYuUSX4Tal2q_5SDMcI5D1A&oe=6B007ED0"}, {"file_name": "YES5.png", "id": "397310236287601", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031528_397310239620934_6959116179281752500_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mJ6uElWFCtkQ7kNvwHyoCA_&_nc_oc=AdrW10dG_1PvwnRKhfrMQ8382LmqckIPFpvEVDEDxuse8lszBFHdS6-Uq54sPXziO8g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8wachpt3pJ9vRWSK-aLEXbiNOa6IAhO95sYEDR8L1Ow&oe=6B006F6E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Swivel_Creative_Landscape.png", "id": "700581638745125", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75348039_700581642078458_1915888512703558944_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vQQadEXDZOoQ7kNvwFJ08Ej&_nc_oc=AdrxCb1xlkbMG6P4tVUQj1CL7mySw48ighEtRqxts0fM6oNN83XVPyZkgSvNOAUPW00&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxFQZqDZGjQV90wXCpSs3cBEb-G3-vyk--CuKVCg97pA&oe=6B00669F"}, "display_name": "Swivel - With Demo", "keywords": ["ride", "swivel", "seated", "rhythm", "fitness"], "long_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, and excitement.\n\nIn this first-of-its-kind outer space experience, you swivel your way down a cosmic track straight to the dance floor. \n\nWhile you\u2019re swiveling, get ready for a hands-on party - drumming, popping bubbles, opening doors, high-fiving aliens, and collecting music notes.\n\nThe beats? Crafted by the legendary Barry Leitch, these tunes groove with the story and your every move. There are 8 tracks, each with its own style, and the first ride, 'Fly,' is on the house \u2013 your sneak peek into the game's vibe:\n- Fly - pop (free)\n- Love me and leave me- 50s soul\n- Sweet tooth - pop dance\n- Sputnik - dubstep\n- Spin - light metal\n- Winter - classical\n- Wally Beben - retro\n- Ennio Morricone - western\n\nSome rides are swivel-heavy, so be prepared for some serious spinning action. And guess what? There are also secret paths to up the fun factor!\n\n\u2013 Important note \u2013\nPlease take your time easing into the game. After a few days of play, our bodies adjust, and spinning becomes incredibly enjoyable \u2013 it's like tapping into our inner child. \n\n\u2013 Seated game with a minimum play space of 6.5 feet by 6.5 feet \u2013\nSwivel is a seated game that involves turning and making cool moves. Ensure you have at least 3.3ft (1m) of space in all directions.\n\nWe recommend using a \u2018swivel\u2019 chair to make those tricky turns a blast!\n", "short_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, and excitement.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.swivelvr.com/privacypolicy", "developer_terms_of_service_url
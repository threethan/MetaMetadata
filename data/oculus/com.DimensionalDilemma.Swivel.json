5OfcpRoY7U5E&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5OUhXjYGEi7yqEVGrks3Y0jx038QKFIbwYmCjy7k4Pbg&oe=6A107EA2"}, {"file_name": "YES4.png", "id": "202891426223143", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39036644_202891429556476_5958224221900062947_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TWiztoGhgJ0Q7kNvwErU1Kv&_nc_oc=AdpDk2DJofNW-Oj3HvmW1wVxuEMIZ8kBothc9iQmUWiuYO_p_wgtTZtrOUSFoJxx6zg&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6nV8GdHmakgqyEKvoqK7UNn08Bn39XjSmMRmNGDW6zIw&oe=6A1047E1"}, {"file_name": "YES5.png", "id": "305075042512480", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75282159_305075045845813_1741575113918231749_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3epAgBUZG40Q7kNvwELcX74&_nc_oc=Adr-hmHCMhaQtxNotuc__y2ZIjlM5HGp19qTxcWekcY9qseKP7bv9p71liJO7DlgE_I&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4zYt2ZFC3Dl8Ip9B8x5Rl6PTvrZsfQ28-AGuI9j2qX9Q&oe=6A1054FA"}, {"file_name": "YES2.png", "id": "763594575580277", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/57566685_763594578913610_402822167131551651_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OFxQvV35XkEQ7kNvwFUG0Ac&_nc_oc=AdrCKHPYrLOKtiW2lM1zbsq_s-k_XKU6IHKRGg0_UawpTPPZpny1Fnmm0SCugEi_SnU&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7EIMNW6BEU4eY5bt0ffLmj-vjjZe2ylb4n5RrrwCzSBw&oe=6A10760E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VR-Alien-Racing-Cover-Assets-01c.png", "id": "6977702768934253", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031457_6977702775600919_7356750813913174640_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ZkXvdk2kT8Q7kNvwGnteVI&_nc_oc=AdqbHhEtBYpUgHNkOmIkwvnqg2MIn5PdsdZIpaOFjag8hw-5dl2EUuTKy0dXk7HZCHg&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6of5witx2AsNXhmvs9OoNDfBHsrlC7BQtVyxWsut1kTQ&oe=6A107CCD"}, "display_name": "Swivel", "keywords": [], "long_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, wonder, and excitement.\n\nIn this first-of-its-kind outer space experience, you swivel your way down a cosmic path straight to the dance floor. We recommend using a swivel chair to make those tricky turns a blast!\n\nWhile you\u2019re swiveling towards the dance floor, get ready for a hands-on party - drumming, popping bubbles, opening doors, high-fiving aliens, and collecting music notes.\n\nThe beats? Crafted by the legendary Barry Leitch, these tunes groove with the story and your every move. There's a variety of rides, each with its own style, and the first ride, 'Fly,' is on the house \u2013 your sneak peek into the game's vibe.\n\nSome rides are swivel-heavy, so be prepared for some serious spinning action. And guess what? There are also secret paths to up the fun factor!\n\nSwivel offers a one-of-a-kind immersive experience that our first players have described as part dance party, part thrill ride, and part workout. They felt all kinds of good after playing.\n\nCan you swivel your way to the dance floor while having the most fun possible?\n\nSwivel on and dance!\n\nJoin our Discord to share feedback, requests, and stay on top of what's new: https://discord.gg/HcAXnXXf", "short_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, wonder, and excitement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.swivelvr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Dimensional Dilemma", "support_website_url": null, "website_url": "http://www.swivelvr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_a
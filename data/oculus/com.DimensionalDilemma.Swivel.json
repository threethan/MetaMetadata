mR2yxNMAUFak&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxPxX2X0a8CmqSAohtNaNUFgimDkeS0oYm6kMk_9pCCfg&oe=69C3CF62"}, {"file_name": "YES4.png", "id": "202891426223143", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39036644_202891429556476_5958224221900062947_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4_vj2izFAXoQ7kNvwFx8nls&_nc_oc=Adpy1gqoKdmthIVhx45W9cdzI3A4VpJRj4ywS1fW36ojs78rOUoLPjAoDr8F9RUBUeg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwbv4TXPUll1FSQdtEFqSpl0UZGaW9E1nNodpq9VeZR_g&oe=69C3D0E1"}, {"file_name": "YES5.png", "id": "305075042512480", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75282159_305075045845813_1741575113918231749_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=468cJYYmlQMQ7kNvwG7P6uw&_nc_oc=AdrzG-3GrR3_Ol-gs_pPdwezaf4TrlWj-PZ-aZS8K-KMU8p7mNS1ks6fLx-z2VOBePM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwZDYfDnjLLZfzNY2bvdFnHCionyab3n9TeFhNvWU-eog&oe=69C3DDFA"}, {"file_name": "YES2.png", "id": "763594575580277", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57566685_763594578913610_402822167131551651_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6sDk6HM5tBEQ7kNvwG9SC5d&_nc_oc=AdqoNcsUCVsuLX8aqAGeIz0NC3O7OW_yeSxvCJ_olVKBuOQMp27eaUbw5yBV3FryztQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwIZ8hfcThZdfIN3EH71XAZtoDLx3_pZEc6X3Xd_dsuTw&oe=69C3C6CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VR-Alien-Racing-Cover-Assets-01c.png", "id": "6977702768934253", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031457_6977702775600919_7356750813913174640_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MrIyLU4Y2XcQ7kNvwEqA9QE&_nc_oc=Adq6B3qxdUpkLf9CnUavgTCVFYjHj6Zqy8fmk2ocqrjJ2k2CVtdDGF9PXGUGja67gkU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyhcKXt5E7wz8wtXVb_8K_xPLyDF6aF4NkncT96m_7RKw&oe=69C3CD8D"}, "display_name": "Swivel", "keywords": [], "long_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, wonder, and excitement.\n\nIn this first-of-its-kind outer space experience, you swivel your way down a cosmic path straight to the dance floor. We recommend using a swivel chair to make those tricky turns a blast!\n\nWhile you\u2019re swiveling towards the dance floor, get ready for a hands-on party - drumming, popping bubbles, opening doors, high-fiving aliens, and collecting music notes.\n\nThe beats? Crafted by the legendary Barry Leitch, these tunes groove with the story and your every move. There's a variety of rides, each with its own style, and the first ride, 'Fly,' is on the house \u2013 your sneak peek into the game's vibe.\n\nSome rides are swivel-heavy, so be prepared for some serious spinning action. And guess what? There are also secret paths to up the fun factor!\n\nSwivel offers a one-of-a-kind immersive experience that our first players have described as part dance party, part thrill ride, and part workout. They felt all kinds of good after playing.\n\nCan you swivel your way to the dance floor while having the most fun possible?\n\nSwivel on and dance!\n\nJoin our Discord to share feedback, requests, and stay on top of what's new: https://discord.gg/HcAXnXXf", "short_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, wonder, and excitement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.swivelvr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Dimensional Dilemma", "support_website_url": null, "website_url": "http://www.swivelvr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_a
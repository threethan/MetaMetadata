6A2D7664"}, {"file_name": "YES3.png", "id": "1782958078873949", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75195906_1782958082207282_5459036329764607070_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bG0SFV4CpWYQ7kNvwFRwaRN&_nc_oc=AdpNwDKUcpgPA_tkGCPaaaRBUYBJ7Zuygzmjy4rlAuQUvmw1co-6oRt1hBWqRK-p2ZU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bQb5-fP_Jtvz-yMwNoJnuc1rCvTFLC68UP3QpDDr9Ew&oe=6A2D625E"}, {"file_name": "YES4.png", "id": "3605753746407518", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86658875_3605753749740851_5280311873928099391_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gBqM2wFSUXQQ7kNvwEIR4bf&_nc_oc=Adqq3KfJwjB2e6EM5X4Zqs-o0iWt5mPIK8FrEaEgnxuuAh5NxUqAU7v20BABODBKoUA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2_12XBsb0-aHFFQfrxyDW8WreBdHCnZS34cgYHrD1kA&oe=6A2D5690"}, {"file_name": "YES5.png", "id": "397310236287601", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031528_397310239620934_6959116179281752500_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yrY3jacM6vsQ7kNvwHvCIP-&_nc_oc=AdoO3oG6blpY1IOGFg82YODZ4ol4RyUkHplppg3ZjZEg9CCfgcziSvaoRzcWazxB4xA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7OK7eaPkrc_Of-iVJqG12y0L5a_fX4vJMI2EQQxCFow&oe=6A2D7F6E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Swivel_Creative_Landscape.png", "id": "700581638745125", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75348039_700581642078458_1915888512703558944_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GrHUgE2seTIQ7kNvwFPL1bI&_nc_oc=AdoE1-PzqJClH1XZYnVR8l4CMa8vwfuo7RGzvDvc66uE3_hyU9J_Uc8Zx2QxgE54s-k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6gdgKDkB_MGUArprV-j-L-Ou24Q2UGyV2cT_VCSWDHw&oe=6A2D769F"}, "display_name": "Swivel - With Demo", "keywords": ["ride", "swivel", "seated", "rhythm", "fitness"], "long_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, and excitement.\n\nIn this first-of-its-kind outer space experience, you swivel your way down a cosmic track straight to the dance floor. \n\nWhile you\u2019re swiveling, get ready for a hands-on party - drumming, popping bubbles, opening doors, high-fiving aliens, and collecting music notes.\n\nThe beats? Crafted by the legendary Barry Leitch, these tunes groove with the story and your every move. There are 8 tracks, each with its own style, and the first ride, 'Fly,' is on the house \u2013 your sneak peek into the game's vibe:\n- Fly - pop (free)\n- Love me and leave me- 50s soul\n- Sweet tooth - pop dance\n- Sputnik - dubstep\n- Spin - light metal\n- Winter - classical\n- Wally Beben - retro\n- Ennio Morricone - western\n\nSome rides are swivel-heavy, so be prepared for some serious spinning action. And guess what? There are also secret paths to up the fun factor!\n\n\u2013 Important note \u2013\nPlease take your time easing into the game. After a few days of play, our bodies adjust, and spinning becomes incredibly enjoyable \u2013 it's like tapping into our inner child. \n\n\u2013 Seated game with a minimum play space of 6.5 feet by 6.5 feet \u2013\nSwivel is a seated game that involves turning and making cool moves. Ensure you have at least 3.3ft (1m) of space in all directions.\n\nWe recommend using a \u2018swivel\u2019 chair to make those tricky turns a blast!\n", "short_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, and excitement.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.swivelvr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Dimensional Dilemma", "support_website_url": "https://www.swivelvr.com/contact-us", "website_url": "http://www.swivelvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "
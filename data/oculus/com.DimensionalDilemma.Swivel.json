uAzxHVhb9m7o&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2YyTf2ChDLhNz3swPQ2LqJQYk0by6HhcR8_fnyWc7A9A&oe=69E221E2"}, {"file_name": "YES4.png", "id": "202891426223143", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39036644_202891429556476_5958224221900062947_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l8LmmdXPMOAQ7kNvwE0_Nkn&_nc_oc=AdpRKCOoczvxTW5-DUqIOTL95cw7EMJv1admuaSiut1vwqFFF-Rdf-dkHm9a6VPQqJ4&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3F4DW_pGUmP0yDfUbkmQ6m1QNqAMDZe-vqHnvP_70COw&oe=69E22361"}, {"file_name": "YES5.png", "id": "305075042512480", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75282159_305075045845813_1741575113918231749_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9uf-hbw0j8UQ7kNvwGy1FLo&_nc_oc=AdqPcKBr8jCxePQwrb9vbXp2hUrkR46muTi_xgjrP-8vDryWWF5xsJHEf_JHf3iDkxg&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af18mwiNY7xy4dMUve9KNGFIHvqlRgiwCFpCWcqrpBkHNg&oe=69E2307A"}, {"file_name": "YES2.png", "id": "763594575580277", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/57566685_763594578913610_402822167131551651_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bx7OAXC_k_8Q7kNvwEv1TN4&_nc_oc=AdoZU28Eaf3oS_yccSeSywWkZS_CWtDCj4naw6ZefV-Lo-Jn3Qz7tF6lA1V5QtJbqY4&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Mnr97opoFMzg5-CjmJKqseAGia6__vRgbyOdfVod7Ng&oe=69E2518E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VR-Alien-Racing-Cover-Assets-01c.png", "id": "6977702768934253", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031457_6977702775600919_7356750813913174640_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_xIecbQ2sPoQ7kNvwFexZaR&_nc_oc=AdoEU_oChu3E_agqjkElPvIvbFdB2g4h1hbaXxMOIe7vS_86kfN47eC3M4iKG8ET0z8&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1CdgYBIg15mVKGgek43zTlK8JlIzzuA3nMx9Ooq-U-vg&oe=69E2200D"}, "display_name": "Swivel", "keywords": [], "long_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, wonder, and excitement.\n\nIn this first-of-its-kind outer space experience, you swivel your way down a cosmic path straight to the dance floor. We recommend using a swivel chair to make those tricky turns a blast!\n\nWhile you\u2019re swiveling towards the dance floor, get ready for a hands-on party - drumming, popping bubbles, opening doors, high-fiving aliens, and collecting music notes.\n\nThe beats? Crafted by the legendary Barry Leitch, these tunes groove with the story and your every move. There's a variety of rides, each with its own style, and the first ride, 'Fly,' is on the house \u2013 your sneak peek into the game's vibe.\n\nSome rides are swivel-heavy, so be prepared for some serious spinning action. And guess what? There are also secret paths to up the fun factor!\n\nSwivel offers a one-of-a-kind immersive experience that our first players have described as part dance party, part thrill ride, and part workout. They felt all kinds of good after playing.\n\nCan you swivel your way to the dance floor while having the most fun possible?\n\nSwivel on and dance!\n\nJoin our Discord to share feedback, requests, and stay on top of what's new: https://discord.gg/HcAXnXXf", "short_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, wonder, and excitement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.swivelvr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Dimensional Dilemma", "support_website_url": null, "website_url": "http://www.swivelvr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_a
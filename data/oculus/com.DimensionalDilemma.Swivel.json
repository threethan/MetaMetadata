gDm_ANRF0FWqdMHu90QI6acLLp4ehNBQ&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFpJJsl33KEk0zdsn2ok0tleMP8AntTrTaXaRMIN1dpoA&oe=6A8D84E2"}, {"file_name": "YES4.png", "id": "202891426223143", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39036644_202891429556476_5958224221900062947_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3UZO7vEaziYQ7kNvwG68VlO&_nc_oc=Adqz3nvHNcH1S8WxxEYa6lhbII_3u5yRwdWM7eHZiGX9O2maDa-TLpcCFQWfGSDTII8&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFwwpRjG95B1GK_FqSzxIvlvCsx8cw7XUmDkb8x8tyOLw&oe=6A8D8661"}, {"file_name": "YES5.png", "id": "305075042512480", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75282159_305075045845813_1741575113918231749_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YzvnInPtNuwQ7kNvwEHuveN&_nc_oc=AdoCp7hyuNt7y_L_Z7B8_RrRhanAoC6LvrsY6tgGfjW6yJ20k34FGCr73lRXSDoP51Q&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGyspeeOG3o-iOstjAl3-W39Qzx7crua6Cg7iKfy4RzKw&oe=6A8D937A"}, {"file_name": "YES2.png", "id": "763594575580277", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/57566685_763594578913610_402822167131551651_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v4aHiE2M--0Q7kNvwHa_M__&_nc_oc=Adr3d83Ibsr3JOIFngQnpso6wJBlshqlomPgGr4zDlauBLMa8JQIhrqYLZASi4mxPlI&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHnjuLQ_i1H_hgpbEBeC_LEXwa0AcrcQ3xdn92Kly6Tng&oe=6A8D7C4E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VR-Alien-Racing-Cover-Assets-01c.png", "id": "6977702768934253", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031457_6977702775600919_7356750813913174640_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UeQclopkav4Q7kNvwEbKfOU&_nc_oc=Adpq_xGjiiyvz9tLJBUfmemxxSR2JS4QD7ZEDmF1EJksYdZoHGq4mut3OSADJcfvPKk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEaFILIJQw3FoNKGZOlx8u6HyH0N4wl_QUFdtslZdQzdA&oe=6A8D830D"}, "display_name": "Swivel", "keywords": [], "long_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, wonder, and excitement.\n\nIn this first-of-its-kind outer space experience, you swivel your way down a cosmic path straight to the dance floor. We recommend using a swivel chair to make those tricky turns a blast!\n\nWhile you\u2019re swiveling towards the dance floor, get ready for a hands-on party - drumming, popping bubbles, opening doors, high-fiving aliens, and collecting music notes.\n\nThe beats? Crafted by the legendary Barry Leitch, these tunes groove with the story and your every move. There's a variety of rides, each with its own style, and the first ride, 'Fly,' is on the house \u2013 your sneak peek into the game's vibe.\n\nSome rides are swivel-heavy, so be prepared for some serious spinning action. And guess what? There are also secret paths to up the fun factor!\n\nSwivel offers a one-of-a-kind immersive experience that our first players have described as part dance party, part thrill ride, and part workout. They felt all kinds of good after playing.\n\nCan you swivel your way to the dance floor while having the most fun possible?\n\nSwivel on and dance!\n\nJoin our Discord to share feedback, requests, and stay on top of what's new: https://discord.gg/HcAXnXXf", "short_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, wonder, and excitement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.swivelvr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Dimensional Dilemma", "support_website_url": null, "website_url": "http://www.swivelvr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRE
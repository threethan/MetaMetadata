IFhmG45SCB7I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCjfw5VPaCr4rO623okY_Pbg__EP2LlKtejfp51eqe7iA&oe=6A54D462"}, {"file_name": "YES4.png", "id": "202891426223143", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036644_202891429556476_5958224221900062947_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hut0n8ynFlgQ7kNvwHw4PAq&_nc_oc=AdoDcgGksf0BKZ23HOGL25CikcvBy-DjncH3NTPSLx3LWUZmnvVbjYD29vl41LTefDQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA1YvvalGw14XZJCiBol67hLedB_cY9tRJjkQPpC0pprg&oe=6A54D5E1"}, {"file_name": "YES5.png", "id": "305075042512480", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75282159_305075045845813_1741575113918231749_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CV6f_zDTCFwQ7kNvwHum3HO&_nc_oc=Adqc5f8lGopPAixXmFI-aqT5YcLYHr2HQIAOVf5qd0fe4sRxUs1fBJOadXmBNVwtweE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAd388KsadjY5nvvuKwky7vLYRd0z6gKW9euFM7MqyRcg&oe=6A54E2FA"}, {"file_name": "YES2.png", "id": "763594575580277", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57566685_763594578913610_402822167131551651_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x3INlAyA6q8Q7kNvwHbib5O&_nc_oc=AdpSOhe72HJ72zQpaPn64d4bRuRfl27y2fABbn0vEO_CbSbdrCB8RPwULkVAnP2o_Y4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDlnz16fQoPKpBNEd7FafcwyJfxbaQfJSz5gpgZPGMIFQ&oe=6A55040E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VR-Alien-Racing-Cover-Assets-01c.png", "id": "6977702768934253", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031457_6977702775600919_7356750813913174640_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0UuH1_hKoVUQ7kNvwGk_4xK&_nc_oc=AdrrkeCmHu7LB0qlSBQTfADC-nalykNHXKKvU5KhXtcdpssxINpG3ttGMH7XYzpUMXc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-pQkhVRZHk4MKTH0TIDFHfxvzAMpley_QCP4fjrjESw&oe=6A550ACD"}, "display_name": "Swivel", "keywords": [], "long_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, wonder, and excitement.\n\nIn this first-of-its-kind outer space experience, you swivel your way down a cosmic path straight to the dance floor. We recommend using a swivel chair to make those tricky turns a blast!\n\nWhile you\u2019re swiveling towards the dance floor, get ready for a hands-on party - drumming, popping bubbles, opening doors, high-fiving aliens, and collecting music notes.\n\nThe beats? Crafted by the legendary Barry Leitch, these tunes groove with the story and your every move. There's a variety of rides, each with its own style, and the first ride, 'Fly,' is on the house \u2013 your sneak peek into the game's vibe.\n\nSome rides are swivel-heavy, so be prepared for some serious spinning action. And guess what? There are also secret paths to up the fun factor!\n\nSwivel offers a one-of-a-kind immersive experience that our first players have described as part dance party, part thrill ride, and part workout. They felt all kinds of good after playing.\n\nCan you swivel your way to the dance floor while having the most fun possible?\n\nSwivel on and dance!\n\nJoin our Discord to share feedback, requests, and stay on top of what's new: https://discord.gg/HcAXnXXf", "short_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, wonder, and excitement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.swivelvr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Dimensional Dilemma", "support_website_url": null, "website_url": "http://www.swivelvr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_a
yj0BYLU3gJRM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNDopTU94paws0r-jXUwFKd78XDcjitYJTSrPwOi9H9rg&oe=6AC127A2"}, {"file_name": "YES4.png", "id": "202891426223143", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036644_202891429556476_5958224221900062947_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wx3sKHVpYHUQ7kNvwFlS3ck&_nc_oc=Adq-l-VQP0VW3FxAEr2GldK1XHHpeNXqpB_ykFZD9Lh36m2WJAAl00QCqcajWKVE3X0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPfDzUFOKcLyOYtk7ktK2pq366FsNoPznepuiYon9s4tw&oe=6AC12921"}, {"file_name": "YES5.png", "id": "305075042512480", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75282159_305075045845813_1741575113918231749_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yqEd3xm28jQQ7kNvwHX_kiA&_nc_oc=AdrJG5Q0YuBqC_7pE1u03-Hq4zuaGku1MI3Nxat-x9tjqhDpneqrNqRX7fNW-irKuJ8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNmlD9KTL-JbTTXakdv5cQzcFvLcky5i4yIEFG0XzrRuw&oe=6AC0FDFA"}, {"file_name": "YES2.png", "id": "763594575580277", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566685_763594578913610_402822167131551651_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C_MklHROydUQ7kNvwE8-Ys9&_nc_oc=AdrLjFkW_gbaNhcbc0Nj8NlNvbwopJEqKeb7exqjbwcIA_sgmFMJ1Xb1F1VwQJ_GEKM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN_MU0to1sdQPemF6mFVsxpjW5jvvayspD-5LLUGPMRWw&oe=6AC11F0E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VR-Alien-Racing-Cover-Assets-01c.png", "id": "6977702768934253", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031457_6977702775600919_7356750813913174640_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2eTHUvCT2XoQ7kNvwHhnObf&_nc_oc=Adp62pGAmho1MeqQ97id54x3NxDzdqPvtU1km4-XiG5Aw-aT46tVfFvzkPZMT56SyAQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMrxiis5WE0ceAqyCeYXG9c9X5mW9tyCRCXOsICGLqVdQ&oe=6AC125CD"}, "display_name": "Swivel", "keywords": [], "long_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, wonder, and excitement.\n\nIn this first-of-its-kind outer space experience, you swivel your way down a cosmic path straight to the dance floor. We recommend using a swivel chair to make those tricky turns a blast!\n\nWhile you\u2019re swiveling towards the dance floor, get ready for a hands-on party - drumming, popping bubbles, opening doors, high-fiving aliens, and collecting music notes.\n\nThe beats? Crafted by the legendary Barry Leitch, these tunes groove with the story and your every move. There's a variety of rides, each with its own style, and the first ride, 'Fly,' is on the house \u2013 your sneak peek into the game's vibe.\n\nSome rides are swivel-heavy, so be prepared for some serious spinning action. And guess what? There are also secret paths to up the fun factor!\n\nSwivel offers a one-of-a-kind immersive experience that our first players have described as part dance party, part thrill ride, and part workout. They felt all kinds of good after playing.\n\nCan you swivel your way to the dance floor while having the most fun possible?\n\nSwivel on and dance!\n\nJoin our Discord to share feedback, requests, and stay on top of what's new: https://discord.gg/HcAXnXXf", "short_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, wonder, and excitement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.swivelvr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Dimensional Dilemma", "support_website_url": null, "website_url": "http://www.swivelvr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_a
mrAzibOg_ApMhxfIVGMPF1yUN_d-xpoZA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLBESypNGiLdMhHhYPSgcbnUFhvpz4T-16_DYCZ3tsy2g&oe=6AAEB2A2"}, {"file_name": "YES4.png", "id": "202891426223143", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39036644_202891429556476_5958224221900062947_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eusCGUF5-34Q7kNvwGLWrL-&_nc_oc=AdodtxS7kUfX9N6zx8yP4xrC6_HgGUh4kBbN0pDhj6Gy0yijSSLqSXDVfRr_-3DNKSw&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4BOQlXvQXObeNSrUNQzOKQbpAZZu7WO-zKKcV_ZmYWQ&oe=6AAEB421"}, {"file_name": "YES5.png", "id": "305075042512480", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75282159_305075045845813_1741575113918231749_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zpaXZ4dYkw8Q7kNvwERwwlz&_nc_oc=AdpNtS3Uweb1RZAlAIHw3ueuB-wteyH3eTrmu7v83bta27Mc4yONwFApq2u-PXd76Tk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKx8wVU0RGIVdi1xycNl2s2mBMvbI5Z1xDGKMeE9Yye1A&oe=6AAE88FA"}, {"file_name": "YES2.png", "id": "763594575580277", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/57566685_763594578913610_402822167131551651_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sGdolU_AaLgQ7kNvwELIxdY&_nc_oc=AdooMEt-8t6Sx_E2A1mG4DilFbUPLzrYF23jbH4l4MfqWNizTgoBOp_3Wk5xNu3Blp0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJyc6IoasHM6Y0wL-8CQ8zcejTT9MIBGTJSzbqD5kPIjQ&oe=6AAEAA0E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VR-Alien-Racing-Cover-Assets-01c.png", "id": "6977702768934253", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031457_6977702775600919_7356750813913174640_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-g5m_AAIN54Q7kNvwEjJpvN&_nc_oc=Ado8xK-taFgYvoMmOFCzDfl7N5wDBLaHyPHIhnb97lPut7xvvCJyj1qD2O3DWnwNw0s&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLb0vEST6IbfG2UyBpA4ctv9-d03FLYOZr10EC9iru8A&oe=6AAEB0CD"}, "display_name": "Swivel", "keywords": [], "long_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, wonder, and excitement.\n\nIn this first-of-its-kind outer space experience, you swivel your way down a cosmic path straight to the dance floor. We recommend using a swivel chair to make those tricky turns a blast!\n\nWhile you\u2019re swiveling towards the dance floor, get ready for a hands-on party - drumming, popping bubbles, opening doors, high-fiving aliens, and collecting music notes.\n\nThe beats? Crafted by the legendary Barry Leitch, these tunes groove with the story and your every move. There's a variety of rides, each with its own style, and the first ride, 'Fly,' is on the house \u2013 your sneak peek into the game's vibe.\n\nSome rides are swivel-heavy, so be prepared for some serious spinning action. And guess what? There are also secret paths to up the fun factor!\n\nSwivel offers a one-of-a-kind immersive experience that our first players have described as part dance party, part thrill ride, and part workout. They felt all kinds of good after playing.\n\nCan you swivel your way to the dance floor while having the most fun possible?\n\nSwivel on and dance!\n\nJoin our Discord to share feedback, requests, and stay on top of what's new: https://discord.gg/HcAXnXXf", "short_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, wonder, and excitement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.swivelvr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Dimensional Dilemma", "support_website_url": null, "website_url": "http://www.swivelvr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRE
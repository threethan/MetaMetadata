qr8rd4wMzPMDZYpITOO6CwHbjelGm5Nw&oe=69B2ABE2"}, {"file_name": "YES4.png", "id": "202891426223143", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036644_202891429556476_5958224221900062947_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PLknNGtnQrAQ7kNvwFJTBar&_nc_oc=AdnVosKFbui4xnOItq3A-9hoZtfMklCBbE_6KcteEgkh3kIh7-Z7Cc03yc36l7ftrRc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy8cJ_4-uTUwO1To67xzgF-0N2FzQrAt4StQePPfCKBJw&oe=69B2AD61"}, {"file_name": "YES5.png", "id": "305075042512480", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75282159_305075045845813_1741575113918231749_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ToXGifJjYG0Q7kNvwHR_YXL&_nc_oc=Adl4CKUKLLA8WCbWYNC8a9TqolGqIO5aNcFSjOgDNfklkQvyvocnTbqJqxaFe2m-7o8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afygq2XP53jLH5nV2nIe6yOQZeWTiB5vfQfj2ExhPv1YAw&oe=69B2BA7A"}, {"file_name": "YES2.png", "id": "763594575580277", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566685_763594578913610_402822167131551651_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ik9Zutbcu8Q7kNvwEeTtyo&_nc_oc=AdnoVaFSGe2mTHwhvIVloFxTLRRyVtyaGugzYhsXl3R4o8FsTtZx5hMoNTaz_ZpxAR4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afx_TWj3vEi9-emMmyuDIgbaNNJ7uP6GZeFMfEnfLWWZ2w&oe=69B2A34E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VR-Alien-Racing-Cover-Assets-01c.png", "id": "6977702768934253", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031457_6977702775600919_7356750813913174640_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4if6HIqVI4UQ7kNvwECKR-W&_nc_oc=AdkVftgEh2Puc4ocjASalnv4LvmcMf6_kU8yv9kYUi7d2Dd0t-zti-dga2YNeVHZcHc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afyael0OdDxLaqprmvuDekGro5FtFTL3dQWsTG1UcoWtNg&oe=69B2AA0D"}, "display_name": "Swivel", "keywords": [], "long_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, wonder, and excitement.\n\nIn this first-of-its-kind outer space experience, you swivel your way down a cosmic path straight to the dance floor. We recommend using a swivel chair to make those tricky turns a blast!\n\nWhile you\u2019re swiveling towards the dance floor, get ready for a hands-on party - drumming, popping bubbles, opening doors, high-fiving aliens, and collecting music notes.\n\nThe beats? Crafted by the legendary Barry Leitch, these tunes groove with the story and your every move. There's a variety of rides, each with its own style, and the first ride, 'Fly,' is on the house \u2013 your sneak peek into the game's vibe.\n\nSome rides are swivel-heavy, so be prepared for some serious spinning action. And guess what? There are also secret paths to up the fun factor!\n\nSwivel offers a one-of-a-kind immersive experience that our first players have described as part dance party, part thrill ride, and part workout. They felt all kinds of good after playing.\n\nCan you swivel your way to the dance floor while having the most fun possible?\n\nSwivel on and dance!\n\nJoin our Discord to share feedback, requests, and stay on top of what's new: https://discord.gg/HcAXnXXf", "short_description": "Swivel is a VR ride through outer space that's jam-packed with music, movement, wonder, and excitement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.swivelvr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Dimensional Dilemma", "support_website_url": null, "website_url": "http://www.swivelvr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null
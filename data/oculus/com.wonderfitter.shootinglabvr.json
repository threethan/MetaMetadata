ng", "id": "4186942224904867", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619751_4186942228238200_4148043424012411770_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O_ne2El7PngQ7kNvwET6rgM&_nc_oc=AdpCxu4qybv_3B-T4SLlzdyWadNL_1xYM3WG0fX0ugD-GvNlczgBt2TldlI6-NQPu7A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP44iMFVhAb-LbaenEvHRAkqpjt0UV2RkudsZmjyCrAyQ&oe=6AE60F97"}, "display_name": "Shooting Lab VR", "keywords": ["Shooting", "Training", "Firearms", "Glock"], "long_description": "Transform your shooting prowess with Shooting Lab VR \u2013 the ultimate app for realistic firearms training. Pair with your Wonderfitter device (M9, M416, or M17) via Bluetooth to your headset, and immerse yourself in professional-grade drills anytime, anywhere.\n\nKey Features\n[6 Critical Training Categories] \nDiverse scenarios replicate real-world challenges, from close-quarters reflexes to long-range accuracy. \n\n[Authentic Firearms Experience] \nSyncs seamlessly with Wonderfitter devices (M9, M416, M17) for tactile feedback, recoil simulation, and performance analytics. \n\n[Train On-Demand] \nNo range? No problem! Perfect for home, travel, or tactical preparation.", "short_description": "Unlock Elite Shooting Skills Anywhere Anytime"}]}, "developer_name": null, "developer_privacy_policy_url": "https://wonderfitter.com/pages/wonderfitter-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "WONDERFITTER", "support_website_url": null, "website_url": "http://www.wonderfitter.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, 
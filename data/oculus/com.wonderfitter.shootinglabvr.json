irearms", "Glock"], "long_description": "Transform your shooting prowess with Shooting Lab VR \u2013 the ultimate app for realistic firearms training. Pair with your Wonderfitter device (M9, M416, or M17) via Bluetooth to your headset, and immerse yourself in professional-grade drills anytime, anywhere.\n\nKey Features\n[6 Critical Training Categories] \nDiverse scenarios replicate real-world challenges, from close-quarters reflexes to long-range accuracy. \n\n[Authentic Firearms Experience] \nSyncs seamlessly with Wonderfitter devices (M9, M416, M17) for tactile feedback, recoil simulation, and performance analytics. \n\n[Train On-Demand] \nNo range? No problem! Perfect for home, travel, or tactical preparation.", "short_description": "Unlock Elite Shooting Skills Anywhere Anytime"}]}, "developer_name": null, "developer_privacy_policy_url": "https://wonderfitter.com/pages/wonderfitter-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "WONDERFITTER", "support_website_url": null, "website_url": "http://www.wonderfitter.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26751070681145733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618432_1447291696920147_8397577506730640345_n.png?stp=dst-png_s360x360&_nc_cat
bCb5Um-23rkImWjwQftuEalVvVj5pBQ&oe=6B0F106A"}, {"file_name": "05-red-eyes.png", "id": "26051033551393118", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823341_26051033554726451_6751670765645847691_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gpnM0UI5JQoQ7kNvwG0D41I&_nc_oc=AdoMKvcbtU2jvO_ueq42oBFRc58VZMQg8xOw6-XGrgwtyh5o3-IMedeJ1A8qcciFkPw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXiyqbB42FKWPKVidinu3mIly28rOlbqYcXnTa-3NFPDw&oe=6B0EF731"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "aftercorp-quest-cover-meta.png", "id": "1111331021874361", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823757_1111331025207694_2929875093185803854_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V5E18Ip5DD0Q7kNvwEgqm1V&_nc_oc=AdowJOxtVCQIOTivr6ZYQ1Pv6BJbyZYm7FwTkZhVEHrqwJLC-U36OfvGHF0I_nwHJIk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWcgyRsLXkkcJO_Yj1qlsux35_bUvqZpsZVGJiEi_qGnw&oe=6B0F00ED"}, "display_name": "AfterCorp - Routine Inspection", "keywords": ["horror", "survival", "MixedReality", "HandTracking", "passthrough"], "long_description": "A mixed-reality survival horror game that turns your home into a paranormal investigation. Surrounded by darkness, use your hands to light your way out.\n\nYour remote operator has a simple assignment: close the portals and follow procedure.\n\nYOUR HAND IS THE TORCH\nOpen your palm to reveal your real surroundings through passthrough. Search for paranormal portals, close them by hand, and watch for movement beyond the light. Keep your equipment charged. Stay on task.\n\nA FOUR-CHAPTER ASSIGNMENT\nFollow your operator through a story of corporate procedure and increasingly uncomfortable discoveries, from your first inspection to the final shift.\n\nMORE WAYS TO FACE THE DARK\nUnlock five Challenges or build your own run in Custom mode, choosing the enemies, difficulty and number of portals.\n\nBUILT AROUND YOUR HANDS AND YOUR ROOM\nPlay entirely with hand tracking. Calibrate your play area, then move through your physical space as the inspection unfolds.\n\nFor Quest 3 and Quest 3S. Hand tracking and spatial-data permission required. Single player. English audio and text. Requires a clear, well-lit play area; the darkness is created in-game. Contains horror imagery and jump scares.", "short_description": "A mixed-reality survival horror game that turns your home into a paranormal investigation. Surrounded by darkness, use your hands to light your way out."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sxp.studio/aftercorp/privacy", "developer_terms_of_service_url": null, "publisher_name": "SXP Studio", "support_website_url": null, "website_url": "https://sxp.studio/aftercorp", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1450899258111261"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821796_943509315279853_270651954832916568_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y9thUWGEzs0Q7kNvwElAO0D&_nc_oc=AdpvwzmIVsIvUYOOSwmSL8zXG7KHnUckMvDGR9ciJl4n10lSLWnmhgCxs9pHTX8SK8U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVCdQqMd9zVbD4d-5h-1Zep71V1MrsWDvNyL0NHzJyu1w&oe=6B0F05A1"}, "is_concept": false, "
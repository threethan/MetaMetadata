-VbBszTrMbKwEKtrnCMv3uvnu5g&oe=6B103CAC"}, {"file_name": "03-room-transition.png", "id": "1818694232664036", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823812_1818694239330702_6118630779094912662_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZR7wa1OWTHMQ7kNvwFUacOu&_nc_oc=AdohL6IySOSP6jSwVDi_E1mmYUn5zFGGqnjUa3Ns2eG1fa5mfa153Q39aASZj38uk2c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVfd656Rr-wx_I9WQc3FSL7oep8P5TJymVb27KEHGkBZw&oe=6B103A44"}, {"file_name": "04-red-eyes.png", "id": "1453750883373359", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823757_1453750886706692_2534215235043275647_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v7RAWu4EZYEQ7kNvwGDO5cs&_nc_oc=Adr6TA7InnmVSsxXYRjIFR1YJkdyuwWCxEbJ1lCR09TguRuOznUxMWf9W9aNGyRBh2I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVeMmVpd675lLlKswymWkl2sHTZeO-LtrmudruFv15rMA&oe=6B104324"}, {"file_name": "05-challenge-selection.png", "id": "956730187156762", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823296_956730193823428_574196744439005533_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MG1xPvpuWhcQ7kNvwEXV9yO&_nc_oc=Ado7UEg_XHGdtWh0TvHcO_QpfjorMxbZrSrjPa47y0brW3eOn_LfGt4KJyN4PNPcUAw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVJPodGsT11TFA-OcRnp378uxLKRGAWpQJSZOskRwp_4g&oe=6B10662E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "aftercorp-quest-cover-meta.png", "id": "1111331021874361", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823757_1111331025207694_2929875093185803854_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V5E18Ip5DD0Q7kNvwFyLdj8&_nc_oc=AdqAXRqgNMVN-ZzwHZgykmaTe3L4-k7pzy1cqtp1JWmr44dBxhLz0yo5BbRt98XB_2A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWFzhKiE9dSzHWt0lb6NautuSTUhxjQT2cpPhH2vnzI4w&oe=6B10526D"}, "display_name": "AfterCorp - Routine Inspection", "keywords": ["horror", "survival", "MixedReality", "HandTracking", "passthrough"], "long_description": "A mixed-reality survival horror game that turns your home into a paranormal investigation. Surrounded by darkness, use your hands to light your way out.\n\nYour remote operator has a simple assignment: close the portals and follow procedure.\n\nYOUR HAND IS THE TORCH\nOpen your palm to reveal your real surroundings through passthrough. Search for paranormal portals, close them by hand, and watch for movement beyond the light. Keep your equipment charged. Stay on task.\n\nA FOUR-CHAPTER ASSIGNMENT\nFollow your operator through a story of corporate procedure and increasingly uncomfortable discoveries, from your first inspection to the final shift.\n\nMORE WAYS TO FACE THE DARK\nUnlock five Challenges or build your own run in Custom mode, choosing the enemies, difficulty and number of portals.\n\nBUILT AROUND YOUR HANDS AND YOUR ROOM\nPlay entirely with hand tracking. Calibrate your play area, then move through your physical space as the inspection unfolds.\n\nFor Quest 3 and Quest 3S. Hand tracking and spatial-data permission required. Single player. English audio and text. Requires a clear, well-lit play area; the darkness is created in-game. Contains horror imagery and jump scares.", "short_description": "A mixed-reality survival horror game that turns your home into a paranormal investigation. Surrounded by darkness, use your hands to light your way out."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sxp.studio/privacy", "developer_terms_of_service_url": null, "publisher_name": "SXP Studio", "support_website_url": null, "website_url": "https://sxp.studio/aftercorp", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}], "external_subscription_type": "NO
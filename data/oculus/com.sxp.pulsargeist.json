e7a0a&_nc_ohc=V5E18Ip5DD0Q7kNvwEviJGc&_nc_oc=Adrhw4B_--3n9SukbYjD2-jSx2mx_uhX1jIrJpkCSM-HT-5_zTFw0UfPZhFk9MzX6Ko&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSEi2mgtU0FSmxyxfpsWamoeUfHQUmuGuGPeCvs-XSMoQ&oe=6B0DAF6D"}, "display_name": "AfterCorp - Routine Inspection", "keywords": ["horror", "survival", "MixedReality", "HandTracking", "passthrough"], "long_description": "A mixed-reality survival horror game that turns your home into a paranormal investigation. Surrounded by darkness, use your hands to light your way out.\n\nYour remote operator has a simple assignment: close the portals and follow procedure.\n\nYOUR HAND IS THE TORCH\nOpen your palm to reveal your real surroundings through passthrough. Search for paranormal portals, close them by hand, and watch for movement beyond the light. Keep your equipment charged. Stay on task.\n\nA FOUR-CHAPTER ASSIGNMENT\nFollow your operator through a story of corporate procedure and increasingly uncomfortable discoveries, from your first inspection to the final shift.\n\nMORE WAYS TO FACE THE DARK\nUnlock five Challenges or build your own run in Custom mode, choosing the enemies, difficulty and number of portals.\n\nBUILT AROUND YOUR HANDS AND YOUR ROOM\nPlay entirely with hand tracking. Calibrate your play area, then move through your physical space as the inspection unfolds.\n\nFor Quest 3 and Quest 3S. Hand tracking and spatial-data permission required. Single player. English audio and text. Requires a clear, well-lit play area; the darkness is created in-game. Contains horror imagery and jump scares.", "short_description": "A mixed-reality survival horror game that turns your home into a paranormal investigation. Surrounded by darkness, use your hands to light your way out."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sxp.studio/privacy", "developer_terms_of_service_url": null, "publisher_name": "SXP Studio", "support_website_url": null, "website_url": "https://sxp.studio/aftercorp", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1417269191474268"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1144869154920286"}, {"status": "PUBLISHED", "id": "1494005055905640"}]}, "baseline_offer": {"id": "1494005055905640"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "1144869154920286"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1458908623976991", "version": "2.2.3"}, "id": "1800363974531289", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1417269174807603", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1458908623976991"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1795634326, "id": "1473241335877053", "version": "2.2.4-iap-qa", "version_code": 20, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1417269174807603", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1458908623976991"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1800363974531289"}]}, "change_log": "AfterCorp - Routine Inspection (2.2.3)\n\n- Seven Meta achievements are now available, with automatic syncing of achievements earned in your saved progress.\n- Offline completions stay saved locally and sync when you reconnect.", "created_date": 1795010152, "id": "1458908623976991", "version": "2.2.3", "version_code": 19, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1417269174807603", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1458908623976991"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1800363974531289"}]}, "change_log": "AfterCorp - Routine Inspection (2.2.2)\n\n- Shine your torch on the opening instruction to begin Chapter 4, Challenges and Custom games.\n- Your room stays visible while an anti-aliasing change takes effect. The Custom title and setup now use white lettering.\n- Skulls react to your torch from farther away. The final portal in Chapter 4 opens silently.", "created_date": 1794935057, "id": "1457158104152043", "version": "2.2.2", "version_code": 18, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1417269174807603", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1458908623976991"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1800363974531289"}]}, "change_log": "AfterCorp - Routine Inspection (2.1.0)\n\n- Dust drifts through the torchlight, and the beam stands out more clearly in the fog. The torch also follows your raised palm more reliably.\n- Walkers and crawlers have new animations and distinct sounds, from heavy footsteps to fingertips tapping across the floor. A detached hand joins the hunt. Cut a flash short and a crawler can retreat, then charge back.\n- Chapter 4 has a new score that follows the action. Your portal count and time appear after the credits. More enemies join the hunt near the end of each Challenge.\n- With optional headset-camera access, portals distort the view of your room. You can now adjust anti-aliasing during play.", "created_date": 1794678484, "id": "1450906091443911", "version": "2.1.0", "version_code": 15, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1417269174807603", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1458908623976991"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1800363974531289"}]}, "change_log": "AfterCorp - Routine Inspection \u2014 2.0.0\n\nYour first assignment begins. Explore a four-chapter mixed-reality horror story, unlock five Challenges, and create your own runs in Custom mode.\n\nOpen your palm to light your real surroundings, find paranormal portals, and close them by hand. Play entirely with hand tracking on Meta Quest 3 and Quest 3S.\n\nIncludes FULL, INTENSE and DIM darkness settings, subtitles, and adjustable scare sound. A clear, well-lit physical play area and spatial-data permission are required.", "created_date": 1793739172, "id": "1426583997209454", "version": "2.0.0", "version_code": 14, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
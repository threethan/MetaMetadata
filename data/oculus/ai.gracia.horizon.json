y & Environmental Depth Support: Merge the scene into your environment for better immersion\n- Hands Tracking: Rotate the scene, pause and rewind without controllers\n- Ready-To-Go SDK: For self-distribution and streaming", "short_description": "Gracia is pioneering spatial computing with the first-ever Gaussian Splatting-based volumetric videos in VR"}]}, "developer_name": "Gracia", "developer_privacy_policy_url": "https://graciavr.notion.site/Privacy-Policy-ffd5b4acd3fd4ff2bccf5bf120192c29", "developer_terms_of_service_url": null, "publisher_name": "Gracia", "support_website_url": null, "website_url": "https://www.gracia.ai/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "30028197166824306"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499304764_1223315925544605_2163738074664570174_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bjxPLBhARiQQ7kNvwF-lvtT&_nc_oc=Adr5gP_0OcQsXhGgpTwWHnBPBvL68F9R5sYhnS9os7zHj4ni6vF8c31UbeOyPjO2Dm4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68qeNnfwaG5G3E2dlS8LjW3g8bh5--54c73CTYakUw7Q&oe=6A0B0A09"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Gracia", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873
png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PScvxuMj3hoQ7kNvwEvePmh&_nc_oc=Adkt04k8UZ9wAUjGz-HyOADOcENPO9f01RlqAfbE8TWLt50UsurpFS4emQyGCvHuwvM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfzVss2O_GMZAXANFiJEO6V31oZuCJdhpRNefthUMmYMpg&oe=69AADD8B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "24.png", "id": "479792944623870", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39031358_479792947957203_7701327199303146140_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J60f1F4vS24Q7kNvwFIWf3z&_nc_oc=Adk1OrHSsVIXvpZdiiPAhY0g2iCeGOXs53P86Svph-lj8cf3PK6XeI28QKEMQJfOvrw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfxIRjoTH9nGtChov1oSbnvcmdMMNJ4Vcjhngf2PzCBNIQ&oe=69AAE72C"}, "display_name": "Gracia", "keywords": [], "long_description": "Gracia is a platform that redefines virtual reality, offering free-viewpoint ultra-photorealistic VR experiences. It's not just about seeing; it's about stepping inside a photo with freedom to walk around, where every detail is so vivid, you'll forget it's virtual.\n\nKey features:\n\n- Unmatched Photorealism: Gracia\u2019s advanced rendering technology blurs the line between virtual and reality and creates a feeling as if you are inside high-resolution photograph. \n- 6DOF Volumetric Scenes: Move and interact within our scenes with complete freedom as if you were really there.\n- Extremely High Fidelity: Up to 550 fps at native resolution.\n- Ever Expanding Store of Scenes: Regular updates keep the content fresh and exciting.", "short_description": "Gracia is a world's first platform with free-viewpoint ultra-photorealistic VR experiences. It's not just about seeing; it's about stepping inside a photo with freedom to walk around, where every detail is so vivid, you'll forget it's virtual."}]}, "developer_name": "Gracia", "developer_privacy_policy_url": "https://graciavr.notion.site/Privacy-Policy-ffd5b4acd3fd4ff2bccf5bf120192c29", "developer_terms_of_service_url": null, "
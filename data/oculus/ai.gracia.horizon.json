xxQ&oe=6B04866C"}, "display_name": "Gracia", "keywords": ["gracia", "6dof", "videos", "immersive"], "long_description": "Gracia is a platform that redefines virtual reality, offering free-viewpoint ultra-photorealistic videos in VR.\n\nKey features:\n\n- Feeling of Presence: Walk around the video and watch from any angle\n- Mixed Reality & Environmental Depth Support: Merge the scene into your environment for better immersion\n- Hands Tracking: Rotate the scene, pause and rewind without controllers\n- Ready-To-Go SDK: For self-distribution and streaming", "short_description": "Gracia is pioneering spatial computing with the first-ever Gaussian Splatting-based volumetric videos in VR"}]}, "developer_name": "Gracia", "developer_privacy_policy_url": "https://graciavr.notion.site/Privacy-Policy-ffd5b4acd3fd4ff2bccf5bf120192c29", "developer_terms_of_service_url": null, "publisher_name": "Gracia", "support_website_url": null, "website_url": "https://www.gracia.ai/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "30028197166824306"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499304764_1223315925544605_2163738074664570174_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A8dzY9THm50Q7kNvwFCLJI7&_nc_oc=AdqUy2Qg5jWnN4oNlPZHh9qRnN
tps://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974713_225532466807699_6065392245843363570_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qss9Tfwuh1MQ7kNvwFQeXwh&_nc_oc=Adp2SUHxherfOGycukMXgi7b-pNfxLpqk7tWUQfk18iCGnTScnNgTqeaS2eO3X7QjWQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGKB_TvHv2vDxeAxMHtCZ5VsOFTdWe3oVswC2fUgY59Pg&oe=6A78631F"}, {"file_name": "07.png", "id": "1088768709238400", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75593946_1088768712571733_972184139648437816_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OGeyKZGbQDEQ7kNvwHG7zUj&_nc_oc=AdqS5KJhD-FVQvF0sD9I9nPY4WNWHjaFqsTbe5NEc7OoXbLmIwewu9bU0KvfvtXBA5o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGzDCvI7hmt3Db-FRuQzWXFYzX3FLwzxRvAdRTVeLrQHw&oe=6A7892E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "465800033225103", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974841_465800036558436_7943392708707471915_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BgWlcDtnF68Q7kNvwF2jue-&_nc_oc=AdrgfT8o2je0TqXcc7W1yA-iURerg2SZrvRCFrr-PYxG2VcLs5PCZ3XOdOhZw97ug0w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHfOo0ssn287Xe_yxODxQNU7TctgtRbTSa8CeblBv3rAQ&oe=6A788357"}, "display_name": "Hitstream", "keywords": ["fitness", "movement", "rhythm", "music", "wellbeing"], "long_description": "Fitness made fun!\n\nThe challenge surrounds you in this 360\u2019 game that takes you on a cardio-boosting trip around the world. So good you won\u2019t even realise you\u2019re exercising!\n\n\ud83c\udfae Over 12 hours of gameplay\n\n\ud83e\udd4a Punch, stretch, squat & dodge moves\n\n\ud83d\udd25 Lite, standard & intense modes\n\n\ud83c\udfdd\ufe0f Stunning scenery \n\n\ud83d\udcaa Full-body movement\n\n\ud83c\udfb5 Awesome tunes\n\n\ud83d\udd7a Intuitive choreography\n\n\ud83d\udc6bMultiplayer\n\n\ud83e\ude9fMixed reality\n\nDesigned with positive energy and physical/mental wellbeing in mind, this immersive game will take you on a range of journeys, from uplifting adventures that work on agility to power-focused routines that build strength and stamina. \n\nThe perfect non-subscription addition to your VR fitness library. \n\nHitstream: where will you exercise today?", "short_description": "Fitness made fun! \nThe challenge surrounds you in this 360\u2019 game that takes you on a cardio-boosting trip around the world. So good you won\u2019t even realise you\u2019re exercising!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hitstream.games/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "And 7 Limited", "support_website_url": "https://hitstream.games/support", "website_url": "https://hitstream.games/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "25853132374295255"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984444_931767488896253_2250571641091412824_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b-hKLBDGtyUQ7kNvwGjbK_S&_nc_oc=Adq4xnKaMQOBZPgWtwHqtJ5vupU3BfKfraqF00378oadSEwN4HVh-A_Le2JJDK-XfeM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDCMBzsNz4AVhha-3ctBs_T4F9fXhwDDo7_VdstHwqUw&oe=6A788F1E"}, "is_concept": false, "is_test"
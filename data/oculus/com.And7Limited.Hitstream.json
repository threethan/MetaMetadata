ri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38974713_225532466807699_6065392245843363570_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sV6YaG0j5coQ7kNvwGOTtGq&_nc_oc=AdoC7BO9j8rQbNv1zDplCXukcp8uXiPPvxeJsLQ2R_mXW4M7r4aT-4fC1BKD7-gCyv0&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_aX3o_hPs9gb5Di1Za3PXd6pgtjvLf9zuecgycXcnxtw&oe=6A36B05F"}, {"file_name": "07.png", "id": "1088768709238400", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/75593946_1088768712571733_972184139648437816_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3NSC4PQVqhsQ7kNvwHBeFtv&_nc_oc=AdoxMl0l2NMoNqAeFCOT3LodF9ov6St3cw4cT6mt-16VjFDRSrKtaC3vQ8UfH_4m8Ss&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9g4sPMe-cwdGr0rJ5BQw8EIcWXgWtpPo4xPhgM66vlBg&oe=6A36A7E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "465800033225103", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38974841_465800036558436_7943392708707471915_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v-0-Ip1HYWkQ7kNvwH8Q45A&_nc_oc=AdrqXVzvaWo4Kie78aeWfE5BQm8HYe_6p7apVC31myV-PsZS5s_vu4ROVi0tH8_iD84&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9zjh7aS2XfT4sI1VeMCvkJOZAOn9NaQmTm1HzipV9bLg&oe=6A369857"}, "display_name": "Hitstream", "keywords": ["fitness", "movement", "rhythm", "music", "wellbeing"], "long_description": "Fitness made fun!\n\nThe challenge surrounds you in this 360\u2019 game that takes you on a cardio-boosting trip around the world. So good you won\u2019t even realise you\u2019re exercising!\n\n\ud83c\udfae Over 12 hours of gameplay\n\n\ud83e\udd4a Punch, stretch, squat & dodge moves\n\n\ud83d\udd25 Lite, standard & intense modes\n\n\ud83c\udfdd\ufe0f Stunning scenery \n\n\ud83d\udcaa Full-body movement\n\n\ud83c\udfb5 Awesome tunes\n\n\ud83d\udd7a Intuitive choreography\n\n\ud83d\udc6bMultiplayer\n\n\ud83e\ude9fMixed reality\n\nDesigned with positive energy and physical/mental wellbeing in mind, this immersive game will take you on a range of journeys, from uplifting adventures that work on agility to power-focused routines that build strength and stamina. \n\nThe perfect non-subscription addition to your VR fitness library. \n\nHitstream: where will you exercise today?", "short_description": "Fitness made fun! \nThe challenge surrounds you in this 360\u2019 game that takes you on a cardio-boosting trip around the world. So good you won\u2019t even realise you\u2019re exercising!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hitstream.games/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "And 7 Limited", "support_website_url": "https://hitstream.games/support", "website_url": "https://hitstream.games/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "25853132374295255"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38984444_931767488896253_2250571641091412824_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SZP3tlDMxcoQ7kNvwEt9PW2&_nc_oc=Adps2DsXyj0upOabjFhawy-e3ppGeIYUIo93XgJxBbWS2pg8d60xHaEDrI-GpjutqcE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85uleOeaX5X-gSzaNfR1go3WAb6EPYgYu_ocZ3cJeRqw&oe=6A36A41E"}, "is_concept": false, "
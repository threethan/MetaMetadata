tps://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974713_225532466807699_6065392245843363570_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qZ3x6BG2tCwQ7kNvwGr888a&_nc_oc=AdrHbQiZw8Jgl9vYMp7e26BzxRE9r3nD0BScEltb8j624j0ZizQfyNw0dxESZce655s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKwV6UlLP1bXmYas05BisEBwiLbhcKjJNOENswUW4t_9w&oe=6AB29D5F"}, {"file_name": "07.png", "id": "1088768709238400", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75593946_1088768712571733_972184139648437816_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=21MzYQavGD8Q7kNvwG4-MmH&_nc_oc=AdplwGJVNQvrgdAbSjISL91BQzMqfKVnmY-oORsjZlggtn5sBqdD3dZVir30qsLpJk0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKV4iMd7u3rSeKDMhj2LLg_JL76iv4XIHuQ-PLqJbjsbw&oe=6AB294E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "465800033225103", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974841_465800036558436_7943392708707471915_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zIqoEatPSswQ7kNvwH_Hc1Z&_nc_oc=Ado-swMQCTzKfoqysCSYF6IivLlQ9t8j-rKI4q4kaj2DN79mElAbrWmqbzvqwFUy49Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKg0TNLKSeMrSHVy3Z-qiWoSFtcC8NT8d6Z_2SBTG2gxA&oe=6AB28557"}, "display_name": "Hitstream", "keywords": ["fitness", "movement", "rhythm", "music", "wellbeing"], "long_description": "Fitness made fun!\n\nThe challenge surrounds you in this 360\u2019 game that takes you on a cardio-boosting trip around the world. So good you won\u2019t even realise you\u2019re exercising!\n\n\ud83c\udfae Over 12 hours of gameplay\n\n\ud83e\udd4a Punch, stretch, squat & dodge moves\n\n\ud83d\udd25 Lite, standard & intense modes\n\n\ud83c\udfdd\ufe0f Stunning scenery \n\n\ud83d\udcaa Full-body movement\n\n\ud83c\udfb5 Awesome tunes\n\n\ud83d\udd7a Intuitive choreography\n\n\ud83d\udc6bMultiplayer\n\n\ud83e\ude9fMixed reality\n\nDesigned with positive energy and physical/mental wellbeing in mind, this immersive game will take you on a range of journeys, from uplifting adventures that work on agility to power-focused routines that build strength and stamina. \n\nThe perfect non-subscription addition to your VR fitness library. \n\nHitstream: where will you exercise today?", "short_description": "Fitness made fun! \nThe challenge surrounds you in this 360\u2019 game that takes you on a cardio-boosting trip around the world. So good you won\u2019t even realise you\u2019re exercising!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hitstream.games/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "And 7 Limited", "support_website_url": "https://hitstream.games/support", "website_url": "https://hitstream.games/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "25853132374295255"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984444_931767488896253_2250571641091412824_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2a1dxH0EVUsQ7kNvwHa7wTm&_nc_oc=AdrRd0juShW_MJbwHvXToT_LGic5p__eQFFRQy9O1blWJ6Fx2S9iHGKCJi43DH61yeY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJCI_GRydijVE2iwv5SX9UhQaV93JghUP1eBhr9CPwKJg&oe=6AB2911E"}, "is_concept": false, "is_test"
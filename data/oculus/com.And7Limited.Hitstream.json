tps://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974713_225532466807699_6065392245843363570_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8LKXtZoqoBcQ7kNvwE34NSc&_nc_oc=AdokBHZ5CoOk6tk58p22Oa8_N8g2uCu3xcB6DDzFaBYePsu6JOU6vEHxA5Y4L_C2rOE&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40cNBFnLWsf1im90ZblJLhQow496tUWYTnq5xNNewn5Q&oe=6A1C525F"}, {"file_name": "07.png", "id": "1088768709238400", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/75593946_1088768712571733_972184139648437816_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ubzp7vlRJQoQ7kNvwHWBl-V&_nc_oc=Adr0MBASPTjJZaKTEPRNMGqWYRogWpnFlnm6uzvoOFSviAixhpJruXfJKS3Hd0T6cNU&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4zX1KkQk5Z1_llEKUlzUEp4LaMvCsE7X6zOfMNW1InVA&oe=6A1C49E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "465800033225103", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974841_465800036558436_7943392708707471915_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v-yG_ghoOgEQ7kNvwF53a-Z&_nc_oc=AdolcH2ftFFN3cZNQzfwAL8zcG5ZEniy5uCWa7HuB8DiyiljUqRivDFZ88HkdHcxmYE&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7hPCHlxG6QDVlLE2_bJSvwEmN_b58euDoW1t-IDhgO2Q&oe=6A1C3A57"}, "display_name": "Hitstream", "keywords": ["fitness", "movement", "rhythm", "music", "wellbeing"], "long_description": "Fitness made fun!\n\nThe challenge surrounds you in this 360\u2019 game that takes you on a cardio-boosting trip around the world. So good you won\u2019t even realise you\u2019re exercising!\n\n\ud83c\udfae Over 12 hours of gameplay\n\n\ud83e\udd4a Punch, stretch, squat & dodge moves\n\n\ud83d\udd25 Lite, standard & intense modes\n\n\ud83c\udfdd\ufe0f Stunning scenery \n\n\ud83d\udcaa Full-body movement\n\n\ud83c\udfb5 Awesome tunes\n\n\ud83d\udd7a Intuitive choreography\n\n\ud83d\udc6bMultiplayer\n\n\ud83e\ude9fMixed reality\n\nDesigned with positive energy and physical/mental wellbeing in mind, this immersive game will take you on a range of journeys, from uplifting adventures that work on agility to power-focused routines that build strength and stamina. \n\nThe perfect non-subscription addition to your VR fitness library. \n\nHitstream: where will you exercise today?", "short_description": "Fitness made fun! \nThe challenge surrounds you in this 360\u2019 game that takes you on a cardio-boosting trip around the world. So good you won\u2019t even realise you\u2019re exercising!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hitstream.games/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "And 7 Limited", "support_website_url": "https://hitstream.games/support", "website_url": "https://hitstream.games/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "25853132374295255"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38984444_931767488896253_2250571641091412824_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d0NCPDOX6-YQ7kNvwFsqPww&_nc_oc=Ado-N0KZdVDb6C-fTHP6iUdxr5KmFdFXS9IPCkAAG555eUoFOeyagnbiqMk5tNNLpsM&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6HNlQa27qNidri3jDgKa5Whm0TI5aqauIZKXjnmc_KWw&oe=6A1C461E"}, "is_concept": false, "is_test"
2142280_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aUi7TY-pRZ0Q7kNvwFk9zoE&_nc_oc=Adl5S8S6MaxV-yKRdnSZqd22gjzlHqp2eOhm29YZvK1k3Wfu6QDVFaHWInoWTzJA4EA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsSw9Jf-abVlxpIUsHZhj_OLPSjGELE_kRBnSsdkrRGRQ&oe=699C5A04"}, {"file_name": "Screenshot-Mars.png", "id": "225532463474366", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974713_225532466807699_6065392245843363570_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DkqawRR4Zs4Q7kNvwF3Vovs&_nc_oc=AdmfC_ZMh9_2wnSOyQF-RglKiJOr3WwcXGVfG7XqI9J37fKcavPVIqt5eTkMfQywKDY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftFyfHy9Bq54gZaZTf_qbQGUU3RbjBy9v-OnfjtFDWlyg&oe=699C389F"}, {"file_name": "07.png", "id": "1088768709238400", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75593946_1088768712571733_972184139648437816_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ob2iM6jkfgQ7kNvwFaT2YO&_nc_oc=AdmE6GBKTmUX9MYV1CzVADeQrWzikdeywsCt_XfKd-3U-W-GfQ469cKd66EktNJYimQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvDkdV2Qqiv-II2bGOXyxTA7dDw_1-CT8CtZqGO_pE5Lg&oe=699C3028"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "465800033225103", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974841_465800036558436_7943392708707471915_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QyAgFKNZORYQ7kNvwG20BzZ&_nc_oc=AdnYzth3zd6H7G8fNjjq7WB3vof5m2bzAEiOjG7nO9tSUNTjzthPDNHkphNdBrjw6Mo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftVskvOfiNsGBwwErZRsIUCv5eUkuF9Jd59BPbDzicp5Q&oe=699C58D7"}, "display_name": "Hitstream", "keywords": ["fitness", "movement", "rhythm", "music", "wellbeing"], "long_description": "Fitness made fun!\n\nThe challenge surrounds you in this 360\u2019 game that takes you on a cardio-boosting trip around the world. So good you won\u2019t even realise you\u2019re exercising!\n\n\ud83c\udfae Over 12 hours of gameplay\n\n\ud83e\udd4a Punch, stretch, squat & dodge moves\n\n\ud83d\udd25 Lite, standard & intense modes\n\n\ud83c\udfdd\ufe0f Stunning scenery \n\n\ud83d\udcaa Full-body movement\n\n\ud83c\udfb5 Awesome tunes\n\n\ud83d\udd7a Intuitive choreography\n\n\ud83d\udc6bMultiplayer\n\n\ud83e\ude9fMixed reality\n\nDesigned with positive energy and physical/mental wellbeing in mind, this immersive game will take you on a range of journeys, from uplifting adventures that work on agility to power-focused routines that build strength and stamina. \n\nThe perfect non-subscription addition to your VR fitness library. \n\nHitstream: where will you exercise today?", "short_description": "Fitness made fun! \nThe challenge surrounds you in this 360\u2019 game that takes you on a cardio-boosting trip around the world. So good you won\u2019t even realise you\u2019re exercising!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hitstream.games/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "And 7 Limited", "support_website_url": "https://hitstream.games/support", "website_url": "https://hitstream.games/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "8800095603358865"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984444_931767488896253_2250571641091412824_n.png?stp=dst-p
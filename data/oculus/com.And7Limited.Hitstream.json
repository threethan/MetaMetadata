1-7&_nc_sid=6e7a0a&_nc_ohc=Z7U0BK-ptfYQ7kNvwF4Hqy7&_nc_oc=AdmJnH337iLsYOc-jlNRpTwp3EkbyWqkJDSTB5rtOYBhXKZiIaswI-J7OozGV9vqBcg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsVhsr39Our2HNE-Q9ANlPVmXae8IvOjomT1HIQBqGDqg&oe=69A4219F"}, {"file_name": "07.png", "id": "1088768709238400", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75593946_1088768712571733_972184139648437816_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xRZy9zJkB3oQ7kNvwHyGW_S&_nc_oc=AdmKKr2qmlyCptsJReu6BbPkxigRgbJtbQaY6DLy8DdYpnBwnD-Cm4sW2a2BY7MVcI4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afsqn9rtC7EDRLVvtd-mSCNWWd3zT4n_qwzkPVCIuYJjwg&oe=69A41928"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "465800033225103", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974841_465800036558436_7943392708707471915_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iS_br1wI2eEQ7kNvwFG-1IW&_nc_oc=AdnYnBawF4ZneXM_AO3ZnWmpe_jAb0r_uucP62c_IpDIpUaB1s6sZwK6QkP8Xf07grA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afti9f5nqcXR1xI-LCy2EPQTwdJNnRWBOOe0RKXy5viIng&oe=69A441D7"}, "display_name": "Hitstream", "keywords": ["fitness", "movement", "rhythm", "music", "wellbeing"], "long_description": "Fitness made fun!\n\nThe challenge surrounds you in this 360\u2019 game that takes you on a cardio-boosting trip around the world. So good you won\u2019t even realise you\u2019re exercising!\n\n\ud83c\udfae Over 12 hours of gameplay\n\n\ud83e\udd4a Punch, stretch, squat & dodge moves\n\n\ud83d\udd25 Lite, standard & intense modes\n\n\ud83c\udfdd\ufe0f Stunning scenery \n\n\ud83d\udcaa Full-body movement\n\n\ud83c\udfb5 Awesome tunes\n\n\ud83d\udd7a Intuitive choreography\n\n\ud83d\udc6bMultiplayer\n\n\ud83e\ude9fMixed reality\n\nDesigned with positive energy and physical/mental wellbeing in mind, this immersive game will take you on a range of journeys, from uplifting adventures that work on agility to power-focused routines that build strength and stamina. \n\nThe perfect non-subscription addition to your VR fitness library. \n\nHitstream: where will you exercise today?", "short_description": "Fitness made fun! \nThe challenge surrounds you in this 360\u2019 game that takes you on a cardio-boosting trip around the world. So good you won\u2019t even realise you\u2019re exercising!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hitstream.games/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "And 7 Limited", "support_website_url": "https://hitstream.games/support", "website_url": "https://hitstream.games/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "25853132374295255"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984444_931767488896253_2250571641091412824_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sD7Kc8bzFMgQ7kNvwGumzz5&_nc_oc=AdmtV0KcNVewalEqahuJI7qRiOIri7F_XGgcpuLpv6z9u7mOYCFwDB7ANFJMpLRVaBU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsQG4h18JDUG3XhaRW642H1qcRYNXjRfReXZDj4j-cF4g&oe=69A44D9E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Hitstream", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"
stacles, enemies, and most importantly to find important Items that will help you move to the next level. ", "short_description": "Embark in an amazing adventure to discover unparalleled treasure and truth unknown to your native land. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://1neglakay.com/pilgrimage", "developer_terms_of_service_url": null, "publisher_name": "Leszczynski Joseph", "support_website_url": null, "website_url": "https://1neglakay.com/pilgrimage", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "729110764741305"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974459_475545650832029_2761954982852191749_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EuuA4NqqwHUQ7kNvwHKb7xj&_nc_oc=AdrqyhI1W-95eW10aAdMCnDhida-G6hmosvVY9TJ4ACj1mD65Ad_KxAlTtuba5qRLCA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_YSq2VkQ5rMikDJ5jnktNgL7tzQwNUfZVfAaHZTXg0w&oe=6A071C7E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Pilgrimage", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}], "release_date": 1649895300, "lastRevision": {"nodes": [{"id": "309256834557689", "release_type"
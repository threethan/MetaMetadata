stacles, enemies, and most importantly to find important Items that will help you move to the next level. ", "short_description": "Embark in an amazing adventure to discover unparalleled treasure and truth unknown to your native land. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://1neglakay.com/pilgrimage", "developer_terms_of_service_url": null, "publisher_name": "Leszczynski Joseph", "support_website_url": null, "website_url": "https://1neglakay.com/pilgrimage", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "729110764741305"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974459_475545650832029_2761954982852191749_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q88IzpUofIYQ7kNvwG66DNf&_nc_oc=AdrhkUn97Alj8sDb_LgPxwh1VmecCGOuDpBqp6uUDj0E-YmXyBVaaKDf48e9MGn8hX0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8im4OAc83ZRqdxXNl2h5r7bpjohldAXSpvAozEW3HSMw&oe=6A2C067E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Pilgrimage", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}], "release_date": 1649895300, "lastRevision": {"nodes": [{"id": "309256834557689", "release_type"
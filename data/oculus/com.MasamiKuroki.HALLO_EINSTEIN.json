fwGd9-28ene8Ka6q1x3joTwHecTDEwU6fvQWo&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1DnfN-bW_C0cqfKDVTOLFWx0vddQlugbMy6s1vbuOtZg&oe=69E23570"}, {"file_name": "SS_03.png", "id": "4588090747885918", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974767_4588090751219251_226456740009901359_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sq0DVXt_rxUQ7kNvwH_mlh6&_nc_oc=AdpEOCUfFLlVEsr6X90WI2GiuZ6tnnviCu-RU7sD834J9Swz4otBKHhBuj1VDzOV9B0&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2P-hO-Kt9wOctJzbnZW5x_SFPVrAmHJAX0RGk0fhWxSA&oe=69E2338C"}, {"file_name": "SS_04.png", "id": "322449729354317", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974669_322449732687650_822808135241468056_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Yn6bAHQ4OcQ7kNvwEft9SE&_nc_oc=AdpPC8bcUdr1vnSG7CzfEVbNI72paes43nRb7LSzqud_1Z-KkobQCEd1BvGavGDYpAs&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1t87wGOrF4Buv_pPFV6JwxSVXOJBKFqxplapNc5liwPw&oe=69E24569"}, {"file_name": "SS_05.png", "id": "836048230450518", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974642_836048233783851_8940182980349785861_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eg6Wqj_jDP8Q7kNvwGtIfui&_nc_oc=AdoYZzLWH-V_4HR0V-g72i2HThVt8wdNDFWXbrKN46K53aHR1PUgo_A-bQKuB2_5nt8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2nvsGI9uJxFYJUHJb_OJkyT6HHWbSRAI4T_O2vkQVYPA&oe=69E2258E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HALLO EINSTEIN", "keywords": [], "long_description": "According to the theory of relativity, discovered by Einstein about 100 years ago, space-time distorts around moving or heavy objects.\nThis content will feature time and how much time will be distorted if you move very fast. Based on the actual theory, you can experience the time difference.\nThe content is roughly divided into two, and you can experience all the content by proceeding in order along the navigation.\nZONE1 The world of light clocks:\nYou can learn the mechanism of time delay in the explanation part and the experience part.\nZONE2 Space Travel:\nYou can go on a space trip at super high speed and experience how much time is actually delayed.\nTheories of science that we don't usually think about.\n-Isn't everyone really wanting to know...?\nA world that you may not have tried to know because it seems difficult,\nCommunicate in an easy-to-understand, correct, and attractive way!\nGet a glimpse of the world of relativity theory through experiences that can only be done with VR.", "short_description": "What is \"Theory of Relativity\"?\nAccording to this theory, discovered by Einstein about 100 years ago, space-time distorts around moving or heavy objects.\nThis content will feature time and how much time will be distorted if you move very fast. Based on the actual theory, you can experience the time difference.\nI'm sure everyone has had a genuine question about their own existence and the universe.\nTo the entrance to know the structure of this world ... 4th dimension plunge experience in VR! !"}]}, "developer_name": "KUMA Lab", "developer_privacy_policy_url": "http://cherry8823.weebly.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Masami Kuroki", "support_website_url": null, "website_url": "http://cherry8823.weebly.com/hallo_einstein.html", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supporte
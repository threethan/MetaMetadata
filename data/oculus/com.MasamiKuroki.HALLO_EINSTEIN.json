XNGxpIBVY1XmMqcMEQUwDSa2NV6ppBciOWc3w&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zxQQjsgeIAIrzXEQK9iId9GjCnVw5aRx7b9NkoOPzuw&oe=6A32A0F0"}, {"file_name": "SS_03.png", "id": "4588090747885918", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974767_4588090751219251_226456740009901359_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v7T5kUESn3sQ7kNvwHYtsgy&_nc_oc=Adp0bmNy6UU-oaidTgdAC10q1I0uVX3NiaWsGdj_QdQHXy54xYQEJbWv5RW7KpVzRAg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-UQdoO3I8DWpqRh3rrMfTU08uYsIKgiAcflyScYd-3Ow&oe=6A329F0C"}, {"file_name": "SS_04.png", "id": "322449729354317", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974669_322449732687650_822808135241468056_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tvdo_QGy_MMQ7kNvwF2C9B9&_nc_oc=Adq5Ulmj44KS8pleP2enaKrLrADFP61pWpiSl9cYkddCzgw79SL4c-txEsZs2gQM0OQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8hDiKiX3F-czvK6ZncavX4Hg3gzisiAVspGn5-Q36LGw&oe=6A32B0E9"}, {"file_name": "SS_05.png", "id": "836048230450518", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974642_836048233783851_8940182980349785861_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bh1iotgC6aAQ7kNvwE55_UK&_nc_oc=Adr9aK1gJI9YVmmC6BjAE73YSRUibLKKR8Hg1ZJBBeKgpea_jbdxobewfmN6pU7Y78M&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-I8NaH_VuCIhWu6fZbaBGqyI9rFLqDcN-Xdn-Nd83yCw&oe=6A32C94E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HALLO EINSTEIN", "keywords": [], "long_description": "According to the theory of relativity, discovered by Einstein about 100 years ago, space-time distorts around moving or heavy objects.\nThis content will feature time and how much time will be distorted if you move very fast. Based on the actual theory, you can experience the time difference.\nThe content is roughly divided into two, and you can experience all the content by proceeding in order along the navigation.\nZONE1 The world of light clocks:\nYou can learn the mechanism of time delay in the explanation part and the experience part.\nZONE2 Space Travel:\nYou can go on a space trip at super high speed and experience how much time is actually delayed.\nTheories of science that we don't usually think about.\n-Isn't everyone really wanting to know...?\nA world that you may not have tried to know because it seems difficult,\nCommunicate in an easy-to-understand, correct, and attractive way!\nGet a glimpse of the world of relativity theory through experiences that can only be done with VR.", "short_description": "What is \"Theory of Relativity\"?\nAccording to this theory, discovered by Einstein about 100 years ago, space-time distorts around moving or heavy objects.\nThis content will feature time and how much time will be distorted if you move very fast. Based on the actual theory, you can experience the time difference.\nI'm sure everyone has had a genuine question about their own existence and the universe.\nTo the entrance to know the structure of this world ... 4th dimension plunge experience in VR! !"}]}, "developer_name": "KUMA Lab", "developer_privacy_policy_url": "http://cherry8823.weebly.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Masami Kuroki", "support_website_url": null, "website_url": "http://cherry8823.weebly.com/hallo_einstein.html", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supporte
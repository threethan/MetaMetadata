tent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSirDXI_Y2kRCzxBP7yz6yuhlSD5t86sHB4F9NAAIKMQg&oe=6B0C5342"}, {"file_name": "SSC_03.png", "id": "29199565969663123", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499314667_29199565976329789_3186896027106723257_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2iCfCmxklkMQ7kNvwGiRFQg&_nc_oc=Adqgo2K-vHic7tR3yp0FnWsACgHzhQ5Gts_nX_KQ1oWiX-RRYKhoX6zilpnV9jkhThA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRF-U8OoM1ZH104FtU6uUYD9PD5Oq6niDcO5LXDp4qp4w&oe=6B0C6F83"}, {"file_name": "SSC_04.png", "id": "1165093242690530", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312068_1165093246023863_6379700767980739751_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z3GvZR32k9MQ7kNvwGAP6dq&_nc_oc=Adrr2bPLJxjeAiizag3Ni6QlsGsCNdAhKepbIPCa5QOXuJMZkmCdUcCU0Z-lKorvwzo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTVoGbKxZ7qa5y7rXc5PKIWnqyPQd1iOHsemr2pbLRNJg&oe=6B0C7AA3"}, {"file_name": "SSC_05.png", "id": "3691166664394546", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499298150_3691166667727879_8482599867707593827_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bpIrBs10pkQQ7kNvwGGe6Qj&_nc_oc=Adq9IQpm7zsskWdwQ9G_wT_CBGmI9wJAfm2MxqjQ8PQHHFy6w3hNxyx18Ao7eZ33O4g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQFdNu6qveQB8lk8842ipdZ2dJKOm3cbxa68GbfyxOB_Q&oe=6B0C71E7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Supermart Chaos: Restock", "keywords": ["supermarket", "restock", "sorting", "mess", "simulator"], "long_description": "The supermarket is a total mess, and only you can fix it. Welcome to Supermart Chaos: Restock, a realistic supermarket simulator where you tidy up the chaos, sort every item and restock the shelves until the whole store shines again.\n\nBoxes on the floor, groceries everywhere, empty shelves in every aisle. Reach out, grab an item, find where it belongs and place it on the right shelf. One by one, the chaos turns into neat rows of lifelike products.\n\nTIDY UP THE SUPERMART CHAOS\n- Walk the store and pick up every item you find\n- Each shelf section accepts one type of product, so think before you place\n- Wrong item? It glows red. Pick it back up and try again, no penalty\n- Fill a section to earn cash, finish a whole shelf for a bigger bonus\n- Clear the entire mess to complete the store and earn a big reward\n\nFOUR STORES TO RESTOCK\nA home store, a grocery shop, a food market and a fresh market, each with its own mess, products and shelves. Earn cash, unlock the next store and keep the restock going.\n\nUPGRADE YOUR SKILLS\nSpend your cash on upgrades: move faster, carry more, reach further, throw harder, jump and crouch, or use active skills that find the right shelf, highlight matching products and pull items straight into your hands.\n\nACHIEVEMENTS AND PROGRESS\nClaim cash rewards, level up, pick your avatar and track your stats. Every store saves automatically.\n\nNo timers and no pressure. Play offline at your own pace and watch messy aisles turn into perfectly stacked shelves.", "short_description": "Tidy up a messy supermarket! Sort the chaos, fill the racks, unlock new stores. The supermarket is a total mess, and only you can fix it. Grab every item with your own hands, find where it belongs and stack it on the right shelf until the whole store shines again. Four realistic supermarkets to restock, a skill tree that makes every tidy up faster, achievements to claim and no timers or pressure. Relax, sort the chaos and enjoy that \u201ceverything in its place\u201d feeling in VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://play24games.com/meta-quest-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Play24 Game", "support_website_url": null, "website_url": "https://play24games.com/", "category": null, "comfo
IqyQ&oe=69A2E872"}, {"file_name": "4.png", "id": "384434473299052", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982502_384434479965718_1855077359662342718_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8OSWsvCBlk4Q7kNvwEUzBpA&_nc_oc=AdmevbwOmAulHFDR7emGa7MsrqOUcvLR03jHBmNRVDWNQ01m9L-wv5s24-h-Sc6K9Gw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuSslVPUXpUHOpUp9OBt3xtoa1u1S30rX8LIWyRqEWN_A&oe=69A2CB60"}, {"file_name": "5.png", "id": "406314461125764", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974856_406314464459097_8110362691925685389_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=31jgVNVTkCgQ7kNvwH64e_1&_nc_oc=AdnOeDdLgoQa1OmyJb_FBVXHpSREZgepS05iIlfW_UziDPMkKJiAV9ADSdkuiOZ8lKs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvkOWS00sx3zb553AZhQB1DqVCE3xlMcI8cIZX58sZNMQ&oe=69A2D619"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Applab - Trailer Cover.png", "id": "1214984612300793", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974877_1214984615634126_2351846715879690292_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wjpVxTlHwbIQ7kNvwGdktaq&_nc_oc=AdkdnvxjX4_X9uuZuf2k1qsPU2qwC6dmkC-LLhpgTUu-2R1OUZWM8vXEL4-syZcqjBk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs_WeyQlTEB9lE9NGfdDlIjTPzOZG3Axv1Dz7khq685Qw&oe=69A2CBB3"}, "display_name": "Cyber Defense 2088 Demo", "keywords": [], "long_description": "Its the 80s again, the 2080s, and your mainframe is under attack from rival factions who want to take our city and all we have achieved. Multiple generations of people have settled here since 1986 and called this place their home. They are in trouble and you decide the best defense is a good offence and allow yourself to be transformed into pure energy. You leave behind the physical world and enter this new virtual reality world called cyberspace! Your first priority is New Zylon, save it from these attacks, capture the enemy's code and use it unlock more weapons, turrets, and powerful AI bots in this epic tower defense shooter!\n\nSee you in Cyberspace!\n", "short_description": "Cyber Defense 2088 is a fully immersive, 3D VR tower defense shooter. Fly around in cyberspace to stop attacks with many weapons, turrets, and defenses. Demo includes the first 12 levels (4 easy Tutorial levels) and 8 hard mode versions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cttrc.com/?page_id=3", "developer_terms_of_service_url": null, "publisher_name": "Calming Winds Productions", "support_website_url": "https://cttrc.com/?page_id=1139", "website_url": "https://www.facebook.com/CalmingWindsProductions", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "244303574524638"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "405795681127424"}]}, "baseline_offer": {"id": "405795681127424"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1633551660, "status": "PUBLISHED", "id": "405795681127424"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "4046165118817516", "version": ".82"}, "id": "891602548379329", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "b
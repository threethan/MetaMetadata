Y50w&oe=69A439F2"}, {"file_name": "4.png", "id": "384434473299052", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982502_384434479965718_1855077359662342718_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QZbf3O1yiy0Q7kNvwGJvvFw&_nc_oc=Adm2KoKNhqyuP4okdhpCdmwA9oGmIgMZWufWlUuHINXzbF8XWRWXYtcDXAB1yw2JRS8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvQrYAtc84PqvXheey70pdo2H-pW_NJFJgYbYRQ1VhD0A&oe=69A41CE0"}, {"file_name": "5.png", "id": "406314461125764", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974856_406314464459097_8110362691925685389_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ANqMzCQImkMQ7kNvwFcZc1p&_nc_oc=AdllYFiNhR7N_Frn6vf8a5XmuI4kvFeE7azVdH_hqmK4huCVRr-SzXE_DrSuk9ucyRI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftOKlu2M-uAi9g5qUx_8bwUvufaZIQCekx3_wpX8jMRvw&oe=69A42799"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Applab - Trailer Cover.png", "id": "1214984612300793", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974877_1214984615634126_2351846715879690292_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6kyd6DGnn98Q7kNvwFQSbWA&_nc_oc=AdlRdRefJIxNnsQgkxIBN4oWO09o8_BgMnFjGKR9WweVFwkAJc-Sg_zkeA7hZoK3h4I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afv-EMxtlwVZIT5mTS7GY5ArHm1wzA78lp3blCyE2zBoKw&oe=69A41D33"}, "display_name": "Cyber Defense 2088 Demo", "keywords": [], "long_description": "Its the 80s again, the 2080s, and your mainframe is under attack from rival factions who want to take our city and all we have achieved. Multiple generations of people have settled here since 1986 and called this place their home. They are in trouble and you decide the best defense is a good offence and allow yourself to be transformed into pure energy. You leave behind the physical world and enter this new virtual reality world called cyberspace! Your first priority is New Zylon, save it from these attacks, capture the enemy's code and use it unlock more weapons, turrets, and powerful AI bots in this epic tower defense shooter!\n\nSee you in Cyberspace!\n", "short_description": "Cyber Defense 2088 is a fully immersive, 3D VR tower defense shooter. Fly around in cyberspace to stop attacks with many weapons, turrets, and defenses. Demo includes the first 12 levels (4 easy Tutorial levels) and 8 hard mode versions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cttrc.com/?page_id=3", "developer_terms_of_service_url": null, "publisher_name": "Calming Winds Productions", "support_website_url": "https://cttrc.com/?page_id=1139", "website_url": "https://www.facebook.com/CalmingWindsProductions", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "244303574524638"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "405795681127424"}]}, "baseline_offer": {"id": "405795681127424"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1633551660, "status": "PUBLISHED", "id": "405795681127424"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "4046165118817516", "version": ".82"}, "id": "891602548379329", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "b
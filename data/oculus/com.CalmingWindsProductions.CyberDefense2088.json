715879690292_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f12mt6PpIc4Q7kNvwFXBpL6&_nc_oc=AdoUF1rwmse5glt9jDJX8r68_H9V_L02U98CZDhNiO0t1MHs0wsU6mbwKj2b_nW4w-A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwBcQboWyFHsL-l5Fs9KKkn2ptPflY6vH8BTPA2v_UUdQ&oe=69CE4D33"}, "display_name": "Cyber Defense 2088 Demo", "keywords": [], "long_description": "Its the 80s again, the 2080s, and your mainframe is under attack from rival factions who want to take our city and all we have achieved. Multiple generations of people have settled here since 1986 and called this place their home. They are in trouble and you decide the best defense is a good offence and allow yourself to be transformed into pure energy. You leave behind the physical world and enter this new virtual reality world called cyberspace! Your first priority is New Zylon, save it from these attacks, capture the enemy's code and use it unlock more weapons, turrets, and powerful AI bots in this epic tower defense shooter!\n\nSee you in Cyberspace!\n", "short_description": "Cyber Defense 2088 is a fully immersive, 3D VR tower defense shooter. Fly around in cyberspace to stop attacks with many weapons, turrets, and defenses. Demo includes the first 12 levels (4 easy Tutorial levels) and 8 hard mode versions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cttrc.com/?page_id=3", "developer_terms_of_service_url": null, "publisher_name": "Calming Winds Productions", "support_website_url": "https://cttrc.com/?page_id=1139", "website_url": "https://www.facebook.com/CalmingWindsProductions", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT",
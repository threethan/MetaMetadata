-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkoYZ3YxuJBV2rv1Tjjsz71DNzrr3pgKMWpciaprSVlg&oe=6B01BD59"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Applab - Trailer Cover.png", "id": "1214984612300793", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974877_1214984615634126_2351846715879690292_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5wSY1sVSxpQQ7kNvwEasNJp&_nc_oc=Adp_DujsUhP-dLlkGnY0wV5sjEKdb1fcuY5nE5bvoMXfonwpD9d6ZsuY5BYJP1_9jSk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRP_YmWeZLC8SSIH6eHJg48BRHwmAVkgftK0_ruISFgDQ&oe=6B01EB33"}, "display_name": "Cyber Defense 2088 Demo", "keywords": [], "long_description": "Its the 80s again, the 2080s, and your mainframe is under attack from rival factions who want to take our city and all we have achieved. Multiple generations of people have settled here since 1986 and called this place their home. They are in trouble and you decide the best defense is a good offence and allow yourself to be transformed into pure energy. You leave behind the physical world and enter this new virtual reality world called cyberspace! Your first priority is New Zylon, save it from these attacks, capture the enemy's code and use it unlock more weapons, turrets, and powerful AI bots in this epic tower defense shooter!\n\nSee you in Cyberspace!\n", "short_description": "Cyber Defense 2088 is a fully immersive, 3D VR tower defense shooter. Fly around in cyberspace to stop attacks with many weapons, turrets, and defenses. Demo includes the first 12 levels (4 easy Tutorial levels) and 8 hard mode versions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cttrc.com/?page_id=3", "developer_terms_of_service_url": null, "publisher_name": "Calming Winds Productions", "support_website_url": "https://cttrc.com/?page_id=1139", "website_url": "https://www.facebook.com/CalmingWindsProductions", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_t
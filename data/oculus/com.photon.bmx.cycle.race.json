://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823837_1133256135682248_3107795819186582107_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oZw-B5KTnZ4Q7kNvwEW_QCC&_nc_oc=Ado9tAEShqV-gAURBKu_Wf1JlD6d0p-kDobspas8PExgsbxcIkKD3X17q-OXS2TeAr4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGyJ0ZYqVOEF1VQosfs9Eo4UTVqb82pSfF845TBK8cdQ&oe=6AEB394F"}, {"file_name": "3.png", "id": "1963231834309400", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823351_1963231837642733_3732580207848849704_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SHJ5Gf7nxwcQ7kNvwFu3Bva&_nc_oc=AdoLIHtmVLt_FvLgDstRNAhpNMOJiX9RbjTJ9REWKxaCTzGQhRAJ9dGB4ClcMm5myH8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaSTRqM_bMGdrn8syWOdUiFB7i6ZljJYFFUn2e-zWEnA&oe=6AEB5E83"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BMX Cycle Race", "keywords": ["cycling", "racing", "simulator", "speed", "bmx"], "long_description": "BMX Cycle Race is an immersive virtual reality cycling game that puts you in the heart of high-speed racing action. Step onto powerful racing bikes and experience realistic cycling physics designed specifically for VR. Every movement matters as you accelerate, balance, and take sharp turns across challenging tracks.\n\nRace through beautifully designed environments including city streets, countryside roads, and mountain climbs. Each track is crafted to test your speed, control, and endurance. Compete against time in solo challenges or push your performance to beat your best records.\n\nThe game delivers smooth VR controls, realistic bike handling, and engaging gameplay that keeps you fully immersed. Whether you're sprinting on straight roads or navigating tight corners, BMX Cycle Race offers a true sense of motion and adrenaline.\n\nBuilt for Meta Horizon, the game is optimized for performance and comfort, ensuring a smooth experience for all players. Improve your racing skills, unlock better performance through practice, and enjoy the thrill of competitive cycling in a fully immersive virtual world.\n\nFeatures:\n- Realistic VR cycling mechanics and physics\n- High-speed racing and time trial challenges\n- Multiple immersive environments and tracks\n- Smooth, optimized Meta Horizon VR performance\n- Engaging and competitive gameplay experience\n- Easy to learn, hard to master controls\n\nGet ready to push your limits, ride faster, and dominate the tracks in BMX Cycle Race.", "short_description": "Experience fast-paced cycling action in BMX Cycle Race. Ride powerful bikes, compete in immersive VR tracks, and challenge your skills in realistic racing environments. Feel the speed, master sharp turns, and become the ultimate cycling champion in thrilling virtual reality races built for Meta Horizon."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/photonhorizons/privacy-policy-prismhorizons", "developer_terms_of_service_url": null, "publisher_name": "Photon Horizons", "support_website_url": null, "website_url": "https://sites.google.com/view/photonhorizons/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26584454081193486"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "
UEjjtQdw&oe=6B071F2A"}, {"file_name": "Screenshot2.png", "id": "813705704077889", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974510_813705707411222_238550223869688159_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sbybo9fsNbsQ7kNvwFV9FQ8&_nc_oc=AdpBgIDfQ81ZoischqmFzCSOp8IEvm2BI1Bw8IY5BEzI2E3fy9wAzizWiCdAZprBuRk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMyG2kG5i9w1bP5N9tx6RFxILA_-r_K_A_6wry_uhbzw&oe=6B072440"}, {"file_name": "Screenshot3.png", "id": "1423618075004984", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031518_1423618078338317_5302236212722376612_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0w8v0JMXAZkQ7kNvwFcMAP4&_nc_oc=Adp7yQPEJsaCUBQoNwvhduI8bSSs8zxLm0Ptj9Ya1eRcXgwnfs8FTfOigICdrWFJzCY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRnOo5YOp-rYh8ve7FoSxLCmVJM6frkdqLBIFVaUOzRug&oe=6B07265F"}, {"file_name": "Screenshot4.png", "id": "809076641406483", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982547_809076648073149_6566950714060643996_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kBgHcMpuANMQ7kNvwFzLOcf&_nc_oc=AdqgloPwPMSFbRFM9PjVsOEitwkOVbg_nKT8Tq-Hx4mjjd02lDctoYmLBGxGxbhAJmY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQXhw9oa-Ock5kjsODpNFjm7NRr4j9Iv-JgdcO3_MT5Q&oe=6B0713E0"}, {"file_name": "Screenshot5.png", "id": "1694871534601590", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031551_1694871541268256_1009713101858916267_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m5nAkmI_X2MQ7kNvwEmYCiz&_nc_oc=AdoBIjeEQpglMIohriflAMYp7kf1UMKkokP5Bd1wBSG5EV5jgUGSTvSZuVq6_tDZ3mE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnpLcwrCbzzdIQBbNmYmAt5Dm-Pj8xR5Jw9tZR0cz3Hg&oe=6B06F85C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monke Run! Monke Fun!", "keywords": ["Gorilla", "Monke", "GorillaLocomotion", "Gamemodes", "Adventure"], "long_description": "(WARNING: The game is still in early access and most stuff you see here is not in the game yet. These stuff are coming in future updates)\n\nJump, Run and have Fun!\n\nWelcome to Monke Run! Monke Fun! A game where you use the classic Gorilla VR Locomotion to move around. \n\nGamemodes\nThis game has gamemodes to offer and if you complete a certaint gamemode, you gonna get free ingame currency.\n\nCustomization\nYou can customize your Monke with colors, face expresions and cosmetics. You can buy cosmetics with ingame currency or you can find collectibles arround the game.\n\nEntities\nWatch out for entities who are trying to get you. Entities can appear in public or in private meet up codes (as long as the private code is known to the public).\n\nNukes\nSurvive Nukes. If you hear the nuke alarm you have to run into the bunker as fast as you can. Only hope is that you know the code...\n\nLore and Story\nYou wanna know the Story that this game has? Try out horror aka. story mode and you will see what's the story behind this game.\n\nWhat are you waiting for? Download the game now to have fun!", "short_description": "Jump, Run and have Fun!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/grape-gaming-guys/mrmf-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CrystalGrape", "support_website_url": null, "website_url": "https://sites.google.com/view/grape-gaming-guys/monke-run-monke-fun?authuser=0", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": nul
ahRox-B198XViOhZ7FF50&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7EGEGT14eZFPFTNACm5zIDStOp6j5Ij9vNSa5nZ1ibTg&oe=6A1C4100"}, {"file_name": "Screenshot3.png", "id": "1423618075004984", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031518_1423618078338317_5302236212722376612_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GNg5-OUf2gIQ7kNvwEBJX_V&_nc_oc=AdoTMPJ4GewiZMA_4VnI_jiGI5FwZsAUEPNyBsl4z1fRaUHmSplF5zeop31LHPGrgww&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6hGQwMb6EkF2k7K9czUWOirMTbsmT5WhWcr2J4tGPq9Q&oe=6A1C431F"}, {"file_name": "Screenshot4.png", "id": "809076641406483", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982547_809076648073149_6566950714060643996_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1B3cfOABpnkQ7kNvwF_ABuJ&_nc_oc=AdpCq5v1pZ0uOAYAihi9Lq6U5-qVZLF9cuZ0-VzU5_Ar89pwGcAR1VNzv0t5D-eFpTk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6IxGQS09bEtqTr_wkQaUt6roSd0VVbgyZ518-bp7sl8g&oe=6A1C30A0"}, {"file_name": "Screenshot5.png", "id": "1694871534601590", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031551_1694871541268256_1009713101858916267_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W9an0oP2cjoQ7kNvwFrLPg5&_nc_oc=Adrvvf5owQfZTDwajN4Dbn9Gt_bcU6nfKOfjpC8hODnfqBYvfO8IEk0U2CwSFdXOlDI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6SwzzFbbOi_DkjKBFCga-gGzQB1ht-GAVFZh8RXfOaGg&oe=6A1C4D5C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monke Run! Monke Fun!", "keywords": ["Gorilla", "Monke", "GorillaLocomotion", "Gamemodes", "Adventure"], "long_description": "(WARNING: The game is still in early access and most stuff you see here is not in the game yet. These stuff are coming in future updates)\n\nJump, Run and have Fun!\n\nWelcome to Monke Run! Monke Fun! A game where you use the classic Gorilla VR Locomotion to move around. \n\nGamemodes\nThis game has gamemodes to offer and if you complete a certaint gamemode, you gonna get free ingame currency.\n\nCustomization\nYou can customize your Monke with colors, face expresions and cosmetics. You can buy cosmetics with ingame currency or you can find collectibles arround the game.\n\nEntities\nWatch out for entities who are trying to get you. Entities can appear in public or in private meet up codes (as long as the private code is known to the public).\n\nNukes\nSurvive Nukes. If you hear the nuke alarm you have to run into the bunker as fast as you can. Only hope is that you know the code...\n\nLore and Story\nYou wanna know the Story that this game has? Try out horror aka. story mode and you will see what's the story behind this game.\n\nWhat are you waiting for? Download the game now to have fun!", "short_description": "Jump, Run and have Fun!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/grape-gaming-guys/mrmf-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CrystalGrape", "support_website_url": null, "website_url": "https://sites.google.com/view/grape-gaming-guys/monke-run-monke-fun?authuser=0", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8277538162361909"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75196230_351905257
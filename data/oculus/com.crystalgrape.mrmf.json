AE8veZCgkU-vmrSpbvKFU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZYBLqEk4pwzf-fmhPQJkSXRSeHfLkpBFNTCoATyWFcA&oe=6A4E5A00"}, {"file_name": "Screenshot3.png", "id": "1423618075004984", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031518_1423618078338317_5302236212722376612_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C6QFS5WUzMoQ7kNvwHzHI0C&_nc_oc=Ado5197h7mMPwNbDSBIhJ2zx4EStLzWDNuwNK30B1Xj8677p4KxuJWp2SZheR_QmipA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBLsecgKWzAKIm1Z-Ar-EPRQn4es7570b6TTTM78w8liw&oe=6A4E5C1F"}, {"file_name": "Screenshot4.png", "id": "809076641406483", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982547_809076648073149_6566950714060643996_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Olm6eG31ikQ7kNvwG0eOf7&_nc_oc=Adpus0Je5E9ZUi6fKH7uGG_G6M9O5gzUkkBfWJaNxLrUksCe8tjZ8ouuAuJEqTGjYws&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-MbnVfX9CsISwM2TIr2bDqlXWAtZ-fh1T3xSBNEXqfQ&oe=6A4E49A0"}, {"file_name": "Screenshot5.png", "id": "1694871534601590", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031551_1694871541268256_1009713101858916267_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7LCc5b-hSAoQ7kNvwE-MafH&_nc_oc=Adp_lWttSIn-zqM2-Vb_BvWbvBtg2DJzp0iUQ3k0B9Q3i8lzz2iZ4ym4ZXY_BDRBIT0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUgQAf5VFQ7fnbXQxsTSoCb6LxkQoP0rllLp9qyJ_kYQ&oe=6A4E665C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monke Run! Monke Fun!", "keywords": ["Gorilla", "Monke", "GorillaLocomotion", "Gamemodes", "Adventure"], "long_description": "(WARNING: The game is still in early access and most stuff you see here is not in the game yet. These stuff are coming in future updates)\n\nJump, Run and have Fun!\n\nWelcome to Monke Run! Monke Fun! A game where you use the classic Gorilla VR Locomotion to move around. \n\nGamemodes\nThis game has gamemodes to offer and if you complete a certaint gamemode, you gonna get free ingame currency.\n\nCustomization\nYou can customize your Monke with colors, face expresions and cosmetics. You can buy cosmetics with ingame currency or you can find collectibles arround the game.\n\nEntities\nWatch out for entities who are trying to get you. Entities can appear in public or in private meet up codes (as long as the private code is known to the public).\n\nNukes\nSurvive Nukes. If you hear the nuke alarm you have to run into the bunker as fast as you can. Only hope is that you know the code...\n\nLore and Story\nYou wanna know the Story that this game has? Try out horror aka. story mode and you will see what's the story behind this game.\n\nWhat are you waiting for? Download the game now to have fun!", "short_description": "Jump, Run and have Fun!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/grape-gaming-guys/mrmf-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CrystalGrape", "support_website_url": null, "website_url": "https://sites.google.com/view/grape-gaming-guys/monke-run-monke-fun?authuser=0", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8277538162361909"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75196230_351905257
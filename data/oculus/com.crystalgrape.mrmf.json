rd5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxD4Ocu8J4t59GXvp9Ey-gf4EnuE_I6EXDag4vw30BaUA&oe=69BC0380"}, {"file_name": "Screenshot3.png", "id": "1423618075004984", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031518_1423618078338317_5302236212722376612_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QQtd31dfM3kQ7kNvwFjUAcF&_nc_oc=AdnmfnguAiiWl8OF7l8SuQhmr-R25h3CqPqyf-ZOhkUWGTy27g_SugeodI-ngL5PgDU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzMkGDaHZk1K9OWZpMCnC3HGFBeVyXFys1kVnIL0lPQrA&oe=69BC059F"}, {"file_name": "Screenshot4.png", "id": "809076641406483", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982547_809076648073149_6566950714060643996_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3fsPBEGN4IQ7kNvwGcvOb1&_nc_oc=AdmfPHEjQbi4CfPhtdG8Dk33uXJOX5s0Te1DFA0BBnlGUWmC8eDKifpavB5EO3Flxv8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afzf9AF3uqMzHHdw-j3e-oXuzyq0nmV0RPGry_FOghhQJQ&oe=69BBF320"}, {"file_name": "Screenshot5.png", "id": "1694871534601590", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031551_1694871541268256_1009713101858916267_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=anZK9jU1IAwQ7kNvwGyJkpt&_nc_oc=AdmXF1WqgW-Gk86rZRGu6GI7BTQhQzfu-lnRFubewiSpjjHe1PpsAdbU1GRi7I6DXdc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwxC9byH8ie9G7CLJGwumlzGIwSylDzpsuTsfbnJBjGVA&oe=69BC0FDC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monke Run! Monke Fun!", "keywords": ["Gorilla", "Monke", "GorillaLocomotion", "Gamemodes", "Adventure"], "long_description": "(WARNING: The game is still in early access and most stuff you see here is not in the game yet. These stuff are coming in future updates)\n\nJump, Run and have Fun!\n\nWelcome to Monke Run! Monke Fun! A game where you use the classic Gorilla VR Locomotion to move around. \n\nGamemodes\nThis game has gamemodes to offer and if you complete a certaint gamemode, you gonna get free ingame currency.\n\nCustomization\nYou can customize your Monke with colors, face expresions and cosmetics. You can buy cosmetics with ingame currency or you can find collectibles arround the game.\n\nEntities\nWatch out for entities who are trying to get you. Entities can appear in public or in private meet up codes (as long as the private code is known to the public).\n\nNukes\nSurvive Nukes. If you hear the nuke alarm you have to run into the bunker as fast as you can. Only hope is that you know the code...\n\nLore and Story\nYou wanna know the Story that this game has? Try out horror aka. story mode and you will see what's the story behind this game.\n\nWhat are you waiting for? Download the game now to have fun!", "short_description": "Jump, Run and have Fun!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/grape-gaming-guys/mrmf-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CrystalGrape", "support_website_url": null, "website_url": "https://sites.google.com/view/grape-gaming-guys/monke-run-monke-fun?authuser=0", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8277538162361909"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75196230_351905257981623_3484449600135350183_n.png?stp=dst-png_s360x360&_nc_cat=10
DCE5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cropped (1).png", "id": "369275378961993", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974777_369275382295326_5593871603870651911_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kem-rfGI3KYQ7kNvwGXq4Zr&_nc_oc=AdlswxYr9tlla_P18eQqVE67QrQKt5q4OqFppAp50QqzrLIuXWnEVP95iqq96vMBU2g&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_Afw5lqcMfnzNSPnNyyjVPrsjA7W-fz5RcA02mHYSLrkPAw&oe=69AAB713"}, "display_name": "An Ape's Life", "keywords": [], "long_description": "A new type of ape has been discovered...\n\nThese apes have adapted to human thinking, but there's a twist... they don't have legs! To take advantage of this situation, they use their hands to move! \n\nThey have discovered areas such as a nice forest, a modern building, and so much more!\n\nSo what are you waiting for? Come along and learn what it is like to be in an ape's life!  \n", "short_description": "Creatures known as the \"apes\" have learnt to civilize a forest, what will they discover?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/an-apes-life/home", "developer_terms_of_service_url": null, "publisher_name": "CrazyFlareStudios", "support_website_url": null, "website_url": "https://sites.google.com/view/an-apes-life/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "69987082169140
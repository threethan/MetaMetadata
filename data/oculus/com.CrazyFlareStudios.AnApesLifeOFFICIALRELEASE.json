\" have learnt to civilize a forest, what will they discover?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/an-apes-life/home", "developer_terms_of_service_url": null, "publisher_name": "CrazyFlareStudios", "support_website_url": null, "website_url": "https://sites.google.com/view/an-apes-life/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6998708216914055"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "203020529527522"}]}, "baseline_offer": {"id": "203020529527522"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1702945800, "status": "PUBLISHED", "id": "203020529527522"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7132858063499069", "version": "0.61"}, "id": "357555223486303", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6972773649507512", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "7132858063499069"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "357555223486303"}]}, "change_log": null, "created_date": 1705878783, "id": "7132858063499069",
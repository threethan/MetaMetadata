, {"file_name": "vlcsnap-2025-05-29-11h44m56s004.png", "id": "2884272338419134", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499318937_2884272341752467_7614833867758011633_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N7wBW53yMQwQ7kNvwFCOrRO&_nc_oc=AdpWKzhYg2-N8wfSPUiKownj7FfWFXFWyHuiHCGjTlbjb9s-hA3vRAMUSrY-1TxfPvY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRXB4fWfGBx5V7vcv3GNikDeMfTIO0VG7drTrl1iNUuA&oe=6B04790E"}, {"file_name": "vlcsnap-2025-05-29-11h48m33s892.png", "id": "1381075616273563", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499318946_1381075619606896_3731889989101433856_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o3zZg1RiWkAQ7kNvwEpFQ63&_nc_oc=Adpu5fnNMp7q5gHqo9E1xh7lK61b_29dB36bK8vlZ2wDRm8wadn9VXgaM1b4iEeSOIk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjjj4Btl3zV96EPWLCtxKyEesE14x8j2pDGXGZ9VPPbg&oe=6B047F5D"}, {"file_name": "vlcsnap-2025-05-29-11h42m35s961.png", "id": "976038777939875", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499348617_976038781273208_347964581038821488_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4wOrsVGIqNoQ7kNvwHN8m7f&_nc_oc=AdrVy3ht0qVJwG4DFbEw1lpnzgYsZihe5uMONBnY_59czb4pZiYbGGM4oVy8eonCDww&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtdHO0ufBlv-aOblxVajZN63mgV_mPPkOaungyMg_SqA&oe=6B0471BB"}, {"file_name": "vlcsnap-2025-05-29-12h18m29s320.png", "id": "1326781075085541", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499318322_1326781081752207_6717000998992626475_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VP9M60XwHZwQ7kNvwGMdNua&_nc_oc=Adq3JWNIaQ-kClpzdnl8dyMhCpriDWa1pPRMGuMZCsX0qXFi-z5aei4SHQZqwT4-wzo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScyrdUqRzAZV9JyRkNoj4tR07O9_wrG2SO1o42ylo1wg&oe=6B047BAC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2025-05-29-11h48m33s892.png", "id": "636284609436828", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499345887_636284612770161_5505962722637464131_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cz6s8t20KG0Q7kNvwF72goU&_nc_oc=Adq_j2-iT67tJUM6TnC7dZKDUOrfAVYBYysWmO_mTwEmUnC29hNlGSJZ4tdzIWnXH6U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZueCvJ6iJuY5anhEQLIk_hQfgWxka0NEX6xMRKAP47g&oe=6B0486F8"}, "display_name": "Perspective VR", "keywords": [], "long_description": "In Perspective VR, you engage in a mind-stimulating puzzle experience where your perception skills take centre stage.\n\nThe game revolves around manipulating simple, vibrant shapes within a three-dimensional space. \nWhat sets it apart is the challenge of positioning these objects accurately based on their shadows or perspective images in the X, Y, and Z axes.\n\nThe challenge lies in aligning these shapes precisely based on the information provided by three images\u2014depicting the X, Y, and Z perspectives or shadows; your focus is on accurately interpreting and applying the spatial details presented in these three images to complete each puzzle successfully.\n\nThe relaxing VR environment & sounds enhance the puzzle-solving experience, allowing you to interact with the objects using controllers or Hand Tracking.\n\nThe game offers a variety of puzzles, including 12 new daily challenges, 30 weekly puzzles, and 48 monthly puzzles, ensuring a constant stream of fresh and engaging content. The upcoming online mode promises to add another layer of complexity to the game, providing even more brain-boosting challenges for players to enjoy", "short_description": "Get ready to stimulate your mind with Perspective VR, a challenging puzzle game that will put your perception skills to the test. \n\nWith controllers or Hand Tracking, you'll place simple, colorful shapes from three different perspectives to solve 360 immersive and zen puzzles.\n\nWith 12 new daily puzzles 30 new weekly puzzles and 48 new monthly puzzles, the fun never ends!\n\nPlus, stay tuned for the upcoming online mode for even more brain-boosting challenges.(coming soon)"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3digitalinnovation.com/Documentation/PerspectiveVR/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Myself", "support_website_url": null, "website_url": "https://www.3digitalinnovation.com/Documentation/PerspectiveVR/GAME/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "30542820845305256"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974504_656396759622718_376461467700284804_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pS56u8OpAA0Q7kNvwFO3i1f&_nc_oc=AdoMApWXTQYLNw15bTGFX3v8fgSGoW75DQfHem0Dgcy5Yjiq_bSuhBkgTdoxoaCZs7k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSoi3UkF2RM1n85ABcgnFqsf4K5JcBbzD74CoTDreqvCg&oe=6B046403"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Perspective VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}], 
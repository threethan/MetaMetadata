=6e7a0a&_nc_ohc=z3zg2Ddx5N0Q7kNvwGZy3p1&_nc_oc=Adr0hwJ2ID3PgFdoXEwvGfsKu17XGHSOKjVYfihKhlLIfN7-qyv1F1yivihtgSq_c2U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPhBUphVsSsTmW5M_tqy2KPr5Z-u3_NBkImxpUmA6PoFg&oe=6AE49805"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iuA4nmDFOnoQ7kNvwE_sCDm&_nc_oc=Adopfp2QZJL_HHoIHSxQGwIhGWQBg0pvf-MbLJfi7RRpJgIkD_KD6k4ItuENtmt9GoQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPmEfYFS1Zw43gc1k8UuSGfw9gvLk0B4dNlEOQV21KHJw&oe=6AE4A592"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oHB3Hg1kPRcQ7kNvwH5IKd0&_nc_oc=AdrIJfdMtBgBtZEx9qP2tf2LNoPvNZvv1xu4pu8URQkM1jyaegxQlV3YLGFJsWJfUcA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN2Hef36eaHlTGWQlJGUTiuPEnAcQHWoGYeOyXtUoqL7w&oe=6AE4A284"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c2Vr-_rHUrEQ7kNvwFoGYbe&_nc_oc=AdpziYVYLJZplPldoosN278QQt9XTSYIfMI26VLN5LA69ghox2rPP4Ofeo8s9zkXeU0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMLgdp_a5s2rNimezUxvYjqcMC3Sv2TUXY1vmjpMM-sUg&oe=6AE48C59"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IXgv05YFa_4Q7kNvwHGFUC3&_nc_oc=AdrlwOQPHgDtzbkH2RlXpy5i-dZewSOiEpa13Runp_IKknO9I365VlFROi9cxzX1fos&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMv05Evji-ZcQvQN_Eiwdi0b9Bt8ctUTvoJM4kBJvRGag&oe=6AE49382"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LjRIcnf9tM0Q7kNvwE0Qep2&_nc_oc=AdqfE8i3uwfkewhRrd79F-wBoOakEf9D-yLv5wpU18TXHtJa5grAmnRfh
=6e7a0a&_nc_ohc=ZmtbzetigwUQ7kNvwEYcBpY&_nc_oc=Adpz80KYZwJPROlTuz3Hn_fSKpEssQXOguQvcs5r5Mwv5Ehu0ncCXB5rnjrFFHm4db8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMikp1l9NBN26PncwZk06aWS8OU7rN2WiEnS1kFays9Ig&oe=6AC64585"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zF1Ls_BUF9QQ7kNvwEZrgeS&_nc_oc=Adod0sp7tMycqm8iOtunGIsz8OzmdHH70HgquY-BFu3gqFmg3A_oWEQWC0x5g84eUTQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZ_cgJ38oGRioMtGD3mBO_xsDq1qlATakX3elkQWZcyg&oe=6AC65312"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6y0X2PhiYQ0Q7kNvwFs73v8&_nc_oc=AdqEcpeAEG6NSBEIGhamHiED01gl5M1_fZ7rmmTF0vaDjXeFalmmZ2xUVo00vjwmG_8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPTOnowODUcbg8fWpeFjJJGY7YFpynJz_rbGyisg5kpFA&oe=6AC65004"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qo0xR9XZPOIQ7kNvwF1T7wF&_nc_oc=AdoUKWTepc0MUD-PtPSBYmBOrDEnrqcb0DxVsw0nFv_R0FjhomXFA8-0_CEiYl4YQ-4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFqnivcC6kUmW7-vsVVrdMceCkpEKv7ZbbYb7JltNiLA&oe=6AC67219"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cZYkipgkLasQ7kNvwHZlgmu&_nc_oc=Adoe7apyoMw24kEJ9OIz8RCzzLghbHcNwl6ZE0uIXxYKwh0Gzwsjm8cNlbY0wU-GsXY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPrXKXe0BsvuTaVocD9wVPPNpJwlc74_s04-7k4F_8m_w&oe=6AC64102"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JCmRR-ykv8UQ7kNvwGV3Iy8&_nc_oc=AdoQRyBOJFAzjc4YwruxreTTqfn-bEfLzZvuv66JOsGAgx95ld0KCUKLX
=6e7a0a&_nc_ohc=LdbCj6HoSeAQ7kNvwFrn6gd&_nc_oc=Adow60qBQWWpGqZ-jvdQV9CEkH7EVNtZJM8DangYwVhHVtjeP2i82uBlhI1ZzQfizLQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMFq3yGkf4Ti9H25yb6ecYYUElvfwHd-NDw1SnxzXvo3A&oe=6ACFB845"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dcuaZ0NT0AkQ7kNvwGsG9nY&_nc_oc=AdpMjYDQC353S87cWr7t3KR4E-Ii1vYo7zUFoCi-_6RbYUxXQ3BNaL4LsOMkv5r1jmI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP0vBdcx1eKyPnr__AEJIOptIxxjgawG3yfOqFH6CZZ_A&oe=6ACF8D92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aToysBFH-FYQ7kNvwFANXlB&_nc_oc=Adod4PwHPONlj34oTecpvUCG8i6-A3_ZXFdTWe3JnSg8sYsZdL8kh6_QOlxEaCOdZVk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOD1GcTsTuFgVSwdaONQ_DGjcbgGcolAgT7y-IB2wZgwg&oe=6ACF8A84"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mvgACNR2ZT8Q7kNvwEgSbxy&_nc_oc=AdqOE4SqRbtIb3bt6ujcZ8NL2D0aLKUoh3JHRHlEXlO9sJXw-uZffQl4y3qKEZvUIn8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNys6nOrBDSlWg4QXf1jsuOE6syFXEK-VjSdu0_kWKOg&oe=6ACFAC99"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dyEJ5yonysMQ7kNvwH_pDNE&_nc_oc=Adq4AEMGzBaB7KBakgTkIdUiAqBLdyk9ya3sUNICLEQ2ZbyKPK-OXPWUla6-VZ2E5W4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNHQ-WOjg4bIEkV1cLQAFzbrY9S_F3FhXeuFA9sH00fXg&oe=6ACFB3C2"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8HsSD52fGloQ7kNvwEoYQj5&_nc_oc=AdrUIJKGrTGtdU_0cTfEqfyredWt6CYDgrrxK1JlRRNichZhDDb5H9JQA
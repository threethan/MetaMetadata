=6e7a0a&_nc_ohc=BScGAJy33mUQ7kNvwHLZXEY&_nc_oc=AdoywybtrJ8pMZIfgINkq_EqYOmod3krKfta5Jnv9odfqBKX2bW7Qunwzjb4rrH6jgk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA8I_HqBss9FFab5trXCOC-QANldfrcrfT_z1u5k4Tn6Q&oe=6A6C9F85"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BI90TUt8ER0Q7kNvwFea_9E&_nc_oc=AdrkYDQkrcS-fVWdo5XYfbL4gJLBJXeQK6ofI_6bvf4gCp6X4Sh9-ltcIDIVoocT4zU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAf0frVnD4knXBPCGR1y4UEI9-qcx6op4sEF0VomQzQwQ&oe=6A6CAD12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tGQTZy_ps8QQ7kNvwGCtVo2&_nc_oc=AdqvPwTBrf1w0HIe3js1nyP4xuinuXY5AFQOQrDfoyT5-cH8KsxdQN1C58z7H6QZJU8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC866-8wCb0atixBHiM4DIWAr9-BuSuoIgOnyvs-1W6KA&oe=6A6CAA04"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mPr5DoceWlcQ7kNvwEAxE0E&_nc_oc=AdoCNrFDkARtds4v5yrQExh1Zjgq_A6kNmIEIGj_zHgfnu6_QY4g-jAJYAknCFJtYFQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA4fMY9etCP6-ZNfoP95Z49lVJesxRWlCpLn6vPxjoU_Q&oe=6A6C93D9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4nH2e29f73AQ7kNvwHDrW9r&_nc_oc=AdpPpLbRLKCXQBAkfd8eZWwxLwU7XF61FoI2OFxe-lXa9u-WSy4GILjVBSDj2ifVn8Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAtOGYe8d4xQIoLwxe42O5IcFC0yU7VewBsj8Y1XY5jEQ&oe=6A6C9B02"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B6JkGPbR0b0Q7kNvwELyNH7&_nc_oc=AdrqYaoOOiqw3Z6Vkxr6gcq_IqrIVv_zCwO4gzvEMfq00TrXDOhRkTHqX
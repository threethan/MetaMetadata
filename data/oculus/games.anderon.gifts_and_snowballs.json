=6e7a0a&_nc_ohc=9-uGbwH5cRYQ7kNvwGsx50o&_nc_oc=AdqGzRYosjP3ltEd0wyUDBzXurj1hHyqmoZLiz_mk5727XR5fAMUFhRGPfy9C1gVbcg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af24a4rMD8i6TdFtPWhntX9gWvaByM7ZqNdNvDsAvwHJ2Q&oe=69EA1B05"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gu9qkrjJyrQQ7kNvwF2DZwv&_nc_oc=AdoeHwdetEHfJdpsZ-tG29KxGhVzVzbZPV0ipLlycuDPGEfZEcsrcbaEJTDLSnFh3XA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3OavNNOIwLp52pTL_xyxy8BnHmPzpFGXxw_fEjF3yEOg&oe=69EA2892"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cu9zi64_jnoQ7kNvwFTFHA9&_nc_oc=Adqn-XlMKym6QM4U4F73H-74jQeQAPuoZ8foT5bbUtgZhTt9LDZN-JBYhYMJpKBAUVc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3OhtIbuPsWHzQTu90wj29iNNeoGQ5qMyXswJUcZ05h1Q&oe=69EA2584"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O1X5J-IT14cQ7kNvwH2B4j6&_nc_oc=AdqJ3p7uUrhZDBKLiLuUSdRQmxS7rh81H-yqlnAKyrz6-77Ap7AajFWWtXgrE0biiuE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0IXdv1a29kKmJD9zujCMphly3l9t5Y_C_1C5fji9S83Q&oe=69EA0F59"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iUuuKMs9-awQ7kNvwFo338B&_nc_oc=AdpFzghgY_9dnLmo9IrboM--_S5TCDF2RdHLvaSp-d6BtW1Gexh6BU2ohB5hcVHqSMw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af28W9GJuMydRgUssOSdSzgMFmYsgrluMhXlxjXJf-jvKQ&oe=69EA1682"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0-FbwvnTa1MQ7kNvwHp3jO-&_nc_oc=Adqx7osMyyQZuIVM3Z_wW9cWJ5kAL6BT93KvEuxyesy_qTHkmqYYmBWdK
=6e7a0a&_nc_ohc=mT67btntPmMQ7kNvwHTdWK8&_nc_oc=AdoatHR_R97y_na1mmMT2RyWcuLFu-pfBsbvBcaBENQBEYu_0PjhcS-AKLVED00j0pU&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6b28b02ZxICPBJ3hdMVzj8nF2XtMpq4jJ8ZpRK8fWUNw&oe=6A09BF05"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9-Q7MeGvoPcQ7kNvwE7U308&_nc_oc=Adqr_R1vLZ0tNFQqkpQ4BjB22WimrolTCjE8pCm4WVIuyHvD-rol8JlGRZFv3OsO0cs&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5q4Khy7CkfohwAMmFtoJ9St2mN3v7Mmig7JRssPoQdHA&oe=6A09CC92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IKhTfiqSBtoQ7kNvwHD1ToZ&_nc_oc=Adod-ZTPnKcJKDe2VwNBCQIi2dThNTGMJE9pehlv4uWpC4j4OA_zL9hYwU_vRUR8uxw&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5eHW8H9a1bFB8GwNbjuLFaEOPA54u6F9MjsrFpGr__dg&oe=6A09C984"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i-0Z-lqJJy0Q7kNvwFyfrmd&_nc_oc=AdrYMXALp3kb6vILJTqDxcKNUTkBvxvpDyL9APOJXTY4QUbjR6LkaMBo_ogwgyebTkk&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4fOuuQn1EO29AttC8bIJXI68v4FxruoZEYbca6tVYkyA&oe=6A09B359"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KODEUY_LKyAQ7kNvwGgRXQ7&_nc_oc=Adp3SH1zpSZm_gqiOwJJvwNHkXftfmlofMj_uNiqcT0iND26anx85QHdf5YVrGlmlU4&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6C3lM5YoKoQP_0F9Z9nhhlumG8Ah_xT1TbSZf390rJuQ&oe=6A09BA82"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YVVwmb3lcIkQ7kNvwHT-PZz&_nc_oc=Adp_vlax4LeXp5R74tKQdU8KFkBFd2xyEf_RXEmdBS0t0rt3d6cDDIc7M
=6e7a0a&_nc_ohc=kafsett0vJsQ7kNvwFD_7MY&_nc_oc=AdrJ2_K5hwF9PrxlewZ_5UsHrl13j_LNT7cgFRP5UlaU2t1hkGo9rvOEEhHuEHeukRU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2bQsz24DI5XkSMCHYGji9kwy1VTC-NBkzUcymAsyhB0Q&oe=69E38385"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i12TB0yhJNEQ7kNvwGQpf71&_nc_oc=AdpWDFEFFYpBG-hon2Ec7nUhdFvtRgaYKHTIe1po9DdJQjHIh0tRDiGOA-nsd6uqd3g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ds7miTxcqfDl469A-Yh9PdKB3HS4IZg15sD2hjm__Xg&oe=69E39112"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5w6I_sKZgUwQ7kNvwEOHqwq&_nc_oc=AdqVV8q9FpOE4ntuuVMBMyxpiupM4OkoZgY5ycjwQKRzCNtmqStTU26SLeE-uRG5MaY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ln4QkgQmaBLVvSczLw8PjJeUAFdtl6P_LpEFSoJSIyA&oe=69E38E04"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YrgruFr7e2EQ7kNvwE_ppNP&_nc_oc=AdpyAJ8HjjMYpHo_AOJvYw24VHCA0lYrd_XHvncz2WFuNscr9Nt7_D9m73tBwcdEmJQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2_mVsJ_1OhKPa0DweQjnVQ0u1K_6BaQa0d5y9cnvt7fw&oe=69E377D9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Nve1BT5Yz4Q7kNvwFd0pKn&_nc_oc=AdoqLSVvjpg9WlP8RZV4kkjyHHcDPUAAx2BiDOR2HHURkoDhdO1ufGewYPcC_-ndWTE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1vs0i_ROxUIXE5aNfuvssCQqawS4Im9rct6MbesxihpQ&oe=69E37F02"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HnOgWk6Hd6AQ7kNvwH_82qB&_nc_oc=AdqNHWRMioDQeyI6Gbe5A801OezemNYQdkSr04ESSbGalWil3xzJ30ZL3
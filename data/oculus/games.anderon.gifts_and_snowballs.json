=6e7a0a&_nc_ohc=UV8oceCainUQ7kNvwEfKobR&_nc_oc=AdrHO9xTSQVKv_5MEPue7T6Fkxu0XPpfsVj64JC5GAQBY_p9eHG2nZKCjOjPnYYM-dE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIS3Tr17tvNaYCIKTyt1iD6Z4lGONy-toNbEH8mSvoIbQ&oe=6ABA6805"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C_x9m8qd_zEQ7kNvwEzkTiZ&_nc_oc=AdpwfFgNP0p0UdfuXgyXV2n5LuKukjXtJjkamd8j8M2MQRs6tFV35YkHxuIa5EZ38Vs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIcU_nzxjCpGT-Kaupsk_NhNM0rYHjcTKKQ9FC6ae_ZDw&oe=6ABA7592"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=167wAch2kkMQ7kNvwHlkGTI&_nc_oc=Ado0mQTWHbiIFquATOmCFscfZCQXix4DZZuUijd8aDjeUG6ZF-TbC75HjQasnaahRho&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKO9fZdg4MypCHwGNG1_gBNt2yb3mx_rPgudDLKINlZQw&oe=6ABA7284"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cwY9f3-LoXkQ7kNvwEK7rNK&_nc_oc=AdqNS1DRC_nVok4vWy-AJaRI8U76udaG6us_frYAYnc5kXCSqpKtqhCnOGVXRX6i2RE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxkDdlFYcBnjHvo_PjilP14oj2H-Kue0txtYSrNjulXQ&oe=6ABA5C59"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cxhUORAjPhYQ7kNvwGaPo7x&_nc_oc=AdotLA-YhfEiwS4pWUSgERFggHL3IRLdRu1ZZsgaqlKig_KfEB53zm48_aFFb2ulwEo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqLPI35_ggni-h87kWZthqXRk9LtYuXj7XUut0G9eD4w&oe=6ABA6382"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q6ou1TPa9BAQ7kNvwFQtuV3&_nc_oc=AdppC1XBSPP6QagjE83P3umxQ40KdJjPM5DwYYlLMzqGwP1G6ni8bvqF1
-iad3-2.oculuscdn.com/v/t64.5771-25/75286676_577533401544348_4203344657555901211_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NT1v1PGXe2kQ7kNvwGxI2ne&_nc_oc=Adk-8ctl_OSdeSs9CXi4JdqiYcMhMSZolEBSzvFmnryCg9FLTILrP1qqxldpOS6bJ5E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvjNixov19vFJssU7gX69GkqJUVhLWFYRM7YpqyeEGnpg&oe=69A98C28"}]}, "id": "2073760636370964", "locale": "en_US", "screenshots": [{"file_name": "screenv2_02.png", "id": "993244952825890", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974853_993244956159223_3665934591366094743_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u5a6tqkixj0Q7kNvwFT9Oar&_nc_oc=Adm_0nWbsFwrDVgV5fdMgoKjm64OAkqSpjJmrB99sY0WFYdNH8O_qEPok_GrT9GobRA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfviiMw-LTRWv8j3E73JCI1sHFCy31GZ3gnQdGCcIjp2nQ&oe=69A9760B"}, {"file_name": "screenv2_01.png", "id": "517646341325841", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572947_517646347992507_8365861269156842802_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8-dUIKB7NUkQ7kNvwHSsCym&_nc_oc=Adm9eVYZUc9dU7K36ujfdrRVrdo7fY4YfS8v50WXMvxb61vNnUaaCwSLSBoDXFCsKWk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfudpsDjRtl8xSpjYjAtTbKbUfnQIn5aZ9HtQoHmhOykpw&oe=69A96F63"}, {"file_name": "bagarre selectable01.png", "id": "987094796807741", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391822_987094800141074_5341301578934495068_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hb3kb2Vm7E0Q7kNvwFmAKdY&_nc_oc=AdmeDROn8RTz7Cs2A7n3sejPw08QJ_QlhLOIzlOBAwcvQaSWJWLWkJgvveugX3X5Nf0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfserMh_Is0YV1695tkv3Gpp0cCZXDCDeRbftKio-3Rq4w&oe=69A96E4C"}, {"file_name": "pinched warrior03.png", "id": "2233739983674845", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391837_2233739987008178_5682748129040869737_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=durU0gWoz28Q7kNvwHwqlTw&_nc_oc=AdnUtnXDxhWWKaGP1iRXTzWOdgmBq-qZeSlYnHcpSAmdbBIH7MlkayYc2POQzeRlKbc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuqJtBJQodhyDIex5ZSfu2RNUBIXwoqKqXLPg4kISzutA&oe=69A98185"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DFrNBx8eLgMQ7kNvwF4O6fb&_nc_oc=AdnPlAUvtZLBdPj0oV41IEO9mPBQn0ug4sGykhtzSBPyECZoEgnIMUuA0oNMdE9mCZY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afu4FGyS_ByomUrzkNnzPxyVy8LdGPy3bLMPYSOAwPO5qw&oe=69A98F12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h7WAPYa6mKUQ7kNvwF6RBvk&_nc_oc=Adl1IGPWIL1uQgbQtoHaF45TtcFQOlxb2uoa4UmVRUjFax8MFA4wxmIjFdTQwcCQCKE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvWEIvW7il92ZEZrDQFkft7EWg1AhWBwTuiS6T8iCBK7Q&oe=69A98C04"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HXM0jP3mEMkQ7kNvwH3Ci4k&_nc_oc=AdmVllZ4agUoZHSAnOxjkPZWqzksFohPBgWc7B5zgKx_q8XXIfG-0cGaauYZaquGw9E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuSrOOfYTWnj3OYFV37F5IxsCVoShk22EaLZK1eXkDYjw&oe=69A975D9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QSyeiATZFS0Q7kNvwFTV1w1&_nc_oc=AdnaQCO8-sc0WfMXZA1a4vM8qMruxlyidPSTRAH14coJx9cJsoO44UZr7zW1qtoQ72Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsISMo_HvIalUgr9EoCamPrCBTIS_0WPArCfFz2_kHLIg&oe=69A97D02"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fzDHDdKe0VEQ7kNvwFRo05G&_nc_oc=AdnBIBb3PUsFPnESH-AV81KDb5x053oIsnkVHrEgBs4OACBU2KLq1rCPP9KLtsDjMwo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afv7401o-seNORgX
=6e7a0a&_nc_ohc=HOLYN9yBL3EQ7kNvwElarqc&_nc_oc=AdrU6DFxrKwB3AO9i3V26phlXtOvZZNqAmrGzyKfG1ZX5DZoQbi4pzBlXFGHsgZyJ3k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLaDyQVakMMLsDlde7lK-Abiu2bK0_Me2vbDBwtW1vagQ&oe=6AAFDC05"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lcK7Ax5UDVEQ7kNvwHwIvzM&_nc_oc=AdoWwMrrGOGdbYWHo_DQmnrAiz1WoqSuwgZ7pSbDh_IFEeK4np0-ic6n5VzoDKLl8_U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLMNCEtkO4O7CR33iK9apFIqzVgKxEMjVAcx97kl3rLlQ&oe=6AAFE992"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-zF_8yPpxsQQ7kNvwGOkrz5&_nc_oc=AdoWOnnEFB6flhMv8CLS-ol4mbjUb527q3ABAUO2AWANjL0VfzGPm3qm9p68VsyEkTU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLOHPMxFNMrERqRK0Jvvu3uZeeBmAOEHWssIxQlzq1QvA&oe=6AAFE684"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X-bd-0kL4RoQ7kNvwHiQWWP&_nc_oc=Adrnl9LYEs_hRosuNjKC_1PpGzMCB2TPEcukyX8ah8V3iqQ_b207NXb-B7oeIqLpT8Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMveNh4yyUdbrXID0thEad0narXeOAn76CTx4Rf3ERhw&oe=6AAFD059"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PigRjd9JuwcQ7kNvwFh02Js&_nc_oc=AdpXmC7CTh6Kr0hhe9A-cg80OfHIn31DwbowaBXTy5lA65f468t2JVSpA28l95T1mwU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLETl0MUAogZN8rkbx6UzgY0av_DdsJyYLgqT1lGiv8WQ&oe=6AAFD782"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KKlqKi-3-iIQ7kNvwF22vX4&_nc_oc=AdrfAvDRQGTKc0tl17aqURW0qZG1bp3Klk0IVi8rdvmbG5MCkYv_IllYG
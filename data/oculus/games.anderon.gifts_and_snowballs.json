=6e7a0a&_nc_ohc=EimbWnSlFJIQ7kNvwHCphFW&_nc_oc=AdpDOwQmfl7iWO1svw_nN4SQ9NeyviuO7sZHeKoe4eLtjjs1HRXb_rqNOcn32Km3vnQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxYLxZl5vGHYyVToRfHia4wULEatiImmit1hQegFHw3g&oe=6AF1FF45"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TSjow23PBXUQ7kNvwGlLkMF&_nc_oc=AdotczpeyFRpvxYEzsH4TxTyQ8IabKf64IxA3kJLpRaVBoqBw04M7IMw6F47pczLT04&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQm5RvK8bYAyaygAcSB7YKJeHU3HisxxWjbWN8TLHa6Vw&oe=6AF1D492"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_bpJ2p0C5e8Q7kNvwHbYNvx&_nc_oc=AdqTxohMk-j0AjP2IBCR0n0wO8hRgXBE1FQXuw6O8P9ROfTVFSShaliJX7yr3_DkaA4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4ald-4Y1HBHZk0_KbtgOYmFsmhGuxqv5JDFKk3SxJyw&oe=6AF209C4"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=frs_XD4Hpd4Q7kNvwFDDjsa&_nc_oc=AdoF6uR0ADxtt9B3w97bgUiTVi9sIEUtnEljPTozXG81QGEq0iwSIxv_phQqHNSYmVM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8Wf_4oRR1nGmtvCwxwHsc9blyDFgfyvXx_RpsdnEHEw&oe=6AF1F399"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aqSLENhVchMQ7kNvwHE1L7Z&_nc_oc=AdoSwCOINNtszSsUQ4ehnK3BT-r-M2ab5PPcKbiycvIY0THdaaj664G1U2Xzv5Aehow&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4FZb4IrVG-XSKtgP7r1db-VOl1pkkSHYPaafVjev5Ww&oe=6AF1FAC2"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9TpRPZx_YMMQ7kNvwEJkR9w&_nc_oc=AdpB8b2nqLISIYTAWun82jWcO_CJrFzxwutwrMD3_EZ42Z80dFodRz_HE
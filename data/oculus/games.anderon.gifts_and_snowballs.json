=6e7a0a&_nc_ohc=S-1j-BzIvJIQ7kNvwFRWzmu&_nc_oc=AdrlHvzJoVNELM_oP4OvKmOOQf83bfDaAE2HaCFVCxudBwgcc_RV-UBXreiS0nSqqs8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBq7uFTXg6fNSMkZOYXzWYW8eQIAe0zi8RJfhzkHqd8qQ&oe=6A4F9E85"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vtdkzTq5nTwQ7kNvwGhSeLx&_nc_oc=AdrKAtSqIyHGdDuDjxYB3U20hgZWB1SyR4JO1ykdjwvHxLHf1Wna8nSNw7SkrEAypKM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCuvCUT4-vypXxqKwLhha_ljqDU_ZnnYnLFbDRxRyDJYQ&oe=6A4FAC12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5mn8gH65JB0Q7kNvwEGsbx6&_nc_oc=AdpueqYqqa8Dc6M1m6usVGN-Z31TdDiBaC05cZ4BCTm_0Ls-7HgyqR2jlqEAkhEm8eA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBA7jOvoWzdcWxg3eUUaNV9-KXIaJv6Tc7Kk6DjhPOEZA&oe=6A4FA904"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zduU8MP8rGYQ7kNvwFo7jhm&_nc_oc=AdrDzXF1Dttw2Czub3VEWxr2HVfKeq5nBoJWyCffs5SHrUc38-XABm64eaeEs4VaX0k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8CLVtNVJLZESK5iXlUNLZnQ4J1wzOiQnjXYF1K1_TZw&oe=6A4F92D9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4jKdJtwyC5QQ7kNvwELSVRO&_nc_oc=AdqebEx79AC7ktaRk5Ox5Gu90KwZcCCYFbwd7V2eh575oAzPWihtqrvoyzaRzmdwHB4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBGO68KUJ0ePVWD1F58_oGNFozAMegeSKIdbKL2sibr1Q&oe=6A4F9A02"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=opzi6DUT88YQ7kNvwEwwewR&_nc_oc=AdroOtf-_tLijoAR-wqx171rBP6FehFtCGymsvH2eK6l5UoyJ1vPc4M7N
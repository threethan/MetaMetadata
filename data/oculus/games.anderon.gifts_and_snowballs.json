-ams2-1.oculuscdn.com/v/t64.5771-25/75286676_577533401544348_4203344657555901211_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ubXpSBE34MQ7kNvwGCHVmr&_nc_oc=Adm_QzESBh_xJglYcMPHzRLqrjl0it5M8dhvPyWPOw4sRItfyr6AnABM4RUrfs7qs8E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyfdnZzpir8kloWM_eEHHxk5PQPGfyFSm1JaFJOLmH9Vw&oe=69AED228"}]}, "id": "2073760636370964", "locale": "en_US", "screenshots": [{"file_name": "screenv2_02.png", "id": "993244952825890", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974853_993244956159223_3665934591366094743_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FCkjBCBulBQQ7kNvwEraVSM&_nc_oc=Adm0aLmp4Zblg7YPD5QB_MqujMBF-UdsgAwlMu-b2J88N-BBrYdseUEa6yW7q1cpUpE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfynEQ_wnwN28YexJMXdtbg0yYL1OQpyTkaoww-fkibAyg&oe=69AEBC0B"}, {"file_name": "screenv2_01.png", "id": "517646341325841", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572947_517646347992507_8365861269156842802_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zIEL2KyZG8YQ7kNvwEo1P-h&_nc_oc=Adlt9EPE4hAiVvRADAM8GtI-yDeB9Rt0T6p4fzvRkN3gZmivYMYHx_UiGHsN9LsyXJk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxEuwthBI12zwKypX7aJui7OES1Gyq93t_nX6bQ-X_aEA&oe=69AEB563"}, {"file_name": "bagarre selectable01.png", "id": "987094796807741", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391822_987094800141074_5341301578934495068_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6hLywjsuT_cQ7kNvwG4qnu5&_nc_oc=AdnuhehUSx2-Ff25V_PD6SW2tespJwBoft0cqIVWh9Gl70phGDQts56c4qjl_WrqbpQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz0vTZXy0XZ_inJLoMWpX7OYjHIjXpdIrN9RILsC1l3Bw&oe=69AEB44C"}, {"file_name": "pinched warrior03.png", "id": "2233739983674845", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391837_2233739987008178_5682748129040869737_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=thzQUfjeqCsQ7kNvwEzia3e&_nc_oc=AdldI_11zBVKFbNN5Oq9mY5sMsbRn2komYM3bAhzdIFJFFb0f9wmbYsKj65LEBIGzVA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzaD0uLTtuVTxTkLsZoXicutQ1I3FOdt3BTUaCIVXLCng&oe=69AEC785"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ETrUao5FuuYQ7kNvwEBlcl4&_nc_oc=AdnRGcAShBLDHrqvTBF4rrMXjS0VDUUAE3VCtBSGKbca4gxDhnDPOg60RkJjsO8di0s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw3EIn3Gj-_ahWm_AmW_zzswGo4LmvDObwhbZ5h84DtEg&oe=69AED512"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6HpnKdFDVC4Q7kNvwENT_76&_nc_oc=AdnniLlWvsotSb4oDykTsedtgALhkdSoGlGTpLT9_3kJJtXi-WRB2itHUvQhPi9es0s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwu9bXl5jNeviyD1zKe2CdRHJvzWIFBwwetC5OsiWTXgg&oe=69AED204"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Zb0naYvegYQ7kNvwEthamq&_nc_oc=AdmB0FxzS3DpgHL3BolB30DDbjU3aj-sABgQvxGTdudanAqybJpA82VcK9plx3V9oik&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzwaHL6VOhUGtEk-3MfwbL_2SS0uIVwBhAaWL2ENQ4MvA&oe=69AEBBD9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l8x-xA6FYzAQ7kNvwHpVbNS&_nc_oc=Adn6-vPT-eqOOfcBvEMRAAhEpIxq8EBuNz9AmByixZ50jeanOq2CsS851iJGLGcMNmg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwq6DQGCDedJVPnSJS57TqxVqY5umProYFWbiMgnou8yA&oe=69AEC302"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qmVU11r5XcsQ7kNvwGe7S51&_nc_oc=AdlBgwq2-1NGcQqHfgQ-G7z2DzQCIACHVT3syZduN6J5tE-RupYJK4ejrHjaEG8B_2M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxZ0Z3A-KXsD2l5
=6e7a0a&_nc_ohc=I_1IIyo8nuYQ7kNvwHPRtUb&_nc_oc=AdrfDhcZNgJ9qt2AlQCP6zdtgk15rKcPjJYlcZsJyFogPYZuBIVhqpFWKI3n-zWi608&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-elYhcE5vS5xY35y7E2vd5QSaodJ3y3hbQ5MY6b1t8OQ&oe=6A451285"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iqd6HKRNiPQQ7kNvwFPZqRU&_nc_oc=Adprp-Mxt9JEPLSCwy39b8WkBL-3dYaYkcO5JLa4e0eMsczT2N9TFxKBcoEybwfuOJA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Lv4sV93jeOT6wQnkRTeCrNm_1NbT5nHsTQtF55hqJ4A&oe=6A452012"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8889ieNHbKkQ7kNvwFObEFW&_nc_oc=AdpZLlZTKiPFoRjZsb3zDSjKiS2SwcV-DHqikb0_fe_7Jx5xA8rwiKGmpnpFKODydMc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-T1CTq13CPgyxQtlIh83iAcNR3DENo7OQhEzbbRN2sjw&oe=6A451D04"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jpQyCOxRoxAQ7kNvwGFNA6i&_nc_oc=AdoQsWfKtOkc6MEWePNJO3kr8dNSBChJ2i_-raFuZlKc_e5wIvAikk4DM1ypgxSUVxE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ca3hCaGKjanw_eeoRXCT4S8GJZ_fehCT3W23AE91EnQ&oe=6A4506D9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xJCSg_dAlYAQ7kNvwERFfCN&_nc_oc=AdpWgm7txf11DJ3KvODzk4w58BSnUrYGgx1EH55a47wxoOcIpW6Pj7DR9q4-Z7EGNOQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9iHYKBc2X7t-9u8R8A_n4E2lYVjpCBcFmGZZUvK3_7Kw&oe=6A450E02"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=siL7J4t4jgAQ7kNvwFV1oht&_nc_oc=Adqh-27fNUGkFeBQRxc4XKPKwOMVUVSkVjHRhpo-Dk854M3pFStSybv1l
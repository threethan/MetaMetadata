=6e7a0a&_nc_ohc=dtD5xESWOjsQ7kNvwHxaKY_&_nc_oc=Adp6IwEqu1jE8uTrSgmCQI9nw3of4MAla7yv2wEZm2AyP94kaZRqQ4RsEFL7OtPSYgY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIpmbKesh4L6ty8FDVG_LZgHL-NKY-CjApWlKGrLkdpQ&oe=6AA15B85"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a2SDcmSG1JoQ7kNvwEHwEa0&_nc_oc=AdpKfQTjxRpVmbnMhXm6uVUR9gq_P922UOVEkr-jrIPpvispJhg9gimDtzhSFy3LHNQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-g9Co0gnZUmjdJ1JLrg0UGiN8RHLOPJlKsjOlKu0F1A&oe=6AA16912"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8NPrG1L6NoUQ7kNvwFMWRa_&_nc_oc=Adp3NSjppVXI3U0k7fwSmIUQ4rjSHrJQQzY-nQvVxRX_u3wdop5YcQo1RIRDkKqumis&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSlhE-scr7dvU1PsYeJcjTPAF6BdCVt7fxxMIZyRUQzg&oe=6AA16604"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T8UcrmCu3SQQ7kNvwFVgOIR&_nc_oc=AdqM4cS3WJnkmOgs1ty5J4p99091JIDaQxIORw1l8OnWK5v0LvLovL_69qsTMpbH1as&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJiYMeEPkAOkLtLTD-kk6fBJ98WIBO5tPSvNSThn5loLg&oe=6AA14FD9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nSz7fgO9eV0Q7kNvwHb3JGi&_nc_oc=AdqqNomB6RKcBm4-6xNZR1sd9pFo1nGI9yyw1SLnjReclbodrfHy1VZ3eK9ukI1cUgg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIAJa-EPtmEx3aCN3cV0xjzZYCByr75Qk26stFWf_obKQ&oe=6AA15702"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CPEp7NWF9HAQ7kNvwFCDKFi&_nc_oc=AdqP0RuaNObxPvhNmty4Iq4D35Q5cEnDwnsKuJkcs2c2MqhOxU6CFQ34z
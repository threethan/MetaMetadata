=6e7a0a&_nc_ohc=DS2BwO8xm-wQ7kNvwEiAC67&_nc_oc=Adpo-WB6OZKB7GNc4wKQn3rX4dHN8EcYWbDtnS7IppTLglUl5j6Lg3QTNNe3bDZU8Ss&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2sJ1pq3bDYE_icXEtQ2BAW69lC5kE6e7CVt2mIo5ZEag&oe=69E62685"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6LoX7LqJJKoQ7kNvwFJCTPg&_nc_oc=Adpfdin7ma0Vm2aDG8oIFkCF6Ek0UAK8LnKBB4hF3CXXjHLOadUg6ZLtdTGBNP1v8Vc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2RK_rpwSrkgTGASk8Jqz62pjMidYU24utFu_i9UAdE0g&oe=69E63412"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_0Dz-khOfmcQ7kNvwGjIXsd&_nc_oc=AdpNWfVJhIYWzkOx1vhT5je_3HDXNBrBfaFlRYl8aNPYmsPVf_v9FKaEz9xiH0-PXpI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3rmKooBysWDvDv1Z9Jn5EI3SIJFUHJdYKDSyFv1zQFQA&oe=69E63104"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YrgruFr7e2EQ7kNvwG2Dnif&_nc_oc=Adp5kMultqX-D3zFpS0p2UJr1b8Y0lLBpFs1MpkV54s02mxBL_h_epWUuVVXjAdLjrQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3CwWJW-GkK5lCqOifgv5QlwaYOoqBzK76To80tUO02Uw&oe=69E61AD9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_vG-uinOeCQQ7kNvwHhgLf6&_nc_oc=AdovPhx1slRFzxxb2ENoNQRqxmAP9eZC42ANlOnWc0LFriRCeBJw8hnW6Q-ZvBrE2Q0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af16S4w5t_cEIOV6hoGJ7c3oCbV-jj82v_QtpMJbQRjqRQ&oe=69E62202"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y3EO7PzMrwYQ7kNvwH76KPn&_nc_oc=Adqv7NbYyiXLHI1nXv16lyAxQ2LyqzqHVMvRE_IvfywpA9ewlQ8coQKd_
=6e7a0a&_nc_ohc=Nv1mH8Wj8wsQ7kNvwGkvDHE&_nc_oc=AdqTzzcfpF9GoVZmN3MOOZ_mYUmW9kaeBExNSpSIz7JDP21rNPaQJJgFySV3xYN7Xr8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJWPLq-XuTXZBzMYKaMC7cHDxZg_Cf9Wbh1iIvnaZb8g&oe=6AC8E885"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zF1Ls_BUF9QQ7kNvwEtu7ax&_nc_oc=Adp3EKbHfcSgKZS1I1EsB-gsAsgdq9_YBkBkBOAfsAa3SdzH47VliZlA4lifoOZgFyg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO1sB179WzvA94QAkXnzdnHVcSeDEmg-WSjDUU0Mf2zZw&oe=6AC8F612"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6y0X2PhiYQ0Q7kNvwF1s001&_nc_oc=AdoB9ynf-mSqjCakMKFMUM4xwjMb9iISCGgf5XfQAvptHm5oiZ9hLPI8IplNdjlRK-8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMj_2h0AlxVAnsTt0Pa9YTfQGWg33PJs2GWjnYdn9z6uA&oe=6AC8F304"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QOuTAa2nsW4Q7kNvwFN46PP&_nc_oc=Adq6u_EM5cuJF2I86ICTkITdoPb0dYlzODiPJtQ1I7px5eVLh_di5fjhrTDTjNmMoZc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZe-YsIFtghyiHkXLo2J2L0exgrgDatwyzjBnkjooElg&oe=6AC91519"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GZtyMDwx6ZEQ7kNvwEgpJIz&_nc_oc=AdqKaz_b8HZ6tkZm1GxbSfSfIcQvJCPTC76qJjc2QZyTQREGCSOoPjOf-j_BOaILvok&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPhArhXDwSwCNZMk-jM83uU2c6rcXqbS1f2u3WkkRCRtQ&oe=6AC91C42"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JCmRR-ykv8UQ7kNvwHceu7I&_nc_oc=AdrDfhxj0Fu89xQAT4-MfCvYV-6FcDiNTh1t2GdzIy81A4CS5i-Zm98W0
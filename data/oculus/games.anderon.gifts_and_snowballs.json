=6e7a0a&_nc_ohc=5BSk01a-d3EQ7kNvwEEj5XW&_nc_oc=AdrPhb-J0mm-x8E86jzj8jWyhXilhiewc4CSzd_b4YyPuy88V_PgffcUZyYC0RHgGY0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJhqC2VpmzG3Iy1DviqXPlHvkXTQpnj6kcxP74Zft7GuA&oe=6A9D6705"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rQfSjjofFQAQ7kNvwEeQcPe&_nc_oc=AdqNYMHptbyKSyKsRK1D_y2feYdq7_o_FGK-b4VUzURdOmgFXkACRDrTlByT9PMmAPo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBBdsQs2-AA5Wu48rF0TY_aG69I8jJmpIPiRrtg_M8Rw&oe=6A9D7492"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ot-gT-LNNEcQ7kNvwGBWKmD&_nc_oc=AdoNUalofgxwEm2d9uqkLO6xHOci95P-4dzbrUONLYlmbVydJ3qSBWtO88RIMGrVV68&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJySn2CE5sc4sQnPZNJ1zcMkUNU3_00GFjf5rcE89OhNQ&oe=6A9D7184"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qLawT6b3PlQQ7kNvwG7woP9&_nc_oc=AdpQIdhcITcWaoOmnrGFI4nhkq49HUn4hVtL8EOkfvExylGDibt4uXI8gqOGw7pkXzY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJg1VbFygZZXA8URtHabeGiKDCxwPznyzETgSyyCkXlvA&oe=6A9D5B59"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QwNRY809WggQ7kNvwG3JfNF&_nc_oc=AdobaCjs7r5KT7Hqys3Uh4ffI0ODbJJ8QzmbvWL4bQZKvAqncxKxE09vsj7fettiZW8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ53bCgYwud4khEVCkr23P3ic557Y4ULx7dpze-V9XTfg&oe=6A9D6282"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XB_HWhyPcjYQ7kNvwHzDc8M&_nc_oc=AdpgxZJ3UGQImxH-rptxHQsix9mF4vKiclQowtDvQz8K4lYHp2hleN0qG
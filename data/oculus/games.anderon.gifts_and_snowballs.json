=6e7a0a&_nc_ohc=EMWS0YS5vf8Q7kNvwFbci7M&_nc_oc=AdqKGe6QEV1-1YdVp6iO_CMdlAn3EqdXEsDny-CJsO7W9kLbdS_tu9DItPg3bFsAUNA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPCofxvGak1Lo0lVmTGRkilRLNOoSVt68dz5RXqex6o_Q&oe=6AC0FF85"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zdnJrudqSNcQ7kNvwFNCtqA&_nc_oc=Adp854UnaP4sUIxzl0ZA0ptTJliUjNBDMj0ml1rICYDoA-Y3SKxe_sjYZYTglEM-204&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPr8mh6o9m74bB2PcOYgYl3601TDF9U5xjpYmh9Kontiw&oe=6AC10D12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0q2Qt_1jta4Q7kNvwFMYNAs&_nc_oc=AdqNGLw-MP9sYLT99ke8htAcJjRkDkIlS5ZSODZpXStw6PaEP2KtbRBGsovNikMXbsY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOjggmUq69HeDsZy95eoX824031m75BYJwP7T3FPz6JfQ&oe=6AC10A04"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ms2ouIzrXnYQ7kNvwHueH_N&_nc_oc=AdrXgqn5pZdNJ3SHX3EOdWAXrqGH-QEh7m_O6dFKhl40f9zQTwacrzyjj3Sg8kthRRE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOiMgykA142CFdu5ywZaTT7sGf0OqbJHZc1VfaRqisRGA&oe=6AC12C19"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ze4aTDG1Ui0Q7kNvwF_9QvE&_nc_oc=AdrRKzQXhhKYYmb5XBIsj9GMv7fWwquI5dZifmub-seurNju-aaN7FfctbCf4suSAkw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO5HSu0kmoO1crBkeruCjjDQ25AtZ32R1fYY4tUvwNQ4w&oe=6AC13342"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fn0LSWMCrn0Q7kNvwF2aNEV&_nc_oc=AdrVbbuqxnwTMvjHFGtTlMjCJYtu7f9N2p2a8txFgLk-YCSTuQPBFXfvb
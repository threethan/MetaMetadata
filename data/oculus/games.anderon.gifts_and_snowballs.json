=6e7a0a&_nc_ohc=dDYR6YnUsP4Q7kNvwEvjukt&_nc_oc=AdrooVIMuicpimvFUzGACTc8O-JbnlOzV1h7BMObGGjEU_ygHhV7ZA5YHGy__qf9OAs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7FXLIT8Ze7M8d4-gUQJDYKNIs2XjUfOKvI1WcW2t7ULA&oe=6A1D8585"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pogbREDvEa0Q7kNvwHSd3Yu&_nc_oc=AdrqCaogWhTYStmvhcLx6tWWBSk_TJCcWi11QZ7q-35SxS2zA2iW-wd2JhqwZh_kJMY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40r6VGQ9TUg5uZl_RH8vUp5h1mWCwlzPG17OgxL5Z1uQ&oe=6A1D9312"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JSCxH7y5e9YQ7kNvwFuqpHT&_nc_oc=Adq3BC_TR6ZMw6ahZqOtN7uR6R56iq1O6titz3tXkJaxQCXjDQ0twVteeIjyOocvMVY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ymAKWbLrjpDh9uaKjKr1_jd0i_qydwfmyuGDJDKEvwg&oe=6A1D9004"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y4Ln6wOBs9IQ7kNvwFIJJCv&_nc_oc=AdpV_4taszKnaLyGfwx6yOONBBZvxpCaj-Wy1jQhq957UUqHIkNhTJ_DslhWhMzAz80&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5FxceqAPHwcuwqTZkzkZ-HKyq6VD_5H55ilBlynjd_Ow&oe=6A1D79D9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-EGbuqfkd_cQ7kNvwHu3pYD&_nc_oc=AdqikFMiK3JoMiwE6MoVZKDS4OboxkLH_AEfFryc0WlcSr61gi6tqOUo4Z3bNiOluns&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qNjXHultwspGmO0KISYpKk65_RAvNOxvqyda5MyvbCg&oe=6A1D8102"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vIVNn_KubI0Q7kNvwGizlvd&_nc_oc=Adr2kV3Uend51m5TFBErTXuQGCEH3gG6uTZIxfFtT6BrJ31xOUSY6933P
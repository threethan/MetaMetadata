=6e7a0a&_nc_ohc=2SMOom0toR8Q7kNvwFjl2F2&_nc_oc=AdqSW9AfmEiHY461awW2_3jHApU4sYwAB2foNMfrVyKbZxZWoYIe6mGHRP-F8yw-P60&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxQS1Ww2xHz9PROxE_atRKIwd1RLwt2iYjf0gMgaN3eKA&oe=69C7D405"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p7ZJrr60zrUQ7kNvwHASvE6&_nc_oc=Ado7xv73o5uJPx6VJLnZqWP9lefr5SGhDvJ982blMoSAGAxcQcCwyvz_youIxH1MZa0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyvzvgO9mwq5e5kqEBK-Sv2Jjp27GWdNh7cjxwOnCVxDw&oe=69C7E192"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZlidPbaD1cUQ7kNvwENzrKd&_nc_oc=AdriwnE6FtuDKu8443ijnUgt2Yp9lV9PfPSHSgsPZcpFIkgJRRufjavZ60BHiQP-1BE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxlQuBeyqgF8kk6vM_slYrgFO4MR5Ju4afWJBW0AF_pFw&oe=69C7DE84"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GD5Qe1PZC2YQ7kNvwGQX3eD&_nc_oc=AdqytR-LR0mFC2iR19d2eMOSxGdPXyv62yFw7uxoTg-IyYh7D2bRTo-TKGqJTT3yLAk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwME2XnANwL9WJ_NPRlN1vmFuq58eGwA-jMiBCg7-y30w&oe=69C7C859"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Ks9CgvUjRAQ7kNvwGmyYR7&_nc_oc=AdrCQLYzZ2u2iJVVMVXNy3X_FLvgBu_i5mg0KLZRxZVfokJF42wlloWW0AFqbQHdFUY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfywyzTANs0VqK5f6eR4BTgSho61e_f4fYLV6so4Bc2a_g&oe=69C7CF82"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EPFdbBei1vcQ7kNvwF-zvAf&_nc_oc=AdreUQhND8aroN_yo0C9myVA5suC39ilNWl02caeT50BDqxK4YsNOb_rr
-ord5-2.oculuscdn.com/v/t64.5771-25/75286676_577533401544348_4203344657555901211_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ulrtC_VQ4N0Q7kNvwFA0h6I&_nc_oc=AdkzwVCRFD0Czjca28GlR2NnRdw7YkHrY6UeL4bi3Aicii8L8PHhu1UUIox5X88czkc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz6d7UCpnlavIfFiWuAeR-2Xj8nTe0NyW5KMSMCdyAPAg&oe=69BC0128"}]}, "id": "2073760636370964", "locale": "en_US", "screenshots": [{"file_name": "screenv2_02.png", "id": "993244952825890", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974853_993244956159223_3665934591366094743_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xRz8nKEK7K4Q7kNvwHi306F&_nc_oc=AdkK3vDfed0ylTGks3Rvc4_Mi-yxLd17I-6eQVT8LCjpUsE-eNYSrq9Cnn_31ClZIcY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfypYvvjUziL-U-QiBvCDNrOjLMRB9b2_aMhZzw8f8Xu5w&oe=69BBEB0B"}, {"file_name": "screenv2_01.png", "id": "517646341325841", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572947_517646347992507_8365861269156842802_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VgFNCSb8AEAQ7kNvwEbpDFn&_nc_oc=AdknQHiiw6u_XZIs67SIzl47e3FAUQkcfN8SA3h1d-BKtal8CEDUTfETpE7qMMso-0c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afw6smsQIhyk0BZwqSFrID5oWLSU4qoOmkV5cLN8tngeBw&oe=69BBE463"}, {"file_name": "bagarre selectable01.png", "id": "987094796807741", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391822_987094800141074_5341301578934495068_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J8BM9rRpmNsQ7kNvwEoM3c4&_nc_oc=Adkrr_XMhNZL3jKbKRdDL013j3bWY-WRVFnQDOwzcdQOhE50SekiHG183aheJ-j6lQw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyRLQ7eTMhAp7vLNJ81jlijsbpbzsJ2bh5K_nw_XhX7tw&oe=69BBE34C"}, {"file_name": "pinched warrior03.png", "id": "2233739983674845", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391837_2233739987008178_5682748129040869737_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ipD4YbJU2bIQ7kNvwGMVeMt&_nc_oc=AdmJcGdx_HBNK4hDaJU-LcwnaLE-TWxnsHipjyhk-mRVSO5zXUCJgNfl7UHsVqfMKgk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afxr3CfWvPK4Z57sCOLB45bqKLK3TdNmnPZ9rqEkLHOxOw&oe=69BBF685"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EDqWWVQH6x4Q7kNvwGUXZHy&_nc_oc=Adnc4QBV7PCDP9v4AjeEEJMBrnawlhQ4fcalmJMmVg4GXaryWfahzNqiXHw33oXmxT0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwlVc_oVQtspB46wZCO3KLamv_BeZyL6WqfuBZiTl4j7w&oe=69BC0412"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W3aDKgMQJnkQ7kNvwFEO38U&_nc_oc=AdkO4RGAHgXkIQhmbDznkEq2ZBJI0nCKirErL34h9GNoMBRR3cjmus10ChyYIJk5c3A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy9dPtk0vWlFmWFMfQq_OWUvi6-U3D-eOlSi7QybLduOw&oe=69BC0104"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JBYDVHAaUjYQ7kNvwF9bLR0&_nc_oc=AdnYYcd5bYyAd4pt6vw7Z0KB07K-CFaLulS_Pu5ZEPT4LsmcLXLzXQ9R3kziKac5_zs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwGYID-YrUkU6Rzr4SbnojJapnA1RBq70AM5J0tTIlluA&oe=69BBEAD9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QM40X9AXKWsQ7kNvwH57-EF&_nc_oc=Adm0YU25Efh6zE4kHiPFp0lCZLw8Q0Jrxd_kW0y_ioH2TSMl6_2qI8iwICZ1vBeNblw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxLxWNwWqhIkqiRKywxCyURXsBYBgedMg2Gsd4VfbgdNg&oe=69BBF202"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H0a1xCroKj0Q7kNvwHmi-WB&_nc_oc=AdmxjcPe9ZanHGE00X1GuK9LiZ10yrntpIWrk3HKiC3fH6lzNdNInxx11sRz1Gs7Y48&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyT5OyoywbZZCra
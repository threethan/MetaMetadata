=6e7a0a&_nc_ohc=BScGAJy33mUQ7kNvwFtimKI&_nc_oc=AdpflyKX-NuIsc9jV5Pr8fRrve9rizpOraFg0V3Juh8QldACCReAGIu9-45SRQTgWVI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_CZmXJ7j5ykB6vs9c9Hn1Z5AQIf6jk4Ck0LuwWU8W5w&oe=6A6DF105"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BI90TUt8ER0Q7kNvwGUUp04&_nc_oc=AdpRWMW8E_ue6exkbeFbqjtDWnPTxAFd8KWl3sDJDzUbkhMgEQQhMQ_k4XqdPEWbE10&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXkXRV2XL_CtJpJZsvN4JoMPo9yg5u36Ne67yoEwK4gA&oe=6A6DFE92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tGQTZy_ps8QQ7kNvwE55Zy7&_nc_oc=AdqvTMahHWiNp-p46i1NGO8qLyDjlZz7XjStmKyVsVBiOJsNmnlxi-3hMmDSL_uQrBI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxWUCMButV6Dap9sVxmPwupGTve8ffAUHySO8GhreZ6w&oe=6A6DFB84"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aiRSKQicRrYQ7kNvwG3BRfK&_nc_oc=AdomDG3WIKCavSSTXLbU3c4BA6qgm0UjkV3AHZe7NdTGDuQV_qPxW5u_3McYY2YIm8s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDcbcpPLtRHLhXLG81yb-EILv5pUZapKfxLY_3UCJaNyA&oe=6A6DE559"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4nH2e29f73AQ7kNvwF3mX99&_nc_oc=AdoU5SnY8-vGMYTMA0cJ4h_Ox5v4J2G0FXlSAVlmRVP0G87IW0Lbbjo_RkKgVSLb5KM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBAkKn2loEhGlrKGb2o-qtqoRrhykaqP7sO5WmS5teXHQ&oe=6A6DEC82"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B6JkGPbR0b0Q7kNvwHIDLyG&_nc_oc=AdqNEOLnsBhsthrL63PdmkPFWOfpV0NG33fVc0YKH97pOIHu5cTFPQRQE
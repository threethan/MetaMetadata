=6e7a0a&_nc_ohc=OPaSjPl4lOkQ7kNvwENAHuL&_nc_oc=AdoxyHlMXKMZALlmDh4FUD8xOJiNUfHjpUc91_MH9lxEjH4f_2FSbNGwXd_9gNQDJok&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ4nomCBXikFMQVTj5AWo1XZtt3k409GPa4esqDnOe3bA&oe=6AA6A185"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iVzLmt6PQO8Q7kNvwEV8eqo&_nc_oc=Adqvu0QsCGDmWphSylTrtQAR9DM5NdyQs2JR3MMBgwWMg_zJFGkyUCXrHKAuDJtma-E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6o8vtr05C1KjvDMcdJGOc4WraPPiWT5qDlbJzcakzDA&oe=6AA6AF12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZRlgfTPyjZ0Q7kNvwHHdXLY&_nc_oc=AdpvfTwIvkKgjHVpAtbbsE3zEV_OOkEV-C6HG-jP-Lg4laqlPEq5-JvNy7lwEYDGKN0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKn-HrCCZNzYeutWMYFm8WpMebBr3eoNX1Nfk0One484w&oe=6AA6AC04"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tCdzRFaVfFwQ7kNvwGDg5dD&_nc_oc=AdqQqxzmOQUDcO8GY7-fmY57UdYGCmeDtKCnzjWA2wqyr5bFJW0maJcP6Mr9JBF6T_U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ024pbQdxPktjZLjSDP2LYrM6819jfCJIAhWPrtbx6bg&oe=6AA695D9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3TiFGzShbKsQ7kNvwHrhgx3&_nc_oc=AdrZRZt1R-oJgsy9sX_1y4-mBLTR5fSA1xopd6fzICK6Vujp1pi4xIplQnzND9yvgDY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK09QGAQIuGZz7p0XoFlJVIeH9WDaxKewFD7-8auJ7uhw&oe=6AA69D02"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ADCl6zbjrAIQ7kNvwEcIucO&_nc_oc=AdoBqiels0UesWDUNnOZX5ZpeFgx0S2fsZnQzyRaHUn6N2sTxd9BRKuFx
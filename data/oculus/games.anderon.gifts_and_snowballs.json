=6e7a0a&_nc_ohc=LdbCj6HoSeAQ7kNvwH21Xk_&_nc_oc=Adpq-xeN2iUOc0RW4lIvpKKJ0BbAf03r4G_eBPyPXFW0G26iJfp7MqZvD9mEvGA7wLc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPyERACcAtPKVyxSR4xkHlVQUOjlMjdYxZSd7jZlKkRwQ&oe=6AD0D185"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NMs6U8IwaGQQ7kNvwHBr2Ku&_nc_oc=AdplDvnqo-l_ZI2dVfZRdIOtIcWkBxO8AvkiTqezMVr42pMOpcXh6iHxCU-8G47QKMc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOGLs9J23bTwVgL5PbgptnqcROEzEfqaYoPoIqsQJjaAw&oe=6AD0DF12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aToysBFH-FYQ7kNvwGxffTF&_nc_oc=AdqCIDi_gHPNaB2e30VxFOOeLBb9u7hdrxpRnjFlNESMxvAXKdt11pf-oHvMSMEXb80&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPBL13tC5RODGTjNFcYYuKXv2TZlP9pK2AH7CpM77gBxQ&oe=6AD0DC04"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IrIxAUhe6ZkQ7kNvwEq7an8&_nc_oc=AdoPHQNDikAlWynMYDNHkBAVeVgMgrxwaq4T-NSaKEhmeokclqlhuL84G0jNxrUdqc8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4IxP4_RIz_pZyKxlYf5FnOo-H0Nn5cG_9qAvRcnJAWw&oe=6AD0FE19"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dyEJ5yonysMQ7kNvwEz90oY&_nc_oc=Adq_v88eOMHQWiw_6yS1BTmoMm67EMA9dH2BvUX7dqdLYpPO_nIP-28E5sXewoGqyzk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJs5olO7W4-9F3Ka8nQhTl_CuRD4PHNqAV6E031NVJ1g&oe=6AD10542"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8HsSD52fGloQ7kNvwFeHQfQ&_nc_oc=Ado1EXQ6P9Q1S3pjo1s_9Td6-mJqP_aqc_fPSzjFgZkpS8oKG3jHyhCb2
=6e7a0a&_nc_ohc=pFKGixA5-TIQ7kNvwEEZi-t&_nc_oc=AdpBrzSdzI3LlIAzo46KBJqxazRuQAQF-l_taazE_nMh6RWsqSt4Zcp2vNR1X6Cmu10&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af30OJ_1b9Iy2IsA1fw63Nd4lnXE8Q5hY7l8mvb0_zWK_w&oe=69DB9A85"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xnnHTzhkf4sQ7kNvwGBJLyJ&_nc_oc=AdpWVOr5AimCQ39X_JTvdxk7NbhKbNguLdGKEF2fRNm06ITl9ZGMXosPkcRls1iZFmI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3-IodsiSw0CjMsDgwSqCfx3awr-fmAEiBO90Vcjg3d5A&oe=69DBA812"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ZFW6L2PqEYQ7kNvwE2eWNI&_nc_oc=AdrZBPIb9Ipupe6TVL4cwIAolkCOtgx1Zm7kq66Ynlm_zQEEPmNjQrXYUifwjh_Px9U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3tSlM3kaWPmYs__hhsyoTs5HNATD-bL2qKT1KfuQqz-g&oe=69DBA504"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JJ-hzLRjnqEQ7kNvwFdg3qb&_nc_oc=Adq5i98RoyBOaPALJfzXdC0LDV4-sUkWacv75Kzi6gwy7ZVnIAWR71hIcAkBZkBcI0w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3pDY1ZjY9YOWyROE1b-VksE7mV921S-cTwqw-UTTTocA&oe=69DB8ED9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iQI4bImZK-kQ7kNvwHV--t-&_nc_oc=Adq3iHoR48APEpPmKoMUbdGyBeod0iGzaZxvOR134NtofxN1kr6agElm7axV8_LapPs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2h_Iye2FDHVfBWJepcrzzf8C3f7mg2MmF4pTdjCv9D9A&oe=69DB9602"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iuv40M-bbRsQ7kNvwHzoFeJ&_nc_oc=Adr6Za5l6V-wRE0cR819ohCy4FNtl6euLH9aIgdebLECZj72nsGZMvl9r
=6e7a0a&_nc_ohc=Nv1mH8Wj8wsQ7kNvwF9ljeT&_nc_oc=AdoSDsGY2eBvmjHj6m9gH2MlDBJIk2OJuFRbcL9ri5ctaaRnfTeLIErn6bhVGnue8Zs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMwEZDmbI8eO0JvW6Ycbxrww4YjQxUmKa8Bc-u3w9K1Cg&oe=6AC79705"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zF1Ls_BUF9QQ7kNvwH4kNZE&_nc_oc=AdqxdCyNKsnlZgcquKpheEwwkYCkEkX0lcSi9sv0FLKA0gUhNxBoTmHpUmMDYqnffL0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFYlLEF7Mmvk1PHkMKSe2qHM14--7qxwodo4hCQ4yUew&oe=6AC7A492"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6y0X2PhiYQ0Q7kNvwG7mHcN&_nc_oc=Adog06BLPGQ5Oby43GT0JbEwzw7e8fHvFgCL0d5qt33xaD5C8c1WDJ6HQ6s_kSyzi7U&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMhO4o6vF_ecGVPRw_ZxurthGiHUViM_HZnGBlqfbTnbA&oe=6AC7A184"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qo0xR9XZPOIQ7kNvwE1LM45&_nc_oc=AdrsMzZhp9WZ9dLEUIxni61n3pNroba4IZr_ARVHMGafGjNrd6htqTQxmA5R3UGp3Qg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOR8hCBL-NVz_YR6doA__83MJ_kxYHWJ-ceoNX0TC8kgg&oe=6AC7C399"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GZtyMDwx6ZEQ7kNvwE3-IPI&_nc_oc=Adrfp0Q9nN6Grj9V9cqAG7O3bGmai5oT4VVBag8qsuz5Ewm7txOAZfzIgRe1ndMj_2c&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMdzBvapB-h1giIRTdx7jkDwn7IKl-qvY0Xo9kJUl0Ysw&oe=6AC7CAC2"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JCmRR-ykv8UQ7kNvwFa2JRg&_nc_oc=AdqLn27d2ij_M8rIJ17X6-GVBhZg1wWUj6Mzb7o3dMEvPL1gG4OFBY8Wz
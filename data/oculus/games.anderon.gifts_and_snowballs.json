=6e7a0a&_nc_ohc=tQ_PHyFGFKUQ7kNvwEq_pi8&_nc_oc=AdrRIb0SwRiXg2V803pVHvPdBNRl4D2pOdtFhtjhS0sxTrGFbaEd92YJmzYuX0QR6_c&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFTtsxKsBu5Z9iOIcllcDw2awnIgDupcIIL2qft5yBW-A&oe=6A884F05"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J4HVc1djTVEQ7kNvwExiIgb&_nc_oc=AdpOocr-PCsVCPdzNePMTpYH-iZAzt9VyFMwHEvCR0tfpC8D0b2igOZ3R3wwLSPcbgU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGpLxMrUoQxHThYrdyus3Y1gD_jsDyrtTscFKCuGQ7qfw&oe=6A882452"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ClAMJe7mVBAQ7kNvwGxClpD&_nc_oc=AdqoeqlBlDVuV5smGIk0om-LsPxCJmDhgnSPm62ZbDDsEQVjcjwKrbzYJ52JJ2au290&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGi3WKNwLM2bL-gh2Wj2zY6JvzaHzeb-uo4TP4Cl9a_tA&oe=6A882144"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JKcNeEy9kWAQ7kNvwFt9xQ0&_nc_oc=AdqclewvkzGEBzpMulgBnNCW4PUEgJacLOr0Ell46KVXU8Bms75-mLz1pVIJz7qhDQ8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEyjpfBm-XaPhAq761pCea8Iltv4q6kHVHojipGTjFFWg&oe=6A884359"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GFb7kU6BjZsQ7kNvwFKxyQ4&_nc_oc=AdqbWHAtrd0GssykP9ysPX75LHh8IUAO4U2oVtPi9rvF-NwGt-k6TImnkVvHVGD0qJo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEe-nWLnFoy0R9zqNBFLxtHLDQxJ9EfCIsM17c8-jDzaA&oe=6A884A82"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AGU3OU1EwQ4Q7kNvwE7fdD4&_nc_oc=AdqtYwUkTDMnc94hsZcoO1Pwe3yy4WYmXbLRhRx9mAHeEABsF7l4R8S69
=6e7a0a&_nc_ohc=qsTz_5KPUjAQ7kNvwFaIT0u&_nc_oc=AdraMbsWbGv3wb9G6Ej0Offzt1RY_NpSLUINwmBZqHCpNeY1gQ_PA5vpogS5J4I8yqs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0OHfcY4PO9F52Ge5qqZYj1SkQNYC8y6jm1ng0XyeGQg&oe=6A79CE85"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LPRwzHJewD8Q7kNvwGcIdOj&_nc_oc=AdpTiB-aVzD2Yuvx2jkVnU9vGJdboD-wzwduCCkI9Xvc6kLizN4j2VZME_WF8lg4trg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGai_vgrIj2mCfUOa7zLhBxua5-QDqa08E7leX3xc5EZg&oe=6A79DC12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mMMtCGyQTeIQ7kNvwH4wYJT&_nc_oc=Adrl_rC_XQFMr7VJv0YTY9HnocY2WHcFkg4ymKqJj7Mx7tOdckUKefMWEsSfUjSHV8w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFydYZ1lGxzPE115ztWdHH8fBo4NekYan-sTWcLSRXcBg&oe=6A79D904"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s90H6M6ygvkQ7kNvwE8OXbm&_nc_oc=AdoU-Pa5shzf7Bd-pz_7HyPrCIBT_Z3WelTSMSKzlUV_NVAiFWF_EbY6J7u9vMB7Bys&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH2MaBkciNWMCpEe0zoEFHp7GnWhdQ_Gvmp0M63QZ3sIw&oe=6A79C2D9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XqU3Bv_QkKMQ7kNvwGMtysa&_nc_oc=Adp-qR6TsywM2VkGP6D0zIDyfQk5yDZZPdAodFP_Uh5oxt81LKYoHQZPOcQVNCR4Bdk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFog8Xy3XMgrWzuMHZWckYPzYWjvABRbwHORd88bP81eA&oe=6A79CA02"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wZU2FXh7fmcQ7kNvwHpB2fB&_nc_oc=AdqfvIi6toff8bVxDcUur-VNRBKnKO3zG6M7MWgLqPfWz94QWL26E5ZQj
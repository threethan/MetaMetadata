-atl3-2.oculuscdn.com/v/t64.5771-25/75286676_577533401544348_4203344657555901211_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ulrtC_VQ4N0Q7kNvwHmcUXE&_nc_oc=Adkt1NLlIj_q5e8t5xa0sDqJjLoMnELxn0Pp0YUA9rA_bxhxsPDQ9qM1TJg0rRITphU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyY_LqF15HdRzVwoRqF0iY0Xae3sCZOnKMlNwv0ebK3tg&oe=69BAAFA8"}]}, "id": "2073760636370964", "locale": "en_US", "screenshots": [{"file_name": "screenv2_02.png", "id": "993244952825890", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974853_993244956159223_3665934591366094743_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xRz8nKEK7K4Q7kNvwH8nlIY&_nc_oc=AdlZurP7NTdDev_xztnHxT5C2SgDW7MN28YoKsoyDGUpjfjRqFOEnSsYtBBpLt1JepY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzHg2_3R_lgtiVR4a8TLSIRXJmygkX6yKp4-UqrLqVijw&oe=69BA998B"}, {"file_name": "screenv2_01.png", "id": "517646341325841", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57572947_517646347992507_8365861269156842802_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zkv8iXVZsxIQ7kNvwETZnWP&_nc_oc=AdmNKgy1Ehx__0AmJI4wllEGjyu8IdIfEnaqZLbCam1m4rNnZpuPiIStvPU2tO-anlg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyOit-9ki6RsldN-z6L3VAAyv889MgqYGhh3FtNSRgwDA&oe=69BA92E3"}, {"file_name": "bagarre selectable01.png", "id": "987094796807741", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391822_987094800141074_5341301578934495068_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J8BM9rRpmNsQ7kNvwElR4Hc&_nc_oc=AdlkwCh4L8ijZzRXoetCiCRuTlMazAS6BkdEawAfsuDV_doBhSCt4Bw74pZQ2gIzZG8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwhWytvtGwU8L6WlLGQnpaYeKgrLbNpGxeA7RtYDCiVag&oe=69BA91CC"}, {"file_name": "pinched warrior03.png", "id": "2233739983674845", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391837_2233739987008178_5682748129040869737_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ipD4YbJU2bIQ7kNvwHe0yHg&_nc_oc=AdnRgyfUNW_ynzXcSTXwAbEktqMDEiugv8ECnk0Qj64UdxAYxGJ2LNVjXWfeC2XnMU8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afx4c6RkNa-s_4Mm_azGaqjJfsCrT1G-RTgBsnTEyi9U6w&oe=69BAA505"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EDqWWVQH6x4Q7kNvwGj0Dz9&_nc_oc=Adk8Ho_l97azQUv2L6uHT8DYkfpAVRi4w15PUEF2kJ-9pSM4AZWI1bpKwTWke-VCpTA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwPPtOSKsEy04CdddVyntjYKWgmUrVvPXzUf2090oEK7A&oe=69BAB292"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W3aDKgMQJnkQ7kNvwF2QD5n&_nc_oc=AdlY5uTQs1lJEOGq2IgYqUwh7KHwZ8vzHvUn5UpJgE7sNaK60LgGDijBWiuMByQU844&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyEAomrpXrZ0vblb6nMrjZcgLkUuYCe8TUwuqZuLh7arA&oe=69BAAF84"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YDyug1GQABEQ7kNvwGQZpAn&_nc_oc=Adk3vcxFSP9TtPpQeVIc4ytuHnpzdoUSTA9wrTVNjdr9_9PSt-H6dQb9DIFVRZtZsOs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afy5JuuvUN0eQipphlnYWfdFKS7hb2EOn5zkSRZCTqL9jw&oe=69BA9959"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QM40X9AXKWsQ7kNvwFiKg0Q&_nc_oc=Adki4bLxHUK1oiL8cjHq8GJVAbgiDfwSJIjUnV8EDq93sFyccwRG7K0S3Z7P__wN1Ys&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afxgc342waruO_ZulNzPD2r0pvA9TRypYmIhzuxHrzQuqA&oe=69BAA082"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H0a1xCroKj0Q7kNvwFoGGun&_nc_oc=AdmteKLYe-wRcnGLVmXqsw75fjOKMZxW_-fLYiurereBcOJZhfvUcDpU3owMU8w6j3E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwLnbL-jiG9rN7U
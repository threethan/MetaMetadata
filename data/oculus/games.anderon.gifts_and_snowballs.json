=6e7a0a&_nc_ohc=P4nICWGddBAQ7kNvwGnyaf7&_nc_oc=Adrazaqv44gAVQ-Mnw_UpgpkiodyawccKM0uF_laE1BXUqd9H025uUNqDjkrKeXqhY0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPROuHc6zmUguBbUe6wHPsWD0RBcsCcvjllU0yusf4ivQ&oe=6ADE0085"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fwgBe_ARh9gQ7kNvwHlbjrX&_nc_oc=AdpXu4n9-e8ZCl-ON6rkrcsbfNmfeikpinPaTDPclmSX0JmeoTgu9Z-e6_JEJA6E2D8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMrHHuNo1EAJwYQQd4rpXVROkGaKYhFiABBeHNOhuXQNA&oe=6ADE0E12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R2gj5YnELTMQ7kNvwHnx8Cd&_nc_oc=AdoeT-wd79ygcVg-p-OhSu6r8Pc-9wVtdzA3I1c9xs5wPdsLW7WCKBmwXqDT0m8gwIE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNIAAEZCKmgcrCEamoeRoTp-_6pneuvOY7FQPWvOj5ECA&oe=6ADE0B04"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JfB7qn24Zx0Q7kNvwG2pa-j&_nc_oc=AdoaO4FkHTuwM1YLU0g6T9isPPUl5pFg2kDr2-UM5VJ0KKrFDsUS0Mcevc77y9mhQkA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO3ervPjqwZr1XPQqK3rsnoTOLbhOJqQrtbwVvG3XiWIQ&oe=6ADDF4D9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yll8FNLpThAQ7kNvwFyRpYr&_nc_oc=AdqOuEBvhTDI8bTGhOh8otR07dr_ingx5vkXXrN7tCt5rK5z9pr3xlniinGy-a8dnP0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMF9BwTCWG8aRIb6FxCIChOtWkqwb7struFF5eLzSM3ig&oe=6ADDFC02"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9_-L2bIOGA8Q7kNvwHFb2lD&_nc_oc=Adpm1YD3IiZbKeQzUFG1mRtJhQWbelbvXNrP-AZJZvMzr5fkhNH0W-mUT
=6e7a0a&_nc_ohc=iRSHkDZS4_QQ7kNvwGJNQ2i&_nc_oc=AdpbFrIF-SVdvSknvYTKNWEWzFpQnpHkWZ-Hd7d05OVrwo1NI4DZ3R9W23l7K8VZwSc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPMcovs5m9nk39Gkj_9mYnb8-DhTMUGieEnmGYGaJZkRA&oe=6ACBC3C5"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=moHBfQOkzHMQ7kNvwH4Vi9m&_nc_oc=Ado0ecyeBI-shPLGrrJZPpVcHAUsDMEwCbwnLPlHXTeYZL6-z7Bq2xb52PNYmanCs9g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP9g9JlCaH5--UinLpYR53T7JmINGvhSt42Li3He5-i-g&oe=6ACB9912"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YHwptqP944sQ7kNvwH9b3qN&_nc_oc=AdofON2Okke-IJNHY5Nn0VyeQcOPpw-MWVwa7Bf9Ld7nAVOI96oLupeO5PnUbRxKre0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNS4U8h3mkVZHVvHVVodFuN2VZp3UO25cRbRMHeMIVaSw&oe=6ACB9604"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QOuTAa2nsW4Q7kNvwFBskmn&_nc_oc=AdqT2arFPrqanELCKnydTegRpcf_zFml4VoRmBqdubOu3NPIIefSi_Pbp5W1a1ygERo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPqREDSyV8i5UdX3RASzlAEmdvURU7UjVFNvt7_ugoWWw&oe=6ACBB819"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ezR7JtOz0xsQ7kNvwEOvFw2&_nc_oc=AdpQI19aZ7ZC1lY1p0VXl7slv45TCpQeUwBm8lvWi7sfIc0fUxqNWHF6-e0Jbqb_rYY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMKjvf3LMSoztdconJH19p3RIPg-ZhvsCgmocZ3V2FDTw&oe=6ACBBF42"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=51dj1cOwle4Q7kNvwGeDPB3&_nc_oc=AdpANWqK8W7XaLbc_2SpH02bmm24-_5A1AHJY242bYpxB7GZobH3jyM1A
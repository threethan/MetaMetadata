=6e7a0a&_nc_ohc=XGgtyhmSfvoQ7kNvwGGqAmu&_nc_oc=Adp8QJic4g0KWaz_QvywxqJCupFCNB0hFfHAzlQF-1CWnzeYEL90_fosGOUAxVlxGHo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxLEcmDo69g9pZ63mcuoZTREq8qyDzpZU6mmg-K9ebRUw&oe=69C3DF85"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Unbj7qlwQGQQ7kNvwEW8QLZ&_nc_oc=AdpKVOVz4i_0C8ycb-IC63Cd7DHK8TBkE8SfeUabf59u0eXpcac4PUpoHoNX1W_VM9k&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxwgNOo7uKp9pUT8MqzwXWFHZjUzvzflXTwi9wMjumVwA&oe=69C3ED12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5qWe9JZfOAcQ7kNvwExmCXl&_nc_oc=Adrzq0xgN3Ph_AfjkfHQDhEIAzVV4rK4lgYB0HRGKJZkBEALQ629lsztu0J2WPaanfc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyYXeZyAeKlOiw2RfdwQlt4wpcJzRKZSnVj1K9t5YfGfw&oe=69C3EA04"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nXHVh5CDmWYQ7kNvwFcIVHr&_nc_oc=AdrJ2Rv9bLz9ZtSY-yHSXgljbC8kBBowMsQCD2wFEFwXgyf_JDTDzHj7r8sVMxqxQ5k&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxUnfrlm5PYXcK30wGZ59AzNVPSj4VxA_XXFQm6aXDh4g&oe=69C3D3D9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VEQvD-yaLCYQ7kNvwGga_aW&_nc_oc=AdqgPZk0r6FjHpdQyi5pSvFA-o7fWuMFRmjYIN6gZYIU92xd57t5KHEiU2_14S6O7EU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwHt4pwIT2FkTnARUsShslIxxLHHmVeyXvVcpX-89cUPA&oe=69C3DB02"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zSrmql89ZcsQ7kNvwHn2QEA&_nc_oc=AdoUgS51Nad8YmxjGKLhz9b5Q9MVbyqV3X88TzyusjONLp5LluY4KHWYA
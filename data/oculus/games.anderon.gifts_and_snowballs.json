=6e7a0a&_nc_ohc=GokgqXDnDVMQ7kNvwFodIMi&_nc_oc=AdpZA8Y-weMRBEpsiABFTchOqMAl7oYIFGKoOGaD_aSdzFgA_OWi-_6qC4SUsVT_eFk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIEezvs5i1KCfr_7d5DXU4IYr2RznXrkJ8sT3ngUoFwFg&oe=6ABD0B05"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C_x9m8qd_zEQ7kNvwF9iA0s&_nc_oc=AdpIUw92y_ASjckN36pk1Yf_CA3Bn1Yh7MXtTm3i7CRaJWVz-j6fi9uEjIJUBLdu3hg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIw2C3J5AeFk6eQgm_FO7W8E5qA950ZL-1vOdtFOfKD5w&oe=6ABD1892"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=167wAch2kkMQ7kNvwGs0c89&_nc_oc=AdpDJvZbT4gNl7S0t7-SbOvw0y-pDmCBez2D3XfpQZj-pOEGXf9PqXDla14vUzIYxlI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_qUxTAUOlBnFzfCDm3Q0g8QmU-fZ7FlXbRg1dE77YNw&oe=6ABD1584"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JMftvk6dInwQ7kNvwGfJDna&_nc_oc=AdrZpswBw76NacWYp-1KiCJ8oEAzyACxJSMxx2Vkvi3S9XICbtDjyLuzFM0jbjhzov4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0JJCkkge3g6ah5rMUFOlV7MgIUcGjFn8fqU1r4UVjIQ&oe=6ABD3799"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fVynE0HwDhUQ7kNvwGQCF28&_nc_oc=AdofrkgYhEXxiA3VtndIIATp-lgt_n33Zvqin4N1AfXaQvXBnRcmXDoKK7t2HJdgsiw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLiVgG8qDr0XVagX_K_bCnWQCPt0m7tX1ZC01C0zbi_5w&oe=6ABD0682"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q6ou1TPa9BAQ7kNvwEadYvY&_nc_oc=AdqEz10w9_RLnFChuUP7Y-F9V_3AGQnOt3KZL71hvQtMe9CQusFsh6EvD
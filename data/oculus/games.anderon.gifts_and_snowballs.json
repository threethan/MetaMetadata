0a&_nc_ohc=NIMmS4LnujUQ7kNvwG0CK0J&_nc_oc=AdqUmL9D6E04MqOV8Qvvjg5c0O1-euwDRvNiKNdHci2S4Lks1W96Kz3gu-ZGDotRjg4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7et9XYD0Ihs9fF_q01slxZbTKUuAPPKN1P8qRyEswYA&oe=6AFB268C"}, {"file_name": "pinched warrior03.png", "id": "2233739983674845", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391837_2233739987008178_5682748129040869737_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZZ9CY6MspBcQ7kNvwHQK6xR&_nc_oc=AdpYT9KtNHHG8z9v2HeSkMZ1IBY2inPtdktq4hZ2SVA8WbRi0-GYvbzYWX_ellUlVI8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxQRbiMIDNZhxGlqI8toS5e3vC046e6xnUsbQ5Br-XHA&oe=6AFB39C5"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pg2biRoI-DgQ7kNvwG4MeD_&_nc_oc=AdqIGjz1CpKhqfDzaR4d_szZQ22YoFrRaR6fLA4BLpUyBi620QmiFozSAgRFW5f-HgU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSh5zL1kcxNt9x71E8mwGyYCbE-QS_6hLQc1WJzdzOrdg&oe=6AFB4752"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ocrEk02XX2MQ7kNvwHV26Pr&_nc_oc=Adr2LOKVyiBkVoY48Wq1lvnzxoQ2AkvYdySJ1I5A_fTQD1Kjc0dqq_OI9dgty_M5los&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYUE1U8aUfB54LcODqAvVX-e_INmflvmdlhP6s_kdhIA&oe=6AFB4444"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_6Dx8IAB6v4Q7kNvwHWj94u&_nc_oc=AdrL23MqYmtvWxcN3SYwi81YtWSlbfovUd6FyNlErAlj__F8Rb9Rz8KhHp6xR7wEWBg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvlxd-m-KyIaXStOb2QriIBclf80jJaJZHtovvAUWzqw&oe=6AFB2E19"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MYC--9V5qawQ7kNvwG
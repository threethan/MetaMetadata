8&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kMwPrh75Ei0Q7kNvwEZqOxQ&_nc_oc=Adp1n7bUvWelcyMsLrHHOYPDnjtazNZo-S_saeWZtCpPoFGGRAUSbB91UOmqNvNn2aI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9UZ0i8NtYOMnrKo7lVa9D4X5c2L_WgL023iZlyrrqO6g&oe=6A369205"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HDGKKi_RTNoQ7kNvwEbjjhH&_nc_oc=Adqo0hGHZ1b9gOCjy9KeliPqGvIPIJ8ubVK61gHwefPXGvhOX88oOekuVZP5Kq7-WuU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UKg4y-XJGCBuRK09H3abSDkyk-DSvWbxZksd7qHyZwA&oe=6A369F92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DZ8fepJ-SQ0Q7kNvwFr2tbQ&_nc_oc=AdrmT9RfIhbRcq--ExbCf9OAhB4tM-pU7NHKwp4uk0dUHu1EvMQo1bMOC5U7lK_3MBw&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8BTwNavPmrYt91j3WDLPmOON8KdS9S--2sl6oWQvjjyw&oe=6A369C84"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9bcQ1Qc3Zs8Q7kNvwFP7zkV&_nc_oc=AdoqXkM2MBHJjixzWCjetJqH_wAHXSnjRsijnPEWX-oFphRfMEOWF0rXWIc_aDhoKqo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9v1qHJjP2ewxODn_zb2GgO8OD7n81oLlnqrckJMoswyQ&oe=6A36BE99"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S4rDYOkhunoQ7kNvwEkRkAs&_nc_oc=AdqpwVJ2dNV5_08yE8s8FfTUsucCnS7NmwYj-sfjs7peiNhGZwSPITUVCXcwxYWDNbQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9gDqHYJ0G5dB1R9xJzYsHNJ0x-ht6yOxlrcwx0i1ckgw&oe=6A36C5C2"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e1fCc6rX0a8Q7kNvwGTA-mq&_nc_oc=AdrwyNJRjah8CHIVHzQVOswBWvgyv_LzdP
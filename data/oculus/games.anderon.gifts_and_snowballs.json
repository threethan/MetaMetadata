3-3.oculuscdn.com&oh=00_Af2wkmgwHpJKx8VT8gBIKl4yMJ7qEjNR1YdmYwQwxLkI4A&oe=69F20405"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TsFVeZjLZEUQ7kNvwH89M1r&_nc_oc=AdqES5rndhGqiE43daq0-Pn6tJ_RjbAxlYzcFVAwoyI8sodebrqtucU980S_hJtjE1M&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af3sRUkwZyLd_drCsfUCpwT9NRIDKt03oCPJgmW7kJV6tQ&oe=69F21192"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hZrs13ha9aEQ7kNvwHxMv2h&_nc_oc=AdqDknbB0Ywx3X0vHuUF9y6bxMknhJjUGW-Thn5tsdtTirHar-NDM6UZvQBZnw73Cfw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af0QWnQU1rGXi_Xs43ab1XFaIadbF-4t1ibIw-9L4__Kkw&oe=69F20E84"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SMra-e5XKOMQ7kNvwG94aXC&_nc_oc=AdrmOB21P97squ5TlgERHpnjZQNkg9Of6zhZg7r0jyagSDujKch11Rx8QjErH56bOB4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2KInj-J7A0zj59Z1nvptInT7323qls5kDs_oaVtzNQUw&oe=69F1F859"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v2k-xTFeAP4Q7kNvwFCmC_0&_nc_oc=AdrL9_efL23XKh69PCKCN94U29EsI7mM_xibN4DRY1DM-j7ckWGpvwst2c4EahgWj2Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2UWJ6G0sn1pPnVY0_wNO1RrgIoHLXHwaMbyiSYOT9g7g&oe=69F1FF82"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tow67OzX1UAQ7kNvwFJ6sTP&_nc_oc=AdqY-c6H5gpgG9qxXZCMge8LuIGe2JuPiCjFgHjZXPUDvmJ9JldXuHWAHELS1bQNR-E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af26g7wYHbxjqUmkDoWch4_mW5__yef3DzTKxwv3qtWbHw&oe=69F2031A"}, {"file_name": "Logo_immersive_layer.png", "id": "15821548
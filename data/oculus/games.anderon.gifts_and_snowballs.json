=6e7a0a&_nc_ohc=tQ_PHyFGFKUQ7kNvwERRS3U&_nc_oc=Adqx8_3w2Y5gvV3KWtpRqLG-ik31jVIizN44Ylq4k0trNTJCYYcWUvAEbGLHL80O93U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRrqwbsTFUTwYg5tw4E09ViYknJjU2ZdfWWfmcuZwHkg&oe=6A89A085"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J4HVc1djTVEQ7kNvwHZDJhQ&_nc_oc=Adqzrk42DCb9KuR2lIGUAefVp1PA3sBqaM3cOod9Ji98_St5ZgxWu3nHGjgxzqi1Ipg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0JSGSkUSA-2pH3tuhi5eq4PyaMfOCwVh_dk8mfbSTSQ&oe=6A8975D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ClAMJe7mVBAQ7kNvwF781hp&_nc_oc=AdoQlm_93vtYNYCZpGdRZVcJNk2UzcRgBpa8B69Rn_A_8pHFrqcN7kgwFQBMColD8xE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHeYSsFtRvxx5DUlBwfbAKNByVqCKGBvvufMKvxhlTqIA&oe=6A8972C4"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HTlVaaQ622wQ7kNvwHHB-Eg&_nc_oc=AdoxnV4r0UwGOlBUxScSV5x1iO99NW5Oki8bwnLrb62PlAZaJPEu6-D1KQt-1N3CbDM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHh3GEFCov7nC8m3bOGOWN9FZVgYbECPIJmcfQsCwkU6g&oe=6A8994D9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GFb7kU6BjZsQ7kNvwFuz1lw&_nc_oc=Adr24qVV3DLeCkJhi2La2GMfVMPHPG9w2SJoxc1MWaEWl3JqQzpXQAJhKBCHYQ4RBgQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEsqgrXUxV0-ctbusLELh7zEPvzs8-Z2rnbw0grC4JBSw&oe=6A899C02"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AGU3OU1EwQ4Q7kNvwHNjMbr&_nc_oc=Adqw3tJqWcd7XL5m5xSTGd-h-gUWlDd0suBYLW1ionYfR2MD01V38yYz1
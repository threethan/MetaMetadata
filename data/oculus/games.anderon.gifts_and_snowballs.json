3MF0kgI1ar6LyBw4Oqz1OL7cphWOCTwMSOAhzIBUWgK33E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwAlIsXC29uyLIVsR_66q5l3Fg0T0S0rhalpwECOxXKfg&oe=69B6B085"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QaAu7auWCpwQ7kNvwFDBnkR&_nc_oc=AdnzGSh3crKk1PUamGyTWFbmrn3kPM7AskV2j8PCc1jUaPd9L5xLs2oAsg0wmGDoE-s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzYuqu2wyJNJvDenDcE7aLRVEnowTeTb053v8PhT_iKQg&oe=69B6BE12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WiJ3kNz9AnwQ7kNvwFiBwIR&_nc_oc=Adn3Uy5Xycj3foN6IMN4O8bpOhJ8MgBWKmxgMTqRSXtHdJ6IIyEPNh_nEXp0WvZeoI4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw79mREDMVuXItrBoDWDbnDFBhdJ6UL0Mb9OpdZs0huKA&oe=69B6BB04"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2QBShXm5o1QQ7kNvwG5YLta&_nc_oc=AdlnWdBYv52dwtX2F9rEt6PoAOIGrKvrdWypbFfSri-5sUZVEcuJIvWznPa_NOqK-E0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afz9NnoEjhr3ZgziQx7Tjr0eaSXv299i-Ag8VZhJzFva-A&oe=69B6A4D9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qttKyaB9N2UQ7kNvwHaCNoq&_nc_oc=AdlAgfpdGFglDAtS3kFRc_N4fijAbZG1Kf0FXZwfiEIX7gnrD2BbpZwKlNlqKxR4nig&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afz6CiJwBc2YWa5Y32xkg7BAO28yVJAqzY4_vOEBILa7EQ&oe=69B6AC02"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tz5_jVgxEJwQ7kNvwEkfC-q&_nc_oc=AdkMGggzPGngIxPhC5YxDTLHeTBS9VU1EAOIsHyQ3PNHYtE_e2G3ytLPyQvlkY-pMPQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afzo_LzfsWkJf0Om
=6e7a0a&_nc_ohc=nHpRvMucAvAQ7kNvwFw6iuK&_nc_oc=Adp-6J8EDQcpcESs-9e1Wym7ECQsHlxIbhcbV-5k3ETOqpHphN1ID_nMwbQJobY5Q_E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBSM472J3lwk7icdGaEY6eabWJiYvW-RV1ixoMnVovHQ&oe=6A5B7C05"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=26X2yrxr0KQQ7kNvwEW3DMz&_nc_oc=AdqAGfNztVknMGEjYN4h4ROmt62nF65-eDDV6NBC5-SbQKi36JD5p1fCXFPG_2XaiWE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCm_BSzHE1GcUch_n7OyyJ1ftkEyjSl0GIYYNXuHeSfKg&oe=6A5B8992"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nEoDSw4s3YEQ7kNvwHJL43t&_nc_oc=Adpf3C4HZq9JsDUMOAAXn-bLmXEZ-gYWXWpqemJwVgIIJOFCBCUu6A9zbW1mhfGc9Es&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA6XzWSi_lR5tYOfwj4SiemJWl1Vp6SHnP9FyZ5rHGr_Q&oe=6A5B8684"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g64bG4Q9kosQ7kNvwHhsBrt&_nc_oc=Adr0e8WPgar-ONc9uJejdibaj_RHOWoM5n94UmQvWiZO1MRPm-JIXV_X1V58IU1kdoI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQABeqERCSyu5YmzWdfEBDAQjVEUhLjTGoAqN8a3Gbm6AQ&oe=6A5B7059"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2XCOgyYY_m0Q7kNvwH_0_6D&_nc_oc=AdrrD_0Y1iVlSKncLntRznypH9W0x_38eEHjxTytOtmNt5N0DWaQoq9nn8JolBJIi0Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7uO2afuYzcvmeCL6HSJnbtq5UNvVcsl-0VX48eC8nyA&oe=6A5B7782"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kjdz5m9duVUQ7kNvwG02z3N&_nc_oc=AdpbPfbQSINes05hnyLSyCuBwbTYn31ji6PbLnzrohA-zbmAAfkvr8cxg
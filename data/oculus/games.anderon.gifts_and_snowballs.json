-ord5-2.oculuscdn.com/v/t64.5771-25/75286676_577533401544348_4203344657555901211_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f4DdYaCivuIQ7kNvwEMDKSy&_nc_oc=Adm4cYH1tv3WV8UAcW3PhUHlSK1RHpFJDcWB4RV8s2m4A_np9CgjklfJhR0wLfF7IkA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afwv6fqR12sxJY-Yejd_C3PJN9e21q6GIo2S_AuOVWI2Bw&oe=69B2C6A8"}]}, "id": "2073760636370964", "locale": "en_US", "screenshots": [{"file_name": "screenv2_02.png", "id": "993244952825890", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974853_993244956159223_3665934591366094743_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0lHgNAOHZNwQ7kNvwE6iiZe&_nc_oc=AdnmWTij0fCZhqMCjuojcVi_sY1Q-diM_eUWzmFPfN4PIpwGCo59uAjQcpOB2PqgEwE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afzh8TSzKaHsBmg9lLdtVEUFyeRYxSmmHOMx9uOYMNkWOA&oe=69B2B08B"}, {"file_name": "screenv2_01.png", "id": "517646341325841", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572947_517646347992507_8365861269156842802_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xBXN4jlUBScQ7kNvwEdAdzT&_nc_oc=AdlTX97WoUo8EtT32DR6v4kpwosFmah59fx6MTDDUv3U6pmfuqdJlBaT66PlTr_jFr8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxcQ37e9LVLHOk3tmms11tDsqTJfoz1ixaJsyC6w8-nfw&oe=69B2A9E3"}, {"file_name": "bagarre selectable01.png", "id": "987094796807741", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391822_987094800141074_5341301578934495068_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6yRoVN5hr_8Q7kNvwEa-X1J&_nc_oc=Adn2D2f7qJ4N27n9KfLjsl-4lHsiPbuYYXVRD-xQ7zr-Vatq6ciw6LFB__Lz6ClEhCI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyRrSLoMFzvaBxU2ALZn4wxD5x67XctzPrIL-ovPEJFEA&oe=69B2A8CC"}, {"file_name": "pinched warrior03.png", "id": "2233739983674845", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391837_2233739987008178_5682748129040869737_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RJJ0DGFcf7wQ7kNvwHC2ciX&_nc_oc=AdmqVPAvGO6TjaxD_y3c8QM_U9Q7MI_bprjEgJFwztAMNoDEvYe9AsBeEdNRQNe4qwk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyIaqcwSkOzUyMD7YFu9ZImrmZmJfKWaSEyTJ1xdomvSQ&oe=69B2BC05"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4qNb-jqM9kwQ7kNvwGYKYSe&_nc_oc=Adkw8hhcnjph_9YqoUuS5aHjOsw1vX4kcq0CPhSIqLZzs9k3i_Cf7Q2tQZt-CMZF8kk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz1lv3gTHXsXpQdW4Rr7XovSXOD6aVqPnGIxJ_i2OtZ0g&oe=69B2C992"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rdz-OqvaRdIQ7kNvwE0VWdN&_nc_oc=AdmhAqFkOfoP1p8txYf7fBVULu_ut3kk4dxR7cqWdMJ8pcrQNILlZY37MAUhTjqKnz4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwbKPNCCPiKOMEZk2zVWhi3kAv_QIiHPyGhwCJN1DmDkw&oe=69B2C684"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SZCs0Xuq_DUQ7kNvwGebMhM&_nc_oc=Adk4KETPAZloeJfP40jXmTeMnKJs087qVMct5n1WCDY6Gswlw-YITXcdniOWXi6aJDs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzOLlushl3RMsK-Iu0gHIHw2WHFtjr1id4QAr9NmjGFpw&oe=69B2B059"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0YAMA2ugSH8Q7kNvwFS97Kj&_nc_oc=AdnfBOAaqXaPhPEQ_ZnZSg-Xdn6PiaXwjWjXu4bkOpB3LXE7VdYy4jxLDD7BSdiwGbM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyjZxzLzns99cAHicEg9WthqSF8tz-zo3JSGcrvXmXJUQ&oe=69B2B782"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ei5JzflxAlYQ7kNvwGpMFHt&_nc_oc=AdmFCI-hYCgEfirMpDPFMUyZT0Wu5-Y4TmNqFycZKatvouoXudKFg-BRm8_QZEL_TT8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwfQa0I_6JAb5-r
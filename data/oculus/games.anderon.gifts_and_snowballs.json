=6e7a0a&_nc_ohc=LBmvALYsKRsQ7kNvwFnZsMD&_nc_oc=AdrY5QkySETW75vVD7zIcCKA7gM0sEUI4jJlU5omjPuP0UqEuW3s7YCVrDi8Mi18ji8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-O5ZEr2czjmCiHEPsJ3RBIIFLJEIRrouCt7ULm2-RD6g&oe=6A3D2985"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rTkjjScyHJMQ7kNvwEDEoKG&_nc_oc=Adpxwubg35BmCuzAkFjLKvmich3tbITHh0-Idxrvp6NLIRs9_sO-2amUxHjANGhu7JI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9DFMnU3w8quicyhZfFCQtC-tbB0Knx_-T2jnYQQUmPTg&oe=6A3D3712"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CyndV_3bbOUQ7kNvwG3tJvA&_nc_oc=Adqarb68CpmfD92wO-mTkJe593QIlJLPHiNXranQeJc68IG0Copo-w792vsPTL5kjDY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_1Mv5obFLhuh8OXRWuh6wiH573Dfyhslo2gMKO9qW0ZQ&oe=6A3D3404"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C9xOJC3JyHMQ7kNvwFvE2hf&_nc_oc=AdpBAcilwE93uQ-sadw2zYtAe3VifMcNJ_pON3dI1RI604b1QRRRV3tS3HD4hBbrIJg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af86Bx35xPrKQt6uB8FCV9n0AOnUI__--HWtM8OXNI-n8g&oe=6A3D5619"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jGf9BuOgJBoQ7kNvwGVAEpb&_nc_oc=AdrP9Ma0qKhZTaC94HxQknqtXQrhP7fMKCLS-vYaYtBWTooWRyi8Z3R5IZO13-BL9wg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8kV7bYNNNAYllnySEI_w6ODUXJo7z4Fd8NPh8YzSUgqA&oe=6A3D5D42"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AWIuWUljyd4Q7kNvwEhbTBY&_nc_oc=AdrHbJ96MHBkONv59tCYMr1qVvEdow0FvHmB-0ijl2slHYEChHw5Zv6U_
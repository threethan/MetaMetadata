=6e7a0a&_nc_ohc=2SMOom0toR8Q7kNvwGtM0I2&_nc_oc=Adpn63WYGLnVcIznewDFU7XQmNAwEwwxhpoiwevbBzdOhOYOp8wyZZFSXbuk2NfOGuY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy-luUJ62GF_dI76B4p3MarwY61DuRHq6F6NBonl4zz-g&oe=69C68285"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p7ZJrr60zrUQ7kNvwHkz0Vt&_nc_oc=AdrtKLyXU9keH-WfnW5BIEx_MtqtSbPbk-hvQ0wCCxZRhwboWBNuk8qqTgZRIFFCYEU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyrnddmsFtPuAuSHr6xw834grpJ0mO8_mDkFuXFJihiZg&oe=69C69012"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZlidPbaD1cUQ7kNvwHHDgy2&_nc_oc=Adr7aBJm2e4pwI1cuaH9Z2DufBofIa5ERDssTFyGIWN2oJPoqZTSeXS0WpGFBYsKaE0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz3WDmziL1bxXaTYykG88rVf60AkrBDBPOHBvFORA4eFA&oe=69C68D04"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nXHVh5CDmWYQ7kNvwFa-hpE&_nc_oc=AdpoIqPl37JJFrGpt0ZOE6UUWtSrq7-96Psw-FdmG26gFcS0UoOLBEe4cqmS5DKyD9E&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfydOOZRymMEEqV3O6P3dnqlIvFFiJ8z3uiGVfa5uLeuQQ&oe=69C676D9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Ks9CgvUjRAQ7kNvwGlu_a0&_nc_oc=AdpU_w9yVOLnDCgK15bGj8W-xTmyl7XRDEwslf-gm8cze1YeeV7dNfZTnP1UlwVvNdo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyOIulnizCOz9mNPwnDLpiU9Zv7gDNZElZUQRdbuyZ59A&oe=69C67E02"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EPFdbBei1vcQ7kNvwE6MHKL&_nc_oc=AdqFGES0M9R1G9E5Hl62Nv59GWRZ3Q7anzZizoqGfmMKuz5MBETT8tgQz
=6e7a0a&_nc_ohc=c9vHu2JofbYQ7kNvwHizWzN&_nc_oc=AdopdzJ6apyNVGp9u2Ldwu0GQzkBOkx-1bwUSDGlC_IHvns_JtdJIFrALic8B2Zqk0o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5hO1lXNF2CPKhvfwjSZBUf-HDXXl5UQ61HLyCkDGPUtg&oe=6A159C85"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6zRUXPza83UQ7kNvwFBiZrb&_nc_oc=AdqQDIqiw7T6Sh_PIolAVpgt7ib7nF4FsiX22oEKplIDQBTdTnqJSi1WBHN596-zVTE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Exay6jWZLv3s8emSoJfP_iYT-sR0dP3Fa30fxtftjLA&oe=6A15AA12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iVZH7Y-fkAAQ7kNvwE4VA6e&_nc_oc=AdqdKAkj0PAdvjUL1G4_iIuISCw4Xak1XZtqWs66dbUD5-RbnFrEmQfcewwQgUgPZTk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6TZBPKFMlMTJqT2JQMrj_gHPWP_UBvTuQOVXvFFsrCuQ&oe=6A15A704"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nxe77EAIIeoQ7kNvwFvEJ7Q&_nc_oc=Adp9UUsr_M0eO0n58WPRciAmUMvryuZIEKba30tcgZNgsmR9JjRI0_Sq8RnOuV5Zeoo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af65Czx65nghqYcMKAT9WourgJ-7xBwQeN-Yzk5c5wrLbw&oe=6A1590D9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A5S7BQrWLhMQ7kNvwGjwvQF&_nc_oc=Adqp2ZXIQ8K9yy10P6JZqHLC3QYhvmooefZWf_HEhmgNWLMMApEj6zh9HzybZ3ov3Co&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4FadKvlszjL5NgVx8xKCImwQ7p2_iDXFjuiBcZt5nfjw&oe=6A159802"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CEMPxpmty7sQ7kNvwF_gULj&_nc_oc=AdpccfWgFW49Ehx7E6ywp2FEJ0TjbVyA9DmQhfglTtXOjZuvFp7ssNFPq
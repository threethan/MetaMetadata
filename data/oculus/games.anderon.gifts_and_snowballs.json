-atl3-2.oculuscdn.com/v/t64.5771-25/75286676_577533401544348_4203344657555901211_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kh_C8Hh232QQ7kNvwGnbaRy&_nc_oc=Adon8Xmme628v_h1_ZlfeQYFEyvHEznmAfG2AAI4_KQ2oM4_E0X2rcFCm7Z7PYcaFIw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afxt4tCjiNCztIFGqa3HAXe__e8qqnZEnq7-Y0J7elWIlw&oe=69C14728"}]}, "id": "2073760636370964", "locale": "en_US", "screenshots": [{"file_name": "screenv2_02.png", "id": "993244952825890", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974853_993244956159223_3665934591366094743_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IAICoEsTnBEQ7kNvwFWuvRs&_nc_oc=AdpVkDdXY1Coc8JIfObgP5GoR3OF4NEpZSq8KxOcFXxcX8tfot8UkrKHgN1fFqmy9Zk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfywJ6H0a6r3JDvgWRZrNHw3m7gYl7RNl1oNcCc_orzSfQ&oe=69C1310B"}, {"file_name": "screenv2_01.png", "id": "517646341325841", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57572947_517646347992507_8365861269156842802_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EI75B8TclmwQ7kNvwERSREB&_nc_oc=AdoeoWmDIwsAd_QwCSrSNLXM0YNmPHERb1h2x-a12rMpO8sMxNBmT0VvUJ0KTCqwQmc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afw1wLmce9oYcPLdNR7Mn_Um-ZSdU8I02DlYHB1uJW-HhA&oe=69C12A63"}, {"file_name": "bagarre selectable01.png", "id": "987094796807741", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391822_987094800141074_5341301578934495068_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=99QA98T_7JEQ7kNvwHtd6yb&_nc_oc=AdppA5Ovu_jryS5fZmWtgXwF3h2JDXHFZ_f_x0wF3gCAZ7fynchL3TpEW32QwOyuyVg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxfD2m5T6XgLPt3ubvW0L49vTaGFkREoQyVzGjUUPaveg&oe=69C1294C"}, {"file_name": "pinched warrior03.png", "id": "2233739983674845", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391837_2233739987008178_5682748129040869737_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z5ZlXi-NWkoQ7kNvwF88OvA&_nc_oc=AdqXCkLlx5oQqnezoHuwL-4OSnqxaTqbdmgjgJNNPrNd7gG6spVdSuAj0tXCHRyYZsU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afw6hIetWD4NY2xIA7DyOyqIfZPzXW_fY-p9-eibN6_gaw&oe=69C13C85"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Unbj7qlwQGQQ7kNvwFVlecF&_nc_oc=Ado2UsTUEgh0HcUOxBh7MbIUKSq-krkma5wPpjcMZ_ScB7AL-b1dj4ciQ2mox-ZEhn4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzZxs6LIkz4qIjpr93c1ASF8ScX64JrcnbD85boxKjOIw&oe=69C14A12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5qWe9JZfOAcQ7kNvwGORA0Y&_nc_oc=AdpMMw98L8UJbQ6SPhEq3YFBXqmAwj-yqFWUSqATnJ3B14wrLHZ0ii62BnSYqansnzs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyTQY3bRBLsmFelrVlbvLmRDifmQJ6PLHfH4LI7w6gLGQ&oe=69C14704"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jp9A1_b51qAQ7kNvwFegqUG&_nc_oc=AdpwGeUpIAGm61AMz2yoxQBXXvVAUQtakbEzK0hErMGgy8xEXI0ka9214j7J2Cct8to&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzbwDoqdCRCdC-HpWiWjG0hoSNXcWL7RTQM2aAQuSXn-A&oe=69C130D9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r8wehxTfSYMQ7kNvwHKse-D&_nc_oc=AdpYB238ctwGw9rzbSbtAyXQvxYHTrf9wm0BeoC_7RsxTZQAXRkQNVtFrViGv2QOmrw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfybfWzQw1Hg5negWBgEat-aAsC3KfWENdRwluk1dwn27Q&oe=69C13802"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zSrmql89ZcsQ7kNvwH9bybb&_nc_oc=Adqs1bXLFd_3rZk92rJ0CyOsVkvXRBRR_8PqCPp7q0Q4fzBXD-vo_1CwduyCsEax0vA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzpvOSBa8XHmZ8B
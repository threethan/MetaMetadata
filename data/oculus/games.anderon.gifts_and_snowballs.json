=6e7a0a&_nc_ohc=5aPTuyjRMdoQ7kNvwGLFzg4&_nc_oc=Adq7xj1AQtIahUl4JyDAP1XLBCwAf1kqngjB-dBaDymROsxkaixWtn4jv7amqVSc4sk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3apjVCVWgfTBe1YoSYibi01s2E_kZC6kYB_HTPePFyAw&oe=69F35585"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TsFVeZjLZEUQ7kNvwHfJRLi&_nc_oc=AdptB6DjOxy1Vmz3HiFQe16mzh4MgrjDm9IGCdSUQhm5f7M9UgrtAZimFyrzDuRUTi8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2UhRti3f887nzI0P0eCr-X7WKGDqtWsJVUYuNz_HxuaA&oe=69F36312"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hZrs13ha9aEQ7kNvwE7kPFZ&_nc_oc=AdrdZ3a_3jJmomVXnUVZizYCtZ3XSS0ndgGnNa05ADmcUCuyX-SU4QMVKzy3V5ShTyQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3pkT_rAI5ePOY4_NAkHyPjsa8fXlXvJVXNUAMSXyEOYQ&oe=69F36004"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4br3iA-N79YQ7kNvwGWUSN8&_nc_oc=AdqhfgzZaB1iEIwXjpOG2cXy8eJIlUwStCjlMkRrQEqag2k-KMepbhnWN_Dlytj0BxM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0uf5Q8sAAglL5cuU7ZOSkJZBufb0ZvXMgBRjN3wlVP4g&oe=69F349D9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v2k-xTFeAP4Q7kNvwFdgVRg&_nc_oc=Adp929oKyxbACCgc5aCvnGTqbEM22LKHU7tXLyFAdRsaODBcUVazSp4bE9LXlujA5b8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1dlHhqTl3xNgqD7zoltz0DkYbExy0QboaUTLb27zqWIg&oe=69F35102"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tow67OzX1UAQ7kNvwGMCYLu&_nc_oc=AdrocHPXhIioh85HKcBQ-IOTaAod_kNYkUMjHq7PX6eHkm_9f6p6dDmyr
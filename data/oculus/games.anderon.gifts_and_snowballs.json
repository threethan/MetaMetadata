=6e7a0a&_nc_ohc=ZmtbzetigwUQ7kNvwGxX8Oo&_nc_oc=AdrN85UFiR__cEd0xldzwsBBUvA-ZfKwONsRP3hLySY63dU6cuDjxkU6hb6O5cDxIPc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMPNuOCOOpMBxzxlEQzDzr1w-mySic6tIB1VYDaWIirgw&oe=6AC4F405"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zdnJrudqSNcQ7kNvwGOIA89&_nc_oc=Adr_HUIjrKJgVsj23tSFRysWftIBBRBoi_UymL9isOsCfuA6WsE-iNRbY88gL1soijw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMTYlhLRW4pG4dcl8X02_7A-8ZbMs5Jkvj4lglmAVhxsQ&oe=6AC50192"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UcQwYiLTSlkQ7kNvwEAY1Qj&_nc_oc=Ado7jAMvoIs-jUmjWoaLtCbL9zc3UTF5BVaRC-ryZMPxyWokO--RJh7upcsWUzUDgSs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPsT37zA8sazjNcb1GOE2CcJK0EgURZ0PYY2u8q5jdQuQ&oe=6AC4FE84"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qo0xR9XZPOIQ7kNvwG9ztDH&_nc_oc=Adp2nu7fPglYeY2YZkhGic87-NrYMuyDHNkyJemEmwAr2R9j2XV4YEbYZVEUbBKquf4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN04UfDyQsyM3sHqSARX8mACJLYy22ugrspoZUvsBIEcg&oe=6AC52099"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cZYkipgkLasQ7kNvwHsyQNm&_nc_oc=AdrH3Agl4oGfvnSc3e44PTMCTot7A6lj-ZqUkiftNmtzLTH-EuTyZWphbyblBtvbjws&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMWIt3JAncUXg-prz7icEXSMbxWYWrRnQqQCuubWRbUsQ&oe=6AC527C2"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SotjUOyj--QQ7kNvwHRlDUM&_nc_oc=AdolgKuVV-ix1H2L_Th4ZC6s2muzjofCsKHIl-I7CVoHKe4CPAMFfdl_W
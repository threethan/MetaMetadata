=6e7a0a&_nc_ohc=b7mIP89PxYUQ7kNvwExUDWd&_nc_oc=AdpEkg6n9o_TjKvpFCzXXVbee0fhJevYTZXTJeY2A_Gy__q3XYS-gDTcja15MBYsaJ8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3iipQdEQ1w0jVVwTNqFItzSucRfjn-MDEjnQq4pxcpw&oe=6A33EF05"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HDGKKi_RTNoQ7kNvwGOx3Ly&_nc_oc=Adq1IunM6NRQdngDlYlUkpKPMq822TUwCUxi2Pfrb2cpK6LtnzO98Yd4exOnsFN-Hjk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-44RHOozbQOFoANWGtkV_8FQEHAHJrnG1_H1fL-OKjoA&oe=6A33FC92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DZ8fepJ-SQ0Q7kNvwEea9WK&_nc_oc=AdouwBeSLjrHL1zVgGn8iuaLQXG3DRCi9A4vw5fvNpbJlLYYBzi6afdlku93iOB1XGM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8rQIq8R_yBZRBPhrkvbGk3-ZFc76umRl8N3G3Nl8X6Q&oe=6A33F984"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jaM8M70u9iAQ7kNvwGXxLZa&_nc_oc=AdrUK0Q_MkL_sbtDymXxgovqKf4xEu1E-QityCcvbfKZ0XovpL0noo0BH6Pb2iRJyho&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9cEPWOeOoav1_fuNdRHA3uhGbC2PP1PSrr4M_gsqF-bg&oe=6A341B99"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kHvRFCuz11MQ7kNvwFXrtxU&_nc_oc=AdrbbxXnSJqpBXuknEEQHYizyqawewwKwB2uNEp38fQQlZjrjTn7iox8hMwx1nmADCk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_iQzAOxM70xFio1hzRu3ABfXsaGjUgX7n4oy7WXDDnBg&oe=6A33EA82"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e1fCc6rX0a8Q7kNvwE74gWB&_nc_oc=Adqhmck371x96J-bj5J_U3vLdCieFGvm9L7pQseOzKF8h4t8MI4OT6OLT
=6e7a0a&_nc_ohc=HyChN3YXSegQ7kNvwHtEAxa&_nc_oc=AdrxbpxCIH-w0x-INEVmd5dwoMpZ0y5FgPo-0-IKBW_VrYzGvWK3vL2EHsg_I7pBnrY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxgtzkJ_xy03vDBz6Bh2gvkl5ry31ztUta-c7qQx7JBQ&oe=6AB67385"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rlziYRBq-iQQ7kNvwHVxMDy&_nc_oc=AdrPiMIAJJJNlX7OVgf6OAiuFWDpZqBvHU6apwWKaiW8VL5fZOHSUbUknIak-lsqV1A&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJsjT6Ohivrm_xajLJdUULmedaOLDQ0luNlnWXDysUbqA&oe=6AB68112"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9MSd1V0yIxkQ7kNvwE88jgk&_nc_oc=AdrUXGlCh3s76DiS378q9OljE1BYlL1WcZT4KnPG-w0Mx8QUm0OkpJc5Yt_a7jkV4aw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLmrkibnNp4rP-hhsSoGluoNXeJN3hY2cWIZ5uknOHdfA&oe=6AB67E04"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vUGLM8hGE-AQ7kNvwFYjgck&_nc_oc=AdoC6xyHcpUeS5gQXSGygctpck0c-dYbwvpfilkqEoIksfA7io1cacNO2PGjugOyzAM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6nFBKX8iZl-84wVzDAUDWT994krhK8-SASzgu-EW7fQ&oe=6AB667D9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3XYprzAnx8QQ7kNvwFA0J0Z&_nc_oc=AdpUp7y2IkGu3FrLjLwEdZ0LgKP3xGAg24tw95A3fOwtWG5CWsjlcJra3auDcT-UVAw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIH-gXUpOiCj230I0f10LF3Gv3YxMeSt5bg7ZXoFEh_7A&oe=6AB66F02"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rpLZ3WLUy7IQ7kNvwFhJXOe&_nc_oc=AdrK1NdGu5Gcz_P03p5EWAgN88Msn-4eZXNuI_Kc-kxWU5cP92Ojh9Ig-
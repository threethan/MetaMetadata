=6e7a0a&_nc_ohc=c9p6SJSqI9MQ7kNvwF1fC1V&_nc_oc=AdoI3NqFAhMAjFx8WXDMv0M1puFTOLHfzEjqd_BHHC1IEqJCwC7ThxUGnweRjNDHTYo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8n2QuNkgRfyA7scsgpWM7uEHrPvZnFChVRit69Qj7rSw&oe=6A2AB485"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0tqWMa8A1IgQ7kNvwEqbz1l&_nc_oc=AdqTbkkRRcj61fmp3eLf9trhxsug5UEcCu4e4RV1QkIzSZbjPtm6zMkMISC4DMqlY7E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_FqQslbegHeLhStjG0G1NNS4pFMV2WmuLWeYD2GjcIeA&oe=6A2AC212"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TbO1wL8FMPcQ7kNvwHSg6kZ&_nc_oc=AdqEgkxbS1oWKLcAK2qLL_zKfXqMfdM9kLDzcGYV-cGRUoZpZVvl2yrwG4kvauvP3AY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9RHV3Qkzna40MBALkoRBXnbJQJDwegvYWSh5L0zl8OJw&oe=6A2ABF04"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oKSPFUQj4ecQ7kNvwH7MOgn&_nc_oc=AdoUWlFQFO7J1F1kghJ2smDPYcO-dbLnt6_IQb0-HpFtDldkRu1PcmPguNHrbXAArUo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-RqyogYtc_o7JrDdQUsJwQpjxV_YE4tXeXS89ErIVOZw&oe=6A2AE119"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YfaiN5lvaAsQ7kNvwE6SHgD&_nc_oc=AdpedQyeC-0swYBQHE7BepxBNOp0PNgMpkCE4UwhS6WMwIXy6QdPiYbfo_LWa9KVu3g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af86xHJwHRwt4fN4uTOcn5vbht_zi2XdgugQhjNkbaQXMQ&oe=6A2AB002"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4XZEwO9AEz0Q7kNvwE4ZpO9&_nc_oc=Adr0bvzV01MDxoMpI6ydH1JEYZDluNlad4woOX0ygLwilDc_yL8XZ_vA8
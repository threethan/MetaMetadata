=6e7a0a&_nc_ohc=H_2oKLFDb74Q7kNvwHIhT1r&_nc_oc=AdoNxCxeXOvEam4xAyDaL4B2KXzrTJThFGO9aJPcoUv0rDObDldrwuxud00RQaRURMg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGayviTDp3o_Rlt62SG-qpZnkrYA5L_q9-KwOdSMB2B7A&oe=6A748885"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=epCQXZd3EVYQ7kNvwEDxAWX&_nc_oc=AdqOxJeX50_k3LFFxIARmtR1QvsvydNA3EO-iM92e8siLTSUpvbyAHEfLsnK6M1RhR8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQENFwsY8S9drN06qXuCdDvZ3cUR3bxz7iuz2c-iOcqjUw&oe=6A749612"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nkxiM3_SEVcQ7kNvwHUT4DP&_nc_oc=AdoifVL94bOP1uJObgmYwG_57nU4PIWG3DPCg-sqobR2qE-gbsZvkUIN_5lJXcJClSg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHB61x6ECPX6mY2DzoejdKvgdlYxPVyUptbgIkD-fdEVQ&oe=6A749304"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hr5DtGbDd0UQ7kNvwEc2936&_nc_oc=Adog8MMrrPFw4RFT7Ep4WWSbJwhcrOR_ukVU7BaHOaEwTr1GxPS13u-RyjlqyKLLmcw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOX3S24Zg6PKLfkSlP15BpAThR0BLs63yErJdqrImixg&oe=6A747CD9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=114exNJUXSEQ7kNvwEtfp4C&_nc_oc=Adp2kLqD85te2N_zGfhd0ZhuaV9qHNF9ulwqm20rr4QOPEJEyim9qGoUWZoz30Olnh4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH31oAQgihvPDy7tPXcGW8sNmlmRJkosXpJW42IYdocJQ&oe=6A748402"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KXgCPzgb-ykQ7kNvwE5nfLP&_nc_oc=AdqAriWoryZGtNruaAwMy60rAdwoL-J6lWE65J9Mv7VS7asptLqhHhl9U
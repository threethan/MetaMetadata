=6e7a0a&_nc_ohc=qsTz_5KPUjAQ7kNvwE9Xk-j&_nc_oc=AdrTmFnCL6k8IJ8OEfeUs6-Rwc8OuJkrwbMXXTbp-jpx0PN6k7OW04PsSaku63ghp3E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYkr5p_wGw-8sVd1rTAKnBL0xa4S_48wrc0gSd_Z5C-g&oe=6A787D05"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LPRwzHJewD8Q7kNvwFZCavk&_nc_oc=Adq65oob9o875f9gM-Wd8TOLm0VfUCNAST7zOAdjaTx22k9_dE5Zpe8vMmgBr_LIPjQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZ8pz2bAYGjWLfTSCkgdSCkiFy4fpMgLxYqdHm8l7ciA&oe=6A788A92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mMMtCGyQTeIQ7kNvwHX19Uo&_nc_oc=AdqZufkO7g7ZVYoEzXiMuLLKVj2E9LumQAdDyVoG_VTeRT-PuxZb2lRvms0GA1ph250&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGhmpJYZlrnEq8IOd6a6c9K4iCmS5XQ8TZk-4zeuc9OXQ&oe=6A788784"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=73T6LsSN3isQ7kNvwG3IdV5&_nc_oc=AdrAUzRA-tiMDHT2dAOBM9FVg4NiP_BO8s05Siaj6lNyJ-SngDyLc1rvCGfYvo_K3QI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFB0LPMts_5L2y8pUuzRBcJ0ek51a83-4EWBfr1XInZdw&oe=6A787159"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XqU3Bv_QkKMQ7kNvwGNVijP&_nc_oc=AdqeR5_2bVOgmVmzb7tCD2Q4BPzlvMgkWK6kYmUp7816tAYnkboz23t2LwGPG1htCAw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhNgt4PDX5gSjffXxUfWtVoYR6C3WKgIQt48dMxlOm3Q&oe=6A787882"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wZU2FXh7fmcQ7kNvwHvKx0e&_nc_oc=AdqDXJAOxdRy38ZO1UezPlNr_URXRa5aQugzIMSs_h8hCLPkuyZ_27FoA
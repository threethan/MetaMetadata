=6e7a0a&_nc_ohc=FDTJbImPLVEQ7kNvwGtfTlx&_nc_oc=AdoskG2P9DXXKJ6oUroDjsDrh8JcpqR1z9w8s19aKdUqk3D_ioSiQsA4O2tl0yRsy-A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3nJekITDI6OCyTw3SMZ65PlZ_qCq_LtNyOhd0jVDW4sA&oe=69E0E085"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i12TB0yhJNEQ7kNvwFWHF4Q&_nc_oc=AdoHsiXaJlBQES8s5OfCPdBeStzNPeCdqhsbhnmFma8zb0XSr6HitDDIvZ_D2fl0ovM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1a-19VsmHXPyTJCeqfNaLJlnjDQAPyr84WssUsAdQaxA&oe=69E0EE12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5w6I_sKZgUwQ7kNvwH2iog0&_nc_oc=AdrtfivanZLsTKHpTfZhJ7UQCryg_5xbQk81-M6On0-QYIZf-KNy6Ga2LNBJ0rugDYE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af19qS2nbxns39llAFOvgoV4M4gZofDYCap18jeDNYjfjg&oe=69E0EB04"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JqUnvOePWTwQ7kNvwEXLs6G&_nc_oc=AdqSk-VbEK5WrjU5c6TBEVzteLtWQ68CMrSSP1qJ9zG3HqXUNZRyUGHsJUmMogZEu4M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af22FpWDpmIrTPtAt_pzvVd7-WvtDfBSq2B0jze04ZhAJg&oe=69E0D4D9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2RHl85UqglwQ7kNvwH-kFGb&_nc_oc=Adove0nJJzxSANE7eqkZ5RG-BQ9ENYLqcO_XN00xv1ZIXaXw8NoRLT3vXNeh2rmqd1o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1HtmaZF9oiMdvOCKeVMbqQSdf6HPmco0pMHVTFy4LAgQ&oe=69E0DC02"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HnOgWk6Hd6AQ7kNvwHiPYcX&_nc_oc=Ado2vdwlaZ4rOJ1-ERwx0ycS_9d_jzQrI0xmx_ZegXsyyUJh2imf-bY-t
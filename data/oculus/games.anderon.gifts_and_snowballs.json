5E05"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p8ZXWTD6aBsQ7kNvwG_a8JJ&_nc_oc=AdnXfiwBfnvpNu47LSJNGelUvcdUfLdrH-eGV0V3XFb5wWTMBShwcBDXG8lT67LZuZY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afv2QC9hm5dtzWDfQiddN7ycIzUMyiD5ndkiVjRu1Fpaww&oe=69986B92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jDajOnFk9EEQ7kNvwH9sbwo&_nc_oc=AdmVN-llp9NDluwaeo-fpLR3Cnvmkdub00JQtmUZu99iLI9sRiPIYK8kt6iPwOHPGDs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftbwisZL3WH7dSnEj6MOpzILecadxsfcXGZddK3rm7sMw&oe=69986884"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dvhZxw6_SPgQ7kNvwHlZCBX&_nc_oc=Adk8HbODK8NKI7IwXwX-pvosfWb-zdMjmAbvq6jdvhExDtVGWvKD6GiOIVj38epQyVo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afty395l6aT6j3c2e72ZkfNm697S8fTIjfW_o75b0l86Mw&oe=69985259"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q1cgww7at-oQ7kNvwFJGNhv&_nc_oc=Adk471VpwbSQQHYn3BduNmQuXFSSnwVeDBA3W2njeMc2v78AWMN9xXxgFtyvpDK3fKI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftUrb3Q3GqsK8JfeJ9_Q4q86kyCy3GVvm7l-wmC7RXJDA&oe=69985982"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dNZ1nhMWHusQ7kNvwE5vZti&_nc_oc=AdnfBETPic-xRW571E2xwIoK5ZM66hLUyXwJxtNuwpaC5EUKK3ZoV3oD5OYD0KCN0JY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvNY7dgaL1ar_tsYhUkxLp-Pj3KO0ohJBHhXaLFiTpFMw&oe=69985D1A"}, {"file_name": "Logo_immersive_layer.png", "id": "1582154802505542", "image_type": "APP_IMG_IMMERSIVE_LAYER_LOGO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v
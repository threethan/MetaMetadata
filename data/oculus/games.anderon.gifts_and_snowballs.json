-sjc3-1.oculuscdn.com/v/t64.5771-25/75286676_577533401544348_4203344657555901211_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f4DdYaCivuIQ7kNvwG0RqRF&_nc_oc=AdmLGm9wdi8iokqrrvItW40fDcb4SfL5KHIX-wbqSshQ0MVYH6DzNnOe1sUJVPNbLFM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz4-gMmUCPvNkocFwUHy1xWMCmav6TNz6bHAluwNivmLg&oe=69B17528"}]}, "id": "2073760636370964", "locale": "en_US", "screenshots": [{"file_name": "screenv2_02.png", "id": "993244952825890", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974853_993244956159223_3665934591366094743_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0lHgNAOHZNwQ7kNvwED-alE&_nc_oc=AdmJ53EjupfItFggZKwvQurNTm26D9QLAeGiQyD9C_Tp5FB7u0KyJE78KGl3nlJLTgA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw62I95Ef9S3ThQf5atP6ApI7XV_nHlBkytBfSGv7nRmA&oe=69B15F0B"}, {"file_name": "screenv2_01.png", "id": "517646341325841", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57572947_517646347992507_8365861269156842802_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xBXN4jlUBScQ7kNvwFfHroZ&_nc_oc=Adn3O7aqryzQxImaujmvmU4ksMDwSipn4y_eukuzENYEA8ngrotU5lyihuzUzOZ9fV0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afyt8aoSQ8SdQRWevMZwSPgP9SICu-7KrCLKv95aLJWWFg&oe=69B15863"}, {"file_name": "bagarre selectable01.png", "id": "987094796807741", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391822_987094800141074_5341301578934495068_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6hLywjsuT_cQ7kNvwFaGhP-&_nc_oc=AdnwR6Q19b68G_bJTevIskSOcNQ4At3TsW_lW2wioFm8mF2G1xeB55QEk6_kVwvrQ5o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyPazRzSwRFeXGu8gpLTUZo6DakTFYykwO76BjGTddpLw&oe=69B1574C"}, {"file_name": "pinched warrior03.png", "id": "2233739983674845", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391837_2233739987008178_5682748129040869737_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=thzQUfjeqCsQ7kNvwE3E_OZ&_nc_oc=AdkelQncdD2m0QeTt33ow_Jb8YVujKDoHG_D6qYwHe24AyN14NtUEKD6vgxLN-Ixzgo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxmTrCcVwouO8QNJ24nZQIzJZvqzdPyCSV85EiusdxR_A&oe=69B16A85"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4qNb-jqM9kwQ7kNvwGJD0ka&_nc_oc=Adn0scfyoNzf1ejTyRCBwE0cQ1HnJWZ66XJZEdVOthZn8rAH_Gg6DV-Y7FpxVh8FDMs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwEZ2hGqcg0FtT3GoZUk1IZsCCKtc_2BQQwF0mZOROPkg&oe=69B17812"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rdz-OqvaRdIQ7kNvwFtYqhM&_nc_oc=AdkfMNlY3Vw3mJX3Xt_gNQUvL4bLqmcRHS7bM3JBjy7Xs4xuSWKlnXPIVMnQL-ur3WQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxSEFAmXAbU9RLO21ZmHfRGbBB-5hpfXa2L2LbqhRcy_A&oe=69B17504"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SZCs0Xuq_DUQ7kNvwGym3Xf&_nc_oc=AdkY1A_rBShJgQxx3CfMxT8lG3cjYqvVW7cFDM39yEydOo_K1R5wchRQGgLtXWMA9AU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxM2fin893ECfkgXXdrsON1aA4PepF68cDFldcP-Gmhbg&oe=69B15ED9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l8x-xA6FYzAQ7kNvwFuk4B_&_nc_oc=AdkErHVxgTqE723WlpdDZSr6tPYoS7MPBIqz7pQtB0BBjGq5EmAU3TnAWFJfbCTkXEE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyHBVlTS1o4p7mDuGilJwSOn2PpdmnLj97xoUAwgUnp8w&oe=69B16602"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ei5JzflxAlYQ7kNvwE74iOg&_nc_oc=AdlUtOgdtie2YzTip77SsiyjOEeVQsvQtyUHIbHGYoK1s1wI1pgH2xvDketyP7kUjPQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afwqi9Pg3qYrJsnE
=6e7a0a&_nc_ohc=X7NnTzLLL-8Q7kNvwEbfrvZ&_nc_oc=AdoRyrM7h9r-Mg5CinYFbb6X5mcGSx3PWaiNLKYe9wlgTYs6Eo4zZXX7XBaTIs3QHZM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7HpvD-xJslgUmPnZE7DmDU1Edl8sfGq14Hr1GRZXIC2g&oe=6A0F0505"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wzNyccKnzEQQ7kNvwEQfu9i&_nc_oc=AdpwMRXTNa093wjpNqmHubdvOBoNk0gGqJJq0H9I1jJGTCgOhghoftr1Gy7gJsNve4U&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af532mXwwbRdKvBlCAnNyuNdkryfB1KTE5Tl5nmDQ_eQiw&oe=6A0F1292"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OtlJZa1d5xsQ7kNvwEPEv_u&_nc_oc=AdpgRIZjcaWJaUzL1uKP6vQmOc44Z-GxQVI64964C8dK2Lq7lOxTXiaEfNQqPxlX7wM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6y2FC5WDkkqGT52_Q6p9qzQsK9kNuYesH8_uDJOzTAtQ&oe=6A0F0F84"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ymf5eHgEWqUQ7kNvwG9gcpP&_nc_oc=AdqyKNNf27oCRzE9dUamdgFmLn5BG4tf92OzCW6WqpWw-QVTdxUwOKNTZThpZpYFTnU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7kwWI1AB6TZ3rNkANvcDXtYQ-4Vu1lwWVXWG5kJ8GwlQ&oe=6A0EF959"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D1yZGHHKqcEQ7kNvwECoz7i&_nc_oc=Adoz8ub3AHBiCRxQvHw-Q-lwOrRTShq8WhqrWHFzqnyAYwdhk9NgSdeP0a1wMzY0DjE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Q1oRL6ehOWWqVPfF1f_a4Rnd3fzT8kCMmyfRslTF9EQ&oe=6A0F0082"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i7hOtjabtFcQ7kNvwF8dO-7&_nc_oc=AdqJvppGenyD0bXWKuL1hJUHCRYd4ir6C9DeWCEc-2rvCaVD-G-8T48Ry
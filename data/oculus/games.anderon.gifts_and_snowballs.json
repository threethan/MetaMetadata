-dfw5-1.oculuscdn.com/v/t64.5771-25/75286676_577533401544348_4203344657555901211_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gsFtRXNqGuYQ7kNvwHwGYWH&_nc_oc=AdklQhz8fYsKzEDy5V6TLTHOKgrDiyaEWteOq6luNBaMLiHnNH52h1-doyXqpuD_8Xw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwmgKo17zXUwu017H4SvW0KcW0TukYxXRCALCBtqSKDpQ&oe=69BD52A8"}]}, "id": "2073760636370964", "locale": "en_US", "screenshots": [{"file_name": "screenv2_02.png", "id": "993244952825890", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974853_993244956159223_3665934591366094743_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6VtG9htKHrMQ7kNvwGQMCu6&_nc_oc=AdnFCz51MNFK0DD-Lw8aiwPcDt_IMguoQLshHejmAT_pc6I-2FrG_euxdw5WjFCfquE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxMhVU3Ng35Jp3fhPh-VbZyyBzUwi9X7UDe0uKp1vdZ9g&oe=69BD3C8B"}, {"file_name": "screenv2_01.png", "id": "517646341325841", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57572947_517646347992507_8365861269156842802_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VgFNCSb8AEAQ7kNvwHyQM34&_nc_oc=AdlFgW7XqThx6wql1acjxA2F93X7Eb-C4MTn1UPZCdhgJxLpV-usaiiKqxu9Mk29XP8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwvnrISbrW0fGqkIY1oDGu4XH2yzUtDWmdKubQWBzV2qw&oe=69BD35E3"}, {"file_name": "bagarre selectable01.png", "id": "987094796807741", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391822_987094800141074_5341301578934495068_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J8BM9rRpmNsQ7kNvwGeOGcc&_nc_oc=AdlrPZMFojtRxusn-nVeWgsxkf9UAcEV_c0kvU8yPgRTLAcBpMq5J_vnhy6JeBLCSGM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzPpEoGDVuTF97iM8RzbOssx6rXQOmrysbNLYGPIAczLA&oe=69BD34CC"}, {"file_name": "pinched warrior03.png", "id": "2233739983674845", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391837_2233739987008178_5682748129040869737_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ipD4YbJU2bIQ7kNvwE4ZzH3&_nc_oc=AdkyS2f9WI3ixkcq47GKIsbIhskz7sTNIDHSGWJfQymauUTf08AbBSwP252NZmIu2uQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxVzBo1x6_3tAdPY9D1MiJcaFPHEjgYiUKZ6ujHdXN8Jw&oe=69BD4805"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=upn3MXREkpkQ7kNvwFIIOte&_nc_oc=Adlir38WFp8-Vhhb2EsEkTd3F0PkgzBbhBjtx041b1Gi-o__EOg1lMVfJIBM4JCv6no&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzuNplDkpGG1TxyPK-ktAFtLwlp2r_8BFsiDT_qUNFZVw&oe=69BD5592"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Vo3jqHfmOUQ7kNvwEMn-Ba&_nc_oc=AdnIoQreerg9rpwjIzfDnDS7btZRyjQov_8yY9prK-JWI8BAImblZEPQ-lOSNmjmspM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwliMILIeI4EoMRnkxyXDb28UiaqIYc-vc9j3PKQWAEwA&oe=69BD5284"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JBYDVHAaUjYQ7kNvwGM2qYK&_nc_oc=AdkXq09iO8P38APEBnM5fJaO4U19Vchd5uo8w6m_Z_tg0SrJlwOeDNSj44fdtpXwdEI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxF36yxoIvZfgNW0uTyjiwLiu9OeouBcoGXCFlN9b_xKg&oe=69BD3C59"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QM40X9AXKWsQ7kNvwHLtBYC&_nc_oc=AdnEhr67D1Rm5UWBArqCJoKy06RoT71orvHmRYUpEcJN4w7cLzkegd-d0pcKj2qMwVQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzXRyNOW306DMn6FwmnNFVwSxcTw5zk-Jg8wMcqWn4RlA&oe=69BD4382"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VJWXyfhMNBYQ7kNvwH3gBir&_nc_oc=AdlWxyNF3UzDHgvqDk17oNfCHJbowdvgk8dZZYdNhXOq1uL8s8QFA3xHxFgWPLHYkL4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzqkQZQQa67lgMQ
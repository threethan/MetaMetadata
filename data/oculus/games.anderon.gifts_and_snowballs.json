=6e7a0a&_nc_ohc=HyChN3YXSegQ7kNvwHaUJlm&_nc_oc=Adpsf08TI7zgrjTBd2VkFF3no_Zgmte2CSU3tG9oSchEGy-PN6fUZBZgQpCX80QyT1I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNE6bXHc-0NnpaGRhFXaM1su7YvboxTnWEDBUeMminXw&oe=6AB3D085"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GOm5V2poe94Q7kNvwFBkkWH&_nc_oc=Adr4bEaZCrai5tvATzB75JbOLNb9hm2zGbUfp6dvalhFOyWODfPRbjMLZwMzsz6y4KM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJWIXQs_XCjlT8lXTww1mwKZMimFQrJFnfRIeuZxlx3Q&oe=6AB3DE12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tiAp0qgXyrkQ7kNvwHjw5Ne&_nc_oc=AdqVYIWmz1vfzVVxa1QKs9NjXcFJZkuxTQopDH5DXMM4y3RuGY70YKfi6k4L47Q7kgY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3WF77Qj6i0HZ7TfHgCuxBro9X3m0kawFmNcR2Am0U7Q&oe=6AB3DB04"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cT2AaQTPg0oQ7kNvwEG-uMa&_nc_oc=AdpiSPfEPusQrR4kMFTxBHL_F02sDh5jQS71IsEfLc11TNqOXK9-BtVuIcPi62nMD3E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIrllrTKpJJcMuGNNTh-HwKxGJPIss8bv0g-O4VX8zFyw&oe=6AB3C4D9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3XYprzAnx8QQ7kNvwH7b18a&_nc_oc=AdrXNEh01O44O0V0JKnFnNvpraFvKVDG6k7ZYlvhSZci7AkY3GtPlWBFLh-zDcGe0Lk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLMXLMaM3PTshed86T2J8vTvEG8J82Dps2qfSYNkj_cKg&oe=6AB3CC02"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qsnS6Y-f3vwQ7kNvwE3f9ax&_nc_oc=Adoknh7fkwrh6dqaAJResoSWcwUQGYENoI1kI1ZnmmyssQ5otqD21X6V4
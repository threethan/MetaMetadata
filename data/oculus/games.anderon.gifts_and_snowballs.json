=6e7a0a&_nc_ohc=C2K9hC_EuvEQ7kNvwFUkD-N&_nc_oc=Adob78qyYGZZekfSqMSLOu8XzOCwCNI8GbnmbGErLg-IXWjXrpBwdd-H7ExBQ6MUp7w&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQasdqxonJwzse47x-9y39wJvWDHP_grk3nlz8bpW-rcA&oe=6AE8C4C5"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RxU-eDlEQ4AQ7kNvwFZLUUt&_nc_oc=Ado4MOJkt6Zo0Qkqn2z1mHQQm1nnPKxl4dVpaO7Vo7XN3cNZchkJ9IeyoylsPy9KaKs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThwWy5d08GHsEwYoapEBn_EKSy3Qa0UIgoe1bIOD_A_Q&oe=6AE89A12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WpbvFmzdMY0Q7kNvwGlKsw7&_nc_oc=AdrM41h97ECw8va3E-hrHtL5tF27moZzDcSNlCH3MgPYY1znuYL6EZpXf72Ixq0Cvoo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxg19aoc4Pe6qnj1WxNCCDckH-NSFENwS-_nFXJQ2fEg&oe=6AE89704"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-AhT3j-IB4sQ7kNvwFxMAio&_nc_oc=AdrXYpiW64LtsiqA3zr6AWF-vAyE8g8H2KNFgvpsmqyKmfX97LhVCTPopnl4nE7PHBk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLbvUkD7DZ57gUg-az40M4UktlXoLytUYiFBJc_aSt5w&oe=6AE8B919"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DzJMFHKqQ6oQ7kNvwEAZYMA&_nc_oc=Adoq2-4t-nfd6a5upzMSlm074rip6DwoOoffqnz-4SK6h5Kdpe9IDY27p57dMT1X3R0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTl-PoWuoCjuL6GxKKwU9IYBslcDKjZD4Zt3SAq6gDRyA&oe=6AE8C042"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4jRYY2ATWBEQ7kNvwFr9que&_nc_oc=AdoMhccr72K2niHqkzv32jWDy7Y9fs5TSmGYtLw-v5a-HND7Qsn8pqAFd
=6e7a0a&_nc_ohc=0UgBcNnP_wcQ7kNvwHgkD9z&_nc_oc=AdoQ3v6eZx0ecW6c7iVYE_17qEuTp_Z2Ggn3gmHxFhDuc7HtamWcZEX-po3EHkj1YPk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB83wuVmWvu-UyW9l5BF6LjrKKjb_tPxCBCr4dMRRCodw&oe=6A5E1F05"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=26X2yrxr0KQQ7kNvwE-mb0P&_nc_oc=AdoqFi-LR75hWoy00VIeRxqZ8QL5bHMxY5FQvLi0H2GlJp-kggukqkoYsGoltX6qjGo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCRrkGFtwzEulGYSmdksxC0UBTXGqyN6qZT_P3MTykfgg&oe=6A5E2C92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nEoDSw4s3YEQ7kNvwHB5EwH&_nc_oc=Ado7zBiE6ich2hboWkVb_hVmLJDolakv-GeR9NTBVVY7K9uvDqGGJ7j36au1n8GQx6Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBkeOihNrvCGtvkTShz5q6yKxplOPwv3EwaRf_b9rMaLA&oe=6A5E2984"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7xzAXSGuaSgQ7kNvwGc-L8u&_nc_oc=Adp1YSQopTjA_MFvpQKKY5-rw7Gs_FUrHHStUJ1yAfLFk1QeWLzxnGxjbdPfFHdjKIE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDt0BciYSIs8d7A0PYeQD479rZL7o5FwCMm_wyO4qBUrA&oe=6A5E1359"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EYXG5lcYMs0Q7kNvwGL-vNW&_nc_oc=AdpmfUfU7Aiofw08L3rOM2qfsPxtT8cVO2rUSh56g_LmQj-Aiz8ONLPtuiCUwq-7inU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQANCG3K6hlYxa0M_tLSzGbFLIorYZE4B_gK_HsOIKK-kg&oe=6A5E1A82"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kjdz5m9duVUQ7kNvwGCoTj_&_nc_oc=Adp96s7vVV2uA9rHVfkDlV9NcO84QyZdOqSDULaQ_e_t4FHgLZsN1EFJi
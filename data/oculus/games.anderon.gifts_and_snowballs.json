=6e7a0a&_nc_ohc=HOLYN9yBL3EQ7kNvwHBPK7U&_nc_oc=Adow82Fv1evNbEBeJ9DRCkTu_rJUCagliDwjxqjHOFWqt0kfTKwU0740x2uP_6P0cbQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLwVcHYFuAZorBsobegNwIM6f2nO799JBQoahWOXzpuoQ&oe=6AB12D85"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lcK7Ax5UDVEQ7kNvwHT56-y&_nc_oc=AdoyHsc-l3yGM6Ygd0jYlThrYFoh8UC85XGCgGUwcvn5pC6M7TxxWhQfWAlUlSSXIOc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKzgEKfXkOtRxueVYGt-Q7ZbBDjJfijx-nB81boe-M1Dw&oe=6AB13B12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-zF_8yPpxsQQ7kNvwEGC5xX&_nc_oc=AdpUI-MHWST4y6Qzzt34RSlRkPjejVFOk-nTlBswfboUMIyPH786TBbHTTaWiIW5k5Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLpONS7lk1xZLUa2LX1W8dnazQg76BrP_MolgMROIJ25g&oe=6AB13804"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cT2AaQTPg0oQ7kNvwH9TD6M&_nc_oc=Adquk7XlKp0cwXj86nit4NdR5NRNaa9iF0I5cO5nPTO3Cyoj_jePwTG9VfBQaw_3aHM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJamNyRcXu0lqilZ_l1dBTGvcpRbwLdT70uI_j1X4DHpw&oe=6AB15A19"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PigRjd9JuwcQ7kNvwEMzn7f&_nc_oc=Adoz5ajCuOcN8d0PDMOyCG5GKnmLI0ns3bb-YXPcJo3Ks1qD2B8eC17AaN97rz0nTz4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInDLcD9EYFv7TmFNuWs9Pqp90Q7XMqSBe4MUUQ-dT_KA&oe=6AB12902"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KKlqKi-3-iIQ7kNvwHUgTn3&_nc_oc=Adp4CDk0dPM76koet_r5xrlCiv2TVYAy2wpEOIsrvU0NQ0Pyyw6qmE2wP
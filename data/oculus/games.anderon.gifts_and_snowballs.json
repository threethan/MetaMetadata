=6e7a0a&_nc_ohc=nHpRvMucAvAQ7kNvwGKkq1N&_nc_oc=AdrwCAHBZcCDrxhcPkxVCvUvM0UDKBu0qzvsW90uBr53ihtXMtU2tva25TTaZfzHJMc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDMCzhtCV0qNl22P085zPXXwZWsdX6p0y1sfMwj4QTrpQ&oe=6A5A2A85"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GhuLHedLrtYQ7kNvwGz8pRS&_nc_oc=AdpXPfvrAJgggyDkWPgrhwFJXiDk7QnPLR8jys8yviLHoLc8k70k0amKCM2NeYXf4YQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA9ulIbYMkfxWHweiHabrS-Tb6fcsMwMsmAxLqaGuFjlg&oe=6A5A3812"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JkMFZ3uGAaQQ7kNvwHCllg-&_nc_oc=AdoDNmKUUJGq8lWv3F0v5D3jW-dkTcCpuENXaKfud4S8gaBSUmipHXnxxbnlfVQ8ots&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCVYF67Hga85vNcWeS0gWVfc1CBKd7UmFeDR_5yFlS2cw&oe=6A5A3504"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g64bG4Q9kosQ7kNvwFg5VMw&_nc_oc=Ado98uF6qnGfThh_DQb9rz1VQMoDBbOCDe4waXcW2HcvrPe-85UJdt17aRfA5U8zJxg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDLV6uzAcc9qoB_JGLKhRPLXIB0fN6RcHz10BcmElKatg&oe=6A5A1ED9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2XCOgyYY_m0Q7kNvwFdsNzf&_nc_oc=AdpblEvO27hwloMQAqlsyWECJ8R3MdfwIks_USOY18fVj_b-OXQzMqa1DEz5bvAbqhY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXh_v-AIHeSuqrulLKDR7zCTTB89QA1ML4jKSfkvxBTw&oe=6A5A2602"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UX26BKJ_w_8Q7kNvwGJHvBf&_nc_oc=AdpTEV5yO4viFyWSF6jiaEMaHlDFfVXJuv8zLg79gvlPvF_dDgNDfusnq
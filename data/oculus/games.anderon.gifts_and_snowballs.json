=6e7a0a&_nc_ohc=m6WsR7QjxHoQ7kNvwFCyC4M&_nc_oc=AdoO2m4bMKOZsJDb8tEPT0mqzoMmYz6NioZqCiPGs1QDD40PHNZwEVIRT8hdh3NVMHc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84hHSUw0_1Ej7Ha1FeOrJGxo_UrFgw5oqg80kZ9LG9lw&oe=6A3A8685"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CPdKrGjHZAYQ7kNvwFU2-7E&_nc_oc=AdohXnsZTKD1fAbJnHQtTgaWo-xNQL8XA6tSCaSIuLI8fmEO1c9Q2COiKny-XSlLJlk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Rx9K-9Y92uM1I-nAo8M7opUkVdsjfeOe5CfOSoJs4Hg&oe=6A3A9412"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zGP009H8zXAQ7kNvwHioJEM&_nc_oc=AdrzQ_IY1hZWU0PWWxipc9ITr--bNjqMUgVLKFJk8bhkHYwf_k-7B9-cVrU0v3NzSFY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_X826SHM6Q7uHF2785m0_fG2I5EIfFHH5OjIRhWoXPmg&oe=6A3A9104"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C9xOJC3JyHMQ7kNvwHJGq1l&_nc_oc=AdolBkHKZ_4TFZ9dkQcGzsMccBjdMSqkMsTtVmkCToubliFLzi8PYNbjlM0QFTVBb8s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7RrzOWGiFwXMVCkrh6NVW3Wns5GrO9f4QOkIApA49IQ&oe=6A3AB319"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=asWMpoaNTHEQ7kNvwE5WRre&_nc_oc=AdrpCI0M17fpGBPIvpbifvgCcHWGXVeksAQl-7DIGEFfphrvXCJwOUncvZqOdXCI_OA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-4465eW5H2lOLXHKsxJ3qOT6AlQoHtbYLBxe1aW5uU4g&oe=6A3A8202"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_vB1igxOh9kQ7kNvwHiiWN5&_nc_oc=AdrDL_HYeMTxgL2Hj6jJVwr4N_nYl8PxjaIcFkeUg0TzYDcMCJM7wU6DA
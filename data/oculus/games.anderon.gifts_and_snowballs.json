=6e7a0a&_nc_ohc=LBmvALYsKRsQ7kNvwELruNH&_nc_oc=Adr_Iz6GL9lRIn4XPwrSyAMjBeCdPF_dvBwE3GCH9epaR9uKCMyfgmafqVu7SGrSV3E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8lOLZwx20IOF5pBqLv_tEjyqEqyGlciU8jjwizTLv91Q&oe=6A3E7B05"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J6BZDgvHdFMQ7kNvwGFy4v4&_nc_oc=AdoBrHQulHsndyXF4fYqocigBZpppVzaqQiv1_P73-YiY--BypNeSJiNyU1_FRWx504&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_yiNnINMK6r_91oZ3e55vJXFgbGnHXyozA5JweJoGrHA&oe=6A3E8892"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CyndV_3bbOUQ7kNvwGJkIj-&_nc_oc=Adpess84LSddch66PvaQ0EPwf2aKmO-6Qgclyp90J2rLU8scjCodCbctnAbsXPbk2ys&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-WehlNx93nWmzM5cVxIOGA-Rp3ckGPQyL03XjXK_lXPQ&oe=6A3E8584"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eeGjJfPYiWoQ7kNvwE8R-ga&_nc_oc=AdrmaRioJ72dr4ztQiZHM9eVz2J1lXBRpKCENv-RbMK_P3haEfAomBXWE1OmcQloXhk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-wpick_CBpVw5FBb7kg_aZHLi2SijqnWetYxaMXwS20A&oe=6A3EA799"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jGf9BuOgJBoQ7kNvwFLct7G&_nc_oc=Adqc5m9GvpDE0Bk9aBDCoLnNMf-lFfBDkoZvoB6ewbnEf_CDxVpMQqSQrgO8kV8TBp8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-aPbQAAaW7-lFCvDEWmkijT_sfBCUIqvJvfL320F_c5w&oe=6A3EAEC2"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AWIuWUljyd4Q7kNvwH6lWAy&_nc_oc=AdpcYCuFVuC_6uT_LnPptVI7Bvh2vQaEfl1otF3HvTIvIRJjc7utrqB0p
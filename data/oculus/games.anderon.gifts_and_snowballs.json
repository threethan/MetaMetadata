0a&_nc_ohc=d1HCFC1OWPkQ7kNvwFAcQ2q&_nc_oc=AdoU5hTRYdYXBtymu2PRTw1nqv7rI9tHoxK_wGRhR8SMeJZH3dSrExmWhWcBUcgGwx4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTphO61K9ARxvrUzUtJ-CWFrHb83NvKiSLWG25l_9toOg&oe=6B09A70C"}, {"file_name": "pinched warrior03.png", "id": "2233739983674845", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391837_2233739987008178_5682748129040869737_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t9oSq4FtJBUQ7kNvwH3WnKf&_nc_oc=Adr9DJAh7Pd4TlX0oIoPU71FOE-vZ5CTRBZZCOQ67x3DValK0-SzAIXzvgnHT42uAzk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTraYjMOgqLn2vo0t0vJ4kh8KXMOuuWNK-le9hg0AzjYw&oe=6B09BA45"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LnNq4Xj_OnEQ7kNvwGnxvy0&_nc_oc=AdpvtGtlbq-nJfDkVdx8GZwFtrS5EMH0HLHZfHWNsQ4il2HVdTrOBo3rRltTnHp6tzw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_sLORwfQO-Le2hMCbl18unqJ5H8UZHMLReq2d6UtbHQ&oe=6B09C7D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DQxJbDmphNYQ7kNvwF07jiw&_nc_oc=Ado2LGSZklxkZaOF00pAeA74BMYh-t9DK1wxAacjbHxJ-dSn8sw_WHliOiNSYfqV-94&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjV9Ljo1gNSyiUwSPBrzprwHfjGuv4oVGdNLaVDoh-WA&oe=6B09C4C4"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K27yNVmeq-gQ7kNvwHrJOmz&_nc_oc=AdpuYHTYjtl7-677RBE2oTakZot8QsEnv4-SQG7hLDaJMO-2vgT8a7y4yjA9bWOjxCc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCuR5FaIWMGXOgo8zKtIzRXyH8rqv79ffnqBxNpggaIw&oe=6B09AE99"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cNNTakovgAEQ7kNvwE
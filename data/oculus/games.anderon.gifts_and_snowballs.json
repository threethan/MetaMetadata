=6e7a0a&_nc_ohc=rtPGkPprmRgQ7kNvwHcx2B8&_nc_oc=AdoGV4sYUNlcv2tzrwAFLgJsQRXOdogIjfRszmc5BfI1AwWfABknJlIgtI8Ch-sXtVs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9FHsuO2D3cPN5J0NVMDiJy0qEBEdDmg99UHcwIhhhLg&oe=6AECB945"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vT3u_e6XoMQQ7kNvwGr5vdz&_nc_oc=AdoplopXfVtCAB5YBY9yiLmoovOILXsmRcdxa8Ehn5DWtUlNcONygqjRgkQKKACsDsM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTeq30eo6ga9r1PZHEQ6cenEqIUlENEonuWc0YmoS0I5Q&oe=6AEC8E92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wZ1jHzVHeyoQ7kNvwHHsR-v&_nc_oc=AdrdUSv4Tl2SZBtSON90YWM7biyNRHRMdNIkrPGUgAjKqFKDXltcwYLkYjV0LEKpzo4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWRv-oSFf1GY6UCtfu59279CbxT3vsaDo7WLrtrOUW0w&oe=6AEC8B84"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yNrR4jiP80wQ7kNvwFpC-8r&_nc_oc=Adp8ttsIwuZccK6bU3JebQ4-emUcKmyHl7jCGK3qKxqYsSDTvhZD1WnwjURwjWU1-oU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWknO5OKnxEH1gAl3_8hGPXgC0b-l0HfM5nzkons3nDA&oe=6AECAD99"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Z8MJkvBQRIQ7kNvwGB3snd&_nc_oc=AdoycsE0sQjS1kTAHdSSJC93TqDX66V6eZpLs6HwLwOiUeBYnyby5SGdckLm9xwK1qk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5yAiNOqC1pfjL5dz06DRGg61U5kxZNiW_rJZcUO4f6w&oe=6AECB4C2"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KXID9LdOkAsQ7kNvwH_r5-l&_nc_oc=Adq_je5eF57t7rKm5tN0TYrTK1AeXyRnUomyxQbuoUlGt0VLwHoT6F7EW
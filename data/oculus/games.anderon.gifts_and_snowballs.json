=6e7a0a&_nc_ohc=BUYUip5p2JUQ7kNvwF2zd8e&_nc_oc=AdrqWbaQn-f7C4F1HgvEttbt0i57CXxfb3DjfvT3llWMxHxZ7nO8MC4ZvdJOaSrA3vI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGyzcQG_jvHKbaFnDgcl9P6gubRRv_vH31-S4uVd1LG6g&oe=6A71E585"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a-ZnWqjXnHMQ7kNvwHt4-53&_nc_oc=Adrscj0yIVacnJ79vzXuWwRyYDiOsrXgEcT_dugHuC7p7XEtpg_PEQWI-QCcNfPd-6M&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWfCsB7l7QhtfMW7e2ntgrMdga25McncOxkG76tH1mPg&oe=6A71F312"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fOTUqZxGX1wQ7kNvwEoGVH5&_nc_oc=AdpBBvE7MGgd3K9afcekt_xZZ_rsLwR60pQhPCImphv_oc8hzwJQCNgidq2xZJQxSs4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJseXcRPNV7fQmaFPoZlFmh3L9VrhtWK5mlu6bY3KhZw&oe=6A71F004"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hr5DtGbDd0UQ7kNvwHSdiqM&_nc_oc=AdrtCljvclqmF0Kxd7W4_JFnfcKfqFxNVJynzYAFvUyGY9rGwGbOtd0afJMjzmBe310&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHhpaTqWYAKwwxotNbtMMKjSiE5EPqgrYEw9wQMVHRi2Q&oe=6A71D9D9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b0Hqxn39yLkQ7kNvwGYnmeq&_nc_oc=AdpmlMOsa0M_aBWYsWaLWRGnJmSAv_EYuGPhfxya8OMNwF8sYPSkAgUKj3_vTBZUh5A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFet1tRy6uGYM6C5dtUkvbdExKTyus0M9PmRRRcBD1X3g&oe=6A71E102"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vSaujhPBwOUQ7kNvwGCB6Db&_nc_oc=AdpF_TX_7np6yh-899LgtNVjbqKxegjjxZEvJAawlNGVYAzn6JWxD2LQH
=6e7a0a&_nc_ohc=4Q0HMHWqJ_4Q7kNvwETfTfF&_nc_oc=AdqHyMvs_k8in590QkXurnqLQfrz2GehW3gDpO-OMXB8BVOtGwuDwUbodazfMvIDyGU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCagcIINxsfQ2dHPJfV17ovq2CdF2-ZPzjPcpiA-HWCsQ&oe=6A68AB05"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YWDWucN5csIQ7kNvwH4TvU1&_nc_oc=Adrm99VU2OxhtpDoF6yCXqUxvAcpCGE8tUmQpW0zm_dAeEM0VQ_Uy-JHsubJa2j8org&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJZAyCO7Mq-v8U8Ewxv6ks-jxRIL3v8AchEWrhKXDasQ&oe=6A68B892"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aSJJ1peUeeEQ7kNvwFt9s0M&_nc_oc=AdphkiKDxJAZtaP8hJQ9IybhcwTfvETJ96fxGVAfybfC5jCiQTSJ9Ki5aeY6RZOt2JU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAetKrXZfDQDAgIuYlGvQAa-axPoVHu8nmyGjcqbDLbUg&oe=6A68B584"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T4Z9kZAYKWAQ7kNvwGoYavL&_nc_oc=AdpsO8BjMZ-3jkqeNZAp4B0nxIBQH95ojJ0AWX5EF02wuiPVpqsddWXXUE7Moeg7qVs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDSHVtZYJId8g8DGjJQF0seFo_3uUlhtfFYyoTXBiDxIQ&oe=6A689F59"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OJ9Ufv8eExEQ7kNvwGoDH4P&_nc_oc=Ado98Fs2AgWKmd4RYrCS6k5wUOw-WYtGdk-5w9HIr9eu-YlI2kiyZiembjRmnBVDDrg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA19gzaLSZ2qHiW00msM1ZCRqK_IzRZ3Td2sJftr0Co0g&oe=6A68A682"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RikoD3u3osAQ7kNvwFOXu5z&_nc_oc=Adqv4EQnKnACywB8IoA62glEE9w4RNV4wnJ9WLfqgdSxY8h9nQkYkTwOC
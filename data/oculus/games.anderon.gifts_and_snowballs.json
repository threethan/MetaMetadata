-ams2-1.oculuscdn.com/v/t64.5771-25/75286676_577533401544348_4203344657555901211_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ubXpSBE34MQ7kNvwESMQ_v&_nc_oc=AdnyDMmM5SFoNS-KoRHiyOCybqtttBozE6HMUP6WTFCKKn-Fk36KqeMqKjWNsnicTwM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afys4OHW64niih6_ZTLXgdoc00mQ4MqZRm9Pcsil88ODQw&oe=69B023A8"}]}, "id": "2073760636370964", "locale": "en_US", "screenshots": [{"file_name": "screenv2_02.png", "id": "993244952825890", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974853_993244956159223_3665934591366094743_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FCkjBCBulBQQ7kNvwGva881&_nc_oc=Adl9ugKxoHndDU6Y7fSrR6WZAjr-hfUStH-uCX5XophAu4Opy6GSFMlIQjzaMOBUkwI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfziNfLHHIcg5a4tdoICH-8mBsEWUh_BpVonTISej4zU2w&oe=69B00D8B"}, {"file_name": "screenv2_01.png", "id": "517646341325841", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572947_517646347992507_8365861269156842802_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xBXN4jlUBScQ7kNvwEBMpO1&_nc_oc=AdnQsMWkRwRhLLimuReErJ9VyizFvN4AwlRWQ4SLyqaOvRJbbusOP7cwdJMF4_jfM-E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw7UjG5NtDf7m1-oRse7NiI0mfqz8xTtaHaVdDJXSAsOg&oe=69B006E3"}, {"file_name": "bagarre selectable01.png", "id": "987094796807741", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391822_987094800141074_5341301578934495068_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6hLywjsuT_cQ7kNvwFCtiXQ&_nc_oc=AdlvIra8x2_hzwaonLfU1uS19EwgoMPW3lGf810uyguGJtbqYrQYC7JZXQQlE4szGhE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afyc8oScrsZxzlV4RyPHq9ORzuX3a9WV9TgdcLJCY8zvkA&oe=69B005CC"}, {"file_name": "pinched warrior03.png", "id": "2233739983674845", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391837_2233739987008178_5682748129040869737_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=thzQUfjeqCsQ7kNvwEHv1sb&_nc_oc=Adk4ZPsfOp6uGhDGXpty4-IbuEjWLvnPpVTuSR7suEqCOscN9jYxlvnnrqnkGE-VAts&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxJyheYqjzwmBMbY6_dUYyCS0vQrlA_3kjqksDVZDxm6Q&oe=69B01905"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ETrUao5FuuYQ7kNvwFDf7eQ&_nc_oc=AdmqBrUCqs29l0Q0_YgjeCJAHJhn1Q51GqOu3BPq8piAyPO7jn7D4aYMh-v90eU5Ldo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzve7jPUailwL3YsXUjV8hRxtU2OZqXeK39uYiP9aAppQ&oe=69B02692"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6HpnKdFDVC4Q7kNvwHMPhs1&_nc_oc=Adnhz2qot6OPUPPb29T_jAlDekV2PcwZFjLK09UivU_ETm2llRNC9n_FgEJ7puFJzao&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwebBECo_NnqmvC_yYIalBGQ6NlLCQqZDi_uqHT_M6koQ&oe=69B02384"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SZCs0Xuq_DUQ7kNvwFdNKNQ&_nc_oc=AdkxnkM15pA0vOAWtOD-s2WVqHoUyUidfua6rrGnWnhHxsmon7cEMmoqgApTTY7v64A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwCf7bx_MqcUJ8Gzu7bVE0FqLoh1RyLvLnvtsTMCnTEhQ&oe=69B00D59"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l8x-xA6FYzAQ7kNvwGGdu8t&_nc_oc=AdlpmB_1-fTVrHzCuwgzzKJ2ryvqrFugPisYAeaORNezS8bte9ZPzXGvcc7Wvb04Fx4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy1-5zM7POOAoDvp9LClZnqULRK_Y5o4wWymjXw2ZZN2A&oe=69B01482"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qmVU11r5XcsQ7kNvwF-r2wm&_nc_oc=Adk0SyRbTNWuilm_ONrfXL7oB7re_7Xxalf19B8ZqgI2sKSqb_1h-5DDElIcS_n2l3Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxzfQHUbUnIpnO4
=6e7a0a&_nc_ohc=JFEkSfLoVEUQ7kNvwEHVoV2&_nc_oc=AdqJTK70ZbBPgmH3DDC1ZzhDZE0Dmv5kgEQUq6VxXfn7_6_UR_-Ll7R8kcSqDq6OEWs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af77nGXci2XQw0HFAjFWS6jkeUldA7DzEarBPqpAoKQvow&oe=6A12F985"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gxLL5H5GG0EQ7kNvwGtWWxO&_nc_oc=AdocBpGxlbpxzWpwHiv6BuFC_AbZXANhoi3-a-OnaPuMmO4NLzTtdxRuZtTNHAZsSFw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af72mOsIE31O_yxrhaE8d_1QiW9s73_EOESy825zaYmAqw&oe=6A130712"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mdKGvFzbAmcQ7kNvwEOPSe9&_nc_oc=AdocLe9vMKGoKhlmApLrh0bkfg2OeEZ5c0phd8IkKiW4mZFcLL0uexRTSvzmrJOvbHc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5BPnBNZMo48Ibs6Jn84dHysqaQW94Z5tuSlRiyhadxtA&oe=6A130404"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nxe77EAIIeoQ7kNvwEOwsnp&_nc_oc=AdrnXLJU2JV6m_I6x46dtSe-Uehhdubf1TeQaRO1r4_gNmCbjr8H7VE8pRx_f2wcjcM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Pku6T_cic4jgIQSEHX-J3CLR2P0HKzGWCIVL9643OSg&oe=6A12EDD9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MgMYsFY7iNUQ7kNvwHhPpCX&_nc_oc=AdparHbACnbxM_q3ejTu5IHZWC2NNTBfZpQEJi_JEz4fwqydwqnvfNBh92Cqio6bMx4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6v-mGHgn6I9qDQsh2osfmZ6x7EChq5bVsRlGgxc0VXCQ&oe=6A12F502"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7cIqaWf6J8sQ7kNvwFV82M3&_nc_oc=Adob6vobnjEs_h8PIcZ3ov5pTe5Kf03kKbfFndjgQytW5WJ433fMRqqra
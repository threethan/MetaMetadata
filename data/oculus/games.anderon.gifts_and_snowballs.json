8&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RM2hJWg5rPQQ7kNvwG1lWki&_nc_oc=Ado7j_CQfbW3uU_9JSOJurs9udg_jTz2QqNt9ug_ShviMUrt8xvz6tB2PPn1eX25Ecc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_EMb9RMDpyYfVVy6VE-13fPJOV4z47GPYs9bln_m4Kag&oe=6A22CB85"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ErmKFgQ804Q7kNvwEZz6pj&_nc_oc=Adrzg8ufZa8_Fy61XQgn3H-H1qneFcD5uA-inslh9bApj31HWMw0aatbQOZPMkQepHE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Ksu8W93dN49rkqu6JMoBJjWAnW79Pj0S3WUW31YSuKA&oe=6A22D912"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lB8O0UcI3-8Q7kNvwH-mBdk&_nc_oc=Adr3e_F_J7BKk-ABIcCuTrzXC29sEKz5NnS7oQtTu3WBCRcCRnwmW8a6fu-YpMqE73M&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8gbl1qwcDLbfRtIqdJtKfpaVdA5k1FXZTKMMXdlsuLw&oe=6A22D604"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gob7rSn2qDkQ7kNvwFQ9l5Z&_nc_oc=AdrUa2aE10-rksxr6KwyfHEmiuOPYPULHtoXwv-arQaueh9MG9kgzGP0OcXp9X5LwYg&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Rq0zw_W9B5r23bXkGQzQsXYeI9s1bk_SORvUU7tvkpA&oe=6A22F819"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=33o-VdRN0eAQ7kNvwG33VOe&_nc_oc=AdomE7x62djKIuZuzrTWfykYCawi7LSJP8e-bACVAJj0z8iKX6dSGnK6H5riZ2ggujs&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9OEuLyPGGQtxTWSg45u56uf-WIWYQgLJdFeOLCLnj7QA&oe=6A22C702"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0AnYvnuF4LwQ7kNvwGlRLUQ&_nc_oc=AdqZEK1Ugar1dccW7LVHCXf4v-3YBY3kb3
=6e7a0a&_nc_ohc=na2jSgSXBLUQ7kNvwFG3eI2&_nc_oc=AdotAuvYnN-NbLXV2RqluGiPYJ_tnxivkzmLeO3KR6MNKQREcpFAy6X4MuOBGrroXQw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af31yO6jzUAUOqOWtafjgCoMV1ACdxdmi48yw8-HDC9xVg&oe=69D26005"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Td4dAdbMJ48Q7kNvwHzndtw&_nc_oc=AdpomdizmF6kbM1M67XKGytOMllzj7ljQFavc198F4Y3Pgw1rwgbDyAYJOVRodvnFAc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0WHixM8VsE8sJsWFxaUri49tCkiYuqT67-xd0Q34-zTQ&oe=69D26D92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lFk7pLOVVb8Q7kNvwFgNK89&_nc_oc=AdoVDxJd6HsuPRV8bHWr1ZLrx8N9J0D5ybUAZS2Iaufr4iHRnM_ZoXJruclr8Lwulp4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3aZCMm43G7LO9lqXW8Dx5MTnIbXXi8upTXNlicLDVGGA&oe=69D26A84"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JAWezlLS-E8Q7kNvwGawsxA&_nc_oc=AdrxJxbtKOjZF7ykX3PwK4hwXn5_so2nYVDUVvcCxQV5oLMSvkd-bEvLc1ZYoErgk7M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af04-oHWgnP61tIvCdFg-hpmBOal-fA4uS7nXJKZyoOoLg&oe=69D25459"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ZYW5M-NP9kQ7kNvwGhmX0e&_nc_oc=Ado8OtaGFP2ycieL_PWQ0-igCAOji7tM-6YdtOg7OUT98YGPm4UsOTmQRc8gux95wEM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2HVXqLPHZwsP2uXdsPQMMT-PLi5rd5xkh2-YhnIFR4CA&oe=69D25B82"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6IQnpdQsGssQ7kNvwF14wP-&_nc_oc=AdrbYz27OtwPlEpB3Ugs-wvjWa7DZMyfEoRza3Vxhq04v-t1rK0YdceTP
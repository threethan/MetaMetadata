=6e7a0a&_nc_ohc=na2jSgSXBLUQ7kNvwEcPotA&_nc_oc=Adqa_EnMg2JRQEUIBvAcvpEJiNQPh9yl22dnwKD95xo7tsMRCophvKfRF5Sn52uO8oo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0OIjPSxp1R0-PrYhyUQiSAcO2VEZL0lIo9fHHoaRq_eA&oe=69D3B185"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Td4dAdbMJ48Q7kNvwEotUAg&_nc_oc=AdpaEM6Cyu4eQm3JohbioN__1_d_Zl6avlcOYKJhlzwh9N0mgJy91LUus0Qcgcl1FZ8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1uwjoy1xzqztAD1Aq3cbXqogJ3zhSTIUtrhi-uL0aViQ&oe=69D3BF12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lFk7pLOVVb8Q7kNvwEtr8WX&_nc_oc=AdrkYgEZw9d7--SpOD7GcapCCpykjU7dmfhDn2JtxUy1aqyz3qc4xQq9amOc3HJZv0c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2a6Io9Oo87O2e-dNgZscz1nHhF1ewnXGwxn4bW4aXD_Q&oe=69D3BC04"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o0xB0_jIXIoQ7kNvwFEXWQf&_nc_oc=AdrWXfC0y5wqHbZ7eI_YYlIE6p6uC4nRC9feEdSAmzIirsxF1J4mKcClbEMDudJQPgw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3sYh_D3bV9KMjelqFsJbOKKJ1OUsgXtwJodPV7CLCibQ&oe=69D3A5D9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ZYW5M-NP9kQ7kNvwHqfEuX&_nc_oc=AdroxL9XJ09OyxJqAM-M-3qRuiOqw_NFEfQaWq7KGjQo0euxuAPrAGiF86zr8y7ndp4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af04jQUKFY9K7yKPItj6fq5m1UF1xX8sg6bBHf9QVi0K2g&oe=69D3AD02"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6IQnpdQsGssQ7kNvwEh2e4C&_nc_oc=AdotrmkJATOSKYxmF1xVg867Znfte1GGs_eJjPA3qJRvbAZx-lXVEiCaU
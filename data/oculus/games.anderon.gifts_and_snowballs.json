ull, "video_trailer_thumbnail": {"file_name": "tmp_trailer_cover.png", "id": "970834377918750", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036683_970834381252083_4781014387430602250_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qesc63HiXacQ7kNvwGnjJUA&_nc_oc=AdnScOmfKocARkVmYlQV9usqhqa4Bt47dGT2PSvFzJcO-pRlBbM7Hb1dc9OVRRbcQFA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz_QAGgjGh2RyJqjYkzaODLoPGLbHgko7fYnEq5369YSA&oe=69B01AC7"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Gifts and Snowballs is a chill real time strategy board game. \n\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of the treehouse before your opponents!  \n\n# Intuitive Gameplay\n\nGrab your units and put them where they will be the most effective. \n\n{1036205311413455}\n\nThe goal is simple : bring back gifts to you treehouse.\n\n{1206127330542199}\n\n-Grows your bunch of buddies \n\n-Use your gifts to enhance your units.\n\n{7717030558386186}\n\n# A joyful atmosphere\n\nExperience the joy of childhood plays enhanced by a heartwarming original score.\n\n {793709389407231}\n  \nJoins us on early access soon !\n\n\n\n", "short_description": "Gifts and Snowballs is a chill real time strategy board game. \nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of the treehouse before your opponents!  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.anderon.games/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Anderon", "support_website_url": null, "website_url": "https://www.anderon.games/gifts-snowballs/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "159
=6e7a0a&_nc_ohc=6uK7kvigkxwQ7kNvwGkE9Bw&_nc_oc=AdrED1Fo50d0_5lOwv4qnCMj8SbY52DPVWKmdlfrdYQ89J_ogn11xQuH_zotqdRpUEo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_RyVfROoINk8lE5pvYRZlYM9eJwwjMQIwKYx4bHmX5Ig&oe=6A43C105"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iqd6HKRNiPQQ7kNvwF5TjGo&_nc_oc=Adrrs6wTPqWRKBOxccvvDKCyz17Ey0327sxhyfomay2QOFrxivQDd_oJqJgfKGtcbG4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-zqAgCs5oKsJYuYcyIohtMptiem87Ib0BPjstXQOymoA&oe=6A43CE92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8889ieNHbKkQ7kNvwEbVmYu&_nc_oc=Adp4Zj72RD2NOdL2cUVQo5tBymxp1Ef59uBjs2vCNR2oIrklh3F7vgUa74Mtg9r2_dQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-yjDY3ESC7_uxI49oRngSmmmA6WukDYY3vCbbmm9f9A&oe=6A43CB84"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jpQyCOxRoxAQ7kNvwGfA3FA&_nc_oc=Adq7zAiiV3l192eUF0okYm0Zy04yyIhDh_jOtx6y1KvRsCEGm9aHgwSn1pgxLp5xKKs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9BlBW0B_JyJUgJv4GoEjVb3Yu8dJ9-9RfLkB7SO9w8VQ&oe=6A43ED99"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W6LMviCWHRoQ7kNvwGFRq_P&_nc_oc=AdpFSTSNnig1gfh9352KDTZY6S_fGbOXISokKRhhTPMOFQXibV7J5jrrT932JMjcI3E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_zB7HkgAOHJLNC4EtOp4ylvq7YA7l95OFDUx0Z_R1uw&oe=6A43BC82"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=siL7J4t4jgAQ7kNvwEl2nVk&_nc_oc=AdrpGOrhniaRcLm-MXTjiM1W0hNjDX-8-du2h9inM0gUK7F5sMwVcbGiU
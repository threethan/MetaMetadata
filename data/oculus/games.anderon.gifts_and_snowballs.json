=6e7a0a&_nc_ohc=IpFhFqAhZKYQ7kNvwHmxtn8&_nc_oc=AdpgsbLEZVwCxgU-dPCjdiXKax-tDxZRDLUsUQ2KzD87KOsP5UjJdo9auEHoYjiXkRc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHqKpvrU1sZ9KCWZ-Xfo8wl22qe6kYjilxJI8sQPHgXRg&oe=6A830905"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fweaIMsvgs4Q7kNvwEVJK-x&_nc_oc=AdqnGmwGKN4GdmedTkPnRWnFuzkD-w3ALXLD33F93fLBwRsFNJQCk-C9BEZM2c5BK7Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHi-x-tE_VQRaEjQtIpD5fUe7DIDD6JN-A95zJBWspgvA&oe=6A831692"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A50HPp7-lKUQ7kNvwEv8j66&_nc_oc=AdoMqLtAjoFk8goosazM_dC1DUNpUUdxkaHlAbFCM-FCYpdHAq_VyQo5JwctmnwqzLo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSySErEcr_QiC4RB5H5Eb3EMHPAanApIxpPUUcEQKx6g&oe=6A831384"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X8QBgP41LogQ7kNvwG4bRsQ&_nc_oc=AdoPLSwg1QEU92t5FRE_NcUqBtX7fU30psPF1KBvW9tJxwLYQ8wEjMidpn_cG7sfDe8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJGdld5zGdXI80xCdfKgxql0qGYPUPLPagVF0ifK_RWg&oe=6A82FD59"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qcaG--8FDZIQ7kNvwHGLqbz&_nc_oc=AdpUxryjGAxbwlgcz9kq3fWZhSKcAB7W_xMgFcGku_8LxzjrVqRzdBmmQxRo2WA4EfY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYmFp5DfyWcc0J_bUFtctJG8kH7JbX19aKo2yFhcAk-A&oe=6A830482"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MDS4mUw-WEMQ7kNvwHw2vam&_nc_oc=Adq2_tqc2iVTwchx1u-Ej_e7ZbAU_uZDjHk_AcMV0T_yrPW6FJPfpc7sR
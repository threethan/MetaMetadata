=6e7a0a&_nc_ohc=kPbV2lIhG2wQ7kNvwHF_qfx&_nc_oc=AdraWXxLzsG2N4RgzIkUr6EDGkOI9dfhL1QDRgaOoSBDTsE-aGU2c_v05IYusZAhb5Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYvE_uH8rza3WXacmq3m-zYSp_3wAXekdgzpi92AzWuQ&oe=6AA7F305"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iVzLmt6PQO8Q7kNvwF8cbXj&_nc_oc=Ado7Kh6uqyGiHYSYcllkd5LMzNL8MEmFo_bcUj6S7KlmvOZ8TkW8kPinl8OzLB6ptAM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQcMzz3NfyeTCQyAj9_1zPPoSFkdCa6-Ru0wz2upkR_w&oe=6AA80092"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZRlgfTPyjZ0Q7kNvwHcV9QJ&_nc_oc=AdplpXCKt5hLHw5_P071I_j2_g0oqFxLg3aJLl_9cpVBWyf-QgEYlhWiQaY8QwN5VO4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ50-BkhkK0W4FL2Xt5g6XwbuU8pYU0330BxB45BCaEFA&oe=6AA7FD84"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tCdzRFaVfFwQ7kNvwHxS54M&_nc_oc=AdogEhAI30oh8YC2D3aUAxKuniN3gBtcMaLKe8zlmhK8sNQL8W1akp4SSPqklDQcBVE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-6GqPjtfqwSufB2IS6QYq0JpI2S2VrmYggwLee8PCgw&oe=6AA7E759"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IpcxBVLeB5MQ7kNvwG6GmAi&_nc_oc=AdqZS13SqyfHQUTiYEPVv-SimoigH6BMBoiiU9l2hmMJ-C8UJ0HWIIyPl7-FoZjQ-z0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2yL7IIT6Pjcba7FcEdCEDD01AfwIA0bDRArPZZ9AZ-A&oe=6AA7EE82"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ADCl6zbjrAIQ7kNvwEaGqap&_nc_oc=AdpRY5gWqHuyniDpiIpXcCrV15TNctgESVs5GazKR7skOgjsBxqEgSqYh
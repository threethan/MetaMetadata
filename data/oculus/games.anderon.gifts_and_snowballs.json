=6e7a0a&_nc_ohc=L5FoNHX44eMQ7kNvwGPPxR9&_nc_oc=AdoiciHGEBUxxAeLbvK1BpjaXb8CfSxyo-Zqj5lhYr8Fhlzm_eAkh_6tbP3B25e5WN4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz7lvrEMbc2iF3RAG4x-a2oom6duqf27GpoyBHrfVsPVQ&oe=69CA7705"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vxr5OLNsJaQQ7kNvwHBTOFB&_nc_oc=AdpneoIQnovGano6fPvIAzoVGLAPi2vDhxe9CCkHRemvbPlIOQWLAcAkOjbumMSsYxw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyHLq4iVOzUQktMo6A0aj6kSqtnETF2_OydzGd1bTjyBg&oe=69CA8492"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4GT_CGYfpsUQ7kNvwGKFiQ1&_nc_oc=AdrAURewLYGv58vasrHL4Nc7_AjnRSJR0qh3473WFs3s-ZWE6hHeU-xynpoEgW2LyLc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzmrBNfacQopIoplQv9gO5XlSULcGE44f-ckSOUn9Dqxw&oe=69CA8184"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GD5Qe1PZC2YQ7kNvwGZLeNI&_nc_oc=Adq7IsSoBpKkpvgn3NIi7Dez8cksza-nWsn-qm5bHjg9MlQK1YaYwbWVPr8vw67LHvc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx3BBu0Mltno3o1DwciDqgTXCkMZHcFRgcm9R_dFRq5mQ&oe=69CA6B59"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P_dKzqVPyPkQ7kNvwGey6Lh&_nc_oc=AdqxoPeV7Lh6mnS7Q66LtwPV2d3DT_R9H606TKbge1ZUU2IlUnQQmkSpv5KSm0gDoWM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz6nlRXV1noAzF3fHmKLDI-QX65Tr_q1qKsMxg0vkuNpw&oe=69CA7282"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4J4Bak0BiWkQ7kNvwFhPUdT&_nc_oc=AdquDzmfPJyKRj5uT04IfRTfpHr2Sa0tchGN1L-cRBWrHPj4OgTpzsuBB
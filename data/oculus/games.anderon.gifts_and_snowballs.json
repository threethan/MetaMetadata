=6e7a0a&_nc_ohc=X7NnTzLLL-8Q7kNvwG7qwit&_nc_oc=Adpj-OMDWoU1TEsvEcB9v-V6RSzHBpPLBXbcGbDANJbmvlJGtZV4JbgB_UWT6l4qdq0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4EgDIKLKeRAq9VzCT-XjGweXRuU4vY7Ys2ZyH2Vl5ZqA&oe=6A0DB385"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wzNyccKnzEQQ7kNvwE_o9be&_nc_oc=AdqtAhWfZ0tAYWGY0xYjEIpG7NFcQ6bPHfYCdliUndZcpp33NkgOqrI5mT4-c_eufUc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af62H1rXuOS_TnbjN7wrjsFfRRNedUH-sM2sv06jtvod3Q&oe=6A0DC112"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OtlJZa1d5xsQ7kNvwFczj6s&_nc_oc=AdqKEZbelt1FGQXc-_E4bjcqWsY7WP0qTYvNkxXTuM0SP5f38fdkETXbWqbw71iRuXI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7awhppw6-NSn6C-gilI33wTYU5Z8qLFSicy0UwxTaeBw&oe=6A0DBE04"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AAXxZY9OMHIQ7kNvwFcNINB&_nc_oc=AdpRZWQbUOICkKDJc93QGW4ru4qTGSMlBoaDG_iOf0tGyKkimwzw16UWmyXOzDQzhs4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4D9YYJyqwgQ6yp363sKAoylUGw-rGPuV8j5XxQBz3UHg&oe=6A0DA7D9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D1yZGHHKqcEQ7kNvwHYOUtR&_nc_oc=AdqK0pmSG5AInDq6ldKq4Z70W-U0-hU4vDGxG_iEmm5exIg5Me4Cbg7gKXUsLoJiB_8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5uhl6XwdYtA6lj5Z6I4bdH5rYlWCL2hqs_dkJPXTlARw&oe=6A0DAF02"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i7hOtjabtFcQ7kNvwHjhOC5&_nc_oc=Adq66pCTnRoMd-4dZ8kMHHAuHxb-VWUgRbcLA08VPu3UjNS5Os7SNd51q
=6e7a0a&_nc_ohc=WNZ75kF_6XcQ7kNvwHgEYfk&_nc_oc=AdrxJxeDs7Bg6OY6L08IKEfXnS4X4LT_PE1l2gCID_2vs2uflK1C5y0YIor6rb3RL3s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQChgq56i4nZyDVTjsxWhzhbR7ok8pi5Yrjff76vWdZjeA&oe=6A50F005"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vtdkzTq5nTwQ7kNvwHhQb8q&_nc_oc=Adq5Vyg7lJBVXjf0I7EJliOxrg_8DPer3LGB1EHvM2rBXDVgKo7CsF618e_TvA4h7jI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-r5m75YFE_w6w1lArNVFeN39BQ27WpNRaRZzdYINw-g&oe=6A50FD92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5mn8gH65JB0Q7kNvwF9kaMp&_nc_oc=Adri-t2vwUQMQ2pZstNGTKGvbZJLV_nogQMinLw5VaKY4vuXymNX2WyhJcoIOFJmMbw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA2p0IOCZH4zBxxbyRRwnbMblqE-7LCqM0TwHCr2v8QAg&oe=6A50FA84"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zduU8MP8rGYQ7kNvwEbZLVR&_nc_oc=AdpEXBFb3jws6dIZlfth_HMB4xG-mmAJ1syR0HEBT_jKvinbatgp1M6ui9Rm89H4cAQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAPVmQIdn9SmS8rN1L1zILymKvfIDnQ4ElAoQA1khhSfg&oe=6A50E459"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JaxZnNYMMW0Q7kNvwFXfbhR&_nc_oc=Ado6GK7tiKTQ-0ckw4KaYyUneXrOXYkA_lHSlxg4Lk5p94Rc6JwV0uNXE_18Y3DrUPE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAbiP81A2cqL8W12OV1spqfvH8jWsdco0Gq695wMMMz6Q&oe=6A50EB82"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=opzi6DUT88YQ7kNvwFiP-j3&_nc_oc=AdpospZSIbkcKhGSDZFTduro1GohY0rJQ3Om1L5Ip0uoIs-UsjXL6wVpG
=6e7a0a&_nc_ohc=VRldfBFRXGkQ7kNvwFsipAg&_nc_oc=AdpEp9bKFUw_VY7ByA5dV8KVPGTU-JjNy7Lq2-PLnNrJosEVxN3qT94UGXWmXmrk2rw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQByDAFWNR42eH_TpEtgMm0qbcUwM_jmyz8v6yRSPqSA-g&oe=6A636505"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UemCf3K8V0wQ7kNvwGJtHZf&_nc_oc=AdqdjZScuq2dYzcgwB4g4Av26jjvcWQa8HOF5f79N2h4P0njsNJ5lrpHdsk-pzloXWQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCKF-FKP3hxBV0vdTxJFHrKJC2z6XVlz6swhEYMkqq7LA&oe=6A637292"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_NYHf8XpkZ0Q7kNvwEdjhz5&_nc_oc=AdoiiMKO555w4PLFIEdj3BAVk6BX-BednTr9j_GsTj1puKdc2sJF5cZRJJ5wn0wO4tk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCThXi5T4Pgg7nPTarsYqhsQ4T7Y3bE2hgUNmdsd3E7-A&oe=6A636F84"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6fLvGzZ73EsQ7kNvwF9G0ur&_nc_oc=AdpAnjX8Vj3MOxU_9rh3SBrtKapIqgD7wuZiSJKvquyORPOeVFL-UjqBw8y32Xepw8c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQ3MM6joExz6s3atgnWDmXWIRGj2O-CwAttOFiXuU8LA&oe=6A635959"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D_HSCSMDYwEQ7kNvwEVtlb3&_nc_oc=AdpaK1uxKiXFk_wUwDLU5spMTNzRQQnuh-b8nUUi_TlqFLjoF-5SANmpgkHHKtBf9V8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBawP5ovFa26aZMXmz4354tXeqIW7ijGl11xmvRPOh61g&oe=6A636082"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4RIOzIqDAzIQ7kNvwFRIZ8a&_nc_oc=Adqi_Bn12JnrKCJTUpRIsHjCxja2c5mswoKAi9S3gjWBUnMvItHoGcV1V
=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wgRD0kYqw3IQ7kNvwG7qtQb&_nc_oc=Adpy7ZRsk4TdH6KWaHOu9-nptEtvqfRarowluAYCJDB5NzRR_CJHdjHPIdJZXHnBqD8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-I0THveH7CJ_zwAdDcZYpaYjNprKHnLKdtFFDj_xAcg&oe=6A8D9505"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vYLkAJdUqLIQ7kNvwHOUebS&_nc_oc=AdqA71-QaNdbOkpWMzCprEAvV_pl8lPX75AzRgOp8iwPcqdG6bJW4-2T-oxKJkMipPI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMDWzvUN3_lkBmS2egJkjeJOgyBwxOpgCxvD-CEy4SSg&oe=6A8D6A52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c2X2xznNE9wQ7kNvwHRaZOy&_nc_oc=AdpkqTYlIG3QghlCzxnhKyfSJQLbuaEedL3BdYB64pLc5UgJv7AKXnJqi3YsPnNWJuE&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFM7Pc0FEEoWMozcIIqW6jsChxDOYgnwEHvoOl4cyFkaQ&oe=6A8D6744"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kTrSVLdfyKQQ7kNvwGE_KTr&_nc_oc=AdrsQPYBFCoFbEBLdgOzLhGoQNCxw8nVJjEjdq-b160yyXxPabrsRyklN2sx8iAEi4M&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHiRAvCHRYcm5sigeb8vBuVObF07ukEkMgNZECmbz3SkA&oe=6A8D8959"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OA0TlF9w-aQQ7kNvwFPSrkw&_nc_oc=AdoW7F5jBuTizRqNHpo3ROJCXqAGRTGPCPzXr_OiBcqkIvIi4bkmw10OHLLYjcd_-0k&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXNoBJpFFtDom2zoHTJDpEZN1s-D4T7k0_Nv3eoDxS5Q&oe=6A8D9082"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R4BUXElqqbMQ7kNvwFQ1ZfE&_nc_oc=AdpG5TvGMfHKYC8kF_Vq4NLijv3I7Iez
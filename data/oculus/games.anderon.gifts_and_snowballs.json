0a&_nc_ohc=ZgPFEL3A53sQ7kNvwFUc1Y_&_nc_oc=AdqA9KxDeKHk7I_4hm_Q6Nl6TxGrq8BZrPf4Ur_UfjiUZ_PMYBV3Ri89kt5sjRxHpQM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTTuXdnmX0UGrnzr7-rW-92oaHZ_pS_MX2tIe46p5l2Ng&oe=6B0B30CC"}, {"file_name": "pinched warrior03.png", "id": "2233739983674845", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391837_2233739987008178_5682748129040869737_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6xdbtncev_IQ7kNvwE4zW04&_nc_oc=AdrNuOBFuQKGOPka9ODIJSVHYlvb5pCvCcw6PgDOwq4O8rHbEySb9oJ01D3iSvlrl0g&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQz8vn8ApN2p0nKEwz6OIxCcKbSJGS6eBnI2P2w2dda3g&oe=6B0B4405"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LnNq4Xj_OnEQ7kNvwFXBqwf&_nc_oc=AdraRkfc_sqIpfU_Fc4si13-IwlaRiDvBZGPs4tupUZyCwzpnd8VfXW-1ZYdVH1JGHc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRYFCHq3ZmtAQkmCei1gApd8pj-Wg4Y58kz4XSoNkP65g&oe=6B0B1952"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DQxJbDmphNYQ7kNvwGjzeRM&_nc_oc=Adq1gsbAMKwKaJzOKWOsf0LxHh3VySpSeRecH8YZ9WaFebyQGEENhTv86yuo1IMIm1w&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSqNKmf7ekUacpFFjrxg1GzSTzE_HYP5xY-k42WwEDlng&oe=6B0B1644"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K27yNVmeq-gQ7kNvwFey31t&_nc_oc=AdqROlrq1vKfGmqzHXJtPHPolIA_KT8HSAjQU5qygdz9_MUSw3CiUJW1CYYh-k7kkHA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRP3eb9OJbQY6QaxRYu8P32iX55DFDkM9EArB-eAVB9mQ&oe=6B0B3859"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JnVuKLwXRcIQ7kNvwH
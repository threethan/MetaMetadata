=6e7a0a&_nc_ohc=UV8oceCainUQ7kNvwFhb_MD&_nc_oc=AdqT46tQClAfFbwxPOxLwXpzpUXA3TVOAxqN2Wu2t8RucZ3NdYB4dZLbXvcDgl0y87Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7AEKhStnPHxLSuWVG9vahChbL5qyTH5_bgFoh7jpx0w&oe=6AB7C505"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rlziYRBq-iQQ7kNvwGZb4PQ&_nc_oc=Adr6_E0NRWpDc4QTAfPbHcrVqPDsGZbJGeD686edXAz1krcCLjV9ShpBIs4Zt8VK4Q8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxDWijyhdjJVzaam9tFnSRlD5qT2aAbDIdMX15Y4o6ow&oe=6AB7D292"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9MSd1V0yIxkQ7kNvwFRySkv&_nc_oc=AdqxFheMg783zOYCnE4sBg9M9bbfTTjucyhfXZWzKovl9Bub2gYGLmqTAmXB_UAEanM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJsM8Ts99kTZ-DqnsL2WKBO3lJKmwWVp1k83Pi-1oC7hA&oe=6AB7CF84"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vUGLM8hGE-AQ7kNvwGh3mw4&_nc_oc=AdqTNC8-Eaual7faBUbWaGhAf5kQmZ9c5rOuxMravvYCZogGpnXnmJ1SyZPN4oX1CAg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4IVuFGy5jVA7IptIkKFI1Xk_YVbYL7dHYcMMO0bm7jg&oe=6AB7B959"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cxhUORAjPhYQ7kNvwH8j6X0&_nc_oc=AdryVpsc9B0bLCEbyBi4YYZEdI7_vNQV-ZduJIRueis3DaOEzvKdD5aL3nGg4HXJpYs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIVcs5kifgIVg2IQL2ZLTJ09WZZN4NYFPvY324mg-SgGQ&oe=6AB7C082"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rpLZ3WLUy7IQ7kNvwE0FAp4&_nc_oc=AdqgXmKrYICpLh-xpeyFGeD-Rho2FFjz0drQf4tYtIpfDvNatpi4EaMDV
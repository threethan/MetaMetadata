=6e7a0a&_nc_ohc=H_2oKLFDb74Q7kNvwHIZkr5&_nc_oc=AdqNCgc-eJBcMG0zIfwcQrv6GhwZW-W1fZOKcov-vWBUGU0IDfzriyPueuG1aiJCuGU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrzY3VeLuwVp1cNW-czJbC_XERi1LqMim_gsCBVEqODA&oe=6A75DA05"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=epCQXZd3EVYQ7kNvwGu29qv&_nc_oc=AdpeXUua5vjVeZEELInGYhLh7RcRfLhg-y_VeShWzv38ytYsleFkGRCplDzfdTMnUbQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdd4oNj-MKnZxI5MkRscpXtYhS2gNbSVBRM7BjjUWNCA&oe=6A75E792"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nkxiM3_SEVcQ7kNvwHMOWvt&_nc_oc=AdpfFLtQgo-86WWP082IqXFbrEbs9QHyrjrWITPgtL07BHI5sCkCDs7FVZcqtMqGx3U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUEx-9YcwLsuW8a5VZak-ifMNw4iMNNuKNLGH60ZEDdg&oe=6A75E484"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=73T6LsSN3isQ7kNvwGYfOQI&_nc_oc=AdqkWgYi1ruyJ3iwO0NBqE-ZYhJae8NYSsQ8dxbcmHZYGKmg6yKvvFaCVNAay_brVuM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEUs45Hx0RMSODLhk8vvXSY4LWZ3XuMKTSDruaE43GJ7w&oe=6A75CE59"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=114exNJUXSEQ7kNvwElD6kp&_nc_oc=AdqgHKPWDTp9tGT-Yo3PIjgEnUiFMqMKF939b66a72Ua5OkphFG3ar3O2wNNA0XDMxU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFDk7or-wB8hGjbqEyUhsjaXBYgvIZLq-AVwsGYqGl4Ww&oe=6A75D582"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KXgCPzgb-ykQ7kNvwGvY-oE&_nc_oc=Adpro-6oYKNEV4X_KzUWasuEFUd_UsgsHoE9JRv6Fdf5UgUlzx4DB1c57
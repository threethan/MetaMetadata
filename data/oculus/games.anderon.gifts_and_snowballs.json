=6e7a0a&_nc_ohc=9-uGbwH5cRYQ7kNvwFcaoL7&_nc_oc=Adrz86c_wcf2WwPys4c7WiXN6Ee_9enFT6KbHK1-MhLlQLseDMcBvadnVLd70Zue8LQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af14U8yGkAJ86KQLqbVqn8qR652qxK_F1ITwPO9z0ouuMw&oe=69ECBE05"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5BQ-h1ve25UQ7kNvwEeYCWv&_nc_oc=AdpOOeqC3XF6vPE6cpzSo5ahNaUjxQyEh8Xhk1zyXbJC54QSypZQJsVceGpK6NBbBTk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2va-qdH8fxQMt1ePYd65Blb4JOi2p7zgQ-LliVHhv8aQ&oe=69ECCB92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PRFTM6vm5a8Q7kNvwHnyZ_r&_nc_oc=AdrezBTdGAbJPEe25UyVyBSFrJ2-nPJTDwv_7zwZ9uto5J_QCAxjM0nfMj5tPTkZ5g8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0yHdRipAVFebUd49abPcNpsyV65-oFecpuChXTYKSqCw&oe=69ECC884"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8lnuKT9y-jUQ7kNvwEqpNln&_nc_oc=AdpZttNb-Ka5hwhuxvt8gPCALFzDpLNqsKH-I9e3h0x2T4dtFEY5uXU9a1zKL2TAt-g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1wOWgKMVI09srkv2AiTPlxxyIP527UuuzIrnExxYM-mA&oe=69ECB259"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iUuuKMs9-awQ7kNvwEWcLdf&_nc_oc=AdoFD30Uw9KYTpk5m_rk6tOslShZGjkexdCe2yuCgokBjJzQmb440Bn2NcYihqHF_aE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3UM1HPY1ETVABM-lxXp8A2SQsUcXxGsDbIOCDUMNsO_A&oe=69ECB982"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dxkK3q6iT2IQ7kNvwGmSP-n&_nc_oc=Adrh2Eu4Jj3zn-5AvRZZzcv1D3eh_cm8b0ahVndPCtGXPB1e6S8rLCb0J
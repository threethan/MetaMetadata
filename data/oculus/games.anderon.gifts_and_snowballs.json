=6e7a0a&_nc_ohc=EimbWnSlFJIQ7kNvwHnnBro&_nc_oc=AdoGjPz1NJPoM-4Txb8reisIID5RyfwK8XJBe-SgMT9w1DIfhqvSnf_3RlOD9IRdXwU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjtCe5LSiT54fXQih_8hTwpGcYIRcHqFKuRO1FFCtJfA&oe=6AEF5C45"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vT3u_e6XoMQQ7kNvwFw9HUU&_nc_oc=Adp6bvjWVB6pIEjLHuX5m2CS64005GEnS8ReQtL8jH0UJPo0fTysGeXrj1fbywjtF8Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5B6V0UXIV4Y4HThkkfYBHf6C93mimGoi6sHFD57P5HA&oe=6AEF3192"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NgVJ7dTcf_EQ7kNvwEsqvye&_nc_oc=AdqvTbNBvMAX9kSGeCIZTQuCHbE_1OrGWel-hSjekhxQnRH_hITY4X2fzVezEDKi1dI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZ9TZr_NZzcQ1mAfO-oZMtp9m-EpIZIx9TsEPhtSVi-g&oe=6AEF66C4"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yNrR4jiP80wQ7kNvwEANUFN&_nc_oc=AdqPQGU18Mk8xeNiMNcA4wH8kQ51xF6I65f_DiW5BZhjSIqubFuzkahTBIi0iCEjjeI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNR5HMM1W__ot0_GVMUDTpwooXVeyw7swMlVzZ3dCqnQ&oe=6AEF5099"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aqSLENhVchMQ7kNvwHTg5F1&_nc_oc=AdoPRuVexZptqNd-Cyrls-x1gSiKPAgkI4AYLyMbngNq5CxOlr6GR390cnRbPyNwG68&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQx9zy4Yu-bnm3Tn_jHk5GBWr5Mho-EMYdOcWni7iCIxQ&oe=6AEF57C2"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fQWJl8d-NfMQ7kNvwEcdx8y&_nc_oc=Ado9FXVnVGoJq_3g9rle4IifrhoYo5XKehVtismml9tF9ussBRHxCTE8c
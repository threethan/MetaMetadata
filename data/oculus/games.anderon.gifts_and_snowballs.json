=6e7a0a&_nc_ohc=VRldfBFRXGkQ7kNvwFUucop&_nc_oc=AdoqDdfPws2p1JfZJ6Anl3Uc6Kafo8uqwc4yjvInzTQMMduos-oB5-Hnmy_Lej6TFMA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtdh67NmeNxGhl-p2k9OqXX8wBT2xmpaYodDZel_NBaA&oe=6A621385"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rexEnlXW8YoQ7kNvwHbJjY3&_nc_oc=AdrQpCjd6Wsxpsis9REvGhkv84yDfktMpTYkLoVpFhdokLNkhHY8TFL9BcEsPseismM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBoCu8mExiUfO1ZJ5JFlCWFwIKpq8cKqTuJIW9_GLM4Gw&oe=6A622112"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-errSZvcVOQQ7kNvwFIK8Jr&_nc_oc=AdrC4CVcukdc1lqk8Nn1cIi8BSiPjYGwtsidckjiN3rkfyQmW0GpCa39R6dIsr5EhUg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQARmqXXWsQ17vE1sd7YKSJaHo1rvYyMRP-ktpxrCiagXg&oe=6A621E04"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6fLvGzZ73EsQ7kNvwEP8HhR&_nc_oc=Adp1V_XBaCLL20aAtfP91Nvazj1EfyuqcWPWlLxZ2iByX-7ZoksgYjA7TULbgYrqFAU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAT8csd54KWzJgrkMGcQ50fIktmK-TgBlsrww-gsq7zsA&oe=6A6207D9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D_HSCSMDYwEQ7kNvwFbkVxJ&_nc_oc=AdobT6G0aohQycUml4AI3HUn4cDs5ZZ9xOZnhpDjsxm0BS3Sbfq_XPgCDH_-MhCFd08&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC5eoVjQNjKsl0tXO84IajNyI_dr83gApsbexnUYxyd0w&oe=6A620F02"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D_6AHVUJR5AQ7kNvwE_1Dtw&_nc_oc=AdregNtWUTye5njoDIVHN9Tf39jNcFhhgXkB3WN7AWtY99n_cEnCZI0mv
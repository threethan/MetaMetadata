=6e7a0a&_nc_ohc=H_2oKLFDb74Q7kNvwGtMrqd&_nc_oc=AdqmF3rOVuVIYnscEJdAXgQJBnn4wwObqih6AFhgTtJLAw-TOfMLfeYmMg1rM64N15U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGOlIktkj9iJGYotTZ-vuK_c09MCZtgsFb8uAh9wv8cIw&oe=6A772B85"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LPRwzHJewD8Q7kNvwFBOJOG&_nc_oc=AdrY_uKNoCM5PzdDVpCtRb2e-ziEDo3f4aDCNZWf4rfCWwse24BJh4PKrMBGiQ6yPq0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZxCr-h0sym60lVcRJqhk_vOjMVUx_K-NoMoL5qEnOjg&oe=6A773912"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mMMtCGyQTeIQ7kNvwFMSEF7&_nc_oc=Adpr0bopxJKtlqhity3f-miN32g7fYDaXoYhmz3fRkLlxqbm8ESCVTA7SOtnM8CmFh8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFulfUlnWLcAN719lDcN986wEn-FI3YqFGuokQmgKZ1Cw&oe=6A773604"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=73T6LsSN3isQ7kNvwFyJ4RC&_nc_oc=AdoYahH57sRSvC3DOQnAPgVT0vqh0yxhSmKKdlNYW84B4K1UnNT168x_o7vUzdArvNg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWdzeKYwG7SIO5ugeOHI56O8LJw1P774zi4I-5-P8WLw&oe=6A771FD9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=114exNJUXSEQ7kNvwF9U32E&_nc_oc=AdodBX5M4pWAsZxzq10SBbW0PF17AQo0qFRnxmPgxk-O3lFX7avwljBOFNgt8AB3tGI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHA0Roco8EL0-PuWsRSD6e4Gd4fgvOQtVb-03oERP52xg&oe=6A772702"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wZU2FXh7fmcQ7kNvwFtxLtR&_nc_oc=AdqmaIt28BpX_XsMUk4iZLmeG6bfiArIXsDJ-3cQszQykKjHd4D5qXeP0
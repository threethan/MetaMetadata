=6e7a0a&_nc_ohc=rtPGkPprmRgQ7kNvwGM5tqi&_nc_oc=AdrjzmvcHf1RN6aphQkPAPbiesirbBRS0wJq3T0bWxJQ59m9-aV05YyxpetXepFP5mc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSesQcviSTwwj8rXMzpi6yMYP4tSLrRii9RkaRG8bm1Ng&oe=6AEB2F85"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RxU-eDlEQ4AQ7kNvwFLMlmF&_nc_oc=Adqb9NJIL-niH7SO9vVNhywOS-zI9UBdBrTDehWe0GZHFb1jCkikWsaiHauxgt7RgGY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2zuKQVbxK29CE14gVWVQHLncU7NU0lnzwyNxpTRfsHA&oe=6AEB3D12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wZ1jHzVHeyoQ7kNvwG2UMIC&_nc_oc=AdqT2A-XsIO_sp5ILj8Ej6rFQSB_8EPsiOBdHq6yMkziQZ4wDpHDHsYOibRnrNhFiHg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLAR5Lfr3th75PLcbBQgtBXo-Ds4UsqMAIpQPDYC2Kjg&oe=6AEB3A04"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-AhT3j-IB4sQ7kNvwFuTRtu&_nc_oc=AdraZPRvX-1xSYRDc6h7oceqWAdP3w-0HvOL5vzNuqaSkNRRm4dfgapvyzBxUYA9rus&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSE3IF7zjWAQXsUpUfwtih6cmgIPNpdB2NGiKiN1WSVLQ&oe=6AEB5C19"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Z8MJkvBQRIQ7kNvwGh1XLg&_nc_oc=AdrNIoQwgr6bYHKM-5bgLzMqtaNpA4zdGvgXeRdzNaCg0wqz6j7I68WfE0Ii5iYBRxc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQG9eUv4vZCSFEE3h8J_Pzk3LxNhtg32R5AHyaFoOA63A&oe=6AEB2B02"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KXID9LdOkAsQ7kNvwF0fZ2x&_nc_oc=Adqdu4NgAWUhcVegZmubA2j7RO8VAoE9QMgMW8udJoA5WG-nuipDTQjGe
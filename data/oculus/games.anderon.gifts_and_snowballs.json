=6e7a0a&_nc_ohc=dtD5xESWOjsQ7kNvwH9zR31&_nc_oc=Adp8puTxT3gzTheoNRIwfR6C9jlvAlf3euX-8orSKUbHNsAsM1oYKOi6yHC0d1-EXqc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_FHtcGHii_RAgtqDXQSJ0iU8WPATP7KSCXXoNp4P-hQ&oe=6AA2AD05"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2MrgivPOHaIQ7kNvwErlFuQ&_nc_oc=AdpSs8uEqx5M-hsSrZdqr2TlyXnREdMwxVRB2qEn6IWlDTWoImwuq8KwCeXEa4ZaQT4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhZOCNo1hrBN6c5l-N6IHaHU2Ho1TB5FlAf7qaAYoCjA&oe=6AA2BA92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XCk937HwlBMQ7kNvwFHdBCL&_nc_oc=Adrf020wFUJiuYf_kW05nNijm3Q14doP-bZEASvCUxDzUZQU2QvGjBgxckwUB_Vxk6M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIwnwYMaiwduIzPkKoluJJu8450cT3wm8pRgBwIuQtXwA&oe=6AA2B784"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T8UcrmCu3SQQ7kNvwHw_keL&_nc_oc=AdrtkGLcxNrEGFvSsxXbwS_B30LR0cuU0KCpU_1b6aciTPwuhPkYS7AujxCHBhBpQKc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJt2IDNI-azIyHZ-UnAL769mTygbh5-Zh8IIAeoFKfEmg&oe=6AA2A159"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nSz7fgO9eV0Q7kNvwGRcbYU&_nc_oc=Adop-CJBcq7OKopPgsgmqxxkDFNy6CurNz5bSRFWYz62bOnK6FI6uC41h4xKqaW_DkQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIeMqh92m8wj3c7W0bDN60mcTvB4VqyCBdPOXK_3mT47g&oe=6AA2A882"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ppKT3O50F7UQ7kNvwG-Kyfg&_nc_oc=AdoUTHTeSAAEf_LzMq7OCiJRYuVsm7A92vxrdmAx5rG-zlFI90K9Y0QLL
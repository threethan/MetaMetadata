: "Gifts and Snowballs", "keywords": [], "long_description": "Gifts and Snowballs is a chill real time strategy board game. \n\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of the treehouse before your opponents!  \n\n# Intuitive Gameplay\n\nGrab your units and put them where they will be the most effective. \n\n{1036205311413455}\n\nThe goal is simple : bring back gifts to you treehouse.\n\n{1206127330542199}\n\n-Grows your bunch of buddies \n\n-Use your gifts to enhance your units.\n\n{7717030558386186}\n\n# A joyful atmosphere\n\nExperience the joy of childhood plays enhanced by a heartwarming original score.\n\n {793709389407231}\n  \nJoins us on early access soon !\n\n\n\n", "short_description": "Gifts and Snowballs is a chill real time strategy board game. \nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of the treehouse before your opponents!  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.anderon.games/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Anderon", "support_website_url": null, "website_url": "https://www.anderon.games/gifts-snowballs/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["
=6e7a0a&_nc_ohc=FwAWjm7kK5AQ7kNvwG9d3FX&_nc_oc=AdqqqeBigR-eNTBsA17K5GyQNTkgtJu5q36_mtrueN7dKmFSw2n1JtvQA0umd4O-qwY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzDwRJFU5T8W5i9IbuBwanWpiIFdydl4SaAH7qvR-TQKg&oe=69D10E85"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Td4dAdbMJ48Q7kNvwG4EbQd&_nc_oc=AdpBTDID5s9qi6gs84MFi1mAo0TrACmsUDF-NoolyfiBJq_IWU8gPOAnRu9betnCMvk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyXdaJpNm_ekNpCcaUIVUsOK6hvaAnYFocTBdij9icJZA&oe=69D11C12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lFk7pLOVVb8Q7kNvwGt5liG&_nc_oc=AdoVtG1eYV06wYOj_1KpAb6fwaRfy6pmUsdwqwJR7Y4zpe0sRcf__MjHFlFBe1sOhiM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwGaVmbe_Dc2ltugb52pvZOjfVbAnjPwQYVloHSKl4NYQ&oe=69D11904"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JAWezlLS-E8Q7kNvwHkEJHo&_nc_oc=Adr9DnJsdFRhrjPR2MG8rbib4gILXvoTjjS5rMCPncgOfmHE_H_ezw2QOKvUUEAUpDg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy_v1luEJv_IvRggQviWVEpKrU4Wm4K6GRhoZb0a1BOgg&oe=69D102D9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3d6_AUnP4vEQ7kNvwGD7QaN&_nc_oc=AdowRzKh0u83HiDE-qwY5jLCjkY4ZSS4GlSv2Q2w9cU36Dt2AiVuW5hzFa34FlJUCvY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxsuw22Dh10ylYWU_WObOM862H4zLKtJDjeoA-pIJZdsQ&oe=69D10A02"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6IQnpdQsGssQ7kNvwG1mdp8&_nc_oc=Adr6hPvYntNZ70u3m7oQnwjIiS-hNLPJTf2lthuD52OzZWLJ4cmPZ_E-z
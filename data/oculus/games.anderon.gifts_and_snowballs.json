=6e7a0a&_nc_ohc=JXLmujmDilYQ7kNvwE95skn&_nc_oc=AdrU608hOzOyiVAe2Lm8h3Mcy-09RC8Bo1P5mhtQWIqR6bWzKxJ8sM-hlF69tUbQBhw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af519ZiAqTu22glMUo--ZFYNwlYD03Tv0f6Nrl5aCNkM5w&oe=6A086D85"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9-Q7MeGvoPcQ7kNvwGMu7cy&_nc_oc=AdpWrLoJwpJFA1SNZWCuyIOkqXFKZL6U9DdFC5BfIii7k1u2EddmI8aVvrY6BdqILT4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4WhwEfdtYaEe75BMgyATgsOxFo6abGlPH3vma2j_9F7A&oe=6A087B12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IKhTfiqSBtoQ7kNvwE0ej3G&_nc_oc=Adr-KDfS90FqanGAMPMdQMv-myE3sdU6Ywvnxy4otkoPUYePpQ0bKLZwuoIPTstW2MY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Uh8aDJUp2jm5A33dqi9kBE3tDRXae59qXVKmzu8aJSA&oe=6A087804"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i-0Z-lqJJy0Q7kNvwEattTN&_nc_oc=Adr2emy3t_JoSPMvLdjJAph9CkGQldm2XhdhyiUKHinCiPlTx_uYqflR657WApYCcQ8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5m5Fb9lKOg92y9d4_DiO53i2_qOxBs6FxkPakNFp9lnA&oe=6A0861D9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z9l77cfTQI4Q7kNvwFBOOMJ&_nc_oc=Adr3TU-e8ZqtNLm0WwB6pIpGLaYf0XKTrx6X3GZn270W1T8Jf4QkPD3NPmS53Bq28Vs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af446tDEAqp_MXX2BosSAV4o__hXSJpI9CJSUOzyy3-jKg&oe=6A086902"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YVVwmb3lcIkQ7kNvwFw6RLf&_nc_oc=AdohcCuJwY-oG_CSwbibGlBWCyVP0x6gcGVIMlssBBrOriVFZ3_bUIgZc
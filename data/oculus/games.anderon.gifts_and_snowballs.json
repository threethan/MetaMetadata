=6e7a0a&_nc_ohc=XGgtyhmSfvoQ7kNvwGiWyD5&_nc_oc=Adpx74RQsLTobLyjU4PW9xZitKDnWHkW1Rty11QHSRkUKWU_dOQPH0n1IPNMMr42XQ0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwhGQdCJkOquZT7c6tAoOibjkLtahIOFut8qyobkDV3xg&oe=69C53105"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p7ZJrr60zrUQ7kNvwGzDJlM&_nc_oc=AdqdHuYttJhkM2LTVtM_iX25LfCho7yV9Dg7n_fodHlqghLQ19DV36eTcIOeQz0q4fU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw4o8QkHY8OY6sSWCjAzlxMUMqnbasgkKNYiE1XlLG4xg&oe=69C53E92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZlidPbaD1cUQ7kNvwGt9sw-&_nc_oc=AdokuX40euSOe8_Ec8LZlSLOmQeZp18SSM8qijJxTnFvqHpz5vyZCv9Gi4VMS2tx6h8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx-Axt-U5skL0cmz6-KaILI_lZz41eshdAyyYJAB8YYhA&oe=69C53B84"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nXHVh5CDmWYQ7kNvwGfhJLA&_nc_oc=Adp-R_Ps4ojNQ7h0jE4sKHYet4aqFV11RXqu_S5ESp_a5RhmAQAF2e4SMff3zBIaEh4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyplPDnKa1kmfju9r3b6uYIChYmLUph_39c6DileqJowg&oe=69C52559"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VEQvD-yaLCYQ7kNvwGqDZvG&_nc_oc=AdofYPBvSgPaZdLQf2Y3HPVQqcnK_bcoz57MEOkqUWOgeSQtBktW6DqbXqw1hF2nCs4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyL8eyBU2QPBAzoK_xumo59qYtKoqSNEOTWpJ2gLwTbFA&oe=69C52C82"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EPFdbBei1vcQ7kNvwHr0me8&_nc_oc=Ado5DGc0zDCt3CFDDZoNDXa1za1OqnxCRF3SOlFi5-RcOo1dctFbjK6Nk
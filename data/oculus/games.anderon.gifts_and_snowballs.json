=6e7a0a&_nc_ohc=kx4LmTWlw44Q7kNvwEuJNIZ&_nc_oc=AdqQIwvSNeFhjgVslxvYoqa6tihug9csECk4drHLMI6hmuqqbVBxEqhUraMhIl7hbMw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBbKrBMDI5STwtjpAgxOth2iwwIvBcwoCVkvzvRoNXRyw&oe=6A4BAA05"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ORQj9UD4h-wQ7kNvwE_enjQ&_nc_oc=AdpM4JtNANM2s0OtMQAJYriXdLTReEyLuKE0gWSaJytCGwxg0Mxn5hMN6C0w0X2md5s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDarBIbuLJTMMqkKyj2OGt8RzY6hs2VMtS3lkgfMtSo2w&oe=6A4BB792"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xlHc_p3NxRIQ7kNvwG8GXmg&_nc_oc=Ado68AwGN3cmTM5CjBmJBa9MeZzn2AgzTRPSY8hdezDS4z_GejDEQFi-CUCnMJB2Yho&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDDYCqrx0zZ9P6tS39g5hrPKAZX3CLfqYSZnvLP_WCFAg&oe=6A4BB484"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sGYx_f84CzEQ7kNvwGfO5Pi&_nc_oc=AdotARi3ezOb2ZT1OSRiwbDlkOA6eGHei-9ksW7x4e18g07c3If5Q7xgjxiVCn55Y5U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBwydnxeTzOlMTgtev1RgDux3idnJnn-5gh5WInqgMPRQ&oe=6A4B9E59"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6TdpI9LUAlEQ7kNvwFGCLUv&_nc_oc=AdoIRmZJOOJrT8nz_tdOB9HvE_5DpxYkl1tM2l5t1Q4B8I_bNOz122of0iJPfEjIrvQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDSFoAQYl4IpBFUkfsMSz9E_NIhE4qgcIx7vk54_9SBoA&oe=6A4BA582"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4SRhMuQjq_UQ7kNvwEw-0x7&_nc_oc=AdqbvEfA9aOHqpxDA6BdQpyxTWj2eO46eBOvIml3IM0GdEWfW-4yxdEWh
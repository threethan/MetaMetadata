=6e7a0a&_nc_ohc=pFKGixA5-TIQ7kNvwEeDZ5L&_nc_oc=AdoyRw5fGg2EConvB94Yl8Demf9NPlprbaHAE5gFBF10yQAdUbMuzBWn-bPwwKFy168&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2X3dbUpLxrMB8xijSJ_tzo6kxWF5zKMBETuCFW80tC-g&oe=69DCEC05"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t43DTiTYuE0Q7kNvwH1tDK6&_nc_oc=Adrm7Qc4VGEg7WXfpxyOUh9t9d8da3Rc54bvkVXoIkFyX22qp4qThT6VCEBhsbuZGVU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ZXlLgqYpzAwf41T4wa_e5LF6N7Mq6suqdFBh-Fd9sUg&oe=69DCF992"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HQ343w_viEUQ7kNvwHjBZw6&_nc_oc=Ado7B8qvci-4dOgbV93fC98a5O9bVCaW6ohjMRDMeLQI10Mr7X7Nl0G3AtLpCsTAunE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0hH89QHZeydxj6vejSHRibKrjJ519YUnA5CvSRpPn21g&oe=69DCF684"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JJ-hzLRjnqEQ7kNvwGAj-0c&_nc_oc=AdqlLHBF9kjnntrhkShIbRBzC3cwv66Hh4xaeUlXE-z5Edu6QuwSoDufHWslKxZkE7Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2M1fxGPfXq4amPgK_nlAyjeT_oUCzGuqSUqBcWgpDH6A&oe=69DCE059"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iQI4bImZK-kQ7kNvwGaeE5z&_nc_oc=AdrN6u9hL1RDcx9JbQrBNjar6Ie02eIKAWEROQsu1msW1UOqj6LIzzVXbf95SbHlV_U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3OYaFYtwSAY0MHbF1h9EYNFMTRzaddAFGbzH9XoUQRHA&oe=69DCE782"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QdrTNqVdX_EQ7kNvwFTzfhb&_nc_oc=AdpS5rLjBt74pyNYEiGGq-vjGfQUYgzYs1TXYM_YDsAdTJ0ex_l67DOUe
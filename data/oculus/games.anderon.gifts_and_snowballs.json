=6e7a0a&_nc_ohc=dDYR6YnUsP4Q7kNvwEufRSg&_nc_oc=AdpwuxowVtybcDuOyAGZlAyGxElVaBNMdB5k1toBUVvf4yAtrtdS7zjSBdrTy27yY_g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5TOWnrLnYoLMQ2OPesYn4W0JnO9TRZj2sfLqEDudifkA&oe=6A202885"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ErmKFgQ804Q7kNvwEcfQ4R&_nc_oc=AdqFIUYzMksqrQfiGdHpFYCp2MfJHv73x72uFoBZ-QkTlJrHvnCvBKPhDWwv7UsZC4A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6V6yZDktj9YLdhiy0Ud6tRSV5bOZ6qNUBDIFh6ZQRILg&oe=6A203612"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lB8O0UcI3-8Q7kNvwG3bYW9&_nc_oc=AdrF0LQ-qb11CfYkxFH6_5MamfsRXdHwRLT2YC8oeXKQ93U_hdjyrWX5ubC1B_Rvitc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5CbOUM7HKFxthKo8ItBzjCnh7-uO0emtu7hL4UCuG_EQ&oe=6A203304"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6LWFWASolXkQ7kNvwGAyMIN&_nc_oc=Adq4XJULeKGIr9iQYfKRquYItjhQJ0TZ8X32DVRD31U-YYhBS5wBep5_KDsBACxrJt4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7oQj02eKiSS9UD0NgV2XWYb83_7S-9UeaTnUFvxjoiGQ&oe=6A201CD9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-EGbuqfkd_cQ7kNvwHW-VMJ&_nc_oc=AdpZkWCL8dUk40M0zIWQ5lLr9mhoz7j5ahxuepHy3P7ux0lsa_smNXbjDVU57TNhf_c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7LnWIyv-fkNC0CXrIn-c0dWYClHEZW3IArxEUHxNHQ2w&oe=6A202402"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0AnYvnuF4LwQ7kNvwFF8v07&_nc_oc=AdpoCQT0TSSi2vbpGkVimi_LzyYsVYSklmEuTN-Tkuafr1ekiG3w9jEAy
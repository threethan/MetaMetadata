8&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kPbV2lIhG2wQ7kNvwG2A0p6&_nc_oc=AdrIOTFtbUuaHgok89Chetl9BGoiJFj7Sv0hYpzJbtTNWU-d-ZY-G4mQeYlefG-UkVA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRgllZxlnBLigAUkwXm4qamPX3Qxq1a-e7IxBomBNkuA&oe=6AA94485"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iVzLmt6PQO8Q7kNvwHF09to&_nc_oc=Ado_-yK8NFT8w6Tb9eBn3ibqoeVAx6fjtDsxJpc6u7B9Og1Zdd5W5ocJjEC-1VmZu8c&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIALquK21Do-K1FCpEAtrZ7gj5xpShXUxV5G7cBTdvc8Q&oe=6AA95212"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZRlgfTPyjZ0Q7kNvwEhKxML&_nc_oc=Ado-MDiRZbo-nLnDxMUuDJgBUv9etTxh6VaTf8BELcVr5mQZzk4W356i68U-K5gHz_E&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKgLLFiOOTPMLo49hjNDW5iSvsagk-TF_V9x7GFB62oRg&oe=6AA94F04"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vHVYupLKEyQQ7kNvwHO9HWK&_nc_oc=Ado0ncr4nf7YArkMFG-YnYgl-lbFW-5NCPd9v8MoCsmITOXBAhXYsFjmp0HXrB2P494&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkScUvgi2AvEvObpFMW4xCkZkdYsDbgp3w1jYZkJi8Uw&oe=6AA938D9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IpcxBVLeB5MQ7kNvwEAmWgY&_nc_oc=AdpXAICz5Pp-GUJO7gZEgo0PnuyjNe5hJsWZWEY-a6HyHIP6Le4i1gbkns_GWcIEPJM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdh_FIABwdbs3Xyr26Es7sDHoNXO0tHwu-83SJFvyDQg&oe=6AA94002"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ADCl6zbjrAIQ7kNvwFMgKFZ&_nc_oc=Ado6eJg6BgC32KGmkG-xYBkk-oNpN_ZmDk
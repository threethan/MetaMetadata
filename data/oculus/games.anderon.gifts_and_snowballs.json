=6e7a0a&_nc_ohc=VRldfBFRXGkQ7kNvwG0D_Dr&_nc_oc=Adq6OZYUmTT3WOBloi9MCj8oyPl8RtdyxIRZ1SVSlZ8nJCHOqkmeYWeNs279lnOBq18&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBIlrGPLB6lyH3_AjOzKsuXL9byVjsYl_KK_BQohCfoSA&oe=6A60C205"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rexEnlXW8YoQ7kNvwHnUl1i&_nc_oc=AdrIir4w5Ct-ndoOuFE1XDDXsprir9OxEojOz6sxw0vngB3e--xMxxkrCJmF19mrP3I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAweqT2iMD6x2uhj1ckw0_lk96QYvgQJl8bzB1KCe7FxQ&oe=6A60CF92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-errSZvcVOQQ7kNvwH3hbpI&_nc_oc=AdpFRM5nfqPdzSXdfL93RHSMltdweuz60RsfISyAre-uGOXWH0oVkbj8dtx5lV6PMAs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQClq8HEoKZKEQWZNjheWtCWHmNIJE4WLZwjRbVIohThcQ&oe=6A60CC84"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7xzAXSGuaSgQ7kNvwG6JD47&_nc_oc=Adq-RwqL6XUDtSATLAwvALIw10EOzWZfFE8T4HPvJTvaRRns1nxJX0BifvpCfW-g7Fc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBjhRmKEtwje-0umX70VClIBYQPfLiklgci8DUsuXcPCw&oe=6A60B659"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D_HSCSMDYwEQ7kNvwFOtOxI&_nc_oc=AdpFEsQgfF20GQMiSt5846O4LB2bjXoPRK4rlj0NfAdS5u9v0sCaPRVYvVvslxVPkCQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqzTGXPebAf49YIYM0flrtix7b_tNf65FPaAP9DjTu6g&oe=6A60BD82"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D_6AHVUJR5AQ7kNvwEgRzuJ&_nc_oc=AdoOqKF55WdecJpY1wO52UcNV7gKG89cI-zoW741ohpuMxWHuG22UOFxq
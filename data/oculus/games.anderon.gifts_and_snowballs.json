=6e7a0a&_nc_ohc=c9vHu2JofbYQ7kNvwE_L9xb&_nc_oc=Ado_A7tE1u5vvqzoWEG5Vc6LjSeCdsjps1df-VfgzQy0RM4uR3AX2aPE2u8Y6gyRUW8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7c4HMmx0oBOOOUWzRYbcwYhdGMs7alGu-y2Q_Dfw2Rxw&oe=6A16EE05"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6zRUXPza83UQ7kNvwG_QHqw&_nc_oc=AdqqMUolnPb1C4TqTUINlREMuLh6oYBIypCYOpRzhRhNaH0PbEyXrWIyRQlmkYUFlbI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5QzCbarq4DcLV4JPNs5iyaWaPZC_yEpyyumjQ1yuVeGw&oe=6A16FB92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iVZH7Y-fkAAQ7kNvwGwL37h&_nc_oc=AdqpSSt57Mn_gdCMznmsg4dnIOQHCm9o9jNbT58cHJiaci3p-2vdOoKLF1s1kUNDPUU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Wq1xgEIGA2NHAF6xzr8QChZ-E57lCKyIT4itzlnqWKA&oe=6A16F884"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gywwPC8mLE4Q7kNvwE9lPGy&_nc_oc=AdqSboUEq-q0gztVAWZljT04YLL2ovDKt3on2_wqe8gFX32CtkTCbCaLs8C0fNl3UbQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42TdQa1CL-jKJ2zyAqX3iKS97eQqMtYIJFT4pR9mRSuA&oe=6A16E259"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A5S7BQrWLhMQ7kNvwGLlPmB&_nc_oc=AdrZq3p7t9MSLlkqjQgdbsuLfEdZLieHUT773Y92dVwpxV4KPhxpEBWtDczuSugc4DQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5KoMbL2CLdHSpUqIVzwk1pyOfGZZKNvBwk0EisnpbECA&oe=6A16E982"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CEMPxpmty7sQ7kNvwFGChU-&_nc_oc=AdrPChpmKDbhiTLzV1h9ogLRfA61N5peJyMq3So4SIEkzLncXtgv_4z4g
8&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mjTsurLOFoEQ7kNvwFNHlbi&_nc_oc=AdpIv4zGBDGXBNr7w_00gaYSRbjOz_W5qYbOZ6XaZNCAvOWamNTZfNsWCHIjlMGCppM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpDDGSclRKNKkF6uO6ov3seCwnFB-HEzWfnPt-oAUr9w&oe=6A7DC305"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q_2vQfzqd8wQ7kNvwFuaFzR&_nc_oc=Adobla0QKIQkKPnN8aDj1SmecUjL4uTS7IF2WdnAlQSMPV41dHKeCdrIM4UTqoiRZ9I&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEpCKkul5naC_GCIsRr6PjI00mKO5LYa0-i7fa3SS57vg&oe=6A7DD092"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4_ho-Dik7TIQ7kNvwGfA-Xp&_nc_oc=Adp4qeraWuMC-fmeynLkvw9f_o0jKgEo1R3KC7TiiZwqr8pMA7HkIaEitiOAa50x184&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHkzHvPYP-zqXWexNv_EoSK92I-dcY2-A-RSJjjYqb6qA&oe=6A7DCD84"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tVBCB5wHSzgQ7kNvwG-iPSs&_nc_oc=AdreQ5239NUSkv51frOyttBC9tlNWrc62Olc3CnLMVDF1U4uQE9G6y4_SG-7g5jVDEg&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMrc3IJojdkr4ThyPE1VCZUrPK6DPNMcMd0W8MmO14Iw&oe=6A7DB759"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rcDA9pbOaIkQ7kNvwFFRIag&_nc_oc=Adoxia-S8AL_YkybvYMIL8-N3Op5UIBXbEFqTkcLKaPyvzte2iHknT7YSDvDz4Ld24s&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrwQGiGXpQUGg67olbNjng4fglNURdW61UaUzX5oQwOw&oe=6A7DBE82"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RSFixgF2z4QQ7kNvwH-cyDl&_nc_oc=AdouGSCc5QMzb3Sk9ySzy_dxExS8H408KA
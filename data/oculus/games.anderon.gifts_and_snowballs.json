=6e7a0a&_nc_ohc=j0--LyCGpikQ7kNvwH9D5wt&_nc_oc=Ado0XCqM7AxFtcyyBdVjEqqWc3ob210QAxWqAvMcMfTFV7msUwwFfpfxCtj1E8CxyuM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAVqwLkdcPknmttOAILRBpc4eO85Yat8-AhIwXK7Z02dA&oe=6A675985"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YWDWucN5csIQ7kNvwENSXUo&_nc_oc=Adpb1qfj63ynKej04zZ3wlzwcDA3PMl1R0cbTQPclk7wpWTOnSUyFgeWeaeZ42A6Ofc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB0mQ2FClNJKKsMdN-mfqz3ZFp-SMQh-mW1P4xfTkuzVg&oe=6A676712"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aSJJ1peUeeEQ7kNvwHZlLUc&_nc_oc=Adp00BDaUepTKEVqHa5kb0FhnhA3xKZaayvvgAYl2t20llzOCvI7fMKVtnDUmlbdIts&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBv04MKw3xtOgqudjbP1PFALKq2yEbKhXjVkNZMzonBLg&oe=6A676404"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T4Z9kZAYKWAQ7kNvwHRGXD5&_nc_oc=Adq5imsOSyx4AL-6GT7T4YFvQVwUXAjnL4VVuW9UBXGVM_mZoxDILZ54yOKG7I3GgWc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDPiJ59Cg1lQ_6WYZ_cIz_tZJmFA-4DDsUDNYNS-wq9rg&oe=6A674DD9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_7LhKZOqYJIQ7kNvwFsl9qb&_nc_oc=AdqeM3CK3DN7xZonM-BO7dpuhI5mgkoiy0kc_m6ZstTPGuOuBvPak0SNwcMwO2V5PGM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAD1kA1msX0CVS_sWwG3PF908FGNcVRoh9ilyHb0hqn_g&oe=6A675502"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RikoD3u3osAQ7kNvwH7QUFn&_nc_oc=Adp-HQ-JO-IjkHC1nEHGbL3iLb0_VrQatWzHsQHKFBULTcmqtr-P7UiSI
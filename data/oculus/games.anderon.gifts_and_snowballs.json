-ord5-2.oculuscdn.com/v/t64.5771-25/75286676_577533401544348_4203344657555901211_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NT1v1PGXe2kQ7kNvwGfpqPm&_nc_oc=Adl4P_3wUiRPC2pX_e5cE5PpZQOjZMlrwQUl_ocrgJaE4gCtAPH0IRvaeGVjPTH1aFs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxGruQL4hY8T4mXAMuAMAFFgvaCsz-W0poshrgf-GiQnQ&oe=69AC2F28"}]}, "id": "2073760636370964", "locale": "en_US", "screenshots": [{"file_name": "screenv2_02.png", "id": "993244952825890", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974853_993244956159223_3665934591366094743_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u5a6tqkixj0Q7kNvwFy8diF&_nc_oc=AdnPqIxZHUjWE5TRiX9_sd-kHGyhBy80R4BXRkWw2NOvXrI967pmdhpMI53KHN6ykMQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afwg5je0ABuwnugxrzseSBRkkv-pVv80tJq3Xn2MvcQFOg&oe=69AC190B"}, {"file_name": "screenv2_01.png", "id": "517646341325841", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572947_517646347992507_8365861269156842802_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zIEL2KyZG8YQ7kNvwGLr441&_nc_oc=AdmrBWwr19vYvCAGw9rPEZ7ghXjE_1S-VFFL_kOElV1naQWvkDNQ3JV9B4gH58D2MNs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afw7UYB6IO3qt8k_COMsFJU3l4BowBzYdn_rxNjDtciBcg&oe=69AC1263"}, {"file_name": "bagarre selectable01.png", "id": "987094796807741", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391822_987094800141074_5341301578934495068_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A9W-UoD88EMQ7kNvwFMDqrw&_nc_oc=Adn128LLo_DloHVCBifbEO0xoEiDwsOtWaCyQ-EYfkq2NngP-BmQPIAihV5wb8iuKVg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxEMN6pX1Ve7bm3e5rjUITmeNcLIATnIaNQVgYBRoNQ1A&oe=69AC114C"}, {"file_name": "pinched warrior03.png", "id": "2233739983674845", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391837_2233739987008178_5682748129040869737_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=POWb3C2LP_AQ7kNvwFQhjmm&_nc_oc=AdkYldBnbTo3o-y-ujiQTsDYZdLaOjr48RtjHy9kNdrzKvrjF2cVNuB12KEP2VuzLmE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzOOEdNFoTATPBinqTHTRq_Rlt1RHPLlLuK6eat6hwt0A&oe=69AC2485"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DFrNBx8eLgMQ7kNvwFStpqH&_nc_oc=AdlAUAeQEfeCjQAzm8SCc8wuHp5rBHo6n7XqFTyUYtpDdvtn7GRBZAtkiRYTmEGllo8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzQYqPzU4CsU0BSJ4ISAucrhpW_aOoYpofI1SpEM9MfJA&oe=69AC3212"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h7WAPYa6mKUQ7kNvwECNsGY&_nc_oc=AdllQ4snmQ8nbdufn-DR2wQBLuqhsfcRwqJy0t-x0R-rS6TNZNwXPZlls4xPSDobqxk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx50zCkG1_NvSXhQt8mUjXzvo42WqwWM5Y8bvnmBmQPAg&oe=69AC2F04"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Zb0naYvegYQ7kNvwHPEZGt&_nc_oc=AdnQCwbEAbto5CGDI6RrxYdyy1pGqatE6A8T_i3IXlH39v6rRi85XF_3D40JXiPdJuc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyD3YJEC3tYuvk7HQw92BeNxd936lLVtqPVo6sKDgSbMQ&oe=69AC18D9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Gjssa3IyzEQ7kNvwETAIqD&_nc_oc=AdkApXEJPS2thwCjetC6DpyrOahDzWXVO6xNBESasY7HjIdasYEArt20VjP8sRQO5Po&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afw5JZ3AeKES9xPqGwf5Z23yrNvSyQpfP49RqVNgSoPNqQ&oe=69AC2002"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fzDHDdKe0VEQ7kNvwFbJ0aP&_nc_oc=Adlr11HSS1Di-I43X59tQ50kENqsN7jvA-HR8cyCHY9-29_6TrEVG1XMCN6IINzmU8Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwGZJcPSGvWS_gT
=6e7a0a&_nc_ohc=6uK7kvigkxwQ7kNvwEvNJT8&_nc_oc=Adq7GK9Br_qNqLHxE1CWHX0Lx7Liihg5ixovbuK2e1H7dgGZSws5XCVkJBDvF-dOJvo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9whrEv05WWwnxMWE1Ol2ddRFx_wcXvVEPKYJ4yD4rPjg&oe=6A411E05"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J6BZDgvHdFMQ7kNvwEs46Q4&_nc_oc=AdoVk9sSkUvm1HNzS2VF1txPwhJu2qhovnrDnKf8PLxaEEt6oRiN5ym4M20mjuSec1o&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-n3cLket7scpa7WR14LdjH32fNW2pkJaulUoDeO1MvRA&oe=6A412B92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hfKallalw74Q7kNvwHhkCSY&_nc_oc=Adrj7qjcSWLRG8lPzbzS4pnNQx71gZzbQb9Lp2-Uv2UoVAQMQjvhgFESVhHtSk2TiWQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-IF4cphICxfbbrI5wbOkwLQVI_yDlioW_ojFmQGwBJ9w&oe=6A412884"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eeGjJfPYiWoQ7kNvwG34m3x&_nc_oc=AdqixhT3moGnMo2YoPRnKqktGBC5I-PFZqKhspIzU47aYuYY9d1_FVJ4k8ZqeM_r3kw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-WfL8sxY1hZaomdHLlV9MDnD4bOtpfq-p7yEftj3ttfQ&oe=6A411259"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W6LMviCWHRoQ7kNvwEf3Xv_&_nc_oc=AdqqQPNuM0ju8AiObOWQMSqJq3ABbXU8CPwDnZKpBQg3rilf99g1pCvjMqbyb7ordFQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__4D12OMTdwG2IUfwVBB9T8B4_2p4bE68q93OgvkxDsw&oe=6A411982"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yPhvkAeUG-MQ7kNvwGTAkR1&_nc_oc=AdptIORNYzpb6NGuRVIsApZhCyJBjo3EiTbZ0tYS_-YlbF0G1m1hLmXK_
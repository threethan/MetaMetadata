=6e7a0a&_nc_ohc=HyChN3YXSegQ7kNvwEY_4Gj&_nc_oc=Adqel8SRvkc93kdfeYJTr8IyAoqrytkDR8jV0bc8ALR0l498u9NnY_7EooesfJO8RZA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIoP_ney1rgboNHF80hb89uO16Qk7t4aIsjmXtyR9mVlw&oe=6AB52205"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GOm5V2poe94Q7kNvwHDnLu1&_nc_oc=Adr7gtwdwpz18s_xbSTrkwH05vFGrPEHiUh9bAbpLfatbTCAws59PCMeEt3ID82b9R4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzd6nBk8qCazfnOPLhMqWUB0KJo8pdD2j5FBQRItwbrQ&oe=6AB52F92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tiAp0qgXyrkQ7kNvwEi4c0c&_nc_oc=AdqO6jAu6msNulUhtydb9u-wTGcSySo6RyRVbrC97nB3hTCNL7zRa6eQCvITFa6AA_4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK30yrgB17gjauslj1MrgNhbTaZLMBZlnDmTAwdDwzOFg&oe=6AB52C84"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vUGLM8hGE-AQ7kNvwH60Kps&_nc_oc=Adp12DQuFmr0gBg8-ifJPg6JDNrsNzB5BsFRdtOg4EkrSiisJco77VP7Cs-vNhDLD9c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLt96deztCD_eZFj5SxRiCIDZxGCzfqLf7aOwv6y-bDgQ&oe=6AB54E99"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3XYprzAnx8QQ7kNvwEqkHJe&_nc_oc=Adq2ZJ4bMq7FHMP0_xcIs4ZGjSnpMYhLii23K8u4H9ESicwv-SnjB8JEKmyu1kSsRLk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLRVEknTSxGbDnIROTXZ0PS2PIkYcP1PDGuGDFfd0RBQg&oe=6AB51D82"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qsnS6Y-f3vwQ7kNvwGgxNSe&_nc_oc=AdrFM69knGDQt4-q3eIZH4258U7F9diSvTNhMXAQGMTa4odmVTAjdvZ5k
=6e7a0a&_nc_ohc=z3zg2Ddx5N0Q7kNvwGxKEiX&_nc_oc=AdrBVUJWhQSAcxJAdqSvDMXSAnRsDAvIjuDFll_lxQbBCNIk2e-6G5X9XkXUyIOAIm8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMsjbqPMKUwpPa_kKFb23CNZY2nelDm-9XJN9MtECtYJQ&oe=6AE5E985"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wTxFPED3UjUQ7kNvwG0J6jI&_nc_oc=AdqlNUBUVMefjC4pWOYFh5r7jiNLm8ae73k-OaaBLwJIfb4nGtHMd-zvFfzz-55EsZ8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM3CvJ_mBLl_zAe8n4ou_ezjlXWampL3NUB_MaZeOM5-g&oe=6AE5F712"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WpbvFmzdMY0Q7kNvwE_YW6b&_nc_oc=Adp19PaPqGiDaexBrsW5ov9RbzjDHnQodpdhT2fqszpvRKt7PJMbzQlEt2n0C5_KWGY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMt0IJ8htMvOSDXG0rcMqYCrEchRfjAYMGnrFijgP8DhQ&oe=6AE5F404"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c2Vr-_rHUrEQ7kNvwGmERJ2&_nc_oc=Adr85n2tujo8fAiWyvKdeprgDu_u_eb3P2SZjtk9oAtFYDm781Qx-ljmRqeZBbQdxvA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPc-n-Rt9d4eCHQ6rWdeR80lfRJEQqTXJ4cIkXov6ICgw&oe=6AE61619"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IXgv05YFa_4Q7kNvwH5wyCX&_nc_oc=Ado_8CB1fVqmg_qR3XiBmN4F8uwGqMTDyGVVixQzD42u-J-Wh5BHZHvQdgYGJSFy3EI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOuF77oX5N5RrhaMM1olzlmjxBEE1dhxvjmPOkZ3oQvFA&oe=6AE5E502"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4jRYY2ATWBEQ7kNvwGZqIRm&_nc_oc=AdrctNafiZiwMfp9cPrLqjEWGYfNn4iNg7Yh-uRZ8VkAelTHIjNJ7d53d
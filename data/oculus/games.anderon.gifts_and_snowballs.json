=6e7a0a&_nc_ohc=5I1fH99ZkhQQ7kNvwFy6Ti9&_nc_oc=AdqNJn1vIH9fCpDvAoC3lKHuh4WCMqgNxScSdBej7gYSdpjMPvJoC9w5gE21zTSKqWc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJiZy-OJyr6mIyvAW_E3r9Jp65_0F9fYVAJXMPMeypF7A&oe=6AAD3905"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SIIPrUXIJ9MQ7kNvwFOjGqo&_nc_oc=Adrw21MVqYvwCiujHkrCBpnJ0vq5s7aIEaJXGLi1TItmN78djbBJ3Tgy3bJ3CTYyP-E&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhE2xmdgYlijuG4pNsog0znSksmCR708fUi4fD7VCXfQ&oe=6AAD4692"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tgjd_DwmKOcQ7kNvwF1sAzd&_nc_oc=AdrQcU0WsV5j8HV76rYasuvH8GuJ18Kmo-JouZIQOciJ4CEgdgK5IJhruqeiUtK3e8c&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0pA_pjP0bV4CHd6kNARp2J9Rp7z7INOJnUwhhtRh3Lw&oe=6AAD4384"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X-bd-0kL4RoQ7kNvwHv4Que&_nc_oc=Adq2U1QhrBiZiNCnRSm91AAGx-D_4VWn3v4acphVfIvzetcMSwZ3qdfTRoO8nHIKdyo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSi9pRO9WQaBRPyP-QyYwk55t5n2tPD7o8qgW4E6GCXw&oe=6AAD2D59"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=684vV-RvHE4Q7kNvwEFOJm5&_nc_oc=AdpTCMpTIHd5gJadIFiNEFN1iN2pasEUbUYTNNeX61umIq5G0jaVAY3SAZKOwNkvm5U&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQICxnNYn5UnBCMH85HtWZ4V5jCMvqoUi4kjtQHIA3m7iw&oe=6AAD3482"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yGrKVFZox30Q7kNvwEZEB7p&_nc_oc=AdrCUkCH9UkDiimIfW7uLRQq4taf2jj9tzaC8KH_SpiSAvXTMYZ_gkL71
=6e7a0a&_nc_ohc=Ujc4I7m2oGAQ7kNvwHKA0t6&_nc_oc=AdqK49LDEjvpL-Xl_jHk7uoCXTa3cFWDWjc1XqenRx_fRRdVsF8rvxTHVhqkUiqqyaM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAHpHWJR7D_lgzBr6ii10vsimrj5Ad45rnANaMCO4kKdw&oe=6A563605"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Wz3Ipl2F1EQ7kNvwHexsZo&_nc_oc=AdpEk44oFx0_vSMBe5FafHZe0xL-9GbxyrRYmfIWJUHLzKCT_O9pz_YCvg5Hy6Tcnec&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAOGdjTDfhfOdjdKqDy_Z6uRfXOlY6fsnWYkrQeQ9pEVA&oe=6A564392"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2fJLzBpePlIQ7kNvwGOqdnM&_nc_oc=AdowE6ncPCXgfU9RNzd-cTHRimtVcAFvty4RKH31OSduHAsZ26ZhM7sk8LaACnw8ZGU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBI-S-t8l8FE_NO_HM1IkvMejUfzr18IN32jvg4dBydKw&oe=6A564084"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NyoZe3yhJysQ7kNvwGjiP2J&_nc_oc=AdrpZ5ztVJUL-Gw61wyLHYSOW4hGNETMZmnapTZkL7--xBsIEcuAEHGpaJHaHkakkzs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDyEFNWJ7QGlg--5CMk-LVD7-Pd3X2LogU4BZlE4GG4Zw&oe=6A562A59"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NpTtfAwiJokQ7kNvwHw-p93&_nc_oc=Adr7e4oQtNNAn9LtrV-HJN-uGevqPFppoFCAqboJ3F53KM4eaNiBI2a4FRXsy6IzvgM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBQacN3eLjb42uSpsTpQC6NbkvyA-GDd2t0Pc3Y9-ypZg&oe=6A563182"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zW4ItIjVJ5QQ7kNvwFwk36c&_nc_oc=Adpk9Sei_PxEsenoXxLk3tPO1GWLEzjRS2B7IE7N_p-g1_qy7wKFt5zQJ
=6e7a0a&_nc_ohc=63ahgwnp8LwQ7kNvwFfrxSU&_nc_oc=AdpATw3LAlnfbhC9FTrAVz99vU6B7TVr-uQwfTS1W57j1lzr1wD8y60CwvpSrOPpDeI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7FkcCpuVPF1WFiOin83rkk8I_9X8XyagkNHnTGFYSX8g&oe=6A1AE285"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EQs8fHQqt5IQ7kNvwED7HcX&_nc_oc=AdpgzSkHJeUyzvhupcLun3zZrZMguEeXyJ7A7mXSNNfQ5CpaOvK9a5RFpEJ9ca555gY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5kXZiHVVgoUJP1aFj8Bio03u0z2BpfoBWyGsTb1I91MA&oe=6A1AF012"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TJXmiET-T-MQ7kNvwEcvfZr&_nc_oc=Adq-zLXAv78ZHak48uPcJvoORl_N4Dfk5ld7mQ7In4GoQ-m0mhGQ6qGkk5zXa9K6uEA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43_jQ2Kab8kwZY2aoLargsmbSYkWd5drSra8x4Mq1ATw&oe=6A1AED04"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y4Ln6wOBs9IQ7kNvwGj2Q4e&_nc_oc=AdqT3waqRQI_SK5FWuCiUVgvnqGfXdczSpwudiAwDLfHUL6aNDUCjZVx2YcaR1xL9nc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6zEUjeJBiGquow5TJhqVviOjzz8lskglrRsW12mNBREw&oe=6A1AD6D9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3H6Ibn-M6REQ7kNvwEWDHOT&_nc_oc=AdosRmRKhdpHGfXoUw88U9dl6VmFgFZCJ3qcZC5cY-UlvON47Lj49H3F2ed_SaZJ0NQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af567o_EWwMGJqc4W6TaiqN8RZAnNLvHrh1H7qpKGA9yDg&oe=6A1ADE02"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JLgHqnz61JgQ7kNvwFycy2L&_nc_oc=AdqpgZTDveuHbwkt6msWcGhLuTa8D1ricNXk53VLclUWfcSDnmARG5zXK
1-7&_nc_sid=6e7a0a&_nc_ohc=4FGVqdY6Z8gQ7kNvwGZL4-f&_nc_oc=Admfjtn9CkmzUXuTQkPeevhEyxKjlM_uS62tjBgG0UtN2hP4KAGmNgQFuvz3ZIm1jLM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwbA8Rr8iAiTwMrqF3dOiBKPYx1EgME6FlO7EfMS8uFWA&oe=69BD424E"}, {"file_name": "bagarre selectable01.png", "id": "1129286058992645", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391904_1129286068992644_4827329140351720927_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s3Ii2lW7iNcQ7kNvwEUo9gT&_nc_oc=AdmaW9tr2nlCrPtcea44kobH-RDx9O9UgMBVEISlNUCLks8AzbS43M-1nF0InMejwnM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwpnyVFbTK1Z_sEaEAnbj8v9Rh-sjdLa8Flf6j_hdlyNw&oe=69BD5D81"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Prolongez la magie de No\u00ebl ! \n\nGifts and Snowballs est un jeu d\u2019escarmouche festif d\u2019un tout nouveau genre.  \n\nEntrez dans l\u2019imaginaire d\u00e9bordant d\u2019un enfant o\u00f9 ses figurines favorites prennent vie et deviennent les joyeux h\u00e9ros d\u2019une aventure \u00e9pique, initi\u00e9e par un P\u00e8re No\u00ebl trop maladroit.\n\n\u00c9voluez niveau apr\u00e8s niveau et disposez habilement vos unit\u00e9s sur la map pour gagner.  \n\nVotre objectif ? Contenir vos adversaires et s\u00e9curiser un maximum de cadeaux pour sauver No\u00ebl ! \n\n{969820411877640}\n\n# Gameplay intuitif : \n- Attrapez et d\u00e9posez vos unit\u00e9s sur la map.\n- Am\u00e9liorez vos unit\u00e9s et gagnez en efficacit\u00e9.  \n- Agrandissez votre \u00e9quipe \n\n{1670788776806885}\n\n# Une atmosph\u00e8re joyeuse : \n- Des personnages attachants aux capacit\u00e9s adorables  \n- Des niveaux aux sp\u00e9cificit\u00e9s multiples \n- Une bande-son chaleureuse \n\n{968721628509767} \n\n# Accessibilit\u00e9 accrue : \n\n- Abandon des manettes \n- Switch VR/AR facile \n- Jouable assis  \n\n\n# Maintenant en acc\u00e8s anticip\u00e9 !\n\n {1318855592629915}\n\n# Discutez avec nous sur Discord !\n\nUne question ou une suggestion ? Rejoignez notre discord :\n\nhttps://discord.gg/d7qA2KNYS6\n\n", "short_description": "Gifts and Snowballs est un jeu d'escarmouches festif unique en son genre !\nLe p\u00e8re No\u00ebl est devenu fou et laisse tomber les cadeaux partout. Exploitez les capacit\u00e9s uniques de votre bande pour les ramener dans la s\u00e9curit\u00e9 de votre campement avant vos adversaires !"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.anderon.games/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Anderon", "support_website_url": null, "website_url": "https://www.anderon.games/gifts-snowballs/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9277539205672577"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391749_586053650886050_2805506039663473676_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dfV_SqQB0h8Q7kNvwGNwDgR&_nc_oc=AdkWvopjKQ9KsCzcw1hjsIMSTZ3txjCrLr79s0WgVhGoDkWB9E2uU3CwXAXUFLL1s3E&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfysBOfeltBy_Ygiuz6d24LRXfOJE39maBQR0rL5OcWXFw&oe=69BD3DD0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "
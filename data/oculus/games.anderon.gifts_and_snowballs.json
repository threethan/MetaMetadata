=6e7a0a&_nc_ohc=VtZN6ZZKs8oQ7kNvwFgf66W&_nc_oc=AdolrObJQghY7Qv2bZhdbGtVPieTF30lgXvkXRW8g6Jd2aMe8X-WPSSx5E5cuUB-Y7o&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHE6MACwHmgxjW9UguaXYagjC2xOgJRHTfa1KnUe2mNJQ&oe=6A918985"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gogbfZvhaMgQ7kNvwFpERvt&_nc_oc=AdqsazraX207bxahiB-kHmHnm6g9IG8QIQaOSdzpJ-e8LA5DMq9r4T9R1NboD5mSetE&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE9KgP13jXTXLt98OdWxe9qMeJ16of7vHCSuHrOXH8_Ww&oe=6A915ED2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vqQPR7jc6ugQ7kNvwHDakyl&_nc_oc=Adp3kBFgaVhougRNpGPe8TT52_J2XEU6Jqe0_XCfoDsQI1vuCWmh2ic21720qbk1dXg&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHC53HFuuGfruogGYEtRiHmal7Ba46bE82F5mNF9qW-0w&oe=6A915BC4"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1FmqEqW3x5MQ7kNvwGbLgDk&_nc_oc=AdrmcGfCMGTpK1hUilZI-2GjtW_F43z3iU9AH5yAj5hWQDVcWKbW4bAUGXoiH90xjRw&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGoX7Z4tPATRQNohEF2V8SvZCDNGEFTGL0YV4DIq6A1Ug&oe=6A917DD9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PBIVaA41Qk4Q7kNvwHpgTwW&_nc_oc=AdqZcuBiwFonDvRVKV7fMnvwkiHzsPJRY_G-R8GZ55JJH7OXkrTDUamzSpojI_5F10c&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEkfGbnmJ15vQj09X3fedSyoznpPL7Vln9z66-PRgt0XA&oe=6A918502"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zGs4S_3ZPgIQ7kNvwHlntWh&_nc_oc=AdodDUK_ptlpqQcTPjWb_DsHmByFm1A14l3NVC-CcJqhxIhBxqexK2T6m
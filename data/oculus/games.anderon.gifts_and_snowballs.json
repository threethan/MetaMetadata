=6e7a0a&_nc_ohc=DS2BwO8xm-wQ7kNvwH069Hp&_nc_oc=AdoPD8yt5Ul2XARx58ZNMUScSgwGNoPE4M4R-tX3Wed0YeMomHG_VX2ooSQ4dvUXSHw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3bszfCg8KURIlnbfmxOSQaP7TOPBqtbqUOZyi0H0AJQQ&oe=69E77805"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6LoX7LqJJKoQ7kNvwHXi9kp&_nc_oc=Adq8drs8pRe6r-YIjXiUMvvf_kAubrDTRfvQcD0oGjMiyk4ET80ll_lusFLlNTAsqbE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0DcvW6kh3bY-6365ekFUo0iFxYSUGhhqKZXqq_eXJDZQ&oe=69E78592"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_0Dz-khOfmcQ7kNvwFzqXPc&_nc_oc=Ado2uDuew74ZpCQeCK1iQ1ldqQxN3WJQNQhp6kggW672LgEkpZmwrLHr-2qusMXWKMQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Kqe8dmtoWVZGoYeriEa3h8yCBoA3RmiGtE8LGL9OBtA&oe=69E78284"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O1X5J-IT14cQ7kNvwH-WRSz&_nc_oc=AdqLnWhAXWZzkBY36j7sgD4o-h5FpoD6H2cqZBFHoj9Ajwmikbb3OeWqYGAbPRbImWg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1DBMYR6p1Zr-erI-uXT3eR80FRoX-7fQwG0XL_9ZkS8w&oe=69E76C59"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_vG-uinOeCQQ7kNvwFjccmB&_nc_oc=Adq5i-qUvbUv-2FKhlRJMABUhjE5gx6sfTpfr5ScWlc4JfYR8P1Mt3XjW9FSQyGLXK4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0jD86eG6_Iy9aI_ejQ23bNSBouqvKEWv5pT6OIiBjVUQ&oe=69E77382"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y3EO7PzMrwYQ7kNvwHznvXD&_nc_oc=Adoll9IBpDl7QdXQf0hqMRMCb5XzjEmmVWgVq5ktlZn23r1kAOfiWda1U
=6e7a0a&_nc_ohc=_IsQRr7iOmgQ7kNvwF1HlSH&_nc_oc=AdrLKQHoDzjD3CbksHTxoxbiUFgAJ3afg2XrobisWI_9d0U2ZCnaA9jJpoRZ_0wHsKE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3igXyvvRPyBN6j5EP6oGzozlcIO2YaGcUIBlGli7eAPw&oe=69F89B85"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hW0UjcObS8YQ7kNvwEh289m&_nc_oc=AdobVW-Gn-kVAKzUFnGunnTGfcfzKMRVyL05pTQG8WTUqDw-VZkFWsTssBehePFB5rY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0EGVkrVa9t16R4hvYc-IsjPx6Lsypq_ibs0UBovrIPgQ&oe=69F8A912"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xp0Dy2Im2kgQ7kNvwHHLYCF&_nc_oc=AdpwUD_nN-7KZ2avKB-T2cOUnYI_wLpgQIoDTpkQxQ9JjdINDAZmoZQehzENUzPFMOg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2lX566Lv37dXq9xf7moGOYrbL8-802SaKPs6Vg0WaFOA&oe=69F8A604"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7OAfc8tJ8OcQ7kNvwFTPySD&_nc_oc=AdpdXvkAiSgPFVqTl2lNmen4QxE3TLjxudqa1DmFB62K9mDzre1TTYPMIBkCkGb1j48&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3PbaGv-IwR1uONN-I8ZeO8uMFR72CiYdKcYjP3PAJzPQ&oe=69F88FD9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ueC52tuV5hAQ7kNvwG-2l45&_nc_oc=AdrLfAV10VqgBHDx7bhpLI4r3jOxyau5PfVUKntTTwshztxd6ftrUBLBA681PWUjEjQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af316zs-yE3ZceFu2JZb2nLEHgmNY03Pzn_Maj_lhWoFeg&oe=69F89702"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ybte80d1Q4Q7kNvwFBNYzQ&_nc_oc=AdrchQLjkNeXTk-ZZV_P6PoomWbTFmcOII9DZLsBU12l8yJ9R2mOmDLui
=6e7a0a&_nc_ohc=FwAWjm7kK5AQ7kNvwEkzpu7&_nc_oc=Ado2mIf0rDUZPjh2vPQnBZLW8Yx0RcPi0EYTeKckBrzFOTQV5n6uIsXMSJs3iqCZrBI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwFFDUr6qB9ObwZ6oN5lA3UfmcPNf8P5WaKWC2VlaoOVg&oe=69CFBD05"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iHJ2O-FGu2oQ7kNvwG-SWAP&_nc_oc=AdrbLeDHeKobBg5cZLlSBAA2pfz9WeuvwxPFZLL8gYJNnFybuJ0_hxgcnxVZ3BSfAgo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwN-hQtj6QuboPzTF1BrXmvFIHTtuEBsSulvYHcK463oQ&oe=69CFCA92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GlJqBRBv38wQ7kNvwEkn1Lp&_nc_oc=AdoysusvwSZPqhqtew4760e2w9fHrNKK2wh58fgZYbaEgcCj9sCqwib0JBWI54Oecls&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz0mOvaMQx-vcDe8U06N9W-j-dd-CcEx_x2ZsyXJdZxJA&oe=69CFC784"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JAWezlLS-E8Q7kNvwEg2nLu&_nc_oc=AdqzXjwBLcPHPYOvrlvCV1nZzY1cROKcQtokgwRSQ2eYP90Y3T6nx4NUWSA5ACY1jxY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwk2IJI2up8yEFIpuoNtcSR9uI3SzSaotYIxCazpbxt5g&oe=69CFB159"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3d6_AUnP4vEQ7kNvwFH0edu&_nc_oc=AdrPcs3msx_xdJoaZ9FPKwYOvz182NuYurGFT1ir9hvnTjNU8RX_zhY-AG8QKgEBclI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyaIxABGDN_GvPQa2yEtjzz-81yIYygbfvxdZQ5nNJuxA&oe=69CFB882"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hJSI33ATC4gQ7kNvwFLhIgB&_nc_oc=AdqbLEcmhpouDc4yMNP02aTS_o0mWnGSHJo6g2RsGd8E_0n8OMaVq1qzv
=6e7a0a&_nc_ohc=3PDxvHcrlBwQ7kNvwHKdMEw&_nc_oc=AdoT3WipXJGLAYY_bfPboZWyJEPIK1YZSOautvtEnqSLi4BEQykZ9TEVCIJsl-zKeEw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9HTWLo5-C2zkyDpF2wEpJblF31M0-miDm4yAq4wFegWQ&oe=6A256E85"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9fsKev3AGOIQ7kNvwG_K-Za&_nc_oc=AdqpzeaoXhzt9iOwzzx7-vEMabIqzXjofYy-1YG0B20UlTmZHxMGVVzYgkDt122zWBs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vGKbr6-1LVACemmSilmwZtwPOFlGZYnerGSRCKmyEvw&oe=6A257C12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2i9XWCdXBfEQ7kNvwEqnC59&_nc_oc=AdrPH7-_UkMFGRO4_BsFW_dhPBJvuEHwj3riBnLrIJkoWxcxYHf2V6ImIE6haX5ox9w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_SQ0xPcLRU2X86BGUUuGlDNVv8i0YgWA8u8ZE-AxUttw&oe=6A257904"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gob7rSn2qDkQ7kNvwHzrvPR&_nc_oc=AdoSj8g5Yj1aig3JXri_dDtpHYfcA4kL-h-xR-ikDxeTiVm_UEtDIZqQlBNlLxrIPPw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7w8Ko-BoF93PZ6RhR8CerqbF2UQSlRb_x9XaoiqicwA&oe=6A259B19"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d3njX37yjfIQ7kNvwEGdgO-&_nc_oc=AdrM1v648yEWhjBsrEZI6MvY5c8cEo4Z7NJx-S7cQSVLQDEcwjqqFo0UQ-ESx5XfTPM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af99Ke3S1QxnD0lP4MLfObuXFPEnRnyLcDUv3gIrbY4vKg&oe=6A25A242"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KQl8GUPODCgQ7kNvwGVBB7E&_nc_oc=AdofbMqEEYCu6pfkxpfISEecx9T-Ek2n_udb2oEh8hooN4_EdqgNnuSq8
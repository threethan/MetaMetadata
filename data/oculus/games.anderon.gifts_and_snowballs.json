=6e7a0a&_nc_ohc=EimbWnSlFJIQ7kNvwH3RN33&_nc_oc=AdpuKl9FM3wT2I6Izej7k6ilnNrmhs8aukzQROIZoATF6YqrZGtDI6OXvnUnBzNcIf8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjJD1aN2qqHwbn2FiewFsU8bYfPbgq5KrvEKqtfqYnGQ&oe=6AF0ADC5"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TSjow23PBXUQ7kNvwH_2uis&_nc_oc=Adq_PerRUUK0CidZgKkKJCk5zIRkR9IqX0upbjbJWke6TAgMEKarLFLStJM7rURhoIU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWvqsJB_tcC_-7lP3kWlrZKVDDg0ET_fH_JfEVl5Oncw&oe=6AF08312"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NgVJ7dTcf_EQ7kNvwE0GZ3S&_nc_oc=AdoueoHLKWal3BC67HwOplvzdOj24Saa0T13y18lY5s3MjixNv9t4ymn7Jwuke3-G6s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRcmm782WSaaBJmAAStzbUzHbRfDrVfmbSafwyDOiFRg&oe=6AF08004"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=frs_XD4Hpd4Q7kNvwHv0MPi&_nc_oc=AdpjT_rWkHaVxMPGaEU86MOmjFr3XrSWxoRkEDVdvYdoa0BgSsAPGMXKKZI4PFyrNqM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMnVxYopNJ9Hz2D4z03Ru47WOU-aH_FPwRDdBztPQhCw&oe=6AF0A219"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aqSLENhVchMQ7kNvwFiAUFf&_nc_oc=AdoburLi9GX-4cBuLQE9WXu9oKSEXl5R1jVx5VRTy0NEo5S4R65FbYRZzdpG1qrPmbw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrzzeaskFFP7kGNUiBYGFNSMp4gDGG0xHhJfR3GS5i3w&oe=6AF0A942"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fQWJl8d-NfMQ7kNvwEbbbXh&_nc_oc=AdpzkfTO0vN67PFjxmCJodHo1NVsbImmo9_dKLUKMtmvTir4uZSbiUeit
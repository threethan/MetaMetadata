8&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OPaSjPl4lOkQ7kNvwEU6Lqc&_nc_oc=AdrqLoVkxPBOzi3hCKKJBGWiCf-mDwAHlsunpScjIGXyBuw_gv2yP1OAVIli0J7dZWo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJcBUxrqZINJkTyVDjxNid9pDWm2rVVts__ANIJWm5IkA&oe=6AA3FE85"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2MrgivPOHaIQ7kNvwFPKRLl&_nc_oc=AdqodMGj0bmjIsDS1K9HkXPDrmqudsdjuR9Au2xt9iN-pLrTkkHRCpRkcvznHWP5MgI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtT82PBNQ12Hu2M70518nWtssiWysJeoE5IqyYSGrg2A&oe=6AA40C12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XCk937HwlBMQ7kNvwFae1Q3&_nc_oc=AdoDK7kCrHKEHmmZkg7uYY7C6TUa4xYMmUYbTvbsy2uBXRrUm2raMFshFYO2pdxi_BY&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxMuyQI8u-I6MpHqAbIihhE6qpEUgCz7U8sf_f1ZpYbA&oe=6AA40904"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T8UcrmCu3SQQ7kNvwHbLk44&_nc_oc=Ado2_V4O8kAKq06EBmvwl1PPUz-nzBvqdS1T2Kc19E5aYub-ScSaN8bfwdbhAd126lU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJShRG9gZVCPhzcmARrSt3x-1qDN1pjLP7v9w1xvilIng&oe=6AA3F2D9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3TiFGzShbKsQ7kNvwEsCJ56&_nc_oc=AdofE28MmeEUcMyxl9pL9ch4R29pMKMGiH2vXihlBGiOFfSOgR7AAQXZHqEFxWNIr7I&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBiQA-TtH_vIPJXQ9wHEZsWfp2i2fX3RuwPhadauEXbw&oe=6AA3FA02"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ppKT3O50F7UQ7kNvwEFC940&_nc_oc=AdpQB7e5L8P4EWuV9MhOPBgZ69EhhByTO_
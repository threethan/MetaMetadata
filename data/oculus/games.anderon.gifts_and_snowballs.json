=6e7a0a&_nc_ohc=XGgtyhmSfvoQ7kNvwGmHacc&_nc_oc=AdpUDg6WTu39w8MY8JlgG71No709oIyeUliszj_vSIAiD7by1Tn30zcue4wwybvDQeI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwyokpk2Et3zKmEDCJvvGkdwS-ryxy6qAzRFrpjyQZJBA&oe=69C28E05"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Unbj7qlwQGQQ7kNvwHwKQr_&_nc_oc=AdqhUszLA9h-w5sBnVnUinFJos6g5f7qyFVT_dJ2i0MpI0axvVXk-Cb6ASrz3M2eqcA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz8ABPyEeMcF53GtGmPLJexyu5lqxALOV68sZe6UlDa6w&oe=69C29B92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5qWe9JZfOAcQ7kNvwFjrr61&_nc_oc=Adqqy2smE2mSTB-hsM8p3rPTNwVXvy1frpD5Xx_z2k106lw7LtNMHAF0DIUwmLweLRc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwhGCZN3aadTO0G4O98IIuXy47yoYW_OeIeneazrnAlTg&oe=69C29884"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jp9A1_b51qAQ7kNvwHT819C&_nc_oc=AdooXGAwB-F1TUyf--JlQBqo_WWSZifnrXS-f7uRYvDIrEe9wjagTICzPfZfyLcGBNs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzfBxRUoaIg5Yth_vA04Du1J2mPhtaSJOG0d0pViE7WZQ&oe=69C28259"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VEQvD-yaLCYQ7kNvwG1bN63&_nc_oc=AdrZrzxxsaE5Yz9SehEZhubw5YVZNBN1RE0GTrspO2ktSaMHcclMnvpeS8SGHTFg7NQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyOlciYrQYtUU2i3IrXxb2ByeD2V1644o7vZEHi_o0UQA&oe=69C28982"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zSrmql89ZcsQ7kNvwGytt25&_nc_oc=Adpnc8yEzRJg4OH4IRNtv6GFQvQGFHgSj3S2ZS9ZA2vHQ0sfClADr3krH
=6e7a0a&_nc_ohc=kx4LmTWlw44Q7kNvwGvpYoB&_nc_oc=AdrHmFI_H5ESegS8EKJK2X-SsDJaJXNRTQmH6ORtioRs-OtJ3r6mfmByIMkBjCuneoQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBQqPedXnEGSS2bg3BGTOO-02OWRJXwZurb1MgV16alMA&oe=6A490705"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4bRhRuH_dRwQ7kNvwGZz6sU&_nc_oc=AdrVHTJDWwqcjeMs74-bQXXAqwbJTZzvIqzgCBPMoLj1SVkkc74HgJ4lIci7FkBRhcw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCdz5Dv8UarJxAadKxiNqS3nMyLNN_TZ9pTdALK1CgvOw&oe=6A491492"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ngjNwR-Xk4gQ7kNvwE5e1qA&_nc_oc=AdqBANzJYCV9a895at6Wu2oGySCdsn4tZW3f2-5AJz_Ywm_XxnxWtPo8xIpx9D0DJ0Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA2SgvMXXUvyB3Pth3uxkyai3JMn-jhXJZbPVbeHbcDZw&oe=6A491184"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LC-7Iqwu68IQ7kNvwGZvf80&_nc_oc=AdrtB2TBVXaSJyHj0-1mjl2ODAoEHhoJkWJ_a5sXp-qMxYQFLLt1KTC7_r77FV-lwzk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBoCDlvVmib3FAtwcqqRzAlCQPP6ZefVyAadSROwgwJEA&oe=6A493399"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6TdpI9LUAlEQ7kNvwE6O7hi&_nc_oc=AdobybPWDxCBSvGoZ2V32kOnX-bug10Q3cHQic2rnsQO8Mno-AvSKZ9TnjdQdXSTvVc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDc4npsXiZr4_HtMiIpBD6t2MOohfJxzrdjsqAjnajvMQ&oe=6A490282"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-G-D9nj7CQ8Q7kNvwFDo_Jq&_nc_oc=AdoU2beFIOpYD9G_DLMNZibxJxCjaFupfUxaS1VKcaD-BQygT6Ua23o6k
=6e7a0a&_nc_ohc=kx4LmTWlw44Q7kNvwFVrlWh&_nc_oc=Adp0Xw2VkRAaQGU5kogHhknSxNLPnpZSZFDsRvacobiuTlDG0RKSm2hvbuZrsqDTa-U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDFdRVOW8Jy1QmUXYzfAz8vtxjLiF1vkJwoMmgPm2LXyg&oe=6A4A5885"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4bRhRuH_dRwQ7kNvwEm6-G9&_nc_oc=Ado-FWldhIiTpWKnxdS6UWDgCHXiUy8vRLGJKbmZoONhSdG6Ak0xQscnNGBxMPg9QTg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDLsddJXRw9XOHe5_wQca8UgH0T2dv3pvhwxnw_XM_dNw&oe=6A4A6612"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ngjNwR-Xk4gQ7kNvwH4ZABA&_nc_oc=AdoaYKBhNit4UYy-h1-laSeY2BgvgmJitHs9d0SvpUMdbD7Wv8rClXOKcMYarTYHp2c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAwr0BftVRTDZmuFXdMQYieZMzn611GdV23y1qwwhQLqw&oe=6A4A6304"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sGYx_f84CzEQ7kNvwEHJiMT&_nc_oc=AdqTkCDw-ztAbjieFf71E_7wqGdvdgrrGF474pssVozB813c1UNH5mYt5Eve7vi-bE8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCr1gZrlo6wgw3bciJFIvhpTWHictbbpqWwx9pLNpykEQ&oe=6A4A4CD9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6TdpI9LUAlEQ7kNvwHeFA_V&_nc_oc=Ado2gXlWZHyVXRRli54_puNWi8wJ_GouS3yMJbRRpzk68upvqYOyT0gFtVr4lJKbmP8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDqL7pvOocAwHhIYyLclUqLv0m3vexRYb7Dv5EX0grFUg&oe=6A4A5402"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-G-D9nj7CQ8Q7kNvwEDRqvP&_nc_oc=AdrsRVcUjXPHCiXmwTnGaoclq4a1nmkebCKS4qHg7p9ZkaidtDU22QibF
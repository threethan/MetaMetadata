=6e7a0a&_nc_ohc=U1-rqP6w_O8Q7kNvwFN5d8A&_nc_oc=AdoYGrJX7GkaMsSFfwNZRlJely20Nk_h3hofqUFfcMyS-VsxJvsuCZQd7tb3ZdwPqjA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af59ZGlCPHen-kRs0NT0Orf_AbgpTNQaJcJxcVuB4yc7Pg&oe=69FC9005"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pKfQ3NNe9jQQ7kNvwFdjnhr&_nc_oc=AdoI90ZzKXc3tKXasGlYKNOHhgzvGnPlnVPfc6r3X6pAu4KG0e7FA9-IeoOq4Y0n6K8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4P-1qnzg-R9S1vJDsSRDNAJrhB2Oek1otoAHg4tJseWQ&oe=69FC9D92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5IL6MLHBavQQ7kNvwHFqqub&_nc_oc=AdqgPtjCc4E-rJjiZbQ1IPfvZOFlcNxOCd0I1OUsBnSmmc0phgk3vxf6hFxKtG870Pw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7MZ_eaXZ6Akdq8ufwBzoBSzLWZhXJAqAfC3jgF74ilbw&oe=69FC9A84"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GWxt_YnFP6gQ7kNvwEo8n-y&_nc_oc=AdpAan1SCR2Hfr0ZbKXxV3VHjXvkX8HaGI3EAi8hfZZmVtMzFvjXzyxJYOP8imj7MIU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4FG1IoqW9HAgPc-AXRTsA5TCpV1hYChN_vurE2UsHXLw&oe=69FC8459"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=azJ-LzM2hIwQ7kNvwHSBIQq&_nc_oc=AdpkZNqhuole751JUBerv16b9ITHieX4PJHC5p0OjurtUkRpCVjR6wALtm6rFI3UsrI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71iMnsWtsDY98gj-Ue7ly5FwXzvOiGZYsiOg-Hp7_HQA&oe=69FC8B82"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mirpe3agzX0Q7kNvwHK0OMW&_nc_oc=Adr4Y65jTeflyOIFReWk3xES3NVswDfBMVNuCoXn7ybIA00DtgkxG__cl
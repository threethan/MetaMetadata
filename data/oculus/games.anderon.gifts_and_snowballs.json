-ord5-2.oculuscdn.com/v/t64.5771-25/75286676_577533401544348_4203344657555901211_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ulrtC_VQ4N0Q7kNvwEbVJsG&_nc_oc=AdlCfZHlj8rePL9gTb8GuxGQ7hTnjP17DOTvIzFS4f5jsnBGcMT_7iTCycaJGZCygrU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afwjwk88dL77WxPQwSDTY4NBcJRByqwoyDw-uiqLbwtsBw&oe=69B95E28"}]}, "id": "2073760636370964", "locale": "en_US", "screenshots": [{"file_name": "screenv2_02.png", "id": "993244952825890", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974853_993244956159223_3665934591366094743_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xRz8nKEK7K4Q7kNvwEEqqs7&_nc_oc=Adm39tO4vPwCLERHSXxiK6UR0I0MuMoV0V43KJ8EEIBhS6u9hbACdmp13iMNiIPaCYQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzjwlKD23doIIcNYWkLQOMSjus9RoygOP9ofooSyNsvAw&oe=69B9480B"}, {"file_name": "screenv2_01.png", "id": "517646341325841", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572947_517646347992507_8365861269156842802_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zkv8iXVZsxIQ7kNvwEacl-p&_nc_oc=AdlTNxm3AjrZha1ZY85_wZCleFUnnmtokRzEYWu52BI6Zsj8MIeMk1fa_hzRA1V-tbs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyHxcsytT-Ar085lO6-mkNszWQPWTmlMBmVNNeqAsk7eQ&oe=69B94163"}, {"file_name": "bagarre selectable01.png", "id": "987094796807741", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391822_987094800141074_5341301578934495068_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HWdZTqltRqMQ7kNvwFygSg5&_nc_oc=Admrk1GD4MbdGOoOPlFF1xRn1bHBZA-xWC4ZN8ownddnw21GDA51W7LPBcBffzaFRU4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwzdJWTNMpIb60qurcAI-2Oe7BDt2YFg9gJl7Q8ug7EnA&oe=69B9404C"}, {"file_name": "pinched warrior03.png", "id": "2233739983674845", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391837_2233739987008178_5682748129040869737_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lAbpJpuweOMQ7kNvwEcoAZE&_nc_oc=AdnFqUfHZDMRxxwiy0BIU_Pkg0P53X6tjMpQLndjkE9xKQysIfmQFgMvDnl6ssUaKTg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzyGky1_IHm6NfuQbjEAql3IRGqnpMjAdnjgCb4OJzkZg&oe=69B95385"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EDqWWVQH6x4Q7kNvwEeVv8L&_nc_oc=Adlkfyr1d_hSO2joww_C3QwyCW59zuNnVO-RySzbqACGGyz8v-tCoKF4O_miIlDFO8M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw6oSkcuMLrc5VqpRf7QUTV-e4WpfCZm_uU5aqpq4rvEA&oe=69B96112"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W3aDKgMQJnkQ7kNvwGmQjOY&_nc_oc=Adll9LplrFfURMQnInaZEHMSUBCMX5zMrLgyslOe0v4vCzSFQYLMakMZdc7uyDxefVw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyyqEsWAckXA0_G9FsuSVaHSFFHtIILX3G1lTPJJ38duQ&oe=69B95E04"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YDyug1GQABEQ7kNvwG4EQvr&_nc_oc=AdksKFNCVsT7CK24mWe_V9QU5cQyZhGj91hMI-NuehGusSkc_oQj5dmKViRSN9smuvM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afw8PIh3Xd--o-BmzMShF6ngxBebI8fSKsdeJvQIqCO7FQ&oe=69B947D9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qttKyaB9N2UQ7kNvwEzCBcx&_nc_oc=Adnyly7CPAzzRiR4D24FxecntGIiLLSlGJj-dnEgLv6kHdR8T1pnW3LlAovaiqp9dmg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyOXRL06tJOAKXKYKBy0TUh48k1N-IMLaK2tRMfx6Y-Tg&oe=69B94F02"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H0a1xCroKj0Q7kNvwHrAspM&_nc_oc=AdnRc1WCnbP2neaDeO2UTeK5HPpDITrXd1oJ7qpScDftGNsjw0qiZC_g8A36KSYk3kw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwA2T5xdaJ4AcEd
=6e7a0a&_nc_ohc=0UgBcNnP_wcQ7kNvwGED8DT&_nc_oc=AdpO906b7hbds2WkOvKRtG4vCy0bfQ5vlHXVt7DkiTnn1IVdKx1Ifv1mRR1UEjqKIK8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJ8OYYW9zyqAHurLg559BUoD_Gi16zhvJkrCwG3AMcRg&oe=6A5F7085"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rexEnlXW8YoQ7kNvwGwGP65&_nc_oc=Adpt_89G95Iu8vKluzKj4tIrw5cqN5kCVsjWDS10E1PdRKJSX14QFWqqYEXr-GQVFuQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAIuO6GNKefvv4Q3WTlb8poicsC2fi3CHHkS9pId2HeEA&oe=6A5F7E12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-errSZvcVOQQ7kNvwHmOxBu&_nc_oc=AdqtrwrHQ5jEmkjcJc8YhtGEJcyejZlEwGTArxFHbngik5J0BtrqAmQYKjxElTSsoWw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8K1AGd1RUwaiGpHl53NODVitQBbjZQcgc7ToDJC9BTw&oe=6A5F7B04"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7xzAXSGuaSgQ7kNvwG108Rk&_nc_oc=AdqzohqNNi6ncqOurz975hgoH3D_VfeVNPoNle267V2AYdBBK2tAJMx9mPZDeLR7xYQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmtRNHgXWZWCaupRr2Q-AgvzpWH7wOjkUj6RMgCrrjCA&oe=6A5F64D9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EYXG5lcYMs0Q7kNvwGxvwrf&_nc_oc=AdpVw02UkynzIIAVWdUiGiYrzkrw9Gg8v_jCnRnnNB--mXS--DPso8YGXhGRKQio4PE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB1LBJ2xm0N-FUS6g6GTm4LsCH46Gt2dOYF9No0PEFrPw&oe=6A5F6C02"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D_6AHVUJR5AQ7kNvwF-g6KW&_nc_oc=AdobwMW0gqZwZf2G_MdmI6GPdRG2r-6aWNRuXe7LXqY2VG3t9bnk39kYC
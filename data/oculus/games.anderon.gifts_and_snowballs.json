=6e7a0a&_nc_ohc=4Q0HMHWqJ_4Q7kNvwEEsgmD&_nc_oc=AdpGU6_x-LTdaEjzfD9teMY6ejsEJqBmBbV3JZ6VHIAYKw8IcxNN-m-FbgnLiTF2U3k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCWI0_6jGZ7XLdRT9334WSFUth1dasCtb8B98ibRkAGiA&oe=6A69FC85"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YWDWucN5csIQ7kNvwHHdwdJ&_nc_oc=Adrm3q_-J-japYuJiyxLLuSswJg6QTuNdrMNYlXqF0lI4Vnezjf-mt1nmfWrMZkuaUA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAzBkIEvp7yHdSJFTlHoainiVqDQ8axB-DcjmDKsoSAqA&oe=6A6A0A12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aSJJ1peUeeEQ7kNvwG-M53F&_nc_oc=AdoOfTz9BpyvqPs-hLBIo9dE2jwGLq_cXAhX2i7Im_5m3xm3tDBoHQN2iF3ueLeE4Gg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDMgz7R3Jdx390qGAZCnDG1zRthC5b-SNVPztXR7CRgeQ&oe=6A6A0704"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mPr5DoceWlcQ7kNvwFgFl0A&_nc_oc=AdqWSoIt9EnTY_g5vFzYMlXpr2dVysV9Zir8-B_22HPKiecdgVwMQLGBvzcFrahMehw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDElAz3Gp71cElm33MFZm6q_OCkdfTVZujC6cyn0g586A&oe=6A69F0D9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OJ9Ufv8eExEQ7kNvwGmSKsH&_nc_oc=AdpyBwein2F_lmpRlcjJh_G-Te_QXPfg_mVFY3xhzGkKHHahMqKygW6ke9vfpgHgCPM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhswdQvKe36Wzirt7Iz5NpNsOfqmQ05HnBeWfeqEarvA&oe=6A69F802"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RikoD3u3osAQ7kNvwHMUkUL&_nc_oc=AdrmCUzNvpvHmAkZxvLRHwygxdhkV5s-Zfakjx0v6kneM5nhdEDVmYysw
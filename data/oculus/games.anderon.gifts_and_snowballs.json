=6e7a0a&_nc_ohc=ynTWqAXmHbYQ7kNvwEfe0KJ&_nc_oc=Adplezjr4etj95YPoJnjhYcKWmLbv1dXxv16RlrqW6XigBWhKYXOwuFXJ-JTXzMG8tE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTexI0n5IwJmj4J8BDqz9tvw4H0P3eGvmn0ZHJCqTn8aQ&oe=6AF9E845"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pg2biRoI-DgQ7kNvwFAIhl6&_nc_oc=AdrK9HsrMg6aw6Pt2yT2u0Vvzb1Fjp2XIXeHcL3pvhOXhVCOXwK6_K__BKq8MCHCyO8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHuAjKjEFLi-DRsDHejsBEwo10-OSTHrKIel5pNJIEug&oe=6AF9BD92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ocrEk02XX2MQ7kNvwEhRdX0&_nc_oc=AdqQSTX_lhhXGejsjuSYFteWOJpg5H8lJiCXiFUABQZvaLTabol3l6hJsUIYm1s8Yt8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsz21iAHMXLMzEIQ2NGmRrTTY0jUJHBzTdg8jd9yIjkQ&oe=6AF9BA84"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_6Dx8IAB6v4Q7kNvwG99g50&_nc_oc=Adro5VJiQGZpo8g4wr-JvXSN0IhOcC9xDf-F-yqFJrqnLPf8bF2fElwZxlD8CpDSj7M&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzbmftB1HquL-I2EDG_znrCmy5V_tMCwa0eLkrB5rVvA&oe=6AF9DC99"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XDL2jlcD4f8Q7kNvwFm_nSn&_nc_oc=AdqYVJj6n-bpcir82U8Cv5EpRFtxwng8v_XR5PCDIii90VMeYu5wL7skGmj1Ez9r6tg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWfEFvwlNChotRGk3FjgYwKSPbfMdXWiHSafv_TUF7nw&oe=6AF9E3C2"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2tFAbXn2vJ0Q7kNvwE6PRra&_nc_oc=AdrjCPRSMGa9QwZTlTVR_Ue_9qkFjCRLJP_33oiL9lp-4OxzXD2f7VCgD
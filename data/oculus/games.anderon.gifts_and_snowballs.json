=6e7a0a&_nc_ohc=WNZ75kF_6XcQ7kNvwFwAf7T&_nc_oc=AdrVvmtRupdNbAr0S9wTrcQm1nWu2cjbsaL9G_fU4A2doVNczMqIm4HjY3WztvLlWCE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBATa4hDDlovbf8PUfG-e2PvtEHBNnomEoXmxIjiY4ig&oe=6A539305"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Wz3Ipl2F1EQ7kNvwHZb5jh&_nc_oc=Adrt44CBp34ZOOL40CSeBgkNc79OpKm9nBJ9Vu40y0xhujl71MWE8KMsL9UnbzC_fAE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDkueRkpdakrEMBvwSmalFZ693XqSAXTBUflGLhuoYYwQ&oe=6A53A092"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2fJLzBpePlIQ7kNvwGBr8wh&_nc_oc=AdrydnWmQI3Q9ImEI6E2f5TW9fbTq4TXFkQ6KzbLXbUU0Nc33kdPrzefg7QfGJaoWRs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCHaIGdv9mnpiQgqJLp4bLaJlMmPQM9WX7UwvV6gYEfTA&oe=6A539D84"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KV_shWcXnggQ7kNvwHgL3vI&_nc_oc=AdoM6leHiVL0IipRqdAwRjBkQU6lTGhbV5AWs6l_K6SKqagHCwGivn2hpFdx4zeo-TQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDnpl2uaLYDaNsEiPLhj_TqIeWEs7ZQz22uhEg5wVYahQ&oe=6A538759"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JaxZnNYMMW0Q7kNvwG8-Dii&_nc_oc=AdqfB4ohhg6ip8rl8xb_Cs5zo2evvWrIGMXS0w1JH_zscFHkFvp3n8_mAxuQdF5paQw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBqjuMYJWc204X3rZwgZRdenJMJHfqbKLUBOTGk_RdHSQ&oe=6A538E82"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zW4ItIjVJ5QQ7kNvwELpIuK&_nc_oc=AdrJ9ZS-GFQIS0DgmLZjmYf9gtZJ9crDQLk2iUp6Ute0TfdtCOYoS_IR5
0a&_nc_ohc=_IfVhTZmEucQ7kNvwGxxT8d&_nc_oc=AdqAicGkVOry43usP8Uy7xRsaxYfc1VofWZ84ehn2aQhuTAmc6btHKGa80dkrXVdYkU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTEEEKh75-K4EDLiY7O-Acho-k3Mea2IrR_RQNLSIBluQ&oe=6B030F8C"}, {"file_name": "pinched warrior03.png", "id": "2233739983674845", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391837_2233739987008178_5682748129040869737_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iDEFHlB2e1oQ7kNvwEqpyFQ&_nc_oc=Adr5uToNojjLkz7IC9WuSCfA6JRiIYbaiajaLH4Up3QHI9G12Ca2YVnbikF55EilHGw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKcnRFJloJqwXAXs8VH-4QnC1EAbcrfY4Dg39HSCEP5A&oe=6B0322C5"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqH-JiSdO48Q7kNvwFNcaAO&_nc_oc=AdpqQ42okqiIhnK0JqhvK_dYy2G47RMxzPde8t8hBoOKTaCNB2gYC7NwATPB5uzvE7A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6-_n72GabMfM3wBEl82FticKts-DbknKJawYgjQDGWQ&oe=6B033052"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Suh1YgvxgP8Q7kNvwEOanGY&_nc_oc=AdqbPFiZCIGhXJOEWBG4sAsPUISJQWDE26vbetP5eAENp3Vk1XvRlAXCRWSgonJJ7EQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJKylVwtEh74c3syFVtKm2lLUDb506HE_U-1aj6CITAA&oe=6B032D44"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bgurPaOa7YsQ7kNvwGPB98M&_nc_oc=AdqNVk4uG4Zr7Opd_0lQOWRFPrflu_ZzdVZOfMpeF49F-6p25v9oXQztcIqgagi__uQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJnf5NsXTxg6PeBe5qUx7pAUyNNEioQttFGk4BdbNS3w&oe=6B031719"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3lfLC5hbPx0Q7kNvwE
=6e7a0a&_nc_ohc=dDYR6YnUsP4Q7kNvwFc_YC7&_nc_oc=AdpIu1KlTOfE5hXcoYNn46jCj574f43A5IYiom0lhX7gT0uw3ZI7tVMEaJwB7tVvjVI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6vy089KgLsQQxYehNgIMmwQjZd4WTh1mNwEtKz6S-xPw&oe=6A1ED705"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pogbREDvEa0Q7kNvwFs8Cww&_nc_oc=Ado3vT-g8x5Fwm3uiijkqgnnVfbPv4hydGsWmdaJ3VlIcF_6ctMS23EudxRiJEHH1O8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4DTwRiyzsQkfu_PkVBVgU9ChMdqOC9Qj9vTzQDhSVghQ&oe=6A1EE492"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JSCxH7y5e9YQ7kNvwHYX9jE&_nc_oc=Adoe75QLt6dscN3swuXxF-fLDVNISG-Azh6WLbPUPQVOdIa1tOro4x7a2jzUaeEuEsc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6K0n9MqUucGR-VEGyFErRdsRKVIPSY-BS3y_yeCL4gVA&oe=6A1EE184"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6LWFWASolXkQ7kNvwHa966Q&_nc_oc=AdpXcgumuMfwmiF21_t2TmDagHn4HiLN159Oceu8itkDlVHZHxq3kL7Wd99W-xFom2A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af41Ahg2ss1cmTt6L0oZc8qeR08fYu9qy6mI5e-aXB9Nzw&oe=6A1ECB59"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-EGbuqfkd_cQ7kNvwEpNDa-&_nc_oc=Adp8y16vUvr_rQOJ2KN55mcAqDCQ5koXH31E5kVaXPVIzpcaslq2rXEbeDf-mTEu7Ck&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4BJoGLsvgYMMZ1HWJhuB3exVcYsuugpDf_pak6ad5BmA&oe=6A1ED282"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vIVNn_KubI0Q7kNvwFVWQUo&_nc_oc=AdpNi9g3EX0IK3yoE9WDpkVXOLz6EesGaCFMBGEYQJI04nnpi8--9NkNO
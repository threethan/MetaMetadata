=6e7a0a&_nc_ohc=1dGntpXRSrQQ7kNvwGqVkfv&_nc_oc=AdpaMazCpIWwDmVh1uwsAiH41srfnFFSXBPCzDKNHKY1Tfn3W2gEmQCOi9_ZsJodQXw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZJm2SNRv54gA5fSanjWSG-pDtdW50IfyDgatM502qaA&oe=6A985945"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yEuWNU65OMIQ7kNvwEsS_KQ&_nc_oc=AdoZsxo1i9iqLcG19OShIxUm1jEanwdytj0-1Mh8_x8r1ajVz7RHpGQzlrGkj3EJiqQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvH-AUZfxuVDV-uWDZuoeqTF5gW36ltRZEP9VnOIr8Bw&oe=6A9866D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5L58yHRg4z0Q7kNvwEZwlx1&_nc_oc=AdoJVBY7auuf4Er8huTH1s-d4tCuMM7dZbwlHKVetUhUYTGpo7rl7xxPziuxWwk-f1g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITdX37M9YBfbgC8isEOrsHeyHEvbOTVyRy0C6GFov_oA&oe=6A9863C4"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qEUJlbuOCAAQ7kNvwGlcAnR&_nc_oc=AdpNRThyHSGQfBwflnS00SsfDCdk631_LSVhoxv-m4YmUP9zcVllNWNgudHVlGZ0L2U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2hc4g4zOFHVSUzHqP0n6k_eT3zh9ytauohBraTWR_Nw&oe=6A984D99"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dG9Yp7Z0SO4Q7kNvwHMQ42d&_nc_oc=AdqetCSbSwbCX4YtnT0FcELbPPJjuPpiVwL0RBT6nfDpEDrKB6WSNq8KH-5w9lwnV4o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVOG-iZfUwebTzTqKWJCH4TF7C0E5Yu6XaNnbI7Q2G4Q&oe=6A9854C2"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cBZ2W3UFHZ0Q7kNvwEYOkhR&_nc_oc=Ado1CSvdv2cpahRbSSuEBMS_OL3vWx4qRlGqwj6lfdCnmCHI_NYB6ayPo
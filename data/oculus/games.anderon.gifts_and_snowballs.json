=6e7a0a&_nc_ohc=WNZ75kF_6XcQ7kNvwFStnHB&_nc_oc=AdpO0B7nuYAqeyz7q_Av35e7u9byKiAg6AlqX5fI4gltXd83Msm1X3yh1TRcW_t_nm4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCzvGRedb1Ar5k6ddI8u9vL4OQ1rBGsSU9WD25wo5zGKQ&oe=6A524185"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vtdkzTq5nTwQ7kNvwGjhuaU&_nc_oc=Adrf4kSBXycb0g0aDVh2adey7eWXptKOKHKAOp_I8O6wmi1iHcUnHJGHQss2Kq4jWfc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFSURgwIxhUlFMJ6yXTZCpBOC1ETqh8gHTIeQQL1wDZQ&oe=6A524F12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5mn8gH65JB0Q7kNvwEyvRmj&_nc_oc=AdpGJz8XZQAWBE3ZppDNxUl-UMg_OGIIyyR9-oHQdZHl2-bF0Rclh74tJZXtCdreAlA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQATElhFCJnd18INp6YvGUXrX5EDQ9xS3DBzndUZOu_ODg&oe=6A524C04"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KV_shWcXnggQ7kNvwG17_-f&_nc_oc=AdpfCQ3pTOBhr2ysyC4S-Y7G355DLevFAwABuF0H1wUau91UaiyCU2ruGYQM5Xr1mEc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDF-MfunNKF2tYHs9BqRibLban4QMkGrhoLHhDUYspOFw&oe=6A5235D9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JaxZnNYMMW0Q7kNvwFRJEHP&_nc_oc=AdpELJ1mgGUF8TdAbo3W73Ytq7o4AtDlMVWSuXq8mBEP9EvUfdjvr2MhYQjLo5KlVng&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB4bR8vZLL6fgmprZqeDiGBhtEij-2BAzvAfArhyzJS7w&oe=6A523D02"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=opzi6DUT88YQ7kNvwFfSJsP&_nc_oc=Adrs_9YJq5GGRg9KiOLj1ZR12e-oLjNFA3eG5NKbdozx2YNB0AazT2Kar
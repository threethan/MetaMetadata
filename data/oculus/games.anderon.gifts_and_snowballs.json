=6e7a0a&_nc_ohc=z3zg2Ddx5N0Q7kNvwGgSnNv&_nc_oc=AdoT0glrKrxu1ww6JapYU8RywAL4C7n0bzlW3BOExL1izw_AMAcf88rU6birHWuAJME&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNBufRgA6FSNuLaoXRe1Sqn_2UUHdmcZF0MBygHcbg59w&oe=6AE34685"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iuA4nmDFOnoQ7kNvwGJ-j-3&_nc_oc=Adqqlegt4tLtZkrTS85jUS2Zl76AP2Mdwje3CKw7TelRRCciS_dEi-Lxj2sK1_IevWk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM5kLjWRPTt-lt8RGBPkvqz25yrqSCJLdmA7T4_nEpOSQ&oe=6AE35412"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oHB3Hg1kPRcQ7kNvwHPXXJb&_nc_oc=AdrV3-bv1THa6WFYuA4GWB0r_de3qG_mqVNDgDCOcYCiDB4bv3WvND2yFOgNMu-DXYE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOgWabnlvEhE0s9IFacN5wzzpx1fPNjiNfDCql4yotjYg&oe=6AE35104"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gIf4Txnla0QQ7kNvwGlrFAs&_nc_oc=AdpW2VJM8sPU5o2bGwwvFOz_4FFFjmVUdI-TFlXQTj7AamPC2vXWkvxd9UQJvyywZXA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOICBu-WpMsk-Vs9kO63BOARe48PlpNVUWt-OH1iXWVVg&oe=6AE33AD9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IXgv05YFa_4Q7kNvwHomlxG&_nc_oc=AdqIQIyhz_ZnZxTYvoLiIOdeXmI343rOqQkfiM7Gvj3T45X_OqazklrfI8z3Anq9sTk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPE1XVcyB9Zm9LdmDBj0EYpoXBqpDIeBpQ78Pab1SYU5A&oe=6AE34202"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LjRIcnf9tM0Q7kNvwGwdmXM&_nc_oc=AdqqD-alCJpL4DRxD2BCI8WsC4lD7ObbxXZFiIsS9AZdjuBg0WCOBRURx
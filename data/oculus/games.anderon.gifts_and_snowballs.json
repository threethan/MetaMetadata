=6e7a0a&_nc_ohc=kPbV2lIhG2wQ7kNvwF4N7Ma&_nc_oc=AdrJf0x-Dn7Uxmzc6OiNUKKkdTKoBOkREB_YWmWw8e7L7Z62W8Ine9jOel0o4HteoHA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLs6oNAb2_qR2LIw_xwrfDGgOQZQYawpIbwj2DbVVy--A&oe=6AAA9605"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SIIPrUXIJ9MQ7kNvwEet-go&_nc_oc=Adqnbh6oE1GPhM-iv0KqTHZzaDWaAQnHVKcybVthul31ksdX73ZjbRFtIcBT1lZEb8M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKvNSqjjjxmOW1Fw_wXPLYQndtFIWgPXhIsQ7GmTU57Uw&oe=6AAAA392"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tgjd_DwmKOcQ7kNvwEY9G-7&_nc_oc=AdrJYviEsv4_m6joQOA9dzA2V2gObgMmPhxzFRRLn7QE8gHt5ZCuCswTudh0J0Q1RAU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbVZCH2pXbylWyRb7XnlZbKqFjqPekvNg5Q2WbbRT1xQ&oe=6AAAA084"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vHVYupLKEyQQ7kNvwFMkpbl&_nc_oc=AdpQkn3_i2KzUEWkizjwwFwTCpvlfBtWuEGQB71VyD5dilGa__-jSjcvSVDCC67rAQA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK13ShRe93bErxvrj7ZEKwTi8wSHxAAAu2ViTBt7M0zmg&oe=6AAA8A59"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IpcxBVLeB5MQ7kNvwFir3q6&_nc_oc=AdoTGy7tg1V0ngJB_G63BiG8zxPdt-nJsXAYMfghD8n7Cf6k3pHGM3ofwOf-sgqDAao&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIM9hcVGwrDR2jW8jWP9OAIX6bn5njf8skU4IXBKSXmtA&oe=6AAA9182"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yGrKVFZox30Q7kNvwG5AfY7&_nc_oc=Ado9o2-nSBH404np7LO-I5wApACMJhzDahjRw6hxGnYUfn6Y1XrviIytK
0a&_nc_ohc=oAxfRQ-UK4AQ7kNvwGo2ffM&_nc_oc=AdqUccvQrKG0P3LiDi0LWSuP3tWj4QkjEQ590Sv1m1_lg8U1_XpUdMZXkfFV0iB0EBw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-thiUjn7sqwdEeRIFJ1tkpcnaw3lF_lCttxxLFw-0TQ&oe=6B01BE0C"}, {"file_name": "pinched warrior03.png", "id": "2233739983674845", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391837_2233739987008178_5682748129040869737_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DCH_6wpTBu4Q7kNvwFgYduR&_nc_oc=AdqX_TF3QmVMVgUsHUnawEW7e9TlHg8C6Vy4c8_38Q-1MVAu8phIEnn51lesYs34aWY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8iYkfj8TjvXoqNmoCDueRDyCUsqnueUTK7lmXVmJ27A&oe=6B01D145"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqH-JiSdO48Q7kNvwFgb5pC&_nc_oc=Adofw1kXuVJ1FsIRwvBzVX1K8X6ObtI9ri3ufMnLWcOgrS_1Ejc0oc0m3f33J_zOexg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQH1PBXtr15PqEuP8yMlxgTXS5leiehBnA2DXKF9A_qAg&oe=6B01DED2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Suh1YgvxgP8Q7kNvwFOmAgW&_nc_oc=AdphypKQM6_tWoZWKNPIrvbck9o_c8mlZXhq6jBuqZ9I-6aJ8LYVBY4aeiEbFM-RT8I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtG5jgeC8pa_lTOwOGBbEUdeqYdvPX1Uqb4ptRg71e6g&oe=6B01DBC4"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bgurPaOa7YsQ7kNvwHyvvhj&_nc_oc=Ado1l-ej9-myPixL8cnFb9S-whM-7-fA4bCSpaaCWCFWdH9cXVMX_lFP66N_umx6mUA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYmLl-_MMSUMumvgKLXAbKdH66v9I1prdUntmOujl-Xg&oe=6B01C599"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4LgSEqx42ocQ7kNvwH
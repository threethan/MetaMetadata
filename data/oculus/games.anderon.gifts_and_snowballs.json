=6e7a0a&_nc_ohc=Nv1mH8Wj8wsQ7kNvwFYdYN1&_nc_oc=AdoCLcaHPATsEjmITPswPa2EwVbRN2lxJyQDmG2tf8O0xxhy4RhcChAQIJ5kWeRH4bc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMITiR3-4mlsDUPjzgGRy-oRJM9UCm32celoirEiNaCwA&oe=6ACA7245"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=moHBfQOkzHMQ7kNvwEV6mBr&_nc_oc=AdpW7oRI-X_qgmJ1xhEkmoE-pymgAYrY3Xgap0FBXUOXniq-eIg6LIyYDRZ8uYFE7HY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMreHCRJQWoxP2Ry8oJh93_M5USNMjPBHXOt8f1TLoO2w&oe=6ACA4792"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YHwptqP944sQ7kNvwE548IH&_nc_oc=AdpyX1ndf4fVxuDm52hHGNbdbA7nF5BmOU9GYygAxbNaU9lbha0Ru_4JuHB41PdJ-wc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNXRznbEpSBD2R2GzfIcpbzxsz1QPhSeag0eeB7bz1jhw&oe=6ACA4484"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QOuTAa2nsW4Q7kNvwEt7JXA&_nc_oc=AdqmGgNqDtOonnT0rRWRpXMumzXd7A2sJKhNyO1l4rFQVw5jwR1sGAs4F9lZhJbNPT4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPVxel594wKaD3XZ2P_ZrUS19yltM_g7nkFJEM3DqrZhg&oe=6ACA6699"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GZtyMDwx6ZEQ7kNvwEVIYSk&_nc_oc=AdreSFjiyFR-xqpJZa5-S4-0MtpdchTzzqIv9AxsFLi-JTwd4VkEsqsCBzqYN53XfvM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNMvJjUXnqW6dqIzvrneowv_CAtAQyVYUgjd_k2LhBkkQ&oe=6ACA6DC2"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=51dj1cOwle4Q7kNvwFf0kCP&_nc_oc=AdqByB0oztiV_BB7i1H4Pjjr5YSbUfZO7gosGVPxhuP_4b1ePH4SLiGRB
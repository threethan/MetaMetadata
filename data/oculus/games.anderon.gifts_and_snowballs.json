=6e7a0a&_nc_ohc=LdbCj6HoSeAQ7kNvwGp571M&_nc_oc=AdoGGa2u5iCFdaSo9WTz0Wupp0msA09OyuF0ywsAMItraUYppNjVSjwOeWAZSRRwafM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPzl7v6JO6ve67Eb6nuMAZK7l5I5vu3xFgY-hYqXBx4lQ&oe=6AD25B45"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NMs6U8IwaGQQ7kNvwGBGkV1&_nc_oc=AdoM4ohxInpBDGLz5GQjOWtU-KcFP7RpCYDCc6nbzDPFnRNEr3c1CZtMWslDnq-X9lo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM5fbTSgfKxFtHqD-hoIaiVgMmt69niFxkkiVcWaz4kUw&oe=6AD23092"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dUdaFeN3fvEQ7kNvwHkNj_p&_nc_oc=AdpIQ1Nabrzsth-cvVVAVbmdQQ_3BCnis2vRuhdy-677UPfHgYqcypO4_KxVEgcD42c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6b0aXlHrjfB6dSCkRsIKlIVRaaHDpMv-h1yroqyPbtQ&oe=6AD22D84"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IrIxAUhe6ZkQ7kNvwH1gvD1&_nc_oc=Adoa6mSpIMDmq6KqGCUU8j1GfLiYOHaNRTkf-Tke8XALsT5ub35ts6UlYt2W2Nia7OU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxKbpY_SchwNPLIaF70iJe5x_LEdMT9UQced4tl4Y_Hg&oe=6AD24F99"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dyEJ5yonysMQ7kNvwGbVGRI&_nc_oc=AdoFOXPEpBfB2Lo8An9j1CG94jh1sg1hxqkEJhWXS3_lzOalU64Mq1LJ-3-4ACWYzjA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN2YBTSsvU1AKYRriLKbOz_Enfc3QkGbh2c_ZGfpKsDxQ&oe=6AD256C2"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i8DniH_BBMMQ7kNvwG6ceyz&_nc_oc=AdrlxVW0DniHYXcV_iGbe0E755dT0kK7iFnxcCHX5mw_2ZbtyF0yPRt_Z
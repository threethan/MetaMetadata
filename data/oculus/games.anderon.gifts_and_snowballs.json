=6e7a0a&_nc_ohc=NLyLVnVMsA8Q7kNvwEjCO2A&_nc_oc=Ado0iVyMt65Q-jfxsUYU9V-azqgGIRrMf24jwT-4zqSg5KoTQX6N6pUrztnNgKny4Aw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWKbw6WWKFtIIMBRpDRi7KyHXlvn0U4bpHfH7qD5bX6w&oe=6A86FD85"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J4HVc1djTVEQ7kNvwF_zRtv&_nc_oc=AdowxAbH979HxOy72eWt9iVU2gtdDcrU0ySwYmvnWqUQ3ZZQR7AuGR0HZB00iWBUG5A&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWROUrV_ogVv2SJMZy7lFVxrjYx7YKvwwGMoyMVCTXOw&oe=6A86D2D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ClAMJe7mVBAQ7kNvwFf1Cun&_nc_oc=Ado2RW-XST291wGyQdbO3YZZ9UYmPffWHMXkmPt_vMYrGBXX5MN0zWnM4vIvN92oG-4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFaGfQ4RX35qUXdgtsmq-AexWMY4-aufDX4THLAT4tOhw&oe=6A86CFC4"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JKcNeEy9kWAQ7kNvwEpxfZl&_nc_oc=AdpZSuVtggccOtEsxcOvFufLqAyhGBWFB8CwsIIVKO_yGlRF_7Sxqzinm_YRF7R91vA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHeK4Ia48iVXLTv7keVO0CBdZnc5sFN0QQ406WJeubL8g&oe=6A86F1D9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rSo4TsQoGigQ7kNvwHCHKMY&_nc_oc=Adp921rRvnqpgNX_jStT2oh7GnGKLqteRFApJDjz6J6Jvry3caFQ13v3SIHFMUT1sRs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFY31M8ObYS-jouBmueQVKbgZVlCGiSdWmkHQZSLBHqaw&oe=6A86F902"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AGU3OU1EwQ4Q7kNvwFV1sah&_nc_oc=Adq96LDBxucNY388rYfFtZ7u1szh_kFf6RUW4gDefBuZI9AgAKGfvO1FZ
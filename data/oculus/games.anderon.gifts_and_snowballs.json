=6e7a0a&_nc_ohc=P4nICWGddBAQ7kNvwGJ5kna&_nc_oc=AdogJ-z0UCEw9bZFtFgqRCWr72klpP3UozRIfXB0NxXGnefh1STBQj7t_VgHVmedoQE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNHXeN1HcM-mMOlrWNsj6f2Qus0dWUAysqcumAY_YXaog&oe=6ADCAF05"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jqNUQSUwCcQQ7kNvwFZZfQo&_nc_oc=AdqypqWssHditmi08qoM53xY1XvoSSmBu75s9oM8VNsOrocwCGn8x7jfWi7jxDemYgU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMkpn5VnnGdo5rlTPSkAI_lQigT7td60YkDVv41yM1hcA&oe=6ADCBC92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B3KWA7pJOssQ7kNvwH0Akhm&_nc_oc=Ado_IpgAV3r5vPSwLnqgSSO8bBU-63np6uqdHfIlQ8SpgMBAy7RUwnBNV-PZSJ2BnBg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-TGZTdsI80D9cnIT5RPkfo4sLCudXpH4-jKDLwkzZrA&oe=6ADCB984"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JfB7qn24Zx0Q7kNvwEWX4_i&_nc_oc=Adr_xJ9Nxv__PeblXbgpKPg1OGZD3lzHvtHI1m0mwcwgFlBgFkB4PIm1TyrYJtkcIxQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOO4q7vJvealjevOzmxpuC6qfi2yF6ZNVkl-SshLj2Tuw&oe=6ADCA359"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yll8FNLpThAQ7kNvwF6Vpbc&_nc_oc=Adr2mQCHgs9OcWcsaFu5t0Dc6G1KmCit1amQW_PK7iUKwoFeO7vAdutLmhJpDHkf2FY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP2I7uJN15UmnREjOb4Zg74BNE7jsj9rzECWnGFzU6y_A&oe=6ADCAA82"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZyDPal6RziEQ7kNvwE_jJAa&_nc_oc=Adq2DfLRs3gI2jBFgLAJyvpJJLS8LcPmcIQUCGvu7V3dxsE0Nfqg1llq5
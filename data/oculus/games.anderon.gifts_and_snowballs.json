=6e7a0a&_nc_ohc=RM2hJWg5rPQQ7kNvwGeen-7&_nc_oc=AdopNVAiIpppeealvX4TixGVA2sRU4y9dIeKz44exEYJzJQseMk6HGKN2G8dmJb8yOM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--a2APuXvc-v0BJ7TPsNneytYUrXWZmnxMsEEXE0B6XQ&oe=6A217A05"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ErmKFgQ804Q7kNvwHONC40&_nc_oc=Adr2jWuoILUHvrdYP2f8S9R_BVe9c0JXyybc8wja5G5s8Ibi2J1rcF9wqvZqR6r8Xsw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9SXkGodwb5fNpg9QOGO_faKkT1WxKg8cjFSIiUC7pKRw&oe=6A218792"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lB8O0UcI3-8Q7kNvwGzXkqJ&_nc_oc=AdqoUnuCz8zd_wO2ZnjSJTVJbmluB8CH4hMPfAe1ZN9Lxvc21Oleb-TiTdqx04UwoWA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8FPPt0td-bViSHq86Nx9YmL6-ivhxbqFS-MY8h4eyWpQ&oe=6A218484"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6LWFWASolXkQ7kNvwGCzrLA&_nc_oc=AdrJfALF5Of1GSoaxWVYoK4h-K6Mhw40YMIYMjjLW2rJSS94EnZ-xf8m_7B1c0PcRAw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9aJ3WVhp-9yKcgCbM0SI5Q9md56gRzqlHd_5rouApr_w&oe=6A216E59"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=33o-VdRN0eAQ7kNvwH-492D&_nc_oc=AdqXgt_agkC8xGN_KgB2srV6L-vUdaR6RMf33o2mUU8uAkQq8VklkjEOjd9mbANJyr8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96R5R4KZB507hZQrOtd39JVELKJrv539PP1jWIZC0IFw&oe=6A217582"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0AnYvnuF4LwQ7kNvwGdamr7&_nc_oc=AdrjtwT1cQIe3cGR-3B-XuT29eha9tE9SUzVYduWsRWArNpATi9WfUhxA
=6e7a0a&_nc_ohc=BUYUip5p2JUQ7kNvwGMEv5d&_nc_oc=AdoXqQnx2KhIKfUcNVxd5YAvGOJvAD0GX1cT6YaplFGhQ8btyG0rCl6xpjTeffWxvKY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWxp5FPycbfHvevSpxLcoBleibBOCMIlb8C6fbUgKqYw&oe=6A709405"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a-ZnWqjXnHMQ7kNvwEsGz0z&_nc_oc=Adq32XYaADcjw2yIKkjpuCmtFIGrvQISj-PoRW_oxr3ofQScYsd_ZyuRcBFPYkzYaZM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQ4iHwIv4o2VDWoEiwuq032tZFRgX6gCwn8o9t-PI8fg&oe=6A70A192"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fOTUqZxGX1wQ7kNvwEoUnEM&_nc_oc=Adp2sfCmOKFD8I7ORVC32VYLPp4a8-Y5X-ZrDV_umotn5ug4CTC1jp-lSRGGjiK_g9A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-3UpYtX3cw_6_CLbgtrg8AdjgKvCJirPQPRZ5Wadvuw&oe=6A709E84"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aiRSKQicRrYQ7kNvwH3wsZX&_nc_oc=AdppFUjBBNfWU71q0Ochd5xh327-f3a246QpFxwJ7stjmT8Pl7OtQo4c5KfbMtA1e1M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHnEtR_mZghQunpYuaO3AVI-dIHn2rtBtz5BS3Ze9ztQ&oe=6A708859"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b0Hqxn39yLkQ7kNvwHHnB2n&_nc_oc=AdppiALbrlws9gvZJuQj9sZZyfeoxVpW9CKtn1X6sD97L_HKKRWThEx3IYwBg-OktzA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0Rrfnz77xj4ZwCPt9QcFJ-HEew7oDpfAVcQ5SNzc1gw&oe=6A708F82"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vSaujhPBwOUQ7kNvwHRYtj4&_nc_oc=AdqE_2cfAmEic2uSnhNE5tJFHlfigKKSoZiKLlji7_ObEQRH8LblKg7xz
=6e7a0a&_nc_ohc=kMwPrh75Ei0Q7kNvwF6SrCd&_nc_oc=AdrwcVG-cZy9Xq0-hpOM9uafp9PjvnEvHoVFQefjIfpd2bmxXeQISVSaBRhPycE4_pU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9e8J_3HP42HD-0lLiy2e2Cchsb0KYaDUZi6k4hqgSTRQ&oe=6A37E385"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CPdKrGjHZAYQ7kNvwHeWMge&_nc_oc=Adq7Oa32QItu1K16kM26snl_GbutB0Y_ZYEIJvJGi-yN4e5gYWdTtlo-mM6EadJ8wRY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_vmQZPXGMyxgSsWvzZPZglqtS3MRz_5bLgJoB1IOG-tA&oe=6A37F112"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zGP009H8zXAQ7kNvwHaGZPP&_nc_oc=AdpWPki5ngG83cbzzRYbXeVjilQDWbKd_RBGAzzxPl1CFOaWAZeoEDy627sonJTZTyA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Q-dZvU-mwgRkNA_i-lG5AIY9JwsNd1wiyiMIdAXTMCQ&oe=6A37EE04"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9bcQ1Qc3Zs8Q7kNvwH9AJ0g&_nc_oc=AdpgWDP948ZCM9Yn0c9AvDOSfdfS6xyeKI-H_eC8H17JhguCuc0BBMsLcjLWWuM2RdI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8zFo5CEEwLgw_4cZPmdGjj-yk9aj2Sb49B8bUZcQLgbw&oe=6A381019"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S4rDYOkhunoQ7kNvwGbs4uD&_nc_oc=AdqS33r8zfWKVJuUqULIvyznW2Ba9XSSJzvkkzahgGNgbI070cmkyS98XGn6h_shGis&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-lqFH1a98UYHR2_E5F5UXAoc36s5Aodp_QMxvyd_oVA&oe=6A37DF02"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_vB1igxOh9kQ7kNvwESuLIU&_nc_oc=AdpjJ1HPVxdrPzbJ0LTVUCE5t-AAl3RFednd-t_6RFgSa91rgI6aYj60o
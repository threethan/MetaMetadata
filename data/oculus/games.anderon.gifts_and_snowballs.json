=6e7a0a&_nc_ohc=qsTz_5KPUjAQ7kNvwEWwrgB&_nc_oc=AdoocQF6M32Fs8ajINMGVXW51FzC_5e8qE5UC0PaeK68UHrtplGB4P-EUDq_2OOiubQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFI1o4TVY_mSUsGVM5mnGs-h-vwPilUMyDCFglmID09jA&oe=6A7B2005"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q_2vQfzqd8wQ7kNvwFq8Pv0&_nc_oc=AdpMiQuqr7HEmkOTBNI0DsvBfSMh1WMT8pM82L2u2p4SjSBmm7j8KLX10j9249iCJ6M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFTyl14K1UZGmYCT88C-BHoT2vgMfYHL5W_b50PokHD5Q&oe=6A7B2D92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4_ho-Dik7TIQ7kNvwHsGTg2&_nc_oc=AdqHm-NtS1D2dzSykXFaZ26TXHMPAmYlyMuxzy-khhs8wFYMuIaptG1gacrc9CPIJAw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGzN01aGcNxQ8Kq8s0jRhZB41bVZaDG820pZC59rxayeQ&oe=6A7B2A84"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s90H6M6ygvkQ7kNvwGoqfPP&_nc_oc=AdqbFiKifQZS52gN1AlysRQR8rQPRtFOK0eoDCG5064OsLA5AW8CjPDnPygDHzp9aj4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHrCoPfZQYNgUxJSQTpelYNO6mDF0FSDvmBukJGDlr2qQ&oe=6A7B1459"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XqU3Bv_QkKMQ7kNvwFcAyWj&_nc_oc=AdodxqqNB2NWmy2aeBZoOfZT0wqZAp5TvCHsCoD7z42-qDaxiwVDN7IrJK2mr874C5g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGTnEfVixWhIAV6417JAX-qLRzXrT2x-B3EWuIGhTY3gg&oe=6A7B1B82"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RSFixgF2z4QQ7kNvwEUpmr0&_nc_oc=AdodhXZZgOM2bWbQnCxqB4b21f75NPlvibUecJ60auv-NFFooYrFSskrV
=6e7a0a&_nc_ohc=UV8oceCainUQ7kNvwFx0ZHP&_nc_oc=AdoOgrOiEhdGADlsqeJtFuD0hWIAh0_IMiAy1kwLNuEc244OSCSqQUBohnYLxjawI0E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZlrFKt4Hp5l_G8IH0OYbQyJzaqngBM3ZSFWRbtqvILw&oe=6AB91685"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rlziYRBq-iQQ7kNvwGkaOkP&_nc_oc=AdqYrsQjwuEs_eZ8MSHJLBlI9KTZkQn6nf2KHLpNv154Tw5GmCEMvtQDki6zCToy7tc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLoUw4DDX5ju_u7YNqhMxQ9yBeDfagpt5ZI8WRoQhUklg&oe=6AB92412"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9MSd1V0yIxkQ7kNvwEj6A7u&_nc_oc=Ado1w0wA6WNey0iW3_sR5Gt2l2uClG_bJTBXgbI4zCX3DJ415qxPcBI2nm9NdPD965U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJaLSN26jjbcbK5M1uDbJqVfCVaqXdmVsbF9o_ZBsLLzA&oe=6AB92104"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cwY9f3-LoXkQ7kNvwFg1SaM&_nc_oc=Adq8cO9DZNfr6so7qcM3GGyGruR2O0DYc2VnC9FCjGMBq_vd9f8vqkhUFucIVfVZqKo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLnMv062l9q6nBoZI1_VQEaiUV53miCiMRAp1hUI4G1w&oe=6AB90AD9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cxhUORAjPhYQ7kNvwH3OBga&_nc_oc=Adr4IKf3Z0dEENVpVaWSEB9RyGVjoc1FQ4icPIr3GhxxYJRxMQ2XAS1mXg4TrZEhxdg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHIBWer3A0bx6NR64R5AjUjWXzyElvcLaB90jfqvEJUA&oe=6AB91202"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rpLZ3WLUy7IQ7kNvwFLVpB5&_nc_oc=AdpMqpEQeb1OFIGNz1F9SjW-cgORGjr5LeKIbw3uvMNxN6iOF-bOjzDoj
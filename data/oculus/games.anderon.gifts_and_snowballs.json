=6e7a0a&_nc_ohc=EMWS0YS5vf8Q7kNvwF4MmpX&_nc_oc=AdqIDKQcvDrEcUU8BVz4WJtU1wDG1UGx1bw9Drc-MxlhnI94n1zd-Jc1Mo0eV4ODtJo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxQz3oSxWy1JFnw0gNFxiwt7lo2HwL9alUeL4JmQxOTw&oe=6ABFAE05"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UKEqar1AV2YQ7kNvwGc9d6x&_nc_oc=AdovV5UC9ufC9ibIdzEnjnHw1Ji-bPrYqKeR0L4T1bZYG7RlVIjtYOjubSRRnw_klHs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPIyJJIzfnchXE-OrfhfNCcVlaCLg7Nj6g1qG5lXT80mA&oe=6ABFBB92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0q2Qt_1jta4Q7kNvwG4eD7f&_nc_oc=AdqFBl77qgkoLib-AmJFaUSSbHEg2hos6SYB08PEwC8EQ9J47EHKn-9CTszSk-q89zQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOpdNrsCMv9K4DpGNzQCUGkfHr4pl8xDf6i8wq_9Wi-7w&oe=6ABFB884"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JMftvk6dInwQ7kNvwEgzMnW&_nc_oc=Ado-wzr2i_AyrvoBlk5TMg4nBozLKq30mGFkiUgD8mAbmBurst-7-Jm7b0p-VyZstcc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMF0yXVMG-mU3mvcd05ls4XhS-8_ofhzFYmQUUsGI18xQ&oe=6ABFDA99"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ze4aTDG1Ui0Q7kNvwHZsLC_&_nc_oc=Ado7J3V1J6aR2qzmJ1viJIEhUDS-vHm8PZGfa4ADkkhyU19ErNGM0qfCN7juQ07zifA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMycz-J4Fph3-Bscxj5s4zF2t3P27HQZvp3CWHsR4v_Ww&oe=6ABFA982"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fn0LSWMCrn0Q7kNvwF09x3s&_nc_oc=AdqpkfhTfLH_ta2Y43YUOFH6ROlSiZyhlKBes9_0k2VcDbW-vSBEfkgfk
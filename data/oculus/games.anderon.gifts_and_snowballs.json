=6e7a0a&_nc_ohc=JXLmujmDilYQ7kNvwGNyyDU&_nc_oc=AdpF8G-G-hrd_3aoR1GzATAt5nziyia15abSentI9jfGyWQlrAuYlx56H8ACEHYl72A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4W3YpFKmOIy4H4YsthHVGh9BuBNpDxmkwjSauuQ5yeQw&oe=6A071C05"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0sDbwhUDB3wQ7kNvwEjxLxZ&_nc_oc=Adp0QBQMpDyzMgQ7kVYFwxUo-k74LcwYG-9EmpHPJmadWojjqGOZyXZ-q1F2Ks6CEqo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7pFP1dN5kGLDUY2pK6LOaKaWYWoeTjHhLXZqtF_H1kgw&oe=6A072992"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2R4y9aN6euoQ7kNvwG62pAR&_nc_oc=AdpGc8pCFN1FgTRGeAofjbC2GGFxsiumgwSkph1y4CJ1nglIetQ0aUEFcyvU9ffSBX0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4uuVKjQm9ymvI43EfgbqK_O-PmBJbzSJXVItGR43gbfA&oe=6A072684"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i-0Z-lqJJy0Q7kNvwFE-X2x&_nc_oc=Ado8dHW-zV36s0yYqfQvxZagXgL23aDYCjTQxEOPU6xfqbNvfhlAQOCG97xeFpdTwRE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5rmTHg-R4zHqUGi30tBsJBZNDCGXgY4B6MR-kUWY46TA&oe=6A071059"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z9l77cfTQI4Q7kNvwHmWkd0&_nc_oc=AdpvxN-vJLwg0tPpK-xh3DJdmuN0lqgBP1ydi1GwKXOi1hYzDNmIE5-JLot7E4qZHCQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6uxcQDr_Ff_Xgz8vIiWjTX4m9T05djDLvmkr4U08qSfw&oe=6A071782"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BvUD0P3b-RgQ7kNvwFe25w2&_nc_oc=Adpv7UjKeW-EPP4m8wELj-TG8MAn64OtTIT1Sf4IEE6_U6s6_1M0BDJmA
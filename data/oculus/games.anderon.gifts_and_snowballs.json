=6e7a0a&_nc_ohc=I_1IIyo8nuYQ7kNvwFcFl0t&_nc_oc=AdrGagx-OIvSSy6cFxsbIj03oxnpsWjDwOa-EQgS0rcBLTmKluagtJtcIbvXl_hLOrg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8tlKkzhoRakLqut9HjKdZ3CQ2X8PAndO9TRGLXh342Vg&oe=6A47B585"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4bRhRuH_dRwQ7kNvwGQa6r0&_nc_oc=AdqrrItJn2SMmgjJvQU8YW9q0CX8c2oeSZoeSdnUO_Tzg_zYXn3pw2GFHMIXhzg5YGA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gG2FolPrhQsFYwYN51r4-eZ5OU25xg6DWhf4JFbbbTw&oe=6A47C312"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ngjNwR-Xk4gQ7kNvwEeSP7P&_nc_oc=AdqDVxbeUxEkS8bwv43iAHBhGpDEcwa-_vC3DuA2-VUUuj11OT7JkqYAZC8K2OZt-T8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3Dq4ffjbFj5yTM2ndPbQo_VynLp_s5jAoCMcEGlYYdg&oe=6A47C004"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LC-7Iqwu68IQ7kNvwHa79Ln&_nc_oc=Adpx8pcIQhgDz-uuBr2rPZYAOypD4vM2kxKHYsRn5WtCneoODBU87FI619oXt8E6VqE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-kigZfYxXF88SVPcNPJVrIFaU5u4xa8dd4nHjFldIN5Q&oe=6A47E219"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xJCSg_dAlYAQ7kNvwGWfgq7&_nc_oc=Adou0lq0DpUbg89l52vOc5pIiZ-hTzfwJYWv98cp0Sng-HTAFFtmbMTkdas_DF0n578&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-DfDnpYay2YGfICROoScVFdZ_-OEOfjuekuGNEQHfupA&oe=6A47B102"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-G-D9nj7CQ8Q7kNvwF7PCnA&_nc_oc=AdrmUvoa1q_tQXHSt-iPuLCaaod4iX0ylBiJF2Dh9bmUY2n5-iPhnOKVL
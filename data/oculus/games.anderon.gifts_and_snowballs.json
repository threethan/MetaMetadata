=6e7a0a&_nc_ohc=C2K9hC_EuvEQ7kNvwFP8Nnr&_nc_oc=Adr9tw_Ol99ohkVAFQx80SqVrDZT7Cl8UyTtQX1qrOX6kwYQgsHMhRhj4Hhab04EeGk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTEWbCQst22Rr31dBboLH9M08B8R3t0zboEI-2DXFz6AA&oe=6AEA1645"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RxU-eDlEQ4AQ7kNvwHvQc9V&_nc_oc=Adp3jE-myWs1KiE_B3TQKO0DFQRuHdU5_U8p6r1fXSdkRO4ptLy16JeN7gtxIoOXSb4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREMgzQ_XYhzrPvkfWy5ONWZlCVTJE9MshDt0QvJ7Ldag&oe=6AE9EB92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wZ1jHzVHeyoQ7kNvwHDO_j_&_nc_oc=AdqGZr-jlFresJMhOJmaf9xcpHHwRjM6CGmuU_0eQ2uHjGZqnEqW0Dupt0j03m0ue10&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrnCOuT5_uNO1IMTOC-PO2ioIk3dk0FaaeaRCMWGdpdw&oe=6AE9E884"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-AhT3j-IB4sQ7kNvwEm9q4w&_nc_oc=Ado5PmizYfnPh_FTsFsL5EAkXvRkFloWLvRmKyp0PSZ47asZxT4l4jly4mlMIfNHNMw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXS02mVbAkVI2TZRq2Le9IfVmyLYU_gONuhk40J1SV9A&oe=6AEA0A99"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DzJMFHKqQ6oQ7kNvwHL8s0V&_nc_oc=AdpA28IllDp2eaZrGou1w7aKhHBSYDNXYqQWRzZhVHnAhXPp1vPGucYGNlH8zJvHP8k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-u-RzD5ZZuqR83wGplmW4oBR2ECYyS9VDH1UxGg9aBA&oe=6AEA11C2"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KXID9LdOkAsQ7kNvwFFSNLu&_nc_oc=Adpxs7rSmgu3gHKrrMiNhbtE9-j46P65UneC5afRBET5p_NOFuKfzODi0
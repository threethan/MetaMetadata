=6e7a0a&_nc_ohc=jwpLwgj7SLMQ7kNvwHoK_NT&_nc_oc=AdoKkpjqZpIHjjcII6GdVXfL5AYeVVdQ_emIpIifmUvWD_GD8LkuBePxYYeuKzwI48Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4RPne0EiCFYF8PQRYxN1jq_AbEPLIys3OvwT0D2jKqGw&oe=69FF3305"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pKfQ3NNe9jQQ7kNvwGQUaih&_nc_oc=Adoo7QRPs0p07u-KEcsbDSHDt5MBJDdhkxFu3oPwJFoeG0SkJXlFozrq1j1jQDf7q7g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af734x1d8IV-jNRTebOfJMcLBFzC5oATJTVVdrzPYFwkfg&oe=69FF4092"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5IL6MLHBavQQ7kNvwFqKrKc&_nc_oc=Adp_ShT2NkQ8bkjsTjUF69Xa5wsXuSBaP-h88yyRV5LNLvq6KaDCL3omsbqAzSHfqp8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Rnf-4MgjF_7Kg9OxoVOKPCrjbnw1bNPSRywr36O_Yuw&oe=69FF3D84"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pfkqlab148oQ7kNvwHXntVq&_nc_oc=Adr8dOPCYHrKOYBMObVbCK9PxoiAbB_4yZF_YH0d-jVsm78Ne-nr2MyuHBKBxyhY36s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4eAsQLBVbBpjJ79j1a7itRXxWdXCQklGve96GJS_Ja9g&oe=69FF2759"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5xvgAcLjV5oQ7kNvwHqO4D1&_nc_oc=AdpiaZaP-b3T_x3Pa69oUbm3ep2kLrWZrCKouNHygOHeuHGTKhLOPX6978KZLcpSnw0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43zJdAwI5KtsDOaa1WvXy1byqmAeT9W8OuJ14Nt5nOfQ&oe=69FF2E82"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mirpe3agzX0Q7kNvwEsIxHr&_nc_oc=AdonQrXOcCw-Ly0y4wtJOL8RttH5v3-H3HM5qBreFafG4SGeaEP9V5CDQ
=6e7a0a&_nc_ohc=4Q0HMHWqJ_4Q7kNvwEe4CH0&_nc_oc=AdrLpFDSj326ZqgW5Z0qhX6jNVZILsgdX8r0PEqQkyrnCGjSEnIgKlgZNjfVpBs9CTA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCpRdnXJu3K3DvqMv3tHS3xMaETO_VlMSrE2K5IXDSLIg&oe=6A6B4E05"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BI90TUt8ER0Q7kNvwE4scgK&_nc_oc=AdrnwP4L90h3_vWYUzjNrfnvRqCvFA5IXXuLpaT3etDNVPM-yUwbMBcOLlhHkDrk4h0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZD4DB04uayixtChPPU7AngKc5u5Y1qc5OpeaSnyQwwA&oe=6A6B5B92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tGQTZy_ps8QQ7kNvwGfwBgM&_nc_oc=Adoc1eDDQurIRE9_LIGFzptibgF4XiUTPDlStbGGFVWnuT_hbgVvPwLsr5gko6GDd-A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHGnlKV2C4DkNUiC1_F9uXFZAgLa--jn1Q_ySTUaXmMg&oe=6A6B5884"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mPr5DoceWlcQ7kNvwH6yfXv&_nc_oc=AdrXtM2ysoG3Ra1AYfUv6u-X7syllUrXh9GwJDHpZpR9zcSyWbVvfVIHUkVQk3AVVoI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBUoTt24cSPS9kPT6QVo601XWXSnVTkwt0mheJ5AuGsZQ&oe=6A6B4259"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OJ9Ufv8eExEQ7kNvwGh5p-3&_nc_oc=Adr5qyAS6pEVj3IVjg6q4Yp0-_p0VHc5eXjcS8VQwFNi4DAi3QyuXcp4jV504s2_WxI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCLUroOVXd5Zkix9jqFBB8BEbrw9RPqGXVtYw9jhZrTEA&oe=6A6B4982"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B6JkGPbR0b0Q7kNvwFLQZr4&_nc_oc=Adr7HK0iTrJATJcSjToI8MR9J8lGIj4Nu1A5U4gjKYnT1lq9TUK4Hw-ia
=6e7a0a&_nc_ohc=ZmtbzetigwUQ7kNvwEMy_9I&_nc_oc=AdpUTvJ-7Qr-HI20W5zj3zyO0SJ57SzM67RgOij2VIooiKNhzonUEM8nVP6hH5M7tog&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO1jKrQ7aAUvtfWm80GCqzHnaTEU4k9hQJc_GX7rUJFCA&oe=6AC3DAC5"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zdnJrudqSNcQ7kNvwGfMKH4&_nc_oc=AdpWfz-2JeUI_HsMMf3PFAKI9737K-4f6iFuUScSLStZOD16iQSC1g8EYVATqrPOOko&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMGAgfyjTo4WHy8SgFScI0yDSKMk8OVfKRR5VIDWFJ-zA&oe=6AC3B012"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UcQwYiLTSlkQ7kNvwHG2uMq&_nc_oc=AdphQdMG_vPZM8W73rUqks04X1l3bCwRt2gna0fOqLJ7fsNilODEOFXSwAn2j507iNI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQObXUKrGa90DPo1sckOQGmp1ijvhZ04Zm8BhvNV3L2N7g&oe=6AC3AD04"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ms2ouIzrXnYQ7kNvwFScQBj&_nc_oc=Adp7yF7EE3lcD8RB_ie3AUf_kQJ2aW2HFE5YgAEBTf988ZLJ3z9Y0EGouA_D8MUOWS4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP9zb-Fleszn2ZEEzrdowPRNjiiD-ymyOI1vPuQUHaAvA&oe=6AC3CF19"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cZYkipgkLasQ7kNvwHZf54v&_nc_oc=AdpfugI_6YS6mOtannNMxhLNSvBe9Jk9YWX4ZNBIuH9zFtxIXejs7p2Trg7sk1dGwKg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIr84ViDhykCWptyGj46c8I_JkkCUKhtlM2YYhJ7OpEw&oe=6AC3D642"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SotjUOyj--QQ7kNvwF32aXl&_nc_oc=AdosNEmxyJMO4K9TiYhmuGUQtINesv7MelNze1Mnq8VjcSVYtapu2lXOm
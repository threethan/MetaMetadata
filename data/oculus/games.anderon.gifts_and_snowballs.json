=6e7a0a&_nc_ohc=S-1j-BzIvJIQ7kNvwHY4Xsr&_nc_oc=Adp98zVnd53l-cEHJtCSv8IDtE61mrH7n1UTKF-wh1WWX_LPvfpFSJftJm1RbdVUKeg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBn7YNSx6pPoKhmWWN41aUADyhFG__WzNs1UITSjY_hJQ&oe=6A4CFB85"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ORQj9UD4h-wQ7kNvwH5VrkI&_nc_oc=AdpdwhDdknNnRatf8B87IGK3Zz70upr4L1iWiEaCT_kDyyU0gHKlNzCQGnO1x_iWODs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAWWlY3KLNH7qb2XU4VLYfA5i-K5dtZDj51IZLdp-tNyQ&oe=6A4D0912"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xlHc_p3NxRIQ7kNvwEIhOtp&_nc_oc=Adojm82plmY_Jt-kRU0Sea8Kn_6ho-N65y0-APZT-lozh9j4L8gFRft60uPVw3y1Mb4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBsydUvh9q8VSORcJ5kWv9e_BSkrZpMFiTLbSsUe9PWZA&oe=6A4D0604"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sGYx_f84CzEQ7kNvwFQ98J_&_nc_oc=Adr0xAKmcfUZOJ9jdmaL7LYf4CHxzKkRUn0-OaFYR3dtpXcDGoa0XX6OFJtj-ipRmRM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXI8zT_HliH8sDgucUIYGeg7vCMy_OcH6lW_8fK6aA-Q&oe=6A4CEFD9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4jKdJtwyC5QQ7kNvwEeAJQw&_nc_oc=AdpsMZ1iCDm4Lo2FNLuHlxve6odNnZJq0cYqFMcu-JbY93q3DQS63zOASX6RbPGgIxc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQANhXkO8elo9i9lhvro1cdYa2k5slcWWojRg63mh2L2QQ&oe=6A4CF702"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4SRhMuQjq_UQ7kNvwG_wXw4&_nc_oc=AdqSprsK1ZzGboQ6tsCzc0-0Qnw0ZiAiPaywdIwnEyOc_YFEx2mKk2hO-
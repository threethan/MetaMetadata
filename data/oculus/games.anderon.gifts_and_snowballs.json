=6e7a0a&_nc_ohc=BScGAJy33mUQ7kNvwHpuUgq&_nc_oc=AdprpCwKzE1x3WdQOpPsgWwe5OfU0UY366-6rgy4P7s4ePjtjEKW2rMhiwsLi5aLM7Y&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUO5NGlF_Yybz269OnZ_NheXNt_Xq22oTunahWi3Isbg&oe=6A6F4285"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a-ZnWqjXnHMQ7kNvwHx-6ax&_nc_oc=AdpYSPZPmXrTvTESqOBJ5OOZXWolE8QxyuJHVAsHpFgTJRjAcwDnmcaYRUWpBOMRIRw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDz5DTWgvzCL4JFanHffHTAiCa_SlSlSc5wy0aWLhAwVQ&oe=6A6F5012"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fOTUqZxGX1wQ7kNvwF8PPwA&_nc_oc=AdprA78HHUQv5rWAX-HlirFvelsxh5_GlHftKa5ujwnVszfBrzM4r0c8qu1lGlntIa4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBifUcgdgbN66CH5S8Yh7Zezak5yoSO50mJs59f0uaIyw&oe=6A6F4D04"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aiRSKQicRrYQ7kNvwEplDXb&_nc_oc=Adq3b7c4jnWZulCXtoyhvWkLxidLHq4zW_7oe1HTmqWPckz4ZTzrddd-6swp0dwSwyA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCuAtnGJuihdvZ17-P5tu3E-hWHGkVB7e3JsNgUSsXQNg&oe=6A6F36D9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4nH2e29f73AQ7kNvwGDXa8T&_nc_oc=AdqIpVdBHvHRSPIpBiEUt2lir16HRLylJmbLzfrHGYC0jMKBTYLHwvZN96osODHM3DA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBPU3l7ExOcOq0f5o8oVrM_OBvYfkk29_EE4kRB1xHD2g&oe=6A6F3E02"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vSaujhPBwOUQ7kNvwHteCWg&_nc_oc=Adp9Zz5AIN3I9nc-IHqAnaMaYiSdi6sO0zBCOz_cEVdmsbywUmLKlLZqx
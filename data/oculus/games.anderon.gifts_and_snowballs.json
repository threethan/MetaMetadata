=6e7a0a&_nc_ohc=5BSk01a-d3EQ7kNvwGWHWP2&_nc_oc=Adq0q5v-XUNuNCyUz35Mu1cPMxtC2kvx9uUxhKm6JrGVJ1pW6Qio3HweQXgx3ee-ipU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIas_n9J8fMntARAMR-Mt3YTB9CTC-Hd96FbIyUwWo80w&oe=6A9EB885"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a2SDcmSG1JoQ7kNvwFm2rGY&_nc_oc=AdqidUoXpPG3k_ImkhEabzKGgK3oJFKj9zGDjBURc6V1eLmVCYoyeMWiHA34R7t0heA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfuWBkhf0RTNOlWpdIeWzyh7vryeikMyVV1HmcCjDECA&oe=6A9EC612"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8NPrG1L6NoUQ7kNvwE5tmzt&_nc_oc=AdrYt_wATDnqW2zLkUu9Wyi3OT-vvUflBFQOkPfbUke9VZyl25s3GwZmNg_RwSbVCQ4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKW4HBAV5aGZqRX_uGQQtiiwOxrTo5miZbd2evOMrywZA&oe=6A9EC304"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qLawT6b3PlQQ7kNvwHa_Ocp&_nc_oc=AdqCJ6xiFADKmopoNjiOfSCgFZMj9kZypjXviylOsVUakzPVZj9i9bTAKsI_qYra_dc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITS1UGh4EuqDrnIbHdLI8pr_2hz3agDO_FFjqysVv9DA&oe=6A9EE519"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QwNRY809WggQ7kNvwHmKzUc&_nc_oc=AdoUE8eu7DO8qMnxFo9Slg5Ser-LWTF4Y26L107tCQctdiFl0vWog8pTbXJ-p0K6D_A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ84PbrLNbr2kQ3UENPHxksWneOoxHJMcbBL9KycCA2ag&oe=6A9EB402"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CPEp7NWF9HAQ7kNvwHcu4rW&_nc_oc=AdokQkvqetykTj9JJJEd52D2p1yM2MSdSu-Rj-5kRzx0JXuA9YeidQc1-
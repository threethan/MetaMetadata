=6e7a0a&_nc_ohc=j0--LyCGpikQ7kNvwEuCQmy&_nc_oc=Adq9KoWmqEChMUe5eK6GryKW9U92W5qg8LzC3EzIL4GGZeRxv6MesQ-dCGaw8c_A0dw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCPb5DxkDEN_whAYkpcmwR3nuxQ1gIuxJ-vM7-kmnTzfw&oe=6A64B685"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UemCf3K8V0wQ7kNvwFlPp4p&_nc_oc=AdpLK-0I0IEoQv9D2iujz2eGnXDqdbt2gM-Nwx8Wbg3wrwBae4Db6XYe1oWSJxUWx5Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAqZ4rbx94Zi64ppEDBsdjrhNMUUUDOVwV6jmY_dkwI8w&oe=6A64C412"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_NYHf8XpkZ0Q7kNvwFOqNPf&_nc_oc=Adqwe8PHgAxRszB209pVvopS0rK9S7HNRbxCL5xZ3_Q_8cSKZsaduC4wgqzu9tu4yFg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmBfqpKqy2ThpgTx5IX5uDLsCH4Kj0BLgtCMxlODNzqw&oe=6A64C104"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6fLvGzZ73EsQ7kNvwG_sCNi&_nc_oc=Ado_bODqSQQ23gRHDB7-iM-x9n308g_s-w3av6ARlopHn74PiEOUfTQjLka-NqWqijY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBK-9DVjl-YaRf4MEiRmdkTpEho2iPvvz8NfELKhN9CPg&oe=6A64AAD9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_7LhKZOqYJIQ7kNvwH-1pDD&_nc_oc=Adp1H1mu6dl-gAup46a9h_gtRR0e1zb-lenTnqzFBiZpkhcdByllctgZfkgg8WyUt5E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQByvp6fmt8PlXmFKTAHxuU7h04KcUAscOxLUNFHt_JCyA&oe=6A64B202"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4RIOzIqDAzIQ7kNvwEZSenU&_nc_oc=AdrrrpLRc_0C69NiLvSBqjY8IeiaR8VG0vW_98KIGUA8oWlAdIhV2eKsD
=6e7a0a&_nc_ohc=mT67btntPmMQ7kNvwFCVLJA&_nc_oc=Adpa17p8TAwR0Q54OpO_Hyv0RCvOIfY_jrHfWQCeJZRf0erMe1BwPTq9t_1INgsSn6I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af58c2LfGZ2IKeiERNC5heZjhRxfkyeyHSIqzjL8w39JAw&oe=6A0B1085"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9-Q7MeGvoPcQ7kNvwER8BTg&_nc_oc=AdoAC-tavfPCubOV9E0EHGUlGEz9B4FLGNP1bPRFR6DCQJU3o5jXR10Lr8WXyLnv78A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4C1gKu7f8tYzY27Lh_nhCao8BDp7C1h_gtowbiQ2fiEQ&oe=6A0B1E12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IKhTfiqSBtoQ7kNvwFrFchk&_nc_oc=AdoKvP2kWnPYIMu_AqcbvAXIYoN-wkpUYypX85MwULxX9rL6wAacyzevfM2OFRN5qDs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7qrsbi3AYKReZKFEwwNQgaSaSbnx3-h4U8Kh_b1vZ9gQ&oe=6A0B1B04"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AAXxZY9OMHIQ7kNvwH2svXM&_nc_oc=AdqoWI7uNa40eiZ0Unb2f347mUbzmaBlq2WShZx6K403z-oDMrqdjtKQUH8RM-BPHnk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5jSphk0LbClUF8ghDRRLK-oJK9WLp9QxO-bNXKetAAOA&oe=6A0B04D9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KODEUY_LKyAQ7kNvwFC8ixb&_nc_oc=Adrf0mZc7zU9u9ZFYhvlC7gyzqEhsGLhjF5ZFjkzc6cJUfntUd_UEEeibV6Xo1PsNzs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Bi0Gx6KSBi5XMalG1Guc_h2WmciP1m_PtMSX35pTceQ&oe=6A0B0C02"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YVVwmb3lcIkQ7kNvwEnINQE&_nc_oc=Adp_J8SjL_YEyQ-1ozYkUsj5JVViCegtMHdOS7Z-XP6fdRyO4vGdNfFEc
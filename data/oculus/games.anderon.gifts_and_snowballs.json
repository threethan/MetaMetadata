=6e7a0a&_nc_ohc=kafsett0vJsQ7kNvwE1FefM&_nc_oc=AdozwP1LxxjbFsE1NrhNdW8Wf9J8Hc_btFLbkibOyIcnq5N2SMb8Jpk4om00BIltkRM&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2NSEPPpOVFvVafbm3JbNELIpkQ7_9mUjMKT_PejEPnKg&oe=69E23205"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i12TB0yhJNEQ7kNvwFWpDGm&_nc_oc=Adrfr1MiGIOR94KEwKF3NW60cBWOHgURdXVBr29_V393wd05Wri275oRuM57NcUG0hY&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1xqj7sFGSl7UZtYDaFjaXURCri33gFS8gZ41Q2YFIQ5A&oe=69E23F92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5w6I_sKZgUwQ7kNvwFH8tAW&_nc_oc=Ado0NS_s-gqbKpZiiaf_X2h9ZY8e-YVvBkvjylXExBh9-FANY-pSRyeacL6VUo5QYDw&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0xZfZQ-zrhmcEtkd864HFR1KtqLyGno-QxRbB90FvNTw&oe=69E23C84"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JqUnvOePWTwQ7kNvwHbZmMk&_nc_oc=Adqst7tkR-u4HgDnDdtyG5ErCnYn5M0cegYC-AlJ11awtKwL7xynIFsjV-eoU1vANF0&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2jyISuJxJzn60d6JTHKgQx_JLERlClam1sfflR6x__yw&oe=69E22659"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Nve1BT5Yz4Q7kNvwFmv_5t&_nc_oc=AdpDPpDfz_SNKL-rJfgV273hAAVIhKVYgopIChZENGrQPfXytzPoJMZpakE9hSAMP_A&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0wV6FNwVih0VCFidbUaTF2uUcZHy5PU-WBwg3Bz4IxGA&oe=69E22D82"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HnOgWk6Hd6AQ7kNvwGh1arH&_nc_oc=AdqE4bdYKLs4YJg0OdbVfkZddQi2bzyOyMzTdeOonPy0GuRACHGf3Qyyd
=6e7a0a&_nc_ohc=LBmvALYsKRsQ7kNvwEErVlN&_nc_oc=AdomDuL46H2aiC_6d3Rlq_NgsDifL_sn62it-REBZ-Ly1dVkkGoU6UaiCT0DYTT5WBw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84bWWxSpxmsvcRwKJ31WA3qOwmPIsEyvn0N8quQUokeA&oe=6A3FCC85"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J6BZDgvHdFMQ7kNvwF3Qyjr&_nc_oc=AdozsvCjzZisk5_ZoEW7FzwCkOT_Q5UAqvCWgVvuW4Ml4MZLVw5FBXNrKh06eXh6hrk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_UFHkA3ab0Xj3_yYIjfhnY6-NiJuphSxnaKcH53i0Ffw&oe=6A3FDA12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hfKallalw74Q7kNvwF3kl-U&_nc_oc=AdqpXllKcIyMg5hZOIAKROAWrPXeyA_HCrJ_brxcXF1w05QLg8eG_019Nhocff2m9fA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8VxTRlB3P9w72SwSrZx7s_Vu_KdaAcXYqz-V3CK30keQ&oe=6A3FD704"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eeGjJfPYiWoQ7kNvwFlK1uT&_nc_oc=AdoZxDhxfd1biYXnCZShYA6ZP-7hNkGcGMsKgeesyKODaRjIrepC0y4jUzfCpBOC1ao&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81484s3wiHzd3cqLB1SzyntnJmN3U9o2T16nUfVhC3eA&oe=6A3FC0D9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jGf9BuOgJBoQ7kNvwEZH4Wi&_nc_oc=AdqlwiQwDoIP8ynGm1apGWlL7xzJRO-6qdBt9IxDyJtUgbmA8uNFdhECtmw9qpUyorw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83GkAVjS-Zis1qtOWtnOGFOaPqeRryGhraclMo4vLgUQ&oe=6A3FC802"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yPhvkAeUG-MQ7kNvwEKpgmH&_nc_oc=Adp6XzNng5L8MdU0x_eD6JZKCprN2DOT47D0KRDM7AmrYNSfbS7hM4Qxo
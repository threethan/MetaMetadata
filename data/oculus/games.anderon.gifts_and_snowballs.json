=6e7a0a&_nc_ohc=BUYUip5p2JUQ7kNvwGybnfY&_nc_oc=AdoVGCeHQQWSDuxlKioHpECEZB3dZseNE_hBqSJxcKG2Mr7aVeiJ7Rbgw4mjGysSyKM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_nPGM6gVDfgSiPXCF1OhlJ33qK1f2IRDD_DyCSOg9AQ&oe=6A733705"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=epCQXZd3EVYQ7kNvwFRaQSp&_nc_oc=AdqmHg0F904ERKJQal3YLfpTA0Dncu4meIbpZoTxQsXkudqRROqgflmFydEIHjj40vo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFUn57UrC8786Q1rGcogwgoRKChrjZF3wHBAGGN1kfo6A&oe=6A734492"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nkxiM3_SEVcQ7kNvwH7j2Mt&_nc_oc=AdqQqBhlC67ltNIei4X3tOyV_ZLsLQxdMSR5fkMif1ixbeqGOdxWf7dpwAz5MjynUq4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGnv20kVsu38Pp28G6yqeD3DB2hfNgG99GXn4OQkNRIaQ&oe=6A734184"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hr5DtGbDd0UQ7kNvwEzD16P&_nc_oc=AdqUx18anzmQQm8gMYYb-iNFTl4DjeZZUoS-VZZWyrWsLdwQodXSuVQjpdbwrrlT2CI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH-FK4De_HwzYJz8Vs0i6bwvhp4e70O1WB0UNILPXczcg&oe=6A732B59"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b0Hqxn39yLkQ7kNvwFDAYRZ&_nc_oc=AdpkSvSnhm8Vu1LKjoLCNkRcb9451DWtchtZrYgcBQkWRf1_D2A7qBlg5n90bKcSrkk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4Sm3e4WOnpOiMVZZ-VWV4OhYCSR9S9ihI6U0N1WfhIg&oe=6A733282"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KXgCPzgb-ykQ7kNvwGsri8i&_nc_oc=AdqP-LEB8EYPJW83xK3uqL4PJMpbpUze2LKOPOxLZpW3mhEz-wjiEKRnS
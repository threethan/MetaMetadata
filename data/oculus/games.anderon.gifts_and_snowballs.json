=6e7a0a&_nc_ohc=HOLYN9yBL3EQ7kNvwG7j1U_&_nc_oc=Ado5LdmBHpvXi96Vw9HxqUZQvZAkaqOhZtA4T2sQGzIj_eKvvDC4-HlKFu1xL8ZDjK4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKO3LF0fK14mzQ6kM5pzAijCcSDp_xuC-Tt-VobE5mI0g&oe=6AB27F05"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GOm5V2poe94Q7kNvwHfT1TS&_nc_oc=Adr0SFADYzPf_rneVPKMIcSiTBr4C33A0RI4ku7_ObOX8d3e3GhcKiVS-c4gbMwyOOk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJAaShp9bFmKtkD4UT79qzLyKu5MG9T6-o2w-XNRBsH4g&oe=6AB28C92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tiAp0qgXyrkQ7kNvwE5oaN2&_nc_oc=AdpeCsB-iuv6tWbyFIx6ZAoyYFVoPMPmcYw0wzxR1yHjntcc7pgzSssUltnEYbX5Mow&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQICmgFdIYrDef-6IfCTDTLYQLxHjL92zbpwbLEv9T5kYA&oe=6AB28984"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cT2AaQTPg0oQ7kNvwGrBBRS&_nc_oc=AdrBnwx_1TiznSMFFwrdbvdJMBbts_e40BahwSMNas_i9C7Yl7zxwRCYuh1pP-vVL9E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJtD5HsvirS0sumlPLyW13am2wDRzFeHpuG3UWZM94S-w&oe=6AB27359"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PigRjd9JuwcQ7kNvwHFgy3O&_nc_oc=AdpT6E_QqN4tcnVrf6OpDX1XWWK_GcZLyAlTJGTM0gZiECmVqgY-Idw5ffDa37viIUk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJOGUU1NILFof1NqfPFtKnfWPfXVBjdtmbyTIndcTE39g&oe=6AB27A82"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qsnS6Y-f3vwQ7kNvwF6vk6R&_nc_oc=AdqxfqprJbFDFwIrBmz8VdGRP1ogp-xJNQ663cP9bLkkUW6zfqkdndgg0
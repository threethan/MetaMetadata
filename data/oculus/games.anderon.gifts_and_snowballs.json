=6e7a0a&_nc_ohc=vwMGze4PwdkQ7kNvwFGDznF&_nc_oc=Adp88XHOMWY9bEBu1htjOITRzyZ4HxHnebTwcXk3EFOjVh7UFm2IstrLNrBJoa1cwBQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af320ybzF9DhgwJEH0CCQbu0k4jo0c8hVTbK00ZKeRaVqA&oe=69EF6105"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5BQ-h1ve25UQ7kNvwGZEbkg&_nc_oc=AdoxESiXWsaNMZg2bcZlTSlGH2aYlwVJoCifJr9ok2BiDheWIfuFf29l2-WNlAk-9fQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2-hEWSQJgrhJzJ1v9dLtQ8fdP2g0pPQjbvZuXyrB7rgA&oe=69EF6E92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PRFTM6vm5a8Q7kNvwFFKRPb&_nc_oc=AdoVvpIWlpANKGSizIOv-ed6E3tBw1oJJX9wUPeHxMVpvHEsbOax3yiZhBj-nf11fCk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3OpGm64h359oU6Tw01xIsPcK284d95vInfbD48fS3Mkw&oe=69EF6B84"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SMra-e5XKOMQ7kNvwHDMsNw&_nc_oc=AdqIWbqO-2mJ_6hx-UjfH5F0RKeiiULMrEq36DZRegr9Ed7_zYnHsDpNjFGQDwoSPYo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2ANq90E0rHyNbZvHYbo5_dg-ugJuGxhco7yMMeZqUtAA&oe=69EF5559"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XcBB1Sx26tgQ7kNvwEHY5kK&_nc_oc=AdqbW5zIEbJa2rTb8o_WXL3TCldrKZkzmx3Q1lRn-8QGvpihl0uL85YydAxs3MjQoEY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2uLyvc2ct2qIkW79PjuZV_Mw-mpFZZ-4tZ8j1s0eo6MQ&oe=69EF5C82"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dxkK3q6iT2IQ7kNvwFkFDJl&_nc_oc=AdrOnkb3OsoBDObbYOdfP1LnN9_M-VWu8CRJs5mfBA1adeeDZGX6-pzx5
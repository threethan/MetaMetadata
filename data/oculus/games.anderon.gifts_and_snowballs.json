=6e7a0a&_nc_ohc=j0--LyCGpikQ7kNvwGUcu9Q&_nc_oc=Adrq8g-qi4EoeFHCqQXhlH4Qbq7woC1XFE6ZJ34LFWdFpXjxvzjeBOGbATvZkMnV6Ls&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBdKRgw67H1iSeTWpkVmLG-8vTjTImwxKM105o8POgz4Q&oe=6A660805"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UemCf3K8V0wQ7kNvwFzSMN1&_nc_oc=AdqkEQxl_I0JX00aVBVTErhLoQSq8fzhJ9PZ83S5tLkzs_HlcVcdaVIBqG00VnvWdw4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQChHYzq97ja4pgb46p2PhQbAlNX0tKe19-DMMdpkBYWUQ&oe=6A661592"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_NYHf8XpkZ0Q7kNvwHD72Fw&_nc_oc=Adotjka-E2Yo0-FLzy6qmR475iTMChB2X8uGVTvABkpXMya6fobrBu_VmfA9v5qfupo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAyJ6BTKGWKR6R1_impfoXsi-b60wG6avuHJ0bBLPNmFQ&oe=6A661284"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T4Z9kZAYKWAQ7kNvwHvAq9m&_nc_oc=AdrEIOi6fynSAIXC4GcJsRsulx24Xgu5mp2ZRiqUjovSUxu-F-4AGql-tWkDuLODA88&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCeQwSC7W9QX8a8346KQ3JWHXVeNeNfQmBDZE6wRKL75g&oe=6A65FC59"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_7LhKZOqYJIQ7kNvwHg4skj&_nc_oc=AdqwYkuhPKwiNGyQxrIeSL84VpoXF8T0earFIj4xmVTMt2fWcK1tiueubVB5NNkRG2E&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-UpNSh1fsiaVYj4fgIvsNHng2qeL7ZIqeQr--hizK_A&oe=6A660382"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4RIOzIqDAzIQ7kNvwHvsu3J&_nc_oc=AdogpP9fOcFqstufqkSikqxtbOCKf_f4vN_WPIPuMgyXR_wwyftyixQZA
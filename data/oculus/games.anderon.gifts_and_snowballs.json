0a&_nc_ohc=_IfVhTZmEucQ7kNvwGLJKI0&_nc_oc=AdpzZasYGayHfeA7r6bKTjC0pgAHTJ6u12jrauDcICZi1nZmV0nRQDvoq1V_J-DJRN4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzvsYPLQ6mVuHUn5yybBK448l89WixczWHCCdi0zDqWg&oe=6B05B28C"}, {"file_name": "pinched warrior03.png", "id": "2233739983674845", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391837_2233739987008178_5682748129040869737_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iDEFHlB2e1oQ7kNvwGwKyv9&_nc_oc=AdqDSI-GkoHxF01S_ff5d0iIdOGCcqIF9A_u3ZhYFOs5yapPadmam3UF1pgFDxEqaMg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSawVo7cQWEUb8_yRmeHITEgFxLKtzWD05BMd4PCOG7TQ&oe=6B05C5C5"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vVMb0lYkQu4Q7kNvwEpzX-1&_nc_oc=AdoHfLjh7HA8bCyOTDJapwUQ6YovNn3Ahwe6xxu1jN0AlqLyXvhGG1ZUf68B9rwxoeQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSMhNWyWh6EBVadH_ScVReW7HgTFTJDUhDX-ILHWjhPw&oe=6B05D352"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=14RDlSt5EZMQ7kNvwEaCIQT&_nc_oc=AdrOw6Qgc9cHXn9hZ15U8JEqgbp6U96PO9JSNYp50dauLX_12I9PP5Q9_-KV74Mat0o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTS5-3TbajzCEbZx07-5a4mtYz_Fs4rvGpWR3rj6Co_A&oe=6B05D044"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UzSSgaZpK0gQ7kNvwHsQbfq&_nc_oc=AdrL8xmmsvsOr3bXULN55s2AdTTiANilpqoTUoknaTn1ykPzQ4g420KPjjjO8yLJlUA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyVzZBIP1hqwyyHGYAWtHIZuvdJBiieDoMsUsqzGkaxw&oe=6B05BA19"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3lfLC5hbPx0Q7kNvwG
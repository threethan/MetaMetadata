=6e7a0a&_nc_ohc=mjTsurLOFoEQ7kNvwEDLl2o&_nc_oc=AdqKwXTMNa9aawGAxTe-jztW_NaEAxRNhKooC8ASiRZlNdFZ4I100cOmVmtefXdElCk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtXzjkI3V_NIKsY3h6NvtmNO_Uo_unk9RkqWSXYKFisA&oe=6A7F1485"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LLRODhbZaisQ7kNvwFZX1YK&_nc_oc=AdoZ1oHmp4MpF7HxgsAvM2qsTNQBw1WUvn4k78ezISZ1aOhDivxsfs680eTnl4PZqsk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEFg-F0P-wLP6zMnH9sHBoA1hikTRYGyrewZapj2gud1A&oe=6A7F2212"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eoHh-i1Ay8EQ7kNvwF2Q4Jt&_nc_oc=AdoxE3PLYbBJXWobyLQV0a4Z2M9PDIfYsdAHM3cpxx7Hmw2EVcv_SBxDxJhJaiLxgEs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGiYdPJ1Xs7_NdZd5p5pjaV2ZKtBwmPtg5Zipq1M0yf8w&oe=6A7F1F04"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tVBCB5wHSzgQ7kNvwE0bAB3&_nc_oc=Ado31YkQSlF5sG9Sjl_ETZeBiuUIqEMySv-TAM5Q3NxQ1tSWIRrwtzTfNobK84HnZ-Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHHG3tmhIE-Zz45LgV_04uZse7ce8gqUMvs07L8ExShFQ&oe=6A7F08D9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rcDA9pbOaIkQ7kNvwEhIOro&_nc_oc=Adq1FX96fZnhJWplot0PUUWp8ECgZJbguqWztpdbwPX4n0RY5TCD0gHi0Tmu28agzUs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQGyGbZlyZiDXj5pxR51fPDnEIcRY0nUpEBrgqjpH_VA&oe=6A7F1002"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oxx8guMJl5IQ7kNvwHMTS1z&_nc_oc=AdrCEwBgcHmQh_O_vjuXtY5CEPIyACcKZpUfsNTSYpyVe8wTcNOuzK_5T
=6e7a0a&_nc_ohc=RM2hJWg5rPQQ7kNvwG5VLW_&_nc_oc=Adq85FUgOpioVaWfRoNdW9batyBs-HhkZpizLeQhFmfCiViLaUhCduZZ9EU2qt6sNrA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-FBl1N0GEOGmxIOmHXg_Htkrf8S7nU9-_HkrQdOZ16_g&oe=6A241D05"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9fsKev3AGOIQ7kNvwE3-omK&_nc_oc=AdqDw93utXUN-L0X0TJAqMEYF36TzXlOJEsVN40FYRw7N6hGxfkEA0O5zvK6HI6lCSk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-9wELL5ZUaFsq9una9dVBM2dDfRFtgH3lQtil-qQpzkQ&oe=6A242A92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2i9XWCdXBfEQ7kNvwG-9TNx&_nc_oc=AdoEScFuM3Y1yBNUZE-IIgOZb55jU89tTaQ8vmy5pCKCNS6Iy5EgXhXSWJhDOt6WHV4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-AzgeAuvEFEgaal7WFD__qpbZ4Iru6Sl3TNR_w-nbnkw&oe=6A242784"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gob7rSn2qDkQ7kNvwHuDbt-&_nc_oc=AdqexdJYv-ZTWLiwC3ZCtmIt1Hm49Mr_Bi8Em2Egh_IPO5cDgiin2iF65zP-fC6dNjY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9L2HbF7wo3eTd0tCxeZpgSfqcaEjXlWmF1UhduKvSUoA&oe=6A244999"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=33o-VdRN0eAQ7kNvwHPOqES&_nc_oc=AdqH5oPYwLKN6JOaHuVD8bIGjqz8gDVKkMx5dVLtvzT5lk3q8arvDaJq5XDnzN4Li7c&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8qDB9PRiCuWgGbQsdgz65Jp9-s2_nE8NLvwuKMUR0sKA&oe=6A241882"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KQl8GUPODCgQ7kNvwEuJIfk&_nc_oc=AdqPxIrs1LQlJjUmaVGRCNXqytii_K1T_BAYRHkaI-so79up8-9BnFApH
=6e7a0a&_nc_ohc=L5FoNHX44eMQ7kNvwGE0x9X&_nc_oc=AdoXpw6sErGYH1EG130kQCuEcPcOXUyFWUa3GwzZLtWTjv9NNBDFF531JNlYboc7EYY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyJ3IjQZ8CVRbOk7azDbVNSMutY9GAY6Went1QjVh00iQ&oe=69CBC885"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vxr5OLNsJaQQ7kNvwHiBR7o&_nc_oc=AdoWlQUi8rj3OMy-kHp_7KrDSLNwUqn88hkrPHcXVj1DdWfAXjBfCEJPnnbeaAhlkz0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxfZKW4mjjTqL-doRX_i5Xq5EW5kHU59iFhZXhawGZsPw&oe=69CBD612"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4GT_CGYfpsUQ7kNvwFoyhH9&_nc_oc=AdqYftx1eXq_C0yyPPZmpi12PfB74A9JFLT5TK36ZuChQMf73YNS4naUJJQEaVHLASA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz1Dx9RPeGKAHEiFlFFeg6u4_gtCqxCzbEd0_341DUO8A&oe=69CBD304"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ebmAQt8x9RMQ7kNvwHcBfdF&_nc_oc=Adqxg612HJ3Y3coxtcrRdMy0ted8cruFlSoLm82mg_u6BUgxjoGP4c-QIOAZmJybmLU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzzRuX35rR9tOSGGysceQS5JLYjifVNEAD0q7L_3izSSg&oe=69CBBCD9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P_dKzqVPyPkQ7kNvwEe--xi&_nc_oc=AdqywCrz8G204lKuU1T5JcW1Si3or1wwVV7f54ZsiOjyEUE-vHo6onPg69ymjE5HMiU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw0RtuTG4fICGxUk2dDHPkXw7pSOc67jw8A0pLo8limAQ&oe=69CBC402"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4J4Bak0BiWkQ7kNvwHBSVq2&_nc_oc=AdrSRE5fq24XOTdrdnPz9nIMEiftm2fXMpkgFn_ZTLQSyLWRsS67GOWE5
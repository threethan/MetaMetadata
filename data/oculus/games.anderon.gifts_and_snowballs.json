=6e7a0a&_nc_ohc=L5FoNHX44eMQ7kNvwEPtUF_&_nc_oc=AdrCfvB9gDO4ovlt_vrppUTM3XnwSVhECZ4GAlZGn9z3RmFv4EN79r7EW57kY_EvLnI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwIWheZF4f2_nEWQYvaDiwce4kcG1xyWKe5k2citSs9UQ&oe=69CD1A05"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iHJ2O-FGu2oQ7kNvwHFqlNI&_nc_oc=AdrwQcb7c73fdfdsLcvlAMyugxkVigqyMxi5Fwg6FQYZGi55lhMvEiLuRbP-ZL3i6IY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxdICq1LT26ccliwFPEYiBxGZlDOQyyC30KGihlz_2lQQ&oe=69CD2792"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GlJqBRBv38wQ7kNvwGciWzc&_nc_oc=Adroxvg-qfSZBjc2Rl1Pp5BM9b8zzSTtSYI7JN4SLUZZqk0ngknqpHFtdlnkL-1HMIM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz27qM3YhluZfgz2m8MnMzlQYZmShU8zZ88jmuvmBfPMA&oe=69CD2484"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ebmAQt8x9RMQ7kNvwFMOPS7&_nc_oc=AdpzjbmwOpyhW3iRxUX1Pf27Qso2ainmHDGsqCvA790BxGsWfs7kPtIJR__CO4jybwo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyCNBtcf4xncWPXJZnZB9clTUvQgfdt4W8dpx4TvBIWfA&oe=69CD0E59"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P_dKzqVPyPkQ7kNvwEVax0d&_nc_oc=AdoUhIrP4S3vSlS9-6PaggXnvPyFpqOX-H5ro8wDVFvCoqDQifhxglKhSvbGZHp9xMo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfynPqww7aSQtcnoLVDEdx5yV70rjgAbcAGmsF27gykL7A&oe=69CD1582"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hJSI33ATC4gQ7kNvwEyStQz&_nc_oc=Adp--XCD-BIBvGAu2N4zR7poCyI6IuKvY9tAlfcaXrG8hzN6tW-MNPfZA
=6e7a0a&_nc_ohc=c9p6SJSqI9MQ7kNvwEDYPs7&_nc_oc=AdqJW8SMk90bnZyN_N3UM4h7akSPmtRiPRQkaOv81EpJLWnsikXgQPqPOYhing2GEQo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-5s622i7Gn7D26oA9IH-qlhMalxt4G-L8ZuyxHarRQFg&oe=6A2C0605"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wGcViX9a_WYQ7kNvwF4y-7-&_nc_oc=AdrZW9ExwMBrFSGO6tPMGpOvMEHpsx5LGME8hoPJa5wZu57xMx0TlEdNZ_RBM8GyaVo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_03Bl_cTw52wiqVR2f7p1xsWzyVTb5p-Ppt-9Y4hI1Dg&oe=6A2C1392"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=---GnwHyaS0Q7kNvwE2IagB&_nc_oc=Adof05sDya33Yt-ERO4SwxFNGu7XtlxEroJaEI5781Q4Ztsn4-3m_DpEb62A_97YyMU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8otgCme8wjcQ3XxaEwXRogHXqGGP3Nn0hFq86dQm4A_w&oe=6A2C1084"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oKSPFUQj4ecQ7kNvwGqMPVy&_nc_oc=AdotswjpmBFpbiCA6jHmAzgd0x1YrTUqaOE5yQGFxVqAzNEFFch3FPPmsR1evY7LH6Y&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_TbRUVvooc6ZW8kaecOCTN9pvavEJrdlbK-JA3xbjZYw&oe=6A2C3299"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YfaiN5lvaAsQ7kNvwG2-yXu&_nc_oc=AdrSi7DQubIg0vlo8iT3Aj5f7UqU_pN26X3T7MvnHLlZOyXe4SYQJLes2uBUx_C7M9s&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_pMVMUth8ivAFrd-68W5KvOJROhnOeqzXetmf7P2CMQQ&oe=6A2C0182"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y_L34ByqOzsQ7kNvwExwur-&_nc_oc=Adr_KWmhlqvGaz4t6n_6Leqj77L-u87rMDAPy57hj3y7Rj2S3iD8ZTpGB
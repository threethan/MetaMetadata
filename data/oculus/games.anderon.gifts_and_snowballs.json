-ord5-2.oculuscdn.com/v/t64.5771-25/75286676_577533401544348_4203344657555901211_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f4DdYaCivuIQ7kNvwHG-eyF&_nc_oc=AdkG9BXd92H_op9IR8lmK7ZbJiDnl85jsO2Ies-WvJk3ngBjFM0orpXx_7AgS0azmsE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyBv0cinnG7BpaQKiPzWyOllIZu99ghtnrJfbMaAc_rGg&oe=69B41828"}]}, "id": "2073760636370964", "locale": "en_US", "screenshots": [{"file_name": "screenv2_02.png", "id": "993244952825890", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974853_993244956159223_3665934591366094743_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0lHgNAOHZNwQ7kNvwHE85sR&_nc_oc=Adm2Wcrmae0DPlReoUpJVATFoT8dKgI22Z5zeAMTFMqcGUzyNtdmvZOSUYrWvjzzigo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw3hc80F4u3WsKhiUNLjGuNWsLs5coRreBMy2skYjGsxQ&oe=69B4020B"}, {"file_name": "screenv2_01.png", "id": "517646341325841", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572947_517646347992507_8365861269156842802_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NIpMnC5wYwIQ7kNvwHYUSLR&_nc_oc=Adm1RgnIDFwLANn0RoHfO4Jo30UxHHuBxGWkfQvxdb1cQmcP4RUTE5Anpb6Zsvvrz9o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzQlA_tgJjo_K44Fc5RAOoo31M61aAenzLEmj3nsD2muA&oe=69B3FB63"}, {"file_name": "bagarre selectable01.png", "id": "987094796807741", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391822_987094800141074_5341301578934495068_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6yRoVN5hr_8Q7kNvwGHW9KT&_nc_oc=AdnooBSET2-8luYlPYaHKiueIcpwZCapdwyxd2YpJozoegatAnpqM2KvyOv1FThhCDg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzprDbXLY6Q032Q6P56vnBRJoSjQdZ2REE5GpWC2yRDrg&oe=69B3FA4C"}, {"file_name": "pinched warrior03.png", "id": "2233739983674845", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391837_2233739987008178_5682748129040869737_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RJJ0DGFcf7wQ7kNvwFWhfoL&_nc_oc=AdmHep9HsC3wRXY24YToZGJmE1UP4ygv4y9hk6vk7CV7UvRv7Iecfvp0qc2H1uIj7Is&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwuqY1XMdsfwQF6zxHfZQKcL7lKab86GnxxS25aIkukWQ&oe=69B40D85"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4qNb-jqM9kwQ7kNvwFusBrx&_nc_oc=AdlxGYAipNRWNdel7yKKFJA7QG1PD53UWfm-gTaDmPftamWlphZypeffiU-z-RiQK9o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxCH1Q5a5Bery6fnqsUtd0ayudADJXqpYxknipqlnt2Dg&oe=69B41B12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rdz-OqvaRdIQ7kNvwHe5qIq&_nc_oc=AdnYAZlngTTe5a4FVW1e8IyolG8UFGa-FRhXFnvLR8d1VeQmTnzdZImp-Ee5Vn2F0Nk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxuEL3SqG-VrFm1mCMR-D4R4hRYVC6YB7aPBvxQslUb8A&oe=69B41804"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2QBShXm5o1QQ7kNvwFANDHS&_nc_oc=AdlNxsK00GXnPalP5-h2MJofu5J2hIxMJGR9PsFeAB0x9IzwFDT_p5j0-Djl8mSRwBA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afzq3s2vmpbIMUrL-GlLIHnlE07FdLGo1XpyRsXbIcacpw&oe=69B401D9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0YAMA2ugSH8Q7kNvwGqw_7G&_nc_oc=AdkctKabXW-pkvSoe2_F8UUlrIC3Ttdo1ngcqBIbVU4SmNtft_zn6APYQh4nsbqDNwM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzbxjBnlavPBSF6WYwky184VJxTTwYJINzEC1n9ChlUkg&oe=69B40902"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ei5JzflxAlYQ7kNvwHUTGUl&_nc_oc=Admvw9SD9Sb4XCY0ag3F6DFRzg3W7MZWCDBLWkeSn5x_t8RIuj9mSzJBckLWh1eapJk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxiukGMW1mKu6V3
NGn9RGhj8JO5QwQmgwpqcPgcDT5yeZgbHnry5cs29ehv0TxyeQWUdalTeIL-FVs&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfxYRAGur34tuiIY2dJrSkrye9Cz5WXvRBR_HuJuYBCjxg&oe=69AAD305"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DFrNBx8eLgMQ7kNvwE8BeQX&_nc_oc=AdlQypqCnhIiZmHpRKf93VAE0yP13Yk3BuXvu3jzuH-u-fjuCUZLZXj0vbUlAVQFxjo&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfweuwDSCGRbBv4NM5J7ccE99EFISG-IQZdLEwoXd613OA&oe=69AAE092"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h7WAPYa6mKUQ7kNvwHF4ag9&_nc_oc=AdlnNrBYYKeXEVtejEAzUhQgc906lv4VhWQ0jOo-V0bU0cKxojJlr6zryDP572iIjGQ&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_AfwhbSDgnXAoClAAk4sKRMJzWysxiJiMbxxbc8n953f4JA&oe=69AADD84"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HXM0jP3mEMkQ7kNvwFqsUyd&_nc_oc=Adlwaxhl_IiivSQ0ZM_yv9UpUvP59Y7TxNQqQGQN1_RzjPLmglYq3ZrFv9vM56GfCMw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_Afwa079e8D1WpHKpUi_jLym8xBY3tLarJVHNsmnmNzcu5g&oe=69AAC759"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Gjssa3IyzEQ7kNvwHm6lz_&_nc_oc=AdniiQR1rE9Rg9fy0rNjL6BXNApn4xtjzcGAKMl--FVxwO_wO-6uzFrtlLaeADR2lYM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfxDtgeyHlY5j8zv4STYVqGkUul1nLFz8pErgin83Iyijw&oe=69AACE82"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fzDHDdKe0VEQ7kNvwGR2CV0&_nc_oc=AdkYT05C_ktbs7Y6YGbHxuoO1PsbwB1UhhLGdVrLeTJC2wKor0TPI3lp42Jks-dyOXo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=
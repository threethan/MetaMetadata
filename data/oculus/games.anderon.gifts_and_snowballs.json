=6e7a0a&_nc_ohc=-fi4RqJxHGYQ7kNvwHSinBu&_nc_oc=AdoOrCieJkN-KwgRcdxXXJNIsov2Gn5tE8wnLIJp2PEwOjPT-yXCNNo2ES5PGOQrZ8k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4c8mDjT0mDEeh6paSEUt67ZF6fxsXQNM1nKKtfX-EeTg&oe=6A032785"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hbGvPYrgT4IQ7kNvwEs8zdl&_nc_oc=AdqVcg-Xpv52zvu2AlhEBV08cVijYd-YNbcb6v8Z-CvC7t83x7gOs9ycvP7j4GS6VRw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4NmpRIjMW-5K1yrzSKjQLGCioMaSgiYdRykjXRKFs39g&oe=6A033512"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R8LuGlUAb-0Q7kNvwFY9H8X&_nc_oc=Adq39cmGdTNBv-GlT33fRAk7o4XA96Ilt5qpWkktsI9mteEwS2TrpQzVTa3Z6EHK2Ks&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4zKX3iFnCD2QuxN7Ue1TgKfbUe5cXfxliCphls_RhKKg&oe=6A033204"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zo4oqmXUIRYQ7kNvwHnHzZw&_nc_oc=AdqPDg_CFkvmf0QHyV-IefFHczyF2cVBS-j6gUGRHg2Cs4WW4cW4mz1Zgbxx4O_ik5Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5j9bsIi1kBWSu1m6d3lEwKk-W1CVRSoZAewVrJuIvCfw&oe=6A031BD9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-E3iBoFdJTkQ7kNvwF4uccC&_nc_oc=AdrKepK75-arj8EAv3iPYLqXn_S81UAD2eqqj8Ejz0i0SCZBQ92zDtHs05QIN9J0-JE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6cZgW1VvPAIpBM66uY6AdIn68pmsUgaX60RaiE81Kr7g&oe=6A032302"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=33NrlRCMydUQ7kNvwHmk9Np&_nc_oc=Adp0cONL3-9_61j4CJYbMlKNuaruMnJSGBnNvaV-lJX8lPVuihGwT_FHO
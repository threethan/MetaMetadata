=6e7a0a&_nc_ohc=BmcCriujQT8Q7kNvwFv0_QV&_nc_oc=Adr_PIzulS8wczI-P1_h9inLsJ5Pxinz06VO2fJHqhX_dbIjUep7EoSrxBFpRnwb0Pk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPYAqvj0kPayAzZFUjp3_XcSbcmvGr0pk5QQDlkMwWnFQ&oe=6AD3ACC5"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NMs6U8IwaGQQ7kNvwEd3rK9&_nc_oc=AdroGkKE7kcPWfUfXkGsU8_jWV-hmAjJ-f8_PqNJjfCT_R5dBEXi3yed2d5N3DZuaTk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPzT3wvihRce2lmxkDtS8SsOCeD63IjajQ83BiwoMwSnQ&oe=6AD3BA52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dUdaFeN3fvEQ7kNvwFUYXW_&_nc_oc=Adrva4iTpMle2P1k58H3c_Bhjj6B46JMJLIO2UUOof5y3_xogSixEBaI12aiOsyzxW0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQSWhZJxMIZU0QkR3nWczIGqdaZfJoO9w7C0mjbZ5hFA&oe=6AD3B744"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IrIxAUhe6ZkQ7kNvwElUHc4&_nc_oc=AdrDv1K79IPFLq9zCRK88Kjs_lGtxztuaeHOwNQ3l-X_pdJtd_qDnAd-qAXF1RGzAcA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO6VZbZomvupF9AOgzS7AfCj24WJvvJGQIqkz-Svg9flA&oe=6AD3A119"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_tpCvi4La1EQ7kNvwGCpDPi&_nc_oc=AdphkMc1V5KsQY7dtDnInkzUJyyRvc5dTD_zvqMBMuJT9tN3p1Hl0B6-gGYfaTwVAQE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMelkrXL04ED--PykdNKlTBKR3zweGiwkbkAoR4ufQEVQ&oe=6AD3A842"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i8DniH_BBMMQ7kNvwGmuApt&_nc_oc=AdqHGwmVZ2p8F25zeg_iLRWqRq_5wVO7iTfzqUa5SWYbTAxH8sL1Fcs3u
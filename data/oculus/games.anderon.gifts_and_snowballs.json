=6e7a0a&_nc_ohc=5aPTuyjRMdoQ7kNvwGJ9D54&_nc_oc=AdpQAnuv3QHcwkUpGa2pLkmPTYmZ48AQRne0OmjiAySABhgX4R39g2mijXVs9RMhaCc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0w4DcB3b4CTcEi25d0ONUOO_UN5QdYQB4yv_BuEn7kUA&oe=69F4A705"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jq5I2yLaAP4Q7kNvwESuM7u&_nc_oc=Adq_qXk_ZZFqinesnYCl741hYHEi35F33pF-n9wxKFefv9QdsA_wpqPDqBwCLr1qMyU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af08Sg98NNsnpKo3rI6qXa34Aunf6JAn9oy30WMeYY4qZA&oe=69F4B492"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wAQYUwhH8xAQ7kNvwGsii5u&_nc_oc=AdqRpKZHDbI6c2bqUHVPMJKTIiFrO4PqrI4ym6asOtwZln5L6onOYfIcAHOUwfUE0GQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0eji5J6tQoUqKSVIUOvmNDcHFSVFttqS9RseHdN7dtTg&oe=69F4B184"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4br3iA-N79YQ7kNvwEiV-tZ&_nc_oc=AdqsfbsPpdA6OwLwNIoHXDXCV1Q5-n6DgqwAreHIl9LVZLOi_TQINbqKDofuNMTrBZw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0cbsNu01wS7_mGgFA6LXw_FONt1B9DDucAz4sfa7t6qg&oe=69F49B59"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v2k-xTFeAP4Q7kNvwGQQp_Q&_nc_oc=AdpG9V3oeGLEzmkq3AwOiOAdYDho25nyOz-gxNl_QZwyo0kPkoed-YXCkaj1DL3EgDI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3NnU026HiVN09Mda5vnAg-4aM2iPT-5MHTwGsi7VLRAA&oe=69F4A282"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mTrcqV3qseIQ7kNvwGKrkIE&_nc_oc=AdqKvQBpY3w18xRpwVGCno7BSM1jFNneoymvBI2p9dqkXNjqter40IoAZ
=6e7a0a&_nc_ohc=na2jSgSXBLUQ7kNvwFOiXNy&_nc_oc=AdqRUhdeVzt8NwMNliEXQpS6HBTlheYbfV6RfIv265_BS5mwo6cDQY3b7pag9EnAjEs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1PE54LRYdQttPCIy5pqu2yzuYxME4I6Ov4lY3tHI50cA&oe=69D50305"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bc5ZzqxCbbwQ7kNvwFwWVJ3&_nc_oc=AdrYucpGOJRfyLnNJ1Azwd7-wJYhuyidF6Zuk7sooQTsY9UFrqSVdinxv5EpjE57kIo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af14TxyoH1D0rAi7FHfMhJw9r_e48a1UzRVOYYbjZcMduw&oe=69D51092"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hywliEN9Z6YQ7kNvwETK0PR&_nc_oc=AdrpUgZPV4UHVfnYvKUzd8iG8B6V3GINrrVvgQQMQxjN5qUj0R3H1NZBROmkSBJ5vtY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af08NrkZJCXf6ykqGxRkvAmDas3jjGqzB96ri6JTVpSM1Q&oe=69D50D84"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o0xB0_jIXIoQ7kNvwHIMSRL&_nc_oc=AdrFxYSvtsMc0Py7S-mO7nxjo__2vparZQyLq_g7Ucgk1is3Dm7pohwK7IWImQSBnZI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0K4LUWhM4EDVCM43PeK5R8WjrDMjqRefh8fytB-IC-jQ&oe=69D4F759"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ZYW5M-NP9kQ7kNvwE0v2It&_nc_oc=AdoXA81QJ7qNuAWc8r7w4_In7BVrcBsqtBNA16X_b_iZowW4bf_KyF702-ACKyPlZIA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0W34mSGeq1Xjs-JxjndlR_8-mqBVXcCR4PFIIYFRNOsA&oe=69D4FE82"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JZf8XJz1SvkQ7kNvwHorcmO&_nc_oc=AdrKUrAdpqzSSQCb_1iAItrq1nQdWrLjkKzU8vKknBuUkojuAriJZa8Ba
=6e7a0a&_nc_ohc=2SMOom0toR8Q7kNvwHB6x1E&_nc_oc=Adq9TI71ocRUjUMAamFQU91LO_gX_BgcjHSCUNwdeMqVRHRMrZzbxZcavrF4MR8RGaQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz2L-IQRku51s3uMRrjYpUVUl-RyfmoiuRcqhoIL1gIdg&oe=69C92585"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vxr5OLNsJaQQ7kNvwGU_C4l&_nc_oc=AdrIDG5QEKPqLCnqNo4KTVJpQ2W46jNQa8VI1SpmL6JKnvVaC-iSTfAsAi-jvXh3Ql4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzHGS3rMLXNvE8-w-qd7zkzeL7P6NkIEGtf4b4pru6-vA&oe=69C93312"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4GT_CGYfpsUQ7kNvwFhqjVZ&_nc_oc=AdrckL1PLK4Gv70hiJNXc-iEP4mT0gDDJLvVqLFFZi_2hOC7DS29JSUwKHudXEb-04A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxTf0txq8h9Eh566eAuxtjRX7UJblC4MvwrryoZTibEuQ&oe=69C93004"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GD5Qe1PZC2YQ7kNvwHfeYWM&_nc_oc=AdqkLWHea1rm2qiV8klZFcMjwd-el4-mCPK61iTZz7G9Y7t6cJOUypn38Fbm6XHjo70&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx29X4QR9lQFfg1_Mj8_7c2nBsIB-JyezSUv9d1t9cY5Q&oe=69C919D9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Ks9CgvUjRAQ7kNvwHDkAPr&_nc_oc=AdonRnxhvLYB0-4pyw4rtMEU_3j3FUX0KzVQZ5KYaKgnHZlZyvz9GZtMY4YDfa3b_DE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwjBEokWnzWVAr8vKuz3QYgZczEyPYqbPa-bnGScsEAjA&oe=69C92102"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4J4Bak0BiWkQ7kNvwHj5aLu&_nc_oc=AdouSDoOsVcWuWD8ePL9quwIm0EQrmb2ezDKcjMfzjEW9zAOmjin71HUd
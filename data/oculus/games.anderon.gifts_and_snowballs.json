=6e7a0a&_nc_ohc=FDTJbImPLVEQ7kNvwE5lQ7w&_nc_oc=AdqG9Z9tokV7Hz5zZZ81psfexnacYRK7BIv-kdWX6aeRZo0xbFQdGy-V5ig2SB97Lwc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3yW1_Igv6LYg1LroWJp2eZcAY4oP0NG5Y4AAlBLIZeHA&oe=69DE3D85"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t43DTiTYuE0Q7kNvwF6j70E&_nc_oc=Adp-qbQvjFeIB0jwlu8Q4OU42N_COR1FYIPfGImMotJRtaguBYxhwOiWxZWtDtMLhyg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3lLjKNTkfMfZFi2puwWWS3tZ4VUIj_PqFztzupQGMnkg&oe=69DE4B12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HQ343w_viEUQ7kNvwHIuXSC&_nc_oc=Adqn7IAeupxtf_gpADfNIfb3lD9gAU4xJ96bqECxeRNfOK4Pek3SxcLBphUwjxb7W40&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0iYMSiKkMS75oaqwwE-SupkQiRJbU3UFOEl0NwJXbl6A&oe=69DE4804"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JJ-hzLRjnqEQ7kNvwETVCW4&_nc_oc=AdqJcc3FwfW8YHZU8yJfTtADaMLmAuTSHn2joDm_rEdcUtJYAEaQN6APPc9x6NVvzLQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2rDKXiWGUKeerEHMDNO0rbBEK-dNvAjtVLE4fg83iXpw&oe=69DE31D9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2RHl85UqglwQ7kNvwHxbEAr&_nc_oc=AdralAqhXRTyvJg70G44R5xWv_tHw6H5rusivDH3K8obOgOiD3A1FC9LXG9sbPfj5-Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2SmbKcIy6KK6b5jifX2VWn_2gHVW4O5ceFeAfdlQMiUA&oe=69DE3902"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QdrTNqVdX_EQ7kNvwExKlXm&_nc_oc=AdqO2vH8dOHWP_ht0CiZ06Wi-6-3GFS8GaY1GSwROQnFFhsVr3E2zQELi
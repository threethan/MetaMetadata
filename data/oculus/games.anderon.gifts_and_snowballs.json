=6e7a0a&_nc_ohc=FDTJbImPLVEQ7kNvwEWkibf&_nc_oc=AdodRFlQfsdUCavNWsQxVgp83tWeoMbGs8okqbaOvwYn3xVxIWQvDUvpbsdxmYk6Zoc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af31xpTEdbLXwHqlwNfyLoaqDRP2KiGZC3Ur2S0r-NKENg&oe=69DF8F05"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t43DTiTYuE0Q7kNvwE63CAO&_nc_oc=AdrUkjW6yBrzr2p_oV-zMGbOPRftZfupyDAOS5F7nKsPJNhcOjCa93Pad7Fs_8TgFTA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0HW4cNr6WOg_UCnrBHWRdnXMcMiD7KGzmvIzg57gVmjQ&oe=69DF9C92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HQ343w_viEUQ7kNvwEEiVnQ&_nc_oc=AdoMipc9F2NfHcHjh5gLpOWKQluPP1WCDsEOTHa-LJc6-qA1FwES4KM17WISfo1yu9A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3MGptGCP7X60Eo3Y856SClXFi5oj_G7vFIzWabfTZufw&oe=69DF9984"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JqUnvOePWTwQ7kNvwF8qK1M&_nc_oc=Adq36rzF_-4gb-zirrU0yvyeiHr-7ZugXAIAVbBTVWznplii4361qZiBaVuxaIsj20w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1mhDOAy-_5mA3c2dpoc5RT6PkI1x8AAnlzUeW3Z1DFnw&oe=69DF8359"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2RHl85UqglwQ7kNvwH2NAmI&_nc_oc=AdqZjno0BeHcMGMHiFv06XwzLRSK-BqUp0qsn2foMwwClk1gWdC58Cce6xQiktN-7jM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2UotVjM93gsvPfV-eUzmyFTqXqGWGt9RjnuXghQFR-1Q&oe=69DF8A82"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QdrTNqVdX_EQ7kNvwGGbJx5&_nc_oc=AdoN8VxMS0433Dt0giw--LgEV_G9jAl6Ub651CLUocHj6tk79BeZiCcTF
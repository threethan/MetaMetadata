=6e7a0a&_nc_ohc=jwpLwgj7SLMQ7kNvwHZQFca&_nc_oc=AdqKtnS7_jo0a-VVosPSlr_qpJhC7DLcWbCbshsAL1RK0lEDO4bTKX559nBdjHYLudE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4yEJ6uy0RKLNotZtxo6pAZcc_pdH0DEESun5D_8-Pokw&oe=69FDE185"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pKfQ3NNe9jQQ7kNvwEiR7-t&_nc_oc=AdrRF_gsMPJkWeGiDKAmuwTV6rrBEr7AXUdo1EeiE8hADrjrcJgjE_WAgabvjyxkgPc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7m7rp8c6eDuBvNKh1S-75lQiyAyz7EUyw5ibAJn-1rJQ&oe=69FDEF12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5IL6MLHBavQQ7kNvwFkrMNR&_nc_oc=Adplypir-pEUE1ZxNTyC8KEQ8grFHStpnRVmRu_j6lA_cIM6859KgCiwNCH4oDjsU58&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6K2LHF92WEFM7SnhZYjZBOXbuSWR-ZG7yOEW-eoREQ3w&oe=69FDEC04"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GWxt_YnFP6gQ7kNvwEPNk6d&_nc_oc=Adr61CnHOjbmrfkgzQzM84DgLHWMmQq6aLJgp78tGJAwQv29tGrMYkb57H01TkGUyW8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4XQVU9xtNOuhHl6VyE7AQjJzcDZ3J3HQtYfqyVIHCTcw&oe=69FDD5D9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5xvgAcLjV5oQ7kNvwGLtXuG&_nc_oc=Adpo15WWYh-f4gIM8wiaI6WZMUfL-2sYIJRR2LJxYmqYf1WJcdTY-BahR60KxsANVZo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7vAvVHgp2XRVig64DX7vpys6UEjCGOYhFuvKkKIfwisA&oe=69FDDD02"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mirpe3agzX0Q7kNvwE5iZCK&_nc_oc=AdrVHYFFn8Q1mVx6kGNGDwLCfjFbzboEh2jFrNZPexKCUZ0XvdAiO2SjB
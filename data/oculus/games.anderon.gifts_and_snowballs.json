=6e7a0a&_nc_ohc=DS2BwO8xm-wQ7kNvwHNl9sv&_nc_oc=AdpKOgwnpYr9iNVYUin-D7Q3kydpEUrLd1eMi--Ge_jAiHHOvTU5fIAEnhylP6UqfdY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2knnDAaxabBYCIqvpOhOZ7JII6PxLOwJQYhPFFcVzibA&oe=69E8C985"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gu9qkrjJyrQQ7kNvwGCvU2r&_nc_oc=Adq3Q1dkLVtk62Mbp0Lj46cNWmY9nyp-hcNPVG33NP9ZWVQjJYfmIGzYOmhJ3Tr4OK4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3GKgo7IcY7kN97qItD7C24GtCoRkK_-MBdc9S4qyyYkg&oe=69E8D712"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cu9zi64_jnoQ7kNvwFYol6M&_nc_oc=AdqZJN3gd03OAugW-PgBfxNbIG_Cc2VIRDmTV_5PmfR1qrMdOQS4VMRAwVSRzSTDA-A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1U83VoAuitkf_rW7M6jhL-OlJKQfospUep-Yb2-kJ5Jw&oe=69E8D404"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O1X5J-IT14cQ7kNvwGBPWwN&_nc_oc=AdqrGo5uCEQX3Ptpi8X623e18YVhFIce1FYTMSaH7BTYT9PZPncEkAiKDS7nBwokbsw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af10Gw6FXlMrVj5z5RBqc0V5UM-iuFdd2g6Enc7nt7M4EA&oe=69E8BDD9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_vG-uinOeCQQ7kNvwGZNh_d&_nc_oc=Ado9fcy-Ii0B62GE3oW-lylIKgQUTjD3Me7blgtcdUtMrvShNWS678Gi4GaHZImnqIU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2MPJouiRQPcT45kSW_jd3VdtzFu_EZkjotLzrVQWCF3g&oe=69E8C502"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0-FbwvnTa1MQ7kNvwGkAtdk&_nc_oc=AdodaW-VW9f0w6ThoP53aOH8Fjp7ssvhSL-GdY_o_c4q1U00L0Np49YO8
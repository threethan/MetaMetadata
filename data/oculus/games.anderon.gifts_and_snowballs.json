=6e7a0a&_nc_ohc=c9vHu2JofbYQ7kNvwHq3tVe&_nc_oc=AdoD2vtFFkPq73ai7aklQHTiaq1IhLR2uc0yKRX-txmki91keGgwQsIk7KxrkkU8lts&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5kCbiZoe6zLZ2y_Ny-wr80zrOiY-gqdThAiQyNNf_kDA&oe=6A183F85"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EQs8fHQqt5IQ7kNvwHqFlQ3&_nc_oc=AdrI45E7l53-t7LETt4vgE0M_IDzl76Xh5OLxFJN3WkyzXNAOEoK8qspImx4hKStIqs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7pr3ugAzqoDTeQ5EAZornvG7DSZJMa3vWyHzVAs7rVtw&oe=6A184D12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TJXmiET-T-MQ7kNvwEzZgIi&_nc_oc=AdqnCZtfshewoN04xtPjKMe5-h6pYOLdw1hmOd0XrqTAEtsxO7FH775rc3Bf2aWGx2A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7knjWp1CEIIAKpzDGQpa_vEZYjSnirUQocgeuHEt8yAA&oe=6A184A04"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gywwPC8mLE4Q7kNvwH04kjR&_nc_oc=AdrzJx6jf9r34uwm-Dw4u1O_I823HivCg0tUVB0-kryn6t9a6mAwhvDjHODvfDynQeI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ZJZNhNHKSIzy6XmbQgOTdEtCv8kDK2cBn16fJ7BkbVg&oe=6A1833D9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A5S7BQrWLhMQ7kNvwEq-2ip&_nc_oc=Adr2jQd0Va8QSqDB0344aAQ8Otp9lKAt3XYBsBBYT-l2KLXUbwu8_DL_QCSUmQuMfvg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79P_z4jwErAdmcBQWcKcXrpCl5jCG1q79JVTVSTAPssw&oe=6A183B02"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JLgHqnz61JgQ7kNvwH7NAHw&_nc_oc=AdqVWfNCn0qu3qFo1LT8TDCKSpTfRXN9Htp6k7-vh0F4xW8Bp6uUKXzL4
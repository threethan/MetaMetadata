=6e7a0a&_nc_ohc=rtPGkPprmRgQ7kNvwFE-1xK&_nc_oc=AdoF9-VctobbydLJ4sxqZsdERaLg_Qukk3fVK_zhWpHT-ue5rhnesANpYjgEBjAgqbs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNY39-fo-eShiwv0tdlszhzCuuy-SUNw_5YndMpdlJsg&oe=6AEE0AC5"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vT3u_e6XoMQQ7kNvwHC-P5q&_nc_oc=AdowiTx-jhWiMnT9zHqCPV_NcLz0somZopDsyO6LPoVSi4Jz047kBkIyMqDPZYGjFn0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2DgSMw9bqzP17HSz22GxbWZX7ZlrIRxDrzitNz2FsHg&oe=6AEDE012"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NgVJ7dTcf_EQ7kNvwGtSK4H&_nc_oc=AdqTfNspgaTEYhqDIPrcehGFNcb550BGRa8dB52zhTJA-RhdtvxwaqLXzXOOX2T4GMw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTd7wZfzOXTo7UPacxmRNzcVepUvJdRdfREzqYVWogMxg&oe=6AEDDD04"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yNrR4jiP80wQ7kNvwFy23eC&_nc_oc=Adrj48nrcoaamfDW2diVs9QV6bjlAWp3VXZvWV5lVk49rukxWzw99bMBztqOhVKrxAA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSF1mK1aYYnaZtibKlkD_1FnE2ypXYazy-ISUVP4PKOFQ&oe=6AEDFF19"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Z8MJkvBQRIQ7kNvwHIf4OP&_nc_oc=Adoiw7Krjyr9KDJV1pYFa4TiIkCceZ0Ecn1iqwqAIzZhb4Lb4lJ4e9WA3tFmFxaXpQA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkiqO_ZA_vWQaY1_fV5-IyxwZrO0QHANQNe6Xfmshn4Q&oe=6AEE0642"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fQWJl8d-NfMQ7kNvwEUul7t&_nc_oc=AdpzGgMMuFu7bS27N1xnVcTjMyTH-PYkBMSFea9sK75WC8kvntdWpd8dN
=6e7a0a&_nc_ohc=6sIuP4DxSREQ7kNvwFrIrmL&_nc_oc=Adp7jVwB_U2gg7S3I87XsAqsMtkBubv6FBOyHQ7OIk28SF36SFXTwnozVkSn84ED5lI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHaarhrTaoNcNQPNk3VrNJ-N5lED3bvC6WHrA6cfuqioQ&oe=6A95B645"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yEuWNU65OMIQ7kNvwHWbiC6&_nc_oc=AdpMBr9pu4OPY9PDSq-ICreMmg-q2cpfTPctrZOvmSIndK2kgG82MsN42hb27G0XaHs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9gyTSEXFpzGk8SJc9A2jrBSemoavMcmPQ7zBlSGQC_g&oe=6A95C3D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=02lTXSedYSoQ7kNvwFtuVWC&_nc_oc=Adql2iEyQRfB7tmsetFv17RsMttGk5IonJhdtPPjLcgCiX1IEE3BRB2zBWI7cRPNDCQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG1qndLwvjcwqFSLx13jvUpsT3AADcW_9AsvhV50YiUIA&oe=6A95C0C4"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qEUJlbuOCAAQ7kNvwEDa4LJ&_nc_oc=AdrN_5Qtywe74pNNtxDrEBjQso9-D6M4M9eZ9yNmP8cn7fewJows6EoEK4A1ijS3FsQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQETFvVF5HwhDgEMSJf3WSH21IE8siyQC5o_5_Z7rQr93Q&oe=6A95E2D9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sL1QjpUHOk8Q7kNvwGO5AQg&_nc_oc=AdoyIEFDMbVUeMYx9LCTsmRVkb0U0b8wlwjIkqYiVSfT1GdjPfe8_1foIsq28UkbMus&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHIxQ0Ge_uBvD_w7PQL57cF_h9v8spN9IxB8vzX_WxeTA&oe=6A95B1C2"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cBZ2W3UFHZ0Q7kNvwF1f4Ar&_nc_oc=Adp_EJQLg4xZeXmZbTGf-cQz06wGjOrZcyRi6nPr9b3zOhJ88VB08romU
=6e7a0a&_nc_ohc=xqklZizneRgQ7kNvwGtqNtK&_nc_oc=Adr2ZsI-QRlokIJeeBve9oz_8hiwV3OJIHvzz2b3p26fg7rTEkTHtRFSPWdC5IxqA08&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIjkEGwl5AM-MtEXP5xSQ9et9QrY4ifMqMc5THWBx_YQ&oe=6AF4A245"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NzwPqb3HHLcQ7kNvwGHv3ps&_nc_oc=Adr3A3gai5OS4tdfLmin5W_EWnvglPNjqK4smbF-9NnOaonBsmDB8YTA2-8udqIeW6A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHBEeFkYC9XY_qPm4R4TKdso7jEeKZl10b3Hlj8Oc_QA&oe=6AF47792"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_bpJ2p0C5e8Q7kNvwHREPoh&_nc_oc=Adr5_IrEetOafGXU2uxlqwzHSdZcWrdtkmykDoYnI7erb2Mk4kEFXOlIfPw21WYLgwo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9v8k8DZE4iwBvBHpvrUW_28B7J6JA8Z-cmuVTpmZizg&oe=6AF47484"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FQZ4Mk4OkwAQ7kNvwHIL5vi&_nc_oc=AdqAKhhLc_jeTN3Fk0iDLGFUUvxP6bg7N5gi0gpt4sxo3MwAYUACltQLS_lach0xiZI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvykCEFK66L3yhn3pQJae697nPisr3QWO8-n5baw9FJw&oe=6AF49699"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gp8sKYWnRCYQ7kNvwFbinDN&_nc_oc=AdoUjZNY3APruDIVKySnqfOuS2InoAUbj3ol3JM8cjMahybkXTlBi2DoXGEBSxYcatY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAajASfHTBVA5Bd47S9dQ-2aSvonHeIIWJg5zXoMIJ6Q&oe=6AF49DC2"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9TpRPZx_YMMQ7kNvwEMjFom&_nc_oc=AdrTSkPhXi5gqzooGt3Ccxy5tmCRU83VYbujVeFF4wKhKlAd-OeRsL9I1
=6e7a0a&_nc_ohc=nLrCzaNXw9wQ7kNvwG14B3l&_nc_oc=Adr0ft7yrXgfZBJbHiAJjOfYuMXtbrDe2k2NgTumigWWdiqB4Z94WkT429pAHAnUKpQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNRK-9TKen-EWwoRCPsKxbSpjwL35lXydFiGFBtZv9DoA&oe=6ADF5205"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fwgBe_ARh9gQ7kNvwGs9bbZ&_nc_oc=AdphUGJGJsl0a2Gl6o3ta5Ck_1fnGG04ihTYmLiz9NG-d0XBti5MBUomvH7fYEjd6PE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMj7D2r2LowyIDLXEWJRBcQ_CYKCJ90AfNVJ2z3oPwMzw&oe=6ADF5F92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R2gj5YnELTMQ7kNvwE5e0wC&_nc_oc=AdrkaVcAPvDNPebtSoXsaTbtOCOHDq4f0lpU343k9scr71PLqG3VIlR5GUTKqPsyIzM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNGNhUF2UefhjmRAL1LHzneP_sKRcm0QMARPHEHW4pprw&oe=6ADF5C84"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JfB7qn24Zx0Q7kNvwHP-M2l&_nc_oc=AdrTB8C0CnU5tncJck8LQETcxUXF6Nm6ft48d0SAjERGWRLAhiNsNT7oNzrQCus57jw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNPxNWXKQ-0b0HUY_8_LAD3X7wO_ofiJ_IwGEuDesECtw&oe=6ADF4659"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=va33UG7Kn8AQ7kNvwHVOxqO&_nc_oc=AdrQnE2P786-b8Ewbr_9UvNqAfoDmnq7TrOyeAkbdAtfQNG8lUPXg3Di38bvL5jf8IY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPbEmUwMGZl_ki1UTfHcyB7cjUT7pXY_2xaaAp6R71ZNQ&oe=6ADF4D82"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9_-L2bIOGA8Q7kNvwFFGHbE&_nc_oc=Adpwx89-s5pzlguVNWC9TN6QP9GJK5VqHsh0x0ni8qPCeFDfJ_Icy0xae
=6e7a0a&_nc_ohc=qQfkrXwIK20Q7kNvwFfzqdG&_nc_oc=AdojACf_C_xnuSOxjHlbhrsX0Vm4m8J6UJt9p37Ellx6U5S_Bt1K0Snq3niRP8chmMg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1V1v5O-xh15DKu2s38YRysuMxR-o_dNaAxwTDojrNHQA&oe=69D65485"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bc5ZzqxCbbwQ7kNvwFZiSKe&_nc_oc=AdpHzHDMyoNaEa7sAY8PswzjjmY84IIsfQUDREL4LKz1_DskfmeNzxU7vl680JxORhk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Rv1kbNhhDNPqTh8L3qSIiOXSnyjfXmMySTAxbCWudLw&oe=69D66212"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hywliEN9Z6YQ7kNvwGVE4CQ&_nc_oc=Ado4fGQ886fBnuor8idpEdTBihCQ__Giw4cAfxCN8jSY_YTGVFJ6lRB8A6eU08-FsK4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1-hFZryRr7hU7zymrTYSvLRC5WHNlsnhqv5V2tArrkvw&oe=69D65F04"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o0xB0_jIXIoQ7kNvwGsf9Zn&_nc_oc=AdpuZ8-pZsj02MOP8Yu4ILEWfCwagIxOozvQy5lWLcckxj8vbMDW-9C33eb_cfofHDQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af26YOy80QPqmI9_VLDZABwOz9kz_Bna1k_rS9UxKbU4yg&oe=69D648D9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3delMX0sfYAQ7kNvwEiVh1d&_nc_oc=AdpDzCdMDDxR6KT-SNXA66I_bGrZRAocYZ5ehB9fGRQZ29RzCrVvo4e6rPG0GACpHuU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af068W_SClaXqp6LIFeA_ERtrRW4vmaErEwBixOsafBm1Q&oe=69D65002"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JZf8XJz1SvkQ7kNvwEVh9_L&_nc_oc=AdoIpCqVlk83TdzCQ-MBZhLO4VHJaeECD1PBO623sbDPs9teeP-c5NqZR
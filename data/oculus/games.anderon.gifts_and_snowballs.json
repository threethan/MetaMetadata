=6e7a0a&_nc_ohc=1dGntpXRSrQQ7kNvwH1Uvhp&_nc_oc=AdoDsL0DVAAsNZ-EsKat9fkkWPzbGSL6rAmaI2_uKU7BlIZ1_LLaLItPiOuBv-NhyRM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKuTgT1FGOgZtLyyVBLvLxDtni7J_ctGUPBhW33TUd3Dw&oe=6A9AC405"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rQfSjjofFQAQ7kNvwHsJ_e7&_nc_oc=AdrXw1zWbvSmh64gkBcBMXX27HpKSMUtnSd0rwipappxgnprO0X7L6GW14sytRalYKg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-uncacCBhT3y8EGStckrjh_p0XX0GqvFHrCpwz8oOLw&oe=6A9AD192"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ot-gT-LNNEcQ7kNvwFkOA1n&_nc_oc=Adp6ETIRbHdvUrQ-iUZhE76wNC-OkP4UGHTPxEJcVsYgFv9p6ZT6tTHcvvp1sovhPRU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJheuviJzGEIy-bB4Vw-2AwcigB3gp6Td4gBLT6zVpx0A&oe=6A9ACE84"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=piC0YsvT_kEQ7kNvwFryDeP&_nc_oc=AdozT40RZH3WHZxTsVaJjziVNnJzwvmuin6YgQpFMbEnCLAu_3zj1g8hffNW1ruilxM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL48HZA-75aAZ98uoJ_0_es4RtoZwD9be-S0e-bJqOe2w&oe=6A9AF099"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dG9Yp7Z0SO4Q7kNvwGoheFQ&_nc_oc=Adrj4kBcL52x3ep7-We-lcGDA7cOfzNxsVIGy-0PNXS5LKrBnvjFz5SFpFX3wLHF__U&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFyAYbEiA8xsD4Xdu19GFs9R-IpTOr_mQ-vA-3xHyemA&oe=6A9ABF82"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XB_HWhyPcjYQ7kNvwFp9h9r&_nc_oc=AdrwLVZzxaRuYTzdMKXTvAfk2bvMo8NbcGPie04z3y2nRUsy46KESrUxJ
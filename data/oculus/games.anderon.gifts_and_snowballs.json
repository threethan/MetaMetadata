=6e7a0a&_nc_ohc=VtZN6ZZKs8oQ7kNvwGgBkUp&_nc_oc=AdqGG74YVDIrlssl2_DOeXPNCf7-HTpKazMBP0MvN89K_8uG2EhvRtMqMiNLoZxLTI4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFIPKvUXdDFihvtqGIH67cUqlLxJ9F-8TzmBjoyR99QnQ&oe=6A92DB05"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TT4R9no7FJEQ7kNvwGo2tax&_nc_oc=AdrQDdMpz8AWcQZHi4g4tf0H6tBgbhEtNnLG4qsZYKnkYGwt6aOgAUfxkH4HflvuX4A&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6ViB-Nta9f2RfQsR_UTiBKs_ftcHViuxjKF5Dv5vEwQ&oe=6A92B052"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=02lTXSedYSoQ7kNvwG4X2FT&_nc_oc=AdoL-P5DmlWKqGApvp_sDaz1CEb7SIqkuztH13p7g5o4eFH_Ez2dGRIbf4YwvKQQk30&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQECs4J57lsNJMacMwS3FWrDnEhwziZKkXZXupnR7qTbIw&oe=6A92AD44"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1FmqEqW3x5MQ7kNvwE_6zPK&_nc_oc=AdoGCQs26GaKw_QAuUgf6NDXQxnfNWJoWe42Hys-YY5Dyvo62Hu12jFxYqiosv33krY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFRYN6STOSf_kA01z85iEAhYHPwmvuvptY-Q8aNrSa-g&oe=6A92CF59"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PBIVaA41Qk4Q7kNvwF3d8Ek&_nc_oc=AdqfiicZP7B9ns372mlE00_kb3yZQgqXecmLTIj8xm_qz1ScODCXWxP54GAzVu9NgdE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHTHczJulxLsxxFCsLIGsrHIu8_NXERPv-TaQL2v1uzQQ&oe=6A92D682"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xkk7X6TGxHQQ7kNvwEon0hI&_nc_oc=AdpFNxBfZTnRTaBc9sLbcacLIP34N5edY9uCXFtHDK2XgriEMGmjoYrss
=6e7a0a&_nc_ohc=m6WsR7QjxHoQ7kNvwErQXTS&_nc_oc=AdoogE2lYnTmZke6Yra5mrFdVI545_9zvRPNvjJc_WmrOfx49hRwwb7Az0TNX1H_WUU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_07ibXGL_CF2LTbuU-XdfAg3jI-1sOlVT1oKiVkntu3Q&oe=6A3BD805"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rTkjjScyHJMQ7kNvwGCdpeF&_nc_oc=AdqgUp6zmd2qdHpNalY8tkfyOY1mbctxRPGHytjyaZGivzr7R7_lIeQVJiq4XNhUG_o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8N8V7onI782exP3GmDw8aS2FizgFzaoeIRy8QxSDBBMw&oe=6A3BE592"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CyndV_3bbOUQ7kNvwGlkiWy&_nc_oc=AdoC3QloLBzZeUkHQYwvq0RHbvP9CDTuG_yJ3ZCUcYAqs_0ouCAnZyp9bT8QoduWbkI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8js8cIsTyHKErUk7-Dl53fUjMk2M_85R1iYxpvvTB7mg&oe=6A3BE284"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C9xOJC3JyHMQ7kNvwEqpikk&_nc_oc=Adqe2QppaLv2oNfojD0CfY1EVOTEWU-Kh4B3IopvN38wvsZVfPik0iYQy_eGPkdSA7U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8LNN7hIcl47FyMa17NJ_dLdOTOsslPAR5HAz6HI4HBpg&oe=6A3BCC59"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=asWMpoaNTHEQ7kNvwF3jFZQ&_nc_oc=Adoy8juK3rbnDYXQUNmyssknvPlR7t4Kvw8jkcOq1BVzwqwTBzROoU6xj5b1VttlHtg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-WlPPVK_D0BU__aejKdmtPeCiXcUz2CdBRp5ZXdhneaA&oe=6A3BD382"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AWIuWUljyd4Q7kNvwFfcuzT&_nc_oc=AdqJUMppoYh6txJd6i4PgmDQhkuiG5qdEUOlL4mLFl96A2__GRrddDgNc
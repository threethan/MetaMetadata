-iad3-2.oculuscdn.com/v/t64.5771-25/75286676_577533401544348_4203344657555901211_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gsFtRXNqGuYQ7kNvwGYGAK3&_nc_oc=Adn87b0ZbXznM4UXpNLiv-F193qfjLSgnwVB5jyGkMJhJiPsjNtM9EIeWIKTSquz2iQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyHxy1moI2EJLrFz8lFIV-0BhNzsTla64mFk9hthhzD0g&oe=69BFF5A8"}]}, "id": "2073760636370964", "locale": "en_US", "screenshots": [{"file_name": "screenv2_02.png", "id": "993244952825890", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974853_993244956159223_3665934591366094743_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6VtG9htKHrMQ7kNvwHNW63O&_nc_oc=AdnjDeqp64how6-DMBqw2VjktSQDc9tu63sDll_9m8zRPZauFhiTsoRjU-1nU8ce7QA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxsZIRHQdC4W7Xr1WvFlqrMGlh-N7YL4nd6LfqapOb3kw&oe=69BFDF8B"}, {"file_name": "screenv2_01.png", "id": "517646341325841", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572947_517646347992507_8365861269156842802_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EI75B8TclmwQ7kNvwH_P6gh&_nc_oc=Adlfyrj37Dx5evDr1mgSH8fF0Xx_ZImwvJiK_lkoU2qX7wm5VQaLaLW8AhFwc4KAOTo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwMxa_3FuyU_X4CrhACuFSpHnJRZrZkizxk85T-fKltxw&oe=69BFD8E3"}, {"file_name": "bagarre selectable01.png", "id": "987094796807741", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391822_987094800141074_5341301578934495068_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=99QA98T_7JEQ7kNvwFejF46&_nc_oc=AdkbnJ4eCSsrVV7RiAzl1-Au4WjZiaQm7a7x3nhqRYJ1lKX1sFQMz2Q2PAH85kdmTzo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwWS9dXR2SHWsCC04026e8ovchik3sy79v6_5cMi7lr7w&oe=69BFD7CC"}, {"file_name": "pinched warrior03.png", "id": "2233739983674845", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391837_2233739987008178_5682748129040869737_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z5ZlXi-NWkoQ7kNvwG8DWMe&_nc_oc=Adl1HP1gpCvqq_ksfIVUmCUPeWD6BYxlQHxtri-53GDmzjq-rSJtPYLYySge9TvTKno&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzW5faCKXTTkoAw06ADQtUXdsnNGGrf8Sm00Hj1ZZswXw&oe=69BFEB05"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=upn3MXREkpkQ7kNvwHstGu8&_nc_oc=AdkFaq7BKjEf5n0ZhxQ2JSqA6Ypm1e1QzSl1GbYHlBpXAZKm3bjDLLdF1AyG4UAAV1I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzKvwTEivjx4lpU0L4frIH5FpVX_QVh5JR4RcnBBDKB_w&oe=69BFF892"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Vo3jqHfmOUQ7kNvwEhZb83&_nc_oc=AdmgZGdrn4kYOh-kgz5Q2hYAnf89X6lNWVaOKvNRf6da1p02fFDL7hn5_LRxtV3GLjc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afy4VQirACYoOHS-dwEl0EQM1kYNYeYflFd_SYGvnekQtw&oe=69BFF584"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jp9A1_b51qAQ7kNvwGg8UXH&_nc_oc=AdkWMnX9HnbyzD1sfmytaViHExC9FlBdPy6HMfyE7Na7sr6uiOjm_qXDUB6eQNqzFN0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzoSIuO8_O1_MZpsLRTxcM_P7K6Gbp1P2rtY0vTi3Y0xQ&oe=69BFDF59"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r8wehxTfSYMQ7kNvwG8cIA4&_nc_oc=Adlyb_oXw174Pj-dZCKyQZ0gnU_mO4G2HRAmPUNS7sqI8BdyhZGFsLVBObpot76Bk60&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz67ADkymqBppKUUFX02nxAxtO85WgTK7LXUCsTgRLmPQ&oe=69BFE682"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VJWXyfhMNBYQ7kNvwFIYjIZ&_nc_oc=Adn-OlQbv5k2TLKK4qGLDHqHRKDKWrPkSKX0kzfRX7jAOtARHqYZyyQ-EQIB_hsBlUo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwkw-Lstmh7oU4W
ztThxuKguy8nSTM5eYqXn_WGUNCkHHPbSdZfpBBWw_b69M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxJ2czVhM5mqWzQ0wOGdJtrhRnf-TuXBYSNsYhznch0GQ&oe=69B55F05"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QaAu7auWCpwQ7kNvwFk03eM&_nc_oc=AdlsHkJn0VWHkXiVCLNuwHR8eVHBXgxZeUq0fDUaxJASymzi1B7K1r66Pd6NxBDlqiY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfywEVtiY_cfaxi7x8L5yinDxLLd-zaMOqgcirJqd4717A&oe=69B56C92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WiJ3kNz9AnwQ7kNvwFEa2o9&_nc_oc=AdlM2MJfkFH-tY0oylVcAY0toH4aU1WAtMrySlLeUv6K5wFWbSr6D-Llrlvdzl-DLNE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyxE-fOnHn3QfMQAscjVMl3da-zcUCcWKwJC71xUbgBbA&oe=69B56984"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2QBShXm5o1QQ7kNvwFWgIE4&_nc_oc=AdmmsZD6BWc-alp7rNvCP5o_ifKsnLh6U3fCkp9YHftOJjtWb10MEwp23WWmiCzhKTM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxYxS1G_jXFWcnn8-YxTPgTelibaFoxotqGFYuAVkvdRg&oe=69B55359"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0YAMA2ugSH8Q7kNvwF-lwFT&_nc_oc=AdmL6nLOUmCbnjWcgMfY4usStIKyTXIdLhVh_tpGHFY646rx36Sy5_TytzHqDH98yXQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy1cnImDTWsb5bztxH0cY6NjT-dXn8gZskFDZWxoKWQXw&oe=69B55A82"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tz5_jVgxEJwQ7kNvwEf7C3m&_nc_oc=AdmwQKYOEahHbUw-rMQsAitduhxxeCpHCLqElTTnOkIBpFPZ-4Bm6O7JEEj4lmGlrOU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyEoqIKnxEUpdlY
=6e7a0a&_nc_ohc=63ahgwnp8LwQ7kNvwH_YYiC&_nc_oc=AdpTgDOWJQiGh_ZKOqjoHtM_5eO44XwvnrNJDc44lFqSx5dZyerXqT6v_uH7X-zd2Vo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Q7wkZm3yZwjCfcO68A6PDI1WlRFRPIMGWvlURrp5ijg&oe=6A199105"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EQs8fHQqt5IQ7kNvwHB8PH_&_nc_oc=Adq4oX_BVkkmvFO9Qk4wVIjekzBK5WSTF69pYUnpcZjJhpnu75g3DSXurXPEuZPErF8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WogTNaXn3EvtfojAibtHYXtJ3O_jGmtOogn-Ui-eryg&oe=6A199E92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TJXmiET-T-MQ7kNvwEtVcih&_nc_oc=AdrM9S8yOxvoMTAAyPg_iGl-AiZR_9Ramo14hf9t8miLGnxzLpogdmTh7KWf8Rqu258&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af46idKCoh1uBLiwPx-R9_eAmOORsGax1unsRRzni9iuhQ&oe=6A199B84"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gywwPC8mLE4Q7kNvwEZDayd&_nc_oc=AdpQ74MTtQzu1p-mClz3lHz6_y0BoAoPc6Wo62F7L7ml7wkJBHF-l5Sez541yhuBFqQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7l7-TwOOFnMbUKqwdUXGTpG5Q0Fm1FRAqvRWCcoLtOnw&oe=6A198559"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3H6Ibn-M6REQ7kNvwG3xEw5&_nc_oc=AdoqSikyrXO1WXtDVuKtaA9dWA_Nrk91G3vP8L3ulHo7XcW-UK2qlxIL4XY_YVMlG5s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4F6MgflUWpby_GNktHPZpsCm942NmS_ndkaG-9sRDdXA&oe=6A198C82"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JLgHqnz61JgQ7kNvwHZpGBz&_nc_oc=AdrNcBQh1PCqjYR71SY3YMrCWptQEXVJaXIt14UklKtcPczB1x6bd6hAp
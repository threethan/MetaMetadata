8&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I_1IIyo8nuYQ7kNvwEXFHuq&_nc_oc=AdqkofbrJ5IznW-WMbqdE44jHBH7jQZxgNP4cAZSezzIIi5gQ89YZI04hK4E07jMwv4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_EU4PSNJCqbfGL2kkHpkc-aP1p5hiRvrxbuefLAs__CA&oe=6A466405"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iqd6HKRNiPQQ7kNvwE8MLVs&_nc_oc=AdrdqmT-GgUhPAkEHmr2BbcWon4PAMhp7IBavRXAZIfS1sYv0TPJb9meqG4My3P07DE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8J-iBD9UYGJCD0zsOhLAfvFVQSV91GaJXTCpY7ldDYyA&oe=6A467192"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8889ieNHbKkQ7kNvwGYur-f&_nc_oc=Adr6Ee5ucP5022Cm76lfeHJYzVg6_jGPAG0yf9Su94YxIMcMo5Onhnm5OifdHjl3fHo&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88amxYl0LS8vjJ8IwM9wAX1_3rPu61VbFEW2qDaeMCow&oe=6A466E84"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LC-7Iqwu68IQ7kNvwGhYMzM&_nc_oc=Adrof3XxHetQtsAr31nHhz30Z2k-_bCTvUOYmHA_sS0eKoqF8-I6sCOagEAW_PviLms&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Nx_M2uCbEhPa0DuK7fWcWrYrPbvlZH-bv7wNPlEMCmQ&oe=6A465859"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xJCSg_dAlYAQ7kNvwEMGj-3&_nc_oc=AdoMX7gXArPYif4Ng0l5uexc0x2ugEBe-Ft86q28T92WVyseJ2pgsi3xZNonIEmz5KU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9RC1Rx6QrUZJxf6hjZ8U1XUB4QsNdyA9cGS0uxgmC3bg&oe=6A465F82"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=siL7J4t4jgAQ7kNvwEQoETP&_nc_oc=AdqsFcLr3EPJFioBtSlBMKw81IFZq_pnw0
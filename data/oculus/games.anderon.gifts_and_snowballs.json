=6e7a0a&_nc_ohc=-JYdTntUGWQQ7kNvwE7Ue_G&_nc_oc=AdqHijiPCy5lu1l_jpSeMPaZCG50mXIoUPUbMcoMR_h9_P_MvwJZlSfpzQzzG9fg0-0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8W70p33J9Ccay1QEgad0WMYQdCYqDXHl_afiSPkOAkpw&oe=6A2D5785"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wGcViX9a_WYQ7kNvwEGCrbp&_nc_oc=AdrCzJtsAiCPnCRxhwDAJNYzWC2A13PgTyeZYtXXcLo60BgjRogy69puXV1mApZI91U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2Hbk4UcLwE4k8jHyoEcSQitvgBGDDCD-_hnxjQ71MEg&oe=6A2D6512"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=---GnwHyaS0Q7kNvwEolYFY&_nc_oc=AdozYHMJmQGJXLzVjkuCXlC7eyorbxBEKXHjOw_hFiAYsCn21uEWnQX9oEpiEBgSXkQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6MAwFOGTuN9feQ2HRxUlSEjJb9-XnzgH4uKWG8EOsEQ&oe=6A2D6204"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oKSPFUQj4ecQ7kNvwFv3cOC&_nc_oc=AdrlxO-3z2SHBwakhi7UpDYLZygpbvipm9VA039KuWhTZj6sTw8O7JFHN9I_f0UKYSI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-dLsgk5t7kdb0Fjs9mQoZvIZ8Ww86wfq-0Q6D1KklxzA&oe=6A2D4BD9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f1Y3aTgS4rIQ7kNvwE_YU3D&_nc_oc=AdpydLJolc2jVoOh7UhF2MLljjaSC9TgsjpREmQ_PkDV3bp7KbI8u06olsVMebsC-9s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8TfBuqlmSGub4lkVZDP_EkdADBIX6pCNd9UBtANNXeJQ&oe=6A2D5302"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y_L34ByqOzsQ7kNvwGwAC3x&_nc_oc=Adp2Xcyf0FfxUbV6_UhhmAJPsXv0_bzG8qKeFpRjWVZ8QLVv-44VwMqNm
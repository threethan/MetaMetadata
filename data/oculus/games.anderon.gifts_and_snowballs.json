=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wgRD0kYqw3IQ7kNvwHbHh5N&_nc_oc=AdrOGqgtwpz_vdtX_qOPWDxcj3ojhoDYVtMRvUM-fMNnBcsnPz9WHWp-9VBcQYFufE0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZtVR2RXw1eHEkWQqRFNl-KUGlPNnfxi2CR9sLdv4B2Q&oe=6A8EE685"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gogbfZvhaMgQ7kNvwHjF9nH&_nc_oc=AdrBJ_1_0z0tCjf5FtPoU4v0M-SrOKV4VcmkOIEwakwRexlkSayeK4Dt_cgenaHyA2U&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6_ExRLit1F9-EkeAbTzLB5XnlS13GzjWHh3dWZqwyJg&oe=6A8EF412"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vqQPR7jc6ugQ7kNvwHseTN9&_nc_oc=AdqU4IUJvP4uGv9Irvq6EXCTKje_pFErfv-XlLw0Y5pJT2D6Ue2BgwgqYd8SV-oZDIs&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGdkKZUJgtYyJO4i3QTqF7bQ8UGaU5gM6u48Gk82LLK7g&oe=6A8EF104"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kTrSVLdfyKQQ7kNvwGG8cYD&_nc_oc=AdpgF2VnYzMeICfV_l3Ph7smYtZ_tLbwS_-jEUS7uRLzIm-AdUB2I18GjSKMzmvWmJQ&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmmzUby9HAAPQsCNUNNopbn0jRVgH_XH3ezDqj3jnm-A&oe=6A8EDAD9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OA0TlF9w-aQQ7kNvwG9z94n&_nc_oc=Adr1UlqJGQ7ScMhYK9mPkuLXzAo7r3RSJBSwi3mzH00dVxNZnkHTdfarEeLyz4fTaS8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3RKNqhBhGyIV-usTj9YEzUNs-yNRkysCzin47XiQUHQ&oe=6A8EE202"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zGs4S_3ZPgIQ7kNvwF9HsSj&_nc_oc=AdoUaRhanPrgdYyahNyXh1EEk2Zz4EtW
0a&_nc_ohc=ZgPFEL3A53sQ7kNvwH8hz6A&_nc_oc=AdqvTNJtpSyKcUm4pv98_9awM-9yp1L666x2RaoNT42X6fDGjppoqK74c_2TEgYxJwI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQCYuutnIFogOb8LmP_T_dhf9RlZeQ6gw4JOg_y6eJUkA&oe=6B0C824C"}, {"file_name": "pinched warrior03.png", "id": "2233739983674845", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391837_2233739987008178_5682748129040869737_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6xdbtncev_IQ7kNvwFnGN_x&_nc_oc=AdqfkTu4z80AfNTi_dYUfFiGeGsKtPyvpo4s5Cr0sMumK-uBSjKxY6yYXUY7DkeyXu4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR40TXqRvmUgbPicmy1O41E2VMkK49L_f1lCb895KZOtw&oe=6B0C5D45"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VLWkdD0tRGwQ7kNvwFn76-Y&_nc_oc=AdqV6IU8O_6b95ky5oEiouxdpStcfLs6T_60mcKuka0Mf8Fjhi9r8oBcc61QQHkpJCo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTDs7MhPu8c7Q-7JnQxjR5AmVnLlu6LGocRCCfA9xtcNw&oe=6B0C6AD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DQxJbDmphNYQ7kNvwGGnfhj&_nc_oc=AdqJMMCoOF4cJ7zYtRba5DEqJBGTGdph7QiF6YI_0kdQE7F4nhLbGoMRYSDmnNgFMZ8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ098woSbdpLCsuWNfo38t1nTe8swmXfqeOLyLZpMMd_A&oe=6B0C67C4"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f4_05g6AEZUQ7kNvwGCjQY4&_nc_oc=AdqxQXyNwE3Ich_hqn8nXayXBzj3x1TcZfKckSJVKvqkIOL7_a3SFqnkahERHaD3jeE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSQ1Hnv7weO56YMyXyiGcNAMqRuGbDSkZOwBHJ59H9L8Q&oe=6B0C5199"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JnVuKLwXRcIQ7kNvwH
=6e7a0a&_nc_ohc=6sIuP4DxSREQ7kNvwFEoFAd&_nc_oc=AdqX5jPugTsel32zA4Z8F68q6H_xPlvUVAOHscavsUjyDpW6PwO00CPIsZqJ1TcU1xw&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQETkwpyd6OUVlQvYVcX8NQGEo__mp-sMq_ZoZQqX6OMvw&oe=6A974005"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yEuWNU65OMIQ7kNvwHI-a0H&_nc_oc=Adq4AZYsJeq-YMVMeIMw86feaUVuSlpSMYT5XMWQkgfWC04UubXG_rbLo-vtjbbDh2U&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGaF_QWocoVzZgasQuj9JJS2I9Y4RdN9WGI0IbmXsT5Yw&oe=6A974D92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5L58yHRg4z0Q7kNvwEzJOrq&_nc_oc=AdofyDOn755j7HgoV8VDEiSPmpq2ifRDfKux4dbr13qvic66mhIHma8IF2us6jUm8PM&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZUt6d-TptA9ptRLOwZ3Fz9_kuibWlv36vVb-PJ_5ffw&oe=6A974A84"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qEUJlbuOCAAQ7kNvwEbM9r_&_nc_oc=Adrer26eNR_gynm-XGppn0YcgW2bqfiuM0wQMwHSdGrv7w0cbT3n_Yuo-1Tjn6nmphI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFym8IWrR8nKhNZDkrHluEHgGjERDAi_t7pzkZ_nserOQ&oe=6A973459"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sL1QjpUHOk8Q7kNvwGNmBr7&_nc_oc=AdoggUEGDgG1rd6tIAsvRAxhJhutZ42gMKFxXGrLbx_hesvnS5QCH8A1blxhAx_yISA&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJabIQJMFhaq_QzXmLLG3v_G7tixq_DgsB22drS7UIpw&oe=6A973B82"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cBZ2W3UFHZ0Q7kNvwEmOM45&_nc_oc=AdoK9XuNN7G3o-_qPyFW-8r6qBWn6be6HmfPi6rnakpNGoJmoKknBbW9b
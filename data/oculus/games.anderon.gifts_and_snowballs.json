=6e7a0a&_nc_ohc=jwpLwgj7SLMQ7kNvwEg7i8S&_nc_oc=Adq_YmnZEAGoWGtvLZqvYgJJjDYwAidoynWBKLbYy5XK4NLDSEvSWjgwsjb4DZuqSpM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7nZiQP_JxQOKTO0oe9ntRNWI8UgjF37fCrWrwXVkCPlw&oe=6A008485"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hbGvPYrgT4IQ7kNvwEdtJfC&_nc_oc=AdpIwwJYnjMdtjuHgJmDYidBjcVcI8meVsJ2U4g0dFhAm_hJs_CUNEpNZFdTN9GFBp8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6EMKO0Hk3MsfRmK2Uw0TjKOq2r4YiueSUZeqZ9pRdHbw&oe=6A009212"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R8LuGlUAb-0Q7kNvwHB5Gbf&_nc_oc=AdrZ7bn0Egx3ml9LGilhdPw3AIqRYfX-gNLd4mk-yd69couIXwgWEYmerCcLi-7ytq0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6HbQoZrjdg8G9Db4vDdW1I6adRiBA8XIQUnmzZJiajbw&oe=6A008F04"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pfkqlab148oQ7kNvwH6aXyP&_nc_oc=Adpuw4kcoWxKCiDwfAGCCSOsetHO-tZJ0iZlezHnDDwMlP7K5x6zDuGrPlezYoN2iG0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5piT_ypQ1V_YW_9f-iZagaVspknrzIaJQ96wvJUWjE6A&oe=6A0078D9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5xvgAcLjV5oQ7kNvwHmrQ34&_nc_oc=AdrQFucciW-fHQghz0qduhvuADWI-rbyLzMBe1GsOoYn4hV7zokTuJUMC5ZDK7zbhAE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5HpMFHKhlnDd7Nj5pWrJB0BY_ijtfB2CpCevbwbTAgEg&oe=6A008002"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=33NrlRCMydUQ7kNvwEqtZGs&_nc_oc=AdpjakaKtbyOWewjpZ-9IUYjarqukFIAE5ZNzaOKzTFyhh2A60QKho47L
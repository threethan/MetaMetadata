=6e7a0a&_nc_ohc=-JYdTntUGWQQ7kNvwG_CNTz&_nc_oc=AdoMsnuw6HR3J7smjhOT6xSPJNkrm63yJiPqnvxeYmrLeGnXWKCv-tSCi_Ik1Rp8vrw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_pcmrm4ED9KriHV8mS5MyBJZdTWxoMzhcznfbOikDKDw&oe=6A2FFA85"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cmlxonQATDQQ7kNvwEOUSd2&_nc_oc=AdoBNspG7t7P5fEha6ZMcgZY7vXy5KzF-AtSYhrX1Vj_L4JCF6zADT6mC3Uu64WjPlM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_BVgWqeQe7AmlBLcgRIs0Y7kmOWboAlnu-FPUNJiQgoA&oe=6A300812"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lZWCeJzNYvoQ7kNvwGajCpY&_nc_oc=Adp1oo8vpzXQMxYEm7VAzYF4wrTtBmapp0xxYsKU68HMIQD1RrLPQyIUlMRcDQgLhRw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9p-d9KDzswfUFZLmxThhLfdnXBpEsm8SN14LdPUUVy-Q&oe=6A300504"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XKJKqsDfhSQQ7kNvwHY2qt4&_nc_oc=AdqiVW-1ZQNGt9Rf5uoXOMWgsr0JUZbR2Fal2KuDD9eOHs-uWBfOkjfRpNcZ-Otn7QE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ynuWeN-9wMC4oznbJM4LFwNNrK7dKV9sa9BdNj5wwXw&oe=6A302719"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f1Y3aTgS4rIQ7kNvwEpI5BV&_nc_oc=AdoMKseMogobLt9irEi6axaHLdkv3kCIvqqZtTqNtqZkDET_qRlOw1i25ELQCgClymQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af94-OqxfI-uMlNmvi2p51LNiMyROtY2UUhuRv1qfI72vA&oe=6A2FF602"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7y4_edPeZUUQ7kNvwG-NRdA&_nc_oc=Adq4s9xYTWPrYygzJcW5tTwlKw4q7PCO3uM1oDpgHRBF_vgxbk_OtkhJj
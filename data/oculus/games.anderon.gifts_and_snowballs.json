=6e7a0a&_nc_ohc=xqklZizneRgQ7kNvwG7SEAK&_nc_oc=AdopMVAqQBhVX1-xdfo7qZhXY1MNF9FA6X1unxTWCyv9PO0ukkHuGgXNVRFACpUd4mY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcefTrPmZPi-Rh9c1fy3tRkKjp_0PcPAU6yrg-quP19g&oe=6AF350C5"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TSjow23PBXUQ7kNvwGOo5Xz&_nc_oc=AdrjP_Uc7e92D-itcbS4ULD3Eh2TBdxAhIXmTm3RUVI2BoPUa0qOpNYa90st4iw2yqY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQh6hZsaOWoNfF00f17iv3sSVOPoG5SNPKMQDMVRVYxaA&oe=6AF32612"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_bpJ2p0C5e8Q7kNvwHGNXId&_nc_oc=AdoaE8jPXKLNXgI_S2YfEyMEgmkjWDbXq1KHhzpP7FsMeb21gs9zhlJCVazx12Dj8_I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRV876eLCHDC73WV_4faaWyPVrHNYh_XhdzhVYawrr9ww&oe=6AF35B44"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=frs_XD4Hpd4Q7kNvwFC8UEv&_nc_oc=Adrzx7XjXIVn2M4nynh9JlzNyRHPNDk3fd8QxgT5NMEVXVPdQ6WjgqPb6YZk7exquvg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScsH-0P-Dc7BPGIDG028f8IGuzsfM0my3JkTZvFu_jKQ&oe=6AF34519"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gp8sKYWnRCYQ7kNvwG7fH4f&_nc_oc=AdqOBEaIECJ9t9Sx1A6P3tKvd7jCbZhD0QCswkx3Tsd7iAQuPLdJbgXtbJBjdXJrwUc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYcI0fQ6d3pG_G7cqFo_zkyFhtF0PBOJAESdofLlvnGw&oe=6AF34C42"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9TpRPZx_YMMQ7kNvwH8_maa&_nc_oc=AdrEcQs4nAuE3VblMLrBaB-QgkVDaOQ2H6ElwcjUvYOqYCVNVVQEj8RSP
0a&_nc_ohc=d1HCFC1OWPkQ7kNvwF49vTq&_nc_oc=AdrtX2byEyCDr93awRErZuVBErw3_mhG1d1fk-DEbUujiw7I7BXeGknDNu4YCyBgJSM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCKsqwWcxLseocaJvtnZ3XMUb2LTT967f9e2porTw9NA&oe=6B08558C"}, {"file_name": "pinched warrior03.png", "id": "2233739983674845", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391837_2233739987008178_5682748129040869737_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t9oSq4FtJBUQ7kNvwF4nqOx&_nc_oc=Ado-ZvK2fRPl0kpm3krUXwhnx4BWgCvytj3U--r07ovi8Xa6hVVw_HM2E_kJf9p9CbY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIV48MZDpl3PPaOZTSfBU1P8lzRSAA7tE7_Tw0E22FvA&oe=6B0868C5"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LnNq4Xj_OnEQ7kNvwEyci83&_nc_oc=AdpUKxz4y-FwUdaKCfXRNpQvcY7lEy093AWUoNE5sw0dOdQj1wwNMlHkYNMtQQ9idd4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1SZ_Lrj6T3q52nDW8-DVfuk16h_HLzh5WndNSRXrPOA&oe=6B083E12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=14RDlSt5EZMQ7kNvwH9S5fH&_nc_oc=AdqYmq8m8q0TzSTHiuyMhlcR32r7SiYPjTIHHM_ALPrugNAcb6rC1n76hZ6D7aROfFo&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRe-VOwJ9YcDlgAq9XAE4Zc718aSYbZ9aQj_JR3_UggLA&oe=6B087344"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K27yNVmeq-gQ7kNvwFz1xWk&_nc_oc=AdodWA1h9vsE3knM1Uji4a7XhmzZUYr9TgpOYKYoagxs78XrWCPm32MthzEsdcz8dj8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgXS4dDx9-0Suj6Yu2blhywxJk90_-UyZWF_9-d_C_cw&oe=6B085D19"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cNNTakovgAEQ7kNvwG
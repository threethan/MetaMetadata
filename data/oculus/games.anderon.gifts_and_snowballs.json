=6e7a0a&_nc_ohc=9-uGbwH5cRYQ7kNvwGwaDSc&_nc_oc=Adq57f1OsXq_YXRc3QY1DDCUV-O3IKjkwj6jziXToNbEmTJ0j_rX16---ld5MjX6bJ0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0dTZnoGFYQzkFwEe7ndgWfxSgPHwwegGTj3-cm41HZbg&oe=69EB6C85"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gu9qkrjJyrQQ7kNvwHZ6tUY&_nc_oc=Ado55FIGMCnLLDzwDKmd27ZpRoMwwQ9TxrDN_xKnLmk2BNqo7S4TYyUwWSIXFgF4bdE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Y99toUcxTSVEBfAE__5GfYUATNWpM8vLHD4eQ2kiZYA&oe=69EB7A12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cu9zi64_jnoQ7kNvwGhu16E&_nc_oc=Adq0cOm48yFQEDdO8aZ2p6aE7u8Pi2A2JryF1eHCXmYyMkXIQnnrBDBg0eIxZNk_Ivg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3CoGNkypvDjxtx67J6mvokrb8WLHbzNQHP9qjyqJNRmA&oe=69EB7704"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8lnuKT9y-jUQ7kNvwFjNwy7&_nc_oc=AdrtQyJbNoUQTLsYBd1Cq-Q9QlS0EvL1vYlDJQq5HWYSDVdAAfbtqFrpqJPMQBZlVVc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3_YYV7_8cSJkilWyKeqA-8bMlrvRXBqVSwU2AGzwrWZg&oe=69EB60D9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iUuuKMs9-awQ7kNvwHEjT7r&_nc_oc=AdrqP573RM26Ux-_uqYEgNBRpNx0VyXGPNWbreO9YNlt7GcxTDLUK242cuW13RLVgig&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0uJ3ZkbkOGL2nXT8__wsguxpNJlXiZCzR9UD1SDeDmEw&oe=69EB6802"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0-FbwvnTa1MQ7kNvwGbkvbK&_nc_oc=AdozkDePSdJzFzkdmf__Ma2zv55YpGF46jZfpSFS8y2C39o41zVTOmZNZ
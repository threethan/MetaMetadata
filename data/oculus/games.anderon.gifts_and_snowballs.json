8&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m6WsR7QjxHoQ7kNvwFbcJEP&_nc_oc=AdoT1lSd4PUO_Pp0LkYXHEz7rZw0ORgAGUFIgl0MrCDXHEUYYQe2MO6n77iE3TLMcbA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-63u9pNryDsBNlUs5QOHGgdG8Mu7SAuVYRncklfub7yQ&oe=6A393505"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CPdKrGjHZAYQ7kNvwEkUSxF&_nc_oc=Adr4hJE-JQ7HDDli9SPhGsgjEcs0-QQ2yvDvqslepRb-wn5TwU_AGZ1dqc4Shn6HFzI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-HCXCDPbFp-PkFFK5yIypwyawnvMOLM4MwF5brO5R4WA&oe=6A394292"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zGP009H8zXAQ7kNvwGKV2Ah&_nc_oc=Adoj5hKkmgm5SD1A8AigT51AuRa58_Yzrisxdxu8EoVOJJseHM8v2PmGTLhAam2dQhs&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8nmmBO6vlWcsqUrHvexhUenfMru0-uqflYqS4LCFZ1fA&oe=6A393F84"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9bcQ1Qc3Zs8Q7kNvwEJIFoY&_nc_oc=Adr7ldg433k73pohEg5QYp1UhmPDvpjOjgX6x2DNboKhw8QBylBY0J1DRUvsEFw6Rfc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_BF8aQeJhmgKmWKEKgASkzqlT9k-IgtSRrCaBN8YsLyg&oe=6A396199"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=asWMpoaNTHEQ7kNvwGiz6Vw&_nc_oc=Adq0iwN_3Zq_M6284tul4oelgiKF2O2-6X-rjJS95dxtdYvSvdd-mms3NDmyrOjfOX4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8tMAyJo_0uRGEChBwqtt2NeHEP-r_R7p4Jb5brQX33Vw&oe=6A393082"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_vB1igxOh9kQ7kNvwHXcRFM&_nc_oc=Adp1v_t1jiZRiYffxPx2dera_tBEG6-cpW
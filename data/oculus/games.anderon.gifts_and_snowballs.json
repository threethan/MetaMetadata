=6e7a0a&_nc_ohc=qQfkrXwIK20Q7kNvwF1PmhE&_nc_oc=AdqlAoaSxx5qqEhXbkLIV55tVAh4YL78sqqbelAaVmGlMEdT72zvkFNsPtxvCsLAuyk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af15B_ddNvtIEQuSDo3gkmKvl8xp_heJFcI8J7e2CBI2Bw&oe=69D8F785"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xnnHTzhkf4sQ7kNvwFztik-&_nc_oc=Adr7Ww4lYOXJivHlNWXTzWAA9vB_PDa_PQ5saIRBEBUwOJOkvkPEUATSzk_CKNSMiJ4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3O3OZxtX07zGdUdmBKbkseeiS3CgYzjXUqfRXLtGABpQ&oe=69D90512"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ZFW6L2PqEYQ7kNvwEZ6qPJ&_nc_oc=AdrQ1zRWL6vtlWg3TP2O6p48sre_mS2NraKHg2AUJ6-uuaBnTs4VnJx-sFpTGZq4_J4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0kQWqsAk4kFuj8ZgBdwf1k-CUxkvfwl-szHRaP9QIvug&oe=69D90204"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zFXU9AT6OKEQ7kNvwEac7_6&_nc_oc=Adrb-XmCOfT9tBOSJWFMl0PZZrmg9e9V3lWV3P_IxODFmgOFqwJEzi_qta_TkWjTHGo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0mnQE1TqztP5lsCF1R2XECJJHnwdtBtLlKHZslP3OE9Q&oe=69D8EBD9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3delMX0sfYAQ7kNvwE9dtWw&_nc_oc=AdpOwthRjRixrhUa-opTmwOS_SQkyn4nJgnvZZt4MUuCiFoS0t0GZ6-RO_mbQRO7wHg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af29yx4eVmYsj1s3fyQXfD9KW76aoHQ_e5Q71mM4KFPwfA&oe=69D8F302"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iuv40M-bbRsQ7kNvwGHEvQB&_nc_oc=Adp1DJHfbsFGeZ-zc-Sf6LR3Ft4duBoM0T6nnoHQyO1eqniY1OSCpv2gu
8&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JFEkSfLoVEUQ7kNvwFV0BbO&_nc_oc=Adpz8g5C9BVN5ooCPh2mZvZTLq2GNSs-bNs-XyvCe3H6Q6SRftOt3GfNs5Pxu8Qq2Q0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af560C1THRjlqHRhz2a78-SVchoHHS0ffyaC8Q-WbNx5ag&oe=6A11A805"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gxLL5H5GG0EQ7kNvwGhbJnG&_nc_oc=AdrG5nTcxrZ1dwoA3JYfwdG0WNrppOa57Jth3C26kZMKhbkCWY4ZGTFs4e4UM0BWP8E&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wxXgG5DzPIuwC8_n_FiI9in7Fi4SDO_MQSMzuyR_fXg&oe=6A11B592"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mdKGvFzbAmcQ7kNvwEDfGk4&_nc_oc=AdqSwOhgTZ0C4k-EK48xVr7vMzllecqwzK8VHEoKhKdyf0kxkZK3uiTyOhlRHzx9b3Q&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5cCuOJ0sDEL_OSXdfmSZRqdkwqQslVI9rg7zN-wt4OoA&oe=6A11B284"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ymf5eHgEWqUQ7kNvwFIpQ53&_nc_oc=AdoE0k4_SnkLcSz6UKFb9r9JizVfCK4-w9VzK-Wjs8IxM9rBKKZxRl9gI6OuNCsSH2Q&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5dB_dx2Knke8XDZURmmr5Zj3jsiuIdylfue3HRGcTEKA&oe=6A119C59"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MgMYsFY7iNUQ7kNvwHOaEJ8&_nc_oc=AdpZQ4I-vGm6ccn2BmIihMLwAZKTSOfUnWAcHEp7s1n4JL5QOkClF2NwONLbhpV0sdo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5C5DD5Qp5uysC7o_ogHSJUlgAGYd9TYHoLUNbIvCFy5A&oe=6A11A382"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7cIqaWf6J8sQ7kNvwFnIjXI&_nc_oc=AdqArzsXOPthZOk7OqN2TmiRftD9GwoLOu
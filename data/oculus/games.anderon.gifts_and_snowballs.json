=6e7a0a&_nc_ohc=kafsett0vJsQ7kNvwFR6sup&_nc_oc=AdpZiiGKRBAL_S2buFtWuKZnFyfM5D6cOD1m6jEGBxd5iGEbgMqiNEYN_O1xkP7HjxU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0XWwgQ25VxCSzCvXsHluoXYNPf4hj456vZilS-44tMEg&oe=69E4D505"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6LoX7LqJJKoQ7kNvwFcZTUa&_nc_oc=AdppvNWKGzhSPHGSX8qt4Uv-Qc8ZEwZ4dofLrBPF32gv0x0YjphzKuWUUu-e-3IvpCI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3WeO6TjfSEgLVWQnZn41znm_ktC8ZZfjTh6M2mF1UWkQ&oe=69E4E292"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_0Dz-khOfmcQ7kNvwFDfL_R&_nc_oc=AdoeFPF71eQgnV4MW5RWJVjFwIvRdZjUUkVFsAi-VaIfc_9TIVKjjXKWPKuXpeVsEfk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1tVsufqaTCGEdRWOmznAOY7N_fqNXRbNC9gpaOGZvU0w&oe=69E4DF84"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YrgruFr7e2EQ7kNvwEkEDps&_nc_oc=AdqZ6fOFSdtE4R-nkIOQd4W1-UHurC2Wtbg6AheFdZtm_JKaSHow4KVilQgycfGB6qA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af08yDc9_yqZI6bQVGBL6_vFKyo8y2XMIRrcTMbNrD1a0A&oe=69E4C959"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Nve1BT5Yz4Q7kNvwHHecOH&_nc_oc=AdrwUGKbmfldPRPbblmMk6o63QebYqbAhFgt0eJLzW7ZAQxk6a7eMl-7iKlEdKhoZxk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2MGBKBiEASLjOC74yjvceLGdyOexNp_236mIbuc_2U0g&oe=69E4D082"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y3EO7PzMrwYQ7kNvwEwSqFR&_nc_oc=AdqvPzZ5Th72gnc67DEwFxwFT-Y-Q_Eu5egzeTd2q1cu0XfUc5h7NAVYF
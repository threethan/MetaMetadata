=6e7a0a&_nc_ohc=3PDxvHcrlBwQ7kNvwHHtrjk&_nc_oc=AdoZ8CoR_91juFxfskTiMqQPHFAo-TRDUYzPac4Xo5veNzoTKlnD1RAMXdSxR5gbxKg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Wc5FGBl8HXDj-gMVn_3al1CUjrumwL3kOj2gK-uqtOg&oe=6A281185"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0tqWMa8A1IgQ7kNvwEv3vad&_nc_oc=Adrn2BuxHDvliCtJUxV1WZN6RlO2LNFDc2Cb5cpnZFg_SfGJCcxgJy9XyYl61FiKcM4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_pOCyRV68FV5-s8TbobY4G8VZAg4do5KyBtjnLQgN2Xw&oe=6A281F12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TbO1wL8FMPcQ7kNvwFw6Cvc&_nc_oc=AdqyWP8KSo1Bi06IJcmUFVkyf0jTNaJAjFz5SnoKIxrGE3fZ-vmIUCzm6GoirmBD-IM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_PIrDLIg0_am-BbuRrAWkgs5jJqlI9apwtNf18o8kuUA&oe=6A281C04"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MeXEG50Vgb4Q7kNvwHO56vF&_nc_oc=Ado4_s9PG8OjVIwrDjnQF30Lyzk-e64UWwYQsg05prh4dL8SfN7oqrVmJ71XmmtnbAc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-qTWXj_QzwlDB67fifi9KPOZ0jTnzvXBQUBclDH9WUmA&oe=6A2805D9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d3njX37yjfIQ7kNvwGO5gXU&_nc_oc=Adp065445Jrb_QiHgaJmaXXXef7w5gNoAOschkQFJQ5QH1qq52blHKTYEdOOYlzamlI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8toKzXKsL05N3UJY_s35uJKa_7vxnXoV36knJ_C9KuZA&oe=6A280D02"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4XZEwO9AEz0Q7kNvwEjF-md&_nc_oc=AdrMoURdYGMynxumk5rRurNvouXOu8GLDy0kqaYmUsJofHvCLOLLwMVfA
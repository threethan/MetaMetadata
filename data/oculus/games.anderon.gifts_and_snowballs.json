=6e7a0a&_nc_ohc=0UgBcNnP_wcQ7kNvwFmQ8OQ&_nc_oc=AdqeJVSJLsx_A4l4LyCBXOkkyvCFBFXJ87hDG-K8wGWvS1shO3FIZZDGc0pn9PNMwek&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCL8FU07MmzW3_czfHj3y2gbmvey60V8ahPZ8VjZnT_-w&oe=6A5CCD85"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=26X2yrxr0KQQ7kNvwHNd6WN&_nc_oc=AdqWHDtqKC6w4V1yKSKDuuGfwuP--zRa076KtknryIeC2FD8R5INzN12wJ9zpB5zxpE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBvU_gLyl_oJc2T9x7Ys6udXIvKbESVMDgRAsP9TOc3xw&oe=6A5CDB12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nEoDSw4s3YEQ7kNvwEIjBUC&_nc_oc=AdpLl-gEVBw83aQMfM2MXknZiJi3tw3szBPG4R1GopENAMyGDNN7IRi-oNCxPDNUVdo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBS4_5IDQ8DNJPrTm9ShFsJaIBHjd_QlGYBjsQUg0BGtA&oe=6A5CD804"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g64bG4Q9kosQ7kNvwEc2bnZ&_nc_oc=AdrDNJ1C2oSA_UBzH883rzSPUX_fkzWt55eMU4T1mVw-puLSnM8hM2pu4Uxj45OQNxE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQARowezFrSTF-OoCS1TsnsCQKL7tcA185NBLsgs-DDTMw&oe=6A5CC1D9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EYXG5lcYMs0Q7kNvwHTmQZd&_nc_oc=AdoNw4-28Sq1gVm9Jh3_vBXnbHOyxnwvp6bkaq7iqB6sp4NMB_0WtG1_3cKhkAFAkqY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZWBfhFp9QGjWkwvG_QC-tClb4Kw8dSgHGwnCcysCD0w&oe=6A5CC902"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kjdz5m9duVUQ7kNvwHSe-d8&_nc_oc=AdpDsJV-6vnpqY8fPDMJqYLE21l6RwIJF94wGhyp8Y2GxGvP3vTsXFX1B
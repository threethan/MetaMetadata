=6e7a0a&_nc_ohc=6sIuP4DxSREQ7kNvwGToceY&_nc_oc=AdppQT4kbd6vlQA85lBRPH70YrCEwmYPCrn3V5lGMnZhrD6fA8VrSGTY4rrhGMw41l0&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNjeJIxQz4KQpOY5g1CU00gdx9wArdoS4Wp_avSICgvg&oe=6A942C85"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TT4R9no7FJEQ7kNvwHfI9py&_nc_oc=AdqZMv4wfj-PJeIuSurChfb9v7A1C08hy8JRsK7GnYclCGxqxqmV9aLX-VWiehrP_n4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYOfNNrhx-8hv8DlqTYQgw3GUXVKzAziQI7tvs9X-gVQ&oe=6A9401D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=02lTXSedYSoQ7kNvwF3tMdu&_nc_oc=AdoeT8XtSihunsgBZ_SEogFYJVHzpFZP6oQ3OWkEYBuYurwnCJ591Z8_90sm8qeHbd4&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEzRjHiRvDXnL29O3i1GLeFhuBhCsqOeRUlE5F2QDHqiw&oe=6A93FEC4"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1FmqEqW3x5MQ7kNvwGoDogh&_nc_oc=AdpNCmII-3AaaNr4DxvYkBjRZrh4ZFav99uLEo0NgBBaCMbo89soCRJpjd72Vxv0xIM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbMOVQjHy-zrcQgxELiUmp9Pqo1WARHn0MvUvyUqTrBg&oe=6A9420D9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sL1QjpUHOk8Q7kNvwF6F-oA&_nc_oc=AdqrNCyJkv4w5laF6zqxXiv7G3A9BTKcfjlNHHxIKm7PT5qw4PW79azPjnXymu3r2bw&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGzhZPWXXvOXbCvz3Dk3On4dGQ7Y9mTB55LVtwmy1iJgA&oe=6A942802"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xkk7X6TGxHQQ7kNvwFoofSD&_nc_oc=AdqWfdgsEAh6Zl4njLPbgsyENJhS_DVf_STn5mvzoNKHpSeZjZx6zCJAB
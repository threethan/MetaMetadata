=6e7a0a&_nc_ohc=b7mIP89PxYUQ7kNvwFw3ciB&_nc_oc=Ado2evwMvDSZzV_CnY_169TpYLkX1C-DX6HRY24M_1AZEfPB_1xeo5I8vQlYLX2ALBo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_oM-Zw73pS34PsDwIerVB_ad8j_5viFUj6MifT3SiZtg&oe=6A329D85"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cmlxonQATDQQ7kNvwHZrbX-&_nc_oc=AdqJMJ-dwZqFyAs6ND2Bf2qLqqAGDBmbg5r_tk5vTGdDZXiqJpgjt4pKU9OTepIpiAg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98dqsbz088wawaWcVtvK7f4T3KE8Q5Nxo0RDV4gRwHzA&oe=6A32AB12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lZWCeJzNYvoQ7kNvwE7a22j&_nc_oc=AdpbanIp0W0HveTQCdIW5CKGT1a6JaD5tlpjSho_DYmV2EkbosptE_VA8DLZMzJ2QtY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9k_c_PPC5vgxIqCqx87618SnXIPZtx3zV5Jh4YQQekag&oe=6A32A804"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jaM8M70u9iAQ7kNvwEldNFI&_nc_oc=Adr5_JYgNHJB-866A6yIW9qvc5laOMfFJmn20ZGwrT5LY-8k3u6dzYsRge4OLTumW8A&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9pC_rkjJQPeX-BEGio60NNPfjJJhmy0YC_0wspBsXmfA&oe=6A3291D9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kHvRFCuz11MQ7kNvwGouNlR&_nc_oc=Adr9R3ih1qP_1VXovouHT7QUzcF4dBgq44bca_dx6Qc-RYe45zFRANYcaKEQ9rY8oVw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83EX2aTTkot4Kk4WhlzGbnQnf2oCmAv-OVSTk7XF1TLw&oe=6A329902"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7y4_edPeZUUQ7kNvwEZdh2j&_nc_oc=AdrtdOfd4YKYIhDxiD-1XItHNdc7vQrwVY8PyWmNwtX6e2913XvsFfkAZ
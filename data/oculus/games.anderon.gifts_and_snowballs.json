=6e7a0a&_nc_ohc=dtD5xESWOjsQ7kNvwEbH1Rg&_nc_oc=Adqpomm0lDae4MCJb-zj8xzc14cIwqVCTwoFzYrUKuJfZz9XDTEHiFgt7f4mqQ_8fVc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIhPb_K0rLUJXWothPEkmMRkG3jN1ZjVaFZysq88Jxx-w&oe=6AA00A05"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a2SDcmSG1JoQ7kNvwFwyjwO&_nc_oc=AdrsXwfJHWKhqk95NOt-Oa_NItWQwJqftYy4v6CpWV14dto6bV9EGMC9YvRd0veedPA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGQYRwDzeigBkhUpFqR4wtFL2oIDjjkBf6wq-egOp1Bg&oe=6AA01792"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8NPrG1L6NoUQ7kNvwHAxnV6&_nc_oc=AdrJsIsYS3crvA3-RALK3jFECHAnd2-lfNXnP130nUykA7g0yzuEoxXsdXeXZImhmqg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdnUqgBPdZMLF0XPqaakKFPZY0w3aXdsZy262Zbgld8A&oe=6AA01484"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qLawT6b3PlQQ7kNvwGIKE-U&_nc_oc=Adr2S-TLDvNOtRdnw6L_DCD2iwJSvEoQcJplX7X_rs9pOuHtxxFGSj22LadbeTGSddM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJhI4PUG_b0mP-wQOSW1myNnY67ReoHTMUCVmsdE-t4JQ&oe=6A9FFE59"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nSz7fgO9eV0Q7kNvwFZ49i8&_nc_oc=AdrMg6hcFMPuX0zcArK67AOUuTvgZWXK2JtSoKJ3y9qgzHsT8dmME3zbgLHMBm_U9Fc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0Bd9e5Hi3cFV0epwDWqVOo21Hf2_Qhvn1gAI_gbNlRQ&oe=6AA00582"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CPEp7NWF9HAQ7kNvwHENHun&_nc_oc=AdoASfIrTWhsqOIT8W2mhJgHLHrDby1ZYjFv9v_ioEuFe2ezTTqbn1z7g
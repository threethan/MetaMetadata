=6e7a0a&_nc_ohc=-fi4RqJxHGYQ7kNvwECaz4F&_nc_oc=AdovGFXpOxpWfFIZVzvkyYGO0ouDSvzK-VegaGhsDG4nw5ha9W986TLTDeR-AF0TcpM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jTg3zHVRs7QhoOAzQHN981rLXVJszF9rj9NiXEE1Fbg&oe=6A01D605"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hbGvPYrgT4IQ7kNvwGJRswj&_nc_oc=AdrvSPxuVBP9Qsos8_cOR5gEVeXUQA3Ks0pxkGpmT32R_p4-Qih4LQCPbfed5wXudo4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qXKKNv0QdLzxHoVqQNC28St0INLqjuVWFcetdwx4mrA&oe=6A01E392"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R8LuGlUAb-0Q7kNvwEj2IK6&_nc_oc=AdpLrwtlT1mIAqEcNt1OtkHHQoK2Rn-4tc8ctuNfDR100_C46vDn4j1aj4St7X6mPZQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_Tj00U3AL50uzDb1CF6JULt_jjjPccOoQ0tosUAkkoA&oe=6A01E084"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pfkqlab148oQ7kNvwFazDMF&_nc_oc=AdoCtHyMimeW4uLjdeaelraDveYApixUSmxXzKmbcDAxApJ-s14ekx1cBYlYhSk1weo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7EZ5JeX2XGDZLvZUS1M69KDOJrU3K_qGjpWylTb_eQOQ&oe=6A01CA59"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-E3iBoFdJTkQ7kNvwH8Ttsx&_nc_oc=Adod2V28YP0QMAcPvUDLHm6TmHRXbk4P-Yqd0TI2vmZVBW-2ErkR2plZyA2BYBGardI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6EShJsBk9Nxe_SBgwSEVVAUXYBM49hXBfhmKgi7y5XTw&oe=6A01D182"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=33NrlRCMydUQ7kNvwFb0Ur5&_nc_oc=AdojHH0zKTyULTyNMjQxDuPQxrL4Zrjjk136ZQXmDNPnZBKLCyx9TM3x0
0a&_nc_ohc=ZgPFEL3A53sQ7kNvwFtPqMl&_nc_oc=Ado0LI-L0qNtKMSdcPNxaMc9Hb5UCeAOoyHawybH2ixKhDUj3JQYQ5PPuNvlgkDXzK0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ6-h_n1A_tZfdKRov4VasF3i1kNvTZocFrjwJFECNx2A&oe=6B0D9B8C"}, {"file_name": "pinched warrior03.png", "id": "2233739983674845", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391837_2233739987008178_5682748129040869737_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6xdbtncev_IQ7kNvwH7tSuf&_nc_oc=Adqw4BZBFYHhzRpGUaSDxMt9X5F2fCJkdcKTNH5lxjATP-2dpHb7Ao_7bWy2Qwe8SZU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTxdlXZIdaEAwQIK5QVYOYnqKOXNAov5tJyzLlURo44Hg&oe=6B0DAEC5"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VLWkdD0tRGwQ7kNvwFCyKJs&_nc_oc=Adrwv_vxJQymU-NoPAdaCHy3x1b7j4yf4845iD7jBxb8mNGmKy8EuYs0pylG_wKyyNA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT8YGwtwI-So8CXf9q2s5SbhcLpwvt9egTPWBzcUYm-JA&oe=6B0DBC52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0a2toSxw5E4Q7kNvwG7O7zq&_nc_oc=Adpji1hXJ3UlAHClweeflK1pK7Qla3AF3GHH_NzpDQLVl2LL-Y2D_V-7L1MR45PFrTI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTB_yJpwGW_zOtZYTc2DYgz2XB_vhshblmh6Juf8G7UHQ&oe=6B0DB944"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f4_05g6AEZUQ7kNvwE4Mi2s&_nc_oc=Adofhcv5KC_HAvvMx_HCyuK7dxcHCDyq5XXYs4iRZWHaTnxcSREIxkThxHoHOxURX94&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSmAmsaDrLwdkzwDlSpAVbaiOLHUG-0e10SSPB6Ywxorg&oe=6B0DA319"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JnVuKLwXRcIQ7kNvwG
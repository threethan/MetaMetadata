5285"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jq3ZwpUOInQQ7kNvwGOOfKG&_nc_oc=AdlkF7is4pdn6vpEa25HWo9W8dZE6zVtXzy2v1Jtsi2oaAkYK_sdl3026jdkMNOZ19U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftMdwLbZkxOh2ivQRwdCEeBKjb8dIDBhnndXjllz3dLwQ&oe=699C6012"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lMFxAkunDGkQ7kNvwG6YCN0&_nc_oc=AdkYYLe8RGt7BdOLY_Rg0xmQEONp3QnRtjlvZyje_fhyQ0XHNkVArk36UkYip9DZc4Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftJWj9zjQVgY4DcIbWLkH9wt9g60sbsOrPFDYvVpSz1xA&oe=699C5D04"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yPUFCZyCu4kQ7kNvwEs30_V&_nc_oc=AdltMpbmm_2eYw_RlWl3FtDuofGzdcSDRtEtciC9mF9-EwoTn1IofoElt6a1eQVdLBQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvkLtTvfdq_wczwkcJLRkuHYiLFNVNYT4D8visLInDLNQ&oe=699C46D9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SFxFK0yek58Q7kNvwHbhZXQ&_nc_oc=Adm2maSQR98UGyWD0S4lfSxnWPzujJeTz3dfqvs4kIffcG0psdCgvWAiR_L68peWZ-M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afu7-E0tfVXQ9cWMx5bXuL8DKljIxwbmphmWd9Hq8Mj3uA&oe=699C4E02"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HqkEbwaVNUYQ7kNvwGHE17D&_nc_oc=Adkd32lRJhI7E8WQwmuUNgx1PCB1MHAZH2WOftXEgYsAozv64YIBRs3_29i337LUpK0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afv4qF3mc6OTNpAO94Fe6Y4pR_aQGVSqZ5JKS8GQbOZimg&oe=699C519A"}, {"file_name": "Logo_immersive_layer.png", "id": "1582154802505542", "image_type": "APP_IMG_IMMERSIVE_LAYER_LOGO", "uri": "https://scontent-ord5-3.oculuscdn.com/v
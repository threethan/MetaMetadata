=6e7a0a&_nc_ohc=U1-rqP6w_O8Q7kNvwFpqxyU&_nc_oc=Adq9f7kMQX6BT7PdNxwJTzL1ogyBOwKbiho3Qv8pPBa8p4mQQnSYpCuecC5jnzUl35k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Tda2KqdgId31TVNiOmyiIg9pEMv3zU9Co8NQ38mANWA&oe=69FB3E85"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hW0UjcObS8YQ7kNvwHi3qfz&_nc_oc=AdoKgPX5FPn7ON4mFK5IFsotiGwdGw6knD_TTJarzqSyojh2B2dtEqslnXv2gNQsFxw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4xHIe1LrGe4gL4EEGGSifNOT4cAwLcCreAWX6M8cbIMw&oe=69FB4C12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xp0Dy2Im2kgQ7kNvwGxFjaL&_nc_oc=AdpZ1Lo7Gv2LuoK5_xWC6Een848vAULgXAAIJLd9jMn8RN8DraUalG5JDK6SeA4p-3c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5i5wtgt__x-xJumWSF54oz-pPRGElDdW37kJdtglMMLA&oe=69FB4904"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GWxt_YnFP6gQ7kNvwFVNtbM&_nc_oc=AdrgskZZeLrcs1WlCk9HQwhMMOJWnszcdHQ-bQ5B9KJtbTw3msGymO-iyGSj3ise32M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5GGXvs5Zm9yFk0B0JfTbeQlunWPp5vNsB4Ex_DLuNfSg&oe=69FB32D9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=azJ-LzM2hIwQ7kNvwG08ptt&_nc_oc=Adr-jSPSvMoD5qgwAmJAhebzpAQGvxAKI0mryNFM5z-CKUPPX6HrPjiL1cFo2Pj01hQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7VHL0G7rsZRikBQ8sE-ZGdklaEd68enDCwwkW5mXbRiQ&oe=69FB3A02"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ybte80d1Q4Q7kNvwHTjpzN&_nc_oc=AdpmXCkr9uQR5Lcs4BoNS_IO6DqR_RbyZIVGXRe8mLmICB6dWx5W-Lgyu
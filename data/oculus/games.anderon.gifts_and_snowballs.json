=6e7a0a&_nc_ohc=iRSHkDZS4_QQ7kNvwFrqERB&_nc_oc=AdqY2Jgu6nyFQPcmNRqfWy-fQTp0I2mO-fqTOoN5ftiXYnUQjj6ihNooxTFXSiACIo0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNvAS2qhKIXRgrd9PHCxxVYw7JWPqwRI-xVsjVdsccJnA&oe=6ACD1545"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dcuaZ0NT0AkQ7kNvwGFyuKq&_nc_oc=AdoAMyNZU9_EXOutzvd9lDRebFxBRKLZrLRMJ2Fee1rpF9lPsx_CMPzywOex6sVpEYE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOcSSVKNrH2RtY64ZB_N5_i8z2hPRoAu1cicmqa6QnYzw&oe=6ACCEA92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YHwptqP944sQ7kNvwHYb8IS&_nc_oc=AdoVVioSgEMRNH1ktVf9CioTLkT6h63982uyDvbQHb4ikxIga2H9qSpVzxiovGqN05s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4pUzscUzofjbOsRpVWs2Cthex037hR7drqymHX9fkFg&oe=6ACCE784"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mvgACNR2ZT8Q7kNvwFLHgYu&_nc_oc=AdovjVmh7yQn58eft7RxxrWjs7x5JwOFfs4hjwZGKpmmfM7Ne0pz7PwvimedjmGTaYU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNAtfUA4aQibVWD5Trse2vYWGvDx3W1VuctgjGwobZC-g&oe=6ACD0999"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ezR7JtOz0xsQ7kNvwHvaZzK&_nc_oc=AdrVjy-GX6S9Wx3sfWuHWpRK67i7XkOn33bN4LvgnAt2F84lcRl8l51fOtzNXlCcaxQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNX5BTcIX-fZKJ3lTG3cSKjJOKdmLjX8toYzpky5Eq2Mg&oe=6ACD10C2"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=51dj1cOwle4Q7kNvwGu3Tty&_nc_oc=AdoNNPJAn53_ocTGA9hDV8Hn3Y5ySQT4dOnwPBlouYQJEDFRnGHf5aFl6
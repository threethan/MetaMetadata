=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NLyLVnVMsA8Q7kNvwEvJr0F&_nc_oc=AdqKKQkbmFdMPIO28grKVEoKT_A7vC9nhewYYlweafEwQsRgSXCuvMBuyKv-x5we2OI&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHA1_Gf8VOZdecl3VvvNCXe8Pa4zNEhLAm34gsHi_u7gQ&oe=6A85AC05"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fweaIMsvgs4Q7kNvwFtj5tT&_nc_oc=AdqeM51E8ia1cEra0TSVjxSnv5khVR40xWK_A8dq2qFetoAmXjh4qgVKBlDkKLV4nzY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF70kD8vgL9GcXXj01KKg_jNG1yC_WgCN7eZY_JwQxUQQ&oe=6A858152"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A50HPp7-lKUQ7kNvwEcd1zO&_nc_oc=AdoaJKMQ5Riu3x-MmzWn4x2W0R0llUn0U93uAXYhOh2Ljh2kCoh6o4YuXk_4C2kODMA&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGEQONYVHrpGfydvUaxBQjnBXFyfr0CmafKFRG8N06Cnw&oe=6A857E44"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JKcNeEy9kWAQ7kNvwEucSUu&_nc_oc=AdosFS7SXOGRc0i05-RKenY6ychV56F1M8cNOoMpmTKg_lGF6YtbyYeyHXea1kEjHL4&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFlgEitgG5mOZk11Bir0TFdirwJTgtovActLwg4H97USg&oe=6A85A059"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rSo4TsQoGigQ7kNvwFWJgpf&_nc_oc=AdrSWUwIRqdfpwHl66ESf2IEEoF3tOZ6Ahz_lBcD3PEfI5HpAvDLZhsdIALNF62TQHQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5JwztR0qG4gBFTja1IeJO4Dlebi_nncebhW2iF6jzPA&oe=6A85A782"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MDS4mUw-WEMQ7kNvwHSOF18&_nc_oc=AdrOwp6VxkuIChfTvR3t2Q58cLEte99y
=6e7a0a&_nc_ohc=1dGntpXRSrQQ7kNvwEbAcgy&_nc_oc=Adp5xeoEDuLz4wlcWbl0r9rJR8cCQrWyL6UnGHt9TaR-vq9SnMSZvGGkg4_pmmTYC24&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKp9wKa8am5L0yfCSEtGKR-a_X7WX3YapoAzXn7RveJEA&oe=6A997285"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yEuWNU65OMIQ7kNvwGb9LZ8&_nc_oc=Adp6saLM18KoMH44_voRRP8231u67P47GZotBGRcBe1Fvr0jEdAH7F1Sd3TEb8ZRgLQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLpoP0qQJOC98LvM3f7zmAiRjJNV-nGgr-J7KGYUfFWUw&oe=6A998012"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5L58yHRg4z0Q7kNvwFs94lr&_nc_oc=AdpxzxuWq4PeICj7rygdXXmBQVfHM9MbkfUymR5Rs0HNlOfEMZplE4veZJrLKP_dfaQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI8DBxdYG3pJwetHo5XD5-7hcTHzjFFkkZCLOPRAfSe5w&oe=6A997D04"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=piC0YsvT_kEQ7kNvwGa_uGj&_nc_oc=AdrLfGMfvh1Fgugd26CW1lWRDw2wor1ZmXc_uS9bOW4cVruwyH2swvvAVr6WQqN_bEc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJU5bdXPFxhl5--L9ApfqJUmBGjw168AckC0yv58PhoQ&oe=6A999F19"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dG9Yp7Z0SO4Q7kNvwHrhsdI&_nc_oc=AdqaC2XoLYld5nZGT0MV8vl0olhF9JBC0yMrhZzW4Ea1PkfYk2xB1FERQ5H6ExsK2AU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4TdWewvuwYwdwNrjGLjibbJyRX9Mu_5edu8HLqe5upg&oe=6A996E02"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cBZ2W3UFHZ0Q7kNvwEhjyRG&_nc_oc=AdrTA6euc21kKNIbV0eGJCTrfYcXOaHBe-W72s1adgsnJFopffxhIBHYw
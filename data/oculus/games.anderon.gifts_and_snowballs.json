=6e7a0a&_nc_ohc=GokgqXDnDVMQ7kNvwFwbagE&_nc_oc=AdpS5XyLD8z-2FKnHI1QbQW5big6eDf6lC2iAwfX6IyHIFOJd2-sU2yzMbBkbARkeJM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLfgcH4OfJxA4g3WwUNdci3rpRwUdL-KdyjAv9ZAuhKlw&oe=6ABBB985"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C_x9m8qd_zEQ7kNvwFkW0wq&_nc_oc=AdoX7HDHvVAxmCcw3d5uIRODD8M2hI1Tt6_mrg089jhe0Rr7HP1_zoc1-hQvn7q7Uz4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDEhezJwNhdF3GUcayGNzkKw1t2NtOu_V1b-ZN2eBCKw&oe=6ABBC712"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=167wAch2kkMQ7kNvwHTi0Am&_nc_oc=Ado0qtDCFl15rguOfNwWeHHGvbmdIBEIozoebwoIiBFfeJauKKKtwgdEKP3IDhxTBS0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2LzwKrqLHpy_zMhwJTlq1-KeHC8RjrnO4Vi5ez_1vCQ&oe=6ABBC404"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cwY9f3-LoXkQ7kNvwEarWQu&_nc_oc=AdoCTxkgDHlUc8RN63NWNJV3kr-y2TNZfcYg6cdEc8JLbZStzrUpMOCP0ChP4QcwV4k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJxZ8UOKA5CutKXD3FnhCxzqsneOpf96ishdFpA-cilg&oe=6ABBE619"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fVynE0HwDhUQ7kNvwFeEdGM&_nc_oc=AdoHt86GK-LcGW_AAFRQydseuB7iu0FGo_PZ1GqmMUmexarJJGMJapT7TQ8oZlF1xQo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNB3HOpu-qW7OPN6cqcHU8LRYPzk0shWZAgoutihzL3g&oe=6ABBB502"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q6ou1TPa9BAQ7kNvwH-CxZj&_nc_oc=AdpC88IBqMoOiyif0Uei1rt1_BV3Yqa-2JYc6matQITExZ-4CS_1YGbMH
=6e7a0a&_nc_ohc=ynTWqAXmHbYQ7kNvwE0l7Kj&_nc_oc=Adr3XqyDCU_zWYyndFvQ0cDJ3OrQmqBSKimFHhwuEUyHDgxkwnfp3lhG7r5uotwBMKE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUssPuTO6LxtAnxad6Ps_R0s_QG04y0wnNdIMc70TMZQ&oe=6AF74545"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NzwPqb3HHLcQ7kNvwFcGmdW&_nc_oc=AdrZdQ0i0fYJYRBmI8ChM6Q0esYm2qNeyPQqDT0C8OtCVv0NEEmG5vfEjuY0Rp5vJkg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcZbAsy8zM9UgZxtiKxOgTnO4aI47IJ0wpC1WtgA22Ng&oe=6AF71A92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7AR11O88v54Q7kNvwEMAGmB&_nc_oc=AdpCXefevHrhuB4KT5klDFBRLyOyCPT9dgn72lGPMNOuBUnhgQSeKqBH0zrG0wYiEnY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWcEHnxhmhHpf-V006ZqXWoYcHJux4Y_xX6ccZTgNBTw&oe=6AF71784"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FQZ4Mk4OkwAQ7kNvwE6PCQ0&_nc_oc=Adop544fFj5ME9gqDY6XNRSOaq3BbXeNBwXcTGO2wHynjUezTE9qMDM7zGXga12V6Oc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgul9EyO-B-7hRzUBjvEYrLaDw8vV43-G6cMOis_RFzA&oe=6AF73999"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XDL2jlcD4f8Q7kNvwExfNfq&_nc_oc=Adr7xuWi-KPUJBCjiH7qhK5Kdsy7m_yoPPsbRPT3sBupu6Z5LVpveV-3TcOKcaGX3qQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSS7ObbJFJ30raqWNyix8D5UmBliS5xiPLPgkDcRhIRzQ&oe=6AF740C2"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sv7NxxRx_XsQ7kNvwF0uMYQ&_nc_oc=AdpYn5UaQ2lnLqu9Q5VmYgTPAwpYxzkbxxRpdaDsvsSdbAo1J-LSXclJN
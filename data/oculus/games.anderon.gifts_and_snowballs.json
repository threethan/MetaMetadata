=6e7a0a&_nc_ohc=FwAWjm7kK5AQ7kNvwEWkySu&_nc_oc=Adr7SN1L_qdzdpHQdku-rDSiD-HCiouIU9OLYvsqC2UFhCVxFVbyRUh83Xtg9dtc0Vs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzTpyBKBwe05FGABOEYxz8B0yT65nQ2IylBMn1L7Z0uNA&oe=69CE6B85"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iHJ2O-FGu2oQ7kNvwH0TT7A&_nc_oc=AdqPetu6E9a-4XqO1rmWpTMS0QbHOtxuGHqLJYKhsA-00RJbIhwy8JrzvObQTcFq6kM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzPFbhN2Vo7ZRSK4_XeAKmmSpd9aQW5gMi16j8rXVfMCw&oe=69CE7912"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GlJqBRBv38wQ7kNvwF_8_w1&_nc_oc=AdpjpfIsLTH1C-hbjYHadagayny20Vsn9cf31XzMZ9qx2MFhjL7nn9xY335dBPds8-I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzua7EDvFnWFiooD45DSZtuvNCfd7rCJcgBq7mjzmcL8A&oe=69CE7604"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ebmAQt8x9RMQ7kNvwEf-07N&_nc_oc=AdomDU5vO5Xoi9-p_a8RS1hBaI7G_71I_Ecui9X8y8jLKyifeSp_tILpoeMLjt_WcA8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwMerCpkF-OWWE3m2GfSvcaa8s39YWqJrvws9JdyktYfg&oe=69CE5FD9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3d6_AUnP4vEQ7kNvwGLyQbD&_nc_oc=AdrU_1YIOuiocfXLOecnOamzSBBVC2mNmntBV37jimm4LLT0yaoAiYjTN0UhViglhQ4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyt0GSf2mw_K0fRx2OptUYjKeds7kAQMEJsYmFylq1M6Q&oe=69CE6702"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hJSI33ATC4gQ7kNvwEJ1fiR&_nc_oc=AdqNW9hf9ezwJtCPyl4LsTxpfh9QUSIO795K_uPCqdKNS2DJiooJoAS3d
=6e7a0a&_nc_ohc=JFEkSfLoVEUQ7kNvwG9pWxM&_nc_oc=AdrC-005dh51-pv8PO2dkiTYFdC2FmWRDqbgl4_4LejHzGV4l2DjuDbkPGR7oK1tET8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4NU_Yn76Urv3coSgfP6eG2_FyioHohrnL2PktE47K9wA&oe=6A144B05"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6zRUXPza83UQ7kNvwEFFfAI&_nc_oc=Adr3d534Hs-YE0QhQJ77qfOWrvmdMv285EGUSbA_xw0Yd4F0kwJBqY112FvqBeRt3ec&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4H47im-s9IZG2F_-q984Eijz4vvYPGio6PXcFXBFv-tw&oe=6A145892"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iVZH7Y-fkAAQ7kNvwElDDbq&_nc_oc=Adqi3uNnfCIwFYf7LWiQOrz-GAiYmjQUGaoMkjs3W_Rfo_bZRtqC3FVCPYTPdPYtGRE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vVCdjcSoLhzjpD9Coe1w7jqjyhXc7L57rnLjEBQGE8Q&oe=6A145584"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nxe77EAIIeoQ7kNvwH5cVCU&_nc_oc=AdojDrtHGNN0GI_LSXT_MTJD0Qm5WQu1VrDtqy3gUbmu8yyHgjA1Gr2WYimRQS2m8mA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7j1dZdzzDGADIsRJL-MODCEVJR6tzCcoOtahLN1vZDVg&oe=6A143F59"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MgMYsFY7iNUQ7kNvwEc9X8m&_nc_oc=AdqDPBFne0KANSD7WuXdvSV7QieWF7_qMXLYM9EBMo8VFiSdhvYQuzfGd54SPoBe3B0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7hTbTA5sG-mPQPyYmv8m3hRql14cKpxDqV-uhCre7nmg&oe=6A144682"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CEMPxpmty7sQ7kNvwELZnxl&_nc_oc=AdqHrV2c3eH7k-VJbENG-C2VGQ9kMf4aCei9Hx975B_FeSsrHR02HlALw
=6e7a0a&_nc_ohc=JXLmujmDilYQ7kNvwG46TxE&_nc_oc=AdquZ95U3x3wrqAmcvSGeDeOqW6MlB2f-TjHb5KLB8Daw5w7E-35ouuMsUtygRLLNtw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af76BoDUH9TVkogD93MVTRbR8a3A6W_-jqF_R_JFV1RQAw&oe=6A05CA85"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0sDbwhUDB3wQ7kNvwHTYdD3&_nc_oc=Adr3FVmAB_oudEQQNZc-zJFO9CZGdmXDXY67W9UOevWfN8NzqRyqVn1JePuj-yTuZyQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7YjV0qixSUHndke0sLCozmZpC-jB_FDUM7LTUHYWgd8Q&oe=6A05D812"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2R4y9aN6euoQ7kNvwE-ueCz&_nc_oc=AdpBjw7e-_JNvH6EzMO1PfnEda8URtIvDXtc54yiwN8KVysBQmWI8DRggAxO8pqLG3A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5mHHxC-ot4IA-zimksGG5IsuMPsMXwDmklnalKFkqg8Q&oe=6A05D504"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zo4oqmXUIRYQ7kNvwHboy3O&_nc_oc=AdpQDuVPhdmMuXHTn0YYfTbeTeBU5bwQ2srDLAJeEP2PCqxf1hsO636ap5BYgHHn484&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4uIa_gLAoioEveWxF-p_5EXhIYXxx3kU_ztPxpErhjSg&oe=6A05BED9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z9l77cfTQI4Q7kNvwFKXRi5&_nc_oc=AdrpQbUIzvePHWsukYl3ZWQoL8zHUyNUN_dwUAAHxbFYrOPnnjeR15-cVbakDpfh_N4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6equupMmUE5MuZ9btZqM8QVUK9iVqj26lh0duGx173hw&oe=6A05C602"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BvUD0P3b-RgQ7kNvwEXKKr-&_nc_oc=AdostViBkAXm7XCpvc1KSwzyIVOgZzgdLZylY_8iy12ob2jezR2xlLiAx
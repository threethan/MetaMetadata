0a&_nc_ohc=A-5aXdJ-Qz0Q7kNvwEybX9V&_nc_oc=AdoQtzbDsz0BTuuAcXiy6MsGSjChLXuWhiv0HjZL4Y9nTysdtIgGcMz_W5owOTmU9gA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX9XBE39n3XE38P2KuS9ca_WE1UaygknpjVywXUl2ryhw&oe=6B0EED0C"}, {"file_name": "pinched warrior03.png", "id": "2233739983674845", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391837_2233739987008178_5682748129040869737_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zHnM-i4kCSkQ7kNvwHuYMx3&_nc_oc=AdpookB9tfTnyQPamVsgR-ZE9jXnF9SaCUtTjNx0UBoGAtn-nNrWEz2mYSeYxkhgnMY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXnrU_6KFyIAeUvP9kON36wTs-y-sbu6qncZJGNJ2d3zg&oe=6B0F0045"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VLWkdD0tRGwQ7kNvwGtckuK&_nc_oc=AdoYzon8fQWLs48u8HVC5NNfkoD_HwrhGbak1odf8y3HAqT_eApIROBi-m64iqAKPaw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWKcpwdL1cKP2C9FMattUoHU3CyiJ4mYWqsnWvUPszS9w&oe=6B0F0DD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0a2toSxw5E4Q7kNvwFL3DUu&_nc_oc=AdrZgB7I51JFTbrCzg_N_ulDaV8D38RbK12NgAUtmh-EndtviQjdLatFFDWOOBtJghI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV4MKTjK816ZhA3SqL6KEdWxFlCHdn7I-26q-FD1tVlnA&oe=6B0F0AC4"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f4_05g6AEZUQ7kNvwF3VDry&_nc_oc=AdpLqrCOGuZ4bks3KAAoINFqEg_74EjIdup3Bmp-OFDnDN1o3KSaWKFVRmyi9cdGEj0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXWPBOYcBBnFVrUDD2wbcwGAcP3_Z578Z1s95qaN8AHJw&oe=6B0EF499"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VkBbbAi4_i4Q7kNvwF
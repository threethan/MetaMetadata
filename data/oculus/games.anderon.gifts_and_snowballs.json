=6e7a0a&_nc_ohc=GokgqXDnDVMQ7kNvwFOkI26&_nc_oc=AdqplgTR3vQelBtS4L1QtZNh1YKP1fWPXs-mfos8NTrJYDWPGTJsyQAE8NnUvmr_4bI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOJ9oN7b9eBdxEfyaWC2cipkGew5JRwZFuV94MviV7vA&oe=6ABE5C85"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UKEqar1AV2YQ7kNvwH8tHoe&_nc_oc=AdqZ1va2YVYmccAE-x5DzzZKg4UcEXQ48kdFs5CKxdpoLZOtnBbc8-QDCN5ZXrUsJ24&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLwpQCd2rGOwq1Ilwo-7MRVYLV3AJ4lvl4xktdz7i3jjg&oe=6ABE6A12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0q2Qt_1jta4Q7kNvwGi9V3w&_nc_oc=Ado4O4s6Vwccjlu1eqV38i9UJInd1ePVAxWSoMKtUrdihemVOWO_48BJEtfvkWTU9aE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjkKiEzOXLR6asSmNutdF3xOZ9e3FZSlSAZOoaqXsSyw&oe=6ABE6704"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JMftvk6dInwQ7kNvwHR0C6s&_nc_oc=AdpPJpdFF7ZHSSmZIy1opkblPmMwAfkEfjw84l4ECbRs6LwhHzMtE-ql0vQFfHoqReI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0RL2tQkUGsR1uvLbvg1hooj2UCxKaHGw9FBMHnQq1-w&oe=6ABE8919"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fVynE0HwDhUQ7kNvwGNnGax&_nc_oc=AdqdD6cPJr7CH4ZsNnysMRRGRDacofUJLCq-DoTwzT04sqdXpfd81d7XT0NwcgDeU3E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3LaZXy6gWwesrllNIUwZ-XtTkClrMzm-hrEq8MsAZEg&oe=6ABE5802"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fn0LSWMCrn0Q7kNvwF7DHpl&_nc_oc=AdpWoDqlYF-XSumwJoHw_uiNcsiZWYnso7JxHaCPG-agS7YgyR0iB92YI
=6e7a0a&_nc_ohc=iRSHkDZS4_QQ7kNvwGI89EV&_nc_oc=AdqIhfEiOtQCEkkKzFbazM-9ijhq7OkHyQZAWK8mPuDoTM3mNsifvLfbBUsjjzorSe8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOS6ehg9xEkimBIMa2QnbH1ori_0jzCKiRtRczRmrJsMQ&oe=6ACE66C5"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dcuaZ0NT0AkQ7kNvwGNQx10&_nc_oc=AdpHsVJQ0BJRdSSULGKUI_bwzylxh4UQrtjjn8QR8ZAM9FXy-2cyukL3-0f1NgnzEgY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOGKQSbM-HS0GBDNlomWShmL6dePGFkVq4CuYd7pIzoOQ&oe=6ACE3C12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aToysBFH-FYQ7kNvwEfDSHg&_nc_oc=AdpoW2fAmL3ISnrTO-KFqx7lDwYqteetfK226_U-2RgfBmoUE5SlksZQBp-HiqNj_7Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6JsPx7Mwqa9k_52PhRUN9NRtvq4aWNaaH04CoDM4FXQ&oe=6ACE3904"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mvgACNR2ZT8Q7kNvwETvEIo&_nc_oc=AdruX-Rm1-CmMVt1CcgpJn_7a-ej0WHC68xl-vib6lwiOew4P60U1c8U1uQMQjJtuyg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP327BTJEtnrjawhMRZpRkhPDrqy6Smyo2ELi7-G0Q39Q&oe=6ACE5B19"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ezR7JtOz0xsQ7kNvwE8Yayr&_nc_oc=Adp42MjlYhchR8qD1d5Ym-rwAPRPfafSR4f9NNKW8d0XAXP8KX8wcbP2Ba7nhzJpjgo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPmzw79R6JJD6mmBFv3zlcFYnJSfyUZmk_u15QskHeiXw&oe=6ACE6242"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8HsSD52fGloQ7kNvwGpWU_W&_nc_oc=AdoWNatApPecSK8l6akYyILmjpxQ43SYK4lTS-7RhQCRo0NzQe2a32GwM
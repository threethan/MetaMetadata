=6e7a0a&_nc_ohc=mT67btntPmMQ7kNvwEDWWXK&_nc_oc=AdqLJ7voABjR8Jl8-T28PXqmR4XoPznQLa2zhxm7lSbVuAh-kc_3u2l3Vr8AflrvasA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5TGnwPsWqtnif8NNA_RSFYA5wgwzHH9Ly2g9Kki5SHGw&oe=6A0C6205"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wzNyccKnzEQQ7kNvwFe-EJB&_nc_oc=AdqcaRmhUZa5ESjMb271YK6jgcP96eFg-mHP5EwbcI3AemqAJ92gW5mhM4T1TU5wTeo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7L1sMBQ4-1xfRCOEIaqTrrNm72teI_SbyDoNhGvdXaBg&oe=6A0C6F92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OtlJZa1d5xsQ7kNvwEW8Z9V&_nc_oc=Adqx4nYJSnlN8EONZ5LJDVmsVNsszj0otM4pIPPcexGC4kuoPYnEh9sHdMv8T9sGc1E&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4cToOootehcbLJLQ_fm-YKHPe6jgGix2S89mJYhYyNzg&oe=6A0C6C84"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AAXxZY9OMHIQ7kNvwG6xT0b&_nc_oc=Adr27MGTa0YVn2K6FuIlD6_F3j0IZIrTl-uaRxxFbt72LSzQMqYjo2kxKdewXG8GpM4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6JOEfBzSbVIvHnJh4lKZSeWMEVqm88uhHFDaZQupES5A&oe=6A0C5659"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KODEUY_LKyAQ7kNvwH096XM&_nc_oc=AdqH5_PqCBGBzOLuIOUS1NU7H47VMh2xb5xT7Wns3L6bspRw3kxz9MqgwmHOB1Anv74&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-twWHCIM8AVqZOwA83Iisllj_dPSAA47zNeb3c-FZIA&oe=6A0C5D82"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i7hOtjabtFcQ7kNvwGMDAmk&_nc_oc=AdoumfJR4SkZEXRByJQ3e5XPIAxdZ7l0DxcBYmP6uXGwyDAFQQsd8twHQ
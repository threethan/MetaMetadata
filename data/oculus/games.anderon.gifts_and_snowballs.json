=6e7a0a&_nc_ohc=kMwPrh75Ei0Q7kNvwEPeNOB&_nc_oc=AdrePpCkuQfsxLNGbrk44j09mElAR4inCa4ZXDhHbw2g_ELJLqR43xcuArJtr7TYBTQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8PpzHfbkTC1MF__XQgGF5Kkd4aJYNUJPojSw3K6jZMLA&oe=6A354085"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HDGKKi_RTNoQ7kNvwFORFQF&_nc_oc=AdqdwyP13n9VWBncpErN_BJhtL7mDdUnVk3HmNQA3UnJPJqPbV93BQOrzoVRFytgZzY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9U_T2d-8jciiMXWPbF-kLJFEkO8bhyNbU_OCyPpgxR8A&oe=6A354E12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DZ8fepJ-SQ0Q7kNvwFD0jMI&_nc_oc=AdpDwKXhagd6LYc1Eg_pY-OlkalFLGqaQtGQA-8nb0XCrJ-iiPckedHN5GrPCJrY5d0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ytCOKBlMVpwMoMcQchR9EUtZ2k_sf-UQzyukUjbsnNg&oe=6A354B04"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jaM8M70u9iAQ7kNvwEnN-Rm&_nc_oc=AdqIhrksaX31o9AuRrPG7Eih2ga-KHuUtTLqVt4Zc6R_UFam5g4bcRDBGWuaxpYswFQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9fyVsIMJKqYpScEkjKfts9ITI824Oyc0dNEPv_VD-RMw&oe=6A356D19"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S4rDYOkhunoQ7kNvwEBCOJj&_nc_oc=AdrQpRquoSrqGtd_M2DYwmnfzXUcv1SXq7VlR9XLwB3A2l2QSWwmrVlPB1IhIHSFKNk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ljIvowBoFc2TyDzQJJ8oD-4ZoD3mRU1Cx7QIYh_2s0w&oe=6A357442"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e1fCc6rX0a8Q7kNvwE9RCDR&_nc_oc=Adp8NQbSYdlmJyX4-GPBIUVWAcv0xS9gRMlIBTwNnvX13phRMCCJHoHXE
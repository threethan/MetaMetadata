=6e7a0a&_nc_ohc=nLrCzaNXw9wQ7kNvwEKlh4Z&_nc_oc=AdpHSsZkQjrZNwX8RFfhcmvx71-h9SeSCLYwbC9B-jHXLy9OxrAuGz_2te75Y6o8JSg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNGh362GfqMobyFtmu68yqHrniRIou_0Z3Qq1r49BnXQQ&oe=6AE1F505"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iuA4nmDFOnoQ7kNvwFdAomq&_nc_oc=Adr-MOuKmQ0cc9mhH7fIED8CkTdjYDvY3urAbuV1ChJ5GRiR4kS1h9xsSdV70GfOX2c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM1lSRfaD-yZRsr2snlPMPmqW0_GsGKNF4lW3kT0DZT2g&oe=6AE20292"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oHB3Hg1kPRcQ7kNvwE2iQ6c&_nc_oc=AdpEEGmg-e8J5JH1OWpPE8tNlgAZuZZguEwFvvrRe2VFcr1WqDnkOczdEURvBe-R91w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQORst705jPIk8oFZqI0h6G3l-c3ISHEkdz1tDb66_QryA&oe=6AE1FF84"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gIf4Txnla0QQ7kNvwGjwdln&_nc_oc=AdqNFO2p4gVXDOUBIjFFV5Y7-9muDNpn967lr8_ruBUMkDTQev8ivw1eKfZ0lcQg__s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOzhKpq8m-8tjrlLySK_hDf11v7o9EPVRHL94-rlQ5T7g&oe=6AE1E959"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=va33UG7Kn8AQ7kNvwGiieEk&_nc_oc=Adp-4ffRGodRvsFBHajusq2Qje8Qk99k7hC_9k1L48it5S8ZoPGvV8jRJyrzmiqR7fA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMwCCSO1_bb-gYznGF1f6vDGEF2zOQWt9otMqG4x7pcZw&oe=6AE1F082"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LjRIcnf9tM0Q7kNvwGwagvg&_nc_oc=AdrNCT-8iFSlZY09JeR0T0Td0DwCTtB59VKx1qC1K-XZdrXDY0y7qNAsK
=6e7a0a&_nc_ohc=xqklZizneRgQ7kNvwGTWgHy&_nc_oc=AdooWVGZR74pRySiinlfUoPp783SY4Dnes2Uf2ug4ETe4NnDHfnTJwGXTTPSnL8YiCo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYNcXUTqMfDbk48QiFimnqVH0wh-UzpGutgBZDDGYOXg&oe=6AF5F3C5"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NzwPqb3HHLcQ7kNvwEFkx7d&_nc_oc=Adr0HVASpFhHUIz2-waOM64iZCzWE6Teasx5mm8DtPIrtkn67aPSwN0-vxLepYFXj2k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSH44He2iWJzKPlALrRVjbOX3g3NNZJWDQndE1dgMiXSg&oe=6AF5C912"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7AR11O88v54Q7kNvwFz6ljY&_nc_oc=AdpyQayGaDIxUMjfUhgfMl580FbThGFms2UFDw2RQu6ZLNA4BH8_oN9q_wBmSCUelPs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvDLofy3sAWId8p1ZY9O2vIZPWe4NhhOU_Z-ranMQzCQ&oe=6AF5C604"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FQZ4Mk4OkwAQ7kNvwFQgUgf&_nc_oc=Adqm8D6b39Rp6GcWXXm8I5a7KGhVYvjfNfPhbTEjwhqVSC0MclaKbOgz_JU_-Ho3wjw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlV9ZETBF1Ynh8XroiT0RKuRdoKw0EgMiEyK9QQ_qUjg&oe=6AF5E819"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gp8sKYWnRCYQ7kNvwEoCS3R&_nc_oc=Adp3A6dv26xZLPc3sIYRCOJGdOY6bll1efHEIKuyr_ZIxiY2rBkCq_T3jQc1jA7emZU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQS3SNTaZpNSY5kK9WNR6eo6Nsf6p6AFmGsCZwxm3KIrA&oe=6AF5EF42"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sv7NxxRx_XsQ7kNvwFeAUCO&_nc_oc=AdonDM0btm3Lr-b2xCNXL4Nh8F6PZaXnNEVHhaAm3iqnEqKFUj7YOAPGQ
=6e7a0a&_nc_ohc=_IsQRr7iOmgQ7kNvwG9-bKF&_nc_oc=AdoA7cYxjd_qR9N33zQbhKbGJegEJ5F5CdpAOvj9h_zJ9q1BLvygN4jLPksPYKlesj4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1vWNthEOkC8RJp4o2AndoEaALnhJGfWaV-5qHDDA9Mqg&oe=69F74A05"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jq5I2yLaAP4Q7kNvwFFmWrI&_nc_oc=AdpJ92meSLjwjd4VrOT6waM5PzHqC_bG-gXZERgN4Txk0a9T0IWzayfk3XL8UV86rzs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2c1TyHHn4m5kIGgd78EJ_f7KAupJTvH4fGm6Hz1l3EYA&oe=69F75792"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wAQYUwhH8xAQ7kNvwEn7p_z&_nc_oc=AdrcE5pO7whqdGxcNPsY0RJo0a_i_urJ7lFibEtQGTOV9CqRX5MSpT9Gf0KGitbx7N0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2xU1rFw4QXENx6kPdcukcZIgjfYdOuZEjFZlt1-CFgWA&oe=69F75484"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7OAfc8tJ8OcQ7kNvwHjLBVR&_nc_oc=Adotgh_gtgm2Ma7SJInMYxpoVSBt3QLryVWZb5qsCqOZE2lxMAeRaCnf2NsGwYPdVcM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3_DuZ2CAwXw0giDaCfTYEtHICOoIhLLImQ3xs-KdqSYw&oe=69F73E59"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ueC52tuV5hAQ7kNvwFVB6Jy&_nc_oc=AdqqQf5ezG2lj_rfrc9VtJbDOqPqy4lqsnP5z4wyHjQ8T4lEBGpdPjrcvfc4jPqnzec&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3gKitPrSIhUQFaYasBNyLh-xPxf2mb_NuyPek04NazVg&oe=69F74582"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mTrcqV3qseIQ7kNvwEyhg1w&_nc_oc=AdrOY3EZI-n-I0wjICtEmf3agY13jWZgCsN2RPj-ORjqETDYvDtgHpc1I
=6e7a0a&_nc_ohc=EMWS0YS5vf8Q7kNvwHN4aOX&_nc_oc=AdqaPpOYeZBPq23SdtjKF_TX-2etNJQ6LE2QFVrX0FztlFaYqpKnpbtS3ok3Kc5Appg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO8KbBnjarJ7iJoQIN4toVfIgzBrXxL3PuyHJ6wjbGrTA&oe=6AC25105"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zdnJrudqSNcQ7kNvwFn1xIJ&_nc_oc=AdpC3D-GjZJjFpaVwja-aduLHHE4Mw4CM5SATICesIfwAuhF6wYV3RS-EQXskXNYnDc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJ2OA5xQF6m68QhhUwfyKB__Mw1WWaAUafUdt_6RHZuA&oe=6AC25E92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UcQwYiLTSlkQ7kNvwEkc4Ih&_nc_oc=AdqETAv_gdtAwAjk4WQMqp2T9fJYg_xAl4UNz8mT39-bVsTuR2gVuri_KnuIrmhg57g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMq-NEYqPtC3JQef1bV1KDBwH3P_KW1lqQSAR3F69coVA&oe=6AC25B84"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ms2ouIzrXnYQ7kNvwGeGca_&_nc_oc=AdqappUwTdscvidc_Usqhan6qb_da6dbRvOjVuLA4OZpDMltFWO4-zBgEP9Q6oHK8BQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMmtM-W9r7qRqmME4YW9hR-xaXpeL24l1xXqotiGKf-Sg&oe=6AC27D99"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ze4aTDG1Ui0Q7kNvwFQ2WMh&_nc_oc=Adp_sVy46FbNhgiKMtsx3R7z7mdUe0UKj0m5-EOdsBAvkQS8jRIxYVQF1Ejny3xz4VQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPVtD7FlBwOqrV1KLdyCWpeqVoWlIi9S5ZBT1TXmDmZ6Q&oe=6AC284C2"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SotjUOyj--QQ7kNvwGYWX_g&_nc_oc=AdpkVXPMcfumVjoDMLykIlbh6DhWuY3qFOwy9bumy4gGOu8DbK7ywN526
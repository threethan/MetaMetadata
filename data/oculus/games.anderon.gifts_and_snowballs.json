-ams2-1.oculuscdn.com/v/t64.5771-25/75286676_577533401544348_4203344657555901211_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ubXpSBE34MQ7kNvwHl1oLP&_nc_oc=Adnxariao5s5mYfLS-a-SiQyRsv0ch-BOzatU5OrE5FDoJwYSr7Lzq0GaTbywBa4GZ0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfznxTYtHmREVgVbU_Gl7FW56Q-53pf3A1QrmQpp-CZ06Q&oe=69AD80A8"}]}, "id": "2073760636370964", "locale": "en_US", "screenshots": [{"file_name": "screenv2_02.png", "id": "993244952825890", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974853_993244956159223_3665934591366094743_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FCkjBCBulBQQ7kNvwFFe1fd&_nc_oc=Adn5shQTHb1zI2kwDU7ZiiJOoPAcsxAx3utbTKWKV15UMHf15ZSC0x6IQ45SdDvqF3w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyV7SN4GogbBqaQm7hwgGs2uXwZm2cPxxQHz25cn4SNbQ&oe=69AD6A8B"}, {"file_name": "screenv2_01.png", "id": "517646341325841", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572947_517646347992507_8365861269156842802_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zIEL2KyZG8YQ7kNvwFtN3ry&_nc_oc=Adm9uLo8M2zyx_hfHhdVX3HPnxB9-JtGeHNQOcj8D05utvVNAYpDd7Hj4omzReINwIs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxpBLs2MkDp2T_QnX_pXowdl7vnXTEUQPwbzw2A_5y5Jg&oe=69AD63E3"}, {"file_name": "bagarre selectable01.png", "id": "987094796807741", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391822_987094800141074_5341301578934495068_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A9W-UoD88EMQ7kNvwH3TIDN&_nc_oc=AdnyfCNfXQL_IipFL0_l1qsRi1-mqOGV3T2gEk6viT07Z3UTQg45j9-uqQhx1qZHOf8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwUmdNrVrKHOWWLGvT2qXUl7TB2nYdzMR7L4v9GjD1MIw&oe=69AD62CC"}, {"file_name": "pinched warrior03.png", "id": "2233739983674845", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391837_2233739987008178_5682748129040869737_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=POWb3C2LP_AQ7kNvwGjr6B1&_nc_oc=AdnMo6FQf9s024DdgdXNZniVqPcG3yGgiH26e6sjmOnorf0lfuFVbK3zsT8LYvZovj4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxXlOHi4ts2hs6hSvjVTUL1ItOwHaDyetbLvTjkawzrLA&oe=69AD7605"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ETrUao5FuuYQ7kNvwGnbS1E&_nc_oc=AdleRQX4NS24Af0mzSwB2YXEUhU_7bUyjKTnm49Lan3Om8r2yRoE6YKKSAQxk3nLNsA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwWJ7rCNykOq5aSSBv3MFCg6V_pTMSyRSeTU6uUWUBjlQ&oe=69AD8392"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6HpnKdFDVC4Q7kNvwFeClFb&_nc_oc=Admh9IMrO1eTGbPLeG8kPga22ID2Nn4k-OAc5aBTgqFXPw5zZzxdHv0xeRQxBzU6YAE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyZ5ccc-8P8hzFtY7cvnOOqkE-RPN4v2vvyFGqQCVn31w&oe=69AD8084"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Zb0naYvegYQ7kNvwGWqZUu&_nc_oc=AdkjJlSlwl6rc2J85o8h4fvbZzrvLOPpKR2Gw06NE_Fb0iCOnY34Nru-iFP4doLim8A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzef1TN7Q2wz0yTe3GcCDHKUuDlYa1j_9_firvSKVX14w&oe=69AD6A59"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Gjssa3IyzEQ7kNvwFyYQwv&_nc_oc=Adls92gY6m39H5AHxrdGazN-SdcgWLTg9kQRh36x2yR8eMYQ4sQ3EnjuOkPYo1CgrKw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzpVxQgiTiiMHQOUaGbhM48bmKKDeRnC3y1mLJTNGA_4g&oe=69AD7182"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qmVU11r5XcsQ7kNvwFKSvUP&_nc_oc=Adl_StVj_DruXbPqXR_nAhcGPO94-1Qgj2bFGgTcL9liHVklZF3Qus8Eoh5mzY6mpGk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxbSxOPn0GVgbxc
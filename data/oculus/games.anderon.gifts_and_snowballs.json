0a&_nc_ohc=oAxfRQ-UK4AQ7kNvwFrb0T8&_nc_oc=AdpD-jO-BEsIZx7PtvvBjCmFN2ThHVv0QSDn-frC3DmQiBqRMaK-yAHaGR4ixImayvQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0JmEKfYkX7yycbW7dc4VNF8r02CzEcrwPpXsAPDxriQ&oe=6AFF1B0C"}, {"file_name": "pinched warrior03.png", "id": "2233739983674845", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391837_2233739987008178_5682748129040869737_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DCH_6wpTBu4Q7kNvwEfilR0&_nc_oc=AdoeequatoZn1C-E0tpX0NCDYOHKhaaRfIVvqO-iXpvl8pxNQHioT-Bg84CsNph3KP8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShCmGV1RBhwKvl-axdUnbvGrUs1bSX5ji3cTmg2X6LgA&oe=6AFF2E45"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AWiCvJwNpoYQ7kNvwEMrbEr&_nc_oc=AdrpfEqtaNapZc5lRHcMpC1acFDKMoC21LQBvQknziZ24kCtF8VHlWvPPpJLqVDmqfI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwNngMQKTkCgcEA0YmhacJWnHnQmHWLsBcjdRcNYHk5A&oe=6AFF0392"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l6MQxYjKDCgQ7kNvwEzQDNI&_nc_oc=AdpkrreCW-qkc3dEOLhs-AT9ELsfAk160IUu-v6fXsdRKg-tKBhbQM0bgOBt1QjW7Vs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZHUq02JAj_sQGrzBXSIozO9nG1guCQ6lme3c24xk7gw&oe=6AFF0084"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uvtCbbj8aVIQ7kNvwETuGOz&_nc_oc=AdrgaZ85LnDz-bKc03rkdMCMp_7hqveCbEvZZUo8I6LNv775YHFlcFSOqRqE6UADdrQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrUDBADtk8xUATAgWIBu7oXgPreQzFkq41G-mPVcXFbw&oe=6AFF2299"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4LgSEqx42ocQ7kNvwE
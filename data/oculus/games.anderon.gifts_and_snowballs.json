=6e7a0a&_nc_ohc=Ujc4I7m2oGAQ7kNvwEGxOif&_nc_oc=Adr2pMoN3Tyo2huNigYsgnFWfqgi9l_MYDu-NHBvXn82sBKp5FL8Zjun9mhBxYYUtVM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDMSkdojEHU1hy2oOp_Jbwp1kbKu8QBCXcznh02Z9xaFA&oe=6A578785"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GhuLHedLrtYQ7kNvwFMvuuH&_nc_oc=AdpyYFdLJcSpBWG9haBdr_TiMN_m-GiUBvl2-ph8FuGMusKApsb1jjozQTytm_VkA5s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCCj1yWMjZ21OsjTlKlZ5T6b5BFYP1PboMrfW5ibIXMbg&oe=6A579512"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JkMFZ3uGAaQQ7kNvwEyadzl&_nc_oc=AdrcACBLxWk5p_5JxY-HsLrMqdB1yyjVQRRLKzpmygyKFOsYLfcUSP8fu0oSJtoZQ68&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC0XYXuYXdOiwOu92TO1LREVFkNgyZt2Vjczo-9BcV0-A&oe=6A579204"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NyoZe3yhJysQ7kNvwHzJpR2&_nc_oc=Adoog4EUpejQZdX-hsm1VIA438KEIUx7wwd9BbRqARKcOtRVWuK_IxOZwGW9f4jpWfQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQANEtKqL94t7F4zHJt_Atr_nJuSMvwxuo4ED-8B9bKhJg&oe=6A577BD9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NpTtfAwiJokQ7kNvwFBpPtl&_nc_oc=Adqsnkd7PIiRXsSZZGHfDw4pCRiWOkgZokq2GZVjszTYYn1iW-oxqSv9JnKZsdFDrcI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQApsohdqsgz_eUfc-QehjKHnG6Jl2ZKRk5Dis4e2bAD1Q&oe=6A578302"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UX26BKJ_w_8Q7kNvwFeAybR&_nc_oc=AdqMj6VNnMR6mYUj1ue2GOKQA6Mk7Q6UrAaF5xRVZMe4SIwtxbf_moiiF
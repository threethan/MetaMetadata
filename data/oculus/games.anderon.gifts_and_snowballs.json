=6e7a0a&_nc_ohc=VtZN6ZZKs8oQ7kNvwFHgR8Q&_nc_oc=Adphot4-KqR39h7XpbumZK8FlqphJHz_-kBKWKhXfi5AKM4X2QKM4bXyHq2ocL38LoI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqCcfNFnAW30GHoF6YxKuFyG7cdg0cgQVk2EEHotycqQ&oe=6A903805"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gogbfZvhaMgQ7kNvwF25t4y&_nc_oc=AdoktMcQfxpcry_XKGT7PxFf8W8e4WZKHINIzpeWz_kMNVGowk1T3wZquwIAvVK8Dms&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHwjed9ydt_0j0qoo7pvnX1ZbdWTQ8-X-L2BBJgWytlow&oe=6A900D52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vqQPR7jc6ugQ7kNvwGgnNWx&_nc_oc=Ado1nsNTCeTGFsgvH2sR6XLX8Krgt6rnYiyOHr38YkH9YWhwQcd2Y-yJRJJ2R975ZME&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMjyGozpH9SszKkWyMiVCm68HjldWkMY_vcFxfKyge9w&oe=6A900A44"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kTrSVLdfyKQQ7kNvwG7PqfO&_nc_oc=Adrr1HiXxwqsc8PyOVlVdGuEDu6Ruuqj-_WTwJQ8GdYhUn_MJEzOCUuH0R5c217e1ig&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOXf_8Ash8kn90xs-xrO4gstNR1FiHvMsH65Ynu93-1Q&oe=6A902C59"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PBIVaA41Qk4Q7kNvwHY5PE-&_nc_oc=AdoTEtAFttFHlCoPXqTLU3KAdwBhPLMDrYbSDIQUIDQzWByjjjW7Wsg6iM8YwUWzKkM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSheLOC_VQlcSkVcIf3Zv4_FLpMidWJ8D0Pi-82rhxCg&oe=6A903382"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zGs4S_3ZPgIQ7kNvwHvvtdb&_nc_oc=AdpIrMwFauzikcTCjSvyNFlPRMXT89Z8xDxLujGl9o5YMNg4OzkFHBtv_
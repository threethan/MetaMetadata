=6e7a0a&_nc_ohc=-JYdTntUGWQQ7kNvwGpj020&_nc_oc=AdpDeG7aMjCWsuZeRNiWh4IoFq8y4ojdw3e5tdUMAeu6qfvVBqxQemCA2YjtqlOKPQk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8yu8zkjNfa-6WLHmHwHdyLGp0Ot93N6-6k_CRvGkeesA&oe=6A2EA905"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wGcViX9a_WYQ7kNvwHYIYki&_nc_oc=Adps56temv8AIoyozBpFBlZJp6b7KyGZxuhzx5ya3vSX2lOMJ0F4VxargK0PEn0Kvts&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_phvWnbHlT5961uHDx7tZaxWJ1zPnAcZZ4ycB5nQtFzQ&oe=6A2EB692"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=---GnwHyaS0Q7kNvwFhR8wh&_nc_oc=AdoMkU25JY72lvCIU907gb9R1pWbQoUirzrmoyg4bYdXTSEr4YajUi5OzUhPQM-95Ek&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8SejVegRCcA_gasi6eGMxdLhLJxong8ssAchftyLE_lg&oe=6A2EB384"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XKJKqsDfhSQQ7kNvwEev-Qz&_nc_oc=AdonvOfaf7ldRlR88jphA5sY_hatsBrVFeS8FjDO1h6mVUkP3tXBjTy53R3woZWfypk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9lX3-0HCD6mLU0mnz3cyhbv8WXsp0DXH7RuGOSusU6PQ&oe=6A2E9D59"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f1Y3aTgS4rIQ7kNvwGyfKA2&_nc_oc=Adq40fggsVhavJnbfM-dik8y3Ha_zS2A5dCi2BgMIDXPoVi5NmbYkAzjD87se9bRPGE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9vyQszzHyhhQaqEJMd_bHhRVQOZW8hGn_QI77dsg-Qbw&oe=6A2EA482"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y_L34ByqOzsQ7kNvwGNfZs7&_nc_oc=AdqZtnWWcNn22zu7rWcXrcx72TJl9HfutftvrgIYgcboRPQRlTiG4DyKq
=6e7a0a&_nc_ohc=vwMGze4PwdkQ7kNvwH23vNp&_nc_oc=Adql3ofMjBT0pT0Fpgf-SRCrf95inzX_pRzz34KB3BEW-HhXzFdVbNvELQFbz5d4aJk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2UDXyvqGxL3Smq6HFqH0vAYHJdQ31A-YWVNEDadLltJQ&oe=69EE0F85"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5BQ-h1ve25UQ7kNvwEXgxl6&_nc_oc=Adoz1lLSjTDoaymxR0zphCxM-WcaGKX8TzTg8vgfmprZHj-SOPBTbB_cv2mmsq3wTfg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3z51VNlC1mxh1YK2mxK6vUrZOzIdEY3zdnKGsQuyXWQw&oe=69EE1D12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PRFTM6vm5a8Q7kNvwH2VgcP&_nc_oc=AdqYwsxyVOWLiK1dR_XDim89E6mSBF_PJyGo2uBLZuV3-ElejsanlFkpDOBELkSXRrY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1IUkWsKjq7SPYbMu9rt9ewYf3EKnl8bwJzNZbsN8bKNQ&oe=69EE1A04"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8lnuKT9y-jUQ7kNvwEyO-Jz&_nc_oc=Adoio_QXjWhGsCdULJvU1oOK-nJ2kqHIFzr3AsNCTU2yhgckRGmvlvhHE8NQPQYjX-4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af17kaO1MzA0qfQGxPknXi7cW5kL3-UzLHJ6cPtp_cmrXw&oe=69EE03D9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XcBB1Sx26tgQ7kNvwFGdLmD&_nc_oc=Adrv_UDfiD1kJE6oVN0IsHPfMz1le8rILIp6tePF6k7n_yzKsDSCRjei2iYSZLjvCmU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af35pnOjXsZATc3HcvwmetrFycDBBiTSebaKoXhA8T_LbA&oe=69EE0B02"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dxkK3q6iT2IQ7kNvwFGkkfS&_nc_oc=AdrX8el-cx9nWzsVodPuUd8EUaL435_1GuCTSWRUUMKpD7yqJKFku9DQ-
-ord5-2.oculuscdn.com/v/t64.5771-25/75286676_577533401544348_4203344657555901211_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6FWkI6Baq7kQ7kNvwFQynYB&_nc_oc=AdlRi-hYVm4Prk7dCLSpn__DE80UoRUHitx4c9VboSSVj6vJQgb_x7xVQrSnI1HxBHw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzUSldTCw07WNj9ahO_dJUh1MLEc6igNiF8q4JQjSwz_Q&oe=69B80CA8"}]}, "id": "2073760636370964", "locale": "en_US", "screenshots": [{"file_name": "screenv2_02.png", "id": "993244952825890", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974853_993244956159223_3665934591366094743_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cunyHK7VXLcQ7kNvwHtENuq&_nc_oc=Adlq3_ZPMK2jwKraPKSVzru22obnWsSg6vQU9fQFQjCjXmd86iaXfXwZEXKrjYGy_Es&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw4XvnO2RTxJVNTffqN2b9SFfPoRkn25vcC2s1Uwd6kqw&oe=69B7F68B"}, {"file_name": "screenv2_01.png", "id": "517646341325841", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572947_517646347992507_8365861269156842802_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zkv8iXVZsxIQ7kNvwEMk4nr&_nc_oc=AdlkrfxFYvMj6rvKtphv8YjeIBHZrvLkbIR0CrDYIIWaZLLybRP1dk4Bp1clLUb-Pn4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afzm1I3Y7Y_9gLTL8TAF4Aia_-TwtGPhtMQa7HYmLaIVCg&oe=69B7EFE3"}, {"file_name": "bagarre selectable01.png", "id": "987094796807741", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391822_987094800141074_5341301578934495068_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HWdZTqltRqMQ7kNvwGSMvNp&_nc_oc=AdlY1IWWgYSJoBFOPGRiG_MPNYrJZEaOVKhits1MFyoITstzNBTONkojuXcNgPwXzzQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz1FtyKRGOblU3NGAEWfholuCVGqpdRUNToO2UifaPeGg&oe=69B7EECC"}, {"file_name": "pinched warrior03.png", "id": "2233739983674845", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391837_2233739987008178_5682748129040869737_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lAbpJpuweOMQ7kNvwFXSMt1&_nc_oc=Adn1zCLC0M5I-J2u66UzfV7a5YmHoTjLq5jDqIv6RNwIqeErZy_kXx9-4vnvUyvOM_I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxAIkT25kMa2GfzGyMR9W4cuy8OTy8mgDTTQkJX-GCfGw&oe=69B80205"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QaAu7auWCpwQ7kNvwEKl-Tf&_nc_oc=AdnJnsTilvgA_wTTinR81obhiJc1mT2OdK6rGjj4OfmKm-Ec0Nol2VNWNgTX3yKBxFU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzgULNW4YxjT9ZQ7Zpx5C-lqYt1-WqAHasneTh_zkRNIg&oe=69B80F92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WiJ3kNz9AnwQ7kNvwEG0BTw&_nc_oc=AdljFIfBl7BeBu_AlF83dAhkpaE7mGKixRXAeyFOIXASosdff43k8L1lmioxqrm0Y6Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxr10KduCzQBBV03EflkpAgh1qNrwaTwxL-MKhYXTAvyA&oe=69B80C84"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YDyug1GQABEQ7kNvwHzeqYX&_nc_oc=AdnW7Fia403M238pSCxnOFIR3Geed1qlPV_Is-JFBCAPrdzI1_C64_QZjBLMrD0P6pE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzoBGKjO-pCHkK9F3AzFaV4CKuDGAS-Uz8QVtWoizl75Q&oe=69B7F659"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qttKyaB9N2UQ7kNvwGh4kya&_nc_oc=Adn-uz5Gfr5lbiVhXEygsobjbkQt7iwE2_mF6Tq2Hfwhnv72fzj7bN7EYMRZQXnnAHw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afzpb9N0-LXnBco5Pq2tGh_XoXQGo3s2PqxxCmBkjmT5TA&oe=69B7FD82"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tz5_jVgxEJwQ7kNvwGREHBE&_nc_oc=AdmjnLLh42X4R3yI1756nCfMw6a7fmbCpKK-p_7awBRRnQaUr4s_843TM8plmNfAK5k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxKDeoaFPkJWu26
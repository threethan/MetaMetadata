=6e7a0a&_nc_ohc=pFKGixA5-TIQ7kNvwEYpEty&_nc_oc=AdovYOgKOUO1w__gli1QVMdNRXpJmIAhAdYU6gHscMn0OUjcv2HFy4xh0N5Y-Em_XsA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Dhq5kSPyOhCX1GJevupPwijT0vIWcx04KQjJGSiBYwA&oe=69DA4905"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xnnHTzhkf4sQ7kNvwF4xoaW&_nc_oc=AdrvmgjQS5rT3fOVD5spoNYNKLiIGhXwowHYTAUkFdQpgtd3LzQc9k03-gD8_sVTeLI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af210d-PEpM7smCwJCXY7JXwRf1-Kue8VMf4SiQKtTM2DA&oe=69DA5692"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ZFW6L2PqEYQ7kNvwGo_M4l&_nc_oc=AdpzChFTGyrbzIWKSLiWZIZFcQpuHr7GBB0xiF9eSeLDuzpZDPohwQyl4s2YCrV0kmw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2QTD6HSWaV78nqwqu4ubtFMy5h5PVcq73MaH0A4gcTSw&oe=69DA5384"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zFXU9AT6OKEQ7kNvwFkXKi4&_nc_oc=AdqeHDVWRyZgfST86wp3WWZHWbl7rFDaFwh4nBh3UInM-8l9m7OgD-3-kcbRK2OTnxc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af33Go9HO8PPKxZ7Azv2dsOTyPz0Kxgq9d-L73saPBKsJA&oe=69DA3D59"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iQI4bImZK-kQ7kNvwG_eDb_&_nc_oc=Adr-ivMyKJ_vTtBhbWunjOgo1DdnSogGZD1Ii57_e4VGiOX6uZz5O7jGDAiKISqZrzs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ZkWICxI-PdAoxvo9atSzTwYhzynFd3wcbZRfeBsMyCw&oe=69DA4482"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iuv40M-bbRsQ7kNvwFUKy4b&_nc_oc=AdqyP_lVDonpUCV_ZKGr6a2SH_DJ7B0Ig7_jTHEs1YaLtfW8VS6YOgwl6
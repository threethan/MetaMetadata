=6e7a0a&_nc_ohc=c9p6SJSqI9MQ7kNvwGWmh8J&_nc_oc=Adr9qvuAB3IsLMLEy59eKh8b5WNBx0PF_0CATN5dGgGe0VVy3lKoZTZdbgEfNlbaP2A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_hxZ-ohLAC84MYloxDAcDm-L43D652TupVt-OeTD6nZQ&oe=6A296305"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0tqWMa8A1IgQ7kNvwGAKeCa&_nc_oc=AdpW3V5gJmYz4IqdGJiy7NgvA9uGCzkRU2BAQyEKZigeNLv21kOULb1C4pG3r3APtbc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xh5Y7OKWyqNY-11SYf45QvfePijXEg7LcrpI9PckWuQ&oe=6A297092"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TbO1wL8FMPcQ7kNvwH2vtLV&_nc_oc=AdqIhwHbeyDqN4z_GdI7MeIE8I2sNnL4uXlRFzKSePaA9UUNN-f_jMmTT6W7A5ULb2Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_fywXVJXKoSKHpAJs2ZMcOuxk6Yt6iNS5SlBJByViTSQ&oe=6A296D84"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MeXEG50Vgb4Q7kNvwHNnOVK&_nc_oc=Adr2c8yWi150Z22LPyo8nTRZ6t9kGSm9FOgXq_bL5oJhGYaDNwXBftwUIK3soNqpj0w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85wPtDfb_n0cYkkIDaS9HJZiC87St0ta_iynJS1rYE6A&oe=6A295759"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YfaiN5lvaAsQ7kNvwFjRQ2a&_nc_oc=AdqJXM9Urvq36sRxruRi3R2dptPafzHWC16yO9DPtIeVm_aCoH9SB2sQmT4byZMHGq4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8x7kmg75Z16oJeur-e8F1061LZuQdV_rGyt8BI2zJoBQ&oe=6A295E82"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4XZEwO9AEz0Q7kNvwFQAcQN&_nc_oc=AdpB2jWcvDaqm32KfcGLuUp4aoyDTZhWKFR9D6y2WbktTJhtTRHniYFF_
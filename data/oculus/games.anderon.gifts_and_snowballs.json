=6e7a0a&_nc_ohc=ynTWqAXmHbYQ7kNvwHatvl0&_nc_oc=Adqt9fDSDmp1Pr9iJGFA1s9XWZjgySKGA3ioYzW1AUjwmQiiS36SSiQRVSJXRkng2DY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRnDHjIiaCqLczaBkhPpr1OkCpDuJsbxQAHJw-0AejA3Q&oe=6AF896C5"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pg2biRoI-DgQ7kNvwHWvQE9&_nc_oc=AdqDs6Q2GJs5rUd0Hanhggs5Lh_O6iAYjEsUz4rzsw6RAjx4ID7l3JOxgogrPduZltE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTT7ws6Gj0ZU3IkYQX1Fokof8OYmHCu5OIEsMICTSGzjw&oe=6AF8A452"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7AR11O88v54Q7kNvwF0_xZd&_nc_oc=AdqzjpqTN8DPMHCTI2_ksfDHdhQsfxgSMqRgieuKPm8r2JzkCBwbHq6vJoqQcScn96c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUlRnJ3S2niZYzURwmkfEfnZxBtqXyopvAxL2DgrFlbw&oe=6AF8A144"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_6Dx8IAB6v4Q7kNvwEr7IDg&_nc_oc=AdoBy7p5w3iGJdwN1haFZgT51NosX0IdcbYKuq8V-17qn8HPeMTfZIWm5k-r989YjVQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxyN7n7l8Td5cIiaRouE_PyplXs5qwK8AIbr3erj-ExQ&oe=6AF88B19"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XDL2jlcD4f8Q7kNvwFjODXN&_nc_oc=Adr2L2ZjpmBpgOvoQAhAAO7tVKKwpTM54BZvcwAAKaKng-RCNUAdrqTd_MP-OU25KI8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStNOzQCvvFJiCWL-7Bb_Jz7FAzGsFA4oseZqPY_OeYHg&oe=6AF89242"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sv7NxxRx_XsQ7kNvwGQVKoE&_nc_oc=Ado8UfCpRmHbu6jLnAGfyNUj6VxRGjincjQOdskbvieZfh4yPFG3U17yI
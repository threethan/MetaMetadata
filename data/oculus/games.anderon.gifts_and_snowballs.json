=6e7a0a&_nc_ohc=U1-rqP6w_O8Q7kNvwEH8J4Z&_nc_oc=Adq4TAybsAyMe6Fk7hkYbKdou90N9X7pIQ6d1xst_3Bnt96PzVg5a4ibXCfoe-jHtSw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6pUpM6ze2k8e1PmaFKCXMznccIJaQYavO2Xz_-ECeG1g&oe=69F9ED05"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hW0UjcObS8YQ7kNvwFcTDfM&_nc_oc=Adp1WRMiiMzS78eAhUvpaAayeeh6ziCkItDi5Y4jR0rz_GUmHGMDzKQPZ1uO94oyu58&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6OqHUgcgxPZNrWtoa4HjUoRmuTD7k5FxHMtveDAImWkg&oe=69F9FA92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xp0Dy2Im2kgQ7kNvwHnH5Yp&_nc_oc=Adp9bb-80_iewp3gVYIGbcA7ORtaukN3vLq1y_FT-TIZXRCUF_8ZHdHH3V2pxGzHsMs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4cWZDMGkYXMxyiPnGn3w2ahLW-drTHF_0_nMk5eAdNDQ&oe=69F9F784"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7OAfc8tJ8OcQ7kNvwHy_CDI&_nc_oc=AdrEbwRNKMhJFmIz-VzQ80gMMrQene66YRyi6pJpD76GAKDDBT5As3WmwtRiL3GiZqs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af627U_MMtstcfK1PczMHrzC0MMktOX2-oPodhMuHmBRPA&oe=69F9E159"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=azJ-LzM2hIwQ7kNvwEeM0zu&_nc_oc=Adrr-NsSPUxYDNZyVIIRu07AA_lYuea8sA7wig-Rl9QOsIEG9yPgEaYhnC7aMnp9N7I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6mDyIbcCEOma-tMeyMWNLVRugce4dUPzRxxqmWUW-kgQ&oe=69F9E882"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ybte80d1Q4Q7kNvwGG_PMf&_nc_oc=AdqmgCJZOb7XWR1AbOfYFSmLNTqmPmqcEBsrfbS6_pAc1v4GwuvZztbPL
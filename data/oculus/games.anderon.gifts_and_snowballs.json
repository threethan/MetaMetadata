=6e7a0a&_nc_ohc=Ujc4I7m2oGAQ7kNvwH-4XCK&_nc_oc=Ado00ySDZgOtH_IgtJSuMBokOy5JZGmi3nvUGBCoxn6ZpWWbJtt7taLI4tGn3uMjN2Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBxm_xdLU-PMFG-l1iIT5PcmGJIKK6HABqWJXuuFBy4fg&oe=6A54E485"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Wz3Ipl2F1EQ7kNvwH2it55&_nc_oc=Adr5VXq9rfqdJbLvZ6o3NXmsG-9FY72tDXVuGD6ytnMVLo5nfIeZvQMK51BRn8yoB3I&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDIlOHrdU-UwN0aOh61tBR0w4NEYBqM1F_xW8Y_ojfsPg&oe=6A54F212"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2fJLzBpePlIQ7kNvwEEtQ6n&_nc_oc=AdoXtzErAvYdrkYnf4UFPzf7UBsD6S75ORyr8PM8pR60Fkl5VJol7wlQdLsKZ7gbatI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA4kWU5ThYPg6wFeS7qVnL7fSPayKwZao_YOsDPQ4Vjpw&oe=6A54EF04"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KV_shWcXnggQ7kNvwE61pSK&_nc_oc=AdpuaiU2DS-QS-JDb_dBGSNvktuhtCNiby1Ng4ga8G0vHYsJp_Edcgngkv-LadkWk3s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBDaEl90ZxA7CEyhrN6uNYect-wKmqcF-Ps72I9T31F3w&oe=6A54D8D9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NpTtfAwiJokQ7kNvwFQRb-Z&_nc_oc=AdpVXuoAqtY200WC4PJPKh-Hiw6TebhTLqqm0iMh2i3tQnMvvnfBLS30dbQDr_JvePI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCoch8wA3j3wNO3abkgZvfBSFLdj01XVf5zeO2iecJ5Xw&oe=6A54E002"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zW4ItIjVJ5QQ7kNvwGEd3ZQ&_nc_oc=AdodqMPkYeC9lM_f5mPXDB1XNosmBg1FlPlgwmPnRmCPUoG98GvtdSeTf
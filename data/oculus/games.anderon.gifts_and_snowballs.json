0a&_nc_ohc=oAxfRQ-UK4AQ7kNvwHqFQko&_nc_oc=AdqDckcq4Xe9SJRHhR_L_JYIZHtAjesOamZEv-jOOUgrbo-NHy8xJg1Ma9ZDDsE-tBI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzYJlAMWxeFw94feVAAsZ4mM37tIFta2MfjzSk3Mr2SQ&oe=6B006C8C"}, {"file_name": "pinched warrior03.png", "id": "2233739983674845", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391837_2233739987008178_5682748129040869737_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DCH_6wpTBu4Q7kNvwHIKXFr&_nc_oc=Adqh7T2ppcNQ6tBRiTRbG9B48mF7HblMh3N9MkeIDJP2_-CHFyMhgVdwpiCgZCDhwjs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrRwBVxnSR2N4yc337gIq0v_ZdSpDpFUNYW80PWThB1A&oe=6B007FC5"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqH-JiSdO48Q7kNvwFpTHsQ&_nc_oc=AdpckQchCsrkvM_zEJCAIy5nrWZlxZDcEHBkpPKRR137n1lnwhfPXCs3WIkxtaJcyRY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwSJW-RhGN-NIVQX7_vNj0lSobY4ahCT40iD-M44qbQA&oe=6B005512"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l6MQxYjKDCgQ7kNvwH12QaE&_nc_oc=AdrVKCr8Uq5AuyIOlLttfGJcFVoe2_S_lMQEqDMg-4-2I4QgMl_qoNH_w0BL3w-RrzU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaf24LdBFrIs5pdjuCL5wbI7ol4vqP-jU9jfmBL6Ah1A&oe=6B005204"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bgurPaOa7YsQ7kNvwFVaPzI&_nc_oc=AdrRHSrSMW1Gsr6_esCbzLpHXOr2pxpX3RytvmP6noj9uCiFX2V1BueugmF6o7JMAD0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQt-FnQx-EBUGYrN-MDl3kOjg7MRyO4HDXhL_-53m3oDA&oe=6B007419"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4LgSEqx42ocQ7kNvwG
=6e7a0a&_nc_ohc=wgRD0kYqw3IQ7kNvwGWsnGf&_nc_oc=AdquAqGZhWdQXO1gycegb1YoBvXW2doRPr24TSPXM4Ib3cVeTAM4aqZgXaqdrp0FWjY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQETh_5YW08HNw0o6hVd2FcS5pteP0kg3TDIOmDE1k6rdQ&oe=6A8C4385"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vYLkAJdUqLIQ7kNvwHslXdf&_nc_oc=Adr_wC968skbn1irVVkqC_KRfybQ2_slhz1K22mCH2vAEMJ7o9yQXz4_rEhSzReyAjU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGN_hR4kxhkidoGsxCOVmBNIS2aBkd559Tq5YHHzTWW9A&oe=6A8C18D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c2X2xznNE9wQ7kNvwH6fSRy&_nc_oc=Adp2J_NmGuS4VpEVOfWC1O68utdN63xA42glRHRZXPP-MCXFGr8mbfWptSiCXNOr_18&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHq5JXUC2V5rDY0LTFsrTGVghszEX8Ppj0LaSe6KWSp5Q&oe=6A8C15C4"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HTlVaaQ622wQ7kNvwGUi3xa&_nc_oc=AdqQ4m8im5r-6rznDqQnyEftGzzH4a4NnNbi84yrqD1pAfidpvvb80biF9HIIgm5LoI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHB2znPIrUk-7pHgAVN57CX82XAArVcOSON5iEcrxKfbA&oe=6A8C37D9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OA0TlF9w-aQQ7kNvwFNAEGo&_nc_oc=Adrv9yvcL67lpA7rhM5FfaDwSwE4WFklMrTwcOdY4D8essZ2V8YMcUjPtZVpsTGgQvA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEXBr_cvd-KKadKYLIwG3HPJKSIWR3LwTnyTU6dAIunkg&oe=6A8C3F02"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R4BUXElqqbMQ7kNvwFeFpI0&_nc_oc=AdqsZyMkCX3-9zX0LzYOFYAeSI37cPuNUPz-96vpqROSBei1hye09_7Ib
=6e7a0a&_nc_ohc=C2K9hC_EuvEQ7kNvwHNQJf0&_nc_oc=Adqc5oTnyb7vqwMckDAFcFeAnVdznR9_HljaRXr_nisfmjW59w0IcFCt7YhhR84Y1tU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMnj5xXgDkq3LnzMXKbYApY8C6Qo8V6RQakOHJ86Ye7w&oe=6AE73B05"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wTxFPED3UjUQ7kNvwFVMkUb&_nc_oc=AdqF0t8aONyvT7hz-fG8bTIM6fSZ1N5afdB-3ywYVPE4O-8HBgPwMjtKj-ChxUQP91c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSt5apvOu3tq2xUEG2XCLOg-yczdaF8k6EpC_6BCL72Q&oe=6AE74892"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WpbvFmzdMY0Q7kNvwFKsWE7&_nc_oc=AdpAK23M5JCMpIOWq1DdXG-arfd430fuUOHDOHYxQ8Ix0G_MsCkg1J22DCBJ7zVfC1A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTE2Ranmqugo8oWf67M7d0IZ6FApeCxBlEDO5uwA-FQCg&oe=6AE74584"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c2Vr-_rHUrEQ7kNvwEM7Ri4&_nc_oc=Adopy5K3q01u8wd1rg66OdqucjoR3bc8OD53EIMqlLHa0UqXn72C6oSps6daTahmYe0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBtxJk0ltNl1p2NK8Spv_25JmNdclwib52_2aX4Kgdbw&oe=6AE76799"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DzJMFHKqQ6oQ7kNvwHNI2b-&_nc_oc=AdrU59leGmW-yd_skAGf662z4Ts2LCR8XIbmgErR6PGWFPSelYG2cJqix6TkO22hF6Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQv2Z2D_OyyYRP-BqCWH5iuagGqmO3PmNOT5ki-S161cQ&oe=6AE76EC2"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4jRYY2ATWBEQ7kNvwH_plBR&_nc_oc=Adq0PsQ4Tovd8hgP1dnXo9EGeSShfSSSRdbIbyGh0US6ea98QMUIjkv0U
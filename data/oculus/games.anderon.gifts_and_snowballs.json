=6e7a0a&_nc_ohc=qQfkrXwIK20Q7kNvwFojCPw&_nc_oc=AdqsFyDkn_8DW_cz0fxE9EkNpLTej3gvM-clOc2QwmT33Bh0lsGVUvmI9t-iNPaL8Nc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1MOG0JUk2040mnoa4YM80uw3fYP3MoUMbS8Fu7NjUTTQ&oe=69D7A605"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bc5ZzqxCbbwQ7kNvwE-rUOP&_nc_oc=AdpZg9i479ccHuKsd43S3lpgH8fFbakZibGIZQlQ9Af05AkUrSKf3zNZGT93bG2RKtY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0hDYtScFQko0Fp7Uf9UOQUXDdjRFGVDV34_ZJ3Ve8hfA&oe=69D7B392"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hywliEN9Z6YQ7kNvwEzJVsK&_nc_oc=AdrXZfM1xEAg8kNOMLFO4SdhXVOX1_pWrFoNcrqrXif9YW0PtlBPFkNuu3rL8MP30s8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3q-j8GY4hKaRQlq5bA8J5tWeSUsncsuJQOthHKaBTbgg&oe=69D7B084"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zFXU9AT6OKEQ7kNvwFS_wbX&_nc_oc=AdptGP_51k7rQcRY0lK6dc2dZgU4ZP3QuCxXuxewFqnXoK2FiiVShIwbcCjcU0r9jN4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0oORSO5S0EaE2qkXyYB_JhgSLvaqhRHuX5BebSxXQiRA&oe=69D79A59"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3delMX0sfYAQ7kNvwHthjH3&_nc_oc=AdpsRNKTIC7snt6rHW_1JLqXD8vDyVC0aK_XOtQl6qTPDLnHNKUDlX7uH2huT4k5Dhg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2NXhtL2adtZcIIy28PjxI-QaVazbKex53syoVE1CQDTA&oe=69D7A182"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JZf8XJz1SvkQ7kNvwHsvK1l&_nc_oc=AdpM1jIS5wVdxmgKgZbc3kl5HtDHPohev_8t15r0VZt1ewUwgBq-hlNBl
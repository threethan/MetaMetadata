-sjc3-1.oculuscdn.com/v/t64.5771-25/75286676_577533401544348_4203344657555901211_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gsFtRXNqGuYQ7kNvwFkBiv5&_nc_oc=Adlc0pygE-XeuHQOGXSWTbVRH900BKICB5SS3ymSZSIkOElLgMbDBlC2UbutPUSgrUg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfweAMd4c1fPS1SoYXfa7LAZn8VoXoDq_WEzvO4jgPIHng&oe=69BEA428"}]}, "id": "2073760636370964", "locale": "en_US", "screenshots": [{"file_name": "screenv2_02.png", "id": "993244952825890", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974853_993244956159223_3665934591366094743_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6VtG9htKHrMQ7kNvwFGGEWK&_nc_oc=Adn14ni9-kv9UuGRSyqcZwxfJexuaQxu4Lm16aN_CPL0GbGHTNCdPgUCWTZ1f_sfMKY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwH_xjPnuySg2FMeP24PpOFp6jKihDIKIDtEj6Mp91cnw&oe=69BE8E0B"}, {"file_name": "screenv2_01.png", "id": "517646341325841", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57572947_517646347992507_8365861269156842802_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VgFNCSb8AEAQ7kNvwG98EBo&_nc_oc=AdnfhtnZKrzFgd8M4hv2JjbyNV7XF0Y_8Kx0yaqpoRgYESVIlhkQTfe2JAbJFS5RDmA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxAk28BJ9pO1yJI3w_Zzhw9pl7oq0O2l9KOZpXb2h-RfA&oe=69BE8763"}, {"file_name": "bagarre selectable01.png", "id": "987094796807741", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391822_987094800141074_5341301578934495068_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=99QA98T_7JEQ7kNvwGSCIqb&_nc_oc=AdlisysxdaAaskQazO7NzzhVgE_HmDU_UqtHSRGDMz8sJLw3c-H3d8tRhvkttfAwWjw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyjkTgDUa5seCLPj94X0j2gU35ipD-zesOufgGVOygxew&oe=69BE864C"}, {"file_name": "pinched warrior03.png", "id": "2233739983674845", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391837_2233739987008178_5682748129040869737_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z5ZlXi-NWkoQ7kNvwFphtJD&_nc_oc=AdkFnweuk9T8k5w2I21_cRuFCBau2lS0QZlHqgdVltAKU92oTe517mYYYbbJdnduEJg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx2GEuU6UyEsp-0DHxs5yw_tuDfSWZ71YaRBmN7YZczkQ&oe=69BE9985"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=upn3MXREkpkQ7kNvwFYccaM&_nc_oc=AdnUQlH8ncHxaO3NkPUqlWDg2wRB5FLvAFLSfC_B0ZUtNSl8-oj5NNTxZnuDR2nnwM4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afyh999Sk2u89fOtIDisfRnFxVmBMFxSYw3letyIbSXNUA&oe=69BEA712"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Vo3jqHfmOUQ7kNvwHqVazP&_nc_oc=Adl80LwGnCYH-ai9_SsYypsTU4t_H6qVaLMH0GS4zsbGJF5SOefuWNqWPX0dkccjwJg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afywagh2rVBmWb5jlL6nxVfPISvtXlNDX7EgMGMgRc4Utw&oe=69BEA404"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JBYDVHAaUjYQ7kNvwH6onBW&_nc_oc=AdnlAskJEmsCdm34yWmBZFi2U9HjY762b1JyiqXBd-yy4Z7sWgJxzTi3sq1FGDFUIvI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyGHd1ROL1JaEPidiCOGX8Hzd9iWOfJVadlJ4xnkSfXfA&oe=69BE8DD9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r8wehxTfSYMQ7kNvwF-0fRO&_nc_oc=AdmBfFV9SX72xbbOBSvetkP7Vh2DPofVxZ0-3mEpaYXd7YiYQZ4BToTdNayEW2bVhAw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyUjygHHhaPOHLqvXaFdITKcHSKcSpeqV7JPFgNjYMOKQ&oe=69BE9502"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VJWXyfhMNBYQ7kNvwFG4b0T&_nc_oc=AdkMYMf__kjGCOLYbZFXNsoGDW0NUIcZApXj0LKlPMSDr52CmJupmxcqRJOCkFOxOR4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxIFE_aFdGJTz5e
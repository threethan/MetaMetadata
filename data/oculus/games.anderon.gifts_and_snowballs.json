=6e7a0a&_nc_ohc=5BSk01a-d3EQ7kNvwE4ryrP&_nc_oc=Adr81FNMRz7h_Eg8gkB8OLrZiPLUsmrSfHKRwH6WG_beJ_PVoUAw08aQLR9r0ycG2Rs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWYMJ_h_DmRQ8ld2ZhMpLJNRgrctQp40mwxRSr2Xpr3A&oe=6A9C1585"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rQfSjjofFQAQ7kNvwFWCtqj&_nc_oc=Adogbu_8_tqksFd1Nj7_1Vfw_0MSyj9x2JOfyLQ7lskNzSAISU8EoIWVpMktB7Yb7X0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHzHVKM44av_BGhitAL1yr1ZKfNBZlpPRXi26tZinsAg&oe=6A9C2312"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ot-gT-LNNEcQ7kNvwFFUxpv&_nc_oc=AdrotRF116TjxnP_im-fvsVgz1pmUW-p0oZiaFDhO_AUM92ZTIXD61PBpORWLTRhk08&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKoHY9innn3_LowvH2qOawcBlycwawZi-pCVeDlMZq9wg&oe=6A9C2004"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=piC0YsvT_kEQ7kNvwG5Z24y&_nc_oc=AdqY4ZHexM_evLlAHHGf6kFL2ljeWnnCUmeTogKnzyNoMZwGwrZbGFUquTb7oR97fvo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0OwZPPGRNXRrg0BfglUTzUUvdrLd5XtYxQ_BWMMSeZw&oe=6A9C4219"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QwNRY809WggQ7kNvwE3tqp8&_nc_oc=AdoOLHTgxMrWPeQP0ZgkIEYiSzK5SeSHmvuaLXK59wc7Wiz32vxE1MrUiXH6x3xpiL0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJGK-5HE8kGEkO0jBKAS0Lb55zi-8TEhEb7jRhMpaFig&oe=6A9C1102"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XB_HWhyPcjYQ7kNvwH17oZH&_nc_oc=AdrKkL1vjRxv_JMKaA3TId3NjRXeI2moh4yRpiN7ZybQUoVHIvVvR79l7
=6e7a0a&_nc_ohc=-fi4RqJxHGYQ7kNvwGap8Jc&_nc_oc=Adp5E6FAeplPdn4T6apnZLNpYm0YvDngTOiK2oT9dyJ9sS4IN57Z4n5gp4g54HtF7Gs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5bH5b7V9hCg4Pw_HnDbnO5k_rU6Jz9kipIHWX1wXGS9Q&oe=6A047905"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0sDbwhUDB3wQ7kNvwHJe2w2&_nc_oc=AdqUziInqvlf0U2upnzBZ_-xKxDqKMk58xhY_ZPM-iTDxWsgNIu0raIZeuii2z8MwWY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7NQp69gOAOSga3DK1KnupjCD4YWsldvGFkZcwl6oY-aA&oe=6A048692"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2R4y9aN6euoQ7kNvwHvxPDj&_nc_oc=AdoC3LVves06-4I3QNzEBHcOEruIm9lov1m7ovcQB2WMzHfMXCTkFTpuNpyUDaz8ZwM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4I0Y8qPEZn1yHM-g1sf4lxU3FqVxQX4_7aElUaNUYy6A&oe=6A048384"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zo4oqmXUIRYQ7kNvwFy177p&_nc_oc=AdrS6SmfhfoyGk4m0HqLIxEQmkkcDEL09yd_3-zqE31vk1VlK8ooMZl-p_wXQ93-hZ4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4my6C0d2usF4gisIQdf5ncBl7FKsNnDr0xR33DkHeBHw&oe=6A046D59"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-E3iBoFdJTkQ7kNvwGQYDI0&_nc_oc=AdoceS33kl3OzXi86uLJR9LMcRDjzY3qKlQ6hUNF7kcp4sLDDscmC98XlNjA2MX6MVc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af430bY3n7qMJ6L0eTxxkA447gaulld79GmQVi5fYNA0wA&oe=6A047482"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BvUD0P3b-RgQ7kNvwGqGjuR&_nc_oc=AdoGoC56XdV0GXz-O1aBmmD7MbYf4a-SzReFOiqdnQITE5T2vQWnmHox_
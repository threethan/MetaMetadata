=6e7a0a&_nc_ohc=OPaSjPl4lOkQ7kNvwHeiITR&_nc_oc=AdoiA_nkTK68ymg5Q6AhhP9x76jtwp7bT9DrBFpl6U7586QKNa5sTHEf5NuJ7GeVK0g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLuGh1_RiJMDWwHk8W3Unm0EBwlmCMACFapFJQBnoeD7g&oe=6AA55005"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2MrgivPOHaIQ7kNvwFUk1hy&_nc_oc=AdosJH_TzVZ1A948gdvEjmj9WqGyBRU_3GXlls7nMAr8BRV1uX8ZayCBKXbaG7KGB5o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJjf6N472EtHGagAFvOmGc_MoIfvCv5eNGjQa3ePEZ4Q&oe=6AA55D92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XCk937HwlBMQ7kNvwGWl_vM&_nc_oc=Adpyck1kPNfmG1jYTXQp5i7lQ7tEG0y3nXSOAYRF3btCzmJghmTd8-nT3TZ45BtFqz4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqPLFHbcEnwKmSjgb8Pk9lj97BaoEvNSXyJ8nD2uVyWA&oe=6AA55A84"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tCdzRFaVfFwQ7kNvwExhjFP&_nc_oc=Ado4nTcGACDZ91QviOZFZfTBGbX2linHQeOiGwE5eDVm7Fm6IAf2Z6jtTA3rsuJKazs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIirV8SkuFItO02KU6x3S37-yh-PhpoA1RD1NY31hvpXQ&oe=6AA54459"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3TiFGzShbKsQ7kNvwGOBtS8&_nc_oc=AdoGmwblYqqNmrvqZHjLU1kKCQ7rEhBwrV7YCG7EPUsIj-ZJAUZ-GlsIp5bkQFKEkS4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRDJdOwgXcqrn9ekV1LHVxgLDavg6puYiZfxlE57JHlQ&oe=6AA54B82"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ppKT3O50F7UQ7kNvwGRuhEn&_nc_oc=AdoHXZ1qZkDumHSc9D2cqw11RokYt1TqpeKZuaHbVKWQtzdOhyd2-V4W2
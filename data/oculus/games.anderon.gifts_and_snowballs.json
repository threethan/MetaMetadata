=6e7a0a&_nc_ohc=b7mIP89PxYUQ7kNvwEkSwon&_nc_oc=AdqgB4vVlDm7BKQHwkna7RCdVOZkTCWrz0AWAtEZvUaRLwOg6mJPWS3u6P8RUPyJKA0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_xwQaDXJxG5RtDWIeZDBGZR3gansyR3UmsZgHqDu4vJw&oe=6A314C05"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cmlxonQATDQQ7kNvwEGDAzF&_nc_oc=AdpdBqvoGkt6wTaNJby3KtdYvzpVnxadXege4c5HB6F_9YOHI3-ARza8WMcQ9DQ9tSM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9JkaBqXJ5bqEjbIEYZCRVscu9xdW1FqQnxbUsBwgOtrQ&oe=6A315992"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lZWCeJzNYvoQ7kNvwG4QSBI&_nc_oc=AdpTm8-gWxzBn07TN7waYlIz3Qklkn_iKl88N6Pn4z3rrEm5yI2gI3Sh3ejXdSZlhf4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8mBUcbzxy8X2U_PtNYJiX1dJ2_G0G__DF0h20kT8qwKw&oe=6A315684"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XKJKqsDfhSQQ7kNvwFMkShg&_nc_oc=AdpJ3VV0KrDAIz9T2ZcyBXDfgtTbBebP5XJg7Tz9GEsSj5befq40dI4yXsMRr0Q-4fw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-apG3zA4vxaT2FAnncmlLRWIs7yDt3sw9MkYFMTDqrzg&oe=6A317899"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kHvRFCuz11MQ7kNvwFxECc9&_nc_oc=AdqrZaf5L1j8DdfXAmrLQQj0Ufkkz9NvVnDu8rGO7PqENH9qG8uucKNeUfneoCPwyQg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0AVnpFbWzKPui6ASEyLlFVxDSpFrflxh1FJkEJyUr1A&oe=6A314782"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7y4_edPeZUUQ7kNvwEOEweD&_nc_oc=Adrf0xGNvwAML7ujNq1d1n2E27ezABOv7-ciMAEhvAC_F1uiJx5cYiWBc
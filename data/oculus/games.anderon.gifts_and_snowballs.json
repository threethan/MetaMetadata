=6e7a0a&_nc_ohc=nLrCzaNXw9wQ7kNvwFVZbDK&_nc_oc=AdpOm4W22KLmq2ZmgsD-IEpo6es3suM8zghvnellmxzHqHnLzJP1GA8BOoSJzF_XipU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOzXN5MvOjfayo35VAksQq7zwjIw6TPWFX9_UOkFmLLuw&oe=6AE0A385"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fwgBe_ARh9gQ7kNvwGHmF0x&_nc_oc=AdqSEBhpHLRIVju22-IeXfXBSq9Y4Kx7BORkDiuJ3lpWHAf-euv-k2kDiyGv1g2vr90&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMevCtlZFpDf_vqruFK4CZDSjCQQgofEsGz_wJgx1zcfA&oe=6AE0B112"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R2gj5YnELTMQ7kNvwFS2JQy&_nc_oc=AdpUvL_5MfLHoas9FtBe7Hao-EkEfNa-MuqzwriTz4mCLxRVUvr5t9uKj-VMjahKo9A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO0elxaGbi8ztH3enK-gTeFQylwh_XyqlSZ2mJ4pM6LNw&oe=6AE0AE04"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gIf4Txnla0QQ7kNvwGwDeZn&_nc_oc=AdpU-eucZQNu7w3u7Jf4AYcl3pM5nE2k0cmZuhRWp0OpKq4SmHP-ZThMZwoV9nw14wE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPTSqXow7YEFVvTYL0YErYagAynqwKnEnSyAcpc21hlag&oe=6AE097D9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=va33UG7Kn8AQ7kNvwEuNLvA&_nc_oc=AdoGikGZTCxb2W_yWyzliyEXwJOvS4gV_UeaAfZ_zN-m0HzYvbNCDFwESUWqfM1GCGM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOgpPqZdz3YEy6fiQHOU53fKH5jmJy3XtBwwqI0DiJjuw&oe=6AE09F02"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9_-L2bIOGA8Q7kNvwG9tIba&_nc_oc=AdqWaLXH7AtdsaC3dndvNjimpFxRiDOWIaVAf4oxUdl_QRuLd3cek89j5
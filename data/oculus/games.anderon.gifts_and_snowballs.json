=6e7a0a&_nc_ohc=3PDxvHcrlBwQ7kNvwHo1171&_nc_oc=AdqQoVEgS38oMsU9lEhZasCIXcDt8T1syrE3vQ_RDA7-9yahOo--ZMvAAHuRdnQmDlU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9zvIrvC3XpazMKRJ-RhrDuEaAJfJMwQFw4xEuSwyed6A&oe=6A26C005"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9fsKev3AGOIQ7kNvwFHAFYm&_nc_oc=AdrdMyTb2fkakTGWYbPZTGKRZGq_d0AN-vxUr0Efoa4F67E1fhdTEKXMtW2oRTpxpQA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9jem2mRtoQKU2L-DQECWrXtSp9Cugd_mgnCzU1GlPhnA&oe=6A26CD92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2i9XWCdXBfEQ7kNvwHK73RY&_nc_oc=AdpbhKkDoWN2ZFFxqYXBIrQRp2RK_m3NR7hrpzjGZ1EJ4X4AiKYAwBu0EuXmC21y0ic&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rs5mJShSKDxS1uJhl4KAi5goy5l7LDd3TfqqgDE1Jow&oe=6A26CA84"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MeXEG50Vgb4Q7kNvwGHmzqp&_nc_oc=AdpKoKfMcxoaUgNP44tLh3msKuvthi4Xh8iRp-uRprNmAyGTJM5CG8t9HST6KwUhdK8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-QvAew3xT_hte5zc9CEUVKalSsD91v4LqY4HuciBdetQ&oe=6A26EC99"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d3njX37yjfIQ7kNvwGb8Mhr&_nc_oc=AdpWULTQm8sRrMbxjzWSGr7ti8BO8ilKW3NMIhE4Afe0AE3OZcY4Hm-e7eOfocTdql4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_n0ssgiERD3MIvHLwfbOO0j04drbqguqjO_4vOek7JRQ&oe=6A26BB82"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KQl8GUPODCgQ7kNvwFcvzgE&_nc_oc=AdpIP0zQmZJtlymYp2fy3x8Rm6JwF5mfutem6tZ38fshv_YBIDcBP5fG8
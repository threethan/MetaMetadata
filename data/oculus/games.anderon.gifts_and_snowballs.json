8&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5I1fH99ZkhQQ7kNvwGkpIsW&_nc_oc=AdqXyQ2jl9RS4uEvOftTxuCFO6dwds_q6suM1c9yn9jc-2yQGKpg6TsGvUpxNwMYz_k&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4ltOBnCWtNa1wJ0VyEZ-L8SmlN8yXIvBmRb6Po-vZnw&oe=6AAE8A85"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lcK7Ax5UDVEQ7kNvwEaSU_9&_nc_oc=AdpVAsFj2uBUvzqU_k0oKZx8D8O49SwAYYSNRW1VJRu9tfozGGyVNRyXgJSJ34qjMXk&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKDp4UhipfyvW3mzMYc6TgH5IYZQrlz67ZxY137TTPsMQ&oe=6AAE9812"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-zF_8yPpxsQQ7kNvwFS6729&_nc_oc=AdqXbS-45QNvmW8ei48x2T0kpl3xyNGe_IVmnEg_VKGAAp92JKoYtfkBWmFaMbwqAqw&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtTS9hM1eCnLGfrS6DV21pSRN7m30cdJEcR6yNNnQH5A&oe=6AAE9504"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X-bd-0kL4RoQ7kNvwEIbb2R&_nc_oc=AdrQjUSCJx-m9B3DL3IJ32N21-sN4qC3xd2NF9UjhwKNksGRrHlItGWTi-2_FVthKDk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQTIg4GKksEHyy08ZM-TB2S3KIjk5F1tEpQp_r5_A4Vw&oe=6AAE7ED9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=684vV-RvHE4Q7kNvwHAo4Or&_nc_oc=Adpsz1Ft4lRYBjFZAchmToylrWjkQZzEIHccA1d-Tbjhyhi57-hHZ7CMAwULw5jSl3w&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLRPAIHyPu2CViVlE9MT26XCD4NPp7gRLxdmxpy5jq6jw&oe=6AAE8602"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KKlqKi-3-iIQ7kNvwH3TZLi&_nc_oc=AdqLpt59DIrAPGa7ciU4Wu6hgecggZB862
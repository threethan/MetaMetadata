=6e7a0a&_nc_ohc=tQ_PHyFGFKUQ7kNvwGFvimb&_nc_oc=Adq-Y70IEFdD8pWoy3OMldv192cU8N6ImvX6m-aVMMTm2yXH6xII1_wRrn6-aosFFLg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGAslvljj8JWjVowG5HJ8eunQwCyqvqVOjNoNLLvm55DQ&oe=6A8AF205"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vYLkAJdUqLIQ7kNvwFprBdo&_nc_oc=Ado_Irwej2QsxYMS9k6GkNtOSBN_L_drSgcIHgbRiddy5XFeN3uTF6PfXgX5dlUl-n0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH1WpIbqBkafqsOr2FmRdWFhZee1sQstrNEWBSAuzgKqw&oe=6A8AC752"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c2X2xznNE9wQ7kNvwGGHQGn&_nc_oc=Adqk9LNgjjXCdilineAUXkbdgRXtndDT-FqZz4aSiZUhp3a-6GsLU0MNdRr-dGuRaGs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjAuPAU09teguv_3TPDReZOkwpyUt7Hg4X1glph0aDQA&oe=6A8AC444"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HTlVaaQ622wQ7kNvwGReNc9&_nc_oc=Adp51H7ZicBlObJgKuVym8p9Tr6UyIU7zKP2J-3OvniHnhj6xeZsUaJu35zQ_ffqXh0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHasRl4EZI9omfNAxDmX4pN6IGv8KY85_mh7pFjTCx6aQ&oe=6A8AE659"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GFb7kU6BjZsQ7kNvwE0wsLx&_nc_oc=Adri6dBww4-MbU4HyUSYlmvwK7saWCicXYIn2n12XZvYx06QvnDCWCsmkDUIIlY6TVk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFTasEUpFq_RQL50qrsOT_JCtL9QFgMv8vlAyFYahCT3A&oe=6A8AED82"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R4BUXElqqbMQ7kNvwEEVvOf&_nc_oc=AdrbCkS-MZmgsGM332FeFs_BRn5mmlIwdT2BxBBuM5X3nGwyPqXv90ztw
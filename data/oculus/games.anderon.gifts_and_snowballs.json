=6e7a0a&_nc_ohc=63ahgwnp8LwQ7kNvwHzrAk9&_nc_oc=Adrj8T9OBtyzd-J0N4iUm98K4c6xU3B8v9DA8wZHAcN1CEwdZRcQ5JfneqebgcSNing&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5sxe2MymFC-zkSIN1XLV3TZpl_3VZkomTmZW_BwtAMvg&oe=6A1C3405"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pogbREDvEa0Q7kNvwFJCZPE&_nc_oc=AdqPJbD6v99C30xm3vhTWny2xca0V7Dh8VjIgZl_zSdjI4PXRjqqKjEUho8BxDkh1Vw&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60EWBV6CG_-uFFWoUx-CHgUXbkjlK-EOl86qpFpYaowA&oe=6A1C4192"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JSCxH7y5e9YQ7kNvwFkB5HV&_nc_oc=AdpZ90fJe6tF6-5LH9XLmURUKNuLdpQnTgzNvjHWFD_IkO6qSzcuC0ituYtzobJdArU&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ET5Cf0VYJ5epD_F-D4U_J-gkWrEwZ_ZraNiNOROnv5g&oe=6A1C3E84"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y4Ln6wOBs9IQ7kNvwFhGBro&_nc_oc=AdoKMrEVnSaOeRNWEa8xvGB4nyj-vuKcK8ajqlmzVFuA7RSlipBcWk6fAvNFxBjCllI&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7rHsgFVxKiflp87oNAc5mvKQsxselxpDefrZd5m5a66A&oe=6A1C2859"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3H6Ibn-M6REQ7kNvwFacZsr&_nc_oc=AdpXKbPiAlY7FdM6CJZ_ko_UBjNf-wtxwCM42am_c8Bdm0jn7YBxEYmdOPZ1jUQDWEs&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6wkJPGBTERz10OcL540DJjvkmFlP4vG6RG9Ph5NHtJgQ&oe=6A1C2F82"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vIVNn_KubI0Q7kNvwGfOnq2&_nc_oc=Adq1Ws9q_Aeeh594k7VEI3NVh-BbbCoIQ6X1O3wVtALMgmJfDDA0z74mU
=6e7a0a&_nc_ohc=nHpRvMucAvAQ7kNvwGr6g5f&_nc_oc=AdpTWZcKU5Xi1osLUHfaxxJrM9yCWHvqFnLztGvA8o-zVzENFdXzd3AwUzJG5XUJxhs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBV17oNj2JlNT-PzFtlKdbKoVVisC5XhEIKQws7Xv5EQg&oe=6A58D905"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GhuLHedLrtYQ7kNvwHW5TKs&_nc_oc=AdocPOmO7Gk3RwoYwpkWxL0CsDSLRtiNV1kRt5LTm0UbkMwvyWOlKGvfzEFjjZfxw4s&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCaWEmJveJOqlOEvTRzwAZnaeVL3q-gNwuhXf4SYJuO-A&oe=6A58E692"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JkMFZ3uGAaQQ7kNvwHCC-GE&_nc_oc=AdpgSGl_huq17D7GFcgGhWBGkxvUJ-v1GgM8qsDn3nBpjgAg6cEUy9CN6goAW7aZQ08&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAtnSht-RiNZ10M3GoWvfgE94DJQ4Fr2EKXJw_744PSeg&oe=6A58E384"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NyoZe3yhJysQ7kNvwE0PqwA&_nc_oc=AdppGyebL7v910wg1gi805F6Ru5jGMaEWTB59CzSBJIlZgYQc_bC7_0BkwFjnz9R25s&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD0zuth8JEB9jNNUd7va4apT3ecRPf3vy1R3twJ8VoeWQ&oe=6A58CD59"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2XCOgyYY_m0Q7kNvwEGrIPB&_nc_oc=Adr2Gvy7vO0dJAd_7hJ7mLVM_xNKw8Mr4A5ZoZVpmMt39BnM79pAYJxL_lo6dSszMoQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBzQ6YVAIaVClj5D67FGtgPdk0sujw9JQCMPY0l6Jz01Q&oe=6A58D482"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UX26BKJ_w_8Q7kNvwErja-q&_nc_oc=Adq8WrcbASjfpQIlvH1-8aI52c5NtGaP0dT_MPKKsBET6kewvKGsbPeac
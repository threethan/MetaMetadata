-ams2-1.oculuscdn.com/v/t64.5771-25/75286676_577533401544348_4203344657555901211_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wiD65nrsALUQ7kNvwEEW0RH&_nc_oc=Adm0xgFOvg8re5It0-855b173yFqFqhyUTToTZxJqnF-U_b26JDKTXjAUVPvRsBYQU0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvY9SnsWWcOPpvRIRQ_KXQGKt9bK4lzezEfV5_5SZ-AEg&oe=69A83AA8"}]}, "id": "2073760636370964", "locale": "en_US", "screenshots": [{"file_name": "screenv2_02.png", "id": "993244952825890", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974853_993244956159223_3665934591366094743_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=85IDJwJxUCgQ7kNvwFOINB9&_nc_oc=Adkb9O5xV9E826zRzSIHk5ny7gA0Nkal7RVED5jw3dfHlYq9LE6e4WXSDd3jGuwwt8A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftSKoz5C2SYZJJoQwWylyUEMaaD1zHqwULpjL6LNMMt3w&oe=69A8248B"}, {"file_name": "screenv2_01.png", "id": "517646341325841", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572947_517646347992507_8365861269156842802_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8-dUIKB7NUkQ7kNvwGZJaPZ&_nc_oc=AdlsEfZ7hvEY5W9t_bxzal_oUxNnOt7FNG0SYULydX5Vd45oURMwDSti6o8onk1nflM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvjF40c_WhGmz5PbD2meNW0e2O34USrBLnbtyQ2GHjHhg&oe=69A81DE3"}, {"file_name": "bagarre selectable01.png", "id": "987094796807741", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391822_987094800141074_5341301578934495068_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hb3kb2Vm7E0Q7kNvwH7TJFC&_nc_oc=Adn9zbhniD5mZaOUAhQJzozhpM4H7OWHUdQLv-sZna5nB-FZjMmHmbaqbE1Q3khSbAE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afs-HsEKYn6vlHwYHFoizb5xgaJZfxRmPkPeyN_8SkWkrw&oe=69A81CCC"}, {"file_name": "pinched warrior03.png", "id": "2233739983674845", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391837_2233739987008178_5682748129040869737_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=durU0gWoz28Q7kNvwEIM7Wl&_nc_oc=AdmRK2TMXoJRuO1WfZxDw8w8Q12_jEcfCQW2i7diKf18PGa6YCW91BlccD7CAo9T7QQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuwA26pPK3tGC3irwClS5LgJoLamH53Xe_1lwku2Wh1YQ&oe=69A83005"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n6d7EbBQKhMQ7kNvwFFZjcn&_nc_oc=AdlBiqZnLA_lF3E4ewTsYz8hA7hXLaWCgoJd2iRaDv8smfY_0ah3qzEL8N4xzVbjveE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsxMVc8rVNP0z0GfcXuK4YKnyJy1W9AIEFd-jNHYPMH0Q&oe=69A83D92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5foVeg_2DLsQ7kNvwFz8beV&_nc_oc=AdnzxnrByWc8X6lkdTc0u658aHKDfQspD6hLTtf-nR4ie7vbIxthMRUq9ZL9L_VZp24&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftgAlxPPLNF94Zk4JImSEApkF9HsW7778fQ6oWfcemS8w&oe=69A83A84"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HXM0jP3mEMkQ7kNvwFJJ2rk&_nc_oc=AdmlmS9AQK-D1heP8xciRD8fN1saozjL4J3UoxbnBzHh41XCiJaBCf-8_LbqM59jvGY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvNlWXWXJ6UWceFhxwd-MFhhaye-b4ZqGAG_rSddukR-A&oe=69A82459"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QSyeiATZFS0Q7kNvwHlz7jQ&_nc_oc=AdnJoMK37IaZDpHa_kgdJrnZj6gtXheKf0Wz2SsU4TqzRKE0ukaSBq31OytdJ-yBBWA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afv-iqs-vBawLdg2nN2oFoDhqD7XU1wOKMFn0GWyFyTb_g&oe=69A82B82"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=URMA1rL7fSEQ7kNvwFgfWvw&_nc_oc=AdkLQlFMiKHjWy1s0G5rPABKyj7eXVIzS11jxoypalzapbGIQPJmD4G-nXvmbSLmJNU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsvaAHvuZ0_6dv4
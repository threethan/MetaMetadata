=6e7a0a&_nc_ohc=S-1j-BzIvJIQ7kNvwHh-Q0P&_nc_oc=Ado8uqxNEVxN-80bgcklmfbYDDrq9auL7IIxg6fjrRTrIUG5Q2imo89AajFNXHkzLsU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCeJuTwL3ToM52D6VwBd5wU0PFntMP4tsVRjR8jcskbcA&oe=6A4E4D05"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ORQj9UD4h-wQ7kNvwE-BNmW&_nc_oc=AdrRu2eK1-QodRc5siCjLeF1bTNbmnSt4yCwy_aVrHSML2OEc0aZblfKyDhxFT8Mqcc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQATLuu0spf3O0qm5IDTYQ2_dhpYohLS2A_yNwT5VkK_kw&oe=6A4E5A92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xlHc_p3NxRIQ7kNvwGzrcmZ&_nc_oc=AdoAADhqF2U5_Qbs0GJ9bYWdcJ-Mnp9F6hbFIYShIDGChQUGwijj0l3QaR0zfZM2Mtc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBM_s0j7-DP0A3vUCcL49CBC0Dc1Wmq7BnK4Rxd-chhgA&oe=6A4E5784"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zduU8MP8rGYQ7kNvwFnHXjs&_nc_oc=AdoKBTAl86t29hrvxvrfTrvc0glB2rOkOZiGztLmn7i9OYZwWJi5cENLPEmroZlo1h4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCHEO0cS3VmMe7ht9cG3BrZL0jykB8lCf_FM95SDmNSpw&oe=6A4E4159"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4jKdJtwyC5QQ7kNvwGzkfaE&_nc_oc=AdrWxN-7NoFAx0_OxSYxK09sC8N9cOS3aPt9E_nxRuP5487JL5OFKNh1mqKUtYpWw_s&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCh9MB1IutApGhNjg6r-mafNDZlVx8HwC3Ra-m36z7c2Q&oe=6A4E4882"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4SRhMuQjq_UQ7kNvwH5lJg0&_nc_oc=AdpyoEFAko69LlmVIPE9YCjqx4-RUvKXv3c7tQIVvUxszjNzDpaeYcWBH
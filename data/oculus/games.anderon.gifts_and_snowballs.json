=6e7a0a&_nc_ohc=mjTsurLOFoEQ7kNvwGIVLT1&_nc_oc=AdpRFXibPeh2NjY0wBFjSe9cup913pUXmTT3DA0q4TPSu0QneZFElDNiYoVtZNvD-1Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9yWSyHpnpFPFwaQ1aukt-rmNMYZg-RM_Sqg1yHbWSFg&oe=6A7C7185"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q_2vQfzqd8wQ7kNvwGG4Ple&_nc_oc=AdpU5N4DWLVoACgje4-ODfhtRfrLsYSR9uP0A_l6t_uEI2_QgfC66-_GAvxavt0aNO0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFR-Y2H-XAXkOD2jMa3fLjUD-kCoegt0sowLLI9ioyajg&oe=6A7C46D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4_ho-Dik7TIQ7kNvwExQiBY&_nc_oc=AdolIaLYWk8DMemJQLJXTjrruVl6SEeUBCldMcq63dRb_boWmSePbrByoF_3c3L7LB0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEPULX7nhY6cjSY9FFiwsiGgiFiMyNh-xg1xWYER5NdIQ&oe=6A7C7C04"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s90H6M6ygvkQ7kNvwEvmxlf&_nc_oc=AdrFOgSd5xfhoOAMZgjMf1VKGhiMO-ReWUrf7xljyZZYugg8_myD-yIiL8ZLlvI2maQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqjmd00yS4_sjv06c2TivCuOSwqTGATXgQn2pRowyCcg&oe=6A7C65D9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rcDA9pbOaIkQ7kNvwGRxkz6&_nc_oc=Adqx_4Rz4ifVJdrPrX8GrGXm6DskdMSKNcPbixaGnhY9m3-rhY9jm8SYgO7XN2jMyNw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFrg-8x8MnWgWDXMM-pK2gq9nY_rnInxq3-bh3vnttHsA&oe=6A7C6D02"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RSFixgF2z4QQ7kNvwGjKta4&_nc_oc=AdosPYGrvSOr_dIfLCc2xvvA8P2U-N2vB8RZ9VygpGEnPORWqnYgKmdmY
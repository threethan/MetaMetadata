=6e7a0a&_nc_ohc=6uK7kvigkxwQ7kNvwGqkqvy&_nc_oc=AdpRx8EfDHuctFcljh7enhBcv9wjnum9bXfo2NiGNuTMslTXn0GO0UQutwoQofcVHto&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9SYrOqJ5VitQ6iEM7wVqhdU45-7h4PCVESJO5O-SAm0g&oe=6A426F85"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J6BZDgvHdFMQ7kNvwEj0Yqu&_nc_oc=AdoFYclVoxQ-SCwbzveEhTH3W4i8i9LJzDNfmdd2eYHKGMdEibVUNgS5ORMuLYL--U8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8DnIsGuzTek3AwN485MkVmyt-FhNk9EtCxMwJh-tmltQ&oe=6A427D12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hfKallalw74Q7kNvwFbz81U&_nc_oc=AdoJPTRBmZd7aMwYuaiTXBytKicegoN8w3QTyBoaAVWhFpItaSHigCygM1CwazrOOt8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9VlcHp9j7Dp0gbKeih64mInbusezxz1IIajJKFOHJsKQ&oe=6A427A04"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jpQyCOxRoxAQ7kNvwFfuSlq&_nc_oc=Adr_Wsj2pviNBcR2QENZ37HhQ282VCzcKnNaxQoBxMVq_fzp1Ryz0aIq7GxkDQQrY8E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Jf-7ZRgSIG_PULDTWxNOPyKcwgBiAsuV0kzSQfsty9w&oe=6A4263D9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W6LMviCWHRoQ7kNvwFnpWBY&_nc_oc=AdrRIkwamh2eUs6HiV58lxMaZZYIZ1Li46nga_cXWundlHKlm608IyZG1Kl_bjnU2k4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ovU0ewfW7KkNJozgFnBiTS-Wo6cn2VUDJRK8f5Wk4Lw&oe=6A426B02"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yPhvkAeUG-MQ7kNvwH3IuyX&_nc_oc=AdrBbLUJMQc89tGwPZvrYQG7dGgM1ra9p6FT6GD-ayRlQ2I5Y6brf5ICv
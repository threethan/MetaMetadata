=6e7a0a&_nc_ohc=_IsQRr7iOmgQ7kNvwFekiHn&_nc_oc=AdplDvlKWdwErslN2Ux8KPBeN2Mp7wmfL-VQt-e2x0DsUNiU5qvwkbocVG_UnllyVXk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2vbrNCv1r3K5doL7B9Y5iieUs_0gJ2IAb9mYfw1QMeWA&oe=69F5F885"}, {"file_name": "droped ramasseur gift01.png", "id": "1161830465296704", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391772_1161830468630037_2108696414486094536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jq5I2yLaAP4Q7kNvwH8hSIP&_nc_oc=AdotiNiOYCX5ziaYNYJlS79cCPEOBXe-4e1r6QTTSw4MED9X-R4RazEBf9qWL5a6foY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af00mEqRgkkMod3auX-rZ6KX9mZbxg2D6-OILoGOdTkLlw&oe=69F60612"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capusle.png", "id": "1015984497028677", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391763_1015984503695343_2256096810208850613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wAQYUwhH8xAQ7kNvwEujsMv&_nc_oc=AdpmlLfkdTSjIWZdOp3L6Yh4UU0dVyAshMg4cJI5mcvUXlFWXGjz5kQQy7RXq7zCkXE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3OzqSj8jxbAnDxTmvVMbv5NJ1tyMr64xmGHmJiVAWzww&oe=69F60304"}, "display_name": "Gifts and Snowballs", "keywords": [], "long_description": "Extend the Christmas\u2019 Magic! \n\nGifts and Snowballs is a festive skirmish game like no other. \n\nStep into the boundless imagination of a child, where their favorite figurines come to life as cheerful heroes of an epic adventure sparked by a clumsy Santa Claus. \n\nProgress through levels and strategically position your units on the map to claim victory. \n\nYour mission? Hold off your opponents and secure as many gifts as possible to save Christmas! \n\n{28275456532099220}\n\n# Intuitive Gameplay\n- Grab and place your units on the map. \n- Upgrade your units to boost efficiency. \n- Expand your team. \n\n{1306473114110285}\n\n# A Joyful Atmosphere\n- Lovable characters with charming abilities. \n- Levels with diverse challenges. \n- A heartwarming soundtrack. \n\n{582700821059223}\n\n#Enhanced Accessibility\n\n- No controllers required. \n- Seamless VR/AR switch. \n- Play comfortably seated.\n\n\n\n# Early access available now !\n\n{7717030558386186}\n\n# Chat with us on discord !\n\nWant to ask question or give feedback ? Join our discord : \n\nhttps://discord.gg/d7qA2KNYS6", "short_description": "Gifts and Snowballs is a festive skirmish game like no other!\nSanta Claus is acting crazy and is dropping presents everywhere. Use your kid\u2019s special skills to bring them back into the safety of your base before your opponents!  "}, {"images": {"nodes": [{"file_name": "bunch_of_buddies.png", "id": "1318855592629915", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391958_1318855595963248_3832640008642857163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4br3iA-N79YQ7kNvwEKsAre&_nc_oc=Adro81Uhetf9KSePK_k3Cjz7OBxfbnVp-CvwmzKGnrPJr_j8yN19V4GA_xrRTzGUXPc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1ilHlXBO1Bqb5A2c4SiAAqobBh2uBp9-1iOLQroKK0gw&oe=69F5ECD9"}, {"file_name": "logo_gifts_and_snowballs.png", "id": "2289796904724427", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473393425_2289796908057760_5718009986926703725_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ueC52tuV5hAQ7kNvwGrac5z&_nc_oc=AdoevRjP0-xFZ5p55zFUPFdB44t3N2zZfR0DdGSisGhmWbHxiKEIVMd_CVZfgpnxNCE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2hQeUHD49z4Co7GAc87ChVsB9_JzA7JjWPi9DDpHqYaw&oe=69F5F402"}, {"file_name": "immersive_backdrop (1).png", "id": "2171671513235127", "image_type": "APP_IMG_IMMERSIVE_LAYER_BACKDROP", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391958_2171671516568460_4600431746571207936_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mTrcqV3qseIQ7kNvwFMhUjE&_nc_oc=Adod6xF_CkCICQQ53Hc2ftwErSJBZnHBa82NDplS57DDB9jrI-EZYuOd9
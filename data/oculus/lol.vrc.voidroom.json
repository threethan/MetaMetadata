02-clubhouse-lounge.png", "id": "1668083415036121", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824665_1668083418369454_2012367576350074329_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sW-RPETATw4Q7kNvwEmv7KO&_nc_oc=Adq1BF4FUUpqR9COMxJnC97AElH-SWtsAjNurrxiixglPagSGdYelNowQZIycU1iv0A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR56F7RE6bWEUwpCynfRhsudr2AXmafGIlN6GXy-WF7zA&oe=6AFC9219"}, {"file_name": "screenshot-05-workshop.png", "id": "1532235612271656", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824328_1532235615604989_5844161894573350261_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0zJA2ye9X-4Q7kNvwHS-mBo&_nc_oc=Adpl1RnCvSYouiG1ja8FEhdKS7uARdxcC6Il9mUM7HclyfQyRX7utKOIhVf_RGw5StI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1kVHwqkSBDfNyOM94CdnnjOfbENOS7lc0pCS6-H4cwA&oe=6AFC84D0"}, {"file_name": "screenshot-01-clubhouse.png", "id": "1476858580962272", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823901_1476858584295605_7950518628658696801_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nQW1xjoOoGIQ7kNvwGsj4t0&_nc_oc=AdoqWO8Cm0mHnFbuFRIuP73rSBI8igLTwUiHa3Mh5YbdiJPJDu_0Uth7D6mfTx7N714&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwG-t33Qjzx4_2NGbgNZG37J9VIqSGUnjzjuw3wEXSkg&oe=6AFC8958"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VoidRoom", "keywords": ["SocialVR", "Multiplayer", "WorldBuilding", "Avatars", "Paintball"], "long_description": "Make a place. Find your people.\n\nVoidRoom is a social VR game where you can hang out, shape your own space and try something new.\n\n**Make yourself at home**\nCustomise your avatar\u2019s face, hair, glasses and colours, then save your look to your VRC.LOL account. Start in your personal room or visit the Clubhouse.\n\n**Meet and chat**\nJoin other players in shared rooms. Talk through voice chat or use the controller keyboard for room text chat.\n\n**Build with the Maker Pen**\nPlace, move, resize and colour objects. Explore circuit chips and wiring, then save your room drafts to your account.\n\n**Try paintball practice**\nExplore the practice yard and try the paintball markers.\n\n**Choose your comfort settings**\nAdjust snap or smooth turning and movement options to suit how you play.\n\nVoidRoom is an early preview under active development. Controls, visuals and performance are still being refined.\n\nA free VRC.LOL account and internet connection are required. Sign-in opens in your headset\u2019s browser. Microphone access is optional and used for voice chat.", "short_description": "Make a place. Find your people. Meet in the Clubhouse, customise your avatar, build with the Maker Pen and try paintball practice in this early social VR preview."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrc.lol/voidroom/privacy", "developer_terms_of_service_url": "https://vrc.lol/voidroom/terms", "publisher_name": "Void Resonance", "support_website_url": "https://auth.vrc.lol/support", "website_url": "https://vrc.lol/voidroom", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}, {"id": "1725996564472128"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1346050791931752"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "3018152245194233"}]}, "baseline_offer": {"id": "3018152245194233"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1791946800, "status": "PUBLISHED", "id": "3018152245194233"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1369864152883749", "version": "0.1.0-quest-meta-20261027.1"}, "id": "1103386405616081", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1346050778598420", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1369864152883749"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1103386405616081"}]}, "change_log": "Room changes clear previous team colours and game-specific presentation. Delayed cleanup from an old room cannot overwrite the new room. VR hides your own nameplate. Interface icon resource duplication and dormant test observers are removed. Existing public room layouts remain unchanged.", "created_date": 1793119394, "id": "1369864152883749", "version": "0.1.0-quest-meta-20261027.1", "version_code": 2026102701, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1346050778598420", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1369864152883749"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1103386405616081"}]}, "change_log": "Share a moment from VoidRoom. Use the new in-game camera and photo gallery, choose your audience and approve friend tags. Desktop hand poses now include open, fist and point. This update also improves room details, VR world-button interaction and local room templates, with networking and reliability fixes. Your account, avatar and saved rooms are retained. Public room layouts are updated separately.", "created_date": 1792526365, "id": "1357993047404193", "version": "0.1.0-quest-meta-20261020.9", "version_code": 2026102009, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1346050778598420", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1369864152883749"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1103386405616081"}]}, "change_log": null, "created_date": 1792516106, "id": "1357764710760360", "version": "0.1.0-quest-meta-20261020.7", "version_code": 2026102007, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1346050778598420", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1369864152883749"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1103386405616081"}]}, "change_log": "Improved Maker Pen placement with clearer Free, Surface, Grid and Object snap modes. Colour choices now update your brush without repainting the last object; use Paint selection to recolour existing objects. Fixed authored-prop previews. Verified staff titles sit above names, and you can hide your own third-person nameplate in Interface settings. Cleaner play HUD, a circular cursor that scales for 4K, and revised Clubhouse, Paintball and Training ambience with varied original bird phrases.", "created_date": 1792500624, "id": "1357403607463137", "version": "0.1.0-quest-meta-20261020.6", "version_code": 2026102006, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1346050778598420", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1369864152883749"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1103386405616081"}]}, "change_log": "Refreshed avatars with smoother floating hands and a cleaner body shape. New Maker Pen and paintball marker models, including distinct rapid, long-range and pump-shotgun designs. Improved Paintball and Training Yard creation templates with new cover and training obstacles. Added area ambience for the Clubhouse, Paintball and Training Yard, with separate ambience volume controls. Includes camera, sign-in and room recovery improvements.", "created_date": 1792491905, "id": "1357210380815793", "version": "0.1.0-quest-meta-20261020.4", "version_code": 2026102004, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
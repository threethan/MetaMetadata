_nc_ss=7f20f&oh=00_AQT1kVHwqkSBDfNyOM94CdnnjOfbENOS7lc0pCS6-H4cwA&oe=6AFC84D0"}, {"file_name": "screenshot-01-clubhouse.png", "id": "1476858580962272", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823901_1476858584295605_7950518628658696801_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nQW1xjoOoGIQ7kNvwGsj4t0&_nc_oc=AdoqWO8Cm0mHnFbuFRIuP73rSBI8igLTwUiHa3Mh5YbdiJPJDu_0Uth7D6mfTx7N714&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwG-t33Qjzx4_2NGbgNZG37J9VIqSGUnjzjuw3wEXSkg&oe=6AFC8958"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VoidRoom", "keywords": ["SocialVR", "Multiplayer", "WorldBuilding", "Avatars", "Paintball"], "long_description": "Make a place. Find your people.\n\nVoidRoom is a social VR game where you can hang out, shape your own space and try something new.\n\n**Make yourself at home** Customise your avatar\u2019s face, hair, glasses and colours, then save your look to your VRC.LOL account. Start in your personal room or visit the Clubhouse.\n\n**Meet and chat** Join other players in shared rooms. Talk through voice chat or use the controller keyboard for room text chat.\n\n**Build with the Maker Pen** Place, move, resize and colour objects. Explore circuit chips and wiring, then save your room drafts to your account.\n\n**Try paintball practice** Explore the practice yard and try the paintball markers.\n\n**Choose your comfort settings** Adjust snap or smooth turning and movement options to suit how you play.\n\nVoidRoom is an early preview under active development. Controls, visuals and performance are still being refined.\n\nA free VRC.LOL account and internet connection are required. Sign-in opens in your headset\u2019s browser. Microphone access is optional and used for voice chat.", "short_description": "Make a place. Find your people. Meet in the Clubhouse, customise your avatar, build with the Maker Pen and try paintball practice in this early social VR preview."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrc.lol/voidroom/privacy", "developer_terms_of_service_url": "https://vrc.lol/voidroom/terms", "publisher_name": "Void Resonance", "support_website_url": "https://auth.vrc.lol/support", "website_url": "https://vrc.lol/voidroom", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1023770785722696"}, {"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1346333895236775"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823910_2366576304152198_5233989095094379450_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oL7T4Tc_LAgQ7kNvwFjqTGH&_nc_oc=AdqfbQQi8FD7YD-Koj2NSrKb30ke6qr0_bF1dLXIe6O4mZ-0DQwU6yc7hfj93NcTwM0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJUTQZIP8E78D1RZlToXShHfCMrl7iAlr0QPOByOnX_A&oe=6AFC705A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VoidRoom", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sandbox", "id": "1990104051447093"}, {"topic_name": "Hangout", "id": "1023770785722696"}, {"topic_name": "World Creation", "id": "1725996564472128"}], "release_date": 1791946800, "lastRevision": {"nodes": [{"i
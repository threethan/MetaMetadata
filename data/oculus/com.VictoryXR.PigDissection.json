"}, {"file_name": "ss_7d605c705b1866aebbc188b821d7d02dbae011b4.png", "id": "255660282708475", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982601_255660286041808_3913103671746758460_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0r7MFy-SDswQ7kNvwGMADUC&_nc_oc=AdnceZ9rsazc_IeQWiXMG5eZebL_xyuY3s3gJiaJUHUD_u3oBK1DICeTLKTdupvthFk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx-LFahuy5TLiTyob55K1Wr7a_ORqZxN6AMwSPfP42oBw&oe=69AC2514"}, {"file_name": "ss_90cf4fcdb702bf75528946a5022afacac8e7fea9.png", "id": "461579864992075", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974557_461579868325408_1578445223530056449_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bwit5zfQyLoQ7kNvwFy8Ds4&_nc_oc=AdkH5ciDQGsz4ykQ5CHGWFUpcxV462w66u54yUZ64BKtE95Mq661nbpDJlNtHfIvbro&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy2aT1bvPiXhiSTs6q3YxL5pnK7Vo3bTYONblCEm9jpUw&oe=69AC2D92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss_1a684e4a42e443590bfbd8e08b49202c42657f71.png", "id": "901011737349559", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982479_901011740682892_675919200486557106_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pb9BT_lr7DwQ7kNvwEQ2WzW&_nc_oc=Adn5a0CFXyftek9Zzd5Jd9xfJ06XkkoA9xFqirShssWyY7tjQYc6AMYrqiSauaSxaGA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxgE74sL2VJtaTERun0e7lYG7em1wEdihgNAUAbm5nymg&oe=69AC1AC8"}, "display_name": "Dissection Simulator: Pig Edition", "keywords": [], "long_description": "VictoryXR\u2019s virtual reality pig dissection software is a hands-on dissection opportunity experienced through the power of VR. This true-to-life, hour-and-a-half practice thoroughly covers each step of the science procedure that students would take if dissecting a fetal pig specimen in their classroom.\n\nThe entire program adheres to the Next Gen Science Standards (NGSS), America\u2019s framework for science learning. In addition, we\u2019ve implemented the processes and procedures of Carolina Biological--America\u2019s leading supplier of science education materials. Using original and lifelike physical models, the dissection experience is recreated to the finest detail and is a comparable substitute for actual live specimen classroom dissections, without the safety and ethical implications. Schools save on expensive and rising annual costs of animal specimens. Additionally, acquisitions are reliable and not dependent on animal procurement.", "short_description": "VictoryXR\u2019s virtual reality pig dissection software is a hands-on dissection opportunity experienced through the power of VR. This true-to-life, hour-and-a-half practice thoroughly covers each step of the science procedure that students would take if dissecting a fetal pig specimen in their classroom."}]}, "developer_name": "VictoryXR", "developer_privacy_policy_url": "https://victoryxr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VictoryXR", "support_website_url": null, "website_url": "https://victoryxr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "491246615742099"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PENDING", "id": "483867554289155"}, {"status": "PUBLISHED", "id": "500888664442980"}, {"status": "PUBLISHED", "id": "2517
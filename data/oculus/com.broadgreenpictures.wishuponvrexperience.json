g_MQMCGPP2p3sBRwoTIc1OSX9LA&oe=6A146D8C"}, "display_name": "Wish Upon VR Experience", "keywords": ["Wish", "Upon", "Horror", "Movie"], "long_description": "The WISH UPON VR EXPERIENCE is an interactive Virtual Reality Experience which immerses users in the cinematic world of Wish Upon by recreating the horrors of making a wish and having that wish twisted by the ill-fated music box.The implementation of \u2018gaze branching\u2019 technology allows viewers to create their own \u201cpath\u201d depending on where they look and what wish they make. Combining atmospheric and practical effects, this high school of horrors provides scares tailored to the chosen path. Given the choice, can you handle the consequences?", "short_description": "The WISH UPON VR EXPERIENCE is an interactive Virtual Reality Experience which immerses users in the cinematic world of Wish Upon by recreating the horrors of making a wish and having that wish twisted by the ill-fated music box. Given the choice, can you handle the consequences?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.broadgreen.com/privacy-policy/", "developer_terms_of_service_url": "http://www.broadgreen.com/privacy-policy/", "publisher_name": "Broad Green", "support_website_url": null, "website_url": "http://wishuponvr.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["HORROR", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "468232504711129"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.577
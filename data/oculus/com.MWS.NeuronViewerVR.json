, "id": "777954316666749", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031599_777954320000082_8114153368963702001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=Dwxgxh6sXYAQ7kNvwFDNzYt&_nc_oc=AdoSBCX1WuJf8Inyly8Jlpe8LXhfxsqntRJGj96Yvrp9zAcu-abDwrI9xodMVFlNdUw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6lHuqBspdT9IUZJe4odgWPdDrmiLzvsgekU8uw422FA&oe=6ADCD5F7"}, {"file_name": "2022-07-04_11h17_11.png", "id": "539906811147842", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974824_539906814481175_8069451749039060972_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MFGQHw-z5LYQ7kNvwHJqiDj&_nc_oc=Adpuscuw2kP4dAnZH0ykqLuwO0G7wbJPFad5zfIxvujqbagIGs7q7fJZYiwxye3auKQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNpFrYTbwxb_I6d1BUbjXst-CC3v5TetK58Y87HLljTqg&oe=6ADCCFE5"}, {"file_name": "2022-07-04_11h17_48.png", "id": "561287292381826", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75269587_561287295715159_4055455353814917321_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qdRcYF1e67UQ7kNvwG2m3hO&_nc_oc=AdpIkDyu0Hw2HuQcBo_aQESU_H92T_9S2cYoBQwoZCr0XrG3ggdQJBzVD0TVx0txEmc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN5SCXTmc9DDp1VCZKYf6AExtNMfQjhjviZPL6LFrTQSQ&oe=6ADCBF0C"}, {"file_name": "2022-07-04_11h21_04.png", "id": "378643914371157", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001717_378643917704490_8667021042148813753_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UYvwRkRY3SUQ7kNvwGEYeW-&_nc_oc=AdqGNF7whRMdjFqIXo7ZU6oagH8tCE_KKEsF7eB3pMjmEwmuOyfOnoJtLSwwr6Qa-98&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPkTin8a5VOrnWuLKQ4hKoGR5qFEQp1L8gfViSGTp_KJQ&oe=6ADCBA8D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2022-07-04_11h16_26.png", "id": "1401137973689150", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982464_1401137977022483_7649163402161599568_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kc1TOH-u68gQ7kNvwEx1ehh&_nc_oc=AdrZiyzTCPUpoRenrxjklxmDesUF2z2sjegMQmYDZsOnrvCyFszxvwapXqVcZLOJNZ0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOasf5rlg18GxHN-DAC00xWk6prnRBLqejl-PNWGYZpJQ&oe=6ADCB4BB"}, "display_name": "NeuronViewerVR", "keywords": [], "long_description": "NeuronViewerVR is the first app for viewing neurons in the descriptive .swc file format on demand in mixed reality (MR). Neurons in the .swc format from arbitrary sources can be manually uploaded to the headset and placed in an MR space. While MR enables the fast display of the neurons and allows the user to walk around them without setting up a proper play space, the app also supports dynamic blending between a transparent and black background for better contrast. Furthermore, a direct interface for accessing all neurons in the Neuromorpho (www.neuromorpho.org) database, which contains  ~200,000 neurons from numerous different species traced by various scientists, was implemented. Neurons can be placed in different colors, favorites can be added from Neuromorpho and even whole forests of neurons manually uploaded to the headset or downloaded from Neuromorpho can be saved and loaded at later timepoints. ", "short_description": "NeuronViewerVR is the first app for viewing neurons in the descriptive .swc file format on demand in mixed reality. Specific .swc files can be uploaded to the headset and are then available for viewing. The app also provides a direct interface to the Neuromorpho (www.neuromorpho.org) database containing  ~200,000 neurons from numerous different species that were traced by various scientists."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mws.biz/NeuronViewerVR/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "MW Software", "support_website_url": null, "website_url": "http://www.mws.biz/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_categor
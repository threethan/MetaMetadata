"id": "378643914371157", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001717_378643917704490_8667021042148813753_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MBdJFkwa_uMQ7kNvwGw72dW&_nc_oc=AdqD3r0Fdw37vaHv_HtNTnRNEsCMSe0nLOvPSAfpuDfKyK5dAnPEX_5roc81UES13W4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTG0jvgj3aNJZQEcXfdFQhQrljoC7VJsmHf4jGwErsZXg&oe=6B0DBA4D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2022-07-04_11h16_26.png", "id": "1401137973689150", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982464_1401137977022483_7649163402161599568_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nIAVC85Cwa4Q7kNvwHK0qaT&_nc_oc=AdqyK8-KUJxmw9Tgn5v2hkIbCputXR7wGgWW9grhBXfPsAjNLE8WAUmCJ3J5IfD4szo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRPlDF-vWeKbjBJn3J3BI0MXfc6BGxD_XeAfmO82oQoRA&oe=6B0DB47B"}, "display_name": "NeuronViewerVR", "keywords": [], "long_description": "NeuronViewerVR is the first app for viewing neurons in the descriptive .swc file format on demand in mixed reality (MR). Neurons in the .swc format from arbitrary sources can be manually uploaded to the headset and placed in an MR space. While MR enables the fast display of the neurons and allows the user to walk around them without setting up a proper play space, the app also supports dynamic blending between a transparent and black background for better contrast. Furthermore, a direct interface for accessing all neurons in the Neuromorpho (www.neuromorpho.org) database, which contains  ~200,000 neurons from numerous different species traced by various scientists, was implemented. Neurons can be placed in different colors, favorites can be added from Neuromorpho and even whole forests of neurons manually uploaded to the headset or downloaded from Neuromorpho can be saved and loaded at later timepoints. ", "short_description": "NeuronViewerVR is the first app for viewing neurons in the descriptive .swc file format on demand in mixed reality. Specific .swc files can be uploaded to the headset and are then available for viewing. The app also provides a direct interface to the Neuromorpho (www.neuromorpho.org) database containing  ~200,000 neurons from numerous different species that were traced by various scientists."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mws.biz/NeuronViewerVR/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "MW Software", "support_website_url": null, "website_url": "http://www.mws.biz/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "MEDICINE", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1110883146195741"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1156266221896495"}]}, "baseline_offer": {"id": "1156266221896495"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1657131540, "status": "PUBLISHED", "id": "1156266221896495"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9163483277114092", "version": "1.1"}, "id": "726924391849564", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary
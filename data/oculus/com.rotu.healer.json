sBpe6XFgH8I&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQENFs0GzZaR2w1rDY-0AHNkIAOLm9_Fx2b2i0Q2Ktva-Q&oe=6A858672"}, {"file_name": "5.png", "id": "1080209267501489", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491821194_1080209270834822_6743924213641926808_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2DN15Fbw1nwQ7kNvwFwDu9O&_nc_oc=AdpdXaZfIvuM-ulq7P5PzVLvsGe-Z1AaSn_I2RkO3T9SxmzdbtDzzI6JMINhEZ4zOpk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGvhDY-QkwT4HissZ_v2CiPZhZWwb7BnXvy3MuI-ZuBlg&oe=6A858CCB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "473391921_1383640519439778_6808914321789533610_n.png", "id": "1044511440572470", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499340257_1044511443905803_5315106498987817785_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Z3VeCQlS4wQ7kNvwHHNTYI&_nc_oc=Adq-VzqCV8c_5JYI8msxgn4UU6S-hCY0aFORMSmZJCJ8wCIQuDDqHsWxf0jiLXMPTig&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEotKcOIW_tle0hsGNLH4ShM2ah0ooPK24wc_krVJb78g&oe=6A859F36"}, "display_name": "Healer", "keywords": ["puzzle", "family", "Leaderboard", "shooter", "roguelite"], "long_description": "HEALER is a mixed reality rogue-lite bubble popper where your room transforms into an ever-changing universe. Wield the power of creation to evolve your space and fight back against an interdimensional virus trying to trap you in a dull, lifeless reality. Healer starts easy, then gets intense. One wrong move, and it\u2019s all over.\n\n{1283911806625418}\n# Build and reshape your environment as you pop sentient bubbles.\n{1288447772909834}\n\n{1251932756485409}\n# Unlock 50 Cosmic Critters that grant passive abilities.\n{750546210732578}\n\n{1719435972789156}\n# Battle Entropic Viruses trying to overwrite your creations.\n{725993309930639}\n\n{1236375144563386}\n# Fuse runes to channel light or dark energy, changing the outcome of each run.\n{732607159428213}\n\n{1862720141238275}\n# Solve entropy puzzles that grant Tool upgrades. \n{1236037301234606}\n\n", "short_description": "Healer is a mixed reality rogue-lite, where you wield creation itself. Collect Cosmic Critters, solve orb-popping puzzles, and overcome an interdimensional virus as you shape a unique universe with every run.\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rotu.com/healer-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ROTU Entertainment & Media, Ltd.", "support_website_url": null, "website_url": "https://www.rotu.com/healer", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9182199978458334"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "25332351856463961"}, {"status": "PUBLISHED", "id": "1210924154252112"}, {"status": "PUBLISHED", "id": "1624242245406237"}]}, "baseline_offer": {"id": "1624242245406237"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1771005600, "status": "PUBLISHED", "id": "25332351856463961"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25736011285983942", "version": "280"}, "id": "597456662864720", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"node
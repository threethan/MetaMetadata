fmcFxIR64ZFQuXh2fvz08sZ7EG4ujrqwqUUJ4g5gTCO_P5Y0Xv8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwjwWZtu-E8pNfDZAxJ2L_5R8oITrfaEZ4tTKm_k9UJ4Q&oe=69B53FCB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "473391921_1383640519439778_6808914321789533610_n.png", "id": "1044511440572470", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499340257_1044511443905803_5315106498987817785_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XN7PaLY4K64Q7kNvwHyVwuU&_nc_oc=AdkI4ZZF_y-Wn5nu6gnH2QTtmhwoDWEqnHTLBqTzibuKK-FBMtN9f6nQBRMeHCnD7ME&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyCIy4WC32VyGqVmoq9wv4FQ1oD_kHiDmkFWl-UD3m9rg&oe=69B55236"}, "display_name": "Healer", "keywords": ["puzzle", "family", "Leaderboard", "shooter", "roguelite"], "long_description": "HEALER is a mixed reality rogue-lite bubble popper where your room transforms into an ever-changing universe. Wield the power of creation to evolve your space and fight back against an interdimensional virus trying to trap you in a dull, lifeless reality. Healer starts easy, then gets intense. One wrong move, and it\u2019s all over.\n\n{1283911806625418}\n# Build and reshape your environment as you pop sentient bubbles.\n{1288447772909834}\n\n{1251932756485409}\n# Unlock 50 Cosmic Critters that grant passive abilities.\n{750546210732578}\n\n{1719435972789156}\n# Battle Entropic Viruses trying to overwrite your creations.\n{725993309930639}\n\n{1236375144563386}\n# Fuse runes to channel light or dark energy, changing the outcome of each run.\n{732607159428213}\n\n{1862720141238275}\n# Solve entropy puzzles that grant Tool upgrades. \n{1236037301234606}\n\n", "short_description": "Healer is a mixed reality rogue-lite, where you wield creation itself. Collect Cosmic Critters, solve orb-popping puzzles, and overcome an interdimensional virus as you shape a unique universe with every run.\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www
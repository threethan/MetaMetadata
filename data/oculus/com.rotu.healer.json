rET6EwWD9Ma6GMo_M60wBBugO7M4pSeQ&oe=69F8AE32"}, {"file_name": "5.png", "id": "1080209267501489", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821194_1080209270834822_6743924213641926808_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C6SEyYriS0cQ7kNvwFFYTrp&_nc_oc=AdpUhsshkKr3uPAmMPBv-UGr40R9O19pFWPIjSSvp6N8br5wDHZNb2RQetH-mXN3L0c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2JQWrAZz5UZf1854ByTESuahb_GuP7i4hw-H3vARXmzA&oe=69F8B48B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "473391921_1383640519439778_6808914321789533610_n.png", "id": "1044511440572470", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499340257_1044511443905803_5315106498987817785_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kZBLjjF3H80Q7kNvwEF-zRi&_nc_oc=AdpHJ3WvaiLwZ2TERVDI55PGlgBxQhTVSgMefkvzJNZvyzQvuVwjaCk92dGLqJn6kXM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3CJqZ-5rdb6jvrex0VcDWRXwUMWU2ugiMGbsUWupBN-A&oe=69F88EB6"}, "display_name": "Healer", "keywords": ["puzzle", "family", "Leaderboard", "shooter", "roguelite"], "long_description": "HEALER is a mixed reality rogue-lite bubble popper where your room transforms into an ever-changing universe. Wield the power of creation to evolve your space and fight back against an interdimensional virus trying to trap you in a dull, lifeless reality. Healer starts easy, then gets intense. One wrong move, and it\u2019s all over.\n\n{1283911806625418}\n# Build and reshape your environment as you pop sentient bubbles.\n{1288447772909834}\n\n{1251932756485409}\n# Unlock 50 Cosmic Critters that grant passive abilities.\n{750546210732578}\n\n{1719435972789156}\n# Battle Entropic Viruses trying to overwrite your creations.\n{725993309930639}\n\n{1236375144563386}\n# Fuse runes to channel light or dark energy, changing the outcome of each run.\n{732607159428213}\n\n{1862720141238275}\n# Solve entropy puzzles that grant Tool upgrades. \n{1236037301234606}\n\n", "s
3.oculuscdn.com&_nc_ss=8&oh=00_AfwJn7ZLd8AEyqjzXETJFjxwQ4BAm2KsZB9cM7SZ35Axqw&oe=69B949AA"}, {"file_name": "ROTU HEALER SPACE_final.png", "id": "1210449070971355", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499296037_1210449074304688_7932197479468287736_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RPCZfUNXtcIQ7kNvwEOJQUA&_nc_oc=AdklJu_3gb4GJSdcmtixKFx_Ol3zFGFuWNfRjoDd0qbpR4_jpdM-UQIJEY_fR_wDQMU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyZ3WwulbIQVWO_MOTHLg36eX1WTFPDSdFRaEPxC8mS9w&oe=69B95FA1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE ART FINAL UPDATE NOV 2025.png", "id": "1359976809165654", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499300678_1359976812498987_3815534789696091693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tFt81uPtV0YQ7kNvwH60JDr&_nc_oc=AdmbtSpr0QhB6iuEmweTICaR3HHwfC5G3b4Dyt3hFtOPErVRXkvo7BeW-Kaxgybcxx4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzuszZn2KXOux9iYd4-Q91S0i6wzA6KOzixq9vfP5qaBg&oe=69B931DB"}, "display_name": "Healer", "keywords": ["puzzle", "Leaderboard", "shooter", "roguelite", "arcade"], "long_description": "# Your living room just caught the Entropic Virus. \nNot the world-ending kind. The boring kind. You know, like Tuesdays.\n\nHEALER is a fast-paced, chaotic, and questionably therapeutic mixed reality roguelite featuring a global leaderboard where you can prove you\u2019re better than strangers.\n\n{1299371742236658}\n\nPop bubbles, solve puzzles, and rescue absurd Cosmic Critters while battling a smug interdimensional virus determined to make your universe boring again. \n{25086948624290038}\n\nEach run reshapes your environment in unpredictable ways. It\u2019s easy to pick up, hard to stop, and beautiful enough to make you question whether reality was ever that impressive to begin with.  \n\n{3169853029858855}\nThe first 300 reviewers will have their usernames immortalized inside the game as hidden Easter eggs, eternal glory, or at least a weird critter muttering your name somewhere deep in the void.\n\n\n\n\n\n\n{806715285475341}\n", "short_description": "Reshape your room, rescue hilarious Cosmic Critters, and pretend you totally understand what's going on in HEALER! The fast, chaotic, and questionably therapeutic mixed reality endless roguelite. Every run reshapes your world and your spot on the global leaderboard.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rotu.com/healer-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ROTU Entertainment & Media, Ltd.", "support_website_url": "https://discord.gg/gvM6esfJ93", "website_url": "https://www.rotu.com/healer", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "377978390272490"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25770480209203716"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822817_2025396161636505_4198084379170938255_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UqstMR3Vf6IQ7kNvwFZAIbS&_nc_oc=AdkV-fhePqaujY7cgjYfzvhCzACBqvgJUGexbD7e_Tf3MnKoNfVYUkusF45MkCU2b9s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwbK8XgonSrvv8Zbft5MrAohenBWcknsjCS9SMrDWYSQA&oe=69B94A99"}, "is_concept": false, "is_test": fals
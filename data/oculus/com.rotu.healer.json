2HS4VJnhtoFgtwuK6OfWGW53Q4c5rJ6g&oe=6AD38732"}, {"file_name": "5.png", "id": "1080209267501489", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491821194_1080209270834822_6743924213641926808_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u_qmHTjdwLcQ7kNvwEKU4LV&_nc_oc=AdriEB9FPkbx29JGWtFjSjfS7Pzv74FHeVjbInmZy29S5JfP02D3i0v4DX25C4Vk9HM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOGWEVGv4msa099s6Szt6K-_j8ego6IobdeBcv1gfnRzQ&oe=6AD38D8B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "473391921_1383640519439778_6808914321789533610_n.png", "id": "1044511440572470", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499340257_1044511443905803_5315106498987817785_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=001Uc4Ma7kMQ7kNvwHErF-N&_nc_oc=Adry72U9cteYpz4VXY-VFUWJ43Uih5evK2ErEzjUPy6ZezlKGFzC5kiZqp6Q3-is68M&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJHFEqxJ_oqC5lLpeIMgyLy5DmcAtBhTC3hpYogCwW8Q&oe=6AD39FF6"}, "display_name": "Healer", "keywords": ["puzzle", "family", "Leaderboard", "shooter", "roguelite"], "long_description": "HEALER is a mixed reality rogue-lite bubble popper where your room transforms into an ever-changing universe. Wield the power of creation to evolve your space and fight back against an interdimensional virus trying to trap you in a dull, lifeless reality. Healer starts easy, then gets intense. One wrong move, and it\u2019s all over.\n\n{1283911806625418}\n# Build and reshape your environment as you pop sentient bubbles.\n{1288447772909834}\n\n{1251932756485409}\n# Unlock 50 Cosmic Critters that grant passive abilities.\n{750546210732578}\n\n{1719435972789156}\n# Battle Entropic Viruses trying to overwrite your creations.\n{725993309930639}\n\n{1236375144563386}\n# Fuse runes to channel light or dark energy, changing the outcome of each run.\n{732607159428213}\n\n{1862720141238275}\n# Solve entropy puzzles that grant Tool upgrades. \n{1236037301234606}\n\n", "s
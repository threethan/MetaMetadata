ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2e-F5SNk_IAQ7kNvwHNWXQQ&_nc_oc=Adr7Nsijfe8JX3S6JPdBhnsWRU69Rf_az3JFm1afyfd1Atr-UqaIknTanG69WorTRuQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6pr_gHY_wY9f5dixBQIa3NBsrkq4PcGMmCn1NhILpA4A&oe=69F9E32A"}, {"file_name": "ROTU HEALER SPACE_final.png", "id": "1210449070971355", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499296037_1210449074304688_7932197479468287736_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M-xzHO6jzQAQ7kNvwFcle1U&_nc_oc=Adq0IKiK0IQXIOGi-y3YCNmEZTJE0upOHrH5CRTL7sGXGpeh2ASOjAQuDtzRV7zPmhs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6sMh2rtw-2MyjHuECttbriGsUGbtB_krodDbsDc9COiA&oe=69F9F921"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE ART FINAL UPDATE NOV 2025.png", "id": "1359976809165654", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499300678_1359976812498987_3815534789696091693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HMjHKaxdf84Q7kNvwGS7vLp&_nc_oc=AdoAtbfDdyRh97gEbui9egbDDmzu6OiSJntstDpfGRY8UK6RxdR9aIXZYse5uEVHU-E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60rD6yGHv8mo852BItmmZGKTRh7yGI41nUNC9SkQ2kOg&oe=69FA039B"}, "display_name": "Healer", "keywords": ["puzzle", "Leaderboard", "shooter", "roguelite", "arcade"], "long_description": "# Your living room just caught the Entropic Virus. \nNot the world-ending kind. The boring kind. You know, like Tuesdays.\n\nHEALER is a fast-paced, chaotic, and questionably therapeutic mixed reality roguelite featuring a global leaderboard where you can prove you\u2019re better than strangers.\n\n{1299371742236658}\n\nPop bubbles, solve puzzles, and rescue absurd Cosmic Critters while battling a smug interdimensional virus determined to make your universe boring again. \n{25086948624290038}\n\nEach run reshapes your environment in unpredictable ways. It\u2019s easy to pick up, hard to stop, and beautiful enough to make you question whether reality was ever that impressive to begin with.  \n\n{3169853029858855}\nThe first 300 reviewers will have their usernames immortalized inside the game as hidden Easter eggs, eternal glory, or at least a weird critter muttering your name somewhere deep in the void.\n\n\n\n\n\n\n{806715285475341}\n", "short_description": "Reshape your room, rescue hilarious Cosmic Critters, and pretend you totally understand what's going on in HEALER! The fast, chaotic, and questionably therapeutic mixed reality endless roguelite. Every run reshapes your world and your spot on the global leaderboard.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rotu.com/healer-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ROTU Entertainment & Media, Ltd.", "support_website_url": "https://discord.gg/gvM6esfJ93", "website_url": "https://www.rotu.com/healer", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "377978390272490"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25770480209203716"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822817_2025396161636505_4198084379170938255_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_w0PFVw57jQQ7kNvwGscDaq&_nc_oc=AdqG4FKl8uxm8169G5tiyeDXA9h7e7bXoEPIOvhQssoKHeB0q6g7CBx
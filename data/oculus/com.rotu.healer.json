2.oculuscdn.com&_nc_ss=8&oh=00_AfzCL70kga2X_4eek0JzDPKejHm3EbM_KH6UTUrStOqqZg&oe=69BD3E2A"}, {"file_name": "ROTU HEALER SPACE_final.png", "id": "1210449070971355", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499296037_1210449074304688_7932197479468287736_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YpYtaTpuxjEQ7kNvwHu8W5p&_nc_oc=Adkv9Yd7o8UDzeEiO4P9Q7wwqsQ3gYgWM_FmnPJM284Du7WywxbfGCQcjPdE67MMgnk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzToWEDoORAlXVkeNoteaEzXjjHvLV95vxLOKWB-nXW9w&oe=69BD5421"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE ART FINAL UPDATE NOV 2025.png", "id": "1359976809165654", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499300678_1359976812498987_3815534789696091693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=60NGzQVhoW4Q7kNvwFillkf&_nc_oc=AdnRXQPNdJ3J_LSHSMGG4o4ywUGFUGIbhHYN__gIY_aMuFodePRi1jRK6hj7bJWwBMc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxT1okmS0JKKDwJOutEkVXMvt9HTLB7M3B5G2PbVJOglQ&oe=69BD5E9B"}, "display_name": "Healer", "keywords": ["puzzle", "Leaderboard", "shooter", "roguelite", "arcade"], "long_description": "# Your living room just caught the Entropic Virus. \nNot the world-ending kind. The boring kind. You know, like Tuesdays.\n\nHEALER is a fast-paced, chaotic, and questionably therapeutic mixed reality roguelite featuring a global leaderboard where you can prove you\u2019re better than strangers.\n\n{1299371742236658}\n\nPop bubbles, solve puzzles, and rescue absurd Cosmic Critters while battling a smug interdimensional virus determined to make your universe boring again. \n{25086948624290038}\n\nEach run reshapes your environment in unpredictable ways. It\u2019s easy to pick up, hard to stop, and beautiful enough to make you question whether reality was ever that impressive to begin with.  \n\n{3169853029858855}\nThe first 300 reviewers will have their usernames immortalized inside the game as hidden Easter eggs, eternal glory, or at least a weird critter muttering your name somewhere deep in the void.\n\n\n\n\n\n\n{806715285475341}\n", "short_description": "Reshape your room, rescue hilarious Cosmic Critters, and pretend you totally understand what's going on in HEALER! The fast, chaotic, and questionably therapeutic mixed reality endless roguelite. Every run reshapes your world and your spot on the global leaderboard.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rotu.com/healer-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ROTU Entertainment & Media, Ltd.", "support_website_url": "https://discord.gg/gvM6esfJ93", "website_url": "https://www.rotu.com/healer", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "377978390272490"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25770480209203716"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491822817_2025396161636505_4198084379170938255_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3gZUP1otukIQ7kNvwGFGOW-&_nc_oc=AdnRHSsX-ciExayntQFh5A17eoIGBAJDVK8QsVY0oRkQGEJcGAL8H5CwhBqr5UA4C18&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwPeHxkxqGYCQNyez0wUZYDFYAjW6zd5_MJJvZilXHEww&oe=69BD3F19"}, "is_concept": false, "is_test": fals
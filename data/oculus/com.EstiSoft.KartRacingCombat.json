_803768006071381_4367082216907765165_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W5VO5_2M0sUQ7kNvwHJWueu&_nc_oc=AdqAcpVUF7xtf54JhLIR31A06eJ8siaL5q41qZyYzWsGyX43i1J4Ok-6GnhQ61Wi91c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4HcLvr6nla1tm9Wt6Z1HELPMq_WX_rwXWoHsB2ygE2Hg&oe=69FB37EC"}, {"file_name": "ss3.png", "id": "1958983284692315", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/585727769_1958983288025648_2608757142171212837_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=azMN2zuyWPcQ7kNvwHK5pWb&_nc_oc=AdrCBA8yQ783CEmxZii7l0vVsHv4ugHLsk0rIUBX1xj1nONIja4OCQOp5trv00Bgek0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vZV2BoX39fbRjsrfNJ50_rHw15fqKOunL_I8tPYmz0Q&oe=69FB27AE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss4.png", "id": "2185765335497023", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819982_2185765338830356_7499703382178773633_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hqt-YM1SihkQ7kNvwENah61&_nc_oc=AdrEhILzMa_ECX_8larTsa31muYNGnB3Jz2d9m_Ig-o_chrdbqC7dFNTjGTvwhqDCrc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7HHvA5rtjurCk-9gVy4NxS0MD1r3I2803bEyIerHqnAQ&oe=69FB2607"}, "display_name": "Kart Racing Combat", "keywords": ["racing", "kartcar", "combatracing", "carbattle", "driving"], "long_description": "Kart Combat Racing brings classic arcade racing together with explosive combat and chaotic fun. Jump into high-speed races across vibrant tracks filled with traffic, obstacles, shortcuts, and surprise power-ups. Every race is unpredictable \u2014 one moment you\u2019re drifting through a tight corner, the next you\u2019re launching rockets or activating boosts to escape danger.\n\nChoose your kart from a lineup of unique combat vehicles, each with its own style and feel. Customize and upgrade your kart to improve speed, handling, and special abilities. Collect power-ups during races to gain temporary advantages, block enemy attacks, or strike back at rivals who get too close.\n\nThe controls are simple and responsive, making it easy to jump in and play, while the combat mechanics and track layouts add depth for players who enjoy mastering timing and strategy. Whether you want quick adrenaline-filled races or competitive runs for the top position, Kart Combat Racing delivers nonstop action, flashy visuals, and satisfying gameplay moments.\n\nRace fast. Fight smart. Win the track.", "short_description": "Kart Combat Racing is a fast-paced arcade racer where speed meets firepower. Drift through colorful tracks, dodge traffic, and use powerful weapons to outplay your rivals. Choose from unique combat karts, upgrade your abilities, and unleash rockets, boosts, and special skills to take the lead. Easy to play, hard to master \u2014 perfect for quick races and intense battles."}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1_l_GxTpD64zBNaY3TAnGXtCB1cmJE-E7/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.esti.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26935577459375496"}, "review_messages": []}]}, "cover_square_image": {"u
c_ohc=-P9ewr-5wpUQ7kNvwGs_DQu&_nc_oc=AdpEsGxuvda-R8X4FZjNIy2Zifb7Zf8kxShIDL1yICIjSv_oRgUJzzbFmcEYNxaQ1WM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJD-xWP-2v8skjDHKsXbHyS2DvTy5Q3-JccyewStmkvDQ&oe=6AB53D4B"}, {"file_name": "Screenshot_04_2560x1440.png", "id": "2320588172046016", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312236_2320588175379349_6509240851392167424_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1yRYzFunnUkQ7kNvwGVolZr&_nc_oc=AdpqgaQHB9H8uivmnKo89KEhw_SaCMpqPQ6y_W_McpwxioPAZmLJgbj0aYzb3gEWzEM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKzBciftU4_sCqAW1k31V68c5HKfMg9b1ppH95VBbuFLg&oe=6AB51ABA"}, {"file_name": "Screenshot_05_2560x1440.png", "id": "1889264702050277", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312332_1889264708716943_459839500965141556_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IHjWKssaanUQ7kNvwHXVUPu&_nc_oc=AdriNwIARymc337aFm7cdmb-BISpX32woBgfe3HNl2XA0BOOa0lybsIAMQr2pNhaB5I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3cg_9QlSgiUNQRGnrQoFicSJ8So5HE1oza2AnBAtTzQ&oe=6AB53AAF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape_2560x1440.png", "id": "27934318042888260", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314648_27934318049554926_1252765953642826078_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VP34NhWqQKEQ7kNvwF_8Pnb&_nc_oc=AdqoKC6oUbiJrb_eNw0GETZCPPdkKLd4FuKi1t5Kymt_ZtLHHhyHrXI27tytnjmiLoI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKz1V_pkGQGbRU_br6uRCC5-TJbv9ezGkQM4j_CrLjfpw&oe=6AB54B03"}, "display_name": "Shin Zero Demo", "keywords": ["action", "combat", "sword", "fighting", "saber"], "long_description": "In this single-player arcade combat and sword-slicing VR experience, wield powerful energy weapons and abilities against an army of corrupt cyber-machines sent to hunt down and destroy the last of your kind.\n\nBattle through 30 missions filled with close-range duels, ranged laser fire, boss fights, bonus rounds, and a firing range where you can sharpen your reflexes against different projectile types.\n\n{2226976054760043}\n\n**Fight How You Want**\n\nBlock and counter enemies up close, or throw your plasma weapon in a spinning attack to slice robots from a distance. Absorb energy from defeated enemies to charge powerful abilities, slow time, or unleash a kinetic blast when you are overwhelmed and surrounded.\n\n{1325377069678290}\n\n**Weapons & Customization**\n\nUnlock new weapon types as you progress, each changing how you approach combat. Customize the color of each blade on the three main weapon styles, and choose between automatic or manual activation for more control. Dual-bladed weapons can even activate only the reverse blade for advanced combat options.\n\n    *Single blades\n    *Dual blades\n    *Reverse blades\n    *Dual wielding\n\n{2290896485045214}\n\n**Skill-Based Defense**\n\nYour weapon movement matters. Deflect laser fire back at enemies, counter incoming sword attacks, and use spinning strikes to block attacks. Controlled swings keep your blade stable, while frantic swinging can overheat the power core and temporarily short-circuit your weapon.\n\n{1584261893294357}\n\n**Collectibles**\n\nFind Jump World toys from our 1st game and Shin Zero comics to unlock more weapons and items for your apartment.\n{4513761008843383}", "short_description": "In this single-player arcade combat and sword-slicing VR experience, wield powerful energy weapons and abilities against an army of corrupt cyber-machines sent to hunt down and destroy the last of your kind.\n\nBattle through 30 missions filled with close-range duels, ranged laser fire, boss fights, bonus rounds, and a firing range where you can sharpen your reflexes against different projectile types."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ninjaplayground.com/privacy-policy", "developer_terms_of_ser
OELQCsLE9GMDAH0w020Ip0ZceH0cQ1I8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XShwfCLEw2Hc1VaBUrc53LIDG2cCGw8LgnOaw-4mq7w&oe=6A3AAC3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_CoverImage_2560x1440.png", "id": "1019005276508658", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819374_1019005279841991_3055172403668809679_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o7CZCO8bG-gQ7kNvwHnYveu&_nc_oc=AdrZ6OXpYtFCngJQ_LFxr5BhjJF8U0drQL1SdMJon_ca7EywqNQwxRb8UFlPUYCfIig&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Pg7tQ8sNnsz0Rh5OV89li8KZNk9NCskmD1Vr2KdZnpg&oe=6A3AAAA8"}, "display_name": "Shin Zero Demo", "keywords": ["action", "cyberpunk", "combat", "sword", "fighting"], "long_description": "# Use your plasma saber to deflect laser bolts and slice your way through waves of enemies!\n\nEnter a world of futuristic technology and ancient cyber-swordsmanship in this thrilling VR experience. As an cybernetic enhanced mercenary, wield powerful energy weapons and high-tech gadgets to defend yourself against an onslaught of mechanical beasts, sent to hunt down and destroy the last of your kind.\n\nShin Zero is a single player, arcade combat and sword slicing game where you face off against various challenges, enemy types and large bosses while you block, dodge and defend yourself against their attacks.\n\n{2908377682683315}\n\n# Face Different Challenges:\n- Gun wielding droids.\n- Cyber swordsmen.\n- High security laser beams & walls.\n- Remote drones.\n- Kamikaze guards.\n- Laser turrets.\n- Bosses and more.\n\n{1358061542182968}\n# Use your extended abilities to fight!", "short_description": "As an cybernetic enhanced mercenary, wield powerful energy weapons and high-tech gadgets to defend yourself against an onslaught of mechanical beasts, sent to hunt down and destroy the last of your kind."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ninjaplayground.
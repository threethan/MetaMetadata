uscdn.com&_nc_ss=7f30f&oh=00_AQT6sRjCLKRvPkrKpXX94nDMBZugDgTR1gmwQ5joX41z1g&oe=6B0B45C6"}, {"file_name": "Screenshot_03_2560x1440.png", "id": "1038292182268904", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499313074_1038292185602237_6207154372569939011_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lkJ0JktB9iIQ7kNvwFBO4B-&_nc_oc=AdobseXkMGCg_z_gYJbN-mHuXxjHOH8OQZpRuJZ1QiVwJiCI0vT3kROQ0Ok39URwEtY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR-i8gtSzPjDssNnRCKUOmxBo6HctJUVSmHG63wZUh9ww&oe=6B0B270B"}, {"file_name": "Screenshot_04_2560x1440.png", "id": "2320588172046016", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499312236_2320588175379349_6509240851392167424_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gPyAVzIaI8cQ7kNvwEmWMiV&_nc_oc=AdryStlB1g_v0Z4cl0H23c8MZ6_3plT7ewwS9XPSjE4fr0LUCo0UhCmZxJoo7p4pQdA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSbBd5-fksiAWEttC_IAnNWVcWlMImNiiPbrufga8Z91g&oe=6B0B3CBA"}, {"file_name": "Screenshot_05_2560x1440.png", "id": "1889264702050277", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499312332_1889264708716943_459839500965141556_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ym5QGaY7YxUQ7kNvwF28Atk&_nc_oc=Adoi7tdJVoTNhSapvZQhK5mz3vPVWVtmQVgXOYEuJMuGvqj4rJ_B9JGqGcLkdR4-kgs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQi6SKmXg0857w_2meX0G2Iy_UrI26v3CoqP9M1AtO4dA&oe=6B0B246F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape_2560x1440.png", "id": "27934318042888260", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499314648_27934318049554926_1252765953642826078_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-AovFKOMC8YQ7kNvwF_tlHF&_nc_oc=AdoKgispE_PV1D4YovQNFty_LQY-ltnKTAmuuoQS-psZX8boqT7fYI2hGFTl4SWgSFE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQN-Ll36K8Vv6XaQ7abULn9yxNWY5tmAcs0Wl3tOTlzIA&oe=6B0B34C3"}, "display_name": "Shin Zero Demo", "keywords": ["action", "combat", "sword", "fighting", "saber"], "long_description": "In this single-player arcade combat and sword-slicing VR experience, wield powerful energy weapons and abilities against an army of corrupt cyber-machines sent to hunt down and destroy the last of your kind.\n\nBattle through 30 missions filled with close-range duels, ranged laser fire, boss fights, bonus rounds, and a firing range where you can sharpen your reflexes against different projectile types.\n\n{2226976054760043}\n\n**Fight How You Want**\n\nBlock and counter enemies up close, or throw your plasma weapon in a spinning attack to slice robots from a distance. Absorb energy from defeated enemies to charge powerful abilities, slow time, or unleash a kinetic blast when you are overwhelmed and surrounded.\n\n{1325377069678290}\n\n**Weapons & Customization**\n\nUnlock new weapon types as you progress, each changing how you approach combat. Customize the color of each blade on the three main weapon styles, and choose between automatic or manual activation for more control. Dual-bladed weapons can even activate only the reverse blade for advanced combat options.\n\n    *Single blades\n    *Dual blades\n    *Reverse blades\n    *Dual wielding\n\n{2290896485045214}\n\n**Skill-Based Defense**\n\nYour weapon movement matters. Deflect laser fire back at enemies, counter incoming sword attacks, and use spinning strikes to block attacks. Controlled swings keep your blade stable, while frantic swinging can overheat the power core and temporarily short-circuit your weapon.\n\n{1584261893294357}\n\n**Collectibles**\n\nFind Jump World toys from our 1st game and Shin Zero comics to unlock more weapons and items for your apartment.\n{4513761008843383}", "short_description": "In this single-player arcade combat and sword-slicing VR experience, wield powerful energy weapons and abilities against an 
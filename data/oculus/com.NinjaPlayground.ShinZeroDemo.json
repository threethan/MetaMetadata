c_ohc=aN1GydyXuLEQ7kNvwH7McSU&_nc_oc=AdovR4vaKBKgjAbPRrTvVccQDm-wgLUwOEEnBFOiTLYOLbgT5UyY7lcH6OkVqQy-l_I&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFp5Rv88VTOSTSNXa1A6YVG-bmezlJeV2AbxI6isFrIXg&oe=6A97230B"}, {"file_name": "Screenshot_04_2560x1440.png", "id": "2320588172046016", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499312236_2320588175379349_6509240851392167424_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8-Ot50wLhK4Q7kNvwGPLcXF&_nc_oc=Adpd8wrdJTu7TUn70-BofmHM6xlcjAQRBGrFZKGHAt8WOYwQmcDuWsHrtSJVI0pNDqw&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_fd23LGXp_mGo3N3kkELKr7YO74oDP6-EwQ1QcKX1pg&oe=6A9738BA"}, {"file_name": "Screenshot_05_2560x1440.png", "id": "1889264702050277", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499312332_1889264708716943_459839500965141556_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E4eaqR4w2pgQ7kNvwGndVxg&_nc_oc=AdqNdZBLN_Xdab7W-R-aRc6GBsmnmrIDGUh1fIwa25L6PK1D9M9XlEm--sw7yN-yhcc&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGpVSAdHUtRpd9EGzpJ_rvLwNrG794pXLM5cEYtgCWWrA&oe=6A97206F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape_2560x1440.png", "id": "27934318042888260", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499314648_27934318049554926_1252765953642826078_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UDJMGkHAVywQ7kNvwGRexmL&_nc_oc=AdozZ4FxN0rKe48dmGeR8VyRWPArjaKFhATwPBNEUNst3ZH37fShBpeudG3EWvlxrts&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRLbWdSF_lJqIL7NqS1JxysL-z7RRS5A6Ssm7Mrgjs-A&oe=6A9730C3"}, "display_name": "Shin Zero Demo", "keywords": ["action", "combat", "sword", "fighting", "saber"], "long_description": "In this single-player arcade combat and sword-slicing VR experience, wield powerful energy weapons and abilities against an army of corrupt cyber-machines sent to hunt down and destroy the last of your kind.\n\nBattle through 30 missions filled with close-range duels, ranged laser fire, boss fights, bonus rounds, and a firing range where you can sharpen your reflexes against different projectile types.\n\n{2226976054760043}\n\n**Fight How You Want**\n\nBlock and counter enemies up close, or throw your plasma weapon in a spinning attack to slice robots from a distance. Absorb energy from defeated enemies to charge powerful abilities, slow time, or unleash a kinetic blast when you are overwhelmed and surrounded.\n\n{1325377069678290}\n\n**Weapons & Customization**\n\nUnlock new weapon types as you progress, each changing how you approach combat. Customize the color of each blade on the three main weapon styles, and choose between automatic or manual activation for more control. Dual-bladed weapons can even activate only the reverse blade for advanced combat options.\n\n    *Single blades\n    *Dual blades\n    *Reverse blades\n    *Dual wielding\n\n{2290896485045214}\n\n**Skill-Based Defense**\n\nYour weapon movement matters. Deflect laser fire back at enemies, counter incoming sword attacks, and use spinning strikes to block attacks. Controlled swings keep your blade stable, while frantic swinging can overheat the power core and temporarily short-circuit your weapon.\n\n{1584261893294357}\n\n**Collectibles**\n\nFind Jump World toys from our 1st game and Shin Zero comics to unlock more weapons and items for your apartment.\n{4513761008843383}", "short_description": "In this single-player arcade combat and sword-slicing VR experience, wield powerful energy weapons and abilities against an army of corrupt cyber-machines sent to hunt down and destroy the last of your kind.\n\nBattle through 30 missions filled with close-range duels, ranged laser fire, boss fights, bonus rounds, and a firing range where you can sharpen your reflexes against different projectile types."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ninjaplayground.com/privacy-policy", "developer_terms_of_ser
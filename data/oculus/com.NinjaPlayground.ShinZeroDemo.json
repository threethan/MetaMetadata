uscdn.com&_nc_ss=7f20f&oh=00_AQQ4lVazK6QIOtu3GUpFLiqlN9JBOoBrZl-ap_zuc-CbVA&oe=6B09BC06"}, {"file_name": "Screenshot_03_2560x1440.png", "id": "1038292182268904", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499313074_1038292185602237_6207154372569939011_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lkJ0JktB9iIQ7kNvwE4Kz8o&_nc_oc=AdqxMsmEMapHU2MkztImqlItgvhDvOS4TwYUhYSdhP4_bwQwfYO8_SexDBFvRKYsPe4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRE51JKiZIwMsFg7gMFNe68bcUFWzg9lrV2o5v7DeliGw&oe=6B099D4B"}, {"file_name": "Screenshot_04_2560x1440.png", "id": "2320588172046016", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499312236_2320588175379349_6509240851392167424_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gPyAVzIaI8cQ7kNvwExHqSO&_nc_oc=AdpOy2dYlRUcKiDCJLVEK0G_PwCOItNLd2RtCtMr8NbxvNwitXR9pYgoYx2jzJ-_gxQ&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0fgktLMNcGrpfB4xn4n52pUv8j6Hz_suvIAaiNnXudA&oe=6B09B2FA"}, {"file_name": "Screenshot_05_2560x1440.png", "id": "1889264702050277", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499312332_1889264708716943_459839500965141556_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FQS8cmFmZ9gQ7kNvwF0ddxV&_nc_oc=AdoFMFSH8f_VfzHgeJy8K0FRfm6kknJFhvCrlR27huXxRotAyeYHhmtMh0YrBRYAULY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSiMDxwAfLevJzttR_Lg5FhBw9wCNJcbxRDLE0LmUdH_g&oe=6B09D2EF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape_2560x1440.png", "id": "27934318042888260", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499314648_27934318049554926_1252765953642826078_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-AovFKOMC8YQ7kNvwH4nQZa&_nc_oc=AdqMi-A7Q10yBGQe0uUyRVUuo80AKRWp_qwlO4WhTHJjRsqN1jJLa2-Il8Uwd-DieiQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSC40aQk6f-_OFlSXfjqb3IQpb1LEpgmApMa_mp-BKAqw&oe=6B09AB03"}, "display_name": "Shin Zero Demo", "keywords": ["action", "combat", "sword", "fighting", "saber"], "long_description": "In this single-player arcade combat and sword-slicing VR experience, wield powerful energy weapons and abilities against an army of corrupt cyber-machines sent to hunt down and destroy the last of your kind.\n\nBattle through 30 missions filled with close-range duels, ranged laser fire, boss fights, bonus rounds, and a firing range where you can sharpen your reflexes against different projectile types.\n\n{2226976054760043}\n\n**Fight How You Want**\n\nBlock and counter enemies up close, or throw your plasma weapon in a spinning attack to slice robots from a distance. Absorb energy from defeated enemies to charge powerful abilities, slow time, or unleash a kinetic blast when you are overwhelmed and surrounded.\n\n{1325377069678290}\n\n**Weapons & Customization**\n\nUnlock new weapon types as you progress, each changing how you approach combat. Customize the color of each blade on the three main weapon styles, and choose between automatic or manual activation for more control. Dual-bladed weapons can even activate only the reverse blade for advanced combat options.\n\n    *Single blades\n    *Dual blades\n    *Reverse blades\n    *Dual wielding\n\n{2290896485045214}\n\n**Skill-Based Defense**\n\nYour weapon movement matters. Deflect laser fire back at enemies, counter incoming sword attacks, and use spinning strikes to block attacks. Controlled swings keep your blade stable, while frantic swinging can overheat the power core and temporarily short-circuit your weapon.\n\n{1584261893294357}\n\n**Collectibles**\n\nFind Jump World toys from our 1st game and Shin Zero comics to unlock more weapons and items for your apartment.\n{4513761008843383}", "short_description": "In this single-player arcade combat and sword-slicing VR experience, wield powerful energy weapons and abilities against an 
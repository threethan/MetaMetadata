uscdn.com&_nc_ss=7f30f&oh=00_AQRRr7zWmtSZS4zzDWta7T8wIgrBwb0WwQHkk1D_SSUNZA&oe=6B0DB086"}, {"file_name": "Screenshot_03_2560x1440.png", "id": "1038292182268904", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313074_1038292185602237_6207154372569939011_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NVEGFZLzsb0Q7kNvwFXcDSe&_nc_oc=AdqXC3RrTyQgDo-L_KsuS_LHrUP--Va3SunLke6v4DcSDz9Z3E6cK4DJJox_DJ5bpgg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTPs4nqaRC5nLBjlSqkeN-Pl2FsTudX5Cf9so69pgiQXw&oe=6B0DCA0B"}, {"file_name": "Screenshot_04_2560x1440.png", "id": "2320588172046016", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312236_2320588175379349_6509240851392167424_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bP1MZiGK7GQQ7kNvwFS0rmJ&_nc_oc=Adqxx9ijUDFBsdRH9WBtk3GIgvu0qXHhJQt2XzwgnOnRUpQN_zj3zPhHJP91z7gCV_c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRvP30_FF49XYnVh7XOA-iHz6k5TVnVAfysU_2cepB5QQ&oe=6B0DA77A"}, {"file_name": "Screenshot_05_2560x1440.png", "id": "1889264702050277", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312332_1889264708716943_459839500965141556_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ym5QGaY7YxUQ7kNvwGcTbQ1&_nc_oc=Ado0hX4JoJKLMOQj8JdhVqswCjyo2HLL9qElT1poyfeuuAWXUNAMbe4Kz9pFSy3wh4w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ5L5N8Yv28mx0TRzkeEEVdBqLePw_tUn-7ey0dHWK92w&oe=6B0DC76F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape_2560x1440.png", "id": "27934318042888260", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499314648_27934318049554926_1252765953642826078_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DSPrcJujjqcQ7kNvwF4xzCk&_nc_oc=AdpqPBX5WFMQxSKsAIze3nIAbYAhBxQXUjnN0lg0yTLPrbi6oypeY8Y8Jy2xlfBX1Ho&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ4VvR0wgVRI9IG1bMXaqKS8QkwhYFs2v1fmecfJqiiSg&oe=6B0D9F83"}, "display_name": "Shin Zero Demo", "keywords": ["action", "combat", "sword", "fighting", "saber"], "long_description": "In this single-player arcade combat and sword-slicing VR experience, wield powerful energy weapons and abilities against an army of corrupt cyber-machines sent to hunt down and destroy the last of your kind.\n\nBattle through 30 missions filled with close-range duels, ranged laser fire, boss fights, bonus rounds, and a firing range where you can sharpen your reflexes against different projectile types.\n\n{2226976054760043}\n\n**Fight How You Want**\n\nBlock and counter enemies up close, or throw your plasma weapon in a spinning attack to slice robots from a distance. Absorb energy from defeated enemies to charge powerful abilities, slow time, or unleash a kinetic blast when you are overwhelmed and surrounded.\n\n{1325377069678290}\n\n**Weapons & Customization**\n\nUnlock new weapon types as you progress, each changing how you approach combat. Customize the color of each blade on the three main weapon styles, and choose between automatic or manual activation for more control. Dual-bladed weapons can even activate only the reverse blade for advanced combat options.\n\n    *Single blades\n    *Dual blades\n    *Reverse blades\n    *Dual wielding\n\n{2290896485045214}\n\n**Skill-Based Defense**\n\nYour weapon movement matters. Deflect laser fire back at enemies, counter incoming sword attacks, and use spinning strikes to block attacks. Controlled swings keep your blade stable, while frantic swinging can overheat the power core and temporarily short-circuit your weapon.\n\n{1584261893294357}\n\n**Collectibles**\n\nFind Jump World toys from our 1st game and Shin Zero comics to unlock more weapons and items for your apartment.\n{4513761008843383}", "short_description": "In this single-player arcade combat and sword-slicing VR experience, wield powerful energy weapons and abilities against an army of corrupt cyber-machines sent to hunt down and destroy the last of your kind.\n\nBattle through 30 missions filled with close-range duels, ranged laser fire, boss fights, bonus rounds, and a firing range where you can sharpen your reflexes against different projectile types."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ninjaplayground.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ninja Playground", "support_website_url": null, "website_url": "https://www.ninjaplayground.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28025724193714989"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499314351_1938609156800778_7446949581799100930_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g2gj8GrydugQ7kNvwHWou3U&_nc_oc=AdpKNowInpFWwmDkmpaEExQZgosWCM53jniJWRivfhkdYgpJAM61cSdBE_p06WUr6dk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR1xYmQ-whFkQQmuzGKf9GfxNvrAwyeiy0MwG3slwwYgQ&oe=6B0D9CFE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Shin Zero Demo", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"t
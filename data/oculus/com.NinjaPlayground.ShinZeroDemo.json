c_ohc=eLMlTRjezh8Q7kNvwEPFAnO&_nc_oc=AdpBN8vZlyiKSL8zGPrBFaDxUlY-Q_IZD6ze6xHqEf9N9hf79lCaLBUQfS1yiBTflWo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3YhCfX2Sh9wbduMIjtCv0t8ewJHOKvgNkXSS1O99k4Q&oe=6AD23E4B"}, {"file_name": "Screenshot_04_2560x1440.png", "id": "2320588172046016", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312236_2320588175379349_6509240851392167424_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cTXQqn3qY34Q7kNvwFvpSnJ&_nc_oc=AdoKMa8CiPo7yPSk4-tRdi-COjwDJUmB6cK1SwiwQHtuFje_uayv9_KyMiVPfCGcNk0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPY6qGZ9-Un0b8NJ4dPGzehhNox4DcybH_Y__FdfKcMDA&oe=6AD253FA"}, {"file_name": "Screenshot_05_2560x1440.png", "id": "1889264702050277", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312332_1889264708716943_459839500965141556_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0vP15pfdUfIQ7kNvwFFT8MT&_nc_oc=AdpBFnHutOJTqiMRORz_B1l6B3pTBKyst5noLPbnrniR29JlFZ1X4aATatVwOYOyGpM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6fff_n3e29ZCA0KJLti9KOZ2Km85R-s_iUnqGJOR29w&oe=6AD23BAF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape_2560x1440.png", "id": "27934318042888260", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314648_27934318049554926_1252765953642826078_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mymjE0muuOYQ7kNvwHbk0Gl&_nc_oc=AdqnAUpuQnOKv6TOTkfnH43-NE5yK_QdyRRbrE4HHzP8MILb389vCllSPQkBT-L8DB8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMbTgapwlvRbQ208mHhuCXSrSW9n_kkNLk1f9a8qV76LQ&oe=6AD24C03"}, "display_name": "Shin Zero Demo", "keywords": ["action", "combat", "sword", "fighting", "saber"], "long_description": "In this single-player arcade combat and sword-slicing VR experience, wield powerful energy weapons and abilities against an army of corrupt cyber-machines sent to hunt down and destroy the last of your kind.\n\nBattle through 30 missions filled with close-range duels, ranged laser fire, boss fights, bonus rounds, and a firing range where you can sharpen your reflexes against different projectile types.\n\n{2226976054760043}\n\n**Fight How You Want**\n\nBlock and counter enemies up close, or throw your plasma weapon in a spinning attack to slice robots from a distance. Absorb energy from defeated enemies to charge powerful abilities, slow time, or unleash a kinetic blast when you are overwhelmed and surrounded.\n\n{1325377069678290}\n\n**Weapons & Customization**\n\nUnlock new weapon types as you progress, each changing how you approach combat. Customize the color of each blade on the three main weapon styles, and choose between automatic or manual activation for more control. Dual-bladed weapons can even activate only the reverse blade for advanced combat options.\n\n    *Single blades\n    *Dual blades\n    *Reverse blades\n    *Dual wielding\n\n{2290896485045214}\n\n**Skill-Based Defense**\n\nYour weapon movement matters. Deflect laser fire back at enemies, counter incoming sword attacks, and use spinning strikes to block attacks. Controlled swings keep your blade stable, while frantic swinging can overheat the power core and temporarily short-circuit your weapon.\n\n{1584261893294357}\n\n**Collectibles**\n\nFind Jump World toys from our 1st game and Shin Zero comics to unlock more weapons and items for your apartment.\n{4513761008843383}", "short_description": "In this single-player arcade combat and sword-slicing VR experience, wield powerful energy weapons and abilities against an army of corrupt cyber-machines sent to hunt down and destroy the last of your kind.\n\nBattle through 30 missions filled with close-range duels, ranged laser fire, boss fights, bonus rounds, and a firing range where you can sharpen your reflexes against different projectile types."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ninjaplayground.com/privacy-policy", "developer_terms_of_ser
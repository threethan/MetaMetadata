uscdn.com&_nc_ss=7f20f&oh=00_AQRyGw-ZjvytFpwOfvnCOdtRjsYhYMiChpiR3sxsS-HWiQ&oe=6AFDDE86"}, {"file_name": "Screenshot_03_2560x1440.png", "id": "1038292182268904", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313074_1038292185602237_6207154372569939011_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EF3J_oVvpBUQ7kNvwGfYucT&_nc_oc=Adrgk3GWKEXn2GWgzwHHzf73iMV6JS_6c97tBYhQtnpjmtFEXZL1mkVtBY47ixKzK2s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTr3BbHi3n9KmoED_9OG5IJipqCVJYqyDQwByZSH6v1Sg&oe=6AFDBFCB"}, {"file_name": "Screenshot_04_2560x1440.png", "id": "2320588172046016", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312236_2320588175379349_6509240851392167424_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MhJ4EcttDRoQ7kNvwHU27bW&_nc_oc=AdpxnTY-B9tX9_uLAUkzscOpSguWsXVFYgF4TQEIA6gE0KG7WEmNTf3_7thd3cWgfEU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpUgk69lhkFQfVKIYXy-Z-7Ce8hDT-hqT8MdPOHCj9CA&oe=6AFDD57A"}, {"file_name": "Screenshot_05_2560x1440.png", "id": "1889264702050277", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312332_1889264708716943_459839500965141556_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S7wM-7YmGL4Q7kNvwGJaglA&_nc_oc=Adqhs8SHEL5VQtTl6HW7_7XILfM0NZCLaNOQ8aXek5ZjM9p2wfzUNv4bgF1p0lqOPsk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuyAOe0vc_OONef7a_b5CfWtwR4qpu7oC3DMKpSOMwsQ&oe=6AFDBD2F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape_2560x1440.png", "id": "27934318042888260", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499314648_27934318049554926_1252765953642826078_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=62eqm41MdXUQ7kNvwGJFGIT&_nc_oc=AdqwULQmSR-iFNo4z-3YD5dTLSXj-rnG_A38sZA2IdEPTI8PObKi65p2JRwmCBgft9k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkA506wM8n0eSBENF2UJ6NscGLEB89KTfvAw1-isw23w&oe=6AFDCD83"}, "display_name": "Shin Zero Demo", "keywords": ["action", "combat", "sword", "fighting", "saber"], "long_description": "In this single-player arcade combat and sword-slicing VR experience, wield powerful energy weapons and abilities against an army of corrupt cyber-machines sent to hunt down and destroy the last of your kind.\n\nBattle through 30 missions filled with close-range duels, ranged laser fire, boss fights, bonus rounds, and a firing range where you can sharpen your reflexes against different projectile types.\n\n{2226976054760043}\n\n**Fight How You Want**\n\nBlock and counter enemies up close, or throw your plasma weapon in a spinning attack to slice robots from a distance. Absorb energy from defeated enemies to charge powerful abilities, slow time, or unleash a kinetic blast when you are overwhelmed and surrounded.\n\n{1325377069678290}\n\n**Weapons & Customization**\n\nUnlock new weapon types as you progress, each changing how you approach combat. Customize the color of each blade on the three main weapon styles, and choose between automatic or manual activation for more control. Dual-bladed weapons can even activate only the reverse blade for advanced combat options.\n\n    *Single blades\n    *Dual blades\n    *Reverse blades\n    *Dual wielding\n\n{2290896485045214}\n\n**Skill-Based Defense**\n\nYour weapon movement matters. Deflect laser fire back at enemies, counter incoming sword attacks, and use spinning strikes to block attacks. Controlled swings keep your blade stable, while frantic swinging can overheat the power core and temporarily short-circuit your weapon.\n\n{1584261893294357}\n\n**Collectibles**\n\nFind Jump World toys from our 1st game and Shin Zero comics to unlock more weapons and items for your apartment.\n{4513761008843383}", "short_description": "In this single-player arcade combat and sword-slicing VR experience, wield powerful energy weapons and abilities against an 
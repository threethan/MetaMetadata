uscdn.com&_nc_ss=7f30f&oh=00_AQTJcTNIUw-ylXatAZsr1ua5tYKUF8cDYHSLouMPLsM1rg&oe=6B0C5F06"}, {"file_name": "Screenshot_03_2560x1440.png", "id": "1038292182268904", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499313074_1038292185602237_6207154372569939011_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lkJ0JktB9iIQ7kNvwHGwXqO&_nc_oc=AdrVzYvo_zFZnL31ZbqbIUcYIP9M6pmWrSt4SnN3IK8fHuNRXtfm0YaPe0ArKXI1O3Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRZU69yff32xF81E6m5Ds3amt2FG-2dRzWEC4hYicS7YA&oe=6B0C788B"}, {"file_name": "Screenshot_04_2560x1440.png", "id": "2320588172046016", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312236_2320588175379349_6509240851392167424_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gPyAVzIaI8cQ7kNvwFe_l_I&_nc_oc=AdpH9sMF6kTnfL7kTfedSp7xz25DxMO5PYKvhPyINccE3NpDOozd8pdg-uRS2t1rnDw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTluhgpSfvaKhuHgcntmFC_UMv9IUfQNOqmd7pAZ4CjKw&oe=6B0C55FA"}, {"file_name": "Screenshot_05_2560x1440.png", "id": "1889264702050277", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312332_1889264708716943_459839500965141556_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ym5QGaY7YxUQ7kNvwHZu3jg&_nc_oc=Adp2jcAAupc8Y5WyqgDmLi4rDQmkb2I9iXVh8PmQbLHkVk7HNhCP9fMRQWGgqYixKT8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSDmbHvh1F7GgRBZj18_0gIJjt-VC4eLQ6uMis6yk_KTA&oe=6B0C75EF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape_2560x1440.png", "id": "27934318042888260", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314648_27934318049554926_1252765953642826078_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DSPrcJujjqcQ7kNvwGxzV3C&_nc_oc=AdplDgQOjqUg8ChoJhhykcF-aldbZS-NNIk_jdTKvbbTyG81luYmpRIowZioO4Gaj1A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRvIryXS0eLIeZ05HvLSls2oLqdgc_NCwotaDok7pJSPA&oe=6B0C4E03"}, "display_name": "Shin Zero Demo", "keywords": ["action", "combat", "sword", "fighting", "saber"], "long_description": "In this single-player arcade combat and sword-slicing VR experience, wield powerful energy weapons and abilities against an army of corrupt cyber-machines sent to hunt down and destroy the last of your kind.\n\nBattle through 30 missions filled with close-range duels, ranged laser fire, boss fights, bonus rounds, and a firing range where you can sharpen your reflexes against different projectile types.\n\n{2226976054760043}\n\n**Fight How You Want**\n\nBlock and counter enemies up close, or throw your plasma weapon in a spinning attack to slice robots from a distance. Absorb energy from defeated enemies to charge powerful abilities, slow time, or unleash a kinetic blast when you are overwhelmed and surrounded.\n\n{1325377069678290}\n\n**Weapons & Customization**\n\nUnlock new weapon types as you progress, each changing how you approach combat. Customize the color of each blade on the three main weapon styles, and choose between automatic or manual activation for more control. Dual-bladed weapons can even activate only the reverse blade for advanced combat options.\n\n    *Single blades\n    *Dual blades\n    *Reverse blades\n    *Dual wielding\n\n{2290896485045214}\n\n**Skill-Based Defense**\n\nYour weapon movement matters. Deflect laser fire back at enemies, counter incoming sword attacks, and use spinning strikes to block attacks. Controlled swings keep your blade stable, while frantic swinging can overheat the power core and temporarily short-circuit your weapon.\n\n{1584261893294357}\n\n**Collectibles**\n\nFind Jump World toys from our 1st game and Shin Zero comics to unlock more weapons and items for your apartment.\n{4513761008843383}", "short_description": "In this single-player arcade combat and sword-slicing VR experience, wield powerful energy weapons and abilities against an 
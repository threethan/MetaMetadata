c_ohc=4-ziJM2URNMQ7kNvwGDO66E&_nc_oc=Adr5_x3W8UGiAICa_tuH-vGlAM0mBfrXlgzkjZyXl_1A8_zKYv_5v0My9n-H6To5Rzc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGHUpGidTysiwzT7Zmi72pu6fA6Q86OQrvbgkQOEH1O2Q&oe=6A901B0B"}, {"file_name": "Screenshot_04_2560x1440.png", "id": "2320588172046016", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499312236_2320588175379349_6509240851392167424_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7g1Gu_gOafkQ7kNvwGK1PH7&_nc_oc=AdrjYtwc3k1_eZykDqSaPrWtDf4jRDrQMTj2OzjQIfw_EqZaiv6BGfGUJVhVOHmC47A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHuipLMWc7S4XxTutcqM1q-lUNRzXP_4JDScEhy6wHtZg&oe=6A9030BA"}, {"file_name": "Screenshot_05_2560x1440.png", "id": "1889264702050277", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499312332_1889264708716943_459839500965141556_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D07ETzU5YlgQ7kNvwESvDyq&_nc_oc=AdrbFiRXOf8UNKP6X1Ud4Ii1OzXRid4bMYuYMnN5CUhChRtha9Crij0z3gugg8xXRXY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-ufQ-G7b-kNyQbDbOg4krsiFqrp0duzbSUyP9aO8N7w&oe=6A90186F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape_2560x1440.png", "id": "27934318042888260", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499314648_27934318049554926_1252765953642826078_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qjoIoUvdDEIQ7kNvwEE5D3o&_nc_oc=AdqvUbtsgYtL7kb1bxYb8OBENJaAnjhJnWgYhcXE0MDJVmA-YQCwD513Y0fo4j-0PLg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHrUreIfI6e2qeacp2Fub09uGQDfSafbq37Y5wIjOZtFA&oe=6A9028C3"}, "display_name": "Shin Zero Demo", "keywords": ["action", "combat", "sword", "fighting", "saber"], "long_description": "In this single-player arcade combat and sword-slicing VR experience, wield powerful energy weapons and abilities against an army of corrupt cyber-machines sent to hunt down and destroy the last of your kind.\n\nBattle through 30 missions filled with close-range duels, ranged laser fire, boss fights, bonus rounds, and a firing range where you can sharpen your reflexes against different projectile types.\n\n{2226976054760043}\n\n**Fight How You Want**\n\nBlock and counter enemies up close, or throw your plasma weapon in a spinning attack to slice robots from a distance. Absorb energy from defeated enemies to charge powerful abilities, slow time, or unleash a kinetic blast when you are overwhelmed and surrounded.\n\n{1325377069678290}\n\n**Weapons & Customization**\n\nUnlock new weapon types as you progress, each changing how you approach combat. Customize the color of each blade on the three main weapon styles, and choose between automatic or manual activation for more control. Dual-bladed weapons can even activate only the reverse blade for advanced combat options.\n\n    *Single blades\n    *Dual blades\n    *Reverse blades\n    *Dual wielding\n\n{2290896485045214}\n\n**Skill-Based Defense**\n\nYour weapon movement matters. Deflect laser fire back at enemies, counter incoming sword attacks, and use spinning strikes to block attacks. Controlled swings keep your blade stable, while frantic swinging can overheat the power core and temporarily short-circuit your weapon.\n\n{1584261893294357}\n\n**Collectibles**\n\nFind Jump World toys from our 1st game and Shin Zero comics to unlock more weapons and items for your apartment.\n{4513761008843383}", "short_description": "In this single-player arcade combat and sword-slicing VR experience, wield powerful energy weapons and abilities against an army of corrupt cyber-machines sent to hunt down and destroy the last of your kind.\n\nBattle through 30 missions filled with close-range duels, ranged laser fire, boss fights, bonus rounds, and a firing range where you can sharpen your reflexes against different projectile types."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ninjaplayground.com/privacy-policy", "developer_terms_of_ser
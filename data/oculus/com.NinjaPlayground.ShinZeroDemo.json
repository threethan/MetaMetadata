-nNMq-pKF5e-ciiNyxDeRa20PTHpVsu8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8HtGn96z6bCrq6kD39mNc-wx3EYj-DMJ31-NoJNjagYQ&oe=6A4143BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_CoverImage_2560x1440.png", "id": "1019005276508658", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819374_1019005279841991_3055172403668809679_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BoNSz-FIc4cQ7kNvwHfLR3d&_nc_oc=Adpao6eWi7HbbHcqJ67SC4RjCWTVt1YcnkX13gkeUML5IbwpHnR1SSNuhsQcw45IiLE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-8SSdfQR7YqRGkgL9IV54nkiCKgj940KmW3jGUfXDztg&oe=6A414228"}, "display_name": "Shin Zero Demo", "keywords": ["action", "cyberpunk", "combat", "sword", "fighting"], "long_description": "# Use your plasma saber to deflect laser bolts and slice your way through waves of enemies!\n\nEnter a world of futuristic technology and ancient cyber-swordsmanship in this thrilling VR experience. As an cybernetic enhanced mercenary, wield powerful energy weapons and high-tech gadgets to defend yourself against an onslaught of mechanical beasts, sent to hunt down and destroy the last of your kind.\n\nShin Zero is a single player, arcade combat and sword slicing game where you face off against various challenges, enemy types and large bosses while you block, dodge and defend yourself against their attacks.\n\n{2908377682683315}\n\n# Face Different Challenges:\n- Gun wielding droids.\n- Cyber swordsmen.\n- High security laser beams & walls.\n- Remote drones.\n- Kamikaze guards.\n- Laser turrets.\n- Bosses and more.\n\n{1358061542182968}\n# Use your extended abilities to fight!", "short_description": "As an cybernetic enhanced mercenary, wield powerful energy weapons and high-tech gadgets to defend yourself against an onslaught of mechanical beasts, sent to hunt down and destroy the last of your kind."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ninjaplayground.
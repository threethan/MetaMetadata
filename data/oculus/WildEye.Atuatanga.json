kg4-1.oculuscdn.com&oh=00_Afto89r8aTmWS2KsW8dM2gRx2gHlMwWV5Godz8UJ5-50IA&oe=69A17FCF"}, {"file_name": "ScreenShots_04.png", "id": "3460357554266569", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75203627_3460357557599902_8063571635412978681_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jpmjGsd920EQ7kNvwHNp6wW&_nc_oc=AdmVHxcBrl0MKCZnAOtuPL5RMSjocATenLBSyBvO7VkBZCvG0OhtKO9eqn0vZEOw5pw&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afu4wAC4R3NhrYu_PEb2Q9lXJUXPZzXp-HXfMctTjTQpxw&oe=69A19BE8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Atuatanga_TrailerThumbnail.png", "id": "872106795023650", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75363515_872106798356983_1001094329600048616_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r7Dhnsz-BIsQ7kNvwGqh8GT&_nc_oc=Adkw_EKmf2G11fQCyZSM3JtwX6FSxaNBUY6o83WLXCR_pbbgYJvj2Adju2I97Ou-SVs&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfvTMqJS0DvDzVdxXdAN6gPmJjR1Ei0klKGPzZPnkIoxDQ&oe=69A18351"}, "display_name": "Atuatanga", "keywords": ["M\u0101ori", "culture", "hand", "story", "mythology"], "long_description": "Step into Atuatanga, an immersive virtual reality experience that transports you to the heart of a M\u0101ori worldview. The year is 3011, and Mother Earth, Papat\u016b\u0101nuku has been decimated by mankind. Her bond with Ranginui, Skyfather, has been severed and their children, the Atua, are in hiding.\nFrom the beginning of time, to the heart of Papatuanuku, from the tops of the mountains, to the first breath of life. Your actions will determine the future of humanity. \n\nTime is running out. Can you reawaken the Atua and restore balance to a broken world? 'Kua Takoto Te Manuka.'  The challenge is before you!", "short_description": "Atuatanga is an immersive VR experience that takes you deep into an Indigenous, M\u0101ori worldview. Set in the year 3011, humanity has destroyed the earth and the Atua, the Gods of the elements, are in hiding. You must journ
tl3-1.oculuscdn.com&oh=00_Afv_2XQdSiSuuv-LQ_ZaUGqXYljRVlElnMoJIftW9wmQ3Q&oe=69A5744F"}, {"file_name": "ScreenShots_04.png", "id": "3460357554266569", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75203627_3460357557599902_8063571635412978681_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CoupigLsl6gQ7kNvwEjFgAY&_nc_oc=AdnwwyPQoTyulCoWz0eZsrxxQ8xJ1H1G6RQfhZVtmMKxod8uAMyACuYxKeD-Py4XMzM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afvyql5bKQMPK8FX0l1gpdYPnIwY_FXn2NSJt8wXJp7ykA&oe=69A59068"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Atuatanga_TrailerThumbnail.png", "id": "872106795023650", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75363515_872106798356983_1001094329600048616_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mqa76Jwp7gUQ7kNvwE5ZXGt&_nc_oc=Adl8zcKjKvE9tfogxoQKeldsXdMCQS2ztU_QGgqKCkTQz-QoXavyJaqV2DmfIWkpL4Q&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfvFSL62w9Si5Va_7T6u4MHDikGutSJ1LOpdq_PvK8smkw&oe=69A577D1"}, "display_name": "Atuatanga", "keywords": ["M\u0101ori", "culture", "hand", "story", "mythology"], "long_description": "Step into Atuatanga, an immersive virtual reality experience that transports you to the heart of a M\u0101ori worldview. The year is 3011, and Mother Earth, Papat\u016b\u0101nuku has been decimated by mankind. Her bond with Ranginui, Skyfather, has been severed and their children, the Atua, are in hiding.\nFrom the beginning of time, to the heart of Papatuanuku, from the tops of the mountains, to the first breath of life. Your actions will determine the future of humanity. \n\nTime is running out. Can you reawaken the Atua and restore balance to a broken world? 'Kua Takoto Te Manuka.'  The challenge is before you!", "short_description": "Atuatanga is an immersive VR experience that takes you deep into an Indigenous, M\u0101ori worldview. Set in the year 3011, humanity has destroyed the earth and the Atua, the Gods of the elements, are in hiding. You must journ
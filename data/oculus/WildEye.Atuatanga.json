844406_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vrnp-bAyNpoQ7kNvwFaIFDI&_nc_oc=AdqiD3OPkDn8TvAgHX_xa6JHf7v-wAlrwiuQXwmHPVBoRJb_yatgaqbDi6Ug4gkrfio&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-5i-b9LucHcpQ-TBwNelEFePkX506jgfG6UwgAGmcIZQ&oe=6A22EB0F"}, {"file_name": "ScreenShots_04.png", "id": "3460357554266569", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75203627_3460357557599902_8063571635412978681_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oViZyrpq8F8Q7kNvwHMGMcY&_nc_oc=AdqZYzvOdZ-aR6-TmTgbKYVIupCAiu6WzOYdLSbRDoXj41IL1Jo00EBw8nDqyeofEC4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_CnYLqa24dKPn5rCznkqOl1J39QMPgrrK6VmiGIOuxPg&oe=6A22CEE8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Atuatanga_TrailerThumbnail.png", "id": "872106795023650", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75363515_872106798356983_1001094329600048616_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bmffKksF3uUQ7kNvwFuQeEg&_nc_oc=AdoQ8fyZrFeBS0_J27DRNjzl_uooj-KQWakYU3pnI5sTWlD_44t3w3HLIzNAmS44cMc&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_RcboLAP50gPtD44HT6FrTimdoP-9COKPlFfnzJzALKg&oe=6A22EE91"}, "display_name": "Atuatanga", "keywords": ["M\u0101ori", "culture", "hand", "story", "mythology"], "long_description": "Step into Atuatanga, an immersive virtual reality experience that transports you to the heart of a M\u0101ori worldview. The year is 3011, and Mother Earth, Papat\u016b\u0101nuku has been decimated by mankind. Her bond with Ranginui, Skyfather, has been severed and their children, the Atua, are in hiding.\nFrom the beginning of time, to the heart of Papatuanuku, from the tops of the mountains, to the first breath of life. Your actions will determine the future of humanity. \n\nTime is running out. Can you reawaken the Atua and restore balance to a broken world? 'Kua Takoto Te Manuka.'  The challenge is before you!", "short_description": "Atuatanga is an immersive VR experience that takes you deep into an Indigenous, M\u0101ori worldview. Set in the year 3011, humanity has destroyed the earth and the Atua, the Gods of the elements, are in hiding. You must journey through the realms of the Atua, restore the balance of life and heal the world.\n\"Kua Takoto Te Manuka.\" The challenge is before you"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.wildeyenz.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Wild Eye", "support_website_url": null, "website_url": "https://www.atuatanga.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1043107547362485"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24599654733022319"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/473391880_493506673525479_2701820555851228885_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mCC2L7N8n2QQ7kNvwEKAkU6&_nc_oc=Adprd_N0vYkiidEtJZxpUxtolPl7ib0EPWGlYbfm9QrKIe7UMABqZJrCd0lwOfkbB3Q&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_d2XE50SJjtUTiVpEy8N9cYoDfX61TUjLFb2zwdSsrVA&oe=6A22D7D9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Atuatanga", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_
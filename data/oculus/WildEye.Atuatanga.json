W0oQ7kNvwEB2FZ4&_nc_oc=AdkEk5UdWORyGHN3IQM5UcinfmKcR4NAFAE0Ia6LkWFG139sXwEfJj_5RiqeU2ZUGM0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzZrt9Z5lI_HwpVy1RtxKmCWpKDKDN-qWdqv-Mp7wWshA&oe=69B2A34F"}, {"file_name": "ScreenShots_04.png", "id": "3460357554266569", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75203627_3460357557599902_8063571635412978681_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sXoqwCdS8TUQ7kNvwHKDLBN&_nc_oc=AdlUXZS_tUsSjYJIa08R2aTfoKJm1riK_AWNZscjQpnRudNDON5SGCAl_a95S1ahXUQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyPn8pDK9NrNMZwn5d4iiNGsG3XtfCdarLOoOs-11SHZA&oe=69B2BF68"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Atuatanga_TrailerThumbnail.png", "id": "872106795023650", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75363515_872106798356983_1001094329600048616_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sp7XNPBVQrwQ7kNvwEnIb_I&_nc_oc=Adk0NBpFxVb_sh6uqoh7kYyw0zx5xhPSj5rslYH7Fcc4MRJ5Pivwyadn5eIATb8D7mw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzrM-M_Pysk23cjvS2GYDopuEIz4aeXd-W94fuOTpFrrQ&oe=69B2A6D1"}, "display_name": "Atuatanga", "keywords": ["M\u0101ori", "culture", "hand", "story", "mythology"], "long_description": "Step into Atuatanga, an immersive virtual reality experience that transports you to the heart of a M\u0101ori worldview. The year is 3011, and Mother Earth, Papat\u016b\u0101nuku has been decimated by mankind. Her bond with Ranginui, Skyfather, has been severed and their children, the Atua, are in hiding.\nFrom the beginning of time, to the heart of Papatuanuku, from the tops of the mountains, to the first breath of life. Your actions will determine the future of humanity. \n\nTime is running out. Can you reawaken the Atua and restore balance to a broken world? 'Kua Takoto Te Manuka.'  The challenge is before you!", "short_description": "Atuatanga is an immersive VR experience that takes you deep into an Indigenous, M\
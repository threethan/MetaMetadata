ad3-2.oculuscdn.com&oh=00_Afuy-boO_j_A89qBpg0TSoVg18UtXCsiMAoKbweKcvxPgw&oe=699996CF"}, {"file_name": "ScreenShots_04.png", "id": "3460357554266569", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75203627_3460357557599902_8063571635412978681_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6eGdjfz3aZwQ7kNvwFMKXOS&_nc_oc=AdkOrFtDiIjw0bWr7rcTjVLNLBtiehm5JvA_hI8DUsSh4-CkCjL3bU5LOkd_uqd4qSk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs1RUQi1e43a1zwalRF2Fc0agURHcMl019xhSymGX_T8g&oe=6999B2E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Atuatanga_TrailerThumbnail.png", "id": "872106795023650", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75363515_872106798356983_1001094329600048616_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z4fVI821aDwQ7kNvwHNlBKv&_nc_oc=AdnMjFYhlYmBtJUKeG-lXWYZCVDeh2AOizrITAiI8xwOoldnX-kDFz6qhpgCBpIZlFc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvmP4ZfgGKEs1N6t6sOwdrIw6dvD9S5EhtRwZtjjUy-3Q&oe=69999A51"}, "display_name": "Atuatanga", "keywords": ["M\u0101ori", "culture", "hand", "story", "mythology"], "long_description": "Step into Atuatanga, an immersive virtual reality experience that transports you to the heart of a M\u0101ori worldview. The year is 3011, and Mother Earth, Papat\u016b\u0101nuku has been decimated by mankind. Her bond with Ranginui, Skyfather, has been severed and their children, the Atua, are in hiding.\nFrom the beginning of time, to the heart of Papatuanuku, from the tops of the mountains, to the first breath of life. Your actions will determine the future of humanity. \n\nTime is running out. Can you reawaken the Atua and restore balance to a broken world? 'Kua Takoto Te Manuka.'  The challenge is before you!", "short_description": "Atuatanga is an immersive VR experience that takes you deep into an Indigenous, M\u0101ori worldview. Set in the year 3011, humanity has destroyed the earth and the Atua, the Gods of the elements, are in hiding. You must journ
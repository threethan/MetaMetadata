ad6-1.oculuscdn.com&oh=00_Af1hh2fV-nB1WRRFEQ5kggbokkyLqtFyL--XPvyiRoC3Nw&oe=69F0D20F"}, {"file_name": "ScreenShots_04.png", "id": "3460357554266569", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75203627_3460357557599902_8063571635412978681_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3n01ouLbw3MQ7kNvwECG1cg&_nc_oc=AdosEtAypjeb_5jGQcnpmaPv4Ga1Lj0gYzemDHYncL-yThw4Vfzt5g4ZPoAOMMWHR24&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3gHHkEHdQK44Fn9QtYO-IoUI5lu7J7rWschRx0C_2Jkg&oe=69F0B5E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Atuatanga_TrailerThumbnail.png", "id": "872106795023650", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75363515_872106798356983_1001094329600048616_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VWVmi31qWckQ7kNvwF8kB0Y&_nc_oc=AdpUIjUGUFn55TESpjCTIonbfARhTibfcbTffJBRPNzb7HZRxpFoehfKRvzoMdrBO9c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1rf9in3q6ARNcSBH--3kV0nx1OFZ1My8L7Snycci-_lQ&oe=69F09D51"}, "display_name": "Atuatanga", "keywords": ["M\u0101ori", "culture", "hand", "story", "mythology"], "long_description": "Step into Atuatanga, an immersive virtual reality experience that transports you to the heart of a M\u0101ori worldview. The year is 3011, and Mother Earth, Papat\u016b\u0101nuku has been decimated by mankind. Her bond with Ranginui, Skyfather, has been severed and their children, the Atua, are in hiding.\nFrom the beginning of time, to the heart of Papatuanuku, from the tops of the mountains, to the first breath of life. Your actions will determine the future of humanity. \n\nTime is running out. Can you reawaken the Atua and restore balance to a broken world? 'Kua Takoto Te Manuka.'  The challenge is before you!", "short_description": "Atuatanga is an immersive VR experience that takes you deep into an Indigenous, M\u0101ori worldview. Set in the year 3011, humanity has destroyed the earth and the Atua, the Gods of the elements, are in hiding. You must journ
ad3-2.oculuscdn.com&oh=00_AfscmIZNuCROg5eF6NnYA6CqXaNI8WTiwQMEB7aQqkBtYA&oe=69A02E4F"}, {"file_name": "ScreenShots_04.png", "id": "3460357554266569", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75203627_3460357557599902_8063571635412978681_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uv9hspmpXnIQ7kNvwHIqkXJ&_nc_oc=Adlq-KlLfJDeL6UUscwWcxQ1V6KIQhwN6GSCL0gE_u879HxD2RmhKHKaB_sksG_XZ6Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuOUg2rZon8QLBFTk7EZKQ71P-uiNzq6Az2_R8MaXr36g&oe=69A04A68"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Atuatanga_TrailerThumbnail.png", "id": "872106795023650", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75363515_872106798356983_1001094329600048616_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r7Dhnsz-BIsQ7kNvwF0fR5g&_nc_oc=Adn_M5LIRVbdVglR3Bxxhj4iyhAnpJDY201JJjQpyj18Wc8ph7Az4egXpzHLnfd71Uo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsyqAvES2sHC9Gkv2MRg5rq3X8tl__1oqBrofjKiA9pug&oe=69A031D1"}, "display_name": "Atuatanga", "keywords": ["M\u0101ori", "culture", "hand", "story", "mythology"], "long_description": "Step into Atuatanga, an immersive virtual reality experience that transports you to the heart of a M\u0101ori worldview. The year is 3011, and Mother Earth, Papat\u016b\u0101nuku has been decimated by mankind. Her bond with Ranginui, Skyfather, has been severed and their children, the Atua, are in hiding.\nFrom the beginning of time, to the heart of Papatuanuku, from the tops of the mountains, to the first breath of life. Your actions will determine the future of humanity. \n\nTime is running out. Can you reawaken the Atua and restore balance to a broken world? 'Kua Takoto Te Manuka.'  The challenge is before you!", "short_description": "Atuatanga is an immersive VR experience that takes you deep into an Indigenous, M\u0101ori worldview. Set in the year 3011, humanity has destroyed the earth and the Atua, the Gods of the elements, are in hiding. You must journ
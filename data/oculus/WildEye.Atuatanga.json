ms2-1.oculuscdn.com&oh=00_AftpJ6gJLX3VpPdOrirUCPqqkCMDC8FK2iH4Ea_mZfvawg&oe=699EDCCF"}, {"file_name": "ScreenShots_04.png", "id": "3460357554266569", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75203627_3460357557599902_8063571635412978681_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uv9hspmpXnIQ7kNvwFSjKD-&_nc_oc=AdkoocCgCeQ1gzr0O03i_m5jEG1Zv6cK01UJLugHwFt4Ih9jqGYrkjhaDcjon8UeqqM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afs4af8cDnzIVjNpw_V1UN9fKEe3SdMuhvCpRAvqLhu5rA&oe=699EF8E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Atuatanga_TrailerThumbnail.png", "id": "872106795023650", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75363515_872106798356983_1001094329600048616_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o82XtExkAjkQ7kNvwHf9fqS&_nc_oc=AdnmVNKQ5dZKRGNMxa72Fh6vEJihhrV_CsciE69aBR-ajM0ufqyTMig3lkBmz6HAqPA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfspC01RGMPffCqKm42dcqyU3lW7hMiMi61szg7aeQKn2g&oe=699EE051"}, "display_name": "Atuatanga", "keywords": ["M\u0101ori", "culture", "hand", "story", "mythology"], "long_description": "Step into Atuatanga, an immersive virtual reality experience that transports you to the heart of a M\u0101ori worldview. The year is 3011, and Mother Earth, Papat\u016b\u0101nuku has been decimated by mankind. Her bond with Ranginui, Skyfather, has been severed and their children, the Atua, are in hiding.\nFrom the beginning of time, to the heart of Papatuanuku, from the tops of the mountains, to the first breath of life. Your actions will determine the future of humanity. \n\nTime is running out. Can you reawaken the Atua and restore balance to a broken world? 'Kua Takoto Te Manuka.'  The challenge is before you!", "short_description": "Atuatanga is an immersive VR experience that takes you deep into an Indigenous, M\u0101ori worldview. Set in the year 3011, humanity has destroyed the earth and the Atua, the Gods of the elements, are in hiding. You must journ
844406_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LEqw5YBEiaYQ7kNvwHk7w70&_nc_oc=AdqYlxQaNvOx2WoAf_dulCxMpabtYUeI7G2H2eNfWjx7XST1HBI9OKt27VDwZz6rT-w&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYRwHuJf0eOKu5KmiIK393rSaKkkj53GajDWCL3HYqjA&oe=6AA9640F"}, {"file_name": "ScreenShots_04.png", "id": "3460357554266569", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75203627_3460357557599902_8063571635412978681_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t5hUglfHdQ0Q7kNvwFD5ONr&_nc_oc=Adr4sRv0PJuArg_9cSSmF90SdNOW9JNHsC5qz-OYuvjRFbtB9KyCAmRd_-YrgnYMw5I&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPy1tOZOVin8SqavbgMrqIlm85W4gNXb547mbKrpfKyA&oe=6AA947E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Atuatanga_TrailerThumbnail.png", "id": "872106795023650", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75363515_872106798356983_1001094329600048616_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HqZjJmqppXMQ7kNvwHITImF&_nc_oc=AdpZTLmLK6ND_C_t9GVh4hBfKKQEBo6lHxY36_S5uAZ3CF9yrA6PXNd_Pfla7LxyNIs&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4Xb_Veg6ssNoXrnV6lAACpMzcBHLvSzrvSpWNdIDIbw&oe=6AA96791"}, "display_name": "Atuatanga", "keywords": ["M\u0101ori", "culture", "hand", "story", "mythology"], "long_description": "Step into Atuatanga, an immersive virtual reality experience that transports you to the heart of a M\u0101ori worldview. The year is 3011, and Mother Earth, Papat\u016b\u0101nuku has been decimated by mankind. Her bond with Ranginui, Skyfather, has been severed and their children, the Atua, are in hiding.\nFrom the beginning of time, to the heart of Papatuanuku, from the tops of the mountains, to the first breath of life. Your actions will determine the future of humanity. \n\nTime is running out. Can you reawaken the Atua and restore balance to a broken world? 'Kua Takoto Te Manuka.'  The challenge is before you!", "short_description": "Atuatanga is an immersive VR experience that takes you deep into an Indigenous, M\u0101ori worldview. Set in the year 3011, humanity has destroyed the earth and the Atua, the Gods of the elements, are in hiding. You must journey through the realms of the Atua, restore the balance of life and heal the world.\n\"Kua Takoto Te Manuka.\" The challenge is before you"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.wildeyenz.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Wild Eye", "support_website_url": null, "website_url": "https://www.atuatanga.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1043107547362485"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24599654733022319"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/473391880_493506673525479_2701820555851228885_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EYLDkSPa7dkQ7kNvwGMza2R&_nc_oc=AdrJNh2IX21PbdXIjUOQUeHrdt0oef-W9j4Hj5X8Mwu-wichErISHWwv1ODFJYIDsaM&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWYdc7ooHQ5mrWEpwJfOOB1ebYJU2WzQ0L-Q26UsrVkA&oe=6AA950D9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Atuatanga", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_
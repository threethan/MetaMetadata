844406_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sNg6Cpn3gwAQ7kNvwEXh4YS&_nc_oc=Adonb_ayyv2j0P20cgEV0XUM_EfdYPdknF35nIdC6SrPkWxYoQkxZGsgHElawuNZIgA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-KWTaUNWcjzDGNW8vehivoKefpJUIZxQvn-GB0HOmiqQ&oe=6A36B18F"}, {"file_name": "ScreenShots_04.png", "id": "3460357554266569", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75203627_3460357557599902_8063571635412978681_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j-YovUeWbusQ7kNvwH39LoF&_nc_oc=Ado5okZr56mqQz6v5BOL2lnqLjA4kh_NGYzR_SN0JSAC3cnGs2j-E3ThZr3lsLFKulU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-vnz9hEkHKx_CahE5sYynyMChER_21kr86rugaqbadyg&oe=6A369568"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Atuatanga_TrailerThumbnail.png", "id": "872106795023650", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75363515_872106798356983_1001094329600048616_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PY87b46DhhUQ7kNvwFNQiBW&_nc_oc=AdpsBGt493ejLoba4ymh4_8iFGLVc5DMVD9yQI7RiMoJZCIe_XHRey89_EuIgr0dwBU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_m2b_o6bd7_C9In0xtqXZ7gMe3JETtGxnyao9Oa1IXoQ&oe=6A36B511"}, "display_name": "Atuatanga", "keywords": ["M\u0101ori", "culture", "hand", "story", "mythology"], "long_description": "Step into Atuatanga, an immersive virtual reality experience that transports you to the heart of a M\u0101ori worldview. The year is 3011, and Mother Earth, Papat\u016b\u0101nuku has been decimated by mankind. Her bond with Ranginui, Skyfather, has been severed and their children, the Atua, are in hiding.\nFrom the beginning of time, to the heart of Papatuanuku, from the tops of the mountains, to the first breath of life. Your actions will determine the future of humanity. \n\nTime is running out. Can you reawaken the Atua and restore balance to a broken world? 'Kua Takoto Te Manuka.'  The challenge is before you!", "short_description": "Atuatanga is an immersive VR experience that takes you deep into an Indigenous, M\u0101ori worldview. Set in the year 3011, humanity has destroyed the earth and the Atua, the Gods of the elements, are in hiding. You must journey through the realms of the Atua, restore the balance of life and heal the world.\n\"Kua Takoto Te Manuka.\" The challenge is before you"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.wildeyenz.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Wild Eye", "support_website_url": null, "website_url": "https://www.atuatanga.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1043107547362485"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24599654733022319"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/473391880_493506673525479_2701820555851228885_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4YNrs_wfHkcQ7kNvwELItxo&_nc_oc=Adqy83b-BY6mJ8yV5Eo-p9_zxWHGYi9n9bs8UOwgRg5VA258klHukA3W_FRPVqxUEdI&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9NnzygPLaSdb1k9wbd6pyMAe-jxEhCSxBskiS1sRQFtQ&oe=6A369E59"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Atuatanga", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_
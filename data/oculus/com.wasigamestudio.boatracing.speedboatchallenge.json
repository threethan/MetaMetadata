ew perspective on Meta Quest.\n", "short_description": "Get ready for boat racing on Meta Quest! Pilot a speedboat, master your steering, and experience high-speed water racing in an immersive boat racing game. Take on the water and put your racing skills to the test."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/wasigamestudio/home", "developer_terms_of_service_url": null, "publisher_name": "Wasi Game Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/wasi-game-studio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": [], "id": "1392864313911583"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "2008810236460634"}, {"status": "PUBLISHED", "id": "1062934126767523"}]}, "baseline_offer": {"id": "1062934126767523"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "2008810236460634"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1394324310432250", "version": "0.2"}, "id": "1139120148694885", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__t
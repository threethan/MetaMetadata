cdn.com/v/t64.5771-25/491831569_1884970215586581_7890867858658855060_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Q-Nq7n3vssQ7kNvwE-G0Pr&_nc_oc=Admt4pAUnAr-zlkQPGdW_G7Lz-vKOvU1ORO9gQfzonMxtUn6PMDrWaivFHyMP5C2sz4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzFsKtIlViumvXPwGEiIvr2kl1p9SzIDsyPHDwGQrt3cg&oe=69B29FD4"}, {"file_name": "Meta_Screenshot_05.png", "id": "1201926861252558", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819473_1201926864585891_8294598904101828179_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MSgfh8OFBUMQ7kNvwGIHTDq&_nc_oc=AdlJj4jlF0ZYHBd6O_nZ9iRSMp6W_Bhg2hzxa7YKYDqaxsEfxLZzxNKwqAAFgSe7leI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxGEnsu5UOy_lECUzEZ0LppXTVczEcJjdP2l0l-qIZsEA&oe=69B2B70A"}, {"file_name": "Meta_Screenshot_06.png", "id": "1678121006240619", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821755_1678121009573952_9162037628264904400_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mRiq49dB1nEQ7kNvwHCphP7&_nc_oc=AdkKFkMh9-MJUitsKku0G7-PmNTBF-F3lcvLX7uw9DFsGkJ_QjIGbpX4-RVj5zHRpoc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyDtwMlq6taT8hCCEcsplaCInGyFtgWMpcb6g03_6jeuw&oe=69B2CBAE"}, {"file_name": "Meta_Screenshot_07.png", "id": "1268863441478678", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822495_1268863444812011_6644257884790191303_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5kKSc0LbGIoQ7kNvwH1RMeI&_nc_oc=Adl5QVo5ifnslbLbeeSHU8d88aDnIOUIFdWWIHOQ_f95PAtVFl7h3Om0dw-W_y4XgRY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afzy5Gxk6A_qbXu-mjYydhTiuwCK6goyEsJtlfYClXr4Ew&oe=69B2A7A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "250529_AppStorePromo_16x9_Music_Drew_4k.png", "id": "1004620755220110", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499301429_1004620758553443_5726085844400761926_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rdwc5Zls1wsQ7kNvwFm4y9-&_nc_oc=AdmKZyzg7eWffZWEnrpv74P2kcGtUzkNlU9rxEneyH1nGJ2aIxOLOIZz6AnrVKuc9pE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxfYWat1iQGuFNzq173Fn1rJnKPVEU-7wQcUrSCSZMUvA&oe=69B2AEE6"}, "display_name": "Vast Haven-1 VR", "keywords": [], "long_description": "Step into Haven-1, the world\u2019s first commercial space station. Built by Vast in Long Beach, California, Haven-1 is a next-generation space station, home to an innovation lab for both private astronauts and government missions.\n\nIn this journey, you\u2019ll be guided by NASA Veteran Astronaut and Vast Lead Astronaut Andrew Feustel as you unlock the hatch to enter Haven-1, navigating your way through its corridor to explore the interior of the space station. Explore and interact with crew storage areas, the common area, the ergonomic crew quarters, and payloads in the Haven-1 Lab. Enjoy an expansive, 180-degree view of Earth through the domed window, and experience the overview effect like a real astronaut.\n\nDiscover the future of space habitation from the point of view of an astronaut and experience life aboard Haven-1, where innovation meets the cosmos.\n", "short_description": "Step into Haven-1, the world's first commercial space station. Unlock its hatch to navigate through the interior of the station, where you can interact with the storage area, the crew quarters, the Haven-1 Lab, and a stunning, 180-degree view of Earth."}]}, "developer_name": "Vast Space, LLC", "developer_privacy_policy_url": "https://www.vastspace.com/haven-1-vr/privacy-policy", "developer_terms_of_service_url": "https://www.vastspace.com/haven-1-vr/end-user-license-agreement", "publisher_name": "Vast Space, LLC", "support_website_url": null, "website_url": "https://www.vastspace.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED
ng?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6gwVFRIzMdgQ7kNvwGGtRu0&_nc_oc=Admr8X2oThJAAMKbIB-Y3zV_KHKWns-60s3BMxVVNqVnzFv_42RXDD6dW3FjSTNuGCQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afs5O6UHw8FxT01TeRYWPmzz9aNWn10LIJL1D-YNb2uv3w&oe=69A570D4"}, {"file_name": "Meta_Screenshot_05.png", "id": "1201926861252558", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819473_1201926864585891_8294598904101828179_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5LygGi5ZY0sQ7kNvwGNVHQY&_nc_oc=AdlhCTKTIxkgH8uKQLfTsSU0g_VIO5L-2HVpcBmyr0buCdKRpoTeJjireqFVHQMepeM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Aftr2TIdZ9qQKyeycVz9kDlvSJiUuLtOSygdDScqSZywRA&oe=69A5880A"}, {"file_name": "Meta_Screenshot_06.png", "id": "1678121006240619", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821755_1678121009573952_9162037628264904400_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CmtrVVwHhpMQ7kNvwEfy8cr&_nc_oc=AdmtCtRvU0PqF4QbCguoWlCSJ7K68lsRi5MWoLICLsfxfz7r6xCBPu5qB3-sjjycuwo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfsSkp9zb1KWer6JYzQ8PsTWjzDwJviOtLRLrT5QuU0bLQ&oe=69A59CAE"}, {"file_name": "Meta_Screenshot_07.png", "id": "1268863441478678", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491822495_1268863444812011_6644257884790191303_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RTUdCMNA4TcQ7kNvwFiwAw5&_nc_oc=AdlRcko3KmFxCfKjei8cK4NeRSfOw6X7HSl5NqppOQ9deCksJUkhykeojD1fJs9ejLM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfuZRZ42lT2lYFH4nhRPCFVBFGkMCxzxjz4Sc2fty0AATw&oe=69A578A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "250529_AppStorePromo_16x9_Music_Drew_4k.png", "id": "1004620755220110", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499301429_1004620758553443_5726085844400761926_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TwMu8wtKQGcQ7kNvwG958W9&_nc_oc=Adk8zEAFJyCqI1G7I9u97iehBUt7hnHNIs-1qTXR7s-g1RemtY_hafBiZX3lT7dATP8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Aftb8mtJna6AXx1jFk9WIlku6QgJAvNl5mek6UnBS1T-lQ&oe=69A57FE6"}, "display_name": "Vast Haven-1 VR", "keywords": [], "long_description": "Step into Haven-1, the world\u2019s first commercial space station. Built by Vast in Long Beach, California, Haven-1 is a next-generation space station, home to an innovation lab for both private astronauts and government missions.\n\nIn this journey, you\u2019ll be guided by NASA Veteran Astronaut and Vast Lead Astronaut Andrew Feustel as you unlock the hatch to enter Haven-1, navigating your way through its corridor to explore the interior of the space station. Explore and interact with crew storage areas, the common area, the ergonomic crew quarters, and payloads in the Haven-1 Lab. Enjoy an expansive, 180-degree view of Earth through the domed window, and experience the overview effect like a real astronaut.\n\nDiscover the future of space habitation from the point of view of an astronaut and experience life aboard Haven-1, where innovation meets the cosmos.\n", "short_description": "Step into Haven-1, the world's first commercial space station. Unlock its hatch to navigate through the interior of the station, where you can interact with the storage area, the crew quarters, the Haven-1 Lab, and a stunning, 180-degree view of Earth."}]}, "developer_name": "Vast Space, LLC", "developer_privacy_policy_url": "https://www.vastspace.com/haven-1-vr/privacy-policy", "developer_terms_of_service_url": "https://www.vastspace.com/haven-1-vr/end-user-license-agreement", "publisher_name": "Vast Space, LLC", "support_website_url": null, "website_url": "https://www.vastspace.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended
ng?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mZ8PHBPBrnoQ7kNvwEnf-th&_nc_oc=AdlXO1SG3wxZE5Dn00OXqeeCf9VtOCGYYKvdvV0TJAtXSwqBBZzZl4ZjcMiMrQL_jUw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvC_deelGxEPeNc83i8cxAOTHejCX0W3VVS8CuLvINw6w&oe=699C3654"}, {"file_name": "Meta_Screenshot_05.png", "id": "1201926861252558", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819473_1201926864585891_8294598904101828179_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NfwD4ujwIJEQ7kNvwGxobls&_nc_oc=AdldSZT64waIApbNpbamGwia_vKvuQPYsTz-TzkezfeqAx95ZKsvdiW_F1Bpa86iwAE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsfMUvanRt43bXJwj9uWZx3-hyHGuVPFVv2ZKs2-P4mTQ&oe=699C4D8A"}, {"file_name": "Meta_Screenshot_06.png", "id": "1678121006240619", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821755_1678121009573952_9162037628264904400_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qqxCFVrqqz8Q7kNvwGe2cy1&_nc_oc=AdlCiXInA9x8rnpWXm7Mw4e9oK0WvghLxP5c_9aZy-0fB9OYvh24DA9Pb0SiHaIzm9o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfspHnGZioB0AvJ_Lp35qvarxvnxquHrUt7PfmoRxLw-xw&oe=699C622E"}, {"file_name": "Meta_Screenshot_07.png", "id": "1268863441478678", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822495_1268863444812011_6644257884790191303_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F8PvzKyBWO4Q7kNvwEVRZr9&_nc_oc=AdkcD8omyTU1BUEPyl59SUe3EgLZytqLM2Agl3h4Uz2X5XOhGqAkh_HCzEG0Qxb1Tv8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftoeCzQPWugkD3R3VaDM-DF7A-2ojnFhspseIhd-C7pjA&oe=699C3E25"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "250529_AppStorePromo_16x9_Music_Drew_4k.png", "id": "1004620755220110", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499301429_1004620758553443_5726085844400761926_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MdlkHlF2IvQQ7kNvwF7n96T&_nc_oc=AdmEhi-I7iW2NXvFqATKdvjxC0NzjJKIf1r-3-cQxEW2yH9TF35x4afaprgYVJQ5VOw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftIPMhrbymEnFCBzDAgzVWL5Se_yJkpV4JmqStcEpcDSQ&oe=699C4566"}, "display_name": "Vast Haven-1 VR", "keywords": [], "long_description": "Step into Haven-1, the world\u2019s first commercial space station. Built by Vast in Long Beach, California, Haven-1 is a next-generation space station, home to an innovation lab for both private astronauts and government missions.\n\nIn this journey, you\u2019ll be guided by NASA Veteran Astronaut and Vast Lead Astronaut Andrew Feustel as you unlock the hatch to enter Haven-1, navigating your way through its corridor to explore the interior of the space station. Explore and interact with crew storage areas, the common area, the ergonomic crew quarters, and payloads in the Haven-1 Lab. Enjoy an expansive, 180-degree view of Earth through the domed window, and experience the overview effect like a real astronaut.\n\nDiscover the future of space habitation from the point of view of an astronaut and experience life aboard Haven-1, where innovation meets the cosmos.\n", "short_description": "Step into Haven-1, the world's first commercial space station. Unlock its hatch to navigate through the interior of the station, where you can interact with the storage area, the crew quarters, the Haven-1 Lab, and a stunning, 180-degree view of Earth."}]}, "developer_name": "Vast Space, LLC", "developer_privacy_policy_url": "https://www.vastspace.com/haven-1-vr/privacy-policy", "developer_terms_of_service_url": "https://www.vastspace.com/haven-1-vr/end-user-license-agreement", "publisher_name": "Vast Space, LLC", "support_website_url": null, "website_url": "https://www.vastspace.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended
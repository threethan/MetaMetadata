ng?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ep19MQAm0PAQ7kNvwEo-JO0&_nc_oc=Adlnk5HXj0J3rDhEg1exlQxKdL5qSmQDeByUnV4DQKC9h6dkxYtdu-hBY1QIljA1hg4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftGKDebYL3jURGT7HU0rl3AJfCvbMU6fGEkmuybyzRCHA&oe=69A41F54"}, {"file_name": "Meta_Screenshot_05.png", "id": "1201926861252558", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819473_1201926864585891_8294598904101828179_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5LygGi5ZY0sQ7kNvwH1XvVL&_nc_oc=AdmCzCR6TMSTxiB1ZdiVYp16qKWN3fI_hbSBpQa_-5q6aBkRhcjWI5ug9Gn9blJI5DY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afsx00DJEkPtS5tDmVIsvPq6dYehF8PHtfW4No2NzRT1Ag&oe=69A4368A"}, {"file_name": "Meta_Screenshot_06.png", "id": "1678121006240619", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821755_1678121009573952_9162037628264904400_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Td-v-LekWAQ7kNvwGbUWGP&_nc_oc=Adnm_pjh_DnF32gVJOezK522tTN-qV065LzG7riV2v6GzluryP-9ltINQjnJ4PUGqIk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftL4rBWWDQPR7kOtQYa4s6s6mjlJPP8Eq0ayifNsFjJMg&oe=69A44B2E"}, {"file_name": "Meta_Screenshot_07.png", "id": "1268863441478678", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822495_1268863444812011_6644257884790191303_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RTUdCMNA4TcQ7kNvwH4EcFA&_nc_oc=AdlWm-RrdH8-E-qHzHu95bZ0hC_RMtqTRjSKrEui5MVvTPllDTRKYmnQujoMFv6hyqA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvyvAnIlDqyoBNsPa1mrj3OFIROhPlwr5LODUQL4Az5QA&oe=69A42725"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "250529_AppStorePromo_16x9_Music_Drew_4k.png", "id": "1004620755220110", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499301429_1004620758553443_5726085844400761926_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TwMu8wtKQGcQ7kNvwEm5E3E&_nc_oc=AdnfOUDUNEm2OjbN-HAVBf_DO3k_tv2pFQbaKqg_lRx7o3qsySQ21eDH3LV-Y-01yis&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afu399kdE_-juDrmEDVjp8wapoSKfICXG0-XCGQ87ad62Q&oe=69A42E66"}, "display_name": "Vast Haven-1 VR", "keywords": [], "long_description": "Step into Haven-1, the world\u2019s first commercial space station. Built by Vast in Long Beach, California, Haven-1 is a next-generation space station, home to an innovation lab for both private astronauts and government missions.\n\nIn this journey, you\u2019ll be guided by NASA Veteran Astronaut and Vast Lead Astronaut Andrew Feustel as you unlock the hatch to enter Haven-1, navigating your way through its corridor to explore the interior of the space station. Explore and interact with crew storage areas, the common area, the ergonomic crew quarters, and payloads in the Haven-1 Lab. Enjoy an expansive, 180-degree view of Earth through the domed window, and experience the overview effect like a real astronaut.\n\nDiscover the future of space habitation from the point of view of an astronaut and experience life aboard Haven-1, where innovation meets the cosmos.\n", "short_description": "Step into Haven-1, the world's first commercial space station. Unlock its hatch to navigate through the interior of the station, where you can interact with the storage area, the crew quarters, the Haven-1 Lab, and a stunning, 180-degree view of Earth."}]}, "developer_name": "Vast Space, LLC", "developer_privacy_policy_url": "https://www.vastspace.com/haven-1-vr/privacy-policy", "developer_terms_of_service_url": "https://www.vastspace.com/haven-1-vr/end-user-license-agreement", "publisher_name": "Vast Space, LLC", "support_website_url": null, "website_url": "https://www.vastspace.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended
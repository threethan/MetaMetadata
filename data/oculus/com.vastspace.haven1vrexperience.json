cdn.com/v/t64.5771-25/491831569_1884970215586581_7890867858658855060_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OCJxXoXVTEIQ7kNvwEG2VGV&_nc_oc=AdkoAn1L_GbSMcNTeuppeCiY8oMeBUkqPnQeyTySl2Y_btw6OukA8s3ril07M5VRm2I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzFG-h6kFk9puPu7b8Qf52kpsUZpcD9302i54dlDwKlxw&oe=69AFFCD4"}, {"file_name": "Meta_Screenshot_05.png", "id": "1201926861252558", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819473_1201926864585891_8294598904101828179_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ebe7uxPaCqkQ7kNvwGr1SgS&_nc_oc=AdntSBCxSi1KTwl_u4bUG-njcUoxsDITQZBrwRXuS5DajIQ8g7q8R4w-Cdx-zvuOz3o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyGA91e9w8XfJcoPouMdCgAwMvv5eFKW-Ms5JCZj-JBMg&oe=69B0140A"}, {"file_name": "Meta_Screenshot_06.png", "id": "1678121006240619", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821755_1678121009573952_9162037628264904400_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EMFafW4P--8Q7kNvwGFRwMH&_nc_oc=AdnntFEkpqmxBjM2WA-o2Zms01a6WydQQZR3yx0A_W2ci69f1MI5slQys-7t3gnT7Qc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxD2ayhkzOeQcdGnDtlls2JLYbb57cEj-N_juQG5-3KBg&oe=69B028AE"}, {"file_name": "Meta_Screenshot_07.png", "id": "1268863441478678", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822495_1268863444812011_6644257884790191303_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=paUJz1eTrlQQ7kNvwFsbUpv&_nc_oc=AdmIA0kiRjvV0VjGoBX4E5q4Ph08WUhlw9CGBTpPOZ45dnXZZPz2yV7Sy1JRdqRVaEk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwU9F5NYksIXQ5h4J4eU_J8aeZ0NI0QuSIEWksMcoSpsQ&oe=69B004A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "250529_AppStorePromo_16x9_Music_Drew_4k.png", "id": "1004620755220110", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499301429_1004620758553443_5726085844400761926_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rdwc5Zls1wsQ7kNvwEBSGHs&_nc_oc=AdnO5Ebb_yCwoDXxQg3gXuwPIILa-oh6eyYZPH4PvIPjuEKV_rVHya37ddmNY5I4zQs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy6y_9Twqw9z8M59eyvmMgDl_zKP0TJoUUJ3ThD-9aySA&oe=69B00BE6"}, "display_name": "Vast Haven-1 VR", "keywords": [], "long_description": "Step into Haven-1, the world\u2019s first commercial space station. Built by Vast in Long Beach, California, Haven-1 is a next-generation space station, home to an innovation lab for both private astronauts and government missions.\n\nIn this journey, you\u2019ll be guided by NASA Veteran Astronaut and Vast Lead Astronaut Andrew Feustel as you unlock the hatch to enter Haven-1, navigating your way through its corridor to explore the interior of the space station. Explore and interact with crew storage areas, the common area, the ergonomic crew quarters, and payloads in the Haven-1 Lab. Enjoy an expansive, 180-degree view of Earth through the domed window, and experience the overview effect like a real astronaut.\n\nDiscover the future of space habitation from the point of view of an astronaut and experience life aboard Haven-1, where innovation meets the cosmos.\n", "short_description": "Step into Haven-1, the world's first commercial space station. Unlock its hatch to navigate through the interior of the station, where you can interact with the storage area, the crew quarters, the Haven-1 Lab, and a stunning, 180-degree view of Earth."}]}, "developer_name": "Vast Space, LLC", "developer_privacy_policy_url": "https://www.vastspace.com/haven-1-vr/privacy-policy", "developer_terms_of_service_url": "https://www.vastspace.com/haven-1-vr/end-user-license-agreement", "publisher_name": "Vast Space, LLC", "support_website_url": null, "website_url": "https://www.vastspace.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED
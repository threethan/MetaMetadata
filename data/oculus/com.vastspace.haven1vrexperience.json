cdn.com/v/t64.5771-25/491831569_1884970215586581_7890867858658855060_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OCJxXoXVTEIQ7kNvwFJyh89&_nc_oc=Adks-zwQXo7QvdFFOtZ0j5YouyIpysZSYIG8tEM-TJ07IbnuOGd9j_zZmZez9wOKSsY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxVKkzcsVpriOYOgYh08QgzqklCpShv03LtwFUK9BIW9Q&oe=69AEAB54"}, {"file_name": "Meta_Screenshot_05.png", "id": "1201926861252558", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819473_1201926864585891_8294598904101828179_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ebe7uxPaCqkQ7kNvwE2_rVb&_nc_oc=AdmHczTIT7Wm49I3X_E8sSiGHo-WN3XY5OSczHo1AoWiKlTVRvG5_EPs3Dz7a0hH3fY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwL7vNwhBq7OF1R_FOhCOrKfn3-VdWYlxFTcwjhlZP4kQ&oe=69AEC28A"}, {"file_name": "Meta_Screenshot_06.png", "id": "1678121006240619", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821755_1678121009573952_9162037628264904400_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EMFafW4P--8Q7kNvwHT1-t1&_nc_oc=AdloE7HjNB7c7T_-eMrOPIhoSTsr5f_hZBQukik-nrWDMbJQISZkdQ29MVy2156WlRA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfymXFxn1WdLkRDC13f489hXi7Q8wjpoT5ZiS1pLpbs2Hw&oe=69AED72E"}, {"file_name": "Meta_Screenshot_07.png", "id": "1268863441478678", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822495_1268863444812011_6644257884790191303_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=paUJz1eTrlQQ7kNvwFowJjW&_nc_oc=AdlL9sm-No55vTfNtXIjibeUmK7a_2xa94GKuhnmrWt-vdXyBEjk5yXRlIjpZVYuUDs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxfuwkJ6P9fQXxfpw-Niy923vnQofXmwx-eSJqrY1mZ6Q&oe=69AEB325"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "250529_AppStorePromo_16x9_Music_Drew_4k.png", "id": "1004620755220110", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499301429_1004620758553443_5726085844400761926_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RqH7TO7fA0QQ7kNvwF26vq1&_nc_oc=AdnrTpoYa49qCFzUIuH68d1n-bQvn6M-jumeM5HqYarhTXfTjsK3DiRp-J4qiX3xLm8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwPk1SC6j3hOdJk-HEuudKEnIEaBrL6oJ8JsyTyq6lCYQ&oe=69AEBA66"}, "display_name": "Vast Haven-1 VR", "keywords": [], "long_description": "Step into Haven-1, the world\u2019s first commercial space station. Built by Vast in Long Beach, California, Haven-1 is a next-generation space station, home to an innovation lab for both private astronauts and government missions.\n\nIn this journey, you\u2019ll be guided by NASA Veteran Astronaut and Vast Lead Astronaut Andrew Feustel as you unlock the hatch to enter Haven-1, navigating your way through its corridor to explore the interior of the space station. Explore and interact with crew storage areas, the common area, the ergonomic crew quarters, and payloads in the Haven-1 Lab. Enjoy an expansive, 180-degree view of Earth through the domed window, and experience the overview effect like a real astronaut.\n\nDiscover the future of space habitation from the point of view of an astronaut and experience life aboard Haven-1, where innovation meets the cosmos.\n", "short_description": "Step into Haven-1, the world's first commercial space station. Unlock its hatch to navigate through the interior of the station, where you can interact with the storage area, the crew quarters, the Haven-1 Lab, and a stunning, 180-degree view of Earth."}]}, "developer_name": "Vast Space, LLC", "developer_privacy_policy_url": "https://www.vastspace.com/haven-1-vr/privacy-policy", "developer_terms_of_service_url": "https://www.vastspace.com/haven-1-vr/end-user-license-agreement", "publisher_name": "Vast Space, LLC", "support_website_url": null, "website_url": "https://www.vastspace.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED
ng?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mZ8PHBPBrnoQ7kNvwFMeJmj&_nc_oc=AdlXnAUmBy9PqyXkY4mQzqnuv6S9XcsXIlYixVR6_39N84TAJvdVqQ1CPvPjENrZ-HE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afu-VVbB4-my954jzC88k63RG_b4OcoGczvZv3WyMtzzYA&oe=699AE4D4"}, {"file_name": "Meta_Screenshot_05.png", "id": "1201926861252558", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819473_1201926864585891_8294598904101828179_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NfwD4ujwIJEQ7kNvwGgpMIy&_nc_oc=Adn8G30_W19sLDHzjFaEC59jjHhOLQDgDYMX6x-KQJukf7v9Pi8I70cyglQkhhmWMGI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsJ84g1g3KoBl_jrwppWoQpxeY66MDs-zetNhMM6BL0-Q&oe=699AFC0A"}, {"file_name": "Meta_Screenshot_06.png", "id": "1678121006240619", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821755_1678121009573952_9162037628264904400_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qqxCFVrqqz8Q7kNvwGOgkUe&_nc_oc=AdnsoyhqFJ8l8ntEYMDL7Xej66CEYbOyZ5DBLqE8bqAz6oEDkL1dg5-xlGuutL_ajds&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aft7S4eJL_ilBQ4Krx5IdEJeXiN5aJc__cRiMiadx8s0ZQ&oe=699B10AE"}, {"file_name": "Meta_Screenshot_07.png", "id": "1268863441478678", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822495_1268863444812011_6644257884790191303_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F8PvzKyBWO4Q7kNvwFjd-hx&_nc_oc=Adl5l64ycAi75iM8NTe765aeeZICa3VSbtenigB3ArYKABZdM3gNiTTJ5B74o4OKXc8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvCkgL4VEJvlpva4nseal_aAcrGN0qrz3NDYLlwPsYJbA&oe=699AECA5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "250529_AppStorePromo_16x9_Music_Drew_4k.png", "id": "1004620755220110", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499301429_1004620758553443_5726085844400761926_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=inAWMvHR584Q7kNvwH14QGk&_nc_oc=Adl0h7idQS8IOcpCW9FBQBadA5rPUDSV7sf0gpOdR18uStun9z-69tUUqyWkHfWz1GA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvMOuqzUpY7KW4SP7exmlVal_57g5VLCkLiyP5pWsTPhA&oe=699AF3E6"}, "display_name": "Vast Haven-1 VR", "keywords": [], "long_description": "Step into Haven-1, the world\u2019s first commercial space station. Built by Vast in Long Beach, California, Haven-1 is a next-generation space station, home to an innovation lab for both private astronauts and government missions.\n\nIn this journey, you\u2019ll be guided by NASA Veteran Astronaut and Vast Lead Astronaut Andrew Feustel as you unlock the hatch to enter Haven-1, navigating your way through its corridor to explore the interior of the space station. Explore and interact with crew storage areas, the common area, the ergonomic crew quarters, and payloads in the Haven-1 Lab. Enjoy an expansive, 180-degree view of Earth through the domed window, and experience the overview effect like a real astronaut.\n\nDiscover the future of space habitation from the point of view of an astronaut and experience life aboard Haven-1, where innovation meets the cosmos.\n", "short_description": "Step into Haven-1, the world's first commercial space station. Unlock its hatch to navigate through the interior of the station, where you can interact with the storage area, the crew quarters, the Haven-1 Lab, and a stunning, 180-degree view of Earth."}]}, "developer_name": "Vast Space, LLC", "developer_privacy_policy_url": "https://www.vastspace.com/haven-1-vr/privacy-policy", "developer_terms_of_service_url": "https://www.vastspace.com/haven-1-vr/end-user-license-agreement", "publisher_name": "Vast Space, LLC", "support_website_url": null, "website_url": "https://www.vastspace.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended
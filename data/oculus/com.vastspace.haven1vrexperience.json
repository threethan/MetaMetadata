cdn.com/v/t64.5771-25/491831569_1884970215586581_7890867858658855060_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kiirHvQNHIAQ7kNvwGHEGhg&_nc_oc=Adk6binfoz9LmenXnoy7ZkNs036P-z38ixXz0LQJuZ10tMYZGzBCSOH25X4zgj7bWU8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyA3tPNspSw3LEeFW6mwXMhm6CpfU_YEviK-aFpmiSW4w&oe=69AC0854"}, {"file_name": "Meta_Screenshot_05.png", "id": "1201926861252558", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819473_1201926864585891_8294598904101828179_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fXIT_pdmQ1gQ7kNvwFkbOOR&_nc_oc=Adk3nCsvIgJBBh-zZf4X-7DdHh6ZWdlHssGXYwVBe1-yIYnDBUwNIzVQOqTD1y22qMk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyQrrCIciHTzoG7QJNi68kanKGayF-2B1SOC6BuZDCNfg&oe=69AC1F8A"}, {"file_name": "Meta_Screenshot_06.png", "id": "1678121006240619", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821755_1678121009573952_9162037628264904400_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tt_3jav9TmIQ7kNvwGpo7at&_nc_oc=Adn4ODJorUWiYJQZCSWzZXhFFrj9Ul3ZtwtIYEa5ivSnONltzzg2NeyU7StaMysyOIU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyIA7m8W1QHXtb_SMFfAm9rWh22dwab7dqUeJU_7KOlZA&oe=69AC342E"}, {"file_name": "Meta_Screenshot_07.png", "id": "1268863441478678", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822495_1268863444812011_6644257884790191303_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HKK1gtg8UfgQ7kNvwGqqjaY&_nc_oc=AdljsUtofBotkSw2-uezdY7moxK_bQW0TPUguETCxK93mOMVHbny-oI7WHC0D2nilSE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afwupghz7EWGmmvPZuUprqeOuBhevbJaZprKIdWHXv7n6A&oe=69AC1025"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "250529_AppStorePromo_16x9_Music_Drew_4k.png", "id": "1004620755220110", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499301429_1004620758553443_5726085844400761926_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RqH7TO7fA0QQ7kNvwFAD7ia&_nc_oc=AdmAQaOROh_S9n8Fy671ZrfnoXYfvjbc7QWSE9ZNasQI7cRE6BWF8x3NTNSBOYTYmfg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy0WAU2wtBcnjLWBV4m8CqztUY8XOVoj_TTANY5HgFfRw&oe=69AC1766"}, "display_name": "Vast Haven-1 VR", "keywords": [], "long_description": "Step into Haven-1, the world\u2019s first commercial space station. Built by Vast in Long Beach, California, Haven-1 is a next-generation space station, home to an innovation lab for both private astronauts and government missions.\n\nIn this journey, you\u2019ll be guided by NASA Veteran Astronaut and Vast Lead Astronaut Andrew Feustel as you unlock the hatch to enter Haven-1, navigating your way through its corridor to explore the interior of the space station. Explore and interact with crew storage areas, the common area, the ergonomic crew quarters, and payloads in the Haven-1 Lab. Enjoy an expansive, 180-degree view of Earth through the domed window, and experience the overview effect like a real astronaut.\n\nDiscover the future of space habitation from the point of view of an astronaut and experience life aboard Haven-1, where innovation meets the cosmos.\n", "short_description": "Step into Haven-1, the world's first commercial space station. Unlock its hatch to navigate through the interior of the station, where you can interact with the storage area, the crew quarters, the Haven-1 Lab, and a stunning, 180-degree view of Earth."}]}, "developer_name": "Vast Space, LLC", "developer_privacy_policy_url": "https://www.vastspace.com/haven-1-vr/privacy-policy", "developer_terms_of_service_url": "https://www.vastspace.com/haven-1-vr/end-user-license-agreement", "publisher_name": "Vast Space, LLC", "support_website_url": null, "website_url": "https://www.vastspace.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED
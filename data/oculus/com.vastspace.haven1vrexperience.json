uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821755_1678121009573952_9162037628264904400_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7PcRXvbd_bQQ7kNvwE4P5Z9&_nc_oc=AdoPRbEGz2EKDm5KpEZM1nUs2pWM-iDM7Zpd-AcCX-V09o8OzVi7ByDcPmzNlviADJ4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6EH5I5B8d5ErRPLFaOp3OK0rmVWz5CWAWITF6NYXYkg&oe=6A7346AE"}, {"file_name": "Meta_Screenshot_07.png", "id": "1268863441478678", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822495_1268863444812011_6644257884790191303_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EFrBymeN3dEQ7kNvwHd1hcM&_nc_oc=AdqV3gwXrHFb2bCAMXErrTxDHugCee_dAcg9IB88HZGViZZf9UC7r1wci8Cc04BA4Dk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFsR3TYlQENj0IUQF3stXZL0iHwZrmP5bCI3Nznjm_mvQ&oe=6A7322A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "250529_AppStorePromo_16x9_Music_Drew_4k.png", "id": "1004620755220110", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499301429_1004620758553443_5726085844400761926_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GS45vmfFZ6IQ7kNvwF1k6f8&_nc_oc=AdoEpc72m2hQhvLtSdypMB16XcBn1d8kGIroXcoumNfxCcKSV2KFve5rtsDj84WvgXc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgkgYUvflRrU50Opf2pcD64UmGJl-bX6MiKVlDXBXN7g&oe=6A7329E6"}, "display_name": "Vast Haven-1 VR", "keywords": [], "long_description": "Step into Haven-1, the world\u2019s first commercial space station. Built by Vast in Long Beach, California, Haven-1 is a next-generation space station, home to an innovation lab for both private astronauts and government missions.\n\nIn this journey, you\u2019ll be guided by NASA Veteran Astronaut and Vast Lead Astronaut Andrew Feustel as you unlock the hatch to enter Haven-1, navigating your way through its corridor to explore the interior of the space station. Explore and interact with crew storage areas, the common area, the ergonomic crew quarters, and payloads in the Haven-1 Lab. Enjoy an expansive, 180-degree view of Earth through the domed window, and experience the overview effect like a real astronaut.\n\nDiscover the future of space habitation from the point of view of an astronaut and experience life aboard Haven-1, where innovation meets the cosmos.\n", "short_description": "Step into Haven-1, the world's first commercial space station. Unlock its hatch to navigate through the interior of the station, where you can interact with the storage area, the crew quarters, the Haven-1 Lab, and a stunning, 180-degree view of Earth."}]}, "developer_name": "Vast Space, LLC", "developer_privacy_policy_url": "https://www.vastspace.com/haven-1-vr/privacy-policy", "developer_terms_of_service_url": "https://www.vastspace.com/haven-1-vr/end-user-license-agreement", "publisher_name": "Vast Space, LLC", "support_website_url": null, "website_url": "https://www.vastspace.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26257420807224172"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499300589_4100980100177572_8732308178809638873_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wBwMqKpBSxIQ7kNvwFRfwuJ&_nc_oc=AdrfdYxq0oxXa7WmAGQCSxsnuyX-ObCf8hPZOpSzaZYsak9Sj2M-4g9-lxw3LKqXjik&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGiQ3p0er
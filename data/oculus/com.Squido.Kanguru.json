96892504247_7361868852065376136_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0uDK3mF74tAQ7kNvwHBkF9U&_nc_oc=AdkBGrPJYE-y738Kst4zlYCgopbcjZ_zrp7QMD0mH_SB4a1v0eNLO2JQFnkGokWsu0Q&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_AfsiG9pwAvw3VGqW5ZothB9PktFfIaR2FTmM4QfiwLQzfQ&oe=69A19BED"}, {"file_name": "Flying_NPC.png", "id": "677536776772662", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/39003281_677536780105995_8276486090699885808_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nklcNrONJpEQ7kNvwHIDYIj&_nc_oc=AdkIw98HxG29DIgiA8f9n1re2mYLxfbUXGO1X_G84WODsFxR8YyguKUaV-EJubznJYY&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_AfvfxczFMfT6wb6jAttpzhDkiA6NPf4DaWB_CyHbsa2lXg&oe=69A1A785"}, {"file_name": "Claw_Ring.png", "id": "677409200346071", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39031308_677409203679404_8062215116938574621_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sW-Q3f-WcJQQ7kNvwE7NvLP&_nc_oc=Adkbhvfb8vHYrXt8kMQZWF1omqgTJ6-oJf5Rr3etf9QRvMLg3KI8FF_AayCwfLC3JxA&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftOgabZqaKgdQmgvLIwPBfqNASzeuIe88xhjBxQ1s0utw&oe=69A192AA"}, {"file_name": "World_2.png", "id": "4828566163930498", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974854_4828566167263831_2140245688094234532_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5dZ6ooqT4nQQ7kNvwH96mq4&_nc_oc=Adn_sPSY-BMXFEIW8yTzE8Emq9HJiSE6rJiROOOx0VNRm0Wr2RXVa8AqplMpjxOaJIo&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfvoK2BEJJHJBQx2VfK92Ow9VCF-r6QOsDAmY-VgqUlLqg&oe=69A1A31A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscap.png", "id": "1128638934555987", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39003280_1128638937889320_8176621081020433459_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ypH0ox3WqisQ7kNvwEA_AdU&_nc_oc=AdnEa9rwMkXGkGKwlDLl3q6yBty2wHlDDBask-DU8O0ZuJxv0jbJ-PIS9NaXWRaWXso&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfuQ4Y3DlvpVqthn6UFk8vvbzhJCQoh6kx5NsnyPuKU9oQ&oe=69A1A592"}, "display_name": "No More Rainbows Beta", "keywords": [], "long_description": "No More Rainbows brings the fun of a classic platformer to VR. Use the intuitive locomotion mechanics to run, jump, and climb using only your hands. Rampage through dozens of colorful worlds to reclaim your desecrated Underworld.\n\nYou play as The Beast. \n\nSince time immemorial you have served as Warden of the Underworld, passing the eternities in a peaceful slumber.\n\nYou are suddenly awoken by joyful melodies piercing the warm darkness. The ashen air now reeks of tulip perfume. The once burning magma floor tiles now feel lush and fresh under your claws. The shrines desecrated with childish chalk drawings festooned with smiley faces.\n\nUsing an arm based locomotion method, you must spring forth into this fantastical virtual reality platforming world and reclaim your home!\n\nIn the full release:\n\n- Full story mode\n- 3 additional explorable worlds \n- Leadboards\n- Epic boss fights\n- Additional game modes (Infinite Mode)\n-", "short_description": "No More Rainbows brings the fun of a classic platformer to VR. Use the intuitive locomotion mechanics to run, jump, and climb using only your hands. Rampage through dozens of colorful worlds to reclaim your desecrated Underworld."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nomorerainbows.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Squido Studio", "support_website_url": "http://discord.squidostudio.com/", "website_url": "https://nomorerainbows.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_i
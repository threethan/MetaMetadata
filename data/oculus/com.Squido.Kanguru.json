96892504247_7361868852065376136_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7aJCGmgyFxEQ7kNvwEkx2px&_nc_oc=Adn0VP6saBCRB1sF-3EIR0jwkNgbA9XKjZO3S8ySQKgm7FOyXucNTaCsWR-YwKZp1CY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfuCydqJyi9eOBZoL-oAnXRrB1U1K7NrCb3BoBtNqasqsQ&oe=6998616D"}, {"file_name": "Flying_NPC.png", "id": "677536776772662", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003281_677536780105995_8276486090699885808_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ObiCFqq3pnIQ7kNvwGMjL7p&_nc_oc=Adl736CYX8mEa85TlApS1gghSyLmHj0y0_ykp1DWiQa4Xr-vSCPuNcv4AvSiVo3YjiM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftIJ6pk2mSnRYSFNTocpyqvai5GV2wyDsiroy_0d486Wg&oe=69986D05"}, {"file_name": "Claw_Ring.png", "id": "677409200346071", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031308_677409203679404_8062215116938574621_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YvSUocHOz2MQ7kNvwGH4uy2&_nc_oc=AdkhhvCflDvPaHrB47_MbNFRsyA4SWfYWs7evXOIZkaTr2ZLIjVJdJNtPgzXe9_2ecU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afucn7RQ8xM6TnMtF-sHCG9iV9-wDtWR3caMUzpiDurvwA&oe=6998582A"}, {"file_name": "World_2.png", "id": "4828566163930498", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974854_4828566167263831_2140245688094234532_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HH91tyTGhkgQ7kNvwF4ySmt&_nc_oc=AdnE_K-ICVVv7JyGwsuAFHVDPCo0XrXdVnTveZYmCJBFkwAw1-kqZ3WRiyPs_4s1iK0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Aft-I-ezC6a-lmGOgLerCwnfnBOolCP-qPadtd88kk5M1w&oe=6998689A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscap.png", "id": "1128638934555987", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003280_1128638937889320_8176621081020433459_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PdB2t-g8fCMQ7kNvwGz61Sj&_nc_oc=Adkbrk-4pqljEbrKptHTSP00PGmLX2jgp2weqVnXYji7-U7zcS3KRAippJ1Xb_SnBVA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afsv0bEQWJN6ugVshUiqTLMVyTc38EnicuxLaGe7z8-ylg&oe=69986B12"}, "display_name": "No More Rainbows Beta", "keywords": [], "long_description": "No More Rainbows brings the fun of a classic platformer to VR. Use the intuitive locomotion mechanics to run, jump, and climb using only your hands. Rampage through dozens of colorful worlds to reclaim your desecrated Underworld.\n\nYou play as The Beast. \n\nSince time immemorial you have served as Warden of the Underworld, passing the eternities in a peaceful slumber.\n\nYou are suddenly awoken by joyful melodies piercing the warm darkness. The ashen air now reeks of tulip perfume. The once burning magma floor tiles now feel lush and fresh under your claws. The shrines desecrated with childish chalk drawings festooned with smiley faces.\n\nUsing an arm based locomotion method, you must spring forth into this fantastical virtual reality platforming world and reclaim your home!\n\nIn the full release:\n\n- Full story mode\n- 3 additional explorable worlds \n- Leadboards\n- Epic boss fights\n- Additional game modes (Infinite Mode)\n-", "short_description": "No More Rainbows brings the fun of a classic platformer to VR. Use the intuitive locomotion mechanics to run, jump, and climb using only your hands. Rampage through dozens of colorful worlds to reclaim your desecrated Underworld."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nomorerainbows.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Squido Studio", "support_website_url": "http://discord.squidostudio.com/", "website_url": "https://nomorerainbows.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_i
96892504247_7361868852065376136_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pQlt8z1NsL8Q7kNvwEsp_pv&_nc_oc=AdkArTOTlZ2s-ljpFQ3upyJkvOtVSbDoe4JlS1WYErP25ZXPyHe_5iQ_s6498OZru_8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu7e4BXD3KtkwGh_pDmPtmVtvSAGfzfdpFsz0twVMqsPw&oe=69A6E1ED"}, {"file_name": "Flying_NPC.png", "id": "677536776772662", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003281_677536780105995_8276486090699885808_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XRHiazzPtE4Q7kNvwF2JjBj&_nc_oc=AdkweuslduZUip6MkHhAkZ45hGY3caDR-Kf2KBC_qhGcam5Ja8iV6IHJk9Xk_vJrRcc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuJRzrqlAUqzwXdJxeKHrG2-RLuSYIlOZuL9L8Xj1saMw&oe=69A6ED85"}, {"file_name": "Claw_Ring.png", "id": "677409200346071", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031308_677409203679404_8062215116938574621_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IdmwlqOH2_EQ7kNvwH4MsxT&_nc_oc=AdmCphG6FHGgPHNdUvQdq7H_WHAgC1tMOF9OFsMSb1zbScEs1uuTGhi0ZGhc6YoHaos&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvIS1SCclcSr1Hmq6WiX2dCMDVpVKUJSYHvV0zPlb_DIA&oe=69A6D8AA"}, {"file_name": "World_2.png", "id": "4828566163930498", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974854_4828566167263831_2140245688094234532_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_4IiTxBcubwQ7kNvwExwgbU&_nc_oc=Adk3eSey8_u6kpi0N8Gnga7O-WtZLbavbI5HGVlw_RIQsQfgZXu7Sr79F-qjSYDkSFw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuD7NLjkZ8qT7FthHX7SpxKCZYlq1Xlm-vKMPalHYf1qA&oe=69A6E91A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscap.png", "id": "1128638934555987", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003280_1128638937889320_8176621081020433459_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y1HuXL03k4sQ7kNvwEGMCDP&_nc_oc=AdlLXxHx0b_ecfHKMCP-8laZLdpE31Ezr3KyGznkeRlppJPnFLQDiwp27N433bHPBV0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv-_JzTP2EZhoJ7NRFUvk6Sa6Krv9fbn0kdjTeMxMiTqA&oe=69A6EB92"}, "display_name": "No More Rainbows Beta", "keywords": [], "long_description": "No More Rainbows brings the fun of a classic platformer to VR. Use the intuitive locomotion mechanics to run, jump, and climb using only your hands. Rampage through dozens of colorful worlds to reclaim your desecrated Underworld.\n\nYou play as The Beast. \n\nSince time immemorial you have served as Warden of the Underworld, passing the eternities in a peaceful slumber.\n\nYou are suddenly awoken by joyful melodies piercing the warm darkness. The ashen air now reeks of tulip perfume. The once burning magma floor tiles now feel lush and fresh under your claws. The shrines desecrated with childish chalk drawings festooned with smiley faces.\n\nUsing an arm based locomotion method, you must spring forth into this fantastical virtual reality platforming world and reclaim your home!\n\nIn the full release:\n\n- Full story mode\n- 3 additional explorable worlds \n- Leadboards\n- Epic boss fights\n- Additional game modes (Infinite Mode)\n-", "short_description": "No More Rainbows brings the fun of a classic platformer to VR. Use the intuitive locomotion mechanics to run, jump, and climb using only your hands. Rampage through dozens of colorful worlds to reclaim your desecrated Underworld."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nomorerainbows.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Squido Studio", "support_website_url": "http://discord.squidostudio.com/", "website_url": "https://nomorerainbows.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_i
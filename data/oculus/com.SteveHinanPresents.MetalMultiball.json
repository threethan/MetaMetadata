pp88KbNW9TNE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRP1PrDrLpLSHL-PCyVJYeFV2GJdGQYqe7pDEnZZw0UHg&oe=6AF9E253"}, {"file_name": "screenshot_new_2_2560x1440.png", "id": "1399594055581813", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499620530_1399594058915146_5103255193496027434_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3VDPo1T9K58Q7kNvwEifocF&_nc_oc=AdpiHn0JBMli2PCDpMNUjYpzH5UUyxHpoGtl1rmnE3_znHiK67xZdAvUA7xaNf-xquM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRF9jn-A60eo-adISTMbcHFGOpXAqWOwxpq8ldo-MO2nQ&oe=6AF9CCF0"}, {"file_name": "screenshot_maze7_2560x1440.png", "id": "1696359361499188", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499620432_1696359364832521_2003531140318246225_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MNl2FsK4BigQ7kNvwHzuPJ-&_nc_oc=AdqmStKA3Uk5VPK75loVHzJAoFxFlS8nPlFKFzvurACVHviREjyx7P8uaWzIHVvHk6k&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQu0IZEeNuA4Z90tY0xeNx9Pz7TFE4nl0EczO8rav2G8Q&oe=6AF9C0C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "hexapuss_storecoverart_2560x1440.png", "id": "26526537960285959", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499619096_26526537963619292_958717442445242367_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q91bArDss3MQ7kNvwEunJ0Y&_nc_oc=Adrp98EJpt-ujEW_tcqBK-S5c5FVKKfwoXrNXq9eYyc5kFdPproXDkw-650jrDjxpYo&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThvOPWJOUTKU39zBJGT19y6l8uar6B6iqwjAaBfWij_A&oe=6AF9DEB2"}, "display_name": "Hexapuss", "keywords": ["metal", "pinball", "music", "story", "cat"], "long_description": "# HEXAPUSS  \n### *A Pinball. A Band. An Ancient One.*\n\nThe end of reality begins with a single silver ball.\n\nStep inside a living pinball machine where crushing metal music, impossible dimensions, and cosmic horror collide. As the band plays, the entity known as Hexapuss stirs. With each ricochet of the silver ball, filled with metal mayhem and eldritch power.\n\n## Features\n\n\ud83d\udd25 **Pinball From the Inside**  \nExperience pinball in fully immersive VR. Stand inside the machine and brace for chaos.\n\n\ud83c\udf9e\ufe0f **Scene by scene**\nThe Hexapuss movie unfolds as you play.\n\n\ud83c\udfb8 **Metal-Fueled Mayhem**  \nPlay through explosive arenas powered by heavy metal music.\n\n\ud83d\udc19 **The Rise of Hexapuss**  \nTrigger multiballs and unveil the cosmic energy lurking behind every dimension.\n\n\u26a1 **Survive the Ritual**  \nEvery shot and every ricochet pulls you deeper.\n\n## Player Reviews\n\n\u2605\u2605\u2605\u2605\u2605 *\"Pinball madness and fun!\"* \u2014 KungfuMama2\n\n\u2605\u2605\u2605\u2605\u2605 *\"Omg is this game sick\"* \u2014 stevo.sizemore\n\n\u2605\u2605\u2605\u2605\u2605 *\"Chaos and delight!\"* \u2014 Stummo\n\n---\n\n**Metal multiball initiated.  \nThe vortex is open.**\n\n**What role will you play when Hexapuss awakens?**", "short_description": "HEXAPUSS  \nA Pinball. A Band. An Ancient One.\n\nThe end of reality begins with a single silver ball.\n\nFeatures\n\n\ud83d\udd25 Pinball From the Inside\nExperience pinball in fully immersive VR. Stand inside the machine and brace for chaos.\n\n\ud83c\udf9e\ufe0f Scene by scene\nThe Hexapuss movie unfolds as you play.\n\n\ud83c\udfb8 Metal-Fueled Mayhem  \nPlay through explosive arenas powered by heavy metal music.\n\nPlayer Reviews\n\n\u2605\u2605\u2605\u2605\u2605 \"Pinball madness and fun!\" \u2014 KungfuMama2\n\n\u2605\u2605\u2605\u2605\u2605 \"Omg is this game sick\" \u2014 stevo.sizemore\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://stevehinanpresents.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Steve Hinan", "support_website_url": "https://stevehinanpresents.com/support.html", "website_url": "https://stevehinanpresents.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"
x1440.png", "id": "1697466364314824", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393909_1697466370981490_6514067213315501838_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tx7TGqJ9-F4Q7kNvwH8SBx8&_nc_oc=AdlSj680QmI2QQcOLP9RTwmK1Wnkbc2sh-ckUVAu4E8F35n4S6sXd5uT1HH9oklVP-M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afs3ErotEyXVzcc5_bcUq7BggZu1Nn82raY1mWPzSZjyzg&oe=699EEF93"}, {"file_name": "pdp_screenshot_7_2560x1440.png", "id": "1299177661277831", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036648_1299177664611164_2656794448543884034_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xFpVOdehYVAQ7kNvwHX5UmI&_nc_oc=AdlXMAyolOJ9wtj_U412fHECz0KFNJe7XaqmjZW133df1Zd-a3JmfHZ3lPZyPnfgZ-0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuvbXhv3bJCcJte2eU8sx0lMT9kBrDh051qhSWPEB81pw&oe=699EEF50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "hexapuss_large_2560x1440.png", "id": "1768813293835418", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619174_1768813297168751_6136855105530155171_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8UubisMPMpIQ7kNvwH2y5i4&_nc_oc=Adl_CRgA67-eOGSWHYOGQ_0A7nogw3WoZStVm1ln2fV-b4ehcE4SSEKLShKPSGBab8k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuoRD2wj0LDCtmj8OB6mFhOsqfndcbiYAMglTPn7AyuRA&oe=699EE01D"}, "display_name": "Hexapuss", "keywords": ["cat", "metal", "pinball", "music", "story"], "long_description": "**Hexapuss** *\"A pinball, a cat and an ancient one\"*\n\nHexapuss is a first-person VR pinball apocalypse where music, madness, and metal collide. \nTake control, hit the ball. Will you unleash Hexapuss or destroy it? The power is in your hands.\n\n**Features:**\n\n**\u2022 First-Person Pinball Carnage:** Immerse yourself in the machine as you take aim and control the action like never before.\n\n**\u2022 Metal Mayhem:** Bang your head to a virtually live metal concert while playing in stunning pinball-themed music venues.\n\n**\u2022 Shape the Story:** Your decisions will determine Hexapuss\u2019s fate\u2014and the future of reality itself.\n\n**What Critics Are Saying:**  \n*\"Pinball madness and fun!\"* \u2013 KungfuMama2 (5/5)  \n*\"Omg is this game sick\"* \u2013 stevo.sizemore (5/5)  \n*\"Chaos and delight!\"* \u2013 Stummo (5/5)  \n\nA vortex has opened with the frequency of the void, and cosmic power has unleashed.\nAre you ready to take control\u2026 or be consumed?", "short_description": "Hexapuss  \"A pinball, a cat and an ancient one\".\n\nHexapuss is a first-person VR pinball apocalypse where music, madness, and metal collide. \n\nTake control, hit the ball. A vortex has opened with the frequency of the void, and cosmic power has unleashed. Are you ready to take control\u2026 or be consumed?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://stevehinanpresents.com/privacy_policy.pdf", "developer_terms_of_service_url": null, "publisher_name": "Steve Hinan", "support_website_url": "https://stevehinanpresents.com/support.html", "website_url": "https://stevehinanpresents.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "MUSIC", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26867018912888883"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618432_18547216717464
-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTaPsONvcUhRoVxyW4frOSeu506iznZEXkTiSVdhRCvFw&oe=6B0C831F"}, {"file_name": "pdpscreenshot5_2560x1440.png", "id": "428753815051356", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001711_428753818384689_1522422253164281646_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TFCwupoNxPwQ7kNvwFhTpui&_nc_oc=AdpuQoYQ9ZMekIJ9GG2SvUJwDLD2A4z-SyhKX0yijyAwZgzp319tP8SdrMIE2aPnSVA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTBPa3aal-SZgNGN4oM9nUvR6QIvAtVAHlMNx85RxLKWQ&oe=6B0C77D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "storecoverart_2560x1440.png", "id": "442888356916842", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031334_442888360250175_8830731171757784778_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1zNHfffGaHYQ7kNvwGWezPw&_nc_oc=Adoo0NKknvmA7uYoWjdKr8SypMflmwMVyWFUxA4vq2LEnfIT-f_dB00ACElf1l9rDCA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSL4Mo9ZnvIDvgAB0_PeR4e8TCX9d5vGjvYSuxHPtI-Jw&oe=6B0C7714"}, "display_name": "METAL MULTIBALL", "keywords": [], "long_description": "Enter the arena in Metal Multiball, a powerful twist on an arcade classic celebrating the head banging, heart pounding excitement of live metal music. \n\nIn this fast-paced pinball-inspired game, it\u2019s up to you to get the band thrashing by activating their riffs in time. \n\nEasy to learn, hard to put down, and playable seated or standing, Metal Multiball takes the simple mechanic of the classic pinball machine to a full VR experience. \n\nCan you sharpen your reflexes and take on the world leaderboard? \n\n\u201cIt\u2019s Guitar Hero-meets-pinball-meets-pong in first-person 3D. I loved it.\u201d - john.falco.16 \n\nFor soundtrack sheet music, developer feedback and press kit, please visit: https://stevehinanpresents.com/", "short_description": "Enter the arena in Metal Multiball, a powerful twist on an arcade classic celebrating the head banging, heart pounding excitement of live metal music.\n\nIn this fast-paced pinball-inspired game, it\u2019s up to you to get the band thrashing by activating their riffs in time. \n\nEasy to learn, hard to put down, and playable seated or standing, Metal Multiball takes the simple mechanic of the classic pinball machine to a full VR experience. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://stevehinanpresents.com/privacy_policy.pdf", "developer_terms_of_service_url": null, "publisher_name": "Steve Hinan", "support_website_url": "https://stevehinanpresents.com/", "website_url": "https://stevehinanpresents.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "MUSIC", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "476811183967333"}}]}, "scheduled_offers": {"count": 22, "nodes": [{"status": "PUBLISHED", "id": "1668916428014201"}, {"status": "PUBLISHED", "id": "1087055870930355"}, {"status": "PUBLISHED", "id": "27535395596101040"}, {"status": "PUBLISHED", "id": "994643416752167"}, {"status": "CANCELLED", "id": "1702634380871309"}, {"status": "PUBLISHED", "id": "1702936860723440"}, {"status": "PUBLISHED", "id": "911513151425982"}, {"status": "PUBLISHED", "id": "4286566021577489"}, {"status": "PUBLISHED", "id": "1562926328281692"}, {"status": "PUBLISHED", "id": "650988227891810"}, {"status": "PUBLISHED"
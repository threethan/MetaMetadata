KsPgM-MfetJI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGdImGz3tyTdslKHuwd5WPxoAog5k6rJsmY7CjpBQp1TA&oe=6A787713"}, {"file_name": "screenshot_4_2560x1440.png", "id": "1276177003490503", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391938_1276177006823836_6039092087151312502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JvkkulPsEU8Q7kNvwGPV3MM&_nc_oc=Adog4AQQaMwgVqXDlkAq3T1kZd8gqvyFfVz6iiod3jaKa1Cym71xUXKf-hQRI9fFFZE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnxR4pPOq52yFT3ZvUnvWQ6upoBwtrDG-Nv3g29nt7YA&oe=6A788DDE"}, {"file_name": "pdp_screenshot_6_2560x1440.png", "id": "471572279302268", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031603_471572282635601_6005548582376314727_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2BL2ffdTwUsQ7kNvwFr39nq&_nc_oc=AdosTQlSbKM8x_JzokVX8BCkyQrmge3iEfYVZ-3S4-0dEA4M_NXJ-GAGHsDszih8XhA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhV3CUolNamaqlR2ozLJAXOwIOxCHDOeBwc9pUIN694A&oe=6A78729B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "hexapuss_storecoverart_2560x1440.png", "id": "26526537960285959", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_26526537963619292_958717442445242367_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZSBvYd533PMQ7kNvwGcB1jY&_nc_oc=AdonuCMz-GxT66iQaNbXCHfxXANXWR0GD3iz8MiPRei6JRqfoXHlLqntBdgk0taxxNc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGy1qYIR1aj7kCblwUpKQRwu3x2VtTfiRprkomUYfplHw&oe=6A787372"}, "display_name": "Hexapuss", "keywords": ["metal", "pinball", "music", "story", "cat"], "long_description": "# HEXAPUSS  \n### *A Pinball. A Band. An Ancient One.*\n\nThe end of reality begins with a single silver ball.\n\nStep inside a living pinball machine where crushing metal music, impossible dimensions, and cosmic horror collide. As the band plays, the entity known as Hexapuss stirs. With each ricochet of the silver ball, filled with metal mayhem and eldritch power.\n\n## Features\n\n\ud83d\udd25 **Pinball From the Inside**  \nExperience pinball in fully immersive VR. Stand inside the machine and brace for chaos.\n\n\ud83c\udf9e\ufe0f **Scene by scene**\nThe Hexapuss movie unfolds as you play.\n\n\ud83c\udfb8 **Metal-Fueled Mayhem**  \nPlay through explosive arenas powered by heavy metal music.\n\n\ud83d\udc19 **The Rise of Hexapuss**  \nTrigger multiballs and unveil the cosmic energy lurking behind every dimension.\n\n\u26a1 **Survive the Ritual**  \nEvery shot and every ricochet pulls you deeper.\n\n## Player Reviews\n\n\u2605\u2605\u2605\u2605\u2605 *\"Pinball madness and fun!\"* \u2014 KungfuMama2\n\n\u2605\u2605\u2605\u2605\u2605 *\"Omg is this game sick\"* \u2014 stevo.sizemore\n\n\u2605\u2605\u2605\u2605\u2605 *\"Chaos and delight!\"* \u2014 Stummo\n\n---\n\n**Metal multiball initiated.  \nThe vortex is open.**\n\n**What role will you play when Hexapuss awakens?**", "short_description": "HEXAPUSS  \nA Pinball. A Band. An Ancient One.\n\nThe end of reality begins with a single silver ball.\n\nFeatures\n\n\ud83d\udd25 Pinball From the Inside\nExperience pinball in fully immersive VR. Stand inside the machine and brace for chaos.\n\n\ud83c\udf9e\ufe0f Scene by scene\nThe Hexapuss movie unfolds as you play.\n\n\ud83c\udfb8 Metal-Fueled Mayhem  \nPlay through explosive arenas powered by heavy metal music.\n\nPlayer Reviews\n\n\u2605\u2605\u2605\u2605\u2605 \"Pinball madness and fun!\" \u2014 KungfuMama2\n\n\u2605\u2605\u2605\u2605\u2605 \"Omg is this game sick\" \u2014 stevo.sizemore\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://stevehinanpresents.com/privacy_policy.pdf", "developer_terms_of_service_url": null, "publisher_name": "Steve Hinan", "support_website_url": "https://stevehinanpresents.com/support.html", "website_url": "https://stevehinanpresents.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"i
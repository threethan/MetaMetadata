1E7xE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8rXln0z11AQ55BAsAlp60F_9vJEnrfZ0t2k8wc1BP1Ug&oe=6A259C5B"}, {"file_name": "pdp_screenshot_5_2560x1440.png", "id": "1697466364314824", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393909_1697466370981490_6514067213315501838_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dPxTe--XH08Q7kNvwGnYGGW&_nc_oc=AdoFkkLflInIFTbcKXFM8o2j31u5G-0-AYdV1Axg7n9iMPNWQCyuGwoAsLpEwCmCd_0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9IBO8L_HR-Qpx1pqWO2IxslBKCuh04BZpW2Dqq9fDmyA&oe=6A25A0D3"}, {"file_name": "pdp_screenshot_7_2560x1440.png", "id": "1299177661277831", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036648_1299177664611164_2656794448543884034_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kap7LjGhf-8Q7kNvwGYWMT5&_nc_oc=Adry9OP5058WgcKB-YSeDDHp7_nif5p9YidDP_OAvRXdg0_86L-wFd9XLvx-oGAw3RA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9GrLGZNh0ioPfPhT7iYf3Jt7W6lBQh92R5jCIoqp8-ug&oe=6A25A090"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "hexapuss_storecoverart_2560x1440.png", "id": "26526537960285959", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_26526537963619292_958717442445242367_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PhPqrInwkEwQ7kNvwGgW2cj&_nc_oc=AdrQqgJ0CmWednJELRPklAi43YyCPDYq8DR_MKmW1N4QJF4JNPylCueDqcNuknJsPDw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_iY5HP5jIQK4y_ksVyzsfVpkgma41JeAJouqcpukzgsQ&oe=6A259D32"}, "display_name": "Hexapuss", "keywords": ["cat", "metal", "pinball", "music", "story"], "long_description": "**Hexapuss** *\"A pinball, a cat and an ancient one\"*\n\nHexapuss is a first-person VR pinball apocalypse where music, madness, and metal collide. \nTake control, hit the ball. The power is in your hands.\n\n**Features:**\n\n**\u2022 First-Person Pinball Carnage:** Immerse yourself in the machine as you take aim and control the action like never before.\n\n**\u2022 Metal Mayhem:** Bang your head to a virtually live metal concert while playing in stunning pinball-themed music venues.\n\n**\u2022 Shape the Story:** Your decisions will determine Hexapuss\u2019s fate\u2014and the future of reality itself.\n\n**What Critics Are Saying:**  \n*\"Pinball madness and fun!\"* \u2013 KungfuMama2 (5/5)  \n*\"Omg is this game sick\"* \u2013 stevo.sizemore (5/5)  \n*\"Chaos and delight!\"* \u2013 Stummo (5/5)  \n\nA vortex has opened with the frequency of the void, and cosmic power has unleashed.\nAre you ready to take control\u2026 or be consumed?", "short_description": "Hexapuss  \"A pinball, a cat and an ancient one\".\n\nHexapuss is a first-person VR pinball apocalypse where music, madness, and metal collide. \n\nTake control, hit the ball. A vortex has opened with the frequency of the void, and cosmic power has unleashed. Are you ready to take control\u2026 or be consumed?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://stevehinanpresents.com/privacy_policy.pdf", "developer_terms_of_service_url": null, "publisher_name": "Steve Hinan", "support_website_url": "https://stevehinanpresents.com/support.html", "website_url": "https://stevehinanpresents.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "MUSIC", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["
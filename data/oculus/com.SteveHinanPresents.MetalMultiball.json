5pOzzfrKGVg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_oSTzziRBbpEa9oR4ciUa2XRdP91KPhr8H18aR5k4RQ&oe=6A2D5193"}, {"file_name": "screenshot_4_2560x1440.png", "id": "1276177003490503", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391938_1276177006823836_6039092087151312502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dp_PuASsoW4Q7kNvwFsF8Na&_nc_oc=AdpGkHqP7Vo-9658wJrpmQf5QlyGqMDNjwK4yhG-6HEuOWp4XZH-qHJC1GrG5RxemJE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9xPh2hz3EB5HNfcfSZPUUXeK_AIZUy-GeybU2W5N57ug&oe=6A2D685E"}, {"file_name": "pdp_screenshot_6_2560x1440.png", "id": "471572279302268", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031603_471572282635601_6005548582376314727_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N0tvdlT_71gQ7kNvwHFHzvS&_nc_oc=Adr8sar2B_eyS9PeIdmsXfq9YEvzSkQZKyPJDMk7bE39dSLT8lrKiVwPr6v5NmOL1EM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af92iHltxB0GHwaykSU8RjtcsX4QFj1OUpPGnMlpIbdhYA&oe=6A2D4D1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "hexapuss_storecoverart_2560x1440.png", "id": "26526537960285959", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_26526537963619292_958717442445242367_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mABX37_GpBQQ7kNvwH7EjlR&_nc_oc=Adrioa8IYk5Sz7aRSP4fjdRE1Y4HUB0mCj4U62mDxIhxkfprRffvTTG1T7Fe2w4IRmU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9jAxe0AP2BqbUSSob3iANEqLrJ1ZjSAispo8Z294RRpA&oe=6A2D4DF2"}, "display_name": "Hexapuss", "keywords": ["cat", "metal", "pinball", "music", "story"], "long_description": "**Hexapuss** *\"A pinball, a cat and an ancient one\"*\n\nHexapuss is a first-person VR pinball apocalypse where music, madness, and metal collide. \nTake control, hit the ball. The power is in your hands.\n\n**Features:**\n\n**\u2022 First-Person Pinball Carnage:** Immerse yourself in the machine as you take aim and control the action like never before.\n\n**\u2022 Metal Mayhem:** Bang your head to a virtually live metal concert while playing in stunning pinball-themed music venues.\n\n**\u2022 Shape the Story:** Your decisions will determine Hexapuss\u2019s fate\u2014and the future of reality itself.\n\n**What Critics Are Saying:**  \n*\"Pinball madness and fun!\"* \u2013 KungfuMama2 (5/5)  \n*\"Omg is this game sick\"* \u2013 stevo.sizemore (5/5)  \n*\"Chaos and delight!\"* \u2013 Stummo (5/5)  \n\nA vortex has opened with the frequency of the void, and cosmic power has unleashed.\nAre you ready to take control\u2026 or be consumed?", "short_description": "Hexapuss  \"A pinball, a cat and an ancient one\".\n\nHexapuss is a first-person VR pinball apocalypse where music, madness, and metal collide. \n\nTake control, hit the ball. A vortex has opened with the frequency of the void, and cosmic power has unleashed. Are you ready to take control\u2026 or be consumed?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://stevehinanpresents.com/privacy_policy.pdf", "developer_terms_of_service_url": null, "publisher_name": "Steve Hinan", "support_website_url": "https://stevehinanpresents.com/support.html", "website_url": "https://stevehinanpresents.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "MUSIC", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["
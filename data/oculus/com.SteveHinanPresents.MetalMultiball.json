x1440.png", "id": "1697466364314824", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393909_1697466370981490_6514067213315501838_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y5Nf-WmeeEgQ7kNvwEVxnsn&_nc_oc=AdmjBs5HBJhzDr0mf2UDxoawpjcEOc_mgTvTg_wl3kYpO7KFYOzjeQe6-FSnywNRQsQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfstGasn7zvJO7-MSe1krTLdqLjBLg0d6T0wsSQsQkljIw&oe=69A58713"}, {"file_name": "pdp_screenshot_7_2560x1440.png", "id": "1299177661277831", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39036648_1299177664611164_2656794448543884034_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xy7nHIu4kBsQ7kNvwFvSbaV&_nc_oc=AdmzOU48AT7RtWxyTU4NH8QeRTzrAZWeOgCbjaM3OSNjF9f4StwdaYGFKIJki6P2ZFY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfvflkD8UbF9tvj7eFk83h4Dy4BQour9oAw8cZaItaQLVQ&oe=69A586D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "hexapuss_large_2560x1440.png", "id": "1768813293835418", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619174_1768813297168751_6136855105530155171_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hcDrzc04sLIQ7kNvwHwc0ad&_nc_oc=Adm8BrXT5BfzPP9rloi3XTleq4dcLxl04-QtTi5DfSFTiAt63J5O7lddNh6DSbTYNak&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfuoxfFF1FgG_54wCgrgN4_MyT7XpLiopOYxoAIyc4pteA&oe=69A5779D"}, "display_name": "Hexapuss", "keywords": ["cat", "metal", "pinball", "music", "story"], "long_description": "**Hexapuss** *\"A pinball, a cat and an ancient one\"*\n\nHexapuss is a first-person VR pinball apocalypse where music, madness, and metal collide. \nTake control, hit the ball. Will you unleash Hexapuss or destroy it? The power is in your hands.\n\n**Features:**\n\n**\u2022 First-Person Pinball Carnage:** Immerse yourself in the machine as you take aim and control the action like never before.\n\n**\u2022 Metal Mayhem:** Bang your head to a virtually live metal concert while playing in stunning pinball-themed music venues.\n\n**\u2022 Shape the Story:** Your decisions will determine Hexapuss\u2019s fate\u2014and the future of reality itself.\n\n**What Critics Are Saying:**  \n*\"Pinball madness and fun!\"* \u2013 KungfuMama2 (5/5)  \n*\"Omg is this game sick\"* \u2013 stevo.sizemore (5/5)  \n*\"Chaos and delight!\"* \u2013 Stummo (5/5)  \n\nA vortex has opened with the frequency of the void, and cosmic power has unleashed.\nAre you ready to take control\u2026 or be consumed?", "short_description": "Hexapuss  \"A pinball, a cat and an ancient one\".\n\nHexapuss is a first-person VR pinball apocalypse where music, madness, and metal collide. \n\nTake control, hit the ball. A vortex has opened with the frequency of the void, and cosmic power has unleashed. Are you ready to take control\u2026 or be consumed?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://stevehinanpresents.com/privacy_policy.pdf", "developer_terms_of_service_url": null, "publisher_name": "Steve Hinan", "support_website_url": "https://stevehinanpresents.com/support.html", "website_url": "https://stevehinanpresents.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "MUSIC", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26867018912888883"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618432_18547216717464
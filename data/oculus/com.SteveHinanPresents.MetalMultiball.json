FzSA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQeoKbJW082tTR4sUXI5Xe4GD5r5Kuq1Dbyvd9MIxAygg&oe=6B05CAA7"}, {"file_name": "pdp_screenshot_5_2560x1440.png", "id": "1697466364314824", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393909_1697466370981490_6514067213315501838_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T1Ps3Q0jimQQ7kNvwE7JJDz&_nc_oc=AdrVN0f6eQCmZvJZsJRBt3bZ5OEDWUPFNXUyOSunLbGQDw5nV7cPRES7wSOoibUD71I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQeqBlo4WLJ8nO7COOo39HhisJFAEINmQYlywuKbonVjQ&oe=6B05BFD3"}, {"file_name": "screenshot_new_2_2560x1440.png", "id": "1399594055581813", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620530_1399594058915146_5103255193496027434_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a6WbmxFAd-IQ7kNvwEHfeb2&_nc_oc=AdrXOE45ZYWD4FzM2VN5uO4sac6axBDWoH2KapppiDeypRTOanx58BFfcPFlczyawFw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGAF7FGM96NVWv4-5D7w78k1EiTnrUarZ9VkSCsM_U2Q&oe=6B05AA70"}, {"file_name": "screenshot_maze7_2560x1440.png", "id": "1696359361499188", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620432_1696359364832521_2003531140318246225_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ISONDpuMnEkQ7kNvwEITolq&_nc_oc=AdqtOqSedu5f0TKN36c9-PLba4HGZ7GfruUdrYWFucydHAp063M3mOWaHxLE8YCwfh8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTJoTuxHvcrWuKytmz1itotBNk90MadO4JCURVH5mOkw&oe=6B05D689"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "hexapuss_thumbnail.png", "id": "2153255405581110", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499628909_2153255408914443_1631486073155740375_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7MoAxtTQkHMQ7kNvwFYbdxv&_nc_oc=AdrH7GspZDQKK9mPqY7waZQdm0qyx13iLsffQIvnoyuu3_cKV4a00sMYrFm4VwJm47I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSD4B3N1Gy9Xpcaqqqtqti7hw9fdvG4aqFpN5DC3K1xqw&oe=6B05CAEF"}, "display_name": "Hexapuss", "keywords": ["metal", "pinball", "music", "story", "cat"], "long_description": "# HEXAPUSS  \n### *A Pinball. A Band. An Ancient One.*\n\nThe end of reality begins with a single silver ball.\n\nStep inside a living pinball machine where crushing metal music, impossible dimensions, and cosmic horror collide. As the band plays, the entity known as Hexapuss stirs. With each ricochet of the silver ball, filled with metal mayhem and eldritch power.\n\n## Features\n\n\ud83d\udd25 **Pinball From the Inside**  \nExperience pinball in fully immersive VR. Stand inside the machine and brace for chaos.\n\n\ud83c\udf9e\ufe0f **Scene by scene**\nThe Hexapuss movie unfolds as you play.\n\n\ud83c\udfb8 **Metal-Fueled Mayhem**  \nPlay through explosive arenas powered by heavy metal music.\n\n\ud83d\udc19 **The Rise of Hexapuss**  \nTrigger multiballs and unveil the cosmic energy lurking behind every dimension.\n\n\u26a1 **Survive the Ritual**  \nEvery shot and every ricochet pulls you deeper.\n\n## Player Reviews\n\n\u2605\u2605\u2605\u2605\u2605 *\"Pinball madness and fun!\"* \u2014 KungfuMama2\n\n\u2605\u2605\u2605\u2605\u2605 *\"Omg is this game sick\"* \u2014 stevo.sizemore\n\n\u2605\u2605\u2605\u2605\u2605 *\"Chaos and delight!\"* \u2014 Stummo\n\n---\n\n**Metal multiball initiated.  \nThe vortex is open.**\n\n**What role will you play when Hexapuss awakens?**", "short_description": "HEXAPUSS  \nA Pinball. A Band. An Ancient One.\n\nThe end of reality begins with a single silver ball.\n\nFeatures\n\n\ud83d\udd25 Pinball From the Inside\nExperience pinball in fully immersive VR. Stand inside the machine and brace for chaos.\n\n\ud83c\udf9e\ufe0f Scene by scene\nThe Hexapuss movie unfolds as you play.\n\n\ud83c\udfb8 Metal-Fueled Mayhem  \nPlay through explosive arenas powered by heavy metal music.\n\nPlayer Reviews\n\n\u2605\u2605\u2605\u2605\u2605 \"Pinball madness and fun!\" \u2014 KungfuMama2\n\n\u2605\u2605\u2605\u2605\u2605 \"Omg is this game sick\" \u2014 stevo.sizemore\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://stevehinanpresents.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Steve Hinan", "support_website_url": "https://stevehinanpresents.com/support.html", "website_url": "https://stevehinanpresents.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "MUSIC", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "30315196061404467"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619685_1430655772087469_2942814973097975907_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dMlOpwWnSJoQ7kNvwF-44Rx&_nc_oc=AdpvIRICxNRQNTHrFCAsmaAV4mXYQSwWeZiT1JAKMoGdxE6-lDW8pFQTV8zRWRev5r0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSeDwweuDx24WJHleRzjoDwx0d8eIdir1FFBBwdrHqwYw&oe=6B05CDC5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Hexapuss", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Narrative", "id": "1008279844328894"}, {"topic_name
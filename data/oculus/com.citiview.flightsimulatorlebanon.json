w&oe=6AF9C44F"}, {"file_name": "screenshot_3.png", "id": "1078508188498804", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499620316_1078508191832137_3664082343118095554_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q3F9EpNtAasQ7kNvwGGs2WL&_nc_oc=Ado7SuzeFb8KM9tO3tjdlIMJxRuJZLgXcf1IoeEdlQmLlxsTE44mw9RMvEgEfkRkftU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTY99CAykThMGzP4gcriCbEePF6etCUsNfbb7xuY150Rw&oe=6AF9C4D6"}, {"file_name": "screenshot_5.png", "id": "1443219771234754", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499620666_1443219774568087_5936605299860291350_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PQxwxOJtsT8Q7kNvwHs8ZXs&_nc_oc=AdpabB2GwD_HBEJdouWOnMDIBuexAxytmXUNcjNbesPE5xoru5iK0kgjwRSNns20SQQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROdqRXbPWH40aQdXWJbY-0O3Hpr_Cn1U5AcAprBa2Hcw&oe=6AF9B872"}, {"file_name": "screenshot_4.png", "id": "1174302804937675", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499622162_1174302808271008_7926538921230999054_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ik7at8y34MQ7kNvwGEse_h&_nc_oc=AdrD0baPKxH192kEeM25T0hSbZTuMfay6AGT14EQl-0rcPQpx8vX6WC2lXhgTRfjl24&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpLIWToCYoVXoDsOXT6HOEAVVRcIIczwOsGjCGzmmLBA&oe=6AF9B825"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1152026484017051", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/593790560_1152026487350384_7290738510628103054_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mNkZEQtdiqQQ7kNvwF8es4p&_nc_oc=Adp3Zep8Xt_wV1Fp3ayFw9dQ4AMbLO6PHzg3Np9eWrXej7o0GlpSz0zVKBkCY-TaMnQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStfsqMvnEhNQPu2liASzijaXO7CNN92aVguKsiMcLfXg&oe=6AF9D91F"}, "display_name": "Flight Simulator Lebanon", "keywords": ["flight", "simulator", "lebanon", "beirut", "jet"], "long_description": "Flight Simulator Lebanon puts you in the captain's seat over the real Beirut, the Lebanese coast and Mount Lebanon.\n\nTHE REAL BEIRUT\nPigeon Rocks and Raouche, the Manara lighthouse, the Corniche, Zaitunay Bay, the Al-Amin Mosque and St George's Cathedral, Martyrs' Square, Nejmeh Square, the Grand Serail and Sama Beirut.\n\nTHE COAST AND THE MOUNTAINS\nRun the coast from Sidon's Sea Castle past Beirut and Jounieh bay to the old harbour of Byblos. Climb past Our Lady of Lebanon at Harissa to Sannine, Mzaar and the Bekaa valley.\n\nA LIVING CITY\nTraffic on the avenues and ships off the coast. At night the Corniche lights up and the Harissa statue glows.\n\nAIR TRAFFIC CONTROL\nTaxi and takeoff clearances and your landing clearance.\n\nYOUR GLASS HANGAR\nEvery flight starts in your glass hangar on the Beirut waterfront. Repaint, wash, fly.\n\nFOUR AIRCRAFT\nTwo private jets with cabins, a midsize jet and a fighter.\n\nELEVEN MISSIONS\nThe city and sea approaches to Beirut, a sunset hop from Rayak, the Corniche run, around Pigeon Rocks, the coast to Byblos, Rayak to the peaks, Beirut by night, a city tour.\n\nENGLISH AND ARABIC\nMenus in English and Arabic.\n\nFLY TOGETHER ONLINE\nQuick Match or a private sky with a code. Voice chat stays off until you turn it on.", "short_description": "Fly the real Beirut: low along the Corniche past Pigeon Rocks and the Manara lighthouse, over downtown and the blue domes of the Al-Amin Mosque, up the coast to Jounieh bay, Harissa and Byblos, and over Mount Lebanon to Rayak in the Bekaa. Start in your own glass hangar on the Beirut waterfront, talk to air traffic control and land at Beirut. In English and Arabic."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/flightsimulatorlebanon/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": "https://citiview-games.pages.dev/flightsimulatorlebanon/", "website_url": "https://citiview-games.pages.dev/flightsimulatorlebanon/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1320422941163678"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/593808163_1773583310585784_7337495533631906400_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QUAwBkpi1KsQ7kNvwFLvLHB&_nc_oc=Adpf40PNQ0DyMfjHWN3rNxQTu0r3h2gHvFy4takM-dEZHCaoJh703C42xyV0zP6SGek&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJPR_oWc7a5TQxHV9vX0T5B5MIvhjt8A5veD_FMeaoGA&oe=6AF9E991"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Flight Simulator Lebanon", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}, {"topic_name": "Adventure", "id": "2691890164460465"}], "release_date": 1793738580, "lastRevision": {"nodes": [{"id": "1320422957830343", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1320422927830346", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1145570044671668"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": 
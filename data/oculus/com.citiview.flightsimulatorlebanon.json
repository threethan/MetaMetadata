7kNvwHs8ZXs&_nc_oc=AdpabB2GwD_HBEJdouWOnMDIBuexAxytmXUNcjNbesPE5xoru5iK0kgjwRSNns20SQQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROdqRXbPWH40aQdXWJbY-0O3Hpr_Cn1U5AcAprBa2Hcw&oe=6AF9B872"}, {"file_name": "screenshot_4.png", "id": "1174302804937675", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499622162_1174302808271008_7926538921230999054_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ik7at8y34MQ7kNvwGEse_h&_nc_oc=AdrD0baPKxH192kEeM25T0hSbZTuMfay6AGT14EQl-0rcPQpx8vX6WC2lXhgTRfjl24&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpLIWToCYoVXoDsOXT6HOEAVVRcIIczwOsGjCGzmmLBA&oe=6AF9B825"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1152026484017051", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/593790560_1152026487350384_7290738510628103054_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mNkZEQtdiqQQ7kNvwF8es4p&_nc_oc=Adp3Zep8Xt_wV1Fp3ayFw9dQ4AMbLO6PHzg3Np9eWrXej7o0GlpSz0zVKBkCY-TaMnQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStfsqMvnEhNQPu2liASzijaXO7CNN92aVguKsiMcLfXg&oe=6AF9D91F"}, "display_name": "Flight Simulator Lebanon", "keywords": ["flight", "simulator", "lebanon", "beirut", "jet"], "long_description": "Flight Simulator Lebanon puts you in the captain's seat over the real Beirut, the Lebanese coast and Mount Lebanon.\n\nTHE REAL BEIRUT\nPigeon Rocks and Raouche, the Manara lighthouse, the Corniche, Zaitunay Bay, the Al-Amin Mosque and St George's Cathedral, Martyrs' Square, Nejmeh Square, the Grand Serail and Sama Beirut.\n\nTHE COAST AND THE MOUNTAINS\nRun the coast from Sidon's Sea Castle past Beirut and Jounieh bay to the old harbour of Byblos. Climb past Our Lady of Lebanon at Harissa to Sannine, Mzaar and the Bekaa valley.\n\nA LIVING CITY\nTraffic on the avenues and ships off the coast. At night the Corniche lights up and the Harissa statue glows.\n\nAIR TRAFFIC CONTROL\nTaxi and takeoff clearances and your landing clearance.\n\nYOUR GLASS HANGAR\nEvery flight starts in your glass hangar on the Beirut waterfront. Repaint, wash, fly.\n\nFOUR AIRCRAFT\nTwo private jets with cabins, a midsize jet and a fighter.\n\nELEVEN MISSIONS\nThe city and sea approaches to Beirut, a sunset hop from Rayak, the Corniche run, around Pigeon Rocks, the coast to Byblos, Rayak to the peaks, Beirut by night, a city tour.\n\nENGLISH AND ARABIC\nMenus in English and Arabic.\n\nFLY TOGETHER ONLINE\nQuick Match or a private sky with a code. Voice chat stays off until you turn it on.", "short_description": "Fly the real Beirut: low along the Corniche past Pigeon Rocks and the Manara lighthouse, over downtown and the blue domes of the Al-Amin Mosque, up the coast to Jounieh bay, Harissa and Byblos, and over Mount Lebanon to Rayak in the Bekaa. Start in your own glass hangar on the Beirut waterfront, talk to air traffic control and land at Beirut. In English and Arabic."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/flightsimulatorlebanon/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": "https://citiview-games.pages.dev/flightsimulatorlebanon/", "website_url": "https://citiview-games.pages.dev/flightsimulatorlebanon/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_m
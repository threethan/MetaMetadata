01.png", "id": "1034247162616157", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499302374_1034247165949490_4303881142646722431_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RLcdFxg4Y7IQ7kNvwG7xBD4&_nc_oc=Adp1ReunqKKiRc1bI4vkoYatcylkR35Nx7iw-AcX8W7GZw-4f4u7r9qqMtMzn7wYn4M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNEDAlaUu0daej526vQxW9NmkNPhIr1F2p39B21Q-3j4A&oe=6ACA6E5C"}, {"file_name": "image_033_0001.png", "id": "991712890378462", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499294603_991712893711795_5686769090351281213_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IodEF8gVe9AQ7kNvwGCfNql&_nc_oc=Adp9hFDu0_JaNbJVb2KleRplLsAh33323E8YWmK5E8RKOCdzC__GvyYjBtp0Fg3BG7o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNF4MKE46Y_YtysYGPnAIYO7D-6dPZm93BHVEpMzRg2Tw&oe=6ACA4701"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Glut Ape", "keywords": ["platformer"], "long_description": "Explore a mysterious abandoned facility filled with dark corridors, hidden rooms, and dangerous secrets waiting to be uncovered. Venture deeper into the unknown as you search for valuable scrap, discover locked areas, and gather the resources needed to survive. Every expedition brings new risks, and every decision could mean the difference between escape and becoming another victim of the facility's horrors.\n\nWork together with other players to navigate the environment, unlock security doors using keycards, and complete objectives while avoiding the deadly creatures that roam the darkness. Stay alert\u2014unpredictable threats can appear at any moment, and the deeper you explore, the greater the danger becomes.\n\nFeaturing immersive VR gameplay, atmospheric environments, terrifying encounters, and cooperative multiplayer action, the game challenges players to balance exploration, resource gathering, and survival. Whether you're searching for scrap, uncovering hidden secrets, or running for your life from a monster hunting your team, every session creates a unique and unforgettable experience.", "short_description": "Enter a dangerous abandoned facility where every sound could be your last. Explore dark environments, collect valuable scrap, unlock restricted areas with keycards, and work together with other players to survive the creatures lurking in the shadows."}]}, "developer_name": "anttdev", "developer_privacy_policy_url": "https://sites.google.com/view/glutape/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "anttdev", "support_website_url": null, "website_url": "https://sites.google.com/view/glutape/home?authuser=0", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1021812866955049"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499310667_1035461445692131_1033935176683846143_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=02_ciHi7VnMQ7kNvwFpL-tG&_nc_oc=AdpFzubrvuEoUi3pUjVASxcgbunFSttBMg6mBjNpKhk962KNQJmrmaewuRdfO0j8mOk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNb3nXFzuOn3F3iW9muUzOOzJKz_To7CCMq2NOMQIuBNw&oe=6ACA7897"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Glut Ape", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES
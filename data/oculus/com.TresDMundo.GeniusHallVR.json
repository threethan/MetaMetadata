scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499302348_912396834886560_638472689561164056_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J-XhmVFrU9YQ7kNvwFvk3uc&_nc_oc=Adp7n5FsFoQ6xjQkCk1JgN_lMN41oWT4vFonmFdxO9hY32wZOAmFaY5m9YUMZ6JQ8ss&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6FY5D7frqyM04erDIr20iJw51X0tDB8aOUZxSm0MuhA&oe=6AAD4F71"}]}, "id": "1429421642401755", "locale": "en_US", "screenshots": [{"file_name": "02_arquimedes.png", "id": "1390742135832326", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499295481_1390742139165659_9022285594874844395_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FS4MAIZRTfkQ7kNvwFRDTYH&_nc_oc=Adrl34w2kzbNWFPRgfKXZuKOX5NHb2PyU3G4dzVXOFvh_FIawEjXLBAzIuWK2UdjOF8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOE77KIJxuYNQx9-5JzTX97KV8xlgFRqzabQCbLH46Cg&oe=6AAD346C"}, {"file_name": "01_templo_en_las_nubes.png", "id": "2187502615519772", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499307352_2187502618853105_3898802315688187893_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pIFgq8QNKO4Q7kNvwHwMMkR&_nc_oc=AdoKv5jo6jihnRFPD5fk2pUtg6MJBQZN4c59TyET5icgXRJ6W_ukWfoqhdV2wGeN70c&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLfJ-fXcKJAHTB_ILdDHYaVsyDNHMlEj-U2gGSqEval2w&oe=6AAD5566"}, {"file_name": "03_alejandro_ficha.png", "id": "1605512608034273", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499313058_1605512611367606_6662680840280890706_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vrEs6NQQwaMQ7kNvwEtcmJ8&_nc_oc=Ado7x-kUycu632cxKcl5EgAgzGMPGm47HttExwYB3mKst5oEtUVq57_Zi3GfHuMbkNw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqwn_i7otaM5-9C_dizQZltr6RQ6ylb9b_sjBzXWj-jg&oe=6AAD41AB"}, {"file_name": "04_galeria.png", "id": "1391421855654124", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499296057_1391421858987457_8516834670377009090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OJJIRRL3hKYQ7kNvwEXQBk2&_nc_oc=Adou-EPZC3mbb-KZL872dwYPQE2b_6P0z6PcdBojNpYGmvt9PQZzHW94aZPlh1zzkJw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHv70PES3Jd7NILMBfC1qb9p5RgVAnzeXDK8r23z4HHA&oe=6AAD59C6"}, {"file_name": "05_entrada.png", "id": "1059608823525566", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499298150_1059608830192232_4502263414119162002_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RKxTRJedtEwQ7kNvwGrHe32&_nc_oc=AdoFx_YvCcxjPq-VKd24RLE8rUOQKB6Y2MJnnPTiDYhhpZF1SWJn2CDbW3dqtDTD8NA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5C5i9cClmTAaqyUkDEmm5W84kDvUp7w06LYkiHdB4aw&oe=6AAD5ED4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "portada_apaisada_2560x1440.png", "id": "1571588501376713", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499312257_1571588504710046_2696521314878315322_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b5NCsOGKl90Q7kNvwH6Q2Rl&_nc_oc=AdordSZNH5Y1YUxMsK9hoUQF3TCNwRs8-s_sNcojGCRlww27grF64shSravmFISeVTc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-lbzLs48nlNmFGZGW3lu2RqrvmZq0RzPcaM_KvhXQBQ&oe=6AAD540A"}, "display_name": "Genius Hall VR", "keywords": ["museum", "history", "science", "art", "culture"], "long_description": "You arrive through a Greek temple suspended in the sky. Behind it, four marble wings and twenty rooms with no walls: from every one of them you watch the clouds go past below.\n\nANCIENT WORLDS \u00b7 Buddha, Aristotle, Alexander, Archimedes and Nezahualcoyotl, the poet king of Texcoco.\nTHE REVOLUTION IN KNOWING \u00b7 Gutenberg, Leonardo, Galileo, Newton and Franklin.\nTHE NINETEENTH CENTURY \u00b7 Napoleon, Darwin, Ada Lovelace, Florence Nightingale and Pasteur.\nTHE MODERN ERA \u00b7 Tesla, Marie Curie, Einstein, Turing and Jobs.\n\nEvery figure stands at their real height, and the plaque says where the number comes from, including when the honest answer is that it is an estimate. Step up and their story opens, with four notes checked against sources. At least one note per person corrects what you thought you knew: Newton left more words on the Bible than on physics; Nightingale never called her famous diagram a coxcomb; the word evolution does not appear in the first edition of On the Origin of Species.\n\nA museum that only tells the flattering half is not telling you about anyone.\n\nFree movement on the stick. No cutscenes, no timer, nothing to buy. Ambient music you can mute from Settings. Everything is written in both English and Spanish.\n\nThe figures are artistic interpretations, not portraits or scans. This work is not associated with or endorsed by any person, family, estate, institution or brand named or represented.\n", "short_description": "A museum floating above the clouds. Twenty open marble rooms, one for each person who changed the world: Archimedes, Nezahualcoyotl, Gutenberg, Ada Lovelace, Marie Curie, Turing. Every figure is sculpted at their real height, so you meet them eye to eye instead of looking up. Walk closer and they tell you what the textbooks leave out: the parchment a monk scraped clean in 1229 to write over it, or the letter where Leonardo offers himself as a military engineer and mentions painting last.\n"}, {"images": {"nodes": []}, "id": "1408713887875120", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Genius Hall VR", "keywords": ["arte", "museo", "cultura"], "long_description": "Se entra por un templo griego suspendido en el cielo. Detr\u00e1s, cuatro alas de m\u00e1rmol y veinte salas sin muros: desde cada una se ven pasar las nubes por debajo.\n\nMUNDOS ANTIGUOS \u00b7 Buda, Arist\u00f3teles, Alejandro, Arqu\u00edmedes y Nezahualc\u00f3yotl, el rey poeta de Texcoco.\nLA REVOLUCI\u00d3N DEL SABER \u00b7 Gutenberg, Leonardo, Galileo, Newton y Franklin.\nEL SIGLO XIX \u00b7 Napole\u00f3n, Darwin, Ada Lovelace, Florence Nightingale y Pasteur.\nLA ERA MODERNA \u00b7 Tesla, Marie Curie, Einstein, Turing y Jobs.\n\nCada figura est\u00e1 a su estatura real, y la placa dice de d\u00f3nde sale la cifra, incluso cuando lo honesto es reconocer que es una estimaci\u00f3n. Al acercarte se abre su historia y cuatro apuntes contrastados con fuentes. Al menos uno de cada persona corrige lo que cre\u00edas saber: Newton dej\u00f3 m\u00e1s palabras escritas sobre la Biblia que sobre f\u00edsica; Nightingale nunca llam\u00f3 \u00abcoxcomb\u00bb a su diagrama famoso; la palabra evoluci\u00f3n no aparece en la primera edici\u00f3n de El origen de las especies.\n\nUn museo que solo cuenta la parte bonita no est\u00e1 contando a nadie.\n\nRecorrido libre con el joystick. Sin cinem\u00e1ticas, sin cron\u00f3metro y sin nada que comprar. M\u00fasica ambiental que se puede silenciar desde Ajustes. Todo el contenido est\u00e1 en espa\u00f1ol y en ingl\u00e9s.\n\nLas figuras son interpretaciones art\u00edsticas, no retratos ni escaneos. Esta obra no est\u00e1 asociada ni respaldada por ninguna persona, familia, herencia, instituci\u00f3n o marca citada o representada.\n", "short_description": "Un museo que flota sobre las nubes. Veinte salas de m\u00e1rmol abiertas al aire, una por cada persona que cambi\u00f3 el mundo: Arqu\u00edmedes, Nezahualc\u00f3yotl, Gutenberg, Ada Lovelace, Marie Curie, Turing. Cada figura est\u00e1 esculpida a su estatura real, as\u00ed que la miras a los ojos y no hacia arriba. Ac\u00e9rcate y te contar\u00e1 lo que no viene en los libros: el pergamino que un monje rasp\u00f3 en 1229 para escribir encima, o la carta en la que Leonardo se ofrece como ingeniero militar y deja la pintura para el final.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://claude.ai/code/artifact/5fc60290-d091-4743-bceb-f4b0b9143ae6", "developer_terms_of_service_url": null, "publisher_name": "Francisco Manuel Mier y Teran Almazan", "support_website_url": null, "website_url": "https://claude.ai/code/artifact/5fc60290-d091-4743-bceb-f4
5_963183776591767_2398615932916917151_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f82KaTCgK-IQ7kNvwEy5quX&_nc_oc=AdqmDznC10eBiYZOvvsdAdnOJAT1tkjA9WPmL7wqE9vX8PTkOAgM754HDD8fowWwoOo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRS4pOiLhsVvwQ6eezwkd6xhH5spG30dqRyUjQshUao4Q&oe=6AFF3279"}]}, "id": "26351509384502477", "locale": "en_US", "screenshots": [{"file_name": "Screenshot 2026-06-07 221818.png", "id": "1161050590422648", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619681_1161050593755981_7503196482805045507_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rF_zdbHG_80Q7kNvwHc1CtB&_nc_oc=Adp65_Z4cBYa3DAPn4Ac2bNsNFAF9cXmA-YYb0_l-quvsJ5sGBy9f6VzpfEMrxOfz6w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEXfaJPrxS4784LFJgw5PP4-dLVuPsCLNXw_E8H5Yejw&oe=6AFF279A"}, {"file_name": "Screenshot 2026-06-07 222607.png", "id": "1491157985408892", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499310840_1491157988742225_6455616670173240116_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HyM53axBk5QQ7kNvwF2a5q0&_nc_oc=AdrhCnzpHwugGs74QcJkYVayw3RqSCsuHmEZg5sXJ7_4P3wuzgc986SGrL1LSGuLPVk&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTlLqQRm7qls7WhprpzMc2fHzyoOj6SGcC4VwGQrUB8Bg&oe=6AFF361B"}, {"file_name": "Screenshot 2026-06-07 221739.png", "id": "1770580627142173", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619836_1770580630475506_6722047595972653227_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lG-zQdy-U4sQ7kNvwG8hOdR&_nc_oc=AdqdyR72YbpZjGgYk7nKvRSofBu7BWtKkJBHPJRf1pTTdZ7KmcIWYxYvskW4RWZRDpw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8jOtx2yl7OdjiUUoV3k1flz_qtUpvdFWhFd0_cnLmng&oe=6AFF1BCF"}, {"file_name": "Screenshot 2026-06-07 222657.png", "id": "1321327506095182", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620875_1321327509428515_6200623719554982576_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SrID30dKb7IQ7kNvwH8Lvx-&_nc_oc=AdrrLiRbEflV0tvacwpFUkJR6JEO0Fd9C5-Ftw0FvEmlDga0qoN1Xz8lmF3bQGsE9RU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzTAVAPF6kLpuV0gcMNlz7iFWLNtouOrbYod7ntfna8Q&oe=6AFF1ADB"}, {"file_name": "Screenshot 2026-06-07 221649.png", "id": "2523014488157146", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619774_2523014491490479_6010263010711627467_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ouXrDE-6Y64Q7kNvwFp1tBt&_nc_oc=Ado-OQADdLGs3k1bTXGC9KkJfyc4yNBTjwyqknx7z_FAbnzxBwDNB5XhZ7iyoqtr6-I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvpt5bABqqABfqYeC766MKj_c2dD9CB9dIIZTA_1-uPw&oe=6AFF1BE8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Past Liminal", "keywords": [], "long_description": "Past Liminal is an early access experience that lets you and your friends venture through random areas that you feel like youve seen before.\n\n# Reality collapsed the moment you entered.\n\nNow you wander through endless halls soaked in rot, rust, and the remains of those who **failed** before you. Every corner hides something inhuman. Every sound could be your last. The air itself feels alive, dragging your mind deeper into paranoia and insanity.\n\nYour past hunts you here.\n\nEvery memory tears open another wound. Every echo becomes a voice. Every shadow moves when you stop looking. The Backrooms feed on fear, suffering, and violence \u2014 and they will not stop until there is nothing left of you except another stain on the carpet.\n\n# There is no rescue.\n# No safety.\n# No waking up.\n\nOnly the endless halls.\nAnd whatever is waiting in the dark.", "short_description": "Past Liminal is an early access experience that lets you and your friends venture through random areas that you feel like youve seen before.\n\nRun from the echoes of a reality that destroyed you. Every memory revives another nightmare as you descend deeper into the Backrooms \u2014 endless halls of decay, bloodstained walls, and things hiding in the dark. The deeper you go, the more your mind fractures. This place feeds on fear, violence, and suffering. You cannot escape. You cannot leave."}]}, "developer_name": "MonoSpark", "developer_privacy_policy_url": "https://pastliminal.oneapp.dev/", "developer_terms_of_service_url": null, "publisher_name": "MonoSpark", "support_website_url": null, "website_url": "https://pastliminal.oneapp.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "26324444537194363"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "1807204363851583"}, {"status": "PUBLISHED", "id": "1996854727697173"}, {"status": "PUBLISHED", "id": "2259811305417074"}, {"status": "PUBLISHED", "id": "1606208571121783"}, {"status": "PUBLISHED", "id": "1325603179091974"}]}, "baseline_offer": {"id": "1606208571121783"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "1807204363851583"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28607665225538938", "version": "tee"}, "id": "884990601028245", "channel_nam
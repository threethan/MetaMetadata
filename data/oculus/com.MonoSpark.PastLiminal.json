c_ss=7f20f&oh=00_AQOizyuFNzKTqrZmTDHRP9TuI0RbcOrYTnrAoD2PheKWIg&oe=6AC3C75B"}, {"file_name": "Screenshot 2026-06-07 221649.png", "id": "2523014488157146", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619774_2523014491490479_6010263010711627467_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-0c-u4BY8yMQ7kNvwEf9YqF&_nc_oc=Adrcw7W4EV8jdMLJEDiMggv9xk9iltpDVhva5FfUYO88lXqunZx4QuvRTFTK3QNyIIY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN1hmvhyskuoCiGQjZct7gm3WJbKgybIyNucPa-GHCHZg&oe=6AC3C868"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Past Liminal", "keywords": [], "long_description": "Past Liminal is an early access experience that lets you and your friends venture through random areas that you feel like youve seen before.\n\n# Reality collapsed the moment you entered.\n\nNow you wander through endless halls soaked in rot, rust, and the remains of those who **failed** before you. Every corner hides something inhuman. Every sound could be your last. The air itself feels alive, dragging your mind deeper into paranoia and insanity.\n\nYour past hunts you here.\n\nEvery memory tears open another wound. Every echo becomes a voice. Every shadow moves when you stop looking. The Backrooms feed on fear, suffering, and violence \u2014 and they will not stop until there is nothing left of you except another stain on the carpet.\n\n# There is no rescue.\n# No safety.\n# No waking up.\n\nOnly the endless halls.\nAnd whatever is waiting in the dark.", "short_description": "Past Liminal is an early access experience that lets you and your friends venture through random areas that you feel like youve seen before.\n\nRun from the echoes of a reality that destroyed you. Every memory revives another nightmare as you descend deeper into the Backrooms \u2014 endless halls of decay, bloodstained walls, and things hiding in the dark. The deeper you go, the more your mind fractures. This place feeds on fear, violence, and suffering. You cannot escape. You cannot leave."}]}, "developer_name": "MonoSpark", "developer_privacy_policy_url": "https://pastliminal.oneapp.dev/", "developer_terms_of_service_url": null, "publisher_name": "MonoSpark", "support_website_url": null, "website_url": "https://pastliminal.oneapp.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "26324444537194363"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1996854727697173"}, {"status": "PUBLISHED", "id": "2259811305417074"}, {"status": "PUBLISHED", "id": "1606208571121783"}, {"status": "PUBLISHED", "id": "1325603179091974"}]}, "baseline_offer": {"id": "1606208571121783"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792774800, "status": "PUBLISHED", "id": "1996854727697173"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28607665225538938", "version": "tee"}, "id": "884990601028245", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26324444487194368", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28607665225538938"}, "rele
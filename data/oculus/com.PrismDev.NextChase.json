chase/privacypolicy?authuser=1", "developer_terms_of_service_url": null, "publisher_name": "PrismDev", "support_website_url": null, "website_url": "https://sites.google.com/view/nextchase/home?authuser=1", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "8302083113182285"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75422370_840781597797099_482384451482725593_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kx0lrSK6nK4Q7kNvwH2DkRz&_nc_oc=AdmVt8wGa_SSia6KKl83PiOHOGmz6YxyvNiZPMTHZSTEXOIYiRXXs1wsGczEcuKT2LA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwkWocXMNwOD7vTUe4S7qY_aIGzKUWF28z_PV6XjzxrSQ&oe=69BA8608"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "NextChase", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}], "release_date": 1723481504, "lastRevision": {"nodes": [{"id": "8163950493662215", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "8163950453662219", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1692137028196521"}, "iarc_email": null, "msrp": null, "tr
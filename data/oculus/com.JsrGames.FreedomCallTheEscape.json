fzUrXnpBsb60fUBGTZHrpQ9ZhyWyUBikAVJadJB-wGMRQ&oe=69B80918"}, {"file_name": "Screenshot5.png", "id": "8866873163348699", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974764_8866873173348698_3528100248580213837_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8cF5QwSttl4Q7kNvwHs9hOp&_nc_oc=Adm-L3gYoFx-RWLP1m5HVzdIL_NhCAT_qTZijDB3AOHA95rza8dMh447ibn7VSt3U5A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyquR4lwGnw933W8UYuZEoqEkHx7JUNeT1Gv7wjPSa2IA&oe=69B81176"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CovertArt2560x1440.png", "id": "1501657303722029", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75476597_1501657307055362_4484497038372370745_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vl5aqTII8wgQ7kNvwHP2IFi&_nc_oc=Adnarw_Yz16ExdCvt1EdzUqimWGjigFhYnF3ER8v-_R3COJIGaRrKaMpGm2dVtd8YSY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyvNhUc4ZZTzMZfBnC28n5ctoKkClKMYbX1RA7ZxK296Q&oe=69B811CC"}, "display_name": "Freedom Call - The Escape", "keywords": ["steampunk", "escape", "puzzles", "prison", "adventure"], "long_description": "In a war-torn steampunk world, you are a scientist captured while working near an enemy base. Imprisoned in a fortress isolated in the middle of the sea, your only chance for freedom lies in solving ingenious puzzles and escaping. Starting in a dark cell, you will face challenges in locations such as the cafeteria, dormitory, and the command block, including an underwater room full of mysteries. Your ultimate goal? Reach the airship that could take you to the long-awaited freedom.", "short_description": "You are a prisoner of war left to die alone in a prison in the middle of the sea. Your challenge is to solve various puzzles to escape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.jsrgames.com.br/freedom-call-the-escape-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "JsrGameStudio", "support_website_url
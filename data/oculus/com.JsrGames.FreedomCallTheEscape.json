 you to the long-awaited freedom.", "short_description": "You are a prisoner of war left to die alone in a prison in the middle of the sea. Your challenge is to solve various puzzles to escape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.jsrgames.com.br/freedom-call-the-escape-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "JsrGameStudio", "support_website_url": null, "website_url": "https://www.jsrgames.com.br/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7022102054570137"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PUBLISHED", "id": "1565879931631103"}, {"status": "PUBLISHED", "id": "1830488890973421"}, {"status": "PUBLISHED", "id": "1566491761301893"}, {"status": "PUBLISHED", "id": "823780220137698"}, {"status": "PUBLISHED", "id": "706240048991494"}, {"status": "PUBLISHED", "id": "1554855761841321"}, {"status": "PUBLISHED", "id": "1685897092278863"}, {"status": "PUBLISHED", "id": "1116553219848562"}, {"status": "PUBLISHED", "id": "1530392454509995"}]}, "baseline_offer": {"id": "1566491761301893"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784566800, "status": "PUBLISHED", "id": "1565879931631103"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": 
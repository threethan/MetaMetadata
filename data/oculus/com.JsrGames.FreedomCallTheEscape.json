fwRno7Acrw0Pq_oC3iEpYm0GKogsWQQ5KL-8TuXUEJCMQ&oe=69AD7D18"}, {"file_name": "Screenshot5.png", "id": "8866873163348699", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974764_8866873173348698_3528100248580213837_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_nuHihemJdkQ7kNvwGEBzvT&_nc_oc=AdlhR9qhMlbkndtpFwvBY0vDTPWkJUfAKPZj7fPEcFajzr1o-QaYgayE19hGRoNJjF4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz61HKa6PSIEZkVCf10dymvsDohSb_gpTHRaeTFKkHpMw&oe=69AD8576"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CovertArt2560x1440.png", "id": "1501657303722029", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75476597_1501657307055362_4484497038372370745_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sFqU71NbOYUQ7kNvwFjRtaY&_nc_oc=AdnAtKxNqshb9MWgxcAAMHNd2WPIX4GcP-YEZciyruRmre-DuYJerjYXQk7QdWj0d64&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz7Q2Z7Huu0WyK5LE6hvaOXMXe9vX67CPNnFR2XHt7rnA&oe=69AD85CC"}, "display_name": "Freedom Call - The Escape", "keywords": ["steampunk", "escape", "puzzles", "prison", "adventure"], "long_description": "In a war-torn steampunk world, you are a scientist captured while working near an enemy base. Imprisoned in a fortress isolated in the middle of the sea, your only chance for freedom lies in solving ingenious puzzles and escaping. Starting in a dark cell, you will face challenges in locations such as the cafeteria, dormitory, and the command block, including an underwater room full of mysteries. Your ultimate goal? Reach the airship that could take you to the long-awaited freedom.", "short_description": "You are a prisoner of war left to die alone in a prison in the middle of the sea. Your challenge is to solve various puzzles to escape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.jsrgames.com.br/freedom-call-the-escape-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "JsrGameStudio", "support_website_url
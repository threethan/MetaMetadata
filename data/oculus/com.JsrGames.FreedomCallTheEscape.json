0596649999657", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001719_590596653332990_193992536642258155_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g8zKE08uKrUQ7kNvwGcVql5&_nc_oc=Adreuyzg3F8DrdptN15XvsVkZEXNc86Va5isYVxmVju_ZmbnUH-XM6zaMfIVCSuS880&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTSrHtd75SzCmV1KGIRZGxnE-Wr4jBq6km1oMEa_kvsBQ&oe=6B0C6458"}, {"file_name": "Screenshot5.png", "id": "8866873163348699", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974764_8866873173348698_3528100248580213837_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wxfWlNth80wQ7kNvwHk0SCs&_nc_oc=Adp-_issOSztivFhGsXecdNSN_KnZ11EZWD7ZDZ9iY3uAgF7fl9Bmh6t-HPaiTzl6mw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTg4gx8qdHsmaVLvxsZBCIgL_ZO_ZABLG64bBSsIAu_dw&oe=6B0C6CB6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CovertArt2560x1440.png", "id": "1501657303722029", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75476597_1501657307055362_4484497038372370745_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YCS6R493vX8Q7kNvwF2ch2v&_nc_oc=Adq5S_Z2QAWi8IeBIgcTTPxe_0uB0I9DAjR_CPw1_D1OWxE96mgEst21JrkJAlXpSoE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSXotg5zuK9UcrZhEZ8tEJ6TgfGr1AUSaT71gzYi88j_Q&oe=6B0C6D0C"}, "display_name": "Freedom Call - The Escape", "keywords": ["steampunk", "escape", "puzzles", "prison", "adventure"], "long_description": "In a war-torn steampunk world, you are a scientist captured while working near an enemy base. Imprisoned in a fortress isolated in the middle of the sea, your only chance for freedom lies in solving ingenious puzzles and escaping. Starting in a dark cell, you will face challenges in locations such as the cafeteria, dormitory, and the command block, including an underwater room full of mysteries. Your ultimate goal? Reach the airship that could take you to the long-awaited freedom.", "short_description": "You are a prisoner of war left to die alone in a prison in the middle of the sea. Your challenge is to solve various puzzles to escape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.jsrgames.com.br/freedom-call-the-escape-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "JsrGameStudio", "support_website_url": null, "website_url": "https://www.jsrgames.com.br/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7022102054570137"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PUBLISHED", "id": "1565879931631103"}, {"status": "PUBLISHED", "id": "1830488890973421"}, {"status": "PUBLISHED", "id": "1566491761301893"}, {"status": "PUBLISHED", "id": "823780220137698"}, {"status": "PUBLISHED", "id": "706240048991494"}, {"status": "PUBLISHED", "id": "1554855761841321"}, {"status": "PUBLISHED", "id": "1685897092278863"}, {"status": "PUBLISHED", "id": "1116553219848562"}, {"status": "PUBLISHED", "id": "1530392454509995"}]}, "baseline_offer": {"id": "1566491761301893"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784566800, "status": "PUBLISHED", "id": "1565879931631103"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": 
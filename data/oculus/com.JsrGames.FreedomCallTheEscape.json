ontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3OHxntK5ICfqGzOwFyqxpUtUFN3jI3Y4S7lK3HYGupRw&oe=69F4AE18"}, {"file_name": "Screenshot5.png", "id": "8866873163348699", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974764_8866873173348698_3528100248580213837_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tsCiaZ_E_MUQ7kNvwGRNtNJ&_nc_oc=AdpEMZ0V_8oBL-PL_Puvu7EcQKk-4D3GioQEdtW3Wv31Sr8XZsPFSS0rmt40NLeV_mc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af13IEDrXJvnRN2HaNJFLpEud88OugsV_J7H5xlvAQDPeA&oe=69F4B676"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CovertArt2560x1440.png", "id": "1501657303722029", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75476597_1501657307055362_4484497038372370745_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hWTcZ8nmEiQQ7kNvwGuZif4&_nc_oc=AdrztOyZB0ZxVwFbfVfW9ASH0_M6Dhvu3kyy6Rz3LLS4zKVW8a_dFG8JApYtMci0oT0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af31gwiY4EMni28qxArY-ZXPB7pG43-96X-QkZ_as2uchw&oe=69F4B6CC"}, "display_name": "Freedom Call - The Escape", "keywords": ["steampunk", "escape", "puzzles", "prison", "adventure"], "long_description": "In a war-torn steampunk world, you are a scientist captured while working near an enemy base. Imprisoned in a fortress isolated in the middle of the sea, your only chance for freedom lies in solving ingenious puzzles and escaping. Starting in a dark cell, you will face challenges in locations such as the cafeteria, dormitory, and the command block, including an underwater room full of mysteries. Your ultimate goal? Reach the airship that could take you to the long-awaited freedom.", "short_description": "You are a prisoner of war left to die alone in a prison in the middle of the sea. Your challenge is to solve various puzzles to escape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.jsrgames.com.br/freedom-call-the-escape-privacy-policy", "developer_terms_of_service_url": null,
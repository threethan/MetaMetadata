ontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2UI5cNawRYiNBwTaoUdUmyGlxV3FBPcfhknzn4EGulqA&oe=69E62D98"}, {"file_name": "Screenshot5.png", "id": "8866873163348699", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974764_8866873173348698_3528100248580213837_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cf5AdAWxCkwQ7kNvwHl7KAO&_nc_oc=AdqFkLf9eoH_SyXfoq-dVI4F2JjYMv0gdFY0IswwdJIYivZl83_iof8C1A7cVwB326c&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0PxhacG06Es_6sbQBnlKEkOcI4Pt7DAMSycYg37cU_wA&oe=69E635F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CovertArt2560x1440.png", "id": "1501657303722029", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75476597_1501657307055362_4484497038372370745_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LN0HbQnj3J4Q7kNvwHUA2zS&_nc_oc=Adqb1mHfF2aYLwXaC9hjDfcpMt-mXKSp80gNe6V7uGVFgX-8Xxn01GEJfT54wRFKtrY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2v16GNySwv_BgIrOCmxSMYqcKfMDssedJ6MAT4WJN03w&oe=69E6364C"}, "display_name": "Freedom Call - The Escape", "keywords": ["steampunk", "escape", "puzzles", "prison", "adventure"], "long_description": "In a war-torn steampunk world, you are a scientist captured while working near an enemy base. Imprisoned in a fortress isolated in the middle of the sea, your only chance for freedom lies in solving ingenious puzzles and escaping. Starting in a dark cell, you will face challenges in locations such as the cafeteria, dormitory, and the command block, including an underwater room full of mysteries. Your ultimate goal? Reach the airship that could take you to the long-awaited freedom.", "short_description": "You are a prisoner of war left to die alone in a prison in the middle of the sea. Your challenge is to solve various puzzles to escape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.jsrgames.com.br/freedom-call-the-escape-privacy-policy", "developer_terms_of_service_url": null,
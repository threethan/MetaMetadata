0596649999657", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001719_590596653332990_193992536642258155_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vw-JRfE3XW0Q7kNvwFTksRL&_nc_oc=AdoygEaBukBmJXuBzhymr4PcAbV-ltdzE83TP8hi8rT1UffelfOvZ6nbD273r6x8Mo0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFAtcK0mvD0NIQXoPNVCVhZKiRov-vXDK5a8q3-CQ9og&oe=6AFC9258"}, {"file_name": "Screenshot5.png", "id": "8866873163348699", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974764_8866873173348698_3528100248580213837_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M8cbr1yVK-0Q7kNvwH8LYh3&_nc_oc=AdqlukY2NlgtPbf2LMvVPxweCbZPL6bRcMf6XvpGXRMZ9s_q858oqU7fH2tt3WqI07Q&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTW_C5cmASIpplPKPo8RgLwUZ46D_8K8RCFXjMcC36_uA&oe=6AFC6276"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CovertArt2560x1440.png", "id": "1501657303722029", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75476597_1501657307055362_4484497038372370745_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZJ6DmiiOdSAQ7kNvwEjw18z&_nc_oc=AdpL-YAjtwEp9_SZ1be21IlWlUMOTXUKAGEUURTAINutdmEZRs0jHMmUVoTrPnT4Er4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTgYNyc2NCQ2PbSq43spagtn_8f0nmduvg_v4wlppyMA&oe=6AFC62CC"}, "display_name": "Freedom Call - The Escape", "keywords": ["steampunk", "escape", "puzzles", "prison", "adventure"], "long_description": "In a war-torn steampunk world, you are a scientist captured while working near an enemy base. Imprisoned in a fortress isolated in the middle of the sea, your only chance for freedom lies in solving ingenious puzzles and escaping. Starting in a dark cell, you will face challenges in locations such as the cafeteria, dormitory, and the command block, including an underwater room full of mysteries. Your ultimate goal? Reach the airship that could take you to the long-awaited freedom.", "short_description": "You are a prisoner of war left to die alone in a prison in the middle of the sea. Your challenge is to solve various puzzles to escape."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.jsrgames.com.br/freedom-call-the-escape-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "JsrGameStudio", "support_website_url": null, "website_url": "https://www.jsrgames.com.br/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7022102054570137"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PUBLISHED", "id": "1565879931631103"}, {"status": "PUBLISHED", "id": "1830488890973421"}, {"status": "PUBLISHED", "id": "1566491761301893"}, {"status": "PUBLISHED", "id": "823780220137698"}, {"status": "PUBLISHED", "id": "706240048991494"}, {"status": "PUBLISHED", "id": "1554855761841321"}, {"status": "PUBLISHED", "id": "1685897092278863"}, {"status": "PUBLISHED", "id": "1116553219848562"}, {"status": "PUBLISHED", "id": "1530392454509995"}]}, "baseline_offer": {"id": "1566491761301893"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784566800, "status": "PUBLISHED", "id": "1565879931631103"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": 
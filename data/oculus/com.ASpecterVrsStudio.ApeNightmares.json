7963816843200244_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gSuKGj24KyoQ7kNvwEoqq2_&_nc_oc=AdpxE_lyLPTZ1g9ynX18kH1vXduQF9zHXUQtI_g3406vpo77rs385eB-zikWOwp4As0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8CNKx7H02EdhbYn4OJeGgZYj_SF7w7OUMz3dgEQCSltw&oe=6A36933B"}, {"file_name": "output-onlinepngtools (9).png", "id": "1485137092363923", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974891_1485137095697256_2823846640687056936_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f55AqqOCdtkQ7kNvwHQBK-b&_nc_oc=AdqR5fJGF2cb1g2V5XDPfdQhD2RdS56gScPeeYzxZ_L8_cb1abi1HrwMG7t5663iBKI&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_WBTA5hZyjKgaw6XWrXyM7f-tpux25JUKv8we5n2PTJw&oe=6A369DC9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Nightmares Horror game", "keywords": [], "long_description": "Step into a world of fear with Ape Nightmares, a Gorilla Tag-inspired horror game designed for adrenaline junkies. Utilizing Gorilla Tag\u2019s unique locomotion system, you\u2019ll run, jump, and climb through terrifying environments as you try to escape relentless horrors. The game challenges your reflexes and courage, pitting you against eerie creatures in an immersive, nightmarish setting.\n\nPrepare for jumpscares, intense chases, and an atmosphere thick with tension. This isn\u2019t just a game\u2014it\u2019s an experience that will keep you on edge from start to finish. Whether you\u2019re alone or with friends, every moment is a test of your survival instincts. If you\u2019re a fan of Gorilla Tag and love horror, Ape Nightmares is a must-play.\n\nWarning: Ape Nightmares is not for the faint of heart. If you\u2019re easily scared or don\u2019t enjoy horror games, this experience may not be for you. Players must be 13 years or older.", "short_description": "Experience heart-pounding horror in Ape Nightmares, a Gorilla Tag fan game using Gorilla Tag\u2019s signature locomotion. Navigate eerie environments, avoid terrifying entities, and survive the nightmare\u2014if you dare."}]}, "developer_name": null, "developer_privacy_policy_url": "https://spectervr753.wixsite.com/ape-nightmares/private-policy", "developer_terms_of_service_url": null, "publisher_name": "Specter vr", "support_website_url": null, "website_url": "https://spectervr753.wixsite.com/ape-nightmares", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7906589752796166"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2005761993194759"}]}, "baseline_offer": {"id": "2005761993194759"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1729926000, "status": "PUBLISHED", "id": "2005761993194759"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9667768840011573", "version": "0.5.0"}, "id": "1075422594142754", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7873090329479442", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9667768840011573"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1749243275, "id": "9675288612592929
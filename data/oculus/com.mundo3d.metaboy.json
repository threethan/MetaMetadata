": "5891786154170029"}]}, "id": "1030126614306267"}]}}, "firstRevision": {"nodes": [{"application": {"id": "1105823338550435", "release_date": 1787325000, "is_concept": false, "platform": "ANDROID_6DOF", "scheduled_offers": {"count": 1}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1106663881799714"}, "id": "28984617354461318"}]}}, "binary": {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1105823338550435", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1106663881799714"}, "release_status": "RELEASED"}, "id": "1106663881799714", "version": "1.05", "version_code": 1, "release_status": "RELEASED", "status": "APPROVED"}, "live_binary": null, "created_date": 1786679472, "id": "1105823348550434", "is_initial_release": true, "name_with_fallback": "v1", "pdp_metadata_with_fallback": {"version": 1, "application": {"is_concept": false, "latest_released_pdp_metadata": {"id": "1105823341883768"}, "release_status": "RELEASED", "id": "1105823338550435"}, "id": "1105823341883768", "release_status": "RELEASED", "status": "APPROVED"}, "release_date": null, "administration_status": "APPROVED", "is_first": true, "release_status": "RELEASED", "release_type": "SCHEDULED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1105823338550435", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1749538042911473"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "1376492643860184", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Meta Boy", "keywords": ["retro", "arcade", "nostalgia", "2d"], "long_description": "HAY UN COLOR QUE NUNCA OLVIDASTE\n\nRojo sobre negro. Solo eso. Y sin embargo, ah\u00ed dentro cab\u00eda un mundo entero.\n\nMETA BOY rescata esa sensaci\u00f3n y la pone donde siempre debi\u00f3 estar: flotando frente a ti, n\u00edtida, enorme, imposible de apartar. Una pantalla suspendida en la oscuridad, con sus l\u00edneas de barrido y sus cuatro tonos de escarlata, esperando a que vuelvas a saltar.\n\nRecorre las Praderas de Zanahoria, desciende a las Cavernas Rojas y cruza el Cielo de Cristal, un archipi\u00e9lago de plataformas flotantes donde el suelo es un lujo. Cada mundo esconde rutas altas para los curiosos y las cinco letras que solo encuentran los que exploran de verdad.\n\n\n", "short_description": "Plataformas en rojo monocromo dentro de tu visor: salta, lanza y derrota a tres jefes en un mundo de f\u00f3sforo escarlata que cre\u00edas perdido para siempre.\n"}, {"images": {"nodes": [{"file_name": "icon_spatialized_background_180x180.png", "id": "2928832877515201", "image_type": "APP_IMG_ICON_BACKGROUND", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499296214_2928832880848534_4724366596392985169_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C5jXeISLSFoQ7kNvwFe2CmW&_nc_oc=Adp2Gt2ftKv1IV_bw211j-tZnLrvG9GgMy6UwXsW7ZXgZvFrD8S4AkmiD2DVLwiUzkM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPsFKDtDv9Ruyy8OcARfOXdHFpACizJl0juXAMjjRWvVQ&oe=6AC516B4"}, {"file_name": "hero_3000x900.png", "id": "2126446528755163", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499305443_2126446532088496_2920538038275900756_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4NyLrlTrhqQQ7kNvwHfNuTp&_nc_oc=Adrf91AoYfu_nexho5FPX3WgZVTXrETwjGK1r_3HFYG7nRCONapMWCN7KvuajX6Pcuk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMBGIIjYb8hNF6taFAgUkXMiC6DF5nid2s7J07UyQWV1w&oe=6AC51941"}, {"file_name": "cover_square_1440x1440.png", "id": "2078903429419617", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499303116_2078903432752950_
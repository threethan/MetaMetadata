2EPhiwicQ7kNvwF0Q5yw&_nc_oc=AdrWmXMoGZ-tnLIy5KPHYc52rwTc532Y7MVXlZMgVoxIYYNZj4z8Nc7gS3PsIPY5b_k&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQORINc8nKbUALNz93lTZQ1htZAiXo_Z5zTt6DAwt5Z5qA&oe=6AC52654"}, {"file_name": "screenshot_3_2560x1440.png", "id": "1783281226034690", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499300725_1783281229368023_492423069722653633_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9XK1KWXBtzwQ7kNvwERRyNM&_nc_oc=Adptw1tjDv3GsgttWCOkY7pOdoWsFywFJlM5qmbIZLKF8DaEPOK3atgdXRD1kFfXczA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZEwZbOstzAe9Nl8dR6UsFapZS2UARR4Pgv_VGVXdNDA&oe=6AC52553"}, {"file_name": "screenshot_1_2560x1440.png", "id": "1962678724393861", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499299715_1962678727727194_8917686525005931188_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8691-FXQeYoQ7kNvwHo6Iq6&_nc_oc=Adp85bt1-Em33hWzxjUHcvM6Ir66tRFRdlDCpBmypoHnjqOq39SfmEpNk-HZLX0-qxI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKUlJjAS5ENChYyLKLkRGAcZCN0xwSaPPxRqHIRdMiqg&oe=6AC50304"}, {"file_name": "screenshot_5_2560x1440.png", "id": "2511717249290321", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499295512_2511717252623654_16572890911161368_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IeygLaGA-XAQ7kNvwGgINjn&_nc_oc=AdrmzV-ZVvg0XM-r4h65egJm7lFW1V_jWK056s86vBkIpFoCoaAaOch1gu9D-T7ajd0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOH0joG_8EvBsqkY_ng-Fe8t26zJ30ps1RFm_myFxdN0w&oe=6AC4F5E2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "1767295861361678", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499292329_1767295864695011_693571934711718991_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dPEHr5xdfKYQ7kNvwEXuMfy&_nc_oc=AdoJufGyDWcMQ8D1oWvMaGs5YLbzHLgzT0Z-eowvlnT2m_BNxFiq82in3vwSHlL52SY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN5hV5IwSrgJsMD3BPmC7ACb-98EiYC-g1xTL-MsuZQNg&oe=6AC4FDC9"}, "display_name": "Meta Boy", "keywords": ["retro", "arcade"], "long_description": "THERE IS A COLOUR YOU NEVER FORGOT\n\nRed on black. That was all. And somehow, an entire world fit inside it.\n\nMETA BOY brings that feeling back and puts it where it always belonged: floating right in front of you, razor sharp, enormous, impossible to look away from. A screen suspended in the dark, scanlines and four shades of scarlet, waiting for you to jump again.\n\n\nRun the Carrot Meadows, drop into the Red Caverns, then cross the Glass Sky \u2014 an archipelago of floating platforms where solid ground is a luxury. Every world hides high routes for the curious and the five letters only real explorers ever find.\n\nWHO THIS IS FOR\n\nFor anyone who remembers kneeling in front of a red screen until their neck hurt. And for anyone who never got the chance, and always wondered what it would have been like.\n\nYou do not have to wonder any more.\n", "short_description": "A whole world drawn in red. Exactly how you dreamed it as a kid.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://claude.ai/code/artifact/b213767d-aa74-4fc6-ac54-cefb1528b4fd", "developer_terms_of_service_url": null, "publisher_name": "Francisco Manuel Mier y Ter\u00e1n Almaz\u00e1n", "support_website_url": null, "website_url": "https://claude.ai/code/artifact/b213767d-aa74-4fc6-ac54-cefb1528b4fd", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1105823341883768"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499303116_2078903432752950_2008216452812118566_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vi7d8WefpKoQ7kNvwGAg411&_nc_oc=AdrqobwQLKInThSP1baCwk-Fj0VWnl6D5e8UcHP2w6gfjjj1_IvFRfT3o79toIfKgNs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-jlyHvNWFTJRtTcuhy49X9bGEpAgQeQf0-zmn8i_I_w&oe=6AC51C4A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Meta Boy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1787325000, "lastRevision": {"nodes": [{"id": "1105823348550434", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1105823338550435", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1749538042911473"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "1376492643860184", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Meta Boy", "keywords": ["retro", "arcade", "nostalgia", "2d"], "long_description": "HAY UN COLOR QUE NUNCA OLVIDASTE\n\nRojo sobre negro. Solo eso. Y sin embargo, ah\u00ed dentro cab\u00eda un mundo entero.\n\nMETA BOY rescata esa sensaci\u00f3n y la pone donde siempre debi\u00f3 estar: flotando frente a ti, n\u00edtida, enorme, imposible de apartar. Una pantalla suspendida en la oscuridad, con sus l\u00edneas de barrido y sus cuatro tonos de escarlata, esperando a que vuelvas a saltar.\n\nRecorre las Praderas de Zanahoria, desciende a las Cavernas Rojas y cruza el Cielo de Cristal, un archipi\u00e9lago de plataformas flotantes donde el suelo es un lujo. Cada mundo esconde rutas altas para los curiosos y las cinco letras que solo encuentran los que exploran de verdad.\n\n\n", "short_description": "Plataformas en rojo monocromo dentro de tu visor: salta, lanza y derrota a tres jefes en un mundo de f\u00f3sforo escarlata que cre\u00edas perdido para siempre.\n"}, {"images": {"nodes": [{"file_name": "icon_spatialized_background_180x180.png", "id": "2928832877515201", "image_type": "APP_IMG_ICON_BACKGROUND", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499296214_2928832880848534_4724366596392985169_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C5jXeISLSFoQ7kNvwFe2CmW&_nc_oc=Adp2Gt2ftKv1IV_bw211j-tZnLrvG9GgMy6UwXsW7ZXgZvFrD8S4AkmiD2DVLwiUzkM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPsFKDtDv9Ruyy8OcARfOXdHFpACizJl0juXAMjjRWvVQ&oe=6AC516B4"}, {"file_name": "hero_3000x900.png", "id": "2126446528755163", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499305443_2126446532088496_2920538038275900756_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4NyLrlTrhqQQ7kNvwHfNuTp&_nc_oc=Adrf91AoYfu_nexho5FPX3WgZVTXrETwjGK1r_3HFYG7nRCONapMWCN7KvuajX6Pcuk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMBGIIjYb8hNF6taFAgUkXMiC6DF5nid2s7J07UyQWV1w&oe=6AC51941"}, {"file_name": "cover_square_1440x1440.png", "id": "2078903429419617", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499303116_2078903432752950_2008216452812118566_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vi7d8WefpKoQ7kNvwGAg411&_nc_oc=AdrqobwQLKInThSP1baCwk-Fj0VWnl6D5e8UcHP2w6gfjjj1_IvFRfT3o79toIfKgNs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZE5UNesi0UI5R1kWci
=6A3AAA3A"}]}, "id": "482579173463090", "locale": "en_US", "screenshots": [{"file_name": "screenshot3.png", "id": "1081697722591942", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003280_1081697725925275_3713409719981561714_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ixZJcsbNtEoQ7kNvwGILIsU&_nc_oc=AdpzO6AcQsUm_zvlnJhQCWwSHPDRCSHh7ATgjkiAnqiFyn5KLdpomjdAP0s2b0DEr7E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-pkL42ezYZDkOmdLgRkc2ahqsuohFqZ6Nz7Tx5ytvtIQ&oe=6A3AA539"}, {"file_name": "screenshot1.png", "id": "891812374719892", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974526_891812378053225_5369050572336997676_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M29Akx4aQr8Q7kNvwH5EOqI&_nc_oc=Adp_NU1SxXcnWGYQ3qnZasARQ5t2MU3YajbtEagfFXrzsQQp_D_GRViUCzqKMQ4ycs0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wEoQGY-ChbrFMy3P0vo_2O5ORXcgsB0XA4-dCV-wRjA&oe=6A3A8E7D"}, {"file_name": "screenshot4.png", "id": "515803696127364", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001671_515803699460697_73940523674033348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iJsyaRIwvHQQ7kNvwEfZ81G&_nc_oc=AdppGamGWLH6id6zthWLd4GLKDdAWuVZ7FTXHMpxQeBU4plsKLvgiQCOKH7rFQTqADE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0cfuXBFB2947-B2VUxvjMZdFbITfjJ1rIZxJw3QVc2g&oe=6A3AA1E2"}, {"file_name": "screenshot2.png", "id": "494805435576143", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974472_494805438909476_6908114846858006049_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yYaUty7jQugQ7kNvwGHXByp&_nc_oc=AdqRRXep71rfwaYhi32ECZwCRgAEdbQz0m3o3Si51pH77SGZRsZEbKWKtspxv_P_ZHg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9AxhwRM0Lyhozu8NNi45MDmSRo3TCqSb73wJKsPjEiMw&oe=6A3AB8EB"}, {"file_name": "screenshot5.png", "id": "295231385884884", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974748_295231389218217_6396604183369755431_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GieyT24txjYQ7kNvwFybBH9&_nc_oc=Adp4xiOdq_6O_bDOH7sl3ZNqh_mLMd-YiOFVhw1szR2FZIPL1hsyVYqcgKabK0UgRHA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9SL2GoZ9SRaLifbv5EX8I4hm81aWRGC0AEGjxCBDW6kA&oe=6A3AA291"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.image.2560x1440.png", "id": "940568733536589", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/65402154_940568736869922_5321874169153941497_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vpoE3ml2DnsQ7kNvwHomSeI&_nc_oc=Adr3qWVtSNLA9b33WWacJ2NP97-AMIzuAu8gIGgoMDhfZi8de1-cmCSTIIzvOHDtxjM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9kvnpBQ0Iy1-GntjKHbEB9ExrZS4RGrRRI3YB_wP1q6w&oe=6A3A8C06"}, "display_name": "Vendetta Online", "keywords": [], "long_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy. Three major player factions form a delicate balance of power, with several NPC sub-factions creating situations of economic struggle, political intrigue and conflict. The completely persistent universe and detailed storyline add to the depth of immersion, resulting in a unique online experience.", "short_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy."}, {"images": {"nodes": []}, "id": "459984882501397", "locale": "ru_RU", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vendetta Online", "keywords": [], "long_description": "Vendetta Online - \u044d\u0442\u043e \u043a\u0440\u043e\u0441\u0441\u043f\u043b\u0430\u0442\u0444\u043e\u0440\u043c\u0435\u043d\u043d\u0430\u044f 3D \u043a\u043e\u0441\u043c\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0431\u043e\u0435\u0432\u0430\u044f MMORPG, \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u044e\u0449\u0430\u044f \u0442\u044b\u0441\u044f\u0447\u0430\u043c \u0438\u0433\u0440\u043e\u043a\u043e\u0432 \u0432\u0437\u0430\u0438\u043c\u043e\u0434\u0435\u0439\u0441\u0442\u0432\u043e\u0432\u0430\u0442\u044c \u0432 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435 \u043f\u0438\u043b\u043e\u0442\u043e\u0432 \u043a\u043e\u0441\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043a\u043e\u0440\u0430\u0431\u043b\u0435\u0439 \u0432 \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0439 \u0432\u0441\u0435\u043b\u0435\u043d\u043d\u043e\u0439. \u041f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u0438 \u043c\u043e\u0433\u0443\u0442 \u0441\u0442\u0440\u043e\u0438\u0442\u044c \u0441\u0432\u043e\u0438\u0445 \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u0436\u0435\u0439 \u0432 \u043b\u044e\u0431\u043e\u043c \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0438, \u0441\u0442\u0430\u043d\u043e\u0432\u044f\u0441\u044c \u0431\u043e\u0433\u0430\u0442\u044b\u043c\u0438 \u043a\u0430\u043f\u0438\u0442\u0430\u043d\u0430\u043c\u0438 \u043f\u0440\u043e\u043c\u044b\u0448\u043b\u0435\u043d\u043d\u043e\u0441\u0442\u0438, \u0432\u043e\u0435\u043d\u043d\u044b\u043c\u0438 \u0433\u0435\u0440\u043e\u044f\u043c\u0438 \u0438\u043b\u0438 \u0440\u0430\u0437\u0431\u043e\u0439\u043d\u0438\u043a\u0430\u043c\u0438. \u0411\u044b\u0441\u0442\u0440\u043e \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u044e\u0449\u0430\u044f\u0441\u044f \u0431\u043e\u0435\u0432\u0430\u044f \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u0432 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u043c \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u043e\u0431\u0435\u0441\u043f\u0435\u0447\u0438\u0432\u0430\u0435\u0442 \u0438\u043d\u0442\u0435\u043d\u0441\u0438\u0432\u043d\u043e\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u0432 \u0441\u043e\u0447\u0435\u0442\u0430\u043d\u0438\u0438 \u0441 \u0440\u043e\u043b\u0435\u0432\u043e\u0439 \u0438\u0433\u0440\u043e\u0439 \u0432 \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0439 \u043e\u043d\u043b\u0430\u0439\u043d\u043e\u0432\u043e\u0439 \u0433\u0430\u043b\u0430\u043a\u0442\u0438\u043a\u0435. \u0422\u0440\u0438 \u043e\u0441\u043d\u043e\u0432\u043d\u044b\u0435 \u0444\u0440\u0430\u043a\u0446\u0438\u0438 \u0438\u0433\u0440\u043e\u043a\u043e\u0432 \u0444\u043e\u0440\u043c\u0438\u0440\u0443\u044e\u0442 \u0445\u0440\u0443\u043f\u043a\u0438\u0439 \u0431\u0430\u043b\u0430\u043d\u0441 \u0441\u0438\u043b, \u0430 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0441\u0443\u0431\u0444\u0440\u0430\u043a\u0446\u0438\u0439 \u0441\u043e\u0437\u0434\u0430\u044e\u0442 \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u0438 \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0431\u043e\u0440\u044c\u0431\u044b, \u043f\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0438\u043d\u0442\u0440\u0438\u0433 \u0438 \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442\u043e\u0432. \u041f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u0430\u044f \u0432\u0441\u0435\u043b\u0435\u043d\u043d\u0430\u044f \u0438 \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u0430\u044f \u0441\u044e\u0436\u0435\u0442\u043d\u0430\u044f \u043b\u0438\u043d\u0438\u044f \u0434\u043e\u0431\u0430\u0432\u043b\u044f\u044e\u0442 \u0433\u043b\u0443\u0431\u0438\u043d\u0443 \u043f\u043e\u0433\u0440\u0443\u0436\u0435\u043d\u0438\u044f \u0432 \u0438\u0433\u0440\u0443, \u0447\u0442\u043e \u043f\u0440\u0438\u0432\u043e\u0434\u0438\u0442 \u043a \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u043e\u043c\u0443 \u043e\u043d\u043b\u0430\u0439\u043d-\u043e\u043f\u044b\u0442\u0443.\n\n\u041f\u0435\u0440\u0435\u0432\u0435\u0434\u0435\u043d\u043e \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e", "short_description": "Vendetta Online - \u044d\u0442\u043e \u043a\u0440\u043e\u0441\u0441\u043f\u043b\u0430\u0442\u0444\u043e\u0440\u043c\u0435\u043d\u043d\u0430\u044f 3D \u043a\u043e\u0441\u043c\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0431\u043e\u0435\u0432\u0430\u044f MMORPG, \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u044e\u0449\u0430\u044f \u0442\u044b\u0441\u044f\u0447\u0430\u043c \u0438\u0433\u0440\u043e\u043a\u043e\u0432 \u0432\u0437\u0430\u0438\u043c\u043e\u0434\u0435\u0439\u0441\u0442\u0432\u043e\u0432\u0430\u0442\u044c \u0432 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435 \u043f\u0438\u043b\u043e\u0442\u043e\u0432 \u043a\u043e\u0441\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043a\u043e\u0440\u0430\u0431\u043b\u0435\u0439 \u0432 \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0439 \u0432\u0441\u0435\u043b\u0435\u043d\u043d\u043e\u0439. \u041f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u0438 \u043c\u043e\u0433\u0443\u0442 \u0441\u0442\u0440\u043e\u0438\u0442\u044c \u0441\u0432\u043e\u0438\u0445 \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u0436\u0435\u0439 \u0432 \u043b\u044e\u0431\u043e\u043c \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0438, \u0441\u0442\u0430\u043d\u043e\u0432\u044f\u0441\u044c \u0431\u043e\u0433\u0430\u0442\u044b\u043c\u0438 \u043a\u0430\u043f\u0438\u0442\u0430\u043d\u0430\u043c\u0438 \u043f\u0440\u043e\u043c\u044b\u0448\u043b\u0435\u043d\u043d\u043e\u0441\u0442\u0438, \u0432\u043e\u0435\u043d\u043d\u044b\u043c\u0438 \u0433\u0435\u0440\u043e\u044f\u043c\u0438 \u0438\u043b\u0438 \u0440\u0430\u0437\u0431\u043e\u0439\u043d\u0438\u043a\u0430\u043c\u0438. \u0411\u044b\u0441\u0442\u0440\u043e \u0440\u0430\u04
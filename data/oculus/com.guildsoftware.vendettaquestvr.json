=6A131D3A"}]}, "id": "482579173463090", "locale": "en_US", "screenshots": [{"file_name": "screenshot3.png", "id": "1081697722591942", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39003280_1081697725925275_3713409719981561714_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y-DGmD-4AxwQ7kNvwHQWP6i&_nc_oc=AdovdKexI2BGLqOZGFElyHM0ISZz8fMI17-9tAXkZTDXNCVgsYmykOE_gRuf-zxq3Nk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5UjJasNNAMBsMJJRxVwduNl4zeHOGu69lcqeazzbqa-w&oe=6A131839"}, {"file_name": "screenshot1.png", "id": "891812374719892", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974526_891812378053225_5369050572336997676_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yg0Yy8GkaSgQ7kNvwERLrr9&_nc_oc=AdqcODBTOrtV9U7BcHBJC2t6z8wWVWclKbbsPnMan0VGRfsGPtnL83zeFMdzhwmvsUg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6uPLgwlnFEdn4NJ96TK1kuEijffV73kSTH-WeYxnfvTA&oe=6A13017D"}, {"file_name": "screenshot4.png", "id": "515803696127364", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001671_515803699460697_73940523674033348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GV_p5H-Y2g4Q7kNvwHgJc4P&_nc_oc=AdqsGpMy8sveKrdh-T5fDT39dz2GueSo7KBo1Cb0E0B_2KENnhNJvFDE9oTN-mDus9k&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6G2rkb9CC3GvV_ewR_E9EL9a3KtbwX-T6cgjAkxQJZNA&oe=6A1314E2"}, {"file_name": "screenshot2.png", "id": "494805435576143", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974472_494805438909476_6908114846858006049_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8qyiJHTEW2UQ7kNvwFSfNV4&_nc_oc=AdpEjuAEbHOYqaJ58--l5rNSo-qqOHfPY3CUcMTIXCk5s4QDncmFxM_zF3kGhL34bWA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4D7MdBaunY8Swj3MziqATfT8JuJB6PkIFYWocBpPSeOg&oe=6A12F3AB"}, {"file_name": "screenshot5.png", "id": "295231385884884", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974748_295231389218217_6396604183369755431_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pOLcPn12F3UQ7kNvwG7mInC&_nc_oc=AdrT0F9XAs4ZeD-IO6R09gzi3pJtMeuWI3dXefCSX2DC-aT-o4kHgt9AQ-llCeyTBH8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7e_YoOdgxCNicZoK2hXmaE6obxE80AN3ZtOWdx5QHHtQ&oe=6A131591"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.image.2560x1440.png", "id": "940568733536589", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/65402154_940568736869922_5321874169153941497_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8rwFgGE9nCYQ7kNvwFYqNLr&_nc_oc=AdocPz_lqqtk6qVMesDhEF7qkjIx_KvYgcuRYMDk1jRGK3Dh2mZCbAk29qRbbLby7NU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5IhLD6lcq8j6wfINSNET_42GMfxPeaf0K3ufMeT3Vx3g&oe=6A12FF06"}, "display_name": "Vendetta Online", "keywords": [], "long_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy. Three major player factions form a delicate balance of power, with several NPC sub-factions creating situations of economic struggle, political intrigue and conflict. The completely persistent universe and detailed storyline add to the depth of immersion, resulting in a unique online experience.", "short_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy."}, {"images": {"nodes": []}, "id": "459984882501397", "locale": "ru_RU", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vendetta Online", "keywords": [], "long_description": "Vendetta Online - \u044d\u0442\u043e \u043a\u0440\u043e\u0441\u0441\u043f\u043b\u0430\u0442\u0444\u043e\u0440\u043c\u0435\u043d\u043d\u0430\u044f 3D \u043a\u043e\u0441\u043c\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0431\u043e\u0435\u0432\u0430\u044f MMORPG, \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u044e\u0449\u0430\u044f \u0442\u044b\u0441\u044f\u0447\u0430\u043c \u0438\u0433\u0440\u043e\u043a\u043e\u0432 \u0432\u0437\u0430\u0438\u043c\u043e\u0434\u0435\u0439\u0441\u0442\u0432\u043e\u0432\u0430\u0442\u044c \u0432 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435 \u043f\u0438\u043b\u043e\u0442\u043e\u0432 \u043a\u043e\u0441\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043a\u043e\u0440\u0430\u0431\u043b\u0435\u0439 \u0432 \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0439 \u0432\u0441\u0435\u043b\u0435\u043d\u043d\u043e\u0439. \u041f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u0438 \u043c\u043e\u0433\u0443\u0442 \u0441\u0442\u0440\u043e\u0438\u0442\u044c \u0441\u0432\u043e\u0438\u0445 \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u0436\u0435\u0439 \u0432 \u043b\u044e\u0431\u043e\u043c \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0438, \u0441\u0442\u0430\u043d\u043e\u0432\u044f\u0441\u044c \u0431\u043e\u0433\u0430\u0442\u044b\u043c\u0438 \u043a\u0430\u043f\u0438\u0442\u0430\u043d\u0430\u043c\u0438 \u043f\u0440\u043e\u043c\u044b\u0448\u043b\u0435\u043d\u043d\u043e\u0441\u0442\u0438, \u0432\u043e\u0435\u043d\u043d\u044b\u043c\u0438 \u0433\u0435\u0440\u043e\u044f\u043c\u0438 \u0438\u043b\u0438 \u0440\u0430\u0437\u0431\u043e\u0439\u043d\u0438\u043a\u0430\u043c\u0438. \u0411\u044b\u0441\u0442\u0440\u043e \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u044e\u0449\u0430\u044f\u0441\u044f \u0431\u043e\u0435\u0432\u0430\u044f \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u0432 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u043c \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u043e\u0431\u0435\u0441\u043f\u0435\u0447\u0438\u0432\u0430\u0435\u0442 \u0438\u043d\u0442\u0435\u043d\u0441\u0438\u0432\u043d\u043e\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u0432 \u0441\u043e\u0447\u0435\u0442\u0430\u043d\u0438\u0438 \u0441 \u0440\u043e\u043b\u0435\u0432\u043e\u0439 \u0438\u0433\u0440\u043e\u0439 \u0432 \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0439 \u043e\u043d\u043b\u0430\u0439\u043d\u043e\u0432\u043e\u0439 \u0433\u0430\u043b\u0430\u043a\u0442\u0438\u043a\u0435. \u0422\u0440\u0438 \u043e\u0441\u043d\u043e\u0432\u043d\u044b\u0435 \u0444\u0440\u0430\u043a\u0446\u0438\u0438 \u0438\u0433\u0440\u043e\u043a\u043e\u0432 \u0444\u043e\u0440\u043c\u0438\u0440\u0443\u044e\u0442 \u0445\u0440\u0443\u043f\u043a\u0438\u0439 \u0431\u0430\u043b\u0430\u043d\u0441 \u0441\u0438\u043b, \u0430 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0441\u0443\u0431\u0444\u0440\u0430\u043a\u0446\u0438\u0439 \u0441\u043e\u0437\u0434\u0430\u044e\u0442 \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u0438 \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0431\u043e\u0440\u044c\u0431\u044b, \u043f\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0438\u043d\u0442\u0440\u0438\u0433 \u0438 \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442\u043e\u0432. \u041f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u0430\u044f \u0432\u0441\u0435\u043b\u0435\u043d\u043d\u0430\u044f \u0438 \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u0430\u044f \u0441\u044e\u0436\u0435\u0442\u043d\u0430\u044f \u043b\u0438\u043d\u0438\u044f \u0434\u043e\u0431\u0430\u0432\u043b\u044f\u044e\u0442 \u0433\u043b\u0443\u0431\u0438\u043d\u0443 \u043f\u043e\u0433\u0440\u0443\u0436\u0435\u043d\u0438\u044f \u0432 \u0438\u0433\u0440\u0443, \u0447\u0442\u043e \u043f\u0440\u0438\u0432\u043e\u0434\u0438\u0442 \u043a \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u043e\u043c\u0443 \u043e\u043d\u043b\u0430\u0439\u043d-\u043e\u043f\u044b\u0442\u0443.\n\n\u041f\u0435\u0440\u0435\u0432\u0435\u0434\u0435\u043d\u043e \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e", "short_description": "Vendetta Online - \u044d\u0442\u043e \u043a\u0440\u043e\u0441\u0441\u043f\u043b\u0430\u0442\u0444\u043e\u0440\u043c\u0435\u043d\u043d\u0430\u044f 3D \u043a\u043e\u0441\u043c\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0431\u043e\u0435\u0432\u0430\u044f MMORPG, \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u044e\u0449\u0430\u044f \u0442\u044b\u0441\u044f\u0447\u0430\u043c \u0438\u0433\u0440\u043e\u043a\u043e\u0432 \u0432\u0437\u0430\u0438\u043c\u043e\u0434\u0435\u0439\u0441\u0442\u0432\u043e\u0432\u0430\u0442\u044c \u0432 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435 \u043f\u0438\u043b\u043e\u0442\u043e\u0432 \u043a\u043e\u0441\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043a\u043e\u0440\u0430\u0431\u043b\u0435\u0439 \u0432 \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0439 \u0432\u0441\u0435\u043b\u0435\u043d\u043d\u043e\u0439. \u041f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u0438 \u043c\u043e\u0433\u0443\u0442 \u0441\u0442\u0440\u043e\u0438\u0442\u044c \u0441\u0432\u043e\u0438\u0445 \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u0436\u0435\u0439 \u0432 \u043b\u044e\u0431\u043e\u043c \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0438, \u0441\u0442\u0430\u043d\u043e\u0432\u044f\u0441\u044c \u0431\u043e\u0433\u0430\u0442\u044b\u043c\u0438 \u043a\u0430\u043f\u0438\u0442\u0430\u043d\u0430\u043c\u0438 \u043f\u0440\u043e\u043c\u044b\u0448\u043b\u0435\u043d\u043d\u043e\u0441\u0442\u0438, \u0432\u043e\u0435\u043d\u043d\u044b\u043c\u0438 \u0433\u0435\u0440\u043e\u044f\u043c\u0438 \u0438\u043b\u0438 \u0440\u0430\u0437\u0431\u043e\u0439\u043d\u0438\u043a\u0430\u043c\u0438. \u0411\u044b\u0441\u0442\u0440\u043e \u0440\u0430\u04
dn.com/v/t64.5771-25/38974526_891812378053225_5369050572336997676_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tnbI3eNAeNUQ7kNvwFigP3k&_nc_oc=AdoMn92bDCUcezO503RnvDHvnwq271Bg9uRoZpIpCX3313173mnCBErfsD3AfltlWz8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5ABjmvFiG9z4oafGz0frmvpBY5EofslPFSAx8Sba-yQ&oe=6AA94C7D"}, {"file_name": "screenshot4.png", "id": "515803696127364", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39001671_515803699460697_73940523674033348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ImiBiTN0ic8Q7kNvwFVhzsk&_nc_oc=Adqd--pL_lbWnzzxG1TemEVXOregsIZRGtezpbimxo0I4YC7KZZZEA-7nJUjCJYCgG0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLcnb4Kmk-a2Rh6jAhbCZq5ATbI__ajGQ4b5ZfbiWOIRA&oe=6AA95FE2"}, {"file_name": "screenshot2.png", "id": "494805435576143", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974472_494805438909476_6908114846858006049_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c0lA1rSCTHsQ7kNvwF7cBgW&_nc_oc=AdoftN5FBk78xXkfXh-oWDBAuk6zzIIgrrZN80xvkWwaPX0_J_jEmsXb45ISnGwBYqU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKDAQT73BVy2UpXIysC_yTdyq6lZUMvrRRfyypKH1pO7w&oe=6AA93EAB"}, {"file_name": "screenshot5.png", "id": "295231385884884", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38974748_295231389218217_6396604183369755431_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zzwybabP2xcQ7kNvwE5r3tq&_nc_oc=AdrKHvNn9kJJgAnok0NAZ7SnXutEbMI6DRHo-HgfAI4WAClb5AmJHfG8G7CH4hmSpPU&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL3p8Tx6j9NJwnBiRkeTlo0uVSat4JeVMBbeKkYg-LYTQ&oe=6AA96091"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.image.2560x1440.png", "id": "940568733536589", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/65402154_940568736869922_5321874169153941497_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Ms7rQRSm5YQ7kNvwFmjxpr&_nc_oc=AdqPRzp6oEt-RJzjOyM-mBjzuKrOd6Q7DH3rw6dA6l0XfNPvbbgI-vmlqANdJX7cX3A&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLwSn2ubmkDH2WyrUSGrd-8SSgk_fGKeNg9skvLSc2ULA&oe=6AA94A06"}, "display_name": "Vendetta Online", "keywords": [], "long_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy. Three major player factions form a delicate balance of power, with several NPC sub-factions creating situations of economic struggle, political intrigue and conflict. The completely persistent universe and detailed storyline add to the depth of immersion, resulting in a unique online experience.", "short_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy."}, {"images": {"nodes": []}, "id": "459984882501397", "locale": "ru_RU", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vendetta Online", "keywords": [], "long_description": "Vendetta Online - \u044d\u0442\u043e \u043a\u0440\u043e\u0441\u0441\u043f\u043b\u0430\u0442\u0444\u043e\u0440\u043c\u0435\u043d\u043d\u0430\u044f 3D \u043a\u043e\u0441\u043c\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0431\u043e\u0435\u0432\u0430\u044f MMORPG, \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u044e\u0449\u0430\u044f \u0442\u044b\u0441\u044f\u0447\u0430\u043c \u0438\u0433\u0440\u043e\u043a\u043e\u0432 \u0432\u0437\u0430\u0438\u043c\u043e\u0434\u0435\u0439\u0441\u0442\u0432\u043e\u0432\u0430\u0442\u044c \u0432 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435 \u043f\u0438\u043b\u043e\u0442\u043e\u0432 \u043a\u043e\u0441\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043a\u043e\u0440\u0430\u0431\u043b\u0435\u0439 \u0432 \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0439 \u0432\u0441\u0435\u043b\u0435\u043d\u043d\u043e\u0439. \u041f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u0438 \u043c\u043e\u0433\u0443\u0442 \u0441\u0442\u0440\u043e\u0438\u0442\u044c \u0441\u0432\u043e\u0438\u0445 \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u0436\u0435\u0439 \u0432 \u043b\u044e\u0431\u043e\u043c \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0438, \u0441\u0442\u0430\u043d\u043e\u0432\u044f\u0441\u044c \u0431\u043e\u0433\u0430\u0442\u044b\u043c\u0438 \u043a\u0430\u043f\u0438\u0442\u0430\u043d\u0430\u043c\u0438 \u043f\u0440\u043e\u043c\u044b\u0448\u043b\u0435\u043d\u043d\u043e\u0441\u0442\u0438, \u0432\u043e\u0435\u043d\u043d\u044b\u043c\u0438 \u0433\u0435\u0440\u043e\u044f\u043c\u0438 \u0438\u043b\u0438 \u0440\u0430\u0437\u0431\u043e\u0439\u043d\u0438\u043a\u0430\u043c\u0438. \u0411\u044b\u0441\u0442\u0440\u043e \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u044e\u0449\u0430\u044f\u0441\u044f \u0431\u043e\u0435\u0432\u0430\u044f \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u0432 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u043c \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u043e\u0431\u0435\u0441\u043f\u0435\u0447\u0438\u0432\u0430\u0435\u0442 \u0438\u043d\u0442\u0435\u043d\u0441\u0438\u0432\u043d\u043e\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u0432 \u0441\u043e\u0447\u0435\u0442\u0430\u043d\u0438\u0438 \u0441 \u0440\u043e\u043b\u0435\u0432\u043e\u0439 \u0438\u0433\u0440\u043e\u0439 \u0432 \u043e\u0433\u0440\u043e\u043c\u043d\u043e\u0439 \u043e\u043d\u043b\u0430\u0439\u043d\u043e\u0432\u043e\u0439 \u0433\u0430\u043b\u0430\u043a\u0442\u0438\u043a\u0435. \u0422\u0440\u0438 \u043e\u0441\u043d\u043e\u0432\u043d\u044b\u0435 \u0444\u0440\u0430\u043a\u0446\u0438\u0438 \u0438\u0433\u0440\u043e\u043a\u043e\u0432 \u0444\u043e\u0440\u043c\u0438\u0440\u0443\u044e\u0442 \u0445\u0440\u0443\u043f\u043a\u0438\u0439 \u0431\u0430\u043b\u0430\u043d\u0441 \u0441\u0438\u043b, \u0430 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0441\u0443\u0431\u0444\u0440\u0430\u043a\u0446\u0438\u0439 \u0441\u043e\u0437\u0434\u0430\u044e\u0442 \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u0438 \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0431\u043e\u0440\u044c\u0431\u044b, \u043f\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0438\u043d\u0442\u0440\u0438\u0433 \u0438 \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442\u043e\u0432. \u041f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u0430\u044f \u0432\u0441\u0435\u043b\u0435\u043d\u043d\u0430\u044f \u0438 \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u0430\u044f \u0441\u044e\u0436\u0435\u0442\u043d\u0430\u044f \u043b\u0438\u043d\u0438\u044f \u0434\u043e\u0431\u0430\u0432\u043b\u044f\u044e\u0442 \u0433\u043b\u0443\u0431\u0438\u043d\u0443 \u043f\u043e\u0433\u0440\u0443\u0436\u0435\u043d\u0438\u044f \u0432 \u0438\u0433\u0440\u0443, \u0447\u0442\u043e \u043f\u0440\u0438\u0432\u043e\u0434\u0438\u0442 \u043a \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u043e\u043c\u0443 \u043e\u043d\u043b\u0430\u0439\u043d-\u043e\u043f\u044b\u0442\u0443.\n\n\u041f\u0435\u0440\u0435\u0432\u0435\u0434\u0435\u043d\u043e \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e", "short_description": "Vendetta Online - \u044d\u0442\u043e \u043a\u0440\u043e\u0441\u0441\u043f\u043b\u0430\u0442\u0444\u043e\u0440\u043c\u0435\u043d\u043d\u0430\u044f 3D \u043a\u043e\u0441\u043c\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0431\u043e\u0435\u0432\u0430\u044f MMORPG, \u043f\u043e\u0437\u0432\u0
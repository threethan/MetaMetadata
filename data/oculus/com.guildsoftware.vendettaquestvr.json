378053225_5369050572336997676_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LV6yX5wyPMgQ7kNvwHPryK6&_nc_oc=Admk3GdnwJZ4KWV500gUCv1a7bETpQiGqeTb7xDogoWxFJ2nWU_zXnUfgJSfTCE1RtA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzFz4dR8m4hLvIKkjwZBJle8Ayoi0047RbxONIS6DhnCw&oe=69BAACFD"}, {"file_name": "screenshot4.png", "id": "515803696127364", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001671_515803699460697_73940523674033348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9A5E6Xm-LAYQ7kNvwGNgD7m&_nc_oc=AdnD9UMuoqSGi17BTvTbtUpCnKBiELg0AihhZVfuPnarsw1GlYaV0m0hJoegvT1RVIs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxaUdQ_V-pIcNSSHMwoNKSjVT24xK16MohaGAjKGpy7cw&oe=69BA8822"}, {"file_name": "screenshot2.png", "id": "494805435576143", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974472_494805438909476_6908114846858006049_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dJUJ1u4eQ4sQ7kNvwEVLXKT&_nc_oc=Adn3uex32vzePnF_Rh72g0YCqv4rcwIWYTKpIMfAfiiyMze9prPZJB3OVmpWLqMeb1I&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afws0sIfmOBGWChafRHtKvsgDAjAyCFzK8KTi__FrS1Ggg&oe=69BA9F2B"}, {"file_name": "screenshot5.png", "id": "295231385884884", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974748_295231389218217_6396604183369755431_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_FVUpo1RAUkQ7kNvwF046a6&_nc_oc=AdnZ4mFn57Wyznu6ULmZfzlJBvye-Gq88kMS9TbEOQ4wfCDeJtP930ROCtqVk2CgDKs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx8yIlFYigQryEIeNxg60BWnA5rowq3tfRaLfFnd0_-KA&oe=69BA88D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.image.2560x1440.png", "id": "940568733536589", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/65402154_940568736869922_5321874169153941497_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uLEprLAsu40Q7kNvwF-eDJO&_nc_oc=Admwsasx4FlZCTG_4eM6gz5HXEEsSgF_wwlfF1DWuN0ajsG_vZ4aKQa1lDxesARM7UE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afya3L1GTleJfRI_wBIUttCs-13mauUwBk9bTQc6idYXnQ&oe=69BAAA86"}, "display_name": "Vendetta Online", "keywords": [], "long_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy. Three major player factions form a delicate balance of power, with several NPC sub-factions creating situations of economic struggle, political intrigue and conflict. The completely persistent universe and detailed storyline add to the depth of immersion, resulting in a unique online experience.", "short_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy."}, {"images": {"nodes": []}, "id": "459984882501397", "locale": "ru_RU", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vendetta Online", "keywords": [], "long_description": "Vendetta Online - \u044d\u0442\u043e \u043a\u0440\u043e\u0441\u0441\u043f\u043b\u0430\u0442\u0444\u043e\u0440\u043c\u0435\u043d\u043d\u0430\u044f 3D \u043a\u043e\u0441\u043c\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0431\u043e\u0435\u0432\u0430\u044f MMORPG, \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u044e\u0449\u0430\u044f \u0442\u044b\u0441\u044f\u0447\u0430\u043c \u0438\u0433\u0440\u043e\u043a\u043e\u0432 \u0432\u0437\u0430\u0438\u043c\
1_796704421797493_4273927429227272418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rOglOaOyE4gQ7kNvwGpmdn4&_nc_oc=Ado7XmlTIZbFUcdokOS6fGW_g1R9hUX7FlgXwpn0_RbjY-plRB6fA0iDP5Z1SvVtuHo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMFRmAG1JXi34OkuASfrMHw9ZFKh2KjHL3kAIh4-bK9Pw&oe=6AC4F65F"}, {"file_name": "screenshot3.png", "id": "243447578052170", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982528_243447581385503_1311164864357431428_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qSzOpWrkUawQ7kNvwGCfRwK&_nc_oc=AdobdxF4fafcGcd8vNBWIbThSww4XG98niNcwRC3UybZ95nVI7FyBLmUTVlfmY3lGZo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP5znHdoS_CJQdgqd5Mhc-3vcSZoE_Fkh87eYlT04gS8g&oe=6AC51D75"}, {"file_name": "screenshot4.png", "id": "756637562706222", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974759_756637566039555_7395506445783665316_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3B3T8tH7wTgQ7kNvwG9yE0y&_nc_oc=AdpY5iGWIBCsg_4obDUsm_h5r-94cbCFX0rcOy_0CnKW8joqP-ITZx0xGSAf-R4B_rY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKe4QiCSUNGF4EIwH5856R6obEALqsvRdtIw41yCRcMA&oe=6AC4FC20"}, {"file_name": "screenshot5.png", "id": "553874096635567", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974780_553874099968900_7378651240689708759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qh57S580mU0Q7kNvwGYr0ju&_nc_oc=AdonFfwJ80oDf3CGBm2KorpPKSqv-TyDW4hIzoMbJeFqbErBCBpKaOCNSPx8VTxr4BI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMU96tosrDChHi7N1790mFnWNl0zZnGvc3utErxv9HVyw&oe=6AC51404"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "md_cover_yoko.png", "id": "177397054888391", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001715_177397058221724_4824817095391091493_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9DQYEPo8PvsQ7kNvwHl20cB&_nc_oc=AdpYVLh9Pv3GDCy0GO4y-LfxyssotWL963v33ijepDkLmMckq45yj5cU2sq4dkesT9U&_nc_zt=3&
1_796704421797493_4273927429227272418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hYNcG7HBGnIQ7kNvwHtjncB&_nc_oc=AdoDne2GeFZEB9ZpWDUEukONrlDdeQnTv-TmfKwHI1ZlflTJ1Vn--iMRkPzm3vO6apg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_WhW6ti9GHJoA8ZRBrfrZZATkd_i9kSl1SOcSwBrt-TA&oe=6A241F5F"}, {"file_name": "screenshot3.png", "id": "243447578052170", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982528_243447581385503_1311164864357431428_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E3KqTRMRUuoQ7kNvwEDahSe&_nc_oc=AdqXkIj_pEGdBoLzflQygQXCdovqwLwy1ofEdk61K3tGXURXLCPi1t9B9ZUHpymoXRo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Q7Ol3B2R1WjoiH0bb7H7hKrJ2rI2cmQADAqXeAhJJ9g&oe=6A244675"}, {"file_name": "screenshot4.png", "id": "756637562706222", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974759_756637566039555_7395506445783665316_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xMg7IKsLeXMQ7kNvwFPezb1&_nc_oc=Adru0Z-KNUJNraPESlbncHCPkrRq7TdK55xE2YslVLI_y_8Xur3pRx3ExRd4vtsMjdM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9j0ClP_Cn85-g2RE8o35_o2FMGzRzSTKFgrj9zUCzPoQ&oe=6A242520"}, {"file_name": "screenshot5.png", "id": "553874096635567", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974780_553874099968900_7378651240689708759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ok-5RwpEt0Q7kNvwHSsK1N&_nc_oc=AdojhBP9WYUL2P0Hceag3-sxoUe7qV7YpqJaBN7QfbrBNFrOPb9Pfff-7CHwRpSAAfw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_pXdFkgZqOppfhJ55-j0UafGEHiAcmH9QF-6E1a89lvg&oe=6A243D04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "md_cover_yoko.png", "id": "177397054888391", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001715_177397058221724_4824817095391091493_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hHqFbFuPy_0Q7kNvwG5dsnC&_nc_oc=AdozCc0LnCJjkjdQEAdwi7Cl3ugTh3fioqwu4C-3a4r4ZRq76V5eq21e8ksG5LAFOeM&_nc_zt=3&
1_796704421797493_4273927429227272418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cTazIhBR81IQ7kNvwFgdlmO&_nc_oc=AdoNgiXRT-e5GH02p0AD6S74GzR-e6X_t2vT6niQ6ZoCD6lDpz17Do-RQXPDbpyCiSg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7lG6NGCaU4xWUPUpnLn-I1ROBvK1p8EuZJ424hU7CfFw&oe=69FF355F"}, {"file_name": "screenshot3.png", "id": "243447578052170", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982528_243447581385503_1311164864357431428_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h7iyYsKKZ7AQ7kNvwEzY6sA&_nc_oc=AdrvWYvSOX7QX4LfiUetqQbIJXS49RcDGZnCwKxlsPctToPZxBnjyZ2bvOQ0c3_WHzM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6tybPv62gJaFxa6NRgzHmt7QkxrQGSrlt11pB698YQtw&oe=69FF2435"}, {"file_name": "screenshot4.png", "id": "756637562706222", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974759_756637566039555_7395506445783665316_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bG4LmYMXtn0Q7kNvwGf3f_9&_nc_oc=Adr-1f5QPgHagqHwn6WS_Ag5qkLakvFXKGPyNDgAhzaGnvIn7O4uAOCIx9QNnwxta6k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af689aAhsW2LCIju0WNw9ipStdgkHv6qO-szMA87MRNj5g&oe=69FF3B20"}, {"file_name": "screenshot5.png", "id": "553874096635567", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974780_553874099968900_7378651240689708759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r8ZZhTJuWcoQ7kNvwGuM06C&_nc_oc=AdoLCcb1SqozeJbiWrr-L5cyls31WNNc0ZfDIiUhCyxkVtS-qU_7rwWRBFl8stwaWLE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5IWUyf7PlKKjmUHjI1wz5pEKt-gRVKBv1KhD-ongdukQ&oe=69FF5304"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "md_cover_yoko.png", "id": "177397054888391", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001715_177397058221724_4824817095391091493_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i97ObBwEGNgQ7kNvwG9TrJi&_nc_oc=AdpkRQqlu1gMir_s3-YpuhAhIgoUm2-2LluXfopb5acu7i3IdrPJXq8RCOh2Hh2iC_I&_nc_zt=3&
1_796704421797493_4273927429227272418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pBcRMNIPGj4Q7kNvwFl1hx6&_nc_oc=Adq00rEISjwjM1HDLCkN4IAeFTOYDTolIa7nzRP-CUXp_spHuFxrrwXyy1OO-DWF3N4&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7TOhxMuT0uY0Zrls3ibgcXb_FyBFnykToYZypUSsxGCA&oe=6A1C365F"}, {"file_name": "screenshot3.png", "id": "243447578052170", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982528_243447581385503_1311164864357431428_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vqwe_OJgBlsQ7kNvwHf3Yr-&_nc_oc=Adq6xjNjL1Sv3Y5UoEM4rT33Ve9XNYAEoeqBHIOeyZht5Sc-RYQes9w2wdHXex-9NoI&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4NrgYs6L0DBfiY4Z3EnrarSR6qg_8GwAAtk5TI0VX5VQ&oe=6A1C5D75"}, {"file_name": "screenshot4.png", "id": "756637562706222", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974759_756637566039555_7395506445783665316_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UmeRO2r03F4Q7kNvwG32Jrh&_nc_oc=AdqcJuBVUkUNcr5ybjfr2LQBHZN_eBnElil0pv4GFS_fEnfvHMyKLJXvN0ieaBWg7vo&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6tjE9p2CvcPI49Lvb3069K5FJ5zEBduf2ukRwjD7E6fQ&oe=6A1C3C20"}, {"file_name": "screenshot5.png", "id": "553874096635567", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974780_553874099968900_7378651240689708759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ign9SLYOXkQ7kNvwHXAVaD&_nc_oc=AdpP0TqMesxORpOiFv3hjRuVpyWgV1Sn9JxYI2wnGg20UQZpOUafpLA-Up7cpvqcl9Q&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5MmLnrxQBDbUGjf-ZvNdVsxRh0A7TrMGjygjxDdfeEuQ&oe=6A1C5404"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "md_cover_yoko.png", "id": "177397054888391", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39001715_177397058221724_4824817095391091493_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wweRe-fjrbMQ7kNvwEH2WCI&_nc_oc=Adqp_M3lcI_s4XJjglKQElyru3KMvpxcbnOe19UK8RoUdMmsxJgd0OD0CQTjcAo1C1I&_nc_zt=3&
1_796704421797493_4273927429227272418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hxFEwY1h5ZoQ7kNvwG9_l_K&_nc_oc=Adrm0BVha_Sf1HP5eWB5zhvg9aAUc_wLrducYGscaQg-Op_ie8DhKdGmf-RMVYXJPr8&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5HeqHnkNgEhsLCUFqwNxs7ztaFfL83aELRatzST_SUYg&oe=6A1058DF"}, {"file_name": "screenshot3.png", "id": "243447578052170", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982528_243447581385503_1311164864357431428_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W8aVlxH7gqEQ7kNvwEiwzcT&_nc_oc=AdoT5ykMs3hqcqLwScriobAR4kg0ZtwY5q9ZnX0xWoQPTJF0q0vWidcOsigho47LDuE&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Zw5PVGwrKh92-maaMzg8Gxngd1QYDr3HXWH2HrTTQ-A&oe=6A107FF5"}, {"file_name": "screenshot4.png", "id": "756637562706222", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974759_756637566039555_7395506445783665316_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J4WM7VlDRFQQ7kNvwHIW3Nr&_nc_oc=AdrNM2Ws26yClBs83ZxoSD6-bZA-DDu9xqe82QlCTO1pPv4Xx2R_VOsCGDx5FzWfpW8&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af45pJMyvy5-LyRmRFWIFXm9xbzjWmdvb_M9RBxYDuKYlQ&oe=6A105EA0"}, {"file_name": "screenshot5.png", "id": "553874096635567", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974780_553874099968900_7378651240689708759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v7PK0swXL5oQ7kNvwGFh_i6&_nc_oc=AdrqZBumZ27BYIKzuvNGcWmZJCtudy1JZvKtXzUvwtsTW3FaO4PS-0ks8RhnViNRI4g&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xUg1ovq-0UOazlWvZK9D8pDybgyRtwaj1TRXnkPIFtA&oe=6A107684"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "md_cover_yoko.png", "id": "177397054888391", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39001715_177397058221724_4824817095391091493_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SDRg93CoaeoQ7kNvwEdOaAz&_nc_oc=Adr2r0qaXad-T9cBaU8OcQGSYuq81CBeN7e-DN8WpytFZ5Vd0Xy8JzHY7adbKRQ8Pvo&_nc_zt=3&
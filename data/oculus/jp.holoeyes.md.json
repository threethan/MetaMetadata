vh0kPfrGy1Ls0X8AHSzKEVx6oKm4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwC5rW6NyAZ73WTzTPvs9Vq14JZrWSvWQJ5r77paWWqWQ&oe=69BD3935"}, {"file_name": "screenshot4.png", "id": "756637562706222", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974759_756637566039555_7395506445783665316_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tJqs27OF1NEQ7kNvwECKoyV&_nc_oc=Adkumats4pc4uMHuAQvX6HyOG_AjTlD63AicVbQC7UKHKKUN05Cdy5lMVp0ibpd5nKI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxHuaJdFZczbPAtAUP2vpUydhcx92ZYg6_X1yrQvIfRgQ&oe=69BD5020"}, {"file_name": "screenshot5.png", "id": "553874096635567", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974780_553874099968900_7378651240689708759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0e0sRRg7RVsQ7kNvwFCgW_1&_nc_oc=Adlcoq-liVwPN7OP6LE5N5XGrTKcBH_y-JcL9mR5rg1tvyTBTxiZIg1lLMPfgXOKgdc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afw29pPhaSitRaIhnnEkx5fWdjWHPrDrV004wPR0baqr2g&oe=69BD2FC4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "md_cover_yoko.png", "id": "177397054888391", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001715_177397058221724_4824817095391091493_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4kWEe8nfJYQQ7kNvwEGXQjo&_nc_oc=AdktwBiXyLpYezNR5aUUN1Vqjd-zcI5YS-yhAAnYsxtr5SPXyV7SD01r3nRa-mio2sg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwSHtqmABmT-2jmKRKnIoDovlCxhDrgLG7xI7TlfcruNg&oe=69BD31E3"}, "display_name": "Holoeyes MD", "keywords": [], "long_description": "Holoeyes MD\" is a program that computer processes image information obtained by diagnostic imaging equipment and provides it for medical treatment. It does not perform automatic diagnosis. In addition to the standard function that displays images, there is an optional function that performs three-dimensional image processing.\n\nIt is to be installed and used on general-purpose IT equipment, etc. that meets the specifications specified by Holoeyes Corporation (hereinafter referred to as \"the Company\") in the manner specified by the Company and provided as a download. For details, please refer to the attached document.\n\nThe latest version of the attached document (electronic attachment) https://holoeyes.jp/pmda/", "short_description": "The medical imaging software \"Holoeyes MD\" is a controlled medical device (generic name: program for general-purpose diagnostic imaging workstations, certification number: 302ADBZX00011000) under the \"Act on Quality, Efficacy and Safety Assurance of Pharmaceuticals, Medical Devices, etc.\" (Pharmaceuticals and Medical Devices Act)."}, {"images": {"nodes": [{"file_name": "md_logo.png", "id": "5998065973633964", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003260_5998065976967297_260827317627691552_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w-beC-RjKKcQ7kNvwF5iruy&_nc_oc=Admi0xpw2rFlR25AvqmZiRWX50SmjNA9cap2UcD9CdoyQ3sf2v2qgEilHlOWoLWhQ4o&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afwz_p6b7tyTszAeVMg54Das7Hm6mOlc0a6oLzkgLt-yBQ&oe=69BD3CCD"}, {"file_name": "md_cover_tate.png", "id": "2303415159832893", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974904_2303415163166226_7688600240374808365_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qLZAComttPkQ7kNvwHZCFBS&_nc_oc=AdmvT2_9JIfNdS49QA6Rqr5K0O15JRK5w7M6wt2A8mWY_60KhQnNslWppCTVTDxMH2U&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzTX2a5g8q_5wma3_vPPxV33nz6PKgyZuvXpMDCT5jGRQ&oe=69BD2F2C"}, {"file_name": "md_cover_miniyoko.png", "id": "950325029433473", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031585_950325032766806_6345836855774372629_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8E5RDfWdcH4Q7kNvwE53Cbt&_nc_oc=AdmooZCRUmRtt1dubR-dYqkd-_kiv7Ro12_at4RUayO2bIdhKvAjr-uW9rycbrxxDEw&_nc_
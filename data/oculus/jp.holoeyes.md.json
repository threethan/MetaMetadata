LAIfkGWWq0Y8Re-GYIx7cUeJWM9o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyzVWwZIkeQJQWT3zyVWnSXV_FpReQlhqLwVviE_q75xQ&oe=69B15BB5"}, {"file_name": "screenshot4.png", "id": "756637562706222", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974759_756637566039555_7395506445783665316_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eE89cHjQWcYQ7kNvwG6GI2g&_nc_oc=AdmLUK8RSnhDfbiVjQF_wwHEaHCKOMeueAqEbgYpOLvZh7vVQXas0c3vZnNQ9wUc00U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwLHOdDsIhpyHRaNZwA65ziyXUclm1rZojULXmfAEnWXg&oe=69B172A0"}, {"file_name": "screenshot5.png", "id": "553874096635567", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974780_553874099968900_7378651240689708759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G04eCY6pijQQ7kNvwH-Z9El&_nc_oc=Adlaewgj6jGknADDs3rcDtkI5c6Y01D_b07pDtEgeIexfHtnmFlUUo_Q8COCky7FZvk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy9St_z6OqfCE25m6VudaNRlt2TAyI8Krdr9U8-kUGt7A&oe=69B15244"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "md_cover_yoko.png", "id": "177397054888391", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001715_177397058221724_4824817095391091493_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1xhk5RCBsSUQ7kNvwE9ri9a&_nc_oc=AdmPStw-xJz2NOemM_EqIeQ9Uuj6vDhTOL7eTTNvFbTirskR5SU2qXa5UkBYBbKqDX8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzAdwUwp9HJquMyZcCF2FfrvZ1Gypff1FFJdkf_ezKm_Q&oe=69B15463"}, "display_name": "Holoeyes MD", "keywords": [], "long_description": "Holoeyes MD\" is a program that computer processes image information obtained by diagnostic imaging equipment and provides it for medical treatment. It does not perform automatic diagnosis. In addition to the standard function that displays images, there is an optional function that performs three-dimensional image processing.\n\nIt is to be installed and used on general-purpose IT equipment, etc. that meets the specifications specified by Holoeyes Corporation (hereinafter referred to as \"the Company\") in the manner specified by the Company and provided as a download. For details, please refer to the attached document.\n\nThe latest version of the attached document (electronic attachment) https://holoeyes.jp/pmda/", "short_description": "The medical imaging software \"Holoeyes MD\" is a controlled medical device (generic name: program for general-purpose diagnostic imaging workstations, certification number: 302ADBZX00011000) under the \"Act on Quality, Efficacy and Safety Assurance of Pharmaceuticals, Medical Devices, etc.\" (Pharmaceuticals and Medical Devices Act)."}, {"images": {"nodes": [{"file_name": "md_logo.png", "id": "5998065973633964", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003260_5998065976967297_260827317627691552_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hjGzr7GGIP4Q7kNvwErXlvC&_nc_oc=Adnzd5CMIoJicA6Y4NPNMDnCSZlljjoufWsYNWj8IrtJSCac5iMGZBPnuvxe5q7XDi8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyaFwGPLt9mcpWUPp8qJqcZLsLKWE2QkLpuXsnbqiYVJw&oe=69B15F4D"}, {"file_name": "md_cover_tate.png", "id": "2303415159832893", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974904_2303415163166226_7688600240374808365_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PTtKW2u_2vMQ7kNvwGY4UgZ&_nc_oc=AdnLolxoRE1WpAXp8vk5Sn0IwcHF3wslg6MJhWbxdQ8BJDPfthPhZ3TcpPz0AjC3C6g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzeYlZLbPWzERKZ3ViWhXpDz1465vuKviVLCLIwiNYU3w&oe=69B151AC"}, {"file_name": "md_cover_miniyoko.png", "id": "950325029433473", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031585_950325032766806_6345836855774372629_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f8X25DqxS6oQ7kNvwFMzMjr&_nc_oc=Adn5emKh6_K_KFDjFEZC6g_zooyPytpI4GE9bF5UtFkyiSk6LVDo_SHQ3xMOZxcL1-g&_nc_
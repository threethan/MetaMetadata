1_796704421797493_4273927429227272418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P2aE4slByNAQ7kNvwGwSaYj&_nc_oc=AdpNVu6PqomVOhI9bdousqAXRR3q4zcy6RbH58sFt0lOc7RLwm8hBCK5IP2Kno9zIZE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3vk2hsMUtLpFVDPLcwoRx272ilvRH2i0ZI9m2N5f2-Xw&oe=69F357DF"}, {"file_name": "screenshot3.png", "id": "243447578052170", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982528_243447581385503_1311164864357431428_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j1SARCOJCjkQ7kNvwGGB6on&_nc_oc=Adq1IDIRubicThXTnYbCd8RDPsXxg5_q9-DpWJiCgaVvJ16QiXvXuUH0KCPcALzdD8A&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2MCVI137YiSi1prCzORmgm5YpCzKBS6r9OEGqW1c6d-g&oe=69F346B5"}, {"file_name": "screenshot4.png", "id": "756637562706222", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974759_756637566039555_7395506445783665316_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z8H34ra6gBsQ7kNvwHefn5T&_nc_oc=Adr0nuYEq7-8w89g5tBbFj-EvzJXsl0antExmdvWkqJzjfcU6O8ttf6OdirpjObiaeY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2205A3s9t8wP2mdqJZkNP94JrreFQtgP-8PP4X8wK57w&oe=69F35DA0"}, {"file_name": "screenshot5.png", "id": "553874096635567", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974780_553874099968900_7378651240689708759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tn3lRG73kRgQ7kNvwHA6eK-&_nc_oc=Ado9_B7XmDUfNHHh6ay2zxl2xCx-Lw_YaQ98wxii79ub-KRazu0USU_KosLt_ypc9-w&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3bWlFo4w0uKqAHSmV1mulTJKX1FvZc6xJd8wHtq9AKCw&oe=69F37584"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "md_cover_yoko.png", "id": "177397054888391", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001715_177397058221724_4824817095391091493_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3HMgQ8SwIWUQ7kNvwFPQCYj&_nc_oc=AdrtPNHvQlg7WvLX5XJqxM25hUWLxvIonsfftW75fkLrsHfoTuFY_Y7xfrhGCBouv-0&_nc_zt=3&
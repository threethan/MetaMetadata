1_796704421797493_4273927429227272418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xCmfHy5egLMQ7kNvwEyJ35C&_nc_oc=AdoI32tyvFEkPRfnzqNEw5W9R5FJLkAVq0zzLNo6ubd55gq6QF6dJndaqbYWJZn3i0g&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7TC-b4sRt5p_DX2REGokvC5GXbno1U8_MmLdVXr-IubA&oe=6A0C645F"}, {"file_name": "screenshot3.png", "id": "243447578052170", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982528_243447581385503_1311164864357431428_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=42oes6cplVcQ7kNvwEZx3zN&_nc_oc=AdoHH0D3ofzGlvqNuMUgwGCqw1r4ssAvV781POVbUHLg_5LKAqxOIpZHe99lN261W0A&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5cXP9i-Zx88S2F86z-mTYokKAMqPOC3S3wcushhiApfA&oe=6A0C5335"}, {"file_name": "screenshot4.png", "id": "756637562706222", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974759_756637566039555_7395506445783665316_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pXc8Pnk7Fh4Q7kNvwGe0CpG&_nc_oc=AdqCX2kgdXhuI_d4SWW7geQ9U9PRAxBpjgMiIdGBx47COGXkXwqBlHGC8Lmhj7Hw76E&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7f9XzZ2cqry9BHGBq-PrBlu1zHASTq_ozJByli-HKrmg&oe=6A0C6A20"}, {"file_name": "screenshot5.png", "id": "553874096635567", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974780_553874099968900_7378651240689708759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hbTyZKc56soQ7kNvwF2M7pY&_nc_oc=Adqm5U_gNmLTyW0moHiYKwZOAYqsbrXWJwNt_H6f_cygPm00j7YI6HK2sHvRGzXhTVM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af764irpeAwro6bOetLB5zdCQ6ERh8j_oC50vehcsNnDtQ&oe=6A0C8204"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "md_cover_yoko.png", "id": "177397054888391", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001715_177397058221724_4824817095391091493_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q_zXLit9ihAQ7kNvwHAhSmH&_nc_oc=AdqAVmazORySejrw-omnzbEoaSOBfwan3VOjjNZ_8dwB7osJ_PUkbN151PuYVyOrXgg&_nc_zt=3&
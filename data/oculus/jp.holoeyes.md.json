1_796704421797493_4273927429227272418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MEZ6WTuOnsAQ7kNvwFVjNhJ&_nc_oc=Adr387TLG20pObIzK6DtRqXNH_TrpOriFp49fYPvWPBcmdNc6nq9UGs805qLJe1k-q8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4qKTfcD2x4ypMbztGBJHo4nKJqBv1LaKz5O2dG_z9Hw&oe=6A8AF45F"}, {"file_name": "screenshot3.png", "id": "243447578052170", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982528_243447581385503_1311164864357431428_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_MiFlkNxG9AQ7kNvwF4vkwY&_nc_oc=Adqi4oJ5Z3FhWYcxZ0lGx_3p-mkSb5h-2JzYKQg0mxzM5xiaacsfrgOH9Xp6191pACg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZY-HodfHG3R4lWg_p-vx8Pb7XOFDpp_uTyMPNKqssng&oe=6A8AE335"}, {"file_name": "screenshot4.png", "id": "756637562706222", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974759_756637566039555_7395506445783665316_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jr0OZhmlJncQ7kNvwGWTbTt&_nc_oc=Adq75yovx5dpEVa8h7Cu0UqzFZkDkg52pHng96R92Aau3MbkN4aNuCr5anMfH7j1KSs&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhTmhO8Yprw4d7udQV2jXEnzOtzbkkuSlIFLNqeeWuTQ&oe=6A8AC1E0"}, {"file_name": "screenshot5.png", "id": "553874096635567", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974780_553874099968900_7378651240689708759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vlc9gMxk14EQ7kNvwF1U1Xg&_nc_oc=AdpMFY5MAAZ8f6703XeYEfBKlfeptT2oECjXEkYSwW4cCWUb6XbDWWtEZ0jEfgfjwKE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEGJx2hcM4j5grjDPG-N1yEEZlWdLKcrTUs5l05-ijhfw&oe=6A8AD9C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "md_cover_yoko.png", "id": "177397054888391", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001715_177397058221724_4824817095391091493_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MT8RdBfUnMcQ7kNvwE3uZDU&_nc_oc=Ado8XzRbylWsrqG-ekiCt6o9X8wv5qxwpJCk9znlR9pnp8CnZP6-znyp5L6UM-VtyFo&_nc_zt=3&
1_796704421797493_4273927429227272418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lFPaZ3tMtfcQ7kNvwEK_L85&_nc_oc=Adr6MG8pD0lX-UJw-HLtpg05K6TpY7LCrwckCTSKTF49nJ80MxxtiJ1y3U7InRJATKc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHP9-4K4Xu8x38pNShJZBv4tujFiPqv7_S6frcvyBBMlg&oe=6A830B5F"}, {"file_name": "screenshot3.png", "id": "243447578052170", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982528_243447581385503_1311164864357431428_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EnnZahhWtZ0Q7kNvwGCn7B5&_nc_oc=AdrnfL3A9Zi_RMI_a6dAOV6PYieiBQyVHXDK5c9kseMyOdCyCnYEbjqvBroMszexy4M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHehJijNK6RVts28By8C1W1a2QBG60vGv1l_0lEMnls8g&oe=6A82FA35"}, {"file_name": "screenshot4.png", "id": "756637562706222", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974759_756637566039555_7395506445783665316_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RD1PBAK6DwkQ7kNvwHsSmC4&_nc_oc=AdpbFsW4cJQtE3bmzZ8tn04IdSD6jgTDQ5fZnBaSEY9RClIRcAEkTfIQJdWFvSnLbTI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGaZQQyqQNqQGsBqVDr3xhp6geu7_BSgrQn3qZK1ZMeSw&oe=6A831120"}, {"file_name": "screenshot5.png", "id": "553874096635567", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974780_553874099968900_7378651240689708759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TauRef5mkw0Q7kNvwGA8Cqm&_nc_oc=Adr6xsMBN0nJ07-jDK5M9zdpjlV4Yu9oiq4aM23wQB42EDm3EegNJYsRkqJfLkV3SWY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFo9xaC7QakUsBkvmzZc9wIHuiQKLZ5XVp2Z6eVJFj9Kg&oe=6A82F0C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "md_cover_yoko.png", "id": "177397054888391", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001715_177397058221724_4824817095391091493_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=72YbdflpUzgQ7kNvwH7i8wc&_nc_oc=Adrtoq2_i_leEG4FDSSmmdATWvfNNFgkF41PfA363KiNhvntmGAXbdEP16kbPvbf7_I&_nc_zt=3&
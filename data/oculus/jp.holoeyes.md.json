U8cE_qtv2HQzqD9LtipQw8YtLRv4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz49bho4BwnbBQ85L-M4xJDUs7nKCWzsHx6_pvVA1Lnpg&oe=69B944B5"}, {"file_name": "screenshot4.png", "id": "756637562706222", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974759_756637566039555_7395506445783665316_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qVvhCvQLHekQ7kNvwFxk-DO&_nc_oc=AdnxEOqciQf04pHtWNSe043CbmN-lxc82f155e2isCJjdGyAkNRjGdAjYGWgkbySf_g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxXMHSNAoffjjL8KQx8sUE2MEZeioG7pUlUrxPAWEKf6g&oe=69B95BA0"}, {"file_name": "screenshot5.png", "id": "553874096635567", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974780_553874099968900_7378651240689708759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mTbzExiegNQQ7kNvwGVKLED&_nc_oc=Adk4ZzT5zXC7KcYM6bLzbFJW8hNTshYZe2TvH59n77gNCJN3ZlRPsVICDSIvnIDtDSA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzyTd_N5YqN8e86G2UvHxv2pYXRCR1PHoStgmZr5ip6MQ&oe=69B93B44"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "md_cover_yoko.png", "id": "177397054888391", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001715_177397058221724_4824817095391091493_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w66hW7qakUIQ7kNvwF1N0oU&_nc_oc=Adm5zl45v9ocPukBw951qJK8GPIKKSHZO6sMm_nvxJTWqlr_RyFYi4FRJmnVhtSFeHc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwfVpMQlCYPJ_Idb55QckR8bpKsh9R1hAFv2o44xiANiA&oe=69B93D63"}, "display_name": "Holoeyes MD", "keywords": [], "long_description": "Holoeyes MD\" is a program that computer processes image information obtained by diagnostic imaging equipment and provides it for medical treatment. It does not perform automatic diagnosis. In addition to the standard function that displays images, there is an optional function that performs three-dimensional image processing.\n\nIt is to be installed and used on general-purpose IT equipment, etc. that meets the specifications specified by Holoeyes Corporation (hereinafter referred to as \"the Company\") in the manner specified by the Company and provided as a download. For details, please refer to the attached document.\n\nThe latest version of the attached document (electronic attachment) https://holoeyes.jp/pmda/", "short_description": "The medical imaging software \"Holoeyes MD\" is a controlled medical device (generic name: program for general-purpose diagnostic imaging workstations, certification number: 302ADBZX00011000) under the \"Act on Quality, Efficacy and Safety Assurance of Pharmaceuticals, Medical Devices, etc.\" (Pharmaceuticals and Medical Devices Act)."}, {"images": {"nodes": [{"file_name": "md_logo.png", "id": "5998065973633964", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003260_5998065976967297_260827317627691552_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kprQ0KHCjmMQ7kNvwHa5vSN&_nc_oc=AdlPEccFbOhCVM3QWBBexw3kynDQwrToKurp4CdX_8il0C_yawyl02HdPt5q6tgXVGk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxg3GKLJrLqjQ4a9E1FneGmTOW5WLaeW0VLk78zFBCcPA&oe=69B9484D"}, {"file_name": "md_cover_tate.png", "id": "2303415159832893", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974904_2303415163166226_7688600240374808365_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q63t2WSAT1YQ7kNvwGNVZEU&_nc_oc=AdmY4Iy03qPLGDYGPg2-UDB1mgwruITvrnUB7AyLuYcmXtlaXesE6xHIV6G0kWtqssk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afwcp_A23rIy7iAdPiVzmcU_h8LcASaJLhzQVrwYDlHKKg&oe=69B93AAC"}, {"file_name": "md_cover_miniyoko.png", "id": "950325029433473", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031585_950325032766806_6345836855774372629_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4LsBomce1VoQ7kNvwH0zr2l&_nc_oc=Adl_8yKERiLyDiSmtKZn5WOIRBT02VMKhc0BO5nHq-MSwmRnH-frVTFTAv36ELfpH8w&_nc_
1_796704421797493_4273927429227272418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tf_8WNh0VuwQ7kNvwGzN9FA&_nc_oc=AdrXvLuPrjYtcwHLryy1lOxUjV_7EVv4llUdE3MU4GzxANoxqgN_RRbTEor_CKZOT8c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPUuOIwgHfhgtvVgQ8cQ6x2axroKjEfCHabnAkN77QF6A&oe=6ADF545F"}, {"file_name": "screenshot3.png", "id": "243447578052170", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982528_243447581385503_1311164864357431428_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i_RbOQpSw7cQ7kNvwEijLxe&_nc_oc=Ado7JU0XJxqRYk5esa48VcQxPyCjl_Wm1_x30stwa2uJLeQQfkJGPNy2pktJpjxWOaw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPCZGWorp6NAu4AHaTautIa_2VqGO3H4TEMql5rL5-37g&oe=6ADF4335"}, {"file_name": "screenshot4.png", "id": "756637562706222", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974759_756637566039555_7395506445783665316_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kkAulZa0qLAQ7kNvwHuw8d6&_nc_oc=Adr2kELHZxdKyNd75KhEJnGWiuoLGmRe-7CXwQVPTxskjpUUvvapgIyApzzd68ANWrY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNv4BnmZh_0sn55XzUVCEQTIAyxBtZeaI3t3l0LhRZRTQ&oe=6ADF5A20"}, {"file_name": "screenshot5.png", "id": "553874096635567", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974780_553874099968900_7378651240689708759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pY6vfuYj7HIQ7kNvwE3oAMP&_nc_oc=AdpbnOZ1EJrJdrfysz7OyBVQizZsr4s-zSC2MG-kIqX08wuthYSX-nLZbEsupZNi2Lc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO3u6bG8PjUCA4_G2lscACy3yPzeObVSvUOw-qd6YjgDA&oe=6ADF7204"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "md_cover_yoko.png", "id": "177397054888391", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001715_177397058221724_4824817095391091493_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p2v1WYsaDmoQ7kNvwEIooXv&_nc_oc=Adq0E3kZf8xLkWdFF91JNsiw45u36vxPvUi_8eBhZ2UqrsKWOkEjsxZfti3DGkELB-s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMUZRuXkWheHbuA80cYaG8mLZCAbflJ1cN8pQIQiTFzMA&oe=6ADF7423"}, "display_name": "Holoeyes MD", "keywords": [], "long_description": "Holoeyes MD\" is a program that computer processes image information obtained by diagnostic imaging equipment and provides it for medical treatment. It does not perform automatic diagnosis. In addition to the standard function that displays images, there is an optional function that performs three-dimensional image processing.\n\nIt is to be installed and used on general-purpose IT equipment, etc. that meets the specifications specified by Holoeyes Corporation (hereinafter referred to as \"the Company\") in the manner specified by the Company and provided as a download. For details, please refer to the attached document.\n\nThe latest version of the attached document (electronic attachment) https://holoeyes.jp/pmda/", "short_description": "The medical imaging software \"Holoeyes MD\" is a controlled medical device (generic name: program for general-purpose diagnostic imaging workstations, certification number: 302ADBZX00011000) under the \"Act on Quality, Efficacy and Safety Assurance of Pharmaceuticals, Medical Devices, etc.\" (Pharmaceuticals and Medical Devices Act)."}, {"images": {"nodes": [{"file_name": "md_logo.png", "id": "5998065973633964", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003260_5998065976967297_260827317627691552_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ulIXKYwNzEcQ7kNvwHCYUgG&_nc_oc=AdrRQH4LJC5-FVZGFHIivR_lh-3f_LrEYQOWRNR2jeqb_r76RXGl0LMG2Yw06_GQKm8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOrYylbuPmae3az_vj0TfgP2C8ir021-WKvZCIlxsAY3Q&oe=6ADF46CD"}, {"file_name": "md_cover_tate.png", "id": "2303415159832893", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974904_2303415163166226_7688600240374808365_n.png?_nc_cat=101&
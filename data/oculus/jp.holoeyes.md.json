1_796704421797493_4273927429227272418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7RvO_6_uyj8Q7kNvwEGiEWr&_nc_oc=AdqqeSfVwAcjBBAUPOQrjyz6pEZGbDA2yUxh20qfwSY0DZ_h6A1NWsFN8M5xm_ef2Lk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1HbxzMoISXE3SZEhv1fM9KyFYnK07LFjc1U-UXAzoSNw&oe=69E628DF"}, {"file_name": "screenshot3.png", "id": "243447578052170", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982528_243447581385503_1311164864357431428_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yYpAkj0yUVsQ7kNvwHBAUyX&_nc_oc=AdoM_FsFrvGgFLpLHR72OW4FzPnFLw8oiqJeJfaNfyUGZgAHoX2Wb4XBfGVbLNNhINo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2P4quXJicSnf3WPaZw8np67jRj4B6VB5DR7Il1LNaQhw&oe=69E617B5"}, {"file_name": "screenshot4.png", "id": "756637562706222", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974759_756637566039555_7395506445783665316_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2HTd5a4YcxUQ7kNvwEZVGCN&_nc_oc=Adoojru0SJqK9baCaxx8FQTAGVbR8Kl0e5Xu5UJfF5bMuN6L2vaUwd89QAuCK4zMnuU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af28EIM7gT8d91bTkwB6loDTsP5b0VB6vaupyOJxoj8Rww&oe=69E62EA0"}, {"file_name": "screenshot5.png", "id": "553874096635567", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974780_553874099968900_7378651240689708759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4F5qOxRnZ9UQ7kNvwFXco3g&_nc_oc=AdpAG24hpcMZL-y4-Seb97dO4HnYNGac9cT4SLuQFf0cHjiJGLx9TR19QpHWHfvHktQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1q9IE7mJFiJtxljwNMwryv-ScMrG2STL5KpXyqg4Zo_A&oe=69E64684"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "md_cover_yoko.png", "id": "177397054888391", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001715_177397058221724_4824817095391091493_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xsVLknns2NoQ7kNvwG0Ndtt&_nc_oc=Adr8b-9CDKgIwCwLGPs_2uRFBjTd-5BpiTGMn_fads8ujWHQyE5MEFpBjVy7R5rTLhM&_nc_zt=3&
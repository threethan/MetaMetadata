BWX_z25eb3wWFjGAF96D0feSf88o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuG_--9YLaQDg4NbyaSuvnzov0HrSK76BoNYqCPYADmnA&oe=69A82135"}, {"file_name": "screenshot4.png", "id": "756637562706222", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974759_756637566039555_7395506445783665316_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RhsuorfQEZsQ7kNvwERnIxt&_nc_oc=AdnND5fLt8SPGDvtd-Si99Ag0KA4E76CFZvbrDRTIuRH9RMF8gPi4OQLo7C9EayOKws&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsiJbkpiPAFs1N_0riA8XB56JjAsE6NxdLSvGZ_hdth6w&oe=69A83820"}, {"file_name": "screenshot5.png", "id": "553874096635567", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974780_553874099968900_7378651240689708759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5xW6eiOQt7wQ7kNvwFeoVfV&_nc_oc=Adlxaw2AKK71hcpcPjYU6P8T-zlH15uPG69qMDIWgCA4c3qLla3Rb-sb_GqSAwD8rtk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftpBefFxG_Re60ODyJiSRngcyef0r7V341z4ycGur18GQ&oe=69A817C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "md_cover_yoko.png", "id": "177397054888391", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001715_177397058221724_4824817095391091493_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-MEBUe0AR4QQ7kNvwG_kMPS&_nc_oc=AdmyFfY9-tkpXU2fipo4hGPwGwlNp3-LpqEygjMMskOr-wxqPetzYjzI31vg7nqw4Is&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsU3CtZwe64JPiW89Iio0vYc_pQXv-NrrElC7H8v6zf4Q&oe=69A819E3"}, "display_name": "Holoeyes MD", "keywords": [], "long_description": "Holoeyes MD\" is a program that computer processes image information obtained by diagnostic imaging equipment and provides it for medical treatment. It does not perform automatic diagnosis. In addition to the standard function that displays images, there is an optional function that performs three-dimensional image processing.\n\nIt is to be installed and used on general-purpose IT equipment, etc. that meets the specifications specified by Holoeyes Corporation (hereinafter referred to as \"the Company\") in the manner specified by the Company and provided as a download. For details, please refer to the attached document.\n\nThe latest version of the attached document (electronic attachment) https://holoeyes.jp/pmda/", "short_description": "The medical imaging software \"Holoeyes MD\" is a controlled medical device (generic name: program for general-purpose diagnostic imaging workstations, certification number: 302ADBZX00011000) under the \"Act on Quality, Efficacy and Safety Assurance of Pharmaceuticals, Medical Devices, etc.\" (Pharmaceuticals and Medical Devices Act)."}, {"images": {"nodes": [{"file_name": "md_logo.png", "id": "5998065973633964", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003260_5998065976967297_260827317627691552_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mic9fS9uutgQ7kNvwHzIb0e&_nc_oc=Adl_mDZZqA86GRzpUnDhRtpaR2to_qB6V6EQPvZTmx9UvHKc9x8oLvkRJqmSeZsOOkk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftHnpkml5-HI_69-ROOJPD-yGylmyB2sdCG89KnqWuKow&oe=69A824CD"}, {"file_name": "md_cover_tate.png", "id": "2303415159832893", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974904_2303415163166226_7688600240374808365_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ugV4fZl99P0Q7kNvwH3Gmpr&_nc_oc=AdmaHLk0Qs6LSdrrM4IjrxOE80F0ER1aEYiY6FuDohkC55y-5I9h4oc-ItIzWeK7Pu0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Aft_T6SctoJQT-2Pb0JekMybLJ51uu_yhA3NZMWWuyG6xQ&oe=69A8172C"}, {"file_name": "md_cover_miniyoko.png", "id": "950325029433473", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031585_950325032766806_6345836855774372629_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XJz9OjSo4TwQ7kNvwE-uFNL&_nc_oc=AdkUybW8UQGjOgL1uNoOv0ct4Xa6CFjeGLcvMK8rL5oQlhGxV25FqeRNtZAkfKPTHNA&_nc_
1_796704421797493_4273927429227272418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QY_Sf4rJfm8Q7kNvwGk7QGb&_nc_oc=AdoWvwyou_T373WOKTCq3Vj457zZfo5govcI00AkjxeXxs08tuQ-us2K9VSdsVGdrbE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCR5bizG3Y5FhYpa8nfx8i2sVQShgPni9fgnQzW2txsFg&oe=6A5A2CDF"}, {"file_name": "screenshot3.png", "id": "243447578052170", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982528_243447581385503_1311164864357431428_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jx214lUk_ggQ7kNvwF6ln4T&_nc_oc=AdpWyn_D8SWg3xal4RoJF5xevDyQhtcX4WHbFH-oTWi2_rjL3ptvgBF1L7icz_UuOJg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCoyYbsPFm-mIgbNwdOBtKI_Duv1WnUaGQR2_p3dYqM9g&oe=6A5A1BB5"}, {"file_name": "screenshot4.png", "id": "756637562706222", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974759_756637566039555_7395506445783665316_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Tzbf69RdQoQ7kNvwE3h87Y&_nc_oc=AdrnK4hTFOlTAOYlFrbjcSXlq7NDLFrgsTx2BaKvjpOudIDJKWNVtCkjUHss1498XzA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBdsHnbnGRqOzX7JhaM_eKsTUyW4rICB8n1iQaiQY0TDw&oe=6A5A32A0"}, {"file_name": "screenshot5.png", "id": "553874096635567", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974780_553874099968900_7378651240689708759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Da5xHKgLdtEQ7kNvwFOMl2L&_nc_oc=Adp5x5CkTgVaCBvA_utgry_zZguGTX9_8gd1XUcYXlpAbmlYIavfKEgL_T_0MF5s6nQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDVDZ-JBBDkGbT6SeLb5864q3h7vMJTxJE9z16a-k7ruw&oe=6A5A4A84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "md_cover_yoko.png", "id": "177397054888391", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001715_177397058221724_4824817095391091493_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i5Rg4_8siMoQ7kNvwFGb7Fg&_nc_oc=AdrWPoMTdRcegeC_R0trpazV_vtNB_W6mGnfDhB49BT4mTbwWQnmFAGS5KnWu8-Phmo&_nc_zt=3&
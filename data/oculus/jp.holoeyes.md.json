5503_1311164864357431428_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fD7vSu7hQZYQ7kNvwHxftM0&_nc_oc=AdqxWunjRWOE5rfVU0vzxCqAMkxjnMGRcnB0qIxHgVgeU17sx4G440mrt5CBA2ed8kI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBfJaCv-FClRJqbyfG4vJ7zSFmD-bGMF4ZIaEOQDDPCgw&oe=6A60B335"}, {"file_name": "screenshot4.png", "id": "756637562706222", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974759_756637566039555_7395506445783665316_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YbeMaY3E4U8Q7kNvwEpwM_U&_nc_oc=Adr48sjjEPQ2NSm0sZjdZ0gCfGPJB4wLiKuM604bjjsiJzmCywHXbG9Qy12Za3sZnQ0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCjbAjn2UPNIFBnThTOhTNqFq7UCFLHKh4libthTrPW-g&oe=6A60CA20"}, {"file_name": "screenshot5.png", "id": "553874096635567", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974780_553874099968900_7378651240689708759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UXwvadHNb7kQ7kNvwE5-p3U&_nc_oc=Ado353qu5fFWsp-STU2cD-bRupoZPz6Bzd4lZGW7XqSMIgjprqF45UhkXQ4SbWoCUO8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBRPzPGb_c-5V9jN90BU9XHLLVOHnUvrELxYxCyBB1XSA&oe=6A60A9C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "md_cover_yoko.png", "id": "177397054888391", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001715_177397058221724_4824817095391091493_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kt4RPfemoP4Q7kNvwH40YCc&_nc_oc=AdrTGeyCf3F6UCc9sukCMv3RuL1XwI5l_ljFirpV7gUD6wRgR0JERl6Yxcuhfzl1kgg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDn6RJeOYNpZoj9ZPNWcwFlN1KFq9vB7tp0wuTWIfHabw&oe=6A60ABE3"}, "display_name": "Holoeyes MD", "keywords": [], "long_description": "Holoeyes MD\" is a program that computer processes image information obtained by diagnostic imaging equipment and provides it for medical treatment. It does not perform automatic diagnosis. In addition to the standard function that displays images, there is an optional function that performs three-dimensional image processing.\n\nIt is to be installed and used on general-purpose IT equipment, etc. that meets the specifications specified by Holoeyes Corporation (hereinafter referred to as \"the Company\") in the manner specified by the Company and provided as a download. For details, please refer to the attached document.\n\nThe latest version of the attached document (electronic attachment) https://holoeyes.jp/pmda/", "short_description": "The medical imaging software \"Holoeyes MD\" is a controlled medical device (generic name: program for general-purpose diagnostic imaging workstations, certification number: 302ADBZX00011000) under the \"Act on Quality, Efficacy and Safety Assurance of Pharmaceuticals, Medical Devices, etc.\" (Pharmaceuticals and Medical Devices Act)."}, {"images": {"nodes": [{"file_name": "md_logo.png", "id": "5998065973633964", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003260_5998065976967297_260827317627691552_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UbW1vvd6bR4Q7kNvwHzldH7&_nc_oc=AdqOoFFkLPOTVAxRlqBob2czgqByyIzdkf5wjeZLPk36gT89hrjL94zLUEsMOEhV_bo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZcFZxhgcHy6smC2Iiop9nKhXUNhpVkNTAemSz7cNibQ&oe=6A60B6CD"}, {"file_name": "md_cover_tate.png", "id": "2303415159832893", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974904_2303415163166226_7688600240374808365_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TgcdA0X689EQ7kNvwH_0jH7&_nc_oc=AdpnrI0PjtsUmTSo4z2ES-gGAcGOCGtFzt8OckBdrL6qFswO8jEhifiQuXdogA8-SXI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBasrDQG00abiR2Qv7gxNX6auTOI9j3KQAORU8K4glJBw&oe=6A60A92C"}, {"file_name": "md_cover_miniyoko.png", "id": "950325029433473", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031585_950325032766806_6345
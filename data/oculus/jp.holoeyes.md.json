gwxTfQIPV21br70Ismu83BXB6wpI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzRzP1HoALumx3fe65BDFNwRDH2oNyOsy9kj6BwiIEIxQ&oe=69AEB8B5"}, {"file_name": "screenshot4.png", "id": "756637562706222", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974759_756637566039555_7395506445783665316_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DF39dnfS6DYQ7kNvwHkiDdU&_nc_oc=Adl7HzeKigIKiRmNQ--MfLxhCrZ0yUrFGD1HDkqQtnGnz0wDhesCm_8ea-ySSIDCSrE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzyl7EhjSS29JS-RqL7ijl30Dq7OvMsZEcUmyiwZDBM_w&oe=69AECFA0"}, {"file_name": "screenshot5.png", "id": "553874096635567", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974780_553874099968900_7378651240689708759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SvtHq9-UisoQ7kNvwG-rvY5&_nc_oc=Adku7jezCh5WUETSRzmnl9pTHkmxiH3dlBdxkkx-wIfnO1wCFwdHgyl0ULl4vx_mAsI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzJkeS4fEz_7U6b169wdJA0GAyGjxd3iAB734wQbEdinw&oe=69AEAF44"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "md_cover_yoko.png", "id": "177397054888391", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001715_177397058221724_4824817095391091493_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1xhk5RCBsSUQ7kNvwHYYXYC&_nc_oc=Adn8xw93uhi-VomnxCDkW3gd6XoO3p8XSmnXs4r5_ma5PwqrvbzeVp1660PZzewK1hk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxL_ylpV4OOCHgynFyMjKM-A-EzT7s3fCY586nfe_E_zQ&oe=69AEB163"}, "display_name": "Holoeyes MD", "keywords": [], "long_description": "Holoeyes MD\" is a program that computer processes image information obtained by diagnostic imaging equipment and provides it for medical treatment. It does not perform automatic diagnosis. In addition to the standard function that displays images, there is an optional function that performs three-dimensional image processing.\n\nIt is to be installed and used on general-purpose IT equipment, etc. that meets the specifications specified by Holoeyes Corporation (hereinafter referred to as \"the Company\") in the manner specified by the Company and provided as a download. For details, please refer to the attached document.\n\nThe latest version of the attached document (electronic attachment) https://holoeyes.jp/pmda/", "short_description": "The medical imaging software \"Holoeyes MD\" is a controlled medical device (generic name: program for general-purpose diagnostic imaging workstations, certification number: 302ADBZX00011000) under the \"Act on Quality, Efficacy and Safety Assurance of Pharmaceuticals, Medical Devices, etc.\" (Pharmaceuticals and Medical Devices Act)."}, {"images": {"nodes": [{"file_name": "md_logo.png", "id": "5998065973633964", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003260_5998065976967297_260827317627691552_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hjGzr7GGIP4Q7kNvwHPmoEd&_nc_oc=Adk1nM5niic6cEBWsROCUsIBKbDRqIlRz_M1amVL_kL23aHeFAWPjgugCulxdzSV2mA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzNv2EBYhlZETJkpycJIpdvU_sL2tLXfzcaPYVzaJfpJg&oe=69AEBC4D"}, {"file_name": "md_cover_tate.png", "id": "2303415159832893", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974904_2303415163166226_7688600240374808365_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z7e65hemkL8Q7kNvwFbxICm&_nc_oc=AdkZK0w8UrJgAf4dwSPD_7ApT9d82S7P4F2VcmmwaSVj5Okbk2YxPewGe31wF2Am5Uo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz7DkwYATES99FcMF5K_Ayy2A1PJ3KsJ6iJe0nD87D3EA&oe=69AEAEAC"}, {"file_name": "md_cover_miniyoko.png", "id": "950325029433473", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031585_950325032766806_6345836855774372629_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2DnYIHen7pgQ7kNvwGU5d5o&_nc_oc=AdmmaXFU1RyWUmtadfqapd-Ube1gdToVUZfBmm1DQ2-qeIK4PsgyFq65Se1E_VRDz3c&_nc_
9eFBvWHT42_h4UzJ15KpSFGvum4I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyLZrJaJAQYnuJtDWOCsYbrYclUAi0VxdmObW1HhHVH2A&oe=69B6A1B5"}, {"file_name": "screenshot4.png", "id": "756637562706222", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974759_756637566039555_7395506445783665316_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LKnz5Hi6kTAQ7kNvwF0ozOw&_nc_oc=AdkVWkSsb6ZB4Ddz4wBUHeeD3tR8q8b41gv9hzkEExcBLCXbK3XSZIYwKhqH8vpDDOQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afw-cEHDio4vkbe9pIJSe2UxA58AK0QusmUfUZmdLRRHuA&oe=69B6B8A0"}, {"file_name": "screenshot5.png", "id": "553874096635567", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974780_553874099968900_7378651240689708759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UhuIfnn7oY8Q7kNvwE6Nhg7&_nc_oc=AdkOy7laQwHM_mgL2MhDkjcVzAGNrOyNwjFej7mfH2TTHKxOdM3zug7KOLXYzhRFk6w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw3QDXhHjY9yUA2gqRRQbhb6Sd3v4vHgqyOckNjqjpcJQ&oe=69B69844"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "md_cover_yoko.png", "id": "177397054888391", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001715_177397058221724_4824817095391091493_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w66hW7qakUIQ7kNvwEDll1m&_nc_oc=Adn3jb6alu_9hmxrM33pGd6ElSTGus_bb-7nuNY9LfjvYYBEStDN5eWRehn86IK29rw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzxiP4KuV1ara3lWfXaLMAq4uwICxvRM9GngeiOz7xrIQ&oe=69B69A63"}, "display_name": "Holoeyes MD", "keywords": [], "long_description": "Holoeyes MD\" is a program that computer processes image information obtained by diagnostic imaging equipment and provides it for medical treatment. It does not perform automatic diagnosis. In addition to the standard function that displays images, there is an optional function that performs three-dimensional image processing.\n\nIt is to be installed and used on general-purpose IT equipment, etc. that meets the specifications specified by Holoeyes Corporation (hereinafter referred to as \"the Company\") in the manner specified by the Company and provided as a download. For details, please refer to the attached document.\n\nThe latest version of the attached document (electronic attachment) https://holoeyes.jp/pmda/", "short_description": "The medical imaging software \"Holoeyes MD\" is a controlled medical device (generic name: program for general-purpose diagnostic imaging workstations, certification number: 302ADBZX00011000) under the \"Act on Quality, Efficacy and Safety Assurance of Pharmaceuticals, Medical Devices, etc.\" (Pharmaceuticals and Medical Devices Act)."}, {"images": {"nodes": [{"file_name": "md_logo.png", "id": "5998065973633964", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003260_5998065976967297_260827317627691552_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kprQ0KHCjmMQ7kNvwFZIPXe&_nc_oc=AdlqvwZ0Z9c-8hWtKlj5jtzXa_k5FORebg5Z6elQG3pbIdeQCgGI95hl80gql_jAfOE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzYd3qhQUU1kLzvhz10hwdYNYvKlI95WEZXi8igAnlrbw&oe=69B6A54D"}, {"file_name": "md_cover_tate.png", "id": "2303415159832893", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974904_2303415163166226_7688600240374808365_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PswobUF-bxIQ7kNvwG-r2Qu&_nc_oc=Adm4z_mtxQ2tmJH97Jzp3i_TKiU7_GndyQNCUojS6qvoPXoMsdXcI4ez5M-KAM4k4Gs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzH5uyHFJG6qA0DYLuGZyi7TfJEm1XyMSZKNhALMHN8aA&oe=69B697AC"}, {"file_name": "md_cover_miniyoko.png", "id": "950325029433473", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031585_950325032766806_6345836855774372629_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c2-X1hg7-DwQ7kNvwFsCPsu&_nc_oc=AdmB6Uc5OLMyqUIHDo4TP2MzUH4JoNrnNTUmUoXhYbPmziK0IRyAS9Jm9qwMOx55pNs&_nc_
NOcMdsrKq8LGCV73PzoGN7MFKkVk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afz8DSW7xTvMlmQOEwvrFExT-IZj1en_3thG82IQciYzaw&oe=69C12DB5"}, {"file_name": "screenshot4.png", "id": "756637562706222", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974759_756637566039555_7395506445783665316_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7KTzBZt7K5QQ7kNvwGuaz4U&_nc_oc=Adp8X63VD6_Z6AznrS-MJVYkJWnNC2Uy_qzuiOr0RpXBPYGKoHyUxyvLAmaKisdW9NI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfycWA22_qWlnZDkLKPFRb-jjoncU_qq5rke7y81Q3jggQ&oe=69C144A0"}, {"file_name": "screenshot5.png", "id": "553874096635567", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974780_553874099968900_7378651240689708759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GPKIV5JMVGUQ7kNvwHxupF7&_nc_oc=Adr-McO6aU9wnmLlNuovd3uQbyc-1KUauRb3r1r_zh82-n1R0NvBKfgfyO5uPTGRa48&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwxW0lmVIxmTfbwLaOYbb5yrP-Re0mo_GoRIjjk9poqHQ&oe=69C12444"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "md_cover_yoko.png", "id": "177397054888391", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001715_177397058221724_4824817095391091493_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u4LVnc-J2FcQ7kNvwGxFJ1g&_nc_oc=Ado_Kef2vmt40wL7Y7a_XD62mZr5LYybBTkxRGjzM_vTMQm4Twb3klkfI-GTsLtEcYI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afymu3pKqwktUbv-a7r89ZwS51B0QMXEgbm-OALmY0HfbQ&oe=69C12663"}, "display_name": "Holoeyes MD", "keywords": [], "long_description": "Holoeyes MD\" is a program that computer processes image information obtained by diagnostic imaging equipment and provides it for medical treatment. It does not perform automatic diagnosis. In addition to the standard function that displays images, there is an optional function that performs three-dimensional image processing.\n\nIt is to be installed and used on general-purpose IT equipment, etc. that meets the specifications specified by Holoeyes Corporation (hereinafter referred to as \"the Company\") in the manner specified by the Company and provided as a download. For details, please refer to the attached document.\n\nThe latest version of the attached document (electronic attachment) https://holoeyes.jp/pmda/", "short_description": "The medical imaging software \"Holoeyes MD\" is a controlled medical device (generic name: program for general-purpose diagnostic imaging workstations, certification number: 302ADBZX00011000) under the \"Act on Quality, Efficacy and Safety Assurance of Pharmaceuticals, Medical Devices, etc.\" (Pharmaceuticals and Medical Devices Act)."}, {"images": {"nodes": [{"file_name": "md_logo.png", "id": "5998065973633964", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39003260_5998065976967297_260827317627691552_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZyWBdfOLc20Q7kNvwEm9X7K&_nc_oc=Ado427yrUV-Wiaeuu4uDDAynlkR-zdlRbKCChPKmOcdfBbJdtg92xC4zyzvGGpTJe84&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afyocg0IW-pwI1LmKr8GG-ndsULQWISTbKibK8eRpam27A&oe=69C1314D"}, {"file_name": "md_cover_tate.png", "id": "2303415159832893", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974904_2303415163166226_7688600240374808365_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=59Fupmgc-YMQ7kNvwEAA2jp&_nc_oc=Ado9dSPWCQZ2XPYWZjySrEUaAd8pmI2PMvB9hHqUj1zXxdjgg-7cNDzfz-n7D_MoOyo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxESnBMD8VZ1PRtQUIty3aa35z6XHob0zUbdAuaGnIfhQ&oe=69C123AC"}, {"file_name": "md_cover_miniyoko.png", "id": "950325029433473", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031585_950325032766806_6345836855774372629_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FypkuwvWhmUQ7kNvwGBSt1d&_nc_oc=Adp1P5tajS2_5msPWkpqddp3wshI7xr6Ovf4aY7S0qMI6ERnL6HosqKY7Y3ziuSbgOM&_nc_
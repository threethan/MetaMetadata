06QpofXDypyZRLZXta8yP9vFwKjA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx79QnKrFokMBQCv67YDyye-uaL6MKowCCYdxJGK70Dgg&oe=69B00A35"}, {"file_name": "screenshot4.png", "id": "756637562706222", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974759_756637566039555_7395506445783665316_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eE89cHjQWcYQ7kNvwFtlOY2&_nc_oc=AdlRx5VQl-hss0WcuSnKYOwdlgnYyS3htUXJ1is9J6p7Fj85gymrFgzmZntZlCHuAI8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyHBMGZcZ740nhJuXuIzODREC5lUE9z6bHWkodtuefktA&oe=69B02120"}, {"file_name": "screenshot5.png", "id": "553874096635567", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974780_553874099968900_7378651240689708759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SvtHq9-UisoQ7kNvwGCJlXa&_nc_oc=AdnEnohzGgGdmMHZjHfVSv13bblkvVFPSDT-LXmRd7C-vwlvOL5pfRWukgv9i_0_tDE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzCf38j9m8vZa1NGzBDzCmCVORmMKdTano6Kpwnddd9Ag&oe=69B000C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "md_cover_yoko.png", "id": "177397054888391", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001715_177397058221724_4824817095391091493_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1xhk5RCBsSUQ7kNvwFN41LA&_nc_oc=AdlPfNUwvllwgmI_cSlygJilfZyBojNTSUKyXXSiqTdUDanEQDw1c2RbvwsqWGBpqGU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyvkMupomeWGqSXMSCLnBQAjkKdt05y42EUBEWk7qkjIQ&oe=69B002E3"}, "display_name": "Holoeyes MD", "keywords": [], "long_description": "Holoeyes MD\" is a program that computer processes image information obtained by diagnostic imaging equipment and provides it for medical treatment. It does not perform automatic diagnosis. In addition to the standard function that displays images, there is an optional function that performs three-dimensional image processing.\n\nIt is to be installed and used on general-purpose IT equipment, etc. that meets the specifications specified by Holoeyes Corporation (hereinafter referred to as \"the Company\") in the manner specified by the Company and provided as a download. For details, please refer to the attached document.\n\nThe latest version of the attached document (electronic attachment) https://holoeyes.jp/pmda/", "short_description": "The medical imaging software \"Holoeyes MD\" is a controlled medical device (generic name: program for general-purpose diagnostic imaging workstations, certification number: 302ADBZX00011000) under the \"Act on Quality, Efficacy and Safety Assurance of Pharmaceuticals, Medical Devices, etc.\" (Pharmaceuticals and Medical Devices Act)."}, {"images": {"nodes": [{"file_name": "md_logo.png", "id": "5998065973633964", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003260_5998065976967297_260827317627691552_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hjGzr7GGIP4Q7kNvwHKNgFc&_nc_oc=Adm9Cjbkkaz0F7D37PTkuy_SZDLgHbWxT6_9PysN9hvPOK4fzUxu6AD3KKIEkUxWK5Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyKi8Yfoph4BdhWo68nbz250aGlCH2Vvh1ODL2ZhH2uuA&oe=69B00DCD"}, {"file_name": "md_cover_tate.png", "id": "2303415159832893", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974904_2303415163166226_7688600240374808365_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PTtKW2u_2vMQ7kNvwG1yfu-&_nc_oc=AdnZWGVCIpWj6wiIvZj4hL0SKuGgU3nGtg9d9AqOCArsRLG5xovYRt2FTQ8kogiwI4Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzbcvoiCo-aVc8N2ntJE3c0rmATvjQZEDP4L4rNrizevA&oe=69B0002C"}, {"file_name": "md_cover_miniyoko.png", "id": "950325029433473", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031585_950325032766806_6345836855774372629_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f8X25DqxS6oQ7kNvwHE2kyh&_nc_oc=AdlEqtgO0CNhgvBVXkvxBooY7mfiiWlxWj-A8EEVcqP74SjciePUMN5SqYbaPtmy77g&_nc_
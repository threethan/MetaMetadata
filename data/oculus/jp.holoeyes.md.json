1_796704421797493_4273927429227272418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y3LhMA1lfgYQ7kNvwGPe7Q6&_nc_oc=AdrJ-3WX6GEphcirNI2zu1200Sc75lE98DYCbfqaIJV2RmmtbNJTD9lOhVC_FED0Now&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGFRKZeBMXHsEZ1vNJSemVv1qV3a4KOO315W1To4n385Q&oe=6A903A5F"}, {"file_name": "screenshot3.png", "id": "243447578052170", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982528_243447581385503_1311164864357431428_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KRVBHonp9bkQ7kNvwEnWoIr&_nc_oc=AdrIRPT0dSJytGxP7EgE_Ine3rigxUsivMMQg3P8SuM5hadMxKuMbSYo83yh9zSQO_g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxjWG8XDDlGEOO66sZFRGCGpXp9Y3-wTSrHgKp9OEfdQ&oe=6A902935"}, {"file_name": "screenshot4.png", "id": "756637562706222", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974759_756637566039555_7395506445783665316_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nf0rbPHs0J4Q7kNvwGmYBIl&_nc_oc=AdrrXpmBh8epBuJpgTDlqsTgMxzSRntTxq9IuwyBYRg0vZ_s2wumAIRPb-_YOAj5T_M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5-G0s3bvnVTBHKNo-h0-ZXL5u0IPCgeV5l-uUGj9k_Q&oe=6A9007E0"}, {"file_name": "screenshot5.png", "id": "553874096635567", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974780_553874099968900_7378651240689708759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=doE3yUFMuJIQ7kNvwHX8XpD&_nc_oc=Ado5wzqoMSL9M8S3AifGDp150AdTUaVCXcY3_Dfzu-zJ-nYIp__K6Z7BrXKJ1A6wPpM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH99QHKCGTUmoyJ7IEhGIIIbqd7ze5GMIvOPIa9KhPlgg&oe=6A901FC4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "md_cover_yoko.png", "id": "177397054888391", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39001715_177397058221724_4824817095391091493_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Sf2n3wRp74Q7kNvwHD6ZMH&_nc_oc=AdpslPHYoX9B39267o-8nmNOm9UAmkiNWui4Ul1SOYMIryekK3ruSo16ST6hPZ7KcfE&_nc_zt=3&
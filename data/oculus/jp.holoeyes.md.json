3KBedhVQJmpjdST0e09CEr95FTTc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxBv838zdxs9FNm7QPM9o8XvD7SPmo9MwyN2mmBTDt8Dw&oe=69BA9635"}, {"file_name": "screenshot4.png", "id": "756637562706222", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974759_756637566039555_7395506445783665316_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qVvhCvQLHekQ7kNvwE_SP1n&_nc_oc=AdlIuQq65NLaOCkMWy6tf3_LyNma1-iVcPXACdo_eRQ-SUpevyjXHupe3gKDocIyceo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxyMsxmSO5b3dSbk64f7FIiUW-Q4ovqMxJb8WRYIYu8OQ&oe=69BAAD20"}, {"file_name": "screenshot5.png", "id": "553874096635567", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974780_553874099968900_7378651240689708759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mTbzExiegNQQ7kNvwEe5loG&_nc_oc=AdlcYWoxizpp8tbvjhhw1n9-SbgxtJJpVAW92PZOG_p_HkzOdKEI93g5Mpxe7G5lot0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfztFSw0c_QaR3Qz2XdccFcEWN21U2n084j0zQh3t3A4Jg&oe=69BA8CC4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "md_cover_yoko.png", "id": "177397054888391", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001715_177397058221724_4824817095391091493_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4kWEe8nfJYQQ7kNvwEW5PiY&_nc_oc=Adk2KywgG_oREZB0Ajztprsrty2CIK1b8atgHfSUTQNr6-qh-_nI-Om-1kiwL5w9jFI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxC2zigxFsl9TTwMb3HUSmStz4Gy9myHc4LHTrKygCmjA&oe=69BA8EE3"}, "display_name": "Holoeyes MD", "keywords": [], "long_description": "Holoeyes MD\" is a program that computer processes image information obtained by diagnostic imaging equipment and provides it for medical treatment. It does not perform automatic diagnosis. In addition to the standard function that displays images, there is an optional function that performs three-dimensional image processing.\n\nIt is to be installed and used on general-purpose IT equipment, etc. that meets the specifications specified by Holoeyes Corporation (hereinafter referred to as \"the Company\") in the manner specified by the Company and provided as a download. For details, please refer to the attached document.\n\nThe latest version of the attached document (electronic attachment) https://holoeyes.jp/pmda/", "short_description": "The medical imaging software \"Holoeyes MD\" is a controlled medical device (generic name: program for general-purpose diagnostic imaging workstations, certification number: 302ADBZX00011000) under the \"Act on Quality, Efficacy and Safety Assurance of Pharmaceuticals, Medical Devices, etc.\" (Pharmaceuticals and Medical Devices Act)."}, {"images": {"nodes": [{"file_name": "md_logo.png", "id": "5998065973633964", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39003260_5998065976967297_260827317627691552_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w-beC-RjKKcQ7kNvwFY8nrk&_nc_oc=AdndkNI5PJU0Z1eQq8kRd65nl7Yi_dLwKyO7pQG4N2VeHCc5I0wprQqEBmwr4vY-dnc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzs1ob3plTTg7rdjLt4AeSKytsqXpJ7chweAaPfJg_vBw&oe=69BA99CD"}, {"file_name": "md_cover_tate.png", "id": "2303415159832893", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974904_2303415163166226_7688600240374808365_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q63t2WSAT1YQ7kNvwHlsooK&_nc_oc=AdmMHqr1gFv_VhjImYK2zoy1cwgVl8lvELywlULoGNWfaQTYzmq4r0HUlpc_HJ9kGPY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxRIUVzmWZ4lbY5vaYmIrAM4wkctEazST6Tpw3e2_C0pA&oe=69BA8C2C"}, {"file_name": "md_cover_miniyoko.png", "id": "950325029433473", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031585_950325032766806_6345836855774372629_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4LsBomce1VoQ7kNvwEz5cih&_nc_oc=AdlLj7QrgwqVOZUcct40UD8G31N4kXWWyDMTvvBRxITgIG0BHJehYtYX9wAGGlFI22A&_nc_
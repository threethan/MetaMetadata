2XuNFI6Ggh4-SaRz2I8Wji8Zhxr0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyYoYGwAzeLG_fFP7ddUJ2ac3XgSvxXopkS6LNserHUDA&oe=69B55035"}, {"file_name": "screenshot4.png", "id": "756637562706222", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974759_756637566039555_7395506445783665316_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LKnz5Hi6kTAQ7kNvwFI51fd&_nc_oc=AdnHvA8yODBRCqGe9aOUzURG8ZkFHZg1_BFvWQn0DmBEe9zbUongyxPRkoIFYPNZLRE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxc6vVg9j74WfOUpRjPA_42zEicOoYxgQle_rMvIC3Tvw&oe=69B56720"}, {"file_name": "screenshot5.png", "id": "553874096635567", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974780_553874099968900_7378651240689708759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UhuIfnn7oY8Q7kNvwGJrIpe&_nc_oc=Adms3IxSHYUCVNJ4TiUUhrSeaYJ-2LXNf-HKGkJYrKokOrA_yOTZsD47RH0VKTYSXag&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwLtmcs3mfif7MMTeSUmLtYKr9y3Zci-T4mPhqDJ-CPXg&oe=69B546C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "md_cover_yoko.png", "id": "177397054888391", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001715_177397058221724_4824817095391091493_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oesCrIxJtlkQ7kNvwHBWssU&_nc_oc=Adn6310ps3B2pj6GlOK8htSo3ckFL8GWGxUiwkaGNBzKiC8lysvRmcDztXk6Xb0MiKg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwguY_M5cw8msP22EhLsTTmZEaghuGH_jPshoe3IpaDoA&oe=69B548E3"}, "display_name": "Holoeyes MD", "keywords": [], "long_description": "Holoeyes MD\" is a program that computer processes image information obtained by diagnostic imaging equipment and provides it for medical treatment. It does not perform automatic diagnosis. In addition to the standard function that displays images, there is an optional function that performs three-dimensional image processing.\n\nIt is to be installed and used on general-purpose IT equipment, etc. that meets the specifications specified by Holoeyes Corporation (hereinafter referred to as \"the Company\") in the manner specified by the Company and provided as a download. For details, please refer to the attached document.\n\nThe latest version of the attached document (electronic attachment) https://holoeyes.jp/pmda/", "short_description": "The medical imaging software \"Holoeyes MD\" is a controlled medical device (generic name: program for general-purpose diagnostic imaging workstations, certification number: 302ADBZX00011000) under the \"Act on Quality, Efficacy and Safety Assurance of Pharmaceuticals, Medical Devices, etc.\" (Pharmaceuticals and Medical Devices Act)."}, {"images": {"nodes": [{"file_name": "md_logo.png", "id": "5998065973633964", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003260_5998065976967297_260827317627691552_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kCx3cVXo4MwQ7kNvwEYgs1W&_nc_oc=AdncwO5-4wF4PcuU4LXSN0s_gTvUeqJJRRvIs05Z47orAbEq8Z9Ysb5KdVQSnvwvzMI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzU5lndjboZss7Oegl9mCN9Ef-8rnV6eljrMW3io8c-wA&oe=69B553CD"}, {"file_name": "md_cover_tate.png", "id": "2303415159832893", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974904_2303415163166226_7688600240374808365_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PswobUF-bxIQ7kNvwHYpE1h&_nc_oc=AdlkFXptUg0MD56hUDMigMvzc33Q3oXafFW6NS4Gh1j9xbhJufk3er05rlL90PTq2fg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwAc9APdHejwI5XHyuy61M45yK006kRg8JVa5IwLkXBwg&oe=69B5462C"}, {"file_name": "md_cover_miniyoko.png", "id": "950325029433473", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031585_950325032766806_6345836855774372629_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c2-X1hg7-DwQ7kNvwH73gqn&_nc_oc=Adnp4E6_IX1qPjoDUR09D_H3XNvIKU6_Atp0VojFzr6CWxfR4-mRuSSNgCLdXktrmS4&_nc_
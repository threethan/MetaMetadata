1_796704421797493_4273927429227272418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P2aE4slByNAQ7kNvwH40H2r&_nc_oc=AdpzBIiVi58jHcEomICDgY57asqll49hCrCXV1YSCGqG-praPeg1kVWldxnDHdymVUw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af16gwmKQNOVIIbdI5oZRk8Vrjd63C_Qf29MbRJpesp74w&oe=69F4A95F"}, {"file_name": "screenshot3.png", "id": "243447578052170", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982528_243447581385503_1311164864357431428_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4E3trheNjYQQ7kNvwGn_NtA&_nc_oc=Adop8fL3LRK_k994lQU2ETvJed3plHtzJHEgxLxpeqzQTgs-8XxrhNQki9dK66PlLuI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2zSQ1X6dsbo4zu46XWmxJGiE6lLq9CtSigVpDFYkqEFA&oe=69F49835"}, {"file_name": "screenshot4.png", "id": "756637562706222", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974759_756637566039555_7395506445783665316_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z8H34ra6gBsQ7kNvwGoxHVV&_nc_oc=AdptQi4RHSwZ4mhm6XeQNWC-VoZiKjkClgtP-TG_PMRicLaE_WtILWNrez29-mPlyb0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1-I42YcUlTa3VyLZHnXo78BHS-fjVcxlUTOlThOZDCPA&oe=69F4AF20"}, {"file_name": "screenshot5.png", "id": "553874096635567", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974780_553874099968900_7378651240689708759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IRt2CuIhfNMQ7kNvwGDRGil&_nc_oc=Ado8PUgyecWAsjyuUNR1KZbxiu2yx_pndXpIXodSPHnAnBT75cH0w5hq_YTUl8o4VJU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af06SdYFZDHc6B7CxYIHlU2KKvRGWBBjeY6iKtI33crXrA&oe=69F4C704"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "md_cover_yoko.png", "id": "177397054888391", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001715_177397058221724_4824817095391091493_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3HMgQ8SwIWUQ7kNvwF16esT&_nc_oc=AdoExxIfmY8v_VyLfck9MndpbZIUMcraeYlLNbAFQouELb4zsu4DQBkU4Lvr5WQXJ5Q&_nc_zt=3&
1_796704421797493_4273927429227272418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K7_pZpqvjzkQ7kNvwFigVtL&_nc_oc=AdpE5JEnEAOjo3qXgDGXaW_raY-Ai4bMu5theu8UuYxTanh59VBkNwcx4EFIMU1SwPc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJan0SuM80mJfz6YI8aMJKHMF5xuCgG0hp_xDRDTffWw&oe=6AF5F61F"}, {"file_name": "screenshot3.png", "id": "243447578052170", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982528_243447581385503_1311164864357431428_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TGVZX5grTIQQ7kNvwEIsJKa&_nc_oc=AdrbI7rA6RMKaLJymkCpxP7dKrgt6YgXRhgpyur6c8VlTZlhMjnys5MJBnnNpsPbbhY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYUdJs4K9aecpNrOvi2mvYfzxLGew3jfMKBsXj_SHtFg&oe=6AF5E4F5"}, {"file_name": "screenshot4.png", "id": "756637562706222", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974759_756637566039555_7395506445783665316_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f_xqdVlDlQoQ7kNvwEw8Xca&_nc_oc=AdrUTQP3hZFhD_Z681t0L3yqJGvw-N-8JLMw5sU6RQ61gT9PgUxFg9aa668o-HtPIVE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVNf5moecxfMbkZWne6mBQ92Lm97qDk8u1-0AQEYtRUQ&oe=6AF5C3A0"}, {"file_name": "screenshot5.png", "id": "553874096635567", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974780_553874099968900_7378651240689708759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eimT3StTVGAQ7kNvwGZEU5W&_nc_oc=Adr1tYiYXJk-nuDbZtOdmBIZexdC2_cZQc4EDgLlW4VTJk0c5nFnIO7m2AVVnbcuyiY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9yEAgg9ESw4RQ4vef8i-RRw1T-h58_5mqjyv_2YFQCg&oe=6AF5DB84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "md_cover_yoko.png", "id": "177397054888391", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001715_177397058221724_4824817095391091493_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gM49jVK1lXwQ7kNvwEWGAN3&_nc_oc=AdoMPqIEhpow28PfMD2Q39sEGT-YlY-o6dHTtp9GbvOTtOkukospQDlTaPKVKDfJ0YM&_nc_zt=3&
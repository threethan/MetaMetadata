1_796704421797493_4273927429227272418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2QymUkO6nF4Q7kNvwEci-v0&_nc_oc=Adoh1sGNpcEDtmBE6xf19sk6nOpoISFoD_74eOvJP0kW4Boe-12wITGVxl_8AiOH_oU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDXNV3OHxG-y0whFO64sSqkfdcriwfuiCkZ6k6tJwkHFg&oe=6A50F25F"}, {"file_name": "screenshot3.png", "id": "243447578052170", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982528_243447581385503_1311164864357431428_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OApsk4vLjLcQ7kNvwHMq5ya&_nc_oc=AdrqI-h4wUpUunHuqX04cfX52V1ymxDXoqpLX18SZ32zuUS9kDdlaUqwaNecwwEE0WU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQASnBCCQTxNjMlBsiDyCFDxS9Ac4znWvSol3hRMyjLA-g&oe=6A511975"}, {"file_name": "screenshot4.png", "id": "756637562706222", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974759_756637566039555_7395506445783665316_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k4Ja5K2iQg8Q7kNvwF3RjzK&_nc_oc=Ados9JfdY0NLXjkBNj82E_JzOZjF1tDGSfMHRA-rg4wi4q6NKoC6wDNjGpt97WxpDqY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDeA57v98l9fwznALQjVSNtfAHqMeZsuNHBQFW1b7yt5Q&oe=6A50F820"}, {"file_name": "screenshot5.png", "id": "553874096635567", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974780_553874099968900_7378651240689708759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zNTUeEmbuTIQ7kNvwEu9_-e&_nc_oc=AdpfKPIDCFFLHsHQPLBm_QSuHqP5OQ0ASgrpgi8MCxMP-rmRO7ncOGSDePfBi67IU-8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCwcIExtS-dgvlfnpaDQahH3wubQCm9L1-ar3GYRgPXgw&oe=6A511004"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "md_cover_yoko.png", "id": "177397054888391", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001715_177397058221724_4824817095391091493_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L-iMEUVbEAsQ7kNvwGJlufK&_nc_oc=AdqT91hh0Ifc-sCpkuxzKHqbjgoI2rPAXqRDCf_hsk7iFasQ-IAeZZ9M0_pIzY99lKQ&_nc_zt=3&
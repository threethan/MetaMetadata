1_796704421797493_4273927429227272418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DyWsxgtyAFoQ7kNvwH_mIeZ&_nc_oc=Adr4BEKwSGhSLai2sfXDBBUtV-_JiVKvCge3F4A8I8KoQCLvMSCg0AKWIZxp1XPkfa4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz4z6JqfG49HaxX7kUK0d41TreqeJSsEUzhgxtECQAnOg&oe=69C927DF"}, {"file_name": "screenshot3.png", "id": "243447578052170", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982528_243447581385503_1311164864357431428_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1S3jBdj2Q5MQ7kNvwHXeYaa&_nc_oc=AdpW28H4OG371CdgldPzXuZWCb9hi7cSdJUEPd7UckPqkxPrj8qaTEg-zjuQYc-sUCk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxU45PlUQskYPmkQqz1tmAbJzL8j1hP_hflzpDc9Rm2vA&oe=69C916B5"}, {"file_name": "screenshot4.png", "id": "756637562706222", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974759_756637566039555_7395506445783665316_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tNz5Tn2g0SQQ7kNvwGgjCG0&_nc_oc=AdrRd8BSg4VkZy2DoJ-84Am2thPzNCrQ-vQV-qgoN2XqKoUyiBx7KG8TPxg63BWub-Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzR-K7r6wBjnx131YeWwN9paV--XwoqIaF21I_QJI6ceg&oe=69C92DA0"}, {"file_name": "screenshot5.png", "id": "553874096635567", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974780_553874099968900_7378651240689708759_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ll5X7YX4VfEQ7kNvwG7xHl0&_nc_oc=AdprpEQULnBb7-qR9vVaCPEEpY_QFy30t4XUQ9V3uS8t1vz6Abl_sQuV38-VCu7Pfvg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxkC6o_yYRtKoy2wR5HOHTeu58V4eqWJ18t9e_zghbiYQ&oe=69C90D44"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "md_cover_yoko.png", "id": "177397054888391", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001715_177397058221724_4824817095391091493_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e0jIzViUaocQ7kNvwH6bwdG&_nc_oc=AdrecyDUYru5dnSciD0IWJ6l4cgryKGi6PUjQK3Ameu9F22vz00onh_jrA7dyKGNBeE&_nc_zt=3&
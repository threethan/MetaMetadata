c_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TpEjiRjeeUcQ7kNvwFIQJKl&_nc_oc=AdqhBeBniHPsSQdbkgwOsSaTE-mIqwzcw008cd5KFhIrIHGZEl89RIILAgPeEvI1TEw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPhaYCIuy8nLMqj3Auv0k28rh0R1kQ5FLjZ-N0ZzUcILw&oe=6ACD0150"}, {"file_name": "0521(4).png", "id": "909782962076010", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499314634_909782965409343_1113452777870318115_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kFc8SOL6At0Q7kNvwFu_f2x&_nc_oc=AdqXw9JUDAUki9O1bZyzABZ_o8GKnNd9-2XCAvMoAV-8bwB6XsPTRETdleCF0MDtcG0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFAjYwzYkVSS1rjpO4_jup_h_lEHwITsWCaIT_wQUlGg&oe=6ACCFC7F"}, {"file_name": "0521(3).png", "id": "2034914453904696", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499303445_2034914457238029_9202514880796603472_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HOZKu6q2BxAQ7kNvwHKkR1U&_nc_oc=AdrNIIC_U8Ew1fIwgWlzR-k9n3NSzcVFdgl-jZ-QOcHNIb7df9gS25Bd_5xsoeCKDcY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO4JBzzjTo9IhBhhRfuvWKFuUUmTLgiFDCJY69hALJsnA&oe=6ACCE45A"}, {"file_name": "0521.png", "id": "1714671056375752", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499299891_1714671059709085_3058434561463556989_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eKpFCC097XAQ7kNvwGmz6jP&_nc_oc=AdoANFp4kLbZ3PIiykeKcfngzjyYP06LhrrI8jNBarRmLuLvLaqnOJMcNzC_AQ0Z7nQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO6DTSO-dl1smM8w-twr4GPk6pDNhIuuwA_NHjcBNFVWQ&oe=6ACD1531"}, {"file_name": "0521(2).png", "id": "1381466537145593", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499299891_1381466550478925_8640818736349089788_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X-TJy7C09qEQ7kNvwGYSZHU&_nc_oc=AdrdENCnd2JfhY-WUfMKK7mFcb8zXZ5aElDGhZfz8Vq0ww6qMs0G78xN1NOJroidQ9k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOnapliIm7h5P8lledBrxEYHVnI1wdQqmqqgj7OAnD7UQ&oe=6ACCFF35"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Space Diner", "keywords": ["VR", "Cooking", "Coop"], "long_description": "Welcome to Space Diner, a chaotic zero-gravity cooking experience where teamwork, panic, and flying burgers collide. Set aboard a futuristic diner drifting through space, players work together to prepare, grab, throw, and deliver food while floating through a fully interactive zero-G environment.\n\nUsing physics-based movement inspired by classic VR space games, players can push, pull, grapple, and launch themselves around the diner to keep orders moving before time runs out. Burgers, ingredients, and kitchen tools float through the air as the pressure builds and alarms begin to sound. One second everything is under control, the next, the entire kitchen is in chaos.\n\nThe game focuses on fast-paced cooperative gameplay, hilarious moments, and highly replayable kitchen scenarios. Every shift becomes its own story filled with close calls, accidental disasters, and last-second saves.\n\nStill in active development, Space Diner is constantly evolving with new mechanics, kitchen stations, challenges, customization options, and social features. Whether you're mastering movement in zero gravity or simply trying to stop burgers from floating into deep space, Space Diner delivers a unique multiplayer experience built around fun, teamwork, and controlled chaos.", "short_description": "Zero-G Cooking in space."}]}, "developer_name": "Flip Key Studios", "developer_privacy_policy_url": "https://www.flipkeystudios.com/spacedinerprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Flip Key Studios", "support_website_url": null, "website_url": "https://www.flipkeystudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_t
c_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lZvN2h6xyAoQ7kNvwGfDza0&_nc_oc=Adrwts5Z33dMqFeKagKzx_LFlo2gTmhzZ0W3ueHhKvYv-gYDui9W6CdV1jy_5CQzlKU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9cS0RBDHODBzAT_r7odhSrgvpQvjeHVVl_O7rZvACuQ&oe=6A3E9F50"}, {"file_name": "0521(4).png", "id": "909782962076010", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499314634_909782965409343_1113452777870318115_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W4OqHiaAdP4Q7kNvwHBVxMc&_nc_oc=Adpj8y8E_XjqQ2xIGjh1VgFN6bWPeCxEfgLG3epAn6I8hsaeyhMf8-OVIbvnYGjMYYY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8EugXeenRj6_9DBLBkwjV79XQ0Jal9AnEd7zc3E8AEhA&oe=6A3E9A7F"}, {"file_name": "0521(3).png", "id": "2034914453904696", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499303445_2034914457238029_9202514880796603472_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xwi1_vna-_EQ7kNvwEWotvL&_nc_oc=AdpaWHe082McJ-7PXP_Uj0z2BVrJrD3PrXfsMSAfkMyc1_v2S5FyPyYZ6mDcqf9HtbE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_tmXSfFBGa7_q5SB4uzXtcmWRiTL2uuO4B-tqh0aWcVw&oe=6A3E825A"}, {"file_name": "0521.png", "id": "1714671056375752", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499299891_1714671059709085_3058434561463556989_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lbmcQV7SFZYQ7kNvwGuj9D8&_nc_oc=AdqZmu0zzSo0IaBuwVz32hlmfpUgbaB50x_hkw6pxbwGURaG_Y1mPovSTCdoyuHG3jE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-eUDJS2vV9kmob3x-GsoABUaOxDE2fxZhjfEllX0fSIQ&oe=6A3E7AF1"}, {"file_name": "0521(2).png", "id": "1381466537145593", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499299891_1381466550478925_8640818736349089788_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FuY44G2iVxUQ7kNvwE0XvTa&_nc_oc=AdorV5oXRwFjQk1NgpjtVBLg-flDKc-XpPlaHuv1GjV7x7CFG3zRudw3zqWSmuSM8gw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8X0JI9NC3JMX3ov7Ymg2bkbcNLPdDKXfCRyPTfWfuBYg&oe=6A3E9D35"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Space Diner", "keywords": ["VR", "Cooking", "Coop"], "long_description": "Welcome to Space Diner, a chaotic zero-gravity cooking experience where teamwork, panic, and flying burgers collide. Set aboard a futuristic diner drifting through space, players work together to prepare, grab, throw, and deliver food while floating through a fully interactive zero-G environment.\n\nUsing physics-based movement inspired by classic VR space games, players can push, pull, grapple, and launch themselves around the diner to keep orders moving before time runs out. Burgers, ingredients, and kitchen tools float through the air as the pressure builds and alarms begin to sound. One second everything is under control, the next, the entire kitchen is in chaos.\n\nThe game focuses on fast-paced cooperative gameplay, hilarious moments, and highly replayable kitchen scenarios. Every shift becomes its own story filled with close calls, accidental disasters, and last-second saves.\n\nStill in active development, Space Diner is constantly evolving with new mechanics, kitchen stations, challenges, customization options, and social features. Whether you're mastering movement in zero gravity or simply trying to stop burgers from floating into deep space, Space Diner delivers a unique multiplayer experience built around fun, teamwork, and controlled chaos.", "short_description": "Zero-G Cooking in space."}]}, "developer_name": "Flip Key Studios", "developer_privacy_policy_url": "https://www.flipkeystudios.com/spacedinerprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Flip Key Studios", "support_website_url": null, "website_url": "https://www.flipkeystudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_t
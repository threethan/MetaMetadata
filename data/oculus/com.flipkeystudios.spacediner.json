", "locale": "en_US", "screenshots": [{"file_name": "0521(5).png", "id": "1621914495589954", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499300541_1621914502256620_6687999264622959616_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tJM1aW_H5s4Q7kNvwFwU9K0&_nc_oc=Adq4FNNJEAvKYq3RUiMj4woVeWk3_AYhtXC9NiJ6HNPbibsnLBqFKWiMffbpCAY2LHk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRb6YL7bjWS_jzOe1dSmfNED8Mx9EsRjjR66hMmTMn9cA&oe=6AFDC8D0"}, {"file_name": "0521(4).png", "id": "909782962076010", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499314634_909782965409343_1113452777870318115_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BJbESCSURHoQ7kNvwEkjacs&_nc_oc=AdpccfqlTqmMmtN4uGFBZ9CBz_C6Fy1tAgiszxMwE9arLINj8VaAcra6RgdHc5mmyiE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYSGardFubQbUQTgF5KU8ECZZD09p7TnnXrhhG6Wcekg&oe=6AFDC3FF"}, {"file_name": "0521(3).png", "id": "2034914453904696", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303445_2034914457238029_9202514880796603472_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ebjOBzPj6rAQ7kNvwGenBJ2&_nc_oc=AdonjspGb47W4YqVAup8PLFD3n8CQbOYNsKlymXtfEmLCqJAgXeTxFc9a9OhWbUwnK0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKDo8JUCDPP-ILgFD2oiEdkDTapS9xWNQE_VAuM8duFA&oe=6AFDE41A"}, {"file_name": "0521.png", "id": "1714671056375752", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499299891_1714671059709085_3058434561463556989_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UEt9Yaci02oQ7kNvwEyIf-5&_nc_oc=AdrTmYJ_YtEB4OKgT1JsyyzdlwlT-MU_BXSObBmm8SwvgSO2-TPCgbHLoy_ghfaF1TQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQX11WU6A004ry6KKP43JMbGQP62Q55gRJY2G5RtAMwDQ&oe=6AFDDCB1"}, {"file_name": "0521(2).png", "id": "1381466537145593", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499299891_1381466550478925_8640818736349089788_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m7oSdKq-GbEQ7kNvwFLt0C7&_nc_oc=Adoc0xNqzK__CNE18vN8o2u39hZNVptmTaUJT8ftIay_JziIf2ng3Ai_X7HbhenJu4k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWDN7SRPkSVAUUFcVRiIm6qB-wTacGMSTuqkuNiZp07Q&oe=6AFDC6B5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Space Diner", "keywords": ["VR", "Cooking", "Coop"], "long_description": "Welcome to Space Diner, a chaotic zero-gravity cooking experience where teamwork, panic, and flying burgers collide. Set aboard a futuristic diner drifting through space, players work together to prepare, grab, throw, and deliver food while floating through a fully interactive zero-G environment.\n\nUsing physics-based movement inspired by classic VR space games, players can push, pull, grapple, and launch themselves around the diner to keep orders moving before time runs out. Burgers, ingredients, and kitchen tools float through the air as the pressure builds and alarms begin to sound. One second everything is under control, the next, the entire kitchen is in chaos.\n\nThe game focuses on fast-paced cooperative gameplay, hilarious moments, and highly replayable kitchen scenarios. Every shift becomes its own story filled with close calls, accidental disasters, and last-second saves.\n\nStill in active development, Space Diner is constantly evolving with new mechanics, kitchen stations, challenges, customization options, and social features. Whether you're mastering movement in zero gravity or simply trying to stop burgers from floating into deep space, Space Diner delivers a unique multiplayer experience built around fun, teamwork, and controlled chaos.", "short_description": "Zero-G Cooking in space."}]}, "developer_name": "Flip Key Studios", "developer_privacy_policy_url": "https://www.flipkeystudios.com/spacedinerprivacypolicy", "developer_terms_of_service_url": null, "publish
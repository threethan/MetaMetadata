82962076010", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499314634_909782965409343_1113452777870318115_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1513oMd9O-UQ7kNvwGNxO8g&_nc_oc=Adq8nAQ54y4QHTf6aDLjhbGqvazzCnOOzkIzTKJBrSpD8nKZ4k1Cfcn-NgsBm0wx4ac&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTUnSnjVhRH68UdROIR2GnawNbiLw23jhfblolDvynmQ&oe=6ABA877F"}, {"file_name": "0521(3).png", "id": "2034914453904696", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499303445_2034914457238029_9202514880796603472_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JoVSVaoxMt0Q7kNvwHjLxh6&_nc_oc=AdoogFnNNTkLqev5TX3kTRDQXF2TUm0J8TYXYgCRi14zCZe10Kvt-hduMpt0aRAAqHM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK7uMnQCcQYMNankNibiR0_suv3MSdcxBghU4xtggJOjQ&oe=6ABA6F5A"}, {"file_name": "0521.png", "id": "1714671056375752", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499299891_1714671059709085_3058434561463556989_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xXSqEuW2HnIQ7kNvwF1FDo6&_nc_oc=AdqodtWuLt8WAPm2-eVMPQkLYsT17Z6_EERRRJkTEpmCPjWrWacEHNsIf-lXsonuZJE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLghIrO1SyVLQ2GDGaicCpxjwZa6Jtr2166W6uXggHbOg&oe=6ABA67F1"}, {"file_name": "0521(2).png", "id": "1381466537145593", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499299891_1381466550478925_8640818736349089788_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xFH05Vu9g5QQ7kNvwERcGXl&_nc_oc=AdqFyNcf1tAkCG54FSwtD-lNbfW6JHEcZ5xFJc1D83lRn61UiagSZip60A4Irrqy9ek&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvE5Z2YwddHJkSlKWrMKTHfjMJWVX0MYqet12b4-YNcw&oe=6ABA8A35"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Space Diner", "keywords": ["VR", "Cooking", "Coop"], "long_description": "Welcome to Space Diner, a chaotic zero-gravity cooking experience where teamwork, panic, and flying burgers collide. Set aboard a futuristic diner drifting through space, players work together to prepare, grab, throw, and deliver food while floating through a fully interactive zero-G environment.\n\nUsing physics-based movement inspired by classic VR space games, players can push, pull, grapple, and launch themselves around the diner to keep orders moving before time runs out. Burgers, ingredients, and kitchen tools float through the air as the pressure builds and alarms begin to sound. One second everything is under control, the next, the entire kitchen is in chaos.\n\nThe game focuses on fast-paced cooperative gameplay, hilarious moments, and highly replayable kitchen scenarios. Every shift becomes its own story filled with close calls, accidental disasters, and last-second saves.\n\nStill in active development, Space Diner is constantly evolving with new mechanics, kitchen stations, challenges, customization options, and social features. Whether you're mastering movement in zero gravity or simply trying to stop burgers from floating into deep space, Space Diner delivers a unique multiplayer experience built around fun, teamwork, and controlled chaos.", "short_description": "Zero-G Cooking in space."}]}, "developer_name": "Flip Key Studios", "developer_privacy_policy_url": "https://www.flipkeystudios.com/spacedinerprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Flip Key Studios", "support_website_url": null, "website_url": "https://www.flipkeystudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_p
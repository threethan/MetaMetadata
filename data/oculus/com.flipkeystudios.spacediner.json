c_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rNHYUOYK1FYQ7kNvwH57sy4&_nc_oc=Adqr_ao5Wyt4xAbHtVICJO08RlguGgknZl7_Fg9fLc1Ujy2Ux9S0Sanvi9XSN5yXUo4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCWj02Fcb0bgA82s1pgy0IHztQpa6WM-yZDbJR5hNIMiw&oe=6A6DDD10"}, {"file_name": "0521(4).png", "id": "909782962076010", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499314634_909782965409343_1113452777870318115_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jH4vKGSkDmoQ7kNvwHl5QEh&_nc_oc=Adq-2MVBxuwdZ5AAnmFPj_8CX4Y1vdxZKXjEZF5l-3UWrmzHzgDmp-b6no8tTKuN8LQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBEAMwkkJRVy7juT3PjjMHvbOvvmK86XWZ_qZrpGGtyCw&oe=6A6DD83F"}, {"file_name": "0521(3).png", "id": "2034914453904696", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499303445_2034914457238029_9202514880796603472_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Ab2hTCnEjMQ7kNvwHzbsFt&_nc_oc=Adpil0GuKSSqQ1sSx1k_fQqGO7peaqY5GPWTDHJKtXNA2WrgQ_dSRERr5uwpHwiBIiw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZNDa_LnyFPHngYWZZsOslytmMcdDWtgwNQOA50nAxpg&oe=6A6DF85A"}, {"file_name": "0521.png", "id": "1714671056375752", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499299891_1714671059709085_3058434561463556989_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A9pvgkcYlI4Q7kNvwH9A-cA&_nc_oc=AdpaYQ53km-lnRhUbJbvs4NBMH1AuWzQmg85jnmuVo_FFVRP18qn0rapOMpfivmOqp0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAqgvoCWtGmmkISyncxJDp58rzW99W03FeZs5aB4yWPUQ&oe=6A6DF0F1"}, {"file_name": "0521(2).png", "id": "1381466537145593", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499299891_1381466550478925_8640818736349089788_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PkumJJaP2eIQ7kNvwGBovo9&_nc_oc=Ado49IkhkW77q7TuWLnaVIz4fvuA4wpsvqEmwBuFWXNbZdy0j3vpEKk4yhwpk5XNzX4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAD9Y3We0mRfXOEcBLYrREg699x_LXAI5C3dj_XNlS9fA&oe=6A6DDAF5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Space Diner", "keywords": ["VR", "Cooking", "Coop"], "long_description": "Welcome to Space Diner, a chaotic zero-gravity cooking experience where teamwork, panic, and flying burgers collide. Set aboard a futuristic diner drifting through space, players work together to prepare, grab, throw, and deliver food while floating through a fully interactive zero-G environment.\n\nUsing physics-based movement inspired by classic VR space games, players can push, pull, grapple, and launch themselves around the diner to keep orders moving before time runs out. Burgers, ingredients, and kitchen tools float through the air as the pressure builds and alarms begin to sound. One second everything is under control, the next, the entire kitchen is in chaos.\n\nThe game focuses on fast-paced cooperative gameplay, hilarious moments, and highly replayable kitchen scenarios. Every shift becomes its own story filled with close calls, accidental disasters, and last-second saves.\n\nStill in active development, Space Diner is constantly evolving with new mechanics, kitchen stations, challenges, customization options, and social features. Whether you're mastering movement in zero gravity or simply trying to stop burgers from floating into deep space, Space Diner delivers a unique multiplayer experience built around fun, teamwork, and controlled chaos.", "short_description": "Zero-G Cooking in space."}]}, "developer_name": "Flip Key Studios", "developer_privacy_policy_url": "https://www.flipkeystudios.com/spacedinerprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Flip Key Studios", "support_website_url": null, "website_url": "https://www.flipkeystudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_t
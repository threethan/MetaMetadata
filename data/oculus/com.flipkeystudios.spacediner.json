", "locale": "en_US", "screenshots": [{"file_name": "0521(5).png", "id": "1621914495589954", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499300541_1621914502256620_6687999264622959616_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nHgr4SMBA-kQ7kNvwEJuuNL&_nc_oc=AdrwCWMimFtLBMG5Rjxn6r745rP3NWzI23yD2Fe_-GVbQsxKDGqj1nPyAddrmQDgzY0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcISnkggpbyZyctx1TaohCOX-rgezZfiUZFopIYnA4SQ&oe=6B070350"}, {"file_name": "0521(4).png", "id": "909782962076010", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499314634_909782965409343_1113452777870318115_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=87ycjXWjy-oQ7kNvwFFUZ6P&_nc_oc=Adp0AChV9J2dmQL5npueTKP2u00IGrg5nADfJ10MGs94FU3nEoyr1TVmbMekg3sa1Jg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbPnvQ9G3coZ9FjC5EAXPqFBQhgzvagcFiAbhynk-BHA&oe=6B06FE7F"}, {"file_name": "0521(3).png", "id": "2034914453904696", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499303445_2034914457238029_9202514880796603472_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-48KRCY_2iUQ7kNvwG9yx3o&_nc_oc=Ado2QWzAtgK9vhL3fWaVgAqnvl24n8Na4hioTDoSo86-5NZ73A1-cDPxTaLoAJp544A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqUCql0M_mUOksqUiF9B689ExoDL1pWAaVIWQ02iSbNw&oe=6B071E9A"}, {"file_name": "0521.png", "id": "1714671056375752", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499299891_1714671059709085_3058434561463556989_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H6G1zJ4LKaUQ7kNvwGE68e8&_nc_oc=AdrOUpBgZaGPebBqY19ZuteyhcQTCRcltqM4n6rECNsMohOdsSeC11u-b0LecVoTcHE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTu0AudAtoEfm13MpQmbYnbX5Iryghid9JouOYzKvfPZQ&oe=6B071731"}, {"file_name": "0521(2).png", "id": "1381466537145593", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499299891_1381466550478925_8640818736349089788_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6iLh2TSlS-oQ7kNvwGIIwaC&_nc_oc=Adqq5FAkxlde9M-KOs-z1cBNPDe61fRX_1It2KDEVSTaEMgjJzgnpt9tjfNhXb0gEyw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQO81cLyDrUCmFEDWKam17rmlWwKMjQWSjQEbzKPYjDRQ&oe=6B070135"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Space Diner", "keywords": ["VR", "Cooking", "Coop"], "long_description": "Welcome to Space Diner, a chaotic zero-gravity cooking experience where teamwork, panic, and flying burgers collide. Set aboard a futuristic diner drifting through space, players work together to prepare, grab, throw, and deliver food while floating through a fully interactive zero-G environment.\n\nUsing physics-based movement inspired by classic VR space games, players can push, pull, grapple, and launch themselves around the diner to keep orders moving before time runs out. Burgers, ingredients, and kitchen tools float through the air as the pressure builds and alarms begin to sound. One second everything is under control, the next, the entire kitchen is in chaos.\n\nThe game focuses on fast-paced cooperative gameplay, hilarious moments, and highly replayable kitchen scenarios. Every shift becomes its own story filled with close calls, accidental disasters, and last-second saves.\n\nStill in active development, Space Diner is constantly evolving with new mechanics, kitchen stations, challenges, customization options, and social features. Whether you're mastering movement in zero gravity or simply trying to stop burgers from floating into deep space, Space Diner delivers a unique multiplayer experience built around fun, teamwork, and controlled chaos.", "short_description": "Zero-G Cooking in space."}]}, "developer_name": "Flip Key Studios", "developer_privacy_policy_url": "https://www.flipkeystudios.com/spacedinerprivacypolicy", "developer_terms_of_service_url": null, "publish
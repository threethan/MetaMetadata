", "locale": "en_US", "screenshots": [{"file_name": "0521(5).png", "id": "1621914495589954", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499300541_1621914502256620_6687999264622959616_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ETURG100Cp8Q7kNvwHUKqwz&_nc_oc=AdoQQS-IKtSBozvFlb0RUfJcFpwEI046sdyEoJWhZA6Tn-uNroKUv5LX5TNHaRN-0K8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQP210MG__l4bF5rldwH1JOpMHArEsXo_bf_c4xEJourQ&oe=6AFC7750"}, {"file_name": "0521(4).png", "id": "909782962076010", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499314634_909782965409343_1113452777870318115_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BJbESCSURHoQ7kNvwHjl7uz&_nc_oc=AdqKZrTBZGbhOKwrpAbTs6g0bKjlf8JacTVZ2ySI2GE_CezqEqq5jeknIfVeSBJxGf0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRAkSbVj_PNTALdqw2ee838wRm4V8UIbB-fj0X3doA9Q&oe=6AFC727F"}, {"file_name": "0521(3).png", "id": "2034914453904696", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499303445_2034914457238029_9202514880796603472_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ebjOBzPj6rAQ7kNvwHIU4wH&_nc_oc=AdpE0erIpyPo6gAJ6rVxBK0r5cIPp1SQ7y9ZsJRfUmmqM5uI9PNGcP1Xwy0wXtMFSzg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwB06Yif3q1SNJb4WkusWJ5MupLLvtt8s_r_qMDBv1gQ&oe=6AFC929A"}, {"file_name": "0521.png", "id": "1714671056375752", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499299891_1714671059709085_3058434561463556989_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UEt9Yaci02oQ7kNvwHEfAja&_nc_oc=AdpRFxx0c6LWJkG5xPRr4LlRRsms5nTwlMd4Rs5WvpsDfIz2lScRHh3c0IG2ScApELk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdZnQbkRquu493MI1gP88ozc1ehrhpVhCsW9Tb26jRVw&oe=6AFC8B31"}, {"file_name": "0521(2).png", "id": "1381466537145593", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499299891_1381466550478925_8640818736349089788_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m7oSdKq-GbEQ7kNvwFvIzW2&_nc_oc=AdpE8eL7NFpXolatv3-9KwB1w-y9IExoiFB7MQi1jSTiuF6fZP3DmxUQi983LPJcUlg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7j59JMrczCMysbYVdR25MnbYHghcqqq1FWrrz6mS18g&oe=6AFC7535"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Space Diner", "keywords": ["VR", "Cooking", "Coop"], "long_description": "Welcome to Space Diner, a chaotic zero-gravity cooking experience where teamwork, panic, and flying burgers collide. Set aboard a futuristic diner drifting through space, players work together to prepare, grab, throw, and deliver food while floating through a fully interactive zero-G environment.\n\nUsing physics-based movement inspired by classic VR space games, players can push, pull, grapple, and launch themselves around the diner to keep orders moving before time runs out. Burgers, ingredients, and kitchen tools float through the air as the pressure builds and alarms begin to sound. One second everything is under control, the next, the entire kitchen is in chaos.\n\nThe game focuses on fast-paced cooperative gameplay, hilarious moments, and highly replayable kitchen scenarios. Every shift becomes its own story filled with close calls, accidental disasters, and last-second saves.\n\nStill in active development, Space Diner is constantly evolving with new mechanics, kitchen stations, challenges, customization options, and social features. Whether you're mastering movement in zero gravity or simply trying to stop burgers from floating into deep space, Space Diner delivers a unique multiplayer experience built around fun, teamwork, and controlled chaos.", "short_description": "Zero-G Cooking in space."}]}, "developer_name": "Flip Key Studios", "developer_privacy_policy_url": "https://www.flipkeystudios.com/spacedinerprivacypolicy", "developer_terms_of_service_url": null, "publish
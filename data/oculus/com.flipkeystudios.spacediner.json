c_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ysUlb2EF-QQ7kNvwGP6rSp&_nc_oc=AdoJyL9EmALbI3Du7TLrLKQAGDV8tcJy--L6pSbU1d4aMaVpRSMOW8lOAmBpwpjPMx4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCfGf4dko-JBpgLHoRS9eMImHPOb7A6l1YMlW_qusLyVA&oe=6A4E3910"}, {"file_name": "0521(4).png", "id": "909782962076010", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499314634_909782965409343_1113452777870318115_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-clsDMTIlhkQ7kNvwHw2rlI&_nc_oc=Adq6rxTYJly3FOmzzFdKxiWm969XqsUYDGWrqQn5tMgny0c5UUq_cJEp4mNrWM4Hen0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC4l2msasuOmIOQI5Pehcro1D0PbqCYrAG6iNkEk2P4lg&oe=6A4E6C7F"}, {"file_name": "0521(3).png", "id": "2034914453904696", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499303445_2034914457238029_9202514880796603472_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nnc6XziHfooQ7kNvwExq_rm&_nc_oc=AdolQXU1lsO3K9A98d0j6xFq9Cu4NWVUUThXI4d4IAqRi3ma8vL6cztSdC5SBUZirk4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQANJP-xfa6OQNmHynJWDR05dVwNPG3tmLQQzZb1_RyFcg&oe=6A4E545A"}, {"file_name": "0521.png", "id": "1714671056375752", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499299891_1714671059709085_3058434561463556989_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yZoBaGIqHIgQ7kNvwHuVYzr&_nc_oc=Adq5azjnXKGd5RVBGnNakjz2CX4cUmu4GgbUezd7GrZs3Zk3cYym_rLEH-h8Ec0wXiw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDWdAcPDQAqIs6Gj-o_D6mu55MehzMEf3sE4gycRD-hZQ&oe=6A4E4CF1"}, {"file_name": "0521(2).png", "id": "1381466537145593", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499299891_1381466550478925_8640818736349089788_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mp20VM2PaioQ7kNvwFvqdhH&_nc_oc=AdpasKcaaW7RVmoMHAC1uatRPNU4uMLv9aZq3couXFgh5ZDNgsI5O7VIleiNrev-2ds&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBVcUQBtvKH50HYxSYASse9in9iOjAisAPNV7uVBaffQw&oe=6A4E6F35"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Space Diner", "keywords": ["VR", "Cooking", "Coop"], "long_description": "Welcome to Space Diner, a chaotic zero-gravity cooking experience where teamwork, panic, and flying burgers collide. Set aboard a futuristic diner drifting through space, players work together to prepare, grab, throw, and deliver food while floating through a fully interactive zero-G environment.\n\nUsing physics-based movement inspired by classic VR space games, players can push, pull, grapple, and launch themselves around the diner to keep orders moving before time runs out. Burgers, ingredients, and kitchen tools float through the air as the pressure builds and alarms begin to sound. One second everything is under control, the next, the entire kitchen is in chaos.\n\nThe game focuses on fast-paced cooperative gameplay, hilarious moments, and highly replayable kitchen scenarios. Every shift becomes its own story filled with close calls, accidental disasters, and last-second saves.\n\nStill in active development, Space Diner is constantly evolving with new mechanics, kitchen stations, challenges, customization options, and social features. Whether you're mastering movement in zero gravity or simply trying to stop burgers from floating into deep space, Space Diner delivers a unique multiplayer experience built around fun, teamwork, and controlled chaos.", "short_description": "Zero-G Cooking in space."}]}, "developer_name": "Flip Key Studios", "developer_privacy_policy_url": "https://www.flipkeystudios.com/spacedinerprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Flip Key Studios", "support_website_url": null, "website_url": "https://www.flipkeystudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_t
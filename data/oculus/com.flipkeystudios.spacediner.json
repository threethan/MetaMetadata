", "locale": "en_US", "screenshots": [{"file_name": "0521(5).png", "id": "1621914495589954", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499300541_1621914502256620_6687999264622959616_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nUXWclcoyYUQ7kNvwG_otT8&_nc_oc=Adog-O_ulvjj-fc2gfrFlIaEP9vymm-KjvlYUdFXY9Q7hgTwH0dDJJjydAC8xPLOo3Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUxNNTxW_w0pDQQ5DV7N22yQdinGo6SKXOw5Oqb-ZPOUg&oe=6B103DD0"}, {"file_name": "0521(4).png", "id": "909782962076010", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499314634_909782965409343_1113452777870318115_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b9dha4gHZO4Q7kNvwHRbkkw&_nc_oc=Adoz0WuSqZyyApe6eTxveBTYCiO_G_cySYjgWjftGw0AUhcft8RXQo7hMcGj5bV10Js&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXEljJh2a_deoVFJ0yeNF1bzl9xs4Ze3rmq8KCj65Y-tQ&oe=6B1038FF"}, {"file_name": "0521(3).png", "id": "2034914453904696", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499303445_2034914457238029_9202514880796603472_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9PLjqCKJy0QQ7kNvwF5X3Qf&_nc_oc=AdozEni_bHCmhc2XNzMvpR3W0iWGBPMh4EojpgXJrbGtXmSXuzmqHDFwGz_P27PMGyw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUSAsQ64RRBHPSMbOS3ZP0kttaJw4R1HYytpeon87ADsQ&oe=6B10591A"}, {"file_name": "0521.png", "id": "1714671056375752", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499299891_1714671059709085_3058434561463556989_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=orvOIXa-85gQ7kNvwGu3VfB&_nc_oc=AdqAgcuKWDPJEgT4KgTqB1b9cyakh7UnYFJo-NZw9Sdo6f2g6mBjWXqkm2qVy5buifA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU0HTgeNfZYZ03helmgra-JabQfLcWLgciaX0KES93uKw&oe=6B1051B1"}, {"file_name": "0521(2).png", "id": "1381466537145593", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499299891_1381466550478925_8640818736349089788_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bLKktaRhpugQ7kNvwHmR4N_&_nc_oc=Adomyz-M6zxZfhHLgDH1q56JLphC4VTlFilQgzrJFhWRYLGwP4ga-n31u_hr6m776GI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXcqJCRZ30jU_WP5hFPfIqVWgMEW1XbKhlsadXoFQlDKQ&oe=6B103BB5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Space Diner", "keywords": ["VR", "Cooking", "Coop"], "long_description": "Welcome to Space Diner, a chaotic zero-gravity cooking experience where teamwork, panic, and flying burgers collide. Set aboard a futuristic diner drifting through space, players work together to prepare, grab, throw, and deliver food while floating through a fully interactive zero-G environment.\n\nUsing physics-based movement inspired by classic VR space games, players can push, pull, grapple, and launch themselves around the diner to keep orders moving before time runs out. Burgers, ingredients, and kitchen tools float through the air as the pressure builds and alarms begin to sound. One second everything is under control, the next, the entire kitchen is in chaos.\n\nThe game focuses on fast-paced cooperative gameplay, hilarious moments, and highly replayable kitchen scenarios. Every shift becomes its own story filled with close calls, accidental disasters, and last-second saves.\n\nStill in active development, Space Diner is constantly evolving with new mechanics, kitchen stations, challenges, customization options, and social features. Whether you're mastering movement in zero gravity or simply trying to stop burgers from floating into deep space, Space Diner delivers a unique multiplayer experience built around fun, teamwork, and controlled chaos.", "short_description": "Zero-G Cooking in space."}]}, "developer_name": "Flip Key Studios", "developer_privacy_policy_url": "https://www.flipkeystudios.com/spacedinerprivacypolicy", "developer_terms_of_service_url": null, "publish
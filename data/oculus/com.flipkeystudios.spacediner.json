.png", "id": "909782962076010", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499314634_909782965409343_1113452777870318115_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h_quxzOz-KQQ7kNvwF8YHPm&_nc_oc=AdqEqJBq9dw4PSQ7t4TQLWI0v5TKzAdVFZgnas7dPdzbyNy2JSxCFGUFmGUayr9FTME&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEEU8upelwd6QA09oX-Ezwgi7bnqZ_fxRWBc0sD1A7rYQ&oe=6A8ECDBF"}, {"file_name": "0521(3).png", "id": "2034914453904696", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499303445_2034914457238029_9202514880796603472_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zsnt1PqatOAQ7kNvwGT_aHT&_nc_oc=AdpHtKNPcukNq5AxFlBb_66j3xc4hepoYf2-DsbpSBCR1wesMNLiCAjKLRK6oj2TtSg&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgKhhVzdIo9yd4H_B5gC8S94pW3WBlSev_MFiQJ_tH9A&oe=6A8EEDDA"}, {"file_name": "0521.png", "id": "1714671056375752", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499299891_1714671059709085_3058434561463556989_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iucCm53mCqEQ7kNvwEQbiT7&_nc_oc=AdqKSRjDwFSdEb8trB7pckAKomAFtFGcNSShtBeiIFLBUf0LM8_z3zmoISzfAIh6fNQ&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEypkxXLsCd3pKZ2C-tUaku3sLC_vyUHvxbTMM5DjwF0w&oe=6A8EE671"}, {"file_name": "0521(2).png", "id": "1381466537145593", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499299891_1381466550478925_8640818736349089788_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N0SHKO8q0XsQ7kNvwH99rhh&_nc_oc=AdoXF8YE5KD7KhrH38OaHbW0lB8a5TFiwB_lOelo0-2pYIMr2fxr4Octhiw2Ymk_Fy8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQER_7NXzYb6RQdCra4W0wiS3P_HmMY3iFKmwTdcpgSPZw&oe=6A8ED075"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Space Diner", "keywords": ["VR", "Cooking", "Coop"], "long_description": "Welcome to Space Diner, a chaotic zero-gravity cooking experience where teamwork, panic, and flying burgers collide. Set aboard a futuristic diner drifting through space, players work together to prepare, grab, throw, and deliver food while floating through a fully interactive zero-G environment.\n\nUsing physics-based movement inspired by classic VR space games, players can push, pull, grapple, and launch themselves around the diner to keep orders moving before time runs out. Burgers, ingredients, and kitchen tools float through the air as the pressure builds and alarms begin to sound. One second everything is under control, the next, the entire kitchen is in chaos.\n\nThe game focuses on fast-paced cooperative gameplay, hilarious moments, and highly replayable kitchen scenarios. Every shift becomes its own story filled with close calls, accidental disasters, and last-second saves.\n\nStill in active development, Space Diner is constantly evolving with new mechanics, kitchen stations, challenges, customization options, and social features. Whether you're mastering movement in zero gravity or simply trying to stop burgers from floating into deep space, Space Diner delivers a unique multiplayer experience built around fun, teamwork, and controlled chaos.", "short_description": "Zero-G Cooking in space."}]}, "developer_name": "Flip Key Studios", "developer_privacy_policy_url": "https://www.flipkeystudios.com/spacedinerprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Flip Key Studios", "support_website_url": null, "website_url": "https://www.flipkeystudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_T
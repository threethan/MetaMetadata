uluscdn.com/v/t64.5771-25/38982595_489894429876580_3862626020524226670_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FDpNWYsqYwkQ7kNvwGj401_&_nc_oc=AdmyiovNIyyqClf-LKCdE2WN9bhRa_O6I9rWHEzqFKHjhw6I8ND_nvYzp04aK-RBCyA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxenYy-ajX-UCBAznqFuM2ht8m-roj_wC88HmCdkVCe5Q&oe=69BFD816"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Quest_Ovation_TrailerCover.png", "id": "904760177537386", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974859_904760180870719_5999571003121744674_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8PbBmbxZOTAQ7kNvwHSkmYU&_nc_oc=AdnDDEJyTJLBQWl3Xduobq5kOymuHgooBH-0UCb85pmr5IksglkRYXO7jM399Coqoz0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwaGgKsjNe0hpOIbbm04RhUEDkYY5snRtw6_jsDXWZJpQ&oe=69BFFD1C"}, "display_name": "Ovation", "keywords": [], "long_description": "Do you need help overcoming public speaking anxiety?\nDo you want to communicate more effectively?\n\nOvation was developed to help you build your skills and confidence by providing real-time training tools and feedback as you speak to a realistic, simulated audience.\n\nImport your own text and slides, choose from dozens of speech tools, and adjust your audience's attire and behavior.\n\nOvation provides hundreds of prompts, with categories including interview and leadership, or you can add your own.\n\nChoose from 4 environments and speak to dozens of virtual audience members \u2014 real people scanned into 3D models who smile, clap, and get distracted by their phones.\n\nOvation records your speeches in 3D, enabling you to watch your performance from every angle and identify areas for improvement.\n\nEffective training tools guide your improvement and ensure you are always on the right track.\n\nOvation captures key analytics throughout your speech and produces grades for your review. You\u2019re able to identify areas for improvement and focus on them in subsequent practice sessions.\n\nJoin with others in a multiplayer session. Deliver speeches together with a co-worker, get advice from a friend, or just bring others into the venue to watch.\n\nAre you ready for your Ovation?", "short_description": "Do you need help overcoming public speaking anxiety?\nDo you want to communicate more effectively?\n\nOvation was developed to help you build your skills and confidence by providing real-time training tools and feedback as you speak to a realistic, simulated audience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ovationvr.com/legal", "developer_terms_of_service_url": "https://www.ovationvr.com/legal", "publisher_name": "VRSpeaking", "support_website_url": "https://www.ovationvr.com/contact", "website_url": "https://www.ovationvr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["EDUCATIONAL", "PRODUCTIVITY", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "823674202060923"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "956389632865701"}, {"status": "PUBLISHED", "id": "883658706050123"}, {"status": "PUBLISHED", "id": "2730119673796658"}]}, "baseline_offer": {"id": "956389632865701"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1740080880, "status": "PUBLISHED", "id": "956389632865701"}]}, "liveChannel": {"nodes": [{"latest_supported
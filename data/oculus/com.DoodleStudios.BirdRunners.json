name": "bdrun.png", "id": "1347788293098845", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391924_1347788296432178_613540574265254062_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=74zXR26SGioQ7kNvwEyyltD&_nc_oc=AdoQ_6s75E3hQ_LJoB1eCKYVtc_BS0LMOHswvoaFwOxsjCgqyK5Gr4nMmJvHoow9RNg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOrccGx1znVrv8Qdwqe0bjv5PHU0GHCxUiTBrBKRDrnlQ&oe=6AD2593C"}, {"file_name": "bdrun.png", "id": "1790144721764261", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391911_1790144725097594_82329047595191227_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-vWqLelk3HMQ7kNvwECMakK&_nc_oc=AdqJTPYQpT-oWrZEwsXLb2PUnp_8GD5Mvs9z3sV2UqKZI2Hz8EdNdeMrMS0JxVUH6pQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPpWLg7BVcZP9YkcQMJh4zg53SdRODjOL7uZGgYvuCnWA&oe=6AD258A6"}, {"file_name": "bdrun.png", "id": "1359512751751308", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393841_1359512755084641_2061987581396801429_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YBVzdDxaYvkQ7kNvwE7j3IS&_nc_oc=Adolalp5XPct1t5Y86M4VLCfUmDehe2Kg-v1fDTm20xKZRhenokZuHKYKds75L1QS6M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN8DMhnWD3nAb01EYNxKmNue_VlU44MEaT6dvr2L2HkwQ&oe=6AD243CE"}, {"file_name": "bdrun.png", "id": "685489780808187", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393450_685489784141520_8206373762344470015_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-HDQYj6G_iQQ7kNvwHrrXal&_nc_oc=AdrsQuliMe2r4Y2zc1cU1_0cJSEE_1P8KYSF3dJJB_oFtVqWbKRLKQUnUG2-3cFKHQw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMdYN9_Rbtw-Qwi2khkHooVcM6jy__c5QVtCjbp5rvPgQ&oe=6AD2390D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bird Runners VR", "keywords": ["Bird", "Runners", "Gorilla", "Horror", "Mods"], "long_description": "Bird Runners VR is a multiplayer virtual reality game that lets players experience life as a bird, using innovative arm-based locomotion to run, jump, climb, and glide through dynamic environments. Inspired by games like Gorilla Tag, it focuses on physics-based movement, allowing players to master traversal skills and compete in various game modes. Whether exploring open worlds, engaging in high-speed chases, or socializing in lobbies, players can customize their bird characters with unique cosmetics. The game encourages fast-paced, skill-based gameplay while fostering a fun and interactive community. With frequent updates, new maps, and game modes, Bird Runners VR offers an ever-evolving experience for players looking to test their agility and reflexes. Designed for VR platforms, it supports online multiplayer, allowing friends to team up or compete in exhilarating challenges.", "short_description": "Bird Runners VR is a multiplayer VR game where players take on the role of birds, using arm movements to run, jump, and glide through various environments. Similar to *Gorilla Tag*, it features fast-paced, physics-based locomotion, social interactions, and competitive mini-games."}]}, "developer_name": "Nebula Forge Studios", "developer_privacy_policy_url": "https://docs.google.com/document/d/1mxaajlw2I3QkUonpxhIMQVqkmtWh8PYNbCZRUiyY67M/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Nebula Forge Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/birdrunners", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes":
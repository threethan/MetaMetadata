GPF3dfupsFW33ss4FzOQRAYjpw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuQ1bT223k3c14yawMtw5yF9ZpmOMBPspjYNwtTed06Mw&oe=699EF37C"}, {"file_name": "bdrun.png", "id": "1790144721764261", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391911_1790144725097594_82329047595191227_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k1bVTHFnkFYQ7kNvwHbHEUd&_nc_oc=AdmSfPH61_NiLceFsLLUPezb9SHnPi5f3CEDA1aLDkHYKON2vsFWCO1QnCEEyd7WHgA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afvtc00UhhsHW3ThA77TP2aCUaDxRjlltbCdhqXq88fG5w&oe=699EF2E6"}, {"file_name": "bdrun.png", "id": "1359512751751308", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393841_1359512755084641_2061987581396801429_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jIoalZ6IhbMQ7kNvwHHMU1d&_nc_oc=Adn2j11FYtndTYueu09E8LFyJy49DixFv4I3w9M4Pau45BJoZddrQPBrGORVIGUJV68&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftCxFPATGWzqXw8jiliLJICaBN--kxLYhVIXXx4HiT9vw&oe=699EDE0E"}, {"file_name": "bdrun.png", "id": "685489780808187", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393450_685489784141520_8206373762344470015_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uk-fzVDsYMAQ7kNvwGwc8Ps&_nc_oc=AdnzyEeXqWx4Ts3qTlbz4u6tIV1dvHzPpOVYox3McuShUTMapk0N9YQp7wzdcwjZjkU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvE-bqZaseLE0XeckPJrqPyFNVhR36PbY1DbZiwvV52Zg&oe=699ED34D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bird Runners VR", "keywords": ["Bird", "Runners", "Gorilla", "Horror", "Mods"], "long_description": "Bird Runners VR is a multiplayer virtual reality game that lets players experience life as a bird, using innovative arm-based locomotion to run, jump, climb, and glide through dynamic environments. Inspired by games like Gorilla Tag, it focuses on physics-based movement, allowing players to master traversal skills and compete in various game modes. Whether exploring open worlds, engaging in high-speed chases, or socializing in lobbies, players can customize their bird characters with unique cosmetics. The game encourages fast-paced, skill-based gameplay while fostering a fun and interactive community. With frequent updates, new maps, and game modes, Bird Runners VR offers an ever-evolving experience for players looking to test their agility and reflexes. Designed for VR platforms, it supports online multiplayer, allowing friends to team up or compete in exhilarating challenges.", "short_description": "Bird Runners VR is a multiplayer VR game where players take on the role of birds, using arm movements to run, jump, and glide through various environments. Similar to *Gorilla Tag*, it features fast-paced, physics-based locomotion, social interactions, and competitive mini-games."}]}, "developer_name": "Nebula Forge Studios", "developer_privacy_policy_url": "https://docs.google.com/document/d/1mxaajlw2I3QkUonpxhIMQVqkmtWh8PYNbCZRUiyY67M/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Nebula Forge Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/birdrunners", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9842887049075294"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "A
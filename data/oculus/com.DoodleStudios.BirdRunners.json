96BB9"}, {"file_name": "bdrun.png", "id": "1347788293098845", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/473391924_1347788296432178_613540574265254062_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jsj9HoQfpvoQ7kNvwHNoXDr&_nc_oc=AdoSeiY5iLxf3XzfnhssM0ZRwh13Lo4lRBDUDR5V--1VPgprKXW6ntu9yIyhu1ILR2s&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLG2wfMFMCF_4cahZMXm5EYsr0pl9NotEmZrxZEjk7fig&oe=6AA9427C"}, {"file_name": "bdrun.png", "id": "1790144721764261", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473391911_1790144725097594_82329047595191227_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zT2vKG5CKyMQ7kNvwHkUC98&_nc_oc=AdqTbeQh0N7WFXsHrPu8GeZ4tuevnXSQpzjFMhi5jMGDQijENLc8cC53Kime54lzrV4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfVjyoXN7yiq5C7sBpZ_4N6tiEV7PjWNK7avBlFZODQQ&oe=6AA941E6"}, {"file_name": "bdrun.png", "id": "1359512751751308", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473393841_1359512755084641_2061987581396801429_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CJomn_WBj-oQ7kNvwFp-Dkl&_nc_oc=AdrVG5FS5ACwMFeC2r3pWWJhlSpuVYJUGZ846utGlO0ZKPf4pxa4gN_3oHprYZ072jw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtxaGUglRO5AmAOOcZSm6jLnxzuCsEi80Bhkm7GexckQ&oe=6AA9654E"}, {"file_name": "bdrun.png", "id": "685489780808187", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473393450_685489784141520_8206373762344470015_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=323QbkSDVgIQ7kNvwGe_HLG&_nc_oc=AdrMy4-4ZfslsjOx5599CmPmSwFwFD5dWsDQ7-12R6aNqVDnBqKxG38yn6-_sXe5Ghk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-ewmURjrzUKyrXsRAFQVYqadnTU_ueBC713zULmJgQA&oe=6AA95A8D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bird Runners VR", "keywords": ["Bird", "Runners", "Gorilla", "Horror", "Mods"], "long_description": "Bird Runners VR is a multiplayer virtual reality game that lets players experience life as a bird, using innovative arm-based locomotion to run, jump, climb, and glide through dynamic environments. Inspired by games like Gorilla Tag, it focuses on physics-based movement, allowing players to master traversal skills and compete in various game modes. Whether exploring open worlds, engaging in high-speed chases, or socializing in lobbies, players can customize their bird characters with unique cosmetics. The game encourages fast-paced, skill-based gameplay while fostering a fun and interactive community. With frequent updates, new maps, and game modes, Bird Runners VR offers an ever-evolving experience for players looking to test their agility and reflexes. Designed for VR platforms, it supports online multiplayer, allowing friends to team up or compete in exhilarating challenges.", "short_description": "Bird Runners VR is a multiplayer VR game where players take on the role of birds, using arm movements to run, jump, and glide through various environments. Similar to *Gorilla Tag*, it features fast-paced, physics-based locomotion, social interactions, and competitive mini-games."}]}, "developer_name": "Nebula Forge Studios", "developer_privacy_policy_url": "https://docs.google.com/document/d/1mxaajlw2I3QkUonpxhIMQVqkmtWh8PYNbCZRUiyY67M/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Nebula Forge Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/birdrunners", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supp
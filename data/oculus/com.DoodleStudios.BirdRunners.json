name": "bdrun.png", "id": "1347788293098845", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391924_1347788296432178_613540574265254062_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rvMLrVfDrpgQ7kNvwF7yiHr&_nc_oc=AdoR9wgTawDV7VFUUlF1AqyMXzdKsY963sju83hlO2r3FtLDt2FyhW3ZD-3AbrFBw0Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5gywuxpDyZDjU0IjdIP11pv5W1vE77h9qz0DDrQk3ifQ&oe=69FF30FC"}, {"file_name": "bdrun.png", "id": "1790144721764261", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391911_1790144725097594_82329047595191227_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y6R6-Wx_xosQ7kNvwGAKbsD&_nc_oc=AdqIwwrzqEzuoHS5Vp1BY2TROBczxoDmZlpGPe4TyZHapM9gbukW2J2k183_X3dmOgw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7FWSasKULcNEFU30OoS0h2N-X9P0QdmL80X6ykjj9OGw&oe=69FF3066"}, {"file_name": "bdrun.png", "id": "1359512751751308", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393841_1359512755084641_2061987581396801429_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kvhisxriy6oQ7kNvwED1yvH&_nc_oc=Adpblni1r7kHn_ITccq00Ck4rSs1Bq5z2ULkyxIiTwFlz8EwXHMlUfRbb8lvWvGS0ak&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4o4ktrCOgE1-6rN99fjwEoBuJ9lHzGpQw8e9-dkk4srw&oe=69FF53CE"}, {"file_name": "bdrun.png", "id": "685489780808187", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393450_685489784141520_8206373762344470015_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CcD5nW0J2uMQ7kNvwGZBzJ8&_nc_oc=Adp-z8kALQ59-tu--nR9DW8eBya3Zm0sBVi7-PoXLFw29sBMzMavZ5R47mXgND5LXiU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7bUqkFjUhJ3WWHDwKm6Kif1B0_X-p9m6z4-h061cb3Tw&oe=69FF490D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bird Runners VR", "keywords": ["Bird", "Runners", "Gorilla", "Horror", "Mods"], "long_description": "Bird Runners VR is a multiplayer virtual reality game that lets players experience life as a bird, using innovative arm-based locomotion to run, jump, climb, and glide through dynamic environments. Inspired by games like Gorilla Tag, it focuses on physics-based movement, allowing players to master traversal skills and compete in various game modes. Whether exploring open worlds, engaging in high-speed chases, or socializing in lobbies, players can customize their bird characters with unique cosmetics. The game encourages fast-paced, skill-based gameplay while fostering a fun and interactive community. With frequent updates, new maps, and game modes, Bird Runners VR offers an ever-evolving experience for players looking to test their agility and reflexes. Designed for VR platforms, it supports online multiplayer, allowing friends to team up or compete in exhilarating challenges.", "short_description": "Bird Runners VR is a multiplayer VR game where players take on the role of birds, using arm movements to run, jump, and glide through various environments. Similar to *Gorilla Tag*, it features fast-paced, physics-based locomotion, social interactions, and competitive mini-games."}]}, "developer_name": "Nebula Forge Studios", "developer_privacy_policy_url": "https://docs.google.com/document/d/1mxaajlw2I3QkUonpxhIMQVqkmtWh8PYNbCZRUiyY67M/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Nebula Forge Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/birdrunners", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes":
name": "bdrun.png", "id": "1347788293098845", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391924_1347788296432178_613540574265254062_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VXDS6VwFFM4Q7kNvwG8xH0N&_nc_oc=Adplyo0i5WNmT-9sxDX0iBRoq7wTBnCcRVQgR398voE9Dbwz15M5bw8l2Vy2-HIodbQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzSgYp5ntVjK2fZ2VXP-XLFUCXnPqcA9aGkDcS5bDs3CQ&oe=69D10C7C"}, {"file_name": "bdrun.png", "id": "1790144721764261", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391911_1790144725097594_82329047595191227_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RwAGBg76LJ8Q7kNvwH_4MvG&_nc_oc=Ado21sqM1ApoulyDh6p2S-9pLSylfgIjU2RK-2H2T8D6VMDpAwihxAlxIK-v_8VbUBw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwKrcd8H7_w2PLgVPzOa5kAeBssOIhW6kLK4Aen3VBsJQ&oe=69D10BE6"}, {"file_name": "bdrun.png", "id": "1359512751751308", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393841_1359512755084641_2061987581396801429_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fuBBaPDxFb4Q7kNvwHRK0kl&_nc_oc=AdpxAJVhGa5qzBDe4lw8m4aKGe-RBZ8tbs2UJaYl1umBf7CGgKTfM5Q7OGbQJ0D-LqI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzA5E1tt2mZzq1gXKBAp9Gjowo4LxAAuJCxajojrMa3Kw&oe=69D0F70E"}, {"file_name": "bdrun.png", "id": "685489780808187", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393450_685489784141520_8206373762344470015_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Irxl6DqcbEQ7kNvwE4jtkS&_nc_oc=AdpD2DPpxb4mzfkrheDOE4l2FEMajD1MgDi9Z0jmfDNaV2M6uPm6JHzBLxhi9DzV_PA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyQwcmy7ODWfc8EvyJKTJDY02jztIxZCYc37hk-u6buHg&oe=69D1248D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bird Runners VR", "keywords": ["Bird", "Runners", "Gorilla", "Horror", "Mods"], "long_description": "Bird Runners VR is a multiplayer virtual reality game that lets players experience life as a bird, using innovative arm-based locomotion to run, jump, climb, and glide through dynamic environments. Inspired by games like Gorilla Tag, it focuses on physics-based movement, allowing players to master traversal skills and compete in various game modes. Whether exploring open worlds, engaging in high-speed chases, or socializing in lobbies, players can customize their bird characters with unique cosmetics. The game encourages fast-paced, skill-based gameplay while fostering a fun and interactive community. With frequent updates, new maps, and game modes, Bird Runners VR offers an ever-evolving experience for players looking to test their agility and reflexes. Designed for VR platforms, it supports online multiplayer, allowing friends to team up or compete in exhilarating challenges.", "short_description": "Bird Runners VR is a multiplayer VR game where players take on the role of birds, using arm movements to run, jump, and glide through various environments. Similar to *Gorilla Tag*, it features fast-paced, physics-based locomotion, social interactions, and competitive mini-games."}]}, "developer_name": "Nebula Forge Studios", "developer_privacy_policy_url": "https://docs.google.com/document/d/1mxaajlw2I3QkUonpxhIMQVqkmtWh8PYNbCZRUiyY67M/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Nebula Forge Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/birdrunners", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes":
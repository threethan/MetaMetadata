LRi2Uk01UamYQewnxK5P1WoBe8&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftENDeO0GJZHcs7X9FNPILTiPRLuZOwQrM1VUpr5NJ_pA&oe=69A1967C"}, {"file_name": "bdrun.png", "id": "1790144721764261", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/473391911_1790144725097594_82329047595191227_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ddxsULlZ97wQ7kNvwFPQrAM&_nc_oc=AdkgGA_j7xD0TfyAZI5WhrmKeOz-W9RnZ0ToykyCS9RZY_eQ4hvCjyOrAD9lsXF2cmU&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Afu8YUgaytUdVaQ1WcTvh3jg3pZG7kSnEAmwMNl6pNEbjg&oe=69A195E6"}, {"file_name": "bdrun.png", "id": "1359512751751308", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/473393841_1359512755084641_2061987581396801429_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rJwUWKaP0RgQ7kNvwGEJRoK&_nc_oc=Admsed1L3li-aqA82Yi9WdhuNNCIpgM_kfkpvE08P8Ilh3cmyuUc91sHjD0oeh29tMg&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Aft3QAfzV7FN3MwK0lKLFtL9iLbV1oPZ7-8I4wzl67di0Q&oe=69A1810E"}, {"file_name": "bdrun.png", "id": "685489780808187", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/473393450_685489784141520_8206373762344470015_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oMRHQXN8qmkQ7kNvwE8tFD0&_nc_oc=Adnibw2iEoWOTVM-i4rzG5RVEZqAiqzr4TGzlcjOdIj8FNK_AGQJEhshOt20vwzM2uU&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfvxdPg60PHwViYFL3BkD4eFGFaknwj5mRWfbthqtkD42A&oe=69A1764D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bird Runners VR", "keywords": ["Bird", "Runners", "Gorilla", "Horror", "Mods"], "long_description": "Bird Runners VR is a multiplayer virtual reality game that lets players experience life as a bird, using innovative arm-based locomotion to run, jump, climb, and glide through dynamic environments. Inspired by games like Gorilla Tag, it focuses on physics-based movement, allowing players to master traversal skills and compete in various game modes. Whether exploring open worlds, engaging in high-speed chases, or socializing in lobbies, players can customize their bird characters with unique cosmetics. The game encourages fast-paced, skill-based gameplay while fostering a fun and interactive community. With frequent updates, new maps, and game modes, Bird Runners VR offers an ever-evolving experience for players looking to test their agility and reflexes. Designed for VR platforms, it supports online multiplayer, allowing friends to team up or compete in exhilarating challenges.", "short_description": "Bird Runners VR is a multiplayer VR game where players take on the role of birds, using arm movements to run, jump, and glide through various environments. Similar to *Gorilla Tag*, it features fast-paced, physics-based locomotion, social interactions, and competitive mini-games."}]}, "developer_name": "Nebula Forge Studios", "developer_privacy_policy_url": "https://docs.google.com/document/d/1mxaajlw2I3QkUonpxhIMQVqkmtWh8PYNbCZRUiyY67M/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Nebula Forge Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/birdrunners", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9842887049075294"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "A
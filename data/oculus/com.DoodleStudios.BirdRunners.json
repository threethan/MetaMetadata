name": "bdrun.png", "id": "1347788293098845", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391924_1347788296432178_613540574265254062_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fFpuaT5LRG4Q7kNvwEWBwS3&_nc_oc=Adp-aBf4d7FxX-32wJj_Neb3mqja8PbCC7KJfPUHlTFFSOhP5iiV9NrDB03wtxELyAQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPeCu2ag0o1V2C-L73VSIUAewviyCcnzzpHB55TPL5zAA&oe=6AD3AABC"}, {"file_name": "bdrun.png", "id": "1790144721764261", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391911_1790144725097594_82329047595191227_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-vWqLelk3HMQ7kNvwHFLiIT&_nc_oc=AdrF20V_aEv27ePStbbXwObsMGQ4dQ7rb75ny9Ev8yJS5_Fvii8AXEgGyn88aOs8lqs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPkkanQUzlx91Wi0U6pYvxxpK_lSjgbuzA8aut_Ihfv5A&oe=6AD3AA26"}, {"file_name": "bdrun.png", "id": "1359512751751308", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393841_1359512755084641_2061987581396801429_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YBVzdDxaYvkQ7kNvwGiql6e&_nc_oc=AdpmNsvACFx4MTBS7dmMKP4moGujn4hwwYdBgZNT_DsgqgD1s1mbLrG7zOl-1qfXx1M&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOVaPRu3PAAzRUrwmb7hiVwwzuE1nSHL6lbvJJX5NZBRg&oe=6AD3954E"}, {"file_name": "bdrun.png", "id": "685489780808187", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473393450_685489784141520_8206373762344470015_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7B54JEmEw6EQ7kNvwFctGvC&_nc_oc=AdqVvvcFNvuymS6d2q2BojRRhHia2_LgXvVcgzRSLLeEGti27zT2rrluWqo4LJCRKto&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNm4KuhGiDnAuYeEFuIrH_7r3K0RokESobYpQrZxUGvA&oe=6AD38A8D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bird Runners VR", "keywords": ["Bird", "Runners", "Gorilla", "Horror", "Mods"], "long_description": "Bird Runners VR is a multiplayer virtual reality game that lets players experience life as a bird, using innovative arm-based locomotion to run, jump, climb, and glide through dynamic environments. Inspired by games like Gorilla Tag, it focuses on physics-based movement, allowing players to master traversal skills and compete in various game modes. Whether exploring open worlds, engaging in high-speed chases, or socializing in lobbies, players can customize their bird characters with unique cosmetics. The game encourages fast-paced, skill-based gameplay while fostering a fun and interactive community. With frequent updates, new maps, and game modes, Bird Runners VR offers an ever-evolving experience for players looking to test their agility and reflexes. Designed for VR platforms, it supports online multiplayer, allowing friends to team up or compete in exhilarating challenges.", "short_description": "Bird Runners VR is a multiplayer VR game where players take on the role of birds, using arm movements to run, jump, and glide through various environments. Similar to *Gorilla Tag*, it features fast-paced, physics-based locomotion, social interactions, and competitive mini-games."}]}, "developer_name": "Nebula Forge Studios", "developer_privacy_policy_url": "https://docs.google.com/document/d/1mxaajlw2I3QkUonpxhIMQVqkmtWh8PYNbCZRUiyY67M/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Nebula Forge Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/birdrunners", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes":
641_2061987581396801429_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qyqJbxIoLeUQ7kNvwGZ_2WD&_nc_oc=AdruOcBlCIjk54oTay4wco6hz6FCiBf9hSjvFPZmu_dyyg1yJmaJx9AxgmyqEuMAjgQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQg3o7nPq6DpmvQHpACXY3jWLC_g9l34Zk5A3kXemYz_A&oe=6B00684E"}, {"file_name": "bdrun.png", "id": "685489780808187", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393450_685489784141520_8206373762344470015_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M5fq4MEV-JgQ7kNvwHrM2I3&_nc_oc=AdqvfgNTGK4qvEvPRLEEXRjeo9YgsTWiZ37rGRGx0-oGYWamCIk0C8ajbKoGPKLZbow&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyvSMq-PrwuS0aWLPm3qw8z9Nbl3fq9ZBJa2Z9iB8ACw&oe=6B005D8D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bird Runners VR", "keywords": ["Bird", "Runners", "Gorilla", "Horror", "Mods"], "long_description": "Bird Runners VR is a multiplayer virtual reality game that lets players experience life as a bird, using innovative arm-based locomotion to run, jump, climb, and glide through dynamic environments. Inspired by games like Gorilla Tag, it focuses on physics-based movement, allowing players to master traversal skills and compete in various game modes. Whether exploring open worlds, engaging in high-speed chases, or socializing in lobbies, players can customize their bird characters with unique cosmetics. The game encourages fast-paced, skill-based gameplay while fostering a fun and interactive community. With frequent updates, new maps, and game modes, Bird Runners VR offers an ever-evolving experience for players looking to test their agility and reflexes. Designed for VR platforms, it supports online multiplayer, allowing friends to team up or compete in exhilarating challenges.", "short_description": "Bird Runners VR is a multiplayer VR game where players take on the role of birds, using arm movements to run, jump, and glide through various environments. Similar to *Gorilla Tag*, it features fast-paced, physics-based locomotion, social interactions, and competitive mini-games."}]}, "developer_name": "Nebula Forge Studios", "developer_privacy_policy_url": "https://docs.google.com/document/d/1mxaajlw2I3QkUonpxhIMQVqkmtWh8PYNbCZRUiyY67M/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Nebula Forge Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/birdrunners", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9842887049075294"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391883_971528185171774_3753372154531983150_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MrPXyp1-2oQQ7kNvwHtrnVE&_nc_oc=AdpxnERQoeRv3jEThcjf65uoFxoD8Seu7OAxKckQ2MjXYdcg2ABJopdT8SHgeL8heDI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdZNwX71QcClYBm2BRc_yEmwZLPAHwg0LALm08ZaqRWw&oe=6B0060FF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Bird Runners VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}], "release_date": 1743625980, "lastRevision": {"nodes": [{
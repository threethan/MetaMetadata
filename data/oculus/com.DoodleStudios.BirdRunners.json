OKlsTSX9GQmINT-GeWM1GNFZBc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afvg73Si1GVgp7l5HGMEw7Xcj0gFr0NXhOO_tnpVl2Pi7w&oe=69A58AFC"}, {"file_name": "bdrun.png", "id": "1790144721764261", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391911_1790144725097594_82329047595191227_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l1XdmqcGDhIQ7kNvwHSZbh7&_nc_oc=AdmZMS4Fm9YpyWI7kAMCGKBz-eMo1fVNhFxTvYzJ72ElMI0ovVlHmgkWifIrMJYV0Vw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfspS5vp6qWCFfqJjhFlt05ZL95SXAMrGeFns1769NhBfQ&oe=69A58A66"}, {"file_name": "bdrun.png", "id": "1359512751751308", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393841_1359512755084641_2061987581396801429_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7dIJyc19OAMQ7kNvwHe4aOs&_nc_oc=AdlQFvnQ_ZfXPTVpiWMDI_SbKwiJSpWeNRFUUNV6hgL5jOZQrU1UUwOjSCy9-ez95E4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfvX34e5N8qFRv5T1YKYwhz0nZjj6TMxuNhL77Lkxfj7DA&oe=69A5758E"}, {"file_name": "bdrun.png", "id": "685489780808187", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393450_685489784141520_8206373762344470015_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QcO8jZg4A8kQ7kNvwFGsF6X&_nc_oc=Adl9PLKlq6DGJa-64QEbAhNGzKBV5kjvvIcSbwu5YxFVk2oLA7joMGYKD_tZ0luiKsQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afuzg0JEkfQAHHlCDQ96UwwRPAETWpKxCBaFSE_ghQfqCQ&oe=69A56ACD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bird Runners VR", "keywords": ["Bird", "Runners", "Gorilla", "Horror", "Mods"], "long_description": "Bird Runners VR is a multiplayer virtual reality game that lets players experience life as a bird, using innovative arm-based locomotion to run, jump, climb, and glide through dynamic environments. Inspired by games like Gorilla Tag, it focuses on physics-based movement, allowing players to master traversal skills and compete in various game modes. Whether exploring open worlds, engaging in high-speed chases, or socializing in lobbies, players can customize their bird characters with unique cosmetics. The game encourages fast-paced, skill-based gameplay while fostering a fun and interactive community. With frequent updates, new maps, and game modes, Bird Runners VR offers an ever-evolving experience for players looking to test their agility and reflexes. Designed for VR platforms, it supports online multiplayer, allowing friends to team up or compete in exhilarating challenges.", "short_description": "Bird Runners VR is a multiplayer VR game where players take on the role of birds, using arm movements to run, jump, and glide through various environments. Similar to *Gorilla Tag*, it features fast-paced, physics-based locomotion, social interactions, and competitive mini-games."}]}, "developer_name": "Nebula Forge Studios", "developer_privacy_policy_url": "https://docs.google.com/document/d/1mxaajlw2I3QkUonpxhIMQVqkmtWh8PYNbCZRUiyY67M/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Nebula Forge Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/birdrunners", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9842887049075294"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "A
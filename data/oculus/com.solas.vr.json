9Ciu_AQ7kNvwG5oU-K&_nc_oc=AdrEKyHVqYI59klAeXoYdEJPakWuxVuwH-QCMuT5jjzCCAwGqZVFLe9uRoQfOEqrM9U&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELL4lW5dyJxgkwLv7a2xU0BQ9I1oTQASOpOWmwVRAuIg&oe=6A943128"}, {"file_name": "Glendalough lake.png", "id": "317898529368349", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39036652_317898532701682_1088784562417673472_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C-7CbbyMtJEQ7kNvwEc2vw9&_nc_oc=AdpL_7oMTHKC7mxL7sGQ1Qz-Y6Tu8BN_dawrk5R4Muw8zxIpzc2ndjNnZmt0_1Nysk8&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFNpY-y7vd1R2w5ks29FEn5RXF7QZBwYz8Exkq0C6aNlg&oe=6A942FDB"}, {"file_name": "Powerscourt waterfall.png", "id": "293387855349260", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75207237_293387858682593_3625796469231178237_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jpdacbP3_cYQ7kNvwGqT0lr&_nc_oc=AdrQsMl6xT-gTZSrCY7ENhsgDrYTgakuW_izofpMrcVJu-oPR3EfOkv7fpGcPOqIQXM&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrCyhOPTud9nKBnLATuViqOKHlv22PsZIh1GvFZnESJg&oe=6A941B9A"}, {"file_name": "Beach wexford.png", "id": "290192465660275", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75222938_290192468993608_254672737452146756_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KjR_GKqU68YQ7kNvwHtt3q6&_nc_oc=Adpp28TjSU0Jf2F9PGW2dz-VVdndAdHN6OQCMjNTkL2yP3ou67qNVzdQ9OdfnvlS3po&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHqIifRgZeyMk1YEr2icad0-a562pvd51gU971a-Kr2Og&oe=6A94114C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "forest trailer.png", "id": "988047351647701", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/10000000_988047361647700_5249813252618530611_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kfXUFg7fKp8Q7kNvwHD14QQ&_nc_oc=AdooHcjno8iYC0UzeGeb28p1-Y78g1fGkWUQN9if4Cwb-dSy7Ok6tiXNjVewFhZ9aLU&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGOUssyqzC91gj0cXIXudXd-YH70SMrP1uf1m6w6njvJg&oe=6A94120B"}, "display_name": "Solas VR", "keywords": ["Meditation", "Nature", "Productivity", "Relaxation", "Mindfulness"], "long_description": "Solas Meditation is the VR app that goes beyond meditation as we know it. With an immersive gallery of landscapes, nature sounds and guidance, Solas VR meditation replicates the real feeling of being out there, close to nature, enjoying the inner calmness we are made for. Bringing together eternal wisdom and cutting edge technology, Solas Meditation is designed for urban living, as a shield against stress, confusion and rush. The graphics and sounds, provided directly by nature, create a seamless multi-sensory experience, initiating a journey within. \nWith Solas Meditation you will feel more. You will do more. You will be more.", "short_description": "Add a new dimension to your meditation and allow nature to take you on a journey within. Solas VR presents a gallery of landscapes, nature sounds and guided meditations, designed to refresh your mind, spirit and soul.  This wonderful VR experience is the perfect micro break in nature that you can take while living an urban life.  Why settle with two dimensions, when you can have more? Why not dive inside your inner wisdom where you can be more?"}]}, "developer_name": "Virtual Reality Ireland Media Ltd.", "developer_privacy_policy_url": "https://www.solasvr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.solasvr.com/terms-of-service/", "publisher_name": "Tiesto Capital Ltd", "support_website_url": "https://www.solasvr.com/about/", "website_url": "https://www.solasvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphic
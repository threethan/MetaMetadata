-LGMQAQ7kNvwFHviCL&_nc_oc=AdomKr1a6IVAykiIx45bTmtIIf3pabzT9GvF62HuWwqqipqzniC4aIgSXCauIWrYFJU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDd4BpWIjJJ8r7PbYlSFIvRnLSJQiW7QGI_Lh-vTwoBTA&oe=6A578C28"}, {"file_name": "Glendalough lake.png", "id": "317898529368349", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036652_317898532701682_1088784562417673472_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FdpgXdtUxYUQ7kNvwElICyn&_nc_oc=Adp90U7OGfPMgWehMw-9CxBSVjgTC3T5ZFuLHl4VAEXHUOKzR6WtYan0nWMQAFm-Ghg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCSwVeYw4FbDpvozC38e2KwBhbU8AgTSHhH3eESPiG-cg&oe=6A578ADB"}, {"file_name": "Powerscourt waterfall.png", "id": "293387855349260", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75207237_293387858682593_3625796469231178237_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VnuONqZMkeMQ7kNvwGyB3Ax&_nc_oc=AdqVSF58mJ1CusDRLwJ7f_3iKwLrwWtw4SuDPHnju2IU1pbPzxdE3sp3RyoERqo7l_A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCc2vatbGeS_3lkjvg8GDqUE9jO-pMFETjKzk37GIX2wA&oe=6A57769A"}, {"file_name": "Beach wexford.png", "id": "290192465660275", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75222938_290192468993608_254672737452146756_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oWd9rlvWGzgQ7kNvwGaJiw2&_nc_oc=Adoa8mJp56oyCyYKW2ABccotYC4vf2ffBc87k_CuB-zPbM6Z__w6gUZHNEc8Nk8oKV8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtu5lj_cTkSkCX9LfaQHCNFlbmg1miwXxexE79GhiOpA&oe=6A576C4C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "forest trailer.png", "id": "988047351647701", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/10000000_988047361647700_5249813252618530611_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qwp652U1JeAQ7kNvwHvJxin&_nc_oc=AdrUnY5BwlzALza-HkLYFlysutrMkFVw0ueBUnGQiZcnhiGCRs_LOIUmZqWkqksxwks&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBF8NKR9Z0EdnevuWDKUgEp_PUDpQjiDvteF4S8vtgtWA&oe=6A576D0B"}, "display_name": "Solas VR", "keywords": ["Meditation", "Nature", "Productivity", "Relaxation", "Mindfulness"], "long_description": "Solas Meditation is the VR app that goes beyond meditation as we know it. With an immersive gallery of landscapes, nature sounds and guidance, Solas VR meditation replicates the real feeling of being out there, close to nature, enjoying the inner calmness we are made for. Bringing together eternal wisdom and cutting edge technology, Solas Meditation is designed for urban living, as a shield against stress, confusion and rush. The graphics and sounds, provided directly by nature, create a seamless multi-sensory experience, initiating a journey within. \nWith Solas Meditation you will feel more. You will do more. You will be more.", "short_description": "Add a new dimension to your meditation and allow nature to take you on a journey within. Solas VR presents a gallery of landscapes, nature sounds and guided meditations, designed to refresh your mind, spirit and soul.  This wonderful VR experience is the perfect micro break in nature that you can take while living an urban life.  Why settle with two dimensions, when you can have more? Why not dive inside your inner wisdom where you can be more?"}]}, "developer_name": "Virtual Reality Ireland Media Ltd.", "developer_privacy_policy_url": "https://www.solasvr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.solasvr.com/terms-of-service/", "publisher_name": "Tiesto Capital Ltd", "support_website_url": "https://www.solasvr.com/about/", "website_url": "https://www.solasvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphic
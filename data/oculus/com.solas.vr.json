kxeFbkQ7kNvwFyvRL8&_nc_oc=AdrrOl9qfGt3myGHJWZI9f8b52fb9TNJ-DkMeVSXaPzSRFb3PurimXby3iRs-PDsnuI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1bBAbWQMJePY0XPAIL8E8C2rWc-xjh8oVM1ZWsM5FVA&oe=6A89A528"}, {"file_name": "Glendalough lake.png", "id": "317898529368349", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036652_317898532701682_1088784562417673472_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VIB14lf_6KIQ7kNvwHdJ88v&_nc_oc=AdrBj1F9vx_emGJsfJ57sR-ZIiEvLwZb_-JcC6DJXBPBS04SGu73MXWqg2WOT6XmpbQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEtGzFBMuKIa4qScPafPZuri9mFuBUJIFsPNlEGUirAaA&oe=6A89A3DB"}, {"file_name": "Powerscourt waterfall.png", "id": "293387855349260", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75207237_293387858682593_3625796469231178237_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8UTGqsKHI_QQ7kNvwFNtN50&_nc_oc=AdpqeiNbvrigxHDaqOr32TfzO6R0C05JJAdVbz0MvpURzhsUc0otSFsNZr4FMjLuK3g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8XNyDBO15g80TZdxLL0hZYq22aw5CcYDAxE4H7a0s3Q&oe=6A898F9A"}, {"file_name": "Beach wexford.png", "id": "290192465660275", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75222938_290192468993608_254672737452146756_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TxTiEpfBM3EQ7kNvwEmyfcc&_nc_oc=AdogFKLf-i5BueglctBoSP3CTT-PxyDHKht0W5vrQR9rKMOqXpDAnP4MU_HqR70z8I4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtERKFQsYQGKYrnYezxlQV8dLMefddbYDR0iDKqzoEsg&oe=6A89854C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "forest trailer.png", "id": "988047351647701", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/10000000_988047361647700_5249813252618530611_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EPRnYgyAB_kQ7kNvwHZFpIT&_nc_oc=Adqzhn1uXwT3dJzmYSVSiX5chmlO8TpksbXIZVFJjoHio0yQLgyHtcsy_ENb04SD25w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0bAxV4o9Ms5q3RFEkj9jBY3lIw-R8oUmfkjMTboklYw&oe=6A89860B"}, "display_name": "Solas VR", "keywords": ["Meditation", "Nature", "Productivity", "Relaxation", "Mindfulness"], "long_description": "Solas Meditation is the VR app that goes beyond meditation as we know it. With an immersive gallery of landscapes, nature sounds and guidance, Solas VR meditation replicates the real feeling of being out there, close to nature, enjoying the inner calmness we are made for. Bringing together eternal wisdom and cutting edge technology, Solas Meditation is designed for urban living, as a shield against stress, confusion and rush. The graphics and sounds, provided directly by nature, create a seamless multi-sensory experience, initiating a journey within. \nWith Solas Meditation you will feel more. You will do more. You will be more.", "short_description": "Add a new dimension to your meditation and allow nature to take you on a journey within. Solas VR presents a gallery of landscapes, nature sounds and guided meditations, designed to refresh your mind, spirit and soul.  This wonderful VR experience is the perfect micro break in nature that you can take while living an urban life.  Why settle with two dimensions, when you can have more? Why not dive inside your inner wisdom where you can be more?"}]}, "developer_name": "Virtual Reality Ireland Media Ltd.", "developer_privacy_policy_url": "https://www.solasvr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.solasvr.com/terms-of-service/", "publisher_name": "Tiesto Capital Ltd", "support_website_url": "https://www.solasvr.com/about/", "website_url": "https://www.solasvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphic
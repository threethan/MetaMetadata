L_wUR8Q7kNvwFgp9o9&_nc_oc=AdrlPgbxqLbz7TO15maQG2CcRgoZqMVzrxPKQeXeYpODpX4lY6Xt1zL7cA9EhnpwuEM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2zVlaWx2MygqW2zpcy-ZsC7j-sqoS3YkNzteFHHXsMOw&oe=69E8CE28"}, {"file_name": "Glendalough lake.png", "id": "317898529368349", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036652_317898532701682_1088784562417673472_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rJk5SAqU1ZEQ7kNvwFhDce2&_nc_oc=Adr-qxg4-0D0MLoMpL00T-dntKsoFbHbb0eVGZ5vhs76FoEFvGXyuWFmqaSibmYYxNg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ey55X3I0TMVEiaP7kTTKhP5ODholGF50SgA-_3ozIeg&oe=69E8CCDB"}, {"file_name": "Powerscourt waterfall.png", "id": "293387855349260", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75207237_293387858682593_3625796469231178237_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qleBYexcOpQQ7kNvwHJiy-o&_nc_oc=AdoVEAJrz8-wW8-DUvFYXZINMQNJxz65GSiGOx1b6XiyzbywQ9TiarX5AHC9kNFKJTk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Ej07yin0X_7gb0mSED5fyns9FQr-3ajmdqBiI_9y18A&oe=69E8B89A"}, {"file_name": "Beach wexford.png", "id": "290192465660275", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75222938_290192468993608_254672737452146756_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aPRVRWmWOGUQ7kNvwH3wkDi&_nc_oc=Adr3nmL0taqvH3hkWMA11bQKLOPaiDEV3dNBppTygTs51XzeQb_TKu6-0rOTYDmwwvM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1cK67xWTNmgC3DTvjqoHCjYT_LS2zp8z6M54ZU7F3Vqw&oe=69E8AE4C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "forest trailer.png", "id": "988047351647701", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/10000000_988047361647700_5249813252618530611_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FmGIrjVpDV8Q7kNvwGRVvwg&_nc_oc=AdpHH4McXbWVPCg1PdNpzVsjLF1jcr6KA4VhT1fGol62f5Ql3AkbvHFRCDqYRIlboBI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1VdWLduvZvR4UObw8LStUwCh1_QUKHtAqiDqOQT0LkFw&oe=69E8AF0B"}, "display_name": "Solas VR", "keywords": ["Meditation", "Nature", "Productivity", "Relaxation", "Mindfulness"], "long_description": "Solas Meditation is the VR app that goes beyond meditation as we know it. With an immersive gallery of landscapes, nature sounds and guidance, Solas VR meditation replicates the real feeling of being out there, close to nature, enjoying the inner calmness we are made for. Bringing together eternal wisdom and cutting edge technology, Solas Meditation is designed for urban living, as a shield against stress, confusion and rush. The graphics and sounds, provided directly by nature, create a seamless multi-sensory experience, initiating a journey within. \nWith Solas Meditation you will feel more. You will do more. You will be more.", "short_description": "Add a new dimension to your meditation and allow nature to take you on a journey within. Solas VR presents a gallery of landscapes, nature sounds and guided meditations, designed to refresh your mind, spirit and soul.  This wonderful VR experience is the perfect micro break in nature that you can take while living an urban life.  Why settle with two dimensions, when you can have more? Why not dive inside your inner wisdom where you can be more?"}]}, "developer_name": "Virtual Reality Ireland Media Ltd.", "developer_privacy_policy_url": "https://www.solasvr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.solasvr.com/terms-of-service/", "publisher_name": "Tiesto Capital Ltd", "support_website_url": "https://www.solasvr.com/about/", "website_url": "https://www.solasvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphic
xt6GmcQ7kNvwEDJz9J&_nc_oc=Adphtb3ym4D9v9kf-jC34fISW-6O1vv1RyB7gb-GSSab4VKfiCrWOQGxYLEBC3b_vog&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2ZAjJXhIfy-_qi-3NCWAqmGTxNBTfjmWoMq1OTSA_Gw&oe=6A8AF6A8"}, {"file_name": "Glendalough lake.png", "id": "317898529368349", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036652_317898532701682_1088784562417673472_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CWRNmwk_Ld8Q7kNvwEbRjQF&_nc_oc=Adoh8Bp728PTP7uZGuNANHinFYkbL2HhX5Lh0UeFT9zMKsumBDw3xOIzTZZuo_VH8Vg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJ2fomZJuklLHd949lOhzXT08I3p0TEd3xCPcgFkWxKA&oe=6A8AF55B"}, {"file_name": "Powerscourt waterfall.png", "id": "293387855349260", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75207237_293387858682593_3625796469231178237_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8UTGqsKHI_QQ7kNvwFZIoRi&_nc_oc=AdopFGrjNooHQscPTCvA9Q-8oaRqkxgjJVVm2TE2cOcRy8vr7qUK6pBkrRtJ9uclkMQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJVaXoxaqPvTgUN-zV949lxzFMM2UrSFXFYdrTZ9ENbg&oe=6A8AE11A"}, {"file_name": "Beach wexford.png", "id": "290192465660275", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75222938_290192468993608_254672737452146756_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TxTiEpfBM3EQ7kNvwEPVXZy&_nc_oc=AdqaFHt_Y3YMmLyqE9qrb5HCny8NspvuELJNAu5-4dzzwHC0dHKN-_eUyJGUqn_p3HY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGiHEJKbpvAmRtgXRz3_xfTQhN1Paty8JR8tsNSdjS37g&oe=6A8AD6CC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "forest trailer.png", "id": "988047351647701", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/10000000_988047361647700_5249813252618530611_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f271Nx4289MQ7kNvwFOb7s6&_nc_oc=AdrTQe_LslqHmJoLK1y8tEBUk8Zk7j9eIiVclkThdamnGPbdOa2W-0_NLvN1qNx0IdU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8e2u5xP7aro9NhIWmlh_2d_fLmi3dkjFL0aCbuZm4jQ&oe=6A8AD78B"}, "display_name": "Solas VR", "keywords": ["Meditation", "Nature", "Productivity", "Relaxation", "Mindfulness"], "long_description": "Solas Meditation is the VR app that goes beyond meditation as we know it. With an immersive gallery of landscapes, nature sounds and guidance, Solas VR meditation replicates the real feeling of being out there, close to nature, enjoying the inner calmness we are made for. Bringing together eternal wisdom and cutting edge technology, Solas Meditation is designed for urban living, as a shield against stress, confusion and rush. The graphics and sounds, provided directly by nature, create a seamless multi-sensory experience, initiating a journey within. \nWith Solas Meditation you will feel more. You will do more. You will be more.", "short_description": "Add a new dimension to your meditation and allow nature to take you on a journey within. Solas VR presents a gallery of landscapes, nature sounds and guided meditations, designed to refresh your mind, spirit and soul.  This wonderful VR experience is the perfect micro break in nature that you can take while living an urban life.  Why settle with two dimensions, when you can have more? Why not dive inside your inner wisdom where you can be more?"}]}, "developer_name": "Virtual Reality Ireland Media Ltd.", "developer_privacy_policy_url": "https://www.solasvr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.solasvr.com/terms-of-service/", "publisher_name": "Tiesto Capital Ltd", "support_website_url": "https://www.solasvr.com/about/", "website_url": "https://www.solasvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphic
t0PoZ0Q7kNvwGnTXzi&_nc_oc=AdpGGV6VCI9nCRBvP74oIWEDBGsSKiZ-3oWJfeYE5CrQFH330x2_yKIGkHCRaxi6BlI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIAL9NrCplajPiqymvypvLn5OGN7Lu0OaE-2ZkNw0wNUg&oe=6AA7F7A8"}, {"file_name": "Glendalough lake.png", "id": "317898529368349", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036652_317898532701682_1088784562417673472_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eKUnuRO3ejQQ7kNvwEwPn85&_nc_oc=AdqmczLIsJFfP2UvjYK-5omP4vkujpzw_KccWcLWoEw8uym8Ipxn3vWYrya_RR4ede0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjJNEqDVXiG04bOjMvyRz8m6985P3kBemEO7bBqsbBmQ&oe=6AA7F65B"}, {"file_name": "Powerscourt waterfall.png", "id": "293387855349260", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75207237_293387858682593_3625796469231178237_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cXuYaiIRQfMQ7kNvwF9eH1N&_nc_oc=AdopFhTU_SPcMrvheeHD6DokjF9-uscr0WZkzZ16LJunkfBnnPUch2DZ8ROz4g2brUU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJgcjmSSYpeOfQF1N9mIUT1tdJzuSOoiZMa-Uiejo8UPQ&oe=6AA81A5A"}, {"file_name": "Beach wexford.png", "id": "290192465660275", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75222938_290192468993608_254672737452146756_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CJdyr_p2eLYQ7kNvwHkh4dN&_nc_oc=Adpv-oq02xQMTZJ6r4CH6QMGXiktA2W_sjP7Tfa1j6R06GOQhc6ZsmXoIKrtp6nJes0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIsfzTdBx2w1thGMmMRCIPl3Y51vNX13XCTjfPvrbO0Ag&oe=6AA8100C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "forest trailer.png", "id": "988047351647701", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/10000000_988047361647700_5249813252618530611_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kkFm5gMLEtoQ7kNvwGy5eP1&_nc_oc=Adq34aC657tDL6sMh8gVDA0P4dlEVxobbj4RbS2jFKlPZ0G1Vo0UdPEdTzphnCkpeQY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNQpHbk-tX7nUIYjU1WWCRsWNjNqXxj5e32g0aPpa0xg&oe=6AA810CB"}, "display_name": "Solas VR", "keywords": ["Meditation", "Nature", "Productivity", "Relaxation", "Mindfulness"], "long_description": "Solas Meditation is the VR app that goes beyond meditation as we know it. With an immersive gallery of landscapes, nature sounds and guidance, Solas VR meditation replicates the real feeling of being out there, close to nature, enjoying the inner calmness we are made for. Bringing together eternal wisdom and cutting edge technology, Solas Meditation is designed for urban living, as a shield against stress, confusion and rush. The graphics and sounds, provided directly by nature, create a seamless multi-sensory experience, initiating a journey within. \nWith Solas Meditation you will feel more. You will do more. You will be more.", "short_description": "Add a new dimension to your meditation and allow nature to take you on a journey within. Solas VR presents a gallery of landscapes, nature sounds and guided meditations, designed to refresh your mind, spirit and soul.  This wonderful VR experience is the perfect micro break in nature that you can take while living an urban life.  Why settle with two dimensions, when you can have more? Why not dive inside your inner wisdom where you can be more?"}]}, "developer_name": "Virtual Reality Ireland Media Ltd.", "developer_privacy_policy_url": "https://www.solasvr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.solasvr.com/terms-of-service/", "publisher_name": "Tiesto Capital Ltd", "support_website_url": "https://www.solasvr.com/about/", "website_url": "https://www.solasvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphic
9moSPcQ7kNvwHQ0yG-&_nc_oc=Ado7dL2H8zGKcDmm56r3zWJG84V53jkQZIkwvAh0aCP73msDA94RrtRqSkDjL2A9zDc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5bWNmsQpG0ciZjtjdkleDyzbUK5LzwsYK6uEOLk8iNoA&oe=69FDE628"}, {"file_name": "Glendalough lake.png", "id": "317898529368349", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036652_317898532701682_1088784562417673472_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iy3mbTpxZO8Q7kNvwE2MvZO&_nc_oc=AdpbCg591gkdOMGLCFigv5xoEQ1IQA5Kt0SXCoO-JNhJlDuqwwlkkJXkK3uuMVnptmE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6u5ovUnatHK545OnzugwXTqhORscthjE3y80cCXJ7fdw&oe=69FDE4DB"}, {"file_name": "Powerscourt waterfall.png", "id": "293387855349260", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75207237_293387858682593_3625796469231178237_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rkyl3IitL58Q7kNvwHgPdZj&_nc_oc=AdqVyFkSUK4F669ocTa5nqvt4_ckqWP1zFV3HYg_yBSMLg44GGOcRW-0kkl3clwWiWs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68A7BYZaidiv__SeGguxnabWQ1gl4vHVK5ss2dV-oyTg&oe=69FDD09A"}, {"file_name": "Beach wexford.png", "id": "290192465660275", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/75222938_290192468993608_254672737452146756_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bHMTb80rx_YQ7kNvwEl3KhI&_nc_oc=AdqavbWnrooM4SzbmvPJle_UyJCQUSEUX7NJEJY-SqwELzKb8qfEWUWHfiKyhPOl9Mw&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4qTnNfZ8yYzPZcT04no2ZsSuvY9lkNYxmB3uC5QUWCbg&oe=69FDFE8C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "forest trailer.png", "id": "988047351647701", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/10000000_988047361647700_5249813252618530611_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-fhiaVcB_4EQ7kNvwE_ZthC&_nc_oc=Adr4etXfC5G5Z4WH5GSO52WJYaQ1FVylcAiTFPL54-73OxfdxYCfezDBgKupgooG1N4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jXLYLhEOsxoXWsQp0tm2W-R7dNa13gpaEMKsvc4Ym3g&oe=69FDFF4B"}, "display_name": "Solas VR", "keywords": ["Meditation", "Nature", "Productivity", "Relaxation", "Mindfulness"], "long_description": "Solas Meditation is the VR app that goes beyond meditation as we know it. With an immersive gallery of landscapes, nature sounds and guidance, Solas VR meditation replicates the real feeling of being out there, close to nature, enjoying the inner calmness we are made for. Bringing together eternal wisdom and cutting edge technology, Solas Meditation is designed for urban living, as a shield against stress, confusion and rush. The graphics and sounds, provided directly by nature, create a seamless multi-sensory experience, initiating a journey within. \nWith Solas Meditation you will feel more. You will do more. You will be more.", "short_description": "Add a new dimension to your meditation and allow nature to take you on a journey within. Solas VR presents a gallery of landscapes, nature sounds and guided meditations, designed to refresh your mind, spirit and soul.  This wonderful VR experience is the perfect micro break in nature that you can take while living an urban life.  Why settle with two dimensions, when you can have more? Why not dive inside your inner wisdom where you can be more?"}]}, "developer_name": "Virtual Reality Ireland Media Ltd.", "developer_privacy_policy_url": "https://www.solasvr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.solasvr.com/terms-of-service/", "publisher_name": "Tiesto Capital Ltd", "support_website_url": "https://www.solasvr.com/about/", "website_url": "https://www.solasvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphic
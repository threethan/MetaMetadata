ZwUC2EQ7kNvwEnBoCC&_nc_oc=AdpSk1hNIFK1GH1Wkv5mOGx5HMhuoS0i0qOWSnrk6ZNUwIBKzQtoR-R_r3r4d-Fdado&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLu9OKp8blTsUjdoSBpin7iZn7eTC6sbK6BK5eM8iVAWQ&oe=6AA00EA8"}, {"file_name": "Glendalough lake.png", "id": "317898529368349", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39036652_317898532701682_1088784562417673472_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mp9aUNBE0HUQ7kNvwFeHUc4&_nc_oc=AdoQIBI5DXjn0HYXgBmGeoutp0zhcUuImUXbcwSo1061Fy8VA9f55ccBk6E3iAL0XIg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfDaVYVj0bmq_LHRtQAS6wRGyXh9VBQvq_S4d5Nv1VWg&oe=6AA00D5B"}, {"file_name": "Powerscourt waterfall.png", "id": "293387855349260", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75207237_293387858682593_3625796469231178237_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L0nDaBTKCT4Q7kNvwHMmIFd&_nc_oc=Adrthqad23EWb-pRZDuR9aBTZLDqIPid892N9bk_wOAmPW-_yaQutABB9aE7uMpWLf8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlEMuUNapjDKpCHfkxQWfNtAZ-1D19ZGgAFLFoIvDPyw&oe=6A9FF91A"}, {"file_name": "Beach wexford.png", "id": "290192465660275", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75222938_290192468993608_254672737452146756_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tOWmaskPQN8Q7kNvwF3-pQE&_nc_oc=AdoEWyLieODgP9nVqxRMH_DQ3XFbeYrsy_7fesPvKrJNdu9DpF8Z3yVtf0WYNpzYQIw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqrZvL_FgrRA0_hZRsxXawqGTFF9atkeG0qqcT9RlrxA&oe=6AA0270C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "forest trailer.png", "id": "988047351647701", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/10000000_988047361647700_5249813252618530611_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fRIepWakUcAQ7kNvwEHCS7Y&_nc_oc=Adrjx0cLlcJzQ0rvgWzavQCMezI5UdsEG7jfPl5QMWa1wqAUVYw_VHcO6lRmk4o1tDc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbOelQ3VNh0GWGAiqvGwrnoNiP32zX4NZH_K_j_Tbe3Q&oe=6AA027CB"}, "display_name": "Solas VR", "keywords": ["Meditation", "Nature", "Productivity", "Relaxation", "Mindfulness"], "long_description": "Solas Meditation is the VR app that goes beyond meditation as we know it. With an immersive gallery of landscapes, nature sounds and guidance, Solas VR meditation replicates the real feeling of being out there, close to nature, enjoying the inner calmness we are made for. Bringing together eternal wisdom and cutting edge technology, Solas Meditation is designed for urban living, as a shield against stress, confusion and rush. The graphics and sounds, provided directly by nature, create a seamless multi-sensory experience, initiating a journey within. \nWith Solas Meditation you will feel more. You will do more. You will be more.", "short_description": "Add a new dimension to your meditation and allow nature to take you on a journey within. Solas VR presents a gallery of landscapes, nature sounds and guided meditations, designed to refresh your mind, spirit and soul.  This wonderful VR experience is the perfect micro break in nature that you can take while living an urban life.  Why settle with two dimensions, when you can have more? Why not dive inside your inner wisdom where you can be more?"}]}, "developer_name": "Virtual Reality Ireland Media Ltd.", "developer_privacy_policy_url": "https://www.solasvr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.solasvr.com/terms-of-service/", "publisher_name": "Tiesto Capital Ltd", "support_website_url": "https://www.solasvr.com/about/", "website_url": "https://www.solasvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphic
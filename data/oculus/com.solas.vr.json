jdroA0Q7kNvwHyeYhb&_nc_oc=AdpT2HatbcvLkGE28uDHJPeIVBgngew2lxwtD277ksWC94NwAIhBKs1xJHqDAGqEEaI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8Q3J8z2wVeoPEtOyPr6JBkYIcQBeNSILWrRltsMSHmA&oe=6AF203E8"}, {"file_name": "Glendalough lake.png", "id": "317898529368349", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036652_317898532701682_1088784562417673472_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v-s5yMFrZT0Q7kNvwGdrLO5&_nc_oc=AdryPlMX2MknMY64Qcea8PJ2MSout_wG2kjojFguIWHbJCRrXelMUAicx8Ck4OKSnmA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAUzn5Ec53jDubtXCeq2ez-4uuZ7-g9wgWzwe3ap_6VA&oe=6AF2029B"}, {"file_name": "Powerscourt waterfall.png", "id": "293387855349260", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75207237_293387858682593_3625796469231178237_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NbBqZhF92zwQ7kNvwHiTSm4&_nc_oc=Adrb0EmmVPhS3l4qyh9iZQNqoZTHLlhyAQ7Mz2ViSsMHxP9VxsqN9XZK1TL9CJxvshw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKOpwN7iNjWbl6_1dEiim6cuxHARoYrDeepTRKcH8tNg&oe=6AF1EE5A"}, {"file_name": "Beach wexford.png", "id": "290192465660275", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75222938_290192468993608_254672737452146756_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mFRxA8rr2h4Q7kNvwHQGbQs&_nc_oc=AdoZKXtIerVQxPchiP6IVwwDmRz_W5YVCDfRiwv8E-bOe6RlaAodkKuAnZt8BDZI-h0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEhc06wdWNrzit-HrcXybQjFmyZ-F-cZdvRMeyEYRpvA&oe=6AF1E40C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "forest trailer.png", "id": "988047351647701", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/10000000_988047361647700_5249813252618530611_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=02vwdoI8cpUQ7kNvwF0Ejmz&_nc_oc=AdpGWLM9i4daPpv60qZEOcTndfbOUAp2hq1deYx1dT61KZ7V_KWkcQTx-jIEaAu4e8A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5EHUXC8dfrc-8Bk4ink6prCqmJh06H-d0P3VFErONVw&oe=6AF1E4CB"}, "display_name": "Solas VR", "keywords": ["Meditation", "Nature", "Productivity", "Relaxation", "Mindfulness"], "long_description": "Solas Meditation is the VR app that goes beyond meditation as we know it. With an immersive gallery of landscapes, nature sounds and guidance, Solas VR meditation replicates the real feeling of being out there, close to nature, enjoying the inner calmness we are made for. Bringing together eternal wisdom and cutting edge technology, Solas Meditation is designed for urban living, as a shield against stress, confusion and rush. The graphics and sounds, provided directly by nature, create a seamless multi-sensory experience, initiating a journey within. \nWith Solas Meditation you will feel more. You will do more. You will be more.", "short_description": "Add a new dimension to your meditation and allow nature to take you on a journey within. Solas VR presents a gallery of landscapes, nature sounds and guided meditations, designed to refresh your mind, spirit and soul.  This wonderful VR experience is the perfect micro break in nature that you can take while living an urban life.  Why settle with two dimensions, when you can have more? Why not dive inside your inner wisdom where you can be more?"}]}, "developer_name": "Virtual Reality Ireland Media Ltd.", "developer_privacy_policy_url": "https://www.solasvr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.solasvr.com/terms-of-service/", "publisher_name": "Tiesto Capital Ltd", "support_website_url": "https://www.solasvr.com/about/", "website_url": "https://www.solasvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphic
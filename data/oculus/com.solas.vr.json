t0PoZ0Q7kNvwFTbDFG&_nc_oc=AdoYB_XdLXTTZ2OSfGpJ9efjAIYUZVNBgPYf6_qBYK_GlXNwa9Dwu6qQCjDSjh4vffU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKGP8oHlxUZf1uEt570jAQEPrwQbo_urfdlxlfvQVIxPg&oe=6AA6A628"}, {"file_name": "Glendalough lake.png", "id": "317898529368349", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036652_317898532701682_1088784562417673472_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eKUnuRO3ejQQ7kNvwFppqUd&_nc_oc=Adr2euQm_USv6j5bmtw_ktwmfW5g7Lv2cL5tf1BD4i3GoOiVLHKhhjWHT_Yl8XW918E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIq2aPV6hj4FLxXNfDhgr6NnKV8Rqhl25YeMfmkgbG9w&oe=6AA6A4DB"}, {"file_name": "Powerscourt waterfall.png", "id": "293387855349260", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75207237_293387858682593_3625796469231178237_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cXuYaiIRQfMQ7kNvwGMf2Zs&_nc_oc=AdpHEPgIapIOSBK9l9BfdLjXZLEQFLlmxOz5dIyEKP-WKkdnuT9_xrEaJrK4At1i6wg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLUdpYfjqfQLvp_4pk8eXnIuU1eO9InOaYz40EsbEUU6w&oe=6AA6909A"}, {"file_name": "Beach wexford.png", "id": "290192465660275", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75222938_290192468993608_254672737452146756_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CJdyr_p2eLYQ7kNvwFMLawI&_nc_oc=AdpN98jI_Y3TmW1VsSEHtraAgVgJDNq2TGB1xNvwA-ZC9HQrjZkUq69rxQIwkuXtfvw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5O3MdVnLgRO3mpRElZb233us-Oyw43U2xBJIad9p2Bg&oe=6AA6BE8C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "forest trailer.png", "id": "988047351647701", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/10000000_988047361647700_5249813252618530611_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kkFm5gMLEtoQ7kNvwGQJvz2&_nc_oc=Adr2u30cSKZ76NltrDMwMSJfqiQu0Q7ezpeOMWsGgrmVjh3yYN9J8Ch5e4IHjdeIa7E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3nlJk5CXS6L8lv3WY0zchvFP6G1PxtlU-p2dM5RdgeQ&oe=6AA6BF4B"}, "display_name": "Solas VR", "keywords": ["Meditation", "Nature", "Productivity", "Relaxation", "Mindfulness"], "long_description": "Solas Meditation is the VR app that goes beyond meditation as we know it. With an immersive gallery of landscapes, nature sounds and guidance, Solas VR meditation replicates the real feeling of being out there, close to nature, enjoying the inner calmness we are made for. Bringing together eternal wisdom and cutting edge technology, Solas Meditation is designed for urban living, as a shield against stress, confusion and rush. The graphics and sounds, provided directly by nature, create a seamless multi-sensory experience, initiating a journey within. \nWith Solas Meditation you will feel more. You will do more. You will be more.", "short_description": "Add a new dimension to your meditation and allow nature to take you on a journey within. Solas VR presents a gallery of landscapes, nature sounds and guided meditations, designed to refresh your mind, spirit and soul.  This wonderful VR experience is the perfect micro break in nature that you can take while living an urban life.  Why settle with two dimensions, when you can have more? Why not dive inside your inner wisdom where you can be more?"}]}, "developer_name": "Virtual Reality Ireland Media Ltd.", "developer_privacy_policy_url": "https://www.solasvr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.solasvr.com/terms-of-service/", "publisher_name": "Tiesto Capital Ltd", "support_website_url": "https://www.solasvr.com/about/", "website_url": "https://www.solasvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphic
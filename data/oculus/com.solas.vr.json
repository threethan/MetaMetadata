", "id": "293387855349260", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75207237_293387858682593_3625796469231178237_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0jgQiZ8YLE8Q7kNvwEWFotM&_nc_oc=Adox9zpqDZR2-FX3QdziHOentkBwEgTSHBMAjmngb7wZalVY7YGJPaTUyWi2Nxu2CjY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af31T-pvI45Av0Du3oZL9TkRRLwKs_-cXcz76EK9Qq84dQ&oe=69F1F31A"}, {"file_name": "Beach wexford.png", "id": "290192465660275", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75222938_290192468993608_254672737452146756_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0RKuCKmKWkUQ7kNvwFKqGsg&_nc_oc=AdoqrGwpUPzantSOUObXB5P8o3RA_bBT2vJAbZUFFyI2J8900aqLBk2O5RoWFaQ7xOk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1s14ict6K11FXMJY9yWlhQq0iGEXKZgugaWBymSylbCQ&oe=69F1E8CC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "forest trailer.png", "id": "988047351647701", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/10000000_988047361647700_5249813252618530611_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rEQLnBpC3xkQ7kNvwHhXM7H&_nc_oc=Ado80zuBy4i_Ro_SJzb4FaTPgRGwaD4sqTjkqirUnqa0USENK2UvZuE8A6PsouSdC5Q&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af1B8nKWwB_uAucXrCvVZmrA8z_DMY_vni_8svqAr7xrew&oe=69F1E98B"}, "display_name": "Solas VR", "keywords": ["Meditation", "Nature", "Productivity", "Relaxation", "Mindfulness"], "long_description": "Solas Meditation is the VR app that goes beyond meditation as we know it. With an immersive gallery of landscapes, nature sounds and guidance Solas VR mediation replicates the real feeling of being out there, close to nature, enjoying the inner calmness we are made for. Bringing together the eternal wisdom and cutting edge technology, Solas Meditation is designed for urban living, as a shield against stress, confusion and rush. The graphics and sounds, provided directly by nature, create a seamless multi-sensory experience, initiating a journey within.", "short_description": "Add a new dimension to your meditation and allow the nature to take you to a journey within. Solas VR Meditation presents a gallery of landscapes, nature sounds and guided meditations, designed to refresh your mind, spirit and soul.  This unprecedented VR experience is the best mini break you can take while living the urban life.  Why settle with two dimensions, when you can have more? Why not diving inside your inner wisdom when you can be more?"}]}, "developer_name": "Virtual Reality Ireland Media Ltd.", "developer_privacy_policy_url": "https://www.solasvr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.solasvr.com/terms-of-service/", "publisher_name": "Tiesto Capital Ltd", "support_website_url": "https://www.solasvr.com/about/", "website_url": "https://www.solasvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["RELAXATION_MEDITATION", "EXPERIENCE_360_NON_GAME", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "465459908569054"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1661203430724027"}]}, "baseline_offer": {"id": "1661203430724027"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1598547600, "status": "PUBLISHED", "id": "1661203430724027"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5003222123084837", "version": "1.1"}, "id": "2383505045281497", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "
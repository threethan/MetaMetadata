L_wUR8Q7kNvwGDm9pN&_nc_oc=Adrg-6EKFM3BLO2AR6_yfX1Su8CwyDYpgeQWjERo_5V0coVMiASqWe-rZMWxnoFpwtw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af16VRyVqd68Uh0t2UJREn2Q5ucTl1JLUrkRLT8R711Txw&oe=69EB7128"}, {"file_name": "Glendalough lake.png", "id": "317898529368349", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036652_317898532701682_1088784562417673472_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rJk5SAqU1ZEQ7kNvwGIt_zJ&_nc_oc=AdocGsl0IxGqaE09dviwCeJucHU2yTAFfmE_wi4tZqoC86nb9C8gKOh8A325q9-WR6g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1mJ8NyzlbNV5Nttd24QT-3hcjKrenw_ZIt95_S5APb6A&oe=69EB6FDB"}, {"file_name": "Powerscourt waterfall.png", "id": "293387855349260", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75207237_293387858682593_3625796469231178237_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c9VlypJMj2oQ7kNvwGkii8F&_nc_oc=AdpN7VhGao2pOXymyk1DLnR1u50ConjzJObJR6I3l6vr2UhcuF6uOublTvv3UvtUASU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2upIdydJPM3eKiLJgY09KEmavI9um0GoU88MGZgfQsPQ&oe=69EB5B9A"}, {"file_name": "Beach wexford.png", "id": "290192465660275", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75222938_290192468993608_254672737452146756_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wMCu01kEo3EQ7kNvwFnrlwb&_nc_oc=AdoV2rA4Y_k9QCjeiE5Ctt_F9XxbDalIrFM6ILJPehMd6-19_5LP3LhYiBmaIL3wiB0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1X1bpBiM2Q3_nDoae8p89o9BeZD2sLMlk6yYyzcJ8Vag&oe=69EB898C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "forest trailer.png", "id": "988047351647701", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/10000000_988047361647700_5249813252618530611_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FmGIrjVpDV8Q7kNvwElciuT&_nc_oc=AdqR31f8TQUIXN3V_w_AZtWKsPTy83PtR0zz9vo76T17UJAiR9254ZnfuwHdux63hmE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1c9yfvYmRvWSsrsb0QNNp57JLFK_rqRQwrwBWBm5xABQ&oe=69EB8A4B"}, "display_name": "Solas VR", "keywords": ["Meditation", "Nature", "Productivity", "Relaxation", "Mindfulness"], "long_description": "Solas Meditation is the VR app that goes beyond meditation as we know it. With an immersive gallery of landscapes, nature sounds and guidance, Solas VR meditation replicates the real feeling of being out there, close to nature, enjoying the inner calmness we are made for. Bringing together eternal wisdom and cutting edge technology, Solas Meditation is designed for urban living, as a shield against stress, confusion and rush. The graphics and sounds, provided directly by nature, create a seamless multi-sensory experience, initiating a journey within. \nWith Solas Meditation you will feel more. You will do more. You will be more.", "short_description": "Add a new dimension to your meditation and allow nature to take you on a journey within. Solas VR presents a gallery of landscapes, nature sounds and guided meditations, designed to refresh your mind, spirit and soul.  This wonderful VR experience is the perfect micro break in nature that you can take while living an urban life.  Why settle with two dimensions, when you can have more? Why not dive inside your inner wisdom where you can be more?"}]}, "developer_name": "Virtual Reality Ireland Media Ltd.", "developer_privacy_policy_url": "https://www.solasvr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.solasvr.com/terms-of-service/", "publisher_name": "Tiesto Capital Ltd", "support_website_url": "https://www.solasvr.com/about/", "website_url": "https://www.solasvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphic
YLEkd4Q7kNvwHPhwpc&_nc_oc=AdoL2wosSZgawmLSoA6jDE1eLnCWhmzmgqKs4Tx0xlAPHUHhP8rkpP6rYScZAZiAudk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyyqXIoyR8C0wNJfztkNNs6XAu6imxfBd8pj-X9fZWDOQ&oe=69D11328"}, {"file_name": "Glendalough lake.png", "id": "317898529368349", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036652_317898532701682_1088784562417673472_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O2xc5KdiEAIQ7kNvwGKLFHa&_nc_oc=AdopPBkZ1y-zqJERNMOg4z5I-1cNX-UMtJ8U-Qk0QWn23eF68IcsmQV7683IUFVIT5c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxFVi7bAq1bIVHuZpv8gyazx45Kuhp3l9C-2Q8g6CbN8g&oe=69D111DB"}, {"file_name": "Powerscourt waterfall.png", "id": "293387855349260", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75207237_293387858682593_3625796469231178237_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H6RePulO-lsQ7kNvwHRvcjH&_nc_oc=Ado_YG_XA4Lp_9lBw09hNhYbZj0WTBxUCooSYuRjK4cwfuvgmj_wFnwCvAtw7x7jeOI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxpH6f-5zaOaX8UNHscbqeGJc_pmGVf20uZ06Yvl71qpQ&oe=69D0FD9A"}, {"file_name": "Beach wexford.png", "id": "290192465660275", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75222938_290192468993608_254672737452146756_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3wbXHGerweQQ7kNvwEgClFX&_nc_oc=AdpB6hjPWEW9Sq0IBzaYMYIiGMx9c-6JOWO--GI1k8TjpHiXiv6HyWqYgsDrhkvvlAQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyPo2f50SOWgMO7Oxx7on08b5WLuvv2-PKjzuTRoLZ9Hw&oe=69D0F34C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "forest trailer.png", "id": "988047351647701", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/10000000_988047361647700_5249813252618530611_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qQoRgCFBl0QQ7kNvwEgJoi0&_nc_oc=AdqJGuZiy3SBvJI4zVsbXeVpUfni0qUUrqsxVBVWzST-ZbZHPfTWlkH1Pr-YBZi_cGY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxuzH__tElGPeb-hyWsXCSQrhpeuU_IGeCaI6FyTJavxA&oe=69D0F40B"}, "display_name": "Solas VR", "keywords": ["Meditation", "Nature", "Productivity", "Relaxation", "Mindfulness"], "long_description": "Solas Meditation is the VR app that goes beyond meditation as we know it. With an immersive gallery of landscapes, nature sounds and guidance, Solas VR meditation replicates the real feeling of being out there, close to nature, enjoying the inner calmness we are made for. Bringing together eternal wisdom and cutting edge technology, Solas Meditation is designed for urban living, as a shield against stress, confusion and rush. The graphics and sounds, provided directly by nature, create a seamless multi-sensory experience, initiating a journey within. \nWith Solas Meditation you will feel more. You will do more. You will be more.", "short_description": "Add a new dimension to your meditation and allow nature to take you on a journey within. Solas VR presents a gallery of landscapes, nature sounds and guided meditations, designed to refresh your mind, spirit and soul.  This wonderful VR experience is the perfect micro break in nature that you can take while living an urban life.  Why settle with two dimensions, when you can have more? Why not dive inside your inner wisdom where you can be more?"}]}, "developer_name": "Virtual Reality Ireland Media Ltd.", "developer_privacy_policy_url": "https://www.solasvr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.solasvr.com/terms-of-service/", "publisher_name": "Tiesto Capital Ltd", "support_website_url": "https://www.solasvr.com/about/", "website_url": "https://www.solasvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphic
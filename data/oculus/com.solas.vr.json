jav60AQ7kNvwFiIIlq&_nc_oc=AdqPr5e_7-JCvIg0yQ5oWTHsvgz7AEvQKeStNDUhyK0rrrAoP43-0QurG3TwQcenlyA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Qy8wqKBkt9NDG0xr1qJC0seLqNhHG5m0gsLQ1rd8kSA&oe=6A33F3A8"}, {"file_name": "Glendalough lake.png", "id": "317898529368349", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036652_317898532701682_1088784562417673472_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aOItEK7huRUQ7kNvwH-iAsX&_nc_oc=Adp8Lp0SJFeQl7pAB7SWRMu_eFdONK6rO-g3eKF9ECZafvIzmOsJsr1sXA9gxUWZ0eE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Q9V-PO2RYZew3crgyrDQgojB3swBaJ3bqAMT3kKRS8g&oe=6A33F25B"}, {"file_name": "Powerscourt waterfall.png", "id": "293387855349260", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75207237_293387858682593_3625796469231178237_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3xkvimJ5zRwQ7kNvwEfWCOD&_nc_oc=AdqWqHcRkax_SIMhR_8ky7zNMbo4BxvxTwBhlRy15_ntdmqwyuRcZ9tUQNA9QdLqjNc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-srxsL98Zb4Glx8Hy80KReGhCz0ONEk_XdbNCQvbFchA&oe=6A34165A"}, {"file_name": "Beach wexford.png", "id": "290192465660275", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75222938_290192468993608_254672737452146756_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T1CJ_tlmI28Q7kNvwF2o_HG&_nc_oc=AdpWmFelBPEZd3kuC_wpE7u4NfLXSje1u11IWpe0y6SmBkTDGwsgKwlX91HBPAGHxTE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-KhlJU-EIDrhnBcALGDNyg0ghop2j5YZOQfaw9NcNkDg&oe=6A340C0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "forest trailer.png", "id": "988047351647701", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/10000000_988047361647700_5249813252618530611_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kzIJcuuI5iMQ7kNvwEvJj3S&_nc_oc=AdqDDoIyV1mPciexBuTR1sDmaHIoSFf9WOun_oWPwgGSW3yvwsLllINqzNnCf-sIpuQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6aDZrJEpFRUyVeCDLDSO9sX5im_fKXKvXdIpmni6rTA&oe=6A340CCB"}, "display_name": "Solas VR", "keywords": ["Meditation", "Nature", "Productivity", "Relaxation", "Mindfulness"], "long_description": "Solas Meditation is the VR app that goes beyond meditation as we know it. With an immersive gallery of landscapes, nature sounds and guidance, Solas VR meditation replicates the real feeling of being out there, close to nature, enjoying the inner calmness we are made for. Bringing together eternal wisdom and cutting edge technology, Solas Meditation is designed for urban living, as a shield against stress, confusion and rush. The graphics and sounds, provided directly by nature, create a seamless multi-sensory experience, initiating a journey within. \nWith Solas Meditation you will feel more. You will do more. You will be more.", "short_description": "Add a new dimension to your meditation and allow nature to take you on a journey within. Solas VR presents a gallery of landscapes, nature sounds and guided meditations, designed to refresh your mind, spirit and soul.  This wonderful VR experience is the perfect micro break in nature that you can take while living an urban life.  Why settle with two dimensions, when you can have more? Why not dive inside your inner wisdom where you can be more?"}]}, "developer_name": "Virtual Reality Ireland Media Ltd.", "developer_privacy_policy_url": "https://www.solasvr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.solasvr.com/terms-of-service/", "publisher_name": "Tiesto Capital Ltd", "support_website_url": "https://www.solasvr.com/about/", "website_url": "https://www.solasvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphic
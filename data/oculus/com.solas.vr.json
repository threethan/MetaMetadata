nqpG5IQ7kNvwGJTJNc&_nc_oc=Adrg0UbpbVPWnQMq3loU3_WWRg-2ZRyjOXb-AMQV7fTvVQ5QJmqWUdahkLGWSeu_-TI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTu6tSK9FLscvUozLfTCVBNODajantmSnW4Kcb2zpe6cw&oe=6AF9ECE8"}, {"file_name": "Glendalough lake.png", "id": "317898529368349", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036652_317898532701682_1088784562417673472_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MNLFYvKW-3gQ7kNvwH4lB8O&_nc_oc=AdqcjVVg62BqrWSCiSpxOYeq9RyaUD_CAFqG-e39I6oDu6PbXTcMHkvsc3F57lUrWHE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHYnvJd2LsNCmS03afz_P_XKciW1nzI_5Y7yumBCJBiA&oe=6AF9EB9B"}, {"file_name": "Powerscourt waterfall.png", "id": "293387855349260", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75207237_293387858682593_3625796469231178237_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vXdGve5NM1AQ7kNvwGASh-B&_nc_oc=Adr-zZU0DEy2R4cUfsdwtVluZ5IbqLC2Jx1kpluRvxb-38FQrcGR4rXxa5rIcPfM77Q&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-ooA-R4Le-urwlISHmQD_5R-087cCPcmJiSXtalwjZg&oe=6AF9D75A"}, {"file_name": "Beach wexford.png", "id": "290192465660275", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75222938_290192468993608_254672737452146756_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=96ac0oxoSBUQ7kNvwFRoW3Q&_nc_oc=Adoq5WqGSX1ja25cmpcS-jiAf1FON4dei6kLRsUMo4PjmeuIQgCCoSxDsUgCsS03kUY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnASjRgEv14A8gSaQdgK9-_x0pTjFh3rEB49YmrAX-EQ&oe=6AF9CD0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "forest trailer.png", "id": "988047351647701", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/10000000_988047361647700_5249813252618530611_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9jBt-FV6VYwQ7kNvwH09mhD&_nc_oc=AdrmbSe3TLvwKMqDjXjACJwH748JaOb-ZaqNcaN0xhS56cLftxOYFtNgYaN_jvkQqmE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVjFhRfdbmPI1Iis4njILfyS34nHGeDwkLg_Fxet3mDQ&oe=6AF9CDCB"}, "display_name": "Solas VR", "keywords": ["Meditation", "Nature", "Productivity", "Relaxation", "Mindfulness"], "long_description": "Solas Meditation is the VR app that goes beyond meditation as we know it. With an immersive gallery of landscapes, nature sounds and guidance, Solas VR meditation replicates the real feeling of being out there, close to nature, enjoying the inner calmness we are made for. Bringing together eternal wisdom and cutting edge technology, Solas Meditation is designed for urban living, as a shield against stress, confusion and rush. The graphics and sounds, provided directly by nature, create a seamless multi-sensory experience, initiating a journey within. \nWith Solas Meditation you will feel more. You will do more. You will be more.", "short_description": "Add a new dimension to your meditation and allow nature to take you on a journey within. Solas VR presents a gallery of landscapes, nature sounds and guided meditations, designed to refresh your mind, spirit and soul.  This wonderful VR experience is the perfect micro break in nature that you can take while living an urban life.  Why settle with two dimensions, when you can have more? Why not dive inside your inner wisdom where you can be more?"}]}, "developer_name": "Virtual Reality Ireland Media Ltd.", "developer_privacy_policy_url": "https://www.solasvr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.solasvr.com/terms-of-service/", "publisher_name": "Tiesto Capital Ltd", "support_website_url": "https://www.solasvr.com/about/", "website_url": "https://www.solasvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphic
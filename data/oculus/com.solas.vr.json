8sHWOsQ7kNvwE2tAb0&_nc_oc=Adruzx_SIK1trCs4_p_OXTWpiyHYQyfajRkjQFe7SbJ3qxyT_wJAViDjBQ5OhKk-sL4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af59VtbQKa4sRLk5jPoaBvKlVEyaXf5or_KmMaIqU2v5CQ&oe=6A032C28"}, {"file_name": "Glendalough lake.png", "id": "317898529368349", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036652_317898532701682_1088784562417673472_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i59UPCpC9E4Q7kNvwHP692N&_nc_oc=AdpdTez4Blkc6yIAXsqauucfZZuZ1g4UvExdToQMUmm8lN1dEZqJfoa6OEYJpebrjs4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7WWWN-uEyOIHq8GZ67wmcQXPuV-ldzcsNtW7g7OB9-yg&oe=6A032ADB"}, {"file_name": "Powerscourt waterfall.png", "id": "293387855349260", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75207237_293387858682593_3625796469231178237_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LddWSmfkbbcQ7kNvwHnFIPu&_nc_oc=AdpWrW8xmadnJ_2PXWVdNY-9zOqmbUUIl_pzLtH0QZKigR_dy6Rwlv08doONChLEUCQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qXXf3DeGRX0-V2D4NgZQHbIAJ7d9lZqZE5ZrEXnEIiQ&oe=6A03169A"}, {"file_name": "Beach wexford.png", "id": "290192465660275", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75222938_290192468993608_254672737452146756_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1z1G5Ip19sIQ7kNvwEGwjK5&_nc_oc=Ado6192kzrBtFThXu96UfUKE0-wx6wihR5QF-necN7r3evHPTmE_TagqM1pSvzJwbuI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af75B3PHZbC8tpAbd8LrMY86iXziWO0hJU4TPVpuR4z7eg&oe=6A03448C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "forest trailer.png", "id": "988047351647701", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/10000000_988047361647700_5249813252618530611_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=URvOaoYUxXgQ7kNvwE2e1ZU&_nc_oc=AdpK8MGUlt-CRN1FeCQBoahwFN_kTM4JgLAhTBtwox3J92Mb1CTN7Aje-QbU1B1psuA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af62H8AhUWkL3bCHaDBwaRQolA7G9yTv-b25eCG_a5duQQ&oe=6A03454B"}, "display_name": "Solas VR", "keywords": ["Meditation", "Nature", "Productivity", "Relaxation", "Mindfulness"], "long_description": "Solas Meditation is the VR app that goes beyond meditation as we know it. With an immersive gallery of landscapes, nature sounds and guidance, Solas VR meditation replicates the real feeling of being out there, close to nature, enjoying the inner calmness we are made for. Bringing together eternal wisdom and cutting edge technology, Solas Meditation is designed for urban living, as a shield against stress, confusion and rush. The graphics and sounds, provided directly by nature, create a seamless multi-sensory experience, initiating a journey within. \nWith Solas Meditation you will feel more. You will do more. You will be more.", "short_description": "Add a new dimension to your meditation and allow nature to take you on a journey within. Solas VR presents a gallery of landscapes, nature sounds and guided meditations, designed to refresh your mind, spirit and soul.  This wonderful VR experience is the perfect micro break in nature that you can take while living an urban life.  Why settle with two dimensions, when you can have more? Why not dive inside your inner wisdom where you can be more?"}]}, "developer_name": "Virtual Reality Ireland Media Ltd.", "developer_privacy_policy_url": "https://www.solasvr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.solasvr.com/terms-of-service/", "publisher_name": "Tiesto Capital Ltd", "support_website_url": "https://www.solasvr.com/about/", "website_url": "https://www.solasvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphic
PvhUcMQ7kNvwEx6P0d&_nc_oc=Adpj0lhiJRTsckrBAyblipWu6CAMG7k0D1_awCe1Pc4GSEQHyy2t-0K05B4euhIAaNc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDTQQW-VruPW9WX7IrGPPCJICDBNUFDJs4Y0nTW43qXSw&oe=6A5B80A8"}, {"file_name": "Glendalough lake.png", "id": "317898529368349", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036652_317898532701682_1088784562417673472_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wm6ua-MonNgQ7kNvwH2qPdq&_nc_oc=Ado_LoDwcVfKfllnngj0tb9bZQDQtnJapTOK0_hXozMzOTgWOQhSQ_SMqtybGznA9tc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCvosbvqck28388DHInur1Ng359jYQznU7goz7gst2gGA&oe=6A5B7F5B"}, {"file_name": "Powerscourt waterfall.png", "id": "293387855349260", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75207237_293387858682593_3625796469231178237_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gSRL5dG6BKoQ7kNvwE9NZ4q&_nc_oc=AdoWCyTtOiRsPKH94L9TyaMWmv9biQyuSPEzFu8zA3iaFEXzQ2WqAm9YF9l3YbHI4gs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCNheym58w93ec4cwnuNbWmX_te3uuJCqX7vrFqCQffrg&oe=6A5B6B1A"}, {"file_name": "Beach wexford.png", "id": "290192465660275", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75222938_290192468993608_254672737452146756_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dkwzwOIBRUUQ7kNvwF0ouy6&_nc_oc=AdqhpoChDOrEKkLVcFDJRamBjOY44tc9JFODzq8z7NDqfstGju3ZFpFLXTWPFYtF7sQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCk05C9W9NkZHGdtWswKXNOd6QVdsYQLBxANGHjJ97CzA&oe=6A5B60CC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "forest trailer.png", "id": "988047351647701", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/10000000_988047361647700_5249813252618530611_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ahtYADm7fDsQ7kNvwF738Ky&_nc_oc=AdorpOwOWE8v7hL5UAk8g5DdxpSLIj1gf1nrKMBLOWbFQqJJZfh-dnpRlaTchIxk5ic&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAcyFjlpjPnMrx2wbs89Lo5sYAVJVTvPUjMibpDy2XDtA&oe=6A5B618B"}, "display_name": "Solas VR", "keywords": ["Meditation", "Nature", "Productivity", "Relaxation", "Mindfulness"], "long_description": "Solas Meditation is the VR app that goes beyond meditation as we know it. With an immersive gallery of landscapes, nature sounds and guidance, Solas VR meditation replicates the real feeling of being out there, close to nature, enjoying the inner calmness we are made for. Bringing together eternal wisdom and cutting edge technology, Solas Meditation is designed for urban living, as a shield against stress, confusion and rush. The graphics and sounds, provided directly by nature, create a seamless multi-sensory experience, initiating a journey within. \nWith Solas Meditation you will feel more. You will do more. You will be more.", "short_description": "Add a new dimension to your meditation and allow nature to take you on a journey within. Solas VR presents a gallery of landscapes, nature sounds and guided meditations, designed to refresh your mind, spirit and soul.  This wonderful VR experience is the perfect micro break in nature that you can take while living an urban life.  Why settle with two dimensions, when you can have more? Why not dive inside your inner wisdom where you can be more?"}]}, "developer_name": "Virtual Reality Ireland Media Ltd.", "developer_privacy_policy_url": "https://www.solasvr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.solasvr.com/terms-of-service/", "publisher_name": "Tiesto Capital Ltd", "support_website_url": "https://www.solasvr.com/about/", "website_url": "https://www.solasvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphic
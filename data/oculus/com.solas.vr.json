BNk4FgQ7kNvwFj6Snq&_nc_oc=AdqG73Vm2ZwciSMegl8UBO_F8XCMtzshgDweUGDap82wEF8edZz5E6Vrhy7rdXCk7-0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7xh0HUX07gu9ZRozl-MDn4i7S-OVGIXcL5it3vj3lDqw&oe=6A0C66A8"}, {"file_name": "Glendalough lake.png", "id": "317898529368349", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39036652_317898532701682_1088784562417673472_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KFd9hjW2XG8Q7kNvwGfb2al&_nc_oc=AdrEmENgCLwgTdls2jb54Q85f-wa2nr0zpOow1ZLEChVPLbVV_DcIK9eXHY1tcu_law&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7KXTmNhn3QMSWFghZTxzVsfbL9h33FI57fwScaBx6h4g&oe=6A0C655B"}, {"file_name": "Powerscourt waterfall.png", "id": "293387855349260", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75207237_293387858682593_3625796469231178237_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EU5BCcBwjEEQ7kNvwFXeQi-&_nc_oc=AdqAJEvBlmE_TOPiRKs8GoUPWiOWK5Ee4mw4GYlzjKBeZv_rf5RK25Jck_t2TJ1kbLU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6TDoET2XMJ4TNJOHb_H27gu4bWYU6dP9yz0eSUe4AdJQ&oe=6A0C895A"}, {"file_name": "Beach wexford.png", "id": "290192465660275", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75222938_290192468993608_254672737452146756_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xyt7lHsMrjcQ7kNvwH9EZRq&_nc_oc=Adomgj4dFJ1g2uriPbTDFCN_dPOqLwjXeamYZcO35CgUIdXwlp6EEUQvqF-VB1yT-Xk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Ozo5bs2uNdPkINkZzlPP2zqmilZEx-MT4o1oMiEKFGA&oe=6A0C7F0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "forest trailer.png", "id": "988047351647701", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/10000000_988047361647700_5249813252618530611_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=veJL1PS2BlQQ7kNvwEYP3sK&_nc_oc=AdpsrqcP2wqqw8gAWvsuBvjg4KIMNVrCSKGJVpT-HquyjHHj6XAggSlPjkZzwMDEDF0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4X1Yiohtb83w7Zf7vBDNc7yzpu4sDDqkUVoR7pXR0KOA&oe=6A0C7FCB"}, "display_name": "Solas VR", "keywords": ["Meditation", "Nature", "Productivity", "Relaxation", "Mindfulness"], "long_description": "Solas Meditation is the VR app that goes beyond meditation as we know it. With an immersive gallery of landscapes, nature sounds and guidance, Solas VR meditation replicates the real feeling of being out there, close to nature, enjoying the inner calmness we are made for. Bringing together eternal wisdom and cutting edge technology, Solas Meditation is designed for urban living, as a shield against stress, confusion and rush. The graphics and sounds, provided directly by nature, create a seamless multi-sensory experience, initiating a journey within. \nWith Solas Meditation you will feel more. You will do more. You will be more.", "short_description": "Add a new dimension to your meditation and allow nature to take you on a journey within. Solas VR presents a gallery of landscapes, nature sounds and guided meditations, designed to refresh your mind, spirit and soul.  This wonderful VR experience is the perfect micro break in nature that you can take while living an urban life.  Why settle with two dimensions, when you can have more? Why not dive inside your inner wisdom where you can be more?"}]}, "developer_name": "Virtual Reality Ireland Media Ltd.", "developer_privacy_policy_url": "https://www.solasvr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.solasvr.com/terms-of-service/", "publisher_name": "Tiesto Capital Ltd", "support_website_url": "https://www.solasvr.com/about/", "website_url": "https://www.solasvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphic
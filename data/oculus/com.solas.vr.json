S4WabQQ7kNvwEdZlLQ&_nc_oc=AdqIOoxsdV9YBgjv0ojKlFnBLfwyopXmZWAbaGzxm71bYJa0xedAiXKt8TIrM7x0bCI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjH3wo7c83kD_HoKuDbpIU1THVEQ2qOslAs-8AAv3LwA&oe=6AAFE0A8"}, {"file_name": "Glendalough lake.png", "id": "317898529368349", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036652_317898532701682_1088784562417673472_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pRX1dBXsEAQQ7kNvwHHIkof&_nc_oc=AdpuvXF1jvXBK9MByRGhsq3ZqKgwSZJo1R3Xl3GkZcstufg_XQuu0rRDf3Il7jIXQuk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0piE2zNr48X7nN9CRt3dIo7SNJmt9-eJ2C5tshIfPkA&oe=6AAFDF5B"}, {"file_name": "Powerscourt waterfall.png", "id": "293387855349260", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75207237_293387858682593_3625796469231178237_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v9ZxI2DOPeIQ7kNvwGkuub5&_nc_oc=Adr5iWX4jPLfwN7C1Ug2x4yyvPFz9Txgucg9tfEVbAU8InREBamxelLKvt3hHPDgJ_8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFO4EPDCo77HEOAMBrWaJBGxMC8QGvMFRArBcs7vof3g&oe=6AB0035A"}, {"file_name": "Beach wexford.png", "id": "290192465660275", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75222938_290192468993608_254672737452146756_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aFamcVpyjPIQ7kNvwFzKvXu&_nc_oc=Adr16fa8MViT_L5jN5E3c3qJAiGY-993dZPrWZz7nXZcNFbVSustXiYtfZ43LbdDxjk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKleY_z8CQdqgijyrvQQFSfKyqAP61Qfwu78D4n69NwnA&oe=6AAFF90C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "forest trailer.png", "id": "988047351647701", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/10000000_988047361647700_5249813252618530611_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LT3Pmuva4YQQ7kNvwGtWYt3&_nc_oc=AdrfbrjTDutM24ZSMlFOJbjd75hQRbFkBWFnJWOt7MMMwU8qqG7_JJ5FySIg1xLWZ_c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLhGTRiGv5iZD9lgCg1OoiNcFh7lGv7eo6d7xc1hlopfw&oe=6AAFF9CB"}, "display_name": "Solas VR", "keywords": ["Meditation", "Nature", "Productivity", "Relaxation", "Mindfulness"], "long_description": "Solas Meditation is the VR app that goes beyond meditation as we know it. With an immersive gallery of landscapes, nature sounds and guidance, Solas VR meditation replicates the real feeling of being out there, close to nature, enjoying the inner calmness we are made for. Bringing together eternal wisdom and cutting edge technology, Solas Meditation is designed for urban living, as a shield against stress, confusion and rush. The graphics and sounds, provided directly by nature, create a seamless multi-sensory experience, initiating a journey within. \nWith Solas Meditation you will feel more. You will do more. You will be more.", "short_description": "Add a new dimension to your meditation and allow nature to take you on a journey within. Solas VR presents a gallery of landscapes, nature sounds and guided meditations, designed to refresh your mind, spirit and soul.  This wonderful VR experience is the perfect micro break in nature that you can take while living an urban life.  Why settle with two dimensions, when you can have more? Why not dive inside your inner wisdom where you can be more?"}]}, "developer_name": "Virtual Reality Ireland Media Ltd.", "developer_privacy_policy_url": "https://www.solasvr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.solasvr.com/terms-of-service/", "publisher_name": "Tiesto Capital Ltd", "support_website_url": "https://www.solasvr.com/about/", "website_url": "https://www.solasvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphic
F0E-nsQ7kNvwHS1RPP&_nc_oc=AdqZy2MRIQ2WXzO88MADsMAEafEGElpM26AEoe2TdZS8y_VNG1Sg_JlAAY9xxzfT7tc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4qO9tSi6tC2Vt1T_ZnhAQ5WYtnH9PtQbUYOUNbIGaKRw&oe=69F9F1A8"}, {"file_name": "Glendalough lake.png", "id": "317898529368349", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036652_317898532701682_1088784562417673472_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o3AyrGvRLTcQ7kNvwHBRdP5&_nc_oc=AdpU794i5TD5AEe1uLwj0FsPBzsJnFBNVuBoMC7GP68-RYbcFThkwRjK55DQAKcmbJ0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ERuh8EIRXF_2OVnCrllzSQqijmKL7hXgQKKfGrCGP1A&oe=69F9F05B"}, {"file_name": "Powerscourt waterfall.png", "id": "293387855349260", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75207237_293387858682593_3625796469231178237_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2vdQxqgCKzgQ7kNvwEsesmt&_nc_oc=AdqSByC-T5pDvPdIEtNf5Kelrfys2H_JDS2P1nwA8uuycfadXr5T2Nct_lULuSbHw8c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af63vY4u5N5LjuaLBn-1C9jHHVvVJ_5ZwfcPLZeOrFKoqA&oe=69FA145A"}, {"file_name": "Beach wexford.png", "id": "290192465660275", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75222938_290192468993608_254672737452146756_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L1ELKChciPMQ7kNvwGpgRta&_nc_oc=Adqljs96cgt_04jxvdJHPD2PZ-iQjLnEk0mR_PYHbZ_h_NwD5eou0QJomcE2-RkCYnI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5VEsj7M3YAiM3evRHSZoAAXxYilUyZlSRQaD2HaH-y9Q&oe=69FA0A0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "forest trailer.png", "id": "988047351647701", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/10000000_988047361647700_5249813252618530611_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gz-d7Rq31jgQ7kNvwGUbKRv&_nc_oc=Adqo1jeKuaHQk5xE_Bt0CdDRj7jKExmK6sYYZjjoojf6F4YPE98ukwpuK-UmQVZ17jU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68pmm5V5xKM0xVVDe4bBz3AtDNgYOSn2D8GIiUOpZVjA&oe=69FA0ACB"}, "display_name": "Solas VR", "keywords": ["Meditation", "Nature", "Productivity", "Relaxation", "Mindfulness"], "long_description": "Solas Meditation is the VR app that goes beyond meditation as we know it. With an immersive gallery of landscapes, nature sounds and guidance, Solas VR meditation replicates the real feeling of being out there, close to nature, enjoying the inner calmness we are made for. Bringing together eternal wisdom and cutting edge technology, Solas Meditation is designed for urban living, as a shield against stress, confusion and rush. The graphics and sounds, provided directly by nature, create a seamless multi-sensory experience, initiating a journey within. \nWith Solas Meditation you will feel more. You will do more. You will be more.", "short_description": "Add a new dimension to your meditation and allow nature to take you on a journey within. Solas VR presents a gallery of landscapes, nature sounds and guided meditations, designed to refresh your mind, spirit and soul.  This wonderful VR experience is the perfect micro break in nature that you can take while living an urban life.  Why settle with two dimensions, when you can have more? Why not dive inside your inner wisdom where you can be more?"}]}, "developer_name": "Virtual Reality Ireland Media Ltd.", "developer_privacy_policy_url": "https://www.solasvr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.solasvr.com/terms-of-service/", "publisher_name": "Tiesto Capital Ltd", "support_website_url": "https://www.solasvr.com/about/", "website_url": "https://www.solasvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphic
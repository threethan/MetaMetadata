_zmW_IQ7kNvwGpZjc8&_nc_oc=AdpdK96o-DbLa_uBeIZsTKVY_een44_ZqZ0PX6ysySPpdLWz70-I9KuaVO6DkL-vlXQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVLKm9dmFuHlhr5Z8sQ0runTILuj8FbCErGzy8Hk-xOg&oe=6A806AA8"}, {"file_name": "Glendalough lake.png", "id": "317898529368349", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39036652_317898532701682_1088784562417673472_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KIo2bZySjTwQ7kNvwGGQmG8&_nc_oc=Ado8fey6RNkF3oLHfkTaTrS_i-ft6xwlyzHSOFpyBRZUrmvDxUSugGEqWSdeWBik5yo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHiYSkieN3WET3ZeSuMZq5U8vDsd81RYsPPqjEmYKeyrA&oe=6A80695B"}, {"file_name": "Powerscourt waterfall.png", "id": "293387855349260", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75207237_293387858682593_3625796469231178237_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U4TGW7PxdDYQ7kNvwFaNUaM&_nc_oc=Adp45tS2cmon4r21jsktuC0Jx29PUwwUdC-SeKGmNLTSmugEb47bMiEJBiuYpFf-1sw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGx0bdIRQKeghRAXf1iM6bNtihviVG3TJ9rdKKjLaxh6A&oe=6A80551A"}, {"file_name": "Beach wexford.png", "id": "290192465660275", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75222938_290192468993608_254672737452146756_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ajpyxjRIWooQ7kNvwG-DIRT&_nc_oc=Adp1j8eF8ZWLegG8hj2tVwHvVlpOvAe4wY_bweeAuHTk4QvR-nEBUNHu0tS1i1VQJdo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG3XQ4_QyMgaPvX5VrN6aXqB8yH7joWHgEY-W8HlhkR9A&oe=6A804ACC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "forest trailer.png", "id": "988047351647701", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/10000000_988047361647700_5249813252618530611_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pOfZxG2xsWAQ7kNvwHgEzhg&_nc_oc=Ado_C1MbkLJtzmptAinPXrN4id0M4-AIUlyMXJs_tr4rlXlq0BVzUW6X0ZH30-LQh1I&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEjkiyquBKJ_Myycy7wu16ehVfuUHShR9-JmAF6srSmNA&oe=6A804B8B"}, "display_name": "Solas VR", "keywords": ["Meditation", "Nature", "Productivity", "Relaxation", "Mindfulness"], "long_description": "Solas Meditation is the VR app that goes beyond meditation as we know it. With an immersive gallery of landscapes, nature sounds and guidance, Solas VR meditation replicates the real feeling of being out there, close to nature, enjoying the inner calmness we are made for. Bringing together eternal wisdom and cutting edge technology, Solas Meditation is designed for urban living, as a shield against stress, confusion and rush. The graphics and sounds, provided directly by nature, create a seamless multi-sensory experience, initiating a journey within. \nWith Solas Meditation you will feel more. You will do more. You will be more.", "short_description": "Add a new dimension to your meditation and allow nature to take you on a journey within. Solas VR presents a gallery of landscapes, nature sounds and guided meditations, designed to refresh your mind, spirit and soul.  This wonderful VR experience is the perfect micro break in nature that you can take while living an urban life.  Why settle with two dimensions, when you can have more? Why not dive inside your inner wisdom where you can be more?"}]}, "developer_name": "Virtual Reality Ireland Media Ltd.", "developer_privacy_policy_url": "https://www.solasvr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.solasvr.com/terms-of-service/", "publisher_name": "Tiesto Capital Ltd", "support_website_url": "https://www.solasvr.com/about/", "website_url": "https://www.solasvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphic
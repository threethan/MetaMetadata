_ohc=0FTBCF9wyIAQ7kNvwHe3Q7q&_nc_oc=AdqQtK2ugXCdWahL6cgHOsxvhXkIZZEKZCdQDzMtFtPmTFngYf04SYOJ4n-HAWxO7Aw&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJaVk2NrOp1z4BVZ_mWr7Y6cTZZDpX3AjFiPFmT2hqatQ&oe=6AA40328"}, {"file_name": "Glendalough lake.png", "id": "317898529368349", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39036652_317898532701682_1088784562417673472_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jqKsqcOPs6YQ7kNvwET6bqu&_nc_oc=AdponaOPDj8GZ8LNhwUiXrVK0rKK_bZ9295vUZaEzBGDvCN7xR3GGGN3vSxrylaYQAQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIeYbftY1p5zqSktN7zmeqszFabHl_a0cGbBKQHdU-yTg&oe=6AA401DB"}, {"file_name": "Powerscourt waterfall.png", "id": "293387855349260", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75207237_293387858682593_3625796469231178237_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ivlFgpFMyk0Q7kNvwHqzHUW&_nc_oc=Adp0V7iG7jpCGLObXDIovHzwKotcFbaBlk6-Qha7vr0IpOsI7eiR_dPPJ0Ii5OR3mKE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3BwuFbcvxDdyAaaHdOZy_iz3oyULmnHOXbLLlrpBEmA&oe=6AA425DA"}, {"file_name": "Beach wexford.png", "id": "290192465660275", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75222938_290192468993608_254672737452146756_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RgjXWvn4KMQQ7kNvwEc8UeP&_nc_oc=AdoRi1aqMriioLHhkZ893zxqsh4avkXSiaKYri9woodxoakCqP4vniy5mwFqXX220pU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI__13ejlqM9KgLbV_W_AmJ7Fxf3TVMSzBXKwH6G-HFLA&oe=6AA41B8C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "forest trailer.png", "id": "988047351647701", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/10000000_988047361647700_5249813252618530611_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=64_TK5Lfj-IQ7kNvwGncxD1&_nc_oc=AdpB_FaF9OqPdUscZZ2oaeuD_6sU9zT6uBbRVASMSK5r2_TYZDEr-bZBXRKJvU5FRKg&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJmnLLKNpBKOTKBlPK1_3-Kz6z-rQPZ1BtLhPdxHSX6Rg&oe=6AA41C4B"}, "display_name": "Solas VR", "keywords": ["Meditation", "Nature", "Productivity", "Relaxation", "Mindfulness"], "long_description": "Solas Meditation is the VR app that goes beyond meditation as we know it. With an immersive gallery of landscapes, nature sounds and guidance, Solas VR meditation replicates the real feeling of being out there, close to nature, enjoying the inner calmness we are made for. Bringing together eternal wisdom and cutting edge technology, Solas Meditation is designed for urban living, as a shield against stress, confusion and rush. The graphics and sounds, provided directly by nature, create a seamless multi-sensory experience, initiating a journey within. \nWith Solas Meditation you will feel more. You will do more. You will be more.", "short_description": "Add a new dimension to your meditation and allow nature to take you on a journey within. Solas VR presents a gallery of landscapes, nature sounds and guided meditations, designed to refresh your mind, spirit and soul.  This wonderful VR experience is the perfect micro break in nature that you can take while living an urban life.  Why settle with two dimensions, when you can have more? Why not dive inside your inner wisdom where you can be more?"}]}, "developer_name": "Virtual Reality Ireland Media Ltd.", "developer_privacy_policy_url": "https://www.solasvr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.solasvr.com/terms-of-service/", "publisher_name": "Tiesto Capital Ltd", "support_website_url": "https://www.solasvr.com/about/", "website_url": "https://www.solasvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "rec
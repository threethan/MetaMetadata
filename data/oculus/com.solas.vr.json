18TbqYQ7kNvwFf-U53&_nc_oc=AdoPYRAjgKgWWBkYyLIb1P_IViiHK0iPkeJht8VsZftHLcmZouQi7-S-MCtG-spMBeY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96JQsmqJ_d5EzPqgSEwY82gDvXQgQHwrfEITad1VJq2w&oe=6A3E7FA8"}, {"file_name": "Glendalough lake.png", "id": "317898529368349", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036652_317898532701682_1088784562417673472_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=am-rnJFCp0sQ7kNvwE94NBf&_nc_oc=Adrx1yw5sYPwJWjoIoxd5OQYe7fGozKk0iozXjSnW4AX4ua1rCkAJPXK-5BA82Lx6-w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9lqgEeVRY-iezxBPt7bLnPwV0zwK7FrauHRnw70hnOEw&oe=6A3E7E5B"}, {"file_name": "Powerscourt waterfall.png", "id": "293387855349260", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75207237_293387858682593_3625796469231178237_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eFcT21n1-CIQ7kNvwGtaafD&_nc_oc=AdpVK-mrtzb9-I-qrXz0GWPdUIFFURtgKQGusbp9nNN0sPSDvxfp6HpGvwSHBzYFt-8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ueTO7Cp-r7k8d0Wk24Ll9ffYdJpZufsoP0O4ZHS82lQ&oe=6A3EA25A"}, {"file_name": "Beach wexford.png", "id": "290192465660275", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75222938_290192468993608_254672737452146756_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cfIUhZ51aCwQ7kNvwGiPwR5&_nc_oc=AdqjbCy5gRiRBvQcC1ukmJQBwHDMWI2U-pCxQsbAyOdmQmxu8msEUe9QZxwsLK5DTOE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9JyBJTR6VYCn-0VnlNVqN24cn-vQ6JMqz0J6D2eiPKsA&oe=6A3E980C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "forest trailer.png", "id": "988047351647701", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/10000000_988047361647700_5249813252618530611_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z30_wQr-fRkQ7kNvwHaehbS&_nc_oc=Adq-ccSf0mQ41yhOHaWnJ_9FZFfEAmpDt21AamWcaeTh4DEcdBxcQdoUAnoTyQ6GnLQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_MZHGCKbltSntwGXhdS1CzWSaOA335SkZ9a-VhR15Tw&oe=6A3E98CB"}, "display_name": "Solas VR", "keywords": ["Meditation", "Nature", "Productivity", "Relaxation", "Mindfulness"], "long_description": "Solas Meditation is the VR app that goes beyond meditation as we know it. With an immersive gallery of landscapes, nature sounds and guidance, Solas VR meditation replicates the real feeling of being out there, close to nature, enjoying the inner calmness we are made for. Bringing together eternal wisdom and cutting edge technology, Solas Meditation is designed for urban living, as a shield against stress, confusion and rush. The graphics and sounds, provided directly by nature, create a seamless multi-sensory experience, initiating a journey within. \nWith Solas Meditation you will feel more. You will do more. You will be more.", "short_description": "Add a new dimension to your meditation and allow nature to take you on a journey within. Solas VR presents a gallery of landscapes, nature sounds and guided meditations, designed to refresh your mind, spirit and soul.  This wonderful VR experience is the perfect micro break in nature that you can take while living an urban life.  Why settle with two dimensions, when you can have more? Why not dive inside your inner wisdom where you can be more?"}]}, "developer_name": "Virtual Reality Ireland Media Ltd.", "developer_privacy_policy_url": "https://www.solasvr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.solasvr.com/terms-of-service/", "publisher_name": "Tiesto Capital Ltd", "support_website_url": "https://www.solasvr.com/about/", "website_url": "https://www.solasvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphic
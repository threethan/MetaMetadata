99YhcUQ7kNvwGg3Ol-&_nc_oc=AdqRpyEuvzNM3f9_ySZJkHVAEGm3uLz0Mf2ISHkZE5UML8FOYhIk2_2Yuwu1LonAIQs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1rh5orceVRu3L0-ZW3CYjMW755KjuYPzd8CvFDzpEGVg&oe=69E77CA8"}, {"file_name": "Glendalough lake.png", "id": "317898529368349", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39036652_317898532701682_1088784562417673472_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kcnd8QhsBAoQ7kNvwFL3xZc&_nc_oc=AdoiN4bT2zkWRoEl7-nWJxXszHZlRv8NTYUFcQXV_GnSVSs-tQ6zF0oOebC7FCF9vSM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af32nO6hIAqeeGWf8XAdECpDWGAqEeOxBp7bLxw19PiA3Q&oe=69E77B5B"}, {"file_name": "Powerscourt waterfall.png", "id": "293387855349260", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75207237_293387858682593_3625796469231178237_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qleBYexcOpQQ7kNvwEYSUUr&_nc_oc=Adq95ZzCevM0c2lxZHsvAWLfsCEgyUg-zcBWiRPjIS0f-4MxsyoUgnkKCZiEt3rvbJ4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1UbbbYajIWLOzxI37pjlPzsu3YQeTpw_E_4OYD4yAzOg&oe=69E7671A"}, {"file_name": "Beach wexford.png", "id": "290192465660275", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75222938_290192468993608_254672737452146756_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aPRVRWmWOGUQ7kNvwGSja79&_nc_oc=AdphpNz95jjJJSiKjlK7VkV1dv-VoQGsTPnI6JUMBfk5pu9BoezSHxbEHVoGGfiHLhg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ZzNEVyKr-RTvLeICmSQ9xcPlLfP27t04avKA0iG1tkA&oe=69E75CCC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "forest trailer.png", "id": "988047351647701", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/10000000_988047361647700_5249813252618530611_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ywhiijw-QnsQ7kNvwHljK-o&_nc_oc=AdrTQKBfnhW9wdFMtRnVkPVAxds_fvgtbHZY4hXSflerHrfOl_076vIkd8EsuYiiKFs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0mrxhDpk94oy5bqUeai-E30tWLamHpYMF-_IhFyzvzjg&oe=69E75D8B"}, "display_name": "Solas VR", "keywords": ["Meditation", "Nature", "Productivity", "Relaxation", "Mindfulness"], "long_description": "Solas Meditation is the VR app that goes beyond meditation as we know it. With an immersive gallery of landscapes, nature sounds and guidance, Solas VR meditation replicates the real feeling of being out there, close to nature, enjoying the inner calmness we are made for. Bringing together eternal wisdom and cutting edge technology, Solas Meditation is designed for urban living, as a shield against stress, confusion and rush. The graphics and sounds, provided directly by nature, create a seamless multi-sensory experience, initiating a journey within. \nWith Solas Meditation you will feel more. You will do more. You will be more.", "short_description": "Add a new dimension to your meditation and allow nature to take you on a journey within. Solas VR presents a gallery of landscapes, nature sounds and guided meditations, designed to refresh your mind, spirit and soul.  This wonderful VR experience is the perfect micro break in nature that you can take while living an urban life.  Why settle with two dimensions, when you can have more? Why not dive inside your inner wisdom where you can be more?"}]}, "developer_name": "Virtual Reality Ireland Media Ltd.", "developer_privacy_policy_url": "https://www.solasvr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.solasvr.com/terms-of-service/", "publisher_name": "Tiesto Capital Ltd", "support_website_url": "https://www.solasvr.com/about/", "website_url": "https://www.solasvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphic
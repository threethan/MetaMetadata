TYdMUIQ7kNvwG_aQyK&_nc_oc=AdrLBc5I9etzm0BbvwcrMZ4Nd3cG2Etzd3t76YM3NBK9hLq4Kmrziq70KsqjfVQQYcA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0yDDQETEWHcqUbDMPQcKP955uoWeewF-UXKJbBhI7e0g&oe=69EF65A8"}, {"file_name": "Glendalough lake.png", "id": "317898529368349", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036652_317898532701682_1088784562417673472_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f4-UjVQWV40Q7kNvwEEViZc&_nc_oc=AdrIuVTHplfwE9k9Fk5PxXdH2BGl9paW0Ywv4nVAXRI9Y2rpbJG07mMQgO8Q580FEU4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2RBftRA5ax5iznfLgDxAerqwgvApnsnivOi-NKGQ-hBw&oe=69EF645B"}, {"file_name": "Powerscourt waterfall.png", "id": "293387855349260", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75207237_293387858682593_3625796469231178237_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0jgQiZ8YLE8Q7kNvwFw7RWB&_nc_oc=AdpfHoS6Dzf1UOWZJL6cg4jyGTJF6cnibDNcmVVa0uwMy2Uu_wFwBq3AUqdS94KSiEE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1pV6WcGwYlz64gasXutjFUETltpddQ7AvqcsnVHHUcBg&oe=69EF501A"}, {"file_name": "Beach wexford.png", "id": "290192465660275", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75222938_290192468993608_254672737452146756_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0RKuCKmKWkUQ7kNvwFWFzab&_nc_oc=Adp3P-ZM5VN5iuyJO38byGo3IQ6Mmx7PWBlSSfMi6sSM25STY9Flvqri73W3JR2G1VE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2UU_iwmOIWwlh47xvUIuag3td3zbbB2d-BV4gki6DhRg&oe=69EF7E0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "forest trailer.png", "id": "988047351647701", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/10000000_988047361647700_5249813252618530611_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AQZvqmIG8VwQ7kNvwGeGKb1&_nc_oc=AdoQSJp5BBV9maKMJFGmUjF-dxqDil7sXPgxRrUNubcv9LLFthBJI3THohIYy_YoOeA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1ZW-HGv5pv7JUjS1BQ1k9ySKiuEWVQkAxixMmeAJ5hpg&oe=69EF7ECB"}, "display_name": "Solas VR", "keywords": ["Meditation", "Nature", "Productivity", "Relaxation", "Mindfulness"], "long_description": "Solas Meditation is the VR app that goes beyond meditation as we know it. With an immersive gallery of landscapes, nature sounds and guidance, Solas VR meditation replicates the real feeling of being out there, close to nature, enjoying the inner calmness we are made for. Bringing together eternal wisdom and cutting edge technology, Solas Meditation is designed for urban living, as a shield against stress, confusion and rush. The graphics and sounds, provided directly by nature, create a seamless multi-sensory experience, initiating a journey within. \nWith Solas Meditation you will feel more. You will do more. You will be more.", "short_description": "Add a new dimension to your meditation and allow nature to take you on a journey within. Solas VR presents a gallery of landscapes, nature sounds and guided meditations, designed to refresh your mind, spirit and soul.  This wonderful VR experience is the perfect micro break in nature that you can take while living an urban life.  Why settle with two dimensions, when you can have more? Why not dive inside your inner wisdom where you can be more?"}]}, "developer_name": "Virtual Reality Ireland Media Ltd.", "developer_privacy_policy_url": "https://www.solasvr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.solasvr.com/terms-of-service/", "publisher_name": "Tiesto Capital Ltd", "support_website_url": "https://www.solasvr.com/about/", "website_url": "https://www.solasvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphic
3xh_0EQ7kNvwEV5se6&_nc_oc=AdqzPib3Ir2RxaAQxzpy4hb7YtiyvzqZc4EOMUlA5GEUeSyt-Z0cu-IV8HlAaRtAez0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJqiy7Fc-VJH-jwR6-DnSh7wtn03a5pHDCD4Jr2WzrlQ&oe=6A54E928"}, {"file_name": "Glendalough lake.png", "id": "317898529368349", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39036652_317898532701682_1088784562417673472_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5RJmFiy5j5gQ7kNvwHXbMwb&_nc_oc=AdqPFzDSbjg2C8Z2IdYtgo_chlvfhVp1xcUAKgNvdVRoLZAem3BpDuhhRw_1niPpkLw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCg52g_b1TWoYedhC9y3yvVZSuXpnLiPI1nJmHFjeankg&oe=6A54E7DB"}, {"file_name": "Powerscourt waterfall.png", "id": "293387855349260", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75207237_293387858682593_3625796469231178237_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DQRppuY1yR0Q7kNvwFYxlnQ&_nc_oc=Adp-VMj3ldlMhUBK5q07bg1p75vuaEH_8QYmJVD2ugMJIopT-vmAA-_IDOP9IqOGGNo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCKNxAU8VUJGqaa-3k2HoG_Y_pUsVNkcZXGg1T8nFmKvA&oe=6A54D39A"}, {"file_name": "Beach wexford.png", "id": "290192465660275", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75222938_290192468993608_254672737452146756_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XVTlDDkIYiIQ7kNvwHrjgK0&_nc_oc=AdrPkTsnqx_yS02P9qh7axOrZawpxr8kEfH7h_hMoZIuzzDY9lmrGu5fN_5CHVjT-wA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDIr8QKha0DGmnf-tjqnFB-RO1mf2nZrH1P_QEw1Az3kQ&oe=6A55018C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "forest trailer.png", "id": "988047351647701", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/10000000_988047361647700_5249813252618530611_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_5Qa7CE1MOQQ7kNvwEMC4WP&_nc_oc=Adpcdm7Y2spBSBrRyPU0nKqEQo5zScF5w7SunRxL4R5B7yM-fifxXzBmaj1xl02xltU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBS-dqD0Wd5B0hQEk2YRL4qXPKAwk5Djc15ZI1IWek6tg&oe=6A55024B"}, "display_name": "Solas VR", "keywords": ["Meditation", "Nature", "Productivity", "Relaxation", "Mindfulness"], "long_description": "Solas Meditation is the VR app that goes beyond meditation as we know it. With an immersive gallery of landscapes, nature sounds and guidance, Solas VR meditation replicates the real feeling of being out there, close to nature, enjoying the inner calmness we are made for. Bringing together eternal wisdom and cutting edge technology, Solas Meditation is designed for urban living, as a shield against stress, confusion and rush. The graphics and sounds, provided directly by nature, create a seamless multi-sensory experience, initiating a journey within. \nWith Solas Meditation you will feel more. You will do more. You will be more.", "short_description": "Add a new dimension to your meditation and allow nature to take you on a journey within. Solas VR presents a gallery of landscapes, nature sounds and guided meditations, designed to refresh your mind, spirit and soul.  This wonderful VR experience is the perfect micro break in nature that you can take while living an urban life.  Why settle with two dimensions, when you can have more? Why not dive inside your inner wisdom where you can be more?"}]}, "developer_name": "Virtual Reality Ireland Media Ltd.", "developer_privacy_policy_url": "https://www.solasvr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.solasvr.com/terms-of-service/", "publisher_name": "Tiesto Capital Ltd", "support_website_url": "https://www.solasvr.com/about/", "website_url": "https://www.solasvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphic
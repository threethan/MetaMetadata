hcBCSwQ7kNvwGa7BCD&_nc_oc=AdoWnwrIGoXPEri2FwyKoRE5J9C7BPcBEksw8a7ctYUDRgi_F1VwsT6ITLMMyBevKDY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Bg-brixeyhfUIDxvSweJmlxAr8rEE-rjg-RcHG8bZ1Q&oe=6A47BA28"}, {"file_name": "Glendalough lake.png", "id": "317898529368349", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036652_317898532701682_1088784562417673472_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nHOfk4oOfKoQ7kNvwGau2e2&_nc_oc=Adq9cS7MXjBgsIEAUxJGLeGZ1S7984GusRlhTvlVss0oY5abQmc6KpJpiQkKUEvBjyA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af861lOrXT9DNbrBtwx8jlj84JS-l1QOMIQKWoxLzG5o6Q&oe=6A47B8DB"}, {"file_name": "Powerscourt waterfall.png", "id": "293387855349260", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75207237_293387858682593_3625796469231178237_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ka7dW2BYp4oQ7kNvwH0Q8Uz&_nc_oc=AdqQWxc7zrPvzYyqwxZlpGPvtlUAEO2f8e7lRNpn5x6YKJ7NVRNoVq3BVXcSH_0uIB8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8KSI7N2C6vhuBYf6OtSFf7J3Ly79IdOhUqvvJWHoABxQ&oe=6A47DCDA"}, {"file_name": "Beach wexford.png", "id": "290192465660275", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75222938_290192468993608_254672737452146756_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=icFXw_P8Q5kQ7kNvwGUYU0y&_nc_oc=Adpx-xuMOURxybjwS1Z4JV8BLQRfgxaXm0somqrmdc6ED9tMza0iZZMYb4_uulvwlVE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_B8CuWWPgXmnSwljvHeTyvR7_-GKlAeI1w58Q4GALB4A&oe=6A47D28C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "forest trailer.png", "id": "988047351647701", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/10000000_988047361647700_5249813252618530611_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8LqestK-CgMQ7kNvwGnVWXr&_nc_oc=AdoTh3wqm7lH245ICvWlOoaXBnqTMKY4TTbxOYdm2LCcilVOZ7wYzuYD-v8lBzpi-l8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_oVh3Q64ysp4haCOshTvZQ35wZupeycNRNHd2WihxvZA&oe=6A47D34B"}, "display_name": "Solas VR", "keywords": ["Meditation", "Nature", "Productivity", "Relaxation", "Mindfulness"], "long_description": "Solas Meditation is the VR app that goes beyond meditation as we know it. With an immersive gallery of landscapes, nature sounds and guidance, Solas VR meditation replicates the real feeling of being out there, close to nature, enjoying the inner calmness we are made for. Bringing together eternal wisdom and cutting edge technology, Solas Meditation is designed for urban living, as a shield against stress, confusion and rush. The graphics and sounds, provided directly by nature, create a seamless multi-sensory experience, initiating a journey within. \nWith Solas Meditation you will feel more. You will do more. You will be more.", "short_description": "Add a new dimension to your meditation and allow nature to take you on a journey within. Solas VR presents a gallery of landscapes, nature sounds and guided meditations, designed to refresh your mind, spirit and soul.  This wonderful VR experience is the perfect micro break in nature that you can take while living an urban life.  Why settle with two dimensions, when you can have more? Why not dive inside your inner wisdom where you can be more?"}]}, "developer_name": "Virtual Reality Ireland Media Ltd.", "developer_privacy_policy_url": "https://www.solasvr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.solasvr.com/terms-of-service/", "publisher_name": "Tiesto Capital Ltd", "support_website_url": "https://www.solasvr.com/about/", "website_url": "https://www.solasvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphic
jAbhm8Q7kNvwEzblg7&_nc_oc=AdqtBC7oGXf8GiGQQTs6xsLLdFPvqCOo4Nuecm6j756RqFLOkAGkNDERkKFJ8pDZyy4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxLoL2BfjDaRs0BDAbQVEYjVks_uwo5Lo3Bg6YEYolagQ&oe=69CE7028"}, {"file_name": "Glendalough lake.png", "id": "317898529368349", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036652_317898532701682_1088784562417673472_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jb1pA3D5LX8Q7kNvwGq2X9z&_nc_oc=AdrDz5DSP4vHmV6RE-tAiRpVy1p6o7GuP5yrzwNfwhJZh40as4JTgwWN0WXYMsOIktw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyBmoLauZioIoGuC6m6gtb9gawWqgov91x0CK_dqYYaUw&oe=69CE6EDB"}, {"file_name": "Powerscourt waterfall.png", "id": "293387855349260", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75207237_293387858682593_3625796469231178237_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aFfC5DN4Gs4Q7kNvwHTjWhu&_nc_oc=Adq2eneGrHx1ksSakQ5WrngoXa2PbXy5aFW3diFk4sHfSJkVLFAvWhOcAsWOY1HGNDg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzavUiRXnJh0ja_xTvcRq1K4w-oU8jeMxAM7Q8CyY7feg&oe=69CE5A9A"}, {"file_name": "Beach wexford.png", "id": "290192465660275", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75222938_290192468993608_254672737452146756_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZZ6tKMcpHgUQ7kNvwGSSzvk&_nc_oc=AdowlMw5jy6h5i_8RzfJX1Dc0VHpBA3FBoon8t6-gS5ezQJLJICtnCx-MeuiI_iT6nQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzlRoKN_w1I78KjvW5zaHTREcpEWXmetA6-aB9FcGHwjw&oe=69CE504C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "forest trailer.png", "id": "988047351647701", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/10000000_988047361647700_5249813252618530611_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O4Ft0QIC-vgQ7kNvwGLpu3z&_nc_oc=AdpNHm3PPAIsrguE6z_VGXUwUysBste_p1O2ffkDtDzXrU97IuolY65VzOrL1J07rj8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzpt0raMyy4B2BWKRArVKxdt-Ij7if7nY6Lv5MgB1iHKw&oe=69CE510B"}, "display_name": "Solas VR", "keywords": ["Meditation", "Nature", "Productivity", "Relaxation", "Mindfulness"], "long_description": "Solas Meditation is the VR app that goes beyond meditation as we know it. With an immersive gallery of landscapes, nature sounds and guidance, Solas VR meditation replicates the real feeling of being out there, close to nature, enjoying the inner calmness we are made for. Bringing together eternal wisdom and cutting edge technology, Solas Meditation is designed for urban living, as a shield against stress, confusion and rush. The graphics and sounds, provided directly by nature, create a seamless multi-sensory experience, initiating a journey within. \nWith Solas Meditation you will feel more. You will do more. You will be more.", "short_description": "Add a new dimension to your meditation and allow nature to take you on a journey within. Solas VR presents a gallery of landscapes, nature sounds and guided meditations, designed to refresh your mind, spirit and soul.  This wonderful VR experience is the perfect micro break in nature that you can take while living an urban life.  Why settle with two dimensions, when you can have more? Why not dive inside your inner wisdom where you can be more?"}]}, "developer_name": "Virtual Reality Ireland Media Ltd.", "developer_privacy_policy_url": "https://www.solasvr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.solasvr.com/terms-of-service/", "publisher_name": "Tiesto Capital Ltd", "support_website_url": "https://www.solasvr.com/about/", "website_url": "https://www.solasvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphic
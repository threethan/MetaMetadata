KGgTh4Q7kNvwEU0UMe&_nc_oc=Adog0UInhBrcv6PPGAvMZCbTRTM5v6pZC0GdAQ4jaDhE9dBOb1m5B7AgXXfj7d8tjN0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIaapmNZUuPYhOls7UonlltPswuklHMnVFlM8bLg5rpxw&oe=6AAA9AA8"}, {"file_name": "Glendalough lake.png", "id": "317898529368349", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036652_317898532701682_1088784562417673472_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bCn1oSf1NS0Q7kNvwEJc5-f&_nc_oc=AdqViuLoPRkwlGPk1RFPJ5O_duLmuNjSFiN6m47DSNZBPc1VIsSC34NDujDCIzzh-Ag&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQ7sjqmf1TdUjKNj4xGyBGu1y-0vWAI3N067i7sGjr0g&oe=6AAA995B"}, {"file_name": "Powerscourt waterfall.png", "id": "293387855349260", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75207237_293387858682593_3625796469231178237_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K6qwnxnL1dEQ7kNvwE-K7i7&_nc_oc=AdqVKKE7wCiWJo9jpNVtJIdfS34wCxFhUPVnCe2tjgo9MxV3Hf2uRxnojqoTWdJvoV8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIhfcKejb5NuI_ACAVnJ623_N9PwZTZx_iSWmjY32V1Rg&oe=6AAABD5A"}, {"file_name": "Beach wexford.png", "id": "290192465660275", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75222938_290192468993608_254672737452146756_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7_3gvTQDbt4Q7kNvwG3B9qG&_nc_oc=AdqkyB0OHO2b-0KTtfi0anijtdFTlmRNYq58lromvqmfrh6Np1nVSNivBCLQyerIGPk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdOWmS094DzARw32Wzgxw8fAA3w40Ug20o8p2VMtgnsA&oe=6AAAB30C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "forest trailer.png", "id": "988047351647701", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/10000000_988047361647700_5249813252618530611_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-g7AWLGXw-AQ7kNvwFO-STy&_nc_oc=Adqz1VA5Y25z_h2W97uYmnDmagpY8gtRPOLDo-OKVZI7JSZsorG7ogwC_p4XZSq0oeY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLrO7cAi70XwpgllK7iQYKYuXRgOFoqURfMOttatm5cUA&oe=6AAAB3CB"}, "display_name": "Solas VR", "keywords": ["Meditation", "Nature", "Productivity", "Relaxation", "Mindfulness"], "long_description": "Solas Meditation is the VR app that goes beyond meditation as we know it. With an immersive gallery of landscapes, nature sounds and guidance, Solas VR meditation replicates the real feeling of being out there, close to nature, enjoying the inner calmness we are made for. Bringing together eternal wisdom and cutting edge technology, Solas Meditation is designed for urban living, as a shield against stress, confusion and rush. The graphics and sounds, provided directly by nature, create a seamless multi-sensory experience, initiating a journey within. \nWith Solas Meditation you will feel more. You will do more. You will be more.", "short_description": "Add a new dimension to your meditation and allow nature to take you on a journey within. Solas VR presents a gallery of landscapes, nature sounds and guided meditations, designed to refresh your mind, spirit and soul.  This wonderful VR experience is the perfect micro break in nature that you can take while living an urban life.  Why settle with two dimensions, when you can have more? Why not dive inside your inner wisdom where you can be more?"}]}, "developer_name": "Virtual Reality Ireland Media Ltd.", "developer_privacy_policy_url": "https://www.solasvr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.solasvr.com/terms-of-service/", "publisher_name": "Tiesto Capital Ltd", "support_website_url": "https://www.solasvr.com/about/", "website_url": "https://www.solasvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphic
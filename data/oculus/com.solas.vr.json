wiGg&oe=69C13FDB"}, {"file_name": "Powerscourt waterfall.png", "id": "293387855349260", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75207237_293387858682593_3625796469231178237_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_cgN4CW1XfcQ7kNvwF_JCZE&_nc_oc=Adq0_uu2FITWY-SG4HDbjN5C6MNx3qG41Sfp1T6EeT_JN72Kj6cqAKmTkv2N64mfkvo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyMK6kdWITyuaTVKqHHHU_YsZvhwrnk48WR1U88cdAIgg&oe=69C12B9A"}, {"file_name": "Beach wexford.png", "id": "290192465660275", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75222938_290192468993608_254672737452146756_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NqgWJb1KwJ4Q7kNvwFyLIRJ&_nc_oc=Adp6MYc6emIbZ-G0CCka0htTDOMDFa7ta-wfG2Kig5QZ4O73o66ANItBexhpytCTKFI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwUyPtEmvj5suJzfz2P4qP_1zIJXgHCe_n0vMQ-UNy6_A&oe=69C1214C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "forest trailer.png", "id": "988047351647701", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/10000000_988047361647700_5249813252618530611_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=03MVLS1DU3EQ7kNvwHQ4Dlj&_nc_oc=AdoigIsk9eG_7osdlJePF-AjaDLwd_QCvMV25gD2_t9zKcj51Y2g-VclIfXEUlLnIrA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyLEvod4COn23NwceFRFsc9Vinyw2NunZEe_5MeYPJJNQ&oe=69C1220B"}, "display_name": "Solas VR", "keywords": ["Meditation", "Nature", "Productivity", "Relaxation", "Mindfulness"], "long_description": "Solas Meditation is the VR app that goes beyond meditation as we know it. With an immersive gallery of landscapes, nature sounds and guidance Solas VR mediation replicates the real feeling of being out there, close to nature, enjoying the inner calmness we are made for. Bringing together the eternal wisdom and cutting edge technology, Solas Meditation is designed for urban living, as a shield against stress, confusion and rush. The graphics and sounds, provided directly by nature, create a seamless multi-sensory experience, initiating a journey within.", "short_description": "Add a new dimension to your meditation and allow the nature to take you to a journey within. Solas VR Meditation presents a gallery of landscapes, nature sounds and guided meditations, designed to refresh your mind, spirit and soul.  This unprecedented VR experience is the best mini break you can take while living the urban life.  Why settle with two dimensions, when you can have more? Why not diving inside your inner wisdom when you can be more?"}]}, "developer_name": "Virtual Reality Ireland Media Ltd.", "developer_privacy_policy_url": "https://www.solasvr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.solasvr.com/terms-of-service/", "publisher_name": "Tiesto Capital Ltd", "support_website_url": "https://www.solasvr.com/about/", "website_url": "https://www.solasvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["RELAXATION_MEDITATION", "EXPERIENCE_360_NON_GAME", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "465459908569054"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1661203430724027"}]}, "baseline_offer": {"id": "1661203430724027"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1598547600, "status": "PUBLISHED", "id": "1661203430724027"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5003222123084837", "version": "1.1"}, "
kGW9lgQ7kNvwH-YV1a&_nc_oc=AdoVMDus3PHSYjqppDRmX5l44f4IeAszv2v0tQhNwKMRdBJKuwbvMkK3r-FJNBPhFCg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIXx-VvICOczCOCVMCkYlgo1mO7AYJCsaliySJ_3eWYw&oe=6A9AC8A8"}, {"file_name": "Glendalough lake.png", "id": "317898529368349", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036652_317898532701682_1088784562417673472_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RRzoFyicNDkQ7kNvwGvonAR&_nc_oc=Adqf6bczMV07LkRRAYYwH0KaiPzS_slzx43-xAjYak-gObAB_TS2xSQeqkDNTyzbZ4Q&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_VaOXbFm6mpoE-nXWtPA-6MUhF7qxmKvvx__J2csGPA&oe=6A9AC75B"}, {"file_name": "Powerscourt waterfall.png", "id": "293387855349260", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75207237_293387858682593_3625796469231178237_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zCEekc8OmokQ7kNvwE6a49h&_nc_oc=AdpEh7yMaVFU4uQ3wCKqB0W7RVrDlB5n8Yo9aLYKJvC6q6-vlVE4CN0Za3WDakaqPjk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzXh3Kw1je5VuErB1YH3kdovkb4L_UR2Hk5c17Eo-k4g&oe=6A9AEB5A"}, {"file_name": "Beach wexford.png", "id": "290192465660275", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75222938_290192468993608_254672737452146756_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9MJlQgMLSjoQ7kNvwFU6I5C&_nc_oc=AdrfU3CZXMeNcXnRCCjUQ75p48hoxhXOMBclq6jB81u-oDFtn4ZD9K0BJ6OsCnxLiXk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIarCQDbKB2Ja1NHcX1jKVUNGDnXdUpL4Qye3iBmV3HLA&oe=6A9AE10C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "forest trailer.png", "id": "988047351647701", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/10000000_988047361647700_5249813252618530611_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x0cFYqBjBnsQ7kNvwFoBsHz&_nc_oc=Adp86PIKSI7510YoxmXUNRCpPcKqvcKsQXnLndOow5UvgiLZUCAPPEvErHR6dZY9qYs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5OB14TOxsgLHfHYQofmdBd5CtJnqncIuPRuG2t5crew&oe=6A9AE1CB"}, "display_name": "Solas VR", "keywords": ["Meditation", "Nature", "Productivity", "Relaxation", "Mindfulness"], "long_description": "Solas Meditation is the VR app that goes beyond meditation as we know it. With an immersive gallery of landscapes, nature sounds and guidance, Solas VR meditation replicates the real feeling of being out there, close to nature, enjoying the inner calmness we are made for. Bringing together eternal wisdom and cutting edge technology, Solas Meditation is designed for urban living, as a shield against stress, confusion and rush. The graphics and sounds, provided directly by nature, create a seamless multi-sensory experience, initiating a journey within. \nWith Solas Meditation you will feel more. You will do more. You will be more.", "short_description": "Add a new dimension to your meditation and allow nature to take you on a journey within. Solas VR presents a gallery of landscapes, nature sounds and guided meditations, designed to refresh your mind, spirit and soul.  This wonderful VR experience is the perfect micro break in nature that you can take while living an urban life.  Why settle with two dimensions, when you can have more? Why not dive inside your inner wisdom where you can be more?"}]}, "developer_name": "Virtual Reality Ireland Media Ltd.", "developer_privacy_policy_url": "https://www.solasvr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.solasvr.com/terms-of-service/", "publisher_name": "Tiesto Capital Ltd", "support_website_url": "https://www.solasvr.com/about/", "website_url": "https://www.solasvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphic
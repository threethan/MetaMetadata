Hogy14Q7kNvwE8e8NI&_nc_oc=AdpKA9Yk95sQai5xA09B-AyfWMvMmcZNGwKzIvMGZWXGxU10PTa_BqJChF0TKnWVxhI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-pBMC91N_v0kekRYw8NLAtSVkKx0E-huvM3ZZw9cPyDw&oe=6A2FFF28"}, {"file_name": "Glendalough lake.png", "id": "317898529368349", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036652_317898532701682_1088784562417673472_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cNlil1LI5UAQ7kNvwERpulo&_nc_oc=AdoqwDLVUcy7nXTV_hAII9IhY_c4JjG5IBzf_g-chF99IwMtHoS6A46zbIQKewyQQ1I&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-a_BYAlgCyLwpWFVtdU9zGcdl8v4kZ3ghXBLfY3ePLSw&oe=6A2FFDDB"}, {"file_name": "Powerscourt waterfall.png", "id": "293387855349260", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75207237_293387858682593_3625796469231178237_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZGbFyTE33jgQ7kNvwGLHk_W&_nc_oc=Adpxlfr1Sc0w432IdgpPrFwCtFuEFPKWU_VceCTKKuFDX_mgNnkZ3PmPzzQw8auFCog&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Z85OeyxLnjEYVw9km3b_DR1pLSzzF8ozGFl7GV1o2Ew&oe=6A3021DA"}, {"file_name": "Beach wexford.png", "id": "290192465660275", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75222938_290192468993608_254672737452146756_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BHRHxyQubxYQ7kNvwGWiwp-&_nc_oc=AdqSj39qY6C65BuRbmlnat7Ws43W-rvHBfj2a-aBlWYFASF23dMxLnnrTJrIKkGJDdU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-IwJQsqiwx652_ApjxJJOMP8RR7fJv0X65daj1C1_KyA&oe=6A30178C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "forest trailer.png", "id": "988047351647701", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/10000000_988047361647700_5249813252618530611_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AuxvngKEXSYQ7kNvwGNykMV&_nc_oc=AdpFmwqXDkfgK2HQ_fpskXxkG0wUG47WGHwYTlqro5jkXCvpZxLI4ab4YvtJYVRLQSI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-HZkDB2zowDtMGC86zU7cKqUxrkT6OKas6cnjhrq6e9Q&oe=6A30184B"}, "display_name": "Solas VR", "keywords": ["Meditation", "Nature", "Productivity", "Relaxation", "Mindfulness"], "long_description": "Solas Meditation is the VR app that goes beyond meditation as we know it. With an immersive gallery of landscapes, nature sounds and guidance, Solas VR meditation replicates the real feeling of being out there, close to nature, enjoying the inner calmness we are made for. Bringing together eternal wisdom and cutting edge technology, Solas Meditation is designed for urban living, as a shield against stress, confusion and rush. The graphics and sounds, provided directly by nature, create a seamless multi-sensory experience, initiating a journey within. \nWith Solas Meditation you will feel more. You will do more. You will be more.", "short_description": "Add a new dimension to your meditation and allow nature to take you on a journey within. Solas VR presents a gallery of landscapes, nature sounds and guided meditations, designed to refresh your mind, spirit and soul.  This wonderful VR experience is the perfect micro break in nature that you can take while living an urban life.  Why settle with two dimensions, when you can have more? Why not dive inside your inner wisdom where you can be more?"}]}, "developer_name": "Virtual Reality Ireland Media Ltd.", "developer_privacy_policy_url": "https://www.solasvr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.solasvr.com/terms-of-service/", "publisher_name": "Tiesto Capital Ltd", "support_website_url": "https://www.solasvr.com/about/", "website_url": "https://www.solasvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphic
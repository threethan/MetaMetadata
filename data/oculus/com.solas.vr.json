_ohc=UgEEbS4WabQQ7kNvwHsFssQ&_nc_oc=AdrcZSznfqPwmLXThEXQfkwQHEbw7PM6WAqBgbwCEFhZMTWzwZeRYztxbpOmDgnW4Sc&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLMJby0cOCAmdixR304wo5D2cG6_G9B1tgUR9JmBqqilw&oe=6AAE8F28"}, {"file_name": "Glendalough lake.png", "id": "317898529368349", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39036652_317898532701682_1088784562417673472_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pRX1dBXsEAQQ7kNvwE7z9v6&_nc_oc=AdpaCBtjvrKITxxuQCudwMNdy4Nu8vdRSz8UhttLWdl0QQVGvHQcPq3b969HglC8JCk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1EKQbNbvc5vy-7ByHt4SgwJokofjyKzQAeu81TbwuVQ&oe=6AAE8DDB"}, {"file_name": "Powerscourt waterfall.png", "id": "293387855349260", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75207237_293387858682593_3625796469231178237_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v9ZxI2DOPeIQ7kNvwHuMKl1&_nc_oc=AdqvR0nVEWI-OuPgfyG6gM4vxSi50Jk9pyjRCI5hvLNTjVd18hBKlc5ZgJpxM3W1HE4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUv83NsHdK0FRBloZGgcklpfNYsFUf6TnoTiimPABeSg&oe=6AAEB1DA"}, {"file_name": "Beach wexford.png", "id": "290192465660275", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75222938_290192468993608_254672737452146756_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aFamcVpyjPIQ7kNvwFG9-lf&_nc_oc=Adofb53tYJuk8-U_HE91QgzJrWz0z7yNiG-W0g7jKUM3qHbB7ctn3_NXZ5kXKPyX4QI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLo6eCldxLgdfAH-NQdo9qWVeLgyYCIJkCVEblYaIZ2nQ&oe=6AAEA78C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "forest trailer.png", "id": "988047351647701", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/10000000_988047361647700_5249813252618530611_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LT3Pmuva4YQQ7kNvwEamhxb&_nc_oc=AdoTl2k0gjlrhiEM2GewkeMdhIK0-fQewbLIdXxPQd0UfefS0cuTkvwVWkbXebxmQ-o&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEPxD3GBceFPwiXR5OZbwILOKVjF6HcGhx59gd9K-WNA&oe=6AAEA84B"}, "display_name": "Solas VR", "keywords": ["Meditation", "Nature", "Productivity", "Relaxation", "Mindfulness"], "long_description": "Solas Meditation is the VR app that goes beyond meditation as we know it. With an immersive gallery of landscapes, nature sounds and guidance, Solas VR meditation replicates the real feeling of being out there, close to nature, enjoying the inner calmness we are made for. Bringing together eternal wisdom and cutting edge technology, Solas Meditation is designed for urban living, as a shield against stress, confusion and rush. The graphics and sounds, provided directly by nature, create a seamless multi-sensory experience, initiating a journey within. \nWith Solas Meditation you will feel more. You will do more. You will be more.", "short_description": "Add a new dimension to your meditation and allow nature to take you on a journey within. Solas VR presents a gallery of landscapes, nature sounds and guided meditations, designed to refresh your mind, spirit and soul.  This wonderful VR experience is the perfect micro break in nature that you can take while living an urban life.  Why settle with two dimensions, when you can have more? Why not dive inside your inner wisdom where you can be more?"}]}, "developer_name": "Virtual Reality Ireland Media Ltd.", "developer_privacy_policy_url": "https://www.solasvr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.solasvr.com/terms-of-service/", "publisher_name": "Tiesto Capital Ltd", "support_website_url": "https://www.solasvr.com/about/", "website_url": "https://www.solasvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "rec
JpYFfsQ7kNvwFwn5BG&_nc_oc=Adr4Hb9JcdEF3IxBv7LG1ZElBTxTA7dkTzOTBO_ragQbiBB48xSE8grJ1SRWa4hUfB8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af15OD2gp2ZecHriaIN1mRHZXtxVSFSJxmJn4tcnlmDzaQ&oe=69DB9F28"}, {"file_name": "Glendalough lake.png", "id": "317898529368349", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036652_317898532701682_1088784562417673472_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QQoWFTdDL50Q7kNvwGiwVsi&_nc_oc=AdqRcNnOmEm3ikabTeuVKkFLUJUoy8PXJzcYYOOH1H4Y8n0fT5pANRmrbdsFei0V-24&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2cQAkUkcybHj-FQ9eMCMJLfjpKyeIO6M9JJiVaI4AsaA&oe=69DB9DDB"}, {"file_name": "Powerscourt waterfall.png", "id": "293387855349260", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75207237_293387858682593_3625796469231178237_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AKFgQYc5PjMQ7kNvwF6XPHX&_nc_oc=AdqVoRPBKCMdsk143vyEmt-e5LdLkihRAsdSAceTweUep6m0CZ00qN3whplyS6FqNqc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3hrCZ4SzwStQMizYvqruYS267u9h1uRU_qqbI5U8Rc-A&oe=69DB899A"}, {"file_name": "Beach wexford.png", "id": "290192465660275", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75222938_290192468993608_254672737452146756_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c5O_6yd9GF8Q7kNvwGwsjtt&_nc_oc=AdpU-zkooPBMGFkjcqS03KFpeHp1vTUv3p8WYmGOaFkzj45M_Ka9vngldgqsPNJ_hds&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1SWJfdPor6E4qfaE_MDFOwNO8JCgpCwKUpQVeg6YXk-A&oe=69DB7F4C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "forest trailer.png", "id": "988047351647701", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/10000000_988047361647700_5249813252618530611_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7uAjoZWUPqgQ7kNvwFnHMKx&_nc_oc=AdoupiIw5Ibjo_oKmcmEx5gFlDLRzFwWJ9BE3B93b_RtX0d4CBJDL4dPv6gGIhUQ5vU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0vJIwRgv6H7-KSgo8zIprcNGg35n-UQvTIcDgOqqEU1A&oe=69DB800B"}, "display_name": "Solas VR", "keywords": ["Meditation", "Nature", "Productivity", "Relaxation", "Mindfulness"], "long_description": "Solas Meditation is the VR app that goes beyond meditation as we know it. With an immersive gallery of landscapes, nature sounds and guidance, Solas VR meditation replicates the real feeling of being out there, close to nature, enjoying the inner calmness we are made for. Bringing together eternal wisdom and cutting edge technology, Solas Meditation is designed for urban living, as a shield against stress, confusion and rush. The graphics and sounds, provided directly by nature, create a seamless multi-sensory experience, initiating a journey within. \nWith Solas Meditation you will feel more. You will do more. You will be more.", "short_description": "Add a new dimension to your meditation and allow nature to take you on a journey within. Solas VR presents a gallery of landscapes, nature sounds and guided meditations, designed to refresh your mind, spirit and soul.  This wonderful VR experience is the perfect micro break in nature that you can take while living an urban life.  Why settle with two dimensions, when you can have more? Why not dive inside your inner wisdom where you can be more?"}]}, "developer_name": "Virtual Reality Ireland Media Ltd.", "developer_privacy_policy_url": "https://www.solasvr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.solasvr.com/terms-of-service/", "publisher_name": "Tiesto Capital Ltd", "support_website_url": "https://www.solasvr.com/about/", "website_url": "https://www.solasvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphic
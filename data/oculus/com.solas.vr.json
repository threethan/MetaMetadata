5elvEQQ7kNvwEgxroD&_nc_oc=AdrX_RYHEjpnK28MEXkGLF4iIXoC4ohtTzFwKDxqcoFx34KQ6cbz9g_vg2ZQmcvpWyE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTI5FV1eL9Y6a8l6sBo9zQiNDdRQvz0tXi9rcY4Z63QsA&oe=6AEB3428"}, {"file_name": "Glendalough lake.png", "id": "317898529368349", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036652_317898532701682_1088784562417673472_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J_x28mTPODUQ7kNvwGoHGlS&_nc_oc=AdqgyDfYUb8uU0Dfyti8RSroC_ROH-rVlpgLLuYrg9KRlH87qPA0mjAWVzG5lAHGXBY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQr7D1mXRIw_TSnE5Jd3lR7hYERzjYLaKJfwO2A0OseCA&oe=6AEB32DB"}, {"file_name": "Powerscourt waterfall.png", "id": "293387855349260", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75207237_293387858682593_3625796469231178237_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VhDSXFEmAkgQ7kNvwFGnpKI&_nc_oc=AdqXB2f9x87GxQLTwyYWhvFok-pfcgMoV4d5hk_yRW0GBMOw7kVndC4nli-QvmYsWgQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgE0zuVSxexstHuflH-0L-P1fdfhqQ_NoTfUPgus6nwA&oe=6AEB56DA"}, {"file_name": "Beach wexford.png", "id": "290192465660275", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75222938_290192468993608_254672737452146756_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s4vjFvenWN8Q7kNvwGT4q_d&_nc_oc=AdrE9ocNmJiFy8X-zotwBfRHz4m3TtBSVKkGCT97glNmJOeeiRk5FHlQF-u4NjSzuXA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtZre7WMi_81TV4OVfoLQoljbc5G8HbUF6GI-tx3U7_A&oe=6AEB4C8C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "forest trailer.png", "id": "988047351647701", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/10000000_988047361647700_5249813252618530611_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=83evC-6P-XIQ7kNvwHjXLZj&_nc_oc=AdrRG2qt-I8kzVeuS2d7qB_cRaVHCnrsx2KjamSs5gNc_bvUIo18LBjkuNvGf3fnp3U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRn-dIE-0XK-XJzNgY5TkXplqVWllT5wi1BrIjNJ8j3dg&oe=6AEB4D4B"}, "display_name": "Solas VR", "keywords": ["Meditation", "Nature", "Productivity", "Relaxation", "Mindfulness"], "long_description": "Solas Meditation is the VR app that goes beyond meditation as we know it. With an immersive gallery of landscapes, nature sounds and guidance, Solas VR meditation replicates the real feeling of being out there, close to nature, enjoying the inner calmness we are made for. Bringing together eternal wisdom and cutting edge technology, Solas Meditation is designed for urban living, as a shield against stress, confusion and rush. The graphics and sounds, provided directly by nature, create a seamless multi-sensory experience, initiating a journey within. \nWith Solas Meditation you will feel more. You will do more. You will be more.", "short_description": "Add a new dimension to your meditation and allow nature to take you on a journey within. Solas VR presents a gallery of landscapes, nature sounds and guided meditations, designed to refresh your mind, spirit and soul.  This wonderful VR experience is the perfect micro break in nature that you can take while living an urban life.  Why settle with two dimensions, when you can have more? Why not dive inside your inner wisdom where you can be more?"}]}, "developer_name": "Virtual Reality Ireland Media Ltd.", "developer_privacy_policy_url": "https://www.solasvr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.solasvr.com/terms-of-service/", "publisher_name": "Tiesto Capital Ltd", "support_website_url": "https://www.solasvr.com/about/", "website_url": "https://www.solasvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphic
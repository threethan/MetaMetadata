_OmyhYQ7kNvwGhuDnZ&_nc_oc=Adr_ycvGs_tMy2C4I3I6_nljz0IVwQ-A6RnjxdxjhdGvjHJoUquL7i31crv6M7AsAuI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAT8mmaPQrq7fHrVqsoYdI7fRoeZ4wo7zM7KWO6zUVQyQ&oe=6A64BB28"}, {"file_name": "Glendalough lake.png", "id": "317898529368349", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036652_317898532701682_1088784562417673472_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2FC_aTrJX78Q7kNvwFQWKzV&_nc_oc=AdrmgKmaFmUDj1lsluJQeT7CLdZiaGihiFggYyS8DMb1sLUKRvPr0VGb-AOfyOWjV4k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJtHAOxREMm4CRtiPbiGQrV6ZoZJFHTiHY27IOzqVf0A&oe=6A64B9DB"}, {"file_name": "Powerscourt waterfall.png", "id": "293387855349260", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75207237_293387858682593_3625796469231178237_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XU1aeRKXPoUQ7kNvwEYXENU&_nc_oc=Adr_ES-5WLVKgt_1q2WGJZOGAJNrUnqqwFZDHa9XkWHd-VftE_98DBz7VrntT5C_-HM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbqZ6ewX0jH46XIFLoGPNPORynwAOIPoB3yaKA2j78kw&oe=6A64A59A"}, {"file_name": "Beach wexford.png", "id": "290192465660275", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75222938_290192468993608_254672737452146756_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BsVg_rVJxU4Q7kNvwGXmWYy&_nc_oc=AdqxtxLCYjVNqf0rEDWDHkAnitAtQEbyIrp-TD4rGZM3SeefCZLWE7fYBLddMgNgEh4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDcGbR7H9QDZ5RxyXUgi7AA3aflQ757Sg5yCPUVjUfB8A&oe=6A64D38C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "forest trailer.png", "id": "988047351647701", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/10000000_988047361647700_5249813252618530611_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=49beYtvHQmAQ7kNvwEn1uex&_nc_oc=AdrcZuj9KdPdcABBkK7qH-LnWwORqRTHwWTELqUeBapBxRqCHn3r7L7-29etJN_4aXM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwyXXgwacJ_ulS15nQZLRbvdzKgj_HE5q9Jny7kJRtNA&oe=6A64D44B"}, "display_name": "Solas VR", "keywords": ["Meditation", "Nature", "Productivity", "Relaxation", "Mindfulness"], "long_description": "Solas Meditation is the VR app that goes beyond meditation as we know it. With an immersive gallery of landscapes, nature sounds and guidance, Solas VR meditation replicates the real feeling of being out there, close to nature, enjoying the inner calmness we are made for. Bringing together eternal wisdom and cutting edge technology, Solas Meditation is designed for urban living, as a shield against stress, confusion and rush. The graphics and sounds, provided directly by nature, create a seamless multi-sensory experience, initiating a journey within. \nWith Solas Meditation you will feel more. You will do more. You will be more.", "short_description": "Add a new dimension to your meditation and allow nature to take you on a journey within. Solas VR presents a gallery of landscapes, nature sounds and guided meditations, designed to refresh your mind, spirit and soul.  This wonderful VR experience is the perfect micro break in nature that you can take while living an urban life.  Why settle with two dimensions, when you can have more? Why not dive inside your inner wisdom where you can be more?"}]}, "developer_name": "Virtual Reality Ireland Media Ltd.", "developer_privacy_policy_url": "https://www.solasvr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.solasvr.com/terms-of-service/", "publisher_name": "Tiesto Capital Ltd", "support_website_url": "https://www.solasvr.com/about/", "website_url": "https://www.solasvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphic
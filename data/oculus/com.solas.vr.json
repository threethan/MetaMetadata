d6TIU0Q7kNvwHej6XE&_nc_oc=AdqY0ngcP0AhtYERlrWpnUQ3kGm1F5OSkWqxNQVXHPIiSgNzwUq9PQlvODV8c5JwbWU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0qgzz9cEG7kKos1SrajjKkHckAWOvgyEt_kZrH5CR8w&oe=6A621828"}, {"file_name": "Glendalough lake.png", "id": "317898529368349", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036652_317898532701682_1088784562417673472_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EHwosDR9UnwQ7kNvwHOcCXU&_nc_oc=AdpSBpk37o9-KnNquV2ktJ3KTCare98Kndt4zJ1N9I6yftcR2afOAqgowcitoWfEF1s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDSa3XuugWHlZZJ1Ru1NZBbdDuYVHh6AnVJxDb1eNbf2w&oe=6A6216DB"}, {"file_name": "Powerscourt waterfall.png", "id": "293387855349260", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75207237_293387858682593_3625796469231178237_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XU1aeRKXPoUQ7kNvwFrcTNL&_nc_oc=AdqrX6FJ1MOplVFH6ZL2SqWmBU3BKAQ6fOT5Tb_E-T77dhlI1wjLaWwSErRoAZmYgBE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDUpKGn-ZfPn5qmcXyA5SdiIWjgeOxxjUrf283kKIIh0g&oe=6A62029A"}, {"file_name": "Beach wexford.png", "id": "290192465660275", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75222938_290192468993608_254672737452146756_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BsVg_rVJxU4Q7kNvwEy4USC&_nc_oc=AdqIwSAD-cRHJ9RiLiL9Mq8dYyk5TjUc9aftJTkxfETMG6WwtuHzsI-4ie-aBTz9A8U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBdLqmMJC2Wd-9pVcS1i2gJbf26qiKeE3CWgRdKWzN0qA&oe=6A62308C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "forest trailer.png", "id": "988047351647701", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/10000000_988047361647700_5249813252618530611_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jZ6djz5dgS4Q7kNvwFbee6m&_nc_oc=Adr8z8KZc6WhY366xmkVV3h4jcEvHH2RgNe_oCrEug4SAxjlPeDqPpXQtnXNcHeGxdM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAw0t4v59F5Me7_6z5VJfe1NnbRksq5LrXxXNVxxsKuSQ&oe=6A62314B"}, "display_name": "Solas VR", "keywords": ["Meditation", "Nature", "Productivity", "Relaxation", "Mindfulness"], "long_description": "Solas Meditation is the VR app that goes beyond meditation as we know it. With an immersive gallery of landscapes, nature sounds and guidance, Solas VR meditation replicates the real feeling of being out there, close to nature, enjoying the inner calmness we are made for. Bringing together eternal wisdom and cutting edge technology, Solas Meditation is designed for urban living, as a shield against stress, confusion and rush. The graphics and sounds, provided directly by nature, create a seamless multi-sensory experience, initiating a journey within. \nWith Solas Meditation you will feel more. You will do more. You will be more.", "short_description": "Add a new dimension to your meditation and allow nature to take you on a journey within. Solas VR presents a gallery of landscapes, nature sounds and guided meditations, designed to refresh your mind, spirit and soul.  This wonderful VR experience is the perfect micro break in nature that you can take while living an urban life.  Why settle with two dimensions, when you can have more? Why not dive inside your inner wisdom where you can be more?"}]}, "developer_name": "Virtual Reality Ireland Media Ltd.", "developer_privacy_policy_url": "https://www.solasvr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.solasvr.com/terms-of-service/", "publisher_name": "Tiesto Capital Ltd", "support_website_url": "https://www.solasvr.com/about/", "website_url": "https://www.solasvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphic
UrZNHoQ7kNvwHB7dum&_nc_oc=AdovtOTD8ie5bxXg66xGG0jpwyv0XE1KoZEl_HgKCFwPqrw0y5DVDpgiBH2hrU2ae6E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbfqqta4qYtjGTJO6KavNMBK3hfzWdjU3ihYZXmZHo8A&oe=6ABBBE28"}, {"file_name": "Glendalough lake.png", "id": "317898529368349", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036652_317898532701682_1088784562417673472_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KTII47hF2sgQ7kNvwHTdNQH&_nc_oc=AdoDL5GWw3ZlVRLsAwfSrjHgOkjEVHkKJMIL72Rk8YfPD69k6zOjzN4DVWTLrNCrRyI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLcuLcNIO3PSk3VV7XYolmq3PYCHPEW1s_3-LbvcN8S2A&oe=6ABBBCDB"}, {"file_name": "Powerscourt waterfall.png", "id": "293387855349260", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75207237_293387858682593_3625796469231178237_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nMHiQi1imusQ7kNvwE2qLSR&_nc_oc=AdqTFVrGIGqBBODzn1Iir889mhJIWgbltC7YpYOtnBXWH8LqMONWB3UxawO-HUkIKp8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2rYrZH48RrGG9JcWVMeugwfirkU5WaB_slWmjDVvs2g&oe=6ABBE0DA"}, {"file_name": "Beach wexford.png", "id": "290192465660275", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75222938_290192468993608_254672737452146756_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MsuHHgdDntIQ7kNvwE6M6kR&_nc_oc=Adp0gCp3V2eZkdj0jqBXTulM-uFUjLpspYNRyBapbgz0hq0hvoL1A-lzlvWaYjyywqM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIsF23WQ5IR-_L-gEsAkI_fEux_MXLM36MvmmJ1C1hA4g&oe=6ABBD68C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "forest trailer.png", "id": "988047351647701", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/10000000_988047361647700_5249813252618530611_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JghbQraqdb0Q7kNvwH5rx1k&_nc_oc=AdrHNUi1VU61IdgCUQ8orCg5icavIr_rQ0SXXmAppFYtJ3dAZ8bvnrkrq7P1YuSmi7Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQNCh8yoQ3gGfXuHHzGFz6rg5QW1nkRslcs0iy529RSA&oe=6ABBD74B"}, "display_name": "Solas VR", "keywords": ["Meditation", "Nature", "Productivity", "Relaxation", "Mindfulness"], "long_description": "Solas Meditation is the VR app that goes beyond meditation as we know it. With an immersive gallery of landscapes, nature sounds and guidance, Solas VR meditation replicates the real feeling of being out there, close to nature, enjoying the inner calmness we are made for. Bringing together eternal wisdom and cutting edge technology, Solas Meditation is designed for urban living, as a shield against stress, confusion and rush. The graphics and sounds, provided directly by nature, create a seamless multi-sensory experience, initiating a journey within. \nWith Solas Meditation you will feel more. You will do more. You will be more.", "short_description": "Add a new dimension to your meditation and allow nature to take you on a journey within. Solas VR presents a gallery of landscapes, nature sounds and guided meditations, designed to refresh your mind, spirit and soul.  This wonderful VR experience is the perfect micro break in nature that you can take while living an urban life.  Why settle with two dimensions, when you can have more? Why not dive inside your inner wisdom where you can be more?"}]}, "developer_name": "Virtual Reality Ireland Media Ltd.", "developer_privacy_policy_url": "https://www.solasvr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.solasvr.com/terms-of-service/", "publisher_name": "Tiesto Capital Ltd", "support_website_url": "https://www.solasvr.com/about/", "website_url": "https://www.solasvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphic
6q9eQ0Q7kNvwFe9auf&_nc_oc=AdrjgMIRrA5OshQk2r8sDUM3G7B8EAZ-JkMTg5vrpcwTLSHATIYrHKmwKz5qNN3mpiQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8jKN6Joasl4N-zl3-hnYMpiO7-6CicI0lqmm8urfopfw&oe=6A257328"}, {"file_name": "Glendalough lake.png", "id": "317898529368349", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036652_317898532701682_1088784562417673472_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VrlN1OY75N4Q7kNvwFK3GKt&_nc_oc=AdpkM7lq3hYHfgQVDc3VsaS1Q9kbMnMsLuGivuvMo9Tw8Rr9Ug52dGNWIP7C18oXvHQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_HIStuMxMVezFV9RwNHBw573HixYEtMqB4tjb3t0601w&oe=6A2571DB"}, {"file_name": "Powerscourt waterfall.png", "id": "293387855349260", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75207237_293387858682593_3625796469231178237_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E_pOGWxOAx8Q7kNvwGWOOPT&_nc_oc=Adpn478WPzr_KXn1Bae0eU32-cZWKL4BnqMfSYJX3iOfMe7yZsVULkjgwktSbZOt-Bo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-AdeLY_j-99W2gsMvIWAsqQw-qDuz1bQQ9lIOTuxAZUQ&oe=6A2595DA"}, {"file_name": "Beach wexford.png", "id": "290192465660275", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75222938_290192468993608_254672737452146756_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GoXyp7wgYaIQ7kNvwHPGPga&_nc_oc=AdqHQ2Ba_6SH6KtzEPIYyjUiKUZ9zoVzpE6_DAZxHVrRegR1FuoPIwaJB8pajqWdHNY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_M9_rlBEqjAmMejH-5F2CNEGl29a15a2DGoPN0rP2j1Q&oe=6A258B8C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "forest trailer.png", "id": "988047351647701", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/10000000_988047361647700_5249813252618530611_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Ppoo4kP-9EQ7kNvwHqEEgj&_nc_oc=Adq2IIKrryen0qURjZwvu_Eut5OeFVOURhyxcei8kBcxl97JEw4ONidYGN8s57O6fR0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8eylgyZasOpy1k5zoXFBO1iRkn1lg63YQJ6t70sSk-6A&oe=6A258C4B"}, "display_name": "Solas VR", "keywords": ["Meditation", "Nature", "Productivity", "Relaxation", "Mindfulness"], "long_description": "Solas Meditation is the VR app that goes beyond meditation as we know it. With an immersive gallery of landscapes, nature sounds and guidance, Solas VR meditation replicates the real feeling of being out there, close to nature, enjoying the inner calmness we are made for. Bringing together eternal wisdom and cutting edge technology, Solas Meditation is designed for urban living, as a shield against stress, confusion and rush. The graphics and sounds, provided directly by nature, create a seamless multi-sensory experience, initiating a journey within. \nWith Solas Meditation you will feel more. You will do more. You will be more.", "short_description": "Add a new dimension to your meditation and allow nature to take you on a journey within. Solas VR presents a gallery of landscapes, nature sounds and guided meditations, designed to refresh your mind, spirit and soul.  This wonderful VR experience is the perfect micro break in nature that you can take while living an urban life.  Why settle with two dimensions, when you can have more? Why not dive inside your inner wisdom where you can be more?"}]}, "developer_name": "Virtual Reality Ireland Media Ltd.", "developer_privacy_policy_url": "https://www.solasvr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.solasvr.com/terms-of-service/", "publisher_name": "Tiesto Capital Ltd", "support_website_url": "https://www.solasvr.com/about/", "website_url": "https://www.solasvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphic
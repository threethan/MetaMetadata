CNBVGUQ7kNvwF3U3uY&_nc_oc=AdqyVaC0-9AQaR4Vs2qRVwjZjrUeTym9IdKxFKuSEYCqtfB4SlAkyFmK17g6SV3zA3U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGlQIk-D-kdA8aDuDMpLCvcpahHRtvZy0m6HwL8ChJvPQ&oe=6A845F28"}, {"file_name": "Glendalough lake.png", "id": "317898529368349", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036652_317898532701682_1088784562417673472_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jd9ZODfome4Q7kNvwE7grEU&_nc_oc=Adq0F8amIgWV1FJ9Bj7JKh4rd9xAU5WuHDnC9puM7-6PvDMECUXLITRVGP_rodPRuac&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRZME06KWjWvA1ElYZnx0nycafJem49mH-6ZNmtTBM1Q&oe=6A845DDB"}, {"file_name": "Powerscourt waterfall.png", "id": "293387855349260", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75207237_293387858682593_3625796469231178237_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eLZ0GpuGYWIQ7kNvwFzA9i2&_nc_oc=AdogUTap0U6lCwEwMrTjleM1IRIqT_2idJDm9bVpVLXNAD_6SZmxEj2FbDEMP2rjQbc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGT-YjPSK7nrOXWgRf9MAOYwnKxVKueO3-l5Ho9q-dbg&oe=6A84499A"}, {"file_name": "Beach wexford.png", "id": "290192465660275", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75222938_290192468993608_254672737452146756_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JjwNnbititYQ7kNvwF0oIEr&_nc_oc=AdoDQFDNAty64cgqoyrYNcLsolCHHoWMmPuy3DTPCMyGAp_ljPRTAYe5KwvGfovljTU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGcTHJc0ofGbwDSYHdCWhOPvlMco0iDpFoJKhZD-y0lsw&oe=6A843F4C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "forest trailer.png", "id": "988047351647701", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/10000000_988047361647700_5249813252618530611_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IHcQ-qdG7uYQ7kNvwGo9ObB&_nc_oc=AdqPtrmijDiDZxBYgGaL2AxHWjiJd7moIDTnHF3jtrvyKJ7wxmT62lN6HPQg3GwVyx0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5eZ7I8TEn7BbctmoXsTD_nDmqVJ5yc7O-D7JW8mlpVw&oe=6A84400B"}, "display_name": "Solas VR", "keywords": ["Meditation", "Nature", "Productivity", "Relaxation", "Mindfulness"], "long_description": "Solas Meditation is the VR app that goes beyond meditation as we know it. With an immersive gallery of landscapes, nature sounds and guidance, Solas VR meditation replicates the real feeling of being out there, close to nature, enjoying the inner calmness we are made for. Bringing together eternal wisdom and cutting edge technology, Solas Meditation is designed for urban living, as a shield against stress, confusion and rush. The graphics and sounds, provided directly by nature, create a seamless multi-sensory experience, initiating a journey within. \nWith Solas Meditation you will feel more. You will do more. You will be more.", "short_description": "Add a new dimension to your meditation and allow nature to take you on a journey within. Solas VR presents a gallery of landscapes, nature sounds and guided meditations, designed to refresh your mind, spirit and soul.  This wonderful VR experience is the perfect micro break in nature that you can take while living an urban life.  Why settle with two dimensions, when you can have more? Why not dive inside your inner wisdom where you can be more?"}]}, "developer_name": "Virtual Reality Ireland Media Ltd.", "developer_privacy_policy_url": "https://www.solasvr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.solasvr.com/terms-of-service/", "publisher_name": "Tiesto Capital Ltd", "support_website_url": "https://www.solasvr.com/about/", "website_url": "https://www.solasvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphic
-wDT3UQ7kNvwFjxBgp&_nc_oc=AdrudeiA3qsB2NB-SQZ3H4Asu6utjYjnaBUFg5cYAKTAm79CaRyR64if6jM7uC6crwQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3SdwgZ6Rng1banle9qI9NR9xa1PjTjJrx-ZroDwpCLQ&oe=6A7C7628"}, {"file_name": "Glendalough lake.png", "id": "317898529368349", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036652_317898532701682_1088784562417673472_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NfXgPrcjx38Q7kNvwGNKP8Y&_nc_oc=Ado1iaKnIoKXOKtntD1-s5UHdBu464L-ndbCt2CqJ8YiU4KRTg0fp06y9BcR1YrDIHI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEeFGg_s48VWuLRCg6f-wI5LPY2aak0oRhXFba1Q_118g&oe=6A7C74DB"}, {"file_name": "Powerscourt waterfall.png", "id": "293387855349260", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75207237_293387858682593_3625796469231178237_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cpb7923Va1MQ7kNvwFFOWxm&_nc_oc=AdrhbplChymhcL6Xmt9sj4wDayb5KjWPfDF8oeNn2AmE70C4Zd2REeK3Dq77ycyzeBI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHlECeV2QgIGW7k1-neKCaIqIb2pxXMBrbpJ70zq1HqRQ&oe=6A7C609A"}, {"file_name": "Beach wexford.png", "id": "290192465660275", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75222938_290192468993608_254672737452146756_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dr-SyzahH1sQ7kNvwHslqDI&_nc_oc=AdplxeAMPEBz9d2GzJwRS5SV7HF3J056sjJSx4oDXR3PJAB4U0C7cD9aG7q2bjn4BLo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6pt89CGTK1lgMVGyw0pOAAjWBpLQu-2RYvA70uhQ77A&oe=6A7C564C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "forest trailer.png", "id": "988047351647701", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/10000000_988047361647700_5249813252618530611_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cJ4_mL7de7AQ7kNvwHG3IRh&_nc_oc=AdqQ0ITSXWlN8hFNttfRnulpeL_oy7E66oULvfKbQTiH-bIskT4CMT4FJTYRBAUWH5A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXyy5S7eRLPaO5bT1Hv10YXiD6ws7RPbADNJUXTudf6Q&oe=6A7C570B"}, "display_name": "Solas VR", "keywords": ["Meditation", "Nature", "Productivity", "Relaxation", "Mindfulness"], "long_description": "Solas Meditation is the VR app that goes beyond meditation as we know it. With an immersive gallery of landscapes, nature sounds and guidance, Solas VR meditation replicates the real feeling of being out there, close to nature, enjoying the inner calmness we are made for. Bringing together eternal wisdom and cutting edge technology, Solas Meditation is designed for urban living, as a shield against stress, confusion and rush. The graphics and sounds, provided directly by nature, create a seamless multi-sensory experience, initiating a journey within. \nWith Solas Meditation you will feel more. You will do more. You will be more.", "short_description": "Add a new dimension to your meditation and allow nature to take you on a journey within. Solas VR presents a gallery of landscapes, nature sounds and guided meditations, designed to refresh your mind, spirit and soul.  This wonderful VR experience is the perfect micro break in nature that you can take while living an urban life.  Why settle with two dimensions, when you can have more? Why not dive inside your inner wisdom where you can be more?"}]}, "developer_name": "Virtual Reality Ireland Media Ltd.", "developer_privacy_policy_url": "https://www.solasvr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.solasvr.com/terms-of-service/", "publisher_name": "Tiesto Capital Ltd", "support_website_url": "https://www.solasvr.com/about/", "website_url": "https://www.solasvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphic
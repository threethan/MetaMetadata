gg4WP0Q7kNvwG0YR2S&_nc_oc=AdojzpfRXU3lqgdaEegIabqaP6UJ2X6DNeP1PoxnJOdFv-plIt0NXqdsAh5UO8rrFf8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUQiGWGQqohdlladMZG2hAEpwmEINiXnupTDTyGHJzcQ&oe=6AB3D528"}, {"file_name": "Glendalough lake.png", "id": "317898529368349", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036652_317898532701682_1088784562417673472_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-vWWdP2QxgYQ7kNvwHeDJsC&_nc_oc=Ado39zgXBITR5MNQJ78ijsN0MXYANKD69jL-ICPTQUftqjH3aKOPQzmz7_V1cE1n-i8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKM5_7szkJHXMP7vpVEQkyPkNDqsoopuphZUORIXiJ3aA&oe=6AB3D3DB"}, {"file_name": "Powerscourt waterfall.png", "id": "293387855349260", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75207237_293387858682593_3625796469231178237_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-CcdXm1F8EoQ7kNvwFk-tXL&_nc_oc=AdoTWORTRYdWLdkuIsqGWc0HB5VI5wvLTPQAWlbp6HOBNu_nx7RP3AOpAumL7K4lKLo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjCEd3m1OtMfnq6qVF2fVl0UrDTOS0mPnILeCVzjL5jA&oe=6AB3F7DA"}, {"file_name": "Beach wexford.png", "id": "290192465660275", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75222938_290192468993608_254672737452146756_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CvyQw6RCPakQ7kNvwFj5G2r&_nc_oc=AdoHV1iRYCAzxWEltLozdj01WO6YBQ2FBWY7RUaZk1p0_M4A_KzLr0XSKwgAo90rb2o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2BtMlWxQW33zZCCv8tlPoJTGfYbaju4jHxiZtG5-yig&oe=6AB3ED8C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "forest trailer.png", "id": "988047351647701", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/10000000_988047361647700_5249813252618530611_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=USTKGXkYwagQ7kNvwE1X9OJ&_nc_oc=AdpwhV5FaaCHZe1hFTLFxKowIemA3V5h1jtSoO0S6Q_jdle-3pcHQne-5jefeZxNIoU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfJapXGniylPdEB0y2BPgj1hz8L-c2MGZz8sHce042Og&oe=6AB3EE4B"}, "display_name": "Solas VR", "keywords": ["Meditation", "Nature", "Productivity", "Relaxation", "Mindfulness"], "long_description": "Solas Meditation is the VR app that goes beyond meditation as we know it. With an immersive gallery of landscapes, nature sounds and guidance, Solas VR meditation replicates the real feeling of being out there, close to nature, enjoying the inner calmness we are made for. Bringing together eternal wisdom and cutting edge technology, Solas Meditation is designed for urban living, as a shield against stress, confusion and rush. The graphics and sounds, provided directly by nature, create a seamless multi-sensory experience, initiating a journey within. \nWith Solas Meditation you will feel more. You will do more. You will be more.", "short_description": "Add a new dimension to your meditation and allow nature to take you on a journey within. Solas VR presents a gallery of landscapes, nature sounds and guided meditations, designed to refresh your mind, spirit and soul.  This wonderful VR experience is the perfect micro break in nature that you can take while living an urban life.  Why settle with two dimensions, when you can have more? Why not dive inside your inner wisdom where you can be more?"}]}, "developer_name": "Virtual Reality Ireland Media Ltd.", "developer_privacy_policy_url": "https://www.solasvr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.solasvr.com/terms-of-service/", "publisher_name": "Tiesto Capital Ltd", "support_website_url": "https://www.solasvr.com/about/", "website_url": "https://www.solasvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphic
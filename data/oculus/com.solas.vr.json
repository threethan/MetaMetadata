rdpJ_YQ7kNvwG6EYK6&_nc_oc=AdpxCadleIAy4qgB6sXr5_-_exFSlurAKQvc5D3gtIEf-uVB28_dqcQrT7hRICYccXI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-PZhgmYE3M62oOoqdHZnXnxbXeRWTB9FsUxiARyqghg&oe=6A184428"}, {"file_name": "Glendalough lake.png", "id": "317898529368349", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036652_317898532701682_1088784562417673472_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bhJzyHGPwKcQ7kNvwGMcT3i&_nc_oc=AdrDGVAwx8lqD_4rrgMfMCHorcxl7CZXAGQ6xPrttk4aMV6OOHmnY73MS22yb6dFhVA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7NB9cisHDdS6k0vKhsm0XziLA6FKPSP1lCwvytfE52JA&oe=6A1842DB"}, {"file_name": "Powerscourt waterfall.png", "id": "293387855349260", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75207237_293387858682593_3625796469231178237_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CfgDsOHsKLAQ7kNvwGf0Nzh&_nc_oc=Adonaa4M1v2WU2wEugDQDXTwJ3UVC_AcoVHcpEZXmPi5E-mqfNybD6_yoAoTCRYCmxQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7JlD_b4dN9GpgiZ5wNvr1nd1Iv_wXQROqyvxmAqSLv_A&oe=6A1866DA"}, {"file_name": "Beach wexford.png", "id": "290192465660275", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75222938_290192468993608_254672737452146756_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F3No6uAzxSQQ7kNvwHtzxGu&_nc_oc=Adr2kHX0vtuzCvR2vRQJTxxMqMZuHlHMwamGTzLP4gKONz3QryXTZBTddreJchRGPEk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7zuGZkcVFZbxtIEa-n8x-mOCOvPBy7FcP8q56wfEMzLQ&oe=6A185C8C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "forest trailer.png", "id": "988047351647701", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/10000000_988047361647700_5249813252618530611_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CK7vtumCvPsQ7kNvwGy83E7&_nc_oc=AdpkM4YPcFqDXLpGCI1rHDfSZzn2nSjga2jXPkkQmrUqLOACTvk4pUSodfGdP-gGg3g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ZD_2KNYqVAcbLvkEPqE47VCjspVuJLnLbqZwMh8z3Zg&oe=6A185D4B"}, "display_name": "Solas VR", "keywords": ["Meditation", "Nature", "Productivity", "Relaxation", "Mindfulness"], "long_description": "Solas Meditation is the VR app that goes beyond meditation as we know it. With an immersive gallery of landscapes, nature sounds and guidance, Solas VR meditation replicates the real feeling of being out there, close to nature, enjoying the inner calmness we are made for. Bringing together eternal wisdom and cutting edge technology, Solas Meditation is designed for urban living, as a shield against stress, confusion and rush. The graphics and sounds, provided directly by nature, create a seamless multi-sensory experience, initiating a journey within. \nWith Solas Meditation you will feel more. You will do more. You will be more.", "short_description": "Add a new dimension to your meditation and allow nature to take you on a journey within. Solas VR presents a gallery of landscapes, nature sounds and guided meditations, designed to refresh your mind, spirit and soul.  This wonderful VR experience is the perfect micro break in nature that you can take while living an urban life.  Why settle with two dimensions, when you can have more? Why not dive inside your inner wisdom where you can be more?"}]}, "developer_name": "Virtual Reality Ireland Media Ltd.", "developer_privacy_policy_url": "https://www.solasvr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.solasvr.com/terms-of-service/", "publisher_name": "Tiesto Capital Ltd", "support_website_url": "https://www.solasvr.com/about/", "website_url": "https://www.solasvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphic
JX9FawQ7kNvwGfhGEw&_nc_oc=AdqxkmeKRQWMlRk8N4Z4u5UKP2peelfPCRMBir30ByNmHX0h7UZaPdnHCoVxqZl5wUE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3D9PN4OikG-9oTg3mMijLbc6r5EzY3i3MIccSZ99SuRQ&oe=69E0E528"}, {"file_name": "Glendalough lake.png", "id": "317898529368349", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036652_317898532701682_1088784562417673472_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0hlSfayJt2wQ7kNvwHiR-mS&_nc_oc=Ado8LTx3cIfa76qPfzsopfUW2IfKCMLPhRBWSIRd8LGqoBg6Z0U14DAGIsrVjJ_lO50&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1WjVZ5McrvPIDsNg-WocmN6l3YAkJmZ0qqvuSbKpmdew&oe=69E0E3DB"}, {"file_name": "Powerscourt waterfall.png", "id": "293387855349260", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75207237_293387858682593_3625796469231178237_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hs3J1orlHiAQ7kNvwGbzygd&_nc_oc=AdqWon2slmMHNlzg1B56vv-TjLAFdCCTauSkif5TMcrebTHFMKx4OJ_xXy-piAe3aOI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Q5e-pvP9H5TQ0wAxz6VTD0a_jSNC-6-r2Jw5u1-aiaQ&oe=69E0CF9A"}, {"file_name": "Beach wexford.png", "id": "290192465660275", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75222938_290192468993608_254672737452146756_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cYP2aevxaMAQ7kNvwHUwk2r&_nc_oc=Adoyg_L6QYWhGH9opDm9T8QBTeHJEL7FcjG_n9CLLOEo-SA5m9I9asbETsfHAVvGDyo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1yUUaCoNO_PLMEUpBvcL-lSSjZ924deEC2tuoSFXk3MA&oe=69E0FD8C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "forest trailer.png", "id": "988047351647701", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/10000000_988047361647700_5249813252618530611_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cn9G1p6KMAYQ7kNvwFU6v-u&_nc_oc=AdoEYx0UE1TLx8lB3wAk1CN7O_vhCqlXLaBCX__aOW9Fte-c6KKSZb5WH8E7uQOxxIY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af23A8TQ0IfjiffNWocyzdU2C1W5H1DFijTCKIrSSJAGgg&oe=69E0FE4B"}, "display_name": "Solas VR", "keywords": ["Meditation", "Nature", "Productivity", "Relaxation", "Mindfulness"], "long_description": "Solas Meditation is the VR app that goes beyond meditation as we know it. With an immersive gallery of landscapes, nature sounds and guidance, Solas VR meditation replicates the real feeling of being out there, close to nature, enjoying the inner calmness we are made for. Bringing together eternal wisdom and cutting edge technology, Solas Meditation is designed for urban living, as a shield against stress, confusion and rush. The graphics and sounds, provided directly by nature, create a seamless multi-sensory experience, initiating a journey within. \nWith Solas Meditation you will feel more. You will do more. You will be more.", "short_description": "Add a new dimension to your meditation and allow nature to take you on a journey within. Solas VR presents a gallery of landscapes, nature sounds and guided meditations, designed to refresh your mind, spirit and soul.  This wonderful VR experience is the perfect micro break in nature that you can take while living an urban life.  Why settle with two dimensions, when you can have more? Why not dive inside your inner wisdom where you can be more?"}]}, "developer_name": "Virtual Reality Ireland Media Ltd.", "developer_privacy_policy_url": "https://www.solasvr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.solasvr.com/terms-of-service/", "publisher_name": "Tiesto Capital Ltd", "support_website_url": "https://www.solasvr.com/about/", "website_url": "https://www.solasvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphic
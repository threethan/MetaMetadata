6q9eQ0Q7kNvwGwiFYq&_nc_oc=Adr4zl4Jj_E8qxycFq1VoqJuqFw7NtCUVa6adZWN8dg_gTcrLy2wuIRj4oMgNIhW84U&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-QHvXUJUCpyrs_2fa7d-UZELcvoo9-t6VoAjqn6BmWJA&oe=6A26C4A8"}, {"file_name": "Glendalough lake.png", "id": "317898529368349", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036652_317898532701682_1088784562417673472_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VrlN1OY75N4Q7kNvwGW-M1T&_nc_oc=AdovGI80rOrg9FCwV32aXH37gCnsLAVqRIyhX7CTgMXzLuqfRjSP2zG2FiqKcXbEilg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8PhU91npxqDfBT-j6Ys1EYX7tpWQ4Mk3y87mZd-AZBdQ&oe=6A26C35B"}, {"file_name": "Powerscourt waterfall.png", "id": "293387855349260", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75207237_293387858682593_3625796469231178237_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2UJWk8a6nBYQ7kNvwET_y8C&_nc_oc=AdpetNrUxA7UFX3736VoEGQnoexAE0q8ifc-Q8OT6s-f_B4dGIv3c35rah_ilgWUNhQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UF3iRaSAdEx34aFOaQOR_2yhRwRL75-VrtJJyrlPElQ&oe=6A26E75A"}, {"file_name": "Beach wexford.png", "id": "290192465660275", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75222938_290192468993608_254672737452146756_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eNIz0G3qVcgQ7kNvwFqr8n7&_nc_oc=Ado6etkAWyitId5ve16LfToinXrUboasWPsPXULDCcYs_6PN5nDXxq27s9qtJWp9oCI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Iu8n2s8W1VCAuHSdrZnDkRmimqWmaQy4cN46LIZmMZA&oe=6A26DD0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "forest trailer.png", "id": "988047351647701", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/10000000_988047361647700_5249813252618530611_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Ppoo4kP-9EQ7kNvwGK9MbP&_nc_oc=AdrUypKaRO6kW9UFjFg7omGPz1f4GOh6wFFTsSw1te_6eBKaOShfaVLhSDspyEHALmw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8II0jamfRkg4KSzCYnnqP4zoPMfbclU-6rucjKMa2dqA&oe=6A26DDCB"}, "display_name": "Solas VR", "keywords": ["Meditation", "Nature", "Productivity", "Relaxation", "Mindfulness"], "long_description": "Solas Meditation is the VR app that goes beyond meditation as we know it. With an immersive gallery of landscapes, nature sounds and guidance, Solas VR meditation replicates the real feeling of being out there, close to nature, enjoying the inner calmness we are made for. Bringing together eternal wisdom and cutting edge technology, Solas Meditation is designed for urban living, as a shield against stress, confusion and rush. The graphics and sounds, provided directly by nature, create a seamless multi-sensory experience, initiating a journey within. \nWith Solas Meditation you will feel more. You will do more. You will be more.", "short_description": "Add a new dimension to your meditation and allow nature to take you on a journey within. Solas VR presents a gallery of landscapes, nature sounds and guided meditations, designed to refresh your mind, spirit and soul.  This wonderful VR experience is the perfect micro break in nature that you can take while living an urban life.  Why settle with two dimensions, when you can have more? Why not dive inside your inner wisdom where you can be more?"}]}, "developer_name": "Virtual Reality Ireland Media Ltd.", "developer_privacy_policy_url": "https://www.solasvr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.solasvr.com/terms-of-service/", "publisher_name": "Tiesto Capital Ltd", "support_website_url": "https://www.solasvr.com/about/", "website_url": "https://www.solasvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphic
cwnnmEQ7kNvwEZNKq0&_nc_oc=AdrMJUwDr1P7iWVQUwg3tIHWIlKgvz5Wqpe8mfBJzrg-IGQaUmMknM0IlgifQ_Iq16k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af255nsrcWm547ym5dp7TkFnUbMlMSQ952AVDVdYkqy8vw&oe=69D65928"}, {"file_name": "Glendalough lake.png", "id": "317898529368349", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036652_317898532701682_1088784562417673472_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fKp51zI5A14Q7kNvwEdXEz2&_nc_oc=Adr6Q3oj75fOmHYJYG6kx1-HMN2MCZ3Iv4C4AVBRGCwOVZ8ab5rQX7Ks--GFngxY8D0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3-9CBT-fmvZBRuO0nJ-ClF80vJ0QHuHGHw9hVgINnzZQ&oe=69D657DB"}, {"file_name": "Powerscourt waterfall.png", "id": "293387855349260", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75207237_293387858682593_3625796469231178237_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HQklDzVjoyEQ7kNvwFkPmu0&_nc_oc=AdruWMrdR3488dAN9VyEzNy1tPfEt898eRUHlAyw1PnP9mrO1M2R3YuimhcE5B15t4k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2QMO3lADTe6rQBxM20ibXNYjCwWKshnazBRt4YiwV8vA&oe=69D6439A"}, {"file_name": "Beach wexford.png", "id": "290192465660275", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75222938_290192468993608_254672737452146756_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DcQsA2u1RmMQ7kNvwEq1kTz&_nc_oc=Adq115SO4C1yxb5vmnetfDMjD6x7N2r0h2yt4y1fi9eqiZ-nTPSbzRKGS4gXZ8hQYfg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3HfY_RFf9djX_FGHRtJhNudCja1YzRDCFhnSZ3MyUwVQ&oe=69D6394C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "forest trailer.png", "id": "988047351647701", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/10000000_988047361647700_5249813252618530611_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QXUiF4MHyVMQ7kNvwGeuOw8&_nc_oc=Adr_ORn6QC_glZgS3RqVLkcr0JWwvaS0l4CkSkFWHeUanoP8twr79w3TFIIpZVD-H4I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af28MCnogvV3QwtwXjbPK0Sjbz6bhGdujymi3bNd9vnNIg&oe=69D63A0B"}, "display_name": "Solas VR", "keywords": ["Meditation", "Nature", "Productivity", "Relaxation", "Mindfulness"], "long_description": "Solas Meditation is the VR app that goes beyond meditation as we know it. With an immersive gallery of landscapes, nature sounds and guidance, Solas VR meditation replicates the real feeling of being out there, close to nature, enjoying the inner calmness we are made for. Bringing together eternal wisdom and cutting edge technology, Solas Meditation is designed for urban living, as a shield against stress, confusion and rush. The graphics and sounds, provided directly by nature, create a seamless multi-sensory experience, initiating a journey within. \nWith Solas Meditation you will feel more. You will do more. You will be more.", "short_description": "Add a new dimension to your meditation and allow nature to take you on a journey within. Solas VR presents a gallery of landscapes, nature sounds and guided meditations, designed to refresh your mind, spirit and soul.  This wonderful VR experience is the perfect micro break in nature that you can take while living an urban life.  Why settle with two dimensions, when you can have more? Why not dive inside your inner wisdom where you can be more?"}]}, "developer_name": "Virtual Reality Ireland Media Ltd.", "developer_privacy_policy_url": "https://www.solasvr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.solasvr.com/terms-of-service/", "publisher_name": "Tiesto Capital Ltd", "support_website_url": "https://www.solasvr.com/about/", "website_url": "https://www.solasvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphic
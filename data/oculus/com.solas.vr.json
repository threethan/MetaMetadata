iAVuFcQ7kNvwEqRfV9&_nc_oc=Adr_k8K3yxLfnN7ZrbdxM3ZeuK-EcMDoOH4MjL3knMDaUZFaErP-tnMzrutDMq2wabw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxQDwatSyIrvXhGhMMqM_Fn78ClUXzWpg2Eg9K1ZnQkaA&oe=69C68728"}, {"file_name": "Glendalough lake.png", "id": "317898529368349", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036652_317898532701682_1088784562417673472_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=19sbdb8UI24Q7kNvwFYVGeJ&_nc_oc=AdogE7BkSgd0dxdIId77-s_DTrvxHVmME6nLrmjhT1HmdMYCcgiWgtQ7r6YWY8zr5Gw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy5HFxEzReNqEKMXD4mnPcZaMyDa4HssJaGEd0F1L9xUQ&oe=69C685DB"}, {"file_name": "Powerscourt waterfall.png", "id": "293387855349260", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75207237_293387858682593_3625796469231178237_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kyEN7xr0L1EQ7kNvwH68YGG&_nc_oc=Adp5o_kE4iEw5ci0fdlYCVHXL4yZew2v4ga0P2ZhI0aFX_kF13Rcas-ERgSy59Y_O4g&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwsJ6BEq0YKF8aHfakroYZ2pyOi0auUfjDH9HYZzEwHIQ&oe=69C6719A"}, {"file_name": "Beach wexford.png", "id": "290192465660275", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75222938_290192468993608_254672737452146756_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XDkVHFQJL6YQ7kNvwHtG5Cn&_nc_oc=Adp89ZBLfQ-5GvCwED182ZH1eUW0jlLdLrWbHXGNyzOqL69RlohkASaZCvrwOU9rhUc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy88PyYGv-dJn7gYjwLuHcj7ASR_Mo1qo5RWt6OlamjlQ&oe=69C6674C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "forest trailer.png", "id": "988047351647701", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/10000000_988047361647700_5249813252618530611_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kEqhzXKZACAQ7kNvwHGyMrt&_nc_oc=AdqGmCtePIcd1uojNo1mZRDQwZFelSloKsyN1PEPvjLnrb3WRNgXB-Bv3ewvCqz6zns&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyzKsjQ1gUMqmoUrA-6hzZL2cTZU4B270d9R6LWrEnOFg&oe=69C6680B"}, "display_name": "Solas VR", "keywords": ["Meditation", "Nature", "Productivity", "Relaxation", "Mindfulness"], "long_description": "Solas Meditation is the VR app that goes beyond meditation as we know it. With an immersive gallery of landscapes, nature sounds and guidance, Solas VR meditation replicates the real feeling of being out there, close to nature, enjoying the inner calmness we are made for. Bringing together eternal wisdom and cutting edge technology, Solas Meditation is designed for urban living, as a shield against stress, confusion and rush. The graphics and sounds, provided directly by nature, create a seamless multi-sensory experience, initiating a journey within. \nWith Solas Meditation you will feel more. You will do more. You will be more.", "short_description": "Add a new dimension to your meditation and allow nature to take you on a journey within. Solas VR presents a gallery of landscapes, nature sounds and guided meditations, designed to refresh your mind, spirit and soul.  This wonderful VR experience is the perfect micro break in nature that you can take while living an urban life.  Why settle with two dimensions, when you can have more? Why not dive inside your inner wisdom where you can be more?"}]}, "developer_name": "Virtual Reality Ireland Media Ltd.", "developer_privacy_policy_url": "https://www.solasvr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.solasvr.com/terms-of-service/", "publisher_name": "Tiesto Capital Ltd", "support_website_url": "https://www.solasvr.com/about/", "website_url": "https://www.solasvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphic
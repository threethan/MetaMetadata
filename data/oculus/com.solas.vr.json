J-8pVmk85_t8xDQr4hqwTd69wg-ds7b5YzcFmCi8TS43gZ91ASeczx0JzyzWA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxN1Ocn-doMjjR0vTFrVLPld4WdRWuwECIyvKoUYYJfpA&oe=69BD4CA8"}, {"file_name": "Glendalough lake.png", "id": "317898529368349", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036652_317898532701682_1088784562417673472_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qT-0FFrbI3kQ7kNvwF4Ng_9&_nc_oc=Adk41jqHeL9kpecYERNxRSHcfsjpvii6bNqlrnI6J8OK6AGmQ37z4e_c01lJOJlBTZg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwsEO6iBsqjwmp5sjRp-9FCGDSJHnuCn-lxXu22WEAr-A&oe=69BD4B5B"}, {"file_name": "Powerscourt waterfall.png", "id": "293387855349260", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75207237_293387858682593_3625796469231178237_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zbCEDjVA-JkQ7kNvwE6GTTG&_nc_oc=AdnrZ1FLtbNdaVcsXtt_3GbEMaNbXpgJYkIZ93p4XdcQSc3i5Rd1MvMKlQBkp7LCeS4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwBjKmfeKEyGdf58LGLqekVYEWmlqtkmxu6ibzKoItfXQ&oe=69BD371A"}, {"file_name": "Beach wexford.png", "id": "290192465660275", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75222938_290192468993608_254672737452146756_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=px0GJlUdnmQQ7kNvwEzv9SG&_nc_oc=AdluBWpb8bnkBJCPW40v8ktFQ7IrIeRVNspntbY8pjx_LcmV7_oOUfvzouQMxjRHpJo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyrtpVkWnYYxUKioU4G7yyMmkOdxIGyuMKldziFUiRU2w&oe=69BD2CCC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "forest trailer.png", "id": "988047351647701", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/10000000_988047361647700_5249813252618530611_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FbHkg6_VrJMQ7kNvwERPzaz&_nc_oc=Adnguv8jzHjECDUAJtAuOwEpB8nG2pwOg9OYEidrk3Wjq8GPSrWHMIeYPOg5gGN3xhs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwBbfpYPpAj7t3OXtZ4yEpW02q8ajrXZK_Ttu-6OjMhKg&oe=69BD2D8B"}, "display_name": "Solas VR", "keywords": ["Meditation", "Nature", "Productivity", "Relaxation", "Mindfulness"], "long_description": "Solas Meditation is the VR app that goes beyond meditation as we know it. With an immersive gallery of landscapes, nature sounds and guidance, Solas VR meditation replicates the real feeling of being out there, close to nature, enjoying the inner calmness we are made for. Bringing together eternal wisdom and cutting edge technology, Solas Meditation is designed for urban living, as a shield against stress, confusion and rush. The graphics and sounds, provided directly by nature, create a seamless multi-sensory experience, initiating a journey within. \nWith Solas Meditation you will feel more. You will do more. You will be more.", "short_description": "Add a new dimension to your meditation and allow nature to take you on a journey within. Solas VR presents a gallery of landscapes, nature sounds and guided meditations, designed to refresh your mind, spirit and soul.  This wonderful VR experience is the perfect micro break in nature that you can take while living an urban life.  Why settle with two dimensions, when you can have more? Why not dive inside your inner wisdom where you can be more?"}]}, "developer_name": "Virtual Reality Ireland Media Ltd.", "developer_privacy_policy_url": "https://www.solasvr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.solasvr.com/terms-of-service/", "publisher_name": "Tiesto Capital Ltd", "support_website_url": "https://www.solasvr.com/about/", "website_url": "https://www.solasvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommende
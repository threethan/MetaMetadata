kGW9lgQ7kNvwFNrYmf&_nc_oc=AdoNhkwMdpUBOEuKHkCKy8-H8QKR94ZGVhakvi9usR7ET_6kvvOd37OPhLcBYi6naEA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJclSalH_SQjFEMeKDRLx6aaa-I9gv5AsiwOwZCPHexvw&oe=6A9C1A28"}, {"file_name": "Glendalough lake.png", "id": "317898529368349", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036652_317898532701682_1088784562417673472_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RRzoFyicNDkQ7kNvwGRPtkw&_nc_oc=AdrqoZLIp8Y7Bf2Xu8A8Wo6VxztQjHf4sMRG6u69UkBr5TU04DB3z53jB9fOGoX0j-0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKiWrp_2faP3DeCrqdAc7kKJ-kntdlRPBo1g4EXfan5fw&oe=6A9C18DB"}, {"file_name": "Powerscourt waterfall.png", "id": "293387855349260", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75207237_293387858682593_3625796469231178237_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zCEekc8OmokQ7kNvwHmTyQj&_nc_oc=Adq9s8NeLj12AGG6-af6XALANX3gxC9qUMl5O_pf-TSEU4en4UJHZpOABav0T5eGPy4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0u0fS_ehZL1OEWpepxNGp-Icplpyop2xvdZw98wSmQA&oe=6A9C3CDA"}, {"file_name": "Beach wexford.png", "id": "290192465660275", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75222938_290192468993608_254672737452146756_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9MJlQgMLSjoQ7kNvwGXMEmp&_nc_oc=AdrD6cJSl8iHJx5OIoA08a1lSjaja5RL3uiHEc8W8AF1HreFYL5Ip81in4Tg8iZN8V0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIklEPQSPYDyDGEbAmBEXV63aWx7PriB1y58RkU9JR-rg&oe=6A9C328C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "forest trailer.png", "id": "988047351647701", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/10000000_988047361647700_5249813252618530611_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x0cFYqBjBnsQ7kNvwGlJoD_&_nc_oc=Adobj5SmnJMs4rb5nm52DAjaq_JpLMqxjw06tShh3MDBE9qFIe-UGFj5O7r1dWtrZ_E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI3wqiQMVjMsZPCwDHkCR8-1bJde0Dt70OJAUB9cwM09g&oe=6A9C334B"}, "display_name": "Solas VR", "keywords": ["Meditation", "Nature", "Productivity", "Relaxation", "Mindfulness"], "long_description": "Solas Meditation is the VR app that goes beyond meditation as we know it. With an immersive gallery of landscapes, nature sounds and guidance, Solas VR meditation replicates the real feeling of being out there, close to nature, enjoying the inner calmness we are made for. Bringing together eternal wisdom and cutting edge technology, Solas Meditation is designed for urban living, as a shield against stress, confusion and rush. The graphics and sounds, provided directly by nature, create a seamless multi-sensory experience, initiating a journey within. \nWith Solas Meditation you will feel more. You will do more. You will be more.", "short_description": "Add a new dimension to your meditation and allow nature to take you on a journey within. Solas VR presents a gallery of landscapes, nature sounds and guided meditations, designed to refresh your mind, spirit and soul.  This wonderful VR experience is the perfect micro break in nature that you can take while living an urban life.  Why settle with two dimensions, when you can have more? Why not dive inside your inner wisdom where you can be more?"}]}, "developer_name": "Virtual Reality Ireland Media Ltd.", "developer_privacy_policy_url": "https://www.solasvr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.solasvr.com/terms-of-service/", "publisher_name": "Tiesto Capital Ltd", "support_website_url": "https://www.solasvr.com/about/", "website_url": "https://www.solasvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphic
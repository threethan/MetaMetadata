mTgDPkQ7kNvwGv09bY&_nc_oc=AdrGmss7gCF3or7ib_0h9KgUZZ1A2sSIUhZ5qhr72q4kjcKl-d2XK61rw7cGwsFCSZU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCeMn-k_WPxDyEHkt5K3VpSGDT5JAeZPgd4XXday56eyw&oe=6A50F4A8"}, {"file_name": "Glendalough lake.png", "id": "317898529368349", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036652_317898532701682_1088784562417673472_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O3NuzHajIuMQ7kNvwGBhNcM&_nc_oc=AdpUtHQZdCoStK3h5Bx9p8LsfUcyWKHyIurPiJ4qeNsW8Xi_EoPtMJDjfFdcjqndnug&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDOJaHsU9ZZG-ZKFX5LodDr2quiWtLZgG5EbKD7kaWOoQ&oe=6A50F35B"}, {"file_name": "Powerscourt waterfall.png", "id": "293387855349260", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75207237_293387858682593_3625796469231178237_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Urv6CU9llMQ7kNvwHqP3bV&_nc_oc=Adr0UOvmCLobCTwDiWATxnr3aUtPgpesyUgfv5KHSencV5ENUSWyelnsEFRmVQEN12o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCbitK53W1E4eU1mPFbiqPuSKaKpBpK3dK8UEpbEayhGQ&oe=6A51175A"}, {"file_name": "Beach wexford.png", "id": "290192465660275", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75222938_290192468993608_254672737452146756_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7_AWDoA7JMIQ7kNvwF9w7NT&_nc_oc=Adp6B_arQop6c0-X7hBG1hygT2uhPuN3oqkQSebqHgWhsBbdVhEpDSikiYy0ZrJdBVQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDFCZyODotiTFIkXrTaOkfbpUblt2xghk2_4ie5Ob6Geg&oe=6A510D0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "forest trailer.png", "id": "988047351647701", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/10000000_988047361647700_5249813252618530611_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zF2HVUy3LZYQ7kNvwEn-pAz&_nc_oc=AdpCgZm0zjDIqAtpB9MmR7WbmVKaZQa7yte-JcKEpeEdlz65g9ONByrR6tSJ05lilAM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJDOiUSEuk7H-dMi_JXJD7i4nd-1z0KorA8sP6UljNMw&oe=6A510DCB"}, "display_name": "Solas VR", "keywords": ["Meditation", "Nature", "Productivity", "Relaxation", "Mindfulness"], "long_description": "Solas Meditation is the VR app that goes beyond meditation as we know it. With an immersive gallery of landscapes, nature sounds and guidance, Solas VR meditation replicates the real feeling of being out there, close to nature, enjoying the inner calmness we are made for. Bringing together eternal wisdom and cutting edge technology, Solas Meditation is designed for urban living, as a shield against stress, confusion and rush. The graphics and sounds, provided directly by nature, create a seamless multi-sensory experience, initiating a journey within. \nWith Solas Meditation you will feel more. You will do more. You will be more.", "short_description": "Add a new dimension to your meditation and allow nature to take you on a journey within. Solas VR presents a gallery of landscapes, nature sounds and guided meditations, designed to refresh your mind, spirit and soul.  This wonderful VR experience is the perfect micro break in nature that you can take while living an urban life.  Why settle with two dimensions, when you can have more? Why not dive inside your inner wisdom where you can be more?"}]}, "developer_name": "Virtual Reality Ireland Media Ltd.", "developer_privacy_policy_url": "https://www.solasvr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.solasvr.com/terms-of-service/", "publisher_name": "Tiesto Capital Ltd", "support_website_url": "https://www.solasvr.com/about/", "website_url": "https://www.solasvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphic
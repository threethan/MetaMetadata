t8RQHcQ7kNvwEttOhO&_nc_oc=AdpSMHjYp8KdY3MibKp73s1N-tRtumNU4KcC0x2EyQBvAUR7xeDBgAScGKGbXgWQ8w0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Vys7Rp3aerROXppjGkc0-wDVC73PcL9g9rDNpYWJvaQ&oe=6A37E828"}, {"file_name": "Glendalough lake.png", "id": "317898529368349", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036652_317898532701682_1088784562417673472_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bm1OCsAButUQ7kNvwHpbg5q&_nc_oc=Adp86UdtJbiY2s8kwtF0j7DeoTrAvR7OT5GDLkx4AhwWOVIuI9LOp0bXf3h_A-7cixo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9WWMBywGPmC1G91FZN9XJT-aKPrXpoHTUxwgQpnLNFvg&oe=6A37E6DB"}, {"file_name": "Powerscourt waterfall.png", "id": "293387855349260", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75207237_293387858682593_3625796469231178237_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ja1Y7GJFtVIQ7kNvwFoudPz&_nc_oc=AdpDqMICoZL7uRubW2PvLm6HF_BUixmWwJW9AlDSX_RX1SAqMxmnkvoWWm_Z4ImsNMA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1STAjH7O03dpAdJ3bTDojT-4ANYZXGUI5KXGJv0wk1A&oe=6A380ADA"}, {"file_name": "Beach wexford.png", "id": "290192465660275", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75222938_290192468993608_254672737452146756_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f19BuLW50ScQ7kNvwF84b6h&_nc_oc=AdqvspQcN8TZraVAK3mB64wh8YdeEKsVIFGon8iI3-euhECsBJZvRkaNYmvTciLuoiM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_1e4skKX9Yohax7UHDOMpylZUeGLTEwtw4rf7M33thYw&oe=6A38008C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "forest trailer.png", "id": "988047351647701", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/10000000_988047361647700_5249813252618530611_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aTscRCOmCNAQ7kNvwHbM4js&_nc_oc=AdqPRlwiwmFUkjRgmQhPRvexu5JUmKuPGQ0KnXVWFK5ZhTR07iQkk6FefZHz_dzo2aU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9FjB3wp0wiYHnkz8_vWZUcWHXum_9mHTvsJLv8aMaplg&oe=6A38014B"}, "display_name": "Solas VR", "keywords": ["Meditation", "Nature", "Productivity", "Relaxation", "Mindfulness"], "long_description": "Solas Meditation is the VR app that goes beyond meditation as we know it. With an immersive gallery of landscapes, nature sounds and guidance, Solas VR meditation replicates the real feeling of being out there, close to nature, enjoying the inner calmness we are made for. Bringing together eternal wisdom and cutting edge technology, Solas Meditation is designed for urban living, as a shield against stress, confusion and rush. The graphics and sounds, provided directly by nature, create a seamless multi-sensory experience, initiating a journey within. \nWith Solas Meditation you will feel more. You will do more. You will be more.", "short_description": "Add a new dimension to your meditation and allow nature to take you on a journey within. Solas VR presents a gallery of landscapes, nature sounds and guided meditations, designed to refresh your mind, spirit and soul.  This wonderful VR experience is the perfect micro break in nature that you can take while living an urban life.  Why settle with two dimensions, when you can have more? Why not dive inside your inner wisdom where you can be more?"}]}, "developer_name": "Virtual Reality Ireland Media Ltd.", "developer_privacy_policy_url": "https://www.solasvr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.solasvr.com/terms-of-service/", "publisher_name": "Tiesto Capital Ltd", "support_website_url": "https://www.solasvr.com/about/", "website_url": "https://www.solasvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphic
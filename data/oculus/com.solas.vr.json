PU_zcEQ7kNvwFbhMe4&_nc_oc=Adr80Ka34WWMkS9tXSuC4S2yX7y06-tGcq6OC6eilJL5WyjKdaZpu-twBW1YjJR4jvI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHzkkJsVzNvTEvGxjAVAFPwiiVr6yTGXjmqR_455REupQ&oe=6A7098A8"}, {"file_name": "Glendalough lake.png", "id": "317898529368349", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036652_317898532701682_1088784562417673472_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G1XBSmBNbGAQ7kNvwG1_FCQ&_nc_oc=AdoC3D_f6KIfvgmtHGWf1WxOxK67UEGqtPwi11IZ6FTWMsMr8pXRkWGPAEtPHID4g5M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFeqB_7qWKDE_5VRQnSCJVcSIh8qBf6le8JgsbcNemsXg&oe=6A70975B"}, {"file_name": "Powerscourt waterfall.png", "id": "293387855349260", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75207237_293387858682593_3625796469231178237_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ejn9ooXT6OUQ7kNvwGFRibW&_nc_oc=Adpzb6cau9ePBqGtFFbxUmvvTAc7WEAq9oQEhCPgxv8FZ4nNWvSmg5vr-Know06pmm4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG2crOXy5gall-ZJkii_pOqGAgfthgzXh3R8tE3MXnmMQ&oe=6A70831A"}, {"file_name": "Beach wexford.png", "id": "290192465660275", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75222938_290192468993608_254672737452146756_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UTfqNTzkXycQ7kNvwH5OoMD&_nc_oc=Adpc8Rxn8CRhSpN1YeRKUkzX2INttqHXKRVVkkITzcSW_VT-_pGzAfUjgzggxfdDNAQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGV6-O7VksVkp8bImhea5CeKQ42H18toE6IIcvyt6VGZw&oe=6A7078CC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "forest trailer.png", "id": "988047351647701", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/10000000_988047361647700_5249813252618530611_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JMNUuVL9kJEQ7kNvwFVJYox&_nc_oc=Adph6j7vwCZaUDYs1wX_mrPtaG8frh9LoJNj9F5oN0aMzrVxaFlYjLntRtdhJLXmgrw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFp8d5fo2bvhajaNworG5_7whiLKlLzFucuuCl98VPieA&oe=6A70798B"}, "display_name": "Solas VR", "keywords": ["Meditation", "Nature", "Productivity", "Relaxation", "Mindfulness"], "long_description": "Solas Meditation is the VR app that goes beyond meditation as we know it. With an immersive gallery of landscapes, nature sounds and guidance, Solas VR meditation replicates the real feeling of being out there, close to nature, enjoying the inner calmness we are made for. Bringing together eternal wisdom and cutting edge technology, Solas Meditation is designed for urban living, as a shield against stress, confusion and rush. The graphics and sounds, provided directly by nature, create a seamless multi-sensory experience, initiating a journey within. \nWith Solas Meditation you will feel more. You will do more. You will be more.", "short_description": "Add a new dimension to your meditation and allow nature to take you on a journey within. Solas VR presents a gallery of landscapes, nature sounds and guided meditations, designed to refresh your mind, spirit and soul.  This wonderful VR experience is the perfect micro break in nature that you can take while living an urban life.  Why settle with two dimensions, when you can have more? Why not dive inside your inner wisdom where you can be more?"}]}, "developer_name": "Virtual Reality Ireland Media Ltd.", "developer_privacy_policy_url": "https://www.solasvr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.solasvr.com/terms-of-service/", "publisher_name": "Tiesto Capital Ltd", "support_website_url": "https://www.solasvr.com/about/", "website_url": "https://www.solasvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphic
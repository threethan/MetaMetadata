kqsGqkQ7kNvwGDQAHr&_nc_oc=Adq2N3-8zat2dMWy5t-27qK_E6QMoQXM3pIG_zwkGrg6zDLoJa3PhgiLK4bmSrg1N2k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMmCL8gT9o4toBULkONzKAYUhfyvdGFDfNTNM2BUfw8OQ&oe=6AD227A8"}, {"file_name": "Glendalough lake.png", "id": "317898529368349", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036652_317898532701682_1088784562417673472_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UCyciG6z9NIQ7kNvwHdLWmD&_nc_oc=AdrBb5AdnrFQ5UXe2fj7TwiMA_H7m-qcWP5aWXusb_vcu6H4QyYC4c3AwmN51vM8nNU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPclEiDsUCkqEvrYgDwaMdVzXmdDX-BdDJYBhFdxyRyOA&oe=6AD2265B"}, {"file_name": "Powerscourt waterfall.png", "id": "293387855349260", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75207237_293387858682593_3625796469231178237_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GXwYSxgB8wcQ7kNvwE917ir&_nc_oc=AdoLAcA8VrwN9uaK7QrTT_IGePPWCchN6BUgKRXHKxtv7TOwc-9HxDoT75DImM_-yyg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMdmvvqmRi0_dJXBZjuQjAyaHF8TUvzRW8omjUbi9pVww&oe=6AD24A5A"}, {"file_name": "Beach wexford.png", "id": "290192465660275", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75222938_290192468993608_254672737452146756_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GQiiNYDXsZEQ7kNvwGn7KS-&_nc_oc=AdpOAjg5sYEQoYPL9XUr-9yV5PFR_OaMUDrakgO7LGY4Q1fk14tlzbq-DPMGmDzqimg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPN9hNvfB60B6V6tiDOccVFi3oEBaDg1V35rv5RD1DnZQ&oe=6AD2400C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "forest trailer.png", "id": "988047351647701", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/10000000_988047361647700_5249813252618530611_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CQwGY0ykfxYQ7kNvwGgFm-r&_nc_oc=Adrn-8VD-vDiujm75O6UlYoiUy-eygOC0-ptEyxFJEj_JWIw_ti-OIjdQxqtFn3yFMg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_a2OX5ACZkZ6P_3JQiv5L9DBiIT1lFXp3LWfMJdhC3A&oe=6AD240CB"}, "display_name": "Solas VR", "keywords": ["Meditation", "Nature", "Productivity", "Relaxation", "Mindfulness"], "long_description": "Solas Meditation is the VR app that goes beyond meditation as we know it. With an immersive gallery of landscapes, nature sounds and guidance, Solas VR meditation replicates the real feeling of being out there, close to nature, enjoying the inner calmness we are made for. Bringing together eternal wisdom and cutting edge technology, Solas Meditation is designed for urban living, as a shield against stress, confusion and rush. The graphics and sounds, provided directly by nature, create a seamless multi-sensory experience, initiating a journey within. \nWith Solas Meditation you will feel more. You will do more. You will be more.", "short_description": "Add a new dimension to your meditation and allow nature to take you on a journey within. Solas VR presents a gallery of landscapes, nature sounds and guided meditations, designed to refresh your mind, spirit and soul.  This wonderful VR experience is the perfect micro break in nature that you can take while living an urban life.  Why settle with two dimensions, when you can have more? Why not dive inside your inner wisdom where you can be more?"}]}, "developer_name": "Virtual Reality Ireland Media Ltd.", "developer_privacy_policy_url": "https://www.solasvr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.solasvr.com/terms-of-service/", "publisher_name": "Tiesto Capital Ltd", "support_website_url": "https://www.solasvr.com/about/", "website_url": "https://www.solasvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphic
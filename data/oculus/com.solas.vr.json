gFVZ24Q7kNvwG0QXAD&_nc_oc=Adq0gi6AU809Z7n_w8X-iFR8lHzvV2XGco4Bu-I_5Hjnbkl-oW4UYyHeJnWEIb0GEHg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8D3Lwyss4g0OG7nQ3B2ooIsvKRpTYGKHXX28xjLMxvUQ&oe=6A427428"}, {"file_name": "Glendalough lake.png", "id": "317898529368349", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036652_317898532701682_1088784562417673472_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2NJb6xhy7zgQ7kNvwEMR1F5&_nc_oc=AdrlJcKqBXhsmvhca7Ms91d3srfEwiV9MV7tHYAdf53nwjsTK2eUTyMxbimJfnCvirc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-o6G2j4m-N8bO50G_NSIgGBwsy3f7hq4hEhSKqGAsXw&oe=6A4272DB"}, {"file_name": "Powerscourt waterfall.png", "id": "293387855349260", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75207237_293387858682593_3625796469231178237_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RWsoBaj9zzkQ7kNvwH-nuhr&_nc_oc=AdrV8-Cxo8MJmKpZHurWPw8iLWTHCXTkU2O5MKzJno3xP72avR7eqIpJBaDc0Mc86-E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_trIgc_6WYjN9dXuvm3PNr4wDD2401CPJmGgxRvoqA4g&oe=6A4296DA"}, {"file_name": "Beach wexford.png", "id": "290192465660275", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75222938_290192468993608_254672737452146756_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dec0AzOREcAQ7kNvwGI5Rh5&_nc_oc=AdoqvbD_Jx5xHdLx5Drxti32Yx2uPT9yX1epuvp7d_LKcIEvFGSA0w3_70YDS56OI3Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_oFERkIRmqrXOsjEugK9JaNkxfdyQVba0Gp3-QsOepfw&oe=6A428C8C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "forest trailer.png", "id": "988047351647701", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/10000000_988047361647700_5249813252618530611_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ZCK_-BnTHQQ7kNvwFbTXGK&_nc_oc=Adqvnmsmv_2uArAHze90UTY_7MTi28z4du77FVnMPR7hRHnoCDGa4DJQWh2_0MOUW98&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af95RD47srgiqgElipMsM6yI6o6q0RS4IsA6yuSxg44v6A&oe=6A428D4B"}, "display_name": "Solas VR", "keywords": ["Meditation", "Nature", "Productivity", "Relaxation", "Mindfulness"], "long_description": "Solas Meditation is the VR app that goes beyond meditation as we know it. With an immersive gallery of landscapes, nature sounds and guidance, Solas VR meditation replicates the real feeling of being out there, close to nature, enjoying the inner calmness we are made for. Bringing together eternal wisdom and cutting edge technology, Solas Meditation is designed for urban living, as a shield against stress, confusion and rush. The graphics and sounds, provided directly by nature, create a seamless multi-sensory experience, initiating a journey within. \nWith Solas Meditation you will feel more. You will do more. You will be more.", "short_description": "Add a new dimension to your meditation and allow nature to take you on a journey within. Solas VR presents a gallery of landscapes, nature sounds and guided meditations, designed to refresh your mind, spirit and soul.  This wonderful VR experience is the perfect micro break in nature that you can take while living an urban life.  Why settle with two dimensions, when you can have more? Why not dive inside your inner wisdom where you can be more?"}]}, "developer_name": "Virtual Reality Ireland Media Ltd.", "developer_privacy_policy_url": "https://www.solasvr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.solasvr.com/terms-of-service/", "publisher_name": "Tiesto Capital Ltd", "support_website_url": "https://www.solasvr.com/about/", "website_url": "https://www.solasvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphic
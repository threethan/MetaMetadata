9Ciu_AQ7kNvwGlrOLK&_nc_oc=AdrnhXz5-sijl8RVxK0vYhvvdcnrvLh2PgSb8Jcm0FOV2_T5lG-K2gK2n0G-crR14xY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF5g7RgzcV0dUakxJb96HG1VyoWk5u_jBCxhgfCDsybow&oe=6A95BAE8"}, {"file_name": "Glendalough lake.png", "id": "317898529368349", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036652_317898532701682_1088784562417673472_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C-7CbbyMtJEQ7kNvwGtDZw8&_nc_oc=AdoHFuKX8vmg5caLj9p1NeOR4q-kvBINK1SqgjRHaI7Klc3gyLlDMrdAUBK6CHX9ZnU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7QcbzkAbs3vxM0DW-NuK2NSUoGLj3bot5SVdjOsuuhA&oe=6A95B99B"}, {"file_name": "Powerscourt waterfall.png", "id": "293387855349260", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75207237_293387858682593_3625796469231178237_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8DJlP0CRmxwQ7kNvwGrM3yK&_nc_oc=AdqO2Oq45BzDNnfJMn9VoKPXx0-euhjEqDSIn43TqCZZFe47JoMIrdElEbHtDCymwI0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDsdEM0DX5_caEYzISGqIMcokuSkzX49vujDFtunBHrA&oe=6A95DD9A"}, {"file_name": "Beach wexford.png", "id": "290192465660275", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75222938_290192468993608_254672737452146756_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YUxdZGHNQdoQ7kNvwEAZhK3&_nc_oc=AdqLMDqSXE3jvtXPscHgux0OEjjAzFLiYgr7GC9k4Li8P0_D0SNVyJQW5bR26M9PtYk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3lOFtTSAApsH-Dr2daM8NvfJ0CXxG1gJhqWArmkTOEA&oe=6A95D34C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "forest trailer.png", "id": "988047351647701", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/10000000_988047361647700_5249813252618530611_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wwxKhul5G6sQ7kNvwGf6t2-&_nc_oc=Ado6VLLoWNePNbLYflWI8uSmKS0kjRryaMyUhELxzBo6e9wRJ310VO7HAK1TNmcxe_o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkhgiwg5kwZLsKNq_b4423FJ28ipIqToudg7F38dfsFA&oe=6A95D40B"}, "display_name": "Solas VR", "keywords": ["Meditation", "Nature", "Productivity", "Relaxation", "Mindfulness"], "long_description": "Solas Meditation is the VR app that goes beyond meditation as we know it. With an immersive gallery of landscapes, nature sounds and guidance, Solas VR meditation replicates the real feeling of being out there, close to nature, enjoying the inner calmness we are made for. Bringing together eternal wisdom and cutting edge technology, Solas Meditation is designed for urban living, as a shield against stress, confusion and rush. The graphics and sounds, provided directly by nature, create a seamless multi-sensory experience, initiating a journey within. \nWith Solas Meditation you will feel more. You will do more. You will be more.", "short_description": "Add a new dimension to your meditation and allow nature to take you on a journey within. Solas VR presents a gallery of landscapes, nature sounds and guided meditations, designed to refresh your mind, spirit and soul.  This wonderful VR experience is the perfect micro break in nature that you can take while living an urban life.  Why settle with two dimensions, when you can have more? Why not dive inside your inner wisdom where you can be more?"}]}, "developer_name": "Virtual Reality Ireland Media Ltd.", "developer_privacy_policy_url": "https://www.solasvr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.solasvr.com/terms-of-service/", "publisher_name": "Tiesto Capital Ltd", "support_website_url": "https://www.solasvr.com/about/", "website_url": "https://www.solasvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphic
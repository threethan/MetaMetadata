RdDX4sQ7kNvwEbWXeF&_nc_oc=AdoEwgQSB9oUsaKaE0KjeSihuP-NBilEL_VrThJTG3e6_40iamv1tPS6btq57Jry8O0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUUF6HvAlOUtkxD1m-iFpNq3kcHwWq35C442C-YdyXww&oe=6A6B52A8"}, {"file_name": "Glendalough lake.png", "id": "317898529368349", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036652_317898532701682_1088784562417673472_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x_hbG62JTVYQ7kNvwEX_Z2l&_nc_oc=Adp_CSmbPEogtL-CgoQOiTtsWFeuDq-dOralSPWYzUwNqY6CpD4ia2EnzW5jwP_PmkA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBFUN4VaURf0LJzNF0x36hwxJe12Oxe0XWyc9vhXIQyew&oe=6A6B515B"}, {"file_name": "Powerscourt waterfall.png", "id": "293387855349260", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75207237_293387858682593_3625796469231178237_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bUDsgtUxJS8Q7kNvwFaAsSw&_nc_oc=AdqisQz0RVNcCctgjrSSL-DlY47ehF4MzU6HhCuU-2S329uF3BjrEw1wXykWkZWirDo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJZ3tnBftsZ92118WZObK2_HXxLHcuCCmgmB2XonlraQ&oe=6A6B3D1A"}, {"file_name": "Beach wexford.png", "id": "290192465660275", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75222938_290192468993608_254672737452146756_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c4thk6C7InkQ7kNvwHmsdGd&_nc_oc=AdpVzY74jmDaBchp9Z8TERvJH8jHDQeRVbl4wuhkpXloXlKCTDcZgaG84fgjb8sEwtY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCHQ6rEuvroha4qR1XvoqIAbw3VDMin6VIO-G9ub0iE9A&oe=6A6B6B0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "forest trailer.png", "id": "988047351647701", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/10000000_988047361647700_5249813252618530611_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dp9POMYHa0AQ7kNvwEPvdpA&_nc_oc=AdpjrBulJ6So68MnSnf_M75oGfDgMnxlI4ylJXOX5_c13gTamJQb3e1vvcS6CklcY3g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAdchxsdf007-OKmqr2h6svZGEx58Vb3Tcww6OuCYy4lg&oe=6A6B6BCB"}, "display_name": "Solas VR", "keywords": ["Meditation", "Nature", "Productivity", "Relaxation", "Mindfulness"], "long_description": "Solas Meditation is the VR app that goes beyond meditation as we know it. With an immersive gallery of landscapes, nature sounds and guidance, Solas VR meditation replicates the real feeling of being out there, close to nature, enjoying the inner calmness we are made for. Bringing together eternal wisdom and cutting edge technology, Solas Meditation is designed for urban living, as a shield against stress, confusion and rush. The graphics and sounds, provided directly by nature, create a seamless multi-sensory experience, initiating a journey within. \nWith Solas Meditation you will feel more. You will do more. You will be more.", "short_description": "Add a new dimension to your meditation and allow nature to take you on a journey within. Solas VR presents a gallery of landscapes, nature sounds and guided meditations, designed to refresh your mind, spirit and soul.  This wonderful VR experience is the perfect micro break in nature that you can take while living an urban life.  Why settle with two dimensions, when you can have more? Why not dive inside your inner wisdom where you can be more?"}]}, "developer_name": "Virtual Reality Ireland Media Ltd.", "developer_privacy_policy_url": "https://www.solasvr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.solasvr.com/terms-of-service/", "publisher_name": "Tiesto Capital Ltd", "support_website_url": "https://www.solasvr.com/about/", "website_url": "https://www.solasvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphic
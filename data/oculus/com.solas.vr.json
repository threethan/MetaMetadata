Hogy14Q7kNvwGwD3lp&_nc_oc=AdotfD80GCUxYSGiL0mTlySbwZdmjUgWG3SDnu_yX1ISHx-7XTaQvCgCjs2eKASEUMI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_FOkJa8HsmuZoO-hcKFqMcpymYOqbhmKQihLAGVFofzg&oe=6A32A228"}, {"file_name": "Glendalough lake.png", "id": "317898529368349", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39036652_317898532701682_1088784562417673472_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cNlil1LI5UAQ7kNvwHUcjUF&_nc_oc=Adpxc6GYy6EKmE_RbsX-jGtrwg62D0tuxVygnFjTYftMgqE2-G1-LBbIN1nrRsKn8as&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-EmJYR8AO9p2vVzxlCVVZhxsPBKnXYmGDLOxRxg_2_Mg&oe=6A32A0DB"}, {"file_name": "Powerscourt waterfall.png", "id": "293387855349260", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75207237_293387858682593_3625796469231178237_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3xkvimJ5zRwQ7kNvwHZufe1&_nc_oc=AdqPIhgDSQvQ7DEwFnlLKU-ZLVRLVMQbLZxi0KrM71NyZiDqYtwtCmi3yOC68uHoLs0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8s2-R1PZZ0hWH19gqPc33wU72nwKBgub9i9xDSruokSw&oe=6A32C4DA"}, {"file_name": "Beach wexford.png", "id": "290192465660275", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75222938_290192468993608_254672737452146756_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T1CJ_tlmI28Q7kNvwHJxGzp&_nc_oc=Ado0iuiRHOicJYZu68-JjQ2AOG3JFYvt2tIQ35g7g6ZfFbFapEA_JKqRwBMhdVdoQ0A&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_h9LIRKeCSvWl-uNv005ITJrsmZYMd96Vjc6iTXadttw&oe=6A32BA8C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "forest trailer.png", "id": "988047351647701", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/10000000_988047361647700_5249813252618530611_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AuxvngKEXSYQ7kNvwEGRmEp&_nc_oc=Adp_4CfEYhUsxYTWWIzKV2pWfJvuPhVnvCKtzLw2-GLs94kKXC5Ej-fLlx6GOl5hnF8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9bLXG5VpKzzoqa7DtkX9_G9X_VztzQ2q3C78rEFQDaWA&oe=6A32BB4B"}, "display_name": "Solas VR", "keywords": ["Meditation", "Nature", "Productivity", "Relaxation", "Mindfulness"], "long_description": "Solas Meditation is the VR app that goes beyond meditation as we know it. With an immersive gallery of landscapes, nature sounds and guidance, Solas VR meditation replicates the real feeling of being out there, close to nature, enjoying the inner calmness we are made for. Bringing together eternal wisdom and cutting edge technology, Solas Meditation is designed for urban living, as a shield against stress, confusion and rush. The graphics and sounds, provided directly by nature, create a seamless multi-sensory experience, initiating a journey within. \nWith Solas Meditation you will feel more. You will do more. You will be more.", "short_description": "Add a new dimension to your meditation and allow nature to take you on a journey within. Solas VR presents a gallery of landscapes, nature sounds and guided meditations, designed to refresh your mind, spirit and soul.  This wonderful VR experience is the perfect micro break in nature that you can take while living an urban life.  Why settle with two dimensions, when you can have more? Why not dive inside your inner wisdom where you can be more?"}]}, "developer_name": "Virtual Reality Ireland Media Ltd.", "developer_privacy_policy_url": "https://www.solasvr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.solasvr.com/terms-of-service/", "publisher_name": "Tiesto Capital Ltd", "support_website_url": "https://www.solasvr.com/about/", "website_url": "https://www.solasvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphic
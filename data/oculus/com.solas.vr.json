9moSPcQ7kNvwFJwq6g&_nc_oc=Adpe0Xk08xyYgtZp1Gd6yMRq9Oe6OaNMgYp3oVtDVNctt3aI5hMkMQU84ntBo59JYwA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ohXfFlepKuIfDfYBMBywVwCtlus5cn8enXmatV__SuQ&oe=69FC94A8"}, {"file_name": "Glendalough lake.png", "id": "317898529368349", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036652_317898532701682_1088784562417673472_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iy3mbTpxZO8Q7kNvwFeF5Sn&_nc_oc=AdrPa82a55p1rcWPg5_98mB5L5c04g4wgy9huLEBrP0EeUqV-lwg_0iK44IrGz--4C8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4cOlIAhLUU_4VzE_j-qL0OoK4VjJ0wHCCb5-K5jDiipg&oe=69FC935B"}, {"file_name": "Powerscourt waterfall.png", "id": "293387855349260", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75207237_293387858682593_3625796469231178237_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rkyl3IitL58Q7kNvwHzfUmX&_nc_oc=Adq9SC_UsY8BVWUYjG7-aoNbRsaHP-1F9M8uzlHpMaXca1FObJ87k251FHRO8NNLaUM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6GtZEscj4mWCrK6XvdmGxZAmq3DHbTigOw8qVhkboA5Q&oe=69FC7F1A"}, {"file_name": "Beach wexford.png", "id": "290192465660275", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75222938_290192468993608_254672737452146756_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bHMTb80rx_YQ7kNvwEmmC3a&_nc_oc=AdoqQSK7KKw5IaSROzcoGGBjV2rO3QRdLqLHfnWy9ipic8covbpbVwOkuSz-wcc4OG4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5jZ7R6M_ofGUmGaAQ90KidH-htF1X94tNYzDS0wihNFQ&oe=69FCAD0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "forest trailer.png", "id": "988047351647701", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/10000000_988047361647700_5249813252618530611_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-fhiaVcB_4EQ7kNvwH_ftSw&_nc_oc=AdorI2VLby5KBUQv5q2fKRL_uyGQW4fr1ByJfZd_DkehN-x-v7-Am_Th1JfAetO8rqA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4R4z_BB7RBVDQ9Kl1nAGghugfyR32Nj40x4P9C7LCtbg&oe=69FCADCB"}, "display_name": "Solas VR", "keywords": ["Meditation", "Nature", "Productivity", "Relaxation", "Mindfulness"], "long_description": "Solas Meditation is the VR app that goes beyond meditation as we know it. With an immersive gallery of landscapes, nature sounds and guidance, Solas VR meditation replicates the real feeling of being out there, close to nature, enjoying the inner calmness we are made for. Bringing together eternal wisdom and cutting edge technology, Solas Meditation is designed for urban living, as a shield against stress, confusion and rush. The graphics and sounds, provided directly by nature, create a seamless multi-sensory experience, initiating a journey within. \nWith Solas Meditation you will feel more. You will do more. You will be more.", "short_description": "Add a new dimension to your meditation and allow nature to take you on a journey within. Solas VR presents a gallery of landscapes, nature sounds and guided meditations, designed to refresh your mind, spirit and soul.  This wonderful VR experience is the perfect micro break in nature that you can take while living an urban life.  Why settle with two dimensions, when you can have more? Why not dive inside your inner wisdom where you can be more?"}]}, "developer_name": "Virtual Reality Ireland Media Ltd.", "developer_privacy_policy_url": "https://www.solasvr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.solasvr.com/terms-of-service/", "publisher_name": "Tiesto Capital Ltd", "support_website_url": "https://www.solasvr.com/about/", "website_url": "https://www.solasvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphic
_ohc=S54mqt0PoZ0Q7kNvwF74Iu5&_nc_oc=AdrDsXck0ZBYkE7qOxbE8Cg6JHmHxz211GXwTeK6X8rnfMNhe_c6-okBGzGRBC_K5aU&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6zo37EOHvUcIeuhqxNu5SyktK2f2Xg7QoL-X2eW2tYA&oe=6AA94928"}, {"file_name": "Glendalough lake.png", "id": "317898529368349", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39036652_317898532701682_1088784562417673472_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eKUnuRO3ejQQ7kNvwEMKjR8&_nc_oc=AdoUUEsuW6mfJXGe_nTgUHWqlmYM6ci09levj_uFK1h7CFYg9bVp8B5akZRvRENRTJk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI96uFXa3nSTkdX2vVdZFugK4qwGCe-WSPagU2IMMb6gQ&oe=6AA947DB"}, {"file_name": "Powerscourt waterfall.png", "id": "293387855349260", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75207237_293387858682593_3625796469231178237_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K6qwnxnL1dEQ7kNvwF5tlxT&_nc_oc=AdrS8Ei1jsiF-HbcpIYeo5X3r-TA0m47lOjSi2tVVTG746Tq3HBBzRYMweB4HI1tj8o&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjR64uYaULCvTA-D9R7HvaUcBl4FVAq6KDXBHxLq7zbw&oe=6AA96BDA"}, {"file_name": "Beach wexford.png", "id": "290192465660275", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75222938_290192468993608_254672737452146756_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7_3gvTQDbt4Q7kNvwFhEyW8&_nc_oc=AdrzrZs8iS3UCxbBJemYQcrSJeL6FSh-hBAuDkqdWA9V_GdLYZMmOBifpgWQgCPMN-A&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJsSCAiFLjSGNcF2LpG1VVDhdvPqZaqtCzIPLr5pebesg&oe=6AA9618C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "forest trailer.png", "id": "988047351647701", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/10000000_988047361647700_5249813252618530611_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kkFm5gMLEtoQ7kNvwFSkUEl&_nc_oc=Adp6q1mPyEuweB3PVzQPYaKQxauxYrbDj2cZ8BXhzh-j0fPfLsBTCs7wfJgCtbGm53U&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKkoXlQ8J42CjrIGTb5I5paWjRTPIynLFAS8B2i9J4BGA&oe=6AA9624B"}, "display_name": "Solas VR", "keywords": ["Meditation", "Nature", "Productivity", "Relaxation", "Mindfulness"], "long_description": "Solas Meditation is the VR app that goes beyond meditation as we know it. With an immersive gallery of landscapes, nature sounds and guidance, Solas VR meditation replicates the real feeling of being out there, close to nature, enjoying the inner calmness we are made for. Bringing together eternal wisdom and cutting edge technology, Solas Meditation is designed for urban living, as a shield against stress, confusion and rush. The graphics and sounds, provided directly by nature, create a seamless multi-sensory experience, initiating a journey within. \nWith Solas Meditation you will feel more. You will do more. You will be more.", "short_description": "Add a new dimension to your meditation and allow nature to take you on a journey within. Solas VR presents a gallery of landscapes, nature sounds and guided meditations, designed to refresh your mind, spirit and soul.  This wonderful VR experience is the perfect micro break in nature that you can take while living an urban life.  Why settle with two dimensions, when you can have more? Why not dive inside your inner wisdom where you can be more?"}]}, "developer_name": "Virtual Reality Ireland Media Ltd.", "developer_privacy_policy_url": "https://www.solasvr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.solasvr.com/terms-of-service/", "publisher_name": "Tiesto Capital Ltd", "support_website_url": "https://www.solasvr.com/about/", "website_url": "https://www.solasvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "rec
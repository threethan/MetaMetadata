JX9FawQ7kNvwFZ_a-D&_nc_oc=Ado4B7I4NCO7c0y5OQsP_WnJowJkdOoIuBw4_wrMfL1NrmutP7GnF-ceQOwp4GWn2rg&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0CN_Te-4k5RtJdV6-RRYRv_Qt_slCU1QnmcYUHjuXLvw&oe=69E236A8"}, {"file_name": "Glendalough lake.png", "id": "317898529368349", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39036652_317898532701682_1088784562417673472_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0hlSfayJt2wQ7kNvwGbfhTp&_nc_oc=AdoGT7msAqrm65fosemesKejIhT2bxaIj2GYcbggBc2S9QkB8aHYoY0HR9bceoJ9G30&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3XsES21e0TmbY_U8vfeBA14egV6gtKSVUU5eX237F5ow&oe=69E2355B"}, {"file_name": "Powerscourt waterfall.png", "id": "293387855349260", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75207237_293387858682593_3625796469231178237_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hs3J1orlHiAQ7kNvwGSROod&_nc_oc=AdoY6cu4GHxzlC4EIrLPkrv3RC-10k82_JYWDbTht_OwLe6N3GJasLlP5Uq8pv3m2Pg&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1mZLTD0sebdRok3RPV1FBkw_iXaoOohN_wzOyQFVsA0g&oe=69E2211A"}, {"file_name": "Beach wexford.png", "id": "290192465660275", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75222938_290192468993608_254672737452146756_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cYP2aevxaMAQ7kNvwGjPQCT&_nc_oc=Adol4UZ4OF1YRlzldAio-tHnWGbbfQyCdN2plTv-2OFQ56nCHFT87iFo-LmA0WGZuGc&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3QKfzpl4XeNmH9rMza5dGYXdHFNjNI9xz4KRpchkj54w&oe=69E24F0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "forest trailer.png", "id": "988047351647701", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/10000000_988047361647700_5249813252618530611_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cn9G1p6KMAYQ7kNvwEY3V8r&_nc_oc=Adr1cAx8X3E36XS0t9BeuONfUGt6knVdyK80mPlNrLf149O6bAACSdIMThp8p0aREJ8&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1E8ouep942wr0tIUcUHgOCvfIDvw3tvpopnswHzuyF7w&oe=69E24FCB"}, "display_name": "Solas VR", "keywords": ["Meditation", "Nature", "Productivity", "Relaxation", "Mindfulness"], "long_description": "Solas Meditation is the VR app that goes beyond meditation as we know it. With an immersive gallery of landscapes, nature sounds and guidance, Solas VR meditation replicates the real feeling of being out there, close to nature, enjoying the inner calmness we are made for. Bringing together eternal wisdom and cutting edge technology, Solas Meditation is designed for urban living, as a shield against stress, confusion and rush. The graphics and sounds, provided directly by nature, create a seamless multi-sensory experience, initiating a journey within. \nWith Solas Meditation you will feel more. You will do more. You will be more.", "short_description": "Add a new dimension to your meditation and allow nature to take you on a journey within. Solas VR presents a gallery of landscapes, nature sounds and guided meditations, designed to refresh your mind, spirit and soul.  This wonderful VR experience is the perfect micro break in nature that you can take while living an urban life.  Why settle with two dimensions, when you can have more? Why not dive inside your inner wisdom where you can be more?"}]}, "developer_name": "Virtual Reality Ireland Media Ltd.", "developer_privacy_policy_url": "https://www.solasvr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.solasvr.com/terms-of-service/", "publisher_name": "Tiesto Capital Ltd", "support_website_url": "https://www.solasvr.com/about/", "website_url": "https://www.solasvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphic
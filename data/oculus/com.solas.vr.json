_OmyhYQ7kNvwG-sfW-&_nc_oc=AdrERzqfhpg70ApL-eeaWwxnxfoddR_UsfWdGdKmTeAiesJ3Y7vYOIIUtZ0i2tg7X_E&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTbugHDgCkr34fOk_PpCDcMpS79RO8GTLRahIkTuO7pQ&oe=6A660CA8"}, {"file_name": "Glendalough lake.png", "id": "317898529368349", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036652_317898532701682_1088784562417673472_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2FC_aTrJX78Q7kNvwF4mxOu&_nc_oc=AdrQe6fHVOE9QHblpdJ8xI7ZQIHndiGJQbSu_jT0JXqAf3CBXbeRzbV4bJzMxX55100&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBRuorpmQ1lNeJqUujVZ1bNlI8PEyuYOOC0XynZx31aYg&oe=6A660B5B"}, {"file_name": "Powerscourt waterfall.png", "id": "293387855349260", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75207237_293387858682593_3625796469231178237_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=43XlkSrgITsQ7kNvwFZzyCp&_nc_oc=AdrukW2N3FxqMs4m__NtJ9tFJn-9GslQ1UElP1zlfas52wKkk-_ELUc9ScF8kTeUIvI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDTBUXC2zYWfnm2RDcfWvpNfa9z5b-xTjQ0bjuZLpdtJA&oe=6A65F71A"}, {"file_name": "Beach wexford.png", "id": "290192465660275", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75222938_290192468993608_254672737452146756_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XqMmz6iMF4YQ7kNvwFs1q1I&_nc_oc=AdrRURSJuBfFQV5cXTXXRgBebV9EPZqkPre1qkOlILHRRdZY2VKIYJDU2kcrtse5xLs&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCafuIRcSWHCNbnGrl_qmnplrNN0gDFz46SqQ5X2kRTYw&oe=6A66250C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "forest trailer.png", "id": "988047351647701", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/10000000_988047361647700_5249813252618530611_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=49beYtvHQmAQ7kNvwGF2yan&_nc_oc=Adpovwpj6sQxC0ctW76d1JW3fmfaU6A743sbD-I-yHZamU9rxjDdpAG6FEh6-UNanbs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCR85wvzkK9BfR0nm_xchPyLcYYyfNW4x1oF0YnlspD1A&oe=6A6625CB"}, "display_name": "Solas VR", "keywords": ["Meditation", "Nature", "Productivity", "Relaxation", "Mindfulness"], "long_description": "Solas Meditation is the VR app that goes beyond meditation as we know it. With an immersive gallery of landscapes, nature sounds and guidance, Solas VR meditation replicates the real feeling of being out there, close to nature, enjoying the inner calmness we are made for. Bringing together eternal wisdom and cutting edge technology, Solas Meditation is designed for urban living, as a shield against stress, confusion and rush. The graphics and sounds, provided directly by nature, create a seamless multi-sensory experience, initiating a journey within. \nWith Solas Meditation you will feel more. You will do more. You will be more.", "short_description": "Add a new dimension to your meditation and allow nature to take you on a journey within. Solas VR presents a gallery of landscapes, nature sounds and guided meditations, designed to refresh your mind, spirit and soul.  This wonderful VR experience is the perfect micro break in nature that you can take while living an urban life.  Why settle with two dimensions, when you can have more? Why not dive inside your inner wisdom where you can be more?"}]}, "developer_name": "Virtual Reality Ireland Media Ltd.", "developer_privacy_policy_url": "https://www.solasvr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.solasvr.com/terms-of-service/", "publisher_name": "Tiesto Capital Ltd", "support_website_url": "https://www.solasvr.com/about/", "website_url": "https://www.solasvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphic
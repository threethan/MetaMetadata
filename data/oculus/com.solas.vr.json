52FnRMQ7kNvwGFQ1D0&_nc_oc=Adpl9uIlkZq6eIyRwWq7ohAeSKuj6Kt_aXOlux14_gM09cJY_MCSv9H8u_XNdCtOPQc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNgr8cWeSt_V835TofVcu2V1oxePQWlcOE2qtFNAR7SgA&oe=6ABFB2A8"}, {"file_name": "Glendalough lake.png", "id": "317898529368349", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036652_317898532701682_1088784562417673472_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f02ANmbKZR8Q7kNvwEOV8_C&_nc_oc=Adrtl6aLF9FQOET2_NKzXcm8DPcup4dY0r22RRwfazGeVww19dj8H3K1_tyclwbWlVk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMcS9AcMNNRuMdtzoxPPAsLgXXAtcIDzMdqubooNZ3PTw&oe=6ABFB15B"}, {"file_name": "Powerscourt waterfall.png", "id": "293387855349260", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75207237_293387858682593_3625796469231178237_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-pNnp0tGWCgQ7kNvwG9iu-Z&_nc_oc=AdqX-tsL3yvg1Q1cifraREB0UQlrRgHD0aeDi81iwg1K9wMCnjfyYzNBNOyca8_YLeQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNN9149G8W5JsHJ_WS7AAW19OkPkVEPk__krgyJkMS_5Q&oe=6ABFD55A"}, {"file_name": "Beach wexford.png", "id": "290192465660275", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75222938_290192468993608_254672737452146756_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RVOZPyah12oQ7kNvwE3G7AF&_nc_oc=AdrUSBYKZnMIU8nYEm-rd86wnyVle4DR13qON_Zeh46ol5tBVHhtJdWzrZn-SmXR3rE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMhQC3Uz1AdAsXaJwq9f0HL5_WotExm8x1m5Pqx-z-SVA&oe=6ABFCB0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "forest trailer.png", "id": "988047351647701", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/10000000_988047361647700_5249813252618530611_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XwudOpdnlTkQ7kNvwEGj-sN&_nc_oc=Adoncrhz7pmT0sarKQ6GBEVl-0QEmH2BJiZZfuHsTRkYSz1PcjgwZhbbffnzUA1mvSU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPoNx-sTA2tLOSqLpxwNjP9wSjWLxDCsyY15JeAzqkwiw&oe=6ABFCBCB"}, "display_name": "Solas VR", "keywords": ["Meditation", "Nature", "Productivity", "Relaxation", "Mindfulness"], "long_description": "Solas Meditation is the VR app that goes beyond meditation as we know it. With an immersive gallery of landscapes, nature sounds and guidance, Solas VR meditation replicates the real feeling of being out there, close to nature, enjoying the inner calmness we are made for. Bringing together eternal wisdom and cutting edge technology, Solas Meditation is designed for urban living, as a shield against stress, confusion and rush. The graphics and sounds, provided directly by nature, create a seamless multi-sensory experience, initiating a journey within. \nWith Solas Meditation you will feel more. You will do more. You will be more.", "short_description": "Add a new dimension to your meditation and allow nature to take you on a journey within. Solas VR presents a gallery of landscapes, nature sounds and guided meditations, designed to refresh your mind, spirit and soul.  This wonderful VR experience is the perfect micro break in nature that you can take while living an urban life.  Why settle with two dimensions, when you can have more? Why not dive inside your inner wisdom where you can be more?"}]}, "developer_name": "Virtual Reality Ireland Media Ltd.", "developer_privacy_policy_url": "https://www.solasvr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.solasvr.com/terms-of-service/", "publisher_name": "Tiesto Capital Ltd", "support_website_url": "https://www.solasvr.com/about/", "website_url": "https://www.solasvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphic
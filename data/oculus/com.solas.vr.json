aLiQmQQ7kNvwHeePkH&_nc_oc=AdqKY6RnUU_SJ5UIgK1SvH1hC0hO2sje76F7zyoN7ONxkA_yWuUaFiCXHuUtK_DTDe0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81VJ6DdsOWj7OtuegCULfZ6Z7BbJq_XxtfznC16M8rcQ&oe=6A2EADA8"}, {"file_name": "Glendalough lake.png", "id": "317898529368349", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036652_317898532701682_1088784562417673472_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zfx6g4rz7tQQ7kNvwFfWAab&_nc_oc=AdqZKgiIGlcYTaE19ZQpoq6CAe9gpS_-MOIqxb_0g327IKL9WWcCRtlGf8J0oJ6MCGY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ID8mokGfrreECrI9UmBajjIkFGkbykZAhb1Vrg_gzUQ&oe=6A2EAC5B"}, {"file_name": "Powerscourt waterfall.png", "id": "293387855349260", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75207237_293387858682593_3625796469231178237_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZGbFyTE33jgQ7kNvwHhm62z&_nc_oc=Adp9dgYk62OMjUD-8-eJ6wE-sNAi2g-dt7RyfmpPcrXgGAmXbEkbT_HmxdDLp93CZ1g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9f91j1ufrIyBmgeHN3SohKf3usDXDlMnYUWPsO1CgjPw&oe=6A2ED05A"}, {"file_name": "Beach wexford.png", "id": "290192465660275", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75222938_290192468993608_254672737452146756_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BHRHxyQubxYQ7kNvwEq5QfH&_nc_oc=AdrpLpS8VK09Hc-ZUecgd-oWzfuKgW5mMmGVmH6iYC2IS7rHo3kN2FCUgwjfyfA1M9w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-FZwYp652bNcb_0-uXDJMYyI84Qmd8Y5-rD53R6wpvRA&oe=6A2EC60C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "forest trailer.png", "id": "988047351647701", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/10000000_988047361647700_5249813252618530611_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fDedsoTTGlIQ7kNvwHibDPP&_nc_oc=Adrj-l3ei4G6SkJDf0HilQ6wdii7HuRCBHIRE-HV2z8oM80uGO7m5mORo8MscNkwPnc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MCUKlncRypne3PTXafSxlt33FhfGmyMoJidz4h4qRuQ&oe=6A2EC6CB"}, "display_name": "Solas VR", "keywords": ["Meditation", "Nature", "Productivity", "Relaxation", "Mindfulness"], "long_description": "Solas Meditation is the VR app that goes beyond meditation as we know it. With an immersive gallery of landscapes, nature sounds and guidance, Solas VR meditation replicates the real feeling of being out there, close to nature, enjoying the inner calmness we are made for. Bringing together eternal wisdom and cutting edge technology, Solas Meditation is designed for urban living, as a shield against stress, confusion and rush. The graphics and sounds, provided directly by nature, create a seamless multi-sensory experience, initiating a journey within. \nWith Solas Meditation you will feel more. You will do more. You will be more.", "short_description": "Add a new dimension to your meditation and allow nature to take you on a journey within. Solas VR presents a gallery of landscapes, nature sounds and guided meditations, designed to refresh your mind, spirit and soul.  This wonderful VR experience is the perfect micro break in nature that you can take while living an urban life.  Why settle with two dimensions, when you can have more? Why not dive inside your inner wisdom where you can be more?"}]}, "developer_name": "Virtual Reality Ireland Media Ltd.", "developer_privacy_policy_url": "https://www.solasvr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.solasvr.com/terms-of-service/", "publisher_name": "Tiesto Capital Ltd", "support_website_url": "https://www.solasvr.com/about/", "website_url": "https://www.solasvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphic
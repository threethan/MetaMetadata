F9wyIAQ7kNvwFnjE7S&_nc_oc=Adoyr-qf7g8o1fI7mL4ZviHns0lDLkAmAbel0TgGUv4hzooswYE7wZ5Ph6ZFrP5N8P0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKz4lpDIPH1cgKI0ITzYlQETNyT9Fg85H8dLf49-mJh8w&oe=6AA554A8"}, {"file_name": "Glendalough lake.png", "id": "317898529368349", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036652_317898532701682_1088784562417673472_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jqKsqcOPs6YQ7kNvwF8pHR8&_nc_oc=AdqWjQlGE4IVWlGBHBGz6QicioPIxBxcI8dWzx_5ym85O2LXmaf66d6pPjM5LYaAfVU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2P_JqEN_wpZKGhFRSpi1VZs68mogGOmsUi75TA1gRPA&oe=6AA5535B"}, {"file_name": "Powerscourt waterfall.png", "id": "293387855349260", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75207237_293387858682593_3625796469231178237_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cXuYaiIRQfMQ7kNvwFJlrUD&_nc_oc=AdozrUH32--LQGch36Zb8GH2YTlSvsUtnt10RlCs0DvnUVoR0fItmfmI0hHBptdFIz8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzaBUD8kwAThA2-1yFZURrB87kApoVIgyal11gMlu2jw&oe=6AA53F1A"}, {"file_name": "Beach wexford.png", "id": "290192465660275", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75222938_290192468993608_254672737452146756_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CJdyr_p2eLYQ7kNvwFyJp1W&_nc_oc=AdocyWUwW3jEQHdj0TEx1ij3wXekLFUmWHMkS1AinRmDG-PpZ-pDOeW265gqc3McX9c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGoqo_oxX4LPfvBkt8i3DoaU5zPvuhTXRtQ6fdPABacQ&oe=6AA56D0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "forest trailer.png", "id": "988047351647701", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/10000000_988047361647700_5249813252618530611_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=64_TK5Lfj-IQ7kNvwE6Z0mP&_nc_oc=AdpGz4YcuFn6mI-FA5DN5dCMTprcPoXoRa-nl-vHhnWPkIhCLFuJ61sPd28ciU6KmPw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLj9RWYEClh-DtTW8UBS2O6kK3ARIeXRQdqiYPxTGpY9w&oe=6AA56DCB"}, "display_name": "Solas VR", "keywords": ["Meditation", "Nature", "Productivity", "Relaxation", "Mindfulness"], "long_description": "Solas Meditation is the VR app that goes beyond meditation as we know it. With an immersive gallery of landscapes, nature sounds and guidance, Solas VR meditation replicates the real feeling of being out there, close to nature, enjoying the inner calmness we are made for. Bringing together eternal wisdom and cutting edge technology, Solas Meditation is designed for urban living, as a shield against stress, confusion and rush. The graphics and sounds, provided directly by nature, create a seamless multi-sensory experience, initiating a journey within. \nWith Solas Meditation you will feel more. You will do more. You will be more.", "short_description": "Add a new dimension to your meditation and allow nature to take you on a journey within. Solas VR presents a gallery of landscapes, nature sounds and guided meditations, designed to refresh your mind, spirit and soul.  This wonderful VR experience is the perfect micro break in nature that you can take while living an urban life.  Why settle with two dimensions, when you can have more? Why not dive inside your inner wisdom where you can be more?"}]}, "developer_name": "Virtual Reality Ireland Media Ltd.", "developer_privacy_policy_url": "https://www.solasvr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.solasvr.com/terms-of-service/", "publisher_name": "Tiesto Capital Ltd", "support_website_url": "https://www.solasvr.com/about/", "website_url": "https://www.solasvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphic
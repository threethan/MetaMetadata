ketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cz2gL52cgM8Q7kNvwGrvcp9&_nc_oc=Ado5vOIJVO2QW81akjnWT5CatF52PSfMrAHnPK85hKl32gPiVeTUvPvKoyUc3Xo2kJE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLEE27PMHu-0p2hnpvotOUsQBMLjG7l7WNjDOzvLXDrQ&oe=6AFC8077"}, {"file_name": "Screenshot5.png", "id": "395930933087914", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974482_395930936421247_7140068988406810268_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qGHenM7vlyQQ7kNvwGfY1zu&_nc_oc=Adrhl82PNMMxzRFMJIng-3Aw8lYA538AcmD3EvFwQXrlD7y6kQUGMo6dlal6tZtQLw8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8d5v_klr443jNmAnEuSM-EiltQFmoGxfxKSwPx0InBg&oe=6AFC8B52"}, {"file_name": "Screenshot3.png", "id": "1468529877063199", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031579_1468529880396532_4535593032672982803_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G34cZ9dDY_sQ7kNvwHBNEHn&_nc_oc=AdoKj7Wmwr0DCn7HePJQ9aE732ATh9q62HnmpjHSeUteDxShK--eA0VR5-vGM0UfSSI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7c14nCNNlH6FZQjn8ZcboGE6QlKZDbHpWW3nryke0gQ&oe=6AFC6164"}, {"file_name": "Screenshot1.png", "id": "3339700806176271", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982675_3339700809509604_1988799250975639629_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qqU5kxiT2jAQ7kNvwFWU67y&_nc_oc=AdpGrufS3pTQe3JYun9CKYGrJ1TKZjBQlaqZ4kONlgsd6PzgNHxbRHTqNMjWVOj-P1k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXWJfui_JycijsZiZtnf26UrkCfvDDVGKDStJKgWh2kw&oe=6AFC7451"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer cover.png", "id": "224857767260795", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38982528_224857770594128_2396860306280612700_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ie9PIcSvCCUQ7kNvwFatASl&_nc_oc=Adqz2sqjVtpcJ7xAvZpgda2-eOyiwAd4ezf81vKvPLmd9swJXVL9gmlaWoJlIY4wKbU&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHjvxQvvvI4U6vi8x3LbwNerb3paY6sFcgklFxZljEZw&oe=6AFC923F"}, "display_name": "Detective Winston Wayne", "keywords": [], "long_description": "Think with your hands and craft your way out of every challenge thrown at you by late Duke Hill.\n\nDelve into an untold alternative history set between two world wars, where a war veteran turned seasoned detective finds himself thrust into an unprecedented case. The demise of a close friend is merely the tip of the iceberg, as a vast conspiracy looms on the horizon, challenging the resolve of our determined detective.\n\nSome of the main features you'll find in Detective Winston Wayne: \n* New generation of escape room puzzles \n* Immerse yourself in Duke Hill's mesmerizing mansion \n* Realistic graphics on stand-alone Quest family devices\n* An alternative history connecting World Wars\n* Live through an ethical dilemma and navigate through several possible endings\n\nDebut Game from Vancouver-based indie studio, SomniumPorta.\nStay Tuned and follow us on the store for more updates on Detective Winston Wayne.", "short_description": "Step into Winston Wayne's shoes, a detective investigating the mysterious suicide of his long-time friend, Duke Henry Hill. Dive into the immersive escape room experience and uncover the truth in a world tainted by blind loyalty and conspiracies. Explore diverse locations and crack the most personal case of Winston Wayne's career. The burning question: Are you prepared to Dance With The Devil Himself?"}]}, "developer_name": "SomniumPorta VR development", "developer_privacy_policy_url": "http://somniumporta.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "SomniumPorta", "support_website_url": null, "website_url": "http://somniumporta.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534",
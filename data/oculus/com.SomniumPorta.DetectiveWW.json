ketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w5YdBAjTBzwQ7kNvwHxmXl0&_nc_oc=AdrvxsrPqummFdVds1gXOyL7zGuvKQGs2S1HRrGZmfeQZnfadCyMR2jDbH6m3uBzJr4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlI9I0UqIDbsEvpBySdkoA-X5Z2ykwCaItIXAfQfcBxA&oe=6AFF2377"}, {"file_name": "Screenshot5.png", "id": "395930933087914", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974482_395930936421247_7140068988406810268_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qGHenM7vlyQQ7kNvwEk0U8r&_nc_oc=AdpHHmaGpnVU33ukcq-FyLO_fr_UZoPe99vUD1dsJJnCxq6vlLHk8UxZREqG9-fvy4s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLB4X99WtdQXq641f1dNj5_HrODMsBS03tdQ2CvBZs6w&oe=6AFF2E52"}, {"file_name": "Screenshot3.png", "id": "1468529877063199", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031579_1468529880396532_4535593032672982803_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KCAPuyoYZ74Q7kNvwFM7Cdo&_nc_oc=AdqWSFk09HaI1FJTKXBJaoJOVCAzGE_Nv3r9x6-EBK5nElVXVoJQzpDYBQRJfI9Kkzw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjQ6uL9XCvh7r-w6jiPYV8qLiFcSZC7XU-jmvWFV2Y2A&oe=6AFF0464"}, {"file_name": "Screenshot1.png", "id": "3339700806176271", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982675_3339700809509604_1988799250975639629_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1IggqAYXoBkQ7kNvwFP74KH&_nc_oc=AdroaEMKnmzXovIMo7w2yqSXuN2HvinpvSDMfZycBLRK5iSc6VX27SnbgiiU3PAQvRU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwIbxGmA6B9OGwcTuopEgS4rtNme6xwuPfwqytf21HXw&oe=6AFF1751"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer cover.png", "id": "224857767260795", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38982528_224857770594128_2396860306280612700_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0HygTW0ZwgIQ7kNvwFwFAYr&_nc_oc=AdpusMnn2WT6A53avphM6rcWR6hgxQcA9Og3NitEkpk0d6mofReRqSSQ_VKlvZjhf78&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEy6-qszbaW-SnRC21WQLJDNfnuLKVuw8DMmXxg_jIDQ&oe=6AFEFCFF"}, "display_name": "Detective Winston Wayne", "keywords": [], "long_description": "Think with your hands and craft your way out of every challenge thrown at you by late Duke Hill.\n\nDelve into an untold alternative history set between two world wars, where a war veteran turned seasoned detective finds himself thrust into an unprecedented case. The demise of a close friend is merely the tip of the iceberg, as a vast conspiracy looms on the horizon, challenging the resolve of our determined detective.\n\nSome of the main features you'll find in Detective Winston Wayne: \n* New generation of escape room puzzles \n* Immerse yourself in Duke Hill's mesmerizing mansion \n* Realistic graphics on stand-alone Quest family devices\n* An alternative history connecting World Wars\n* Live through an ethical dilemma and navigate through several possible endings\n\nDebut Game from Vancouver-based indie studio, SomniumPorta.\nStay Tuned and follow us on the store for more updates on Detective Winston Wayne.", "short_description": "Step into Winston Wayne's shoes, a detective investigating the mysterious suicide of his long-time friend, Duke Henry Hill. Dive into the immersive escape room experience and uncover the truth in a world tainted by blind loyalty and conspiracies. Explore diverse locations and crack the most personal case of Winston Wayne's career. The burning question: Are you prepared to Dance With The Devil Himself?"}]}, "developer_name": "SomniumPorta VR development", "developer_privacy_policy_url": "http://somniumporta.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "SomniumPorta", "support_website_url": null, "website_url": "http://somniumporta.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534",
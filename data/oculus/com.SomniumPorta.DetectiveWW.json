ketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Ba_OtH37o4Q7kNvwFJ6ag7&_nc_oc=AdpPGwSGpL7iZ-dTFHYjWsrVLXyDo8EXW6ldB7O6i8Ha4CUN3-S63uNDiv7qQvtjZZY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSiI-lPuQcz06zXjyDFXGuAfpU7Z95LdKAkleMQW8pN-A&oe=6B09AF77"}, {"file_name": "Screenshot5.png", "id": "395930933087914", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974482_395930936421247_7140068988406810268_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UsJWMDc5WZsQ7kNvwGH7Tgv&_nc_oc=AdqBMXUXI6Dz3EWtfPFfdrgUJ-xg_IsxnHeVT-P_Bp0KIZcVXzAbnLqyTzTG2E2dxKU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_O7U5BP6kG9mWaYH_RdRRagr2SN2ApVKRJWur2oRW9Q&oe=6B09BA52"}, {"file_name": "Screenshot3.png", "id": "1468529877063199", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031579_1468529880396532_4535593032672982803_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i7AqvcdwYgAQ7kNvwHx4afW&_nc_oc=AdpxiRttEdakrlP8fDHlkIccGVQXCaxdavKPr__vG3ZCsNiANT0aZjvgblLkD9h8LDU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS10rykkCtRyLz1YgL8Tmifr5M1j1aXwdDbzDZe0BX68g&oe=6B09C8A4"}, {"file_name": "Screenshot1.png", "id": "3339700806176271", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982675_3339700809509604_1988799250975639629_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JCcX8tKrtJUQ7kNvwEs0ZhH&_nc_oc=AdpE2i9DZ7IWhfJPM5rsc2tovvMnbofkThbb1TEqT8f-Qys5WbhSHPifde6ptuh8a60&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9R71DtLmMw17ICT8XdUdAMnjkuJvJlldAxJg3179_6A&oe=6B09A351"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer cover.png", "id": "224857767260795", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38982528_224857770594128_2396860306280612700_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SFov9B0h7mEQ7kNvwGbzEmr&_nc_oc=AdoasL14miixn2XsyQthvUSsupZWklUV0QpN9xCZw-BFbGecu8bjzXjpl3slf78uDBE&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRH8sri8i2RC9483xnn93I3cHm_TfkD0oGFzcanURWmvw&oe=6B09C13F"}, "display_name": "Detective Winston Wayne", "keywords": [], "long_description": "Think with your hands and craft your way out of every challenge thrown at you by late Duke Hill.\n\nDelve into an untold alternative history set between two world wars, where a war veteran turned seasoned detective finds himself thrust into an unprecedented case. The demise of a close friend is merely the tip of the iceberg, as a vast conspiracy looms on the horizon, challenging the resolve of our determined detective.\n\nSome of the main features you'll find in Detective Winston Wayne: \n* New generation of escape room puzzles \n* Immerse yourself in Duke Hill's mesmerizing mansion \n* Realistic graphics on stand-alone Quest family devices\n* An alternative history connecting World Wars\n* Live through an ethical dilemma and navigate through several possible endings\n\nDebut Game from Vancouver-based indie studio, SomniumPorta.\nStay Tuned and follow us on the store for more updates on Detective Winston Wayne.", "short_description": "Step into Winston Wayne's shoes, a detective investigating the mysterious suicide of his long-time friend, Duke Henry Hill. Dive into the immersive escape room experience and uncover the truth in a world tainted by blind loyalty and conspiracies. Explore diverse locations and crack the most personal case of Winston Wayne's career. The burning question: Are you prepared to Dance With The Devil Himself?"}]}, "developer_name": "SomniumPorta VR development", "developer_privacy_policy_url": "http://somniumporta.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "SomniumPorta", "support_website_url": null, "website_url": "http://somniumporta.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534",
ketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ertHz7LZOMQ7kNvwH0V6lZ&_nc_oc=AdoAiVxn4NozkgtxOffvFoOtiIWG6Y-lQ-5GHUKuLbxCKIRJ2l6Sh4qZ2HpSgMcjwvk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5x1Vm3ptHrU183eTqWMV1vUHseF51_o7QFDme2-f-8A&oe=6B0317F7"}, {"file_name": "Screenshot5.png", "id": "395930933087914", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974482_395930936421247_7140068988406810268_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y4qcRIYTFUUQ7kNvwE-5mJX&_nc_oc=AdqH--opT3_D1BMCfhIKYbhQICbIwMxwlrBR-vLnJCDKXqaVprWYlVkdDJlmd91HGpM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQToTYzWHG7a_iV3gdO-iI7h42utWr5lQTxgekUi_BEulQ&oe=6B0322D2"}, {"file_name": "Screenshot3.png", "id": "1468529877063199", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031579_1468529880396532_4535593032672982803_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=htoRumeZnb4Q7kNvwFnRY86&_nc_oc=Adoubbe1822urka9yniTMUson9ZQEksRCenfgWomIqgPGvIH6_Asc7YuEhagH27ka_Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNMv5b8-L6qXqBYpRi7SmpPZR0s1LK4LDFYgTg8dxtTA&oe=6B033124"}, {"file_name": "Screenshot1.png", "id": "3339700806176271", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982675_3339700809509604_1988799250975639629_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NIuYc8Tri0sQ7kNvwG6bCTw&_nc_oc=Adr5CxiPeN25WT1HEtbfO0SdMomuiJ7LG0QIcY03Bvpf0S9K6Ntwf3tFUmR198vEESA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRp21AyOrm94zg4wshFHfzOF_HNcIiv2lffyZc0NyfzQg&oe=6B030BD1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer cover.png", "id": "224857767260795", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982528_224857770594128_2396860306280612700_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VrdOhLI8wjoQ7kNvwGnRMh9&_nc_oc=Adqo6sjiBrIy5f8m98I-uzSpBu4RNTq_pN4rbW4P5GPJoYc_D2QtceICdM25T6ysoq8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5Q0z2pWyboBIOtUjsa8YMUgKsBHTFuKz6bHu1yfkAnQ&oe=6B0329BF"}, "display_name": "Detective Winston Wayne", "keywords": [], "long_description": "Think with your hands and craft your way out of every challenge thrown at you by late Duke Hill.\n\nDelve into an untold alternative history set between two world wars, where a war veteran turned seasoned detective finds himself thrust into an unprecedented case. The demise of a close friend is merely the tip of the iceberg, as a vast conspiracy looms on the horizon, challenging the resolve of our determined detective.\n\nSome of the main features you'll find in Detective Winston Wayne: \n* New generation of escape room puzzles \n* Immerse yourself in Duke Hill's mesmerizing mansion \n* Realistic graphics on stand-alone Quest family devices\n* An alternative history connecting World Wars\n* Live through an ethical dilemma and navigate through several possible endings\n\nDebut Game from Vancouver-based indie studio, SomniumPorta.\nStay Tuned and follow us on the store for more updates on Detective Winston Wayne.", "short_description": "Step into Winston Wayne's shoes, a detective investigating the mysterious suicide of his long-time friend, Duke Henry Hill. Dive into the immersive escape room experience and uncover the truth in a world tainted by blind loyalty and conspiracies. Explore diverse locations and crack the most personal case of Winston Wayne's career. The burning question: Are you prepared to Dance With The Devil Himself?"}]}, "developer_name": "SomniumPorta VR development", "developer_privacy_policy_url": "http://somniumporta.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "SomniumPorta", "support_website_url": null, "website_url": "http://somniumporta.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534",
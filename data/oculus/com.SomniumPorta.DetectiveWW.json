nc_ohc=ExQo8ZOPV00Q7kNvwHD3nFc&_nc_oc=Adm2MVMHvULNeA0VKmEb59c3WvKz3qmc6PwNqDF347Pgvfo7Mwz6287_qA-hXlAwmTI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsATdaASUhav-SevP5kYchUs-vxDK1SvuZOBOUzGDY3kA&oe=6999BDE4"}, {"file_name": "Screenshot1.png", "id": "3339700806176271", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982675_3339700809509604_1988799250975639629_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HNV7x6f7y3cQ7kNvwGopxfY&_nc_oc=Adlu43VPL6QuDHmaTWeEln2qyewjbLi8Hqum6G6yiGCi8SIBqOaFCkZriCQlvwhO8_w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvm5OUb4-hykPOahB3wv6C0BDaxPZOeomRPNS1s_hGSoQ&oe=69999891"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer cover.png", "id": "224857767260795", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982528_224857770594128_2396860306280612700_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IETur68vkFsQ7kNvwGUWHfl&_nc_oc=AdkAUbekmHiOWY-cmWB0ZQFPwnRcwJXYSqNE5Yd6XcURt9Ifv2Dx6xNXkB6qWlC7WKg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afud9b-W61xoRB8-92syL21lbBipCKws6K4rdrGyjOKqUQ&oe=6999B67F"}, "display_name": "Detective Winston Wayne", "keywords": [], "long_description": "Think with your hands and craft your way out of every challenge thrown at you by late Duke Hill.\n\nDelve into an untold alternative history set between two world wars, where a war veteran turned seasoned detective finds himself thrust into an unprecedented case. The demise of a close friend is merely the tip of the iceberg, as a vast conspiracy looms on the horizon, challenging the resolve of our determined detective.\n\nSome of the main features you'll find in Detective Winston Wayne: \n* New generation of escape room puzzles \n* Immerse yourself in Duke Hill's mesmerizing mansion \n* Realistic graphics on stand-alone Quest family devices\n* An alternative history connecting World Wars\n* Live through an ethical dilemma and navigate through several possible endings\n\nDebut Game from Vancouver-based indie studio, SomniumPorta.\nStay Tuned and follow us on the store for more updates on Detective Winston Wayne.", "short_description": "Step into Winston Wayne's shoes, a detective investigating the mysterious suicide of his long-time friend, Duke Henry Hill. Dive into the immersive escape room experience and uncover the truth in a world tainted by blind loyalty and conspiracies. Explore diverse locations and crack the most personal case of Winston Wayne's career. The burning question: Are you prepared to Dance With The Devil Himself?"}]}, "developer_name": "SomniumPorta VR development", "developer_privacy_policy_url": "http://somniumporta.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "SomniumPorta", "support_website_url": null, "website_url": "http://somniumporta.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7862559310423992"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "773400544626337"}]}, "baseline_offer": {"id": "773400544626337"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1707897600, "status": "PUBLISHED", "id": "773400544626337"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8074647202548534", "version": "2"}, "id": "1129125574740898", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "pr
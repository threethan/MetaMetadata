ketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5iam8qtZPgcQ7kNvwGO4o-J&_nc_oc=AdqXnMzXR_ol-y7mYHvEltrilt7dNSncJv15To_nK7XGVJnBbPQeldT-pigj-08AF3U&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTFEIwII5NeVPge20V3X4fHe8FnSjG1jn6UtreV0C-Qiw&oe=6B0B3937"}, {"file_name": "Screenshot5.png", "id": "395930933087914", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974482_395930936421247_7140068988406810268_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UsJWMDc5WZsQ7kNvwHbmIpj&_nc_oc=AdrkWR6rSI4N2TttMMCMrTe3QsKg_TAR3qI6tDHbF4F-sdDvHcFJG7igOLKS1rt3c5k&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTYHST6g477vsTZusoNVLyDNJCYO8EW8MGDyHjezyZH6g&oe=6B0B4412"}, {"file_name": "Screenshot3.png", "id": "1468529877063199", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031579_1468529880396532_4535593032672982803_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i7AqvcdwYgAQ7kNvwG8FkQB&_nc_oc=Adq3QgLfGQt7R_3n2nwERxM-882oMqzLhKZM2eWU8pvYUGwqKx5DUE_-aDmc31_IvYo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRA40DoBIaxXsxPmASoHci9Ap5oh2JBVtkK5nZWHlTQGw&oe=6B0B1A24"}, {"file_name": "Screenshot1.png", "id": "3339700806176271", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982675_3339700809509604_1988799250975639629_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mIPY5Mx-5FcQ7kNvwH4xfZL&_nc_oc=Ado_kz5CbackAlY89CqVKEHWq9LOhonQmfqsSUhDCC9L5oIs14wqEv6ZGQgkLbVM5VU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQkho3jTEVk9uk7JiJh7QF86OiSGSS3jfdHVui8BI8ImQ&oe=6B0B2D11"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer cover.png", "id": "224857767260795", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982528_224857770594128_2396860306280612700_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FMFUvrOB5UkQ7kNvwGHZHPA&_nc_oc=Adom84ySuF3PFB84ZHmCVvLZ337GDRIn-rcMLxmvQQssoYmIgqVh7QifB7rV4m4Ui40&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQrvBMjMm1VkOq96Nw4615FsU_GeU549JdtQmBxFNJw0A&oe=6B0B12BF"}, "display_name": "Detective Winston Wayne", "keywords": [], "long_description": "Think with your hands and craft your way out of every challenge thrown at you by late Duke Hill.\n\nDelve into an untold alternative history set between two world wars, where a war veteran turned seasoned detective finds himself thrust into an unprecedented case. The demise of a close friend is merely the tip of the iceberg, as a vast conspiracy looms on the horizon, challenging the resolve of our determined detective.\n\nSome of the main features you'll find in Detective Winston Wayne: \n* New generation of escape room puzzles \n* Immerse yourself in Duke Hill's mesmerizing mansion \n* Realistic graphics on stand-alone Quest family devices\n* An alternative history connecting World Wars\n* Live through an ethical dilemma and navigate through several possible endings\n\nDebut Game from Vancouver-based indie studio, SomniumPorta.\nStay Tuned and follow us on the store for more updates on Detective Winston Wayne.", "short_description": "Step into Winston Wayne's shoes, a detective investigating the mysterious suicide of his long-time friend, Duke Henry Hill. Dive into the immersive escape room experience and uncover the truth in a world tainted by blind loyalty and conspiracies. Explore diverse locations and crack the most personal case of Winston Wayne's career. The burning question: Are you prepared to Dance With The Devil Himself?"}]}, "developer_name": "SomniumPorta VR development", "developer_privacy_policy_url": "http://somniumporta.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "SomniumPorta", "support_website_url": null, "website_url": "http://somniumporta.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534",
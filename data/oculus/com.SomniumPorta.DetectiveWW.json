tps://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974482_395930936421247_7140068988406810268_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TSw--AaR-FoQ7kNvwE8bCeW&_nc_oc=AdmsFmM7SBnAXLbL2vA3Bh2Fkw4BeRGdPh4pn0ELZUnAmZ3sIXmf4QZ4xe-gE3k4Hug&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwIHOaG4OfQxWi_NFY81K---lt1z7tfHDp892lKoAlR3g&oe=69BBF692"}, {"file_name": "Screenshot3.png", "id": "1468529877063199", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031579_1468529880396532_4535593032672982803_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o4WHKYYeaWUQ7kNvwFuj08F&_nc_oc=AdlSNG1v9gkBgMVpniKDGACzJGAaelN72VqNNOkom0BdYZB4R_N8HFXtbuEfUArPsaQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxwagR_FSdfWMNd1-_H72eVoDgUGi4VaRfFR52aZyFQbg&oe=69BC04E4"}, {"file_name": "Screenshot1.png", "id": "3339700806176271", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982675_3339700809509604_1988799250975639629_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hxv8DNYFc1sQ7kNvwEG94Ky&_nc_oc=AdmZImWbQH5fgtNeSlZB8l-r9wBrcYioe-SgvBD72e6A4BK2VtoRakoVEzz4RinauNE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy1WrSrmkEJW9OY880zFH_3DbhYlpQBP4ULomX0oot_pA&oe=69BBDF91"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer cover.png", "id": "224857767260795", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982528_224857770594128_2396860306280612700_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OeAMbUwGvtIQ7kNvwG72rrj&_nc_oc=AdnSjLv2qym0s2cCE22mrhKDbOhlpoa-n9NcVKwWP_Wm-KEwbCWg3dszaBti5b_nsTU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx8xGQ9eKWquKQ7H0hqEltK2M2_-pg-UgCO2525NxKxQg&oe=69BBFD7F"}, "display_name": "Detective Winston Wayne", "keywords": [], "long_description": "Think with your hands and craft your way out of every challenge thrown at you by late Duke Hill.\n\nDelve into an untold alternative history set between two world wars, where a war veteran turned seasoned detective finds himself thrust into an unprecedented case. The demise of a close friend is merely the tip of the iceberg, as a vast conspiracy looms on the horizon, challenging the resolve of our determined detective.\n\nSome of the main features you'll find in Detective Winston Wayne: \n* New generation of escape room puzzles \n* Immerse yourself in Duke Hill's mesmerizing mansion \n* Realistic graphics on stand-alone Quest family devices\n* An alternative history connecting World Wars\n* Live through an ethical dilemma and navigate through several possible endings\n\nDebut Game from Vancouver-based indie studio, SomniumPorta.\nStay Tuned and follow us on the store for more updates on Detective Winston Wayne.", "short_description": "Step into Winston Wayne's shoes, a detective investigating the mysterious suicide of his long-time friend, Duke Henry Hill. Dive into the immersive escape room experience and uncover the truth in a world tainted by blind loyalty and conspiracies. Explore diverse locations and crack the most personal case of Winston Wayne's career. The burning question: Are you prepared to Dance With The Devil Himself?"}]}, "developer_name": "SomniumPorta VR development", "developer_privacy_policy_url": "http://somniumporta.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "SomniumPorta", "support_website_url": null, "website_url": "https://www.somniumporta.com/game", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SIT
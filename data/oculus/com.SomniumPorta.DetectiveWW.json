EC792"}, {"file_name": "Screenshot3.png", "id": "1468529877063199", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031579_1468529880396532_4535593032672982803_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BaFQsdkKNW0Q7kNvwGYDpts&_nc_oc=Adnam-oYiBClNul_vsxaOFl2P7CEhenseKRPJ1wcIikWWYGF7wfCorQzET_DmJhdtZs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwK4J2bWmmb0-DOUvtVUkp2dM40EIl99ZIxipnEOlXHpw&oe=69AED5E4"}, {"file_name": "Screenshot1.png", "id": "3339700806176271", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982675_3339700809509604_1988799250975639629_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=arFUYizt7OsQ7kNvwGe1v63&_nc_oc=AdnbfLIr1lmKCahYJDTm8Rdd2-migpbpWFf2RdK-viABkfMaL5K95lBpcFCUNBnRrog&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxQggAaOTiaM5ClzRdxT3DUxVm_T2a3QYbrkH-8v2ZQ5w&oe=69AEB091"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer cover.png", "id": "224857767260795", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982528_224857770594128_2396860306280612700_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NCJIQBA9xnoQ7kNvwHbwodP&_nc_oc=Adl_hUEAU3DKj7V7zuSFk4QxerlHa92OzEMmNsTfysn-kWoLzlT6uifaIhFtpi9L8Zk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzE0J9sBOa-rRnnKZYdF50zX_D7BwOBed-x-upsPKAONQ&oe=69AECE7F"}, "display_name": "Detective Winston Wayne", "keywords": [], "long_description": "Think with your hands and craft your way out of every challenge thrown at you by late Duke Hill.\n\nDelve into an untold alternative history set between two world wars, where a war veteran turned seasoned detective finds himself thrust into an unprecedented case. The demise of a close friend is merely the tip of the iceberg, as a vast conspiracy looms on the horizon, challenging the resolve of our determined detective.\n\nSome of the main features you'll find in Detective Winston Wayne: \n* New generation of escape room puzzles \n* Immerse yourself in Duke Hill's mesmerizing mansion \n* Realistic graphics on stand-alone Quest family devices\n* An alternative history connecting World Wars\n* Live through an ethical dilemma and navigate through several possible endings\n\nDebut Game from Vancouver-based indie studio, SomniumPorta.\nStay Tuned and follow us on the store for more updates on Detective Winston Wayne.", "short_description": "Step into Winston Wayne's shoes, a detective investigating the mysterious suicide of his long-time friend, Duke Henry Hill. Dive into the immersive escape room experience and uncover the truth in a world tainted by blind loyalty and conspiracies. Explore diverse locations and crack the most personal case of Winston Wayne's career. The burning question: Are you prepared to Dance With The Devil Himself?"}]}, "developer_name": "SomniumPorta VR development", "developer_privacy_policy_url": "http://somniumporta.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "SomniumPorta", "support_website_url": null, "website_url": "http://somniumporta.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7862559310423992"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "773400544626337"}]}, "baseline_offer": {"id": "773400544626337"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1707897600, "status": "PUBLISHED", "id": "773400544626337"}]}, "liveChannel":
"obb_binary": {"id": "7999150423431546"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7795920753754515", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8074647202548534"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1129125574740898"}]}, "change_log": "The First Patch Is Available Now! \u0670\n(Version 1.6)\n\nLess than a week after the first release of our debut game, Detective Winston Wayne, our first patch is ready. \n\nYou can find a shortlist of the changes below. We're constantly listening to your feedback and try our best to optimize it in the best possible way.\n\n- General environment lighting improvements\n- Completed Achievements list, now in your hands!\n- Vignette effect control option added\n- Liquids overall look and graphics are improved\n- Normalized the objective SFX in Tunnel and Stable sections\n- Inventory accessibility improvement\n- Some mechanics stability are improved\n\nWe hope you enjoy this brand-new update and give us some time to get back to you with a batch of new content for Detective Winston Wayne and beyond!\n\nFeb 20 ~ 2024 / Somnium Porta, Vancouver, British Colombia", "created_date": 1708447534, "id": "7991779504168638", "version": "1.6", "version_code": 7, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "7991777950835460"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7795920753754515", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8074647202548534"}, "release_sta
8988406810268_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bxUtLc4y4CIQ7kNvwGRoHLB&_nc_oc=AdnANF3nKojoWXJQWOlBqkx6Vri-QX3oOU6OomaQIAhqXhEKLNMb56oWp-zNFX9RPA4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftN2zIHutj4OSwbL9KzKvOrkoNFbjsmzzMMzXHowXvCdQ&oe=69A6DE92"}, {"file_name": "Screenshot3.png", "id": "1468529877063199", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031579_1468529880396532_4535593032672982803_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JKtV4FsAOEAQ7kNvwH5JauK&_nc_oc=Adm-Op8GRonKjtSLv-mvAMxO00kignzBessePnDfekXBD_9x1mJPC1SOARxiQw1tuxI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvpmnjuzbnU7Zb78e7JmUvebyoA0pY1w_HzmN0vcUmurA&oe=69A6ECE4"}, {"file_name": "Screenshot1.png", "id": "3339700806176271", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982675_3339700809509604_1988799250975639629_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bKLAvwIc_cYQ7kNvwFtYSAB&_nc_oc=AdlvrBaqm97nInuuePenGd0dCfVTEG13Fp4Beuunphg-Qf1pZbkjkcxP_G6JXeBiZTw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsmqtlmKBerP6t9kb6KPWzOhD1fU83ewEd0hKVj0OKSBw&oe=69A6C791"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer cover.png", "id": "224857767260795", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982528_224857770594128_2396860306280612700_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kdSk9g6guzkQ7kNvwHzko8T&_nc_oc=AdlA4HF6zep-rXNF7N5WOXzF_EaEicvoPd7rrUhTNmF-X6vvlbrsr2UOpbUywALHENo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afuv99FBqcw3joSiEd6VwX50q8CUdFoDUBY0tFFBrD0H5g&oe=69A6E57F"}, "display_name": "Detective Winston Wayne", "keywords": [], "long_description": "Think with your hands and craft your way out of every challenge thrown at you by late Duke Hill.\n\nDelve into an untold alternative history set between two world wars, where a war veteran turned seasoned detective finds himself thrust into an unprecedented case. The demise of a close friend is merely the tip of the iceberg, as a vast conspiracy looms on the horizon, challenging the resolve of our determined detective.\n\nSome of the main features you'll find in Detective Winston Wayne: \n* New generation of escape room puzzles \n* Immerse yourself in Duke Hill's mesmerizing mansion \n* Realistic graphics on stand-alone Quest family devices\n* An alternative history connecting World Wars\n* Live through an ethical dilemma and navigate through several possible endings\n\nDebut Game from Vancouver-based indie studio, SomniumPorta.\nStay Tuned and follow us on the store for more updates on Detective Winston Wayne.", "short_description": "Step into Winston Wayne's shoes, a detective investigating the mysterious suicide of his long-time friend, Duke Henry Hill. Dive into the immersive escape room experience and uncover the truth in a world tainted by blind loyalty and conspiracies. Explore diverse locations and crack the most personal case of Winston Wayne's career. The burning question: Are you prepared to Dance With The Devil Himself?"}]}, "developer_name": "SomniumPorta VR development", "developer_privacy_policy_url": "http://somniumporta.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "SomniumPorta", "support_website_url": null, "website_url": "https://www.somniumporta.com/game", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8050205214992733"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982588_888506369642250_6277014722146213021_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FBaTim38Z8AQ7kNvwGof5Ir&_nc_oc=AdkbOuBC4CsJ4gHXIPonRyblrhuNBO2pF8xcgZDilg5ctAUJvcuPL_TVB_3goneJpxA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftaZJJ2e1oWkEfyYAez1mYOwVS_BChQf9mvF6LukiusHQ&oe=69A6D9A1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Detective Winston Wayne", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}], "release_date": 1707897600, "lastRevision": {"nodes": [{"id": "7795920780421179", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "7795920753754515", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "2069528536750167"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "DWW Cover Landscape.png", "id": "904512567942925", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75411988_904512571276258_3432446423059377664_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5eX9KrOMQxEQ7kNvwEsURQj&_nc_oc=Adknvp7ydM08XyBC2haadu3FZyOE4JdhCOv614mMspOSW1EjC6aq0I3i_6_JxzYwnzI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv7BtlqrCTRi6jAULOzKeJelSxpWEnYNhdnoG-HRQwbmQ&oe=69A6DBAC"}, {"file_name": "DWW Hero Cover.png", "id": "893309929154827", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974670_893309932488160_697027836206318365_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=54VvcFBOC30Q7kNvwFmnfHb&_nc_oc=AdmTMtzUbWVNHP5OoBu2tF85Z2_I8NCVwJkhxfoxR7H3zycopOykDlJFq4gOHGjO0-
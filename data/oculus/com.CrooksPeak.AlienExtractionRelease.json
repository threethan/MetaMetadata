nd complete puzzles to solve the station's mysteries.\n\n- Scour video feeds for alien movement or lost clues\n- Pilot drones to explore, distract aliens and lead Lenny to safety\n- Control the facility from the comfort of your security desk\n- Traverse the facility minimap; just don\u2019t trust it\n- Attempt to mute the station AI when it starts insulting you...", "short_description": "Control an alien infested space station in this lighthearted VR strategy puzzle game. Guide Lenny the janitor through deadly and dangerous levels: sneak, burn, distract, pilot, blast and clean his way to safety. Control drones, check cameras and complete puzzles to solve the station's mysteries."}]}, "developer_name": null, "developer_privacy_policy_url": "https://alienextraction.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Crooks Peak", "support_website_url": "https://alienextraction.com/bug.html", "website_url": "https://alienextraction.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["NARRATIVE", "PUZZLE", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "305579791380963"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1210358307528942"}, {"status": "PUBLISHED", "id": "546720570362804"}]}, "baseline_offer": {"id": "546720570362804"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1757955600, "stat
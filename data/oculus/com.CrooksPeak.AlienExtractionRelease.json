.png", "id": "258710549666948", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001703_258710553000281_5940404028619034902_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=v3HHg4UxuKUQ7kNvwF00y_k&_nc_oc=Adr_CjpDX1-YxsgTzSbdcF7DuW7aUyGptCBONwbx9ytw4u-ko2p57Q1NjZk6Xb-33aU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af1O7dNziE1zMP4KQeSRm4NJwrPZrAflCPNqIgX8Ll9_1Q&oe=69F20670"}, {"file_name": "coresOculus.png", "id": "528453132011064", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75241701_528453138677730_5686059616100355801_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tDeqtpyCFb4Q7kNvwHPdSg4&_nc_oc=Adrvvkx-m8LFAuB22Tmcu3zS4T1X3WvzI0O8L3zQqDsZyncomMvnpXOZlRTxxF2lKZI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3rD7xPVoTLyTEOFOn0ac4bkV7mzNu_5NArRPEMLgOw2g&oe=69F1E5BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculusCoverArtLandscape.png", "id": "308101964601158", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035388_308101967934491_2413884904465272539_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KTScfmFzXdsQ7kNvwGCX_w1&_nc_oc=Ado7Gvbvy4v0uAdqwgMJxgIJAsLqqVJV4idSyEd-pU3PnTZ2FvUpNs9iTJXYM-b7eKY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1O2nv3tfrDFuQmMAyDR5574axnRRUqu-UwI57Yp4JJcg&oe=69F20616"}, "display_name": "Alien Extraction", "keywords": [], "long_description": "Theres a big alien mess and somebodies gotta clean it up\u2026\n\nControl an alien infested space station in this lighthearted strategy puzzle game. Guide Lenny the janitor through deadly and dangerous levels: sneak, burn, distract, pilot, blast and clean his way to safety. Control drones, check cameras and complete puzzles to solve the station's mysteries.\n\n- Scour video feeds for alien movement or lost clues\n- Pilot drones to explore, distract aliens and lead Lenny to safety\n- Control the facility from the comfort of your security desk\n- Traverse the facility minimap; just don\u2019t trust it\n- Attempt to mute the station AI when it starts insulting you...", "short_description": "Control an alien infested space station in this lighthearted VR strategy puzzle game. Guide Lenny the janitor through deadly and dangerous levels: sneak, burn, distract, pilot, blast and clean his way to safety. Control drones, check cameras and complete puzzles to solve the station's mysteries."}]}, "developer_name": null, "developer_privacy_policy_url": "https://alienextraction.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Crooks Peak", "support_website_url": "https://alienextraction.com/bug.html", "website_url": "https://alienextraction.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["NARRATIVE", "PUZZLE", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "305579791380963"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1210358307528942"}, {"status": "PUBLISHED", "id": "546720570362804"}]}, "baseline_offer": {"id": "546720570362804"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1757955600, "status": "PUBLISHED", "id": "1210358307528942"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5384068524936942", "version": "1.4"}, "id": "1375857106216026", "channel_name": "LIVE"}]}, "is_for_oculus_ke
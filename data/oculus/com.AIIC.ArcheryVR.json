_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cQ5ai7bbp9IQ7kNvwFRYZZW&_nc_oc=AdprRYDkwfcN-UhO9iSQy2Cp_1NDQ0J2Doz_fZR9aO5WBnu4Ie9Wkb1zULO3kFTJtcQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLq1qTeIM01LuxHLe_ti1MWHsdafoNdcyl8TQfSJmtBlA&oe=6ABE84E3"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j_m0Ju7tc0sQ7kNvwFu6Hek&_nc_oc=AdrQJk-CEpDBEHLO6DiHaL4BbkpgaYaN3isG7oVNEiT1NOMjIivcWFRjJ97ioaRSOc0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLrdnvkXNJWkPQrV2LJprzqjp5Ng-wT_8hyVLb9MaGvIQ&oe=6ABE8580"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dw9emigKXAYQ7kNvwG4kywt&_nc_oc=AdqcOUr88-ULIEptARsLyLxOfG6nKoVetYNgyaB8Q_EGTRJezSt_zu9Z3pLEW-UUGNg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIgywtGu5pC1Pkiewch7eJj0XJR_7A218nVUAiIBW5-YA&oe=6ABE792D"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CkqkVm-2HkMQ7kNvwEpx_Su&_nc_oc=Adr7ZU21TTfi8m2qcfY7m6gr37yDGlza3e371ajk0ACyFLcF61gru9j46Ui8vUXbV_Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHNeDQoMxpx3ABkOe4uVUg8r6JTOlYO5hnxt2kpXyJ_w&oe=6ABE8B9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uNkXlZZz8gIQ7kNvwG7rXgK&_nc_oc=AdrSsHWQMcXcxOxtSZX_Ur_Ga7utDMDMFImzdWzN09WOAwkMec8ij4SwLRx1SZ2h2xA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLAYLBUw1dIMfZsLCC8FKMApd42UmimPLE6kFu82gBFow&oe=6ABE5B87"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
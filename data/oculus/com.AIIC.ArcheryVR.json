_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3fkmXkqYYIMQ7kNvwE0S9V7&_nc_oc=AdqMuFmMlYxHFTwtAufHxYory6_6xbod3Nh7JWQAiRaZc4DhbfxbS8RRdlsMA0jhrlc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0p_BnQT8H47fvYCxCTAPlUtjKKMjZTXTKkVgRycPpjVA&oe=69F88BA3"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DUt4BKmM4dkQ7kNvwFMj5kD&_nc_oc=AdoHkgRAk_E9Iu_8O56J5InwacBg1R1Kdt94HAq9u1DmPtiUsHbG7DeKyIFcwVetb2A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1x3RWrTcMPxqxDocUMwpP9UvVoyL1IlBSWE2aVIX0yrg&oe=69F88C40"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oxy9WCyOYisQ7kNvwG45xx3&_nc_oc=Adoznw9XXMjPCxYdih75fP2UQvDYDh5xkpQXH06ptO0M2C_giYTOvON4jKu8xaOjzaU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af23XCJJYX_sB7-NQmF8gmCTzuZccSTCJaZjvyS3JDGwXQ&oe=69F8B82D"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A2_YPmLXn_0Q7kNvwEhnzrB&_nc_oc=Adq2FdStW--JNgBfMYy_tUfoOtOKLNjBs9EDZUksuQlUaSz9WhZwOrnZzH1geNgJS38&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2sa_Vc9peFzxjPGlrm8KD9qVrymo2Z2nF0uSLGixvkCA&oe=69F8925D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VPKdDVmrW4wQ7kNvwG2rq9X&_nc_oc=AdqJ-mEyHB0FZYqivQM1ft74lR8M6gs45X61G_jsYG-lx61ZzIvd7IdspJyR7doUcuM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0--cSnRAcXpcKF_ucG8bG07YmlJpHTi-CqVGLwhJ_o6Q&oe=69F89A87"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nnY2jFUX5XwQ7kNvwGxlwzH&_nc_oc=AdpfNmqPZKPO-nvaLfJQ1MS7Fdbj-1tVNnu5XsnJiu0mQt-O1l-eYlgPffAyfi36m3E&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBz66UvE9XuKBno_IuIgSum1oYIP1tu2r_fojy4003abg&oe=6A562623"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=21iPW0zXKCgQ7kNvwHQKA-F&_nc_oc=AdqI60Z3RUg_GvgtKntoafdlYo8YpDDPXvaOohOtZuc6wSyEsLGxdL4cy6WtQzo6mag&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDUg39Jr-nivrPTtivtmWjIAZZ5nALfajtdpLnN3yQ3XA&oe=6A5626C0"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jvv-Lt61dOUQ7kNvwEs9K9F&_nc_oc=AdoWwtahNslbvOhecU7vTfKz55M4RWCL9VqG08yYyTmYr-r9kvuUunRCqUkCOSHK044&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBY52HOyJEuRPiFf_PsQQrv9-boOyHgYtyRpb6Lpolqcw&oe=6A5652AD"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mQADLnHOJ6IQ7kNvwGaKQAb&_nc_oc=Adoo7kiVwO1vSYSgnFi9Up1d9peqC35jvl_qY0R4dX_4ypqiFcDh79OANdinzfbq9xE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA2ddRJKP0b1OMSErOJ8rlRBtEA-Y_Yq-htE-J6SiayJA&oe=6A562CDD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rnr_gOA9ikgQ7kNvwE0J6d5&_nc_oc=Ado_6YmAyPmumJ2ouaYVP_LyxddhogWFFxFPm_KTwHtvXL_H4uo5SxRVCu9BtJwdj-o&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBDzWbQxXKxz4D3KWLvQIGcB6GtOKFz_W54Y5eGebnApw&oe=6A563507"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vpPsgc1CSQAQ7kNvwHaKyu4&_nc_oc=Adrn3wAd5b1agu-2LZ8HOqxo8yXcuROom_psQO2xVTPhSBarirtdLIXeD4569dKsk6Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz_gXmQMqvgISIHeyMJxfZ04lBAEjjfz9PgATRYMe5vkQ&oe=69C27E23"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5kQ3Y-_uszYQ7kNvwFW1ODN&_nc_oc=Adprp3HIflqOTRLVhZMM62u9OB5snKbhmvQD6uKtz6PLaNwc5n_PMXeNasuJSqLnXho&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy4IzHPjrOg4kmu_PNvyH3aJURcQsZRbMz4g-5Kghrz9w&oe=69C27EC0"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_N4L4tDWkx8Q7kNvwH5guRp&_nc_oc=Adq7pphVNo7SmliHx-2b4i0JmRUSVeLy2Fxr_ZzpaLfPXWmB0RJ5W0AgYLxls9ADxrU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwyVrvru2CAfG-X1us1Sj-UOHv9eVp9TIdcJ0zUKF_VbA&oe=69C2726D"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-DMl4pAOR2UQ7kNvwE1EwVU&_nc_oc=AdqqhPUJ2y-Z15Y1bd5vGcC1laCL607COHjYtXc6DLaECouOZBncQHlBI0lOAIqVW9Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz7mCYNKEQ-BeYOLJ_4WxqJte0Uwm7J2y7FoOjP4Lz_9A&oe=69C284DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o3l7ZjQ9oYUQ7kNvwHMZ2ia&_nc_oc=Adq7aiRx6WktzMb11MJZUVYF8lyBw0Jz7yWkf6eNdiFSt0sImFR7qkJWPoOumqMUv0Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfztIwCzCGvRYN5LvdnyKEPA2vVgIkwUDSe37ks53wFbwQ&oe=69C28D07"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m5dzn2uwLpsQ7kNvwH0BS8J&_nc_oc=Adpj8a6ir5D11e-PBTJC74-tpfU0onoSThaIUdSAPX1RmZ0G3F0DGsY0F0piGCQJlgE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfydcMvZ5yyqKcrk0oJpsO91MSQlkKJli50pxVA2H7VEqw&oe=69CFAD23"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=deBVfNj9_CMQ7kNvwHpodO5&_nc_oc=Adr-8NSAfLJxu6HXCGFsI04YXoNT5xAHll0aTydC1CJz5siBU43jxjnoJGNopx3Si3s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfznYVBwADzaifPURU9atKhe6qyiX2i6V7mljeUvKPZMBA&oe=69CFADC0"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uo0DX6N6Pe8Q7kNvwFRnxn7&_nc_oc=Adq4WtEeP7FdC6X6jJaFuddP9uxLOnggvk8LNpgg9Ul8LgRhsOUED9vEBAVasuS-tQE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzvhLdWrT6AC5WOp5KPUp_pfVXyhj_iGbA0_WUqJ0M24g&oe=69CFA16D"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3acLi6lkUIgQ7kNvwFi0H1G&_nc_oc=AdpNtqyrGn4hg5pG0pnNDSSoE_ceG5C4BGi779TbEnfvhph1Pq81bZN-ZoMNWCilfjc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwGdgvYIgAhpHrugTy96Hr4VBrpP1-M89i8_EJsF6ubrQ&oe=69CFB3DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vux52z7kVMYQ7kNvwGlaLcb&_nc_oc=AdqEq8ex-7Y-cS7qXmaAA_vgMf91pbnJuBuy-i1iJ3dB_6aVXE0aAyKLdUxknA6SRRw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx68_IGQ_dFiAqfGeXqrPjNy2_GkjSnq1Y-wCc8DY4ZIg&oe=69CFBC07"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n1IUL1PUHVsQ7kNvwFVOEsY&_nc_oc=Adq7K2qs01ywLC7EMAwBPizq3oCjJAd42uZ4Y_v8Th_SdOtSnjJouybGQvbr3r4E1uU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_HisojVOrtbeEhTGoh4xkpGPcWW95FJR1Xel5k68yhQ&oe=6ADF4223"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uqnvse9YavkQ7kNvwEPq6xl&_nc_oc=AdqPG0mB1iKh84bCDof6MWUEh5n46F4OSuoN5lqFjBqDvLEgAp237xMwbEVN7hRwHhM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNh5M45XpPKf_GNMiDOf2JrZc-_RWM-9V3Vvmp04PL9AA&oe=6ADF42C0"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NoM3-IjpuUEQ7kNvwHKa_cd&_nc_oc=Adrq8rI-ub60h3vtGvDPTSQswjDqLRFpxiqI1grb1hayzV1zrBDdV0B58BKYpG9Q50Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPA0uPI2kXFvTlawySZUdAxkEXKE_uKXBYUaEx_waKPeQ&oe=6ADF6EAD"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZPyJ93XVvpoQ7kNvwGVwxN2&_nc_oc=AdoVQVGTQ5Syag1NbE0nddDAhKxoK7UVe9OxiOKNHpLvnDzXFV-xfjtctex7dI81GK8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN57ZTyq0YUJcebxhoTJ8iRHif_PgeIW5KaCwYoEXHLrA&oe=6ADF48DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wUAQRAcn144Q7kNvwHsBxBs&_nc_oc=AdratESDVksHJPa8SVKRhizicn_UADj7sG9orsTsCOSXRDkp4e-a7i4NrQN9NCq6WCM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNdj-uE_a_1AXv2BAOivoDxcF-BqXZwVX2hZXbPH2r0Jg&oe=6ADF5107"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iGw2D4oeEY0Q7kNvwGv8Gwp&_nc_oc=AdoLxx5NNZji8jB8RHwFy2nrk-7X5IhvroOql5Ax85QoL7qwKB2QQwwXR0cicHNwlRU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_z_dRLcfb2OYc_onIlACyj9YyQfJbXweGs8sNUOWE1g&oe=6A5B6C23"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XfmdsCAz4Y8Q7kNvwHQTsyc&_nc_oc=AdpdFhXz8qPH0SFUf_cf7vVKp3amyneQKE8rU3H9QU_qNwoOnu834IntqDBLriMKpWc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCoWrXmrwBxecImc0PJqR2hAOZTDAluo7_Wra_NgMdg4w&oe=6A5B6CC0"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w6EL7SeGhlIQ7kNvwEwPG0w&_nc_oc=AdqAW-j69KeneF0c0Vf_lgN6UyVsg1yvwmeRepVruk2VYlNKEpr-VuFaYacUNNZ_iQI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxVDh8RHHUvNlpiQ-d_lA2ED8GxOy4v6-9aL4c8gvcig&oe=6A5B606D"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hZvzzyplspAQ7kNvwGwv85C&_nc_oc=AdrCHzDWtmVm4CajstniBJ8DvGVjnl75A9FY2J4DMZDFgvBZrT14EGK1iqk57eUxM18&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCHqNZTlkyOr4tslaTzIQKfhjOwT4FGMlQLyyZ_XXTuvg&oe=6A5B72DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N3cxaxBulbwQ7kNvwGPnrWr&_nc_oc=Adp-clPk2Hrha1KYFW-kjfjgD67XoLUBxGyxyFHVur3b_BNwGhiDRIwi3s7YEtv8ykc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBz3UOaYxBeCKQW6Jwxlxwi1yoDg2lqgypaMOdjFYAIYA&oe=6A5B7B07"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
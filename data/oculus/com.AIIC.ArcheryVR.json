_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eh41Y-XQt4IQ7kNvwGX8SRF&_nc_oc=Adqe-VlSR1kWwUWR2cTcbksAPOpL_1WjDfAuUF5yCMw-jgmwup6jg02-z056mG6RlYE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1bGO2GfzCyquUIappBGEPNXcnhGgQBCMyS6onjkrvOew&oe=69F345A3"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_UNf1UVHl3oQ7kNvwHxzSrd&_nc_oc=AdpDV0SIvWRRWV2cOXEQgJ8GtEpohYyXaeRIzq2M1OEw75z-aPVPhDsH0-4E5jT5_5g&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3SvFpFC8GiPLSuL5wu6pdb5fNhRWoASsLuPze2F7n0wA&oe=69F34640"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zJJ8I2bQSsMQ7kNvwEbF2F5&_nc_oc=AdpEZ9K9NFMccnkyV4eVAriGtAcsBwbmNU7yQxvnDvvz8hVArGrzhPQ3lo9dYYMpAXQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2sKTx3CqKlAMFlZoQUa2hE-65DgeBLwi5wlFQ9ej8Vtw&oe=69F3722D"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VKZrLNlijq8Q7kNvwHYOA2M&_nc_oc=Adqt8A1Uhz3EWXfQp3DYTuSJiKrJxld_EJpRTejrXgHvTfChh3S-NyGpi2L2jmhtXr8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0c4ETOTCjcRSGkaliRgcsdy7sMkeZBl-IBruq7h_8ACA&oe=69F34C5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lb35XHXeYEwQ7kNvwE07huk&_nc_oc=Adr_RZf6Ef6YQQZApYikD3uAUPrzMrTYz5acjne7uziYNeqGZh1gjmvpuZLXGEORQ0M&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2GeLUrTlTIMo3p7vXHqI-6zL8w4N7kbp_mJiXE_lZBtQ&oe=69F35487"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
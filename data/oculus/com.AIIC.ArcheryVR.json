_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rULtit4unS8Q7kNvwHhiv3y&_nc_oc=AdoNATOOTyyWlz2b8zuIstwwqXsWEYcvhz9vT9bOd5JiGMuynCvIyzbWc85KRr4iv-M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3t2TmOysOfy2jmVganjTyi_EVNWR4Hl8i32cfym-6A8w&oe=69E4C523"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9HXLFrVtpgYQ7kNvwFuKA6c&_nc_oc=AdpdqlAKkTthrGY90ybQAvW_N8hWt1xSlcpDJjdRSU5iKN-SA3jgYOFf0hGNcAkXy2s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3YYAZg1-iauL4fLwp5l8K_i0glOTQBeESs9tE4N5-sDA&oe=69E4C5C0"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OIBG3ww7238Q7kNvwFfOoub&_nc_oc=AdoN3-TdxGAC8R7WF_z6TLLAIGivXaFV5LiI4T4NddiQ1_itWDxnEjeHLYl2AyqoUv8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2-aE6nqTVb6txOkvZ37qvUfeH1YoBaya2Jb83pd3-_mw&oe=69E4B96D"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n_krhQTsEZMQ7kNvwGa1oy9&_nc_oc=Ado1GFqH5ZSL8kdbCIPqDrVRqNh1DDiB34gGhlEAEe-7bmPzDvEBtB3GfwS4IuwId-w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3nifudxskjC6tS8wXu3fQ0iGeDG7Ef2n2n1B7M9VzjdA&oe=69E4CBDD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-EvwsJwg0pIQ7kNvwFjRg4T&_nc_oc=AdqHgMMhXEKA9u_SJN2T2EZrjfkxyg-PiljU7_127M2GdJoX1Lcwpu9gUt1xLOsFemo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Olms-OdkjLGdqszbh-5GZfRcepFnACVzulu0hQWc5Ow&oe=69E4D407"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
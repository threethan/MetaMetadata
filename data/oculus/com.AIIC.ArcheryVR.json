_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PABJrfJUFKwQ7kNvwG9R9OW&_nc_oc=AdoeT2rYGjy6kcyspX6iThVTECoz5J9ovCMj1hUlEZmqEXkRXZgIubkywZlrozOo2rU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6sBzjAsAjHgVejHZ_-T-GwPQIULZEHBqm-NwKSoaBVAQ&oe=6A046923"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hc06FxDvodIQ7kNvwF25YTD&_nc_oc=AdrAW-5UUgzy6acRokUR8nq37cbOPx1C6BvA0TK5_F1JD0F-kz4y_SpZ7aJPGGwm08Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ymffZuzhG600F73vXvpPq5g1KdsPsVv326Az8VRoh6g&oe=6A0469C0"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WDUYpFQWY78Q7kNvwHDFn_g&_nc_oc=AdqD7YlvZz73Vq0oGmWb9g_r0jP_sUpzUpX9nUZL8YMBhpHnlA8iq1OQ7Rn2sUIHgcE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Mv7uoZ0PoMUFlTn5-xJbMmLzd-fCCZVCzpFS5hNpRhQ&oe=6A0495AD"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SbtuszDDD0wQ7kNvwE66OK8&_nc_oc=AdrFzRq2yuftlL077rgDLv0THkL2o3kChgb7bMgnuKyZgjiJtlCG1W_mkFoLiljuTeU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4lFFWMkG8xwfF9ZfQzz9B6NuoDXK4iMnBFVN4pKmstrA&oe=6A046FDD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vVoJb1ubCF0Q7kNvwHnyGwv&_nc_oc=AdrP_Co67NchdOR4GgW4XEPQf0mFjHJX9UsHiCPqEihDUUFlA1FBPdf1us2mLPwxFtk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qDml0DxkSX7nEHk8qJfxAALwXN0Zt1Uy9DE8br6CDLg&oe=6A047807"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
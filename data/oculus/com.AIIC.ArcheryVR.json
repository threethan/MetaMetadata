_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N_m6oGhzwnwQ7kNvwHT764S&_nc_oc=AdoMCCVziJJhhbEobwycRurrXV-xwPtnfUxCFDU0RPIGWs8Simo6GXpGuytJKIdJd6Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKq81TZoZSbv3SwJt_rJDyiOjUg9KZ1fzX_xXddxoJxgQ&oe=6AB00463"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qT-7ayNS_HwQ7kNvwF4t_Ga&_nc_oc=AdrxfrsT_sHgbkDHQwuwPZ9pRc8BZcjf0MGZShVBFYK-C8nluSoogs0eDP6d_Zuye50&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL00BcOhUWjYrSFt23M-c3HlPkKC1QtinTDcDqe7yh86w&oe=6AB00500"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5DPSH62iJnMQ7kNvwHmOKf0&_nc_oc=Adq_tFvpbt2-FU7Uod4b-Ec_eU1EfSj_WGyqjzFbaDAouC0h-gl-WHZWVCsfpkbau0Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5ZKRgnpTN4PYtaiL7mL4o_PSVxPWEY4C2_WhiwID_bg&oe=6AAFF8AD"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1BRVSDfz0GQQ7kNvwHARVTd&_nc_oc=AdqG7DWsXyr2ueQMBKBKRFtB5Ug98z4xO7d9ITtU6LqNQztFi351OmD277K9FssgIzo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLLFes-3ucyOt3DEnZJ8Rc4xAsjkIto84FR6CzEc3vyw&oe=6AAFD2DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=30ZxjWjepTAQ7kNvwEix8w8&_nc_oc=AdqP-fkPKcR8rwnMNLmptX-N3Jdgg9-fexd0qrOiPEDJOi_LPfYJlS6KlExf07GqntM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqtTCEUKaHvlWMR-P5g8R93JEY8K06YIIMZjnxLKufAw&oe=6AAFDB07"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=clfAIlYQj1sQ7kNvwHHdVMe&_nc_oc=AdpE9LIsA-ES0wekBvBXCGlv2IWqymZn_I90DCnBL7GHtEgMQJ3v2W31AgEI0M3X7ek&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCT6V082-5l5W8Z8uZWf2lKsqZi49Rm3bWoLCX0as5Mkw&oe=6A6DE123"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zSSDsR84aqYQ7kNvwGu9p5n&_nc_oc=Adq3D7sP4YhvHQBlF7NXxQ45pnauD81oEQwchfyl5gY5uqPtaNDWfmTTmuU7E3bMKDQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBOjnTw19p_WFoWyrJzWmX3d66Cf4DnJCmC5mlxqPxZg&oe=6A6DE1C0"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-prK1-U8k2EQ7kNvwErnl4d&_nc_oc=Adp_WH2R9URqCIe0uoEU5rPQykcv5k8-YiEAOINSkn0goenw6jQyYB2n8xddkqVCVZI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCglrLJoqQSA9QehKrZg4bIh1cb2rwHKTY0zd2aBNAOaw&oe=6A6DD56D"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VWLGK5EPtNsQ7kNvwF9JRml&_nc_oc=AdobY1OaU-TxrZOEBsIT238NMcKwgEkEHAOsvpKIlzHSImHO97NX05wiInBGLTfnxlA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCMlc0AdeAqFdlxOL1m_wBOpBX9fmQoqnFSdm8mA_vfEA&oe=6A6DE7DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ekEjKiUiTE4Q7kNvwGxeC-G&_nc_oc=Adoe8Yn7rpiPEcQCO9Wg2vJsXkb1pf6aeOATwIbUkU_XIth4mdkfYYZX1cId_pAIUaA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBGWN-KjxGV2J_PbBSVjH2G33ozyp1MCZcURYY0GckOw&oe=6A6DF007"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
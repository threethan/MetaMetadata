_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=enQ-GZoYN-8Q7kNvwGWI4Jh&_nc_oc=Ado0RC9JoRlDxHPMmuPZYYnZuuAoPcZoWVw51mziGlpnHxCqVHCSl18gei5LGBpD5MI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBdfRk-vFfGjXneH0CSwkfukfiqxBTT6tdDtVXz5jfog&oe=6A4F8EA3"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YhHN8h94LfwQ7kNvwEGGTut&_nc_oc=AdpFbwWYVvaFAy4BsKL0QVtBfE5EntSwrP_3N_mhVQKh4iL15cTok7uI9mVaWfQRPRs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAiFRn5H4vC0d3hgezhcxRl7IbKAcrB3uSzH7zzoiO12w&oe=6A4F8F40"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ENY4xh57Wm4Q7kNvwG3dfNw&_nc_oc=AdoXq2M3fIJFzmrbXy8l0HH8y5EwuLWuXPtCcmX6FMj0kdqPkbj66is9MS7d40q-3s0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCGYdXJCZ0YA00mKO17L1qjh6ff-iKzLyrp3Tjfx2i_Uw&oe=6A4FBB2D"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M8n7T_rgYKQQ7kNvwFN8btR&_nc_oc=Adpb2kop_ZaXayaJuyxxiDLA6RPDm0vm_xccmwgtbFI932Wm0i5VNhQQfgGFI23e6ss&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAAUrKEiYerMbLUNa7MVWyQk_W4QdLwRpG1-vxYuNpNiw&oe=6A4F955D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QpjAS47q43MQ7kNvwH71Yiy&_nc_oc=AdqqBnAMwgCHOVDuorIsZFkwv9C2bB8kKp41SW1dns-xtxb83jr6b6T7oLYdTj6KkqY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAVUSd2cO3INVQVVJdyWKyF8zJAi96F6Km5hbH7bkzOmg&oe=6A4F9D87"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3fkmXkqYYIMQ7kNvwEqB_gM&_nc_oc=AdpP22s6MUT-zzXOdbjC5OCZex0l8-6A4j_YiN5HQ7Pvt8C2xbuOjd-wPpKwE2oqrEA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af03JuD6bNYFJp-_IR72Seq8Y5Q1t-fJDZuM_pIVXYULjg&oe=69F73A23"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DUt4BKmM4dkQ7kNvwETPcGK&_nc_oc=AdoySiFT5N4ZiKTscqjZQPZXxP-Wp4AOr2FbWAmTuraahl_3dwrnOqXt5DKzfI2iv-g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2M4DphXqmsuymsvzgs_1qnUa2v5xZydN8KBgutPZ7QYQ&oe=69F73AC0"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oxy9WCyOYisQ7kNvwEEt1vP&_nc_oc=AdpYD-yt-1yxVuJ4UrnDn75O0egIvkRyTB1YlrtwRv2R-F_xlMf40CvQDJnE2d6d3O4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2iAKy3Xoi-30dGRkhPx5fWxvypr9RwGJf3F2gBfSEq2w&oe=69F766AD"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DD-HVbdOqocQ7kNvwEZ3UJQ&_nc_oc=Ado9QdU6kMaK8tg7jOB0szo4WsdqVAF8bqGmiEzRmTad6smkdtDD_YiGEEQq0_NXoA0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2JeYwPFoujm6QDBCZRFwkLB-yN7WT_aymFIagTUqeSsQ&oe=69F740DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VPKdDVmrW4wQ7kNvwEPDahB&_nc_oc=Adr6dhn6seE7kTSed7UDEZXOnu-ks2W_6Es3tFnJhbTB00uUQbUZGPif4ixiKuFbg1w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3Y5sesueficNHEvJWE5jlhQShOwgmLLLMdrDMuZPCt-Q&oe=69F74907"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
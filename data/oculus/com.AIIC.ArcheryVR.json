7_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JHDerXxTPxAQ7kNvwFcfPVh&_nc_oc=AdqKtubpit763WCZ_Fs8AmLkuHe3PfYIthhHHEr9ccmjosNkXhgacVmoSq_smqS64ZM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9F-EBM68C54P2LGtrO7nVeYMEFUY8IwFX0Erw5SOvOA&oe=6AA934A3"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=av5DxYPHz6YQ7kNvwGIWYB3&_nc_oc=AdpMxZWyVYxEeNwH4M84LCJGAmp_UX0ibWAufGgLMIkEj420Niby3cgNRn5dmTckLoU&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLue2Qlvx9jfcuLR__yY-nQ4ZhRySHRdH3P3nJ7F6AsPA&oe=6AA93540"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oid0Lw4mOhEQ7kNvwFt9Rce&_nc_oc=AdokG7UnD2cRYJLLCXLop5xfpfClA9xWfY3ySjoRBw-kF2vPHPtpnTucAbigLoKvh6M&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLoGuKWDkrb2nJJBe8HSkxqRcThT7GgjZElzXNMwiKUIg&oe=6AA9612D"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q5Q8aVU7fYgQ7kNvwHkuqPu&_nc_oc=Adr0ncBU3auPQCHiX8564QLcKPHKRGJSCDMzb7VgXbRK7O7PJGIytj6rhE3vdB34Y30&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLujPLvKhGi7c9uvoFOW0EMFtR3wYABeV0PC3CK0t7q8w&oe=6AA93B5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VbMKg9Qc7VUQ7kNvwEVoB05&_nc_oc=AdrBmOFiEmDyoYKsPmdR0nL4W4yqwhKt64Rhwb2jai2OBUWau8qHnKcayAod7hByv24&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJFO-ck_wt4xUqN7rAldXLGqDK2DcMTGadtQdOc7ZhAaQ&oe=6AA94387"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null
_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U-1Fq2uTAisQ7kNvwHjbPdY&_nc_oc=AdpIf6LcNCBZRPcpjjzhCh58edjmV-dDvbjZBTENam0LEFRIKi_bX6x8bExqBxy1LyA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8QHZl3psfgsgEOSG7v2JOOO46389Cb8zJoWP-BCEtjGQ&oe=6A43E963"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HqwajVpXPhQQ7kNvwH0WtZS&_nc_oc=AdpRhpV0F9RrwQaVhkOHe1sHF8D9VYjBkKCpnMxQaqlLqmy-cDn7xek77bLGwnFqMz8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-tjeDiS0wiLivUTCuqzHfsT4e0gtTdpe9ZuxPZ7Afgw&oe=6A43EA00"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1j4JJewjLnIQ7kNvwGKcLxE&_nc_oc=Adqp1KLPsfjKgepGl6nwZcz2St4ff__aI17gNxsOQC75kwmZSnZ8vMZ3GszFQNV0B2k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-kkRt3Ri1AKa1VmKCvWhF1fzlxztTVC-H0FA7emvxtgw&oe=6A43DDAD"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0EyoSNL173AQ7kNvwEXaTJl&_nc_oc=Adpp34n5S95cT1fhQYmLbBF_oyGYAjk5NwOi2qWcL4APc_H3mGUyxUFtxsVFDMJYGRA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Yds06u7I-HuAjF_zqlCAaCUqTD31f_GqTSj-RrX2z1Q&oe=6A43B7DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uY9PRi_f6usQ7kNvwG38uzN&_nc_oc=AdojvEMuFRJbdKg3VO91KSFvUlyYe2xf2117nFfFU8Ud85XQsvJ5aGRn8cAW1JumyEQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-KG6XEs3Mi54tm6e2sCCwHBFi4XylrY9XnlsCs-00Qgw&oe=6A43C007"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
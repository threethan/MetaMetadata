_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KBA0jyhFQZ0Q7kNvwGVRftF&_nc_oc=AdpNO6SV2KxIMauxg6Hzw59foD9QJuyK3K7y9rv71-bsSdcyG06O71H6M1TXV-CDnFY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1VzHSABC1STFDthTx4YL3U3-FSgOES_Gxf77PeBm4gew&oe=69E76823"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gvtbN8herPAQ7kNvwHL4sc5&_nc_oc=AdpjZ68ZLHVTFrbD2TpV_dGmd5kplgRVfiQWC7-Ny9EcW444awopCtIMToeQAUhjEoM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2R9Zx7zYnra71o7Iqo9gTUR_CggokpxV7gVAzOe6I-lg&oe=69E768C0"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fRy-CCEOv-wQ7kNvwFLMQQv&_nc_oc=Ado-ROsYUKFb1VIOadHDoQjIiwwyIsxWtY2wBbdn6KzQ7nc2fsfktBmV28Q4Yi_r0lw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2O0mZtSdggxgxZyCjL13bPLC5twC4MO2lDPpoXmgJw7w&oe=69E75C6D"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n_krhQTsEZMQ7kNvwHkO5m5&_nc_oc=AdpnsekjW0AfU7r0PNOAYVmQCmTVOwEeaLxOWgYjli3OmNDuBwxQKOK8YiZ_UVcuj_I&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2z8qX0YLhKIyexXhAICWJBfNEdcnDJBRXF_HbbrSoHmg&oe=69E76EDD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eGanakhplgkQ7kNvwGuTv8E&_nc_oc=AdokO2e9CR2p1CLNTW7LWQ0F3s57MS5QPkxCb4ohA-iO3wsN3onFDh40oDe5PHufk1Q&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1XiLWWwpHi0MvIx7H8eiT5nrzicaUH6ATGH4nKW2hMVA&oe=69E77707"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
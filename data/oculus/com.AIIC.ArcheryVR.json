_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VPM9whnmIm0Q7kNvwFwn0QE&_nc_oc=AdrlVtpy7ixqn4dTDrcWoAfW-fdSPkcEQq35CIKdiJBGAMz-ULQbJjVaExWlb0S8HnU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCWmcmK5IQtwSQIoQINAPRgt0ygsyZFAGMI_6RakWz9Fw&oe=6A6B3E23"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UnuffUwj7J8Q7kNvwEa5pIU&_nc_oc=Adp3_Z8B_rKjHF4PjRyfa7hSxzbWz_ic0q7P69r8wqohfbHrLq7aNYWnzaR3bggj0_w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB1KzpqePlJ2rpCncw-m_AyHBa6MOXDBD8yIYWqmUBQjA&oe=6A6B3EC0"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UgFBu7O25jQQ7kNvwFOhh4M&_nc_oc=Adph4e0HukC1NGYiaLvCkm5V5SSGb6TCsxuR7Yz0w9H4zEtr5aqd_SoaqWrRHZRvcb0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBvYn6wtcel0gKfQ_yKR1dyDTxm7_zWugxbyGYDQWSAg&oe=6A6B6AAD"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VWLGK5EPtNsQ7kNvwETOpaD&_nc_oc=Adr6Dr7gXrPKFBa69yO621b2Oqfyxfwrox__TcKaaJcg_DNHXNov9BtUBvUOqu_6gCM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDrCV7KQi4c_FL46WPf1z3miOB3kA0zN5x0MGJLSx9Ftg&oe=6A6B44DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y29nWbpQHlwQ7kNvwH-cRI9&_nc_oc=Adppi-1xZkwLdhzgiCPCNenOICU7VVuGMLsZ32B7b_QwS6j6PvMdSqOKPlxQKQlvIjk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDCfFC0CWj2IvAr29i7dAUC4PhFHz6R0J8zUJVtSlxzhg&oe=6A6B4D07"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
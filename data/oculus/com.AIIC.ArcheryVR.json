_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kBHUD70srigQ7kNvwGtxvC7&_nc_oc=AdqDvcyDBwqnCNgf67nR8PTGl_L9rH_ydoO4XBbSlmClUI5kZEX_KJMUFGV5z1VJIOA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPRZO_JRgdml-JT8cijdpYnHqO98wtCfW86Qhug00pofA&oe=6ACA6263"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lw-pRd7QBtYQ7kNvwFRTvKJ&_nc_oc=AdpA9wfHrpNsLqshmUXQwb9ZENeoxcG2rHEtTAWbGv6k3vqwIVHMlsSxJL533zY5Cy4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNROdWXDA3Qh_kuqIC9x6prpojRG9-S0V6iuMNFHqnpWw&oe=6ACA6300"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gHXdhdue0SMQ7kNvwHBlt8o&_nc_oc=AdrIftjpfsd9zQoUOcpvEcTZOqEmLjJMad53I-pP7V3eoXHpyJdLN4-hmyL_cWnEZgg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZypn3kJhYa6X9e8s-Smvy1dYsoRBwc2rcsX-MMVjL7w&oe=6ACA56AD"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HETXPOZWJucQ7kNvwGG9A79&_nc_oc=AdpSlawGLd0lxvcTTTVgA3rVG0PHq2JKIsobel7y0PThRnahbhgE077fWyv8l60zIJA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOHrlQ6_yGJSnfFpy6cHx6UdyBGIiW7cH6p4AzA0sMpYQ&oe=6ACA691D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dT0-faIJLiIQ7kNvwGxPrWQ&_nc_oc=Adpst996I9FzZ2X-ktRYLaAAS4dhwTDKt3o692hPWek3owtMGzuf_Suq1uJh5GUlqSY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMAiT4Udx1te4WUh3CW22NEIqJm1EUV8FvLXEAUYaEEdQ&oe=6ACA7147"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
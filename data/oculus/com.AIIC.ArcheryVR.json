_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4wjiBT16s20Q7kNvwH7Edt9&_nc_oc=AdpO6L34C3DoipSMJ93LO3mXm01u8B_EgElbybGUX9s1rxGetuivjFlhkPqGQ8JS9R0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7keZPKj0E2AvDoegigL-_cPa4M2p1sXukwK0dquk6XwA&oe=69FDD1A3"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vG_sq9sDwkcQ7kNvwE8Uniq&_nc_oc=AdpD8Xka6rjMFuMQr3gp0Kvim2vQHAabHB26YV-vMqfkNZ58I9qLMIp47fN1mup8FDc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6mTSTL86HVkkIGIFpQBuat_yoZWGQANng2L9mWVYZxVg&oe=69FDD240"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vEjVCy4UCQwQ7kNvwHvUG7p&_nc_oc=AdpBzxhpSox6AurGmpkoWXhr7t2LRZMMLYYBdvIAxQn_Ptwd-afQa-3vOUN2oJat9cM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7jbNDsFgiI0HZ-jIYYUDfpV-MZfzzQEY-XtFD_wj_IKA&oe=69FDFE2D"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FTCIGyuXfXYQ7kNvwHyQ3jZ&_nc_oc=AdrLQNHae9s8lwHRxmLtpiLRd3fDYxX_ImuFpZtOhiixpCb_YfKElDAx0YSyD-xMWP8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_y5-4i3tlmnLTpMCG7YlFPW3PCOedEL2YjCw9CxWFzw&oe=69FDD85D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vgNJgNiWxBEQ7kNvwGyOwyd&_nc_oc=AdowF4hW5CMWQOi9cEgG9vYzi9g2FZu5J_KBzpFeV_Gt_jH9uhUSFxLPG77mB0gOd7o&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qwes1N7nW2Okav0xqYYtqAecVeGQlIfHOk9RTLqlY2w&oe=69FDE087"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
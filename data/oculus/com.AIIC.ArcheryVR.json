_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wlICvVSd6SoQ7kNvwFvhc5a&_nc_oc=AdpDE8hT4vp17Kf10BKuyx4CBi0o9Cg7tijZyX0JCnprvahIQFy22ygQZ1vCgJmfT_g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3aTDYByM_FSfWqf9FZI0n6wHfN2oQvFOZ4hPH7yU2nw&oe=6A3568E3"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AKM2kUYfFrsQ7kNvwGeO7K7&_nc_oc=Adqigdtbj1g6rSldxugiZLPeE7K-leP351VsRLDK9JZGkNlzFpZGcBanwUm557xk4E4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Cv8rUzeiSn4cF6eAnabji2R74G6YNf-EPI0zxXVHPDA&oe=6A356980"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I9RVebYQXj4Q7kNvwFTwJlU&_nc_oc=Adocsg3ItojYSCWsvh29L7N2az4SI9nA2rlkH6Up2w6pSOTgQWVjQlE2W1_U6XXh0-U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bC9s4bOi39z3KGRyi3IuKsAn6c4JILFf17ImEsthTug&oe=6A355D2D"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JWM98I3SrQkQ7kNvwFLJoNs&_nc_oc=AdoqEoh1hMV5ca4b_W2W2i06GBkURkb7N8xkrRfncCKpJdWfVIGjL0O3-_ep9Pu_8LY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9L8UCKJZAXDD6J0pzc6q2IO2mlK9HvM5E2XkT5J2O6Wg&oe=6A356F9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fqMUp1ChB4oQ7kNvwGy1wOl&_nc_oc=AdpPASYQsJM9O8hedA3JfLcYMk1DvSBweSxWU5JIZ99jtb9gQHEseUvThCKWDNcNVcw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-aTIINstfbBLDQr6e-750r-pjM3AAZ4PcTmd3fJDIEXg&oe=6A353F87"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
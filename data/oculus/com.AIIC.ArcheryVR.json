_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=08uEeihNf_kQ7kNvwG7Ze0z&_nc_oc=Ado7G9L2PmX1y8u3mm89yI8Cx5at02_bUmwIEEmXLYePrKT1DAkRrSfgQCQAoE0sOWo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDUHulCq-DOVbJL2JDhjobw_JAasnsr_LRverk4p45vEQ&oe=6A5E0F23"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F82IN8LaNAkQ7kNvwGmq-m9&_nc_oc=Adoxa8whcvEinGJIGE3RHd6_SQ77_qeJnKekkiuaxk4i30eY4BCwg9nrYN5LRwW_gV0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBu1De4fNh8FeWfCxGzL7WOjeT0Bd7-RtMOYCaq280HYA&oe=6A5E0FC0"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OawZrSC0vMUQ7kNvwEEcMB0&_nc_oc=AdrJMfMSl2SLy87UMbCFz0Dbn_r9XWsqZRzIBAv9gICmQpC5CuQiVTJPaQy97biKZvc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHt_4tPE31FCioi9mHRQeYwFtyXTNIqsoCDTZ1z7seDQ&oe=6A5E036D"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hZvzzyplspAQ7kNvwFejtyx&_nc_oc=AdrBS_Hk1V0gsTfa3lztM2z47lZpMWONZP2fW3zH_xF0LcK1OljiZYqxQNoW_KaQAyE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJVMhSJGpTdm4Iyzk61fR41jKYhWDoOBGIXVPuq9Q6dQ&oe=6A5E15DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5mcaF-B-LCMQ7kNvwEvQtwR&_nc_oc=Adq1SaHbdvOfRLCDSAbf2RqJGioPblKpR69_kMTC_f4TZelM4TUNQi2ohJiwimPP5rU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBKHa2Ri0HLypE5mWVIZCAHjjE2MqVuQRA1OYD_KTeq6A&oe=6A5E1E07"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r7hgxH5L0IwQ7kNvwFa_qNU&_nc_oc=AdoCLFvCoyRm5YQktjnCU13WI4mxYHyI3ODgBZki5AuM9KCY1jSNpPuTTjRKmYxpRqU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af59yzN6n3V8Zs_B4pkj7qbv9pYsN6HQXtZZQwwGf8DQOQ&oe=6A12E9A3"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_bgS07OmjBwQ7kNvwE3xPwl&_nc_oc=AdpsQS-COKS8EnBf5KlTuDfRY08LPBvMgJDJygLVqY2mGyvJES0JLUduvZd1qNoo5N8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6TeueD3L7XiqaK2oy22pjsGihJr7UGSH252bq98FiPmQ&oe=6A12EA40"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7R8L74764DQQ7kNvwHaIyDf&_nc_oc=AdruQgKTVod0yIDRvk9jnMwj9TZLYF9LS6ohXN4ZHq9RnGCgOS7HmSNl4fJD06Z7ADk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4fqMJcCKQRpxf-MMuRLLyR5NXUzUQUDzOZYmTPVu7MYQ&oe=6A13162D"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JBABVmKX9Q4Q7kNvwF-cSaR&_nc_oc=AdpeN9PNpabDB1KSBHZ7AyPeLut6NaAh6ki1ScCWYvMKnk7XtnUvanixzNLPB-_kiiQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4FURl-3sNTinYXfuQixrVDL_9O5de_uTj2OLhXNvXd_g&oe=6A12F05D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nWMPGGG5xegQ7kNvwHdmT6A&_nc_oc=AdoVOKkdQFlwNMERg4_oiFIXcRDByYOYel_uNz5lxHRCQCgzovPA92SJOJnQB_G6CyQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7c2dBtElFdnLcCZ78t5_Zsj1-4XrFene12WigZ1i_DPA&oe=6A12F887"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
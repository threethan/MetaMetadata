_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=72vuDIr0GjkQ7kNvwEtWO5h&_nc_oc=Adqf4zDWBD6-dr8hgNCbUpEEAYMXnR7Kl_DQccLupBES-VLYQQWdSsrw0da1hImRbTk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUTVHSp6gBBUlHpHgUGcSS0RrTqHUbJnIyV3mTAYLP9Q&oe=6A984963"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YakMjT-F1FkQ7kNvwHnqVK1&_nc_oc=AdpISAu9pcdU4_XHlAXZPi6vDY_gD4cNoaCFt9CgAlE5g_B0v7aWXYbQDaLqqPIL670&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMByALlMBXOGkx6YN_j-p_u7mNCCV_dDRWA9VsWT4eIA&oe=6A984A00"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ADUfGOJs-IgQ7kNvwFWhwbC&_nc_oc=AdqOFTqSTQrHTcaFhQTUMci8CZBXJeBrPtIEwSv1Q3eu24L-B6GUfniRCsjSM29KpyE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLjfVd_PFeXiZi5eLOcK-CDv415Ra10IgnD-Z2Y8HUEA&oe=6A983DAD"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rcvNmqxug7oQ7kNvwE_Ohs7&_nc_oc=Adrp4RdYEekUDJwKzJPmzNCHUNGhLRNXPPdRQ65iQzw0j61xeX07LiWlD4Ir77nU-EM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1ubcQ4x4gqIQOjv5LiHyajzoIlbc_Nbqp_9hm7qnIsA&oe=6A98501D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RvGtFvOgJjkQ7kNvwEF7NJp&_nc_oc=Adruhm5fDl1VEtcQgnq4DdXyx5vIHMdxvMiTej1NxWDuIR4kuMnzZQWik8Tn4CVPPdI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLz7rB8NS6_vU9H-SfNyPSQ0FBeXOcd5al7hH4RXhH-w&oe=6A985847"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
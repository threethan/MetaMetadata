nt-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw_9sJF7Qb32LPzyXFA3DjfpNeVR8cMjmX7PWyzIT4VMw&oe=69AD66C0"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RDG-L6BY2H4Q7kNvwERxa91&_nc_oc=Adns5zSHWn4wI1tqAxj64dZti5QavBXGzoh2YgxUc7k_KkV9rLaCJUtNUGn6rcjyE40&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxadL-yxJupzRsYcOsIF3mjAXrmkSBBn7KOpYSMJTxr-w&oe=69AD5A6D"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m7DQ5PlLjhMQ7kNvwGrfHOU&_nc_oc=AdkWPUO7DGdw8Q76Ig8PxMvX9g9LH9mBPZvxf_1hQvJr3WYQMUa3Cd9sY1nYTXC98RA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxpseOmFFmzk8KpH0ivhkSqsnhxocMjiw0Y5btyjNSM3A&oe=69AD6CDD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-1qbS9HVCMUQ7kNvwEGm4Kd&_nc_oc=Admvm7MUc106YqDOecHKW2cI09UmNLerrC605pCSpqgxKUJZBXzhZkEvAVd83lS8dTo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw8ESw4G0Q3iwHROyPD_Y5N6MC4SJZ-VaiCoXssnEdXOQ&oe=69AD7507"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32648800938068305"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2079502342881196"}]}, "baseline_offer": {"id": "2079502342881196"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765555320, "status": "PUBLISHED", "id": "207
_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9HBlDCTCXx4Q7kNvwHc2ZJg&_nc_oc=AdpZ45PgfLnPS6WgfO8TYiz1mJ2x8lrbJa_lTWQKYUtUqvHwWiWjg9KWOmU5WN8Aqwc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-C8Q6UtkOA2qaH2gRV17JJ523hx_guFZ4-IiVo_HZu7g&oe=6A4502A3"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HqwajVpXPhQQ7kNvwFKenno&_nc_oc=AdrIGYiv5uSkf3g_uX0s-aJV3ymoQBzbxNV5L7p0kviq9zJ8oQpbplW0VuEg49KJ_i8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-OHDJTjr__dD7VLomAARX7lYHt4e7tWBNC9PGuwmK1UA&oe=6A450340"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=77x4RiXBe3sQ7kNvwG6_eiB&_nc_oc=AdpPsf_Sbc2VuMjqwNvtGEWzVvUiIA6J_JbayMdhc8WLfTIZAxcDCJ84rW9eAYBmcwk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8hvESdcAAKueA6DFs3OHIwBVptQPbg0BGuFKmEGwWt9w&oe=6A452F2D"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0EyoSNL173AQ7kNvwFIBWBT&_nc_oc=AdrSTlL8FNE5iJ-A0OuKQzqHf896hmaUc3g2IRmz-9InpZYIlg7B-PBf9zgUBu0wucA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8YXXUNXhk_JyRG-EzfG_nMtZcGd3bx2XPZEw9k939cKQ&oe=6A45095D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uY9PRi_f6usQ7kNvwEoE4tJ&_nc_oc=AdonyTmc9u2fpEdvO6thJ71qQvhILdYd-SrevmUkk_M7O_KAscHCQWuOewDYC-UQIAA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_NcyAYSbi1Hi4NxJihxHNQWyEVAPIL9lErT0PwCU-B8w&oe=6A451187"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fZP0G4kjz0YQ7kNvwGO4iwi&_nc_oc=AdrGhrqMwPFNXYCs77Z2mcAQUFkWLLU7tAba9wHSvzZsd9GG83igHs0WoxxD9t2JSKU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOom2rE83BEW64g7onpD8ZwkP1aJFNA-k37OtuS737p7g&oe=6AD24B63"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eq_4yCOUwTYQ7kNvwFS1-b1&_nc_oc=Adr8DFFXpwcAd-wodQNGtIAWm3KpSEG_twHjeD_HhrG4FkIioqmg1WuvGGrBbRkXO9A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMg77B3_SR1TccsLbObCi4PVCAR2ZX1En9OKiZqnEAmQQ&oe=6AD24C00"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vao370n9HtUQ7kNvwHuu-o2&_nc_oc=Adoj1KZTEInCxWYVZ2OMcM1YJgpluQPahDU3p6nchyUGnupGfjCNDrD3QlVBre4zVGY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPEEhWdEB9u3jF45wUlFxG8csrlzGcvEoL43YOeyMsLOQ&oe=6AD23FAD"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bRs2qf_L7ngQ7kNvwEamBps&_nc_oc=AdpQU_gnIbt8nLUXzgSCHIKMC52q_ekDcQ98tSuk250feA872coBz1DN5R3NbDqlXzo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOHJdStNgeWVKZHqOH1ZisXIg8uDQ5pG2kxrjEvPRCuHg&oe=6AD2521D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TI1aGKx9DXoQ7kNvwE7WVFq&_nc_oc=AdrLywBy24X87zUIE3EitVKSa08bnel6pQvx8KeeqFH_sZ2w__B4C09Lu_lkNNSCCcU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPovXVRJKi5tnQ1owFy9Ly0bH2CFGNi4caY9-Y7Usj6Fg&oe=6AD25A47"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
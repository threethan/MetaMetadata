_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O9ZwSP2Qzl4Q7kNvwE_8O2D&_nc_oc=Ado4LxmL7UK5zoALkaiSdayNznLkN_uDV5W9nXtQWXPSjBleKttAsbw0ImYzu5WVGwU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWFiKV4G4y3c4FbqaWIYIpdsOMLoYtq2H3ScJb-I1Qsw&oe=6A92CB23"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8a2a5KKza5sQ7kNvwEy-CWh&_nc_oc=Adq_YSfkl2IpoISeAMWa_j0WDRNvSiUmVbjq7laRyiS6g3CCvddvNL7SbmAx8hGfWmA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGBwNMiJ3h5nT1NLDzjELDsoA4ZRhkKtaEbW1TYti1UGA&oe=6A92CBC0"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P8kli-bwXIAQ7kNvwH2asgG&_nc_oc=AdpwiBDU-XVWG20if1_8_Rv1vbcmm-EBmtOC1S4IKwEGn4nEW2iSJYNDgj3CeyeDFeg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFtLokLg1hOpInNTx2o8XhgSVwMVulxpd2W_eiiwebVqA&oe=6A92BF6D"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yvyYd20-jqsQ7kNvwFf_Ic_&_nc_oc=Adpyg2XCgaVgVrO8neKDaOOGRCuolfYt-h3YS-jXGMtBdIun61lDZiZVARDwaiZWQbo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEyokUwNPgKdjjsN9YDf0HWiAlgTmas3wnU5V0F-9DDBg&oe=6A92D1DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=it0lh__QNLUQ7kNvwEq7rWH&_nc_oc=AdrlivBr_5GzhTK6qrl5NiHWPHlmNQTypuee33Ue4NO-dxiVpV3fpoadZWJPb1cMy1o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDbFh2PDwp35-nt0SYdvUX_BEhjXnVPcF6Cvd9LORhJQ&oe=6A92DA07"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
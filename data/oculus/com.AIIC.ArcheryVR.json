_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wWsWlsgONgAQ7kNvwGz3_v7&_nc_oc=AdqoWrZZi4F_662seodCzxLC56Fc4JU07KdMa8z4pCQCeeO9dLmdYnzEuZEkbsaOC9Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOzo9AhJ8sz5frEayfXUhfU73h0JU3Spw0obplgQVgqA&oe=6AF886E3"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mgfFRP3yKlYQ7kNvwFh16Hy&_nc_oc=Adpes-sOgCgB4pe9-B4VLC0iRh68wsaTRH2sUCEz45HZ-hcGI396jWNhkFpnsLo2gws&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQM4CBnzbuBX1v1X0cSq12mlF0K5ONeDueRuulNvipO1Q&oe=6AF88780"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lkfpqeU-YbUQ7kNvwFlW5P1&_nc_oc=Adpss8MceOjkt5XoU_UZXwe6pS2xN5_Rhd7TjJBYtP1Vzqery5fF3Rg_Uh6JDdBEfrE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdg4yTRHyBXkOf2k2YoIy9pNyi0Sn5GvLYqdr4NgO3uw&oe=6AF87B2D"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cL5s_UZ64vEQ7kNvwHoGo5N&_nc_oc=AdqYbt_3jm7yCzuwQgMG2LhGKGHUd31DNRAmicS5zkrqpjC_Kcvef8XANFl2_qktYqw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxg4ugzC71n8zrV04R90y58AgrVFCqlDiznubzz897_w&oe=6AF88D9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fITVxhWE5HgQ7kNvwHi0FiQ&_nc_oc=AdpudjTsg-BqcUriLY7Tdcj_iR4yJ6nMY_Y9LGccqqAhZ8l-TRDhpp4Co_vTxp7d-H4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTIcOxzZ05YkJ7UWFFN4rJDx2KTsW7nJLv3E_QhR_SJnw&oe=6AF895C7"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CL316dFeH5UQ7kNvwGu69UX&_nc_oc=Adryeed2wP42QHfS2q7DSaJktoViOTfWA81pGj6xc-6PeQeRZanSbnZ7N5o_lOLlzjU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBivHJvDFed91rtm7b8slTR4u4_rxt-ZqPaZrwNQ9c82g&oe=6A65F823"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O8YO3xp7Cg8Q7kNvwGz8y1-&_nc_oc=AdpQ9Kvj7PVaQR1LklpxWGKQk9Pq9Jcb9HMM45cl8-oFh2mXXQNGwXWaSc0RhQZdeUM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAplV2-vqb8dN7HAtsN0qFJ8c73OGFdE0PNmZPmq6OjTw&oe=6A65F8C0"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0KLGtgKRur8Q7kNvwGYrk0j&_nc_oc=AdqnKmAAPZmU5xeMF7US-FH_IZ_vQTQfqbtKjxQgESyHNGOMG97Z5BUDKCLuPBOwfeI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCES2ymBIYsazUWgmJ30O5gDH4ET2IsSOb2N1SuD7O0Pg&oe=6A6624AD"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Akz7G8xSc1kQ7kNvwGvls3y&_nc_oc=Adpmc2P6wx2rsZ7nc66Zw8cezzCoXGhsoQkHpFo5c4luHvyG0JD0wSmsVCYag4mk2o8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmG7X7BzS_XwhqlKrEws1saMawnWp9qE_7w7KTfr0h-A&oe=6A65FEDD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=st6W4lmjsAAQ7kNvwHjfvvv&_nc_oc=AdoAFSCtmNR2NpKxKSMrtAgjEh5mao8-WeyFHr_XdqbTUytRG9mQBPsowz7MC0m7Eg8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBN2kGwATcDUekmWkCWpl1IT9OVV3aiNK3AQv9H6D_r_Q&oe=6A660707"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
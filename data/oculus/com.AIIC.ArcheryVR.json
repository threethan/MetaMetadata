_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m5dzn2uwLpsQ7kNvwHrpd3m&_nc_oc=AdroWkdNzhCBW2p08a4H1_LR__5RuOJt6TAY2U_HwCVskAc9GBxbzbxiSEQkj6j-WGo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyJSZ6LgpMdZYJoe5MRUmhdc8QOC34gOHVPMtoLhvkIew&oe=69CE5BA3"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mc5airxB4JEQ7kNvwFBLz2r&_nc_oc=AdpOIsiLZ6gwJNBbjrGTmacgCjPjMc44j3n9qXVzXkiYiXJw3YEP7SKncGcz33vgFqI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyT-lU8_KnSM4XwJZkUNmA9rNYoZ5K4ezaMix7ckqgDbg&oe=69CE5C40"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uo0DX6N6Pe8Q7kNvwGSsCYO&_nc_oc=Adpahi43nupWD24RWqmmxTfKIdKl4PkmToXkIA3qfZu9afwJ9mRgrzO1wBgLgMNj5e0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxzMPyuztwbQguXHkaw9B7hXr_FkJQzJfZ0QW4E1fyMaA&oe=69CE4FED"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3acLi6lkUIgQ7kNvwEpdR69&_nc_oc=AdrkdD15csckc28urAu3WF5xI7ULmquTy8HHwz_O_hTHvXTm-67_-8gOq5W3yBE6JHI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxiG3Dv3KkLaC4zSo33MzKsCwAykryq44WABDq1JVJyKQ&oe=69CE625D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tK3uOW2VuDwQ7kNvwGqXtxf&_nc_oc=Ado955RMb8MhCnNZKB9pIJm9P9F-ioJgQ5SWfpf2MAHhisH9ufjLjOGymZVL8M20Q7I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwp0x2dbloXKj3ycgrBJgQtGZmd9JLs2fCxjAXUI7GqXw&oe=69CE6A87"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
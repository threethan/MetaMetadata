gIuPKEdIkM0aezBA12i24Sx0gTKGBsWraH_9qP1nJaR1jBTcSQ0rIflLdrxa210A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2SQ45Rkuv2RwfBd3kzpLsI9jRpDQXQdcg-7oljqJTlIA&oe=69F0A2A3"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-NNpmC5ecUQ7kNvwFIQTOs&_nc_oc=AdpcVgq1iee5rkNXSkww6CqV9RpYJw9gWMNO7HVC-2RdTCbXIMoNgFiSu4rkwN-z2DA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1W_2wg3Gq7ZDfPQVawsvoDQGxSZuTD9ZSp-U_qOd7q7Q&oe=69F0A340"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h72cKA8hsAMQ7kNvwEosZ5g&_nc_oc=Adrd6v_WoTwzztRXyJDGtx_YQ_aoWFj3hxh1eYtjCa4AlEBctOPj-D2Ko5j_WmHBiY0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1dgtLmxAu48jxfkqf8kS_V8PX0MRsFvNcJdFMoZJjH2A&oe=69F0CF2D"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VKZrLNlijq8Q7kNvwHLhbzb&_nc_oc=AdrlHZ8j7K0wFhHPqLO74RlB9AfqGccBPFoXR1L1MWC03LNUOD4RH91oQk5DvO97eAo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1BQYXq6VXqei3YI-bFITv1OqQFiEgg2VYv70CE3dnXUg&oe=69F0A95D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MiT7Z5D4akIQ7kNvwH38ymy&_nc_oc=AdqV_S2ecpHUuiJJAMsWII_8tRe07s-adveJSf08GsYSuHWrkq6Cede6S2lzP8Zh4vg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2jFawQj5lC3f5P2-fNcCgllY5qvo2EEBDVq6f79Ik5LA&oe=69F0B187"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
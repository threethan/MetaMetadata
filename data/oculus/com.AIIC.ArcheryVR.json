_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=szolNK0Aj3YQ7kNvwEr2sau&_nc_oc=Ado-NFqjyQO2GI2qCwbamUBmCMKeFnRboHPQxde5giupKBmus69-t5dusgnMiZjo_Vc&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGMdX1mzzROzRE26askn9XzMYfpL9Zg3ZfDmBalbUi-jw&oe=6A973023"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YakMjT-F1FkQ7kNvwHVlYRq&_nc_oc=Adp8e0_TSrf1ZmKwf9ZbdpmrpA49Ey8UbyAZImyN7oT6SwhnmSDXryg9yTo4RstehN4&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEK1PJXNiCwROWhcfH40jQ8iQnvxBVxcJRcixiOjlEJDg&oe=6A9730C0"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DndK2xkcsS8Q7kNvwGhlHRZ&_nc_oc=Ado-ts6FHjuDdj46xejzDQHG5MQzY0h8red_qtoVUkK_qHIsSX90hotc04I2MC6jlXA&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGW3du8oq2x06a5e3QYpS81zxbdN5DFT_drbBK7APwTDQ&oe=6A97246D"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rcvNmqxug7oQ7kNvwFjcQhd&_nc_oc=AdpkBj2_MtSTFXFExP5pu3pqJp5nXdbrzdmondiFgSq47jWPxxk9LVy44CAVz3He6cs&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4d0-mwICGUW97qwGFkUzhd2NnEeb3aXxqIyfxgQHquQ&oe=6A9736DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RvGtFvOgJjkQ7kNvwFhUR6Z&_nc_oc=Adrie4iFSKfvsNd2YkVDH7bLy2PrU71n284eZpkxygjhqsxlYhXP0Jr9gx3bdfg7NHg&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmsFl0NErCRd0FnFk9JR6Gs5k9VHoCTQSJdZXV3I8weQ&oe=6A973F07"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
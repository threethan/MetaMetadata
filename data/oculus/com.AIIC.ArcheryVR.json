_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=flpDpKYdnmcQ7kNvwGY53JL&_nc_oc=Adqm4A1s8srKUATlUWcMn_AbR-Hbx2JijWe4xQYOjrLgawSH_-tWZ0X1oU_ZWYvkODk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHqB2ldOqLQUkO4vnwE5Z3MU71y2h8HmcEBOLMGFEg3Bw&oe=6A71D5A3"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lV8vkuAo4egQ7kNvwE-niUw&_nc_oc=AdrNjIfRieD63IUiCZN-vL5UeBdL2llnJHzPUL_cfDyNWIIjVdKKzImXJWRsBhI-hlE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_oeL9hxeD2X_PmtWJS-YLgMIUFisQ9ZKoToQ8VWc0WQ&oe=6A71D640"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z0Za6RuJnjAQ7kNvwEjuBkj&_nc_oc=AdqF8dP8cJ4B4uhGETd5DdCHyazRF45rn6zeK8gnRnPcLwOrBh25ohCXTKXBYXjn1_Q&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHVtC_LYAugaGp1NaiLBsDq7FsKaxMZhlc_FVQ7glpS4A&oe=6A72022D"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BP9xamKyN58Q7kNvwGbfsOV&_nc_oc=Adoyw2zLD-kFU7Bi2rmVsF34tfOy2Ys5zKfSmfyW2vRm2-kGTvvjBV0LWhG-yZMITWQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGFWbzf0ppK2VTUD8ZREfMLQVXyiSu7AE_In-bkl0lvaA&oe=6A71DC5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=33RzR8gyMxgQ7kNvwELn_GW&_nc_oc=Adouw7txOw5aw08egd_tAWLRkLeOAFDHnItIR4cBOqhFYFA3Bv1gjKM9ThJaG0D9gjc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNymMu2rQDUg6QrtaGU4o1qySRco2__IbjlbV3KlFruw&oe=6A71E487"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=znzVU4Xu8D8Q7kNvwEJsYK7&_nc_oc=AdpvDuaTNNouaQUSy6TdxXw3GBpDG3VmwvMEAHsbpkZ1aqQI8sb19SfRJM1KoYcDLdA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6mAIwJ8X_rPiPVRdI2w1R83qp1XbLxL6IPJoddmrDBsg&oe=69FC8023"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vG_sq9sDwkcQ7kNvwGbU0JL&_nc_oc=AdpFdnMmFgVAkrozHrEV8Jg_uXjZHq3xK8EdIdrz3EQDzwYF58G9Y1hRlD_2wZMh_Cc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6N8081UT8rgLfNnzqXendlmEr_0mm9qNc8_qc4Zf-SbA&oe=69FC80C0"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ra5n4N1lApgQ7kNvwEo6-1H&_nc_oc=AdpzBt3Ds47Ge4u6othpuslZ2NBxlllTKVa77Il-6Qd9nLp60aipl14v6GZBZh4HBWM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af66ffO6ekK5c46ElMHdd_dtts39vp-OSc2qOP68_uTTzA&oe=69FCACAD"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FTCIGyuXfXYQ7kNvwEc5lse&_nc_oc=AdoCNY_8Jby2EM2Q_fR1oB9K6TB6sChZVLRKH8Ml19jKhAMkCt5zNGl7_EXU1U7lucA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7eaqhvUFo8Cfsv1ggv-XZeu_XFVoCRdn8IWzlnMmXMZg&oe=69FC86DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vgNJgNiWxBEQ7kNvwHRfJ2-&_nc_oc=AdoFaRu9gN1Ock-u2ms4QYszsjvle7H2uO2tqg6CbCCOKL0LHVIQ74TBHB4aj8GLxaY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5XgJu2vIZllrjJINZyPYy2WDj2C49l7dK3VeDyT66lDw&oe=69FC8F07"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
7_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1-AOipu8QUIQ7kNvwHL6hr5&_nc_oc=AdoUiwn5Y9ZwTUxMEFdofQGNbS0tFaxolJb6VTwyXCUQRWrP5p74UKgZYurUzAyNwzI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9g-cU2hKqTqaAoyhwln_n-XDnp5e7UmRT771n_JuxfNQ&oe=6A395D63"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YgotFX0C5EwQ7kNvwF_jCey&_nc_oc=AdoWuoLkBzKD-91Tn0Z5vihuDwOXmsD6hZ4NJJ6yJrKHWI1jR1faRDKo-8n68XYQVtk&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-x495870RwFhAr6QQNppjH9YkiY6SpEl33T6c7DDQyoQ&oe=6A395E00"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lMFRbEIn5UIQ7kNvwGR83Vs&_nc_oc=Ado14Jv4ZyIW7NflulgQOUChHWLTR3ONzuOUzAceD6wPZqDrBXSa-xRmTOapCKNqQmg&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Z2jr3A2-MMJHiI8eP5t0Lo-cqRCL7-Wrj_MTaaHIvpg&oe=6A3951AD"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R4S-1mxfgEgQ7kNvwHjsnB9&_nc_oc=Adpn3CxbDbAcJJD8D-0TcTv4yZyJaedH8_aVZTUz6viFsR6htaarB9bUqSfiXYgAkUU&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-JWCabygrH5XzeU54SA4kyBV18qu7etd0g2nC0RrBSuw&oe=6A392BDD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=762wHRK7lV8Q7kNvwHCCVoi&_nc_oc=AdqoAlUOGRZmcRSyy8euJObyMjHiohSj3uqQJZbMTCRAkDLyvmDZq7Tdviun4t9xZFQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9R3fH-wSXUT7g1SVH3NluQ6lqSwcSL8eVJQLpeN1d9EA&oe=6A393407"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null
_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LkprPSOeilgQ7kNvwFurLhx&_nc_oc=AdrejTJpn43grUBJ_W2IfaidCNPleeyKo_-iFMZ4MCpOEEAPk_lBu9sz9OtIfTkKT-0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1xJSsS7Bjw9nf4xRGin1OwrmRBbNTF7dD22lhCbaFZyw&oe=69EF5123"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-NNpmC5ecUQ7kNvwHmJ2HL&_nc_oc=Adr0CSzVHmr6Oj4dYOvhsEMr4GzqSjA6rXjcAd_9hwfMKs0dSvMSGqtOFQ70Blpq1ZI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2X0WW9y5S9gYKNbmjqWqoYujo6DCJ7iGc6n0gi7ccQkg&oe=69EF51C0"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h72cKA8hsAMQ7kNvwGZm3fx&_nc_oc=AdrN3OUZ_qOfH0yVEI4Snm6RFWl3JQ17mG3sfFKSgc_QlJXXUAwg8rQJMnG74anxZmQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1i-TAEdExk8EZmUtOqt2XrDxxVjefa3RG8Y2Bexcf-3g&oe=69EF7DAD"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B8ielHuxB3AQ7kNvwEGImCe&_nc_oc=AdpLa260mWOcqJeUSWBY8qD62yw1CfZQQ1ZIQHk2800byfggQqIKO5HZ8P6fmK00o5k&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3KDwdEA3oOqDFe2LEg2gJJk8b1YZBjv4ygfllt9nKyXA&oe=69EF57DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MiT7Z5D4akIQ7kNvwGOM1fs&_nc_oc=Adozne2oKzO9c5UR8nwfprFf5DOBxyYugpoi1Me4wrdbsW19c_cJ1BUdYbEZgPTI-wc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af310ujUMCj8fuXNoTxq0YWT6wsEbeqTcgfExAq4PNz89A&oe=69EF6007"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
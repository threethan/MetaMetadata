_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mqn5auGAL-AQ7kNvwGSlecr&_nc_oc=Adpr970qfRvpzYrpFTKZowFw19IFFWTrf89dfLIvwUNiY8KCXMLY5SRZyDVIEob36ms&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1lZC3amLUheQLQ271CuFstG4M_7THgE88xAjYuMb92iA&oe=69D8E7A3"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RBX_xFAjB5AQ7kNvwERRcoz&_nc_oc=Adp0FI_B54o4KbxSAptuhvy2RMdZe7CSd8nf7m1hmUzIhw9ne-U-5vBwh4Knw4Wozho&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af21FcT-WQS3x1MhzljXA5Id8P5sKDqy36ldISf92ktC0g&oe=69D8E840"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hNQcUd1wFC8Q7kNvwG2EZQ1&_nc_oc=AdrKP1Rr_6JeaoPtnfqaSqcidGuBNFI3XB4WEkAC2-3WPUUPldq1Gy1zofRRS2aycBQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3F1dBA2eu6G_PcZYgWIgJzaa2z1KNT9OLOBXxmyOJHUg&oe=69D8DBED"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TdfzPA2S8tQQ7kNvwHy6JFb&_nc_oc=Adpb7Jtqkd33W3jgE1DLqls45hhmnI30vSNL80fuiE0a5Dzt-6gXGN7_CTYf_vsDzSM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1l2tblFQbKpeFdst76SgLMiAn7J9gxK5f3w26fe7rdhg&oe=69D8EE5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T44XnfwxA-UQ7kNvwHSSWSi&_nc_oc=AdoMwArFI6hcgB1vuCHcuEkKmJY8mKz624ZIO5qkhUogmWpwuK2h-UFoitlmymorwBs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3RPg4MYX2Edas8A-WA_uEa8EC_rrWFy15oNbgU_llHYQ&oe=69D8F687"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
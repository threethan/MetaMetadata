_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aRDZF_zBkRUQ7kNvwFDrHyX&_nc_oc=AdqIy1VEb7t71F9JBv4GtgSaayxlylUl4ZvxgVthew-prc5hERyf8VDhQCYi9IKH92A&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5rd8HH2ygBMkWdpddrEzW9G2gMnJm3JXCfAdxJxZZtxw&oe=6A1C5C63"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lGOy6OVehJkQ7kNvwHbYPXx&_nc_oc=AdqhZwubY0gQS9W9S7wYV7yVVS006mU1iaJzgkwoH7ZWYWyqFKIvqx7KARVu74Xpxs8&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4C0H1KWT63ofBz7aFGlE_NboXoYBjotk7HUikXkjovxw&oe=6A1C5D00"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gg_RIYXrpr0Q7kNvwF5kQ-e&_nc_oc=Adrf85M7oFgZhh9P0YMu04t-P0_ATGOxTBsVofTo84MB1FROqvO_xFBr8PzKlBRrQgw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6dhDKM49Of8e94EalCSWJFoYYqF0vyfanrjwoFjCsyLg&oe=6A1C50AD"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZAwsvDcUrf8Q7kNvwG84F3l&_nc_oc=Adp96usniLMuPStuHpUTj31-GZm6oG0NiO31MP4eUhGpF3jY-KFr04LNXHql31mxo0k&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6nEV6rBEqPaPo3_IFZN-aE_2ET6b3rM3_Eu6d15_Lm1A&oe=6A1C631D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=etNTXsww-EwQ7kNvwHPJlqo&_nc_oc=AdokYHh_o5-0Y6yDmt2XgnsjXGxIx2Ay3_Uc2qXmsKFKn5B5YF_gMMIDvWQL0ACSif4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4SBLcqanEP6lqs9yMLxy7g8tGi77hw1Kl3EjjVGiv8bA&oe=6A1C3307"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
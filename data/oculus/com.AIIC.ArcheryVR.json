_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=02aVBjqssFoQ7kNvwHyo0cK&_nc_oc=AdpKxmTqvW86HzZTAFTgWriMPwK1H91_inabqcnjz4OGuhS4EiNq3jI7IJpKgB2XEFw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5Yxa_1yh7svmU7WiiS1HntQr2oQb4hPst4QaonmgdCQ&oe=6AF340E3"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YgcMmeF8X58Q7kNvwFJmbsC&_nc_oc=AdpI6ADDhyRID4qJyjP_vbLh7bbYyASlC6ASTAQ4uAuakx5JOEd5Dias704zM6EAUVE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5ma7phL6ZlYG8s5DsidFkRp0RDknh4T9ZX5OK0vmCZg&oe=6AF34180"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t7HDwrtGyTYQ7kNvwFP2D5i&_nc_oc=Adpl3QC7wKhRafCJ1bqraU8RlK0koeSwD8gpVQdJARKoe3q7T8TzHGBTiYH4tXu-b5Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrR8xg8JoZUqhaaYVdQ3J66izCs2zZWie3S76iAn2Ojg&oe=6AF3352D"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s5-hMbFxsw8Q7kNvwE0RPy1&_nc_oc=AdrA_HRUBR-oyFvVKsEWDy3UFsis5RlnjBmRtLoTPzMdrX2lFIF83dJv-YZFZhwiOJE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTlIDIkmvVLULTR3hAYemlqIl_TsvFXhNAfLKw7x-k6Dw&oe=6AF3479D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tSNMWj9g0jQQ7kNvwGITLkH&_nc_oc=AdqGgGvHj9GSfZMEYQawG9rC9EjwzyzrrLwkmMCcMNBslqbqsRvLxrBr2vJERYS3y9M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTshf6Nmtoo8O93gQWM0wIps3CPHFFhzA-1JgnyLOObrA&oe=6AF34FC7"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
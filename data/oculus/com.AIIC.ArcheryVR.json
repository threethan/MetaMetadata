_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=znzVU4Xu8D8Q7kNvwH1cEvK&_nc_oc=Adqx52OYcMTeCOoyhLFXrxc-zPjzSNTEa2lXkjPcD4BFgbolSohhbYb32LUP5p_oieg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7c774G3TuXiO35zjFl1tbsyY1TSLOX0dNTL87Jp2I70w&oe=69FB2EA3"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vG_sq9sDwkcQ7kNvwHWVk1A&_nc_oc=AdpUFcy-HIf6e8KG9DtNV5gZbDUFi8xO1uRk89keJrkIE72A3mYfLxnqOd48A1F3tvw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Ksjr5mZoRw1I18Lgz_6EidRiHnooMAxaTNw96YYDbLA&oe=69FB2F40"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ra5n4N1lApgQ7kNvwG-IxM1&_nc_oc=AdphuIBJIrARu_bGQocZlST0ZfifNX__UrFSfJX96GlD9WjWgStI-gf4q5tdcwL4rQ4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6uEBIFCs-PpI8t3NjytAvUfhzBDRFwf-pNcMhPtx5uEQ&oe=69FB5B2D"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A2_YPmLXn_0Q7kNvwHCxPhL&_nc_oc=AdoOKKsz80ZfKImGRioyACBfY9-ELnQFxnLN-119IfCBb17BKGEl-z2U2uWvFktrDyg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ulKov42FF_51PMYUXQz8qNaNN1fRWFdcDo0JNqPYc7A&oe=69FB355D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vgNJgNiWxBEQ7kNvwEFalTr&_nc_oc=AdpTbqefhGKZ_ZHjA_GkfV0zDqmdIlPjw9A6kBDrLd9AnXDx8MeDzdUZ5syMNd03Kuo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af47kXm27_PDIns59j-ED56KSl3q1C2l45Lsk1JUy51oMQ&oe=69FB3D87"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
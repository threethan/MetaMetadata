_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EcE6WOAqYQcQ7kNvwEm8Dg_&_nc_oc=AdpAwUag3tHUWiDWEPTeU0s9PRC2cTmmvlQkUzBCC8fBeGoX3sLHz4ucuKNbI354370&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_ficFOFULuJVRPEKqWTZvsuMXKs0cT1rs533S5EzvXA&oe=6AA29D23"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dUVvAI2Tm_sQ7kNvwFdOhj6&_nc_oc=AdrhNs1Gal85RCbVaVkCSycCsdcIoRdOmDEeGG9xD3rUBbeCdcayoX8BuK22s0a9fZE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLplDhOlS8_GhZhnpFta1_r7f4nqBIV997pe6XVHLnebw&oe=6AA29DC0"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TJlC3AINLAIQ7kNvwHF21n4&_nc_oc=Adoiucyt8NeBKo_3KOgT2dKnLxIk7V6m8OmrN-435UAfVzWAHbXPX2yEyE7wx2IT3_g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJo3oemyqEKydxWz4X6bkDjN_mpyP7lnNPs5XxUakpxwA&oe=6AA2C9AD"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HrCz-RlXEkgQ7kNvwH7ET-W&_nc_oc=Adrw9vq8Jew1Gp-m4DFLDWre5Bpo1G1YTo9P2pQkvDVOctFVughb5iMKIjVd8pZHTm8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMpHQXT0m1iFbAyohlGmVJwDtzsVYY_a89KT5S3EIR5w&oe=6AA2A3DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8WqpsVssl1AQ7kNvwFYMuoj&_nc_oc=AdqbJId3mjmNeoT3T3cMhyM7MTYrtFdrUX0MBjZ7FZ2bUtp51BHt6Zhzign_JpXHRjA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ4D39-Gn0VVI-psDvOGxlY7ZlVTMEf-fs1BWkkIUQFMg&oe=6AA2AC07"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nnY2jFUX5XwQ7kNvwF3EuXN&_nc_oc=AdqMfbuht0NQgUlSzPl6VKr-kImiBxFHRJKKs5maZlLDelYhUXK8wPl2flxtI9ljicc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBfFOy4xOb7OGxOTr48bPDPw6ntU9h-_bHSA1K-SquQyg&oe=6A5777A3"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=21iPW0zXKCgQ7kNvwHVl4hR&_nc_oc=AdooIV_E_KXXDDIN_s3CxVSPDkTmctsDbSVyq2b0RaFq6Q4izPNo9B-5PcQyysLCmik&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDkM3zPjN84tceb47t8H0_xt5jhd7UFKS08RSynr1H6HQ&oe=6A577840"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jvv-Lt61dOUQ7kNvwEF9NoA&_nc_oc=AdpmSRGTkjIya73i_-lJ_wiItoqxZifyBk2qSBdiiaiH4SDkigUfLlOhLiuir9kwyc8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD2LlZZ0WXR5lOMAqyTp4v2__FyCgh2NVxHRnJud0MFnA&oe=6A576BED"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wWDFj2nGO7cQ7kNvwEwijjj&_nc_oc=AdoLeblVdqDQ5nV06mha-F3byg8Rtgb3OKXLBC6ifnzX5QGvrITVyU-Um1yjl2Y6n9s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQmldkh9YcvtFtDEeO_1TzgwSfACWSXOnRWw2NQ1hbiQ&oe=6A577E5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rnr_gOA9ikgQ7kNvwEhnE_l&_nc_oc=AdrbdSKNwvLA5sTEl4B8GSvTDhlIRzZsEtEsSsS6QvVbwPFMiOq-1PGalVE5VulY7nM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAAJgBmkJR5-2GdedtyCh4kr0_lionJ5-VoKHn0mm-OLQ&oe=6A578687"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
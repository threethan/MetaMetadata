_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=spbBExVoajMQ7kNvwGjb4fo&_nc_oc=AdoFBoerSkzUF7JvEW7UeoObgtL2CQFZG8SwUhjzUM5CsbQ6FDAjfwCot9q5ttJloTI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7C_tqZeWZpbe9M2weEjvN3o5rtMQWv5ffCcX2dzYeD4A&oe=6A085DA3"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LsvKJ_1MiS8Q7kNvwHU_dA2&_nc_oc=AdqE2Q14mQyhbHH51Yc3Lo4foLkY_NEhjFHSzmVY3H7uInOCMng4WUhOVwfcLEXos9A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af433wWj55Gl2nCxeMfzb9xJ3NM3S7XHYDM9ipGDv848yg&oe=6A085E40"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_fiJKY8pAMkQ7kNvwGzeTNy&_nc_oc=AdpLouvuSQPKO-Md2vGyg9qbK4_MjzuNlHRxPkgSOnpKgtCNbyxkCKW4ELY6pTdU8X8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af41rksWJ1riFxCeIXNfZXI-GWdXuqFrJr7xc_Br2EMapw&oe=6A088A2D"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1c333Vjow7wQ7kNvwGYYzVP&_nc_oc=AdqFuNX-AkPLcBcoxozxw8nBOpIRPEtsCQ1jiueyKUk62L78K1UDry1EXACtOKoBd_w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4NnSUvlimBZJPZ6nu8PCT9_eTOPTKNhDsL1V3NsvdM3w&oe=6A08645D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nuk9FfvV1wAQ7kNvwH__Nuc&_nc_oc=Adr6QqCgtVmv0iMxDFU4fc_ewmEcCdBz-R535sQ_z1JxKZXobnUQat4QnUjan_F_6C4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Pt9lxiymlC2_i5YZcOOlwga-eEEG8LDcFXFQP5Ukcgw&oe=6A086C87"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
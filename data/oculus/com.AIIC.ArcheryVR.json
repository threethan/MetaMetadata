_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=faqjkYa1x-IQ7kNvwGlU160&_nc_oc=Adoc4eveIHhuuTpbnqrbWsAPerbF6tdiGbbn6PxxbwncgJyOf4Q0lYMMjXWMIZnAzgY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzeOWPBdsN9NDPRxr6b15lC5BYd7gBq7NfQPpBTF_SiBA&oe=69C915A3"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1OQFk2ubAF4Q7kNvwFvIIEC&_nc_oc=Ado13Vb0Sbpmnu-H53Uc4N4hPHPuZ652a42myXNl3uJFKiji52AdanU0V3XMEj3GD3I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzjtQIMsxkar5lng1N76l2dN_0e6vszG0jZiV8u2wIthQ&oe=69C91640"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uCSkw8Uf1WsQ7kNvwEand7a&_nc_oc=Adp2_B76pBxSgSw6Se4QO5u1I_drZ1SmwvVqZj0p9PsCCWzgu57CPj0qHLyMGZNjwgI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz4gWsXUGRNZsWGEng8tbhzNgEgf0_15PKqV89M0-aTHA&oe=69C909ED"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RoY8Hx7xseAQ7kNvwEjpJDS&_nc_oc=AdpbNuOKWYXK-d9ayGGn3AR6okCMmw-3Fm4YWXSF0-FGaf88pFmeb1h78ysQA69qGas&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyVP8lAgp_iejUs_xUlZ79uBciKPQShFSoHC1iVByfx9A&oe=69C91C5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h0vlBtsLFbAQ7kNvwEaq2Sf&_nc_oc=Adq4zJ3U0ucE4m_eKt2qEIpV5rOL_ZGD7jj6Z1e2c-BUbo5vSxJL8gyDIj5rEhQRoZU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx6uiGz-BNwrod7ol_DPyjlgQIhtRUBaSH0BLRgWWZHKQ&oe=69C92487"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n1IUL1PUHVsQ7kNvwGru8rw&_nc_oc=AdoBJyHpKK20z5GAGJtbGlc3Mh9blD6teolbCD2yFqoBTjHoVB26Lr4gA4LVIoGkAHo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxtJxkSKHmP8XME3qsflEnff9e11yGLtS5_lsXmkYnRQ&oe=6AE21D63"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=onIP42USy80Q7kNvwG-ZSz2&_nc_oc=AdrN3oKtcB-IEvQ9tJ35hL4WzV-hSogAQcBKVKnxLq47gf15pY-mbYO0Qdmvl1pdFiQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOfBbFCQ5MHiuRZ34kxSzB30QsRky4-FD7-qmKXA6GVYg&oe=6AE21E00"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NoM3-IjpuUEQ7kNvwEhrvGF&_nc_oc=AdrBJEC506-67pgcNp3qnvQzH2LeAJ1--XnZ_LBDaoQf8xlWVI3f39882Zmz_jN9Kvc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMuBztfVteOecNRP_UzseuSMcpLHg3M8S0zT8jxStUK6g&oe=6AE211AD"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zhPb_vJbTSwQ7kNvwFQ0arh&_nc_oc=AdoiRULKiiMZXR4tKApfWaWMup6dKVKkmDMGF28wETYkM6fVHxlQAmKCjqQleNVPqGI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFqPRCqr724VC5nHbEVhN59gzMR6l0jYW9duOEZmU5Eg&oe=6AE1EBDD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7sYPSYAFZWQQ7kNvwH8jOrc&_nc_oc=Ado4eEsSiHz3u4g9FTGU0h5ahz8aPCB5tBPLhNN8KQqR3F9tg1NptG_TkHniNEEvDh0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO4MinbtbMYNhgGVahqjJt2NxVV6EXS66cpEbNfiqz05w&oe=6AE1F407"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tUaCojxaPNEQ7kNvwHvcg6R&_nc_oc=AdpkQORRpcByb06PQjixpuYWluIxSAtkS5WubHD-RQRPTcry_pYxuF-6H1TzZZhdxLM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEohrLl5pn2UNz5LvBlhbqN5_A4a9WfmWrIV2HdTiY41g&oe=6A75CA23"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KGCYiQv6W90Q7kNvwFczCHi&_nc_oc=AdpY5B9qWThNJGGHbIEPvQqNapTj2HyPPK3J_bFdkgPtJVCA-sRSQqL7BD2pB9l8aZo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWpB7HVfkf6a15ezE99c0zwr8xskCNGWFV5IiTrkHnMg&oe=6A75CAC0"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DU4vHebqgEAQ7kNvwH7BW2n&_nc_oc=AdoSX_suZbIdNMelM6Fb9Wyv_ihRtDop84DO2q1xX7XZUo8rZBLY4YKPDhTMgNpoXuk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZ78A5puzlEoFx8XCoNM2knLE_grw2g1MJQDYIykpQ1g&oe=6A75F6AD"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FpIYypZxQQ0Q7kNvwEYfudU&_nc_oc=Ado757PpAYyohIsfvJbXOuQElMIX1qSFBH6_-cKbO50AiXK8vMB-ESS2aHkq_rfYkjw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQERgNP92mvPw9q2MdMY0PF-7UD1v3dVq96sVmCvQ0k-rA&oe=6A75D0DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T0WE93Bw2XUQ7kNvwEBV4Py&_nc_oc=Adp-LJB7OwFgTGpeiYJv1H9Z5kp9H-_jodaJn4kidr-rFAdiIa77ArM_ChJIvJ_SOw4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYzTPV1T9PTMlN10A0k9jCRFkhTTuq-FTL2O7HxB3dKA&oe=6A75D907"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
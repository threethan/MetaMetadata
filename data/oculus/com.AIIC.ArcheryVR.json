_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tUaCojxaPNEQ7kNvwEIVX93&_nc_oc=AdpE2rWrDTCR7klIyiPi_tXmxIXnDokPS5hDpdJy3ajQDSpN4yjAJ_pgzCJemnvNsZA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGK-I5QKP1WV6o4WnChXAA6wK6svdvg5UgbGD_lHB-CLA&oe=6A771BA3"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KGCYiQv6W90Q7kNvwEElwFP&_nc_oc=Adqdyuxh4KfmRHCuApjC_jeoP7rzd6IMM7s826rFVB_zQkzU90jDnqo_5iGCqT6JW0E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0sRONQ_HCwaiOHBpRr6ahCErRP1GftwRiiTfCmx0Hkg&oe=6A771C40"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DU4vHebqgEAQ7kNvwFpRfUh&_nc_oc=AdqH5h_NXekzY8lTN6ovvEmNbil-j2zQ18iajpM3ZwhOlJEQ6Aqj2tOUZ1pT0zcr9e4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzb1iLCMoUS3ClhXBcXGRyl29bHUxpQmd-K0WYPERlpw&oe=6A770FED"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lgC1GOfOuCIQ7kNvwHV915O&_nc_oc=AdpND8ODxSyN6UDq2Bs4FgDMKEKtY6jIA_BpiYHXhOFHt5LyG076t8sVguQMSLnNFOg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHfDm0klThP4_4ljNr9bmBIKhe1Uf22bvrNMqRxRd42rQ&oe=6A77225D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T0WE93Bw2XUQ7kNvwH5J-3X&_nc_oc=AdrvDAtZe1o6EvdTUr597Z2wi5o6bOmkgcHiVPtQyYwf0xoi5_wzI7EpiiEkBvhO_u0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHoZfl5oGWxJDqbWPFtqq7qF13yNcGwkW4HrRtKlOsH0g&oe=6A772A87"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
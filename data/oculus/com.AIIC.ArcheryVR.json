_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LkprPSOeilgQ7kNvwFHLBkM&_nc_oc=AdrOqszCozaqbg8KEFYZZWH6NEK_visVKLhscvFMOisE7g9CYvrlUEgTEabgFN-7qlk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af277qKMo5urN0JJhOLUAZjHWwVvkn-qzhXCS_F0h8iDEw&oe=69EDFFA3"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eI92KyeOEPcQ7kNvwFATC6-&_nc_oc=AdprSWuL7STI0G_5dqzidQwIElbS7KutJ_kdlp3w1SW3nDqfdokaPKOUGz7RF9jz4Hk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3qKggKeSpcnW5nIVvFOU8YiXYPEqH5XI-wGuHZGUuemQ&oe=69EE0040"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h72cKA8hsAMQ7kNvwG7NMno&_nc_oc=Adr3xV2apc-V48pb6frV0bjU0tsXg10wbtRPc2Dva0pjmuwXFTl9aJk4ULPkKeJ9EzQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1EAUYPampMp1egLxYvYslHMrTHHhXJwOthsZ-NtuQ9rg&oe=69EDF3ED"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B8ielHuxB3AQ7kNvwFkFWl6&_nc_oc=Adq-HQ3oNBNlZZgAiljEJsOy4QHCDW75viA7zPHUVs784pGA0KEzeM1BSz8ZSU4VDJM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0r2Lsc8SP-KzvcjupiXfm6nQbpTrgDS8WySdE8hIaCLQ&oe=69EE065D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ro9E0XJGr7EQ7kNvwFo-25H&_nc_oc=AdoAHOeUYIk7dAu068M5bCrYWIfJpHae9ApcTEWPSASukUOiikkxYo0cC7bjhaX8MBU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0z8f3bMnBibKNLXyL9h80-Bq9lNhFrOYMpd87sRRWy4g&oe=69EE0E87"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
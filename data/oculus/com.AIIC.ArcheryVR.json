_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ljwdP0yL4HkQ7kNvwHlvs49&_nc_oc=AdrSzPtKOJPzNwUfno449MyfVwf__AtdY4crCB0em8ef70iIEIiyVpkEihMnOGJ9nos&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNMXdGzOv1vjqNU9dAXNmdJQynz6uCskohTK5CC-Yt5wA&oe=6ACBB3E3"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lw-pRd7QBtYQ7kNvwGcBzkm&_nc_oc=AdqtoD1GwqpliM2q98BPFOi_V4F_E2S9bpZ7AvrLcQSWLamEqnZA4pgHp9X50-Gk_b4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMfi5K9b4TmAcnxIMmDtNaTX-m26aRkeJleMnUvHIOj9A&oe=6ACBB480"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zx2_0GbWhrsQ7kNvwFpRF4E&_nc_oc=AdoD2TcKDKVxT7ehmHINLRyBuXQWradDNfzYvjUqL8O9vAsIa1WeqilmY9AN42bu6mo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPk0E006qKpQBbVfi07bQ8aTSyJrmWJDCiCtD4awIZNrQ&oe=6ACBA82D"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HETXPOZWJucQ7kNvwFsTuQi&_nc_oc=Adoq0e1ODPugm9aEWWF5fVVeWdGoPt-UvUEBsxTqm_90qcAaLIg8TPxOGysXzzlk25Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPpoqWBihTzw3315iioM5R1tBgX59VU0p1jVPhPlkvuiQ&oe=6ACBBA9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dT0-faIJLiIQ7kNvwGLbmE5&_nc_oc=Adq-oHA3PpGY1vFoW67DioJ0NRvvRdEETilbvFLjI2yk8lYlaReulBwgiKRS_bkp5ss&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_ILzDAaZ9rgGe_STimu-sHmLBpz0YJwVxRzQywgo8cg&oe=6ACBC2C7"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
38172987_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dDRJBpQzkrYQ7kNvwHx8sEZ&_nc_oc=Adr8vCUuGYnxP_QVorx_FUc46aJJlV3NLaEFBK3I-ngk_9dSslX6auTShyDiPjrFOzk&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHrTzghQ9YX6TfX6ZCm9lXLRAZRBwW89F7teOP7eTmlnw&oe=6A8ED6A3"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NyQt9Xtu45MQ7kNvwFvPi9g&_nc_oc=AdpK3xcwXS7a3c3SpZ6J0EqruMLW6RLxCjdXRxzvq8s3BXMyt09y8kFYlC1Cwq-2Sko&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFHS5h6z2o6ePXfMe3-Yikgq45Pbld3VnSR0TzIn52YBQ&oe=6A8ED740"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EinPdqQSGMcQ7kNvwHCKtb1&_nc_oc=AdpCM4Knw9F8XoI6HcckyA889ywjkoiEKP7BYqMF8TT-9Z6xi_AyYVNxKWTdTvVLEhA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_BdjZPX8LAQ22tYexL53EqJQTf_oGbX2Z9KZcuXNeHA&oe=6A8ECAED"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RRP98aSmGqoQ7kNvwHbP87W&_nc_oc=AdqCC6DJAp9QhhSa1fY827kXR_wAp-sdVsVD5X7DdwJOU3PspifIr-1Zy6glNHqD5Fc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEg5gsGZbi_7ZtOvHxqhvVh_dxEoWfeyI8YYrv30yUwXg&oe=6A8EDD5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U-L25NitIbYQ7kNvwFTxzDy&_nc_oc=Adqx9GJih6QfWyEceCOSvnYAD_sIALNPI2kt1iHf1sOYlbQfE68_C3HQqtq9MTlTfag&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGeNB9aTdIRkHYxx3KF28gf4EqUpUPqxHFTMkBCypJ4pg&oe=6A8EE587"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_
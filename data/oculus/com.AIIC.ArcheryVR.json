_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g8LZZUOqNA4Q7kNvwF1_2sq&_nc_oc=AdqKWRnQloQRf4WFybwkemfhPrLLDPC8iWSPwp_Tx9np5LP2BcHh7q78IOjdPjsi1r8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-pI28fKrNtm463pE3Z-d9DHD2JoebQs5z3II1FFqto_A&oe=6A2ED163"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rWccfxQEUYQQ7kNvwGPaJF8&_nc_oc=AdrTFTElUHfUb1avM48Xq9F5FuMKBAQKj1dZn7OWZlJqW4u3-_5-Qup5inRhbjFF5-0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-HmpvQUOkIhpUeKCerNfAYHwUrSOddy-KJ_6hOwVALhw&oe=6A2ED200"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a7UAz0UkXksQ7kNvwEtG4qV&_nc_oc=Adoob5ipMo9V5SPpMvHHHv1t1aSrdGrOOCfjkm1YSvGSSqhoek2phclEsYyVcjgbmz4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-iOUv3fC9j0XC92Wtlf_KOgdIJbDdM6hB8BtZcFvckJQ&oe=6A2EC5AD"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G_DtwSotdnwQ7kNvwGRaxkb&_nc_oc=AdqqDRx9O5Kx45kVWAWB9BdjkLCIjHdmyukXEpCUndMItmuInPhd-xkRHsELQukt93s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vnwuBlApuG9ofQCU4pNWo3OfjUvokB9WMBfKvvftREQ&oe=6A2E9FDD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qp-4vK7tce8Q7kNvwGNuazr&_nc_oc=AdrzbcGr4BQ0qrKdoJ0jlwMtaW5YqcwnpVe0OxV2oieHGJ4snXHj_0hOY9d977Yerls&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6Dcel7aA8B_7WvXh4-LUk1UJYlNPgHj_6tzUCTYuNgg&oe=6A2EA807"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YAvJ2-xptd4Q7kNvwGedhMp&_nc_oc=AdpyiHeYe-V0Nu-8dTheYn69fk-VkB1qdwauk0ToX7Tl6uYv1VJO3Od28bAYZx3lfjo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIpaRCzivs0F8wAWfc5qGo-YdqSda5T-IZS-sAnHEnXA&oe=6AB69BE3"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3h7mD_R5KIQ7kNvwGS6Sdd&_nc_oc=Adp8U_rvLImJ3KpMieQ3tEj27SewfhICkBoZ5aREZ9_Ih8K5C2o86WmlgZdCW7jQpFk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRZgwrdl2M3Iu0eY378KNh2cQci6MM9IVYJUoM7CpTNA&oe=6AB69C80"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZWY_LdGWY3gQ7kNvwHDOE2G&_nc_oc=Adr2wyB68X5D99NPBJqDE97nhbkFrAvEgeZ4DB0YLQXsKUFJJeK4sV4JWMIaw3rW2pE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6_r1Tqfojrt8qvPkdtwa1gogAQBYrjUKf6-8RPR1m3w&oe=6AB6902D"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AO4xOwvtSwMQ7kNvwGGRkQu&_nc_oc=Adour10rkvyCpU6Knb9RSnYdkzwG9PoCzysI5fBPcF_zEW5juoCNm_UDrmIDJdpZcVg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvMPSf9yK_lIMll3Q80jU_yu6OSfYfbt6CZs0qRRqbrw&oe=6AB66A5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-a3xiDcqbnIQ7kNvwFOO1ha&_nc_oc=AdqMJkkWqTN7nQPRwBoNhi34CGI6IbnllznjJFA7GAVF-F482Zv-9khU0ny_8gCKGKE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLt2w3tDfe_RSQlT1ASlFQb8KZStXoXz29-nEMYSg9OyA&oe=6AB67287"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
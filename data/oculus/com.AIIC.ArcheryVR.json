_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZsL_WYKElegQ7kNvwG1qHxW&_nc_oc=AdqQp6DpaaEAITyNuMrSjRfOSR-qSFdE8HKOncaz1cDoh-K1G7XZfM6-mDtFNyhWjdo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwFHt9jNjjtsYngACsRvib2amWQoVQJfdgroZ-HlT8vLA&oe=69CBB8A3"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mc5airxB4JEQ7kNvwGQsw9a&_nc_oc=AdpqCo5U3u-jaW7HvipYJSuz_9BwnWnFoB61i6bUB7Oej_UYXEigWz-Rasy24bUOa3s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxcqGdb6S1cLwE6s-u5qykp9gey5Wat5ctvbdDKhebU3w&oe=69CBB940"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vH3Q9SIKZzoQ7kNvwFH1tIo&_nc_oc=Adq54YXSZ4iKMR1Boe74OUmk-IsUcCzj_0YgA8LChP3W1qdxmr_ISvSzvt6z0uPpGOw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyrV9gryERoNRWoE-XEFeOe74nxGrU4QH-DOkF-MU9edQ&oe=69CBACED"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RoY8Hx7xseAQ7kNvwF9ZHhL&_nc_oc=AdoBADf8Uj04yRVhVC5wp2neKwv5LZdmvZO3LGtnwVfojt7n8mF77EbZ553Rg6PPE40&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy637WOYZjv8oJ0Dh9KvSMYEiUBIco9Huy_X_kzKug63Q&oe=69CBBF5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tK3uOW2VuDwQ7kNvwGqItpg&_nc_oc=AdpU-wU6LRbChPYw0NTUsb2r_eQ9xAnHf_MerHAeMYLFM8fkmecmGPdpxDU1d2tSDcA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfximU22dcHDgMNiVQzOsffRlK4SrhlJWpi39q-qF5ryOQ&oe=69CBC787"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8KiJfXQjZlwQ7kNvwEEtLNA&_nc_oc=AdoYFvD_PT-SNo4WKHgFJNK-hNpQNxWTN0ASsh-osWy7L48x922PP5kKq9tlZ38ksos&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWA8Az8fLgy97R8sgrXHx0ajmlJT0mjCRAC_WqNgtWkA&oe=6AE8B4E3"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pz1R6uk5bwgQ7kNvwGKrQrr&_nc_oc=AdqBfMy9WDkKvRh5M6hS-yW5upjNAKR3HYpfbIkMc2sfEBTozOOlcBJqpa_-WZv-u2g&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPVClzQKQFH7xV5BLxrQOv3rmUYCtR-WZtCvt6R29dVw&oe=6AE8B580"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=59AUqT9SMKAQ7kNvwF9LHDr&_nc_oc=AdoznddjpnynpXm3-A5PTwIX2QhzvHNgnP75Nycuzgwz4UEIqMU5X9qqLqs_ZoYxiys&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJwXgn3h5mejJJsulPgiXgn5Jvl8xvLkYjNNhnoTC0uw&oe=6AE8A92D"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dAb4NLHQCmsQ7kNvwECoLCS&_nc_oc=AdoT6lwVL5IwDmRZh1MF6uBDp8p7z0tWtypwEP8KTzJSgoUsDJ1bzmWjEbvSZCsLUyI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEs28BKw5EegAJRJ82bM7sZIDeEWLyUkCcNbDevHCmwA&oe=6AE8BB9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rxtEfkJYPgsQ7kNvwEhnDV8&_nc_oc=Adr94QUTU1TgfrgtfNGWTyZQBnnhuLNWH6JKN6ibF6Nr6-j6eOcW1k1T0luapQqstnU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjWueKBivJrIkmtRQf-RbicB1sYTZfONnKEJ87Iqn8PQ&oe=6AE88B87"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
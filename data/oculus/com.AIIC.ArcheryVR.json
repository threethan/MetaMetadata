_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EUTYWPX9HC8Q7kNvwE7PqXD&_nc_oc=AdqvSB6ozpMLt6rvpPqGmDQzFvfd0jeOc5l6W4wYoogsO38EhM1aoET44LXtEP_6Alc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIq_bKmkhzQAa6f9Oe040nJou_-liSjT2JJrcj-SvzVyg&oe=6AA691A3"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mDKPjU27-zAQ7kNvwEzr3V7&_nc_oc=AdrGTtEFEoR8nq7ZtmmUVDSPhUO_VpZT9wBf0oxzQIRk1CbgDAbh1-c16rMwGgKS9ck&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6yC_Ak1iyZhFiLhUOV1vCJXy3aQai3QXBkY0SR0ytSg&oe=6AA69240"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QsTg-tLrgc4Q7kNvwFUBNqv&_nc_oc=AdrK0Q34E73_1IYAD14-ji6AunY4SiPZNHOVbFBcPFHeBcHqAm_onDpBJB5RUujRTTw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLUGE9hccG87RkcQGiDilc6D1TKkSWgI-ob9G9h2jGBtg&oe=6AA6BE2D"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q5Q8aVU7fYgQ7kNvwFLixlv&_nc_oc=AdoRRVxRo1tXkOz2UcVy0My79hZQ5wxOZJfhZtqzSDuLLpfmPryW4NPF9H3x1sZMR-8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIcFZ-oZddi5kyZpwjllAG6TNkBijqensjQ2cQMGz8mew&oe=6AA6985D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H7eTpCHZCkIQ7kNvwEjMT3V&_nc_oc=AdqumhARKp_CO238yIIxzALU4NDsXuKQfl2a8jOvTyWeUuXGCoJY2T8zVTbXKOFxWRk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIE1wHMpJpi61l4V4YR-8vXRoYomzISKmbrpIiazc43JA&oe=6AA6A087"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
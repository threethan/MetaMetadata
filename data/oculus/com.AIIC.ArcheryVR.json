_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rs_zObnTl2QQ7kNvwGx9bT1&_nc_oc=Adr26Lx8-QoB_5MoVrlLGSxBzr3voC_XmEQAtACyVAJrQ-h9YfX_5U8K_YpOkRvsHs8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQl7Cv4E9bapsfctr-FT4W78gpEDZNLxxzruEbLSlGbw&oe=6ADCD763"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uqnvse9YavkQ7kNvwGNsAIR&_nc_oc=AdpjzOSurCl0efPtMc_kmG9AtqRVIks8TF6ip8etJops913U6Tuo5bDEMHzFxC8OrdY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNc6TVC78moM4YQqN4G6M-CKXVxhX5tLvP4FHDiEXdx3w&oe=6ADCD800"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gtFYKsDZGyMQ7kNvwGbef1i&_nc_oc=AdqXTd9kyX6-syxkL5SYP8EEq8uLjka090FGghXF0bInYToYpUqfCSuo9BHNEz6YT4k&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMrWl8Bba5e7ubRQgflvD8xekLrFIRonlRRQn4bnPzr9Q&oe=6ADCCBAD"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kf5Ggik1SLkQ7kNvwEWkOkK&_nc_oc=Adp4fYUHSsqR1-GcBkFovRjikE2eyY16Yz60L6qSAJfj_Rugn6su5VoL8rym2gisslA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPs8OkPit4k2dJthOBwm4D-ExaOTgRzsj-5RZHO9yD6Hw&oe=6ADCA5DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wUAQRAcn144Q7kNvwHjQtoK&_nc_oc=Ado0tRbm-RObq4sbJqNQthMpZF1-Pi1rmQ9x_L9BkCCi0RGA3Yd1rkxek7cj0ikAGfY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOeXSXerY7sJFt8DNc0V9BrIFMQa2ln27OoTXqGgzNWEg&oe=6ADCAE07"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
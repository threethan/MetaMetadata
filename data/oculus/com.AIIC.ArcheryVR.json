_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nnY2jFUX5XwQ7kNvwFHdNYY&_nc_oc=Adq60fuWPEY-BlJM3RkvHWNkZSVpMOvsVuYNbSRSXtMMkxMofJ3ca5S7AEr7MoEf6XA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDtGb0bWUTXvBO6sWuxIWw4As8XuYZpyQzG1W9hSGE7Mw&oe=6A54D4A3"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d1W9-6n871IQ7kNvwGEoVa_&_nc_oc=Adrn0k9QVjXd54nPuFxIqz-Xk4A5FdEaMAO4dNcVSiAo1hgsjs8dPIs7nSfkxPn6Iu8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0Wq0meZWJMqFnc0MlqnySpd96hiNP5h1EMgAI333G-A&oe=6A54D540"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jvv-Lt61dOUQ7kNvwEZ7wcn&_nc_oc=Adqp1KubymhGyEEp99-YG062IpEWxrc4JCRCqI1g0C1PHYNOgimmAFrEmUvxDawb_DU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBOpWEEvPQVUEDkm--Xxx-uC3w7AhdzuTxWi_FWSKWS7Q&oe=6A55012D"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mQADLnHOJ6IQ7kNvwExGYmH&_nc_oc=AdrZwoC4U6KvuGFkWgXz8aYaLo_sV51XPQX9Q77cX1s7RfvaUfmryCaTzasCpgMpP8I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCoN-IEN1rGxDCKtL0HsilhcsC_o8wmwD5VA009ddHshg&oe=6A54DB5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2sqeUXGbvf4Q7kNvwHviOzF&_nc_oc=AdpUQf4sSWqt-acFPR1OLCr_RbMswQBk7SC1BhER5OfNt0KQUKgT5k7fZRZgRO-DGzQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwmf9whkkPMQfPGscAmSC3OexZCp4B3OLDcGNt_NpNDA&oe=6A54E387"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
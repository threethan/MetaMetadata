_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KBA0jyhFQZ0Q7kNvwHzCNCA&_nc_oc=AdpWJOVmOlPgn0-75L36yIxJqXsO_JKLtuZLoI1-gIMTUr5VbStuGsL6KQuMdwpwRPs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3CNR8A8RQ8Mt0NeklIUJ7QJE8ibT2M5JrP9hjXLSW2-w&oe=69E616A3"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9HXLFrVtpgYQ7kNvwHtBxcv&_nc_oc=Adqtpfup_RB6OvSCBvrOpjQYARIC6FuYq5Ywp-9im9bZ1c2J2BCXm_q-yvDPCvLxtKc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2GjZLU2uLYQpQZxY3v1LtBVEaAoy3rMY-MB55Ar5Sc3A&oe=69E61740"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fRy-CCEOv-wQ7kNvwHeiQwD&_nc_oc=AdrvlZaVMQjdwAv57jcxafyNQ6ywtga0mubLoT4whDlF5TJcNxtroEOJdP8OlBEqBkE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af33vqz_GsWW3265Lhyfn2yOhKyvPTGCgLQHDBSrXmBaVg&oe=69E6432D"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n_krhQTsEZMQ7kNvwExMSQa&_nc_oc=AdpNP9drUL2GyOy7lNSjmiJ7TFdzBS-zxfjCM8l8gxeCqQFvRfJJuLyt65BWoV59naI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af057fxgoj50_sdR6PBYUV5nguo_vfBf7F8OkV8ZndHviQ&oe=69E61D5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-EvwsJwg0pIQ7kNvwE6MSao&_nc_oc=AdrIwwwogI0Bh0hZ9MAlqRgjvYxDskVuxu-lqtz-o_g2UMMGzftAiyOdOZvLm7_FR4U&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Z6P-riDSGzF-UOIc6qGWNHAGlz6SMBNaW5VlFh2hStg&oe=69E62587"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
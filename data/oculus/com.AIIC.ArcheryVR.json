_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O9ZwSP2Qzl4Q7kNvwG27RnN&_nc_oc=AdpNfIHT6XQjIMjKuNLE5bwJ5Nn_CN_5PhhvWxVgw0jNii4X04kyI6BJLfJnI7Cm-do&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQETtLwfRgLAqLloxopPxwll1SQs0gzVOILuRXH5KfjuUQ&oe=6A941CA3"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8a2a5KKza5sQ7kNvwGQn-ov&_nc_oc=AdpW_HxdCk1AAnOeUSWx9mFP_LvzgfcgVl4rZ9AzhGx0799FUkyARH2c4LNoIGV0TnQ&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8dXJ2cR4YIPGipnoHI_BfmCUQk05hEyCvuVwiRYPPdA&oe=6A941D40"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DndK2xkcsS8Q7kNvwES9FLn&_nc_oc=AdpH7C6Dqzbk5A9nb5d3rVekW_-1X2PCYN5tduqYq0LD5jL2qNH31cfANfrQ44HzCiI&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHfNfTqZ1aA68wtU8zHM-cBcTuSF7tiBulLCaVJ37kxNw&oe=6A9410ED"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yvyYd20-jqsQ7kNvwFNCEo7&_nc_oc=Adr-kXiTEyPbQm3QqQ7To00C6Xj-ZRtGUqQluPxVFph16OgoID01S6GshDkdA5I08_0&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUJV9mnPKKCnnYanCC2XlvdxCfUsAf8sRwHlHKwobqVw&oe=6A94235D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=it0lh__QNLUQ7kNvwHnGRAO&_nc_oc=AdoWqXRDbRGK1_AfR2N7A5yIEoSmeLUto6wKzONO5dDv6Tw10HjJBMrBLUaw2PRWtps&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFM4YE0AaoR6HD17wgElfeSNBkhPRMC7DSEloyWVV0z9w&oe=6A942B87"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
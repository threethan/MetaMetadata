_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EzvbkgYsPRUQ7kNvwFtZzPC&_nc_oc=AdrwdVsd_rTQ1Ir3OMugWMKR3EWzSzJjfZcHeXwoywXWZv76psnlgosa7FKEbs7wums&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTEJyJnqr8-1SIfC3uEzvWJMtokLWeqKp4Pw7OxTDXtBQ&oe=6AEF4C63"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8B3-dL4E3VwQ7kNvwGk-QdU&_nc_oc=AdrRcRep2T2Ri2u_bbCDFQV1Q00gv4XPCaSAw37Cpgx_Aq8Tyg7pIC-t2HyhKkEkJcg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGe0E4oYy7Nk00P5B9A5pwYLqWmSweVKnh84D8RMXP0Q&oe=6AEF4D00"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KlL1pYvWsZYQ7kNvwG3WNm9&_nc_oc=AdqEz3E4fiDzIjtkOilLnvu4kY2mctzmpf20L5jUTayMTHd-y7Pa_osbmTMOxQ0mGpc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQovN5lFK5Zcom2PVJUxJTnsYkg7vdgfSr1wkmnM0ND2Q&oe=6AEF40AD"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xQka9_8Z8JIQ7kNvwHVOpqZ&_nc_oc=Adq0pJafswpflIBywMPoqUdPQMSYwcGy7-XtVrVb84_s4r9CJ-loDgRMxVMYMnOY8kY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKt94ca9iiMexw48Toq2rfc_78yi7_5t_Mh_hkX3y6zQ&oe=6AEF531D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RbHXM9yqwcoQ7kNvwGJ1V-E&_nc_oc=Adp0B8xdfbvb4pMqD15wdDttBg9eR6tpOgzEpAZks70F34EHx2zHlijsRAv0eyIZeTM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_r9cMG-R-BiuJSEGbQFmQxWMAAtBWTHoOxyiSVjvJFQ&oe=6AEF5B47"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
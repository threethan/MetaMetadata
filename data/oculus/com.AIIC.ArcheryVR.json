_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iGw2D4oeEY0Q7kNvwFkc82t&_nc_oc=AdpZp8ANw0tJHa3mxTto90mjrtjzaWJfR-fox8hrGVCjj9xL8TjgWI4zEAwh_07gvoc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCvfp9XnPBVSYV1BSPIZ_-Xr-ZGiw4cebB-3k3GQciHYQ&oe=6A5A1AA3"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XfmdsCAz4Y8Q7kNvwFbHKLl&_nc_oc=AdqSB5RtBIpYq4-Zea5Ca_xfLhRKzYnDa-khYMaHRp5aYpzc05avWKVrjRYCnuWIrYU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCf_SsPhu8ffJiL3JVH0YFY8UlCsDiQ7smrYpUvICRljA&oe=6A5A1B40"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w6EL7SeGhlIQ7kNvwHygdTX&_nc_oc=Adp2Uzt9_G6Krmf6G5WBcy6pqvfmR8VYjQSZuE1842t1M2Phri1y_ZuBZZbD0i_EGkY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALJS_Q4qD3eSAGvmvrjliZ-SgIp-0kF3lb-Sq1TxfXQg&oe=6A5A472D"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wWDFj2nGO7cQ7kNvwFPVBAv&_nc_oc=Adq_9GXt5SK_FaOZFPGxKh1URyRS8cuy-Sd-hGuehTaehJvwBk_MHeEECT3UwPpd8GM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJ1NjA_5E8UfHRLbbXYVVoNt-EBAAqusR15DJv97KZhg&oe=6A5A215D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N3cxaxBulbwQ7kNvwEbgivA&_nc_oc=AdoWuKPew6Ld4eFHhi8eUgSXF5kjmLy82N58YBuqaz2GsymWA4O5yA2zqzKYhs_OlEI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAYlD_3p76xN4Z_1zrl7fam2pqUBefgA0aJt6vdS5WW1A&oe=6A5A2987"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
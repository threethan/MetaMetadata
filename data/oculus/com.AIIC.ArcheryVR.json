_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HEt_6ziTNX0Q7kNvwGMXNee&_nc_oc=AdqHNNVw1vvDqNAgAPYjxwREjicsat25m7ly4w9XeXLrCH0H_A_RmhGyGvM8O1u3QKQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2oKojQ4wATeBY0o8PwEPtz0XiKWdIPy-xNjxEMxIbA-w&oe=69DE2DA3"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QtQTEfH1PR8Q7kNvwGU_skp&_nc_oc=AdqAdUORJS9C8d3LE6BoC_NBac0N9P2BP-zD31Lk6lHJP48LvigHNmW3frqVkQmgeLE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2TnDWfCa0Yc9XrH7fcy3HkZ0idRGx3EOo9ZpCrMvLycg&oe=69DE2E40"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EeOjTEbsZAEQ7kNvwHfBhdv&_nc_oc=AdpND9BAdf8WVpM2_51ZTYDl_rHopkUXxgWCC_q-aJrk6aG_ZPngeH08Ce1rr4d8L2U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2FMyKIdBEuKwcWSiPSa92FhthK49IRJEPKItpo58Nikw&oe=69DE21ED"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=18f4QKke5qYQ7kNvwH9bkMK&_nc_oc=AdoIDvEWI2AWbEEtxJBmrrAabhbp-xJ1wqh9qA8HzYPQQlr77TBUmqXek_RoYr1reJM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af12_Q6g4Z70HzHnHQ_F4k12wJOLXS_lmEpY3KIsOJKHgg&oe=69DE345D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FQfezNwrJkMQ7kNvwEZ4DUV&_nc_oc=Ado5qUUoOfy42JRQpt-IUD3cpepzMHxsIcYEKidoxQGwhtU8FgJF1xY8qPIOzsbue7w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0vMaZ7RwWlb0lzx-37fOWyrnCdqHir_6ewpf12k0TT3g&oe=69DE3C87"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ah7p2fDUpPIQ7kNvwEIR4iT&_nc_oc=AdrbEoOZmrQsy6l-aUwH3KyB60nYrOzKavZnZ1-PFBcccTIzHoXRBr2sj7kKyFCglyM&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4-3K5FDCYjXDUC33kG6115XVDonLr2jRy9ImqF4-_hzQ&oe=6A09AF23"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LsvKJ_1MiS8Q7kNvwEYE183&_nc_oc=AdpSX1se7Myg5eYVtM4fhnc1WZXpjbHk5qaekbrZ_06gIXQUJlLtSiFBs7IC8-FmNnE&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5BXGuQkMh681lkLrfWxoTr5BtdlJK5ekIvjG0QYySiKw&oe=6A09AFC0"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zAB8KRB_r-kQ7kNvwGjWLwU&_nc_oc=AdpH977aHtUa2JGwFNn0MLf6bQ23AS1FaGkzyKX0-GL4hhjqfO61lqd9KmdqEG4IQVc&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6zKhbzU-0GXABZjojAVWKlHYwyHdTKVrVtgJ7cr_UAKA&oe=6A09DBAD"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1c333Vjow7wQ7kNvwH637Mr&_nc_oc=AdqWd6ZVeBteL8BXuCfvDip0xDYliDtxR51GJapFflGCTiv_TMWNDoqHQrZ2es6Fpzg&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5YzME0OrdpgUt8h0TIL5UiBL72Fj6lXEoMV5aa5PJTGA&oe=6A09B5DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nuk9FfvV1wAQ7kNvwGIhBDD&_nc_oc=Adpy4yQz2VmV6J8uWxNVkR6FAye0asr65PEoQ9GfK70oM1aHeFBG3hYRMKleKdxflS8&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7UPCN-ZsvYpjwK2-Ttx1iLpRACHnApqo400SMhWqYKgw&oe=6A09BE07"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
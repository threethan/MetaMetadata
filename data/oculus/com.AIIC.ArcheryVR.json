_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YAvJ2-xptd4Q7kNvwG1xZ4y&_nc_oc=AdpckGDT7cpw4PAjlPipfzL0uusqYDiWdG4xsoK3nvoQ4SUeiINiMKfO5DAVVk3DPu8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLRrBFrFc1Cet2XKgAL3GIihqFCiUVGixKj8ItMjOehCQ&oe=6AB3C0A3"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CFrtcbM9w0kQ7kNvwEKhFt0&_nc_oc=AdpH3nNJ0OyRrvleFxGDKSidXoKYP2-hQFlxUvWeje9q4KzRPP_UM6S9MOfT_WgTJu8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4WepW30hkoLC-U-PrNqj0JAbMKnUs31vKiN7iInJnAg&oe=6AB3C140"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZWY_LdGWY3gQ7kNvwFX-SNm&_nc_oc=AdrEeh2svgRJDJxlLk0be-DAb7kLJP5E5MjutRtka_5-G1BgjB5X8wV-lZdyyGEhhgs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJsOsZMjp-cN00wXMB1VA-cDBQSQlTi-crBGDnH10AYTw&oe=6AB3ED2D"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P1nqGFvooJ0Q7kNvwEdSeA-&_nc_oc=AdrjCAX-KW6hys95TwJI0znqNiZdZEnifIH-3GMbrEP7SvxbweipBL4Vyjo1X320N3k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLLLLZQK7s73iwP7YuXODlX7it7d3lDjbNKPUl2Bw-FPg&oe=6AB3C75D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K6XyaEgszjcQ7kNvwFKfaqQ&_nc_oc=Adq3mgp24Lfs8X49t5Doq5IGlUQDlKkwAFVFEbw_cEn_fypVaAddG8SOEbVAigY7rJY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLA7Fie6pBts5kQl8oTVba-_IDcC-eFji_vo6XFswUerA&oe=6AB3CF87"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
7_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WCfG_q6GzCwQ7kNvwG4VtEf&_nc_oc=AdpjEEvidrJErNkkGMnR63xaTs2N5vErfwXEgGTR-zDWzBrjsK-2jFp_zBIbVINoNGY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJwKIHoQabeXjFrBZF1-YsH6-AOav-anRKWP4ZhZnBSDQ&oe=6AAEB2E3"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qT-7ayNS_HwQ7kNvwFiV2fl&_nc_oc=Adpn2zWzEL3C7xqZZe4wBlER42pu7JO6KnfdXmU1WZvckDfQAWLUOGWQNMgXKqzHJh8&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLRB38hBFWYR2Y6GDuZ4Mv7XFCRoar6NkDZrhaX_cY4mw&oe=6AAEB380"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zOG3lBGiRNgQ7kNvwF9nR8o&_nc_oc=AdqMKEiaSEChRQJI4_vDAa6UO2wkZHjGaOcrvan6-A8Rrs_cmiNXuRwbtKecqs8BKKg&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIhqOnu8HKYaENNwBXIJh45Y7GdN9AEVQDnb2UxbpBdAA&oe=6AAEA72D"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1BRVSDfz0GQQ7kNvwEoWJ4C&_nc_oc=Adr_-z1aPpT4qgN9UE-BgSn4LLOmtZL4ow-Tm2hlldyvYBb6xaZt_cWs9StIUzxGTaE&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLv9rBNq9D9PzVUwrGyNkOC639naY5flIuNHk6apOF1Ew&oe=6AAE815D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=30ZxjWjepTAQ7kNvwHw5WS2&_nc_oc=AdpXaOsh3gnUT0gnPg9Oqk3Y9D6bq1nEvV7DfOxlwONI1aOx3O7nsQYXP6ESU3G-Fhs&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKY9Itt-dPKpy9EQjB8vsK4YCBdx9HaCq_4gKd9qbPaFQ&oe=6AAE8987"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null
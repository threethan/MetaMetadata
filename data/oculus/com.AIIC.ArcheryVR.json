_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m5dzn2uwLpsQ7kNvwH0L3sf&_nc_oc=Adrh0dia6A0rAaUpYMMY37o-T7g1dFxgQtsHMuQD9MP0sMztXeqKiAkpF5nk3dGFAOk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwD61F5C4qaZPGtyFb4qENBdImHsTYh4RcICX_3nfUFww&oe=69D0FEA3"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=deBVfNj9_CMQ7kNvwE6oTz8&_nc_oc=AdpFwL-mATnjujqsFY5VbQ1qeS6YGRaUuQyet4KuFo3Vji_wNdZR9YlE0JLDe4XzlcM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxpkzxeETQSyBTwUfkCyjMJgt6R6zmlbb0pTiroaUAKcA&oe=69D0FF40"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uo0DX6N6Pe8Q7kNvwFG3X5y&_nc_oc=Adp7E4w9zPE5Nf-OYPC0TUJrlQ-ZEcenqh7gFFZp2o8SAKZ7dkschIZncfoFLvBcWPY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfySwY13676HXBvG3qGLmlLI06GL8gLBjEs5Q4LUjHxm_A&oe=69D0F2ED"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=guKkMO1R_v4Q7kNvwFkucXz&_nc_oc=AdoM73wZRB1209I8j4eHoC_bpBdPhcTznvOj0n1Kyb2B9YS6bBrcFn81eVjQmVmGmY0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzJ5tpoTvgeWDbFPLsr0tEru0qHw5eUhvUECc29sqVZkg&oe=69D1055D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vux52z7kVMYQ7kNvwHieZfG&_nc_oc=Ado9G2LCn_laBp4kmd-6jkk60snl1ISsIQ7JcyoShCEvAedIx1O_IARhQPXzK_GL3lQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwaouqcT-xYHjb1m6A3SCQAa5dmR7v-ZpBwgMG5FIwHSw&oe=69D10D87"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
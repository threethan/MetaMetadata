_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9TvDC0e9YDQQ7kNvwFDr7E9&_nc_oc=Adp9AhFFoCpgLg9zUwP57I9lFuXXHKF3zS3X8t352bWyt4qWS-bFi2qfLEprTveIaSU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_QNnwz3yMv52Z_EbS35zxvSEYdO5AQY0EAGDwdwcBt6g&oe=6A317463"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rWccfxQEUYQQ7kNvwEH-EkI&_nc_oc=AdqZ8CcoQPeMEs82xCekuqn2uteNqZ4KW1N9x5hhiT53tmxRiYYuZp4GI9Yu7l95ZCM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9EqwhK3NBhD14Y0AOSKrVasxm7ygEyFsi-9atqdk6DjA&oe=6A317500"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7a6TC1tn_s8Q7kNvwGBA89t&_nc_oc=AdolWJffXxJrGSdPnT6ZrRaYw7q_0iayC5FH4p1Jlg9lX0J29DA7c36q_5_nTcSPzaM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_uQTS3kNZO8iL95KEFHsAs8Pv4hzbNB1zB_uGv2f2uxQ&oe=6A3168AD"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uKxCPBLgvhcQ7kNvwEp4wID&_nc_oc=Adpz24puVBGxrdVE-QUsZEr-9gOQ86c4U8phZmhw1kvaHRUGX2bemTzNBT4gLErKrds&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-OzNlReiDyD-NItPjlyEGd6dYR0ry8zMi0Iw1eOKo92g&oe=6A3142DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qp-4vK7tce8Q7kNvwHCIQTg&_nc_oc=AdpUACEMOhlgfhlgns8XWStOL0vbCBWZkdZyTGs_VLjDjIZA2gjQMFT_6oalrGHQH0g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Mr3LZ5UqnSCECvxD0qWkY6lAZoSERLNbkjz7sRtS4-Q&oe=6A314B07"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
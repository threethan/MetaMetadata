_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4wjiBT16s20Q7kNvwFAIsAh&_nc_oc=AdoaV3fPTSbm121J3StjN9BeCC4HzT9lNDFLUSXrG94dbSsPBvlIqX2DDfbf9CD0Aas&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5SFeSHYakE-Dxe5f5Dy-jlY_v5FhKGFjpOlAsC7t0x5g&oe=6A0074A3"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ompA1FV_5wQ7kNvwEch7W_&_nc_oc=AdrmaYb7avQA9cMjmS6-RiORABf5qW2CDfCuo2zr6yzMLf9kPaOcX43GxdU1MmuW8uQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5O90KrQ8zns3neCI7xJPLWHoDzu-OOrPK_eB3xq5YgZw&oe=6A007540"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vEjVCy4UCQwQ7kNvwGVz9yV&_nc_oc=AdrCi9PitjtZztCeJv8Z9tMcHXVRgv0zmDn7-9ukARdhCWNCVjusw3f20jI5NPqBj9I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4VYEUqJbszElAXNyiaSNm12NDhXBocWPmvntdEBFDJKw&oe=6A00A12D"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JTFJNCeOddEQ7kNvwHHBUES&_nc_oc=Adrp3RxMvoTevbaNDOSjoseuPaJ2KRtizhAo4lWXUJ32_sIijby_jCQaO2EvHwc5mMM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5eLMNIPKXpYW7tO0c2-DQUqg_wgK0oSe1JHtJxTQG_gw&oe=6A007B5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U6RBzpSR_UkQ7kNvwFCMgZe&_nc_oc=AdrVQekVlrFAUjNosmNBZ4LvqqZBmJNxcnxvD-7VKauFpAXIZeOx559JVffJiEO3HuM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6cvTPYe-kLLIi34cyJ7Z0aywQI8I5wGA0qqHM0TYtoXA&oe=6A008387"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
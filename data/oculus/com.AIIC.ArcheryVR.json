_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6DBUAlbiHZwQ7kNvwH4D6Oe&_nc_oc=Ado58OEU-B0SC8DIonnyRQ355ZvUzB5XWrU72odH_tCY2ORg8hRNGsBgn_hxWHdpWiM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAEeFg2zwnKFNrRrDUGjF5_m-FXSbItuFgC5UJqh9frUQ&oe=6A60B223"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F82IN8LaNAkQ7kNvwFFu5aN&_nc_oc=AdrUsHhZpbcPvoq4syVfCJ-plgX0iCFxEbdZo1aJt9HNoS4fQxS983KRSGXnUAjdcrE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCRhPvZ9PSIPjyuoOuLsz2NJVvSpAi34M0owUcV2f9Vaw&oe=6A60B2C0"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lm6dBW2KJ2UQ7kNvwGnglE_&_nc_oc=AdoM3Z-LKexj3uAjNJ1h3iyspAhnzzVRnsAiy1FZy6JAHn6jOupP2gO5b1cLxhjTrE8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmswDLiaU_iQZcjp-yhbkPtmATiikKOoGmQovWns5lzw&oe=6A60A66D"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y62LsaCeph4Q7kNvwGJ2aaR&_nc_oc=AdppBffGFmksdcD2_xcTVO9ulX2hZMcQL0byDcpq9QRU3jd_a2oYt6RqdXv0VkEASBM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCFtj2Bzn3yzuy1Y4V6s68FMvj7rvihqK-loajkisyxUQ&oe=6A60B8DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5mcaF-B-LCMQ7kNvwH1_q0G&_nc_oc=AdqbEYZoODxGb1l1rG3Y3MNN1KSiFTxGyViO2znNiI3UNB5WF49YQM8LoIEjgEPzDoE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCG7xeRAxGCKbbcbDyTwf1x56nGEtJLLHneZpIR3EqOgw&oe=6A60C107"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
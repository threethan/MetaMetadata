_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=clfAIlYQj1sQ7kNvwE6MIwL&_nc_oc=Adr_LuM7SoIYk3zIjYD759ipffr7c8bdcvhxtQHBuhy3l1y3aoPNpSZ5jrTStBrkE1k&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAeJFT6c3-ipX3YOGk1vITNV94lWx5HTGNVrzz0_Mao9g&oe=6A6F32A3"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zSSDsR84aqYQ7kNvwFd449h&_nc_oc=AdrU8Vze4mZRMLoIXgY7tWTHT7XJ-oJBT1q9SO8AXF6QBbDcVNiXnoQa9xMP2hnnnj0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFrKlH-n4pYWUXYYiGo1KXQ7NDINBQYRR1lyhY-2t_Xg&oe=6A6F3340"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-prK1-U8k2EQ7kNvwFZd8dD&_nc_oc=AdrdwCQzekWVGd2vKbvSRYRiL5c4YVOgAFrwAVisoaBw1DAlwxU0O2PG4bqKWxEKPH4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDKEhruMtz6pgfT_1T1pe5WZJmGu3yrzlzO-ijRtANC0Q&oe=6A6F26ED"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BP9xamKyN58Q7kNvwHS3gb-&_nc_oc=AdpAYtXNsj1oWkmsS9Ghj40yWAT-kavPC0e1NuSqFRAyAP1zCza3NDYkySdcnIZbiAE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDpmhc4rEc9tJXta7_EPNUvvC_g05B5PPd8193Io4fiug&oe=6A6F395D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ekEjKiUiTE4Q7kNvwH_f-jO&_nc_oc=Adol_PLDGNj2OY-FbdECJVKgvqXH47gZ9aHBCtgn8Z0yqUeMM8MVyR503_k7_qgEtsw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCiKXU7aB8qtnI-6HBGFvtl9EweARmgVV7ve7D7j7Buhw&oe=6A6F4187"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EUTYWPX9HC8Q7kNvwHkYgVl&_nc_oc=AdqcctcyjyYXRE0cAW09bZXIz7gxPgxvBWp5xw9fpkkYShBAz4yqbtxLEHubH-g8vhg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQICjseyg_yaCZ4ifcG7i3_tp7eExxBTvq_-Ede7FWHGnA&oe=6AA57863"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mDKPjU27-zAQ7kNvwHEtE6K&_nc_oc=Adrwj69WD-Wbqkr-9tV3Ck_PyrUVKaQyBUeWpIhTDWfRC5DZ_KtZayplRDP48ZWYA24&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXlqIfXvsaBTaJBazsOSmMu-A-oWQ-UcVSThfFYRinJA&oe=6AA540C0"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QsTg-tLrgc4Q7kNvwHs5V46&_nc_oc=AdqGodXEgXZho9Ip_zQRDJgU9IVVOyo2duuphgzlNS9Bpw5huRPDUtqkZ4SqQpbrA2A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPChzWT3s0DGNx18W4brFybdRN6dLs_99hFsixv4ZyJw&oe=6AA56CAD"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HrCz-RlXEkgQ7kNvwEJQmbW&_nc_oc=AdqSs6WNMjQn85A8akRbP-ic9oxQTe36n-JjPEQCaN0IG2ZiP9wVeEDT6Jgu2k-3-6U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWCYVvBvmBsUXrr2awt2OlYtUsnZ1KTxHwtB_1sNSIgA&oe=6AA546DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H7eTpCHZCkIQ7kNvwGmVrV-&_nc_oc=AdpgMr76QD-46k08lBOcd3Xi5cmPW2OVoilLZOa_PLk5mogc-rHm54aQwEZJ-0wWruI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCtE04m-mVkwqXdduKnh2TARrjIwtjdggohLXtsLY1vw&oe=6AA54F07"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
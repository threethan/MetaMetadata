_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7La3v9zxZxIQ7kNvwH1bxN2&_nc_oc=AdrNY0b-_ZpQCFOeDmJfk59SCUAg3criBXUhg_ELAOgGp6g80mGjsskoHP2wSFwutvc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITu1epN7TTT9wQWWv3BL0JCdIwZygTsYbPyhQN8If6ZQ&oe=6A9EE0E3"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uwvlcjtJ_eMQ7kNvwF1FGDF&_nc_oc=Adrf5rPSvk5gY8IHZkmZ0CO8ikUfMSiKvTLtGtIdXq8w899LM99AflxmqVflY01Upcs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIO7YqPPkxKznfAXqpA07_QdtZjuA8Jw_SRvpvCg22bfw&oe=6A9EE180"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BP2YWXExDFQQ7kNvwFWZtME&_nc_oc=Adoa_c18UGp9PgkqaKA2gziHwNqYmVvWIUXpPkALyB3LPBjlPAiRo5XcdRZG4y0QSM0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLIm2fa_cpe332yu2V-Hb8XiCc53yU2Bq7HukMfRRPiFA&oe=6A9ED52D"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2793gHQZORYQ7kNvwF1cSjA&_nc_oc=AdrVvaj5VBrSuB5mhohYA-2gDmFr6tMncTCI0kAsE1sIFlg7pLZR6c8_lHW3KcF4fBM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJyaX86HSukPZH_fB9HH4GeH2tn3IMBVQYpJnzoUqtVWw&oe=6A9EAF5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vfEi6gwn2wgQ7kNvwFQV4xp&_nc_oc=AdrKbnKbhIDlOacYE7ECGfbONUS6LaqZVNsDilwEpEJLqK27OfMXMGR1I05AkAtR_Ec&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIbwSlgcRCOv93_5qE_c6wvfAA4CD3unNyV3OZgjGjpBg&oe=6A9EB787"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4wjiBT16s20Q7kNvwFyw6NT&_nc_oc=AdqyJLMpDismIkvuN4qAyx-vDFc9LulU5HOzavJpXBC_5PJEW2j6bOtgOm8mi7ZnV7k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6PuLWvYfoDM3U6o6tzInuwuUedHb1ToNZt7-aaRoclgQ&oe=69FF2323"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ompA1FV_5wQ7kNvwG1i6Pu&_nc_oc=AdpyZxscYlKsYwH0FbXVNvwDmuzdzgyaPxY40bfSKiVnAJtV0scnXmPex7BGZdsqADs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4IvhX_wij0yEvS5Pfd7M7f0C9vauISIeW7ttLhfNF4XA&oe=69FF23C0"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vEjVCy4UCQwQ7kNvwHbFnvh&_nc_oc=Adrlm77xS-3IYG1baT7Qd1AVg6Faj5f_wv-BnZ5RwZcoi7jjEUNkm8HL2J6CVWtp4no&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_MXDaxNWox79Qg3stsdxO5BgbfWjz9OlJNgBXAXp-fQ&oe=69FF4FAD"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FTCIGyuXfXYQ7kNvwGUAB_j&_nc_oc=Adom4GQTtOucvfrt6aP-XtM28nYRHIcS40rCGYJCUfJg9f_nd12IsDcnZ5-9uEtp_4U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5MT0VKYOhR4LnUbzfJRXMdKuFu7K5eSq3I3z--x1EN-w&oe=69FF29DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U6RBzpSR_UkQ7kNvwHplOP7&_nc_oc=Ado1z8LA1McZKxCZugM2ruwR1ISaImfYbwH9NR2tvmAdpOVUoQAP1Cz9TZDg2OWHySs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5U9dw27V_SGXBjOBplY27fgRjxwZLtNMn5z68LBCFFiQ&oe=69FF3207"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r7hgxH5L0IwQ7kNvwFCKKHj&_nc_oc=Adrh0tY_AwW8IMb0LhssMHxh8CLdAy6lSZGU7S7UQOUJGG89hv6zzSWORYlTONARuDo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4sspIfk6zY7YhtHghBUDgT9I63yctb9b1RhZBNx0wodQ&oe=6A147363"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_bgS07OmjBwQ7kNvwGsge5_&_nc_oc=Adq9_qmsrv_9F4-ksBH8Qe58s_iV5Bew78qszEdoc2kUyAarCTcm6OFcYLgZqocr8CM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7L5e87Qr0uPwMrAj5g6B0DyIumlejDR-CulAHAAPlDGw&oe=6A147400"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7R8L74764DQQ7kNvwHZUK_S&_nc_oc=AdrfhuzIF4q-ty6hPnSsvPQfMLJovNJjWRNZizlV9jXuVq8vvNZrSRZUuXgPuAp-Sgg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af63L3btm3nofS7jv-xcOe925q9e569ZDz9Ee__q2khR_g&oe=6A1467AD"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g2Obn66U03sQ7kNvwEI97aS&_nc_oc=Adq2nFglqhJx-e5YzDcImqhcsx-egSBYcVLeuEpY1MRHHDCleTU4CfghmFdkGv2G_EM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4wSf_-NQCXMMkmdmYp6L8Fj65Sj5GpTnvyR1RzKGX0tA&oe=6A147A1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nWMPGGG5xegQ7kNvwEH-yC8&_nc_oc=AdqerwQCttV2zSo5_j1lzuPhK_hmjF22mcVUtozhC-Yu5JZjdR2IfSsQ2qtUwBgujkI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6lgS2xE3yYkn_s55l1DhoSDownL1iPJommx35VRSbChA&oe=6A144A07"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
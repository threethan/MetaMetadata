nt-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afs8qIIbQWAD5usCR9Vt9X6O57a828hYY7sWgi3j6Ip-bQ&oe=69A97240"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KB5duENZ9S8Q7kNvwHKtB1K&_nc_oc=Adm0Ws5hcoMgZ3bjpO4YTbA1MopdlzA4wQVkuC31bqYctrDuAokHtCGaTgjGGTAvyjM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvwC7FZdTLbYHUhOedsVt94lZUIU4WKfjFhL6OIRgEqqQ&oe=69A965ED"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GXiHqFzCbggQ7kNvwGcO8kf&_nc_oc=Adlq4keTXUnTpWl8WlMT7Bnn0P4C5RhyY3u6yG0bWyhZpvqvJFdyfX7GDnC7yYyqkqA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfsV1muEDS3i47x0QdC7UogGGo9kEIFGJkoRFrQFGsLyjA&oe=69A9785D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zlVi4SRsTSsQ7kNvwFC-Vzm&_nc_oc=AdnulG8ZxvJMZay0gsHjq05d7reGA_EGJnw2tfGzF6Qw46EWzHC9HKHvMD8zRCf3BKA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afv4L4oe8ptQQXi6nlQ63RkGL18ENdbQg0RHXIbqc5kcbQ&oe=69A98087"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32648800938068305"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2079502342881196"}]}, "baseline_offer": {"id": "2079502342881196"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765555320, "status": "PUBLISHED", "id": "207
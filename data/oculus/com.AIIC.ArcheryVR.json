_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PNy58YN_LSkQ7kNvwHUSk17&_nc_oc=Adp3hZkum3q1lbL8cGkrp3cRqiinStwlA_seowkKAkLdttuegTcr177bbVO8YMr3rkQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHjilia4V0r3zU3aalLNddZmG_OuymCkH9WmtrM0saKKw&oe=6A8C33A3"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U92JG_tJIhsQ7kNvwHUT4-D&_nc_oc=AdoMlnTDjtgWHWIT-Qxtjw0fgt6awsok3_spWhQKebiOZj_ALNZz4fJFgzznVq_4qpY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSvDkx-ZzzHUa4iUryWEVmjM16tryc8oMfYeGgL9i3OA&oe=6A8C3440"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EinPdqQSGMcQ7kNvwHXgGC6&_nc_oc=AdokaxMc6Rxc1JJ2yyQbqd8XooPn67fXgmA7DsDJtRiQY2g51eeB1s4reTvExwrQyas&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFudrLb58PCAgbzmPkIIrXXo4NKNlLW5v6yrpbQqDj9DA&oe=6A8C27ED"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6cSS1zcLe5oQ7kNvwF1JRDs&_nc_oc=Adpue1CxUV7JfpxBgmOdMZTzHC8pFEduNI2eraaqyvYQazg5-a-TNeV-0ARPZQHs774&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGOVvXDe8PlfAVgq0kTdiqMNdZrCqB6q9c9W1BkUEtYrw&oe=6A8C3A5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wLPIF92QW6oQ7kNvwGRUc2M&_nc_oc=AdqKiuj3S3A6wtdeYbxMz2Qwre_pIBa5YFCPzyzSrBdBt_uChYnDslTElXOjR9Q3D0s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0aXf93OfRPUhiR_N75iSps87KkXYydTVuc4b72QpmcQ&oe=6A8C4287"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
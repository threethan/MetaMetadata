_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iNoi2dhQDSkQ7kNvwFz9WJn&_nc_oc=AdpR2gzvyu17-rD8p-PKluAK7I6gvrP2976PLTkb7Q4NXwbdii-6Fu7EHdr9377pRgo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErLq8EDVunAAb0_EyuA2c1ctRioWFPVKEHbx4o2YmCyQ&oe=6A7B1023"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zGm1EMs8rvsQ7kNvwELfvlI&_nc_oc=AdoKr495Mf66_YDH1hleBozsS6gZ8jnhwfGwma-rFDGUvPDzzcfAFwbGrGuIgG6rZIE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEG0pTGS6o2Qq_hDPaNEAfGpZvMeOsy-Pr5qYWAwajmhQ&oe=6A7B10C0"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=taZm8vl9RocQ7kNvwFZH_Ae&_nc_oc=AdoKCXq_Tj3wKAXPVRXYiqysaUOSjL3ZeGqCOK8tb2PPghfCB24nSVTSLgK4ZaUPfz0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8CZgDoRkUlnPPSCf3AbukeaPQzP8jfi6-oePel1g8eg&oe=6A7B3CAD"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tzAAi3gCZq0Q7kNvwG7__5A&_nc_oc=AdrHx0OhnrnXp-WW1K_Oo_Ys7f8OBTnnR6lw1zmKe5dKeOQFqRBOOmxSBKT6QmMh1u4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0bc94JNZHNYoGd7fL9oVJkyV0q7g0khqSy9MK3yw9aw&oe=6A7B16DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cbp22V6Kq_IQ7kNvwFFsMoC&_nc_oc=Adq-NnQoXyoHuCxS2l0ps9H3tl9PqPb3vf7CoMnhXtb4D7OHLoV2XNJr8FHE1WYXWh0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_mnkXScZuTX4wwY_Mq7Br8pQU2qyVcG2vadwiPm2u1A&oe=6A7B1F07"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
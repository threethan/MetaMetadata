_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vBUr6ENt86sQ7kNvwGlKxGN&_nc_oc=Adr1EmEphYtgmXAjXO2SqNIFU3zAO-PDTKwHZqS7mRtiAcaFt2C9iZqIKP4bR3d3Cow&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7wqAteA-HYDAyfWnr8dM9qrTp-UN3fntluQa0Me3O9w&oe=6AC27963"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mqM1Lybd_ssQ7kNvwFkqWEM&_nc_oc=Ado_gjrK-WTT8cfacUAuRKwzNzCjMBTgX3bPXdXNn1Cct-t8Dk5KprNzEGFIi8eoHyQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOyiIh8ohvOIN4_0pSc3SclWNmc-ff8Er5HQ1MlG9zQiA&oe=6AC27A00"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yvyhzLnqT9oQ7kNvwH59j6w&_nc_oc=AdpKMwP0pfKouBlq18zsKfKRs5yQXkb3IPN-RJd5TGZZ0laB9DdpNW3tlZKJwtirFgM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP7xn9CKU8-rf76IH0TC0beW72GWWdJUkNagmWK6xGJaw&oe=6AC26DAD"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pmfrqNy40mQQ7kNvwGC5n9Z&_nc_oc=Ado1_XDeO7jVJ_alyCrCm7J2DXU1PdUz-Q_bqn7bwh2FZQvOMrMz_OeVhVodmnVbL1Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO6RG8L9gbPH8GtffbavCg5k5QeC9XjY7U0TOxxdORJUg&oe=6AC2801D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eXzEFS27sjAQ7kNvwHjxwwa&_nc_oc=AdpYquwOVWg8-UUKP1SEjoyEa-pFZITKAUcJ8pwFOvejwsNTBbWlQLC1iIStoqNMKfY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPQVE911yuGeTySfndyWepaVuT_cOOs4Yq_6pdVQVZqOA&oe=6AC25007"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VPM9whnmIm0Q7kNvwF8u4t8&_nc_oc=Ado6Q_m44DpKduqGCjdK7Jfa2hytMUPw8BrzcZ_NP40I810YyZ5nYdWDnH1Kzi-vhlY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQATg_qE5Shwmtpcbv62MqcV6lFOH6jFHkkuufJGbLlXAg&oe=6A689B23"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O8YO3xp7Cg8Q7kNvwGOMBse&_nc_oc=AdrHiRAkg2QVZUfFdTIPzy1DGJZpF05piJiLibBtFkk58bWolmTPx_yQ_A4qjRc9qEs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDfMDzde72YkcNMwFTcT0w2Pwsl--Rzp0tcdBLDhzU8nQ&oe=6A689BC0"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UgFBu7O25jQQ7kNvwHU9zI5&_nc_oc=Adq0zTOTTjvTFeQMSUpI-YFdIAhx46mhG0laORXWXrPIzHYudetlAugG4k8G4F77nqU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3Bfmt_MsgK7fC96lKJAq_1FayUsuzqhy7HNtgfyvRVg&oe=6A688F6D"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bog17gaxzeAQ7kNvwGS-uqY&_nc_oc=Ado_XzDbuakj0-XywjuaDSNL2Q4nOAHCo6w-kzJl7pz5F0IkTMU5Evne4lD7g_XCxqM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDFQVkLLppX5sw0nxwq4TnKBQ6rPKa30zPubaZbUsdR2Q&oe=6A68A1DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=st6W4lmjsAAQ7kNvwFiAzvB&_nc_oc=AdoChT-5rA5clvOcMPZlKiFZJKNAltTaiaA-oP-wHNaW80h-oTkoSy4B6zVy5iobJtA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-T_BwfQ1tO-3fHdqB8a1zR2c6R8rgsKgxEjj_Pg_mrw&oe=6A68AA07"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
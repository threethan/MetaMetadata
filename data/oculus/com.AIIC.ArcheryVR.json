_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gfJOgKx4zdIQ7kNvwGZga90&_nc_oc=AdrizpQi5PSwXGYEbB_XUm10NQZPhKPOIYHycciDfH-yLZOusEtkWY3v2GorQSGAPGY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97bRaUvnW2Ir5-ReQb76Q8OD_URgPneZrgJYCtKNkMEg&oe=6A3EA363"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EeT8Qtn6v8cQ7kNvwESNQsJ&_nc_oc=AdoW1PDBcDITnb88txHfc6vtkYgrAYnhEbR4O-RnPkAcZKiCdGBIL9aMhwNFsdw1834&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8SXwde9ao3HVHmOss4jRiSSI9-58VyaSCoV0Vg022vzQ&oe=6A3EA400"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FdXOOw_IT-0Q7kNvwEGAjWS&_nc_oc=Ado5NbDTopV621FEadNj63mKaer4wqfUq4ffDv51YDhx3k9n2dos4r8-ylstT9S2uBo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_U7U2fgWQRHUifhxBu59x6NVDzN94CdRgKm331MWsELA&oe=6A3E97AD"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DbHJGubp6L0Q7kNvwGZRwpW&_nc_oc=AdpS5CiYLU43y9MzQW7QE4nwqXNpud6m6qi0kEnF5G7vtblTuGQ3oKau-2lDcyGLRyw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_yfCKmVk-UBgk8a75T7HsBTAX8KLEsTZ22FiFmyEfExA&oe=6A3EAA1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6CBbuCh7bZIQ7kNvwENYVrx&_nc_oc=Adq_zHHsm5VMtrzAXijdAk2k1cjPisvmU2Mv0W6eC0fcZQ5U314MSQFqRnUuSsf22IY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-jF9EgC5tGx47tKlZH3BY9nd1nT6qVlMQsySg4BqMXhQ&oe=6A3E7A07"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
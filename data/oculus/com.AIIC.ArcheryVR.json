7_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wlICvVSd6SoQ7kNvwHrBE8g&_nc_oc=AdpCWevUAWHS86NCfWxokm14_sJyfZjzw-lQO2SOwl2A1HRDF5W_2mpnyyW4JmxkFcQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-PeqLdWw2MT0Q9gjfQjQyMIpq8izVS21r6TUWRkfE5rA&oe=6A36BA63"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YgotFX0C5EwQ7kNvwHoWeZn&_nc_oc=AdoBYXCoGsROAhe_8N1Q8e2-7eFR072puSCwGXI7HYq4Tz6z-T65Mwt6vTA28JXfgCA&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_WxBPZ5QBkicW8TONEvQgKelX8gFRBKwMbvW1Lc7YohA&oe=6A36BB00"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I9RVebYQXj4Q7kNvwErLVpM&_nc_oc=Adqpqn2E5vI39SFPyJLMKh6Y8vVM2RAy97TqqiNHkNHMSSnHA86JUC3gL6m7GvIp4Cw&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9l2p_o5C8d7uEQygvivtVy3Wozvcn-saWhgwEdSmRG-Q&oe=6A36AEAD"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JWM98I3SrQkQ7kNvwGeapWb&_nc_oc=Adp7Vifih2PVLjUuAk8YwG-c0inxr49Zg-BlIxvd3EFdpZEGuaIQ1dlm9FQvWIA59WA&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-XfGnusZDQCnEDjMwcq22T3RgyxPND1zu8_SjZ4rgpdg&oe=6A36C11D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=762wHRK7lV8Q7kNvwFIjFFI&_nc_oc=AdpE5cWwbE6yAFedJb5_G4OT-T2BWunHbgbUVlgNEuzjFbuXYTES0K3WAvC1eI6j5l8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__mj4w4RGOBmuWX01k9b_KsyxAqdbmzBivWgC2_HlKqQ&oe=6A369107"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null
_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=08uEeihNf_kQ7kNvwEI-JNJ&_nc_oc=Adq-G3U37diItW3019EL2EWvcQTCuRvP5auxFJN18m_h9g8FOmQxxF88T3l24TUn-ME&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbewtAeCdnjwH6CkwxcaDD-oQUEzgUP5Xu_oEN7XiYpw&oe=6A5F60A3"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F82IN8LaNAkQ7kNvwFYkeRB&_nc_oc=Adq6FUJX_zYBLORVIgHdZUlVZ5Ymu_GQVai7QCKKzTefKOsJQKdX8p2h0ngZYAE19Ak&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCNTSvSlV5-WieYuaJKKQkbX3a381Bj5lODQ_s4qn3sVQ&oe=6A5F6140"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OawZrSC0vMUQ7kNvwGWkaDZ&_nc_oc=AdoxOXgJrlPwdi8AvrJlJcxGwvFTYU2T25U2qG3pn-MUM3KnsH2ovooxfghbn0kKlcE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAf35dxZ8wdRht3WpR3o_zuPME_uVxAyyaI9YN-IjoDOg&oe=6A5F54ED"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y62LsaCeph4Q7kNvwEXkeW7&_nc_oc=AdpFu3BoUS50QBX66LMX-D4LApb-z8jX0g2mMm4HMsogl4LaGnKlWjuCC2eluttGjQw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTFU9xXBpClnKdjN_H_-k33GNL4Ztx2dXq-aPJlhLGRA&oe=6A5F675D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5mcaF-B-LCMQ7kNvwF_qNvj&_nc_oc=AdoRUbPjXc0t9QRWzCd6d2Z5JC6Iu2Q-PxB5J34zTlYwhN8wp6-lioiWl1Q9yN3QEAk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZM0rvDgvdLL8fikuknOx9Ytu3ADLd6iCu07PaHx5HIg&oe=6A5F6F87"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
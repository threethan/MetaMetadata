_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o5aOMfOGg6cQ7kNvwEAIWMV&_nc_oc=AdpO6iikNs9uZTT0fDc1rMUBqkfPsOKYpTRFXzqPNY4mEzxumDu7Cq7LDLjIIwmcPaE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0cxXpPcgFvwYjAipWGolB6JYQs3-s5JDCrmPl04DGCQ&oe=6A2839E3"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BqIQBBJKDx4Q7kNvwEVTyWw&_nc_oc=AdohVinBlctFPXlkfpOCmAvgXXTTCu6wSZsfCCVUeTEyMMnlWFRUcrlsohCCHzp_Xto&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af875FF0kEMnPP3RCsJjcTmh5hHb1g5rglewHO9QiC_syA&oe=6A283A80"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qj1NpbFQqY4Q7kNvwFl5ZEt&_nc_oc=Adp5aZSDDy05c1hh6fzY6zicPZF7yywMJz8CphEA2Q55D8xBXZzMO8JccATBr9wP0_c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9hNy9wakGM5812bPX3UeT1X59DHi-f5ibGopUCGlQxJA&oe=6A282E2D"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O-kQ8y-7hGUQ7kNvwGZ4xQI&_nc_oc=AdqOW4t5wfS8jZYQM4X97482bmGV4cU_kexgJQBMVi0gwbAiiXOerXzHh6rq1vrFKsk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-9uB0kDtl0qH-2x3Cvke10ct6JRFLGFLe-_JZ1nN-R5w&oe=6A28085D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tW8vT7qvzOIQ7kNvwEvQaDT&_nc_oc=AdrIyQr0dW2Jyj9u-wnlhgOPsPniTyFq9bG8g19xDw06kaIMvTqpx2gg2ScMKXlJrwc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7VLgdfBXuvwwORqDaBV5laclTG2WlIOuiKwokYEYfNw&oe=6A281087"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
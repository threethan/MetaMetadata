_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ah7p2fDUpPIQ7kNvwGBBkWq&_nc_oc=Adq1ER3xA-yDZvgT4Exv5D0zNCQ-y1UUnQXeVLp7pGe6ihL05pNo6gjefJWDc5aEQrU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7qDmzgayRBN5b0KAiwqVmKgTfZX-QLIP2McQMmUjuGRQ&oe=6A0B00A3"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oe5qBhQCZwEQ7kNvwE_YNsP&_nc_oc=AdpddYkzS2wpVAQU1meQdF1balz-5NDt7CSU717cC_BlrrfY3b6_ohTHl3K5jYr54qI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7vx5HGyd8umn3Aey8Oqwh68yEjHGkWVIpFNR9tfnY09g&oe=6A0B0140"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zAB8KRB_r-kQ7kNvwGfqXIp&_nc_oc=Adp8UpMWry-9MW28GAlpdMAyFhF5LRA0LyPFCZ-2Hv_CMgGDTMayjB_13p85Hr2r59U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44yOZeUtJ-znwEdKgj4vGbtXBGCOPKfiefNWc4M19cDQ&oe=6A0B2D2D"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1c333Vjow7wQ7kNvwGPnmnJ&_nc_oc=AdpY752A7SxIz4dvJuGiKDBvXInIu-6ewY9qoxoOOeCiLPqYxxzvLxp9tZ_aqUR90aM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7r5dPT419bV9xEjwY7iRaFHeQVOUcM9QDq-gA9Kx-yzw&oe=6A0B075D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7YR9CzD28OUQ7kNvwGRoz7V&_nc_oc=Adod4gwIY5HnuT0VsqfntnqouJ0K0zONLtRswhiErAyakYkJWK6RTF1veyO2LeG9Onw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68-69QeCSXtsu4-CfiycAv4X3hGZB8nlz7k0ksHvNgIQ&oe=6A0B0F87"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=enQ-GZoYN-8Q7kNvwGCln4Z&_nc_oc=AdraTTkdlX4UJNqZVRKZPSMzGUf5sEoY5q8wK7Xv3v8C6cyCJHwyhdSyEZtg1xtVGz8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDA-WTMgrfdNz81Rj4cS4nu-HYYIbw8peqj75KKt9i2hw&oe=6A4CEBA3"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-_M5YXb4snAQ7kNvwG5__Ep&_nc_oc=AdrVuCXUlk-Iyi3SZ_Ijf6Aa47IyUnLhbmKbd1qGQwrXK7Ynj-RHbZjdhmf3DF9uoIs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCggHdubUvXlXmv5JTAq-lfTiSy1pPUX4zduiCum13Y9g&oe=6A4CEC40"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ENY4xh57Wm4Q7kNvwGlS-NX&_nc_oc=AdrjaNO5E5HmjOeXx2uq1ajgZe420mKVfXSuXSIsWdIa7aHkvSDkz66kSOVLI-1BgR0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAcMVafmMVUOipUUP_fiJdwUoFZpRkDzacc-BkrbknUfw&oe=6A4D182D"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_p4zuu4mtuUQ7kNvwEr1jrr&_nc_oc=AdpgoRL0CImBveQXMMztblPPGLstDFwd-xkpdzEytPaOLw91eOvAabq6ssLvUrRTPLc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCrjVN1YQ9FWZLT_fGuz5jOw9FMrmGe4ITRgQ2bqIQyJw&oe=6A4CF25D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CXDLUj-xwjUQ7kNvwE06Qrw&_nc_oc=Adrqvx3_uTeRTmCFWa7L1K9y3VGf9mK6Kj1qN-3jePn-6DpObJL3ms4dRWp0fsjcV5A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9t7iBQEhHMQrD7XGsslWoc_qQojSjNvtderpWjdrhJw&oe=6A4CFA87"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
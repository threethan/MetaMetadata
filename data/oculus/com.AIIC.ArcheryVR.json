_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TtajvATFx7UQ7kNvwEk_YRM&_nc_oc=AdrLrFJF0v5Wyz338GHmv3ZS9F6nFYPz5ELWQ-bpgwJ3UDzryaHdJhpwB2QZpLkJFHc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEnsJjCV-fqNiFE7jIGwMT0OWU5ctYWZSWKi02-eg6_mg&oe=6A82F923"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LAC0BdnyBVYQ7kNvwGDl6Nn&_nc_oc=AdoSGkLR1OQLRlIB9KV7fTXRG-puUR-pUQRJSnWrCkac07sGM7S4WgqS19d9xL412K0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGezg100XFN4oHEoqdhJBmnBfHISw5MuuIMnN1-xzPvww&oe=6A82F9C0"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2RrWwKZPnhYQ7kNvwETgZ4j&_nc_oc=AdqT-ss8jmvaVhxhIv7rNBPH--IW_imRW_faYCtOxUgF_8UK7kzZihMzSZu2Dw2Z8nI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHWnJn73hDSh6nNgkJM__RMM2s6wrN7TrcsbdN5jHk8HA&oe=6A82ED6D"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s_GKzUK56W8Q7kNvwFSWSqp&_nc_oc=AdrFI3w8fKRrIuqQ4Lt-RJyJZ-lpnCb1AklcBSMtY1LG-_6cpzA7z92AF8nAJkwDz20&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHhh_A_ro-M7gNB5bvidDu24SD0_3M3kHoFF5mfh-dIAg&oe=6A82FFDD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GUVq71zGJRQQ7kNvwExyUSC&_nc_oc=Adr_oLPJiQwsrSqcbLm_y2dVq5o3IwjTuoKO50CfSyX-Vbz45r7ddxLTMpKgKylbdV8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHe_QjckSNOiDXUFmBTsJzKAi8ZndDq0lEsLQhq8zR4xg&oe=6A830807"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
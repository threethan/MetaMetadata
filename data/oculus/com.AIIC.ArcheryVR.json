_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WCfG_q6GzCwQ7kNvwHduT6n&_nc_oc=Adr71nI0C2cTB-ykb9uvcbJVZMm5lXDfXkjZsuh3aAiuVoULVgHs91nnvIcKzBM9z3I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLGn9uHjImrcyRxOMgeF0BHGUobEdTiPtb0CUrn8JyXkw&oe=6AAC0FE3"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=av5DxYPHz6YQ7kNvwGw-Wfy&_nc_oc=AdotBavtt3DdI_zoNaa4ZO4my_EUYm2YgJqFXR-rNxgSqMbijCiZj8ATdjghERETwyY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIm-rUrj_daLSFhCksxzC3eMXzosn-Aj3dWcPGtmO4XpQ&oe=6AAC1080"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zOG3lBGiRNgQ7kNvwEqxMss&_nc_oc=Adr42ObMsKq7E1yudLWX1AQPhXd1yhkE1URSpw2SryTLGfx3AK17R0DGrzmSj2fTXDU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKS2rysNzrc00P35cxy0LVwLT4AxtWh_r0OVoGXObsQFg&oe=6AAC042D"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BMkVo1ZFrk0Q7kNvwENK7LP&_nc_oc=Adp1hnwReAMGLY0Zr-eRYF5Uokj5mP2jMxJTzx9l3J6ZuOg1Aldum91XqfU5e0XM3g0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJA1V0upOYmGPsyn1XhBp_i44XAp-aY6L5K5HBsdYIJGA&oe=6AABDE5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VbMKg9Qc7VUQ7kNvwGaogaJ&_nc_oc=AdoVgc2kaoYp669UhX5P1xWzpFBGKicUHYEnfGF7fH2a3PN9iodhKpxBwtEPj4zr_xw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxUlaaNEXZgj6_UVL-CSd17Mb6FQWGRR96kpcSRX3Gaw&oe=6AABE687"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=02aVBjqssFoQ7kNvwHG6MMa&_nc_oc=Adr9p9pTF2CTl4PKIKZmNYXm7blXR5hzedii_410lBlGnEDPN1n-415foOyRASjscNM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdtjOaqZ_amJU6iBSUi4ez_jZ-BoR0AepmFH0PwA0eUQ&oe=6AF5E3E3"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ENFj9AfMoV4Q7kNvwEdIwwT&_nc_oc=AdpcEZ_WHMS3rguwrzUDS7-LDNohD3mCnauPxPQxH9Tv7AyjyI--BvTms_XkLq13AKA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsOZVULxPPUzqCM0zvylh-UoD-_KoAdKmDQt0kOjyp9w&oe=6AF5E480"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t7HDwrtGyTYQ7kNvwGJ-M7x&_nc_oc=AdoOmt5zZZYsfIYP5Z7hxVYsM6hzWPpGZWi4i5EZHfmuvlrqD-xxbD4H0ZpVIwbY-nU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSe1EMeITf8pozyREn7Wxt8IYPuwkA1qWtRSxPHU2ppw&oe=6AF5D82D"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cL5s_UZ64vEQ7kNvwEaxXf8&_nc_oc=AdpXI_rh4v6hoVLb2NujIIxFEA02v3razlbLFMTPAlHEZ2qZ7Yse1JCbL6wTeHh6mpw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRr2Jeu6Yq7Oi8Ow20cfeT3sipQwCaZkA99d4Pw-9nu5w&oe=6AF5EA9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yEZO5eBU424Q7kNvwH_0FsU&_nc_oc=AdrNbsStnnuWoBg17ly9KLcISjx1_vtXwb_clKDTsQWsSfH87egM7ZXuYXBHgn0qAGA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRU_-Z6q1o_MqL4faTEjCJS6SXK9T4WxzHJPwwlFFGxOw&oe=6AF5F2C7"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
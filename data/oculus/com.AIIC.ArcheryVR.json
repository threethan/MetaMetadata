t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8UioB4cBVhcQ7kNvwGu5BER&_nc_oc=AdnWVzxiUz1robK2EnR5Oi4NHIK92TBfGy1orWbRm7EFzEJ8ipALYGAwgIfR47dwrpk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfsFpND-dZQOol-abgQ5KpsRrl8GDVurJaYVQn_YFtHZiw&oe=69A5716D"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MpKNval5hxMQ7kNvwFbt-bt&_nc_oc=AdmLX9qY0fKvcVsOwORbWktqjQyE22ao1Jf0SsfXrYM9FLQi1fFmjYbSMb4TD0ux01c&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfuLK7bfPMmcQvs8VPvZ_yPWxyXfy0BgNt7sy2__WfOEkA&oe=69A583DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X2EW5WCpOcwQ7kNvwGRln4y&_nc_oc=Adkzd5d2RjNN1VBq1fE2z-i3UI2O22uHU6nyxlcIblx4B5XwYO2G1Q_Wxtd3IlvFfnc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afubn-aob061eJbaxKVZxPYwwZHgR5OGjHKx5X3XvIslIA&oe=69A58C07"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32648800938068305"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2079502342881196"}]}, "baseline_offer": {"id": "2079502342881196"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765555320, "status": "PUBLISHED", "id": "2079502342881196"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "32712838251664573", "version": "1.3"}, "id": "4539690526258374", "channel_n
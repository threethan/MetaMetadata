_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6DBUAlbiHZwQ7kNvwGsKBRp&_nc_oc=AdpAxP1_3yx0YT8b6FGRUP8UFijJ7iOliEOCPm28FjB7w70-jPYygQe3wgv_E_vmXOI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA8WNZinPhmcYSANStAi_2xYSSAttWYOVCHzT1wEJn0pg&oe=6A635523"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3HLQU6bLkjIQ7kNvwHVWlxk&_nc_oc=Adr6Jt7MKdvFypAyqG40IVipXix6_D_A7QrqP3mhEIQrXPAx0tmBLbdYXlYrSJKEfFY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQ7a_4xZv7-ggLGn7kygYO1pfp9Xs1yWdJr0oRYIT3bQ&oe=6A6355C0"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lm6dBW2KJ2UQ7kNvwEGv1Z0&_nc_oc=Ado8IQSRBzhv-PefkhYP1j9Jxej2yOSqfDBQF49koOSbrww3xN9TFYD7rhH9HMToM2w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBwTu7XLrJlpjkNfuLM8iI-oBGkdOzDJWAuShauN4oeBQ&oe=6A6381AD"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Akz7G8xSc1kQ7kNvwGMZ89V&_nc_oc=AdrEMP3Bb9W6trIXqkwzCvvzfBxj1ANA-lHg9GM1aULEp_mD92_y1GQqoLar6UOZZmU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDs9JUckvnwZgFCzIwWg_m5u7AM1nBv08bd59xrsepwzw&oe=6A635BDD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K-KeycUdVxQQ7kNvwEu-fy_&_nc_oc=Adr4-XoNNK_owqbvuID5N_ypx0lKlTvuginH7takbBYDPBQogOvKRG0nZsehbc8QNV8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-hF7whLeja8p8QANMlH5W_YEakizSV4BqAaNXSUiSyA&oe=6A636407"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iGw2D4oeEY0Q7kNvwFYMJpA&_nc_oc=AdqObh2sCtgutBdBircylmuVT2fDmlrf02MlxSbRY71796J-pE3F0OPW7vJoCIeVhp8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDSGOi2Wbtegjvk7Zl9G6TucVV7M8Gh2FMlqdU-w5V3nQ&oe=6A58C923"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=21iPW0zXKCgQ7kNvwGQyvf3&_nc_oc=Adp58nedABAl3Udh-6URuGvJ8aLNbKoCX8m3fwoKGug2uEFwIa78wgaVpswmS-pnm0E&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD45ZFGPf7n2XeJ0oHu5xqcV-jFpxBL5A2Y7_F_oxhzgg&oe=6A58C9C0"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w6EL7SeGhlIQ7kNvwHnfaOS&_nc_oc=AdrRp7xF-3qBhGVVnW0jhR6Y1Qt4z0G4UcLhioukzJHp_s0W4LfHu67CK6k0RKiJhAI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCGCyGYtoZ0vhjCGG6_Uj0Eh0mWpO2wsKY9VrCmpMnwKA&oe=6A58F5AD"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wWDFj2nGO7cQ7kNvwGp419Y&_nc_oc=AdpayCsnpT0tfNckm53onSZE0VWWBygGEjdrpMC8TXTxfQa59s20nT01nbuun0-66Pc&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDVw0DKHETieyzNPUxRAYGh8DlmFDzfj_V9IQ-Mpynu5w&oe=6A58CFDD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rnr_gOA9ikgQ7kNvwFw7R-C&_nc_oc=Adr2aj-n_XDW71iIlU1Uh967WVxZs15FyhRiN4-EAASndnFT1Ygd8aO0kU9TLFYeayE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-Dh_e0aVvG9YUi9k0q2PsjL-ki_EH2BgK0nw_CLCTMA&oe=6A58D807"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
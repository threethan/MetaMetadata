_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PNy58YN_LSkQ7kNvwG96QCq&_nc_oc=AdqIqYU5pEjrU68YMpuRtLh1PtNhRrGWNwzwI18GCWNC7kU6NLa6URtUbUjRQlBUQcg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGbhvcxpjqKRWPjN9dJk5zfvr5tMCyyGjghDN5gPjW3Uw&oe=6A8990A3"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U92JG_tJIhsQ7kNvwEN7PeQ&_nc_oc=Adqo63so37ipgpqGzAbcdzb_-H8ub3YsPW7Q3rXoPMCyVJGGwF2bvEfvAyG37UfzQuY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFguDPb1a41GG9OxFn28togT_mekatTeLU5UCF1iG02YA&oe=6A899140"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gGs6j_rlo2gQ7kNvwF1hj_w&_nc_oc=AdrnfTanC4lp_HItvmlaIEoSUugHFf7Sgv_ag-YlcafvH7PIP5LzwZ2TZXDnDqsTl_I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGuQsP23wYwtF4yHQ14OBbSBcvoqwD4Kf76znr5yThGZA&oe=6A8984ED"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vBofolvn5zIQ7kNvwGTHtWJ&_nc_oc=AdozWElRVgCUK2LK1tjy_tr1AX2TWpwB2H0cjBxeE5FrEOQtQPR_DVyBzPUsejGoOY0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGeS-jZZ_wYgg4MU-bRGIqgg-pQsl4LvBreUF-xfuYk-w&oe=6A89975D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wLPIF92QW6oQ7kNvwG7DBro&_nc_oc=Ado14hhxTI7eZViUfFm1hI-a99yS3xH4Ul8SoMTON_X5YlqAKw3xx1SEXRm8tHuNB4Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8L5b85gC---eqS_pKCGsQFUkqweSuDq-8_S2ehxP_gA&oe=6A899F87"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n7wn4CXSHNEQ7kNvwElchAf&_nc_oc=AdoWon3XTKCJT9e8SYsxu1AtCF0rc5aiKvzbF08Y3mg7skbzoYK418BfJAze7EBhlec&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQQLzh8QNd6lEHI3kRJR3ZUCY1rGxKg_33C35-DMQ8Jg&oe=6A7F04A3"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=95A1OgVnSDcQ7kNvwGxGBNK&_nc_oc=AdrPKC4WhpUBrIKJ5vwxAOJEKNAiQk7I2ryYT2lAGtXVAL9hBx01DUoVaygUi5pKOpU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHwhMxD0MCvqCdRfBEBcsRV79Es1JTBpiXi8ojOWVlMfA&oe=6A7F0540"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3gtJTlwUNY4Q7kNvwESTlnZ&_nc_oc=Adr_TFfNhp3dL-vQMYMSi8RXu5DKbRl9x1SHXhQOCSSaVAwHGoJ0BLTtb8-SLqJeES0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEkB-hAz86OP_AyY9n9XGwHgBme0XYAIqJLadX7ewELOw&oe=6A7EF8ED"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XvP0LJYGfDkQ7kNvwFIlKjg&_nc_oc=AdrzN5gu7cr9vKCjmV1gLaHBABVsGjC5Fb3raXLGAhWCeyHocw9mpp0o1gTI30OJ6aY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFH2eMD9HhLsqwGxYcX-mr2aHM0AyLPicJy5y86cAFd8g&oe=6A7F0B5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Il612ZtfU0AQ7kNvwFDcjbH&_nc_oc=Adp_jLK82tZDc3McAueQf2TVCOCzJNZnK8p56uz7MYbBqBWUY4UT2BqhMAfcjEXy_Po&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSI98Me8M0GOKyB9i3w_EXVg9ynqZph_2uyWpldqxIEw&oe=6A7F1387"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
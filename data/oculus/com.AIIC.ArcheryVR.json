_8630006457222592984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YwCksR0K36QQ7kNvwEYzO_t&_nc_oc=AdpIHT0wAWldqJT846-RNvCbCNJScnPe_XiyqDMPK9lx2Mzrgv-M-r2GkPzPUe4xC0I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOmitLeYCAgolSEtxW1fUONSEP_ir_7Ws1FhspFR7LgGw&oe=6AC3CAE3"}, {"file_name": "6.png", "id": "1743589156250118", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819356_1743589159583451_3320508258015646214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mqM1Lybd_ssQ7kNvwGfjftt&_nc_oc=AdrC6j8jlaceaVEadv2_-oRbJfOxZiNml5E6lybdyqlHvdzD2D8KMVq8MpMOlQClpaw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKaI-9KIiSTQ6P3eSHmWZcRWRuyCLd7rhlXRz05ANGoQ&oe=6AC3CB80"}, {"file_name": "3.png", "id": "1567542021334144", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823271_1567542024667477_4493149698156905292_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=do9Tg_1qx4cQ7kNvwGkf4Cq&_nc_oc=AdrZMYiRy4pItXIH5v1uhCAN_hdaAj0NnSPIgJ2qCSUtvfwstgsooIxwTTtnP8NFdWw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMScbiphXyW73_MeJlfFdVamsT1wyoKa8qe8x2PkQ3LZQ&oe=6AC3BF2D"}, {"file_name": "4.png", "id": "871079115274051", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823757_871079118607384_645471339255579721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pmfrqNy40mQQ7kNvwHcBEkI&_nc_oc=AdoCzpXmV_VlrTHKZdA6cUFDSxUWTaAo7PulnOob9OYrhUi-b1KsD1eV8BhKDoKwEQw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNbiDSfrR468B6edMZeUrUR82JpO6c67u43_0fSEpmlBQ&oe=6AC3D19D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art.png", "id": "1828362914458757", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823271_1828362921125423_3666720472601451674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eXzEFS27sjAQ7kNvwF789RD&_nc_oc=AdqAK9hHeGuSkQ0ag4oyWnLPzIA1-nB5hMgIQY6TcPKdjvorSGjQ0BeDpK0BQ3Z3sYY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNtAY2H_lGT-BlhaeFf7sbTksdfBh-WjHCImOgmmk3wbg&oe=6AC3D9C7"}, "display_name": "Archery VR", "keywords": ["Archery", "Shooter", "Simulation", "Birds", "Arcade"], "long_description": "**Overview**\n\nArchery VR is a focused arcade shooter designed to demonstrate high-fidelity VR mechanics. Step into an immersive environment and test your marksmanship against dynamic, fast-moving avian targets.\n\n**Key Features**\n* **Physics-Based Archery:** satisfying and realistic bow handling tailored for the Meta Quest 3 controllers.\n* **Bird Hunting:** Track and shoot down birds with precision timing. The harder the shot, the more satisfying the hit.\n* **High Score Challenge:** A pure gameplay loop focused on skill improvement and beating your personal best.\n* **Immersive Environment:** Clean visuals and responsive audio feedback create a satisfying shooting experience.\n\n**About This Project**\nThis game serves as a portfolio piece demonstrating proficiency in Unity VR development and C# scripting. It highlights the use of the Meta XR Interaction SDK to create smooth, responsive player interactions.", "short_description": "A fast-paced VR archery simulation. Master realistic bow mechanics to shoot down flying birds and compete for the highest score. Features satisfying physics, precision aiming. Created as a technical portfolio showcase for immersive VR interactions on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/archeryvr/home", "developer_terms_of_service_url": null, "publisher_name": "AlanSalam", "support_website_url": null, "website_url": "https://sites.google.com/view/archeryvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
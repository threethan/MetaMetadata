JFH0AnlIJd0k7FxWDP-2IXH4StjN22MYLqUmWdA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR5FQBZ-n719M655d46SkHfK3kL49ajB1W2GnyjtPW74w&oe=6B0B1AAF"}, {"file_name": "screenshot3.png", "id": "880065436859203", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974581_880065440192536_3169506190588574631_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O9gAlXjJPTMQ7kNvwEEIJH2&_nc_oc=AdqGAeUvUh_lLNZtg12-oS-cUFduxlyiLdoHJtYobJarIDrXf4EKdtIqNWggAB1X5gE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSGG6YeAiEq9ksWRZzmpkqegwWxauQPii2inNOAgvYH-w&oe=6B0B319F"}, {"file_name": "screenshot4.png", "id": "427814126974269", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031359_427814130307602_336341457739226029_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZXgi-9pwWT0Q7kNvwG4atVR&_nc_oc=Adq1-s7yj-TZaTcjfulkOe_W3_0u5rJlF3qFDCeh5zlsUUeYaqXLHNFVUKn0j8wj2gk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTTKrKephWdLbS2TbXJWJPo0xj4w-xtstDagLb91rkF_A&oe=6B0B443B"}, {"file_name": "screenshot5.png", "id": "1487225012164964", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75295292_1487225015498297_5010089407039707767_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=edLCPezdlEMQ7kNvwGabpr3&_nc_oc=Adp-sAmj6uAWgiNKBa27OCBvbmyvAfANHh2p09W7CKZoPAg14TRA2BzxVe1ep5NC2k0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSWjlgkrR74rymouc9A-I3G39MbaX6rx33KcGunHINqYA&oe=6B0B1C1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VK3.png", "id": "4508591389416930", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499314660_4508591392750263_135294743665109963_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F7n-xuN6PfkQ7kNvwFKjkgm&_nc_oc=AdrTvThhAAa5sfonmhcWPc2bDG2A6upycIEq8KNZIkzSSdpYA2J9JJP0kfOm4Uruezk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQZu-dpjM6PjFMGpJ_VdG6Fz92ZZNxp4K0tpcyncBgrQg&oe=6B0B1438"}, "display_name": "Virtual Kombat", "keywords": ["kombat", "virtual", "VirtualKombat", "Fighting", "Combat"], "long_description": "# MASTER THE ART OF VR COMBAT\nVictory isn't about button mashing. it's about timing, movement, and precision. Trigger attacks using your virtual combat controls while positioning your hero around the arena to outplay your opponent.\n\n{1054373600501429}\n\n# UNIQUE HEROES. UNIQUE ABILITIES\nEvery fighter brings a different playstyle. Learn their strengths, master their abilities, and discover the hero that matches your fighting style.\n\n{968612079548362}\n\n# SPECIAL ABILITIES CHANGE THE FIGHT\nTurn the tide of battle with powerful abilities that reward smart timing and tactical decision-making.\n\n{1965764474077640}\n\n# TRAIN AGAINST AI\nPractice with your favorite heroes, learn their abilities, and improve your skills before entering competitive battles.\n\n{27692465773727411}", "short_description": "Immerse yourself in the ultimate combat experience with Virtual Kombat. Step into the virtual arena where heroes from across the realms clash in breathtaking, fast-paced battles. Master devastating combos, unleash powerful special moves, and outsmart your opponents in intense one-on-one VR battles. With stunning visuals, immersive sound, and a variety of class skills, Virtual Kombat offers an unparalleled fighting game experience. Are you ready to become a legend?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.virtualkombat.com/privacy.html", "developer_terms_of_service_url": "https://www.virtualkombat.com/terms.html", "publisher_name": "Kinbona Limited", "support_website_url": null, "website_url": "https://www.virtualkombat.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "4597
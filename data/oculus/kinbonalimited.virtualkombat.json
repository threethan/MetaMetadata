&_nc_oc=AdrnMsqq8srv7YG3qhpakrYGbIRyaceJthiDj0FR3NuKHr3pDVQYPDPV8ag9cJ3qssA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJw3YcostLHEMGJDhJJJhrFpcqaelVmLR5DodkVcHzCw&oe=6AAEB05F"}, {"file_name": "screenshot4.png", "id": "427814126974269", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39031359_427814130307602_336341457739226029_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KHZ5xplaDp4Q7kNvwEZHPZk&_nc_oc=AdqMSTdaQsBQrmztpqL5_koX_4TD5uKi1J2VHlztcl1sRCrekrhvjaqz6MUHmvpM2xg&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLiWx6MPcl2M3nUjOotYj8p0BgtQSefCzlnE17_15-v4A&oe=6AAE8ABB"}, {"file_name": "screenshot5.png", "id": "1487225012164964", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75295292_1487225015498297_5010089407039707767_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f9CRXXA8sfQQ7kNvwGq4CH6&_nc_oc=Adp8b9cqHVCQFf4ze3QtwFtapUDiDRgKoORkgNo079IjczrKPYrW9SnDRxAKwBpnk4o&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbMhwVRzD6TUrJDCzWuXaJ79h5K-a-biH8eH8dP0fd8g&oe=6AAE9ADD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VK3.png", "id": "4508591389416930", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499314660_4508591392750263_135294743665109963_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gNJ7gGl1szoQ7kNvwGBAz6v&_nc_oc=AdrxNm3yd0YKY7q9k_cU9jRlYEALxpUEN6uQ8sHxZ5xICRSO8jIBIKHfejfUDufVtYk&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9yjqw4CKHRk3zeTdRGG-NOQUzzRSzQJXOMvVBx-a9VA&oe=6AAE92F8"}, "display_name": "Virtual Kombat", "keywords": ["kombat", "virtual", "VirtualKombat", "Fighting", "Combat"], "long_description": "# MASTER THE ART OF VR COMBAT\nVictory isn't about button mashing. it's about timing, movement, and precision. Trigger attacks using your virtual combat controls while positioning your hero around the arena to outplay your opponent.\n\n{1054373600501429}\n\n# UNIQUE HEROES. UNIQUE ABILITIES\nEvery fighter brings a different playstyle. Learn their strengths, master their abilities, and discover the hero that matches your fighting style.\n\n{968612079548362}\n\n# SPECIAL ABILITIES CHANGE THE FIGHT\nTurn the tide of battle with powerful abilities that reward smart timing and tactical decision-making.\n\n{1965764474077640}\n\n# TRAIN AGAINST AI\nPractice with your favorite heroes, learn their abilities, and improve your skills before entering competitive battles.\n\n{27692465773727411}", "short_description": "Immerse yourself in the ultimate combat experience with Virtual Kombat. Step into the virtual arena where heroes from across the realms clash in breathtaking, fast-paced battles. Master devastating combos, unleash powerful special moves, and outsmart your opponents in intense one-on-one VR battles. With stunning visuals, immersive sound, and a variety of class skills, Virtual Kombat offers an unparalleled fighting game experience. Are you ready to become a legend?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.virtualkombat.com/privacy.html", "developer_terms_of_service_url": "https://www.virtualkombat.com/terms.html", "publisher_name": "Kinbona Limited", "support_website_url": null, "website_url": "https://www.virtualkombat.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "459781504968480"}, {"id": "275629210202852"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes":
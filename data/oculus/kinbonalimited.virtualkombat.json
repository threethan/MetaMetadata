3vCyAFKhdntbob7winpxaO0q7T7KeHNCRHn-ki8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCMXfSq6nl1RvF2FGLwv2Rl3ARt3VYvhTsWnFx3ghNvQ&oe=6B083F6F"}, {"file_name": "screenshot3.png", "id": "880065436859203", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974581_880065440192536_3169506190588574631_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t9GeunwLtW8Q7kNvwGhP8xm&_nc_oc=AdrMcrncUws-KoKX1uQdWoG_4a7zoFFJvVIq3QpfIiIApn8cINS8PjE2G8vo0oO5fXc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRafglAE4K0zjyG5rt0625wcV1lAtvWhQ5EeH8KfxrGJw&oe=6B08565F"}, {"file_name": "screenshot4.png", "id": "427814126974269", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031359_427814130307602_336341457739226029_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZXgi-9pwWT0Q7kNvwF9UPK7&_nc_oc=AdrlusZJrvLA08dS2jazJvHXfZWIMWbCLgLhLW0W48_1XyDrqFM8hNdw26BLCKz2ZCQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEqJEYvUy0XESROgSfyqP0n1qEgiHHE_X2TzdJAo8IXA&oe=6B0868FB"}, {"file_name": "screenshot5.png", "id": "1487225012164964", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75295292_1487225015498297_5010089407039707767_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VwghyM5-yscQ7kNvwEV_6fR&_nc_oc=AdqZum951SfXAYkPaD-w5rI88lpBrb2vT2UNCiEHJozLoVcc1sr3LG603968P3Zxur0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR72ViAhEn0wn_26OEsQQxBrVmirdbsHKdEzi0nsakPzg&oe=6B0840DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VK3.png", "id": "4508591389416930", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/499314660_4508591392750263_135294743665109963_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F7n-xuN6PfkQ7kNvwFMB3A9&_nc_oc=Adq7Gd8Cpvs8pxlhxZm1cTEgvGTHqgB0NXlFjmw6dYPgfkx97658I0TobtY-vytgoSw&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7Pvqp2R1f8Y_GNeFIARCxyycHB2tv8MtNW4-uy94TLQ&oe=6B087138"}, "display_name": "Virtual Kombat", "keywords": ["kombat", "virtual", "VirtualKombat", "Fighting", "Combat"], "long_description": "# MASTER THE ART OF VR COMBAT\nVictory isn't about button mashing. it's about timing, movement, and precision. Trigger attacks using your virtual combat controls while positioning your hero around the arena to outplay your opponent.\n\n{1054373600501429}\n\n# UNIQUE HEROES. UNIQUE ABILITIES\nEvery fighter brings a different playstyle. Learn their strengths, master their abilities, and discover the hero that matches your fighting style.\n\n{968612079548362}\n\n# SPECIAL ABILITIES CHANGE THE FIGHT\nTurn the tide of battle with powerful abilities that reward smart timing and tactical decision-making.\n\n{1965764474077640}\n\n# TRAIN AGAINST AI\nPractice with your favorite heroes, learn their abilities, and improve your skills before entering competitive battles.\n\n{27692465773727411}", "short_description": "Immerse yourself in the ultimate combat experience with Virtual Kombat. Step into the virtual arena where heroes from across the realms clash in breathtaking, fast-paced battles. Master devastating combos, unleash powerful special moves, and outsmart your opponents in intense one-on-one VR battles. With stunning visuals, immersive sound, and a variety of class skills, Virtual Kombat offers an unparalleled fighting game experience. Are you ready to become a legend?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.virtualkombat.com/privacy.html", "developer_terms_of_service_url": "https://www.virtualkombat.com/terms.html", "publisher_name": "Kinbona Limited", "support_website_url": null, "website_url": "https://www.virtualkombat.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "4597
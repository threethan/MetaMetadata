O5LI7kJxpcSd2OUcAJIBNPbLv2-CdKdl4JRJ9f0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ88NfFtCI-8E1189zSAP91fQ41EKZzgGnJXDmcsKdVlw&oe=6AFF04EF"}, {"file_name": "screenshot3.png", "id": "880065436859203", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974581_880065440192536_3169506190588574631_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=asKCHaIYuMwQ7kNvwF9NmVf&_nc_oc=Adrd3j9sipNuB2X67jsdOBEftIT3fte_aS26xqHqROf8dm7CNOTsx1TdPGh_bGmXt3I&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaxn7X0dVZktm_wKy0N2o4nyzH57Ayd9OCV4irTCygLg&oe=6AFF1BDF"}, {"file_name": "screenshot4.png", "id": "427814126974269", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031359_427814130307602_336341457739226029_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KD8jhe7OSvEQ7kNvwGQGpJU&_nc_oc=AdpChR-j-LADnIGkH3ICWEUGkFErBHoWvBggUScay3WW3ExqOcMuuGxH0es2ZsQYc9g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSu1EbsT6SIKtLQoWmkp2M_mLZj3LB_wMH3jaIyP4-few&oe=6AFF2E7B"}, {"file_name": "screenshot5.png", "id": "1487225012164964", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75295292_1487225015498297_5010089407039707767_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jgG9mh6-sQEQ7kNvwEFSiPU&_nc_oc=AdoQfkOavFCCS2J0S6o25KjuREpCephhtPmxwgPSfikcblDbzO1WqgjRGmHrJXkzJZI&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQcYCi2dHvymdGcdw3Sj-mia9rKxC9kbUvcKBCYEAKKQ&oe=6AFF065D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VK3.png", "id": "4508591389416930", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499314660_4508591392750263_135294743665109963_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eRhV5dgdEJkQ7kNvwGMRxU1&_nc_oc=AdplohmO3AmRLAjwYs1vlxN1_7B4mj78Ea_PWBzS4KEx-FfbfO-h5dItTzMWL8dGYfg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNjOiNstRKuQ3Uy7aV5pw2-6mUxXVAytTB6Jjy53PjRA&oe=6AFF36B8"}, "display_name": "Virtual Kombat", "keywords": ["kombat", "virtual", "VirtualKombat", "Fighting", "Combat"], "long_description": "# MASTER THE ART OF VR COMBAT\nVictory isn't about button mashing. it's about timing, movement, and precision. Trigger attacks using your virtual combat controls while positioning your hero around the arena to outplay your opponent.\n\n{1054373600501429}\n\n# UNIQUE HEROES. UNIQUE ABILITIES\nEvery fighter brings a different playstyle. Learn their strengths, master their abilities, and discover the hero that matches your fighting style.\n\n{968612079548362}\n\n# SPECIAL ABILITIES CHANGE THE FIGHT\nTurn the tide of battle with powerful abilities that reward smart timing and tactical decision-making.\n\n{1965764474077640}\n\n# TRAIN AGAINST AI\nPractice with your favorite heroes, learn their abilities, and improve your skills before entering competitive battles.\n\n{27692465773727411}", "short_description": "Immerse yourself in the ultimate combat experience with Virtual Kombat. Step into the virtual arena where heroes from across the realms clash in breathtaking, fast-paced battles. Master devastating combos, unleash powerful special moves, and outsmart your opponents in intense one-on-one VR battles. With stunning visuals, immersive sound, and a variety of class skills, Virtual Kombat offers an unparalleled fighting game experience. Are you ready to become a legend?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.virtualkombat.com/privacy.html", "developer_terms_of_service_url": "https://www.virtualkombat.com/terms.html", "publisher_name": "Kinbona Limited", "support_website_url": null, "website_url": "https://www.virtualkombat.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "4597
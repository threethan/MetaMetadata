sSSfg110mOqo0LRQwuoxjr6FYg3JUPLWCqLUYtA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYxMFS5kvaZEfwfCADSx7wdrNHeadhytnO7sRyUzs7eg&oe=6B07262F"}, {"file_name": "screenshot3.png", "id": "880065436859203", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974581_880065440192536_3169506190588574631_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t9GeunwLtW8Q7kNvwFDJbgy&_nc_oc=AdotEe5v1j3d4Bg6JWuXW1FVAkFWueUrThNAEQIiT7TURuDSVJtB78DZBje6-duQUQs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRc1KjarbcCpr0LR3ygaOcG5Pqb68IhWuBlaWtljNhmnw&oe=6B0704DF"}, {"file_name": "screenshot4.png", "id": "427814126974269", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031359_427814130307602_336341457739226029_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ni7m09Zd7wMQ7kNvwGF1YVw&_nc_oc=AdruKYlfGc6cinz91J5ElbNu3YSkod7xiGTZrgseX0_TNVTQyhebZVYwZiUR3nbMNOI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMgNragVLuGkz3JPK9fucQlA3P22DnTY8xRH-_SeGEFA&oe=6B07177B"}, {"file_name": "screenshot5.png", "id": "1487225012164964", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75295292_1487225015498297_5010089407039707767_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VwghyM5-yscQ7kNvwFxO-01&_nc_oc=Ado8MTq91qndA4APkovXl5qAgTGw8y4TY2TbyblOEmPO9sRMd9CMlbWAxKzLF1M-J40&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0no7OiQ2AuULVxqP21DwYjrPhc2AWKlMlAJcXn40LyA&oe=6B07279D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VK3.png", "id": "4508591389416930", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499314660_4508591392750263_135294743665109963_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1BMn8UuoA1EQ7kNvwHzq6oC&_nc_oc=AdrimK452qym9lIVNG9cxwidBapeoeYrCM5DTd9GgXPB0m8Oh23RQ06_3eXeaw9w7tI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvmgrjU5IrDe3lwIH7sSzBP_GMbjicpRfv-Szrm_mnUg&oe=6B071FB8"}, "display_name": "Virtual Kombat", "keywords": ["kombat", "virtual", "VirtualKombat", "Fighting", "Combat"], "long_description": "# MASTER THE ART OF VR COMBAT\nVictory isn't about button mashing. it's about timing, movement, and precision. Trigger attacks using your virtual combat controls while positioning your hero around the arena to outplay your opponent.\n\n{1054373600501429}\n\n# UNIQUE HEROES. UNIQUE ABILITIES\nEvery fighter brings a different playstyle. Learn their strengths, master their abilities, and discover the hero that matches your fighting style.\n\n{968612079548362}\n\n# SPECIAL ABILITIES CHANGE THE FIGHT\nTurn the tide of battle with powerful abilities that reward smart timing and tactical decision-making.\n\n{1965764474077640}\n\n# TRAIN AGAINST AI\nPractice with your favorite heroes, learn their abilities, and improve your skills before entering competitive battles.\n\n{27692465773727411}", "short_description": "Immerse yourself in the ultimate combat experience with Virtual Kombat. Step into the virtual arena where heroes from across the realms clash in breathtaking, fast-paced battles. Master devastating combos, unleash powerful special moves, and outsmart your opponents in intense one-on-one VR battles. With stunning visuals, immersive sound, and a variety of class skills, Virtual Kombat offers an unparalleled fighting game experience. Are you ready to become a legend?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.virtualkombat.com/privacy.html", "developer_terms_of_service_url": "https://www.virtualkombat.com/terms.html", "publisher_name": "Kinbona Limited", "support_website_url": null, "website_url": "https://www.virtualkombat.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "4597
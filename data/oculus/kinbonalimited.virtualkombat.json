4ep6lvR7U71EyBaxemWCT1Jgsx0TtrF4r-wbazk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR047hIYnI8qoVgiN4-3ebILNDu7g8rzZFLT5rvIVg-uQ&oe=6AFB48AF"}, {"file_name": "screenshot3.png", "id": "880065436859203", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974581_880065440192536_3169506190588574631_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OfL3Eod5zxwQ7kNvwE_K1f-&_nc_oc=Ado5w8Oc8XMDf3hGQwUzUo2tWkvvjAwVt5onOamOObWtOdgcNpaxNBSNovO9DECPvU8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjC0m2-u93V_AjqaGiy78fGhd0_TWVesnf8vra3aO07Q&oe=6AFB275F"}, {"file_name": "screenshot4.png", "id": "427814126974269", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031359_427814130307602_336341457739226029_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vWrbZfrTuYsQ7kNvwERvWkS&_nc_oc=AdpcESAxwfki7bEEb27jlApRM_ra-DGi7no6WoP-mDe0qyT2o2rkKwxD51biYW13tqI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBw_2CEC2JuEaO_fH3LkBF0bjQxXFd7tSj0Vn7nluknQ&oe=6AFB39FB"}, {"file_name": "screenshot5.png", "id": "1487225012164964", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75295292_1487225015498297_5010089407039707767_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eeYHkrYVBjgQ7kNvwGGksuK&_nc_oc=Ado356srz0sXYkSL4ji40slkF5ZEwm14WNa8DZ_J45qotPXziNjo3hr9TQaFXu17rKU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtOuJsujnwmtZyWUyIJonjsoZWRAEx4lrxzzWBb8Supw&oe=6AFB4A1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VK3.png", "id": "4508591389416930", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499314660_4508591392750263_135294743665109963_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4IlCqJZsNXsQ7kNvwG2T4GY&_nc_oc=AdocWQLrggNCTb84MzAL2gptiD0a6VGuRpKWCeo4CvZL08aRaLOioywzG4seLedUfYQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR58d3sYspaxc5lg93hF5pTzva6-27WFhFSwmU3SDzJFg&oe=6AFB4238"}, "display_name": "Virtual Kombat", "keywords": ["kombat", "virtual", "VirtualKombat", "Fighting", "Combat"], "long_description": "# MASTER THE ART OF VR COMBAT\nVictory isn't about button mashing. it's about timing, movement, and precision. Trigger attacks using your virtual combat controls while positioning your hero around the arena to outplay your opponent.\n\n{1054373600501429}\n\n# UNIQUE HEROES. UNIQUE ABILITIES\nEvery fighter brings a different playstyle. Learn their strengths, master their abilities, and discover the hero that matches your fighting style.\n\n{968612079548362}\n\n# SPECIAL ABILITIES CHANGE THE FIGHT\nTurn the tide of battle with powerful abilities that reward smart timing and tactical decision-making.\n\n{1965764474077640}\n\n# TRAIN AGAINST AI\nPractice with your favorite heroes, learn their abilities, and improve your skills before entering competitive battles.\n\n{27692465773727411}", "short_description": "Immerse yourself in the ultimate combat experience with Virtual Kombat. Step into the virtual arena where heroes from across the realms clash in breathtaking, fast-paced battles. Master devastating combos, unleash powerful special moves, and outsmart your opponents in intense one-on-one VR battles. With stunning visuals, immersive sound, and a variety of class skills, Virtual Kombat offers an unparalleled fighting game experience. Are you ready to become a legend?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.virtualkombat.com/privacy.html", "developer_terms_of_service_url": "https://www.virtualkombat.com/terms.html", "publisher_name": "Kinbona Limited", "support_website_url": null, "website_url": "https://www.virtualkombat.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "4597
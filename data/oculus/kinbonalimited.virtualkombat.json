ajEQ7kNvwGU3-8s&_nc_oc=AdpOvJdf5tOkGvXqEijAEhajS2HlGiRsCHEh_RAhRYVUtIsB2rc5eJzk2174rhT5L_c&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEm3YQgw7Om3QVDz3X-XAkSDyPlxU0mlbfGG8M2JNvhzw&oe=6A8D829F"}, {"file_name": "screenshot4.png", "id": "427814126974269", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031359_427814130307602_336341457739226029_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=knwcOXkEqaUQ7kNvwE2YXke&_nc_oc=AdpaXL7TDUubB71q9vnwfV5KpGWlIZjXZIuYk4xHx0BaqufCwgJgC8ixRmI4ag84NDI&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMwFVVqwm9h6Q_hhIXWCILmxVcuAYFkeyfLm_RsmpHsA&oe=6A8D953B"}, {"file_name": "screenshot5.png", "id": "1487225012164964", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75295292_1487225015498297_5010089407039707767_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pf5JunWNOwsQ7kNvwHCE3_S&_nc_oc=AdqsG7MVgGCoT1GynDGuWSZmdZUYi8KmjgWs31T27HWS75MrVyRlNSGYYLP0eCO1C78&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmvADoNIIQnHuE3YsxIC8WdZqOKnDQwfQRPoBImBnVAA&oe=6A8D6D1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VK3.png", "id": "4508591389416930", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499314660_4508591392750263_135294743665109963_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N5GiT5Ifl3oQ7kNvwGf-Vc2&_nc_oc=AdqEsX_ETExXpUFS3LqtUjlQXXtbeWAWUH6EXwf6cv2UPTvrr66lZsyTFPGNUM8hk8g&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhaXZ660JrTFxBmwuDs76DaDD3FjISp8wk7VhjKT_vWQ&oe=6A8D6538"}, "display_name": "Virtual Kombat", "keywords": ["kombat", "virtual", "VirtualKombat", "Fighting", "Combat"], "long_description": "# MASTER THE ART OF VR COMBAT\nVictory isn't about button mashing. it's about timing, movement, and precision. Trigger attacks using your virtual combat controls while positioning your hero around the arena to outplay your opponent.\n\n{1054373600501429}\n\n# UNIQUE HEROES. UNIQUE ABILITIES\nEvery fighter brings a different playstyle. Learn their strengths, master their abilities, and discover the hero that matches your fighting style.\n\n{968612079548362}\n\n# SPECIAL ABILITIES CHANGE THE FIGHT\nTurn the tide of battle with powerful abilities that reward smart timing and tactical decision-making.\n\n{1965764474077640}\n\n# TRAIN AGAINST AI\nPractice with your favorite heroes, learn their abilities, and improve your skills before entering competitive battles.\n\n{27692465773727411}", "short_description": "Immerse yourself in the ultimate combat experience with Virtual Kombat. Step into the virtual arena where heroes from across the realms clash in breathtaking, fast-paced battles. Master devastating combos, unleash powerful special moves, and outsmart your opponents in intense one-on-one VR battles. With stunning visuals, immersive sound, and a variety of class skills, Virtual Kombat offers an unparalleled fighting game experience. Are you ready to become a legend?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.virtualkombat.com/privacy.html", "developer_terms_of_service_url": "https://www.virtualkombat.com/terms.html", "publisher_name": "Kinbona Limited", "support_website_url": null, "website_url": "https://www.virtualkombat.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "459781504968480"}, {"id": "275629210202852"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_i
pgAe5O5wOj-oBMCOwKSDvvpp9a3B4_wrieGG4xo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWa5pOIU0-Gi7sj7iv5Q5m5gIL0yULnOx0Nletvuvh4Q&oe=6B05D4AF"}, {"file_name": "screenshot3.png", "id": "880065436859203", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974581_880065440192536_3169506190588574631_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t9GeunwLtW8Q7kNvwHOrKVG&_nc_oc=AdoHNkVEkp3jLFRehYc3CHxn8IsCslPg8N9Ds1hgMB34uSjN1ZR_XWrh2POKpbEQlsU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDpoCmw7ajIHsh4lUUiGP7AGXiS8oRbNcGA_qQCZuWJg&oe=6B05B35F"}, {"file_name": "screenshot4.png", "id": "427814126974269", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031359_427814130307602_336341457739226029_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ni7m09Zd7wMQ7kNvwFHq5kT&_nc_oc=Ado95WVJk1SBasY9S15rzEDHrGI2vAQsHOWPNEB5NIkuQgOzPOdHRKKw40DrA0RG_p4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVchH2iYg3nuCNw4TV1EyDx8q2HVVx8DgDBcMwWLyrWw&oe=6B05C5FB"}, {"file_name": "screenshot5.png", "id": "1487225012164964", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75295292_1487225015498297_5010089407039707767_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VwghyM5-yscQ7kNvwFTRrej&_nc_oc=AdrK-erTp7UDdwiaT81f_4It4QxtvNQy7kOck2Ijodq04axZMhyJb5AXO5kwVV3-Uz8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0f8SH2cVVzobW6uEbiAqjSeoxtBQfbmtn2o7Vzh-KDw&oe=6B05D61D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VK3.png", "id": "4508591389416930", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499314660_4508591392750263_135294743665109963_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1BMn8UuoA1EQ7kNvwHbV6Eq&_nc_oc=AdoE1IynhZGA2wQSQSlo2SphrN5fL7ZJ9c8lzpC0bo_fSL0t36xKEbjIhhFiJ-mL3EY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIDt2dpRxd3KJnfozjV_zN-Mswftys-Mp6zltfalIEUw&oe=6B05CE38"}, "display_name": "Virtual Kombat", "keywords": ["kombat", "virtual", "VirtualKombat", "Fighting", "Combat"], "long_description": "# MASTER THE ART OF VR COMBAT\nVictory isn't about button mashing. it's about timing, movement, and precision. Trigger attacks using your virtual combat controls while positioning your hero around the arena to outplay your opponent.\n\n{1054373600501429}\n\n# UNIQUE HEROES. UNIQUE ABILITIES\nEvery fighter brings a different playstyle. Learn their strengths, master their abilities, and discover the hero that matches your fighting style.\n\n{968612079548362}\n\n# SPECIAL ABILITIES CHANGE THE FIGHT\nTurn the tide of battle with powerful abilities that reward smart timing and tactical decision-making.\n\n{1965764474077640}\n\n# TRAIN AGAINST AI\nPractice with your favorite heroes, learn their abilities, and improve your skills before entering competitive battles.\n\n{27692465773727411}", "short_description": "Immerse yourself in the ultimate combat experience with Virtual Kombat. Step into the virtual arena where heroes from across the realms clash in breathtaking, fast-paced battles. Master devastating combos, unleash powerful special moves, and outsmart your opponents in intense one-on-one VR battles. With stunning visuals, immersive sound, and a variety of class skills, Virtual Kombat offers an unparalleled fighting game experience. Are you ready to become a legend?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.virtualkombat.com/privacy.html", "developer_terms_of_service_url": "https://www.virtualkombat.com/terms.html", "publisher_name": "Kinbona Limited", "support_website_url": null, "website_url": "https://www.virtualkombat.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "4597
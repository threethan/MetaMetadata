m8n5UKghrdSPSG-NoGKlOWmUtvYICJYEk_tjYkY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQh6kuGXToUGUDH0cpEPMOtot2H9TaJC8U80ms8xp3jVw&oe=6B04832F"}, {"file_name": "screenshot3.png", "id": "880065436859203", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974581_880065440192536_3169506190588574631_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Boq23tVsiMQ7kNvwEj_V_U&_nc_oc=Adq0rvQfB_WPGFdy1CfrSnF4GOG66LweqaNkiRVE_PLfkvlGGIQroMc8_DDQjeEFEyY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzyTHFFAPUnQDHevv-Kye-Y_5JPhZ1F1wL4ZI6LodBWQ&oe=6B0461DF"}, {"file_name": "screenshot4.png", "id": "427814126974269", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031359_427814130307602_336341457739226029_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ni7m09Zd7wMQ7kNvwFIpr69&_nc_oc=AdpLywp1FtDWqWqHgJ9oGIegFajfgwDgjg9XDGirFV875yvWQP5-L2WLR48F1m4eRpo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYpcAtrhCAlrKNkWdd8JpQmD8eoty5S3FSlHAgbWqZ9g&oe=6B04747B"}, {"file_name": "screenshot5.png", "id": "1487225012164964", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75295292_1487225015498297_5010089407039707767_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VspUyXwHt3AQ7kNvwFvlZzv&_nc_oc=AdpVg_q29eMAyM5OhijazrRoNLGYbcqQA5mmTIXbqdOTGLcKZIsnp3gn4T0QlVSQLjk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtrAn3tU1fwBoxRKezrRqDzn6WrELD7jRY3zMPb9DD7g&oe=6B04849D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VK3.png", "id": "4508591389416930", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499314660_4508591392750263_135294743665109963_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1BMn8UuoA1EQ7kNvwFrK7eW&_nc_oc=AdpV-zP3xgzefEYBqGcmiGEztCI07145AN83mgIOl6ztozRm52WMRGRhhQGdOjvCb9A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvgfo0ZFbO15YqQt-VY6ow-h1uvgiUs-rEYATskWKbrw&oe=6B047CB8"}, "display_name": "Virtual Kombat", "keywords": ["kombat", "virtual", "VirtualKombat", "Fighting", "Combat"], "long_description": "# MASTER THE ART OF VR COMBAT\nVictory isn't about button mashing. it's about timing, movement, and precision. Trigger attacks using your virtual combat controls while positioning your hero around the arena to outplay your opponent.\n\n{1054373600501429}\n\n# UNIQUE HEROES. UNIQUE ABILITIES\nEvery fighter brings a different playstyle. Learn their strengths, master their abilities, and discover the hero that matches your fighting style.\n\n{968612079548362}\n\n# SPECIAL ABILITIES CHANGE THE FIGHT\nTurn the tide of battle with powerful abilities that reward smart timing and tactical decision-making.\n\n{1965764474077640}\n\n# TRAIN AGAINST AI\nPractice with your favorite heroes, learn their abilities, and improve your skills before entering competitive battles.\n\n{27692465773727411}", "short_description": "Immerse yourself in the ultimate combat experience with Virtual Kombat. Step into the virtual arena where heroes from across the realms clash in breathtaking, fast-paced battles. Master devastating combos, unleash powerful special moves, and outsmart your opponents in intense one-on-one VR battles. With stunning visuals, immersive sound, and a variety of class skills, Virtual Kombat offers an unparalleled fighting game experience. Are you ready to become a legend?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.virtualkombat.com/privacy.html", "developer_terms_of_service_url": "https://www.virtualkombat.com/terms.html", "publisher_name": "Kinbona Limited", "support_website_url": null, "website_url": "https://www.virtualkombat.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "4597
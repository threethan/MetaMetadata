ent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxMycSYp3f7Yn0Y6MO_hbRk1n4UabuxS-WUZyIdox7ByQ&oe=69AFF883"}, {"file_name": "migrated_image.png", "id": "2665404563747783", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12427628_944662762348785_9052153139829932032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YQ96RyQy030Q7kNvwHEHxFc&_nc_oc=AdkoipJ3jLDtTC9tlLyK3TdKabZkAu_FygRUAUNZzu7vTnwn8vh1fdg5bSzQvmpEp1Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx_me0eTKNlvkSNx3Hk1TRWy0oAFIBuyT5yPNjsxRb03A&oe=69AFFA8A"}, {"file_name": "migrated_image.png", "id": "636416553586309", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162716_1603944873006524_1840643809914912768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qMNbtQ-FbCoQ7kNvwF2GfdQ&_nc_oc=AdnzXtxoOrf2GKLEJUv18t_MwRPB-fYzun_ee5a17rLgA7nTgTH3hxiaTB9dUtm5YDI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyKMKssYyArWRRTmBTi64xaNeENAHG07rSGu-Q8W1OoPg&oe=69B01559"}, {"file_name": "migrated_image.png", "id": "141509870580218", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162753_105474883577168_2760768629560573952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=130qo2Hdi1YQ7kNvwGwrxJl&_nc_oc=AdmerY1ypzqdXkU05de_jKFyVuvjLwhwEobJAwF4A0v-u3CdeYVI9twDfb0ciFFDqKM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzijnFxjDMRFNTYAk5hlyKaHVnypERmsjoUQRDeDobNkQ&oe=69B0150A"}, {"file_name": "migrated_image.png", "id": "231039388021951", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162763_1642951579127800_3642216555741184000_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QhOZFVGxCUgQ7kNvwH9h2PN&_nc_oc=Adlk0OPKUghINcQpk82f-lHyJvkRf9xVVjwLPldNEkOCmgn5usmC8SLHE19SWF1Dl2w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy4BjsFTxQVZh4Zq0fzLctCVHUQWG2ju9HvrRrIG-n-QQ&oe=69AFFADC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store Cover Art Landscape.png", "id": "198798457528467", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162769_198798460861800_90065447017250816_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G8j3CCRdtRoQ7kNvwFD9wHK&_nc_oc=Adm4hKa0WYSU4Zfqit4dllCTZolUiheKwcBt-CYaCxCQvxGLfcqkYiMh2YeeTK2K9kc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxccFB1tLnxSeQH3P0IfwH-xGnhl0Z35FE47Vf2mUghvQ&oe=69B00669"}, "display_name": "Tjuhej", "keywords": ["adventure", "storytelling", "playhouse", "paint", "puzzle"], "long_description": "Tjuhej is a story universe where mindful storytelling and thrilling music provides a positive input and time to reflect. Each level starts with a minigame where you must solve a task and figure out how to get to your story. At the end of a level you will get a star and when the door to Playhouse got 3 stars you can unlock this amazing room. When entering Playhouse, you get a whole new world, where you can redecorate, collect rewards and let your imagination fly!\nLevel 1-3 can be played without controller then double tap to move forward and swipe to turn.\nYou should definitely use headphones!\nTjuhej features:\n\u25cf\tMini games - mystery, strategy, puzzles and action.\n\u25cf\tMindful stories with amazing music - binaural beats that relax and rejuvenate\n\u25cf\tCreative Playhouse \u2013 decorate your own playhouse with 2D and 3D painting, listen to music.\n\u25cf\tRewards \u2013 for every three stars, you\u2019ll receive another reward.\nThis update has new levels, a few bug fixes and a tutorial.", "short_description": "Tjuhej is a magical playground for kids and big kids, where you can play fun mini games, meet storytellers from all over the universe, and get your own amazing playhouse. With Tjuhej, a world of excitement is at your fingertips!\nNow new levels 4-9 with new surprises!"}]}, "developer_name": "Minditorium", "developer_privacy_policy_url": "http://www.tjuhej.com/wp-content/uploads/2018/01/Private-Policy-Tjuhej.pdf", "developer_terms_of_service_url": "http://www.tjuhej.com/sample-page/",
2753_170176693581863_3687672969183625216_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mypsh3nF5nEQ7kNvwHMRHUX&_nc_oc=AdpzLjR7nZjCTi8zNpCcZhju04yPkzgimbcdwYRDrDsS-MWgVuQ8NMZshoI_tKeup7s&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQReg3sW5GElLX2heNYpcX7Cd7uTui46mOgH83W8raNn_Q&oe=6B0999C3"}, {"file_name": "migrated_image.png", "id": "2665404563747783", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12427628_944662762348785_9052153139829932032_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vZLBcGmdaQsQ7kNvwGHGOYH&_nc_oc=AdpAjuSpTzktPK_3YnmShmwG7e2rpe1H52zYwvFKluxhOZe9_tAVtptjDsykjOUU7Nc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIsguUw0QnXKPWfJDss5gdpiaDFHZ6Fwk_NbS3MABQfQ&oe=6B099BCA"}, {"file_name": "migrated_image.png", "id": "636416553586309", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162716_1603944873006524_1840643809914912768_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NcatiewBEwIQ7kNvwE1wNo_&_nc_oc=AdqNmis_1nsrk-3diOgxaiLh96AQvYz1axOEPArxHokUC7QnVAKzo0Wad8X4-zMDKjY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUWGANzuOUZRKIRnvtMoXdA8v0-HqShFPJt71b88YRBw&oe=6B09B699"}, {"file_name": "migrated_image.png", "id": "141509870580218", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162753_105474883577168_2760768629560573952_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XN-nQor_J_kQ7kNvwHn3ywS&_nc_oc=AdrLw_QEzOG09uhP-jGQX-N2ebvvEnOf6NmBDfgfCSIypgwwFf4icC-t434SA13IiH4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1hBgsVftrfpShJwq9_pRcYfm5YmOE8X4PRirJ3pHKyA&oe=6B09B64A"}, {"file_name": "migrated_image.png", "id": "231039388021951", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162763_1642951579127800_3642216555741184000_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=baLapQFaKgIQ7kNvwH_Cdbo&_nc_oc=AdqU2pKm8Q7KZ9xhRDVa70g3RaMRggklehBfJ-Nzll0DFuuRFjp0R7fEBKEtvMmg9Es&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSmE8RZ1HHkz5zJquPacEmzJBIyKdZvcyvqbPtvcXT6A&oe=6B099C1C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store Cover Art Landscape.png", "id": "198798457528467", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162769_198798460861800_90065447017250816_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wBnCcg8Z9UgQ7kNvwFQVaJF&_nc_oc=AdoZdOamYSWJ3vLCilUhmkYAQFxMC9V3ayglqo8IzUwQ6kcBbPRVZ_r9s0J2jFVucBg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXCr2k2lPp1S9u4Je7avNe-t2IDOkTfqv5GGyxUrsMUA&oe=6B09A7A9"}, "display_name": "Tjuhej", "keywords": ["adventure", "storytelling", "playhouse", "paint", "puzzle"], "long_description": "Tjuhej is a story universe where mindful storytelling and thrilling music provides a positive input and time to reflect. Each level starts with a minigame where you must solve a task and figure out how to get to your story. At the end of a level you will get a star and when the door to Playhouse got 3 stars you can unlock this amazing room. When entering Playhouse, you get a whole new world, where you can redecorate, collect rewards and let your imagination fly!\nLevel 1-3 can be played without controller then double tap to move forward and swipe to turn.\nYou should definitely use headphones!\nTjuhej features:\n\u25cf\tMini games - mystery, strategy, puzzles and action.\n\u25cf\tMindful stories with amazing music - binaural beats that relax and rejuvenate\n\u25cf\tCreative Playhouse \u2013 decorate your own playhouse with 2D and 3D painting, listen to music.\n\u25cf\tRewards \u2013 for every three stars, you\u2019ll receive another reward.\nThis update has new levels, a few bug fixes and a tutorial.", "short_description": "Tjuhej is a magical playground for kids and big kids, where you can play fun mini games, meet storytellers from all over the universe, and get your own amazing playhouse. With Tjuhej, a world of excitement is at your fingertips!\nNow new levels 4-9 with new surprises!"}]}, "developer_name": "Minditorium", "developer_privacy_policy_url": "http://www.tjuhej.com/wp-content/uploads/2018/01/Private-Policy-Tjuhej.pdf", "developer_terms_of_service_url": "http://www.tjuhej.com/sample-page/", "publisher_name": "Minditorium", "support_website_url": null, "website_url": "http://www.tjuhej.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "EXPLORATION", "NARRATIVE", "PUZZLE", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "468801428115103"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12410407_2026531734289567_8454582236719611904_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aN_x2Elfcv8Q7kNvwGmQ8bo&_nc_oc=AdpA8bDFOe7iraoBwm1UL_CtuJuCCaSt8p9LGJ-ByznOaRM9AazBCOYHd7bK2Nr9sHo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTm3WG8NWy4-mLlRAcsFUL4ssLv0DzIcD35JR25utHJqA&oe=6B09B780"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Tjuhej", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1518026400, "lastRevision": {"nodes": [{"id": "1720304891347691", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "178045628198
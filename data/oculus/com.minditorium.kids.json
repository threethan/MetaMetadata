ent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyKLLhmD_gCIGvfgpuo785csrMcdVhsgjH8OxDaA-18SQ&oe=69B14A03"}, {"file_name": "migrated_image.png", "id": "2665404563747783", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12427628_944662762348785_9052153139829932032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YQ96RyQy030Q7kNvwHQOPMG&_nc_oc=AdlbMbnSHGMKAFn5WVSz-traXxw3dFwu3H0LkqE_f8lijRRUiOigh2x-Fjo65cOXxeY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw6MFkEm9cxPdGhQIi55RQtE3gmc6Ow5fCh7A3RDWgx4w&oe=69B14C0A"}, {"file_name": "migrated_image.png", "id": "636416553586309", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162716_1603944873006524_1840643809914912768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qMNbtQ-FbCoQ7kNvwH6LfTC&_nc_oc=AdnLJfwqpzB_w2OZmpIHkmPmRmWDUYhx05QAmHO6jZ5xX7H1CqGRT9SY6N94_m4q6bA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfySRslXXoF9gqwxafuJ0x_8jd9D6wyzu0EHH0C6AcZJBw&oe=69B166D9"}, {"file_name": "migrated_image.png", "id": "141509870580218", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162753_105474883577168_2760768629560573952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=130qo2Hdi1YQ7kNvwGA1hKu&_nc_oc=AdnQ7f5vCluRAiPB13LvY0xQZEA2Da6MZSthC7boQjLvn_9JhdaOJ1MuH-jQVyr5VOQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxUBK_oj_AtdX6FdbceGG2PtqN6UNmfpwlQA0vijO-Tcw&oe=69B1668A"}, {"file_name": "migrated_image.png", "id": "231039388021951", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162763_1642951579127800_3642216555741184000_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QhOZFVGxCUgQ7kNvwELH47V&_nc_oc=AdnqrRlHYN8O0CkcrK5Dd4Ch5CmioNc_02rHfh2AS9sFVraReAs7GaWRXw2eX2csIg0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyqTJoiAfssWSO4b93aulxFdk3ffEE7hmlMKmHkCDY3Fw&oe=69B14C5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store Cover Art Landscape.png", "id": "198798457528467", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162769_198798460861800_90065447017250816_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G8j3CCRdtRoQ7kNvwFHzHMA&_nc_oc=Adk1_3v2lR3_ros87725LY-z9A4sRX-brLuq1LQOpvV4oBD9OqbKugLraOlyieMUbKY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afz5qzp-kw52fRPIBfYdvEFjmf_FkmRxUuME6nX69J-81Q&oe=69B157E9"}, "display_name": "Tjuhej", "keywords": ["adventure", "storytelling", "playhouse", "paint", "puzzle"], "long_description": "Tjuhej is a story universe where mindful storytelling and thrilling music provides a positive input and time to reflect. Each level starts with a minigame where you must solve a task and figure out how to get to your story. At the end of a level you will get a star and when the door to Playhouse got 3 stars you can unlock this amazing room. When entering Playhouse, you get a whole new world, where you can redecorate, collect rewards and let your imagination fly!\nLevel 1-3 can be played without controller then double tap to move forward and swipe to turn.\nYou should definitely use headphones!\nTjuhej features:\n\u25cf\tMini games - mystery, strategy, puzzles and action.\n\u25cf\tMindful stories with amazing music - binaural beats that relax and rejuvenate\n\u25cf\tCreative Playhouse \u2013 decorate your own playhouse with 2D and 3D painting, listen to music.\n\u25cf\tRewards \u2013 for every three stars, you\u2019ll receive another reward.\nThis update has new levels, a few bug fixes and a tutorial.", "short_description": "Tjuhej is a magical playground for kids and big kids, where you can play fun mini games, meet storytellers from all over the universe, and get your own amazing playhouse. With Tjuhej, a world of excitement is at your fingertips!\nNow new levels 4-9 with new surprises!"}]}, "developer_name": "Minditorium", "developer_privacy_policy_url": "http://www.tjuhej.com/wp-content/uploads/2018/01/Private-Policy-Tjuhej.pdf", "developer_terms_of_service_url": "http://www.tjuhej.com/sample-page/",
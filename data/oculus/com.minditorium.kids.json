2753_170176693581863_3687672969183625216_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gSSR7Joec-wQ7kNvwGg1ycS&_nc_oc=AdqHWzJAjtP_zujSTQY-v5Dlu2ajx9vud3Gt1Zhu-zuZ0mBT8rB5KvYc-BX_njnpI38&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUYZEDGmY9uP06FuGncb6RPfGs2Fq3RfRXYoSRSFWP2pQ&oe=6B106983"}, {"file_name": "migrated_image.png", "id": "2665404563747783", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427628_944662762348785_9052153139829932032_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YyVWiY_zNoAQ7kNvwETb-Og&_nc_oc=AdoWmYtKmNvnUsRPb4exc7-yOfY7dudCvUAIjoCSVTJQCASSQA_QjfkyjS2UDFdg4tE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVsa3tZj6-MarVZc1amX1pKDudWG84QbrmC0cBnyvOhRw&oe=6B106B8A"}, {"file_name": "migrated_image.png", "id": "636416553586309", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162716_1603944873006524_1840643809914912768_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5eJcFYgeGboQ7kNvwGkEUD4&_nc_oc=AdpYjj_5nA4bU7tALvot7JYTYGYtsbUaZuRAWp_Ul9-R4W2UlsSzMx7x3_lj-At8lmA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWfu4sANVUX-WzYk5heOGTkTvQyKUiTYWZhQC7NFVWlZA&oe=6B104E19"}, {"file_name": "migrated_image.png", "id": "141509870580218", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162753_105474883577168_2760768629560573952_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bm67gW74P7YQ7kNvwEs3xUW&_nc_oc=AdoBjvBHM2T9jtFU2jfulCHgSa6IbrtMoNCDV2i0tFypL-fRrP4EDbSIEeacr0U10Nc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWJnDck0TL_vjxTiDz82y-p30Zn0iOau5IwgrAv07LcCg&oe=6B104DCA"}, {"file_name": "migrated_image.png", "id": "231039388021951", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162763_1642951579127800_3642216555741184000_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6jtJcW465-IQ7kNvwFihnWb&_nc_oc=AdplSgb_2o4pCOPZSdgVFkuyAa1wbqB8_GsXHnKfxpIarxp-VoIpKROo2Dg3FEnwgHk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV2_ViV4vWinSsDPZtLQjwH58geC0nx321Eng5GD00pcg&oe=6B106BDC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store Cover Art Landscape.png", "id": "198798457528467", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162769_198798460861800_90065447017250816_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XUbxB8ZQd2kQ7kNvwGw7Rn6&_nc_oc=AdplJaGM4qD93R6f7Q2alY0ySqMPHHDcqGo_5mR2o2TEFJM5uv-xhiA0gZriieWCuNg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXzYzgrwapgUhsFJ0RHWXYrYj6Zm8v4OYCze_INml5Yvw&oe=6B103F29"}, "display_name": "Tjuhej", "keywords": ["adventure", "storytelling", "playhouse", "paint", "puzzle"], "long_description": "Tjuhej is a story universe where mindful storytelling and thrilling music provides a positive input and time to reflect. Each level starts with a minigame where you must solve a task and figure out how to get to your story. At the end of a level you will get a star and when the door to Playhouse got 3 stars you can unlock this amazing room. When entering Playhouse, you get a whole new world, where you can redecorate, collect rewards and let your imagination fly!\nLevel 1-3 can be played without controller then double tap to move forward and swipe to turn.\nYou should definitely use headphones!\nTjuhej features:\n\u25cf\tMini games - mystery, strategy, puzzles and action.\n\u25cf\tMindful stories with amazing music - binaural beats that relax and rejuvenate\n\u25cf\tCreative Playhouse \u2013 decorate your own playhouse with 2D and 3D painting, listen to music.\n\u25cf\tRewards \u2013 for every three stars, you\u2019ll receive another reward.\nThis update has new levels, a few bug fixes and a tutorial.", "short_description": "Tjuhej is a magical playground for kids and big kids, where you can play fun mini games, meet storytellers from all over the universe, and get your own amazing playhouse. With Tjuhej, a world of excitement is at your fingertips!\nNow new levels 4-9 with new surprises!"}]}, "developer_name": "Minditorium", "developer_privacy_policy_url": "http://www.tjuhej.com/wp-content/uploads/2018/01/Private-Policy-Tjuhej.pdf", "developer_terms_of_service_url": "http://www.tjuhej.com/sample-page/", "publisher_name": "Minditorium", "support_website_url": null, "website_url": "http://www.tjuhej.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "EXPLORATION", "NARRATIVE", "PUZZLE", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "468801428115103"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410407_2026531734289567_8454582236719611904_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KTOMRTMny3oQ7kNvwG91aG-&_nc_oc=Adq3VwhVdqs9krJxFzgMyyQCpEdd1gb49U_aWMJYsqtqnuuAFx8hByw5x5DcS-7qC0A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUnSc6U65WUx3MKxN7izFBqtQ0xl6ciRaOk2vWoKyhf7Q&oe=6B104F00"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Tjuhej", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1518026400, "lastRevision": {"nodes": [{"id": "1720304891347691", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "178045628198
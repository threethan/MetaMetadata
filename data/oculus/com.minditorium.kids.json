yof8wUQti6Mp-A&oe=69A56C83"}, {"file_name": "migrated_image.png", "id": "2665404563747783", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12427628_944662762348785_9052153139829932032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y9guj2M1nSQQ7kNvwGecSoy&_nc_oc=AdkSsWkANGqjndcIyYs6uuLQj68pdnRCRCK1ow_PqKPW12TCyhyJtnl8j9Cd2Ujqp5A&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfsE-p4yXR3mD6DxHhfdYTBc-HonN_Xo1B9u8ODSXuUm4Q&oe=69A56E8A"}, {"file_name": "migrated_image.png", "id": "636416553586309", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162716_1603944873006524_1840643809914912768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ThY7UZComu4Q7kNvwHFpOE_&_nc_oc=Adk1qxWFV5oGLYXSTi1-ilwg5c-FK8wuIKyMDVW6bTAfJIHG2o-QjJOuhJS7qlCd4io&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfuxokfpC2L_7wtlNsKAx9pA56Yu8KwFTUXZ_HUZvNxbvw&oe=69A58959"}, {"file_name": "migrated_image.png", "id": "141509870580218", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162753_105474883577168_2760768629560573952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MO0TGyKhP5cQ7kNvwFQ-Vdm&_nc_oc=AdmunrFTfXOcdbbL-rjLI8Dqyr76H8xNyHzUbK0EMQ0m8scj3KKZrAhu_Q9VHgfAXDE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Afu67_k_m3zhEvxdHny6TNTTY0nbKAj_B5m-OvjBXQgJ0Q&oe=69A5890A"}, {"file_name": "migrated_image.png", "id": "231039388021951", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162763_1642951579127800_3642216555741184000_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g32hi-E7tEEQ7kNvwGd4Ls4&_nc_oc=AdnnuJ8gWioCKOyWutzijF-vJlFbEoduTdDR__dX0Ng6erNA2oIU5E62B3h7B4P3i1E&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AftyCCWmm3AUjUkzVaxum6xfUSfHaKiJ6f-rAcIQHtXDZQ&oe=69A56EDC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store Cover Art Landscape.png", "id": "198798457528467", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162769_198798460861800_90065447017250816_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W75CSazjfesQ7kNvwHZmtHE&_nc_oc=AdlYPiUOA7kzW_03VhynNTEiNXsNmrCy_4am1dO_AxMoJJnfiUV_e2N9ZouoftaAynQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afv_bucEU-N_AhqaXNh00nINN6C-nniFxYzy7HTji_ao7A&oe=69A57A69"}, "display_name": "Tjuhej", "keywords": ["adventure", "storytelling", "playhouse", "paint", "puzzle"], "long_description": "Tjuhej is a story universe where mindful storytelling and thrilling music provides a positive input and time to reflect. Each level starts with a minigame where you must solve a task and figure out how to get to your story. At the end of a level you will get a star and when the door to Playhouse got 3 stars you can unlock this amazing room. When entering Playhouse, you get a whole new world, where you can redecorate, collect rewards and let your imagination fly!\nLevel 1-3 can be played without controller then double tap to move forward and swipe to turn.\nYou should definitely use headphones!\nTjuhej features:\n\u25cf\tMini games - mystery, strategy, puzzles and action.\n\u25cf\tMindful stories with amazing music - binaural beats that relax and rejuvenate\n\u25cf\tCreative Playhouse \u2013 decorate your own playhouse with 2D and 3D painting, listen to music.\n\u25cf\tRewards \u2013 for every three stars, you\u2019ll receive another reward.\nThis update has new levels, a few bug fixes and a tutorial.", "short_description": "Tjuhej is a magical playground for kids and big kids, where you can play fun mini games, meet storytellers from all over the universe, and get your own amazing playhouse. With Tjuhej, a world of excitement is at your fingertips!\nNow new levels 4-9 with new surprises!"}]}, "developer_name": "Minditorium", "developer_privacy_policy_url": "http://www.tjuhej.com/wp-content/uploads/2018/01/Private-Policy-Tjuhej.pdf", "developer_terms_of_service_url": "http://www.tjuhej.com/sample-page/", "publisher_name": "Minditorium", "support_website_url": null, "website_url": "http://www.tjuhej.com/", "category": "
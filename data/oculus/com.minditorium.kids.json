ent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz29n3KqXlUzb4dZnyH14TiPiwbe9v41KzvPAnDHFQCCA&oe=69B69003"}, {"file_name": "migrated_image.png", "id": "2665404563747783", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12427628_944662762348785_9052153139829932032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zZMIPUuP9EgQ7kNvwHvJlg0&_nc_oc=AdmzyGcF-zAq_L38wljx9sjG2nhVKUmwmtqnW_Sx_ATzbtLdM-rkhZ3LHJdupiot0do&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyaLqAiX92nIxRI_POR7EAHn7WUU2BKwzO5xes6ky_hKw&oe=69B6920A"}, {"file_name": "migrated_image.png", "id": "636416553586309", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162716_1603944873006524_1840643809914912768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ulXvmiBWk3kQ7kNvwHwIQoH&_nc_oc=AdkrphdesSUjWJloaBRAebEEuZpI-7jWbwJUhgEYYhz6GqVfrZkfOnD3TicQ5vHvDSg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy9ZtJDryrRL259sVf7WjAzWH_Iw-v1eGB1U3ufZkntQg&oe=69B6ACD9"}, {"file_name": "migrated_image.png", "id": "141509870580218", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162753_105474883577168_2760768629560573952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wt01E-NiK_IQ7kNvwGmXXdO&_nc_oc=AdkbSo1A58TgG54lDSKMLzRI8q5cRRe0toqXwYzDngjK17xq64TVxGdul7KyjcSPd0E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz-IRsFXf4KWDgv3OP2_qVVHSonRURjRzYCxM9NTldxBg&oe=69B6AC8A"}, {"file_name": "migrated_image.png", "id": "231039388021951", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162763_1642951579127800_3642216555741184000_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KkMhTLpGkgsQ7kNvwG1akRI&_nc_oc=AdldLSPbozwa88qFzJQar-e7RNJpbxdQUwslRAlXPad6GUOZUuh0zY1epbcJ-f1f_qo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyHsco7YTbq7u2VeNOCsc8fSow4TwrqrtHKhdTQyssjSQ&oe=69B6925C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store Cover Art Landscape.png", "id": "198798457528467", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162769_198798460861800_90065447017250816_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rUA9xWMdofMQ7kNvwF9299Q&_nc_oc=Adkr_2LvHNkGZs167vEaRN51-GmgFmgZPWnY74sNjq0nWRh39EvKBP-q9vdDL0VuY-4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyoOeR3-NmV3N-01Adr5zTaCtZwOQJtw21F9XkgrDk-Rg&oe=69B69DE9"}, "display_name": "Tjuhej", "keywords": ["adventure", "storytelling", "playhouse", "paint", "puzzle"], "long_description": "Tjuhej is a story universe where mindful storytelling and thrilling music provides a positive input and time to reflect. Each level starts with a minigame where you must solve a task and figure out how to get to your story. At the end of a level you will get a star and when the door to Playhouse got 3 stars you can unlock this amazing room. When entering Playhouse, you get a whole new world, where you can redecorate, collect rewards and let your imagination fly!\nLevel 1-3 can be played without controller then double tap to move forward and swipe to turn.\nYou should definitely use headphones!\nTjuhej features:\n\u25cf\tMini games - mystery, strategy, puzzles and action.\n\u25cf\tMindful stories with amazing music - binaural beats that relax and rejuvenate\n\u25cf\tCreative Playhouse \u2013 decorate your own playhouse with 2D and 3D painting, listen to music.\n\u25cf\tRewards \u2013 for every three stars, you\u2019ll receive another reward.\nThis update has new levels, a few bug fixes and a tutorial.", "short_description": "Tjuhej is a magical playground for kids and big kids, where you can play fun mini games, meet storytellers from all over the universe, and get your own amazing playhouse. With Tjuhej, a world of excitement is at your fingertips!\nNow new levels 4-9 with new surprises!"}]}, "developer_name": "Minditorium", "developer_privacy_policy_url": "http://www.tjuhej.com/wp-content/uploads/2018/01/Private-Policy-Tjuhej.pdf", "developer_terms_of_service_url": "http://www.tjuhej.com/sample-page/",
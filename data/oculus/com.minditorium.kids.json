ent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxF9QwQkt2W5ofjzgQbwEgr3jieZxnQDKK90HgxSa0Tsg&oe=69AD5583"}, {"file_name": "migrated_image.png", "id": "2665404563747783", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12427628_944662762348785_9052153139829932032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nMX8l2YP6MwQ7kNvwHrYe1O&_nc_oc=AdkF0KB4eJM7mQr_mK2s3K03g14YqtbDFTzG-NrkTD5zLqm_V6xvsWF6zKxY-bBzyTw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy2u8UIjttki7sRZehQXu2Vy5RJbCLZDcXOo2Cchkt66A&oe=69AD578A"}, {"file_name": "migrated_image.png", "id": "636416553586309", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162716_1603944873006524_1840643809914912768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MY0mkgQEt9cQ7kNvwFlebzM&_nc_oc=Adn-io7tgyahdj0arEjeYCkOYP4fkamJl-NmVwTISGIPCufsNf4k--H5E-EAJ7QAVyE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzPjoLNZsfVN9VY9Hz_6Cp_RL_JP6_OsoLsHkpXwJqIUg&oe=69AD7259"}, {"file_name": "migrated_image.png", "id": "141509870580218", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162753_105474883577168_2760768629560573952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F4xUiv13aGgQ7kNvwEawZXt&_nc_oc=AdnY8NcNuRiKYknlVOhdvTg3YotM2kDXiA2etgoI7qZf_8nIn3HHa5rg0mvm4G2uOcg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyexWL8SO6sKwnpSWNuGqa2ITyq72Erh1WgID7uCepB8w&oe=69AD720A"}, {"file_name": "migrated_image.png", "id": "231039388021951", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162763_1642951579127800_3642216555741184000_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I6bTH7oouOAQ7kNvwH2j613&_nc_oc=AdlC9-Mg1nh7ub3ebOcQDnuK8c6HPqwVunWsXR63lIxO6hENuqaRJCWVYBCTjsoFC9g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwA7Ny0_zY-SaV3ufN-nqcGIrDVNTBOidwo7ks9XlBsTg&oe=69AD57DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store Cover Art Landscape.png", "id": "198798457528467", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162769_198798460861800_90065447017250816_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oZlQZRYgw1QQ7kNvwF8Zde0&_nc_oc=AdlOZninYHnZGXyL48QJ7Wnd-JG9691SyZIdPEtYkB7po_Af3RaFDW5FdT6SRhzVr4U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxsRanDEl2ZYCdw4fGNH0cPqv8MOZitj_huGLVzh3TvFQ&oe=69AD6369"}, "display_name": "Tjuhej", "keywords": ["adventure", "storytelling", "playhouse", "paint", "puzzle"], "long_description": "Tjuhej is a story universe where mindful storytelling and thrilling music provides a positive input and time to reflect. Each level starts with a minigame where you must solve a task and figure out how to get to your story. At the end of a level you will get a star and when the door to Playhouse got 3 stars you can unlock this amazing room. When entering Playhouse, you get a whole new world, where you can redecorate, collect rewards and let your imagination fly!\nLevel 1-3 can be played without controller then double tap to move forward and swipe to turn.\nYou should definitely use headphones!\nTjuhej features:\n\u25cf\tMini games - mystery, strategy, puzzles and action.\n\u25cf\tMindful stories with amazing music - binaural beats that relax and rejuvenate\n\u25cf\tCreative Playhouse \u2013 decorate your own playhouse with 2D and 3D painting, listen to music.\n\u25cf\tRewards \u2013 for every three stars, you\u2019ll receive another reward.\nThis update has new levels, a few bug fixes and a tutorial.", "short_description": "Tjuhej is a magical playground for kids and big kids, where you can play fun mini games, meet storytellers from all over the universe, and get your own amazing playhouse. With Tjuhej, a world of excitement is at your fingertips!\nNow new levels 4-9 with new surprises!"}]}, "developer_name": "Minditorium", "developer_privacy_policy_url": "http://www.tjuhej.com/wp-content/uploads/2018/01/Private-Policy-Tjuhej.pdf", "developer_terms_of_service_url": "http://www.tjuhej.com/sample-page/",
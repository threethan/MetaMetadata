ent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyNd6OC1TYZ7SK6P-jAqo4gsnmHQYO5UKND_IqCY0Zhpw&oe=69C11C03"}, {"file_name": "migrated_image.png", "id": "2665404563747783", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12427628_944662762348785_9052153139829932032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oIrhtZc4iNQQ7kNvwH04r_p&_nc_oc=Adq_1o9mATv_Wlkz1WAJKGUmFqOYQc3J60B5nyn8RlABC8lpg_MJ1dt0q7lIL88CCVo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwAz2OdEhViEL1h4lt-d2z1LpOdTyaZ__EhMLJI63Qf7w&oe=69C11E0A"}, {"file_name": "migrated_image.png", "id": "636416553586309", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162716_1603944873006524_1840643809914912768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3HFkE8FbS4EQ7kNvwFMgzEh&_nc_oc=AdofrwKOQS9lDDkl4or97pez664qHl4LwyIipvF2Tm3dI1rIRccPUuDOl_JOkQwclz4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afyq6y0JGWg3V4MftCFL408oWQyWs420zRIGIyxNaa-yyQ&oe=69C138D9"}, {"file_name": "migrated_image.png", "id": "141509870580218", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162753_105474883577168_2760768629560573952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7EdFHHGLv-0Q7kNvwHjOt-Y&_nc_oc=AdqpB2AWwJCNZeNGOMNcD6fyvc6-EiwzZUrGlNKS7vLSwDKItnbiP-EobnahN00IL4c&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyCRxHuli-EFZTi7CuH-f756a9XAnkoelPHYeBxXFcFog&oe=69C1388A"}, {"file_name": "migrated_image.png", "id": "231039388021951", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162763_1642951579127800_3642216555741184000_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3FPVo3TBXtkQ7kNvwGQcfbW&_nc_oc=AdrXOUwB93e4KJ9PwZ2pSdS71mdK_CAYfEuYtfKpmx2I0FcsS6yDlEuvopiV9LCkEds&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxEOqAJkQ8vQ28UJDcxdT4rgV1k_d9B1RONuaAUXi0GPQ&oe=69C11E5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store Cover Art Landscape.png", "id": "198798457528467", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162769_198798460861800_90065447017250816_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6y0toN72bikQ7kNvwHU7YAv&_nc_oc=Adq6uKC5EEtx6N86SVb6WIJcRemBw8pmkTffpuXtluICwAGwZ5Pbvs4ZimNPWcASd7A&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxKg7QJMwEevIyjmqWdjms2ZLYeXsYi6gzTZLhN5zexYg&oe=69C129E9"}, "display_name": "Tjuhej", "keywords": ["adventure", "storytelling", "playhouse", "paint", "puzzle"], "long_description": "Tjuhej is a story universe where mindful storytelling and thrilling music provides a positive input and time to reflect. Each level starts with a minigame where you must solve a task and figure out how to get to your story. At the end of a level you will get a star and when the door to Playhouse got 3 stars you can unlock this amazing room. When entering Playhouse, you get a whole new world, where you can redecorate, collect rewards and let your imagination fly!\nLevel 1-3 can be played without controller then double tap to move forward and swipe to turn.\nYou should definitely use headphones!\nTjuhej features:\n\u25cf\tMini games - mystery, strategy, puzzles and action.\n\u25cf\tMindful stories with amazing music - binaural beats that relax and rejuvenate\n\u25cf\tCreative Playhouse \u2013 decorate your own playhouse with 2D and 3D painting, listen to music.\n\u25cf\tRewards \u2013 for every three stars, you\u2019ll receive another reward.\nThis update has new levels, a few bug fixes and a tutorial.", "short_description": "Tjuhej is a magical playground for kids and big kids, where you can play fun mini games, meet storytellers from all over the universe, and get your own amazing playhouse. With Tjuhej, a world of excitement is at your fingertips!\nNow new levels 4-9 with new surprises!"}]}, "developer_name": "Minditorium", "developer_privacy_policy_url": "http://www.tjuhej.com/wp-content/uploads/2018/01/Private-Policy-Tjuhej.pdf", "developer_terms_of_service_url": "http://www.tjuhej.com/sample-page/",
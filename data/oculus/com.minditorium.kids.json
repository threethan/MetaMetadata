id": "198798457528467", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162769_198798460861800_90065447017250816_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oibvt4Mk3zIQ7kNvwHVenFN&_nc_oc=AdrDrwOqGgWoWASg1IFmRaJfFqHhBClkGRJ09QhTbH55Z3SA3Cl5PLWnj-1_5XEg47I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af05k1DZhpAlUSi8XfJgkgTFRvk1KHP2PZSpz7NEMG339Q&oe=69EA0869"}, "display_name": "Tjuhej", "keywords": ["adventure", "storytelling", "playhouse", "paint", "puzzle"], "long_description": "Tjuhej is a story universe where mindful storytelling and thrilling music provides a positive input and time to reflect. Each level starts with a minigame where you must solve a task and figure out how to get to your story. At the end of a level you will get a star and when the door to Playhouse got 3 stars you can unlock this amazing room. When entering Playhouse, you get a whole new world, where you can redecorate, collect rewards and let your imagination fly!\nLevel 1-3 can be played without controller then double tap to move forward and swipe to turn.\nYou should definitely use headphones!\nTjuhej features:\n\u25cf\tMini games - mystery, strategy, puzzles and action.\n\u25cf\tMindful stories with amazing music - binaural beats that relax and rejuvenate\n\u25cf\tCreative Playhouse \u2013 decorate your own playhouse with 2D and 3D painting, listen to music.\n\u25cf\tRewards \u2013 for every three stars, you\u2019ll receive another reward.\nThis update has new levels, a few bug fixes and a tutorial.", "short_description": "Tjuhej is a magical playground for kids and big kids, where you can play fun mini games, meet storytellers from all over the universe, and get your own amazing playhouse. With Tjuhej, a world of excitement is at your fingertips!\nNow new levels 4-9 with new surprises!"}]}, "developer_name": "Minditorium", "developer_privacy_policy_url": "http://www.tjuhej.com/wp-content/uploads/2018/01/Private-Policy-Tjuhej.pdf", "developer_terms_of_service_url": "http://www.tjuhej.com/sample-page/", "publisher_name": "Minditorium", "support_website_url": null, "website_url": "http://www.tjuhej.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "EXPLORATION", "NARRATIVE", "PUZZLE", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "468801428115103"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12410407_2026531734289567_8454582236719611904_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4_zS4JQIpc8Q7kNvwF8ANql&_nc_oc=AdqFiBxwsyJJ1KnF62q4cCfR2ySxaHIHrQZcONAu5MbmMaibH1D_6knuOyLkUIe7Msw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2v0d-OU1ZqURuWBFNbzgSdxHy_UafyPaeMwtAoUf4JqQ&oe=69EA1840"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Tjuhej", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1518026400, "lastRevision": {"nodes": [{"id": "1720304891347691", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1780456281988243", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID"}, "iarc_cert": {"id": "170773177024233"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "migrated_image.png", "id": "2960119317388446", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-3.ocu
2753_170176693581863_3687672969183625216_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VKnCo-FOOuAQ7kNvwFXrj3-&_nc_oc=Adrnm8iwlX9240L4_EwCla79crjllCTuwWHGZzP4VCPEglGk9IWm1rMlh4HiK1CSlrI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9tL0rnpA64XMBDovD9M355ghnyKjCRVC9tdzlGPBX9g&oe=6B030243"}, {"file_name": "migrated_image.png", "id": "2665404563747783", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12427628_944662762348785_9052153139829932032_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X5mxUDzn-VMQ7kNvwG2FKtD&_nc_oc=AdpdmM-wapfMp-j_9ee_IuJ5lYrjuRQKQRhtaSBT_04rgrGI6eTC3c59AYyiHKkUMM0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8_Ef5Thp2nTqEHGwDLzaqgOIXzs2c0i673OT3UBag_g&oe=6B03044A"}, {"file_name": "migrated_image.png", "id": "636416553586309", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162716_1603944873006524_1840643809914912768_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6if7C0qQ12sQ7kNvwGfH34c&_nc_oc=AdocmYx1CJrQCFoebkOOVq6EABxVwB8ZbXa7onkJ9X1SZwUMXYdavPplLR_7LbsJPtQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtZu18MFDZGNxT4uMDJg_xdKpH6CK7CocjKEtvVJz-uQ&oe=6B031F19"}, {"file_name": "migrated_image.png", "id": "141509870580218", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162753_105474883577168_2760768629560573952_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=POIUOqmt4H8Q7kNvwGSfZ_r&_nc_oc=AdrJNoOPmsm7LJadpL0Zg61W0FBz_iQAo_NKlXWcJwJtfHsn01t7TM8l4LjknwdkOWE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRePXe_Z1LcGAvXGFyvmMnetr-h-V3vecSHfVU-vKHUVg&oe=6B031ECA"}, {"file_name": "migrated_image.png", "id": "231039388021951", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162763_1642951579127800_3642216555741184000_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hzWWAgd4gwYQ7kNvwENi5WE&_nc_oc=AdrBTwSyjgxD8tDAmDqLYOg32D_JmyYGbzKlq-If5PMPwBP8Jx90Q3F6Twpan_4BfnE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQToLIJkRlBupUTCmtkGrrdLAG-q-G50rQ09YP3UIk5aCA&oe=6B03049C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store Cover Art Landscape.png", "id": "198798457528467", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162769_198798460861800_90065447017250816_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bVV63LkrpmgQ7kNvwFfvaBp&_nc_oc=Adpf4FUAdALZZNvQpyE2MtYBpx9tu12SnaowB6JzOSk3jEt5_iZGDVswaU7xVPWEJdw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4KLI-z1PPuxRavgaL2uyCowYD-YeOrVRxbsvF2HcYlQ&oe=6B031029"}, "display_name": "Tjuhej", "keywords": ["adventure", "storytelling", "playhouse", "paint", "puzzle"], "long_description": "Tjuhej is a story universe where mindful storytelling and thrilling music provides a positive input and time to reflect. Each level starts with a minigame where you must solve a task and figure out how to get to your story. At the end of a level you will get a star and when the door to Playhouse got 3 stars you can unlock this amazing room. When entering Playhouse, you get a whole new world, where you can redecorate, collect rewards and let your imagination fly!\nLevel 1-3 can be played without controller then double tap to move forward and swipe to turn.\nYou should definitely use headphones!\nTjuhej features:\n\u25cf\tMini games - mystery, strategy, puzzles and action.\n\u25cf\tMindful stories with amazing music - binaural beats that relax and rejuvenate\n\u25cf\tCreative Playhouse \u2013 decorate your own playhouse with 2D and 3D painting, listen to music.\n\u25cf\tRewards \u2013 for every three stars, you\u2019ll receive another reward.\nThis update has new levels, a few bug fixes and a tutorial.", "short_description": "Tjuhej is a magical playground for kids and big kids, where you can play fun mini games, meet storytellers from all over the universe, and get your own amazing playhouse. With Tjuhej, a world of excitement is at your fingertips!\nNow new levels 4-9 with new surprises!"}]}, "developer_name": "Minditorium", "developer_privacy_policy_url": "http://www.tjuhej.com/wp-content/uploads/2018/01/Private-Policy-Tjuhej.pdf", "developer_terms_of_service_url": "http://www.tjuhej.com/sample-page/", "publisher_name": "Minditorium", "support_website_url": null, "website_url": "http://www.tjuhej.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "EXPLORATION", "NARRATIVE", "PUZZLE", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "468801428115103"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12410407_2026531734289567_8454582236719611904_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9UaIgFAi9ZkQ7kNvwG0Paph&_nc_oc=AdpqGx_Qpo5jWamQoe0--gxD4DxUnktsnIBxl9xp4_JesNL46tUEf2pj9leRH7G0Cl4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAg4nQiT5vaIo9_4jOxpErXsShigGS4SxclvRo190g8Q&oe=6B032000"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Tjuhej", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1518026400, "lastRevision": {"nodes": [{"id": "1720304891347691", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "178045628198
2753_170176693581863_3687672969183625216_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JdVKVFKgdgUQ7kNvwG-M4r5&_nc_oc=AdqNrtnO2pK_FwW6GwlXKNUCjw3PMbx5xrnxwfJK5CL35j0oUbd5Fkr71NNq6wdH3O8&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTix6wgZ8HnjaVk1s8r9c8YFlJGNt0PYPOtG1lv3Yi-XA&oe=6AFF0DC3"}, {"file_name": "migrated_image.png", "id": "2665404563747783", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12427628_944662762348785_9052153139829932032_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NwCP1wHrPacQ7kNvwE-VESQ&_nc_oc=AdrSb6jzp9jndtUl_YvDtaFnJ6OBgZbyK-8evzG4JNQj7cqHearVP3WFs01EVg7ieGU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6BISfI8KcPJ7HGF2HD2at0DctfzmpfdaRDrRS4uLBmw&oe=6AFF0FCA"}, {"file_name": "migrated_image.png", "id": "636416553586309", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162716_1603944873006524_1840643809914912768_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fD7JMKRDp2oQ7kNvwFzYBEP&_nc_oc=Adq5sstY8V0uP9YTOgYmpGjfNg-Fb1vv-k7ILQgdFqctIuceFB-ge4ClFcjhuetwPfE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSISwTUTMcgqHBK1UfapBXfVQcJcQpf1xsaMCnF9uG4eg&oe=6AFF2A99"}, {"file_name": "migrated_image.png", "id": "141509870580218", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162753_105474883577168_2760768629560573952_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=La6yduvtYSEQ7kNvwFJwRtx&_nc_oc=AdrMFV5x4DEccCTH8piwU2Ojmd0xB29OQHrfX4VpHqiumXgzsOhk73KiBpTnc-vUbbs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRetSTJ5ykRv9aGXbOpyjHo0p8RFnpWRRy5OQ0CY1XIxA&oe=6AFF2A4A"}, {"file_name": "migrated_image.png", "id": "231039388021951", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162763_1642951579127800_3642216555741184000_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JPEP2e7IWiMQ7kNvwGI7NoP&_nc_oc=AdohPy0ApT4lxf8cV_fUHPB7KvPZckb6lu62NhA4KGQYlkq_ON2-18s5jF22twVryQA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTr-NxVeDf3a0-6OVA4lBUpzAdhsQaVnFVkz1egEmfiBA&oe=6AFF101C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store Cover Art Landscape.png", "id": "198798457528467", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162769_198798460861800_90065447017250816_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f4X--5DWl5UQ7kNvwE0yGxF&_nc_oc=AdpL9xEhh516jyKZn8kg4PpY_Y773EIkY6N50ND_irMURCVjHmFOeI9nFXenzKvC3mQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSoZ3mSpcLAV0VguE5TRyNe3IfX38uqxa5tuFxSGPqfbA&oe=6AFF1BA9"}, "display_name": "Tjuhej", "keywords": ["adventure", "storytelling", "playhouse", "paint", "puzzle"], "long_description": "Tjuhej is a story universe where mindful storytelling and thrilling music provides a positive input and time to reflect. Each level starts with a minigame where you must solve a task and figure out how to get to your story. At the end of a level you will get a star and when the door to Playhouse got 3 stars you can unlock this amazing room. When entering Playhouse, you get a whole new world, where you can redecorate, collect rewards and let your imagination fly!\nLevel 1-3 can be played without controller then double tap to move forward and swipe to turn.\nYou should definitely use headphones!\nTjuhej features:\n\u25cf\tMini games - mystery, strategy, puzzles and action.\n\u25cf\tMindful stories with amazing music - binaural beats that relax and rejuvenate\n\u25cf\tCreative Playhouse \u2013 decorate your own playhouse with 2D and 3D painting, listen to music.\n\u25cf\tRewards \u2013 for every three stars, you\u2019ll receive another reward.\nThis update has new levels, a few bug fixes and a tutorial.", "short_description": "Tjuhej is a magical playground for kids and big kids, where you can play fun mini games, meet storytellers from all over the universe, and get your own amazing playhouse. With Tjuhej, a world of excitement is at your fingertips!\nNow new levels 4-9 with new surprises!"}]}, "developer_name": "Minditorium", "developer_privacy_policy_url": "http://www.tjuhej.com/wp-content/uploads/2018/01/Private-Policy-Tjuhej.pdf", "developer_terms_of_service_url": "http://www.tjuhej.com/sample-page/", "publisher_name": "Minditorium", "support_website_url": null, "website_url": "http://www.tjuhej.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "EXPLORATION", "NARRATIVE", "PUZZLE", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "468801428115103"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12410407_2026531734289567_8454582236719611904_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MVl7F7pP7rYQ7kNvwE74DTR&_nc_oc=AdpfedFErrSKlAy-ifDgAd4r3P6J8jvXQ0CvwOkV3xVXhDnI1JBVscXVvXNpGDNnWq4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdUTuIRuEZnqC37FWU5XsCWHl7FTUFk-IZ8F3J4szh8w&oe=6AFF2B80"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Tjuhej", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1518026400, "lastRevision": {"nodes": [{"id": "1720304891347691", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "178045628198
ent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftPpXd9cSENr4cgtBUEUVlvBsK4wW-L1_RmpNUOOyUzaQ&oe=69A80F83"}, {"file_name": "migrated_image.png", "id": "2665404563747783", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12427628_944662762348785_9052153139829932032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AOGvePDtY_wQ7kNvwE_o4sW&_nc_oc=Adk0NxHbVBrVO2c15H8hsKV643WWnb1E2HzTLH2r_bVTZ8JXaI0ddlY9KfQfE-uDKw4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftXqbi1JBypAiuaWJWXU7CRFcQlLh36uzy2NHSFZVmwGQ&oe=69A8118A"}, {"file_name": "migrated_image.png", "id": "636416553586309", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162716_1603944873006524_1840643809914912768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=myEYVgipjMoQ7kNvwFUBJRK&_nc_oc=AdnlxoAzw1IiRJctq1hKWzqM0FbvYNOUhwAjJcHSYo3XrFz6yytMptz57_r-w7ujyVA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afth5fysAEiOdnyEeeOBGmORh0SIjLuUxFNe8ptS0gjhPw&oe=69A82C59"}, {"file_name": "migrated_image.png", "id": "141509870580218", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162753_105474883577168_2760768629560573952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y9EfsW00mUwQ7kNvwHg0JO6&_nc_oc=Adnc9R7rD4KKcvyroYyTXpo4UpDfDDYgNyfcM2TvaYZnRPsR89Xoi2x80S-hNWi2Jxo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvcevS8V6YLjz_mCOKUAjOqMsE0NpEOKoAuD7HCMH2JIg&oe=69A82C0A"}, {"file_name": "migrated_image.png", "id": "231039388021951", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162763_1642951579127800_3642216555741184000_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eVtCkEGKBQMQ7kNvwHtn46H&_nc_oc=Adm9zVLn1zOv2quXQEdWPGWagqaumZLm4UrgmVD_iOy_llgfShZhM0jeEj-grAh9u-Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftGJ9XMSAa-Ky79-9zjnYrhBK8SHed5gTURIgsc2GhOTg&oe=69A811DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store Cover Art Landscape.png", "id": "198798457528467", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162769_198798460861800_90065447017250816_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8F3G0UJhhEIQ7kNvwEnOG09&_nc_oc=Adkty8M8MKsTl9kzBHiP6vZjAoy_iQOB32UvP2UVcxBzzfjE2vSe_vqYW5XuutcwoJc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvfPwejW7UBy7aHkK1uNKiNdpNqbK1LZymL_mQbYPhsKA&oe=69A81D69"}, "display_name": "Tjuhej", "keywords": ["adventure", "storytelling", "playhouse", "paint", "puzzle"], "long_description": "Tjuhej is a story universe where mindful storytelling and thrilling music provides a positive input and time to reflect. Each level starts with a minigame where you must solve a task and figure out how to get to your story. At the end of a level you will get a star and when the door to Playhouse got 3 stars you can unlock this amazing room. When entering Playhouse, you get a whole new world, where you can redecorate, collect rewards and let your imagination fly!\nLevel 1-3 can be played without controller then double tap to move forward and swipe to turn.\nYou should definitely use headphones!\nTjuhej features:\n\u25cf\tMini games - mystery, strategy, puzzles and action.\n\u25cf\tMindful stories with amazing music - binaural beats that relax and rejuvenate\n\u25cf\tCreative Playhouse \u2013 decorate your own playhouse with 2D and 3D painting, listen to music.\n\u25cf\tRewards \u2013 for every three stars, you\u2019ll receive another reward.\nThis update has new levels, a few bug fixes and a tutorial.", "short_description": "Tjuhej is a magical playground for kids and big kids, where you can play fun mini games, meet storytellers from all over the universe, and get your own amazing playhouse. With Tjuhej, a world of excitement is at your fingertips!\nNow new levels 4-9 with new surprises!"}]}, "developer_name": "Minditorium", "developer_privacy_policy_url": "http://www.tjuhej.com/wp-content/uploads/2018/01/Private-Policy-Tjuhej.pdf", "developer_terms_of_service_url": "http://www.tjuhej.com/sample-page/",
2753_170176693581863_3687672969183625216_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cCVzLzBIfyQQ7kNvwHobH70&_nc_oc=AdrbWrspCzWBxR-_mriv3Zf03eW7dmTOyhogaJWqnZ_7hdJt6Ks5rHWf7a94HACe-Qw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQNQWwpZenYx6DqQ8TKw3ujF0TGDb6iiZYBM5mhjgiVQA&oe=6B0C7503"}, {"file_name": "migrated_image.png", "id": "2665404563747783", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427628_944662762348785_9052153139829932032_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4rKn2KiMD_cQ7kNvwEtYmPq&_nc_oc=AdpEjHQDGHgaXmNJHn9DBDVUc_ed42NtV_HuMGzV3OevjQ3_mbZO_yWbCMSlEV6fceU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRE_gLDT86PT7gvtkxKePrk92Ebe9UhE-Z5-R9VVU1zYw&oe=6B0C770A"}, {"file_name": "migrated_image.png", "id": "636416553586309", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162716_1603944873006524_1840643809914912768_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rr-nlG8qLO8Q7kNvwEZfbyM&_nc_oc=Adoa-XiiYOfwc2IpzIjg02zZYsvPGGe9mV0YhMo_NeJXDZP0Qax0MQ1-B72_hAYHsh0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQREcBxPhNMmuR8dHwxoYwoJzjRj0ZtO3h2oy4LHGi6Hhg&oe=6B0C5999"}, {"file_name": "migrated_image.png", "id": "141509870580218", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162753_105474883577168_2760768629560573952_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Z0GVT0SA60Q7kNvwGSZUHc&_nc_oc=Adq2ucfBs8O7vYsFOia_EAHaurTBiAu2z1sadGLbScRAKaLsHMLPruE5yoOWCb_8SiA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRJ4IJGREPx5dOFYO6WEJDnL2e-Qqz51ZGb7srTU-zsPQ&oe=6B0C594A"}, {"file_name": "migrated_image.png", "id": "231039388021951", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162763_1642951579127800_3642216555741184000_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0t2XWcGRxZMQ7kNvwEGbk68&_nc_oc=Adpul2g0mlRYSbMpW2HqUkQhkQRa84t_2aagi6flPsO02LMudwmRBIT3hAbit3Hwap8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR-fVIVvBnYbVs_n1nywn3VPqZkKO243uUXtZjbDJMh4w&oe=6B0C775C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store Cover Art Landscape.png", "id": "198798457528467", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162769_198798460861800_90065447017250816_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a9_mQCGIwbUQ7kNvwEQSmCh&_nc_oc=Adq1rbbxRu57vERt1oQJJGSIOcrVa_E0zQ0oDRK4Lu6QcQnSd6jgEwfv6pdWFMuoHm8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTd99-eZTVM7L2IXwRDgFjbT2O6NSllxzaMayAu6PnygQ&oe=6B0C82E9"}, "display_name": "Tjuhej", "keywords": ["adventure", "storytelling", "playhouse", "paint", "puzzle"], "long_description": "Tjuhej is a story universe where mindful storytelling and thrilling music provides a positive input and time to reflect. Each level starts with a minigame where you must solve a task and figure out how to get to your story. At the end of a level you will get a star and when the door to Playhouse got 3 stars you can unlock this amazing room. When entering Playhouse, you get a whole new world, where you can redecorate, collect rewards and let your imagination fly!\nLevel 1-3 can be played without controller then double tap to move forward and swipe to turn.\nYou should definitely use headphones!\nTjuhej features:\n\u25cf\tMini games - mystery, strategy, puzzles and action.\n\u25cf\tMindful stories with amazing music - binaural beats that relax and rejuvenate\n\u25cf\tCreative Playhouse \u2013 decorate your own playhouse with 2D and 3D painting, listen to music.\n\u25cf\tRewards \u2013 for every three stars, you\u2019ll receive another reward.\nThis update has new levels, a few bug fixes and a tutorial.", "short_description": "Tjuhej is a magical playground for kids and big kids, where you can play fun mini games, meet storytellers from all over the universe, and get your own amazing playhouse. With Tjuhej, a world of excitement is at your fingertips!\nNow new levels 4-9 with new surprises!"}]}, "developer_name": "Minditorium", "developer_privacy_policy_url": "http://www.tjuhej.com/wp-content/uploads/2018/01/Private-Policy-Tjuhej.pdf", "developer_terms_of_service_url": "http://www.tjuhej.com/sample-page/", "publisher_name": "Minditorium", "support_website_url": null, "website_url": "http://www.tjuhej.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "EXPLORATION", "NARRATIVE", "PUZZLE", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "468801428115103"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410407_2026531734289567_8454582236719611904_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aN_x2Elfcv8Q7kNvwGiIF3G&_nc_oc=AdpZIV58HHOeXhT_rYmSDRIxI1jMFsXXGggJmhLCu9bh8zIUbzdiUZ2-MO_0rBVr1GI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT9OSTnfpDHLkmFrklB1ju80Jfe7atv_xvq5UnZ2D_Reg&oe=6B0C5A80"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Tjuhej", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1518026400, "lastRevision": {"nodes": [{"id": "1720304891347691", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "178045628198
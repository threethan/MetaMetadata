ent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxVXQk-HY06yJ5R2AdTzn6nGo3fXQSiejTNp4RJVeCsaw&oe=69BD2783"}, {"file_name": "migrated_image.png", "id": "2665404563747783", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12427628_944662762348785_9052153139829932032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0PzS6ELWJmoQ7kNvwH_4C78&_nc_oc=AdnIsnen5IEYuOel_lPzz4tJY2f97HMqTRPZxHfE6eKW0s-vRLW4373Fux9id37CUJk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyvAIg-OZ2y0NHmtubKltpHS2PvkWAY73-qduyZidownQ&oe=69BD298A"}, {"file_name": "migrated_image.png", "id": "636416553586309", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162716_1603944873006524_1840643809914912768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JtFr31ShCvcQ7kNvwHj5oS6&_nc_oc=Adnl-HPuk5KUf0XwiDEYULQBJTM5aUkYjFk8ZQILJuXK4gGRdS0_98ykhHUU8qhXolY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyG5RHgrvBZhWutLCSiy78iEifGAFUIRdS5iHmAANab7g&oe=69BD4459"}, {"file_name": "migrated_image.png", "id": "141509870580218", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162753_105474883577168_2760768629560573952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1meBJa5rMy8Q7kNvwEEM71p&_nc_oc=AdkCugVsGt_Q-Gu9zLobNtWMMziu6aR8BZlr6YeHKt11mn57zOOvoHnZOQCJjEfVmhE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyXeuZVlZvgzknq2eT_ao04tA0yfUg5BVheOKyNK6iFMg&oe=69BD440A"}, {"file_name": "migrated_image.png", "id": "231039388021951", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162763_1642951579127800_3642216555741184000_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=smMSdfdCLkAQ7kNvwHDGq5U&_nc_oc=AdnekxNNFpwZC9ejKbMcaagLrda_hy-XJ7MZeOd7y50VeiCqnbotiUmrew81bUaSTNg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw4FdfjvG2YNDehIci3SAVmw4e5Nm-2Mef46SoQ5cPndA&oe=69BD29DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store Cover Art Landscape.png", "id": "198798457528467", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162769_198798460861800_90065447017250816_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WsISJ-dLbigQ7kNvwGVSlvn&_nc_oc=AdlcpPyvCce44oVQEMWyt1iD3_lb-yBbJ_TogYtGpRYZfCnPUx7CojR8BZqxjXQvVxs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxN16FN096NGEPX6DNj5g4ys40c7yAfCrm5sHMHYYMCdg&oe=69BD3569"}, "display_name": "Tjuhej", "keywords": ["adventure", "storytelling", "playhouse", "paint", "puzzle"], "long_description": "Tjuhej is a story universe where mindful storytelling and thrilling music provides a positive input and time to reflect. Each level starts with a minigame where you must solve a task and figure out how to get to your story. At the end of a level you will get a star and when the door to Playhouse got 3 stars you can unlock this amazing room. When entering Playhouse, you get a whole new world, where you can redecorate, collect rewards and let your imagination fly!\nLevel 1-3 can be played without controller then double tap to move forward and swipe to turn.\nYou should definitely use headphones!\nTjuhej features:\n\u25cf\tMini games - mystery, strategy, puzzles and action.\n\u25cf\tMindful stories with amazing music - binaural beats that relax and rejuvenate\n\u25cf\tCreative Playhouse \u2013 decorate your own playhouse with 2D and 3D painting, listen to music.\n\u25cf\tRewards \u2013 for every three stars, you\u2019ll receive another reward.\nThis update has new levels, a few bug fixes and a tutorial.", "short_description": "Tjuhej is a magical playground for kids and big kids, where you can play fun mini games, meet storytellers from all over the universe, and get your own amazing playhouse. With Tjuhej, a world of excitement is at your fingertips!\nNow new levels 4-9 with new surprises!"}]}, "developer_name": "Minditorium", "developer_privacy_policy_url": "http://www.tjuhej.com/wp-content/uploads/2018/01/Private-Policy-Tjuhej.pdf", "developer_terms_of_service_url": "http://www.tjuhej.com/sample-page/",
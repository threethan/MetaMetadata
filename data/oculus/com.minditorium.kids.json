ent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afu9CrsBUtElfLLe-RI2EdydTW68FcrsP6g79E91JFhHmQ&oe=69A96103"}, {"file_name": "migrated_image.png", "id": "2665404563747783", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427628_944662762348785_9052153139829932032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AOGvePDtY_wQ7kNvwFPi-vW&_nc_oc=AdnZnLwch6txKQXTPzgUMrgWuATVTFaz6cFEk9RhnR3rfh51HbxkIWUYpe33sESYztw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsceocSrtib2vBIEu7wyZIu-n696mNjNJHBrltvJJqzUg&oe=69A9630A"}, {"file_name": "migrated_image.png", "id": "636416553586309", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162716_1603944873006524_1840643809914912768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=myEYVgipjMoQ7kNvwECDSnn&_nc_oc=Adk347LmkbXCvuzOhpP64COFsLV2hlu9sYqMQSHxv50T17gF8V6oK9XwN5Z7GxIaoOk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvVdJy0NVtdlmK97LdHbMS2eXM3Uqzr6AXG9Zy3LOoXLw&oe=69A97DD9"}, {"file_name": "migrated_image.png", "id": "141509870580218", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162753_105474883577168_2760768629560573952_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y9EfsW00mUwQ7kNvwFnL0ua&_nc_oc=Adm_i2P-Tyh3Z97Fv0YoGXI711wHnVU5PbLlcF8LRMRtxhfwUurXfC7AbkI6hGMstFI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfugYXnwKeVI9-Dui9RMF5m3BWQRv9u2-RgzxAMbU0HB-g&oe=69A97D8A"}, {"file_name": "migrated_image.png", "id": "231039388021951", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162763_1642951579127800_3642216555741184000_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eVtCkEGKBQMQ7kNvwFp6biG&_nc_oc=AdnKjdxQmnkJcKECIZ_ArxpqvQ2EEsSQ67iZ9Q-Xr1p6Tk8AQo2_3peNeJrKsxdOO5M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfuR5wT9HFdFSya_8GhG1rpmQ34yUuD2P9KZEU-ZtXXHmQ&oe=69A9635C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store Cover Art Landscape.png", "id": "198798457528467", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162769_198798460861800_90065447017250816_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8F3G0UJhhEIQ7kNvwFzniYi&_nc_oc=AdkHcdg0LySOnaTCLGF08f3WitFEeS2XQ2s8uZ5OR4tzGG_znkpkh5Y54p7AF_1YEcU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afu1GfA6pck5zrzUkKXHDgB_MMRIZs8HjfvHxP82tNulQw&oe=69A96EE9"}, "display_name": "Tjuhej", "keywords": ["adventure", "storytelling", "playhouse", "paint", "puzzle"], "long_description": "Tjuhej is a story universe where mindful storytelling and thrilling music provides a positive input and time to reflect. Each level starts with a minigame where you must solve a task and figure out how to get to your story. At the end of a level you will get a star and when the door to Playhouse got 3 stars you can unlock this amazing room. When entering Playhouse, you get a whole new world, where you can redecorate, collect rewards and let your imagination fly!\nLevel 1-3 can be played without controller then double tap to move forward and swipe to turn.\nYou should definitely use headphones!\nTjuhej features:\n\u25cf\tMini games - mystery, strategy, puzzles and action.\n\u25cf\tMindful stories with amazing music - binaural beats that relax and rejuvenate\n\u25cf\tCreative Playhouse \u2013 decorate your own playhouse with 2D and 3D painting, listen to music.\n\u25cf\tRewards \u2013 for every three stars, you\u2019ll receive another reward.\nThis update has new levels, a few bug fixes and a tutorial.", "short_description": "Tjuhej is a magical playground for kids and big kids, where you can play fun mini games, meet storytellers from all over the universe, and get your own amazing playhouse. With Tjuhej, a world of excitement is at your fingertips!\nNow new levels 4-9 with new surprises!"}]}, "developer_name": "Minditorium", "developer_privacy_policy_url": "http://www.tjuhej.com/wp-content/uploads/2018/01/Private-Policy-Tjuhej.pdf", "developer_terms_of_service_url": "http://www.tjuhej.com/sample-page/",
1867920503863_1620445226026681549_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sKQPcJOBlC4Q7kNvwG10ehz&_nc_oc=AdokaSfzogFfRQiC7CmYGxtRtRtje7WmG596gWZhGVi8-2Nia5h4-mvrSBxEShtkdFk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRx8X5RlPbLxCvAXjkcJgT_wxVgrFqPhzDhOb6hDCR1WA&oe=6AE9FEED"}, {"file_name": "05.png", "id": "1128519878133341", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031373_1128519881466674_8323235063697067211_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8jMztoG8B68Q7kNvwGqgqpk&_nc_oc=Adp9yVVI9EIjswxP4p9TD5B8BBvwRfS-W2rbn17mgUiQWcuiGXnMSjWfe1YbptBInKw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-RFaXsa5Eldbbdwths5G2NG7TSPDKwYlYNpRicIxSrA&oe=6AEA010B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScaryMineTrailerEdit01.00_00_44_03.Still001.png", "id": "862709658668266", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036610_862709662001599_2821859789789372133_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l5CRPZcd6UUQ7kNvwFDAw4A&_nc_oc=Adp1QL5B7jtp0aW82NotUjsHR6vI61bx0Whg64ok939a8feygb9ue9_5QpvqToUfmq0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSM-cjQofmgQVMEvoGJfEoOa_2rnKqG2GiVqAipTcyM5Q&oe=6AEA0CD6"}, "display_name": "Scary Mine", "keywords": [], "long_description": "\"Scary Mine\" is a groundbreaking virtual reality horror game that beckons players into the haunting recesses of a long-forgotten mine, shrouded in mystery. Boasting lifelike graphics and intricately detailed environments, the game aims to seamlessly blur the lines between virtual and reality, immersing players in an unforgettable experience.\n\nSet against the backdrop of dimly lit tunnels and foreboding chambers, \"Scary Mine\" presents players with a challenging mission to solve enigmatic occurrences and navigate the treacherous depths to survive. The game's dynamic narrative unfolds through a series of tasks and puzzles, encouraging players to make split-second decisions that shape the outcome of their journey.\n\nThe immersive atmosphere is heightened by atmospheric sound effects, ensuring that players feel the palpable tension with every step. \"Scary Mine\" is designed to provide a visceral and heart-pounding encounter with fear, as players confront their darkest fears in the unrelenting darkness of the mine.", "short_description": "\"Scary Mine\" is an immersive virtual reality horror game that plunges players into the eerie confines of an abandoned mine. With realistic graphics, spine-chilling sound effects, and split-second decision-making, players will unravel the unknown horrors lurking in the darkness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1wXW4Hyq5Rqr6HxU8MEokie4qwH6c4Wz9/view?usp=share_link", "developer_terms_of_service_url": null, "publisher_name": "Simofun", "support_website_url": null, "website_url": "https://www.simofun.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8963404830414960"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1209796783888217"}, {"status": "CANCELLED", "id": "1275989193694198"}, {"status": "PUBLISHED", "id": "1535843177161715"}]}, "baseline_offer": {"id": "1209796783888217"}, "is_approved": true, "firstOffer": {"nodes": [{"start_tim
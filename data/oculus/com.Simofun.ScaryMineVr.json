uCvLUelXDfKuavseBaWo-LP_AhIiceCvbg3tb0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuqUDhaeMkqn_6_BqKht2cjOgC5J7K0XDEqP1yDdW0faw&oe=69A2D2AD"}, {"file_name": "05.png", "id": "1128519878133341", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031373_1128519881466674_8323235063697067211_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Gx33-SiUM4Q7kNvwFIMIhH&_nc_oc=Adm6dS7fZ7CXk-QHy1NqIx1_cQAlnWBW4I-BG7Wn54QBv9QWUlfOW9beshg2EwedKDo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsArqSVo6Cz1dPVE2jXSkx9O19lyqk3-eiJlYL3KApjhA&oe=69A2D4CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScaryMineTrailerEdit01.00_00_44_03.Still001.png", "id": "862709658668266", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036610_862709662001599_2821859789789372133_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oEQNN3aLVc0Q7kNvwHOFeAZ&_nc_oc=Adm0W-T1F46NLJ8zH1rh-RxSBf4MzTmi56PYwo6YoneMtH_n-p-FSREfCL-jY0z2dEQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftAuET6oG4vpoj2KOWghq5ei0wBLzCzXta4c8VerLdOIg&oe=69A2E096"}, "display_name": "Scary Mine", "keywords": [], "long_description": "\"Scary Mine\" is a groundbreaking virtual reality horror game that beckons players into the haunting recesses of a long-forgotten mine, shrouded in mystery. Boasting lifelike graphics and intricately detailed environments, the game aims to seamlessly blur the lines between virtual and reality, immersing players in an unforgettable experience.\n\nSet against the backdrop of dimly lit tunnels and foreboding chambers, \"Scary Mine\" presents players with a challenging mission to solve enigmatic occurrences and navigate the treacherous depths to survive. The game's dynamic narrative unfolds through a series of tasks and puzzles, encouraging players to make split-second decisions that shape the outcome of their journey.\n\nThe immersive atmosphere is heightened by atmospheric sound effects, ensuring that players feel the palpable tension with every step. \"Scary Mine\" is designed to provide a visceral and heart-pounding encounter with fear, as players confront their darkest fears in the unrelenting darkness of the mine.", "short_description": "\"Scary Mine\" is an immersive virtual reality horror game that plunges players into the eerie confines of an abandoned mine. With realistic graphics, spine-chilling sound effects, and split-second decision-making, players will unravel the unknown horrors lurking in the darkness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1wXW4Hyq5Rqr6HxU8MEokie4qwH6c4Wz9/view?usp=share_link", "developer_terms_of_service_url": null, "publisher_name": "Simofun", "support_website_url": null, "website_url": "https://www.simofun.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8963404830414960"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1209796783888217"}, {"status": "CANCELLED", "id": "1275989193694198"}, {"status": "PUBLISHED", "id": "1535843177161715"}]}, "baseline_offer": {"id": "1209796783888217"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1744830180, "status": "PUBLISHED", "id": "1209796783888217"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nod
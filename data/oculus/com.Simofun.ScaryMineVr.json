Rpstr3yYuJyDUmM_8mo9OdHge2b_AUbYmacI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXOI-C9RZYP9q4lTJIOlqWM-IFheTTuLNnwUQhW0cqoQw&oe=6B10662B"}, {"file_name": "03.png", "id": "1071867917170530", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974794_1071867920503863_1620445226026681549_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_kGjK8XLFlQQ7kNvwHJrRcL&_nc_oc=Adpdxd9dkJTiqOJF6FIDXklfX44C4hMblAWuCu9cWoUtUVK6dlSCoASRlUPDQJ07AWo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVqNt6cQIMuQicY6pGzsqFAvImtVtkx33GvQhwrC5Twaw&oe=6B103A6D"}, {"file_name": "05.png", "id": "1128519878133341", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031373_1128519881466674_8323235063697067211_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_C30NGkyXMUQ7kNvwHoNJCQ&_nc_oc=AdrEQ5cWrleSo9Vc9iVd57Edf1gFdCV5HxLYkt4TJG6yqNut2P38HEmmY-EtU4qwJmM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXALCHVra55ra5X2Co1-u-FRFpFpW3FhR-V1966u6VSnw&oe=6B103C8B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScaryMineTrailerEdit01.00_00_44_03.Still001.png", "id": "862709658668266", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036610_862709662001599_2821859789789372133_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2BAdLSBrGrEQ7kNvwHDThaj&_nc_oc=AdrvFDc7pPDuDcJy9AY5UDIIQVwUQs10aRPy3b2o6649VGHgP81JpA-EIRGXntIsioo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUCIqK339PFzHpMRN8rRch-OEv8RjH6E_tVJa33hABMUA&oe=6B104856"}, "display_name": "Scary Mine", "keywords": [], "long_description": "\"Scary Mine\" is a groundbreaking virtual reality horror game that beckons players into the haunting recesses of a long-forgotten mine, shrouded in mystery. Boasting lifelike graphics and intricately detailed environments, the game aims to seamlessly blur the lines between virtual and reality, immersing players in an unforgettable experience.\n\nSet against the backdrop of dimly lit tunnels and foreboding chambers, \"Scary Mine\" presents players with a challenging mission to solve enigmatic occurrences and navigate the treacherous depths to survive. The game's dynamic narrative unfolds through a series of tasks and puzzles, encouraging players to make split-second decisions that shape the outcome of their journey.\n\nThe immersive atmosphere is heightened by atmospheric sound effects, ensuring that players feel the palpable tension with every step. \"Scary Mine\" is designed to provide a visceral and heart-pounding encounter with fear, as players confront their darkest fears in the unrelenting darkness of the mine.", "short_description": "\"Scary Mine\" is an immersive virtual reality horror game that plunges players into the eerie confines of an abandoned mine. With realistic graphics, spine-chilling sound effects, and split-second decision-making, players will unravel the unknown horrors lurking in the darkness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1wXW4Hyq5Rqr6HxU8MEokie4qwH6c4Wz9/view?usp=share_link", "developer_terms_of_service_url": null, "publisher_name": "Simofun", "support_website_url": null, "website_url": "https://www.simofun.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_inte
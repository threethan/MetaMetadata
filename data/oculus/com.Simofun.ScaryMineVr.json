NHP3jmN-dnx7QvUGD5y-g_FGvqHbXotc3aA8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqiGmxrRIID-bnIHKX1GWMltL9ZklZBbAM_v8k8u7pBw&oe=6B09CEAB"}, {"file_name": "03.png", "id": "1071867917170530", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974794_1071867920503863_1620445226026681549_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Upw8PcivTYAQ7kNvwHZYunz&_nc_oc=AdrZ8zlDYTX5r2PRzNNr56sM6gwSxehDhZv0zrVK6qvZ6-BR_lM8Jzgg_q81oij_JLA&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdYDP9dVUrcP4X0U0Mx_MEVBuGmkBbcgsKhrBMxZrG8Q&oe=6B09A2ED"}, {"file_name": "05.png", "id": "1128519878133341", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031373_1128519881466674_8323235063697067211_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2DyUYoz7_B4Q7kNvwHObS26&_nc_oc=Ado6Vvj2eWakMv3RkJzqlRQDqORZb5d0iqbGA3NmmcdD9jd-25NwtOO7uztx3B5OOLY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMKIPSg0SE0-HnCGnnIxbtD_1KRj2-kix25-ARD582cw&oe=6B09A50B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScaryMineTrailerEdit01.00_00_44_03.Still001.png", "id": "862709658668266", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036610_862709662001599_2821859789789372133_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FqqqqUcIoJwQ7kNvwHwnjN_&_nc_oc=AdoGPOZ7Vga6aKCHpesRR6kCv3VLzFWxlwrKB2QA0S6ir_IDh9ilMBCYExXz-S_44bU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQEnlf8tASp5VLpgSEiFoF94eU1c0fun9I-iD7dZEZCA&oe=6B09B0D6"}, "display_name": "Scary Mine", "keywords": [], "long_description": "\"Scary Mine\" is a groundbreaking virtual reality horror game that beckons players into the haunting recesses of a long-forgotten mine, shrouded in mystery. Boasting lifelike graphics and intricately detailed environments, the game aims to seamlessly blur the lines between virtual and reality, immersing players in an unforgettable experience.\n\nSet against the backdrop of dimly lit tunnels and foreboding chambers, \"Scary Mine\" presents players with a challenging mission to solve enigmatic occurrences and navigate the treacherous depths to survive. The game's dynamic narrative unfolds through a series of tasks and puzzles, encouraging players to make split-second decisions that shape the outcome of their journey.\n\nThe immersive atmosphere is heightened by atmospheric sound effects, ensuring that players feel the palpable tension with every step. \"Scary Mine\" is designed to provide a visceral and heart-pounding encounter with fear, as players confront their darkest fears in the unrelenting darkness of the mine.", "short_description": "\"Scary Mine\" is an immersive virtual reality horror game that plunges players into the eerie confines of an abandoned mine. With realistic graphics, spine-chilling sound effects, and split-second decision-making, players will unravel the unknown horrors lurking in the darkness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1wXW4Hyq5Rqr6HxU8MEokie4qwH6c4Wz9/view?usp=share_link", "developer_terms_of_service_url": null, "publisher_name": "Simofun", "support_website_url": null, "website_url": "https://www.simofun.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_inte
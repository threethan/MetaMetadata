ame itself.", "short_description": "This app provides ability to pair your treadmill with the sensors, and swap paired shoes without need to access to PC.\n\nNote: this app is only sets up the hardware and manages treadmill pairing with it sensors. This app is NOT a treadmill controller nor a game itself."}]}, "developer_name": null, "developer_privacy_policy_url": "https://datacompboy.dev/", "developer_terms_of_service_url": null, "publisher_name": "datacompboy", "support_website_url": null, "website_url": "https://datacompboy.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24037018169306495"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031596_1272319343985916_303409703703305803_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UVcj5oZTXAEQ7kNvwHS7lGM&_nc_oc=AdpVWmJ42dB4PhAC_2xArnZBiAPDqLDczv7noSLyAS-KCdMLYQHXnAlAR2nzZtUyd84&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRy50T7RFycT6D1VKOKRHJGDV-tajFfgk9tzAHPuOQVZg&oe=6B0C6DE8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Unofficial KAT-VR Companion App", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Utilities",
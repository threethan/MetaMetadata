ame itself.", "short_description": "This app provides ability to pair your treadmill with the sensors, and swap paired shoes without need to access to PC.\n\nNote: this app is only sets up the hardware and manages treadmill pairing with it sensors. This app is NOT a treadmill controller nor a game itself."}]}, "developer_name": null, "developer_privacy_policy_url": "https://datacompboy.dev/", "developer_terms_of_service_url": null, "publisher_name": "datacompboy", "support_website_url": null, "website_url": "https://datacompboy.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24037018169306495"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031596_1272319343985916_303409703703305803_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UVcj5oZTXAEQ7kNvwEAj3TH&_nc_oc=AdpZwaQYJYzh2JQMdceUShESLR39OqXVrsha76hwGLD-UgSicdMscgPso2O_tHTRmZE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS0vgzn57utU4z6zUSq6IrOXame72P77NHeq6TfPX-nEQ&oe=6B0DBF68"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Unofficial KAT-VR Companion App", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Utilities",
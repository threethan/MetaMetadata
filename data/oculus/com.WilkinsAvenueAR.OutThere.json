.oculuscdn.com/v/t64.5771-25/39036645_819642420154919_5213770894862090542_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m7U8Zm8Qqh4Q7kNvwHgyQA_&_nc_oc=Adom1BajRjY4MzHIdrB2AbY54RS17SD3nf-EE3MI8ShjY0it3OjKYoxY8Jg8iLjgqiM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPb9ZGsww5--4i7qH284v9efuu_GQAlDr9dTqW3jP1ARA&oe=6AC8FBDE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeV2.png", "id": "8404126199630691", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974886_8404126202964024_113125977374139482_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yHioB29wAIUQ7kNvwH_-R5m&_nc_oc=AdrOK_x4sUKTLFFhLe4frvO39JsWgEbOrJfoxbHBmtLFnaGf4l8JXwST1TP2IDjJsEQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNdyhska4ZrijExLaMCVxrvzxKqySyUITz3aVrE1NYptg&oe=6AC8EB19"}, "display_name": "Out There", "keywords": ["Musical", "Animation", "AR", "MR", "Immersive"], "long_description": "\"Out There\" - A Pioneering Immersive Musical Experience on Meta Quest 3\n\nStep into a new dimension of entertainment with \"Out There,\" the world's first immersive musical designed exclusively for Meta Quest 3. Crafted by the visionary team at Wilkins Avenue AR, this experience redefines storytelling by merging advanced spatial computing technology with emotionally resonant narratives.\n\n\"Out There\" showcases the exceptional voice talent of Grammy and Emmy-nominated artist Vanessa Williams, and is produced in collaboration with Pollen Music Group. Leveraging spatial audio and an innovative mix of 3D and traditional Disney-style 2D animation, this musical envelops you in a captivating, multi-dimensional world.\n\nEmbark on a magical journey that transcends traditional entertainment, and discover the future of immersive experiences with \"Out There.\" Available now on Meta Quest 3.", "short_description": "\"Out There\" - A Pioneering Immersive Musical Experience on Meta Quest 3\n\nEmbark on a magical journey that transcends tra
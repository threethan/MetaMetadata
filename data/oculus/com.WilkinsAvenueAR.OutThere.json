.oculuscdn.com/v/t64.5771-25/39036645_819642420154919_5213770894862090542_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hBlCMSdFHlwQ7kNvwFLuS90&_nc_oc=AdpJHDJ4-gwztd5kPi0W5gQ6B4jOLpMuBXwe86HL9LVH2m6xYAp0DkBPXzFLv1M61-A&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0YQjsJabnE7jC5MQ_2T2xyNU2OEhkFcU8Gl8Y3Th7LZQ&oe=69F4BA5E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeV2.png", "id": "8404126199630691", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974886_8404126202964024_113125977374139482_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M4nh-dh-wRMQ7kNvwEq6m7x&_nc_oc=AdptUSvg4EJLqJp1XpmfQB3KROZ4IXANwAGUctx0htakZDeobnYChBI8kjoQnyx35B0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1J_ABSj6r8dvaV55C5QqI0q54h4dx11pXpyaNo_QHekQ&oe=69F4A999"}, "display_name": "Out There", "keywords": ["Musical", "Animation", "AR", "MR", "Immersive"], "long_description": "\"Out There\" - A Pioneering Immersive Musical Experience on Meta Quest 3\n\nStep into a new dimension of entertainment with \"Out There,\" the world's first immersive musical designed exclusively for Meta Quest 3. Crafted by the visionary team at Wilkins Avenue AR, this experience redefines storytelling by merging advanced spatial computing technology with emotionally resonant narratives.\n\n\"Out There\" showcases the exceptional voice talent of Grammy and Emmy-nominated artist Vanessa Williams, and is produced in collaboration with Pollen Music Group. Leveraging spatial audio and an innovative mix of 3D and traditional Disney-style 2D animation, this musical envelops you in a captivating, multi-dimensional world.\n\nEmbark on a magical journey that transcends traditional entertainment, and discover the future of immersive experiences with \"Out There.\" Available now on Meta Quest 3.", "short_description": "\"Out There\" - A Pioneering Immersive Musical Experience on Meta Quest 3\n\nEmbark on a magical journey that transcends tra
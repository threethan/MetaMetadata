.oculuscdn.com/v/t64.5771-25/39036645_819642420154919_5213770894862090542_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x_zIsPnmTn8Q7kNvwFzRZMP&_nc_oc=AdqW2UdGnpT6V9O7l6kCw_zHgjU4iiF_9RJtBf9D5tsXGtP63LWU8Kq5pIsDZCu7r-M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAtIuZfJ93OaJNXytKiiU0dcgj_A8JVZXMuYLzFcJuhOA&oe=6A6E045E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeV2.png", "id": "8404126199630691", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974886_8404126202964024_113125977374139482_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mOhrPVNC0ZcQ7kNvwFaEOA8&_nc_oc=AdrMLwMej3MhvRTNSiG_VcNEn9M8yUDv5VTt7DL6dRPaJ78PdNTyCfeuUu8rJsUnP0Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAB1KRh8ZbFRIZA0FlvOfXceqrIyydTAA3ILHdxUFqeOQ&oe=6A6DF399"}, "display_name": "Out There", "keywords": ["Musical", "Animation", "AR", "MR", "Immersive"], "long_description": "\"Out There\" - A Pioneering Immersive Musical Experience on Meta Quest 3\n\nStep into a new dimension of entertainment with \"Out There,\" the world's first immersive musical designed exclusively for Meta Quest 3. Crafted by the visionary team at Wilkins Avenue AR, this experience redefines storytelling by merging advanced spatial computing technology with emotionally resonant narratives.\n\n\"Out There\" showcases the exceptional voice talent of Grammy and Emmy-nominated artist Vanessa Williams, and is produced in collaboration with Pollen Music Group. Leveraging spatial audio and an innovative mix of 3D and traditional Disney-style 2D animation, this musical envelops you in a captivating, multi-dimensional world.\n\nEmbark on a magical journey that transcends traditional entertainment, and discover the future of immersive experiences with \"Out There.\" Available now on Meta Quest 3.", "short_description": "\"Out There\" - A Pioneering Immersive Musical Experience on Meta Quest 3\n\nEmbark on a magical journey that transcends tra
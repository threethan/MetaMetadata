.oculuscdn.com/v/t64.5771-25/39036645_819642420154919_5213770894862090542_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WAu2gDFSh6EQ7kNvwEhfMOx&_nc_oc=AdoQKGKBel5amKYU38UoXJinC9JtXegENeUToVEAbtIz_KtFmqCigU3YxECtgpbwZLI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEIrTW7x81FIZfI-CbweV0CztfchAeZe51AtheksPn2aQ&oe=6A95C99E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeV2.png", "id": "8404126199630691", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974886_8404126202964024_113125977374139482_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-QyCkDRqy4wQ7kNvwHF1bhl&_nc_oc=Adr_l4VENd_KYtE0FYhgDkHXPx3R4nBYXuXr2akAMN8XiQv5WOlNmz-F7JJewPwB8Hk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSN9hGHdIn8cd9LahIRO96z6cAWOh1q0OHlmxmiK6U5Q&oe=6A95B8D9"}, "display_name": "Out There", "keywords": ["Musical", "Animation", "AR", "MR", "Immersive"], "long_description": "\"Out There\" - A Pioneering Immersive Musical Experience on Meta Quest 3\n\nStep into a new dimension of entertainment with \"Out There,\" the world's first immersive musical designed exclusively for Meta Quest 3. Crafted by the visionary team at Wilkins Avenue AR, this experience redefines storytelling by merging advanced spatial computing technology with emotionally resonant narratives.\n\n\"Out There\" showcases the exceptional voice talent of Grammy and Emmy-nominated artist Vanessa Williams, and is produced in collaboration with Pollen Music Group. Leveraging spatial audio and an innovative mix of 3D and traditional Disney-style 2D animation, this musical envelops you in a captivating, multi-dimensional world.\n\nEmbark on a magical journey that transcends traditional entertainment, and discover the future of immersive experiences with \"Out There.\" Available now on Meta Quest 3.", "short_description": "\"Out There\" - A Pioneering Immersive Musical Experience on Meta Quest 3\n\nEmbark on a magical journey that transcends tra
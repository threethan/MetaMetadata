54919_5213770894862090542_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uyxp10NhruwQ7kNvwEop0Ab&_nc_oc=AdkgFtvKsRYWg52iWNuszCRmEMwe7rninPIWcZOHxnpRjaj_l7jbGcSHH6-Jfq7g0jg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxH0bgQLUAtEbJH_LH4rVf8kflY6ReLdM-pHVeAruWrLg&oe=69B8155E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeV2.png", "id": "8404126199630691", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974886_8404126202964024_113125977374139482_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7WoZfOL_5k8Q7kNvwHKguE4&_nc_oc=AdmR-eXhxvwMuAM9F3k--bpBX417fj5cgeHeG3QIcOoPUmWkJp2tnxn7OtOQpc5JLvs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyN28M-fk9KwLiwoV1ZAB5PuL_NUleDYpr3cQeQqjwaXQ&oe=69B80499"}, "display_name": "Out There", "keywords": ["Musical", "Animation", "AR", "MR", "Immersive"], "long_description": "\"Out There\" - A Pioneering Immersive Musical Experience on Meta Quest 3\n\nStep into a new dimension of entertainment with \"Out There,\" the world's first immersive musical designed exclusively for Meta Quest 3. Crafted by the visionary team at Wilkins Avenue AR, this experience redefines storytelling by merging advanced spatial computing technology with emotionally resonant narratives.\n\n\"Out There\" showcases the exceptional voice talent of Grammy and Emmy-nominated artist Vanessa Williams, and is produced in collaboration with Pollen Music Group. Leveraging spatial audio and an innovative mix of 3D and traditional Disney-style 2D animation, this musical envelops you in a captivating, multi-dimensional world.\n\nEmbark on a magical journey that transcends traditional entertainment, and discover the future of immersive experiences with \"Out There.\" Available now on Meta Quest 3.", "short_description": "\"Out There\" - A Pioneering Immersive Musical Experience on Meta Quest 3\n\nEmbark on a magical journey that transcends traditional entertainment, and discover the future of immersive experiences with \"Out There.\" Available now on Meta Quest 3."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fr.wilkins-avenue.com/out-there-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Wilkins Avenue AR", "support_website_url": null, "website_url": "https://www.wilkins-avenue.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8147786528646969"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "495792250049077"}]}, "baseline_offer": {"id": "495792250049077"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1726472340, "status": "PUBLISHED", "id": "495792250049077"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8227002430725378", "version": "1.1"}, "id": "1039124994252364", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8147786508646971", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8227002430725378"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1039124994252364"}]}, "change_log": null, "created_date": 172649
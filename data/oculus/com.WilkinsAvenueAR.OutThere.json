m2NMbrKIvQJp6p2OTFCUXONp8i1J-KxXVJnWiJ6GzZ4redGTbubNJBKBFPeAg07kA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvBM2otULlzrTA6HETxHa8HzVDhEEtV4buML6i77EKJXQ&oe=69A6F1DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeV2.png", "id": "8404126199630691", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974886_8404126202964024_113125977374139482_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CPVWNOuA2SQQ7kNvwFdy-ex&_nc_oc=AdnIutQxakwRDseLzyDV2x2zrOGbknyRJoAuCHU_fDOhr_nhILbJ3CYQw5-fa2zx_iY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvE0KcfCvoliaMEleagiIjEsqhWmJf_mLT3Xi7AWVL0ew&oe=69A6E119"}, "display_name": "Out There", "keywords": ["Musical", "Animation", "AR", "MR", "Immersive"], "long_description": "\"Out There\" - A Pioneering Immersive Musical Experience on Meta Quest 3\n\nStep into a new dimension of entertainment with \"Out There,\" the world's first immersive musical designed exclusively for Meta Quest 3. Crafted by the visionary team at Wilkins Avenue AR, this experience redefines storytelling by merging advanced spatial computing technology with emotionally resonant narratives.\n\n\"Out There\" showcases the exceptional voice talent of Grammy and Emmy-nominated artist Vanessa Williams, and is produced in collaboration with Pollen Music Group. Leveraging spatial audio and an innovative mix of 3D and traditional Disney-style 2D animation, this musical envelops you in a captivating, multi-dimensional world.\n\nEmbark on a magical journey that transcends traditional entertainment, and discover the future of immersive experiences with \"Out There.\" Available now on Meta Quest 3.", "short_description": "\"Out There\" - A Pioneering Immersive Musical Experience on Meta Quest 3\n\nEmbark on a magical journey that transcends traditional entertainment, and discover the future of immersive experiences with \"Out There.\" Available now on Meta Quest 3."}]}, "developer_name": null, "developer_privacy_policy_url
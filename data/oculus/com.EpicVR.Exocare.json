HPJZyY&_nc_oc=AdoyZrvsNFE7clala5YHB5uGreVlJ2ktP7pR9Ty297KGFmQGEtOjrPugS6ySav0G32Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUu2WL-ZClBpNXuPM9aPTNanVEaMSZOuQQB3MXJNq8qvg&oe=6B106643"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ExoCare", "keywords": [], "long_description": "The app provides opportunity to relax and unwind by providing the set of neck exercises. By navigating underwater environment, you collect points by swimming through hoops. You steer by looking - simply look where you need to go! Stretch your neck and relax.", "short_description": "Escape the stresses of your sedentary workday with our immersive VR relaxation app, \"ExoCare.\" Dive into the serene underwater world and collect points effortlessly by simply moving your head \u2013 wherever you look, you'll go. Immerse yourself in the calming depths, explore vibrant coral reefs. Let ExoCare be your portal to relaxation and mindfulness in the comfort of your own space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://epicvr.pl/en/exocare-privacy/", "developer_terms_of_service_url": null, "publisher_name": "Jakub Osi\u0144ski", "support_website_url": null, "website_url": "https://epicvr.pl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pl"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6564408917007456"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39
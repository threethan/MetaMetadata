8714465381", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499312454_2263348717798714_4893010851948074891_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y_S0FcyPeLkQ7kNvwGr619U&_nc_oc=Ado3qzo_HVGHUZN2NITo2QZKKCQ6jrctGxWuZPpZh9x2rAlbYQB6-hIneJwP7wfD-18&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJhwkQfjj6DRC6za4veZW-3Dg8248gTacihV4hIjzfvpQ&oe=6ABA6805"}, {"file_name": "Starscream and his Seekers.png", "id": "1084416910820258", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499312332_1084416914153591_7676104511537261799_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RutrYG0tFH4Q7kNvwEcMlEe&_nc_oc=AdpLIfwWqa6ljNspsuS3k6a3ZZHGMS4eoBIcIF8G3FD0TTyEXEcHid9c-UIVXqbh_UM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLcnQv5-t-dEOlmBpAJGFD24JgMin4Qz591r9mzyweE2g&oe=6ABA8CAC"}, {"file_name": "Bumblebee.png", "id": "27484474034581428", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/618758916_27484474037914761_8689132552829532106_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dg24L6zOKykQ7kNvwHP-kZR&_nc_oc=AdpokzL6ESnwMa9fOpPFsOfDSVtdGU31mzRpoStemIpx7PHybAVS__VpEpd-wAS50IE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKcfMjg72KWiLmIhzrY_q1Bdk__0_gR_us8kTK95iPccA&oe=6ABA8296"}, {"file_name": "Megatron vs Optimus 01.png", "id": "920432357785892", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499314641_920432361119225_7169613079597462880_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WwMYjQyc1QAQ7kNvwGw7ySc&_nc_oc=AdoqHSlsaXVz1R_lwY7shvjKmb4PF2qHAesf3WezhOjBP7QoPloKX3wvfdmFbTcpC-8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKy7AJZChoxETtMcLhw5wtZBv1RgEqIBH4hzTEaFocHsw&oe=6ABA5F8C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Couverture paysage.png", "id": "2177038996559177", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/507883442_2177038999892510_5252610264766666385_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qwolOMkDCGEQ7kNvwHpKl-k&_nc_oc=Adr9IGyYfoe7l4p15Jo0jlHTn8lWuV93jx_CtlqwfHFwShvmfE3Gl-IzHFB_O5Tlkvg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfX-Ho8PPLeXRvtiHmQFjfntpTuyY1aKn3DpmQL1061Q&oe=6ABA667B"}, "display_name": "Transformers Beyond Reality Redux", "keywords": ["transformers"], "long_description": "# Join the Autobots in an arcade-style, on-rails VR shooter set in the Transformers universe.                                                                                                                                                                                                                                                               \n\nPlay as a human recruit fighting alongside Optimus Prime, Bumblebee, Grimlock, and the Autobots as they battle Megatron and the Decepticons across Earth and Cybertron.\n\nBlast through powerful enemy forces, unlock new abilities, take on towering bosses, and help save Earth from destruction.\n\n{1017734821263058}\n**Fight Alongside the Autobots**\n\nJoin the Autobots on the front lines of the war against the Decepticons and fight beside some of the most iconic characters in Transformers history.\n\n{2255661398590182}\n**Battle Legendary Decepticons**\n\nTake on powerful Decepticon commanders as each battle pushes you deeper into the war for Earth.\n\n{27848004054826113}\n**Arcade Shooter Action**\n\nInspired by classic arcade shooters, dodge incoming attacks, unleash powerful weapons, and carve a path through the Decepticon forces. \n\n**Journey Beyond Earth**\n\nLeave Earth behind and experience the home world of the Transformers for yourself.", "short_description": "Join the Autobots in an arcade-style, on-rails VR shooter set in the Transformers universe."}, {"images": {"nodes": []}, "id": "1873774393594085", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Transformers Beyond Reality Redux", "keywords": ["transformers"], "long_description": "# Joignez les Autobots dans un jeu de tir en r\u00e9alit\u00e9 virtuelle sur rails, inspir\u00e9 des classiques d'arcade, se d\u00e9roulant dans l'univers de Transformers.\n\nIncarnez une recrue humaine qui combat aux c\u00f4t\u00e9s d'Optimus Prime, Bumblebee, Grimlock et des Autobots dans une guerre contre Megatron et les Decepticons \u00e0 travers la Terre et Cybertron.\n\nAffrontez de redoutables vagues d'ennemis, d\u00e9bloquez de nouvelles capacit\u00e9s, terrassez des boss gigantesques et contribuez \u00e0 sauver la Terre de la destruction.\n\n**Combattez aux c\u00f4t\u00e9s des Autobots**\n\nRejoignez les Autobots sur la ligne de front dans leur guerre contre les Decepticons et combattez aux c\u00f4t\u00e9s de certains des personnages les plus embl\u00e9matiques de l'histoire de Transformers.\n\n**Affrontez les Decepticons l\u00e9gendaires**\n\nMesurez-vous \u00e0 de puissants commandants Decepticons alors que chaque affrontement vous entra\u00eene toujours plus loin dans la guerre pour la Terre.\n\n**De l'action digne des salles d'arcade**\n\nInspir\u00e9 des grands classiques des jeux de tir d'arcade, esquivez les attaques ennemies, d\u00e9cha\u00eenez un arsenal de puissantes armes et frayez-vous un chemin \u00e0 travers les forces des Decepticons.\n\n**Au-del\u00e0 de la Terre**\n\nQuittez la Terre et d\u00e9couvrez Cybertron, le monde natal des Transformers.\n", "short_description": "Joignez les Autobots dans un jeu de tir en r\u00e9alit\u00e9 virtuelle sur rails, inspir\u00e9 des classiques d'arcade, se d\u00e9roulant dans l'univers de Transformers."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meta4.games/privacy-policy-transformers-beyond-reality-redux/", "developer_terms_of_service_url": null, "publisher_name": "META4 Interactive Inc.", "support_website_url": null, "website_url": "https://www.meta4.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_ca
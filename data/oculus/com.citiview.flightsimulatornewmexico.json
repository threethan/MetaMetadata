6CNQIQQ7kNvwEduROj&_nc_oc=AdocgouPRB_2x3op1d_96K77V8w1nhqKe-BgnQojHIsLTnEzumOL8jes70qtMChiqmo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRiTJi-ZRxE6_le747-ZBkqK1C25megTEO8apppk6BFcg&oe=6B09B38D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1117436030757002", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/765553549_1117436034090335_4026025309440264669_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XlUpbNhxgnQQ7kNvwHNHlyH&_nc_oc=AdpWYMDcMJrFEgO7-iySkmNSDmdN0V0W4ijtTMVTX0JhCUjGxYtSJ1PWieFzqpv-EgU&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHlcKuGX49iFR4tBW4QOXUyRW84EXetTMB32jVq6HQAw&oe=6B09B8C6"}, "display_name": "Flight Simulator New Mexico", "keywords": ["flight", "simulator", "newmexico", "albuquerque", "jet"], "long_description": "Flight Simulator New Mexico puts you in the captain's seat over the real Albuquerque and the Sandia Mountains.\n\nTHE CITY\nDowntown's towers, the KiMo Theatre, the Alvarado, Old Town and San Felipe de Neri, the University of New Mexico, the Rail Yards and Route 66 through Nob Hill.\n\nTHE SANDIAS\nFly under the Sandia Peak Tramway's cables, over the crest at 10,678 ft and its antenna farm, down Tijeras Canyon and past the ski area.\n\nTHE BALLOON FIESTA\nHot air balloons rise from Balloon Fiesta Park and drift down the North Valley to the river.\n\nTHE RIO GRANDE\nLow down the river past its bridges, Corrales, the BioPark, the Petroglyph volcanoes and Isleta Pueblo.\n\nA LIVING CITY\nThe Rail Runner and freight trains on the real tracks, traffic on I-25 and I-40. At night Central Avenue glows with neon.\n\nAIR TRAFFIC CONTROL\nTaxi and takeoff clearances and your landing clearance.\n\nYOUR GLASS HANGAR\nEvery flight starts in your glass hangar on the West Mesa. Repaint, wash, fly.\n\nFOUR AIRCRAFT AND ELEVEN MISSIONS\nTwo private jets, a midsize jet and a fighter. Sunport and Double Eagle approaches, the Rio Grande Run, the Balloon Fiesta, a Kirtland scramble, a city tour and the city by night.\n\nFLY TOGETHER ONLINE\nQuick Match or a private sky with a code. Voice chat stays off until you turn it on.\n\nEnglish and Spanish menus.", "short_description": "Fly the real Albuquerque, New Mexico: under the Sandia Peak Tramway's cables, through the Balloon Fiesta, down the Rio Grande and over Old Town, downtown and Route 66's neon. Start in your own glass hangar on the West Mesa, talk to air traffic control and land at the Albuquerque Sunport and Double Eagle II. English and Spanish menus."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/flightsimulatornewmexico/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/flightsimulatornewmexico/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_MX"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1394304853766050"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1394405220422680", "version": "1.0.1"}, "id": "1799248527991536", "channel_name": "LIVE"}]}, "is_for_oc
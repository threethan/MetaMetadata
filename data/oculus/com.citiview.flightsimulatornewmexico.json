nt-dfw6-1.oculuscdn.com/v/t64.5771-25/654956704_1438725201132098_6246429344030974891_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IwH5WigZ8_AQ7kNvwHd6NNA&_nc_oc=AdrVA9fPqohDcQuT_gQSylJhdt17K7833e6KsOnlI__ofVNCoKS3qCzoyXL79kagExU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvfeS2GLB_sYA4vOix3mt_mjXWh3LkPndvLaKM-cwH2w&oe=6AF9D2BC"}, {"file_name": "screenshot_2.png", "id": "1410790847886596", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/673536876_1410790851219929_3541579206483814587_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6KorF3_TrUYQ7kNvwENdfme&_nc_oc=Adq2ccqPdpbUQ04qdTOcHZthy1t75nQtq8P4sGQFLkUA81YGmyorsfAIZOwnHqGEIk8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwJLPK32elBVp84SaHSSrqyJ6AUd1cp4f6F3s4MCks1g&oe=6AF9CAF0"}, {"file_name": "screenshot_5.png", "id": "1423140249768562", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/737543484_1423140253101895_914684867522619468_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zeJa-biU5oMQ7kNvwHjwzgr&_nc_oc=AdrAneRk9Slq4HCTFRWSf7n_wzj-9qVFOP931PdIWpYeadJcMvg2TuWfeB8YXo3-rn8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqRGboZEcJsjEZNi6iBaFfGxV1jg1qcI4k-1XAArkOUA&oe=6AF9BA00"}, {"file_name": "screenshot_4.png", "id": "4760381847537229", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/673652249_4760381850870562_4652801662820377133_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YW1QUXbLXkgQ7kNvwEboXbw&_nc_oc=AdpA_2pNC7vGuHbcSG25wMmeP3Nt80WkP6JY8AOksOglNjr310NMfE1Lg68dW_q1m0k&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHnnkAwOrve062zXYuuHhy7N8C1NVkGzWIf00Z6tkERA&oe=6AF9E18D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1117436030757002", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/765553549_1117436034090335_4026025309440264669_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T6rhW94kDbYQ7kNvwGH6fU0&_nc_oc=Adra5bzkkYbN9giAjpG_-RyhbR2vCY_c77QSL8tO4yTnONjnAcfzS0huesS5VIyXLkQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCIC3A4YHlIktGsDwQC6SvL02XUsrPHosS7uZ3O55wYQ&oe=6AF9E6C6"}, "display_name": "Flight Simulator New Mexico", "keywords": ["flight", "simulator", "newmexico", "albuquerque", "jet"], "long_description": "Flight Simulator New Mexico puts you in the captain's seat over the real Albuquerque and the Sandia Mountains.\n\nTHE CITY\nDowntown's towers, the KiMo Theatre, the Alvarado, Old Town and San Felipe de Neri, the University of New Mexico, the Rail Yards and Route 66 through Nob Hill.\n\nTHE SANDIAS\nFly under the Sandia Peak Tramway's cables, over the crest at 10,678 ft and its antenna farm, down Tijeras Canyon and past the ski area.\n\nTHE BALLOON FIESTA\nHot air balloons rise from Balloon Fiesta Park and drift down the North Valley to the river.\n\nTHE RIO GRANDE\nLow down the river past its bridges, Corrales, the BioPark, the Petroglyph volcanoes and Isleta Pueblo.\n\nA LIVING CITY\nThe Rail Runner and freight trains on the real tracks, traffic on I-25 and I-40. At night Central Avenue glows with neon.\n\nAIR TRAFFIC CONTROL\nTaxi and takeoff clearances and your landing clearance.\n\nYOUR GLASS HANGAR\nEvery flight starts in your glass hangar on the West Mesa. Repaint, wash, fly.\n\nFOUR AIRCRAFT AND ELEVEN MISSIONS\nTwo private jets, a midsize jet and a fighter. Sunport and Double Eagle approaches, the Rio Grande Run, the Balloon Fiesta, a Kirtland scramble, a city tour and the city by night.\n\nFLY TOGETHER ONLINE\nQuick Match or a private sky with a code. Voice chat stays off until you turn it on.\n\nEnglish and Spanish menus.", "short_description": "Fly the real Albuquerque, New Mexico: under the Sandia Peak Tramway's cables, through the Balloon Fiesta, down the Rio Grande and over Old Town, downtown and Route 66's neon. Start in your own glass hangar on the West Mesa, talk to air traffic control and land at the Albuquerque Sunport and Double Eagle II. English and Spanish menus."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/flightsimulatornewmexico/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/flightsimulatornewmexico/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_MX"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1394304853766050"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1603091597743370"}]}, "baseline_offer": {"id": "1603091597743370"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792375020, "status": "PUBLISHED", "id": "1603091597743370"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1394405220422680", "version": "1.0.1"}, "id": "1799248527991536", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1394304843766051", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1394405220422680"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1799248527
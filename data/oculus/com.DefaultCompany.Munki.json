gen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_52AsbFYLbIQ7kNvwHd_Sx6&_nc_oc=AdqabDQN_2i7cEu5xnUzbt6t-GPGrIbzFdjwadQO4ld1WNf8W0ggCKx4PLi3lecz-cw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUDIgXw2c5RbiBU1622hQPL0L7HO_0T18HumxrP2OjH3A&oe=6B105809"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Munki V2", "keywords": [], "long_description": "Welcome to Munki 2! We're thrilled to have you join us on this adventure. Sadly, our previous version had to bid farewell due to a mishap with the APK, but fear not, for we're back and better than ever! Get ready for a slew of updates in the pipeline, promising more excitement and thrills than ever before. Explore new maps, traverse through dense forests, and brace yourself for the spine-chilling horror that awaits in our yet-to-be-finished horror mode.\n\nBut remember, amidst all the excitement, we uphold certain values to ensure everyone has a great time. Cheating? Absolutely not allowed. Toxic behavior? Not here. Harassment? Absolutely out of the question. We're all about creating a welcoming and enjoyable environment for all players.\n\nSo, buckle up, grab your gear, and get ready to embark on an epic journey filled with challenges, mysteries, and endless fun. Welcome to Munki 2\u2014where the adventure never ends!", "short_description": "Munki is a game thats beem waited on by many!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://8c59f875-c954-4399-a836-11c788114cbe.godaddysites.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "DominicDev/Munki V2 Studios", "support_website_url": null, "website_url": "https://8c59f875-c954-4399-a836-11c788114cbe.godaddysites.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_a
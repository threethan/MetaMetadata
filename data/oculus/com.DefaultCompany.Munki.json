=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W4ThjrcturgQ7kNvwGyJVb4&_nc_oc=AdoIgzbmEUpf7ejkOm07VPbwPd7VuYXNNv52fJlfZJpiGwcveM-D9O9tgAsJmsrziHU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEaKDhy0CVPatDVyJG7gioJ21NlPed-oVuMl5-jYKoP7A&oe=6A73512A"}, {"file_name": "Screenshot 2024-05-10 112445.png", "id": "1809991109479378", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569444_1809991112812711_5565217219802371332_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ah-6HOu-9KsQ7kNvwFVhkz-&_nc_oc=Adpz7m1jkhLHhS3oR9ayxUdACsjeqV2_h6fM53d3E50EW6dJRjDC6rLwQ1IHLDTh-JA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGaBS6VzWcA55yEo5iszMBIuMputLL27Ez-MjK_iTwWIw&oe=6A733365"}, {"file_name": "Screenshot 2024-05-10 112513.png", "id": "407896442124629", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974858_407896445457962_633300190001224004_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7vKf8sFE5kkQ7kNvwHoLe0m&_nc_oc=AdoJcP20UONqA8RQeT-9a-bw39wbivZZxyf7tJqgVnKRQK1YsXDYuvZPtEXeZb8vJoE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFt7e4L5YLM5kpNFfer63ytwVJ7ukYtK4u3ZJ2twSDxug&oe=6A73412E"}, {"file_name": "Screenshot 2024-05-10 112429.png", "id": "7495438383874629", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035423_7495438387207962_5348652815821706164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TC9ZtOxJgU4Q7kNvwEarguV&_nc_oc=AdpPbORIEc6M12FqZ6055gAGRBIWBM-gEk3BcjqnUm2P_tBJr-odM6Z0Fvx5P7sfxr8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEW-AsF3FZSwD_WtYoqegI70EkzCLe2fSVwTi5lil6lfw&oe=6A7353B2"}, {"file_name": "Screenshot 2024-05-10 112543.png", "id": "379877018388721", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982563_379877025055387_3402817369444598279_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vvo-xdQmOKAQ7kNvwGeTrg_&_nc_oc=Adp8gTWRjwpdQyH3AjNJPR3cWBOobePQ7LXMb148-IEThc7yzSJdFGkrNCLsSF1wrHw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQECfmJ2HUvzlGVNPunlguw4-QwoQtwElKZ73JDG0TQEyw&oe=6A733D49"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Munki V2", "keywords": [], "long_description": "Welcome to Munki 2! We're thrilled to have you join us on this adventure. Sadly, our previous version had to bid farewell due to a mishap with the APK, but fear not, for we're back and better than ever! Get ready for a slew of updates in the pipeline, promising more excitement and thrills than ever before. Explore new maps, traverse through dense forests, and brace yourself for the spine-chilling horror that awaits in our yet-to-be-finished horror mode.\n\nBut remember, amidst all the excitement, we uphold certain values to ensure everyone has a great time. Cheating? Absolutely not allowed. Toxic behavior? Not here. Harassment? Absolutely out of the question. We're all about creating a welcoming and enjoyable environment for all players.\n\nSo, buckle up, grab your gear, and get ready to embark on an epic journey filled with challenges, mysteries, and endless fun. Welcome to Munki 2\u2014where the adventure never ends!", "short_description": "Munki is a game thats beem waited on by many!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://8c59f875-c954-4399-a836-11c788114cbe.godaddysites.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "DominicDev/Munki V2 Studios", "support_website_url": null, "website_url": "https://8c59f875-c954-4399-a836-11c788114cbe.godaddysites.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_la
_LwX5LVTI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7L7NqISB3L8KqTIvbTubkzAZTKSQxxwQTDlI3dA3B_Uw&oe=6A1C4E2A"}, {"file_name": "Screenshot 2024-05-10 112445.png", "id": "1809991109479378", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/57569444_1809991112812711_5565217219802371332_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7DfsXLwkH18Q7kNvwHlX7M7&_nc_oc=AdogSJ__PH4X8dx_S8msrq75G6PJHfA9p2CZEoDg1ycTlenJ3Z1qTPiWqnm9IhFn_k0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5pi05WPsgFH3zhvtT461pwok3S25H6gxS1gqtRPFA1Fw&oe=6A1C3065"}, {"file_name": "Screenshot 2024-05-10 112513.png", "id": "407896442124629", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974858_407896445457962_633300190001224004_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XhagcamAjf0Q7kNvwFkvuOI&_nc_oc=Adqlds4uUqhqo6AY2nRbazDwdOVhia--0UmCs8Y8Vpymz7iy-bgMDE4KN3_yqg5om-Q&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5FD4DpLc7PrlmkwBRDuwbKGiGD6h_IJK-HrWcTdD16NQ&oe=6A1C3E2E"}, {"file_name": "Screenshot 2024-05-10 112429.png", "id": "7495438383874629", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39035423_7495438387207962_5348652815821706164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ekWcBZZNZbIQ7kNvwHf9LkW&_nc_oc=AdpCIkzCc9Q_F8ch7E_BJGGJs9Wixcxkyac--uQlPncvrGbOna6QA-KoZiY5Gc6tR1U&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42v2cjYHEvH3e6MxRZnlkdBd9OOt2pgvzPOnBdRyvV5A&oe=6A1C50B2"}, {"file_name": "Screenshot 2024-05-10 112543.png", "id": "379877018388721", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982563_379877025055387_3402817369444598279_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ChmlVIFtF_UQ7kNvwETFCyJ&_nc_oc=Adq4u_934bluZkhtCQYMYnQz2Q3I2wpXHsNep_g0nZ-hL1SfXO_TcW89hiA0yBPC_-o&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_XKUsYo2owACXavJfTHITe5fsZtDdLaU6Gezob7S0pQ&oe=6A1C3A49"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Munki V2", "keywords": [], "long_description": "Welcome to Munki 2! We're thrilled to have you join us on this adventure. Sadly, our previous version had to bid farewell due to a mishap with the APK, but fear not, for we're back and better than ever! Get ready for a slew of updates in the pipeline, promising more excitement and thrills than ever before. Explore new maps, traverse through dense forests, and brace yourself for the spine-chilling horror that awaits in our yet-to-be-finished horror mode.\n\nBut remember, amidst all the excitement, we uphold certain values to ensure everyone has a great time. Cheating? Absolutely not allowed. Toxic behavior? Not here. Harassment? Absolutely out of the question. We're all about creating a welcoming and enjoyable environment for all players.\n\nSo, buckle up, grab your gear, and get ready to embark on an epic journey filled with challenges, mysteries, and endless fun. Welcome to Munki 2\u2014where the adventure never ends!", "short_description": "Munki is a game thats beem waited on by many!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://8c59f875-c954-4399-a836-11c788114cbe.godaddysites.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "DominicDev/Munki V2 Studios", "support_website_url": null, "website_url": "https://8c59f875-c954-4399-a836-11c788114cbe.godaddysites.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "support
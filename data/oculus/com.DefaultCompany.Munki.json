NHt-aOY0YoBVdg&oe=6AA408AE"}, {"file_name": "Screenshot 2024-05-10 112429.png", "id": "7495438383874629", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39035423_7495438387207962_5348652815821706164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CpZxVqwwGkUQ7kNvwHeDQiI&_nc_oc=AdpMrKpmKpyPa72_RN6_3xo_ZnRgiWuGJf-7i7fcDnJz56g-oU5BJEI8k12Opea4ADM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLihrLUhQnXG_NF5A3XiNG6_VTI9UAwNf3pwmKh5LVkxg&oe=6AA41B32"}, {"file_name": "Screenshot 2024-05-10 112543.png", "id": "379877018388721", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38982563_379877025055387_3402817369444598279_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pnaDTgIwPPAQ7kNvwEjG-QP&_nc_oc=AdpW0Ba4dIHhPvY1zpW3v70WCsLN5WVeGD8RltAd4U85zTF7C7KRTGzrfiwXbUniKqk&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLsxe2LOL1MN9-u1T7QZCNy_E9a_rim8DcryqGb_DzgOg&oe=6AA404C9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Munki V2", "keywords": [], "long_description": "Welcome to Munki 2! We're thrilled to have you join us on this adventure. Sadly, our previous version had to bid farewell due to a mishap with the APK, but fear not, for we're back and better than ever! Get ready for a slew of updates in the pipeline, promising more excitement and thrills than ever before. Explore new maps, traverse through dense forests, and brace yourself for the spine-chilling horror that awaits in our yet-to-be-finished horror mode.\n\nBut remember, amidst all the excitement, we uphold certain values to ensure everyone has a great time. Cheating? Absolutely not allowed. Toxic behavior? Not here. Harassment? Absolutely out of the question. We're all about creating a welcoming and enjoyable environment for all players.\n\nSo, buckle up, grab your gear, and get ready to embark on an epic journey filled with challenges, mysteries, and endless fun. Welcome to Munki 2\u2014where the adventure never ends!", "short_description": "Munki is a game thats beem waited on by many!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://8c59f875-c954-4399-a836-11c788114cbe.godaddysites.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "DominicDev/Munki V2 Studios", "support_website_url": null, "website_url": "https://8c59f875-c954-4399-a836-11c788114cbe.godaddysites.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6330312947093769"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "883913880155595"}]}, "baseline_offer": {"id": "883913880155595"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1715874480, "status": "PUBLISHED", "id": "883913880155595"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6369973153127748", "version": "0.3.4"}, "id": "1150073959688982", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6116904308434635", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "6369973153127748"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1150073959688982"}
=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BIg940xrV7AQ7kNvwGhS-u_&_nc_oc=AdoyPKpY9INYeX_dSuhjJlvfZvJyCnBse53zpgEhdW-pvtKjoOhkFVVCT6yRWegJ3rU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBfzDe6S-DDmF5FlHHtBNVyCI5lZiq2leSZxB_WH_xfA&oe=6A78972A"}, {"file_name": "Screenshot 2024-05-10 112445.png", "id": "1809991109479378", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57569444_1809991112812711_5565217219802371332_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tQH_F7pYYysQ7kNvwEInG6g&_nc_oc=Adql1ZMa-a-G02sSLlNA-UoKlZkmALao7HDs-CshBjZS45-LOLJQONKVOS_K3u87ES4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7WuQyfoVHmPIchiIlVpGab9xi-J4ntBGzVPbtGiLQMA&oe=6A787965"}, {"file_name": "Screenshot 2024-05-10 112513.png", "id": "407896442124629", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974858_407896445457962_633300190001224004_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R2uOsV85XMkQ7kNvwG6Kvvd&_nc_oc=Adpxs8GhNbQN9szQLy_-PxN6gTyJlaTWeidvKnGdp3RlXi_GZNyZ65PnCNACrZbb1gQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGfNdj7hyHnhSn9Yys_vYFkNaEmvRe8Mx7zn2HGgSk2qw&oe=6A78872E"}, {"file_name": "Screenshot 2024-05-10 112429.png", "id": "7495438383874629", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035423_7495438387207962_5348652815821706164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8xNEpF1Ok7sQ7kNvwHJ8RC8&_nc_oc=AdoBDe4nnnS6I9MNC-_524-2vtnfT7-er2eHarLQ40OCCvDPEVuS6uI_qre0vVLLppo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpoyTVTqywIa4xBLsoUavIqL2xmk_EYJrahYn11bewug&oe=6A7899B2"}, {"file_name": "Screenshot 2024-05-10 112543.png", "id": "379877018388721", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982563_379877025055387_3402817369444598279_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6jzRfVjBuJMQ7kNvwHsId55&_nc_oc=AdonIWt6YAJl1ErsuhccAQJ-wl9cpK9rXLkQdOLoOMeuPRDXfX8beFRMR2pvp5F3gLw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHYfqIS3NzlluXsENeJhd3QU8FkaXxjTvB1p6zGboVzpw&oe=6A788349"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Munki V2", "keywords": [], "long_description": "Welcome to Munki 2! We're thrilled to have you join us on this adventure. Sadly, our previous version had to bid farewell due to a mishap with the APK, but fear not, for we're back and better than ever! Get ready for a slew of updates in the pipeline, promising more excitement and thrills than ever before. Explore new maps, traverse through dense forests, and brace yourself for the spine-chilling horror that awaits in our yet-to-be-finished horror mode.\n\nBut remember, amidst all the excitement, we uphold certain values to ensure everyone has a great time. Cheating? Absolutely not allowed. Toxic behavior? Not here. Harassment? Absolutely out of the question. We're all about creating a welcoming and enjoyable environment for all players.\n\nSo, buckle up, grab your gear, and get ready to embark on an epic journey filled with challenges, mysteries, and endless fun. Welcome to Munki 2\u2014where the adventure never ends!", "short_description": "Munki is a game thats beem waited on by many!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://8c59f875-c954-4399-a836-11c788114cbe.godaddysites.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "DominicDev/Munki V2 Studios", "support_website_url": null, "website_url": "https://8c59f875-c954-4399-a836-11c788114cbe.godaddysites.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_la
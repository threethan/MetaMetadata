-3YeI6sJo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6DPcI32XthCuWo-dgGjKWzo77GQqCxFwfgX5HqD6E5Cg&oe=69FA072A"}, {"file_name": "Screenshot 2024-05-10 112445.png", "id": "1809991109479378", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569444_1809991112812711_5565217219802371332_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0jd8q6P5ydcQ7kNvwETBrkk&_nc_oc=Adq8okk-dSd-qpogVk4Xx6osxq1xZesjzZxDfvEP_d07zOp3QKWm-AJVxeqoe2d625A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ZgX8oE-zY78yGLcxrU-H8FkuKuqHdkXkx1D1VdKWzjQ&oe=69F9E965"}, {"file_name": "Screenshot 2024-05-10 112513.png", "id": "407896442124629", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974858_407896445457962_633300190001224004_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j6QEemyXBvAQ7kNvwHKsNB6&_nc_oc=Adrb4FfB54rtSXS-mwKzkRKUc7RjVhXCx_nvdO0WIox1IjZqI7XalUs-ydLWCEBqORs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6GoOaczQxE3tvGch5LnLjH1Az3_A19w6ajBNgkQsZ-MA&oe=69F9F72E"}, {"file_name": "Screenshot 2024-05-10 112429.png", "id": "7495438383874629", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035423_7495438387207962_5348652815821706164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XrACzk6mqecQ7kNvwEVG2z1&_nc_oc=Adr8dMHzgN70m4W4UJ31k-a9-2jxSWagO9CV6IQwho4m6t8_O0IbJdkEsTXKgOvkPhM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af77MfGSjrYjht4Ta5Fjq2Tddx_e_ehsjmKTc62fMu_LUA&oe=69FA09B2"}, {"file_name": "Screenshot 2024-05-10 112543.png", "id": "379877018388721", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982563_379877025055387_3402817369444598279_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aja2b5TxGj0Q7kNvwHbSIB1&_nc_oc=AdpxwTigFk979WM4XpVvjGy7VDiiwl2Q30GQH-ZPE0MKKhO6s9LiQqKKXalPRqBOg7M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wa854gTD7GQ-RNXXq212aNrHb7lzEeRPXWRFyk-fVcQ&oe=69F9F349"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Munki V2", "keywords": [], "long_description": "Welcome to Munki 2! We're thrilled to have you join us on this adventure. Sadly, our previous version had to bid farewell due to a mishap with the APK, but fear not, for we're back and better than ever! Get ready for a slew of updates in the pipeline, promising more excitement and thrills than ever before. Explore new maps, traverse through dense forests, and brace yourself for the spine-chilling horror that awaits in our yet-to-be-finished horror mode.\n\nBut remember, amidst all the excitement, we uphold certain values to ensure everyone has a great time. Cheating? Absolutely not allowed. Toxic behavior? Not here. Harassment? Absolutely out of the question. We're all about creating a welcoming and enjoyable environment for all players.\n\nSo, buckle up, grab your gear, and get ready to embark on an epic journey filled with challenges, mysteries, and endless fun. Welcome to Munki 2\u2014where the adventure never ends!", "short_description": "Munki is a game thats beem waited on by many!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://8c59f875-c954-4399-a836-11c788114cbe.godaddysites.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "DominicDev/Munki V2 Studios", "support_website_url": null, "website_url": "https://8c59f875-c954-4399-a836-11c788114cbe.godaddysites.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "support
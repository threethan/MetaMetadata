UySysoxERo2SaL76qDc&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFNZMg5yqeMEZvrqcDkCOjLJxgAPcP2ZbGbcAYZrQXi8g&oe=6A8EC86A"}, {"file_name": "Screenshot 2024-05-10 112445.png", "id": "1809991109479378", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/57569444_1809991112812711_5565217219802371332_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IKj1EX-SlLcQ7kNvwHwHmJR&_nc_oc=Adqg9-USFi8b5UdeoRZD9P9hlSrfjQPGNg7Iyvsri8FyctRDitgu-c4BThdk3FUpYk8&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEv8UVwqUFjTHIwdRFW3HrJq-1HWzqWnYziDVqyI3Ps3Q&oe=6A8EE2E5"}, {"file_name": "Screenshot 2024-05-10 112513.png", "id": "407896442124629", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974858_407896445457962_633300190001224004_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CAjIHYY9RGUQ7kNvwH3hP1J&_nc_oc=AdppSBlO95xWAez218V0hHfm9n-rxsuMfIRLcCLB7RF5uzt808hZkfWjBphJMB3-b04&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8jn8yDq8XBtchWvE4g2AjNIp6_6-yo5ZAqSQx68AIXA&oe=6A8EF0AE"}, {"file_name": "Screenshot 2024-05-10 112429.png", "id": "7495438383874629", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39035423_7495438387207962_5348652815821706164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=asITAftWj9UQ7kNvwGH4kQs&_nc_oc=AdrkquchW1YkeT98QBew7v32h4ihGa1eKRT-F2eN2wD2Ix9-cO1_xlQR8Onsn1RPeXk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFPX0DK1E82FC_QyYqHyGN1jT4qucpPTGPxbVSE9ElgEA&oe=6A8ECAF2"}, {"file_name": "Screenshot 2024-05-10 112543.png", "id": "379877018388721", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982563_379877025055387_3402817369444598279_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4QShImAviqUQ7kNvwGxJDKK&_nc_oc=AdrLy09e_h0TVPa16PylwGzOkCI4WVBb4ufDoKW1QpT3oqeooqAbhgoGXIZ0t143Nos&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErcNYSd448KUaxY_CRgWyEiGtL9aYyOVCG9F7IAVQPcw&oe=6A8EECC9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Munki V2", "keywords": [], "long_description": "Welcome to Munki 2! We're thrilled to have you join us on this adventure. Sadly, our previous version had to bid farewell due to a mishap with the APK, but fear not, for we're back and better than ever! Get ready for a slew of updates in the pipeline, promising more excitement and thrills than ever before. Explore new maps, traverse through dense forests, and brace yourself for the spine-chilling horror that awaits in our yet-to-be-finished horror mode.\n\nBut remember, amidst all the excitement, we uphold certain values to ensure everyone has a great time. Cheating? Absolutely not allowed. Toxic behavior? Not here. Harassment? Absolutely out of the question. We're all about creating a welcoming and enjoyable environment for all players.\n\nSo, buckle up, grab your gear, and get ready to embark on an epic journey filled with challenges, mysteries, and endless fun. Welcome to Munki 2\u2014where the adventure never ends!", "short_description": "Munki is a game thats beem waited on by many!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://8c59f875-c954-4399-a836-11c788114cbe.godaddysites.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "DominicDev/Munki V2 Studios", "support_website_url": null, "website_url": "https://8c59f875-c954-4399-a836-11c788114cbe.godaddysites.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCA
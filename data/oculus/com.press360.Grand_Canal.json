HyETTi&_nc_oc=Adqw2OAGktsXQa8pITldgQHgS53IcNzVUIvovZiWrvlBDEr9sVtjXHYnADA75sYNt_c&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXIhupQSGBFPLGawHik3Ugou21VC8NFQOyFfgFp7TVyQ&oe=6AFB2B12"}, {"file_name": "04_screen_3.png", "id": "3064872357067151", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001656_3064872360400484_2494520140609094693_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_-xitd8vNJ8Q7kNvwEU5ZGH&_nc_oc=Adq7MxMwpS_JPUeTo7JUTUIwI24J7S3v2z_fmWgDNUSjfwgLJ6lIInG3GELT0AKTC2Y&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnZzqSjD2sRRziJMsbXZZwjMTn6owg4MxHf5_bLEFvcw&oe=6AFB46FE"}, {"file_name": "04_screen_4.png", "id": "1993705221027330", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974453_1993705224360663_2989380386410764130_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dJMMEEb131AQ7kNvwHK7gJd&_nc_oc=AdqAQ_QLWgHW9fIJFMNwhEGkJhJAhivGEfjXr-tGSY3-9CnSTQHrv55t1RTuecB2-L0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9DRsFXP9jY5FkiJzlBBPwcH5QDIAk_NczB82yhTdOvg&oe=6AFB2AA3"}, {"file_name": "04_screen5.png", "id": "282362300648192", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39036629_282362303981525_5788594260541901548_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fDkNqhK9bqYQ7kNvwFhHHfZ&_nc_oc=AdqwmPIDsE7sQ1iPwOrCr752UmAQwu5plG1JOiLuDhbhLRI0iLTKW03ZDN4ZY0x66uI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGZtRV9GNCN3r44w28o9b3bwMo-xTnxPX9wsrn1YDZQQ&oe=6AFB41AB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Venice", "keywords": [], "long_description": "Take that amazing real boat trip through Canal Grande in Venice, Italy without leaving your home, even without leaving your couch!\nNice VR experience and beautiful memories if you already were there or if not, gain experience as if you are there.\n\nno comment - no statement - no argument - no judgement\n\nNo moderation - this is no documentation und no reportage.\n\nYou will enjoy the destination like a normal tourist and you will feel the urban atmosphere with all the crowds and the soundscape of the city.\n\nGet the real feeling in that place and take time to beam directly to Canal Grande.\n\nYou will pass all the famous old buildings and see the boats, water taxis and gondolas on the water. The tour goes from main station St. Lucia to famous San Marco Square (Piazza San Marco) with Campanile Tower. You will see also the Rialto Bridge.\n\nYou travel with the real official Venetian public waterbus just like any tourist arriving in Venice by train and you can see both sides of the Grand Canal.", "short_description": "Take a quick trip to Venice. If you don't have money to travel, then use this VR app. Or you would like to prepare yourself for the next trip to Venice or remember the many great impressions when you were there. Or inspire your friends and invite them to a boat trip to Venice."}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dtopevent.info/oculus/user-data.html", "developer_terms_of_service_url": null, "publisher_name": "press360", "support_website_url": null, "website_url": "https://3dtopevent.info/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["TRAVEL", "EXPERIENCE_360_NON_GAME", "NEWS_AND_INFORMATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9171361
ExTTVG&_nc_oc=Adomd7Wdex7kw0htjOa8lsdnVq-w19zypCLM2Kgxs4S0xoT_3MRbht1cdd8Eopyc2-k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYluCziq6u25Vnlcu3aKo_Ri267XBqd8u_AdzFQuU0lQ&oe=6AFC7C92"}, {"file_name": "04_screen_3.png", "id": "3064872357067151", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39001656_3064872360400484_2494520140609094693_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KuwAczJIqIoQ7kNvwHGsq-W&_nc_oc=AdoH6CjZ6exctg9QI7AkhDufJ5HEDLfLkG5SaM-yq_AmuyD7oo2WQxcoD4b8LzspSv4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTt_DS-QyZVl6-cU-1bDUet7cTGMFEIdh41sym4NaF2aw&oe=6AFC603E"}, {"file_name": "04_screen_4.png", "id": "1993705221027330", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974453_1993705224360663_2989380386410764130_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dJMMEEb131AQ7kNvwHFpiWQ&_nc_oc=AdpZ6hzgrQU2URDl8qmfFsCqyvHCIwzYG3lDRryZZSbGEFxQT9ccrFEzEm5bBY_ielg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzpKKSFVAmKY46H98TbtR2qSNEeRAOXRaWeH2E-4npCw&oe=6AFC7C23"}, {"file_name": "04_screen5.png", "id": "282362300648192", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036629_282362303981525_5788594260541901548_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fDkNqhK9bqYQ7kNvwH3AW6I&_nc_oc=Ado-5fpch30xjFfnFDizHEbpDiZFz9qcXMVHD2JsgunnlOgKQCQnrkvnsm0CuhNPuHc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRnXFY_4Wc1AvKeeIt-R5sXeN5hGly61Jxq3pCX52mT3Q&oe=6AFC932B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Venice", "keywords": [], "long_description": "Take that amazing real boat trip through Canal Grande in Venice, Italy without leaving your home, even without leaving your couch!\nNice VR experience and beautiful memories if you already were there or if not, gain experience as if you are there.\n\nno comment - no statement - no argument - no judgement\n\nNo moderation - this is no documentation und no reportage.\n\nYou will enjoy the destination like a normal tourist and you will feel the urban atmosphere with all the crowds and the soundscape of the city.\n\nGet the real feeling in that place and take time to beam directly to Canal Grande.\n\nYou will pass all the famous old buildings and see the boats, water taxis and gondolas on the water. The tour goes from main station St. Lucia to famous San Marco Square (Piazza San Marco) with Campanile Tower. You will see also the Rialto Bridge.\n\nYou travel with the real official Venetian public waterbus just like any tourist arriving in Venice by train and you can see both sides of the Grand Canal.", "short_description": "Take a quick trip to Venice. If you don't have money to travel, then use this VR app. Or you would like to prepare yourself for the next trip to Venice or remember the many great impressions when you were there. Or inspire your friends and invite them to a boat trip to Venice."}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dtopevent.info/oculus/user-data.html", "developer_terms_of_service_url": null, "publisher_name": "press360", "support_website_url": null, "website_url": "https://3dtopevent.info/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["TRAVEL", "EXPERIENCE_360_NON_GAME", "NEWS_AND_INFORMATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9171361
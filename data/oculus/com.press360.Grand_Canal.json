H7kPj4&_nc_oc=AdrL3Ns5DpMPuUck1b6q57ax4egLEEoGoiC2VxO6iNu6tbH_NGvcBvqOTY_bGC7GuXc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfb0Tu_KIDT9pB0YsYStBBLViOAeHfJcyBaDeZzOSjzw&oe=6B09AB92"}, {"file_name": "04_screen_3.png", "id": "3064872357067151", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39001656_3064872360400484_2494520140609094693_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4XMgcSPwRDgQ7kNvwFlMgSK&_nc_oc=AdrW_ylvr0tYYfFgkW16mhHTk1QU_vW0xpPvYBn2O5moppRBAcVPUE6RhVi9WDAQcRQ&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyn0Jqpwri23fC0QVC5tBtkzcK_Ejqz_j0tdeV9s-INQ&oe=6B09C77E"}, {"file_name": "04_screen_4.png", "id": "1993705221027330", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974453_1993705224360663_2989380386410764130_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=crcMIvR49mcQ7kNvwFfa4Lh&_nc_oc=Adr6ortsoqfjIroCLeRAKFrfJOYOdilS9jvU8oysZJi_6DFQYGBfoUypbo-U5hDS0RA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT51y9wPvo67rn47GXGfOyrrjn9ufR2wRVJT6ondk6H-A&oe=6B09AB23"}, {"file_name": "04_screen5.png", "id": "282362300648192", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036629_282362303981525_5788594260541901548_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gux-wtfwFNgQ7kNvwEVbih1&_nc_oc=Adp3GdnSA0pa0DSy9swDCorZB2hRAzZv6-45JOFNum6RqeQiG5zk-ekfi4mTPclqTRo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR33G58khZPtKuL3ws3k7dlTSC_rAKW37vgkeZAA7tcCg&oe=6B09C22B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Venice", "keywords": [], "long_description": "Take that amazing real boat trip through Canal Grande in Venice, Italy without leaving your home, even without leaving your couch!\nNice VR experience and beautiful memories if you already were there or if not, gain experience as if you are there.\n\nno comment - no statement - no argument - no judgement\n\nNo moderation - this is no documentation und no reportage.\n\nYou will enjoy the destination like a normal tourist and you will feel the urban atmosphere with all the crowds and the soundscape of the city.\n\nGet the real feeling in that place and take time to beam directly to Canal Grande.\n\nYou will pass all the famous old buildings and see the boats, water taxis and gondolas on the water. The tour goes from main station St. Lucia to famous San Marco Square (Piazza San Marco) with Campanile Tower. You will see also the Rialto Bridge.\n\nYou travel with the real official Venetian public waterbus just like any tourist arriving in Venice by train and you can see both sides of the Grand Canal.", "short_description": "Take a quick trip to Venice. If you don't have money to travel, then use this VR app. Or you would like to prepare yourself for the next trip to Venice or remember the many great impressions when you were there. Or inspire your friends and invite them to a boat trip to Venice."}]}, "developer_name": null, "developer_privacy_policy_url": "https://3dtopevent.info/oculus/user-data.html", "developer_terms_of_service_url": null, "publisher_name": "press360", "support_website_url": null, "website_url": "https://3dtopevent.info/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["TRAVEL", "EXPERIENCE_360_NON_GAME", "NEWS_AND_INFORMATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9171361
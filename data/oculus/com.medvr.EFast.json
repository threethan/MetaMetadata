b=1-7&_nc_sid=6e7a0a&_nc_ohc=rB4ofqhQvw0Q7kNvwFW3rIn&_nc_oc=AdqdTVjXe3-_37bBL09ptvHKFwDYo1i8aFicb5s30p9RqrPB4d7c7fk_IGHjdGjzP3Y&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNeR6viCf82XPPA2ctd7v4wQR2OMzc0glqv-yRYIMGxxw&oe=6AC8F4A9"}, {"file_name": "com.medvr.EFast-20250611-113150.png", "id": "516775641426673", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491825009_516775644760006_1382766000675166165_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NiinAj74sJkQ7kNvwFrmjzI&_nc_oc=AdpRtUxQmevJzILN6j2YtK-PrnjyDUE0hjc6d0hUQ2ysNq8FbGhAqmvmiXAVfcx_M4k&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPFkOkuSzRt9qVwhmPpwIBp-TzYoUkkkewTmsvH04R_Kw&oe=6AC8FC5A"}, {"file_name": "com.medvr.EFast-20250602-184537-0.00_01_13_34.Still005.png", "id": "1100282135257857", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491820596_1100282138591190_4637298414022001268_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fzj8MmH1B1UQ7kNvwGt5oY9&_nc_oc=AdrD_meMdqMfsO1THKLHDzwvBFx5ITKYbjpcD8BuzXYRAtBi4y_lHh43xjLrB_8nQ4s&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_tAKtiv7P1Z56k_7xkrGKHqJMGRK4JaDKz3G60caBmw&oe=6AC8EC88"}, {"file_name": "com.medvr.EFast-20250611-113200.png", "id": "2450408521990534", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491820987_2450408525323867_8010144908682949265_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EHpUVNZR364Q7kNvwF1Wdnu&_nc_oc=AdrY2vFBFKxtdbzzuWO8qyCEJFfVr8gOttUBmZbdpZPoLIeUgtQeFeg3ohbBU1qrhgM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN1Wr171eiB7tp3usx8CyiFdlo4Xkgq_w0yCwOxueAMSw&oe=6AC91369"}, {"file_name": "com.medvr.EFast-20250602-184537-0.00_00_19_14.Still002.png", "id": "1261329388919423", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491827071_1261329392252756_4491137049392224278_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zu7rDyMia7gQ7kNvwFcN4A6&_nc_oc=AdpVaBpoQxlzs94L8vd-Asu4nvAULVk0ttnyFkcVf1VmzvAdm5uDccMmM3HH7nBG5IU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN4nv455lTC7KeAzDGEYffZvBMnRQXQHqjDDvB8GqwYQw&oe=6AC90189"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "E-FAST for Trauma", "keywords": ["EFast", "VR", "Medvr", "Medical"], "long_description": "\"E-FAST for Trauma\" is a cutting-edge VR simulation designed to teach and reinforce the Extended Focused Assessment with Sonography for Trauma. Step into the role of a trauma responder and perform real-time ultrasound examinations in high-pressure emergency scenarios. This immersive training module helps learners identify pericardial, pleural, and intraperitoneal fluid with precision, enhancing diagnostic skills in critical care settings. Ideal for medical students, residents, and emergency medicine professionals, this simulation provides realistic anatomy, step-by-step guidance, and repeatable practice opportunities in a safe, virtual environment. Developed to bridge the gap between theory and clinical experience, \"E-FAST for Trauma\" delivers hands-on learning anytime, anywhere.\n\n", "short_description": "Experience hands-on training in Extended Focused Assessment with Sonography for Trauma (E-FAST) through immersive VR. Practice identifying internal bleeding and trauma-related injuries in real-time, interactive emergency scenarios. Ideal for medical students, residents, and healthcare professionals."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_conn
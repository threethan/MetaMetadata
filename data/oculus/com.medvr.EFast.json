b=1-7&_nc_sid=6e7a0a&_nc_ohc=q9Tef35fZs4Q7kNvwEKfH_G&_nc_oc=Adrcd2WtWaIPFfGVIvgStU0noaUdbOxvi2wzu-rA6v41T-_VGlB79QXNvTVsYh5EmR8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJE50q_0Rbm9UFpufSUkslnPzbLnneh2foIgEGWeBYHrQ&oe=6AA2B929"}, {"file_name": "com.medvr.EFast-20250611-113150.png", "id": "516775641426673", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825009_516775644760006_1382766000675166165_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BfKRqjKz_pEQ7kNvwEjGrAT&_nc_oc=Adp4ExcQt85s1Y1fedswwjv8RheNz6Yu-6W7OgGIgJvxDPEs8dMzroNu2_zPKQDdZvg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkf_L-rOfDos4lyDKVQVAQdHqo2cxj5ra2ToAjk6akyw&oe=6AA2C0DA"}, {"file_name": "com.medvr.EFast-20250602-184537-0.00_01_13_34.Still005.png", "id": "1100282135257857", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820596_1100282138591190_4637298414022001268_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vk6fAzmZeswQ7kNvwGZzN_o&_nc_oc=AdoFUl3ir_nxBieeIg1s1qhHHfYJ-LIkOaethS6J0jwqClPFHfkg8OSa8iM0_TgDNOk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLh3cbyFd-SHZzUJqHyyDWwoTsqR0Ksc1jM0JEWMUxxPQ&oe=6AA2B108"}, {"file_name": "com.medvr.EFast-20250611-113200.png", "id": "2450408521990534", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820987_2450408525323867_8010144908682949265_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MN4LLfJlbQwQ7kNvwFUDH4q&_nc_oc=Adpp3uUBDuFGnzNKMSver-lwaTkrT16bZ8JhE_tOElr3zxcxEpsDI4q3OhBJ7v9HgNk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIiEiQYvDqbrG6All_DRV0c3Ex6zX8Gm5EQWYQQi3Sz0Q&oe=6AA29FA9"}, {"file_name": "com.medvr.EFast-20250602-184537-0.00_00_19_14.Still002.png", "id": "1261329388919423", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827071_1261329392252756_4491137049392224278_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bXG3c-wWUVYQ7kNvwFWXA_M&_nc_oc=AdrJh36_uzEEorDrji0NYzLC6dQPCpj9s3EzSq3oJ4PShnZ_RNhY4IvsR2-9hl9_z-4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKrv3pHSLPDtREXeUMNW91FNWtch5uMHMNqe1WC_6AYuA&oe=6AA2C609"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "E-FAST for Trauma", "keywords": ["EFast", "VR", "Medvr", "Medical"], "long_description": "\"E-FAST for Trauma\" is a cutting-edge VR simulation designed to teach and reinforce the Extended Focused Assessment with Sonography for Trauma. Step into the role of a trauma responder and perform real-time ultrasound examinations in high-pressure emergency scenarios. This immersive training module helps learners identify pericardial, pleural, and intraperitoneal fluid with precision, enhancing diagnostic skills in critical care settings. Ideal for medical students, residents, and emergency medicine professionals, this simulation provides realistic anatomy, step-by-step guidance, and repeatable practice opportunities in a safe, virtual environment. Developed to bridge the gap between theory and clinical experience, \"E-FAST for Trauma\" delivers hands-on learning anytime, anywhere.\n\n", "short_description": "Experience hands-on training in Extended Focused Assessment with Sonography for Trauma (E-FAST) through immersive VR. Practice identifying internal bleeding and trauma-related injuries in real-time, interactive emergency scenarios. Ideal for medical students, residents, and healthcare professionals."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_conn
=AdpEO9b0vay_VN1_gE4_J4wW5nlKCcAOxQN0fX7Za69pY1KRiFUcnkjHUz2P7bhnyOk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af11tOTxYdwvM6d3Xk3xaOhKTjNhSr-aoQCPJ5bhLN-EBA&oe=69D50708"}, {"file_name": "com.medvr.EFast-20250611-113200.png", "id": "2450408521990534", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820987_2450408525323867_8010144908682949265_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1rmBKbWRK7EQ7kNvwFmdyQ6&_nc_oc=AdqcbK8x7855KoVn2iYw2AL_txtzAAtn7QUtp2kSEBKNQTJz6tAQj-GZ2_R2HItZuy8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af34Dnw8p8LUow0NPE_YnNQFwTnCQM0Q4gOq7jftGbFJsg&oe=69D4F5A9"}, {"file_name": "com.medvr.EFast-20250602-184537-0.00_00_19_14.Still002.png", "id": "1261329388919423", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827071_1261329392252756_4491137049392224278_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C8e6fq95-00Q7kNvwGm3Dw7&_nc_oc=AdqnwZYhVfIWzuTUoLdRn_zI6H1FVvO5xeDsd87zqGW2eXTSIXcTeQFKy-ZjeblHWSw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1oSSEZbLQRzjIByElYad_Ii0NZpcSq_2QNWW1-fjCC2Q&oe=69D4E3C9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "E-FAST for Trauma", "keywords": ["EFast", "VR", "Medvr", "Medical"], "long_description": "\"E-FAST for Trauma\" is a cutting-edge VR simulation designed to teach and reinforce the Extended Focused Assessment with Sonography for Trauma. Step into the role of a trauma responder and perform real-time ultrasound examinations in high-pressure emergency scenarios. This immersive training module helps learners identify pericardial, pleural, and intraperitoneal fluid with precision, enhancing diagnostic skills in critical care settings. Ideal for medical students, residents, and emergency medicine professionals, this simulation provides realistic anatomy, step-by-step guidance, and repeatable practice opportunities in a safe, virtual environment. Developed to bridge the gap between theory and clinical experience, \"E-FAST for Trauma\" delivers hands-on learning anytime, anywhere.\n\n", "short_description": "Experience hands-on training in Extended Focused Assessment with Sonography for Trauma (E-FAST) through immersive VR. Practice identifying internal bleeding and trauma-related injuries in real-time, interactive emergency scenarios. Ideal for medical students, residents, and healthcare professionals."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "30059640770347198"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1461754958531266"}]}, "baseline_offer": {"id": "1461754958531266"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1750144260, "status": "PUBLISHED", "id": "1461754958531266"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "31007262838918315", "version": "1.3"}, "id": "1078953254141147", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary
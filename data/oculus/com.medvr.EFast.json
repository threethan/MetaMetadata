b=1-7&_nc_sid=6e7a0a&_nc_ohc=hHaMXdC8AxUQ7kNvwHfvd1x&_nc_oc=AdrM_ZbRNF7c7NB7CL3cHETg2XKgdiu_zil3oar-BbyZGJnhBYu-Etn6XdIQhUUcXK8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgMRs9oQ93uvTLT2RTsEo3XXUU1BPSlp7neMaFkHENdw&oe=6AF8A2E9"}, {"file_name": "com.medvr.EFast-20250611-113150.png", "id": "516775641426673", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825009_516775644760006_1382766000675166165_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-d1jqNpZVLoQ7kNvwGCdJZk&_nc_oc=AdqrkKC-FAf5neybIJ6N1DG9AZ2CoDwAVrhaO4p7j832td9TRxOu-E9Tzzyd4Jzj8PI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTe4iY_ZiQBNX0tR1T7ldfm4w__LvM8euMb3geC1pVPFg&oe=6AF8AA9A"}, {"file_name": "com.medvr.EFast-20250602-184537-0.00_01_13_34.Still005.png", "id": "1100282135257857", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820596_1100282138591190_4637298414022001268_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6GRTBEwVXGMQ7kNvwG8EKZk&_nc_oc=AdpPeRGocq6xA6eWqmsDVqWXub_Hcbv3u1YUqsM85OzIDEUg0iqIe5XK4-H9ZBH6vC8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTA_cJw96itAzcoe2_Sf_CXGZMjcHvZ_w8rhWaIfSJdOQ&oe=6AF89AC8"}, {"file_name": "com.medvr.EFast-20250611-113200.png", "id": "2450408521990534", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820987_2450408525323867_8010144908682949265_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sb0PF3bjj7AQ7kNvwHXHvBw&_nc_oc=AdplJB2lwN9r2Uxe2p1UcJYZbhwxzCBwqfa5KAUo7dCotIBIA8WT-jaQxo5Egmpaowg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSfc4jAbpLOkNOqRnjpSDUr93ZEUawF1UY3qiB8LPJJw&oe=6AF88969"}, {"file_name": "com.medvr.EFast-20250602-184537-0.00_00_19_14.Still002.png", "id": "1261329388919423", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827071_1261329392252756_4491137049392224278_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=je-iaqN0d_UQ7kNvwFCL4gk&_nc_oc=Adq65-vIihfBGh0xerO-4DWceOKPAsmmvc_ZFVOq6wG0H6QusAMmcP0UNxuunxp9WhE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqssQREJexAonpV4CUcu-uNhPzjUXIqEQfjy_WgyCdCw&oe=6AF87789"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "E-FAST for Trauma", "keywords": ["EFast", "VR", "Medvr", "Medical"], "long_description": "\"E-FAST for Trauma\" is a cutting-edge VR simulation designed to teach and reinforce the Extended Focused Assessment with Sonography for Trauma. Step into the role of a trauma responder and perform real-time ultrasound examinations in high-pressure emergency scenarios. This immersive training module helps learners identify pericardial, pleural, and intraperitoneal fluid with precision, enhancing diagnostic skills in critical care settings. Ideal for medical students, residents, and emergency medicine professionals, this simulation provides realistic anatomy, step-by-step guidance, and repeatable practice opportunities in a safe, virtual environment. Developed to bridge the gap between theory and clinical experience, \"E-FAST for Trauma\" delivers hands-on learning anytime, anywhere.\n\n", "short_description": "Experience hands-on training in Extended Focused Assessment with Sonography for Trauma (E-FAST) through immersive VR. Practice identifying internal bleeding and trauma-related injuries in real-time, interactive emergency scenarios. Ideal for medical students, residents, and healthcare professionals."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_conn
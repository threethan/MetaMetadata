b=1-7&_nc_sid=6e7a0a&_nc_ohc=-gClgkKlhcQQ7kNvwGyexeA&_nc_oc=Adp1foMhF5lJzal02aTrXFbaZu3C9TG8MQ_Ew-HfmZ3-nKAS0_UgaRSouZbQYMSxk9M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJeTzTJx4cwYXyH86rHsQJRseSBLzkSkgcixUnaS_6JOQ&oe=6AB67FA9"}, {"file_name": "com.medvr.EFast-20250611-113150.png", "id": "516775641426673", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825009_516775644760006_1382766000675166165_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hHrm0oeuoFkQ7kNvwH5etkx&_nc_oc=AdqraEr3CmIrSnWTNoTLP3g6W2CbrYE0nQec09UCgPXQEI9J4oD-m31KJROigCNxV68&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKR_BYzBNhNh6WaTYmlE4WAKH455Qpu5eFXrQ82aSrOrw&oe=6AB6875A"}, {"file_name": "com.medvr.EFast-20250602-184537-0.00_01_13_34.Still005.png", "id": "1100282135257857", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491820596_1100282138591190_4637298414022001268_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XfJcE4ms6jUQ7kNvwGgiAJT&_nc_oc=AdqzP_7LCaGzh_qW_-osofed6To_oGCbRUGGq59_JQ-2e-4C3ezLrjfaz5nY3bR38Nw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIkAGX6fcZKupwzGjzcdaBwxnrV8Sj6PCUDCqD2W5QvJw&oe=6AB67788"}, {"file_name": "com.medvr.EFast-20250611-113200.png", "id": "2450408521990534", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820987_2450408525323867_8010144908682949265_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IuuIMTVASI4Q7kNvwEUbFhR&_nc_oc=AdpR_b3Ef8j-IG65QS3zvdra-QNxHwOlLcRYWaBARPFmcSour9DI8evyfT8wQXskwJ4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKOxnKLq-hFLSvK1UTpik6FsMRDPmkllvDtyWPUMlF-Bw&oe=6AB69E69"}, {"file_name": "com.medvr.EFast-20250602-184537-0.00_00_19_14.Still002.png", "id": "1261329388919423", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827071_1261329392252756_4491137049392224278_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bkYqNCL9B6sQ7kNvwE_Ftam&_nc_oc=Adq0BDs9AGKaNC7IkyVNIsMK4Zn4-tGckMO1h6WOSFTYcuAYgxolsx18NwWlodTi5-A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIyF_pWERZBcvlSdbp_ZlU-6YGJbIRz9185rjeT8068iA&oe=6AB68C89"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "E-FAST for Trauma", "keywords": ["EFast", "VR", "Medvr", "Medical"], "long_description": "\"E-FAST for Trauma\" is a cutting-edge VR simulation designed to teach and reinforce the Extended Focused Assessment with Sonography for Trauma. Step into the role of a trauma responder and perform real-time ultrasound examinations in high-pressure emergency scenarios. This immersive training module helps learners identify pericardial, pleural, and intraperitoneal fluid with precision, enhancing diagnostic skills in critical care settings. Ideal for medical students, residents, and emergency medicine professionals, this simulation provides realistic anatomy, step-by-step guidance, and repeatable practice opportunities in a safe, virtual environment. Developed to bridge the gap between theory and clinical experience, \"E-FAST for Trauma\" delivers hands-on learning anytime, anywhere.\n\n", "short_description": "Experience hands-on training in Extended Focused Assessment with Sonography for Trauma (E-FAST) through immersive VR. Practice identifying internal bleeding and trauma-related injuries in real-time, interactive emergency scenarios. Ideal for medical students, residents, and healthcare professionals."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_conn
b=1-7&_nc_sid=6e7a0a&_nc_ohc=sEXEnTiJIJEQ7kNvwF5c0Dh&_nc_oc=Adpf-1IBWwpGiBKbS6gRqaILe8ZT6yh_QRbJF39zItzXdxQ6F3xiVrYOoyqaXN9HJrI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6BbqT3LscpOtnkDaonbmvrAHnJLRiLDUg3a-ek5LVUQ&oe=6AF324A9"}, {"file_name": "com.medvr.EFast-20250611-113150.png", "id": "516775641426673", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825009_516775644760006_1382766000675166165_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=98_upMDpQ0wQ7kNvwEBlwF5&_nc_oc=AdoadkJ2-vDO5ba2cBtOPntsse5nbAaiHVm2mboLVG0Q40NW8xn0CY91TdVEpIZWFVA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYnPi2kI9ML5ajF0Jj5bzbW9ln5kw8l_JswzAop2o2sA&oe=6AF32C5A"}, {"file_name": "com.medvr.EFast-20250602-184537-0.00_01_13_34.Still005.png", "id": "1100282135257857", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820596_1100282138591190_4637298414022001268_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YAIka-DMKQcQ7kNvwEbmxLZ&_nc_oc=AdokS4KDNySesKMdVqPHKCF4STHRqK_vQKKBqj0SahIR9UTMGBfDvCozHWesRoe892Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgkUSgR7hNn72vTXlTeoydq8_ES9kMakn8mQewewdNtQ&oe=6AF354C8"}, {"file_name": "com.medvr.EFast-20250611-113200.png", "id": "2450408521990534", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820987_2450408525323867_8010144908682949265_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qX-8kRG62SAQ7kNvwEy8EpI&_nc_oc=AdqQ8iQZOaUx-abGDG0NcGq0M7Nbrf8ef4spD5tVqkhZuQA57fXgQRYXAsr3Cf8D29w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvCEo6soGh8GXPqPtHAiP9ODJV1OebIY7MLgOtyAGc0Q&oe=6AF34369"}, {"file_name": "com.medvr.EFast-20250602-184537-0.00_00_19_14.Still002.png", "id": "1261329388919423", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827071_1261329392252756_4491137049392224278_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WvuB4Y0fkUoQ7kNvwFy5isg&_nc_oc=AdoEBad_hMGe5UdKCadbQklTNoZ0nQX6YV6IwV5vLjnxCTUREubuQi-2PzI0b4rzYBQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSayyH3hE4O1ZeL8_pzcUk8eG5qyWnNpxH0-DpKKyQYg&oe=6AF33189"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "E-FAST for Trauma", "keywords": ["EFast", "VR", "Medvr", "Medical"], "long_description": "\"E-FAST for Trauma\" is a cutting-edge VR simulation designed to teach and reinforce the Extended Focused Assessment with Sonography for Trauma. Step into the role of a trauma responder and perform real-time ultrasound examinations in high-pressure emergency scenarios. This immersive training module helps learners identify pericardial, pleural, and intraperitoneal fluid with precision, enhancing diagnostic skills in critical care settings. Ideal for medical students, residents, and emergency medicine professionals, this simulation provides realistic anatomy, step-by-step guidance, and repeatable practice opportunities in a safe, virtual environment. Developed to bridge the gap between theory and clinical experience, \"E-FAST for Trauma\" delivers hands-on learning anytime, anywhere.\n\n", "short_description": "Experience hands-on training in Extended Focused Assessment with Sonography for Trauma (E-FAST) through immersive VR. Practice identifying internal bleeding and trauma-related injuries in real-time, interactive emergency scenarios. Ideal for medical students, residents, and healthcare professionals."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_conn
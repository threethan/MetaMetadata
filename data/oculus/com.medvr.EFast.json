b=1-7&_nc_sid=6e7a0a&_nc_ohc=RRhTcYt-o1QQ7kNvwE9xiQk&_nc_oc=Adqe63mK9uRjRTMsiTGWsgOtoxwQMgzYp4gv-7ZmBYPvKGWqi3PdtA2PpZ0sbJcKtWY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJtiB4ArFcVxFo3cCYTSt4oelbh0J4U_binQMzp55FnQA&oe=6A9C21A9"}, {"file_name": "com.medvr.EFast-20250611-113150.png", "id": "516775641426673", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491825009_516775644760006_1382766000675166165_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W-dbB0WYlioQ7kNvwHOhMDj&_nc_oc=AdqPvCVxWDp0OOpO6b8JgxoLJd68fJVfcPv0MxdJLkBcjAK4Mqc9RCWrO6u_p9ZmjWQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJaYFtPRevQcBY6XttWcdA0EqfPeLv8u_YQfxzpU5ge0A&oe=6A9C295A"}, {"file_name": "com.medvr.EFast-20250602-184537-0.00_01_13_34.Still005.png", "id": "1100282135257857", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820596_1100282138591190_4637298414022001268_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Au1ZkIh9mvcQ7kNvwHfaGqf&_nc_oc=AdqMEVrGA6q73N4076pyHEFeTqLEQGIzAM5l-MIuYyAIlG8MdHnGjh0cmbwzfpBbCRQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIiD0o_OYYZTXVwDzrnOUo2a1Pt-vvgstJNPz5VaN6bkw&oe=6A9C1988"}, {"file_name": "com.medvr.EFast-20250611-113200.png", "id": "2450408521990534", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820987_2450408525323867_8010144908682949265_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u39gFIqQBvUQ7kNvwFILiWe&_nc_oc=AdpdfoQotxVRqNlck2Qd9PgoHctN-q2NcccvPo0PFjh7HGTjG6p4oikhja5HcdQQn8M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBRy6h2Dt2-XDr8ylteZJzuVmRvNmoHbhT3vnBxwVMqQ&oe=6A9C4069"}, {"file_name": "com.medvr.EFast-20250602-184537-0.00_00_19_14.Still002.png", "id": "1261329388919423", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827071_1261329392252756_4491137049392224278_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=85Q81CaUT_IQ7kNvwEHqYlO&_nc_oc=AdoYCLcQ9hE7mnOy4cf5GOMF_tvGSpNXycZNig552Kkf1HyRzOaXbfEeBaQMta5F4gE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6DijsPtaJ2WZTBc5TtwwQ2G6rO3MHgj4QpvQ95VkmGg&oe=6A9C2E89"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "E-FAST for Trauma", "keywords": ["EFast", "VR", "Medvr", "Medical"], "long_description": "\"E-FAST for Trauma\" is a cutting-edge VR simulation designed to teach and reinforce the Extended Focused Assessment with Sonography for Trauma. Step into the role of a trauma responder and perform real-time ultrasound examinations in high-pressure emergency scenarios. This immersive training module helps learners identify pericardial, pleural, and intraperitoneal fluid with precision, enhancing diagnostic skills in critical care settings. Ideal for medical students, residents, and emergency medicine professionals, this simulation provides realistic anatomy, step-by-step guidance, and repeatable practice opportunities in a safe, virtual environment. Developed to bridge the gap between theory and clinical experience, \"E-FAST for Trauma\" delivers hands-on learning anytime, anywhere.\n\n", "short_description": "Experience hands-on training in Extended Focused Assessment with Sonography for Trauma (E-FAST) through immersive VR. Practice identifying internal bleeding and trauma-related injuries in real-time, interactive emergency scenarios. Ideal for medical students, residents, and healthcare professionals."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_conn
729"}, {"file_name": "com.medvr.EFast-20250611-113150.png", "id": "516775641426673", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825009_516775644760006_1382766000675166165_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Scqjf1ek0IgQ7kNvwEg7DbU&_nc_oc=Ado1np5fJJxB_0YMAX3gj0FZnUUlwocZzlLcwktgqzH8QNiT1XpmizsYIxH_7zAY89s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7p6PEskSCEs9t5SUCxoqqm55aGi1flD8UzDiL4bXJeag&oe=6A145EDA"}, {"file_name": "com.medvr.EFast-20250602-184537-0.00_01_13_34.Still005.png", "id": "1100282135257857", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820596_1100282138591190_4637298414022001268_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8p8jq7Z_WLIQ7kNvwFuAWWG&_nc_oc=Adpz8NCeErlAhivSzTbkc6jvJnKJX8NYiwN9gKTz1qcZL2m5Fc97madVmrz_ZEi0-lw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af709BDj4HeVKEJE7jYC6aC6SsJxS-ZEvWlV0TKvFR-EGA&oe=6A144F08"}, {"file_name": "com.medvr.EFast-20250611-113200.png", "id": "2450408521990534", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820987_2450408525323867_8010144908682949265_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EtR5P3bB5CwQ7kNvwGqb40o&_nc_oc=AdojnMlSkSSEyBf1kLLi74LI038IOWe6r7HBlPi1g6Nz573wUIaZfT0qfccxtIP5ZTo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5g8R6Upvn3MCoLSWeSaKA38jO9NTKF8aUIzHTruYPe6w&oe=6A1475E9"}, {"file_name": "com.medvr.EFast-20250602-184537-0.00_00_19_14.Still002.png", "id": "1261329388919423", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827071_1261329392252756_4491137049392224278_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jrkRlmLG1rYQ7kNvwE0Q9zw&_nc_oc=AdpaIHaXGKxgPgeYHwD2a3blnqEwkxLfCtkhv5Abbe0pddZ9HWwPcrvvN66jzgGlkrY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7an3PvMuJQkltxebTRHWH_WBCNgVGEEtD8aDxHF8nsFA&oe=6A146409"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "E-FAST for Trauma", "keywords": ["EFast", "VR", "Medvr", "Medical"], "long_description": "\"E-FAST for Trauma\" is a cutting-edge VR simulation designed to teach and reinforce the Extended Focused Assessment with Sonography for Trauma. Step into the role of a trauma responder and perform real-time ultrasound examinations in high-pressure emergency scenarios. This immersive training module helps learners identify pericardial, pleural, and intraperitoneal fluid with precision, enhancing diagnostic skills in critical care settings. Ideal for medical students, residents, and emergency medicine professionals, this simulation provides realistic anatomy, step-by-step guidance, and repeatable practice opportunities in a safe, virtual environment. Developed to bridge the gap between theory and clinical experience, \"E-FAST for Trauma\" delivers hands-on learning anytime, anywhere.\n\n", "short_description": "Experience hands-on training in Extended Focused Assessment with Sonography for Trauma (E-FAST) through immersive VR. Practice identifying internal bleeding and trauma-related injuries in real-time, interactive emergency scenarios. Ideal for medical students, residents, and healthcare professionals."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes"
b=1-7&_nc_sid=6e7a0a&_nc_ohc=qrKD4bKxT9IQ7kNvwELgzSB&_nc_oc=Ado6mMRTRJkrh463XlmV04fbqFpLBaSmLGpkc-8kiJ0Rz791p93qAX3G6bnO2o1yVf0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-FIxrZ05i_RIsk8OE1H1CeVYfnBOMrDqKlLEjCYZD4A&oe=6AAAA229"}, {"file_name": "com.medvr.EFast-20250611-113150.png", "id": "516775641426673", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825009_516775644760006_1382766000675166165_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9m19GxJh_-MQ7kNvwHVyDP4&_nc_oc=Adp276PvdpSf_8PfNZVG1sQG1AWJIwvayy3eMl9dhdBiTE4JZZanKR4L1_NaVE1v3Fk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIVYnRsqiO7jkT_gjRc_oh6jV2gTgySb0GU6VFJojl4GA&oe=6AAAA9DA"}, {"file_name": "com.medvr.EFast-20250602-184537-0.00_01_13_34.Still005.png", "id": "1100282135257857", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820596_1100282138591190_4637298414022001268_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zHBwbNcXHqUQ7kNvwH6Vxsa&_nc_oc=AdpEDtUIzOwLcyH_DvZsyJHMgRGcz0dWhkG9wugWHIAZVlUzzKhj9FJ9EQfHmh8__Qk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJuPoTEdB4qMjGkQYmqPZbX1iAmJxmE9SrWz_WxHdGW7w&oe=6AAA9A08"}, {"file_name": "com.medvr.EFast-20250611-113200.png", "id": "2450408521990534", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820987_2450408525323867_8010144908682949265_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uBiZX6Pn3EsQ7kNvwHkTtwd&_nc_oc=AdpANPH7qnwXFrk5ELTKYVtOAc9ynGhUdPyeis2STVtq_1lIYZHMEbvSbP7AmRITS70&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJTm_CX5aVsqyVHHgv03jqyA-MU3qyPNJELCcS0kGHoWA&oe=6AAA88A9"}, {"file_name": "com.medvr.EFast-20250602-184537-0.00_00_19_14.Still002.png", "id": "1261329388919423", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827071_1261329392252756_4491137049392224278_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=heWrfj5x4nYQ7kNvwEHB5Qj&_nc_oc=Adq93B54H6D9AbZVbxtYxwVYtRgEiu3gMl5Bcmy-fHt1cXE1AoOf8EFSAuTFmQ_wLnA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJATWTSQCcwfkgpbuKWHbcgBAr_mIG98Q02mc1aT0Rl4Q&oe=6AAAAF09"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "E-FAST for Trauma", "keywords": ["EFast", "VR", "Medvr", "Medical"], "long_description": "\"E-FAST for Trauma\" is a cutting-edge VR simulation designed to teach and reinforce the Extended Focused Assessment with Sonography for Trauma. Step into the role of a trauma responder and perform real-time ultrasound examinations in high-pressure emergency scenarios. This immersive training module helps learners identify pericardial, pleural, and intraperitoneal fluid with precision, enhancing diagnostic skills in critical care settings. Ideal for medical students, residents, and emergency medicine professionals, this simulation provides realistic anatomy, step-by-step guidance, and repeatable practice opportunities in a safe, virtual environment. Developed to bridge the gap between theory and clinical experience, \"E-FAST for Trauma\" delivers hands-on learning anytime, anywhere.\n\n", "short_description": "Experience hands-on training in Extended Focused Assessment with Sonography for Trauma (E-FAST) through immersive VR. Practice identifying internal bleeding and trauma-related injuries in real-time, interactive emergency scenarios. Ideal for medical students, residents, and healthcare professionals."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_conn
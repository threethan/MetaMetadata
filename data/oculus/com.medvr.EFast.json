b=1-7&_nc_sid=6e7a0a&_nc_ohc=WnY3lr323m4Q7kNvwHJM-99&_nc_oc=AdqSpzVsZtlb9BleqBNE-DK3g_K0Vlqbh7uH_wvyMFREoKG490k4sR53bf0owUPPyV8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-IlDqUDc0VdjD0gASHCpoJNHr5iyLSQd-rxg2T3DHSA&oe=6A92AEE9"}, {"file_name": "com.medvr.EFast-20250611-113150.png", "id": "516775641426673", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825009_516775644760006_1382766000675166165_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YDiwwWMgFrwQ7kNvwETefvh&_nc_oc=Adre0s57HghTZGWH7Q7cP6BpmkX8bG18odHwOhw3ie-P_qGD7U09w4Dr7qU6KqP9_kU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGopvNXOeuLFq98DiHdbdZK9s9UXNEI5V_qivnPsM0_rw&oe=6A92B69A"}, {"file_name": "com.medvr.EFast-20250602-184537-0.00_01_13_34.Still005.png", "id": "1100282135257857", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491820596_1100282138591190_4637298414022001268_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=egJneQntXu8Q7kNvwHuT32P&_nc_oc=AdqnCQDwcpB4ZQt13E4jzfo46OQQ_3IuouzA_SD4MZNIcKY3for4PEbTnpWqkxv02ZI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFR8MITNPy2Pl6BM7b6W_2LQ9OEM1QkeKacaEa3QaRdqw&oe=6A92DF08"}, {"file_name": "com.medvr.EFast-20250611-113200.png", "id": "2450408521990534", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820987_2450408525323867_8010144908682949265_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=exHtijWwpUUQ7kNvwHIER0a&_nc_oc=AdqrsXS_Bn1_hE54TNpTsjuCIFSLKwRpQ85omEPyGZk0twBYE7_5bfH6bgUMYW4M4KQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgLbjH__g7e6wYKREuqDDP8WGg8UFgVA187LhFbVDEmg&oe=6A92CDA9"}, {"file_name": "com.medvr.EFast-20250602-184537-0.00_00_19_14.Still002.png", "id": "1261329388919423", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827071_1261329392252756_4491137049392224278_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y4OlvK1ovRMQ7kNvwG1CdNc&_nc_oc=AdpivKT5qCkdjm9Nf8E5R4lmdRmRf1Dya4pdZBkFHCn7NPALgh_MwnWdEzqU0agtAT0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgFqDILGn1VJrrOcN-V3PCW5l1LTTAImwOr30P8AakeQ&oe=6A92BBC9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "E-FAST for Trauma", "keywords": ["EFast", "VR", "Medvr", "Medical"], "long_description": "\"E-FAST for Trauma\" is a cutting-edge VR simulation designed to teach and reinforce the Extended Focused Assessment with Sonography for Trauma. Step into the role of a trauma responder and perform real-time ultrasound examinations in high-pressure emergency scenarios. This immersive training module helps learners identify pericardial, pleural, and intraperitoneal fluid with precision, enhancing diagnostic skills in critical care settings. Ideal for medical students, residents, and emergency medicine professionals, this simulation provides realistic anatomy, step-by-step guidance, and repeatable practice opportunities in a safe, virtual environment. Developed to bridge the gap between theory and clinical experience, \"E-FAST for Trauma\" delivers hands-on learning anytime, anywhere.\n\n", "short_description": "Experience hands-on training in Extended Focused Assessment with Sonography for Trauma (E-FAST) through immersive VR. Practice identifying internal bleeding and trauma-related injuries in real-time, interactive emergency scenarios. Ideal for medical students, residents, and healthcare professionals."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_conn
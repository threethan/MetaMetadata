b=1-7&_nc_sid=6e7a0a&_nc_ohc=4UMYEdVZNIUQ7kNvwGG188X&_nc_oc=AdoiVoWI-Ep3z3rvXavGC5zvd7aWuE7rF9peVCx1Bm-z1aQdMnqrNqla1w1VCz_RYo4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKUT6b0GLg1kAUS6eRMv9Tvu4rkYgppuPsJBrh9e39sw&oe=6AE5F5A9"}, {"file_name": "com.medvr.EFast-20250611-113150.png", "id": "516775641426673", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825009_516775644760006_1382766000675166165_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k-JGySvjW_4Q7kNvwGKDjvu&_nc_oc=AdrQz3lZjI3ki6rC-8QmpLA1qxw7yYTlYUld0G8qI2FHhhHZssaiV77gAF0rM-jr_dY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPnnlvzqie2WZkBRhm7kncv_tJSPinzl0fSolq2F9jNbQ&oe=6AE5FD5A"}, {"file_name": "com.medvr.EFast-20250602-184537-0.00_01_13_34.Still005.png", "id": "1100282135257857", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820596_1100282138591190_4637298414022001268_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=omTJjyzdEcIQ7kNvwGD0lFB&_nc_oc=AdqLvta7vdwuiS385jU2Wqni5hZKz-Oj_GNuz7F_ko3YAKWm7o2D5wcGu8Z9ldGibxI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMR9axiaVUU1J1orLaiCHHQyJgt6XqknSELLqNY4YSnDA&oe=6AE5ED88"}, {"file_name": "com.medvr.EFast-20250611-113200.png", "id": "2450408521990534", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820987_2450408525323867_8010144908682949265_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7VDABlNNy9IQ7kNvwGPxOuQ&_nc_oc=Ado5tj2yqVWIiRcRN0g5dO9EehnTxhJPHN-L9RZ_yqMfLlz3KRij6aJ_5aUFPx91Ing&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOhC0tlev3LrIXUL0Z79UkV8JwsZblFUYMJ-Dx2SyIgiw&oe=6AE61469"}, {"file_name": "com.medvr.EFast-20250602-184537-0.00_00_19_14.Still002.png", "id": "1261329388919423", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827071_1261329392252756_4491137049392224278_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4OCjB0lbWKAQ7kNvwGighJV&_nc_oc=AdrALrPf8X1dpI8p2yBg3XkcarpWIyUI9Tv_uTlTsfgwXU-Gy9DGJd7cVLv9uU1GRuI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP13XjvJ48HL6prdjPG7FvXSknVRCxRV97fxukVlUfI4A&oe=6AE60289"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "E-FAST for Trauma", "keywords": ["EFast", "VR", "Medvr", "Medical"], "long_description": "\"E-FAST for Trauma\" is a cutting-edge VR simulation designed to teach and reinforce the Extended Focused Assessment with Sonography for Trauma. Step into the role of a trauma responder and perform real-time ultrasound examinations in high-pressure emergency scenarios. This immersive training module helps learners identify pericardial, pleural, and intraperitoneal fluid with precision, enhancing diagnostic skills in critical care settings. Ideal for medical students, residents, and emergency medicine professionals, this simulation provides realistic anatomy, step-by-step guidance, and repeatable practice opportunities in a safe, virtual environment. Developed to bridge the gap between theory and clinical experience, \"E-FAST for Trauma\" delivers hands-on learning anytime, anywhere.\n\n", "short_description": "Experience hands-on training in Extended Focused Assessment with Sonography for Trauma (E-FAST) through immersive VR. Practice identifying internal bleeding and trauma-related injuries in real-time, interactive emergency scenarios. Ideal for medical students, residents, and healthcare professionals."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_conn
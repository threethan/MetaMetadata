scdn.com&_nc_ss=7f20f&oh=00_Af1tjSZccoMp5eOYrcLJWeYEvCNXGSAo6E-e84TR-XXO-g&oe=69F60C5A"}, {"file_name": "com.medvr.EFast-20250602-184537-0.00_01_13_34.Still005.png", "id": "1100282135257857", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491820596_1100282138591190_4637298414022001268_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K6uwb416cF0Q7kNvwGX3pda&_nc_oc=AdqBYctTRIwnuxRlFjcZxdWJvINTV9InjKju04k7Om4442DlOXq5J4m_WnvxMGKD9Yo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3EWtjfhzoXTwgeeD4yyO_8pswcRJ2pE-7h4GSGhS2x8A&oe=69F5FC88"}, {"file_name": "com.medvr.EFast-20250611-113200.png", "id": "2450408521990534", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491820987_2450408525323867_8010144908682949265_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=32_F2HeLzy8Q7kNvwGXBgmA&_nc_oc=AdrUqGhB4OBQeRVsWPXJZZHx-AZXJxEi5oZ-b7DbGPPPskVYXKOEm3XhZ9D-kvjr_l8&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0Xtwt3q9A3dtQ9VaNPw2lCAcWx0rnm_JVedNNwqiiGcg&oe=69F5EB29"}, {"file_name": "com.medvr.EFast-20250602-184537-0.00_00_19_14.Still002.png", "id": "1261329388919423", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491827071_1261329392252756_4491137049392224278_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zTdWuF17yOQQ7kNvwEQ52oi&_nc_oc=AdqE1y8u0oqG8zgm6GQhibhEJUYm2AVt8KrSEwVJKl_j2EOyABn4FkJ4714aZeAwsjo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1qXjZtG6kRndIAxYwdpP8Dzo8PO2mv2YfOmYe2A0J0OA&oe=69F61189"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "E-FAST for Trauma", "keywords": ["EFast", "VR", "Medvr", "Medical"], "long_description": "\"E-FAST for Trauma\" is a cutting-edge VR simulation designed to teach and reinforce the Extended Focused Assessment with Sonography for Trauma. Step into the role of a trauma responder and perform real-time ultrasound examinations in high-pressure emergency scenarios. This immersive training module helps learners identify pericardial, pleural, and intraperitoneal fluid with precision, enhancing diagnostic skills in critical care settings. Ideal for medical students, residents, and emergency medicine professionals, this simulation provides realistic anatomy, step-by-step guidance, and repeatable practice opportunities in a safe, virtual environment. Developed to bridge the gap between theory and clinical experience, \"E-FAST for Trauma\" delivers hands-on learning anytime, anywhere.\n\n", "short_description": "Experience hands-on training in Extended Focused Assessment with Sonography for Trauma (E-FAST) through immersive VR. Practice identifying internal bleeding and trauma-related injuries in real-time, interactive emergency scenarios. Ideal for medical students, residents, and healthcare professionals."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "30059640770347198"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1461754958531266"}]}, "baseline_offer": {"id": "1461754958531266"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1750144260, "status": "PUBLISHED", "i
b=1-7&_nc_sid=6e7a0a&_nc_ohc=IxQL3m8sGtoQ7kNvwGhKS_A&_nc_oc=Adr5gVLIrSEwGrEE5aNAjS6NtZE9Mja37zXt5O2wCkJLfniKRx7_WX_TUm_WQ5oTDtE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFD47ZXmlw5hTFYwFDKO9_w4E9MwFmeOxaTQBg16zRKvQ&oe=6A7B2C29"}, {"file_name": "com.medvr.EFast-20250611-113150.png", "id": "516775641426673", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825009_516775644760006_1382766000675166165_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JTl1289NjNQQ7kNvwEAEVU7&_nc_oc=AdopoHJG1-avw33PjifY2fUkkYuQyIhaMlckLW5JJ0d9c0UKrlo59iZ9hOyBqCmgLU4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0fcNCEYeO6glgy4qTjL4NfrItsF1_9TVXnnWuttlN4A&oe=6A7B33DA"}, {"file_name": "com.medvr.EFast-20250602-184537-0.00_01_13_34.Still005.png", "id": "1100282135257857", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820596_1100282138591190_4637298414022001268_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GLXU9GA4pMsQ7kNvwHibYpt&_nc_oc=AdqbqxBYiahtRIHYluuWn4-MYBUWK53kP5odwVmqp5u-PxW-Kt37PwKHfiNqPtWjkP0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGt-lratN2n2OXwlQRfDiShKKw3PiVEhd_q-LLqokgmKg&oe=6A7B2408"}, {"file_name": "com.medvr.EFast-20250611-113200.png", "id": "2450408521990534", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820987_2450408525323867_8010144908682949265_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1sbJfQL-wnYQ7kNvwHbNBAg&_nc_oc=AdolpdWTYHdFOA4IRSek97TxE05Kv2X8Fe-YSAUDpIIV9x5w20fCPF0JjnIlg87sas4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHmeL5ZOhR0U8rdwzQvMigO8DXk-Di8APs6rS6aSLYJcw&oe=6A7B12A9"}, {"file_name": "com.medvr.EFast-20250602-184537-0.00_00_19_14.Still002.png", "id": "1261329388919423", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827071_1261329392252756_4491137049392224278_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LxwzDJFtJWEQ7kNvwGvy12x&_nc_oc=AdoBQ6m0KAvpEBwrzNiEruSFnK_MA8KXprV6jB2OLArThULhU5e-MCHhsfKMFCww3jo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4XYw0RaDWOlGBdnvLPHw56IfE2AIXcjIj_S7kYOw7Og&oe=6A7B3909"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "E-FAST for Trauma", "keywords": ["EFast", "VR", "Medvr", "Medical"], "long_description": "\"E-FAST for Trauma\" is a cutting-edge VR simulation designed to teach and reinforce the Extended Focused Assessment with Sonography for Trauma. Step into the role of a trauma responder and perform real-time ultrasound examinations in high-pressure emergency scenarios. This immersive training module helps learners identify pericardial, pleural, and intraperitoneal fluid with precision, enhancing diagnostic skills in critical care settings. Ideal for medical students, residents, and emergency medicine professionals, this simulation provides realistic anatomy, step-by-step guidance, and repeatable practice opportunities in a safe, virtual environment. Developed to bridge the gap between theory and clinical experience, \"E-FAST for Trauma\" delivers hands-on learning anytime, anywhere.\n\n", "short_description": "Experience hands-on training in Extended Focused Assessment with Sonography for Trauma (E-FAST) through immersive VR. Practice identifying internal bleeding and trauma-related injuries in real-time, interactive emergency scenarios. Ideal for medical students, residents, and healthcare professionals."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_conn
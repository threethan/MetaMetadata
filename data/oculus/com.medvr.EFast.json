b=1-7&_nc_sid=6e7a0a&_nc_ohc=IxQL3m8sGtoQ7kNvwH-hu3Z&_nc_oc=AdrtNli2tEC_qr8OhjugPof3neY5m5GMWpmniP7RawD-z35bh914533IrfXQj5iOYlM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWxWfVVBPHYFMZwDHumIcgorXhAi1BolIZRwo7CL4MwQ&oe=6A788929"}, {"file_name": "com.medvr.EFast-20250611-113150.png", "id": "516775641426673", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825009_516775644760006_1382766000675166165_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mR9rwCnPU4cQ7kNvwHwv9F8&_nc_oc=AdoOw8U6mgbSM67alJ0lfiAN6MZEqZrZsXtAHv3qDEN2oQSH-NRxEQJFn5kv_5aR9qw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_RDLpcgL_CSB1Svg9b1OVfcpyHYx3J8x3OFM9fvMVmg&oe=6A7890DA"}, {"file_name": "com.medvr.EFast-20250602-184537-0.00_01_13_34.Still005.png", "id": "1100282135257857", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820596_1100282138591190_4637298414022001268_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GLXU9GA4pMsQ7kNvwE41Tdp&_nc_oc=Adp9DUJfw1yv-0RfeClDVjwXZ25RObMhlF93CRUNMB0qDD2WRiRj9nEJUmhIY43Srjk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFxopeRNA_70EvYDCMa2kQNR9zXlnZ2Ak1MU1gOnuZzTg&oe=6A788108"}, {"file_name": "com.medvr.EFast-20250611-113200.png", "id": "2450408521990534", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820987_2450408525323867_8010144908682949265_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1sbJfQL-wnYQ7kNvwHrBmqk&_nc_oc=Ado4i0J_XVh4bERB-tCrxOZWRtfkSsuPhtzvAt-qM0j79a9SGwj8SQuGra66cuuuCFI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6bQrlZYVL9SSaZsqftRZskDVZMN4yksn5zLzPkpdJGg&oe=6A786FA9"}, {"file_name": "com.medvr.EFast-20250602-184537-0.00_00_19_14.Still002.png", "id": "1261329388919423", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827071_1261329392252756_4491137049392224278_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aF2bGkszM0kQ7kNvwGyYhuU&_nc_oc=Ado79V2OBxA2j-4TbbR6iRnYvYayXkLHsN2CSWoty8o2hqDBzx5nyWIzbQ2uV7MrblI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGn7OaPL81kUsw2AsAV1JxfQNT7lZIsDDhnNZiEql0bJw&oe=6A789609"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "E-FAST for Trauma", "keywords": ["EFast", "VR", "Medvr", "Medical"], "long_description": "\"E-FAST for Trauma\" is a cutting-edge VR simulation designed to teach and reinforce the Extended Focused Assessment with Sonography for Trauma. Step into the role of a trauma responder and perform real-time ultrasound examinations in high-pressure emergency scenarios. This immersive training module helps learners identify pericardial, pleural, and intraperitoneal fluid with precision, enhancing diagnostic skills in critical care settings. Ideal for medical students, residents, and emergency medicine professionals, this simulation provides realistic anatomy, step-by-step guidance, and repeatable practice opportunities in a safe, virtual environment. Developed to bridge the gap between theory and clinical experience, \"E-FAST for Trauma\" delivers hands-on learning anytime, anywhere.\n\n", "short_description": "Experience hands-on training in Extended Focused Assessment with Sonography for Trauma (E-FAST) through immersive VR. Practice identifying internal bleeding and trauma-related injuries in real-time, interactive emergency scenarios. Ideal for medical students, residents, and healthcare professionals."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_conn
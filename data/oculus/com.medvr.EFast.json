b=1-7&_nc_sid=6e7a0a&_nc_ohc=rB4ofqhQvw0Q7kNvwG9HSmb&_nc_oc=AdpJ6VheDU0USMG9BtyobaFHI7S6K3uluCKYGtoQpaKnVNl-P2v9yfdIfnvoMekN6Cg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOvNlb0ou1Ou7-eL7zhbo_YtUXqSTLSX_qDNizDFLXFWA&oe=6ACA4629"}, {"file_name": "com.medvr.EFast-20250611-113150.png", "id": "516775641426673", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825009_516775644760006_1382766000675166165_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NiinAj74sJkQ7kNvwHoOZXu&_nc_oc=Adp6o4sKdtYr8lAceJssukSZ-Yf8pdiXk_Rcy_VNWKjoWNWyXwmm2WK90jYSpiaCffw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOjl9aXofIZOQsz-3SVJ9h1BoZuDcgu3ypJfXuM8tsULA&oe=6ACA4DDA"}, {"file_name": "com.medvr.EFast-20250602-184537-0.00_01_13_34.Still005.png", "id": "1100282135257857", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820596_1100282138591190_4637298414022001268_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fzj8MmH1B1UQ7kNvwHwmfey&_nc_oc=AdpTyJh-GqzNx6NR8b6NnctAyK1c2C9__PCfFwD8_Bxi4wdxu1MnYuYPFBkZI21Cdx0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPHPyXN8LM6OHpdjewH285Tf2798POXhyByLKrVRwpkEQ&oe=6ACA7648"}, {"file_name": "com.medvr.EFast-20250611-113200.png", "id": "2450408521990534", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820987_2450408525323867_8010144908682949265_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EHpUVNZR364Q7kNvwFMQfvX&_nc_oc=Adogd8rpsWD7RqLpV2V-Dc0PhDdazv9LaGPqIW0tYVjqUm_0CslETPza8yqkpM5TtaU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNg8jfHxb4xrZckgoshyxCH1OgpMQ0eI-peCITwgmw8cQ&oe=6ACA64E9"}, {"file_name": "com.medvr.EFast-20250602-184537-0.00_00_19_14.Still002.png", "id": "1261329388919423", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827071_1261329392252756_4491137049392224278_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pe6DKbeeCpcQ7kNvwFif0zF&_nc_oc=AdpnhhM_q5SnW_PeWkMhcpVREuDgtkZ8AXXa2_mKV-cLFuVxaRPispBQ6BK0j7vKq4Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPe5oSllou-QltvWDH-dZzz1a2p4YkYi59IJXc593YrgQ&oe=6ACA5309"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "E-FAST for Trauma", "keywords": ["EFast", "VR", "Medvr", "Medical"], "long_description": "\"E-FAST for Trauma\" is a cutting-edge VR simulation designed to teach and reinforce the Extended Focused Assessment with Sonography for Trauma. Step into the role of a trauma responder and perform real-time ultrasound examinations in high-pressure emergency scenarios. This immersive training module helps learners identify pericardial, pleural, and intraperitoneal fluid with precision, enhancing diagnostic skills in critical care settings. Ideal for medical students, residents, and emergency medicine professionals, this simulation provides realistic anatomy, step-by-step guidance, and repeatable practice opportunities in a safe, virtual environment. Developed to bridge the gap between theory and clinical experience, \"E-FAST for Trauma\" delivers hands-on learning anytime, anywhere.\n\n", "short_description": "Experience hands-on training in Extended Focused Assessment with Sonography for Trauma (E-FAST) through immersive VR. Practice identifying internal bleeding and trauma-related injuries in real-time, interactive emergency scenarios. Ideal for medical students, residents, and healthcare professionals."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_conn
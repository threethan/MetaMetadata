b=1-7&_nc_sid=6e7a0a&_nc_ohc=Ayaklt-4fdcQ7kNvwHhtZS6&_nc_oc=Adp8b23M-iTcT1L6TqrH_fSduPMwaEC0KpMOkVodhigLiC37fVy-SnC5KOngzAMZ-0g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPx7L2YoLGqnDRWAg5-plffnQzQE7gJJXa93l7jiMD0Q&oe=6AEF6869"}, {"file_name": "com.medvr.EFast-20250611-113150.png", "id": "516775641426673", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825009_516775644760006_1382766000675166165_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rKnt57v2xAgQ7kNvwG6n4-a&_nc_oc=AdozAiJG9PHaN6NKH5NxdKYPQ64-9P5T-wJ3h8i-lFCepsboroScDAQpy2JbVh-CuUQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQl7uCrEdTZ9-Bh-9ZPFngPBraHoxLg3l26rqcQEni1hg&oe=6AEF37DA"}, {"file_name": "com.medvr.EFast-20250602-184537-0.00_01_13_34.Still005.png", "id": "1100282135257857", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820596_1100282138591190_4637298414022001268_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WVHMTvYb7_kQ7kNvwFHequI&_nc_oc=AdqiG0QU6DGsytZ-8P1s3-EhiHcVO-25YYxWmTBl65JyVuqus1ieU9Ht0HFnWWFJKTU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgh-pJjsEoOpzlbriWHQ_xD2xxCkGENVa9Q644UOnSHg&oe=6AEF6048"}, {"file_name": "com.medvr.EFast-20250611-113200.png", "id": "2450408521990534", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820987_2450408525323867_8010144908682949265_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y0rxD6Dnti8Q7kNvwEUv8fo&_nc_oc=AdrEV8Ucu1xGuXCHpM2WBd_pm5_XcOzwww94e5i2SDoij0xvbjZpQi23MUc92Eo7weM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjGy2frxtYCMJIkjQSBt1wcFMdCU2dzsKKLgWLCJhpSQ&oe=6AEF4EE9"}, {"file_name": "com.medvr.EFast-20250602-184537-0.00_00_19_14.Still002.png", "id": "1261329388919423", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827071_1261329392252756_4491137049392224278_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nPGESvEC-lQQ7kNvwGMoJ8i&_nc_oc=AdpzQ2yTu7XTUCY0hUtqRgsw_hgpmqJQQo5FWKrahFt3Vg2S_o6D3kqCsIe4WXdeNCI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThxShPpiaZlh4gJlhpw4VQVEJT3g8VOpG1TEO8soqOxw&oe=6AEF3D09"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "E-FAST for Trauma", "keywords": ["EFast", "VR", "Medvr", "Medical"], "long_description": "\"E-FAST for Trauma\" is a cutting-edge VR simulation designed to teach and reinforce the Extended Focused Assessment with Sonography for Trauma. Step into the role of a trauma responder and perform real-time ultrasound examinations in high-pressure emergency scenarios. This immersive training module helps learners identify pericardial, pleural, and intraperitoneal fluid with precision, enhancing diagnostic skills in critical care settings. Ideal for medical students, residents, and emergency medicine professionals, this simulation provides realistic anatomy, step-by-step guidance, and repeatable practice opportunities in a safe, virtual environment. Developed to bridge the gap between theory and clinical experience, \"E-FAST for Trauma\" delivers hands-on learning anytime, anywhere.\n\n", "short_description": "Experience hands-on training in Extended Focused Assessment with Sonography for Trauma (E-FAST) through immersive VR. Practice identifying internal bleeding and trauma-related injuries in real-time, interactive emergency scenarios. Ideal for medical students, residents, and healthcare professionals."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_conn
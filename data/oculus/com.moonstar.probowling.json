oc=Adq-oEzOgpQUvxXswMH-Sxh6HfN6sf67w3GNTswvyBsaId-EcmdWfyEC77urUavDDyQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBMMnJWTjfBFuoqhQgylgyQZ6qzi7EzZlV6W4AQhQDVw&oe=6AEDEFB1"}, {"file_name": "migrated_image.png", "id": "201811821110842", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982559_1211352452359901_1653211106404990976_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gjvk8l1cpusQ7kNvwHVPrP6&_nc_oc=AdoM84Rlqy8oKKWWbIzwMU-4FM2V17HfzQ47wOKVrasHnh0mIZ-kf6wLdfSboW1OSwE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3OOjVaNjojUbFTZFxCPu6THDpHWu0wOyOf8liUjXWbA&oe=6AEDF1F4"}, {"file_name": "migrated_image.png", "id": "196159655021180", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974876_480368835864611_6173717808111681536_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=87rCSzxZRbwQ7kNvwHkbwnq&_nc_oc=AdoqFq_KqxG0tIKkYCex75bzDSFJPLUQnxwI5MsAP1TCB2BMNQwouS6h6-IgZ8h638U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZ41t9vn-euZ8RvfSK1bwaueNuc6tqu4Td1mf3JRqI3g&oe=6AEDD8AD"}, {"file_name": "migrated_image.png", "id": "286926512302306", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974503_2971137249627887_2738815793285300224_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p09BMTpgq3oQ7kNvwFCsbLA&_nc_oc=Adp06p1Cp1qt6JBeKeZo8JL-arISZbhVV8lgWx3rbUqBpUAMxjw-j4-AP_4mOP3_bVE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdB4MxCPLqBMqkY8JNt12hkQZpSey0ef0yN-8gL2EmUw&oe=6AEDF1A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1a.png", "id": "796339428369487", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974474_796339431702820_5955742702304479792_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ynaDqQUl8hYQ7kNvwHbG972&_nc_oc=Adpl1f3cKuhE0-dFxHbbhqcu-Mc67Cz3mrr5mHnXaWeVgaW4rzy9zFa-xFim0k-66U8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8y0f6Xdsi3c7g1edVigZK0bhwyYQBQFzxvFyMxnjpKg&oe=6AEDD8EA"}, "display_name": "Pro Bowling Social", "keywords": ["bowling", "tenpin", "multiplayer", "sport", "sports"], "long_description": "Bowling is a fun sports game but you need go to a club since it requires a large space to play. With Pro Bowling Social you can play bowling in the comfort of your home. \nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them."}]}, "developer_name": "Moonstar Games", "developer_privacy_policy_url": "https://www.moonstargames.com/bowling_privacy.html", "developer_terms_of_service_url": "https://www.moonstargames.com/bowling_terms.html", "publisher_name": "Moonstar Games", "support_website_url": "http://www.moonstargames.com/", "website_url": "https://www.moonstargames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7978772488821844"}, "review_messages":
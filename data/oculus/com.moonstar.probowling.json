oc=AdqK3xa8HW-5Cirrf5FRlYxrjXcdSM3hqALGB8YuBj4inLfCQOMtIZA3tcX-pPR7Jwk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1Q_yuNecnAWdX_TuXd6oxPB3jCjIp6Jb8iJA4kAXOkwA&oe=69F615B1"}, {"file_name": "migrated_image.png", "id": "201811821110842", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982559_1211352452359901_1653211106404990976_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0W32UHX-AFUQ7kNvwGHGcLn&_nc_oc=AdqrujvPjBMpSM0-_uL6O4i7GmWrju2ztbg_90KJd3cmP0CMjMHrbrD--7_zG3lB4uo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0VXBJnJi02SfJv4o587UjQZfAlt75YQwAarcQu3WfgRw&oe=69F617F4"}, {"file_name": "migrated_image.png", "id": "196159655021180", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974876_480368835864611_6173717808111681536_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F0UtX-zFqPAQ7kNvwHChrTK&_nc_oc=AdovKHtrx2ZHUCaRhLpFwLl1OufEPoWYpZ0XNnSjcfnjhW8bMJXYFuHHnae16A0LMbc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af247JsgO1fWNO5KtWc_g0OLIYjCoeDqed-OMBHAjNk2UA&oe=69F5FEAD"}, {"file_name": "migrated_image.png", "id": "286926512302306", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974503_2971137249627887_2738815793285300224_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DZzr-NbVAHAQ7kNvwFxUhif&_nc_oc=AdpA5nLA1G0JG6LiaAGgiBZ6VuS6--SmGHV8tPnkmM_bL8Kp1QdLjUuneXDup04we0c&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0a2_DRzuAHYdGwGWXWtdfjKavWIUOoncDfnA_xNAq5fg&oe=69F617A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1a.png", "id": "796339428369487", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974474_796339431702820_5955742702304479792_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1q1HLo1fCnUQ7kNvwEES1yH&_nc_oc=Adq6LoLNvK16qxFh1BubbTGDfFPyv9oDsviQo5wvVpIvmyvtYCY_eqgNU8w_cOFW_HM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0tG2nOQdlbDDSxybyFS8zk2HEe2mHLb448cMyFdUaF9w&oe=69F5FEEA"}, "display_name": "Pro Bowling Social", "keywords": ["bowling", "tenpin", "multiplayer", "sport", "sports"], "long_description": "Bowling is a fun sports game but you need go to a club since it requires a large space to play. With Pro Bowling Social you can play bowling in the comfort of your home. \nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them."}]}, "developer_name": "Moonstar Games", "developer_privacy_policy_url": "https://www.moonstargames.com/bowling_privacy.html", "developer_terms_of_service_url": "https://www.moonstargames.com/bowling_terms.html", "publisher_name": "Moonstar Games", "support_website_url": "http://www.moonstargames.com/", "website_url": "https://www.moonstargames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7978772488821844"}, "review_messages":
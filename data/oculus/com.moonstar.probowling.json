107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jSww6uOUXsoQ7kNvwF8lFL3&_nc_oc=AdpCyUmLlCxezjNrsXuz4_XJ3cp8i8tf069xzSUGA-bK27RO56k0oCzhWUdMafHeVDA&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3ERyxm6c0TuWhagJl8HElUWGFoZbVoAw1_YnmZO_M7Q&oe=6A22D1AD"}, {"file_name": "migrated_image.png", "id": "286926512302306", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974503_2971137249627887_2738815793285300224_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sxRHyjrIpBcQ7kNvwHBiiTl&_nc_oc=AdqGkT4wPdCOdq3D0LbDBmhrbDE3DRMvz0vcx0QMHdvsum1LZ34lYahiLb-3Qu-mWIA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_KdLuSktcCVqCHV_j97HY6JWiJAjnOCuOsS7v6g24M4w&oe=6A22EAA2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pro Bowling Social", "keywords": ["bowling", "tenpin", "multiplayer", "sport", "sports"], "long_description": "Bowling is a fun sports game but you need go to a club since it requires a large space to play. With Pro Bowling Social you can play bowling in the comfort of your home. \nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them."}]}, "developer_name": "Moonstar Games", "developer_privacy_policy_url": "https://probowlingsocial.com/privacy.html", "developer_terms_of_service_url": "https://probowlingsocial.com/terms.html", "publisher_name": "Moonstar Games
oc=AdoPasBQaPNHK7t3S00KwvED5vmTYPnNZroa46mvq-JMNOiA2iViAhEjX8SNrRvD7rg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMWXqdKGYOa8dQsvBvGUCYBPGaze73Zrdm-6nJjpm9fDA&oe=6AC905B1"}, {"file_name": "migrated_image.png", "id": "201811821110842", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982559_1211352452359901_1653211106404990976_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BkJcx2l6KTEQ7kNvwFPFk2E&_nc_oc=AdoU_KipzYhqQVrBqdpkH1V16HpqBRMRV2M_CiobfC1K54XpcgADQUp2aUwfURqNH0A&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOrfHZBFmH8HyhTo08inEDRir2S1PNgy4fDZVGsxduUHw&oe=6AC907F4"}, {"file_name": "migrated_image.png", "id": "196159655021180", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974876_480368835864611_6173717808111681536_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MGoIAEFl0ucQ7kNvwECf6p5&_nc_oc=AdooMsZ0-fl1DNeNGdNM3WBJqkfxiaZIO-AjayNG5i3Qkn7XNpmTEA1cTob9aPuM24A&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM0gVcxHZQi1CqE8CIwthEr4KeK7sm896rhhFev1Kskgw&oe=6AC8EEAD"}, {"file_name": "migrated_image.png", "id": "286926512302306", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974503_2971137249627887_2738815793285300224_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5JI6eil9UYkQ7kNvwESw7am&_nc_oc=AdqPR4rz0WPpOBnEet3oofRB-c8RSefK6RvJIJdNQWn2HihMDIfjMovg22BqSqq9zag&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN68a0kBDBti_u4hGhlxK4Iee9Ei2MECCbOyPF_7F3qkA&oe=6AC907A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1a.png", "id": "796339428369487", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974474_796339431702820_5955742702304479792_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uL4OaSGIAMEQ7kNvwGZnD_E&_nc_oc=AdqHCtbThJfS0IewGJyiseIb-H_h1h9_89CkCHczMFAbs7Rx7NCEUzGGM00TczSpSEo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOlFW-fzS59EC8CBxJ7ijhYC67tpnAcy0C03uDq45q4GQ&oe=6AC8EEEA"}, "display_name": "Pro Bowling Social", "keywords": ["bowling", "tenpin", "multiplayer", "sport", "sports"], "long_description": "Bowling is a fun sports game but you need go to a club since it requires a large space to play. With Pro Bowling Social you can play bowling in the comfort of your home. \nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them."}]}, "developer_name": "Moonstar Games", "developer_privacy_policy_url": "https://www.moonstargames.com/bowling_privacy.html", "developer_terms_of_service_url": "https://www.moonstargames.com/bowling_terms.html", "publisher_name": "Moonstar Games", "support_website_url": "http://www.moonstargames.com/", "website_url": "https://www.moonstargames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7978772488821844"}, "review_messages":
oc=AdrZg0AMkzYcSTv3Of6rsCHCEGQodenMd2Uhxbq0ZI7R2vfVuscODpOfcLLhCC4X1Bc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2mWAfyb4qtRwWl2k9onrmlsEobVwki2Lzmgs9Ky_Ib1Q&oe=69E0FDB1"}, {"file_name": "migrated_image.png", "id": "201811821110842", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982559_1211352452359901_1653211106404990976_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B2i_HLKrDh4Q7kNvwHdy55_&_nc_oc=Adq1B-S8RUSGVy9daeeF7F-d8N4sbHwq-iLATzBr2WqgDN90BOZ-GSNlHZV7nooxzbs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1bwJCZRp1Igf4PK_F8qxXq11x_cEADynwE4JNClLPtsw&oe=69E0C7B4"}, {"file_name": "migrated_image.png", "id": "196159655021180", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974876_480368835864611_6173717808111681536_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h1pQieWl9q8Q7kNvwHQhnVV&_nc_oc=Adr2NT9WM2f-yQeORI48cjqvU72cQY3seuGXhSwvVuzltpfgOGs9s_l2fTGmHPiyJvY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3mycys9TbswyjBv0pFgbhS3m5xhMIF32YtGTI6I_l57Q&oe=69E0E6AD"}, {"file_name": "migrated_image.png", "id": "286926512302306", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974503_2971137249627887_2738815793285300224_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SFKgP4G1kXQQ7kNvwFkFphk&_nc_oc=Adok06jce-12DdxKYQ-BtVtcgWGfPWhiNb-M5SHp0YtykSOjwN-rwu6em5mSzON0XnI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1KbcqEkyVoZVc5XKgEs-2Fw8KnSdVGODIpmY6D_F_p-g&oe=69E0C762"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1a.png", "id": "796339428369487", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974474_796339431702820_5955742702304479792_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gwi8LWBuJKQQ7kNvwFJxjZP&_nc_oc=AdoBnAEcEgLwMbx-lMKVP4YQPzWpNe-DDVNL6o48VIzj5A0HiCRUulQ-26MfUmInINo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1A1yoETJdsJs9sMPB3ZYnaSgHufGclS3EXMZmKr7bLxg&oe=69E0E6EA"}, "display_name": "Pro Bowling Social", "keywords": ["bowling", "tenpin", "multiplayer", "sport", "sports"], "long_description": "Bowling is a fun sports game but you need go to a club since it requires a large space to play. With Pro Bowling Social you can play bowling in the comfort of your home. \nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them."}]}, "developer_name": "Moonstar Games", "developer_privacy_policy_url": "https://www.moonstargames.com/bowling_privacy.html", "developer_terms_of_service_url": "https://www.moonstargames.com/bowling_terms.html", "publisher_name": "Moonstar Games", "support_website_url": "http://www.moonstargames.com/", "website_url": "https://www.moonstargames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7978772488821844"}, "review_messages":
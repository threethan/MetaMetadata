oc=Adp1sCh30kRBFBFh8kVVRPPXEw22bsdWdjKInG6kDO7B9fy7qJpVfELsxzTgDwBMIPM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvvm0_tyW2wqCFSN42o_2MRt4Z3yIg8yTGOHykrWV1JQ&oe=6AF87BB1"}, {"file_name": "migrated_image.png", "id": "201811821110842", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982559_1211352452359901_1653211106404990976_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dOckphT0jfkQ7kNvwEAUmPC&_nc_oc=AdrSvpu1uSKNdm3papgRm-ckO2XckCUzyKJSG7arWHA7m34VVJvyResUmSi-QiAHEK0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4GeilmlPvW5lQIQ6zxGlCCsJdhU3ITVVJyJWUmKH94Q&oe=6AF87DF4"}, {"file_name": "migrated_image.png", "id": "196159655021180", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974876_480368835864611_6173717808111681536_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Me03J6VYml8Q7kNvwF1F1qh&_nc_oc=AdqN10aQ0XiPADmTqv797_RNUPM-C6TrgOTEnU2pIWMgYy-FGK0QncI-KSZFR4cuJkc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCOeSyPgP3Dc-Y9miI5YN5cdwLx9VP3fCuNgr8EJ28zg&oe=6AF89CED"}, {"file_name": "migrated_image.png", "id": "286926512302306", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974503_2971137249627887_2738815793285300224_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CBMorN7V6rQQ7kNvwHcF6I0&_nc_oc=AdqN7CX9l_wzXN4RkRcr62eRiR4zn28GniDfoioDJuTArStmTpVUk-wF9JzMmvP_hPU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJqeWbuvhW3i0_rFd5dbec7zopsmV7mJYLtCVKWPG-9Q&oe=6AF87DA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1a.png", "id": "796339428369487", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974474_796339431702820_5955742702304479792_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pq6NMONxPMkQ7kNvwFmMCUI&_nc_oc=AdqcudGXM4PYA2Vj-50RhBTKZp_j2VNx4Gqxep-O1wLLVlwPAm6keSnROVnID-ZYIzw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQU8uGTXHsnPQyhlVkDsADshJMZyuaWhMqyuTO7eop4dQ&oe=6AF89D2A"}, "display_name": "Pro Bowling Social", "keywords": ["bowling", "tenpin", "multiplayer", "sport", "sports"], "long_description": "Bowling is a fun sports game but you need go to a club since it requires a large space to play. With Pro Bowling Social you can play bowling in the comfort of your home. \nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them."}]}, "developer_name": "Moonstar Games", "developer_privacy_policy_url": "https://www.moonstargames.com/bowling_privacy.html", "developer_terms_of_service_url": "https://www.moonstargames.com/bowling_terms.html", "publisher_name": "Moonstar Games", "support_website_url": "http://www.moonstargames.com/", "website_url": "https://www.moonstargames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7978772488821844"}, "review_messages":
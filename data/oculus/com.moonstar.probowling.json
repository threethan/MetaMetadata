oc=Adp7KmYuO8QTwqYPTRn8GQRJIfwIXVBneKogWHRUz-Jk99bVrW7yn2p9iuE8IR8VUpk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8L3n7LSnD_-YOvfwcnbfqd_7GYwmKnklHA0oJyMuvwg&oe=6ABA8531"}, {"file_name": "migrated_image.png", "id": "201811821110842", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982559_1211352452359901_1653211106404990976_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jkOjuK0SiO0Q7kNvwHawSam&_nc_oc=AdrED84wPffAqfawQNCg1IsOOViZyyB3Occ8LdMrrmZUiyiOx7Hlzd7_RY5XBqKppyw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPpLZRjZERLU1d3x1LImd4r__lFLuaz6TvKstOvU4WcA&oe=6ABA8774"}, {"file_name": "migrated_image.png", "id": "196159655021180", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974876_480368835864611_6173717808111681536_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tu3iT2VryeQQ7kNvwFsSsDt&_nc_oc=Adok8xHoLM8A7Em0PjqZ9z_XtVyaymj48LTt4jE4eFggkCwkvTApQFNKsUiKlneWWM4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzo19kRzAr-8IlSIOAXQLz6DklIq9eu7BpjQGmrAGe_g&oe=6ABA6E2D"}, {"file_name": "migrated_image.png", "id": "286926512302306", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974503_2971137249627887_2738815793285300224_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0uAwnKNbL70Q7kNvwFHNpcD&_nc_oc=Ado8YHFR96GEIogGh9nD0roFLYh2P007Vr_iHiNbom6N1iskulYqBX01JJqmUZ-jnRk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0SbKNPty6_Dg9lZZ9sAPm4CVoM9SJNB42KowiobUvWw&oe=6ABA8722"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1a.png", "id": "796339428369487", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974474_796339431702820_5955742702304479792_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dvLN8nZ7ME0Q7kNvwHSNxXL&_nc_oc=AdqUimHOojGD_fzUC9Ntzn5MpIkyKhjIEovfZEs6yOtLzFI6CRx94queYOTQmVrf214&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJyNmRVmjJbvsb-irSvgPbNQGYKqnVusHPyTeWmyq9AMg&oe=6ABA6E6A"}, "display_name": "Pro Bowling Social", "keywords": ["bowling", "tenpin", "multiplayer", "sport", "sports"], "long_description": "Bowling is a fun sports game but you need go to a club since it requires a large space to play. With Pro Bowling Social you can play bowling in the comfort of your home. \nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them."}]}, "developer_name": "Moonstar Games", "developer_privacy_policy_url": "https://www.moonstargames.com/bowling_privacy.html", "developer_terms_of_service_url": "https://www.moonstargames.com/bowling_terms.html", "publisher_name": "Moonstar Games", "support_website_url": "http://www.moonstargames.com/", "website_url": "https://www.moonstargames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7978772488821844"}, "review_messages":
c_sid=6e7a0a&_nc_ohc=7sDLJVE-QA8Q7kNvwE4Mkz-&_nc_oc=AdrbxJv0-N7zX9tIlSLI-O3eOyc1NV2X1cXpheYNcheLGr2o1hRU8IZk9jK2e4TfrTU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-hYgI0hqVcCttxCdwyHLRY_Ev9lNPVT2CNNsLpnWR1dQ&oe=6A3A8CAD"}, {"file_name": "migrated_image.png", "id": "286926512302306", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974503_2971137249627887_2738815793285300224_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=boKzdlp1pUIQ7kNvwFj3vCE&_nc_oc=AdqPZB20Fs0i8hAkIT4CHzWz8nJ4ln81atgreZ1xzPafDA7ZQgzDW2iiz6KoBC0hRFM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-v_qEIQBll5sWsbHy4RaDiwWLdTCFqqoJPTnYSgH6zUA&oe=6A3AA5A2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pro Bowling Social", "keywords": ["bowling", "tenpin", "multiplayer", "sport", "sports"], "long_description": "Bowling is a fun sports game but you need go to a club since it requires a large space to play. With Pro Bowling Social you can play bowling in the comfort of your home. \nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them."}]}, "developer_name": "Moonstar Games", "developer_privacy_policy_url": "https://probowlingsocial.com/privacy.html", "developer_terms_of_service_url": "https://probowlingsocial.com/terms.html", "publisher_name": "Moonstar Games", "support_webs
oc=Ado4D9q-r3eqZyCtr6XCUpvP3ZzVnTvpj7GWIWs2yK2kQ_yRuZ-VttWe91Iz6Bzm5Cg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzT9s0MUmQ0ol6bz7Ms16xnzZ6uYEzZJxIiIsBP-ZLODA&oe=69CBAD71"}, {"file_name": "migrated_image.png", "id": "201811821110842", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982559_1211352452359901_1653211106404990976_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mNpt66mIRYgQ7kNvwFyKFkm&_nc_oc=AdrOWSa9kLvDIMkDaYf176vlST7HM1T9t0no4CmUh5EB0afdgOj5nGARoWWEjbxnF-Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx1BtxJoTzsFteAXw4pJAY-M6F70VG2fYQbF4b_z4wutA&oe=69CBAFB4"}, {"file_name": "migrated_image.png", "id": "196159655021180", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974876_480368835864611_6173717808111681536_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0IVs2DkwtNsQ7kNvwGSV3sX&_nc_oc=AdpzJzT4EgNVHJAGAHNOR4zzN7T6nAf1rO4ODfWA2ICbIMPu0zZJhoMuk_Tkr6hMLzM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwoDpGQoVQbv4AtAll0I-w3pxias-Nwm0jalo1YrTvo2g&oe=69CBCEAD"}, {"file_name": "migrated_image.png", "id": "286926512302306", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974503_2971137249627887_2738815793285300224_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tq-T-1307dYQ7kNvwEVMRYf&_nc_oc=AdrbxTd9X3UNizDrwzB72oOg-kMPVfV7kMnDiHBLZDLTpOF7zeWpL2p05m8L1Qr_vXc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzysLMJcmGEFPk4NRSrI8VcwR3pRXDDM-PBEwmfzTcc8A&oe=69CBAF62"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1a.png", "id": "796339428369487", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974474_796339431702820_5955742702304479792_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ntjm7RpIVMYQ7kNvwHE0_Fi&_nc_oc=AdqeTycQ7TbflviMeAbwcTB7FSr6CWJ_xlwu1PWWEGDkGEFTtXdfsnyqkJ9iCDMhyNk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxWZbdRZ3VJ-8Mmz72LVtyMPRtC_J0Q6bbP08mu9B8Fwg&oe=69CBCEEA"}, "display_name": "Pro Bowling Social", "keywords": ["bowling", "tenpin", "multiplayer", "sport", "sports"], "long_description": "Bowling is a fun sports game but you need go to a club since it requires a large space to play. With Pro Bowling Social you can play bowling in the comfort of your home. \nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them."}]}, "developer_name": "Moonstar Games", "developer_privacy_policy_url": "https://www.moonstargames.com/bowling_privacy.html", "developer_terms_of_service_url": "https://www.moonstargames.com/bowling_terms.html", "publisher_name": "Moonstar Games", "support_website_url": "http://www.moonstargames.com/", "website_url": "https://www.moonstargames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7978772488821844"}, "review_messages":
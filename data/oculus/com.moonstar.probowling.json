oc=Ado_b_RbIcCGa3t4wCQQ7UbNcOgVu-SsV6lngkW-UZS02Rr-wB4y1LPhQ8Cq23B1M2Q&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQChzfpSyejO__kffisBFa6K3rdHfYTGhKJ8htlNo2Rg&oe=6AD391B1"}, {"file_name": "migrated_image.png", "id": "201811821110842", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982559_1211352452359901_1653211106404990976_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NSZK-qwQEbgQ7kNvwGHcPzn&_nc_oc=Adqp_La115BPz8QbvuK9RUjtIg3FgbkzlEGaBoT6vf8msIVnKXPcTlE-TWRRbJ5Bb3M&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOroM2kHGPQ0qOpHmni-eAcHuBWLIif7rUSiF04--JJ_g&oe=6AD393F4"}, {"file_name": "migrated_image.png", "id": "196159655021180", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974876_480368835864611_6173717808111681536_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QTP-esEdpoEQ7kNvwGKmA-h&_nc_oc=AdquJKnlweRkltdPQchPrN7cYBKK02YS45lKRvdyhQ3mEAIQyYxMMB8dW1y4RZzLfm4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPhfjPuqfrbEXTrh8pYs_zfrqb6Vgde4qHaKh4LU3YulA&oe=6AD3B2ED"}, {"file_name": "migrated_image.png", "id": "286926512302306", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974503_2971137249627887_2738815793285300224_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mBOXIJ6hQ-AQ7kNvwGJSPAX&_nc_oc=Adqr5YPWr2AQ7na0QCWG-4UWlvWa-LXBB3bLoM_odGRCMKD0G6r9-ZFR692DyFEDhEo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMFmSe0zc-1H51EsLTzTtkhPBRO3oaX9cf44A5PxWUwyw&oe=6AD393A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1a.png", "id": "796339428369487", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974474_796339431702820_5955742702304479792_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lefSWmg9-O8Q7kNvwHyNppP&_nc_oc=AdqY-5yC9HnfSmAF3fNytN1I_k28FvotVAkF4fi6OB9s9dWZ3UOvv0XreCiTOGySywA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO6s6Ocui9JwqdS6kpOwiC6BE2peymSNrKbe0-GHBOu7w&oe=6AD3B32A"}, "display_name": "Pro Bowling Social", "keywords": ["bowling", "tenpin", "multiplayer", "sport", "sports"], "long_description": "Bowling is a fun sports game but you need go to a club since it requires a large space to play. With Pro Bowling Social you can play bowling in the comfort of your home. \nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them."}]}, "developer_name": "Moonstar Games", "developer_privacy_policy_url": "https://www.moonstargames.com/bowling_privacy.html", "developer_terms_of_service_url": "https://www.moonstargames.com/bowling_terms.html", "publisher_name": "Moonstar Games", "support_website_url": "http://www.moonstargames.com/", "website_url": "https://www.moonstargames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7978772488821844"}, "review_messages":
q&_nc_oc=AdoEYc5A6hoYIEvs4DXx8vtH7qilt6PJ5jFFycARZ7VTwlFGZ5eMx9WpnWrmWoWd5-I&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9JO9mQmGWwMdf2CfoDmn-5CCpVJcq0z-as9QylQPKBnQ&oe=6A36AF31"}, {"file_name": "migrated_image.png", "id": "201811821110842", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982559_1211352452359901_1653211106404990976_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Uc7Khsxe8wQ7kNvwGSTm6w&_nc_oc=Adri6q-ImuR9O-hz3sGpI2k_l0kHSUad-qz9yp9QHUxYEp3x6iXN4z4XF0WKuY84k2w&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-71GzLTs9kj7QhAa2ZZKRLs_8xZlbTWv8HC2LUiz7BAA&oe=6A36B174"}, {"file_name": "migrated_image.png", "id": "196159655021180", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974876_480368835864611_6173717808111681536_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z4An8qBYRoUQ7kNvwFaapXK&_nc_oc=Ado5kMKPUuA_avDtIXCA0JCEbgcY1aeBi_sEQsFofZPJ3kkCgrLtYeaOaZv2aK8Iiwg&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_44VAwMYaX2IIZZjkhNRzqg6JyYD_qCZffj8ICyrxpWQ&oe=6A36982D"}, {"file_name": "migrated_image.png", "id": "286926512302306", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974503_2971137249627887_2738815793285300224_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ijAp2W1kPowQ7kNvwHef9tJ&_nc_oc=Adp9Z1KniUH1ut76VgW9zWGSiDtTlpL27du5vNQN15jJrVWr5GWAWs-AKcSwa7pgaWY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9zrGREq2PYVXB3tceM2aU2S0XjmjPSf_9tAb7dSZ52OQ&oe=6A36B122"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1a.png", "id": "796339428369487", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974474_796339431702820_5955742702304479792_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tjgwsZIyV8gQ7kNvwHV5joX&_nc_oc=AdpYnux79SL0aD2_F1EBzHVyR43rmqCkOW25w8f08EG0WPyWSsXXzFlehgYVxlXybKE&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af846yVgDww0ea0TIDsNmcIHW1b0u9GJ3KUlrUz2Hw8C6Q&oe=6A36986A"}, "display_name": "Pro Bowling Social", "keywords": ["bowling", "tenpin", "multiplayer", "sport", "sports"], "long_description": "Bowling is a fun sports game but you need go to a club since it requires a large space to play. With Pro Bowling Social you can play bowling in the comfort of your home. \nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them."}]}, "developer_name": "Moonstar Games", "developer_privacy_policy_url": "https://www.moonstargames.com/bowling_privacy.html", "developer_terms_of_service_url": "https://www.moonstargames.com/bowling_terms.html", "publisher_name": "Moonstar Games", "support_website_url": "http://www.moonstargames.com/", "website_url": "https://www.moonstargames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7978772488821844"}, "review_me
9&_nc_oc=AdpHDuYiqSgcL9IS4Wf_t63QKjjvNqGZ-VwjvEdj8Fe-BqqBiJezZpwJgaZ0jC5kg0U&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af48kaOyIV3_7Fi8aUdo19cZOgxOIS1MDW_8k30j_4J-Xg&oe=6A11C531"}, {"file_name": "migrated_image.png", "id": "201811821110842", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982559_1211352452359901_1653211106404990976_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sB-U7LvVAAkQ7kNvwHpUsUH&_nc_oc=AdpdWNVUZ_grt_W7ueCVIIlpAwOe2GsTNluvPXSTJRMKns9o96oHTLVuh-NHf_fzmN4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6fzvJY32Vm_MbkM4ttqFDlhLJzu2FWJz8zwlOIkPJGcA&oe=6A11C774"}, {"file_name": "migrated_image.png", "id": "196159655021180", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974876_480368835864611_6173717808111681536_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tf8fmO2jO9MQ7kNvwHHSP_M&_nc_oc=Adoc9jbItWF6ViXHc6IH0b7J0PN6PWfxx3uLenEEWbPpy-1exBnlU2rQMwyP59Jly4Q&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7mdBQyrZKj5wFgCW7ltNt6YB5yhn9P0140D5w8zFa2Ow&oe=6A11AE2D"}, {"file_name": "migrated_image.png", "id": "286926512302306", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974503_2971137249627887_2738815793285300224_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t9VbtcP5VqAQ7kNvwFsdtqD&_nc_oc=AdonzV6TGHgSmi3XEl0dFnD3HTo8FtISZSw8zKc-cTd_a73_-Kv8ofh8VbmQaspg4sU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6JP8yrOfCQ9EyDhjr6TxL98ERVw3eeQhxINmUwHra8Sg&oe=6A11C722"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1a.png", "id": "796339428369487", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974474_796339431702820_5955742702304479792_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bOTVMRpWiiwQ7kNvwGGsEyM&_nc_oc=Adr2uoiXNx46w-fWwIjoD4HbwcvE99Q2Ffznn5ACGkXqqhyU_qCuoDBGW2rjgCDEb7E&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5tdDdb-LhzVmf9IpnKPBZRhfWWQ-Pk17-D3u1JPPScpg&oe=6A11AE6A"}, "display_name": "Pro Bowling Social", "keywords": ["bowling", "tenpin", "multiplayer", "sport", "sports"], "long_description": "Bowling is a fun sports game but you need go to a club since it requires a large space to play. With Pro Bowling Social you can play bowling in the comfort of your home. \nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them."}]}, "developer_name": "Moonstar Games", "developer_privacy_policy_url": "https://www.moonstargames.com/bowling_privacy.html", "developer_terms_of_service_url": "https://www.moonstargames.com/bowling_terms.html", "publisher_name": "Moonstar Games", "support_website_url": "http://www.moonstargames.com/", "website_url": "https://www.moonstargames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7978772488821844"}, "review_me
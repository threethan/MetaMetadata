c_sid=6e7a0a&_nc_ohc=7lUxZkQy-9cQ7kNvwHYpesT&_nc_oc=AdqVKXXcc8-moMQXkY21T_PptCm_NzNHS_ThF0YuCyOWArTSRa7yvfZkTxUQZabLnUA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2eKhZIsFmjCFq-oiF4V6jY8aQqzSoahGM4VTuysjkXsw&oe=69EF672D"}, {"file_name": "migrated_image.png", "id": "286926512302306", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974503_2971137249627887_2738815793285300224_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=50czTg4bRukQ7kNvwGB4WHx&_nc_oc=AdoVzs47kM67j0UGD1dXsEJmftw_GnGaFez35cnI1rB27p-55gGqZ62yzONTGnRiBIc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af28N9h4zmFXCLEFrG6DR15HCDgeEtDP8YR9Da_AvbGBZw&oe=69EF8022"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pro Bowling Social", "keywords": ["bowling", "tenpin", "multiplayer", "sport", "sports"], "long_description": "Bowling is a fun sports game but you need go to a club since it requires a large space to play. With Pro Bowling Social you can play bowling in the comfort of your home. \nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them."}]}, "developer_name": "Moonstar Games", "developer_privacy_policy_url": "https://probowlingsocial.com/privacy.html", "developer_terms_of_service_url": "https://probowlingsocial.com/terms.html", "publisher_name": "Moonstar Games", "support_webs
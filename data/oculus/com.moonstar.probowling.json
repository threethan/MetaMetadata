oc=AdrCYnt9Z3EFnUbLS59dw8le9StmPHQVABWQXgJFf4xWUm3AUjn2b0i7QPRQXpWIk9U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af58SWsBZdsO5LNjwvF8hpulLVnoCY_cn6ZYaWiln7bIAA&oe=6A1DA2B1"}, {"file_name": "migrated_image.png", "id": "201811821110842", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982559_1211352452359901_1653211106404990976_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x8S9X5bxGt4Q7kNvwGA07_Q&_nc_oc=Adpa1bNjs-M4Py3c-d-daXpUiDkEnmH-ir8QdU2CHvEod64FpBlWv-iL6HsmOopVjqk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ouw4p6NwrQent3Y2MduZjrm_ETXEtd_g7kDRnmozsIw&oe=6A1DA4F4"}, {"file_name": "migrated_image.png", "id": "196159655021180", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974876_480368835864611_6173717808111681536_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HX_KI25ysQ0Q7kNvwHRBFqB&_nc_oc=Adr4wuq8SVkpvSI5ALwq1VPXN4WskxymX0zn0CYdkbRfXUuo-npJQcknb0MHlbIzOn0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7QPmo25ZNcxi4EU09uqvH_r8GUrI8sM98IdIaw2Vv-lg&oe=6A1D8BAD"}, {"file_name": "migrated_image.png", "id": "286926512302306", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974503_2971137249627887_2738815793285300224_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e6nqSbcikxMQ7kNvwF2U3sT&_nc_oc=Adq_LVeO1FjA9JvLMGqojxElVdB4EoJncTsEGXKypbWhYAYLM6jpHXNCC9t2snwBY8A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6mvjHvCgb_UTlZDMIL9SqDWCMS9LJ9Kmf0g8jJkR9EBg&oe=6A1DA4A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1a.png", "id": "796339428369487", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974474_796339431702820_5955742702304479792_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PD80aRjtfS4Q7kNvwFUB3_h&_nc_oc=AdohqSa7ftscpiDdkUcZ_PHPVf6TXkElNZ8cRTDb5b_hgucRDeJSuQeyazD7GNhOpPs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Evo2ick-LOVlaZPlvMYlmmSTu6dPI0hZFEN9-q7ZwCQ&oe=6A1D8BEA"}, "display_name": "Pro Bowling Social", "keywords": ["bowling", "tenpin", "multiplayer", "sport", "sports"], "long_description": "Bowling is a fun sports game but you need go to a club since it requires a large space to play. With Pro Bowling Social you can play bowling in the comfort of your home. \nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them."}]}, "developer_name": "Moonstar Games", "developer_privacy_policy_url": "https://www.moonstargames.com/bowling_privacy.html", "developer_terms_of_service_url": "https://www.moonstargames.com/bowling_terms.html", "publisher_name": "Moonstar Games", "support_website_url": "http://www.moonstargames.com/", "website_url": "https://www.moonstargames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7978772488821844"}, "review_messages":
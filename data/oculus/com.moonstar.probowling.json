XjX6ObDhHl3osgRbV9ueUQTU9yJZa_a7fD_Crk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuQSgWbHYrnpkZ3EW6t85UnLg8Y2BPv4wowZojP2k7bEQ&oe=69A814F1"}, {"file_name": "migrated_image.png", "id": "201811821110842", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982559_1211352452359901_1653211106404990976_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-dnHsGVQ-gIQ7kNvwFT05EJ&_nc_oc=AdlxW_EzRNiDY-mrBNkFFlJyFsoqM2uiZ-xpefx_3AvkIgso5PxyoUtK7248dMxMdSE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvKS9RNeyD_qv5yDdrkQO615Ji_vtKiy6EMbmIPU6dSWQ&oe=69A81734"}, {"file_name": "migrated_image.png", "id": "196159655021180", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974876_480368835864611_6173717808111681536_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1hAufdSG_X4Q7kNvwG6y5ru&_nc_oc=AdntWAWmKXheWYP3uKG9sfbDfzfjYg7Q_2hazEK5N0OAT60Ey4vXZ23RqwukkeBh-1w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftYp3KKmJOcLEM6CMClktH57sCE0tAtW2OZxslq6q4LOg&oe=69A8362D"}, {"file_name": "migrated_image.png", "id": "286926512302306", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974503_2971137249627887_2738815793285300224_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VIbFMtOQTkAQ7kNvwFzl5ou&_nc_oc=AdnPbmfg0F436di7mdGCXB4PIaTofTGeCAbE4vpqImZ7dKSLAyDMICh25I2IVUpgoTg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsRVSLtUioYK1oXwVkgT7STS5ib6lTcPxiikwkcwnFs3A&oe=69A816E2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1a.png", "id": "796339428369487", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974474_796339431702820_5955742702304479792_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BdY7bWDJZKMQ7kNvwFCU4Nl&_nc_oc=AdnGwmPiK0WmtDxNfAZb5OcoWMir4iG-yauzOvO5ISV1H7ZEL94kqA7HMedDJvjxtmE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvSTKywjL99W_7T8-qasTf5xGAVDmA5ShZqG5hdTAvEiA&oe=69A8366A"}, "display_name": "Pro Bowling Social", "keywords": ["bowling", "tenpin", "multiplayer", "sport", "sports"], "long_description": "Bowling is a fun sports game but you need go to a club since it requires a large space to play. With Pro Bowling Social you can play bowling in the comfort of your home. \nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them."}]}, "developer_name": "Moonstar Games", "developer_privacy_policy_url": "https://www.moonstargames.com/bowling_privacy.html", "developer_terms_of_service_url": "https://www.moonstargames.com/bowling_terms.html", "publisher_name": "Moonstar Games", "support_website_url": "http://www.moonstargames.com/", "website_url": "https://www.moonstargames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7978772488821844"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scont
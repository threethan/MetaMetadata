c_sid=6e7a0a&_nc_ohc=ReabVEg_p0IQ7kNvwG9NVZ4&_nc_oc=AdphItjTdqaiq8pX8pUyvdW_MgJS8qOGciTneM5nfoAVyw_sC2BP2TqnkJaG5qmXDUE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_uGSRehy665nery9TjsMudCpX6-nRfVnFVz5W-VC7Vxg&oe=6A4518AD"}, {"file_name": "migrated_image.png", "id": "286926512302306", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974503_2971137249627887_2738815793285300224_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=okMWQusSReUQ7kNvwFyKHwK&_nc_oc=AdrVg7WDIctpz9MQLU-bUoDG57SWmORrhDAau-TthOjlhAEO93hNICL5MJANRNpWILc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9OdYJ4fiTDIstIhwzua7z04CU3UnUDurCNN9Es6K1-lA&oe=6A4531A2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pro Bowling Social", "keywords": ["bowling", "tenpin", "multiplayer", "sport", "sports"], "long_description": "Bowling is a fun sports game but you need go to a club since it requires a large space to play. With Pro Bowling Social you can play bowling in the comfort of your home. \nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them."}]}, "developer_name": "Moonstar Games", "developer_privacy_policy_url": "https://probowlingsocial.com/privacy.html", "developer_terms_of_service_url": "https://probowlingsocial.com/terms.html", "publisher_name": "Moonstar Games", "support_webs
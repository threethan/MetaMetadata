oc=AdplZZkOwKXsuWpIk1oikkj_XvaXhUMZxgbvHL0upjB3EhvjsScjJqny0IsvKW6IaWI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_BxcOtL-2i9lhkLh52bXMtIA34oRjhH8Nu17-88CIQZg&oe=6A243A31"}, {"file_name": "migrated_image.png", "id": "201811821110842", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982559_1211352452359901_1653211106404990976_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hrBR1qkweIMQ7kNvwHKmOnX&_nc_oc=Ado8cbr1TdFl4tUco_-_PsAji7kJmQlT9ljBFraFzQ-Id7v5fJBZyimqzIBvRFeHL_I&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-lxmGJIGJjFm6f-IY5pcLxTIDfGITXFMtrHgAV8trjUA&oe=6A243C74"}, {"file_name": "migrated_image.png", "id": "196159655021180", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974876_480368835864611_6173717808111681536_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jSww6uOUXsoQ7kNvwFX161c&_nc_oc=AdqB8wzHQ3UT-TRekBEnykpOR2_DR2Iu2BhxVJ9fG0sE0LK2N4LNM5Q6lkMgEsG4hdo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-hIDsZ1WJKlyNM-jsjHZfMh-Ktc_tQWXqEvrv9sUhn4A&oe=6A24232D"}, {"file_name": "migrated_image.png", "id": "286926512302306", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974503_2971137249627887_2738815793285300224_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sxRHyjrIpBcQ7kNvwG7FK5E&_nc_oc=Adrlfwf_kpk1SiCSic43S9EWKf8tGV0uiUrhtsNAgKzz88DBB0Ma-gYHKUxeUxOE-DY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-7eWSgdS2szbPB0s_6ymuZN5ZrXxD0qUQQURDAiP1HDg&oe=6A243C22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1a.png", "id": "796339428369487", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974474_796339431702820_5955742702304479792_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ksi-_To7VhoQ7kNvwGFJ04M&_nc_oc=AdpUTqWuZWzqfE9CJ44wLA96CS5L9CxG_Apschw7dLYerENKrMp-CBjxSEHW2QonKyU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8m578fzlQv6Rx-8a58JxTKb8X5TahrKJYRRC_YYAteIQ&oe=6A24236A"}, "display_name": "Pro Bowling Social", "keywords": ["bowling", "tenpin", "multiplayer", "sport", "sports"], "long_description": "Bowling is a fun sports game but you need go to a club since it requires a large space to play. With Pro Bowling Social you can play bowling in the comfort of your home. \nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them."}]}, "developer_name": "Moonstar Games", "developer_privacy_policy_url": "https://www.moonstargames.com/bowling_privacy.html", "developer_terms_of_service_url": "https://www.moonstargames.com/bowling_terms.html", "publisher_name": "Moonstar Games", "support_website_url": "http://www.moonstargames.com/", "website_url": "https://www.moonstargames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7978772488821844"}, "review_messages":
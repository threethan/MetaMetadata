oc=AdoCWMpnAGa3t0gAbt7LdzaxDe0QAcEQ79uoB-VYxcPQGwJuSZqeImZXfZlDF8Xh7WM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2in65snoVCLqK0zirRkFU61izal-Z7sbWSLU64oSJizw&oe=69F372B1"}, {"file_name": "migrated_image.png", "id": "201811821110842", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982559_1211352452359901_1653211106404990976_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ExyO-8qYFYQ7kNvwHdET22&_nc_oc=AdrjHoLMKoDsJkmcHuv5oWFrDiEY8laHu87c9Y9WkS7o8YpaK0DlnbRpgKsZwC1K0rE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af01V8o-rEeovX0MokBGXIhdCxcb5w7c16srK389JwX7YA&oe=69F374F4"}, {"file_name": "migrated_image.png", "id": "196159655021180", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974876_480368835864611_6173717808111681536_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F0UtX-zFqPAQ7kNvwHZ7rQ8&_nc_oc=Adog6e4kwbhigmDoBhM81yiTY-DDraT-2JIUftoYb9lRkpt2Z8QvcYxMHgk9rJ6rHYk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1GRBCcRjrqxhqIBlh_jvlaHEdxZFL53aRxpty6F1G23g&oe=69F35BAD"}, {"file_name": "migrated_image.png", "id": "286926512302306", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974503_2971137249627887_2738815793285300224_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WcpFwy4log8Q7kNvwHxrAH3&_nc_oc=Adrabu0ucvm-nDVmrmOKj-h-jJid3aBNcSPrjtjNf3LQQuwgMmzcgP8-zVZhW4qmEx8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1UAdo04d-4tSwFvWA9Km_Kxeam4JdN0nn0sgwjOkoRjQ&oe=69F374A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1a.png", "id": "796339428369487", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974474_796339431702820_5955742702304479792_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1q1HLo1fCnUQ7kNvwEvxTiS&_nc_oc=AdocdI8EeKL0tCFsCfycundC8nJ37S10VzE8Ppq5rtIWJkHLNhPLixmL--TIQKn19qU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0-XCRsnZ-VdXlEeDy0QABBGppDku3NNy9aL8s91Fgzdg&oe=69F35BEA"}, "display_name": "Pro Bowling Social", "keywords": ["bowling", "tenpin", "multiplayer", "sport", "sports"], "long_description": "Bowling is a fun sports game but you need go to a club since it requires a large space to play. With Pro Bowling Social you can play bowling in the comfort of your home. \nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them."}]}, "developer_name": "Moonstar Games", "developer_privacy_policy_url": "https://www.moonstargames.com/bowling_privacy.html", "developer_terms_of_service_url": "https://www.moonstargames.com/bowling_terms.html", "publisher_name": "Moonstar Games", "support_website_url": "http://www.moonstargames.com/", "website_url": "https://www.moonstargames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7978772488821844"}, "review_messages":
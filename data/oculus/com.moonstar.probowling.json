oc=AdqXvXGVUXcFksCiStZXWL3wHo1Mx9aEt4lZlavBv58Cl6GxCapW2tjZgieobpux-2k&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFevPbM-F55wS18L4O2px2chniw_X_jYln39wNsNUTdDA&oe=6A804AF1"}, {"file_name": "migrated_image.png", "id": "201811821110842", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982559_1211352452359901_1653211106404990976_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mJV9VcHKrMAQ7kNvwHG0wCo&_nc_oc=Adq4eMuosIGEpLnqNl7XBSwFvLrymdKvA43yrUiMEBAq52tRcvgNxsq5CSIJGCDrGKc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGfKJy6hZjuzpoKUegoK3k9CToO0ps-obz6ZQQ43yMlhg&oe=6A804D34"}, {"file_name": "migrated_image.png", "id": "196159655021180", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974876_480368835864611_6173717808111681536_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9WM5h2ApQZYQ7kNvwFF9mw_&_nc_oc=AdozI9d_tiorCrcx-X2UjDpxI7Nm9ncE1xYKhR8vCa-j_xytR1tYasvUyUzKFp5fS-4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGeeCo5VLOj8ujlCcB52FJBAIShTuGgoRkbH5kq4Rv46A&oe=6A806C2D"}, {"file_name": "migrated_image.png", "id": "286926512302306", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974503_2971137249627887_2738815793285300224_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KeI_eWHa7TUQ7kNvwHonEYa&_nc_oc=AdpyBtp_DRrF2VRW2qJ-N44xuf4AdY9f2H9K8WJ9S09E74L7w7aQYHlHtVStb7AppYA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGy4XA48YUODMpNLSmuBSPNXmFJOE2LRc3VZApD-cCx3Q&oe=6A804CE2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1a.png", "id": "796339428369487", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974474_796339431702820_5955742702304479792_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K_Spr_Dthh8Q7kNvwGH95gC&_nc_oc=Adqm8IZIPpxe0UBxdYAmjOY2UrFXGeIt0y274Zd0IRZKVBR9zTbx3zLPNhUUVozNduY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEEDyqXMHq18VViC0939EkZu5Qzj3fPFP8QcHkJkm11Iw&oe=6A806C6A"}, "display_name": "Pro Bowling Social", "keywords": ["bowling", "tenpin", "multiplayer", "sport", "sports"], "long_description": "Bowling is a fun sports game but you need go to a club since it requires a large space to play. With Pro Bowling Social you can play bowling in the comfort of your home. \nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them."}]}, "developer_name": "Moonstar Games", "developer_privacy_policy_url": "https://www.moonstargames.com/bowling_privacy.html", "developer_terms_of_service_url": "https://www.moonstargames.com/bowling_terms.html", "publisher_name": "Moonstar Games", "support_website_url": "http://www.moonstargames.com/", "website_url": "https://www.moonstargames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7978772488821844"}, "review_messages":
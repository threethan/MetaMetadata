culuscdn.com&oh=00_Afs8tXUr-HXgBT7xKUcGojzZMUfQdTV_NiIQneE5nZZpNQ&oe=69A6C371"}, {"file_name": "migrated_image.png", "id": "201811821110842", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982559_1211352452359901_1653211106404990976_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-dnHsGVQ-gIQ7kNvwEMA7sD&_nc_oc=AdkBlaXk8x-HQPybUX_ze6fAJweR0KQbuAq4pFBTN0rzf1RXNp89b4ZT0zZl4beh4OE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aftb-5SnGOpgKNvXNndFdyeXx-KGSfWoIsRruvVPPaMXWQ&oe=69A6C5B4"}, {"file_name": "migrated_image.png", "id": "196159655021180", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974876_480368835864611_6173717808111681536_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FtKyBgnDYfsQ7kNvwGcdcld&_nc_oc=AdlUf52HaMgxHxZUAcWJE4rB6Anr6d4W-Brrlvues5OFUDCunxInegncfy41DtHXWvw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuRFMKFPhDthOOl0pOcdN6L9NOsFvOuf0Ij5hFoA4HpXA&oe=69A6E4AD"}, {"file_name": "migrated_image.png", "id": "286926512302306", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974503_2971137249627887_2738815793285300224_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VIbFMtOQTkAQ7kNvwHN-Z9m&_nc_oc=AdmStn1Wt22-8G1Mt_x2nsDQMwgPS8JutJN0b3HIslKxI8sD58Ejpn46zGXVJ1deMIM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfujbjHfqQk_sW6s1BzR1bfg00q1WmagNGB--DY8ODhP2w&oe=69A6C562"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1a.png", "id": "796339428369487", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974474_796339431702820_5955742702304479792_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R0HZuLGoyjoQ7kNvwH4GUuS&_nc_oc=Adkrcd42fJmia7HLD2GGmAf3WImnCEpZoZvAqbNmr5cAp31YoPvNk7Hp0xWlybasKUE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft73LGpwBKsbBwrbA5r3d2kTqSUNSDdlEv2exK9R7uwjA&oe=69A6E4EA"}, "display_name": "Pro Bowling Social", "keywords": ["bowling", "tenpin", "multiplayer", "sport", "sports"], "long_description": "Bowling is a fun sports game but you need go to a club since it requires a large space to play. With Pro Bowling Social you can play bowling in the comfort of your home. \nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them."}]}, "developer_name": "Moonstar Games", "developer_privacy_policy_url": "https://www.moonstargames.com/bowling_privacy.html", "developer_terms_of_service_url": "https://www.moonstargames.com/bowling_terms.html", "publisher_name": "Moonstar Games", "support_website_url": "http://www.moonstargames.com/", "website_url": "https://www.moonstargames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7978772488821844"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031514_613734426919831_2718185183447709503_n.png?stp=dst-png_s360x360&_nc_ca
oc=AdoIJguM6i1Zo7UPayg2ycwteY8h5xgo2cl_UeK6OxDbEhwk2OimansMx7v5EY8tUG8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSK2PlVYCcfjjeIgYRvttRJDAiWzfkoh7L_DHYoz5R9CA&oe=6AF092B1"}, {"file_name": "migrated_image.png", "id": "201811821110842", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982559_1211352452359901_1653211106404990976_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=49t0rmibofkQ7kNvwE3wwti&_nc_oc=Adqo7hkGGqJgCIzchg6L1p4RR3VJWZXMZ8SC3n0b1RZgEcy1XhVElyEq1AIwDdejp4Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQboTwq3dUc4JbqJQOSoKmFE31UXcKD2Gj_1PH0gyUTpg&oe=6AF094F4"}, {"file_name": "migrated_image.png", "id": "196159655021180", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974876_480368835864611_6173717808111681536_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JOou3OuR41gQ7kNvwESA5ew&_nc_oc=AdrKzoYmYSyMSEMOQtCbgiE9lcUbW-sw_hDso7QlKdQ5jMFmdBXjm8Fy-Y-W8IQcY0k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQY3TGZyTgZqaauVKO6plbW_1A8HVjAXrJzMjnTyllJcw&oe=6AF0B3ED"}, {"file_name": "migrated_image.png", "id": "286926512302306", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974503_2971137249627887_2738815793285300224_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e8AE16J4QPgQ7kNvwGrhpsX&_nc_oc=Adolk24wscmgc5JTfd_PDLEsM-LWvU5L4uHsph-qff24AQ5SvSEZFVk9x1ZqGSY3J_s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKNqPtjrbe1ErkBrraHr2nDCHo8AJukGerGdi_v1gZMg&oe=6AF094A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1a.png", "id": "796339428369487", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974474_796339431702820_5955742702304479792_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OHEiVrCTOyUQ7kNvwF0cZc0&_nc_oc=AdoFCrYoEPg_pSzjMogjxzuxFg9kvPqGFkyKG8_iuSjbNNUmOstyeTA0b0PpM653LxQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwD6Z5ytE4lseBN_o3zal_WULwpTCBT2UED268Lzc5Gg&oe=6AF0B42A"}, "display_name": "Pro Bowling Social", "keywords": ["bowling", "tenpin", "multiplayer", "sport", "sports"], "long_description": "Bowling is a fun sports game but you need go to a club since it requires a large space to play. With Pro Bowling Social you can play bowling in the comfort of your home. \nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them."}]}, "developer_name": "Moonstar Games", "developer_privacy_policy_url": "https://www.moonstargames.com/bowling_privacy.html", "developer_terms_of_service_url": "https://www.moonstargames.com/bowling_terms.html", "publisher_name": "Moonstar Games", "support_website_url": "http://www.moonstargames.com/", "website_url": "https://www.moonstargames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7978772488821844"}, "review_messages":
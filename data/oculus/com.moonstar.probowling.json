oc=Adrsh5_Mx12yYIJw50zOlO04dOEqQsWclUEp2A8DxONB-SAr70OuhgtofXRF2DFZqek&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_EBfMMUd0PdcjKfbCxZsJ5EHMTVXEoU9PSDHYMDR_usw&oe=6A428CB1"}, {"file_name": "migrated_image.png", "id": "201811821110842", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982559_1211352452359901_1653211106404990976_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jJFKTjPn6jcQ7kNvwEMlcah&_nc_oc=Ado6CGtP3YB7sHGaELV_-K9d-1FFxBcOdv6AAzrigUcn-ZWXRXiMMoNy37-tWEPrF1k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af814KwqbTXvmHeMZzgaVZ7_3scUWcSDZYXFDZ1X2KOhUQ&oe=6A428EF4"}, {"file_name": "migrated_image.png", "id": "196159655021180", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974876_480368835864611_6173717808111681536_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ReabVEg_p0IQ7kNvwF5y5QJ&_nc_oc=AdrnJAxQKv-b6lnh8onz8Kjc7x5kMlFu6ZoIzC2Zk1AEU5e8NTVW4BkIsFMkiAysUlU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-dfXolIyk7VvUq_6ZaiFCpnVtaU8R-KzvsQRyq6fKXeQ&oe=6A4275AD"}, {"file_name": "migrated_image.png", "id": "286926512302306", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974503_2971137249627887_2738815793285300224_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SJpiqIWpCh4Q7kNvwH3I2Am&_nc_oc=AdqQ91jP72-12oWDfbmJhd0Sa0UbTA9gaXkkbdw3vf0vit7mjVdqjcNvos0ltN1Jgy8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_FUA1PA9rdFX8gPfqvwBxL9lxaBLaErP4YBEhOYfRapw&oe=6A428EA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1a.png", "id": "796339428369487", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974474_796339431702820_5955742702304479792_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=joezO4nAjkYQ7kNvwEJZAyQ&_nc_oc=AdoPpXVdDQk4cxtKWKNSKB0hMgBPCLI7NdNl5ypZLh4LRW5kSn_bSWGw5aMgTkj1N8A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-afgRQoelmxsBxqi7PMWwsx_NM9TeCvjDC14PBvb2sTQ&oe=6A4275EA"}, "display_name": "Pro Bowling Social", "keywords": ["bowling", "tenpin", "multiplayer", "sport", "sports"], "long_description": "Bowling is a fun sports game but you need go to a club since it requires a large space to play. With Pro Bowling Social you can play bowling in the comfort of your home. \nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them."}]}, "developer_name": "Moonstar Games", "developer_privacy_policy_url": "https://www.moonstargames.com/bowling_privacy.html", "developer_terms_of_service_url": "https://www.moonstargames.com/bowling_terms.html", "publisher_name": "Moonstar Games", "support_website_url": "http://www.moonstargames.com/", "website_url": "https://www.moonstargames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7978772488821844"}, "review_messages":
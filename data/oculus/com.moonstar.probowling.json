oc=AdoECd662RySWoSTJnVt7IUA3rNhsU9IplNfIpvWA1V3NUtwJZ0dQagceKUUtDRER5g&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ZjfMzZ4YXVCvuy0ZsPBgfrH0BmJw-ofOA-YJ3RfRTgQ&oe=6A1C5131"}, {"file_name": "migrated_image.png", "id": "201811821110842", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982559_1211352452359901_1653211106404990976_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ndfMbD3ZZNsQ7kNvwHGxcd0&_nc_oc=AdoYekcUnxmTfM_a1Yd-elRCQ60TfTVvq6uIUyHCSP1yToRXtvEslcQDPt7g_bqMF0o&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5KRfniYFvcPbqdYPFqzOHGQnxGQsTck9u9vfwNK1s--g&oe=6A1C5374"}, {"file_name": "migrated_image.png", "id": "196159655021180", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974876_480368835864611_6173717808111681536_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HX_KI25ysQ0Q7kNvwHpTo1B&_nc_oc=AdrfJV7_IBijBpVS6-4IiV4ZgXoPAL3M0m32lRXF7y0OrpXNSRiLj9NW5j3rWxbZ7Og&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6XMLiPq56gkVwjsEHwi5YtAf-oDLAXNbdItWnC9m-zxA&oe=6A1C3A2D"}, {"file_name": "migrated_image.png", "id": "286926512302306", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974503_2971137249627887_2738815793285300224_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NFaVlZxVX30Q7kNvwFfM3YB&_nc_oc=Adr25Ztuv1WDriaf0aFmUJfqUx8J6VIsQkiZDinGt6_X7VVdZ7ztG4kD-sCrYP7CGmY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ik3uD2mPxbXv4RPcHjp98lgNFfHChYCAcmtb-ICCg9Q&oe=6A1C5322"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1a.png", "id": "796339428369487", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974474_796339431702820_5955742702304479792_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PD80aRjtfS4Q7kNvwFeU_IA&_nc_oc=AdrsxF8orV3GmuwrauwxRvmU9Qo5uhYnGUFspyILB2i4VVqLy5csBxqFucOoU56VqbI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ozK5_CpKmfrnvJFSUuO_WEgC3k7Ldz6Z5Cat6gDFmPw&oe=6A1C3A6A"}, "display_name": "Pro Bowling Social", "keywords": ["bowling", "tenpin", "multiplayer", "sport", "sports"], "long_description": "Bowling is a fun sports game but you need go to a club since it requires a large space to play. With Pro Bowling Social you can play bowling in the comfort of your home. \nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them."}]}, "developer_name": "Moonstar Games", "developer_privacy_policy_url": "https://www.moonstargames.com/bowling_privacy.html", "developer_terms_of_service_url": "https://www.moonstargames.com/bowling_terms.html", "publisher_name": "Moonstar Games", "support_website_url": "http://www.moonstargames.com/", "website_url": "https://www.moonstargames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7978772488821844"}, "review_messages":
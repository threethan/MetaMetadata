oc=AdqfT4FCpi732nc2wnNScttrg5IIaU5EdInBeyZHhUeWlFuCD0RZ4O8039pQjoGvBPY&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQILLYf1quaydJYW3ltcgaGcF5k7cewBU_wqVpiNDc1g&oe=6A9724F1"}, {"file_name": "migrated_image.png", "id": "201811821110842", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982559_1211352452359901_1653211106404990976_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W-lUK2gBFw0Q7kNvwEU3Bm2&_nc_oc=AdpiAuuBJS7B9zTmN4RTxxsq3rbyDSKTpDnsqfgpmM4FM3kuVOMRS-M7n5zH6EBqYH4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGquHDYPVGlN_MZrh65pY6oo9oWAxJ3vfhUW68pWyS_LQ&oe=6A972734"}, {"file_name": "migrated_image.png", "id": "196159655021180", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974876_480368835864611_6173717808111681536_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EmNtYjR0J98Q7kNvwFUCiwc&_nc_oc=Adp3miJWX5JC6YZ3u11LzcUUylF2HJAWHH-NZFw6XpM3bOl_u14yTo8LkKmfm2BQFhs&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4Y97uZ2nwXQN822RK0g_8aKSMqluabpk9IiTWBzcHNw&oe=6A97462D"}, {"file_name": "migrated_image.png", "id": "286926512302306", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974503_2971137249627887_2738815793285300224_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1TYOV_Y5GSsQ7kNvwGMmptc&_nc_oc=AdrpbhKDs7527npJoTJhEiurBT5-abSs48s1CRtXP-S27lvYxfSh2C9wUZTs0NZ4Pjk&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGiqn-M0FMuHPpkDvuPAtPEU22Kiz8MnUUiKy8fQ3rEYQ&oe=6A9726E2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1a.png", "id": "796339428369487", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974474_796339431702820_5955742702304479792_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H8BTr_FbbnMQ7kNvwEKIBx2&_nc_oc=AdqDGAdYhsA5LTzySl8woa0i16eqQbLhdCT-Qw_1RZ45u30cRPp3NgdWdX3i3zu1xFk&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGiHwEOrOh36fOLtlASLr5PIN6clCtbcCwh_hv_exbuyg&oe=6A97466A"}, "display_name": "Pro Bowling Social", "keywords": ["bowling", "tenpin", "multiplayer", "sport", "sports"], "long_description": "Bowling is a fun sports game but you need go to a club since it requires a large space to play. With Pro Bowling Social you can play bowling in the comfort of your home. \nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them."}]}, "developer_name": "Moonstar Games", "developer_privacy_policy_url": "https://www.moonstargames.com/bowling_privacy.html", "developer_terms_of_service_url": "https://www.moonstargames.com/bowling_terms.html", "publisher_name": "Moonstar Games", "support_website_url": "http://www.moonstargames.com/", "website_url": "https://www.moonstargames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7978772488821844"}, "review_messages":
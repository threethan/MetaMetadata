oc=AdqOK3MwcfrfCNUfj8StfUXVqTi9eL3Bu-uLkYtzvltYSyms23vCekTFmHA8k8JEuVE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM9wrsE31rYq5bZhfUTXDewBJ_cwp69bgd_xJs5eMgXMg&oe=6ACE4BB1"}, {"file_name": "migrated_image.png", "id": "201811821110842", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982559_1211352452359901_1653211106404990976_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c4dOINql70QQ7kNvwFqp1q2&_nc_oc=AdptSVw5w7EbWG6NzFYm7opcqsTsHJ1j6l-BZpp4CMSDiE1cXt79LUjkkUmCDg63SFI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMLMx2HkS2-oMVkpFxzDETGqJOUQYK52McWVJwxB0ESTQ&oe=6ACE4DF4"}, {"file_name": "migrated_image.png", "id": "196159655021180", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974876_480368835864611_6173717808111681536_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lgAGjPxtyfwQ7kNvwH1LTFI&_nc_oc=AdoqPWpJx1hBcLTDniMrKZCPoHwQAgvmYsCAUxmlh8QScqReQBeWjk-NeFCYcUhbpkQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOqviin_w6W_ys41CzbaUUGzebwiRLOqxIw3pQ4ChdiwA&oe=6ACE34AD"}, {"file_name": "migrated_image.png", "id": "286926512302306", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974503_2971137249627887_2738815793285300224_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0WsWqwXDM-gQ7kNvwF-CJma&_nc_oc=AdrxLp5G_MD0IfBDa4N4Sppd1Y9z5GYZRhDHV6iw7AokFIgzdl4VX45g7MptIg5rRy4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMw6I8XygWFVYfnN0PpN_X7pC7xaMbnA6o72iUkPIR6fw&oe=6ACE4DA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1a.png", "id": "796339428369487", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974474_796339431702820_5955742702304479792_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gOGUn7uALzQQ7kNvwG_NBuH&_nc_oc=AdpOJ-KLBrkRsJMb_SNtgYD5RDu3jpw81vqMO6h3EAv4a54jA0j4333mGxakopqJY4s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPc-0mljRKp9fb8kgiOxJFsMw_r33lkfWrV5Ltcj-ZEdg&oe=6ACE34EA"}, "display_name": "Pro Bowling Social", "keywords": ["bowling", "tenpin", "multiplayer", "sport", "sports"], "long_description": "Bowling is a fun sports game but you need go to a club since it requires a large space to play. With Pro Bowling Social you can play bowling in the comfort of your home. \nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them."}]}, "developer_name": "Moonstar Games", "developer_privacy_policy_url": "https://www.moonstargames.com/bowling_privacy.html", "developer_terms_of_service_url": "https://www.moonstargames.com/bowling_terms.html", "publisher_name": "Moonstar Games", "support_website_url": "http://www.moonstargames.com/", "website_url": "https://www.moonstargames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7978772488821844"}, "review_messages":
oc=Adqrj-V1is99NcskK3CCdkEX2h8uXBzQJvQssJMkjwKvtyAPCIKrbC-tVmktmFqyeR0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ddA_0QhcWMDow2oK6L94buoT2bKkzDleNzlem-6IHyQ&oe=69D78AF1"}, {"file_name": "migrated_image.png", "id": "201811821110842", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982559_1211352452359901_1653211106404990976_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PoOLpfKJpoAQ7kNvwFzWRnP&_nc_oc=AdqApt-I1ehiOCOBSduGzij2yxSwplnmS9WeFtfW8e3TcKnH2qEfVhYepHiNYCxaBMI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af09vD7vaoudgmDADp1t-hHvVruSLe6cQx1JNDnKVLxkZA&oe=69D78D34"}, {"file_name": "migrated_image.png", "id": "196159655021180", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974876_480368835864611_6173717808111681536_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-eYN_yDWXUwQ7kNvwGmVogy&_nc_oc=AdoPU4nLF-kRPWG_MdEu-4cEUQMNoh8Xgu_d3rr60vkTGxOwJFjbazh2_TmsNcLMreM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af23xMiaiL9aB5z0NjA6PQtM0AXbRBN6RpRV1ZjbpPXCYQ&oe=69D7AC2D"}, {"file_name": "migrated_image.png", "id": "286926512302306", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974503_2971137249627887_2738815793285300224_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y0xVKC9bZMUQ7kNvwGVOKZd&_nc_oc=AdqMMtMk8jfyt7GrpBWXxXIomBs1QaKdYJOf9xTa8I5AjeDUEDBX9edX-UzcR9al85I&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Rnq0XFDXzrnXkiucg7s2AZhK1wyqJnLuCM3Lh2MQwKQ&oe=69D78CE2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1a.png", "id": "796339428369487", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974474_796339431702820_5955742702304479792_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qpZmXpvfDygQ7kNvwGpXD5V&_nc_oc=AdpzMpu5T3KtXsCFmgfdMlNwRFlUKjGjdTiexTZLpHoGhWTud2vg56YjCSvS5xlbxnw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af00f690mbi_ut8Bw5Rqs5uUEZT81pN42jr55uQjSXoLxQ&oe=69D7AC6A"}, "display_name": "Pro Bowling Social", "keywords": ["bowling", "tenpin", "multiplayer", "sport", "sports"], "long_description": "Bowling is a fun sports game but you need go to a club since it requires a large space to play. With Pro Bowling Social you can play bowling in the comfort of your home. \nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them."}]}, "developer_name": "Moonstar Games", "developer_privacy_policy_url": "https://www.moonstargames.com/bowling_privacy.html", "developer_terms_of_service_url": "https://www.moonstargames.com/bowling_terms.html", "publisher_name": "Moonstar Games", "support_website_url": "http://www.moonstargames.com/", "website_url": "https://www.moonstargames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7978772488821844"}, "review_messages":
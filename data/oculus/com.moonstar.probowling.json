oc=AdqBalAoUQiUJDkVrMrqqUwvu5wF4mkRe42o_yY7fNoUoSQpbsBl2Roq9DHB7i1F-cA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOhHWUXG2c1srPOAxHi_Rj1eVyNbv7HHKzBWt0cd4p5Dw&oe=6AD0EEB1"}, {"file_name": "migrated_image.png", "id": "201811821110842", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982559_1211352452359901_1653211106404990976_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b2aGa8x6xrwQ7kNvwHPZLnt&_nc_oc=AdpOL1C8VxUCo0OT7brvXeVHjdQq6MfZQUwjafR8Rg1gI25sNTlj3MRxETGk-7I-m4U&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMOEukQBwEDOsgJfMCw-BCM74bXdvcIlhefX_F9VFeuaQ&oe=6AD0F0F4"}, {"file_name": "migrated_image.png", "id": "196159655021180", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974876_480368835864611_6173717808111681536_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QTP-esEdpoEQ7kNvwGfmcF0&_nc_oc=AdoE9PTymT3VJUN0NnLpVaj9ZLJEthdzt5Hh7qkqOUPyv1ZmSUMSpK2KHY9mTOteVv4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPcF1h8Z8_6gham5oGrU0BkEksFF_-HEjvRpFCSgewVIQ&oe=6AD0D7AD"}, {"file_name": "migrated_image.png", "id": "286926512302306", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974503_2971137249627887_2738815793285300224_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZVlGDD3HFwAQ7kNvwGkSAbe&_nc_oc=AdqeHvF9uTi4PDi1pK8Y5pmZqnoNuWsjBtg1j9Kr9nBV6MzbuuiEOjQF19AMYSeHeT8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMV-zQEg4_Uv0CxJ3AyGlvCgH9Ra-9JEZrr1Opr45L1qg&oe=6AD0F0A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1a.png", "id": "796339428369487", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974474_796339431702820_5955742702304479792_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lefSWmg9-O8Q7kNvwFOL_Rm&_nc_oc=Adq3FGRdP9cLHTkxnaqZgzodY4sAcYbd9v35d7BB4GTqaPXoYZomGny1u_nMRrfT35k&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOggcDNPzIvBCLlxmqy8xaQIoPgVzhK5tyaTuIIvuujCA&oe=6AD0D7EA"}, "display_name": "Pro Bowling Social", "keywords": ["bowling", "tenpin", "multiplayer", "sport", "sports"], "long_description": "Bowling is a fun sports game but you need go to a club since it requires a large space to play. With Pro Bowling Social you can play bowling in the comfort of your home. \nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them."}]}, "developer_name": "Moonstar Games", "developer_privacy_policy_url": "https://www.moonstargames.com/bowling_privacy.html", "developer_terms_of_service_url": "https://www.moonstargames.com/bowling_terms.html", "publisher_name": "Moonstar Games", "support_website_url": "http://www.moonstargames.com/", "website_url": "https://www.moonstargames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7978772488821844"}, "review_messages":
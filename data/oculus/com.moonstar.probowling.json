oc=AdqV0ayU3gFZjb4GcxjQYyDEnBEcV_yoD2jcWo4jcFFNJTxa2gt29T1Cs19GTj4_5gs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UegbG3gp8w67-V8rKEW43eo1gc216vBBRzDU7OWjg_g&oe=6A3800B1"}, {"file_name": "migrated_image.png", "id": "201811821110842", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982559_1211352452359901_1653211106404990976_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Uc7Khsxe8wQ7kNvwFIIbyz&_nc_oc=AdrQtoNSsYFoOM57mAbu7D1kln5GUtMlqogfnwjc4_0x6dHrDBG3tjrlV1z3xLLNHhU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3I57AIHMzDk4JNvyvJZgOPOWnMzOGoLOvyDsSqoZHqg&oe=6A3802F4"}, {"file_name": "migrated_image.png", "id": "196159655021180", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974876_480368835864611_6173717808111681536_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z4An8qBYRoUQ7kNvwGk16Is&_nc_oc=Adp42FxAwYeDKnnSRAs8nHRtnpMmEkzLQayje7jLsJ8QOe33OUUPu2w_-sSV9fi1o6s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XGM8YTDMvNioioi0OMNZbpwreWkQ-eOOvsxC_PbjRSQ&oe=6A37E9AD"}, {"file_name": "migrated_image.png", "id": "286926512302306", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974503_2971137249627887_2738815793285300224_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ijAp2W1kPowQ7kNvwFVjFP8&_nc_oc=AdrtFD-gqX64oWIY3cPvm2LWrrUGEfrOOvEVBP2mJ57SgKJdDNbgDLScXWsvC29ewgI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8eYm_xWBTHIR3lh2SlfX3u1Mz_4wjsJIQu7oFVGFTUXQ&oe=6A3802A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1a.png", "id": "796339428369487", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974474_796339431702820_5955742702304479792_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tjgwsZIyV8gQ7kNvwEIxGOD&_nc_oc=Adqpny0i2WvuJ9PDfehOBwGVQkINOPofPvCXX9TMHrEaBG3u3dmnzCFzEB3q4sygV9A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8mJtjiwFVoPhCODItBmP1ghlGlSA9W9-QRbBE797e8ng&oe=6A37E9EA"}, "display_name": "Pro Bowling Social", "keywords": ["bowling", "tenpin", "multiplayer", "sport", "sports"], "long_description": "Bowling is a fun sports game but you need go to a club since it requires a large space to play. With Pro Bowling Social you can play bowling in the comfort of your home. \nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them."}]}, "developer_name": "Moonstar Games", "developer_privacy_policy_url": "https://www.moonstargames.com/bowling_privacy.html", "developer_terms_of_service_url": "https://www.moonstargames.com/bowling_terms.html", "publisher_name": "Moonstar Games", "support_website_url": "http://www.moonstargames.com/", "website_url": "https://www.moonstargames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7978772488821844"}, "review_messages":
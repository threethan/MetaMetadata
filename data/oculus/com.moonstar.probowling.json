oc=AdoZL5BEHYTyO1GzszM79m1ljdWUgRqGPwVYRhgDsFXU_HhZuCyczvETqV6m0W2clT8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyX7gyiS31VJ4Xf0YGEKRdw9M50iqela-yzTus-eWyqew&oe=69C272F1"}, {"file_name": "migrated_image.png", "id": "201811821110842", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982559_1211352452359901_1653211106404990976_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hGUx32AGvKEQ7kNvwHLE9KT&_nc_oc=AdphEoA3eZDD2CcLZDUOd_lE2en9wwA_H4wNmXoT3u5shP6FDidpzyFxQVa1gDlBOuc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwcT_aYQoDdVAtMUWrY0UZ54ESlYJXPiU0G2NdSYTEY1A&oe=69C27534"}, {"file_name": "migrated_image.png", "id": "196159655021180", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974876_480368835864611_6173717808111681536_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4bxVOVcdiBQQ7kNvwHw_kEm&_nc_oc=AdpduRMrfcIw6RDkJhnVmcCY4Y86ERdB3nv-m3-VqJEnmPH1ZpkuVoVD1SAAQhKAsnk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwj_PdhO_ssYQvmkEOY3f692eQ0bfNG0DKBpTjW2gxskQ&oe=69C2942D"}, {"file_name": "migrated_image.png", "id": "286926512302306", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974503_2971137249627887_2738815793285300224_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E8XDQ4JF0HgQ7kNvwGem0mQ&_nc_oc=AdpzE1xUGpptSwwjzzUsPz8w1wQW_VZTpp3GEdl4rscSwgFeBqvPwaIUzTqdttP2eK8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz5OM-tIn2qnKHBLirOdmAb_ovuzQFjn7tnurHiO6TxLw&oe=69C274E2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1a.png", "id": "796339428369487", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974474_796339431702820_5955742702304479792_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i-2flMfRlXIQ7kNvwEkAZyH&_nc_oc=Ado7LeEMKVUaE4AI5-FXhmMnSc2Cfc_HK0eglm1u1dNV_p8915aRkgSOh7yQhuvxH5M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzi1h8-PMVgYxysGkV2oeraJgFmdPTaM-1IXe9wDLg9oA&oe=69C2946A"}, "display_name": "Pro Bowling Social", "keywords": ["bowling", "tenpin", "multiplayer", "sport", "sports"], "long_description": "Bowling is a fun sports game but you need go to a club since it requires a large space to play. With Pro Bowling Social you can play bowling in the comfort of your home. \nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them."}]}, "developer_name": "Moonstar Games", "developer_privacy_policy_url": "https://www.moonstargames.com/bowling_privacy.html", "developer_terms_of_service_url": "https://www.moonstargames.com/bowling_terms.html", "publisher_name": "Moonstar Games", "support_website_url": "http://www.moonstargames.com/", "website_url": "https://www.moonstargames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7978772488821844"}, "review_messages":
7kNvwGu_fiD&_nc_oc=AdrB3w6W-h89s9Q2ZXq02e5-uYf4lrU1CI6GLm-ZNt1qkJRF-AV42EA8V8jO6moG0o4&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGiNyBpzjCMmmPsaP3Vmw_np9Tu8OxFiWQb_pYQyG6hSg&oe=6A8590F1"}, {"file_name": "migrated_image.png", "id": "201811821110842", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982559_1211352452359901_1653211106404990976_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8aLf2DaJ5DkQ7kNvwGNYySR&_nc_oc=Adrv_ekgkCA2GsETHyVXwuDgLQGf84JkldLlB_GcsRmK0eETFUEjCH0cas0MFq6gKlk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGL8P51d7eBcqGX9P4rCYSMX3N1Yj2HsQ2WKoZXHEMOig&oe=6A859334"}, {"file_name": "migrated_image.png", "id": "196159655021180", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974876_480368835864611_6173717808111681536_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V1oeWFu7-WMQ7kNvwGURKnF&_nc_oc=AdrxUq9NE6C1L3ePK-0JvsNfYF5pZXlsdwQ8NjiiVCrbfK_GdJlLIAK81i6JQP3-XVk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHvlGA883U8RHFkn5XW4togIPX1VmDeW2lUbGyaoz9EYQ&oe=6A8579ED"}, {"file_name": "migrated_image.png", "id": "286926512302306", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974503_2971137249627887_2738815793285300224_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WK71DbWWDG4Q7kNvwEe7nGI&_nc_oc=Adqn7r2MtTdPmg3Xx2feb6qAUlYnuSUuL8EmwqnaQ0adcOadkbmcJ24W1QxnrLdkSyA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4BEOlHKkiKigzFiiqDJFyhXgVqRmfQTnhepSzXqHB0w&oe=6A8592E2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1a.png", "id": "796339428369487", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974474_796339431702820_5955742702304479792_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hQFXMvbhulUQ7kNvwEWhKzG&_nc_oc=Adrl5WB46aTiv625ZRJzmWmyNCs0Rx2d7SLtikwde1n-IzOxB3b0WYjiADKqfE79hR0&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF14gnoACMujnwQ3WiPtHZ7bRB7iRWFbqO8EoSja49Djg&oe=6A857A2A"}, "display_name": "Pro Bowling Social", "keywords": ["bowling", "tenpin", "multiplayer", "sport", "sports"], "long_description": "Bowling is a fun sports game but you need go to a club since it requires a large space to play. With Pro Bowling Social you can play bowling in the comfort of your home. \nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them."}]}, "developer_name": "Moonstar Games", "developer_privacy_policy_url": "https://www.moonstargames.com/bowling_privacy.html", "developer_terms_of_service_url": "https://www.moonstargames.com/bowling_terms.html", "publisher_name": "Moonstar Games", "support_website_url": "http://www.moonstargames.com/", "website_url": "https://www.moonstargames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7978772488821844
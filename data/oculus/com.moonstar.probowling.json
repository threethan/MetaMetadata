oc=AdosBsV9GB83amCFSjrlyAplwzDF5WEfNTj7B8N0ivTELWVQprGH2WPKWc2wUcyJRsQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAq3Yyv_nQB1_St0GjDtYouAHLfUnBUygvUiTNuiy28Jw&oe=6A53B031"}, {"file_name": "migrated_image.png", "id": "201811821110842", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982559_1211352452359901_1653211106404990976_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=udejbjO07k4Q7kNvwEsQAi4&_nc_oc=AdpDvrkp0wqjucQr8UFgS0V1005jomuU5-XLyl-5KBXh6qs-0wecxf7CE-gpNxqmens&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD0ficvBzpV5NwNLQ490sx62aAODqefE-vpqfKEuMG9OA&oe=6A537A34"}, {"file_name": "migrated_image.png", "id": "196159655021180", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974876_480368835864611_6173717808111681536_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f6Ni4U6Ed94Q7kNvwHc99GC&_nc_oc=AdrAMHgSLNOI57FYVOwDrmzaHOXXH1PCKzgVlNBAkbFJOpdQELcMAOKQALgOWFwENbM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCHL7Ge_41c6OoH2sa168ePeKMRU9KxUYT5d6vaMRBVQA&oe=6A53992D"}, {"file_name": "migrated_image.png", "id": "286926512302306", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974503_2971137249627887_2738815793285300224_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LjLI2DjUB1gQ7kNvwHpzc_E&_nc_oc=Adrpk5PGeGS3TQHz31QTy4N4VHnfCUIZBnfI-nOIviqz0Mm2hV5lGda6QAjl8xkdtWE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhQ1Cs1eBIDnSEeyUR-wQMd5jlBSqZMUN-BKhyhCs9DA&oe=6A53B222"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1a.png", "id": "796339428369487", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974474_796339431702820_5955742702304479792_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nycVgty-WgAQ7kNvwHZhlda&_nc_oc=AdonfXB_2DjfwGaCKoKqyPddPaV8pe1vdnKpDb9ShxRMLS2en8eTYQ73ARyfaINB700&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAu97S5tahwg-qjswZ5TqUKG0g6B3yAD_861Kh9J4tXnQ&oe=6A53996A"}, "display_name": "Pro Bowling Social", "keywords": ["bowling", "tenpin", "multiplayer", "sport", "sports"], "long_description": "Bowling is a fun sports game but you need go to a club since it requires a large space to play. With Pro Bowling Social you can play bowling in the comfort of your home. \nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them."}]}, "developer_name": "Moonstar Games", "developer_privacy_policy_url": "https://www.moonstargames.com/bowling_privacy.html", "developer_terms_of_service_url": "https://www.moonstargames.com/bowling_terms.html", "publisher_name": "Moonstar Games", "support_website_url": "http://www.moonstargames.com/", "website_url": "https://www.moonstargames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7978772488821844"}, "review_messages":
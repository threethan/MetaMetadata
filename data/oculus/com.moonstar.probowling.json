oc=AdpVFwGOoNrVZ53hMUjhBnebCiYlwy5s54F2v8jhyrbM1sNqba2xgB15VQjARPkIaS4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP5xHgvowmfQLhpCAQFNjlrxhWIHgLFx0yk1wwnRueRcw&oe=6ACBA8B1"}, {"file_name": "migrated_image.png", "id": "201811821110842", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982559_1211352452359901_1653211106404990976_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c4dOINql70QQ7kNvwGXsNcQ&_nc_oc=AdpMfm5D44kqPdT2mfZ_SIUu-ZWBUTVeiRnfKRb-DVNhSnHnlKagnbd921hr8Lh39ww&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPqy8Vrwb1jmLg6P72R1EL_zCFaJkNuyvpRU7dof9ioJA&oe=6ACBAAF4"}, {"file_name": "migrated_image.png", "id": "196159655021180", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974876_480368835864611_6173717808111681536_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MGoIAEFl0ucQ7kNvwHpzO5Q&_nc_oc=AdqK1kmBArS0sGxJxhGD76j6pOdM8yC3JD47g0vl5nOJl49T8NQpgZYIEcr0qqE0Df8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMPZNqUrtCysndDn9vNHnmcoBiG5R2yxaSmWaYzLZpCwQ&oe=6ACB91AD"}, {"file_name": "migrated_image.png", "id": "286926512302306", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974503_2971137249627887_2738815793285300224_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0WsWqwXDM-gQ7kNvwHqXyaA&_nc_oc=AdqEUqcgUBiR23JwAdYI-Afbr1GliXQ-KYmhyoBiyOQmpYbdKXo1uyKwxS2DyOHBJIc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOLIQF0QF4BXnTqqZXCv2jpGGpfFwyn6ALFNhIZC60CPA&oe=6ACBAAA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1a.png", "id": "796339428369487", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974474_796339431702820_5955742702304479792_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uL4OaSGIAMEQ7kNvwFGEWQE&_nc_oc=Ado6TzlY0N1n1ORCHMOtpembp7tiG9LLgGSW_mzLu-7TbYc-7bhp-whTNnFDHPsUrcA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPfGoK6-smhhvzuA3ES85vB15wX3q785aUiwzNmRy4Dbg&oe=6ACB91EA"}, "display_name": "Pro Bowling Social", "keywords": ["bowling", "tenpin", "multiplayer", "sport", "sports"], "long_description": "Bowling is a fun sports game but you need go to a club since it requires a large space to play. With Pro Bowling Social you can play bowling in the comfort of your home. \nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them."}]}, "developer_name": "Moonstar Games", "developer_privacy_policy_url": "https://www.moonstargames.com/bowling_privacy.html", "developer_terms_of_service_url": "https://www.moonstargames.com/bowling_terms.html", "publisher_name": "Moonstar Games", "support_website_url": "http://www.moonstargames.com/", "website_url": "https://www.moonstargames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7978772488821844"}, "review_messages":
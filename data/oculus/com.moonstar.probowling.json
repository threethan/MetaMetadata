oc=Ado3EWJu7d9r3Ccw145M3ju0-ji_43w3it_HJlVIKCaTsvoZXVsK4zXOA6gv-5Qeas0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5sZIsgcaCLmYjulZDv-QWxPWU4abBcQ6pMH8V5sSg7Ww&oe=6A0DD0B1"}, {"file_name": "migrated_image.png", "id": "201811821110842", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982559_1211352452359901_1653211106404990976_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T1xCZPpG8X4Q7kNvwGYDEj5&_nc_oc=Adr8KakY243x7mHlEKSBw5As8bHNL7yMYkyamsz4Ymp7N0JZmgma65mJpn4Wkq9BwkU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4RI3aRO2FgnAH3EoXRJxsDjdNcgKYToCVoEHt-o1BBjA&oe=6A0DD2F4"}, {"file_name": "migrated_image.png", "id": "196159655021180", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974876_480368835864611_6173717808111681536_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x5ibdiHoW0YQ7kNvwEp6VjH&_nc_oc=AdrG9prdC7Obxb3WgMX-niBnngdYx8N0jm-w3S3jIDpEfkgsnqQwPE1qR1vW4-QfJMA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6bgCT5xoYBJQFy6FyVmEVjo3Dzx-Rqe4kehZqai4hRaQ&oe=6A0DB9AD"}, {"file_name": "migrated_image.png", "id": "286926512302306", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974503_2971137249627887_2738815793285300224_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SGlYQqTWZzkQ7kNvwEa3c5f&_nc_oc=AdqKRHETZ1fJXsh7zYet6qVGm335FRtd1P5UTe9D4ZnLO67UzRmvbCBVVYj9hQdsTu8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_8yXBFYPyn8DwSYiaXFYk4fx9o1f8r-tI7Ws7uFUAQA&oe=6A0DD2A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1a.png", "id": "796339428369487", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974474_796339431702820_5955742702304479792_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tMU7nJsKhv4Q7kNvwEJKQ8N&_nc_oc=AdrJkOxfkbg_JNPKHnQ0pKl2EAwMXnwBDHbmG4GvsPCnHG95SFjobKTQGByRk-ifArY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4e_K1o1tzLgJCeqi5QSTiLlIUmd2vq4JI8ZlwU3DlXEQ&oe=6A0DB9EA"}, "display_name": "Pro Bowling Social", "keywords": ["bowling", "tenpin", "multiplayer", "sport", "sports"], "long_description": "Bowling is a fun sports game but you need go to a club since it requires a large space to play. With Pro Bowling Social you can play bowling in the comfort of your home. \nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them."}]}, "developer_name": "Moonstar Games", "developer_privacy_policy_url": "https://www.moonstargames.com/bowling_privacy.html", "developer_terms_of_service_url": "https://www.moonstargames.com/bowling_terms.html", "publisher_name": "Moonstar Games", "support_website_url": "http://www.moonstargames.com/", "website_url": "https://www.moonstargames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7978772488821844"}, "review_messages":
oc=AdoWQ4Vpnwgx-bNI4aeu-mZWesBP1N0bQ4zvUmtUaHfwTFowwafzO7iP8yVt4jP5Nx8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLGOzmwjAw-_7Hly4VVfmUT5v5MVbcVDHYv8JUw0A-0Q&oe=6A735431"}, {"file_name": "migrated_image.png", "id": "201811821110842", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982559_1211352452359901_1653211106404990976_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ao6R75A5kO0Q7kNvwG7XeRR&_nc_oc=AdpIrxvyvcxnyCregc7-I_2Ch5v5FJnBD8waqQGUSvsArKG2BRJJPDY1wL11rTh9p-M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGhzZ9JFI0mWePfx_acTiV0JtX7F7oTSz7HwCgWlcgyzA&oe=6A735674"}, {"file_name": "migrated_image.png", "id": "196159655021180", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974876_480368835864611_6173717808111681536_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YDuoJjJawEUQ7kNvwEk4Z-D&_nc_oc=Ado6eNnZcd08S-Av8bp2wK5FFlI8SI7isCzCB8jIPOZsoHyTIf95UebaOWfQoW53SVE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEf0S5rqSszixE2-Y0enYoTn77g06TmDQrbykkw0os78Q&oe=6A733D2D"}, {"file_name": "migrated_image.png", "id": "286926512302306", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974503_2971137249627887_2738815793285300224_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mcV0i0diwacQ7kNvwFTUQjR&_nc_oc=AdrkkIUZbdVzBhKCZJnGjU_rmXk1yvRnebgYRwdYfua4CfCLUB-itfRjkU02vqnCA4g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQ6qtb-N9iFCYAbysijS6nJGRQWIfPKya0k-HvKCp7ow&oe=6A735622"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1a.png", "id": "796339428369487", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974474_796339431702820_5955742702304479792_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uCkhfryGf7MQ7kNvwHUoMyF&_nc_oc=AdpJzr_jyC_deMiepH3TrXOR56H4UZaaO7I8Em_PebvRXxPvvjAJncCbHZowGlwuMLE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0NclCYIwKXkCNemW9MKp324RbgEQGiJAqswngIT6Acg&oe=6A733D6A"}, "display_name": "Pro Bowling Social", "keywords": ["bowling", "tenpin", "multiplayer", "sport", "sports"], "long_description": "Bowling is a fun sports game but you need go to a club since it requires a large space to play. With Pro Bowling Social you can play bowling in the comfort of your home. \nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them."}]}, "developer_name": "Moonstar Games", "developer_privacy_policy_url": "https://www.moonstargames.com/bowling_privacy.html", "developer_terms_of_service_url": "https://www.moonstargames.com/bowling_terms.html", "publisher_name": "Moonstar Games", "support_website_url": "http://www.moonstargames.com/", "website_url": "https://www.moonstargames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7978772488821844"}, "review_messages":
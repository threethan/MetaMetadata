oc=AdoZ9C4xMVQtOg1ZTrUjDSCvPgGBvawd17RhuDLFoTwKTaMW-XB0InNQh-xaK_f7QpU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-oFttJp890qlBd87ENdoc4MF4NMLuH1niUP0oXwX0nsQ&oe=6A3AA3B1"}, {"file_name": "migrated_image.png", "id": "201811821110842", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982559_1211352452359901_1653211106404990976_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nIlnGl4uquQQ7kNvwG4Khyc&_nc_oc=AdoOxCYNUuAn2Ao_EDFLw-WQJs-dCM7cBLVzAEf1lHgSZ57Uy3x9wONlqCMS6yBH34I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Bg3JE93JAmgx_pbI78bJGcVybEgLf6d-WZ1Yd7kcq6w&oe=6A3AA5F4"}, {"file_name": "migrated_image.png", "id": "196159655021180", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974876_480368835864611_6173717808111681536_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7sDLJVE-QA8Q7kNvwE4Mkz-&_nc_oc=AdrbxJv0-N7zX9tIlSLI-O3eOyc1NV2X1cXpheYNcheLGr2o1hRU8IZk9jK2e4TfrTU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-hYgI0hqVcCttxCdwyHLRY_Ev9lNPVT2CNNsLpnWR1dQ&oe=6A3A8CAD"}, {"file_name": "migrated_image.png", "id": "286926512302306", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974503_2971137249627887_2738815793285300224_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=boKzdlp1pUIQ7kNvwFj3vCE&_nc_oc=AdqPZB20Fs0i8hAkIT4CHzWz8nJ4ln81atgreZ1xzPafDA7ZQgzDW2iiz6KoBC0hRFM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-v_qEIQBll5sWsbHy4RaDiwWLdTCFqqoJPTnYSgH6zUA&oe=6A3AA5A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1a.png", "id": "796339428369487", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974474_796339431702820_5955742702304479792_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LL3SKDTMH8UQ7kNvwG-4NNH&_nc_oc=Adr_ROy7JcO8AWlWJ_7W9KkZAA0mv3otrnBH1kwXy8tAJrCiLTaEXAoF6Mv79Uur8Kw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9zNn51MGImAUio9DPoWQKHaJZH7tyfONAvWzyVizu7tA&oe=6A3A8CEA"}, "display_name": "Pro Bowling Social", "keywords": ["bowling", "tenpin", "multiplayer", "sport", "sports"], "long_description": "Bowling is a fun sports game but you need go to a club since it requires a large space to play. With Pro Bowling Social you can play bowling in the comfort of your home. \nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them."}]}, "developer_name": "Moonstar Games", "developer_privacy_policy_url": "https://www.moonstargames.com/bowling_privacy.html", "developer_terms_of_service_url": "https://www.moonstargames.com/bowling_terms.html", "publisher_name": "Moonstar Games", "support_website_url": "http://www.moonstargames.com/", "website_url": "https://www.moonstargames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7978772488821844"}, "review_messages":
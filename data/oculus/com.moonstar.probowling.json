oc=AdrX2AeYWM8IGE3vkHEFML0VIW3guNkyc73KTF1sHisU0OgYyv0fNjz3VUxAy30gs-I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af32JmWA4AWVMD7N_kIXVNZsCEyGtQZx_Tti6qK4zkzLJQ&oe=69EA3831"}, {"file_name": "migrated_image.png", "id": "201811821110842", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982559_1211352452359901_1653211106404990976_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pKYsL6Lxc40Q7kNvwFLnFnr&_nc_oc=AdqMpH8DFd0aQ5L8bKbkIPt26xE2mIppsDBaNJc4o5yoWNwYuNFVnrL-kb4nd-aN1r0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1TwwLcXH0s8PF_ubbmxpPCSCVOx7G__toFcNkfd62y5w&oe=69EA3A74"}, {"file_name": "migrated_image.png", "id": "196159655021180", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974876_480368835864611_6173717808111681536_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QrMqeJ1m8YIQ7kNvwFYhuJ-&_nc_oc=AdoVOfVdLEbWrs-GFDdt6WhydFGQEhvg0WGl0V7tzg0C_qAxF8fBLDXmblvBOa7Sm0c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2bjAzJhxguEB43I4DnwsAZ5fNjNVAKAFm6POqquAt6uQ&oe=69EA212D"}, {"file_name": "migrated_image.png", "id": "286926512302306", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974503_2971137249627887_2738815793285300224_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B691dAjVpXoQ7kNvwEI1Gjl&_nc_oc=AdoEwSOaIUueENXfn0nwjjXE1DOCnwBMvYG7n5AqH-3-gzybZ8thkC0oJ1-9SAr6P9c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Ai1gyYlQBNfHTPSYsMDRLcCxTQdcB85F7HQbU0Ad7Aw&oe=69EA3A22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1a.png", "id": "796339428369487", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974474_796339431702820_5955742702304479792_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-wAgjxCE5BgQ7kNvwHBtfVg&_nc_oc=Adrfn4YfMEbV4i_QcrwFUeV16c9kZ_DLHyyJV5WfzJEHWk0inCXbM4NMgS_YQGEk4MQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0oKV-Qmo68LFg5GSjmVfZ_8e145Ydq4Quv9-w68VqxUw&oe=69EA216A"}, "display_name": "Pro Bowling Social", "keywords": ["bowling", "tenpin", "multiplayer", "sport", "sports"], "long_description": "Bowling is a fun sports game but you need go to a club since it requires a large space to play. With Pro Bowling Social you can play bowling in the comfort of your home. \nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them."}]}, "developer_name": "Moonstar Games", "developer_privacy_policy_url": "https://www.moonstargames.com/bowling_privacy.html", "developer_terms_of_service_url": "https://www.moonstargames.com/bowling_terms.html", "publisher_name": "Moonstar Games", "support_website_url": "http://www.moonstargames.com/", "website_url": "https://www.moonstargames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7978772488821844"}, "review_messages":
oc=AdramUbku9eXoPGjfkWtVvUgacOyRqru9okqPTUlLF3rQ2uX2_Kri5uNg0KSPyf_0RE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBPcLol2XyXl7zIpEQIf2Z1TvLlEbXhad8YNITgevXYyA&oe=6A5501B1"}, {"file_name": "migrated_image.png", "id": "201811821110842", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982559_1211352452359901_1653211106404990976_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U1lQibnyTL8Q7kNvwHTvrvf&_nc_oc=Adp2MtyvithU9-Sq-FNFBXTiBhZNQYduzQplCmJNafhNDAtWvGe22TllzXVwbKxgdPY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCM-WoTF15_J-TCTpn2UH3Xi_rXjShJf0tH9AjJnJIL0A&oe=6A5503F4"}, {"file_name": "migrated_image.png", "id": "196159655021180", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974876_480368835864611_6173717808111681536_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f6Ni4U6Ed94Q7kNvwEgQqpM&_nc_oc=Ado7dPt3ay4rRke920gSN8eKzAJyD8nOSxaDbrUEXllYEVG4bhA6UuCgL4XfezqEx6A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBU3wyUYghlYlaBmGZVf1bbrOABHCX63xb3cp-pvhmyXA&oe=6A54EAAD"}, {"file_name": "migrated_image.png", "id": "286926512302306", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974503_2971137249627887_2738815793285300224_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CDA2s6U3rB8Q7kNvwH_edVS&_nc_oc=AdoWC4qjLxpYgvIsbpkuzVIzede_NOR0awx6MrMWVzDsi60v72LZB3klTRvDU4xGBTQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_5glYShSKWC4G2933Ng9sGraGSEH4D9FIVduT-XpoKA&oe=6A5503A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1a.png", "id": "796339428369487", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974474_796339431702820_5955742702304479792_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nycVgty-WgAQ7kNvwGXO-b4&_nc_oc=Adqjllc_76pnLoDmPn16pQ6aqSaxmkN6hsGyYaHcxrG7GAqGGkKPlBScWDMkh9WLCYI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDfc5-YUsPWEYoe98XCBdq8J6o9RRNgsNTNnaehKdPVcQ&oe=6A54EAEA"}, "display_name": "Pro Bowling Social", "keywords": ["bowling", "tenpin", "multiplayer", "sport", "sports"], "long_description": "Bowling is a fun sports game but you need go to a club since it requires a large space to play. With Pro Bowling Social you can play bowling in the comfort of your home. \nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them."}]}, "developer_name": "Moonstar Games", "developer_privacy_policy_url": "https://www.moonstargames.com/bowling_privacy.html", "developer_terms_of_service_url": "https://www.moonstargames.com/bowling_terms.html", "publisher_name": "Moonstar Games", "support_website_url": "http://www.moonstargames.com/", "website_url": "https://www.moonstargames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7978772488821844"}, "review_messages":
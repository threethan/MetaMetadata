oc=Adp66tbuD_XAK5z2OQRyRQy0E-4HA85kfswHvRZ9G6GSJnr82hpgW4g9wXJqE6_Vdso&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6dzNyfaHQxTK2xtSHl5hy8lInwpmAB4Mj49sOANIFR0Q&oe=6A049631"}, {"file_name": "migrated_image.png", "id": "201811821110842", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982559_1211352452359901_1653211106404990976_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UmE8y6Bzn7EQ7kNvwGhvhvf&_nc_oc=AdrQFg1WP1YiWJ14auEXQrkRIuILNM120XXAQhzsAjTgCDurRzm0OGVqsnnm3k1tUHg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4EipEKo2lkcd8tr0_EpLQwgENFPUHwLLC2ESrBc4BTHg&oe=6A049874"}, {"file_name": "migrated_image.png", "id": "196159655021180", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974876_480368835864611_6173717808111681536_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ga7LKejEZOsQ7kNvwHi3_Sr&_nc_oc=AdqowY7vl-U_nCHTQS7nyPaGuHPXLGp3D5wM8YejL-tT9mKWsZBKb-zxlpV1U9lP67w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Fa0nTJMIOEQ74Me4nexhKqvEanWYI1mE3rm9tzy_VqA&oe=6A047F2D"}, {"file_name": "migrated_image.png", "id": "286926512302306", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974503_2971137249627887_2738815793285300224_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eoKg46RwRPwQ7kNvwE4Ms1v&_nc_oc=AdpDsM8P4zd1aJk09rIf_o3wl28lJoGTpoT--D6xqy1gauCCnZ6SzP6OdQmmn1Sh0dA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6uNLBSYVYu-Zugmki7H0extIQK4iyNJfHsAbHc0cmarw&oe=6A049822"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1a.png", "id": "796339428369487", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974474_796339431702820_5955742702304479792_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Quxi1JJ2vocQ7kNvwFOVVLc&_nc_oc=AdpugHASpTZLbURaBG3dTYtfdYx4oAVStwzCf08xQ02G28TKlKDcBUgXPI-VNz5qm2Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5CBY19GGXV4I7XkLuCGEE_elU52C3h-VY3HTyzq3O6Kg&oe=6A047F6A"}, "display_name": "Pro Bowling Social", "keywords": ["bowling", "tenpin", "multiplayer", "sport", "sports"], "long_description": "Bowling is a fun sports game but you need go to a club since it requires a large space to play. With Pro Bowling Social you can play bowling in the comfort of your home. \nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them."}]}, "developer_name": "Moonstar Games", "developer_privacy_policy_url": "https://www.moonstargames.com/bowling_privacy.html", "developer_terms_of_service_url": "https://www.moonstargames.com/bowling_terms.html", "publisher_name": "Moonstar Games", "support_website_url": "http://www.moonstargames.com/", "website_url": "https://www.moonstargames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7978772488821844"}, "review_messages":
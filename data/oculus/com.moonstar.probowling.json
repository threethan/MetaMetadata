-pIrGCmksabpFeXVCeLpIyzZMn-WIeDoIfOabA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyWeYzxGHwFCSewg6DAwfNmgmOEylwA2ehmGdFZ_Mg72g&oe=69AD5AF1"}, {"file_name": "migrated_image.png", "id": "201811821110842", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982559_1211352452359901_1653211106404990976_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rc_m2_DFcJEQ7kNvwHwbRtI&_nc_oc=AdmHM9PHEUceL7j9hi5mzafWk_c3EvIUlBBSk0-IuGy6Tf773eAaPmpRc-G0_lgyS3o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzF7gYz9RHPtO-Acp_YmxexQP_97GVrSXQz4ySLNdVy6A&oe=69AD5D34"}, {"file_name": "migrated_image.png", "id": "196159655021180", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974876_480368835864611_6173717808111681536_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZidK1UT3bPYQ7kNvwEAZpkZ&_nc_oc=AdmsXYSWKxv5Uo6qEBdo7EpFVyU1JMub6ydD-ZSr16zdtJ027QxbxGRhDQzh0IUg0Ns&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxZY4Y0A9y5HXhXiY3r7Mhc2hKcQviCIyXbPZVEOSaI0g&oe=69AD7C2D"}, {"file_name": "migrated_image.png", "id": "286926512302306", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974503_2971137249627887_2738815793285300224_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yd6PnjKBsrMQ7kNvwHXI7BY&_nc_oc=AdneXyAAisvNYDsZZ26JrKKgLkrNpr68RjXMyr4YXDNNeAnw-HJcbaOjUVhoFux_bcY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzgclQqOL3wBE-OLk6YahVya6jJooxpsxz9MaGlG9l-qw&oe=69AD5CE2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1a.png", "id": "796339428369487", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974474_796339431702820_5955742702304479792_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yaB0Ymw0H3gQ7kNvwGPriZp&_nc_oc=AdmASN2SZ4OvCVZwjVx8L-O7-RM0SHSqxnsSE7dC_rIjheLpSa7sRuCXe4rIPF1a02U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz_8Jv8zXqkngAc4btqcW1WMP5tql69_H37KlDDLmRydQ&oe=69AD7C6A"}, "display_name": "Pro Bowling Social", "keywords": ["bowling", "tenpin", "multiplayer", "sport", "sports"], "long_description": "Bowling is a fun sports game but you need go to a club since it requires a large space to play. With Pro Bowling Social you can play bowling in the comfort of your home. \nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them."}]}, "developer_name": "Moonstar Games", "developer_privacy_policy_url": "https://www.moonstargames.com/bowling_privacy.html", "developer_terms_of_service_url": "https://www.moonstargames.com/bowling_terms.html", "publisher_name": "Moonstar Games", "support_website_url": "http://www.moonstargames.com/", "website_url": "https://www.moonstargames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7978772488821844"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scont
oc=AdofRENnTrFGdbHlLXjTQ5sbruX4rbQt3LLhx0SUXiHRajpCy49utLBIf8jax4TxZWM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4p1rqosFm65l4tBm4NXU13ufW9y5VOSEZOel1SK55Qg&oe=6A819C71"}, {"file_name": "migrated_image.png", "id": "201811821110842", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982559_1211352452359901_1653211106404990976_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u8R37cFsz4oQ7kNvwGwv18L&_nc_oc=AdqSuSqdt6fxfveqSF1KLBCfarjjrWABiN2Gi9tLWM_vPjEImTZZ3YaMuOXregFq5-w&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZKq9HxK-zPDTOqL2yPZ6Ep62GzhESi9E5ut-NmY5tgw&oe=6A819EB4"}, {"file_name": "migrated_image.png", "id": "196159655021180", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974876_480368835864611_6173717808111681536_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UL6OGQHO58AQ7kNvwFQ429c&_nc_oc=Adr5A0QdWK-9JUyNm3TemvYALB8HxcN7DO5GJXKtNQA4Z5bfjF9T-mqs_zO5iKzIruE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFBDpaQsiPUG0OTUZ2FWTijMDG_bh8MGdYsEOHqzDNqEg&oe=6A81BDAD"}, {"file_name": "migrated_image.png", "id": "286926512302306", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974503_2971137249627887_2738815793285300224_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KeI_eWHa7TUQ7kNvwHujnGv&_nc_oc=Adp2xrnckmMTqbrwczZUfu_f3Fe2PX1aNuQz1hxlEycHinOhoTfH4RDnDa5Xo5oENPQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgy-W22k7HdL4zbhJ_dpID2lcJvzYoQY42_DkMCBKUYw&oe=6A819E62"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1a.png", "id": "796339428369487", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974474_796339431702820_5955742702304479792_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g1nDhSjZRtcQ7kNvwF4B3Ou&_nc_oc=AdqgCoYylZwnlrBQJDBeVeS9Vbk47pcrm0BPlct4LaBWmVZtmgfm3FN36rgk7U4FVmI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFxFR_DEWx82-KBi74EsOiGvyphrTpohz7oiaZX1FNPjg&oe=6A81BDEA"}, "display_name": "Pro Bowling Social", "keywords": ["bowling", "tenpin", "multiplayer", "sport", "sports"], "long_description": "Bowling is a fun sports game but you need go to a club since it requires a large space to play. With Pro Bowling Social you can play bowling in the comfort of your home. \nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them."}]}, "developer_name": "Moonstar Games", "developer_privacy_policy_url": "https://www.moonstargames.com/bowling_privacy.html", "developer_terms_of_service_url": "https://www.moonstargames.com/bowling_terms.html", "publisher_name": "Moonstar Games", "support_website_url": "http://www.moonstargames.com/", "website_url": "https://www.moonstargames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7978772488821844"}, "review_messages":
c_sid=6e7a0a&_nc_ohc=E-CM3qRGY0oQ7kNvwGe5ayU&_nc_oc=AdpfS_215bz6Lqv8ATeSx4Yc1Bmaw3E3udTxTmqvjz-2ldfWOaMHPdsnvyNT2tsqKRc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSH8n2iKTFo3ets7lMuPAVotZbQP7GXgS0PzYo1Hafmeg&oe=6AF5C1AD"}, {"file_name": "migrated_image.png", "id": "286926512302306", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974503_2971137249627887_2738815793285300224_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QehXvcesiLMQ7kNvwG7Bb6u&_nc_oc=Adp_k_Ln7xe3lFWsXC4n1zOpHTmizzxJLFx3uO0jSYWjK2LNA6DwMkIDpEcN44WpQQM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSiZkVoyUgyLX_bFwjw_N2o7C_fLkh4FVt9va-ZtXYYQ&oe=6AF5DAA2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pro Bowling Social", "keywords": ["bowling", "tenpin", "multiplayer", "sport", "sports"], "long_description": "Bowling is a fun sports game but you need go to a club since it requires a large space to play. With Pro Bowling Social you can play bowling in the comfort of your home. \nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them."}]}, "developer_name": "Moonstar Games", "developer_privacy_policy_url": "https://probowlingsocial.com/privacy.html", "developer_terms_of_service_url": "https://probowlingsocial.com/terms.html", "publisher_name": "Moonstar Games", "support_webs
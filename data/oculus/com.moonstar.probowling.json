culuscdn.com&oh=00_AfuXyNRz2CFmRxXsm5Syj_U-7Mzq-PYE7WW5byxwRzT1Cw&oe=699EDA71"}, {"file_name": "migrated_image.png", "id": "201811821110842", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982559_1211352452359901_1653211106404990976_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PMmdqRkl5PUQ7kNvwHtZXx1&_nc_oc=AdmRRHbM2Q1ewONuIFLjMePJw09EjrXjgYGx6Zz_amL2iAm5C37QIhFy-QvriK0ZJU0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afur93djUWbM0d9TMM-q_LhcE9HhuHUmBlgOimkqLdR-Wg&oe=699EDCB4"}, {"file_name": "migrated_image.png", "id": "196159655021180", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974876_480368835864611_6173717808111681536_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yJy1uBlDCoYQ7kNvwF3o8Tx&_nc_oc=AdlhYo26_HeioKYKibG9DrXD-Z-v7J0-XOnIHljcgCikeqeRobcoHien9U2NUSMVeZ8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afvsh03KchRC6J02ovtp-jQxoLSveFuMtoG7aoUQzqUp1Q&oe=699EFBAD"}, {"file_name": "migrated_image.png", "id": "286926512302306", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974503_2971137249627887_2738815793285300224_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ElcPFtw1kG0Q7kNvwFnclQj&_nc_oc=AdlXh1sApomgB78xowb7W-YJ1vMQnEh9lsGelAWFUf5EilLDbYxIB2aWz6hQaGmEnr0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftMDJ3sUJhMegDCynWHyorSXnVbwU-0bBgdqpX0FNdmEQ&oe=699EDC62"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1a.png", "id": "796339428369487", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974474_796339431702820_5955742702304479792_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qx2j7wq-NP0Q7kNvwH1T8gE&_nc_oc=AdkvyBANPJWwb2h8dFHxXBC4iC1LCuZszt53pNjYlukAjkfzMOXmEA9L22zfn0BVvDE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuaHQrmVAhBYJ-UUHQbdbA6ElimSnTA1p6cvpRv37JMBw&oe=699EFBEA"}, "display_name": "Pro Bowling Social", "keywords": ["bowling", "tenpin", "multiplayer", "sport", "sports"], "long_description": "Bowling is a fun sports game but you need go to a club since it requires a large space to play. With Pro Bowling Social you can play bowling in the comfort of your home. \nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them."}]}, "developer_name": "Moonstar Games", "developer_privacy_policy_url": "https://www.moonstargames.com/bowling_privacy.html", "developer_terms_of_service_url": "https://www.moonstargames.com/bowling_terms.html", "publisher_name": "Moonstar Games", "support_website_url": "http://www.moonstargames.com/", "website_url": "https://www.moonstargames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7978772488821844"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031514_613734426919831_2718185183447709503_n.png?stp=dst-png_s360x360&_nc_ca
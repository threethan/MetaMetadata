culuscdn.com&oh=00_Afu0k2p-g0HnEbBECcZd-1iNWUcpgS18pLH-av1HQFo8Xg&oe=699842F1"}, {"file_name": "migrated_image.png", "id": "201811821110842", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982559_1211352452359901_1653211106404990976_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0TXChWCUG1AQ7kNvwH0Ms1f&_nc_oc=AdlbuSX7rSrtcaBVBUVRvAfTg01N2YQgFIE3tdFRp0KyFJ5rhBt-wIvxiupYlJljGlI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftR1Z1riqMhmP1eJEhw-cST6eCsJJTJ49EvvPRhzIX99w&oe=69984534"}, {"file_name": "migrated_image.png", "id": "196159655021180", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974876_480368835864611_6173717808111681536_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MGeAvCquNRgQ7kNvwG_2c8l&_nc_oc=AdnoGMmP3aBh3yc65HvDyAJX40M2v242YpokuNP30JdhwuFFuNd6fpikLZ6kCoDa-Nk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfszlOQJfC3oVuBWzKCMcJwK08QOSIBPktkyjVhZSvruqg&oe=6998642D"}, {"file_name": "migrated_image.png", "id": "286926512302306", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974503_2971137249627887_2738815793285300224_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4AOiQvOYfsoQ7kNvwEFSRJJ&_nc_oc=AdlsiYI6wNgopJyOHq4x6mOKDM85GgRd6yg-tinSGH82Cq_HTESHEhjIBVXrxGY270I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Aft6foaaRkz_wxbOF8NE3w9GEHZF5UozkreyDN7w5boj4Q&oe=699844E2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1a.png", "id": "796339428369487", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974474_796339431702820_5955742702304479792_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3s1YTZBue7EQ7kNvwFdHCnC&_nc_oc=AdnGGl5xX9_2GjajSN-ZJsjDLavt2Xh1ocZyl6t6hkx0Oo5HvNdbGH-wKwkBFlESWT0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsWopVJV9kSMOJ-48Xn54YT9XIk2gvhaBnxo4aqNZcLYQ&oe=6998646A"}, "display_name": "Pro Bowling Social", "keywords": ["bowling", "tenpin", "multiplayer", "sport", "sports"], "long_description": "Bowling is a fun sports game but you need go to a club since it requires a large space to play. With Pro Bowling Social you can play bowling in the comfort of your home. \nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them."}]}, "developer_name": "Moonstar Games", "developer_privacy_policy_url": "https://www.moonstargames.com/bowling_privacy.html", "developer_terms_of_service_url": "https://www.moonstargames.com/bowling_terms.html", "publisher_name": "Moonstar Games", "support_website_url": "http://www.moonstargames.com/", "website_url": "https://www.moonstargames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7978772488821844"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031514_613734426919831_2718185183447709503_n.png?stp=dst-png_s360x360&_nc_ca
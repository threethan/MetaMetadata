oc=AdqT5RGgo1g493eOEfWcizGozguwMqCbpCD88zilCFBRzqAYM75xURhcy_e2Bq6cdZg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqsewRRS0FPAisYK0Krw-e3aY3f_WQalgnUTVwzI2Cyg&oe=6AAD5631"}, {"file_name": "migrated_image.png", "id": "201811821110842", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982559_1211352452359901_1653211106404990976_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wgttsfcmArUQ7kNvwGVzgCa&_nc_oc=AdqOemBlRS67CIrMRUFIPFLPsRyuD4w3pF-6kUIqnL8XLYI_nNDBYPdZqpAbTvXpusw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJqSH4lXbx5efSP4zCzETkYT095PvLY-4ptCvlFlvH1UA&oe=6AAD5874"}, {"file_name": "migrated_image.png", "id": "196159655021180", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974876_480368835864611_6173717808111681536_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sHuoDHEnrb0Q7kNvwE--tPC&_nc_oc=AdqZi8zwzEUsF8tk5_vOSAyM3FfjCg0dGMl79y8WLDWISMfp3ebaEt49l9AEnZUTI0Q&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQImMALz93szwYFmViUZEXVsEFCDi87lhOLY7oSr69bLkw&oe=6AAD3F2D"}, {"file_name": "migrated_image.png", "id": "286926512302306", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974503_2971137249627887_2738815793285300224_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qOBZDTdMNwoQ7kNvwHfsa7N&_nc_oc=Adpmqc6Ds7BIom0XfeNwwM-pZw9N_3w0heSW7W4wO9OYPw83LtjWcbYLdGjGyaFlq2o&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNJJcwRMbjgyWuIIgeHJtjIFhld0qR1293PG8Ayw-z5w&oe=6AAD5822"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1a.png", "id": "796339428369487", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974474_796339431702820_5955742702304479792_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TFJEysezeF4Q7kNvwHipXmo&_nc_oc=AdoLGy2U2ELQ8LiXncHNYTn7uCD9Azbc_2OOJBvJI2M2C4hMsIRrUcdriaWqmG65ikk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9713vrZgz-0Tr4s8juJ3LazucPRV2H6WRAXWiYwlxvw&oe=6AAD3F6A"}, "display_name": "Pro Bowling Social", "keywords": ["bowling", "tenpin", "multiplayer", "sport", "sports"], "long_description": "Bowling is a fun sports game but you need go to a club since it requires a large space to play. With Pro Bowling Social you can play bowling in the comfort of your home. \nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them."}]}, "developer_name": "Moonstar Games", "developer_privacy_policy_url": "https://www.moonstargames.com/bowling_privacy.html", "developer_terms_of_service_url": "https://www.moonstargames.com/bowling_terms.html", "publisher_name": "Moonstar Games", "support_website_url": "http://www.moonstargames.com/", "website_url": "https://www.moonstargames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7978772488821844"}, "review_messages":
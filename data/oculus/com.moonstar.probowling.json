oc=Adper6QtGXPGT-JxhYYIGX1gQo88ZVR4upGiw5viRzu5GtHThyMvOGF_e7bCmp8PrmM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGAwRs5RMkAk9RwanTnlJPq6NX-b90FLTYfTo-4Gp6t7Q&oe=6A7202B1"}, {"file_name": "migrated_image.png", "id": "201811821110842", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982559_1211352452359901_1653211106404990976_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ao6R75A5kO0Q7kNvwGlRjWc&_nc_oc=Adp7H7O7Ohq-VBSoyZ3hS09deytkM7NIkEDYuv9khobETk2FEEqA1FSMgAr40Cw6gZw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOVLrftCo6Yxi6CmnF16NRYQa7ZW3aHJFovkC9Z-RRhA&oe=6A7204F4"}, {"file_name": "migrated_image.png", "id": "196159655021180", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974876_480368835864611_6173717808111681536_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YDuoJjJawEUQ7kNvwF0PlO1&_nc_oc=AdpGFAtVWWGtAFgspaqXAYZsHDNxPcZOAR3L7uiCkNk0iHKesL08ivnzYBONzxuZfDs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHEcIZq2pDvw_zzBSv3OmGk5tkKyUB742N5T6qwyIJImw&oe=6A71EBAD"}, {"file_name": "migrated_image.png", "id": "286926512302306", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974503_2971137249627887_2738815793285300224_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mcV0i0diwacQ7kNvwHn_Sk5&_nc_oc=AdoP3tHG_GMKYpTvZnV03MS14KA5cgWkVkRrA_vDcgrSotWjqAem0WPdrOydHMFGemo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGcj84-s-RAK3SdsBYjSGBGZdIu7tdTNybyhhuEn7DQDA&oe=6A7204A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1a.png", "id": "796339428369487", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974474_796339431702820_5955742702304479792_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uCkhfryGf7MQ7kNvwHNZhqz&_nc_oc=AdpWVqBNpvJcLk7unNXHwnXdWYbHSMrgtWtBeOdW_8tkdDVnqQrgplXdL_zN2PPX37M&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHTtdW0x5dAB7TnMqj9kTZM5erwPtGliM7UhY3jUJyXlg&oe=6A71EBEA"}, "display_name": "Pro Bowling Social", "keywords": ["bowling", "tenpin", "multiplayer", "sport", "sports"], "long_description": "Bowling is a fun sports game but you need go to a club since it requires a large space to play. With Pro Bowling Social you can play bowling in the comfort of your home. \nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them."}]}, "developer_name": "Moonstar Games", "developer_privacy_policy_url": "https://www.moonstargames.com/bowling_privacy.html", "developer_terms_of_service_url": "https://www.moonstargames.com/bowling_terms.html", "publisher_name": "Moonstar Games", "support_website_url": "http://www.moonstargames.com/", "website_url": "https://www.moonstargames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7978772488821844"}, "review_messages":
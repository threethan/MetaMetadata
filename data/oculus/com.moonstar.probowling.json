d": "201811821110842", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982559_1211352452359901_1653211106404990976_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IINx8yR_P-kQ7kNvwE0UUs7&_nc_oc=AdoXdyEZyZnA-gRsRuYx9eVfDADyBMXJ6_cYxxUSixSTsnkkxH3RyZzwpmmsjEgVF_w&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTejr_MnKmqX5NS_UMWvpb7_beIakbQ4nX5ToAnkiBqow&oe=6AFB20F4"}, {"file_name": "migrated_image.png", "id": "196159655021180", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974876_480368835864611_6173717808111681536_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Me03J6VYml8Q7kNvwEoKdtT&_nc_oc=Adra9fG5X1FV5rW8xt0o_koAQ_ZJDfw0UW888LlCwEQ8M6Lcj2RKdsQJaRbkqryRcp0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFgw_kuKks4nGYfHoAr5mQqt-84yVCalo9nWGd-u2jhA&oe=6AFB3FED"}, {"file_name": "migrated_image.png", "id": "286926512302306", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974503_2971137249627887_2738815793285300224_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YmgIady3GcAQ7kNvwGW6wtr&_nc_oc=AdplGiDdIo-vovF32B3PaOLO5hVjwolDRi8LrR-io5Qjf7HO_GaY6mQ-nLqVSNWUD0M&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROiRU5LBM9G4wfgNunK0Ax3HTVl34uIf8_xRXMi9BT0A&oe=6AFB20A2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pro Bowling Social", "keywords": ["bowling", "tenpin", "multiplayer", "sport", "sports"], "long_description": "Bowling is a fun sports game but you need go to a club since it requires a large space to play. With Pro Bowling Social you can play bowling in the comfort of your home. \nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them."}]}, "developer_name": "Moonstar Games", "developer_privacy_policy_url": "https://probowlingsocial.com/privacy.html", "developer_terms_of_service_url": "https://probowlingsocial.com/terms.html", "publisher_name": "Moonstar Games", "support_website_url": "http://www.moonstargames.com/", "website_url": "https://www.probowlingsocial.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "642673340491908"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2511964669080224"}]}, "baseline_offer": {"id": "2511964669080224"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1574359222, "status": "PUBLISHED", "id": "2511964669080224"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2767543009944844", "version": "1.0.0.6"}, "id": "608832152890836", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBina
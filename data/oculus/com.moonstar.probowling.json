oc=AdqXWu9b_A7jJnUFAcjNudgg8VU9lKZTQT8zfg3ShRqhVQxHfoLWTthoOIbXMtMqr5E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_GTCffHuiMU6ZP_ahVU_w530PN9cY1uYwcsQ_Mz5Fa8Q&oe=6A43DE31"}, {"file_name": "migrated_image.png", "id": "201811821110842", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982559_1211352452359901_1653211106404990976_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jJFKTjPn6jcQ7kNvwGhmUgL&_nc_oc=AdrBOiBTj1vRueHaWjMXHHOXNzeWJI4pPD2PskrrdORgljeit0Er0ZPLTo_uC64MhPU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-LWcMgXAB4RfEvhDEwh5abHb3hMohsZ67D_Hfdl25HZw&oe=6A43E074"}, {"file_name": "migrated_image.png", "id": "196159655021180", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974876_480368835864611_6173717808111681536_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ReabVEg_p0IQ7kNvwEn_7Lh&_nc_oc=Adq-c0Vd6jmgMmLmFF01Tu7LLEx851qYEAHmxuGa-E68HimgmpyLJLz89DbY2KssIRk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-MOjv7_w1aWkEmAS_V2sCGXzv0VVGKFE5aik9lVBJEsw&oe=6A43C72D"}, {"file_name": "migrated_image.png", "id": "286926512302306", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974503_2971137249627887_2738815793285300224_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SJpiqIWpCh4Q7kNvwEI-Y5S&_nc_oc=AdoQn-lqED7Z3HHCB66jdDbGjHNB4sYh2YrtQ1mKXXgGi5rJkKJp7RYXkhzf_anElwo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8HmNDEq3UdNuEhsCMwt_U64LobZpNY3mB-5lJ-KgoHCw&oe=6A43E022"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1a.png", "id": "796339428369487", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974474_796339431702820_5955742702304479792_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=joezO4nAjkYQ7kNvwFZ9EjA&_nc_oc=Adr0E4j9fV8FQqUA21eJLhqmUxxwZqtSkOhsaJ82ByByRIWv8nc40-zB2P2iAHPEh9E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_2YxOdgyCbgJpsBPtihtrB1jyx8Rb_W0YCLWufDlWsKw&oe=6A43C76A"}, "display_name": "Pro Bowling Social", "keywords": ["bowling", "tenpin", "multiplayer", "sport", "sports"], "long_description": "Bowling is a fun sports game but you need go to a club since it requires a large space to play. With Pro Bowling Social you can play bowling in the comfort of your home. \nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them."}]}, "developer_name": "Moonstar Games", "developer_privacy_policy_url": "https://www.moonstargames.com/bowling_privacy.html", "developer_terms_of_service_url": "https://www.moonstargames.com/bowling_terms.html", "publisher_name": "Moonstar Games", "support_website_url": "http://www.moonstargames.com/", "website_url": "https://www.moonstargames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7978772488821844"}, "review_messages":
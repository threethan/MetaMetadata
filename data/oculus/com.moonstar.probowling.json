oc=Adob8TlxD6c-5KRHgNPEg4m-sWkD-Wgdnw2-L09evwjfWR_H57hjfrUhpkg5sTB_ZDY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0nRb7hJWh7Fm9wkO0H-WiNY_wYLEqpVI_ZR48BvE4Nw&oe=6AE75831"}, {"file_name": "migrated_image.png", "id": "201811821110842", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982559_1211352452359901_1653211106404990976_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2JW9nWrXTfQQ7kNvwEYWl6Y&_nc_oc=AdpqdjWb1etjMtCp7ICjJ9dygzBN7FiDOegtxezML7hoy2sAjJwJDaaRXXziVSMPtu4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKP6QdYAeC8jDEz2xA0zvZHTZ7FtSXTOpxPX02M1kSCA&oe=6AE75A74"}, {"file_name": "migrated_image.png", "id": "196159655021180", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974876_480368835864611_6173717808111681536_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kntYLd9jsqAQ7kNvwGqiJJr&_nc_oc=Ado_nGTypeMmG1x3imD9njSJwYmw_ipnSMg9lj29asQA0wTgn-7Msj8Phi5RLlEkyvI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYROiNorSy_alQt9iNOUJ4BFW-GGiXCJ2vtuyQ2j5JKQ&oe=6AE7412D"}, {"file_name": "migrated_image.png", "id": "286926512302306", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974503_2971137249627887_2738815793285300224_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nnWyRrxa6BAQ7kNvwFVOJh3&_nc_oc=Adq104nmeV1gQK6Zm4ofPk4fsWWpKJeOnWGQp3leEvgHvlbmmE6RGATfSL-HoEZM39k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkugvs0FPvRy5oMQb_sXxz-61qBGkAnhKfPV9OuFr99g&oe=6AE75A22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1a.png", "id": "796339428369487", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974474_796339431702820_5955742702304479792_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lj761pmlQGQQ7kNvwElerVS&_nc_oc=AdqjNyFH57oq3UBHXgMguE4UTUNWWkiCbA06UUKkVqrNtGWp88qn6qXgPEPQxHCOgTs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGFPenf6CYj7FS6wb0Z092WhzrQcjA6r-sDWUnZKlWfw&oe=6AE7416A"}, "display_name": "Pro Bowling Social", "keywords": ["bowling", "tenpin", "multiplayer", "sport", "sports"], "long_description": "Bowling is a fun sports game but you need go to a club since it requires a large space to play. With Pro Bowling Social you can play bowling in the comfort of your home. \nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them."}]}, "developer_name": "Moonstar Games", "developer_privacy_policy_url": "https://www.moonstargames.com/bowling_privacy.html", "developer_terms_of_service_url": "https://www.moonstargames.com/bowling_terms.html", "publisher_name": "Moonstar Games", "support_website_url": "http://www.moonstargames.com/", "website_url": "https://www.moonstargames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7978772488821844"}, "review_messages":
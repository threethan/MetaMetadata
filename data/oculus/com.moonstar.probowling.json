oc=AdqWD0O1zN106GRekYqtNcaCyIqWxwzhc-C5sHoTblInjcBMHd3wjfrw7RJP_Om6l8s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLOMP7zAl71zJkU3bKuYS4tKjoJuHLqxeWDI0OncngMSg&oe=6AB7E231"}, {"file_name": "migrated_image.png", "id": "201811821110842", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982559_1211352452359901_1653211106404990976_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jkOjuK0SiO0Q7kNvwFXNfAC&_nc_oc=AdoWB3-CH5gw1nEzELtx-pnrS_ruRo2yEueSQ9QtPaKyr4KLqs4xhRbcH8WPtdQEsr4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJTsNjzoNJlyvI7i4i0wnEvhmbNulYm9Ie9RWVd27vImA&oe=6AB7E474"}, {"file_name": "migrated_image.png", "id": "196159655021180", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974876_480368835864611_6173717808111681536_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7I4TmmPnMFkQ7kNvwG7GFLf&_nc_oc=AdqDLQqY4Opv5ncyeq5tHA3nypdeNiCACCvJ3YL4zUVcfOo5HG3bwHQDufszt97d8ec&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHhUVuXhgz_7Y4qSbxVXZtyeSFzLMu-ZneTp9WTIW0bg&oe=6AB7CB2D"}, {"file_name": "migrated_image.png", "id": "286926512302306", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974503_2971137249627887_2738815793285300224_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0uAwnKNbL70Q7kNvwHf0KAm&_nc_oc=AdpcnKTO-6XtzVgiymK7zDWGhvEwEkwoMPQ4DPD3ZXVySuoycO7rj_oHsuferm3Lbko&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIAwwzdJrRHP-zhPF-kiTJT38JjRuIJLvm_WxPw4qQBNw&oe=6AB7E422"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1a.png", "id": "796339428369487", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974474_796339431702820_5955742702304479792_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yojtx2q4T50Q7kNvwE0R_Wk&_nc_oc=AdpvwC2x-nMO_EXhhzeyhl_d7RlJmqC-v_aefs5T-tUsYhiAUfayQP1jhrebWn5GPEI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0L7SNFEOWFoKi7mdDKZt94oPn7-dzj4kjt58t4HUrMA&oe=6AB7CB6A"}, "display_name": "Pro Bowling Social", "keywords": ["bowling", "tenpin", "multiplayer", "sport", "sports"], "long_description": "Bowling is a fun sports game but you need go to a club since it requires a large space to play. With Pro Bowling Social you can play bowling in the comfort of your home. \nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them."}]}, "developer_name": "Moonstar Games", "developer_privacy_policy_url": "https://www.moonstargames.com/bowling_privacy.html", "developer_terms_of_service_url": "https://www.moonstargames.com/bowling_terms.html", "publisher_name": "Moonstar Games", "support_website_url": "http://www.moonstargames.com/", "website_url": "https://www.moonstargames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7978772488821844"}, "review_messages":
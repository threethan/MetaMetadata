oc=AdpaPNGy7A-ACfB25ve-lNFfZicw_a47Nnp6yAcoX9ip4VkiliAHHxQXojcnkT_CMoc&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2hwP2FU2UliGLgHHPrRK3OZM3D4BPeAlUzKtpLk7rfng&oe=69E24F31"}, {"file_name": "migrated_image.png", "id": "201811821110842", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982559_1211352452359901_1653211106404990976_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HK2aWzkgHiUQ7kNvwF_p6hP&_nc_oc=AdpaFsUc3796KzPZFHGkR8wLYk-op8NScFc-zDXhfuL48eju0_Qub1XtXiCag0IUbj0&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2J6-FGC8m4ly1IgYo1BspV6mH1q098GkDhBfmLWGIlpA&oe=69E25174"}, {"file_name": "migrated_image.png", "id": "196159655021180", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974876_480368835864611_6173717808111681536_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h1pQieWl9q8Q7kNvwFgZgdt&_nc_oc=AdqBrXp2ODQ6fw9ENCHy8tHdiFO4lYw16v1wqorJ1luZKxjUQY1sVbfqK-TNg9yep38&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af13y26LLMv5rnjROrPRVWVeYL8eQJlmRcMe5AzDzEe4bw&oe=69E2382D"}, {"file_name": "migrated_image.png", "id": "286926512302306", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974503_2971137249627887_2738815793285300224_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e7oFLBn8qHYQ7kNvwHpVScG&_nc_oc=AdpRAjw3mjsxDT94ujEZLuQlOsjIgAe2q0ecN-wvZNASYHZt99VqBlvKxRYoJ_8ZG6c&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3JetMj_TrJ_FT3oYQv7mgtj0_YuyNYBwW4phEfB2iSHQ&oe=69E25122"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1a.png", "id": "796339428369487", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974474_796339431702820_5955742702304479792_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gwi8LWBuJKQQ7kNvwFKULAN&_nc_oc=AdoOvpkFEZDcEKkuProsV5gvppV0Pk8DAfEzV-gLawsJltY1tM8CaJBOE0hM66uhrlU&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3tbGyDUCplIb6oVwKsATsZS82J1E0bRErNqYowykJqWg&oe=69E2386A"}, "display_name": "Pro Bowling Social", "keywords": ["bowling", "tenpin", "multiplayer", "sport", "sports"], "long_description": "Bowling is a fun sports game but you need go to a club since it requires a large space to play. With Pro Bowling Social you can play bowling in the comfort of your home. \nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them."}]}, "developer_name": "Moonstar Games", "developer_privacy_policy_url": "https://www.moonstargames.com/bowling_privacy.html", "developer_terms_of_service_url": "https://www.moonstargames.com/bowling_terms.html", "publisher_name": "Moonstar Games", "support_website_url": "http://www.moonstargames.com/", "website_url": "https://www.moonstargames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7978772488821844"}, "review_messages":
culuscdn.com&oh=00_Af3b772JTMxaFbVtIFicbhvJCUe7iPRGZRnBXUwfBdVYUg&oe=69F0CFB1"}, {"file_name": "migrated_image.png", "id": "201811821110842", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982559_1211352452359901_1653211106404990976_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PAuf76C_VYAQ7kNvwGpRUkF&_nc_oc=AdrfMUXERzeSqR_1__JK7nxaPLP0-F6llghzFuiYVrTZ1B9fQG3ma7nJnJpVW34TaU0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0BGi1oaPUsNuq4hlXRikK5A9J8-toeE7O7JnfuS86p-A&oe=69F0D1F4"}, {"file_name": "migrated_image.png", "id": "196159655021180", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974876_480368835864611_6173717808111681536_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7lUxZkQy-9cQ7kNvwFS3rZg&_nc_oc=Adr7mGYN7ojvCLISXQjC9l7PdODtHQAF5MNj2FpQLPXVM5kmNi9jMcmQYEjHrCeKcZ4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af026FZxRURlfugZqOJBPafbhcgbTbMjhqs7BRsflz-1-Q&oe=69F0B8AD"}, {"file_name": "migrated_image.png", "id": "286926512302306", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974503_2971137249627887_2738815793285300224_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=50czTg4bRukQ7kNvwENMaZO&_nc_oc=Adr04AwXUAcHAji88VpohbQm0e95PERLArGPQAMuAyOUXi_6nYQdpbUYpYFskNGtIps&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3HXxseJ_Whtra5ngGbXce_koDSb8qn_xzEzcvVy3GfMg&oe=69F0D1A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1a.png", "id": "796339428369487", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974474_796339431702820_5955742702304479792_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nrS2NdRc334Q7kNvwEmD_Ms&_nc_oc=Adok8_L1769cqOXKUtKUskW5yixG0WIERtgja1Vj5xV92_10nH7uyHmEGqaINDCKTNw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af32P9b3Q622uZd9Ve0Nh4QLeO1PjyEbLfQdxFj9p3zZGQ&oe=69F0B8EA"}, "display_name": "Pro Bowling Social", "keywords": ["bowling", "tenpin", "multiplayer", "sport", "sports"], "long_description": "Bowling is a fun sports game but you need go to a club since it requires a large space to play. With Pro Bowling Social you can play bowling in the comfort of your home. \nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them."}]}, "developer_name": "Moonstar Games", "developer_privacy_policy_url": "https://www.moonstargames.com/bowling_privacy.html", "developer_terms_of_service_url": "https://www.moonstargames.com/bowling_terms.html", "publisher_name": "Moonstar Games", "support_website_url": "http://www.moonstargames.com/", "website_url": "https://www.moonstargames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7978772488821844"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031514_613734426919831_2718185183447709503_n.png?stp=dst-png_s360x360&_nc_ca
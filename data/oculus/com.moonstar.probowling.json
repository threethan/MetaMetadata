107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z4An8qBYRoUQ7kNvwGXUGnS&_nc_oc=Adp5jYfSiR11W4LBbYKtoAkg07JrYTmuhgXTykx5iV_eH9TStdZD8oRWmL9FxhtnhY8&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8apZ9Wcvvwyvj2fw5SQh1kedXqzpO5Ucb1yxvpLQgLEQ&oe=6A393B2D"}, {"file_name": "migrated_image.png", "id": "286926512302306", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974503_2971137249627887_2738815793285300224_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=boKzdlp1pUIQ7kNvwHNk9L6&_nc_oc=AdrF9iqJW-g_3wKc1EP5PThOfuoPRHEChg7s6cKGwP2HsQDnVyg_bwfHY2j2kmQtYbU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-pYlQc78npY4Z5arLlt1KZjz-W2mfB5hE2wsXIl-4oMQ&oe=6A395422"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pro Bowling Social", "keywords": ["bowling", "tenpin", "multiplayer", "sport", "sports"], "long_description": "Bowling is a fun sports game but you need go to a club since it requires a large space to play. With Pro Bowling Social you can play bowling in the comfort of your home. \nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them."}]}, "developer_name": "Moonstar Games", "developer_privacy_policy_url": "https://probowlingsocial.com/privacy.html", "developer_terms_of_service_url": "https://probowlingsocial.com/terms.html", "publisher_name": "Moonstar Games
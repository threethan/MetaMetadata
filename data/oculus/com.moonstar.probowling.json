culuscdn.com&oh=00_AfveB0M0C4_PLYS9vI_H_bDaJ7fp7YVjTu3TiCF9NeaDjQ&oe=69A2CEF1"}, {"file_name": "migrated_image.png", "id": "201811821110842", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982559_1211352452359901_1653211106404990976_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XcLuTprBSMYQ7kNvwHkLQ1l&_nc_oc=AdmnPLYtI2PpQMMnjBpD_13cAIhrekAqzdcpKH7M9NsEmVg8IjRXahOBaz8FZ2umK-c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aftvvbp8xKRS0iZ3q7WbDCWLZdpUeR0RKO6QlWVYHivY0w&oe=69A2D134"}, {"file_name": "migrated_image.png", "id": "196159655021180", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974876_480368835864611_6173717808111681536_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oM0bR3DUdxgQ7kNvwEwciND&_nc_oc=Adml5TgH6xPaHs-9zpFZvMfbGjMhte0VA8knhOAZWSbuIog-u_b_euxDVdhtVwU_eZA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftPDmuGC7yY5rAeTD5z8-nz6as_huNuCAaH-Mj04Z14FA&oe=69A2F02D"}, {"file_name": "migrated_image.png", "id": "286926512302306", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974503_2971137249627887_2738815793285300224_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qAb85SKSP5oQ7kNvwF3tbtl&_nc_oc=AdkNaZxpGHMkBH01eW8xFQeE5TdRcvj43wZ9LKCZgIZ8cZv3Prnkv0J3ezK1NCbRA9E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvYfyOc7AjxIkJ4hAE-OE9oF9K-6FlRWlMRDoiuJPAjrQ&oe=69A2D0E2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1a.png", "id": "796339428369487", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974474_796339431702820_5955742702304479792_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gqDCKht5qX4Q7kNvwFlTGXA&_nc_oc=AdmPCYIfwbfse9UrQQgY-7N_JlpCdfzZWy8jm0zSQNcbM1G1LgU-wOk1XpbTgS_rr1A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftdxC4hUiJrJwMig_b-wXq6rdpJZWDKsY64Sqh53tQgPQ&oe=69A2F06A"}, "display_name": "Pro Bowling Social", "keywords": ["bowling", "tenpin", "multiplayer", "sport", "sports"], "long_description": "Bowling is a fun sports game but you need go to a club since it requires a large space to play. With Pro Bowling Social you can play bowling in the comfort of your home. \nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them."}]}, "developer_name": "Moonstar Games", "developer_privacy_policy_url": "https://www.moonstargames.com/bowling_privacy.html", "developer_terms_of_service_url": "https://www.moonstargames.com/bowling_terms.html", "publisher_name": "Moonstar Games", "support_website_url": "http://www.moonstargames.com/", "website_url": "https://www.moonstargames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7978772488821844"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031514_613734426919831_2718185183447709503_n.png?stp=dst-png_s360x360&_nc_ca
7kNvwErQkRq&_nc_oc=AdpJLM7laylY4fd0c_8CMXOF2GOugqwe0gdwkcCb_sf4bI0W9jWLaBTGrj9akkE99dI&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGPGi7Ta_t-RYZVwUOXvHcdZAb5hySARax9UFuwgJmBUw&oe=6A8D79F1"}, {"file_name": "migrated_image.png", "id": "201811821110842", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982559_1211352452359901_1653211106404990976_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iuGEmZwHuYgQ7kNvwGEiriQ&_nc_oc=AdqvSImWliiRSJ8jDMJ4VIMTHYSRB0OSlqSUu7WWo7lqfcoyIL5pCVO15QObqTmcqco&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGGbg452s35pFZi2LJNTwKJnQwixtnUmXOYhO0-8jixeA&oe=6A8D7C34"}, {"file_name": "migrated_image.png", "id": "196159655021180", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974876_480368835864611_6173717808111681536_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0AOBDY7zLNQQ7kNvwHn4fLL&_nc_oc=AdqUZfGjWD4lkHg9foHJCNMrtDGxhjhru3b-ptDj5RW94lvE4VYsr0zxiaUoohj-Q2o&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEpog_RwfueIz3YOAs3hCS_YMYrx0II5zFwKDuLezCBgQ&oe=6A8D9B2D"}, {"file_name": "migrated_image.png", "id": "286926512302306", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974503_2971137249627887_2738815793285300224_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=697sS8MTzZ4Q7kNvwFjc1pi&_nc_oc=AdqjagcnA-VJzDXGtFds2heAxbjlP_c-ZzVTjIcRqJbcp5FXcF_oBmNY_F2CoxfpW3E&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHk6uRQseL6ZbEZhCxWxYBWfPLGBwmyt5qCbAWNhA7gPA&oe=6A8D7BE2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1a.png", "id": "796339428369487", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974474_796339431702820_5955742702304479792_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nNJdjNuE0voQ7kNvwF-vLSZ&_nc_oc=AdoPEd7oBTRAeQAz3gyTvDurpJp-Eq6kX7wrocSRfEExJLMvm4fMsx07RX6EZBKixsI&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFMsPbnUNdgv6zXlJ7OHYILXxk4jRfSANEL2kRtyNl8eg&oe=6A8D9B6A"}, "display_name": "Pro Bowling Social", "keywords": ["bowling", "tenpin", "multiplayer", "sport", "sports"], "long_description": "Bowling is a fun sports game but you need go to a club since it requires a large space to play. With Pro Bowling Social you can play bowling in the comfort of your home. \nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them."}]}, "developer_name": "Moonstar Games", "developer_privacy_policy_url": "https://www.moonstargames.com/bowling_privacy.html", "developer_terms_of_service_url": "https://www.moonstargames.com/bowling_terms.html", "publisher_name": "Moonstar Games", "support_website_url": "http://www.moonstargames.com/", "website_url": "https://www.moonstargames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7978772488821844
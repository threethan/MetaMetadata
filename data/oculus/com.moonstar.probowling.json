oc=AdqhZ2kUye_zdQ7wm1KsuEuSvWFywLAa_VV8EAzyg0xkqYrxAaVun0F0WDduXS70ddc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpzM2Ttlrot9MlZ-97Cg-ILxxI1l5PXTyEE0jR5zN6fw&oe=6A771071"}, {"file_name": "migrated_image.png", "id": "201811821110842", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982559_1211352452359901_1653211106404990976_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jp6yd_CpEnUQ7kNvwE7gLFw&_nc_oc=Adr1ZLZ6JduM9WJM-nR6xvQdwMEeLICunVK_B2v0p-KZxAKtVRGeZuXetN1K8nnvlfU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFamGFd1PDCQuBxdPwIiqRb7w2C6EPJyYflKCjqjHDFLw&oe=6A7712B4"}, {"file_name": "migrated_image.png", "id": "196159655021180", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974876_480368835864611_6173717808111681536_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CVHhC0PL4osQ7kNvwGWZVlV&_nc_oc=AdrW9Kt_5pLiU94vkfpjxR_lQf6cColT0k7z1Rv3yeKwCJ0buGSf0x6j1Yu0kba8M54&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGnbN0N5QdqzWPmN4xDaKKOH3l7sqcCGRSZJpGWcuT9aA&oe=6A7731AD"}, {"file_name": "migrated_image.png", "id": "286926512302306", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974503_2971137249627887_2738815793285300224_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eCg5_jeNiMQQ7kNvwGJMZ6A&_nc_oc=AdqTAtCVVwu65Jj0ZofdUnqNviRhpBACHZA5uX8J2A3coeB1-m8Ci9hnfh4pP1vxLik&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOBiU7_Swxua7FHSFR5wrP06E1Wx1ozg72kzo2tvsE8w&oe=6A771262"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1a.png", "id": "796339428369487", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974474_796339431702820_5955742702304479792_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qUKtQYLtp2kQ7kNvwEEWEfe&_nc_oc=AdoyGw8gIjQpq6HBnM38SRo4aN_2ecnABCaSXM-U20TD6i6pBNrC5pRiLqeOj4tYSSY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_0Q4AM-zaNVeX78kxiA86AbJ9kw3Pf8nYJRoCNpOh1g&oe=6A7731EA"}, "display_name": "Pro Bowling Social", "keywords": ["bowling", "tenpin", "multiplayer", "sport", "sports"], "long_description": "Bowling is a fun sports game but you need go to a club since it requires a large space to play. With Pro Bowling Social you can play bowling in the comfort of your home. \nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them."}]}, "developer_name": "Moonstar Games", "developer_privacy_policy_url": "https://www.moonstargames.com/bowling_privacy.html", "developer_terms_of_service_url": "https://www.moonstargames.com/bowling_terms.html", "publisher_name": "Moonstar Games", "support_website_url": "http://www.moonstargames.com/", "website_url": "https://www.moonstargames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7978772488821844"}, "review_messages":
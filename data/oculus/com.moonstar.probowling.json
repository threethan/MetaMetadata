oc=AdrlcwG5gfFA1Jvef1g_FeME7t3y-FjiTmgrmpaL0pGs884XgtuOGHTGS2bKfSitOvY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1lDPGZ5-V9ZbnixjnpR69KYh8qypPpW1vswXr85UcirA&oe=69E75CF1"}, {"file_name": "migrated_image.png", "id": "201811821110842", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982559_1211352452359901_1653211106404990976_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Gt4YfbqrEsQ7kNvwE6ief_&_nc_oc=Adqksmg24L90F0WaWpO5W0iS-zLREERr1j6NfezsKxqBfUT9oulTGvvNcRC0ErBbfLE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0PJL87hma6Q_6pA4KNA7-A1GHDOWhk2ZfvEdh-oRRxbQ&oe=69E75F34"}, {"file_name": "migrated_image.png", "id": "196159655021180", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974876_480368835864611_6173717808111681536_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QrMqeJ1m8YIQ7kNvwH7RBx3&_nc_oc=AdoGfMV6uiMu3Ofnnj3nYQyXWPmJTfLmXjzLlepfqRVAjWSEcRYFtkjAui_l9lWMz-E&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af34CL2z1ImrExpzNbtVg_EgVYGEA7lpl5URg_P90QWqtQ&oe=69E77E2D"}, {"file_name": "migrated_image.png", "id": "286926512302306", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974503_2971137249627887_2738815793285300224_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IGcHDs6mg-IQ7kNvwGmDWc7&_nc_oc=Adrpi9s7RaPe2jdJZSnZvOnijF___tFMO2vo4jY6Ksg6R8NUGC_vYoHg3QlS_yX4vl0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1QoZQbWsuFGpJIjkzh2eOayiAbxn8FXBF8V1k2gyW6LA&oe=69E75EE2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1a.png", "id": "796339428369487", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974474_796339431702820_5955742702304479792_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-wAgjxCE5BgQ7kNvwHvW17U&_nc_oc=AdoqXI3hBaSnCeaykx8_KvC4AQaxmfsqNRMLrFGCsgJiQ7Uwhp83uBKwH_l1QHu9hjA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af01JTW90amcv6Li9ZeM1cDDBi7-eib-WG0nFB5bz4DKxg&oe=69E77E6A"}, "display_name": "Pro Bowling Social", "keywords": ["bowling", "tenpin", "multiplayer", "sport", "sports"], "long_description": "Bowling is a fun sports game but you need go to a club since it requires a large space to play. With Pro Bowling Social you can play bowling in the comfort of your home. \nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them."}]}, "developer_name": "Moonstar Games", "developer_privacy_policy_url": "https://www.moonstargames.com/bowling_privacy.html", "developer_terms_of_service_url": "https://www.moonstargames.com/bowling_terms.html", "publisher_name": "Moonstar Games", "support_website_url": "http://www.moonstargames.com/", "website_url": "https://www.moonstargames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7978772488821844"}, "review_messages":
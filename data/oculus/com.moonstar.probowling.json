oc=AdqQOIca3HZx8ARSuxTn3kB8CNZCssek96XjNEE_hocFCbl4a5dneeeHkULRdVR6uac&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ZtlxXC4sic8802dhR8J_Quf-LDqI7-hsGwS2ybW_Ekg&oe=69E643B1"}, {"file_name": "migrated_image.png", "id": "201811821110842", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982559_1211352452359901_1653211106404990976_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Gt4YfbqrEsQ7kNvwFdoFfQ&_nc_oc=Adr4SvunREgjfG2eEFyC-Dz6ouUgAfT5aDO_5G_D1NE63TrkyLVDwGkO8HGgojv4T-s&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3oADhXKABr7cYfhRUoVQOZ0-p6ji9AOtkewmqXdKMz-Q&oe=69E645F4"}, {"file_name": "migrated_image.png", "id": "196159655021180", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974876_480368835864611_6173717808111681536_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8j0ABLG8qlEQ7kNvwF8XbTM&_nc_oc=AdqCCDh5kvZJ75Dq_OLDMcjBIX5ZcAjcwy7fnwn1pBfOpCLnrrkNY_TVaXqF2kpdhoE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2tcl1KrJE-w4KQ6ldv4HURj_hC0IRUz0HbbRdYPdbWzQ&oe=69E62CAD"}, {"file_name": "migrated_image.png", "id": "286926512302306", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974503_2971137249627887_2738815793285300224_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IGcHDs6mg-IQ7kNvwE9bBq8&_nc_oc=AdoN4AH4hUmTKhmbyV0BfUaZj8nt8lk-lTQhg6JbPdyRXL9x5aTugYAjQnEx368isG4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2T_P2fuGWdqF1jyDpZXtYyIWfS0pkhNe6fbJfBDqWUgg&oe=69E645A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1a.png", "id": "796339428369487", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974474_796339431702820_5955742702304479792_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mP00iE5u0sQQ7kNvwGQzT8t&_nc_oc=Adqz1lC_4Zd7c_PF3VswEaQq0a_V_dBJKcu2rapu1qAXPegqvMoTHHNZ0abAzaXZbe4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1qW653vyFZv6dRCW89Gz12IB5Po6jZ4vnHfQv69RNJCg&oe=69E62CEA"}, "display_name": "Pro Bowling Social", "keywords": ["bowling", "tenpin", "multiplayer", "sport", "sports"], "long_description": "Bowling is a fun sports game but you need go to a club since it requires a large space to play. With Pro Bowling Social you can play bowling in the comfort of your home. \nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them."}]}, "developer_name": "Moonstar Games", "developer_privacy_policy_url": "https://www.moonstargames.com/bowling_privacy.html", "developer_terms_of_service_url": "https://www.moonstargames.com/bowling_terms.html", "publisher_name": "Moonstar Games", "support_website_url": "http://www.moonstargames.com/", "website_url": "https://www.moonstargames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7978772488821844"}, "review_messages":
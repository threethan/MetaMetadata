oc=AdomAxDjHcyA-AP2sB8rkIupX722IqOzbrkngT8Q1uAknE4lFHn_pGDmg4fbV8MJZrA&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF5CU7XE2iJ6BulL-acVJ_gpoy9GuoDn_3XtXHoCtj_zA&oe=6A916E71"}, {"file_name": "migrated_image.png", "id": "201811821110842", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38982559_1211352452359901_1653211106404990976_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-lwTZWwlcfUQ7kNvwEE6IVT&_nc_oc=AdpFPCVIDxc0yFVtNm7ac4oc1jVsgR8SDEXXf2elgd3O7l8Dvr0yvhe5EyIrjs2p3oA&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQElanZ9NRDAFKzdPACjM7L0KnORGMVefdhO24PJ53b8eg&oe=6A9170B4"}, {"file_name": "migrated_image.png", "id": "196159655021180", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974876_480368835864611_6173717808111681536_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IMWc1Re6KrgQ7kNvwFR2UxA&_nc_oc=Adpo-DOoSF8h4Xbuf7-WcjauLd9EcTy9msrzbiuNrS3s4UBlox-KtoVRBgPpToURwBA&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYKmFrLOq_RNWuIVszTzKWqFAaFTZr98VPGnZ0roib6A&oe=6A918FAD"}, {"file_name": "migrated_image.png", "id": "286926512302306", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974503_2971137249627887_2738815793285300224_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0aMGj--TFRgQ7kNvwFsTjuy&_nc_oc=Adp1ZHaMCsYhjwDaOXRsaPWKCiJebj8tMO_nre2FLiFsCQ9_sUJJgwrlfGt_9QBoGG0&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4JqkM6LEkxiE3ANtf9JOAS_iERliLTjXs75kxHgJ2zw&oe=6A917062"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1a.png", "id": "796339428369487", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974474_796339431702820_5955742702304479792_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_VicPcWX3bYQ7kNvwG-eCQo&_nc_oc=AdrI_xEifgC-BKFhwXZAUuq8T711kfoADDwXv6b9bwq8rCAuWtXJYk_7bfncVXVoIz4&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG__2_MM6msKmfD_fHexpz-8x_ZG3yZ5A9sQHnB1EXlGw&oe=6A918FEA"}, "display_name": "Pro Bowling Social", "keywords": ["bowling", "tenpin", "multiplayer", "sport", "sports"], "long_description": "Bowling is a fun sports game but you need go to a club since it requires a large space to play. With Pro Bowling Social you can play bowling in the comfort of your home. \nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them."}]}, "developer_name": "Moonstar Games", "developer_privacy_policy_url": "https://www.moonstargames.com/bowling_privacy.html", "developer_terms_of_service_url": "https://www.moonstargames.com/bowling_terms.html", "publisher_name": "Moonstar Games", "support_website_url": "http://www.moonstargames.com/", "website_url": "https://www.moonstargames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7978772488821844"}, "review_messages":
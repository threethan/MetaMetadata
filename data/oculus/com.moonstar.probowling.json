oc=AdqV_92kL06Ke_hL1Qk5FhlC3-wW-hBtAHATdPDk8HFCG8PMRpxv-RiKDsxGM-fJMU8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0wC1IvyrvtL2F-PA_voz2duVHYJ4NzPt2jI-Ouyqz4yQ&oe=69DF73F1"}, {"file_name": "migrated_image.png", "id": "201811821110842", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982559_1211352452359901_1653211106404990976_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B2i_HLKrDh4Q7kNvwFjKMXr&_nc_oc=AdqIOeHGq1yU1O0Z7Ej_XQFRsQVYfYYuotjGItUD9xRjBAjzjBn8kOVHNmizBs_oPsw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1h3YaxENGQnjBKAmBDyX5ci2LxBm_JkaPXH6xFXdw1oA&oe=69DF7634"}, {"file_name": "migrated_image.png", "id": "196159655021180", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974876_480368835864611_6173717808111681536_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h1pQieWl9q8Q7kNvwFHPTNJ&_nc_oc=AdqCoJ9yG8OThvvNqcJAg-5qaYSF-d9rOG6u-AwShHG8XWq61blN1JptbkfOrh7H__s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2rHr2m3FeBl8kkMY0gZs6VxwgIOj84oD1vEiGqoZGQMg&oe=69DF952D"}, {"file_name": "migrated_image.png", "id": "286926512302306", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974503_2971137249627887_2738815793285300224_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SFKgP4G1kXQQ7kNvwHVvD8K&_nc_oc=AdpqkfzLB0amP8HQKO_wpxwT9e7j73xbS6h8f7eotr5lc9uOftGj1yR7P_Lh61wwjoM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1-BZv3qod7h6k3BzbI_qWwn9o9-FiB28MRkDJwBOasmg&oe=69DF75E2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1a.png", "id": "796339428369487", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974474_796339431702820_5955742702304479792_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gwi8LWBuJKQQ7kNvwGg-RDd&_nc_oc=Adq9od5l-jvormQlZZwwuxGTsSIX23gg7SuNQ3ckqV6xC8w8jFEvOheir6ZGvkOyVgM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af17QkY7TmttHj0c_eiH9LFTPefMlOBeypAAcD4xr0OUzQ&oe=69DF956A"}, "display_name": "Pro Bowling Social", "keywords": ["bowling", "tenpin", "multiplayer", "sport", "sports"], "long_description": "Bowling is a fun sports game but you need go to a club since it requires a large space to play. With Pro Bowling Social you can play bowling in the comfort of your home. \nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them."}]}, "developer_name": "Moonstar Games", "developer_privacy_policy_url": "https://www.moonstargames.com/bowling_privacy.html", "developer_terms_of_service_url": "https://www.moonstargames.com/bowling_terms.html", "publisher_name": "Moonstar Games", "support_website_url": "http://www.moonstargames.com/", "website_url": "https://www.moonstargames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7978772488821844"}, "review_messages":
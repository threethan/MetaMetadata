oc=AdrEFV690RaquZLzrUP_dAcPLy_qjAz-SUzrrBoeI5jXKqnpRqqEO3WczrpZk4QvLVk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1n856x5pl7RzCt6es5TDYVS8rHGWhnpZDoU8X13f0qRA&oe=69EF7E31"}, {"file_name": "migrated_image.png", "id": "201811821110842", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982559_1211352452359901_1653211106404990976_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PAuf76C_VYAQ7kNvwGvTrOk&_nc_oc=Adq5S0DA0CVJmyk-XgDiZr90p8XJyLRHNF-Shb9Lyzesr0BuFfGRfIwzgO3iJoXBO3A&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0hWLYPJ8jMbc1frRz0b7D2u8CWLnQOnpbHntmiG0KtNg&oe=69EF8074"}, {"file_name": "migrated_image.png", "id": "196159655021180", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974876_480368835864611_6173717808111681536_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7lUxZkQy-9cQ7kNvwHYpesT&_nc_oc=AdqVKXXcc8-moMQXkY21T_PptCm_NzNHS_ThF0YuCyOWArTSRa7yvfZkTxUQZabLnUA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2eKhZIsFmjCFq-oiF4V6jY8aQqzSoahGM4VTuysjkXsw&oe=69EF672D"}, {"file_name": "migrated_image.png", "id": "286926512302306", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974503_2971137249627887_2738815793285300224_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=50czTg4bRukQ7kNvwGB4WHx&_nc_oc=AdoVzs47kM67j0UGD1dXsEJmftw_GnGaFez35cnI1rB27p-55gGqZ62yzONTGnRiBIc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af28N9h4zmFXCLEFrG6DR15HCDgeEtDP8YR9Da_AvbGBZw&oe=69EF8022"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1a.png", "id": "796339428369487", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974474_796339431702820_5955742702304479792_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nrS2NdRc334Q7kNvwFD2JkJ&_nc_oc=AdrJpBV8S_Rcq5qzJA058FKrK3yO6E0AylY0wEtzRcAi5EohBH1rnNv7RprxgWMLJTM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Gv9YCh8zkA6s_ldG1lGvcGgbWHfFD3q4p1uZ8orNg5w&oe=69EF676A"}, "display_name": "Pro Bowling Social", "keywords": ["bowling", "tenpin", "multiplayer", "sport", "sports"], "long_description": "Bowling is a fun sports game but you need go to a club since it requires a large space to play. With Pro Bowling Social you can play bowling in the comfort of your home. \nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them."}]}, "developer_name": "Moonstar Games", "developer_privacy_policy_url": "https://www.moonstargames.com/bowling_privacy.html", "developer_terms_of_service_url": "https://www.moonstargames.com/bowling_terms.html", "publisher_name": "Moonstar Games", "support_website_url": "http://www.moonstargames.com/", "website_url": "https://www.moonstargames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7978772488821844"}, "review_messages":
MotGW7YuyU4yA3Af6hs_dWSH8aRYsMlxiP6a8k&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afxc5aQTqdY4Y5Jtgwy5N-xuFb5C7OhN-WS2H-TjFgmAoQ&oe=69BA89F1"}, {"file_name": "migrated_image.png", "id": "201811821110842", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982559_1211352452359901_1653211106404990976_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d1kyUqKbkGoQ7kNvwEj2pqW&_nc_oc=AdnKjzvkHuyHqrHYXFCYI40oBbd8dZ0MnTuexNGTGWUtn1bR3OpNmkS3FcHQzOf0H7M&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxbdTjC7YBxefnXfvW_S23TkHeWssUm0JJCwNK1FN61aQ&oe=69BA8C34"}, {"file_name": "migrated_image.png", "id": "196159655021180", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974876_480368835864611_6173717808111681536_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=euZ82xxPVRcQ7kNvwFEpsjk&_nc_oc=Adl8b-xoYcYLDRKmHxxnuU8lIz02YFrYM-r6Hv1AL7rqEdIXgwfoz-saxxUGha8y15M&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwkCdKOejYfHCvluIFR86mlRSOMGCFtgw7tG68ErPjZmA&oe=69BAAB2D"}, {"file_name": "migrated_image.png", "id": "286926512302306", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974503_2971137249627887_2738815793285300224_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MQ9w6E0bdxUQ7kNvwFX2YXW&_nc_oc=Adn07ZcI5-GUErTDkrMIcOSgHNXRV-Pv8vRxsQWFWJNeWyBkpGc_tVn5EuVwi_WygrY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxNycTjyvox8jtvvcdsRbnzeD2S1x_DsrZd1SiZfUndoA&oe=69BA8BE2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1a.png", "id": "796339428369487", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974474_796339431702820_5955742702304479792_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QPy4Mpm9fXUQ7kNvwFO-lhb&_nc_oc=AdkecTyyVb1Rwgs0CQk3HLHwakoyCq8OoXcRSFtwG4KfeA4mJ4weC24h8YnTnk-E96k&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfywJuKYuVExB9mg7JL7RmmY4Rsn2IvvcIgzY38uQCBbuQ&oe=69BAAB6A"}, "display_name": "Pro Bowling Social", "keywords": ["bowling", "tenpin", "multiplayer", "sport", "sports"], "long_description": "Bowling is a fun sports game but you need go to a club since it requires a large space to play. With Pro Bowling Social you can play bowling in the comfort of your home. \nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them."}]}, "developer_name": "Moonstar Games", "developer_privacy_policy_url": "https://www.moonstargames.com/bowling_privacy.html", "developer_terms_of_service_url": "https://www.moonstargames.com/bowling_terms.html", "publisher_name": "Moonstar Games", "support_website_url": "http://www.moonstargames.com/", "website_url": "https://www.moonstargames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7978772488821844"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scont
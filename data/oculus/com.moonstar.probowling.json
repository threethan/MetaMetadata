oc=AdqAa5r1vRdgSkJzbNMRwktj5AoEVrDJ-ByVDE2nHSak4TdYNTj_MX5IhBVx1gYFosU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9SY4tgEPo0HaIQl7H8XSqOZfi7d6gGH-3TziWEz7kkww&oe=6A2C2331"}, {"file_name": "migrated_image.png", "id": "201811821110842", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982559_1211352452359901_1653211106404990976_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LK1xPH72Y8QQ7kNvwHeV_qs&_nc_oc=Adqcb8neFDAVMrtCq0-dYzmx67CosSC5XGcrx9UfOc3Um2mRLGPhzjQ3hsDeLQ5jHfw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Kwu-DsDOjNqEGhvNZ902qxhoDPZpaoAKgEvJQdfCMaQ&oe=6A2C2574"}, {"file_name": "migrated_image.png", "id": "196159655021180", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974876_480368835864611_6173717808111681536_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AN0xcwHJ7lkQ7kNvwGIkgvy&_nc_oc=AdqqXeMv8gEmo5lK_gMsafyOaciYloeiZvvsYaCY_BvOb7niM3gYZIRNsydfk7FR9nQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_D6wF3AZ1QFm5WrMfaOP9neLOfpTNf3h3Vz3yTCFmlEQ&oe=6A2C0C2D"}, {"file_name": "migrated_image.png", "id": "286926512302306", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974503_2971137249627887_2738815793285300224_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BZ-hL-yvV3IQ7kNvwEDeNHE&_nc_oc=AdoLM0pbp8V3p2bwjR5f_HyekCc0KrUx-1rBrXciaY8k4Mdb4N3gQYBK8gKeudqy5VM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-KpcUq0a5mlAlmNpl4Lugf2khOrNlMmF_PGnyjnSLH8w&oe=6A2C2522"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1a.png", "id": "796339428369487", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974474_796339431702820_5955742702304479792_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C2ruS9Z_0CwQ7kNvwFxjX5T&_nc_oc=AdrqJeGP17r-ZqCpdttcK14lCplvOB14T2Pyj0ALhyd5JdDAewQknHaI8MLoJrIkPA4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Tnn9WDcUjDVdgC0k43yBAj5Wj3lsLZGKz51fpCfI-6g&oe=6A2C0C6A"}, "display_name": "Pro Bowling Social", "keywords": ["bowling", "tenpin", "multiplayer", "sport", "sports"], "long_description": "Bowling is a fun sports game but you need go to a club since it requires a large space to play. With Pro Bowling Social you can play bowling in the comfort of your home. \nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them."}]}, "developer_name": "Moonstar Games", "developer_privacy_policy_url": "https://www.moonstargames.com/bowling_privacy.html", "developer_terms_of_service_url": "https://www.moonstargames.com/bowling_terms.html", "publisher_name": "Moonstar Games", "support_website_url": "http://www.moonstargames.com/", "website_url": "https://www.moonstargames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7978772488821844"}, "review_messages":
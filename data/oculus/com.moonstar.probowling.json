oc=AdqnOXIgfFReJ0HyLXPhM7qOf_Io5VQEo7ZEFZCB4MzEYdzF_XDED71cG87BTfKZDG8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6vgqruzAIKuJGLLoB3He60TH-MJJ3lDJ-1HnpK8L6tow&oe=69FA0A31"}, {"file_name": "migrated_image.png", "id": "201811821110842", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982559_1211352452359901_1653211106404990976_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_tdjok5eQmwQ7kNvwG4lKzY&_nc_oc=AdroVk7go9Sinjy3vfkmzFlkWRC0J9X9qIsZCfo99s6aqapFZzoH7yne4afyijZGCVE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af65slBy0luzXF9-TNDyHXTHrz14Z0ZKNSy9kOYKZZvgCQ&oe=69FA0C74"}, {"file_name": "migrated_image.png", "id": "196159655021180", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974876_480368835864611_6173717808111681536_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ztGTgbflsRUQ7kNvwHjAHtx&_nc_oc=Adq-nvxo0mHDdksONhrGXOkszRbEKmGKB1kak_yZM8NMSflwLk9A8-Yqkwlx-KGH_6s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5YGSSFMEIV3COfhhwTItzOoB_E9e5_zNNuJZya7odg_w&oe=69F9F32D"}, {"file_name": "migrated_image.png", "id": "286926512302306", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974503_2971137249627887_2738815793285300224_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fqKL5InP6a4Q7kNvwE9Jsea&_nc_oc=AdrHEGgqIeeNnXA9tbqN7xgxpLJ0OiVySkEui2n8h-ZRir-JX_GIDm3BB3Xg0P-eLoo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6V_twkHP8bCAK2MT8SHA2to7j6koe0g2Djk2wGbKr56A&oe=69FA0C22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1a.png", "id": "796339428369487", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974474_796339431702820_5955742702304479792_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bzNjNw8WnysQ7kNvwFcsuoa&_nc_oc=AdocPahqEFElWxjeDKukNzBab1QIZu2LwUc6h2NQOcBEcFxXRwG6cx1VJnNW2STpnYw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Smk_sMaVoZ2kHY0ScCFkycSKnBosDtJMlHouKSYQ58A&oe=69F9F36A"}, "display_name": "Pro Bowling Social", "keywords": ["bowling", "tenpin", "multiplayer", "sport", "sports"], "long_description": "Bowling is a fun sports game but you need go to a club since it requires a large space to play. With Pro Bowling Social you can play bowling in the comfort of your home. \nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them."}]}, "developer_name": "Moonstar Games", "developer_privacy_policy_url": "https://www.moonstargames.com/bowling_privacy.html", "developer_terms_of_service_url": "https://www.moonstargames.com/bowling_terms.html", "publisher_name": "Moonstar Games", "support_website_url": "http://www.moonstargames.com/", "website_url": "https://www.moonstargames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7978772488821844"}, "review_messages":
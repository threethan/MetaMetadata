r&_nc_oc=AdpBlF8uVU8newd_2pVoAGO6NV2ddAkUyhHS3VVDZamhLU-WRA1bMde2dS8iSNH6zCk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLhocN_jqMtUNXqlj1oGfN8lvf1sPUs-GnDqtv4fYmdpw&oe=6AAEA7B1"}, {"file_name": "migrated_image.png", "id": "201811821110842", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982559_1211352452359901_1653211106404990976_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wgttsfcmArUQ7kNvwE-CION&_nc_oc=AdoLKWmYTowjz8UUB8Sn8Hf7LmMqCuoftlMJ6Tk4amv2Fgw7cnTV8_kgal5iKIHS6X4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUhb8KkXSKH3tmz_j5Wv-vyLH1aI1yRdZ9v0M85s3u6g&oe=6AAEA9F4"}, {"file_name": "migrated_image.png", "id": "196159655021180", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974876_480368835864611_6173717808111681536_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sHuoDHEnrb0Q7kNvwGquhv8&_nc_oc=AdpMhNpKyfZVA9Z3N2u7-WG2v2ktsPUX8hl6pwFUDgLjsG80m9LbZRFcBkkBL8OABQc&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJsRXJ_-lsOqXNLohTKNPVI-dyMVZP2ntuvMas9WsjNuQ&oe=6AAE90AD"}, {"file_name": "migrated_image.png", "id": "286926512302306", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974503_2971137249627887_2738815793285300224_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qOBZDTdMNwoQ7kNvwGbUBZw&_nc_oc=AdrDBfx3uOsaYZB-bjwPxNrhhcHnZi0y8z4w2lC51dUZyFc3g0wNqpUYCMy_4vJu3D4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-80ZQWZcbpRI8LqDgglmW13ftfMmaF-OWDeRmbPHTQw&oe=6AAEA9A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1a.png", "id": "796339428369487", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974474_796339431702820_5955742702304479792_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TFJEysezeF4Q7kNvwHdVSTG&_nc_oc=Adq9IwJ17brt9UuhH6ghlxyrO4mwCYHKO2okco6xSJAi3gIMmFDWXDuC-rONYwFFV_Q&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJW0DwAUFqOO43yVlaBXvT-bt6HPpKEIeiywF1D81cQ8g&oe=6AAE90EA"}, "display_name": "Pro Bowling Social", "keywords": ["bowling", "tenpin", "multiplayer", "sport", "sports"], "long_description": "Bowling is a fun sports game but you need go to a club since it requires a large space to play. With Pro Bowling Social you can play bowling in the comfort of your home. \nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them."}]}, "developer_name": "Moonstar Games", "developer_privacy_policy_url": "https://www.moonstargames.com/bowling_privacy.html", "developer_terms_of_service_url": "https://www.moonstargames.com/bowling_terms.html", "publisher_name": "Moonstar Games", "support_website_url": "http://www.moonstargames.com/", "website_url": "https://www.moonstargames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7978772488821844"}, "review_me
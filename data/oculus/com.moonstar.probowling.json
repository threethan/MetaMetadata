culuscdn.com&oh=00_AftCj8m8mfTPqLG8aR43lo71f2j4wBXgJFXO8Vcu9hGoBQ&oe=69999471"}, {"file_name": "migrated_image.png", "id": "201811821110842", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982559_1211352452359901_1653211106404990976_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0TXChWCUG1AQ7kNvwEK8wco&_nc_oc=AdkHlMClDlp6YNgNyK80_fEK-u22MFEXO2thlBmgtE9wivfdIoOSmRCKq5gTahypixM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afva9m2yOFULUQFJiFj3SY2iSCwqb94HOF141y9difUc4w&oe=699996B4"}, {"file_name": "migrated_image.png", "id": "196159655021180", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974876_480368835864611_6173717808111681536_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MGeAvCquNRgQ7kNvwEsvQcC&_nc_oc=AdmvVUycx2GrvKNUs4IxByN9q1bH_MsSdKsSmaZbO0G4s--feuwWXYz4gIFbuK53w0Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft3Lpg7uwrALyjMuaxLtphaMwPW662g54n5JYLY6PbULA&oe=6999B5AD"}, {"file_name": "migrated_image.png", "id": "286926512302306", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974503_2971137249627887_2738815793285300224_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4AOiQvOYfsoQ7kNvwETR4ME&_nc_oc=Adka5o3QzYavdxzkBhv9F3WpPjXTQvQMB7SxAkgbSlGTpBWpCQElsA-K9PPSDOBCXUY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfusWZrLKaDgTdfVimqCXlZ6hWgLLjYc76Z6QroriWwi9Q&oe=69999662"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1a.png", "id": "796339428369487", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974474_796339431702820_5955742702304479792_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3s1YTZBue7EQ7kNvwEW3PEh&_nc_oc=Adnct463ceOl56cnWPeYRdw1elLmn_EgsT3Ra7lLLHBPmhVmKJPx_92-53TYthicDWQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuJgKnMtvxOksCOINGw3Q94EV9IQzXLRcJX3chwO9Ca9A&oe=6999B5EA"}, "display_name": "Pro Bowling Social", "keywords": ["bowling", "tenpin", "multiplayer", "sport", "sports"], "long_description": "Bowling is a fun sports game but you need go to a club since it requires a large space to play. With Pro Bowling Social you can play bowling in the comfort of your home. \nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them."}]}, "developer_name": "Moonstar Games", "developer_privacy_policy_url": "https://www.moonstargames.com/bowling_privacy.html", "developer_terms_of_service_url": "https://www.moonstargames.com/bowling_terms.html", "publisher_name": "Moonstar Games", "support_website_url": "http://www.moonstargames.com/", "website_url": "https://www.moonstargames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7978772488821844"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031514_613734426919831_2718185183447709503_n.png?stp=dst-png_s360x360&_nc_ca
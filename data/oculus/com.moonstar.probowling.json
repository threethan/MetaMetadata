V&_nc_oc=AdqOPJ73nP-5SbCWaRGzcLuGWUpOmKpqsc6DDFNZ-SE7fgpJfAN0kpEiKZKpQcpZThA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQId6x4xdJfk8kwYBJk_vAfIhreCft-IA2DwRGSCvW8GDQ&oe=6AA961B1"}, {"file_name": "migrated_image.png", "id": "201811821110842", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982559_1211352452359901_1653211106404990976_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DvhjFPshjS4Q7kNvwHnIxnH&_nc_oc=AdozxZX3PiCtDhROyIS3lMMsh25TbtFJR04zwxw3JUh3J_2wPbLgpzz8z2L923v_Hhs&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKkmPRYzapLGsVadssZLLLjsz9aoCVsDAu2esor7L7FRw&oe=6AA963F4"}, {"file_name": "migrated_image.png", "id": "196159655021180", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974876_480368835864611_6173717808111681536_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DptL-RT4mY0Q7kNvwFkAI8m&_nc_oc=Adof-PIOjxgHnNFxvKj7wYgyS7jNRMg1EMASNxJbh8vKV7WG7ziJwbIwk9diiTF3uhY&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvKcRPPSdl29VCbS85hqcuAfyNTBSbuRoPi0xtpa2awA&oe=6AA94AAD"}, {"file_name": "migrated_image.png", "id": "286926512302306", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974503_2971137249627887_2738815793285300224_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z0NHP1OmD0kQ7kNvwFX6dCL&_nc_oc=Adrp_gYGJrcMc6M2Z6-gTMIGa-ThDQ0vKC6kcT-r_nTwRdGwvQq3uGvEwh9VbhMhnvU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJesoD_0MFZ2AtmkbI_Bq8guNoJFVCw4cyFo0yFsEBMlQ&oe=6AA963A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1a.png", "id": "796339428369487", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974474_796339431702820_5955742702304479792_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vC8U7zGaiHwQ7kNvwES3dHD&_nc_oc=AdqcUpA_q4H53xs5sRiE5N2ZXHE1FOwUYgJ384qQwfrRCgv_pSD_b6AGWNXVbst7uIM&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpNbJCr1d0BGXk-H4yUdZYU2Kqqxiq_126mkQBU9DofA&oe=6AA94AEA"}, "display_name": "Pro Bowling Social", "keywords": ["bowling", "tenpin", "multiplayer", "sport", "sports"], "long_description": "Bowling is a fun sports game but you need go to a club since it requires a large space to play. With Pro Bowling Social you can play bowling in the comfort of your home. \nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them."}]}, "developer_name": "Moonstar Games", "developer_privacy_policy_url": "https://www.moonstargames.com/bowling_privacy.html", "developer_terms_of_service_url": "https://www.moonstargames.com/bowling_terms.html", "publisher_name": "Moonstar Games", "support_website_url": "http://www.moonstargames.com/", "website_url": "https://www.moonstargames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7978772488821844"}, "review_me
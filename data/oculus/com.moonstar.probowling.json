oc=Ado--7U_Azf0bK_wnK7aO7Jg37AgPUF-9WnFkrarm-IgbeCoILKZoo2pAikJQsOQNzc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8DGcS0OuGpOlcfznGqF_iXk3evfox6gh1bQvpLqQdxg&oe=6A8AD6F1"}, {"file_name": "migrated_image.png", "id": "201811821110842", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982559_1211352452359901_1653211106404990976_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gf-MwvTTLLoQ7kNvwF1YDMM&_nc_oc=AdrMFI7RAmbOPDha5uhWVJYBFJZkHrhwYcpv4Qh0jl69XOjYcSWbx1YvQv6FOdjthnM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGufv3sO5hbMFL52ELr7ei-u3tRQQ7zOOBKgr-Q2dlSPw&oe=6A8AD934"}, {"file_name": "migrated_image.png", "id": "196159655021180", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974876_480368835864611_6173717808111681536_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ofj-0wLzHooQ7kNvwFqNlTy&_nc_oc=AdrPDt1m8CJDTBCA2B-tCQeyzMr-HEg5jLnjLbgm5u15uPrH3fUZ-LInykXA3M-BPPM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJxoi_Xrxef0uQiuoI-V-MQcUQAwcm3PMg_Y8W_EAH7g&oe=6A8ABFED"}, {"file_name": "migrated_image.png", "id": "286926512302306", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974503_2971137249627887_2738815793285300224_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O_ZFJXXZ5eEQ7kNvwEgm3L0&_nc_oc=Adp12czbjrYyN_1_1PTPnNxyY7_UJ7bwUcDngQiTuXdkRBUjQFkOAw2USB2OZM9Pmng&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHEBATHY0si8SHA-X1ulWsgB724eX3D0HixuJ7TPfBOhg&oe=6A8AD8E2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1a.png", "id": "796339428369487", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974474_796339431702820_5955742702304479792_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9n4_6fsTjOUQ7kNvwEZ7bBu&_nc_oc=AdrU7ObNOTyAMH8_qRtikvL-jSyAxS2gvS1zmujKjSWssoV_sL4bvn6IQ3CCTogdreU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFK6h0nV1DtwDkEvAaUJbiMrWbZ37NYuuIVRH_8vTnLsg&oe=6A8AC02A"}, "display_name": "Pro Bowling Social", "keywords": ["bowling", "tenpin", "multiplayer", "sport", "sports"], "long_description": "Bowling is a fun sports game but you need go to a club since it requires a large space to play. With Pro Bowling Social you can play bowling in the comfort of your home. \nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them."}]}, "developer_name": "Moonstar Games", "developer_privacy_policy_url": "https://www.moonstargames.com/bowling_privacy.html", "developer_terms_of_service_url": "https://www.moonstargames.com/bowling_terms.html", "publisher_name": "Moonstar Games", "support_website_url": "http://www.moonstargames.com/", "website_url": "https://www.moonstargames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7978772488821844"}, "review_messages":
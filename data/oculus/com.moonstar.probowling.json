eFPjgBO_sT7yax6TjN-11dXDtRARzPO8j2K9tQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx0kCi3SC3FvnRSqszm2_T8hDpDfOdlpjMrFb75QLBi2A&oe=69C12171"}, {"file_name": "migrated_image.png", "id": "201811821110842", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982559_1211352452359901_1653211106404990976_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rRDgWHoioHQQ7kNvwEOhy6j&_nc_oc=AdrL_9mDm2pn7oHDv3bocTVWnKJ4Nqpwls5KwiT7FEPjce4fXphmwIsecHbUPYp7ovg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxT6kMIMZNlOT1zo2AuRjGETUsiHrDXx-o_BkVyizZg8g&oe=69C123B4"}, {"file_name": "migrated_image.png", "id": "196159655021180", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974876_480368835864611_6173717808111681536_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4bxVOVcdiBQQ7kNvwEIPvxZ&_nc_oc=AdrK4whHlZyJDpcs52wKk7yKii8M5H-FxCV9WnUKhgzK3dpY8T0gS0eMW1dYZi8uQBc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afyv6qdLcP2aoQJEG1MzCY_ALDTGgwNMSzEYM_PoOFPnsA&oe=69C142AD"}, {"file_name": "migrated_image.png", "id": "286926512302306", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974503_2971137249627887_2738815793285300224_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tcbr_LlGWHcQ7kNvwEEU2Nq&_nc_oc=AdqGlUeZ-RU9U5tMl7MTSkbw7TZFIC7IPJrXY6kjr_YuF5Ws1MWeljCBhfrO42-eNMw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfySqaiAw-2RLGsRGmZQSoeFC0fFmS0HOJATgSEX5D0wPg&oe=69C12362"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1a.png", "id": "796339428369487", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974474_796339431702820_5955742702304479792_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i-2flMfRlXIQ7kNvwHtv8lW&_nc_oc=AdrDcvqRjcATCgK_eQ3o6N45F1JtopRAto4HmHg5uP0DExcCqo0i6wrNBKtCxpwbSz0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxecL6VrflJgXBl74KcSTR2LzxqCoY4gWtQNfFkCHi8Zg&oe=69C142EA"}, "display_name": "Pro Bowling Social", "keywords": ["bowling", "tenpin", "multiplayer", "sport", "sports"], "long_description": "Bowling is a fun sports game but you need go to a club since it requires a large space to play. With Pro Bowling Social you can play bowling in the comfort of your home. \nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them."}]}, "developer_name": "Moonstar Games", "developer_privacy_policy_url": "https://www.moonstargames.com/bowling_privacy.html", "developer_terms_of_service_url": "https://www.moonstargames.com/bowling_terms.html", "publisher_name": "Moonstar Games", "support_website_url": "http://www.moonstargames.com/", "website_url": "https://www.moonstargames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7978772488821844"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scont
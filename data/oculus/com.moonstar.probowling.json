u&_nc_oc=AdrJ0ZnrVD1z6VnVMRiNY-bBGqzHU02miBCy--nSjHrpl4jSo9WJvBBmpT89lnWc6pU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af94WJPOV48bXvWy_CU6v42LkqqxFVctwx8kqMYEvpZPbQ&oe=6A22E8B1"}, {"file_name": "migrated_image.png", "id": "201811821110842", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982559_1211352452359901_1653211106404990976_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hrBR1qkweIMQ7kNvwE72dgl&_nc_oc=AdpqYjnl_8kr_o6vc9Luk0TuwUcSDSclKfYCH3OAqLrcdIOsEI8DanHKTgJufRBbFrw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_1-jonkWn5T4uczSL1VvRncN2Pkt6OIoW0aFX7qQGLOw&oe=6A22EAF4"}, {"file_name": "migrated_image.png", "id": "196159655021180", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974876_480368835864611_6173717808111681536_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jSww6uOUXsoQ7kNvwF8lFL3&_nc_oc=AdpCyUmLlCxezjNrsXuz4_XJ3cp8i8tf069xzSUGA-bK27RO56k0oCzhWUdMafHeVDA&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3ERyxm6c0TuWhagJl8HElUWGFoZbVoAw1_YnmZO_M7Q&oe=6A22D1AD"}, {"file_name": "migrated_image.png", "id": "286926512302306", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974503_2971137249627887_2738815793285300224_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sxRHyjrIpBcQ7kNvwHBiiTl&_nc_oc=AdqGkT4wPdCOdq3D0LbDBmhrbDE3DRMvz0vcx0QMHdvsum1LZ34lYahiLb-3Qu-mWIA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_KdLuSktcCVqCHV_j97HY6JWiJAjnOCuOsS7v6g24M4w&oe=6A22EAA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1a.png", "id": "796339428369487", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974474_796339431702820_5955742702304479792_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ksi-_To7VhoQ7kNvwF2G4QB&_nc_oc=AdqrsCnCT0w_m0p73QiadqmByshsi4GCTLwv-P11F9P9whfTIp4Os3ydHX_At24fGGA&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9DTo2TpgdfyAx2ffarHsffzlLdSUZq9IY9jJ4cX8bSQA&oe=6A22D1EA"}, "display_name": "Pro Bowling Social", "keywords": ["bowling", "tenpin", "multiplayer", "sport", "sports"], "long_description": "Bowling is a fun sports game but you need go to a club since it requires a large space to play. With Pro Bowling Social you can play bowling in the comfort of your home. \nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them."}]}, "developer_name": "Moonstar Games", "developer_privacy_policy_url": "https://www.moonstargames.com/bowling_privacy.html", "developer_terms_of_service_url": "https://www.moonstargames.com/bowling_terms.html", "publisher_name": "Moonstar Games", "support_website_url": "http://www.moonstargames.com/", "website_url": "https://www.moonstargames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7978772488821844"}, "review_me
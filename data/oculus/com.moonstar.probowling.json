oc=AdoDNnh26jRe0LDgJhC1avDnp3kaxzqzrJm4-0yMLHkVt82J7paebkGLsMGA52AgBE8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6bibyyQ56vApxZu4z3WtxMw2K17GcF5OzrZKlb8oDXIw&oe=69FDFEB1"}, {"file_name": "migrated_image.png", "id": "201811821110842", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982559_1211352452359901_1653211106404990976_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F5S7xSActgAQ7kNvwETyko6&_nc_oc=Ado5HzhTx_-0s3sOIn-9wKoTTRQLJxse_oJuQFp_IogBENz_REpERkfummdw-PkA13c&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4YDvispx6OdZxgmizGbRpWy4QUrAxjearHKmVkZ5sU2Q&oe=69FE00F4"}, {"file_name": "migrated_image.png", "id": "196159655021180", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974876_480368835864611_6173717808111681536_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X-mjt8wHDlwQ7kNvwExGQct&_nc_oc=Adp64y_z0bhI_wm25nlHvqL4fCJdTwOiNDbbWDlsJ3gJ1kAxz-Su-JcqtE56vZOC4ag&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ZmLzrqvNTiilmIT8YgE-ASI4Lkzed9fzrWC7bA7wIUg&oe=69FDE7AD"}, {"file_name": "migrated_image.png", "id": "286926512302306", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974503_2971137249627887_2738815793285300224_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0WFrJ8P56DgQ7kNvwHfkjDU&_nc_oc=AdqPpvfjLgzGiJkuR747A7cfr6-AErK_OoResJmHy1QJjt_3-bLhutBcAopTRfM_DrQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4A9FMLclGhl_oyrlXI4moLt73At_m2QIqBbWP_m8jEFQ&oe=69FE00A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1a.png", "id": "796339428369487", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974474_796339431702820_5955742702304479792_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xIY-Uc8cbH8Q7kNvwFvhaCY&_nc_oc=Adq9NWqSBPT4ScNc0WMfzmnVwV4JptfVqNWCptydnV7akZjI53MbmhCVdNlGYC_hR_8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4MryxISc0dKKaGUPsf_BDlKkKYsEW0C74s021fMPpeOA&oe=69FDE7EA"}, "display_name": "Pro Bowling Social", "keywords": ["bowling", "tenpin", "multiplayer", "sport", "sports"], "long_description": "Bowling is a fun sports game but you need go to a club since it requires a large space to play. With Pro Bowling Social you can play bowling in the comfort of your home. \nThe goal of ten-pin bowling is is to knock over all ten pins at the end of a lane, with two balls per frame allowed to knock down all pins. A strike is achieved when all the pins are knocked down on the first roll, and a spare is achieved if all the pins are knocked over on a second roll.\nStrike is 30 points regardless of ensuing rolls' results. Spare is 10 points, plus pinfall on first roll of the current frame. Game lasts for 10 frames and maximum score a player can get is 300 with 10 strikes. This scoring system is called World Bowling Scoring.", "short_description": "Pro Bowling Social is a multiplayer, ten-pin bowling game. You can compete with players around the world and voice chat with them."}]}, "developer_name": "Moonstar Games", "developer_privacy_policy_url": "https://www.moonstargames.com/bowling_privacy.html", "developer_terms_of_service_url": "https://www.moonstargames.com/bowling_terms.html", "publisher_name": "Moonstar Games", "support_website_url": "http://www.moonstargames.com/", "website_url": "https://www.moonstargames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7978772488821844"}, "review_messages":
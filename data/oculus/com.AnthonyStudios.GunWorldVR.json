.oculuscdn.com/v/t64.5771-25/473400239_1310683786896985_5583443670629390498_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w9aHeniBvq8Q7kNvwGNHCyA&_nc_oc=AdmOSkESD48CyqQkZ3eSx1Z6weJxeHpXiaxAv5K7AuWryLps9d3QabOMJ0c-SD4i2iU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzOiKNNWnni05FxD2AqLBiGxXFAiZGnuXkk6dKAgjbikg&oe=69AC36AD"}, "display_name": "Gun World VR", "keywords": [], "long_description": "# Play the most immersive sandbox multiplayer shooter in Gun World VR\n- Become Elite - 'Gun World VR has over 600 guns and attachments'\n- Sandbox Experience - 'Spawn unlimited weapons and build endless loadouts'\n- Multiplayer Physics- 'Experience Physics in multiplayer mode with friends'\n \nGun World VR is multiplayer sandbox shooter with realistic physics and over 400 guns and attachments. Become the best tactical soldier and assault positions with your friends. Build anything in sandbox mode.\n\n \n\n# \n# Features\n# PvE Missions: Solo or Online Multiplayer Co-Op with Up to 8 Players \n{1698171884084267}\n# PvP Mode: Competitive Modes and Maps\n{576661228143983}\n# Tactical Teamwork: Trust your teamates and friends\n{475675245514985}\n# Procedural Compound Raid: Play different maps everytime\n{877926837430604}\n# Breach and Clear: Assault positions with your pals\n{533088592860767}\n# Tactics applied: Strategize your assault path\n{1604474137162060}\n# Breach and Clear: Flush enemies out\n{1206195163783608}\n# Sandbox mode: Experience physics and building loadouts\n{593476859695271}", "short_description": "Play the most immersive sandbox multiplayer shooter in Gun World VR\n\n- Become Elite - 'Gun World VR has over 600 guns and attachments'\n- Sandbox Experience - 'Spawn unlimited weapons and build endless loadouts'\n- Multiplayer Physics- 'Experience Physics in multiplayer mode with friends'\n\nGun World VR is multiplayer sandbox shooter with realistic physics and over 400 guns and attachments. Become the best tactical soldier and assault positions with your friends. Build anything in sandbox mode."}]}, "developer_name": "Alto Interactive", "developer_privacy_policy_url": "https://github.com/superdude12399/PrivacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Alto Interactive", "support_website_url": null, "website_url": "https://www.altointeractive.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "24898958386431947"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304115_773975288452145_9422885841949123_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dm4rAbwtU20Q7kNvwF-YuLG&_nc_oc=AdlyHFl8PVKUr1rZKizUP6YlMbOoOCVAeh5ypDX4dUVhliIevmDB46Tai4MTsMEym1Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwCy12FJeQHC7TZpQ0brngQ29nBtyW3q-VhwjFa0axl0w&oe=69AC323D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Gun World VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Sandbox", "id": "1990104051447093"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Hangout", "id": "10237
yxVR", "keywords": [], "long_description": "Stryx VR is an exhibition space and virtual art gallery based on the Stryx gallery in Birmingham, UK. The virtual space is a recreation of the actual physical space, complete with changing exhibitions. In Stryx VR you can see artworks and explore the Stryx Shop in an interactive virtual world. \n\nFor more information on the project visit:\nwww.stryxVR.co.uk\n\nForm more information on the artists visit:\nwww.stryx.co.uk\n\nTo purchase items from the Stryx Shop visit:\nwww.stryxshop.co.uk", "short_description": "Stryx VR is an exhibition space and virtual art gallery based on the Stryx gallery in Birmingham, UK."}]}, "developer_name": null, "developer_privacy_policy_url": "http://psiconlab.co.uk/index.php?page=privacy", "developer_terms_of_service_url": null, "publisher_name": "Psicon Lab", "support_website_url": null, "website_url": "http://www.psiconlab.co.uk/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "661189792561536"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "715652563703196"}]}, "baseline_offer": {"id": "715652563703196"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1690918149, "status": "PUBLISHED", "id": "715652563703196"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_te
3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af638qvPvktbhOc6TAnx9X4Z2cgufXb1Xgd1Ybk0BofxGg&oe=6A19A7EE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TechniCapture", "keywords": ["techni"], "long_description": "\u25a0 Do you have any of the following problems in the field of work training?\n\u30fbIt takes too much time to train new employees.\n\u30fbIt takes too much time to train new workers.\n\u30fbIt is difficult to get new workers to take root in the workplace even after pointing out areas for improvement.\n\nYou are probably always seeking \u201cefficient training methods\u201d to facilitate on-site work.\nHowever, with conventional methods, it is difficult to find specific areas for improvement and instruction is time-consuming.\nTechniCapture is a tool that was created to solve these problems.\n\n\u25a0 Three points that TechniCapture solves\n(1) Identify at a glance which operation is causing delays\nCaptures workers' actions and visualizes \u201cslow or inefficient actions\u201d.\nBy clarifying the causes, it becomes easier to make improvements.\n\n(2) easy to install\nSetup is completed with a single head-mounted display.\nThere is no need to bring in large equipment to the site, and the work area for training can be used as it is.\n\n(3) Simple operability for immediate use in the field\nNo complicated operations or specialized knowledge is required.\nWork improvement plans can be created on the spot based on captured data. This can be immediately reflected in the educational site.", "short_description": "TechniCapture is an MR application developed by Hololab Inc. for the purpose of \u201cexploring efficient educational methods.\n\n\u25a0 Three points that TechniCapture solves\n(1) Identify at a glance which operation is causing delays\nCaptures workers' actions and visualizes \u201cslow or inefficient actions\u201d.\n\n(2) easy to install\nSetup is completed with a single head-mounted display.\n\n(3) Simple operability for immediate use in the field\nNo complicated operations or specialized knowledge is required.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hololab.co.jp/technicapture/privacypolicy/index.html", "developer_terms_of_service_url": null, "publisher_name": "HoloLab Inc", "support_website_url": null, "website_url": "https://hololab.co.jp/technicapture", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "jv"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9136110523185302"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "3979200142396035"}, {"status": "PUBLISHED", "id": "1060180335901976"}]}, "baseline_offer": {"id": "3979200142396035"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1750310280, "status": "PUBLISHED", "id": "3979200142396035"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24897836796586088", "version": "1.0.12"}, "id": "2141641016294714", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8982301071899582", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "24897836796586088"}
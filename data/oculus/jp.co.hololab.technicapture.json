5f93\u6765\u306e\u65b9\u6cd5\u3067\u306f\u5177\u4f53\u7684\u306a\u6539\u5584\u70b9\u3092\u898b\u3064\u3051\u308b\u306e\u306f\u96e3\u3057\u304f\u6307\u5c0e\u306b\u3082\u6642\u9593\u304c\u304b\u304b\u308a\u307e\u3059\u3002\nTechniCapture\u306f\u3053\u3046\u3057\u305f\u8ab2\u984c\u3092\u89e3\u6c7a\u3059\u308b\u305f\u3081\u306b\u751f\u307e\u308c\u305f\u30c4\u30fc\u30eb\u3067\u3059\u3002\n\n\u25a0 TechniCapture\u304c\u89e3\u6c7a\u3059\u308b3\u3064\u306e\u30dd\u30a4\u30f3\u30c8\n1. \u3069\u306e\u4f5c\u696d\u3067\u9045\u308c\u304c\u51fa\u3066\u3044\u308b\u304b\u304c\u4e00\u76ee\u77ad\u7136\n\u4f5c\u696d\u8005\u306e\u52d5\u4f5c\u3092\u30ad\u30e3\u30d7\u30c1\u30e3\u30fc\u3057\u3001\u300c\u9045\u308c\u3066\u3044\u308b\u52d5\u4f5c\u300d\u300c\u52b9\u7387\u7684\u3067\u306f\u306a\u3044\u52d5\u4f5c\u300d\u3092\u898b\u3048\u308b\u5316\u3002\n\u539f\u56e0\u304c\u660e\u78ba\u306b\u306a\u308b\u3053\u3068\u3067\u3001\u6539\u5584\u304c\u3057\u3084\u3059\u304f\u306a\u308a\u307e\u3059\u3002\n\n2. \u624b\u8efd\u306b\u5c0e\u5165\n\u30d8\u30c3\u30c9\u30de\u30a6\u30f3\u30c8\u30c7\u30a3\u30b9\u30d7\u30ec\u30a41\u53f0\u3067\u30bb\u30c3\u30c8\u30a2\u30c3\u30d7\u5b8c\u4e86\u3002\n\u73fe\u5834\u306b\u5927\u639b\u304b\u308a\u306a\u8a2d\u5099\u3092\u6301\u3061\u8fbc\u3080\u5fc5\u8981\u306f\u306a\u304f\u3001\u6559\u80b2\u306e\u305f\u3081\u306e\u4f5c\u696d\u5834\u3092\u305d\u306e\u307e\u307e\u4f7f\u3048\u307e\u3059\u3002\n\n3. \u73fe\u5834\u3067\u5373\u4f7f\u3048\u308b\u3001\u30b7\u30f3\u30d7\u30eb\u306a\u64cd\u4f5c\u6027\n\u8907\u96d1\u306a\u64cd\u4f5c\u3084\u5c02\u9580\u77e5\u8b58\u306f\u4e0d\u8981\u3002\n\u30ad\u30e3\u30d7\u30c1\u30e3\u30fc\u3057\u305f\u30c7\u30fc\u30bf\u3092\u5143\u306b\u3001\u4f5c\u696d\u6539\u5584\u6848\u3092\u305d\u306e\u5834\u3067\u4f5c\u6210\u3002\u3059\u3050\u306b\u6559\u80b2\u73fe\u5834\u306b\u53cd\u6620\u3067\u304d\u307e\u3059\u3002", "short_description": "\u25a0 \u4f5c\u696d\u6559\u80b2\u306e\u73fe\u5834\u3067\u3001\u3053\u3093\u306a\u60a9\u307f\u3042\u308a\u307e\u305b\u
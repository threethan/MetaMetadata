r print.png", "id": "246912787875696", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031311_246912791209029_5540108180063733703_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3gGgIufrr5QQ7kNvwEZ8ZCV&_nc_oc=AdqO0zLsSgaEEVuusbcYcism-NZQfScfvt0_KcTgFFhZD3R3w5jcUOepPP_wNQ5jaWg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af29FMc92yaRUwMjavGs8pa5d38s1BvsTCCit0v7tUpmyQ&oe=69D7BA6E"}, {"file_name": "Print 3.png", "id": "2170405556482566", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/57572950_2170405559815899_5420058398011207589_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TnFzxQ2cYl0Q7kNvwFoXe4a&_nc_oc=AdqdC5RqHpasaE5U9bOYi5hm9OJElzLGh9RcZ7U2IhD4jcX6XQVD11YfGBrXyE-IdtA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af24QTaVAlcb7txg8PvV1ESl9WTzE-I21FeUMoTin15I5A&oe=69D793EF"}, {"file_name": "Print 5.png", "id": "921050275807580", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974548_921050279140913_846272164452751718_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=faAnv18wSBEQ7kNvwHNIVEo&_nc_oc=AdrCLVPoXOXDwqGzTp6c4FgKP-sKBLzUIk8XiK6ewSyMSEjEQIh3Rke3aRvlHoWygPc&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af25enOUwo5jesLWNPMFQeosXM_G7Vfl25xSu8VkhJOdUw&oe=69D7BF17"}, {"file_name": "Print 2.png", "id": "1288706015050300", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75641339_1288706018383633_3836298053771559642_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T9JJn30RsHYQ7kNvwHbGR3s&_nc_oc=AdqntXDVma_hhw8VlWW2AlNXIpjzGihWlb9dIylEEg0QNGOCOOhUbhfFVdrUbGQy7ls&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Hteo0q8Ws9iblKLtPiu_Z9VVNCgLktmGdBk5qs02mtw&oe=69D79091"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Final v.0.1 (eeve).png", "id": "945385240225978", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974721_945385243559311_50820886768660782_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qiOCGNChLpUQ7kNvwHNm7eR&_nc_oc=AdrKnPglONWbb6W6V2O0CIailYqrTJh07wcp9dFs5jcLn0TA7PpLL1XoWuUHeotqGiI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af07pkiOHrQMxV5h-4Egy2tX8d7xf7m7_6EzFV8inLlXUQ&oe=69D7963C"}, "display_name": "My Room", "keywords": [], "long_description": "My Room is the game experience that allows you to interact with your friends and also create your own world.\n\nCustomize your character and explore our two game modes: Playground & My Room.\n\nIn the Playground you will find yourself in a multiplayer environment surrounded by minigames that are available to play with others. These games include:\n- Soccer: score as many goals as you can\n- Air Hockey (Arcade): play with the AI or with another player\n- Basketball (Arcade): throw the balls and try to score points\n- Cornhole (Arcade): have fun trying to score as you play with the bean bags\n- Darts (Arcade): practice your aiming in the available stations\n- Mini Golf (Arcade): try to aim the hole at the mini golf courses\nThe multiplayer also includes voice/text chat for you to communicate with other players\n\nWhen in My Room, you will be able to customize your own space. You can choose between 3 different themed templates, explore and change it the way you prefer.\n\n* Find more information about the gameplay itself the app*\n\nUpcoming updates in the near future:\n- Game monetary system\n- Shop\n- More games\n- More rooms\n\nHave fun!", "short_description": "Play minigames along with your friends in a multiplayer environment or explore and customize your own room with this experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vresearchlab.com/privacy-policy/", "developer_terms_of_service_url": "https://vresearchlab.com/terms-of-use/", "publisher_name": "VResearch Lab", "support_website_url": null, "website_url": "https://vresearchlab.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "ex
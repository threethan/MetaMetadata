r print.png", "id": "246912787875696", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031311_246912791209029_5540108180063733703_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iyHsW3nFkRQQ7kNvwEmlhlu&_nc_oc=AdqA4o5_h4kIEKU3fB_XkIKBIy2YF-aUict7qiBO-sZhOo0glOowvRd3IDF4fxWwvlk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7Nkuyl28qeA68tHAkp3haEYDqWr8kz45RHPLTrsZi4Q&oe=6AB687EE"}, {"file_name": "Print 3.png", "id": "2170405556482566", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57572950_2170405559815899_5420058398011207589_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fXMl_kPW51oQ7kNvwFVkTQM&_nc_oc=AdorlEwlypyL6PZPdjWVtxCH6LdUR63ZnGVhi36mKi-MhspArjt5bmymoYOacvK_p38&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLlRTMp3bhYZm7ZaZybJnW_iFunZwlTkgQVg_imWuUqMg&oe=6AB699AF"}, {"file_name": "Print 5.png", "id": "921050275807580", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974548_921050279140913_846272164452751718_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K7j4NiO2WysQ7kNvwGsdykX&_nc_oc=Adr1y2W_RKepqQuO_phOBKju6T_jywjCI-44upA417cLGD9aEIXB7IXHzkaZTSZZugk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5J3JUMHuJzOgHK974vE3luuRKSb23ea-3cRLUupQIMw&oe=6AB68C97"}, {"file_name": "Print 2.png", "id": "1288706015050300", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75641339_1288706018383633_3836298053771559642_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1DIZfrUkk3QQ7kNvwEJ-qOH&_nc_oc=AdqNfBZ4BbvCc_fqC8lDneNgd9P43NgcLk7BfApp94yj0Rj4yO7C57AU2Bbs-6PiKMQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInrLcZX4Aqn5SzMERb3NwlWm7C5oPS9-ejdlvWkOd1Lw&oe=6AB69651"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Final v.0.1 (eeve).png", "id": "945385240225978", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974721_945385243559311_50820886768660782_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BgJHlg3gd6cQ7kNvwFrfYOP&_nc_oc=AdrAWtFWOT-EwBu-jHl8m3ytaJ28WMM5QFRp1WDx2HBmfsySUQtQsdAYnJU9b__BtVQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIkJ8Npdyf0cW-61tu5RwepUseJNlTWuMYVqkhWzYp7Vw&oe=6AB69BFC"}, "display_name": "My Room", "keywords": [], "long_description": "My Room is the game experience that allows you to interact with your friends and also create your own world.\n\nCustomize your character and explore our two game modes: Playground & My Room.\n\nIn the Playground you will find yourself in a multiplayer environment surrounded by minigames that are available to play with others. These games include:\n- Soccer: score as many goals as you can\n- Air Hockey (Arcade): play with the AI or with another player\n- Basketball (Arcade): throw the balls and try to score points\n- Cornhole (Arcade): have fun trying to score as you play with the bean bags\n- Darts (Arcade): practice your aiming in the available stations\n- Mini Golf (Arcade): try to aim the hole at the mini golf courses\nThe multiplayer also includes voice/text chat for you to communicate with other players\n\nWhen in My Room, you will be able to customize your own space. You can choose between 3 different themed templates, explore and change it the way you prefer.\n\n* Find more information about the gameplay itself the app*\n\nUpcoming updates in the near future:\n- Game monetary system\n- Shop\n- More games\n- More rooms\n\nHave fun!", "short_description": "Play minigames along with your friends in a multiplayer environment or explore and customize your own room with this experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vresearchlab.com/privacy-policy/", "developer_terms_of_service_url": "https://vresearchlab.com/terms-of-use/", "publisher_name": "VResearch Lab", "support_website_url": null, "website_url": "https://vresearchlab.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "ex
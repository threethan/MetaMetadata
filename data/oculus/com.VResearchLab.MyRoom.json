r print.png", "id": "246912787875696", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031311_246912791209029_5540108180063733703_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5g4XH1WZ-B4Q7kNvwGooUsk&_nc_oc=AdpT_N1BVHW2r-rGvIfXWiK4U3ZMH4hxbXU2t50bECFCnd25jae_0mc48W-wp3Ix1sM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af36f5t5JRvejqtu9r6gtM45-59P__P44FdO3FXefyNi-w&oe=69F4BB6E"}, {"file_name": "Print 3.png", "id": "2170405556482566", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57572950_2170405559815899_5420058398011207589_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sBYVu8D_oNUQ7kNvwGtJHQq&_nc_oc=Adr4HoBViNEQ46t3VSuOLEqhiwb46H2WTjU3AaJGFkxjVaemP2an90YjuY0KHEEowto&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3zQZF2CA9lRzXJZLaTkhcdDAK7HLxXU6oWegHaQKmwMA&oe=69F494EF"}, {"file_name": "Print 5.png", "id": "921050275807580", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974548_921050279140913_846272164452751718_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wY-f17ASpFMQ7kNvwEPlQuI&_nc_oc=AdpfzCIj-EQW1ykYpHz0CK_OmgWeSf4uCtCx4Pty_jpKDO8CZZFG20lKZSQi3i0JLVg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3t8vG7Mo5ZFqvUlwS4SxR7LHBrkiylWkpARgG4At0-RA&oe=69F4C017"}, {"file_name": "Print 2.png", "id": "1288706015050300", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75641339_1288706018383633_3836298053771559642_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RVrPZMBk9uQQ7kNvwGatEEY&_nc_oc=AdoIUmBpow0hRG7ZMAc3ki-7mdg50Od69Ia4kq8ppfRaA7-otIMTSPK-A5ZmyQEnxZw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1cv-z_y2laKcV3EHf9-QA8qvqrFevDgB1cfK2wyPDmgA&oe=69F49191"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Final v.0.1 (eeve).png", "id": "945385240225978", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974721_945385243559311_50820886768660782_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=feMoqpOqGO4Q7kNvwEZ9zMZ&_nc_oc=AdpKRXpY4zWXgZ-hjRSJfrs-4ymKD3jU6BHWacvc0Ge_6M58E4GXTH9xrlWLZttXTvo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0GjRuxMqVET4mY_3PLnVS-mYY3vuUg8HiTjOpih9bPyQ&oe=69F4973C"}, "display_name": "My Room", "keywords": [], "long_description": "My Room is the game experience that allows you to interact with your friends and also create your own world.\n\nCustomize your character and explore our two game modes: Playground & My Room.\n\nIn the Playground you will find yourself in a multiplayer environment surrounded by minigames that are available to play with others. These games include:\n- Soccer: score as many goals as you can\n- Air Hockey (Arcade): play with the AI or with another player\n- Basketball (Arcade): throw the balls and try to score points\n- Cornhole (Arcade): have fun trying to score as you play with the bean bags\n- Darts (Arcade): practice your aiming in the available stations\n- Mini Golf (Arcade): try to aim the hole at the mini golf courses\nThe multiplayer also includes voice/text chat for you to communicate with other players\n\nWhen in My Room, you will be able to customize your own space. You can choose between 3 different themed templates, explore and change it the way you prefer.\n\n* Find more information about the gameplay itself the app*\n\nUpcoming updates in the near future:\n- Game monetary system\n- Shop\n- More games\n- More rooms\n\nHave fun!", "short_description": "Play minigames along with your friends in a multiplayer environment or explore and customize your own room with this experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vresearchlab.com/privacy-policy/", "developer_terms_of_service_url": "https://vresearchlab.com/terms-of-use/", "publisher_name": "VResearch Lab", "support_website_url": null, "website_url": "https://vresearchlab.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "ex
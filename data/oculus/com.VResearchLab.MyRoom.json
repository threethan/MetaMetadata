5696", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031311_246912791209029_5540108180063733703_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aKPakfHKas8Q7kNvwFzDjjN&_nc_oc=Adm1SHqkSifJMobzRnvdcMoDkICj4Ww-rKV0k6Wo2JEybbYxBZkqMbzIeJnsfbH_KM0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx1ljUchbRlx0HboN2HQubittD0q6UydrW4zZBF4uL8Ow&oe=69B02D6E"}, {"file_name": "Print 3.png", "id": "2170405556482566", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572950_2170405559815899_5420058398011207589_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MLuM6wmHxcsQ7kNvwHWtnnx&_nc_oc=Adkz7LTELvg46_rPYhOfdBIb8HasOPdBJ0rUAPyEGAKhJ6EYWDozIN-hnVX3rU--_iU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw--KO7BlYmcVdU2PAI9XFi_BzP9lIMvaKD7e5T2D4abA&oe=69B006EF"}, {"file_name": "Print 5.png", "id": "921050275807580", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974548_921050279140913_846272164452751718_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0FF1v6RQcgEQ7kNvwFT8FZD&_nc_oc=Adl9P1y1017fmRgbUktETsK3ZKFuZfeOMRoEWQQnLV9MDLfHAkLUGGiqkeiM_0BFpJU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw3TcsIDQzPhEd27HZ19SyD0o-XJZ9TjHJi9d28pp1F4g&oe=69AFF9D7"}, {"file_name": "Print 2.png", "id": "1288706015050300", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75641339_1288706018383633_3836298053771559642_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UwlrSqSxHksQ7kNvwH-4eZs&_nc_oc=AdlNLDcG-v-ocwMwdOOl8bvs9LgF6i9Oj_AEyZy491vwq-gdz3ORp2EqsQFBcuMaG78&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwizrZoPhbQ0DeYqp5VorESwS2WHXZTwzi3uVNSUprRQg&oe=69B00391"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Final v.0.1 (eeve).png", "id": "945385240225978", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974721_945385243559311_50820886768660782_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vb1qAXNnMqYQ7kNvwFundsi&_nc_oc=AdlJ9B6kkLX2uHP0QMGW7YfY6UkOV94jcJWktaUH2fnEX7M969FCaTiC88j_Jx2hnxY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxlz2ZGi6oEnZ4QkklflYh-ONSy6b0bRwdDgs9oSmJ4LA&oe=69B0093C"}, "display_name": "My Room", "keywords": [], "long_description": "My Room is the game experience that allows you to interact with your friends and also create your own world.\n\nCustomize your character and explore our two game modes: Playground & My Room.\n\nIn the Playground you will find yourself in a multiplayer environment surrounded by minigames that are available to play with others. These games include:\n- Soccer: score as many goals as you can\n- Air Hockey (Arcade): play with the AI or with another player\n- Basketball (Arcade): throw the balls and try to score points\n- Cornhole (Arcade): have fun trying to score as you play with the bean bags\n- Darts (Arcade): practice your aiming in the available stations\n- Mini Golf (Arcade): try to aim the hole at the mini golf courses\nThe multiplayer also includes voice/text chat for you to communicate with other players\n\nWhen in My Room, you will be able to customize your own space. You can choose between 3 different themed templates, explore and change it the way you prefer.\n\n* Find more information about the gameplay itself the app*\n\nUpcoming updates in the near future:\n- Game monetary system\n- Shop\n- More games\n- More rooms\n\nHave fun!", "short_description": "Play minigames along with your friends in a multiplayer environment or explore and customize your own room with this experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vresearchlab.com/privacy-policy/", "developer_terms_of_service_url": "https://vresearchlab.com/terms-of-use/", "publisher_name": "VResearch Lab", "support_website_url": null, "website_url": "https://vresearchlab.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres":
r print.png", "id": "246912787875696", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031311_246912791209029_5540108180063733703_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s2cmqoeMicgQ7kNvwHI5cmS&_nc_oc=Adpxm2i2Zw9LdcrZExQY17zJ3I_Rt5CYGPXSQDegQLWKKXFsz_6k3aVERnoAEbM6gH4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLlUnisp_2xMrsw8Kx5nH53geavaP1fpibDpCiZP7A0dw&oe=6AB92AEE"}, {"file_name": "Print 3.png", "id": "2170405556482566", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572950_2170405559815899_5420058398011207589_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ETKMODCyzN4Q7kNvwF1AkEp&_nc_oc=Adq-3jTfPmPiB6Dmw8mc51Dxf45tQxDs4_dKbSHDUJVd9vNEKLkF3QTVlh2UbWX3g0o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJ_9BB-EF74NVlFOxZE5OJ-F1156CEL5f7GKKo9dEo6Q&oe=6AB93CAF"}, {"file_name": "Print 5.png", "id": "921050275807580", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974548_921050279140913_846272164452751718_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eUcaxyO9YMYQ7kNvwFFVScg&_nc_oc=AdqrGsoXs20_X1fH9SZ0Pqdh59uRtFL1WsutsEY0vOmxuehNqMoaTeq7bvX5KSI_kgI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQQFfPialr-JrVwMzOPb5Sq2RgGNqqA8HVY8_ynoOLVQ&oe=6AB92F97"}, {"file_name": "Print 2.png", "id": "1288706015050300", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75641339_1288706018383633_3836298053771559642_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oqArAs4fV-0Q7kNvwH7UrCb&_nc_oc=Ado6d8USBGZmJzDdqN0DJhn2KTo42FweNefASPdqS1GqfBqpJfahRMoNXL3o1fgkN3k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzNIqJURNiloOBxe1t4NcpPXWSqdaJsfAwW-YYq2LBpw&oe=6AB93951"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Final v.0.1 (eeve).png", "id": "945385240225978", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974721_945385243559311_50820886768660782_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BgJHlg3gd6cQ7kNvwGnvV5p&_nc_oc=AdpAozfna7cFQfS5FKN5udKDqKPmzUaAsCT18hDTZdulkXiAWR1pC4VXKDwok9zR1xo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjO0sSiOjtdEGGu_j-_kA3ClDFVKKSbBg_mCxi3vF7FQ&oe=6AB93EFC"}, "display_name": "My Room", "keywords": [], "long_description": "My Room is the game experience that allows you to interact with your friends and also create your own world.\n\nCustomize your character and explore our two game modes: Playground & My Room.\n\nIn the Playground you will find yourself in a multiplayer environment surrounded by minigames that are available to play with others. These games include:\n- Soccer: score as many goals as you can\n- Air Hockey (Arcade): play with the AI or with another player\n- Basketball (Arcade): throw the balls and try to score points\n- Cornhole (Arcade): have fun trying to score as you play with the bean bags\n- Darts (Arcade): practice your aiming in the available stations\n- Mini Golf (Arcade): try to aim the hole at the mini golf courses\nThe multiplayer also includes voice/text chat for you to communicate with other players\n\nWhen in My Room, you will be able to customize your own space. You can choose between 3 different themed templates, explore and change it the way you prefer.\n\n* Find more information about the gameplay itself the app*\n\nUpcoming updates in the near future:\n- Game monetary system\n- Shop\n- More games\n- More rooms\n\nHave fun!", "short_description": "Play minigames along with your friends in a multiplayer environment or explore and customize your own room with this experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vresearchlab.com/privacy-policy/", "developer_terms_of_service_url": "https://vresearchlab.com/terms-of-use/", "publisher_name": "VResearch Lab", "support_website_url": null, "website_url": "https://vresearchlab.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "ex
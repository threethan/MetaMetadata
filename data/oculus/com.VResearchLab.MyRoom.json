r print.png", "id": "246912787875696", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031311_246912791209029_5540108180063733703_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=coSk504Nzw4Q7kNvwF8Jzef&_nc_oc=AdrRK1Fvvy7ldS35d1lpU041G8LDgm5omUB-bX3UbY4u5QaOD63WSgvIVEuLSzAcn6I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAxrpS8dfKA12xWV6ycb-NYvdREAp8Lkb_7rhKK6QM_LA&oe=6A53A76E"}, {"file_name": "Print 3.png", "id": "2170405556482566", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57572950_2170405559815899_5420058398011207589_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wF9A_3no658Q7kNvwF2vnCl&_nc_oc=Adre5kH7_lKsKWC0ntWA02nJJ6WcYsz55gsY1Rfqbj1ulcY3wQePcuqbN27iL0tEPWs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwUAfS4zTvD2ILuNT5byjbNtCZ8zqe4HRs6EpjN5oDMg&oe=6A5380EF"}, {"file_name": "Print 5.png", "id": "921050275807580", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974548_921050279140913_846272164452751718_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iG5rn1tDeFYQ7kNvwEbpH3v&_nc_oc=Ado0PbYG0bVijmUzFzZK0G7OqVoEdi8CGmy3c8zkz_eFxekkGFJvyLpwru1ibTFR1t0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCLPqnEQS4ad3gGD5CHQgjNbYTiIfW6YaCxHpls09Si1A&oe=6A53AC17"}, {"file_name": "Print 2.png", "id": "1288706015050300", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75641339_1288706018383633_3836298053771559642_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K_wYWtbQ290Q7kNvwHr_TF_&_nc_oc=AdoUMUJRqfsAZ4ui5jTrLCShJy3inO7QYEuKXL_SLxAD43s4S1PKhTSEZ_cPgKPiNDI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBhBeH4jAhD9ISB1qErRmgKG6mkWq-H4fHt_-978DjfEg&oe=6A537D91"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Final v.0.1 (eeve).png", "id": "945385240225978", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974721_945385243559311_50820886768660782_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bwb9Aas2AjAQ7kNvwFHwwO5&_nc_oc=AdrSe1h84bWZY7W3U8Y6zb9EgGWAP6tkfrUztgwdJVApAcxDgX2gCyiHHTZsnHl6XK8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCtgKlGNINrjpOn_aQz_ki6RSp2mvL_MXGxIQv513EXHA&oe=6A53833C"}, "display_name": "My Room", "keywords": [], "long_description": "My Room is the game experience that allows you to interact with your friends and also create your own world.\n\nCustomize your character and explore our two game modes: Playground & My Room.\n\nIn the Playground you will find yourself in a multiplayer environment surrounded by minigames that are available to play with others. These games include:\n- Soccer: score as many goals as you can\n- Air Hockey (Arcade): play with the AI or with another player\n- Basketball (Arcade): throw the balls and try to score points\n- Cornhole (Arcade): have fun trying to score as you play with the bean bags\n- Darts (Arcade): practice your aiming in the available stations\n- Mini Golf (Arcade): try to aim the hole at the mini golf courses\nThe multiplayer also includes voice/text chat for you to communicate with other players\n\nWhen in My Room, you will be able to customize your own space. You can choose between 3 different themed templates, explore and change it the way you prefer.\n\n* Find more information about the gameplay itself the app*\n\nUpcoming updates in the near future:\n- Game monetary system\n- Shop\n- More games\n- More rooms\n\nHave fun!", "short_description": "Play minigames along with your friends in a multiplayer environment or explore and customize your own room with this experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vresearchlab.com/privacy-policy/", "developer_terms_of_service_url": "https://vresearchlab.com/terms-of-use/", "publisher_name": "VResearch Lab", "support_website_url": null, "website_url": "https://vresearchlab.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "ex
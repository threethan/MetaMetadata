r print.png", "id": "246912787875696", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031311_246912791209029_5540108180063733703_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L_vEV6zSvs0Q7kNvwHLrOXN&_nc_oc=Adr0Lay9i3MjRbjwujJRY8KWaz_Q-EQSFYgqVFgQo_x-edZBkdrR6BWq10mSRdQIWko&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af793zyCyrm7zUoY99-k6WgbuxVPYnM3W8BXhytosCTyRQ&oe=69FA016E"}, {"file_name": "Print 3.png", "id": "2170405556482566", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572950_2170405559815899_5420058398011207589_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_2PcVD769NMQ7kNvwHJyzL0&_nc_oc=Adpk-iBzv1D4Pf7bLiays1-Cv7txKG6W-Z7torVKRhRjRcF8Ii9bIvZ-itcIBXhgOtg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6MgQDtRbGVTub0UGd20Sj9bq7DIxR_Y1xxnn9X0W4mow&oe=69F9DAEF"}, {"file_name": "Print 5.png", "id": "921050275807580", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974548_921050279140913_846272164452751718_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GCg25U8OJHgQ7kNvwGgyDOX&_nc_oc=AdoRKrCJ-WCje0nPOGVnOqn_8DPLhz5WhwDnvFGVFgh1olRHRvegz475DEqVE5r3Uds&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4uaGzy__HyMkPtbXeTe1TRnWemFgL1HDzDM1iLoohCug&oe=69FA0617"}, {"file_name": "Print 2.png", "id": "1288706015050300", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75641339_1288706018383633_3836298053771559642_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aoqLA_E0rlgQ7kNvwGhmk8W&_nc_oc=AdrVyzO0Mm8K9YYPUK0plnYpFnFOr1ZJVk2IhEftKBNkXhzniJiASfA-TTj9GL3is9A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4rIgNRyHIih02E78Sgl5OItoV7MVYY9bp1FkcLAKY6-A&oe=69FA0FD1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Final v.0.1 (eeve).png", "id": "945385240225978", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974721_945385243559311_50820886768660782_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iiev9chUxAAQ7kNvwH-aGnE&_nc_oc=Adq3t1w6hebzTxT2wvgbF8TEVsFO11LvR-x_jFfafVd3REnQt1cBHRgDgg28nvxDD6U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4K0Gpy6s28O6Vl7nMm4SUKg8EhP9kjBe28CihekNROLw&oe=69F9DD3C"}, "display_name": "My Room", "keywords": [], "long_description": "My Room is the game experience that allows you to interact with your friends and also create your own world.\n\nCustomize your character and explore our two game modes: Playground & My Room.\n\nIn the Playground you will find yourself in a multiplayer environment surrounded by minigames that are available to play with others. These games include:\n- Soccer: score as many goals as you can\n- Air Hockey (Arcade): play with the AI or with another player\n- Basketball (Arcade): throw the balls and try to score points\n- Cornhole (Arcade): have fun trying to score as you play with the bean bags\n- Darts (Arcade): practice your aiming in the available stations\n- Mini Golf (Arcade): try to aim the hole at the mini golf courses\nThe multiplayer also includes voice/text chat for you to communicate with other players\n\nWhen in My Room, you will be able to customize your own space. You can choose between 3 different themed templates, explore and change it the way you prefer.\n\n* Find more information about the gameplay itself the app*\n\nUpcoming updates in the near future:\n- Game monetary system\n- Shop\n- More games\n- More rooms\n\nHave fun!", "short_description": "Play minigames along with your friends in a multiplayer environment or explore and customize your own room with this experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vresearchlab.com/privacy-policy/", "developer_terms_of_service_url": "https://vresearchlab.com/terms-of-use/", "publisher_name": "VResearch Lab", "support_website_url": null, "website_url": "https://vresearchlab.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "ex
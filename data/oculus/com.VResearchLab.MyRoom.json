5696", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031311_246912791209029_5540108180063733703_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aKPakfHKas8Q7kNvwENdkRE&_nc_oc=AdmVCrX6rfZu3DgpTvie6y3_8NsQ1flWU5Ja5YeDp9hrSY_PUbm8DcOP1RLHd7LXc6s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwEvHI0Sv35BIEcCcxDPBxR1cz_oH5tinSj9co20iniUA&oe=69B146AE"}, {"file_name": "Print 3.png", "id": "2170405556482566", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57572950_2170405559815899_5420058398011207589_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MLuM6wmHxcsQ7kNvwEjLqpo&_nc_oc=AdnHkLSudjlGrcLtpgVL5guONFe07YIGTUVwVNw_petaV7peCsEEV5HBvKKonOxvOIM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzsIdEZLsTjxzICXH17ApGbv12qxdcLzl1R3ZR7v4X_zA&oe=69B1586F"}, {"file_name": "Print 5.png", "id": "921050275807580", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974548_921050279140913_846272164452751718_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0FF1v6RQcgEQ7kNvwES_CTl&_nc_oc=AdmOBzBazbprFoFfUaV4bMjYiYn1tYv8Lu6BvGpLqJzJGisFlARF_vbiPg2eyGN9eoo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzcVb0J1HXqeXokqZJrwu6KWjVuJdd5HWlaeJAH-clvRA&oe=69B14B57"}, {"file_name": "Print 2.png", "id": "1288706015050300", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75641339_1288706018383633_3836298053771559642_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UwlrSqSxHksQ7kNvwE18LiX&_nc_oc=Adn2M9NtLslHodPI9mSQhdQe1KHLCnbjh7doykjuI_rGlir1IoybUIrDXjR4yeK7ZXM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz2NkSxv2izPv11Dv5bGgp4Qv1tlgC4iALoF23HvS8rag&oe=69B15511"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Final v.0.1 (eeve).png", "id": "945385240225978", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974721_945385243559311_50820886768660782_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H5I4U377aPAQ7kNvwGuXFNV&_nc_oc=Adndl1tZFA_CmvOipZZdGmgn5xJtnpcnMQ41kB21LLfrYcRFAqX4ztVimoOo3F3_XAQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afzru00ftBVqlan8G88TMdHF5upaTXq3GIP4SnNf4S603w&oe=69B15ABC"}, "display_name": "My Room", "keywords": [], "long_description": "My Room is the game experience that allows you to interact with your friends and also create your own world.\n\nCustomize your character and explore our two game modes: Playground & My Room.\n\nIn the Playground you will find yourself in a multiplayer environment surrounded by minigames that are available to play with others. These games include:\n- Soccer: score as many goals as you can\n- Air Hockey (Arcade): play with the AI or with another player\n- Basketball (Arcade): throw the balls and try to score points\n- Cornhole (Arcade): have fun trying to score as you play with the bean bags\n- Darts (Arcade): practice your aiming in the available stations\n- Mini Golf (Arcade): try to aim the hole at the mini golf courses\nThe multiplayer also includes voice/text chat for you to communicate with other players\n\nWhen in My Room, you will be able to customize your own space. You can choose between 3 different themed templates, explore and change it the way you prefer.\n\n* Find more information about the gameplay itself the app*\n\nUpcoming updates in the near future:\n- Game monetary system\n- Shop\n- More games\n- More rooms\n\nHave fun!", "short_description": "Play minigames along with your friends in a multiplayer environment or explore and customize your own room with this experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vresearchlab.com/privacy-policy/", "developer_terms_of_service_url": "https://vresearchlab.com/terms-of-use/", "publisher_name": "VResearch Lab", "support_website_url": null, "website_url": "https://vresearchlab.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres":
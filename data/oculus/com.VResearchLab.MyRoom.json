r print.png", "id": "246912787875696", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031311_246912791209029_5540108180063733703_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2aDHszb58BIQ7kNvwEeVsLn&_nc_oc=Adp2NRI9_miJfYWkilaWxZJt2h9_E7YicT8zm2ko2YywPrwjbaRx6CRXYOIqdAlcD3o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ELjSCwfspmUqf0XTPXP4O5Yyv2_66lhfvmGXmotoQ2g&oe=6A2AC8EE"}, {"file_name": "Print 3.png", "id": "2170405556482566", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57572950_2170405559815899_5420058398011207589_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sXWPtinxBnMQ7kNvwFRj3JX&_nc_oc=AdpkkYk97kfK1tdy4tofPxSCH-Qs6orD3KoCpe7LB_ROjmPrjRMPbgCoz2V4chYpXow&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Q_UydR4PCznw2LPbFd-HORtcMYzFCU4-WXCUE-Lca3w&oe=6A2ADAAF"}, {"file_name": "Print 5.png", "id": "921050275807580", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974548_921050279140913_846272164452751718_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vwqWPxjp5LMQ7kNvwF_KTF_&_nc_oc=AdoED3sjID--LjMuhHyvxUOgw-MIagBr-XpPKwYMHHADZYTMzqu1jC45x88LfWLgj98&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-bNo8p29J0uRec2-oYCZ7u_54SQV1rHzVWIYeC2Ky4mQ&oe=6A2ACD97"}, {"file_name": "Print 2.png", "id": "1288706015050300", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75641339_1288706018383633_3836298053771559642_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dBMCT9nqKPYQ7kNvwG_BTYu&_nc_oc=AdqT_noFVzyVmwNmDpYyE00YLWJGfTvIWxpPbOGhtCid3RUY1wN6aERTWkYhCJ59j0c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-44ELs6_-bHw5jHn5ooqvwoeELSMUD5x_Ec4xbHTGFaw&oe=6A2AD751"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Final v.0.1 (eeve).png", "id": "945385240225978", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974721_945385243559311_50820886768660782_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RI4npNJyI3MQ7kNvwG7bJ-Q&_nc_oc=AdpbgPtt2VvOWkYSVpg9OyE_FkgdEaeaaSvXjGJgjKfhlgN8NdGVez_vBs_qvwJL0-w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8BXvoTK_Onf3zf7qGSSE_egem_EWbd2Vo-P-6igMPqGA&oe=6A2ADCFC"}, "display_name": "My Room", "keywords": [], "long_description": "My Room is the game experience that allows you to interact with your friends and also create your own world.\n\nCustomize your character and explore our two game modes: Playground & My Room.\n\nIn the Playground you will find yourself in a multiplayer environment surrounded by minigames that are available to play with others. These games include:\n- Soccer: score as many goals as you can\n- Air Hockey (Arcade): play with the AI or with another player\n- Basketball (Arcade): throw the balls and try to score points\n- Cornhole (Arcade): have fun trying to score as you play with the bean bags\n- Darts (Arcade): practice your aiming in the available stations\n- Mini Golf (Arcade): try to aim the hole at the mini golf courses\nThe multiplayer also includes voice/text chat for you to communicate with other players\n\nWhen in My Room, you will be able to customize your own space. You can choose between 3 different themed templates, explore and change it the way you prefer.\n\n* Find more information about the gameplay itself the app*\n\nUpcoming updates in the near future:\n- Game monetary system\n- Shop\n- More games\n- More rooms\n\nHave fun!", "short_description": "Play minigames along with your friends in a multiplayer environment or explore and customize your own room with this experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vresearchlab.com/privacy-policy/", "developer_terms_of_service_url": "https://vresearchlab.com/terms-of-use/", "publisher_name": "VResearch Lab", "support_website_url": null, "website_url": "https://vresearchlab.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "ex
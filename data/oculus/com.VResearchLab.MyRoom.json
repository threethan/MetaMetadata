r print.png", "id": "246912787875696", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031311_246912791209029_5540108180063733703_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=neQ_nsKG3nsQ7kNvwFoTJGr&_nc_oc=AdrZmbzjPOpkCon6YnL7bSHXSwTT2UzMDqTYSsJx2skz-xKclMsiTRXGgbzwo3EF4ws&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1MyFVqmhsIdl6oDyo8isBOfWDlF3KP9Ifi4dxr5a7Zjw&oe=69EE23EE"}, {"file_name": "Print 3.png", "id": "2170405556482566", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572950_2170405559815899_5420058398011207589_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JDh8lpwQyGUQ7kNvwFozZ-K&_nc_oc=AdpblO6-Ll_VtnPPnQUQHLWQ5lO3cbjKVlBwb3WvzuCE1cYcc9PG-CTAw5ShG1VgZ80&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3vkDZ2o7x_6GMQuITRMcGED3_VZu9Blt28tStHHrncjw&oe=69EDFD6F"}, {"file_name": "Print 5.png", "id": "921050275807580", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974548_921050279140913_846272164452751718_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LhM8H4hSLA8Q7kNvwHiL5Jd&_nc_oc=AdpSiY8yF8X5w5XppAW---R-CR8bFFv9_SVd7p0p4u_eBedPocOsFfOpXjHULuAI4f8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3H9xu236QC_BJXpPo1tGRfRfLE6Qr3lzlWkWQjArx__Q&oe=69EE2897"}, {"file_name": "Print 2.png", "id": "1288706015050300", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75641339_1288706018383633_3836298053771559642_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=teKgfKZr-ugQ7kNvwGNYhrq&_nc_oc=AdqyHV8DjqqM2ro4PQeLc2nswmaBhDQ2ksZPGiaW-8tKGwSf6s_hikQGdSV8iNDI7iM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3hAww-xF7Bm0KIvGaOyKUEiJbeHzIgTziLKx7wYv0IWw&oe=69EDFA11"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Final v.0.1 (eeve).png", "id": "945385240225978", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974721_945385243559311_50820886768660782_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FTlsdleHfuQQ7kNvwH-Crbg&_nc_oc=Adr3As9Wej8sHp8tFo7sxjqq7RZd6OBuQ6sSu4FZhUUcbGyWWLF9tDXCnUFnX0zb0n0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af28cMTzQpan7nfpkPnxrXXV9C0LZg8ICHMZnGy-8fmzcg&oe=69EDFFBC"}, "display_name": "My Room", "keywords": [], "long_description": "My Room is the game experience that allows you to interact with your friends and also create your own world.\n\nCustomize your character and explore our two game modes: Playground & My Room.\n\nIn the Playground you will find yourself in a multiplayer environment surrounded by minigames that are available to play with others. These games include:\n- Soccer: score as many goals as you can\n- Air Hockey (Arcade): play with the AI or with another player\n- Basketball (Arcade): throw the balls and try to score points\n- Cornhole (Arcade): have fun trying to score as you play with the bean bags\n- Darts (Arcade): practice your aiming in the available stations\n- Mini Golf (Arcade): try to aim the hole at the mini golf courses\nThe multiplayer also includes voice/text chat for you to communicate with other players\n\nWhen in My Room, you will be able to customize your own space. You can choose between 3 different themed templates, explore and change it the way you prefer.\n\n* Find more information about the gameplay itself the app*\n\nUpcoming updates in the near future:\n- Game monetary system\n- Shop\n- More games\n- More rooms\n\nHave fun!", "short_description": "Play minigames along with your friends in a multiplayer environment or explore and customize your own room with this experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vresearchlab.com/privacy-policy/", "developer_terms_of_service_url": "https://vresearchlab.com/terms-of-use/", "publisher_name": "VResearch Lab", "support_website_url": null, "website_url": "https://vresearchlab.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "ex
311_246912791209029_5540108180063733703_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wzE0An5m7-UQ7kNvwHgwe8h&_nc_oc=AdmpcBE3-ctwb6Lzd_0Phn5eDzp7-6pRMqKCkcfvWsHHciO06pz75TXDdlydrOB_TSU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afuld2UW4NUMkTWu_lUhsaLKQe7HXiOG8aZaAueEbABvNg&oe=69998BAE"}, {"file_name": "Print 3.png", "id": "2170405556482566", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572950_2170405559815899_5420058398011207589_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0sorJH1mkysQ7kNvwFr3VhW&_nc_oc=AdlkTNWW2kHAZmTnWyYwziaz1ahZhKocYYDH_jSPohu0F5sxTKxF8VTssqjDO3vtmSI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsr75asTysSAuYPvfRBbJIy0z-rpsqFm23_G2EUSeCwgg&oe=69999D6F"}, {"file_name": "Print 5.png", "id": "921050275807580", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974548_921050279140913_846272164452751718_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E2As3SfexywQ7kNvwFe3jG7&_nc_oc=AdnBdkWO2xf9hrh_G5A6ONIANvBgfHpFsNlKeD3-1jHOHhozV_3Lz6Hx13uSMi4oWUg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfstTrmjTgWExdKkGA0EVde18HegoSJ-YZe6KU5Fx6OMig&oe=69999057"}, {"file_name": "Print 2.png", "id": "1288706015050300", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75641339_1288706018383633_3836298053771559642_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kiax3jjW7DYQ7kNvwEBS1Td&_nc_oc=AdlUuGs-6Ee2U5LDLsoZQ31TyFVjAka2mDeQq1BZDXdC5ap6aWfWH1h3ZHiFHDddxNI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvfuZgj6RCLXvT9CPgc-0KZCA4KYP01GFlKX0wHMCmHMA&oe=69999A11"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Final v.0.1 (eeve).png", "id": "945385240225978", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974721_945385243559311_50820886768660782_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ZzFqIZSrO4Q7kNvwGotpe1&_nc_oc=AdnPhVPANjXMRmxVjjcoxvui-rQG_px_2Y7SiixqMAH4bUA-GpY--yowiyBECnodHYQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftWDC1tRvdaxBAWL6oIuX-r8I86DO0toFWzT7mFTgaJ2w&oe=69999FBC"}, "display_name": "My Room", "keywords": [], "long_description": "My Room is the game experience that allows you to interact with your friends and also create your own world.\n\nCustomize your character and explore our two game modes: Playground & My Room.\n\nIn the Playground you will find yourself in a multiplayer environment surrounded by minigames that are available to play with others. These games include:\n- Soccer: score as many goals as you can\n- Air Hockey (Arcade): play with the AI or with another player\n- Basketball (Arcade): throw the balls and try to score points\n- Cornhole (Arcade): have fun trying to score as you play with the bean bags\n- Darts (Arcade): practice your aiming in the available stations\n- Mini Golf (Arcade): try to aim the hole at the mini golf courses\nThe multiplayer also includes voice/text chat for you to communicate with other players\n\nWhen in My Room, you will be able to customize your own space. You can choose between 3 different themed templates, explore and change it the way you prefer.\n\n* Find more information about the gameplay itself the app*\n\nUpcoming updates in the near future:\n- Game monetary system\n- Shop\n- More games\n- More rooms\n\nHave fun!", "short_description": "Play minigames along with your friends in a multiplayer environment or explore and customize your own room with this experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vresearchlab.com/privacy-policy/", "developer_terms_of_service_url": "https://vresearchlab.com/terms-of-use/", "publisher_name": "VResearch Lab", "support_website_url": null, "website_url": "https://vresearchlab.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null
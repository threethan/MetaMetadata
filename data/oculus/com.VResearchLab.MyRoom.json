r print.png", "id": "246912787875696", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031311_246912791209029_5540108180063733703_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UfbwjHWfemYQ7kNvwH9Jm-p&_nc_oc=Adpspn_pdw5cL9ZPmGBlHmbWmvpkJwKldKq4orxW8UNg-RLnrqnkPWMQgC1mtbqtuzE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2OP36dnHtvcYJozs6GJJ62C6IXYR9DVxgEKh1OECnivA&oe=69DE51EE"}, {"file_name": "Print 3.png", "id": "2170405556482566", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572950_2170405559815899_5420058398011207589_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q7OkBNtOdjYQ7kNvwGe_kwS&_nc_oc=Adr8wKFYJ3KPxYRGxeVq2tZTVRKQ3wPZJDnQU7YgFwhch3qt0BRVD3_xI-zO1xyMmEs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1LLqncqZqQ50SPTqFinsrKz7bj18Cpfc4fAgTZtX8PPg&oe=69DE2B6F"}, {"file_name": "Print 5.png", "id": "921050275807580", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974548_921050279140913_846272164452751718_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4LeoV3dWdIMQ7kNvwFIFm7V&_nc_oc=Adp_IPlgTBacJKuN8RPqZXuoQ0Tkq46K_BOUlObvmuMkknbkqHKPIPtzaK-YHtHudhk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0_Hv36PYPCz12zABiQAedCh-DfmIeO4RdJg1oWo5uqLQ&oe=69DE1E57"}, {"file_name": "Print 2.png", "id": "1288706015050300", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75641339_1288706018383633_3836298053771559642_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QySNQEY26tEQ7kNvwHsLGwU&_nc_oc=AdqhXePX9zmT1jQer8RzgEMV0o83SHf6z8VsjBysH-qPTQzWPhpHrzTX_R8WVzKysgI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af29zyVnz4D1taYzpulz9mqqRlI0_SpxqyuuwSz8gbfPNQ&oe=69DE2811"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Final v.0.1 (eeve).png", "id": "945385240225978", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974721_945385243559311_50820886768660782_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3xeQSfkfcZQQ7kNvwEPIQto&_nc_oc=Adoa8KXNr02p7WBJQN85BmCOuqreSZBHDaNp3bADWZ2n3Z8d-MPHdnCFnF1s6AwoGQE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3xD8wjmM0zi_9NNrlhtzGhcwkbZNUoRnhb0wu3IQoEVg&oe=69DE2DBC"}, "display_name": "My Room", "keywords": [], "long_description": "My Room is the game experience that allows you to interact with your friends and also create your own world.\n\nCustomize your character and explore our two game modes: Playground & My Room.\n\nIn the Playground you will find yourself in a multiplayer environment surrounded by minigames that are available to play with others. These games include:\n- Soccer: score as many goals as you can\n- Air Hockey (Arcade): play with the AI or with another player\n- Basketball (Arcade): throw the balls and try to score points\n- Cornhole (Arcade): have fun trying to score as you play with the bean bags\n- Darts (Arcade): practice your aiming in the available stations\n- Mini Golf (Arcade): try to aim the hole at the mini golf courses\nThe multiplayer also includes voice/text chat for you to communicate with other players\n\nWhen in My Room, you will be able to customize your own space. You can choose between 3 different themed templates, explore and change it the way you prefer.\n\n* Find more information about the gameplay itself the app*\n\nUpcoming updates in the near future:\n- Game monetary system\n- Shop\n- More games\n- More rooms\n\nHave fun!", "short_description": "Play minigames along with your friends in a multiplayer environment or explore and customize your own room with this experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vresearchlab.com/privacy-policy/", "developer_terms_of_service_url": "https://vresearchlab.com/terms-of-use/", "publisher_name": "VResearch Lab", "support_website_url": null, "website_url": "https://vresearchlab.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "ex
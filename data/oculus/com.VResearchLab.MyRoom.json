311_246912791209029_5540108180063733703_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=neQ_nsKG3nsQ7kNvwGCnzzs&_nc_oc=AdpItCJ9Q67tKlnglU90RqdyT7r59Ca7czK6ukTVQwgOXXdqaTnEU6Fcy0FMn5UaYZw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1PJUHmR-TOGl44El6Z9IjhgjEr0rMZ9lK5UuOzA23fng&oe=69F0C6EE"}, {"file_name": "Print 3.png", "id": "2170405556482566", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572950_2170405559815899_5420058398011207589_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JDh8lpwQyGUQ7kNvwExnHmo&_nc_oc=Adp1YgrHvx5l45C-zELrEoQH1mVi9mK7uImOuzp_O4T5CYZ77jJo2fGmre_APrYVv9Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3_WTzEntFQUKkb3_YJv5HrnMiA55Vq7OiYZxRc0b4cqA&oe=69F0A06F"}, {"file_name": "Print 5.png", "id": "921050275807580", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974548_921050279140913_846272164452751718_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LhM8H4hSLA8Q7kNvwE-ukok&_nc_oc=AdokL9qOAVwFjPGLVrngLp4bDSbTUnpIRjs0E-AYtqTEtBYmITA4LHkb9mz6F2n0aSQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1tWEdpwf5B4PZo2dhDHeNQfzC2T9Dc40ahZbnNF2ii_g&oe=69F0CB97"}, {"file_name": "Print 2.png", "id": "1288706015050300", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75641339_1288706018383633_3836298053771559642_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=teKgfKZr-ugQ7kNvwEK9lDj&_nc_oc=Adp9FqVSSmbejpJw_NedcdrOPT4oX0BDEl_u-cxyByYi48hCqXZAfAv-1-es3GR0lXM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3cMLFAoOO-G_6LQtMIxSUbFWyGG7H6l2TILJtT74y4tQ&oe=69F09D11"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Final v.0.1 (eeve).png", "id": "945385240225978", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974721_945385243559311_50820886768660782_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s2wE6tkkzpQQ7kNvwGoozmi&_nc_oc=AdpugksR8IA5sOhJzvoD5KLzAE_LzQZMPfGmf1GT3Va0Ez5-MbmztSKUhOezSBySqP4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1k8uDL2RAfqSNUuBX_KwB80YjHBAcnaIHN8NhtGhXCNw&oe=69F0A2BC"}, "display_name": "My Room", "keywords": [], "long_description": "My Room is the game experience that allows you to interact with your friends and also create your own world.\n\nCustomize your character and explore our two game modes: Playground & My Room.\n\nIn the Playground you will find yourself in a multiplayer environment surrounded by minigames that are available to play with others. These games include:\n- Soccer: score as many goals as you can\n- Air Hockey (Arcade): play with the AI or with another player\n- Basketball (Arcade): throw the balls and try to score points\n- Cornhole (Arcade): have fun trying to score as you play with the bean bags\n- Darts (Arcade): practice your aiming in the available stations\n- Mini Golf (Arcade): try to aim the hole at the mini golf courses\nThe multiplayer also includes voice/text chat for you to communicate with other players\n\nWhen in My Room, you will be able to customize your own space. You can choose between 3 different themed templates, explore and change it the way you prefer.\n\n* Find more information about the gameplay itself the app*\n\nUpcoming updates in the near future:\n- Game monetary system\n- Shop\n- More games\n- More rooms\n\nHave fun!", "short_description": "Play minigames along with your friends in a multiplayer environment or explore and customize your own room with this experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vresearchlab.com/privacy-policy/", "developer_terms_of_service_url": "https://vresearchlab.com/terms-of-use/", "publisher_name": "VResearch Lab", "support_website_url": null, "website_url": "https://vresearchlab.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null
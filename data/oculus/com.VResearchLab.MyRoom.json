r print.png", "id": "246912787875696", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031311_246912791209029_5540108180063733703_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OCqyJO2yfsYQ7kNvwHeOedv&_nc_oc=AdoISd_HzFt8PnzLQDWaETAVzzSGADBbeAkgfIfMJukHkL6qZ1QwSaCFLQp2eKFt98E&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74q7sPIJCfmN0wQwZfVUNQNWCUhjEC7jdMoMvNwWmNFg&oe=69FDF5EE"}, {"file_name": "Print 3.png", "id": "2170405556482566", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57572950_2170405559815899_5420058398011207589_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rIicHZs13yUQ7kNvwFQ-hos&_nc_oc=Ado6f_p-umQAZ-pXLPAnHYqdx3LTstdn7gWOt2esscwJqbyZrK31AzM6AW191dD2O2o&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7gF3O7S-d9-5ZN6OowFJJgvws2KgVrDOthkFA1amPMWA&oe=69FE07AF"}, {"file_name": "Print 5.png", "id": "921050275807580", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974548_921050279140913_846272164452751718_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iV37Gv-7aO4Q7kNvwEV3J3k&_nc_oc=AdqZhpJMyXsh2f043x5INuUPwMKJ-4KrzLqIgq4NqpuWwSwLXUygzVIGkZTROk_QBBk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af78Q0nZYylPFSpEP9KqTQgRdoJ4bcydzY4FiEdnM15tSQ&oe=69FDFA97"}, {"file_name": "Print 2.png", "id": "1288706015050300", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75641339_1288706018383633_3836298053771559642_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uRA-jkQ0km8Q7kNvwE5bKgh&_nc_oc=AdrKuPRMOIw2UqvVjWQyoG2HHJOSE5s6oXw39nST4qfa0NNleitINiQVW1gbjOg0kBs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5eORdY-Z9d5JQ3IXFTR8XorMdAZ8tWjfKtA8S32ixw9w&oe=69FE0451"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Final v.0.1 (eeve).png", "id": "945385240225978", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974721_945385243559311_50820886768660782_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iv6blYTbycUQ7kNvwF_s3Li&_nc_oc=Adq4LugDLGgTe96-ALwhhBwqBy3CW7ih8NFGXZXVtqGT21ApxAMKXNeViUzSzOYNDhU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7HUdu7TTqxdskXVk_UxyAK6c4ljJRVeo_E1zdnUsDBqg&oe=69FDD1BC"}, "display_name": "My Room", "keywords": [], "long_description": "My Room is the game experience that allows you to interact with your friends and also create your own world.\n\nCustomize your character and explore our two game modes: Playground & My Room.\n\nIn the Playground you will find yourself in a multiplayer environment surrounded by minigames that are available to play with others. These games include:\n- Soccer: score as many goals as you can\n- Air Hockey (Arcade): play with the AI or with another player\n- Basketball (Arcade): throw the balls and try to score points\n- Cornhole (Arcade): have fun trying to score as you play with the bean bags\n- Darts (Arcade): practice your aiming in the available stations\n- Mini Golf (Arcade): try to aim the hole at the mini golf courses\nThe multiplayer also includes voice/text chat for you to communicate with other players\n\nWhen in My Room, you will be able to customize your own space. You can choose between 3 different themed templates, explore and change it the way you prefer.\n\n* Find more information about the gameplay itself the app*\n\nUpcoming updates in the near future:\n- Game monetary system\n- Shop\n- More games\n- More rooms\n\nHave fun!", "short_description": "Play minigames along with your friends in a multiplayer environment or explore and customize your own room with this experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vresearchlab.com/privacy-policy/", "developer_terms_of_service_url": "https://vresearchlab.com/terms-of-use/", "publisher_name": "VResearch Lab", "support_website_url": null, "website_url": "https://vresearchlab.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "ex
r print.png", "id": "246912787875696", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031311_246912791209029_5540108180063733703_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vg0dr_lPldcQ7kNvwGeHljr&_nc_oc=AdrA2QXcHZNiRy6yYzxRLLoGJhsrun4GTWjLb9Fa39YqOa8nk6I9Yd-_5te8Eo_E1Lo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9xr6qDi4lX1zbEjm6FeVqNseT8masGOAY-BFpFyqFWSg&oe=6A3A9AEE"}, {"file_name": "Print 3.png", "id": "2170405556482566", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57572950_2170405559815899_5420058398011207589_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZqHqUuYdN4QQ7kNvwE1xxTb&_nc_oc=Ado9kRO5tuh6BY1aCUYnXkT9hn1hcw3JhQG2GhTqDlTvc2CCQsOxfTbg6cGTKuTT-_0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8qFMpMLitPdza_UXbYQheazm_Bnx-op4W4ELLA3oJyLA&oe=6A3AACAF"}, {"file_name": "Print 5.png", "id": "921050275807580", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974548_921050279140913_846272164452751718_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V1SDDRwN53MQ7kNvwFrjulf&_nc_oc=AdoFOAi-tjwNHws26tCs_s9_LYo2IX1t5r62I-c3Erwlj7smBDPTW8UH1gSiKEhgsu8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9evJFUvt5H37GZIsRchYnKqkibiYzdR1JisS9HzEE4dw&oe=6A3A9F97"}, {"file_name": "Print 2.png", "id": "1288706015050300", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75641339_1288706018383633_3836298053771559642_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=70aRoKQA8J4Q7kNvwH8egrs&_nc_oc=AdoaXsW57hm8HWwZ3OOb24kVb57IzFSfNTFBUYn6Pjh8yq5aEsqpaslz5mrB9WQ1x3c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-k58Std9HcwM9LEEtn6kSFJdtKqamLERs8FDRAy3eLEQ&oe=6A3AA951"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Final v.0.1 (eeve).png", "id": "945385240225978", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974721_945385243559311_50820886768660782_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fkGb5h1bEtAQ7kNvwE2qXTZ&_nc_oc=AdqzLQI-rsxB-zd97duWvakBOKtEKGWPyzph38MKOn5JxZFQwt1mjVeQRTba0QKhfuQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Z4LQJV8pA5oD6blYsqybNWcBDfZtooo1_y-m0gpP5nw&oe=6A3AAEFC"}, "display_name": "My Room", "keywords": [], "long_description": "My Room is the game experience that allows you to interact with your friends and also create your own world.\n\nCustomize your character and explore our two game modes: Playground & My Room.\n\nIn the Playground you will find yourself in a multiplayer environment surrounded by minigames that are available to play with others. These games include:\n- Soccer: score as many goals as you can\n- Air Hockey (Arcade): play with the AI or with another player\n- Basketball (Arcade): throw the balls and try to score points\n- Cornhole (Arcade): have fun trying to score as you play with the bean bags\n- Darts (Arcade): practice your aiming in the available stations\n- Mini Golf (Arcade): try to aim the hole at the mini golf courses\nThe multiplayer also includes voice/text chat for you to communicate with other players\n\nWhen in My Room, you will be able to customize your own space. You can choose between 3 different themed templates, explore and change it the way you prefer.\n\n* Find more information about the gameplay itself the app*\n\nUpcoming updates in the near future:\n- Game monetary system\n- Shop\n- More games\n- More rooms\n\nHave fun!", "short_description": "Play minigames along with your friends in a multiplayer environment or explore and customize your own room with this experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vresearchlab.com/privacy-policy/", "developer_terms_of_service_url": "https://vresearchlab.com/terms-of-use/", "publisher_name": "VResearch Lab", "support_website_url": null, "website_url": "https://vresearchlab.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "ex
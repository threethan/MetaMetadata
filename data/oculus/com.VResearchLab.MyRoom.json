r print.png", "id": "246912787875696", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031311_246912791209029_5540108180063733703_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L_vEV6zSvs0Q7kNvwHxqoh2&_nc_oc=AdoN_h6RiBd-amkZghkUXYaxy1zSIPM0LwPBtA8p3XZRmrPryQiak93akRHJoDgNd3s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4rRZJqrK7cWcWT50B3-wUtZMc-jAJVGo-I7rdK7vAfsg&oe=69FCA46E"}, {"file_name": "Print 3.png", "id": "2170405556482566", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572950_2170405559815899_5420058398011207589_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_2PcVD769NMQ7kNvwH48bP3&_nc_oc=AdpB2ec1Gt5W1vgZSHbPiGUHOnYaJ7pyJV57P7E-kaQJncdFVAvGrxSz-XCo-eqalNs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7fGBr1SVRmRjOIWYMCTgYR9BHG65Xy_-SKGYzyAyTuuQ&oe=69FC7DEF"}, {"file_name": "Print 5.png", "id": "921050275807580", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974548_921050279140913_846272164452751718_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GCg25U8OJHgQ7kNvwHPaYpp&_nc_oc=AdoGvYpzkkJiXcC1dBnZ8FkolZHFLp9h_LPK8yvbO25xi3512d7ouwipX04bfyoUKt0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af67f27oexvH4PVK3X-VbfEyooqmuEJELF6oHeEJ7XDdIw&oe=69FCA917"}, {"file_name": "Print 2.png", "id": "1288706015050300", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75641339_1288706018383633_3836298053771559642_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aoqLA_E0rlgQ7kNvwFNMq3t&_nc_oc=AdpRLye_5IOJqM4SsWtajW7EuB-z5hioWrtygEG_mD1PEpfF2F-naeEPyHIBUcNkgYU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Gsi3YwFDqKSccvaUl9KlmTZKEaeFbGIhejZI94MOQow&oe=69FCB2D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Final v.0.1 (eeve).png", "id": "945385240225978", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974721_945385243559311_50820886768660782_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iv6blYTbycUQ7kNvwFotwZE&_nc_oc=AdrcEiH-xATtuL8_0I_4143BTSKue1vThh7ze3Fx5IUDEfil62VMetPMMDraCu0DkXk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6IcR7CANFEYQyR-bfToWLxjYOkRfsByooQwoRih9-Q3g&oe=69FC803C"}, "display_name": "My Room", "keywords": [], "long_description": "My Room is the game experience that allows you to interact with your friends and also create your own world.\n\nCustomize your character and explore our two game modes: Playground & My Room.\n\nIn the Playground you will find yourself in a multiplayer environment surrounded by minigames that are available to play with others. These games include:\n- Soccer: score as many goals as you can\n- Air Hockey (Arcade): play with the AI or with another player\n- Basketball (Arcade): throw the balls and try to score points\n- Cornhole (Arcade): have fun trying to score as you play with the bean bags\n- Darts (Arcade): practice your aiming in the available stations\n- Mini Golf (Arcade): try to aim the hole at the mini golf courses\nThe multiplayer also includes voice/text chat for you to communicate with other players\n\nWhen in My Room, you will be able to customize your own space. You can choose between 3 different themed templates, explore and change it the way you prefer.\n\n* Find more information about the gameplay itself the app*\n\nUpcoming updates in the near future:\n- Game monetary system\n- Shop\n- More games\n- More rooms\n\nHave fun!", "short_description": "Play minigames along with your friends in a multiplayer environment or explore and customize your own room with this experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vresearchlab.com/privacy-policy/", "developer_terms_of_service_url": "https://vresearchlab.com/terms-of-use/", "publisher_name": "VResearch Lab", "support_website_url": null, "website_url": "https://vresearchlab.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "ex
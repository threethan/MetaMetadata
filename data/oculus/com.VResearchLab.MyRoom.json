5696", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031311_246912791209029_5540108180063733703_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aKPakfHKas8Q7kNvwGUez-V&_nc_oc=Adn7K56eOq3J8R6XqxOxoPFMpG9osylMEjl50W1Dr1_9D1NSCAJfogtgpXLz368sgU4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyZFKNyFf3DlDjhAkS_mitWP4bmnlVO4ClXsf3OVoD26A&oe=69AEA3AE"}, {"file_name": "Print 3.png", "id": "2170405556482566", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572950_2170405559815899_5420058398011207589_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MLuM6wmHxcsQ7kNvwHyej53&_nc_oc=AdnJIwdm79oyYV1Rb7roiOREnSPU427MgpSb7wro7k6Nv1TG2v1H7Y4w3Sf10YVWcx4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzehNum9k93plFNzqCKqDIy6Rp2dvX_tKEZir9fAR3viw&oe=69AEB56F"}, {"file_name": "Print 5.png", "id": "921050275807580", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974548_921050279140913_846272164452751718_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0FF1v6RQcgEQ7kNvwFxY9nl&_nc_oc=Adk4_AIcrMpycWbP3DpugFWqFDSNxKvcNeFlzigfaOOiogh0mCutL2c6j0vhhf6mdfY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyeLH4DNeLXMwBAugDa0390JIZup2x8hOai8KGuBJQnWQ&oe=69AEA857"}, {"file_name": "Print 2.png", "id": "1288706015050300", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75641339_1288706018383633_3836298053771559642_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UwlrSqSxHksQ7kNvwEv4Ey-&_nc_oc=Adnz-BVSI03-5GLoGK1PTjHwJ4l0Omkt8shIohJsaCBb_VgQs12u3supl1AHRkItgU8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzOiqrC1iZwzdPTyfNeWw1gIbDf99HOzdzYHVV7PANk1g&oe=69AEB211"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Final v.0.1 (eeve).png", "id": "945385240225978", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974721_945385243559311_50820886768660782_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vb1qAXNnMqYQ7kNvwHCV8g-&_nc_oc=Adkuzr31TQAemuszaog0axDdG5IZ9GU3DN79nMQcfrRPQwQeDr_o0RxGfh8g2_WlyUA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzKx_4Pdw_OhB_eBMU8akdqX-jBUeMlkc01Rgw_MsACig&oe=69AEB7BC"}, "display_name": "My Room", "keywords": [], "long_description": "My Room is the game experience that allows you to interact with your friends and also create your own world.\n\nCustomize your character and explore our two game modes: Playground & My Room.\n\nIn the Playground you will find yourself in a multiplayer environment surrounded by minigames that are available to play with others. These games include:\n- Soccer: score as many goals as you can\n- Air Hockey (Arcade): play with the AI or with another player\n- Basketball (Arcade): throw the balls and try to score points\n- Cornhole (Arcade): have fun trying to score as you play with the bean bags\n- Darts (Arcade): practice your aiming in the available stations\n- Mini Golf (Arcade): try to aim the hole at the mini golf courses\nThe multiplayer also includes voice/text chat for you to communicate with other players\n\nWhen in My Room, you will be able to customize your own space. You can choose between 3 different themed templates, explore and change it the way you prefer.\n\n* Find more information about the gameplay itself the app*\n\nUpcoming updates in the near future:\n- Game monetary system\n- Shop\n- More games\n- More rooms\n\nHave fun!", "short_description": "Play minigames along with your friends in a multiplayer environment or explore and customize your own room with this experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vresearchlab.com/privacy-policy/", "developer_terms_of_service_url": "https://vresearchlab.com/terms-of-use/", "publisher_name": "VResearch Lab", "support_website_url": null, "website_url": "https://vresearchlab.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres":
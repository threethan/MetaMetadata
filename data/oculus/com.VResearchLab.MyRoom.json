r print.png", "id": "246912787875696", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031311_246912791209029_5540108180063733703_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-GKu11RyBagQ7kNvwHOTj81&_nc_oc=AdomFBuwbbuzR6h39lPrCDWJIWV7CsTip4_WBzLWY4_SP2xE5AsuGPmWX3ftcOZMe9I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Zf0MRiZOAOKPPuL8xAcFTJ0cDffcbVL8wPb_UQ3akzg&oe=69DA5D6E"}, {"file_name": "Print 3.png", "id": "2170405556482566", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572950_2170405559815899_5420058398011207589_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OEH8HQ49xE4Q7kNvwFBVx00&_nc_oc=AdqSXgTESioMiO1pIEcYvEujWMY3w0unzMbdeAToho-Ea9qgz195ox-oDkCYzzJgpQk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0lUG9jHA3MNVtDctGqf-43r30zt43Wt0vvqbPGRtfWBw&oe=69DA36EF"}, {"file_name": "Print 5.png", "id": "921050275807580", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974548_921050279140913_846272164452751718_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HRI3-oi0Gv8Q7kNvwG3NvZX&_nc_oc=AdouU2bcLCUqua-HLdtVKBhfk20AsmqEC8QMT8Bjcurk5py1gquqojPKkKPjGtVZS0w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1EZkJQp0nFZDkhGRZASZb4HwgWNHpt9Tf_aPumrEWO3A&oe=69DA6217"}, {"file_name": "Print 2.png", "id": "1288706015050300", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75641339_1288706018383633_3836298053771559642_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4FIuQ-Z1e10Q7kNvwGnnOJZ&_nc_oc=Adrt6O4eVFT9j6V2B-aHePSfYn3aAerkj14O0yCKgrti75Q04rLwqLotfd4do2d33ZY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Dd0pLhr0ThIXDBt8aCLVKDINGhVv9uC3dIDNkN-b8_A&oe=69DA3391"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Final v.0.1 (eeve).png", "id": "945385240225978", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974721_945385243559311_50820886768660782_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5xf3r7J8O2UQ7kNvwEBOm42&_nc_oc=AdpDsmOuV5k_DfgAec_49SgNJZWVrf7uJTFpoglNaoH6_xaQCjdcgVPONYB2kPGXfjQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ia3t_E1022iXWXMa87Z-UjPr8NT6PPDvCa_w3-dTX2g&oe=69DA393C"}, "display_name": "My Room", "keywords": [], "long_description": "My Room is the game experience that allows you to interact with your friends and also create your own world.\n\nCustomize your character and explore our two game modes: Playground & My Room.\n\nIn the Playground you will find yourself in a multiplayer environment surrounded by minigames that are available to play with others. These games include:\n- Soccer: score as many goals as you can\n- Air Hockey (Arcade): play with the AI or with another player\n- Basketball (Arcade): throw the balls and try to score points\n- Cornhole (Arcade): have fun trying to score as you play with the bean bags\n- Darts (Arcade): practice your aiming in the available stations\n- Mini Golf (Arcade): try to aim the hole at the mini golf courses\nThe multiplayer also includes voice/text chat for you to communicate with other players\n\nWhen in My Room, you will be able to customize your own space. You can choose between 3 different themed templates, explore and change it the way you prefer.\n\n* Find more information about the gameplay itself the app*\n\nUpcoming updates in the near future:\n- Game monetary system\n- Shop\n- More games\n- More rooms\n\nHave fun!", "short_description": "Play minigames along with your friends in a multiplayer environment or explore and customize your own room with this experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vresearchlab.com/privacy-policy/", "developer_terms_of_service_url": "https://vresearchlab.com/terms-of-use/", "publisher_name": "VResearch Lab", "support_website_url": null, "website_url": "https://vresearchlab.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "ex
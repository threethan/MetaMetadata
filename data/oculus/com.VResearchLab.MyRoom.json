r print.png", "id": "246912787875696", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031311_246912791209029_5540108180063733703_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tpEJCYHLmMQQ7kNvwHl2x4H&_nc_oc=AdojkgEPKPU6B-g5wcknYlN6D5IO1uYrzPm2bnM0TVbbxevte9LFNKTcNrkAeT26lIQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7F52A8FQqQFu4OvXNJODQs4zSBEbPayHj-XUMAYvmOQg&oe=6A203CEE"}, {"file_name": "Print 3.png", "id": "2170405556482566", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57572950_2170405559815899_5420058398011207589_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XBymTCb-lwYQ7kNvwGJsfC7&_nc_oc=AdppPLJ0t03Lb0iCUQEZTXvWGTXeWQUBK3EyVQwrGP1n8EoEa7nOogl3D0agFviv9mY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5FmuWDWZfw0DVEFIGPNWMhluwvcSdHiow_xc5khnlBHQ&oe=6A204EAF"}, {"file_name": "Print 5.png", "id": "921050275807580", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974548_921050279140913_846272164452751718_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HQmRGPHx5jUQ7kNvwH_vXwN&_nc_oc=AdpwjquSX7PfG7pFi7jPbuSa6oeOikjwtFX5ZCjboD47z-U7qwMddxr2kkKfKT5r8Ac&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6MnC9F6ITdi7isBTrzNpSZFJyeNu50LWyyHz1htDUbOQ&oe=6A204197"}, {"file_name": "Print 2.png", "id": "1288706015050300", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75641339_1288706018383633_3836298053771559642_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=65NOtGY-iuwQ7kNvwHQpaEu&_nc_oc=AdqOfPTqXV5LJa0wgVn8GNqPZFcbUbQZDeyiKf7FULDNA_MwbWB6QPPe7oCx5Ganilo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af48nejcuHA4KDddn2ac_blwr3OyQBpkSDT6AIqcgVYZyg&oe=6A204B51"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Final v.0.1 (eeve).png", "id": "945385240225978", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974721_945385243559311_50820886768660782_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nIt5EW7S4_gQ7kNvwHvTKcP&_nc_oc=Adrvdb_G8eorZXIADWeek9Duf0K22_EWBD-8l-TX-cFoGi43EUoQhV_ht4yuObaslhs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4-O0lP7zuC8HXu8srTto4faotR0lkaCSug-aXVpj_t_w&oe=6A2050FC"}, "display_name": "My Room", "keywords": [], "long_description": "My Room is the game experience that allows you to interact with your friends and also create your own world.\n\nCustomize your character and explore our two game modes: Playground & My Room.\n\nIn the Playground you will find yourself in a multiplayer environment surrounded by minigames that are available to play with others. These games include:\n- Soccer: score as many goals as you can\n- Air Hockey (Arcade): play with the AI or with another player\n- Basketball (Arcade): throw the balls and try to score points\n- Cornhole (Arcade): have fun trying to score as you play with the bean bags\n- Darts (Arcade): practice your aiming in the available stations\n- Mini Golf (Arcade): try to aim the hole at the mini golf courses\nThe multiplayer also includes voice/text chat for you to communicate with other players\n\nWhen in My Room, you will be able to customize your own space. You can choose between 3 different themed templates, explore and change it the way you prefer.\n\n* Find more information about the gameplay itself the app*\n\nUpcoming updates in the near future:\n- Game monetary system\n- Shop\n- More games\n- More rooms\n\nHave fun!", "short_description": "Play minigames along with your friends in a multiplayer environment or explore and customize your own room with this experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vresearchlab.com/privacy-policy/", "developer_terms_of_service_url": "https://vresearchlab.com/terms-of-use/", "publisher_name": "VResearch Lab", "support_website_url": null, "website_url": "https://vresearchlab.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "ex
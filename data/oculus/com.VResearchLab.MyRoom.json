r print.png", "id": "246912787875696", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031311_246912791209029_5540108180063733703_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bIGuxawSPKUQ7kNvwGAnY4I&_nc_oc=AdohBgYLlky4R_TxT-BBqAAkTPxaqdTlAnbtFKissCB0wL3hfOo3UUMREoVfqX8Ateo&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOKBkMk0eA136Fo8lcTNryFj6Eg9eq7QtlfqAK2RYetXw&oe=6AE35AEE"}, {"file_name": "Print 3.png", "id": "2170405556482566", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/57572950_2170405559815899_5420058398011207589_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XX1igbIlHBUQ7kNvwExil28&_nc_oc=Adps12DerbmuC3fQ_poSIA4Hjk_KC2qjWfbb7m_6YVa4KkmY06_23-CGptyI5IKJmVg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMgqKYAbh_slWb6eHQVQAUHliFremvlcJ4lOStQhHMClQ&oe=6AE36CAF"}, {"file_name": "Print 5.png", "id": "921050275807580", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974548_921050279140913_846272164452751718_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LRyz7EriJUQQ7kNvwFqSvpy&_nc_oc=AdqEmJaj4vzFRNx9QeT7ReRG50TheAtiu0A92_BKpu6qVbR6Tdt0hd7Zv-fBkSUCP6k&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOa4t65VxG2cPu-IXbTnjAvtOsfF20ZHwCNf2HK41Xu3w&oe=6AE35F97"}, {"file_name": "Print 2.png", "id": "1288706015050300", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75641339_1288706018383633_3836298053771559642_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BRTi2QIPjM4Q7kNvwG792Nm&_nc_oc=AdpIjEy-g6h86aKEMGH2-tKQ0DqAy-csg1TO_LmeIlJMtgrizaTFRSAJ8vd_v1gXkvw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQONhSiZZISo6m8ogwDKDd89AUWeso-Kqck03LL8avjyOg&oe=6AE36951"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Final v.0.1 (eeve).png", "id": "945385240225978", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974721_945385243559311_50820886768660782_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zvEg5KRvR5AQ7kNvwFGLETk&_nc_oc=AdpD7Lx8mSlClKGEjsN6CT8U5aQkSz_Wxxi9WWaFZCwHVAzl_ULaT507umzVFoCAFkQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOO7_dm6iXE4MkEUWyr-tGMTaS12t4ENf1q0C20lgb4tg&oe=6AE336BC"}, "display_name": "My Room", "keywords": [], "long_description": "My Room is the game experience that allows you to interact with your friends and also create your own world.\n\nCustomize your character and explore our two game modes: Playground & My Room.\n\nIn the Playground you will find yourself in a multiplayer environment surrounded by minigames that are available to play with others. These games include:\n- Soccer: score as many goals as you can\n- Air Hockey (Arcade): play with the AI or with another player\n- Basketball (Arcade): throw the balls and try to score points\n- Cornhole (Arcade): have fun trying to score as you play with the bean bags\n- Darts (Arcade): practice your aiming in the available stations\n- Mini Golf (Arcade): try to aim the hole at the mini golf courses\nThe multiplayer also includes voice/text chat for you to communicate with other players\n\nWhen in My Room, you will be able to customize your own space. You can choose between 3 different themed templates, explore and change it the way you prefer.\n\n* Find more information about the gameplay itself the app*\n\nUpcoming updates in the near future:\n- Game monetary system\n- Shop\n- More games\n- More rooms\n\nHave fun!", "short_description": "Play minigames along with your friends in a multiplayer environment or explore and customize your own room with this experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vresearchlab.com/privacy-policy/", "developer_terms_of_service_url": "https://vresearchlab.com/terms-of-use/", "publisher_name": "VResearch Lab", "support_website_url": null, "website_url": "https://vresearchlab.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "ex
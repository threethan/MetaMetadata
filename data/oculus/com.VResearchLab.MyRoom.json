311_246912791209029_5540108180063733703_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6x2uUQ_5GqIQ7kNvwHabhPr&_nc_oc=Adkgk9K_zEDKY54KOGfnL-uG1dRpXXkfz74ZwhEjN1oB9At_8PU-uWPbLiMF5LbXU44&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afssz79YCIVasnIaHwsyAWmIrKqa1Xn8pykqgXaaOh5doQ&oe=69A1ACEE"}, {"file_name": "Print 3.png", "id": "2170405556482566", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/57572950_2170405559815899_5420058398011207589_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4MU-ssMRCy4Q7kNvwFN27w-&_nc_oc=AdkQpWM1xt-UDi4vRgJzORs5NSHAG5Z5W-cHz3Zmx7tYmfaXMPf5IA9_lLN6KpPBwbU&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfsnyG5NuJd7LLuhFcmkAQ-SRRizpRM0ge_Lv21ngiCEBA&oe=69A1866F"}, {"file_name": "Print 5.png", "id": "921050275807580", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974548_921050279140913_846272164452751718_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gmIlZotXKagQ7kNvwEI6R8R&_nc_oc=Adk3LnwlumHrLjXyLXFwaFwSB9GuQvcuRiliu9PlICXWwIvqGY4Lu_GQ2_ybSL5PzV4&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Aftenpjo64QTzR8iYBccy5ZNvXhwSyZZy5FuuQiMnuRW5g&oe=69A17957"}, {"file_name": "Print 2.png", "id": "1288706015050300", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/75641339_1288706018383633_3836298053771559642_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gjgnOdw83jgQ7kNvwEHgFCF&_nc_oc=AdnhQEBM8Lee2plHuwX2cQ2UJqwfH6FeMZOYx49W_cjuVMnEPj_eOLtQGPDq-oWGTvA&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfvvlvnFjI4p40zbVJFUJO8Mdt9xdI43EBnZ2y4C4i7JYg&oe=69A18311"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Final v.0.1 (eeve).png", "id": "945385240225978", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974721_945385243559311_50820886768660782_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GbSwdkKxwhwQ7kNvwGAP0I6&_nc_oc=AdnPJjfpIDORt1Yly0PIOwH7BaEYJtrnujckRvlEQlvP0nOqFW8DLpmtcxmCpVg6Dcc&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfvDjtqeF4YH8InDBJADpfXHsgYpE1R18HPtOwre3qFIUg&oe=69A188BC"}, "display_name": "My Room", "keywords": [], "long_description": "My Room is the game experience that allows you to interact with your friends and also create your own world.\n\nCustomize your character and explore our two game modes: Playground & My Room.\n\nIn the Playground you will find yourself in a multiplayer environment surrounded by minigames that are available to play with others. These games include:\n- Soccer: score as many goals as you can\n- Air Hockey (Arcade): play with the AI or with another player\n- Basketball (Arcade): throw the balls and try to score points\n- Cornhole (Arcade): have fun trying to score as you play with the bean bags\n- Darts (Arcade): practice your aiming in the available stations\n- Mini Golf (Arcade): try to aim the hole at the mini golf courses\nThe multiplayer also includes voice/text chat for you to communicate with other players\n\nWhen in My Room, you will be able to customize your own space. You can choose between 3 different themed templates, explore and change it the way you prefer.\n\n* Find more information about the gameplay itself the app*\n\nUpcoming updates in the near future:\n- Game monetary system\n- Shop\n- More games\n- More rooms\n\nHave fun!", "short_description": "Play minigames along with your friends in a multiplayer environment or explore and customize your own room with this experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vresearchlab.com/privacy-policy/", "developer_terms_of_service_url": "https://vresearchlab.com/terms-of-use/", "publisher_name": "VResearch Lab", "support_website_url": null, "website_url": "https://vresearchlab.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null
r print.png", "id": "246912787875696", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031311_246912791209029_5540108180063733703_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rZJsExUGHxoQ7kNvwFO5XKd&_nc_oc=AdrQem3w7Rodr_C3FgshXQvwhAQcxIqmf4E5xijUWE5aoavy203N0tT_cGadBVVtqA0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XP2xXbfCFBux-5mUokHhiWY4HaJgcKfggcdLoqOzhLA&oe=6A2D6BEE"}, {"file_name": "Print 3.png", "id": "2170405556482566", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572950_2170405559815899_5420058398011207589_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LOhDCWWCxBQQ7kNvwHNsZbF&_nc_oc=AdpY_u49cc1SdEHibIfhLDO0tFLrEiqEY3DyUB8aeANxaZZmeTnlPQJqWr8aWmdxEMI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_VlN9w9D21qt5HAEf2ms42Iy3VZFfIHNC2mQaG4Z9lKg&oe=6A2D7DAF"}, {"file_name": "Print 5.png", "id": "921050275807580", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974548_921050279140913_846272164452751718_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i6sLy1alz5gQ7kNvwGnbym6&_nc_oc=Adoa0KeVRCCvVg7Kc3nDdXfPtCdnDOGkt1xmN2kcPh9bisWtZHB7FjuJXiwUsVD2vqE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-wnlDav6erHhGnhi2KaOPLigRVMTBQsLbP_flbAtGw7g&oe=6A2D7097"}, {"file_name": "Print 2.png", "id": "1288706015050300", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75641339_1288706018383633_3836298053771559642_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vGuqXkhTP-4Q7kNvwFxl9q7&_nc_oc=Adp0zNI5r5OyuUXELuxztqWDZo_LRd0POJ1viZSZsPf3q6D9gw_IinZ6k75vZ3GLc4A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_xhPb7YE1vxFdk_7MmXiZOcL7SvB6v1i3R3HkeBv0KpA&oe=6A2D7A51"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Final v.0.1 (eeve).png", "id": "945385240225978", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974721_945385243559311_50820886768660782_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E8GkQpWWV0kQ7kNvwGUUbSn&_nc_oc=AdqJsr-wKRJrH9Qx3pUciMsBjvwjLx9MVN6Rt0yjKZmNdL8LhFVJ64IqTu9e4TikfOI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9PoP6eb8OUvbrAxbUpDiBBt4KPjer7_qPDigG0hLfu7Q&oe=6A2D7FFC"}, "display_name": "My Room", "keywords": [], "long_description": "My Room is the game experience that allows you to interact with your friends and also create your own world.\n\nCustomize your character and explore our two game modes: Playground & My Room.\n\nIn the Playground you will find yourself in a multiplayer environment surrounded by minigames that are available to play with others. These games include:\n- Soccer: score as many goals as you can\n- Air Hockey (Arcade): play with the AI or with another player\n- Basketball (Arcade): throw the balls and try to score points\n- Cornhole (Arcade): have fun trying to score as you play with the bean bags\n- Darts (Arcade): practice your aiming in the available stations\n- Mini Golf (Arcade): try to aim the hole at the mini golf courses\nThe multiplayer also includes voice/text chat for you to communicate with other players\n\nWhen in My Room, you will be able to customize your own space. You can choose between 3 different themed templates, explore and change it the way you prefer.\n\n* Find more information about the gameplay itself the app*\n\nUpcoming updates in the near future:\n- Game monetary system\n- Shop\n- More games\n- More rooms\n\nHave fun!", "short_description": "Play minigames along with your friends in a multiplayer environment or explore and customize your own room with this experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vresearchlab.com/privacy-policy/", "developer_terms_of_service_url": "https://vresearchlab.com/terms-of-use/", "publisher_name": "VResearch Lab", "support_website_url": null, "website_url": "https://vresearchlab.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "ex
r print.png", "id": "246912787875696", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031311_246912791209029_5540108180063733703_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UfbwjHWfemYQ7kNvwH7cSwr&_nc_oc=AdroIrHiaAnIUQ48-COIAwLuh5O3cqWopqXPLUl1EPlLv46mDXCPpJM1z6bUn9UFyZM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0OOCTipxNGnQGq-U2lU-kTXNllv4pGQf-SryH52WZxcw&oe=69E0F4EE"}, {"file_name": "Print 3.png", "id": "2170405556482566", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572950_2170405559815899_5420058398011207589_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q7OkBNtOdjYQ7kNvwF3ADJK&_nc_oc=AdpgG4W8N2_poea_E4wUkHFtExQUMjzpDhgTAoxo7Hk4lu584Q3KAEgXWP2P3XJTr64&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2xrF28ZSvTEXILYvqu4TzrdtWSnRBucFNihMarzSo9Zg&oe=69E0CE6F"}, {"file_name": "Print 5.png", "id": "921050275807580", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974548_921050279140913_846272164452751718_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4LeoV3dWdIMQ7kNvwH0yyJx&_nc_oc=AdoM2PQRKdoZ8jVk7yz4kXYPEiI50UwketlLq5oU3vpgbtAwjcT82fRvoPXXKPY3lkg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0x1hnVAo8WqPRuSIpQhadHDzyaROf6K9h2IG7RDDapzw&oe=69E0F997"}, {"file_name": "Print 2.png", "id": "1288706015050300", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75641339_1288706018383633_3836298053771559642_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QySNQEY26tEQ7kNvwFypFWE&_nc_oc=Adqqrf16uqweCpy_HHNmfeipYcL1X9Freq4di4IF4xer80fHszmlkHJ_Yo4UwQp4Vtw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0cbHUsFJGvK-Rfp1Zl0mZ5DXx7jBheSVIFdrwIiFgOow&oe=69E0CB11"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Final v.0.1 (eeve).png", "id": "945385240225978", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974721_945385243559311_50820886768660782_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QmroJinpJmgQ7kNvwEVzY7r&_nc_oc=AdpVqd2yUq8Ex1WXWpa-ZkASB-wDdBWsDXIGbFVOYZZ9vOKOEK9GxWkqXF-PFjUSJi0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0iKISVqaJXw8nvAD9OTxBdrnN8ptGzI7APk1C6aEvBGQ&oe=69E0D0BC"}, "display_name": "My Room", "keywords": [], "long_description": "My Room is the game experience that allows you to interact with your friends and also create your own world.\n\nCustomize your character and explore our two game modes: Playground & My Room.\n\nIn the Playground you will find yourself in a multiplayer environment surrounded by minigames that are available to play with others. These games include:\n- Soccer: score as many goals as you can\n- Air Hockey (Arcade): play with the AI or with another player\n- Basketball (Arcade): throw the balls and try to score points\n- Cornhole (Arcade): have fun trying to score as you play with the bean bags\n- Darts (Arcade): practice your aiming in the available stations\n- Mini Golf (Arcade): try to aim the hole at the mini golf courses\nThe multiplayer also includes voice/text chat for you to communicate with other players\n\nWhen in My Room, you will be able to customize your own space. You can choose between 3 different themed templates, explore and change it the way you prefer.\n\n* Find more information about the gameplay itself the app*\n\nUpcoming updates in the near future:\n- Game monetary system\n- Shop\n- More games\n- More rooms\n\nHave fun!", "short_description": "Play minigames along with your friends in a multiplayer environment or explore and customize your own room with this experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vresearchlab.com/privacy-policy/", "developer_terms_of_service_url": "https://vresearchlab.com/terms-of-use/", "publisher_name": "VResearch Lab", "support_website_url": null, "website_url": "https://vresearchlab.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "ex
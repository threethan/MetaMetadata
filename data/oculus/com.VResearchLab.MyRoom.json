r print.png", "id": "246912787875696", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031311_246912791209029_5540108180063733703_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RCvTTo4l2fUQ7kNvwF1E9yc&_nc_oc=Adqt62GWuFSwno8pLRmTjZXJGrZ_kMBf8KnrQYYT0Q2ihEw4rsY9OIUxzfhBp5J_esI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPqGSNHGLEBdm8SUvWvCo8hT4SZfeJHQTJbqDEsWCnvMw&oe=6ACE42EE"}, {"file_name": "Print 3.png", "id": "2170405556482566", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572950_2170405559815899_5420058398011207589_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3bxqLwCin2EQ7kNvwEFikg-&_nc_oc=AdqUTwSdoGmNVkEiEpkAs_CdUYo6SAm-4GlwAVDpQ1V4wfCjhWjW4xLOXvadhuLCAE8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPyCH3NpIpFn3oO8sPScRNfGXm5rdmLwM2f5eBLes9COg&oe=6ACE54AF"}, {"file_name": "Print 5.png", "id": "921050275807580", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974548_921050279140913_846272164452751718_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lz2EhVGJA24Q7kNvwEVmBA1&_nc_oc=Adq8lBe1M4oEs6qs08qbHIzsjAzWifTRFQjQfNND87LbwmtkeLx1284tSqmN-M1mt2Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPeDGkOS4SeDJkXD-Irl9ZuzgDr3r8Ql_ipoRI2uLSfeA&oe=6ACE4797"}, {"file_name": "Print 2.png", "id": "1288706015050300", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75641339_1288706018383633_3836298053771559642_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X5Ve4rS2p7oQ7kNvwHsAZBf&_nc_oc=AdqoqTzKhcMZeGRt2n4RCO7kAeYWazRxrlxWZUBNyR3NYK6oypOy5k3ovEpg8ws72BA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7L3j5vrHr7Ozo2kyOfvPQARcTFfTgojLO2eTuLe0jcg&oe=6ACE5151"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Final v.0.1 (eeve).png", "id": "945385240225978", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974721_945385243559311_50820886768660782_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9L0AV4qRt6IQ7kNvwHNMP_D&_nc_oc=Adp6Q21Ot4eWN5ZG5uWgJ3SBevq2OarR8K2ZS-ypsN1su3jroe3Ysb3XvW0K0M_65DI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMhaqZsof42SvMDpQ9627VqSvKDevKYWXa5EmzxPNd3Ug&oe=6ACE56FC"}, "display_name": "My Room", "keywords": [], "long_description": "My Room is the game experience that allows you to interact with your friends and also create your own world.\n\nCustomize your character and explore our two game modes: Playground & My Room.\n\nIn the Playground you will find yourself in a multiplayer environment surrounded by minigames that are available to play with others. These games include:\n- Soccer: score as many goals as you can\n- Air Hockey (Arcade): play with the AI or with another player\n- Basketball (Arcade): throw the balls and try to score points\n- Cornhole (Arcade): have fun trying to score as you play with the bean bags\n- Darts (Arcade): practice your aiming in the available stations\n- Mini Golf (Arcade): try to aim the hole at the mini golf courses\nThe multiplayer also includes voice/text chat for you to communicate with other players\n\nWhen in My Room, you will be able to customize your own space. You can choose between 3 different themed templates, explore and change it the way you prefer.\n\n* Find more information about the gameplay itself the app*\n\nUpcoming updates in the near future:\n- Game monetary system\n- Shop\n- More games\n- More rooms\n\nHave fun!", "short_description": "Play minigames along with your friends in a multiplayer environment or explore and customize your own room with this experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vresearchlab.com/privacy-policy/", "developer_terms_of_service_url": "https://vresearchlab.com/terms-of-use/", "publisher_name": "VResearch Lab", "support_website_url": null, "website_url": "https://vresearchlab.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "ex
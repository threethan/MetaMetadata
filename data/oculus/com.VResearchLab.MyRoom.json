r print.png", "id": "246912787875696", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031311_246912791209029_5540108180063733703_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L_vEV6zSvs0Q7kNvwFoxKbb&_nc_oc=Ado03SbPWl_5vF27y1qx8kPlCkGcAie7cVmnum8lPgqcKRsHp8zNrlrfQLtH_tYXU2s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4PnCoKv8wkiwXeHSxlD58FoT9b0GoOlDCTGpR8bGsAkA&oe=69FB52EE"}, {"file_name": "Print 3.png", "id": "2170405556482566", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572950_2170405559815899_5420058398011207589_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_2PcVD769NMQ7kNvwHFMCom&_nc_oc=AdrFmBfLTlMbaLJypjVotTNohHxLGUOibt5P6gtJp0luFUjM7YVgUuQZMlvDyoRyACg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Dlx7QQrPjk0nC0bjYExGU2pl_QW_rmqQOo_zk5IA34A&oe=69FB2C6F"}, {"file_name": "Print 5.png", "id": "921050275807580", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974548_921050279140913_846272164452751718_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GCg25U8OJHgQ7kNvwGCUYQ5&_nc_oc=AdruXhUEf5kaEuABJcd6Ly2xZlmLY7YDatsxvHIZ0SppeUVYlt9DbRbFQFEBDfM1Eiw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7rSG6bugcyKTP7v3sp4DmNcryskDjp_GPj9nIjWIF-EA&oe=69FB5797"}, {"file_name": "Print 2.png", "id": "1288706015050300", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75641339_1288706018383633_3836298053771559642_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aoqLA_E0rlgQ7kNvwFk6fXx&_nc_oc=AdoPQXrjX2TD2h8a7TVdqOwtZwj27bXUiD5SHGtPFUYiOoK7l-BquYws7YwvA1VpuVQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4g-j7sYgdKdnDHc8ZKpVeiLQc-_6Pcgc-O-bNX4d8A_Q&oe=69FB2911"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Final v.0.1 (eeve).png", "id": "945385240225978", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974721_945385243559311_50820886768660782_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iiev9chUxAAQ7kNvwF_vtTC&_nc_oc=Adoh_KWFh106-16DUFMaq4JSBjNUde481bWBYeSjY30A5rsdRtAHla_f_-Tt2ZKag3Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ip-ls46gQbSOmftjIzZvnDPLFZMqqjMnCSOTxNopUig&oe=69FB2EBC"}, "display_name": "My Room", "keywords": [], "long_description": "My Room is the game experience that allows you to interact with your friends and also create your own world.\n\nCustomize your character and explore our two game modes: Playground & My Room.\n\nIn the Playground you will find yourself in a multiplayer environment surrounded by minigames that are available to play with others. These games include:\n- Soccer: score as many goals as you can\n- Air Hockey (Arcade): play with the AI or with another player\n- Basketball (Arcade): throw the balls and try to score points\n- Cornhole (Arcade): have fun trying to score as you play with the bean bags\n- Darts (Arcade): practice your aiming in the available stations\n- Mini Golf (Arcade): try to aim the hole at the mini golf courses\nThe multiplayer also includes voice/text chat for you to communicate with other players\n\nWhen in My Room, you will be able to customize your own space. You can choose between 3 different themed templates, explore and change it the way you prefer.\n\n* Find more information about the gameplay itself the app*\n\nUpcoming updates in the near future:\n- Game monetary system\n- Shop\n- More games\n- More rooms\n\nHave fun!", "short_description": "Play minigames along with your friends in a multiplayer environment or explore and customize your own room with this experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vresearchlab.com/privacy-policy/", "developer_terms_of_service_url": "https://vresearchlab.com/terms-of-use/", "publisher_name": "VResearch Lab", "support_website_url": null, "website_url": "https://vresearchlab.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "ex
r print.png", "id": "246912787875696", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031311_246912791209029_5540108180063733703_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t-CiucBXgLUQ7kNvwHK07aT&_nc_oc=AdrIELUQQD1X4uDiPKhZvBOfk5H8-4ATsmuYIULmTrYCRla8Iqe-jmqcES31bvp9jfk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfvBELJEDGOY7bq_urPQ-iLi6la6XEk7ELT2z-nhsakg&oe=6A9986EE"}, {"file_name": "Print 3.png", "id": "2170405556482566", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572950_2170405559815899_5420058398011207589_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ghIDgAVw5MQ7kNvwHJXwmT&_nc_oc=Adq_zTgvkKYyDQ9ITQkFTv55MZKaeB2Qs_aYjuSWzSswGDWvCCvjF4cFBpBRHVpaI0Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6zc2CzdoXxSCBvymb8FjPNUVGK_vniborJsUwe8qftw&oe=6A9998AF"}, {"file_name": "Print 5.png", "id": "921050275807580", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974548_921050279140913_846272164452751718_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lnSuLtDh4zUQ7kNvwFUvYgm&_nc_oc=AdrjtJVcwpe0HJMRRU1jgHN3CeUs1sh6or3n_U_HjGPHi9KUp5PsD0HeHOMDkL77t0s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkup_xLnDGrkk1tZUPeK5wVe2VKnDqGAi_uO11EanlKw&oe=6A998B97"}, {"file_name": "Print 2.png", "id": "1288706015050300", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75641339_1288706018383633_3836298053771559642_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5-Ms-RtePhkQ7kNvwG-1OJT&_nc_oc=AdqpO8sF7fmg8liEGUhQWrGyYNQV8ZDq2NxR8YuZfh-mRePATCee553YJxP88WPuBzA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZgjraH1oKzSxu49a9rOgf2hHTkO4sWotBswIcwQu9jA&oe=6A999551"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Final v.0.1 (eeve).png", "id": "945385240225978", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974721_945385243559311_50820886768660782_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oDsSW9pKNxEQ7kNvwFtmQb3&_nc_oc=AdoQOUEOSduwpidgzBdxb1VbrE6O3d4gh2Z-_xuuC-OxP2WJfqNyHm3klc2fQXFAaK8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIsQzAEX6rNtdd-BPSIXiCICcQ2u87WDy8zrTA4MuXPAA&oe=6A999AFC"}, "display_name": "My Room", "keywords": [], "long_description": "My Room is the game experience that allows you to interact with your friends and also create your own world.\n\nCustomize your character and explore our two game modes: Playground & My Room.\n\nIn the Playground you will find yourself in a multiplayer environment surrounded by minigames that are available to play with others. These games include:\n- Soccer: score as many goals as you can\n- Air Hockey (Arcade): play with the AI or with another player\n- Basketball (Arcade): throw the balls and try to score points\n- Cornhole (Arcade): have fun trying to score as you play with the bean bags\n- Darts (Arcade): practice your aiming in the available stations\n- Mini Golf (Arcade): try to aim the hole at the mini golf courses\nThe multiplayer also includes voice/text chat for you to communicate with other players\n\nWhen in My Room, you will be able to customize your own space. You can choose between 3 different themed templates, explore and change it the way you prefer.\n\n* Find more information about the gameplay itself the app*\n\nUpcoming updates in the near future:\n- Game monetary system\n- Shop\n- More games\n- More rooms\n\nHave fun!", "short_description": "Play minigames along with your friends in a multiplayer environment or explore and customize your own room with this experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vresearchlab.com/privacy-policy/", "developer_terms_of_service_url": "https://vresearchlab.com/terms-of-use/", "publisher_name": "VResearch Lab", "support_website_url": null, "website_url": "https://vresearchlab.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "ex
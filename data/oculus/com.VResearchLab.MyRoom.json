r print.png", "id": "246912787875696", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031311_246912791209029_5540108180063733703_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UhqQAW_Y-U8Q7kNvwEqVifN&_nc_oc=AdqyaJubwF8w0lwx-4NiPqJO5Bg72q7G7xrjpw4kmKo5fbsmYanSRdhPeP28KLn12LM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxfqIURsQSUn1u130KPEsEgQoV8Bz5988fWLc7TnZ8cAQ&oe=69CFD16E"}, {"file_name": "Print 3.png", "id": "2170405556482566", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57572950_2170405559815899_5420058398011207589_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=adhSUsVWeq0Q7kNvwFk_nFD&_nc_oc=AdoAnrT2vyp20xpCFmjR6KGg20Z2nL8r7kVQvw8msYlcx3S_ZQo7s7WeTVrbZElcfik&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyAHEL7mgI9hDZ5ogRjbJcoFpHyDyyjbBUJQSoFA0DTXQ&oe=69CFAAEF"}, {"file_name": "Print 5.png", "id": "921050275807580", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974548_921050279140913_846272164452751718_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sHpBVnyTuJYQ7kNvwGedwIz&_nc_oc=AdqAj8x92IPvTT8SAdXuT86r4oqW8rC8g8hUIXMDe217WZZJ4fgZ7QmT3h0R__ZTtWM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx1h5Q8-lciHQY8DYN_txnPU9F8f2i8UEakDQiAP5M2KQ&oe=69CF9DD7"}, {"file_name": "Print 2.png", "id": "1288706015050300", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75641339_1288706018383633_3836298053771559642_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ZBpSxLjkKMQ7kNvwGyiCYK&_nc_oc=AdqPOnfcR8GerFpkXJe91Lus_13KFLIXBfHE6f2XHMyZDfpvAYWSnwx89fabQ7p348U&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyYXDvqkD_YPfIAWorWIOycuQPHc_y8M7Ft2xuvZCBhPg&oe=69CFA791"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Final v.0.1 (eeve).png", "id": "945385240225978", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974721_945385243559311_50820886768660782_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AVLsyXy-bXAQ7kNvwFBbBUG&_nc_oc=AdqO7QVxmkufe9xXTHyDdUr6IfAD8egfzOQ1s08P54AGiF80iZrC5mbjzhNhajtiVFw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfySlU0sgpvU-6MfK3ETEvqi6y_xq-xoZ2LK3QiGz0hkCg&oe=69CFAD3C"}, "display_name": "My Room", "keywords": [], "long_description": "My Room is the game experience that allows you to interact with your friends and also create your own world.\n\nCustomize your character and explore our two game modes: Playground & My Room.\n\nIn the Playground you will find yourself in a multiplayer environment surrounded by minigames that are available to play with others. These games include:\n- Soccer: score as many goals as you can\n- Air Hockey (Arcade): play with the AI or with another player\n- Basketball (Arcade): throw the balls and try to score points\n- Cornhole (Arcade): have fun trying to score as you play with the bean bags\n- Darts (Arcade): practice your aiming in the available stations\n- Mini Golf (Arcade): try to aim the hole at the mini golf courses\nThe multiplayer also includes voice/text chat for you to communicate with other players\n\nWhen in My Room, you will be able to customize your own space. You can choose between 3 different themed templates, explore and change it the way you prefer.\n\n* Find more information about the gameplay itself the app*\n\nUpcoming updates in the near future:\n- Game monetary system\n- Shop\n- More games\n- More rooms\n\nHave fun!", "short_description": "Play minigames along with your friends in a multiplayer environment or explore and customize your own room with this experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vresearchlab.com/privacy-policy/", "developer_terms_of_service_url": "https://vresearchlab.com/terms-of-use/", "publisher_name": "VResearch Lab", "support_website_url": null, "website_url": "https://vresearchlab.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "ex
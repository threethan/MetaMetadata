311_246912791209029_5540108180063733703_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wzE0An5m7-UQ7kNvwG4iJbb&_nc_oc=AdnRgzWHNoLoDiY8JCDexz9TG-q_sxJhC2s1hbCRb-zZrkaT5D7V2Q9Y3rQUNfYMdaE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afu4ulMbBxmI5qDkJGYl1G_IMX-TpY9HdXBQ2EFcJId5-Q&oe=6998726E"}, {"file_name": "Print 3.png", "id": "2170405556482566", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57572950_2170405559815899_5420058398011207589_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0sorJH1mkysQ7kNvwFQpjD5&_nc_oc=AdlulViHCxyzToamZr1iDvE0wK7psESrMPWpIgaFFBFHMW6ZGkgN5Bmb-TXmg0qff2s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afs6eFka8oZYRoSnKklZVGzcyqgHG2ixRrJrEicYrmJFXg&oe=69984BEF"}, {"file_name": "Print 5.png", "id": "921050275807580", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974548_921050279140913_846272164452751718_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E2As3SfexywQ7kNvwG3xiGZ&_nc_oc=AdnhMX7YpajDuoG3nWA8cZrn9MbONJeS6ht0uFZ4u6z80yLjf5V1fSR_24ikXHPcBYY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftrlCl77mgzeeOsDS_TMEqAdv5LoNgA6twdbe4TuYeFgg&oe=69983ED7"}, {"file_name": "Print 2.png", "id": "1288706015050300", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75641339_1288706018383633_3836298053771559642_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kiax3jjW7DYQ7kNvwFQaWkb&_nc_oc=AdkSFHMuD3Ha2EJLKvGZIJBEOpLmJ_UvjCrZx7VqaSc7syRjMpiWIIyMxggSrtAVcbs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvYZ_vFVA1GOPo0Ss63AoYUEgKuuVSO90iLvxgtBT3eHQ&oe=69984891"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Final v.0.1 (eeve).png", "id": "945385240225978", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974721_945385243559311_50820886768660782_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LOvUkXg58HEQ7kNvwH8HOca&_nc_oc=Adm9tG83W7yZiAqz3Ffj4FzD4THABBQaU6vjb1uO1qRoIbhfFLjBUzJGozES94XfoF0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsDXfp27IpBQsEzEG-ZoSjFtQJhsdLZduyyQLk4GLl0zA&oe=69984E3C"}, "display_name": "My Room", "keywords": [], "long_description": "My Room is the game experience that allows you to interact with your friends and also create your own world.\n\nCustomize your character and explore our two game modes: Playground & My Room.\n\nIn the Playground you will find yourself in a multiplayer environment surrounded by minigames that are available to play with others. These games include:\n- Soccer: score as many goals as you can\n- Air Hockey (Arcade): play with the AI or with another player\n- Basketball (Arcade): throw the balls and try to score points\n- Cornhole (Arcade): have fun trying to score as you play with the bean bags\n- Darts (Arcade): practice your aiming in the available stations\n- Mini Golf (Arcade): try to aim the hole at the mini golf courses\nThe multiplayer also includes voice/text chat for you to communicate with other players\n\nWhen in My Room, you will be able to customize your own space. You can choose between 3 different themed templates, explore and change it the way you prefer.\n\n* Find more information about the gameplay itself the app*\n\nUpcoming updates in the near future:\n- Game monetary system\n- Shop\n- More games\n- More rooms\n\nHave fun!", "short_description": "Play minigames along with your friends in a multiplayer environment or explore and customize your own room with this experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vresearchlab.com/privacy-policy/", "developer_terms_of_service_url": "https://vresearchlab.com/terms-of-use/", "publisher_name": "VResearch Lab", "support_website_url": null, "website_url": "https://vresearchlab.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null
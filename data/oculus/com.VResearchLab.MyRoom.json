5696", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031311_246912791209029_5540108180063733703_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4CRZQJ9rZ5IQ7kNvwEqdnpL&_nc_oc=AdlGreF9GUgxocnsnq_CLn0GLjda6R707ZuUILBQAUsKZr4KDfw91k5jN-kktiOc2YI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afzya96t-zeYrfWGhIKpyUBa3TBrhM_kgycC_w8Dy1k5gQ&oe=69BC0AEE"}, {"file_name": "Print 3.png", "id": "2170405556482566", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572950_2170405559815899_5420058398011207589_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qfDcNu2cUBkQ7kNvwFwqjLP&_nc_oc=AdllK6_AJXxCgPgmtn6ZGTrQK-ZApyNUZk6GOhia4er8wi0SMQQqZ4KnkUmYCydOzg4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxuAunBgFWccl5LJMJkKyLF3x60Z2oz-eJNleD7CmKiIA&oe=69BBE46F"}, {"file_name": "Print 5.png", "id": "921050275807580", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974548_921050279140913_846272164452751718_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j3z_5SEsalQQ7kNvwFZmRK3&_nc_oc=AdlYidLG_epOBUse85ivjLKlf5bPO02lPkGGvQjFZJjrYhMOmPwG8UXLsxlFUj5EWZM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy7qiUNU88ZPwPvi1d_vSaKglwqZlyI6GnC-VbLfw30QQ&oe=69BC0F97"}, {"file_name": "Print 2.png", "id": "1288706015050300", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75641339_1288706018383633_3836298053771559642_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g_GQjmWh1b4Q7kNvwHgHotr&_nc_oc=AdkOFsroLdrzFsRkzP3ysjUALq2cGQeH9kBvg4gyATzYRfXDUPr_xTE1TlRjwrAZKfE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afyh9q1TU3vFHujMl8EJliIuZj4JF0RMWD-mqBbNGaAm3Q&oe=69BBE111"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Final v.0.1 (eeve).png", "id": "945385240225978", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974721_945385243559311_50820886768660782_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FUSYP1O5Am4Q7kNvwFxeCom&_nc_oc=AdmQqjhsn7Ahl5lkatFY56yxzMXLjsA2WecAhXZKGCdTVE-YkwMN0qZpg_9B8eyYvjc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfztUhl8HyklclNPeLM02a2jYjRe-Y3DyJ_BL-0zJYn6Kg&oe=69BBE6BC"}, "display_name": "My Room", "keywords": [], "long_description": "My Room is the game experience that allows you to interact with your friends and also create your own world.\n\nCustomize your character and explore our two game modes: Playground & My Room.\n\nIn the Playground you will find yourself in a multiplayer environment surrounded by minigames that are available to play with others. These games include:\n- Soccer: score as many goals as you can\n- Air Hockey (Arcade): play with the AI or with another player\n- Basketball (Arcade): throw the balls and try to score points\n- Cornhole (Arcade): have fun trying to score as you play with the bean bags\n- Darts (Arcade): practice your aiming in the available stations\n- Mini Golf (Arcade): try to aim the hole at the mini golf courses\nThe multiplayer also includes voice/text chat for you to communicate with other players\n\nWhen in My Room, you will be able to customize your own space. You can choose between 3 different themed templates, explore and change it the way you prefer.\n\n* Find more information about the gameplay itself the app*\n\nUpcoming updates in the near future:\n- Game monetary system\n- Shop\n- More games\n- More rooms\n\nHave fun!", "short_description": "Play minigames along with your friends in a multiplayer environment or explore and customize your own room with this experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vresearchlab.com/privacy-policy/", "developer_terms_of_service_url": "https://vresearchlab.com/terms-of-use/", "publisher_name": "VResearch Lab", "support_website_url": null, "website_url": "https://vresearchlab.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres":
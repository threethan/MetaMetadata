311_246912791209029_5540108180063733703_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XESRx-aU7p8Q7kNvwE-jcfd&_nc_oc=AdlG8On3SuFY57GX1MYkf1sXYZwhffbVN4MtJa2vwrI4O47GsxestACB8YpDtbnJBzA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvy5JACIsl3VavXlABuzfP3dWmXE-pCAo5xd6BbiYF9mA&oe=699D802E"}, {"file_name": "Print 3.png", "id": "2170405556482566", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572950_2170405559815899_5420058398011207589_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FivKK0IjhW0Q7kNvwEi8T9w&_nc_oc=AdnKZgJ0dntK3uUjXihs00xzUzsigclmaLyyusb6f04K2VFKkJ9g7bvJyY3Jr96f9SI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftfcXq9oR6VJuAb_CEPzZ1HnLlEgiWXjBCNsS9QvZLCqQ&oe=699D91EF"}, {"file_name": "Print 5.png", "id": "921050275807580", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974548_921050279140913_846272164452751718_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8NL-7mBatmsQ7kNvwFxOuCA&_nc_oc=AdnVduepwv5-YQvsRO6s6IoivycdgJjVkRjHLaCbn2HyJfE1e60U1Uzq0o60HDd4MmY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftBSRv38l3q0nvNU9Xc86JjFhVKwMcJ4s5VLWh1cSQbHQ&oe=699D84D7"}, {"file_name": "Print 2.png", "id": "1288706015050300", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75641339_1288706018383633_3836298053771559642_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QMt9QXPcwNoQ7kNvwE0xl6L&_nc_oc=AdmB2gE8kkjX1zZKZu_dhDmNL12Uda35L2o6Uff-z_hSfXs8lJ7sbS8saegdkd3fZyY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvEyzjUWNNB0Apz_xbG2DUwzHA8hhwVbNO2GsBWVLueVA&oe=699D8E91"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Final v.0.1 (eeve).png", "id": "945385240225978", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974721_945385243559311_50820886768660782_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q2rYWHFsASYQ7kNvwHmuIfk&_nc_oc=Admy56wKA1trM1hD1-ConUHxLkCsfMPX734uCRCBLokOMS4g6ruV0TmE5tjjqYx2qtg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuLUc4NBJy5k7u1FnrUkV4_ky6XMWhNMKO2R5bgnvWt7g&oe=699D943C"}, "display_name": "My Room", "keywords": [], "long_description": "My Room is the game experience that allows you to interact with your friends and also create your own world.\n\nCustomize your character and explore our two game modes: Playground & My Room.\n\nIn the Playground you will find yourself in a multiplayer environment surrounded by minigames that are available to play with others. These games include:\n- Soccer: score as many goals as you can\n- Air Hockey (Arcade): play with the AI or with another player\n- Basketball (Arcade): throw the balls and try to score points\n- Cornhole (Arcade): have fun trying to score as you play with the bean bags\n- Darts (Arcade): practice your aiming in the available stations\n- Mini Golf (Arcade): try to aim the hole at the mini golf courses\nThe multiplayer also includes voice/text chat for you to communicate with other players\n\nWhen in My Room, you will be able to customize your own space. You can choose between 3 different themed templates, explore and change it the way you prefer.\n\n* Find more information about the gameplay itself the app*\n\nUpcoming updates in the near future:\n- Game monetary system\n- Shop\n- More games\n- More rooms\n\nHave fun!", "short_description": "Play minigames along with your friends in a multiplayer environment or explore and customize your own room with this experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vresearchlab.com/privacy-policy/", "developer_terms_of_service_url": "https://vresearchlab.com/terms-of-use/", "publisher_name": "VResearch Lab", "support_website_url": null, "website_url": "https://vresearchlab.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null
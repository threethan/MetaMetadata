r print.png", "id": "246912787875696", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031311_246912791209029_5540108180063733703_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wNvGEyrfFY4Q7kNvwF5seGq&_nc_oc=AdoVJr1uG55r_-K-m8FLMKpBqIdAHim2yslSHKZmEJYSoGjSYWFO8qlbOo-GMe3OCCk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOS0uYTxk9y13XWl97kwK08DCZBbvtB0vuSyAxdNFIThw&oe=6AE2096E"}, {"file_name": "Print 3.png", "id": "2170405556482566", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57572950_2170405559815899_5420058398011207589_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FI4yUbT1g-sQ7kNvwEoFWb2&_nc_oc=Adolv2WhpNmUWRVB_35b7Tt77bhDhG5lKjd7KKuujgjgzSgTCIU2XwJ0Ub1qc2WO7EI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOsQwoBQRInFnSnqeFyPmqV_jINdhCJj_SpcW-rwzPkJw&oe=6AE21B2F"}, {"file_name": "Print 5.png", "id": "921050275807580", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974548_921050279140913_846272164452751718_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SRwiiU-a6_0Q7kNvwHKU-AG&_nc_oc=AdqATQOnbo4dE6KUUpPM-8O1ZSqv8t20LIgsU2QtAi3ivfSXrLEnqEKtS8II4hCT-70&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMPgZzRLxuX7hldVw5DhW2uT1GEpdSC512MvyB2AJGRlw&oe=6AE20E17"}, {"file_name": "Print 2.png", "id": "1288706015050300", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75641339_1288706018383633_3836298053771559642_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lSjP7GvuOfAQ7kNvwFa8GR7&_nc_oc=AdpNYVXprnzuks692QnA3g6-M_5h89QWIZmGcHJguhyAaWItvYadujdHyKad3lRXPbM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMXhB64Tf7EtPOazMxWw3s0JbPyZ_vjt89jKUKCCz2V9A&oe=6AE217D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Final v.0.1 (eeve).png", "id": "945385240225978", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974721_945385243559311_50820886768660782_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zvEg5KRvR5AQ7kNvwFav8Mi&_nc_oc=AdqqJSNz_rgoRuVp_Ub1oNqLhcrZ3tRBuOulLR3EwcDGi_0mRce_SxnD-_3Xa84DogE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPiXiMFzvTwzaMLss4Z88ykkFixSCWHPNrLCpbo5yS4HQ&oe=6AE21D7C"}, "display_name": "My Room", "keywords": [], "long_description": "My Room is the game experience that allows you to interact with your friends and also create your own world.\n\nCustomize your character and explore our two game modes: Playground & My Room.\n\nIn the Playground you will find yourself in a multiplayer environment surrounded by minigames that are available to play with others. These games include:\n- Soccer: score as many goals as you can\n- Air Hockey (Arcade): play with the AI or with another player\n- Basketball (Arcade): throw the balls and try to score points\n- Cornhole (Arcade): have fun trying to score as you play with the bean bags\n- Darts (Arcade): practice your aiming in the available stations\n- Mini Golf (Arcade): try to aim the hole at the mini golf courses\nThe multiplayer also includes voice/text chat for you to communicate with other players\n\nWhen in My Room, you will be able to customize your own space. You can choose between 3 different themed templates, explore and change it the way you prefer.\n\n* Find more information about the gameplay itself the app*\n\nUpcoming updates in the near future:\n- Game monetary system\n- Shop\n- More games\n- More rooms\n\nHave fun!", "short_description": "Play minigames along with your friends in a multiplayer environment or explore and customize your own room with this experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vresearchlab.com/privacy-policy/", "developer_terms_of_service_url": "https://vresearchlab.com/terms-of-use/", "publisher_name": "VResearch Lab", "support_website_url": null, "website_url": "https://vresearchlab.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "ex
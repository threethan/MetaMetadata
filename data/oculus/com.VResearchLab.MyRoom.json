1207589_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m5wnuoCS3YIQ7kNvwHNeq-r&_nc_oc=Adrqn8YzUsTfAwa_lDRyoRaFLDziWo_r5SxxCMZuMr0a9nKEquReXOqJPt2QDn6VAuI&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHjyqpQPQsqspdUQBkWufRu4dTI0mqKsb9RAx5mTt2LCg&oe=6A8599EF"}, {"file_name": "Print 4.png", "id": "220651490621410", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974904_220651493954743_4634282644435104952_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GW6W5vBfzPoQ7kNvwGT7ypM&_nc_oc=Adqovt6JK5I0JmvUbl2sqVSrxIx6fXv09ArlIMuYnv5Q3HW9n05_xb7FBiFP2A3Vfxo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEqqW2hrWEEIERAniQHsZR7JIajWSR4XRDoCT9C36fd6w&oe=6A857A1C"}, {"file_name": "Print 5.png", "id": "921050275807580", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974548_921050279140913_846272164452751718_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x0Xsh_SN_D8Q7kNvwEc4d0U&_nc_oc=AdrKM6dNePgGOUW7XKUDzIV4bgH2pxM_pZEhg2JxMK7ZrF4bcW4BrUrAmS-dMpcCMdo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEltamPPmS7Jp6NC_MwAPwBjO8rbmNzBlbeuQ9zJwssTw&oe=6A858CD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Final v.0.1 (eeve).png", "id": "945385240225978", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974721_945385243559311_50820886768660782_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mzVXpGglA-kQ7kNvwHFFDO0&_nc_oc=AdoL1CIkvuaPnDeDg_VFmSN6xa17AVUKoSKUXjukrXRB6LHIoAZB-CalDQcOD-muUes&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFBlYJj9QlA9TW0hC2DKJnC7jjl_bTUOl-gYFwATfiB0g&oe=6A859C3C"}, "display_name": "My Room", "keywords": [], "long_description": "My Room is the game experience that allows you to interact with your friends and also create your own world.\n\nCustomize your character and explore our two game modes: Playground & My Room.\n\nIn the Playground you will find yourself in a multiplayer environment surrounded by minigames that are available to play with others. These games include:\n- Soccer: score as many goals as you can\n- Air Hockey (Arcade): play with the AI or with another player\n- Basketball (Arcade): throw the balls and try to score points\n- Cornhole (Arcade): have fun trying to score as you play with the bean bags\n- Darts (Arcade): practice your aiming in the available stations\n- Mini Golf (Arcade): try to aim the hole at the mini golf courses\nThe multiplayer also includes voice/text chat for you to communicate with other players\n\nWhen in My Room, you will be able to customize your own space. You can choose between 3 different themed templates, explore and change it the way you prefer.\n\n* Find more information about the gameplay itself the app*\n\nUpcoming updates in the near future:\n- Avatars\n- Game monetary system\n- Shop\n- More games\n- More rooms\n\nHave fun!", "short_description": "Play minigames along with your friends in a multiplayer environment or explore and customize your own room with this experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vresearchlab.com/privacy-policy/", "developer_terms_of_service_url": "https://vresearchlab.com/terms-of-use/", "publisher_name": "VResearch Lab", "support_website_url": null, "website_url": "https://vresearchlab.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "575409077551853"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "
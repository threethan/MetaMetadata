r print.png", "id": "246912787875696", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031311_246912791209029_5540108180063733703_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6py9EZ9l5-AQ7kNvwGn6i6R&_nc_oc=AdqRfy1Vqs2nKs4KLS96xU3JZCyfR9VGeC8ZkdjxqUEbU5Q6DmY9rM8vekQL3brEH7M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8PVNab5c9YqhI8Av8_s0CF-bRVc_CL4oX2ShLzwSAyPQ&oe=6A43D56E"}, {"file_name": "Print 3.png", "id": "2170405556482566", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572950_2170405559815899_5420058398011207589_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mG8HKrQpzd8Q7kNvwE5uzQZ&_nc_oc=AdrAlki_ZS4wqbC6NkMt0_xDccKYCTI9exHT-ReJo9PSIG1fnESVaepjM5fe2bRjMKE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ge35ihwQp4tz0h2M4hrvypVZrQlkrS2eeZHBxMM28PA&oe=6A43E72F"}, {"file_name": "Print 5.png", "id": "921050275807580", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974548_921050279140913_846272164452751718_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UbJUgiEyp88Q7kNvwGB1jfu&_nc_oc=AdrkQAcqFwo4QPzm56X6msFM961NNW3e_tjz-DcaUSW7wAFxA8QZH9R-lGG6ww2tUTc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9V-v91tCuWl-lVjiKl4u5Vc93O8iDNBXICFiaiLiXCHA&oe=6A43DA17"}, {"file_name": "Print 2.png", "id": "1288706015050300", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75641339_1288706018383633_3836298053771559642_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8exDArzls4MQ7kNvwFi2McG&_nc_oc=Adp3-HPQqCyeT51qpamxJEPHRhHtJWm_6-UGdsEF80GoOQi2nG4ODUIZ4xwZliLQ2cU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8MQV6UwKj_dgB0gpm4LctsxBKwDpnhe92uXBCuhLdMEQ&oe=6A43E3D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Final v.0.1 (eeve).png", "id": "945385240225978", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974721_945385243559311_50820886768660782_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6q2gcKi3CckQ7kNvwG-jnx9&_nc_oc=AdpDHBuoUDjq82mRWFp7P6cxMvPadzK3roezw2PtQd05rUP0Aerw8slJH0Mp6Pcjjdg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_AONs6VpJU_o2Ur4Krec9QF_2I_kT6JEv01gJFslFovg&oe=6A43E97C"}, "display_name": "My Room", "keywords": [], "long_description": "My Room is the game experience that allows you to interact with your friends and also create your own world.\n\nCustomize your character and explore our two game modes: Playground & My Room.\n\nIn the Playground you will find yourself in a multiplayer environment surrounded by minigames that are available to play with others. These games include:\n- Soccer: score as many goals as you can\n- Air Hockey (Arcade): play with the AI or with another player\n- Basketball (Arcade): throw the balls and try to score points\n- Cornhole (Arcade): have fun trying to score as you play with the bean bags\n- Darts (Arcade): practice your aiming in the available stations\n- Mini Golf (Arcade): try to aim the hole at the mini golf courses\nThe multiplayer also includes voice/text chat for you to communicate with other players\n\nWhen in My Room, you will be able to customize your own space. You can choose between 3 different themed templates, explore and change it the way you prefer.\n\n* Find more information about the gameplay itself the app*\n\nUpcoming updates in the near future:\n- Game monetary system\n- Shop\n- More games\n- More rooms\n\nHave fun!", "short_description": "Play minigames along with your friends in a multiplayer environment or explore and customize your own room with this experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vresearchlab.com/privacy-policy/", "developer_terms_of_service_url": "https://vresearchlab.com/terms-of-use/", "publisher_name": "VResearch Lab", "support_website_url": null, "website_url": "https://vresearchlab.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "ex
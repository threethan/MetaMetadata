r print.png", "id": "246912787875696", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031311_246912791209029_5540108180063733703_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dZ1D2d83QckQ7kNvwH6nqFw&_nc_oc=AdrGdjPJz945oiJa9NBRGQvc4A6Yh0JWMNyafjZb4lK3XmDGigc0B7ShYFqA3xYFZS0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0-SGuECBw8jfsaPR1wMfZGOB-trEKUOuqN1jcCwCJgKQ&oe=69E4E96E"}, {"file_name": "Print 3.png", "id": "2170405556482566", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572950_2170405559815899_5420058398011207589_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ck0tEmYg3VIQ7kNvwGwurqM&_nc_oc=AdovfRwHlJ25nPqW_Ye7SYtFiqc3rHmpey89brCpyH3YR2iQZ-8K83GD2jAwfM210gE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3UgHc-ZzVI7dmG5nb2J8YoOFaRbMjKAl8tpVg9Ow5jiQ&oe=69E4C2EF"}, {"file_name": "Print 5.png", "id": "921050275807580", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974548_921050279140913_846272164452751718_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JNnX3yIZAroQ7kNvwFjK7Bf&_nc_oc=AdrD1DI1kEzBRtGQnQZZzLFM711YazpylrDFZX0WRkChGBf7KyiQArLj4TpYBUkuXXQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3DCq6dMgJIVKpgC7M6g6pz0TxzVmrXt9xuQdrTUUm7hA&oe=69E4B5D7"}, {"file_name": "Print 2.png", "id": "1288706015050300", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75641339_1288706018383633_3836298053771559642_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=60Pg6k1W84YQ7kNvwFCVGEl&_nc_oc=AdoRefuZQ6FTgHCkrIqm0uC868JnSZiyRwr_IYAJoBC73eW3I1acNFYPZ6x1W7g6DbI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Y2MmwUEiQHYb60Xd8fLncKq6c-GM2HOYnoIg6al7Gcg&oe=69E4BF91"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Final v.0.1 (eeve).png", "id": "945385240225978", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974721_945385243559311_50820886768660782_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5MjkstiSts4Q7kNvwEYcfeD&_nc_oc=AdqQS-Z4IuTWkecdPIRMKC6pM2LbAGiuFdG8vxNk5ddUxRDu-W73F1VcywG0FmiCvEI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1iHQaMjyhDL2Ofbd2TX2X4RZXRaVahxdOKo3nDxMeFhA&oe=69E4C53C"}, "display_name": "My Room", "keywords": [], "long_description": "My Room is the game experience that allows you to interact with your friends and also create your own world.\n\nCustomize your character and explore our two game modes: Playground & My Room.\n\nIn the Playground you will find yourself in a multiplayer environment surrounded by minigames that are available to play with others. These games include:\n- Soccer: score as many goals as you can\n- Air Hockey (Arcade): play with the AI or with another player\n- Basketball (Arcade): throw the balls and try to score points\n- Cornhole (Arcade): have fun trying to score as you play with the bean bags\n- Darts (Arcade): practice your aiming in the available stations\n- Mini Golf (Arcade): try to aim the hole at the mini golf courses\nThe multiplayer also includes voice/text chat for you to communicate with other players\n\nWhen in My Room, you will be able to customize your own space. You can choose between 3 different themed templates, explore and change it the way you prefer.\n\n* Find more information about the gameplay itself the app*\n\nUpcoming updates in the near future:\n- Game monetary system\n- Shop\n- More games\n- More rooms\n\nHave fun!", "short_description": "Play minigames along with your friends in a multiplayer environment or explore and customize your own room with this experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vresearchlab.com/privacy-policy/", "developer_terms_of_service_url": "https://vresearchlab.com/terms-of-use/", "publisher_name": "VResearch Lab", "support_website_url": null, "website_url": "https://vresearchlab.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "ex
r print.png", "id": "246912787875696", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031311_246912791209029_5540108180063733703_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=diR__6Tpp78Q7kNvwGIK2_o&_nc_oc=AdoJT9QORpfH6_UXrjej4vk2yC42ly5lu2csvf-lj6dm7DuCMOoPZ_rOXK1NjXDdT7c&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1SW8h8HsHXfU4059j8LxpMw1J37vOk1SmdR_5AhDAAoQ&oe=69F60CEE"}, {"file_name": "Print 3.png", "id": "2170405556482566", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/57572950_2170405559815899_5420058398011207589_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AQK9-FAUu14Q7kNvwFh9hVp&_nc_oc=AdrwMoTuNpoRoKBHsGXNsu_sCw0GB99XAc5Yh6QfHCONkPkOsMzGJw8LzFnjp8ofmFc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0NJawSyEonxgHJC4m_rDRNiA8c4TtvY8QUsIjvfA0EmA&oe=69F5E66F"}, {"file_name": "Print 5.png", "id": "921050275807580", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974548_921050279140913_846272164452751718_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5OdsnUZI834Q7kNvwG_wDPK&_nc_oc=AdpZr2K8vYdq1xF64SQYpoUPByTvqEVsbZMXhrPggJXroNPmC8dQeliRNjz8y4tM0Bk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3sQ3R_PM1AV4RxPj2eJajLyvMzyvl0sH_ahgJnB-46zw&oe=69F61197"}, {"file_name": "Print 2.png", "id": "1288706015050300", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75641339_1288706018383633_3836298053771559642_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QhMi3CHYwWEQ7kNvwGb-QsL&_nc_oc=AdrYz0qpN7sZuxmX8C8ZLQgLGu50o0CtFhaS_bjOVpOIE_lmU9gXC81fDaw-cDsFL5E&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2YoySUj8TwRBS4ipZbC-yN-bAwcHHPUMjqhLQ9idnHkg&oe=69F61B51"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Final v.0.1 (eeve).png", "id": "945385240225978", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974721_945385243559311_50820886768660782_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=feMoqpOqGO4Q7kNvwG1iaPO&_nc_oc=AdrA0vwYAW8JKt7-ESdJdQWz68CJAGZYiI_O_LFkpuU_MbXHcZC9mhIrMAyGqfhVamU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af326fr80sHNHRxrMmx6w3TI5vVOZyqR8kcMBAew-I-eEA&oe=69F5E8BC"}, "display_name": "My Room", "keywords": [], "long_description": "My Room is the game experience that allows you to interact with your friends and also create your own world.\n\nCustomize your character and explore our two game modes: Playground & My Room.\n\nIn the Playground you will find yourself in a multiplayer environment surrounded by minigames that are available to play with others. These games include:\n- Soccer: score as many goals as you can\n- Air Hockey (Arcade): play with the AI or with another player\n- Basketball (Arcade): throw the balls and try to score points\n- Cornhole (Arcade): have fun trying to score as you play with the bean bags\n- Darts (Arcade): practice your aiming in the available stations\n- Mini Golf (Arcade): try to aim the hole at the mini golf courses\nThe multiplayer also includes voice/text chat for you to communicate with other players\n\nWhen in My Room, you will be able to customize your own space. You can choose between 3 different themed templates, explore and change it the way you prefer.\n\n* Find more information about the gameplay itself the app*\n\nUpcoming updates in the near future:\n- Game monetary system\n- Shop\n- More games\n- More rooms\n\nHave fun!", "short_description": "Play minigames along with your friends in a multiplayer environment or explore and customize your own room with this experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vresearchlab.com/privacy-policy/", "developer_terms_of_service_url": "https://vresearchlab.com/terms-of-use/", "publisher_name": "VResearch Lab", "support_website_url": null, "website_url": "https://vresearchlab.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "ex
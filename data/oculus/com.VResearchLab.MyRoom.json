r print.png", "id": "246912787875696", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031311_246912791209029_5540108180063733703_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7A_0kpeKbsAQ7kNvwFbLZzH&_nc_oc=AdrViim5g7-EZLlrXpRlELv-BfSuFpTUegJ13N0G5aTmZOM9gFFnbKPjqz-lWzdU0Sk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTt-OR47sRBbYq_Bot3jQ-i24g31Dnc9mO-04hLwDqpAQ&oe=6AF9C46E"}, {"file_name": "Print 3.png", "id": "2170405556482566", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/57572950_2170405559815899_5420058398011207589_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RvS5DuJoifEQ7kNvwG6PdsV&_nc_oc=AdqfCIuNP1dGzZ4vn0SUkrxDrMqVSihgTdWvrn1ISAa1jJjMzPOJiH7j1EPT1Iugmtc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQs4WAQCZ-yXxlTJn2Orijv7ZA8mGh77qO2YiMBRp07Hw&oe=6AF9D62F"}, {"file_name": "Print 5.png", "id": "921050275807580", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974548_921050279140913_846272164452751718_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fvN0K_fMRp8Q7kNvwH2xaCs&_nc_oc=AdpT4zw-qa3O3jn_C0HCEzZXGjsi0_Jb6XAS3tHulh6xJtOO6dgQuLatq3LWjNOtfZ0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGib9zGKL-1pl1y8pvuv3EV4TGlj1oQh53cp5MgurK7w&oe=6AF9C917"}, {"file_name": "Print 2.png", "id": "1288706015050300", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75641339_1288706018383633_3836298053771559642_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YCkDvoc5d3wQ7kNvwGk_EPr&_nc_oc=Adon82nh2wUUxDJwImPkUocIa_u0BJxyABVa18ni2rGogsBflF_3UpFDYbHaUkcHxk4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGdmEk2bAYJmAoPJySa7xSNd5-m9pjrF0fT1LA7b1wgQ&oe=6AF9D2D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Final v.0.1 (eeve).png", "id": "945385240225978", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974721_945385243559311_50820886768660782_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nSTPZuwdOz8Q7kNvwGlsWis&_nc_oc=AdrvQVr5gfanB1spGw6HOWQrfuDnXPbC-ApGlfrteluwAoBzXky0l1ima3PjPxO-jYY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7uHuhxQNVjQYoHA5q1bt1oS6irrd4PGb3NlwBilvRcg&oe=6AF9D87C"}, "display_name": "My Room", "keywords": [], "long_description": "My Room is the game experience that allows you to interact with your friends and also create your own world.\n\nCustomize your character and explore our two game modes: Playground & My Room.\n\nIn the Playground you will find yourself in a multiplayer environment surrounded by minigames that are available to play with others. These games include:\n- Soccer: score as many goals as you can\n- Air Hockey (Arcade): play with the AI or with another player\n- Basketball (Arcade): throw the balls and try to score points\n- Cornhole (Arcade): have fun trying to score as you play with the bean bags\n- Darts (Arcade): practice your aiming in the available stations\n- Mini Golf (Arcade): try to aim the hole at the mini golf courses\nThe multiplayer also includes voice/text chat for you to communicate with other players\n\nWhen in My Room, you will be able to customize your own space. You can choose between 3 different themed templates, explore and change it the way you prefer.\n\n* Find more information about the gameplay itself the app*\n\nUpcoming updates in the near future:\n- Game monetary system\n- Shop\n- More games\n- More rooms\n\nHave fun!", "short_description": "Play minigames along with your friends in a multiplayer environment or explore and customize your own room with this experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vresearchlab.com/privacy-policy/", "developer_terms_of_service_url": "https://vresearchlab.com/terms-of-use/", "publisher_name": "VResearch Lab", "support_website_url": null, "website_url": "https://vresearchlab.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "ex
://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031311_246912791209029_5540108180063733703_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5g4XH1WZ-B4Q7kNvwHR10T2&_nc_oc=AdpA9w9CsNYa7NnQMZ5IkomcFbsoH_VSwBRXoIMETEe8GzgFH_ZoPWp6kBIRazsb8hI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af2dwVUX0sAZ7s9RXdaXtdSKHwdSDfwFUK-9DnomnvPs4w&oe=69F2186E"}, {"file_name": "Print 3.png", "id": "2170405556482566", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57572950_2170405559815899_5420058398011207589_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sBYVu8D_oNUQ7kNvwGIZDZO&_nc_oc=AdrO19WDK-n3aySw-2COqY0q6g2U3cDtQ-8evdmSo-cMdA9vRk1K7iClCnY1rMV5alg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Han8n5PtY24frBtay-y8srE1C5mWKAEPjGiQk1vEKng&oe=69F1F1EF"}, {"file_name": "Print 5.png", "id": "921050275807580", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974548_921050279140913_846272164452751718_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wY-f17ASpFMQ7kNvwGaDlTy&_nc_oc=AdrvJXsTpkGRFuTYiDkeClPGlPGO9Z4ZQRD0j2H6CFygHoakD77IuwToYjvf2voDlx8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0GazTrvaGafiDfH8pxP-u5E4fqJSaxYY-JKrr1tIGbxQ&oe=69F1E4D7"}, {"file_name": "Print 2.png", "id": "1288706015050300", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75641339_1288706018383633_3836298053771559642_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RVrPZMBk9uQQ7kNvwG8ZvfY&_nc_oc=AdpAyfHuvDPbtoRLnqKdrvwfJNzLgWCLYkV03tiIOkw9lu2qvwsiwLess8O7JflVEAU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af1E9KYe7kTnJWI71cMjC132c7zDCKxYlXVVhIQzsSpvCA&oe=69F1EE91"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Final v.0.1 (eeve).png", "id": "945385240225978", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974721_945385243559311_50820886768660782_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s2wE6tkkzpQQ7kNvwHyw-ua&_nc_oc=AdrX_1BoKHaQfmF0j5XNOklR4fEA4YgGhy12_zKTesaoA8K1Ev6i8UXzicRW73fG1EY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af1wA-Po7IVz7zzEaWMcnRzLbRdP4NOM2ctOVov-Cy_nLg&oe=69F1F43C"}, "display_name": "My Room", "keywords": [], "long_description": "My Room is the game experience that allows you to interact with your friends and also create your own world.\n\nCustomize your character and explore our two game modes: Playground & My Room.\n\nIn the Playground you will find yourself in a multiplayer environment surrounded by minigames that are available to play with others. These games include:\n- Soccer: score as many goals as you can\n- Air Hockey (Arcade): play with the AI or with another player\n- Basketball (Arcade): throw the balls and try to score points\n- Cornhole (Arcade): have fun trying to score as you play with the bean bags\n- Darts (Arcade): practice your aiming in the available stations\n- Mini Golf (Arcade): try to aim the hole at the mini golf courses\nThe multiplayer also includes voice/text chat for you to communicate with other players\n\nWhen in My Room, you will be able to customize your own space. You can choose between 3 different themed templates, explore and change it the way you prefer.\n\n* Find more information about the gameplay itself the app*\n\nUpcoming updates in the near future:\n- Game monetary system\n- Shop\n- More games\n- More rooms\n\nHave fun!", "short_description": "Play minigames along with your friends in a multiplayer environment or explore and customize your own room with this experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vresearchlab.com/privacy-policy/", "developer_terms_of_service_url": "https://vresearchlab.com/terms-of-use/", "publisher_name": "VResearch Lab", "support_website_url": null, "website_url": "https://vresearchlab.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_
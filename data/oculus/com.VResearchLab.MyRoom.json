r print.png", "id": "246912787875696", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031311_246912791209029_5540108180063733703_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wiH3nq3ffIkQ7kNvwEAuICq&_nc_oc=Adre1aGlMxDf71wZ32XTJzUE6_s4bNSdUMnA1Hg4KKdaAHPhR76zeJItGcjDmbW4seI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwBORD5R-32VWowHCRcrydR7xr6IJ7iOueNveMdvMQkkg&oe=69C939EE"}, {"file_name": "Print 3.png", "id": "2170405556482566", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572950_2170405559815899_5420058398011207589_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L9SwTVpwzYUQ7kNvwFI1mJc&_nc_oc=AdqHlwWBaN6V8uYBTHTIvoxot6d81xox4qaQWol4Zrsw8oPMlAP6iy0l3ZApi1gG5f4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy3CXZsVfAdB2gmKKqoffDY4jFIcFxtahuXEG3xyjhwJQ&oe=69C9136F"}, {"file_name": "Print 5.png", "id": "921050275807580", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974548_921050279140913_846272164452751718_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Vi8ICsG1AMQ7kNvwHf-Apx&_nc_oc=AdqG_X2ru5611rmTRlo8rC0zkWxhghuaaONYzol70xvht9_paj_k1XW95xF6gnsH8rg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzd9FWVjV1UA1Dpkpbip19nwMUXQiDpdZO8aSq-yNiMGA&oe=69C90657"}, {"file_name": "Print 2.png", "id": "1288706015050300", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75641339_1288706018383633_3836298053771559642_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JPuRKQzxpOcQ7kNvwHbHHZY&_nc_oc=AdqIOaV4TtklJOksuH3XHyU0Hhq5clOryDtjp6UsqNoS2uPt1GAU4N6sHVkf54T4AHw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzJfBa5P-I8kNrxCTWD4ypZqGvnPRCPLwH_sG2gRQR3dA&oe=69C91011"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Final v.0.1 (eeve).png", "id": "945385240225978", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974721_945385243559311_50820886768660782_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iJnL9lu4SBYQ7kNvwHtiBvl&_nc_oc=AdrECGaN3f_ghqhRWwUsIw0FlSscfLSe0EcQMSEfqruZ10hjIXhpNR7gu2KaZD_ztp8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxhplDI1SWg2miEA8h-Gd5JPEJJBBCG2iwI2kE6VoGE-Q&oe=69C915BC"}, "display_name": "My Room", "keywords": [], "long_description": "My Room is the game experience that allows you to interact with your friends and also create your own world.\n\nCustomize your character and explore our two game modes: Playground & My Room.\n\nIn the Playground you will find yourself in a multiplayer environment surrounded by minigames that are available to play with others. These games include:\n- Soccer: score as many goals as you can\n- Air Hockey (Arcade): play with the AI or with another player\n- Basketball (Arcade): throw the balls and try to score points\n- Cornhole (Arcade): have fun trying to score as you play with the bean bags\n- Darts (Arcade): practice your aiming in the available stations\n- Mini Golf (Arcade): try to aim the hole at the mini golf courses\nThe multiplayer also includes voice/text chat for you to communicate with other players\n\nWhen in My Room, you will be able to customize your own space. You can choose between 3 different themed templates, explore and change it the way you prefer.\n\n* Find more information about the gameplay itself the app*\n\nUpcoming updates in the near future:\n- Game monetary system\n- Shop\n- More games\n- More rooms\n\nHave fun!", "short_description": "Play minigames along with your friends in a multiplayer environment or explore and customize your own room with this experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vresearchlab.com/privacy-policy/", "developer_terms_of_service_url": "https://vresearchlab.com/terms-of-use/", "publisher_name": "VResearch Lab", "support_website_url": null, "website_url": "https://vresearchlab.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "ex
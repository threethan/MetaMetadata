r print.png", "id": "246912787875696", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031311_246912791209029_5540108180063733703_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=epbXbna7Jd8Q7kNvwGiv0kc&_nc_oc=AdoB2cVVX772FL1xZjzqJP8Nw3ImtGmD1drtctoAcpDFm6plRBwrz9excbg47wUWijU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3tJBpUGbl1cVkwOLxJ5xeIGApJfw2Sh-yLBGLXsdpq0w&oe=69EB80EE"}, {"file_name": "Print 3.png", "id": "2170405556482566", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572950_2170405559815899_5420058398011207589_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sTEJPzH0BVEQ7kNvwG6MS94&_nc_oc=Adqwqr7TUVfZWGaOaXEXNVXxloYfEkaETmeIQhEPZTOF4OiJWWuEYE4tLNFVvikAVBw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3aUv8IfjvXnymOIbI37aLeQoFD7FQRp3shP5BFk3sakw&oe=69EB5A6F"}, {"file_name": "Print 5.png", "id": "921050275807580", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974548_921050279140913_846272164452751718_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y_0f-Om7PzoQ7kNvwGvf21S&_nc_oc=AdoD1LwRdAkpnuSxxxqGdNUzx5z0INm8vem4GNpNN8qo06nGF9uHqKkTqJtPa-ZWr00&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3HpwWZWyDcBzdlqBaQbLYUX6x_GNjQBRbIu32o54LvoQ&oe=69EB8597"}, {"file_name": "Print 2.png", "id": "1288706015050300", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75641339_1288706018383633_3836298053771559642_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=APw0RoMx9QIQ7kNvwHG6pgq&_nc_oc=AdrEodVWOwvfobsCdXHfx1t-r_vrtlw970TW75OPzwTpUc7PpFh_MHk2nCD8ykrPwrE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3yQvn9BkV2DeMx6_2xrHfCRy3pCGE1igO77BbYHpAsxQ&oe=69EB5711"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Final v.0.1 (eeve).png", "id": "945385240225978", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974721_945385243559311_50820886768660782_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2M2lA4T49YUQ7kNvwF0aqO-&_nc_oc=AdpE313jIoycU4lPPW5xELT6h684bdPV5SGjPJzfPA9GiNS2HuNdiu-pqBMQrJa_9mQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3J2Ps53E08mvuGqt3I6QKv1fDt0rw6865wRy92OpcbWg&oe=69EB5CBC"}, "display_name": "My Room", "keywords": [], "long_description": "My Room is the game experience that allows you to interact with your friends and also create your own world.\n\nCustomize your character and explore our two game modes: Playground & My Room.\n\nIn the Playground you will find yourself in a multiplayer environment surrounded by minigames that are available to play with others. These games include:\n- Soccer: score as many goals as you can\n- Air Hockey (Arcade): play with the AI or with another player\n- Basketball (Arcade): throw the balls and try to score points\n- Cornhole (Arcade): have fun trying to score as you play with the bean bags\n- Darts (Arcade): practice your aiming in the available stations\n- Mini Golf (Arcade): try to aim the hole at the mini golf courses\nThe multiplayer also includes voice/text chat for you to communicate with other players\n\nWhen in My Room, you will be able to customize your own space. You can choose between 3 different themed templates, explore and change it the way you prefer.\n\n* Find more information about the gameplay itself the app*\n\nUpcoming updates in the near future:\n- Game monetary system\n- Shop\n- More games\n- More rooms\n\nHave fun!", "short_description": "Play minigames along with your friends in a multiplayer environment or explore and customize your own room with this experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vresearchlab.com/privacy-policy/", "developer_terms_of_service_url": "https://vresearchlab.com/terms-of-use/", "publisher_name": "VResearch Lab", "support_website_url": null, "website_url": "https://vresearchlab.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "ex
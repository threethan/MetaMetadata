5696", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031311_246912791209029_5540108180063733703_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OB59p_hu750Q7kNvwEBSfAH&_nc_oc=Adk-Y_tC-EWoDFBhoxXIBrp7SeBZ3HsOdGs-Hye4AoYF9TIW9XmM-h5IXe7FoNGtRVg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Aftbs9vgVSa2xQWDSMtxWSab-LR18VtZN851wT3dat0nSw&oe=69A995EE"}, {"file_name": "Print 3.png", "id": "2170405556482566", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572950_2170405559815899_5420058398011207589_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CokaEJmSGgoQ7kNvwFOx5tD&_nc_oc=AdkkdrgRn9ZnPTZsNb9Yo0P7AsFGsYGxo9F3RhYz6xll-u5eAij5Ya3x-95ikZAkiQA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftJ5ru5UHdhN4qgcFFjYgOo72_Kp9yq8drdYVZGmJ436g&oe=69A96F6F"}, {"file_name": "Print 5.png", "id": "921050275807580", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974548_921050279140913_846272164452751718_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RW-47jtqh68Q7kNvwHHjyct&_nc_oc=AdltJ0SUMMluywu6BhkG93jeqSRZZAmK2J8m3Zh_joYu8c-_qldtCUaReKlSsEGA0ls&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvezPGkIarEiqBtDknzFGFus2giXRdztfZan5Z7-lA0kA&oe=69A96257"}, {"file_name": "Print 2.png", "id": "1288706015050300", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75641339_1288706018383633_3836298053771559642_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hGTknq9GlfYQ7kNvwEuhpyo&_nc_oc=AdkyVu1ruXW7apAUcyGf-vNtEqQBrraB2aac5hSaYx2LfQvJlEhq-iMHcRzm0-cKprw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afv1McgzwfssxyTOvPH3ksehFjkJ3YTy_Lcp6VBCrNo5-w&oe=69A96C11"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Final v.0.1 (eeve).png", "id": "945385240225978", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974721_945385243559311_50820886768660782_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ork4Iks19SgQ7kNvwHIdV3M&_nc_oc=Adm38Yi3rOoc2rQT4aB2tCuhbaPoR52XTj3-ZTo16wg8BD2o9m6KpvNsUBdRNicwblA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afs53MgdaJdIsGDPlMor6cwgngwOdrRNvO2cFKLzDiM1zA&oe=69A971BC"}, "display_name": "My Room", "keywords": [], "long_description": "My Room is the game experience that allows you to interact with your friends and also create your own world.\n\nCustomize your character and explore our two game modes: Playground & My Room.\n\nIn the Playground you will find yourself in a multiplayer environment surrounded by minigames that are available to play with others. These games include:\n- Soccer: score as many goals as you can\n- Air Hockey (Arcade): play with the AI or with another player\n- Basketball (Arcade): throw the balls and try to score points\n- Cornhole (Arcade): have fun trying to score as you play with the bean bags\n- Darts (Arcade): practice your aiming in the available stations\n- Mini Golf (Arcade): try to aim the hole at the mini golf courses\nThe multiplayer also includes voice/text chat for you to communicate with other players\n\nWhen in My Room, you will be able to customize your own space. You can choose between 3 different themed templates, explore and change it the way you prefer.\n\n* Find more information about the gameplay itself the app*\n\nUpcoming updates in the near future:\n- Game monetary system\n- Shop\n- More games\n- More rooms\n\nHave fun!", "short_description": "Play minigames along with your friends in a multiplayer environment or explore and customize your own room with this experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vresearchlab.com/privacy-policy/", "developer_terms_of_service_url": "https://vresearchlab.com/terms-of-use/", "publisher_name": "VResearch Lab", "support_website_url": null, "website_url": "https://vresearchlab.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres":
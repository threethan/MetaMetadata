311_246912791209029_5540108180063733703_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OB59p_hu750Q7kNvwF9HKoo&_nc_oc=AdmCdpEYArpdqfLNwj9PGW5q6QQzxNZahQfm9se_xpy-KOEawNXW981pqf-mVlNHYgc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvKiqInqnX_w6af3NspfLTKVSBZ5ashtn6mlkEIcQnX8A&oe=69A6F2EE"}, {"file_name": "Print 3.png", "id": "2170405556482566", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572950_2170405559815899_5420058398011207589_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CokaEJmSGgoQ7kNvwGBRITI&_nc_oc=AdkPtNMEwRjCV_oHBl44pjtjfcOzNWFt2NKFGKfkFDRdbMiIKmGJ7kdL2sBcKACpUpg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvYGWVbyvfoDlipwii-lqmrwCNiE8awMBivGg3AhbhJog&oe=69A6CC6F"}, {"file_name": "Print 5.png", "id": "921050275807580", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974548_921050279140913_846272164452751718_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RW-47jtqh68Q7kNvwESJzIY&_nc_oc=AdnQLj3U_zijI56YI1wE69l0x-z6W_Cu5W7BK-17UgZxBJtPVPeAjvLZgLW3IstXGfI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsE-eZA7gtcKWRV5Hin8wJ6T250TalrGTJLKoU8jb-9lQ&oe=69A6BF57"}, {"file_name": "Print 2.png", "id": "1288706015050300", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75641339_1288706018383633_3836298053771559642_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hGTknq9GlfYQ7kNvwEB3QZR&_nc_oc=AdnC1dvnj0YfHVkkSzUAWJ-aQFDsBJTSXpoX06NUE7ZmUv-Zo3J2csk-zCsVhgewoj4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvCr7Ab3pbSZExH4lHXKUeE89K7XY1JewwKbzukBngY_A&oe=69A6C911"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Final v.0.1 (eeve).png", "id": "945385240225978", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974721_945385243559311_50820886768660782_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EQNkMa63M-AQ7kNvwEMl7Sf&_nc_oc=Adl_HhMqSDZx0jszcYDcjZ6fl84z62MZTO8c4I3GkcoihDGlLZO86srtZzuRJ4JHoCI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsm1LnhQwlpb9Le6GCyxIEHLQb8xQ0KDvGH2n-_eRwWjg&oe=69A6CEBC"}, "display_name": "My Room", "keywords": [], "long_description": "My Room is the game experience that allows you to interact with your friends and also create your own world.\n\nCustomize your character and explore our two game modes: Playground & My Room.\n\nIn the Playground you will find yourself in a multiplayer environment surrounded by minigames that are available to play with others. These games include:\n- Soccer: score as many goals as you can\n- Air Hockey (Arcade): play with the AI or with another player\n- Basketball (Arcade): throw the balls and try to score points\n- Cornhole (Arcade): have fun trying to score as you play with the bean bags\n- Darts (Arcade): practice your aiming in the available stations\n- Mini Golf (Arcade): try to aim the hole at the mini golf courses\nThe multiplayer also includes voice/text chat for you to communicate with other players\n\nWhen in My Room, you will be able to customize your own space. You can choose between 3 different themed templates, explore and change it the way you prefer.\n\n* Find more information about the gameplay itself the app*\n\nUpcoming updates in the near future:\n- Game monetary system\n- Shop\n- More games\n- More rooms\n\nHave fun!", "short_description": "Play minigames along with your friends in a multiplayer environment or explore and customize your own room with this experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vresearchlab.com/privacy-policy/", "developer_terms_of_service_url": "https://vresearchlab.com/terms-of-use/", "publisher_name": "VResearch Lab", "support_website_url": null, "website_url": "https://vresearchlab.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null
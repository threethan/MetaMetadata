311_246912791209029_5540108180063733703_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6x2uUQ_5GqIQ7kNvwFuOKMh&_nc_oc=AdlqyLyZyqxl7Ukx8PhQFLhMPenSevz9ONj6VIKTQqDLSiDRqWBLZ-DXt9_30YVZ0ec&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfszgP1W3ua07jptKECvF18m5t-39oJL5Tytmyelf8rkJA&oe=699ED1AE"}, {"file_name": "Print 3.png", "id": "2170405556482566", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572950_2170405559815899_5420058398011207589_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4MU-ssMRCy4Q7kNvwFVCGFa&_nc_oc=AdkXwODh_RE4q3D3PfndfJe-bxPov1MJZQPDsgWGY10h9IL6sjM0HmgHAKCGaUlOiug&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvMP3z1XldCekLeOIfWbyv6YEXOt_70txgrTAA_4RQs5A&oe=699EE36F"}, {"file_name": "Print 5.png", "id": "921050275807580", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974548_921050279140913_846272164452751718_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gmIlZotXKagQ7kNvwHkfVef&_nc_oc=AdlivPBI2uBnMsNBr1EQjPFKKGIFPB624CRMXUSdZ0lihW3xxytSOCVogu2FBg9xAgM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftXwPk22HvwoB_LlD3vGAaf4LU9bIVWcNu5DRG_KFr0kg&oe=699ED657"}, {"file_name": "Print 2.png", "id": "1288706015050300", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75641339_1288706018383633_3836298053771559642_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gjgnOdw83jgQ7kNvwERdOMU&_nc_oc=AdkzEr8LnEIS3klRNRrFaRzk-Tv88EhNgihQWO4qnUv9Rf-75MmrHYYKAeRRVuzUG10&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afs6gWYhr9D_5rowmBsNhwsST0mdr0dCosdPpJxnWIZbNA&oe=699EE011"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Final v.0.1 (eeve).png", "id": "945385240225978", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974721_945385243559311_50820886768660782_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q2rYWHFsASYQ7kNvwFKvNHO&_nc_oc=AdnoXHxY5HfOY_Qbd6Ggku5mD370q_spKNFnvMZNqYCmubMdt1fQMZLCNEPrtX9vdPM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsyeWHlIQjVUiBWMMxkV4SNX0xcDLt067-sqZrDTqOTVw&oe=699EE5BC"}, "display_name": "My Room", "keywords": [], "long_description": "My Room is the game experience that allows you to interact with your friends and also create your own world.\n\nCustomize your character and explore our two game modes: Playground & My Room.\n\nIn the Playground you will find yourself in a multiplayer environment surrounded by minigames that are available to play with others. These games include:\n- Soccer: score as many goals as you can\n- Air Hockey (Arcade): play with the AI or with another player\n- Basketball (Arcade): throw the balls and try to score points\n- Cornhole (Arcade): have fun trying to score as you play with the bean bags\n- Darts (Arcade): practice your aiming in the available stations\n- Mini Golf (Arcade): try to aim the hole at the mini golf courses\nThe multiplayer also includes voice/text chat for you to communicate with other players\n\nWhen in My Room, you will be able to customize your own space. You can choose between 3 different themed templates, explore and change it the way you prefer.\n\n* Find more information about the gameplay itself the app*\n\nUpcoming updates in the near future:\n- Game monetary system\n- Shop\n- More games\n- More rooms\n\nHave fun!", "short_description": "Play minigames along with your friends in a multiplayer environment or explore and customize your own room with this experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vresearchlab.com/privacy-policy/", "developer_terms_of_service_url": "https://vresearchlab.com/terms-of-use/", "publisher_name": "VResearch Lab", "support_website_url": null, "website_url": "https://vresearchlab.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null
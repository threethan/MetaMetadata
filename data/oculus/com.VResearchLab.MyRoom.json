311_246912791209029_5540108180063733703_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XESRx-aU7p8Q7kNvwGyHOcm&_nc_oc=Admo6N4IjOTEEd0zG9tRWKscInZj_G3B69oow4Q9cKOYxHC88RT_QZjhC0hnpCJFeaM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Aftc2-Cq2G1xQzYRXhXtsZordk-qHxLXjKjGv42HSIlpOg&oe=699B156E"}, {"file_name": "Print 3.png", "id": "2170405556482566", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572950_2170405559815899_5420058398011207589_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FivKK0IjhW0Q7kNvwHiUbqr&_nc_oc=Adk3pV4iSiZLEZHKu-EFVtfIWHVzAbOdQlJo512_EeAATE01iuxG3blSGOJzDLb_jY8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afsw7frpw4BFspYxKOZdtp0PW76ewNQLn9Hp0eBe4HlUtw&oe=699AEEEF"}, {"file_name": "Print 5.png", "id": "921050275807580", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974548_921050279140913_846272164452751718_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8NL-7mBatmsQ7kNvwHciiuA&_nc_oc=Adk3A26XVXIv9mnyh7V59bNS7bZYkjecLgF4cHDE_kiXgKE0Rwm69vuOpY7OfIHQ0XQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvW8MCJsIIESOkOwN9fM88LKoV99A0iidAPC_wtwZVgaQ&oe=699AE1D7"}, {"file_name": "Print 2.png", "id": "1288706015050300", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75641339_1288706018383633_3836298053771559642_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QMt9QXPcwNoQ7kNvwFHPHVk&_nc_oc=AdlC7g9hR-aGqylEVJdNGwcA_LQss0cchuNP4p7oRcXOdtpXcZBJp79ioke6OWe5VF0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afsj3X95UABZRR6YfsPWVX4f2qeLAXBxdG52ZHKTGoqCOA&oe=699AEB91"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Final v.0.1 (eeve).png", "id": "945385240225978", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974721_945385243559311_50820886768660782_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ZzFqIZSrO4Q7kNvwGZ9FqF&_nc_oc=AdmQXBSZacOr470lsmtJkVOwxFtHdwSnDm4GdUWO8KjQ1tqF-HGab3b7GsKAHdIZYZ8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afti_xsf3mkwFhnxhRdkIw1PkLkQtpvvolPhH89hfNh-uw&oe=699AF13C"}, "display_name": "My Room", "keywords": [], "long_description": "My Room is the game experience that allows you to interact with your friends and also create your own world.\n\nCustomize your character and explore our two game modes: Playground & My Room.\n\nIn the Playground you will find yourself in a multiplayer environment surrounded by minigames that are available to play with others. These games include:\n- Soccer: score as many goals as you can\n- Air Hockey (Arcade): play with the AI or with another player\n- Basketball (Arcade): throw the balls and try to score points\n- Cornhole (Arcade): have fun trying to score as you play with the bean bags\n- Darts (Arcade): practice your aiming in the available stations\n- Mini Golf (Arcade): try to aim the hole at the mini golf courses\nThe multiplayer also includes voice/text chat for you to communicate with other players\n\nWhen in My Room, you will be able to customize your own space. You can choose between 3 different themed templates, explore and change it the way you prefer.\n\n* Find more information about the gameplay itself the app*\n\nUpcoming updates in the near future:\n- Game monetary system\n- Shop\n- More games\n- More rooms\n\nHave fun!", "short_description": "Play minigames along with your friends in a multiplayer environment or explore and customize your own room with this experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vresearchlab.com/privacy-policy/", "developer_terms_of_service_url": "https://vresearchlab.com/terms-of-use/", "publisher_name": "VResearch Lab", "support_website_url": null, "website_url": "https://vresearchlab.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null
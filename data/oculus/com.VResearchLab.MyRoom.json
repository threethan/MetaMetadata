5696", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031311_246912791209029_5540108180063733703_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4CRZQJ9rZ5IQ7kNvwGYmnJ2&_nc_oc=AdkIxRqLYl32g5YZ12ex0jNDirIeQP0yLjTivO2AkdH5ju-g00YT_gqoFHDstp-hXC0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzUmjCW3pnfNq9r4yhcw8wLpWkdGmVSG2XKIZArfm7I6Q&oe=69BD5C6E"}, {"file_name": "Print 3.png", "id": "2170405556482566", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57572950_2170405559815899_5420058398011207589_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qfDcNu2cUBkQ7kNvwFvMjsa&_nc_oc=Adl10c8M5otI8CP8R2kllZkurK1zxKg-CLn4YFmT8xeP002eyJ5KsEI8JkBoBjFyLUc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwQxGEya2I9Enm4QdIyOmAOK9eQ9Lvs_lZaXav35bjocw&oe=69BD35EF"}, {"file_name": "Print 5.png", "id": "921050275807580", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974548_921050279140913_846272164452751718_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j3z_5SEsalQQ7kNvwGs7ZBk&_nc_oc=Adl7zcRQcYgWpHU_ap2mRHgpwRSL8GGIJA0Lh5heII0JYYCsiT3MLGWDa5i9YwFuFwA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxpb4aN2elD0e2QXfdDcLUgyb6gO4x8NnMiFLloxbo_uQ&oe=69BD28D7"}, {"file_name": "Print 2.png", "id": "1288706015050300", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75641339_1288706018383633_3836298053771559642_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g_GQjmWh1b4Q7kNvwEUYL4b&_nc_oc=AdmxGVHdJ5GADp6x85KZYb-FPCzEJlzP-Hl71aDEmb0_hJSKoUzaxa55j30XoeO5uqk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afxw5oXgFtrD32-xkd0VodN538aEuMzO2cZPdtV2UtSWFg&oe=69BD3291"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Final v.0.1 (eeve).png", "id": "945385240225978", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974721_945385243559311_50820886768660782_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RG7_AYjL-NoQ7kNvwGhtXk3&_nc_oc=AdlV-FwPbl0ZYje7wodtOK9dPTfZ8e4l9naEmccZ_HoDSA3FhzaDCypy4xoW0yptyRg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afzj5O5DcDwMqAbAPtpkrIfXjgxgcMRHMuak_J5ioms0Hw&oe=69BD383C"}, "display_name": "My Room", "keywords": [], "long_description": "My Room is the game experience that allows you to interact with your friends and also create your own world.\n\nCustomize your character and explore our two game modes: Playground & My Room.\n\nIn the Playground you will find yourself in a multiplayer environment surrounded by minigames that are available to play with others. These games include:\n- Soccer: score as many goals as you can\n- Air Hockey (Arcade): play with the AI or with another player\n- Basketball (Arcade): throw the balls and try to score points\n- Cornhole (Arcade): have fun trying to score as you play with the bean bags\n- Darts (Arcade): practice your aiming in the available stations\n- Mini Golf (Arcade): try to aim the hole at the mini golf courses\nThe multiplayer also includes voice/text chat for you to communicate with other players\n\nWhen in My Room, you will be able to customize your own space. You can choose between 3 different themed templates, explore and change it the way you prefer.\n\n* Find more information about the gameplay itself the app*\n\nUpcoming updates in the near future:\n- Game monetary system\n- Shop\n- More games\n- More rooms\n\nHave fun!", "short_description": "Play minigames along with your friends in a multiplayer environment or explore and customize your own room with this experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vresearchlab.com/privacy-policy/", "developer_terms_of_service_url": "https://vresearchlab.com/terms-of-use/", "publisher_name": "VResearch Lab", "support_website_url": null, "website_url": "https://vresearchlab.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres":
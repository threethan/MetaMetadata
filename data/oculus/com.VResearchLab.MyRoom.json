r print.png", "id": "246912787875696", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031311_246912791209029_5540108180063733703_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bIGuxawSPKUQ7kNvwHfovdO&_nc_oc=Adq0mVIVm0vs5UTjExAlYzjotDGnyfl770uT-7NDvV0ATZMH9WCbkn8iZEHmuNkjWTg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMCAGmWGgyH9sM2jJ65Eyi7vialN6m29TJO-QiX6hxRXQ&oe=6AE5FDEE"}, {"file_name": "Print 3.png", "id": "2170405556482566", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572950_2170405559815899_5420058398011207589_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XX1igbIlHBUQ7kNvwHxE2m1&_nc_oc=Ado5Afar4fytUx-0LZ7tjWvDb1Qe4rACc9OzFda9tglB-oRi-Urn039KrX347xCNU9U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNoY9h4jId_UYUl_XbJcDcsEaQ_OLNm0WRyp15jt4SKkw&oe=6AE60FAF"}, {"file_name": "Print 5.png", "id": "921050275807580", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974548_921050279140913_846272164452751718_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LRyz7EriJUQQ7kNvwGv1y_B&_nc_oc=AdoePsy67qC4NvkiguOcChm1tFmVbY6EoJ3NMg-Kin1BV5EHJ2zT2yMig9_uieVEKWc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNDYQwbaqVfbkICwZzz8N_NzY-t0RkrHZrmTEZu99HG0w&oe=6AE60297"}, {"file_name": "Print 2.png", "id": "1288706015050300", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75641339_1288706018383633_3836298053771559642_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BRTi2QIPjM4Q7kNvwG6oqrH&_nc_oc=AdoJvTlqtqfhFK-VifCONCUycqAXAUIC5gjUeF6s8A2pcj7JwNYoD478K6eqHhP2M38&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOp8ju3frDXq-s2D1JFIYG1G43aS5RaB6Lbr98_5JQIUw&oe=6AE60C51"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Final v.0.1 (eeve).png", "id": "945385240225978", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974721_945385243559311_50820886768660782_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lsky9mLJsXkQ7kNvwE88AWD&_nc_oc=AdoOM6HktrmWlHmugGikTpi2z-FHlMuh_88RV2IG5G4s6VHOOY3382nSIqE8uC12RNs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOvRFcpCMfVbYcNZ1fTldv-_kWb5O0p1hBOZWSE136RYQ&oe=6AE611FC"}, "display_name": "My Room", "keywords": [], "long_description": "My Room is the game experience that allows you to interact with your friends and also create your own world.\n\nCustomize your character and explore our two game modes: Playground & My Room.\n\nIn the Playground you will find yourself in a multiplayer environment surrounded by minigames that are available to play with others. These games include:\n- Soccer: score as many goals as you can\n- Air Hockey (Arcade): play with the AI or with another player\n- Basketball (Arcade): throw the balls and try to score points\n- Cornhole (Arcade): have fun trying to score as you play with the bean bags\n- Darts (Arcade): practice your aiming in the available stations\n- Mini Golf (Arcade): try to aim the hole at the mini golf courses\nThe multiplayer also includes voice/text chat for you to communicate with other players\n\nWhen in My Room, you will be able to customize your own space. You can choose between 3 different themed templates, explore and change it the way you prefer.\n\n* Find more information about the gameplay itself the app*\n\nUpcoming updates in the near future:\n- Game monetary system\n- Shop\n- More games\n- More rooms\n\nHave fun!", "short_description": "Play minigames along with your friends in a multiplayer environment or explore and customize your own room with this experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vresearchlab.com/privacy-policy/", "developer_terms_of_service_url": "https://vresearchlab.com/terms-of-use/", "publisher_name": "VResearch Lab", "support_website_url": null, "website_url": "https://vresearchlab.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "ex
r print.png", "id": "246912787875696", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031311_246912791209029_5540108180063733703_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yWsE60EoZQMQ7kNvwEvZGp9&_nc_oc=AdoM65WIwstB8T3AqlVB0eN2Ag_70253eBJRj0L2T8HAFlkLD-VOKLVickkor17hdww&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKibUUJKEy1QepjLFqPexiXefhydUzJlRG7tgVI9S3GMQ&oe=6A9ECCEE"}, {"file_name": "Print 3.png", "id": "2170405556482566", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572950_2170405559815899_5420058398011207589_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ulxb_hfCguwQ7kNvwHTTpiC&_nc_oc=AdqCz8Yu-BjmTrmPHC07uOHseQRCpDAVvmF01QKQQtTUHizMAY0mny3KtrQRlbrSSGo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6b0Yc5UZGRtqF75SdmQjh-dsj--QMi8oL_MvFMcom1w&oe=6A9EDEAF"}, {"file_name": "Print 5.png", "id": "921050275807580", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974548_921050279140913_846272164452751718_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JHHzlCrKuq8Q7kNvwFtFPGO&_nc_oc=AdoVn6Pmb_9ye4anTnL5bNvcF1xQ9UTv_sQR6YdKRRSClO0XYf1KCGbEwkloOkACpkI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKdo0WHHnFmmA84uCZGtiJEhoG0CIxWmbVGqDpxck9SA&oe=6A9ED197"}, {"file_name": "Print 2.png", "id": "1288706015050300", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75641339_1288706018383633_3836298053771559642_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VHWcAaxieAEQ7kNvwH1sG4L&_nc_oc=Adr9rHGt6YeIXeDG7xVWrCT9WKGc530FWTb8JubU5J5qmKEBf3SYiWezhFgs4qgBhF4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7HrMiEzkuabPRg3TDGNRy1udJHGu_fzmdr6RuCdfBCg&oe=6A9EDB51"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Final v.0.1 (eeve).png", "id": "945385240225978", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974721_945385243559311_50820886768660782_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H-lIieP0hDYQ7kNvwEepNYd&_nc_oc=AdrExygc15q24T0Kol6xVqzzZz0PVxcIe0ZW0Ikn7Ol3zvixVMXFLxCy7x1MBvbEzTU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZfL1EBr0HLFqYX50F7Am7z94eCbBCTrPZSZdQ7dKU1A&oe=6A9EE0FC"}, "display_name": "My Room", "keywords": [], "long_description": "My Room is the game experience that allows you to interact with your friends and also create your own world.\n\nCustomize your character and explore our two game modes: Playground & My Room.\n\nIn the Playground you will find yourself in a multiplayer environment surrounded by minigames that are available to play with others. These games include:\n- Soccer: score as many goals as you can\n- Air Hockey (Arcade): play with the AI or with another player\n- Basketball (Arcade): throw the balls and try to score points\n- Cornhole (Arcade): have fun trying to score as you play with the bean bags\n- Darts (Arcade): practice your aiming in the available stations\n- Mini Golf (Arcade): try to aim the hole at the mini golf courses\nThe multiplayer also includes voice/text chat for you to communicate with other players\n\nWhen in My Room, you will be able to customize your own space. You can choose between 3 different themed templates, explore and change it the way you prefer.\n\n* Find more information about the gameplay itself the app*\n\nUpcoming updates in the near future:\n- Game monetary system\n- Shop\n- More games\n- More rooms\n\nHave fun!", "short_description": "Play minigames along with your friends in a multiplayer environment or explore and customize your own room with this experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vresearchlab.com/privacy-policy/", "developer_terms_of_service_url": "https://vresearchlab.com/terms-of-use/", "publisher_name": "VResearch Lab", "support_website_url": null, "website_url": "https://vresearchlab.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "ex
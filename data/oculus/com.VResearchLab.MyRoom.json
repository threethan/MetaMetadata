311_246912791209029_5540108180063733703_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6x2uUQ_5GqIQ7kNvwFjGQ_D&_nc_oc=Adlg4ALIADdrcuebD5SYSHf5mnh4yz_5kPnN1TKzprex__5JSl4urLOvbZPHisW0sMI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft-KeIapfAvtOWNc_38q4HncvXAkgvrCy91R7uMEE2dsA&oe=69A05B6E"}, {"file_name": "Print 3.png", "id": "2170405556482566", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572950_2170405559815899_5420058398011207589_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4MU-ssMRCy4Q7kNvwHo4gZy&_nc_oc=AdmXKhZtReUeeS1TqWd-03TbJfI5Rp57FWt_g_3KPiKkUZ23Nzvbqmq_VFJQj0CMn_U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvIKOJO47O8HM9iSkpXoBY8OG--zf3kZmUJK7rETQCNoQ&oe=69A034EF"}, {"file_name": "Print 5.png", "id": "921050275807580", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974548_921050279140913_846272164452751718_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gmIlZotXKagQ7kNvwE_VJzZ&_nc_oc=AdlHbh_s6TGWMvTLEETQ6ow8cpZ7dZtgCblg9dqOCa5O2q_Zm-9xKtdynNrkjztf4os&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuRcGo9YvcbYVIKDW19BhyvEsIf5y1lf6n1VqPZX9r00Q&oe=69A027D7"}, {"file_name": "Print 2.png", "id": "1288706015050300", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75641339_1288706018383633_3836298053771559642_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gjgnOdw83jgQ7kNvwF1jTPZ&_nc_oc=AdktVfyZ0V7SttdLfLwxJ6q-8ZRP5atZMYrUxKkkU39F9stQQfkoEwWJzk4Z4kVDqUA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvgVvtftZKJdp__tmdbOsvfN6nb9y-fIwDbD8X1uRt5sQ&oe=69A03191"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Final v.0.1 (eeve).png", "id": "945385240225978", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974721_945385243559311_50820886768660782_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q2rYWHFsASYQ7kNvwFkpCwc&_nc_oc=Adnnetfei3KbkZJ74wSFggDKJGnCJU5g8xe27CwlB2zXVTJS8HO_Q1kSKs_JBWRtSMQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsuUB4xMsvi0J_NowSqNqtzi03d8JOvP9px3ZAOr9v_jA&oe=69A0373C"}, "display_name": "My Room", "keywords": [], "long_description": "My Room is the game experience that allows you to interact with your friends and also create your own world.\n\nCustomize your character and explore our two game modes: Playground & My Room.\n\nIn the Playground you will find yourself in a multiplayer environment surrounded by minigames that are available to play with others. These games include:\n- Soccer: score as many goals as you can\n- Air Hockey (Arcade): play with the AI or with another player\n- Basketball (Arcade): throw the balls and try to score points\n- Cornhole (Arcade): have fun trying to score as you play with the bean bags\n- Darts (Arcade): practice your aiming in the available stations\n- Mini Golf (Arcade): try to aim the hole at the mini golf courses\nThe multiplayer also includes voice/text chat for you to communicate with other players\n\nWhen in My Room, you will be able to customize your own space. You can choose between 3 different themed templates, explore and change it the way you prefer.\n\n* Find more information about the gameplay itself the app*\n\nUpcoming updates in the near future:\n- Game monetary system\n- Shop\n- More games\n- More rooms\n\nHave fun!", "short_description": "Play minigames along with your friends in a multiplayer environment or explore and customize your own room with this experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vresearchlab.com/privacy-policy/", "developer_terms_of_service_url": "https://vresearchlab.com/terms-of-use/", "publisher_name": "VResearch Lab", "support_website_url": null, "website_url": "https://vresearchlab.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null
r print.png", "id": "246912787875696", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031311_246912791209029_5540108180063733703_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RCvTTo4l2fUQ7kNvwE6JvHj&_nc_oc=Adp-TKon6J0Wv7B3bX3O4OwgWaXJpEah8NSNsok2dAyM9gcp0_tZ5Yg3P0wC335Lto4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNdETEFyA4fbEKx2EuJEYmnh7xYnseFj2BfGB5a3_qlCQ&oe=6ACB9FEE"}, {"file_name": "Print 3.png", "id": "2170405556482566", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572950_2170405559815899_5420058398011207589_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3bxqLwCin2EQ7kNvwHWyMhM&_nc_oc=AdpofppUzr3RPbPQ7XqUAP9EoxU_5sbktFK40-5pdhq9dRZXWqfeU1dz9KcdVJz1umg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMtwo7Dy-h1KKiD77-EGchfdsT_LCzeKJlLRt4y5GMu8A&oe=6ACBB1AF"}, {"file_name": "Print 5.png", "id": "921050275807580", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974548_921050279140913_846272164452751718_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lz2EhVGJA24Q7kNvwFU1gsj&_nc_oc=AdqAfH_7eMgdT9nThm1QLkQzzEyeYxxAwFCkkCoSnY1_kQuFIRn7tDG-iyXspUJUqQs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMLAGbFdYLjhgCiWJPULItNavVLf0mR6jJ1bl62aN1XXg&oe=6ACBA497"}, {"file_name": "Print 2.png", "id": "1288706015050300", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75641339_1288706018383633_3836298053771559642_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X5Ve4rS2p7oQ7kNvwHHHHWz&_nc_oc=AdpFBt1mRrA7zfzf8J2ju6_qcniwdg-ckHMWDSyUJOQfrvBRN-5jDTCxeBrSIGBo5gk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFEl3ah_W8AjA-GBmJ2x7dPUGDFhAkQhoORPwOUEc-vA&oe=6ACBAE51"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Final v.0.1 (eeve).png", "id": "945385240225978", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974721_945385243559311_50820886768660782_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r491U9yek-cQ7kNvwEjytIF&_nc_oc=AdqRfTLwiJLXN2FZQ-UyWM96Cgvv0lcF94LAF-egSYaHOSTGRBP6CSY7k54jWd-AVzw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPC296dGeB_Bn3-As9RMFv6RoICtsnB5ydSPuZd4hyA3A&oe=6ACBB3FC"}, "display_name": "My Room", "keywords": [], "long_description": "My Room is the game experience that allows you to interact with your friends and also create your own world.\n\nCustomize your character and explore our two game modes: Playground & My Room.\n\nIn the Playground you will find yourself in a multiplayer environment surrounded by minigames that are available to play with others. These games include:\n- Soccer: score as many goals as you can\n- Air Hockey (Arcade): play with the AI or with another player\n- Basketball (Arcade): throw the balls and try to score points\n- Cornhole (Arcade): have fun trying to score as you play with the bean bags\n- Darts (Arcade): practice your aiming in the available stations\n- Mini Golf (Arcade): try to aim the hole at the mini golf courses\nThe multiplayer also includes voice/text chat for you to communicate with other players\n\nWhen in My Room, you will be able to customize your own space. You can choose between 3 different themed templates, explore and change it the way you prefer.\n\n* Find more information about the gameplay itself the app*\n\nUpcoming updates in the near future:\n- Game monetary system\n- Shop\n- More games\n- More rooms\n\nHave fun!", "short_description": "Play minigames along with your friends in a multiplayer environment or explore and customize your own room with this experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vresearchlab.com/privacy-policy/", "developer_terms_of_service_url": "https://vresearchlab.com/terms-of-use/", "publisher_name": "VResearch Lab", "support_website_url": null, "website_url": "https://vresearchlab.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "ex
_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vzq7tI4pv3YQ7kNvwHfWpuX&_nc_oc=AdpDYGzyvcmaqdy5DHYtsy0fstjS9ZPM7IAv3sQW9WoSjvQXWVYbqBY6N-3AQ3jTI1A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af554KQqqNGjaSu7cb6ov1O5RWDtXJu-f5kaULI2Yot88A&oe=6A184C9E"}, {"file_name": "leavesandtrees.png", "id": "3627811494209942", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2yIA5wJH_DMQ7kNvwFhuLrI&_nc_oc=Adp_v8d7jn2cRIPKBQi1RgMIrhR2D4kGH6_JlFaOM_NqGMMWI98fF4GrjrHwxLm7nsQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4zyjK2XC3GdrRzKn_B5briMdfbH_gm2Vpzk13ZbtFtxw&oe=6A1844A9"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2mmM2jfCdJcQ7kNvwEwm3rq&_nc_oc=Adp7ewMnCFgvvWnpq4biqRpPOHQ4JAcz5HAVcbIoJrHrgiFtajlSehJ108YwHJteb8Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5G7AX4MoeV07CgW6x_orOsHfux5DV763erRSmTi4ufAA&oe=6A186630"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sC7hLNOb4woQ7kNvwG9utUj&_nc_oc=Adp7uPCTGUrglT0v98dKkCHQmJ08M1Bg8MuTozoF6q07W4cOOSQ8N0zGu7jQe0zsw7c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5MLI13tLaBuAyBj4NCIhF1aLpyFsTSmlDtlRSUsAU5xA&oe=6A184E96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xNJHaenfuscQ7kNvwHO6URZ&_nc_oc=Adr5RoY-ROsRBv1kBCVE2-jeMMm7YeR09dhPU3CN_FTL0KgnCrLm3hgc207cZ6hXZNU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7z8A2qUGVmUy8BJqvBSZ3lFm2o0hHQbohz5ap58QfNGA&oe=6A186854"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics":
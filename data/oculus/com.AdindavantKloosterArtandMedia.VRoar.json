_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1phDhqFHaiwQ7kNvwHvi9ag&_nc_oc=AdobWqoIrNZcelihZ1S32IgmMwafU6kBa5jTgu5_nV2lf7pWHtdXcKUdlK__j1tFMEo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHLDiQzWvzQXp0vDrX2-clvdMul3-dDQ4_oorK8sZ0Yvw&oe=6A92AFDE"}, {"file_name": "leavesandtrees.png", "id": "3627811494209942", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6YKCV5lHo28Q7kNvwFr4faj&_nc_oc=AdoDGq0sOLLm1R4u6ZtlKLhrZ1f5QkgbyvUjUJO8gbzc8VmZnPyXa31rLJedgGafmc0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFpZ6lZCU2_XGd-ykb5RLbtFl9eeQHCFH27klk2JOPmFA&oe=6A92E029"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sm77_YqOl2oQ7kNvwGEb_QB&_nc_oc=AdpqIhIiIxHmtQcswBkbV3y_ogKw2F8Iuv1EO7f89CMOCi5IadrjnPLwtZ_bfOtZO1I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVUnkUALJ9c05PiTXJ0BCwRFPRIRpjczsHHshngnW4uQ&oe=6A92C970"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EXgRkEqapqYQ7kNvwFqOQYE&_nc_oc=Adrm3O_abwlvKFB_0yqhHBFUCqcVyBuXB5hGzt8hyooqCPwgunX92F3V79l4G8p-mPw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEFQPjObgW25TB-OfpZuhT-yk-E_fXl0EVehUwOAWE72Q&oe=6A92B1D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x8q3Q8A9cr0Q7kNvwGUm2jW&_nc_oc=Adrhc74CsWp0w17tAvtU9p2g7JfS9orH0_m1mkNtW6DOtl4nK5NYMsJB0fMUq0tYM3U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVuw2uBCZqmhWohDryZ0VUc4WAVSQdaA4svPRe_qSMwA&oe=6A92CB94"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics":
1-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L3rR2HmmXikQ7kNvwGa8g_z&_nc_oc=Ado_7dJq9xgFtloo6LLjhYATvzW6il0FMeqCpMO70gtAMX3IuprhUjpBoKCn-9Fh504&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw8LrBQH9CHwSMyRNKlBnqXm_LsRXlDip4S-3iZ1eYfwg&oe=69C53629"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0cjY3DbGgXQQ7kNvwEwJACV&_nc_oc=AdqUMZQLbp0zI7cAmpd_Z2ypdaIZSMVWA5w2Q-vY9aHBPArrktRR_ZpfMnJJeAvGdko&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwS_j9FYCCSMkbNAnCgdPf4DFLir6DfRKDWy8MLRoVleA&oe=69C51F70"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oeGvCxUXX8cQ7kNvwHczs4v&_nc_oc=AdrSn6vFmu6BlcTFtDn8nX0WNA3P-o_o5JZQAnXTf_snLLvaURo8yOeS0Yk3C8d_FbQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwFjDnYdzIsYOWO7habGbW7tZEmyBytHibEX9xZTQ6rMQ&oe=69C54016"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qSZqYLtEILQQ7kNvwHmgujM&_nc_oc=AdqiWX0ckkhL_XovtEHibwnW1N5MfNaYbpPow0sh20Frzz3Sh6qrDWV18NnixlFj5co&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyfDuv38-1caVtUbdyR4tlBE1LQQuHWdmehyZhf7cJddw&oe=69C52194"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "928105881625935"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "812148190574
_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vzq7tI4pv3YQ7kNvwEV7xAg&_nc_oc=AdrvllrvQS9Zed4rC0Y_crSvrtOg96fU_5k8kj4P6OenQvvQIL-YEWoLtLwdsjEh55g&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4gvliXCPsXTkR7ky47AbqgBE-Ajdmo8Szoo4WaPBlMXg&oe=6A16FB1E"}, {"file_name": "leavesandtrees.png", "id": "3627811494209942", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8vqR1-5QvacQ7kNvwERDOGF&_nc_oc=Adr13W0da9lnF30aGAo8bQmEyNXsLCsCpZ34ipO1twql4t91ruGHjxs78Zd5LEjCN0Y&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af41jpzkVnjat2cWAHo1a86hpQOY7eXwH_45m2oH4mJgLg&oe=6A16F329"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2mmM2jfCdJcQ7kNvwH04TYy&_nc_oc=AdqYuipFlM5gG-Ej1qEi3SEAbpVfct5fA70iFWPlBr96XnOIWL7LPXaENw0qAj8utu8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6D9cpL4P5KLdh08hcJlduacZy1FEmfXVlmbCbTntZQOw&oe=6A16DC70"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sC7hLNOb4woQ7kNvwHHFmK9&_nc_oc=Adr03au76MuTAaho5MkdWBxPVPuq4j4MwdhaOnORUAXE0YpNoL1p7DNrYdQ4z1mMYAw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Zn3SUtFjQGs_Yw_4nIZH6xCCGqAJDhrcFRh7TzkpNUQ&oe=6A16FD16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xNJHaenfuscQ7kNvwEK1bLz&_nc_oc=Adq8WH_JjTYloQxe_5CMPio2UfNxvuYG1Rkt7x9EkDbr5_RnvDzmtKOWydV8MTpKgrk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5fvz-_27WZScQIcwi5T6w8WgIPsRAuEhbYEs487K-lEQ&oe=6A16DE94"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics":
_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f6rZUP3qNI4Q7kNvwFCuF5j&_nc_oc=Adqw6tOLRYLaAN1Pkh3KKKJhf9LmYo4qkgSwO15qw-0pXyBaBeSJSC7x96ODZ42ua0o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_EH_06MtmrkuPzqOTRuElRuZxiZ8tjuAYTX_Lsy-FONw&oe=6A47C29E"}, {"file_name": "leavesandtrees.png", "id": "3627811494209942", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=isQ7gs5HPhwQ7kNvwF4ZSNl&_nc_oc=Adr5H2tcgxKlVqeEVPMjAnMeXSd8_AB9Ibo3G7uK0qmJwxSM8xkHtW51r806rTut5sw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9L-qSiY-QX0WsiVR0eO72_QfXYyizK0vGSUMazx1ZoqA&oe=6A47BAA9"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qerFDJb8lZAQ7kNvwFexYSk&_nc_oc=AdqTKqQfNIUqv59oVGsG3oeFoPGe6wdYFr8eLUUV2jMUryBfTVa8Kmulvn_4nPPVdXU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-zk5IX5kVuLe8j8efRqSLv-8XAhEvuYgZauBGHLaJK0A&oe=6A47DC30"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=chPrPTCijxkQ7kNvwEsHHpf&_nc_oc=Adp0EJiuR3xWEQbbzfCRpbnjWN6Mbfiz62YgM4nshHtkQaB0Bz1WQL0aUH048Y1ufEM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8LztBVhaWCgcpmTt9qNgiOFwIE8pw-jZj0s5zJf2ZcBg&oe=6A47C496"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bldEVYX1rvsQ7kNvwF5UAUx&_nc_oc=Adpm4q52KYRk8Y070XsZItDR-FfmdBfgfT1U2CthCc9SXuaZ02Slvr9WmdZTHI1jECk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__EZcTWHPUELwT6cuLt10IrT9fHWrv17Mf_MRXRBJPxQ&oe=6A47DE54"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics":
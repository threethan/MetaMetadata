_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0xVeM5j5rh8Q7kNvwGIrO_7&_nc_oc=AdpxUTejgdpLHlW5zKlB8c8MzGXE-QzNNp7hmOkoOjN8TX2krnVAQOBhGrOs3nAJZ1A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO2pbwtgvYcyZ3_uL3sxMAJ_z_fwWSmDrkA6ATkBzj8zg&oe=6ACA471E"}, {"file_name": "leavesandtrees.png", "id": "3627811494209942", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P-741dHJbxMQ7kNvwGQSvx8&_nc_oc=AdoEsQS6KYWN_xSdl1uDMJgT3uodP_NToUBgEZmkXoxRIVhwLxZayr9mLthRqjCKFHY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP2XnJApwUNnAzHMwSYWqfXrNHynfYJYJrKVR8NUat0yg&oe=6ACA7769"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TlK7kaSq07YQ7kNvwFEGpNe&_nc_oc=AdoNmObXrDsw1vudXwVX2jRxHACzaHX9vstKxJFUTVtW684iF22siOV8-l8pgC5raiQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNLHUId1PeGWDDhuKPCW2KalgO0W6MBCO3XQXbbgDyEVQ&oe=6ACA60B0"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IQ1xNafdjvAQ7kNvwGGockB&_nc_oc=AdpK6gCfjN9UZMxnHr_666D8IY1023vTPeM2ex-8BIeE5iR1kiE1-63eCZ_qc0OmM1w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOnEgNazkfSXM43U6KT2NGLLEwFL3odBFjEwpozGvgw9g&oe=6ACA4916"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B6JF5WDrqRQQ7kNvwHG8bI1&_nc_oc=AdpDYQ3j3giyqo35rBHwiA_CEZ4k9dc5iG6cPNwPSw_U8r1SZevKl_0rFFOcKwhXVKE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMG-g6wqO89ApEqsXalmBNyxeNJMbW1_0gPqa5lwmBYsA&oe=6ACA62D4"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics":
1-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vJKcWwRoT6UQ7kNvwHOUipV&_nc_oc=AdqIPg4zgigrVRGWBYeqU5wRL0aEsLrFn3ggSDks69ub-kBoe-kT78csvOeUrleJG-s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8aEmdbnTWJC2mpIf4oBs8v3ArgHhN6CsKWWCsivrQX5w&oe=6A4517A9"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qerFDJb8lZAQ7kNvwE_EzyS&_nc_oc=Ado1l7LpVfpJWQGxURJx0sacdnl8pIRulJvpGfD-EbuBNRCeS3Q8j54YWEGdbryr-1M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8saWt20P7u1wCo-pA6TpuB-f_39TFf9-aVYUnaOphi4A&oe=6A453930"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DXoGBnb3XAQQ7kNvwGop4pv&_nc_oc=AdrnM9T3qt0PAPf3dMJWgZVdcLo5No5dncqz38lKxpIiIJeVJgGH0vd_Nj335whxLnY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8lODaf9s0n-fAa-uA9CkRN-ik3E-_iWvE7NrTG8UHc6A&oe=6A452196"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Mk1eSINnb4Q7kNvwHDK-fU&_nc_oc=AdqWc42dY9F3COaDcNfkxng6QGmUuxnaeBnzDowAx_fLbT6iZr2Kb2dPXjbt2zQOfLg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8W7n1r9i3g1YrYChP9Z8LwO7H2rFoRrYOVt4KQH2CJNw&oe=6A450314"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "928105881625935"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "812148190574
_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P-99U4X9FhcQ7kNvwHDzyxe&_nc_oc=Adot1dnxYfhYqPsOCHzcYXx_nfoW26pLRkb_6S_M44NSBeYuKeAEy5UYLGj9qOjqtF4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPllaAdXJZunYCV8CBGcAfWfmH0bTshoSQICXsYF1TnhA&oe=6AE5F69E"}, {"file_name": "leavesandtrees.png", "id": "3627811494209942", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hjBE2xlH5OAQ7kNvwGLIPHM&_nc_oc=Ado3jZgdmiTPWjEMHk1CEXJVn1YC-eSU046PEUU_whc2MC-xn2drjhf41eAo9z5LzYo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOhgMHfwdBJDoZfrPabyeFsvd2jMW7zDm_saLiXnrmW3g&oe=6AE5EEA9"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qJor4FM5F9QQ7kNvwFxaelZ&_nc_oc=AdoEa0PIKcX1HkgsxkbQX1D1aicTNCaVBXhShTRvhj2qwI5K27ad4Vt6lhgmZ72Xfy4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPT9acBj_EMN-ivGuw7tF6cShpSOwO1NoSAd_-Sz1aPxA&oe=6AE61030"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BK9TPz3Z5f8Q7kNvwGAfbqX&_nc_oc=AdqbxrQyYpK7_RBa-3KaeREES6PYJwrqJV9ri0u77xlBcE0PLkJRWCuO-jkZ7Cn1Log&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPTZh0CkzUcixnCvy6qKPySssY2wRO_KZYvIZMq7uqBdA&oe=6AE5F896"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1wPaD5CUsFgQ7kNvwF0YbsI&_nc_oc=AdqnL78ZbnRLA3vSCn6-QvKwN6unCZRMc-eot1SaS35DTfVKGB_yDI1ZVA721AJpVpM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMaMBPd5UIsUoHcHfrdr7lMPQ_t-5i713s3PmaJripnDw&oe=6AE61254"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics":
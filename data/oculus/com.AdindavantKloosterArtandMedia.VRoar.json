64"}, {"file_name": "whiteballstreescells.png", "id": "2776687769137070", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031624_2776687772470403_2357440132662109965_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FMt7pxz45TkQ7kNvwEDvnJs&_nc_oc=Adrcp-36IxjcLFHFkVI_dqVS1ElFM-_Wjr3U4tnuhvqLZnfI9UR0tIqKeGgeaHo_JkE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoFi_dpTVrKJ2pj6WB2CZw7LoYrll7iO3OPRcmavfrUg&oe=6AFDB19E"}, {"file_name": "leavesandtrees.png", "id": "3627811494209942", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nVZhWecCK_wQ7kNvwHE_uDa&_nc_oc=AdrniIUdBexA4IQhjA0pPbLQyji0rsar16PmRoQ9ZsX93eB6Ux1CE8NfKeCpB9Ej-g8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQ4Hj8cMO5owJwN_b6Ji3RaQrey2MTmLwlFDzWrjZj8g&oe=6AFDE1E9"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TeOsBoiSBSwQ7kNvwEN7P7i&_nc_oc=AdqD45NNeiu2leTJabvUVezC60FH1Fc2iGAsG_ojKsbexwR1lmnwQGoy-JWQWGWznH0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqz80Y8-Xty5taTK7OJYmYwdREsfDoZeatZyR4tD7aGA&oe=6AFDCB30"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=32VCmtLuBhQQ7kNvwEGOPCb&_nc_oc=AdqrI31PDRzVFkyYTslgjK76plreOwUPMNvhbG9FSrGlv13-XPf_b9cBlALWq_JCf4A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqyCr2QcWyfvftVmwxz7NRyF-HJbP9iJhmq0yr5z3qyQ&oe=6AFDB396"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KpZPNc_3nY4Q7kNvwHG9mg0&_nc_oc=AdqlwMiBCRL0arKwxe30NZMD8OsS1wA0vpFnzuBSM-tIgmHI8mTFIUukTE-u-0ChAQ8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaZVsXmGBp0_rJ9yJVamnRLPptoZArseKf_iRk_DwACA&oe=6AFDCD54"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category"
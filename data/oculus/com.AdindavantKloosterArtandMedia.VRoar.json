_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=66LzGpabSbUQ7kNvwFkbztB&_nc_oc=Adrm3notiS6yIuZTKevQJwvFy_Sqt8jlyQfhhD02UbekrvNhgaKCd_ZceevtLIeAuiQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSE7RSDYwDE8hwBFAE3e8beNnWSsUmAmKe6swC9-Vj1A&oe=6AB28C1E"}, {"file_name": "leavesandtrees.png", "id": "3627811494209942", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zkCaCd_HKzUQ7kNvwFoiULK&_nc_oc=AdrJ7GCEunyGGlX6Mxeb6gCU2Lmw7Wlqhwosk3emQlZo6v2pJG820GqJvUICC6lwKMc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6RBdwgQeFjyQjkHtv10JPefUsVplPVBf0GwDyTsaoIQ&oe=6AB28429"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L-eVFBQha_YQ7kNvwHRobRe&_nc_oc=AdoA6A5_RpMDvgosYxH6bYQEE9nEMzcQu67sEzdQCn6VDvnXGClMZ1B5xp3thgKZgAY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7C500fG4-l3w-6Q7gN9WLfSVG-4oy7Cv1TGDIWxqoBw&oe=6AB2A5B0"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QhxbUyD7y_EQ7kNvwH6A0Xz&_nc_oc=Adrr7dhJ76RM9Xn03NBf9KwR8YPRo7TbINtepyMCcs2mlMwSkdHQccDfK3qQ-25R3rs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJOkKDFik3dOnU_LWHnjN-MiGc1GennM3END95kRiHboA&oe=6AB28E16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PNkf5xD7ktYQ7kNvwEoMiUd&_nc_oc=AdrcTEC6emXCpXfTSfok-ysGQ27ue0YyPBy8lHXPzFc9f56Ykmff1exzfRx6hFM6M20&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJpjAcsMloeABt-RrTb1hRlyIiP0a6KyBFaMMyvLDCC1g&oe=6AB26F94"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics":
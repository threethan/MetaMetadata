_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tgiwy4AQNa4Q7kNvwFaRi02&_nc_oc=AdpN6qf_n-OQleSbt0SnbH1nmutwyb5uDu291z9E-1_hArSis0O8o-1GwMnUBKPH8VQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwcPQRjkBJ5PvdTP6cxzk8Ifg6mfiMsXL05Ry3BiPA26Q&oe=69C29B1E"}, {"file_name": "leavesandtrees.png", "id": "3627811494209942", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vl3MZtVzeUIQ7kNvwGBA2jo&_nc_oc=AdoWPZKoKgHbp2eFvpe2tAoRvMUlJkfT9l18VaX8pY1KuKpfxZMfw5UINYr_D0_Tte8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxPFlD5ng1b8KwMPCr7AzE-m4NL1vcLpzWVTcFHglsJfw&oe=69C29329"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0cjY3DbGgXQQ7kNvwH9gtqi&_nc_oc=Adrh-i2BfNgf0WZydPtsx-VK6IyHOdrRPFo4B88Z66UdnZUlaUOhDO2gs-b06EI9ADA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwhUoxfZk9i3ZFKDa-ejDLDea7oiSUXZOMy3_CrJKPVDw&oe=69C27C70"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dzEGyHxLFj4Q7kNvwE4NT-y&_nc_oc=AdqTntnbQmH2R2QDBxPfC6nAA5B3S8nZVlOC5cmkvIRmTZMaP81a0nt4Ko5C2FZAT-M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz837qSQwLOaabfUjCFXJNZZPIag2f1rITk-8u5Yx341Q&oe=69C29D16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rSDrkqv7aWAQ7kNvwHC4PBf&_nc_oc=AdoYiY0oqqA8HwM5mUPyjbYuTWVokTKgSgnYHz0LvF0Kk0f5RKqIGF81IqYcMvHSbLM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz5p247fFYJ1CaIgdVXCJ9QkGDOVANRkTL5c0C_whXv3A&oe=69C27E94"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics":
1-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WjyJYDDxkV8Q7kNvwHGJAq4&_nc_oc=AdpDlpuB6MzMYovfn76YRTANy7CMt9UF0D3FonGQDCNK4TCDV1frN6_9leldC2H5Xec&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_y3PCy8oZMDnSAlAQqitYDPQ1lMRsn1n-icVnqET4DRw&oe=6A32A2A9"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0kWdiMkHClgQ7kNvwFw_37k&_nc_oc=Adq1jelVbRLVhysJeKY8tMAoNTR2r4h0ep-AbCA3oWubGHNxbljaVOWLe-ndyKBHrzo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9J4ewFN07uCuWAkcpkYNbyXC8DDTnr5AI2eAzRLpnlZA&oe=6A32C430"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cOtBRzWai-4Q7kNvwHpajid&_nc_oc=AdqnyqZcWZ1cUmv_7xIBG7lgutMXJZi0r9h3yJYAc4OW8DM-A5G44fdiwAvAwH9qSyY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8na4UBNv43lCluQ4MYs6MiZ6Do81-53pE1pspBpdRi5w&oe=6A32AC96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IR7lzadXqTgQ7kNvwFFHfnK&_nc_oc=Adr1ScqufXK6jj3FkElwd4cf8zwfIeearkPmhaNJP3oCH-ZVuBu1lPIuPlBU7i3Qe5w&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8tND_SYixRL6ACJ4D6dia06gi0tasD8_z7LDHRdDjaPw&oe=6A32C654"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "928105881625935"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "812148190574
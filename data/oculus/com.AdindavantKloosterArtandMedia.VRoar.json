_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ik7CrqVobY4Q7kNvwE83WKw&_nc_oc=AdoP2XfzfuUd-4QSQLk4TsoMcRsf9nUZhA6ahg_nVQBj06ToaCxQB0c4k_0Bx7V5umI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFUVVKDC7Uth3OwPVMITLkyZU-sqMielgo1A60eUjK9sQ&oe=6A95C35E"}, {"file_name": "leavesandtrees.png", "id": "3627811494209942", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6YKCV5lHo28Q7kNvwEfobB1&_nc_oc=AdrhbQSFo4Fgg-ucz8bhjdBPhY6TWKmiyynH85MCkA5s1iRFB9z2zx79OYonNpyVf8w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgFDpfgX62y5nS82QyrbxlicwM45sgQZJyjU7FAQ-FXg&oe=6A95BB69"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6bdmLSJnH8MQ7kNvwGZNBew&_nc_oc=AdrZor5nwvRxaWW16cW3WoDBUwK8fvGT7teVYgGbwOGE-e_NvchBoTLIxCUMjMtxkDQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFL4y-oGog8JuwSO_Hn0mlzxu3RQJs7N8O2_0iLI5TTaw&oe=6A95DCF0"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GwvYj1JHIt4Q7kNvwE5zS_T&_nc_oc=AdpaoJXVDVxEDGUIO4Zh0L9CV8NcpUIaTF2qtoqt0YYRXPQK0qevMcX2T_Q2lSLJnKk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHYeXlxWdS0d_ISL0w4CSCewwZbQi1wLcpX8Qq9rVYspw&oe=6A95C556"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xvFuefvOqIcQ7kNvwGHggYI&_nc_oc=AdqeAJnclcRzHDp8qyICq96JmBWhltEtnD1_lxtQI8b8NtjcTUxkymJLSINEcgOYOKc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFp6cgQ8y6WhbDygJfh-2Of9YGgwXZjkkJTvsFE9gxbDg&oe=6A95DF14"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics":
_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GVj9LKdted8Q7kNvwE1tnfs&_nc_oc=Adr_szy3D2oSAirF9WoCf0zgMBKSdr04SxXbgsahS81gS3I0CvUFnDE-OzdqehIlBIU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Qz1OdvCBIKuJzfIIFd-0mF-qscDntpwNrRfyxWvDDLg&oe=69D6619E"}, {"file_name": "leavesandtrees.png", "id": "3627811494209942", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pZByFc0x7jUQ7kNvwFUbWxR&_nc_oc=Adr-tUhHrzbJ5WhZ7g6SkTHRMKtL0P9Ox-q_TTSHFIL3eOQQZbrcjX7_XZUlRJV9N-w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Y9_AxJcJ8KOx6B3QDyhZmE1rB7I7LoF1WHVFJmRC78Q&oe=69D659A9"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ej-e0CrMV7oQ7kNvwFzfVsH&_nc_oc=AdoB2sJDG2eWpFMTNOm9p-wIvoMzWxUi4MU0APPisVJFh0n5i8rRaewH2evQEG6-xjU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1j9GDuRZ6GAk7YjKscDY7hDnvcvQ8UCvn6rqDQqX1xpA&oe=69D642F0"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U1ar3eWgx-MQ7kNvwGKOwV9&_nc_oc=AdqnTaDnqgiE_QHnCzcVlenf1uH-EGzFVlx8rrVbe70aXwt3GeC0URvrW--UE7DC4nY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af01VDyRK_SpA-WHSPp7c60fWLLfq5OzwW9co7ATgxCORQ&oe=69D66396"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k35pYCY9gYUQ7kNvwGlrTu6&_nc_oc=AdqSqx1DgjmbVHGueKOpUV6pUZA6_qR8PUcgKK3aT0-HOSGtsNwqhUHJL11iQljltQ4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Nx2FQmifk4RqcA9nYbx5jEMI6Bz4gtSiz6QcLPxD3Pg&oe=69D64514"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics":
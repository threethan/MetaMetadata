_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f5R6zxS83XkQ7kNvwFTwieT&_nc_oc=AdqHl94XciOOJyRFbjDvM4soWWkK7p0UlDOSQEGnWleVn9zz0KBiTpqQGSyrVxNYeWk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3RSRa-3ZhuD0H6vACoYV4OG6Lu3Vtibu-ThTZCOTevw&oe=6A79DB9E"}, {"file_name": "leavesandtrees.png", "id": "3627811494209942", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MKu3DTDLfMEQ7kNvwHfyDcq&_nc_oc=AdoHtG-GrEd5xpx605jalq5gPhdwl2s_XRkv9VHj3h0hc9wVawnDpfUprvnli7Nb6uk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWsdeT0Og-2GM-j9snHoO1KqLo4hEQAIM-HUC1Cc31wg&oe=6A79D3A9"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cFZ_r2fP2ZsQ7kNvwGvs4YC&_nc_oc=AdqlWhtbOCvKgdiigPzNztDD-NbD8Er3pBjtyqYZNqmhaT8aJw2lJmxUBfg8Hc1sHj8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFKFznKw4Sc7WFhfPKM_nT-iZkHhf8mcPtnXIvoY4vOlA&oe=6A79BCF0"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VTwC8HIPO3cQ7kNvwESFjC1&_nc_oc=AdppzDaPKlS7lIxJHTcCRWQd_fu4Xz7O8AIk4D13veHWt07_N1rvF8EG8EJb0WsVIV8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG1HHoVy453XGLP6ST91PHDz_9lmshU-zxEfGkO-ehR6Q&oe=6A79DD96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sOb_oPrDbLcQ7kNvwH9cYPn&_nc_oc=AdqTv3hLBn-HlaU4LKJBQrB8pR-Ko8NRQfZsUoz-XLYQ8bD4CUf_U35zwjUwATy6P40&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHqSak1spcUSPE0uFA70o7imDInnOwSxwCnHSEFdCu2JQ&oe=6A79BF14"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics":
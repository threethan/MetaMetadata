_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8IubH244KqAQ7kNvwEZk5YO&_nc_oc=Adqt9kfgTdnEmrzGAPuGsM_zEIB8CTHa5dOgseANvSu3Jy9UoJwBMltcOoCObT9XRI8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af20RRB5wpyHPvBp0Q7fWBVGtUybP7lZqb2Jslt9wIY9Pw&oe=69F3629E"}, {"file_name": "leavesandtrees.png", "id": "3627811494209942", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XVz8xSzViI8Q7kNvwGcmIcp&_nc_oc=Adrne9x_yzzHzY-NTSUTEhDk0MLIq37os3Cz6N_Orh84HglUjbENmt5sPk5TrjlmfgY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af26Jam4O8O_QiN_qBm4bqWShMNvRuNey3hiLNsIBTEXEA&oe=69F35AA9"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HLAo1SI5IiIQ7kNvwHeGk3d&_nc_oc=AdpdlgQ6vpF1NIoIG1fTkBd64DrUlo_DK3F0o2EcxvKcNB-jIQctg7F0vwCJVCVveBQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0I6SjclmqmGLiVo1WHQGBzMVptomEZTs2dGHTq61FJPQ&oe=69F343F0"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3kHVRXTZ7hgQ7kNvwFLs_ni&_nc_oc=AdquitBSPgiS1LlnyL0R5uESWKsCaghzgON1hWfy3utuTHTY3cq-Py3FF5cFZh-Bbfs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0SckLgz0lZ1ZcLjOQkBWyKRlAy1JVEqZ2AIl9uBBlLdQ&oe=69F36496"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UZJAMDqvd80Q7kNvwGfaU1f&_nc_oc=AdqPFOc-wfQPGEraO3LznP4ixKocy3K-eUXkbJdWxQ4kAWpgOPVNWtpqXv17MsDFYyI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2bng9IUI5gRuGcLl91lhxKjuyqEIKN0zU-IiM_I1UD-g&oe=69F34614"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics":
_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uGj--Ow4EfkQ7kNvwFPmy9j&_nc_oc=AdopfWceedMTiXwaGHc-rAefwgB27b2kBLVvswyxdiv1s1O3KbnjG6zr4EWi3SWsT2Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOTkoRiXkUafonxzRen-wvbMvponD3hngF5daKvEQnRrQ&oe=6AD2301E"}, {"file_name": "leavesandtrees.png", "id": "3627811494209942", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6bYqJ3ff8F4Q7kNvwGrtPyB&_nc_oc=Adq2HsGKaPA0w9Gvccn3kZDLxNBKGMU2RApgyHVtoe9aFyksS9w0El3ht8qpescjPEc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNDqPNBGlOv2n0_cBVceisWF9s8e2wcDP9XAeAxNAZGJQ&oe=6AD22829"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C5r34_nc2IIQ7kNvwEag7-H&_nc_oc=AdosIzu5rZ3HEsUJaMBt3ubgvxl8goBA_KMiYeBMIW4bws1jotlsXZgDsa7hAXba__0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPzjNlZq6yG03UUeGvAKWBUg8CAXVGKWjHPVk3fYGetZQ&oe=6AD249B0"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N39E3KmEEHoQ7kNvwHffGgb&_nc_oc=AdquGxpMrYiV9w9qaL-SYFpEToDQni6hXIYEN9952DCk2ROgqOt67SUe_XbQXvFf5_c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNWMO0jtXqx3Qj6IUMrlTU1RY9M8lYWLfDuv7YFlX-10Q&oe=6AD23216"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qz_god_RYAsQ7kNvwHoZt-G&_nc_oc=AdqLNVWJ8Mowv5CMwi9Ig1TQDMyr4HL_fIE52X-4u702fROCXxZm2hD7GIpIpIFNo2E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjpnU6Mn558hWqmMa-rVPtnbRtKSB0Rcre38DOc8kDtg&oe=6AD24BD4"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics":
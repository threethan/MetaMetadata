_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k_iA0csvSJYQ7kNvwEjcqek&_nc_oc=AdqrNLgO2n3GINlhigPWmDNEBtY5KMRv_glGGmwpkEvMn-MVmYaU5wUGy7U2eWIMrgc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzDdw1beQYbPnTVgZM4BNrgNId2-bKjnNteUVn51TxLnA&oe=69CE789E"}, {"file_name": "leavesandtrees.png", "id": "3627811494209942", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t3G37Ynnb7sQ7kNvwGucemE&_nc_oc=AdpZqKTgZB8malqnm17cjkeGs8pIVVhMfa-McusQSKoFCvX_57CWmqJjhFcT2x2_yGs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwWRsm97UAzkHwz7yiBsF7HpOGyAlB-c4NzIRP5MfC3ug&oe=69CE70A9"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J-2JTnPBNwEQ7kNvwE4UlrL&_nc_oc=Adpi7PoY1Ss0Z01G5iLrfGLyG9jcN0mp_YWkkRmkS8PPZbojLy8Q_-c8QwZd7oUKwZc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx9rbmIUQ01f1dTYVbsdOkn7NcySKT7Pr3MQe5ULJNN4w&oe=69CE59F0"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5_8-xCpRlPoQ7kNvwEK1h-3&_nc_oc=AdqPXZIoaXj-8HBFvZVvyqyokuCRagNwAv-SwABK9yd9cHdEqydryMWcducoX1wPlpY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwn8Dm5EG7GssTShkle8y7b-pNZe0KtwsbTI3IA7Um_3A&oe=69CE7A96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K06wb4-qrGgQ7kNvwHwVeCK&_nc_oc=AdoVPQvb7iLoy0XctZrZ0vUTE6xXBiNUE3MUxWaIWq-zr9ERi6UKaa-H942JURFSARk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx4U9tDABLQbdIyYZuzlrMdSlMJvnyp-O1A0AS0m_AQjg&oe=69CE5C14"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics":
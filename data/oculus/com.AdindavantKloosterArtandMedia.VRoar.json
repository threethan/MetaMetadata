_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pZvrRsFMa5sQ7kNvwFXtrv3&_nc_oc=AdpG7cdvlGnH0DFUjVT2zUkQDUHTzOthoO4zHTBBs-fpi32Bw8qNZ1MT2RRRLUKvff4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Nb_GDuxSrNZIN5qPceIjDW6jtORFgYlTfqPNTmZf6Eg&oe=6A0B1D9E"}, {"file_name": "leavesandtrees.png", "id": "3627811494209942", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cMjY5fBEMIEQ7kNvwGgdluZ&_nc_oc=AdrPGHnUglarUlDbxQjKgKhrjtpKQBixqyvkPP1bTOX_f5eSB32nOaGUq4kVF2xfk08&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4xwAERA8coyOgRIvBDSFPTQCnZ06EKbfBcJ_mDQn7Qww&oe=6A0B15A9"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DiYdZ6bzLYAQ7kNvwEcJedr&_nc_oc=Adp15t3xgTBBPxIz-3PXVvYgWi9ffROUPs1pIn92s1YQ5_NTkjo9K8OtkFX7CPmzPEM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6LlXg0vXy-aI0DpygQq8AS8svDqymZ6CsIR60xOvdpUA&oe=6A0B3730"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8trnjGaTPCAQ7kNvwGYsaTc&_nc_oc=Adq1w8HgibkNmW_1ESMi9Kh5e5JJyEBnz-_cwTacOPRqATJpqnFoc02gfNedARrTkBI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6rBoUauiK-6xaI6kmlk1ROg4BhpZFXwul5Y8Ibt7bQBA&oe=6A0B1F96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RA1y9pff6nEQ7kNvwHKT28K&_nc_oc=AdrbCh9UgaLZne_COJq4XzJrGeMJ1E6GUx0KA-dKY9nbnpg8rYRxBwBap-7xC71t0XY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6vnCrHlgGqE632l1dogJLYUsckF0v9i_LDcaWIAg1KqA&oe=6A0B0114"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics":
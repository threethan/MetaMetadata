_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uGj--Ow4EfkQ7kNvwFtD6l7&_nc_oc=AdrtjJJZ9hZLWp5NHQbUNEr4vzmz0IvYc-xO5ws5dYIzLwZ9V7OJFwaz2Ja-JoZZtQs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM73uJh16hLZ1yOyKQpjAgHYlZ-xTbTwdMR94UOCNurcg&oe=6AD0DE9E"}, {"file_name": "leavesandtrees.png", "id": "3627811494209942", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MaHXqriq2NcQ7kNvwFqrj42&_nc_oc=Adrh8WKlzXwxXwIPUkPkNHjQU8QvfgGXjNcdOOw0JTpnvh4YcRMNBs8vlv1YZFl45R4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPS932naRVJC2h7GWRiafSSMTu21b4qTjmxUIfl4PBCrQ&oe=6AD0D6A9"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C5r34_nc2IIQ7kNvwE_lnh5&_nc_oc=AdowKoK45JZE84e6F8VUSzA0ECV9zy-xvBM_md-si8-OECv8_RV8hZzNYsEYslCFcmI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOApu0EaYApDqNi2I1JsZjrdc5gw0amcXmKfy0vRx_44A&oe=6AD0F830"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N39E3KmEEHoQ7kNvwFuGC_0&_nc_oc=Adoo9MipAIR6OspuUHXV55Zjg6d2ukp9LvCBUwLQd1oueye0Aa3aOlJxDYcKvPwQmWE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMLU_PjR1mL-agJxw7VMhFkblLJkKdUMFNlz8WTDxwZjA&oe=6AD0E096"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qz_god_RYAsQ7kNvwFpk6am&_nc_oc=Adp2d_IDwXPVgQ8nWW_KAdEZFMfsV6Q-yXw912F-bq37EWk6ixtCgPhwhyF3tlLyVOE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO6pJX80O4CMaOuFbFUI7oqz-Ku7rakeVjO_g0BEwzisQ&oe=6AD0FA54"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics":
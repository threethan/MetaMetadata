_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0YwwQLGqxcMQ7kNvwH3d80J&_nc_oc=AdrbzcgpgiW1TwdzB4Verk8psMZ9RPeYEXn3VsH_y-Io0Tba_RggOeYy3Mdu9szSerA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_eMILK46D5AEgFPbNcCG3uohRbz8rwFzKyK_J4uYXNCA&oe=6A3E881E"}, {"file_name": "leavesandtrees.png", "id": "3627811494209942", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7HJgcXJBFZwQ7kNvwGBJ7Ww&_nc_oc=AdonIbH4ACM3EAYYCslpm74guqYqqbxYWTmRDa9eXGH_J_gDeof-vqe_Jrfp3cUmTRo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8qo6c8cHKiIluQACzMovq5AEMCtRIgTp0ojqFzELS-hA&oe=6A3E8029"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qbsQcsAh64cQ7kNvwGKz_r0&_nc_oc=AdqvwWKWZJAi08nqTdVYMZmQcSx8zmgSrG_6zfBlPWmEB7OanNYrtt8E-Y4pMZ5EOww&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-diz4fZrIZmrZEAqc2LSnaQwnEenE5w5gQJ8L53lkM1g&oe=6A3EA1B0"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tAqrFzrmvtoQ7kNvwGFIFTu&_nc_oc=Adry5sXzJzVmoYM3iUev9BRebNp5BJbrBiuV60htgGq_XO-BYvVCq4JG5MeEKInkaQM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-JEW6G_9IqWD-d96GULja9iYS2rdeMx6gA_6to6di6LA&oe=6A3E8A16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hgn7hUysg_gQ7kNvwHpk1RK&_nc_oc=AdpTV7CYnvbaGoUFGTvagcoUocyc2FaD-qRczXqtbEtJX4HnRQRVQqM10dQskhRnvuk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_1yetVjBsrHHaYsWpr_PM2Q6_v0LQCF980_-wvmb2Cuw&oe=6A3EA3D4"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics":
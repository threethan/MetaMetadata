_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qi8MKXFhR0sQ7kNvwFLqLfw&_nc_oc=AdpcC-9sIrmqfDJz88fgur14ivbyFhWc-C4Kt_Mt8rJNzdj5qqrI1C6z1AKv7pSWP_k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af66IaJhJ1HfJcujyyWuPLlsSF2jphJPaCB2B0_8kSsB2Q&oe=6A20359E"}, {"file_name": "leavesandtrees.png", "id": "3627811494209942", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xR_vEAtAdDcQ7kNvwHsRKnX&_nc_oc=AdpsrvAHb4IwY8Seb7mq8bCoFtSoWTYZbbJiri9os2OG41_lvAcbtwnmLC9Fee3wGBw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zQ_XaZEAB74tL5bweYshbG8aYK4SCckCMdMKCspySFw&oe=6A202DA9"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pu82mV5YDGMQ7kNvwEWB8kH&_nc_oc=AdrVyhEd9bkQOqIp_voB-sRC4HACRNClBKjn2XcH3kaYneLWsnez6cNK3-GLZSxrpl8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6MJZ-5ARRflmk9vda2A08OLjG3zNroemZyp6YEMko52w&oe=6A204F30"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pcYS7l9Y2vIQ7kNvwFXuDwM&_nc_oc=AdoC6lM9WwTFigBBP8sjmL4wINustCuZCFt6DSGOHxUGp7AlxE8NWi8BK6CdpMLgIbY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JT31Fx9p8Fx5suTihJ3B58A6fMAOVgpu7aoICWRooSQ&oe=6A203796"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aELtzf_h80kQ7kNvwEK8Tfv&_nc_oc=AdrhfYkqgejgGO7416OJCmIuWdybBJ-MBCeXGAvlnUriv-6o7sz1csPwaanqYFZ9ovU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qVi1xeUKYa8exW4OdwnR7r_c-BhZN81CWZmBkglBFlw&oe=6A201914"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics":
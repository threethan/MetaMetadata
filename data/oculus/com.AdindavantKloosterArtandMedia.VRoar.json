_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vcIxGnR_eowQ7kNvwEtr46f&_nc_oc=AdqUMetl55TGmj9wqbCk0JlxxoYyal1vWlNRIFnwOQtaLc6BdbzErN05SIl3v-zayKs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJtpm-ynfp1p7jDooN12keBgoW1M_R_kgPMusPwr9v9Vw&oe=6ABE699E"}, {"file_name": "leavesandtrees.png", "id": "3627811494209942", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hKMnMZsh_a8Q7kNvwGMKsFk&_nc_oc=Adp6d7UzMmeuHu63DSWiLqoHX3XfY2uOEMsBwDy2uPyZsFTyu9q-0awuHHv7u_nEyZg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXsHZbB1lZDCzC-SFbA-PRemdHTNlaV84Gx4TXhr441w&oe=6ABE61A9"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ITCnPqLT2FsQ7kNvwHa3dTp&_nc_oc=AdoMGF7Gdg5t8Rnq0hgmkBe-6y_zq6fL5NMDxVEg8865zIzUxTG18bs4vVPtE5fpNmk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLZd7wC7zIG3xnBOm9JLiiB_vosJNWd1IVjVuSo0bkww&oe=6ABE8330"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UqI9qCXgV_IQ7kNvwH2zKuN&_nc_oc=AdrH7FYuvNmEQy1gc_NHpR3_4R_bRiA6SQUMVpGNf4fcmSBAZOD1ufl5xq0c_VKHOLw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKD0kaCrzXX_BJSQNt_0V2WdZgBK5XxNjIucO641tWBJg&oe=6ABE6B96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tc6JAbr5_ygQ7kNvwHO9tHx&_nc_oc=Adqy6BOyCP2-tZg1ml51MH0lspvA1GjiW2B3YsHO12cm0jtU1op00gctvTt42HEXP8A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJoQqkL_fS-q-RzHY7OmEU9Y_Y3g4Vts0mRmbQvPuQ3tw&oe=6ABE8554"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics":
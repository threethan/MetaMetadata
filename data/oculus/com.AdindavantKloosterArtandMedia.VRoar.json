_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HE_JbJfGVDgQ7kNvwH5paHR&_nc_oc=AdoUYfDahkRWZ9y1Dd20XpWUX7RNzZGJ6PbvJrJf9GlwnOS5OgX2n9HYADZQNTVl9CM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUmHIVlMbIPdd0tCUsSHbDX2IN_01RP01V2gG5FPtaVw&oe=6AABF49E"}, {"file_name": "leavesandtrees.png", "id": "3627811494209942", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NCJVtl_28wUQ7kNvwHkW1aF&_nc_oc=AdpDQ5ruqxBPxljhF21XIuJ2V-rTP8dh7oRVNZ6pRmkmAf-VKvnXme-bvJi8KVt8yBU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4mls1V1t4r8nmVNJ_NP82YxKwKyUoXJLbnxfD8acsTg&oe=6AABECA9"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-MxGUHlAnOUQ7kNvwGNkiXd&_nc_oc=Ado82O3tuwi5ISidjoLkrQA5T6Zs8vowefwA6PvpShm36cCWekQBxz_NmVQYof6ncwQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJofOfcoZZATSCxHEsXI-NHhZ4TDKVwS1ungfs0Otlydw&oe=6AAC0E30"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cMXR3lUhOagQ7kNvwFxIMT2&_nc_oc=AdrH_wc5o1MwLJPFe-qfmJvn4PpHkH_00m4D3qRnbPHO996ODYwEf-Tj9Gd7PEkCjmU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKzt4OCO5FI5zVDW-dd_XOLtjV_JAf6JJWBVzQgT7gWIw&oe=6AABF696"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jbf9RYsmKXsQ7kNvwGmFgp8&_nc_oc=AdqMsQgYiE_qW9Uferd9xScQSXLkc0H0VA6JyouTiYohdas6tv5typgQ7dh_h06gU7U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8kkZzdtTE_hAP3HzD04midJy-mzpyrFhpYbqf0eEVFw&oe=6AAC1054"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics":
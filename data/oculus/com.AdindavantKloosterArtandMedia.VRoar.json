_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JTBkJu1b0eUQ7kNvwG90ri2&_nc_oc=AdrVKcpW0wsxMU5NdkmgGR3gQse2-gfipRjbzhUe9fwPT7e6ARHaiV0JOzS11WyZbac&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af32Xhtxpy7epxnbJI0hL9OzsoHJYPxPllsHT1a3yQJkzA&oe=69F6059E"}, {"file_name": "leavesandtrees.png", "id": "3627811494209942", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wvtwuPs81UsQ7kNvwESW9kv&_nc_oc=AdpT6Tt9Ywf95Jy1MHdSkmTXGIbOzIcB_a10QFFnh-llYS9tAsUOiopnma_3aAwsI3M&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3T2NZI-5W7AuVShkGlG3LInbOm_4RhemdPgrj9fKrshA&oe=69F5FDA9"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9N_BuF5kwPIQ7kNvwEzwFdZ&_nc_oc=AdrJXlYXxv5-e0CvUsKqhaJFQ-7Dy4r0BAjhWW9I4En95sG3CmKQyqGGumpZ7fhKpYM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0aWfb2AcVRS2SQHqeZQnmmVAYgn6KSiaGTHU-saQ68-Q&oe=69F5E6F0"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3kHVRXTZ7hgQ7kNvwGSl_vP&_nc_oc=AdrV87lStLKofO0cr7F7jhsWgmKk3rate6JEjkXaMxwHXJdJ2FKTvvKLVTf1aYf75bo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0oK1XeoPMRTXfkAPR02-iTC0wbWGWWBFteL1BYxpBBRg&oe=69F60796"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UZJAMDqvd80Q7kNvwE36lf_&_nc_oc=AdqCgvOYcGkjxgfpo273BxP38AC_e8SWMnU5-7hri7TwZSBJGFIIjx173UIoXAgOuuk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1IcZVDDWtSJJZKBGws51nNIk3YzNvGrZe1aSVgQOt6aQ&oe=69F5E914"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics":
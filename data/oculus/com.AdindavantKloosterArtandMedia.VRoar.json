_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g8HwYn6S-GoQ7kNvwEozL8O&_nc_oc=AdpIwM_lNYM0W3XbrIzdVlKc_vRRFJaX6KLpGONbKbisjUm8dZucYiFKXQ-Icu5Qu7E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9H8F8DfJy0muiMkwcJCqT9p2nYS0sc71D5UX0fZFKDng&oe=6A2D649E"}, {"file_name": "leavesandtrees.png", "id": "3627811494209942", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tAuGce0j9owQ7kNvwHA9Gm9&_nc_oc=AdpkW7e-S4qpa_Jv9W4UP0DFrpW8Gh_mOU1S_iwKQVFrO2eikNXl-gTqWAwfMRg5hac&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-OL20WP5Sb7_3Af2X5h-6-owe5Vo_knxz6HzsW6_quKg&oe=6A2D5CA9"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bnx-_B7XgTEQ7kNvwHLjSRK&_nc_oc=AdpVgWMTJw_GIJRfNzmIBkGX22nyyplpnY7hGYHZdYS69LVqIR2-J1NVPq9zSutpdxk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_psngYVTFGOxI3dvD2mW-nnPPg7fjgjFsVE5Zknb7hYA&oe=6A2D7E30"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QGXJV9Fib0AQ7kNvwFMHfuJ&_nc_oc=AdqUP1qiEd-TgdW8QdEHAYs4tMRz9IyYNBHgdkBIVVeGKljwzXU9hlOTB2mveuCb5wA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80fFu67PSs9WwFnSaNx9rVDrjBBvLwZ9ObnKNd3IsZYw&oe=6A2D6696"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zjjgyQmY_9AQ7kNvwH5bRAl&_nc_oc=AdqPgIzPhjdqfjw4ExoCPkvsnKK-agnxufao3Eojz8jCLYCDqVWZ9NzhulmtC4ru0lE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-DBmU6fVGQMDNIA2dN4veKzJgYivuw0izukYaNJTOQFQ&oe=6A2D4814"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics":
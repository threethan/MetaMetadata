id=6e7a0a&_nc_ohc=zScnfkki3UsQ7kNvwGmugl5&_nc_oc=AdlQcAiHK7naNUPtRhHsyxRfYhr32F34vToNxaeW5VV2-nV527WCjNN4x4grATbbfB0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy3ay9bjyneXz3uPd-FsCk6pt3prKwPIEzUxe04uJGkGg&oe=69B0261E"}, {"file_name": "leavesandtrees.png", "id": "3627811494209942", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NjnKTwLlIFoQ7kNvwGIbmG8&_nc_oc=AdlIMdP64kO2aRurl_8n5SZs6eMBhc6I3jiTScsMpxLQ6WVlz9SzQ4NGOJ6n739Iml4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfytzC3Bkt8VRF56wcmh8-7NOQh-SuMFwwqGcLYiO6jslA&oe=69B01E29"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RNYAXiTQozEQ7kNvwGB-vpi&_nc_oc=Adk3BwQmFjeqcqjs8eIh1Tr_0DspTaFQAf3xX22w5q8pXFeZEK6g-YAVBNJ2xOfQXg0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxZR608lzJQwsE4vWyg2svX1ScX6gU99ad0bKbMORUgtw&oe=69B00770"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Tcu6Oj_AqQQ7kNvwHIMmo8&_nc_oc=AdkJf_uZI4X1SANDGYYt-VMOJxbJ6ecHlT98XYEPsQrczfhl8lUfvRTvyY_nQvxIGHM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfycxtI_Ko67AC2cUFMvicn6EdN5NDMC4bXYl3-8T2BumA&oe=69B02816"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tOlSuCf7BZAQ7kNvwHTjYJ7&_nc_oc=Adk9-4CohKhgtXVwBE12i-BMAG9bAe5J3FNPors-NIEjjtemQowPaOWIakXLshcQr4o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxRYgKZJOn49mZAEKfpusaioJHwhVm0yKl-ZB3rMJ-_Eg&oe=69B00994"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_p
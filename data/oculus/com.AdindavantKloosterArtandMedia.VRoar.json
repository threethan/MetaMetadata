_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ii29BaP7pfQQ7kNvwGgdpvq&_nc_oc=Adqej1uRCGEhWE4Y8BD-cPaDpy49D0gkMZ49Vo4ri9fER8wIUooD9EkorAN4z5ouoA0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFBNf_-QfZxCRzE5e7zBGjjJkBJnyVDxi9H-M8ZkXlDQw&oe=6A74959E"}, {"file_name": "leavesandtrees.png", "id": "3627811494209942", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W92TbAzwljgQ7kNvwFCxyFG&_nc_oc=Adq-jTTJ2ABwuPPgxx3XM_HaCmrxTMYD2LpqvXplCZhZaW1ebSeF114c6MxUlFpuX-g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzprIm6H5y-5dU97fS6RAOs2p5FERxxEs3Ne7XV0Rbwg&oe=6A748DA9"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cxn0uzGfOm8Q7kNvwE1d32A&_nc_oc=Adqt5oJT5nw646MYHXrXiMUO4JtFDda7JH7CdN2-45DOONHUKexU-5IPLtXGKWy4mOU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdySFHUYfzqd4Z0peYZ9zkFxeZDHnXeCrHpYAj7ZVC6A&oe=6A7476F0"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yF_iALjUlV0Q7kNvwEOkiTB&_nc_oc=Adq1yf-3LewlU7UVctHAzMthxXlCrNEdBOGCD24tet26tF-Pv_WHzk_unEzvREZtVuU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFBqBis1LwKuoydsWO-YPph4C0D3EWvtioKAOU2tdcFug&oe=6A749796"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ymlIaNwu74UQ7kNvwF2fp-d&_nc_oc=AdpaZ9y4e4YD5KkTTI6BLOxWMRSduUMOCrPT_z78z4nilGIeCb2HxHOvu_orUAAH0nQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5-ooErgqjkhkQgUzYm0V3Tnxj8oc6q5nnoOu07KlnOg&oe=6A747914"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics":
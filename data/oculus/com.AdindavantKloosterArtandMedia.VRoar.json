id=6e7a0a&_nc_ohc=DRo4-t9jg08Q7kNvwHfQuci&_nc_oc=AdmCAkBu4rb1wRSBpCtThfdrMfVeB6k7CSzUF3gjmRm6i1qVh6FP3JfwivweMGb37rw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxLisGzh-OJOjHGWvv0qr-Zw7bFA4M5J6UQOELAdPPupQ&oe=69BD551E"}, {"file_name": "leavesandtrees.png", "id": "3627811494209942", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MSD29zVNrrkQ7kNvwFcj3-_&_nc_oc=AdmAC5k0McwcTRBjZQawQZ8jOblqzTqLNaXY6dv7pKzyFDPCBGazpV52aBOrA4rvQ_s&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afz8BhiKfvzUXWnn5g6Kk0y_kMZ_HjKaafHYh9kiJ3KEaQ&oe=69BD4D29"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9CELkB1Ia1UQ7kNvwEYtXpa&_nc_oc=Adks4AHetf9PTg80v_C54VQcLT6LPLgfmt1E9W_qbUUGBtSOWdz4Ko90ayhoH8Aaau8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyDqQ05fm_pwqmMzX-qp_hKyAflrn2YAmWNtsRACdjQ-g&oe=69BD3670"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_3bMHEVnwvwQ7kNvwEGW7Bk&_nc_oc=AdndRACqGDgg0SAWllAjS7YCWrLr-4-a66n1IiaaIWL5PgqaIin4OFXdcfmnSCdTAWU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afx4K36Cs5vQ5aYaa4PXmA1XTRj4WYMrdAs_0xBoZmDQmQ&oe=69BD5716"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2uO3BdlZaxsQ7kNvwHP40_D&_nc_oc=Admelbl_gsHaouY8PS54Ik-e2qq-b0cGCkXaefVY4BTzqngALw3sDOmKxujJ9yrQClk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzH4l1NPXgDf0qIBMHPJBISVneSuVTs1vkzWLw5-lag_Q&oe=69BD3894"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_p
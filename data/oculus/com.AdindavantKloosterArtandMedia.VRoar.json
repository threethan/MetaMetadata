id=6e7a0a&_nc_ohc=cXLxXS3MjTkQ7kNvwEJaYLb&_nc_oc=AdnN5NGeHl0DhdMhiGkATrn3D2nOp-RIe_RQn3sURzK32EzLtRUw0N1nXp3nso1Rrx0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzTwj_GW6iRXc77c9ivSWaRfbS9rvi2lT9Ct80mKU7qQA&oe=69B9609E"}, {"file_name": "leavesandtrees.png", "id": "3627811494209942", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ze5SpdwErkQQ7kNvwHWIjz-&_nc_oc=AdkufA0UF9jpMhwxNnVJKpJ9gkyyRw7QmQjbGKEHSUBv0NRd8ZSwx_YHNd-x2p57f_s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzUBixfwLZSpNzi1Hbtn226cD71EBrrVlLkECB-IhLhZw&oe=69B958A9"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F9ApTV72PL4Q7kNvwGw6BNT&_nc_oc=Adms_X84aVYCyz7i9amb2caEoumayj1V78bJ18v1WX3HbybuBUMqZI3I9fMZot32KN0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxevCTAEMfgYVxfsbNwUzRCcJTHrscLyWGbcDF_ye6Bow&oe=69B941F0"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1TyCqtUNEgkQ7kNvwFUNaKt&_nc_oc=Adn17TjhviQ0LHcHYAN5xtRFa728QQrRbx_VEOqkcp2oh-SdhCiSXqoIUgCP5OLF3X8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afwgsmzj1rY8EkdTMGj5wN6l2dJfWE6gW9KdzGRtRa1-ow&oe=69B96296"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NQqtsDs1APEQ7kNvwGM0rey&_nc_oc=AdlqvEssWmZ9WM4wJccltgTJFAgHl3KRVvfB6GdHt2MQdsKwz7SsPmUiy8djEuBVUb0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxFVsT0vjzvurVHZc2-sFeSpeEa28i9ZUcymG8tovC27Q&oe=69B94414"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_p
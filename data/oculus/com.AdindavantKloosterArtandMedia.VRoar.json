_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qypbOo56WlQQ7kNvwFH3scT&_nc_oc=Adq3a86w5D792JKCJEklI__9d43muD7u6SUWRJtD3K5pBnSH0fd4y_tUzlWBil9flfg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2QhAtsN7WEyZgsaAkam-0MlY-SbYGKME8dB7NRm-4jMA&oe=69EF6E1E"}, {"file_name": "leavesandtrees.png", "id": "3627811494209942", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E8bOqa3wR3YQ7kNvwGjsNtB&_nc_oc=Adr4nWUTejisVIygZ4JVLnkmVfsr0LO5Pq6LWrRySR1oeMp-lFKARRBX3W114Dv9EMo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af21K39-Fb1diNsQmGThnoMpUjVXEKl5kVQrqdzQdhrKaA&oe=69EF6629"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BEGSYIzr1OoQ7kNvwGj93Wy&_nc_oc=AdoaUely3Tq_Zip2PlTbIutqUxkoIMHw-t6cOnbp5BQ6Yse9TwZjlp5LlnfPD0JVHnM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Rgn9x7_bnojZh79wkovTPPqYJh5PjsJOx8fLI09AEgQ&oe=69EF4F70"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ahx4hpBnGBUQ7kNvwGobUUu&_nc_oc=AdpTXXLSIArB6t3EPifu1z4zl22RxqW1Saty3XuSHxx1K20biWrSHk6U0lHouhY7NiY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1TdDOvjBprc444VZ9hOB673jxZL724XX_qiqGsuFNVaQ&oe=69EF7016"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B5rowScfEO0Q7kNvwG4CL6p&_nc_oc=AdrUkPMbeemQ77zlmF2BIq0e3LID780d2rPWuUJI1Lg782rZfsQUe0AuwhuAVJWOCY4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af00FfxSDM1SQSBNAI9RFR_F48Yu54c7URXZNOZYZl0asw&oe=69EF5194"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics":
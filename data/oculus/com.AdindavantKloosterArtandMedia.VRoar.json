id=6e7a0a&_nc_ohc=kwbffEhgYBYQ7kNvwGLxjU_&_nc_oc=Adn5I3qo1FwiW_Fp1mhzO2Jbnw3_xpTDXpgirL717vsIRK9J4WvVnXTt5DEYf2gdx_4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwjISwDMUrZICntTBlQ5wXgZQH5OYBX7DnAi93enq_Pww&oe=69BFF81E"}, {"file_name": "leavesandtrees.png", "id": "3627811494209942", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MSD29zVNrrkQ7kNvwFVMEf_&_nc_oc=AdkVo5FiJi64cC6wXx3ALNHi0WzSzlZ-PUsMlslgBy6QitGaRIvWT3TSAEFmbB4Lc4A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwcfRsPDeqrkK6H-sp1MrR9taCKAoq9egXrAowVkQOawg&oe=69BFF029"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VnsNjVYupc4Q7kNvwFafprh&_nc_oc=AdkCorYX2GWwF84ORxuW9zQnUjR6BKF-n8DxXuHpJu2rKj-iQUq5Dk6fpJ6rTDgjuaE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx36EGaHUU8rAMXPxebpPi6zW7L-iKW-EsT6GZN2XMDig&oe=69BFD970"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dzEGyHxLFj4Q7kNvwFttJO4&_nc_oc=Adm8N3Xg7ZGxtNF7F5-WW6_9NjCIkVHBiB63a6ajlamws9BMaDfWWR28woRb24TtEq0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afy5CohZgGntWpv7sN-dhAsG6gl9_kbAIHU5ic9EFzpXcw&oe=69BFFA16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2uO3BdlZaxsQ7kNvwGsHIzu&_nc_oc=Adm1143Fwz639ya4niBqC93XQ3db3brgMZJ1zP18iwDLHhfmlEDLYNxQej53Ik0J7gk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afyb_zMVRw9nNnvdHEi37hFuC3TFilrdaywYPyFJuzV0kw&oe=69BFDB94"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_p
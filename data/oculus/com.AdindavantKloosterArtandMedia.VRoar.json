_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aPCFyqwVeGQQ7kNvwGMMnMk&_nc_oc=Adr25EAlqvks6VjXtOLuZCNwXgf-AR28x1t4QXuIT7nNnwug5hsLwa4KEx-H5l7r_IA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDq5Ymo7tV7qDaiwhQADJFNfD2X4rTGw6PyaDp3ofPszw&oe=6A6B5B1E"}, {"file_name": "leavesandtrees.png", "id": "3627811494209942", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VS45I6tfnm0Q7kNvwFm3rJT&_nc_oc=Adpom8hpRVbeD_BVp9feNKdgm6UnI73ctlqyTNjvAPvq84tQCU8K5V85st1talVSSTA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQASu4WAlbKbT_ty_L7BjdsiTe3ZCSaB8i7yMzZ1KnBtHA&oe=6A6B5329"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-J0f_BRNODkQ7kNvwHiHzFz&_nc_oc=Ados1N2xztPXvK7L5Wt4Euq_hvSmZfiPpwavLiy7g9AMyFwdzSgaM3wzhjZC0vcgYmE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAVyI-oDvnUOvCetzRjfTT4lv8SBH8BxAdF8KUabmZd_Q&oe=6A6B3C70"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-WIQ5hznLFMQ7kNvwFKQq-a&_nc_oc=Ado1ABuXV-GbeV_qHOK30502XjSAnSQnsFFXprLZnKERbVTDIKcj2X3EbA_Gr3hA8c4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDyR-Kyh43u8-ydXGTNA788oQh7Ic-MYQFNbH5_MM3LGg&oe=6A6B5D16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-Fnc4O_5p0Q7kNvwHbsYEY&_nc_oc=AdrWswIEnONTqIfaZa_n0AKErh1A9AumrFfE62Otcc81iYKKhwjd5gsN9AaGnSJ_UuY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBurYCCwwKLzmpgYA7JzNSkZe_pq3iyracCBByasg8psg&oe=6A6B3E94"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics":
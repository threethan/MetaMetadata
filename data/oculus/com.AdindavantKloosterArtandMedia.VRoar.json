_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MGK3DDUOLDkQ7kNvwF3Kxaa&_nc_oc=Adp9aTaBUNq8pxcBHW97lSxSasKHV0dBRaJN9IFZfdWQ0SYyqigXnmtz7bgpXcd3z20&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcy0rdGV_JHg2R0h-SOg2vT_fDgoU7Zl-iJahaKR_u1g&oe=6AEDDF9E"}, {"file_name": "leavesandtrees.png", "id": "3627811494209942", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q60Py0NDA7kQ7kNvwHpFWRE&_nc_oc=AdpKVEiePuUHNrTyS76zJY0H5eG9ofHw6a4iZMUrLKrJMYiOHR2YYBRx4J8AsXUJ1ag&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBgy_JV_O9MtxOWFkW_4Ci5TFgcnqBcorLHhlCb2HS3Q&oe=6AEDD7A9"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z3xfOwVmwQsQ7kNvwGqZQ3B&_nc_oc=Adrh7DYeVY687ZbGy1n4bdZax8P6IoCypdu0Xl4tXMs2dT5i1lKqw7KH_m-xREBSAAs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgpRaZngCpr-8yjVoVN2MBTkNEgbCp2JVAcOq-SejxOg&oe=6AEDF930"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_-2M4Swp4VYQ7kNvwE_efxG&_nc_oc=Adre_oMFjRhMNt5_CIxWHYuMAjHjZ2_pEdTgMXXxZRZjS4-V4mw25tUvC0KOv2GRGr4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTlRU8yzBQFcbA-ZuGWxXB0_lL7Cx2rOn0MNhKsLFN3zw&oe=6AEDE196"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L4G7YIlht6gQ7kNvwGDROTn&_nc_oc=AdrQlmva4rd2eKSDcf5exKnuUnNBfmXbnweNF9dLEeNR07Nq6EjktSRMMhUU3JDRNk0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaD226Ch4B2rUz_oU-vJp9dxjd736fyKgZAZuymR6syA&oe=6AEDFB54"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics":
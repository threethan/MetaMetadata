_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S6Ap_sEXeAMQ7kNvwEjJek_&_nc_oc=AdpSORYnAEd2eVoc55SGKwpXVomlnKd2dIAKATBq0UKIBydC1mI1xMRHdiePZe0C9JQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43VpqCLUHKevEG7Hjq2npkqmFsmO-c1TgrzuJ5-K_RPg&oe=6A13069E"}, {"file_name": "leavesandtrees.png", "id": "3627811494209942", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tdGzwXfucqIQ7kNvwEdFvAx&_nc_oc=AdoFfyLvfy8BXxkQc6gAGSJeVDT6rHuiUJ3dmJhGxeQmElvnAVboNxoMe3kzww341XY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af76CXXfjuB9zHOzWUBwXEOdseVdkre5nIvuE5tIuYMH4w&oe=6A12FEA9"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=avsLjuUEv0oQ7kNvwE831Fo&_nc_oc=AdrGCkFib2gLIgMIZ5KYjbnxFpo4UFPpqU2J9QMVfZXfXX6WYscEbiVy-JgQz8ESG3k&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5DKHKGfBtNmyEZ-YUQ6k8T8L8UCLEoheGErNctKFxiXg&oe=6A132030"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BlRD_f7M4IoQ7kNvwHDJFaY&_nc_oc=AdorJufmBEDVJQlKH8hdb-S0ZCkpOqrQsy-4jW4tB61-K2GfhQTQ-2iRw9ZpUrT_QIY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5hoLEe8ImNaA07nm3oXxv9HL7qYp9xgql3f-g_0cDuvg&oe=6A130896"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ztz4COe88ToQ7kNvwFRHMn0&_nc_oc=AdrsQhP0-T8WOsQ3655gYM5GP4CryX3-SM0okH4lgauKYaWjOgu8LDtitJdrnMV-mXI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WHwo6KFGHbpALODLbYptbyHPQWqXVoNdaO-D331JLRg&oe=6A132254"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics":
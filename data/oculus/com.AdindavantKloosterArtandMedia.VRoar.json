_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zeUhgx7E5lAQ7kNvwHbtAwm&_nc_oc=AdrT0bOrowhVBepIrq44Nu-e5goeBJldwKtr-_btOwHLm--v7DnhXzY1fMWl6InyzbY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJn-btipPska1pzg4rJDTLqwqnGHHX1ua0MGV5JkMu9ig&oe=6AA0171E"}, {"file_name": "leavesandtrees.png", "id": "3627811494209942", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IH0hHYSHLREQ7kNvwHsKYVG&_nc_oc=Adpr7NkZp0toFMalO8SHlODbuoahSBkOuYwBM4x4Pv7oHvExlECll7YLD4Ns6AH5uZA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLcAJ8je0ACH7R7ElxmPR6cmgpyxjLnqHR95zY6DZ9HA&oe=6AA00F29"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YHy0G7U_GHsQ7kNvwGdM0Zg&_nc_oc=Adpjl8izX2B6JbIluLZ2Z5TEunWjg02TAJOoR2X1UI6AhRR33qGYIcKrUDa4GeWRLrA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJuNByDCoDtxGiOLXU4PGuvPyQ5FWfCyCi2GmqstU8G7g&oe=6AA030B0"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gQVH09TYGX8Q7kNvwG2JuHU&_nc_oc=AdpOXH0Fg84gaUd75e-cQyKtEfg0WESLY00FCiRJlGsVlQO_G4U_Tju7v2fUX9jS_SQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9ItkXKIM8nJgoaPPEDQsxjno-pX1H9jF7lazN8_gfCg&oe=6AA01916"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qKiazRF3qJAQ7kNvwGuHxii&_nc_oc=AdqOjEIK_N2Ht1I7ZSsvDsqEvi_7X5Y_Kmr0RCiTyffgu31a3HARvn2m7b_3pkuWhj0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIaO9Ckk4HXgEcKPbhLFLBnUlAA7GmbHnY0y7qnIt23nA&oe=6A9FFA94"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics":
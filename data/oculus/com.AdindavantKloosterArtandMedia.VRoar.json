_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9DFM-7bBiGkQ7kNvwE7H3gv&_nc_oc=AdrfvPtfO0L6zPHXgg9z5U2BDFs_jLW9UWfWgLD_ElmLQ1LMP2S0QKjBIyOkbLTivQQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5D9MTA0O0qez0mXu_TKNIzDtYNHCqgQrlv_3hSl48nog&oe=69F9FA1E"}, {"file_name": "leavesandtrees.png", "id": "3627811494209942", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ceqvRkqNFw4Q7kNvwGdyJAQ&_nc_oc=Ado2sirZXguxlEz9MWhsYtPvN62d-IxtZHg8O_drS4eb6brRdeQx121v-MTzQWx2I-o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vjntsKDEwcqbs7f2lTF0TnJmBy22lNGHOXlwzBAoCFQ&oe=69F9F229"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mcl3zaqw00gQ7kNvwGdsY-5&_nc_oc=AdqD3F6Th0tmxaM3RQkSYWXaNI9vdAPB4oY82EAyX-mjOexIspGFeSmx2vEEWSweecA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7cBv20OVTauxS93SIe2WkAwh7SSGVxMQlXRhUfVtwBLw&oe=69F9DB70"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A_wvU8E7-owQ7kNvwHjYSsH&_nc_oc=Adq6PR32jgRtWuTBgLc5K2xloy_uMQ4NxU1G64QzKqd-iM44bwl0eH8i5c7rfTwHltI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4V726BYTAVDUyo8Yhn-BZZcKhBHX6DHQYELG63QUIh0A&oe=69F9FC16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u-uDkt6X0RgQ7kNvwHHm6Vy&_nc_oc=AdpvjEyKwketfEtZOzFzBxbc6mrG_zawmqqGaRNQvf_43HMuE7X8DogK8PujLoTrRRg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af57VMj9pMNhL9SZ4muExZCjD3UnbsuLm4SfQ2LpURkV0A&oe=69F9DD94"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics":
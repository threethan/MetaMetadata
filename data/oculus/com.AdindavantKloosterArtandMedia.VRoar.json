id=6e7a0a&_nc_ohc=zScnfkki3UsQ7kNvwG4tIqK&_nc_oc=Adm5fhyPU3E9rwbIyZjCPvNawj_a4mlG4Kj9VK0jwDlqj897fMiM-7EiPbK32KXDy44&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx95qJuksgwzmlhfhwZk-1Mi_F_UIPTtGS2-RY98b3bfQ&oe=69AED49E"}, {"file_name": "leavesandtrees.png", "id": "3627811494209942", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NjnKTwLlIFoQ7kNvwFyu1lC&_nc_oc=AdkSDT2xgJA3y9ynkRhPyyJJA3dH6S4CYtNa5H5s35ZOWDz-cAfO1445zsxhxTKgaBk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzi0YZ1wVCA628qYPulxOeyK95YTEsqY8U1XLyms1fLkA&oe=69AECCA9"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RNYAXiTQozEQ7kNvwFGq4Va&_nc_oc=AdkrsWjJSfopq79nxMslNmu9uIVJzQrlPFF2RmGwlfoR8VVnJlt5kctE3fjkDqacW5M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzKK08j527voJWLlhELpSlxxE-UaVCoYPmWFemhje4j5Q&oe=69AEB5F0"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h0nJ9oxCs4EQ7kNvwHWeLHx&_nc_oc=AdlQBj0lPbzi11exLnppJAtk6oJIYrrlVu8eRBF94OzW119Fykk9TaNhkEMUjTLguSk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwVZDIA5GotW4X2CkPnsOwtY5OFg4vokYYG7YgX5Fnapw&oe=69AED696"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tOlSuCf7BZAQ7kNvwHD_8Pr&_nc_oc=Adl-l5Q8a2z10nx6qyljApx69pBPONyv_RofzJau5BeO_Qrm23XWdqpX0yya0JenKns&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzZAeUTt4SLUpxSRmrf4xrCiz7jgP0BZLbQnQ-wM3dE6w&oe=69AEB814"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_p
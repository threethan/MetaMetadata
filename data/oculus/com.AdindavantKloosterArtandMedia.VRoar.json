_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G-YK61Pm__8Q7kNvwHPwoE3&_nc_oc=AdptNv70UTQxOpTAYNYzvRsfCYMPXt_kKScuM42nWv2-rHq_rN3tF9zOsFhESh140rE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDdO9qplpyZMIn6UzMTy8r7UcOX4OND4avpCb0Sls3FGg&oe=6A5E2C1E"}, {"file_name": "leavesandtrees.png", "id": "3627811494209942", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m3lOzlXw5dsQ7kNvwHZuy6C&_nc_oc=AdqOOg_Ps_jj_Aoaop7XlJ1OJJ6jFb5tnnx1PYRtoBJWSI4ckhHM7lFaWm3ApNBo7UY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhyrPWwKphgGjZemZrkJLT3RQA5tXGoSCyvt4Pd8myJQ&oe=6A5E2429"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hvBhYfsOBlYQ7kNvwFXNAIc&_nc_oc=AdqhBBhK2lrbDTXu23SAi7X8ZNKWrnG-XkIVnn_WFLm57QmzDUa2XtzONj5xYeOoSY0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAgaJM5_85C0hFLAckm6QmcyrttCbUk1-SE6fxr2BWZhw&oe=6A5E0D70"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jv38QeEraNAQ7kNvwG8aid9&_nc_oc=AdqdbYagNSZbPjIXKPMm4bsL_ukWmobkEgpWNrZJA7JZOwQ9_z4UFnnRs489aIKRbkw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAfUFXLUMu2Hcg0YgKkjE15gCAozuyzDHmKgRszHjE1Eg&oe=6A5E2E16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PmcysQFjl38Q7kNvwEj7iKW&_nc_oc=AdodC_4wBST4EulxeARQMDX87iVSM1KxqkoETP6Kd9BtwQTGkADUqOWJ2PIrQkgf8Ns&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAPT_xsdnQBv1R905_85LIayFd_gkUYcSVDDBG7D9Vm1g&oe=6A5E0F94"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics":
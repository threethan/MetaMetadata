_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CokGy7ifbL4Q7kNvwHAKHRd&_nc_oc=Adp-0wNRkH4xH0LE3jW1JcIM0tGGFzr7atyi104b8lWIVuLSONjLVlbYkJJhVRuYK1k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBNOxJcBRJAVAhWJzLs0RGOnKFHBEPiWWvRPEwEdA6iQ&oe=6AA6AE9E"}, {"file_name": "leavesandtrees.png", "id": "3627811494209942", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4RVSkNIN0ykQ7kNvwF0isQb&_nc_oc=Adq8puEZ2mwSSE7IA8RToaTXqHqxto3onkMSIsbW8Z0XUnwxyTBUafaDnFTu_wY5mjY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI3Pdzyo5M021BEZJerGeGc6Bj6TVs96fulnd50EsOSbQ&oe=6AA6A6A9"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BYIlL97M3zEQ7kNvwEU7oRK&_nc_oc=Adq6bD-OKoNGRAq3TvKbsFluvtgyRkF9ZVT26URtCWL_f8Q-pzysFZofuN2XYXT5CwE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIu26ERMd7JwJOh4qv9_bXfBDWhZFXSgnBHrJhQMlbr2Q&oe=6AA6C830"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ylqTfA6cjuIQ7kNvwHTpe8G&_nc_oc=Adq_qmLvRmWXD4wNpTSG6RSfzViVS6qhfZ9kj0sSTOimbO8f3TKFZr0yBhffb46Q7S8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzAYo29Y7Oq84NnnMI0a-_8xe-wdMBTGUfuDiIu2ZHUw&oe=6AA6B096"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=If3iOeM9ExgQ7kNvwHl3PYa&_nc_oc=AdqLQHqadt__VX3gcVHNXi0GzkRnQ6nuukvsWx5u0oaj7_6th2zinGx4TP89n2jnUC8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIVhHSsurAobXzE-5oSjZOEba9irBC96N5Vit_0pOgW6A&oe=6AA69214"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics":
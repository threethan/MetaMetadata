_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GVj9LKdted8Q7kNvwFTk_0-&_nc_oc=AdrnPgmoFMPggrMz4x3yCFarfcpoc4Fqxjm16WxH5FhRvYN0EYy-xqieEA8oVwalHlQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Zg1u-a4EaMZeds9DD0vupj2Ivfn1eeFzaHOs08hUjMg&oe=69D7B31E"}, {"file_name": "leavesandtrees.png", "id": "3627811494209942", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pZByFc0x7jUQ7kNvwH-x6Pn&_nc_oc=Adp19A7jI_TDAbVdvB6dH9SnGic3rBJcgiPC-X-MbYSxfB7k7XQqvYDrMZq7gLSEibQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af36hMm1LNxHbHWSgfvaCamoWLXUNLLSp7YClIiGKT7aRw&oe=69D7AB29"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ej-e0CrMV7oQ7kNvwEEkyKQ&_nc_oc=AdqizxWekfXP8vf_UVB461LaJBnu7L7xwKg4wKeMN-KbZAzgJ4tSDK7YUozwsNwiTkA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3s-Ew7PoB01CTkLQta4LkcMQze3OYn0wWhEOTPMeP9jg&oe=69D79470"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hnbXe0gRa20Q7kNvwGnvg22&_nc_oc=AdooHI8CZiszGEGxuzA4LK-FZELx08Xx6FWsZ4z9PVgxte9SQkN2-bLSlI2JuFMNBXE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af13xA8bcbydG9aYIYxFOjTOcVmCThHvj5rKDiOq4Jv4wg&oe=69D7B516"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k35pYCY9gYUQ7kNvwEF2jwb&_nc_oc=AdrbVs03xY26WgTKu_w8synFMuzRk99yQw0yZOGRipXzz-OF60htaf2STfavOUIfDms&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1GwpTIHFNNvm0r06WITCcv-GMQkqMUZz2K4_7QjmWcGA&oe=69D79694"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics":
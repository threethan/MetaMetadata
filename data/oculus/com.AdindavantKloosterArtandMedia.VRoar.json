_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ik7CrqVobY4Q7kNvwFZOOF6&_nc_oc=Adpdprz1vheFmk8t5aGmlNitwJQUQi9c9B2PqDoYPf3M6X3K-dCV3-r5mje0cFOVAGQ&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGTGk9F6tEdU7lfjkrR1rP7jLCrX-HMa0Yn3Wud0Gg3jg&oe=6A974D1E"}, {"file_name": "leavesandtrees.png", "id": "3627811494209942", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9oExGpbo3B8Q7kNvwEsNipn&_nc_oc=AdospHYTCQD-w4YhoJ7zpSdgbMSDLNXzKaciH6C32MoxGG17uYH-nOLh4dqHpiBJpfI&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4Fc9G46wf8ynYg5MkL-1T-mkGAsSQyI9Q4gsBpS7aPQ&oe=6A974529"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6bdmLSJnH8MQ7kNvwFBxB-f&_nc_oc=AdpXvTZao8vX7RZOaTE3CilSt1mqqchAl9Et_2P_0vBMAJ-EmEh_kJSXNlTQR2UlOBA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7e-MjFAuvGfuEb8UbkSNbc966qGIc2YnyRiL72sd0eg&oe=6A972E70"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GwvYj1JHIt4Q7kNvwH3Qw1I&_nc_oc=AdqOG5iDVQ_5ihyvJ-CBt48lDznyqONm9UMh6ivxlqn6V8tvNuUUsK0qfe7HxKyofTs&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHAjGP9kjEF9YZQGwJPWi3CAW9GUXpqtDrojAk5MWm-xg&oe=6A974F16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xvFuefvOqIcQ7kNvwHICjeC&_nc_oc=AdqcgyuTzS2XkBjk92ebvWA2q3GpnDRwh0KzqNJKISvLRhK7BHJgTO0otp2RXJwuOa8&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFPz6Fk33_rGU8r2-kP9pDsy6Kg-tb5HfW6TFjr4iBldw&oe=6A973094"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics":
1-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tAuGce0j9owQ7kNvwF2lBSy&_nc_oc=AdoNlIpwVxVWctIjJV7Hkhs17aNoGdCoPkqp1vfkXWs9PcrXFmv0ZH72tbSA4nCiXlA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_hZ5C0zZ4he2Z5u_nRAnSQJ7FJlTHC3Rn5sKHfAhvlVQ&oe=6A2C0B29"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yl65VKyE_rIQ7kNvwG8SpPo&_nc_oc=AdrXeH90coMP3s-nr1B0zrfmvbm96r2uw3cSxOUfZR9oS3megfCYaIEwolf2DdFZbqk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9s0g8WeV0VffraEVtyeNmPjtN-h-mDywoMokwCoBoYJw&oe=6A2C2CB0"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QGXJV9Fib0AQ7kNvwGMo3bs&_nc_oc=Adq3u2CZREkkwyS6-Fby1dNR7qTdk-g5QW6DgMDiSp8Hwyvhh5S12GCVQ7XEWxEASi4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9tp1TWJGqc2bISX4rjkOHOAey2vgDd3ijEAYk4s51abQ&oe=6A2C1516"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zjjgyQmY_9AQ7kNvwHT33b2&_nc_oc=Adr1r-N061k4KkzxZY_2Vg4SZnGoYU_fg3ZBleAbHxTyx3Iib1L5pOO6joeKwJtOVJk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xKyWJYkfRThnCFlAj29lq-xLQP7c-r75pSJ32we4N7g&oe=6A2C2ED4"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "928105881625935"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "812148190574
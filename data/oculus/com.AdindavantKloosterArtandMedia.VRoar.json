_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P-99U4X9FhcQ7kNvwEb46xc&_nc_oc=AdodoHPHb2_a_TjwqsqqpFd51oMY_KTY5zFaAYkYLISgIB_gIxk7ZSQmacRrvBr_qbo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPY40iifWlwstKkTJXZAhMWtBObOXM30qkoX3twD1KHYA&oe=6AE4A51E"}, {"file_name": "leavesandtrees.png", "id": "3627811494209942", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TvCcRbpMnpUQ7kNvwF_n4Xc&_nc_oc=AdptSAQuZK0cNP1DFlnSVmcR-m5QoEqxrQZ1XQiLDRkR3bj6ZV-ZlRR5esbgiCRv5Lo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMLoNQY6-cnlq7HQZaRDR-xkrXbrRDiPtQXSEGpp-o8fg&oe=6AE49D29"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qJor4FM5F9QQ7kNvwFg1nkh&_nc_oc=Adpy3-FBAl62xlgyddLmYsqGXAsY8RQjE-MM1fOzGTUVwl-gbE_lDnwJQV8wFNWBjbs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPwIfHUwADQawsUYgmfWm-fwQgFJRy7Vq_h1Lpo_OAhfQ&oe=6AE4BEB0"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BK9TPz3Z5f8Q7kNvwF09YEO&_nc_oc=AdqGRCjqqPF4bfHGFwWIblaJwj96MB19iifwfjo0i0wAHFJo3NK1WljS5amO7Oqt0DU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPTmY2ycrsAidj0_dyo992xA-GMOuS9N1cy5DP48vBJcQ&oe=6AE4A716"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1wPaD5CUsFgQ7kNvwHfMHNo&_nc_oc=AdrrMSiRDymWrgP_I1Qh87SCOLxKLST3IYemTJQFtokB_q7eMmhPdLSClnqTKCIJiJM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPRL4zoJAh3VXRO3PuQGH3UL87Snwqjj8HeYTsIjkLryw&oe=6AE48894"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics":
_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yfHh4dWqyUYQ7kNvwHvGFFp&_nc_oc=AdpUNSAwGSX6uYLesLVsJ5w_BNtSW9ZF8lnWOwZy7w9pdcUPJNwxqRxsv2_4n36d3hE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af41SiCgUa7WXaXBmFBqivbl9_pLJAT6icvn0QK6QJ1Djw&oe=6A03349E"}, {"file_name": "leavesandtrees.png", "id": "3627811494209942", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V2cuTfwhBa8Q7kNvwGRIGv8&_nc_oc=AdoB9I6SDQUt1-OSXZKLs6KXxQkBl6LxR0iRgDP6kbBq54tyWClNu5cUNMzZWw_jaQk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5XzfglWddzQMZbax0VhUWQnxXi1bDA0URysoOwHu0VGQ&oe=6A032CA9"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FqiG-jDhvsoQ7kNvwHHvYd3&_nc_oc=Adouq7AKfAspOcjCKQzgoL1VBQItKjB1QYsKLAu0ZeEPjlOWCThCAlea7PjDK4DBql8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5m0qMOVTPGDtt38qfNCRTyNz-qcexxmEMjjRm6tsqZcQ&oe=6A034E30"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9MmO55HHBjsQ7kNvwHf62Ww&_nc_oc=AdoFmfBHfnTnEhyb0wPAX-61lfzKQ3WYR-dNOowiKNdjv3frb_fM1aQoannPmTU8ZdE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Q-iw69V2wPGHJ73FDcWrTYGHxp7hjgENoiFItdzZqcw&oe=6A033696"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tl2OwpI4qMsQ7kNvwGtiebn&_nc_oc=AdpV9ad0VEyYqNwiaVorUQpbqxw39jIaA-pUHQsrMUh1bvLsGolZ_wa32PnjITmr5Hg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6JqqRhVgMWffpdJ_r7Q8Xz6iyrY1lDYW9-9joFWE2ZyA&oe=6A031814"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics":
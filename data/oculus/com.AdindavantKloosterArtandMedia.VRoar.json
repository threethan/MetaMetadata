_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GcAgtqrr_GEQ7kNvwE4LLS-&_nc_oc=AdqDiM_kd81xY_I99AwkbI-R0aN5vcZ-G1Xp1tMHev1_GHqoYEGxUJCKZL--qdZBaBA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMr_9BFmGKDsYgfvtOF4tDgwYYsvzc0ddNjCPOEMskR2g&oe=6AC6529E"}, {"file_name": "leavesandtrees.png", "id": "3627811494209942", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eyi9wGVljZwQ7kNvwEUEseO&_nc_oc=AdrjUup8rMddrmVS46YIFXVvAImH-QfFSc1KKgkbGCpqpgmQtofW5oPM0Kh0UW5Czik&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOL0P1dZWJ4vcKJlSHi5gu2v_WDQQIq87y_rQfgrbx7rQ&oe=6AC64AA9"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=linH1mFFJYQQ7kNvwEE9dNc&_nc_oc=AdoHPpYa46BptjAvESyBygEidoMQdl6J2H0NWE67UIBshxu3w2dW58Tond2Uhrmhvfo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOKlQp7OB6-ypsO-5G30z8S9ErRUQZEMGoVNw6zareM9A&oe=6AC66C30"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xHBBK288BkYQ7kNvwFvxnAf&_nc_oc=AdqAVSgEECfMoC9FH1kBdcFdcC7Izx4NAMUxak3J-7sDAePg15xPn5Ygx6ZNwNgv_JU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO338LY5M29kiBIW74-U_OQu-IC_zZLW6_iHN9FnxthdA&oe=6AC65496"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0kuJFUawf10Q7kNvwE60GwP&_nc_oc=AdrMJWJNNPlTanDfj5jxpL5PUBkdoR1uI0d0GKtqH8jIu03KXUYkesuGtbPCUzsxfGw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-_s-SJuw3763SQr0i1Us-ZypVKNDSiTm_udChX9tJnA&oe=6AC66E54"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics":
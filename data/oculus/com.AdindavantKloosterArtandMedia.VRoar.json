_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pmg8azIEBpcQ7kNvwFCbCPS&_nc_oc=AdotSLy7fFEpSGfsPLrNFygZJ0OzaRFWv6G0AoKHxYptIRtLxjDsrcPhBkDBgXMjlSc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8sxVSBF-JxOJrVsHg_kyeHVDDS95lBq9GghOb3RCNREg&oe=6A354D9E"}, {"file_name": "leavesandtrees.png", "id": "3627811494209942", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O3GXyJifG5oQ7kNvwEAAV7r&_nc_oc=Ado1PbgffRemjuc_aKGoMeKj2jx535YGO6CHxVdwg1fWO6yqQ5Nzx8nuNonWNiDRpQw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83GGROOUgBoCaaG5qkmdowywTfFtwoVVCF0XfnNe2MHQ&oe=6A3545A9"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q7aqJ2TWHwgQ7kNvwGPB89r&_nc_oc=AdqLOWH0uaRAaYPuNcMdh4u8OGIghtVlDAHvyARzKZjNiKy15E8f1rh3L0bZtXPCGhk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_VTJ_QFsE3RQoOjKvZtMQWslVNT8hYOyquQPWPjvNbBw&oe=6A356730"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cOtBRzWai-4Q7kNvwFWrv2v&_nc_oc=Adpac5rxZ5X6B53YSmUaTjIkLagTY5jjswz5tjshRhBpmt6qnuLpzavn7S3OzrAa4fs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90-tvBfjOfwrp0YgXMgj9KGbmSDESwXSL_fuDRPwNyTQ&oe=6A354F96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IR7lzadXqTgQ7kNvwHMm68M&_nc_oc=AdpgsNwYfj3uazXtrsgqROTUhXDEqPaNDvJMLZDQ66EfI0EZxawBnoNAfCV4ro5C1Zo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80UlchoBPKoAz32rhxUqqjrd8EIz4igTSH9Msw3om9cQ&oe=6A356954"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics":
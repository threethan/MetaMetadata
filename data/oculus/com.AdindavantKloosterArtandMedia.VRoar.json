32662109965_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=77m9Pv29cXQQ7kNvwFrSepx&_nc_oc=Adrq3GouyBWZ6pQRLT1Z7C2veiLsl-IocAF0Dl-fsd-7CtkO4D4DrnyWSaeCG8IkJG0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQ0jibsyrbj3sh4IW5ukrvkvHv8Tt7EHM3jFjsRjNiWg&oe=6A8D69DE"}, {"file_name": "leavesandtrees.png", "id": "3627811494209942", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IeaOdwwwUFsQ7kNvwFxje_Q&_nc_oc=Ado0UIlRjBaR3ZQPw6Zaiw4GoSR0dE_OUBkLOtnkEwPCmdCgIPYGk0gP7jwcc4-iTL8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGWEL7m4WP0dCWqGuf0J2XSmf9HOkoN2SdqFeinJH0zOQ&oe=6A8D9A29"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wv8n2rxHvHEQ7kNvwEXw1P0&_nc_oc=AdrpWy83KhjFYh35Ie0J0P2E1NaLk0QSVgf8eYd0m2Btju0vHf0Me8nl12wZQTyDItk&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHx2nMpm9gOOgNy4GpaGNDqIAtAjVJtTvCH06_XFa6QlA&oe=6A8D8370"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sjOXTsxrOoEQ7kNvwEEAREy&_nc_oc=Adr6B0DbZaDCvWtta7JBAtT_yZboxWdNxtDKAy2fudpQk8-5gW6_aO_eL9zJKKJ7JJU&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEaNWCArz9jTfh-kKusFxJE7v0YYy8UWAxEUU-lpH_s6Q&oe=6A8D6BD6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rTzsU0nJHkEQ7kNvwFkbSA8&_nc_oc=AdqICui7bmu84g1SFfB_NWo9u9j2Lmy6QWvq67EA66kIUXk9-6ab9GsLLnpbhalJ7j0&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGtyaD_pnwoSjZcnKdC8eYknxyqysxxoWTZkNC8XfW6Dw&oe=6A8D8594"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommende
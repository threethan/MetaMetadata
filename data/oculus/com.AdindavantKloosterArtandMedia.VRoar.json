_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kfgeHO_aWHEQ7kNvwHK6rgt&_nc_oc=AdpZg5J16C1OkXPCDkUPR8tGUfElp5o0xMz9OasOdY4hRTDo-S-h1ElLG3T0aJogOlY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwdv3NQaY-NZqX5BABfuQrNMY3cRDcyJM_NoAqO-CtNwA&oe=69C68F9E"}, {"file_name": "leavesandtrees.png", "id": "3627811494209942", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L3rR2HmmXikQ7kNvwE40UhV&_nc_oc=AdobCcYIOhAUnT_0y1F8JE0Ewco7XgAlr81eCkBppeBxl6qCFlwP9iUz6iqW8ArKy0c&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx5ph_O6dBYHYeJc9lk1rVKtmc8lVNr5kaZ_oNQHoNfjg&oe=69C687A9"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WlXeeXQBKzsQ7kNvwGCrqSt&_nc_oc=AdoC0kgD9nkxIp8HvDuDZXQQqXWrn5uH1DfemT_DVV8CVmGRSDR7mEewIYubKIYofQg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzgMc1oSEZ6PCba8Beij91I1DZzCFO_IeG9WejWeE1m0A&oe=69C670F0"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oeGvCxUXX8cQ7kNvwF2zPKn&_nc_oc=Ado7wvicAnuuRZU99bo_RJQttFrhm4lm0hsMYMzKxRj3vkugdPaWosKiDqvHYqfXeNQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyJl3I9nWdssp5il2Rymu4lZebIE7SJDBN0YpAQQM6lWw&oe=69C69196"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qSZqYLtEILQQ7kNvwFJOiHQ&_nc_oc=AdpaFUIGr3MUWWW2BTHj0WLK79yWsN6bjL96gkyot0OdQogCDEgNUFGfKzKY6rTbNTw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzdA4FBDo5ZLgDb-Fm65N2BKJ9Z03TTlib7JHsvAyJliw&oe=69C67314"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics":
id=6e7a0a&_nc_ohc=cXLxXS3MjTkQ7kNvwHexAUw&_nc_oc=Adm8A0jmGXL_G1wwLZVqsrep9TGn6uFGZaes9a1LVum1btXsdGvqm636Cx4DOftbu2U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwU0A-8hka5zos3uBxF7DddT2ylAAwdSD5ZTR69Ty5QOg&oe=69B80F1E"}, {"file_name": "leavesandtrees.png", "id": "3627811494209942", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cPibe-KN8EcQ7kNvwECubfP&_nc_oc=Adm1Xz6sNmssEzK7dwZyHuT3OGLuvOQF1JgiTmLWnmaGe20J_q9C8UIcVlzMmd2ssvk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzMUPif015c0v4cZBnaYizYBfYELKJ3fNb5kdrbQuZtZg&oe=69B80729"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F9ApTV72PL4Q7kNvwFbtmfG&_nc_oc=AdmUZxFFqfMaT8FlCLkRNoVWEIbur7qBP-UOjprkaTQkfxf-p7Ae9I8OFptVUlqSCIA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afyxc-ML0v4ob176SbKXO76Hg4KuXuwMb6MtDbTUnq65Rw&oe=69B7F070"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1TyCqtUNEgkQ7kNvwEgGjRa&_nc_oc=Adm-xBGyn-d1aYWY0AmwPEIZRLZQDp9rPUIOZqrwOIWo7QXd969wgpNdlQfAXZWSRt0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxsqaVz-cW1aSo7nX-BmN54uIylecy6Ex7Fq2q3weoRIA&oe=69B81116"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1UGoH6BIT9wQ7kNvwE0y-V-&_nc_oc=Adk_FNH2Fibd8bSAB85UXTb0KxWhaB7sS5NfYmsfHxMTO4de4xBV_BHO9xkyHXicaQA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzACLHGiyKIteI5sQb5FywNBRoxGFSzXT-sW0c5S0WJmA&oe=69B7F294"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_p
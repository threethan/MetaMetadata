TrvPDoBmTK5CEnfzNnmo1Jv5KBznjpXbB3PexQxel1yE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuUC4VYB2Ec3bmT7jaCMH2Li0SA4lLahDhqNbs8IElUdA&oe=6999BC9E"}, {"file_name": "leavesandtrees.png", "id": "3627811494209942", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hgoq3yvOuE8Q7kNvwF0tu0Y&_nc_oc=Adn1zySPMaywerbeaoUhQywAhr1rYesoOBXBJBTG5ZaKFl1CkoeKcMCz2_UYfiB9rCA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftSY4ZmwTOPz6DSYFQFL00v00laqsCWpduP3ZJs_74HWA&oe=6999B4A9"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tb8akgoutL8Q7kNvwFQiKwC&_nc_oc=Adm_p-XxU9n_KTd96db4n1XaTl2jHC4PNg_Xvm6LCCxpas6OB6mWDoLX9FiLTTf6XzI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftGh6CuwMdnQ2ob1nPdxcNAFqQ7lMAws4hWssyECJIAIA&oe=69999DF0"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mCbCAdJP0jEQ7kNvwH9X24K&_nc_oc=AdmRdpNFuGEy8NTuP8EK9oX5sc3vlQP8qqjF0q0dc4zypIcah4xEnUK0x2YaF01aimw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsypUkUAFgkdfHVGUYWTqnBhGq1GpHcdJgSwz1C73_zww&oe=6999BE96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ry0KtRu1osMQ7kNvwF5WRTf&_nc_oc=Admk-CgOMsPWYLnBCxDvKHgyeEn_-BxJczjZ478cJ1Vy-rVHkIsTtsI-Hm-KN-SY4lk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftgpzbVBM_eDWfdp3fUR27lNGcwpNpD_bxDSZ2kr_JaXg&oe=6999A014"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player
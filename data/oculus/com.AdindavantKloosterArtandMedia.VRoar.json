9965_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mRuQV93GkbkQ7kNvwF1TUrk&_nc_oc=AdqHi6t-hWh158YcBSzAujLZS8HTTP69Zlh6y69FAZo3gAyWHbkZXFUAo6xdtQmdbD8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8nJsP7tIKGwSneHQoJqzZSWfb4B98eLD-ZIpwKuXEUJQ&oe=6A22D89E"}, {"file_name": "leavesandtrees.png", "id": "3627811494209942", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xR_vEAtAdDcQ7kNvwGevpdx&_nc_oc=AdpR6FZ5uIEj0MGyEEtZH8WsQfVoK40OjfM11g0pbXiVeHSKir3_ZHP6OBbyMLVPu3Q&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9nuxDYRgbxvy5O3-DA49jIqMkt99So0NNb2MfplT4dBw&oe=6A22D0A9"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dwUCIg6XH4gQ7kNvwGPEKgV&_nc_oc=AdqOPHrUQ1hwj45vcFapcBf1gC3WYFqmN_Q10Byxquyd-rz8L8DwltKDJ0zYWOUFvqU&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9j8Hbrnjw015dx4qYRqLku3U7lXVEy4EfSLoh5rjFGWA&oe=6A22F230"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jwIVGkNzT9MQ7kNvwEQBwSm&_nc_oc=AdrSzfl_XepCTDbfoT2vvOP42drD5NlSUkQKSHqDwDgbZjAWAlxBdhvNLuCXTaH2hOk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_tYY4gaOrk7KVfj_WdTeMKKlp6bknhcEJYUTBvXlKDjw&oe=6A22DA96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rzCB7ldw5t0Q7kNvwEq3s-W&_nc_oc=Ado_F1NLVB6Z2Sa42OJcgzJiCrKZkQ6AxCX3PaPEmtny1qTnN8Pm1qUR_VnCY3a4GQs&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_CPhuO_-UEAZa3Og7oI8CpWJkoHKKZyGZPQn9t_aQzkg&oe=6A22F454"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_gr
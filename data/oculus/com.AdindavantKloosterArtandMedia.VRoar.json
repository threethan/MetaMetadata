_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FC4R0lH8IAIQ7kNvwFWMVHr&_nc_oc=AdpOGkGUSuV2RJBnKOs3dJQrpKx7i2K_x1Xw6CuJiMcVMWx9BJb9dH6ac8xSfCjT8ZQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDCwzuWRID072A1VOSDYeSdyws2I3v2ADFJzW4Cx-DoAA&oe=6A54F19E"}, {"file_name": "leavesandtrees.png", "id": "3627811494209942", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B797hUZ89p4Q7kNvwGhzr3f&_nc_oc=AdrOOP0Rtp1JZT889iEQ2GZGOOO1aMGmriensATLTAweF4-2K83i1_hxDdYbUBxyfbo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDoDYUJu1uoAp9XGdUELVe5g0sWymckjom9YTgI5oeuUA&oe=6A54E9A9"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BdOXMiUfgjYQ7kNvwE2yUEB&_nc_oc=Adp1E_O7Uhw30w9ErSnwU72aiuq_N78_3gHcU_MObTr0Eun134kRjH5yi8ISZCUCfM8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDrox0cpl9Jg6oMDgpl5_7aajtXlffrcDviRfArw8KBYg&oe=6A550B30"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IM_vZQU_g2wQ7kNvwEgu64S&_nc_oc=AdrfUHurJaMcRDRVag7_7eAU3dsNYSVN0nS4tb6mFMIvTiEKRotcEHVwK3g_DrdO2Ac&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBSqWn4kGPPv8yKTAPkTBg3KdB6cY4ZA_84rnytDD-hBQ&oe=6A54F396"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SCSF4uO2FpAQ7kNvwFo4u3j&_nc_oc=Ado1Cx-FFrNT2boWf6_AhmME5m97JBSHZHV6QQs9amBw4Q33Kt-eErN9QSVJa5Ji4q0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAdL9wKmXJjBjiaTPojbYjtqAoBfGi9dVHtklgnXpuuhQ&oe=6A54D514"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics":
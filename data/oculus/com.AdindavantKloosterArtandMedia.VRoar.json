_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8g8oH4eAwBQQ7kNvwF4MSiE&_nc_oc=AdpV3vNZZnpNMCmRWRhkUxnMNr3qD9H6yPkiaBGXEtQmVz9pKVdzBFvDuYSIy6boRks&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93RcJfA4tVidKRCKlDKXPSBeqxQhrs_KHqYoGOu7yCwg&oe=6A281E9E"}, {"file_name": "leavesandtrees.png", "id": "3627811494209942", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C30GawU7QHAQ7kNvwGqvILo&_nc_oc=AdpYO8KLfq7kcfHNc85XQZ_xg8f4FKnjZjz4SM7E1RNala95mTIJjOLRvWwfGJU6coA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Yu64dEBqJF1rgNGaadvzjY6MpyFXnVXQNALz7kJ_Udg&oe=6A2816A9"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JSzJ2RbZZNcQ7kNvwHFy6cV&_nc_oc=AdqRDFBfEojWUmAWJVTBl6zeH4d8gmDAfxRh9Es2E3ZyHfBQxO0dIKEg01WTSwyQ3vE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_oujGrA2kKMCbCzf-tNNB-rcjqmEKrcLXydsHjFkAe2Q&oe=6A283830"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wP0G7-XWOLoQ7kNvwFGNGOJ&_nc_oc=AdpbsGlSrOAoRbh_VuAtbA9hUYXIWsQbHOX0SPsU0Ef0g0uh4hnPIFrD2xziA_1IR-4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-zEmoz6If7fOyJ-2fx2koq6Qd22W8dKUHw6v8wl8OuUw&oe=6A282096"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0dLWGAaY3pUQ7kNvwFYU1rt&_nc_oc=AdprcP6e6olLNeKrXutk5Q86X1oKD_TNJELd0Rld4P8xr9T_8T_WpqlaEb33naVaMhg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-itU779dO5n4Xsmw4jMIb3pmooMpbr50WlNfAODfyPxA&oe=6A283A54"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics":
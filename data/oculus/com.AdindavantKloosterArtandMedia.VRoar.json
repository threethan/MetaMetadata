_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SEtwzXSgf_EQ7kNvwFmC9Tp&_nc_oc=AdoYua0PUR8XWqPL0elm0bVMgTyngVoYUEUzsRDYB8kZ4Ve_KCpL86Ac_lKNCTadFRU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQECAQ03GNrDaTRje71WCKiBVdY9FChGekOCt9LfenOihQ&oe=6A8AC6DE"}, {"file_name": "leavesandtrees.png", "id": "3627811494209942", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IeaOdwwwUFsQ7kNvwHidsyJ&_nc_oc=AdrA1OFOEjltBm7PKTbGP5UAUsYRJLXbDZI-RSWMie_V8XYPcZA72L-vvjZiFw9kZqY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEVrAEeHTUD40QmNjhbrJF5Uiu2BvYA3n_SMlLfF_GlWg&oe=6A8AF729"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RHqWHJPnJEoQ7kNvwGUMUST&_nc_oc=Adqb8odIxWKVxOWTnwNtv9OwRHW9YC-SaNtDOCivC024cwbbx_frM6uVr9pdG8uBIj8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGOMVgvUhkO3tJaAcoEsrmr1SbrSNZveYEtS5yvrdfl9Q&oe=6A8AE070"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lMWFoMGatzkQ7kNvwEFImtV&_nc_oc=AdrMhvW14mOk5d3UFOU_iQBvSoHk-0pMNSBM9aHWx8-LvxFbnHZt2avJeUKRLmZGIx4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHLfUXS2pXQOk7FZqlblt7fV7hjZ-q17JvCccmE5unT1Q&oe=6A8AC8D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rTzsU0nJHkEQ7kNvwH5Ldib&_nc_oc=Adrd8Y4NKUo2yOFnCh7mYWslbsqyQ_dZ60l_zMQzgehxvnfeyhjp-RJKio5F-NnfbXE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdSKRFyV-0e-5ailgajWnV3cYQtPJkiW79lavICn_fBQ&oe=6A8AE294"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics":
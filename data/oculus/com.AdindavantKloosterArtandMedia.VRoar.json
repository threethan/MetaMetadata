_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G-YK61Pm__8Q7kNvwH9G27a&_nc_oc=Ado2DS1lkeLh3PzW3BRTXb8rAEfjaaG3M-RDH2sZ27AXmAoDJbTqqnCBcuqzC4XF71I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCt86SK9DPKpbIbDP0GFcVp2ss9eYy3LJrfbbebmgtBFQ&oe=6A5F7D9E"}, {"file_name": "leavesandtrees.png", "id": "3627811494209942", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q3il6dEk0VQQ7kNvwH2h9Kd&_nc_oc=AdrAj0dmKk_TnbkJoksgTbg9K7I13Zp4NQm2wnwJ91SiBuFTtdKzmj4k8xd9-PwT_DY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB4Xo-IoNdvAun1NRkK10i9OiyT4bYg8ZupxZJoMMdfmQ&oe=6A5F75A9"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hvBhYfsOBlYQ7kNvwGnRWfm&_nc_oc=AdpbbKKJLagA3Qd28B50hSERbSgxO9cQfvcAkleNnc6gT6ueZqoma_e-vV7zgd33fyo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBEOWivnQD8MToXLuBM3aqAg3lKjMnNBTpDqo5Sp_aXHA&oe=6A5F5EF0"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jv38QeEraNAQ7kNvwEy6F0O&_nc_oc=Adq6KjukI8181nGVg4VtT8Ij1LpnNgkG3ONp23hv6ZnO-L8AJigmyJRoBauoDThD4Gw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXPWlmH-PCaJYXrH9QMs5JZJPNi8yavfHIwKCMGpF-5g&oe=6A5F7F96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B8h0WbZpKFoQ7kNvwFnQQ3m&_nc_oc=AdqLMxmt9oH3iMmkkLPyzPMnh7noBPl6hTl4-udVsuPw_VOs4frWgm1xJs6lv0KCYlw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCctacHXbJP4NPy9-WKGL3IK6Oj0sbpR9iABfEO6C4Y3g&oe=6A5F6114"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics":
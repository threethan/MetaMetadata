_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QKYknm1bS7MQ7kNvwEoiSjx&_nc_oc=Adr-AH0l61UV3m_E__8lUEQA7OW1puf2aP2LiGk5Xprt_pN36NfeOrtAGhs928Ht064&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YipsewPL-JOT8jDs0KBVoi_cUC223Cxh1zvM9t_-Gaw&oe=6A43CE1E"}, {"file_name": "leavesandtrees.png", "id": "3627811494209942", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vJKcWwRoT6UQ7kNvwGQmyuZ&_nc_oc=AdoFdxpVdjLkWwBajRlCfmAjYaE21qg-EuZLEUuMgUDqUU1fnTe0GqlDc4i_9buAjSU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_oBWTWRxYRSFbhfMzEm-lidNdBGIR9txMATiVEFvjVug&oe=6A43C629"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r7p8lLITzFMQ7kNvwGkcVhu&_nc_oc=Ado4EaGxLC2FGIkiK1J2kAR1U28SOMLpqH3ApdkPsbU-qP8e9775ezyTWlOsPwrVCdc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9lawzSzAWLbCeCaaCgQ71GlSBGLIMyBR59HjQBfMUAzw&oe=6A43E7B0"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DXoGBnb3XAQQ7kNvwHYwrP7&_nc_oc=AdoV7RQd7fuNHOyrxfWBrEnbAXOb4BVlPnZlDQFl1JFmsR4KtxRuIZ3Cdr6mAdn_uYk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Us1GK9NTwtvGfleAwawkSdGjbq8jMFhKZAmDDhvvEFg&oe=6A43D016"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Mk1eSINnb4Q7kNvwHo1-E5&_nc_oc=AdoNYZgecuJ3Khb9l1M9LEBVIDqTLJMjII2QPXdXIvD9hkZvNeHYihD0a0ZmEEFYYn8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MbLuzKuDt5Q7jtr8ThTgntOi4B2hf551ecDTs3Ulj1A&oe=6A43E9D4"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics":
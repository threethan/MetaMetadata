Cej8q-9o4Mxax2Hk3hX-ZB1T0k_I95_XUyMxpgEkOhNc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsDpi4Wy26asAVm-trjK1CrMoUXsqr6NS3rOaKpE4_yaQ&oe=699F029E"}, {"file_name": "leavesandtrees.png", "id": "3627811494209942", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QIKaZTTclw0Q7kNvwHyrNnE&_nc_oc=AdmWKtRjQv2PAuPcr9nYbvwEaWTfCbV7OzJegPcGBOfTgNOTjSx78ClpP9qoh8j6zXw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvdVeDlh-7L02qBdzM2WNIBs1wHyf4pCOMnguNjxugvfQ&oe=699EFAA9"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vAcPrdNnezEQ7kNvwEEqXXG&_nc_oc=AdlcP4bTbqfguft1q7ODTAWnIwm0lyFzEfMFEbacClNrRdimWhg7Vi5RpnYjxjr1EMk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afs79nwSprjorjrY7XD9RBKYWV7F1EB9nH9EhrzU94x2FQ&oe=699EE3F0"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZityvcsBcLgQ7kNvwFdUqIu&_nc_oc=AdmfyaEfavuGVud2NkL1qjfN1lg-lNMZhhzxfKfqx3wzBwQUjXlLjtN8ctzRDjRsqNM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afuy5Z7OmxayBjdp2ZMSGIjHeo2OVVAKCvoKuAdv5MeTlQ&oe=699F0496"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qR6z3ozO4zkQ7kNvwEmpylO&_nc_oc=AdlAMQJhPCMRB98PBPTGgNhhtzTB18XqTn2aW21_3Yoa98C6R9oSX9oIsJwfEhkxknc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvXKOChXvTKiofYjOYu6F5HdWsArfhGZ6C8Gib6Rcaqew&oe=699EE614"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player
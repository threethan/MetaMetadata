_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ii29BaP7pfQQ7kNvwH3zgb7&_nc_oc=AdoL0N1k2DKoNXm0WwkpzT6srpybikW_lmV0YBFyEQYCg5EGxo9KapKtAZ5dnDV-LNI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvgWJajIYCive21OSU-yNRXLjqwv8S32l47jTtzC9SMw&oe=6A77389E"}, {"file_name": "leavesandtrees.png", "id": "3627811494209942", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MKu3DTDLfMEQ7kNvwHZLo-Q&_nc_oc=Adpx86nlYXhFYdCXPYRsUZ-I9vgAnf0fnT9UH2MVJlQ_vIT3DP-lDAPJYrYrpTkwEoU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEGHx6XWIVX4bwzu7ErdXBLOfoufFVibWnUD9td5qWMJA&oe=6A7730A9"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cxn0uzGfOm8Q7kNvwHpitiO&_nc_oc=AdpwhgW9KCCgsqMmTCqPexvndOUf3LHR3wrvLjx6GfnJnl9hRVpkLfOej8v-qhfeD_0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHVuNJIgtP-FfdpYpJKMmgoEmLZWV7dsGdSFA5AOUO44g&oe=6A7719F0"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TFzE98DFj04Q7kNvwF88atN&_nc_oc=AdqvjT4qsLO_6SeUkiqXK_oDBRpyYedmkEwhTmlRKl_MuUyjMnaDgQ-ec63-CjE7FCs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFTKsS9kt1iVqPRTAldBCeUZFASN3jfmvk-rH6m5wkSOA&oe=6A773A96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sOb_oPrDbLcQ7kNvwHhwkvO&_nc_oc=Adq-rV-A0amvgciH_5G7ltEpCfERP9SJoiqaDYBEwtl8mw6dUAd9EsYmDgsvTGYVig8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGPNSuZAwVMK1POOJUhfSmUgKXVS5o5taRNg0zd7MV7fA&oe=6A771C14"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics":
_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pVrCf3Hm29EQ7kNvwE-sV3L&_nc_oc=AdrsJASQZTK0_az95wj2fBrc4o-VYZ5r_8HTjVVadSmXqyb1OKuGcKoKyZXePE7_9tc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3H-ajD94tKRjehJuh2eZuoj8qtZDJmwChdofrC8twqQ&oe=6A2AC19E"}, {"file_name": "leavesandtrees.png", "id": "3627811494209942", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C30GawU7QHAQ7kNvwF-1Ld_&_nc_oc=Adrm34l5Nzx3oJ95exmawYiwQ1qJSeZiwFV4oGD0GTjVoDsXFyvXjn4LgNqV1JaMHOc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9gTWbmiBUp-FA7jsLkKVNK7ecQPUCgFtw1mWy7dduFLg&oe=6A2AB9A9"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yl65VKyE_rIQ7kNvwFN_wZV&_nc_oc=AdrUU5JqyF9vV9fWy0rDFtXypGkjCwO7tvb7jZat7XfS2EcE6DxgRkO-a-h_dennKoo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_-2SiMVRaA8nhyF12Ij9CMJ8tePmN8WYxaxjgTGzWfg&oe=6A2ADB30"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QGXJV9Fib0AQ7kNvwHL9Jxr&_nc_oc=AdpXA7FXZUnWC6Fd3LGxyFH4Nrblxpufy4dJS_vTFO3ULU5C37q6N_KUasbgsgzlT10&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8D9M5wSkTlWKyeQsjNs3d-bJoyr4RrSVv6QvVpQfD5kg&oe=6A2AC396"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zjjgyQmY_9AQ7kNvwGL7mBC&_nc_oc=Adpk4sfanhXaC4-_FuzmUesnaVN4XyAjpEDBD4FWBSWZYdNLRcmzh-tj1lN3ZZYO8QQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-k1bDE9-1FWDmg07l92inj_YFngcSGwut95RAUHqS6JA&oe=6A2ADD54"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics":
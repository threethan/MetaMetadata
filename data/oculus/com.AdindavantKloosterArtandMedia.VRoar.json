_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pQZJOO5mwNEQ7kNvwEW0Zqm&_nc_oc=Adrl_jhfr2wV2MWOrZ5rQyBGb9U4R-xfyug9myGPdvBti112A3MUKm1uld94tkeMxPI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN5z6kTmitjJaxQyW0zsFJzK_GJvC_MQU1A9Nh56Q9X-A&oe=6AC10C9E"}, {"file_name": "leavesandtrees.png", "id": "3627811494209942", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hKMnMZsh_a8Q7kNvwFmDiGH&_nc_oc=Adr1YcfS5NWPpOTdaKH7WucCklDjjhad99YbPvLWXymJjMtmCjRY8xDcPxwGn19SkL4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO50obzu_ha4wlswzItACifcXTpf70dJFTkz0j7O92uDA&oe=6AC104A9"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DcN3VmY4vBoQ7kNvwGIQjXG&_nc_oc=Adqj9sMy24aQRYkTwM7yPyfhUqzIpiXmApeuVO178gPuzr2vIuK5HJRqL_JvHEAOvhk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-usqf_O2Bu6sui7VwFQ2qhhTQbx_77syID0Pt9icdMw&oe=6AC12630"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_qKxC8HSL9IQ7kNvwFpK1IR&_nc_oc=AdqgXZseBbgnQ_35SEmAQT-8_xgj9IfUtl_aF7Hi06rsCSKxCDRb_3U67EKLqIoP-mQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNRUFsz4DCkmrlvyVLX_N1l4zZL4pg8jua-wy23WQfWpA&oe=6AC10E96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H5duymDlWGcQ7kNvwEw25us&_nc_oc=AdrKSdlOBy0EqtaAIxrWSHytPUOh1tN8qfbXyjypYdTnNSePZg2IHYq4OQ-I87MNPcQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPohmyHURTtLqi1754xtOhi7vTH9uU5A0PPPIB7P_cQnQ&oe=6AC12854"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics":
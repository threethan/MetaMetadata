_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zeUhgx7E5lAQ7kNvwGqlGJs&_nc_oc=Ado-yQ6fAX4wkD6vIKP6_FvxkLWV0yA7-9HbBd2E_KbqleCeWVu4z5wVgFgK0X_P0OI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKcyyBuze-F1ykRXn4Iahg_fttHdAMaQ47iHP-8N4zhyQ&oe=6AA2BA1E"}, {"file_name": "leavesandtrees.png", "id": "3627811494209942", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mVXws6ze6XoQ7kNvwFC8dZu&_nc_oc=AdoERDbS5ioNMy2hKTU2ogysc02QYkmxszpuyu7cFWvxK_znudMSumgfJNiS5k0ixXw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILbhhK3OeExhvlovbUQ1K1xQ1QYQqDZUXMeATC8vxgMQ&oe=6AA2B229"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YHy0G7U_GHsQ7kNvwGhOO9u&_nc_oc=AdryjleJ427IktklKxM3trQhrNIsYFfy61NKS64VnUi0ffxAr5byUWUYeVKsepzsxSY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIGna586oDqx3Ewrj9hoBR5m6QO-blJ6iAfdjOSQWOzow&oe=6AA29B70"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ma_zECazh0Q7kNvwG1YslL&_nc_oc=AdqqL83UG0E4dqfj1laalrHonN-_e4thvBa6uvikyetJwOUMfOzpyFhFTcUZ1pYhUJA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLiQSvhX59kJDkQkc-A-1aXk7MthTE7zfoQ9xMz382DZg&oe=6AA2BC16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bm0FndKGpKoQ7kNvwHNXqIV&_nc_oc=AdpHI7wNg133W5qlvh_GPHXhERPuQdQ5ZUFEfJQrmHEPlMiIOLCEWv27dAVxHSlrepQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKA0VLUBZn9CQcyNNoiqJAEYPLXXqwpSuPHh0YLCyICfg&oe=6AA29D94"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics":
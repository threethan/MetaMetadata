_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f5R6zxS83XkQ7kNvwH_vDq5&_nc_oc=AdpD5T-5gt9GwJ7KXGIhIJT_fEkmAqBG0EN0munckA0zkmpQZQOUAs97njvwRGE9EmA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHEURVl2QF4vxeUi5SL_um62116YLSzX3ZI__PYOVp5mg&oe=6A788A1E"}, {"file_name": "leavesandtrees.png", "id": "3627811494209942", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MKu3DTDLfMEQ7kNvwEAJFJi&_nc_oc=AdoSysIPTxJxahrH0An78hb4ubv7TtBtENCuju5VPtAgWorsg-77a3Kb2ae2o8B47J4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdxslwyBbfxk_6UZaSAxIgXy4JdRRWhr4KjFbcdfh5Lg&oe=6A788229"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cFZ_r2fP2ZsQ7kNvwEh23EO&_nc_oc=Adpk6fNYYPcvCelG6Qioku1ZOZU9MxOZ6Zr_NKEwKCsZn8HqNWwKvEdfXnN65y9Rpms&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEVJEN7NqBmtS-rvI_56sOCFbpogiBMSzuZ-SFPcVgggg&oe=6A786B70"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TFzE98DFj04Q7kNvwGQfyQW&_nc_oc=Adp5V5xg36Bm8MlH_lNqcGMByABo7z71EajQAd2LEGPZnn5Of-sdYEzAVeM2sgXw2lY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGvkbIakYI5ibsB4PrjpbluVaLMV_AdTV9CK9JEoEDcYw&oe=6A788C16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sOb_oPrDbLcQ7kNvwG-tkEA&_nc_oc=AdrfWDRJ_wLkVs2yaVU0NaABZl609PAy1YlFaMEmgDhBAHKgWEB1BuwLlUqNAutQsXA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFI7mJwDfeu81xQJLXGvmUnv8fTKbNoPpI_i0Ij2YHc6A&oe=6A786D94"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics":
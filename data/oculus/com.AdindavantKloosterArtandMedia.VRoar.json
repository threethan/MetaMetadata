_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kaGj1Kf2u-4Q7kNvwGm0GlT&_nc_oc=AdoS0WeXUe7wrzzzMGQnRAUj9wliaaCyPSmSnxw_I45hvFzXBNuwB8YD9u3dSquvbQQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af75SjI2rtorciLCmpEEvNOOKoPG5OqcCXai6Ci2vnp-Ug&oe=6A087A9E"}, {"file_name": "leavesandtrees.png", "id": "3627811494209942", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cMjY5fBEMIEQ7kNvwEINVNf&_nc_oc=Adow0PELArmHetsw0EHvM4qCceMd1iBsB4KrChwurQX7E9fNKFJE1SPcns61L0SPE6g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4sftIdjzk7183ldWYzfZnYD0t0iG_Hk_Gd2J6RwlAgAg&oe=6A0872A9"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DAKNOjzxNYYQ7kNvwE4vbCG&_nc_oc=Adooemn7X_CMCybGVSUrA4iX00eqHLU0dTvHq9gUnzyuqDCRmK42y6o5pwOhsVl5b-Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6W1NTW_AG3paicimBDLFpGgdpkVCC1dCsfs_LAmjPhAA&oe=6A085BF0"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_eCRUpvl6mUQ7kNvwEKQzzZ&_nc_oc=AdpoRQlI61EyBh_JGSANPoyxx14KzWQDwr_izHuMzY9LT6Qx-0Yhy7DcYMlJP0IrfBo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Gh5Vynl-XbfuHkOunCF4p7b1-Su19XTDc8SNwcTCppw&oe=6A087C96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JaNdhcUzs1wQ7kNvwH0W9ZD&_nc_oc=AdrK9MRzXbctHtImEyJh7Qj0AKL2lXxnF08qqndRaYAQZNbbGjmAYG15eaeW6VUWfrg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-IRwRQM1zlXXbHFpmuReB66bdn4ih8KEggYnd9PO8iQ&oe=6A085E14"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics":
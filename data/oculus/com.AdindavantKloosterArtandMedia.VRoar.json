qendnhPvuB-fUJAOKZMrqWaSj1k9R_2Bq0sK9daTp3Tg&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfvmATsm32usfen_W7LtbWt94WMBTqg-SwQSej9oV75w7g&oe=69A1A59E"}, {"file_name": "leavesandtrees.png", "id": "3627811494209942", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EdAt3sr6UZsQ7kNvwGTWKPY&_nc_oc=AdnRiL7ciBdxzEPh3oSaGkqzeznTDEhNBNLi8oCU-cf1nonWwUotNrVDQ1Xa3rwqnFA&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afs6CLbE8dHRTOF4C-GYscT8t4IBjVN8CltdMKrJViR-4w&oe=69A19DA9"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vAcPrdNnezEQ7kNvwGL0A6k&_nc_oc=AdlXHmw-rYKfVK5In7rXJyBhMEqYpcz1GrbnFrA9AOc_yQf4tIU4Oj1fbjp-KPW3rzU&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Afu1ncJq6LZwyx7gyXZlzKgro9tNvRA_1RJflWXcesgNkw&oe=69A186F0"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4DGyQXODF0sQ7kNvwGknonL&_nc_oc=Adn_ZMZJnaqujlAEdW-cItfGtvIvsIaeq8p59AXYckPAcDOXjZJ1oJIjRn14gJ79Wt0&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfvgcMqvx-AHt2rB0wim7pUuEi0FNQ8DWV3NVuvCjqMmyg&oe=69A1A796"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IJGxHPwJKk0Q7kNvwE1xbUX&_nc_oc=Adml0D5KhiYhSsbxBLNMgj6PjlbasFGSH5eBWsw5Gyp5SeCwFt541iYpomcDFnDByCE&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfsksPZYEQ8pBzVBXWKTs6AwtNAvkYAiyLgdrP5f_EX0sg&oe=69A18914"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player
_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tZ97A10GXtwQ7kNvwFi5MX9&_nc_oc=AdoGXozYqL6oHp01dAnJLMOAy7q4f1fkQVHmMCswHpYLGck4E-RBYaxs3N4yM6JriFA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3yXBqhjBwU9Xxxr2yl8WHCzThrzM9iZBFUWTRuwlz_Mg&oe=69DF9C1E"}, {"file_name": "leavesandtrees.png", "id": "3627811494209942", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DTbHFLjwe4IQ7kNvwHbbqNZ&_nc_oc=AdqQuQvYWTByP3VG79Qv4IDSlwrKLighzzG1sGgTn8WI_uM-YkkCpkNqotgvqf2-CCg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1B6o2qhDSnMRBsOBdZMxWOv-RxAyWYb1lfpET58lyKNQ&oe=69DF9429"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SUtpz_MBEoUQ7kNvwGF1iV0&_nc_oc=AdpAVKFf84aaomHE1e8OCj_HPhYRQS9iEJG9gnCgegHzMXN4ltDHa6_7HjST73yACTM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1wQzlXDMahDzIX-S0QNirfIOIH5MUu6vZDNl0f97LIsA&oe=69DF7D70"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UEmSpjRs0FAQ7kNvwEbAyUy&_nc_oc=AdomRyxkoPuzkYSztZjmBppkZWmnosOenI9BhXYzMbdtbPu88IFMeVeBnxa0l4xWQ70&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ddiCbY70CAseGwin1-FFiZ0gzNqr93VXZGdzfSTFHvg&oe=69DF9E16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pg7vznvowUYQ7kNvwEDxfZ2&_nc_oc=AdqJax1ljWQP_yIlR0E9-bLS5sGLzGvYhE8Gzb4dzLmc0BwzGET1ZDJfDV4DGbx0Sh8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ac3-DXA_4JY-yPTyWbxZ_g-sbHQ1vqwtyeUzcWQWr_g&oe=69DF7F94"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics":
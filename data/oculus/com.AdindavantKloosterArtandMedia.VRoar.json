_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qi8MKXFhR0sQ7kNvwHK0fXn&_nc_oc=Ados0C9sWquHW0-iHAPt5fls3XqUIOxBSpcePMx_Uq-Cfevbn-cwS2gJBXYM8FyuSZA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ltcfhBvT_wQgVmIfhMhFjZBPC2gAO3ZbHA5ougo2QmQ&oe=6A1EE41E"}, {"file_name": "leavesandtrees.png", "id": "3627811494209942", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v_K2vClp2U4Q7kNvwGgIyIO&_nc_oc=Adq_mO-x_maVQLv0wMC7q_EjuBl__oYlyw81LvyRYC35xw0BFfcvOLwH0u6FIWGqgXk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5uDkWKg4-lUCpo5LG9DWKLylLygaEd4zGvxdD77QqlEg&oe=6A1EDC29"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pu82mV5YDGMQ7kNvwH2sy8x&_nc_oc=AdrzhgAF9ckvry-6CHGIv24WSJ4aAnDbK1nbgA1Cs7pJwzMjB3Lw2o2-rlN4lCxXWTA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Pyd9FImUGl_u3_sEzgw4dl-YIEmWkLgLBhhB8ltlMig&oe=6A1EFDB0"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pcYS7l9Y2vIQ7kNvwHXIqg3&_nc_oc=AdpfUmCj99jAuSj__q5vDjCRVehnTcxsUNo1Hl6nmOquFBdMnjFm7kDsfZhdfVM4tPQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7YPV7ALC-EPpvFGxRG3TVrSsZm7uF9P_ZON5m6Hm0N_A&oe=6A1EE616"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aELtzf_h80kQ7kNvwHMtAEJ&_nc_oc=AdoqQOFCV_c0JI0ug17aVyJM6ztkKqhQ5XpFVh__kmLXuCCHNNfGqYlWOz-uqpdL_Yk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ny2OSQYw2QQAFPoDxFrK5-2Y8qEA3Pyo2q8w_gaN7hw&oe=6A1EFFD4"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics":
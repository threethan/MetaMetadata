_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k_iA0csvSJYQ7kNvwGdD5x4&_nc_oc=Adry692hQPrqaLf_xqkoiRxpBtzrpy0yOGMltIy3Th_RTkr-hzjEedZeD2F6_harj6w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwTjeRBcnIFXN6axCFvbRXB7hzMasqljjQNnLN8w6P3yg&oe=69D11B9E"}, {"file_name": "leavesandtrees.png", "id": "3627811494209942", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nHIbSlhZNDcQ7kNvwGfy4MC&_nc_oc=AdodCC-N6a-P7S2AcFrTS8AAK9wFsVuoq8Pm2r3ZNk_vSxV6IrSbTOgOFzMxjyKPlCg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxkgyPzpjTeXDwCDw5wliXCldXQ1xwVwedkmIBgg50ehA&oe=69D113A9"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J-2JTnPBNwEQ7kNvwEAN-iY&_nc_oc=Adq3cVqdfuuasZ8czRHCAe-aCnNSZ4I7i4kY-sL1Z2kWo9KJJdtqBmW-guCFj3f9q8E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwUxbKCacrCFTdGFQIWOv3CYy818ECx3iTdzv3JgIv6pQ&oe=69D0FCF0"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1YCUS4jCvB0Q7kNvwGBvbOr&_nc_oc=AdoaG8dkMSp1RMo7UF5pFtyB_t99CVwfqHeb_wOQmlb6nJYSQrZuJVhdlixChGq434M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxg_Rq8ywrEMU9tUqvSGf6gxFROuAXhju4bpm0X6yQARw&oe=69D11D96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K3lTB9BXbX4Q7kNvwHpxRs2&_nc_oc=Adr0a8V387V0ykBuCuDzFjznBwQdi8NPL507dORHvWR6gKK4oIQ1cgEfOUrORzKIlmQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxuajOqjTSGq54t2OrqJPW8Pzug9fOGkmhJp_hANOVMRw&oe=69D0FF14"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics":
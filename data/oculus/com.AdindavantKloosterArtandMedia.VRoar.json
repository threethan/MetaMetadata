om/v/t64.5771-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tdGzwXfucqIQ7kNvwEduW9E&_nc_oc=AdrLBSvEeypqLy2aIY1amtmeOZisJ3Mk9DZ_uV_NkfakSYjMlzSuL_9UMBsiV7z29K0&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6gaJ1BE09jklJBFWJzjaHzdcAsSSsDUauvqFewxE27Bg&oe=6A11AD29"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=avsLjuUEv0oQ7kNvwFjqTqP&_nc_oc=Ado62XOHJgD2v5KfwJRPs5kzMsai7igVQgTGkn_rvNp4kLB44LMIcvtFTBpF1bz-GVo&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Hx4eQNeO-hUDpwHkuz4ePI_OLgmQeTvp_4qs4-BDZcg&oe=6A11CEB0"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z48Ir0-x2kUQ7kNvwHRQdRo&_nc_oc=AdrEEzPLmpiP6HoLbcJdIX6Ju_TdWfplnLcyYKdhC6R_PBLxD5VIFUApyq08jr5mMQw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af72avDqKcQr3Rb-ARL0h1a2J7Xgjt4hfrKAlio0Cluwgg&oe=6A11B716"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wdm5YtCZVUgQ7kNvwEmq21j&_nc_oc=AdrkqauRfbipwzJTQt9wG1K65VI-Wci_zLBWQ32ohAUCughiBYvhH2em59TrG3b66P4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7bsPTRe-HMkRHF69M6rnYqXfkyfCkAOvINSQbxnuHdtA&oe=6A11D0D4"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "928105881625935"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id
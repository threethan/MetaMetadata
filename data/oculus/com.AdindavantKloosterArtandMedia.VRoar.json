9965_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fjH1tkoW_ZMQ7kNvwHQ6G-T&_nc_oc=Adrwy2M17boBpiPDYYeFGgOaYFfu2wOX66AcSNW2sz6J2plDz67c9L3-s-JQ00zdBTw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFMCQBtYO5_GIdC3D7sWYIBYoFYolZvhmH_sUuo_-q9g&oe=6AA9519E"}, {"file_name": "leavesandtrees.png", "id": "3627811494209942", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4RVSkNIN0ykQ7kNvwGoZKXn&_nc_oc=AdqtLPl4SmAXVb3xLKYMs_Tqd7gn4cAPFUVPyZnWZ4Rwl0ff7GTYmaksl7ZqluhkgBM&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4kvO2jb4WIov0bjdaKNKl_e1bi4cHjtLHBcmh7zWCew&oe=6AA949A9"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UVlX77jDVlIQ7kNvwFPJ_gG&_nc_oc=AdouibmIK7btWRNGF2lkBcSF9urNloXBOdJIRrC-39R79a8DbBzs7QCvOMANadg0FNo&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlp3YJmpG-zkMXThEl8YBBFzP9BOrnfa-2fP7LYR3NAw&oe=6AA96B30"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cMXR3lUhOagQ7kNvwFeQqA5&_nc_oc=AdrPaMGJ0n5b-t7kzT4yP_vSqRoZhZYYfgASmJ5KxePNQQdC-jiIbOw0ENLMVsJ1fxg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWLZGMgmA9136L9t3LXWgGGdmQCIDM0effo6XCcJSKOw&oe=6AA95396"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jbf9RYsmKXsQ7kNvwFqdy4b&_nc_oc=AdplYggsKwmfgjUnyRpOaed2lKKt0i10NdzsbpaG4JDBjHEUzWQ8yNYJHw0IwIEw4rU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvjUGwLnvokH-9IuNpohx951mB_sSO4NHgorEcT_oShw&oe=6AA93514"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_gr
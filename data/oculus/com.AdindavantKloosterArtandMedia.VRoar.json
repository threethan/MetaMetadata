_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CokGy7ifbL4Q7kNvwG3PFLz&_nc_oc=Adrwte9m4LB2K5BMCypkVBJpJmC742RmLbNJmLjDnRJf_vOc1Y-l6864RdjsZi09sWw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ4Y0E_WjhrGQPXpZeuIloPNe2jybZxYCG5zIYoSntSjQ&oe=6AA55D1E"}, {"file_name": "leavesandtrees.png", "id": "3627811494209942", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mVXws6ze6XoQ7kNvwEJIAPv&_nc_oc=Adqrgls8IFC5_QiKNuOc7lRyazsbd2kh0qj0YrEgDbbRetXEbEwZPRb4CxekriDCfx4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKA-SF9BweSN8R1MFIlm2VCrfsth23jpSQwaP6aUwvxsw&oe=6AA55529"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BYIlL97M3zEQ7kNvwFx7hYM&_nc_oc=Adr-qup7mi1cXHaqdCiBd97kU1s-6H1VF_NHVus7XM5lZQ1XzaOmGBvpu575-aT6iC0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKeyide6ZasSgVI1RBWUK8G1t5Zj9Q03gAUvsxZ4pye9g&oe=6AA53E70"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ylqTfA6cjuIQ7kNvwFP2AMq&_nc_oc=AdpmLap7d6NsfgcmqkGj1NZZL_3nJFAYwcsnki_L2_f-ppq-3xEKCyUIfRcY_LDXdCE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKL7SPxZ9Q32kZNy8MLcNBDnvGPBfd6MDLimpXCf0-FhQ&oe=6AA55F16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=If3iOeM9ExgQ7kNvwGgpiJ6&_nc_oc=AdptsTCSOe-mJodS4GtEmS0zzD0KgIORSpKdsNzZ4kmnjFmggwG5bZET6wAF5BKeZ5M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOJoWgplZ0eDuODCygqBSak4ZBk_FMxHjWCw5nOfUDdw&oe=6AA54094"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics":
_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pZvrRsFMa5sQ7kNvwElGnL3&_nc_oc=Ado80mKJjNGkOz8PYPEQzh5hQhV9CeGqmd0Ittuo-ojCU34sccFGr17wefHYiaSNGb8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af432RN9ZaJ1QYVuJ-eEnWdX8PCrhaVjcqlrEu8asdiRWA&oe=6A09CC1E"}, {"file_name": "leavesandtrees.png", "id": "3627811494209942", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cMjY5fBEMIEQ7kNvwFUeh4o&_nc_oc=AdrBJfDKx24uIaEJ_BAQk5DOCKhTpt3NU2ahaN_iGIpm4-NrQnd-8CL26F8kAZYnxYU&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6H_ZSDbKyu61w8uX_hl8aw6Wb_Q4FJ_rUFiq-M6FDKHQ&oe=6A09C429"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DiYdZ6bzLYAQ7kNvwFasqzz&_nc_oc=Adr4Rjr1aHPbQSmklmjzjpe7YHlcvN4koljL6DymTbHr4hI-PcHMnusab_w-jndTx2g&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7hBwldHCPdM2pFlAhR4kExMhtpIL8K6evPbEdFwgklgg&oe=6A09AD70"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_eCRUpvl6mUQ7kNvwGmUqNn&_nc_oc=Adox_-1RBPe2QGurSplAx3BvfAM8CoSp5T7AKuoNnEeOPW6QMOCox1dT86za3izAjpI&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5HhDB1AAjvFFyU690skdaSTa4eZcB44i8zE5ic2wPFRw&oe=6A09CE16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JaNdhcUzs1wQ7kNvwGygDr6&_nc_oc=Adogu-HNIwbSl0E8QACyLYuFWuPhb-u_H1mnVEVgMBE59Kfm2cWOUTq2Xfs5PKm6pTQ&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5KxlFx-ZdWnFgVNr1i-Tyy9BQ5mRaR728NI0qvhE75hQ&oe=6A09AF94"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics":
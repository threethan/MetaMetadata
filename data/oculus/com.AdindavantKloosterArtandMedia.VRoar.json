6L32VIl5GnNkrlUEoiazl9u1J0463_uL0ljWiQGSS-Po&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvdDp9kraAk8lU6tOmN9u3eD090HH_DP1eqlRalp2gnTg&oe=69A2F71E"}, {"file_name": "leavesandtrees.png", "id": "3627811494209942", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EdAt3sr6UZsQ7kNvwH-cDdo&_nc_oc=AdnsTU4CP5rXt9y2yoQDcCZmgBaWaEa37yn66oCsG4xLNH8AX8zuVrLuRkclU2HUU4Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftmMPvkxJxTOxod-8SB0nY3CrdjgHUA0GiYV_4xsWGeYg&oe=69A2EF29"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sKjCriWXIIwQ7kNvwFzN6JS&_nc_oc=AdmkJZBxFaa6Vz7EiOTp5G1zEkBOj0x039ByCOvnXEurNP4tbno5S-O2mFjVHojgm4w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afuwh5cm7ftXWzLgmtdbxsC282f8ZJ7TG72G2st0FhIKEw&oe=69A2D870"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4DGyQXODF0sQ7kNvwE_2TXD&_nc_oc=AdliWu2ocT6bTtLymkHZ7AtPBmbIAjQULlzq9YLh3BoIbMsgj2Bd6wXzX_wFPjmONpg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftRB-bZeallV1imNHPVSgK3G0R0RsA7-4Em8zJJzJmMkw&oe=69A2F916"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IJGxHPwJKk0Q7kNvwGRQWTm&_nc_oc=Adl9dUIesCvzytd3Gce6gvHK5PHcpQx8ziSN4i41gUmJBbBx374wuXe8KL0OZiHWA_U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuQ1alqiAhcMe4yTuFJtwSNtwPLbMy2t0wG6aqqE5R83A&oe=69A2DA94"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player
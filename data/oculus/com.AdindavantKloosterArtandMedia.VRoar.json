1-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SCuplRHBAPUQ7kNvwEWemem&_nc_oc=AdpRR-5Wf_UYlws1t_v1q7Tl6SrnQkjWPpKmdx0ixmh7F5zrJpxKPDDsSg2y3--0C-c&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGPhXP8AIhciyVdDTzaINd4yBwbUzy2-m5Fb9DvAbXflA&oe=6A918EA9"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sm77_YqOl2oQ7kNvwFVL18W&_nc_oc=AdrGWVys6qq_DbUlT6Tj5JbolupwJFYd0Qqg-vBq5glpzVh6OPJUkxkKIC-Cq3sdSsE&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGPjDMwkh_agjZMg-ZWWEQqedmMLgTKJ9NQ2eOjMIqSMg&oe=6A9177F0"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EXgRkEqapqYQ7kNvwGOyoBh&_nc_oc=AdrFdzmIykYCZFYyDs5nTEusksvvkFn6WVi2pETEEH40TMRalIb6Gl_wPsWDForLDHY&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCNYzo2OEywOr1CIDP_euJVhBNrlABjnTo-TFWxfMSDw&oe=6A916056"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WpQqEo9XtRsQ7kNvwF9RN_r&_nc_oc=AdrtE_6EBDLhPq_Z55mffX_ZPI-uUpz_oqfMnwroOjL9ntL5sua62ZCEilCh4Xn-JY4&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYwzMyxvAnoDke9we70JJUsh3eXZLCPh0orLiP1goqZg&oe=6A917A14"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "928105881625935"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "812148190574
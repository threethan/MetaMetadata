_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kQaA6k__jMMQ7kNvwEDtmp4&_nc_oc=AdrutHSppi0vuDj1fRiniKWnfLy6OkzBV1EvsCSK8htgT2AUAOTdJW2tLd90LIbUz4E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBDwyBjq_ho2A85r-bY9If2kVC_RYULafmK2m-6qvDeWA&oe=6A60CF1E"}, {"file_name": "leavesandtrees.png", "id": "3627811494209942", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q3il6dEk0VQQ7kNvwHHFqpL&_nc_oc=AdqkprCC3pe_b3yzXoxFSrBAF9dm2Ag3mTuciSU7MvMPuzRzAeH0OEiHG0KpZzAMp24&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDEa0CqqV0xjnA1KgKIz3ZTWI0z60eUfrHZa2fakFqW6A&oe=6A60C729"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZtrCyxFKJ04Q7kNvwHbaOeD&_nc_oc=AdomfmmXHfHSMpSumPgIWj5IIpUANkZYPSGMB2AwJwkooeIotTcTI8FhdvdWsjIJ61I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBFBX7plGpwFBIxbrErLqW386iy-ehFsSDzVaISD-odBQ&oe=6A60B070"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jv38QeEraNAQ7kNvwGIsx2L&_nc_oc=AdraYmTOrKD3xqQxK5NCq577JYQtxnawMXw-E6ilSTD0rVjrHkrL_tec9e7sIyd-tYc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAW7gCDWxETLLQfnyq02XA-hCd7yP1Q6KTToInOfuB4fg&oe=6A60D116"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B8h0WbZpKFoQ7kNvwG_dwny&_nc_oc=AdpSFsfC4iLM4nCGZ-4C2udEiM1IeyZSzhilUDKHEZ-8hFvJLpe45LSUOj6-OPRIUO8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB3sQLdSFmAexmZPgicD1P-tGjx5_5Es0ckAnOlZksK8Q&oe=6A60B294"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics":
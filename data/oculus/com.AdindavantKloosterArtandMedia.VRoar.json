_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yfHh4dWqyUYQ7kNvwEkxcSD&_nc_oc=AdpfE01VM9EtvEq9K9GULlBSS1ZyXUe8QvrnGSPdC4sClagIpb0qwM8_KQZbV5BjOD8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ZBemYKRe-z4nxoMwOk64Nk_Ivh8yRiwuNuQakuSsmIA&oe=6A04861E"}, {"file_name": "leavesandtrees.png", "id": "3627811494209942", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XfbozitD4vsQ7kNvwG8czuM&_nc_oc=AdpEyvJoC6uoja6r9zRwd7-T8xKZPhjogNS5mqV9bV2mkZ7D1LyWeE1XXkKN8nnjiZg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42LY0f9W6brJfZiLgN6p-NEDVqRtsGlS8FSUAXewxGXA&oe=6A047E29"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FqiG-jDhvsoQ7kNvwEfRA5F&_nc_oc=AdpV7uXB7DK8rVXXJrAvNAWBbbhib6nfM6DE9AErwYO-3JC96uVWKkGGJXrevU2Thf8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ntwC4Pw19ngDVJcH6C3-NfAMNY7rEG5KO87OiaLFKLw&oe=6A046770"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9MmO55HHBjsQ7kNvwH3yL7H&_nc_oc=Adp7q7DrEwIufF2AEUTdFuNq4TvFx9V7QYsUhTy3rvLz9LKRnG1uG_H13lZcc1hfchg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af75w8Xv-V0QQuNmqqCABMmBDjmH1_gsQsQi5yxdp_o2ng&oe=6A048816"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tl2OwpI4qMsQ7kNvwHquZSi&_nc_oc=AdpmStYdA3fvvUpnlpgo8nFwYpFcDIOWN_DLLRYBiGFrtCN0K6Blnf6Qn9dyQmx-vsQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4e2YF7b4DAdaFweyqE1cwmbACIrWbk-uA2xyZzQHQAJQ&oe=6A046994"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics":
id=6e7a0a&_nc_ohc=KB_E_PyNt-MQ7kNvwF_ORbg&_nc_oc=Adn4XdMxUAUMo4V0NJ8sI8MQy6yPDLGuTYtbYcJJs9sza-_e8FpFvi4P72qpRmM8gFY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwVLY3JqcUX-QMpK45l41J4ki60rl4WzHLjL-aZucZB4Q&oe=69B2C91E"}, {"file_name": "leavesandtrees.png", "id": "3627811494209942", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E7YuLuz6k-YQ7kNvwHiwUwU&_nc_oc=AdnbkAaCEzajNoU6o2xvr0yf8DDSQ3LT6fbrOIWgizn6mo2CfA6N5TzR2Xx9pXTH6cc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxjI8zGUeO25PgeZBHg8hN8HsZq7B8gxnnQWNNs_SSEFw&oe=69B2C129"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3wnYyRcNh_YQ7kNvwHAYUws&_nc_oc=AdlwRKoxo6WIrBoJjj-6qwtXz0Tzdbh2VfkLQ6bl9XquhkUSpENgJDBMTckrQvR329Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxAwn5hc5cy9xZr0cBOYsexGKLb-iex6U8AOQ6MR7eK8Q&oe=69B2AA70"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Tcu6Oj_AqQQ7kNvwFOrCvi&_nc_oc=Adk_t9a1D0hxL8tBC7QSb-0fAks2a0byqHn7sJrKgoqBRlt4ka3r2oe45nVzTte-PEE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz5AwsMzSwlagzYLeM9d2kiK2oyG69DRE6M3uNo4yv6cA&oe=69B2CB16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V6Kn3N-2ghIQ7kNvwGhMgDL&_nc_oc=AdkvusDaDIDRAkxuyfiGkb9Inf08Bm4GP49ZffiMNnN73irevSFWWYjmd0xrHKFHXoE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afwwt9M16puH0snDGZUno0zp06jAlIsRKhS-hMP2-evBSA&oe=69B2AC94"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_p
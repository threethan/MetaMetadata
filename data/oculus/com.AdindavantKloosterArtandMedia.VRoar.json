om/v/t64.5771-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V-CQbuq5RSsQ7kNvwE1Ohhf&_nc_oc=Adqyqc0mi534cuj5TXJLKG9y4ZSOwd-_SZZmojHvydUSbheAD2MqalHjSXk_9mr4CUg&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKP6YpUCAp47GKjkbrZ8iKcNTHtkCQf5-L0wnfmK0alkA&oe=6AAE8FA9"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-MxGUHlAnOUQ7kNvwGOw8Fz&_nc_oc=AdoGzfrCNM9c0M3S3QeHriKKmIadkjkYWTUbJHyirq9QHu00_AiBFjLoQnywvrK2n6o&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqPGVibbuGvznzBE0IkpDn0ppr9wlVGJAG6I8zQiIAtw&oe=6AAEB130"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Puzo4xVRWcQ7kNvwFjxr5v&_nc_oc=Adr7vQrpp__aorMgfvvfxq9BBEUVM0ZDBI_Iu3SpSDF4Jhjq16yuLq7fXl25gP8S-o4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK11K4TrCq5xANumHn41Qm2LENoI8PwPRz5hp5m1sApmw&oe=6AAE9996"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4tL-rCsqFesQ7kNvwGv2RrB&_nc_oc=AdqjThPYHSyEeV6unyJ5gOEHeny8c1oDX7y5nQVMCzD91B-EMDZL9ckPqR0Ge5js19Y&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKzZHyWu1RItAXu-dNYnnP_egZ_NyDkTt41dHoiYqAdxQ&oe=6AAEB354"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "928105881625935"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id
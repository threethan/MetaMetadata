1-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XfbozitD4vsQ7kNvwHXnE1n&_nc_oc=Ado5-LDxB5imqipIl3O4Qqc_I_BPwyiVhigeuxGVd1zbg6biP2TyXfB7GGF6UilgQbE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af50dUvrmqrgrMUUQzq5aH28pL7-qLuII1t6xyHgTZmiMg&oe=6A05CFA9"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DAKNOjzxNYYQ7kNvwFI6Iee&_nc_oc=AdqzwrD1VDhZ3zxnldqKGrgewrvqY4gJ7qNl1WfkqIWXkopv8mBphOI7mrSMSjoUk0I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4DpyAlsMtSh8DJWUiUiEpzSOyN_EIvN2MmPwCSw7tqkQ&oe=6A05B8F0"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9MmO55HHBjsQ7kNvwEePTq7&_nc_oc=AdpwT08ZMfDhtwsDU0DWdF6tGgkGRtHTcsWYKDkT4cxClq-BWMc-foFKYWeDEX4ewhU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af63IttOHgLuX66JqVFDy_IlO69-zsTQ0QgJtj-_QN453A&oe=6A05D996"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tl2OwpI4qMsQ7kNvwE-GQQY&_nc_oc=AdqMM6D5qMJOwnnp_lMH7vetSzRS9QraVkalV0p-Ct6MToziH0n5cvL3EyecJDracyE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4P_HsHwltvHO8-OpganMvEg9z3wOoccjjnznnZFTgsTQ&oe=6A05BB14"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "928105881625935"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "812148190574
_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zmPp2yQ3ZWkQ7kNvwHjmPWT&_nc_oc=AdqjceoelGLy9V9S5z0lTIkxYO7ZPxj2PvuH10d1tmZ0_haXfP6VcRbGgo76XEOCz-o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFtIciiB10VPyMQv1KDIfQO71vbZBkZuTWKZTWHqTJaw&oe=6AF4771E"}, {"file_name": "leavesandtrees.png", "id": "3627811494209942", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A2h6WIgQABIQ7kNvwGYsL_L&_nc_oc=AdoMrgyFmID5Irwkos2VecE4LMV19_BU-rLWl6r_jdxa1sYRH1ZNNoy67egZPqKLDt4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScdx9XyCfgMYgLjscdaLsWVxDpRaMgU9IlXTLOuOnWeA&oe=6AF46F29"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ygH8hTzD_kQ7kNvwGq2D3c&_nc_oc=AdpsjMXcHgtVVQvJ4egW6394Zuu7A_rUGd0qw2G-SEMyhDRyDtToCDzPSEhgZKNth3o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFC2TNE5Vi_l8GspXDh41Cnefj1znZadOz-SaW8zNkjQ&oe=6AF490B0"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s6fNYqESiNQQ7kNvwGdaK7M&_nc_oc=AdpugYyN1Ci5Foo4A2VA-L_wpjpIB_ECRZBgMokFUPBaRPb0ASctuar2WBVzcgSVG0Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZYa3JIs8hCvNGWx7Sh2Vny5UD3bWuV0fu-MLgh23lRw&oe=6AF47916"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nmNAlwQAKK4Q7kNvwHiTpjA&_nc_oc=AdpgHSKcCbgzOqGFgXluI5awrrYxc-7AXUDiBd_0RkX9wYkbKcPzh3_v0qfVizznHXQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHd0qR2rmdicMMmDB3XwSwb437CPqFxx19I4iEwDvHJw&oe=6AF492D4"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics":
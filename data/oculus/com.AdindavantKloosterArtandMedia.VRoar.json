id=6e7a0a&_nc_ohc=KB_E_PyNt-MQ7kNvwF9ArRm&_nc_oc=AdnNz66gO0Ycwz-p-M0v1vpYDlkt54-ubyhcd99BNWVi6uoTX5XRBQ2Z-IhNERLufxw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxOPJt6NFQj4fgsluM60gWSmvyrK6d99fO4L9lAuS1GOw&oe=69B56C1E"}, {"file_name": "leavesandtrees.png", "id": "3627811494209942", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cPibe-KN8EcQ7kNvwFm56Lt&_nc_oc=Adly_tDhPbcxrTvJyYAdEhG2OOSTgRVD2hTRAvqOlZXgVoPFyU6EaIPctyBLLYQge3Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwWOWZK5X0g6OSyIZIIsSj48uyRf8E_Sd7d2P2-jeS7CQ&oe=69B56429"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3wnYyRcNh_YQ7kNvwGApkgo&_nc_oc=Adkf6pl8Vl1T9EhKtDL0Nb6zBFtqf6hy3cF3d5endJSlmP1WH6b0R1qJa7_52byFC3M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwr2k6JgHOob-JB978sWlQbEwGT3BwZzveh_cyEfS-dFw&oe=69B54D70"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i4su0ZK4PmMQ7kNvwHSvnI-&_nc_oc=AdkYyiM7XbnNlyjOzpMxd90DrtLbHLAKmHFI9OdgCo2IBClkepz4ooBCGmEKWNSRQZ4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz34PZXIsmIPzLt3zQbWZR1Q6sV5Oi95m07i9ncRbYosA&oe=69B56E16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1UGoH6BIT9wQ7kNvwH7KtpY&_nc_oc=AdnvP4CzqPUP6xwjT4xiP-VjCjD-EBIHCGnf9XR7jYv5HhuD55DBNt8uQzrD-Hkp19k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzPQJ1p8UEmmZXGW_OGewVc_Nth0sASE1p0PNbxYeDAlA&oe=69B54F94"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_p
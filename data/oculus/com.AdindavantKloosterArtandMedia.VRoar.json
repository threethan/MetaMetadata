_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=66LzGpabSbUQ7kNvwHmiyEq&_nc_oc=AdryucxIFEf7L1mT3l5iizV9iQrsVmSvqBc2assSM35KuqmPDU9WHInlXqrlCqnhVrM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIasqfI5Uu0lujy-hQ1GELW3zj9N9RLYhClE9UxfQ9Y1g&oe=6AB13A9E"}, {"file_name": "leavesandtrees.png", "id": "3627811494209942", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V-CQbuq5RSsQ7kNvwFLNXuZ&_nc_oc=Adq4E4hGSTtR3-6qTuFa1GboC3xpAq0P4F2Ob2wi8etnGaGxxOaGRqw09JW9bGx7WGQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK2gww5KSaq82jM9I0mNveO9CAByJaxn7QYh_0hO8nPsg&oe=6AB132A9"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L-eVFBQha_YQ7kNvwHuKVpv&_nc_oc=Adr5wk3W3HJubUByz0xRphQeCjuICDJk8dCwAXRZ_HQX7CgnrhSvbjSNykw-lrAsNJo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInArsvWkvcaVOF7W1jLsDBrIpIqLRwh0Er9hM2MrxgUw&oe=6AB15430"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QhxbUyD7y_EQ7kNvwG_LuWc&_nc_oc=AdrNiqHU9DTcM-aoWBwIQ_W_qyKIkSevmLcwqGTqF1NYrawaKxnf0M97UBScG8MlPz8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-ron-AN6-ARLTPhLI9KU6lIsZlm8OpHrZIGZYrOVBew&oe=6AB13C96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PNkf5xD7ktYQ7kNvwExsc2S&_nc_oc=AdqikABuWyaPvRuaaYuYFqkhMSOwGaYg1p9Vm9VTEouzb8r9kE6FymclyGqRfBqUtdM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRbjj_cx5N3uZaj203gft7btuFCLRE5obtvBolSQLnqQ&oe=6AB15654"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics":
64"}, {"file_name": "whiteballstreescells.png", "id": "2776687769137070", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031624_2776687772470403_2357440132662109965_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fbwO-7o_3MAQ7kNvwGp5ZjZ&_nc_oc=Adq5GBJHVkQtf4EQKfCDjwD8w8EO_k-H2ZLLbjRp6PSNXglhqyT9gmSAII8H70JGLhU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ_WlualnvleYyQnwBoF7yp8ZtmIfhJCv71I82pLIdeMw&oe=6B0DBBDE"}, {"file_name": "leavesandtrees.png", "id": "3627811494209942", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982487_3627811497543275_1359127470543222432_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NHZcFk9okPUQ7kNvwFhER9g&_nc_oc=AdrQUcwlURZaDbSfgXNxpbLkEQ00OwL9B35m4ezOK71ApvF1gDC7aIvMn3Xa0PB01ak&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSpIIYqkltIjUKPPwjN8tYdb0IlDbE-hlAgViRxuFT_mA&oe=6B0DB3E9"}, {"file_name": "redballscells.png", "id": "882777689929667", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974713_882777696596333_8849572616087486688_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ECNihgWOgaQQ7kNvwFRdFMU&_nc_oc=Adoo2HPjJCpFJaB-20DWTZ7DnRvW9rFXcUvFaYNmyj0VIG4xCic8PjGBHzbu5Ki0k7E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR7oIX19NmTIsgBRsgPFLtGlu1ZDjjfMooecwDIwbV8wg&oe=6B0D9D30"}, {"file_name": "leavestreesclouds.png", "id": "300350992420438", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982602_300350995753771_1235810631026950315_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1dGHKoo1TecQ7kNvwEC_ivq&_nc_oc=AdoD7Y-CQMONE6RgpaY8CITY6Gyi79q_cbqYqqhrBMsiqvsB1a3edLW0qGyNQF-zZwE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQfjUrn2EKALnG5ZH3CIm-CBhrYu0z8I2khYsaB9rZAMw&oe=6B0DBDD6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "greenballsinkcloudgood.png", "id": "962054461785866", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86601733_962054465119199_7092540537134037982_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SmBEWrexAEAQ7kNvwFzJxJ3&_nc_oc=Adoft0sUim5rUJ-Bv1jtYVnDLiYfpX56YXxQV8oHm5WUPEVgN_BabQr6ea4fuFcIjto&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRLDpFtShy5iGiFh6KS-VemvfPwtLqvXHoGurUzdRvj4Q&oe=6B0D9F54"}, "display_name": "VRoar", "keywords": [], "long_description": "This indie developed VR art game allows the user to see their vocal expression directly affect the graphics in a variety of fun ways. You can make trees by navigating through the landscape with the joystick; blobs appear with each detected onset (so making lots of short sounds will quickly generate a flock of blobs), these blend to a different texture depending on changes in certain sound features and comic clouds distort and dance based on the sound you make. Each time you press the A button a new skybox surrounds you and the mappings between sound features and noticeable behaviours in the graphics are swapped. ", "short_description": "VRoar is a voice responsive VR art interface that allows the user to explore their voice in a sonic and expressive way, to steer an animated graphical interface that combines handmade drawings with computer generated imagery. Blobs, trees and clouds are made to move to pitch, volume, brightness and sensory dissonance variations, creating a visually appealing scene that can be changed for different interaction patterns each time the user presses the A button. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adindavantklooster.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Adinda van 't Klooster", "support_website_url": "https://www.adindavantklooster.com/contact.html", "website_url": "https://www.adindavantklooster.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category"
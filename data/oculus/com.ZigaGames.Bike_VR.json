&oe=6B031342"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "7576637879026119", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86615892_7576637889026118_3213961923196708108_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2zvsgckhyUMQ7kNvwFOCEHP&_nc_oc=Ado4fUcPCKxtn4xDIl6A13SJpV7hIeZM_ZX4-mm2K7JwvJC0mJbQxIvQkNsfnQ8mhlQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqG7pvF1M2dlogftXZq7qBs2wVWlaHOEr4cMuqhCxxNQ&oe=6B030A9B"}, "display_name": "MTB Downhill", "keywords": [], "long_description": "Dive into an exhilarating adventure through the world of off-road mountain bike racing and speed with \"MTB Downhill\". Explore breathtaking natural landscapes, thrilling races, and endless exploration opportunities.\n\nModes: \n=> Career Mode:\n-Take on a series of exhilarating challenges.\n-Unlock new levels and bikes as you progress.\n-Master each stunt for the ultimate gaming glory.\n\n=> Stunt Mode:\n-Perform jaw-dropping stunts \n-Conquer challenges with stunt bikes\n\n=> Time Trial:\nCarry objects against the clock in a thrilling Time Trial.\nTest your speed and precision in solo gameplay.\nCompete for the best times and unlock new levels\n\nDifferent bikes:\n\nUnlock and choose from a fleet of high-speed, \nEach bike has unique attributes for varied gameplay experiences.\nUpgrade your favorite vehicle for enhanced performance.\n\nNavigate diverse environments for a dynamic experience.", "short_description": "\"MTB Downhill\" is all about off-roading, speed, and challenges in VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.zigagamestudio.com/index.php/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": "Ziga Games", "support_website_url": null, "website_url": "https://www.zigagamestudio.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_
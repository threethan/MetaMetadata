er challenges with stunt bikes\n\n=> Time Trial:\nCarry objects against the clock in a thrilling Time Trial.\nTest your speed and precision in solo gameplay.\nCompete for the best times and unlock new levels\n\nDifferent bikes:\n\nUnlock and choose from a fleet of high-speed, \nEach bike has unique attributes for varied gameplay experiences.\nUpgrade your favorite vehicle for enhanced performance.\n\nNavigate diverse environments for a dynamic experience.", "short_description": "\"MTB Downhill\" is all about off-roading, speed, and challenges in VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.zigagamestudio.com/index.php/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": "Ziga Games", "support_website_url": null, "website_url": "https://www.zigagamestudio.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "673385183287495"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7332579510153277"}}]}, "scheduled_offers": {"count": 14, "nodes": [{"status": "PUBLISHED", "id": "1454351526022466"}, {"status": "PUBLISHED", "id": "1825361578117354"}, {"status": "PUBLISHED", "id": "1169396994841037"}, {"status": "PUBLISHED", "id": "809087458490840"}, {"status": "PUBLISHED", "id": "1497262471693233"}, {"status": "PUBLISHED", "id": "1236488937935899"}, {"status": "PUBLISHED", "id": "683060334230185"}, {"status": "PUBLISHED", "id": "980913790842574"}, {"st
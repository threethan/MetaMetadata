HDqhJfrMdH-D2N-QmOJqGUavfU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZoA6HnQuQRpJmyMfB6ueHYs0RM0pLGPtX4zhTTEVoTg&oe=6B0869AF"}, {"file_name": "Image Sequence_002_0001.png", "id": "1635306147908632", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/491820441_1635306151241965_3015294756911394918_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vk_PlegS_KEQ7kNvwHrCF5N&_nc_oc=AdpMFwcDVvTxZth0jPXfNI1Ye6LafIUx2HCWMgjcztYW_2vMODY2Ytp-uKMDLSlXMG4&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpmfPw8Frs1xZYjYHCcRg32hR5aqMNs8COeG_5df2q1g&oe=6B084176"}, {"file_name": "Image Sequence_003_0001.png", "id": "888164260497461", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823812_888164263830794_2699388260831139756_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VGfjEam5YnIQ7kNvwFi1H3_&_nc_oc=AdpTM-KcrbLufb_3EFN6FawoPJOnn7o6KPnNJxJX06wY1QNsfIs3fjVWg6G9qZOFL8s&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSc8mc7IpSohhFdiXbuXyt2eu-wfcUODMYUqxXsRodUWw&oe=6B08713F"}, {"file_name": "Image Sequence_005_0001.png", "id": "1432948451630948", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491823296_1432948454964281_8310435058803268137_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nHyLO7mdAY4Q7kNvwHQW2Qo&_nc_oc=AdqjNE34NjeXxW_0mqCEcU82pmR8whxQZm8nbmIsLMOPJpI7CdOXMEhd6bLgDcGaapM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3OuY0-9JfkVdBK_M0rXKFM_XuqENvUcNLF8SIdBVgZg&oe=6B085AE1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_020_0001.png", "id": "1253241443610202", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491829165_1253241450276868_2593898828327800074_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wK5c4AP5wlgQ7kNvwGDh0p1&_nc_oc=AdpIPf597n8dXtxNwy5X_zYW5MYiyOAXni0dA58j_OkjDW8e6_aqhyliw9bwL4nryv0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7vcDQwBmpQC3Jbf1Y6xZwPkYEZghxFZunvjfaq4rlSA&oe=6B086AA6"}, "display_name": "Clown's Game", "keywords": ["gambling", "horror", "slot", "Clown"], "long_description": "Clown\u2019s Game is a gambling-horror game.\nYou don\u2019t use real money, but the fear is real.\nYou are trapped inside a twisted circus arena.\nFences surround you. There is no escape.\n\nIn front of you are two machines:\n\nA slot machine where luck decides your fate\n\nAn ATM where you must deposit money to stay alive\n\nEach round has a clear target.\nYou spin the slot machine to earn coins and try to reach the required amount.\n\nEvery target gives you three rounds.\nFor example, if the target is 80 coins, you must reach that amount within three spins and deposit it into the ATM.\n\nTime is always against you.\n\nAbove you, a heavy hammer is tied to a rotating gear.\nEvery round, the gear moves closer to zero.\n\nIf the gear reaches zero and you fail to deposit the required money, the hammer strikes a bell.\nThe bell wakes the clown.\n\nYou hear laughter.\nThe clown approaches.\nThe game ends.\n\nThis is not just luck.\nIt is pressure, fear, and decision-making under stress.\n\nCan you control your nerves, manage your money, and survive the clown\u2019s game? \ud83c\udfaa\ud83d\udd14", "short_description": "Trapped inside a deadly circus, you must gamble with a slot machine, manage your money, and survive round by round.\nMiss your target, and the clown wakes up."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "Jb Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vrprivacy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "
juJLUDlhjjcSo6IDbuHILxlC1Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwj2exl2G6B55GJa2Ci3BzZHRDcoZvpcUEdjDBN2w90w&oe=6B01D22F"}, {"file_name": "Image Sequence_002_0001.png", "id": "1635306147908632", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820441_1635306151241965_3015294756911394918_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E3arnpXiMEQQ7kNvwFJZJ4v&_nc_oc=AdpXBT5DNRn3UXNCe9LWin7ovRK0XIKJtjpO_27AaBPuafqsfKkvg2fOSdzFW5k9SFA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwnAma3Ve1npJp9OicRHsjDLUFwUrATc4LzRvm94W-fA&oe=6B01E236"}, {"file_name": "Image Sequence_003_0001.png", "id": "888164260497461", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823812_888164263830794_2699388260831139756_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iCv3QF_cEjQQ7kNvwFNfzo-&_nc_oc=AdpPUAqB42sQnpLJdz95EpTWqK_7ZnuKsyluZIKSiW8yZLWb52ujM1ac2ZbGAR9O3b8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQybO_k7pmcm0mXroWSLU6PjwoVoHtrMiCF-K6n3Q8DeQ&oe=6B01D9BF"}, {"file_name": "Image Sequence_005_0001.png", "id": "1432948451630948", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823296_1432948454964281_8310435058803268137_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r22K53o-uccQ7kNvwFGF1Rf&_nc_oc=Adq0utrzbARXRiE95KkMGAdjgijoV4x3I8r6YP5biWXA9YsqWqDz3jSLISxYhhB21tk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5Kc2vkYzu6oimKOyzVeeOnMl94LoUhOX290rcx7Yf7Q&oe=6B01C361"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_020_0001.png", "id": "1253241443610202", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491829165_1253241450276868_2593898828327800074_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y5eYqzv0T5IQ7kNvwFbspeG&_nc_oc=AdoYMDwp01BK6W1myEinJ15ehKh1qRTZbfRQBOVwmeHqSognvBwYffNy22iAT7cMMXw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbZAFJG5oWCXrq_yCGjt4apKMUg1MYxAt_5bhfqMKqgw&oe=6B01D326"}, "display_name": "Clown's Game", "keywords": ["gambling", "horror", "slot", "Clown"], "long_description": "Clown\u2019s Game is a gambling-horror game.\nYou don\u2019t use real money, but the fear is real.\nYou are trapped inside a twisted circus arena.\nFences surround you. There is no escape.\n\nIn front of you are two machines:\n\nA slot machine where luck decides your fate\n\nAn ATM where you must deposit money to stay alive\n\nEach round has a clear target.\nYou spin the slot machine to earn coins and try to reach the required amount.\n\nEvery target gives you three rounds.\nFor example, if the target is 80 coins, you must reach that amount within three spins and deposit it into the ATM.\n\nTime is always against you.\n\nAbove you, a heavy hammer is tied to a rotating gear.\nEvery round, the gear moves closer to zero.\n\nIf the gear reaches zero and you fail to deposit the required money, the hammer strikes a bell.\nThe bell wakes the clown.\n\nYou hear laughter.\nThe clown approaches.\nThe game ends.\n\nThis is not just luck.\nIt is pressure, fear, and decision-making under stress.\n\nCan you control your nerves, manage your money, and survive the clown\u2019s game? \ud83c\udfaa\ud83d\udd14", "short_description": "Trapped inside a deadly circus, you must gamble with a slot machine, manage your money, and survive round by round.\nMiss your target, and the clown wakes up."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "Jb Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vrprivacy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "
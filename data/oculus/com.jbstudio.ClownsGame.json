EBfDh5EQ7kNvwFUBPof&_nc_oc=AdoiAjn60XmVhGuG4DaFy4eUYVcjwdETVYv2nnqL6LI-2dytSMXO5e89bOBlzyIXK7g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBs6uMd3eHWxv72gSPgA_5N4jBtFLve3pQHHLWDsvWuA&oe=6AFC93BF"}, {"file_name": "Image Sequence_005_0001.png", "id": "1432948451630948", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491823296_1432948454964281_8310435058803268137_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LqocTc52s1gQ7kNvwEZoOdu&_nc_oc=AdqMyKx16i0RbOzliEjMbD-mzu130sPtKCjE6kCOWx7JDj14TIGPfhrIg2Qjb-5nxR8&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQv6NSI9SoTbO0H-sbFire2rKGiOPylGehfMdUHPlMDtA&oe=6AFC7D61"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Gemini_Generated_Image_9zmv6v9zmv6v9zmv.png", "id": "1583784949541657", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827987_1583784952874990_2927993087654322517_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N7lPYv_fs94Q7kNvwFvuk_C&_nc_oc=AdrKpEBsx94HSgaG4EioCqCNQBmMKxLHhETC34C-7O3a_rdt_stT-h2dCspkXGBCKos&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCGOHmLhYG6AVDTKt2lvliwKix0S_E4X4-PPbpW1E0Hg&oe=6AFC8F63"}, "display_name": "Clown's Game - Gamble for your life", "keywords": ["gambling", "horror", "slot", "Clown"], "long_description": "Clown\u2019s Game is a gambling-horror game.\nYou don\u2019t use real money, but the fear is real.\nYou are trapped inside a twisted circus arena.\nFences surround you. There is no escape.\n\nIn front of you are two machines:\n\nA slot machine where luck decides your fate\n\nAn ATM where you must deposit money to stay alive\n\nEach round has a clear target.\nYou spin the slot machine to earn coins and try to reach the required amount.\n\nEvery target gives you three rounds.\nFor example, if the target is 80 coins, you must reach that amount within three spins and deposit it into the ATM.\n\nTime is always against you.\n\nAbove you, a heavy hammer is tied to a rotating gear.\nEvery round, the gear moves closer to zero.\n\nIf the gear reaches zero and you fail to deposit the required money, the hammer strikes a bell.\nThe bell wakes the clown.\n\nYou hear laughter.\nThe clown approaches.\nThe game ends.\n\nThis is not just luck.\nIt is pressure, fear, and decision-making under stress.\n\nCan you control your nerves, manage your money, and survive the clown\u2019s game? \ud83c\udfaa\ud83d\udd14", "short_description": "Trapped inside a deadly circus, you must gamble with a slot machine, manage your money, and survive round by round.\nMiss your target, and the clown wakes up."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "Jb Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vrprivacy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26203752519296634"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491820387_925477710080171_9004924805371735039_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OoAy1Gz3aBIQ7kNvwELIQUW&_nc_oc=AdojuajyRkhutoIkCuXOwOS24hz8cfks1h8-5JsaS7zICPmQnw-X4
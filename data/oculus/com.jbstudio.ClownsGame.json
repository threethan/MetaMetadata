An-NTrh-YHzIN4V1k7eSXKMFOg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSf8Ota2s4JjQyvYJmnIoVnRxHX9cLVhr8aISJa7jcBug&oe=6B07182F"}, {"file_name": "Image Sequence_002_0001.png", "id": "1635306147908632", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820441_1635306151241965_3015294756911394918_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VQk3G3p0t4cQ7kNvwGif8iX&_nc_oc=AdpJmaYKPxvCEbgPUqxRzMLkwUf8QvvdlrjcvrEIyMPB3Ztq6kBuKeR6Lj6oYLmxYug&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoQLVL6hS0RDkrsZclcAeWm5w19ffRPyIf7SPmvB48IQ&oe=6B072836"}, {"file_name": "Image Sequence_003_0001.png", "id": "888164260497461", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823812_888164263830794_2699388260831139756_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lbyIjwntqxwQ7kNvwFH1yDC&_nc_oc=AdrMherZmgoJTy_F4R-RXqwa3G96tvk-5OKtcT38bR9Aa96TzXvHeDEhBqVeeETqdTU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfGvEBn7UWGcBEq8RBEHyEx3D8p6XV-H6mRKpCJZdzsQ&oe=6B071FBF"}, {"file_name": "Image Sequence_005_0001.png", "id": "1432948451630948", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823296_1432948454964281_8310435058803268137_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nHyLO7mdAY4Q7kNvwHYmLux&_nc_oc=AdoeaOizEwFs8BDWvoRLpM3sB0UOon4gdJOhWuR3SYQ4CUuvTr1Zvdw6MYXfJ5zT9W4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5UaQTMDRLZc8GpW3DDX656YodldCn8wfVyo31HvDhsA&oe=6B070961"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_020_0001.png", "id": "1253241443610202", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491829165_1253241450276868_2593898828327800074_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XPeJALpD-lYQ7kNvwEzJLbP&_nc_oc=AdqB_kEVh7QCFa59H4sMPE1HnvKCgKiUB0Axj6Ai_Vp920EiUUd6t-2xjxLDLns2tLI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkYMf88ftVo1DF6DhwO_ehvdBMogyWawLrXrL9aRtlyQ&oe=6B071926"}, "display_name": "Clown's Game", "keywords": ["gambling", "horror", "slot", "Clown"], "long_description": "Clown\u2019s Game is a gambling-horror game.\nYou don\u2019t use real money, but the fear is real.\nYou are trapped inside a twisted circus arena.\nFences surround you. There is no escape.\n\nIn front of you are two machines:\n\nA slot machine where luck decides your fate\n\nAn ATM where you must deposit money to stay alive\n\nEach round has a clear target.\nYou spin the slot machine to earn coins and try to reach the required amount.\n\nEvery target gives you three rounds.\nFor example, if the target is 80 coins, you must reach that amount within three spins and deposit it into the ATM.\n\nTime is always against you.\n\nAbove you, a heavy hammer is tied to a rotating gear.\nEvery round, the gear moves closer to zero.\n\nIf the gear reaches zero and you fail to deposit the required money, the hammer strikes a bell.\nThe bell wakes the clown.\n\nYou hear laughter.\nThe clown approaches.\nThe game ends.\n\nThis is not just luck.\nIt is pressure, fear, and decision-making under stress.\n\nCan you control your nerves, manage your money, and survive the clown\u2019s game? \ud83c\udfaa\ud83d\udd14", "short_description": "Trapped inside a deadly circus, you must gamble with a slot machine, manage your money, and survive round by round.\nMiss your target, and the clown wakes up."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "Jb Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vrprivacy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "
x93bVuBSl7zThHezFkMU4ZQvew&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRNkwLVGrtdGbwX-8X0dW79ydDrhf67CVpj4q2VFD9ySw&oe=6B0C5E2F"}, {"file_name": "Image Sequence_002_0001.png", "id": "1635306147908632", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820441_1635306151241965_3015294756911394918_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DZnwVlo5cv8Q7kNvwGKmb6F&_nc_oc=AdrBlWYnfrBUPSftzRYnoIxk_alBZgLTmv8Er75B_JS3qD5tYlhc09j-6iCFdABgNlc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSL8XfddYVRYNQ3qrQOnOrApyXve4rPhBoEYq_GV4Q1QA&oe=6B0C6E36"}, {"file_name": "Image Sequence_003_0001.png", "id": "888164260497461", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823812_888164263830794_2699388260831139756_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FireAsI_XZgQ7kNvwEXWZas&_nc_oc=AdrwnFqYIjI0lh5QCwpKR_Msz3ufHRbyKJEWZ4TQRn36kee0DJ5uUDfbe_EAml0Q9jE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRvtnNxYDxbei4UJpeacVbHsVbXQPAH7RWNhypfHjNnYg&oe=6B0C65BF"}, {"file_name": "Image Sequence_005_0001.png", "id": "1432948451630948", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823296_1432948454964281_8310435058803268137_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z_PHkGZ8MXYQ7kNvwGKHZX_&_nc_oc=AdpP5js-3Q-E4_7h5ZZI5DPoVobl1eTNyuMBnw5U16Y5toHgVUYRGt1MVufmvVorb6k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQBA25WGta8tRQOGyMZ1ZIoLZ-31bv-6a_crBGoBG2etw&oe=6B0C4F61"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_020_0001.png", "id": "1253241443610202", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491829165_1253241450276868_2593898828327800074_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GwT059K2DUQQ7kNvwGHghSv&_nc_oc=AdqDr54lWsPlw7gVGVdnMAzFR8GliRlBYqTUdl2hDebeB3-90eraLvxINBET-v3nksA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT0GwZ8QRStem9Jz8-A-XG5l9dHHi0MSBLGZF4dfEvD8w&oe=6B0C5F26"}, "display_name": "Clown's Game", "keywords": ["gambling", "horror", "slot", "Clown"], "long_description": "Clown\u2019s Game is a gambling-horror game.\nYou don\u2019t use real money, but the fear is real.\nYou are trapped inside a twisted circus arena.\nFences surround you. There is no escape.\n\nIn front of you are two machines:\n\nA slot machine where luck decides your fate\n\nAn ATM where you must deposit money to stay alive\n\nEach round has a clear target.\nYou spin the slot machine to earn coins and try to reach the required amount.\n\nEvery target gives you three rounds.\nFor example, if the target is 80 coins, you must reach that amount within three spins and deposit it into the ATM.\n\nTime is always against you.\n\nAbove you, a heavy hammer is tied to a rotating gear.\nEvery round, the gear moves closer to zero.\n\nIf the gear reaches zero and you fail to deposit the required money, the hammer strikes a bell.\nThe bell wakes the clown.\n\nYou hear laughter.\nThe clown approaches.\nThe game ends.\n\nThis is not just luck.\nIt is pressure, fear, and decision-making under stress.\n\nCan you control your nerves, manage your money, and survive the clown\u2019s game? \ud83c\udfaa\ud83d\udd14", "short_description": "Trapped inside a deadly circus, you must gamble with a slot machine, manage your money, and survive round by round.\nMiss your target, and the clown wakes up."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "Jb Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vrprivacy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "
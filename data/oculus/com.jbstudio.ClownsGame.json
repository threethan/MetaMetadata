8260831139756_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yFT7LsBHfCoQ7kNvwGWchZh&_nc_oc=AdpA6q3fdECo71ndjA3H_GaMMjZGwKSvQuXYj8oBE3DzVt9oxWr0mUZIHh3E6xZfABw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQClUMsXg07Nlxg94A9fis3JY0X3hx5ooO9xw03dkg0aVg&oe=6A4D03FF"}, {"file_name": "Image Sequence_005_0001.png", "id": "1432948451630948", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823296_1432948454964281_8310435058803268137_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3j8uIUhH6W0Q7kNvwF350WF&_nc_oc=AdrBvDTlVOUQktuNJxCbzqzCmkwaIY6eHkg34CZ5pnpoMAsk-ZPebwYY2zKSq2N0hfo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCppwL6wJSK5jFIje92taQYG2DoCgJXBQcSG2Nx1mv9Zw&oe=6A4CEDA1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_020_0001.png", "id": "1253241443610202", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491829165_1253241450276868_2593898828327800074_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ctqsop0satsQ7kNvwHq0li5&_nc_oc=Adq6uVxGw9O7_lL374N22YFHLWhjS_lMLDKbZWiUabVfvkcLCCidBhHnwiTTQxrdzlo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQChfpiCSDOKSl9MRlGpdQK0u6xuKN1ju8kR3KwdakRcew&oe=6A4CFD66"}, "display_name": "Clown's Game", "keywords": ["gambling", "horror", "slot", "Clown"], "long_description": "Clown\u2019s Game is a gambling-horror game.\nYou don\u2019t use real money, but the fear is real.\nYou are trapped inside a twisted circus arena.\nFences surround you. There is no escape.\n\nIn front of you are two machines:\n\nA slot machine where luck decides your fate\n\nAn ATM where you must deposit money to stay alive\n\nEach round has a clear target.\nYou spin the slot machine to earn coins and try to reach the required amount.\n\nEvery target gives you three rounds.\nFor example, if the target is 80 coins, you must reach that amount within three spins and deposit it into the ATM.\n\nTime is always against you.\n\nAbove you, a heavy hammer is tied to a rotating gear.\nEvery round, the gear moves closer to zero.\n\nIf the gear reaches zero and you fail to deposit the required money, the hammer strikes a bell.\nThe bell wakes the clown.\n\nYou hear laughter.\nThe clown approaches.\nThe game ends.\n\nThis is not just luck.\nIt is pressure, fear, and decision-making under stress.\n\nCan you control your nerves, manage your money, and survive the clown\u2019s game? \ud83c\udfaa\ud83d\udd14", "short_description": "Trapped inside a deadly circus, you must gamble with a slot machine, manage your money, and survive round by round.\nMiss your target, and the clown wakes up."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "Jb Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vrprivacy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25590894487249110"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1584177089344542"}, {"status": "PUBLISHED", "id": "2998272813715992"}, {"status": "PUBLISHED", "id": "1425937862656714"}]}, "baseline_offer": {"id": "1425937862656714"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1782493200, "status": "PUBLISHED", "id": "158417708
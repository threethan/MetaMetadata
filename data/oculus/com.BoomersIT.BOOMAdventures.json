n challenge your friends to check who is best thrower\n\nYou have two worlds to choose from: Winter and Summer.\n\nMain pros:\n- Cute ducks\n- Simple mechanics \n- Low entry threshold\n- Scoreboard for every game mode\n- 3 difficulty levels", "short_description": "Grab a duck and hit a crab or grab a snowball and hit a snowman.\nThis is the primary goal of the game.\n\nThere are two game modes. Campaign and survival. \nIn both you can challenge your friends to check who is best thrower.\n\nYou have two worlds to choose from: Winter and Summer.\n\nFeel the holiday!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://boomersitgame.com/boomadventuresprivacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Boomers IT", "support_website_url": null, "website_url": "https://boomersitgame.com/boomadventures.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7135866869805140"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38982553_1141960000031028_3797006546411227419_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Abwhfc_xAkQ7kNvwFOQnBu&_nc_oc=Adq-AFh-BgGK7TCrVKvzm8nHOr8PsRflbJF9M92-7SBtMB6TdS7J6RPlDYUqCsUiRLY&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af432R-MF3tVGWxwJGYDHNj8mfOycUUoy9iZOwYzvkvU_w&oe=6A09BA99"}, "is_c
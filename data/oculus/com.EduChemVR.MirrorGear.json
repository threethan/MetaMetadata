5/11162711_1985834191706068_7233967481977569280_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3SIJaWNFVywQ7kNvwEk8BST&_nc_oc=AdrfLZQNu6zq5FFyFULjNHylXWZ5sMAaI3YmDjB2dx_f9zvgdeTnRA8mFRZVfUCJQ1w&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2JVrVk6BC_LlRb0beLZDr8r5MUPGFm1t8HSKbOfd7Qw&oe=6A8EEA6C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chemistry VR", "keywords": ["Chemistry", "Education", "Learn", "Molecules", "Edtech"], "long_description": "Learn and experience chemistry on an atomic level. There are two modules: Stereochemistry and Molecular Geometries. \nTo enter one of the modules press and hold the Gear VR touchpad. Audio instructions are given, so head-phones are recommended for an optimal experience. In the scene, press and hold the touchpad to travel in the direction you are facing. Release the touchpad to stop/freeze the view. Double-click on the touchpad to select molecular objects and learn more about them. \nEnjoy!", "short_description": "Learn and experience chemistry on an atomic level. There are two modules: Stereochemistry and Molecular Geometries. \nTo enter one of the modules press and hold the Gear VR touchpad. Audio instructions are given, so head-phones are recommended for an optimal experience. In the scene, press and hold the touchpad to travel in the direction you are facing. Release the touchpad to stop/freeze the view. Double-click on the touchpad to select molecular objects and learn more about them. \nEnjoy!"}]}, "developer_name": "Magnus Norrby", "developer_privacy_policy_url": "http://educhem-vr.com/", "developer_terms_of_service_url": "http://educhem-vr.com/", "publisher_name": "EduChem VR Sweden AB", "support_website_url": null, "website_url": "http://educhem-vr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION"], "has_in_app_ad
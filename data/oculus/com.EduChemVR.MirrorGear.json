hoQ7kNvwE1oYqt&_nc_oc=Ado1PaqjM1B9XWVF5Pp82UmippRXud1wGq7yb1wl7jPvie2wXuwPydV9DqOhtuIRgw8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMeGvL8QQHIVwjlilGIIqFk5g_Lc-cnmIzmF-rfeTgUeQ&oe=6ACE5DF3"}, {"file_name": "migrated_image.png", "id": "580503105888980", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162766_304623786708960_5960570555580022784_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EYNMj9bIBiYQ7kNvwGwJtbp&_nc_oc=Adr8s7yPJ61XUPJ-m7AOt0MA7ihBxpD5iMkPDY1oyrOB2dp0FwODHFUJgGnrE1TE3gY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMxC51Y64KCo37IPp2KGeFGs0dZSnsV1TsOCahlC1HXeQ&oe=6ACE4A62"}, {"file_name": "migrated_image.png", "id": "206858657081615", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162694_152533685493893_8730114443276451840_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VZEi3QKBIZYQ7kNvwFV4cTL&_nc_oc=Adp8DIPiUzcVajo5umNjYxOwi4Cy0BRA-gkOThLqev-D60fp8EFKxQYjjx2QssJBU00&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7vmn6u6qluLo5XyP9wVnhCfZWzggnEajgZGstTOt85w&oe=6ACE64ED"}, {"file_name": "migrated_image.png", "id": "648061739345122", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162711_1985834191706068_7233967481977569280_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=83plKJECx1YQ7kNvwH7inV4&_nc_oc=Adpehop3lTHITG4zV6AZ0eNREfi9J3JQ-A7uuT3wfjuoxDOLnoZG-WwBeu-HjpjO-bI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxgYsrnJgj6D5tOHAIcGx-aKXPNzpvMG-dpsHc3JdzBw&oe=6ACE326C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chemistry VR", "keywords": ["Chemistry", "Education", "Learn", "Molecules", "Edtech"], "long_description": "Learn and experience chemistry on an atomic level. There are two modules: Stereochemistry and Molecular Geometries. \nTo enter one of the modules press and hold the Gear VR touchpad. Audio instructions are given, so head-phones are recommended for an optimal experience. In the scene, press and hold the touchpad to travel in the direction you are facing. Release the touchpad to stop/freeze the view. Double-click on the touchpad to select molecular objects and learn more about them. \nEnjoy!", "short_description": "Learn and experience chemistry on an atomic level. There are two modules: Stereochemistry and Molecular Geometries. \nTo enter one of the modules press and hold the Gear VR touchpad. Audio instructions are given, so head-phones are recommended for an optimal experience. In the scene, press and hold the touchpad to travel in the direction you are facing. Release the touchpad to stop/freeze the view. Double-click on the touchpad to select molecular objects and learn more about them. \nEnjoy!"}]}, "developer_name": "Magnus Norrby", "developer_privacy_policy_url": "http://educhem-vr.com/", "developer_terms_of_service_url": "http://educhem-vr.com/", "publisher_name": "EduChem VR Sweden AB", "support_website_url": null, "website_url": "http://educhem-vr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "620453415700521"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162716_1740457356263833_5307649687371644928_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pcK-yYxZVhQQ7kNvwFf0cFP&_nc_oc=AdqafT5TPARm3DJty8J3x0aSObxZXHkVL2nX6wgglhLnwtH66VVC3NjXkh8B2s8c260&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPWrxPqMj4nd4PeoUEcXhHU
t=scontent-ord5-3.oculuscdn.com&oh=00_Afu19I5UU5ELiFUhNUzN7Igct2KWHgD0ZlG3FW4BGZrhRg&oe=699C49B3"}, {"file_name": "migrated_image.png", "id": "580503105888980", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162766_304623786708960_5960570555580022784_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bR0P7WpuUK8Q7kNvwE5HJ11&_nc_oc=Adma-bDBc8PFL3CcPXuz7PNUxAh06-WrSaGIeqEgG68PKBBLvDmVsOzLsMqtfSCxh_4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvAC6e7u64mRsz6DgZrvnfKgdcng7AOh3ce_OoaQeOycA&oe=699C3622"}, {"file_name": "migrated_image.png", "id": "206858657081615", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162694_152533685493893_8730114443276451840_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZqwD93Qeyn4Q7kNvwGGO9b3&_nc_oc=Adn5kRmCrnUKGTtuRzq5VRFiUyNmgVQf-Rm0zCwsKy0EHwtW-HtMcMYrNhDtkPA7qvw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuSx6SyFDD8RrtEUlj27rQRjIQJiniJLZSSk2O3p0umng&oe=699C50AD"}, {"file_name": "migrated_image.png", "id": "648061739345122", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162711_1985834191706068_7233967481977569280_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A2qpBdxTqucQ7kNvwFD0zwy&_nc_oc=AdkmPthogwLNE3ixkq0bAs3MhjaeRAfzNo2cQp4YO4S5kcreQRC8hU5RuY6aEkpA5OI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsE09DysDFBFaLb6v2gGGgDOc52MasSpQHy-C1wR6aqPg&oe=699C566C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chemistry VR", "keywords": ["Chemistry", "Education", "Learn", "Molecules", "Edtech"], "long_description": "Learn and experience chemistry on an atomic level. There are two modules: Stereochemistry and Molecular Geometries. \nTo enter one of the modules press and hold the Gear VR touchpad. Audio instructions are given, so head-phones are recommended for an optimal experience. In the scene, press and hold the touchpad to travel in the direction you are facing. Release the touchpad to stop/freeze the view. Double-click on the touchpad to select molecular objects and learn more about them. \nEnjoy!", "short_description": "Learn and experience chemistry on an atomic level. There are two modules: Stereochemistry and Molecular Geometries. \nTo enter one of the modules press and hold the Gear VR touchpad. Audio instructions are given, so head-phones are recommended for an optimal experience. In the scene, press and hold the touchpad to travel in the direction you are facing. Release the touchpad to stop/freeze the view. Double-click on the touchpad to select molecular objects and learn more about them. \nEnjoy!"}]}, "developer_name": "Magnus Norrby", "developer_privacy_policy_url": "http://educhem-vr.com/", "developer_terms_of_service_url": "http://educhem-vr.com/", "publisher_name": "EduChem VR Sweden AB", "support_website_url": null, "website_url": "http://educhem-vr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "620453415700521"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162716_1740457356263833_5307649687371644928_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oCEXcLFbpFMQ7kNvwFZLvAo&_nc_oc=AdnmNICGWHH_uFTMNx-ez69Q7pMnpevjwY6zcGGEl2vv6EZEUvBP1TZGVU_WZ-BMZzk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftrI7hI3w35hjTtPddDGgB7e8tncOiaHKWH3KwD0bfWww&oe=699C4143"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Chemistry VR", "platform": "ANDROID", "conte
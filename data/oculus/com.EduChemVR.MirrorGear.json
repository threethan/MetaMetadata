W0Q7kNvwH9eXEr&_nc_oc=AdrmvF5aUkCmQklyswqGxYMPpawdGUP45gEWuLC3Y8P_2pLXu3ZVjomTfkVQ7bGL1HY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0pN5mFJSBCajK7bwLJ16_rtWEeuJqeyw_luauQaJoyog&oe=69DCE333"}, {"file_name": "migrated_image.png", "id": "580503105888980", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162766_304623786708960_5960570555580022784_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wySnEBIhPLYQ7kNvwEBBVf6&_nc_oc=Ado2gFZG_D4P5FGqyehsz-ptzstg26AD5mMMlOr-JxdY4p7ZswWMaoKLgWQEr56Yits&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0PKcFnyU7H_L_fSrntcK5Lcq2xM1BKib954iEi7mPwlA&oe=69DCCFA2"}, {"file_name": "migrated_image.png", "id": "206858657081615", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162694_152533685493893_8730114443276451840_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p0Y0pJjsB1UQ7kNvwHUOVcj&_nc_oc=Adpzh80bvNAZIfAFIHFGLwrs85NAlyE_zUQZY269jOwEHC5YgI06orsR-VUYZnIb1Jo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af27kAirJ01j4EWIdo8UsPPe2kryzbPQMwsfQtysL1egOA&oe=69DCEA2D"}, {"file_name": "migrated_image.png", "id": "648061739345122", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162711_1985834191706068_7233967481977569280_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WWsUe81TdegQ7kNvwHUpETY&_nc_oc=AdotGRS0E7m9-z5nYB72HtppRHDuBws9_pQbvL1RoNTMMld37h_zE5KdC1xmc6n7PRY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3S5QldYhoBriVxvoYxWO9U2KUDZ7Not55zvUZnW29kHQ&oe=69DCEFEC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chemistry VR", "keywords": ["Chemistry", "Education", "Learn", "Molecules", "Edtech"], "long_description": "Learn and experience chemistry on an atomic level. There are two modules: Stereochemistry and Molecular Geometries. \nTo enter one of the modules press and hold the Gear VR touchpad. Audio instructions are given, so head-phones are recommended for an optimal experience. In the scene, press and hold the touchpad to travel in the direction you are facing. Release the touchpad to stop/freeze the view. Double-click on the touchpad to select molecular objects and learn more about them. \nEnjoy!", "short_description": "Learn and experience chemistry on an atomic level. There are two modules: Stereochemistry and Molecular Geometries. \nTo enter one of the modules press and hold the Gear VR touchpad. Audio instructions are given, so head-phones are recommended for an optimal experience. In the scene, press and hold the touchpad to travel in the direction you are facing. Release the touchpad to stop/freeze the view. Double-click on the touchpad to select molecular objects and learn more about them. \nEnjoy!"}]}, "developer_name": "Magnus Norrby", "developer_privacy_policy_url": "http://educhem-vr.com/", "developer_terms_of_service_url": "http://educhem-vr.com/", "publisher_name": "EduChem VR Sweden AB", "support_website_url": null, "website_url": "http://educhem-vr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "620453415700521"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162716_1740457356263833_5307649687371644928_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=605Lfzg8QUwQ7kNvwFzaYPy&_nc_oc=AdqHGQSX9QiWjyiQUGVRD1SYHqiJLSMPg8YcTvlz8VTJwBJcBYNDcH1JH6a-cWPS5K8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af02webltH8cCPI7-7lwUU3S
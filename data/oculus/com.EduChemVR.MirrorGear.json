W0Q7kNvwFclDhU&_nc_oc=AdrwIKmBRiaIhzWT5pRVaT9tyunhUL7rJ0zuk5Zq726fc0O3QfSRY44D4c5KD6Li_kU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0WMGiocX3q9fcf_5fN6KsEAZDWSEE-fYhCFB61C6PHxA&oe=69DA4033"}, {"file_name": "migrated_image.png", "id": "580503105888980", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162766_304623786708960_5960570555580022784_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=94d86y22dfYQ7kNvwHTEUo4&_nc_oc=AdpvRKonWPmssLe3lrqgiGOtmbgn_sqb_wV-LXogJuJKW27GHINQxndbWvUsVhd4Mt4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2GWc5JSnIfx3nBPr5uKT6kxLvxXvrJXArK5ihNoOLevQ&oe=69DA2CA2"}, {"file_name": "migrated_image.png", "id": "206858657081615", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162694_152533685493893_8730114443276451840_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JvHg22oUiDcQ7kNvwEL7zr0&_nc_oc=AdrO5E6LwC0QOs_oCI-RXfo37FNJCJCE8HiP92yQuBVx9GDBUvfZZEFi9HLxJp9k1PY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3fcDtNcAUPv4rKs-ni3nTbBu-kXSMrDO31LheuLp0seg&oe=69DA472D"}, {"file_name": "migrated_image.png", "id": "648061739345122", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162711_1985834191706068_7233967481977569280_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WWsUe81TdegQ7kNvwGcBkF1&_nc_oc=AdoA8_L73Jd1mnpo-lwcf5W3BfV8zXdDMBSNYTTlHuJ_79sxNFj1_VZNjr6PMqmZQJM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Yh5vtqeyWXhlF0EQfb3gNv67onf6hBTgm-K-xh4TMBA&oe=69DA4CEC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chemistry VR", "keywords": ["Chemistry", "Education", "Learn", "Molecules", "Edtech"], "long_description": "Learn and experience chemistry on an atomic level. There are two modules: Stereochemistry and Molecular Geometries. \nTo enter one of the modules press and hold the Gear VR touchpad. Audio instructions are given, so head-phones are recommended for an optimal experience. In the scene, press and hold the touchpad to travel in the direction you are facing. Release the touchpad to stop/freeze the view. Double-click on the touchpad to select molecular objects and learn more about them. \nEnjoy!", "short_description": "Learn and experience chemistry on an atomic level. There are two modules: Stereochemistry and Molecular Geometries. \nTo enter one of the modules press and hold the Gear VR touchpad. Audio instructions are given, so head-phones are recommended for an optimal experience. In the scene, press and hold the touchpad to travel in the direction you are facing. Release the touchpad to stop/freeze the view. Double-click on the touchpad to select molecular objects and learn more about them. \nEnjoy!"}]}, "developer_name": "Magnus Norrby", "developer_privacy_policy_url": "http://educhem-vr.com/", "developer_terms_of_service_url": "http://educhem-vr.com/", "publisher_name": "EduChem VR Sweden AB", "support_website_url": null, "website_url": "http://educhem-vr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "620453415700521"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162716_1740457356263833_5307649687371644928_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mMcCUTWquFAQ7kNvwEmvDVV&_nc_oc=AdpyYeKEjcfzwkIvVcv9ttlZuqUVdzMxeni4Ip3GPk4PQVoBVYCoTEg8YNf_TErzoGY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3X3znbrTida6eECH6ZTN4R
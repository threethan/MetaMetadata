t=scontent-iad3-1.oculuscdn.com&oh=00_Afv1RYPhnXT1lyxxF09wUBmUqi2EMIOrOkncDTP1jnsoLg&oe=69A03E33"}, {"file_name": "migrated_image.png", "id": "580503105888980", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162766_304623786708960_5960570555580022784_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mGNqW6y9034Q7kNvwHgEzJW&_nc_oc=AdlTGMzRVqlr1cazIqR8-Qd_55n-x54pAsnuM7AOtEYH3RHD4RBxfQKPJ8n6m9A7IvE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afuk06JxhMXrIe_x8GIKVKSltSZe_xPAIq3r8ej80gfsEg&oe=69A02AA2"}, {"file_name": "migrated_image.png", "id": "206858657081615", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162694_152533685493893_8730114443276451840_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SFh297PnBVIQ7kNvwFeBKF1&_nc_oc=AdkzpYkJqgRxUq_Yo7Sn1To8430RYLpIRIO63PX9Gl4ToL24e7vPIfoMBvm41sKRUHU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv2yWODZYiceJoNeCRN3fthqJi9zCXrKyFBqx7Xzg4Vaw&oe=69A0452D"}, {"file_name": "migrated_image.png", "id": "648061739345122", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162711_1985834191706068_7233967481977569280_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qH4fLss0D4MQ7kNvwFZwkQ6&_nc_oc=AdnqIhK_Fu7yyDtTIlDLoPEE0ljm9WMaeaH6bzKe9Bumh1BJm3WzHgce2JR3QBQnW8o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvzOV0a2omyghBk-Bx9RxOOhKFruQ2B7kGAFEaYB601KA&oe=69A04AEC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chemistry VR", "keywords": ["Chemistry", "Education", "Learn", "Molecules", "Edtech"], "long_description": "Learn and experience chemistry on an atomic level. There are two modules: Stereochemistry and Molecular Geometries. \nTo enter one of the modules press and hold the Gear VR touchpad. Audio instructions are given, so head-phones are recommended for an optimal experience. In the scene, press and hold the touchpad to travel in the direction you are facing. Release the touchpad to stop/freeze the view. Double-click on the touchpad to select molecular objects and learn more about them. \nEnjoy!", "short_description": "Learn and experience chemistry on an atomic level. There are two modules: Stereochemistry and Molecular Geometries. \nTo enter one of the modules press and hold the Gear VR touchpad. Audio instructions are given, so head-phones are recommended for an optimal experience. In the scene, press and hold the touchpad to travel in the direction you are facing. Release the touchpad to stop/freeze the view. Double-click on the touchpad to select molecular objects and learn more about them. \nEnjoy!"}]}, "developer_name": "Magnus Norrby", "developer_privacy_policy_url": "http://educhem-vr.com/", "developer_terms_of_service_url": "http://educhem-vr.com/", "publisher_name": "EduChem VR Sweden AB", "support_website_url": null, "website_url": "http://educhem-vr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "620453415700521"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162716_1740457356263833_5307649687371644928_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MRBnCaHCEfoQ7kNvwGI8D3z&_nc_oc=AdnnbILiBdp5B-INS2ySesJZqjBdiAww4XyM4Eempfb6_-wAvHSAtZCeiEjkQ0lBxSk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsYB2299gZdR4EvTCSoPIOnMSfsCsMOYF0ggVbPzdqbrA&oe=69A035C3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Chemistry VR", "platform": "ANDROID", "conte
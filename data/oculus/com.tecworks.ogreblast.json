UQ7kNvwG1bukb&_nc_oc=AdqIl1qFL5KsIRepbzw4TvXR29h4TKy5GfaZ3P9B0ihC7xKM8ujMmAxi3EsA9UjmCyk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELF31dMnuvb2oEqbw78jpalYMlPsBbe5kDiiAjqubKQQ&oe=6A771645"}, {"file_name": "gg2new.png", "id": "797467676540656", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499302483_797467679873989_8701686546132773430_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n3xIwb2fej0Q7kNvwHB8yq8&_nc_oc=AdoDKNKRyXDVP9fxwA-tEwyAeQGNWxI-ptW6r5jbobL_rQBccwJbL1GL6BJFlYl4T2U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEy1KsxVYAbmv48LAsiwhawwXpzO9aOWYOIpsFN_vwdOA&oe=6A77316C"}, {"file_name": "gg3new.png", "id": "1866582263957568", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499296119_1866582267290901_1269278170433226009_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VRnRl22IW_oQ7kNvwEJr9QO&_nc_oc=AdoZH7OsbbzcwUaLN1SkXfFvGq6kw7q_BKmxONqmgWWSZ1txZaoWm0zZhlQjlLNoQW8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4dsFrJRjO7Ry6KrbtjNAWim0dxuK8y2AajZnp_O1B8Q&oe=6A771706"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "main2.png", "id": "2008132266783362", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827960_2008132270116695_3068053838870321891_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n-cP7NVZL1MQ7kNvwGFNFKb&_nc_oc=Adqk9_AKj_0HZZhKVNwVBHtgYAJdjmzGIO4Rrn_raB4VI6RutFcFb18201qa7ZMj0Wk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESOqfn-0s55XdQlWigcaMyIuQrUVeGYHi5WBpyqTAkBQ&oe=6A772C8E"}, "display_name": "Crush the Ogres", "keywords": ["ogre", "ogres", "fantasy", "medieval", "arcade"], "long_description": "In a forgotten medieval land filled with mystery, something strange is happening beneath the ground. From the depths of the earth, swarms of tiny ogres have begun to emerge, digging their way to the surface with a single goal: to collapse the floor beneath your feet and drag you back into the dark caverns they came from.\n\nArmed only with your trusty club, you must rely on speed, precision, and quick reflexes to stop them. Strike the miniature ogres as they pop up from holes in the ground before they multiply and overwhelm you. If too many escape your blows, the ground will crumble and you will be swallowed by the depths.\n\nInspired by classic arcade games where players had to smash characters popping out of holes, this game delivers simple mechanics, fast action, and addictive gameplay. Easy to learn but challenging to master, it\u2019s a thrilling reflex challenge that keeps you on edge.\n\nPerfect for quick sessions, Crush the Ogres is a fun, adrenaline-filled time-killer that brings the spirit of classic arcade machines into a mysterious medieval world. Grab your club, stay alert, and crush the ogres before they crush you.", "short_description": "In an ancient and mysterious medieval land, tiny ogres have emerged from the depths of the earth to sabotage the ground beneath your feet. Grab your club and crush them before they take over and drag you into the darkness below. A fast-paced, arcade-inspired game where quick reflexes are the only way to survive."}]}, "developer_name": null, "developer_privacy_policy_url": "http://jined.great-site.net/privacypolicy.htm", "developer_terms_of_service_url": null, "publisher_name": "Tecworks", "support_website_url": null, "website_url": "https://jined.great-site.net/index.htm", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"],
n_raB4VI6RutFcFb18201qa7ZMj0Wk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESOqfn-0s55XdQlWigcaMyIuQrUVeGYHi5WBpyqTAkBQ&oe=6A772C8E"}, "display_name": "Crush the Ogres", "keywords": ["ogre", "ogres", "fantasy", "medieval", "arcade"], "long_description": "In a forgotten medieval land filled with mystery, something strange is happening beneath the ground. From the depths of the earth, swarms of tiny ogres have begun to emerge, digging their way to the surface with a single goal: to collapse the floor beneath your feet and drag you back into the dark caverns they came from.\n\nArmed only with your trusty club, you must rely on speed, precision, and quick reflexes to stop them. Strike the miniature ogres as they pop up from holes in the ground before they multiply and overwhelm you. If too many escape your blows, the ground will crumble and you will be swallowed by the depths.\n\nInspired by classic arcade games where players had to smash characters popping out of holes, this game delivers simple mechanics, fast action, and addictive gameplay. Easy to learn but challenging to master, it\u2019s a thrilling reflex challenge that keeps you on edge.\n\nPerfect for quick sessions, Crush the Ogres is a fun, adrenaline-filled time-killer that brings the spirit of classic arcade machines into a mysterious medieval world. Grab your club, stay alert, and crush the ogres before they crush you.", "short_description": "In an ancient and mysterious medieval land, tiny ogres have emerged from the depths of the earth to sabotage the ground beneath your feet. Grab your club and crush them before they take over and drag you into the darkness below. A fast-paced, arcade-inspired game where quick reflexes are the only way to survive."}]}, "developer_name": null, "developer_privacy_policy_url": "http://jined.great-site.net/privacypolicy.htm", "developer_terms_of_service_url": null, "publisher_name": "Tecworks", "support_website_url": null, "website_url": "https://jined.great-site.net/index.htm", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26588529907475720"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820923_1970629180482517_1389230531356973027_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OzBU-610b50Q7kNvwGfvyRY&_nc_oc=Ado-FA3AW_TO42Oy9YrVZAfC9sdqcsI2GTEapJiQXgfVY-mEqOwEBlaCMxKjr6ptbhM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGncZVGy4C1R7t3Fi4l3-qB88AOzhRi-7cxjyYtAAdoVw&oe=6A7722F0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Crush the Ogres", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1778277600, "lastRevision": {"nodes": [{"id": "8012218865533439", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "8012218852200107", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "4417583558561775"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "main2.png
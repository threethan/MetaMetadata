h3IIYwcCfzlTPyvpu0fSMPR66cE3V0mw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af57IZO8h63YWujsp1Qf7C977VHlmcb7LFC3hzx5soX6SA&oe=6A049304"}, {"file_name": "migrated_image.png", "id": "207786587099382", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139502_694538347403639_579334948712873984_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sdBZZj28MMMQ7kNvwFdgiar&_nc_oc=AdrsSrvgh0AXd0a8yyWAsWmpqTPaHAs5_bYNx4gRtRjULHOESmwMnMQr_sk-VzwpCx8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6l6nisZEyS_tE2ebsjkF-sUh48A36ch7pRWJJx881DBQ&oe=6A048F0E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MYTF1 VR : R\u00e9alit\u00e9 virtuelle et vid\u00e9os 360", "keywords": ["tf1", "video", "voice", "s\u00e9rie", "replay"], "long_description": "C\u2019est le moment de vous pr\u00e9parer \u00e0 une immersion totale au c\u0153ur de contenus exclusifs s\u00e9lectionn\u00e9s par TF1, LCI, MYTF1 et MYTF1XTRA sur MYTF1 VR ! The Voice VR : prenez la place des coachs et buzzez quand vous le souhaitez\u2026 Fan de The Voice ? A l\u2019occasion de la nouvelle saison du plus c\u00e9l\u00e8bre concours TV de chant, vous pourrez acc\u00e9der \u00e0 toutes les auditions \u00e0 l\u2019aveugle en r\u00e9alit\u00e9 virtuelle ! Vivez des sensations fortes en r\u00e9alit\u00e9 virtuelle \u00e0 travers des exp\u00e9riences in\u00e9dites sur mytf1vr. Retrouvez un catalogue r\u00e9guli\u00e8rement enrichi de vid\u00e9os en r\u00e9alit\u00e9 virtuelle sur MYTF1 VR : sport, info, documentaires, divertissements, reportages et contenus in\u00e9dits ! Explorez des lieux interdits et vivez des experiences incroyables : visitez les pyramides de Kh\u00e9ops, montez \u00e0 bord d\u2019une Formule 1, d\u00e9couvrez l\u2019int\u00e9rieur de la grotte de Lascaux\u2026 Et t\u00e9l\u00e9chargez les vid\u00e9os 360 pour une meilleure qualit\u00e9 de visionnage.", "short_description": "C\u2019est le moment de vous pr\u00e9parer \u00e0 une im
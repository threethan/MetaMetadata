80_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y91SBwh5BncQ7kNvwGABlFJ&_nc_oc=AdmHk48bSHJtjue4bGal4Lnet9wCJgwZYr469YFvM8wcjMbxcPIx-go6EtEDwbOPK6E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv3ZPOuDnFeRnRWy3YMq1H-DMk8e8Tzvdoa1CiGT6j2Zg&oe=69A2CB29"}, {"file_name": "migrated_image.png", "id": "200904117837737", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12331199_403996186617400_1247254869216067584_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=brA0Lwar3OMQ7kNvwGiKEzN&_nc_oc=AdlOz7CAZXxn72IVbQtvOJa0uI1_8X523_hBYta4GH7ZBAv7q5DLb31smkihc5mAzhQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuS1rnPRHfXotaq59H30FCg_gjSR8V-0UL-RqHzZN05Dw&oe=69A2F821"}, {"file_name": "migrated_image.png", "id": "2645245402426315", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602136_1306802762745008_16700533653897216_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RR1WDnq7kLMQ7kNvwHSkZ3W&_nc_oc=AdmAu1WxSUwqw_62DLhA--HAZoko3hi-3v_u9bmt72xzvXDSp4wtmMj8KpkuRATtFaM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftrZNOpgczVrW_SV3Aq8mGm8L-1yZiNixtQdvDOXuBWog&oe=69A2EDE9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MYTF1 VR : R\u00e9alit\u00e9 virtuelle et vid\u00e9os 360", "keywords": ["tf1", "video", "voice", "s\u00e9rie", "replay"], "long_description": "C\u2019est le moment de vous pr\u00e9parer \u00e0 une immersion totale au c\u0153ur de contenus exclusifs s\u00e9lectionn\u00e9s par TF1, LCI, MYTF1 et MYTF1XTRA sur MYTF1 VR ! The Voice VR : prenez la place des coachs et buzzez quand vous le souhaitez\u2026 Fan de The Voice ? A l\u2019occasion de la nouvelle saison du plus c\u00e9l\u00e8bre concours TV de chant, vous pourrez acc\u00e9der \u00e0 toutes les auditions \u00e0 l\u2019aveugle en r\u00e9alit\u00e9 virtuelle ! Vivez des sensations fortes en r\u00e9alit\u00e9 virtuelle \u00e0 travers des exp\u00e9riences in\u00e9dites sur mytf1vr. Retrouvez un catalogue r\u00e9guli\u00e8rement enrichi de vid\u00e9os en r\u00e9alit\u00e9 virtuelle sur MYTF1 VR : sport, info, documentaires, divertissements, reportages et contenus in\u00e9dits ! Explorez des lieux interdits et vivez des experiences incroyables : visitez les pyramides de Kh\u00e9ops, montez \u00e0 bord d\u2019une Formule 1, d\u00e9couvrez l\u2019int\u00e9rieur de la grotte de Lascaux\u2026 Et t\u00e9l\u00e9chargez les vid\u00e9os 360 pour une meilleure qualit\u00e9 de visionnage.", "short_description": "C\u2019est le moment de vous pr\u00e9parer \u00e0 une immersion totale au c\u0153ur de contenus exclusifs s\u00e9lectionn\u00e9s par TF1, LCI, MYTF1 et MYTF1XTRA sur MYTF1 VR ! Fan de The Voice ? Avec l'exp\u00e9rience The Voice VR disponible dans l'application MYTF1VR : prenez la place des coachs et buzzez quand vous le souhaitez !"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.tf1.fr/politique-de-confidentialite/", "developer_terms_of_service_url": "https://s.tf1.fr/mmdia/a/59/1/11593591hnlxj.pdf", "publisher_name": "TF1", "support_website_url": null, "website_url": "http://www.tf1.fr/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "MUSIC_VIDEO", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["fr"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "481649109979279"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162814_102585153625543_6861941589506260992_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zDglmZqeNswQ7kNvwHomVs6&_nc_oc=Adm0oln8n0KyccVvIr2Py8fPwIfoZaufHhIvWSJqNb2Ug
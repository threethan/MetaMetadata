2238759160631_1199317831658824570_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZXxJteof-CgQ7kNvwHa8kke&_nc_oc=AdqnEoG5r7rykeAI9Lp0nRJDwa_hOLUPh1JHsyOfECErgV2M8S2IRoni2iS2BKoQ5gc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOo8ScGEZUMspCnRFUmcS29oBXUCVyL0DuOSVu39LD-JQ&oe=6ACD0D1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Image.png", "id": "1309452010513767", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618937_1309452013847100_2123343845743984460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FzkzODluWDMQ7kNvwHtcMRJ&_nc_oc=Adpg88gmDEW2Ie1pcL9IOXq1dels_Dku8UdWYht4BpP1D5V1ElfjyFmIxCv7dR3aBjE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOeVPUNEoViwOjWT2AxkkLEEa2oN1-0IiljlcLjzcAqrg&oe=6ACCF2B7"}, "display_name": "Speedway Race Clash: Ultimate Showdown", "keywords": ["Racing", "Formula1", "Cars", "Driving", "Simulator"], "long_description": "**Step into the race in VR**\n*Speedway Race Clash* is a fast-paced arcade racing experience built for Meta Quest. Jump into the driver\u2019s seat and compete across multiple tracks with AI opponents in quick, intense races designed for VR.\n\n**Race Across 9 Unique Tracks**\nFrom tight technical layouts to high-speed circuits, each track challenges your control, reflexes, and racing strategy.\n\n**Drive Multiple Car Classes**\nStart with Classic cars and unlock faster machines as you progress:\n\u2022 Classic Cars \u2014 balanced and accessible\n\u2022 GT Cars \u2014 faster and more demanding\n\u2022 F1 Cars \u2014 maximum speed and precision\n\n**Earn, Unlock, Progress**\nWin races, earn coins, and unlock new cars and tracks. Improve your performance, master each class, and climb to the fastest tier.\n\n**Built for VR Gameplay**\n\u2022 Short races (20\u201330 seconds) \u2014 perfect for quick sessions\n\u2022 Smooth controls and responsive driving\n\u2022 7 AI opponents per race\n\u2022 Easy to start, challenging to master\n\n**From First Lap to Full Speed**\nWhether you\u2019re aiming for perfect lines or just enjoying the speed, every race pushes you closer to faster cars and tougher challenges.\n\nAre you ready to take the lead?......\n", "short_description": "High-speed VR racing with real progression.\n\nRace across 9 tracks with Classic, GT, and F1 cars. Earn coins, unlock new vehicles, and master faster classes as you progress.\n\nFast races! Tight control! Pure arcade speed!!!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/somosunogames/inicio/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Somosuno Games", "support_website_url": null, "website_url": "https://sites.google.com/view/somosunogames/inicio", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35864408466507411"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618499_1199258238982793_2263393031316038989_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ibwt0GRTgJ4Q7kNvwHzoo0H&_nc_oc=AdqkPhK-yjLAv2dee4eQVQlurODeFToUQegrn-kVcDRmwqugDZ0NJRCDC088zCQHlbk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNLo87bKsKjzee8UicE4IlhimFpL3XhhwtS4vKgAZWDPQ&oe=6ACD0798"}, "is_concept": false, "is_test": false, "is_trial
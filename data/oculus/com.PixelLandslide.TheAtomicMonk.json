9&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bTH3IXc0COQQ7kNvwH8HgGL&_nc_oc=AdooKJNr9siX5X7veex0pOJX_fXYEil_Ou90yUBDyAVIscmWf4tfVPJ_L1lsOh5SC20&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0F0wXHrxrP-OYmfSX_l1JspIBnMLVFQ9TeGrOo-ebTw&oe=6AFDCD2C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Atomic Monk", "keywords": ["Gorilla", "Survival", "Atomic", "TAM", "Shoot"], "long_description": "Tired of the same old Gorilla Tag horror fangames? something completely different. fresh, wild, and raw gameplay to keep you engaged\n\nUnique Experience\nmutants, radiation zones, and PVP-PVE action all in one.\n\nCrafted with Care\nEvery part of the game is made from the ground up to give you smooth and fun gameplay. No more clunky stuff, just good times with your friends.\n\nBig Exploration\nBig Open-World map Filled with Buildings and Abandoned Monuments!\n\nMassive Servers\nMake Friends with 100 Player Servers (200 player servers coming at a later date!)", "short_description": "Tired of the same old Gorilla Tag horror fangames? something completely different. fresh, wild, and raw gameplay to keep you engaged"}]}, "developer_name": "Pixel LandSlide", "developer_privacy_policy_url": "https://pixellandslide.squarespace.com/legal", "developer_terms_of_service_url": "https://pixellandslide.squarespace.com/legal", "publisher_name": "Pixel LandSlide", "support_website_url": "https://pixellandslide.squarespace.com/contact", "website_url": "https://pixellandslide.squarespace.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommen
dn.com/v/t64.5771-25/57569430_1996087577415249_311313702587003460_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TYYx4Haw3CsQ7kNvwEqKFMH&_nc_oc=AdqkwQuZwUpmW2rn0SpT0E4YA4NAA1RhpAV1xeSljcyGax0cRCEhjOK6zg-EUB-9nrE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTswDCTywl6NJoFxZK-Dn4lDwWVtty9LZ5RmxI5VFGuhg&oe=6B05B9F6"}, {"file_name": "3de8fa5f86cd447476c4c61a962dcd7d (1) (1).png", "id": "602798271942533", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031456_602798278609199_2456997631010076673_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EGY1Fib1f9UQ7kNvwHUeIu5&_nc_oc=AdrhHuMt-1iVIrbzQmRcXIi3NdvuDO7d94lfxciU7SoFklruWgVP2Bxbo47Kl5qjHzk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIXU0RfbldQVpVYr16UueAAQ1RtZHNHZj6uGDQJbd5Zw&oe=6B05CF9E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u540d\u79f0\u672a\u8a2d\u5b9a\u306e\u30c7\u30b6\u30a4\u30f3 (1) (1).png", "id": "266362419322952", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982674_266362422656285_7956766679824628207_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9QZGnqJBg_UQ7kNvwFvsoZO&_nc_oc=AdogTzKIlFXoP_4Sgv8y8FBYmmCDIZ6KZm5is6zBEAB_e0gmtWkVOOABOnll7_rc-Eo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1754Q7Y-y8Woq6dEA_sVYQKV5lJV-t_zUCyj8s2tqNA&oe=6B05CD24"}, "display_name": "Nonbiri Relax", "keywords": [], "long_description": "\"Nonbiri\" in Japanese translates to \"spending leisurely\" or \"taking it easy.\" As the name suggests, this app allows you to enjoy a relaxed and unhurried experience. There are six different spaces available, each with its own unique ambiance. (The number of spaces is expected to increase in the future.) These spaces encompass various settings, such as a crackling campfire or a tranquil rain environment. There are no time constraints, allowing you to spend as much time as you like in each space. To exit a space, simply press the home button located within each area to return to the main menu. Now, please have a wonderful time enjoying this app.", "short_description": "This app provides a space to soothe busy individuals and those pressed for time. Please enjoy a leisurely time in a comfortable environment with calming ambiance and sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sparkleand.store/vr-privacy-policy", "developer_terms_of_service_url": "https://www.sparkleand.store/terms-and-conditions", "publisher_name": "Sparkle and, Inc.", "support_website_url": null, "website_url": "https://www.sparkleand.store/nonbiri-relax", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "549438580565712"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6436852036400697", "version": "0.9"}, "id": "3153724728260878", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6428910040528230", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id"
wW77G8P63fbEsros8fh_cc-F6cRfv-L5mGNhN_g&oe=6A9FFE36"}, {"file_name": "3de8fa5f86cd447476c4c61a962dcd7d (1) (1).png", "id": "602798271942533", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031456_602798278609199_2456997631010076673_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HO9Y-npCQi4Q7kNvwHY0GMn&_nc_oc=AdqPQ3WBpym8UIyr07Rf8ICPMkydtT-RumyQjGO2PVYG0qeXiKaBgRp8pOT_OGyOyX8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJh5G_2_etrCE6F7G-rQwJSTLD6VZGnkLlePz_kiqtZlg&oe=6AA013DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u540d\u79f0\u672a\u8a2d\u5b9a\u306e\u30c7\u30b6\u30a4\u30f3 (1) (1).png", "id": "266362419322952", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982674_266362422656285_7956766679824628207_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vvsNUmf_33IQ7kNvwHMHWv3&_nc_oc=AdpBpMTkNzjT691iq0XgG0i-HyDmmb8ockLvU7dyOcZ_8HXV8kRtkTSK6xVwwODf8wo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJVDVrd9EcQyqYtwFr3mLC3SmkVFK9YhOXWQNEbz4gdA&oe=6AA01164"}, "display_name": "Nonbiri Relax", "keywords": [], "long_description": "\"Nonbiri\" in Japanese translates to \"spending leisurely\" or \"taking it easy.\" As the name suggests, this app allows you to enjoy a relaxed and unhurried experience. There are six different spaces available, each with its own unique ambiance. (The number of spaces is expected to increase in the future.) These spaces encompass various settings, such as a crackling campfire or a tranquil rain environment. There are no time constraints, allowing you to spend as much time as you like in each space. To exit a space, simply press the home button located within each area to return to the main menu. Now, please have a wonderful time enjoying this app.", "short_description": "This app provides a space to soothe busy individuals and those pressed for time. Please enjoy a leisurely time in a comfortable environment with calming ambiance and sound."}]}, "de
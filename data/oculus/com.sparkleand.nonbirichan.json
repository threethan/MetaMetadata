5aBb-8wPD7e9SrPjpvtHJlC-wcQ_ou_3ipd0i_A&oe=69DF8336"}, {"file_name": "3de8fa5f86cd447476c4c61a962dcd7d (1) (1).png", "id": "602798271942533", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031456_602798278609199_2456997631010076673_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hwOjgX_BR2UQ7kNvwGjwGUV&_nc_oc=AdqrUQK-CY32k9FcgEfjCeQOhm5Mf6eC9DpG4MmUUdpf6fFdamVg_o8uULBFXPvVbFg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0u0q7a_jHePUdmFLEWFYCzeGm5hQluaGbIZKfv5jvcgA&oe=69DF98DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u540d\u79f0\u672a\u8a2d\u5b9a\u306e\u30c7\u30b6\u30a4\u30f3 (1) (1).png", "id": "266362419322952", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982674_266362422656285_7956766679824628207_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eY8Hr_DMCeQQ7kNvwHx1xpT&_nc_oc=AdpI4Rh5Jqb5nxLquzr0E_LgvtHx9Te94eBJXdDeDhENDrGLlrPrDzPA4TlDTrdZwHo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Cr4g5Yn_I5QuN1V9MVwgQfId1ONYY_uDlNzWQiwdmqw&oe=69DF9664"}, "display_name": "Nonbiri Relax", "keywords": [], "long_description": "\"Nonbiri\" in Japanese translates to \"spending leisurely\" or \"taking it easy.\" As the name suggests, this app allows you to enjoy a relaxed and unhurried experience. There are six different spaces available, each with its own unique ambiance. (The number of spaces is expected to increase in the future.) These spaces encompass various settings, such as a crackling campfire or a tranquil rain environment. There are no time constraints, allowing you to spend as much time as you like in each space. To exit a space, simply press the home button located within each area to return to the main menu. Now, please have a wonderful time enjoying this app.", "short_description": "This app provides a space to soothe busy individuals and those pressed for time. Please enjoy a leisurely time in a comfortable environment with calming ambiance and sound."}]}, "de
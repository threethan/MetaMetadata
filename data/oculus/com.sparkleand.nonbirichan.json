mUPwQ3ZpvXrMS1pEzLu13srjfFeasyR5DcL9cqA&oe=69D3A5B6"}, {"file_name": "3de8fa5f86cd447476c4c61a962dcd7d (1) (1).png", "id": "602798271942533", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031456_602798278609199_2456997631010076673_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lJ469C0JiHMQ7kNvwHREBcy&_nc_oc=AdoCHcOlgqpZMy4aSP2yEwUkQoPM7nP9Xv97-Qy5Fw5wAi7QnjnDNbRmPIIUVaX40R0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1vEcaVO_iV_CMhC0MK_jsEtZ1K7ccTAB8Glu6jgb4ukw&oe=69D3BB5E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u540d\u79f0\u672a\u8a2d\u5b9a\u306e\u30c7\u30b6\u30a4\u30f3 (1) (1).png", "id": "266362419322952", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982674_266362422656285_7956766679824628207_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hhmsn67Llx8Q7kNvwGyMTDd&_nc_oc=AdoxpD6FuvSb2EG3mW5RSL-U7VnpUbVFrnvy21CyQmIw1iR3658As-1aqxV5vwjGheM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0o7Pjdt5NL5JI8U_5FX25PC-MIwGZRRVRCLF2p7cR-qA&oe=69D3B8E4"}, "display_name": "Nonbiri Relax", "keywords": [], "long_description": "\"Nonbiri\" in Japanese translates to \"spending leisurely\" or \"taking it easy.\" As the name suggests, this app allows you to enjoy a relaxed and unhurried experience. There are six different spaces available, each with its own unique ambiance. (The number of spaces is expected to increase in the future.) These spaces encompass various settings, such as a crackling campfire or a tranquil rain environment. There are no time constraints, allowing you to spend as much time as you like in each space. To exit a space, simply press the home button located within each area to return to the main menu. Now, please have a wonderful time enjoying this app.", "short_description": "This app provides a space to soothe busy individuals and those pressed for time. Please enjoy a leisurely time in a comfortable environment with calming ambiance and sound."}]}, "de
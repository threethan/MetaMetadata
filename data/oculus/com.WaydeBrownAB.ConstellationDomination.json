t=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrq4OlUV1Q8r61KqHSt7GQhOYonRUpC62ZKPA-2QpObw&oe=6AFC5F1C"}, "display_name": "Constellation Domination", "keywords": [], "long_description": "A simple but satisfying VR RTS style game set in deep space. Perfect for when you just want to chill out on the lounge, pop into VR and conquer some galaxies!\n\nThe game at its core is simple:\n      1. Upgrade your planets so that they produce more asteroids.\n      2. Take over empty planets to expand your army.\n      3. Wipe out the enemy to conquer the solar system.\nbut you will be surprised how challenging simple game mechanics can be with the right constellations. A good strategy and fast hands are a must to be able to dominate this galaxy.\n\nThe game has movement mechanics that allow you to float around the galaxy whilst sitting in your favourite chair, but it also works perfectly whilst standing or in room scale so that you can run around your house attacking planets and wreaking havoc on the enemy.", "short_description": "A simple but satisfying VR RTS style game set in deep space. Perfect for when you just want to chill out on the lounge, pop into VR and conquer some galaxies!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://constellationdomination.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Wayde Brown AB", "support_website_url": "https://constellationdomination.com/feedback/", "website_url": "https://www.constellationdomination.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPACE_UNIVERSE", "STRATEGY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": 
e": "3.png", "id": "1150180360583895", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821725_1150180363917228_9151733531980987276_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jIuXNzxI4fQQ7kNvwEdPz8-&_nc_oc=AdogzLP4bYHFljaXt3YzsMS2HdtcLrrwG8K537SJH55ZpyMUEdeGeLEXjSw6R_vzLfY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfyuW8hIJ-nW4Caaw0Vy-Dh1qCKtqpbe2fQ4Q1rpcypA&oe=6AFC6E80"}, {"file_name": "4.png", "id": "677023061886195", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821782_677023065219528_940733743377294403_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j11H_mKVQAQQ7kNvwGLNRWO&_nc_oc=AdqNujmz-3yel-VIMWUya3MpmV1qgV1Ls7u8Avrkz1DnwYy-70w9j0exhP5qPRi3i6k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEtKWJvG1NBlF_iFYrGiOr5AQAKvcDA1mObvFyTSpgSw&oe=6AFC5F88"}, {"file_name": "5.png", "id": "2087178448775404", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491827973_2087178452108737_6482137199764472056_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n6Ii8rQXwl0Q7kNvwEiM1Jq&_nc_oc=AdpPm1CrjLDSuoSXG3r16Nu4Rbbn5SPBCR6N8mqm6wXOGveE16yg0FQwK-BGpQHGi4M&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYDUuE-e8nsta0p561JI6JHyME9vBxyuJFpHh3NLMrnA&oe=6AFC76CB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hotel Life VR", "keywords": ["hotel", "simulation", "housekeeping", "roleplay", "bellboy"], "long_description": "Step into the world of hotel hospitality in full VR!\nExperience life as a bellboy in a luxury hotel \u2014 greet guests, hand over room keys, carry luggage, deliver room service, and ensure every guest enjoys their stay.\nFrom reception duties to room management, every task immerses you in the rhythm of a real hotel.\n\nScan guest profiles to see if they meet hotel standards, manage check-ins and check-outs, and handle unexpected requests or events that will test your speed, memory, and multitasking skills.\n\nWith realistic physics, interactive environments, and detailed hotel interiors, this simulation offers both relaxing management gameplay and immersive role-play moments.\nWhether you want to master hospitality or just enjoy a day in the life of a bellboy, this game delivers an authentic VR hotel experience like never before.\n\n\ud83c\udfe8 Key Features:\n\nFully interactive hotel environment\n\nRealistic guest interactions and behaviors\n\nMultiple hotel service tasks (reception, room service, cleaning, delivery)\n\nGuest approval system \u2014 identify who\u2019s fit to stay\n\nImmersive sound design and natural VR controls\n\nTake your place behind the reception desk and show what it takes to keep a hotel running smoothly!", "short_description": "Be the bellboy in a luxury VR hotel!\nGreet guests, deliver luggage, clean rooms, and manage hotel operations in a fully interactive hospitality simulation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gametriclabs.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "\u0130N\u0130T\u0130UM STUD\u0130O", "support_website_url": null, "website_url": "https://gametriclabs.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25186331180962715"}}]}, "scheduled_offers": {"count": 11, "nodes": [{"status": "PUBLISHED", "id": "
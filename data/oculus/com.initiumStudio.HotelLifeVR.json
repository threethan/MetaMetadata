Vbv4SlVZEUunHUkiA8Rc4Xh6LESQjOZIRry051e1FeIW_1thcWfY3mi3o&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0rtT7uxvxN-XNQToQw4-wzbgGdxSdxiZMYeqpbWn9E8g&oe=69F37100"}, {"file_name": "4.png", "id": "677023061886195", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491821782_677023065219528_940733743377294403_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zErpr6mq-vcQ7kNvwFmoiAb&_nc_oc=AdrmxK719yKQSVqWJX_9lfQdh_vc8rBZATe2k78gxXw1Q7fgDLKqIUfpTJYBQVGkGJY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0es4YqP2XoOS1d4l9K_5R8OUmZxMaH-Xczr4j59LLqCQ&oe=69F36208"}, {"file_name": "5.png", "id": "2087178448775404", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491827973_2087178452108737_6482137199764472056_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mj3iSPSAvQsQ7kNvwE79mCu&_nc_oc=Adr1M_oCCvDwFdD0ymZzcOVrIFgx_qL-gXbCW0sOwAphBz-1xmOc4lohYFN1Y3iUY9U&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1GZhuCT9uH5CetaMltGpx_6EwHoIPp1DLVnNYr-vJ4Tg&oe=69F3410B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hotel Life VR", "keywords": ["hotel", "simulation", "housekeeping", "roleplay", "bellboy"], "long_description": "Step into the world of hotel hospitality in full VR!\nExperience life as a bellboy in a luxury hotel \u2014 greet guests, hand over room keys, carry luggage, deliver room service, and ensure every guest enjoys their stay.\nFrom reception duties to room management, every task immerses you in the rhythm of a real hotel.\n\nScan guest profiles to see if they meet hotel standards, manage check-ins and check-outs, and handle unexpected requests or events that will test your speed, memory, and multitasking skills.\n\nWith realistic physics, interactive environments, and detailed hotel interiors, this simulation offers both relaxing management gameplay and immersive role-play moments.\nWhether you want to master hospitality or just enjoy a day in the life of a bellboy, this game delivers an authentic VR hotel experience like never before.\n\n\ud83c\udfe8 Key Features:\n\nFully interactive hotel environment\n\nRealistic guest interactions and behaviors\n\nMultiple hotel service tasks (reception, room service, cleaning, delivery)\n\nGuest approval system \u2014 identify who\u2019s fit to stay\n\nImmersive sound design and natural VR controls\n\nTake your place behind the reception desk and show what it takes to keep a hotel running smoothly!", "short_description": "Be the bellboy in a luxury VR hotel!\nGreet guests, deliver luggage, clean rooms, and manage hotel operations in a fully interactive hospitality simulation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gametriclabs.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "\u0130N\u0130T\u0130UM STUD\u0130O", "support_website_url": null, "website_url": "https://gametriclabs.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25186331180962715"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "969723922419393"}, {"status": "PUBLISHED", "id": "1230253588881662"}, {"status": "PUBLISHED", "id": "1420393152466388"}, {"status": "PUBLISHED", "id": "1590778125255639"}, {"status": "PUBLISHED", "id": "4351635575108182"}, {"status": "PUBLISHED", "id": "1284028467085893"}, {"status": "PUBLISHED", "id": "7325166232
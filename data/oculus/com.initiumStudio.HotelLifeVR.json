e": "3.png", "id": "1150180360583895", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821725_1150180363917228_9151733531980987276_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LoKiP4m7npUQ7kNvwF9_o5K&_nc_oc=AdrbBW7QGgIK5S8f1y1jze8s0fufuc0HK3XF7JMcgLp-eZ-xpR8UmHbMm3YjloK1O8g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS70oi907J6cNHhFrFKv1J1jyKKPdecyhAolYRgh2UF_Q&oe=6B05A900"}, {"file_name": "4.png", "id": "677023061886195", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821782_677023065219528_940733743377294403_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ub1sq8U4Z0UQ7kNvwHxfaL1&_nc_oc=AdqXIaQ8pEbzt-QgjfrKIIeb7wMd8W8xv2kGCC7VJn2Bezh-VIHED2usEvneIITNCtk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPRmdkuSvDQJYmrtoFIfNsKn_p1gBQ2FvKjx8tKTv1fg&oe=6B05D248"}, {"file_name": "5.png", "id": "2087178448775404", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827973_2087178452108737_6482137199764472056_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ic-W196W3vUQ7kNvwFzhm3J&_nc_oc=AdoMJ8oSxnT1sbMGRepuwhiUadsIs8HWOqqJgAOVyGOLqUrULhJW74_hQHbrcTcDrzg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1hN1YEUaBOl6a9iWFXvAwAKi95_VbvGZ32404OZf7uw&oe=6B05B14B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hotel Life VR", "keywords": ["hotel", "simulation", "housekeeping", "roleplay", "bellboy"], "long_description": "Step into the world of hotel hospitality in full VR!\nExperience life as a bellboy in a luxury hotel \u2014 greet guests, hand over room keys, carry luggage, deliver room service, and ensure every guest enjoys their stay.\nFrom reception duties to room management, every task immerses you in the rhythm of a real hotel.\n\nScan guest profiles to see if they meet hotel standards, manage check-ins and check-outs, and handle unexpected requests or events that will test your speed, memory, and multitasking skills.\n\nWith realistic physics, interactive environments, and detailed hotel interiors, this simulation offers both relaxing management gameplay and immersive role-play moments.\nWhether you want to master hospitality or just enjoy a day in the life of a bellboy, this game delivers an authentic VR hotel experience like never before.\n\n\ud83c\udfe8 Key Features:\n\nFully interactive hotel environment\n\nRealistic guest interactions and behaviors\n\nMultiple hotel service tasks (reception, room service, cleaning, delivery)\n\nGuest approval system \u2014 identify who\u2019s fit to stay\n\nImmersive sound design and natural VR controls\n\nTake your place behind the reception desk and show what it takes to keep a hotel running smoothly!", "short_description": "Be the bellboy in a luxury VR hotel!\nGreet guests, deliver luggage, clean rooms, and manage hotel operations in a fully interactive hospitality simulation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gametriclabs.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "\u0130N\u0130T\u0130UM STUD\u0130O", "support_website_url": null, "website_url": "https://gametriclabs.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25186331180962715"}}]}, "scheduled_offers": {"count": 12, "nodes": [{"status": "PUBLISHED", "id": "
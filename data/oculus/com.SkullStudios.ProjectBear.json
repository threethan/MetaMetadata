ends, and start tagging!\n", "short_description": "Project Bear is a fun, fast-paced VR game inspired by Gorilla Tag. Created by passionate developers who wanted to bring something fresh, exciting, and fun back to VR. Jump in, explore, tag your friends, and make your own unforgettable moments!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1fG6OhAngcAD8QTz956OqQ6irfTxDpHQLbIhYULyHQsI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Skull", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1rWt222W3kPk4v6tOa8LiLx54bIVb_po18uYhBoIqzN8/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1344096588789687"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1344225938776752", "version": "AsteroidsFangameTemplate"}, "id": "1488628273108092", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1344096575456355", "is_concept": false, "latest_released_binary": {"__typename": "
 who wanted to bring something fresh, exciting, and fun back to VR. Jump in, explore, tag your friends, and make your own unforgettable moments!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1fG6OhAngcAD8QTz956OqQ6irfTxDpHQLbIhYULyHQsI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Skull", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1rWt222W3kPk4v6tOa8LiLx54bIVb_po18uYhBoIqzN8/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1344096588789687"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823366_964291129471847_1755458767959048931_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ysl60SXq63QQ7kNvwFatbuh&_nc_oc=Adrp1J-zSNxtCyzTsKxHiKgeHTteLYX0plUQCiXTvF4yakkqG30z6my6Np6lDBodduU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEj2imgERdJkdcqSuUkd1Zb5zkHrLJNh2tyDu0IHJocA&oe=6B05B3A7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Project Bear", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Platformer", "id": 
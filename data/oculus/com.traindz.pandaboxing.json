b=1-7&_nc_sid=6e7a0a&_nc_ohc=kQ2JHiP4_LkQ7kNvwGEUVXK&_nc_oc=AdocGL7H95qe6YEXVq9jICdgVjtGGJxia0VQ7QGrGlo_F5o_elhISeh9BTuwIOibQiA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5nrUQqHMH4BA7RZiwgSM0uWvdVtGrhqOdpEJlaEqE03Q&oe=69FF3D25"}, {"file_name": "SCREEN4.png", "id": "2375262309504937", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392005_2375262312838270_8915025067164246813_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XeOm_kG4OYkQ7kNvwEsFtec&_nc_oc=AdrBAcCg_qe1H5q0Cv3ZLi-gMgJRKV-7wpJJ9fC9-zYDxiFM92oucXiMLj40hEtWWp0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5hAg5q-w8DdxtR9oi-X2sJumkouqqArOehpD3cS5tOuw&oe=69FF4953"}, {"file_name": "SCREEN5.png", "id": "482447744799251", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393584_482447748132584_7290716402068684415_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OBjVvvyMVbIQ7kNvwEyKchg&_nc_oc=AdoS41EBqpGtv_p7yCRc1i8YqdYvB1V6QDYe-FnMzl0qufhB_9a7GzNpuqilAvrUnIU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6JTaa5snGn-bROnJjbJrWAvin75IHluJcf6W_xgWCOSQ&oe=69FF4090"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "491151787396549", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_491151790729882_4737948214887056122_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OL7yjM3rp2MQ7kNvwHoc2du&_nc_oc=Adru1_amQAxdY8WwtQ7hFHxN-BkJ1QuHNpTS4cce3rhbZKmPFI_GoG34upE83a2K6Ek&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6jOv04tg1Sf4rSr0cwjfDHGrVBmYtDg2VJtlcI_LWmuw&oe=69FF23D3"}, "display_name": "Panda Boxing", "keywords": ["boxing", "fighting", "thrillofthefight", "animal", "action"], "long_description": "Step into a boxing ring and face off against the most fierce, unexpected opponent, an unstoppable fighting panda! In Panda Boxing, there are no rules, no referees, and no mercy. It\u2019s just you, your fists, and a wild, fast-paced brawl against a panda that doesn\u2019t hold back.\n\n\ud83e\udd4a\ud83d\udc3c\ud83d\udd25\nDodge, punch, and survive as the panda unleashes relentless attacks. Stay on your feet and keep up with the intensity, or risk getting knocked out. Use the environment to your advantage. Look for items scattered around the ring to aid in battle. Smash open boxes to recover health which could turn the fight in your favor.\n\n\ud83e\udd4a Personalize your fight style by customizing your boxing gloves with different designs. Will you go for patriotic fists or gorilla head ?\n\n\ud83e\udd4a Do you have what it takes to go toe-to-toe with a powerhouse panda in an all-out, no-holds-barred brawl? Put on your VR headset, step into the ring, and find out! This isn\u2019t just boxing\u2014this is Panda Boxing! \n\ud83e\udd4a\ud83d\udc3c\ud83d\udd25", "short_description": "Step into a boxing ring and face off against the most fierce, unexpected opponent, an unstoppable fighting panda! In Panda Boxing, there are no rules, no referees, and no mercy. It\u2019s just you, your fists, and a wild, fast-paced brawl against a panda that doesn\u2019t hold back."}]}, "developer_name": "TRAINDZ GAMING", "developer_privacy_policy_url": "https://www.biims.net/pandaboxingvr", "developer_terms_of_service_url": null, "publisher_name": "TRAINDZ GAMING", "support_website_url": null, "website_url": "https://www.biims.net/pandaboxingvr", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "suppo
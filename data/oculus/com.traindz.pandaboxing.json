_AQTb8Or6vEgm2OjzULIDn2kZekHY4ecxJBDkUa-37Ex4_A&oe=6AFB1C6C"}, {"file_name": "SCREEN3.png", "id": "1164533248415008", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473392163_1164533251748341_2374396971714818691_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mpzjJ-sd61UQ7kNvwER8d_J&_nc_oc=AdpmP7T5Jy-mEKhJgWXvH5kPeGh84HKHYOk0_cpur-UoHyWsRylBSBbArAW7zae3jPE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_Y8BzUlK46Dboy-om-XtrAFipJmotH40SYzg4_4jkJA&oe=6AFB43E5"}, {"file_name": "SCREEN4.png", "id": "2375262309504937", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473392005_2375262312838270_8915025067164246813_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P3d6mutnN64Q7kNvwFnhZhK&_nc_oc=Adqb_7bQRh-sQfalg3UyBLRgxc-BmImRfkYgxykVi8GnDjbUtpY3W5_eQ0KLL1s0zwo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzl5uhBtrdpBE0OUDZljeHluqCv54bmBqbkl19KA4Njg&oe=6AFB17D3"}, {"file_name": "SCREEN5.png", "id": "482447744799251", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393584_482447748132584_7290716402068684415_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Ca115OzZy4Q7kNvwFY-ptp&_nc_oc=AdrmnZK6Oks4GYPlAKM0xj2ieUdZW53uXUghS2is5lgnAgYfcVVni8iHG_FldDjBoBo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSr0MWfAtD5kgY2FrFSYYQLS9lcQLfRIRh7b1YK_-v0Ig&oe=6AFB4750"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "491151787396549", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391958_491151790729882_4737948214887056122_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4_FOzKecWc4Q7kNvwGgxH6c&_nc_oc=Adqxm5o0k7fJ43lhseKLbvWu6IofFOD-cwO8nBfT1SiFl0pT6zUczTaCH5xnIHsLEmo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTHneMly3X7_h1wg4k2GtU0eEL27ht7ZE4Zzj5M8UqNg&oe=6AFB2A93"}, "display_name": "Panda Boxing", "keywords": ["boxing", "fighting", "thrillofthefight", "animal", "action"], "long_description": "Step into a boxing ring and face off against the most fierce, unexpected opponent, an unstoppable fighting panda! In Panda Boxing, there are no rules, no referees, and no mercy. It\u2019s just you, your fists, and a wild, fast-paced brawl against a panda that doesn\u2019t hold back.\n\n\ud83e\udd4a\ud83d\udc3c\ud83d\udd25\nDodge, punch, and survive as the panda unleashes relentless attacks. Stay on your feet and keep up with the intensity, or risk getting knocked out. Use the environment to your advantage. Look for items scattered around the ring to aid in battle. Smash open boxes to recover health which could turn the fight in your favor.\n\n\ud83e\udd4a Personalize your fight style by customizing your boxing gloves with different designs. Will you go for patriotic fists or gorilla head ?\n\n\ud83e\udd4a Do you have what it takes to go toe-to-toe with a powerhouse panda in an all-out, no-holds-barred brawl? Put on your VR headset, step into the ring, and find out! This isn\u2019t just boxing\u2014this is Panda Boxing! \n\ud83e\udd4a\ud83d\udc3c\ud83d\udd25", "short_description": "Step into a boxing ring and face off against the most fierce, unexpected opponent, an unstoppable fighting panda! In Panda Boxing, there are no rules, no referees, and no mercy. It\u2019s just you, your fists, and a wild, fast-paced brawl against a panda that doesn\u2019t hold back."}]}, "developer_name": "TRAINDZ GAMING", "developer_privacy_policy_url": "https://www.biims.net/pandaboxingvr", "developer_terms_of_service_url": null, "publisher_name": "TRAINDZ GAMING", "support_website_url": null, "website_url": "https://www.biims.net/pandaboxingvr", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "459781504968480"}], "external_subscription_
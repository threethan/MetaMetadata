WU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9T4MG1uuBNgKXZKY-AUVhJsi0iY9K8inEezMlQ-n0dvQ&oe=6A32A7A5"}, {"file_name": "SCREEN4.png", "id": "2375262309504937", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473392005_2375262312838270_8915025067164246813_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0HQcTpVX--kQ7kNvwFlycS3&_nc_oc=Adp1JzH3vJFeQ9OtZJ2q0-VYVZm6Hnt6v2CVrfwmdZ4OlLucvp9-fonmm90PhydiIqU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_nOV5WDXK5aEMDbuckRv2ir-fZlMvUfIENuQ-gSofsQ&oe=6A32B3D3"}, {"file_name": "SCREEN5.png", "id": "482447744799251", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473393584_482447748132584_7290716402068684415_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d2PujAmYGQIQ7kNvwF59oE9&_nc_oc=Adpkm64h-uVqT0uLqoEoYp4CZJtQ8BB8NCRvUx103YU0LX9KL8mGEl3ze8wTF9nd3a8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_t1GkwRxsQufscQr5vnMdJ2GkAlQ4om7GETX6Ci2LEAA&oe=6A32AB10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "491151787396549", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391958_491151790729882_4737948214887056122_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hoA2GeYjn6gQ7kNvwHHn_ps&_nc_oc=AdoTy_NBjIm26hFow4LNl8nV6p-KeNz5FzUm84Vfme2j3AAKE_Jr2WfoCTpVzhr4IGw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ontLKdMQ-EtKRa8cDAadBBe1e6mZjKtc2oizE6U5ugQ&oe=6A32C693"}, "display_name": "Panda Boxing", "keywords": ["boxing", "fighting", "thrillofthefight", "animal", "action"], "long_description": "Step into a boxing ring and face off against the most fierce, unexpected opponent, an unstoppable fighting panda! In Panda Boxing, there are no rules, no referees, and no mercy. It\u2019s just you, your fists, and a wild, fast-paced brawl against a panda that doesn\u2019t hold back.\n\n\ud83e\udd4a\ud83d\udc3c\ud83d\udd25\nDodge, punch, and survive as the panda unleashes relentless attacks. Stay on your feet and keep up with the intensity, or risk getting knocked out. Use the environment to your advantage. Look for items scattered around the ring to aid in battle. Smash open boxes to recover health which could turn the fight in your favor.\n\n\ud83e\udd4a Personalize your fight style by customizing your boxing gloves with different designs. Will you go for patriotic fists or gorilla head ?\n\n\ud83e\udd4a Do you have what it takes to go toe-to-toe with a powerhouse panda in an all-out, no-holds-barred brawl? Put on your VR headset, step into the ring, and find out! This isn\u2019t just boxing\u2014this is Panda Boxing! \n\ud83e\udd4a\ud83d\udc3c\ud83d\udd25", "short_description": "Step into a boxing ring and face off against the most fierce, unexpected opponent, an unstoppable fighting panda! In Panda Boxing, there are no rules, no referees, and no mercy. It\u2019s just you, your fists, and a wild, fast-paced brawl against a panda that doesn\u2019t hold back."}]}, "developer_name": "TRAINDZ GAMING", "developer_privacy_policy_url": "https://www.biims.net/pandaboxingvr", "developer_terms_of_service_url": null, "publisher_name": "TRAINDZ GAMING", "support_website_url": null, "website_url": "https://www.biims.net/pandaboxingvr", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28388474484129315"}, "review_messages": []}]}, "c
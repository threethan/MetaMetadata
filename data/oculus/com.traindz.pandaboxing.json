E.png", "id": "438281299307192", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391911_438281302640525_7773953931045204998_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BnX9iOyWB_UQ7kNvwEeojZn&_nc_oc=AdnHaIkw-vq88UY3-9vBtbI5MSAc0fxJbsgCii4uZMPr4DwBc1PoX1SA5rcT_XPdYnM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxGLRFVfWQhZd2gEDqCriDy6p4W3BZJHyJ7qwwQXq0faA&oe=69B69E41"}]}, "id": "1843795216451687", "locale": "en_US", "screenshots": [{"file_name": "SCREEN1.png", "id": "632164966277418", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391959_632164969610751_8651399017216663741_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SfcLhUqumGMQ7kNvwFAUwEa&_nc_oc=AdlFw2U3PypVQWn5hl2QEmGrEpiGgxTMFh0Gmlga4u_iQf6zuHgsjLZEI_QHl_uFe9Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyoWpK2IDFTxYO7J2RDLhlLq20mG5Ryg-UjAhxAB9MbrQ&oe=69B69F1A"}, {"file_name": "SCREEN2.png", "id": "978617513899687", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393554_978617517233020_2953324506008420345_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_sW5pi7iHhQQ7kNvwGfuKCQ&_nc_oc=AdmpmzxcoZIfCwFsW6Z9xjp0CpThbfJUKwedKxoZDt89yK5-izLYRunN1ATPET5mXwA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxskiZIqoD5bZvAXsVkM5A63Pgt4hxaHYSV36XQf9LE-A&oe=69B6932C"}, {"file_name": "SCREEN3.png", "id": "1164533248415008", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392163_1164533251748341_2374396971714818691_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_PxrMt6MXOUQ7kNvwEmAotM&_nc_oc=Adk5go4jPBEWHMwNhBf0h5Xvuk6ob-Pz47xQiehCOvNSqb3oNdyR2tisFqXzv64NmME&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzKng-07rmd-aVutwUExBu6qhHBd3FCp1JSVuc3yoQOiw&oe=69B6BAA5"}, {"file_name": "SCREEN4.png", "id": "2375262309504937", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392005_2375262312838270_8915025067164246813_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GYXbxK9NAGEQ7kNvwEITH4Y&_nc_oc=Adlql4BokNsef-g--DtF2kqeJ9je6dRYK0t3B2D1AMwTD-PGHZ7KGMbIhKBKkVhTCC0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwgO0sJM6JzafWrp5J2MZqttAWBDuPhOrF5OM6h7LpDZw&oe=69B68E93"}, {"file_name": "SCREEN5.png", "id": "482447744799251", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393584_482447748132584_7290716402068684415_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pN11Q0tjDy0Q7kNvwFzCgfM&_nc_oc=AdnqA0Wc0fce8MqFjrnSauPB8BdI_rB6O47OmSdXhBrotgG-48kk2obHCmhgMKx6hNY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzCCT2TM3cux-GIGtpKc12j-hrtiSZOG4PDhQCwTnUN7g&oe=69B6BE10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "491151787396549", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_491151790729882_4737948214887056122_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=72x9ogobUM0Q7kNvwG8uRe_&_nc_oc=AdkqnDKmd8T7EfaAho9M1BycBoezM3_LkgoY4C0fvLjwIeKnZW6wFrGpejZNhgDHMwE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyMahIXD8NitKsJubs5I1fev5kz9I6c9Gr8D5EyaYP14Q&oe=69B6A153"}, "display_name": "Panda Boxing", "keywords": ["boxing", "fighting", "thrillofthefight", "animal", "action"], "long_description": "Step into a boxing ring and face off against the most fierce, unexpected opponent, an unstoppable fighting panda! In Panda Boxing, there are no rules, no referees, and no mercy. It\u2019s just you, your fists, and a wild, fast-paced brawl against a panda that doesn\u2019t hold back.\n\n\ud83e\udd4a\ud83d\udc3c\ud83d\udd25\nDodge, punch, and survive as the panda unleashes relentless attacks. Stay on your feet and keep up with the intensity, or risk getting knocked out. Use the environment to your advantage. Look for items scattered around the ring to aid in battle. Smash open boxes to recover health which could turn the fight in your favor.\n\n\ud83e\udd4a Personalize your fight style by customizing your boxing gloves with different designs. Will you go for patriotic fists or gorilla head ?\n\n\ud83e\udd4a Do you have what it takes to go toe-to-toe with a powerhouse panda in an all-out, no-holds-barred brawl? Put on your VR headset, step into the ring, and find out! This isn\u2019t just boxing\u2014this is Panda Boxing! \n\ud83e\udd4a\ud83d\udc3c\ud83d\udd25", "short_description": "Step into a boxing ring and face off against the most fierce, unexpected opponent, an unstoppable fighting panda! In Panda Boxing, there are no rules, no referees, and no mercy. It\u2019s just you, your fists, and a wild, fast-paced brawl against a panda that doesn\u2019t hold back."}]}, "developer_name": "TRAINDZ GAMING", "developer_privacy_policy_url": "https://www.biims.net/pandaboxingvr", "developer_terms_of_service_url": null, "publisher_name": "TRAINDZ GAMING", "support_website_url": null, "website_url": "https://www.biims.net/pandaboxingvr", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28388474484129315"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1411669680183743"}, {"status": "PUBLISHED", "id": "660069433583213"}, {"status": "PUBLISHED", "id": "2363480414027300"}]}, "baseline_offer": {"id": "2363480414027300"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1746817200, "status": "PUBLISHED", "id": "141166968018374
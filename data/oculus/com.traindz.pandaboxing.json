E.png", "id": "438281299307192", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391911_438281302640525_7773953931045204998_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nzH4Ux1Yv7YQ7kNvwEeAEYJ&_nc_oc=Adn5n5_5939W_v1yDvaLhxEJf1S6RgF7GrnEXPcMwC2CXQKxylMa8pBGtSTkGNhfR7E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvVwWxAiS9HB2n3OSz2R4EGQHnOP8Or3XHfuBZv2L-Zeg&oe=69A96F41"}]}, "id": "1843795216451687", "locale": "en_US", "screenshots": [{"file_name": "SCREEN1.png", "id": "632164966277418", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391959_632164969610751_8651399017216663741_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=30QmjHQL7aIQ7kNvwEBoo7h&_nc_oc=AdnUMrmAZWuzG0c8l-Q_pZ97W3fDlTQgUq_po8gpirsfqzlbUZvoupPORP5OD1kOs9w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuB7oLxLomtj-OTeJD9kEVJRQAh2nMF1eshrCThTnIxGw&oe=69A9701A"}, {"file_name": "SCREEN2.png", "id": "978617513899687", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393554_978617517233020_2953324506008420345_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ef_ooBs0tSIQ7kNvwHDrE7e&_nc_oc=Adn5tasibOXsI9veddganSJRi4b_bckP24XlnQcJYcMylrc-sM0glD307bzmWVSItOU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuB1Q8lLb4TR1GXKAZQ3f4jfMmrE1c23zHmnqwbOzBy-A&oe=69A9642C"}, {"file_name": "SCREEN3.png", "id": "1164533248415008", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392163_1164533251748341_2374396971714818691_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M_4_NDb0wSkQ7kNvwG83Ti1&_nc_oc=AdmzT1RrRPLJlUX9YM-VZ5995zZRZdYelfaCO7UO2wTyT7XbQNSGKJuRnzuaH3VAaSo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftPILd_63fEcF6xtfqsAIvdL099yIsL8dOb_VotE9xWiQ&oe=69A98BA5"}, {"file_name": "SCREEN4.png", "id": "2375262309504937", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392005_2375262312838270_8915025067164246813_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ewinzhBa3hAQ7kNvwHSS_aX&_nc_oc=Adn2s8wVv1T_zOSfBRt8WkeVtZVC1moSq_9UPjX_nHdcLpcvsj-FUsg22z3OGHRKSTQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvtK6m_FkK75Y9CyXaCqLlfzpEDZwDfOtQsaPHiHrPTfQ&oe=69A997D3"}, {"file_name": "SCREEN5.png", "id": "482447744799251", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393584_482447748132584_7290716402068684415_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t1XopNLaJgUQ7kNvwH5SpnX&_nc_oc=AdnIFNkfOlzFtauqCbt5AzhoKF1Jec9BGCv6Ev4QB_oH5HM91paAPYEj7Q8FZuspo3E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afv7fm7YckkecNGCTsGILgdDCZG2xceBqeoXsUWLGxFWQQ&oe=69A98F10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "491151787396549", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_491151790729882_4737948214887056122_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PjlYvRqWyXwQ7kNvwGnmouj&_nc_oc=AdmPhOzz5L4g6c3G5fAKydC6lESNtuVOqOSVSC1VXqv9hvIv6UkjUssXBUfOYo2BuWM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftlGAfnUas6CrhhbiLd8kMjC6Z9TsaIp3BQ1Iqa76E5qw&oe=69A97253"}, "display_name": "Panda Boxing", "keywords": ["boxing", "fighting", "thrillofthefight", "animal", "action"], "long_description": "Step into a boxing ring and face off against the most fierce, unexpected opponent, an unstoppable fighting panda! In Panda Boxing, there are no rules, no referees, and no mercy. It\u2019s just you, your fists, and a wild, fast-paced brawl against a panda that doesn\u2019t hold back.\n\n\ud83e\udd4a\ud83d\udc3c\ud83d\udd25\nDodge, punch, and survive as the panda unleashes relentless attacks. Stay on your feet and keep up with the intensity, or risk getting knocked out. Use the environment to your advantage. Look for items scattered around the ring to aid in battle. Smash open boxes to recover health which could turn the fight in your favor.\n\n\ud83e\udd4a Personalize your fight style by customizing your boxing gloves with different designs. Will you go for patriotic fists or gorilla head ?\n\n\ud83e\udd4a Do you have what it takes to go toe-to-toe with a powerhouse panda in an all-out, no-holds-barred brawl? Put on your VR headset, step into the ring, and find out! This isn\u2019t just boxing\u2014this is Panda Boxing! \n\ud83e\udd4a\ud83d\udc3c\ud83d\udd25", "short_description": "Step into a boxing ring and face off against the most fierce, unexpected opponent, an unstoppable fighting panda! In Panda Boxing, there are no rules, no referees, and no mercy. It\u2019s just you, your fists, and a wild, fast-paced brawl against a panda that doesn\u2019t hold back."}]}, "developer_name": "TRAINDZ GAMING", "developer_privacy_policy_url": "https://www.biims.net/pandaboxingvr", "developer_terms_of_service_url": null, "publisher_name": "TRAINDZ GAMING", "support_website_url": null, "website_url": "https://www.biims.net/pandaboxingvr", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28388474484129315"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1411669680183743"}, {"status": "PUBLISHED", "id": "660069433583213"}, {"status": "PUBLISHED", "id": "2363480414027300"}]}, "baseline_offer": {"id": "2363480414027300"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1746817200, "status": "PUBLISHED", "id": "141166968018374
b=1-7&_nc_sid=6e7a0a&_nc_ohc=dOBSdDYzkxQQ7kNvwHmDa3d&_nc_oc=AdrJMZ-4ndU3yaYF_PgblURCWqltHbDai69q4eUFlEBybEWlO86dpd6-YsiwMKPeb_4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_VdIv3RDsdIRPQK7M_dpc5KHohexefVjovGpsjDiFMKQ&oe=6A296D25"}, {"file_name": "SCREEN4.png", "id": "2375262309504937", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392005_2375262312838270_8915025067164246813_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2dg5wgQCoJUQ7kNvwFFdhhF&_nc_oc=Ado0DGcM2V9f93kgPSZ7mf_vPuA57lnWop7i8Y8LdTkafu_GIhkml7G_CMDWu4lfmJs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af94z-8hyH2LsUtx6udLRJRvdbGDr1xamaEIv1ltPyHq0w&oe=6A297953"}, {"file_name": "SCREEN5.png", "id": "482447744799251", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393584_482447748132584_7290716402068684415_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gx_8bu4PIp4Q7kNvwH3-afE&_nc_oc=AdpSw5q8gRxRKFbheNoen0HZl_PEIFvOJS8yzEiqaedkgj0Q--13SvYsJRpnB0-2Tv4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8NqFAUv-AWuvTQaDvwqlcIuI3QBoPSlernqjsDfv_H2g&oe=6A297090"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "491151787396549", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391958_491151790729882_4737948214887056122_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QNcpTEdJ6CAQ7kNvwGfxdhn&_nc_oc=Adoel7QB6HaetD4I83wWHF2tK9K8_qQHMk0HrwQ8szeMwvXokpO1qbu-AjW11irRnQ0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9pGbpP-sfHtztA59J_EexMCrJ66GrOXf4FrDY2mTpuTg&oe=6A2953D3"}, "display_name": "Panda Boxing", "keywords": ["boxing", "fighting", "thrillofthefight", "animal", "action"], "long_description": "Step into a boxing ring and face off against the most fierce, unexpected opponent, an unstoppable fighting panda! In Panda Boxing, there are no rules, no referees, and no mercy. It\u2019s just you, your fists, and a wild, fast-paced brawl against a panda that doesn\u2019t hold back.\n\n\ud83e\udd4a\ud83d\udc3c\ud83d\udd25\nDodge, punch, and survive as the panda unleashes relentless attacks. Stay on your feet and keep up with the intensity, or risk getting knocked out. Use the environment to your advantage. Look for items scattered around the ring to aid in battle. Smash open boxes to recover health which could turn the fight in your favor.\n\n\ud83e\udd4a Personalize your fight style by customizing your boxing gloves with different designs. Will you go for patriotic fists or gorilla head ?\n\n\ud83e\udd4a Do you have what it takes to go toe-to-toe with a powerhouse panda in an all-out, no-holds-barred brawl? Put on your VR headset, step into the ring, and find out! This isn\u2019t just boxing\u2014this is Panda Boxing! \n\ud83e\udd4a\ud83d\udc3c\ud83d\udd25", "short_description": "Step into a boxing ring and face off against the most fierce, unexpected opponent, an unstoppable fighting panda! In Panda Boxing, there are no rules, no referees, and no mercy. It\u2019s just you, your fists, and a wild, fast-paced brawl against a panda that doesn\u2019t hold back."}]}, "developer_name": "TRAINDZ GAMING", "developer_privacy_policy_url": "https://www.biims.net/pandaboxingvr", "developer_terms_of_service_url": null, "publisher_name": "TRAINDZ GAMING", "support_website_url": null, "website_url": "https://www.biims.net/pandaboxingvr", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "suppo
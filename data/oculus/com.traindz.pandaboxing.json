E.png", "id": "438281299307192", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391911_438281302640525_7773953931045204998_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ycVtqS_EXekQ7kNvwEY3E_f&_nc_oc=AdmssZlHkIFbtSr3X12s01pYJvzNDMSR51AJ8uxykSIYx5iJXkjCvQ7ckp9CyqjFzMU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwwCLYtxvELlDSV6u9at-fKSjNjUdl5V_GNtFZyRkyrJw&oe=69BD35C1"}]}, "id": "1843795216451687", "locale": "en_US", "screenshots": [{"file_name": "SCREEN1.png", "id": "632164966277418", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391959_632164969610751_8651399017216663741_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h3vQodQzRSUQ7kNvwHUN1RZ&_nc_oc=Adm_G9_AexpkQAogfiz7DTWTKAXbCrRzsnF_3Ad8QWNmDLqd550VdUskDuoBvzmvOpE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzcR_R5T-snUS0oly71cK15KbxDLhhbiGabmIN9FDFTIA&oe=69BD369A"}, {"file_name": "SCREEN2.png", "id": "978617513899687", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393554_978617517233020_2953324506008420345_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IYSWcFLQ16oQ7kNvwGcnL6Q&_nc_oc=AdmMEZGf5C72yJuCqMnJ2shFiqoI62lhX6fFnYqugM78uBYMYNnFe5_L3nkIzKZeX90&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzAZq8W5z3_sTPLOKvUMGPcWeBv9J9e6Je2mbve-JEXmA&oe=69BD2AAC"}, {"file_name": "SCREEN3.png", "id": "1164533248415008", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392163_1164533251748341_2374396971714818691_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NA_UJJ4EJuMQ7kNvwHAmKta&_nc_oc=AdkTC84G-pitDKQh39wHxrH9U-h6NSlxskRyrFmjZcPP8Uq3t1h4_U4O4c_aWsfbBq8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy9ut8zNtx1rA5DpNJO5gBF9bHrbdQEZeB_HiqkG3iPIA&oe=69BD5225"}, {"file_name": "SCREEN4.png", "id": "2375262309504937", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473392005_2375262312838270_8915025067164246813_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mhEfTUOxDtcQ7kNvwHhoeIo&_nc_oc=AdnTX28LrklK77_zuQjD_GLxNMS-eYq93CBSpse13TXgKk0KhU7E7NxyHxK1_gBvecI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxrN8h2sZpsa_Jkw4fIzd3vnB_mMyfEUTJI1h04xdfLAA&oe=69BD5E53"}, {"file_name": "SCREEN5.png", "id": "482447744799251", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393584_482447748132584_7290716402068684415_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DXvBUJaXu4sQ7kNvwEUG539&_nc_oc=AdnsCCaJ_v2pcRMJUvMfYUrqhwl6bXtMc_4kKiQ0pemzUE445Mjqxw-FCDjYZtH6PU8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwVSKAXIxOZKR32NB_RFEYp-NV9EFYjZQU-FLKTQe2sJg&oe=69BD5590"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "491151787396549", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391958_491151790729882_4737948214887056122_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hq2A7-4dT6cQ7kNvwHQwGg6&_nc_oc=AdnrRvmN0MOXJUv-nTmxMlOeoyUxt5JJn3kNfdoL6oyjGOrpAcqINRC6hOJ7l1k0uFA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzNggKRHQsa5sg5oD_55iacAAbKiVoFJiQDtePZXwaWUg&oe=69BD38D3"}, "display_name": "Panda Boxing", "keywords": ["boxing", "fighting", "thrillofthefight", "animal", "action"], "long_description": "Step into a boxing ring and face off against the most fierce, unexpected opponent, an unstoppable fighting panda! In Panda Boxing, there are no rules, no referees, and no mercy. It\u2019s just you, your fists, and a wild, fast-paced brawl against a panda that doesn\u2019t hold back.\n\n\ud83e\udd4a\ud83d\udc3c\ud83d\udd25\nDodge, punch, and survive as the panda unleashes relentless attacks. Stay on your feet and keep up with the intensity, or risk getting knocked out. Use the environment to your advantage. Look for items scattered around the ring to aid in battle. Smash open boxes to recover health which could turn the fight in your favor.\n\n\ud83e\udd4a Personalize your fight style by customizing your boxing gloves with different designs. Will you go for patriotic fists or gorilla head ?\n\n\ud83e\udd4a Do you have what it takes to go toe-to-toe with a powerhouse panda in an all-out, no-holds-barred brawl? Put on your VR headset, step into the ring, and find out! This isn\u2019t just boxing\u2014this is Panda Boxing! \n\ud83e\udd4a\ud83d\udc3c\ud83d\udd25", "short_description": "Step into a boxing ring and face off against the most fierce, unexpected opponent, an unstoppable fighting panda! In Panda Boxing, there are no rules, no referees, and no mercy. It\u2019s just you, your fists, and a wild, fast-paced brawl against a panda that doesn\u2019t hold back."}]}, "developer_name": "TRAINDZ GAMING", "developer_privacy_policy_url": "https://www.biims.net/pandaboxingvr", "developer_terms_of_service_url": null, "publisher_name": "TRAINDZ GAMING", "support_website_url": null, "website_url": "https://www.biims.net/pandaboxingvr", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28388474484129315"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1411669680183743"}, {"status": "PUBLISHED", "id": "660069433583213"}, {"status": "PUBLISHED", "id": "2363480414027300"}]}, "baseline_offer": {"id": "2363480414027300"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1746817200, "status": "PUBLISHED", "id": "141166968018374
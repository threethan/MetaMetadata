_AQRiI8BkuyqRq5LKjLdOctYo4l6BgHDwV2Rkj5KrBPm1TA&oe=6B0B26AC"}, {"file_name": "SCREEN3.png", "id": "1164533248415008", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392163_1164533251748341_2374396971714818691_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TKdzqi1eT9UQ7kNvwHHFVzp&_nc_oc=AdqKT3jOhjsYOgql5uK_RbmAYLR91DQAAzD0dxIZ-DbOy8iCVh5OU-j-jFv1hnUFLj4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQStOWuKzdDyrw5xPLLpcC_XIAiMMAxg_5nYSYcgC0PMUw&oe=6B0B15E5"}, {"file_name": "SCREEN4.png", "id": "2375262309504937", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392005_2375262312838270_8915025067164246813_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0XLcBEJhu5YQ7kNvwHhaI5Y&_nc_oc=AdoXcozPf25SUw4ULu5ztu2mOBL8PgHcFqtTsMjpyMK09c7V8hBLxQFtXuVlyl-rSBo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTtLf-8gjzUwlCApB_iyP8dDZkSoZjKC0Klmqa5QiTSdA&oe=6B0B2213"}, {"file_name": "SCREEN5.png", "id": "482447744799251", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393584_482447748132584_7290716402068684415_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PqzZXZsp-3AQ7kNvwF8fDN7&_nc_oc=AdoonODZ5yYv9dagY5wBGUixzRrtsSVc7PbNWdUMAnIZzkTE8woVYiXS6muKZ6grhfA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT1g01e3Qxlw4IAQlUHocJ3Yt0aEC6iA4ZY2tO65FMW7w&oe=6B0B1950"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "491151787396549", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391958_491151790729882_4737948214887056122_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ZcwHPnUfPcQ7kNvwFUHo9x&_nc_oc=AdoHoifNu8qV6ji09bkrwwFdo_UjZyoAl2pjRBCpb7jmgkXhQRYSbTpz8-hqxyfyYxw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ4vnOIBAxH5giw2_eAU83iqijqtbZrTmYJWIugVKbUYg&oe=6B0B34D3"}, "display_name": "Panda Boxing", "keywords": ["boxing", "fighting", "thrillofthefight", "animal", "action"], "long_description": "Step into a boxing ring and face off against the most fierce, unexpected opponent, an unstoppable fighting panda! In Panda Boxing, there are no rules, no referees, and no mercy. It\u2019s just you, your fists, and a wild, fast-paced brawl against a panda that doesn\u2019t hold back.\n\n\ud83e\udd4a\ud83d\udc3c\ud83d\udd25\nDodge, punch, and survive as the panda unleashes relentless attacks. Stay on your feet and keep up with the intensity, or risk getting knocked out. Use the environment to your advantage. Look for items scattered around the ring to aid in battle. Smash open boxes to recover health which could turn the fight in your favor.\n\n\ud83e\udd4a Personalize your fight style by customizing your boxing gloves with different designs. Will you go for patriotic fists or gorilla head ?\n\n\ud83e\udd4a Do you have what it takes to go toe-to-toe with a powerhouse panda in an all-out, no-holds-barred brawl? Put on your VR headset, step into the ring, and find out! This isn\u2019t just boxing\u2014this is Panda Boxing! \n\ud83e\udd4a\ud83d\udc3c\ud83d\udd25", "short_description": "Step into a boxing ring and face off against the most fierce, unexpected opponent, an unstoppable fighting panda! In Panda Boxing, there are no rules, no referees, and no mercy. It\u2019s just you, your fists, and a wild, fast-paced brawl against a panda that doesn\u2019t hold back."}]}, "developer_name": "TRAINDZ GAMING", "developer_privacy_policy_url": "https://www.biims.net/pandaboxingvr", "developer_terms_of_service_url": null, "publisher_name": "TRAINDZ GAMING", "support_website_url": null, "website_url": "https://www.biims.net/pandaboxingvr", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "459781504968480"}], "external_subscription_
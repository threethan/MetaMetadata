_AQWxNCvfPYcSKEVF-A9bmPLqAlF29zOzg12XxIRn2DLO3w&oe=6B0F1B2C"}, {"file_name": "SCREEN3.png", "id": "1164533248415008", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392163_1164533251748341_2374396971714818691_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WhJu3E5m-0cQ7kNvwFbonlK&_nc_oc=Adr9uI5IljYxfHdfLqdASKBstPsJ4k3xTUWGJDDp-XjBSQi9ukTBlObNxDT5DbQiSI4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWmnyyUqj6ppgBi2fVEi6k3d7sUwmKodzP-AEnKDIQzlg&oe=6B0F0A65"}, {"file_name": "SCREEN4.png", "id": "2375262309504937", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392005_2375262312838270_8915025067164246813_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V7s0Z6Si3rYQ7kNvwGxwj5f&_nc_oc=AdoPr8YYtUr-ksdvufD5utLReoRAGhle4fGoD9p7XA-oyVYLP_t5WqQAggMenxsXQko&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVcOr7lWJC7Qd7PErr9kDxVDHdLZH08KYt5jLTLhOTw8A&oe=6B0F1693"}, {"file_name": "SCREEN5.png", "id": "482447744799251", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393584_482447748132584_7290716402068684415_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NBICixTIWU8Q7kNvwHsfbg9&_nc_oc=Adp6RuokR9VPacpDHT0T8KzSMminYLanKXvhjqF3dM6bbER5f-9m2qlWQ_0D96IvRYg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVZbchp0ykjB3XxYC7h_PTmY7XifRQy5Ee3czQzISP2xA&oe=6B0F0DD0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "491151787396549", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391958_491151790729882_4737948214887056122_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Zfe5rkfAm0Q7kNvwFxtCFF&_nc_oc=Adr8cTn7KvIv3ZSeI5cA2fmNBaSDTm3hj0uqmao3cFumqZJKY2BLuiva0OZVk-zdcaI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUW7XgLyFWfs98JYBmgLk6kOgJCvO45icx4GYb9Dq6qrQ&oe=6B0EF113"}, "display_name": "Panda Boxing", "keywords": ["boxing", "fighting", "thrillofthefight", "animal", "action"], "long_description": "Step into a boxing ring and face off against the most fierce, unexpected opponent, an unstoppable fighting panda! In Panda Boxing, there are no rules, no referees, and no mercy. It\u2019s just you, your fists, and a wild, fast-paced brawl against a panda that doesn\u2019t hold back.\n\n\ud83e\udd4a\ud83d\udc3c\ud83d\udd25\nDodge, punch, and survive as the panda unleashes relentless attacks. Stay on your feet and keep up with the intensity, or risk getting knocked out. Use the environment to your advantage. Look for items scattered around the ring to aid in battle. Smash open boxes to recover health which could turn the fight in your favor.\n\n\ud83e\udd4a Personalize your fight style by customizing your boxing gloves with different designs. Will you go for patriotic fists or gorilla head ?\n\n\ud83e\udd4a Do you have what it takes to go toe-to-toe with a powerhouse panda in an all-out, no-holds-barred brawl? Put on your VR headset, step into the ring, and find out! This isn\u2019t just boxing\u2014this is Panda Boxing! \n\ud83e\udd4a\ud83d\udc3c\ud83d\udd25", "short_description": "Step into a boxing ring and face off against the most fierce, unexpected opponent, an unstoppable fighting panda! In Panda Boxing, there are no rules, no referees, and no mercy. It\u2019s just you, your fists, and a wild, fast-paced brawl against a panda that doesn\u2019t hold back."}]}, "developer_name": "TRAINDZ GAMING", "developer_privacy_policy_url": "https://www.biims.net/pandaboxingvr", "developer_terms_of_service_url": null, "publisher_name": "TRAINDZ GAMING", "support_website_url": null, "website_url": "https://www.biims.net/pandaboxingvr", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "459781504968480"}], "external_subscription_
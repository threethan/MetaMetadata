E.png", "id": "438281299307192", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391911_438281302640525_7773953931045204998_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qot2vtrEt90Q7kNvwHgXg_l&_nc_oc=Adl8DMY5T8wR3Q1xln577E6FdeBm0XM43-MkN9loVPbbaUN9EnIA-gMRBUWO-p0b2I4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfysCm-jfTxFDfhWCnGroNt3nVly1D2arLJESQVVRwFLOA&oe=69B94141"}]}, "id": "1843795216451687", "locale": "en_US", "screenshots": [{"file_name": "SCREEN1.png", "id": "632164966277418", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391959_632164969610751_8651399017216663741_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SfcLhUqumGMQ7kNvwE-k5zS&_nc_oc=AdnqZYqsVHGS1_0Lb1dcSQw9PfOymnMmBCmN-aqO4CpK8PwTee0HhBgp6vkVdyOuHJQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxnZzdPPN7QaC4sdO0J041kH0dYBKrWBfVEGAVUNa9f5A&oe=69B9421A"}, {"file_name": "SCREEN2.png", "id": "978617513899687", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393554_978617517233020_2953324506008420345_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RWwdxNWYaWMQ7kNvwHfkvh7&_nc_oc=Adkz79AH3K7_cnO0_DmMf7OEZW3-QqcWQg1_CQAyGDz2CJmgh1FYdtIBSUgai3YE4Yg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyJ0d1nu6nv4G9xxXZ_093ujS0YCK80ASvLetGwFzxDHg&oe=69B9362C"}, {"file_name": "SCREEN3.png", "id": "1164533248415008", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392163_1164533251748341_2374396971714818691_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mHLIbZ2ksl8Q7kNvwF54QcA&_nc_oc=AdlUDINfO2MpYmFw9RC23mW107dt37sV28dJnraqtH1YgJcF-pLmwGbRl1G4suHlZ3A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afzv6wxFsKHG_0kSnmUF1Qc2wvEwIKKCM3V2GDVotIDffg&oe=69B95DA5"}, {"file_name": "SCREEN4.png", "id": "2375262309504937", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392005_2375262312838270_8915025067164246813_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3zTZeQ_3Lj0Q7kNvwFHCVTc&_nc_oc=AdmIWF3Ax0h867aa1TFpgd1QZTmNZ7oZtueGxENwnhlM4Rr1usurobdmh72L44bg6pM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwsppX6A_sJIhxYYM5q7i6I1ukzaXPuVICtugAyn3rphw&oe=69B93193"}, {"file_name": "SCREEN5.png", "id": "482447744799251", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393584_482447748132584_7290716402068684415_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HCH-VtlA55YQ7kNvwE96227&_nc_oc=Adm9yHpy59JLPSSv6b7tl8_Vy7A8tAVpKaQY07hieUlbRxImC01uen9yLxOgyezDdsI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxCV1Z1oRtDVtyXpiC6JmvrNZ7Am4bTOlkfzQrw7DGECg&oe=69B96110"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "491151787396549", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391958_491151790729882_4737948214887056122_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EfyykT4SoDMQ7kNvwG4VPCM&_nc_oc=AdnZIVAfpCYUBQIpCYspNi7zDY4m60HiA-roIoiF6OUOQ2xJ4QTTUw5ncmrmNKwk57Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw82cARhQTOhHaZ3z3bo6hvJEA9dCht7cnEBf3_hdZ_Vw&oe=69B94453"}, "display_name": "Panda Boxing", "keywords": ["boxing", "fighting", "thrillofthefight", "animal", "action"], "long_description": "Step into a boxing ring and face off against the most fierce, unexpected opponent, an unstoppable fighting panda! In Panda Boxing, there are no rules, no referees, and no mercy. It\u2019s just you, your fists, and a wild, fast-paced brawl against a panda that doesn\u2019t hold back.\n\n\ud83e\udd4a\ud83d\udc3c\ud83d\udd25\nDodge, punch, and survive as the panda unleashes relentless attacks. Stay on your feet and keep up with the intensity, or risk getting knocked out. Use the environment to your advantage. Look for items scattered around the ring to aid in battle. Smash open boxes to recover health which could turn the fight in your favor.\n\n\ud83e\udd4a Personalize your fight style by customizing your boxing gloves with different designs. Will you go for patriotic fists or gorilla head ?\n\n\ud83e\udd4a Do you have what it takes to go toe-to-toe with a powerhouse panda in an all-out, no-holds-barred brawl? Put on your VR headset, step into the ring, and find out! This isn\u2019t just boxing\u2014this is Panda Boxing! \n\ud83e\udd4a\ud83d\udc3c\ud83d\udd25", "short_description": "Step into a boxing ring and face off against the most fierce, unexpected opponent, an unstoppable fighting panda! In Panda Boxing, there are no rules, no referees, and no mercy. It\u2019s just you, your fists, and a wild, fast-paced brawl against a panda that doesn\u2019t hold back."}]}, "developer_name": "TRAINDZ GAMING", "developer_privacy_policy_url": "https://www.biims.net/pandaboxingvr", "developer_terms_of_service_url": null, "publisher_name": "TRAINDZ GAMING", "support_website_url": null, "website_url": "https://www.biims.net/pandaboxingvr", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28388474484129315"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1411669680183743"}, {"status": "PUBLISHED", "id": "660069433583213"}, {"status": "PUBLISHED", "id": "2363480414027300"}]}, "baseline_offer": {"id": "2363480414027300"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1746817200, "status": "PUBLISHED", "id": "141166968018374
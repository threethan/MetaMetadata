ontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392163_1164533251748341_2374396971714818691_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=94tkAk7HQWoQ7kNvwGQplDI&_nc_oc=Adr7lquEGfTgpiPXbq9Ka5Qbdqf2jGpCvhI0M-2MJDHz3em-pndeVFKjkIpLpLytOf0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTEwBZoOWU7MtNg3zqcIVFxfR50rvD_k73c2H4FPC-xbA&oe=6B072165"}, {"file_name": "SCREEN4.png", "id": "2375262309504937", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392005_2375262312838270_8915025067164246813_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TjEANAQXbXMQ7kNvwHlYXoj&_nc_oc=AdrgokTpUBqz2j4CcrIjoQekLE0Cn1hV5gT_CD5MvDv15kDCH2JwZECW82foSDxexEs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_H5g2OM0vDjshKKgbGgfPjfcq5waTrYdXPNycrS756A&oe=6B06F553"}, {"file_name": "SCREEN5.png", "id": "482447744799251", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393584_482447748132584_7290716402068684415_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_CxYdhj2HkQQ7kNvwFb9Hjb&_nc_oc=AdrEv_k3v6KGRaEI8YHqi1Nu9v3l3t_-k4rKI7Y62s866rHysTanRX1T9TTnzeMdCv4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwz9tixqLbGjpoYT1rx34CfUkMDSbrbP3mrgqJF_Z4dg&oe=6B0724D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "491151787396549", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391958_491151790729882_4737948214887056122_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qyNzjFtWbC4Q7kNvwG-7g-Z&_nc_oc=Adq24OkPxrR8kPxUCdNwTdLKn4WnNhNVKq2-0AmhPVi8A6LbOyfQNTuS6YFmdostpKA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKeKZnCwMywGKtuJzsdeHW3DxJzBzUyhL7mnLzUXM6lQ&oe=6B070813"}, "display_name": "Panda Boxing", "keywords": ["boxing", "fighting", "thrillofthefight", "animal", "action"], "long_description": "Step into a boxing ring and face off against the most fierce, unexpected opponent, an unstoppable fighting panda! In Panda Boxing, there are no rules, no referees, and no mercy. It\u2019s just you, your fists, and a wild, fast-paced brawl against a panda that doesn\u2019t hold back.\n\n\ud83e\udd4a\ud83d\udc3c\ud83d\udd25\nDodge, punch, and survive as the panda unleashes relentless attacks. Stay on your feet and keep up with the intensity, or risk getting knocked out. Use the environment to your advantage. Look for items scattered around the ring to aid in battle. Smash open boxes to recover health which could turn the fight in your favor.\n\n\ud83e\udd4a Personalize your fight style by customizing your boxing gloves with different designs. Will you go for patriotic fists or gorilla head ?\n\n\ud83e\udd4a Do you have what it takes to go toe-to-toe with a powerhouse panda in an all-out, no-holds-barred brawl? Put on your VR headset, step into the ring, and find out! This isn\u2019t just boxing\u2014this is Panda Boxing! \n\ud83e\udd4a\ud83d\udc3c\ud83d\udd25", "short_description": "Step into a boxing ring and face off against the most fierce, unexpected opponent, an unstoppable fighting panda! In Panda Boxing, there are no rules, no referees, and no mercy. It\u2019s just you, your fists, and a wild, fast-paced brawl against a panda that doesn\u2019t hold back."}]}, "developer_name": "TRAINDZ GAMING", "developer_privacy_policy_url": "https://www.biims.net/pandaboxingvr", "developer_terms_of_service_url": null, "publisher_name": "TRAINDZ GAMING", "support_website_url": null, "website_url": "https://www.biims.net/pandaboxingvr", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recomme
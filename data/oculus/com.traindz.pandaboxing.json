E.png", "id": "438281299307192", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391911_438281302640525_7773953931045204998_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qot2vtrEt90Q7kNvwF9WhF6&_nc_oc=AdnIRPGzvMYRSDgOVNRKq5KFmpDCh0sAKkbzXkuYQzQd-JwTQeIPBcKFyUt6vaYsJPY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzBC6SEaKfBTbIE1eEqaflLxGmdXtvWpk1L91U6xW1efg&oe=69BA92C1"}]}, "id": "1843795216451687", "locale": "en_US", "screenshots": [{"file_name": "SCREEN1.png", "id": "632164966277418", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391959_632164969610751_8651399017216663741_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h3vQodQzRSUQ7kNvwHT1HQb&_nc_oc=AdnMyElt4vFPessXmx4GHflggO5bIEo0zrR9WBNSTu1gpBVu9A-GDMMF6Os4OvjIO0A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxaBz54XvwWb6oyqw32bJxZwjPN6Vdky44CyO0cKso0wg&oe=69BA939A"}, {"file_name": "SCREEN2.png", "id": "978617513899687", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393554_978617517233020_2953324506008420345_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RWwdxNWYaWMQ7kNvwHCA5ly&_nc_oc=AdmrxPafT9U_az3HtH2_oOTXe_tLmIFYbvaOG-LrwzqrSf7P_peiaeElfL21iLWRzM8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzZSaUeG43B8PpUvY0bJR5I1uniqTnJPLTMprmWMrzKtQ&oe=69BA87AC"}, {"file_name": "SCREEN3.png", "id": "1164533248415008", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392163_1164533251748341_2374396971714818691_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mHLIbZ2ksl8Q7kNvwH9bjyu&_nc_oc=Adl8JuhFV086AoVxNs2Eclv5S_iTUAWo2dVAcyZEooFJ9Ma4qB0PnGSlfvICerqTgII&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxuE1CAinPdm9RmInLBysa9MMDRxKGCA2QBsj7NAEIhjg&oe=69BAAF25"}, {"file_name": "SCREEN4.png", "id": "2375262309504937", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392005_2375262312838270_8915025067164246813_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3zTZeQ_3Lj0Q7kNvwH4yHh6&_nc_oc=AdlMA2vMsCJUV3t8Jo9ksU89RD_ZcoOUa0_DCceaI4IjyIPuoDvuIUBi6kQt6icQHbI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxIVQ0-Ic3htCYwMweuFLG1Ug6B-wctKSJzfi2ty_3V1g&oe=69BA8313"}, {"file_name": "SCREEN5.png", "id": "482447744799251", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393584_482447748132584_7290716402068684415_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HCH-VtlA55YQ7kNvwGmdZoe&_nc_oc=Adl-b5oUDlGJ0y7hg0-aa-6_re1ewgXi7HfoJ5osovhnkd0Ag2Sq5e_bdgEr9-Tf5LA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afwrji-ev1j_p9pDGWLSjaW9C6BoHsmFOw0NlPl5ZPJZjg&oe=69BAB290"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "491151787396549", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391958_491151790729882_4737948214887056122_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EfyykT4SoDMQ7kNvwHFj5Jv&_nc_oc=Adl7UJt8DSCy7dRw7MSjZsTA4BqoIKmLU9EH4vvP05T2gcmubE7LXSBinpgWWLBUa74&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwiSXyv2iKtNwM2N7KVLH-vXwEanVio7-Tp7CLPElRZjQ&oe=69BA95D3"}, "display_name": "Panda Boxing", "keywords": ["boxing", "fighting", "thrillofthefight", "animal", "action"], "long_description": "Step into a boxing ring and face off against the most fierce, unexpected opponent, an unstoppable fighting panda! In Panda Boxing, there are no rules, no referees, and no mercy. It\u2019s just you, your fists, and a wild, fast-paced brawl against a panda that doesn\u2019t hold back.\n\n\ud83e\udd4a\ud83d\udc3c\ud83d\udd25\nDodge, punch, and survive as the panda unleashes relentless attacks. Stay on your feet and keep up with the intensity, or risk getting knocked out. Use the environment to your advantage. Look for items scattered around the ring to aid in battle. Smash open boxes to recover health which could turn the fight in your favor.\n\n\ud83e\udd4a Personalize your fight style by customizing your boxing gloves with different designs. Will you go for patriotic fists or gorilla head ?\n\n\ud83e\udd4a Do you have what it takes to go toe-to-toe with a powerhouse panda in an all-out, no-holds-barred brawl? Put on your VR headset, step into the ring, and find out! This isn\u2019t just boxing\u2014this is Panda Boxing! \n\ud83e\udd4a\ud83d\udc3c\ud83d\udd25", "short_description": "Step into a boxing ring and face off against the most fierce, unexpected opponent, an unstoppable fighting panda! In Panda Boxing, there are no rules, no referees, and no mercy. It\u2019s just you, your fists, and a wild, fast-paced brawl against a panda that doesn\u2019t hold back."}]}, "developer_name": "TRAINDZ GAMING", "developer_privacy_policy_url": "https://www.biims.net/pandaboxingvr", "developer_terms_of_service_url": null, "publisher_name": "TRAINDZ GAMING", "support_website_url": null, "website_url": "https://www.biims.net/pandaboxingvr", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28388474484129315"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1411669680183743"}, {"status": "PUBLISHED", "id": "660069433583213"}, {"status": "PUBLISHED", "id": "2363480414027300"}]}, "baseline_offer": {"id": "2363480414027300"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1746817200, "status": "PUBLISHED", "id": "141166968018374
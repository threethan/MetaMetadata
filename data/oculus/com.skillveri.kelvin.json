KXnBlvVSYhnRelZvGIVoqWRY3GAlxkF0Ko1ojmGAi6OMHg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Su8UKPlQ9Pvrp9jlyCyuFuIACFaNycc71vQsRFIy4eg&oe=69E4BF44"}, {"file_name": "Gauge.png", "id": "5928683237217267", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974813_5928683240550600_263121794450703303_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7rV8zopzdxwQ7kNvwEzpz6H&_nc_oc=AdpetoNfBo8xzlNTrWZYPOoL6dXxgjWWsCEtdH3EcRrWzIJsjOTq8BQ_605xmyRgINk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Aqauabh5gKL-TwDvvNyx0TxDNDiHQMr6rbiy8EytGWw&oe=69E4C5C9"}, {"file_name": "RefFilling.png", "id": "1258784941701550", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974535_1258784945034883_909213723295103334_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cME2iY_GwPwQ7kNvwFx08u5&_nc_oc=Adqw6vuXCj5FHkSa1mT-ZzP95-uhlaKAIsL6cv3BwEBi9MbA5XA1N-AVFWDAT7sHWFc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3pe2VJTPXqfwSz2vkRFPnYpWapKaqGi5QUwiQDC4FHTg&oe=69E4BA16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt (7).png", "id": "915058696207937", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982688_915058699541270_3867657740977549359_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jEgbJwDo6L4Q7kNvwHMvVPl&_nc_oc=AdrWo1e4OdgmXOGJQwMU_IDs4qhD4NFHDdc0AjF24mmbwVhNKOsBPkxr_bkhvwjLC9o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af16hUJVUNuKnptS0C0hyB4KhMlPnWcxUH9M2u1fuiYv8A&oe=69E4D7E0"}, "display_name": "Skillveri Kelvin", "keywords": [], "long_description": "Skillveri Kelvin is a virtual reality simulation tool designed to train students and aspiring technicians in the field of HVAC equipment service. They can perform tasks like Leak test, Brazing, Vacuuming & Refrigerant Charging. Once you enter inside the application you can use the hand tracking feature to interact with the environment. Select the desired module and interact with the environment using your hands. Read the instructions from the board and follow the visual cues (arrows/markers) to perform the tasks. Directly pick up the tools from the table and interact with the HVAC machine based on the instructions to complete the tasks. Repeating the tasks till familiarization will help you learn the process better. Please note that this is currently an invite only product and you need a code to use this product. Request for an invite by mailing us at skillveri@skillveri.com. Invites and activation codes will be sent out based on the emails we receive. Note that this is a manual process and may take up to one to two days.", "short_description": "Skillveri Kelvin is a virtual reality simulation tool designed to train students and aspiring technicians in the field of HVAC equipments service. They can perform tasks like Leak test, Brazing, Vacuuming & Refrigerant Charging. Please note that this is currently an invite only product and you need a code to use this product. Request for an invite by mailing us at skillveri@skillveri.com. Invites and activation codes will be sent out based on the emails we receive. Note that this is a manual pro"}]}, "developer_name": "Skillveri Training Solutions Pvt Ltd", "developer_privacy_policy_url": "https://skillveri.in/skillveri-kelvin-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Skillveri Training Solutions Pvt Ltd", "support_website_url": null, "website_url": "https://skillveri.in/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_a
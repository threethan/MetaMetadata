7a0a&_nc_ohc=sPE6R6mNgsYQ7kNvwF19144&_nc_oc=AdoIBVXD4keV3JdI-OjFI5H-HaFl91V9aR3D3mKkGhJKiBEUZHE0QVdZZehI30BLdA8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6394yWuBH1u69WXryx7dm8iJJHJ1P35pE5ORE_d2Dpw&oe=6A9D69E0"}, "display_name": "Skillveri Kelvin", "keywords": [], "long_description": "Skillveri Kelvin is a virtual reality simulation tool designed to train students and aspiring technicians in the field of HVAC equipment service. They can perform tasks like Leak test, Brazing, Vacuuming & Refrigerant Charging. Once you enter inside the application you can use the hand tracking feature to interact with the environment. Select the desired module and interact with the environment using your hands. Read the instructions from the board and follow the visual cues (arrows/markers) to perform the tasks. Directly pick up the tools from the table and interact with the HVAC machine based on the instructions to complete the tasks. Repeating the tasks till familiarization will help you learn the process better. Please note that this is currently an invite only product and you need a code to use this product. Request for an invite by mailing us at skillveri@skillveri.com. Invites and activation codes will be sent out based on the emails we receive. Note that this is a manual process and may take up to one to two days.", "short_description": "Skillveri Kelvin is a virtual reality simulation tool designed to train students and aspiring technicians in the field of HVAC equipments service. They can perform tasks like Leak test, Brazing, Vacuuming & Refrigerant Charging. Please note that this is currently an invite only product and you need a code to use this product. Request for an invite by mailing us at skillveri@skillveri.com. Invites and activation codes will be sent out based on the emails we receive. Note that this is a manual pro"}]}, "developer_name": "Skillveri Training Solutions Pvt Ltd", "developer_privacy_policy_url": "https://skillveri.in/skillveri-kelvin-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Skillveri Training Solutions Pvt Ltd", "support_website_url": null, "website_url": "https://skillveri.in/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "746781267174675"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "135547386045786"}]}, "baseline_offer": {"id": "135547386045786"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1682049600, "status": "PUBLISHED", "id": "135547386045786"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26685752877691754", "version": "3.26012821"}, "id": "3027478377558572", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6731656153528055", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26685752877691754"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3027478377558572"}]}, "change_log": null, "created_date": 1769603696, "id": "26685752877691754", "version": "3.26012821", "version_code": 22, 
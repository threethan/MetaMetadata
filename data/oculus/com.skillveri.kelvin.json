ru7bek7KIrMJyNoAhWzx4SMT6w_W4iWeouZomackQ&oe=69F1EE44"}, {"file_name": "Gauge.png", "id": "5928683237217267", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974813_5928683240550600_263121794450703303_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VuGVJp3JNyIQ7kNvwH-eG6p&_nc_oc=AdpVMe6ElDn_VjvlM86AyG3XUMpvtDt2C11l1xP8XaE2lEgeDjKxeioLdN5kTiDFmFE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af1HQLqOqhmCTd6NJ6J_TjeB4rURkSwXgY4JBxLIbuQkIQ&oe=69F1F4C9"}, {"file_name": "RefFilling.png", "id": "1258784941701550", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974535_1258784945034883_909213723295103334_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=33msqJsMgl8Q7kNvwHR3_C-&_nc_oc=AdrJs9_fEQVmjZ4JOFo07lNpjyy0jPDvcxM8o7ByNr9_gDwWW4upi-M91gbOWbXggoY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0iJcAzUnDa6rOH9JOAI9-Z5tvJ3vzrAyACJB23yVCKBQ&oe=69F1E916"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt (7).png", "id": "915058696207937", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982688_915058699541270_3867657740977549359_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FxtW-QlNhG0Q7kNvwGPjn_1&_nc_oc=Adoi9xbTGoqrLqLM2W3Kfkjn9jkrpj2xdUQjTgHc3FQDlgYFebF74N0BcP6BO_sx0ms&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af22RXlTV7Qh8XjNcLRkZX5HgzrzNeECUNi6wPT8QbHZyw&oe=69F206E0"}, "display_name": "Skillveri Kelvin", "keywords": [], "long_description": "Skillveri Kelvin is a virtual reality simulation tool designed to train students and aspiring technicians in the field of HVAC equipment service. They can perform tasks like Leak test, Brazing, Vacuuming & Refrigerant Charging. Once you enter inside the application you can use the hand tracking feature to interact with the environment. Select the desired module and interact with the environment using your hands. Read the instructions from the board and follow the visual cues (arrows/markers) to perform the tasks. Directly pick up the tools from the table and interact with the HVAC machine based on the instructions to complete the tasks. Repeating the tasks till familiarization will help you learn the process better. Please note that this is currently an invite only product and you need a code to use this product. Request for an invite by mailing us at skillveri@skillveri.com. Invites and activation codes will be sent out based on the emails we receive. Note that this is a manual process and may take up to one to two days.", "short_description": "Skillveri Kelvin is a virtual reality simulation tool designed to train students and aspiring technicians in the field of HVAC equipments service. They can perform tasks like Leak test, Brazing, Vacuuming & Refrigerant Charging. Please note that this is currently an invite only product and you need a code to use this product. Request for an invite by mailing us at skillveri@skillveri.com. Invites and activation codes will be sent out based on the emails we receive. Note that this is a manual pro"}]}, "developer_name": "Skillveri Training Solutions Pvt Ltd", "developer_privacy_policy_url": "https://skillveri.in/skillveri-kelvin-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Skillveri Training Solutions Pvt Ltd", "support_website_url": null, "website_url": "https://skillveri.in/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "sup
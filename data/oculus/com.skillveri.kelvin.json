m/v/t64.5771-25/499619163_2137161520568880_3985119841862806111_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_05V2VQ9BqcQ7kNvwFKenSx&_nc_oc=AdrlyvQ6erENwnVEcpYwso6h-0mbA7BNibFS1W_ca6b8lKtfWFyRKAZWFWrvEjmzEgc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKN5ihOc03GEU2zYIGUbg2GjiOue9U2dleVRYswz_ucbQ&oe=6A9D8BE8"}, {"file_name": "hvac ent 4.png", "id": "1565538228301802", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623384_1565538234968468_6563678698502612621_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y5knGBBczVYQ7kNvwHX2CRE&_nc_oc=AdpLRzQT_FiKP1i2z3aZPwVXS8H0baba5uVDfRmcWH0pbMAgiWdYT8hwBGbE3WjI59k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIEZtEpDfP9NXsr3mTY4eu0lNddsXqqrNxfOpGt4C0TDA&oe=6A9D7DC6"}, {"file_name": "hvac ent 5.png", "id": "3072764232928271", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620530_3072764236261604_3770685632745080629_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qd2Lrm9ZVLUQ7kNvwE1Eg0d&_nc_oc=AdrEF8aWPC7Cj1fK0D8Y48FDKokKvKRyb2I0VMA3tH5WV2Dnn1J-N8yvDZV06-fmpCE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKzFz034tOdifvvd-6Bv_r3LLIAFZw_65tSbeigtgMphw&oe=6A9D5DA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "hvac enterprise thumbnail.png", "id": "1897612331377367", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622325_1897612334710700_7605301912565015639_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NfuDuOq8li4Q7kNvwHE_TWd&_nc_oc=Adq0HL9sgXjLiW45bduRUk0H0o3u2o_1-3i57Tsqp88hbd9u3yrZgMdXRbB477yTUeY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6F_mbQwyGmaMpgfBwjmvTKRfbpzxDJpWGZXsmQLPhEQ&oe=6A9D83EF"}, "display_name": "Skillveri HVAC Simulator-Enterprise", "keywords": ["skillveri", "hvac", "simulator", "vr", "cte"], "long_description": "Make your HVAC training step into the future with the Skillveri HVAC Simulator Enterprise edition.\n\nExperience a fully immersive training environment in advanced Mixed Reality which seamlessly blends virtual workpieces with your real surroundings. Inspect, repair, and maintain HVAC systems safely, repeatedly, without ever touching a live wire or wasting a single refrigerant canister.\n\nPerform all actions naturally with your hands, just as in the real world - no controllers needed!\n\nMake your trainees:\nPhysically operate HVAC components in 3D\nIdentify components in an expanded 360 degree 3D view\nMake mistakes safely - no risk, damaging equipment, or wasting money\nTrain on multiple equipment without physically installing them\nLearn at each one\u2019s own pace, pause and repeat whenever needed\n\nThe Skillveri HVAC simulator recreates realistic scenarios and guides learners through complex tasks easily with step by step instructions.\n\nThis Enterprise version includes:\n- Commercial HVAC cleaning\n- Residential HVAC\n- Leak Testing\n- Brazing\n- Vacuuming\n- R32 Charging\n- Blended Refrigerant Charging by weight\n- Compound Refrigerant Charging\n- Refrigerant Recovery\n\nReady to scale your training? To enable our HVAC simulator for your school or institution, contact us at usa@skillveri.com. Skillveri simulators are used by global industries and 100+ schools & colleges across the USA. Check out www.skillveri.com for more details.\nFor personal usage, check out Skillveri HVAC Simulator-Personal Use", "short_description": "Let your students master HVAC skills in immersive VR-no risk, no tools, no wastage. All actions done with hands, naturally as in real life - no VR controllers needed! Train anytime, anywhere. Build confidence in your trainees with realistic hands-on practice before stepping onto a job site.\n\nThis Enterprise edition covers cleaning, leak testing, brazing, vacuuming, refrigerant charging & recovery.\n\nTo enable our HVAC simulator for your institution\u2019s CTE training, write to us at usa@skillveri.com"}]}, "developer_name": "Skillveri Training Solutions Pvt Ltd", "developer_privacy_policy_url": "https://skillveri.com/skillveri-kelvin-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Skillveri Training Solutions Pvt Ltd", "support_website_url": null, "website_url": "https://skillveri.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28718963961037292"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/507823854_1707062483862778_6298613492813214851_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jMJDJRZ2YvgQ7kNvwGFRBj2&_nc_oc=Adp7HHk2ZLmPkPjw-oWJgBzDzPIbrBOsOQ3soY57pd746fEckSm86TmqmmC73rpIt-U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1XqsGiiJ_rA0whCiJEvQ2ZMBVahYLuvWMKJOd55oA9Q&oe=6A9D674F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Skillveri HVAC Simulator-Enterprise", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}], "release_date": 1682049600, "lastRevision": {"nodes": [{"id": "6731656156861388", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "6731656153528055", "is_first_party": false, "enables_in_app_ads": false, "is_
6zzQojYmB-75JlQ&oe=69A03144"}, {"file_name": "Gauge.png", "id": "5928683237217267", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974813_5928683240550600_263121794450703303_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dbTT9khcuAIQ7kNvwEG6O67&_nc_oc=AdnN5Pf8J7QeRGfhGEddv8Azv5_QchDWjMQ_wfeEp_Pdxkl6VCsx6FKxZ40tT4crops&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfumISjqah6aTv3RZ3hRlVS-fLNKEGmJQoFvwlA8KMVmlQ&oe=69A037C9"}, {"file_name": "RefFilling.png", "id": "1258784941701550", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974535_1258784945034883_909213723295103334_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DmO2Z0Yh06YQ7kNvwEtHpEF&_nc_oc=AdnkMWpIBXx_utm1jJP-GonAMMIunQTlO0vOsQbiXdRtIzyAaH3GWmCSnQHlsX0WTCg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuO6XYwEj_WPz0eAZSVixlSfUHRUB7SA_gdaQpBL-b0vQ&oe=69A02C16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt (7).png", "id": "915058696207937", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982688_915058699541270_3867657740977549359_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EMuP7dBkq6UQ7kNvwHno_Jc&_nc_oc=AdmSaL--aepfQIu-oOKx24qPXWBx-fXtAzh6MaRxN3X0DihakdKvNXqmeFZuCRKHvGM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvtdvJzEYfzqxMl5eARYEtrcZJJ9NpenUe1kmrtCL8Mjg&oe=69A049E0"}, "display_name": "Skillveri Kelvin", "keywords": [], "long_description": "Skillveri Kelvin is a virtual reality simulation tool designed to train students and aspiring technicians in the field of HVAC equipment service. They can perform tasks like Leak test, Brazing, Vacuuming & Refrigerant Charging. Once you enter inside the application you can use the hand tracking feature to interact with the environment. Select the desired module and interact with the environment using your hands. Read the instructions from the board and follow the visual cues (arrows/markers) to perform the tasks. Directly pick up the tools from the table and interact with the HVAC machine based on the instructions to complete the tasks. Repeating the tasks till familiarization will help you learn the process better. Please note that this is currently an invite only product and you need a code to use this product. Request for an invite by mailing us at skillveri@skillveri.com. Invites and activation codes will be sent out based on the emails we receive. Note that this is a manual process and may take up to one to two days.", "short_description": "Skillveri Kelvin is a virtual reality simulation tool designed to train students and aspiring technicians in the field of HVAC equipments service. They can perform tasks like Leak test, Brazing, Vacuuming & Refrigerant Charging. Please note that this is currently an invite only product and you need a code to use this product. Request for an invite by mailing us at skillveri@skillveri.com. Invites and activation codes will be sent out based on the emails we receive. Note that this is a manual pro"}]}, "developer_name": "Skillveri Training Solutions Pvt Ltd", "developer_privacy_policy_url": "https://skillveri.in/skillveri-kelvin-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Skillveri Training Solutions Pvt Ltd", "support_website_url": null, "website_url": "https://skillveri.in/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inter
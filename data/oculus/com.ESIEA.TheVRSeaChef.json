3924539659244_6872540824165978202_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=acUXhicJSIwQ7kNvwEnJmKp&_nc_oc=AdrYNDE-pIwIe_FdZ8Fk-zvrWYKMEP61PurPms2tMbkNPWJT8-jEs447BgG2WYNwqiM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgdNC_tAqWi38J3zo0FfFMjp5qFbMQr_v4ygf5vAzVug&oe=6AEB34A0"}, {"file_name": "Screenshot_6.png", "id": "1573465457837658", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823802_1573465464504324_2614353974622069702_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=933jrYBDLbIQ7kNvwFMu96u&_nc_oc=AdpPApXUCQybrywjHm3_75VVvxgdO0F2R56WYzNhj8QeszPfmTZU8Srd8tQD_WtNjeM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShLO_Tbj3-EdYt36CglQfkWXeaRg4JPj9LAPZbai1RSA&oe=6AEB3769"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image de pr\u00e9sentation.png", "id": "27546637765002679", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823296_27546637768336012_82709430732726836_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ggpW7kctVg4Q7kNvwFod0Qd&_nc_oc=AdoKQ8yWIAz3iDZVSf81KuEAGGPKoalqQxCuLO7ocxNutZAMn3cEALXdo_smf2eh_oM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRw2xuggKeq2ASURvIhsy9MkfQBihTJav01BdvRSVPUHw&oe=6AEB5BE7"}, "display_name": "AQUAFISH - VR Sea Chef", "keywords": ["AQUAFISH", "COOKING", "SEAFOOD"], "long_description": "VR Sea chef is a cooking game in collaboration with Aquafish 0.0 where you are on a stranded island and you, as a chef, need to feed an extremely hungry octopus\nPrepare his meals accordingly to his demands in only 5 minutes and keep pushing your score, try not to drop any food on the ground or your score will decrease\nwith over 50 different meals to prepare, explore all the possibilites with different ingr\u00e9dients straight from the ocean such as salmon, nori or sea cucumber and many more.", "short_description": "VR Sea chef is a cooking game in collaboration with Aquafish 0.0 where you are on a stranded island and you
3924539659244_6872540824165978202_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4x0DlZQ0AoYQ7kNvwHSzm_u&_nc_oc=AdoItdeUIX7XwZMaq4sSxPVcCTCtSDoPsZWbO-RfqPQiNduY8hlH8I4-ljypzsLOz7U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0w03W6LjhRkAZr7krIqt-7yoe1eHBTCfzOgPxtvi24w&oe=6AA55520"}, {"file_name": "Screenshot_6.png", "id": "1573465457837658", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823802_1573465464504324_2614353974622069702_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=orRLUy0pP0oQ7kNvwG4_EQA&_nc_oc=AdoduJLh1DAeH97bW7OVmkybXAgGa_WHh0u-wlk1-VBthUyGFzi7f5YxIqvaBv0WdJ4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqpVnQtStUBEVAtFSPihXpYd5aS1VNHzVO6p1yLxGVgg&oe=6AA557E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image de pr\u00e9sentation.png", "id": "27546637765002679", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823296_27546637768336012_82709430732726836_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fD_CMHY9g7IQ7kNvwGiHlf-&_nc_oc=AdpQdG251V9JupERoKL0wINOcwPJHXEkb1Nd9ht_B-308ueoXHPPmGFiiZmYHzVIxqE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLmalELby5gAGGLYoM01An3Yc3UV_X4PnZOyQcA9U3Y8g&oe=6AA54427"}, "display_name": "AQUAFISH - VR Sea Chef", "keywords": ["AQUAFISH", "COOKING", "SEAFOOD"], "long_description": "VR Sea chef is a cooking game in collaboration with Aquafish 0.0 where you are on a stranded island and you, as a chef, need to feed an extremely hungry octopus\nPrepare his meals accordingly to his demands in only 5 minutes and keep pushing your score, try not to drop any food on the ground or your score will decrease\nwith over 50 different meals to prepare, explore all the possibilites with different ingr\u00e9dients straight from the ocean such as salmon, nori or sea cucumber and many more.", "short_description": "VR Sea chef is a cooking game in collaboration with Aquafish 0.0 where you are on a stranded island and you, as a chef, need to feed an extremely hungry octopus\nPrepare his meals accordingly to his demands in only 5 minutes and keep pushing your score, try not to drop any food on the ground or your score will decrease\nwith over 50 different meals to prepare, explore all the possibilites with different ingr\u00e9dients straight from the ocean such as salmon, nori or sea cucumber and many more."}]}, "developer_name": "LII esieaLab", "developer_privacy_policy_url": "https://docs.google.com/document/d/16wO9PBjo23GMbhFeHPu1uVkqkCJUNO0RrNsPy5zCim8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "ESIEA", "support_website_url": null, "website_url": "https://www.esiea.fr/esiealab-recherche/lii/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27353157427697516"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491825481_2934329810237420_6170415134633088768_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TT9Fh5dlYTIQ7kNvwFpddLN&_nc_oc=AdoUhT7KMIUig7IqiExRWo3zc4kRzJwIv16ZGMSXckyF-PYciolAQKg1wOgE4sCgYb4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJXLg0OfvJfMfu9Ldqjo__BMtPLcC4qBPouNlv5gJWM2A&oe=6AA55C7A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "AQUAFISH - VR Sea Chef", "platform": "AN
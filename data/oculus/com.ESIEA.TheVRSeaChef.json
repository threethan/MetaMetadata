-25/491823296_27546637768336012_82709430732726836_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lu85MCPSGCkQ7kNvwHZ2xvJ&_nc_oc=AdqF0yK4n40BmARVVsOERCfPqa6fzjlh3IqT3TPnsnV6EjXGbpWe9V-2T7XVCvNTW1A&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7HW6MVyWbkqriH0i59rY1-PloZLiSdgR4vnVVgEg5pw&oe=6AE33AA7"}, "display_name": "AQUAFISH - VR Sea Chef", "keywords": ["AQUAFISH", "COOKING", "SEAFOOD"], "long_description": "VR Sea chef is a cooking game in collaboration with Aquafish 0.0 where you are on a stranded island and you, as a chef, need to feed an extremely hungry squid\nPrepare his meals accordingly to his demands in only 5 minutes and keep pushing your score, try not to drop any food on the ground or your score will decrease\nwith over 50 different meals to prepare, explore all the possibilites with different ingr\u00e9dients straight from the ocean such as salmon, nori or sea cucumber and many more.", "short_description": "VR Sea chef is a cooking game in collaboration with Aquafish 0.0 where you are on a stranded island and you, as a chef, need to feed an extremely hungry squid\nPrepare his meals accordingly to his demands in only 5 minutes and keep pushing your score, try not to drop any food on the ground or your score will decrease\nwith over 50 different meals to prepare, explore all the possibilites with different ingr\u00e9dients straight from the ocean such as salmon, nori or sea cucumber and many more."}]}, "developer_name": "LII esieaLab", "developer_privacy_policy_url": "https://docs.google.com/document/d/16wO9PBjo23GMbhFeHPu1uVkqkCJUNO0RrNsPy5zCim8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "ESIEA", "support_website_url": null, "website_url": "https://www.esiea.fr/esiealab-recherche/lii/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_
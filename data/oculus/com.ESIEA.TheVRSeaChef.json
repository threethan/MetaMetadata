se\nwith over 50 different meals to prepare, explore all the possibilites with different ingr\u00e9dients straight from the ocean such as anchovy, nori or sea cucumber and many more.", "short_description": "VR Sea chef is a cooking game in collaboration with Aquafish 0.0 where you are on a stranded island and you, as a chef, need to feed an extremely hungry octopus\nPrepare his meals accordingly to his demands in only 5 minutes and keep pushing your score, try not to drop any food on the ground or your score will decrease\nwith over 50 different meals to prepare, explore all the possibilites with different ingr\u00e9dients straight from the ocean such as salmon, nori or sea cucumber and many more."}]}, "developer_name": "LII esieaLab", "developer_privacy_policy_url": "https://docs.google.com/document/d/16wO9PBjo23GMbhFeHPu1uVkqkCJUNO0RrNsPy5zCim8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "ESIEA", "support_website_url": null, "website_url": "https://www.esiea.fr/esiealab-recherche/lii/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28408750622138186"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491825481_2934329810237420_6170415134633088768_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W2I18pGcVaIQ7
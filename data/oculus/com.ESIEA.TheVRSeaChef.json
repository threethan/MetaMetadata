3924539659244_6872540824165978202_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kQ3EG9-loPcQ7kNvwHQchZF&_nc_oc=Adrv8r_qdQM5V3i0NfL1ysGijBxuojRbsgNieIVM_JHwR_ZF0esMnvMajJyt0FyDlU0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKwLtEKBhJHBIZSAPLq8dj6mNoAZgXJChjB3zPzDOXNNA&oe=6AAFE120"}, {"file_name": "Screenshot_6.png", "id": "1573465457837658", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823802_1573465464504324_2614353974622069702_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IxWVabGHnmwQ7kNvwGapOXk&_nc_oc=AdoTs_g6zcbBkOOUfgxNvvbfAXsiUSfBnd4vwnd_8Itn4elqy8-nUhtJSltJjmABMUI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLihu5LX3WmxkV0RM3Ji9bo8bu23YpIVXTGL6CJer7llA&oe=6AAFE3E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image de pr\u00e9sentation.png", "id": "27546637765002679", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823296_27546637768336012_82709430732726836_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X4iGQP2jr5UQ7kNvwHlC2SR&_nc_oc=AdriqD87xNTmo1ds6EWnwN-HDUmI271TQ5kYAcCR7duAZ04p01HDVp3rPsWpXRmXRuk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdCqlr4Pp3Pnsc3tnLmMrQ7HCfiPHkRkRpEJDZ8hoDEA&oe=6AAFD027"}, "display_name": "AQUAFISH - VR Sea Chef", "keywords": ["AQUAFISH", "COOKING", "SEAFOOD"], "long_description": "VR Sea chef is a cooking game in collaboration with Aquafish 0.0 where you are on a stranded island and you, as a chef, need to feed an extremely hungry octopus\nPrepare his meals accordingly to his demands in only 5 minutes and keep pushing your score, try not to drop any food on the ground or your score will decrease\nwith over 50 different meals to prepare, explore all the possibilites with different ingr\u00e9dients straight from the ocean such as salmon, nori or sea cucumber and many more.", "short_description": "VR Sea chef is a cooking game in collaboration with Aquafish 0.0 where you are on a stranded island and you, as a chef, need to feed an extremely hungry octopus\nPrepare his meals accordingly to his demands in only 5 minutes and keep pushing your score, try not to drop any food on the ground or your score will decrease\nwith over 50 different meals to prepare, explore all the possibilites with different ingr\u00e9dients straight from the ocean such as salmon, nori or sea cucumber and many more."}]}, "developer_name": "LII esieaLab", "developer_privacy_policy_url": "https://docs.google.com/document/d/16wO9PBjo23GMbhFeHPu1uVkqkCJUNO0RrNsPy5zCim8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "ESIEA", "support_website_url": null, "website_url": "https://www.esiea.fr/esiealab-recherche/lii/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27353157427697516"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825481_2934329810237420_6170415134633088768_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T1ND19WSsQcQ7kNvwFYB86r&_nc_oc=AdrvYeYgaq1NWfSU9gKSfMPqdfbzIpJMZHsFKYXMP5PdQOL6OXgUwWNQopzU6CFzOyM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1CX4W9QYy28DK4NAbWfDwMk4C6i96_JAPKfFNVfyBKg&oe=6AAFE87A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "AQUAFISH - VR Sea Chef", "platform": "AN
50_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kMdId2wKWu4Q7kNvwFCCQOY&_nc_oc=Adofz_t85PgMeMP2IyEP7HSwonGp4-QF3ST9EwHqZq1eX3Z7LcXubpgsX3jwGZ743WI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQAHysCBql13hk8U4f_kXww_Ay9eby4CRqTN4njMCvtg&oe=6B087297"}, {"file_name": "ScreenShot3.png", "id": "988852023573455", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491821081_988852026906788_5249986527094067898_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=br1eyDlShuoQ7kNvwGBAzUn&_nc_oc=AdqkRibi-eJqIg5--oZA0nBAapnqo7ZlDtsgMqrbdN7TDXCsYiNS2SYvPOAQN5hLqGY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFmC8v65lWagF4HnWyk4og-VMFAiVfEdjJyv4fspahYg&oe=6B086243"}, {"file_name": "ScreenShot5.png", "id": "1433618705115507", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491824671_1433618708448840_7035026529616538174_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yq5rZRjgB9QQ7kNvwGttg6h&_nc_oc=AdoQx-BKGoS1Tj4WcYTGrEPA-_VUhOC6BNuutxmASLQjQpUxp41AJkF_JyWqbAvBwKo&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRC0aBmzun3tysn2IbMssXrfLOeBuxQb1WXNS6PcEUF6A&oe=6B086A49"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Snapshot.PNG", "id": "848476604929184", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491820983_848476608262517_5008057075773251413_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8u9AUahgZToQ7kNvwGxm6tQ&_nc_oc=AdpXOv3Fcbcb8jnKuVAZP11Qx9RnhJ3fDlULq5_NKwttrgp5Mu0gRUTeuPrUAcbNf9Y&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBD4TopfIbb0dh-A_0wt_bRZg6RsVwXD6sF06fNXLvrQ&oe=6B085F02"}, "display_name": "Human Anatomy Tutor", "keywords": ["Human", "Anatomy", "Body", "Bones", "Muscles"], "long_description": "Human anatomy tutor is an educational VR Experience that let you learn about the anatomy of the human body on a more didactical way than the traditional textbooks. \n\nYou can point with your Touch Controllers to any part of the Human skeleton, Human muscles or Internal human organs and hold that body part to see it better, you can see the name of the part (so you can easily memorize the name of that body part easily and see how is located on the human body) and you can extract more information about that body part that is publicly available on the Wikipedia that is stored locally on the App.\n\nThis VR Experience do not require an internet connection to work (100% offline), and is available on the following languages:\n\n- English\n- German\n- Portuguese\n- French\n- Spanish\n\nThis VR Experience present the human body in 3 layers:\n- Human skeleton\n- Human muscle system\n- Human internal organs\n\nThen you can hold any bone, muscle or organ of the human body, see the name of that part and read information about it.", "short_description": "Human anatomy tutor is an educational VR Experience that let you learn about the anatomy of the human body on a more didactical way than the traditional textbooks. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-notice-last-updated-april-15.html", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are-we-indie-virtual-reality-video.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": 
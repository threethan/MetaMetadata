ng?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IyshyJ383x8Q7kNvwGqgU-D&_nc_oc=AdqUslZX-fXT5TwJk4bY3-8S_tMlZ6YVv-PXxlkszwPFCqafX-mWySkVY5tUND_DY9s&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af10kAOJmvscGLvR9nUQKbqIxviv9PmPi-ovZDdGtBB-4g&oe=69F20DD7"}, {"file_name": "ScreenShot3.png", "id": "988852023573455", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821081_988852026906788_5249986527094067898_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hjfmAW9eFagQ7kNvwFL2cqx&_nc_oc=Adp2udxDh_3NwnmNAYeNzM0Zh7UUrhlXOTJQz0_p5szzo8v3wfXAdjcIZHA_fU-JQQg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af2Gi-3KTgr_aeSrTnuKH1OjNJ52Evpmi7KqIf1b_L9rIQ&oe=69F1FD83"}, {"file_name": "ScreenShot5.png", "id": "1433618705115507", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491824671_1433618708448840_7035026529616538174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=No6AMt3DP7UQ7kNvwFOgRAd&_nc_oc=AdoLQpeb2nmZ0uzSWMoa5c_1mQbx0YaoTt1CGWeNO3XitHNBLeU17NOazmLH0yBHwgQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af2Vj2Dv0iIFJhZz8l1tUkwW8yPVtxJW-s40t2VzISfTYw&oe=69F20589"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Snapshot.PNG", "id": "848476604929184", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820983_848476608262517_5008057075773251413_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QYnJwct20LEQ7kNvwF4DyXJ&_nc_oc=Adqisnxo0EkN0b_7b5F1d2cLZyBm_isQEQVs9os23touXO3elkhqAYAiZUi9ZL1C1mg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2phhbHFHsWkUpYjXea37dYrzNOhDZhGRnfikgoWWGU2Q&oe=69F1FA42"}, "display_name": "Human Anatomy Tutor", "keywords": ["Human", "Anatomy", "Body", "Bones", "Muscles"], "long_description": "Human anatomy tutor is an educational VR Experience that let you learn about the anatomy of the human body on a more didactical way than the traditional textbooks. \n\nYou can point with your Touch Controllers to any part of the Human skeleton, Human muscles or Internal human organs and hold that body part to see it better, you can see the name of the part (so you can easily memorize the name of that body part easily and see how is located on the human body) and you can extract more information about that body part that is publicly available on the Wikipedia that is stored locally on the App.\n\nThis VR Experience do not require an internet connection to work (100% offline), and is available on the following languages:\n\n- English\n- German\n- Portuguese\n- French\n- Spanish\n\nThis VR Experience present the human body in 3 layers:\n- Human skeleton\n- Human muscle system\n- Human internal organs\n\nThen you can hold any bone, muscle or organ of the human body, see the name of that part and read information about it.", "short_description": "Human anatomy tutor is an educational VR Experience that let you learn about the anatomy of the human body on a more didactical way than the traditional textbooks. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-notice-last-updated-april-15.html", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are-we-indie-virtual-reality-video.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26546007115041952"}, "review
&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1osaRPiCa4EQ7kNvwHexyZK&_nc_oc=AdpRH7srbF10ekrX4xTJwbYuO5YLR27Oobez2ClGWqY1TBkhzKmBPQgjakiUQGjhoRs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9FFkWa-r-vsUEuptPZLkvsU9OWAsi3qaFGfjgu7GG-Kg&oe=6A3E83A0"}, {"file_name": "ScreenShot1.png", "id": "4103345429956830", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823270_4103345433290163_4264538028001096750_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v1APJcvMatUQ7kNvwHaIzdn&_nc_oc=Adq7QKnAy7sRiap8aS1JlJApPkkkA16lPF1QvUQ7G86Xs2XuOK_wKCaaQV_DqBAYS9U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8DGfnzkxaXRWqh2YI04zpKfL7jwFU0xAFRgODJjRRbPQ&oe=6A3E84D7"}, {"file_name": "ScreenShot3.png", "id": "988852023573455", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821081_988852026906788_5249986527094067898_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ElVYj27d0c4Q7kNvwET_G_s&_nc_oc=AdqIW3UgtTPApL5XLrG6AjY4gxxhs0hfFee8-3-AkIMIGgAlMi9Kqf6XK22gCcGPW0Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-AcY8uPRi_5xLazLU9Y2NpV6PS--HCsMx4b1L8oJVaUA&oe=6A3EACC3"}, {"file_name": "ScreenShot5.png", "id": "1433618705115507", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824671_1433618708448840_7035026529616538174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=glat7O9auxMQ7kNvwFgYjjA&_nc_oc=Adou21chb8Z6rKrtSMr6pz5g0ZpjyMEidaA1QoHhNYAQRj8_o_XvRCkOYEiAQh_wwKo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8yNsh-POB4Arby9kWjBoYb1Wf_SXEC2vbnYX2KN1HMdQ&oe=6A3E7C89"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Snapshot.PNG", "id": "848476604929184", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820983_848476608262517_5008057075773251413_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cCjczqB-yFoQ7kNvwEVFpJJ&_nc_oc=Adoub7QdxQgUGjrscdG5kdIlsWCAYOw4kQZZiYaCQISWeYOPtKiOs-Oxeq7ZQy65vNM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3ISn6BvY10kkDWli1gE4VARtXGmb62xXE35OM3HGrvw&oe=6A3EA982"}, "display_name": "Human Anatomy Tutor", "keywords": ["Human", "Anatomy", "Body", "Bones", "Muscles"], "long_description": "Human anatomy tutor is an educational VR Experience that let you learn about the anatomy of the human body on a more didactical way than the traditional textbooks. \n\nYou can point with your Touch Controllers to any part of the Human skeleton, Human muscles or Internal human organs and hold that body part to see it better, you can see the name of the part (so you can easily memorize the name of that body part easily and see how is located on the human body) and you can extract more information about that body part that is publicly available on the Wikipedia that is stored locally on the App.\n\nThis VR Experience do not require an internet connection to work (100% offline), and is available on the following languages:\n\n- English\n- German\n- Portuguese\n- French\n- Spanish\n\nThis VR Experience present the human body in 3 layers:\n- Human skeleton\n- Human muscle system\n- Human internal organs\n\nThen you can hold any bone, muscle or organ of the human body, see the name of that part and read information about it.", "short_description": "Human anatomy tutor is an educational VR Experience that let you learn about the anatomy of the human body on a more didactical way than the traditional textbooks. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-notice-last-updated-april-15.html", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are-we-indie-virtual-reality-video.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_
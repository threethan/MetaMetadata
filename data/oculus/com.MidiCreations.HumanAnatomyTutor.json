f&oh=00_Af8eCFNvsS6Q3nTu5con0N3-CSyr7X3PVJfSql-1MKQGUw&oe=6A467499"}, {"file_name": "ScreenShot2.png", "id": "1626231181962401", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491822931_1626231185295734_2071850456499349033_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Mr_Gm__8IAQ7kNvwGy1vo7&_nc_oc=AdpIb4MJm8D694EAQnZyH2A4kkHuMgnLhk2D_OPiHEQ9LwJ69nUHCD_QK3XBu6lZxF4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_O5kdPY3SPMw89vvPoZTmQMzy9lj2a_YRl-8giwPCFSQ&oe=6A466CA0"}, {"file_name": "ScreenShot1.png", "id": "4103345429956830", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491823270_4103345433290163_4264538028001096750_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=itx7dmIpn5gQ7kNvwGhfnuQ&_nc_oc=Adpa3EFrHy2a592k9IUI8T4jOBKmDIVUSOqXnEdkW2CJV9bCa6YL8odv43X53WM7SxI&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8HimLyCDO3daJsXnXNWiRUAoHMBSIfxZSUQDAiaCvPKw&oe=6A466DD7"}, {"file_name": "ScreenShot3.png", "id": "988852023573455", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491821081_988852026906788_5249986527094067898_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S6wVLUdqQZsQ7kNvwFTizIF&_nc_oc=Adqw9qh6qzF5bv7ByyKZMVun0XhoPF8jaBVGc6nerOXNIYr49X-AHPOfe7gxMm_cCNI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__-vSXxzzEoQ4uTiHwqQEGlnRGY5QKBLCd7cQyH_waLA&oe=6A465D83"}, {"file_name": "ScreenShot5.png", "id": "1433618705115507", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491824671_1433618708448840_7035026529616538174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yY9vOp7sh1wQ7kNvwGfFt5t&_nc_oc=AdrhjjtBJyl70pxLBmnuRRLXMjoAVMjQInnmw-ca-31Rb64JkMuJSQPYu0eQ4onRjOw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9lthQnpHM6FDT7HnJm8ieeKa99RImNK8qMC41fzH5O0g&oe=6A466589"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Snapshot.PNG", "id": "848476604929184", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491820983_848476608262517_5008057075773251413_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ZZ08vqYCeoQ7kNvwHg9x2W&_nc_oc=AdqL-j1i7gfyJzpUgDfCoJFAegQSJfEVCZzC82LdpflIKFg-brra3ZOK-rwks14kD28&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_TpoAX7z6sMXJZ-vlV66M8VhKRpJos2WjygICJOxv7XA&oe=6A465A42"}, "display_name": "Human Anatomy Tutor", "keywords": ["Human", "Anatomy", "Body", "Bones", "Muscles"], "long_description": "Human anatomy tutor is an educational VR Experience that let you learn about the anatomy of the human body on a more didactical way than the traditional textbooks. \n\nYou can point with your Touch Controllers to any part of the Human skeleton, Human muscles or Internal human organs and hold that body part to see it better, you can see the name of the part (so you can easily memorize the name of that body part easily and see how is located on the human body) and you can extract more information about that body part that is publicly available on the Wikipedia that is stored locally on the App.\n\nThis VR Experience do not require an internet connection to work (100% offline), and is available on the following languages:\n\n- English\n- German\n- Portuguese\n- French\n- Spanish\n\nThis VR Experience present the human body in 3 layers:\n- Human skeleton\n- Human muscle system\n- Human internal organs\n\nThen you can hold any bone, muscle or organ of the human body, see the name of that part and read information about it.", "short_description": "Human anatomy tutor is an educational VR Experience that let you learn about the anatomy of the human body on a more didactical way than the traditional textbooks. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-notice-last-updated-april-15.html", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are-we-indie-virtual-re
&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TSlE_Cv04tUQ7kNvwEVYdGe&_nc_oc=Adpr4EARuepM8TBsoCTbajcrIS0LWsXjjKKCCXJHyEn3idVzy9I1JV9ilaR6urehv2M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rXVAC-GhgJ2i4NcLH4TCvfs0q1_Roso0UFl-2RuEu-w&oe=6A3BE0A0"}, {"file_name": "ScreenShot1.png", "id": "4103345429956830", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823270_4103345433290163_4264538028001096750_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v1APJcvMatUQ7kNvwFFjaMS&_nc_oc=AdoY_eryjr4Tw3plLERi2XPcHbVJXkogsuawVsWGiVYR4FX8BaJZc3KvO03ejuUHC30&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-RfSlr4VQwVm00hb-yLmy1EScPYMHJ4lyT3CAIS3wLgw&oe=6A3BE1D7"}, {"file_name": "ScreenShot3.png", "id": "988852023573455", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821081_988852026906788_5249986527094067898_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ElVYj27d0c4Q7kNvwF-F9BZ&_nc_oc=AdpCeWPx3w_DLbV0FhyIzIAvD-FYsoQO9jbPF0LSKzGvxth-ENg-wl-4hIkC8XRybS4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9BrumopH-i32AQi_YOm2oi5AwZuRUWNmbC0OWetzvlpQ&oe=6A3BD183"}, {"file_name": "ScreenShot5.png", "id": "1433618705115507", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824671_1433618708448840_7035026529616538174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TueCaV6B94UQ7kNvwEGo-i1&_nc_oc=AdrRRq-kvMTp7GcGs9n2mxYzBNzZ-XHzRMMFkNr0aokeuMY7Bp9DGt7PmVLlAqVzhrA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9zjouVag7XXW_OO6G2o4NvJPtOflrNN6eQvJboarv0Ow&oe=6A3BD989"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Snapshot.PNG", "id": "848476604929184", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820983_848476608262517_5008057075773251413_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XbFaMExdpbMQ7kNvwGwPEH7&_nc_oc=AdqKL7c9LkaP5hVuBDg74uQIvcABtB8hXUOgqf2PoUNGWX_mCX1ArE55VpO2lhs43wY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8nIKtGjHh80HQrL3V3aCpQ3Ml4gtI-L-iGDDfp-dgeIg&oe=6A3BCE42"}, "display_name": "Human Anatomy Tutor", "keywords": ["Human", "Anatomy", "Body", "Bones", "Muscles"], "long_description": "Human anatomy tutor is an educational VR Experience that let you learn about the anatomy of the human body on a more didactical way than the traditional textbooks. \n\nYou can point with your Touch Controllers to any part of the Human skeleton, Human muscles or Internal human organs and hold that body part to see it better, you can see the name of the part (so you can easily memorize the name of that body part easily and see how is located on the human body) and you can extract more information about that body part that is publicly available on the Wikipedia that is stored locally on the App.\n\nThis VR Experience do not require an internet connection to work (100% offline), and is available on the following languages:\n\n- English\n- German\n- Portuguese\n- French\n- Spanish\n\nThis VR Experience present the human body in 3 layers:\n- Human skeleton\n- Human muscle system\n- Human internal organs\n\nThen you can hold any bone, muscle or organ of the human body, see the name of that part and read information about it.", "short_description": "Human anatomy tutor is an educational VR Experience that let you learn about the anatomy of the human body on a more didactical way than the traditional textbooks. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-notice-last-updated-april-15.html", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are-we-indie-virtual-reality-video.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_
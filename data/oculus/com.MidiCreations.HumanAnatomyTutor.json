C3CA0"}, {"file_name": "ScreenShot1.png", "id": "4103345429956830", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491823270_4103345433290163_4264538028001096750_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vJ9o8fAhSuUQ7kNvwEx2nwY&_nc_oc=AdrkR-gX3pMAH2MGHWxRDUS4aeaFrMV5qfHE7tOxts-oRUS0tkKUfre6NHcUgjB4rLI&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7lZjZOYkGybSCzPqZ4C5J7G4WsMZr3K4t3qnHO8eoMuQ&oe=6A1C3DD7"}, {"file_name": "ScreenShot3.png", "id": "988852023573455", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491821081_988852026906788_5249986527094067898_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qUx1qYu14foQ7kNvwEl3v-G&_nc_oc=Adpynw_s-ftZnDFnAldJSbtPPtlZEbcLP6MNtCNAFCDP2Ape_PEcgl8IMHAbwMLEHyw&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7AD3b4n0HJ_8EixZnTX13v_mEe2POTg63pMHExVL28bQ&oe=6A1C2D83"}, {"file_name": "ScreenShot5.png", "id": "1433618705115507", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491824671_1433618708448840_7035026529616538174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jFAeCT4Aij8Q7kNvwETFIUi&_nc_oc=AdpB5g3p5EjwVSZt395lTfkeQydxx98kcA1rK2W_9iV8p3TQBzCG0G5S8xSpjw5_9m4&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ysDUtv6mJpsH6H2AgRcGF2O07udVXnYbR05ka2x9Fmw&oe=6A1C3589"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Snapshot.PNG", "id": "848476604929184", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491820983_848476608262517_5008057075773251413_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EVIorWYHLKcQ7kNvwFsLw4y&_nc_oc=Ado7QuWTFhyvWqQXQ723wMedTiGnBwSgLUL_CnE_mrZV9yaO-wuRQ9yt4VYuHuP4zg4&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5gxUrlHYt4Ued4JGPhMVQDz7sefmQkyOLpcQaACPT4PA&oe=6A1C2A42"}, "display_name": "Human Anatomy Tutor", "keywords": ["Human", "Anatomy", "Body", "Bones", "Muscles"], "long_description": "Human anatomy tutor is an educational VR Experience that let you learn about the anatomy of the human body on a more didactical way than the traditional textbooks. \n\nYou can point with your Touch Controllers to any part of the Human skeleton, Human muscles or Internal human organs and hold that body part to see it better, you can see the name of the part (so you can easily memorize the name of that body part easily and see how is located on the human body) and you can extract more information about that body part that is publicly available on the Wikipedia that is stored locally on the App.\n\nThis VR Experience do not require an internet connection to work (100% offline), and is available on the following languages:\n\n- English\n- German\n- Portuguese\n- French\n- Spanish\n\nThis VR Experience present the human body in 3 layers:\n- Human skeleton\n- Human muscle system\n- Human internal organs\n\nThen you can hold any bone, muscle or organ of the human body, see the name of that part and read information about it.", "short_description": "Human anatomy tutor is an educational VR Experience that let you learn about the anatomy of the human body on a more didactical way than the traditional textbooks. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-notice-last-updated-april-15.html", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are-we-indie-virtual-reality-video.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "su
50_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1MOH8GyfQdEQ7kNvwHIDBVj&_nc_oc=Adp3yzvQLlMh1JjgXhFepfzWp8YAjE_DQSeV2U9LsbW5336uCCpDRqZwInKECj46A5M&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvw_ZVKrmKK9MFBEkNHJ46byHpFPVC2jgcK8vIVVqVCw&oe=6B09C417"}, {"file_name": "ScreenShot3.png", "id": "988852023573455", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491821081_988852026906788_5249986527094067898_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RhfeEfQQZeAQ7kNvwFFNffn&_nc_oc=Adp3akSPf034x6KHQI_8f5eMjscv_T-Vmrk58kDiYWgiR9swlgFnxMoAikA6nxEJYrE&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUaxTEUPQwRYCEUfvzkygUYEl_8cvDQatnDokxB_Uh1A&oe=6B09B3C3"}, {"file_name": "ScreenShot5.png", "id": "1433618705115507", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824671_1433618708448840_7035026529616538174_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yq5rZRjgB9QQ7kNvwGXnUXF&_nc_oc=Adqpgpl46cNBCJkhH4xxZDnudIha2Ebyej9Aj09-5-o73temho25GeIqui7J9veGdmA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHzG-PRYU97DP76X4jCABZ7z-8qw559wsL1Nx2TRcd4Q&oe=6B09BBC9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Snapshot.PNG", "id": "848476604929184", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820983_848476608262517_5008057075773251413_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8u9AUahgZToQ7kNvwGdY9vR&_nc_oc=AdoNVDYL3m96uIV3B0DbBaGNO8GkGbpdiUxyGmg6Vwpr7HQEC0bFR1qKg2I-mJ94O4Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRkNr_9WV96ZgZpB2UwTf_xDCw51La1RQFEc-Y4YxTZQ&oe=6B09B082"}, "display_name": "Human Anatomy Tutor", "keywords": ["Human", "Anatomy", "Body", "Bones", "Muscles"], "long_description": "Human anatomy tutor is an educational VR Experience that let you learn about the anatomy of the human body on a more didactical way than the traditional textbooks. \n\nYou can point with your Touch Controllers to any part of the Human skeleton, Human muscles or Internal human organs and hold that body part to see it better, you can see the name of the part (so you can easily memorize the name of that body part easily and see how is located on the human body) and you can extract more information about that body part that is publicly available on the Wikipedia that is stored locally on the App.\n\nThis VR Experience do not require an internet connection to work (100% offline), and is available on the following languages:\n\n- English\n- German\n- Portuguese\n- French\n- Spanish\n\nThis VR Experience present the human body in 3 layers:\n- Human skeleton\n- Human muscle system\n- Human internal organs\n\nThen you can hold any bone, muscle or organ of the human body, see the name of that part and read information about it.", "short_description": "Human anatomy tutor is an educational VR Experience that let you learn about the anatomy of the human body on a more didactical way than the traditional textbooks. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-notice-last-updated-april-15.html", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are-we-indie-virtual-reality-video.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": 
ZlwZU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-E_fmXquzpNRPejbcKq32oaIWWI7iSPWyJ9zLGzQtJwA&oe=6A2EB1A0"}, {"file_name": "ScreenShot1.png", "id": "4103345429956830", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823270_4103345433290163_4264538028001096750_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QXrezn_bmiYQ7kNvwHMtg3U&_nc_oc=AdoieYWg7xmY6nVL9AlBvrqKJMF4t6S2SECDxvcSfo-ED15Kw7r25MA8h1greW3gsZA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0h8MqTpzL-XHU964PI7lBLnf256N0jo6KsJEEV5Yt0w&oe=6A2EB2D7"}, {"file_name": "ScreenShot3.png", "id": "988852023573455", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821081_988852026906788_5249986527094067898_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KGFT9585LccQ7kNvwGFo9nt&_nc_oc=Adrkdb7ZOlFPjfAlFmf2rvzH54LMQAsucU1DA5C_H3BEfmHQVDfIWHZ68tOl5gyMcPo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-j8vNN-OIIZjwEST1lO_ri-D7aUfXnzwj_gUqk0iUE3Q&oe=6A2EA283"}, {"file_name": "ScreenShot5.png", "id": "1433618705115507", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824671_1433618708448840_7035026529616538174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UYjC1VMTLmcQ7kNvwH-e6cd&_nc_oc=AdqjQ4GHr7ILb70oQo9rDNaMwoWQLpJrB5PoNdUyTU1kGdZ7ffdwwbs6x7fQxCRiZYM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8T16Kwl28GmaOXsh7tFSIKQL0bv6mP0zvPv2P6IRAAWg&oe=6A2EAA89"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Snapshot.PNG", "id": "848476604929184", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820983_848476608262517_5008057075773251413_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yL0Wx-4TSysQ7kNvwFVT2dz&_nc_oc=Adr34PYA4HoZhQl97HeoZ8rpk3y9uSc32IAe0P_vSeGV1TAYibYPYhHWVpSte2QdeYw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8I4yjYR11XtaN8NujxMnyZdwqf_XtVlAt6N9VOSBnCHg&oe=6A2E9F42"}, "display_name": "Human Anatomy Tutor", "keywords": ["Human", "Anatomy", "Body", "Bones", "Muscles"], "long_description": "Human anatomy tutor is an educational VR Experience that let you learn about the anatomy of the human body on a more didactical way than the traditional textbooks. \n\nYou can point with your Touch Controllers to any part of the Human skeleton, Human muscles or Internal human organs and hold that body part to see it better, you can see the name of the part (so you can easily memorize the name of that body part easily and see how is located on the human body) and you can extract more information about that body part that is publicly available on the Wikipedia that is stored locally on the App.\n\nThis VR Experience do not require an internet connection to work (100% offline), and is available on the following languages:\n\n- English\n- German\n- Portuguese\n- French\n- Spanish\n\nThis VR Experience present the human body in 3 layers:\n- Human skeleton\n- Human muscle system\n- Human internal organs\n\nThen you can hold any bone, muscle or organ of the human body, see the name of that part and read information about it.", "short_description": "Human anatomy tutor is an educational VR Experience that let you learn about the anatomy of the human body on a more didactical way than the traditional textbooks. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-notice-last-updated-april-15.html", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are-we-indie-virtual-reality-video.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommen
10&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fSdKMqua0OQQ7kNvwGxvUq9&_nc_oc=Adqj0CJTdg6aum79Je-W2LF0UZhODyCjTDrtAY8EzqWvtf3QjSKUUxY2fhGSlGOEWGs&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9D6mMTFouTBBwuXcsHojiwHzk9G_mxyX15qfw-XQ-hpg&oe=6A369AA0"}, {"file_name": "ScreenShot1.png", "id": "4103345429956830", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491823270_4103345433290163_4264538028001096750_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O7YyHIc_fm4Q7kNvwHtG8xB&_nc_oc=Ado2RoFGbr-eDLH-RZF8ZpVQrPpMeYnVPDdQvCMA2f1knhTJvewPtxfGhA43MX3AdVY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0oyQmLfZWfomqBU6c6jmAVxTgAiCiUBxCq-3daHtndA&oe=6A369BD7"}, {"file_name": "ScreenShot3.png", "id": "988852023573455", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491821081_988852026906788_5249986527094067898_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MlrT6_pgWfsQ7kNvwEJYcQy&_nc_oc=AdqgKHQTMb2DJrQdcuqKAk-t3D_Ngegm7FfhgvsXDraSACbt0EjLOe7SZmmggpYmhF0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8SVEAdxOa5d-M_sDatJh89AiuL5cPvn6LuRCx6WFD8vA&oe=6A36C3C3"}, {"file_name": "ScreenShot5.png", "id": "1433618705115507", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491824671_1433618708448840_7035026529616538174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XEaUbEFclt0Q7kNvwE9ghhj&_nc_oc=Ado1oNHu8jjXqext-b53yK2awJB1r-LGp2f6EN2QXPo7_F5ARQBumv7bqgFJ7q02D7Y&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-D0V4fMf56-P6HKnOSYBhPj1XiagE4rk1G_nWsJmyGcw&oe=6A369389"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Snapshot.PNG", "id": "848476604929184", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491820983_848476608262517_5008057075773251413_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lRe3bME1qOsQ7kNvwFLaJ4O&_nc_oc=AdpMfRSd5pMzjXiUkp3xWYygFiagWMDeKPzbZUNvgHGBg5kmrmII2F4GmLHudbY4vT4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90vT2FYDcRVtSvpKpGZUpSwrCa2BbPBarzWoMQRugZug&oe=6A36C082"}, "display_name": "Human Anatomy Tutor", "keywords": ["Human", "Anatomy", "Body", "Bones", "Muscles"], "long_description": "Human anatomy tutor is an educational VR Experience that let you learn about the anatomy of the human body on a more didactical way than the traditional textbooks. \n\nYou can point with your Touch Controllers to any part of the Human skeleton, Human muscles or Internal human organs and hold that body part to see it better, you can see the name of the part (so you can easily memorize the name of that body part easily and see how is located on the human body) and you can extract more information about that body part that is publicly available on the Wikipedia that is stored locally on the App.\n\nThis VR Experience do not require an internet connection to work (100% offline), and is available on the following languages:\n\n- English\n- German\n- Portuguese\n- French\n- Spanish\n\nThis VR Experience present the human body in 3 layers:\n- Human skeleton\n- Human muscle system\n- Human internal organs\n\nThen you can hold any bone, muscle or organ of the human body, see the name of that part and read information about it.", "short_description": "Human anatomy tutor is an educational VR Experience that let you learn about the anatomy of the human body on a more didactical way than the traditional textbooks. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-notice-last-updated-april-15.html", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are-we-indie-virtual-reality-video.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type":
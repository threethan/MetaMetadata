6F6A0"}, {"file_name": "ScreenShot1.png", "id": "4103345429956830", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823270_4103345433290163_4264538028001096750_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J98c0BMhgFcQ7kNvwGX6vkL&_nc_oc=Adql97Y8uRou6skfsMRxyo9n6apQv0Ml_qJa6E-zubZQpB_UxFrXjesEGLH0vqEVIB4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5SIEyJtLuC-wq6b58h12b9ACnxwOcVc2nQnr7etNDnHQ&oe=6A16F7D7"}, {"file_name": "ScreenShot3.png", "id": "988852023573455", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491821081_988852026906788_5249986527094067898_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9iEWeZFvmWgQ7kNvwF3mroo&_nc_oc=Adq4PE7OUzuaJPO2ifimnNkohE4wgevzcQV9LklDa7PxPFNSIKNTZuoxqG695PcleXg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4aueEKEKvy1sNNaHrnfEDkpLPtFulMhJ84r6eoHOCepg&oe=6A16E783"}, {"file_name": "ScreenShot5.png", "id": "1433618705115507", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491824671_1433618708448840_7035026529616538174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=diUWvrcZAO0Q7kNvwGVYzSX&_nc_oc=AdpjdRpW8o5Mp5xer-NO00sb-HN88ACdjJFoX-tKcMGDVexIz4CBhstsnbA1IWJ4jiQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RvH--cE1ZVtpKZazlt2Hk4kBOlohAU4oXjUWd0NTWuA&oe=6A16EF89"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Snapshot.PNG", "id": "848476604929184", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820983_848476608262517_5008057075773251413_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SONaI5ZEtvgQ7kNvwGXsc_A&_nc_oc=Adq668jK4Z4Liv45dhyGDwja_IDlAffz00wG2iL6KIFbh0pFEtKkcWEptVtZwmmZax8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5i9jUii-iF0W6IJ6sf2Rop091lwhhrhE1cKTKverzevA&oe=6A16E442"}, "display_name": "Human Anatomy Tutor", "keywords": ["Human", "Anatomy", "Body", "Bones", "Muscles"], "long_description": "Human anatomy tutor is an educational VR Experience that let you learn about the anatomy of the human body on a more didactical way than the traditional textbooks. \n\nYou can point with your Touch Controllers to any part of the Human skeleton, Human muscles or Internal human organs and hold that body part to see it better, you can see the name of the part (so you can easily memorize the name of that body part easily and see how is located on the human body) and you can extract more information about that body part that is publicly available on the Wikipedia that is stored locally on the App.\n\nThis VR Experience do not require an internet connection to work (100% offline), and is available on the following languages:\n\n- English\n- German\n- Portuguese\n- French\n- Spanish\n\nThis VR Experience present the human body in 3 layers:\n- Human skeleton\n- Human muscle system\n- Human internal organs\n\nThen you can hold any bone, muscle or organ of the human body, see the name of that part and read information about it.", "short_description": "Human anatomy tutor is an educational VR Experience that let you learn about the anatomy of the human body on a more didactical way than the traditional textbooks. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-notice-last-updated-april-15.html", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are-we-indie-virtual-reality-video.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "su
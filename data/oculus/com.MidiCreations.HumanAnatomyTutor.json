-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALSTtkH7lzxvLz_wlxJOHWOigN_oc0O6itU2Yw31ODrw&oe=6A50E983"}, {"file_name": "ScreenShot5.png", "id": "1433618705115507", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824671_1433618708448840_7035026529616538174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vm1P7yPfNFcQ7kNvwGFhVJy&_nc_oc=AdqRYCvXfMl2cZChHg5hqz3jxsFoDn0ZhjsFANj_bsKyHE1cfUya-1Ya92wZMGcg1QA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAIDKkWRxPkdeQe2QvfpaNuFhCWG2dqNIuZmS35CkiDVw&oe=6A50F189"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Snapshot.PNG", "id": "848476604929184", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820983_848476608262517_5008057075773251413_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s9iBgKWYHLcQ7kNvwHyNqzi&_nc_oc=Adoqgp7UkE21yj495fNU-hm-oDuSp5gy_qiUG6BHj4XkXLtq8cbFLIRfc_OmrzqaOww&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCKLpAZ4kl9XbqWa-1c3Y_3gCrBc0a0rP_EJ5ASlW4JXQ&oe=6A50E642"}, "display_name": "Human Anatomy Tutor", "keywords": ["Human", "Anatomy", "Body", "Bones", "Muscles"], "long_description": "Human anatomy tutor is an educational VR Experience that let you learn about the anatomy of the human body on a more didactical way than the traditional textbooks. \n\nYou can point with your Touch Controllers to any part of the Human skeleton, Human muscles or Internal human organs and hold that body part to see it better, you can see the name of the part (so you can easily memorize the name of that body part easily and see how is located on the human body) and you can extract more information about that body part that is publicly available on the Wikipedia that is stored locally on the App.\n\nThis VR Experience do not require an internet connection to work (100% offline), and is available on the following languages:\n\n- English\n- German\n- Portuguese\n- French\n- Spanish\n\nThis VR Experience present the human body in 3 layers:\n- Human skeleton\n- Human muscle system\n- Human internal organs\n\nThen you can hold any bone, muscle or organ of the human body, see the name of that part and read information about it.", "short_description": "Human anatomy tutor is an educational VR Experience that let you learn about the anatomy of the human body on a more didactical way than the traditional textbooks. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-notice-last-updated-april-15.html", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are-we-indie-virtual-reality-video.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26546007115041952"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "954321543971483"}]}, "baseline_offer": {"id": "954321543971483"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1776347700, "status": "PUBLISHED", "id": "954321543971483"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26585197611122902", "version": "1.02"}, "id": "2141458416630778", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBi
50_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kxJz4i44ndsQ7kNvwHfj_Wv&_nc_oc=Adrehrxm-bytrsJJvJDcfh_klLIsBZ0WuOdBYfHkhumQAyHNGOS0-o0t1u_ATwX6AIA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQurF3_FL5KN7lv9fhPwsGG5UJLlqbXbsWdNml-a-kB0Q&oe=6B01DB17"}, {"file_name": "ScreenShot3.png", "id": "988852023573455", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821081_988852026906788_5249986527094067898_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WrIJDZvw0j8Q7kNvwHCpE-o&_nc_oc=AdoUqIRb5KfXgGrusCUPSX4_PthBwdA9232LFMRsbftnfylb0RydmnhPbvAzNdGbivc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8XtIu4FWGv1hze74ECVerN_OgJvQGgGek0lnqaAyC6g&oe=6B01CAC3"}, {"file_name": "ScreenShot5.png", "id": "1433618705115507", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824671_1433618708448840_7035026529616538174_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9UGrPMZ41P8Q7kNvwG-iNQA&_nc_oc=Ado5CivYqxYI3q_n7kl-v8ej5UP8odvNtrN4FG6-VRsgkFEi1a-hheV5blhqF_09pcU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1J_PDRp1WSIJRixz3LiX3CZLDSVI4ypu3EOBAq8PR1Q&oe=6B01D2C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Snapshot.PNG", "id": "848476604929184", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820983_848476608262517_5008057075773251413_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e0OijHflAbEQ7kNvwHqy6k-&_nc_oc=Ado_YaggKbdw-JuDYGil5j_J71d7NQzPAgB25e6GZhs_QtjGqRODaCw-oPiiTYkJXWY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxdiynvOqUBsUDebWy4ewEYaq7JEYduVMbNGcDXQtQuw&oe=6B01C782"}, "display_name": "Human Anatomy Tutor", "keywords": ["Human", "Anatomy", "Body", "Bones", "Muscles"], "long_description": "Human anatomy tutor is an educational VR Experience that let you learn about the anatomy of the human body on a more didactical way than the traditional textbooks. \n\nYou can point with your Touch Controllers to any part of the Human skeleton, Human muscles or Internal human organs and hold that body part to see it better, you can see the name of the part (so you can easily memorize the name of that body part easily and see how is located on the human body) and you can extract more information about that body part that is publicly available on the Wikipedia that is stored locally on the App.\n\nThis VR Experience do not require an internet connection to work (100% offline), and is available on the following languages:\n\n- English\n- German\n- Portuguese\n- French\n- Spanish\n\nThis VR Experience present the human body in 3 layers:\n- Human skeleton\n- Human muscle system\n- Human internal organs\n\nThen you can hold any bone, muscle or organ of the human body, see the name of that part and read information about it.", "short_description": "Human anatomy tutor is an educational VR Experience that let you learn about the anatomy of the human body on a more didactical way than the traditional textbooks. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-notice-last-updated-april-15.html", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are-we-indie-virtual-reality-video.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": 
08D20"}, {"file_name": "ScreenShot1.png", "id": "4103345429956830", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823270_4103345433290163_4264538028001096750_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=edkce4WhcrUQ7kNvwF0yn-c&_nc_oc=Adrsb0KK6jM4DtDieWB2xFdgN18KqEAchkIwnYpp-rVS6FbF6uWK6D8HvKT9q9U8Ml4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Az5_7_tz2N9uEWzMTGoE_ROBVtdC0WWy6dNcb-kMXyg&oe=6A008E57"}, {"file_name": "ScreenShot3.png", "id": "988852023573455", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821081_988852026906788_5249986527094067898_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e_8drYl260UQ7kNvwGc_wXC&_nc_oc=AdoLUS9Yi8E91WqUvjJVxtEw_BUG9_0SBElNJGqmYgGT-O2uGoM0NmdyOzL0k96uZ3U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4xWd2IYegZwk8Y_arx7hQxyCra0f2bHzpYsdG9Rg1tKQ&oe=6A007E03"}, {"file_name": "ScreenShot5.png", "id": "1433618705115507", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824671_1433618708448840_7035026529616538174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=10nA-g1J3_AQ7kNvwH8b2cT&_nc_oc=AdrxoTsOJhdptLBqcMs4UnpiVuFiDv7EA9MXFRgaPG61iMlh20H775C9WBqFD6OGrjM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af419xJ4PQu2tm_HakaTL0z0ozlaa_XfPIvSJbHdXPYY2g&oe=6A008609"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Snapshot.PNG", "id": "848476604929184", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820983_848476608262517_5008057075773251413_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gJLeK3D7p_oQ7kNvwERVGfx&_nc_oc=Adqxta74g4OQCv10Cn6QSykrlLWqxpSRDckkl-G0KKUAO5wsccO90_qnPr56qjZtNNg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6GL5SjyIRpin3U83yk_ErTgB4XGi86wqfivhawEl9IvQ&oe=6A007AC2"}, "display_name": "Human Anatomy Tutor", "keywords": ["Human", "Anatomy", "Body", "Bones", "Muscles"], "long_description": "Human anatomy tutor is an educational VR Experience that let you learn about the anatomy of the human body on a more didactical way than the traditional textbooks. \n\nYou can point with your Touch Controllers to any part of the Human skeleton, Human muscles or Internal human organs and hold that body part to see it better, you can see the name of the part (so you can easily memorize the name of that body part easily and see how is located on the human body) and you can extract more information about that body part that is publicly available on the Wikipedia that is stored locally on the App.\n\nThis VR Experience do not require an internet connection to work (100% offline), and is available on the following languages:\n\n- English\n- German\n- Portuguese\n- French\n- Spanish\n\nThis VR Experience present the human body in 3 layers:\n- Human skeleton\n- Human muscle system\n- Human internal organs\n\nThen you can hold any bone, muscle or organ of the human body, see the name of that part and read information about it.", "short_description": "Human anatomy tutor is an educational VR Experience that let you learn about the anatomy of the human body on a more didactical way than the traditional textbooks. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-notice-last-updated-april-15.html", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are-we-indie-virtual-reality-video.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "su
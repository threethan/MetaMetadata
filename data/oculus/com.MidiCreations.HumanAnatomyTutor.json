&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TSlE_Cv04tUQ7kNvwG7DIrv&_nc_oc=AdqyXjVDbjHd_sgB8H5GrI057Pj6tDyn7FH5v-F66jtzUn_BFB4bStkAFZVhQDz6xZg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rqr_ZQlecrBrhKvGj1a3Gsytv4tlYRp7_7xhPuDbChg&oe=6A3A8F20"}, {"file_name": "ScreenShot1.png", "id": "4103345429956830", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823270_4103345433290163_4264538028001096750_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vSv-d6VuYa0Q7kNvwH3cReF&_nc_oc=AdpNYM-BepeO6hZsZcubtbSWM6WdAx_eaRI9WHNT8t7yZa7o5W5hpufPV3z3rnX7PSc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_nJ2bkBO4FmiIy9k7gFRC0YAwkdkNm4r8wxzv5w499Zw&oe=6A3A9057"}, {"file_name": "ScreenShot3.png", "id": "988852023573455", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821081_988852026906788_5249986527094067898_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6AKQdB4luzcQ7kNvwGnR8zv&_nc_oc=Ado7r32RNQFogJzsOUS8_O21npLnSJQRCKY4Eljz5cUFyDJrSJz-2b_XHqaFVNPcLIM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8o0l0Eg04xNWAgM0xzAKx9w0orVQ9cyBnT96ZSpU5lUA&oe=6A3AB843"}, {"file_name": "ScreenShot5.png", "id": "1433618705115507", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824671_1433618708448840_7035026529616538174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TueCaV6B94UQ7kNvwGRe5gr&_nc_oc=AdrXGfC2r50du-dWFqQ0UsUOYRg0OgAUWCWTqSgSnUhrrWfZiYTTjwX0XOJltwvHjSk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_YPTJcwm0jRAn9NizXAVWriMDujKAKlZeM1TycTuBIkg&oe=6A3A8809"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Snapshot.PNG", "id": "848476604929184", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820983_848476608262517_5008057075773251413_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XbFaMExdpbMQ7kNvwGu3WNq&_nc_oc=AdqUYsTXKVyjN4isXVaxFsyAZk6RLxmu7dg5ADo4sAmlmfrBigOJovSZDgJVeCwnbJI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8hxEmGAPSw5BGpF5UWmDUnxkQE74ZRW2VGRsFiyaMSJw&oe=6A3AB502"}, "display_name": "Human Anatomy Tutor", "keywords": ["Human", "Anatomy", "Body", "Bones", "Muscles"], "long_description": "Human anatomy tutor is an educational VR Experience that let you learn about the anatomy of the human body on a more didactical way than the traditional textbooks. \n\nYou can point with your Touch Controllers to any part of the Human skeleton, Human muscles or Internal human organs and hold that body part to see it better, you can see the name of the part (so you can easily memorize the name of that body part easily and see how is located on the human body) and you can extract more information about that body part that is publicly available on the Wikipedia that is stored locally on the App.\n\nThis VR Experience do not require an internet connection to work (100% offline), and is available on the following languages:\n\n- English\n- German\n- Portuguese\n- French\n- Spanish\n\nThis VR Experience present the human body in 3 layers:\n- Human skeleton\n- Human muscle system\n- Human internal organs\n\nThen you can hold any bone, muscle or organ of the human body, see the name of that part and read information about it.", "short_description": "Human anatomy tutor is an educational VR Experience that let you learn about the anatomy of the human body on a more didactical way than the traditional textbooks. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-notice-last-updated-april-15.html", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are-we-indie-virtual-reality-video.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_
50_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u3HTvb4vQ7sQ7kNvwEZlpre&_nc_oc=Adoy99tBTHjqfI5uYcBWVztr86wN7yE_m1CPlyf9SRC8OK0v5dH24Y5N_94hM0P9Nyc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSj9kC2pWzKXtwH-isvYythuBk0v82hHzIhNuHB41rYPw&oe=6B005157"}, {"file_name": "ScreenShot3.png", "id": "988852023573455", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821081_988852026906788_5249986527094067898_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tj19UE-6NqQQ7kNvwEPfyvY&_nc_oc=Adr0QbQia2-pVhtPExgVYRBPGAlpvsYftKMJoTMkq3Ytj4qaBlb4or8PZHu6Njo4Nro&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThGkmi9WomynIdFAsAwFIR2IutUmYFV-sD8U9LQjj-AQ&oe=6B007943"}, {"file_name": "ScreenShot5.png", "id": "1433618705115507", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824671_1433618708448840_7035026529616538174_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9UGrPMZ41P8Q7kNvwEjFeAI&_nc_oc=AdpEFKLXRkNwVSb2XP2iOWC05Qfm7zn8slt4qoz4RmSQHhgyp_JxOa9911uCHcs1C9g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9jp7PZ-REWPJQgjGHNZKi6CjNQChQS7qtsJhfw2JHGw&oe=6B008149"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Snapshot.PNG", "id": "848476604929184", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820983_848476608262517_5008057075773251413_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e0OijHflAbEQ7kNvwFDRNgd&_nc_oc=Adq9TIsZ2Q0TCHmEQhFmE-W_JYZ9auJJVfmuYuHxT4OQdQC-Z2en3537r73gnsgxAiM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWonW2YZNV3OjXTh3fVTvci7MLwjuwvRvIZMGR0jDt1Q&oe=6B007602"}, "display_name": "Human Anatomy Tutor", "keywords": ["Human", "Anatomy", "Body", "Bones", "Muscles"], "long_description": "Human anatomy tutor is an educational VR Experience that let you learn about the anatomy of the human body on a more didactical way than the traditional textbooks. \n\nYou can point with your Touch Controllers to any part of the Human skeleton, Human muscles or Internal human organs and hold that body part to see it better, you can see the name of the part (so you can easily memorize the name of that body part easily and see how is located on the human body) and you can extract more information about that body part that is publicly available on the Wikipedia that is stored locally on the App.\n\nThis VR Experience do not require an internet connection to work (100% offline), and is available on the following languages:\n\n- English\n- German\n- Portuguese\n- French\n- Spanish\n\nThis VR Experience present the human body in 3 layers:\n- Human skeleton\n- Human muscle system\n- Human internal organs\n\nThen you can hold any bone, muscle or organ of the human body, see the name of that part and read information about it.", "short_description": "Human anatomy tutor is an educational VR Experience that let you learn about the anatomy of the human body on a more didactical way than the traditional textbooks. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-notice-last-updated-april-15.html", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are-we-indie-virtual-reality-video.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": 
0nS9A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9DzvIBTWAvHggUHBdTqM6J3FzAEFrY52aD4F-VpjhZpw&oe=6A296BA0"}, {"file_name": "ScreenShot1.png", "id": "4103345429956830", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823270_4103345433290163_4264538028001096750_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NIjOvBKIH0EQ7kNvwG_1-P-&_nc_oc=AdosYQbMVZM7FP9aOQ9dZZMReMPTGqke_7vCWq_6sN74jyfKTX8Ul1d3Q6pyUiTQLRo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-zHhrGeKr7gSHfToYSNWYsQG2bu_X-CkeCoG9idHap_A&oe=6A296CD7"}, {"file_name": "ScreenShot3.png", "id": "988852023573455", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821081_988852026906788_5249986527094067898_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w4914CsEBoAQ7kNvwGv6cOQ&_nc_oc=Adr2-_-HH7kLljgH0Yp3QVfzXnF3uIvmY3gLqDGXPahWllj1YKrTfrrN8vpbjg3b4MM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-7tDCvb4n4E-PKt_D692w_EjsqCXOXE4ISqfdWYgURSA&oe=6A295C83"}, {"file_name": "ScreenShot5.png", "id": "1433618705115507", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824671_1433618708448840_7035026529616538174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lzltaksBvAkQ7kNvwEo5YbG&_nc_oc=AdpOBN9ZC2gxd66yqzbL7iS5LYNoTwrJpf0h6iDgnE28PgodDLrWlg0IZZZsiYuBNb4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-56Jt-khCo9JEn4hogGb4rrUcEevmQaBtcKpyGu7rU0Q&oe=6A296489"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Snapshot.PNG", "id": "848476604929184", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820983_848476608262517_5008057075773251413_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cie6f-iAS04Q7kNvwFhHeNd&_nc_oc=Adp-iH7-R5pUHzUS5TLPeZI9q2x9MFUD755qlDrOmUrqsNGtsP6L4sQIhY5yQFfSlbE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_BLw2mhqECC-CxCKA8tqTvZBkHG6ULsSfFrI59VV7NZQ&oe=6A295942"}, "display_name": "Human Anatomy Tutor", "keywords": ["Human", "Anatomy", "Body", "Bones", "Muscles"], "long_description": "Human anatomy tutor is an educational VR Experience that let you learn about the anatomy of the human body on a more didactical way than the traditional textbooks. \n\nYou can point with your Touch Controllers to any part of the Human skeleton, Human muscles or Internal human organs and hold that body part to see it better, you can see the name of the part (so you can easily memorize the name of that body part easily and see how is located on the human body) and you can extract more information about that body part that is publicly available on the Wikipedia that is stored locally on the App.\n\nThis VR Experience do not require an internet connection to work (100% offline), and is available on the following languages:\n\n- English\n- German\n- Portuguese\n- French\n- Spanish\n\nThis VR Experience present the human body in 3 layers:\n- Human skeleton\n- Human muscle system\n- Human internal organs\n\nThen you can hold any bone, muscle or organ of the human body, see the name of that part and read information about it.", "short_description": "Human anatomy tutor is an educational VR Experience that let you learn about the anatomy of the human body on a more didactical way than the traditional textbooks. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-notice-last-updated-april-15.html", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are-we-indie-virtual-reality-video.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommen
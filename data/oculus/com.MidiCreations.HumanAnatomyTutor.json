oc=AdqpjAo0nDKYNR25hnwSA-DfOywB7s-rHYYY9xOJlXYp_DHTBvRMPFf2oXbDZWFE0EA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af35FzzoELIvOqcIQhmaCKMeJ0xmwNPa8P5YLp7O5qD39A&oe=69E8D357"}, {"file_name": "ScreenShot3.png", "id": "988852023573455", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821081_988852026906788_5249986527094067898_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rcKaF6G16dsQ7kNvwFu02Qc&_nc_oc=AdqjnTMxQYt13AtoHTdNsYkuMxzdUtzH3L1k64VbNz-bRypdbmMO9atjqsy-Tpvoin8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2alS1y8JDDMxP_35tfVUNrWdrjtcu9QTdLcUhO_JX9ag&oe=69E8C303"}, {"file_name": "ScreenShot5.png", "id": "1433618705115507", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824671_1433618708448840_7035026529616538174_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7BEBuwyXlvEQ7kNvwGawq8X&_nc_oc=AdrYT5Kpvo5H2B_0RhIkbzT-JjXy-q9DRICNC3Le5R6O8a4phuxSqZvpN1mDnyUqYLU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3hxvA7-YMML6ow5sEso32ogSCnME9wFmEiVnYz4X9CcA&oe=69E8CB09"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Snapshot.PNG", "id": "848476604929184", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820983_848476608262517_5008057075773251413_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Flwbd5Vb00IQ7kNvwFJ2GbD&_nc_oc=AdplWAJv-awZlCj-pTosjmPPo8mn6RAU9fJKFDrXu7936ergcUctJVJtDfPo27D4kC4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1mxgUfRo6rgND4xLopbagef0z4KTSw1WGF9MxlC8ZDNQ&oe=69E8BFC2"}, "display_name": "Human Anatomy Tutor", "keywords": ["Human", "Anatomy", "Body", "Bones", "Muscles"], "long_description": "Human anatomy tutor is an educational VR Experience that let you learn about the anatomy of the human body on a more didactical way than the traditional textbooks. \n\nYou can point with your Touch Controllers to any part of the Human skeleton, Human muscles or Internal human organs and hold that body part to see it better, you can see the name of the part (so you can easily memorize the name of that body part easily and see how is located on the human body) and you can extract more information about that body part that is publicly available on the Wikipedia that is stored locally on the App.\n\nThis VR Experience do not require an internet connection to work (100% offline), and is available on the following languages:\n\n- English\n- German\n- Portuguese\n- French\n- Spanish\n\nThis VR Experience present the human body in 3 layers:\n- Human skeleton\n- Human muscle system\n- Human internal organs\n\nThen you can hold any bone, muscle or organ of the human body, see the name of that part and read information about it.", "short_description": "Human anatomy tutor is an educational VR Experience that let you learn about the anatomy of the human body on a more didactical way than the traditional textbooks. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-notice-last-updated-april-15.html", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are-we-indie-virtual-reality-video.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26546007115041952"}, "review_messages": []}]}, "cover_square_im
https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499300807_4219558884974658_8236595694685100277_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rhZVLPowrQsQ7kNvwEs3aTe&_nc_oc=AdoYP0ClGPHWSxDwXina-4Qs0Iqu4bqTKbvlgcLk0GRZa0IiGHml0txjD2K_4GvWro8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA2FbX6oH39R13OTp-R86kQXMMbt5cCtuxBYZf_wD2zoQ&oe=6A52336E"}, {"file_name": "LaGame_Custom..._08.04.2026_23-15-36.png", "id": "2086382645542428", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499295566_2086382648875761_5404561521702394411_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ypCePUk-M20Q7kNvwHUfato&_nc_oc=AdoDMj2SLoUaSyQsADGuHSE560P_u2kENuewn9_hpe14KY0eAF1a9B4wFYPH1I9WBKQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQArEJNzKf0U2HYAQa6CTn2ngo9fk8NCU7OWM9W2Q0jU6g&oe=6A523C52"}, {"file_name": "LaGame_Custom..._13.04.2026_17-27-31.png", "id": "789745183929886", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499310720_789745187263219_2885589204408317186_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cPEz9x-6QJIQ7kNvwHFMq7M&_nc_oc=AdoaGE4o0VNpNZAQOu-K-wd_1R0u6R1xh9sQAPhN4gORnjVlqOXWWn9T74VXJGw9XGU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDL5b5b0mReafekziEEneSKGjc2b4ehpKptU9jz3qt_ig&oe=6A5253CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Echo Bats", "keywords": ["fun", "gorilla", "fangame", "kids", "happy"], "long_description": "Echo Bats might be one of the best Gorilla Tag fan games, featuring a variety of fun and unique mechanics that set it apart from other games in the genre. Inspired by titles like \"Cube Runners\" and \"Gorilla Tag,\" it builds on familiar movement and gameplay while introducing fresh ideas to keep players engaged.\n\nExplore immersive environments, experiment with new mechanics, and enjoy a wide range of activities designed to keep the experience exciting and repayable. Whether you're climbing, moving, or just exploring the world, Echo Bats offers something for everyone. With its creative design and focus on fun, it delivers a unique and enjoyable experience for both new and experienced players.", "short_description": "Echo bats is a free game that uses Gorilla Tag locomotion for its primary movement, it\u2019s an amazing game with unique features."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/echo-bats/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Bubbles", "support_website_url": null, "website_url": "https://sites.google.com/view/echo-bats/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26613302601657826"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499303471_1510612600584620_770069735017525477_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YZYhQqd00CUQ7kNvwFjFQsh&_nc_oc=Adr1H8Bh3EUbkOlNNnrXpJP6rQyqI88GrX6SXguH1jPVBByAl_g_ZEnrhuvRwuMmWgw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAyG1In2OZpMeirS8OGNECbRjsGTLMRqi9lF-fb_S1qBg&oe=6A52563C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Echo Bats", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "274332603592
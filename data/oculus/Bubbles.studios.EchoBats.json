oth new and experienced players.", "short_description": "Echo bats is a free game that uses Gorilla Tag locomotion for its primary movement, it\u2019s an amazing game with unique features."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/echo-bats/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Bubbles", "support_website_url": null, "website_url": "https://sites.google.com/view/echo-bats/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26613302601657826"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303471_1510612600584620_770069735017525477_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JEOuoD6G2rcQ7kNvwHb-p6x&_nc_oc=AdpZQwT8a8lXPwwVRDJKuSJvOXkPHKxsiuQUZhnulLLJro_iBog_jNyFZVtyBdR4AMA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3E0C2fuNhA3mlSFW9DElW6rJ2KsAs6pBHsuT3MEesB_Q&oe=69F0C73C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Echo Bats", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Platfor
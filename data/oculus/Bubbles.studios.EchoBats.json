https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499300807_4219558884974658_8236595694685100277_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VG44X-VUITwQ7kNvwFmYXbW&_nc_oc=Ado-Tt86Ck0TSEqNg0uuaivfpqxjNB_KZcRUCGAmubvHuW6PBpbaw_zZvhwDObxF8dM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7LEvcRZuUYC5Age5uwnEY-w6KAbtdPYOpxSOQQNxKtsw&oe=69FC81EE"}, {"file_name": "LaGame_Custom..._08.04.2026_23-15-36.png", "id": "2086382645542428", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499295566_2086382648875761_5404561521702394411_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PSIyIdDi_LEQ7kNvwErl7N7&_nc_oc=AdqfHLNj4L4JNWHuUIubKf3erx8oxbgRs8WI-kmAiHacuIamFM12ylxz7tc2BMinSgU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5C-1G10JVK3nDs5evs2hnRyAIqzjqqfytyh2yJFSmzQA&oe=69FC8AD2"}, {"file_name": "LaGame_Custom..._13.04.2026_17-27-31.png", "id": "789745183929886", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310720_789745187263219_2885589204408317186_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=joILQOUKaAsQ7kNvwHq5Rgs&_nc_oc=AdrG-EPD9pbRyoQjfFXEwwuEu6HHX5w0vCNSCxwrqOT1pqWQiZ5L6rwyWIlDJEh2g4M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ZWyiylj6RnZF6QQtXV9o4aj7LqytDB5c_a7IBKxatIw&oe=69FCA24F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Echo Bats", "keywords": ["fun", "gorilla", "fangame", "kids", "happy"], "long_description": "Echo Bats might be one of the best Gorilla Tag fan games, featuring a variety of fun and unique mechanics that set it apart from other games in the genre. Inspired by titles like \"Cube Runners\" and \"Gorilla Tag,\" it builds on familiar movement and gameplay while introducing fresh ideas to keep players engaged.\n\nExplore immersive environments, experiment with new mechanics, and enjoy a wide range of activities designed to keep the experience exciting and repayable. Whether you're climbing, moving, or just exploring the world, Echo Bats offers something for everyone. With its creative design and focus on fun, it delivers a unique and enjoyable experience for both new and experienced players.", "short_description": "Echo bats is a free game that uses Gorilla Tag locomotion for its primary movement, it\u2019s an amazing game with unique features."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/echo-bats/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Bubbles", "support_website_url": null, "website_url": "https://sites.google.com/view/echo-bats/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26613302601657826"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303471_1510612600584620_770069735017525477_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XtH4AV1hc40Q7kNvwGizJL2&_nc_oc=AdqjECkfRKuMr2WfN3l4vbgwQfI138RNKEbHO5znFvKL0FfU77SNveOzmSOUyMGU1xg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5lraV9Ten5lHGWLynrjx3nzvHPd33f56IJ9CTIAlJ8EQ&oe=69FCA4BC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Echo Bats", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "274332603592
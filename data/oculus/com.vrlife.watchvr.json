 interface is very well organized trough channels for an easy navigation.", "short_description": "Watch the best Indie VR Movies and videos!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://letswatchvr.com/privacy", "developer_terms_of_service_url": "http://letswatchvr.com/terms", "publisher_name": "VR Life S.L.", "support_website_url": null, "website_url": "http://letswatchvr.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["MOVIE", "MUSIC", "MUSIC_VIDEO"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "634213567691137"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12139002_970685139704914_6507232270733017088_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z55bsQCynA8Q7kNvwFSA9u5&_nc_oc=Adpz6fskIFPwf4RSEoxwrmzSiwdjvfW7J1R8LhDkc0ByTH9Yu53jpBmqfIca7CxVRoQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpiSBMTLX39vIkyn9eQs30kPzL5fnp9R1Vr5yHVVv9mA&oe=6B0056E6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Watch VR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1485302972, "lastRevision": {"nodes": [{"id": "1294950680539119", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1588092357883622", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID"}, "iarc_cert": {"
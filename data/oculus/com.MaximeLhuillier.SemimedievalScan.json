244715", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MR-VioNYiGIQ7kNvwH1M-Kq&_nc_oc=AdrHQGHOTb8lExup_INP3-jKORkDmYVxsaFDCU2JH7Zp3rPgZ70pEEq85qoxfbM6qAI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLA-C4czwy3ZHployDWxbVrctpKitRU-1rCocwli2TY4g&oe=6AA02E34"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hFC0wSeyez0Q7kNvwEcT52q&_nc_oc=AdpcY1Q5vGooZEc_ytvoMw9XcGsa3YaAjxRWsUfBOEhDLj7yQKmLQPCUAbuXaYdJWjQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLIYBfb1Fbr79GEHGagKyWglePYhgECvBxMY8ugAOisIw&oe=6AA00DCB"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W3ZnYruXUPsQ7kNvwEExTGa&_nc_oc=Adq2M14ZdVAISK0IwIexyaAkAON3JTTUXbwHfl-3nukZ-mP1spPUzPd4Cdfv5UigDvE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK10-VVkktKacbxVaI9e3xwRgCUFeb1Z2O7ITWMjvW9vw&oe=6AA021E4"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lrVok7ACuCQQ7kNvwG4iAz5&_nc_oc=AdogytXlNqEAjIPD4B0UUTBAXI0y578WCj2rWWhWT14PH9twr-yAnctMBcFPiJaS_ZU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKu--oJMNLALjeaKzhJvEiVeJgi6M2vOc-zhW1mOKvNEA&oe=6AA00B60"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ZkBvdMKdwkQ7kNvwGCyKHq&_nc_oc=Adrxp1T1NPB0qZMH24ePQh0lIrKJeZc28MM0vOn2OfIQS44MwYQy9vWNMX19DaIZEmc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0svZdRhxkGCRosxaZpevNZJd-19BL6k1BcG6TYtuogQ&oe=6AA00DFC"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
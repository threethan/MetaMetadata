": "Screenshot0.png", "id": "1235098807268738", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982658_1235098813935404_7719619199213845753_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=miYDGDHlht4Q7kNvwFUyVPc&_nc_oc=AdovHsk9qlmIMuiuSqq-_5ik3E0QCo5KWgOmv0aX-Xc5qxIEYIcpWZ5S36fBGuTzCYs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTHiutneUJAk6VCDKL0484EWPTeIVeWshZ_BlPwZSoChw&oe=6B0B3A48"}, {"file_name": "Screenshot1.png", "id": "1079721616244715", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0-eG_rUU2TEQ7kNvwHg--CC&_nc_oc=AdqvT6uLzZIsYYLgzk-RjlqwlI4ZOLugKk14H0nIxK1W37sMSJFNq-8mMn0xiUFNlvY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTERx11t9DNohqda9HLfZCSt4ktb5z7-KP2fAWYYQLq8A&oe=6B0B2FF4"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yb5VDyNqBdcQ7kNvwHQdxDt&_nc_oc=Adp9sGqYagiqA1OQf8cUakRgPWbi0azWQpnybUiZTYyFwXstvRt6D5UI24GoiJMxxDM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTmSz675zeGUHYxisHGgfVX4Ijbos0-aSneyiHSpxuUPw&oe=6B0B0F8B"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XTAWY11NWI4Q7kNvwG0I04m&_nc_oc=AdoRsYHqUx5Uru_qPv-6kSWDdwQ85ocm6vrZ7esDwQTWIzyRQuXrNZfO0vhxTMbtouY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQyn7xKM4OLedIAhbRW6-uW7aCBe_gYm4IWP1X0GgQgvA&oe=6B0B23A4"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TVXa4WHS0HIQ7kNvwEdZ2-0&_nc_oc=AdqTE9lIu9VwyPWCWJ2OB69IwsBT7AQ9QBGQoJVyKzgwyGkXInvFdlbH2mtHbaQtfvY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSx1vvXwZ3wK02ydQMdK7ruTcXSgNccCekCOjh2ACn7sw&oe=6B0B0D20"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mE8fKkH5TkIQ7kNvwHwjUKc&_nc_oc=AdqrgE1syX_s__eJ-1lCfEw4le6hqVSXRCe76r0rveMti_MLESj-B0rE-a20WzWNsOc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTYwdbJLUwfnvpprtPciJAIHvs63PV9dG6K-55TFXeMYw&oe=6B0B0FBC"}, "display_name": "3D scan of a semi-medieval town", "keywords": ["photogrammetry", "reconstruction", "360camera", "digitization", "scan"], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8744915575541513"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974593_643470730539088_3502460444141589985_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AdvcSC7gsEgQ7kNvwGYIA_t&_nc_oc=AdobWdoR-_5fV-hE_zP_pHNuC0SpIprI-PLkFfivwyfwE4kVQOC3BoWjVBiLhXOPBeg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQqgPOKU_9lSGM1ql8j702Nt8I1eNHQtZNDnsfDj4qDdw&oe=6B0B0CB1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "3D scan of a semi-medieval town", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Travel & Exploration", "id": "
244715", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5dMIsBBkLQAQ7kNvwErap6R&_nc_oc=AdoInyLdwi7mwLMPVEl8_xDhuoUF86oqsFvo30X14z3cTpXRYMvnso3ZmFHEb2ytIf8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af07-Ho6ay8k4HXI4oEVefPi-j8YL2BzUILIKaluV85kXw&oe=69F492F4"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0RxzqXtXZuMQ7kNvwF6zjYZ&_nc_oc=AdqW3yE4gAqp0zm5OWir2cuAlAW-vX2nze79COGJmxrh2XLO5kz3M5EhzM5AxVf2XZg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3RcXjBxSEjQG6q1vpbiIdeXvmbYiMY3nBFonPMfen02g&oe=69F4AACB"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7OLUu6B_CyEQ7kNvwFaXbQ_&_nc_oc=Ado0RfXUmXyK--lA37ZXUz3qQOaOX52T_CCH8mCG4kmfpNuIYB9J9GUlqAjpT2LC9RU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0LhUCGWBNjskXVp3flaDHH1vMYj3v752zNxOO1A96nHg&oe=69F4BEE4"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6oHkUKs2BfcQ7kNvwHYzgG3&_nc_oc=AdoTEB5O8EbUko34-4WJdwEqeXKZn_ESi07N-5vA-cgAffVWJhoytQOa84waU02Soyg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1JnjpIegdUkN4xxyErwAUyf_Wf8IZ6G1Ce40poCGbV6Q&oe=69F4A860"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JWXqfBze_88Q7kNvwG2FPhA&_nc_oc=Adpk2EuQnzyGOBcPOW7wa5M8AvHmUye4KBKGreIV9sKiFxqisBVkjliy26VI0L_Ks2M&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af07Z33YhuJonIHwWrDE6SdBEDxln1eDSMlZtWuuV8FLdQ&oe=69F4AAFC"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
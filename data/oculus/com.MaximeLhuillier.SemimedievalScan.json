244715", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A0aiLw6tdKwQ7kNvwGv46w8&_nc_oc=AdoRbfJmCgshA8rQuyTVQYo6UlzdLmaBMyQoYjDTiiBXUgxtGyIuJaKaxlfTJFKsng0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJXJV6K6OWtpJFKNlmkbwIQnAXyCJ0n93s4mF_ZeBe5gA&oe=6AB2A334"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6fTgJJmsYBsQ7kNvwGxQUHA&_nc_oc=AdpJKSf4SMnDfceQhM5I-FVOY5yjFIhSn5bunXilnbrqjqd7VLKGgFaaiEghMmJyf0A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxqIYD4oDly0alQDt7aMo0fVCsRYGh-ygj56Blsbo35w&oe=6AB282CB"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kpkVhoqWHP8Q7kNvwFLrjIG&_nc_oc=AdqkQknVNaxcLo4c-5UMpqrOTIWEGBAOqkkyReJantnRGcA-w9bm_AFADlJgv4EZCh0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7msiH8c2mmfIq5WBmmsZ5zNFI2faACTs6tZI5IHlymQ&oe=6AB296E4"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lfjHywYItVsQ7kNvwGDgSBP&_nc_oc=AdrrbZO8UGX6tBFtbh9EYBV7RjFTbB14meFsJ3Nb4VtaG--QlX77xwipsyjsLVjdZ_E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1Pan68HAuzzE-iN43uJ-2jQikHG6ZEHxh08DFsAthLA&oe=6AB28060"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EV5mebIoM3kQ7kNvwGJFtyJ&_nc_oc=AdrXVERx2wNbCnHQrrLsJZlj2BizdHitRO09gFrGi4jvZR3VknvTIM-OP0n2X5GqmPg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJpE_MRcKnrMFWtO6P6tIpXxolBrPjzV5qNbmFtv8fIfg&oe=6AB282FC"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
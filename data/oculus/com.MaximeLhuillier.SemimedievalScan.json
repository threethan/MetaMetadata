244715", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hZ_6334gKSQQ7kNvwG_Tpij&_nc_oc=AdrurYqy-Ecwk6trwuVI-BEMCcc_a91pTPM9Z2Im-4osRIAK7DzXU37ly6x8bFQQI_Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_mpBOEdEd3Z0952vEe9CQDX2NgfV8n_lEwvMcrC7zaA&oe=6ABE80B4"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f9iSLB5WDCwQ7kNvwF_aZRo&_nc_oc=AdrawnO1YdMQPHsNsJwEEjY6TEk7Gr0GZGEMLeHiveaAdh0Om-qwWZ_Aqw3W6MFi96k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZ2mxIDHztWRKtMcEkKKFcNzGwC0BNWwL5Do6LhaxpLw&oe=6ABE604B"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=auOcODzXH-0Q7kNvwEkX77f&_nc_oc=AdqpWv3hMfd3EVcc-ZVRYro0g55x8GJL9-rlacyPofbKPtr3DAgvx7GLXaZ18ZDB_Yo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJAsW7nvRfr2ZyDlFPxJvyYPvUmmTZN--TgzlaD4NrlSQ&oe=6ABE7464"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U7S9J64khUYQ7kNvwEBVJMz&_nc_oc=Adp5rnfb4dJcCd7qlE-d-V_Rr5Hg34Dh2_WXOwYVkysOxRLtvpaUhEqluOCnCQBKpKI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8hYuNhJKrf97RMElh6goJhgz8hR3yJEvYkJTI4doRUQ&oe=6ABE5DE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MeTV-B-9rBwQ7kNvwGK1gW6&_nc_oc=Adq_tBZ9VwCVloqz6I2KPNiHf23kYTq2bzMSn_J6odICwgOd_olLuj6WDNUGFHTzohE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJR3JVshjiskmionvU1K4TNNm98_5f3R_excA0vLbHWgQ&oe=6ABE607C"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
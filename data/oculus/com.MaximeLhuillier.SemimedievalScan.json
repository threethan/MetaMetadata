244715", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VENZaoGliUwQ7kNvwGvSpN9&_nc_oc=AdogJFFZ-qwsVcM04Mk2oZmQoI-H3jLEY9JzexQarQ4UbD1RPA21D-43eaZpjQU4wSU&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHhDZ6tM1NgM_483VYUQ_KUTTcHLO8XVJh93z1PAIiAXA&oe=6A941874"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qi7al83vFTkQ7kNvwFFLzsi&_nc_oc=AdqCtii8lAkj-YDvr1q78OYRBWtQj865Pm7Qi3hDUpbJmYwABWS2Yiy-xIeLw3MzJaw&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGERPp_LDwWX1adwpKsEK0IlCKowRfbxpiuhGclG_1o7Q&oe=6A94304B"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qnpbs80C8G0Q7kNvwEjmUhf&_nc_oc=AdpIJe-PLI944vMgtgPA6IiSpZDCoXqxDZ7tWNW4ZknxAFvoaxFYg72u2ZK-kY5cVPA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHQhA1-rzxR7joBvKd-Go2mtCwOItgCSyu5QgOY4o0xw&oe=6A940C24"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bk6t1016UcoQ7kNvwHnxYTz&_nc_oc=Adp9-mH_UCKoxeu_25fsr28ikJZh-r0uOabipV7u3I20eRq9ehS-tS70lphcU6DblJ0&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF42XfE8cFJcZBBQHdLcxEVUFr1S8hSz3vrobnhuPMh6g&oe=6A942DE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P5b7hPhDQPYQ7kNvwErXyKt&_nc_oc=Adphd7A1bAmH4NKSVdjhxluOhfOQv4qsZUls3yELkgR_o1F45dFh1Ba9-aO7ApT7VyM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELQU_4BxnhPy4vd9po2DRZMyiCBz0x3cFxPqaB4Awslw&oe=6A94307C"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
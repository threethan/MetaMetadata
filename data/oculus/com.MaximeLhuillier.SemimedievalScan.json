721616244715", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wgJyJeQ0hAcQ7kNvwHYkBBM&_nc_oc=Adp2fkpV1KzTsFjslgbG9gN1eMb9GRepl7aLH1yiWmTe_LBhwxNI94cv52dUY5ZYAso&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxZ2ZqglqJAvUZJuLwPe64quSZ7OHRe5IYzrp_d9SQAA&oe=6AAEAEB4"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K5OtlDog_qEQ7kNvwGE7opx&_nc_oc=Adr1LWT9X4jk8SZJilX3XgjgPysN3DQGcMpBAScJ7-CuWBtsqY5yEM_D_YuA5ovNjEY&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-JEY6hif0E9w3xEB34VnD_JL6vjCFhYvpJ3eBKdoxow&oe=6AAE8E4B"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rz6i7YnHiOoQ7kNvwFOU09f&_nc_oc=AdqshzxeYrDwG7ibRo_d2pNd8HMRcjwFsC3te4378X90RBrV64GUk9V2VQimBoDeJE0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKn6iUQYp_HdvDv7ElTqRi15vbwBX82G98DLb8F8p6g5A&oe=6AAEA264"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vixyYRBMBOEQ7kNvwG8IfbK&_nc_oc=Adp8bkYG7ifsHEv4leMvf6gfEH-yB7nbhjigmlSQSrN3Iu9CeYKTxsoIMMx_irrHRLA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHayLxvCMYkhAPAeboNXnWqBB6-iiqt2f-nhdhoqlDmQ&oe=6AAE8BE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u4d0DRqHpDIQ7kNvwHOouKI&_nc_oc=Adr5CAvW5LUkF4S-K_xmGahuOfW-rSLfjTZfiCNqjbU54SslliJrucqVoy99WdEyg5U&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6z-lx1_YE_JKNq2PagDT06Zyi8GHGlE04zpxxQMSpng&oe=6AAE8E7C"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"},
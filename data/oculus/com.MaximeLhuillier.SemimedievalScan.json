244715", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jTchx54v8EwQ7kNvwF-LH7G&_nc_oc=Adq-iS0rIsN8QuPmAQyX-7V8QIwgG5_5oLTejiwyd_c1OTTOcJt5KQn9YTiOKDbGlLE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCL-bXvPklKwdni38a-uk6AzJA5JkPdg7_LRhc7HxMABA&oe=6A65F3F4"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AnD5hBs37FAQ7kNvwHBpNHR&_nc_oc=AdqTtWbWtL0yL1WJPJD4ZFekMfNoqFB4RwE-Tklt7Sk4gqnaaW_50W54ubZINpoARYc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDgTQgIHc2uguPsQLdtZiPdyStqsfSs3dTWNv-uyK8G6g&oe=6A660BCB"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iwcuhN1BqSQQ7kNvwFoaI7y&_nc_oc=AdrHQqkzTqZvuVUHXXvpIn4Pq44uUJjuxF6Pb2HoipX6HErHxZlmk6cIK6qQ0ykzBNg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCV1S-FSTmeq3pN-XIgBU-ApkcoDJPHKCPAhvnTFVA2AQ&oe=6A661FE4"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j9LZK_OTukcQ7kNvwER6Gog&_nc_oc=Ado4cz1Xrk9b1z-PtMCyLXOTTluz8pPwjwq_pPCrIFaw7LcwQsPFNjgTmYT3VZc1t7I&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDY2ay6q7Wkr6TMKFG7FfgoOYWNJaw6LqBAbm7nJG4dtQ&oe=6A660960"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zki8MEyzw9QQ7kNvwFgTf6t&_nc_oc=AdpilUz7sz8nsvZFcBa3MKlf4f3ehB3bqqo0IAGs725w0L2c3JEuzy1L5za3lzh0Wfw&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6pwSDvdQgRvYL7ve3zTuKQJhp-MNmFKBPSEhzumsykw&oe=6A660BFC"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
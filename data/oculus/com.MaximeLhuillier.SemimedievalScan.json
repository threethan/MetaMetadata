244715", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rSZ4YA1gtWgQ7kNvwFTbHzC&_nc_oc=Adp_ztCbusZQe5LuXI4YfVTIsf884FafOpLRjjP2WvMLbyv4QCSDP0It140KFeYuP6w&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxPWEvZcfoO-iG89cG7I5lswskmPi_G-_UkWhbEwt3oCg&oe=69C279F4"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KlT3eRsYu1IQ7kNvwElMLxr&_nc_oc=AdpVL_SpFs5aDgGMJRVZu-Mi0gTX-ph6z1v-F3pJuNzo9rnepX-ifSMDNTfA8uO8lWc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyFmZARLZslkQznGxzhQSqUCWXLoSFLQuzJrvaycs7vhw&oe=69C291CB"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wq4wUdgXpyoQ7kNvwF2NxGE&_nc_oc=Adrsp0DNiT3jNUqh989RSmg7sP0JYjh9m_oQ_YVDhsf8W3r6ZdbpmqU6omOHXjd06LE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz-yj-YqoHnNfGSy6nnPMIldzri9Gy-VMz3hMcJKyTLdQ&oe=69C26DA4"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oZxsbc_rLKkQ7kNvwGuF59C&_nc_oc=Ado3LY6DgXL6FpUMRa-PYtso-O7F_-U8dSBlb7ZE7GbRXKqd1qdyg2gfAu1F3tnRMp0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxtJ0KhE-wYhyE8Xxipnt56scajqVrrrSNsXY9LVkEpEw&oe=69C28F60"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B_9mK-BZ9JAQ7kNvwHZ5bWo&_nc_oc=AdpYkD5AqzDEzCD55P4Q_pA7FUYE6AWXY3BZcOk0wn96C-t5I4eMD0Tvt6qicm7aasA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw4BmQ0X92MKPc58WXX5tgpCqUmrrOAmcT7ND0eAuOjTg&oe=69C291FC"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
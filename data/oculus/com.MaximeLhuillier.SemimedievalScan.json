244715", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6gTPZ_EcmCYQ7kNvwH3e0eC&_nc_oc=AdrhsKuIeWivEFBGiBMtH7Gi2c6nZcmCalrawi3rgXc0pIH8HQA8YI_gJJeGYlGbsdc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af705s7f_p24ffd7kUJTpQpNXnOg82DajdZIQufQ28TRuA&oe=6A0F2934"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tAs1pYvk-soQ7kNvwGc9c1C&_nc_oc=AdqFSjEyWCjck5qtnaR_yceeUMnC96Rfqj6LkUMGYYW6KHUQgSl86Dy5d5xUnR-w6Ig&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6G4MXqeiVAPEgCTDVymuQHfX8F1b53--OrV8n5h--dLQ&oe=6A0F08CB"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Taqb5ne7IBAQ7kNvwERCzak&_nc_oc=AdrGe9kOvK14ROKTOaLJh4VOwzaDdm9xwglfspgmPMqgWlRoia4d7SiF0TQRu5rXm4s&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Zmxo0umX2BPy76lcZWGa_o0GG6vqBu7_4DcWBiaLtrw&oe=6A0F1CE4"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gn3XczXPxlkQ7kNvwHfLGF8&_nc_oc=AdoiisVCM0YKw2Gwj1_JtsNwYQ2Ept9AluoQAbfYOysCexf-457MBqPHfC2ta7BBn48&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4F-tVTit8QsOyWroSAL15puCNA1VctyFg-1ssabVd-5g&oe=6A0F0660"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EeLQQSyIkDMQ7kNvwGKVzTg&_nc_oc=AdrUmnybySjR8d-S6zkGx0uTbM_5oHnFHfS3lcyxZs_JNu4Qo27z77qaViY289tJ_BQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6lsrsBNDY1Z9HP0c9zYcQG__T3oTWiGGUb7gqBxYTvZQ&oe=6A0F08FC"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
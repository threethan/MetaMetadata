911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JhMWtUd-hTQQ7kNvwEbvyRV&_nc_oc=AdlSFDN5V2skDIYQMpoAmdE-qrHz5OwQ7YP7mwawiULG_dwV2fkZT_OiWpuvEPOdBOY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwq2KPhCQby551uriSp47Zngrs93isKM8VW_nZcTF6aHw&oe=69AD61F4"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rOOS_UIvUs0Q7kNvwEBYSnE&_nc_oc=Adl0B0ZpK0dyKJdRayNGZoSG9iZxoqxiZstWT4ZzZXWd3i6kGqWBAw1f--k-vLY0KV0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzf4FgvHg8bEhK9LRysfjdS3q1hngxKP2MGT7k5uq7w0A&oe=69AD79CB"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BRFZqngP4qcQ7kNvwG1FKUQ&_nc_oc=AdkoLailPfY31kMz7Uq577I_j_6GwzFuT_WzJYKSvA0gt_GOomTtL1WINS-UXm-0ocA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz-uKqfxqpdzbKGntzJVeVHQEIWpjLQ1Hqo_YyG-84YtQ&oe=69AD55A4"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bqOyHChZ5X8Q7kNvwEA4Co5&_nc_oc=AdnF6w2wqn90ycZctsnsri-uLYV_heoZWZZUBxKqNneuWvXRZwV0TsejSlL6O44dLr4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy_8bRXDaB4v0v-fJLx-6Qf30yvTPnQgfnpTAcMmhz3EQ&oe=69AD7760"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=69_828emdV0Q7kNvwHTsVRx&_nc_oc=Adl9kjOtpeFpRamuFgsjvQMHPiT6MEqFxctYCfs0LRFnSHez7q1cVdwOA1r7USSLxqM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx3Pdx5dij2nBn4XqmqZdwtamEWy4SQLhS5xHSCdTCDpA&oe=69AD79FC"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATIO
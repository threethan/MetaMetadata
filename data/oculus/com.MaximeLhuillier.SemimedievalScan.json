244715", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DHxjiPpRqDQQ7kNvwGzXsk-&_nc_oc=AdrROJoGheUxlBVkymKI5lkt319KA3cIXjwtRoU1Kz6L899nKkyqKqLfLRoy6lJ1Uiw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw-Ao6TkH3_aNbxeDCYpR5XtcUP0PR1MDs-82x7BOhLtA&oe=69CE5774"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eP84UmM7mV8Q7kNvwHz8q0U&_nc_oc=AdpEZvbPZuLec5_yR0G2tDLtjfK-3VQ5cn1WMlKDO9NCpMacVjFogGgJQAQBdT4X3xY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzLtIhpxEVv9oqFeKXFKVPNOajDMG8x-Pc0ubyLjHCoFQ&oe=69CE6F4B"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sXMErVAeldEQ7kNvwHlV9Z3&_nc_oc=AdoGX3Td9_qjniPRCM_cylLdtZ11xYVFpgPD-WRXbDJMTz1mzXyoAIvg-AZt6tu-_Ps&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfygexnfRAFmwieWqolf3sG70S46VmDEwbQakGgAwwHqmA&oe=69CE8364"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=soXWZlgRN4cQ7kNvwEAzh4c&_nc_oc=Ado369-_OkAyfUFZ05-sCweyrDUc-s15hzG9S9paoa7splnkcMZBnJy08n_ls4UDU1o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwZOWqy0WQpxTLWdqtq21MwUM07Vi3KwZ76QUkR4pkHkw&oe=69CE6CE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GEX9fC-qVzkQ7kNvwEaYXy5&_nc_oc=Adq427l9FvZqAynNI8W1Y1QsVTxFrj4MJdwpEK2dwYfh1x8WHBaZ590uF1TqgFP1hVE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfywyX5CskvP-WMvznHYMkYQ1uYBtPehYdz1zUbFL7-pFQ&oe=69CE6F7C"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
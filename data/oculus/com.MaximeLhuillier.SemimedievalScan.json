244715", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZeCbRa89tKcQ7kNvwH-CBT7&_nc_oc=AdoXu7UEqpXVbvHvgTAqVToeLiwq4nA3LFx-FP-XOSeI6IOOkc06iT69MDkXLD8syFU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_KLMELDje144uSZCVVI46o8buneRvMXw8JDWZl2c4IHQ&oe=6A2C2A34"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nag7ghCvQssQ7kNvwGfQBaD&_nc_oc=AdqyZ8wx5FGNqpcVYL3s6sMrvvGiDPLtf5ltyc2CU2HYrNyeFuYADytAX_NSovK8-5o&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8q6v7nUfW7wFmiiHdCdig0-DqzLs-M6xyxO4eI9aI-kQ&oe=6A2C09CB"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=81li-gZTyMgQ7kNvwEL4vto&_nc_oc=AdqxMENAm9VclcWEc9zcdPDR0y4cVit6TJKstAshX1IVoav5xVnQvrSqZhShlAA37iQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-onv-zY9johi0vPkLKuDNpLKH1WBV4UGEegTzMHJmEYg&oe=6A2C1DE4"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uEklWEeeLncQ7kNvwFct5jJ&_nc_oc=AdpViqrQ8gCbA6w4RkujoYuIo0eJX9nB-KUr_roTtcGtAF1rhICxI99OFjZ8ax6BqV0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__-1afCFRrs_uHjTb7Jc4hokQydJk7TURpQkbKFlQG-Q&oe=6A2C0760"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fCCQQkQCju8Q7kNvwG16FnF&_nc_oc=AdorOoSxXJswt9wklIWGcw747_sNNbu-ArMStm56vPuhcIumF2s0S1ODM93wDmdm3w4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8FKdgcpap4qljGG72jeEI69WN0aKWGg8wkkPaNgbqyfA&oe=6A2C09FC"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
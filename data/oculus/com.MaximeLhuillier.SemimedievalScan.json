t-ord5-2.oculuscdn.com&oh=00_AfuzGcOElpaGrSwfFQFp5rCE7brmBiTeoM6Ayt7cFmHCig&oe=69A42774"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Az-ncDKpj0Q7kNvwG9sXB9&_nc_oc=AdlcKzxOfekBdFTSlM9eOvwYrGNg0OUylxc-xgQ8ZDRGtxn8hgAwgMX9_Jrennw4e1s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afu34NdDWdw3b0RLiEqaLivNkTeS8BLRn7lxbqxzGJAykw&oe=69A43F4B"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aff38g8bebUQ7kNvwH7G8gT&_nc_oc=AdmcqXMOkryrvh795VX46nPGhOQ4ed-XHcYuk5MyGHhQed71Q5CrVS6K4ERubyrDMj0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsfdNJ5dx7js2fJt2A3iD7artHs-yIwmtk80eTBipZcYQ&oe=69A41B24"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xtdt2mm2EOwQ7kNvwG4zlp3&_nc_oc=AdkeAuNpgPnkLoOFD50DbWWyyxN8cSzbsxXs0Af89HMBROxx0szwb1e_ZESJloku2f4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afvz4-w5vKVAPVm0WdhgRnbCdYBz7GtUjXPEuq3hCwclPg&oe=69A43CE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=902k3FKqP8YQ7kNvwE9450H&_nc_oc=AdkuD2XCrXAh90WGAxJwhxpZYaf6puUVUbV237wxaarNt1e94RjTXirDrbhHXUi7zaM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afvm4IBvwhcdhIwRz1FBP8ExluiGBE4pUulgT0JRGA9mLA&oe=69A43F7C"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "497208435570627"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1775993366072693"}]}, "baseline_offer": {"id": "1775993366072693"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1661964780, "status": "PUBLISHED", "id": "1775993366072693"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5781986361834464", "version": "0.1"}, "id": "1315291425673466", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5781980855168348", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "5781986361834464"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1315291425673466"}]}, "change_log": null, "created_date": 1661948191, "id": "5781986361834464", "version": "0.1", "version_code": 1, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
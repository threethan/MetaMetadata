244715", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xcMz4sIadCYQ7kNvwFz4i4N&_nc_oc=Adoaa2snuOjxa-IH-S_bIR13ANGPERUltiyG4Nv6l5tCpCVevYMAliE5K4hkJ9dm3qY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMxBBRBlfDY8_SH1ZfxTAIzKjJM9T-oqM3rAfoNCiMPuw&oe=6AD24734"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3WjzsMa_zv0Q7kNvwGLdaan&_nc_oc=AdpWqv7hsJ8E2_ItAb1rT7_rfAWrY_7fP3lrNUIAqY2ln-gbUNCxBAd_vKPqJ4VWjjs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQ_akq3VDRMpNSteYp6-diZ0sWlo2KWFV8EK0JtX53mg&oe=6AD226CB"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HFQQ2i-PF0IQ7kNvwFPURBK&_nc_oc=Adr3qWQHG_WyzaV9z8uzfi4cViYK3aqWSZBPTLNbQmrOh2668OqsF5XcTv-9KZ5_Ipg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOkHnM1xsJksUMj7vk4j7BWjqC_veOz9CzvzaT9AOv1Hg&oe=6AD23AE4"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BMCpj4YfBWUQ7kNvwGacgGU&_nc_oc=AdpIYmX42Ns5qMplceHkuv8mKaEiv2xYI8KcEpo__ZXOOUrJnEmDx3YWqNEMgsAUTxQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN8w1TyCrpwmNgcDBe889EjFJIeDHcGnpGgScO7t2_CTA&oe=6AD22460"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mdfcb0giWgoQ7kNvwHzXA9B&_nc_oc=Adpcl1VjrogDjExGMY-_wnmrfT_8Plrkb7tPhBDuZig5N9l3_wGjFYN7JY6Y_xVFns8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMVYy4RbbYYa1RBrnz9dTbD816kgEMpijaGvzbVSluEog&oe=6AD226FC"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
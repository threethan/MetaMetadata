244715", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hAjNEQJ_b-oQ7kNvwG_qVs6&_nc_oc=AdqoHeurVtZ1KSwq2ni-vfIFl6Vs4s0Mh5OwuWOwTZSs_A9e0FqD4tO3LwKmgcq3t1w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDFyFWOl4-B6sjg_AQ-Ih23o7mjeVhECxw3dH0b0r4ogw&oe=6A69E874"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GTV8FJwYqegQ7kNvwH7CtwY&_nc_oc=AdoiGG2u8qPwEUroDflC_5-EDWIYdGA24c0Thtbs6DMngzOew451JsAjUtw19GynQwA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBa2jujBuhk__qE0JsENe0Zw55sN77faue4iCs3avsOcQ&oe=6A6A004B"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U0u18x_pytIQ7kNvwEMyWpJ&_nc_oc=AdqGJIpL12E6N9gxrVEUDnQQoAu08K95gawpfu9lUOl5v2ZlwsyHos5YTt_5UGy476o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCykybNxwoWnMpbmlgZHN6GrLs9IoWYoAcrXYPHyA1F9w&oe=6A6A1464"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YF3PQVRL-LAQ7kNvwFDyelJ&_nc_oc=Adphwe9tGwcyQQBpUOruw7tdPxNFQNVs_Qe6PFGUsQ1rsKjCDGJ3-NlIRWdA9Pt8UpQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAj5zqx6zo9tKu5gth13U-oPD_ycmhlrcyyMeF3-kojEg&oe=6A69FDE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vpcEbU09IsAQ7kNvwGc5GBS&_nc_oc=Ado9SMuSUy2ZREMv9dSeQtkrm1N-9hJGXq1umyvBb4DGcGkhjdRdp_NbHgP6H4GaFvw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD43GiM0Gsb3lYbX1xTY_2Qbgzk-c0eFnG9iEZktxlgsg&oe=6A6A007C"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
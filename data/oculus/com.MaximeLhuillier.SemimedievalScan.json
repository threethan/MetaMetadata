911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i1dFT6FMJc4Q7kNvwFmYC0D&_nc_oc=AdkRrDqF0VYOcuzWbFYLndRVh8Ie3cMfrBUbTBd0mmCpbX25AW79ZVL7nl_TCk3KdZs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afu71KiixniLaF35OuplrmOVwrpI2SSC8JhJ9-nAL40KYg&oe=69A96D74"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d4lgsTryqikQ7kNvwEZWYBz&_nc_oc=AdkCbS1PwxyksZmdTWbiUH5w4mmmFLVzsQ_8FASSr9diYJoKdGpSFxaC-JZlJbTi5g0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftFJHmiHB1Kux2arNX8X5TzNLHNYHbDcamc8jL2OpiScw&oe=69A9854B"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hL6ysBJrr78Q7kNvwG0fflD&_nc_oc=AdmCpVV5_EA1TeeWvAuyrHYmEwjRgmA0qVEnEaV2fpCS5JHXuhfy1D9F-2BpnrIie6A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfsQ6bJkKXCBnxbL4p5JQlyFzX6FRuZq-HB9nu_pW5qDYA&oe=69A96124"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zSllU4_kZFwQ7kNvwHXiEPr&_nc_oc=AdmWomcY4zlaF4IsQIpHOC4HSzn6HiYq8IWk2CZDzrmXf97YmWCei2kRHtE38Dc2M-g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvvxOpWhobHVJK5jkeWg2MW2TwWtIPjpYSNHkxDd1jJbw&oe=69A982E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QDslwEC0ffEQ7kNvwEhH6Nj&_nc_oc=AdmSazl9xUJ2QbFxaHn126HUAcPLaNOLtttzKi0_kQgfNh4vCFH6V7JHDKL6LNT3--8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvPim37m8weDFNhWlZPEi5trt9RpFTroHc3fracpyt2zg&oe=69A9857C"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATIO
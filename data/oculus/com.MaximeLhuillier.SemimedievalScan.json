244715", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YnNig_gKe1oQ7kNvwHK7NBw&_nc_oc=AdqOoaDVcn5Zup9owKbSRgUZe2pAvriMGOysTRpopUCPuZuP9Nfh_baAx8yU1rhAjPY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMS4Pftvk0anMyJXoajBMqi5b1DEuEuF7gqlTJlVCGCEQ&oe=6AC90CB4"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V56LIsgT2EcQ7kNvwFT6E02&_nc_oc=Adr3L6_LV2xJEQJKB24ww2owzGKGwXmQou9SdJhs-ijZUePOUv_FwTjTxga03_2z0zo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM50p6DfLCQ85ITZu4TIj52Wqhyo1PTTulra-Oe3X2IIg&oe=6AC8EC4B"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uEKwXUXPXtAQ7kNvwE0z_Gx&_nc_oc=AdrepsHFVMIoyOSRziuIm5IRRAxJ4ETHrhDgDwcAGu2QgvkB6W7OkTOW1O8kR5CR2Rg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMYxZIj5pTQ5fxDVzdhhn14u-CzmPpR0bcgmwHhXDRdlQ&oe=6AC90064"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J_f6jK1jJjIQ7kNvwHnLiKw&_nc_oc=Adqmptz2CesJYNqT_3jwFtV4mjboKrv5DxpOj9aw5PhT7O0yvcxz6_Pfsk10LVBs0xY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMlkrDox8thSh2DzctiGfNeo_5WwI60ZfyNUEreYXiF1w&oe=6AC8E9E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ajXwEhdTNOcQ7kNvwHCO-gj&_nc_oc=AdoVw4qxNVYr6PdIZhM31VM73_uhRbYLnfHJbYjLFpRR4_jKxqXd67N00-7wzJF6yhA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMLdxyiV2pDU7MEiYD0QyKszaDd7X-OzlzMiBddzNoXrQ&oe=6AC8EC7C"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
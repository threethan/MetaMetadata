244715", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qqsrvrG7LdMQ7kNvwF3mCxQ&_nc_oc=AdrIS5pvdzeBPYvwadtk_ENpe1y7GLvgsWOJ-TfdRIkeOX30_oolzfSexAjqRsP-8FI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQG_Izlw7hy52gvINQ9stXbrKlV4VQilSqJ1E--Ey93Pg&oe=6AF33CB4"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XnDH4sltKocQ7kNvwEAMbom&_nc_oc=AdomzPv2HHh1kLucJcpZyyIFlgVaPmbtKdAq9o0-t61Imr5-hPDtMbDDkunNy16xzzs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRpJu2-ykMKMBMwpBTlxglcL5fM_DDOp4CKvxbW6SCjg&oe=6AF3548B"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ttTczA6B2VsQ7kNvwH27gSr&_nc_oc=AdpoasS4Dv3B6jGPISfZrIbowVOfYcloYSYpYuvQLW-A-wQsgA2Ie2TmwL-16U1L7zk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7_SOpZzjCqgb1EzsubaMA_rJI1CQ3k4fVeAkpJOuMQA&oe=6AF33064"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=890JL0C-r8wQ7kNvwFXEkPI&_nc_oc=AdpLQoeHn3QcK1kMZUAC8TBXFmFUyo3w16SpAksasuM_U88618jEurrMJPAnqVzOxl8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWafnMEZr2OxP3kLLRTCwxzKClDnJCVAK5qUec1h9xJg&oe=6AF35220"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=slgT_4pnuowQ7kNvwHCETVI&_nc_oc=Adp-oGCyuVVDeJmdlq7tqZCTeJaR-gS8rh49iUdp3W0XPvfK36h2N4fotsppm4v9OL4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8XYHjoU7XEfLcJ11c6uc6fGzageG0YTNg3GaKYfZjMQ&oe=6AF354BC"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
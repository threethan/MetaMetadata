244715", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f1IEwNGMMHQQ7kNvwGP-w6A&_nc_oc=Adqt3mDF38dt1X_lVJOSMhumOtUGGnr_ZL4NvEGYo6dUUsyIRb1Ai5BTYKfQypnsngA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw31oUS3qPqNvavltmQJL7dhML1yrkuStM0gPQeF-LRzA&oe=69C51CF4"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KlT3eRsYu1IQ7kNvwEoK7Hq&_nc_oc=AdpX5jHmERCQYgTMVdWa4w1XAF870hb3EyyHr1v2mANtl4LrNQAuC3vzK2r5tLqDJ7I&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzIr0MOv9g1G5wyoWWkMZZAMspbSE4gY5WH1doNQTjcdg&oe=69C534CB"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tSJTyr2ZLZgQ7kNvwHs7Vze&_nc_oc=AdqOlw8-Gy8sRixuBksUUQUtbk1SxB7zPtcuH7wqVzGD0J8I_03ngOJoPGDhc021Jmk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxD0QUWAOPvJkTFm5zNkNPU_CtWZydJbl1QdEbyU2p2cg&oe=69C510A4"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lr4X3IMAY3YQ7kNvwGqs72h&_nc_oc=AdqUrTc6wNx81I72PtsJ3WXq5zDiQ00QlhBi9eF-H6M__eOhTMHkobq6U9SjVgTHTFs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzv1SMt1u0UI-JPjMcWMUE9agp-9mCUUyh4XqLWjBG2MQ&oe=69C53260"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OTRkDI-7HecQ7kNvwEC2d0A&_nc_oc=AdoUTviPu1Dsk3ludhfLKU49lSwZbjviUjzdwrbmn94liVW0RRygogZziBIV_v4yM-A&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwPoDnnFxqcqDnGvSsH8vtaQRDMULxxVlJ1deX153NksA&oe=69C534FC"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
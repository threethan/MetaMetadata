721616244715", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M5ltYqYp7JIQ7kNvwEhZuBx&_nc_oc=AdoZZ_TfKWP0DdUs0glYuHnfh-gt_itJLQ6W93RdUdemJmWMQdFQLZpKlu8X99q_Jek&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6FkMO7AH1o6ArKKRwPfRkbbyXZgji52a2RyHdxBUEvg&oe=6AA422B4"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kR0Bj0DhDMUQ7kNvwEZYp2M&_nc_oc=AdoerQtap8Kuhswgwdbnl_0TJdBY6AEQJTVR6c4oDdOFLtih7NXCaD-RW-gsNtksPCM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIz7NuOeM8m4fR-V_Nf6I9RcJ5WPwOLLCfE51IJRr0OcA&oe=6AA4024B"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DPCRJhaD2RIQ7kNvwHnka3H&_nc_oc=AdqErGcvRUG5yjyN5W8JZniDfgGCxNikhIhAE5V8_slFhjKvJThE3252-zgGNsOE1sE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCBAJm7B6OUhZaKb1sdwvDN5DThk1jRks2nQ07WywhBw&oe=6AA41664"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fOUKMfTkPhMQ7kNvwHh2k-A&_nc_oc=AdrUHQJb2vxGWuCtsDWFX270-_jg1MLrMEsX6HUqTJyazYb_oXGcsOgNlJY4JH1B9LE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJW0eGS4Yo5BZetSG9_HFJNCcuj9I9Rn02T_UDd2Ycy7Q&oe=6AA3FFE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NEfEEso2SDsQ7kNvwEOud_T&_nc_oc=AdrgdSMxCAKCWKdCM-nA6q2xeY7A2wXAV4qLfYu4sVJoTiPk3OjTmsIP81w497f7KSc&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKf6NQXM-CLO07XIVE1iBdjUWYRFdB1QYbEAlSwUMUXFw&oe=6AA4027C"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"},
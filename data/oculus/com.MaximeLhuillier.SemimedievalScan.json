721616244715", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=959B6p2yXBsQ7kNvwHl4VPz&_nc_oc=Adoi2sESKKJtjqc9UxzVEh_c8H-K0mjE3pqprwhRb5KrW9dU7uKpFh52UpqwOpYPV9I&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGTdsglkPOCmmxFyuSjlKh8qivQYoNglBe4bRn1wpM73A&oe=6A7DAEF4"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dDRqSOME6AMQ7kNvwGGKlAs&_nc_oc=AdrqG_86GHLkcch1G_egydbv8FBYPFALIVLZgEcU15mGj07DVxjVY50ynFE1ftPSJwo&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEn05niXzvqPpTLx51sPi65G9Iad9PgEHg93vHrjB7Hxg&oe=6A7DC6CB"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4XqF0QB5QFQQ7kNvwGrzTyd&_nc_oc=Adp-_iBs-8eLs3vcvfhBH769m8SNUnta3udhSDeakONI00X91DxX0uzrXULrhYIgCwQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHCWHDpH567zzZPxuRkTDr1JtM8Bsupd9isZhhbWfCrOw&oe=6A7DA2A4"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mjGpFOroHu0Q7kNvwGpxI0q&_nc_oc=AdpEnHKYQn5axd6ejjuP_JSjzi828cJiiA3hP04GD0WmGdfQzzsIOL6qEEMf7SK5e4I&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG8iZSleHcikwzpQH6Zlv8niFGzU1kF90z_tA9SyUMsRQ&oe=6A7DC460"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=06-fJwuN1p0Q7kNvwGxloCz&_nc_oc=AdpepWIzX9XHzHudrYRHhrYKqCpdanLALk-7xooSYAiAk7RqHS3EIbw7YarMQWjw5eY&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHfwP7o25qipczwM4dbl03xTtb2A55rHtVo1nh5QOniXg&oe=6A7DC6FC"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"},
244715", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cm9qs0t6BO8Q7kNvwGEKr2F&_nc_oc=AdrsHe8hhoWmnbb12BU86ih_xz-eHwcUTBPa3SU5ZCjyNxHikLVlq94n3itHLFDsjHY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDr69SFi6c_GUFCera_rQ8bZR4reIhKyQXmKzgME_NNw&oe=6A71D174"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kw4OxqAm06gQ7kNvwG2vZbW&_nc_oc=Adp1fhPZHSxD3p3-yYFR11_etOHr4U6JUQPhUjcfS_os0xk8ioHKFVbhySwSFkWHZsE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1EA-1Bh_eAi5DkhKMWpv0JoYc-G0jEALxZE3h_dguxQ&oe=6A71E94B"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2E1W3J156RQQ7kNvwERovQo&_nc_oc=Adp3zgdedWLogcYuievUEiRCmLMcos9Zrhqn4Fm4BeNjc7CbO90YdfSbwXLkLp1GoHc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFxYvipZUDaM4bc856xEG11CVXJJS_Sxc3-JFvTwOuRTg&oe=6A71FD64"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EuzWIenSfa4Q7kNvwHBef3m&_nc_oc=Ado8ZrZCHz1wz3CbkiY0ETBhp5vzsJByTbVp5DV4-YWkf53BSxyqeMVkuoNLXpl1SvQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIVDoepstUZUDZ0LnvXqROIyE9z6aWYRbMQuKTSK0KGw&oe=6A71E6E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7CgGtNrrNj4Q7kNvwHtryHq&_nc_oc=Adpp34-q1LixxCDTyhpvPk8pcaZ8EXAGD66BKgHEgKbJUMBZ4M4kHI8omNdOpywfsEs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHkPvbPkP7EoDNxgdMWxT_J8s9Nwu85ZEc9tanJNXYvng&oe=6A71E97C"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
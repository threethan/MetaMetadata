244715", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yVdAc5bWwa4Q7kNvwHBKNaC&_nc_oc=Adp9dEx_f4GGcAgw0Yrq5t4uW_YLw4xZx1JAEGOMTD-xU8zOCuLqHzX-rxd68uo4h0A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDfRoyRSSS-fVpiTVx0p44QWboCwbX4PwDobmrQ0M4BKg&oe=6A6DDCF4"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P5dhADzzLVkQ7kNvwF99pJZ&_nc_oc=AdqWrkHKgW6Ki6uRtMgET13JA-NDFmT9z8Yil1KcNCxqugaDEChtPbyQDcpcQJ-4WVw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDcoulibgKbJgKPKu2r2SbVFWvI3PFGnqFHSL8E7HqoLQ&oe=6A6DF4CB"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LSHLEyIX_DUQ7kNvwF-99Fe&_nc_oc=Adoc7BWPsJDzH51R0ISF0pHKt77yCXfr9lqbpeCakJKn8VSt5Gy5pPtK4p7gHdFiitM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDEpX_Mko6vWuYBuo8h96vCXq0YRU45HS8nTM1-za3q2Q&oe=6A6DD0A4"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_1kGABMamXIQ7kNvwEYmnD2&_nc_oc=AdrRtKBrshXPJC8Q3_QBEZFzoiHzV1Sc5o6Lyu0UGLVN7ZN2buLygAOuaiV0dAGp6u0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC0BZ46Z_1C8H8aA4InPX6Y1kEFvb6z_VfSha8-p3gQsw&oe=6A6DF260"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lg27-d2NmoIQ7kNvwHM37-M&_nc_oc=AdpVSYAxL0fHBNm_g03EFakVBn8hS1HWK_UX-EH6GHvaMEgfc4V6utlJDNAerP7kdTQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCMZR-65uRIXjfVJq4kq1uZ8kodtJI3zGlVJiYn7baFkg&oe=6A6DF4FC"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
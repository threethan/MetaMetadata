244715", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FVKpf9WN_fcQ7kNvwG9CVwb&_nc_oc=AdqGcqwaKp2cARxJ2rKpAJxHt7s5X-KxptTf9nO2WNZdEg77_Lt-35TsW88VibdFwco&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0sEKnKNfoROSQykLmzcjxOlAUzrrhxNfvH1AJqOlmog&oe=6A244134"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ij0qXHuv2vMQ7kNvwH0c4XW&_nc_oc=AdqjlJVuLNx9YmazRaVo8zdTw_8R-tS1ReqVjmINxzIErR3mttGFzFPJk1tIdbZvRLg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Q2MInFYrtSB0mlTuYK-taSRT3jATeNCf60qYwhzovyw&oe=6A2420CB"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4zHqGvnlAEUQ7kNvwGw9MPo&_nc_oc=AdoJt1L-G_jW5kHy-DTzJxROQ1rrPpvs68WCPUMBS6RWQl0Zz1rOWbXRDblt0WHDXqw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vdJ8IVs4iAr1xsb3Az8sLERgZ6HE9fAZ6UUyjrFDI0g&oe=6A2434E4"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mLuBNJYnRn0Q7kNvwFRiawv&_nc_oc=AdqP13J8kSMTCsf6BrqiwOYufM2a9zDHFtjwBWnwxbWD3B_ZeLg3-cNCzlHmUZnok0A&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9lUHK6YgXb5PGgu9wQriBom8fat60tn2J1cfHVdz6ACA&oe=6A241E60"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y0RpzfJWacoQ7kNvwGLPtMM&_nc_oc=AdpQt-cEQDjAU8J7mKSLM4WUBwqyD-AlQ2rBQ-ucyswo5VjVTpmsShMu2L_g_nFZchE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Fqd9mA2rwDYADxUWhB5q09JwErPhw1BkZgta8cL4T0g&oe=6A2420FC"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
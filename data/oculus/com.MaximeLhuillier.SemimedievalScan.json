244715", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f1IEwNGMMHQQ7kNvwGdShrI&_nc_oc=AdpbPqEwTClcTZ51Zk2o_rlblLT1uvjKvYTJ-X76pWUttH47EaWIESRMY0zp6a4Nuso&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwZ3dF4dqJRU4RiRkgbRSnFYVNhuRSzabE8ZJnWqcGxTQ&oe=69C66E74"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MLp-ezIsZbgQ7kNvwEQQYzp&_nc_oc=AdouCudjFo00xESj33lIhjf6Xtz7r0yazFDAHb-4_YYRpXQ_YYZ_we-iVtmBLpcWD6s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzjyENLp18M-ELe7EpD-tDTNlhLnl60kWW1ZpIQgxsKmw&oe=69C6864B"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tSJTyr2ZLZgQ7kNvwFjD256&_nc_oc=AdrzX85uSbrBBPrmB0IS84GaKgfC3WvU0i0HMGip7mzmRX4Kqfn0Q6i5o8FYkNwFpGY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy3w9btVz64a5srqb3acYAoaUWzS5-iPEkF20t50cUjLQ&oe=69C66224"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lr4X3IMAY3YQ7kNvwF4WoFX&_nc_oc=AdpUtATrrIx1KCb3dZXyjT4iEMJJFn5F_FTFhAQc3O3RqGXNKbs8NzBqoSR_rs0EpvM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxa3m3OWReWH_0sxCemDHuWRPpz9_Wb5KRMtq2n2TXfZA&oe=69C683E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yvkkHQ96TlMQ7kNvwEE-1fk&_nc_oc=AdqW0VVhObEg7CW_vnI6-TI6siHrMkcqz3rS0Sb1ExxOhExTMI0SPT5n_Jp0xUwjkNE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz0fxZvRpzmO7VW6EkcdFIEucOkQsDiEN8KGiQnSKUEXg&oe=69C6867C"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
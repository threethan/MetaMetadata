244715", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7LfzMc4JNOwQ7kNvwH181YS&_nc_oc=AdqwEjRuuxujniSK17n6OBPDdhRxFqMpOK-xey6lH_5Jau3rnF9ZRG6GDVBruUjfP-Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGICkk1DQUrpLFcO7TKYrJuMea-CmGB45nhO8oIxn9Xnw&oe=6A898C74"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ikDv5tj1aI4Q7kNvwF2W260&_nc_oc=AdrjsEoylV13p5llMsu40UWHOx-uL8Vl7LDGtnFCCxI41kWwf22nSZbJEJq5hwjCYGU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHrQvBe1kCbKZgQRfJ4bmAeG5dZ-fKYKEnPi0eI4qW-Gw&oe=6A89A44B"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0w1QH9GBGTMQ7kNvwHqMYzi&_nc_oc=Adoi-hu-vE61IgmUDCRre3XoI0TbcK1zUsp4s8ws3eCZZ_N42mBOZskzrDGNXDqDnYg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_PTsD9gzzLkb9bzg-jbEJFB76J4h-DHhb5HMK1mCuXw&oe=6A898024"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5PEFKSpxbBoQ7kNvwF53BDE&_nc_oc=AdoCtjaSeFdspHufpCx24-zKQCtwhEcJdEd0VDxNeUKhem8wQ08FeS4P4UEn5JWDFvY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJibV-LA4w0O_rCNxoNh5_iMqEcfoMOEkKzEFj0L5k_A&oe=6A89A1E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4pJYQeSSgrAQ7kNvwEZoRHE&_nc_oc=AdqZlENRY-vh4ykdVBNFgIoo-BaSwTtYy_5mIgnQEYg4EqLRLG4y1EX5DLdfyL2Y0Fk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRYU80WuxwMnps-TbkKva7Pz4WkCPKp99JaaWzNGPzwQ&oe=6A89A47C"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
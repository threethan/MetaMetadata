244715", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2u0qM5U9-yYQ7kNvwFuGANc&_nc_oc=AdoE_vcaHm54ZkiRl4ZAyKdzLyAd5GToHiOrDbZDMvlkK9A5reE9ynkxBxt4ky1M4yk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7d-1u7_slsvzJsEUNY3gO3uuanTAYZ8kOBQiYflRUSyg&oe=6A0891B4"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UMAsNOQOdscQ7kNvwF5tODv&_nc_oc=Adpe84IlFABi400WQfxObyLGnycwvJFlXwvT-xrBvB3z6i98Do8F5XqBS7HzLbiEsa8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4eqvMR9TtosWGppxuUPBSrAs7rHHsn_u6JMbMTHEFMzQ&oe=6A08714B"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o405Avv_zJAQ7kNvwGngKnM&_nc_oc=AdqD-MBNncaVs0DnjeCiO5zpfM1mpi0QldCUSU8foKXfbMqy-cA0ybhtH10BX05znWw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-tO1oWK4QcJQr7_M44OH-ksDvSsq6FiQoo9-iCKBlTQ&oe=6A088564"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5h9cQCTZGncQ7kNvwHb0iOc&_nc_oc=AdqXHQF_Ud_1ar7OzQ7Sy1N6vo1NG2uhWYYXNcdQtX6hi7mKUXBhzoUaD7CgMIF1J-w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4DwOCscvxWgrwsjD8PWKSNMsqsPaut5Dv14Gg_9CopvQ&oe=6A086EE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3AqdSn6Gm2sQ7kNvwEN8pIY&_nc_oc=AdryZ3JThNDf8NLiCY3OxJdjzxSepPNTSMXgB6lLcBJQvejNi9zWfjkrAwCTaXcTKqk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6aykQ-6m543r7k3daDBfFtlJ0gbgS9aXm1tuitP92TLQ&oe=6A08717C"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
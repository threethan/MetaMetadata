244715", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ls3vITC6yjcQ7kNvwFBeB8G&_nc_oc=Adqmf531xo-gUvy828EthIQ4K_bohQVV-yMVsx7hxwW11WMzoBd7M14_Z7PfoXuSVnQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2e0-dDJFSxGMhKZ0bXDDTv-z0drad9rcDwMs-pfVwzAg&oe=69DF7AF4"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cap8XwYeswoQ7kNvwGgL_T5&_nc_oc=Ado-OucH43mmt2yZqzcvziqrHjRZEtGk3uHtQ989zTH5kHvo4zP0uuFi-HCGdbtL4FI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0KB5sN6wZEvwWjO6-FFvAFmF5_LoDa4zjzaubAtmKrpA&oe=69DF92CB"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vvHuUKMi5zsQ7kNvwEnVIrG&_nc_oc=AdqsG68X3YMoeSt7jxowhjOwuws1S4xKDtZP1oA8-GoTTF5VOCLIT3X3JmN5dJKUc0I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2hE_MJz6nilaeuKOrYjOfT0ST5SUuFGqSp1E3wxmqilA&oe=69DF6EA4"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nl_GpI8X1KUQ7kNvwG2llh-&_nc_oc=AdpCffkqWumiWi8IQKN9z9OuTfdQLiFMk_65eklSO2t9Z9GwBgVVwgIS0a2aMtXZXkM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0s2fLzhQ3T9MQYEvphuND313M3UKmE_RTn-HT54kgEAQ&oe=69DF9060"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KM0xyV8PKHEQ7kNvwEJcdny&_nc_oc=Adq7nJKGfkq-FqXsotnVBj_tY7RNG2-8YgVJxo5ry55CWWJmjBA5MsBKlaXbHCGK6nE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af19wnGu80Ki6lcG9cE6rV6jBZ0v2aL-WqU_cMFlRZe3kQ&oe=69DF92FC"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
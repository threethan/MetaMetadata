": "Screenshot0.png", "id": "1235098807268738", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982658_1235098813935404_7719619199213845753_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=miYDGDHlht4Q7kNvwGGGrFo&_nc_oc=AdoqXQienp_Gd8bCSXFdCF6MyIx_qkXyQygepnfK2KoOKK7rTu4dnpW7ECwn4SxWB4I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQaC5XOtLrieoHz0xkcjS_Ohzzw2r4fqPVdXjOIT7Kx2w&oe=6B0C5388"}, {"file_name": "Screenshot1.png", "id": "1079721616244715", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0-eG_rUU2TEQ7kNvwHEZtqv&_nc_oc=AdrZoEqRXyL_t2KOgoemg_ju-EY7NVfi_YHsK0A9hZHzmDGUrHcmBa4Wj6197KyauXo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTXBKsgVDu2Zu2oTS280RXWb5rs2zwpb9ARNJNQOaC0SA&oe=6B0C8174"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yb5VDyNqBdcQ7kNvwE8IgFG&_nc_oc=Adpogpd-EJ50ntsKpqgH2T85RreV1T33QHjE96tqh8_LYUs2DybTPCj87YiRfh_368I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRoFBerCVF0RkoRTF_30CeI6gdgm1svf9mnvmWiZfANZA&oe=6B0C610B"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XTAWY11NWI4Q7kNvwGQe6Ln&_nc_oc=AdoLEwzNlbc2_X0Pk_1y25hz9nFI_hPdJvv-umMS7J9qYGFz6ByLBOStDuHrwCCr_50&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQoL3ziQ4fxrpWcbdSj7cDm4IYjnSR8LUE14T901Kuw3A&oe=6B0C7524"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TVXa4WHS0HIQ7kNvwESlGho&_nc_oc=AdqxdAw5gZ8kUNMiX0ofBg7gPRVPzXcV2MHqxhfUUKaWA8GEhUFCN5N48PIG4ZdSmOY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRJNlbNxIk3NzPVElVt_ItJRC5ydJ6CebMxPU3N4BuNCg&oe=6B0C5EA0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mE8fKkH5TkIQ7kNvwH8XtSm&_nc_oc=Adqk81_lgebzkJ3Ni8e3ZTW9imukoiw48i5C4ace8MLjuZjy7xp6ziRZJmWSS8YcUtU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSp0QQJo8rX4ytnM26MQGv6UwJ4Qds3d47OX0q1yPFkVA&oe=6B0C613C"}, "display_name": "3D scan of a semi-medieval town", "keywords": ["photogrammetry", "reconstruction", "360camera", "digitization", "scan"], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8744915575541513"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974593_643470730539088_3502460444141589985_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AdvcSC7gsEgQ7kNvwFA-TU_&_nc_oc=Adq86el4x7Rol7en7qjBSq-3-QEH_64xaWvAhB9yXtJEQf1hiY0BhDlIq9zhNW0RfUg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQS3XF4dGe8VfGAR552CvQcuDc-q9HGhvhwrm6u8Beyqw&oe=6B0C5E31"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "3D scan of a semi-medieval town", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Travel & Exploration", "id": "
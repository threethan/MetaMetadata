244715", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bxGbZ87ENbQQ7kNvwE_TeeY&_nc_oc=Adpr7H8fOVI99H6zIJ6-xguX_lkdnUwf-VD3U75qcZ7TP7R6PHwJWeAxlPYPyFjnwTA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQOaMU6Arq0cSKFe-8RgMsKdPUTaI7H63LkPbm5uRrAg&oe=6AE8B0B4"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mI4G2_GFp_EQ7kNvwFgEla7&_nc_oc=Adoh1mEV0XeFgeIW4e5xzb8Rk89iMHKI_OGPyHeaaERoJO0MmW5-vygXOC-ONXkz8qo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTEbTdo60iYYSPejTPdAy-nleRJ_JiwkeAj6mZ7HN5S5w&oe=6AE8904B"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3yQk_1zphNUQ7kNvwGQRoTn&_nc_oc=Adoon8M67_A9M4lPvqS7zKg4QLayjO9rQXExwwhMIDgBB3zdITyl7m393WftM8gVKtE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqgKnzg6mO6pWneXLRIt89CPMbGgiuQRMdEtBZRveQSw&oe=6AE8A464"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mL9WDgLhFe0Q7kNvwEc8Bhp&_nc_oc=AdrMXNGwZZS1a0LQ0F3SHiiqj9f73GJGVjO4K0X1va-x9_NITamcPXa8SWZcAV1kKxM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtahexa1UJRoV4ihxJvtHkiJPpetrzUzhAJuJ_dUGBlQ&oe=6AE88DE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jYNH_1bt96EQ7kNvwG9nJCQ&_nc_oc=AdpbI3B5a2KAJycUQg9Lnt2v0oX6XT3MkPxvJ-axa0UTxm1K-b_yYdFscBhtT3vIWsk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRECHmM7F4_xUiI6IXWqh09yIH30gt18WXVRupubph07Q&oe=6AE8907C"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
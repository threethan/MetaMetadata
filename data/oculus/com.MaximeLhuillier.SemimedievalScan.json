244715", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=40ZEyiq9YhsQ7kNvwEQO6pa&_nc_oc=AdpA6rppRgNLR_Cla5z0M4GUqV33fyxgdA2sUsrjz_Y4BJ6mF8S5aMmHbEc2c9PJTfE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1FU_yr0kWxSoVsVKkKFduRfKVN7LvH8Tg4-6do_I8fA&oe=6AF73134"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Qsijvgm9_0Q7kNvwHqsUYk&_nc_oc=AdqLFqPNBCe8Yyt7PkvpolAbOtQDpXGsjHyNVG0SxpYookbygGgeM3Rj4cxIiI5-Lko&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-dhPObcMg7QdmDXpHGZYbAR_co97f48Cs40VUUY_ZZQ&oe=6AF7490B"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zs-BEUSF2X0Q7kNvwFpjuFp&_nc_oc=AdoXu8rGe0FUHMX4Oru3YFaNiNpZ0aIh1pK74fFrq6ARqyfdq5-TAnK2VkwKrdzNtbw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS19Ud-VqejsItc5sMaAMxtLeg2r0AIurX1S7zgR-yyCg&oe=6AF724E4"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4XHTumxzgLYQ7kNvwFcl8JJ&_nc_oc=AdqxTivFpEo_c64KjRCPCqwnuGo8Nlbe15EZfAEAMXpNDTagS8aJb5fmYUz_vHbU2Mg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYyaw8-QOVul00sASseRjXJ-ajL_p-UUi30Yn0-j0Ncg&oe=6AF746A0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7k_ZxIfvt7IQ7kNvwGA12I-&_nc_oc=Adq49uLaMjyIKV5cTUlcEHjV_6_quDz_XQznWUQIVuYnb9eFE3qvpayw3QoiwIDT1b8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPN4ThTxTiaP3hfReoJn6JwxjC5-hBQSqf7siN2Wcy_w&oe=6AF7493C"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
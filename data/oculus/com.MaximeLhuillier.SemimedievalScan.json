244715", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GHjc2fvhGFUQ7kNvwEiJfar&_nc_oc=AdqqQ003gWusCMRXxWrFrHXpJKS0KElaXqzKZzeU1J_K51gvFB9KIyJoQ5al9t3YDGI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-4L1aka3kn2bTNdAk5Q9Jglwt9UmRNkksUZxigjqu83g&oe=6A3FF0B4"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=03ZTNA8MSPYQ7kNvwFKySAl&_nc_oc=AdoSwHvB0qqChmandJcwF1EmPATiRALOD7q5ppFQ5MPgXgWs9Lcr2uS_mCskJS6aA0s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_I_K4Tzvy-4W0LaB6FWCA6Re57Ev4ekTOIdpuGBk6Y5A&oe=6A3FD04B"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GPsYZKBVATcQ7kNvwFfCCIi&_nc_oc=Ado-HPvf2UyfnKY1ufst6OkmBFzpu_TrrxiWZGUUKkFOl0yeGcYY0ihZE8l_fr4S-HI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8SPPR49Bp62vOoJ13t266jEGcapvrkKniP_zlWCoj5nw&oe=6A3FE464"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DXsLOec8OhEQ7kNvwGBTDY8&_nc_oc=Adpr4vFutKwV_greoKo2K1mD_hINP19cNQn5Vih6FfkMTJxZH534baJ_UdwsztbQNh8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_P5JGlO6_jGT9Q9MuoGfOQWidHqu_T_llUnZt8FdoHQg&oe=6A3FCDE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b0B-gPiGx4IQ7kNvwEXXX2w&_nc_oc=Ado-4q2DoUtpoSMgK5w-XJ9fVhcYbG3NRGvZAzQ3t976Uad79xgrgtCTNCoWRM7ZSI8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96PZK30V9x_fnJ2VAnnpGEqdzT_Vw6KA4KHt7WtBgiVQ&oe=6A3FD07C"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
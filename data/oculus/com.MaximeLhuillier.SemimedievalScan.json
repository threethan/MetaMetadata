244715", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5dMIsBBkLQAQ7kNvwHYQHRA&_nc_oc=AdrXid0xflDpWPKD_lu_YoX0d2mOJdcXVZqsoBtnC1QiAyXXzw5SMlvTPMuWg9AdjBM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1M1E7YtAqHAkIKdRKrEn7O2ucKX0ZXcb6rrm0-XOd5xg&oe=69F76E34"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bMCyJ94Czu8Q7kNvwG6BvmB&_nc_oc=AdpGOPKng6Y2k9_b41kWE0DajTcH5D_FPGd--rNCfPXFV8dSQiL8DjO6qVz6uQPtHzc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2_Ys6Ls0vGsy_XijARWzr1EyJpY_RxSoc0ne8XmLH8fQ&oe=69F74DCB"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7OLUu6B_CyEQ7kNvwH2GFIl&_nc_oc=AdoILMlt1RsmM7iolACx-EMaY7UDBT1CeqaJ7hvy5m3qkdyrT-w9175S1RYmFarwlF8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2u0MXpFzDCebyjs6o4kJTVXtG2u6TNaPgUYjOGgB8zgw&oe=69F761E4"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z1T8f94pAwMQ7kNvwGGIhX2&_nc_oc=AdpMl5EjHk31WAMRuJUNNw6WZHwgxibRp1rrjhbV5mRY9-MpxKPlDnjOHQoYLQY-Bp8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3mzJsiSe7fcLe95Jx7M4hBsYunJEAZ0ckaX4AZ2N0HgA&oe=69F74B60"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0bF6vwAaaIQ7kNvwFRNRJg&_nc_oc=Adr3WJidKFrzorumM7VvUeCKlAf5Pup-txOwbLMf60pNcZeszhYUuIDGKl-nP7zEYFA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af00oFP7dkvTDKx7cP-DN67ecTqQKF68BkG1cq_2ZeW0mg&oe=69F74DFC"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
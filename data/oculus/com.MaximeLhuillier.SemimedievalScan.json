": "Screenshot0.png", "id": "1235098807268738", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982658_1235098813935404_7719619199213845753_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yHJA5YZDgoAQ7kNvwGGnSQB&_nc_oc=AdqlydaoGA3v_DLjx87oDg2xuUWSDP1ppccKttw0xpDW801cYflYM82UxEk9DsB5ceE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRWTibmhrMROCqvq6SqjMrM4Nd5V3diCDdjnVZXN3mrfA&oe=6B0DA508"}, {"file_name": "Screenshot1.png", "id": "1079721616244715", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-7oR1bIfnWsQ7kNvwHuc8wH&_nc_oc=AdpXvJG-WVdov0TdfYyCdv3u5T4-zfGj-a-NzjrOmD94HXFt5lIjlATE0CBaeX7yzPg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS7X-6wwWkQY3F5gxyr5qkLKLV26nbbH0ZecH9tUZqVkw&oe=6B0DD2F4"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yb5VDyNqBdcQ7kNvwFb-ZKK&_nc_oc=Adrz6W9CqYYhMbJDWfFbJeAS2UXEID7F9tTxnYjlS1lIo6KJSnGraojGoLaBVdaDqvs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT4ka-6eqd5YOpW1NMLWuDIM-gKMePj_LDV0HAi7wlDgA&oe=6B0DB28B"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wm2ZisLR4_gQ7kNvwGtDGns&_nc_oc=Adpl56WsYPBt9KB-p-2BBV37s7Io32M6CvamOFD-ZKLiALgy_2xg18Gf1ie_kPVCljk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRpbyGG6kCUw_5QNDNWQ3GJS7CjX28fSRrDRum_ypN5Zg&oe=6B0DC6A4"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TVXa4WHS0HIQ7kNvwEgRL_K&_nc_oc=AdrFTWqDI2L1LiwuxhnWmskmHUfVKYHTyqlvkf50tIvdfxfjhFu7s_6ha31fZb2bEbw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTEpwlM8t_vmmU5ClUJMowC2oSRwipoU3MBk6xQ6a95ow&oe=6B0DB020"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mE8fKkH5TkIQ7kNvwFDCNlQ&_nc_oc=Adoirg7vtc2kvR1gi19q0vSJSrx4ioIFBREStrNDp9tA4Tg4uewxJLwe3A_NVCxqw2w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQxL-5iN-Ez0jCpMNlhWnBMmvOZPPHAQziyTUZYD4mB8Q&oe=6B0DB2BC"}, "display_name": "3D scan of a semi-medieval town", "keywords": ["photogrammetry", "reconstruction", "360camera", "digitization", "scan"], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8744915575541513"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974593_643470730539088_3502460444141589985_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AdvcSC7gsEgQ7kNvwGT9dOx&_nc_oc=AdrUsjh28ZncUD_zAttThwkfuLnIjUVBOdAW1p5HkVSGrNZa0CP_US1aCjfnm0yFZBc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQLPBprAkdFdo88MZzDaoFhLrAYjbLikNRanA4moHvMvA&oe=6B0DAFB1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "3D scan of a semi-medieval town", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Travel & Exploration", "id": "
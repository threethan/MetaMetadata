244715", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qsRUTVQ_oIsQ7kNvwG6JnGb&_nc_oc=Adqzpet7_sTKXqhh0MXgoTUjICLl7qAgY4hxZfdrHerM5fJ0g7IvD_E37RpL4iB-NxI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCNQiJpRdKIv1wijgnCamqzNlR4pcCCit6ZyxrD2yUMng&oe=6A565A34"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3CO0xnWYLQUQ7kNvwGeLRVD&_nc_oc=AdpZwyGCnz3FAMfLFfqgI4oItWT-TtdWdAPOIkIv4uBWpUIjYzL5sI_mpzs3qX9QBy8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCPlvIejcxGkUKhl5Gz5RqovCxcfbuYGXO0gC9tWw0oRw&oe=6A5639CB"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=65t69wfc-58Q7kNvwHw1G7_&_nc_oc=AdpDz9NxuR45pbzG3hd03iIfJ8v7V9n7tWMRoIHOOREOQEg9ofXWLOXmZbO45pB150c&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_m67EROjDdZo0LmeQKISKPdXisU0fz29FNLYH9tqBsw&oe=6A564DE4"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9CQ-p2vw5hYQ7kNvwFtbUFf&_nc_oc=Adoao-HzGb5FV-n9kMh6B0hSG_PJHgz9kdsWgTkSI7KHSTUfE5s3yGG2NlkkMBXatJ8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBd-5J_Xws3aMJKYAYqqPVv6_Q5DADy7iUYFpbezINVng&oe=6A563760"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ExR4tubwRzEQ7kNvwErV4lL&_nc_oc=Adqo0O-Iha1D5H6PDJvpLkvnjvfU_gwdeHiqEJAiH3FT7M7Y8bMVswWGTIUPkmxx6O0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCGN0hErik8pHCegE-MY_ZQgLuF4hV82Z6jOsejunEZpg&oe=6A5639FC"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
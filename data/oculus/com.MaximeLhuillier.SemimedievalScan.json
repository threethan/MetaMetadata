244715", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kIdwwrDHgyMQ7kNvwEpu1YF&_nc_oc=AdpJFbF1WfXqQSTdvvlxYAnQpEPIfvtdebrrSLaVH-LdzSFGgrjeMzvIkDI3OIba1yg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOb66aTxfmknHk7PbJr3590pmMUvNK-xJR6WB4hb0PC5w&oe=6ADCD334"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eG8dS9VjsFkQ7kNvwHb7p5o&_nc_oc=AdraJAwCM0VZST7TTMOmtkdv_ElQOf7GUhEPytKTASv37o2zKeoZvU8AhZcCCxGPn9A&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMuaF9cmNwM2g7S6vozKGzPnLch87iooTuQHBuHr4-9LQ&oe=6ADCB2CB"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rNXJO5NJ454Q7kNvwHyVBMb&_nc_oc=AdqXho_cLZ7DcokNQlPOmMIgyafSf5JQgtXqo7fJpNFTl-hzLYu84R6ZAIt1ukeeArY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOC_MoGCOE4a-OY8rlJ3CxYY3SteQF4U7_hPkT4kJhnUw&oe=6ADCC6E4"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sbWGgA1iLhcQ7kNvwE3hvqs&_nc_oc=Adrv4U3E1T_2dEOEbFybi_7F2KV_djJ8Drrd3jgXrp4w0jeb8XsfSvggAZh0iI3_HDo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOoQnqrqzg2edDT-cqtIfeI8WpeU2OwvC2_lkfvLtDtmQ&oe=6ADCB060"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6-NR6xSLqP8Q7kNvwF4w3zC&_nc_oc=AdoKwcO7HLYz6nrbMHYWUYpNo2TIbaSU8QDMa-u9_rbFm28EbStJRKdzCw-D_BtrPBs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNE3Bcte783bXfJ3yf7aahWSgjAf4cFP3aZw5_nu7mdQw&oe=6ADCB2FC"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
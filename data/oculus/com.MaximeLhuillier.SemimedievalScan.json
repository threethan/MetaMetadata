244715", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NoIMSXpjRwwQ7kNvwE1WnBD&_nc_oc=AdrYYlDhncSRPWlVguliXhFppRNLKhVdPKTXEKgErdLezmLJ4Iqa2gkB0UB4P7zRo-w&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9aOkaNX-cfsdNGYt0-LOYlMSd3PX20ajWRN0wGdL9sw&oe=6A301EB4"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vE9zLe1JgWUQ7kNvwHkdEsY&_nc_oc=Ado5D8odATCBMyUA0u4WfT5GBWpcOcEopRo_Jw7U4OrSIR2Jj8PoZBrzZ0evZ_8qdzA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_c5gi7gkgnhxfzw7LLlzxdDTjCYIWLrJHZzCgcp6KrRQ&oe=6A2FFE4B"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wrj4YXoQC8oQ7kNvwGusD3e&_nc_oc=AdrVCvCzB5G7uA_6YjWJE0tMZJTpaMhvRqst3nfUUqsT-M8U5_5qjd2wcuTTfrB8kPY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_xxlxtZvJlH_8VWnFkBDmdBCwM2EhXtAOagTbwB_2f2w&oe=6A301264"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZafvuCV_2GEQ7kNvwHhRhea&_nc_oc=AdqQP8PNsx0R32YfhxuYAXzZECWChEyoW7rap8qPl6nTK8VXfw-8u64d4MT9h-MiikU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Y5czD_Qr7QHEXirxpZTHpwqPaCpHuGYL4H8vm5dC3Yw&oe=6A2FFBE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f7TrSV_UfnIQ7kNvwHAvIyb&_nc_oc=AdpckDVxQ7S5KNqTGdd1Ln6mm5-uRR08ifBnC89fwszE0mcLBx_p3If1MGemwuFFx0Q&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8JLtl1yWrLhA0w6kdc1AOskqm719Er9py5jBYVEkD2uw&oe=6A2FFE7C"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
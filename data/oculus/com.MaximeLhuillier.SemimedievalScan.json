244715", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yVdAc5bWwa4Q7kNvwHipaAq&_nc_oc=AdoUxeEy4DffCbL7euEBi-PtaFy9IFtQ_fFDAtGjLu_GvzywebS9BI3oAC4svy6TSik&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBMO7b99HnhKuD3YTbpV3q_npjOIcDqSPFK63tKa_jYCA&oe=6A6C8B74"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P5dhADzzLVkQ7kNvwHkd9JA&_nc_oc=AdrKpsC2G00AuNmMfQ1KGzVpXHJqWgx1iivQCD9_z1U3SN_BIkltqiw1XBecKUH2UQk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA8R98wnNxZoXh3WuMQS3RqdUJJtjQRisOU3MM8UEGnQA&oe=6A6CA34B"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LSHLEyIX_DUQ7kNvwEmp5ni&_nc_oc=AdrmPScqG_zdppHaTMZz24XK_aA3-I7NcLMq1CctP-uYXmnVjva9U6LYhRe5H2w3OhM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJOapE6TZiXWIhXZHkRObIjIvIXLoK3-Tg6h5_1t_drA&oe=6A6CB764"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YF3PQVRL-LAQ7kNvwH-Qa-F&_nc_oc=Adq3Xsd1ngJJgCsfou7D4xdJoqJlbrGjfwRAYwZFf4icWCT09eTTV_SmIDhsG0_TE8I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCgUnXlVZM1kXvxWLm9UTOpSgJg-I8O0zBiOBhpEJdHSQ&oe=6A6CA0E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lg27-d2NmoIQ7kNvwHRrOj5&_nc_oc=AdrlpPK07qZUjMkli2kwlHNA1q9y5M2avatuNIAVQhfBFe3Boga9Vh0HCa8UcHCF2Ew&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBV-ZmbWa7oTSBBDAcNN_HzYgcd2iyEZ2Pl8v8VWCsJZw&oe=6A6CA37C"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
244715", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JBI47c-UN4sQ7kNvwHEBsZI&_nc_oc=AdpzDZeG-IEmlsaqXDTq4IOb0Na8mXrePaK9wDsX7iTs7uF0je8ZOniQBANDpp7N9bU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGwyCirhlw_Tmmf-wsMZXAKDlcbVaUMyCEf_aq6fEfDQ&oe=6AF9D434"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Qsijvgm9_0Q7kNvwGvuI5F&_nc_oc=AdoHXMl-KA2cJ2gTkOgGnOju8CCeSroWkyPYxgf7l9ENQdrN9NptuzlHelq_ZWPBfwc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFCOvSX1BG3kHSdm8hvBLoYZqiCHzua4sGDxWIKdTDRQ&oe=6AF9EC0B"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rArfdn6nM5wQ7kNvwHxsnxf&_nc_oc=AdpB1QK2cFXC7FP9CYGpRZ-NKlYrsn503EGla0rQTeOb4dlYbOk8KOYbczM1wX2tGj0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSof4K7lmn1CPFPSMHp9ten4vhtxCGzY6ELYZopDkj23w&oe=6AF9C7E4"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l6Rxj53LLrkQ7kNvwGygvZk&_nc_oc=AdqIuanPCGTVIZKzs1P_fm7Nw26mUR3XueJtpjZHHUncWLsE7Fc67FxdCwyRyUUFZXU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVfZvigGlumRu4PejL_ooUp4Nwv41nXosg3Zob_k4-GA&oe=6AF9E9A0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7k_ZxIfvt7IQ7kNvwHCDOq6&_nc_oc=AdpIYLnRNu-PqeWBUWSXwtKYcDpQO4bmH3qZPghhatrKT9MBVrTohLlSXDbe6jkkEwU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScpxNR5fhgL-NbC3HkoJ5f51jWAeqqJAfXIyRq0GczHw&oe=6AF9EC3C"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
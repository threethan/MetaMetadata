244715", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gpnmz6kJ_2oQ7kNvwG90I1X&_nc_oc=Adp5MsdmUHEQxTEQF-HKT8hnMRKGj95DxsKtzG7jiWW6vlYrz8iGCxfbIa_gv_Hbtgc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5fYoalzsY7tRFvIOkkdn1VWck6Le6AqNJ_msroP4a5cA&oe=6A01C1F4"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-C0mAe5Pv9AQ7kNvwFhyQgE&_nc_oc=AdqqzqmtPWqXdlildER1MuahzqpH9MTjHYtpz-8iCjC7o8pv2NjQfOq4qjzne7oyp20&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5OEr0-2oBlkXuH3eGgHuTFTG2_eqXOUCVt36WYeACAcw&oe=6A01D9CB"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=erb7TNGb8CgQ7kNvwGlSh5g&_nc_oc=AdoewaYybr5P_GIRqRNhGAE3dAZdpMjhKEmhqRKWidlanrygNF6w16SgkQh8rXiEQFI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4CCZdU1hRTNVvBbIoD5usnJIWfEZxjAyvYcY0_dBT9LQ&oe=6A01EDE4"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qOED_CqhpSIQ7kNvwH5wP3S&_nc_oc=Adq3eJAOWKisVobSQJia9uaquNCyk9Af-oo4IdGwk30tDotUYZklQqluKgh0tPYrpOQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7dxB4MoPXSRk0S5VeNFMYykQAFt6EnZ8WKCE8csvNOEg&oe=6A01D760"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H-oW1FgP3_IQ7kNvwGepSmX&_nc_oc=AdrdkxA9893hXdLjpYDeOgsclaQvR4s9Q1AOi2LhX1HyA44VPfjpaIDfwefE45VM5X0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7YVEYJg8gkON3nZ2-ktqdai59x2f6hg3jpkowBzXD1xg&oe=6A01D9FC"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
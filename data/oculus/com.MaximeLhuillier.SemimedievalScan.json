244715", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hvfvLNAq63EQ7kNvwES1bIb&_nc_oc=AdooYTSwOSq9oIIuFAwxTLBTf4CVrGFiVgEdyMeuymUJdgo8kBrMj63DkQVIZ4ofS2I&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4QfP2Tdr0p9-Oxixvv6KEoSWtoSWmXYb7uO5bSiuy8Q&oe=6A5A1674"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qr9LjrCKlN4Q7kNvwGWI7Y0&_nc_oc=Adqi3ZbObQ4S3q3jMJhCN9nA7mSymIA3PcEVb1sJYmxqzBS4QcSfgYni6E0cz-V0axU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCw6KGoeNPvYNZyl41dtnrJnz8gQzw08p-tuyfuWWxX8A&oe=6A5A2E4B"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gpkhDLRijyIQ7kNvwFdln7a&_nc_oc=AdpbJJlxjop0TH5T_-CPD1w2PC1iFq6DswZQaYmH7IOCshGIwuEUVl4Sg9ETRYVgg2k&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQyR2Z89DKO4vz9elnX2VPhyYzf2GwC4v-44kWYUXZlQ&oe=6A5A4264"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J3b9p2nCEtIQ7kNvwFhGE0J&_nc_oc=AdoGb6QEzGphwnJopTzmS5bxFVrvhotzqDZfkZCGYHOVr5-ZYqAWPyYPOiM_JIejeS0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDC19_Tfa4ZQh2kZz7bvdABZbRZThZBRuwf2zpFm-K3gg&oe=6A5A2BE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RF2_5gnF1PkQ7kNvwGb_c-K&_nc_oc=AdpUNEaqEX8QlkCrlfQYeuIrM4qKWhLwD4PR_KFXLMpwWetWDn21u2bVknSXcirlUqY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTXtcwaDag1o4Q43-WiMIvhOtJGvHCQBH52MrE7YflnA&oe=6A5A2E7C"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
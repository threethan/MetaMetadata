244715", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YzH-kM2YDp8Q7kNvwH54aR0&_nc_oc=AdqBST2PZ9Q9dWeqejTAlsrtjvt01d_eLBUafBbrscNLAJadXlniZqIjMXrwTkXBn1o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7rD97KSwMPmOySBBaXqZbjdA5UA_E_5R1XQMNBuWdXPA&oe=69FCB434"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5bKCVvQ6LSYQ7kNvwFm2gdm&_nc_oc=AdrrCBnzLUM2p_fmA6kgKN3aVhQnbIMjDjB6gHyqTxamJ_L4FLJMSn_xEoENUf1Oo6Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4-318oqCAi9IBneHLTtnqKsRMUu2gUaGuHnpgDGfn_9g&oe=69FC93CB"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PKKDBJ9ZX5MQ7kNvwGY9qad&_nc_oc=AdpZ0NAful0YSJHS7co4d0hhrF9_0ZrS4kwdF36vu9TwKEXPiEpHE_DWx5cl7lvgTLg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7AFkFEVkzdocsxkwHqbz10CvwR79NK3YhAiSHWbFYhgA&oe=69FCA7E4"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w16WdvyoMxoQ7kNvwFuXs8o&_nc_oc=AdocSvRRbI9aGwNnJQqgA0tQ18o0sSfm7kVNKPANBuMPhNR6DAo4ECI79vmjipQo4F0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7MhlW5aYiVYzfEeIX0-aCHSMKR2q_fsMNswM5beI5L2w&oe=69FC9160"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5KgI_Xi9SBoQ7kNvwF0muEy&_nc_oc=AdpZ6P0_GusRo4LiS5NNdvKhLs20zGAE47-rNn9kDOab-0l-L3ldhz_GOVj1I07MF2w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5047rETmKwfXoyzfhgKt_l-zH7xI8KZb1clGk1EuPigw&oe=69FC93FC"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
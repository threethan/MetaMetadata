244715", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9CKGZqw624oQ7kNvwFvqFuX&_nc_oc=AdrFWB6vdlYRphZ3FP3cRVbYSG3LYBr3TFOXVcl4Bc_rZCtpOM-Ky6b5Ytz__yJ6j1M&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM3w305VAErgP3IBKQHfivvTVtNn4usCCFuWTBBI3kPjA&oe=6AC51834"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SjUG-0QlmwoQ7kNvwGwG6uT&_nc_oc=AdrO5pGODbvGbO3YO39fgFCEcRP5PGNVX21nw-BlsFBOHXBKim2tBLR8fWbeXCSoGJ0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7H8gOIXhDpy9sCoOaRJE0N4BoBDEPX3FSC4p44uTYTQ&oe=6AC4F7CB"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vVg9zWkEt2kQ7kNvwGdr_tv&_nc_oc=AdoJ-GeM0seTkETvXsn0Q9ouhl8b9ImHjtdz5MDLwJ6A4i34-saG0y8TyajNQDIrbqs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPa_w7Vi6dhVliYR4GQZbixFELvKvaTbPWhiIVHub0Zgw&oe=6AC50BE4"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qy4OMBkUuicQ7kNvwFLZLdv&_nc_oc=Adp-hmKnkc10PhFxR253auHW8HH3xdYrSNi-M3ggX3rhnkGJm_rhBIWPnRwjIh0xUvQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNtsqiugKHp08aRuvn2qHazIOvxVJOQC6JYyP-VfDF5-w&oe=6AC4F560"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-71A4qRZIKcQ7kNvwGnqD_i&_nc_oc=AdpPG_72Zww-Wmh0YINzzUsCGE_ErxyriMpQM9z3MmaSnQxeFnENQEWROEhNfjAUgKU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOM22_tDrR8wTNil1iLYx0PaOki-ez6IvGWDDBMBHfb0g&oe=6AC4F7FC"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
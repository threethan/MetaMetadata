244715", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v3DOJYlUMSoQ7kNvwHx025u&_nc_oc=AdofAjk53eyL-devbp6WZI9UPPrfZ584tmN-43Cu8LzKWqw-iW2YbdNKiLpZVn9zy_Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3OlfjLtBjkEZGQ5dj19YXneuh5gp-synxJEYSxtASALw&oe=69D8E374"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lzjk0DkU5SUQ7kNvwE1PpGE&_nc_oc=Adq6HkKjzWx-q-igarxnfb7PZoS625jrMsa00sKDX5kOTnzLHltzgdESdoHKibdYnrc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2LDCyFTMPe6Ic3aVAqpAfSlAefKmLlwnjAYeCZi33U3w&oe=69D8FB4B"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IlEcRO-HgCoQ7kNvwGsr2qV&_nc_oc=Adp6saPIdfzyeeCtZtLWBkMQ9T4Zn_AUPsNJ1876gvWWK0QjrpjfTxcRe-g8YtDRPnk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3yMDA9rTZ1hAhHHSIwUkb4AwEkUYINGm-YwoVVK40nSg&oe=69D90F64"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9KMtJKXVdLcQ7kNvwGuCIBD&_nc_oc=AdoK4ymgql5Pa8jZeky1ICg1iJHzwB2szrLLZnMF6Cy08_vmTKoUgJPujAMkTRPZ0B0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3PPzDqXxCvrtI93XSIP50yfHPFUC3I6UMO55NA_TolOQ&oe=69D8F8E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gm3GALp1dekQ7kNvwE0M9Uz&_nc_oc=Adqc94EjViSxrgI3kBv1Js359ZzO1MIbXv0Wt6Mxwa-xYsPxOQO086p2Zzir3_E_f8s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1cX3AS4FEMYGJmtxNKeQ0CU836d7FxwpHQ_XkR1kFqKw&oe=69D8FB7C"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
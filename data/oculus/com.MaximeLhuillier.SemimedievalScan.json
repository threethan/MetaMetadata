244715", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lhEtqD1pMBgQ7kNvwHmpiSq&_nc_oc=AdqLHbXyzFAxkQtS-J0fjctlrzXRBPcqklLf2-ksJaT443xtghJjlhPp5Ev01RJf_Tw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL47OQlLIrxSu8k-nYJ21qZ3hVOwXk50G3fAD4C3zxSUg&oe=6AB697B4"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ZA08xxjnrUQ7kNvwGkc5cl&_nc_oc=AdpRgv_3mMOFR2b_CFiaPtkyT3t1O9HvZ3-8DjIhQ4J1w_uedzbMTzgMV_dTu2HZ8_U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIAUXTI1ZAhvoqXhfnfn745QX1KDdHiWAj0qLBxbza5VA&oe=6AB6774B"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ob8_7kOdz5wQ7kNvwGFpvTV&_nc_oc=AdqM-4om5gms0GQZQmTbwbLe1MdByK53-WRBn_sQVxYpkToTK0lnsMKqK2Qc-brWRlw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJ4-PHMdCqDJctjrlNXfhM68jMgnrSBtmos7AOS0-E0w&oe=6AB68B64"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nJfSrBZpoksQ7kNvwEfSD_0&_nc_oc=AdqF92WbzwudEtRIraRG5wDVNVB1xvR3j9GNvsCqtk5BXFNOqijhWIF-wplHs1dzrz8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhqTeIfr_MYSnjRFkZukR86L_MXVNxJQ6rLsp7kEe-sQ&oe=6AB674E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Ic7RhdCTMQQ7kNvwFcns27&_nc_oc=AdrH5qHjTZ8hxztmd9Wtmq0zJP_w4szKzsn8Fp7H20q0G7kBJDukfJCrmFLmZpUsTxg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYkohLkl-orJSg3g1iHTS-A7CUJ133lBcNdhs4THqzoA&oe=6AB6777C"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
": "Screenshot0.png", "id": "1235098807268738", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38982658_1235098813935404_7719619199213845753_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XFgTqyyHK_EQ7kNvwG98wnL&_nc_oc=Ado3CZnY9A1glMLwIXimg3uysWjS-mIG8jKxJav9u144zQWbJZ2XZ_rAc4FmQErlVPg&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtHOT6OuyUvZuQgr03vMImH2wMzdh2GefUS1vYzgKQpA&oe=6AFC8188"}, {"file_name": "Screenshot1.png", "id": "1079721616244715", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JBI47c-UN4sQ7kNvwGG6KL6&_nc_oc=AdpOUYTozkNUVXE57ucoxHC1jzcHjsGoUdC8oEchscmY_UnHGAuKfZ22nGsD5c2Ontw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlOo4qwL1BeQaeugAmEB645J67Lcd07SSbNVDSyx8qQg&oe=6AFC7734"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6OeOHzDbuEIQ7kNvwEoyUEG&_nc_oc=AdoOmHp5AspoNbb0pN35BZ5XOqjayM6SUwYDuHqqG-NlXCE5mN-7NHgQDwt9pVLs7Dc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTumPEdRjJi_QnuezQDfnamivEPc4bbinPI4NfxkeWCUw&oe=6AFC8F0B"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rArfdn6nM5wQ7kNvwH9kQMi&_nc_oc=Adq8VvY3BGftfy0PvAcnbcO8LINzDyd6bnGG-0nzmFxZqXNmb_GxKseEFrKZVkYDmzA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ15D2VJ9Apnxu4ZDmnhSnocw4XfYM_yeec14LroYycbQ&oe=6AFC6AE4"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5MqsuWiQBh8Q7kNvwHBTfNP&_nc_oc=AdqrSk1ttpdX1Wlw5xZZdMpolPfD4TqSnRH-dTS4gkcaf3ntw5u7EKThEJmx-yN-BdM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRp8zH9b77MyvYjUQ7i6AQkLI3ZE2yf_5ueH8jkZk6o_g&oe=6AFC8CA0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GjZMRwbvrEgQ7kNvwFf99rh&_nc_oc=AdpuUblRV7kBAG72HgyN4IQyGf938ba-q64rnm6aMHJ3LCIUz3PQIVLlNm8J0Y5RNnI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUDn6M55lW2NgLhkrZmk5qVWHEunge_YgF2KZJwuCCBA&oe=6AFC8F3C"}, "display_name": "3D scan of a semi-medieval town", "keywords": ["photogrammetry", "reconstruction", "360camera", "digitization", "scan"], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8744915575541513"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974593_643470730539088_3502460444141589985_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xlX0NFGLOD4Q7kNvwGgRVlu&_nc_oc=AdrEpp3RtOJjGN8As_tyG-jaoATlh81p0cuozuz_Vm_Wi0aZ3EjNb0lPHBhBSeif7EA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQfSeQW5kypzccy8HimR0BKc3QVsRH3h7JQpECNHMaOg&oe=6AFC8C31"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "3D scan of a semi-medieval town", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Travel & Exploration", "id": "
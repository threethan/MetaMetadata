244715", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qqsrvrG7LdMQ7kNvwHW8jHY&_nc_oc=AdpQ22lDbDnuNsVMXL-UGtMucKN9VT_sJqZ-UMSKFeSv_uiX31P157AYKPOsufgN5Rs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSatUjisU1UgLBovrd8yxLHl96HgifBjOON1r-9hYyryw&oe=6AF1EB34"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hsWzobZ416EQ7kNvwFP1uGO&_nc_oc=AdqHDzJUTpQCkGkJAlpM7tSzydpVTRPKhZ6fX7r-k5BNAkQCKX3hvmKSWsv855eP7Jo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmEqBiOVjiqrRMLkZD53rsa5GA7SG5Vz4uqAYmXKfOSg&oe=6AF2030B"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ttTczA6B2VsQ7kNvwEeW3BW&_nc_oc=AdpWzRcyvj4Ylgp-g07HFVPsRZHQNL1i1ZsDuOarSVWQMsZozN0LlUqIpCnbbBK9VCo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQE3_hrfPQuSPSX2ci7sEhhu3PYTmyfGxxrK8B5JUNSzg&oe=6AF1DEE4"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=890JL0C-r8wQ7kNvwG9vJ9u&_nc_oc=Adrn8l9e3sWTsC6Xvi_DlSHEaHu5gQ5M8XsOBUlp0YN4DPua96wr-ToQOx1V4qeFpyQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtwFSS_7nEgyq8HTvjUko1cH1D-FR4tpMFyrc_UIYgwg&oe=6AF200A0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-cCgCKfqFsUQ7kNvwFh4sKo&_nc_oc=AdqTh9-r0WWUguJne8zBhaBaPxvKbE1d1JcnWEJsgzOdFIXKo1vIKCuE3H5RHmUI_WA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxu7OcKo6kNvAPzl8KQqkBr-bqiKK8oDU8iyvs3fdV_Q&oe=6AF2033C"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
244715", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9J5jDDDg-VEQ7kNvwEF8bgj&_nc_oc=AdpAjX2AfxLi0muTBgGQlCKhl3oy-irZd2lBwei-QYlVjmw7Ic6upLsfZCS4awG2C3Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDvoYJQyMHXV19MhInoLa6weKKl9Ip04rWfxpuVh7RRcg&oe=6A4BCE34"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fmyBvoki0dgQ7kNvwGw349w&_nc_oc=AdpU-KboeCMTVM13vHyRvIJP4rFQPndAEcmjs-1AJj-bVOuzRWgud3Ic-50ff9beMgw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAm8ZDzHXnYE9VUiFJgve0erD50GuVlTp9-Nq7-gMIG0w&oe=6A4BADCB"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P60psEQZDhUQ7kNvwFee9a2&_nc_oc=AdrkNrg4TeBsiu3c7E5Q72N3FOge6GbZye_eJk0652qcOAMdWs5B-NuQ7EMfuDI5gW4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAy81SfZ4Sgwogh_iCLJbp47iKvfFrgehbpYRvHM_Pe_w&oe=6A4BC1E4"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=neCKdEPHlucQ7kNvwFMBB7Y&_nc_oc=AdqQ0plf16K6olCOlJKEqrTx3Pj7b3JHEK3fFl-_ZvdTlCnbuJYyPUC9ePWtqIya6Ow&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD3VpIAg8NBXktgUCTxDr79l8Rs44llHy42AOjHT8X_xQ&oe=6A4BAB60"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ylk0SvSvjsEQ7kNvwHZYLX_&_nc_oc=AdoBGhswr04XOb25H3-GgszfbvE6S-BI6B9QXGmy_O2USGB7kiFiWOFuRxGMGa93WCk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCKtGVdxQUR5bFYjwhfs5mWgMs7diMit9mAl6anzM48Gg&oe=6A4BADFC"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
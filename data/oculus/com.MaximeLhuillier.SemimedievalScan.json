244715", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZeCbRa89tKcQ7kNvwEsX6Z4&_nc_oc=AdrodEvGptQFUnc2owHbps7lO5Jwnet6Y9qJ4krfcOiJ7ZBGypiqsD6qWn-_LBgGsCk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Nu-G6s6McwzXs-PsC4FddNts-52NkfCWzvGFBtm6RRQ&oe=6A2D7BB4"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vE9zLe1JgWUQ7kNvwGqdy2N&_nc_oc=AdpkZoJiZ0RcIAZttHC_Ej8W666Hzr-S_HOLRICSiG-RuTQJmp2OSkb7PU4zeKNXNb8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93ugBFIdJq6YUsDVja3IR_WYTnIvgvNZzU4xjVh28F-A&oe=6A2D5B4B"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=81li-gZTyMgQ7kNvwGIvOb-&_nc_oc=AdpEqSZ0ocTVrJwDX1dgGoYnieE7-bYVvo8HBIJgHWdtA-eDfTQ_Yq0c9JYTKy-Qb4w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_g2GkWFAG8J8jJdmdjJ7AYSnvk6cu-PRKpXG-hfGOSdQ&oe=6A2D6F64"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uEklWEeeLncQ7kNvwE4NbiO&_nc_oc=AdpF4ZGQOiNe1K0qSA3AlsFrenE6ClpvgcD2K-4iffMco8XWNvrA37dOWnJbVJ8jPZs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_j5RS-xhAds5BleNCrDGuZcD4WKS-xx8sphaG9Z2JoQ&oe=6A2D58E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f7TrSV_UfnIQ7kNvwFpt9Uu&_nc_oc=AdoCsZG6cyt9kRGLO5FhncilvRGPKqCgz5eiuPqVtcPG5w75T_IrNsYsoKdkftbC0ag&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8MUeYsx7I8zeuOzKBRkJMKzh8DyuRad9UilRgghlC3SA&oe=6A2D5B7C"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
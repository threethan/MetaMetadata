244715", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6gTPZ_EcmCYQ7kNvwFo_yn6&_nc_oc=AdpuTR1YOLsTRw_F9aUJjYtkgyjUpbsaWXdBYBc1pkwYV7aj4T4Me52HbbFmBRw-4n4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Ft1LglZkpxK_i7KIfT1RF20hx6QSfd1suKYIgkS0G7Q&oe=6A0D9F74"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tAs1pYvk-soQ7kNvwF48zLA&_nc_oc=AdqA_PFtc9acUrkNfuF1RcmKZ2lKOOTMbFfdTYQPgfSAJkq8fEAZD8ZpxuGzJdBRQhk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_XcmNY5iFxHeBrrZPFhs1E7R-aD33iuXY_sr-duXUNg&oe=6A0DB74B"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Taqb5ne7IBAQ7kNvwEIePgb&_nc_oc=AdrubMC2NsunKhcrgeqUraZyYwiqgFCWjnhZn-q4uSPjtZCw0NlxA-Dp5vAGDUNa21g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60zwA6TSEk_Uk1kx1J-TirAL5ygiq_pVBotIrgaf9P2Q&oe=6A0DCB64"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aJSnQ37Oq8YQ7kNvwFWnZJ2&_nc_oc=AdqFtsKN-_2uzqdYAgW2tBLQUKnVPFfiFCYP8P6e3etbgLvZ07HUi7H6tE5u9Ydq9hs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af575DCr0AVykO3aJ757g-wDEDqyQKhin3WZqNrLlHGcDw&oe=6A0DB4E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EeLQQSyIkDMQ7kNvwG06-jd&_nc_oc=Ado6s63uyD37y3lLqIskyVewO9-PZq6IoKXz0YFNokrTI2YTOUVojb5CpaOgAySXWYE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7kj3_D2jBL9n-lvVVXq_OHKY7J96p7YptDMyO6-ycK7A&oe=6A0DB77C"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
244715", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3kdYemfg4fAQ7kNvwEUodAe&_nc_oc=AdpteJ2E3PpPo88K60VL3N-yxDICKjwT9YXW4abO9W276TUonPylsSNighWU6PCEPvg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_H56jr7NZo9hLMwO2Z1ys_DDtFwyP5JjPto-Z4H-h2Og&oe=6A47D9B4"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MaPPkVJcZ78Q7kNvwG-S1L5&_nc_oc=AdovwWjqLgPVFjP1F7XbSKBOTVPWS6QxW7jEmhCQBcoJcewQRf2Sufi6efppYgpVF80&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8yBrzP-Om8omW92hnz-jqdc7U2GVzPGWbB9NFMkw-l4w&oe=6A47B94B"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hL6_JYu-yeMQ7kNvwGDBJ7A&_nc_oc=Adq9vUDBW4dnYt-fEwjtatBK5S4p2i86keAJ7_BTB3JPo4TAjiLjDxcDDqzXnNhc22A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7NFCt2i0xazmK2kTWqP3vWjOLHom7sKIuK-31fvTHAw&oe=6A47CD64"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MURcPYgsI58Q7kNvwHQQc_S&_nc_oc=Adpxp6zytN8TYkdr3bGerxGDkhIQwsXWs6sWAD8hQBbvrr7zvwjd0nFgxLVmPoFQTHk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8j53CSy_VSIV_CpamBJfB8360-6kMjWpy7Xn-uOzDi5A&oe=6A47B6E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hNaNdWBQ3QEQ7kNvwElDCZG&_nc_oc=AdrcQVRZAggNvfwac8rp14_VjLnzN7FefzpIvYhH2kvdEOmv7NXx5kaMoUUtMYosSSI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-39rXuHp98opSUiZ9SHnLqEJ_7dtnmt5hpvV1jBzDYDg&oe=6A47B97C"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
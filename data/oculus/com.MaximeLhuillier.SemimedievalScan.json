244715", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RkdMpFe_f6QQ7kNvwHdnl5u&_nc_oc=Adq2AvJnOrec8l1F5ctCD0L8lca1fFwS3A3mTxMqFVWQVfCpug48W_3lvXCNuy_CQC0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_T3nZr9ycd_WuFK3P85UutGhMK8J8nKIB0NTi_rWbgcg&oe=6A2AD8B4"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nag7ghCvQssQ7kNvwGktMKm&_nc_oc=Adq0AjMT_HDyJjBqoPbTxOu4KrvKJAmd8EaRb-k-IYSAAlOMA2Ld80qtU-aync2L_Jc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8hzEVmZb1xWPGvNlnFpfWaHD7QwdoXvaeLsFzurlcm7g&oe=6A2AB84B"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B4Cfi88hyU0Q7kNvwHSampe&_nc_oc=AdpzJKPQRP_aEJVZIsz2OMCGvVrzLa2CYfH_HTDlps5YBOscR6VoLsUc3--pzdYcTuw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9gbPwmtVGOZRHCaDUg8_D7tmLN33QvJNS3J_yHrt5VyQ&oe=6A2ACC64"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uEklWEeeLncQ7kNvwHwhmJL&_nc_oc=Ado_8TRaq3tmmntzzuFnn3eWi5P0DoTYWrDMngyrOrVtzZljU6J1oofaBAc_gcO2g6E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af914kqTfFmJ8HfbVzp8rVx4QGfxZa6HO3DbiW3Y6KJJJQ&oe=6A2AB5E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fCCQQkQCju8Q7kNvwF9neSj&_nc_oc=Adox2YAbcufFx_VefGfcc2fxcqXMWlMGbwdtXfFkNmIb4E4ifxQPi9pCQbcheltpmkk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9UUSWWfyr23jgT-5rIDXo9ahmSEr6sUEDZ9THGMjZYHw&oe=6A2AB87C"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
244715", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gpnmz6kJ_2oQ7kNvwFeJtr6&_nc_oc=AdrYtLAGAUwDoJcg2M_qH-Cv1LKCGvtxy3EXomDdE1eyZUuhSIw6v5N-FaGp6zerb2A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6UzTlcrY5Ht0dAw4rTiieF656BnGxToJJUiOOeBCdYiw&oe=6A007074"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eQXCpBkQLPEQ7kNvwFR8ini&_nc_oc=AdoU_jcqyFmSCKqLusMcmqMti8SonEgH28pseJntQd9STvPmiP6dl2x_PrKZGA9ZilA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5SFGp_Aq6ZvTC0LqTXJctIJcQv6xsHIQFcWNy6lMC7Ug&oe=6A00884B"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=erb7TNGb8CgQ7kNvwFJzIP-&_nc_oc=AdpkKRRAio_HjGx5NoP104Nipg18Nc4RnCweG9C52O64HTH8lng7kyf5S4l4w4NPu8U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4bETy7XfMGPvPtTWCopysem5r_NgJGNj9MAJU0iuOu6w&oe=6A009C64"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qOED_CqhpSIQ7kNvwGz7--P&_nc_oc=Adp88KAsLld0tCYYH01r1K-q_7aYrlwGr4LYFHgx-hdIVc4XXVsMpMLgpgvAdtLw5gg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79a2jKcNQYffQVFLHxLWbwdk2iSvq5z2QRhqd9h-vc1g&oe=6A0085E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0uhbVSNxvh0Q7kNvwHOKVf_&_nc_oc=Adpnw2ZfpFLAOBLwHfHZtdjBSCvg0StQmmEbzMrvaIYnkCCP0MBchD-pwKUP3qJ1SNE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5e3_v9DbDruxDeNzXhPAYfqkjsu4WMBGlR1LLGcnYRtA&oe=6A00887C"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
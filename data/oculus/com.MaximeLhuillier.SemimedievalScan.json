244715", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bxGbZ87ENbQQ7kNvwER6Iju&_nc_oc=AdqOTCQHTAnoLrVE2fzl2ZxyMHCS90Xl4LNgCdFvwYMyI_QU58GglgizWPSjp22iPng&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcfjG6zEKfpqXTR4LdNTF76vQqgcFUFAw2xMTJsczdvw&oe=6AE75F34"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mI4G2_GFp_EQ7kNvwHnaH-Z&_nc_oc=AdqG_byAsznUEAgSJgQSpb55E2xofcYc96Q6TGlabWoxg8sRBW9Qu8ismKRp2fABYek&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRknitMvG2VTIeBraz5x4OfmoGQN3DuR1Uhvd9MOmjreA&oe=6AE73ECB"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3yQk_1zphNUQ7kNvwETdz0p&_nc_oc=AdpNk8lJk9EXrLZyBfqqj3NJQwr4hSUpcBzV8WKfHcQE0XTdSC_YwMkt377efZkq-mk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyxlf6Oz9hKf2pnHzcjMmFaIqjNAsb7QAcMDfie4M0ng&oe=6AE752E4"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s8sFoljyuu8Q7kNvwEeoLFw&_nc_oc=AdorPFfHZJItg5NCUnEl93B81b7c5X53Lr5rsCp3LouuZ4on47HrJt8arc9mvVpa7LQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4kPO05oSMooD4W8nzicgNnObBp55e6Z1qYzpopbgGQw&oe=6AE73C60"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jYNH_1bt96EQ7kNvwFMXJs_&_nc_oc=AdoOV6DN71b41WqcAddgJu7bw4U-4ZvCNfNUStXWbPQi1dyESPsHKJCyXj07ZbptkEE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9aNh01Sf7Wz-QdMtRW6-4NSlSWIxHn8MEdChPkimV0Q&oe=6AE73EFC"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
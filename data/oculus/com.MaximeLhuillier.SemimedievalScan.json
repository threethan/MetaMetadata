244715", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ls3vITC6yjcQ7kNvwFxdnKR&_nc_oc=AdrCnzD-nsMf6-Nn-IxllIi8UFE3YNwmIfzLuyWfcJqjmF8SCamhipLebxGhyw_HRe4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1jyh-f9eeqDuQmwgR_Uv5fDq7-MmVuubprcxwTjelHqA&oe=69DCD7F4"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kGHjx0M_BkgQ7kNvwHhfowu&_nc_oc=AdqXi4gufp1NDk2OcCIdc5GMQb9tNHOpOlUhQCfLsbATw0p0ewWHZxvvifLVHwEEU_4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2tfv_UPRWgPo3yUzDTCXj37pc5TkR0j359_gGh3AokpQ&oe=69DCEFCB"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vvHuUKMi5zsQ7kNvwG9Z8rb&_nc_oc=AdpWUmei6LXHWX4TYzaAjpvuAMayPn2r1K8G3mgC0vADNnV-uZMY2glkZAMXYICNU0w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Rqxo7-6RaL9cHjRGtHIf5qgldW5f4sE8snQnMMQvx2g&oe=69DCCBA4"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dKIVAv11-qkQ7kNvwF4anCP&_nc_oc=Adra3z7LjI5TauwIq7DiyM7_dwyRjbbPT9XFghwWsMhA5bGuxIuAq_cneG6EsHfdC3w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1jCqFziB-yhvPqiKDOY9xDHPieBI5Hy91LlF6Ts0mjjg&oe=69DCED60"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G1FqdQFcjX4Q7kNvwG1JcmT&_nc_oc=AdpA_zbDTpYe255mTPR1TYXimmQekRTwpMRJ1cR9kBFROD8ChwabyjqtpWT5_BbkamU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2lioAc4aDJJlWj0bHMgEL8pLljg90Oet_RydBqbjmIbg&oe=69DCEFFC"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
244715", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sIuNGiqeglUQ7kNvwGams1t&_nc_oc=Adqe4pVT5XbkVq-u9zG4zKBd_j31woMKc70ZTSK3BrFm6bM-f3tl37SIoyojDNCY2-k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIMK_Uf0h6OXlrdujO5_OrZ7TZe0mULJdLWP6VFY0oBw&oe=6A8C2F74"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m6GSktrbNToQ7kNvwGC3zrV&_nc_oc=AdpIHL9uqoUHgShazOHo4lNrIbU4kKp3Y-RgmGh1A3K_tc264fZqRj42R5MqF2YIY-g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGO2Q63KwrAESvGbfmhVcXp_20SiPOyqCEmKNqooNdkSA&oe=6A8C474B"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=avr8_emfE7oQ7kNvwEIOkxg&_nc_oc=Ado5v3E9qLxL8xWTuufUm3X3t4_o1UlOcwIIC0GvsrxpsqpWIG6ROYl92Qj3UBzMobU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEeiJVUdn-Rd7E_xIKMwruy3UDHUXiBZB6XfWv0cLIiMg&oe=6A8C2324"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5PEFKSpxbBoQ7kNvwEhKBG6&_nc_oc=AdpLPprkRhqv5hdt3XTHAH3AD51qfReLdm6JzopssWVkmsUN6n3R2_p4Wyo0fP0Yr-4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMdQnkhlAI2sU9A5vPXI4wbrX8bkvB0qc2v3zuW0XH-w&oe=6A8C44E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4pJYQeSSgrAQ7kNvwFTOdX-&_nc_oc=AdqO78gQemBiTTnHPYgKR9qp9ADxcSovYoEzO4KIHCLOrsjyPPUXHARKBPkvsuDyOLI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFBPxG1E7YeDQl7Lu8LZyheoETIpXzM3ztjy4H1KEtYSw&oe=6A8C477C"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
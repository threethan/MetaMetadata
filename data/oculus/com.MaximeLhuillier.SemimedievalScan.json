244715", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rSZ4YA1gtWgQ7kNvwGKMdgh&_nc_oc=AdpkoshUdL-Nu_2OoW1EK4lmxrkz41Ng4qDLkhQysRRdVzzr3Ue-C3gMeQP00kTfe8o&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx1NTSGQzIoOspJEUU2xZhYpdTU7oejjMGC4UTJUhhxng&oe=69C3CB74"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KlT3eRsYu1IQ7kNvwEbPNar&_nc_oc=AdoEDYCgWk6-WDhJUfDGJd3qJEWMfo8ZUXbWj02CGXBDT1MhZ4uBnm2lJNNgPZUKb20&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyIAlIqS-fvLHYBJzKerqOHjcN6aUzpaNLUvkx1JDGzQA&oe=69C3E34B"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wq4wUdgXpyoQ7kNvwF0P-F7&_nc_oc=AdqNhAwRXvXkqv3m8Wy895FrWmF7gIGiJ8fz_LcSTTNVRMKunYLzeXxu1mJL3MVjhkk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwov8rFsTI8LHzGJvTjPnt5dLepjTssS08D4L-QFL9VpA&oe=69C3BF24"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lr4X3IMAY3YQ7kNvwFWaoS_&_nc_oc=Adqc44O7zkVumSa3NHgnkmr7Vp1V1Rvd3o5g53nCQ6ZME9n1cRUp594hIWVfLuiLJX8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyANRBmJL7DqnmrKffSjMqdlf2QgsNrCzA8Sxo_ilrr9w&oe=69C3E0E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OTRkDI-7HecQ7kNvwF8CVFE&_nc_oc=AdpXn0ctuO2-KpyobuFt0gpf5K8f1p7EKKtIc1xen_SDiYQhGIlrGE_hcRqM425ptnU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyeGiBt_JrZ9IQJ4UDtO6pa3VRLRJTSxl7wcOa15KFKmA&oe=69C3E37C"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
721616244715", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=00DWmQvtl9oQ7kNvwEWykx_&_nc_oc=Adr3CSQUNjaszSdJBaHv8rgzGwW_N8MJGWWoJE3A8s9IsJBU2i0pyty712ChFsEY8Vk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpcJO2Q1NQic4ANTIQxFJuQ8ffTBK1V4KKu9S6o-3Kiw&oe=6AA968B4"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C2KNh55llNwQ7kNvwFA_pPu&_nc_oc=Adr_J8vmomngDT3nTKxcCrLPNwDxxRa4cVYwkx1t1blqDgfEN9tm11rbbwGDEjlk2bw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbk8NKNS7et_DrH35BQGco2yFcokvpNaNbVR8oPPyRWQ&oe=6AA9484B"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aRr9ERcmlpwQ7kNvwG6OToS&_nc_oc=AdrpYvq9yG4dsKPfk7BQogSIErO9Q2I5YdbgF_9g-a5h8uDmBCjPrD3dvIke_0k9Sqk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJb-1Xd1qk5sH8L2z8fo4XWmjQpd89DG_9g-zATYdC1EA&oe=6AA95C64"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SwzSQXHQ3_oQ7kNvwHWDCIt&_nc_oc=AdqACQUkh1AtkDjIBK-c5B9cOHWLhkkA6tXNPUgB_g3fQDd5TwvBpRiHqZEl1uereMU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKvvg8U4p8r1YkWlDXGv2OB5i8jibEB2VmyNQCuQkmf3w&oe=6AA945E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aCDLwB9omQYQ7kNvwF3eJMH&_nc_oc=AdrQOAGTI3GMGOHzPAi9myrwUb5EGJ7dS3TFjUrFoQDYDgRnXIn0KbWK34QJpxTlNRA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKD9WnyH70vtxgNwPX3q5oUxZ-CK2v8hdqJT0RZKq3rZw&oe=6AA9487C"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"},
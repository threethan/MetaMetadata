McfzW&_nc_oc=AdqnILutKujvIOdeCcikJc4dzOKa_PGwnO7BJruva4GZSaNU-IXXYVxUMpa1yGJ3Vuo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1KSm4SwF5hjNdhw1u-CUVrBbLu9ZQrOvq51pZogWe1iw&oe=69F1EFF4"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0RxzqXtXZuMQ7kNvwFWlf88&_nc_oc=AdqlfUXTS5D73eK8deEd0JLonzKVREcFXUo_Het60eHEg8_i8mLvCk89nsfgst6x1ho&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af02KQ8VaXq4ArRMsPSV4Th8nv-FVHy8eYCt8zByt2OPjA&oe=69F207CB"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uiuOzG4K0OsQ7kNvwFp5RN_&_nc_oc=AdpOicRNRWxX3O-Q9ABcOs9f-GSGxc32-azTWLuim8aFWhUDm2DrBoUfqrt9JS50YYM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af1FOGS4KynuyaJqI06ZwQodBw_YucqgSQmrsh67ROFDeQ&oe=69F21BE4"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FPVT9urdiCgQ7kNvwGxCRlk&_nc_oc=AdoXKZZimTC-8SpTNEl2CN-rsqeck5F3WliKkidBxVZ-vxePHuFYyhmOw3NWne0TSOY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af1ThUqxMa7YlAyTnD28-Ajk3567o2n0jMgBlKrv1_65Vg&oe=69F20560"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JWXqfBze_88Q7kNvwG74Oj1&_nc_oc=Adrgr8u_ECY5XEq-P3XZp3lePPaM_6Zaxh9EmPYT9CPt3jY90VK58NBdLIHqMVm3jr0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3yhlK8D0Hbb9JlIwg8i9X-JI1sSp2YmOfvMGvksEafGw&oe=69F207FC"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphic
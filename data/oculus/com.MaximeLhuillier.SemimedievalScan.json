244715", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=959B6p2yXBsQ7kNvwGzTrM7&_nc_oc=AdqQ-hxjXzaK16TMFGh3feCfiTfOdwvVr9rg3Rjl-h0IbaxxLAQkJtXNDFpymAxV0A4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjVBxHm8gVSWv3koxaXIoyoHbUAoa6Pw-zAFd4Y1LMeg&oe=6A7B0BF4"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ueRrC6WcciAQ7kNvwEoyxUx&_nc_oc=Adq3Qy5HmDh__yyIpwbh2V15vkFMiBji5yoyqJKtN9JC6nDRKeSXFLG3D8tWilxv2cc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPrHseqsDBHKjZBY-1O62kqQwaERRdKOL1Cm9ZnlkPfQ&oe=6A7B23CB"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4XqF0QB5QFQQ7kNvwF6dT7h&_nc_oc=AdoO6dtLiAqu77GAIF3_Q-RCOWHxPJIcRqPQLNmXhyWUoFjz_7R6e3HLi8Gwk-mh4uk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFs31wJOrTFI0ERHy43jRUNvCwvgIahbfxEHmpA-06Maw&oe=6A7B37E4"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rHkPd5wOlaEQ7kNvwGOns8h&_nc_oc=Adov95FG4vxdxWgvFmXWKBnSwJlhiawD9WRYni5AYoRUd6MH9lk434-7D2B1M7V4zHc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHyA63-tggmTzmqeb9FPVtsw-2RdWZdfnhUvr6YEjJ3Zw&oe=6A7B2160"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eo2OKMZG0l4Q7kNvwGz8n7P&_nc_oc=AdrXOZzsY4_k0pVHFSqeZ_EilbGpltvJbIVrho4QTkj7wRI5ZgQU1F6SzqiOHJzARPE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEjO-w8CzvOgrXNqSCgfSpj_7anQt79sxZRrwMCL8ieDA&oe=6A7B23FC"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
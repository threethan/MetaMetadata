244715", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S40fUZsfmE0Q7kNvwHs4tYT&_nc_oc=AdoLKxRH6wDXY0YxhOhq_cVxxIkhOi8pRKkIDxJlcBmit_RuDZ68kPiyh232pBZoDlI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPWdT3V21sTuCRGsyCnWpuXfwwZm0CXXsho4JCtr-J7zw&oe=6ADF7634"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gxiPShsd4QkQ7kNvwFpAmbN&_nc_oc=AdpVsr6gaLfaxmFekrbU_TW3jm1p7r3Vrur3ACmqxbCIA-AV1cuRIeJgUyh_-4KHEvA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPuR9-yTS8RpgJntU8u0DLMyWHvQ6dv2akClBrQZvobjA&oe=6ADF55CB"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZyRbfYt0fX8Q7kNvwFkbtHm&_nc_oc=AdqrvgVpFAnGKsHed27NAU1M-FqMP2AiI1tzVLoiJHDb0b5AnoXFbTYmCZYMHFjGDeg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPzWXUxiSKdzeH-w3jGJpjQPf5o6DCmm1gsDfkMTS8wqg&oe=6ADF69E4"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sbWGgA1iLhcQ7kNvwFxzSFL&_nc_oc=Adrur4vsZEhZMhEzac0UlJJ7NAy4c5RHm9Ytx2SdFGhILph3c87mUztKcKFYxNXei1I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPNLSWFbFDnMOqv7CdBPQ5VfADDkEAQUpXH5P1YtT2QtQ&oe=6ADF5360"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B7ZzjIGxuosQ7kNvwFprcay&_nc_oc=Ado1xiGSZDsombTqmDYf3aMpBoIj84osyY5MiX6hmGnXz78OhzE6RAc63uH1z24gPdw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNMIbgSge6DvzXb6gJf-n2Fl7GTYTgMg-Uoz2FauXlSqw&oe=6ADF55FC"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
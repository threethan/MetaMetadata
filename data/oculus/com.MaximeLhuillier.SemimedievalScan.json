244715", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v3DOJYlUMSoQ7kNvwHB0z3y&_nc_oc=Adp371UuopXaihZYAlEMwKV7PTb1JuYRfpm4fLBHS87u4PCaVJZl-wh1Hge_u1tWWvE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0YFG-596Q5Oqw8cVG2hawpDmHI0r4aZD4mTcFwTSqBaA&oe=69DB8674"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kGHjx0M_BkgQ7kNvwEo1lDC&_nc_oc=AdofZmD4Gouq7AmJWNT_45w3R1ZQ_a-H-Q6rhc08UIcQ78o0h08nrj8gQYiRWsDW3NY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2DfBzsD1a0v9HhQ9svnv3I-JMePEvPoVYXaAWPX2KdJg&oe=69DB9E4B"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IlEcRO-HgCoQ7kNvwFX0ean&_nc_oc=Ado5aeUXNFmLbJ2GtML5W8vfbTmvFKj-YLqvnhq2UA5kV0IcdvmhDt3JTkAJOVZ75TA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3dXvDtSqbeMsPzcgTYbkzs8hv4NCBJQ3vbErtj0x9OGg&oe=69DBB264"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dKIVAv11-qkQ7kNvwHXIxBB&_nc_oc=Adp-15TY4xTjDwqCJ5VwuM_18SVVdDQMGa5hj-Qug09yds28tcTjx7aW8PJzaabXxPY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3cPJlIqCfHqKUTE2ikqky_CVGE3P8hO5hZYGqnslykkA&oe=69DB9BE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G1FqdQFcjX4Q7kNvwHZ003h&_nc_oc=AdrQYbwdvQ2EODMszHtJ2UGpOJWzBok1GCmSrx8ALP1DtAo_sXDbY2vI8SH5G6pyjxM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0H5EqKx9miZsjiDSIdWcwEFsYsutIGcJ7L4hBNW8y64A&oe=69DB9E7C"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
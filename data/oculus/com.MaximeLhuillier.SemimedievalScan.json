244715", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=djNBCszfyD4Q7kNvwFue6-l&_nc_oc=AdoqXZo0d2fNau5JJ40su5UbH0qxXuE0F9pX1_xr39WWaIb-LwHWn165o6j6sXk-0CE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Jkk3yADMlUtDUiMkYwp_4KuF3heh8AhH9Cbl-2TlaEA&oe=69FA1134"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5bKCVvQ6LSYQ7kNvwHx1649&_nc_oc=AdprIQZ__Hkni78MaAEWsP1cMaCWqFDrVFD9tAs4XLoTeCjb47oQjGU_HqYiSHcBl8I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Z02mOwAVpwgO0N5viiJP0XNWI7zBH78-NKmb2qSy5ug&oe=69F9F0CB"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pX1uVpqXMB8Q7kNvwG7LdbJ&_nc_oc=Adq0xs7yfko2YeGhBFlBMkYIPQOSyeQySBPGSA0Xp3HWuyuaSMjSJtk9Da5IYoXmm6s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Tm1lOk7lM7mMAUunauDCAejkLureC6cbbk1_xF_Fczg&oe=69FA04E4"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z1T8f94pAwMQ7kNvwE34pIA&_nc_oc=AdogKZ6OuYJC0bTqUR1935bnQmrrMJQLj3Uz-n9IZertJwuslNtvvx1q_9rCFJx5S4k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6JCudjX3NISpHr1uQUmxUuDx0tqFSLVgia75f1AB1a_w&oe=69F9EE60"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5KgI_Xi9SBoQ7kNvwEz63gD&_nc_oc=Adr1yxsq8S-7Iomx6siPK-niaIDt3XxinYSimTsqA9JIXguDCt9UevlcdU_NTgJgUYE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7t2MzB1GO-k5KVQe0Yv6FNo8pkErBUapyhAgNE53biFg&oe=69F9F0FC"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
244715", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yVdAc5bWwa4Q7kNvwFIR78P&_nc_oc=AdpuM_E8kZ8h-j-OQzW1s2utlpUML7elcZS7t-O0BXbUeaYPVgo7-nVI0vvzq8Nho9Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCOb7AhhXHGN_aYPmZ81szFaNswD0w5vjvLauFe2PYejg&oe=6A6B39F4"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GTV8FJwYqegQ7kNvwHU8Ivg&_nc_oc=Adqj33ONgnJu4laKxoueaJpYUlE62AOH9wbeDWdbCXk1ndiHqeHwhj-w0eC8cGKKUrM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAGTJQiHvR0EYLwdcMg0Fr3FKN2wz-g5Ojykxyfu2AtZw&oe=6A6B51CB"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LSHLEyIX_DUQ7kNvwH8Ztnr&_nc_oc=Adp2NSrrBptXYcP0jF2X1OgWxws4C3eS2mKBuJqxzSkqHwYjVw4cpIyVXjDNfjzbzHE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-Ethlc3F0h9BnYg5MbTzhPIuJCR5pbObk9Sc2cJtPKQ&oe=6A6B65E4"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YF3PQVRL-LAQ7kNvwFwkely&_nc_oc=AdqgQVYQ18Tlxc9B7P6Y-SpKkhoH5d1jj-i5gp_di4uJ6Tat_VJaLQ1BwYevDiwKB1s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDGvVXqNe8BkxUWpZ29XSjD_R6XI4IQZjcbd8TVS_4u7w&oe=6A6B4F60"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vpcEbU09IsAQ7kNvwFCnFev&_nc_oc=AdruMxAm3st-TnKP0xTeuQgVj2PJU1ZHuan-WdIDcnOKWC3vrE7newUAlnXhmDkpl80&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmLcokrpYbAyP2jV7Vmq1jWG6JcGWwecTLoRUem_NYVw&oe=6A6B51FC"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
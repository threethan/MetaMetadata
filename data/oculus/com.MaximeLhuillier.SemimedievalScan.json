244715", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mg9df71R34AQ7kNvwHQebwh&_nc_oc=Adq7NY-glGrJ3XEVWJO7gr8L7UXgkD-4o_hUqQrdMUOZny1oKKb5V5eWK_3Dix6xrcw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELY4Lis2jhXyMAKLAIJ6D6aAKCepM4WnEKdTE8pKiQyw&oe=6A7868F4"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ueRrC6WcciAQ7kNvwGgCdFn&_nc_oc=AdrMEzmv0GJIPZVUuRrAXp0ZVCLDnL7xJ59wXnftZsY5o-o5MBMSqyrwLHHRGYiyB8w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMjISdH0BJVxAoVtiXIoToVw0kHB0GjTu9RDiBu7Cq6Q&oe=6A7880CB"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=odCdBBs2I-IQ7kNvwFPoVwB&_nc_oc=AdqNVmVYBLqANRaqYj-bRJ-MCUIzvJDeVn0Qgn9wdsj7-Fyh4UPsj5KXqemHBJym5DA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbvIKCZ7Pw7jCTzcYTHzGryJZKARRIbngj-HFMAfsdqQ&oe=6A7894E4"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xYLxIxkoasgQ7kNvwFwq37z&_nc_oc=AdrrJIrxjESXY1ufkpY9D1bCL50FyyTvUYso9LzSUq1754b0ie1zoN_vDXwb_KRWlmw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRsRBiK70-4RUOI8qU5V-4NZI2slvyYx7nuW6mSPX4TQ&oe=6A787E60"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eo2OKMZG0l4Q7kNvwFgHLXS&_nc_oc=AdqpJtn3dUjTobkHHST-PnWN_nlu91Fx0pI-004_D1cA69R8BDig9VFNHNLzlCkAFgQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHSVQBh3tdX5yhUY2pz06pUlBubTfyP-59mSxWGl_qQ3Q&oe=6A7880FC"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
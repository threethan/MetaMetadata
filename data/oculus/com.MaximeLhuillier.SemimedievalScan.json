244715", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=--DzHEMCT24Q7kNvwF-_2Vy&_nc_oc=AdpJUZ2JApgI8uZ7BxybqCiOL7Wd93Fz0NdKR6oF141kv7DT5uxk1tDIA4AOvxqD7aU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3zLsOBtXbiqacwIyAuyqYecNVeSJWYvYiZrE8CxPZZNw&oe=69EA06F4"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-NbZBpNYXEMQ7kNvwH9s7a7&_nc_oc=AdpSFVmgTK2zVAQ_7JckJjucBI3C6OoFGEbegJR9YRbeRftBhmBtPxaEdwWe-J7QidA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2HRPTKWY-vW_YQkoB5G_uUkShRNurY8q0GiJkKzwcrkQ&oe=69EA1ECB"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rd30zJk4KXoQ7kNvwFOt6gw&_nc_oc=AdoKkURyg5yCkhihwsT7YiMPxXudwFM0MDwCFLna2bKY19ftzgzFWa6ngveL3Ffo2Tk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af25UyPLGnpjYdVFCpKtAbtpfI-gE-h0VkWiXonZLojjHQ&oe=69EA32E4"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yyoe5zSTd20Q7kNvwE4-ymo&_nc_oc=AdqD_VR1CDHShF0mMwj88yRyrSS4wwZrnP1OJ5T-C_aPinrIJzDytVUBM4cZ4CSgGj4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1XwM3RXOMIb9HwKoXKJoE1YKjZqaxMes4WtE02LUYBiw&oe=69EA1C60"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bEcHTm4UVPoQ7kNvwGVw42W&_nc_oc=AdpjQfF_CnC0GHrjRQqrxp0U9jELPgu4wOmclaoSuQXhQNeVwb83XsGOUiTaLfYzzSQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Slkd1Rj-ccJbSfiTWd3vOfeKwnZlIkCYm_JctxhO-uQ&oe=69EA1EFC"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
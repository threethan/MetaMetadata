244715", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UrHY0ylUDpoQ7kNvwHXzjXK&_nc_oc=AdpFtCM2xWRD4iW2L8JUV1BU5O6reNhifRE6CxksaWC01GOYlzi3lMar01jYZD7NXPs&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFj1_SpBTmGiXKV9YJ-DFcDvFfpI8ceixz1WbUvGv6T1g&oe=6A972BF4"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7y762Xtc0LYQ7kNvwH_1lBI&_nc_oc=AdqStfORk4kMrVPi2C7K1p7wTonzqoQAQ1dsWcsocuuuXnsQvE1AYhIodETxaLzLuJI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOX5DBVUByWEoJy6qG5CNwmrWct8JYlcrpGFiyS7ULXw&oe=6A9743CB"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vzhBfTCTEj0Q7kNvwHrKK5-&_nc_oc=Adpa83URTEp1XbFnIH6cPvrtCl1t3Ot3-UHMNVj1btijSwgUj-TMVmzarbZrAJOzatg&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjqv4ARRxnoXN_m7D5bFlxQNsP28Hgxuc4MCJ_owKz9A&oe=6A971FA4"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7PpATMFCCrgQ7kNvwH7gTKe&_nc_oc=Adod-f1lbl1F9OS79ohR-dOJQBEGJqiLOY1Jy62t_lHG3AV3Ve3QeTTE2WEodAPuphQ&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFwJI3NnzV41O7uWAZD4nyqDQFb6cfficys6HabGeR1AQ&oe=6A974160"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CooSI2QMzkAQ7kNvwEpqPup&_nc_oc=AdpvfeMA2F3RekEZAh6mkqrzL6hvDFMRjILGyrYb-eiyUgCbYYExodC6zJfB3GOunZI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH6IdUaMv2XI729vVLFkLomomzIFl3FB4pla5skD0pJhg&oe=6A9743FC"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
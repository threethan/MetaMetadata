244715", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qsRUTVQ_oIsQ7kNvwEV7Mhc&_nc_oc=AdohrKwd1cQOq664G5nW6BSa1jk_uDgqffahuUdT_dNYeZ0taHzA5YQ4isEtdazRlBM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBNWCN_-YhY5arI64aLbIrBs_svVBL8qcPqHWJvEb88yQ&oe=6A537EF4"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BcY5N99fDIIQ7kNvwFIQTpD&_nc_oc=Adrcek8pDQWN9ArKFb-IjGVWow8HYtqdALnGWLerSFJTMsOD0isyPjQeinvImvXxy90&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDzLusf8ecISF1lummoXa4tEHz9aZpPSue3YBBt1mro6g&oe=6A5396CB"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=65t69wfc-58Q7kNvwHQ438h&_nc_oc=Adovp6E0IjcJ7-WLTtBsF9EuDBW0td1P2L45Y1UzeZ-4cr6oiIqrBgYZ6Ay54emyEOo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD92obsw8q4bpe-u_PTmA0v5NacAauFlB086YT7slXluA&oe=6A53AAE4"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DNYGYIQVX3IQ7kNvwG2oiL-&_nc_oc=AdresvyGDuz_HupejX1ZuhoZ5xvnuc8noT9RSzPiXr43SsXoNc23cw_k3mIDkb59dNM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDijKuyXo1jBlnCxMUvGqNuAx_8iRWGcJodvX1eiL5y_Q&oe=6A539460"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f5yBAneNIDMQ7kNvwFJGR-A&_nc_oc=AdrxykxoTI7CclFTgjIb0k_eVSHutqRnvHBdfqPUcw8ztgBQMV2QtAvyixZbQkgC92o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6Nw0n-WUXIgwZveERtEyYbmrkYUGzN9Rb7hMoAvaV2A&oe=6A5396FC"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
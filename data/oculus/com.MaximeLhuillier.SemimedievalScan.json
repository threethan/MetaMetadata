244715", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=959B6p2yXBsQ7kNvwG_jsuS&_nc_oc=Ado0D7PM7MbdHeBWoPduId56ygbLwr8gkHuAV2QijwnkQxjCD1DR6M9LsnCl3smk3m8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvlGmYKaZ_0SKGOqWjFBbi2uYmvB3BLbHwPNzHFQjKKA&oe=6A7C5D74"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dDRqSOME6AMQ7kNvwGL0DG5&_nc_oc=Adpijby7nDn3KQFt535UWLGfv6prLm_SjbSHbgg7THflAQFEpGtS2GScWUH5QmwcloM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFMfJLAvqM_Ou0zW7dO1A4wQaeq57eagSIJPNPMcOEwzA&oe=6A7C754B"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4XqF0QB5QFQQ7kNvwEID2zx&_nc_oc=Adoeewc6R7zs0myqRPFJdWbyZrlH1rDpUJ_AkpeZgqVIVv-6vLjMkQfIv7Zyki6edzQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRSYeYM8Vw1wBNtsrBUx_oBA5DBQiIxYmQG7t3BBsDyg&oe=6A7C5124"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rHkPd5wOlaEQ7kNvwGPhiHi&_nc_oc=AdrhQfXX7_q5RRbid60n13irjPlA7Tv73NGJQBJFlB8BDp9XK4xUIZOZR7KMj3pyQ0g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZJCGW_yfDhN-q3-90DLIyTXNjnaEjg2LbEanQv05QGA&oe=6A7C72E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eo2OKMZG0l4Q7kNvwFLY6S_&_nc_oc=Adrp4TERcAGQ-3LExk4IfIj6oo6ORXMKfNhGYk-hBtU-KtxdGqKK60X_NtT6V9cLAdw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG2c2u-eNWsGnXcY-t-nZtFd5BZreEca62Z_ykS6iI2IQ&oe=6A7C757C"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
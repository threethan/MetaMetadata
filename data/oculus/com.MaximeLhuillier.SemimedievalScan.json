244715", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=djNBCszfyD4Q7kNvwFZa2eO&_nc_oc=Adpce2lr8qU8SNqdbfkcFsU6lzVbJPYfXMQL2cxqNzLql3B9xk7G3lRfUr9iBXrvuyQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2q7Oug2bkaTektnhxNoSiY45Pe3j4oNO3NEm06DYQtoQ&oe=69F8BFB4"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bMCyJ94Czu8Q7kNvwEnNUV_&_nc_oc=Adqt7yf0mAvSRSVro_UM5FciPfKiI1-zVdwuXlKQrWmFeamKt1J2q93khV0YD5QiMCI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2ha-MbkSeiLHYPdJSgMtXwxRugd4W2_TqXlMn4WhNqHw&oe=69F89F4B"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pX1uVpqXMB8Q7kNvwHj3Ur4&_nc_oc=AdopvMMIFqzZ_Eh7CzH-25wSPRedXSs1NZlK1G9oK_WBvIGTFQyqkO-mwXmSmQ5s-cY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3q91IK56dwEAOifFiFiElnD_lZlKLhP2q6xW7k1Lntug&oe=69F8B364"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z1T8f94pAwMQ7kNvwFTPCne&_nc_oc=AdqOY0FAt0h4OU0lf7om_N9388XsQXJgzIhlhJWKrBAaOtQghV_blY11SYVWWruziGc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2k-NWa5h9t9KB6OtuJ0VsMa20BrlaIGXHiscrsQ4IR_w&oe=69F89CE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0bF6vwAaaIQ7kNvwHENHKY&_nc_oc=AdrdpDG5nlCpaVvCsq__76Ou-K149nuypCFJeGIMlLyFPcuMxRJeHud79HWh9Zm2oQ0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3CicJpCE8cC01a8nC9fgMoXNeaw7MGlfcT2CuB3_wiTw&oe=69F89F7C"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
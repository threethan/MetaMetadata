244715", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o2Y_57-KUYQQ7kNvwGSqhHr&_nc_oc=Adr6ln7r46DLkirOgQF3hcE2-XUCwQ7zdk_PMGQTFxIu6s-mCRiCNRGi3gI8-FsTMoU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42k8NoNEzDQ81R-_GE9Mf5ZNKfCrS08Rc1zi7fCX9Odg&oe=6A1B06B4"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=770Si0bfKucQ7kNvwFHGh7-&_nc_oc=Adpb56sPz4i0sVZ5gYRDeJZD7fAhAA_vDMW6vaMNPVNSnGWpnv4wqc9Hf11ku0KOfH8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4wKp1RN3GF6fcq00ulLEdfTztd7hsUhwkY_iKd-lhuUw&oe=6A1AE64B"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mzRt0GyL5hoQ7kNvwGvkQoo&_nc_oc=AdqCAdSFeEs_uinpPfvV3fL8BaIwOOEc0OpDfminhJQJbruEcyGRIqBxBl0sm3isSZU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6TCCmRMqIHFY3KLhBZpOkQ46ayF9XWWRfCT7ySylRFFA&oe=6A1AFA64"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DxR3soHSpvAQ7kNvwGAzAn0&_nc_oc=AdojVzwYZN_zZNMtRuegNy5u-L3D0Ck8AMxjleM2UyxVI7NuLUbtaFZAMZMB7T56a-Q&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af45Q1gnO_0KA33mAuMlfP43y8GVNLLTRA3NWxjU1FAOEg&oe=6A1AE3E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e1ou3kbXAiIQ7kNvwEwnf1N&_nc_oc=AdqHfouM3obiNLO2Gvjlstbc4KrfFRMJ-cUgUEgFnv4cddVDHnoquOQ9bu20IWLLYA4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4vXTtgAGZabIM9XNK2oBhAsW1-2gI0-XSzAyAAli3kvw&oe=6A1AE67C"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
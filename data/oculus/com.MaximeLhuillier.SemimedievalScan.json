244715", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CNoQ4C0wPwkQ7kNvwF4e9wv&_nc_oc=AdrMflfaVrzRza9iNybtR4-m4InR-U5oPg1PXBQ4yjk7AcjmSAj-VFHTwL5ypl-v12o&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPuPx0K5c8clt6uPyqIliVc2oKH2pzCZp3jshTnc84u6w&oe=6AD0F5B4"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3WjzsMa_zv0Q7kNvwGf8C8a&_nc_oc=AdrPaof5ICX-IIuHlTN5Tvw5s9grjFgCvrJrxkE4DMnwt7FJrsANFjYiqfHS7zOIefY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMAk4k95o-jpF02H3SVIOjHbCzHo4ZcceqgcXK_KkAGrw&oe=6AD0D54B"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nJ4FYuCg4nMQ7kNvwGfRQKi&_nc_oc=AdqmPFcO1FLyA6SWSGq_VxYbq__OAE4EHZMrQXKjQVdLcVUBsbUihQat9GzBRE5bzFo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgJIJl9DpgLWxhyco0IjU8CRatwoRPoGY6LqfYnZYc-w&oe=6AD0E964"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BMCpj4YfBWUQ7kNvwGuVRc2&_nc_oc=Adpnts7b4NQyIzh6a_UBOdE8HDkniHTSFXmP8NtNlg0fffcy3jOkW0oOm3SHBRIiMdo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNuqGqvB8rb4E7XvydhpcV82lrxdvaW8dCMsxq2gqVlmQ&oe=6AD0D2E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mdfcb0giWgoQ7kNvwFcx_w6&_nc_oc=AdrhnqNvSeF1-uRdl5AzrYiUSPHul8Ph0Vjt_5bhQY4eMHY-eecWuOqJTsNCMs2z5OE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMqquypIkiAd7-vzeB3yg130cBTss69KvQSdwAPx4a7zw&oe=6AD0D57C"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
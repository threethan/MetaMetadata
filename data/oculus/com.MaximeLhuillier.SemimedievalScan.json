721616244715", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YKEU_ZKMZg8Q7kNvwHjHLK3&_nc_oc=Ado9F6XdnwGJdUnrTfk7z3rO2l5ePIAovAIAlMWL2tsQJLEikQWuipW5JEAhf7s_u-w&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Rrdw1T7qidz544LlK5Bgq8zL05ZYzhdym-FtYmFsONg&oe=6A395934"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SoirmH_Ik_EQ7kNvwFKL8Ta&_nc_oc=AdoWh3MrF9S2xdUXVdRkP3KI-oXklDjKDxX2gzFYxpGutWEa_pZmXeTnBEQUv5BBdMs&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9HzNFfblxLvZ0HwH5ULTmGJFAWTpCGt61AxfBO28NhuA&oe=6A3938CB"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q04PSRv4vW4Q7kNvwFnXJrs&_nc_oc=Adpk5a2z3XBJjoCngnJWjVod_C0ANx0U6Q8rA7oE05s89R9_Fno5Z2KepDugXdAguYg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2eLHO1guUYph4w5GvGLtBaxzFGq8BNigCZrTMv-JJnA&oe=6A394CE4"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8m11wkRQkIEQ7kNvwErF0vQ&_nc_oc=AdoHP2_yHbJtP49m00VTN2YqcQdMAvS9W5wujAd1dPGA-9VeQa5ngfN1DgJrA7GS9Xw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Fb4FmTYX-tHs4ZsuFrwQMlgA5lBfyjG0GnPhUwXcDjA&oe=6A393660"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IrQgXCAHZbUQ7kNvwF3F2zE&_nc_oc=Adow1PMQMFpIkZF5ycgEpq1BZGH3jGM6vdK9ZBX9dPqdW-d4nQ-N071_uOKKDgvNzZs&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-wx7Tvsaualo2pg4ul9IdpugBtA8JvmvoUlAM3WX5yMA&oe=6A3938FC"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"},
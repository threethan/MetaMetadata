244715", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y-tIU-U7oiYQ7kNvwFnWlkF&_nc_oc=Adp0sMH79vrUfdjse5XXdLdhDkspjtXMRvXb9i3rYVh0wu7AYtabizT-VQ72MMPN2Us&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMRLbWq0cvltMu7CF1D0-0jP7WD4QVHPqr6wzNncYF-EA&oe=6ACA5E34"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V56LIsgT2EcQ7kNvwHrX7hn&_nc_oc=Ado7JInBcn0JTOBJQAVNyyy1cuYWcNwCDl4-YIrjz4l_WPsMvbgXlUjFQ4A5kX5Ed_k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOiwFNHW-rfNGiqBlJnNWgmwLRQFhg_4zSL7V3eu8UwyQ&oe=6ACA760B"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oxh3PkfvytMQ7kNvwGue_K_&_nc_oc=AdpJL3jUmDUZWvcB5L5Sylnnj8c72vqfMhJS8YZPQVmLwxmYBaxcG76a9Fl1toqGJH8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMKEao4tvo8XTubMPLls2rLoGgMYlllsfnX2Rp0dKexPQ&oe=6ACA51E4"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J_f6jK1jJjIQ7kNvwH0FuIX&_nc_oc=AdoGgzZuvr2es---fS3UrNW7CqmEr1tpU4P1WfkDvPADlIL1Xz3pSVEljeFmYWzX4sA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPH3IFVNjwEKMVnwhkuja4FoNnpQeJCwm4vR6Kbe8Uo4Q&oe=6ACA73A0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ajXwEhdTNOcQ7kNvwE0JK8A&_nc_oc=AdpSU7D4UBsrL6DnbBq93L5viKdW_Xbv9AAZLW5jUdFyGfi9Y2MHUYnBzeG_rqoKWpg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO9uSvGurqipzSpE_OrtvzSpw8-sjoxS8T-38_uRlJqYg&oe=6ACA763C"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
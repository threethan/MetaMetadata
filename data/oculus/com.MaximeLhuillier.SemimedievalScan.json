244715", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2u0qM5U9-yYQ7kNvwHGuB8b&_nc_oc=AdreWc4b24ipQBnvnA7KH8pn-rjQ1eufIFFABKiLd22ac5HOu2BO1H6171BFRo8dURo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4pd27LXjkbjeYYLCLoK4g6KhBG_hfeCbmxmbfsfMWJyQ&oe=6A0B34B4"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V6XLW2u1ldEQ7kNvwHbYBMy&_nc_oc=Adqo5niZXtd68InWd-WFhV93wFe0SBqi2nCF_qstwrYx6OHizGEXVFdCCN8w-ikM4VM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xjtN_TZXVayTBYeqbOxC_g00U8oat_FY3ab3NTk5eaQ&oe=6A0B144B"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o405Avv_zJAQ7kNvwGWiIHV&_nc_oc=Adow0spbJy53yoJUr5N2lACv-1B7QdD4k79qhG1GjF6VBXZlxvOnj06KpRNqpHx2kgw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7t_qcCdvmPiiUirIb2KsT8XI6QWxlKC_U_VipgLHAS0g&oe=6A0B2864"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aJSnQ37Oq8YQ7kNvwHjYGiF&_nc_oc=Ado4k7_kR0xEceywHO9qRgwgY-OaLBf3_7i19gPNa8QE3_-znEyX86OkXurS37jzz_Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ziuTyUBZufWJSgd0vzrRXQq5JsD1jL8-_2I1D4by4ww&oe=6A0B11E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WZpdI6pseEkQ7kNvwGRM7Tc&_nc_oc=Adott512VQVVQGzjuhgGXQ9Ej4p9voVdDFwD_ZSVQAozFeed7YbtBhpFZmVBMBG2Dyg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7S_bvVqJgEChv2rzHGavOEZQa3Da-xOXJRsJc2rgHvyg&oe=6A0B147C"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
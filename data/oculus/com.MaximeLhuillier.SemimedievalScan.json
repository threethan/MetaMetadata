244715", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8kpsQX-m2a0Q7kNvwFVmP-J&_nc_oc=AdqL1loDEw8jDKn_ScNI7yvghXDgIqOrtBG53Hbg8H5fb-BfhKB1HhZPBHSAlVlPAgo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHjXEgmmEIzkcBflguFmLm_Ra7ooLJXXHlnv3-34s6mCQ&oe=6A9023F4"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-zYr7VRGW-AQ7kNvwFhTV-M&_nc_oc=AdrpyK-6wWAO-NHebiAunn8HP_-zV5UWE0Lgel9gxcvHXRxXYaRofK-UkcYnajf9mxc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQENCEUI7wQV9wftw2dbzIyTni8mRkG0XeI7V8K0KON5XA&oe=6A903BCB"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xr9tbsbe-qUQ7kNvwEC9aBz&_nc_oc=AdpYA6G1Uxm4HdAVbFTdYyH7CE5sFvSTxmW1NomtjQCWkofN0WLIVA3hSxeL3Z-oq_U&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8H2_6V4y2jB0atx_1C-2fKV485si5TyGVkDDbiBW3fg&oe=6A9017A4"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T5sTz-06IYoQ7kNvwFRdDXC&_nc_oc=AdoSkyrf-2PIjTiqWldB1KrCRG5Lew0gToE8MBS3dbJaJbJCCIFZcyXcrU7CaX5llSc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpuGouvMimd5JyCLRzDFfXtlRgJy9DCxNYctd9F_1p_w&oe=6A903960"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=et1mEQFKt9cQ7kNvwHX1vpj&_nc_oc=Adr7ZmCixtM708BRpbuYqDdHKGa0UO-Fny0y4Yt3lFnI8c6QqZQhOm8DEiZ3qjpqlcc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkwKsodHBbh84NRFhhflflm2sCQomhj9RWSJctWvOGfg&oe=6A903BFC"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
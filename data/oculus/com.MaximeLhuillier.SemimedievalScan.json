244715", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8vbzHsyFAXEQ7kNvwGtomK-&_nc_oc=Adq5pkT8zCt2ygbuZQgJRICAQ96nCWxUpLSIKrgDS5j6SLZubP7CrY_0qr-i0aIgBrs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhIltHknBfkFNBTd5x7tivzNFqMB8svkByVLtH85ZAlQ&oe=6A747474"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sCxzAS-WQykQ7kNvwG4BKyv&_nc_oc=AdrOX9ToLHsJXEVRH9o-7PSC4pLoaV-psPBJdnn4X3HInZ6HcKIsVKN1dy5zkhgVEfg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFwQy1i5Y1OlyAvGFxK9cYiGPYhT1jLqh44F2YmL1TosA&oe=6A748C4B"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B0tm-4uWDukQ7kNvwEg3Kzb&_nc_oc=AdqiGdCx3LwlGjcdJ-1Mvs9xrtz__3TZ_slyqHztdUSkG1L_2bMfPzOiiTi2QwpgFFs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE9n_9rFdSmkpgBooAzgmET2eWXVxDlDRx7bluB7yaLug&oe=6A74A064"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EuzWIenSfa4Q7kNvwEfZ7SP&_nc_oc=AdpjqeLTzvs5St0qRa0SAzDWWivnEIAdFtn6t7qaZ1YV5AWzFyXUdd-6GhkRipDcxnA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1pHlIK15ZSd4-WqT-oyb1M2MDNHzIJOVYDvxIL_IlDw&oe=6A7489E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7tO94RDqB2AQ7kNvwHX4aDA&_nc_oc=AdpDDzjTQgeFGUSGRbbUVXeb6ETBPYeMt0XEguLJ9YwffjR7xauSD-xzZmIAt6xOgiE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGEcXr5oMdh073WfwehW-y8rDqs1Ib_tLJmULTuSy18-A&oe=6A748C7C"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
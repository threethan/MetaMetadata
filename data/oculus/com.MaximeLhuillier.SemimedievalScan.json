244715", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ls3vITC6yjcQ7kNvwH0UOIx&_nc_oc=AdpoxfjC-6ccwAd42hd_S2-P9MqvRnbPGQ7htAPVQyoG0Dz7ndSMz7HeXLY-2wAy-m8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af12t9rumBVdm8LTG1tH1AiRSKRD1VJ7veHxqhSm938JIg&oe=69DE2974"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cap8XwYeswoQ7kNvwEiUd13&_nc_oc=Adp0d5c70TinszAJl9F_3pLdBPuxDasvGtiNZFYimaKV63Nb8UmJ65c_hdjbmoa5yWo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1O6xJzGTWBsIDhwVuUvUqjLtb38c9bCdoflDbuN-CiBg&oe=69DE414B"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vvHuUKMi5zsQ7kNvwEQATfA&_nc_oc=AdoG_I--e3yE_UUTREAqHlQNy-YrYm4xH_723O95_L_hkeIA2w8llrIecLxLBwkWVkc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ifyxCi6ga5vQ1SSHgz-5x-Q4EG-fbMRWyzsc90BNr1g&oe=69DE5564"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dKIVAv11-qkQ7kNvwFlitAa&_nc_oc=AdrCsVQluPjxZPAz6Jfdoht6p0horg0MSvONy12g54R06p4PHjpwoe4AUC5vcyCDl_Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ubbs5N94zE4oQiStBMC19Y-g2-Lm_whmfmR58WAffFQ&oe=69DE3EE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KM0xyV8PKHEQ7kNvwEbgOsp&_nc_oc=Adr9POcnpC2Tki4M7MIJlwdwFz4gX9YaQtSKB70GG50IDElmskxgCYpH9ZWhz1Hnjag&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af05wpcqYgn4tOlvKITecTf4w-PwMPkpE81Efr1k38JfRQ&oe=69DE417C"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
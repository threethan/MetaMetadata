244715", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bxGbZ87ENbQQ7kNvwGZ7hei&_nc_oc=AdqtL_q0iZnxR72G3sHDaBi5CDIKECtgKjLHXqK4MftYye0Nj1d6M8eOp2sB5hLAnLs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOX5TDzkFqUUUDWCVngh54gKTOn64Q85pDsMLskO-8vaw&oe=6AE60DB4"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pY7U1FcAihUQ7kNvwEweCtN&_nc_oc=Adqpeqgp74RmuYPSKMiC0P73G3-LNnoGrUtOo3W0HVM4hV4SLNHiiHFGNvoksBcwNk8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPBc3LwSyj1YU-rrJQljnyI2I7SGHKCxvtJR57ylYGcZw&oe=6AE5ED4B"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3yQk_1zphNUQ7kNvwHQmKzb&_nc_oc=AdpCFcNlFSZeourjgb7cwEy6LwrD2VLTRmNpEYKIyeoDrWS7tQAiNUhDKWZHUcpXg14&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNAfmfupVtouJn7oUjjfcCSsOFDPEo0pPN2w-QRLRaCew&oe=6AE60164"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s8sFoljyuu8Q7kNvwFrYk5t&_nc_oc=AdojperIXJnxgD_ctky_D4KEFz4_3m9Ceqy49Yj7gMnTPXeQ3klIS9yTn9Z8Q9vtP7M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPfwgB-FkmrfIwsSHqlVDy8uE06bOYNY71A1ccb9yQBvw&oe=6AE5EAE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V9wM1ywp5JcQ7kNvwGDgdpJ&_nc_oc=AdrVKIAw13vG2xLj2-LKUQlAgG0WRuoQk2twwZmu_NrcFZv15O7AxHxuPPeWr3cqXNQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP22bSi8z8I37_Z854h7knJl5okca-kOwC1vIB6dURswg&oe=6AE5ED7C"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
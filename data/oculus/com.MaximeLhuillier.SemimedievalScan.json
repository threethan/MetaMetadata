244715", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NoIMSXpjRwwQ7kNvwEmB-ce&_nc_oc=AdoM9AhX4SgvNG1IN_x1Evv7I8Vg6PShvZoFNZI9e1CotpZekDYz2ts83M-p1sAEvek&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8oOaSlbD2E9_GGUgAbePiBaOfUuRIJ8KG4ll6z6qJbtg&oe=6A317034"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dLHkYHOhlOQQ7kNvwETGZpe&_nc_oc=AdorVTTov2Cm_A0KKCdec-EardBnh6JlyIydfsAkNQ6SqsJC6ELeezaWIlxnWL5sleU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ofJT0vl56PNKO111InGTiZOqhfqRFstve_1Gu8m9fEQ&oe=6A314FCB"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wrj4YXoQC8oQ7kNvwGQAnyh&_nc_oc=Adrlb89CWlpAPhKpgSDKiZyLR3OH6p02o00WVbVuAvlboGgIeSWKhT1lOAhIXZ4hefQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_74-tYAYKPbattYqQ10z00rk-SXs1S3f5F5BD_pCsexA&oe=6A3163E4"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZafvuCV_2GEQ7kNvwGz4LRI&_nc_oc=AdpgoYmwOyk2MmmpFc5F_wLe5jGlEXe5Y7ArzGsj0640-MPwMgytVX0TY9BwH7PG4b8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9IqONdSywlMlqMr9XejedEMahpU4jK3KqyHTMxLBzgHA&oe=6A314D60"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jiw7kMeIUFsQ7kNvwGmtwnD&_nc_oc=Adonv6e7E-hcc-4ah-HI0NnEibGPhsUO7JR743wvpct_1yEjLW7qXEpX4kK7OS9gtm0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8te0jDFUrtlswt8IaEEBdcxF0-Qvj-LzBIwtp6PDkx6A&oe=6A314FFC"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
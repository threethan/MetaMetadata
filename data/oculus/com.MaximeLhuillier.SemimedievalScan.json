244715", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tx2UGgCKlesQ7kNvwGIBCUa&_nc_oc=Ado60Gn6S1hJn0cmgixqcJecHQDwpoWrWjujeXg6ipWn02v6C2n3IPl3CSYC1KE1mEk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9HfjQAcG-aWQO_SFSsVTisqvmo-H2htMELRvQhAty6mg&oe=6A43E534"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Wzh26OUfLkQ7kNvwFF2ceP&_nc_oc=AdoJRlZO31RGp2Sto0LF6-_p51l67X8eq3JcQOR7Dn1URp2bDUFLONQSTF5manAUwHM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ThvgEPitp-Eagq9CaBNoUFfu2GiTKzSAqqJn4ZjlQJA&oe=6A43C4CB"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JbF6HdTUx7MQ7kNvwHK0_ZZ&_nc_oc=Adre-GPLSzJh1PgqYvIZ_Kc3U3eGG9wVwSq-3ChS0cjHPRtG72QUOy-Dr_qGsBJkM8A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_JAIC07kj4xLHJAE5ev09AtB4NkixiWz346DrRpx25Rg&oe=6A43D8E4"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rziIHZ2JzekQ7kNvwFMLKrK&_nc_oc=AdrzZDVLkkpb_9tU7pVkQSscV6tPQiDibYlhht6AS-A8vljf7BElZfKeX5V4SJ9UdCo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8HgRugtPhsz5STqYF3z5D0rRda6jRCQF__jk9TKq919w&oe=6A43C260"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DZLxLAL-CCkQ7kNvwFEj03I&_nc_oc=AdplxkZnMa0CKVBSXIanyUB96PK65CqGA5OcSFLSwbdiQSQ7WxhoUyOFKGMTfl3X-Hg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8WMYCY3Jt_3xXF-Tc46KmrHCn2E_9_5KeMuuPZ5RRSaA&oe=6A43C4FC"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
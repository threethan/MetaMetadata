244715", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bCN-iG5xQYAQ7kNvwG4tF_I&_nc_oc=Adrqha2So4-ve7JrvBfRhYfcnvNwdnSJUC-Y32T69mrXCo_na06eEkmKuxaJnnZtJKU&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4OQXXWuIEimMXsfgitSUAEEIDEhyMFM5H6qw_prAQSQw&oe=6A1C5834"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=770Si0bfKucQ7kNvwF-QQDF&_nc_oc=Adrj69b527nfiyQdBi3xL3zt6lM-gOLOC-Yh2K8VwxPzu5mSQkvMJmLN5726DBzDHcE&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7MnpeHq7GYU-jffaInOv3LXL7l8qQpzESli2TOBM_cAA&oe=6A1C37CB"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pWAlTZRT30QQ7kNvwFFXpot&_nc_oc=AdoU9Z9EQkZW6WRxcdiAEoP6umA03cktxHqhof1no7Sz_cGyBzsO8Ev9PZ3MqY-OIqM&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5YXQk1ZhM-EGq-T-KiFA4pKsz5YkfU9r7YYj1rt7ATmA&oe=6A1C4BE4"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DxR3soHSpvAQ7kNvwHGmYkw&_nc_oc=AdpFH9eNfEOVX_ED4L8JQqxshGNzVZqh2VatkFCaz10myvjxvAyVguRgztqY1lXVWJM&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5RHmZjiA2d7LdJEq39NcWVMx24d0KH9y1Ac_yqe0-8XQ&oe=6A1C3560"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e1ou3kbXAiIQ7kNvwHlMSV0&_nc_oc=Adqg3rpO6PAT937zNixztmjroxVKJAWGSrTa2AxLZYIYNnc9aalHe68HjQqO3rwHfgU&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_JHWfCypnRjaffsmHKef1lhyVOtDydKKYYZf7ywdlJw&oe=6A1C37FC"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
244715", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T8RvtSF8YlUQ7kNvwE4d0Ic&_nc_oc=AdoE60V4hfe2QLvsxD2xxqU25P5aaqngDVOIzAK5DsFNe4ZpBzJh5pJhpPDln0vnoPQ&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2N6YtM5dn5yId9_8t3odzHSa-rGvCkb18t-8nFrBWngQ&oe=69E21DF4"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XFb8jroJrXoQ7kNvwH5X_1R&_nc_oc=Adpm7LEi208Al0FDGQa-l1Azk533ouX74nfsCA2h3h1K9I3EoSEa36rPNlDWHMjYtPk&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af21AtMxIq1dR-4QaL7qRvHfmoGONnOQqOz2N4EEwF5DqA&oe=69E235CB"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZSneoQi3w6IQ7kNvwFOBZOa&_nc_oc=AdokjnebEfSSjlZjAPGsEvOSEzIJC6LrM5fY3g9XlYwICV_FwZQoZd7vWtFch-X9P7s&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2kYcJg0NqHXNY8oFxOxKq6HzQJLaGXlpK6ebowSYfvkQ&oe=69E249E4"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nl_GpI8X1KUQ7kNvwGRPQUl&_nc_oc=AdqVA78_XJzjIexNFiisl6rL87ek7bezo-en2nYNl-EQiYNYZuejvlQfurq2Ljy3mow&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2zXBr3Jw9JQ2NW6QbJTuWGmQc6ux1iBenHnLqbzgpOGg&oe=69E23360"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mX00-GwRmewQ7kNvwFjSTsh&_nc_oc=AdrrAYPQYuq8w7A3OWog_cNlxp5ToXe7NgDC7DrMrVNUVBUFiBAgafW8_AQKXfb5EzE&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3oi2vTIzKjQ2pQMvLsWba6kZ2BDQKg8uPzb2ZXadUh0A&oe=69E235FC"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
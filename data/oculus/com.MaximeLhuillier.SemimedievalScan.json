244715", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HgBoqZrsd6kQ7kNvwHSYwZ1&_nc_oc=AdpCw2Slw_naNCoiuQ2Vouv0H2rT2K_rvpQfHNXDcjuS_jPDkhFvJl5nZlc968Ww0j0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7bbwSba5qNp9s3CeBm4cgdqgwjPH16bNsPrXMEdNkZbQ&oe=6A171234"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fNUDzXAA_QwQ7kNvwEjpYtf&_nc_oc=AdrYvwZ9LDP-H2WqHDOiRK-b_OTIhfUczwUzvcDfXr-bSbfcp6YdQP8eW62YuB9iHbI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af78OMrgJv-wHEHuZZoLlZzUL2sVCCVasyNud0rgdzhfww&oe=6A16F1CB"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DaGslfsqlg8Q7kNvwG4QKgr&_nc_oc=AdougMn8_YzoVLfREL1mt2dhQsLCQyRYVUqj0ZKVHoolpZ2xm9F6WH3K0HMqWwvuwFs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4I7IEzYmszJ2abzIy6m7tSLOTUIPXwcKVxaagYPewfCA&oe=6A1705E4"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xujxxS0O3EQQ7kNvwHylWOZ&_nc_oc=AdoCUeDki7mnCiwf8tlGGoHkl8inL-DiraiQNp9rmsKHrkK-Bl_btk9gHzOIsFclXgw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af63gH6yOsNw-99EsN8uaO_Q-7jxH-1XNj67OFP9wqn1ug&oe=6A16EF60"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MDOLGHXaTUQQ7kNvwEIONQA&_nc_oc=AdqlPpij1BcTx2Q1UeHDE-iYAaSuLN295wE1iybFztlLi3meVDOb4FYojJrL6QRzLHk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6NmQEbjXrl23bPRH-UP8StTY268izkjhMkcAC6LiKmbA&oe=6A16F1FC"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
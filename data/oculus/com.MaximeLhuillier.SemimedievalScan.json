244715", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y-tIU-U7oiYQ7kNvwH-qgMD&_nc_oc=AdolWRedmFRDYakbPbfBw-pRuZ3amTGfBJEg8B5e5Pm_GitUg-UOh8yi0GfQP9bHAa8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNbybULofghYy2A8lRH1GHMCj0Vnv-CEDtTrPseVckdjQ&oe=6ACD0134"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y-MrTaiwaOwQ7kNvwHwlG8X&_nc_oc=Adqp_7bhjo_me5GjfFUCd5JKU3ZHL2Y6--8SJpIBWguxaBfawK6TnvgaBWvSwdTAv_E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOVZY90rK0zwPchwfVIbWrcfsRlLxdhGvDm33KCp10bcA&oe=6ACCE0CB"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oxh3PkfvytMQ7kNvwGSDdQd&_nc_oc=Adp3uU6m61ANVYz1JyaZUYmSZ-n95o4--VuvFjtubsmH8ms5dXioce3H_O1gOuxkh1A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQONXeyEI-nQ2nPOmuQBaQUmZKcXGt8GHSv7cQ95NQ4Wbw&oe=6ACCF4E4"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KxXhyvl1AWgQ7kNvwFPhK_c&_nc_oc=AdpFtUTjv5zgaWBMl6Aq681A5v6Tx8r9JRA6QiYvSOAruX5aj8oM5OH0LtaRFqmNNm8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNHQ2GA28lhJpOzLsH8zqD8pSpRIc_88bFLayOA4tbZ8w&oe=6ACD16A0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9wQ3BFLpKfMQ7kNvwESluvg&_nc_oc=AdrraMJNKIw6lNkdvj88aPRc4euOTfpdm4UDymx_98bXS5vzcen321grQ_t6JL7pcIE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMOS61jFF5HyRMbJfU689zsqWMdDp_j_so6HfYNEDXgfw&oe=6ACCE0FC"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
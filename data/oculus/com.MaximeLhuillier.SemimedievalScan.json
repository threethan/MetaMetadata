244715", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o2Y_57-KUYQQ7kNvwGuThKX&_nc_oc=AdrA-4YOj4wGdKoLZIvk_I237Gz553k_2oWAyDb8fc1PLJml3AHX4-fceJaexZS-dg0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wkpp2NkJ0xrckFVxqbQll7ADDyNpYtd6ld2dobvVx7g&oe=6A19B534"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=770Si0bfKucQ7kNvwH3tBec&_nc_oc=AdqI4Hd0ig0fez5pg-Xyw0sJp1wKv8XOgud3L196Jeb2JkQbDFK3kjW76qisHIEB6KQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4HOLMPxbSx81I-wZHZB-rQECx9eDHyTmbHM84GplvrTw&oe=6A1994CB"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mzRt0GyL5hoQ7kNvwH0-Kc2&_nc_oc=Adqvwin_ixylSqMecOFS1WNgf3MetMOQnqlxT2P6EnD8bIXOK18rouMfUBKhxgMAAsg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af67XQ4exeLxlr0-cFAHmTKOeSEs7-mSO7evHX63SAhIyA&oe=6A19A8E4"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xujxxS0O3EQQ7kNvwEudcVc&_nc_oc=AdrTqLvVC_b9rGqxPwJWIFfA1Vf2f5XA0Kg01hE-CKTjggUmjB_OVvkmjONURBn7sZw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5iQGl_2_4mYDWqXc8tLNyiT5mIYT32ad5rof5gCRFN3w&oe=6A199260"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e1ou3kbXAiIQ7kNvwFAuE4G&_nc_oc=Ado84qe6BpVrGh_L-968mRaaGAM0FV_vdOhOwC-wOe0Cpqx8g8dH9qthYXAR0ki2MVE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Cddq-qkD8eA8cy76vu2ZJ6ushmIssJ0d3Nbl3wRUTgQ&oe=6A1994FC"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
244715", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=78OvTBhdPNoQ7kNvwErnopo&_nc_oc=AdrN9hzJEce9PhUEKokWAUk1y_L_kmbXi7uJV4TumF_5uaudQtjBBQuW1T-Eo9_0H2Y&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Ok7S76WjRJpSeNai0qTxJE4O-i84Fl9KjUYt3_zEPMQ&oe=69E763F4"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ob1YaNy3usQ7kNvwHnR7Q3&_nc_oc=Adr8efgm4aqckpSLHIO1-mVR1XmWrj2dqhqmQcgUsELuEfVz9egqVaNUXVpJwQlUE5g&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ZA6ZbbRq4OrX71lKNhMdFhZCTz6TW3uXFOwrMMRUxhA&oe=69E77BCB"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M5Bmo2Za0s8Q7kNvwH4gW1d&_nc_oc=AdqAN35GpmGvkFLuY11Yotfq7UJIx1A4zXk-xgg9RuOaFzQ2Ssg9OGn_wUHq6wiBBIk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0rO6BiR7X29dRS-dqWPtRN_T9n2XD--rgBLTYXDzdLqQ&oe=69E78FE4"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yyoe5zSTd20Q7kNvwF2cdg7&_nc_oc=AdowK4dx7r9HVsduA3Hk1tgwcvNVIDPdEEuBpr8w3o_emo2ipBGuWB3Jw4tFQvGfZZw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af17zLPo3FcCeGB6VjZ9bRXLonJf6Od43bcF5SuUV9ijmw&oe=69E77960"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lUddc49zf2AQ7kNvwF8jAhH&_nc_oc=AdrmBNh0MgTcgInnMZoEBCjg5b9duu1jcB8CN02PpnEW1XO3LbqFxlrQJYRLevUtbJM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3c8z9YwkCJ_xRKJXDG09_ZsO9wP-37sSKtAhYlGf02Dg&oe=69E77BFC"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
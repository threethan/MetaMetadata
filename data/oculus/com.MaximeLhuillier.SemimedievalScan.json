244715", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CNoQ4C0wPwkQ7kNvwFQFeHG&_nc_oc=AdqtQh5sd8BBLWhfXAlWN1GsrW3ooVy5S9y9N46JGq6kPVSblBIyHU0dNRtqwcDDHu8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNVG8GseWFFjw3fR_BY-1ZZk2LV2M_oLjDLJlTkMTZ27Q&oe=6ACFA434"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3WjzsMa_zv0Q7kNvwHqtTnC&_nc_oc=AdpB6Z1ca6PR5sP_HCP9j9M3WsDhZq7QplUAKUXNAx4X-bcH4RimzrHAoimU80k1U0E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN4vDN7QVS3pCbTpGL0uRotPuWXN5jJr3zqOtIYzRuudQ&oe=6ACF83CB"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nJ4FYuCg4nMQ7kNvwHPvIgw&_nc_oc=AdqqS3hljkVMpCtmcO72nFsdYEU2RM3smkfqdK4bgoyA_0hAUdiz8LAlnT9sFKHlKso&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7KXW6s4UwIU_F2ckwGsZtiXIuRVglUKqwXikt2wDveA&oe=6ACF97E4"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KxXhyvl1AWgQ7kNvwEFsMsG&_nc_oc=AdqQwHw6YCI0gSVtD1o1NOyHM2-UPaZ2r423rcRbxToW9MvIgxzVV2wao_tJ_lOKxr4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQORGRGgBoCyARiCUBOIQb2KDB-opVX7xZR2qDI0PdJY2g&oe=6ACFB9A0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mdfcb0giWgoQ7kNvwF9v8fY&_nc_oc=AdrV99JFYgoFA9JM6q2aw6ClAeDDiD8PQaghqYHHsGomTqBicCXn86mJk-Cf5I4yOSw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOK0hR9KZ7Dwg_6abT3VElmOjr99pCj5yVBhPbnHcHfVg&oe=6ACF83FC"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
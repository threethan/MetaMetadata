244715", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sIuNGiqeglUQ7kNvwH5QQSZ&_nc_oc=AdoDt0XN-3aquLgN0Kl9mdlbMIPoeDK20LLzIGlFBXLBXELizMhxEZkUqvWoKN6xqZ4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGTD_I9YOvj_ThJBYlrQuj-C9rbWIY5rq2XoGLwULV3wQ&oe=6A8ADDF4"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ikDv5tj1aI4Q7kNvwHRnT8e&_nc_oc=AdoV3_VL29xjRGwklosMDZGlvBqDPIZy7aH1uEyRSZjTnAgc2oqkg4ZG0AIwmju6lSs&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEt2YGGCUOfC6Fq8aXo2dcsAt98LYo5-t-h6AJzm_DSHw&oe=6A8AF5CB"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=avr8_emfE7oQ7kNvwGwenG6&_nc_oc=Adot1iKKJWDahuKuFZhEJ3NuTyMiw_Y29cZUFCIZ4pB_jsWfZUmsHHZbbvVfMi5D4DI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGC7CVRvektxeYSgMw7eCB1vRB23d37UZ4b1kydeFlBIA&oe=6A8AD1A4"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5PEFKSpxbBoQ7kNvwG6PI36&_nc_oc=AdpGeJzMxplglrR03DdeqXa7NGQIO4sxMArR9w2MyC2j-VNOJbaTVqhknZGNXRdPJQk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEor67JOPstUHajppuVPKvQoxCS_AEYIQmhTb1WmqAnZQ&oe=6A8AF360"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4pJYQeSSgrAQ7kNvwFxXZa_&_nc_oc=AdonqgpU-tTcWZxpUM_enbs1fdpY-pjahlgqowNjm5p2btY8NO17cBSVRODFTUkO1Nc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEiGlUiIGs_PdXzpDgD_RlkPgHnI13XP9Z9039jNUxFRw&oe=6A8AF5FC"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
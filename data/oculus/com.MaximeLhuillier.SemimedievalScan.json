911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qt61vRQAjNUQ7kNvwE8ImcT&_nc_oc=Adm4mYbcyULUvSSrNs8ipUgC6e8nJqNkFl_9VYUmpEJaqjTyvhcGH7vE4DUdFkZi3Z4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afzy322SsuBwKHv4D20BMDEuN0-KNyHmCs_oN5Po3Lh8XA&oe=69B15674"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DgljtNYZyz8Q7kNvwGNFA1b&_nc_oc=AdmrZYejPhKPzORc0uzUu_9mkzhN146b_w5ukH6n22gNKMeeoUFp3nt-iGRfIOHdDeU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxulgHi2OQ-Ks85RRUYr6e9z8-Tpwr1lK75xOWBuFRZbw&oe=69B16E4B"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3gTMDgBT5rMQ7kNvwHgFc2x&_nc_oc=AdnydVLL7y4eLP0SpRx-fB52n3bnzoQmmenTSv_x1qzHsRLsk_smcNdXt0n1BM3X5OE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz_eTQPp4h7FRGYXd32rUP2rd-w24MtjIp__W57uwPTiQ&oe=69B14A24"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-_XkNn61q-EQ7kNvwFak-8G&_nc_oc=AdmoJj43Pbov45XQbIrvUI-YGyD-RU5lwJFftvaIiOLcIimrAH7fGYKmsN8HEgZ-1Xw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxvStb_TkvmvzS-bRhOf8YA_4W-aDGUtA3REE-gRYdPig&oe=69B16BE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E8NGWKx1XxUQ7kNvwEjPZan&_nc_oc=AdmiKFomYo0YZsiWPOYM8AGlT-FA5-Vsur8da3xjT_YRfsFWIB-hBwzi_GxvQ9xNx-g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyZQHtuJ5wXxtNxclXwRNajreQH97VZekLi3kRs_gIYOg&oe=69B16E7C"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATIO
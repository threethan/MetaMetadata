244715", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=00DWmQvtl9oQ7kNvwFQ5E0T&_nc_oc=AdrDdD86DI-4KQWWH3FFoGBWHXT7O9t79nI2K0OGpBkRHeNU4hXeaF7MtPlMLHuy1xk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIj5UIenFcFjBeYWCn07qU8gprpBHhmFtn1nkKOVbZHKQ&oe=6AA81734"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C2KNh55llNwQ7kNvwEqMK66&_nc_oc=AdrS5WZaJ-BPX4q0Umxqpgj8CKMtCkKfhemdBTDJL7c8wfsfyJXLHhNRAr2iwjMQ0aI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJc2VUeAf0ldl3K8mGpqv2cwRtRqb7QuXjx2yc99JPXJw&oe=6AA7F6CB"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aRr9ERcmlpwQ7kNvwFbbS6i&_nc_oc=AdpDc3htA24bnAiJlKuL2Zidq_fFvRU0cohFS1MDXkm83jBrQ2LfiffDRWQf3GQUZXk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnHnCGH-BvaUZmPyfDIpq-w09MYx9potQPFUu8yIUgXQ&oe=6AA80AE4"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_E5YnUqOECAQ7kNvwF1D89C&_nc_oc=AdqzqFsmAjMorW6Z0kHx6nQrkDZlpqytMRT8z_xv5MIcrYBmpMS0yBveWjLoNTv0XxY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLLBYC5xBaQxQiJ5Uzvf_2RDEWuRfETOiuwmcTdwXW3QA&oe=6AA7F460"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aCDLwB9omQYQ7kNvwG452oL&_nc_oc=Adrk5kWFlu2m5uWzkRukvz0YxyI35YLXOxTkhAI6I2RBMWvuRl6OxdnBBXHQNKHK9Lg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLs2aI0EYxZW1F8BZ2TKnoy-8cwmvgMCN_30ZLAinMuNQ&oe=6AA7F6FC"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
244715", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A0aiLw6tdKwQ7kNvwFwZmX9&_nc_oc=AdrY-sUVUSGKJMJpakCaRpX909AZLvPM2XMiQp3-Y1P8PJi63GU8GpaYlRvOpJiGaKg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfwQb_X2MEX2nCQfgDokZDtTxNIrPjNIB1VtxjixWKtQ&oe=6AB3F4B4"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ZA08xxjnrUQ7kNvwEqxbrW&_nc_oc=AdrMO9WRFMfR55fEJ1KUxlfkeDVhSeCF5H3SPT1P22CDa8QixTW9o5ogYBkYOtgUktE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7Am-NxO5EIkuanaSphW7vXrhJB5CVo54e0lM9vy-vOQ&oe=6AB3D44B"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kpkVhoqWHP8Q7kNvwEwzyom&_nc_oc=AdqjdvdRwHs3WDF7mAQnQo4loTgJSM50nS_RykwH3EMVBWq4n6eVQQuzF5eLvpn9HFQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-4jALe61eLWePH46T6YgwbD-b-ths5Z7pqpjwnF7jPA&oe=6AB3E864"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lfjHywYItVsQ7kNvwHU2ggD&_nc_oc=AdrkajdyebS2-uVkHstTdGBmpHMfY2Wv1AsByywJ1psqSLNG2AqnVwY0_O62BtkCfAs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK7ND5n59BapXgS3k4ORr4UQe-MPSx2C5uIidEZyOW_Dw&oe=6AB3D1E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Ic7RhdCTMQQ7kNvwGQi1GH&_nc_oc=AdoZNMGcr8NZcrdtcO4ErCR1D7WZPkW9MTSdVWRaN2vm9EnZG9Y8ti-DIkzPN7ExiPE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI3t97KBTuJU8mhnAKPn_9FOJheXNLmBSLz6lx8xOsAYg&oe=6AB3D47C"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aQyMBXr0n3MQ7kNvwGkuGsj&_nc_oc=AdmCQo36WqNh50DAPE4zzdFM5inWBr6_FtxoEy98-04DOjWEIYhlnSAOeSskniPTdZ0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxdBW9E-VDSwc8zsWB-Cyn7Gg4guRt13cVJ7Y8Sgr210Q&oe=69BA90F4"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I6x8T3amn_QQ7kNvwHKkmF4&_nc_oc=Adl1GuttNMd2-H2TspmskVKU-4LTsUDlGkxyX01NA8pyFWRFtU_dGXPqrMixdnIH6to&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afwm_q4rz6ITWIluAGP90pzWCRdssd4NiLhDylUHVMkgMA&oe=69BAA8CB"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CapA_gb0AdgQ7kNvwGpvU9C&_nc_oc=AdnajQ3XEG9Cal6YdTy5rXDp6-3q98abvtILlhqxsL_UajZqaHjQKTZ-H0L1P7CLVNk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw4TUlxlTD9vSi9D5zYp-gusbegPFg8bBBePxX05IUXkw&oe=69BA84A4"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mpT25XfVrfoQ7kNvwHDL17D&_nc_oc=AdnjnBZZzZj_8nvI0lZBmQEBXhBJI-A8iv6z0u8l7LmpCBYqW33DDMYPqDjJWCKJdd8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwpG8cn2JtX9zHgwREyMgcErjE1DwttagRbXB-N1I9XUQ&oe=69BAA660"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RkNqouCDrOIQ7kNvwHFOjt0&_nc_oc=Admoe_oUXxlAQM5ggpo75V2X5L4fX8jsDhMB01J_A5Ul_afiNTIQq92uDJfDS3ENgBY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwdHyL-kfHA5tnHnHIgGNN-iO-9D7dnR7NPz6651nDsvg&oe=69BAA8FC"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATIO
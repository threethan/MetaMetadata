244715", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jiL4lup11u8Q7kNvwG7Ltkw&_nc_oc=AdqP_sxLli4ijDa2Ar0ACjfPIxTsTaLr-e_RSpaOdBXR6Pzs2aShsP_3t3aBcZ6HyzY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7aGVafhgVMjLoIyP-mevoxee7QmW5EQl8aUJGusyO_Vg&oe=6A204CB4"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RCK9JY7hriwQ7kNvwG15QIT&_nc_oc=AdpFHf1L3BgASHq8ZoqXrNaA75xvWeellIuUZBljXhXbnvndJSg1c45u95AEzmeURpo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_z-oU9PVnqrXcxgrE2zsluooFndbA92psOuniiaV7Hw&oe=6A202C4B"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uOqOmP9qPnsQ7kNvwHiGOYp&_nc_oc=Adr30G5VJjg9QbZPrr7R4lRfS1AgpobznVpve-m5AxFzAqLWZeQzQv2SaXl4WJ6VQNM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7tZ1FCEqqrb1PaCJOXxTysU-MqcbhQkbz0oHybBlImRQ&oe=6A204064"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VSLnlECuE2UQ7kNvwGmJoly&_nc_oc=AdpIrigTvM9SB-BGtkLM8BsH02s-1YBkB9V9R5xoHy2dGj0OAkakr8p526TXK3I5TUw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6T2BA_XAef48f-k_thvVpUfvnJm3Nv-QH3aADXyVHEOA&oe=6A2029E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aERdQ1Dow08Q7kNvwHl0qyS&_nc_oc=AdrEdRpcoNsQoZhoQSdGrVQIny4NsO0AJUTxc6qHG6sKJsh4U4tT4Yn23PJBhZ66x2c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af59Us5A2s0lPfcVwbochpsLS8N-G4qRLwL6jo_XevaNIQ&oe=6A202C7C"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
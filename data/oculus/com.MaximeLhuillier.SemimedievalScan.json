244715", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2u0qM5U9-yYQ7kNvwE4GFbj&_nc_oc=AdpvKWelKRnzsTQWBZ1V1M8cW5RBIFXnKdpwNl9v7vFpmS0dgPaLuZTa5ImCXpIrYkQ&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5yJJZ5d7j1seXTiX-nCHPvqkapjIN_vKM0RbFFLK_Sdg&oe=6A09E334"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V6XLW2u1ldEQ7kNvwF5gNlH&_nc_oc=Adog3rDerO3geRBKxRvcXBXENbpGHZxtuIMoV_RyZIAKlHGO_Fxwz3v89BlVVi11t0E&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4rVqOVA6nCv9J7D_qvy_ZGHgABvH4fvFMrVyqZnoK8-Q&oe=6A09C2CB"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o405Avv_zJAQ7kNvwHepvWD&_nc_oc=AdoxEpnynygWg-YNpnpt1jchmToovEzjor1pRi-5AaoiDVTNbGEG7wkOKhcrVECqFiw&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5LjPh3E826l5VeqsCImFL9bVgDLn_1LfgYbYHDKUPcfA&oe=6A09D6E4"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5h9cQCTZGncQ7kNvwEEDxaS&_nc_oc=AdqvkQyRqELwOQbMvCRhC2UYgjdLNHPCuXnYnVhffbHtvEU_qhdrnE_spKGklNps07w&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7zVNB26Glesbbv9Op1QJWS8ZZBzoJ6mwIFdYTSATdMlg&oe=6A09C060"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WZpdI6pseEkQ7kNvwHNmd-H&_nc_oc=AdpSjWy6Z45UZCT4oUCmT5KmdQPasPEDGi-Mzs9kdI6WvQSHYYO-8hGZUe4SKYn2tC4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5HPXQk1nvkztyiyBJHI0WiSYSphsbXa4CG9zRoaC4Blw&oe=6A09C2FC"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
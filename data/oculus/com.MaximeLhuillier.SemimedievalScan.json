244715", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lhEtqD1pMBgQ7kNvwGGQ8oA&_nc_oc=AdqV4wIKXseA3Paiywzup6W8-hapF3zuQCZW1gfskEBOwyxUezoZ2f0OhmiEirS_p_M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9hsNSfd7W2IHuPu9g7ZbMour17jnXGd6Yd9pQ6K5NkA&oe=6AB7E934"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GnJDi84nDEwQ7kNvwGL1zuB&_nc_oc=AdozhZbuxlnAThlwK-vcdPXwShYK16bWTtlBcBibhigkv9oEDoZdmIkEZKMGmXPEMPQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJra_gg0qeJuF7O0qCA_OqwSIpHvPMvBgxOqrLsvgJMcw&oe=6AB7C8CB"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ob8_7kOdz5wQ7kNvwGm63Az&_nc_oc=AdphndTSiiO9Y_G1l8u7B8m5f2FtSay5Z3-KOdlGQVVe-b5EBBw4y7byzRiW1STys54&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNwz5dByKpElpvyJcF2KPROzDScv1ZItV4zR88pSTu0A&oe=6AB7DCE4"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nJfSrBZpoksQ7kNvwGw0pSz&_nc_oc=Adrgy0N8OQwUK0F6lmIQ3DSoVqWb97qRSvMtqj1ic8ZhVbA0ImYpqL6Ynn68-xxsWAM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIS5ZT8GjT0QdClG15uQ0gapiUzsHHAQ1GLSh42vVFk3w&oe=6AB7C660"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NPeRoFB-SwkQ7kNvwGpZ6Nc&_nc_oc=AdqzL6hmd-KoUJXLVETlG9BJseBg1YNPwQWCkrBTcVveLkrZZqm4xTO-fjIDs_Cj7r4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHolyRym2iWFUU_EjBRfICQss14SDIwGjKaKFuOwR61A&oe=6AB7C8FC"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
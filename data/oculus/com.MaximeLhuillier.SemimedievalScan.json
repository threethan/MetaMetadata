244715", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PJnu-r1UMpUQ7kNvwE0Ag3F&_nc_oc=AdrOTyxDoXb241UXP3DgGA9TZE8mgfi54JX7wSeJmQO2WndwpB2cSCeV7acCwNo85yo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0THRvACDT6pl8d_n9ebMQXhp4G8U4rohiXqVLj5BOEhA&oe=69ECA9F4"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-NbZBpNYXEMQ7kNvwE9TGir&_nc_oc=AdpMI2o3XdBma0YGTIlIErQNsjMWPzKHX4e_HzTVsP2TbekZP9EJzr_0HX37oHrURek&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af24pqr9g-OWH7GI3VcXpG3sPI6_MXPJtfmzO-fpmqqdKA&oe=69ECC1CB"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AD5U1gurXPsQ7kNvwFaZPLV&_nc_oc=AdoEM_-_Hfsp7TE6W_MDvyfAu-1mHdMlwKcOHsLZomIEbtdJX8wC65OMg006e-nitAM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af24hWmh6RNRuPTyXm396_7ZDli9472jmSBE1T-CF4Snxg&oe=69ECD5E4"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kbLInkQocVEQ7kNvwFPvKLw&_nc_oc=AdpJyI4N35rlpa5_ZPp9Cj-XTPJNvhecrdI23taXB2Ddbbk9R0YppJKmX1jK5vF_ok8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ntlbZDe5KykLYMi9t-mvl3_oDSGhz5lKSrwSNiYIlzg&oe=69ECBF60"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bEcHTm4UVPoQ7kNvwGzpFn_&_nc_oc=AdrSO64rEUulAblvTtJYxDZ0yUCusaDBnlGruKBNEUA9gZNGe2UJv5TJkoBR1VTonTQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2aHFiFZTvvI_pjr1uC0J2rBxBQPIX-TodjkExUT7w57Q&oe=69ECC1FC"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
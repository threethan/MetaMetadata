244715", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bXvtVtHPHA0Q7kNvwHHDfVB&_nc_oc=AdrCfZbH2BwcbYeeMOSH7Nge4nmTZBTbCRfvJVZ6ibUUEaNbQnFT-BKfrX0IWIHUwzg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmTlBklfA9aRcK-dnWVC7KElyHYaT4FVWlIz6oQ9il6g&oe=6AEB53B4"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-zE3Xd5ZuvIQ7kNvwFErHmr&_nc_oc=AdqkUdpRRZAAk4GEWDxujO_NcS1MhLfJWIJvc8tsPWNpVE0HcpbhG2aBmlBAPP6FNIE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaP4XEuKZzKY5oywx-9qVDxPwjYEu1wG2_Enkj0b5MbQ&oe=6AEB334B"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oaMu6SrJ6n0Q7kNvwFWTkog&_nc_oc=Adp5raCfVK1adRSW4rzJGsnvwaTbr_E-zrzjbnjNiD3vMw3bNT0q42O47X1Wn7tiYnM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQReItJs_LIWr-vFPboi8Rj_k9sdfwgY0qJ06gBYmZmQYQ&oe=6AEB4764"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mL9WDgLhFe0Q7kNvwG668L8&_nc_oc=AdpgXtKrWoHsVnOAbMCp8xFlRLv0kG_dnHQeiGTyVRsttEBuyDW70tIXKx3k6gDYs9U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsZgdYYA8bWBUfinTWhQgSQb2Ugt4l8F1mbmIf7W5UPg&oe=6AEB30E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iFp_q1KS7MkQ7kNvwGsBR2E&_nc_oc=Adq_oKK8db4V1JpWWnE-2Sl0GGeW0XNEiybYnjXUgJW1nIBg1LQy0yFHLR1WseOoNGA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQx6CsVXf-wz4awfulvvMXU38z7BeT1U98yDXFXzO3NQg&oe=6AEB337C"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
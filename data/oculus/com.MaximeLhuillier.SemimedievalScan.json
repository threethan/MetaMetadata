911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aQyMBXr0n3MQ7kNvwFmf8qK&_nc_oc=AdmLyha9LgB5-iK_cA0p5FsKHBKDgL53DmgYXPEz0CtrvcwMknvbaXvVnFsz_yV0Ulc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfywsuG2Ps9Lfs7eEeePzcZT21CMDQl-XFSzkJgCeQMQaw&oe=69BBE274"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I6x8T3amn_QQ7kNvwHHrjzW&_nc_oc=AdmlW5By5SJcgQGygW9Ik30NiOulSR5AJ-anFELJV8DklTGGNym2xk362zvgTWUvp68&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx6NbOF0MMlZIE8t-Dla2GevVWJYXSO155jfjafYy98jQ&oe=69BBFA4B"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CapA_gb0AdgQ7kNvwGolu0h&_nc_oc=AdmMfDAVNLdNlatC7zQJPnJ_22fpgwm9cBOjoXIOyQvAqeKq73ovIlu7zg_YhWiLShQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxHwv6QHm8dZPKNvBSMAG-R6_A4fevgMav1R_FHcnmvnQ&oe=69BC0E64"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4zlB6SDvySYQ7kNvwF2B07p&_nc_oc=AdnD15LrhaBk9UdFpvpqB2G5CHZjTCz5ECeeaMpXMZkb4gVvj1-V24h7Mg-6ETxRqbA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afxda6Qa1Lyxz76rnJhjrpVQ0gJeEf-jpLaeJA6-RTfLXg&oe=69BBF7E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AFbntdkLgvIQ7kNvwHrxt4c&_nc_oc=AdnOCzBiAq-RSf_cA7mSJPAN9hRdfhSc9TB_j3Omm4jWQf6M5Wz-jwl3VXzrRuXimzc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afzkmsvuve7bRUr0CsrWUa_LT2fA_SvvfhLvmCAmjd3YpQ&oe=69BBFA7C"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATIO
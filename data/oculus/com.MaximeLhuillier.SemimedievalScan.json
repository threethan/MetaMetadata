": "Screenshot0.png", "id": "1235098807268738", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982658_1235098813935404_7719619199213845753_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C1VS5OMXo0kQ7kNvwFvfWln&_nc_oc=Adpme6O-pLwqvfcWNpCOnIFfUMc5wrw3a6ny9f5ZCt9EoEqDkQn90u0tbv17wYta0JI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0nGrQ40qWCC3CO8aJbPQBOU4V5nMw3S05QaSVPMRiXw&oe=6AFDD308"}, {"file_name": "Screenshot1.png", "id": "1079721616244715", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6oyDASrDJfAQ7kNvwHEtKCZ&_nc_oc=AdqblyLqZZdSz6-_LrfgoZGheCRG7kti6K73pd87AOIBXudaCC3KyFSf6-rF2PwrfW8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQe-eskc0DXwA3FstunPHl3xvaqiS_2GfwEZ28l-0oYFQ&oe=6AFDC8B4"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6OeOHzDbuEIQ7kNvwGFENLo&_nc_oc=AdovHejnuXaZQqtOcd3E3db811UFG5XUSWgHZG5j20xNnDZTgMM9lm5bwt3vIwGR4Rc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkTXvEmEdDw9S_HI7DolCodjutjLsGoaVONMBCzmIDkQ&oe=6AFDE08B"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nX2Impq4WPAQ7kNvwGcAI1W&_nc_oc=AdpJk_HlY0sQ4d3-Y8S1WRBJvQKFSLpPz6mFTS60xUaEDUAfLBin7xF9DYBx4YKSIeQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2_AJj7MFVCAqHyIJFLj7ynMwxjKhcK5db_bKZpkAM5g&oe=6AFDBC64"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5MqsuWiQBh8Q7kNvwH5rzae&_nc_oc=AdrYw-c--UcZQAXxqCT63pKn3Z3arIOQgs7_tYqqg-cHY1-Rnx_YneAhW2V7Jy4do_s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMqXOSwJvkf_La9rLtqmDL_KrUSvX7PgU7TY_1ZKRjWg&oe=6AFDDE20"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GjZMRwbvrEgQ7kNvwETbUxG&_nc_oc=AdogGxCo4MA2WR3DEG8mWznwFKJdzJs-OTarL76IHXJ5wEwdqzJx5O2-Y6O_gkACfJY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkmD0CGH4RrriRUKub-ZJEO8dJDbId94VP-7BGCTaCmA&oe=6AFDE0BC"}, "display_name": "3D scan of a semi-medieval town", "keywords": ["photogrammetry", "reconstruction", "360camera", "digitization", "scan"], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8744915575541513"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974593_643470730539088_3502460444141589985_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xlX0NFGLOD4Q7kNvwH4lBYT&_nc_oc=AdoZpr4xT7PtDlBw_UhgUbiZPSJZ55zx3guad20P57gf_2TP5JLb_HHmh_kmeY5mLdg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOhDx9OefdRseKj1npS4ghk5TT3EHZe7UkHpO0DCohEg&oe=6AFDDDB1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "3D scan of a semi-medieval town", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Travel & Exploration", "id": "
244715", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NoIMSXpjRwwQ7kNvwGb7kXA&_nc_oc=AdrsTNWVvpHU15201aTcSaFFJ03OE9p-r6Rb7z9UBFXl4naxhLL3zH0U1TkaWAqVNbk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__guAjQSdjCdz2KnYfjx8bvE7hBpISDacEmJ8IXzwCxA&oe=6A32C1B4"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dLHkYHOhlOQQ7kNvwGtNXkw&_nc_oc=AdpAe7RkQRCMW5aWKQsel-FeOuI7ew8_xP8s1QzN21AdzHUMZaqpcXAarI9X658zA6o&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_X5IIaIMEdXXZJd79i4Opajq6xxLdiJUEefW3puD996Q&oe=6A32A14B"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wrj4YXoQC8oQ7kNvwG6FfBr&_nc_oc=AdroEXiVO3w90Fx186xp0dhEqFT8mLlAQrVIo3Z2c3ruYZFDSfFbkW5QUUZ9t_b_rpo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Y_z06uk8_1vSywYtGXIjHIxvcYGrx4WJEvkn9-eThaw&oe=6A32B564"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ut_1UPBm5hQQ7kNvwEeJ6LJ&_nc_oc=AdqAUoXOEngrv71y1HINHms9ADWQq_07MaaqAFYuhQaCMXh5CHlAktLjeQv3uzqirss&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-tTS575KxfSGiC34Da1D0HD0AWgDHjn_cB5yVBWDkwpA&oe=6A329EE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jiw7kMeIUFsQ7kNvwGiGxsg&_nc_oc=AdogUAbBonUDA-OTQjx4_b58ZgvkUt2MzGV7FF9FqhxBh0DAF8tJZbspA25HWUa39rY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8gPUTM0EHSwsJJNJu8PaJckXE_z560piRudFTniEwQgg&oe=6A32A17C"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
244715", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YKEU_ZKMZg8Q7kNvwGov2T-&_nc_oc=AdqzZ5JWQeWjSuQPdOUkSIJaalBpXTMjrmNIUIM5hMSzpesqW7EyikhQZ2IYt1grcNA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8KYMgCzICNj3evP0tev8LT5bakdUSjhOsOC_aQo8N5jw&oe=6A3807B4"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vSz6kHPL9UIQ7kNvwHwE_9y&_nc_oc=Adovq5p0BAluMva4FS_iAhN9jNh-dgxBtD9rZXL1-F2WoY387NPjjGwcGLpChtE6h_M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Q6GilzWxPwbmGDmDMoj676wTPL5sieg4Bj2eozYQTfg&oe=6A37E74B"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q04PSRv4vW4Q7kNvwEKEzrj&_nc_oc=Adp-W2Hd0kEthAnpv16zoSk3yOgdBl2TbN9lZxwlUxjRxwaV3rVjlVoPEe2Fx2234i8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YqqCDxsB82xcKos7TnCcirZsC0iUiSQAH5SFy0p4mzw&oe=6A37FB64"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8m11wkRQkIEQ7kNvwGgI-jP&_nc_oc=Ado-nqsAvwvvXt-nbsSdZmeTCdiadL2S84fFKjn8hcQyFXVBWSS6Tq6YRkJY5Fs9y1Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8BLVDrKlookIYTX8WI1mTyRPODZtPSAFby2Y8yCXbPHQ&oe=6A37E4E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OsfiAvczfYgQ7kNvwG-cKeU&_nc_oc=AdpRn6oMVsEHs89eW5VsNz5p7SQY1_Ii_UHZXudIC_e2PMxP7cY4_WRJAE-XKuVOyh0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ZXV7CIs5-UDBfQz3TJq_r-8AEprYCEWXnY283KGI1ew&oe=6A37E77C"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
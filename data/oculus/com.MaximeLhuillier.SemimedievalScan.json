244715", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VENZaoGliUwQ7kNvwHzbaD5&_nc_oc=Ado5fhLgc7O-zYErpMVo2BhAadqST0m66Le_aQxXmuVeZBhyuEzWDY3j8LBUl24pY5E&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSxmuOMixW5Lej0Xwzi08irq91VnYoNidggqmhxUO78A&oe=6A92C6F4"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-zYr7VRGW-AQ7kNvwEEMel7&_nc_oc=Adp7iSod7pRPDpsfcpQf5K3SZFHE_0wTlsNEupBJzb3fPLsUGxhQ18Kdk3Dxv-Zk7H0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGt0MNzUSti93Lf5fz6dNsmIGpOVHunLwfawyke25wqSw&oe=6A92DECB"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qnpbs80C8G0Q7kNvwFTqx0h&_nc_oc=AdrW6sZRrm3eK7RcLFj-fZEtv58wHhvnR8HTQKlu-WeXTgODEawhCVvwIkZsNTqhv3Q&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGttFJBh5FZ4rO_5BMyU1JA_qne6bzydJEE-O0kgpqNRw&oe=6A92BAA4"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bk6t1016UcoQ7kNvwFPl5-t&_nc_oc=AdqVj8tTIUeSPj33nwuM83hNSvqZfjh2efaGR_AQnaDRRnq2vuYmit-OBxwTq4fnYuM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJjLGbE_jgTqrZFLHvi2Qk6F5mUG8kzQ2gebHkBIKiow&oe=6A92DC60"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P5b7hPhDQPYQ7kNvwEMUB0V&_nc_oc=Adod_AlXPTRR00Kb3THhjt6HTtpGsnsquV5ISYCqOmFD7zu2xU2QW6ND1hAU2jsX490&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHptKpfTML7EKB_1OrCR_ql214nlDGmigm2cW26XJR_yw&oe=6A92DEFC"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
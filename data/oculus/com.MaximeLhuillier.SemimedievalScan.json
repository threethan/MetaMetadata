244715", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=78OvTBhdPNoQ7kNvwGCEVHF&_nc_oc=AdqMvHRQrAZLMPk6fMaX5d22dKK_iaeMWzYbZBzgs7iegX1HYVYQUe16PyZpJWMm_NU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1wGfQrr4rBmh_P_e2rJFPWN_9o7I59G-LXexKOAwDpyg&oe=69E4C0F4"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XFb8jroJrXoQ7kNvwFJg1by&_nc_oc=AdqTQATh_cPGzP9Q-2yLez4J6O2X6iPzaQoFbf2F64h7WvfBU9FFJ0HIlf3o2y5Yq9s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1figw0Fjs6hvsEcsyQ_Y-Ma_QVwPqZQKSB3fOx_LviUw&oe=69E4D8CB"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M5Bmo2Za0s8Q7kNvwHJUpJF&_nc_oc=AdoMMFyGW8tD12Wl7aIOVsysMrhfbLV_6SoBeCeKJLXZZK_tclV4A9HM9PzD3jJu01I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af11ciuSfx85XZc5d1jKOZRYw9spkdckG_J1l6TUJyMUlw&oe=69E4ECE4"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=09w0Udbzf8AQ7kNvwHp0ekd&_nc_oc=AdpXxExs65idALG31qvfeVhdoLRe0s2XTqdVn1NMlPonP2sOZlvKBEURWvChiBk53aQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Lhd7T835Q6M601Zj0_HhjZp_-soyMcYJM7pBKlqJriw&oe=69E4D660"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mX00-GwRmewQ7kNvwH1Meoq&_nc_oc=AdryAz-8FhuzOzABAXfiGbhRs73wTgXc7c1WY0wGcXe8fS9kHQCPm3I6v0QBi9mNx1k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3dtRQPxsfyPELQ1fD5lEPb6cMrqONxDbw-qiYlDAhTjw&oe=69E4D8FC"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
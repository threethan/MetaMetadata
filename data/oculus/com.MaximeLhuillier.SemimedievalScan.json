244715", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T8RvtSF8YlUQ7kNvwGtrg9b&_nc_oc=AdrtSR2hEbcG43wZLlETrUtwQVWHvBTECHjr42TCZkEq5RBR7Vb40-9KnH5TJST4ngA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2_qhPmwUme5ZS53J-qtpcQgN3y7ZAgOKVTUh9dlkFEMw&oe=69E0CC74"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cap8XwYeswoQ7kNvwGW8bo8&_nc_oc=Adp9qcS-J1fMHSNrVR_HmACMx8xwsNHNXyJYfuvOdJLDouGdfq8RZ6LcVBqjNUkH90E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1iRyCbPHP9Xct7q80-PJX_vsDmRjilVTwTdqzYYqZ0Pw&oe=69E0E44B"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZSneoQi3w6IQ7kNvwHP70Kn&_nc_oc=AdroRKQLHoHoXoK-sYV5EfY5bww71yWsq88rfCcnDkREEOaSMYRB_QUma4RvAnFxbeg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2GRMAacTFf8KS_ObLS9FwydAe-lZ6Y19vHJpGXvZGqoQ&oe=69E0F864"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nl_GpI8X1KUQ7kNvwEJtNfF&_nc_oc=AdqSZeqxkWKDZni9lgqH-qVHzjZf6Efkn-e2Zp1y_XaXp-Pls-BV_taQ0ZNfvQb-mn8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1A9k54WEu4914xNgev0bFfL4AoJYyryAJ_Ns9QTRDkyA&oe=69E0E1E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KM0xyV8PKHEQ7kNvwFcxI1R&_nc_oc=AdoNtsPsGedMltg6l3MZR7GT9vFuqiOykDjvzMAtgYCslQgteKlIMER3sKBp_a9sneQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1WzpmdhQjyGhDxy82oq-pZnSCO7Lyh2oI5pF_xonfZdg&oe=69E0E47C"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
244715", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MR-VioNYiGIQ7kNvwGWvoWj&_nc_oc=AdqJqQAj2W77KCdYNZnJOT3UVOVEZJglT0ngjF7h03ydBgLHxe7j8UAFa5FF-Xj8Yc0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFMzN_IordlkEtZckiABLS5r0--ocChbxdk3MvAHK9TA&oe=6A9EDCB4"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eJAHaHdyZpIQ7kNvwGjLIuf&_nc_oc=AdqbQzOsEG5EgPIESMNv1tLabUxC4__LOVIJht7x__D-18Ax9Fe7V0ak4-SIKuVC0KU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLI5mUdrQEDNOXH1kwBRTHHBIPlS7iF9O6NsVBoAfoN7g&oe=6A9EBC4B"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W3ZnYruXUPsQ7kNvwHeUA6u&_nc_oc=AdqnDxwZGWP7XF37CtJ8Ev3U3qWReZKEdHHX5GjlBnOUwGdZVOJ4QyxK0wGOpuPqzIM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKJ59oPV7oVcxP1gWJjm3WqAzEAan2xjF2rrPf_nYXzw&oe=6A9ED064"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lrVok7ACuCQQ7kNvwFjYJy2&_nc_oc=Adq8dMl1V5zSWtJNvi8vh4j1wdwo_2eVq63XSewbo5kMo8YizJXqFTWYRDmQc6Nthjc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCUNucJsnMZEzDcjCv3LnLUDgUfguM0TRWSpCiHs_N-Q&oe=6A9EB9E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wy1dhtyb5qsQ7kNvwHXQ9lB&_nc_oc=AdoCJnEXo3-fUCIUggFX98lEyz-f4mUxgRXgPujulCqe3NXfJMEAK5Clcn1c0qcs1sE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKYoCPS2rhS3gBkfTH8c0e6B5K6HgtvdZSepg8jXXupqQ&oe=6A9EBC7C"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
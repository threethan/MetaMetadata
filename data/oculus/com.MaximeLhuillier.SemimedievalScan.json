911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1k1qCpkY_b0Q7kNvwH6S9vU&_nc_oc=Adl3dOLBgBjkJp4eI0_PmgDxDNGILjzV8vzJmPDzmoy5A-sQZaMnvr7jBkNhU_vwNRU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afybsuz1R2I30q8tTdPnk38RvjL1mxblfAxN6ZWKCGC6ug&oe=69BD33F4"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I6x8T3amn_QQ7kNvwG1PI06&_nc_oc=AdlgF9k6JfdEiGjdmGpdeMPyea7HXH29fCBvIsICB0Wwkvw5jJ68-yDZ1yUykoY6k9w&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxnAbZTY8G9qtqqWy-TuVYYQM_2LHu3Va6pI64jx_Q3bg&oe=69BD4BCB"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l0LpJSJIkE4Q7kNvwG-voyG&_nc_oc=AdmE6zIZxLpNTv-NoCnHtq65lWNWSlXowHp_XHppxgOxer6Q2cx8917rWrebBaEpBr4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyXtRT1fPBNZ-Elja_Lmz2lRMriUxhBvTnqEbDR8jLZIw&oe=69BD5FE4"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4zlB6SDvySYQ7kNvwG0Cwco&_nc_oc=AdlQl5ftN5eeFM8ACCurMu8ZIpioCnh2qWMX6x-YagCH8lS1jqnRYLjr7SlIDYFJrDE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwYIvS5bmrDEGOaz1HPyvQObl8E5puseVis05uJbycapQ&oe=69BD4960"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AFbntdkLgvIQ7kNvwHYUdjY&_nc_oc=Adm11KWlRZDo51lLzE8IP2cK31DlCQFXalpAt8w9NDffISdpaRzT19SFGZNCZWdsxHg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwWrSJtAsVta3ZseHDGuyA-bbcykUo1kGP_Vm3MB5sWhw&oe=69BD4BFC"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATIO
244715", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DHxjiPpRqDQQ7kNvwHgsIMV&_nc_oc=AdrmZXIaTSIvZYeaDv66wya4PV0hSN8q6kz-ei6sn2wjOLcuvznulJ03aTmrVy4SzrU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwIKf2kgTs_03MlUFanICRqrIwM-m0Oxaj2SqhojxZ20g&oe=69CFA8F4"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eP84UmM7mV8Q7kNvwEiu_gB&_nc_oc=AdpNupVt1Fp9jo5tm-kKW8vM2syAYTtqu1Dxxk1opnfrIWFNi9RnZkycW2zsFQDPYpg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxzAvWwRNAfjBpRFRcL49W159rMfkFX1d9ZtTwPyEWf2A&oe=69CFC0CB"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sXMErVAeldEQ7kNvwEXhrjC&_nc_oc=AdoUliQGv917bMBRJ_ELTLhPEEbT8s6f4bcyImZrno6F_0lpZNc1FE7lCx5CaEHeiMI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy6stIKZ74HZvG0fOtkPJwGuenEEWFGcNDRiB_xbo3AgA&oe=69CFD4E4"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cBYan_6OuPEQ7kNvwHumEmK&_nc_oc=Ado0p7YX-JsxogsA36KPm6CnEENKCdJXuPMJjBpUp1-roefheIom0MMeYJ1CCODmg4s&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz9VGFlBz17iocvJBm4AdFAQMBknwAvD4GzZiY93J2h1g&oe=69CFBE60"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GEX9fC-qVzkQ7kNvwFReW6u&_nc_oc=AdpnpnmKmiJVQa1UKAYAwwigf42f-Sc0xbDXOSYtOzzCF4cmr_gO19rGWozQ43kfsI0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyGYUEiNCkk_HBSshDa38s8n4eCHaOW69-TRqlB3-X6tw&oe=69CFC0FC"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
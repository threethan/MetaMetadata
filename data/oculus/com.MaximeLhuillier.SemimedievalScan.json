244715", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u6chYc1sJ_MQ7kNvwGUP2G4&_nc_oc=AdpRNtZOA-Rm05z78MrZpuHd71bnl932ZGRMqo6nL_SehCtCW703eLuy2Z4-SQYOTXw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af94w-tONfjJkhvTMpbdNCJyBNriGNUyiEnmA6wWUfycBA&oe=6A341334"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dLHkYHOhlOQQ7kNvwGir8GD&_nc_oc=AdpTQgYmj3HhKHzHed02czJ0TaZFVX4ntNI36agws2fCilrw7EewevurXOi517NDgEg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ZJ9ROoEzosetnLq0imHHNY6-NcxnCo4RnSsUUCHdMgw&oe=6A33F2CB"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1b_zzGZ6stsQ7kNvwERKxU2&_nc_oc=Adq4J15d4uxnsvqlZsKPsCKzKVMHiOufRAQ0qgzGeoTpBDzp9Z7ybl0C7BgV0tRDKgo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xzyUHhhZljK0uJ9z7dYDU8k3Ts_SoxQM1WaqV0HLO1w&oe=6A3406E4"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ut_1UPBm5hQQ7kNvwGuWjK2&_nc_oc=AdryN1BDmqcjK5DjrnQ5tnV83Zdg3TB6eDI5VyJ91Ju9s3SYJAlj5akP5_Lraq59F0w&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-CVOlULmPtstRV3T6WLkbadriiYnKtvq0aCJGzD1fs8g&oe=6A33F060"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jiw7kMeIUFsQ7kNvwFTWJGO&_nc_oc=AdrhQd5dSFdMJ6TuUXYWN8rOVpohaRJ8ZGZD_hV3GatBXKxo2THtCEBmUAikmCO8-A0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2IMASmSUXPojNNAN-DolnpBnB82rDka5RawLrVoT0RQ&oe=6A33F2FC"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
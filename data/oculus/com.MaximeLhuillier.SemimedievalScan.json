244715", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S40fUZsfmE0Q7kNvwHZynN9&_nc_oc=AdqO8O3EjffMNivKx2eD3IJ6nYmFQyCxAYrYEO9DDVcyBnpzK70yW_Eq_K-LchZ4p7I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNC_Ex4VZ_raF7El7qRnqjoUwzf24xjAzIVcrPeumVQ5A&oe=6AE0C7B4"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gxiPShsd4QkQ7kNvwHLb649&_nc_oc=Adq0d-RoQFxWFk6DDpiIYtykHI-kf-zo7FuW4-5qwKj48I4pQ4ctJvKRGoS3ucCFTPs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPeqMLBpjsRQpNhoTVd-Y0eHcqMJofkCuAxMkZw4yGQKA&oe=6AE0A74B"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZyRbfYt0fX8Q7kNvwG-Z3R1&_nc_oc=AdpsTQsE4u5LmkL3MXuoysPFbXqmLbbFJnZlWWOcgCimTB_Lvk_NZifP3QRNI7SHmY4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMcN_oOuTax1ogvM4VyZVhHdxU0XXhIGCEtEUKgzi1DWg&oe=6AE0BB64"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RIr5urvad8IQ7kNvwE6DckX&_nc_oc=AdoYl6SdU1_ZXOIbmc9YmamY86mMlsyu1qL92q2NNc_y22R9uf-aYw330pf9UB1Q_6Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPXWmIQHcTQlgnPux591Pu9wzMxzz1Tgk54rOkhYQg0ww&oe=6AE0A4E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B7ZzjIGxuosQ7kNvwFVCwiH&_nc_oc=Adqkac2vC7n7FFB_KTxOcXsc4ed6jjb8K7RU9vHm2DAdm_6ednNoWZTRxK8fKgs2p-c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNpuE95nktI_aOmq3GsBxaHM9QY7ZJcGKNghUoo-jjGpQ&oe=6AE0A77C"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
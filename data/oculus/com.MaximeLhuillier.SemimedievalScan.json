244715", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hAjNEQJ_b-oQ7kNvwF_ZcWe&_nc_oc=AdrDk68nKppQAg1g-sfwftxQilU8c9w8alciX_8AdTgMkW3WxRlVuQgJuFM4dTMLvs0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDv0L8kRHa6usEhiga3kZAE2nrJ_UW7bXNEtcMtvfJZzw&oe=6A6896F4"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GTV8FJwYqegQ7kNvwGWt736&_nc_oc=AdrQfIsgjLDjN3cCclnTFEJINwb5TKkkVgXnK2jNOy5995aYXoXNSeo38nMwhdrHFAA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD3chbQbBu8eLkGHsJyIWI-sT5F0QZWuI9mYXaezGYGDw&oe=6A68AECB"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U0u18x_pytIQ7kNvwFyZUCe&_nc_oc=AdrbWVbyusv6GHwLc5PItXzHg7UOeHd2fkcR5Tm6rZcHhxfQOJa3VQMysixrgbCtLgE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDsvNMaf6goZURfNA8MH0gUEv8-4KlRJ0SMjL7Hpw15mw&oe=6A68C2E4"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j9LZK_OTukcQ7kNvwGZ8tz0&_nc_oc=AdpNL3h08_6GrmNy0AVf-mLdvMYWQVXl6mRmIJQCLkIp_8WYVNIkVhKFcWPvbQKdy6s&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAc--3avjEYPDLh0LKC7gVFw_JASOhA2UVXrwq_ecgQNQ&oe=6A68AC60"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vpcEbU09IsAQ7kNvwFgjMQt&_nc_oc=AdrCHblVS7-yB9bd5cg4FAWXKclyHftELY06bXcwIoXIxrIn72Mr4QrDvWmhO-mOhJ0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCvbXABJnulinY4IXtU-iy9aNTDfO-VY3zhDFGpLK_lGg&oe=6A68AEFC"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
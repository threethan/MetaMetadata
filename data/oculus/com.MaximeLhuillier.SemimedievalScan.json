244715", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jTchx54v8EwQ7kNvwGz_Fae&_nc_oc=Adpl885BzbXx3XbUL1-gFeb5It3ESMeeVkmq0X1Skxahp3wV1b3lUZ_4gRw_3YOOx6o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCOpVAYLI1cm8mWox-3AHHB2h0lZ0q481dHJbQN_87dEw&oe=6A6350F4"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LY8yABDwqmAQ7kNvwFey9xe&_nc_oc=AdrbwoGiFl0H16eutfg4pMk6REsSx8ilWpngeDn2npZhoNnCtmxcBEqNvRF7lD4kkYA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC5agMMOvXvsdgryEXjY-97eWh8YyefdAntbCdRR9tTdw&oe=6A6368CB"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iwcuhN1BqSQQ7kNvwGQEv3X&_nc_oc=AdqpPiDOzYWOSKBDFl7nEwhnjebGIat4hAOfgpYzNcTRv6Ci3CzrWPdgcBj3w7DXLA4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCtSnPMnjYFcCaRvD_v-5ytSq63eywd6_y33k9fHtWYJQ&oe=6A637CE4"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IOLq2Q2mMNMQ7kNvwHplhzZ&_nc_oc=AdrixzEJSVEFqR1whYEQf20o8YUq6Tlkt7BfjeUhmnkbGVxxPaGiUx0QBbh1P3kPuYU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDy87fvCW4gie2OPGzxmMzuM88JqBe0dqEKN-hqeBiCWg&oe=6A636660"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DdRFvT8MIEYQ7kNvwGOQhUZ&_nc_oc=Adoh14AwND_RbV26ZkdlIn8j0wrXvwLWkqB4hQ5T2TP64-buknqpmPrYWxY9FTaZu9A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBFVAYlr0nQXJ7ih2KthHEhjVgGKYK9wBYK6A_g12uKNg&oe=6A6368FC"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
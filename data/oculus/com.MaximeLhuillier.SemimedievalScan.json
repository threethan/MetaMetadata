t-iad3-1.oculuscdn.com&oh=00_AfsRGL4qmYAeTdYGHRKE4fUQDKRiAOOAMhXiBScl2OzeFA&oe=69A032F4"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jBF4u4XrrD8Q7kNvwE5SNRk&_nc_oc=AdlLsEk2o5O0cWHVrs_38-yaFXgOVd3S-Xv-IEVs38gy91PT6rKkXurwB4JJwpTuIb8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsO6g_79tps_CYkVnA2CApktQci3yDMbSKv_6MuS7_Bhw&oe=69A04ACB"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YlCc533GOlEQ7kNvwGFUzhY&_nc_oc=AdlwRGmnaJj6_mmIrDl9k65Vu2obxBRPsg2UpmxBUjI-vGdS0ihXTivhnitHI1N2DMo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu1sIJv07vNsPu9ZZRLd8bb4EtYLTD5E8eL0x0HgXsFtQ&oe=69A026A4"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cN_RMBRNBuMQ7kNvwGwLK01&_nc_oc=AdnrYyxFs1F6CRM0k6BToqgLjZdFi_4rzZ0Q2DRaniiOuQ_8P48MUVHgJ4sCr55QVCU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afvu29nHCv-_3N-ZPJKLst3ayTmIGWiPgRGn6J10DOWZcA&oe=69A04860"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=STNL8RuAp9MQ7kNvwE-1CpC&_nc_oc=AdkAJRnBAwZbpXbk1hqckYRvScil6EPpmfuTihbo7Xyc--_MSE8eX-1al9RNLZo7D4I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvCZ4sMOr7HytXhkgpIKS50MyS9tQuQGK-Si96bld2VGQ&oe=69A04AFC"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "497208435570627"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1775993366072693"}]}, "baseline_offer": {"id": "1775993366072693"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1661964780, "status": "PUBLISHED", "id": "1775993366072693"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5781986361834464", "version": "0.1"}, "id": "1315291425673466", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5781980855168348", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "5781986361834464"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1315291425673466"}]}, "change_log": null, "created_date": 1661948191, "id": "5781986361834464", "version": "0.1", "version_code": 1, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
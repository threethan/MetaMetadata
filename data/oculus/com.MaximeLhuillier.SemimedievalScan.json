244715", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lhEtqD1pMBgQ7kNvwHE2uRD&_nc_oc=Adqz-hxWbNnyaHNex9qb9XaRmvAg9ivfWjkdQptJA1ejcTXysEuTs9GnsdtYwAvjzFI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLy6dffBXdXeb_z6IWc1LxskYg7coz326aMi0rhW8IEKg&oe=6AB93AB4"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GnJDi84nDEwQ7kNvwH8Gzmh&_nc_oc=AdpwdJXeAvQNm47LtEVXd9wP1p12mXafTDMO1DnCTiFehPnHR_NNf4aJdhsI7JHWSOw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ84wc9cE2hiT_YT5x2VS-jO6cG26e84IlnjJzhTVmrGQ&oe=6AB91A4B"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ob8_7kOdz5wQ7kNvwH5HO_l&_nc_oc=AdoS2EU1jmW7uYlgzbdeHxT0-q5uitTIrbviBBH2qnoAkPSRsFQRuRwytGyvNn9hGNE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK29IhabHlOb96LIt-q6Dg_5m9d6K01fi5Z1PxyOuImxw&oe=6AB92E64"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1QTUU465cz4Q7kNvwExQex3&_nc_oc=AdrvouzRrDgj0vgo6YXNyFbvcvBMF_-TgUNkTpxOUZVyfln0IAQ_Zdp3CZXzvwlQ_Vw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKGI-W4dXOIKyQxPq4OWmhkfifsBxNsgRlC1JPBj9Qp9A&oe=6AB917E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NPeRoFB-SwkQ7kNvwFesYbr&_nc_oc=Ado_H0h348k1RxvFe45h7NmMwtAo7IDR12fFS7wKEsfajWK3oObBdfByZHsaCccrT7c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8mgw2HrSeWbMnlraiE_cpoTgKMR4RRkDy1gXNNy4PDQ&oe=6AB91A7C"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
244715", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YT3m2vMGvgoQ7kNvwFwzft6&_nc_oc=Adp6nlAQUO3Eghkmi9mBFZpLs_QtDGpTP1ywY4sNO5Q3Ds_8G8ipEP-ebrTrbwqu97g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ZpCugE0ydR12Yz9oQd2NeJarlHq5mOXRIQa4xzXHxOQ&oe=6A0464F4"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-C0mAe5Pv9AQ7kNvwGvNm_3&_nc_oc=AdpcvT7E5GrFzeniUFOvKtEg17ZIUwNi_OZfjP43EanesztOJ2Szx8bF38AIVO3dX0Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Y0A-zm5vEqNK61MzO5Gl-b3OYwfw4YA7_-DND6-dtkQ&oe=6A047CCB"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E1HIqWftCVgQ7kNvwHD4t5q&_nc_oc=AdphGcwHnj6uzTQIyYgef0nS7WBUpBjawjnyReOe-NQMM8671_74cuNhkh3LVQ3gQ4M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5bJxh_-R9aX6tkseHPAHGsU8y6c_uGSlupk4Aiuz0ieA&oe=6A0490E4"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x60K4SwiMngQ7kNvwFR52Q_&_nc_oc=AdrDO7Z32u1N79Ck8jRVendUp_anmrQ5cXttQWKxnvkOyAJ4x90wis8NPNabx0L6mr8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5OlmcUgaHKgr-O0dLI79wBziRFRgg7QNrpAMS94zQI6g&oe=6A047A60"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H-oW1FgP3_IQ7kNvwErVgjy&_nc_oc=AdqTfCJwBySkZ_3QT2EISErYRd-yWlZhEM7-1H5Q4IYo73ky_berOkn7WJqk_jHPQFY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6rawHRcSyiMJVSFY3Ox6XvDzBQKuaYkWhAkvVthkhY3Q&oe=6A047CFC"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
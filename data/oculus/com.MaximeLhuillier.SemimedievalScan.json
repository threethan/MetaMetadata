": "Screenshot0.png", "id": "1235098807268738", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982658_1235098813935404_7719619199213845753_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EmH-iCXohQEQ7kNvwEdGvAK&_nc_oc=AdpZIJ9uXMJWQ60YK9PKhpyfqY2MUJ8n3czofxKINV1GnmL4wYZD94yrsbCnB51q238&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSuvD2OZ5f4XOUTsfFBT6QUfIHCnLAOwxT79HzEZosNA&oe=6B070D88"}, {"file_name": "Screenshot1.png", "id": "1079721616244715", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qgnh_RmDZZYQ7kNvwHKoFQF&_nc_oc=AdqwwScd7esFBHl3WxAEUq2KF27lLaFCcald8ss4Gv77tMf3xqFh2C6OLNw2JiI4aqg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQi8cR7sSELCFa3CfC9ue3WwG6SvfL0sXGFOEM4xWOx-g&oe=6B070334"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FWPgfSrNuJUQ7kNvwHxo5pE&_nc_oc=AdpxhaCgzuPONC7tbcAIvco2AYSyUmgUqPfPT_FW55H9tsMTCIYcItn5YFAmV5ueG80&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPyE2dD9VjrdJ4fxKpkLEt9_Lgfmiun4xlUNw6vegg2Q&oe=6B071B0B"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2rNpF9GtOuQQ7kNvwE-IsHN&_nc_oc=Adpzg4JtWa4uaDAB_ZffdsN5u0zKF0OP7rM3GjdZ9YKXIepqViJ9xkbVai55Dd2AI2k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZpK8xg56GzN5_FBq1COfAZwN6WXu6in2KcQQWkW3C1g&oe=6B06F6E4"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=44DxOIpkDacQ7kNvwFaluNy&_nc_oc=AdqJgr5XQXJIeP_rtxYfP1-vslasfgdkcCut4FQdDsbvL40UbbQ5BsxbAZStI46yDmI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0rnHll_Vo-RUoKcUXMpRI1B3elntWp9VhyYytO7dblg&oe=6B0718A0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SkL5yoUiJXkQ7kNvwG-FBDv&_nc_oc=AdoAAhcO4xY2PIJ41hvgT4noQVGPYXrLc4zExn0FeDLBF4SNGNK82dBKUFca2HNGr-I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMhlWzO2F2Eg5DRhl8902UtiF9r3iQD8om1gPhTovAyw&oe=6B071B3C"}, "display_name": "3D scan of a semi-medieval town", "keywords": ["photogrammetry", "reconstruction", "360camera", "digitization", "scan"], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8744915575541513"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974593_643470730539088_3502460444141589985_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uEmH5q_8BXEQ7kNvwEreo_u&_nc_oc=AdqKcjTnu83VB-b4YncJF0Rf4cAXdZtUqEp_AZnLGOFYF2aolANfh2t-SOYLnvTVFPU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8Y3cX5RfK23dwC1CFskW6eaQbiCNVqW1Wn7zuNJuTVQ&oe=6B071831"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "3D scan of a semi-medieval town", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Travel & Exploration", "id": "
244715", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HgBoqZrsd6kQ7kNvwEcj0NN&_nc_oc=AdqOpuMcBno9WlpbVnMEYi9zAhTRBzQxHBlD0eNwkuHjMdqLg8iPk5xioIy7fMA1C9c&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6oKBRY1u2aE2XYjtLHfpN5KhR3oR5KCiZqWckjbcx2UQ&oe=6A15C0B4"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fNUDzXAA_QwQ7kNvwFmedXh&_nc_oc=AdoYbiB0IdiwvHu4QdZQKMBAE-XTe_xGvXOUO_1ls_NiyGaFkAoSG9v2vv8hRYyU3yQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4J3F7ugshhB81p7_OaeoTDOO40hbAO9HV9Ee3QLDRS0g&oe=6A15A04B"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DaGslfsqlg8Q7kNvwHaP5HY&_nc_oc=AdoM2zbyMxFSdHdH_6pAnaLAZXf64B7Y6QL2XEgrOV9myt4j6ZFMp9aorEChjeH1grA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Vxo6MDg6wdJPOm-nk-2Eio76TBE_413cFavWF-MwSUg&oe=6A15B464"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=caOEwkJv120Q7kNvwGfWno1&_nc_oc=Adr0WZKIYJuzpASQj1puNftrxFNAxEe6Thq7129k_BGhb1euHaP1SPUSq5YqT3njbis&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7GIXyKvpjHY-8DoQlEVE0NVZL-oRzU-bw1PLcHxhyRvA&oe=6A159DE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MDOLGHXaTUQQ7kNvwETHVrj&_nc_oc=AdqvAeogbXEFBsZ-KHjsvFt_mgWB6-XMZyHu_W330HyfUcZqawKAgZG28kcFibWFaH8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Hggy7VebRBONLgJVSLosa7hki--NBXhTSyLWDlUln5w&oe=6A15A07C"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
244715", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9J5jDDDg-VEQ7kNvwG3Kp1o&_nc_oc=AdpxeMVY96XrEgR4RJO58CgJ01mXv_q1rfX-XZWoRJxtSa-ddYU02jMzKAWcN-26XP4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDmqSTJeCL2aVVQEhmRMROgZV8MA-S91M3BYpem--f7nw&oe=6A4E7134"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QaIKkGZmoUsQ7kNvwHphlAe&_nc_oc=AdqnIiEM_L_LLQocuAu7nLxjXvEkpbIYl6X2CHkggCicDOvvXJTlcS4vdpXyX21cbrI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB4-6DYFo8JgtinMLBDO29vk1546zyeYR3JqRig-Ay0VA&oe=6A4E50CB"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P60psEQZDhUQ7kNvwGqDa7t&_nc_oc=AdpbN4K2Cvryh-XAyUeeG69iujBMT_cFi6K_yCPotK78cJIIO4gaVeOO0k_4gCu6lKI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDHfi3PMRANneKRZhvh_7jhCgvp5ScWobGOPaO1NDlIZw&oe=6A4E64E4"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qIoY3lfQE0QQ7kNvwEiTFFZ&_nc_oc=AdqLkSzf3ur8lMGsOYDicLVAU3d0nAfRxv_rpzH5_wuZbmkZ8kgwT4FVbxIBSvTWF8Q&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD2EBAC2UVjJCcSEIAPOC83Ey6O4H0ffZGDVvEvppyoMg&oe=6A4E4E60"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jp_-6ZiOQ4oQ7kNvwFy4TFo&_nc_oc=AdrATy_rEDSvJq1iNnGEF0KUYhur_KrTvQgsPPErbNh_oD7RArtgRuXVkaT2EJiz-kI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9pmWvpjCDHiKN6AbXsmjAhq1n0gL4GSURfLSPypXzHg&oe=6A4E50FC"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
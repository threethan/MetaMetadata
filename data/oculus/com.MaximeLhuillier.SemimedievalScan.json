244715", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HgBoqZrsd6kQ7kNvwHoDaHy&_nc_oc=AdrUsxQFZC_45Kg3EXIqOATB_SlPEDOib6KwpjyTUSqX6sF8LX7203Wvb7I6wCKFBFw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Kd1RnBVLWLQzsAqKXzV-dB_wu_rVUWjliQmpeOWWCiQ&oe=6A146F34"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a55cuoQ4hucQ7kNvwHkGJva&_nc_oc=AdoT8dvQgz_WXbdDZkndX7LJGE6s4omSzb_wf7bPUv8YjxVqJR_iZF7cmbhaO0xfAzA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_WXc13w-mCJLWQEdfO4C-ktgNEGihymaWUUGoyx6FaA&oe=6A144ECB"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DaGslfsqlg8Q7kNvwFZW883&_nc_oc=Adr8BN5J0lt-_bxLe2Nv0t42QFZxtrU3HeQtSfl_UiZ25fSrvfIdyiIPErEBwZ5twu8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4fYMO6IvIC1OYctZdTq-ZPD2GQenEczWul3SEfWzxN2w&oe=6A1462E4"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=caOEwkJv120Q7kNvwFOwAoR&_nc_oc=AdpJWpi0zMdy7ZW4JNRvzq-Q-L0kC1iCmC924HWFKUy4JNVFjYHCEp6M2XXr6hZ89eg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4KtF6nrQ13AOpTKkCf7SRNtEYI71vHS7tWObvzuX7vig&oe=6A144C60"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K9o28246RmYQ7kNvwHGsWXh&_nc_oc=AdocJC2aI1LpR7-dHjWK6YVdsOiB4E56WFt7EzCiLt1cJNw2hUa3dfEv3HJSa88gAVs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7xQB6THLXeFKxp5aqGaZDYnS6Ej32oLK4NwGlXNKN3Bg&oe=6A144EFC"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
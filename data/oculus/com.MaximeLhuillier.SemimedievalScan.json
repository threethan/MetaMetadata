244715", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bXvtVtHPHA0Q7kNvwHoWgA9&_nc_oc=Adow9T2ggIvM0s6BHewzahQFMx-4bzapODhJCdXLjJd1kdXa1AIoLnoPJ6aGXBek4Ks&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwQwvP_xR4wJIQ9ehjE0jBpF09iXpJgYWiUwpIQ9DUKg&oe=6AECA534"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-zE3Xd5ZuvIQ7kNvwFC5DKU&_nc_oc=AdozBvsoV7lDJAipSkkV-f1BiTVaGESao3hdlKYgMoHkIN0Y2u05EJ9AOsglQPhfDyc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXwIXzK6tKKFaU4D-Jle_xokdecb60ZZdSrCmHriGwnA&oe=6AEC84CB"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oaMu6SrJ6n0Q7kNvwHn6xZh&_nc_oc=AdqI4DYnIvZUXNPrCrnj-p4t7ShhnUAbakc5dWvTqcN2Ys_6I3eApL0fp5Rni8CMwDk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQgSsiAsp_BbPEDbI_NR81kB0A9zdEuuDJ1tk5vGwnbA&oe=6AEC98E4"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aXW_pyJv1PIQ7kNvwEjqLUM&_nc_oc=AdqdaBgnmZ0NSwrRVZPjRqP7amyx2ImvRXNw2AaRHbtRPy-5RHtjWXct5kaPdYDaHVg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUxBzFB3CJPEiILoYKJqqJeU3aZJloao1SHyHDyUPFtA&oe=6AECBAA0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iFp_q1KS7MkQ7kNvwFYszOI&_nc_oc=Adon9UxWd3LssonpzRZ3Hzw6IjHWcPP6ImdVardS9ZBonW1DJWl7k9Uq4HeH2gCbjKU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbiDGMEv37eNP3OIEEGCl7gd9PAF5RZspfk-I4yItCkA&oe=6AEC84FC"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
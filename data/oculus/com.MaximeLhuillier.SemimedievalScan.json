244715", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WSDCMqvu5ToQ7kNvwFJvRyO&_nc_oc=Ado_dJlJkrZxipcLN9jJLkwwzzCJCaVL-h97Z68WMOaw_xy3kYmNxVQeQ6GykdK5Uu8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFAYnU5X7qzp1ONhIA-odTsX5csIGR6j6cxsnOYhbulQ&oe=6AAD5D34"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K5OtlDog_qEQ7kNvwHIWPFt&_nc_oc=Adr1RRPsRkH9u0DrLwQczVO-eQJi7BPCJXv9y9ahP7SnOBRV4_c8XQn-OOMu394m7JM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWIm0hO2eV3hZqhlhku28lbDEcoMYgvL5geSHMg7CyAg&oe=6AAD3CCB"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_271k9En7c4Q7kNvwGXkXFm&_nc_oc=Adr2GdWTO9n8fc0LkKYyA274s3i1OyFUVTRA7m9GgGKq-1YFSLLVtwoU05sm_IVxJ_w&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0GTHYH1ByjH_pZ-59GQ2BRqYUVS0ocXRoMR2NE5vGbg&oe=6AAD50E4"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vixyYRBMBOEQ7kNvwG4U5tE&_nc_oc=AdoUOzFy8mtMU6UouzgS_UW2SLvRaSoQ5cgPKwJpAK58T6z1PKzwehMXVERmvHefTNE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLcg1iSAjgI4z8xGwbQgGuGN2Yth9akYSV754gH4pYTbQ&oe=6AAD3A60"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u4d0DRqHpDIQ7kNvwFMZg4i&_nc_oc=AdoM6I3f0SS-0Vs5VUiXIXhCNBvw_KDhxBJEeIorjd0-VUDM47FSzypdb6O5nj9JYiM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLfrPH_viYII-VQrzU7n5cr5yPtWUhNPMaOeJYMglYGFA&oe=6AAD3CFC"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
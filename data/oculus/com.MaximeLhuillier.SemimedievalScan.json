244715", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fYx8IPU5aWUQ7kNvwEO7-uX&_nc_oc=AdpcboIRiMV6iEnJ5knxsLVIUssjZarwmm5_66_iFkGI71B0B6mU2y3iqlqkclxk8uU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzgWvyE-GoNAshH7xyVyKNY6eXjp1WUYgOoPWakkSV0tQ&oe=69CBB474"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qvrxoCWjm-wQ7kNvwHZghWG&_nc_oc=AdoXYj0T0LiuoPvK0ADbFLbRWbyi6OL-LAP-21zEPEqWvtUDdZKjRWvR6zBP_iAf8HY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxtB7NCcKMWsw0lBjU2HyAR_3gYfxMkSwPvlhL1QXqgxQ&oe=69CBCC4B"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y4ZTA-neuYoQ7kNvwGheUzI&_nc_oc=AdptKFUJ7tWVVLpm_yWrSpLFB7OdH6tLwjHBPTrtteRP_2Ma3gnVID9y21gsjbq5eLQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy7mjgHozeOUexM8iQOjgxyiNz8lcsf8kgvpEHR3BKFhg&oe=69CBA824"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=soXWZlgRN4cQ7kNvwHlVSi9&_nc_oc=Adr15i_aZLMwTvbKFWGalhVZanVg_bZl4PtLgtgXf5OfLIQ9aJoP0QXgh4eOZmrV4qw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyhdWNmuYuGG-vAG1FErJsNwlsXgL5I1-hNdgrx1V5GKg&oe=69CBC9E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JezznYiLDgkQ7kNvwGjZX-w&_nc_oc=AdpxZJ-fHCkfsQYGRNSzn_WKyQOd7Zb6BOY9cNo0aQ5mY3KeEkBVMj2EdJV2p7WpAaU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxu5lyOGmZkiqDHK5SvJT1TIBUksS-5OrOI6XxnI4b-IA&oe=69CBCC7C"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
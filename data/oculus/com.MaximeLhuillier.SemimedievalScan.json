244715", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mg9df71R34AQ7kNvwGcPdqm&_nc_oc=AdodZLwcmgRR8ew_PgTqBP1wsjK1RsFv3NJxsDpQWLGR7Go3hbUZMa1_G6P6PgciEz0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8W3hcsaUKiI3ihLZgORI3gY3vZG2YnFYjhNNeTHpw5Q&oe=6A771774"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sCxzAS-WQykQ7kNvwFGh3G1&_nc_oc=AdrWSDHq7ygFEMUYsK71teWaq-t5W-9U9oed7-3mB1unSfWbmJnYTteUaErwSDZ6OnU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhXBimrMuDVrtrvrr7o7Uw-vT2pYXTl3_DpWCaC6byTg&oe=6A772F4B"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=odCdBBs2I-IQ7kNvwEy3rvF&_nc_oc=AdomuajbMChXWOwZDga7tpZw6T9YfDBfH-3Ot9U6leUn7DFGDeKjMvFqrprZaSFUvSo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF476FLrICuwTZOshJVB9xOmJh3enQ_O7kGD2I8e3HZow&oe=6A770B24"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xYLxIxkoasgQ7kNvwHO22f-&_nc_oc=Adotk_CCiYQy8RDt1oaf6uyq1eiAOagRApBqtk_l1NaJAaOEd4NqE1710b70CnHIcfU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEeQwPh_WFLyT2KUPcqUIvSErNrg4wGSneEncJXSOL18A&oe=6A772CE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7tO94RDqB2AQ7kNvwG2vRB0&_nc_oc=Ado75E70CXdRWhXzyV3lknAPj0YQRjA8S4H2FZUWNpjSFkC5PXLVtn0VX-2UQgLWz1s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4woOVZW5Z5YGc3LmFcAo6kI7v18NL-pnb3kohUtEagQ&oe=6A772F7C"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
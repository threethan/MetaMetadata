244715", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u6chYc1sJ_MQ7kNvwGOC-qJ&_nc_oc=Adpby8JBQ4Si9F2krwIQH-vQUBekgn5EjNuZAQuVBG4VMWk27qF51dIEa1qvZFXrvbI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8p3Dx4D4yMBG-FUsx2w2xyRB1P-BgYWgGLYhl92MOEUQ&oe=6A3564B4"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vSz6kHPL9UIQ7kNvwETy-vO&_nc_oc=AdqwAFM1GhvuWPg0oorX-9hQy0r4WL3LC4yNNlxr2DTk5fyNuw1TPYUh8yltJo0y2EU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9IJR0ynROixIIG1SjWvhDhKvfMgXTO4oRAOxVaL14omQ&oe=6A35444B"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1b_zzGZ6stsQ7kNvwF4gO1a&_nc_oc=Adpy0Yia4241JOQNATOJb2oAgzBAA0fTO33OUl5mO8unta9XAfx3JQQCLH8S61rn1rs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9mMczUx0-2idspxZOFpAt1GcruWtDH7z922jYFWtlpvw&oe=6A355864"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ut_1UPBm5hQQ7kNvwFzt7DQ&_nc_oc=Adpt0RK10jDOV2X6n1Mg2eJs6Qh1CqZPRGOW3gUxGCMIdd7up6xxTnBv1GZh9oeytpA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-8EUP9emFaYgvmvVLxkuX-QJ5BtLVDnH_Lq0Vkz3jdQ&oe=6A3541E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OsfiAvczfYgQ7kNvwH3MR0M&_nc_oc=AdqHDQZ0_ElPKe6lZegD_yrPxxh2Sx72QUfwxuUeOWW_17uDjVYXgFXTa8qRcjND63g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9oDaJDz63AvcceBNNkKDMVqGllZ3ZGEs3qnegfwAGKqA&oe=6A35447C"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
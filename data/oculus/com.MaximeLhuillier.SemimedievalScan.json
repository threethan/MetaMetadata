244715", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UInQkDOJPtgQ7kNvwG6kS1s&_nc_oc=AdptVfUc_cQdlGHypwKZcGvga7zl4yVpiYtAN6maIX0SnKSnnH1VXM35f3e8dFqmhlg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3sH7-_djXsSjek3LsmYSBYs_O1kkK7jjOhgUdPhlRxfQ&oe=69D791F4"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lzjk0DkU5SUQ7kNvwE-GddO&_nc_oc=AdoguZ24i-9rf_q56xF6MpULzJZfwE2trMRJK40l9UPR_hDamzEuTaDCCy-GlVBBC10&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3jzumBsvfu5pS3YE7Q3ANGrGkshynH0TFYwyt2rahSfw&oe=69D7A9CB"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I6UMK5ay634Q7kNvwGvGzsI&_nc_oc=AdrrA0tYVYAnkQkW7CKCmyBLuxIsyWQZ7oZkuymbNhPzoR3c8AaLHhieSlSwXcFCZsE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3MBwqyUSA-VU1YthpmZoaO2zlA0Z712E3YvnkVRlP4Xw&oe=69D7BDE4"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9KMtJKXVdLcQ7kNvwHXiMOG&_nc_oc=AdrlFsxlU0Tg4stwxH0EFf0N5X0lIDBXDSlLfczNjInTsC_dfr29Ggo48r9CSdsDR_A&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0wSuRoR2mU7kCdZe2TIWuY4e3RDWrMnAwl4OZnJ3KLSg&oe=69D7A760"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gm3GALp1dekQ7kNvwHUTOjK&_nc_oc=AdpOChLyBsyjjUBvQ-jPTZKb9Pkg9kJwT6jeTxwfnps74ggTzZGSrPrcpoe4PWy0sH0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3mU6x_CsuD5G62Ud9hwYDVlndPfK8hXVE8lHMo4Oylxg&oe=69D7A9FC"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
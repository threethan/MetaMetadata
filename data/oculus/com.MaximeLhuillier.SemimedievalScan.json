911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rSZ4YA1gtWgQ7kNvwHty0ya&_nc_oc=Adpk6kihQiTU9BICJr0Xh-Hr38e2eS7AeSMvWflGmM6EqZtIOQy1MzMXPPog6q_e5xw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx8iV9Qhv_9CERmWW75mbCFyEQ22Gjay_zNM0HJtbYkew&oe=69C12874"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y7ouxXF6FssQ7kNvwEWXjFe&_nc_oc=AdriYDP26yeLdSJ4KZRWZzW9eCI0IDnrCzAyt3Y6_aKWwxFGCEZ_iEq9csghQrIvLi8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfztvZ-EmTfz9z-uZotkm3u0643I8fvEhRFBlC_OpX25Lg&oe=69C1404B"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wq4wUdgXpyoQ7kNvwHhfuXr&_nc_oc=Adp3FHXDLDgHHsiFVaxpaSVkgvcDVI-FMti12V3BJ1j-HbA_vlMN99CkcyvnqSABmJQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwFltBQAP2RIj6VK_utoEnFSrD-jnc1G1nX7dSKmCJjyA&oe=69C11C24"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oZxsbc_rLKkQ7kNvwFr6ayB&_nc_oc=AdpQmtjxgIN73ezBBwnGtd9ha2XmYGu1G_YfGUMxqRoiGCth2ZXUF9K8Z2v2lma4_O8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyZpVNLMIm8IHBG4ln9HI5yG3OheMHFb7ul7OfftZNGEw&oe=69C13DE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B_9mK-BZ9JAQ7kNvwGMww4h&_nc_oc=AdrPSrnR4LigK0VhGj0rcQpRNJ9b5FBVY_mIRlGP1HERLs0f0AP2bWDzB6SRFOmTYAo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxwY4nc7T0KSQLdk1RhJfJopauWoEm0Pv7vU8kYR6h4FA&oe=69C1407C"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATIO
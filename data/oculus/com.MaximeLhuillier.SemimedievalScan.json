244715", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=63QXNpF2NmEQ7kNvwEEgRGX&_nc_oc=AdqIOUYUJvyKJpKHFdDcA5kPB1UVzoSuCzqKr_G3err_9yvnHnO1iIA_nKPIR0TNgFw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIlBrl0Iw1Z_GqklHK0JQoR1GAgoLYilKywsCFhSZVn3Q&oe=6ABD2F34"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f9iSLB5WDCwQ7kNvwGSS0Y9&_nc_oc=AdrhgdbBwFnl4IODGO7LIryBD2X0uO6cJublB1Sm6u1GxJ8idmg5ihwNrjGOS9u5Iqw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1BCcUf6wUswjXnc5qsnLPU-A6cRTtnW9sh0OmYj13jA&oe=6ABD0ECB"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AGQkGAXzh0sQ7kNvwFsZqMe&_nc_oc=AdoMH3BIVQk1ZI1sb9SHm_7sKGc2FXHaAB8QK7eWvQVHeiDQ6WHVydhXyOxyJGJsJ60&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfsmbErDphyr7n7noCPuOsn18syyIAHI28HhpzEEwUVw&oe=6ABD22E4"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U7S9J64khUYQ7kNvwFDYsir&_nc_oc=Adp7WgugwRMB5qF_xKrwsmR13lRc_I0LwmCnsxOOvG8WzytSXeLxgs-uaZC6Z4T8ep8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWKyVWhpA9OjL4tnIdWhP2H3_R2cH8tp7vDSyF8QwVjA&oe=6ABD0C60"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MeTV-B-9rBwQ7kNvwF5L0Q_&_nc_oc=AdoLb1IkiudmPG_odgUUH6e-6VBr2sVdcUnHiL7bnMGIGdyPooS5udZuXReQBEPNLE0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-8hlNwleRmP_RQQJ-E-yu8AHM8CXaap5MlVy5_OFuoA&oe=6ABD0EFC"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
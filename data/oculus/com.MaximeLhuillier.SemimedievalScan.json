244715", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uHSa1XeNG10Q7kNvwF93gLx&_nc_oc=AdprkmPItJvjQgqom12uhaAbIpa1-2_IeZHC116EBkHp8pzaWuAXxRnKNgaeENoyQHM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8pKPp5pOb-Ho4Ecxnw_0S3x2GFS5fqM_WZV8MwYjc7Bw&oe=6A3E9F34"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=03ZTNA8MSPYQ7kNvwHbzjZN&_nc_oc=AdoGp_AjyCXQsEGXGZUc6m_6jK32mw8PcEV5GltdnaaCsZWNrvCRitDUuq5S3zB1hy0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ntNVikw0SyyensNHonbm62vg82Na83ZDcty3l--fbXA&oe=6A3E7ECB"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P-eGMbwAB78Q7kNvwFCc850&_nc_oc=Adqz9G_bFnbHI6IAGSAgYWsp2DxqJfnXemn6UxkdKokwhbJ6TlWiXZyhVb_H2WakVpk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9n_euveqwAKN8ejXiBCmCWUqQCV_f2sLfi8Q8j49QOrQ&oe=6A3E92E4"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DXsLOec8OhEQ7kNvwE5vNvX&_nc_oc=AdqXU2wqnemc0x-ZHCv46zxBwM2iZ1yBSxbzaF8Z0epiB4d5-pzxEx9PiXRmo9y8Xss&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-KjU9PVXt0sJvUwo8o0BR7Uq7cPbdrBnLV_WEOA1b0zQ&oe=6A3E7C60"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b0B-gPiGx4IQ7kNvwE0EfKF&_nc_oc=Adpe_5LvpkEfyTfwwkXd9vlyILuPfM_TFzvhOHtWD77ZITqYHK4UyTItLsvY6lashD8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ZbIZnztMb-snFkg-s5m8NzU6i57ovHG-Yb6_z7hDSWA&oe=6A3E7EFC"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
244715", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cm9qs0t6BO8Q7kNvwFLF_hx&_nc_oc=AdqBKZFo6FU-2LbINF5bue0DEpQFzikLQy4Lr_6L5NKC7CT8jVU2aDDa3d3baLV2avs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDIMaEZLaQd1o1Yq3jwPPekGRXHOR0EfON5dxoR5epuQA&oe=6A6F2E74"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P5dhADzzLVkQ7kNvwHR3Nur&_nc_oc=AdqDJDzufShJkSq3HoDiJmQ5knInXhNTzVzOIa5xfuZN0V4o4OZGnwp8mj2MiQvCgxE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAN6jZeZPByhLd0zKmF7rDwHBx_P3c8sdp0QsVdI1BpGQ&oe=6A6F464B"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2E1W3J156RQQ7kNvwFGL3TV&_nc_oc=AdpqHq507fnO5k9b7c1jXW4l4-CWkNawm898FeGr3-HoMebHHqSr0woTdvPdZEHJHOo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAq4PvXFInL8g-0_27aa8SkqMIfnRHgdMfWVB47t5JEcw&oe=6A6F5A64"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_1kGABMamXIQ7kNvwG_hjg4&_nc_oc=Adq7OBxm_PfLymI2nBTA5WgF_UQ-PAzyUUIDGcgmIuhLP7JB84ajgpTrRXYpmtCoVKo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDebuaZ-8ul5E5KPyPexDKEj13d5WXlbhcsdp7-Mrc8Yg&oe=6A6F43E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lg27-d2NmoIQ7kNvwG0OiZn&_nc_oc=AdoeIwEaG4WC9v6TJ1QjcbX6klDb7yVgalZkSzQhF1NZov8h6Pik82IrpOKZ1cqkwS8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZWbJKm9T-6Cnfnl6hsSfPUqEnEgtMV4saL6gTZgwUPw&oe=6A6F467C"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
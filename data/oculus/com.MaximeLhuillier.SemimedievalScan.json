244715", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jiL4lup11u8Q7kNvwGYBxge&_nc_oc=AdqBJ_11YT6iOKFd6rN8YBI6kagvjzy0m78f_fijt2unkGhHi2Mv5J_Zxu50QoDJeU4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8s0PROTNksyTP_qx6Xdyyj8lvBn1V-1nUMbsaGkxFl6A&oe=6A219E34"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ij0qXHuv2vMQ7kNvwHTGjAn&_nc_oc=AdppTOab4vlNGgkvinIZe1xgC4LHx_XXoM_G_JyfcUM0JoDvw7b9yTuOThW4Mx3v29A&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8YGRDZVW85kCDrODq75tAGExHYiDGWWFFYhtHlrp9GSQ&oe=6A217DCB"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uOqOmP9qPnsQ7kNvwEQLDjo&_nc_oc=Adpe1_K8W1EDCVZ5rwx5mVx9ewjsA5rR0Tt96CcUkcq4sZj8EHx966KmhhsOx7tCynQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_SHtkqsrC5tT5uEFQadbobuJ0eHOj1z2DBT20lNG7dUw&oe=6A2191E4"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VSLnlECuE2UQ7kNvwFURPfx&_nc_oc=AdobQtPi10B_XlG0TW2mCcXdU80kyPMn_9Owjarpf99XzWbNtxiiw7U-XXbH-MsR5iQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_lJrMzUj1I4MiOeWbYMOHO9pY1f8Lav27gzkvG8_bhPw&oe=6A217B60"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y0RpzfJWacoQ7kNvwFY7hwR&_nc_oc=AdptVO6CMGs8fdCYOiN2Hg-T9YODWrEQcwDpbpq-K6tefvSdVKfi3P56joonK2GtiV0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-CD0G0GjI_kcJrLyWbjA3_aIbViEVQRdvTFu_fwYltOA&oe=6A217DFC"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
244715", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vx5HDCS8nVsQ7kNvwFoF5cz&_nc_oc=AdqXkmSek5DTuPI34PD5CK2iev363qAWd5nu-c2IE1UgM-qteV6mPHFDT3qayYAujGI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaBdnGYnJLjruITEXEnMGqnOKsJRVZs8JBm93srDP1zA&oe=6AF099B4"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hsWzobZ416EQ7kNvwGwunQC&_nc_oc=AdqwFeskXH5WJHiHWKj3Tnaue-t_dgi7BPQkDctvyk5G5HH70RZ-N7QmNwa7LA2kCww&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdhiY5RXKALUIm8aW099sRg1ccwAP3UK6rHLnJXF3NwA&oe=6AF0B18B"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TayVWrzFcAQQ7kNvwGOLcqR&_nc_oc=AdoEA5TyCv17DfbOfywWMM4eS8Hk7lJ3Pj3hHp2wJ7OYguz8Dho5B4If7wbUmHJnziw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8nU3T6k_WjkAts6s13-wRm-aV4YX_Sr9ZjKdFi80MYQ&oe=6AF08D64"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=890JL0C-r8wQ7kNvwFd_HQN&_nc_oc=Adrq2ptMb55BtVo8UOMXG_Zd1TDB8tlT0_jcLqysiH6HTBAem7gvIAOGR7iOxTqpqwU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwgl_nbs2IuVDS49SUEYTTvokgY9eLWpsK8MduJjM0kg&oe=6AF0AF20"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-cCgCKfqFsUQ7kNvwEhPufD&_nc_oc=Adpqc-6qVRY-YaQQRY2DlIcNU2NuugmCubZhL32a2BvDrimVpdbZmeXVN4wIdJviefI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRktE71u_376c0X28KrPZ7ORjyj2BenYNDhb0MIOJHyw&oe=6AF0B1BC"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
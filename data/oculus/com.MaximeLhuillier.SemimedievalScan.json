911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CQAJrJqeBjQQ7kNvwHIG2MR&_nc_oc=AdmYBsnac1p4XYXq-eYDc4zBDk9z763S7qKcyYYnvJrsTwXDtpVsz_ifVieIDvednJI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afsk-eAHR1ShhJpO1bVpQ0Pl0DDmLQsC8O4MyqEMlLIB_w&oe=69A81BF4"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d4lgsTryqikQ7kNvwGbv4gn&_nc_oc=Adm-Gk9I9xk8AqIfXFvBqmaZNAsfrIbzxNCdH815v0ztfDDWwkFUvfxV-S6sruzNTTU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuHE8utNbu3OLqF3aPoliN12n9qjX5btM0YdiFbu99EIA&oe=69A833CB"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TW2VFOs06s8Q7kNvwHrw4nA&_nc_oc=AdmbIKJCvm8nFIKmsc_3AQe5EGeKYYKXyqIXLL4FoMrP0r5xhyzP3qQPZ3CklNockc8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsripYr0M99Zg56LSra7gO3WXwrWHt1YijtEFRy7MHhWw&oe=69A80FA4"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zSllU4_kZFwQ7kNvwEMoskk&_nc_oc=Adk1nsh_bQhA1Yhv65Wel00IzCqdNU-4y5RrsTZE7SNb_0txVS2h0K9NWAfCVRBaD5k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvizbpYtKUKoJrdN8BYe7kCwLnwtowlTHsj6nyPXKc6OA&oe=69A83160"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QDslwEC0ffEQ7kNvwH-DTd6&_nc_oc=Adn0bSTj6ktW8bVWqZIquU9CqlPm6HOwbncQ7Hk1YMjRKk8fu7_-rJyumgbVE5fyfBQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afu-aa0wSxTULR1QDohQca2jjVdae4eIP9JF6M3mHakqhA&oe=69A833FC"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATIO
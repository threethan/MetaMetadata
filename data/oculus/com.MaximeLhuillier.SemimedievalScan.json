244715", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UrHY0ylUDpoQ7kNvwHPA5hV&_nc_oc=AdqfiIuyuYgA-W2wrzf8iOFOWyqNu-igRSXhgXPApx0jN65UtMfu0deVxT7QLOHVJ8Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMdhgmPgbuJRvk91KaQOpNjZmTuXhMFaCadtpbJ6jtNw&oe=6A984534"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7y762Xtc0LYQ7kNvwH-d3E3&_nc_oc=AdoeLBjrrRYv-_fdA9gGx-C4Po1zhXTjGL3_hXD4CcoeqspaCFMhXCJBhvFxk5EZtto&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWI5hSUHY7WqeHB6NRX2DorN9BGHAGVmk9hOA8FxXiLA&oe=6A985D0B"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vzhBfTCTEj0Q7kNvwHUXNoH&_nc_oc=Adq16lBh7Xll3BBveYX-Hm7K9m7M5X56nvV5GVDVP5w_5CTzTwiHlXAr-pXUoLVQcpM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJs8ui24gcWE8J7DThsg4eqm16wgdXM7Oaxc74sSwap9A&oe=6A9838E4"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7PpATMFCCrgQ7kNvwE6dB9R&_nc_oc=AdoOdsDh9Xh5sD0VujkW4Ai3fV4g4aGttNyQi77eh6Cwjm3z3t8a1vNpOqzVTlY_IWo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHZUWbY0_f9h3eTRNgrCgSmYmclzuso5xtaOr7VK7L0A&oe=6A985AA0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nsLPaiKFmvAQ7kNvwG6MNzt&_nc_oc=AdoxI0HY1QthCT3jZL6nnEY-j2nwpWeTw1_XxYNGUXTDz7p5kYkepKDJUvuUWiOcr7Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpKspeFBc5OuqdphMZoSlv5nh8H_fqMwU8_caEd-wnJA&oe=6A985D3C"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
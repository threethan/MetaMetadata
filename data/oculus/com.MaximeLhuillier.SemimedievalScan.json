911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IfcY3yn8rTQQ7kNvwF91HFf&_nc_oc=AdlEf9AfU6o96Qh-Hel3uJUo1Qwd8McYXTemqxrANL29Baoci5HuoRbT1NsK07_udpg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afw_g6IUdOZeJXJ2Ki4k78ohTvHo7rwgW28SbbYrdCxq1A&oe=69B69C74"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jFP68HmP3TUQ7kNvwHl7Wda&_nc_oc=Adk-n00QdTQiLn0bCUDde_fEkblk--o6oFKeBTIgPmGDfseO_VRq4MdZ0AsLLXtrVcM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfycWlx8nP0DiChcAyGl9h23lwZ_kiI5aLSUW8wpY3t7vw&oe=69B6B44B"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cb0VWmQ970IQ7kNvwGwIxCm&_nc_oc=AdmKO1xYRrOq7HDggpnZ8qJ3ORMH5ZG2lPKSA5Ak094KHRMwQoP4-cMvO-YZwAgkXgI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyJ8BKzbVj2zN-e_rgSIgwwAUXhc1XaS3J5M9KApxyorw&oe=69B69024"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FGsVQ1LRaXoQ7kNvwGkOm0P&_nc_oc=Adk5AwRrzzxhklZ3HhvXD9Dy_pcoBAREPfCt2IrFqm7RtOpYZMdZHgLOZj7AM9Fo4Ss&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwk9A-ux_U0_wM6kVebTPgzO1tiZq_rKKkWayKpBSCvgw&oe=69B6B1E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mz7xESeSmV4Q7kNvwEDOVUS&_nc_oc=Adlmk0KFe66AydiwrF6QUbawyusX7XndjFpBOobwv0FQ49GXPTNfWgm-4TwzRRZUmPY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxPwdawRmyGIsPeSqEznXU0RaAhVO8lT-lN5voFsUJv2w&oe=69B6B47C"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATIO
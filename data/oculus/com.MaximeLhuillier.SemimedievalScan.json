244715", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036690_1079721622911381_2025426547054885093_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9CKGZqw624oQ7kNvwF6HD7c&_nc_oc=AdoRyrhC96ahTjEKVDTJz0Eshx3kimr6YCc0nlf3L_8KKqXiukK0RTSKOgMclgcqsuM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN6blBlBU571srZeJkLNpBVPDW9Xm-E2FLjuq_VaX22Bg&oe=6AC3C6B4"}, {"file_name": "Screenshot3.png", "id": "617397003109784", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031458_617397006443117_1774695430560020032_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SjUG-0QlmwoQ7kNvwFjMOPy&_nc_oc=AdraACNduAIct2YGLa0ynDfxc-8E4D5PvolGfpJsR9a2oqS5bvblZ3OiTPjzu_Kw2cc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMAQ9VEmL-N-DbdOnXeKrQfpnT3DFayz1V7fO0zzksr-A&oe=6AC3A64B"}, {"file_name": "Screenshot2.png", "id": "482401670377841", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75580070_482401673711174_747670155297192185_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vVg9zWkEt2kQ7kNvwGaHX6K&_nc_oc=AdoZZyVzTKzcfI1j9bxLITR_5C7pHXqjpJ_1LF38QYLP3cr4X5wWRMmJxPFeKpkz8CU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOplNO9KmVoFar6ogsHmL8a9C6WQR0x0kIzcwbxwvdMqA&oe=6AC3BA64"}, {"file_name": "Screenshot4.png", "id": "484817489765699", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031458_484817493099032_3228411915693974550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4lUp0fSe3ZEQ7kNvwE3mbzb&_nc_oc=AdrlOnQULyiSlFsXcbcKco9AOq_IWlvD4t8sUsqN7FwOaWzplyA9SQIjirI6wmZkYME&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNXaMhCRXErymAiMX1yOsXsbkkr5VMMDU5o1dN9YqjIbQ&oe=6AC3A3E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1775139299488526", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610702_1775139302821859_7160853561334559601_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-71A4qRZIKcQ7kNvwEJyisq&_nc_oc=Adoj6coVRCefSt_5CKAXiHFMTpKw8Xh8qaviED3C9uTsVombrqX8Zhemxysnzkfxfg8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN4ZEF35fGG54QiCZWA42SI3g0nVD2CyTTnsLU6U5eIKQ&oe=6AC3A67C"}, "display_name": "3D scan of a semi-medieval town", "keywords": [], "long_description": "Move like a pedestrian in a semi-medieval town, reconstructed from videos taken by a helmet-held 360 camera, whose trajectory is about 1km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a semi-medieval town, which was computed by photogrammetry from a cubemap video (4096x1344x2) taken by a helmet-held 360 camera (Gopro Max) and by walking about 1km in a town (Montpeyroux, in France)."}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "contex
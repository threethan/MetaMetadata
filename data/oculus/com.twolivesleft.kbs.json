}]}, "id": "1202630755180243", "locale": "en_US", "screenshots": [{"file_name": "KBS_Stills_1.png", "id": "980511574506678", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/499619808_980511581173344_7207423674585731379_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rTU-LEpaHSkQ7kNvwFWE6GJ&_nc_oc=Adqia9TpknPLGZ7ScbgeAWY1NJ1lGiKhWlI3Ao0k5AcovRTF5M9H_ruCPJPA03zAebU&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7PwsfyArId_1E0cmw0Log557y-CVkTy4U3NT4BGyIxvw&oe=69FDFFE9"}, {"file_name": "KBS_Stills_3_PNG.png", "id": "1294181812081681", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618284_1294181815415014_1570882082867893948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1gC1ou8PipIQ7kNvwEVkCJ9&_nc_oc=AdrpXpVJJ8EKx8EZh5doxoSK_3dfI5U6MGd1dubyqMzSTwuGpviaSQJdcXcRUJn2xM0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5cT8d4c9nuxX0vQU2ku6eqguOhLwHZnuwEjQraHlttXQ&oe=69FDE24B"}, {"file_name": "KBS_Stills_2_PNG.png", "id": "1706467010771911", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499618274_1706467014105244_7858068695088584391_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mqQJpMdZcKAQ7kNvwFlRE3F&_nc_oc=AdoqUdc9M2i0TzD_btrOpv9lGFh_J87mpb8rtUYFL73jA-s5J8CrrpG-aTRwKzvWeLw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7cVOtcnCT-vsDLL5nxQ_rNLY8rewKFdnn6ojdOBywUbg&oe=69FDE68E"}, {"file_name": "KBS_Stills_4_PNG.png", "id": "1331878612131995", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499617850_1331878615465328_6576108192907805074_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fbpAwL4CVxQQ7kNvwFYCxVq&_nc_oc=Adp3BY9XACHrvAIdhfzBtEYSnUBXfOPwtT8hh3wOL8tQ2DtHo-3qKl4-ihF5rhP50NA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6sQenC6ZY6rd_6h1dBx3vckRRMLD8aIkmgo7hxdS8saw&oe=69FDE375"}, {"file_name": "KBS_Stills_5_PNG.png", "id": "943829845164542", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618069_943829848497875_6854849106831117999_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9jUYGU-eC2MQ7kNvwEL-XHG&_nc_oc=Adp1wakZ8NcP1NbXgQuoWPtMnMMhVExYuCJarnHR4aBfvpo9akpEKWwarc5FYHYMFjc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Rb-G0pLOd7MDs6m3bWoT6ZbweJh0dzzLLwGZCHLYFAQ&oe=69FDD22F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "promoArt_Landscape_final_v01.png", "id": "1354889856475745", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499297507_1354889859809078_7019410016185870800_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N3RRdGTrJHQQ7kNvwGZnaRN&_nc_oc=Adq-hEYnIcrfxZw_3RFqc8lgqm0z-zQmhUkuZEhiGhZSVDgggDw5mpo6kKLquHmSz6o&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af652EKhp0hgKIf3v62B4MjLscfjQRMCI9boD7lmXD_yvg&oe=69FDEB9E"}, "display_name": "Kaiju Battle Simulator", "keywords": ["Kaiju", "Battle", "Physics", "Action", "Mechs"], "long_description": "# \ud83e\udd16 Pilot a Giant Mech\n\nKaiju Battle Simulator is a sandbox beat em\u2019 up experience where you face off against colossal monsters. Test your mettle, using your fists, guns, blades, and powerful mech attachments in this ludicrous physics-based combat action game!\n{867231876386045}\n\n# \ud83e\udd16 Advanced Physics and Destruction\n\nBattle advanced physics-driven enemies built for VR! Kaiju walk under their own power and react dynamically to every hit. Tear through destructible maps as both you and the monsters leave a trail of chaos\n{4231729640423901}\n# \ud83e\udd16 Forge Your Mech\n\nBuild and customize your mech parts and colors. Up your arsenal with attachments & weapons like sawblades, rocket fists and plasma cannons! Choose your loadout and drop in ready for battle.\n{1989062715063833}\n\n# \ud83e\udd16 Calling all Reinforcements!\nNeed backup? Call in the Kaiju Defence Force. From tanks to battleships, bombers, and more, to join the fight against the kaiju. But destroy too much of the city and your allies will turn on you\n{1288880463445505}\n\n\n# \ud83e\udd16 Early Access & Roadmap\nKaiju Battle Simulator is in Early Access and actively evolving. Expect regular updates with new features, content, improvements, and other cool stuff as development continues!\n\n**Join our actively growing Discord community for sneak-peaks, updates, and a chance to help shape the game!**\n\n\n{989810550136797}\n\u201cThe development of KBS has been a wild ride and would not exist if not for the amazing support from our loyal fans!\u201d  - JtM(The Developer)\n\n\n\n\n", "short_description": "Kaiju Battle Simulator is a sandbox beat em\u2019 up experience where you face off against colossal monsters. Test your mettle, using your fists, guns, blades, and powerful mech attachments in this ludicrous physics-based combat action game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.kaijubattlesim.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Two Lives Left", "support_website_url": null, "website_url": "https://twolivesleft.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35268897832756161"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499618432_896450976738349_8534724269339187671_n.png?stp=dst-png_s360x360&
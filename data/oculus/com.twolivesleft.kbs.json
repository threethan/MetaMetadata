/v/t64.5771-25/38974688_1484346052259215_3453884255902543846_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G0FznpkM4QQQ7kNvwGBtnVk&_nc_oc=AdncYhEnhbyvMFXf2JkPGX1usY3uWaYSsQLsQqOTCIyV4wnhMxJpEIyHdVq45NL7aiI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfusqKbyXbbwZ23wakgLoXHAW42bC1exf9HZzxL-izlQRA&oe=699AFF4F"}, {"file_name": "vlcsnap-2025-01-04-11h06m58s876.png", "id": "956244162531425", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035405_956244165864758_8890972340454721006_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=abSXo8thi5EQ7kNvwHNk1k3&_nc_oc=AdmYiTTZAlEdc674V4zcaG58TvWh1JJZ2PIGgNTBG04nfCRyiRJIzVyKQlrVctueGHA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afso6XPASDlr7ktdwCm-HPCF-7nZiOnqYFB7w737sCYr7A&oe=699AF736"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape_V4.png", "id": "1589407288861482", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619805_1589407292194815_8507903267868364650_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DxKVrnxVmYEQ7kNvwHIHWgk&_nc_oc=AdnedtPbXipPRAzhNIPG40g8m5RW8wI2Tnfg6CgYUxSkn_CeJNrFxwU7sA5ukQ6lGhw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvFS9rnGUX2ALnWNKiTy0wRYcJ8wLZxL1cu-xZIRgX5SQ&oe=699B150B"}, "display_name": "Kaiju Battle Simulator", "keywords": ["Kaiju", "Battle", "Physics", "Action", "Mechs"], "long_description": "\ud83e\udd16 Pilot a Giant Mech\n\nKaiju Battle Simulator is sandbox battle simulator centered around combat against mighty Kaiju opponents. Test your mettle against massive monsters using fists, plasma cannons and rocket hammers in this ludicrous physics-based combat action game!\n\n{8980208215349953}\n\n\ud83e\udd16 Advanced Physics and Destruction\n\n{9315981055113456}\n\nSome of the most advanced physics-based enemies ever seen in VR, Kaiju walk under their own power and will react realistically to damage. Buildings crumbling and vehicles explode\n\n\ud83e\udd16 Ouch!\n\n{1650691029182164}\n\nDon't worry, I'm ALL RIGHT!\n\n\ud83e\udd16 Everything is a Weapon\n\n{568241179406356}\n\nI'm sure they all evacuated, right?\n\n\ud83e\udd16 Early Access\n\nThis is early-access experimental prototype, future updates will bring new features, improvements and other cool stuff", "short_description": "Pilot a giant mech and battle mighty Kaiju to the death using fists, plasma cannons and rocket hammers in this ludicrous physics-based combat action game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://twolivesleft.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Two Lives Left", "support_website_url": null, "website_url": "https://twolivesleft.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33601813172797977"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618264_1232683495736044_8225245569381957038_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t-Dn9qfcxjYQ7kNvwFAm0e_&_nc_oc=Adn3o8DRGE3b_3hYwnSUwZ-qIlaHyca53nQjB20zrtT9LxD75zTPfU7_Sz2G9Tv3MFE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afvgbcf_ut0HwnvbhSyrSXFOxPZztWwDN29pxTs7_cG2Sw&oe=699B10E1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": 
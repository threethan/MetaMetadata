"}]}, "id": "1202630755180243", "locale": "en_US", "screenshots": [{"file_name": "KBS_Stills_1.png", "id": "980511574506678", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619808_980511581173344_7207423674585731379_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E9aur3A6HOQQ7kNvwH600ui&_nc_oc=AdrTdwO-hZFGOFI53kJDfKHyqYWJ4C-SEsieqLMumGq084QoThsGPq1EmAiepxwrEmY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4vYjSOl-xjjL6Vh3ea2LgsxqUNPXdC46OZmzltciELiQ&oe=6A01F469"}, {"file_name": "KBS_Stills_3_PNG.png", "id": "1294181812081681", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618284_1294181815415014_1570882082867893948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MK4xbtigmp0Q7kNvwHXxsrC&_nc_oc=Adr6EpGcNNuOw5qKAVig_UUymvrJ2up5A3FqgKFgpPFgRgyDlrKOQ5H1oJq9Slv_aPY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6eav6XOk3b1_oGDNmPm20hAqwvPx8wzWL6WYg3VeMmaA&oe=6A01D6CB"}, {"file_name": "KBS_Stills_2_PNG.png", "id": "1706467010771911", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618274_1706467014105244_7858068695088584391_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XTZRgCVvNzEQ7kNvwFAsxEh&_nc_oc=AdqO_BxFmEWWMLacoJpveNGJAEgLladAEUnvs_j3Im7KOBP_x8J2f6SncfD_4fNF1G4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7t67sN0DrJKB1ag8tfFrftS5Ep7DaJXb4YOPH-qNY5ZA&oe=6A01DB0E"}, {"file_name": "KBS_Stills_4_PNG.png", "id": "1331878612131995", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617850_1331878615465328_6576108192907805074_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J7Fh8nZwbFUQ7kNvwGRHvkZ&_nc_oc=AdoNF-Z8BMXI5sq9YlkfJSy2S316OqPqOyeLNwzjk0lgur15MVHOXkObMLx9G4UHA6g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7fWJ6gdM50oc1kLvNIUumeS80KtCO4PZFqDoFdUGqhfA&oe=6A01D7F5"}, {"file_name": "KBS_Stills_5_PNG.png", "id": "943829845164542", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618069_943829848497875_6854849106831117999_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XArCHTKPQvwQ7kNvwH7FTM7&_nc_oc=AdruJbqyG4P8_vLNgEJtJnEKwlZceuGMB44bd46j_ydP0BA87paAVKiq-ixTuDj6cwg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5sq0R71Q7VanS6ifEGax5dIAuStWKG4I6I-lkLo9XSzw&oe=6A01C6AF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "promoArt_Landscape_final_v01.png", "id": "1354889856475745", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499297507_1354889859809078_7019410016185870800_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bm2_UFGBBYwQ7kNvwE7Z_vb&_nc_oc=AdopMZH6ROywy8bGAGOlUBtI7dOhrJ-SewKHszD-R5VTzpPalScwmUZG3Kl9NedcbUA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6yEkjZxYGETfqmMITOpECKovGN0LNkXJ8ARh7m8mlTwA&oe=6A01E01E"}, "display_name": "Kaiju Battle Simulator", "keywords": ["Kaiju", "Battle", "Physics", "Action", "Mechs"], "long_description": "# \ud83e\udd16 Pilot a Giant Mech\n\nKaiju Battle Simulator is a sandbox beat em\u2019 up experience where you face off against colossal monsters. Test your mettle, using your fists, guns, blades, and powerful mech attachments in this ludicrous physics-based combat action game!\n{867231876386045}\n\n# \ud83e\udd16 Advanced Physics and Destruction\n\nBattle advanced physics-driven enemies built for VR! Kaiju walk under their own power and react dynamically to every hit. Tear through destructible maps as both you and the monsters leave a trail of chaos\n{4231729640423901}\n# \ud83e\udd16 Forge Your Mech\n\nBuild and customize your mech parts and colors. Up your arsenal with attachments & weapons like sawblades, rocket fists and plasma cannons! Choose your loadout and drop in ready for battle.\n{1989062715063833}\n\n# \ud83e\udd16 Calling all Reinforcements!\nNeed backup? Call in the Kaiju Defence Force. From tanks to battleships, bombers, and more, to join the fight against the kaiju. But destroy too much of the city and your allies will turn on you\n{1288880463445505}\n\n\n# \ud83e\udd16 Early Access & Roadmap\nKaiju Battle Simulator is in Early Access and actively evolving. Expect regular updates with new features, content, improvements, and other cool stuff as development continues!\n\n**Join our actively growing Discord community for sneak-peaks, updates, and a chance to help shape the game!**\n\n\n{989810550136797}\n\u201cThe development of KBS has been a wild ride and would not exist if not for the amazing support from our loyal fans!\u201d  - JtM(The Developer)\n\n\n\n\n", "short_description": "Kaiju Battle Simulator is a sandbox beat em\u2019 up experience where you face off against colossal monsters. Test your mettle, using your fists, guns, blades, and powerful mech attachments in this ludicrous physics-based combat action game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.kaijubattlesim.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Two Lives Left", "support_website_url": null, "website_url": "https://twolivesleft.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35268897832756161"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618432_896450976738349_8534724269339187671_n.png?stp=dst-png_s360x360
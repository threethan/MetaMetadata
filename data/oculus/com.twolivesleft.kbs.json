u8a66\u305d\u3046\uff01\n{1456957595634829}\n\n# \ud83e\udd16 \u9ad8\u5ea6\u306a\u7269\u7406\u6f14\u7b97\u3068\u7834\u58ca\u4f53\u9a13\n\n\u6575\u306e\u602a\u7363\u305f\u3061\u306f\u3069\u308c\u3082VR\u5411\u3051\u306e\u9ad8\u5ea6\u306a\u7269\u7406\u6f14\u7b97\u306b\u5408\u308f\u305b\u3066\u4f5c\u3089\u308c\u3066\u304a\u308a\u3001\u81ea\u3089\u306e\u529b\u3067\u6b69\u884c\u3057\u3001\u653b\u6483\u3055\u308c\u308b\u305f\u3073\u30c0\u30a4\u30ca\u30df\u30c3\u30af\u306b\u53cd\u5fdc\u3059\u308b\uff01 \u30e1\u30ab\u3068\u602a\u7363\u3001\u3069\u3061\u3089\u306e\u653b\u6483\u3067\u3082\u58ca\u308c\u308b\u30de\u30c3\u30d7\u3092\u99c6\u3051\u629c\u3051\u3066\u3001\u901a\u3063\u305f\u3042\u3068\u306b\u30ab\u30aa\u30b9\u3092\u3082\u305f\u3089\u305b\uff01\n{2326453131177411}\n\n# \ud83e\udd16 \u81ea\u5206\u306e\u30e1\u30ab\u3092\u5f37\u5316\u305b\u3088\n\n\u81ea\u5206\u306e\u30e1\u30ab\u3092\u5efa\u9020\u3057\u3001\u30d1\u30fc\u30c4\u3084\u8272\u3092\u81ea\u7531\u306b\u30ab\u30b9\u30bf\u30de\u30a4\u30ba\u3057\u3088\u3046\u3002\u30bd\u30a6\u30d6\u30ec\u30fc\u30c9\u3084\u30ed\u30b1\u30c3\u30c8\u30d1\u30f3\u30c1\u3001\u30d7\u30e9\u30ba\u30de\u30ad\u30e3\u30ce\u30f3\u306e\u3088\u3046\u306a\u5f37\u529b\u88c5\u5099\u3067\u6b66\u5668\u5eab\u3092\u3046\u306a\u3089\u305b\u308d\uff01 \u30e1\u30ab\u306b\u88c5\u5099\u3092\u88c5\u7740\u3059\u308c\u3070\u3001\u6226\u3046\u6e96\u5099\u306f\u4e07\u7aef\u3060\u3002\n{1524021362491519}\n\n# \ud83e\udd16 \u63f4\u8ecd\u3092\u547c\u307c\u3046\uff01\n\u63f4\u8b77\u304c\u6b32\u3057\u3044\uff1f \u306a\u3089\u3001\u5bfe\u602a\u7363\u9632\u885b\u8ecd\u306b\u5fdc\u63f4\u3092\u8981\u8acb\u3057\u3088\u3046\u3002\u6226\u8eca\u3084\u6226\u8266\u3001\u7206\u6483\u306a\u3069\u306e\u983c\u3082\u3057\u3044\u8ecd\u52e2\u304c\u3001\u602a\u7363\u3068\u306e\u6226\u3044\u306b\u52a0\u308f\u3063\u3066\u304f\u308c\u308b\u305e\u3002\u305f\u3060\u3057\u3001\u90fd\u5e02\u306e\u58ca\u3057\u3059\u304e\u306b\u306f\u8981\u6ce8\u610f\u3002\u3042\u307e\u308a\u3084\u308a\u3059\u3
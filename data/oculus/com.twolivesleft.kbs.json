_Af4zYZkIHyUJxLO7dH3Ty3e1zWvVI7ogOxTDgy9afVHzlQ&oe=6A0B114B"}, {"file_name": "KBS_Stills_2_PNG.png", "id": "1706467010771911", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618274_1706467014105244_7858068695088584391_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ud-eZLqWlmAQ7kNvwGDAO2w&_nc_oc=AdrQv-2XkQLjoRrmM-98znfyI-YYvOH8Wpf0UAYqNUvnEzv71K_5usKan7-nYCSafu4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af77qSFhtQo89FJAbkMqU7W5eQkeqPJFzhqg9KuwUTe3Tw&oe=6A0B158E"}, {"file_name": "KBS_Stills_4_PNG.png", "id": "1331878612131995", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617850_1331878615465328_6576108192907805074_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kXR-reeP4BUQ7kNvwFqZduB&_nc_oc=Adrox9mjNAwgN37TGYGE1kZFGkMrq8Jny8sNseJHnORZxTi1QmnmuUU_PL4dTtRdjaw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5HdZ-SrpwYGPcvnsAJ3x5J6ucAnycUDHDgBT_ZZgrY9g&oe=6A0B1275"}, {"file_name": "KBS_Stills_5_PNG.png", "id": "943829845164542", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618069_943829848497875_6854849106831117999_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pcpHgqQiscoQ7kNvwFaspI0&_nc_oc=AdpawTaEicHyKyIzvQzUrA8-rSf7_LGT5Evxfpbh5ZqZgbA5ZEsKX-qKNHL0uyuLX-M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6fg41HjNzZyet5Z_BVZ6mc3b10oP50V8pIoY0mhFl37Q&oe=6A0B012F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "promoArt_Landscape_final_v01.png", "id": "1354889856475745", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499297507_1354889859809078_7019410016185870800_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TWkuuJmObqEQ7kNvwHJjpqt&_nc_oc=AdocZyRbIHE4WbGSbnt64dby3zmZZrie37GSKxeINf-yIPkUYdZz01O2FUv01acZg6I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74S_ScqpDid93hRFEPxmHLLZM3LTJN-mbTp-R13iuWng&oe=6A0B1A9E"}, "display_name": "Kaiju Battle Simulator", "keywords": ["Kaiju", "Battle", "Physics", "Action", "Mechs"], "long_description": "# \ud83e\udd16 Pilot a Giant Mech\n\nKaiju Battle Simulator is a sandbox beat em\u2019 up experience where you face off against colossal monsters. Test your mettle, using your fists, guns, blades, and powerful mech attachments in this ludicrous physics-based combat action game!\n{867231876386045}\n\n# \ud83e\udd16 Advanced Physics and Destruction\n\nBattle advanced physics-driven enemies built for VR! Kaiju walk under their own power and react dynamically to every hit. Tear through destructible maps as both you and the monsters leave a trail of chaos\n{4231729640423901}\n# \ud83e\udd16 Forge Your Mech\n\nBuild and customize your mech parts and colors. Up your arsenal with attachments & weapons like sawblades, rocket fists and plasma cannons! Choose your loadout and drop in ready for battle.\n{1989062715063833}\n\n# \ud83e\udd16 Calling all Reinforcements!\nNeed backup? Call in the Kaiju Defence Force. From tanks to battleships, bombers, and more, to join the fight against the kaiju. But destroy too much of the city and your allies will turn on you\n{1288880463445505}\n\n\n# \ud83e\udd16 Early Access & Roadmap\nKaiju Battle Simulator is in Early Access and actively evolving. Expect regular updates with new features, content, improvements, and other cool stuff as development continues!\n\n**Join our actively growing Discord community for sneak-peaks, updates, and a chance to help shape the game!**\n\n\n{989810550136797}\n\u201cThe development of KBS has been a wild ride and would not exist if not for the amazing support from our loyal fans!\u201d  - JtM(The Developer)\n\n\n\n\n", "short_description": "Kaiju Battle Simulator is a sandbox beat em\u2019 up experience where you face off against colossal monsters. Test your mettle, using your fists, guns, blades, and powerful mech attachments in this ludicrous physics-based combat action game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.kaijubattlesim.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Two Lives Left", "support_website_url": null, "website_url": "https://twolivesleft.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35502765089369433"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618432_896450976738349_8534724269339187671_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8HwxpkIyPNUQ7kNvwGMzfw1&_nc_oc=AdpDuK3uT-8cOQ5VJDpTrKnpuWvhTO8EAieldwMJdup0F07z-Lr-p1jUWuSA8ho8oMc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6mfTEOktuksaY9nA1i0Ly86IyfTq4O9TPDHSU6sdd-wg&oe=6A0B0413"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Kaiju Battle Simulator", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sandbox", "id": "1990104051447093"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Simulation", "id": "331529188132278"}, {"topic_name": "Fighting", "id": "2710427532541308"}], "release_date": 1724195220, "lastRevision": {"nodes": [{"id": "26221957270783641", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"app
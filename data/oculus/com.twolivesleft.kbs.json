259858", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623295_1352009129593191_3273661964166776808_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xIQsxk_Rlp0Q7kNvwG0Z1KR&_nc_oc=AdrX-Jdd6yUKq01DSxvfCCjo151YtnaPtv1rsUNDo3KKZW0mIQIw33w2v2-argQ4fmw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsv-z3WJ9_bQ_1Eou-c1y_mzINIQ5HA0hnHbN-P_VkiQ&oe=6B01BFB3"}, {"file_name": "Moby_Break_2.28.2.png", "id": "25501794172851100", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/673689288_25501794176184433_1730287630046369143_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EXwLjtU54f0Q7kNvwFJufzd&_nc_oc=AdruFCYKDcePqsDR7IZrfSvO7AUdmdgy8Vfe1vfNuCcVBM0pxMANTr425rY8g_xOBco&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9XZXYCmsSh4B7Ua7imvmQ26v812R-iCPwdzLL21AFgw&oe=6B01C5A4"}, {"file_name": "gorpin it_1.19.1.png", "id": "1654100265672746", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/507826282_1654100269006079_6269522603563422539_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ft9ZYHpgxD4Q7kNvwFnD7Wn&_nc_oc=AdpYF1-ka-82gybSL8Srw29rw0pGSC8nYl5iFW9baCpXtL1fMYcDAxUxjFvp8m07f04&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzPGap9SVfoS-NmocdTuqaliU3piJIfh8uqOxYyZhDqg&oe=6B01EC92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "499619751_920099577203485_2118469296068269175_n.png", "id": "1452474746746582", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620630_1452474750079915_3747347445512989481_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vPpDil9zmOMQ7kNvwHzlKoJ&_nc_oc=AdrWKb7I4vcw4zi0-nWij1FItIRFQaQEyS37rHN2H3fEL2aDbjvAa2KpLSOr5BbM_lE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBvKijzYviUP1a1K2xVIxlRzpoEaTOO62bGwGFVOCUpA&oe=6B01E3A4"}, "display_name": "Kaiju Battle Simulator", "keywords": ["Kaiju", "Battle", "Physics", "Action", "Mechs"], "long_description": "# \ud83e\udd16 Pilot a Giant Mech\n\nKaiju Battle Simulator is a sandbox beat em\u2019 up experience where you face off against colossal monsters. Test your mettle, using your fists, guns, blades, and powerful mech attachments in this ludicrous physics-based combat action game!\n{1506182761309601}\n\n# \ud83e\udd16 Advanced Physics and Destruction\n\nBattle advanced physics-driven enemies built for VR! Kaiju walk under their own power and react dynamically to every hit. Tear through destructible maps as both you and the monsters leave a trail of chaos\n{4231729640423901}\n# \ud83e\udd16 Forge Your Mech\n\nBuild and customize your mech parts and colors. Up your arsenal with attachments & weapons like sawblades, rocket fists and plasma cannons! Choose your loadout and drop in ready for battle.\n{1989062715063833}\n\n# \ud83e\udd16 Calling all Reinforcements!\nNeed backup? Call in the Kaiju Defence Force. From tanks to battleships, bombers, and more, to join the fight against the kaiju. But destroy too much of the city and your allies will turn on you\n{1328213756123989}\n\n\n# \ud83e\udd16 Early Access & Roadmap\nKaiju Battle Simulator is in Early Access and actively evolving. Expect regular updates with new features, content, improvements, and other cool stuff as development continues!\n\n**Join our actively growing Discord community for sneak-peaks, updates, and a chance to help shape the game!**\n\n\n{989810550136797}\n\u201cThe development of KBS has been a wild ride and would not exist if not for the amazing support from our loyal fans!\u201d  - JtM(The Developer)\n\n\n\n\n", "short_description": "Kaiju Battle Simulator is a sandbox beat em\u2019 up experience where you face off against colossal monsters. Test your mettle, using your fists, guns, blades, and powerful mech attachments in this ludicrous physics-based combat action game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.kaijubattlesim.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Two Lives Left", "support_website_url": null, "website_url": "https://twolivesleft.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "37874213565557895"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623345_1584069046661496_4254061030421648428_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mjzLJpmvzQAQ7kNvwFR7t3M&_nc_oc=Ado059p86eKF2jW7seUuR3-pkCR70iO4wGpZCI5YqC4e36Ub0Z8vsHOzXtqwHphg1cI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUREDW9933eSAH6npNb_3DB0ba4enK672R4P0dR3Li6Q&oe=6B01D1EF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Kaiju Battle Simulator", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sandbox", "id": "1990104051447093"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Simulation", "id": "331529188132278"}, {"topic_name": "Fighting", "id": "2710427532541308"}], "release_date": 1724195220, "lastRevision": {"nodes": [{"id": "26221957270783641", "release_type": "SCHEDULED", "administration_stat
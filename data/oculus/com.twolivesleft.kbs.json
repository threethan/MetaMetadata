v/t64.5771-25/38974688_1484346052259215_3453884255902543846_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a5OA8JLgm-sQ7kNvwEgPhTn&_nc_oc=Adk3HiTecfgydWK2h-AeunG5TwrAOVCXwxDZIqa8ffCIyjk3_E4stoo1AZrEhgypFXc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftCpeENx4rw61fmFmhjziWc6qGFjDpKnb1fMfmfmhRuIg&oe=69A6DCCF"}, {"file_name": "vlcsnap-2025-01-04-11h06m58s876.png", "id": "956244162531425", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035405_956244165864758_8890972340454721006_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1wHhzfgzd94Q7kNvwFytRo1&_nc_oc=Adk2aRTobwsWPN2vW2cFgNsHq7XKpyslaHQCq48ozANvC7fMKhg9yXAxAZQ21baC74M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftsFMhHKnVlCXyXzslKAzQtzIcZft_7Qlw5tvAYCtY-2g&oe=69A6D4B6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape_V4.png", "id": "1589407288861482", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619805_1589407292194815_8507903267868364650_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aoOCZB8kd4QQ7kNvwEXJ9rh&_nc_oc=Adlts_9qEBpKe7IKXwoHEwL88tpPcZTJ_WWtot3t9hTXz73PX-6dIHaz4guD-95ByjQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftJ8pAe_pT23fGqauDsoTDJMk3AzFzeOFWyqG3ElAk9eA&oe=69A6F28B"}, "display_name": "Kaiju Battle Simulator", "keywords": ["Kaiju", "Battle", "Physics", "Action", "Mechs"], "long_description": "\ud83e\udd16 Pilot a Giant Mech\n\nKaiju Battle Simulator is sandbox battle simulator centered around combat against mighty Kaiju opponents. Test your mettle against massive monsters using fists, plasma cannons and rocket hammers in this ludicrous physics-based combat action game!\n\n{1491894735830956}\n\n\ud83e\udd16 Advanced Physics and Destruction\n\n{2011474116103824}\n\nSome of the most advanced physics-based enemies ever seen in VR, Kaiju walk under their own power and will react realistically to damage. Buildings crumbling and vehicles explode\n\n\ud83e\udd16 Ouch!\n\n{1340881881178570}\n\nDon't worry, I'm ALL RIGHT!\n\n\ud83e\udd16 Everything is a Weapon\n\n{1333064208332548}\n\nI'm sure they all evacuated, right?\n\n\ud83e\udd16 Early Access\n\nThis is early-access experimental prototype, future updates will bring new features, improvements and other cool stuff\n\n{1594825015125807}", "short_description": "Pilot a giant mech and battle mighty Kaiju to the death using fists, plasma cannons and rocket hammers in this ludicrous physics-based combat action game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://twolivesleft.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Two Lives Left", "support_website_url": null, "website_url": "https://twolivesleft.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33862399586739333"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618264_1232683495736044_8225245569381957038_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IYU9DqlqmggQ7kNvwG2Er3Y&_nc_oc=Adm6k-7cxpNj_X9ZAOVRXs22nAxtLwzbaI5kza28UwjkUWhR0WO22kdCpjiohdL1eyk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afujhc7-XJT6ATZdmmQtUcehc4VDE15ThiimxMw6_R97Ew&oe=69A6EE61"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": f
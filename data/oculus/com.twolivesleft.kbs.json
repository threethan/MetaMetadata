RRVdyfHejSxls72keXkmR0iRo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7p65rn8iXr411y_1LxlIIWbwWpJ0VN8Pk-75PzT3VjcA&oe=6A1ED787"}, {"file_name": "Trifold_Screen_Grabs_1.1.6.png", "id": "2068107677387362", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619187_2068107680720695_8300763407503762253_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v6vJyYI0Wo8Q7kNvwE9PJ8I&_nc_oc=AdrQ2HNgooGTTtJOrXxSXe6AtQvAAHPj4l2q6FhmDItXW-kNdvu1q5cxuhrao_DDteQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7JNZpemULeCeaOv-38vwu2IJwiFmBSfxwIOKxKX7A2xA&oe=6A1EFE17"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "promoArt_Landscape_final_v01.png", "id": "1354889856475745", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499297507_1354889859809078_7019410016185870800_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tkH7x1PRkXUQ7kNvwHsjPfm&_nc_oc=AdqQLeuS1zvnOqzllzOG80QwtDVTAuiK-7ga5ihMiHc6S6eosbVkJz0UEpsposUiHQo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4qx1o_wXQ-H-5AjUnZEEP5gLezl-__f9sQNvSOi3SYOA&oe=6A1EE11E"}, "display_name": "Kaiju Battle Simulator", "keywords": ["Kaiju", "Battle", "Physics", "Action", "Mechs"], "long_description": "# \ud83e\udd16 Pilot a Giant Mech\n\nKaiju Battle Simulator is a sandbox beat em\u2019 up experience where you face off against colossal monsters. Test your mettle, using your fists, guns, blades, and powerful mech attachments in this ludicrous physics-based combat action game!\n{867231876386045}\n\n# \ud83e\udd16 Advanced Physics and Destruction\n\nBattle advanced physics-driven enemies built for VR! Kaiju walk under their own power and react dynamically to every hit. Tear through destructible maps as both you and the monsters leave a trail of chaos\n{4231729640423901}\n# \ud83e\udd16 Forge Your Mech\n\nBuild and customize your mech parts and colors. Up your arsenal with attachments & weapons like sawblades, rocket fists and plasma cannons! Choose your loadout and drop in ready for battle.\n{1989062715063833}\n\n# \ud83e\udd16 Calling all Reinforcements!\nNeed backup? Call in the Kaiju Defence Force. From tanks to battleships, bombers, and more, to join the fight against the kaiju. But destroy too much of the city and your allies will turn on you\n{1288880463445505}\n\n\n# \ud83e\udd16 Early Access & Roadmap\nKaiju Battle Simulator is in Early Access and actively evolving. Expect regular updates with new features, content, improvements, and other cool stuff as development continues!\n\n**Join our actively growing Discord community for sneak-peaks, updates, and a chance to help shape the game!**\n\n\n{989810550136797}\n\u201cThe development of KBS has been a wild ride and would not exist if not for the amazing support from our loyal fans!\u201d  - JtM(The Developer)\n\n\n\n\n", "short_description": "Kaiju Battle Simulator is a sandbox beat em\u2019 up experience where you face off against colossal monsters. Test your mettle, using your fists, guns, blades, and powerful mech attachments in this ludicrous physics-based combat action game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.kaijubattlesim.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Two Lives Left", "support_website_url": null, "website_url": "https://twolivesleft.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_play
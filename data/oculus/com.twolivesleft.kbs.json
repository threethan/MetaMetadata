T78eqNhCjoUJIEYoNWaQDPn3oeUK5_7xLI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK7PFeM2SkTbrBYJnwU4jcyqgmI7fX5k-MqFkRtTaCcOg&oe=6AB667E4"}, {"file_name": "gorpin it_1.19.1.png", "id": "1654100265672746", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/507826282_1654100269006079_6269522603563422539_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k7q1pORY8cEQ7kNvwEIXAyf&_nc_oc=Adrq84XTvqkJ9jSMjen7hciMUom_erHxnBxHIx-ST1XWjWAcV_LFVEEs0pWt0FSDcGs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqEz99K0V4z1Xi9L8v3lecdHLMKHC1QlZ1h9bQpZlf0A&oe=6AB68ED2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "499619751_920099577203485_2118469296068269175_n.png", "id": "1452474746746582", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620630_1452474750079915_3747347445512989481_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5vR6WQ81MagQ7kNvwHWsVuw&_nc_oc=Adp_YgkjOgLjhWj5B8dUvrE6uFZrIKVPL6shjWEd6EtuOX2AA1-k6-BpCDPllrWA13c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJThnHWs-Qsh3P2d2FhNhCk4GD9A80QFZOKLRU2sdukdQ&oe=6AB685E4"}, "display_name": "Kaiju Battle Simulator", "keywords": ["Kaiju", "Battle", "Physics", "Action", "Mechs"], "long_description": "# \ud83e\udd16 Pilot a Giant Mech\n\nKaiju Battle Simulator is a sandbox beat em\u2019 up experience where you face off against colossal monsters. Test your mettle, using your fists, guns, blades, and powerful mech attachments in this ludicrous physics-based combat action game!\n{1506182761309601}\n\n# \ud83e\udd16 Advanced Physics and Destruction\n\nBattle advanced physics-driven enemies built for VR! Kaiju walk under their own power and react dynamically to every hit. Tear through destructible maps as both you and the monsters leave a trail of chaos\n{4231729640423901}\n# \ud83e\udd16 Forge Your Mech\n\nBuild and customize your mech parts and colors. Up your arsenal with attachments & weapons like sawblades, rocket fists and plasma cannons! Choose your loadout and drop in ready for battle.\n{1989062715063833}\n\n# \ud83e\udd16 Calling all Reinforcements!\nNeed backup? Call in the Kaiju Defence Force. From tanks to battleships, bombers, and more, to join the fight against the kaiju. But destroy too much of the city and your allies will turn on you\n{1328213756123989}\n\n\n# \ud83e\udd16 Early Access & Roadmap\nKaiju Battle Simulator is in Early Access and actively evolving. Expect regular updates with new features, content, improvements, and other cool stuff as development continues!\n\n**Join our actively growing Discord community for sneak-peaks, updates, and a chance to help shape the game!**\n\n\n{989810550136797}\n\u201cThe development of KBS has been a wild ride and would not exist if not for the amazing support from our loyal fans!\u201d  - JtM(The Developer)\n\n\n\n\n", "short_description": "Kaiju Battle Simulator is a sandbox beat em\u2019 up experience where you face off against colossal monsters. Test your mettle, using your fists, guns, blades, and powerful mech attachments in this ludicrous physics-based combat action game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.kaijubattlesim.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Two Lives Left", "support_website_url": null, "website_url": "https://twolivesleft.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "37874213565557895"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499623345_1584069046661496_4254061030421648428_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HnPaRJ3t02UQ7kNvwHv5BS5&_nc_oc=AdojBfi9-EOqGk7pmF75JUg4Pvmq6n8_tvwMvGgxpSl3LzG-VPRr6CIR2Mta_zsbKdQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLBA3TJWava1nlBZX6ecetQWxWGnhNZH2d5uA0VaDfukg&oe=6AB6742F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Kaiju Battle Simulator", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sandbox", "id": "1990104051447093"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Simulation", "id": "331529188132278"}, {"topic_name": "Fighting", "id": "2710427532541308"}], "release_date": 1724195220, "lastRevision": {"nodes": [{"id": "26221957270783641", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "26221957220783646", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1267324311304169"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "CoverArt_Square.png", "id": "3839846559568563", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974714_3839846562901896_5484261265291050274_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CtcSHUgxzjQQ7kNvwFu9kHI&_nc_oc=Adp_EJh0SisjBtwwU9mqqyHwTJ9wajl48nGGM1B2IhwQ3_oKVVlCLKNzV7lNA0gGdXQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbEfaNxerjxGOmHIEdzOiFeh4ALEwUJY-j9hbSxyz-NQ&oe=6AB687
632\u885b\u8ecd\u306b\u5fdc\u63f4\u3092\u8981\u8acb\u3057\u3088\u3046\u3002\u6226\u8eca\u3084\u6226\u8266\u3001\u7206\u6483\u306a\u3069\u306e\u983c\u3082\u3057\u3044\u8ecd\u52e2\u304c\u3001\u602a\u7363\u3068\u306e\u6226\u3044\u306b\u52a0\u308f\u3063\u3066\u304f\u308c\u308b\u305e\u3002\u305f\u3060\u3057\u3001\u90fd\u5e02\u306e\u58ca\u3057\u3059\u304e\u306b\u306f\u8981\u6ce8\u610f\u3002\u3042\u307e\u308a\u3084\u308a\u3059\u304e\u308b\u3068\u3001\u5473\u65b9\u306b\u9283\u53e3\u3092\u5411\u3051\u3089\u308c\u3066\u3057\u307e\u3046\u305e\u3002\n{1511567977024485}\n\n# \ud83e\udd16 \u65e9\u671f\u30a2\u30af\u30bb\u30b9\uff06\u4eca\u5f8c\u306e\u30ed\u30fc\u30c9\u30de\u30c3\u30d7\n\u73fe\u5728\u306eKaiju Battle Simulator\u306f\u65e9\u671f\u30a2\u30af\u30bb\u30b9\u7248\u3067\u3001\u30a2\u30af\u30c6\u30a3\u30d6\u306b\u9032\u5316\u3092\u7d9a\u3051\u3066\u3044\u308b\u3002\u4eca\u5f8c\u3082\u5b9a\u671f\u7684\u306b\u884c\u308f\u308c\u308b\u30a2\u30c3\u30d7\u30c7\u30fc\u30c8\u3067\u8ffd\u52a0\u3055\u308c\u308b\u65b0\u6a5f\u80fd\u3084\u65b0\u30b3\u30f3\u30c6\u30f3\u30c4\u3001\u6a5f\u80fd\u6539\u5584\u306a\u3069\u306e\u30a4\u30ab\u3057\u305f\u5185\u5bb9\u3092\u304a\u697d\u3057\u307f\u306b\uff01\n\n\u6d3b\u767a\u306b\u6210\u9577\u3059\u308b\u958b\u767a\u8005\u306eDiscord\u30b3\u30df\u30e5\u30cb\u30c6\u30a3\u306b\u53c2\u52a0\u3057\u3066\u3001\u6700\u65b0\u60c5\u5831\u306e\u5148\u884c\u516c\u958b\u3084\u30a2\u30c3\u30d7\u30c7\u30fc\u30c8\u60c5\u5831\u306e\u30c1\u30a7\u30c3\u30af\u3001\u30d5\u30a3\u30fc\u30c9\u30d0\u30c3\u30af\u306b\u3088\u308b\u30b2\u30fc\u30e0\u958b\u767a\u306e\u30b5\u30dd\u30fc\u30c8\u3092\u3057\u3088\u3046\uff01\n\n{1693066765223295}\n\n\u300e\u3053\u306e\u30b2\u30fc\u30e0\u306e\u958b\u767a\u306f\u6ce2\u4e71\u4e07\u4e08\u3067\u3057\u305f\u3002\u30d5\u30a1\u30f3\u306e\u7686\u3055\u3093\u306e\u7d20\u6674\u3089\u3057\u3044\u30b5\u30dd\u30fc\u30c8\u306a\u3057\u306b\u3001\u3053\u306e\u30b2\u30fc\u30e0\u306f\u4e16\u306b\u51fa\u306a\u304b\u3063\u305f\u3067\u3057\u3087\u3046\
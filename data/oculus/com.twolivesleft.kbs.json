}, "id": "1202630755180243", "locale": "en_US", "screenshots": [{"file_name": "KBS_Stills_1.png", "id": "980511574506678", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619808_980511581173344_7207423674585731379_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rTU-LEpaHSkQ7kNvwEjJRxl&_nc_oc=AdrvM4V7bWuxqvr_OqX3zfmMbtjFueq8H1PD4xDOhSAPLymppnQVrnyJQdknhlrtqqE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79kl6I4rCqaB2h-AyaYTexZlHIEgctB4r1I0aV5KRN9g&oe=69FCAE69"}, {"file_name": "KBS_Stills_3_PNG.png", "id": "1294181812081681", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618284_1294181815415014_1570882082867893948_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xXcWbK1OzmQQ7kNvwEIkuBN&_nc_oc=AdqZDj7ZB7I3AwbE1kcphlJgtlu2gEp5hWTzM9EAtetKoJ_FvkCgAsY37Y9nLR_KiVU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7oQNwDt2ZAM30FVcDC9_-SwvJtGbDr3sBccx1_ngfKQw&oe=69FC90CB"}, {"file_name": "KBS_Stills_2_PNG.png", "id": "1706467010771911", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618274_1706467014105244_7858068695088584391_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mqQJpMdZcKAQ7kNvwHqqduL&_nc_oc=AdrPlATaLm0KXLeWD6ZFcMP1unRs01ojCrPN8ZJ_dBagKsiAA5ZOydmTWVQ0F6g-apE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4mpfEpHUI23tvCMxeK9h6cfymm9YUByb0CxQXeZR2bTQ&oe=69FC950E"}, {"file_name": "KBS_Stills_4_PNG.png", "id": "1331878612131995", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617850_1331878615465328_6576108192907805074_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fbpAwL4CVxQQ7kNvwG48fDe&_nc_oc=AdrP74OEke4KXbYieMsUO2frB0V6UHLz96R8uN0VZrS1A3vjpxX8kdegelDv0jpqOP8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5e4geXHU68XPtCoSh6DWoD3fevLuwT81rp_3-vWKSBzA&oe=69FC91F5"}, {"file_name": "KBS_Stills_5_PNG.png", "id": "943829845164542", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618069_943829848497875_6854849106831117999_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9jUYGU-eC2MQ7kNvwHwNjq7&_nc_oc=AdpAPLVMxActkuS5Om4NTCXvNNRM1wH8R_o4wyhq3GitihsOE0stPlE04hdXkdLwnLc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5lsYYI_FXh1pOQ-oGC5FFknFYPGW18_wqhf_QuPhTetQ&oe=69FC80AF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "promoArt_Landscape_final_v01.png", "id": "1354889856475745", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499297507_1354889859809078_7019410016185870800_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ize1v2QUDoQQ7kNvwFsnMwb&_nc_oc=Adof1bqRGM3mx8fuxudb1nNmXDjZmw9szBih1T3zthKoV0IQoj9EPo2hUpjR5sa2UFA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6s5B3NIy0PpXqE_V_CYtyoaiUqp-ZhR3SPuqUD3asXkA&oe=69FC9A1E"}, "display_name": "Kaiju Battle Simulator", "keywords": ["Kaiju", "Battle", "Physics", "Action", "Mechs"], "long_description": "# \ud83e\udd16 Pilot a Giant Mech\n\nKaiju Battle Simulator is a sandbox beat em\u2019 up experience where you face off against colossal monsters. Test your mettle, using your fists, guns, blades, and powerful mech attachments in this ludicrous physics-based combat action game!\n{867231876386045}\n\n# \ud83e\udd16 Advanced Physics and Destruction\n\nBattle advanced physics-driven enemies built for VR! Kaiju walk under their own power and react dynamically to every hit. Tear through destructible maps as both you and the monsters leave a trail of chaos\n{4231729640423901}\n# \ud83e\udd16 Forge Your Mech\n\nBuild and customize your mech parts and colors. Up your arsenal with attachments & weapons like sawblades, rocket fists and plasma cannons! Choose your loadout and drop in ready for battle.\n{1989062715063833}\n\n# \ud83e\udd16 Calling all Reinforcements!\nNeed backup? Call in the Kaiju Defence Force. From tanks to battleships, bombers, and more, to join the fight against the kaiju. But destroy too much of the city and your allies will turn on you\n{1288880463445505}\n\n\n# \ud83e\udd16 Early Access & Roadmap\nKaiju Battle Simulator is in Early Access and actively evolving. Expect regular updates with new features, content, improvements, and other cool stuff as development continues!\n\n**Join our actively growing Discord community for sneak-peaks, updates, and a chance to help shape the game!**\n\n\n{989810550136797}\n\u201cThe development of KBS has been a wild ride and would not exist if not for the amazing support from our loyal fans!\u201d  - JtM(The Developer)\n\n\n\n\n", "short_description": "Kaiju Battle Simulator is a sandbox beat em\u2019 up experience where you face off against colossal monsters. Test your mettle, using your fists, guns, blades, and powerful mech attachments in this ludicrous physics-based combat action game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.kaijubattlesim.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Two Lives Left", "support_website_url": null, "website_url": "https://twolivesleft.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35268897832756161"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618432_896450976738349_8534724269339187671_n.png?stp=dst-png_s360x360&_n
store_1.23.2.png", "id": "1352009126259858", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499623295_1352009129593191_3273661964166776808_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i3zGZ8f7u8YQ7kNvwHTcc1r&_nc_oc=AdprTrxHwcCv4fIYSTeo7DEad5B3v1QzAaOCe_BWMuk5QUwrEJgLGzfU7N2ZPIP2NTU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZEoKyJI__TKK-Q0GWgvEHVO1Urmj6zUqv3YxfpqG8-w&oe=6A6C8DF3"}, {"file_name": "daylight brawl screen shots_1.7.2.png", "id": "1009392981695782", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499313110_1009392985029115_2681527087704604832_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lXvmehH_xZMQ7kNvwHf-CEd&_nc_oc=AdrCR6-1zW486Ht1dXuA5Ab_1jZFiOXG-_mqjjNO4DNs_xBusS1UmzZiq0taTEgJ9l4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAL8-PTdyr_35e03GDpPjPXQ93paLcoOFdrF_u4uU03Ng&oe=6A6C9EEF"}, {"file_name": "Moby_Break_2.28.2.png", "id": "25501794172851100", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/673689288_25501794176184433_1730287630046369143_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ggDKDMyZeNUQ7kNvwHaJROE&_nc_oc=AdpF0YCipP7yQOJZVXsr1tGeqql5rfzdbFPJX68NNqUiY_wqpEdieug6REDLwJarRwQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDuheiKXISJFlypUujHPMbDTR_-OIJSfLqBWbiODnJWSg&oe=6A6C93E4"}, {"file_name": "Orochi_saw_2.57.1.png", "id": "1584703029260152", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619187_1584703032593485_9062598522226540866_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4no3jIMa5hIQ7kNvwF0_ccB&_nc_oc=AdoVbkNB7lkQU_p7ht3m3wKcO9TNrtmJh48NCCv6-o6S3mQ5SzRcPZ8J1XorYJ2R4Y4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB83ylv0Z0cavmY43iEyWk0dYmJn1r5eNm_B6G3kB1YjA&oe=6A6CA007"}, {"file_name": "gorpin it_1.19.1.png", "id": "1654100265672746", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/507826282_1654100269006079_6269522603563422539_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Qs3URQvSP0Q7kNvwHPWv8n&_nc_oc=AdofC9uczjXxaAZzlTBz4n6afBrbhybbJeqTIpFROXLU78u6e1Byzqo-xx69gpnI3T8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCye-aM3W2FY2ZxPDpQv9j-FhtPGHaUogCJ7VjNVY286Q&oe=6A6CBAD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Vorax_V14.png", "id": "1570989861187278", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619805_1570989864520611_40251424796346061_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BKG3O1-oEqQQ7kNvwHTuSMT&_nc_oc=AdrIEy8MLFbwy5-Ny1St6vljyr_Q1rksREwRCBXlKc06uGfC7EQuYmJOy4Xu7riLEUI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDYYghwr2c8eWqF-Xyubruge9dmZUSA7pXgkCAEKb40Ig&oe=6A6CB105"}, "display_name": "Kaiju Battle Simulator", "keywords": ["Kaiju", "Battle", "Physics", "Action", "Mechs"], "long_description": "# \ud83e\udd16 Pilot a Giant Mech\n\nKaiju Battle Simulator is a sandbox beat em\u2019 up experience where you face off against colossal monsters. Test your mettle, using your fists, guns, blades, and powerful mech attachments in this ludicrous physics-based combat action game!\n{1506182761309601}\n\n# \ud83e\udd16 Advanced Physics and Destruction\n\nBattle advanced physics-driven enemies built for VR! Kaiju walk under their own power and react dynamically to every hit. Tear through destructible maps as both you and the monsters leave a trail of chaos\n{4231729640423901}\n# \ud83e\udd16 Forge Your Mech\n\nBuild and customize your mech parts and colors. Up your arsenal with attachments & weapons like sawblades, rocket fists and plasma cannons! Choose your loadout and drop in ready for battle.\n{1989062715063833}\n\n# \ud83e\udd16 Calling all Reinforcements!\nNeed backup? Call in the Kaiju Defence Force. From tanks to battleships, bombers, and more, to join the fight against the kaiju. But destroy too much of the city and your allies will turn on you\n{1328213756123989}\n\n\n# \ud83e\udd16 Early Access & Roadmap\nKaiju Battle Simulator is in Early Access and actively evolving. Expect regular updates with new features, content, improvements, and other cool stuff as development continues!\n\n**Join our actively growing Discord community for sneak-peaks, updates, and a chance to help shape the game!**\n\n\n{989810550136797}\n\u201cThe development of KBS has been a wild ride and would not exist if not for the amazing support from our loyal fans!\u201d  - JtM(The Developer)\n\n\n\n\n", "short_description": "Kaiju Battle Simulator is a sandbox beat em\u2019 up experience where you face off against colossal monsters. Test your mettle, using your fists, guns, blades, and powerful mech attachments in this ludicrous physics-based combat action game!"}, {"images": {"nodes": [{"file_name": "KBS_Logo_Text_Only_Japanese 180x180.png", "id": "4526121077621925", "image_type": "APP_IMG_ICON_FOREGROUND", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619805_4526121080955258_6028134103375509128_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CprzuU5AiP4Q7kNvwEff0i_&_nc_oc=AdrNvbNYyM13_yinnHw5IMh24rIb6n_gOtTl17l37T8EPmqYSbPRvnYGJHTWOpl1dWo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBVX1XVvJgx42CE43Ew2AI0SMWe6-ne3sCgGOY8Jd4RgQ&oe=6A6CAFDA"}, {"file_name": "promoArt_Square_final_v01 180x180.png", "id": "2985700284952055", "image_type": "APP_IMG_ICON_BACKGROUND", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823837_2985700288285388_1842010507031737133_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CPLXIkkRLFsQ7kNvwH4X4mo&_nc_oc=AdolWsJHKotFDRQItM2_3tbv-DhkU3ASltWGaG5aa86Ng1RXrytnvxJlreZG2RBibjM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDFLfqm0rkQHhlFm8_h1e9tzQxAiusZxtAEZXMIi2ucqA&oe=6A6CAACD"}, {"file_name": "layered_icon_composited.png", "id": "2373675123157000", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623345_2373675129823666_4271762290004116189_n.png?_nc_cat=103&ccb=1
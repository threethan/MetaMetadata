"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036671_648685863661787_3096920358156072576_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TEBbejDN0nEQ7kNvwFVVTeo&_nc_oc=AdoOFrTO9lWFGfrAKjFKNbov6so076Cqut_YwtfzdPxVvN_GBJiGiYutI3qOzOHD1to&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af22HxUMyhwZZWKtxpVSmzuQREnjrqfK0l4M6s4zmspVOw&oe=69D265E0"}, {"file_name": "office build 90 2560 x 1440.png", "id": "1251024332433431", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974520_1251024335766764_4635200739085119148_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dnDU-M_HFQMQ7kNvwFDWj1Q&_nc_oc=AdpmpXv5lBS6_GY49tLJO7oRu6xtWlJ8nhtAOYSqq2s-VXwhQg0ZTgfeIiob5iS_JLY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3d9vfBwrvVjAJqSaLQom92ddMBJGLbHwqnC-MZ7np96Q&oe=69D2717E"}, {"file_name": "vr room build 90 2560 x 1440.png", "id": "702154417995674", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974545_702154421329007_1278873116692662506_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VrAzJMyLsvAQ7kNvwHA9Zoo&_nc_oc=Adr8LKaE0Yf-IqWKs6LmHKKa_VfIjNF8o0ZmoyYrOt_C0IwwmgbgK-ObqiLdCls_bSE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af34Q_jyGEdAwwaW7sglP1UI8NYaiv-5Gn88A6-VymGHTg&oe=69D2628D"}, {"file_name": "boss build 90 2560 x 1440.png", "id": "1002711294001170", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974520_1002711297334503_7026414676209736084_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EhQ8pCbpTVYQ7kNvwHzPV0A&_nc_oc=AdrNgV4aapirONNSdMpJpfoTr6IJkAqznoXfG4Pq4GDftX15SSJXBfH9Lju6dzyPnIY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2zpzgzwXULC8GH3D9FAdu5P7OXnpVmf9xH_wrn-9Yg8A&oe=69D269A7"}, {"file_name": "final room 2560 x 1440.png", "id": "450754603860973", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974585_450754607194306_3396184327224578678_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qlTGZv6Pq7wQ7kNvwEeAXZa&_nc_oc=AdqLR8vVPCiIKpCQ8Mtvu5hZhip9FzRf9ys6dd89Va9kRO8jR29cIp4ncI8bjoKX_4k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0XuXMNUHzCNyoHOfrSlhHGdp7SpRRbTJ8SiGDBPEG2ow&oe=69D25B18"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "535391551416483", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75375748_535391554749816_2854941644077308396_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SbNkSG6baUIQ7kNvwGV2MPp&_nc_oc=AdoY6Ciwm06OBss_r44oLO6ufrCSGqcWghNwYzcobm8z54pIFRu20BPLuReGlnJl6Ew&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af24u_TNhkNFNkTT2OlSYZrQmK8-ViUTultxo6L2TcTTEw&oe=69D25FFD"}, "display_name": "Exit Condition One Early Access", "keywords": [], "long_description": "Note: This game is currently in early access. It is fully playable and fun, with around 2 hours of play time. A target of 3-4 hours of playtime and a price of $9.99 is planned for the finished game.\n\nYou awake from cryo in a weird sort of museum. A robot refers to you as a curator and the security system is malfunctioning. Can you get things back to normal and escape? There are no jump scares. The game is designed ground-up for roomscale VR on the Quest, but supports all locomotion modes. Most objects can be interacted with, it fully uses physics, and the hands don't \"ghost out.\"\n\nYou'll need to solve puzzles that include drone navigation, crafting, routing power, rewiring circuits, climbing, physically navigating mazes, and dancing. Some puzzles will have you moving in and out of AR and VR within the game itself. There are four main rooms and the final room is a \"boss level\" that contains the largest variety of puzzles.\n\nThere is still a bit of placeholder art and the story aspects are still in progress. Before purchasing, consider trying the polished demo, which is a single room with about 30 minutes of playtime. Updates can be expected at least twice a month and usually more often than that.\n\nhttps://discord.gg/2NfBumhKQD", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "developer_privacy_policy_url": "https://exitconditions.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Damon Poole", "support_website_url": null, "website_url": "https://exitconditions.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "427622596118426"}}]}, "scheduled_offers": {"count": 16, "nodes": [{"status": "PUBLISHED", "id": "1415132687024958"}, {"status": "PUBLISHED", "id": "916767337371235"}, {"status": "PUBLISHED", "id": "1426499515603771"}, {"status": "PUBLISHED", "id": "2739374122927885"}, {"status": "PUBLISHED", "id": "1308468774035988"}, {"status": "PUBLISHED", "id": "677381124676674"}, {"status": "PUBLISHED", "id": "630953529583727"}, {"status": "PUBLISHED", "id": "2210883735993759"}, {"status": "PUBLISHED", "id": "1131130601512417"}, {"status": "PUBLISHED", "id": "918334267149061"}, {"status": "CANCELLED", "id": "2023249271479048"}, {"status": "CANCELLED", "id": "816646503998188"}, {"status": "PUBLISHED", "id": "1620171495507266"}, {"status": "PUBLISHED", "id": "1556700831529842"}, {"status": "PUBLISHED", "id": "645059734175354"}, {"status": "PUBLISHED", "id": "537899281283186"}]}, "baseline_offer": {"id": "1131130601512417"}
"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036671_648685863661787_3096920358156072576_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xh7u-fFSa8wQ7kNvwHWDqO0&_nc_oc=Adpn2uIa61SXYdNZ4jHwalbysXjA3iCPD4OoeiRXA8xuTHTICcpQpkBM1fAVVIErD2o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1md5LfDTrD9RRp5QReNsZcpo7EZKi07iYvvNFNxS-blQ&oe=69E8CF60"}, {"file_name": "office build 90 2560 x 1440.png", "id": "1251024332433431", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974520_1251024335766764_4635200739085119148_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VLoyZuCGAt0Q7kNvwExKthG&_nc_oc=AdqxEoc73YqEOHliX4hWkbYg0SZiO2a77UH-aJfxVcZfLUgdY91cXTM-PjPV--RkEao&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3H2VR2f1Kt1X9zZX3gr0lJ1EFw2A0gnmbCE_vqoqb5lw&oe=69E8DAFE"}, {"file_name": "vr room build 90 2560 x 1440.png", "id": "702154417995674", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974545_702154421329007_1278873116692662506_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=84NVqaNNX0AQ7kNvwHcJo-4&_nc_oc=AdqDd9-dqT09HJLvLfwnb3Onv-x05UHsqJiGuR6gv3fr3IMo9133hfpJ6InfWGd4D6w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af17XjX-e35dirH-cepFclTcgEuEA8AowrZvfvyGmVqlcg&oe=69E8CC0D"}, {"file_name": "boss build 90 2560 x 1440.png", "id": "1002711294001170", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974520_1002711297334503_7026414676209736084_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2H-usdodKUsQ7kNvwHlEjzO&_nc_oc=AdoFu7CqikM7kShc80FmccQ8ewEfkNcWCs8ioRvxtYMBm9HrbG97F9m2vKIO3VEe010&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0MYdGrokLOirpBJnV6sY5IDgd6p8mgQx9TUEPd6QqCAw&oe=69E8D327"}, {"file_name": "final room 2560 x 1440.png", "id": "450754603860973", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974585_450754607194306_3396184327224578678_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kWUteUG2CxgQ7kNvwE0-EAV&_nc_oc=AdrSqgcV0-fHpjCpmdO2bZNWdoJwIL07uC_v2WVtS9He4UBCcir-ZrhtMUSr5U7YStc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Jt4bYrN1HEBC2HYIFkeoFy-Nezb6iyTFIUZBJyfwkbA&oe=69E8C498"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "535391551416483", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75375748_535391554749816_2854941644077308396_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CbcjjowQwXQQ7kNvwFOpBL7&_nc_oc=AdpW2XM-gzKqCFuipNt8C28KigrQWY4MF_sUR9S7Uecb--e0Z1qB_RKTgmNEaINWJvo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af07VqnfvHivacV_uc9sHKTa-EQYdy5KNRz0obBigYZTGw&oe=69E8C97D"}, "display_name": "Exit Condition One Early Access", "keywords": [], "long_description": "Note: This game is currently in early access. It is fully playable and fun, with around 2 hours of play time. A target of 3-4 hours of playtime and a price of $9.99 is planned for the finished game.\n\nYou awake from cryo in a weird sort of museum. A robot refers to you as a curator and the security system is malfunctioning. Can you get things back to normal and escape? There are no jump scares. The game is designed ground-up for roomscale VR on the Quest, but supports all locomotion modes. Most objects can be interacted with, it fully uses physics, and the hands don't \"ghost out.\"\n\nYou'll need to solve puzzles that include drone navigation, crafting, routing power, rewiring circuits, climbing, physically navigating mazes, and dancing. Some puzzles will have you moving in and out of AR and VR within the game itself. There are four main rooms and the final room is a \"boss level\" that contains the largest variety of puzzles.\n\nThere is still a bit of placeholder art and the story aspects are still in progress. Before purchasing, consider trying the polished demo, which is a single room with about 30 minutes of playtime. Updates can be expected at least twice a month and usually more often than that.\n\nhttps://discord.gg/2NfBumhKQD", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "developer_privacy_policy_url": "https://exitconditions.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Damon Poole", "support_website_url": null, "website_url": "https://exitconditions.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "427622596118426"}}]}, "scheduled_offers": {"count": 16, "nodes": [{"status": "PUBLISHED", "id": "1415132687024958"}, {"status": "PUBLISHED", "id": "916767337371235"}, {"status": "PUBLISHED", "id": "1426499515603771"}, {"status": "PUBLISHED", "id": "2739374122927885"}, {"status": "PUBLISHED", "id": "1308468774035988"}, {"status": "PUBLISHED", "id": "677381124676674"}, {"status": "PUBLISHED", "id": "630953529583727"}, {"status": "PUBLISHED", "id": "2210883735993759"}, {"status": "PUBLISHED", "id": "1131130601512417"}, {"status": "PUBLISHED", "id": "918334267149061"}, {"status": "CANCELLED", "id": "2023249271479048"}, {"status": "CANCELLED", "id": "816646503998188"}, {"status": "PUBLISHED", "id": "1620171495507266"}, {"status": "PUBLISHED", "id": "1556700831529842"}, {"status": "PUBLISHED", "id": "645059734175354"}, {"status": "PUBLISHED", "id": "537899281283186"}]}, "baseline_offer": {"id": "1131130601512417"}
nt-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZThFdANWodBIgaplSZO24mH-YnTILwinYTO_sN8UKPA&oe=6A7C4D42"}, {"file_name": "7_ECO_Remastered_FinalBattle.png", "id": "1233526448448036", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822581_1233526451781369_7479849779421110855_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S3EDtqHNUaMQ7kNvwHmO9zb&_nc_oc=AdrhOJUal_8Bafk9BzdcEoGNiLVKLAfXCW0-YNqwG3LT18_8p9wyXOSRcUDFZY9f84A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQ928k-kIqnSBV5WdZTWHfKzw7HJE59bWat7iJduCfrQ&oe=6A7C6110"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ExitConditionOne_MainCover_w_Captions 2560 x 1440 safe.png", "id": "1215321857033813", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619063_1215321860367146_683015123330448268_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xccIxJxwiaUQ7kNvwG_xh1k&_nc_oc=AdqKvhOyg6ruXhJI9PejLRCv-TpbI2y3qj3b9da0ovk56_ByjFyiucoSqmVMW7TCrlQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFKtO0yxzDNaN4KqS8jci5-XwA0X_YXXiVmn_jVYTOYhw&oe=6A7C4736"}, "display_name": "Escape Room Exit Condition One HD", "keywords": ["escape", "scifi"], "long_description": "You'll need to overcome dozens of puzzling challenges by crafting tools, remote controlling drones, rewiring circuits, climbing, playing Match-3 games, shooting, and even dancing! There's five distinct levels expanding from a small chamber to a cathedral-like boss level.\n{1867939200771207}\nThere are 13 achievements, 4 collectible series, and dancing and match-3 based shooting mini-games unlocked along the way.\n{756005933743740}\nThere's even a chatty robot companion and if that's not enough you can talk to us on **Discord** here: https://discord.gg/hBcfWrezhD\n{2049227882550659}\nPlease note: roomscale mode requires a 3m x 2m guardian.", "short_description": "A roomscale puzzle adventure with escape room bones. Four main levels, a boss level, collectibles and a shooting mini-game. P
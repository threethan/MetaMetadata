nt-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlmvn3gEgcfl3UV73qy8cG2t979R7Qp_66PxyVSiuZ3Q&oe=6A983502"}, {"file_name": "7_ECO_Remastered_FinalBattle.png", "id": "1233526448448036", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822581_1233526451781369_7479849779421110855_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rMQXNwU91BcQ7kNvwFXD2R4&_nc_oc=AdqOrxDu9iGpYgQ8eBukZo0Dspc2nZMbDnkYC9I9xMalCYvWQ_Ms9rbZOzMbU5P-ofA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKAwpSHdB9eUv4Ol28EvhtO_TvbzklTpjT6vqCSfmlYeQ&oe=6A9848D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ExitConditionOne_MainCover_w_Captions 2560 x 1440 safe.png", "id": "1215321857033813", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619063_1215321860367146_683015123330448268_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E22I15274ToQ7kNvwG6jE1o&_nc_oc=AdrV0CpTlT8LYGwQxn4_aOt0wV65l8xiH4Ri7CLlSaMVDsutIzNzLR0vBNYrbmX-118&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIN-omvrsm8jwK-Z-l3VQ0421znVb39KEW-V--ilMvFA&oe=6A986736"}, "display_name": "Escape Room Exit Condition One HD", "keywords": ["escape", "scifi"], "long_description": "You'll need to overcome dozens of puzzling challenges by crafting tools, remote controlling drones, rewiring circuits, climbing, playing Match-3 games, shooting, and even dancing! There's five distinct levels expanding from a small chamber to a cathedral-like boss level.\n{1867939200771207}\nThere are 13 achievements, 4 collectible series, and dancing and match-3 based shooting mini-games unlocked along the way.\n{756005933743740}\nThere's even a chatty robot companion and if that's not enough you can talk to us on **Discord** here: https://discord.gg/hBcfWrezhD\n{2049227882550659}\nPlease note: roomscale mode requires a 3m x 2m guardian.", "short_description": "A roomscale puzzle adventure with escape room bones. Four main levels, a boss level, collectibles and a shooting mini-game. P
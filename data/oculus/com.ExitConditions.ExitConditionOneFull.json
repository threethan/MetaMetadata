oh=00_AfvvYrUAZj56RsTUUmIXmSPp07BLqiClz09vq1-eE7lLWQ&oe=69A04CE0"}, {"file_name": "office build 90 2560 x 1440.png", "id": "1251024332433431", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974520_1251024335766764_4635200739085119148_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y1nCuTryCNcQ7kNvwGs_kzU&_nc_oc=AdmB4mFXoO8vriRPpjVNVO16C0-yvNNAjBwW8NLWOi65l-eTh12hUCO04GuWGyWuguU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvRF-ejPzf4utFqhZ9KZE7lL8cSN9K_JGTvsBvF7rtSZg&oe=69A0587E"}, {"file_name": "vr room build 90 2560 x 1440.png", "id": "702154417995674", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974545_702154421329007_1278873116692662506_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-15M9JAs3_sQ7kNvwH-GQ1j&_nc_oc=AdkBMN8jIdydt_6uFvCL13PGX4JZ4atzbBNvsz_dDn1dEF2MPRkPvrn-CNgBqgS_2KA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvJnDN20stXmriQgDWOq0V_RI4AXLWunrF756yMwS2Y-w&oe=69A0498D"}, {"file_name": "boss build 90 2560 x 1440.png", "id": "1002711294001170", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974520_1002711297334503_7026414676209736084_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TRFGjw0Q87IQ7kNvwFaK8hH&_nc_oc=AdkAr4oaa7G8ymb_9TnRdIhLoX-pvPbJbWMvmwQv5XGgs7erWdPTp9qI9XC0o97Ac3E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfteHz8ENF-A3vNoorJloagW3E5mVkTYRyz-XlaeAZy2Vg&oe=69A050A7"}, {"file_name": "final room 2560 x 1440.png", "id": "450754603860973", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974585_450754607194306_3396184327224578678_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kMBPCcdb7iAQ7kNvwH7wRS4&_nc_oc=Adm9jBtJQfUONFSrFbl-31j0ZcTIHaySY4k-heCJ6x_y0bej7LrhsJIkMzS-QEFc26c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv1o6wKnN8cJNrnSHwKRUhKc4KCGk4bemrOnzZxXCgU-g&oe=69A04218"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "535391551416483", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75375748_535391554749816_2854941644077308396_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cq_McXNYeIAQ7kNvwGnLkfu&_nc_oc=Adm0k0jlyHNLaCoRvgU3lJHGx8uuJ8uG2giJuT1kL0kfxYsVrmEaqnIWhOB9G5uzLyI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu-dhHeLxY1KXd-Wl40pLXvi5qogcFKup14TFToAJ0hkQ&oe=69A046FD"}, "display_name": "Exit Condition One Early Access", "keywords": [], "long_description": "Note: This game is currently in early access. It is fully playable and fun, with around 2 hours of play time. A target of 3-4 hours of playtime and a price of $9.99 is planned for the finished game.\n\nYou awake from cryo in a weird sort of museum. A robot refers to you as a curator and the security system is malfunctioning. Can you get things back to normal and escape? There are no jump scares. The game is designed ground-up for roomscale VR on the Quest, but supports all locomotion modes. Most objects can be interacted with, it fully uses physics, and the hands don't \"ghost out.\"\n\nYou'll need to solve puzzles that include drone navigation, crafting, routing power, rewiring circuits, climbing, physically navigating mazes, and dancing. Some puzzles will have you moving in and out of AR and VR within the game itself. There are four main rooms and the final room is a \"boss level\" that contains the largest variety of puzzles.\n\nThere is still a bit of placeholder art and the story aspects are still in progress. Before purchasing, consider trying the polished demo, which is a single room with about 30 minutes of playtime. Updates can be expected at least twice a month and usually more often than that.\n\nhttps://discord.gg/2NfBumhKQD", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "developer_privacy_policy_url": "https://exitconditions.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Damon Poole", "support_website_url": null, "website_url": "https://exitconditions.com/", "category": "GAMES", "comfort_rating": "
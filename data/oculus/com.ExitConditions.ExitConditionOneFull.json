nt-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_XMeRRvRKHXV8a1V0JDHQ_r1bgkknnA89gmIB5jeRLQ&oe=6ABBCD82"}, {"file_name": "7_ECO_Remastered_FinalBattle.png", "id": "1233526448448036", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822581_1233526451781369_7479849779421110855_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ND1DuAv7Os8Q7kNvwHq8SEq&_nc_oc=AdrT2EUS-muujC53QXZTWY0GFZPXMOgeHhdyI8c7HTDiUNCtI5l3Y4DNXV8tRLUqbqM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnqEMecASRGcMYtpuYHe2TAtF3DIPJICHOCuN-1nsvmg&oe=6ABBE150"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ExitConditionOne_MainCover_w_Captions 2560 x 1440 safe.png", "id": "1215321857033813", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619063_1215321860367146_683015123330448268_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BHdqGdeam-UQ7kNvwFt9E3r&_nc_oc=AdpQGrFVDpZ8BJgGcHlcfbjK7DhTbU7tWXGmTkemsXMkqAy2j0-z7aOwphC94ST6WQo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLMmFRmNSYPC5HNomIG_CF9GV9d7H_fN0sKhQv7dz-6vg&oe=6ABBC776"}, "display_name": "Escape Room Exit Condition One HD", "keywords": ["escape", "scifi", "room", "adventure", "puzzle"], "long_description": "You'll need to overcome dozens of puzzling challenges by crafting tools, remote controlling drones, rewiring circuits, climbing, playing Match-3 games, shooting, and even dancing! There's five distinct levels expanding from a small chamber to a cathedral-like boss level.\n{1867939200771207}\nThere are 13 achievements, 4 collectible series, and dancing and match-3 based shooting mini-games unlocked along the way.\n{756005933743740}\nThere's even a chatty robot companion and if that's not enough you can talk to us on **Discord** here: https://discord.gg/hBcfWrezhD\n{2049227882550659}\nPlease note: roomscale mode requires a 3m x 2m guardian.", "short_description": "A roomscale puzzle adventure with escape room bones. Four main levels, a boss level, collectib
oh=00_Afvei3ZxDRvfEDdlcVOvC0mpqnEpSoJi_FynRbLsT6ofFw&oe=699EFB60"}, {"file_name": "office build 90 2560 x 1440.png", "id": "1251024332433431", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974520_1251024335766764_4635200739085119148_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y1nCuTryCNcQ7kNvwHaPpT4&_nc_oc=AdnFHOaC2dCR_UvTUPtT6y4hKFHY-qmpZ6JgS1C6ZgO7cPNsn_douDlqWBhlq_Fs0U4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvDIwhLHtyc3sn5Gx25a0TXSwWWwulX83LKkd-aDTXSag&oe=699F06FE"}, {"file_name": "vr room build 90 2560 x 1440.png", "id": "702154417995674", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974545_702154421329007_1278873116692662506_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-15M9JAs3_sQ7kNvwHQNb6Y&_nc_oc=Adk0TBS2hI_Qrfc9EmgthJmgbc3a4MdgvknXsoAwUxINiy2PG0KvoCDpoJAVdvNcBo4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsboaYk37qX4mT84e2cUAS5g7VU11LdjO6DDeZuDDOuMg&oe=699EF80D"}, {"file_name": "boss build 90 2560 x 1440.png", "id": "1002711294001170", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974520_1002711297334503_7026414676209736084_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TRFGjw0Q87IQ7kNvwEP07xN&_nc_oc=AdmEj27tKPonBLpYWBONweUMH2Wjcq-ohpb7IoRn4KhZ22T1LMJNm4olm17czfHM6bI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afv1iUvVhA9f48GqDkKSK7XLpBGU7Qxr9Dc0-0tGiKgq4w&oe=699EFF27"}, {"file_name": "final room 2560 x 1440.png", "id": "450754603860973", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974585_450754607194306_3396184327224578678_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aEd5ief0pPQQ7kNvwG9QGJd&_nc_oc=AdmzHmk0GToBSpmquJj1clIj48gWsCjkgp7ewtvsmf1vuUawXjbuWDYbyeMx0xxu5Q4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfveR29r0h81pkFflh-QvBQKk29zuwkKiNmy2hfzIjrUjg&oe=699EF098"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "535391551416483", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75375748_535391554749816_2854941644077308396_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cq_McXNYeIAQ7kNvwHrgWhu&_nc_oc=AdmP5kY-5HhAcl2c1pSSVCJhMBT9RIHpaOKSfhI1FBspPNILEEjfYVN0OfUmwNHq8gY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afsw5-0YKro05vY8z0LMi8rpQ4n8O88od9yaWlqUTE0FTg&oe=699EF57D"}, "display_name": "Exit Condition One Early Access", "keywords": [], "long_description": "Note: This game is currently in early access. It is fully playable and fun, with around 2 hours of play time. A target of 3-4 hours of playtime and a price of $9.99 is planned for the finished game.\n\nYou awake from cryo in a weird sort of museum. A robot refers to you as a curator and the security system is malfunctioning. Can you get things back to normal and escape? There are no jump scares. The game is designed ground-up for roomscale VR on the Quest, but supports all locomotion modes. Most objects can be interacted with, it fully uses physics, and the hands don't \"ghost out.\"\n\nYou'll need to solve puzzles that include drone navigation, crafting, routing power, rewiring circuits, climbing, physically navigating mazes, and dancing. Some puzzles will have you moving in and out of AR and VR within the game itself. There are four main rooms and the final room is a \"boss level\" that contains the largest variety of puzzles.\n\nThere is still a bit of placeholder art and the story aspects are still in progress. Before purchasing, consider trying the polished demo, which is a single room with about 30 minutes of playtime. Updates can be expected at least twice a month and usually more often than that.\n\nhttps://discord.gg/2NfBumhKQD", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "developer_privacy_policy_url": "https://exitconditions.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Damon Poole", "support_website_url": null, "website_url": "https://exitconditions.com/", "category": "GAMES", "comfort_rating": "
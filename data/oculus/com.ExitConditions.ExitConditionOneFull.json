358156072576_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nIyuKxi15GIQ7kNvwGBus6_&_nc_oc=AdkPfXt7s9jMSUlqmr-0-nwi_AKX4OGFZKzjHDySFzLRAX--eaSuS59pxUW8sH38fPU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxybcKCkvhNLsaVNPtEIC_NOWkBrBfo1KUgONKFaNORNg&oe=69B2C1E0"}, {"file_name": "office build 90 2560 x 1440.png", "id": "1251024332433431", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974520_1251024335766764_4635200739085119148_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mAkVdDzug4YQ7kNvwErN7nr&_nc_oc=AdlHkX_z61v9ZhoDYTFBNnqoJb3uxZEkXoXFtNPONOMQFlI9FBHe64uOjQNfVksmCWU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw8-Mlh-lpkOE7wIv4NkHIbOBxPGZSwsej7S04HO63EZg&oe=69B2CD7E"}, {"file_name": "vr room build 90 2560 x 1440.png", "id": "702154417995674", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974545_702154421329007_1278873116692662506_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kpI1MTv_i9wQ7kNvwEOTSd0&_nc_oc=Adn_nHFLKmFjFYdbbulc--J-umUvwoGIIqXtAtU5nei0Jde1Os3kHnnqcQaEOntYW1k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwRCmYyszenDdg9L3cm86B62Sh4ELUes4Qgo4Yt9mse2Q&oe=69B2BE8D"}, {"file_name": "boss build 90 2560 x 1440.png", "id": "1002711294001170", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974520_1002711297334503_7026414676209736084_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LJobpARIATsQ7kNvwFBZUuK&_nc_oc=AdlsCj3DNhzSEEeEiLNRSPdo9U7XHxZ7pfGkmuPHc7Ff_qRFshyUZ_aZRfe8xFFvync&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyoxViN-zUNN7JK-eLJWImyum2B7SO0pD-rPMcAJQkm4Q&oe=69B2C5A7"}, {"file_name": "final room 2560 x 1440.png", "id": "450754603860973", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974585_450754607194306_3396184327224578678_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qsp9jZ-K97kQ7kNvwFFZbg2&_nc_oc=AdljTtxpgTPJRdikCmlfEfeg6AvKPx5XhUYuZRtM9IkxIKgn1Mos21lYprW9NINJNrg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afyq8RJADlG_fH2vqSIGGZqADUuyQ7wFDhW2rFJRH7ERWA&oe=69B2B718"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "535391551416483", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75375748_535391554749816_2854941644077308396_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gGk2YWwEP38Q7kNvwHJqrcc&_nc_oc=AdkaKvDYIojfXRjUubrmyPHrq9HlfzuslMcm4sPBHSNuO1cuLxnSBDh9U0CooCZsF-I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw-OhFyjCZD3VLzomQSNOIy4FixZ1UJgdeY9lQ96MPKIQ&oe=69B2BBFD"}, "display_name": "Exit Condition One Early Access", "keywords": [], "long_description": "Note: This game is currently in early access. It is fully playable and fun, with around 2 hours of play time. A target of 3-4 hours of playtime and a price of $9.99 is planned for the finished game.\n\nYou awake from cryo in a weird sort of museum. A robot refers to you as a curator and the security system is malfunctioning. Can you get things back to normal and escape? There are no jump scares. The game is designed ground-up for roomscale VR on the Quest, but supports all locomotion modes. Most objects can be interacted with, it fully uses physics, and the hands don't \"ghost out.\"\n\nYou'll need to solve puzzles that include drone navigation, crafting, routing power, rewiring circuits, climbing, physically navigating mazes, and dancing. Some puzzles will have you moving in and out of AR and VR within the game itself. There are four main rooms and the final room is a \"boss level\" that contains the largest variety of puzzles.\n\nThere is still a bit of placeholder art and the story aspects are still in progress. Before purchasing, consider trying the polished demo, which is a single room with about 30 minutes of playtime. Updates can be expected at least twice a month and usually more often than that.\n\nhttps://discord.gg/2NfBumhKQD", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "deve
oh=00_Afuz1hURtrm4OOejEFL5ovkRAeM0_0yIrgDMFrvAGoaKCg&oe=69A592E0"}, {"file_name": "office build 90 2560 x 1440.png", "id": "1251024332433431", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974520_1251024335766764_4635200739085119148_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zkf9oAE6SVUQ7kNvwGE2vDK&_nc_oc=AdktWpu6ILljBOsWP4xqFE_iUYUJ6cj29YLmREcGfA5LfbkP4jBSS5LcY-oSAOapeuM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfvGbldsW971xihCRKx84cpJ-hlKgcWHY7-h6cUTXkQIBQ&oe=69A59E7E"}, {"file_name": "vr room build 90 2560 x 1440.png", "id": "702154417995674", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974545_702154421329007_1278873116692662506_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gPxvUgRYt_kQ7kNvwEKY7Jr&_nc_oc=AdklRKFfLg6S5zLz95ive0msYiEaKCmCTjEL5Up_X6YUMMmQUI6ROn-1NEBXiDirAUY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Aft2tRWgFtA27WOWqdJ8izr6DNtcrDCSqiaD6Ztxz5keoA&oe=69A58F8D"}, {"file_name": "boss build 90 2560 x 1440.png", "id": "1002711294001170", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974520_1002711297334503_7026414676209736084_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PqHyInS8kR4Q7kNvwEoxwPE&_nc_oc=AdnxPVqi3UDltiUtF8a88tbxWWVup2AfU4gK4ntmNGG2dltmLYA3dG9j-udLiiF97a0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Afuv_lJ9vFLIk7W-2ts3_I6HOxwmPDOZ6X49MaxxNdJFdw&oe=69A596A7"}, {"file_name": "final room 2560 x 1440.png", "id": "450754603860973", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974585_450754607194306_3396184327224578678_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UrB5m_PUfHoQ7kNvwE1Yo4y&_nc_oc=Adk8PlXiB77crPZcxcxTGAJZHF6unMLrfF_hZPWxVaCef4JXOYS7hD7ulQUL-nYprB0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afso1pUo721HgkAt4ma_PYPjQBb4wACudFqdfzu3VMn9Hw&oe=69A58818"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "535391551416483", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75375748_535391554749816_2854941644077308396_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U8_RavEZ05IQ7kNvwGcqQ2n&_nc_oc=AdnshSd1MNH5eCIDiWfqZAN2Zrf4qkwmfgT1-eVgm1RHv1r6IgDOOAIUecAy6AMAR4I&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfuKXjHRUvcxZeXmoa6YKVWUBnG3PAefQdWTjr0AnS2X8A&oe=69A58CFD"}, "display_name": "Exit Condition One Early Access", "keywords": [], "long_description": "Note: This game is currently in early access. It is fully playable and fun, with around 2 hours of play time. A target of 3-4 hours of playtime and a price of $9.99 is planned for the finished game.\n\nYou awake from cryo in a weird sort of museum. A robot refers to you as a curator and the security system is malfunctioning. Can you get things back to normal and escape? There are no jump scares. The game is designed ground-up for roomscale VR on the Quest, but supports all locomotion modes. Most objects can be interacted with, it fully uses physics, and the hands don't \"ghost out.\"\n\nYou'll need to solve puzzles that include drone navigation, crafting, routing power, rewiring circuits, climbing, physically navigating mazes, and dancing. Some puzzles will have you moving in and out of AR and VR within the game itself. There are four main rooms and the final room is a \"boss level\" that contains the largest variety of puzzles.\n\nThere is still a bit of placeholder art and the story aspects are still in progress. Before purchasing, consider trying the polished demo, which is a single room with about 30 minutes of playtime. Updates can be expected at least twice a month and usually more often than that.\n\nhttps://discord.gg/2NfBumhKQD", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "developer_privacy_policy_url": "https://exitconditions.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Damon Poole", "support_website_url": null, "website_url": "https://exitconditions.com/", "category": "GAMES", "comfort_rating": "
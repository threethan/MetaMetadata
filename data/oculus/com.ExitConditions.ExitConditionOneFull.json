0vTbHix25yc6_EJ9HiiOVtoyODeV_5P_k5bwQ&oe=69B42182"}, {"file_name": "7_ECO_Remastered_FinalBattle.png", "id": "1233526448448036", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822581_1233526451781369_7479849779421110855_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_CfRQy1r2rwQ7kNvwG3pTkA&_nc_oc=AdlRg0q5KfktQjY5lBj9ejVVdkcJ3M_LLotqfcm_vWgYdIq1esZHkju8rbYYaGUP9fw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxt48ZMoxGuSv-jiZudWQUVaz5u6gZNjiJMDYvsGWTo8w&oe=69B3FD10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ExitConditionOne_MainCover_w_Captions 2560 x 1440 safe.png", "id": "1215321857033813", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619063_1215321860367146_683015123330448268_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qd77VylkBzcQ7kNvwGwM3Qh&_nc_oc=Adkwl-OwpBJMOqy6luTuk9MwPw0HME5cLY2m2Ka6kPZajU1MHwoN7Gv3ApZ6sQpHPM8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwQY7nQmQ3cr5ycgJRVHaBj7eKhws4yFYW4Qf8udZfzkA&oe=69B41B76"}, "display_name": "Escape Room Exit Condition One HD", "keywords": ["escape", "scifi"], "long_description": "You'll need to overcome dozens of puzzling challenges by crafting tools, remote controlling drones, rewiring circuits, climbing, playing Match-3 games, shooting, and even dancing! There's five distinct levels expanding from a small chamber to a cathedral-like boss level.\n{1867939200771207}\nThere are 13 achievements, 4 collectible series, and dancing and match-3 based shooting mini-games unlocked along the way.\n{756005933743740}\nThere's even a chatty robot companion and if that's not enough you can talk to us on **Discord** here: https://discord.gg/hBcfWrezhD\n{2049227882550659}\nPlease note: roomscale mode requires a 3m x 2m guardian.", "short_description": "A roomscale puzzle adventure with escape room bones. Four main levels, a boss level, collectibles and a shooting mini-game. Puzzles include wiring, search, match 3, dancing, climbing, d
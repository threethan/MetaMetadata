358156072576_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ARkpAnIip-UQ7kNvwHnmST5&_nc_oc=Adl7LkgzXufeJTM64Frb3RTrcWE6pU1nSuzyj6D4-TlEecqOKP9Huf2g4A8GjIH3FBs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzJg6EXJlzxFkFRhRcy8_fxvhC81Guz_KEXwVCOKiC0pA&oe=69AD7BE0"}, {"file_name": "office build 90 2560 x 1440.png", "id": "1251024332433431", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974520_1251024335766764_4635200739085119148_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VbC8Jq6bWMYQ7kNvwF03NSQ&_nc_oc=Adl81w5zcqrLmfCZKrkjtXkzvbZmVBd14bIsB-5BGtoje-0XR4oXZPYSr2oN0ZN0vjE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwi-gA3ZLMJFzMnvloKENnwGaBQbz2PDFlcE-VkqDXYHw&oe=69AD877E"}, {"file_name": "vr room build 90 2560 x 1440.png", "id": "702154417995674", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974545_702154421329007_1278873116692662506_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f1R1QzMGeQIQ7kNvwGbDQvl&_nc_oc=AdnQiuZ1t0GGVVuft-VT3U2cthD1JqjO8bkt1BOa0bKgjeCyXX8JCCKMxVXAd-VCkGg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzKAMkWEv5IaCqe4Q2zm3GUT49m8J3I0z_QC4dQ0PUMRg&oe=69AD788D"}, {"file_name": "boss build 90 2560 x 1440.png", "id": "1002711294001170", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974520_1002711297334503_7026414676209736084_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t3a7R92l_cAQ7kNvwFLmeqh&_nc_oc=Adn34aNQOGbMgNYWBUzVQ7RSJ_Nln5XU6NrhIbnrIsfBMqat7yLrJOmWeQZqf3L9540&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxXZ57YR5NtD7XV-snjR5gYZVQMtKSAZzScV0ZQg5v0cQ&oe=69AD7FA7"}, {"file_name": "final room 2560 x 1440.png", "id": "450754603860973", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974585_450754607194306_3396184327224578678_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fHkL3pjsEf0Q7kNvwET6Nod&_nc_oc=Adlv9KmJAlqCwzpYiTLKT6JhwknkFXpMpRWS1-jOuzwWJ8NkuRr0mLTGi3Jd1nZVD54&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwLlUj7ek_nxEGqeN2IMrJkBm1oIWSOH6Eu57TfyXKZGA&oe=69AD7118"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "535391551416483", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75375748_535391554749816_2854941644077308396_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gZGpTJzMUgQQ7kNvwF7oxK-&_nc_oc=AdmTLSV5mMgIOiBjDujXQRs-Tj_iE-CxXIG0VkGqGXq_UCswELt_I80CIYyvM8WpcR8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afyt5o936_xlXV1RpG4ft3TSDOx5mu1V8agsASFErYQtVw&oe=69AD75FD"}, "display_name": "Exit Condition One Early Access", "keywords": [], "long_description": "Note: This game is currently in early access. It is fully playable and fun, with around 2 hours of play time. A target of 3-4 hours of playtime and a price of $9.99 is planned for the finished game.\n\nYou awake from cryo in a weird sort of museum. A robot refers to you as a curator and the security system is malfunctioning. Can you get things back to normal and escape? There are no jump scares. The game is designed ground-up for roomscale VR on the Quest, but supports all locomotion modes. Most objects can be interacted with, it fully uses physics, and the hands don't \"ghost out.\"\n\nYou'll need to solve puzzles that include drone navigation, crafting, routing power, rewiring circuits, climbing, physically navigating mazes, and dancing. Some puzzles will have you moving in and out of AR and VR within the game itself. There are four main rooms and the final room is a \"boss level\" that contains the largest variety of puzzles.\n\nThere is still a bit of placeholder art and the story aspects are still in progress. Before purchasing, consider trying the polished demo, which is a single room with about 30 minutes of playtime. Updates can be expected at least twice a month and usually more often than that.\n\nhttps://discord.gg/2NfBumhKQD", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "deve
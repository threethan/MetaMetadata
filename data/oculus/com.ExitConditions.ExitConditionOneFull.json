nt-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8IiNevQhOkLsjxj7JFYuUOJPkuNjWAFXZOcS1L_pIig&oe=6A4FB282"}, {"file_name": "7_ECO_Remastered_FinalBattle.png", "id": "1233526448448036", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822581_1233526451781369_7479849779421110855_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yrmcPBaAljUQ7kNvwH3CGCc&_nc_oc=AdpSdogm8luD7UIQ0XFhprE-A9vnSkVpmdnmEEwHRImEQ_QTrBvEw6zsgGTyB_m813w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBiW9QPnH9DCoCndiNrDKzoHuviBSYy_sKdmdcuLqbnKQ&oe=6A4F8E10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ExitConditionOne_MainCover_w_Captions 2560 x 1440 safe.png", "id": "1215321857033813", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619063_1215321860367146_683015123330448268_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Z4yy7o172YQ7kNvwGHGTRs&_nc_oc=AdoFg2agVax_6FPpPLQ3Bhwg8taFBWawj1-AZHxD_WyAYRIa6RyRl7uB_656Pa7cSlE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBxHNe_elkefFd_EAtoOU9cbn4PrKVLB4BjVo52C5vTA&oe=6A4FAC76"}, "display_name": "Escape Room Exit Condition One HD", "keywords": ["escape", "scifi"], "long_description": "You'll need to overcome dozens of puzzling challenges by crafting tools, remote controlling drones, rewiring circuits, climbing, playing Match-3 games, shooting, and even dancing! There's five distinct levels expanding from a small chamber to a cathedral-like boss level.\n{1867939200771207}\nThere are 13 achievements, 4 collectible series, and dancing and match-3 based shooting mini-games unlocked along the way.\n{756005933743740}\nThere's even a chatty robot companion and if that's not enough you can talk to us on **Discord** here: https://discord.gg/hBcfWrezhD\n{2049227882550659}\nPlease note: roomscale mode requires a 3m x 2m guardian.", "short_description": "A roomscale puzzle adventure with escape room bones. Four main levels, a boss level, collectibles and a shooting mini-game. P
oh=00_AfsaTY69au72Jcg_GRrlj_WsoVkewDwqMRP6SesMnvopQw&oe=699B06E0"}, {"file_name": "office build 90 2560 x 1440.png", "id": "1251024332433431", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974520_1251024335766764_4635200739085119148_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2DUf8bg_TKcQ7kNvwH-ApQ3&_nc_oc=Admki6pxLCvAiAGT3FtBIJ8qEUbPMGhVpwr_35mNb2j-au9ObiQs2EENAl9vUOomHhA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftJ6wqNeF8I3TWaZJkjC793eROr8mYfGVmLexdp_a1hLA&oe=699B127E"}, {"file_name": "vr room build 90 2560 x 1440.png", "id": "702154417995674", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974545_702154421329007_1278873116692662506_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ODfeCEZl5YcQ7kNvwEMa4IW&_nc_oc=Adn8TEqJZwYcREuhEW-v06Bm-Y1IOTAfG8dlYepty2ZaI4zqU_RJsKi9gz21PrP7Fdk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvPucbm3ncYLqJ1hsIpjxv5qMTXLThZr7Si814MsXIhPg&oe=699B038D"}, {"file_name": "boss build 90 2560 x 1440.png", "id": "1002711294001170", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974520_1002711297334503_7026414676209736084_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1fm9LjmgUk4Q7kNvwH9DkKy&_nc_oc=AdnP85s50DWWztBnwdQ4nCHbMfna9Ca4dt8C6Aky7dR5LUKq2RfQSV1hwvSpIeHjgr0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsKpQvf8lIK4r3wyYsd1asmzFVaFqbABVZqbOdPZ7OTrg&oe=699B0AA7"}, {"file_name": "final room 2560 x 1440.png", "id": "450754603860973", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974585_450754607194306_3396184327224578678_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LLkoodM6_8UQ7kNvwHH7366&_nc_oc=AdlOyQEj8jNAEOfeGWFGY87uRSkqB05Bhwwjj9ik8z1-Q1AjP9zqtAS8259mFYFhGak&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfupIyiV2jgGYStmRONWqCddwoE0Irh-cp3vWuCDLVXuRA&oe=699AFC18"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "535391551416483", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75375748_535391554749816_2854941644077308396_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gtOilE9lIWAQ7kNvwF5S_y4&_nc_oc=AdkuE2Bs0oSBiK-eKk095E4Bl5d8YhNrWfHsq3aPbKPBSrNHyDfEfV7vE2B8gGeujXw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afv9rebgsCW9n-qh7Lo7spzFToUxw6lO5-a3Mj63Dp_06g&oe=699B00FD"}, "display_name": "Exit Condition One Early Access", "keywords": [], "long_description": "Note: This game is currently in early access. It is fully playable and fun, with around 2 hours of play time. A target of 3-4 hours of playtime and a price of $9.99 is planned for the finished game.\n\nYou awake from cryo in a weird sort of museum. A robot refers to you as a curator and the security system is malfunctioning. Can you get things back to normal and escape? There are no jump scares. The game is designed ground-up for roomscale VR on the Quest, but supports all locomotion modes. Most objects can be interacted with, it fully uses physics, and the hands don't \"ghost out.\"\n\nYou'll need to solve puzzles that include drone navigation, crafting, routing power, rewiring circuits, climbing, physically navigating mazes, and dancing. Some puzzles will have you moving in and out of AR and VR within the game itself. There are four main rooms and the final room is a \"boss level\" that contains the largest variety of puzzles.\n\nThere is still a bit of placeholder art and the story aspects are still in progress. Before purchasing, consider trying the polished demo, which is a single room with about 30 minutes of playtime. Updates can be expected at least twice a month and usually more often than that.\n\nhttps://discord.gg/2NfBumhKQD", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "developer_privacy_policy_url": "https://exitconditions.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Damon Poole", "support_website_url": null, "website_url": "https://exitconditions.com/", "category": "GAMES", "comfort_rating": "
nt-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzKS7P1CLWK774O5T0kJ3I5kTKykvzgLNjC0ZfIxA3x6A&oe=69C69682"}, {"file_name": "7_ECO_Remastered_FinalBattle.png", "id": "1233526448448036", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491822581_1233526451781369_7479849779421110855_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fXGJaV3tMhMQ7kNvwHjb4u4&_nc_oc=AdqHTI71XHKeybJ8F7RLzsO2_-Q6ThR4l30EF8Re_6oJrqhp23boy01G6PjwL6cgOdQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwuOV9mgYZ_kPLnCJhMfMexHEpJxyX6TnWQTWO6dtT2Mg&oe=69C67210"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ExitConditionOne_MainCover_w_Captions 2560 x 1440 safe.png", "id": "1215321857033813", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619063_1215321860367146_683015123330448268_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=beXhk0_UdooQ7kNvwHFOO1Y&_nc_oc=Ado-Gb_0FvHUjT2OhAHl6wU0QGeVcuDtYA80MAwcCC_GQ57Pqz8A4oTahjxk2jlOwEc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxAHzxpOwNh16fixS8eazOr47i1q3y_cPf8LoFR7DZIpg&oe=69C69076"}, "display_name": "Escape Room Exit Condition One HD", "keywords": ["escape", "scifi"], "long_description": "You'll need to overcome dozens of puzzling challenges by crafting tools, remote controlling drones, rewiring circuits, climbing, playing Match-3 games, shooting, and even dancing! There's five distinct levels expanding from a small chamber to a cathedral-like boss level.\n{1867939200771207}\nThere are 13 achievements, 4 collectible series, and dancing and match-3 based shooting mini-games unlocked along the way.\n{756005933743740}\nThere's even a chatty robot companion and if that's not enough you can talk to us on **Discord** here: https://discord.gg/hBcfWrezhD\n{2049227882550659}\nPlease note: roomscale mode requires a 3m x 2m guardian.", "short_description": "A roomscale puzzle adventure with escape room bones. Four main levels, a boss level, collectibles and a shooting mini-game. P
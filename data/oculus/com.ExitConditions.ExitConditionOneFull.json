oh=00_AfstQFr9_Yah2ocalt4Ddh0DNIO3wsQSH_jExdvTIl5rSQ&oe=699DA9E0"}, {"file_name": "office build 90 2560 x 1440.png", "id": "1251024332433431", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974520_1251024335766764_4635200739085119148_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2DUf8bg_TKcQ7kNvwGXQaPT&_nc_oc=AdnXwhHK0kGAC4l0hlsj_sPFggtXJlQKaesi3Hou_MKy7pcSPB2I50aECpeJILvtRhA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvTFpiER3HbS8Iv7I6-of0bSosxh85DqL87t6HA_bnaOA&oe=699DB57E"}, {"file_name": "vr room build 90 2560 x 1440.png", "id": "702154417995674", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974545_702154421329007_1278873116692662506_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-15M9JAs3_sQ7kNvwFgiFW8&_nc_oc=AdmSMHYWWdXDB4f4uQ0V-urd5ybBT5QijLYGucyMDGJa3TGGLdpJxMi_vssiZ5oCLLA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuPQJcp7Z7Nvu0rJcEptNwia7bhOhf1gIYWJEWuM_qAjA&oe=699DA68D"}, {"file_name": "boss build 90 2560 x 1440.png", "id": "1002711294001170", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974520_1002711297334503_7026414676209736084_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TRFGjw0Q87IQ7kNvwH2jbjY&_nc_oc=AdmRQpF-UF9oTaRkt__TYXhCoAe0m4y2_8JTQfIiQmsExqPTJoq5AKaemMXqIB_5jSg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsRLneR8oyQm7Hp-6s3Pu0dKcv-xevu5svgbeLiCbAUzQ&oe=699DADA7"}, {"file_name": "final room 2560 x 1440.png", "id": "450754603860973", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974585_450754607194306_3396184327224578678_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aEd5ief0pPQQ7kNvwFpjsmh&_nc_oc=Adk2YWEkByE4smFwVX4CYDLIY2JlsmHmfrYzncIUtEDb2gHgWb0L5KPqbiFNmhqmePQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs8fcjjY8TUYgMg2LSa_sT93B0SXmbuxwn0K7IECJ_Ujw&oe=699D9F18"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "535391551416483", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75375748_535391554749816_2854941644077308396_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cq_McXNYeIAQ7kNvwGR4LlR&_nc_oc=AdncIIKi2t1PtZlFYnuZ2WSU7LLbLdujo9aSUVymLujUOrzYjIVL1rBPBJqeaZXXYJI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfssuzB5t7Z1TSyyE8FY7H0hzERWzmDsGpgO_cqoLVkRCg&oe=699DA3FD"}, "display_name": "Exit Condition One Early Access", "keywords": [], "long_description": "Note: This game is currently in early access. It is fully playable and fun, with around 2 hours of play time. A target of 3-4 hours of playtime and a price of $9.99 is planned for the finished game.\n\nYou awake from cryo in a weird sort of museum. A robot refers to you as a curator and the security system is malfunctioning. Can you get things back to normal and escape? There are no jump scares. The game is designed ground-up for roomscale VR on the Quest, but supports all locomotion modes. Most objects can be interacted with, it fully uses physics, and the hands don't \"ghost out.\"\n\nYou'll need to solve puzzles that include drone navigation, crafting, routing power, rewiring circuits, climbing, physically navigating mazes, and dancing. Some puzzles will have you moving in and out of AR and VR within the game itself. There are four main rooms and the final room is a \"boss level\" that contains the largest variety of puzzles.\n\nThere is still a bit of placeholder art and the story aspects are still in progress. Before purchasing, consider trying the polished demo, which is a single room with about 30 minutes of playtime. Updates can be expected at least twice a month and usually more often than that.\n\nhttps://discord.gg/2NfBumhKQD", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "developer_privacy_policy_url": "https://exitconditions.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Damon Poole", "support_website_url": null, "website_url": "https://exitconditions.com/", "category": "GAMES", "comfort_rating": "
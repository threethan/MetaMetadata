nt-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7qUrMvngy4ByO_kVsSx6dQZ89SxqgucACeZqdQg2ebIA&oe=69FCA402"}, {"file_name": "7_ECO_Remastered_FinalBattle.png", "id": "1233526448448036", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822581_1233526451781369_7479849779421110855_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nP0rMn8CMtUQ7kNvwEN5EnC&_nc_oc=AdqeByH3TZi2AEY0M02zbzGH81L8V589iDqIBqPUbvRDeDEqyaEz-BrCpzL2wYpmYjo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af59UEQceCJCv4kTYmy3VXQJLIiUxowEV3irzMVA-ro5jQ&oe=69FC7F90"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ExitConditionOne_MainCover_w_Captions 2560 x 1440 safe.png", "id": "1215321857033813", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619063_1215321860367146_683015123330448268_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3k1tWtG-ZBQQ7kNvwEw3xA-&_nc_oc=AdoR67spqFVtIA-aaDURfysbWEwPG72jfdR0jUknGF7HnT_iSKAYUnaw_Wd5AlnQ63k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6dESZHbGrAJRIXWm7hG8nrQAbTgaBumIXXsh85hJgvLw&oe=69FC9DF6"}, "display_name": "Escape Room Exit Condition One HD", "keywords": ["escape", "scifi"], "long_description": "You'll need to overcome dozens of puzzling challenges by crafting tools, remote controlling drones, rewiring circuits, climbing, playing Match-3 games, shooting, and even dancing! There's five distinct levels expanding from a small chamber to a cathedral-like boss level.\n{1867939200771207}\nThere are 13 achievements, 4 collectible series, and dancing and match-3 based shooting mini-games unlocked along the way.\n{756005933743740}\nThere's even a chatty robot companion and if that's not enough you can talk to us on **Discord** here: https://discord.gg/hBcfWrezhD\n{2049227882550659}\nPlease note: roomscale mode requires a 3m x 2m guardian.", "short_description": "A roomscale puzzle adventure with escape room bones. Four main levels, a boss level, collectibles and a shooting mini-game. P
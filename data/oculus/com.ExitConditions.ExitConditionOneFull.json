358156072576_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g0Us-dVhBLcQ7kNvwFzZZH-&_nc_oc=Adk4R5yZnH4dNJxcJ0bNwTqq4GLP4Zja4pIrr7XK80wNkPv6z0XsGTc3JM5ZATTUpjs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy04oj3GYEYDwEObyrVDZzozi1QdAxzWttykQ9I15mZUg&oe=69BAAAE0"}, {"file_name": "office build 90 2560 x 1440.png", "id": "1251024332433431", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974520_1251024335766764_4635200739085119148_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8nxsBtkMuK8Q7kNvwG4U6Bk&_nc_oc=Adlv1hqd-nKMH5nam9G8Vpbxmm4BnEsEtaN--ipRgrAhBS9CzVQGAlC9YCQu3J6oz2c&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afw4GeMhcWSRKLs9-nJh4eyrE94XmwE0wate_6Yhrv2VNA&oe=69BAB67E"}, {"file_name": "vr room build 90 2560 x 1440.png", "id": "702154417995674", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974545_702154421329007_1278873116692662506_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ulnx9AY7bLoQ7kNvwHpCZ0S&_nc_oc=Adk1DXKXAFdQ0s_Fl7speqw4VFKp4js1rZhU5Iff_2GqwhkiKv2WNQBlREcN2XNT3uk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz74J5xAA_hSyovdR9QouoGwdap8Ei4jY21lihrp2ueuw&oe=69BAA78D"}, {"file_name": "boss build 90 2560 x 1440.png", "id": "1002711294001170", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974520_1002711297334503_7026414676209736084_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v5ljMr-9FYMQ7kNvwE_4NoC&_nc_oc=Adlnbn8nCVYkf8VCLjhiyCBBK8wRX4-WWLIVaJZjk9llG4XE1OnsMVDw8AHngZM0uNg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx-qMYHXN6zEiF4iVKDpoqNI8afSTaPH8K_9OQihq0URw&oe=69BAAEA7"}, {"file_name": "final room 2560 x 1440.png", "id": "450754603860973", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974585_450754607194306_3396184327224578678_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rZbJOvBRJ9EQ7kNvwFJOAPY&_nc_oc=AdnVJGSjdWlooHgGkDDPyjGcIMDjnmwYsd2l20HCIMq5q0bwfv4DKFDPcxddT8eOiOg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxDi8bDhZqup96usEfiffJ-L1oZcgHuwPlAlHXojmHOYA&oe=69BAA018"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "535391551416483", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75375748_535391554749816_2854941644077308396_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mabuSZwMpK0Q7kNvwHqhVdi&_nc_oc=AdkVsrTfUwytnaia5K-dTZ5Livb4rK-TdsiXv_Qcg3Q88DGRGSmee4d3ZT_PuROSyZo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxZDBbqsHfg-YZIgCVS1jhh8DJMTlwZCFURCAnx7u4yVg&oe=69BAA4FD"}, "display_name": "Exit Condition One Early Access", "keywords": [], "long_description": "Note: This game is currently in early access. It is fully playable and fun, with around 2 hours of play time. A target of 3-4 hours of playtime and a price of $9.99 is planned for the finished game.\n\nYou awake from cryo in a weird sort of museum. A robot refers to you as a curator and the security system is malfunctioning. Can you get things back to normal and escape? There are no jump scares. The game is designed ground-up for roomscale VR on the Quest, but supports all locomotion modes. Most objects can be interacted with, it fully uses physics, and the hands don't \"ghost out.\"\n\nYou'll need to solve puzzles that include drone navigation, crafting, routing power, rewiring circuits, climbing, physically navigating mazes, and dancing. Some puzzles will have you moving in and out of AR and VR within the game itself. There are four main rooms and the final room is a \"boss level\" that contains the largest variety of puzzles.\n\nThere is still a bit of placeholder art and the story aspects are still in progress. Before purchasing, consider trying the polished demo, which is a single room with about 30 minutes of playtime. Updates can be expected at least twice a month and usually more often than that.\n\nhttps://discord.gg/2NfBumhKQD", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "deve
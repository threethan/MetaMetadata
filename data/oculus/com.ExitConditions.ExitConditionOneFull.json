nt-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCbqWqR6e6nj1ZRTp00nJOJvzVjt0cRtFdhE9Eqm14yFw&oe=6A676D82"}, {"file_name": "7_ECO_Remastered_FinalBattle.png", "id": "1233526448448036", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822581_1233526451781369_7479849779421110855_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_9vjNttGraEQ7kNvwGHsd9E&_nc_oc=AdpjRqp3a_WzavMN78i9eJPWSNvTCXPcTQrwta94uBHus2a6qxPQwtQQwnfTuBKb8tI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAn-R-JNvPMAA9vsClflPADD8fUmWE_cGZTurclO5LtVQ&oe=6A674910"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ExitConditionOne_MainCover_w_Captions 2560 x 1440 safe.png", "id": "1215321857033813", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619063_1215321860367146_683015123330448268_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JKw0ZzXKhPgQ7kNvwGzA3QM&_nc_oc=Adp61Py9e-cllL2CYGUhwQWj8T9w1JtLS_3SqTodtHNDmMLFzBxRJ8PMyu8bxThAvrY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCPCnrx32XZtCBQkY2NU_CJXtqdRM22-nz3yvHafM6bvQ&oe=6A676776"}, "display_name": "Escape Room Exit Condition One HD", "keywords": ["escape", "scifi"], "long_description": "You'll need to overcome dozens of puzzling challenges by crafting tools, remote controlling drones, rewiring circuits, climbing, playing Match-3 games, shooting, and even dancing! There's five distinct levels expanding from a small chamber to a cathedral-like boss level.\n{1867939200771207}\nThere are 13 achievements, 4 collectible series, and dancing and match-3 based shooting mini-games unlocked along the way.\n{756005933743740}\nThere's even a chatty robot companion and if that's not enough you can talk to us on **Discord** here: https://discord.gg/hBcfWrezhD\n{2049227882550659}\nPlease note: roomscale mode requires a 3m x 2m guardian.", "short_description": "A roomscale puzzle adventure with escape room bones. Four main levels, a boss level, collectibles and a shooting mini-game. P
358156072576_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a-tnplSxapEQ7kNvwFAgh4y&_nc_oc=AdmWv_f9KNoW2cSNCsHQyl_MOwKkxll1O-dRJFUDBIa29i2Pl2sfYmZxRk6BQOThwSw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afv5TJ1lDUGEhowxuAMUewfIRnxNVuu0jU4epuHjjTdhfg&oe=69A98760"}, {"file_name": "office build 90 2560 x 1440.png", "id": "1251024332433431", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974520_1251024335766764_4635200739085119148_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7D_inSBV4ngQ7kNvwFRR670&_nc_oc=Adk67LVFfsRH_YY4xdzuaX2IRg5FzTq3MLmd7GBlPbLR0F7gjkng89jdv9KqPsCntnc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftAzF2E1gVs72Y_reyWe6RT18EmCr2OnjWpaGZTS3rEJA&oe=69A992FE"}, {"file_name": "vr room build 90 2560 x 1440.png", "id": "702154417995674", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974545_702154421329007_1278873116692662506_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LvYg8haSKtUQ7kNvwGHq4bL&_nc_oc=AdkooslYCNA8zb4Aeol3YOU4wx-5xdT0RBeHde6ez214cyjAwYcIF0sBy2iBImtNIPs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsjIOWiuWHYUXONSk5Y9RNptfhxJAOCq2e2kfuXbX76fg&oe=69A9840D"}, {"file_name": "boss build 90 2560 x 1440.png", "id": "1002711294001170", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974520_1002711297334503_7026414676209736084_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QDXzhx1WtFcQ7kNvwHJcFKF&_nc_oc=Adm39Eca3k7Tkyy5FzEAWcGNdQ05AGI6jYSvIyN4tmjeoe0Ccw1GdXzsMuGW2j66MUQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afv8wmgo6mBJjNxId1uAnVAGJc-0At_MZwWrn7d3LxG1jA&oe=69A98B27"}, {"file_name": "final room 2560 x 1440.png", "id": "450754603860973", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974585_450754607194306_3396184327224578678_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aU4tESZQStMQ7kNvwFrk2Yk&_nc_oc=AdlNeEksSIqPgLUwwocLUYiyCjgV9zK0UjqylCE6F97UuCndL_jEQEzQbpYD_CwInRE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuBehi5tTxsFb9fi9xt8krHsYaanHYYVk561uEOTaNgWw&oe=69A97C98"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "535391551416483", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75375748_535391554749816_2854941644077308396_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rCQuzc224ZkQ7kNvwG8LF2w&_nc_oc=Adncsu1_xi2EdLL29AFqzjr1aMtuvNfboJLDFwtZlGwG32RYEPbFigH36qNUNj9AzYw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Aft_nUlZ1DBzxZr9m7D4aJ3u0uWeEUsar4oStQjZPrKhqw&oe=69A9817D"}, "display_name": "Exit Condition One Early Access", "keywords": [], "long_description": "Note: This game is currently in early access. It is fully playable and fun, with around 2 hours of play time. A target of 3-4 hours of playtime and a price of $9.99 is planned for the finished game.\n\nYou awake from cryo in a weird sort of museum. A robot refers to you as a curator and the security system is malfunctioning. Can you get things back to normal and escape? There are no jump scares. The game is designed ground-up for roomscale VR on the Quest, but supports all locomotion modes. Most objects can be interacted with, it fully uses physics, and the hands don't \"ghost out.\"\n\nYou'll need to solve puzzles that include drone navigation, crafting, routing power, rewiring circuits, climbing, physically navigating mazes, and dancing. Some puzzles will have you moving in and out of AR and VR within the game itself. There are four main rooms and the final room is a \"boss level\" that contains the largest variety of puzzles.\n\nThere is still a bit of placeholder art and the story aspects are still in progress. Before purchasing, consider trying the polished demo, which is a single room with about 30 minutes of playtime. Updates can be expected at least twice a month and usually more often than that.\n\nhttps://discord.gg/2NfBumhKQD", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "deve
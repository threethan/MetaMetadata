nt-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMWkYyrvCVRBnszxf8SaS2SY0H4r6tMWRYOx-QeRq7FzA&oe=6AC65982"}, {"file_name": "7_ECO_Remastered_FinalBattle.png", "id": "1233526448448036", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822581_1233526451781369_7479849779421110855_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wq9gAeH2FWkQ7kNvwFI3jgq&_nc_oc=AdqLt0b_WKlN5ZLO26FT8Q7WYunzyFcllCRcdiQ1IOxqLsERg267UGq2LDHiycca9so&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOgrzeVI_eKI6xP7wYJ9SNRFkEF1aAVd2YAg6ScqRQ6dw&oe=6AC66D50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ExitConditionOne_MainCover_w_Captions 2560 x 1440 safe.png", "id": "1215321857033813", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619063_1215321860367146_683015123330448268_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r70DRtAUjSgQ7kNvwFxkO-m&_nc_oc=AdoFM173vTg9CEfhbXuLPcl7fumEVPTmetxEWu1_7i4aqOcGssmVhA3Vq3r-FT1BV3k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZTrjd6Ni6IpITXW6MXv5TW8FOSC-lAf9r-fIyWvEUcQ&oe=6AC65376"}, "display_name": "Escape Room Exit Condition One HD", "keywords": ["escape", "scifi", "room", "adventure", "puzzle"], "long_description": "You'll need to overcome dozens of puzzling challenges by crafting tools, remote controlling drones, rewiring circuits, climbing, playing Match-3 games, shooting, and even dancing! There's five distinct levels expanding from a small chamber to a cathedral-like boss level.\n{1867939200771207}\nThere are 13 achievements, 4 collectible series, and dancing and match-3 based shooting mini-games unlocked along the way.\n{756005933743740}\nThere's even a chatty robot companion and if that's not enough you can talk to us on **Discord** here: https://discord.gg/hBcfWrezhD\n{2049227882550659}\nPlease note: roomscale mode requires a 3m x 2m guardian.", "short_description": "A roomscale puzzle adventure with escape room bones. Four main levels, a boss level, collectib
358156072576_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oh5ptCrF7wYQ7kNvwGqyLxM&_nc_oc=AdnsKwr5KxX0eaOTpxGTsbrjNgLFMGxppRugWSFke7LvK81l-4noLPWcAfDOEuLpiyo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy0nB3yYib75XFGWtPhfudqbrfNe1wiV75g34TQeFy-8w&oe=69B95960"}, {"file_name": "office build 90 2560 x 1440.png", "id": "1251024332433431", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974520_1251024335766764_4635200739085119148_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gNGFRBvXL7gQ7kNvwH8njRa&_nc_oc=AdlUkeqLRmrcw04NgE59zqvEk2BaOY1FnxQE7N5SifNMppl7ZJcbQyCWc_ejebJVv0M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afzic9Pgz6KflT85gelDqCtF3ss5bdZzRSGHq1DcEXQsMw&oe=69B964FE"}, {"file_name": "vr room build 90 2560 x 1440.png", "id": "702154417995674", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974545_702154421329007_1278873116692662506_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ulnx9AY7bLoQ7kNvwGxoAKx&_nc_oc=AdkJbsPoNm5_Gn2J7whAFM_d9EqVHRFy--B7f7rQD3tifdP7Mc-Z5WWuW-melay4Xd0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxbh40KA1FrO0oemkRNX85gs5aEgYVH4qoajKhiaDGOVg&oe=69B9560D"}, {"file_name": "boss build 90 2560 x 1440.png", "id": "1002711294001170", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974520_1002711297334503_7026414676209736084_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v5ljMr-9FYMQ7kNvwGk2zBK&_nc_oc=Admg5nCcoG36dKK7DbBEGamVfJDXrutMPD8JoGgFUPjUa8tFUuqPXVQYJ2bgO7jQlyQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzFA9a9hxJw357gIsdlGel_TJaVjPpETS7NbInarICSvA&oe=69B95D27"}, {"file_name": "final room 2560 x 1440.png", "id": "450754603860973", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974585_450754607194306_3396184327224578678_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rZbJOvBRJ9EQ7kNvwFpJ0aV&_nc_oc=AdkIf0L0jSch0PIHZa9xuWMqpaMc5BZ1spxwfvKh-Q2K_pbRCGLemYUjLhXBQ9oS5nA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzI585sxe-ZV2V6E-ZmgqULcVinh9qa4WGEUl16w8shEA&oe=69B94E98"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "535391551416483", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75375748_535391554749816_2854941644077308396_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mabuSZwMpK0Q7kNvwG1ngVd&_nc_oc=AdlC3UuvWquxig71tkYbNCy06_4bEFom-vr995Kjv5gwBLqVlw1gKix24mhntwkqEAY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzxW4fsZtprYjyr1qtUk4DnMKBooourNLgDooDW4tQq5Q&oe=69B9537D"}, "display_name": "Exit Condition One Early Access", "keywords": [], "long_description": "Note: This game is currently in early access. It is fully playable and fun, with around 2 hours of play time. A target of 3-4 hours of playtime and a price of $9.99 is planned for the finished game.\n\nYou awake from cryo in a weird sort of museum. A robot refers to you as a curator and the security system is malfunctioning. Can you get things back to normal and escape? There are no jump scares. The game is designed ground-up for roomscale VR on the Quest, but supports all locomotion modes. Most objects can be interacted with, it fully uses physics, and the hands don't \"ghost out.\"\n\nYou'll need to solve puzzles that include drone navigation, crafting, routing power, rewiring circuits, climbing, physically navigating mazes, and dancing. Some puzzles will have you moving in and out of AR and VR within the game itself. There are four main rooms and the final room is a \"boss level\" that contains the largest variety of puzzles.\n\nThere is still a bit of placeholder art and the story aspects are still in progress. Before purchasing, consider trying the polished demo, which is a single room with about 30 minutes of playtime. Updates can be expected at least twice a month and usually more often than that.\n\nhttps://discord.gg/2NfBumhKQD", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "deve
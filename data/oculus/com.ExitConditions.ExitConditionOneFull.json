scdn.com&oh=00_AftrV0yGMXB7ySZGIZCsDVuoqgmDsMMLnApXQw7MOnc8hQ&oe=69A6E460"}, {"file_name": "office build 90 2560 x 1440.png", "id": "1251024332433431", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974520_1251024335766764_4635200739085119148_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7D_inSBV4ngQ7kNvwHVUFQ6&_nc_oc=Adn6RIzxnuIgjlKMe12nlQKXWCMPd2ZssAAwJ7zUdEQ0v7YkIuV6J0SJR-UIfd3W0kA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftxXRQ71o7pM74-n2cJc8sVHHzwpwUBMXROAIqOwonUyw&oe=69A6EFFE"}, {"file_name": "vr room build 90 2560 x 1440.png", "id": "702154417995674", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974545_702154421329007_1278873116692662506_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gPxvUgRYt_kQ7kNvwGxIf7w&_nc_oc=Adk-7fvQ9SRSGVbXKUi7_HwNeiOmRhOsB0AHFEmKj7rCg3HFzEycwv5Af6qQFHuBVAU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu5iDJ1SNfDHxPHEuwfDToKXQKaEMaMqEyAYk3cS4Ytsg&oe=69A6E10D"}, {"file_name": "boss build 90 2560 x 1440.png", "id": "1002711294001170", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974520_1002711297334503_7026414676209736084_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PqHyInS8kR4Q7kNvwHJtHb7&_nc_oc=AdmPorsdlXohQKq39PYAh8meFBNprYMwJee6y6MjGjfruCl6xD6QRv6UySlJ7JqevSc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu9N1yZ7c9IMBUpvZhyk79Ky9kqJq0VDMqjHylLHWctzg&oe=69A6E827"}, {"file_name": "final room 2560 x 1440.png", "id": "450754603860973", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974585_450754607194306_3396184327224578678_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UrB5m_PUfHoQ7kNvwHMDOKf&_nc_oc=Admje8cIjJdhYfcmFxsC1ZG_5ZlzgTMqh-XklZ6Kld2_-_FmSvRpPtyE-OoYJO4Wpw0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvDi8YuTO2hRLbOx18Fm1Hl4pQIgK6wsqxpeEk0Yv_RKQ&oe=69A6D998"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "535391551416483", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75375748_535391554749816_2854941644077308396_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U8_RavEZ05IQ7kNvwEFFS68&_nc_oc=Adk4ng38AjKyLzkZQ0VT7vf9ZR0ZQxnJbjzFv3TXqC9RWQtlYoWH6UJbw6ZbmlqyD5A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuoqBXo5oP6BiKW9di3AzAgpcQTfPHLpaj8CnatRzGenA&oe=69A6DE7D"}, "display_name": "Exit Condition One Early Access", "keywords": [], "long_description": "Note: This game is currently in early access. It is fully playable and fun, with around 2 hours of play time. A target of 3-4 hours of playtime and a price of $9.99 is planned for the finished game.\n\nYou awake from cryo in a weird sort of museum. A robot refers to you as a curator and the security system is malfunctioning. Can you get things back to normal and escape? There are no jump scares. The game is designed ground-up for roomscale VR on the Quest, but supports all locomotion modes. Most objects can be interacted with, it fully uses physics, and the hands don't \"ghost out.\"\n\nYou'll need to solve puzzles that include drone navigation, crafting, routing power, rewiring circuits, climbing, physically navigating mazes, and dancing. Some puzzles will have you moving in and out of AR and VR within the game itself. There are four main rooms and the final room is a \"boss level\" that contains the largest variety of puzzles.\n\nThere is still a bit of placeholder art and the story aspects are still in progress. Before purchasing, consider trying the polished demo, which is a single room with about 30 minutes of playtime. Updates can be expected at least twice a month and usually more often than that.\n\nhttps://discord.gg/2NfBumhKQD", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "developer_privacy_policy_url": "https://exitconditions.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Damon Poole", "support_website_url": null, "website_url": "https://exitconditions.com/", "category": "GAMES", "comfort_r
oh=00_AfuS8A8VDNabCB7kcRXUpzv3Ew_pMvkBXIOje_oXOsO_dA&oe=6999B560"}, {"file_name": "office build 90 2560 x 1440.png", "id": "1251024332433431", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974520_1251024335766764_4635200739085119148_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TsQbBLNkQNoQ7kNvwGcQon0&_nc_oc=AdmlZdVlk8-0afeVhdRvPwueoTvIe7FrJnBdjB6hEhyJJToGZDpQe7fG3V6aH7o1UkE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvL3boX-N9fKy8nVRoyBMUm4cBd3Bvz_qcaKHABmg_K4Q&oe=6999C0FE"}, {"file_name": "vr room build 90 2560 x 1440.png", "id": "702154417995674", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974545_702154421329007_1278873116692662506_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ODfeCEZl5YcQ7kNvwFC2Q3m&_nc_oc=Adly4bmZ6ADC8ovWHkfl2IvfIeidccaYHvkCfOBcPGv7sbdYNyktoW5pYKA1Oby02tA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfucrWjot4Jz0eEpFaPUD-MnTgEu9ntMvWXGatd-DCek3g&oe=6999B20D"}, {"file_name": "boss build 90 2560 x 1440.png", "id": "1002711294001170", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974520_1002711297334503_7026414676209736084_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1fm9LjmgUk4Q7kNvwExSYJc&_nc_oc=AdmbkOBX6yBAasKrNr3Rvn-rk1pK8rB5RbfkVsXJQISdWt9dnoNGN1yKXJj8xrUIuqg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsSZguahsK6bL7eEqNN3ucWCMNMm9I1OqbhzhfSfSdssg&oe=6999B927"}, {"file_name": "final room 2560 x 1440.png", "id": "450754603860973", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974585_450754607194306_3396184327224578678_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LLkoodM6_8UQ7kNvwG_j990&_nc_oc=Adng9XBRPn4Ehdq2F5qT9FnIt6yxIbohcHsE6Nr_NV2JcsRsVNf9cqyY-nOG0wGXR4Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsCCz_aZ5i6ZQg5fWe8zwzXbfQx8nRygaAsi9y7rlIXGg&oe=6999AA98"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "535391551416483", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75375748_535391554749816_2854941644077308396_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gtOilE9lIWAQ7kNvwGecx3L&_nc_oc=AdnIX1kBbCJcU2c22maLUsSx_CgXPevTRnEC2fSP1eJCrDBQ-6Gp-7LTBeQ2_-Z5RJY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftwtRpwiArQ09i3bRZuvuxLtYnWgY_bUnaqymp_mOQOEQ&oe=6999AF7D"}, "display_name": "Exit Condition One Early Access", "keywords": [], "long_description": "Note: This game is currently in early access. It is fully playable and fun, with around 2 hours of play time. A target of 3-4 hours of playtime and a price of $9.99 is planned for the finished game.\n\nYou awake from cryo in a weird sort of museum. A robot refers to you as a curator and the security system is malfunctioning. Can you get things back to normal and escape? There are no jump scares. The game is designed ground-up for roomscale VR on the Quest, but supports all locomotion modes. Most objects can be interacted with, it fully uses physics, and the hands don't \"ghost out.\"\n\nYou'll need to solve puzzles that include drone navigation, crafting, routing power, rewiring circuits, climbing, physically navigating mazes, and dancing. Some puzzles will have you moving in and out of AR and VR within the game itself. There are four main rooms and the final room is a \"boss level\" that contains the largest variety of puzzles.\n\nThere is still a bit of placeholder art and the story aspects are still in progress. Before purchasing, consider trying the polished demo, which is a single room with about 30 minutes of playtime. Updates can be expected at least twice a month and usually more often than that.\n\nhttps://discord.gg/2NfBumhKQD", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "developer_privacy_policy_url": "https://exitconditions.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Damon Poole", "support_website_url": null, "website_url": "https://exitconditions.com/", "category": "GAMES", "comfort_rating": "
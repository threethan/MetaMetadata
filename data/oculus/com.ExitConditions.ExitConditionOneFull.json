oh=00_Afv1tbCSo_oM5aHXTsKXpFxInmeDe-qYYH7jSvtHBxs3Dw&oe=699863E0"}, {"file_name": "office build 90 2560 x 1440.png", "id": "1251024332433431", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974520_1251024335766764_4635200739085119148_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TsQbBLNkQNoQ7kNvwHwlc2m&_nc_oc=AdkR8VgIQKIjNlc7AwrRwg7npkWRUbmk0RDVblBX9w7Y_3WrQLCUdysRPWACan-iQZQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afvs7q52IpwrYURwJS8RlX9uhEbp_Ez_jdZK7wAhn9MUKQ&oe=69986F7E"}, {"file_name": "vr room build 90 2560 x 1440.png", "id": "702154417995674", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974545_702154421329007_1278873116692662506_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cxXCPhRRUQYQ7kNvwEF8SAz&_nc_oc=AdnYGf0GOtQwKdgiZ-EcIp16AZcMMKEEPNN0O-lknUxYM5Rfgqjvqf1aCnEWJ2aaAMk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfuvIs2obhEHPrqw1Dmr3ACuTb3bjQLZKWdq2u4ssKXu1Q&oe=6998608D"}, {"file_name": "boss build 90 2560 x 1440.png", "id": "1002711294001170", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974520_1002711297334503_7026414676209736084_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ha_6oYyQylEQ7kNvwEe44a3&_nc_oc=AdkvMhC5CEWhfM71vPNLoI_C6-o5RKKfo6kOyUrB4Oyo0qju9pEMndHpOgK-80p_MIg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfsMGpasaGmF7ius0a8od1tA2yxIOZ-hHELhJ-yE8tRfEg&oe=699867A7"}, {"file_name": "final room 2560 x 1440.png", "id": "450754603860973", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974585_450754607194306_3396184327224578678_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LLkoodM6_8UQ7kNvwFUVLK0&_nc_oc=AdmWpr8UBGKA-rcprTA-n1blc675mALCACCyV_bmv0GUtB6sU5qoIKUCQqAZeOsYMhY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afv6LdvWl993eUvytskTCjtSRtdPJF-iWEdnAkLu9Keoiw&oe=69985918"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "535391551416483", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75375748_535391554749816_2854941644077308396_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ktx9XOPEJUUQ7kNvwGdw6-G&_nc_oc=AdnTfHUmgBNltJdTt5KP_90qVakWgExhh96bc8YHlKBb96ZskIfkfzD8RUlb8Vdq-Tw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfuSuwYktu-XlrghrmHR3OFDbWGhsNCjtg5OyKK5Npkliw&oe=69985DFD"}, "display_name": "Exit Condition One Early Access", "keywords": [], "long_description": "Note: This game is currently in early access. It is fully playable and fun, with around 2 hours of play time. A target of 3-4 hours of playtime and a price of $9.99 is planned for the finished game.\n\nYou awake from cryo in a weird sort of museum. A robot refers to you as a curator and the security system is malfunctioning. Can you get things back to normal and escape? There are no jump scares. The game is designed ground-up for roomscale VR on the Quest, but supports all locomotion modes. Most objects can be interacted with, it fully uses physics, and the hands don't \"ghost out.\"\n\nYou'll need to solve puzzles that include drone navigation, crafting, routing power, rewiring circuits, climbing, physically navigating mazes, and dancing. Some puzzles will have you moving in and out of AR and VR within the game itself. There are four main rooms and the final room is a \"boss level\" that contains the largest variety of puzzles.\n\nThere is still a bit of placeholder art and the story aspects are still in progress. Before purchasing, consider trying the polished demo, which is a single room with about 30 minutes of playtime. Updates can be expected at least twice a month and usually more often than that.\n\nhttps://discord.gg/2NfBumhKQD", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "developer_privacy_policy_url": "https://exitconditions.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Damon Poole", "support_website_url": null, "website_url": "https://exitconditions.com/", "category": "GAMES", "comfort_rating": "
nt-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af35-kYDYDCFl8o5FPCd1nnUfMUdi9ASGD20MRcUwtV-Tw&oe=69EB8082"}, {"file_name": "7_ECO_Remastered_FinalBattle.png", "id": "1233526448448036", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822581_1233526451781369_7479849779421110855_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MxrFU2ZcH90Q7kNvwF-73ox&_nc_oc=Adpr-4wV2vJfG9H4S3KfM8aI6_L2tj5AVqnIS_t3f3haZ60Df7EZyPblUGDrJ0azwLc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2SIg2Epsw7BGGopL-_gBTp3O6Vlt5jAYbWUr7bdiR1dA&oe=69EB5C10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ExitConditionOne_MainCover_w_Captions 2560 x 1440 safe.png", "id": "1215321857033813", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619063_1215321860367146_683015123330448268_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WZPOaL8pXvYQ7kNvwGveXox&_nc_oc=AdqyXso_d_AU59VxqPwN41y4tgg5SDHvm7IWH0ur2u9bueSRTprFJ2BGYcXYS7htetw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1rJW-rZ5NzYJ97cMKFpIpVG9YiiUfR4gVJBY5qsulHHA&oe=69EB7A76"}, "display_name": "Escape Room Exit Condition One HD", "keywords": ["escape", "scifi"], "long_description": "You'll need to overcome dozens of puzzling challenges by crafting tools, remote controlling drones, rewiring circuits, climbing, playing Match-3 games, shooting, and even dancing! There's five distinct levels expanding from a small chamber to a cathedral-like boss level.\n{1867939200771207}\nThere are 13 achievements, 4 collectible series, and dancing and match-3 based shooting mini-games unlocked along the way.\n{756005933743740}\nThere's even a chatty robot companion and if that's not enough you can talk to us on **Discord** here: https://discord.gg/hBcfWrezhD\n{2049227882550659}\nPlease note: roomscale mode requires a 3m x 2m guardian.", "short_description": "A roomscale puzzle adventure with escape room bones. Four main levels, a boss level, collectibles and a shooting mini-game. P
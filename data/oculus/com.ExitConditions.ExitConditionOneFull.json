nt-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89CnMCET3BqDTXdZ16iRKtlGu4sqXBhPQzUu7h7sGigg&oe=6A2C1A02"}, {"file_name": "7_ECO_Remastered_FinalBattle.png", "id": "1233526448448036", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491822581_1233526451781369_7479849779421110855_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4YiWO_YevswQ7kNvwE0fmiF&_nc_oc=AdqZUCMMdYZzJwrnqrcBxOYbdu4XyZD6SSax9-AwNUXuUfXbDLjpO5LmRgXJnwq_Wmg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9K22HkYDSjw1b7uUTr5a-08k4vFrybU0Hmc5q4pfaKFQ&oe=6A2C2DD0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ExitConditionOne_MainCover_w_Captions 2560 x 1440 safe.png", "id": "1215321857033813", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499619063_1215321860367146_683015123330448268_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FjxHTE8m_NsQ7kNvwG7_YXc&_nc_oc=AdrHUUAy8iZ5O4FpHennBtsySQYyuvwK2zo9TgVhKbOCxH__JwtuZD7JPfeHbXmcXlI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_v6kLAMdoUd5OeNru03IOmxfZ53FsziUtJgEQw1B3W4g&oe=6A2C13F6"}, "display_name": "Escape Room Exit Condition One HD", "keywords": ["escape", "scifi"], "long_description": "You'll need to overcome dozens of puzzling challenges by crafting tools, remote controlling drones, rewiring circuits, climbing, playing Match-3 games, shooting, and even dancing! There's five distinct levels expanding from a small chamber to a cathedral-like boss level.\n{1867939200771207}\nThere are 13 achievements, 4 collectible series, and dancing and match-3 based shooting mini-games unlocked along the way.\n{756005933743740}\nThere's even a chatty robot companion and if that's not enough you can talk to us on **Discord** here: https://discord.gg/hBcfWrezhD\n{2049227882550659}\nPlease note: roomscale mode requires a 3m x 2m guardian.", "short_description": "A roomscale puzzle adventure with escape room bones. Four main levels, a boss level, collectibles and a shooting mini-game. P
nt-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6N0Ab9zDl1CGB45GwqcY9oTov4ySLWjQ1BM1oEK_u2TQ&oe=6A048D02"}, {"file_name": "7_ECO_Remastered_FinalBattle.png", "id": "1233526448448036", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822581_1233526451781369_7479849779421110855_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SuZrwDvhyfYQ7kNvwEMh5wl&_nc_oc=AdqEpq08wxgzW0V3OI88DljUkxjklmRifT0Cs8zrpNebaJsCi3suxNkpMXvLRNOX-q0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6IKLEnNAZmkpkCNkVhHekM4X_1X9uC7gcM45rbPcV7YQ&oe=6A046890"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ExitConditionOne_MainCover_w_Captions 2560 x 1440 safe.png", "id": "1215321857033813", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619063_1215321860367146_683015123330448268_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=etdiSw0ToV4Q7kNvwEog6z9&_nc_oc=AdoEbU40AbDn7gAhmxaVt6bQjfBrB6JcppM1D2EwmpAqZv7-uyTFAUvC6rSVMzX570o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7B1F7KgOkKzNyZTXnai7FjqWHybf8X81BcBujxXhYqKw&oe=6A0486F6"}, "display_name": "Escape Room Exit Condition One HD", "keywords": ["escape", "scifi"], "long_description": "You'll need to overcome dozens of puzzling challenges by crafting tools, remote controlling drones, rewiring circuits, climbing, playing Match-3 games, shooting, and even dancing! There's five distinct levels expanding from a small chamber to a cathedral-like boss level.\n{1867939200771207}\nThere are 13 achievements, 4 collectible series, and dancing and match-3 based shooting mini-games unlocked along the way.\n{756005933743740}\nThere's even a chatty robot companion and if that's not enough you can talk to us on **Discord** here: https://discord.gg/hBcfWrezhD\n{2049227882550659}\nPlease note: roomscale mode requires a 3m x 2m guardian.", "short_description": "A roomscale puzzle adventure with escape room bones. Four main levels, a boss level, collectibles and a shooting mini-game. P
nt-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2nsssD2RJmDSiHa0XjixWQL1bLQK19juL53j8k-EvTBw&oe=69DA5D02"}, {"file_name": "7_ECO_Remastered_FinalBattle.png", "id": "1233526448448036", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822581_1233526451781369_7479849779421110855_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uagufaGFAdwQ7kNvwGu-q1Q&_nc_oc=AdrwlHbujUv9k_0fOzgmw0W874hhjrCq-NZa36_Mx444w-7VGPHccSgheNV4zHjrFlQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Nt6zbaiGSXh7GpQdC9K0UutaP78lwDHeDJU4je-o0mg&oe=69DA3890"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ExitConditionOne_MainCover_w_Captions 2560 x 1440 safe.png", "id": "1215321857033813", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619063_1215321860367146_683015123330448268_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gh22bhQjSFkQ7kNvwHIZZmT&_nc_oc=Ado9fR7yzY4RaWvGFtHE9qlGvEJe8AEh57_XZTKYJHxjCgH-lVJGlY4QG-V_hnHobeE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3HVB9MV1-7mzFs2xzdbzQbjcPLeV9epmpVqUaHW5Ylqg&oe=69DA56F6"}, "display_name": "Escape Room Exit Condition One HD", "keywords": ["escape", "scifi"], "long_description": "You'll need to overcome dozens of puzzling challenges by crafting tools, remote controlling drones, rewiring circuits, climbing, playing Match-3 games, shooting, and even dancing! There's five distinct levels expanding from a small chamber to a cathedral-like boss level.\n{1867939200771207}\nThere are 13 achievements, 4 collectible series, and dancing and match-3 based shooting mini-games unlocked along the way.\n{756005933743740}\nThere's even a chatty robot companion and if that's not enough you can talk to us on **Discord** here: https://discord.gg/hBcfWrezhD\n{2049227882550659}\nPlease note: roomscale mode requires a 3m x 2m guardian.", "short_description": "A roomscale puzzle adventure with escape room bones. Four main levels, a boss level, collectibles and a shooting mini-game. P
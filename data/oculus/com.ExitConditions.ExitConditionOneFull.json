oh=00_AfvVkYHVLEaadfRxn6jTnJ00cTegiSDXSGKZeM_0YDwy_Q&oe=69A2EFE0"}, {"file_name": "office build 90 2560 x 1440.png", "id": "1251024332433431", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974520_1251024335766764_4635200739085119148_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zkf9oAE6SVUQ7kNvwEclbot&_nc_oc=AdlrOvV7b03jZmwXO6cHhfsID-nkCa56U1WcDBpcQ6DZEIleGhP4DUFJRnCFbXSRSsE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvRZW6djbTBsFF2XkdyURnweBehfySeGGhUMv-qZbof9Q&oe=69A2FB7E"}, {"file_name": "vr room build 90 2560 x 1440.png", "id": "702154417995674", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974545_702154421329007_1278873116692662506_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OpaD6_ZMt_gQ7kNvwEdKKT_&_nc_oc=AdnXosCXHuys5wJK750DzmyClXmg7S5sFDaFouXKjbqoVrINusznVqFcixNPtMU40Fo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs20AnLYbUJD8owbVVHj_fely9PRG1H_DUiaCumLps-og&oe=69A2EC8D"}, {"file_name": "boss build 90 2560 x 1440.png", "id": "1002711294001170", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974520_1002711297334503_7026414676209736084_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=joB6m-HzfGYQ7kNvwGrnJzj&_nc_oc=AdliPeTL0qLQNRfa1_1bKqgzZO8IFh-ACQNdWP9urwuPuDRsA7RjpoIj9MDfn3hpKY0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft0rhzLSZqXs2AbnEz0gjKpCLiVT_7LhUtgmLFZvtafTg&oe=69A2F3A7"}, {"file_name": "final room 2560 x 1440.png", "id": "450754603860973", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974585_450754607194306_3396184327224578678_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kMBPCcdb7iAQ7kNvwGHwSNU&_nc_oc=AdlzDkzSnfqvhdcz-xDoVQP10wZmp_RPfR1Dv29RwIpqBQj-m6rzlhHqSL5ETImnJTA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfswQ2GllqVRVwgjV6uo652JFVoQFb3QszztZCYeSEUvuQ&oe=69A2E518"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "535391551416483", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75375748_535391554749816_2854941644077308396_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FjQtnjvVPikQ7kNvwHAeGI3&_nc_oc=AdlzcMuqS3xf_cuyKouTO9nov7w2K2WXXTybGCNgJdxTWT8dIqoIvyM1TYyC5ujTf-A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft1T08YaADbDq66xsF-MERLv0PEOqxb7LovwIaLosCmJw&oe=69A2E9FD"}, "display_name": "Exit Condition One Early Access", "keywords": [], "long_description": "Note: This game is currently in early access. It is fully playable and fun, with around 2 hours of play time. A target of 3-4 hours of playtime and a price of $9.99 is planned for the finished game.\n\nYou awake from cryo in a weird sort of museum. A robot refers to you as a curator and the security system is malfunctioning. Can you get things back to normal and escape? There are no jump scares. The game is designed ground-up for roomscale VR on the Quest, but supports all locomotion modes. Most objects can be interacted with, it fully uses physics, and the hands don't \"ghost out.\"\n\nYou'll need to solve puzzles that include drone navigation, crafting, routing power, rewiring circuits, climbing, physically navigating mazes, and dancing. Some puzzles will have you moving in and out of AR and VR within the game itself. There are four main rooms and the final room is a \"boss level\" that contains the largest variety of puzzles.\n\nThere is still a bit of placeholder art and the story aspects are still in progress. Before purchasing, consider trying the polished demo, which is a single room with about 30 minutes of playtime. Updates can be expected at least twice a month and usually more often than that.\n\nhttps://discord.gg/2NfBumhKQD", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "developer_privacy_policy_url": "https://exitconditions.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Damon Poole", "support_website_url": null, "website_url": "https://exitconditions.com/", "category": "GAMES", "comfort_rating": "
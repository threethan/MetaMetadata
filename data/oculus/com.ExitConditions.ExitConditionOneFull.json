358156072576_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a-tnplSxapEQ7kNvwHx9Izv&_nc_oc=AdnHQuR8HzjpLKHgOvLQIeUhRiAoCgaUdTcEG0OTULT3lkd_HlIcuyNUW_yA7VHqTKs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuFm2C3RrzZVy63wXCQjtJLO9nulcXZvEERpl7EI3V3kg&oe=69A835E0"}, {"file_name": "office build 90 2560 x 1440.png", "id": "1251024332433431", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974520_1251024335766764_4635200739085119148_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7D_inSBV4ngQ7kNvwHBSFMy&_nc_oc=AdmkmFQdYI4P1adIQIIyBZMURoPXbqMbjwzTU22Kfmgh2Jde0dOS_uVEhrdj4Bg2Ur4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvqbT4J5ui4X9zOjxVjAgXWUn0oU3TkQ8GT4TcgZgRYRw&oe=69A8093E"}, {"file_name": "vr room build 90 2560 x 1440.png", "id": "702154417995674", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974545_702154421329007_1278873116692662506_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gPxvUgRYt_kQ7kNvwFAbXxP&_nc_oc=AdkxalgpJNo4-61RiiEVYZShYjAZFa1UTaFaQRmPD-T7DELTYV7rtqiDa-dqu4TqqrM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsVHvMyd0nOVDrherSWEyyLf8DNyMTBnd1H8D8VUb3V-g&oe=69A8328D"}, {"file_name": "boss build 90 2560 x 1440.png", "id": "1002711294001170", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974520_1002711297334503_7026414676209736084_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PqHyInS8kR4Q7kNvwGlHhS4&_nc_oc=AdmmEuM2buqKfE6gBxuNwLgeLpeh2Kc09dLw3WA5SzWlVu6hltpvrRqXI7m63EJmjLw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuLsMWs9Py3yADEbBomnsJJyj49BzySFxf9UpftRyJKnw&oe=69A839A7"}, {"file_name": "final room 2560 x 1440.png", "id": "450754603860973", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974585_450754607194306_3396184327224578678_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aU4tESZQStMQ7kNvwHIk_Wa&_nc_oc=AdkYbGQ41-sZ98YjD3-AXdDZMesXe-LijehmtpuMkLupzbG_pFLy1JYsiB2MWafF93s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvBb4jkNI6bJOZp_8SOgz0bG_uRUIbyeT-Ykxjf4BQYcg&oe=69A82B18"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "535391551416483", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75375748_535391554749816_2854941644077308396_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U8_RavEZ05IQ7kNvwGb6XE4&_nc_oc=AdkWPaW6JKcMp7Z_RhiU9U0qJPBZXuT3ogYikAm9h7SIfmCCy_zK6fTEnWgIVfwbUJo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftgU1EkX5wO8uC1IpXoZO68nWhjiiPYcl00yDpE0DiP0A&oe=69A82FFD"}, "display_name": "Exit Condition One Early Access", "keywords": [], "long_description": "Note: This game is currently in early access. It is fully playable and fun, with around 2 hours of play time. A target of 3-4 hours of playtime and a price of $9.99 is planned for the finished game.\n\nYou awake from cryo in a weird sort of museum. A robot refers to you as a curator and the security system is malfunctioning. Can you get things back to normal and escape? There are no jump scares. The game is designed ground-up for roomscale VR on the Quest, but supports all locomotion modes. Most objects can be interacted with, it fully uses physics, and the hands don't \"ghost out.\"\n\nYou'll need to solve puzzles that include drone navigation, crafting, routing power, rewiring circuits, climbing, physically navigating mazes, and dancing. Some puzzles will have you moving in and out of AR and VR within the game itself. There are four main rooms and the final room is a \"boss level\" that contains the largest variety of puzzles.\n\nThere is still a bit of placeholder art and the story aspects are still in progress. Before purchasing, consider trying the polished demo, which is a single room with about 30 minutes of playtime. Updates can be expected at least twice a month and usually more often than that.\n\nhttps://discord.gg/2NfBumhKQD", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "deve
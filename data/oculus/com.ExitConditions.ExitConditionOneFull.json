nt-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_udkpDT0Fn7X1PkgB44QdC_vfjmGu8d0yFqFWM7qgRBg&oe=6A37F782"}, {"file_name": "7_ECO_Remastered_FinalBattle.png", "id": "1233526448448036", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822581_1233526451781369_7479849779421110855_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8_2Oqy7XOOEQ7kNvwF98U7m&_nc_oc=Adq1goMGcQOauUVLyDrY7IyBX05RC69yeFTga_4eX_DQpAn9iEfNHEbPjefxsyurfkA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80yVAJDLWMoMbXOmManjF5u_6TCo6x823N_wBHH0c-rw&oe=6A380B50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ExitConditionOne_MainCover_w_Captions 2560 x 1440 safe.png", "id": "1215321857033813", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619063_1215321860367146_683015123330448268_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r5PoC9-FyJIQ7kNvwEWMzpJ&_nc_oc=AdpgU8FIkurOy4qfugwNBbI1VHfqKwW5y0usiLnIQ-kR1JfyldudIhYdbXPvMxhLr_0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8d0zgAFde5FeWWpl4gXyy4uQ2GsqLSSfwqj4J192K9og&oe=6A37F176"}, "display_name": "Escape Room Exit Condition One HD", "keywords": ["escape", "scifi"], "long_description": "You'll need to overcome dozens of puzzling challenges by crafting tools, remote controlling drones, rewiring circuits, climbing, playing Match-3 games, shooting, and even dancing! There's five distinct levels expanding from a small chamber to a cathedral-like boss level.\n{1867939200771207}\nThere are 13 achievements, 4 collectible series, and dancing and match-3 based shooting mini-games unlocked along the way.\n{756005933743740}\nThere's even a chatty robot companion and if that's not enough you can talk to us on **Discord** here: https://discord.gg/hBcfWrezhD\n{2049227882550659}\nPlease note: roomscale mode requires a 3m x 2m guardian.", "short_description": "A roomscale puzzle adventure with escape room bones. Four main levels, a boss level, collectibles and a shooting mini-game. P
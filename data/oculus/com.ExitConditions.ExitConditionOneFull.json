nt-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNz597XxDrE5UM8e3EL9-NjMwFexZNlz-vE3g2nC2hXQ&oe=6AF9C402"}, {"file_name": "7_ECO_Remastered_FinalBattle.png", "id": "1233526448448036", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491822581_1233526451781369_7479849779421110855_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kr4MT_ihUl8Q7kNvwGEScTi&_nc_oc=AdoQuFvQKPHjkr3NfWRCMJgdck_9pcIhEUmwYDxNg9V4CFPLhzErExcKwV0_TO5PmvU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1Rpkj46P01ppPzhfY06QDbkMn4zF6dEWWGkLzznlKow&oe=6AF9D7D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ExitConditionOne_MainCover_w_Captions 2560 x 1440 safe.png", "id": "1215321857033813", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619063_1215321860367146_683015123330448268_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P-CZlhIfmHMQ7kNvwHjGMl9&_nc_oc=AdpA-GxXyqqm49VI6dkK20oeVNmX1oXoBhpwRacaOCEFN3p64ubtyc89FnZDIXolLOw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRw9SQjlA8uXjTFUTNRtuV5KI2yYrFq1JklDVglqqHK7Q&oe=6AF9BDF6"}, "display_name": "Escape Room Exit Condition One HD", "keywords": ["escape", "scifi", "room", "adventure", "puzzle"], "long_description": "You'll need to overcome dozens of puzzling challenges by crafting tools, remote controlling drones, rewiring circuits, climbing, playing Match-3 games, shooting, and even dancing! There's five distinct levels expanding from a small chamber to a cathedral-like boss level.\n{1867939200771207}\nThere are 13 achievements, 4 collectible series, and dancing and match-3 based shooting mini-games unlocked along the way.\n{756005933743740}\nThere's even a chatty robot companion and if that's not enough you can talk to us on **Discord** here: https://discord.gg/hBcfWrezhD\n{2049227882550659}\nPlease note: roomscale mode requires a 3m x 2m guardian.", "short_description": "A roomscale puzzle adventure with escape room bones. Four main levels, a boss level, collectibles and a shooting mini-game. Puzzles include wiring, search, match 3, dancing, climbing, drones and much more."}]}, "developer_name": "Damon Poole", "developer_privacy_policy_url": "https://iworlds.studio/exit-condition-one-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "iWorlds", "support_website_url": "https://iworlds.studio/discord", "website_url": "https://iworlds.studio/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "fr", "de", "it", "ko", "ja", "ru", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24677488955282739"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974782_8778013132248484_4116436600452784514_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qfpOW29FtrwQ7kNvwHH9AS4&_nc_oc=AdpYd7McPx7pbEcga8HHY9-sy4SMVEisE11dA5n8TXXHSA0Ai0IH0Ut8eXnrLgfp1dA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4g5ga50PdjgLrUMywk4UV5YBANLPaIjih7aQdCN8CiQ&oe=6AF9C4BA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Escape Room Exit Condition One HD", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_nam
358156072576_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g0Us-dVhBLcQ7kNvwFMJ7Xs&_nc_oc=AdkpzoOVlIZ38q7jGUWXbNONcatTgwTLAYZkrto8mPd6z3LvmyTutU4JP9unZMZwzIc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyJAyE54ctu4yk96nkiTDE9FjPT-t7FdBDQAzE8PiOYtg&oe=69BD4DE0"}, {"file_name": "office build 90 2560 x 1440.png", "id": "1251024332433431", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974520_1251024335766764_4635200739085119148_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8nxsBtkMuK8Q7kNvwHDZdfa&_nc_oc=AdkUiBjEH4XJp3pyv_c0ohfOHBHuryjrwa7JVO7Or3dO7QI5T4VmTDG53QvHAcu7SAs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwfN-5hALXEe7vKMfCTLCinVVY0LysqzPEq3Rvzm7oxYQ&oe=69BD597E"}, {"file_name": "vr room build 90 2560 x 1440.png", "id": "702154417995674", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974545_702154421329007_1278873116692662506_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V8V6myNakZ8Q7kNvwHBBM1x&_nc_oc=Adl21MFKFAAPhBuXxeQL5ASJfPRlFud_er93bnZG6d8efStdrBa_Qyx_kOStsSeskcE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwLvmi7-eC74YfUxMPOAAsjbNiUj9fMVVdfXlVi8Uvg_g&oe=69BD4A8D"}, {"file_name": "boss build 90 2560 x 1440.png", "id": "1002711294001170", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974520_1002711297334503_7026414676209736084_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iFkuaZkAIPgQ7kNvwEU8lLw&_nc_oc=Adnidt6rXy3gyGS88dM_H84GIKaeOXw82p3Of_p0V3AUDF6tuKW762GzcpC5xhFigMo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwnBp_Ia1wMg12dQass0k9JbGD0WUR3ak-inGcfHb5yBA&oe=69BD51A7"}, {"file_name": "final room 2560 x 1440.png", "id": "450754603860973", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974585_450754607194306_3396184327224578678_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-fbetymEKEQQ7kNvwHExbeF&_nc_oc=AdnaSQXYgPPqsbloW4NxjJ2koAgwYmMkUXLj7mL22dQaQNQ0ZxsfE538HCi0D7ON3ss&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwDlZ6S_onro9D488bMQ3qbcr6mbQ7B0DsH2XgJTaUMzA&oe=69BD4318"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "535391551416483", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75375748_535391554749816_2854941644077308396_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bu9JGz_HzK8Q7kNvwFcH_8K&_nc_oc=AdlUaEueanWCSrU5j7Qku-7ZOxOhewegzp260saRs6k9pMA3rGeOxGqCYXfnfr8pROQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxPL7cy7gNgQBLe4FmJVHoje_X0tT9IZqtqlNk0y0J-fg&oe=69BD47FD"}, "display_name": "Exit Condition One Early Access", "keywords": [], "long_description": "Note: This game is currently in early access. It is fully playable and fun, with around 2 hours of play time. A target of 3-4 hours of playtime and a price of $9.99 is planned for the finished game.\n\nYou awake from cryo in a weird sort of museum. A robot refers to you as a curator and the security system is malfunctioning. Can you get things back to normal and escape? There are no jump scares. The game is designed ground-up for roomscale VR on the Quest, but supports all locomotion modes. Most objects can be interacted with, it fully uses physics, and the hands don't \"ghost out.\"\n\nYou'll need to solve puzzles that include drone navigation, crafting, routing power, rewiring circuits, climbing, physically navigating mazes, and dancing. Some puzzles will have you moving in and out of AR and VR within the game itself. There are four main rooms and the final room is a \"boss level\" that contains the largest variety of puzzles.\n\nThere is still a bit of placeholder art and the story aspects are still in progress. Before purchasing, consider trying the polished demo, which is a single room with about 30 minutes of playtime. Updates can be expected at least twice a month and usually more often than that.\n\nhttps://discord.gg/2NfBumhKQD", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "deve
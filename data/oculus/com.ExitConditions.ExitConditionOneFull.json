nt-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5UAwGD6-QXqinf6xhI5BeqwvUp1PVnR4tQuwLxkaLoBQ&oe=6A1D9982"}, {"file_name": "7_ECO_Remastered_FinalBattle.png", "id": "1233526448448036", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822581_1233526451781369_7479849779421110855_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uaLGMO-_-x8Q7kNvwGEPHXq&_nc_oc=AdqHtLydz0bHqtZBFPsnhwU82ytu_6Coam2YIbl661MQNJ3F0Szw1Qw_z77hpWu0pao&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4YbIyzsnkUN64f8sIFm69zy6lZX4Me6kjzULfatTow-g&oe=6A1D7510"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ExitConditionOne_MainCover_w_Captions 2560 x 1440 safe.png", "id": "1215321857033813", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619063_1215321860367146_683015123330448268_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tsl0M3tWcZYQ7kNvwG12qrK&_nc_oc=AdohU44UUWo0mA-bsj2fu6XU1DwdvuLlqrQUGTZ9-y9xkQSgOgJywm5iqCCwlPESl2Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zbEnm6qj7x8Va2WyK9HIlSF0BurPtCdxp2Ymusc8NIw&oe=6A1D9376"}, "display_name": "Escape Room Exit Condition One HD", "keywords": ["escape", "scifi"], "long_description": "You'll need to overcome dozens of puzzling challenges by crafting tools, remote controlling drones, rewiring circuits, climbing, playing Match-3 games, shooting, and even dancing! There's five distinct levels expanding from a small chamber to a cathedral-like boss level.\n{1867939200771207}\nThere are 13 achievements, 4 collectible series, and dancing and match-3 based shooting mini-games unlocked along the way.\n{756005933743740}\nThere's even a chatty robot companion and if that's not enough you can talk to us on **Discord** here: https://discord.gg/hBcfWrezhD\n{2049227882550659}\nPlease note: roomscale mode requires a 3m x 2m guardian.", "short_description": "A roomscale puzzle adventure with escape room bones. Four main levels, a boss level, collectibles and a shooting mini-game. P
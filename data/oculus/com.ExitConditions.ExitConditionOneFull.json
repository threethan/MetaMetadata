358156072576_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SGcnwujwt4YQ7kNvwFJupVP&_nc_oc=AdlfXU64fPZwBYqn8QO22F2WmmS27QYDJIHA5R4dpbM9l7Qhl9bpk2QNEkSFPeq-K34&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzyIhlbljBfvTXZEWn1C7NaLHEXHjRStyeWQSWt-NbAYg&oe=69AECD60"}, {"file_name": "office build 90 2560 x 1440.png", "id": "1251024332433431", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974520_1251024335766764_4635200739085119148_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gb-QwBrtwz4Q7kNvwGDFOcT&_nc_oc=AdlI2_EnsJhF5l1EeodQYnfGbL7bXXXe23EJKQEizjrl4Ym4gD3jyBbz1cWPhA8NB_w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwid9i3_evCeIWKtGSyDxy6RXfhn3Ra0s4mt116DXEfcw&oe=69AED8FE"}, {"file_name": "vr room build 90 2560 x 1440.png", "id": "702154417995674", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974545_702154421329007_1278873116692662506_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f1R1QzMGeQIQ7kNvwH48Ozi&_nc_oc=AdkMjVRbHaj-YLz6ROUgTsy25VqsaRTi97jGLb5N-0eh0Z2XE_qtvpeiMIkUVHizT6c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxPcnWsbWqxkwLVG0o5okEPC0eN-i19enhVyuuSDfBkeg&oe=69AECA0D"}, {"file_name": "boss build 90 2560 x 1440.png", "id": "1002711294001170", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974520_1002711297334503_7026414676209736084_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t3a7R92l_cAQ7kNvwFw84f0&_nc_oc=AdkhZdJrQ1AiQAS4AycVzXgA1QwX7Gy3puclQD_2ku4Itzc_oVcZ1lK_0rjokTU22qw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyWbzL2Ei2JmdDPQZCpMpWMCcdj9WU1RNgN3iDobTToyg&oe=69AED127"}, {"file_name": "final room 2560 x 1440.png", "id": "450754603860973", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974585_450754607194306_3396184327224578678_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fHkL3pjsEf0Q7kNvwEBxlwC&_nc_oc=AdnVCgvti_EX5fyQuXoVoH7Nvd8d6NsEbKeu3sM445PgsF4dKlg7jUf2nJXB_pfbxi0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwaaNrbGc4UqtkO_CqCLWpij-7yTmz60u9RCtbybtKSHA&oe=69AEC298"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "535391551416483", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75375748_535391554749816_2854941644077308396_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gZGpTJzMUgQQ7kNvwHFeOk9&_nc_oc=Adlb6yVUG8AnWAcSVSTIHdMUa1RNkqR23X_g1Khi_LfFNEDHWzubzud8UeQYnd0dn1I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzsdXF29Q7TBuHwBq1kjbpte8zUzEE7FiZXT35bZdysBA&oe=69AEC77D"}, "display_name": "Exit Condition One Early Access", "keywords": [], "long_description": "Note: This game is currently in early access. It is fully playable and fun, with around 2 hours of play time. A target of 3-4 hours of playtime and a price of $9.99 is planned for the finished game.\n\nYou awake from cryo in a weird sort of museum. A robot refers to you as a curator and the security system is malfunctioning. Can you get things back to normal and escape? There are no jump scares. The game is designed ground-up for roomscale VR on the Quest, but supports all locomotion modes. Most objects can be interacted with, it fully uses physics, and the hands don't \"ghost out.\"\n\nYou'll need to solve puzzles that include drone navigation, crafting, routing power, rewiring circuits, climbing, physically navigating mazes, and dancing. Some puzzles will have you moving in and out of AR and VR within the game itself. There are four main rooms and the final room is a \"boss level\" that contains the largest variety of puzzles.\n\nThere is still a bit of placeholder art and the story aspects are still in progress. Before purchasing, consider trying the polished demo, which is a single room with about 30 minutes of playtime. Updates can be expected at least twice a month and usually more often than that.\n\nhttps://discord.gg/2NfBumhKQD", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "deve
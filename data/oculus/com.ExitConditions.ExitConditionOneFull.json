358156072576_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oh5ptCrF7wYQ7kNvwENbFhw&_nc_oc=Adn7XB00CQncQLVO_3jqs56sQAje_RBgz0y5kmLjAoOYr4o4a3XLvN_ZrXO_2wSjdrQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwdbzXDf-878d3Afdg7cmS97QureGccmwiayUfWKnoMfw&oe=69B807E0"}, {"file_name": "office build 90 2560 x 1440.png", "id": "1251024332433431", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974520_1251024335766764_4635200739085119148_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gNGFRBvXL7gQ7kNvwHpzXSa&_nc_oc=AdnEzx3W6lyYqudmlylfzjaKEWC8CTjkVnRPWj22_5z9a5OJ1OdtYEbcviS2VteKEd8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfycGrZAnK7CQyf41lbmpQsdsA_XIQ_kCbO3steKGmxNTw&oe=69B8137E"}, {"file_name": "vr room build 90 2560 x 1440.png", "id": "702154417995674", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974545_702154421329007_1278873116692662506_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VLUqvU01BKQQ7kNvwEL5blg&_nc_oc=Adm9f5dhPY70wdTc_H-yr4B12vgQjG7LKXEEmP73HW0EENG_5fUsKEnODw-87WVT7c0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyTTaUesqPi8V8STYIG-n1sKjHIV1lDJMd6aluS2EF2Pg&oe=69B8048D"}, {"file_name": "boss build 90 2560 x 1440.png", "id": "1002711294001170", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974520_1002711297334503_7026414676209736084_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oUhkzIzuWEEQ7kNvwGlG02U&_nc_oc=AdkHzPTn9Ar_E5o3RhUdrmCWG0aBOu163Cid7pb1OayH5R_huaGBqIn8EwH6KgoGUOA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyUcA4Np-M93hl3OE_G8nMEncXkfkAM7SN-T64f-R6udQ&oe=69B80BA7"}, {"file_name": "final room 2560 x 1440.png", "id": "450754603860973", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974585_450754607194306_3396184327224578678_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rZbJOvBRJ9EQ7kNvwF5o6hn&_nc_oc=AdnE6DGn30XFc8TXa2l6VENrHs-xRDtuqprYMW8eRTpLgSenJkIcyIsscFTCmtEz18M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwGJc0SrveNQaXWASLplTnlA26RGWNeshlF7-fUdftK6Q&oe=69B7FD18"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "535391551416483", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75375748_535391554749816_2854941644077308396_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pN5fHuZIIsQQ7kNvwHVOn4I&_nc_oc=AdnDdgD7LqEJ2mElqTnRKl9bNjJ9yM3CgnTHdGipArgCJ-01NSrIhdPGwYyOuJR0dSM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwgT0R1p1mQfItkXPSRBmq8RqJuK2t96mHJS7GsKVOBLg&oe=69B801FD"}, "display_name": "Exit Condition One Early Access", "keywords": [], "long_description": "Note: This game is currently in early access. It is fully playable and fun, with around 2 hours of play time. A target of 3-4 hours of playtime and a price of $9.99 is planned for the finished game.\n\nYou awake from cryo in a weird sort of museum. A robot refers to you as a curator and the security system is malfunctioning. Can you get things back to normal and escape? There are no jump scares. The game is designed ground-up for roomscale VR on the Quest, but supports all locomotion modes. Most objects can be interacted with, it fully uses physics, and the hands don't \"ghost out.\"\n\nYou'll need to solve puzzles that include drone navigation, crafting, routing power, rewiring circuits, climbing, physically navigating mazes, and dancing. Some puzzles will have you moving in and out of AR and VR within the game itself. There are four main rooms and the final room is a \"boss level\" that contains the largest variety of puzzles.\n\nThere is still a bit of placeholder art and the story aspects are still in progress. Before purchasing, consider trying the polished demo, which is a single room with about 30 minutes of playtime. Updates can be expected at least twice a month and usually more often than that.\n\nhttps://discord.gg/2NfBumhKQD", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "deve
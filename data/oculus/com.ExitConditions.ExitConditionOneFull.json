nt-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJ917HiXxyzwwdEF3G3le5RD_IFQIqFGhPqvuiGAiomg&oe=6A8C1F42"}, {"file_name": "7_ECO_Remastered_FinalBattle.png", "id": "1233526448448036", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822581_1233526451781369_7479849779421110855_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j2LoKN9M_AkQ7kNvwH_mg48&_nc_oc=AdoKqIBkURtUJaabMiFrUB1bfxuoQTWRaETwxRb5POuClAA1AHgEm6JRz1BhdrzxGU4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDZdiPEm01ubt2buFL_F1mgM5ZOrirFhJ9w6Wbz4EUAw&oe=6A8C3310"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ExitConditionOne_MainCover_w_Captions 2560 x 1440 safe.png", "id": "1215321857033813", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619063_1215321860367146_683015123330448268_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0HPsgtOCokkQ7kNvwF9IDJv&_nc_oc=AdrwU3qri50z_iGJfgC8ymg28gxSCGRnMFY_dgQgoLEpsiWfX22l6b1lYWE-0eZ30Tg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHTSYXPBuJTJyqUUrxch_1z82FSqeDvafRtKGDN3Cv3EA&oe=6A8C1936"}, "display_name": "Escape Room Exit Condition One HD", "keywords": ["escape", "scifi"], "long_description": "You'll need to overcome dozens of puzzling challenges by crafting tools, remote controlling drones, rewiring circuits, climbing, playing Match-3 games, shooting, and even dancing! There's five distinct levels expanding from a small chamber to a cathedral-like boss level.\n{1867939200771207}\nThere are 13 achievements, 4 collectible series, and dancing and match-3 based shooting mini-games unlocked along the way.\n{756005933743740}\nThere's even a chatty robot companion and if that's not enough you can talk to us on **Discord** here: https://discord.gg/hBcfWrezhD\n{2049227882550659}\nPlease note: roomscale mode requires a 3m x 2m guardian.", "short_description": "A roomscale puzzle adventure with escape room bones. Four main levels, a boss level, collectibles and a shooting mini-game. P
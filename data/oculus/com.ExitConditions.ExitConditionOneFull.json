nt-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90lURS3D8EsNzFFB-7bbVrkjyL9nyFCMkzEYRDgcA4zQ&oe=6A258282"}, {"file_name": "7_ECO_Remastered_FinalBattle.png", "id": "1233526448448036", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822581_1233526451781369_7479849779421110855_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wq3aIjOtIPAQ7kNvwEmK0YL&_nc_oc=AdpjT4bSA2jAO_X8iTvgajfDqe0BJEZj6Z5TXqglsnwUjZzXeOTHjs36j4EldFCWOko&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-JFn6u-s_2xGg7QMBKjVTZ7Cip_vLfSYX0U-hi7s-dbw&oe=6A259650"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ExitConditionOne_MainCover_w_Captions 2560 x 1440 safe.png", "id": "1215321857033813", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619063_1215321860367146_683015123330448268_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U1mppXwjktoQ7kNvwEpZOQV&_nc_oc=AdoGUBt_GCwjtJT2Bw-pcmr7aL1k4On5_Tu_vkO_RWlnh6qbuMTjn86pVP5GgzFcy9Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-qZ25oj4fZEP01_pyfLoT5gzWwLIIZ_WB9fdvbOG4_Mw&oe=6A257C76"}, "display_name": "Escape Room Exit Condition One HD", "keywords": ["escape", "scifi"], "long_description": "You'll need to overcome dozens of puzzling challenges by crafting tools, remote controlling drones, rewiring circuits, climbing, playing Match-3 games, shooting, and even dancing! There's five distinct levels expanding from a small chamber to a cathedral-like boss level.\n{1867939200771207}\nThere are 13 achievements, 4 collectible series, and dancing and match-3 based shooting mini-games unlocked along the way.\n{756005933743740}\nThere's even a chatty robot companion and if that's not enough you can talk to us on **Discord** here: https://discord.gg/hBcfWrezhD\n{2049227882550659}\nPlease note: roomscale mode requires a 3m x 2m guardian.", "short_description": "A roomscale puzzle adventure with escape room bones. Four main levels, a boss level, collectibles and a shooting mini-game. P
358156072576_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-4uvUsY19kwQ7kNvwHlXlhH&_nc_oc=AdnrTGr1QWu6SeF1I1wZmLVAZ-gUsRNIQ_rNDACRtt-PjICrKIhfx67GthHSn-_FMfA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyEf6qKZj3h9AcUqBUpNGfSyBFWac9-f15I_EOOPpp2hw&oe=69BFF0E0"}, {"file_name": "office build 90 2560 x 1440.png", "id": "1251024332433431", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974520_1251024335766764_4635200739085119148_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q33V142RXYgQ7kNvwGOHTgM&_nc_oc=AdlN-OzC0T1e2PU_2mbLthDT-FVQV5nn7wBN7xY9TCadf5muAZFQcuge1boW-RsOJCs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwR0mvXwXNoL_QlFb2l54sXKp4srDZO-ctxB0os7-NxUA&oe=69BFFC7E"}, {"file_name": "vr room build 90 2560 x 1440.png", "id": "702154417995674", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974545_702154421329007_1278873116692662506_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V8V6myNakZ8Q7kNvwH_KU9q&_nc_oc=Adk93IBMEiSK0HRpS-uC373kBIKpt7T0gPoZkZP_mCJD_1Is4zyYraH2_WCu77hSKFA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz2mLYnWh8vAN4kTkU4XXmFtiazFPKiT14-u7Fu5pe8LA&oe=69BFED8D"}, {"file_name": "boss build 90 2560 x 1440.png", "id": "1002711294001170", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974520_1002711297334503_7026414676209736084_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iFkuaZkAIPgQ7kNvwH3eO3D&_nc_oc=AdlvUt_Nl8LLTmtM4yAREWeOin3esIh4OaxD1QUjvRhbPEF-nvPWi6SWbaB9R9udMDA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzCjoO3QtCaG6iv4Tlz2zJbdZx5XK5C4SWa6y1l0kpGRQ&oe=69BFF4A7"}, {"file_name": "final room 2560 x 1440.png", "id": "450754603860973", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974585_450754607194306_3396184327224578678_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F85k4sZRXPcQ7kNvwFydbaa&_nc_oc=AdnV9UGyCZQZqvvespGN2MYVW-ZJZvlMPAC5rR8aezdOjbIdFWTx38VF-YtUjymJODw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxcchIVkzqt6_TWZQ269brak07kn4kbnRGXfZqIqbvR_w&oe=69BFE618"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "535391551416483", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75375748_535391554749816_2854941644077308396_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bu9JGz_HzK8Q7kNvwEXza-s&_nc_oc=AdlUUFd3B0dF9Dt0Np00tad2HT0VGbpwAKYXeSi7qOw9Q0Mr02xdarQux0YD-vhVVNg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzLPMlUIj0pxww_oEImzaZVRQ7Vc1Xn_-DrjJKGxz_iDA&oe=69BFEAFD"}, "display_name": "Exit Condition One Early Access", "keywords": [], "long_description": "Note: This game is currently in early access. It is fully playable and fun, with around 2 hours of play time. A target of 3-4 hours of playtime and a price of $9.99 is planned for the finished game.\n\nYou awake from cryo in a weird sort of museum. A robot refers to you as a curator and the security system is malfunctioning. Can you get things back to normal and escape? There are no jump scares. The game is designed ground-up for roomscale VR on the Quest, but supports all locomotion modes. Most objects can be interacted with, it fully uses physics, and the hands don't \"ghost out.\"\n\nYou'll need to solve puzzles that include drone navigation, crafting, routing power, rewiring circuits, climbing, physically navigating mazes, and dancing. Some puzzles will have you moving in and out of AR and VR within the game itself. There are four main rooms and the final room is a \"boss level\" that contains the largest variety of puzzles.\n\nThere is still a bit of placeholder art and the story aspects are still in progress. Before purchasing, consider trying the polished demo, which is a single room with about 30 minutes of playtime. Updates can be expected at least twice a month and usually more often than that.\n\nhttps://discord.gg/2NfBumhKQD", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "deve
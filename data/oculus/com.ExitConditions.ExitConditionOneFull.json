"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036671_648685863661787_3096920358156072576_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tC44e00RV-kQ7kNvwGB9YRJ&_nc_oc=AdqA-MSh13qwX0hNTJUKSRtY59Jf2UOL42jUKI-Fzrtr-r9Ep53Es-BEHnDQcX7BBEk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAs-czFJi81KC4PMn5Vf1RlHl2DF9dAJEw5rXZzhOrPHg&oe=6A5A3060"}, {"file_name": "office build 90 2560 x 1440.png", "id": "1251024332433431", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974520_1251024335766764_4635200739085119148_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GJEqAWPr2hIQ7kNvwHh1ipl&_nc_oc=AdqvdhlzMdIPmBsonX3nvIHsbf1MD07GwBmu7ZoSG6_WLJLlMNcUEie1Q0nzbDbyWW0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCM9TDc041bVAtnB8wDNVNS9ft_UOpDHCZFb0PfsE-pvw&oe=6A5A3BFE"}, {"file_name": "vr room build 90 2560 x 1440.png", "id": "702154417995674", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974545_702154421329007_1278873116692662506_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QXsoObeGlXMQ7kNvwEuEUex&_nc_oc=AdonJyMwFSVcE8uv294gMzf2ihF15nKjNYSlCvoG894KjD_93enichWmvTaZ8T4NuEQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDSeUNoDuFlMjokLatDnmUDa6fvubcj1-tvpPwwduomHg&oe=6A5A2D0D"}, {"file_name": "boss build 90 2560 x 1440.png", "id": "1002711294001170", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974520_1002711297334503_7026414676209736084_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ILL1Mmn2PS8Q7kNvwGeZU8S&_nc_oc=AdrhorGstmr6_qlkrZ5gz0W22AlWxQaY3Z4wqwilljBA-GVRYVdNsjBdUJ6ep1vkW7E&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAi5idsoI9oSd5y0OYB7fi7GaKiB62DmqEgr7_Ylu5phQ&oe=6A5A3427"}, {"file_name": "final room 2560 x 1440.png", "id": "450754603860973", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974585_450754607194306_3396184327224578678_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9NJfjEYW-pIQ7kNvwHKaEQm&_nc_oc=AdpM9GGwksNlT64Z90Bg6np2UgOyp1M8cI4o52U18Wl8hLNOFMDWy0obP-z_Hc447gE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBe_9K0X4J2E-mwZSj0y-0dVY82jJ8woWyNfmjgBoXVsQ&oe=6A5A2598"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "535391551416483", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75375748_535391554749816_2854941644077308396_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K1ufkuDeAK0Q7kNvwFaYuVP&_nc_oc=AdrHJ_dH-rspRTDW5e9hH2AqZa7K3SUQDIRT0GQP1xT5TczTBGWd16f_-yTUBzFj4Pw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCKjXkcNjGmQ334qrorD6t_Jovu_Fyzl93gGPxDn7gAEw&oe=6A5A2A7D"}, "display_name": "Exit Condition One Early Access", "keywords": [], "long_description": "Note: This game is currently in early access. It is fully playable and fun, with around 2 hours of play time. A target of 3-4 hours of playtime and a price of $9.99 is planned for the finished game.\n\nYou awake from cryo in a weird sort of museum. A robot refers to you as a curator and the security system is malfunctioning. Can you get things back to normal and escape? There are no jump scares. The game is designed ground-up for roomscale VR on the Quest, but supports all locomotion modes. Most objects can be interacted with, it fully uses physics, and the hands don't \"ghost out.\"\n\nYou'll need to solve puzzles that include drone navigation, crafting, routing power, rewiring circuits, climbing, physically navigating mazes, and dancing. Some puzzles will have you moving in and out of AR and VR within the game itself. There are four main rooms and the final room is a \"boss level\" that contains the largest variety of puzzles.\n\nThere is still a bit of placeholder art and the story aspects are still in progress. Before purchasing, consider trying the polished demo, which is a single room with about 30 minutes of playtime. Updates can be expected at least twice a month and usually more often than that.\n\nhttps://discord.gg/2NfBumhKQD", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "developer_privacy_policy_url": "https://exitconditions.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Damon Poole", "support_website_url": null, "website_url": "https://exitconditions.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "427622596118426"}}]}, "scheduled_offers": {"count": 19, "nodes": [{"status": "PUBLISHED", "id": "1459946772604761"}, {"status": "PUBLISHED", "id": "996359646583308"}, {"status": "PUBLISHED", "id": "1652721239380553"}, {"status": "PUBLISHED", "id": "1415132687024958"}, {"status": "PUBLISHED", "id": "916767337371235"}, {"status": "PUBLISHED", "id": "1426499515603771"}, {"status": "PUBLISHED", "id": "2739374122927885"}, {"status": "PUBLISHED", "id": "1308468774035988"}, {"status": "PUBLISHED", "id": "677381124676674"}, {"status": "PUBLISHED", "id": "630953529583727"}, {"status": "PUBLISHED", "id": "2210883735993759"}, {"status": "PUBLISHED", "id": "1131130601512417"}, {"status": "PUBLISHED", "id": "918334267149061"}, {"status": "CANCELLED", "id": "2023249271479048"}, {"status": "CANCELLED", "id": "816646503998188"}, {"status": "PUBLISHED", "id": "1620171495507266"}, {"status": "PUBLISHED", "id": "15567008315298
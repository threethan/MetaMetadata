358156072576_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-4uvUsY19kwQ7kNvwEFo0VF&_nc_oc=AdoJ4ar-WP8SeB9rxG_uUs8o-S1nbCFi5xfbhGMTL88_nMyH3VXmbUGldD_fv9RB3Pc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxl_pmVs484uflgLkZRhQeVQNV4k8BeFjXMhrgYpsue9w&oe=69C14260"}, {"file_name": "office build 90 2560 x 1440.png", "id": "1251024332433431", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974520_1251024335766764_4635200739085119148_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q33V142RXYgQ7kNvwFh73CT&_nc_oc=AdofMlpb7QMOusCjVGPokrtLYcGxc6_lOFLNx9LrSBmQxSOAcqep3hnARWDuHxiTOiY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afyvdo9D4fDWO6AWlvxA-VPACBfKO24qPLc2Rt7GjQCsgA&oe=69C14DFE"}, {"file_name": "vr room build 90 2560 x 1440.png", "id": "702154417995674", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974545_702154421329007_1278873116692662506_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=80LY602Eo7gQ7kNvwFn_P4A&_nc_oc=Adr7jm6tEHQZDt2WrC9D4SyP5cGBNWd643O6RPGk4l08tTwvd6OxIWAT0cf6cIcJVUA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyHNKeM3wq9-XJc4I99gv64giTRt77mogcKtXTwnMZ9Ag&oe=69C13F0D"}, {"file_name": "boss build 90 2560 x 1440.png", "id": "1002711294001170", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974520_1002711297334503_7026414676209736084_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WlzmT-tASUAQ7kNvwEfXvgp&_nc_oc=AdqMWpPzyAt1yoEAPAoXH_Luo4G9HJq4OM38BJ3hf6tF6KrBQ2B4pr5d_WAQcYSW9kQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzpU5ZYTnzvadZ9OsHk8kcBm41tTOwLPOc6QJhPY2deYg&oe=69C14627"}, {"file_name": "final room 2560 x 1440.png", "id": "450754603860973", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974585_450754607194306_3396184327224578678_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F85k4sZRXPcQ7kNvwH_OJDv&_nc_oc=Adp_hPbSuovSHkRbMwWnijCz-gilFuX_-RKalAfn16lilwA14NXC8ylfFwrsPbYyGTk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx0z6bUjikcPCz4SyDbY1prYk-IpBaJa13DbwqahtITkA&oe=69C13798"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "535391551416483", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75375748_535391554749816_2854941644077308396_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yrP-80YYOz8Q7kNvwEQH801&_nc_oc=Adr5aTIkA0PRfm-lCa99U5Qtj-ngLi-ZvQnWWVSEhlVdLNoXE1Cc1RlbD5Kms6Epa-8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxabTkWS5xPjCoV0NpZzAlboeYOSz8IgqnA2eEaY2bFPg&oe=69C13C7D"}, "display_name": "Exit Condition One Early Access", "keywords": [], "long_description": "Note: This game is currently in early access. It is fully playable and fun, with around 2 hours of play time. A target of 3-4 hours of playtime and a price of $9.99 is planned for the finished game.\n\nYou awake from cryo in a weird sort of museum. A robot refers to you as a curator and the security system is malfunctioning. Can you get things back to normal and escape? There are no jump scares. The game is designed ground-up for roomscale VR on the Quest, but supports all locomotion modes. Most objects can be interacted with, it fully uses physics, and the hands don't \"ghost out.\"\n\nYou'll need to solve puzzles that include drone navigation, crafting, routing power, rewiring circuits, climbing, physically navigating mazes, and dancing. Some puzzles will have you moving in and out of AR and VR within the game itself. There are four main rooms and the final room is a \"boss level\" that contains the largest variety of puzzles.\n\nThere is still a bit of placeholder art and the story aspects are still in progress. Before purchasing, consider trying the polished demo, which is a single room with about 30 minutes of playtime. Updates can be expected at least twice a month and usually more often than that.\n\nhttps://discord.gg/2NfBumhKQD", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "deve
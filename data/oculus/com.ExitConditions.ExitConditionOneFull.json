358156072576_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ARkpAnIip-UQ7kNvwGefxMu&_nc_oc=AdnguDdWw4UqldQrG11WTRcNQJzt5_DHcLFljhTW7GKeMgvtWprwcK8OL1fcvy0DBQo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwR76l2hCIa_aPgC7ujQnrR__lZ_pRvqxMmB7rnA_gTZA&oe=69AC2A60"}, {"file_name": "office build 90 2560 x 1440.png", "id": "1251024332433431", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974520_1251024335766764_4635200739085119148_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VbC8Jq6bWMYQ7kNvwEUQzIY&_nc_oc=AdmSIRhUwAhuBKudLREcdiukCEcKGxjC3JOZXtRBsPS_4mrZP0iRu-_UCFvRcN74JgQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyiioDzKw6QD8IWERrLOKCaj_bYofmfxCvvWYASTgDuJw&oe=69AC35FE"}, {"file_name": "vr room build 90 2560 x 1440.png", "id": "702154417995674", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974545_702154421329007_1278873116692662506_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LvYg8haSKtUQ7kNvwGz6_sJ&_nc_oc=Adm5ZomGEWQxHlfWrCBDSLN4UpeVeURgtCGqx24XRDzc2qFFD6dHzuSyt44Z0FZbJHo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afzfx3Fz1fzVFJcClNto8iDCCl3LDjSkfx4v7qQNNCcLyg&oe=69AC270D"}, {"file_name": "boss build 90 2560 x 1440.png", "id": "1002711294001170", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974520_1002711297334503_7026414676209736084_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QDXzhx1WtFcQ7kNvwEY3IrX&_nc_oc=AdkRi5wJmo6bB-STkQLesI0JTY9d-uI0FURBj7vH1CUhTzfecLBxYtjXIo24OVlgYDg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxAlHd30GL_L9uzCvUa_also8lrA51mMEHU8PlZDaLf7w&oe=69AC2E27"}, {"file_name": "final room 2560 x 1440.png", "id": "450754603860973", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974585_450754607194306_3396184327224578678_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fHkL3pjsEf0Q7kNvwGT3Fqh&_nc_oc=AdlmkutotdixAa3Lyc8Fir19le6om6yMlLdlybTjLso3pjEgLQ2mK0duL569Qt-YjzI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz2suOt7yRurwt0CjH3pLV5OhFt1TKLHsq2Mz8s1WYCDw&oe=69AC1F98"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "535391551416483", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75375748_535391554749816_2854941644077308396_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rCQuzc224ZkQ7kNvwGVj6JN&_nc_oc=AdlL3PPECbYaQhqwIFW_mTxQ-Z2uEWf27qJDhYvDIrkktj70xL545X3hJ5SAbCb46KM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy11GYsZ4Dj7pq9gH1R6LXYvILwATQ_NtaAahOVwChJ0Q&oe=69AC247D"}, "display_name": "Exit Condition One Early Access", "keywords": [], "long_description": "Note: This game is currently in early access. It is fully playable and fun, with around 2 hours of play time. A target of 3-4 hours of playtime and a price of $9.99 is planned for the finished game.\n\nYou awake from cryo in a weird sort of museum. A robot refers to you as a curator and the security system is malfunctioning. Can you get things back to normal and escape? There are no jump scares. The game is designed ground-up for roomscale VR on the Quest, but supports all locomotion modes. Most objects can be interacted with, it fully uses physics, and the hands don't \"ghost out.\"\n\nYou'll need to solve puzzles that include drone navigation, crafting, routing power, rewiring circuits, climbing, physically navigating mazes, and dancing. Some puzzles will have you moving in and out of AR and VR within the game itself. There are four main rooms and the final room is a \"boss level\" that contains the largest variety of puzzles.\n\nThere is still a bit of placeholder art and the story aspects are still in progress. Before purchasing, consider trying the polished demo, which is a single room with about 30 minutes of playtime. Updates can be expected at least twice a month and usually more often than that.\n\nhttps://discord.gg/2NfBumhKQD", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "deve
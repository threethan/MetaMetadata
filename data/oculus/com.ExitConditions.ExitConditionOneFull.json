358156072576_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SGcnwujwt4YQ7kNvwE9Ii1P&_nc_oc=Adm1LKE8BQ_64IKTtrwI3o6xexu5arxDQ5VALuKAkPUBz2s5vez-eJMYnlJv3xjhiGI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyqM_9e7pfhRCi84y5xcXeQBN2koAxARByQ7bPt6J2U5g&oe=69B17060"}, {"file_name": "office build 90 2560 x 1440.png", "id": "1251024332433431", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974520_1251024335766764_4635200739085119148_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gb-QwBrtwz4Q7kNvwFH_hyu&_nc_oc=AdkbB-v6bprAvRWaUveUYlU1SNtn6fOBeRwyZPPCp5RTdauVos3fbKqJS6CtsePwofE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwRcxaUIfWs8JjN5HifmKScFhF7KW_Th8ONSJk9EAZUeA&oe=69B17BFE"}, {"file_name": "vr room build 90 2560 x 1440.png", "id": "702154417995674", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974545_702154421329007_1278873116692662506_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kpI1MTv_i9wQ7kNvwEDFtUU&_nc_oc=AdmmevnGnAEBs7T9gOigAEgub7eZXK90-ygiFseJE7g7p437qSlMuVKsDO6vHFGgPcI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwpw0paU7y8OPI6_yq2rgK6QCAlsNFd9Fq9NGhSXo1Sww&oe=69B16D0D"}, {"file_name": "boss build 90 2560 x 1440.png", "id": "1002711294001170", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974520_1002711297334503_7026414676209736084_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LJobpARIATsQ7kNvwGgdwwW&_nc_oc=AdmV1OD_krvTIWqu3oHW2LIaYgPUuQ4cswiUU4MFEDaqhzaNvMzj7_wYDkZ8V2edM90&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz3cxQl4SYpnSi7DXKwIR0xs4u-wvSxPL5QQHI48S0O5A&oe=69B17427"}, {"file_name": "final room 2560 x 1440.png", "id": "450754603860973", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974585_450754607194306_3396184327224578678_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qsp9jZ-K97kQ7kNvwEvE5H7&_nc_oc=AdmLQJaztrt0x5bee-7xklVdna7fwAMebimwBekFHoTYd4wJy_oEVv4IYsLg7L2ZFjo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzGJac54FY338GjRu3wWh3_6Pk13JdAMQpbuf5W0XvjXw&oe=69B16598"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "535391551416483", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75375748_535391554749816_2854941644077308396_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gGk2YWwEP38Q7kNvwGEdcJe&_nc_oc=Adm7x6vZjtttvEh247cIgcejoE1QwlpiVvH9HUhrbDReZl8yCihnzqr4uuOTbCnb4no&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyraLJtHJrU5HN0_cgKYhjArnkD1_TjsAi_ILFxh2mkpg&oe=69B16A7D"}, "display_name": "Exit Condition One Early Access", "keywords": [], "long_description": "Note: This game is currently in early access. It is fully playable and fun, with around 2 hours of play time. A target of 3-4 hours of playtime and a price of $9.99 is planned for the finished game.\n\nYou awake from cryo in a weird sort of museum. A robot refers to you as a curator and the security system is malfunctioning. Can you get things back to normal and escape? There are no jump scares. The game is designed ground-up for roomscale VR on the Quest, but supports all locomotion modes. Most objects can be interacted with, it fully uses physics, and the hands don't \"ghost out.\"\n\nYou'll need to solve puzzles that include drone navigation, crafting, routing power, rewiring circuits, climbing, physically navigating mazes, and dancing. Some puzzles will have you moving in and out of AR and VR within the game itself. There are four main rooms and the final room is a \"boss level\" that contains the largest variety of puzzles.\n\nThere is still a bit of placeholder art and the story aspects are still in progress. Before purchasing, consider trying the polished demo, which is a single room with about 30 minutes of playtime. Updates can be expected at least twice a month and usually more often than that.\n\nhttps://discord.gg/2NfBumhKQD", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "deve
reen.png", "id": "731065226539035", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499307435_731065229872368_7750937163283254853_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=db3iN2SN4g4Q7kNvwFm1Jz3&_nc_oc=AdoQ_2ViKZYul6bFhcrOnfHe8Yj98gd0dh8MK3RyUbxi3h3LU_xWkDt9Cf1QEK-3Soo&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3ZjoQhTdK63JkJeZl0a8X42SEZJjhQHrLGa16dxfU7Q&oe=6AFF0A02"}, {"file_name": "7_ECO_Remastered_FinalBattle.png", "id": "1233526448448036", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491822581_1233526451781369_7479849779421110855_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y3qoGqmMbrkQ7kNvwHIifvD&_nc_oc=Adp4R0B1k57F4Gz0X_J8Zj9nEWByrPVJHyHQcuEiygSUn7oUDfoBp5zlYXpn-AY-Vco&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSt12JAoBpZazx2d4DnE7J-NcoUXuv76eJWI7ywMIk3fA&oe=6AFF1DD0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ExitConditionOne_MainCover_w_Captions 2560 x 1440 safe.png", "id": "1215321857033813", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619063_1215321860367146_683015123330448268_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ayzh6kaLcT0Q7kNvwGNt2Fs&_nc_oc=AdogEgtutbbS7MhhKscqUi1WUjFceidoHaR5c3M7NEzwJ63bOytDRDd9maFJ8i-jiqE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQiEY_RZraal7wjI-INm93Sdj1dpa-noeGJpa5gYzPXrg&oe=6AFF03F6"}, "display_name": "Escape Room Exit Condition One HD", "keywords": ["escape", "scifi", "room", "adventure", "puzzle"], "long_description": "You'll need to overcome dozens of puzzling challenges by crafting tools, remote controlling drones, rewiring circuits, climbing, playing Match-3 games, shooting, and even dancing! There's five distinct levels expanding from a small chamber to a cathedral-like boss level.\n{1867939200771207}\nThere are 13 achievements, 4 collectible series, and dancing and match-3 based shooting mini-games unlocked along the way.\n{756005933743740}\nThere's even a chatty robot companion and if that's not enough you can talk to us on **Discord** here: https://discord.gg/hBcfWrezhD\n{2049227882550659}\nPlease note: roomscale mode requires a 3m x 2m guardian.", "short_description": "A roomscale puzzle adventure with escape room bones. Four main levels, a boss level, collectibles and a shooting mini-game. Puzzles include wiring, search, match 3, dancing, climbing, drones and much more."}]}, "developer_name": "Damon Poole", "developer_privacy_policy_url": "https://iworlds.studio/exit-condition-one-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "iWorlds", "support_website_url": "https://iworlds.studio/discord", "website_url": "https://iworlds.studio/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "fr", "de", "it", "ko", "ja", "ru", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24677488955282739"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974782_8778013132248484_4116436600452784514_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YPAqiPnAYHsQ7kNvwF-hUxS&_nc_oc=Adq6IIstSTgnJRtqKdfZFRAZp2yL_Qslok85vYb9bKTDtPfd8LbaPQQ9jaLZW-yMBaA&_nc_zt=3&_nc_ht=scontent
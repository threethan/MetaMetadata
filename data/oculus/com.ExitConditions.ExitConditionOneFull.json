nt-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-Zhn-GqMGfNJz37iyWWa_yFYkZTBkrru_Yds6CwLgkg&oe=6AE8A082"}, {"file_name": "7_ECO_Remastered_FinalBattle.png", "id": "1233526448448036", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491822581_1233526451781369_7479849779421110855_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P9tsLwarhX0Q7kNvwE9ohsY&_nc_oc=AdqD1n1Ag-xQuZQxMY3Ajc76YpMvNQIGnh9IOyu_wH8jS-aU2ki3N4PaJGzCIkqucuA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFgJE9kMxpCzr7UhZov4qIf1nWW9DlWh775ZzHnEMMKg&oe=6AE8B450"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ExitConditionOne_MainCover_w_Captions 2560 x 1440 safe.png", "id": "1215321857033813", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619063_1215321860367146_683015123330448268_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M-kA5BC6m5gQ7kNvwFS8Iig&_nc_oc=Adqzhe1BL4v0jslcdk4o5V4QPwKOctQzg_ybRFXip24LOskBpJB5fb-PIKqErE4GsSc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNeIkZiPK_93JyPaWSfPJ3xfbRul-CLj41A4MJIm9PxQ&oe=6AE89A76"}, "display_name": "Escape Room Exit Condition One HD", "keywords": ["escape", "scifi", "room", "adventure", "puzzle"], "long_description": "You'll need to overcome dozens of puzzling challenges by crafting tools, remote controlling drones, rewiring circuits, climbing, playing Match-3 games, shooting, and even dancing! There's five distinct levels expanding from a small chamber to a cathedral-like boss level.\n{1867939200771207}\nThere are 13 achievements, 4 collectible series, and dancing and match-3 based shooting mini-games unlocked along the way.\n{756005933743740}\nThere's even a chatty robot companion and if that's not enough you can talk to us on **Discord** here: https://discord.gg/hBcfWrezhD\n{2049227882550659}\nPlease note: roomscale mode requires a 3m x 2m guardian.", "short_description": "A roomscale puzzle adventure with escape room bones. Four main levels, a boss level, collectib
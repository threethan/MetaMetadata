nt-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ZL8o_d5eXHMw3i8VTvmvQ2NDdunC1mw30oW0PY84Fpg&oe=6A428382"}, {"file_name": "7_ECO_Remastered_FinalBattle.png", "id": "1233526448448036", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822581_1233526451781369_7479849779421110855_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j5dqgRAh-F0Q7kNvwFK6WFS&_nc_oc=Adq_dyiwxhZajShkIQNKE3c9Afeo3HVdNJM2fXdBw525BzuG76Ar4lJYDW7E-X-tcgA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6_TitpIRbA764ERm3PtzERqDXq1Bw3SW1fXnXNG26GA&oe=6A429750"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ExitConditionOne_MainCover_w_Captions 2560 x 1440 safe.png", "id": "1215321857033813", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619063_1215321860367146_683015123330448268_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lnZiIOrwknUQ7kNvwG3DM2E&_nc_oc=Adq27Zy1W3fkEA_T5ebCscb4jJJ5XMXSZJ6TOZAqTVKOIoVNIf8yWCwiAmvY8I7cU4k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9hqH8VBa7ixmTQg3hYPBeaRY1S-AfOGCSYGqejZifupQ&oe=6A427D76"}, "display_name": "Escape Room Exit Condition One HD", "keywords": ["escape", "scifi"], "long_description": "You'll need to overcome dozens of puzzling challenges by crafting tools, remote controlling drones, rewiring circuits, climbing, playing Match-3 games, shooting, and even dancing! There's five distinct levels expanding from a small chamber to a cathedral-like boss level.\n{1867939200771207}\nThere are 13 achievements, 4 collectible series, and dancing and match-3 based shooting mini-games unlocked along the way.\n{756005933743740}\nThere's even a chatty robot companion and if that's not enough you can talk to us on **Discord** here: https://discord.gg/hBcfWrezhD\n{2049227882550659}\nPlease note: roomscale mode requires a 3m x 2m guardian.", "short_description": "A roomscale puzzle adventure with escape room bones. Four main levels, a boss level, collectibles and a shooting mini-game. P
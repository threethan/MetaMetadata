nt-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43VT1jvXhuo2jE5p7V2ixGXOHb8BaL5m8XA-EUEJyHMA&oe=6A01EA02"}, {"file_name": "7_ECO_Remastered_FinalBattle.png", "id": "1233526448448036", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822581_1233526451781369_7479849779421110855_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SuZrwDvhyfYQ7kNvwEvLT5H&_nc_oc=AdqC4pWTyS4Y5Z5anTeq2TR_lvZja64gVYTmmQ-H5UATdpmrlCerZyx5lyC7EhnW8K0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af64HbYq_-_CzveO8N3RGpsIjPLjSwTpo3ZVBEpSps4aEg&oe=6A01C590"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ExitConditionOne_MainCover_w_Captions 2560 x 1440 safe.png", "id": "1215321857033813", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619063_1215321860367146_683015123330448268_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=etdiSw0ToV4Q7kNvwHypiII&_nc_oc=Adoe3jeqjTf48UBlFXEJX_W7ocX_sYIjEq6n2klscwkXNWCf3yoC4LCE4yBUigdr5iA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5GMhfTSTyvclZ1OGvRn-tyl9urYhQr9mHv2W45Gtg97Q&oe=6A01E3F6"}, "display_name": "Escape Room Exit Condition One HD", "keywords": ["escape", "scifi"], "long_description": "You'll need to overcome dozens of puzzling challenges by crafting tools, remote controlling drones, rewiring circuits, climbing, playing Match-3 games, shooting, and even dancing! There's five distinct levels expanding from a small chamber to a cathedral-like boss level.\n{1867939200771207}\nThere are 13 achievements, 4 collectible series, and dancing and match-3 based shooting mini-games unlocked along the way.\n{756005933743740}\nThere's even a chatty robot companion and if that's not enough you can talk to us on **Discord** here: https://discord.gg/hBcfWrezhD\n{2049227882550659}\nPlease note: roomscale mode requires a 3m x 2m guardian.", "short_description": "A roomscale puzzle adventure with escape room bones. Four main levels, a boss level, collectibles and a shooting mini-game. P
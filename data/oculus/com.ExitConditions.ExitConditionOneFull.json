358156072576_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g0Us-dVhBLcQ7kNvwFKc3tR&_nc_oc=AdlCe6krXM8anoLHcWh4rw5M5hVJUoJGOPXnZsAH62eOJ5bd5MgFLkL1HnpC0xZU6RM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxXB3id5W42571R1Kh7Cf8n2u1fSTSNhrxpqCtPEBvxXA&oe=69BBFC60"}, {"file_name": "office build 90 2560 x 1440.png", "id": "1251024332433431", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974520_1251024335766764_4635200739085119148_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8nxsBtkMuK8Q7kNvwE3n6b6&_nc_oc=AdnP2QyvZWopUTyl2wNSUgc5HSJJrtcsJTDIa3HNY8-soZGUvuMlUbmb58-sVUsmT9o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afww-QRBPhBTBJCMnk90yrIY9M0Yv6sjlD2vKb1Jhsc08A&oe=69BC07FE"}, {"file_name": "vr room build 90 2560 x 1440.png", "id": "702154417995674", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974545_702154421329007_1278873116692662506_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ulnx9AY7bLoQ7kNvwF9XDwy&_nc_oc=AdmAmjPLW_Lkc-e5lACa3_t1m-iwgVMnh7HsQ4k7uzqo3KiPjQs5ytE8x1UCu6iVJrU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx3eY5um6xk4Z3M8v22My01V9uUAtjoMJE5vo0tyVZJ7g&oe=69BBF90D"}, {"file_name": "boss build 90 2560 x 1440.png", "id": "1002711294001170", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974520_1002711297334503_7026414676209736084_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v5ljMr-9FYMQ7kNvwFxazQN&_nc_oc=AdmXG70wTLzxcg03HWauEgPuf7h6E1104t-Zp6A5fMDBMM0uSghW717wiDLti3x9Bmc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx6vCJ7RkU92g_GmRt_FsHTKmtYsqXwsVzkg7fdzsxAEw&oe=69BC0027"}, {"file_name": "final room 2560 x 1440.png", "id": "450754603860973", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974585_450754607194306_3396184327224578678_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-fbetymEKEQQ7kNvwGXwvYc&_nc_oc=Adn0wCApOLGTazMxXkB0WY1cOMjChTX03TfIt3AuGqb_0wO5zZvPSeZ6hGuF1Gx8UX0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzMhwaiF6TNAtrW8r39ejtOfIWeksJoAEb98Vqby1zH7A&oe=69BBF198"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "535391551416483", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75375748_535391554749816_2854941644077308396_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mabuSZwMpK0Q7kNvwHPjR5m&_nc_oc=AdlEAhoyboqyLz3ode8R7aVRCLpCl0qnNR-aLlj8XxSWu7an7c5H97NLHJ_Oq4PrguI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfydAKOxTpjtkjcAuYD0Oul0q7Vq-oizudYKurKd8K5Skw&oe=69BBF67D"}, "display_name": "Exit Condition One Early Access", "keywords": [], "long_description": "Note: This game is currently in early access. It is fully playable and fun, with around 2 hours of play time. A target of 3-4 hours of playtime and a price of $9.99 is planned for the finished game.\n\nYou awake from cryo in a weird sort of museum. A robot refers to you as a curator and the security system is malfunctioning. Can you get things back to normal and escape? There are no jump scares. The game is designed ground-up for roomscale VR on the Quest, but supports all locomotion modes. Most objects can be interacted with, it fully uses physics, and the hands don't \"ghost out.\"\n\nYou'll need to solve puzzles that include drone navigation, crafting, routing power, rewiring circuits, climbing, physically navigating mazes, and dancing. Some puzzles will have you moving in and out of AR and VR within the game itself. There are four main rooms and the final room is a \"boss level\" that contains the largest variety of puzzles.\n\nThere is still a bit of placeholder art and the story aspects are still in progress. Before purchasing, consider trying the polished demo, which is a single room with about 30 minutes of playtime. Updates can be expected at least twice a month and usually more often than that.\n\nhttps://discord.gg/2NfBumhKQD", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "deve
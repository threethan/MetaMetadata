nt-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_eA9X58NeJ5xOjsTRUqFF1Y3K0TfFcNdSRU0RduB5Jg&oe=6A8ACDC2"}, {"file_name": "7_ECO_Remastered_FinalBattle.png", "id": "1233526448448036", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491822581_1233526451781369_7479849779421110855_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HwT0SgH6TO4Q7kNvwG6wdRK&_nc_oc=Ado40z_UShGn7gReAabiQyHxLfsIxN-oe3o2d_pRH-uyPtB2wlqpx94J10yE7lRt4wU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFtJZfj6sfEXfYX3q6FKtOIADyPWCFHgDyqDTfvkGwttQ&oe=6A8AE190"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ExitConditionOne_MainCover_w_Captions 2560 x 1440 safe.png", "id": "1215321857033813", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619063_1215321860367146_683015123330448268_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A3P_GRR-3JgQ7kNvwFRxn7_&_nc_oc=AdoBrGcopcP3amzvzvWseUJG78Ye6e3QXsNaUPrILyQ0P5cbmTidM0AfVDLqWTq1J7M&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDQDxei3P8IG1DP6pyv95Txe0vywsShkGSjjQHrqzcVQ&oe=6A8AC7B6"}, "display_name": "Escape Room Exit Condition One HD", "keywords": ["escape", "scifi"], "long_description": "You'll need to overcome dozens of puzzling challenges by crafting tools, remote controlling drones, rewiring circuits, climbing, playing Match-3 games, shooting, and even dancing! There's five distinct levels expanding from a small chamber to a cathedral-like boss level.\n{1867939200771207}\nThere are 13 achievements, 4 collectible series, and dancing and match-3 based shooting mini-games unlocked along the way.\n{756005933743740}\nThere's even a chatty robot companion and if that's not enough you can talk to us on **Discord** here: https://discord.gg/hBcfWrezhD\n{2049227882550659}\nPlease note: roomscale mode requires a 3m x 2m guardian.", "short_description": "A roomscale puzzle adventure with escape room bones. Four main levels, a boss level, collectibles and a shooting mini-game. P
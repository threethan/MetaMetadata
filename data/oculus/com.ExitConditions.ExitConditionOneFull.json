358156072576_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nIyuKxi15GIQ7kNvwGEFp5Y&_nc_oc=AdmAG8Is9KxsI35znduwPyaO1QomGwfctjG_FftnLhdTGpnPLl_-O7e4U-Ck73PgyX4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy07I8Yz7IPr6DykH4B9KuoLg12qxHdWigMsY88piJKTw&oe=69B41360"}, {"file_name": "office build 90 2560 x 1440.png", "id": "1251024332433431", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974520_1251024335766764_4635200739085119148_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mAkVdDzug4YQ7kNvwH3KrxV&_nc_oc=AdlXBbzXnIjgCxw4HtiLfJOed42GHQA2X2uyX2__ymTFvM7YaDCXcBnS1-b0Vr6LXAg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfweqK5qwcR5p0wnzHzkh-9zHWmx2Zskm4A9shCLU-S6AA&oe=69B41EFE"}, {"file_name": "vr room build 90 2560 x 1440.png", "id": "702154417995674", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974545_702154421329007_1278873116692662506_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kpI1MTv_i9wQ7kNvwFEccf3&_nc_oc=AdnpUozkIEwMeblPzTDn_DzGSfdEZMUcIKBXmK9CbtJyUQBM7jayWOwv7KTkPojgqIg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx1EHpBUyNdmUwr4rekjuxFX9tdEyPCxxQCW1VoruY0hQ&oe=69B4100D"}, {"file_name": "boss build 90 2560 x 1440.png", "id": "1002711294001170", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974520_1002711297334503_7026414676209736084_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LJobpARIATsQ7kNvwGszPrw&_nc_oc=Adkcx1qv-npvitGYMOfaaHv62k2f8_aQV2hh7TBJpwxN89C7ntcWiFPMDXMzqWJQPlo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx0M5DwWi3-SDNQa9KEMf0x0KDjRFSd69Rxz-rsfdOdGg&oe=69B41727"}, {"file_name": "final room 2560 x 1440.png", "id": "450754603860973", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974585_450754607194306_3396184327224578678_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ww_R3S7k_GcQ7kNvwFtnnpx&_nc_oc=AdmscWFxlRmsUblmGsWO8nMDGGMIOlCWvv4KdhBai8jsiTD-h_Cw1BxNK3qF7E3Kwv8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx9pK4ByLOQ04PGWf-GO0746RD82YKvj9sJyZCMOOnyJQ&oe=69B40898"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "535391551416483", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75375748_535391554749816_2854941644077308396_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gGk2YWwEP38Q7kNvwGH-q6y&_nc_oc=AdkzOdiwfY9NjWWdzGeHgHSEmZrtmjLd_mUWGEG4WXo-1N52QQj_HHE2TUAxfUwYUMU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afzf_9y7y9kvzS3pxxlYosPQ9sL2bFvvWPZ3h0spveBadA&oe=69B40D7D"}, "display_name": "Exit Condition One Early Access", "keywords": [], "long_description": "Note: This game is currently in early access. It is fully playable and fun, with around 2 hours of play time. A target of 3-4 hours of playtime and a price of $9.99 is planned for the finished game.\n\nYou awake from cryo in a weird sort of museum. A robot refers to you as a curator and the security system is malfunctioning. Can you get things back to normal and escape? There are no jump scares. The game is designed ground-up for roomscale VR on the Quest, but supports all locomotion modes. Most objects can be interacted with, it fully uses physics, and the hands don't \"ghost out.\"\n\nYou'll need to solve puzzles that include drone navigation, crafting, routing power, rewiring circuits, climbing, physically navigating mazes, and dancing. Some puzzles will have you moving in and out of AR and VR within the game itself. There are four main rooms and the final room is a \"boss level\" that contains the largest variety of puzzles.\n\nThere is still a bit of placeholder art and the story aspects are still in progress. Before purchasing, consider trying the polished demo, which is a single room with about 30 minutes of playtime. Updates can be expected at least twice a month and usually more often than that.\n\nhttps://discord.gg/2NfBumhKQD", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "deve
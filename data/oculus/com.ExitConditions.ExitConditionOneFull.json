nt-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwsjSXzJgkxwhPsypUs4CuW4vEUlKmLzMS2wIh0OgpCSA&oe=69D12282"}, {"file_name": "7_ECO_Remastered_FinalBattle.png", "id": "1233526448448036", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822581_1233526451781369_7479849779421110855_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mwYMc5WFtioQ7kNvwHxhgqa&_nc_oc=Adpv56svUL2S3RdFcjOWbIDElaAVQW6ErGBNkz8J-_SGD6asE22hnF4ubL86GaxT51w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzCIU7Rks6FOZLnroAVlIGLNkDAktWY_Df7mAQTJ_b24Q&oe=69D0FE10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ExitConditionOne_MainCover_w_Captions 2560 x 1440 safe.png", "id": "1215321857033813", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619063_1215321860367146_683015123330448268_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XPa9LigQ1MQQ7kNvwH-XYRS&_nc_oc=AdpW-KkpO9vDcsb_qJPykLdqT-pgOIaWsPMtIXirlub-uT9eDqM6D1sSl4-pcIrtUT8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxkurF4LvHbs9VGJ4b3DDPecnuOsfvDfccUrzFZ8ITyMg&oe=69D11C76"}, "display_name": "Escape Room Exit Condition One HD", "keywords": ["escape", "scifi"], "long_description": "You'll need to overcome dozens of puzzling challenges by crafting tools, remote controlling drones, rewiring circuits, climbing, playing Match-3 games, shooting, and even dancing! There's five distinct levels expanding from a small chamber to a cathedral-like boss level.\n{1867939200771207}\nThere are 13 achievements, 4 collectible series, and dancing and match-3 based shooting mini-games unlocked along the way.\n{756005933743740}\nThere's even a chatty robot companion and if that's not enough you can talk to us on **Discord** here: https://discord.gg/hBcfWrezhD\n{2049227882550659}\nPlease note: roomscale mode requires a 3m x 2m guardian.", "short_description": "A roomscale puzzle adventure with escape room bones. Four main levels, a boss level, collectibles and a shooting mini-game. P
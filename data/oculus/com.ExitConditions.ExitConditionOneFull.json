358156072576_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nIyuKxi15GIQ7kNvwEpHZR6&_nc_oc=AdkrfEoCd7i7ZalMCDewocJNjxBHzJ4S2mkv7KmH9It2ht61IH88AZzT35cQSw3JGGM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afyab3GuHvseD436OOMTK_aO5pJNO5PLkWdadYj0fLc00g&oe=69B564E0"}, {"file_name": "office build 90 2560 x 1440.png", "id": "1251024332433431", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974520_1251024335766764_4635200739085119148_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mAkVdDzug4YQ7kNvwE6YWJb&_nc_oc=AdkCK29AfAKvREZzETwdC8UNHrd_vCRXvVt_Ff3QXeiAkT5UPLfAw1AnubBNxFrUtAo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzrEsyC8C3yOApNtsjosp00xGu7sbvz9vq4liZu56sEeQ&oe=69B5707E"}, {"file_name": "vr room build 90 2560 x 1440.png", "id": "702154417995674", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974545_702154421329007_1278873116692662506_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VLUqvU01BKQQ7kNvwHAdD2i&_nc_oc=AdkjZ_L4Gb7JdyhSOKerzYDUR1YPYYYFRJYvmBPcjycmlqtTnFH6Qz4YLdtpWPvxVqE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyE1CRbbExoaYdrGMKSF2jazH_jGYc3F2-IYIthR9F6rw&oe=69B5618D"}, {"file_name": "boss build 90 2560 x 1440.png", "id": "1002711294001170", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974520_1002711297334503_7026414676209736084_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oUhkzIzuWEEQ7kNvwFeH05H&_nc_oc=AdnSacHaiL9_Ez_uKNxZ4wCWdVpFBYsX0ZoyoFhfPtjsxwLTiG0dW51uuuf-saAZoeM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfywXsNFHCr_GfXJ3oaw3vkQHvSrH__Xs5hfGY6lcbcpGw&oe=69B568A7"}, {"file_name": "final room 2560 x 1440.png", "id": "450754603860973", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974585_450754607194306_3396184327224578678_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ww_R3S7k_GcQ7kNvwHghLWt&_nc_oc=Adn2S3pC-Wh-2xtArOjXhmWvB6gznWNaqn2ZnstJ1sVgVUrYbWMxHBuhVwWwIPCpB6Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxlgxCQicRnztMB6F1h-LS8XnlmYr-8fVuIrQsx_YHfXw&oe=69B55A18"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "535391551416483", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75375748_535391554749816_2854941644077308396_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pN5fHuZIIsQQ7kNvwEX1plI&_nc_oc=Adl9qdgmiaOrafUIuhEYV6VLQeOqQ0oXT2fD4OtvsVrcPJljsVJY4_GkTNhl_AtyunI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxVaa5OhV8Vrvp-wZ_MXAJxSGCDJhB2gTqfOfP8RDGIyw&oe=69B55EFD"}, "display_name": "Exit Condition One Early Access", "keywords": [], "long_description": "Note: This game is currently in early access. It is fully playable and fun, with around 2 hours of play time. A target of 3-4 hours of playtime and a price of $9.99 is planned for the finished game.\n\nYou awake from cryo in a weird sort of museum. A robot refers to you as a curator and the security system is malfunctioning. Can you get things back to normal and escape? There are no jump scares. The game is designed ground-up for roomscale VR on the Quest, but supports all locomotion modes. Most objects can be interacted with, it fully uses physics, and the hands don't \"ghost out.\"\n\nYou'll need to solve puzzles that include drone navigation, crafting, routing power, rewiring circuits, climbing, physically navigating mazes, and dancing. Some puzzles will have you moving in and out of AR and VR within the game itself. There are four main rooms and the final room is a \"boss level\" that contains the largest variety of puzzles.\n\nThere is still a bit of placeholder art and the story aspects are still in progress. Before purchasing, consider trying the polished demo, which is a single room with about 30 minutes of playtime. Updates can be expected at least twice a month and usually more often than that.\n\nhttps://discord.gg/2NfBumhKQD", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "deve
nt-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN6SE3NGFuP76SJJRHhN5uZO-UVtN6g4gXgz0qKXzuLnw&oe=6AE5FD82"}, {"file_name": "7_ECO_Remastered_FinalBattle.png", "id": "1233526448448036", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822581_1233526451781369_7479849779421110855_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P9tsLwarhX0Q7kNvwHrtQJC&_nc_oc=AdppFUqWFweBCyZ43w_nrz3kICPe56af5ciaqj5rU_ZpyhzEa5yWpcQk8ulDcWFgW-w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNAkdscnSx6cXMGlY5EgOhCsK1i2FJ0UP3WROBB6KEatg&oe=6AE61150"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ExitConditionOne_MainCover_w_Captions 2560 x 1440 safe.png", "id": "1215321857033813", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619063_1215321860367146_683015123330448268_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KhST8wDyemIQ7kNvwEeKjM6&_nc_oc=AdqE5YSoDIKqepipZMU3-AazlQUfKygb2yNpJ9-EhFDsCrOjsKoLw03umXygJyBIjKc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMdrJXc8oEHXgL44o_Tn86z6V_j8coUlYhKIx6plzvIxg&oe=6AE5F776"}, "display_name": "Escape Room Exit Condition One HD", "keywords": ["escape", "scifi", "room", "adventure", "puzzle"], "long_description": "You'll need to overcome dozens of puzzling challenges by crafting tools, remote controlling drones, rewiring circuits, climbing, playing Match-3 games, shooting, and even dancing! There's five distinct levels expanding from a small chamber to a cathedral-like boss level.\n{1867939200771207}\nThere are 13 achievements, 4 collectible series, and dancing and match-3 based shooting mini-games unlocked along the way.\n{756005933743740}\nThere's even a chatty robot companion and if that's not enough you can talk to us on **Discord** here: https://discord.gg/hBcfWrezhD\n{2049227882550659}\nPlease note: roomscale mode requires a 3m x 2m guardian.", "short_description": "A roomscale puzzle adventure with escape room bones. Four main levels, a boss level, collectib
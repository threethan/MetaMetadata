358156072576_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SGcnwujwt4YQ7kNvwGPiXq5&_nc_oc=AdnU6GmblmBj16tNRGXRtKRaAVkmWBZ39JspLbt8bsCLgh5gC5SUQRIlyVMOOsGKcj8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzfph4Uu_47JjlrpNinBRPcfxs_SMs5QxXVJMslk0CadQ&oe=69B01EE0"}, {"file_name": "office build 90 2560 x 1440.png", "id": "1251024332433431", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974520_1251024335766764_4635200739085119148_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gb-QwBrtwz4Q7kNvwFPHGT7&_nc_oc=AdkfKVIO_6nqZIeSXbGNrVt8YsZxOED6QYQsEEOP4wTqSv70YEZipTuXT59GiqB4CNw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzRM61bPRG9uhe48XD4JjhiiFi_f3rouDvprhu1P4vwgw&oe=69B02A7E"}, {"file_name": "vr room build 90 2560 x 1440.png", "id": "702154417995674", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974545_702154421329007_1278873116692662506_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f1R1QzMGeQIQ7kNvwEZOqq4&_nc_oc=AdlMzG3ra_jMJaoP_ArQvftmXTTxTngG_AyaSeWgF-w-j51M56y7M8zMkIbUrk1Xzog&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwSzj1G1jwm4_22KDq8oK6GbU1-I8f6GwnzuIEnix_gng&oe=69B01B8D"}, {"file_name": "boss build 90 2560 x 1440.png", "id": "1002711294001170", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974520_1002711297334503_7026414676209736084_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t3a7R92l_cAQ7kNvwE2W2mO&_nc_oc=AdkbJQiuB6wflGzsnTmvFX5g_g3tygcROdggu4_CrjgB78uYsWQICjQv_3crUavW6A0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxv-BQ3-Fn2ZdaESmVJoU5yYa2es59pVI7T1XmpLzvqFQ&oe=69B022A7"}, {"file_name": "final room 2560 x 1440.png", "id": "450754603860973", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974585_450754607194306_3396184327224578678_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qsp9jZ-K97kQ7kNvwFInlI_&_nc_oc=AdkId3_La2WQ-hbahyJ5ieOoR_aJFPJXStVynMlTT66kpjLKUrkoY9TE3xKNfr-Qlbc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxtclcsK-uWCxYDL46cls2uEyOmSD3K0_lCDgnDoErDKw&oe=69B01418"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 thumbnail.png", "id": "535391551416483", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75375748_535391554749816_2854941644077308396_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gZGpTJzMUgQQ7kNvwGWFisO&_nc_oc=AdmiJtOLa0qu4Wkj_WhnmFBx4CH8UUVO7WVxmJocwORmopl_OBcXR3XNOGHNFLeyme0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwW04B2CQXmi1_MnAmpjB66AMhOPxWtCFNtt-XLzoB9sw&oe=69B018FD"}, "display_name": "Exit Condition One Early Access", "keywords": [], "long_description": "Note: This game is currently in early access. It is fully playable and fun, with around 2 hours of play time. A target of 3-4 hours of playtime and a price of $9.99 is planned for the finished game.\n\nYou awake from cryo in a weird sort of museum. A robot refers to you as a curator and the security system is malfunctioning. Can you get things back to normal and escape? There are no jump scares. The game is designed ground-up for roomscale VR on the Quest, but supports all locomotion modes. Most objects can be interacted with, it fully uses physics, and the hands don't \"ghost out.\"\n\nYou'll need to solve puzzles that include drone navigation, crafting, routing power, rewiring circuits, climbing, physically navigating mazes, and dancing. Some puzzles will have you moving in and out of AR and VR within the game itself. There are four main rooms and the final room is a \"boss level\" that contains the largest variety of puzzles.\n\nThere is still a bit of placeholder art and the story aspects are still in progress. Before purchasing, consider trying the polished demo, which is a single room with about 30 minutes of playtime. Updates can be expected at least twice a month and usually more often than that.\n\nhttps://discord.gg/2NfBumhKQD", "short_description": "Roomscale Escape Room"}]}, "developer_name": null, "deve
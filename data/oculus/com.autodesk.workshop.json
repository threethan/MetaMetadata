24343433476287_8918942951199295624_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U7iumtQNETAQ7kNvwESgxpn&_nc_oc=AdpJU6KTT2sOvCx6KkV1117YITXndDdh5ma5Jrwf2fpquOz4sGHOmGzC6pysau_Z9qk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3uXRTZa9ZJnfiCKzz4kH-hUi0JziUM4w0ZTqBssp0qnA&oe=69E8C4DD"}, {"file_name": "4-Workshop Image.png", "id": "999692381122745", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984460_999692384456078_4612545688317797888_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-QHDPOc7dWMQ7kNvwFN6y59&_nc_oc=Adq5J4AKS3jJzTa6lECbUnrz1_iJgSNW72RDdQZNnyxzQyVpD2pGLPbNeVFx4FpcJnY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2sU2QrXauduWD-IaekOqw-hx3fdSAWvsePmfwGHzcZmg&oe=69E8BDFC"}, {"file_name": "5-Issue Management Image.png", "id": "965478264755779", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974639_965478268089112_4308866345139591421_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sBAOe5TO26IQ7kNvwHgHHGP&_nc_oc=AdrAodsgyHgICzOwkskclt0M575OSik6OyddyJChLMAqrAvuZMrgmpR1kMCIgiVeIjg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3te1n0ywSZJrAV3WXkFF0qd_iFtg6dCHmUC51SOacelg&oe=69E8DF1B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Workshop XR", "keywords": [], "long_description": "ONLY AVAILABLE FOR LICENSED USERS. Sign up for the waitlist to stay updated when Workshop XR is available for you. Visit workshopxr.autodesk.com to learn more and request a free trial.\n__ \nAutodesk Workshop XR is an immersive workspace for Autodesk Construction Cloud where AEC teams can review and collaborate in their 3D models to track issues, catch errors, and enable better spatial understanding.\n\nWith automatically connected data, no-prep model streaming, and synced issue tracking, Workshop XR makes design reviews frictionless and efficient.\n\n**v1.0**\n\n- Load Revit or Navisworks Models from ACC into VR\n- Meet in a collaborative workshop with team members\n- Access supported ACC data like Files, Issues, and Model Browser Settings\n- Track and create issues\n\nAutodesk Workshop XR is compatible with Meta Quest 2, Meta Quest Pro, and Meta Quest 3.\n__ \nFOR LICENSED USERS ONLY \n(Visit workshopxr.autodesk.com to learn more and request a free trial.)", "short_description": "Immersive workspace for Autodesk Construction Cloud | Review and collaborate in your 3D models."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.autodesk.com/company/legal-notices-trademarks/privacy-statement", "developer_terms_of_service_url": null, "publisher_name": "Autodesk, Inc.", "support_website_url": null, "website_url": "https://workshopxr.autodesk.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "1309326339782559"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1283496769325380"}, {"status": "PUBLISHED", "id": "1986824868356221"}]}, "baseline_offer": {"id": "1283496769325380"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1741971960, "status": "PUBLISHED", "id": "1283496769325380"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26141708718844641", "version": "2.19.25"}, "id": "1103341383989130", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only":
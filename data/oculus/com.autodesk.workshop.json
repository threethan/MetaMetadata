vNhB2VTJBgQ7kNvwF1UQv3&_nc_oc=AdqYe0Qz5L10PUuG2MwwBoIVNElMrAeVaXWxFtoMoP249pJSET2z9xy-x0Qwzx_R3SY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGhIJv5NAhRXIkMz8YctYGi1v1uUrRvffJk4ZAzR4fQmg&oe=6A8D897C"}, {"file_name": "5-Issue Management Image.png", "id": "965478264755779", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974639_965478268089112_4308866345139591421_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=swIKexnChqIQ7kNvwGFQzf_&_nc_oc=Ado2DFXjqeF-xYuHViE3Ks7HKO2zV8f_GWbDywAXU06kJecTWNBtOhjtpctPjUH8Xjs&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE62N_WwQe6Z7rGXMy4rnBTwVWTMBJAo6N6LFak6RJtww&oe=6A8D725B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Workshop XR", "keywords": [], "long_description": "ONLY AVAILABLE FOR LICENSED USERS. Sign up for the waitlist to stay updated when Workshop XR is available for you. Visit workshopxr.autodesk.com to learn more and request a free trial.\n__ \nAutodesk Workshop XR is an immersive workspace for Autodesk Construction Cloud where AEC teams can review and collaborate in their 3D models to track issues, catch errors, and enable better spatial understanding.\n\nWith automatically connected data, no-prep model streaming, and synced issue tracking, Workshop XR makes design reviews frictionless and efficient.\n\n**v1.0**\n\n- Load Revit or Navisworks Models from ACC into VR\n- Meet in a collaborative workshop with team members\n- Access supported ACC data like Files, Issues, and Model Browser Settings\n- Track and create issues\n\nAutodesk Workshop XR is compatible with Meta Quest 2, Meta Quest Pro, and Meta Quest 3.\n__ \nFOR LICENSED USERS ONLY \n(Visit workshopxr.autodesk.com to learn more and request a free trial.)", "short_description": "Immersive workspace for Autodesk Construction Cloud | Review and collaborate in your 3D models."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.autodesk.com/company/legal-notic
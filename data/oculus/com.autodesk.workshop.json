/499618400_1429848734848842_1630443177490495162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QK_ldcEog4EQ7kNvwErS1GQ&_nc_oc=AdoO2AfQpwqLONQdvU_Kn3kkXj5VeSelsN9VWMB7rw2PrKoZrN9EYHuTvDC7deg8nks&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2UqXsiyBb8oU3oJS_tfoX_LlnR3KVBwMApCK0uWc_tqg&oe=69EA1F1B"}, {"file_name": "9-Easily-inspect-BIM-properties.png", "id": "1687251795253914", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617706_1687251798587247_8509653498830603313_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wcOBpe5z6PcQ7kNvwHTSQY8&_nc_oc=AdpKjnT8y9q8kRzwi3a-EpUxtFNaK66OYBnG79VHkwla86eoQ9vRaSOp0uBp_w-BGEw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1eUYkNwT7q-SCFPHn5ztyrYxHuIqAHnf2PtA7ctzvswA&oe=69EA059A"}, {"file_name": "2.0 Avatars Claridges Console.png", "id": "1337520514243630", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391969_1337520517576963_5948801512705426850_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GZKyrAWqwNQQ7kNvwHa1jp4&_nc_oc=Adr_YfCL0FJ0KoZmPgnzLv2b9I94EjquKYMa1vwebV5xgYVk5aeXMvrYcApRJT1oO4k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ioEM2D0IMPPlcZ3eTWgtjHR-q9JBgEaNue2wzwqA0mA&oe=69EA2A1F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1000032637.png", "id": "1066395218351378", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001695_1066395221684711_7831929589683911492_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Ipn-aNLQM8Q7kNvwHMpchT&_nc_oc=Adq0Qge62uVIrr_ZwHgGr6fZL5Hsg3InDXHGifuI8QE48nAIvTl-2HTb2PCi6MtPI3k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af16CNylNyPj__cNan64vcCctpwSrCm1qM9d-ByGjCedgQ&oe=69EA1B96"}, "display_name": "Autodesk Workshop XR", "keywords": ["Revit", "Navisworks", "Autodesk", "Design", "Review"], "long_description": "AUTODESK WORKSHOP XR LICENSE REQUIRED FOR USE. Start your free trial at http://www.autodesk.com/workshopxr \n\n \n\nAutodesk Workshop XR enables AEC teams to gain spatial clarity and identify issues sooner by collaboratively walking through projects at human scale\u2013 before construction even begins.  \n\n  \n\nBy seamlessly connecting Autodesk Construction (ACC) cloud data for on-demand VR reviews with real-time issue management, Workshop XR accelerates design reviews, helping teams reduce costly rework, speed up project delivery, and minimize waste. \n\n \n\n**Capabilities**  \n\n- Load Revit, Navisworks or IFC models from your ACC Projects into VR  \n\n- Meet in a collaborative workshop with team members  \n\n- Review your project with your team at 1:1 or dollhouse scale  \n\n- Access ACC Project data  \n\n- Create and manage issues in VR  \n\n- Take 3D measurements  \n\n- Inspect model properties  \n\n- Join an ongoing VR session through your web browser\n\n- Access and review snapshots from model coordination\n\n__  \n\n \n\nFOR LICENSED USERS ONLY (Visit http://www.autodesk.com/workshopxr to learn more and request a free trial.) ", "short_description": "Immersive workspace, connected to Autodesk Construction Cloud | Review and collaborate in your 3D models."}]}, "developer_name": "Autodesk, Inc.", "developer_privacy_policy_url": "https://www.autodesk.com/company/legal-notices-trademarks/privacy-statement", "developer_terms_of_service_url": null, "publisher_name": "Autodesk, Inc.", "support_website_url": null, "website_url": "http://www.autodesk.com/workshopxr", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUC
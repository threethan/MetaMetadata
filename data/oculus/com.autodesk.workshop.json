u4Q7kNvwEsRv9H&_nc_oc=Adq_WDuZCLN5S-89MBb_LwaBJZFnNqsG-OgCo1YyapgZmh6HkdNt0S6TiFPkUk3Dlgo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInfH1gweswE170LRbTI-LKzrEGdtJY1P8TnvFlFNvlaw&oe=6AABDBFC"}, {"file_name": "5-Issue Management Image.png", "id": "965478264755779", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974639_965478268089112_4308866345139591421_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LDRgpFTekAcQ7kNvwHPIYsw&_nc_oc=AdpzzI-mtDzGiOYukzgGNfgweMeVYdYyR4BGbvtuLWvCX8SV2CgVuGvIP4_Mnqs8Ld8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJD92YdVoEatfZ8oCkwHTsqE3ywInWZbBTtdWb2Fg_Dw&oe=6AABFD1B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Workshop XR", "keywords": [], "long_description": "ONLY AVAILABLE FOR LICENSED USERS. Sign up for the waitlist to stay updated when Workshop XR is available for you. Visit workshopxr.autodesk.com to learn more and request a free trial.\n__ \nAutodesk Workshop XR is an immersive workspace for Autodesk Construction Cloud where AEC teams can review and collaborate in their 3D models to track issues, catch errors, and enable better spatial understanding.\n\nWith automatically connected data, no-prep model streaming, and synced issue tracking, Workshop XR makes design reviews frictionless and efficient.\n\n**v1.0**\n\n- Load Revit or Navisworks Models from ACC into VR\n- Meet in a collaborative workshop with team members\n- Access supported ACC data like Files, Issues, and Model Browser Settings\n- Track and create issues\n\nAutodesk Workshop XR is compatible with Meta Quest 2, Meta Quest Pro, and Meta Quest 3.\n__ \nFOR LICENSED USERS ONLY \n(Visit workshopxr.autodesk.com to learn more and request a free trial.)", "short_description": "Immersive workspace for Autodesk Construction Cloud | Review and collaborate in your 3D models."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.autodesk.com/company/legal-notices-trade
c_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Otw0_LQbVn0Q7kNvwH96mh-&_nc_oc=AdrETXtbElMIyEBk66iCyMkXH3Oow_o32eGSvoXkJU8jhYnB5WrxEFrhaAtQNU5wMwI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6YaysJmN_tenO5xw-Bo6K21_HJPnarThGzMqBl4OIR9g&oe=6A048E9B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Workshop XR", "keywords": [], "long_description": "ONLY AVAILABLE FOR LICENSED USERS. Sign up for the waitlist to stay updated when Workshop XR is available for you. Visit workshopxr.autodesk.com to learn more and request a free trial.\n__ \nAutodesk Workshop XR is an immersive workspace for Autodesk Construction Cloud where AEC teams can review and collaborate in their 3D models to track issues, catch errors, and enable better spatial understanding.\n\nWith automatically connected data, no-prep model streaming, and synced issue tracking, Workshop XR makes design reviews frictionless and efficient.\n\n**v1.0**\n\n- Load Revit or Navisworks Models from ACC into VR\n- Meet in a collaborative workshop with team members\n- Access supported ACC data like Files, Issues, and Model Browser Settings\n- Track and create issues\n\nAutodesk Workshop XR is compatible with Meta Quest 2, Meta Quest Pro, and Meta Quest 3.\n__ \nFOR LICENSED USERS ONLY \n(Visit workshopxr.autodesk.com to learn more and request a free trial.)", "short_description": "Immersive workspace for Autodesk Construction Cloud | Review and collaborate in your 3D models."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.autodesk.com/company/legal-notices-trademarks/privacy-statement", "developer_terms_of_service_url": null, "publisher_name": "Autodesk, Inc.", "support_website_url": null, "website_url": "https://workshopxr.autodesk.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscr
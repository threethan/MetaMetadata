90495162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GcEz5J5legwQ7kNvwH0TrH0&_nc_oc=AdrmAclnFdgS7QekM59HisSgITDHYPNXvdDuN_Gem83Q62i1_-nHL7Nq4sEHgxX5PgA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1sXOeo_ELRr58UypsFh7zswyf8-zGu1oaTO-eMIf4etw&oe=69F2081B"}, {"file_name": "9-Easily-inspect-BIM-properties.png", "id": "1687251795253914", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499617706_1687251798587247_8509653498830603313_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fHMNaft7YfsQ7kNvwF-6QqL&_nc_oc=AdprsUInIpKve8UoMvJiXyHu5P4MuUfUxm8Ieq9POPkF4Kg3qrEP_KiOVHxB3rZxc7Y&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1BFrYCFNGPhQCOHEaAxvHvmPZqTEr_Deqmq8rq91l_pw&oe=69F1EE9A"}, {"file_name": "2.0 Avatars Claridges Console.png", "id": "1337520514243630", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391969_1337520517576963_5948801512705426850_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=53qxXIo3puIQ7kNvwGCis8V&_nc_oc=AdrUP9h5-0X-OoNKRXKYzw3DuibhCxRNGNwQCEgDHi4Co_g-M4adtJ-9_TBhkY9nkOs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3Hfc8kGIFCQ_molhzxc4HZyPgVXCX0Me2mz_KucqPmEA&oe=69F2131F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1000032637.png", "id": "1066395218351378", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001695_1066395221684711_7831929589683911492_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ccHQUMvauREQ7kNvwH9k4nU&_nc_oc=Ado2N5PwXBxHXsx4VbmxROsifZLzO4K8yp6B4jci5rJroqw3dDG1x944PbIbxaq_Q1k&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1YCnletvbPffBNgTt8Jgx9Xz4qOF7MpM8kXglKvInIkw&oe=69F20496"}, "display_name": "Autodesk Workshop XR", "keywords": ["Revit", "Navisworks", "Autodesk", "Design", "Review"], "long_description": "AUTODESK WORKSHOP XR LICENSE REQUIRED FOR USE. Start your free trial at http://www.autodesk.com/workshopxr \n\n \n\nAutodesk Workshop XR enables AEC teams to gain spatial clarity and identify issues sooner by collaboratively walking through projects at human scale\u2013 before construction even begins.  \n\n  \n\nBy seamlessly connecting Autodesk Construction (ACC) cloud data for on-demand VR reviews with real-time issue management, Workshop XR accelerates design reviews, helping teams reduce costly rework, speed up project delivery, and minimize waste. \n\n \n\n**Capabilities**  \n\n- Load Revit, Navisworks or IFC models from your ACC Projects into VR  \n\n- Meet in a collaborative workshop with team members  \n\n- Review your project with your team at 1:1 or dollhouse scale  \n\n- Access ACC Project data  \n\n- Create and manage issues in VR  \n\n- Take 3D measurements  \n\n- Inspect model properties  \n\n- Join an ongoing VR session through your web browser\n\n- Access and review snapshots from model coordination\n\n__  \n\n \n\nFOR LICENSED USERS ONLY (Visit http://www.autodesk.com/workshopxr to learn more and request a free trial.) ", "short_description": "Immersive workspace, connected to Autodesk Construction Cloud | Review and collaborate in your 3D models."}]}, "developer_name": "Autodesk, Inc.", "developer_privacy_policy_url": "https://www.autodesk.com/company/legal-notices-trademarks/privacy-statement", "developer_terms_of_service_url": null, "publisher_name": "Autodesk, Inc.", "support_website_url": null, "website_url": "http://www.autodesk.com/workshopxr", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "26026348350380679"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86613165_140343355821986_8651146829085167166_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RYGzt7mGRm0Q7kNvwESr4R6&_nc_oc=Adoi_ayfn-0expQ3NgNV6aJlYOMgyL7IVJxCcg9fbc0Wl159WcILg695gLBoanzxmQ4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3R4bCTL0I54tslTKMYocOTfW8lw6VPUnD8VJhD13_c_g&oe=69F20011"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Autodesk Workshop XR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Productivity", "id": "1063584910766706"}, {"topic_name": "Creativity", "id": "1819021644882647"}], "release_date": 1709830800, "lastRevision": {"nodes": [{"id": "6311586882283452", "release_type": "MANAGED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "6311586865616787", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "691982826308947"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "AutodeskWorkshopXR_Icon.png", "id": "1141472113504422", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031336_1141472116837755_3818497714176144045_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SVNs9pRTRQAQ7kNvwE1NXlZ&_nc_oc=AdqrCEwvpetbMec7d73jj_EmZxX8swqCrqcGGjJa-4xtIvktw28s9yjGxOQjI1FpPNY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3ei1qG_1NbQBFwIDxQqIBDBJWXdYhTdS3-WbY9wWOC_A&oe=69F1F424"}, {"file_name": "AutodeskWorkshopXR_Landscape.png", "id": "899348434944280", "image_type": "APP_IMG_COVER_LANDSCAPE", "u
legwQ7kNvwE9vIR1&_nc_oc=AdqOk--g5aV5MYufvTlpH_Z2X8hDRvWeE877p_UC2zT0s8vWiTaYXJ-EPG7tmu3nsG8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3s2EJgPmAXZXonK-UEc4kx57KFJ8Xbsk91oJbAqqO1rg&oe=69F0B69B"}, {"file_name": "9-Easily-inspect-BIM-properties.png", "id": "1687251795253914", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617706_1687251798587247_8509653498830603313_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NFbzXp4snVYQ7kNvwEuKHos&_nc_oc=AdrvJO9ifjJiSwv1rWUMm5znvfNLT_QZA0AeuVEMcKXVX_FxLV0ZRi-vW-BG2S6lSiw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af3oZTBjC_E_l3bMCCEImYIqqdRgK6zdmMMo_55j1ZnBnQ&oe=69F09D1A"}, {"file_name": "2.0 Avatars Claridges Console.png", "id": "1337520514243630", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391969_1337520517576963_5948801512705426850_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=53qxXIo3puIQ7kNvwFas5Wd&_nc_oc=Adpbo6B-jdW5vnEz0Fw42n1TLNNa9kJoCO5g24QYp1cDiF2FlUOvydKuszwdcrQfGWE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af32XMUVFLtLVOt3NA-Vh1PqWM0xJ4pu25T9d9cI6txdVw&oe=69F0C19F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1000032637.png", "id": "1066395218351378", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001695_1066395221684711_7831929589683911492_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ccHQUMvauREQ7kNvwEtOGRK&_nc_oc=AdqLKu_EToJFxK664rpwMaLJDLU5YILWe7-6glGEmC7taOPxIhWGdZupJ9gmBLnwGQ0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3gskrvULge_txm-MIfoTLDAu2shT1xjh90q6kPOQ9sMA&oe=69F0B316"}, "display_name": "Autodesk Workshop XR", "keywords": ["Revit", "Navisworks", "Autodesk", "Design", "Review"], "long_description": "AUTODESK WORKSHOP XR LICENSE REQUIRED FOR USE. Start your free trial at http://www.autodesk.com/workshopxr \n\n \n\nAutodesk Workshop XR enables AEC teams to gain spatial clarity and identify issues sooner by collaboratively walking through projects at human scale\u2013 before construction even begins.  \n\n  \n\nBy seamlessly connecting Autodesk Construction (ACC) cloud data for on-demand VR reviews with real-time issue management, Workshop XR accelerates design reviews, helping teams reduce costly rework, speed up project delivery, and minimize waste. \n\n \n\n**Capabilities**  \n\n- Load Revit, Navisworks or IFC models from your ACC Projects into VR  \n\n- Meet in a collaborative workshop with team members  \n\n- Review your project with your team at 1:1 or dollhouse scale  \n\n- Access ACC Project data  \n\n- Create and manage issues in VR  \n\n- Take 3D measurements  \n\n- Inspect model properties  \n\n- Join an ongoing VR session through your web browser\n\n- Access and review snapshots from model coordination\n\n__  \n\n \n\nFOR LICENSED USERS ONLY (Visit http://www.autodesk.com/workshopxr to learn more and request a free trial.) ", "short_description": "Immersive workspace, connected to Autodesk Construction Cloud | Review and collaborate in your 3D models."}]}, "developer_name": "Autodesk, Inc.", "developer_privacy_policy_url": "https://www.autodesk.com/company/legal-notices-trademarks/privacy-statement", "developer_terms_of_service_url": null, "publisher_name": "Autodesk, Inc.", "support_website_url": null, "website_url": "http://www.autodesk.com/workshopxr", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"
9F0ADDD"}, {"file_name": "4-Workshop Image.png", "id": "999692381122745", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984460_999692384456078_4612545688317797888_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_g_jZzB0azIQ7kNvwEPd_h3&_nc_oc=AdpK4SaKtf-cK8A340Fs8A2tHRDpvZmbUpoZXWa7cnPqDhuuKVwtQ9HUkb3SA7f8nM4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2NYzqxgJ-ch7ihLZyPN0qLfLyHSDwcd_bZUlYOk6bj7Q&oe=69F0A6FC"}, {"file_name": "5-Issue Management Image.png", "id": "965478264755779", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974639_965478268089112_4308866345139591421_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YhRJSkT1yScQ7kNvwFoyz-g&_nc_oc=Adp49sixGruQ-SHv0jlglaG1pM0uRHFrYF0ihbDHfhlRXvRcHNcCFl9fwCPI2KExRTw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1x87kFtS8RON-_0ABvWqzw4UP_5xC8Ti5hEKUAKl8qWg&oe=69F0C81B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Workshop XR", "keywords": [], "long_description": "ONLY AVAILABLE FOR LICENSED USERS. Sign up for the waitlist to stay updated when Workshop XR is available for you. Visit workshopxr.autodesk.com to learn more and request a free trial.\n__ \nAutodesk Workshop XR is an immersive workspace for Autodesk Construction Cloud where AEC teams can review and collaborate in their 3D models to track issues, catch errors, and enable better spatial understanding.\n\nWith automatically connected data, no-prep model streaming, and synced issue tracking, Workshop XR makes design reviews frictionless and efficient.\n\n**v1.0**\n\n- Load Revit or Navisworks Models from ACC into VR\n- Meet in a collaborative workshop with team members\n- Access supported ACC data like Files, Issues, and Model Browser Settings\n- Track and create issues\n\nAutodesk Workshop XR is compatible with Meta Quest 2, Meta Quest Pro, and Meta Quest 3.\n__ \nFOR LICENSED USERS ONLY \n(Visit workshopxr.autodesk.com to learn more and request a free trial.)", "short_description": 
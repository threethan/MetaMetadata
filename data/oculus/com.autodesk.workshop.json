/499618400_1429848734848842_1630443177490495162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BZqoakbqZxgQ7kNvwFQOfw3&_nc_oc=AdpHoOKgM8QR3WBc4puWSBDagps4DHsztmHjuEHP1y-FTw3Wl8ZxA_WndeGmfEDMu80&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0gbbY9E36Gv9Ws4zbq7IAV1XPVY42kPkzrX6dieFed8w&oe=69E62A9B"}, {"file_name": "9-Easily-inspect-BIM-properties.png", "id": "1687251795253914", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499617706_1687251798587247_8509653498830603313_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lPDN3-eMlHEQ7kNvwEF9h2m&_nc_oc=AdrQ5N0JywgCllN6SZuM-qrIoeFA0p7OWClKgmbp3QtEWuR0bikmp5JpCoEDuaxruh8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0B2q2mPEW1N-QEFQQJX3C_HmIRYsix54oTYkmfyr77Qw&oe=69E6495A"}, {"file_name": "2.0 Avatars Claridges Console.png", "id": "1337520514243630", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391969_1337520517576963_5948801512705426850_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zb2QwzqObIQQ7kNvwETRpN5&_nc_oc=Adr60mxIxLD9SV6ajK3v58dhJVBu3wDTChHxZqXULD9507vdIFO8XDdRgyMKqndXQ6Y&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0DpijpymZkhTg4wVhA3cJw5VaA1fHfqGDLDFVsRaXnEQ&oe=69E6359F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1000032637.png", "id": "1066395218351378", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001695_1066395221684711_7831929589683911492_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ipZMyV4muuQQ7kNvwEc8hMK&_nc_oc=AdoUfYOYEsD5mhT91oS5klxLXYKbY2vYmk_Qz_T256VtEv2t4dODJWT1f3P9bWq_7Is&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1cQxDQz3-elaWm28ob-E4y-m4P90vn3RQCkoxUPPQCWA&oe=69E62716"}, "display_name": "Autodesk Workshop XR", "keywords": ["Revit", "Navisworks", "Autodesk", "Design", "Review"], "long_description": "AUTODESK WORKSHOP XR LICENSE REQUIRED FOR USE. Start your free trial at http://www.autodesk.com/workshopxr \n\n \n\nAutodesk Workshop XR enables AEC teams to gain spatial clarity and identify issues sooner by collaboratively walking through projects at human scale\u2013 before construction even begins.  \n\n  \n\nBy seamlessly connecting Autodesk Construction (ACC) cloud data for on-demand VR reviews with real-time issue management, Workshop XR accelerates design reviews, helping teams reduce costly rework, speed up project delivery, and minimize waste. \n\n \n\n**Capabilities**  \n\n- Load Revit, Navisworks or IFC models from your ACC Projects into VR  \n\n- Meet in a collaborative workshop with team members  \n\n- Review your project with your team at 1:1 or dollhouse scale  \n\n- Access ACC Project data  \n\n- Create and manage issues in VR  \n\n- Take 3D measurements  \n\n- Inspect model properties  \n\n- Join an ongoing VR session through your web browser\n\n- Access and review snapshots from model coordination\n\n__  \n\n \n\nFOR LICENSED USERS ONLY (Visit http://www.autodesk.com/workshopxr to learn more and request a free trial.) ", "short_description": "Immersive workspace, connected to Autodesk Construction Cloud | Review and collaborate in your 3D models."}]}, "developer_name": "Autodesk, Inc.", "developer_privacy_policy_url": "https://www.autodesk.com/company/legal-notices-trademarks/privacy-statement", "developer_terms_of_service_url": null, "publisher_name": "Autodesk, Inc.", "support_website_url": null, "website_url": "http://www.autodesk.com/workshopxr", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUC
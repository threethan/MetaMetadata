om&_nc_ss=7f30f&oh=00_AQXjY70gxMU6ee1j2w1wf5B3DzBgLrBh6r7JXdLFx8sG8Q&oe=6B0F0490"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "dvg.png", "id": "827649056620753", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820574_827649063287419_3241480496335208908_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M18_Txt7VoUQ7kNvwE3JGH9&_nc_oc=Adq8WDqfBD8vBY1VAotMESm85po9a4MG_5w1z8RC18KmH7Uzwg8br9uTLB2_5G6VfvA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVCIm_9ugjNzJNi0c-32wdS-1TCJfKIEcnt1JhvCnk2hA&oe=6B0F0513"}, "display_name": "DvG: Conquering Giants", "keywords": ["David", "Goliath", "Bible", "Christian", "Jesus"], "long_description": "Prepare for the ultimate battle against the notorious giant. David versus Goliath: Conquering Giants is an imaginative twist on the classic story of David versus Goliath. \n\nIn this epic virtual reality game, YOU are the young shepherd boy on a journey to protect your sheep from the dangers of the outside world. You better be quick on your feet because there are lions and wolves and bears nearby! \n\nArmed with a simple yet powerful sling, you\u2019ll face challenges around every corner. They are sneaking through green pastures, lurking in the woods, and prowling in caves. If you defeat these foes, then you just might find yourself on the battlefield in the Valley of Ellah. There Goliath has threatened to destroy your family, lands, and nation. IF you can beat him in one-on-one combat, you will save them all. \n\nCan you sling your way to victory? Are you a \"mere\" shepherd boy, or are you a GIANT SLAYER? DvG is brought to you by VLB in collaboration with  Virtuous VR Gaming and Immersive History.", "short_description": "David versus Goliath is an imaginative twist on a classic story where you face off versus wolves, lions, bears, and one mean giant armed only with a simple, yet powerful sling and the faith of a young shepherd."}]}, "developer_name": "Immersive History", "developer_privacy_policy_url": "https://dvgthegame.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Virtuous VR Gaming", "support_website_url": null, "website_url": "https://DvGtheGame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "DOCUMENTARY_HISTORY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25807982578819777"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974841_1189717438110776_2069114476086640866_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hv0vw45E5-4Q7kNvwFZUBRf&_nc_oc=AdpW_-LyzP0UiS4SHReSEV-QunvbwN_zh_eiIHCT22yMUdOcerVRB2lYC7sa-6TVUMs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXciCeDwOAqrK0XNIuzonhpnNfFcn6XLCsnnpPPXZEQQA&oe=6B0F15A5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "DvG: Conquering Giants", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Fighting", "id": "2710427532541308"}], "release_date": 1620835298, "lastRevision": {"nodes": [{"id": "207420804501463", "release_type": "SCHEDULED", "adminis
5.png", "id": "520071285631012", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036631_520071288964345_4562392981684324039_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ouEhmRfyfrUQ7kNvwGowWs8&_nc_oc=AdlJ1knKom-7Tf7Y39rQaAABGZZBIkVL9mh615IQGOawEnIFtaBJEme2cGP2NMAe8y4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvYUtCKbAeUsvsLYRI8izen-pkPEiaFjNAvdAoK6oFC8A&oe=69A6C758"}, {"file_name": "ss_13.png", "id": "265690371679214", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974820_265690375012547_1510504170056223339_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FitIKqhJJ8EQ7kNvwHFrgGr&_nc_oc=AdlzkHxeIkyPRAFct6EZ8TTdz-yNYzdDOOycxQHYcxVNdRBxdfMPtKvxpTca2gd2ues&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afut2ZK4x_UZV7ci2OBrOtS_DsrLqnBQA0hXY0XuoGCGNA&oe=69A6F1F1"}, {"file_name": "ss_9.png", "id": "134280148617699", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001691_134280151951032_6299915936235647779_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GgSJb2P4gBUQ7kNvwEXqGJO&_nc_oc=Adk38ZT48qd6wprPih_n52_6r-moFicWNMw6KrMkBVKA_pcFEwyN4z1VlfgEUl9_tkY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afukg7pX7L_U3i2JujKiij9BMUHt_Bf6SAgpbw3Jjzs4iA&oe=69A6D9DA"}, {"file_name": "ss-1.png", "id": "525148578882129", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974453_525148585548795_1553380563267252209_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W6cWX6TdqT8Q7kNvwH5-8jO&_nc_oc=AdkEBfsD3BuHons6fERk0z_GkN8LmpU7Q70reRVy4J-p1Cj9RCEKMwV2NWfxIWS44ZA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuD4uH7ZGMaD3pLrKmceZCJ1ZGN9nJvLCBT_gFr6ZHWfw&oe=69A6E2D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "dvg.png", "id": "827649056620753", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820574_827649063287419_3241480496335208908_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GNjF3XX3cYMQ7kNvwGL7Vkz&_nc_oc=AdnlMLYTtYmFNNIRuwXdeGja9UXh8oB2nsJIfUy4hWgAyv1hNt_QG9FKSEDaUKzl_10&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftcqu0ZTtoil4hHUdBbsfq7pINTx2ZAL7et4VwPDOalWQ&oe=69A6E353"}, "display_name": "DvG: Conquering Giants", "keywords": ["David", "Goliath", "Bible", "Christian", "Jesus"], "long_description": "Prepare for the ultimate battle against the notorious giant. David versus Goliath: Conquering Giants is an imaginative twist on the classic story of David versus Goliath. \n\nIn this epic virtual reality game, YOU are the young shepherd boy on a journey to protect your sheep from the dangers of the outside world. You better be quick on your feet because there are lions and wolves and bears nearby! \n\nArmed with a simple yet powerful sling, you\u2019ll face challenges around every corner. They are sneaking through green pastures, lurking in the woods, and prowling in caves. If you defeat these foes, then you just might find yourself on the battlefield in the Valley of Ellah. There Goliath has threatened to destroy your family, lands, and nation. IF you can beat him in one-on-one combat, you will save them all. \n\nCan you sling your way to victory? Are you a \"mere\" shepherd boy, or are you a GIANT SLAYER? DvG is brought to you by VLB in collaboration with  Virtuous VR Gaming and Immersive History.", "short_description": "David versus Goliath is an imaginative twist on a classic story where you face off versus wolves, lions, bears, and one mean giant armed only with a simple, yet powerful sling and the faith of a young shepherd."}]}, "developer_name": "Immersive History", "developer_privacy_policy_url": "https://dvgthegame.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Virtuous VR Gaming", "support_website_url": null, "website_url": "https://DvGtheGame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "271042
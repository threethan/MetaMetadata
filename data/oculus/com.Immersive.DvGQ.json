5.png", "id": "520071285631012", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036631_520071288964345_4562392981684324039_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ouEhmRfyfrUQ7kNvwEd76vn&_nc_oc=AdmjDiLnfAm4pBSy2RrWkEXz-fsQ2FpdS4_h4Ig65aAwuyHKe8KWqareuFWLJgzSEOo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Afshr8ZRtqwZc434oQDRtdcyKR7trhCvRuaC0C9oCbLdwQ&oe=69A575D8"}, {"file_name": "ss_13.png", "id": "265690371679214", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974820_265690375012547_1510504170056223339_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IBz6EK0GVj4Q7kNvwFAfERk&_nc_oc=Adk7zNeE6HmsA5pBQ_nH5vPAhUeIsHVNtCkBtVc7DsLDScPGXSXkO2rNdnqfNfN4YHo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfsbbfBqZtTVPNTd-dO0xi_b76clT4x9OnQlFz9CN_cdiA&oe=69A5A071"}, {"file_name": "ss_9.png", "id": "134280148617699", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001691_134280151951032_6299915936235647779_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GgSJb2P4gBUQ7kNvwHdaML7&_nc_oc=AdkbG6pFdO5IFPylSOrT2dL5usBaDyxA7pun8evdEBXgzW9gYvnPmTxSaxmayaoB9Qk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfsLDjifQtXuF5zv-cI9Z7rxpcS3BAw3zVErM6kq0NcXGQ&oe=69A5885A"}, {"file_name": "ss-1.png", "id": "525148578882129", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974453_525148585548795_1553380563267252209_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W6cWX6TdqT8Q7kNvwG22Ptn&_nc_oc=Adm0-Qkl5jGV_Pn3w25Qmhrz4Hku45W6BKeflZheZYMPah9OuwVUqWF9xM6bi1SyJIY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfuXq7QWug43zXMAaGnwWt5HIotZJa81xOCvAX3jMzeq-g&oe=69A59150"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "dvg.png", "id": "827649056620753", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491820574_827649063287419_3241480496335208908_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GNjF3XX3cYMQ7kNvwEC5wgJ&_nc_oc=Adn_q7QbUAuCs1VaaA9e4y598-eqqLP2WFE3oapPBF9tk1w10L41H82f--hw1AmOkfU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afvp0J1GZw0SDlJWHX8Q9sbAOFkA43KDCf8mWSLp5FK5hA&oe=69A591D3"}, "display_name": "DvG: Conquering Giants", "keywords": ["David", "Goliath", "Bible", "Christian", "Jesus"], "long_description": "Prepare for the ultimate battle against the notorious giant. David versus Goliath: Conquering Giants is an imaginative twist on the classic story of David versus Goliath. \n\nIn this epic virtual reality game, YOU are the young shepherd boy on a journey to protect your sheep from the dangers of the outside world. You better be quick on your feet because there are lions and wolves and bears nearby! \n\nArmed with a simple yet powerful sling, you\u2019ll face challenges around every corner. They are sneaking through green pastures, lurking in the woods, and prowling in caves. If you defeat these foes, then you just might find yourself on the battlefield in the Valley of Ellah. There Goliath has threatened to destroy your family, lands, and nation. IF you can beat him in one-on-one combat, you will save them all. \n\nCan you sling your way to victory? Are you a \"mere\" shepherd boy, or are you a GIANT SLAYER? DvG is brought to you by VLB in collaboration with  Virtuous VR Gaming and Immersive History.", "short_description": "David versus Goliath is an imaginative twist on a classic story where you face off versus wolves, lions, bears, and one mean giant armed only with a simple, yet powerful sling and the faith of a young shepherd."}]}, "developer_name": "Immersive History", "developer_privacy_policy_url": "https://dvgthegame.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Virtuous VR Gaming", "support_website_url": null, "website_url": "https://DvGtheGame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "271042
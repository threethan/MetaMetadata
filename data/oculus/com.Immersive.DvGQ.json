a&_nc_ohc=Z6CxWOsGSIkQ7kNvwFEqDv9&_nc_oc=AdkWOZyvYs1PZS_KTrQT3nDkLIP3TOPZU-eVZjdbH5hMzrmIkQdNo0kIaE-NY-m6Z7Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afymo5zTHueerv_sDgEbJYUfiOBzAbSpg8_aYcaBr-pAOw&oe=69B01DD3"}, "display_name": "DvG: Conquering Giants", "keywords": ["David", "Goliath", "Bible", "Christian", "Jesus"], "long_description": "Prepare for the ultimate battle against the notorious giant. David versus Goliath: Conquering Giants is an imaginative twist on the classic story of David versus Goliath. \n\nIn this epic virtual reality game, YOU are the young shepherd boy on a journey to protect your sheep from the dangers of the outside world. You better be quick on your feet because there are lions and wolves and bears nearby! \n\nArmed with a simple yet powerful sling, you\u2019ll face challenges around every corner. They are sneaking through green pastures, lurking in the woods, and prowling in caves. If you defeat these foes, then you just might find yourself on the battlefield in the Valley of Ellah. There Goliath has threatened to destroy your family, lands, and nation. IF you can beat him in one-on-one combat, you will save them all. \n\nCan you sling your way to victory? Are you a \"mere\" shepherd boy, or are you a GIANT SLAYER? DvG is brought to you by VLB in collaboration with  Virtuous VR Gaming and Immersive History.", "short_description": "David versus Goliath is an imaginative twist on a classic story where you face off versus wolves, lions, bears, and one mean giant armed only with a simple, yet powerful sling and the faith of a young shepherd."}]}, "developer_name": "Immersive History", "developer_privacy_policy_url": "https://dvgthegame.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Virtuous VR Gaming", "support_website_url": null, "website_url": "https://DvGtheGame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_c
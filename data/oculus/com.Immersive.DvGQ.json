7QWug43zXMAaGnwWt5HIotZJa81xOCvAX3jMzeq-g&oe=69A59150"}, {"file_name": "ss_12.png", "id": "191838512391423", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974873_191838515724756_893440667464324707_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wH3YqwKr2iAQ7kNvwES5q4K&_nc_oc=AdkHeemlnE1I3stsC6cgsWSi4hsl0Bi-9OmTHGgOsQPibGV2oIemgsNzCWKiZLkUPX0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afva3_6acGgzgTkp_xEHZIpq3_mok7UZ8MgoqrdwKp3OqA&oe=69A58195"}, {"file_name": "ss_9.png", "id": "134280148617699", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001691_134280151951032_6299915936235647779_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GgSJb2P4gBUQ7kNvwHdaML7&_nc_oc=AdkbG6pFdO5IFPylSOrT2dL5usBaDyxA7pun8evdEBXgzW9gYvnPmTxSaxmayaoB9Qk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfsLDjifQtXuF5zv-cI9Z7rxpcS3BAw3zVErM6kq0NcXGQ&oe=69A5885A"}, {"file_name": "ss_5.png", "id": "520071285631012", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036631_520071288964345_4562392981684324039_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ouEhmRfyfrUQ7kNvwEd76vn&_nc_oc=AdmjDiLnfAm4pBSy2RrWkEXz-fsQ2FpdS4_h4Ig65aAwuyHKe8KWqareuFWLJgzSEOo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Afshr8ZRtqwZc434oQDRtdcyKR7trhCvRuaC0C9oCbLdwQ&oe=69A575D8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DvG: Conquering Giants", "keywords": [], "long_description": "Prepare for the ultimate battle against the notorious giant. DvG is an imaginative twist on the classic story of David versus Goliath. In this epic virtual reality game, YOU are the young shepherd boy on a journey to protect your sheep from the dangers of the outside world. You better be quick on your feet because there are lions and wolves and bears nearby! Armed with a simple yet powerful sling, you\u2019ll face challenges around every corner. They are sneaking through green pastures, lurking in the woods, and prowling in caves. If you defeat these foes, then you just might find yourself on the battlefield in the Valley of Ellah. There Goliath has threatened to destroy your family, lands, and nation. IF you can beat him in one-on-one combat, you will save them all. Can you sling your way to victory? Are you a \"mere\" shepherd boy, or are you a GIANT SLAYER? DvG is brought to you by VLB in collaboration with  Virtuous VR Gaming and Immersive History.", "short_description": "DvG is an imaginative twist on a classic story where you as the player face off versus giants with a simple, yet powerful sling."}]}, "developer_name": "Immersive History", "developer_privacy_policy_url": "https://dvgthegame.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Virtuous VR Gaming", "support_website_url": null, "website_url": "https://DvGtheGame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "DOCUMENTARY_HISTORY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "932740130942808"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "736070869544127"}, {"status": "PUBLISHED", "id": "404853001648953"}, {"status": "PUBLISHED", "id": "479119666656921"}, {"status": "PUBLISHED", "id": "931635877395241"}]}, "baseline_offer": {"id": "404853001648953"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1768845600, "status": "PUBLISHED", "id": "736070869544127"}]}, "liveChannel": {"no
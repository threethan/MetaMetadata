5.png", "id": "520071285631012", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036631_520071288964345_4562392981684324039_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8cCbrYQnlgAQ7kNvwFUB0wS&_nc_oc=AdnKLXnj88E5NaM-deFadkoYbKHIVLkTX1zsIacFdwL3gwLMZ5qccdprv2xpo2h9fvY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsFhdgdCmDYyfWaiyQLf0T71bxQlwwxvT2gC40DnxkOCQ&oe=699AE9D8"}, {"file_name": "ss_13.png", "id": "265690371679214", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974820_265690375012547_1510504170056223339_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y2Eu2fKlJyYQ7kNvwH1E8fu&_nc_oc=AdkJTd4EH9ia72eit8N4eGyjsB1GoeXDCVtzzT3tRaM-ygeJtoh5Iv5f_gEL-kXZp0A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuVV4RDxdnYrhIdAQBeFL2bQVXZJnrOvLAKPXxR0hgYJw&oe=699B1471"}, {"file_name": "ss_9.png", "id": "134280148617699", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001691_134280151951032_6299915936235647779_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yKGlFlCM6WQQ7kNvwGmN0xr&_nc_oc=AdnY2Q8cE8fnjoeIqf7ia5a3-aJYalZ9zgCt691ZZtHL0TrOit3Xkf2q_YDw3Kbv5oI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aftav6Wo1mYG-Ov_t-5lB8e99SwiC9W1Q57LnsPAglQ4GA&oe=699AFC5A"}, {"file_name": "ss-1.png", "id": "525148578882129", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974453_525148585548795_1553380563267252209_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NK0c0P6-X_sQ7kNvwEjZHrK&_nc_oc=AdlbzN8U4_jQ_tB75kV_LGh7Ripo_SkGpZFaXpCCjyr0cRKvKNV0kUpiUUxN6BDKl8E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfukseHSa7kHiAWpz-jzOC6js_Amboqt5t9tFEfaA_3KeA&oe=699B0550"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "dvg.png", "id": "827649056620753", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820574_827649063287419_3241480496335208908_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g0HONHFh5aEQ7kNvwGJyGZp&_nc_oc=AdmO2PTLX9OmPz0pvSWtEyDMHYqdNkjLBePqY_6AxkmIJT_wo3KdgHtpJdCJuHLmQLY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsMjooYxbigIxgX0vr5I7ZZzngiHnk7Zx1V5ujmYCtsVw&oe=699B05D3"}, "display_name": "DvG: Conquering Giants", "keywords": ["David", "Goliath", "Bible", "Christian", "Jesus"], "long_description": "Prepare for the ultimate battle against the notorious giant. David versus Goliath: Conquering Giants is an imaginative twist on the classic story of David versus Goliath. \n\nIn this epic virtual reality game, YOU are the young shepherd boy on a journey to protect your sheep from the dangers of the outside world. You better be quick on your feet because there are lions and wolves and bears nearby! \n\nArmed with a simple yet powerful sling, you\u2019ll face challenges around every corner. They are sneaking through green pastures, lurking in the woods, and prowling in caves. If you defeat these foes, then you just might find yourself on the battlefield in the Valley of Ellah. There Goliath has threatened to destroy your family, lands, and nation. IF you can beat him in one-on-one combat, you will save them all. \n\nCan you sling your way to victory? Are you a \"mere\" shepherd boy, or are you a GIANT SLAYER? DvG is brought to you by VLB in collaboration with  Virtuous VR Gaming and Immersive History.", "short_description": "David versus Goliath is an imaginative twist on a classic story where you face off versus wolves, lions, bears, and one mean giant armed only with a simple, yet powerful sling and the faith of a young shepherd."}]}, "developer_name": "Immersive History", "developer_privacy_policy_url": "https://dvgthegame.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Virtuous VR Gaming", "support_website_url": null, "website_url": "https://DvGtheGame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "271042
me": "New Project (53).png", "id": "2503199380039029", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491820382_2503199386705695_1974732486691516265_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iZvOShD7rucQ7kNvwG30iUN&_nc_oc=Adoop0OfcKs9dhZLgasx3vsyhchGQkGnG6qB0sVI3xwRuFjd1kdTSDw6L534UOYlkaQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBs4YP92TKn0vGhuPeXcGuw197mmbvIblWnoQctoDFtQ&oe=6AA96155"}, {"file_name": "New Project (54).png", "id": "1411805779874054", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491826562_1411805783207387_6154060418010846762_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e1VZGtpWNewQ7kNvwHK0spV&_nc_oc=AdoGMDW--uEIQIKtz7uQUiGj5DMmtgJavYBwbkDb8uVkBEcepX_ZuhEvQDGwY8g_vJY&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIbGoR9CeFErc1djk4xIzFe6ZWSCZGqtA33iCsx7nxbsg&oe=6AA94BB3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MixMaster VR", "keywords": ["dj", "djconsole", "music", "party", "Tomorrowland"], "long_description": "\ud83c\udfa7 MixMaster VR puts you at the heart of the party with the most immersive DJ experience in virtual reality!\n\nStep behind the decks and take control of two fully interactive virtual turntables. Load your favorite tracks, mix between them with a realistic crossfader, adjust EQs, apply effects, and scratch using responsive jog wheels. Whether you\u2019re playing to a small lounge crowd or headlining a massive festival stage, MixMaster VR gives you the tools to perform like a real DJ.\n\n\ud83d\udcbf Key Features:\n\nRealistic Virtual DJ Decks \u2013 Control tempo, pitch, EQ, filters, and effects with intuitive VR sliders and knobs.\n\nWaveform Visualization \u2013 See the beats, breakdowns, and drops with dynamic, scrolling track waveforms.\n\nLooping & Cue Points \u2013 Set loop ranges and jump between cue points with precision.\n\nLocal Track Loading \u2013 Import your own MP3 files directly into the game.\n\nImmersive Venues \u2013 Perform in clubs, rooftop bars, and massive festival stages.\n\nBeginner-Friendly & Pro-Ready \u2013 Learn the basics or push your skills to the limit.\n\nWhether you want to practice your mixing, throw a private party, or challenge your friends in VR DJ battles, MixMaster VR delivers the ultimate music performance playground.\n\n\ud83c\udfb6 It\u2019s not just a game \u2013 it\u2019s your DJ journey. Step up to the decks and own the night!", "short_description": "\ud83c\udfa7 MixMaster VR \u2013 Step into the DJ booth of your dreams!\nMix, scratch, and loop tracks using realistic virtual decks.\nControl tempo, EQ, effects, and create your own seamless mixes in an immersive VR nightclub experience.\nWhether you're a beginner or a pro, unleash your inner DJ and make the crowd go wild!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/53a8c8c6-9d48-4292-9f12-8c1490e69ddc", "developer_terms_of_service_url": null, "publisher_name": "Render Island", "support_website_url": null, "website_url": "https://www.render-island.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24416650917947545"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1955706601928026"}]}, "baseline_offer": {"id": "1955706601928026"}, "is_approved": true, "firstOffer":
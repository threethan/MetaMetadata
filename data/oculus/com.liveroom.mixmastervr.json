00_Afw1ulMCjN-CIRYROGMQbU_dLqepAvt2ObzYt02wMLmU9g&oe=69BAAE80"}, {"file_name": "New Project (53).png", "id": "2503199380039029", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820382_2503199386705695_1974732486691516265_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1pTABIonjsQQ7kNvwG9aCxp&_nc_oc=AdmErGeIYAPunSRFzXkHNG6ZEwUwuhAFBcYGWWzRA7p7v23PmqGz-Y88hafHpkuAg90&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwpKBcaBB4umrOZY77PBUI4euqcuQGi4Lqn9TTDwa3hOw&oe=69BA8995"}, {"file_name": "New Project (54).png", "id": "1411805779874054", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491826562_1411805783207387_6154060418010846762_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o8UixMUAELAQ7kNvwHTmSUS&_nc_oc=AdnCe1TeXWDkfY-j4c6b4LOrce2zHbQbmllRkiBbWugInC46TvPuL101qzbToN_dWU0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyUAAq5_nswY4T18TybT3_3jmbytn7ieR15H3L6sR-Ewg&oe=69BAAC33"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MixMaster VR", "keywords": ["dj", "djconsole", "music", "party", "Tomorrowland"], "long_description": "\ud83c\udfa7 MixMaster VR\nStep into MixMaster VR - the ultimate virtual DJ universe where the party never sleeps. \ud83d\udd25\nFrom a massive 24/7 free DJ Arena to exclusive ticketed headline events, this is your backstage pass to a whole new way of experiencing music.\n  Drift through glowing virtual venues\n  Catch your favorite artists spinning live\n  Party with music lovers from around the world\n  Jump into live chats and hype the crowd together\nWhether you're vibing solo or rolling deep with friends, MixMaster VR transforms your room into the hottest festival on the planet.\nWhat Awaits You?\nFree Non-Stop DJ Arena\nDrop in anytime. Day or night. The decks are always spinning.\nExclusive Ticketed Events\nGrab tickets to special shows hosted by your favorite artists and organizers. Limited access. Unlimited vibes.\nExplore Virtual Venues\nBeachside sunset stages. Cyberpunk sky lounges. Massive open-air festival grounds. Hidden warehouse afterparties. Where will you teleport next? \ud83c\udfa7\u2728\nLive Crowd Interaction\nChat, react, dance, and connect. The crowd is real and so is the energy.\nYour Party, Your Way\nChill at the back and vibe\u2026 or move to the front row and own the night.\nAre you just listening\u2026 or are you stepping into the mix? \ud83d\udd25\n", "short_description": "MixMaster VR is a social virtual reality platform for live DJ events. Step into immersive venues, attend real-time performances, and experience music together with people from around the world. Explore vibrant spaces, chat with other fans, and feel the energy of a live crowd\u2014without leaving VR. \ud83c\udfb6"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/53a8c8c6-9d48-4292-9f12-8c1490e69ddc", "developer_terms_of_service_url": null, "publisher_name": "Render Island", "support_website_url": null, "website_url": "https://www.render-island.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26202046929407926"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499293201_1292754292238605_94623350232641522_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C-B-fFycicQQ
&oh=00_AQKhUqJGv0EmUSytUIqK4lK6540_rofePz8ZXFDJrvcIJA&oe=6AA93F12"}, {"file_name": "Screenshot6 copy.png", "id": "895493606314256", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499314663_895493609647589_8383826507970451006_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PYvULQ4yFqkQ7kNvwEn8U6b&_nc_oc=Adrw-wWn2V9XJmSRSGOqJD1YcV_yWAmyeArv316zca5QR249JLUiG_DjGOw_eAsPz8w&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL3XUSFaXExVZIswYzu9iobwKOM1wiKQByWcP3t9usRaQ&oe=6AA93DC4"}, {"file_name": "Screenshot3.png", "id": "1615521836842928", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/604282317_1615521840176261_1941879771785854814_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rIhZvdzofMMQ7kNvwGxpgzk&_nc_oc=AdrIQfkmz52FOpn-YzU81ytsDQu3-KdLlluZZFA52bV66TqHnj83v7EbkWqH27E1W9o&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHm_zihCrMTVcTFs427vDgnZlFkC79F-OF26js3UeWww&oe=6AA93E2A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1664651702331023", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499623601_1664651705664356_7791680538615226725_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ax4M4fPjg7oQ7kNvwGVzpZl&_nc_oc=AdpB_vo4bVqruBi-iIXRPP1tCRNb-vNi0uLLmGNIrSe313-41MobZLSafTfxrzv9DHU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIP3reJZCXWzPvdAIQvJJuYvyQOtjGs0jdxBpiYcwhLhA&oe=6AA93D61"}, "display_name": "MixMaster VR", "keywords": ["dj", "djconsole", "music", "party"], "long_description": "\ud83c\udfa7 MixMaster VR\nThe world's first VR home for electronic music. Your headset is your ticket.\nMixmaster transforms your VR headset into a portal to the global EDM scene. This isn't watching a concert on a screen, it's being there. Pull on your headset, create your avatar, and step onto a living, breathing dance floor surrounded by real people from every corner of the planet. The bass hits, the lights move, the crowd roars and you're right in the middle of it.\nNo ticket lines. No borders. No last call. Just you and the music, any time you want it.\nThree ways to experience live music:\n\ud83c\udfb6 Virtual Concerts - Fully immersive shows where artist avatars perform live on a virtual stage and you dance in the crowd with fans worldwide.\n\ud83d\udce1 Live 360\u00b0 Streams - Real-world events beamed straight into VR through 360\u00b0 cameras, placing you front-and-center at the venue as it happens as if you're really there. Can't get to the show? The show comes to you.\n\ud83c\udfdb\ufe0f VR Event Replicas - Faithful, hand-built recreations of real-world events, rebuilt inside VR so you can step into legendary shows and experience them again and again.\nMake it yours.\nCreate and fully customise your own avatar, the way the whole crowd will see you. Express your style, stand out on the dance floor, and show up as unmistakably you.\n\ud83c\udf9f\ufe0f Grab tickets right inside the app and unlock exclusive live events. You'll be notified when your event goes live.\nDownload Mixmaster free and step inside the music.\n", "short_description": "MixMaster VR is a social virtual reality platform for live DJ events. Create your own avatar, Step into immersive venues, attend real-time performances & live 360\u00b0 streams, and experience music together with people from around the world. Explore vibrant spaces, chat with other fans, and feel the energy of a live crowd\u2014without leaving VR. \ud83c\udfb6"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mixmastervr.xyz/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Render Island", "support_website_url": null, "website_url": "https://mixmastervr.xyz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27796432393302697"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491819854_1065296133330150_4930114729331626124_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PrTB4Q3TZGYQ7kNvwHHMGWN&_nc_oc=AdpopaArJhuyBOo0eRv76n2eTGgOeKThxeb_GdhBGBAxqhEFH6zfSAC046pb4L1gdIE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJShU2eO4lMkK0hWuI8G_UcLkgVp1lo36x0WYePFcHyA&oe=6AA953D3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MixMaster VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}, {"topic_name": "Rhythm", "id": "1672577396871977"}], "release_date": 1755912300, "lastRevision": {"nodes": [{"id": "24373831132229524", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "24373831092229528", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "750580621055389"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "piclumen-1755671754722.png", "id": "1945304422919440", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499301022_1945304426252773_8676522577185716016_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KoE6oEyknYoQ7kNvwHjGKgy&_nc_oc=AdrHoAX
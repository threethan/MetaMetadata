content-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9TB2izDDfJZhL28iqVKBzA2JtM7NYtsOFJLG5g8vamDQ&oe=6A46781C"}, "display_name": "Dark Harvest", "keywords": [], "long_description": "A mysteries species has invaded earth. Mass evacuations are underway and the world is in a state of panic. Sightings of strange entities near your property have been reported but you need to gather essential supplies before you can leave.\n\nArmed with only a flickering flashlight and your wits, you must find the supplies and escape your farm before the mysterious creatures find you.\n\nInspired by early horror titles, this intense survival experience will have you creeping through dark cornfields to avoid extra-terrestrial intruders. Not for the faint of heart.", "short_description": "A simple horror game inspired by early horror titles.\n\nA mysteries species has invaded earth. Mass evacuations are underway and the world is in a state of panic. Sightings of strange entities near your property have been reported but you need to gather essential supplies before you can leave.\n\nArmed with only a flickering flashlight and your wits, you must find the supplies and escape your farm before the mysterious creatures find you. Not for the faint of heart."}]}, "developer_name": null, "developer_privacy_policy_url": "https://darkharvestgame.wixsite.com/main", "developer_terms_of_service_url": null, "publisher_name": "Kitungo Studio", "support_website_url": null, "website_url": "https://darkharvestgame.wixsite.com/main", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, 
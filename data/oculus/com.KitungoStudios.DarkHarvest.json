cdn.com/v/t64.5771-25/38974781_768537834049341_28684273576251418_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xt83n5IEa24Q7kNvwG9cYXr&_nc_oc=Adr1z0bDc3GgxoUC5rNKkxVIWYMJzD5f8NepnR7RyLcw0nqqlhdLpmQDELPFdDAD_go&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNh6OSFIR-iT8E5yKhbbhrulVsyhuKFU1tKEnUtAN8rw&oe=6B01E55C"}, "display_name": "Dark Harvest", "keywords": [], "long_description": "A mysteries species has invaded earth. Mass evacuations are underway and the world is in a state of panic. Sightings of strange entities near your property have been reported but you need to gather essential supplies before you can leave.\n\nArmed with only a flickering flashlight and your wits, you must find the supplies and escape your farm before the mysterious creatures find you.\n\nInspired by early horror titles, this intense survival experience will have you creeping through dark cornfields to avoid extra-terrestrial intruders. Not for the faint of heart.", "short_description": "A simple horror game inspired by early horror titles.\n\nA mysteries species has invaded earth. Mass evacuations are underway and the world is in a state of panic. Sightings of strange entities near your property have been reported but you need to gather essential supplies before you can leave.\n\nArmed with only a flickering flashlight and your wits, you must find the supplies and escape your farm before the mysterious creatures find you. Not for the faint of heart."}]}, "developer_name": null, "developer_privacy_policy_url": "https://darkharvestgame.wixsite.com/main", "developer_terms_of_service_url": null, "publisher_name": "Kitungo Studio", "support_website_url": null, "website_url": "https://darkharvestgame.wixsite.com/main", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "275629210202852"}], "externa
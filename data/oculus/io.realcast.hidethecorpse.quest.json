5/86621367_1669417527200625_4434469507586597919_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s74RcZcu4PcQ7kNvwENt_qL&_nc_oc=AdoBy2jtx7eGJDJXv_N37n7_DOS10mkG4QzrL6oxF8lWT-UbU_QjRb_HswTG9C92sy0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGvYnmUkrP50Gu65HrkSdIR48c9nqqsM0PLQ0wux_LiIQ&oe=6A8C2E2D"}, {"file_name": "GarageCanap 2560.png", "id": "1528126788117949", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982492_1528126791451282_916551118711322979_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MCbFjWhtaUQQ7kNvwFL_kqo&_nc_oc=AdoppqhSVxvn_oEEtIDa4T_5E70Cs7VORDzd7xOsAZDYQtCksRk8uwoO0wq1lLbYNiI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJh44wfFd9evgOuNp26yAeNneFtF0TObgsIXfd-g79vA&oe=6A8C2771"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_01 vrai.png", "id": "1276531310399450", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75441576_1276531313732783_930706324677103262_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ZWNMfR0jCMQ7kNvwG8Q2TK&_nc_oc=AdrK8oVyK9PFh64FATrtxDy255v1cCqW-MWWABCinsbvuAtZ88nk9uSVzn6NLlHEqOI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFn3fXj_o-txquzKNn3REJW8tYI0WUOrwn14qczONCuag&oe=6A8C26CD"}, "display_name": "Hide The Corpse - The Ultimate VR Body-Hiding Challenge", "keywords": [], "long_description": "In **Hide the Corpse**, you\u2019ll find yourself knee-deep in a far-out situation, don\u2019t freak out! Locked in a room, you\u2019ve got **4 minutes**, a body and a whole load of wacky furniture. \n\nIn this **hilarious 1970s** VR adventure, it's your job to hide the body before time runs out, and the cops burst through the door\u2026  \n\nBut here's the twist \u2013 we're talking **wild physics**, funky furniture, and a clock that's tickin' faster than a disco beat.  \n\nGrab, drag, and contort the corpse and the interactive environment in increasingly creative and desperate attempts to hide a body!\n\n# Early Access Dev Description\n\n**Why is your game in Early Access?**\n\nThe goal is to gather player's feedback to improve the game to get more replay value by adding more features and content.\n\n**How long do you plan to stay in Early Access?**\n\nApproximately 3 to 4 months before the final release. The first ALPHA version includes two first levels, we'll be adding levels to the build on a regular basis every month or so until BETA and MASTER.\n\n**What features are you planning to add to the game?**\n\nIn addition to the levels, we want to add spin-offs; these are shorter levels that offer highly replayable challenges. There are some other ideas that we'll share on Discord, and we want to leave room for the best ideas from the community to be incorporated into the game.\n\n**What is your pricing strategy during and after Early Access?**\n- Early Access on Meta App Lab: $19.99-$23.99\n- Full price of the final game: $24.99\n\n**Discord:** https://bit.ly/hidethecorpsediscord", "short_description": "Uncover the thrill of solving high-stakes puzzles to outsmart the law"}]}, "developer_name": null, "developer_privacy_policy_url": "https://realcast.io/privacy-2/", "developer_terms_of_service_url": null, "publisher_name": "Realcast", "support_website_url": null, "website_url": "https://realcast.io/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "377978390272490"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER
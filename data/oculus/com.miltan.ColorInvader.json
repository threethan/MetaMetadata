Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhdfSFTPGr-FqlcnTJ-VsOsmlx7n3eZmFHd7bZc8BtjA&oe=6AB533BD"}, {"file_name": "Lord.png", "id": "5605720129516539", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57568673_5605720136183205_1887583409434190937_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2gRfLsdUpRMQ7kNvwHROU11&_nc_oc=Adq2FUmoVO1arbKdC13oG_0t1du9f8ZufAUoI0y-GE3vr1LAOF4LnJ8ajr4HA5pE0Hk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLMTliy7XSidB5Z8S4nD9QJigLZr1lVs9H8OealyTjJOQ&oe=6AB525A5"}, {"file_name": "shock_screenshot_03.png", "id": "530590718705440", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031339_530590722038773_6559496024535191768_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pEq50aP2KbUQ7kNvwHxFGKD&_nc_oc=AdoiYqkqw9rrP6IorQKgs_3doMvZc8LHXnUTn7BZ-97mXmKqaN3gwgErwZDZFdmmQ1k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpQVB4u8tnhArfvxbhHio_Xzo2U1oZ37SImbHmIxplaQ&oe=6AB53553"}, {"file_name": "RingCage.png", "id": "609394747605347", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031432_609394750938680_7657552994363738778_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jeNLZHAsQL8Q7kNvwGAeD0s&_nc_oc=AdqqHJ4Ekb4--rgvPQRkELst4_kvbjeLKG0yMqByqVMT1mrL-URLE83-ieR5ShFNDEI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLAXWHy2TLrsJula6Fxxr_ImzTmzX5Q1JmNmARUcTudCg&oe=6AB54542"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store Cover_v2_2560_1440.png", "id": "1204870540118790", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75222942_1204870543452123_3348987008165391076_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=985pFOYIPMEQ7kNvwHXX1s3&_nc_oc=AdrD9KweRKGUrWZNANKbA8IMsj0md6TyMZWagcEhNdISm5CjTcpK9-Ge-9Lq1XeK-No&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZg7aABEAzkLpN7oQboU0AClPYi1DGi-XpxNsgKY815g&oe=6AB5315B"}, "display_name": "Color Invader VR", "keywords": ["puzzle", "space", "shoot", "color", "alien"], "long_description": "Color Invader is a fun VR adventure shooting puzzle, where your job is to defend the galaxy from invasion.\nThe game promises a lot of fun with over 350 unique levels that have multiple game modes, bonus stages, and level features.\nLevels are completed by shooting the orbs with the corresponding colors, also the colors can be mixed to produce new colors that add complexity and fun to the puzzle, and on top of that, there are rockets, meteors, space jellies, cages, portals, space rings, shock waves and so much more to compete.\nThe game is optimized for a variety of player skill sets and fun is guaranteed.", "short_description": "Color Invader is a fun VR adventure shooting puzzle, where your job is to defend the galaxy from invasion.\nThe game promises a lot of fun with over 350 unique levels that have multiple game modes, bonus stages, and level features.\nLevels are completed by shooting the orbs with the corresponding colors, also the colors can be mixed to produce new colors that add complexity and fun to the puzzle."}]}, "developer_name": null, "developer_privacy_policy_url": "https://miltan.co/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Miltan", "support_website_url": null, "website_url": "https://miltan.co/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "
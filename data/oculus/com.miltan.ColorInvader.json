71-25/39031339_530590722038773_6559496024535191768_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t0kF3Qk8HW8Q7kNvwF2ja_j&_nc_oc=Adq4_87QBBdKDRQTjf9MP-H3suVIAdX8lVzLMTIaUn4rItCGG7c2i0ATOWgWi8A45k8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB00NaHr0lQC0BiB8oxeaUm3A-kw-EoRuVNJ0SgF1vSUw&oe=6A53A653"}, {"file_name": "RingCage.png", "id": "609394747605347", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031432_609394750938680_7657552994363738778_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UXjPCcuso_4Q7kNvwGHpZtZ&_nc_oc=Adof-L5f2_oQtNOCcNUf_i6pI8hoOMCPBH7lvd5Ax7bCP0Yyq2eQYVB_u1jT8Uv9YNc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDPOdJog8_OvxQZAHvwcGPyecAwd3q18wZeVY-sD_RRFA&oe=6A537E02"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store Cover_v2_2560_1440.png", "id": "1204870540118790", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75222942_1204870543452123_3348987008165391076_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xmra-lr8g7AQ7kNvwGkrexZ&_nc_oc=Ado8SxUaB8SspydaMZ8gii65FzsfP70XL1-KGvjn7V4aAsP6Osly80RdGSuoc8tClTo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBa0YiyuxhMqahSmH7bSckETxP7WraUsEbrluxT9K2rIA&oe=6A53A25B"}, "display_name": "Color Invader VR", "keywords": [], "long_description": "Color Invader is a fun VR adventure shooting puzzle, where your job is to defend the galaxy from invasion.\nThe game promises a lot of fun with over 350 unique levels that have multiple game modes, bonus stages, and level features.\nLevels are completed by shooting the orbs with the corresponding colors, also the colors can be mixed to produce new colors that add complexity and fun to the puzzle, and on top of that, there are rockets, meteors, space jellies, cages, portals, space rings, shock waves and so much more to compete.\nThe game is optimized for a variety of player skill sets and fun is guaranteed.", "short_description": "Color Invader is a fun VR adventure shooting puzzle, where your job is to defend the galaxy from invasion.\nThe game promises a lot of fun with over 350 unique levels that have multiple game modes, bonus stages, and level features.\nLevels are completed by shooting the orbs with the corresponding colors, also the colors can be mixed to produce new colors that add complexity and fun to the puzzle."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.tan-digital.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Miltan", "support_website_url": null, "website_url": "http://www.tan-digital.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1296984627748015"}}]}, "scheduled_offers": {"count": 13, "nodes": [{"status": "PUBLISHED", "id": "1964058604214650"}, {"status": "PUBLISHED", "id": "822658924168495"}, {"status": "PUBLISHED", "id": "1293220512572323"}, {"status": "CANCELLED", "id": "729972353445761"}, {"status": "PUBLISHED", "id": "795270699757343"}, {"status": "PUBLISHED", "id": "691235120609289"}, {"status": "PUBLISHED", "id": "967099298834134"}, {"status": "PUBLISHED", "id": "643365168204996"}, {"status": "PUBLISHED", "id": "1299073957950794"}, {"status": "PUBLISHED", "id": "418887324609269"}, {"status": "PUBLISHED", "id": "513183714598635"}, {"status": "CANCELLED", "id": "537575475397461"}, {"status":
kjh576VLGKheb6iNOC5RFssCk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwzK4xqYQliVl1jk5qMn6qJ80vw8qgnh43vzpItiCtwPg&oe=69BBE182"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store Cover_v2_2560_1440.png", "id": "1204870540118790", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75222942_1204870543452123_3348987008165391076_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RbbV6aRvf_gQ7kNvwGd-wKC&_nc_oc=AdkljhzykCPPRQxnU-C-MvCJ43htNxXod_wfK2CgWktRTZWILUPzSBp45PRU-46zxJo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afzhb2gpHUUjgjqerOG-br7grFMOdnMYGBR6eDRAPZM14A&oe=69BC05DB"}, "display_name": "Color Invader VR", "keywords": [], "long_description": "Color Invader is a fun VR adventure shooting puzzle, where your job is to defend the galaxy from invasion.\nThe game promises a lot of fun with over 350 unique levels that have multiple game modes, bonus stages, and level features.\nLevels are completed by shooting the orbs with the corresponding colors, also the colors can be mixed to produce new colors that add complexity and fun to the puzzle, and on top of that, there are rockets, meteors, space jellies, cages, portals, space rings, shock waves and so much more to compete.\nThe game is optimized for a variety of player skill sets and fun is guaranteed.", "short_description": "Color Invader is a fun VR adventure shooting puzzle, where your job is to defend the galaxy from invasion.\nThe game promises a lot of fun with over 350 unique levels that have multiple game modes, bonus stages, and level features.\nLevels are completed by shooting the orbs with the corresponding colors, also the colors can be mixed to produce new colors that add complexity and fun to the puzzle."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.tan-digital.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Miltan", "support_website_url": null, "website_url": "http://www.tan-digit
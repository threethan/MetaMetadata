s&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uQDrPTRYFpAQ7kNvwG8yRyG&_nc_oc=AdoZFIK1ULaQhIBCXiZRL9Vd1OcDsb26QQVDhniiMqenzM2OgqE1q22ajRyQP0wedoE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxilGvMbOb28nnQD8Y_4NM-Ax1gxirpffPbsG6Mzf4wA&oe=6AFDB3DB"}, "display_name": "Color Invader VR", "keywords": ["puzzle", "space", "shoot", "color", "alien"], "long_description": "Color Invader is a fun VR adventure shooting puzzle, where your job is to defend the galaxy from invasion.\nThe game promises a lot of fun with over 350 unique levels that have multiple game modes, bonus stages, and level features.\nLevels are completed by shooting the orbs with the corresponding colors, also the colors can be mixed to produce new colors that add complexity and fun to the puzzle, and on top of that, there are rockets, meteors, space jellies, cages, portals, space rings, shock waves and so much more to compete.\nThe game is optimized for a variety of player skill sets and fun is guaranteed.", "short_description": "Color Invader is a fun VR adventure shooting puzzle, where your job is to defend the galaxy from invasion.\nThe game promises a lot of fun with over 350 unique levels that have multiple game modes, bonus stages, and level features.\nLevels are completed by shooting the orbs with the corresponding colors, also the colors can be mixed to produce new colors that add complexity and fun to the puzzle."}]}, "developer_name": null, "developer_privacy_policy_url": "https://miltan.co/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Miltan", "support_website_url": null, "website_url": "https://miltan.co/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENT
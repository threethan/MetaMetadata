52&_nc_oc=Adp_Gk3gEJ-MbY7Hr4dw0Bkul837IxD1XXXPb4XYn3HKCrBVMUm4L32snjJ13k5XJwc&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_S024tfXjgU-bD5uExr6Uer__DV74kdszcm-2K0enzfQ&oe=6A36B542"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store Cover_v2_2560_1440.png", "id": "1204870540118790", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75222942_1204870543452123_3348987008165391076_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IpHvEgs_NlsQ7kNvwGdQgrn&_nc_oc=Adq_dZL50dGeOSFosbQeCVnhpJ4XxE-nj8NV_bn9_Jzv14OB26o92fMVIUQCFcRrJwo&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8KDaKJOK6ABEgYma2Mj49eeGvBiFp5PEA3zEFIfDfBMw&oe=6A36A15B"}, "display_name": "Color Invader VR", "keywords": [], "long_description": "Color Invader is a fun VR adventure shooting puzzle, where your job is to defend the galaxy from invasion.\nThe game promises a lot of fun with over 350 unique levels that have multiple game modes, bonus stages, and level features.\nLevels are completed by shooting the orbs with the corresponding colors, also the colors can be mixed to produce new colors that add complexity and fun to the puzzle, and on top of that, there are rockets, meteors, space jellies, cages, portals, space rings, shock waves and so much more to compete.\nThe game is optimized for a variety of player skill sets and fun is guaranteed.", "short_description": "Color Invader is a fun VR adventure shooting puzzle, where your job is to defend the galaxy from invasion.\nThe game promises a lot of fun with over 350 unique levels that have multiple game modes, bonus stages, and level features.\nLevels are completed by shooting the orbs with the corresponding colors, also the colors can be mixed to produce new colors that add complexity and fun to the puzzle."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.tan-digital.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Miltan", "supp
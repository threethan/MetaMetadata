_ss=7f20f&oh=00_Af5qyKa0JN-24GL0GC03MsMLiY95gtOm9tOsgnjVNsSPoQ&oe=6A0B1735"}, {"file_name": "16.png", "id": "178823475190074", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75469623_178823478523407_8088012145720117123_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PYEjYAoIOiQQ7kNvwEySXMd&_nc_oc=Adq3CBympp0FynlRMMGDQC4jv3rz_V2q8EtUYiuiMI-fLAyPLPC6yD7h2IsTtOsFz9k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af63ji38w2Zk9hRVXYs-M5LSeUEgb3VIRjW7sZsBqqM37g&oe=6A0B0A3F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Car Racing.png", "id": "1978409252494324", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036672_1978409255827657_6553865201042861875_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ykOLYZxoqQQ7kNvwGVsVlW&_nc_oc=Adot7TQbJ_JsUxdfUVMriSqq7CKie0F0wrabhRRuEnPq2EOW5y_c0VChDusMSs4u18E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4pBKZJIinO8KPxydgeZfMa_AhY9EJIxw24esBe1vglZg&oe=6A0B22B4"}, "display_name": "DRFT : Car Racing Games", "keywords": [], "long_description": "Welcome to DRFT, the ultimate car racing game for VR! Ever dreamt of driving super fast cars and winning exciting races? Now you can do it right from the comfort of your home!\n\nDRFT offers you the most realistic driving experience in virtual reality. Feel your heart race as you slide around sharp corners, barely missing the barriers. Listen to the roar of your car's engine as you speed down the straights, leaving your opponents behind.\n\nIn this game, you can be the star driver you've always wanted to be. There's a whole garage of amazing cars waiting for you to try out. Each car has its own unique feel and style. So, whether you want something speedy and light, or a heavy monster that can push through the competition, DRFT has got you covered.\n\nNot only that, but you'll be racing in some of the most stunning locations you can imagine. From the bustling city streets, through the wild desert plains, to the lush green countryside. Each track is designed to test your skills and keep you on the edge of your seat.\n\nAs you win races, you'll earn trophies and unlock cool new cars. Plus, you can even customize your favorite cars, making them look just the way you want.\n\nWith DRFT, you're not just playing a game, you're entering a world of high-speed action and endless excitement. Get your VR headset ready, it's time to race!", "short_description": "DRFT is a super fun car game in VR! You can feel like you're driving for real. Slide around bends, zoom past other cars, and win races. It's like you're inside the game! Get ready, get set, let's DRFT!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://radpony.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Rad Pony", "support_website_url": null, "website_url": "https://radpony.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "570924935256345"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PUBLISHED", "id": "894898916196697"}, {"status": "PUBLISHED", "id": "24728068040211068"}, {"status": "PUBLISHED", "id": "2628475937501466"}, {"status": "PUBLISHED", "id": "829700279404544"}, {"status": "PUBLISHED", "id": "24969910755934989"}, {"status": "PUBLISHED", "id": "1345849716603192"}, {"status": "PUBLISHED", "id": "988593779775452"}, {"status": "PUBLISHED", "id
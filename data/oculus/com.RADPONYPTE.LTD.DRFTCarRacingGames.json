 join the race. \n(dev 4Q2025 roadmap TBA on our Discord Channel)\n\n\nExperience raw Online racing, drift physics, intense rivalries, and pure, unfiltered speed. Join 500,000+ drivers and feel the difference.\n\nWe've been in the garage, and players are noticing. 3.0 to 48. Rate rise withing the last month."}]}, "developer_name": "Going Merry LLC", "developer_privacy_policy_url": "https://sharpforks.com/privacy-policy/", "developer_terms_of_service_url": "https://sharpforks.com/term-of-use/", "publisher_name": "Going Merry LLC", "support_website_url": "https://sharpforks.com/contact-us/", "website_url": "https://goingmerry.xyz/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25424445760566233"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491824292_1524527371982674_1889274897303467910_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1EU5fuQCq4UQ7kNvwE9h6Z2&_nc_oc=AdqrDC3xTf34xPP6vG1O6x5d5LfJW-zo-I42FVFDNUNS-lrTHdpHnp8drg9g_94hPx4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af2LuKv6UKQuuJ0n1F3-a3Nj6FQEaWxQrVLSh1uXnn7feA&oe=69F21945"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "DRFT: Online Car Racing Game", "platform": "ANDROID_6DOF"
127310_1835157840750265051_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z5jk_v06cOMQ7kNvwH6ZoEy&_nc_oc=AdoACbcaxGKRjz_I4a51SG-DxYhuche2JRmEKGM-ANqZNxReU1d-GmK8itqxf-jQg74&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGg0Lss-TDcWbAxQWmxbC8Az0aU-fxar8ZNJz7QRbKKQQ&oe=6A95BFE7"}, {"file_name": "02_Construct_PM_02.png", "id": "1408255196350653", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035315_1408255199683986_8343718587872104188_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LipxghW4G9sQ7kNvwExw7mC&_nc_oc=AdpX77egnYke-ueS3ImaS6y_cKkcHbeveivbpekLLIi5NYwWca2N7zbNJ_sO3qioNa0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmZNm6b0zMzxBYPPPU87M9-u7Vc6jTQGKIVea3DEP8pw&oe=6A95C6C3"}, {"file_name": "06_Buffer_AK_03.png", "id": "583802233255067", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974871_583802239921733_8972368477914273203_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yDHLbAZx9dAQ7kNvwEBccHR&_nc_oc=AdrbYXD3fl83qrOVh18wl0aYq0u-YXyb3Z0YrjFk5BW3gIQn4joXUDHzPVW9R6HwmhI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHg8yVmtMr3dAwWBV6p2SKrjGzZAEwKMJb2w6Ed_KEWRQ&oe=6A95DB17"}, {"file_name": "12_Kolhoz_Tushonka_09.png", "id": "1093908084861243", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974901_1093908088194576_7834133607333643926_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UTk_KRBvh0cQ7kNvwGjm8nk&_nc_oc=AdpTYaqmtbpjSxhAponB26IreSNPIqGP4TusiNUSk_qBVcz3tklCw33IU_rj1j85n7Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHGCJ7KFdheZtLw5BlJ5eGKvBYocUyg-pLGQbNuu2n_KQ&oe=6A95B8BE"}, {"file_name": "15_Hub_Weapons_10.png", "id": "2011524495723534", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974854_2011524499056867_6974653420321126592_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oH34vTVtwO4Q7kNvwEPmiga&_nc_oc=AdoQvT37wtKowzW5iwDGvhanB5EKK89mAVo51ppYRQ8IjjvMKl_5GOVmY-dSRwzvHiU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGsKMvJwA9jkiup6r-PAY0twsfCm6ss7q9DUnbw0KsXpw&oe=6A95CB87"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ITR_Trailer_Thumbnail_2560x1440.png", "id": "436045485127212", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001671_436045488460545_8320295034043980832_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fmTXuzL_1BwQ7kNvwEh6CaN&_nc_oc=AdpHntFnb2ksSAZVVWibTCzCURsaVu4IMPAlJQ7iUgI4K85DpT6BDlY6kcTW6BBf1wg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHYiNvGZrq_oQUb5ThdoZ7E6Gt7rMFM8wEc489stQoSFg&oe=6A95CB32"}, "display_name": "Into the Radius", "keywords": ["atmospheric", "shooter", "survival", "horror", "gun"], "long_description": "A VR single-player survival shooter.\n\nYou find yourself in the middle of the blighted zone cut from the outside world. Your guns and your wits are all you have left. Fight the deadly enemies, dodge dangerous anomalies, collect wondrous artifacts on your way to the center of the Radius to find your way out.\n\nExplore the Radius\nBe careful: the Radius is swarming with deadly anomalies dealing damage to anyone foolish or daring enough to get close. Navigate with your realistic map, plan your route, climb over obstacles, scout out shelters, uncover loot caches, and try not to get killed. At least not too often.\n\nCollect and fire realistic guns\nRealistic interaction with a stunning variety of firearms like the AKM Kalashnikov, PM Pistolet Makarova, SKS Carbine, M9 Beretta, PPsh, FN SCAR, and many more.\n\nSurvive by all means\nNavigate the terrain, move slowly, take cover, crouch, sneak, and beware the threats around you!\n", "short_description": "Explore the vast post-apocalyptic area of the Radius in this single-player survival VR shooter. Reach the epicenter of the desolate Anomaly Zone using your wits and a wide arsenal of weapons with realistic handling mechanics.\n"}]}, "developer_name": "CM Games", "developer_privacy_policy_url": "https://cm.games/pr
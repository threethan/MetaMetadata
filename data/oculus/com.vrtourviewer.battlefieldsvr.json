5033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QSBd9-Hxc_QQ7kNvwHZ9jAN&_nc_oc=AdoiM1rZ-UeMaJbESa7AEH3SwwZSPpdBHjzPnXrvD7Hlcis3VP7elX9Dz1yTxZIDYHg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ZHNX42l7O23rBh3k65R5l8tpUCv4_vd1s5SYBLxydqQ&oe=6A3A9D69"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BtI-2VcJ7HcQ7kNvwHyeHu0&_nc_oc=AdrCUEAzXBA2Q84B1ro-xlCXY8c8tQ5ddL_eEWY_301hggiv4i3RqJk1b43OHXOsko0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9UoI_X7sC-vuvfizQIVRxtGyjac9o6VuBtaHiB1_dUnQ&oe=6A3A991D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kJ-PAtwCcZwQ7kNvwGYwK8F&_nc_oc=Adr_bqV7l1d-mw7l3z4SbFE0ewV7OSHq9vOmoLdLkrvruUsj4AqqxDuw40EBWEsO-CI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Gyx5m3fofOyBo423g24cOaA9F-ftAH2kvyoZghe64Sg&oe=6A3A9409"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qKPMrPatbVwQ7kNvwG0RGBM&_nc_oc=Adrp15GiFRy20d32MCk5JFg09wiHl8ypjJuGv7oRAImL5cPxkPIOAlhCMQp1P4Zf9MY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_kHpg_GURTHLG8MVayj5XB6MdtkV8c_ssFEPqzOIKrQ&oe=6A3A84ED"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nzYwv15CO_EQ7kNvwEC_Jix&_nc_oc=Adql6KjIDQXMpsTXiGMPsW0ioU8uSlq5ktZrG_pI_7cLPKso7JK2TnoMUA_9c0FbxrA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af99LWu9Un2OYZPSfnHB5m9TzoJZnj370NpLCbYGKXdcPA&oe=6A3AAA1E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
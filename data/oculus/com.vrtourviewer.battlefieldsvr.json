5033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Ux3w-58GoMQ7kNvwFQSNIo&_nc_oc=AdrwyNsuHWJPgMfKDk8w1WfHm_2s6klzMi1TBX6o_UbBDGJD1n3cAiakeBtIPv7O9vo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQML6iXTqcBjYN9T2hn1uVmg7u2zV6Q52GSclvcTd-nzGw&oe=6ADE1769"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bTp9DQUrbdkQ7kNvwFzSRYg&_nc_oc=Adre2Fq4gS4M4xAQdSRb9x502wmjUCN6zHwixC4Mj2hwb-lTHET6uVmKsTdokbScUSI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNlIChKohRyDFPYN2nR4wPmu_zuib8etU48U5YLAL8NkA&oe=6ADE131D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2lVBa4TfUkUQ7kNvwE95-6t&_nc_oc=AdonejpyadnPN6zmllVvxShxKsIJg8zd5u-p0MZEqfj9sIik61KLoXiDmJ_0c1UPFJI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPfP98Rzx0Qkz6stgjd4pAPXmz5-jj0q--DEUwcVJTM-g&oe=6ADE0E09"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YhCMdup3aVQQ7kNvwEkHjiB&_nc_oc=AdoixZEwuRlEPZj-mX0XlXvvveidRfX527sD7ZCLQym-Xo_bhbSN-1TXxD8qMXUnTIA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMCVM4xAZIQ9qVkN93lfiNt74RHnaeGr1BF9v70t_dKHw&oe=6ADDFEED"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iUSbZttDwKEQ7kNvwG_SYga&_nc_oc=AdpzS0dwiJ7DPCs0U0656SxhAGetxbq7PLGKT2RPTWj1k0Cq17pL-NlDBHqnmAw86bQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMwHdsRgsOKn_Vr0WphVyPRajbTvLuYyhQ_4EpjODBMPw&oe=6ADE241E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
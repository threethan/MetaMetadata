5033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bFMgACWiR78Q7kNvwHx8ZkQ&_nc_oc=AdpKxBA0D9Pm7LHpHLk-oMQgfHOMH_5-e5ZDqV1I2XkRsJnp__K8tLXKOFtouQB9ew8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH2AVZ_6FjHyO6sp9H_XyjK4CZTbnY8cIEno1b0MP8faA&oe=6A8AD0A9"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J4Ijjfkg4TQQ7kNvwFO5zSF&_nc_oc=AdpbH5SE-8x7tzCW4XkZdz0w3SHdwLfpD7z0Q-VYm0s5rYsUfUj3z5q0bwQnnurQoEM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE7a892TKNWX2sEsV243blvPlwHLiPWwkaPFQegBUHrsg&oe=6A8ACC5D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WpVtYagM3jgQ7kNvwEmp4Qp&_nc_oc=Ado7etTygbMM_rnG80SggYV5r5AoCzz_yXnotJctMwmCXJOw2a4c5ZfnEl1jUBXr04g&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZx4t9qvsrnpn7DPTKvgC9kSR2WP-yOFDmf_3uaVHcUQ&oe=6A8AC749"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=alYGH3uHE-0Q7kNvwEqc1mO&_nc_oc=AdpBFUPGtcscP5LyFYqoWu4sbyDd6xstmcIn8EZwW9rTbAfYDz8mUp9GS7zcc2P_ZDM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEGRBfAGC97tQM44Iy88VOT4_FEsaX_xfJaPQJVtis8vw&oe=6A8AF06D"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Fu8M0zHVfEQ7kNvwFe5snB&_nc_oc=Adr5drzdJWn5CqIcEw38dfihX0zbOX2dTIEBj6CeuE9cP21prV2Qwm1MSdNdIqkzZCw&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQECfNmb4ZK0uiu_k27LnFjNRmVKpyH_pwNo_g7ZeOeRDA&oe=6A8ADD5E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
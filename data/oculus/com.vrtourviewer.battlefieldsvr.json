266605033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YzVycgwAoQgQ7kNvwHnAASi&_nc_oc=Adq4Z1XhaG4ghZ_QunqfpYzA6kca9UoMU4mscaGWaG9g9nGuAHlq-mE2kc6p4ivSjMA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFrDHwGZVT8UhRhsGunOvY68JS9Ao_x2-Krk56QCMH8GA&oe=6A8EC529"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QZzOGDa7PFkQ7kNvwFxeGc5&_nc_oc=AdqXkgVkCzpunttCBUEw1tcFTA8l4viayAMFpTW6cddobZdbsB2XCVlAPH5eKIw3sR0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQElx-H-9GxiW_9w0QIelW7Wr013r2dFm76LVuBzmpVUTQ&oe=6A8EF91D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mOHOYIGS2AkQ7kNvwGfVYOZ&_nc_oc=AdrNKwG6s-e9JwYoYruYWw7zjxHPmBatDQiazULGT-arCCyeHWekr93X1Xf4zUHGezw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCtcyjC2nEOjZ_wwoAAPhP0nOsD-w0kTil4KTUlyJ8UQ&oe=6A8EF409"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7nDb5VT8k70Q7kNvwF0vE42&_nc_oc=AdooAqEjL2S5HnhsbI9DzIbLy63lIUMjbG-85DMrdgEf2pHnGaYQFDzvUQIk-qwUz_w&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpc7Ej_8q6zdG0m6jPWHBdG4mjXBswIFnSOZe69kfZLg&oe=6A8EE4ED"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GEOpZ8FkMUQQ7kNvwEcCxUp&_nc_oc=Adpc9u81SFYyE1FYjbYGLt-08zKPWTxVc3zgx-rXZq8ANdhZ4Y5dRda6G4kb5bzMrgc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9SGJbA_DSgllSsgxbFXMMaYUrK0p-DE_wRYi6hTCMqQ&oe=6A8ED1DE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": nul
5033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=By_hevljDsYQ7kNvwF-nRLp&_nc_oc=AdqnLVDoFs62mbg0AsQYhkZYWoNJua3_HWj74xyR72UuUI0PU7UTJeadTGbJ9vTPi4o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHfY-rxSAJ0shghgIWTYJ0-g-jARxzcA0cx_3s0pWPTgw&oe=6A7893E9"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=skFd7MkjJ_gQ7kNvwHbNFhP&_nc_oc=AdrgvmiKrInSEwDRl3uBCbyLMP0R6cwltNBFDUXCuck4BQ4hV7E41tCoFtU--sqUrgQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFrm8vd-_LN4pdFRfhOzZXaMb1wjkhEamz8Wy8Nuho9mw&oe=6A788F9D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uEnZOfVTv-AQ7kNvwHXTLWY&_nc_oc=AdpAb5o8tje4gpkPM42M_lqPDhBvVLeK12I4cJapi7OG11ukFRHgLK306eAxSc1OEUY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhw9xTiN21d9-XYlrVDpj8OwIHbb4HhoUMm7ZW5Pk5cg&oe=6A788A89"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2qhhZSiTsVYQ7kNvwEtsmA1&_nc_oc=AdqSAHoUL1UME8RzpkbN8zsgMGdyc500JDraTPpnqYrg84dTloX1x_MSvH9B97LaBG0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4vWMSIxAlQL7EAVlCVJJ0gvGAm512RQdWyC6vVo8H4Q&oe=6A787B6D"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OlD4OzdWD44Q7kNvwFhEYd4&_nc_oc=AdrlGxpyntYXwo5vUS6pOKWxhYBXfGriVMyK0AI_2jUXlK723SV0Mrr47-J35GeZS_0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1cMzYKa2Fzni2dTGYVFRlvXJaMLyBsegc1z_yjIWqxg&oe=6A78685E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
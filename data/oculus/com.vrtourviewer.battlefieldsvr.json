_oc=AdmIRHcdRRIrO4FCCLkqJHQaot0BliAW-UUurLgDtPjQu437iuwlH5kfe45vOgdXe4Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftc-VO9jHRLDlGc62bOHjyhE9OZVd7Nr3965pQshjwV2w&oe=699D82A9"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HSLXL0PMINgQ7kNvwHBB6bW&_nc_oc=Adn8wFWRB9UuEUb2sRbRMoqBdzheh_jNcURuAW3XtXT1rUiKJPI_-8A9hzizshQBki0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfujcMuiQ-8O0jkDdBJ01rVlHozybd947wS90PW7cqxz5A&oe=699DB69D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vZAUoDCQIAYQ7kNvwGEkxqD&_nc_oc=Admtj-sScalN0x9FW1PrgAFHRrzfy2VxF5IP9sR_8V6qWtKijqxl4X4liAEsRbVfces&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsXorx5dqXJxxLtR5gItQeiAXSihMtUH-7HoQw6fP5iqg&oe=699DB189"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o4T4Lm8AQvgQ7kNvwE30yvg&_nc_oc=AdmMbFMyf9GGjYl89NwNyBbX11QV5e3ZlOLzQAFarPdDQR5esrAVH5s2PAPunhjeMY4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftxcfDM8RDJk0jpsjKKEVJLAubGyC5PXRbDul7XRCkVyg&oe=699DA26D"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ia7k--N_wUAQ7kNvwEOpJSs&_nc_oc=AdkFh8YE0uVxpGy91Eak8XbLTPdNYvMrEaKd5DbT7lc1Qtxh-YfLzKrwgemLYcdqEG8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuDklEAxJZiXYR8BiW852jTrKRQutC1Bxk9Ftpj8OtF6A&oe=699D8F5E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING
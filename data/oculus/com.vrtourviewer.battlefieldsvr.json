5033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3s9Gt65rp6EQ7kNvwFOFtPJ&_nc_oc=AdrIuCdKG5XP-trlgxgXa0uidle3x8h-Q2wcf9VCQIRLOkZexJMNA3BJmIelFqJ6WFY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9LuCF2Pg4Pc2913uXg5sT39BIGOjQETtNyRK8gr79V0A&oe=6A2D6E69"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F39ZTekxrXsQ7kNvwGqjV8s&_nc_oc=AdozubY2zzFnJhmfhT8K7-jmCQqkPhF8uMYxtvW3gfhDmgoR4hZH3WyKpmamZTuy1MM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-bfVsLViWZ2v4e2np-B_nwM6xsz3MdOSDERXjvLnQlRw&oe=6A2D6A1D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SZTj2aCd4fYQ7kNvwEd5Vjz&_nc_oc=AdqnYSB-CoxN0j1AyYF0KKIMr4jLwW98MTLmPE7ZEA4xJ6KZotSGuA6MiRfuSq8x0Lc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mMlYwLh7RxnPWDDFBVqYKoj42GCIM2ZUnCp7gyUepqg&oe=6A2D6509"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M6zHnbpqy0QQ7kNvwGCsgHM&_nc_oc=AdqJoQKDF8DeMDzWTd_UkH3pfoWn-QNWVVyHNhuYc_cLyRSriZbZ0BZ9rzjOqDDRdPA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8YQ60TTN0ArJVdJw8aWIFHtHEbUWw9C9j_M3gAuyClEA&oe=6A2D55ED"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k8VqLh5-KGcQ7kNvwHZ8Suw&_nc_oc=AdoF1hCWPVmBHYML_RxMaJR1l_LygmetMGa-HtyX9GxMLHtl6t4D1ccfFBB-MmLeIGY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8pnsfnXQ3MtnFDuYhw51dkKh_EbzXVaYiqku6VN5rDQg&oe=6A2D7B1E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
5033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7mieswxomRMQ7kNvwF8g-lg&_nc_oc=AdpeqVjzw3UjZYSEv94UzJE4AjySEYvPz06zZCnxUIsKFgfRWjmmgCof8rXKA6PoPI8&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBSeZXRg5hKaECp34r8_m42drtyzjCx1HClfCgFtgkPLw&oe=6A564CE9"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4t8VV0xS9LwQ7kNvwFW65mR&_nc_oc=AdrxWKaqSqw9DxuzN0LUYjJv0UnobaL7m-6HM8uqwijebi2VIj1Jdmoq8WxLv9GdNmE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBloH7h8nbdO8mVoUrD_A0NMkq5Lg2VpnQfPf-lePHcyQ&oe=6A56489D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BWhiwxPWQ1oQ7kNvwFs-Gas&_nc_oc=AdpPzd-SJInN9Jp93ESN0Wsbd5r8YGykYkSHjGXBUm200meQlszlLr5pbIXIuN79ON4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD2rcCRQpHcofekVSgxxRPcAOfhlg_nCz_AT6XnIdO82A&oe=6A564389"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gL8PvejLwZcQ7kNvwHgi0zR&_nc_oc=AdrGqq-qhZE99bE6pFYB6Isk3K_-1g1waFtCjh5gEWW8Vw7BLk9c-a3k_MX4MS7A5Uk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhsFcZ-GVWmfg3cHrBxYZa2cWkQC_8XcrouAomsYYVrg&oe=6A56346D"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bRZaIziH5NsQ7kNvwEMc2hj&_nc_oc=Adp9Gcc3YJebOQveQnE4aUam63kRYxRbQsVeoMKPwoDTo8m58Elc7WQsTUQ511eNiw0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBoMNZ83mL7olTYoipw3E0G-sWwKjGPXeMJJ9CveiFGFw&oe=6A56599E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
5033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NYLAl9h3JAgQ7kNvwFsyFpf&_nc_oc=AdqkS3wgPla85r9JrHlJitrOt9KKgQq1VUQG-x0op9gwiRQw-pfLZx-ngrmwdAy8faQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNFCBUpppeynOQIJrHgzASPSuLIGpi3Q26_46Y6OFOyg&oe=6A86DC29"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UrmETlaDfsAQ7kNvwGO5a1K&_nc_oc=Adq0UYVT_8lUVGcFFKSbGzfVUcT96V4GIT-pf_Ep6vVFr8OSqp2mSZcU5iuUBw0S1Gs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGOtzyGclCG8O-B_0rZI2MDPPjnZU_14pfmy2dMcwlhsw&oe=6A86D7DD"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xRB_lZ33YSwQ7kNvwE5zdqu&_nc_oc=Adr3N1tMY0XqXvlpm954afou4W0fLQVIvVTI0gpH4Nl7bf1Hla8Q2Nh_08_YE_HqKBw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFD2GJPviRE1qapurcVvbCRQfBz5nCnIyP_Om-Scd1WsQ&oe=6A86D2C9"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SUHNHWKYJ9kQ7kNvwH9q9r3&_nc_oc=Ado0sGJ1k9Q6PdbM8HGQt3CGSzZBGVQmcbRBjaxLJIrATH2hvLtbd7qmHfETbmyUCxM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFj3nmyp6MpBKnEgJnuRPsMiRq1SzOKDBylGUPcO7n80A&oe=6A86FBED"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KvZjkAa60z8Q7kNvwEIvmSC&_nc_oc=Ado0oGfbMlVDaw2al3ox2NKbmNGnIZJnESwM2xbaPvlsn8reL_dr_6OmSRxmXG3qTRY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhClZeUJHJ7SYpFL8HJlT11aW_xUqp5I6YDoWhGNdQ9A&oe=6A86E8DE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
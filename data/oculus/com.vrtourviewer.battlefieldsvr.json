5033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7RA9PyeW6AAQ7kNvwH0Uh9z&_nc_oc=AdrtpbjXWr69lXjOr-mzLZZSLC0LxUG-38O9XjUK4vmEOkF2UUrWl7cEFgY4JHZ_fGE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNwmPWKDVXjuKeOkVqxNWmtcqGByBwki65qqPXP23Xcxg&oe=6AC267E9"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0pnWDYI7etgQ7kNvwEKSLmt&_nc_oc=AdoqxBVcdYwG_Eftr5cOEPbcOyCS2QVZN0qHLj3Bn0b16EbxGTL_aK_4x1gAwji_W0k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOvgE3fydssdcohJHT9WWqYJSBJ9JIDn2Dr05M7o6h0JA&oe=6AC2639D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sZpxgmbwcNYQ7kNvwF9cC9i&_nc_oc=Adq9pMsUQaPbcpigkkgAwd984d0EcrSmGVOiASSAKiVZ-iesLlCurJkg2hvXnAw3W0g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNMzxbFH2AEQV3CAxNko2XI5CzWthj9_R0J0QkSbiHWxA&oe=6AC25E89"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nRSOY5cPrfYQ7kNvwGtoz_Q&_nc_oc=Adq_s715INfqznIJ_qYklhwZUq__2QN-_9VV2btc6Z_4DjQCvcaeoDYzlZDFOzygpsY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOOrFMLatf8W7veI7N2lyI5rFpXswIoQDYKFrvwiIUhgw&oe=6AC24F6D"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M2Yhf6JAdPQQ7kNvwHCN5RH&_nc_oc=Adrvbnw3y5VDrpLTPCplHXb7h-As7e-dlJuqHmBFJ6PKXb4aSOco5Xd1oie5GNoYhJo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNmpRfLlWjZw9AHlxUZqytgJrE7yHs-GeMKMQf9YyMqeQ&oe=6AC2749E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
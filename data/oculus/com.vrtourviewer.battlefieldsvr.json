5033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p3AMj3wvaNsQ7kNvwEvpavw&_nc_oc=AdrResnQhGAWXEFzUTSApQhJr3M3PB9CRIYeg4zbvDXzcnsFN9euY4vOFKJ0RBo_Psg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-UgEPTcTSYywArvwLFFT7KtpaG-IC7ZSeXVPSbeCy4A&oe=6A9ADAE9"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GAyGgcXsxlAQ7kNvwFQXoPW&_nc_oc=Adp_C73_QYfBDkDOg8c099nJY8OuYXqM01tWme2vdQyA1uqrZVjV9fHNqvQ4LjoMXco&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIL4Z7JEUHU6SVuvEAFvktCT5oECKIshmrm-LXeHW1C_g&oe=6A9AD69D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SU_pFQMPaXoQ7kNvwHtc9EW&_nc_oc=AdpcGVRbdwsTVlwu2DIcalDhsSx75e8v9gtNHK0o3-eYIMuinNLcojNNGqEsZNT_JOg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-ftvpLLfFUwTI9TaAze0be5qBSbC1lNSzEX15BNL8GQ&oe=6A9AD189"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tHPglfqhxrwQ7kNvwHgvvUh&_nc_oc=AdrtQZeYUBe3AjiSiNMDqwqG-D8BFEV0KjX8OmjrYUi3ho_gLp7kwx3gI9TlLRcREJk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIwCyyMuoM-x8xJOObpyJ1_CDa08dDfFga4yzczeFYuPg&oe=6A9AC26D"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C0KvI1o6HY0Q7kNvwGliuYM&_nc_oc=AdpFz58yDVgtMwbNBIwVc8YnCySa1Bh-CDpiWtfyy9vvHcXvkXtqph4trqUeMSSj7A8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1HyeF3xUS4wCb8OuWIkUCTSx1RN3l4k6mlX_t6lcVJQ&oe=6A9AE79E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
5033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ldTD73WnQKcQ7kNvwHdEFwl&_nc_oc=Adqut2yNh8Y6OIv2yZeKU-szFOx2gAZenellB-0NRV5M58rSg77T8cbAzF_vm3gaJc4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wh3OZmoL2nDAxORfJ8ngLc0idC7Ln-zEDOCG9Dl66sg&oe=6A0DCA69"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UE-6OTkbJJcQ7kNvwEOel24&_nc_oc=AdrwNAakz_PbcswjglZ1jxTVHpeBwwB1Prjyhfuq_OkzKpBKW97uDfPm1V0KKJrvgRs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6oNHZpojYrC30W1Me-Bx-y9NbAqvrl-qrPQFBK370Z0w&oe=6A0DC61D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a9uHXDgMH7cQ7kNvwGMgmMe&_nc_oc=AdpCsqsAjk7dm9Qh3sEPrGTo4BxTHKgAottT5Ip9djgw1ioDZ6ewH388eywxcElQAZM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4NFD2lDb_RhA3rvEweX3wopf-AnUtI0hYJXqLbPNArrg&oe=6A0DC109"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7zEmO44WOfIQ7kNvwHZCqbQ&_nc_oc=AdrhHN_Q4CUcRap5qfmF89e8iXh3wC1mWQ_o2sLmev89HUuXZDHWsA_BtT-qNOYzNXs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ele6uuocQJSNLavMIHpJzLR3HKs85MhqVhfmh-0Gu9g&oe=6A0DB1ED"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pQn1kc8sr44Q7kNvwFTWmL5&_nc_oc=AdrDONNpY67JzLWSmfRmpoTQPrhw3uCZOFvlCC9KXExl8bljMODquq8i_9UEq-gFyoo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4wuGF_BpVcaHxWxkLjdCQ84_cQ99dyxtRCpgPu8HlvYQ&oe=6A0D9EDE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
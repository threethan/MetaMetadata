5033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wCL6-k8aKvMQ7kNvwEWX-uf&_nc_oc=AdrRzLK7kE1UW2rlABEgxuEMm_w7Hia-3g_z81StfKB3KmH3TTP1lK_ALd3mX9q9aAA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1SbO_7ttW2HaEsFDqtwm_DwnKEEBxReCcZ9GBGuwRYpQ&oe=69DBB169"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BKfnfq1HGqsQ7kNvwGEFvd0&_nc_oc=AdpN21Yj7pyoqdHlkd3XlPStrM-OmBUIADt__N5Ueg2rjGvbCnyLB1kIUrcTqLUtyC8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2SvBxd0OBlY0Hoi4IaEPsH5M-phsV0LaGqunNSPIujBw&oe=69DBAD1D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=znqkTBOCKkIQ7kNvwExn9jn&_nc_oc=AdrxwAb0H225zIG9HOrlww3PHWhwZ72qQuvFMEHsSDVN0E6aC6hMMCDemHnEX76ACSY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0gaiTIwabZzNtIbC1aRwX_f6MYXVPL8pr_A7QCsNnVQw&oe=69DBA809"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xiTROY9L5iEQ7kNvwEw_zcv&_nc_oc=AdoXHkcJCUP97nG0eQdCgAdeymAV_iOF_qdNJKawUHOFaMbpwKHWW9Ye7CBmLXnfWpM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3a-sUHBvqu50ybyOR1K02db5zCHX-8Dy2YV9LLNoPdww&oe=69DB98ED"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KcAeiUqcz1YQ7kNvwF7FBUP&_nc_oc=Adp9zW-LGxehFpOTA7Cx_4xtlj0Xr5hXAl_tIO_1bn_f42Y2eDxafdyy8OQJ04p2Mdk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0B5M5cbXbUD15hKj9_APQhf0mQYZLUP-U4VnDG3NOXFQ&oe=69DB85DE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
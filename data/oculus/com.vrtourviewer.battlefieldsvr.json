5033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jqKb08YsP6UQ7kNvwEFpeHB&_nc_oc=Adq0rNy-BvR4IC8uiM8IMiQxM5FlOKcjy4J3JHvDBZ6K5UZy1Baafo3Cnz2Ye9qF-ww&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8p3J_XVX5QsEmp2wTiH96adtOjin8jiUjZHp1M22pIzw&oe=6A258569"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7M7lFQEZb94Q7kNvwF6kow4&_nc_oc=AdoQp2pIFbaIf0uwsd4deNUqpM8pLKLA0FdEyZafZDS3Ghj7WA8hoYo5H7c6ayU6Q9s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-qhf0qzjFcCas5SK0wszSU0Ei0bmePuBCo4aWS1WNT7w&oe=6A25811D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=giTkLyZZozEQ7kNvwFjzjGi&_nc_oc=AdoRnCUqmuGlUy8Jqa_rA-Ac6xu-iGL5q2JtOP_feQiFbx8Cttzk6hO922FzU0Pvw5I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8KLCW4bwDzk-x-B61DIAgspPezh-A4jWvYTgn6T3N9A&oe=6A257C09"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9TFMaBEn47QQ7kNvwHOL8-5&_nc_oc=AdqdHkcdJDCqvfUDOzuCGyVPbxO-JvTm24GYYe6fOBxF95lihaoqem2xCdOnEnPmUAs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6h8w1KUh_eZ8G3fxkFJbgr-mjJ4q57gk-U0aILqY7TA&oe=6A256CED"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EtmoBIK38M4Q7kNvwFtxQfy&_nc_oc=AdrbiyMjo-tlboGLVrkEYB_I_wvgEdeMA79uxtKTOgL4lXJkiAxDfEwHWEFlH3VtxDE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_EvdbbZDGWHzgRN2Sd0Ta1J62sFSB3zhFlCoWdQ_exQ&oe=6A25921E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
5033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-MzhyaUJMzgQ7kNvwEpXAnC&_nc_oc=AdrfHwYLyhSWLMUXNGANzvLuFrcffu0TowiWjJ3a685ykWs480vJ_ejwZt_hr3YWbFk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_PIRnkZn3-6TLQeFxND-PO7irX5VQuN_ixWNejTI0j-Q&oe=6A4134E9"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0dFFm2jFu5MQ7kNvwFyrcKj&_nc_oc=Adp-JNYvo5rPoDeoOWQbg2wXWaXErEjfKIFX0ckvvyUlj-DBi2198RNOwvX5e78pHc0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8I98mgz7-NHS7N0WE21s7qUjJ2Kju9lrpchie9Jzmd1Q&oe=6A41309D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ocf1T_fH-H4Q7kNvwEe_RL-&_nc_oc=AdqvTCbo4V-oYoK83RuG_EAbKDFanCeR25qD6-cYwsgNeioXf7ew9KiwARc7knHqwW4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9GpkbV8iH5NAMxt7Ki_C_ZHngub2t2mYiHOZ0fJEv5NA&oe=6A412B89"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Rq4Xze1ODQQ7kNvwFDqx9G&_nc_oc=AdooB2_yvxjQjSoEgjSguf3Sz_jzZ5IY_1s1zw0zVGYf4sk5itLKa-jIsmgTNxaZjJo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_KCp4nwgwFjb1jelzNWof-6BjbilXFEKBt2s-IPi-C6A&oe=6A411C6D"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BONbzedUR4IQ7kNvwE1EUUo&_nc_oc=Adop2uKF-6V6i_JJuunxlVzgb2uK0Am-HS3ZzGEamTxNTyyKfIRrICjkHrbZEPuJ-GI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-D8gDUbGo5PuKW409_0GmATrgKVidZwSwV_7Oc2m0Q_g&oe=6A41419E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
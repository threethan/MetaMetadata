5033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WMrEi6rhLvAQ7kNvwG2Y-Z3&_nc_oc=Ado7kfJJTSbJ1YFK_atuQON7tnCoEbHiN0Id0r3WRY-9wpkLqLgkGpZAOrR2LAdSrY4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBgpPcYarKHfaCVrGx9lCFVuI5emMJKyj3-5U8Mw8gRcg&oe=6A53A9E9"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RiHnb4-CExwQ7kNvwGmkMSv&_nc_oc=AdrhjZbyAgIf52Xs0sCDIS-rXN00GW-Su7SN5Bb6B0BmvPFot1OM85U8OVxl3S5Eptk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBKQpwFYyMnXO58JgOUYDGbOY9wHQVCzM9FQBdfVMgQSQ&oe=6A53A59D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bu-2-K9IQq0Q7kNvwEtEcKK&_nc_oc=AdpjCS6Z6BQpgAxxqgo9pj2tg-7wjG32vJgY02IBvWsIa63Uhb7F9UfCnmuXa8C1Qns&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBfYB0U-BOaSmuzxNbGj8I-e9fX2aGP45kAhGvV3KIwig&oe=6A53A089"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=63hqWbfnICYQ7kNvwHmA4_g&_nc_oc=AdrzPiCD-mbJa3k6FSvffM5fnFASmNPKUqd8yhNFNhptRABG4eTeYpSAZLskxI2nLNY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBow2nUaOd25pYgfz3vpg3mZTIFINrftXdeoTPkUfxOxQ&oe=6A53916D"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bRZaIziH5NsQ7kNvwGdJIRQ&_nc_oc=Ado6ag46VKTPgSXqR-8xxle9w74JZwyUa4J9Rhjg0J6-bH2FrPqyA9MZrwOJytoy8Iw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDSYQ-i2GPZybtRlqPUPX-9XrE2n-xVCJV-82kn3Ldwzg&oe=6A537E5E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
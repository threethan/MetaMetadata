266605033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NYLAl9h3JAgQ7kNvwE9ti2K&_nc_oc=Adra1AOwifBCHYzaCEJG-Z3-7SZ4kBMuN0xnThbnx7NDcpEcda3ARlOmGXFK2NuDRP4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFMEthQtLhbYt1t0LlVSpbVbdMo2iWeLt_6NFmdD5wRAw&oe=6A858AA9"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UrmETlaDfsAQ7kNvwEtMnez&_nc_oc=Adp_6OSbIEmILN5661hXYp84X3Ea9BMh0dfLvG31BaQJAXor0Nxz1FLg6a7-1PlOZ_8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFHUDHNgAdy1IwCAf2wYJ2CNEwDNWwb5ZuSFUbMWAAUmg&oe=6A85865D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xRB_lZ33YSwQ7kNvwHH9fWt&_nc_oc=Adode9X3upFfQUc_23khYiPLtS6NCs_Qoet7MMSEC_6KbnC7GV14u3wQaAL0RfNlST8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEfPvcLqy-ajcIBOH9h1zqGa3CFppMeTmHrCsTsEehKtQ&oe=6A858149"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SUHNHWKYJ9kQ7kNvwEYqoKe&_nc_oc=AdoyXIjSrq2YDgRhWorddvbFr1OCKufegZDoDVuII5xLSA7J2q5Bjbq8915RMSPFRCE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErhHKdUV_3wL_7xLWAJ8ECQTqkxCrkWgQp7zwGai1scA&oe=6A85AA6D"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5hh2rhCbVK0Q7kNvwFhg7NP&_nc_oc=AdraQQG0UlQAcsYWXYgDPx_h952YmPue2gLInBb22QNmCppAuC6y4s-z24aCF-0uNrs&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDJWssNfxzXzrK-K10Gay5Wdcd135WIt2PsDR1-Ib96A&oe=6A85975E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": nul
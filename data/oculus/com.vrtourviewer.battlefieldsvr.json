5033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fBqAUiHliP0Q7kNvwGJwutw&_nc_oc=AdpfdtPCwy0rPtQv5peNjodbrEHZZbf7SZ9q8E1eg9kkyDj5UnR-5eouoqExXucL9zA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3qnqP2J0dtG2U_KGin4QuZI6U5VxT-ONiGtMn_g_UvGA&oe=69D276E9"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_cp5DOnjbnIQ7kNvwEQ6hwN&_nc_oc=Adr8A4kKOkBU9jPCyWKZW68hsZWdaiZCFkL-sz2RIehY6JV04VQpFeqF_TVdiioVIjE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1lXQSQFhAZ3B2IHran-rrI036nUmWW85QlNB2-KG4o3Q&oe=69D2729D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H1vo345hqGEQ7kNvwFLIlVA&_nc_oc=AdpZnn9pP2KJQ3osuIbPZJ97cwczknEBK4HwTlRpL_QUcHezFy0Q4hSLHJabyEe9Jz8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3KZKfFEdUCjoOmZKeBqUbxem3h0C-Yww11xVo4ipqTCQ&oe=69D26D89"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qazveJ72zRIQ7kNvwE7JS8L&_nc_oc=AdrCQfQkiaSyHs72sk-fGYhUnRzHX8NaZZXr_ZvSdsNYxg2fWfrTiCbx7C59xNa-l_8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1BW9yMekYVAM_oWi73pseWLCSZO_es_siuAX5KGVR0Ig&oe=69D25E6D"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8jV5NUTGLbQQ7kNvwFLQgtO&_nc_oc=AdodUzLoxlmnYrzU6rGHnX4UVpIvJGHoC9GdHb6ywjsECzY4KM6G_clmX5QxR0HdEd8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3SNzYgLzTIkHuePzbKd0WimhJoZrsWioxLwYgX0MA1aw&oe=69D24B5E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
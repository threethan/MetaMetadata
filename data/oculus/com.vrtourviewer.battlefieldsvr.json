5033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=697-ggOR1eMQ7kNvwHcyZkb&_nc_oc=AdrhMhIclivuk3G4WjyH1vtr0XqvWOBQw4bt-kdtGN6g3ybpNWKO-TxBeunQO0CAle4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_BaJdE_lGQlceqHoe--nXLOArBrNyVBhoV8Z5iLTAJNg&oe=6A2ACB69"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F39ZTekxrXsQ7kNvwFt5Vpu&_nc_oc=Adqyhcd2z5bKdDeXjIHYwVxTn9BJvsiOqam5Kx4Ia5KLAn-sjoEJO6R0Rk_tBqpeC3A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jdGbh9PhmG8FyhDf36J7KPcEA4qUrjYnbzTDyggwVKQ&oe=6A2AC71D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xkZ1TbuTZ-4Q7kNvwHdu7iu&_nc_oc=Adp7IWwSHxNmLKl3f9pBSpzkJqkADnwgCGonQVR06tHjQQ9UFU4oA7d4MG7tgA7B5Fs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9LZ4hi7l9OpiNaEkSfScs-QcpUklOQIacdtvutsdJDBg&oe=6A2AC209"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6RM8C3nlzhUQ7kNvwGveiZj&_nc_oc=AdriWcbBPrCE1QhZ4hWp8Rk52_IWQVK1bBVXNw7FqaZs8hHBHk-tfTW8z236Zm2awvU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80uTbs0Z7oXAoLy4BlIITjzwpJk18hDAshrU34p8qFeA&oe=6A2AB2ED"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WwDuerO_mrsQ7kNvwHgvpvB&_nc_oc=AdrZ_se8NFKP0zO836VDdMFJ6TCHAoQ8B8kQZmz8HNuVHMzAjZPdO9XVhB9z8MGFY_Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9RDRjRJLyO3a-YTOjVNfwMBqazcTIBoM6KX5_01-1Qvw&oe=6A2AD81E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
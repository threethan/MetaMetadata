5033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xy3dwfseSxQQ7kNvwEP_z13&_nc_oc=AdoepNm_SaBNDba48p0oTyqcZzr0loGeahAG8Y0fUHLYy7FWA_PSX_sgbqHNdWyF8Qw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4pBGWu9ghjCCf9RdLRXjnhV46Pf01J56z49EAC84ulmQ&oe=6A1461E9"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VDQJvafYo04Q7kNvwH_O9IE&_nc_oc=AdqvfeewI5wsdjE6MM4KE-pPxxAbAknt95cp76mKbaJ0sq3-yqTkEzapYbUDrbtxWhc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zSPik5DHL4-sxQl4Z_oZssyND16bVcihBRP3iYDoC7A&oe=6A145D9D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3G4ySGnKH04Q7kNvwFJbOwV&_nc_oc=Adqr-At3R4vgUC6wQ0fwTwtK5Avo11imVVRaX2H1XCn4UvnT9cq4XT1M9SZeC_PgdC4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4oUEFtk7Ywp_xQm9i2dGpzmHYGB6U8Kg_fdJd4Wt7yTg&oe=6A145889"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U0q5dGM8gcEQ7kNvwEuOSup&_nc_oc=AdocTcn2u0RaybWfjFqJ8-AS2wEVn9vA-V7Dg-GJUlu5pW7OxXRbUkBgS7g2njXljc4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5CvRprETZmosIJJ8kMhQHF4jCP_igJ4f7RoA_c7pscZQ&oe=6A14496D"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tNIIDpc1P0sQ7kNvwGIJV7D&_nc_oc=AdpOSSmc1cXJh6PRtRkCrBrFsReg8bUhYcWdFVVbR_B3u6OSi2HRhF01Qp4plyWPb4A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af49P66tqNBxcpNAEMtQ1ZP85Vs1PxprwXZ68Gw3m8LnZg&oe=6A146E9E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
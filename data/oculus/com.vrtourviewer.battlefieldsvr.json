5033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QBCjw5-EtGoQ7kNvwFTKzEH&_nc_oc=AdooeiVzjPmYKcryhQJ_3OFDxCESSYg6EspTTN248ywtIiOn0OoT_H8bRRykpyZ9Ud8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAf3GMmkr0j3rakkB63skuBW_8-5b_EVGyRbNlePCy_lQ&oe=6A68C1E9"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h4t3q6v5SlIQ7kNvwEnEkXj&_nc_oc=Adq1Dj9tM1WhuIJF16UhJiNpEf7mfQz7TKLEdGFYXTMjJT8W5wEfyuq_RDPIZsjrGEY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDb8txfzroc9dc6jCs2X0DFyS9s1kBB4iXYpJvFFrrxaA&oe=6A68BD9D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B9mVWGax6jUQ7kNvwG3CxhF&_nc_oc=AdpT2iToolgqn4gcall-l5-31Iw1uuCFq6R89FZLuyxm6AFtIyyWu4outbcbx2F3MiU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCtuxs39-rmNFAI8XXLJdTIbYIiEClaTq2xTi_-Em5Tzg&oe=6A68B889"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sw4sbqQx5OAQ7kNvwGNG_t1&_nc_oc=Adq1zrYpye27L4xNiTn-VyPlpf2gED9x6qgCdePA7lXOarJDY3aw58c7Rb9nBc3Qfeg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDxxZ2bhmwUuMlcm55CBvYV0sZto5NYcoqUq1p8I_Iikg&oe=6A68A96D"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JPCyoqmjmDEQ7kNvwGwLnp3&_nc_oc=AdoFknSWCTmprcuY_0SuGCHa3W3HzkiJnfojjbZoZZ8k7xIz2pKg3z5waT2yB4nIMmY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCzfYprJvM8KDwSmLtQZbE_qYHce_tqr5skWtMtmRCI5g&oe=6A68965E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
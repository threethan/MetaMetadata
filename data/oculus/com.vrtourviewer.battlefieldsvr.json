_oc=AdmByw_MdzPRzlccu50GQi7nKUAIFOc1X_TIl9ETDPFlFZtQ6Vq3b6Wd_Xe9ULEFRbI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afva_hAn5zzH9DNBy2lobDRwRVFgH4CNGCpVlnvsUVXW3g&oe=69A6F569"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aml8z2wFqtIQ7kNvwHAT-Yz&_nc_oc=AdkuWpY2EmkCDlefjStbVrAJNlVR6tHqh7YSUqP_nm5P6baQBa4KL361tIkEWiKsD44&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftCBF1ui6Rj2tYQLqIwf3XoaWRN1glnMq9RoTSSVOcNTw&oe=69A6F11D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rZFchMm_E-8Q7kNvwEEbzAq&_nc_oc=AdmAvgpMsHXfVEtGNFoY5PUB_b3VcdBBnVAnlXeanRffN6vQwgqoSETuQkTL2FKn9wg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuWrg8gBD-C_yna90nzgStdpoU5jULHJRhA5objdrxFdg&oe=69A6EC09"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V2gx8rWplx4Q7kNvwEygjkH&_nc_oc=AdnELybFY5-CIE4BaOM-8fWgZGEe-_lqIUbOyaMVc_VrYGtDCXmT20jkj7t8gonrspk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvHkGid_M1w27hpm82a5lvUpK9Xvo0alDbKqb4zvo_FDg&oe=69A6DCED"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V_1C8WinO9AQ7kNvwED_F8X&_nc_oc=Adk-0YO9z_-ZBly8kVpazKHBMJ69F7bE258b-72wClDvjrlyp8Rc1whUSTeSGgld_N4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuYJ7Gx0ElgkUzKZEQZmAlZ4sZB57YhsgH7ptTGlOTpLw&oe=69A6C9DE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING
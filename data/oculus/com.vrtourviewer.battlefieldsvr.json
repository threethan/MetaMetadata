5033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xCBEF5oYzioQ7kNvwHXWqll&_nc_oc=Adpq4bVhZlTf3WHrOM-5rc5iYhZbCVq38Gl3apvRya9UQhw2ckhfFXKbfHFg3CUPwvw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCKTslXnbGqzJADLnZcd7cL7zT-DoXMLjvzzeqF8z6q9g&oe=6A5B92E9"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=skiBQ89LzTcQ7kNvwErvZlR&_nc_oc=Adqw-dwfJlX6G3l88eMW8Rk_gYHLS3FNDjGS7GO1m9VpZBNhqDx4xS7t8xp4q8zb3Do&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQADl0_89tOyW0eMwh_MQjQXW3Gsru1vryY6FjWSD-YdRQ&oe=6A5B8E9D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dMNAfDY9MpsQ7kNvwF4dZDY&_nc_oc=Adr5WivOLbh51A5LR4mGaKZnP5ntHMo3lBwrXco8CP9ZoKjBX7M15c4wX-85Fiz2Z74&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD5lMxw_yHprJR2x95ODcheqx9LWqyGL6Goz_jdCabgPQ&oe=6A5B8989"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7DE-unMGnBgQ7kNvwHDDfLm&_nc_oc=Adqk8u7_1MFPUdrPwe3CBS3mAZ0lbkL4WZAdSu7O06u9QrOYWjt2adJPg8WyVtLtCUA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDmC4CFY-CWtDnE15wnTI4EHipZlaW-Y9mON7EUyf4l7g&oe=6A5B7A6D"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y25vhkTHQB8Q7kNvwGn7bSF&_nc_oc=AdrirZRkGU7zgOWa98IpJTDuzPsEg4OqIOSuZ7Hh4XO0q6y-4rAxGnpTG16ZPvekaSE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8-5JOaQFzhlF8xTEd7rlyybqCazgI4EmNIVutVfEIEg&oe=6A5B675E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
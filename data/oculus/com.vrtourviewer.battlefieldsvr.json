266605033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XWHjdM6n65QQ7kNvwENRWR1&_nc_oc=AdoX515P7SsvVH9lDV_l4GUjNI4TiDZXh78hCTMPThlTVoJrvsTtcjtZbK5klVSt0gw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_ZDEBmyUW4qN28hG6xH9e7JpZb5jxeHHGO8CPXXjbmQ&oe=6AA95B69"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5sykP_F8u5wQ7kNvwGrbl1m&_nc_oc=AdqScjstyyg0aOaeM5_VJrckG4Ne5N_sBTQ5NMGPc89l3vi9lYIZljIe_JY7QbkzW40&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvfGK_7HePdRHN2NS7JLbuBcQKgfq9MBxsL8PaJvOY8Q&oe=6AA9571D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BmCMI_zRPOkQ7kNvwGDRREZ&_nc_oc=AdrPjFEkJ41mCGDjVD-QiOG-ueoJe5nzoS48WjBRhR4hBCpG4KbxHMvwz7NJToK65HU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKydGTe8H7z2g0Xh01GM46IPpVlFUHNXIidIXLP_vWC_A&oe=6AA95209"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=esTEZgyXQ04Q7kNvwGl_Tgc&_nc_oc=AdrcFkxoS61iiFwxkHykl6URZvtpp2oBcwH2ZltwhwOEUGldUPuoLchLGfNJuzb_XGo&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJH6xdCjphh9LXekLEkxouncGZwLTJaAs2zkrsfEGekvw&oe=6AA942ED"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b7fxXFmtSn8Q7kNvwGYqIwd&_nc_oc=Ado2UoJYprNYVV1c40OYAK09SNFyepOX_2EIO4cNdDF8Dz5natwEQeTVxwpq2s4diJ0&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKm1icyrxTF3obPPTNtZD7f6fzVDj1hwwB3twTm1Oa4FQ&oe=6AA9681E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "re
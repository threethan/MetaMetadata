5033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KEZY7Nbp8Z0Q7kNvwE90Cv1&_nc_oc=AdrCjqTJ3feI5AdtpCNanqZExuxpHIB9vuEEBmAIQJCKdSk4Ka3NsNU7Gz2ewEoo5A4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNtosawikKcrEucNwuwyJe_BDRQmUHPcIeG0C1CbuN2eA&oe=6AD38B69"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A-_wB9ZtsvEQ7kNvwHyIhhM&_nc_oc=AdpgCLX6Z56X2O65JDqNiygC9oigKrhuW71HAXPgIGYe3-qone1q_rdJhVlYNb7m6RM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNSstbc47Dk9i4Ovl-aSUPZTSDahwj1Q2NoUf6AcwFJ5Q&oe=6AD3871D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xw8dA19NMbkQ7kNvwECIx6K&_nc_oc=AdpbSu9fW9VCH1ypN8g4ly1VcEl2FkwL9LyIZVQO4prJjuYd3rTE9E5QxEi7KjRmpbM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOriNJi5SgN7L-otv4JngWK8wWV0QKZWUYuITn1R_3NDQ&oe=6AD3BA49"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mc4wjYA8vC8Q7kNvwGhPMVV&_nc_oc=AdqRv8Lr_J_B8dzxI0eHsyEL5d0bL2GHVMEFj8SjXRuPttFR3ZodTISWtPAhtnIwkr0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-gm6fvAcfl4LEExizcQbMELAzfHAZHA6uEq9sw606GA&oe=6AD3AB2D"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OgL5K0ISys0Q7kNvwGsPpPB&_nc_oc=AdphcJ7e7pOLIOmWQGcU58YMSYY23UwbhWj7ZABQQSKp0eDnVgPNwA7eds_lEmcWVa0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPA9MoxoRLRpUPut8jTUVYPiqteq19NkZx7QsmK38Jsmw&oe=6AD3981E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
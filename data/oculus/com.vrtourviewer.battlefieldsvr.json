5033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bFMgACWiR78Q7kNvwFojpva&_nc_oc=Adp8xslyzRCQtNLu1ETNNPWIQCibtcz7YPGx0vfn1QU1c7bLj_HfZX2Eb3ypKrdfUx4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLO1SUCyCzs9L9a7cklY7-OKoLbD2vDNGTJb2sNemZAg&oe=6A897F29"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J4Ijjfkg4TQQ7kNvwHzgRZp&_nc_oc=AdqXo0OippuMqc68NvyOFRrWMlb3OPBl5qbU_jQbd7yPeLRtmQIewzBevdjWteI5YAA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHYLVxF68yw06G-1gfuS54_o-QsUoBS8c9o6uAfTJP6LQ&oe=6A897ADD"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WpVtYagM3jgQ7kNvwGE_cjG&_nc_oc=AdojH3R5FeZrNng-9kjuUabaG4mgMW8rmZ7W7bdtTPo3gKgXu3ZUHuIkv5GTrVQqOKk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQE2L734PU_ZUakB63F_Jc60TPdTG7lBErUtm8IIqa8Q&oe=6A8975C9"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=alYGH3uHE-0Q7kNvwFx4-Z7&_nc_oc=AdoPUfVLHGlTBPfDYtE2r46Lzq46kmopcmvz_dmzbf6vdSaJWOaW2709Ok9wUMfjcxc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmGxU048Mu_zSeupTQijjw34nZ_GilwNZhHgltjGM1ow&oe=6A899EED"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KvZjkAa60z8Q7kNvwFvZgXz&_nc_oc=AdrL4CB-SQRVX2b-Q7Nn7vJ5ayNYwCTcXyhizWE2peepW4PQQz4ZyVXutgoo_OZbbYY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFlpKg8tzFTaeW9o7-zWY3NfS8BdoCCAAqOmZjJ6lAZQ&oe=6A898BDE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
5033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7RA9PyeW6AAQ7kNvwHy1c44&_nc_oc=AdrWUvJkjEvZXAaH14Xi6KFISfqsVendPTjSt-UZ96Fy57xPw50FjwEGHBsj8Q5LNxg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOXlA13yS5bwrEWtZ-QDQDJ9k8RFwBxbpaZ4FcqyLYmnw&oe=6ABFC4E9"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o-2fbX_Z6PYQ7kNvwHe2oEZ&_nc_oc=Ado-Cnnkk1K2nYl80teU2ffAStLFQb-ACGyn9fibGZ75aT_mZ64PwHr3zo-LFX9Pskc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPvUB8KD3hHyzYQlc_Rh2vcFM-vlkGt-kBGlgx8Xbmtg&oe=6ABFC09D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sZpxgmbwcNYQ7kNvwGlPa8U&_nc_oc=Adr7xbekt7d2kJuXjONABvn7Vz87kyLd2LrZB-fNGZcLlWchPCENxN2pItFYSme0Vp4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOH_Ui2B_SzFaVtlF04zdFhzQzRhUwXhHFg84SGmsF48A&oe=6ABFBB89"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nRSOY5cPrfYQ7kNvwFGsWRf&_nc_oc=AdqZWw38n9ABW1Mcbj-BQsCbJqela0M0YVpH7lmdBv2xSc7pNvZntp2nx9LM7T1vHME&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPyQHPiyDwojhpfpnTXpFCEJNFRsdrwuyx_MDKBo_QiVw&oe=6ABFAC6D"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MdnJvYbi22MQ7kNvwFikESM&_nc_oc=Adr-d5VOIvasonIvY-7QOt0uHkRI4RGVMA4uUwJaxxzHLQ_ftuNMBI2fZoXODKL6Cz0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM5DYBlDYbhvYmK1gy8A7iSx2RYXn4OKQb12DtLIG57ug&oe=6ABFD19E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
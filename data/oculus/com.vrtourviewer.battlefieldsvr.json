5033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rR0XOMp_1Z4Q7kNvwE7vg_z&_nc_oc=Adp7DfEENBNSlcLJo1rvMVB5Rzi3nRJRWELRm2eLluMgqZHdwL9lDHwig7ChWvK4zC0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af56WpT_mYQYjQzqo8lcuC4V7eT0q9EQYLRnsPkuZ2WAww&oe=69FDF869"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7HC3oxR8R-EQ7kNvwHQMj66&_nc_oc=AdpUqz5PN7sgkaZmX3vvhHNmu-g0Xn6j1_q0_kZ-2rlkOUbsIEoWv2T3LqLJwNRwikQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Sz_Zisd8EPulKOBzqssks2vBab36DBt5_VU6AQy0tOQ&oe=69FDF41D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a_kr0k-9sgwQ7kNvwHxOwzh&_nc_oc=Adpdb8uj94PDMpGgLNmwi5yboJCKbyH8BtWZAlR0vK1Z944zNx6ryFCHPmCxRvp6UzI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af63bEuIS3_R4RkRubz3bONjxOvtNVY2EDf0_S5VZ43QjA&oe=69FDEF09"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gsV6gCIBJ54Q7kNvwGCPjW-&_nc_oc=AdqSWK9g-skvIXFFLPyucQGYp9rv9L1UndAl6f6rlzcpZmtB427_uNU0n1nmBJEey54&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7plWZWW6E1EUdRqbx_u7J096i7cFymJfhl5-EDMbzSUA&oe=69FDDFED"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oFhsiLRildAQ7kNvwE1DoyB&_nc_oc=AdoEA00TqN2lrAbXwNR4SIWbI6EMqjpj_ME6s6GyV4JjFej1eacMiMD5SnUVs5ZKIss&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Ki5ASgx0w-M9iX2gIAG6qPuGTJRKAQ5cIThjJEFBemg&oe=69FE051E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
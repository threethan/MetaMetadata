5033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SFYxrY82hJ0Q7kNvwFnkHiP&_nc_oc=Adql7qj7a52dHpvgaW-Ju2o3nmc5ylak4LTZoKpJ06yaqSVd6NEyvRihnbX8tUqMVsM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2yfmQyBqKgfaurkNe4dP-dCZAW1XWe-i721victwGz1g&oe=69EE2669"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IyhxmSzdkE0Q7kNvwF76-7w&_nc_oc=Adp14WDtwlDPqKilzTCXuZDZeHGAJNs01fKfVMODyLPR6AcZ1Wq7CDddtOYxzzrktnY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1sSVyMRTxPN8ghyAR_jgj-Ftxa2Qc7GJB_DADmHGgtpA&oe=69EE221D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bGDmfaQzKTkQ7kNvwEigoDU&_nc_oc=Adqlb8T78Q2_hNd8hp9uZAparSbPeU4BVXuGAtaHTdRkHxwVhhTYbRa7ncObNiZu9-s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2nEe0D40dXFOGc18yKBQ-YcDsouLTZyrP0UZQA_dQ3zg&oe=69EE1D09"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GeiaXHIjqSkQ7kNvwHOgNF5&_nc_oc=AdquJHzMcruQ6p3oriPVnSzIA0UAasSVFj54JTwUA9vQ9jcvN3vjgJ8uJ7Yl_x7OL0w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1vxM5ToCxiNN-OrR5EY3vh4vX3rCrc5mKmbgMLa4WwOQ&oe=69EE0DED"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C0Pj23--WYEQ7kNvwGli1yB&_nc_oc=AdpN-GaWxDk9n0Z93hU3xp9joqyqpA98AwsE7Jq-hHyFq6y6d53wbqeeYRM3LHfrtAg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af33anIkoaNGsECARkjxWnXZ75eEbL50-MU6ZBf3quh3ZA&oe=69EDFADE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
5033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bH7ks1QN1_oQ7kNvwEbRv8c&_nc_oc=AdrKSOKexl5f6u7NQvPAMg87XNRLMdbySZmg5WlMwytY7iyL-Z7X24XpDrQmG6jRr4k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af66ut1jSZSYhIWq54iw5GmBq6nAvwhIL9G9x8PmyZKNyA&oe=69FB5569"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7HC3oxR8R-EQ7kNvwF7SBtx&_nc_oc=Adq2RCPnidul6cbwMIWZMLxSgifxeM8RixuJcWxgVVnIfZ1Q-P7KNFSmFTb_TtgxEDc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7QA9b6kIy4LO9eQUZ2fDoUaTm625E7UOiky--VyF1FAg&oe=69FB511D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gyB06jh6CrEQ7kNvwE5Dlnu&_nc_oc=Adqi-qDpuYjE0xGujMbH-seRuvn41khebWE3O7IDaI_TcgY2KQc8TU7nYcWSMWT9psI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4wPq_TZ_usCPORL_Uy0aYRaHkAsy5sJMswBZjkP7IjJA&oe=69FB4C09"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LAMCA4dPiL4Q7kNvwFKyWM1&_nc_oc=AdqB6WFPb0MhUSwLnDP9bZ1Zgb9VdTFG_8bYvXqDYzMX3W2UJwHNFIvEi2LmbL-4C4c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4D3ju4_2cfjWkJeF9Vu1O6G-W50CFi-cM4o_mLB2NBtQ&oe=69FB3CED"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RvCRA-6ZmKoQ7kNvwFdhAc8&_nc_oc=AdryFQkfxLij5sArtFYfPHygNYUDdpeyLgPNpt-yI7Sd06DeTI80aBI3pVBSZ__fp5s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6y-QkcmcHjVpKpSvUsPLsrwFreugP5xtBNOyaj6Xx1aQ&oe=69FB29DE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
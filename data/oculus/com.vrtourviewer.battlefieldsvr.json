5033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pav8vS8Vr8IQ7kNvwHD_RZf&_nc_oc=Adp_cFEKhhoS9jyUkw1IHS94kR6XgpdEqatRGAbTNDk49ShPVhCrDU9k06olEhRJFjA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFUgP-81fIx7EfBpcdXH_5gWiWmds5jt46SZC1hqhS9Bg&oe=6A7C5029"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2-ELKXc3oPgQ7kNvwHhkVRT&_nc_oc=Adryxy6Nv4DJ0tiXbj-EgLDKPelMlg7JA5KkZRhrwLORuvZ4mwLzHiBbJdpruwq98LQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEd7ygHchqqJxQOVpBUKq_3Fcf9QQXuAFPIlRpc2UGxTg&oe=6A7C4BDD"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=POGip9rJDBoQ7kNvwEM8oeI&_nc_oc=Adr0BJ4hoVvLvaWuabVzhBv9J-UWfZbi0pFu7A3cjua56AoWzXmEaErMmKLz7xjZ2Aw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEiU5NpmlK05wjeG7hPhaZH-sA9iYf1qflGd6_wx2lpxA&oe=6A7C46C9"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EiP5zFtw-DgQ7kNvwHfN1rt&_nc_oc=AdrCVKKFtE6TQoD17AmfnfF1UVVYZ3hiQD2UU1nLM8NmusQBytIji6AQI_dpxiHd7ug&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFIlbOYsI-GGCvA7v0FxD9zXEAwr2Uq7zVOE1fNeUJveA&oe=6A7C6FED"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DlPgD0--be8Q7kNvwGFTwq0&_nc_oc=AdorDffiSd5GQ9IFQ1ZrabXjpxMDmvjngoJaTxveYScJF-_l4htDAuhjJTbd4EsIkK8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHw7rEhIaV5PM8pTeYB7itkFd2n4_NsHqKPngQ4gtSRQ&oe=6A7C5CDE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
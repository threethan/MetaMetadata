5033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dz1qGMUanVEQ7kNvwGuqT-S&_nc_oc=AdrHLS0CasXBS6567RYJT8E0-HTzdl2uw5ATz2pvF2eK31iJu9xlHqGD4OsaRktGwYo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNBsA2KJPg8tpNM8UG4bDoeX1e1l3dAYm3T7ZakKELvoQ&oe=6ACA50E9"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hoLWd9lbp_8Q7kNvwH8u5KK&_nc_oc=AdpHqqb7TRpSY1Hn2j6HMxipx8kU6YKLNBJQw0nJaK5vstOX0NskshGbjjfrcdl2rr4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPC08Ojxug-P3zyttWzWgERoEMm5DLPQMhMGcMtcJxYNQ&oe=6ACA4C9D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CH3VxiD4ZRcQ7kNvwE_JV3O&_nc_oc=AdokmE4XpEv8cLKqWTwjwfRqDO-LPG9kIeBO_eL4xKGpalI7mF-PeF4826C1fsiaI5w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPqejVtMgZOV3zJ9NNU5nzFDThxfOp90PBXHLgaGAPTWQ&oe=6ACA4789"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VY7dTYsYr1oQ7kNvwEZVi3D&_nc_oc=AdrwMKHtsxwqAphUVqnywfVBMNrhlEjj2KFw4oXSkh-mP15-6eBb9tL5Jc0LPQD1AFk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOjZhcAvVmWbB8oVHDm0WgHZAp59NC0-dtP-SVXpTBARA&oe=6ACA70AD"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p7qGO90XXFgQ7kNvwEZxkS7&_nc_oc=Adpvt8wgy_0PGdFOAgBpEzV3XJe3QzrCgyvE6weOuRBEUtSJVmoSzwf8Vu5ib56hDcQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMYMoxgEo2JaOEuj5Rn7EDqHYsZsX8I-OnovjDFtKPPiQ&oe=6ACA5D9E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
5033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IY0l118YBckQ7kNvwEW9F4e&_nc_oc=AdrqNScxV0txsf0Io32i7ogVf3x4c4YGd4q9pZveCkxksziyF3zLjoXDbOxtgxY4s0k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLZPe3vmOKiqF3R0dv7i6tDVA8wTQn0Wx-nVgeL6cH-w&oe=6AB295E9"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-YSGTciW_igQ7kNvwEBhHWd&_nc_oc=Adq1z7a2E1Knl898JYEM3NYD9EnC9FIOX1PvUzYrsi8WitCohyc0wNceUtgSXWZtFxE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKsZL6L5Iogr7nfFBNtbSlLpKlwt4-YJBlxCtBDhgBd-A&oe=6AB2919D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YbiUkReeImEQ7kNvwGdwa0t&_nc_oc=AdpwwvDNr1d6yl6WuFv_Ags-0VmBMvmmGh4Ip6rhP_Z8ODkDG2fwS3WhONIEHb8nxho&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPFghBRyw-wB9ueilEdAb3mOrHMmUwUZzyAFjmQwhtcQ&oe=6AB28C89"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4d--o8GXTtcQ7kNvwEkZKoF&_nc_oc=AdqWZaZe2gFIj-_XvWFFpi-M8OIM0DZUiyJaA26rAMhgW2LrH7gtXRHJTeH9s5x3sgM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJmBlMtcpROyCK7FlXKblHSasq6T5M6j4wZcHY9rDz96Q&oe=6AB27D6D"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VMH8Zty-NRAQ7kNvwHGV_CL&_nc_oc=AdpxJVyE8j9cDwm1Wr2TyHSG0-ovlc-rgYjvMCSWjcvKDJgBCnx_Hc9nfTf6-v7Orc4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBm2RyVZao-sDFktR5YAj9PidD7YHHjlJAOzc9k5kcIw&oe=6AB2A29E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
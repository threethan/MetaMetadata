5033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x7qPtjQkTXcQ7kNvwF3gbOj&_nc_oc=AdomSWi6ft3nJpb6EmTfSVuhuDGpnydSrA9QJqf3fEobf-k_HdurQk3U3NHkUIVhJko&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0BIGQg8rrpWHX4O9XkPxV_ohaXCGkbHOJu5D2h_6Tjeg&oe=69E4EBE9"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ttU8Ua3QuoQQ7kNvwGMt00_&_nc_oc=AdqE-WerRE2Y4R9E8tMmA_GzFk-1XqDNvNcjTFqvzW2hFL1ibG4_UIN-NarC5MYUWpM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2IegxR8_AQ_p7x-aglJqRhvQlpPPZujN75F76cc3VHoQ&oe=69E4E79D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KvwzHtDW1hwQ7kNvwH5o8nc&_nc_oc=AdqgO_LHPFXzYMGZfYXoOxL2q_EPLWVphF_FUb77cZl0eD_0fBV7h0LE9dfQamZysaY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3EjZSh7HH0Rt3SNpLlx7Ri89NRK3M4a4AQkPTYDoRs8w&oe=69E4E289"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hqx8BwW43TUQ7kNvwEkb7tl&_nc_oc=AdpfFeWwcKxY4Am3qoGz4FW0Dcj-RfoKEE1VLe7SaatSxCT0_a6HniT-2putdXCh6TI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3sPijEDf11I0B3WulTu4WKLi3rufS4isB0lc4eEbwxFw&oe=69E4D36D"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mqy4zvMl5lgQ7kNvwH9qFyY&_nc_oc=Adr7wIiMgTvo-Ex-mnxYZ4tRQDh6KAJUfdwvxQEpA12eKIMXxla_qFu5AOQDBIOzpVA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2vjn6br3y1hC09lcDzLKFqhlhc9NJjf7CEOD9gyFKADg&oe=69E4C05E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
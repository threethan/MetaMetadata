5033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y6E7KJqvn3kQ7kNvwECtw0k&_nc_oc=AdovL-9lZKLYSzBSMHRE-DI_Kyh1xNiojdDBKPnrkjnSDeLfCPLhdF2PEZ7rZ5IqHD8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx1aM-to02MK9NesTfBkfbiQgxxv8RjU4oPEVlPoJbFXw&oe=69C547E9"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vRUexvW4eHcQ7kNvwEbVeRw&_nc_oc=AdoDSCtXjVk6L1xz6TLAhM4aeNXhH7Ddbsh6NaATZjtd2zBjYjr0RqM0ZoYGF0EXgxA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfybKw70HTJOvtcFrzuyaj28M2Gm-HdTfDmmwGOu-q8i0w&oe=69C5439D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XBRbmnMeCNIQ7kNvwHBMCbc&_nc_oc=AdoZFznvYN9ogB4Cc1uml40BC1MnP0QmXkO5y1NhPOEk5dLjwn6z2A-PFMqOPWwwDtA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyOwO025QTNGnHjulj8v_Bq0ETgOovx9L2VTzR6PTuA1Q&oe=69C53E89"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3dz3Gt5UjToQ7kNvwGxhlS9&_nc_oc=AdohneNSQj-NR7Y1cVuqRs5sMX94lXJ80YO9b1Crno5RPt-FA5g12PEU-YznzxncW7Y&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy4uZN3jHmcHZHe7Tnr2Q7V_bC33KpQVlDgmaYjVMfliw&oe=69C52F6D"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=amY_7NWguN8Q7kNvwH7Bksu&_nc_oc=AdrxBiBIZwJik8BffcQH4w6dym84BlwTFkM1nQnctvBdaUHGX_tw06ALokVJB3tKHGg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzDMUHxNvNH0ZnLUGc0k1AZZGRXNi1yUcGmJc0yotM4nA&oe=69C51C5E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
NvwGU18qJ&_nc_oc=AdpshTcSHvC-kFYBrXFHZx5COPqCrLYuTz3atlu0M_kLFKZmzy3WLM2-_g089Ge7aLw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2o7Ti3OAV9UGj18TaYNCF1LXFRaL7jTmIkioIRpnFjBA&oe=69F21AE9"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5SmfWs6GrP8Q7kNvwF3jynL&_nc_oc=AdpY5ID17feBvMNWTRZjqdvvrszmII5NEyUcriCX49fi0r_sThMji1g1iyaoZ2QwJIc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1FQOTzurEKtqEWHCETPMG1ih56l3_csqXRxDCUnnRRIA&oe=69F2169D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MyBSJ3cvv0sQ7kNvwGwU_iB&_nc_oc=AdrvR4XvDBBj3L72p0D8jqWJ-EqhYSyx5z85EUDbywIexSymHcsXHG9PIXOpYn3b-6o&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af15wuAaduKN4CYuV7myiOho-2f0MIHbKJL-u-1N_viiCg&oe=69F21189"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vepfu7lJzvgQ7kNvwFb4-Ak&_nc_oc=AdpXnboQW74y7csNkNDveZtEER1xJyUKRN6veRPmq1Of590YEsoCGdPjgPQngjU3A2U&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1K-SJjOweqjOgl2uTKIwr4dTRD-GIc6zL2bCU5u2QHeA&oe=69F2026D"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lkhprDBB1_YQ7kNvwGo0gio&_nc_oc=Adppsj43rvgQrMIshodX8BvmchCNi5baMV19UIlXC4mGekPIWtS2TkIzrIxImnmN1oE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3YSysLDrI4mAkFdcXQyYFyw7PNn6NoKv73G94dAtoI8Q&oe=69F1EF5E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [
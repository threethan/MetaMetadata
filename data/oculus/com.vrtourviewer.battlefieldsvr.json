5033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XWHjdM6n65QQ7kNvwGBrJ9h&_nc_oc=AdqqRaE9x5kKJ-GrOFzn5XbgSodtsr57iUzUuIj60xYM-HEeP05e_AJv7qZQurnStsM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYmyeDnkiAmxTjuwFgIzBzaVq8_fCYResMVCOuwa2WMA&oe=6AA809E9"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2PNWe3ZtYlkQ7kNvwHlIKIT&_nc_oc=Adp9_d1xICkxsfLqLoYk9kP4r9Hl3E0S6nvVL5aowhmAt4hlRK8W6P5AICEWsgwWI3g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJoAeuENQPIDZtp-xzhJFl5NoNI7pCtQJUV5ox3rUrwjQ&oe=6AA8059D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BmCMI_zRPOkQ7kNvwGjBLPM&_nc_oc=AdqmHOy0TdZzi80IgYrrsHc_jlW9TY0OHRf46T3PqVyjBbzrzrJWVtEfoCD64HlvHMA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIytz0FucJTgsZEuBCy2MPWg8ETKa2hGgEqklUKqs18Qg&oe=6AA80089"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=esTEZgyXQ04Q7kNvwENDX1K&_nc_oc=Adqt73-Zy2BDrLKsbnHVD2_8eZK-4caAOeMGEC3T-vLbBMpc21kvrJa4BTM4jpY-EOA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHRK6C8jYRGzHfuueSlAB746Tqnd7nIVb2njNI7aCVNA&oe=6AA7F16D"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b7fxXFmtSn8Q7kNvwHd1ySb&_nc_oc=AdpRR2fbO7kx400r-NEWYIKEEaANsuTg5AtsUOLupkBB2kPmG3qDZEBUYx-4TNg-4IE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJH2fh6gBQaCD1H5KXusQhNpCKPKrfMAsy1CS_3mQoSMA&oe=6AA8169E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
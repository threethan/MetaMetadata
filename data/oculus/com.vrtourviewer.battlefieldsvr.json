5033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hqBCaRtmAtUQ7kNvwHmMDlr&_nc_oc=AdoqO0ZFWKM13q8-olMeTmUbzJObrpKlxqviEQwdUu-FUqyIeUZzVFVPy35rm2wUlRY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7C7Eu5YpF0F7mgabtJ9siaFN3igMomi06wVKsy3ixfDg&oe=6A185669"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8I4XULroyKIQ7kNvwHRnkFj&_nc_oc=Adr7U-kfmpsDnziUYuM3fQzACrjynLgCu0rvTEeNVBtxNtltA4CFcBofJeUp3Roa3NU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4aCIEJQcKTNgqwTmRqU8a0y1J2AF2LGSSiIvlTlRUIUA&oe=6A18521D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BPAPbmXuKMYQ7kNvwHuvtCP&_nc_oc=Adp8IVy_-v43sueBOHqLk55M5RDj9IMdonOyoqUTQ_df6hm22QEeHR39SdQ9nsGc5tc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7z4n40weG8L6rjGBM7ixSfgRHxsQqxi2O-UCsS_al3qQ&oe=6A184D09"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=84WNaKxuD_kQ7kNvwGZZ-Qz&_nc_oc=AdqZurOWcPDw3y0GX8UEA-VTHWHnQdhwMnXL3VRlnZxR5Yar6Oi3bp6FT-9uovx-JTo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61UwIO41WNSakz_1h_Xf5wP79xSgxh4uR-Q70cXiWZyw&oe=6A183DED"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aLHi7umSJlIQ7kNvwGOQM4c&_nc_oc=Adob9WqUzxYQpS7SZ41FgRCpMfbjCzBL2K9YedO79BRhslDKfx8T2ZmoCfP7E0mOdsg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6F2p1AH57YC_MC0qTZXg-n2Mywld2IhcqmJjST1YxXGw&oe=6A18631E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
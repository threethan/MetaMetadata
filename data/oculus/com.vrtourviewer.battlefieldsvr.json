5033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ejk0MbrWPy4Q7kNvwGpQit6&_nc_oc=Adola5nRyTr-8Qc-z-Q-Z2k3LOoX-l3h_6CZSJhckdcB08gz_6LBnYvYpfKK8_Znaek&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3kNyzHkrBr13ZhbYzA-ZY4PjEJ6T9Z4aqgJ0XdmrX-w&oe=6AF1DDE9"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LZFDeGIk1l4Q7kNvwElsG_T&_nc_oc=AdraNq4Em2Qm4ikxYImDoRRNuXVLOGp24VpW8-UzvBokMx_cT8lTK_9L1lrRH74JGhM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVsIg6LLTHofXMS4Tx9_0ylEid7ijMVIZ3MjzkOFA52w&oe=6AF1D99D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EeOR5c469BoQ7kNvwFthmeT&_nc_oc=Adr1xH4OwOGx0r1HmUkVSXu6OT7bQn4mXtoeAxPec8ZVRQb9tGCKMXETdeQrcDQoHJs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSivh7mi-3-zDaQknO1IKKIDBbTWwJMoYo9quin_eeXmQ&oe=6AF1D489"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jd2hmcj6x-QQ7kNvwEY1Mb4&_nc_oc=AdqwSm5Mx3IIUzy90zxm5BwJLfmtCQYxOhBOi2kNSPHIrCDxZ3_l3bni3590gpcsUDc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCPYb9o3A_suWMbgzHCTXxBRfqc4ch3GPWwNAPWXlHvQ&oe=6AF1FDAD"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lTM-3krvdvwQ7kNvwGq8RAq&_nc_oc=Ado09JecYFIP5Po-5Pqp-0YQhmtnTyNbFRbJzCzRRizLExDSvZyao44yiAITsZ5BEJs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjgcV68bzRC8T3VFpJr1F6f8Lh38KppvHEV_eG2GUI2g&oe=6AF1EA9E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
5033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JHIVn391DhsQ7kNvwER6H1m&_nc_oc=AdraLL4Zq6rFtLxLnDphBpRYnipKFyrXwiQw6CFrJHu41laNLxQNxrndt8NGVAsyG58&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8o8EQFcZf_0RMppgw7fjooXeeTNueG4w-Q2l3QC9Q2dg&oe=6A3E91E9"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0dFFm2jFu5MQ7kNvwEItnMB&_nc_oc=AdrOBEXJEPgM-RRoyqGG2v1swSdcbGcZFD5xbj2ciCXDg2tHCdIJP8QQLZGN9dSAixI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-4Bx7g_gYxO5joyHx48Rx0YiF7OHCEcZAZs_POloZgBw&oe=6A3E8D9D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O6r8GlS-MQ0Q7kNvwEIySDt&_nc_oc=AdozTeNZsBoohChriFYoMrTIGmwhvh2wW81DdPdJEBYREmHtMoiU83H9gmm2JHe8_j0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Ft4ct8kkv7XmNACcZ8QhfOBO2QswTjornNVfOebwrjw&oe=6A3E8889"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SfFRpSqee-AQ7kNvwEP_llI&_nc_oc=AdqLgFrRpgYyzTTcx6fE3N5xUgZZp42ryPMYd0QuOD6DUKHAi4fcBWxrXAJvbg0gcaY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9nqiNx15SeZLLQ8Sz3cy6V_oqZ7S17Sg8Wi5YUcZvAUg&oe=6A3E796D"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PbuNMcYeAPoQ7kNvwHm9aT4&_nc_oc=AdommCkX-lwMXhLvXl9CpcbcAWdzoj9yCcRy4M3spOhLgCyVPTIKjYGoJz36ukz5odU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ib3vXNSFyydvlKY3aLVSofWuU0A6lCKQbM2II9jXgnw&oe=6A3E9E9E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
5033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fR4QFhUz8LMQ7kNvwGmwj-p&_nc_oc=Ado9sO9mzemRuFYf_maPpHBqybwFk7Bt5WWOrAvAb42F8gnAI2Hga6Jt2PD88kULPao&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH1xVqp9Q2IjgIcxcmkQ-D6g2Gzqn0UjhW1W8K2EQQUHw&oe=6A971EA9"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OzlU_T5sFfQQ7kNvwEuT4_m&_nc_oc=Ado-xyi6bCl2zDXaDVyx-TaTesutKht1cXzG5_gGxeqwjnHU_cVwGd5IWKdVsplqOeE&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGy1UCW4kVPb4NttWoSSEF-KPhVpBq1ww7ldLT53nORbg&oe=6A971A5D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zO_7aiNxtAgQ7kNvwGrxCAg&_nc_oc=AdoPU1ovTjEykqeaqmONYXOD2rmiAQF1T8hCnJ9psQu1QfZgbBXTJV8xm_vkAqa4jpI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHP9DoQhxblvHywSkTa184z01jB3SfE0cHMNKphqviUnQ&oe=6A974D89"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5DERet96otMQ7kNvwGotYMg&_nc_oc=Ado2ha5c8hmyBZ7IFaO-_L9POEV_lMf2nDCef4vAlI417IIdMIvh-6k3Tet9S3MkbD4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQER0yHOViwm-cNyDLuKIzOVCMM19gh2N2McGYrYgJhATQ&oe=6A973E6D"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i6JN0nSh6MEQ7kNvwFozpEo&_nc_oc=AdogXP7HXOBwMij4TD4IpumUQJ6vqjdvIjKB-YRvyxcThbijeUMyVrWYqrt8FJp5hIQ&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8vNb7dB7wO3IfV0AJ3YnUKr8xvO6bQyHtMIuw9xvepg&oe=6A972B5E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
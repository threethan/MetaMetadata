5033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cC9szvjK9tUQ7kNvwHmzLGe&_nc_oc=AdoaVEbF9nppjpA_XYgzH3FpeV_viMtYzrqvj8BR2ylaK5kgJs1l8DImFC_69lOHYIo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG0wB_zokPnKUcLnqD03TMl-LMU3qqm-l4uX4oiZDMTYQ&oe=6A82E7A9"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qfi1dsLO0UEQ7kNvwH4BMkN&_nc_oc=Adp07jV3iC1oXmFlM5J69nk-EJK7Uw-DotDVgM8ek9dGlazjSEKugz1bmRGQ_YHfpm0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQDY9_Ys8jE5iHtb7D3P-UmFk6Rxc9aIEVja3rlUF2qQ&oe=6A831B9D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WZgIStoauIgQ7kNvwGf3t0A&_nc_oc=AdrPE5xHS_HqtRmHcu3Xdbv73Nya2NreFYJGSOAvtZ4hMNlnu3ROhJ6O-SwlYAGJBT0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7NpaKlOU-Cr1hZojYO7lj1qYOwcplbMwHouxOjYFBgg&oe=6A831689"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dt6nJTzYeoYQ7kNvwGY6ZR7&_nc_oc=AdqNu19-2HNKhb3XsVwTRM_SbSAjovaIXeaZwmfeO3Aj2w5BDh-7Xe0za8V_ZopT7ac&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCwbeyYv_J6wzZBHP49anBU7RYvIH-dYeqQeu2B2aAMA&oe=6A83076D"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5hh2rhCbVK0Q7kNvwHIGLGe&_nc_oc=Adrn0UImRDBvOh3h6zXPAPv3vEnMO0kxMAWfFzrm_gxz1chYt-37RkUMxFprmxVh6jU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDtNd9g80AraAzqaIJ_Y0aq2BpGMdVhknujfYag5cotA&oe=6A82F45E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
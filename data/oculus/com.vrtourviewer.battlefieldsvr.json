5033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bh2WmWT3PWMQ7kNvwHiZXG9&_nc_oc=Adp41Ke5HJwCZSx6VlVSx5tVAZa8OLf5BDjgfozQTvJXV1JTIKOEw7JQIN__NPLY7hw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af26HaSwbFGKKGvP_77AqP9a1RbIuSGoQd96edddPow4rg&oe=69E78EE9"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B0Ro1IkDPYkQ7kNvwGdzWMM&_nc_oc=AdoGK9EKr9orQMpSrQgIhHrTjOV8sTFL5qB_mg8tcopzk6NwlLwxX4H_TxiII3ksPCI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1SONET54NlGH2NIGi3VyOADLiEaKGijyYRYIFGtGRI3A&oe=69E78A9D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bcaBYFK8IO0Q7kNvwH1OSoD&_nc_oc=AdoQmRnVeLmTM402GkNUP7Brw3YPGaa-pbuVqVJVvB1_Dpew7fk0qN31wHMy13iNRFs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0MBbwh-_67kw2gGj5DVNDrLB50zUk65La_PG0THOEQKA&oe=69E78589"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=whkUBZU1vlQQ7kNvwFUzFu3&_nc_oc=Adr7F4AB08v5j-uSx3lKv1nTxDpD5m69TlPxOfkrhrNOgful3GgnzcdmGwyHfzudTuI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1q6EHYJvLvaxEAI1_5v00Qk3W7q_O8CX44zBXGGktVTg&oe=69E7766D"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mqy4zvMl5lgQ7kNvwGTxjAU&_nc_oc=Adq2-0HFD07wA-1fuNvNdSY7hnmFrik_5lXHh4bOhnR2pJU_o-E61fNmJC7xYyj6FhE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1UZ5rda62S_jSQrM2DLozcukZaf2HhUcjDH9oLh5k-8g&oe=69E7635E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
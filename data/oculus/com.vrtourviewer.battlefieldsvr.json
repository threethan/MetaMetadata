5033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dz1qGMUanVEQ7kNvwFG1Wqz&_nc_oc=AdrFZOnomKmdt3Ab1H6hKOztAUUDHmIYOqpPTJqPJX4ZpmYiMWEeEFJOub-6x2YYA6M&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOpQaFIQmrlbEPHrPbmuKubwsm8F46jOJXky-R1JBz0RQ&oe=6AC7ADE9"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AxgRtF5_vKkQ7kNvwHDxmDy&_nc_oc=AdrVD79rFJPfpNZO1mspSE9ZpiECjIm_wJkIqsL9dyjfq853pGOg_IeEZ6xwIseXx_8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJqiyYzmoZ78odTbAf7B8EmiRCzDjVgY92qVjnPMKfcQ&oe=6AC7A99D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CH3VxiD4ZRcQ7kNvwExzY9E&_nc_oc=AdrRpMwE7ttcn-CvOY_8Ywjkcy0POj8Zb3WjzuOAf9wdCZWblPlYUZfQh-Dm_mkn36w&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNM4Bn1QxEiJGan5e5ZaeCXoz09-4oMasqHawG5hRIDFg&oe=6AC7A489"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VY7dTYsYr1oQ7kNvwFo17GV&_nc_oc=AdpkyMNoQzwORNuIeWhI0gCluBN7oVWvEnGS8VaWvVF2Sqw_UYe25xz40UyIdHAW6Os&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNwjHjF_rwiFOHvLcDHI1yxlzxwEJF_jc0cc84S_kTQyA&oe=6AC7CDAD"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kED3LLSqGNkQ7kNvwHp2GDO&_nc_oc=Adp2e2vyU_pZ9vPzsVEz1a1BqsrnAmvt2lnl58hEMoOyNyC-HUsT_4-jr0KT7AcNC_g&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNblbLxhaV-CTUf9pjN6fr6OqLPHcbhWwFlaCRBK7R3Cw&oe=6AC7BA9E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
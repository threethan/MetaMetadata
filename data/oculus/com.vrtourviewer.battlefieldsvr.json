_oc=AdkTNqVMTTKijNMVyfbYDRzI_zFCfA8535OlwLHiv_j5md9onzTXAlfu8u8-tuCgPRs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afv9jZR9KtethvShGhFTJnROxg58yn3ePrvbhZi2wq7S2g&oe=69983CA9"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cIbrUvPabHEQ7kNvwHgGVuX&_nc_oc=Adn2FRM3uNAenIe0IMhQ23SPvIu0i4VWofF20aIy0QR3mcxkaH_WqwrTTCcZY_Q9wMA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Aftruz_Cb5sV-1oW31l2O1R-DldPs1el_noXkBYa-ThtVQ&oe=6998709D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=creBXZ2OzHYQ7kNvwH9qJQe&_nc_oc=AdnxrB0G6WcgdpV9XAh5xYtxmIcLH-PYbvo-PQU4US_q-uyPcnh23ic17zo-gijWnN8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfviofvIlICuQm_m53PApBegJyoW8B_BjuIG2PUD3QaiBQ&oe=69986B89"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SP0wck98jpgQ7kNvwEkMJPr&_nc_oc=AdnOafmgwIKE6x8ugYyg9iJf3xpw_dcCm6Sr6VG7I-Kzv5q5AKz6siVI21vm4A70So0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftO4uM8gAdStkxxIabbT2gY9xCb2OZYxMyVWEto0u_Wwg&oe=69985C6D"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RIRuB0hFj5oQ7kNvwFXG-SN&_nc_oc=AdmRjAgwrVKW2JUjcRyOYpRlJDfNtjBv7kW7dYoqj_Eng54NHQLto6WO4pWxiUpR6XI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfufF_GmYoFAxz8IVzuX3b0SHUnY146N6xxR5z5cpguyEg&oe=6998495E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING
5033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B3PQ7emc3KsQ7kNvwFOV_Kf&_nc_oc=AdraB--s31H-dzWhFw76qRtV7_HpwFfoHX75qfITdEItjZwRNRGVBEQ9iy5WwH-p_bA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3e9lgdCUGJWhm43n2zeamlPLJLY51YJRWZYqjcTgFZVA&oe=69F60F69"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T3tRaralvQcQ7kNvwEt3HGS&_nc_oc=AdrCKLT86aE2EmBZHFXgBbh-trq3Sm9-WWE79R9nV39UVvCyNoCtTLbkKHOhBhVaYQc&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2qWqrEgbZU-s1Z46wTKBTa3f8HzUF_6THk3M9lfLninQ&oe=69F60B1D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z_-3mgHcrcoQ7kNvwGk2ipP&_nc_oc=AdpnAvd2n9dlncLVTIRH9Xst7W-OivtKTjBnZj_zy0TS5yfA5rL5kAiGe68O0GoW_X4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1fK-GF3j7I1tSgaTyqhyq2N1CI1k3SEbNDooiY1QofiA&oe=69F60609"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gzratMk-948Q7kNvwEyIKcr&_nc_oc=AdoflVD0AkkSm1Ttx6HQgZm8uroPVIebP1g8xjQlxxXbdh1j_P5QaLRKCwpJ8MJkrQo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1oa1hsdbg4K8-q1hBEtonkohSV7Lb_fR3W4s-iSIrgOQ&oe=69F5F6ED"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QF4ORP3safYQ7kNvwHVIQvp&_nc_oc=Adr7hP0QQaeCUMikcEH3j8eZ7Ggz77WGZPw76mZONaCLr74siUxKK93T6fAw0K94GUA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3qxKvAy8MTC0akjgJ1oxk-ZeWs5MbNst9jESrnhj37iA&oe=69F61C1E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
5033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GYtm3UULyxcQ7kNvwEhh54n&_nc_oc=AdqeXBXjvgoG25rX1yJXHaTY3wqfb1tjgorGP2PIqD_C5edJnbdHZYbfillNdPB6eqQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNx1Mhc2TsBnuYkrS2fLGl-7yXRdQwKMFKP6mPjzGxvqA&oe=6ACF96E9"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gONHAHEYduMQ7kNvwGXKHGU&_nc_oc=Adqy1dM0KM1O8xShh44rszVEKvvBfjQ8EJDlh1cu3YsPMfVz1Y7clAWZP6tZqcxdGlk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO1zlyo9F7JwUWtfDaGmrbNqtNBlq6gkO1kMFcxj72uRg&oe=6ACF929D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aJMJycnCSYEQ7kNvwGr8bpc&_nc_oc=AdqpBO-Bu1BCXZ3BMU6D-bfLV6BTJuTN3aFric48dI0B9VqZKSHhpHYYapaOYRHGnbw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3bBSDhol4r9PpOm5OSTicpudo63n__a-yGgpiyn9mdA&oe=6ACF8D89"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NwuBF58yedsQ7kNvwF2Vkb4&_nc_oc=AdoA8OIU4xbxZHsW4V2kkxEs9m-sjOWf6zuMkZ5g-ncg9oPr7_LZhbcUN8CJesa68nM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOw4Gt3p1tNRGeizS1Pb_ve569W2HAik0sUFADUN_1-_A&oe=6ACFB6AD"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Th8mmap3sRwQ7kNvwFw0PNn&_nc_oc=Adq1E_hC6jQJ2i7-LHbRpnTTTfu0IulwkEds0EGpX4fZoWKHkFEo_4o_yVMzEN-_gL0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMduAZx7UBknqfvgmZnhmVUJeaMCzOvdIb4HLI7k3ZQOQ&oe=6ACFA39E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
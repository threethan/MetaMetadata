5033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f7-PwK5HMqkQ7kNvwHQbAp7&_nc_oc=AdrASMKQKiWOBz13uR3vCDB6IZ_dZ_Vk6EXkM4IU7dqW9GO2GKXP_RxMQSxlMikpmwA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af06qMxI9f0ou5pgrLTS6twHy-eaNmC6yc8zU0QtFjn08Q&oe=69E0F769"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gOFVLJTYaZ0Q7kNvwEFH4Xf&_nc_oc=AdphQbaoDAh1oD547g800rn9M9mOieyu5Uryt0WUWMRHMzqHD6n0Tu3DCdsTshbXAr0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1RqJGax8qIsDyLo5N8aDX7f4NSZyTeWjcf0MdZ_Zhjew&oe=69E0F31D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zteBITm_fqgQ7kNvwH1PNhq&_nc_oc=AdrsnjlAg8U3bArdf3kK4LRgEKH0LygVm2PrO2M19gF_0SOrznwb3cHhor-gHMfnGJo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af21XEm9jISrzXg6bfHjrz2--5_MHC592On0G00Dp8hbNA&oe=69E0EE09"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DaV8yC1kswMQ7kNvwGsegFG&_nc_oc=Adpc-D8rYAE0KN03FuG8iFfbKLIQZ4lWO5bHz1MdRgrFU8455ZsEcYKGbHzNV2pTR24&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Lyu0q7YAztIDyS5DX_k26GDlArt0UCnmyupgQVxm0UA&oe=69E0DEED"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZxJ3iBNFgD8Q7kNvwG0y-TH&_nc_oc=AdqhLdE3e_ZgQGqlpO5C4Qn-ubI5GzrYtRYtpp6fJmH1dgMNHGRnyv2fyAJQkWFZ26o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af25kjoeEoMkWkM7WzPeEaw8HpjQW1aEPuYL_OFWHBRFyw&oe=69E0CBDE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
5033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xy3dwfseSxQQ7kNvwFnh12O&_nc_oc=Ado9sz0Y3NRVF8nnQymOCUhWIGwPoQ6dunbB6rW_ahkhAhnGkF-fq0Cvb0dEBb1Z0DI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4RdibFnF7muringxYCDqvAhTUcEsE1SBMVNpTjNIDw4Q&oe=6A131069"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VDQJvafYo04Q7kNvwEyzFFT&_nc_oc=AdputKRQX3ahsODaMO993YzobKI_amIzuR67tEELG7unJNGH5FEhA2H9vFYagS-ePiQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4MQNwrZkUj0e0c2j2g_FRBSDIVMkPPdV5SG5nwGUBa5A&oe=6A130C1D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3G4ySGnKH04Q7kNvwGKhano&_nc_oc=Adrc6C-QaljaG-1PTxEHv04H7OFxskRBCujtb6zp0kFsk2T7GY-xh4xeaXLqPgGIwW4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4xYhXXcy_pL5-r4ewZgUMh1-JpGcC0_F9nX0ocuUgpug&oe=6A130709"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U0q5dGM8gcEQ7kNvwEZjkFB&_nc_oc=AdrBLd66zUe-T-ANMm_TA6x-znQ1XhwK8j9LxSYDU5PDuRFgaiMQ_VaBrg-0vudFAio&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74KsvE5TfQYG1TBJ6mEq8wcCvAvCVwfcBLCbGq9qvwtA&oe=6A12F7ED"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mQzfJmcuDrwQ7kNvwEBeoEu&_nc_oc=AdpB_eZcpWQz7vkG2T1ls06U83VyhLENKseRHKfmkBybHL799kUwIXABAkyKjRZzyQg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5F7wGrosspyW23VprEzZSBOZqtsxQfOUJdw7sFk8kGDw&oe=6A131D1E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
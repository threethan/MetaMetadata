5033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xrLYm7EXNT0Q7kNvwHmvnsz&_nc_oc=AdqVBURlAsKQbQDtC27nqDZHaVIFs4qh3LlmvV4cgNUnCvUWZaWe4huV1tSS4Dl-gGw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6H2E3-WJpJIk1wNz6v2j2N-MDLVZ65Y9_3xbROIIjFhw&oe=6A203F69"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ZU4UaGpZfYQ7kNvwGCxJ57&_nc_oc=Adp8hpDbaFpU9XOwdpxnZK3FCQsSlWNv9azdd12yJ-cn-dIbp8RafXTjhKjznzPZ9XY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Pjx6xCnE8_GnHJc9AfroGMkx5sW7U1JJGHSIi6AGDzw&oe=6A203B1D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WoKA6NTH904Q7kNvwE0Vj7u&_nc_oc=AdrKAlDlBp44rv4fFkw_ItxlQLIu07kpAPP9GpoTtEr1V2MjBN0A7whEMC_o9JFO0Tw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7q2TfL7a6GDjXIRqnbVzC0V5xr0yH9c63cFYni8kHtyg&oe=6A203609"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UEa3k77bixUQ7kNvwG-Wu0K&_nc_oc=AdreQG33r0jkpoXYTzgmr--tnauXeRvEgp9zaUOuNp1UWc5odGnsVQV1ZNBXia95Q_4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6yNWYI9qExKdmjzwI7PHkhfLOhZ3exym3sgG1Fzm5Z9Q&oe=6A2026ED"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aZxW1OZt-VoQ7kNvwGKq4ii&_nc_oc=Adq8XbHr6oXZAMcQ-Js7oYtvGZWH7oTP2N4RfgFtaanadipyUJ8e2KJH49szhW8t2bs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Ep41KeaMmfRVKgkI5WF7ckv6p5irFnoySw2QzXhuM4Q&oe=6A204C1E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
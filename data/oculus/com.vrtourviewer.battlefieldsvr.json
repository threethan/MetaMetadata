5033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vrNhx-zDZmIQ7kNvwF73Vbn&_nc_oc=Ado6bNqaov55ZMQA8gdEuDJsOg7BGFuJx_M3XB1tbwnAfWzWyNaSXvDXexobLVZreaw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlqWO0Zf6jw3huGc3Fx2HCj0tNkQH9XKMiBJVjBhDgSQ&oe=6AB7DBE9"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iMytzCKGVK4Q7kNvwFNZWN9&_nc_oc=AdrTcYFk6dAy7DoklgQN8YNol_BoCK3w8xYQd2BhkC1v4oEHScoMMf5WYcoYoV4h8XI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzF21gwcs19LQqcwnmLbhFQPTXdNJKeutsMh-Dl_iTfg&oe=6AB7D79D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vp7tz8sSMXgQ7kNvwF5N647&_nc_oc=AdrMcgIFIzAZ7hrHSkyZx1xpuBFYGumv0Oo_SffUT64NwAFPRykYUhe86Ou_WhrWba8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEuGnqPaJF8mftU7Hb14rD2ds5i0wc2fIrojgDqaEw2w&oe=6AB7D289"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hjkBWC6LMe8Q7kNvwE9tEp4&_nc_oc=AdrV7DEP0TR61SCL-KOWJWQev7HCgYNT2ag2WyWraxjNjLEs6YVA7TMTEkCgAjHLwZ8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6J0a5tK8eo9NgiJADzDV-WY-idkNrpTXg5F3hv7OB3w&oe=6AB7C36D"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gp6NlMdcE9QQ7kNvwE1RP8_&_nc_oc=AdoOZ1gEwSWT2aF2qunNxc3R3ib5XdfECaa9663h7CW9USj-UXEPPwZzMwoMsaTJg3I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpYyTaRJiFUl_vtjfC-onFub7dQk9Y-_bguDZc__rWJg&oe=6AB7E89E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
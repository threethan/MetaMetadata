5033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0cT6bvgNqLUQ7kNvwEAEoSY&_nc_oc=AdrGeSohMDGrMufn-wYVT05RPkKnkI6xjBo4bgl75AracVfZnCYqioILr4RS1y_OikQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFsbV7PYKJDwfl0VWj0w-NaKPwHzSVGSrlfmWVGwlRcLw&oe=6A92B9A9"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3em7k8r-p4Q7kNvwHaccZJ&_nc_oc=Adqz2bCrGnwzL9xPmQrhEDDChB8_GeGc_gG6wqkKUdJRnfp2zNuuu_FzFuvxEXMi3ew&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEEy-rvG8I9B7txSXjhsTpZhrUDmUW4Q45tuQEBtwWbCw&oe=6A92B55D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h3xHaLZNlysQ7kNvwEbvZWv&_nc_oc=AdoL-t1D6PogqC_dApXry9WfFhz6yRtp-N4mw-4GG66mof_9jNV0WIF0lr1WwHRzgdE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6cjMYBIfoYFt9glAytHVQc__m-ZgHxP6MM-NW9Pljtg&oe=6A92B049"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zb9BWH5Tg0YQ7kNvwGxPXhF&_nc_oc=AdospRVtAasL6IjwPPFKk_OzbWugiaICLyZL7sJ5K-eGX_cV0gZUUYcrV7kX-OdTv1w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFB2cAhv3OtUTcQOIAoQZXI3MN_duadgQfNtccfSoIDNg&oe=6A92D96D"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o4pqkr-5GdQQ7kNvwEZ7uEq&_nc_oc=Ado5Jwq4MkZdQ4vpLy6aCPhuJCMo4a6Z7Lwd1dwx0XrFJYgU84xDVJQehwS0ttiJVms&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLV75YLVZqfTFy68RSoOsXBrIon5MIgulsL2IiLqgpsA&oe=6A92C65E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
5033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ZnXqU6cmVUQ7kNvwHyeXHb&_nc_oc=AdoVj58CyvPnk5n89bOgfMNbOp6FxkyioAAraCzokOnn85Qbuj1I8ZNOHu10SCnFkww&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2A87egBnzFtdBMQMTsMEYIiA59AgPV0kqJm7OoAMSD9A&oe=69ECD4E9"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IyhxmSzdkE0Q7kNvwFVdqEW&_nc_oc=AdoZkHdOfQpJzLrhvBF8wjsItcX7HLYFSzCGLLBYL3WnfIO9GN-bxqtHeE3JP_15iOA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1et9pHrhJR3dc-xS-3_AXWBAAK5Ov90THo8XHp37OCxw&oe=69ECD09D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4v45MnKtpcAQ7kNvwEMfiLy&_nc_oc=AdqClhSYUkaJ_VW2ekRhI2uqdGqCTsHmzbkj__EE2nQTYBt0_1Dj4i8Q8rNWP_X0TG0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3OEkeHH8YCQHhMk7gPufBAhj7BxJ1aRcIXekP3X2yTzA&oe=69ECCB89"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QLHR8UQytNYQ7kNvwHfqbHk&_nc_oc=Adrz4zowgS4r8bdeDbS9QBqx99jb5SrljX1gdUImHTXJo9M1eQ0OIMiOXPLigY7_M4s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3jVUdJZnAksBq5-XhHLWuE4N1vG38eHLmcfexuQc05Bw&oe=69ECBC6D"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C0Pj23--WYEQ7kNvwGLEztM&_nc_oc=AdoHHCoVaThj5JJSEbURM12NCc5bAH-Msul7_ogmUVCSHGZVv3yWQn8HD2Dznsx2FdQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0M33aQPinQj5cMYvyHg6bq1__d5TmPZ5mXu7B8GDxikQ&oe=69ECA95E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
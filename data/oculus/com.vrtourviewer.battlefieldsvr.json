5033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dwrJA1EFpMwQ7kNvwFqUGzM&_nc_oc=AdrCOETbz4jVd64pqC_tyFma3wwqnsAemWg-LV-gbXcpHi-nl-QDXqU2bbc3IdUEAIQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZcB89-MCSk7-sWYyTHqQUP1rcSmSYagGFQ__QHKhKpA&oe=6A6F5969"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zlyCKDZpJ1gQ7kNvwE-02ez&_nc_oc=AdpQUyveWBrOjB5v3Rbap6wiFlJZu9_03Ts8ohLc3CHzGhF7j_G3Rs_DucRT7ed6kKw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwH8E4cFQLWlGiYG3-f7c3_pLB-GrTmdqcqjGG_iUDmQ&oe=6A6F551D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j6dLR1IEqr4Q7kNvwGwWzez&_nc_oc=AdqhbaOZL5Zj1dYGK7tbS0Q1rv5YABsaj3Nm0VPLBY-Jk8R3FoKYEVkFjCA7YD7XOxU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0xbOOUkqEgwwDjw2Q1WYCRWmmrHRVHrG0fL3C7zPQ2w&oe=6A6F5009"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2xLFM4FrNEcQ7kNvwHzbkwh&_nc_oc=AdpcBfJ3nP4Yk1ohfhoParP3kYVUXzGgWedN-U3P40AxtR0flD0_D5A57COwW1jDZqc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD0NPrPvhQPJ3BQO9hg6aeuy1qjvu-IWCURNswlXAz7IQ&oe=6A6F40ED"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K0FYAIZykOwQ7kNvwEZscX2&_nc_oc=AdqoVj2VniDl5b1aDqMUIg97Jv7NK8U7wsA1tJsmyiEeBMSl9Wl9HVs_eUY4rLUQArc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDFCnH5PulhuSN6SVqKu1YDMbP4xoxZ55AKuIcl51NsvA&oe=6A6F2DDE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
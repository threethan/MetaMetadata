5033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f7-PwK5HMqkQ7kNvwHaWulL&_nc_oc=AdrvwWim9m2I3AzvadP0lTZqnDQKk9Ywa4o3rZLbG6vwg8BvxNhk8jxlYqu5P-y5u9Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0fkotnxeiH2g5MsDbIPeX5gODXsyONvpbkm7wED45QZQ&oe=69DF6DA9"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gOFVLJTYaZ0Q7kNvwGm0vVk&_nc_oc=AdpxRLRWA8Qdtmmw_7Ory7knsI3cZSBxmw8sWMojQn8r_6Jq9leP6w7gR0QSEwdoK_M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Q2FkjqPWC25dtruGBby5bilzDJx81byHE0x5fD_5xvw&oe=69DFA19D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zteBITm_fqgQ7kNvwGaISZM&_nc_oc=AdrVjHP7TifsKKuqDEUoOiEbMWp9wvm8gKp3sg1pRRI4rN1-HZmM5p4LYExN3EGw8yk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Zyuw9WsJjLW3BllJO-sKnsV1YTlKZw2u57NdBVVqViA&oe=69DF9C89"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DaV8yC1kswMQ7kNvwEAamHr&_nc_oc=AdpHIfQvM93Qk-RuPsZoLIvk3P4dgnKU1Xu2N3HIRKwGD8mDpvj-BxeRRJ48nqpsv40&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2tCKO2zEANK1-1D2qhAMZSB3pRdEg9NvnHbyqgscaxGw&oe=69DF8D6D"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b0QOn5m7X78Q7kNvwFUxejl&_nc_oc=AdovHtuX_o7vWTvdJ2W3BvWN53VpjG7sirMbwFyYaU3LmtNdOqnIam94YGPqwpO3ETA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2bNDg6KK3az2pCxslrZtIV_3B3WEUI3bU5_3dELxeG2g&oe=69DF7A5E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
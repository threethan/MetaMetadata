5033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MiqvvZ_8KdIQ7kNvwFe_k1u&_nc_oc=AdpJMhymHkjo59_JXHQNPpInMOVKOueEP6Iiy-AA-O3-f3bjqgb5Em1XWsp_WXTz5zo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMOXzYNQ6Je5mh1CWgtzJchAMXGfE8c-yWHbMawytlubQ&oe=6AE0BA69"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hM8X_se_BvUQ7kNvwHupKxA&_nc_oc=AdpFLBe4Jyx0JDn0zlmrcI4h2WqBNi6aWfDs62MvZZs9TxwU7vWJ0hrdRQnMuojk_Gw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMfu8mF8-pU_CMZjZDagNxBVI57Z1ItGD_3Oxw5uOL9uw&oe=6AE0B61D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JMEo7J87jfsQ7kNvwESrv42&_nc_oc=Adoa4L5nz5VvXJRePBuc5tI7FjhECGRgCKIWDYjLrMCdbSTeQWBXzBeLiSTGJCjGm_U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2zFfcO4xEKXNu2G3lvpWuudDyWT7wgg_kXH2Jd637wg&oe=6AE0B109"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rJTKyR_5AcEQ7kNvwHL6cN-&_nc_oc=AdpwbCP7M3Oo1eQynRtXGa_0cD5CCpNT6tS4KjCv_CnqCmFWSuFnZ2GW8kuiP97FZIk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMMDzcTWMxOA9GfjJUUVm53foJ6VxZC7SENTXJS8roiYw&oe=6AE0A1ED"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iUSbZttDwKEQ7kNvwHhJgnz&_nc_oc=Adok6y7NZZv9RtmguPfsc7tJsPBhrh60uyYorms0atgs_N6zzoRNT0Ed7VDSUYq02dE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNVA4b9KcfkjVDf9Gi9RuYjcwuHI8LIT_eIsdx2na7xrw&oe=6AE0C71E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
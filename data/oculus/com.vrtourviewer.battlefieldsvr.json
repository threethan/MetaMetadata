5033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GYtm3UULyxcQ7kNvwGfyUXC&_nc_oc=AdopeN3CSSpL2eNomBb9Z_hEg8UzqLv1s3AVyjNdLzv6oLjmSc7CJX2Fgw9JCCDcRdM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOVJL4S8IlwhcZSJjQJL0eV8BgbvnFqrnN9s-Y_tPCjuA&oe=6AD0E869"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A-_wB9ZtsvEQ7kNvwH79Gxv&_nc_oc=AdqwhX4kPeu1FuIxODzsJZupAoyrrskjFxW51lm-pcst8ZRE93mSohsyQCNxjXqB_eE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMsStUijNQHkzpnJimlRbqU06lxHHKVu36Ve3c67AZPcw&oe=6AD0E41D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aJMJycnCSYEQ7kNvwFHwUic&_nc_oc=AdqRfUvL0HdMEucu14f6bQgqLdUXawFCc9diLfQK4uHTDI4Hu-LvQAAUyAp5pCMphlk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOVQGKAUQHauLsKreCtLaHzfCCSJPcOIy5BME7ThNR_Ng&oe=6AD0DF09"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NwuBF58yedsQ7kNvwGc1SnS&_nc_oc=AdoHlzqkFl090ASk_vah8uEYxaYLfEWeCIEcYYk8ng4eyIo0db-dKNRKzSufuUvfnzs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNnPuhbO0b7guRFVXhdW9ZuPSdBJELXEtJkwqYiEYREYg&oe=6AD1082D"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Th8mmap3sRwQ7kNvwFMJjFG&_nc_oc=Adpb-Nc24CkskX--8-s3vX44VYRabrzC6d3Bn3ssnoHYKFU_Mb8rHUzNDg2fUILknAY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOsRVSTNJq9D402XbqD3K1x5CQy6CsWXseXeCs54ATMKA&oe=6AD0F51E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
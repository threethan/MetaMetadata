5033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o-AHtWGckRsQ7kNvwGURDlA&_nc_oc=AdpTvEGlUDbkaE9cSHsg22_mrvcfB7Zn6pMcPRKkm90Zhd1y-caeVTHQ398oN5Lg-pw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDRiv4ljwkVqJYSS4oOKGa1Jew8GpXKE3x_AuMp5FD-qQ&oe=6A4A6F69"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_yJhRaEfg9gQ7kNvwHTcZKj&_nc_oc=AdrNAiz_KwoTC_tZPTJAqepLXXueVnTUb_opbSVOWqgE3N2PTBejCLj3EkCzG_0w_L0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_kzMWdZN4jL5WmhTUd-MKBIthPS-sAmjT1jl8b7AHhw&oe=6A4A6B1D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aBNKZEEV2GUQ7kNvwGQA9eC&_nc_oc=Adr5B--Vve7Kz6R40LWs7imc2_iqSIjgG7CTUqSCoGe4uoU0f1KwhT3yHC_U1mtl2VM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBI5uUnKpM_nSRjZcmanZVtkkuamC69FOzHMQ2fPIQRLQ&oe=6A4A6609"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yfi8XTtLvpQQ7kNvwFvIIsc&_nc_oc=AdpH8yectJfp-oZSaO5VCyC6Sj3nWSA-R-Du_ZjB6AqcnQ5vCxO4d6_5vVGGyjJsecQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCoOy6aXaewpFcwxkkT-O23brPpwfULCFArWwTs_7ughQ&oe=6A4A56ED"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4GOhPKtDUr8Q7kNvwFYb65l&_nc_oc=AdrvD25sZ_8gJPGgY5BXtJwTwARAATrt0kVIjYWBN7v-JhqQwLo26oj70LJSgdpTVEI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDOsNA-lzG2uh-Q8v2f2_fVbxqe1-rHa6vA_H0rlgj_zA&oe=6A4A7C1E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
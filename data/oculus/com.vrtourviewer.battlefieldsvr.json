5033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hD7c5hmvbP4Q7kNvwGBvz8i&_nc_oc=AdojiKuRm0li0lM0KMrA1Ufq18FVe-CtjOJNHmf4xaoNjLBvXcoMlL5TaqaKieEhPBc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB4yPxvPR-WylRZy9dPKCG52VAEoODKbqA4h_NBderVaw&oe=6A4FB569"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bQSTqU_fchMQ7kNvwHo8wAI&_nc_oc=Ado7Ksmz_AQpjOoyyIG5oJLIDOEokSiOG2QGlsV-fGDovvftHtWUu4PzRHvaSZsgrhQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBsjCFC_eN-ouREn5jKP93OusSUSVsA1nZ_nuoG5hhtAQ&oe=6A4FB11D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b2VBQZuaXOsQ7kNvwGsK9DJ&_nc_oc=Adpz-x4pzWQ514iZxszO3lLXaDfQQfB2kQwjfgq_10Q2TdUnVVYfP16EKqCKM2rSUhw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQASH5QLgmK0ieJhj7brfDoRLWXFgwQd-nEcUIvHzYpcmw&oe=6A4FAC09"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Ofp_j6dtEsQ7kNvwGWjNdN&_nc_oc=AdpSVtRUPFU-obafzn69uwQh9Pp2IJOJehS4-Myeai0NHJlBl0Twv3sk5vofXHqOh9w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDHBmuqzuqWOh8g_JggAhoG40ipe3M1IOLVcOlzK7FG6g&oe=6A4F9CED"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LduYAl9-pqkQ7kNvwEikDGi&_nc_oc=AdqssFDZ-x_UgSaqAasgLFlHzEQB7rINVP1PqdYel-sGhLDg2ysPfp98rbf7TPmYRKs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDfm_A58L3vbXozC_i_Y3a-YlCaFSXeh8i-qNbTOhmkcQ&oe=6A4FC21E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
5033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bh2WmWT3PWMQ7kNvwESglTM&_nc_oc=AdqQ_IsoK8pX8vBGDU3R43lZND0u6CPi8co9TnX-3LLJwQfBWl1CLFt3hCPrw3QdCNw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2jnGiP4TtvyAOdlotLZMA4c_SNMsihWftwqhOR9AeGlA&oe=69E63D69"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ttU8Ua3QuoQQ7kNvwGRW9GN&_nc_oc=Adr3RWjJvtcFdgHhkoCWsLoMOm62gtXGpjLQiGO5e8MY9zcXMAxw8k_mJ2E7xKcc6c8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2QymPDV4-vvF-pIMATTX8tIUdiP30Bt3kUj4nZtCfNCQ&oe=69E6391D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bcaBYFK8IO0Q7kNvwG5N_MC&_nc_oc=AdqOpD8ZH6GVCyZWEZoB_4QOn-vDBkjwUH9xNC1ENISPD4kYZGyt4SWGXnZddTfPvcY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0sEVZPnYJb0jRcElKb2zkNdDH3M6mDMtXVf7mxrQFDQg&oe=69E63409"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=whkUBZU1vlQQ7kNvwH4hGHG&_nc_oc=AdoUD9AMdaqwnut1bLl3ihZO8zJTcrNkqfWrqQr0lPjfp7Ih-1DggqteMA0g-a2WKEE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0qd8KU4dNhzoC3RsvLwF7u_VGa5RqLms1VT81YddO7xQ&oe=69E624ED"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mqy4zvMl5lgQ7kNvwEInxzf&_nc_oc=AdrdwFnYQeNyNIdIi3diq7HLOFE0mBac8MLQAxr_SyCcZBXkds8d6ZD2TT8EBR38NfI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af32X22vKH8vB8vMP1Ns49WeOd5qqE_i6hGrr6lfLowwAQ&oe=69E64A1E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
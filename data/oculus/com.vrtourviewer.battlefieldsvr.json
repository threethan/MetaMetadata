5033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bh2WmWT3PWMQ7kNvwGNjx5y&_nc_oc=AdrZUoXluZMrXyssYdxs3exNK4WFhaBwbdL9XlQ3VoF2P9eClaEbFQS8E0-cw0QdOW8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af14uUCqOtXYjOykv9ZZWv5zrnXA6irp_Cq44K29FIhWIg&oe=69E8E069"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B0Ro1IkDPYkQ7kNvwHYtgX0&_nc_oc=AdoUqJZDi0-pT1N6tV9p6qRmbhG-9x32kWWaHH5yzVCoIUrW8CnGUDfooy1xQQkVlxw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ulPR-Z7WY2cE5ELr55v9UKAgHjbQzF5_6nbz_shJ81A&oe=69E8DC1D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bcaBYFK8IO0Q7kNvwFIR7cg&_nc_oc=AdqYB4FJ7b3QhoLBdezqiS68FVix9HBNCpvGQQwhfRiWatqDE9U3nxB3kIUQs13ZsKo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2vk_BQ-3GruWjk8Prmv-n9-sp5sjfTNC23SPHrgvYsHg&oe=69E8D709"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=whkUBZU1vlQQ7kNvwGw6kyc&_nc_oc=AdpjIia-seR1mtHoeuAMBlImaa_5SJeHq3mYglbtRlIlad90khaUM9-D9RFv6Vr1GWk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3xhIw3HFUkimry5a0J6jo-oz7lRjWrWbLHxYWnuoKoew&oe=69E8C7ED"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zl5_rxnU4-sQ7kNvwEGM6Gq&_nc_oc=Adq23iw8fN5pnKtYtGJ04oNLg2ORiPUF3TlzFC_jOJ3Qu_K0ql-X9-qKHpg3IxlRkdU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0v0HaIO-gDOy1-eR5JHCkP9te_h2i0cNLkRCT-vSIXcg&oe=69E8B4DE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
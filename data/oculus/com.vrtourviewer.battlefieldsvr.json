5033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p3AMj3wvaNsQ7kNvwEQYWYy&_nc_oc=AdpFgVsOjziBgomYS88VmYo0H-0wnVpl30jY_lfVoVhlEiIzl1vU8gJ-w0FEzr9cfTk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLgCvGpjZDIpuia2yD3fCuHaI0gcterIXZXcAOVS0R8g&oe=6A9837E9"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OzlU_T5sFfQQ7kNvwETKbGj&_nc_oc=AdpJcdiTU3vlLDtLHulxZJsGH1HU8Rd8ClkbADbAEGlr7j9og6Vny6X_J7ftmLk52iU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIs71eVp9lJXcZwPxJLyLynZFz8ZvzrhSVjXCjGAnN9dQ&oe=6A98339D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SU_pFQMPaXoQ7kNvwFnlLza&_nc_oc=Adqg1p96qMBYAYHZ61H47kkkA262wHNxa5XMJfmmYw5nR5_TJDDuVG2OmB3JWU49thQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJhQbJEvyxNJeSutmx-cwLaIOJOz59Qb4A8rlEHLcNadg&oe=6A9866C9"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tHPglfqhxrwQ7kNvwHZqAi4&_nc_oc=AdpnVl1M8EiJ7EFMbAtL_3eR9UxxyaVmwc5BjCosmETG5swkyshNcT67xom5EJGyd_o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITF84wKgnWpE-jBUKfOK3VH869-2uJOLzUGDK3DKSuCw&oe=6A9857AD"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i6JN0nSh6MEQ7kNvwHKU0__&_nc_oc=AdpIap5r9Tajs34a8CfhTDBbax3wfgg0nDzFlfOOnRoqzEBuZyzqPkvzZely5JNM28Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPbBAj8xSNmZdmuFkDPcCm_r-OeFQXHzPr1HudC73u5A&oe=6A98449E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
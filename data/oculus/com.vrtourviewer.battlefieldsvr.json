5033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fBqAUiHliP0Q7kNvwH3YmY-&_nc_oc=AdrIDjCuiMRDqSg2yx-LyJZ--A895YTBlJp_KNhyCxVhwLyYCz4MRqBF4fKSWipzlM4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0IZkqCqdtCPeGxd6qHbCI5KWQdWT95kHh2ouSRufBV0Q&oe=69D3C869"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MPNzVuSLh-sQ7kNvwHlPsU1&_nc_oc=AdoYNKjIABuMa-Me808co8WBjTuFkqr0ga2L2p0NawaLP_o3brRfsUW7rt-uZ-I9ZPg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0rjpjsdm0SVIHAWCE5SrhYL--MRa11T0xIkcvd88us-w&oe=69D3C41D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H1vo345hqGEQ7kNvwHYSoEK&_nc_oc=AdrSfQj2oIKKNIOya5LInAsp0Ha_qY5MzbOej7SgI55BuqDcBe4dC8AHCFT6zYaBMBY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1RjzkehiYB6IOr0oAA2nZRqbpKkNRHn36uTFhvGr9mDQ&oe=69D3BF09"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qazveJ72zRIQ7kNvwFeUz8N&_nc_oc=Adr0iaUmcGbrTd5RFBh6-CZak6zguSfpuPffWVW1VF6adj74Sx1qE2xByz_FosrVZZk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ZduqiJh6F5Ml-PH6VdFQ9oGE_1raZLYr_4iPGJBweUw&oe=69D3AFED"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8jV5NUTGLbQQ7kNvwHK1-JO&_nc_oc=Adr6TZt-U8oTGCZ7Eevouq4Wq7zNsuqd3t9Gv_mjHPX3uTz_9ZcUr_nOBEYXj5q_Q8c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1XkmpkqtGacfltr8InZxvpkI7SmVDVB3FMLLfvP_VtmQ&oe=69D39CDE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
5033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hqBCaRtmAtUQ7kNvwEKu_45&_nc_oc=AdqSMmJYc-umyhBK8W-SDlM8a8zbWx2d04CYuZoLyI_R5E9eGB5hy8YVDe4AhTOfifc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af72jtdqONm5qf6bNJUWCtYNDBsmxnnjqbE9H2ouNmTPdw&oe=6A1704E9"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8I4XULroyKIQ7kNvwF_72Jj&_nc_oc=AdrNCTDFuFGR1wLYbckDzkjOpaIS5CQMJOxFjcFN_F_bnAPuDFXJg6XrsZxjR-HQ7OQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4bHVJ6E5kVsxT6x79_c0CQdvyfKmzRQW-EbTOZulsZew&oe=6A17009D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BPAPbmXuKMYQ7kNvwEUKN76&_nc_oc=AdqcZh1pg_iD9crWRKutGMg_pdIgB023ZnOa8DuxtnG0GgO6-EBquRAWg2cln8bTWhQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5rfShZvviVIuIUhAjyf5TtKA7otCoAUbPsW9Aoq_1Llw&oe=6A16FB89"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=84WNaKxuD_kQ7kNvwFfqOVZ&_nc_oc=Adqz1O8Ljeb5_ZX570XT4RBa6oCGCl7DLBGmOBCSF_h319UULDw5a21JgaNsiwZ41hM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5bkv3EL2GODR6JBgd9RB1WWjHSjFrenMm313aRmZ1JNQ&oe=6A16EC6D"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tNIIDpc1P0sQ7kNvwHvie7R&_nc_oc=AdopHDsyKMKnWLninTA1Hv_fW0HHaQelL8ojDzGK8hB-H8Qqc_IwRRw02BjibOfZGlM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6VbhEDFLDJ5mFbYSaBuHRGPBU0_vV4FqYr9wCWy_TMzA&oe=6A17119E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
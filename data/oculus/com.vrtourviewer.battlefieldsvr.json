5033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_PsCqvDzA7MQ7kNvwEHG3Vf&_nc_oc=AdodcvZ4tn5N5vizPI_yjEHbHsJ95FY8qhE0ncSyD-NWVrMc16g7oh0jreqz8oymXOE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ZQFMCYWIaGrKhVLEa5s7fQpokP0CZzoyBzWnR2qctPQ&oe=6A3162E9"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0UXB_oiyrY4Q7kNvwHyL8ue&_nc_oc=Adqj8HevKow9sRZLrrX5680cxT9z8ce8WVlOu8V5t1P1yLc4_--Dv19KOEkhyP9AduA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8f_47ocj08AOA4GWlSPNJh8B2jBLKfYkkJlcPqjdGPBA&oe=6A315E9D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hTLMWHZukKEQ7kNvwGI_1uD&_nc_oc=AdqoJN3tyUxsSBiwg47TJ24JAECSJ8um8u4sQUKn5B0hXdDknzXoXejmBwMDli6MEH4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-jRzza6zu7Pu3q1Sc_3fqu1tQ_QYOt5jSmgRDzXtaIqw&oe=6A315989"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N8ncCJDtqDMQ7kNvwFBDZkS&_nc_oc=AdpQg_LVeBoywWwYa4KiIOxLtkJbJCHT1aJfWe_b75S1JW6dOyoekWiWQ4ImKcRolp4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rKXtK-2JruPimjyoMvthccediOf15d5JkpkSei6FHvA&oe=6A314A6D"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AYoW59-1l-oQ7kNvwF9bazH&_nc_oc=AdolA0bhViZRSV7Zr-XXz-CusYa_pQzePXZl-JYAytq4sOh8Q0dCUiixPV80at550ag&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ZQUc8-0gTESIRzznKQz9lIBoE1lf8cLHS3HrMI3XfWA&oe=6A316F9E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
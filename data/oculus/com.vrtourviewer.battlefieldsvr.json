5033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LZ1FRXA6Yl4Q7kNvwG2d8QJ&_nc_oc=Adpq0gLB67H5g5bSkjsxGE3Bkx2Zlue8FhuxE9MquAK8svNCxbDoD56XxqRn6AZlSGg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0mp0D6H91grbBag4cj7UWcnKGPoALo-GlHyVd1MuVRYw&oe=69D90E69"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0WldSfs1nJMQ7kNvwEJEq-g&_nc_oc=AdqB36dZC_PIn_cHGdcTHgxr-fbp_uqw5_E2Kg-LIRpgMhlNHyGYMGM0peJBvEA4vN0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3_dSIZEO7wIiSb45-y466a95pC2LYI7-L_0yV-hN4YJw&oe=69D90A1D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NpcDnsgP1AQQ7kNvwEQNGwX&_nc_oc=AdpAuoOlBJemKe8S0W8k8NW-n5NFnp7f4RoqDx3k79NCsqHHjbwpWCjKcAlzV8IvQBE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af092PwAUNZM6LvaNpnm8MO2EZ8waJW9BmZhxohsrl1tiQ&oe=69D90509"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ktnJR8RugiYQ7kNvwHxjOEM&_nc_oc=AdrCt0Q2DutW3glj6POZIGRvhkn1iWo-GBlW0rPHPh11eWHBakAuWB38ZwfH5a2k3hU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3sCTv2DuBbY7hQO7XCYRXOTsXUPMZGbWTPCs2EW6jImg&oe=69D8F5ED"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KcAeiUqcz1YQ7kNvwF3qGCq&_nc_oc=Adon4ukxDollNOdk-U5OgU-cHHwjgF-2c72uiGU6AoV9JoyzKk3mB1ZQzJ_1knwNp8M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0PVJsakpLaKNutGF_qq67nLyTzX-xDwzIY4XEawgHfAw&oe=69D8E2DE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
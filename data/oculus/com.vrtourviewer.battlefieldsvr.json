5033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qy78ouen4w4Q7kNvwHvZmnd&_nc_oc=Adqd0_op_XVhtuhGzYnuw23AX0SK6NmkE9i8z6X8A4Bvy4OQqqLjuMd8h62VHpNnaVk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBA7oArVNTVgTjhwfUloC_yvig6VzGNbnAYaUptHO2RGw&oe=6A637BE9"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wPh967DEdtEQ7kNvwFXHMDR&_nc_oc=AdovU4zV4rjShe7tPDUmFJMzbOzJZaNtPo6Ia9-nONQbGh1xCvPJoR9f0Yq3MtsZ2f4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBLWcZX5ZO1aqufwz_DI_epaf_qUxrW4eoad_qCj4g-rg&oe=6A63779D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-5GbmgqdM78Q7kNvwHiRt0g&_nc_oc=Adpe3A2nIHdpRC7AYmt0oGwmCKjKwFreknZSYs0dNXRK6jJ0clLRTO35lFYxV_153_Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBzsvChw6Tlj13uFm0dwNy43XihzWEXcbkqruRqen2W1g&oe=6A637289"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eVlFec5c0acQ7kNvwFhoIzC&_nc_oc=Adpj5G9E7BoAZmcngH8c2lStPOYm7TYl1VKzEW6edYkIlIBgclv6lr5-18GRK0eVYhY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBoTcg66NfPzXIoBprO5JbCtmhp4PU6LLyPFG3wiCE-dg&oe=6A63636D"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XV-ucyhiTyQQ7kNvwGTr5r4&_nc_oc=AdqPBne_cCpyonGY_dQZO6VcRbpUuaWsFzZN7uOtCaQJWHDLIiFYvlW-yDnSw8pomrk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCdYK74uUeTBn6cRdjEVO7gKQ0TO7PIxNe38CfczSwazg&oe=6A63505E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
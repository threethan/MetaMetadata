5033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QBCjw5-EtGoQ7kNvwG4XjA0&_nc_oc=Ado9I-kBlnNsUBM0CC8QYJOWd-M-nWA0uj_lsz8yHioQeErwMGIeyA6NqTuXBdqInL0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD1guYhDntAvP4eawLvWZD_lf0rHYcn866tDYSrR5LpcQ&oe=6A6B64E9"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pf9PxCheymEQ7kNvwF8Mbgc&_nc_oc=AdqqmhXVXlKbkUkJ_uDi7YijlqVxRrNMNEwX6CDRl_VF6BURBspSwkzghNBw_lsbYwE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDcV2Z2T8hOFX6cJOkRstR3DI0ej4FprmoBhRwgzd-S5w&oe=6A6B609D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B9mVWGax6jUQ7kNvwFCDF8l&_nc_oc=AdrZ64sB7wcagDHLTvVyYxKcmtiRHCvBdRAVB_JPQtbLZNZIYv9Ef1Ha24btrOGTRnM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCAb144nSKre3EQXeqkwpdJZNt_xEvFv-1L21LIFXls2w&oe=6A6B5B89"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sw4sbqQx5OAQ7kNvwEbsiKb&_nc_oc=Adr1-jyo6wtJHxRVDk3VsJlLidgqcyZNU0_5gukH5uk9LPdlQ6CjPyOZd_Ksqn4y4I0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDuUk8SpXm8mdrlK7meMh9j0vuSXl765cX-eXhGeAJQmQ&oe=6A6B4C6D"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=svwPCEgLyz4Q7kNvwGmUiwg&_nc_oc=AdpcfT0xeiHtAlwHv3yljqE1QkT5TydibI42psfbUBN8ZGKr04joTDugrAbxopca7f0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCTmiojRNejBUJqhdE09MqwOugu7oqxikBm8d3HmTxYtQ&oe=6A6B395E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
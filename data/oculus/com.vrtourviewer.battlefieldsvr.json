5033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xCBEF5oYzioQ7kNvwGbaufe&_nc_oc=AdoxfquxP-9Z6E0tz--tsYkmnVEmDbTEZ-ARcLJ-HnmJnLh_JianW1yANXdNO05yNv8&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAKzRPJWTowWhFLpk5Iae-vHTp7k0JIfiptYc_B3oP4fw&oe=6A58EFE9"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4t8VV0xS9LwQ7kNvwGoGB7H&_nc_oc=AdqVTQsJztnE9zL8m7m5B7aLqjiUtQylmui4AamyO8N7xQCMtfDKUZaUoAX2d-mLPzE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6Zh3nx7Psf3vFYxV5PX3K4HedSXzgMGllZx-26kWItg&oe=6A58EB9D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dMNAfDY9MpsQ7kNvwFJT_bO&_nc_oc=AdqoXjuqt0f9o_skJF8KMgaYZ-nUCGcsbydfVe6VsfVgFyxCG1RbqJs6BvNJjtlWjfk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCFrbGpvMHBRydHQScrOpV-4NLgaY2Hqh63dOrK4BVaow&oe=6A58E689"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7DE-unMGnBgQ7kNvwEZt8u6&_nc_oc=Adq565NjPWW1VPGH4hwFU2yjwG-4_yLiPykxH1DxjC2_LMtsAg8xu1tMd2mftaK_dLs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC1_dJJ1dF5ABIadCVGgeUo8Qf0A7GBKD3zkYJ2P9e8UA&oe=6A58D76D"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iFFHjpx78xIQ7kNvwEvZW4-&_nc_oc=Adq9mxStWUCQnM-1q3YPhaN0EsGHs2HwDyRFQ_n-Ssg_MgoTBWixK17R8Su9xxSgmTM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDOvS8gYmhv6DImt_xnGeVU0Y1k327eoV52sqqnweNfDQ&oe=6A58C45E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
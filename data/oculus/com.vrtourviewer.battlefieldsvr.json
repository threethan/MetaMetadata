5033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8zCBc89UlNQQ7kNvwEhS1kD&_nc_oc=AdorMjLSye-BHJzSxb87LVp42-e2covU1HyONUgaYYJ-YyEu5rzmr2KHYBM-GvXwmQM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQn7gUmgmGej98AbVgzLUJpIEIku5CIhrlG93F6TooLtw&oe=6AE8A369"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nkoQW4eSy38Q7kNvwHrhWnP&_nc_oc=Adr9W-hXKW9O_snEOfuI5yCiK7fPrXqxiKBdFgXg9WtNAdT-nHdjnYTjsM-OEAjRp6Q&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmVfs1F__LNGG8gi2n7wqpSXyZQLDI5FQLGjXkFUzLAQ&oe=6AE89F1D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IPE1Iro9aOAQ7kNvwHPzRoa&_nc_oc=AdqdYxLMkT28Bn2qx9NSfsRxAMQXhvfKpOpS22g9lR1xc0NqXsUNnsgGG87Xntlg504&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDBghCrZaikhgkQdXAr8t5YFtoJXEWP3DX-v_9zwd5uw&oe=6AE89A09"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b9KjHjS7fEsQ7kNvwFhIISW&_nc_oc=AdofvEnkbpzusiSHzZeKiHu6JPuPVCjmFpN-tA2RU3Irsf2uoMHltH3L48ofn8se2_o&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQj7G5bGke84uEEQ5_VXWfievsEQwOyUjFEQbvvi4hmJg&oe=6AE8C32D"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l5ETpRa4DG0Q7kNvwFf2XIw&_nc_oc=AdqdN8fB607IFDkrIxkn1Pmllb9AJDXD69JN_DftiSHKhyy-gtuaKoSKQ0TjNOIeDws&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSYw76Hv_Yzm2aGgc-ixoiPpJhIf0kvOmJiO18TnZSbw&oe=6AE8B01E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
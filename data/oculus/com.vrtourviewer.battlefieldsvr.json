_oc=Adm7ZfWdHyrIE-erhF3IGz_LahMM05sZ0ZqzIuOMvamld8fU-Rlb7KoqboNlfCoRugE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsCewgqtKAKNqJi7x1Zx9A7pN8VEYqDKXnrmzrduylRdw&oe=69998E29"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cIbrUvPabHEQ7kNvwGRivM9&_nc_oc=Adkgz9xkG2QWLSxbQRcAsWeMgnI4KvPeKHwRqpYvoBafI3AVd1CZrPo1sFMUR6hGWQw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsIlKanD2VyhQ197w93If1fQoKLQ5R_9S-PDgqVnCRefg&oe=6999C21D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=creBXZ2OzHYQ7kNvwEV3aWb&_nc_oc=AdkxLSxZ09jQ0moBthjpuNDzrPKW0w4nvbuGIyH6oJkW0Ymy6fi-CFOtcA9UsKf-sbg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfttNwlaSKB0Y1IZJ6-1Fnl1VsNS7ACh-MRsWGeRmRFDIg&oe=6999BD09"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SP0wck98jpgQ7kNvwF7QcCB&_nc_oc=AdmrmDdVnRI1N8XzDfzqma72WUhrWyb9cWsl8HSih7y40AUeADkZ4JU8QJD6-W72-dA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvmuWTNhFB-a2jORKvFuaakz6B5v5cM3bHltwQLGiMC-w&oe=6999ADED"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HCcLHe5-_ZkQ7kNvwEggXIb&_nc_oc=AdmGkRXpGF0045Xsi4PY7cPr2AwnxO5PF6h8hmG-24OgUXTOKkhbDt00WmNFnCIZkdg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftyXNlwUakpbPxEPE_Et9FUEqhoEa3yoMnefq6-8qKbxA&oe=69999ADE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING
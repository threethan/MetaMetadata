5033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JpRoPIAxH9IQ7kNvwE25HfS&_nc_oc=AdqHXqkUrRXLK48M4GnU6pBimVmNfCpOwqyWb6Umb9aBif6CZOIeI9_b3ZYJjulSFDs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTG99YawpbLq5Xvl0kvAdoLWZrMof2aAYdpzDX435KWpw&oe=6AEC97E9"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HEpS45VOIWgQ7kNvwG6BOFB&_nc_oc=Ado-I3dqKdAnf5fQV-O1QLC9DNqwYQGZXFWoy4g8UrFyo3e7HXTJsKc-vEl5mFMHYFg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQaESRPn0luMbZRrCNehmTxeR6d5MfCuIOyT1mUsebZkg&oe=6AEC939D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HZy_Ui7oZyEQ7kNvwEC8GnO&_nc_oc=Ado7IdACy7DxcEq4NgkSlg6mDtuB0VDxvcrGpJR0Pa7fWnr8icoWV9lTCqZ_ecuDttc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXDTExUmy-yt5Xui6bYh0SXdiGxwO9CaX5DWYTyguUgg&oe=6AEC8E89"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yYDt0sunNAAQ7kNvwGcUzbN&_nc_oc=AdpOc7SgE6l8CZ66QobWjyA8wXOIY-bW5WCQgjj_fyysZJOg_sph02y9YqO9VENy_3o&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMa8vk2EyJtaKi0AQ25PAjsbB5A-IRpYqvsapK1nkOnA&oe=6AECB7AD"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fRabvhqWF7oQ7kNvwGpcyi6&_nc_oc=Adq4NtiBi-StUpP7FYZsxk996ijZC5fqeVGciXwrd5z_YFF2EXnQeej5V9dZwQeZ5oY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSs0Yajvpe4NoYnISKk2rMeYmOAlRNH8vdG0dUpLUrBnQ&oe=6AECA49E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
5033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WMrEi6rhLvAQ7kNvwF6t4I8&_nc_oc=AdqrSKAhe7EIgjR5FoBRzEGtr_V71NeLTE8v3Ko4o6XPAFrKE_KyfGI0gC2PdMz-yUE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB0xe0HY469ZzXJGMXLmAkuwIEoOf7MTDiKYLTVVyVylw&oe=6A5106E9"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bQSTqU_fchMQ7kNvwHz5cw1&_nc_oc=AdrNFW3CD5qg_0k0h0GNKaH9vaY4XrosPDWnBl4Sr96jnWvBZPXOlTUXV_Iy5g7p0og&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCvgNQFXSFq00Iq_-YiTBhVu2Y1W7SWRmBIO2u-1N-Jjg&oe=6A51029D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bu-2-K9IQq0Q7kNvwFZcBbR&_nc_oc=Adqc68gdkqIugs526cdeJIjhZHYYYoBKcdXnEBuM4_POc9gr8-95v8ebHTeKrHZ6Prk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJ8VCprrBK5-uITKdP9N714OZXn9cY9f3w9D10_Tq8TQ&oe=6A50FD89"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=63hqWbfnICYQ7kNvwEugnQW&_nc_oc=AdpnZy-Owp9aHsXIs3XPFGE1Wgk5s9gU10xepkyh7aSuqLaJHfgfbh21OUXMZBPAuGI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-ML9JKN6QhIw8293Kmiw8ILbRNKaF0SnjI_NX-nGldg&oe=6A50EE6D"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LduYAl9-pqkQ7kNvwGlxsVO&_nc_oc=Adpl0HwowMK90hkA5bHje-QHAFeSiLCOp2Qe41J-l-wuWBK2mTFl1_3W91UBqtEBDnU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDl3PvWIV13IeMp-NimFbJLchlBauFxprC25AS_0amc_w&oe=6A51139E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
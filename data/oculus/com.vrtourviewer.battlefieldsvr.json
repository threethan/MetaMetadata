_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fv3IE2VloKgQ7kNvwGsw4eV&_nc_oc=AdkTdSkE5apAAI0XJw-bYfZOdfNZbgs_9A4OXVYYUiAKDV6CVr74I-QrFcTKxUaDHA4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfzdvI1vOkf0iSa71QfPrXC___vAlbiDsBKCGst5H6NgQw&oe=69AAB1A9"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jLWMvwC_GVQQ7kNvwHLTjuF&_nc_oc=Adn_mdvbFctxzqUqdUw0GNWXQa3z_svqsG25DM5PgeUK9Fc6tC6CoJUF6cKHyqfJkhM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfwpxRcOm0Bl2qfUS3ML8n4QufBV1_aAMbBg8nqW5PWCmQ&oe=69AAE59D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VN0UjSMO36EQ7kNvwH5dE8y&_nc_oc=AdluzVELS9FVeMyhXMCF15mWD_ACQtB7Mj2vRu5oNU_q4NF372YnH9ju3QS3zKuiumE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzdiyAhRujgm7ZgJIkmVTWh_tinRMBlok35AW-i8ce1jg&oe=69AAE089"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dKBIaMQslE4Q7kNvwHguDOq&_nc_oc=AdlTC5X8pO_p_FCGeYJidEJQH2H-79oKN_HGl1eKq-VALrAOY2iCtQD8gTbolpdOsBY&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfyFXx6DmYe6wBSqXocqK6ZvFg_nGWjo4puCvfHB_fXsLQ&oe=69AAD16D"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vH3it0_ZluQQ7kNvwHtvU2o&_nc_oc=AdmXOBeANQmEF7MBoky-JoJ4RWb6HcvkhniHwwBhHya_h3HvxSxswqi1-9YFqMVPx8Y&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_AfwSlH8D3-GV2CthZ9N5piR2eV2NonmlLJAwTNXOGjtQeg&oe=69AABE5E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor":
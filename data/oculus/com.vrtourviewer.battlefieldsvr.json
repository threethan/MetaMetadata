5033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ZnXqU6cmVUQ7kNvwHE91tq&_nc_oc=Adq-cjcCrdWuw8B4aBQxmR1122f5TIkzHBGlo4iX9exyCantFYkBnZ4LZ0TMTIDXq7g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0QGXzAvZQvVeei70QodXquKy6bWEgskkyXU21PEEvTRA&oe=69EB8369"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IyhxmSzdkE0Q7kNvwHcWXjb&_nc_oc=AdqE38NPvHcXer_40TSv7b0WPuf0txwSkf5ZOwIjxlcPbd2pRlbmsNP52sx2-uLyjj8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0F46hmmKT5ShvC4QEaBJGwEpBgBygfi4UL4XIuhTm2iA&oe=69EB7F1D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4v45MnKtpcAQ7kNvwHGUi_s&_nc_oc=AdoLq_C1VyzT8-kjcXIXVLSZBAnGnt8nufb-neb7zb0cwC2IYI2LqVSU-fG3yB1bczw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3dY-WI6zJMnI8wWqQIqQpwlnBN8-RF8STVzlpZeupgkA&oe=69EB7A09"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QLHR8UQytNYQ7kNvwH3aLnq&_nc_oc=AdqKgK9B_yrkHlk0EVAZGLBxS7GFv6j39oY3DL5Yb89GJX4wTSQ520iJOoCOPuujDwA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3xpKG3JCch8_4Qn-QQsqRsUCwSsbWRNAz2pck8Au3TkQ&oe=69EB6AED"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zl5_rxnU4-sQ7kNvwFf51qC&_nc_oc=AdquTGiSIulDzkSpcHiY___SVOQx7K9fWw9W0sGgXpH6oqTI3pd3EkI_25kVUcbEWCA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Q9Km1HJ0DmBY-r5Czyv8UzyycfimvJr0z5srnIdxCVg&oe=69EB57DE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
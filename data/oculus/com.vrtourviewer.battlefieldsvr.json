5033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wCL6-k8aKvMQ7kNvwGRreAR&_nc_oc=AdqnOtNHb2SMPndDf0BopYhZOz1EPbxDcjHPudVaHt0tUHY80WhzNYwa2TcQ1p8Uoio&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ruPfAPjeFmGboMfonFdJx3WgeYoOIzZ_dNmqK03C0Yw&oe=69DA5FE9"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0WldSfs1nJMQ7kNvwHTx6-H&_nc_oc=AdoFf90hfhp0Utfl9QwiNq-P33L889A2GvQsgUhyRdTy9hJfPCGJGRgPulU6MYEh8U8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2z_nxcnasVjnGW-mTjwElrkF9kOx21_67U5oNqTkUhhw&oe=69DA5B9D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=znqkTBOCKkIQ7kNvwGuufkL&_nc_oc=AdoGTrxuG__WsKayhvnJ5SXS3D-YD3DyWcc5bxb-Yo10MWgwO7KKVHh0pu04J3Kw1V0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Mwy_8VGnFqnf5Op_CTMyzCWDq7jJcICkhz0mMHtuWKQ&oe=69DA5689"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xiTROY9L5iEQ7kNvwHR0nUV&_nc_oc=AdriUZg_XP7VmQfrkw6umoylD5ibIWuHikujNCNnq6fpmAbR2j4tGmJMPYI119gwV9s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0cMOJG17CvvrEhzpZyS8bGP5mHXJKe_E-rHk6rzR5PPA&oe=69DA476D"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KcAeiUqcz1YQ7kNvwEWE0AD&_nc_oc=AdqLXU0-x1b9LqDtLI7O00GEFvRMaM9sTC01nTUSsjyx4_V6DaNZSHHDTnQ4BNFGr-A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1EPbBxXKEml4jRQQ6rDS-P4AvlwyewKuSRAel1VhN0_Q&oe=69DA345E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
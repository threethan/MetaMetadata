5033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hGNY1r3p2v0Q7kNvwFw-Tai&_nc_oc=Adq94ELJopDweIplvz5czqXt1xmAN55PRMkSwnL91rynhjBp5S0JhIjLsZwYQnhIXxQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzvl26BkWoIZdEnHftfu13myE4t2gr_JI7wKffOIyNc5g&oe=69CD30E9"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=20Ailofl1DgQ7kNvwHRx00q&_nc_oc=AdpOZ2E5-phIHobX6w0QItC-FuNOHzNoPO_hvHCfOW3oTpwVkcLaTdg92Y9wLQS6pK8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzbq9rYmsAbcPo_2QY9z8p9EGSPAHA9v4R6JOHGoFwllA&oe=69CD2C9D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UHoutrIS9lMQ7kNvwFdPVJE&_nc_oc=AdrxFnqj5CBbw-h9swTgUKRYOfhRKVtH8T7PGqZfO-b22EzEFnfMzsuQszV8ZmU_Tpw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzdfVcVMQK4-cIXHZ53gm_Wuve9E2MgqTCGUNQMPwNkDA&oe=69CD2789"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zaVZaKI6FVcQ7kNvwGSS55M&_nc_oc=AdpXlFF698nn9UNCoRBJC11E6u45asc8XvEAYwXI2iQZGOiVnlm4Oo7qk-JFHWtp-AA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx1SFvuIOPEa-ZvE_HmLMpCNV-hpyM85EodrkxMN_M3yQ&oe=69CD186D"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OeeTTSXMR7kQ7kNvwFXIebM&_nc_oc=AdqJYjmDT9IgXwSRxTUvrVhT9iVo_5pNpzajtyBo7vnwKI5ueKoozAYpRAE5unb1cew&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzgMnzA57igr_WyeJNSvo5wlT8oQV-hvAm3eVS43qDpaA&oe=69CD055E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
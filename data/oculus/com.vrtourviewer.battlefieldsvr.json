5033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xCBEF5oYzioQ7kNvwEpFFBy&_nc_oc=AdpOS9jMQF20NZ2x_d3XiqPQEKPPGuzzin25oG0Ns1dX19u3Ku3RegWqdg-WT9G-g9Y&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDQWc5CzCWnJcvpc6LEvCsSDlGo5P1heRD2nK_5o4KKFg&oe=6A5A4169"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=skiBQ89LzTcQ7kNvwG6daWS&_nc_oc=AdqPxE-ycNsQojVKzuIoGLrewlfRoNb9p-QDMd14KAxpvNxxSE87RbxMGQ5B01aCErw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBBX4aWHSPG9Tl0CR3u_-nNhHqeWf3SqSRCiYDh-NNgRg&oe=6A5A3D1D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dMNAfDY9MpsQ7kNvwEwW1my&_nc_oc=AdqioZJ5pWBQPJOmbHIhcTBW45TnbnP9wufLsMyAStRYwl0FCYe_b50TMNhP2CXzJfo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCKaq16sN1XOMe-6akbXJpWijPoG_IGyD7PkBZz4qo63Q&oe=6A5A3809"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7DE-unMGnBgQ7kNvwH5uKnY&_nc_oc=AdpGgVUCiXt-tKNVmFRI9tzEffJKZxmbPsENrrEmFiMXSRiX7n6JJIp-MbNIEF0DwFk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCdwiRaOvLYXPdmKNh5tcnYSwgRsCh1UDhOEQnnZ77e0w&oe=6A5A28ED"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iFFHjpx78xIQ7kNvwF8GKOK&_nc_oc=AdqW0-dMfgNm8mWpj_8Ww15okrLsOAUfBLzLnolelSr_gErhnQpozIo_2hFzEn9GaFE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAYFbNG1OSCC43xmytBA3dsHMyNYlq7z468YfjsBdKI8w&oe=6A5A15DE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
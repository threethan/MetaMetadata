5033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=83OIztdU8tAQ7kNvwE3FVer&_nc_oc=AdpPVA4us2IbLrmTq1nt3mAYA_SqJS-EzCEOT6CCrdOvqPpTKZ946J3tJggCdhb-ufQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIG-WutXEWM6MS02f7gdml-9Vxqw0CrkdJHXiU23dZ8kA&oe=6ABE7369"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o-2fbX_Z6PYQ7kNvwH91Mb8&_nc_oc=Adq6ihaQQ7mztYzhgvVnUQFyEVD1FfRkBt8QhY_xEOacmCZeUbD-t2leh3bOZMJI5y4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYUSRBGdzAuVE8v4ZHWheMiaICMA6Zet1XJwItgu7Dew&oe=6ABE6F1D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kiZDYQ4ZDhEQ7kNvwGI8hKC&_nc_oc=Adp-Bg5N974_vS6WUF-H5arbeTEygJgdX-5refyXL-ljEFt3JEXLf2fsE4l_zfgcR48&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITvVTaiJf2mv9IZjGHUzgYUiVzO4Yu8ItMJGCFLf2IoQ&oe=6ABE6A09"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wOwGrs5UjsoQ7kNvwHv2IR0&_nc_oc=AdqD4O6OoSEKkNsX-PhjasttveqbkVYkI4R3CuS94yjzR6e588jdasIbycXr87OSTkw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJURj4Fwe8flqyOQg5vSqXBDRC2qxhPaK9mYnkaSvwdUg&oe=6ABE5AED"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MdnJvYbi22MQ7kNvwGkQTQx&_nc_oc=Adq4cci6MSzPi8YSVKgekNeGQDBF8ssk_Cv1jKhhaz3shreIT09HgZ0pcfgnDcdTbn0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIscxTDZJeTEX9MHywBMivKZPUDeOJm6e9fz8D6LDcFlw&oe=6ABE801E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
5033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fR4QFhUz8LMQ7kNvwGbDSz7&_nc_oc=AdotXXr_2vGDe9YokWN1n_6QbfLxLThkkKKv8BefM0DYWPKhH-PJwLWkRXJ5cdKPf-U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqviyYU_s8_g_4i-6uL1U2KryGTQ3cj26ay7ESiQfHuA&oe=6A95CD29"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OzlU_T5sFfQQ7kNvwEOFRb5&_nc_oc=AdqhQAEePB4Z7aRo0HpXpPxP1r2F408VM4QkY6H9ZUQf0n7e6AhSKq_d6sOmBfZRhQg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEFOySxXnIW6EB8kLxF2kn2sH5MP_TQ8Xlxp9UwUAxu3g&oe=6A95C8DD"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zO_7aiNxtAgQ7kNvwFE4Ho7&_nc_oc=AdqEGLxCnFPkZA3otocaFcglBbjhodLD4jyAf7Ks1sYx1tZR4SNalLsqKlUeS8YCwlc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQJJWRbSxVjf2o6dbsdQztEJShEhodNeLAYbPHhwss8w&oe=6A95C3C9"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5DERet96otMQ7kNvwEBXha0&_nc_oc=AdqeVydLxUScXBUDWkS8OTF5R5xIAkn9Mt9vlFlCsE-hZvzYtmGiWcsQJ5ECzreCIhI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyNGNrjjg2mAsdSeRm8axF9hmxRVXZTwYTG2Q5z3UjeA&oe=6A95B4AD"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o4pqkr-5GdQQ7kNvwHxu2-C&_nc_oc=AdoW8TyUVkYd7yGIJXDub4MRo_TkwjpwTuYjfIzFbXf-UZNL_hRGXD3SbBhpW8f0RwY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGw4ls31G76_7XT5wA7JWZrjrWUOy7gEO8ZFCNx7lgBEA&oe=6A95D9DE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
5033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xrLYm7EXNT0Q7kNvwGPAZN3&_nc_oc=Adp0t3WiqpkjoFF0ILyO4Fx0IFajd4jIAMbEpk49BQwREoq7v38zJZUyxpyls7uZ-Vs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7e62xr5OUweU4Y7FD376oYaNA3LPYwAGP2bJaGMHVd8g&oe=6A1EEDE9"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ZU4UaGpZfYQ7kNvwHgHiVa&_nc_oc=AdrZxp9QHuJO8VAYwzTBOhFTeOKGWCAXKbH-3OUM7OS2XbMifxsWSemSuOB1JbJBiSg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7E-BiRtTIS22pXW8scGnePFAODbkGlFuuq5L34jaAuCg&oe=6A1EE99D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WoKA6NTH904Q7kNvwFBQ5sV&_nc_oc=AdrjHsfYQds3Rd_eNz3ayQzpLyd7v-H4GoHOuZAyTDVzJffap2gEi7my-3sZhLDwrXE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4k-qAFB8Lqauqn4AJHZ_kr9y9wA8hqVGggBtYnqXutrg&oe=6A1EE489"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UEa3k77bixUQ7kNvwGWuips&_nc_oc=Adrt8WpOwhCc6WWUT_3X5nk1wcZRBwBET9v3gcctqco73RPv1sBwIdaEK2RQA4MotGU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7xpvwicKbCzhKxJ4-KlBNI4wfuw8Wdx_5E-5bp0y7puQ&oe=6A1ED56D"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=shIXjqfyL6UQ7kNvwH7xvL0&_nc_oc=AdpZqXdlhs_W0yKHRFR_NzjvdJ38H-HY66WeRjl1nnx-xsMzm3cFxIWQA5dtR2lOY48&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7D9UGa3LSN2A9_uPUSbYCf2WegjGPe8WznUVQpuEDLzg&oe=6A1EFA9E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
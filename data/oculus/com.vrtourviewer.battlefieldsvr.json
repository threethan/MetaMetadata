5033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o-AHtWGckRsQ7kNvwEde4VV&_nc_oc=AdodduPbd-zk1MV2rQ2VML5M5iNX_sYJuqWr3U9LPcSpI9TKUJ5h2BT1QdGMZ7KjLyM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBrpA4o1wCCOZZRBgqd_XaVabFeDuYPGyS7A27VNwqaFA&oe=6A491DE9"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DL7BPICjqd4Q7kNvwGKDOXZ&_nc_oc=AdqK4BsUMjtWwusagAvkPqbqA-7f_UQFKGV5j4fBd__B2ckU8XUQnmR5-5vbz2AU_iQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDm6wdQ4aauUt9SOMRi-yr00xNH28GPXGni-Yq8tnOIvQ&oe=6A49199D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aBNKZEEV2GUQ7kNvwEqg242&_nc_oc=Adruv_WkXuR5vTuH9ePYjvytrIiiIZICyeXhRGo2FM4qzBuJEuE7M7msT44FCEn6yRk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD295DNEhpuY13-YIbCe-B3AKdkBGf1cYBAP-4TxqrtUg&oe=6A491489"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yfi8XTtLvpQQ7kNvwG54h9M&_nc_oc=AdocMQTY3p-98jcWFyu9gwqfu6GXnYFDRwX6fxK6J8CKVy9IaO_pINW-bA9RdChkr_g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDM0UPEJ3G2RHak9Vp6CFxq00JpBqRBz-P3_HiDoU5CZw&oe=6A49056D"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4GOhPKtDUr8Q7kNvwEOVj9c&_nc_oc=AdpkBzH6h_oTx_N5JYiRshKBbHKLxb2LxI-yVma8McAUJzTWPHCvcmQaVZT6vIHZhPo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAo9DFpdq_1mzJD0JwAPz0afioPmDeZRg8tgRBT_5Es6Q&oe=6A492A9E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
5033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S3w_eZ2TWiQQ7kNvwFN3-0G&_nc_oc=AdoJqul36eNbxX8r5d-5XbBFoS6Ef8aeHE5KSDHusA0wqxS7mjBkGo3-qOm7aVXxwuQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOvlA4QIZNIRtmy-Wq5Bsx1RNG_EJHsHzQreYrUbnuwSQ&oe=6ACCF3E9"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gONHAHEYduMQ7kNvwHluNBX&_nc_oc=Adph7zuzyuhyVkPZxZ9N8BRaIkbssdfXH7vNI9hhBxJ4FPG4IiPCKyQMMUfpuVuIhjE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNmfnodY5mtc-AxXxBMnM5ZkQBlms-1182Oyy_gE-LfMQ&oe=6ACCEF9D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_-TJ49n6fGMQ7kNvwET7CPC&_nc_oc=AdopEUKh27SEztxbXVLJT12J15NYosRjm-tghgbzSh-FtlYcTTKVJq3Qin0ku9RpgNo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMs-qXqpXSh3njUonpmaMseeE6J9vZYHT_DSn9X0k4g5w&oe=6ACCEA89"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dkxZNVT6inYQ7kNvwEvDmYd&_nc_oc=AdryAdLp7wodfgLE2s2Qg_j7hIXX5WxjLoFkxOL_S4uBQthZzrpIgmq9Pzv_4ndfh1Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO4Gwi5zl_QMDmntfwgXLqD1YL7mszCzqO2Zi-6MjOUuw&oe=6ACD13AD"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p7qGO90XXFgQ7kNvwGe7nnR&_nc_oc=AdoSAewmk4EbkvO8HvlEDJXbKr9mLO61BkLyLux79gZWd9sapjk2Dw2qwfK1ysKgTtw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNzb8wCOb02H5RyWVOecX4pL-jLH4uNEZtKEcLHKac48A&oe=6ACD009E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
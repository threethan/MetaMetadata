5033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bTzfR0OMRxIQ7kNvwEIbJyx&_nc_oc=AdrfmJ7uRrHAm4IgEzLWeUaZJFbcOw5uKKviAO1_9YJ0cm1eX9KAEI4_t_kYVnrmlB4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjlE8gFYeZhB3icanI4hnCkP0JWPfFkrtl--1F7NvVIw&oe=6A9D7DE9"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G6G4Py1ULNkQ7kNvwECWUhz&_nc_oc=Adod6z6Y9AjeFJUHOkNU3DoMuUpqj3w0Ex_Rw54fOk93hpJJRwxVEqM45IUoIQFivMw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKiOK7DSgu4gZ2vwHBsjNTL80d0aTOLBzowKbDuNedzuQ&oe=6A9D799D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CBl3K664XFMQ7kNvwG8Zrn2&_nc_oc=AdqDZa9rmR1aY4jrrMK9eD7A94H3__mOH9hWx8igldJzS4ZyRfZbhrtfq_Ne4sHhmXc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNOzufhAvo75tpFpuf9DiqHmckyFBVGJEm-x33yVdWuA&oe=6A9D7489"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aIi8olva5MYQ7kNvwFfqh9z&_nc_oc=AdqKva5ZURou-Ob9SgVP_1V--HPp2hd6FlGed-nkywgSEhdovLT1TFM4GfLQ25_aX7s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0tOksUf1gGgQiD3Dtf-e5yl95qIgbIfuKoq5Sl0SyYw&oe=6A9D656D"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C0KvI1o6HY0Q7kNvwE4R8ie&_nc_oc=AdqLq6fdHpGjnkZ1a5yZoZ39IIXEj24g7DDeukmIYUqLrY12tuVjjGnJ641B32W-LNM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpFhH2KXmEMwp-m_be3PLBwYwBkJ0A4qfePHh-RH2SZQ&oe=6A9D8A9E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
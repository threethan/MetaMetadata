_oc=Adkj5LYBoqUpapZdWoHPUE2qQ5fbdv_LAHqXtDp76_LmAbjSZrsrSDqDGRibe4wCSOM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftXD2QZigOnbaWEs3jUUkXIyaVHhAdiNg21p1hjX-jcOA&oe=699ED429"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HSLXL0PMINgQ7kNvwGWhxF3&_nc_oc=AdkFAmWp2CZzqGCGfCC23l9ypbSoWPGjfRSLPmaeF5_0hNMgeUSAX7D8tvYuNP3MhU0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftyCfOzvzxU-WlMIVTGQKt_x5hAvo2ndWYfvSMLM1Ljkw&oe=699ECFDD"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GOSUFCXWuWoQ7kNvwGwbfyH&_nc_oc=Adm6Qz0xkgvJ3GgYLdReqeADTRSoDzNVZu8tRyn17Ag_za_50BOBlXvasa_eC637k5o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvijYtXbTvReuG0F0FqXB5pyNxMva-Ooe8hQVpx90sTkA&oe=699F0309"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YOqKFrkr1fQQ7kNvwE3KERE&_nc_oc=AdkuDqQ3QahEDog8ENqE05pZSCyvghPbF_YWT_MztxEk7yhgijcUuHcTh_vihyK16MY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afs_mv0A1F1kzOgKcGLSU2HikRwi34iAxC8lusWGh4BCpw&oe=699EF3ED"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ia7k--N_wUAQ7kNvwEILkMK&_nc_oc=AdmR-a_XjMoUdwoFIdnNoPLYm3cQTjrj1oUkbB3uSJHPb7zag9G1py8ampm4P7Eqb4U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuN00g6I5UPXwKSvt-vMW9k50N0oKW67k3TekxHpACQew&oe=699EE0DE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING
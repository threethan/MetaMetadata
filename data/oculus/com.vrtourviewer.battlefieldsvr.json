5033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CGGZjos4VbEQ7kNvwHt-ng5&_nc_oc=AdqzVIDtH3xIMBmTMfvVdc41etMZPrLccR2P-tOUBI7Ou9bAOCTx8hvnsrlB7iOBC30&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKsdBpu3wFAXWdQxAn8gxB025BDvGDCsw0A2lib4N5SjA&oe=6AA566E9"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2PNWe3ZtYlkQ7kNvwGeMm1l&_nc_oc=AdrDegFIq7iNIn2M6Bl3HSWr0rZWYUkCaHXf9P61aS4n5pcZJU2eJhQTBQxiByQq_XY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxTWTKo-jBbuXY_B5MQdw9wXPtCrdJDHw6SCkXRsO37w&oe=6AA5629D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o229f0Zy7aAQ7kNvwGCb0cR&_nc_oc=AdqR4NiorydImpfvYYSxDbLxSUG7DhaxhN177vZ6wq_UHR4xCpjm9hk1yJLpyQ6zk4c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjmJlMyV3-P9ULTd8j6cf96lq7r1otYFQArv4cMKT9pg&oe=6AA55D89"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZlcvQ8wCHnoQ7kNvwF9VLC6&_nc_oc=AdoqXJbuEQ5T97gsgm3A3VEXG0Jfvkww7Kz3XwTdd_2qiPMmgidcOQrKxTxdBXMmGMo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIEJN8cP6j7eUo0Z5h6MQTGcYuCDK6akDC4FVT2YakCzg&oe=6AA54E6D"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1xb4w76DQTkQ7kNvwFEpP9V&_nc_oc=AdqsiDgYxNoR8LTe9xjzAdO1M_oLOngU2pAyazgFdpx85IF8yJNq8GDdY0DpuYhi46A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCpBGaYcyYoOVkkVP8Q1dkb2M3u2uU6LUmgQzudQ3deg&oe=6AA5739E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
5033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LZ1FRXA6Yl4Q7kNvwE9ff2p&_nc_oc=Adp-LHhtq4m0sRK4YoEJ1WGaQaCOgXrUhyYNWbJ2lBRYLcWb99UVMuhEaXP4nrhZ088&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1VnQzH1jdoIRactaZsnh6ZwTxpyjAABScdzs6duKPNlw&oe=69D7BCE9"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0WldSfs1nJMQ7kNvwE1YQ3Z&_nc_oc=Adoo9kbOe-4YhE_ZCxUrhGcpeuhnCCmdZdbYyJbSheox8nUYu-ykI0qeARTZxjO9_GI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0YSG3Tqz8d-zZIqnlCfLITYiPsfjj411fzHO5XIAtcEg&oe=69D7B89D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NpcDnsgP1AQQ7kNvwEWSSaO&_nc_oc=Adph66Jk359WkO4WUorwPbTaqdvpXHWrvLNdoFvAp0D5xFDhdUw3VgflKUT-87vcJx0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ucn_N0AoIWHJMLG4g1QqEYfCQXKvc4lPV9ZPJpsqRtw&oe=69D7B389"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ktnJR8RugiYQ7kNvwHcPKRz&_nc_oc=Ado6Ig3N6wZUg2_3roogw23av7_TSijXeW8sPinpOfOUXoCKmMDiJraNOmYInF5wizA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0hf3L146HwE34L1aLU0cfYzcJ_cm_3jSTdwviTVo34DQ&oe=69D7A46D"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mMd8e2aED24Q7kNvwHA8O37&_nc_oc=AdrtrZgTLOrCEisqW_keuYz21BDjpQjXba4odMr4rEI8r0vGK9NjTsuoOe17_j6v8ps&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af36dUn7bUA-FSrPztatzVScwjRdlmXHoOMRdCNsTqPB0w&oe=69D7915E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
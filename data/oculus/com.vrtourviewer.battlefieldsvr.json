5033733_1291297079182360098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vl10k4jBFc0Q7kNvwG73_mL&_nc_oc=AdruCHdPy8Pj9yN33AQgPXw89EkIM9MzOYtVzW8c1OCXuyRF-EP1sqh56ZgCAg9hP8c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhgnNkaL0wWcDpb3ZLr6ZELsNwmbnIovSvVJqP7Y65_g&oe=6A5E35E9"}, {"file_name": "2_GW_Crossing.png", "id": "938933307946845", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035368_938933311280178_3413123613244023510_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RlsXB75Qr6QQ7kNvwGe6QXI&_nc_oc=AdoYHiC9qVGt_YWwsxGyg9aallAKFfS6R9elTQb9BAdz1hvO7dqzYOv-MVfHEviA1sw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAod8g_ls2qNo4xOE9w28T855I1M5ctBSIDUj5mb6QAZg&oe=6A5E319D"}, {"file_name": "3_1812.png", "id": "1331033787538823", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984468_1331033790872156_199531194759712732_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d-4ZJYDzUrgQ7kNvwFcjVxv&_nc_oc=Adrg2DpQoKfF7mNwGl6nH7Uhif0TCBWJ0OuTam9X4l0uA7mGbr6xKh9oT1qfDF-Uyw8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDSuFZUjSYEsxX49TurzMdEThYZcLKmTHXaqJ_7tMDkFw&oe=6A5E2C89"}, {"file_name": "4_Shiloh.png", "id": "1326526088041109", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75221331_1326526091374442_5826335678387933618_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vkOUgkEL-pMQ7kNvwFXlaCQ&_nc_oc=Adq2k1c04qeW8DFO-2UsdIkL4j7C7VUT7upgzbBMXdUiCEruUjH9eF_-U1uLk4glQ48&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBL7Slo2k95-6U6hniPf0C9uLQ_MTTS-XMrTLFFL2QUwQ&oe=6A5E1D6D"}, {"file_name": "5_Burnside.png", "id": "3171180953016240", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031587_3171180956349573_4188897667472489614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y25vhkTHQB8Q7kNvwGdSyy0&_nc_oc=AdqwQxT3gQs2ksuIRIZnykVE8bza1goFnKgmk8wukybz-fj6SKCFXHD1fSlZi5McCfI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDlR3jhtxLBnpvOWpsJk6yefGy4Gi8ajqEeKBK48hNoJA&oe=6A5E0A5E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Battlefields in VR", "keywords": [], "long_description": "Immerse yourself in the epic saga of American history with Battlefields in VR, the groundbreaking virtual reality experience from the American Battlefield Trust. Explore the pivotal landscapes of the American Revolution, the War of 1812 and the Civil War like never before.\n \nFeatures:\n\u00b7         Discover over 140 immersive scenes from 40+ battlefields and historic sites, all from the comfort of your own home.\n\u00b7         Experience breathtaking modern 360-degree photography that transports you to the heart of each location, bringing history to life like never before.\n\u00b7         Visit legendary battlefields such as Lexington & Concord, Washington\u2019s Crossing, Yorktown, New Orleans, Charleston, Gettysburg, Antietam, Manassas, Chattanooga, and many more!\n \nWhether you're a devoted history enthusiast, a curious student or simply captivated by America's rich heritage, this app promises an unparalleled journey across the most sacred landscapes of our nation.\n \nDownload Battlefields in VR and embark on an unforgettable journey through history today.", "short_description": "Get Lost in the Landscapes of American History!"}]}, "developer_name": "HULLFILM", "developer_privacy_policy_url": "https://hullfilm.com/vr-app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "HULLFILM", "support_website_url": "https://hullfilm.com/about-us/", "website_url": "https://hullfilm.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommende
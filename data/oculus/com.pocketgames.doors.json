560355399279056", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031474_560355402612389_7593154677209284784_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LEHbNUKDWxoQ7kNvwE6numv&_nc_oc=AdkHeGis2TRsu0cgS4sWZwleHQSCS-2mEA_wfsipRSFNRBd2RD6UCaHpl1uBc4QLEQk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwC03Jt1nChJ_uNilZjnMOUhkeIq2Y7LidlQuCXI9M5Pg&oe=69B95F89"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_ImpossibleDoors_2560x1440.png", "id": "548223044031667", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974830_548223047365000_5431885981916940141_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IRWno6TocC0Q7kNvwEWfmn4&_nc_oc=AdnT319uPFZYByDBhAIVtJ3b_5U3EfTbx3C9fZvYYw8xfNAPs_WXsx-cpzWwb6DOrmg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxyWr6UdelNY3vPzVEuQNZ029p5fJ2Mw6tNRQ6cgEe-7A&oe=69B94882"}, "display_name": "Impossible Doors: Can you open them?", "keywords": [], "long_description": "The most obvious solutions are not the way out.\n\nImpossible Doors was designed to get you thinking outside the box in the shortest possible time. Entertain your friends and family as they try to solve puzzles that might look easy at the start but are seemingly impossible to solve. If that doesn't get them, mini-games like basketball, Nerf guns, and paper toss will. If you're expecting a 2-hour solo game, this probably isn't for you. However, if you plan to entertain your friends and family or want to draw a crowd, this is the perfect title.\n\nKey Detective Features:\n\n10 levels of puzzles\nMini-games to earn coins for clues (basketball, paper toss, Nerf guns)\nMore levels coming...\nKevin MacLeod (incompetech.com)\nLicensed under Creative Commons: By Attribution 3.0\nhttp://creativecommons.org/licenses/by/3.0/", "short_description": "The most obvious solutions are not the way out. Impossible Doors is designed to get you thinking outside the box in the shortest possible time. Enjoy these tricky levels!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://orangenose.notion.site/Core-Loop-526683c3424d473e8981689fc63f2b9b", "developer_terms_of_service_url": "https://app.getterms.io/view/wAH42/tos/en-us", "publisher_name": "Core Loop", "support_website_url": null, "website_url": "http://www.coreloop.fun/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7911962568857851"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PENDING", "id": "1676622209674885"}, {"status": "PUBLISHED", "id": "948985519885235"}]}, "baseline_offer": {"id": "948985519885235"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 0, "status": "PENDING", "id": "1676622209674885"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7932579190129522", "version": "0.0.5"}, "id": "503747834965997", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5703497526371044", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "7932579190129522"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "503747834965997"}]}, "change_log"
_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RwoRb0IDqC4Q7kNvwGWpX4S&_nc_oc=AdoPTsr2SpVLZpZaRK6Xa94k4QeqrezEEGZkbOYpY6rhU_wdu3UZPi_YlAauWtK8dwM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfuPhMll5azhptNdSU7_6sTrBXWDVRqcD3ZfMZDz1Ybg&oe=6B0705FB"}, {"file_name": "Screenshot_ImpossibleDoors_05.png", "id": "560355399279056", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031474_560355402612389_7593154677209284784_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ZVuWyA_bDUQ7kNvwF5AjTT&_nc_oc=AdpxxZ8x-hZuWt9KeSkeA9gHs23seCcFHCFsFZVwxe9BO3w_aoRM5xbaWiRXQWuytpE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5iL8iWLKlIIHYvdErb4FR_lwreGBB6SGZ2hF9LCRCUw&oe=6B072349"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_ImpossibleDoors_2560x1440.png", "id": "548223044031667", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974830_548223047365000_5431885981916940141_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NGi78lMkw-UQ7kNvwHOG_e1&_nc_oc=AdrAKxfGbTf22c2TqEmWkY_ztE8DlEDj9CSkmrOjFvz6IwKlJV47WpdnZyyWJS-Hcu0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSS3jHPM2Nd9BKUBAiqtnxCSxJMy_HxwbUnjZWre072rw&oe=6B070C42"}, "display_name": "Impossible Doors: Can you open them?", "keywords": [], "long_description": "The most obvious solutions are not the way out.\n\nImpossible Doors was designed to get you thinking outside the box in the shortest possible time. Entertain your friends and family as they try to solve puzzles that might look easy at the start but are seemingly impossible to solve. If that doesn't get them, mini-games like basketball, Nerf guns, and paper toss will. If you're expecting a 2-hour solo game, this probably isn't for you. However, if you plan to entertain your friends and family or want to draw a crowd, this is the perfect title.\n\nKey Detective Features:\n\n10 levels of puzzles\nMini-games to earn coins for clues (basketball, paper toss, Nerf guns)\nMore levels coming...\nKevin MacLeod (incompetech.com)\nLicensed under Creative Commons: By Attribution 3.0\nhttp://creativecommons.org/licenses/by/3.0/", "short_description": "The most obvious solutions are not the way out. Impossible Doors is designed to get you thinking outside the box in the shortest possible time. Enjoy these tricky levels!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://orangenose.notion.site/Core-Loop-526683c3424d473e8981689fc63f2b9b", "developer_terms_of_service_url": "https://app.getterms.io/view/wAH42/tos/en-us", "publisher_name": "Core Loop", "support_website_url": null, "website_url": "http://www.coreloop.fun/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7911962568857851"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PENDING", "id": "1676622209674885"}, {"status": "PUBLISHED", "id": "948985519885235"}]}, "baseline_offer": {"id": "948985519885235"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 0, "status": "PENDING", "id": "1676622209674885"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7932579190129522", "version": "0.0.5"}, "id": "503747834965997", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": fa
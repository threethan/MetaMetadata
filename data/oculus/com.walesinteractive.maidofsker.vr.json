JUW6yFtA&oe=6A806675"}, {"file_name": "MOS_Screenshot_05.png", "id": "736657509427199", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499303116_736657512760532_3787353401354777260_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CU33tCFf1NcQ7kNvwEYD9kr&_nc_oc=AdrBcT13yaUKZk3E-MBsvd-3wpyhZcE59DMxQFCs3Ii1hEuFvQ2iCqXKHNIuoaLu-Pc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEsz0yEIqEoCpLRhcp5CE0_0Y58g3k141lJpJ3mHCVA-g&oe=6A805EC8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MOSVR_CoverArt_Landscape_2560x1440.png", "id": "833311606052129", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491820980_833311609385462_3071336568594115766_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=srHEZER5IV8Q7kNvwGDyLgY&_nc_oc=Ado0EyYu108aioBTgiRWFDWzvY10QcKUMUE799RFdAunMtKE7kUnpDEve0ahAOEFJNY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEaokpX4XeY-C1Yqv-jkYtrJ5Bz6w7E2ZTd27DRtPfU-A&oe=6A804F34"}, "display_name": "Maid of Sker VR", "keywords": ["sker", "horror", "survival", "scary", "fps"], "long_description": "Brave the nightmares of the Quiet Ones. Do not panic\u2026don\u2019t even breathe!\n\nMaid of Sker VR is a first-person survival horror, set in a remote hotel with a gory and macabre history from Welsh folklore. Armed with only a defensive sound device, you\u2019ll utilise stealth tactics to avoid death amongst a cult of sound-based AI enemies.\n\nSet in 1898 and inspired by the haunting Welsh tale of Elisabeth Williams, this is a story of a family empire driven by torture, slavery, piracy and a supernatural mystery that suffocates the grounds of the hotel.\n\n", "short_description": "Maid of Sker VR is a first-person survival horror, set in a remote hotel with a gory and macabre history from Welsh folklore. Brave the nightmares of the Quiet Ones. Do not panic\u2026don\u2019t even breathe!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.walesinteractive.com/privac
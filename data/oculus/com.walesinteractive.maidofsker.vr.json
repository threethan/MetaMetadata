sI9jf8642zfrViC-VSYX1ibPS4kH_VUfykpb-KRhM4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1syhiJ902ORT8o3bPVqM85zALv6yWRcLP5mL0G8P_V2A&oe=69F0AB48"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MOSVR_CoverArt_Landscape_2560x1440.png", "id": "833311606052129", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820980_833311609385462_3071336568594115766_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mb3K13qO2_EQ7kNvwE4txFr&_nc_oc=Adpt7lutkZCOnQ-F8-h_Y_f4-juS1AMv1wfX99SLWtzTsUNu7TAR5OOXfdyDAl8jRGA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0DVhW4Gct5IIY-Ck7A4aCbR2iYwi4FyrUfwBMAWpn9lw&oe=69F09BB4"}, "display_name": "Maid of Sker VR", "keywords": ["sker", "horror", "survival", "scary", "fps"], "long_description": "Brave the nightmares of the Quiet Ones. Do not panic\u2026don\u2019t even breathe!\n\nMaid of Sker VR is a first-person survival horror, set in a remote hotel with a gory and macabre history from Welsh folklore. Armed with only a defensive sound device, you\u2019ll utilise stealth tactics to avoid death amongst a cult of sound-based AI enemies.\n\nSet in 1898 and inspired by the haunting Welsh tale of Elisabeth Williams, this is a story of a family empire driven by torture, slavery, piracy and a supernatural mystery that suffocates the grounds of the hotel.\n\n", "short_description": "Maid of Sker VR is a first-person survival horror, set in a remote hotel with a gory and macabre history from Welsh folklore. Brave the nightmares of the Quiet Ones. Do not panic\u2026don\u2019t even breathe!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.walesinteractive.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Wales Interactive", "support_website_url": "https://www.walesinteractive.com/contact", "website_url": "https://www.walesinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "274332603
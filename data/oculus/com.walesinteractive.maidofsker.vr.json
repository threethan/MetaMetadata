28dQzcTw&oe=69D10EF5"}, {"file_name": "MOS_Screenshot_05.png", "id": "736657509427199", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499303116_736657512760532_3787353401354777260_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N2TSse6NRPoQ7kNvwEXmX2b&_nc_oc=AdrlyB-e86r22KgFvJCUDkhyuKa1YxPQrGMiClsFWD_qVOs0E59da9tmSLsElAM8BNk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxOTAAeHXZBBsuSV01gJwnrHM8Q8vueooXQoPmzD7uLSg&oe=69D10748"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MOSVR_CoverArt_Landscape_2560x1440.png", "id": "833311606052129", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820980_833311609385462_3071336568594115766_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DX9JFtooyNAQ7kNvwEoxCC9&_nc_oc=AdqWI9yNpCMMmiCuFjnuNmCo7pqsLNbiTUXcMv1S4z9f3gdwcrWVkSoJCz5TCxh3kKY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxFTSa_wpGo1jSHsk1XiWs3oDFKLo2HG2zo9NBiizLTcw&oe=69D0F7B4"}, "display_name": "Maid of Sker VR", "keywords": ["sker", "horror", "survival", "scary", "fps"], "long_description": "Brave the nightmares of the Quiet Ones. Do not panic\u2026don\u2019t even breathe!\n\nMaid of Sker VR is a first-person survival horror, set in a remote hotel with a gory and macabre history from Welsh folklore. Armed with only a defensive sound device, you\u2019ll utilise stealth tactics to avoid death amongst a cult of sound-based AI enemies.\n\nSet in 1898 and inspired by the haunting Welsh tale of Elisabeth Williams, this is a story of a family empire driven by torture, slavery, piracy and a supernatural mystery that suffocates the grounds of the hotel.\n\n", "short_description": "Maid of Sker VR is a first-person survival horror, set in a remote hotel with a gory and macabre history from Welsh folklore. Brave the nightmares of the Quiet Ones. Do not panic\u2026don\u2019t even breathe!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.walesinteractive.com/privac
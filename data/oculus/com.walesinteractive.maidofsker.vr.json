wmynNi1Q&oe=6A95B6B5"}, {"file_name": "MOS_Screenshot_05.png", "id": "736657509427199", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303116_736657512760532_3787353401354777260_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UZHUX2hfreQQ7kNvwHfVC0B&_nc_oc=AdoMPAG5AMhMXUx25a7sNbOkMornTnq3k2A-1-l4RdxXYAEu04UD_lzsy-s5M-K5eLs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7TYuN_CMbDWzlkl_GtJQc7xMnOlsYR7yWMdWNA-kpjA&oe=6A95AF08"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MOSVR_CoverArt_Landscape_2560x1440.png", "id": "833311606052129", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820980_833311609385462_3071336568594115766_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0T3wmuD_r7EQ7kNvwE4zi-p&_nc_oc=Adr-DDzq9jREDL-Z_5GvnGR-f9HX6r50e1kap2Y-APzQNq2Y_qZBoVYxDG-ao-6OGmY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG8i_XSYZs45lBSKWYwH1u6M0QKYDQ_XlLlESJMqJPtGA&oe=6A95D7B4"}, "display_name": "Maid of Sker VR", "keywords": ["sker", "horror", "survival", "scary", "fps"], "long_description": "Brave the nightmares of the Quiet Ones. Do not panic\u2026don\u2019t even breathe!\n\nMaid of Sker VR is a first-person survival horror, set in a remote hotel with a gory and macabre history from Welsh folklore. Armed with only a defensive sound device, you\u2019ll utilise stealth tactics to avoid death amongst a cult of sound-based AI enemies.\n\nSet in 1898 and inspired by the haunting Welsh tale of Elisabeth Williams, this is a story of a family empire driven by torture, slavery, piracy and a supernatural mystery that suffocates the grounds of the hotel.\n\n", "short_description": "Maid of Sker VR is a first-person survival horror, set in a remote hotel with a gory and macabre history from Welsh folklore. Brave the nightmares of the Quiet Ones. Do not panic\u2026don\u2019t even breathe!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.walesinteractive.com/privac
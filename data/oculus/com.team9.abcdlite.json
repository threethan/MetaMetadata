H_OiysOxaPGyIileOSyzfP4oerqg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDoIHtnifdug3ieK29K9Y8n4pJJxGj8So7xzC94xkhzJA&oe=6A4FA20B"}, {"file_name": "Still 3.png", "id": "830974549700261", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818885_830974553033594_4396299903776021267_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rATRzpGzJLwQ7kNvwFhtz8q&_nc_oc=AdrPE9z_6LwgRNvHZcTu_ZLgXck8p_eEet0qKjZOkHqXjGYtK-x8hQWDn1fpCfwz7HI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDIM3VB-dJndsUU-dxjmWEykqIz2xLiwUzTGR88TsPqLQ&oe=6A4FABAB"}, {"file_name": "Still 4.png", "id": "3811531058979944", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818860_3811531062313277_4803446781348276368_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qhXnqxBo7jwQ7kNvwFQH9Wb&_nc_oc=Adqs-xpxkrrmsZ5S3pLW_EJTNb60yQjUad6vjLaNm3KLGmkW4iIGH6WcrIwsQ8t1Nyk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC2RR4ONmQx_TkKCr2d_gtK97MOXMOxxODpBO_V4dxCkA&oe=6A4FA769"}, {"file_name": "Still 5.png", "id": "1386987132956435", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819854_1386987136289768_2275216444642195183_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0bsXsbiDnv8Q7kNvwF_1lTS&_nc_oc=AdqCxGU7Lkxd3JTPseHghwKB_j6e9vXJX1vQ0fn3rSPq11gO0K7zdNDgLHN-9k1_EqM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB_uEQYhMwBMt4FJUh19bee9WihlBwL3jf5bMf7sTDKjQ&oe=6A4FB106"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "A Black Climbing Dog", "keywords": ["climbing", "platformer", "challenge", "movement", "animals"], "long_description": "Reach the top, one precise grab at a time. ABCD: A Black Climbing Dog is a challenging, skill-first VR platformer where you play as a nimble black dog scaling floating courses with arm-driven jumps and pinpoint holds. Every run tests your timing, routing, and stamina. No gimmicks\u2014just clean mechanics, tight controls, and the rush of sticking a hard sequence.\n\n{1386464659600739}\n\n**Key Features** \n**Pure climbing, pure challenge:** Arm-powered movement with deliberate jumps, momentum control, and precise hand placement.\n\n**Course variety:** Short, focused routes to marathon ascents\u2014find your line, master checkpoints, and chase the summit.\n\n**Learn, fail, master:** Bite-sized attempts and quick resets make hard sections approachable and addictive.\n\n**Leaderboards and times:** Race friends, refine routes, and push your personal bests.\n\n**For climber brains:** Designed for players who enjoy tough mechanics and real skill progression.\n\n**Comfort options:** Adjustable vignette and snap/turn settings for intense movement sessions.\n\n{1311921787616827}", "short_description": "A skill-based VR climbing platformer. Leap, grab, and scramble your way to the summit as a determined black dog. Tough routes, precise movement, huge satisfaction. Unless you fall of course."}]}, "developer_name": "Team9", "developer_privacy_policy_url": "http://arianestudios.com/abcd-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ariane Studios", "support_website_url": "https://discord.gg/ZVEW8Tr88E", "website_url": "https://www.arianestudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "459781504968480"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25381527278177
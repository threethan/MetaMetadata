AQThB1Ttwy7i5dcXyj6KCR7VZXgsfAR_Kp1WqRyIPuNVJw&oe=6B01D4CB"}, {"file_name": "Still 3.png", "id": "830974549700261", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818885_830974553033594_4396299903776021267_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GTd1VwF0JpoQ7kNvwErBtL9&_nc_oc=Adqdgy8m70ZzEftGoF9NCam9GdvxiAKA_EuROEEOrXbEu7f3xgubzmiJ5FoqGEz0xbM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqx4oImnTnf4SP1WJOmQ-ZCOOxYwvMU6eBC1gupPZ_ew&oe=6B01DE6B"}, {"file_name": "Still 4.png", "id": "3811531058979944", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818860_3811531062313277_4803446781348276368_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-aZ42t9T3qIQ7kNvwFmGw_G&_nc_oc=Adp5B-7rpT3tB0wdaF933dsCzwBb3C2K7r2DEgptbW-v9nhcI0ltxHo6AzTPxzHXj9o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwotqsOCVfmIvLmVKRobWAiouYaAt_1vuMSaiRnuH7mQ&oe=6B01DA29"}, {"file_name": "Still 5.png", "id": "1386987132956435", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819854_1386987136289768_2275216444642195183_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AYYrk2hVPTcQ7kNvwH9GXG_&_nc_oc=AdpqNYeMpbk5yNs83gkirYHLE4Wt1Qn2Fx86ATqV0VgknDQ6Zt02SySOLrhAK3Gz1KM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSt0mD-Q74lTRjPg9n1gCJeMeuBUT69o40nypisMOB0Q&oe=6B01E3C6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "A Black Climbing Dog", "keywords": ["challenge", "climb", "animal", "hard"], "long_description": "# **Climb to the Top as a Canine Companion**\n\nYour beloved human friend is trapped at the top of a perilous tower, and they need your help to reach safety. As their loyal canine companion, it's up to you to move like a dog, bark, and jump your way to the top. \n\n{1386464659600739}\n\n# But be warned - if you fall, you'll have to start over from the beginning, so tread carefully! \ud83e\udee8\n\n{1311921787616827}\n\n# **Unleash Your Canine Abilities**\n\nJust like in Gorilla Tag, use your arms to move around and jump. But this time, you're a nimble, four-legged dog, not a monkey or a cat.\n\n# **Bark to Boost Your Jumps**\n\nLoad up your dash by using your voice, then channel that energy into powerful leaps with the triggers. There's no obstacle you can't overcome with your canine agility.\n\n# **Collect Souvenirs Along the Way**\n\nYour human friend has left behind special items for you to gather as you ascend the tower. Fetch them all to prove your worth as the ultimate good boy.\n\n# **Conquer the Tower, Again and Again**\n\nThere's no save system here - if you fall, you'll have to start from the beginning. But that just means more opportunities to refine your routes, race against friends, and push your personal bests to the limit.\n\n\n(EN) Supported by TAICCA and the Taiwan Ministry of Culture as part of the 2025 Innovative Co-production: VR Game Early Access Production Program.\n\n(CN) \u672c\u6848\u7372\u6587\u5316\u5167\u5bb9\u7b56\u9032\u96622025\u5e74\u6587\u5316\u79d1\u6280\u5167\u5bb9\u570b\u969b\u5e73\u53f0\u5546\u696d\u9a57\u8b49\uff1aVR\u904a\u6232\u958b\u767c\u8a08\u756b\u652f\u6301", "short_description": "You're a black dog! While playing video games, your hooman best friend has been thrown at the top of the weirdest tower there is! Your goal is simple: get to the top of the tower to save your friend. But it's not going to be easy!"}]}, "developer_name": "Team9", "developer_privacy_policy_url": "http://arianestudios.com/abcd-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ariane Studios", "support_website_url": "https://discord.gg/ZVEW8Tr88E", "website_url": "https://www.arianestudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"},
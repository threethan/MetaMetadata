bdxeRTvQo-lJrxbQNgvwOJmw&oe=6A36958B"}, {"file_name": "Still 3.png", "id": "830974549700261", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491818885_830974553033594_4396299903776021267_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aQflbrefRVcQ7kNvwGiUHAW&_nc_oc=Adq9fxSAC5mtA1VlJAvKQgdFgYuyFXd9qPqCd9BBHOP1BUwMsZ8H_BRtBANkWi75HrI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-SLNXJCoLvnSfTC9GxoOCjvoobiKZIC7iTIzcpAc300g&oe=6A369F2B"}, {"file_name": "Still 4.png", "id": "3811531058979944", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491818860_3811531062313277_4803446781348276368_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QPjylr5DFqEQ7kNvwHGV3oz&_nc_oc=Ado5c-NNbJlVNYgIlLRBF6DlYkOB26VLzZY9bWWOF2lBVzmdIK7svJo7a3f3YffGSBA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9QBpyIp5zWjr6EtAUabBO-2kyWvOPT2j5LboWrRuDBnQ&oe=6A369AE9"}, {"file_name": "Still 5.png", "id": "1386987132956435", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491819854_1386987136289768_2275216444642195183_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0d-5FRQIjUYQ7kNvwEup-N2&_nc_oc=Adp-UIydqyK97kms1qyY1Ua_0_V7z6Unw0iwfb9wwMdnqesJSiG_OwL5CbEX0AyMH9A&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_vAw3pu-M1x0VTJHkvn559U6Ke6ouTOGPeTym8zA0obA&oe=6A36A486"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "A Black Climbing Dog", "keywords": ["climbing", "platformer", "challenge", "movement", "animals"], "long_description": "Reach the top, one precise grab at a time. ABCD: A Black Climbing Dog is a challenging, skill-first VR platformer where you play as a nimble black dog scaling floating courses with arm-driven jumps and pinpoint holds. Every run tests your timing, routing, and stamina. No gimmicks\u2014just clean mechanics, tight controls, and the rush of sticking a hard sequence.\n\n{1386464659600739}\n\n**Key Features** \n**Pure climbing, pure challenge:** Arm-powered movement with deliberate jumps, momentum control, and precise hand placement.\n\n**Course variety:** Short, focused routes to marathon ascents\u2014find your line, master checkpoints, and chase the summit.\n\n**Learn, fail, master:** Bite-sized attempts and quick resets make hard sections approachable and addictive.\n\n**Leaderboards and times:** Race friends, refine routes, and push your personal bests.\n\n**For climber brains:** Designed for players who enjoy tough mechanics and real skill progression.\n\n**Comfort options:** Adjustable vignette and snap/turn settings for intense movement sessions.\n\n{1311921787616827}", "short_description": "A skill-based VR climbing platformer. Leap, grab, and scramble your way to the summit as a determined black dog. Tough routes, precise movement, huge satisfaction. Unless you fall of course."}]}, "developer_name": "Team9", "developer_privacy_policy_url": "http://arianestudios.com/abcd-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ariane Studios", "support_website_url": "https://discord.gg/ZVEW8Tr88E", "website_url": "https://www.arianestudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "459781504968480"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25381527278177728"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1988843245323655"}, {"status":
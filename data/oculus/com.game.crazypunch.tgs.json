tent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1N8e4WprhISgcSX2ZHvitl9Xn0RSpxvdXdgtq__716QQ&oe=69E23F75"}, {"file_name": "CrazyPunchVR04.png", "id": "1520678485679019", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491823905_1520678489012352_4213708511349902823_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hcxBc-4cMw8Q7kNvwHRKH1G&_nc_oc=AdpKbo-MaO2BHpYjU0jacafCLz7dayOhe8eIJXgF2uw-Q8QwpmbmiAgn8itZLcoZlJE&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2eyixuFehltv2uH5N2DQtE4d_0Oob9bVQQx3QTPLSPsw&oe=69E23811"}, {"file_name": "CrazyPunchVR06.png", "id": "1326615032829234", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/491828028_1326615039495900_972954419969622900_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wRXbjdSSFVoQ7kNvwFX-TB4&_nc_oc=AdpESRE8TKSG-UJSG8KWDgPqPEbFtrGm12PMyMRVWVVhMDLiiC5EZyrUkyBpvvTynns&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0CgTwrBYWh4cOcxgOznkDJmxYdpk6a-sVPpezbPOsqFw&oe=69E23EF2"}, {"file_name": "CrazyPunchVR05.png", "id": "1942916653286131", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491828028_1942916656619464_1426682885452854030_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XCLnOStQp3IQ7kNvwEbhCtp&_nc_oc=AdpjUnL4_7F7c9kSLxGTjBU9I_hTmzR5mEYKmVeYzYuu-nMLtykJ-2V4ZqZplWYWirQ&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1_HG7PAiVT3rdFOjpoYIhL75uL-MEGWFTpai5H4ZpADQ&oe=69E23D25"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BG2560.png", "id": "842491838812206", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/491818860_842491842145539_7523562580354491068_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wpk6tbzBAeMQ7kNvwFdKeju&_nc_oc=AdozYR9eSbAAWAtmOE2EMRQzM5IZ_0uBY2xhYEEKO4aTKEdkc8f8ctV0Uf-AZS27UhU&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ygnWGS0-yCWJ0Ki2u2vtXodRS2erlET4zylcgJeYneA&oe=69E24147"}, "display_name": "Crazy Punch - Fun Game", "keywords": [], "long_description": "# Get Ready to Rumble in Crazy Punch - Fun Game!\n\nLooking for the ultimate way to de-stress and have a laugh? **Crazy Punch** brings high-energy, physics-based mayhem straight to your Meta Quest. Step into the arena and unleash your fury on goofy dummies, mimics, and wacky objects in a world where the laws of physics are designed to make you giggle!\n{766238139859150}\n### **Why You'll Love Crazy Punch:**\n\n* **Hilarious Ragdoll Physics:** Every hit triggers unpredictable, \"giggle-inducing\" reactions that send your targets flying in the most ridiculous ways.\n* **Satisfying VR Interaction:** Experience immersive haptic feedback and comical sound effects that make every punch feel (and sound) amazing.\n* **Endless Variety:** From classic practice dummies to strange mimics, there is always something new to knock around.\n\n### **Two Exciting Game Modes:**\n\n1. **Level-Based Challenge:** Put your precision to the test! You have a **limited number of punches** to clear each stage. Can you solve the physics-based puzzles and hit the mark before you run out of moves?\n2. **Endless Mode:** No limits, no rules. Just pure, unadulterated punching fun with **infinite hits**. It\u2019s the perfect virtual playground to test your speed and blow off steam.\n{2028700261244703}\nWhether you're looking for a casual VR game to share with friends or a satisfying way to unwind after a long day, **Crazy Punch - Fun Game** offers non-stop entertainment and endless laughs.\n\n**Download today and start the crazy punching mayhem!**\n\n{1393681361851026}", "short_description": "Release your inner fighter in Crazy Punch - Fun Game! Experience the most hilarious ragdoll physics in VR as you punch, slap, and knock around goofy dummies and mimics. Whether you're solving punch-puzzles in Level Mode or blowing off steam in Endless Mode, the wacky \"giggle\" physics and funny sounds will keep you smiling. Simple to play, impossible to put down\u2014get ready for the ultimate stress-busting VR experience!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thundergamestudio.com/metapolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Thunder Game Studio", "support_website_url": null, "website_url": "https://www.thundergamestudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "2710427532541308"}, {"id": "459781504968480"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33633235726291583"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491819323_1527696721864294_5321052373056277721_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dFW3lekhVsMQ7kNvwF-ffPs&_nc_oc=AdoLfQst0TmlfynNlYhwSVZmrS1uzWaKcJWLBUUkfdoI41aDGvpzOyMUWrbdR3w3yZE&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3nQu_YB2iprVKtXa8OQvcwxyrh5cyBmV0EhcI7TgUEKw&oe=69E23DFD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Crazy Punch - Fun Game", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Fighting", "id": "2710427532541308"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Party Game", "id": "1700921480735423"}], "release_date": 177064
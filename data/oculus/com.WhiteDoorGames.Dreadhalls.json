1-25/12482172_214190209346144_9130900678007324672_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=08AiDBxKVKIQ7kNvwGma_2b&_nc_oc=AdrMf5Q_9mJVFZ-eVkEYscBcHt49slGg2LLl6r9Mf4zF0dT87IGJVrmUEGM2lk_OXvg&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG1J_ZSdCdraDy1ZCdFIhi7P-9Y4I3X_prcajM_Hvphnw&oe=6A7DC04B"}, "display_name": "Dreadhalls Demo", "keywords": ["scary", "dungeon", "dread", "horror", "fear"], "long_description": "Experience a new kind of immersive horror in Dreadhalls!\n\nYou are trapped deep inside a massive dungeon. Explore it, survive it, and find a way to escape. Your only weapons will be stealth, your own courage, and a faint light.\n\nInspired by the survival horror and roguelike genres, Dreadhalls has been terrorizing people ever since its debut at the 2013 Oculus + Indiecade VR Jam.\n\nDreadhalls is an intense and scary experience, not for the faint of heart. You have been warned!", "short_description": "You are trapped deep inside a massive dungeon. Explore it, survive it, and find a way to escape. Your only weapons will be stealth, your own courage, and a faint light."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.whitedoorgames.com/privacy.html", "developer_terms_of_service_url": "http://www.whitedoorgames.com/tos.html", "publisher_name": "White Door Games", "support_website_url": "http://dreadhalls.com/contact", "website_url": "http://www.dreadhalls.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "HORROR"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "GEAR_VR
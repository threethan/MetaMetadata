83760_2667262574431077871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tDaWEQQnQMkQ7kNvwHkIE-L&_nc_oc=AdqQHwfRx4lvVCwHpOp1G2eXiOcfPJtQqzgRi2h2T1MgTS0ceMbFF_hHYJDhAC7B3Nc&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_1mt--CB0d2jdSPw7Wu9BXGpZhffkpe6slwab7riB-A&oe=6A9172D4"}, {"file_name": "screenshot_2560x1440_02.png", "id": "669054496302012", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/499618910_669054502968678_12487198628138138_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=avBrTzYUd48Q7kNvwHG-C4n&_nc_oc=Adows4hnYIm_93trxL1HwcjgtgFTckqB4Ofu1G_98dxh4WPpvgJsaujcvV89Qz3taHA&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGignwqw1H_LdMyUg5_6MRx5osSaA4iLrTVeh0_PAzexg&oe=6A917CAE"}, {"file_name": "screenshot_2560x1440_04.png", "id": "1692932094965269", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/499618297_1692932098298602_7171383388243165638_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VnZlVtu_ocwQ7kNvwEMA3wo&_nc_oc=AdrAVc0S1DtlS53aZF3DsFhx1FzpVkLal9t7pVSuEqEZtNkCQru9Y2oeW6r_w057E18&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFlLNxjQEUEJs7jaxiqhrDH5fp13oUN09h185vpQy3rLQ&oe=6A9165A8"}, {"file_name": "screenshot_2560x1440_01.png", "id": "952606510468970", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499619685_952606517135636_8047896386954430759_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jdzQYL7i2A0Q7kNvwGveP3L&_nc_oc=AdrLUM1U80i7aXhGbHOYMCZ_x-4IDLnKnQsDRBmCwYWLaBRLPfsD13MW-Od5eXVo5yQ&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFlQLGHi1imPzRso3oTx6Jh-Dm3qhXRf7Qqgz-LnXZkkQ&oe=6A917679"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape 2560x1440px.png", "id": "952628337349594", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/491819417_952628340682927_7092126336638068634_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fD_WWjZz9P4Q7kNvwHbS_hr&_nc_oc=Ado8MtaEXZ3rVn7CJ5bygnZ2lMIn334eyiHkVlgvoc3T5JKF2OpsxKaV7cGxUjrWiWw&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGykyNReZAOoAStTafli9ZlnN5Y3M_GjZfyDFYXdL-pOg&oe=6A915CC7"}, "display_name": "BeatGesture", "keywords": ["rhythm", "music", "beat", "handtracking", "gesture"], "long_description": "Step into a new dimension of rhythm.\n\nBeatGesture is a VR rhythm game where your hands are the controller. Match hand gestures, positions, and timing to the beat for a fully immersive experience.\n\n[Gesture-Based Gameplay] \nHit incoming notes by matching the correct hand shape, placing your hand in the right position, and timing it perfectly with the music. Simple to learn, deeply satisfying to master.\n\n[Expressive Controls]\nPlay using natural gestures like fists, open hands, thumbs up, and L-shapes. Direction-based variations and two-hand patterns add depth and challenge.\n\n[Dynamic Note Types]\nTap \u2013 Hit on beat\nHold \u2013 Maintain your gesture\nSwipe \u2013 Hit the note in the arrow direction\n\n[Game Modes]\nCampaign \u2013 Progress through increasingly challenging stages\nFree Play \u2013 Replay songs with selectable difficulty\n\nImmersive VR\nDesigned for Meta Quest hand tracking with stylized, rhythm-driven environments. Passthrough support available.\n\nFeel the beat.\nYour hands are the instrument.", "short_description": "Feel the rhythm with your hands.\nMatch gestures, hit the beat, and master immersive VR rhythm gameplay in BeatGesture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/beatgesture-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "LefthandDeveloper", "support_website_url": null, "website_url": "https://sites.google.com/view/beatgesture/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "15921
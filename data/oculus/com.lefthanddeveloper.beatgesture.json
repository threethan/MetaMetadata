83760_2667262574431077871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sPFDOSD_tRgQ7kNvwEc0UqA&_nc_oc=AdqInU1xvhjzQyJmCsqpQ4LOXLqy5zWKAw4asj-jLCkG4voMyJ9lFVFhDCZN-zr57sU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5FHtuaM7nuhMPA_miyUWO53RWD4Hk1VyNGFi01P1CDQ&oe=6A9C3714"}, {"file_name": "screenshot_2560x1440_02.png", "id": "669054496302012", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618910_669054502968678_12487198628138138_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qTgTW1QXKggQ7kNvwGkpURW&_nc_oc=AdpIz9Kkb41wSSudbKyZNxkYkL3_sXYbdUZksm5RQ2bOnEqunYScsA2gUJfdF4RMris&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdeCsewKJ-XHb01mu90IHAlzqEk-Wi-Nl_MzbpBTghgw&oe=6A9C40EE"}, {"file_name": "screenshot_2560x1440_04.png", "id": "1692932094965269", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618297_1692932098298602_7171383388243165638_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Qg3V4LARZEQ7kNvwEjKeBB&_nc_oc=AdrnPWKXqvvNutHvy4ok6O7PieUv118IsKwGGlPAJiz_u-M8PDFCD1ATgpOLCcjdtEY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvQ3oopzuJTDfMLHre-5ugX332xmF5s12FcxwDPDFdAw&oe=6A9C29E8"}, {"file_name": "screenshot_2560x1440_01.png", "id": "952606510468970", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619685_952606517135636_8047896386954430759_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=22Paj59Go98Q7kNvwFzOgKC&_nc_oc=Ado9J-xuUJBVjB4Jk3jtDDIQOZD52iReQ8-wj8HpZRCnHc-DNtdPGRE8B8pAiKNn0Xs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqr4S5_OOihbwdmERGsp2comHlvRAhrBVODUZZrje-OQ&oe=6A9C3AB9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape 2560x1440px.png", "id": "952628337349594", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819417_952628340682927_7092126336638068634_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jzBb8yoDJ8AQ7kNvwE5cuPG&_nc_oc=AdocrmZMcv0ewOLrosRA2YKQlbJ7BeuiANcf8v3cBcgCBXxbSFhc67Zz1F-ZMlsx5UY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtqeqV4BMfDZbwqSag2nkcIKu2ThKCPJcNQ7tTQOTG9g&oe=6A9C2107"}, "display_name": "BeatGesture", "keywords": ["rhythm", "music", "beat", "handtracking", "gesture"], "long_description": "Step into a new dimension of rhythm.\n\nBeatGesture is a VR rhythm game where your hands are the controller. Match hand gestures, positions, and timing to the beat for a fully immersive experience.\n\n[Gesture-Based Gameplay] \nHit incoming notes by matching the correct hand shape, placing your hand in the right position, and timing it perfectly with the music. Simple to learn, deeply satisfying to master.\n\n[Expressive Controls]\nPlay using natural gestures like fists, open hands, thumbs up, and L-shapes. Direction-based variations and two-hand patterns add depth and challenge.\n\n[Dynamic Note Types]\nTap \u2013 Hit on beat\nHold \u2013 Maintain your gesture\nSwipe \u2013 Hit the note in the arrow direction\n\n[Game Modes]\nCampaign \u2013 Progress through increasingly challenging stages\nFree Play \u2013 Replay songs with selectable difficulty\n\nImmersive VR\nDesigned for Meta Quest hand tracking with stylized, rhythm-driven environments. Passthrough support available.\n\nFeel the beat.\nYour hands are the instrument.", "short_description": "Feel the rhythm with your hands.\nMatch gestures, hit the beat, and master immersive VR rhythm gameplay in BeatGesture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/beatgesture-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "LefthandDeveloper", "support_website_url": null, "website_url": "https://sites.google.com/view/beatgesture/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "15921
cb=1-7&_nc_sid=6e7a0a&_nc_ohc=sRoAKUnBJV8Q7kNvwEH3O6r&_nc_oc=Adr-cxfsUjTHwDeKyA399hsIp851vmcEE7mhIXU5xvbckVALQE9FaKtZhdG-POcq28w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71l5nHzA0HF6c1TguFl93AiKW14QA4DWxY7Cz9ennKlw&oe=6A01E348"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape 2560x1440px.png", "id": "952628337349594", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819417_952628340682927_7092126336638068634_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1yXnmqIU-rkQ7kNvwGqOrwc&_nc_oc=AdqhbcnSJ85Hlo3s9-imrgl7pgyPdVnp_d0OqAijPRjZ_BKLg04Qsh7qRHFhz-yr7-8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af52foeNJNuC1X7nLbao4QiRs7i_A9KEdJkrFnqUxKRpUw&oe=6A01E187"}, "display_name": "BeatGesture", "keywords": ["rhythm", "music", "beat", "handtracking", "gesture"], "long_description": "Step into a new dimension of rhythm.\n\nBeatGesture is a VR rhythm game where your hands are the controller. Match hand gestures, positions, and timing to the beat for a fully immersive experience.\n\n[Gesture-Based Gameplay] \nHit incoming notes by matching the correct hand shape, placing your hand in the right position, and timing it perfectly with the music. Simple to learn, deeply satisfying to master.\n\n[Expressive Controls]\nPlay using natural gestures like fists, open hands, thumbs up, and L-shapes. Direction-based variations and two-hand patterns add depth and challenge.\n\n[Dynamic Note Types]\nTap \u2013 Hit on beat\nHold \u2013 Maintain your gesture\nSwipe \u2013 Hit the note in the arrow direction\n\n[Game Modes]\nCampaign \u2013 Progress through increasingly challenging stages\nFree Play \u2013 Replay songs with selectable difficulty\n\nImmersive VR\nDesigned for Meta Quest hand tracking with stylized, rhythm-driven environments. Passthrough support available.\n\nFeel the beat.\nYour hands are the instrument.", "short_description": "Feel the rhythm with your hands.\nMatch gestures, hit the beat, and master immersive VR rhythm gameplay in BeatGesture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/beatgesture-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "LefthandDeveloper", "support_website_url": null, "website_url": "https://sites.google.com/view/beatgesture/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35694766050122375"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "738589209279858"}, {"status": "PUBLISHED", "id": "1584496899310597"}, {"status": "PUBLISHED", "id": "1680768333085894"}]}, "baseline_offer": {"id": "1680768333085894"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1782493200, "status": "PUBLISHED", "id": "738589209279858"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "35963582089907435", "version": "1.0.0"}, "id": "944677714974221", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "35694765943455719", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "35963582089907435"}, "r
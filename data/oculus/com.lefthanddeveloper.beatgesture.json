2560x1440_01_v2.png", "id": "1066714709239225", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620341_1066714712572558_7058001035126764018_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gL6zUB9HdPgQ7kNvwE3C_J3&_nc_oc=AdpdAalAx1BKspKfDD1uWOBP53miSVssFvWWh8wOBPjKF2KkAj4k9Rq8ds1RCIvgoaE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_Wy8Q9-FOQI_19GIB9KQhTw9F2jUuBKD9YkFqtBN_ew&oe=6AE1F296"}, {"file_name": "screenshot_2560x1440_03_v2.png", "id": "3419503744896967", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623179_3419503748230300_6824419827252677977_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MBQL6ykLe7sQ7kNvwERwQxx&_nc_oc=Adp3N6DXmovl7i9tAPZni0aaAkjduZgb3Gjcp1HhSn9E6-M_a052X_ccGbLX_VvKp-Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP54GAFWeohxdTsAToZ7n4H7SeUzgkhBUYZz3IztvkwVg&oe=6AE217E5"}, {"file_name": "screenshot_2560x1440_02.png", "id": "669054496302012", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618910_669054502968678_12487198628138138_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SVelGo3P0CEQ7kNvwEfrp57&_nc_oc=AdpdQUwE3v-DU5b0_1LyYjZGE5ZisG7uAjcimfSOCH7KuN2FQCUzlL1UYIefZoJ3cs4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOdtToKB6X15ZVoKYy4CDo-uezgBNQ232ja2QCdyzG4YA&oe=6AE1E82E"}, {"file_name": "screenshot_2560x1440_04.png", "id": "1692932094965269", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618297_1692932098298602_7171383388243165638_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hQA5X0yLw6gQ7kNvwEdp7C7&_nc_oc=Adov4dqx_qBSytcJTvw--AvUrfsskk2Eh1D6c4ifUiSceSC4OZ5wr8aP8u6zHmgebxA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNYgaRh0GufFedTK0hXoPInVDZB3ZSP-vxyHY6GqsrJEg&oe=6AE20968"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape 2560x1440px.png", "id": "952628337349594", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819417_952628340682927_7092126336638068634_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vSR8iFVm-1wQ7kNvwEd-7NX&_nc_oc=AdqwSTTvwVGEVAgyPt2-6B5IzqbDy5e6amTZvxvoOYxeEoNus5AyEcruemzedqha1ag&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMmLC8e-noTL6-mU8fNRAjjX6dNGm1uawzrdYldKGWL0g&oe=6AE20087"}, "display_name": "BeatGesture", "keywords": ["rhythm", "music", "beat", "handtracking", "gesture"], "long_description": "Step into a new dimension of rhythm.\n\nBeatGesture is a VR rhythm game where your hands are the controller. Match hand gestures, positions, and timing to the beat for a fully immersive experience.\n\nDesigned for Meta Quest hand tracking with stylized, rhythm-driven environments.\n\n{2229418921186635}\n\n[Gesture-Based Gameplay] \n\nHit incoming notes by matching the correct hand shape, placing your hand in the right position, and timing it perfectly with the music. Simple to learn, deeply satisfying to master.\n\n[Expressive Controls]\n\nPlay using natural gestures like fists, open hands, thumbs up, and L-shapes. Direction-based variations and two-hand patterns add depth and challenge.\n\n[Dynamic Note Types]\n\nTap \u2013 Hit on beat\n\nHold \u2013 Maintain your gesture\n\nSwipe \u2013 Hit the note in the arrow direction\n\n\n[Game Modes]\n\nCampaign \u2013 Progress through increasingly challenging stages\n\nFree Play \u2013 Replay songs with selectable difficulty\n\nPassthrough support available.\n\nFeel the beat.\n\nYour hands are the instrument.\n", "short_description": "Feel the rhythm with your hands.\nMatch gestures, hit the beat, and master immersive VR rhythm gameplay in BeatGesture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/beatgesture-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "LefthandDeveloper", "support_website_url": null, "website_url": "https://sites.google.com/view/beatgesture/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [],
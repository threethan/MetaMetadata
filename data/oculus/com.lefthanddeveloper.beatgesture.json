712572558_7058001035126764018_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1UZDyLFOO9wQ7kNvwE7J0Ju&_nc_oc=AdpF5KUEV5wOAUy4pa7F5bXHFrAAriy-TpqYYWh9k9sw5KCoUiLPHBIuZ5lbJ5tlq0A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOPi9gYCOmIh07o2du_bKa36JTdheCNg_acEKSplwFjtg&oe=6ACA6FD6"}, {"file_name": "screenshot_2560x1440_03_v2.png", "id": "3419503744896967", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623179_3419503748230300_6824419827252677977_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uJWloeZkhlIQ7kNvwHhx0Rl&_nc_oc=AdpmQfnbSS_XkafkL0EYnxa9_Dfc07N3ZjG2BUlStOPraSEWI_jpgVCwrs6brI668J4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPYwptpSsmq93M8rluPl37I_cTm2_7pPtTAtddtfzvYKQ&oe=6ACA5CE5"}, {"file_name": "screenshot_2560x1440_02.png", "id": "669054496302012", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618910_669054502968678_12487198628138138_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BzcRrbrSgCMQ7kNvwFBOIDe&_nc_oc=Adr0lELa8tsEvYLowlDGa_FmbD1XpiY5Cg8bH6X4R_-ZvAQnT-kScBcovSz4xcHUkbY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZUrMQf-bsFj0-NUYc6p3FWx2YhS6wDOhBcRTCICF5JA&oe=6ACA656E"}, {"file_name": "screenshot_2560x1440_04.png", "id": "1692932094965269", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618297_1692932098298602_7171383388243165638_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1K3Gb42zVdkQ7kNvwGSrWND&_nc_oc=AdpgHdWNNyV4hiunSjYwIfyQtg2noneV1m-g7WciBZQ8z9oZY4N21Y6pKxs5AMtY5DE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOtGUbZvCeudkwvfZMpCimL7UeFC-wyqfsty0igH7GICQ&oe=6ACA4E68"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape 2560x1440px.png", "id": "952628337349594", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819417_952628340682927_7092126336638068634_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B4C8OJK-3_cQ7kNvwF1508e&_nc_oc=Ado5iAKw_2--kReq-xnzfaLTVQ8zqrVn2fmxCz7zVnOENAsCOBdbKriTK7RCDRWp_d0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZqKUV67nlV2cBX5P1nmmzskLV8hEIMJFYQpVAsS_oDw&oe=6ACA4587"}, "display_name": "BeatGesture", "keywords": ["rhythm", "music", "beat", "handtracking", "gesture"], "long_description": "Step into a new dimension of rhythm.\n\nBeatGesture is a VR rhythm game where your hands are the controller. Match hand gestures, positions, and timing to the beat for a fully immersive experience.\n\nDesigned for Meta Quest hand tracking with stylized, rhythm-driven environments.\n\n{2229418921186635}\n\n[Gesture-Based Gameplay] \n\nHit incoming notes by matching the correct hand shape, placing your hand in the right position, and timing it perfectly with the music. Simple to learn, deeply satisfying to master.\n\n[Expressive Controls]\n\nPlay using natural gestures like fists, open hands, thumbs up, and L-shapes. Direction-based variations and two-hand patterns add depth and challenge.\n\n[Dynamic Note Types]\n\nTap \u2013 Hit on beat\n\nHold \u2013 Maintain your gesture\n\nSwipe \u2013 Hit the note in the arrow direction\n\n\n[Game Modes]\n\nCampaign \u2013 Progress through increasingly challenging stages\n\nFree Play \u2013 Replay songs with selectable difficulty\n\nPassthrough support available.\n\nFeel the beat.\n\nYour hands are the instrument.\n", "short_description": "Feel the rhythm with your hands.\nMatch gestures, hit the beat, and master immersive VR rhythm gameplay in BeatGesture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/beatgesture-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "LefthandDeveloper", "support_website_url": null, "website_url": "https://sites.google.com/view/beatgesture/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {
83760_2667262574431077871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k82Yi4cX2PcQ7kNvwHYp-C_&_nc_oc=AdrHYraOH1EJ3aqWK9FSh8qSBVIKEoYTaMtm06c1xP60gkI6FczgRPXETmPJ-aUgplI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHco-aHBDmnOd4SrQhgYJN4Xh3YinTejFhMmRkrs2UL1Q&oe=6A972954"}, {"file_name": "screenshot_2560x1440_02.png", "id": "669054496302012", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499618910_669054502968678_12487198628138138_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UCcby8p3wB8Q7kNvwFADKWn&_nc_oc=AdqSLlNESnz2BDnpLHY2gLcTz4t_szZW1w0bTn4WvI7L9kv3oPxIYhoPhYsoSUzlcJ4&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgmD2qDMSU3ImPR-z2KMsVzKC8cQ3EIJWXta4G9ukF-A&oe=6A97332E"}, {"file_name": "screenshot_2560x1440_04.png", "id": "1692932094965269", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499618297_1692932098298602_7171383388243165638_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aeho8BOM_BIQ7kNvwHn0zKv&_nc_oc=AdpjIEDZHCWT1zeXCWV8DIzGZ2F6SMmnQ98WCfBNXF_aFE-CWokzPN3JAhjKPJyug4k&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQECQ44FsX7OUxfMgrECnaD7877vkZUDe_eCnKWNHzvNWw&oe=6A971C28"}, {"file_name": "screenshot_2560x1440_01.png", "id": "952606510468970", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499619685_952606517135636_8047896386954430759_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mt2gdLbfJSIQ7kNvwG0YaDJ&_nc_oc=Adppjm7SkGNqO12qb8egsrLb5b2Rg91p9MideXtlz8baGL-mDiprD-VJu9OV012H4dM&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQElR1JWVcWyV6KXgB7ExpPzmKlkQaUDTHYqjGD1CPuk9w&oe=6A972CF9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape 2560x1440px.png", "id": "952628337349594", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/491819417_952628340682927_7092126336638068634_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R6IMEmSmWacQ7kNvwH0Y6Oa&_nc_oc=AdrjIPn1_iFL8I7i7SR1KdyN_j6dGmgCOOEZdQZRGylWx5nQjvRqvHFc5mlEVl0drQg&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-NDihfytrt9OcvPw2ARxcDL1chu3v1X6Vc9aTCPAWiA&oe=6A974B87"}, "display_name": "BeatGesture", "keywords": ["rhythm", "music", "beat", "handtracking", "gesture"], "long_description": "Step into a new dimension of rhythm.\n\nBeatGesture is a VR rhythm game where your hands are the controller. Match hand gestures, positions, and timing to the beat for a fully immersive experience.\n\n[Gesture-Based Gameplay] \nHit incoming notes by matching the correct hand shape, placing your hand in the right position, and timing it perfectly with the music. Simple to learn, deeply satisfying to master.\n\n[Expressive Controls]\nPlay using natural gestures like fists, open hands, thumbs up, and L-shapes. Direction-based variations and two-hand patterns add depth and challenge.\n\n[Dynamic Note Types]\nTap \u2013 Hit on beat\nHold \u2013 Maintain your gesture\nSwipe \u2013 Hit the note in the arrow direction\n\n[Game Modes]\nCampaign \u2013 Progress through increasingly challenging stages\nFree Play \u2013 Replay songs with selectable difficulty\n\nImmersive VR\nDesigned for Meta Quest hand tracking with stylized, rhythm-driven environments. Passthrough support available.\n\nFeel the beat.\nYour hands are the instrument.", "short_description": "Feel the rhythm with your hands.\nMatch gestures, hit the beat, and master immersive VR rhythm gameplay in BeatGesture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/beatgesture-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "LefthandDeveloper", "support_website_url": null, "website_url": "https://sites.google.com/view/beatgesture/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "15921
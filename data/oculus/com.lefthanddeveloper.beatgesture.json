hPSVXiRLQjLJO3dIhv0uRYBoQxjENKkvjzAUBg5okDdpXKI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJjvKTTRjs7-Tk63fxELoIWflSu8_RYyc6Ed28Pyk16Q&oe=6A7B0954"}, {"file_name": "screenshot_2560x1440_02.png", "id": "669054496302012", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618910_669054502968678_12487198628138138_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YmNUurCcB6gQ7kNvwEqeqlg&_nc_oc=AdpgZwDysoQ2Qd4dPWVXgcZOw4R_Zc3mGUvB8lCjQup72TKqD8VissjdmCx0Y2hpLq8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHWLDdvZnkWMMRjJQJ8wzBc-Aag3RSY2TXIjDi-uJGi1w&oe=6A7B132E"}, {"file_name": "screenshot_2560x1440_04.png", "id": "1692932094965269", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618297_1692932098298602_7171383388243165638_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oX2zXC_J930Q7kNvwHPsivb&_nc_oc=AdqHxYtMgTQH-2eU7C4yDzGPXAT0aYvZxH9dPsJBNkfeq2J53Y2izeucyvYeqLdi1sM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGfsyMNHSRSr7Cp0AlHRAD9kVCcZEvsVfR6_Mm1hldIEQ&oe=6A7B3468"}, {"file_name": "screenshot_2560x1440_01.png", "id": "952606510468970", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619685_952606517135636_8047896386954430759_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7fP61nhDsFkQ7kNvwECAJZi&_nc_oc=AdpfhP20dDmB66NK7hSFnppmyJx6t3skweV_eOHK_oJijfzii60HtHAjaDu0SqzY4YM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFXhUhvYDmWfTV0Vxmg9dO9mnfWh6jRR31FEH6r_rhSdA&oe=6A7B0CF9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape 2560x1440px.png", "id": "952628337349594", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819417_952628340682927_7092126336638068634_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jFM7W-so00EQ7kNvwGBCpGh&_nc_oc=Ado9TRm1V3In9NlS-ODlN76AO6eRdZR3RhNZvqoJN2P4I0aRFSXgIpqC5UdDCLieK54&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWclt85m1YwhyJRVV6jI5f1I5Ph22htKwz-2FLORaWvQ&oe=6A7B2B87"}, "display_name": "BeatGesture", "keywords": ["rhythm", "music", "beat", "handtracking", "gesture"], "long_description": "Step into a new dimension of rhythm.\n\nBeatGesture is a VR rhythm game where your hands are the controller. Match hand gestures, positions, and timing to the beat for a fully immersive experience.\n\n[Gesture-Based Gameplay] \nHit incoming notes by matching the correct hand shape, placing your hand in the right position, and timing it perfectly with the music. Simple to learn, deeply satisfying to master.\n\n[Expressive Controls]\nPlay using natural gestures like fists, open hands, thumbs up, and L-shapes. Direction-based variations and two-hand patterns add depth and challenge.\n\n[Dynamic Note Types]\nTap \u2013 Hit on beat\nHold \u2013 Maintain your gesture\nSwipe \u2013 Hit the note in the arrow direction\n\n[Game Modes]\nCampaign \u2013 Progress through increasingly challenging stages\nFree Play \u2013 Replay songs with selectable difficulty\n\nImmersive VR\nDesigned for Meta Quest hand tracking with stylized, rhythm-driven environments. Passthrough support available.\n\nFeel the beat.\nYour hands are the instrument.", "short_description": "Feel the rhythm with your hands.\nMatch gestures, hit the beat, and master immersive VR rhythm gameplay in BeatGesture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/beatgesture-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "LefthandDeveloper", "support_website_url": null, "website_url": "https://sites.google.com/view/beatgesture/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NO
83760_2667262574431077871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k82Yi4cX2PcQ7kNvwFiC2ZH&_nc_oc=AdquD4xyXc6i5wMHHLtY4KpsrtMwSBYo7Yyqa8OiFcLteH_BywtpvRxlkfNjbHI3xTE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_DIkeoZDFjVOiSN0JAQsKVvDVS_f_1rMJGW6aqVS-CQ&oe=6A984294"}, {"file_name": "screenshot_2560x1440_02.png", "id": "669054496302012", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618910_669054502968678_12487198628138138_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UCcby8p3wB8Q7kNvwFUu21c&_nc_oc=AdprmpLz4xwzjULyuwuQlRg4hUEyQTki2WxBFc2pxL_BzD8sZAj6XGiAoDpHK4HY0oU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLk_EcS7RNInYmjCFhW3hUVl3Z0GeRies3skx12nl0dQw&oe=6A984C6E"}, {"file_name": "screenshot_2560x1440_04.png", "id": "1692932094965269", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618297_1692932098298602_7171383388243165638_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aeho8BOM_BIQ7kNvwGz5V_L&_nc_oc=AdqhdZtx6JYABismwVmRILhWynsqFM-F92pHSM2zsIZyp35saLC1Zc61rhJOPaviiw0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQINTsiY2ep76D4aCxY-xzo-6uYc7BTRXBZO5w_3y9PCWg&oe=6A983568"}, {"file_name": "screenshot_2560x1440_01.png", "id": "952606510468970", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619685_952606517135636_8047896386954430759_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mt2gdLbfJSIQ7kNvwEbo8fQ&_nc_oc=AdpOgH3Vp_0QSiuGpnmXya1pRPuCZTyQ5Sl9aphImSnn7ClMqhQ5X0SG4wwVxpfhvbg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJA2uaL-tD2RlCXo9EcuxqiZRa8YIsDmKL_15apXfptCw&oe=6A984639"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape 2560x1440px.png", "id": "952628337349594", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819417_952628340682927_7092126336638068634_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R6IMEmSmWacQ7kNvwEptkzF&_nc_oc=Adrdod_MqmVKABwXwzR_hCLMsujAwe3MQEv8ZXEcRNm9XIblllSCidfThsxjhHEoBUQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJBzXL7evFhCUNWeaWG81YEW8BzZam5pv0i5ZB86b4enQ&oe=6A9864C7"}, "display_name": "BeatGesture", "keywords": ["rhythm", "music", "beat", "handtracking", "gesture"], "long_description": "Step into a new dimension of rhythm.\n\nBeatGesture is a VR rhythm game where your hands are the controller. Match hand gestures, positions, and timing to the beat for a fully immersive experience.\n\n[Gesture-Based Gameplay] \nHit incoming notes by matching the correct hand shape, placing your hand in the right position, and timing it perfectly with the music. Simple to learn, deeply satisfying to master.\n\n[Expressive Controls]\nPlay using natural gestures like fists, open hands, thumbs up, and L-shapes. Direction-based variations and two-hand patterns add depth and challenge.\n\n[Dynamic Note Types]\nTap \u2013 Hit on beat\nHold \u2013 Maintain your gesture\nSwipe \u2013 Hit the note in the arrow direction\n\n[Game Modes]\nCampaign \u2013 Progress through increasingly challenging stages\nFree Play \u2013 Replay songs with selectable difficulty\n\nImmersive VR\nDesigned for Meta Quest hand tracking with stylized, rhythm-driven environments. Passthrough support available.\n\nFeel the beat.\nYour hands are the instrument.", "short_description": "Feel the rhythm with your hands.\nMatch gestures, hit the beat, and master immersive VR rhythm gameplay in BeatGesture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/beatgesture-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "LefthandDeveloper", "support_website_url": null, "website_url": "https://sites.google.com/view/beatgesture/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "15921
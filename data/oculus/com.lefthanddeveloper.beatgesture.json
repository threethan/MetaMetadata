2560x1440_01_v2.png", "id": "1066714709239225", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620341_1066714712572558_7058001035126764018_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gL7sNBgGY8wQ7kNvwHV-8VR&_nc_oc=Adq2TsXs8FIYncmTrXiy4wynRpVodw6i1CvnepVqvf1zuD5GA3RxqNpAJp3rbSh1zDg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3HysRzmS8Htx3Re6XSrRtlCKeYu34EKeqAgg8IJkFxQ&oe=6AF0AB56"}, {"file_name": "screenshot_2560x1440_03_v2.png", "id": "3419503744896967", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623179_3419503748230300_6824419827252677977_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=skdqGW1ZZUQQ7kNvwEbsH4W&_nc_oc=AdrEuB2Q3DP2lSQlXvsLHvp9LWnO9VW703Ivlbqcde5zVlyQzcDB_cVx93s8vhrhrV8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRV0phlTD4rshYm99vLlDtZHZNYN83pDJdg9z2RRCWYTQ&oe=6AF09865"}, {"file_name": "screenshot_2560x1440_02.png", "id": "669054496302012", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618910_669054502968678_12487198628138138_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rBzhfoxnO98Q7kNvwEiIjD5&_nc_oc=AdrhWgTZIGkNaGzehdFnplBFmv200ijFrF1gtuT3dG2DIFSZq_cYZthkvyQ-aL-ae6c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScqw-sB6If8Y2ljloqMtUAgEPnYjiT-UTsXxvBOq0yeA&oe=6AF0A0EE"}, {"file_name": "screenshot_2560x1440_04.png", "id": "1692932094965269", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618297_1692932098298602_7171383388243165638_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZtMD-mCJPMAQ7kNvwEiE9Kb&_nc_oc=AdpRFZ3JZ6juOQ4gyBMyjnXxgvfmFPC7wPdIwHC-ZHG9zu1k06cgDB0OT443SraIrCM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8OQpxf0zdG8PiIZQN5R92ig7PbRTYq_YV69Iqrk1m_w&oe=6AF089E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape 2560x1440px.png", "id": "952628337349594", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819417_952628340682927_7092126336638068634_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xrRfFR434TgQ7kNvwGl-3E4&_nc_oc=AdoOcoeP3jYc08-5KwnrSO0886UfgEUHMBBEDyIGIt_fZwUrkyEilV4ZnhTEhg974lk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLzP8_Qkr0_kuacCx72Iv8FRiGakxHsYZBnoLeS7SiJA&oe=6AF08107"}, "display_name": "BeatGesture", "keywords": ["rhythm", "music", "beat", "handtracking", "gesture"], "long_description": "Step into a new dimension of rhythm.\n\nBeatGesture is a VR rhythm game where your hands are the controller. Match hand gestures, positions, and timing to the beat for a fully immersive experience.\n\nDesigned for Meta Quest hand tracking with stylized, rhythm-driven environments.\n\n{2229418921186635}\n\n[Gesture-Based Gameplay] \n\nHit incoming notes by matching the correct hand shape, placing your hand in the right position, and timing it perfectly with the music. Simple to learn, deeply satisfying to master.\n\n[Expressive Controls]\n\nPlay using natural gestures like fists, open hands, thumbs up, and L-shapes. Direction-based variations and two-hand patterns add depth and challenge.\n\n[Dynamic Note Types]\n\nTap \u2013 Hit on beat\n\nHold \u2013 Maintain your gesture\n\nSwipe \u2013 Hit the note in the arrow direction\n\n\n[Game Modes]\n\nCampaign \u2013 Progress through increasingly challenging stages\n\nFree Play \u2013 Replay songs with selectable difficulty\n\nPassthrough support available.\n\nFeel the beat.\n\nYour hands are the instrument.\n", "short_description": "Feel the rhythm with your hands.\nMatch gestures, hit the beat, and master immersive VR rhythm gameplay in BeatGesture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/beatgesture-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "LefthandDeveloper", "support_website_url": null, "website_url": "https://sites.google.com/view/beatgesture/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [],
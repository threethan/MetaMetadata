712572558_7058001035126764018_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lXrHlvLMHQcQ7kNvwHklWNJ&_nc_oc=AdqlAG-cS3n2Jiwauj9KzoBpaZFXWXYbhwwOCYEG9fip-p9XbQEOxiLwJHZg7DAVtdk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKP0U58XVAv1gArKMtfnTmNom8uLpb2AYUqgIAcrLkIhg&oe=6AA00796"}, {"file_name": "screenshot_2560x1440_03_v2.png", "id": "3419503744896967", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499623179_3419503748230300_6824419827252677977_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l7KlOOz3W3QQ7kNvwGJwWPg&_nc_oc=Adqy8Wr6PA0uJx9gX6wMrUaLt0pZvJoW5MfmmI4lq-RArMDDTFb8WtF58WQvFJ33S1I&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLiLD2PncqCF7We4aRzJeZGnPIKwncD4TqFXfVtfLZTyg&oe=6AA02CE5"}, {"file_name": "screenshot_2560x1440_02.png", "id": "669054496302012", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499618910_669054502968678_12487198628138138_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VTfPZ6Asn04Q7kNvwHoOF3m&_nc_oc=AdqXA4NCcN4zP0CRrqjxDaEbqw-s4nlc4EvTNLXoWw1MMnf7JVHsk5D5gnCvt9Gyd2I&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKx4Tj9uR5Jqw3lc9KDVmBEaijuyKk3yLTMAxYcBgj3hw&oe=6A9FFD2E"}, {"file_name": "screenshot_2560x1440_04.png", "id": "1692932094965269", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499618297_1692932098298602_7171383388243165638_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2gOz2wAJrg0Q7kNvwE7unNw&_nc_oc=AdohwgfTfEOQgx7qiKNmhQ3Kl0IdpxxXgCmcpVkP1QDNmDJfGiVFd6DS8LGQPx7M5F8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKKa80ilUSZm1rTRr9WFuu0s4Nthnv8Y62SCQNDlLQflQ&oe=6AA01E68"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape 2560x1440px.png", "id": "952628337349594", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491819417_952628340682927_7092126336638068634_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ONqH3udagDcQ7kNvwE1SJJI&_nc_oc=AdpFfG8BaJuSX8kWF-SkTxRItkAewqE90WnqyfiEKIuzegJZ55b5Q6H4_F6UqpDlynU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1thLLFtu6N3UezSxazfiJi6FqS1SOIxpUfZstwRZw5g&oe=6AA01587"}, "display_name": "BeatGesture", "keywords": ["rhythm", "music", "beat", "handtracking", "gesture"], "long_description": "Step into a new dimension of rhythm.\n\nBeatGesture is a VR rhythm game where your hands are the controller. Match hand gestures, positions, and timing to the beat for a fully immersive experience.\n\nDesigned for Meta Quest hand tracking with stylized, rhythm-driven environments.\n\n{2229418921186635}\n\n[Gesture-Based Gameplay] \n\nHit incoming notes by matching the correct hand shape, placing your hand in the right position, and timing it perfectly with the music. Simple to learn, deeply satisfying to master.\n\n[Expressive Controls]\n\nPlay using natural gestures like fists, open hands, thumbs up, and L-shapes. Direction-based variations and two-hand patterns add depth and challenge.\n\n[Dynamic Note Types]\n\nTap \u2013 Hit on beat\n\nHold \u2013 Maintain your gesture\n\nSwipe \u2013 Hit the note in the arrow direction\n\n\n[Game Modes]\n\nCampaign \u2013 Progress through increasingly challenging stages\n\nFree Play \u2013 Replay songs with selectable difficulty\n\nPassthrough support available.\n\nFeel the beat.\n\nYour hands are the instrument.\n", "short_description": "Feel the rhythm with your hands.\nMatch gestures, hit the beat, and master immersive VR rhythm gameplay in BeatGesture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/beatgesture-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "LefthandDeveloper", "support_website_url": null, "website_url": "https://sites.google.com/view/beatgesture/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {
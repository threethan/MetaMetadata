1549751313383760_2667262574431077871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7RYKv_tNR1EQ7kNvwGrfzWs&_nc_oc=AdoUFnwf8x0C2ecdtM_iCNUtgSJaj-tO_KR2eqXGkk0ZlP-rpOYEr-pN6UZ2p-dHBTA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5o2PhGsIbiCB7fLE8ISTLD7evdYjEI0EQBRQqJru_kA&oe=6A8D7E54"}, {"file_name": "screenshot_2560x1440_02.png", "id": "669054496302012", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499618910_669054502968678_12487198628138138_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=16qFdEGnPIkQ7kNvwHJKr5_&_nc_oc=Adpiv23zRCP084w0iSimoag_AJs6mDXOlIKg-JsbPQaQo1Ci-oRgY3L_SyF2lxooquM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-E7XLfGi4NVmrt2bKqA1_8Ifb9O96otDw7WR_m4IO3w&oe=6A8D882E"}, {"file_name": "screenshot_2560x1440_04.png", "id": "1692932094965269", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499618297_1692932098298602_7171383388243165638_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LEgPKOChumgQ7kNvwEV0A9S&_nc_oc=AdpXhNY7Zc_JhlTyjMj1zHedHguA6qF2WMWEKUR5ZHnJrxVVtfePwC-FyUYPvWr2siA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEoZMDnnStNPDL_L9yFrzKMv5w3vi0R6sVo8Q82ghCEiA&oe=6A8D7128"}, {"file_name": "screenshot_2560x1440_01.png", "id": "952606510468970", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499619685_952606517135636_8047896386954430759_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xZAmo9uOrAkQ7kNvwF8OPOn&_nc_oc=AdowyY61TlCz6vZUHKhkLu-CTtPsjk6Zm73QTJblEpi9_d90cAaZtUHERzy6HLyHgFw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDk69Mjhim0Ru_ImJqLL7MMTf6YAm4vlQFkdBBlBeXww&oe=6A8D81F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape 2560x1440px.png", "id": "952628337349594", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491819417_952628340682927_7092126336638068634_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XbngumRNqVUQ7kNvwEOoV7w&_nc_oc=AdrCjzzgcW0yBlr4HA1CXFbrDRvz4eGSrCRdylmUO0HAlUwX6_BlJzjzBQEReDSgIMw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRRd9-7GQ0-AucWvkcmT1Wkzy_HitaK2Ki9pjH1JKAlQ&oe=6A8D6847"}, "display_name": "BeatGesture", "keywords": ["rhythm", "music", "beat", "handtracking", "gesture"], "long_description": "Step into a new dimension of rhythm.\n\nBeatGesture is a VR rhythm game where your hands are the controller. Match hand gestures, positions, and timing to the beat for a fully immersive experience.\n\n[Gesture-Based Gameplay] \nHit incoming notes by matching the correct hand shape, placing your hand in the right position, and timing it perfectly with the music. Simple to learn, deeply satisfying to master.\n\n[Expressive Controls]\nPlay using natural gestures like fists, open hands, thumbs up, and L-shapes. Direction-based variations and two-hand patterns add depth and challenge.\n\n[Dynamic Note Types]\nTap \u2013 Hit on beat\nHold \u2013 Maintain your gesture\nSwipe \u2013 Hit the note in the arrow direction\n\n[Game Modes]\nCampaign \u2013 Progress through increasingly challenging stages\nFree Play \u2013 Replay songs with selectable difficulty\n\nImmersive VR\nDesigned for Meta Quest hand tracking with stylized, rhythm-driven environments. Passthrough support available.\n\nFeel the beat.\nYour hands are the instrument.", "short_description": "Feel the rhythm with your hands.\nMatch gestures, hit the beat, and master immersive VR rhythm gameplay in BeatGesture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/beatgesture-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "LefthandDeveloper", "support_website_url": null, "website_url": "https://sites.google.com/view/beatgesture/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871
83760_2667262574431077871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bSEhACn6YlkQ7kNvwFdMBio&_nc_oc=AdpHgM0cBL-BW294w_KtSt3jZ3CxHTsPsEQzldoz07ZgB_ENTYxgSnMULxO3qeJPbN8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8YGbwy05WwH_RbH7M6OWkCKM3NA6Q-6SvTDxVFNlcnw&oe=6A9EDA14"}, {"file_name": "screenshot_2560x1440_02.png", "id": "669054496302012", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618910_669054502968678_12487198628138138_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VTfPZ6Asn04Q7kNvwE0U-Vh&_nc_oc=Adq-CHL-EMqCtsYIF9tbWgRdNQtOmoY2HtsDIHCIzDQ6VzHj6gAKIcohHFMMjWKQ3nM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI6Xi4y_1VveHVfqbyGZeuvjIeRpuGh4mii2rzZyZMLHg&oe=6A9EE3EE"}, {"file_name": "screenshot_2560x1440_04.png", "id": "1692932094965269", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618297_1692932098298602_7171383388243165638_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2gOz2wAJrg0Q7kNvwGvf5Y7&_nc_oc=AdopcwEfLMOUUPKJ_EIGB1e9_C8E3jACGXbFVd4oW-s3mIJI7wGwoUf1nra20Bdmxvk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJRsH7PbNF03XPZ5ivCkqc8KNVB9LW5UlOxziZF5GW1HA&oe=6A9ECCE8"}, {"file_name": "screenshot_2560x1440_01.png", "id": "952606510468970", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619685_952606517135636_8047896386954430759_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fuY7CpHil7UQ7kNvwHpTuzz&_nc_oc=Adr395rg3WQS8w9j3EdG0_bb39KeEIpZa9-gyMEiCVySciL6uyef4MWE807G-yEAXmg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPkAcYVBklYWCd_QIky5vM-mizT7Z-aZmLKozhe162BA&oe=6A9EDDB9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape 2560x1440px.png", "id": "952628337349594", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819417_952628340682927_7092126336638068634_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ONqH3udagDcQ7kNvwEZHBEt&_nc_oc=AdpwPKT970QOJH22IDP8mOVf5LcT0dbAZg3foz7DimdSUAu9D7YWTjOj7DSJdyEelTg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5fJg2X-2T22sfXi_bl996XxpIFWlZcFqPsbt4NxoSvg&oe=6A9EC407"}, "display_name": "BeatGesture", "keywords": ["rhythm", "music", "beat", "handtracking", "gesture"], "long_description": "Step into a new dimension of rhythm.\n\nBeatGesture is a VR rhythm game where your hands are the controller. Match hand gestures, positions, and timing to the beat for a fully immersive experience.\n\n[Gesture-Based Gameplay] \nHit incoming notes by matching the correct hand shape, placing your hand in the right position, and timing it perfectly with the music. Simple to learn, deeply satisfying to master.\n\n[Expressive Controls]\nPlay using natural gestures like fists, open hands, thumbs up, and L-shapes. Direction-based variations and two-hand patterns add depth and challenge.\n\n[Dynamic Note Types]\nTap \u2013 Hit on beat\nHold \u2013 Maintain your gesture\nSwipe \u2013 Hit the note in the arrow direction\n\n[Game Modes]\nCampaign \u2013 Progress through increasingly challenging stages\nFree Play \u2013 Replay songs with selectable difficulty\n\nImmersive VR\nDesigned for Meta Quest hand tracking with stylized, rhythm-driven environments. Passthrough support available.\n\nFeel the beat.\nYour hands are the instrument.", "short_description": "Feel the rhythm with your hands.\nMatch gestures, hit the beat, and master immersive VR rhythm gameplay in BeatGesture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/beatgesture-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "LefthandDeveloper", "support_website_url": null, "website_url": "https://sites.google.com/view/beatgesture/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "15921
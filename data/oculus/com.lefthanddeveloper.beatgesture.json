712572558_7058001035126764018_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jv2fyR9XsToQ7kNvwFK0Xpe&_nc_oc=AdpTklld0-8TrpOMn99j1gl_yx7Ap9LOcsIC7yZR6nTi-yUWfnzk5e9GnCzO4XKShIQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3RTL5BSCOFuOVv2XUvTzjeOwYLcDEWP_myW3TpKExtQ&oe=6AB12B16"}, {"file_name": "screenshot_2560x1440_03_v2.png", "id": "3419503744896967", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499623179_3419503748230300_6824419827252677977_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V0KR5vONSmsQ7kNvwFZYa15&_nc_oc=Adozi_LtbHoQqJROJGb6G-LuDv7cuy5fkv_TDE0NgF-Ad9odanLrU3g0JcaTlWnTmbg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFLb-xcLnXJXsIYXbUI9XbrnZFTsAR-ylFqkx0bMYbPg&oe=6AB15065"}, {"file_name": "screenshot_2560x1440_02.png", "id": "669054496302012", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618910_669054502968678_12487198628138138_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3DqDJ6hijvsQ7kNvwFxkr64&_nc_oc=Adr1_niJkQFF3QjNwy1CZeyt_LPdU0q9FsTd4erptn0qEIoCcP2-iPiNTZ9Zv7x2xv0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3k-JECJi__iTvXsOUMeGqkCDrr3OhxhzGQ2dGEse7OA&oe=6AB158EE"}, {"file_name": "screenshot_2560x1440_04.png", "id": "1692932094965269", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618297_1692932098298602_7171383388243165638_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h1ZyKojlBDwQ7kNvwGI1k14&_nc_oc=AdriNQqRqXdgg69vQ6sLHDmSEKnwDDetquwgGMtCbyV2yPJOV-_t4h8FKRgutSbRbic&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIwFCbx3yvrofQZ-MQ5MACr1auWVST3B4KhMULhFWbscw&oe=6AB141E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape 2560x1440px.png", "id": "952628337349594", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819417_952628340682927_7092126336638068634_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ABi-mVFZNcQQ7kNvwHVrpCQ&_nc_oc=AdpMlC8gmj96sRX5pAE_R76LOlbYr9YP4rzdXjHnWyymngnpqNDirlSQbY9dciXABtU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKE7myyTHCK08Gx0bgXqDDT2tE5rmTMS4OseK_EmexJzg&oe=6AB13907"}, "display_name": "BeatGesture", "keywords": ["rhythm", "music", "beat", "handtracking", "gesture"], "long_description": "Step into a new dimension of rhythm.\n\nBeatGesture is a VR rhythm game where your hands are the controller. Match hand gestures, positions, and timing to the beat for a fully immersive experience.\n\nDesigned for Meta Quest hand tracking with stylized, rhythm-driven environments.\n\n{2229418921186635}\n\n[Gesture-Based Gameplay] \n\nHit incoming notes by matching the correct hand shape, placing your hand in the right position, and timing it perfectly with the music. Simple to learn, deeply satisfying to master.\n\n[Expressive Controls]\n\nPlay using natural gestures like fists, open hands, thumbs up, and L-shapes. Direction-based variations and two-hand patterns add depth and challenge.\n\n[Dynamic Note Types]\n\nTap \u2013 Hit on beat\n\nHold \u2013 Maintain your gesture\n\nSwipe \u2013 Hit the note in the arrow direction\n\n\n[Game Modes]\n\nCampaign \u2013 Progress through increasingly challenging stages\n\nFree Play \u2013 Replay songs with selectable difficulty\n\nPassthrough support available.\n\nFeel the beat.\n\nYour hands are the instrument.\n", "short_description": "Feel the rhythm with your hands.\nMatch gestures, hit the beat, and master immersive VR rhythm gameplay in BeatGesture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/beatgesture-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "LefthandDeveloper", "support_website_url": null, "website_url": "https://sites.google.com/view/beatgesture/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {
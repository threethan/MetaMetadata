1_1066714712572558_7058001035126764018_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=srAnJrPF5xcQ7kNvwGh0R7y&_nc_oc=AdougJ1NnG0lA0BDHhNZrAcjAEn_c_pLBrUw889ZaMybQYSny1tnoJ7EzkR1e2sfGTM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKzCVD6T2HbAp5g9o0POFSHXx8Rr7Wth13I0OpJw9shZA&oe=6AAE8816"}, {"file_name": "screenshot_2560x1440_03_v2.png", "id": "3419503744896967", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499623179_3419503748230300_6824419827252677977_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V0KR5vONSmsQ7kNvwGxS7Md&_nc_oc=Adp_TOCTCu9F6BrKjmcQIh3NsV2oJAzAvk2bdT2nROCgfMUYYYgwt33tD2lfjQBq3SQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7pwp9lLvb-Ur_OvRUmjNAOieThby-7oj6n05Rtxrtcw&oe=6AAEAD65"}, {"file_name": "screenshot_2560x1440_02.png", "id": "669054496302012", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499618910_669054502968678_12487198628138138_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3DqDJ6hijvsQ7kNvwFhYAS0&_nc_oc=AdrJ1NbsjGOu6Oo8dT6_2K_SxpL07tEWhVBMxcW7MFe5evXgjas3KHDlL23AA8iABDo&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqrXfpgIYF8YtJh8Ji2BQLhqIerk3s4Y9ahlSkhyMZKQ&oe=6AAE7DAE"}, {"file_name": "screenshot_2560x1440_04.png", "id": "1692932094965269", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499618297_1692932098298602_7171383388243165638_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dGiolZWZaBwQ7kNvwGE0djF&_nc_oc=Adq0T3AtOexsP1K_m8yVdCu5v2BLwGRTsm0E-jyLKi4Ii_hzpM_PmkmqU2YIVfynCj4&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBcbitUWXFCuW-9HA0AitW-WGB3qagxenPldQ8CVuHGw&oe=6AAE9EE8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape 2560x1440px.png", "id": "952628337349594", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491819417_952628340682927_7092126336638068634_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ABi-mVFZNcQQ7kNvwFDzLg0&_nc_oc=AdqpOsJhmMevzaEutIE2rDS6YVqIv8W3iz6gHANNHpIL4uQW4gEAQR13U7Mm1oQYQh8&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIoiJjaxBQyKmfVQMGJs0c6QTrkrNP94SH7lb3w7SmdRA&oe=6AAE9607"}, "display_name": "BeatGesture", "keywords": ["rhythm", "music", "beat", "handtracking", "gesture"], "long_description": "Step into a new dimension of rhythm.\n\nBeatGesture is a VR rhythm game where your hands are the controller. Match hand gestures, positions, and timing to the beat for a fully immersive experience.\n\nDesigned for Meta Quest hand tracking with stylized, rhythm-driven environments.\n\n{2229418921186635}\n\n[Gesture-Based Gameplay] \n\nHit incoming notes by matching the correct hand shape, placing your hand in the right position, and timing it perfectly with the music. Simple to learn, deeply satisfying to master.\n\n[Expressive Controls]\n\nPlay using natural gestures like fists, open hands, thumbs up, and L-shapes. Direction-based variations and two-hand patterns add depth and challenge.\n\n[Dynamic Note Types]\n\nTap \u2013 Hit on beat\n\nHold \u2013 Maintain your gesture\n\nSwipe \u2013 Hit the note in the arrow direction\n\n\n[Game Modes]\n\nCampaign \u2013 Progress through increasingly challenging stages\n\nFree Play \u2013 Replay songs with selectable difficulty\n\nPassthrough support available.\n\nFeel the beat.\n\nYour hands are the instrument.\n", "short_description": "Feel the rhythm with your hands.\nMatch gestures, hit the beat, and master immersive VR rhythm gameplay in BeatGesture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/beatgesture-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "LefthandDeveloper", "support_website_url": null, "website_url": "https://sites.google.com/view/beatgesture/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "45978150
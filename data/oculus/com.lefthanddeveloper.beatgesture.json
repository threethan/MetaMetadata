83760_2667262574431077871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-YdJ-Ub3-sIQ7kNvwEAHqq0&_nc_oc=AdrHwo2zlp-eafJ0TbYikMeTG7RkVHwr6JR3UYj1CvQru8fz3_Jk94b3EaPn4T1Aii8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjcWu4Cn8jltnYG7vXvxCXdPfpT9ksh7_TIhJlpnwOHw&oe=6A9415D4"}, {"file_name": "screenshot_2560x1440_02.png", "id": "669054496302012", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499618910_669054502968678_12487198628138138_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Du9pNxMKK_kQ7kNvwG3ZIQY&_nc_oc=AdrUEN0HSQ3oE5Ly9FqRLBqKvhasdF1LW6mROgom9W3kn80zCKQFrfEugw079XcKpcs&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHm2tYge1UbJoe5tdmtYwUDnSkyw7UBCEy8OhOpW8u6gA&oe=6A941FAE"}, {"file_name": "screenshot_2560x1440_04.png", "id": "1692932094965269", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499618297_1692932098298602_7171383388243165638_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VnZlVtu_ocwQ7kNvwFCUFMg&_nc_oc=AdqXc0vJBuqVX6eWn8Kpp_OlpZ_V29Wwqw-78rWnDsr9TAqYa8RxoAUAKaamxdBBNqM&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGTdz3IHgJ-pR5zb-1C_y3aIq9gfJ-Ctr1Vrt2yTX1-UA&oe=6A9408A8"}, {"file_name": "screenshot_2560x1440_01.png", "id": "952606510468970", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499619685_952606517135636_8047896386954430759_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SJwY8KVxqiQQ7kNvwEld5Yd&_nc_oc=AdqIP1OvWn3zjqN2fKGceWcFpi_v_tc4cRYfFrnLYfA-9_2BwSvx_HYZeKzIeM7_ICg&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5xsj7I2Oxket3nOtj7s9BTxy6ykw9uF3zd2JfcCuP-A&oe=6A941979"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape 2560x1440px.png", "id": "952628337349594", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/491819417_952628340682927_7092126336638068634_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eyZL5sCjHbgQ7kNvwHjlJVC&_nc_oc=AdqWxGmO9MxPdIs_lpzGSLvl3l4Sha3Cvh_iMyuqxAI1wg8N5QVjHL01It_BTdHp56A&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEixp5CGivoAZ4JkIbhM3Nng6tf5oQh1xjR0AV7V1Zv7Q&oe=6A93FFC7"}, "display_name": "BeatGesture", "keywords": ["rhythm", "music", "beat", "handtracking", "gesture"], "long_description": "Step into a new dimension of rhythm.\n\nBeatGesture is a VR rhythm game where your hands are the controller. Match hand gestures, positions, and timing to the beat for a fully immersive experience.\n\n[Gesture-Based Gameplay] \nHit incoming notes by matching the correct hand shape, placing your hand in the right position, and timing it perfectly with the music. Simple to learn, deeply satisfying to master.\n\n[Expressive Controls]\nPlay using natural gestures like fists, open hands, thumbs up, and L-shapes. Direction-based variations and two-hand patterns add depth and challenge.\n\n[Dynamic Note Types]\nTap \u2013 Hit on beat\nHold \u2013 Maintain your gesture\nSwipe \u2013 Hit the note in the arrow direction\n\n[Game Modes]\nCampaign \u2013 Progress through increasingly challenging stages\nFree Play \u2013 Replay songs with selectable difficulty\n\nImmersive VR\nDesigned for Meta Quest hand tracking with stylized, rhythm-driven environments. Passthrough support available.\n\nFeel the beat.\nYour hands are the instrument.", "short_description": "Feel the rhythm with your hands.\nMatch gestures, hit the beat, and master immersive VR rhythm gameplay in BeatGesture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/beatgesture-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "LefthandDeveloper", "support_website_url": null, "website_url": "https://sites.google.com/view/beatgesture/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "15921
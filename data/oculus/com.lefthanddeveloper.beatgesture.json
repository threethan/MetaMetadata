ng", "id": "669054496302012", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499618910_669054502968678_12487198628138138_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=weWhM6QEdz0Q7kNvwGVvt7U&_nc_oc=Adrpf6OVmN3NL3jxaubgZ_FSGxJqXG094cPl9V1QVt2PWwzYr1ql2erlvy91VYybWh0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5pKfYq9InR1_tisiYIRZgM1TXGZ0O8oK7eAwKKQXDz6Q&oe=69FDD4AE"}, {"file_name": "screenshot_2560x1440_03.png", "id": "1011394704910988", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499618293_1011394708244321_271218965032337833_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DzjSwdrDefcQ7kNvwFQFrEB&_nc_oc=AdryHD7Bkds3mrzUc6qkJd7PgDbppS9QOVGllT-I8902E1M9ZneDg_DeiseKv5412zA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6fBguzT7ZMiNx03JUnhfi-2w4oLoby2y1hk8WgVm2mbg&oe=69FDD7C5"}, {"file_name": "screenshot_2560x1440_04.png", "id": "2373983199774401", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619098_2373983203107734_3118493041035305371_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rjcBr9bOP6UQ7kNvwHkDxEY&_nc_oc=AdpGph-MxjC5KCgPvAnN7AXfKi2ZTmv9Vo3_H73y-SiT_Ot3wIQpKOH8Yx4ER4RLrAk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5VKU-P25HthwDKwAwymWyimlf_b3iN8_TaWJrOkbNqfg&oe=69FDEEC8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape 2560x1440px.png", "id": "952628337349594", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491819417_952628340682927_7092126336638068634_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XjfllSMvR6IQ7kNvwHRyJBi&_nc_oc=AdrTNRvnSrKX1l-d_YMbYZ2uJRHPbAnu-N76zp6-Vq1meSxpJfkdUa33xpCJr2HQfPU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4PbAN6ngPNIpA1Yl6GElMVqZWIB9Gqjw3UpjL7kRhN7g&oe=69FDED07"}, "display_name": "BeatGesture", "keywords": ["rhythm", "music", "beat", "handtracking", "gesture"], "long_description": "Step into a new dimension of rhythm.\n\nBeatGesture is a VR rhythm game where your hands are the controller. Match hand gestures, positions, and timing to the beat for a fully immersive experience.\n\n[Gesture-Based Gameplay] \nHit incoming notes by matching the correct hand shape, placing your hand in the right position, and timing it perfectly with the music. Simple to learn, deeply satisfying to master.\n\n[Expressive Controls]\nPlay using natural gestures like fists, open hands, thumbs up, and L-shapes. Direction-based variations and two-hand patterns add depth and challenge.\n\n[Dynamic Note Types]\nTap \u2013 Hit on beat\nHold \u2013 Maintain your gesture\nSwipe \u2013 Hit the note in the arrow direction\n\n[Game Modes]\nCampaign \u2013 Progress through increasingly challenging stages\nFree Play \u2013 Replay songs with selectable difficulty\n\nImmersive VR\nDesigned for Meta Quest hand tracking with stylized, rhythm-driven environments. Passthrough support available.\n\nFeel the beat.\nYour hands are the instrument.", "short_description": "Feel the rhythm with your hands.\nMatch gestures, hit the beat, and master immersive VR rhythm gameplay in BeatGesture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/beatgesture-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "LefthandDeveloper", "support_website_url": null, "website_url": "https://sites.google.com/view/beatgesture/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_p
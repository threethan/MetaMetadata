ng", "id": "669054496302012", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618910_669054502968678_12487198628138138_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QQK_Wl9vACcQ7kNvwEGyDw-&_nc_oc=AdpOZ_WnURXmlsLEDzj7ANqHly-GOgz-gL5FL8_NVVQ7UiRQmIf68qjZBieAbXtbwn4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1xAVPzcpDQrz5BdngRmE8ljs10aDSpR-y8iXTmIixmhA&oe=69EB5FAE"}, {"file_name": "screenshot_2560x1440_03.png", "id": "1011394704910988", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618293_1011394708244321_271218965032337833_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3JJJXPsQW7YQ7kNvwFAFGt4&_nc_oc=Adq7kL8UFzVG1-mD8Uoe5UHUFAz5bz3jIzhx70jhBtyvsCp2I5OcoJU4ku1dcCCuseM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0EhaqEj1DfojVCyQ6Q9WQjZEFsgEoExgO7op3x8HVHJA&oe=69EB62C5"}, {"file_name": "screenshot_2560x1440_04.png", "id": "2373983199774401", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619098_2373983203107734_3118493041035305371_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GVfqOqUCPM0Q7kNvwHbd_xJ&_nc_oc=AdrUwmq_ANbIrnHF5WrB0aRdViTBpszbwriha0aaRH6Szuwyc70CK4kFQURLUx0ZfGg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1tiZa1f7yx1vnOIJ4eSNxo6CZ7IaGuiA7DFGF6VxZZ3w&oe=69EB79C8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape 2560x1440px.png", "id": "952628337349594", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819417_952628340682927_7092126336638068634_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BOsgBaKItp8Q7kNvwHvLyvB&_nc_oc=Adq2sh0TkeelAd9YhBCdGkuxfSRaiBPqL2I9XCoLiflsI2HKbbtMgPLQIhv6QZxFWMM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0NT4cS5EMNuTaoPZOPmXnHvH6CB2lQQfwTHNixnV2beQ&oe=69EB7807"}, "display_name": "BeatGesture", "keywords": ["rhythm", "music", "beat", "handtracking", "gesture"], "long_description": "Step into a new dimension of rhythm.\n\nBeatGesture is a VR rhythm game where your hands are the controller. Match hand gestures, positions, and timing to the beat for a fully immersive experience.\n\n[Gesture-Based Gameplay] \nHit incoming notes by matching the correct hand shape, placing your hand in the right position, and timing it perfectly with the music. Simple to learn, deeply satisfying to master.\n\n[Expressive Controls]\nPlay using natural gestures like fists, open hands, thumbs up, and L-shapes. Direction-based variations and two-hand patterns add depth and challenge.\n\n[Dynamic Note Types]\nTap \u2013 Hit on beat\nHold \u2013 Maintain your gesture\nSwipe \u2013 Hit the note in the arrow direction\n\n[Game Modes]\nCampaign \u2013 Progress through increasingly challenging stages\nFree Play \u2013 Replay songs with selectable difficulty\n\nImmersive VR\nDesigned for Meta Quest hand tracking with stylized, rhythm-driven environments. Passthrough support available.\n\nFeel the beat.\nYour hands are the instrument.", "short_description": "Feel the rhythm with your hands.\nMatch gestures, hit the beat, and master immersive VR rhythm gameplay in BeatGesture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/beatgesture-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "LefthandDeveloper", "support_website_url": null, "website_url": "https://sites.google.com/view/beatgesture/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_p
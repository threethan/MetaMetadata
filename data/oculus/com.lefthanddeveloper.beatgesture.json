1_1066714712572558_7058001035126764018_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2SdmBM9hQ7UQ7kNvwFdpE_9&_nc_oc=Adpw2xymYUU9W6S7sbMq54oxvcMTfUCB4Ce8WCcjp7-4upIC1N-g7az33EKZtQqPO50&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMfuyLeYH9fwKjZBpFbB5uyuuQXTJDleAbToB233DNEQ&oe=6AA94216"}, {"file_name": "screenshot_2560x1440_03_v2.png", "id": "3419503744896967", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499623179_3419503748230300_6824419827252677977_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AMAO1F7FMzoQ7kNvwEoyecB&_nc_oc=Adr465hCy6bXmJepN6QaxAQa7f7Pq5mlukzrdZVPedvoAqeZTEkR2w7IoXWAhpFO-H0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSVs4BQ8qyBQQY6hataL95qwMI3EOWbDucxYfwCKlJ5Q&oe=6AA96765"}, {"file_name": "screenshot_2560x1440_02.png", "id": "669054496302012", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499618910_669054502968678_12487198628138138_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eqzHbvHriJkQ7kNvwGPXPHJ&_nc_oc=AdpUP1whE204t2anjXiNXQ9Trqz_ErugusBRheauIFOgK-5bfWGljPqDB9sba4-UXWs&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKinzdaRvcBlr3c5UcmGCGPfigFuReCfR8uoJGh83Xd3w&oe=6AA937AE"}, {"file_name": "screenshot_2560x1440_04.png", "id": "1692932094965269", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499618297_1692932098298602_7171383388243165638_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ysjaEQUQJbkQ7kNvwFHyEos&_nc_oc=Adq27bcr7OFk3DKzz0LkrnXb4U8AxOeDGdjIc-A0JLCs3egprrD0iHJoCkrhUkQ9RU4&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpA_amEHLCfaipzNSCJggrV5E56tDlaK8h1cRS0IWS1A&oe=6AA958E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape 2560x1440px.png", "id": "952628337349594", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491819417_952628340682927_7092126336638068634_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Kdb8hyedgUQ7kNvwHNHGlH&_nc_oc=AdqSg3qsUxtOePSQtCLsFinQ-OKPPyjPWOoGLdI-6CZUrhFUH9-oQGqN7gEgrP0Zx4g&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdyh1xk7u51FeHpSFNsRyTW7UklYnG0d5W7QjwVjaehg&oe=6AA95007"}, "display_name": "BeatGesture", "keywords": ["rhythm", "music", "beat", "handtracking", "gesture"], "long_description": "Step into a new dimension of rhythm.\n\nBeatGesture is a VR rhythm game where your hands are the controller. Match hand gestures, positions, and timing to the beat for a fully immersive experience.\n\nDesigned for Meta Quest hand tracking with stylized, rhythm-driven environments.\n\n{2229418921186635}\n\n[Gesture-Based Gameplay] \n\nHit incoming notes by matching the correct hand shape, placing your hand in the right position, and timing it perfectly with the music. Simple to learn, deeply satisfying to master.\n\n[Expressive Controls]\n\nPlay using natural gestures like fists, open hands, thumbs up, and L-shapes. Direction-based variations and two-hand patterns add depth and challenge.\n\n[Dynamic Note Types]\n\nTap \u2013 Hit on beat\n\nHold \u2013 Maintain your gesture\n\nSwipe \u2013 Hit the note in the arrow direction\n\n\n[Game Modes]\n\nCampaign \u2013 Progress through increasingly challenging stages\n\nFree Play \u2013 Replay songs with selectable difficulty\n\nPassthrough support available.\n\nFeel the beat.\n\nYour hands are the instrument.\n", "short_description": "Feel the rhythm with your hands.\nMatch gestures, hit the beat, and master immersive VR rhythm gameplay in BeatGesture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/beatgesture-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "LefthandDeveloper", "support_website_url": null, "website_url": "https://sites.google.com/view/beatgesture/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "45978150
zTURaQawQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNm3JCPQJ6G84rFheCO7wAN4I_lBdszta4E3m6iDXLS1Q&oe=6AC7C585"}, {"file_name": "screenshot_2560x1440_04.png", "id": "2373983199774401", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619098_2373983203107734_3118493041035305371_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-i4V7RALCkYQ7kNvwGSZzTu&_nc_oc=AdqTo93gp9fmPpJIHyEQuq2U07S03pcVqq-dpXJa5EiD-A0jDvAM-qQ87151CTghlaU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQODnGVWUEPsckA-oLkWpR77Wet16i_zAxiGB2UzYp_D1g&oe=6AC7A448"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape 2560x1440px.png", "id": "952628337349594", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491819417_952628340682927_7092126336638068634_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4LyBoM8Oo_EQ7kNvwFUEe-Y&_nc_oc=AdqtZIBucnGKiomBIBWlEzwxw1ACYFTx6VRvEhCdkGmZjrdR-LDbwTV14Oso78NTj-k&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOU5QcV1Wwyuz84kL4gya0c0MfGtCt9dXGhWtIbkIktzg&oe=6AC7A287"}, "display_name": "BeatGesture", "keywords": ["rhythm", "music", "beat", "handtracking", "gesture"], "long_description": "Step into a new dimension of rhythm.\n\nBeatGesture is a VR rhythm game where your hands are the controller. Match hand gestures, positions, and timing to the beat for a fully immersive experience.\n\n[Gesture-Based Gameplay] \nHit incoming notes by matching the correct hand shape, placing your hand in the right position, and timing it perfectly with the music. Simple to learn, deeply satisfying to master.\n\n[Expressive Controls]\nPlay using natural gestures like fists, open hands, thumbs up, and L-shapes. Direction-based variations and two-hand patterns add depth and challenge.\n\n[Dynamic Note Types]\nTap \u2013 Hit on beat\nHold \u2013 Maintain your gesture\nSwipe \u2013 Hit the note in the arrow direction\n\n[Game Modes]\nCampaign \u2013 Progress through increasingly challenging stages\nFree Play \u2013 Replay songs with selectable difficulty\n\nImmersive VR\nDesigned for Meta Quest hand tracking with stylized, rhythm-driven environments. Passthrough support available.\n\nFeel the beat.\nYour hands are the instrument.", "short_description": "Feel the rhythm with your hands.\nMatch gestures, hit the beat, and master immersive VR rhythm gameplay in BeatGesture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/beatgesture-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "LefthandDeveloper", "support_website_url": null, "website_url": "https://sites.google.com/view/beatgesture/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35694766050122375"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "2515588852247806"}, {"status": "PUBLISHED", "id": "1723303695661850"}, {"status": "PUBLISHED", "id": "983294301238044"}, {"status": "PUBLISHED", "id": "738589209279858"}, {"status": "PUBLISHED", "id": "1584496899310597"}, {"status": "PUBLISHED", "id": "1680768333085894"}]}, "baseline_offer": {"id": "1680768333085894"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792774800, "status": "PUBLISHED", "id": "2515588852247806"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"
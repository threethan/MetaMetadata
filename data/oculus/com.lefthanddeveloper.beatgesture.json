712572558_7058001035126764018_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=srAnJrPF5xcQ7kNvwG5svVL&_nc_oc=AdrDtYpsb2x90Dm1EeZEMpbKEQzFV30d_qjXx9JN0zQpno6e5YGbrfmcUwayphWdxKk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLN69uxah0ALpqn0aVeP036f082BUKsf1Zfv_s-pwSqqQ&oe=6AAD3696"}, {"file_name": "screenshot_2560x1440_03_v2.png", "id": "3419503744896967", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499623179_3419503748230300_6824419827252677977_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VbJ_wXGxv6sQ7kNvwH8PIU7&_nc_oc=AdqlNoBwyqOQ7PjXDRfisf2Ko_sxTr_W0Hl6514XOs2rfbMv70ylVzo2WzyI-klhr-Q&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI6srtYuOGFtP6BgSuSHuuJiqmcMSGw6ik1hySarMcJag&oe=6AAD5BE5"}, {"file_name": "screenshot_2560x1440_02.png", "id": "669054496302012", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618910_669054502968678_12487198628138138_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xnW3dIubYEIQ7kNvwHUS5OA&_nc_oc=Adp8idmMlQDX_rIg7LpoveUsWkKPXq5TkYSDUUwpV4DLQDJHZNx9uUC204aPZTwpdEk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0kQgFVFv3uyewEUcVnaKtAalzJhWqBMukdNJzh__Naw&oe=6AAD2C2E"}, {"file_name": "screenshot_2560x1440_04.png", "id": "1692932094965269", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618297_1692932098298602_7171383388243165638_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dGiolZWZaBwQ7kNvwE1Jvwc&_nc_oc=Adrp_eA8a02JthXg5pK0f__BiT-tIY1x3D6JF5VdrFwHx8pXhVelqkqRVTw3sc3VdRk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-Jm-I6TZ4Hopp33q29VHfTSo1phc9Q-A65LNPNdLxxA&oe=6AAD4D68"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape 2560x1440px.png", "id": "952628337349594", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491819417_952628340682927_7092126336638068634_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bKd94ypVg2wQ7kNvwEOWtfT&_nc_oc=AdqdhjRnW7zPiXD8tl4ZlZxCoyF0IrIf74UZU2txKa1yK_YYsx_E5Z1y-7RhmQ9mcUA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUp0e7FF4WidaO9eC8vsEBXq55Fb4YIvC7EMqG3ih7Rg&oe=6AAD4487"}, "display_name": "BeatGesture", "keywords": ["rhythm", "music", "beat", "handtracking", "gesture"], "long_description": "Step into a new dimension of rhythm.\n\nBeatGesture is a VR rhythm game where your hands are the controller. Match hand gestures, positions, and timing to the beat for a fully immersive experience.\n\nDesigned for Meta Quest hand tracking with stylized, rhythm-driven environments.\n\n{2229418921186635}\n\n[Gesture-Based Gameplay] \n\nHit incoming notes by matching the correct hand shape, placing your hand in the right position, and timing it perfectly with the music. Simple to learn, deeply satisfying to master.\n\n[Expressive Controls]\n\nPlay using natural gestures like fists, open hands, thumbs up, and L-shapes. Direction-based variations and two-hand patterns add depth and challenge.\n\n[Dynamic Note Types]\n\nTap \u2013 Hit on beat\n\nHold \u2013 Maintain your gesture\n\nSwipe \u2013 Hit the note in the arrow direction\n\n\n[Game Modes]\n\nCampaign \u2013 Progress through increasingly challenging stages\n\nFree Play \u2013 Replay songs with selectable difficulty\n\nPassthrough support available.\n\nFeel the beat.\n\nYour hands are the instrument.\n", "short_description": "Feel the rhythm with your hands.\nMatch gestures, hit the beat, and master immersive VR rhythm gameplay in BeatGesture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/beatgesture-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "LefthandDeveloper", "support_website_url": null, "website_url": "https://sites.google.com/view/beatgesture/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {
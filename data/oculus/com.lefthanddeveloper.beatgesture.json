ng", "id": "669054496302012", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499618910_669054502968678_12487198628138138_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cCKSMvL_IQcQ7kNvwFv8XCq&_nc_oc=AdraPZ1spRHR_yzd2VLZh-R0RIRkNp7pk6vCHupf5gOuaNkAH1zV8Lyl_dM5bHM4FJg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3mc-Vvvp-UQYjoCHmhQP-_WhfAprsRBnfyH-WNA2YlcA&oe=69F49A2E"}, {"file_name": "screenshot_2560x1440_03.png", "id": "1011394704910988", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499618293_1011394708244321_271218965032337833_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wYOfwOYRDPQQ7kNvwHV1anI&_nc_oc=AdpvYMw7hGABLp1CVd35br28uBs6pR9C04S8oppbhnSAX_Wu1VMQ1PEgz9JjxRSfKO4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2oGlnRXrFWNOZ0mrCmOzHu7cDlpM8Gz2PnH-kbuGyb_Q&oe=69F49D45"}, {"file_name": "screenshot_2560x1440_04.png", "id": "2373983199774401", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619098_2373983203107734_3118493041035305371_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d6VMEfcswfwQ7kNvwG07BKM&_nc_oc=AdoKWotVQvP6HR3Sdhh9oRxg91VARNwqKlBbVroJ41KMP3nhsXjx6rFg6cnbW3iX0B0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2UigdJo7PSvU-nIXCUwoX6tjDt3uf5uMkR9JAQ9seE1w&oe=69F4B448"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape 2560x1440px.png", "id": "952628337349594", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491819417_952628340682927_7092126336638068634_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LRciyARLz00Q7kNvwHZU4f_&_nc_oc=Adq-IFwgT7-8RQ5ws19lFxR-ztfXnWRDaPrc3y5PqIaUXY9YYUNsxxquSmOCWl9TCPc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af00TyiKflZVfWrJf1j9uxrEgg38iIbZOzwnqKeQDhvRLA&oe=69F4B287"}, "display_name": "BeatGesture", "keywords": ["rhythm", "music", "beat", "handtracking", "gesture"], "long_description": "Step into a new dimension of rhythm.\n\nBeatGesture is a VR rhythm game where your hands are the controller. Match hand gestures, positions, and timing to the beat for a fully immersive experience.\n\n[Gesture-Based Gameplay] \nHit incoming notes by matching the correct hand shape, placing your hand in the right position, and timing it perfectly with the music. Simple to learn, deeply satisfying to master.\n\n[Expressive Controls]\nPlay using natural gestures like fists, open hands, thumbs up, and L-shapes. Direction-based variations and two-hand patterns add depth and challenge.\n\n[Dynamic Note Types]\nTap \u2013 Hit on beat\nHold \u2013 Maintain your gesture\nSwipe \u2013 Hit the note in the arrow direction\n\n[Game Modes]\nCampaign \u2013 Progress through increasingly challenging stages\nFree Play \u2013 Replay songs with selectable difficulty\n\nImmersive VR\nDesigned for Meta Quest hand tracking with stylized, rhythm-driven environments. Passthrough support available.\n\nFeel the beat.\nYour hands are the instrument.", "short_description": "Feel the rhythm with your hands.\nMatch gestures, hit the beat, and master immersive VR rhythm gameplay in BeatGesture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/beatgesture-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "LefthandDeveloper", "support_website_url": null, "website_url": "https://sites.google.com/view/beatgesture/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_p
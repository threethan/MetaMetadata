712572558_7058001035126764018_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JLEVqu2e7UYQ7kNvwFbgWCp&_nc_oc=AdropOaXdve9qdUoely-hurxlwol9eN70TuZEjHLXB4xss8FAhwJlwi-3zD35c9f98k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMP8M9c3y56mx4AkLmdyqlF19O9RamxIwS1rzSklmdl5A&oe=6ACD12D6"}, {"file_name": "screenshot_2560x1440_03_v2.png", "id": "3419503744896967", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499623179_3419503748230300_6824419827252677977_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uJWloeZkhlIQ7kNvwEuolJe&_nc_oc=AdpPoVAu4ua41i64gqGSmBuHl6eZp_WaMhcrnGKpnJzU-nXt05APDx5hknssemiRUz8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMxwR5Eq3v4ne7GhBVXWMdsE0rGiHn38GEy-L7rI2xzKA&oe=6ACCFFE5"}, {"file_name": "screenshot_2560x1440_02.png", "id": "669054496302012", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618910_669054502968678_12487198628138138_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BzcRrbrSgCMQ7kNvwGeQ2at&_nc_oc=AdpvOoTMOgkrxO3Ji4IIZ6ghigyboaKA2oeTXJisGcQSa6aYz0kjmZ4vcKW1HPuqfcU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNmg1_L7jhj-9aOSwUozmfyWi5JdPFvXQlEP6yeN52Dkw&oe=6ACD086E"}, {"file_name": "screenshot_2560x1440_04.png", "id": "1692932094965269", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618297_1692932098298602_7171383388243165638_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BjpCCIfcD70Q7kNvwHLomMr&_nc_oc=AdoOCATc3cNt4KWXa96Dqh2BgMRLZP3YF4L52YLrclBpPQMr2y57iNHVeXAQQ4CCy-k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNE_-HGoPLDmP_A2tz_vXufmSgpv-TsscRwwG_LchArQ&oe=6ACCF168"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape 2560x1440px.png", "id": "952628337349594", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819417_952628340682927_7092126336638068634_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B4C8OJK-3_cQ7kNvwGa2OSR&_nc_oc=AdosKPpbpyFzUVN88YF__vbkmKiVNXFiWBjA6MTuZZSUs3QskZQCiebuaK6o7tvV-Gs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMtW0IEQFFDMFtH8Iv3uJz0xg_W8HtKiHBFQllmkmO_xA&oe=6ACCE887"}, "display_name": "BeatGesture", "keywords": ["rhythm", "music", "beat", "handtracking", "gesture"], "long_description": "Step into a new dimension of rhythm.\n\nBeatGesture is a VR rhythm game where your hands are the controller. Match hand gestures, positions, and timing to the beat for a fully immersive experience.\n\nDesigned for Meta Quest hand tracking with stylized, rhythm-driven environments.\n\n{2229418921186635}\n\n[Gesture-Based Gameplay] \n\nHit incoming notes by matching the correct hand shape, placing your hand in the right position, and timing it perfectly with the music. Simple to learn, deeply satisfying to master.\n\n[Expressive Controls]\n\nPlay using natural gestures like fists, open hands, thumbs up, and L-shapes. Direction-based variations and two-hand patterns add depth and challenge.\n\n[Dynamic Note Types]\n\nTap \u2013 Hit on beat\n\nHold \u2013 Maintain your gesture\n\nSwipe \u2013 Hit the note in the arrow direction\n\n\n[Game Modes]\n\nCampaign \u2013 Progress through increasingly challenging stages\n\nFree Play \u2013 Replay songs with selectable difficulty\n\nPassthrough support available.\n\nFeel the beat.\n\nYour hands are the instrument.\n", "short_description": "Feel the rhythm with your hands.\nMatch gestures, hit the beat, and master immersive VR rhythm gameplay in BeatGesture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/beatgesture-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "LefthandDeveloper", "support_website_url": null, "website_url": "https://sites.google.com/view/beatgesture/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {
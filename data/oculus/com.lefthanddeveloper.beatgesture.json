.com&_nc_ss=7f20f&oh=00_Af6pCqvLSBix2df36ZWCd6ZXPn8_mtmELRD2R7JA9py5gQ&oe=69FF1FF9"}, {"file_name": "screenshot_2560x1440_02.png", "id": "669054496302012", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618910_669054502968678_12487198628138138_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=weWhM6QEdz0Q7kNvwFYe9LJ&_nc_oc=AdoLB_5xGhiABMzVepFQNtgP9CB7Il-VLFr-yvX1LE6TCFJ4shSB5_E8STOhKkN5sWA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6mbb4y1ogbfGczvSz64-dAwJhoWlXEcPgiHh4Gg6BFOw&oe=69FF262E"}, {"file_name": "screenshot_2560x1440_03.png", "id": "1011394704910988", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618293_1011394708244321_271218965032337833_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DzjSwdrDefcQ7kNvwEOykYk&_nc_oc=Adr1hXngHPNjqU9WAXNCLFsfmDy84jHV2daaWJVSF0HKWG-VWnJjf7XaLwF4nLpYzTU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Bii2rSjy3_h6sr2jRSwjD7LEqNWzmWpId2p4T-Gzptg&oe=69FF2945"}, {"file_name": "screenshot_2560x1440_04.png", "id": "2373983199774401", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619098_2373983203107734_3118493041035305371_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sRoAKUnBJV8Q7kNvwHeLTud&_nc_oc=Adqc3iGpbivkFDCXXmAiSO3T0NUpjuOQgByYiMjm2fO09aU_Nx6LFgBzdGL0a6yFAx8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7uX0UKAt1rQGEChJVa2eOlexWP2F_kfb8i7v5T9MhwSw&oe=69FF4048"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape 2560x1440px.png", "id": "952628337349594", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819417_952628340682927_7092126336638068634_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XjfllSMvR6IQ7kNvwF4ri5f&_nc_oc=AdptZaSJYvCo-aG8nKBo8YJ43KR1ZchuIIv0QxM6Z1KOEftXMM4hoN4q31ih7oDYEjM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6CBHZ2UeYZtfd4yzc1fNpBM7e_pT9BvPCcr6z6jeNB9A&oe=69FF3E87"}, "display_name": "BeatGesture", "keywords": ["rhythm", "music", "beat", "handtracking", "gesture"], "long_description": "Step into a new dimension of rhythm.\n\nBeatGesture is a VR rhythm game where your hands are the controller. Match hand gestures, positions, and timing to the beat for a fully immersive experience.\n\n[Gesture-Based Gameplay] \nHit incoming notes by matching the correct hand shape, placing your hand in the right position, and timing it perfectly with the music. Simple to learn, deeply satisfying to master.\n\n[Expressive Controls]\nPlay using natural gestures like fists, open hands, thumbs up, and L-shapes. Direction-based variations and two-hand patterns add depth and challenge.\n\n[Dynamic Note Types]\nTap \u2013 Hit on beat\nHold \u2013 Maintain your gesture\nSwipe \u2013 Hit the note in the arrow direction\n\n[Game Modes]\nCampaign \u2013 Progress through increasingly challenging stages\nFree Play \u2013 Replay songs with selectable difficulty\n\nImmersive VR\nDesigned for Meta Quest hand tracking with stylized, rhythm-driven environments. Passthrough support available.\n\nFeel the beat.\nYour hands are the instrument.", "short_description": "Feel the rhythm with your hands.\nMatch gestures, hit the beat, and master immersive VR rhythm gameplay in BeatGesture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/beatgesture-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "LefthandDeveloper", "support_website_url": null, "website_url": "https://sites.google.com/view/beatgesture/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
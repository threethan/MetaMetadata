712572558_7058001035126764018_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1UZDyLFOO9wQ7kNvwEjMesq&_nc_oc=AdouX75WR82vd5dqCsyPZ6E4TSescl5HzYlNNf47-wpE4Fh9qG-ES6YJPj810N2DaY8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP9h_UtmQ4gn-ZQwM4GnddEaP8dgEFugwr2mWkGm-Pihw&oe=6AC7CCD6"}, {"file_name": "screenshot_2560x1440_03_v2.png", "id": "3419503744896967", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499623179_3419503748230300_6824419827252677977_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BoML_tqo2L0Q7kNvwFmvj1k&_nc_oc=AdrWB2pROOL9vHB2Md22H7hn0vmJn_b3iXFEjOWZlplHyoSWktipvXItOath8NK8uIU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPM78loS2jUJIqWECbqviPhP5uGHPwcMs3ILlYdJkGbEA&oe=6AC7B9E5"}, {"file_name": "screenshot_2560x1440_02.png", "id": "669054496302012", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499618910_669054502968678_12487198628138138_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jA3JIERBRL4Q7kNvwGyE0o_&_nc_oc=AdptCFG0QFVh7CaNlG8gybrYBzdVcZBf9_ts3kozqLkyP8-IOWmdASsdXbL0nXNvTeU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP7ZYiAlATf7IIsFClNe22eh_hwQ45MB0yVMed4yUXyQA&oe=6AC7C26E"}, {"file_name": "screenshot_2560x1440_04.png", "id": "1692932094965269", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499618297_1692932098298602_7171383388243165638_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gD8uIf5jizUQ7kNvwF29NOz&_nc_oc=AdprMRAkBNurnGJErjUWxgz0l-i_bLIsEdatgdSUrrk9z4WFh4pA0tbUoPMAsP67CDs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIsomE_1T_-p7pH6ulxurZn5nC0iXAAKotz_HYJwyvkA&oe=6AC7AB68"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape 2560x1440px.png", "id": "952628337349594", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491819417_952628340682927_7092126336638068634_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4LyBoM8Oo_EQ7kNvwFUEe-Y&_nc_oc=AdqtZIBucnGKiomBIBWlEzwxw1ACYFTx6VRvEhCdkGmZjrdR-LDbwTV14Oso78NTj-k&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOU5QcV1Wwyuz84kL4gya0c0MfGtCt9dXGhWtIbkIktzg&oe=6AC7A287"}, "display_name": "BeatGesture", "keywords": ["rhythm", "music", "beat", "handtracking", "gesture"], "long_description": "Step into a new dimension of rhythm.\n\nBeatGesture is a VR rhythm game where your hands are the controller. Match hand gestures, positions, and timing to the beat for a fully immersive experience.\n\nDesigned for Meta Quest hand tracking with stylized, rhythm-driven environments.\n\n{2229418921186635}\n\n[Gesture-Based Gameplay] \n\nHit incoming notes by matching the correct hand shape, placing your hand in the right position, and timing it perfectly with the music. Simple to learn, deeply satisfying to master.\n\n[Expressive Controls]\n\nPlay using natural gestures like fists, open hands, thumbs up, and L-shapes. Direction-based variations and two-hand patterns add depth and challenge.\n\n[Dynamic Note Types]\n\nTap \u2013 Hit on beat\n\nHold \u2013 Maintain your gesture\n\nSwipe \u2013 Hit the note in the arrow direction\n\n\n[Game Modes]\n\nCampaign \u2013 Progress through increasingly challenging stages\n\nFree Play \u2013 Replay songs with selectable difficulty\n\nPassthrough support available.\n\nFeel the beat.\n\nYour hands are the instrument.\n", "short_description": "Feel the rhythm with your hands.\nMatch gestures, hit the beat, and master immersive VR rhythm gameplay in BeatGesture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/beatgesture-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "LefthandDeveloper", "support_website_url": null, "website_url": "https://sites.google.com/view/beatgesture/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {
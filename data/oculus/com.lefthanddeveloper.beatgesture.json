712572558_7058001035126764018_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mNx0RHKVqWwQ7kNvwGtrIW-&_nc_oc=Adr_pYr9lXnZs-Kx-ZttCMkNXYEfGw8WQerGSPuppPta8I1JESZY7Z1ZSOL4LrzBpZY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMzGTd8V30PgFmJddVjuWT0t9D6VrBUhXYHMljSB7ukyA&oe=6AC13556"}, {"file_name": "screenshot_2560x1440_03_v2.png", "id": "3419503744896967", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623179_3419503748230300_6824419827252677977_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AVbOREpp4_AQ7kNvwH4hE82&_nc_oc=Adp4dPpZNR2aK12EtryzWXKBpAGg9dAY_KUAAqaWRopTFV1RYX62CkZ2sINpybUhWW4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMn_d5jOdAPqegYcUv4yaIJK-oLRgPpzi3vc24lHLurRQ&oe=6AC12265"}, {"file_name": "screenshot_2560x1440_02.png", "id": "669054496302012", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618910_669054502968678_12487198628138138_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tjYi_af59F4Q7kNvwH43FW5&_nc_oc=AdqWkpVtWLuNIEGNkTP5I0NBjAJG6G3TGwsR-1UVFUU4C006HK382G_Mk60zhbJgQYg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNqEFrY0a5FrjUi6N-9DNQRrw91zj_YrHdQ6ZeP67mjuA&oe=6AC12AEE"}, {"file_name": "screenshot_2560x1440_04.png", "id": "1692932094965269", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618297_1692932098298602_7171383388243165638_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=scZiLZHCPloQ7kNvwHyLlJS&_nc_oc=Adr2BCw7RwcMsp5TWm0U-pPZafMGBR1bTUlOk4yK40Obz4tGWYMJYBUWhRkfUH7jaTY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNeX10OWyiUmroNCmuLyn8Su7cGTgcIzmnW4mfbWv8z1w&oe=6AC113E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape 2560x1440px.png", "id": "952628337349594", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819417_952628340682927_7092126336638068634_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rlFbYD0cpv4Q7kNvwFuswPT&_nc_oc=Adp7JveiLtkm_4lh_66NqqRBN3x4zBeFk443_zAKObAMKYhNjAVDcWSdrPWD4HuW-_A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMpZRIuGfKuWuYtR4-e4RC8DGgt4ww9ZVBYC9fqNxb8Nw&oe=6AC10B07"}, "display_name": "BeatGesture", "keywords": ["rhythm", "music", "beat", "handtracking", "gesture"], "long_description": "Step into a new dimension of rhythm.\n\nBeatGesture is a VR rhythm game where your hands are the controller. Match hand gestures, positions, and timing to the beat for a fully immersive experience.\n\nDesigned for Meta Quest hand tracking with stylized, rhythm-driven environments.\n\n{2229418921186635}\n\n[Gesture-Based Gameplay] \n\nHit incoming notes by matching the correct hand shape, placing your hand in the right position, and timing it perfectly with the music. Simple to learn, deeply satisfying to master.\n\n[Expressive Controls]\n\nPlay using natural gestures like fists, open hands, thumbs up, and L-shapes. Direction-based variations and two-hand patterns add depth and challenge.\n\n[Dynamic Note Types]\n\nTap \u2013 Hit on beat\n\nHold \u2013 Maintain your gesture\n\nSwipe \u2013 Hit the note in the arrow direction\n\n\n[Game Modes]\n\nCampaign \u2013 Progress through increasingly challenging stages\n\nFree Play \u2013 Replay songs with selectable difficulty\n\nPassthrough support available.\n\nFeel the beat.\n\nYour hands are the instrument.\n", "short_description": "Feel the rhythm with your hands.\nMatch gestures, hit the beat, and master immersive VR rhythm gameplay in BeatGesture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/beatgesture-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "LefthandDeveloper", "support_website_url": null, "website_url": "https://sites.google.com/view/beatgesture/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {
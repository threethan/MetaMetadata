Ao00cB12-F-IZrZtmxHO1vQ7L2pOssMbI0QYcQaoRPieDQI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCR_broO3BbvD3Z1_Th7rRC1Fo9PAOMuA6ZQeqlJj44Jg&oe=6A5E0854"}, {"file_name": "screenshot_2560x1440_02.png", "id": "669054496302012", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618910_669054502968678_12487198628138138_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WtlizX2PsIAQ7kNvwEX2KWK&_nc_oc=Adp-xYsKzvqcA8IQjPgPAUINmoaLWUjXTBgs6AULvLRJUfjiuvw3S-R-ZhG4msvIFUQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDj389vC0xo5SE1kuLR-w2l7OCzSegi7-Va7YjkCy6kWA&oe=6A5E122E"}, {"file_name": "screenshot_2560x1440_04.png", "id": "1692932094965269", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618297_1692932098298602_7171383388243165638_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4MpzFCRXgOQQ7kNvwFJX6-t&_nc_oc=AdpmuZzhKnXrz57zRZpatXNj6gPLabYdHDab5XHauhDwGah08bOUldgXJ-DyxL7GlyM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBDfPgOQO_xspA0xkMDnqNiI04gkk4_xnwkHppvno3QhA&oe=6A5E3368"}, {"file_name": "screenshot_2560x1440_01.png", "id": "952606510468970", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619685_952606517135636_8047896386954430759_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R_hJlB7ta0oQ7kNvwERtqQ_&_nc_oc=Adp8fDxZt9yOECPP-ZKKa_OoOPhGrKt_LaoR3BUZ0_bh2PkqCJblVljwD21VdSpCYTw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBO9ZKMkUEk4SByNJ-BQhvDwD95iS5sTmJZWwUJU1kS8Q&oe=6A5E0BF9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape 2560x1440px.png", "id": "952628337349594", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819417_952628340682927_7092126336638068634_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OCEYT3b21N4Q7kNvwHBYCWo&_nc_oc=AdoC1Sg11CTgrN1jHCD9XEqyAdhLMxVDuBmZgv9Gd-SPudvUn-0S1JtDwH0W6VjlQLg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDQViUJmA02VoSr3O9RwMxIoqV9fKMoMmLO2wftvkufvQ&oe=6A5E2A87"}, "display_name": "BeatGesture", "keywords": ["rhythm", "music", "beat", "handtracking", "gesture"], "long_description": "Step into a new dimension of rhythm.\n\nBeatGesture is a VR rhythm game where your hands are the controller. Match hand gestures, positions, and timing to the beat for a fully immersive experience.\n\n[Gesture-Based Gameplay] \nHit incoming notes by matching the correct hand shape, placing your hand in the right position, and timing it perfectly with the music. Simple to learn, deeply satisfying to master.\n\n[Expressive Controls]\nPlay using natural gestures like fists, open hands, thumbs up, and L-shapes. Direction-based variations and two-hand patterns add depth and challenge.\n\n[Dynamic Note Types]\nTap \u2013 Hit on beat\nHold \u2013 Maintain your gesture\nSwipe \u2013 Hit the note in the arrow direction\n\n[Game Modes]\nCampaign \u2013 Progress through increasingly challenging stages\nFree Play \u2013 Replay songs with selectable difficulty\n\nImmersive VR\nDesigned for Meta Quest hand tracking with stylized, rhythm-driven environments. Passthrough support available.\n\nFeel the beat.\nYour hands are the instrument.", "short_description": "Feel the rhythm with your hands.\nMatch gestures, hit the beat, and master immersive VR rhythm gameplay in BeatGesture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/beatgesture-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "LefthandDeveloper", "support_website_url": null, "website_url": "https://sites.google.com/view/beatgesture/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NO
1_1066714712572558_7058001035126764018_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7pnHI-Xh-LQQ7kNvwEmaFM6&_nc_oc=AdqVsjNd8hWGs2TC-rR5eOnrHaSu3-0JGcVOkb2r8tW_WRY1UuXbt6XMbEGgLk-Ht0A&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5XwXmep3QvPKJsgwLgAM_Wfflo9PQtQMmLx8VSt4r8A&oe=6AA3FC16"}, {"file_name": "screenshot_2560x1440_03_v2.png", "id": "3419503744896967", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499623179_3419503748230300_6824419827252677977_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R4fz05BTbXgQ7kNvwEwMiVo&_nc_oc=AdrNrzvzRx7k0UNdQSLU0E89GsEgUU_6dnUeYZqhE9eLRwEikd941LKQbmQrDJpmddI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvWdCmCqbO67-yccCxeeJL5GkSCHwExKmw6wHWxblIYg&oe=6AA42165"}, {"file_name": "screenshot_2560x1440_02.png", "id": "669054496302012", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499618910_669054502968678_12487198628138138_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TQaUkcvZ4d0Q7kNvwFZM4hM&_nc_oc=Adpz5KEigeg0Iho_5tS5sUTHlePqK_c6yA-bvfwdIx_CTSr2_J1C_MBOMmgMUih3XgA&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKTPSUDUJ2PTKF8eXobUXGgSj-r3xV44DurgnLRYYbAvQ&oe=6AA3F1AE"}, {"file_name": "screenshot_2560x1440_04.png", "id": "1692932094965269", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499618297_1692932098298602_7171383388243165638_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WgmMpj8j-WIQ7kNvwHn3gnm&_nc_oc=Adox4K5ZPR5suAX8XmA1POkWhwtvtensQtXa89KuVu6NJ9Bz1NwW4SKVCzE90MEko7o&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfHbEpJ50pM4Tffhk2A74US8-fN3HT8QA_uJrGbXGeKQ&oe=6AA412E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape 2560x1440px.png", "id": "952628337349594", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491819417_952628340682927_7092126336638068634_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MVz4teImjFgQ7kNvwE6h8UC&_nc_oc=AdpehOQTQLsaI3ocKmr8qNTKvagSw3_a6Yv4jKLXCUN_PxKHoRqVgXWa6eCb-nrUru0&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqtc4rUyYOXwDv07MSzSO2ZN8q777oBiMaj0vy0vE8sQ&oe=6AA40A07"}, "display_name": "BeatGesture", "keywords": ["rhythm", "music", "beat", "handtracking", "gesture"], "long_description": "Step into a new dimension of rhythm.\n\nBeatGesture is a VR rhythm game where your hands are the controller. Match hand gestures, positions, and timing to the beat for a fully immersive experience.\n\nDesigned for Meta Quest hand tracking with stylized, rhythm-driven environments.\n\n{2229418921186635}\n\n[Gesture-Based Gameplay] \n\nHit incoming notes by matching the correct hand shape, placing your hand in the right position, and timing it perfectly with the music. Simple to learn, deeply satisfying to master.\n\n[Expressive Controls]\n\nPlay using natural gestures like fists, open hands, thumbs up, and L-shapes. Direction-based variations and two-hand patterns add depth and challenge.\n\n[Dynamic Note Types]\n\nTap \u2013 Hit on beat\n\nHold \u2013 Maintain your gesture\n\nSwipe \u2013 Hit the note in the arrow direction\n\n\n[Game Modes]\n\nCampaign \u2013 Progress through increasingly challenging stages\n\nFree Play \u2013 Replay songs with selectable difficulty\n\nPassthrough support available.\n\nFeel the beat.\n\nYour hands are the instrument.\n", "short_description": "Feel the rhythm with your hands.\nMatch gestures, hit the beat, and master immersive VR rhythm gameplay in BeatGesture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/beatgesture-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "LefthandDeveloper", "support_website_url": null, "website_url": "https://sites.google.com/view/beatgesture/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "45978150
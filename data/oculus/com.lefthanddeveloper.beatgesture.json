4fL5wJR7sm2FDuvkPf6yEZWsW95AzqR-MzERjEegn43UmRE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAwBM6GPx8B8lZ_X8ms2Y6ayzdstSPja3nFOdrTfwYttA&oe=6A689454"}, {"file_name": "screenshot_2560x1440_02.png", "id": "669054496302012", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618910_669054502968678_12487198628138138_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=byZ7cdWbmc4Q7kNvwG05-Vf&_nc_oc=AdqsdVlqDa9Z3IY4iQln9hFrS2AvoaFH-hEmbT7CQqY3SzQgrcjRciBUOVj03YHeXeY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCENURzGue17BzszBz0zouJM51mEpvqWn_qKIAk9V6inw&oe=6A689E2E"}, {"file_name": "screenshot_2560x1440_04.png", "id": "1692932094965269", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618297_1692932098298602_7171383388243165638_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-7sSu99DBkUQ7kNvwGg6Q4g&_nc_oc=AdqrzOemYqjSrypumZY2BUslLxsNIoOLR7cRXIq8QlefuHYvR_3keQ62jVsZ9ag0vkM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDoAycIi5XDiatguh-pzg_bhWoxzggqdo_Zs7VUY8P13A&oe=6A68BF68"}, {"file_name": "screenshot_2560x1440_01.png", "id": "952606510468970", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499619685_952606517135636_8047896386954430759_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JUNZAedg59UQ7kNvwFmKZ4F&_nc_oc=AdrYlTGRqg7kYPNHiMjfVpfA69cdDn3R8FPs8YbjVkUMNk0BUvkdQbrCzFFZsWIw7uM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA529PWtqJD1fHN-VO2LCeNgtFAE2JNyr1xyIxahHOc4A&oe=6A6897F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape 2560x1440px.png", "id": "952628337349594", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819417_952628340682927_7092126336638068634_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P4suEcL3H8QQ7kNvwEri4hP&_nc_oc=Adp9XaJzTLFd_HHXZXVZe44Byr6sCBUKv8_-eKqZfm4Ix9oKGeECwHIyd1pYGsR3O4Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAxlBLeR4SYeTe6QOKoUIr98fHZfGhECNGGhMFlQyD9IA&oe=6A68B687"}, "display_name": "BeatGesture", "keywords": ["rhythm", "music", "beat", "handtracking", "gesture"], "long_description": "Step into a new dimension of rhythm.\n\nBeatGesture is a VR rhythm game where your hands are the controller. Match hand gestures, positions, and timing to the beat for a fully immersive experience.\n\n[Gesture-Based Gameplay] \nHit incoming notes by matching the correct hand shape, placing your hand in the right position, and timing it perfectly with the music. Simple to learn, deeply satisfying to master.\n\n[Expressive Controls]\nPlay using natural gestures like fists, open hands, thumbs up, and L-shapes. Direction-based variations and two-hand patterns add depth and challenge.\n\n[Dynamic Note Types]\nTap \u2013 Hit on beat\nHold \u2013 Maintain your gesture\nSwipe \u2013 Hit the note in the arrow direction\n\n[Game Modes]\nCampaign \u2013 Progress through increasingly challenging stages\nFree Play \u2013 Replay songs with selectable difficulty\n\nImmersive VR\nDesigned for Meta Quest hand tracking with stylized, rhythm-driven environments. Passthrough support available.\n\nFeel the beat.\nYour hands are the instrument.", "short_description": "Feel the rhythm with your hands.\nMatch gestures, hit the beat, and master immersive VR rhythm gameplay in BeatGesture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/beatgesture-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "LefthandDeveloper", "support_website_url": null, "website_url": "https://sites.google.com/view/beatgesture/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NO
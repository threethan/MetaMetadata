83760_2667262574431077871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rO2wORIN5v0Q7kNvwFm-MDL&_nc_oc=Adon2R4uTyCzJfBUGq_NH-MnQbswPOiTUwZEqp_qBF8krToIGH4e15raPvqwmBRxaXY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH__4nrY4upQUpPQ2ErhJkL7lZt08MLRKoB5M6mA3IVoA&oe=6A8989D4"}, {"file_name": "screenshot_2560x1440_02.png", "id": "669054496302012", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618910_669054502968678_12487198628138138_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cR83v6-jYC8Q7kNvwFl33wA&_nc_oc=Adr3runeS7EeT2-PxSGXvMErWtNVQUAwQpKEY-Haixfm4K2CqF4QUbnxYtFRTlIUV8s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjayDArZ9nFI0xL_BQZKmsYtcki67z38xS83NRUviNUQ&oe=6A8993AE"}, {"file_name": "screenshot_2560x1440_04.png", "id": "1692932094965269", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618297_1692932098298602_7171383388243165638_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nkgLnSTM6FMQ7kNvwEHfrHG&_nc_oc=Ado4KUgsU6BpLZXR27HbXeBUw5zJZOaJ6znfEXU02kUmQoGNoPq4vtaBrPFXVs0WIFw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGWOatHFRL4d2Bnea2xmXTrcQSGZfp0fhBWdsrU9XKe4g&oe=6A897CA8"}, {"file_name": "screenshot_2560x1440_01.png", "id": "952606510468970", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619685_952606517135636_8047896386954430759_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uj9O7LmKxgEQ7kNvwH9Amrw&_nc_oc=AdrGDIVdg5o9xw2HUEbmdv_xdpnep7Ws4I0wXkbqNLdt4A-eqGS_OWFGWzyTWgb3u3o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH58oZgKGQaAR-DYkYToiK4dgdmxpQWx2M4JQ_skEmj0Q&oe=6A898D79"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape 2560x1440px.png", "id": "952628337349594", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819417_952628340682927_7092126336638068634_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DNUtZHfWHDMQ7kNvwENof8J&_nc_oc=Adp227Lj9NE1v2wBQU5tZ2sHWFCRZXVW3twAWGShNciTNCUqjiEETXpS4jjuGNXZaLk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQENyqB93ANXcOHEYFfWEfFC7DyKkTljUS3JMkCTRKMdJw&oe=6A8973C7"}, "display_name": "BeatGesture", "keywords": ["rhythm", "music", "beat", "handtracking", "gesture"], "long_description": "Step into a new dimension of rhythm.\n\nBeatGesture is a VR rhythm game where your hands are the controller. Match hand gestures, positions, and timing to the beat for a fully immersive experience.\n\n[Gesture-Based Gameplay] \nHit incoming notes by matching the correct hand shape, placing your hand in the right position, and timing it perfectly with the music. Simple to learn, deeply satisfying to master.\n\n[Expressive Controls]\nPlay using natural gestures like fists, open hands, thumbs up, and L-shapes. Direction-based variations and two-hand patterns add depth and challenge.\n\n[Dynamic Note Types]\nTap \u2013 Hit on beat\nHold \u2013 Maintain your gesture\nSwipe \u2013 Hit the note in the arrow direction\n\n[Game Modes]\nCampaign \u2013 Progress through increasingly challenging stages\nFree Play \u2013 Replay songs with selectable difficulty\n\nImmersive VR\nDesigned for Meta Quest hand tracking with stylized, rhythm-driven environments. Passthrough support available.\n\nFeel the beat.\nYour hands are the instrument.", "short_description": "Feel the rhythm with your hands.\nMatch gestures, hit the beat, and master immersive VR rhythm gameplay in BeatGesture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/beatgesture-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "LefthandDeveloper", "support_website_url": null, "website_url": "https://sites.google.com/view/beatgesture/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "15921
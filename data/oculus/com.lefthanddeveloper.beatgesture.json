712572558_7058001035126764018_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yOzkBk4uWi0Q7kNvwGE62Iw&_nc_oc=AdrNAbT6Jl7b4tFEjSY-cfS6g7v5wBtu_XpBK9cACqqbgeeC2mYAQUrigZLtgz5cTs4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnZK5V7ZT0tGqfIuoy-U6hYxuYIHJlFIZ-SQF86cbGcg&oe=6AB67116"}, {"file_name": "screenshot_2560x1440_03_v2.png", "id": "3419503744896967", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623179_3419503748230300_6824419827252677977_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EnZVnvhs9IAQ7kNvwFPxEDS&_nc_oc=AdrXdCcVHprh-4ray3p0neAHxvZNYTa_CVzpDxyat-w4CKNN2OnSgTEP-VyPMaNet-Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_yWsTu-exotjbU-ljS_ICbVjSMOefc3fFatP7_3V2og&oe=6AB69665"}, {"file_name": "screenshot_2560x1440_02.png", "id": "669054496302012", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618910_669054502968678_12487198628138138_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wa_W2biKr90Q7kNvwHZEH5n&_nc_oc=Adp0TYm7TPLLMufHUIAaviu6AWuMTDpgKCIzSw0zPdj6A55IY3Vc9-24ttbfVDgrmPc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLoGYgKWsXq0_rb_Z5NILBdSyP2Nev_1kcesY-ppzX7Aw&oe=6AB666AE"}, {"file_name": "screenshot_2560x1440_04.png", "id": "1692932094965269", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618297_1692932098298602_7171383388243165638_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IY3mvTZM6W4Q7kNvwH77Z0l&_nc_oc=Adqbi57-mdeXMDb3DP20YC2tT24GII_VEUWjokGMOLY6FAgHaaPFdzpzZcxsZ8fJEhY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZ371J_DBlREFlJI6KMCRnVumI_CwS0pCAkaCLvgaKAw&oe=6AB687E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape 2560x1440px.png", "id": "952628337349594", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819417_952628340682927_7092126336638068634_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Nx7DfikjSQQ7kNvwFPVdpO&_nc_oc=AdqG_BXtv7GicpLSbsfJSCEZPAitOpRcjV39S4br6gs1fUi3t1p1mEP0B1pSOCZrfBE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIthf5MMDprU1idTNer51UM9jg5tCQV54y3qCc-arSYCA&oe=6AB67F07"}, "display_name": "BeatGesture", "keywords": ["rhythm", "music", "beat", "handtracking", "gesture"], "long_description": "Step into a new dimension of rhythm.\n\nBeatGesture is a VR rhythm game where your hands are the controller. Match hand gestures, positions, and timing to the beat for a fully immersive experience.\n\nDesigned for Meta Quest hand tracking with stylized, rhythm-driven environments.\n\n{2229418921186635}\n\n[Gesture-Based Gameplay] \n\nHit incoming notes by matching the correct hand shape, placing your hand in the right position, and timing it perfectly with the music. Simple to learn, deeply satisfying to master.\n\n[Expressive Controls]\n\nPlay using natural gestures like fists, open hands, thumbs up, and L-shapes. Direction-based variations and two-hand patterns add depth and challenge.\n\n[Dynamic Note Types]\n\nTap \u2013 Hit on beat\n\nHold \u2013 Maintain your gesture\n\nSwipe \u2013 Hit the note in the arrow direction\n\n\n[Game Modes]\n\nCampaign \u2013 Progress through increasingly challenging stages\n\nFree Play \u2013 Replay songs with selectable difficulty\n\nPassthrough support available.\n\nFeel the beat.\n\nYour hands are the instrument.\n", "short_description": "Feel the rhythm with your hands.\nMatch gestures, hit the beat, and master immersive VR rhythm gameplay in BeatGesture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/beatgesture-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "LefthandDeveloper", "support_website_url": null, "website_url": "https://sites.google.com/view/beatgesture/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {
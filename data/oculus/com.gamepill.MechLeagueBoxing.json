NjGD4fWjC5cXz0rHDov1-ipm8_04E2cyMhK0Bpicnyow-w17CHFe7K3xuk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9EdHAPdmmY5SugJDtrt9G8lCbiPl3VW8G_cLghXO6EmQ&oe=6A2AB528"}, {"file_name": "Joker laughing.png", "id": "1319611320056296", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499310651_1319611323389629_7668274206321718115_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cSh-ZmQlTBoQ7kNvwGIzn7G&_nc_oc=AdrPMuvclIPASZWYe8XfUS7wqTExTtZKn0B3c6yRWeiE_-O4xoaYihOa5TN5QDhjqsU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9teCvuUpkE31iSB97Nern0BOuQdHtfAP4F3cswRW6YmA&oe=6A2AB399"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MLTrailer_CoverImage.png", "id": "26601302916187281", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499307326_26601302926187280_8187897479031061361_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jzViv8HR_sQQ7kNvwHWt2gL&_nc_oc=AdqGQgEh9XMSfcSva7QTFBFKWwhLrArIzE_Oj1pmVY0MJpP7vM1LSedGxaD7P2K-RtI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rj53ksSegNA8MyzhG5jMT5ze7j5vjPJgVrxRFAySJiw&oe=6A2AB84A"}, "display_name": "MECH LEAGUE Boxing", "keywords": ["boxing", "robotfighting", "mechcombat", "robotboxing", "vrworkout"], "long_description": "Welcome to MECH LEAGUE Boxing\u2014an adrenaline-pumping, metal-punching VR boxing experience. Step into your mech and rise through the ranks using using powerful punches, well-timed dodges, and precise counters\n\nFeel every hit. Break a sweat. Earn your way to the top.\n\nIn a future where mech battles are the ultimate escape, robot fighting has become the arena where champions are made. Now it\u2019s your turn.\n\nMECH LEAGUE Boxing is a full-body VR game and workout where every punch, dodge, and counter is powered by real movement. No buttons\u2014just pure VR combat.\n\nFEATURES\n\nFull-body VR combat\nPunch, block, and dodge in real time.\n\nVR workout\nBurn calories and build stamina while you fight.\n\nFast-paced action\nTest your reflexes in intense VR fighting.\n\nIntergalactic arenas\nBattle across unique locations.\n\nTrain and improve\nSharpen your skills and rise through the ranks.\n\nWeapons & mech combat\nGrab, smash, and dominate your opponents.\n\nCustomize your mech\nUpgrade gloves, helmets, and gear.", "short_description": "MECH LEAGUE Boxing is an adrenaline pumping, metal punching spectacular. Get your robot suit ready for action as you rise up the robot ranks. Punch, dodge and fight your way to the title match and the glory!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mechleagues.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Mech Leagues Inc", "support_website_url": null, "website_url": "http://www.mechleagues.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26829948719940885"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499301053_2147708856013113_2617777906538536812_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ozMOZUCpjUQ7kNvwHYAd4d&_nc_oc=Ado4BoTD_2E4G3vJLMLdOQ_sP9UjudzsUD891MmNmOl-kempp6_Yw-F0idfkT3dInuc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9yEGsBJM_kpCNXcCMuevvo-Gv7yKbHt5S0y89JV3GUOg&oe=6A2AE1
MU0jbjT4xqdcx4mI32A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIq0ENIa2jubR-G3asuxfURuQNgfSA0YXH167zBaZG1ww&oe=6AABFC0F"}, {"file_name": "PowerPinballScreenshot_C.png", "id": "1222575713162152", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619571_1222575716495485_3521606044532419295_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i6RpL2umdeQQ7kNvwE1Icki&_nc_oc=AdoAGoUY1GWQIddKC7OtfwAgi9cOQt36drTvcPsnmlme4Y7OtQ-anNKA3S9i9zhFUiY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITl4p21Mhqv0KbU0pRk61VNdP_94Z1smySUj9Ew36Mzw&oe=6AABF9BC"}, {"file_name": "PowerPinballScreenshot_B.png", "id": "755942597569579", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623314_755942600902912_5605775117535171560_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_8NPz95ZTP4Q7kNvwEVOWij&_nc_oc=AdoHKNE6BXUgPAZfzW00VWzK4Ffj7CAj9GZIBW39vfk8jUtg7jl9YirQeMPifpEDr28&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQhNinvruGFX5PpsiNKm6ebZSf0Dhvk2TNprZFSY7n5A&oe=6AABE274"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PowerPinballTrailerCover.png", "id": "2736418476802068", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623384_2736418480135401_2125188723260981836_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KL9-HbzogeEQ7kNvwGLgZLH&_nc_oc=Adq6K8oBgo0R2sOAQTlug1UXblU50LF-V-HtUl1ZNiidG6Y6XIDsknEFFPjNiswK_TM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKM2H_sINTBlE8hm6NfjN50OJNaTvvWgScQlMVhCNPE8A&oe=6AABDA29"}, "display_name": "Power Pinball", "keywords": ["Rehabilitation", "Exercise", "Coordination", "Movement", "Wellness"], "long_description": "Power Pinball transforms rehabilitation exercises into an immersive arcade-style experience designed to encourage natural head and body movement.\n\nStep into a vibrant pinball arena where your movements help control the action. Track the ball, react quickly, and guide it through bumpers, targets, and obstacles as the game challenges coordination, visual attention, and reaction time.\n\nDesigned to promote active participation, Power Pinball encourages players to move their head and upper body while staying focused on the playfield. The result is a dynamic experience that combines meaningful movement with enjoyable gameplay.\n\nPower Pinball is suitable for rehabilitation settings, wellness programs, and anyone looking for an interactive way to stay active in virtual reality.\n\nFeatures:\n\u2022 Immersive pinball gameplay designed for VR\n\u2022 Encourages natural head and upper body movement\n\u2022 Vibrant environments and responsive gameplay\n\u2022 Accessible and easy to learn\n\u2022 Suitable for clinics, rehab training sessions, and home use", "short_description": "Power Pinball turns rehabilitation into a fun arcade-style experience, encouraging head and body movement through immersive pinball gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.avrwell.com/privacy-policy-avrwell", "developer_terms_of_service_url": null, "publisher_name": "AVRwell Inc.", "support_website_url": null, "website_url": "https://avrwell.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "36846504901631339"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1362577852638916"}]}, "baseline_off
y3&_nc_oc=AdoFwCyIWyv0gnp9VbAJeiI0B7vfa_H6Ll-x-h_68vUQHns6A1Hi5gLXqvTp3g72TdA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGPEEHi-OQNjQr3PdVxI1cd9H9Z_uBW14RG8_GhAmF5hQ&oe=6A95CAB8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nomad Shooter", "keywords": ["archery", "bow", "sport", "arcade", "training"], "long_description": "# Nomad Shooter\n\nA VR archery challenge that rewards a steady hand, a clean release, and the satisfaction of a true shot. Step into the role of a steppe archer and put your skill to the test.\n\n**Earn Every Shot**\n\nThere are no shortcuts to the next trial. Earn the score you need to advance, learn from every miss, and come back with better timing and a steadier hand. The further you go, the more each shot demands: judgment, patience, and the nerve to release at the right moment.\n\n**Master the Bow**\n\nTrain at your own pace or go for a cleaner run. A master archer guides you, but only you can make the shot.\n\n**Breathe. Draw. Release.**", "short_description": "Draw the bow, make a clean release, and watch your arrow fly true. In Nomad Shooter, you become a steppe archer, training at your own pace and facing trials that demand greater focus with every shot."}]}, "developer_name": null, "developer_privacy_policy_url": "https://crocos.kz/politika-konfidenczialnosti-nomad-shooter", "developer_terms_of_service_url": null, "publisher_name": "CROCOS GAMES", "support_website_url": null, "website_url": "https://crocos.kz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommende
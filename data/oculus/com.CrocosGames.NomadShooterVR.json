548772_4485103318723119630_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v_SMSg2DiJMQ7kNvwH4dedc&_nc_oc=AdqJOLkPAfmuWjS6OYlyTTZMrnCUBzJEwGespMI7_VbPnuT4zAwCBQa24uT7tCF4xjA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKsXCQCjI86pRnpQjdj95qwo9ZpKuynAdpnLLTCpjO-cw&oe=6AAD55AE"}, {"file_name": "Image Sequence_007_0005.png", "id": "1083190017992905", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491828008_1083190021326238_6033640442851345_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QKdCUki-ct0Q7kNvwE98YYp&_nc_oc=Ado2Cbkd8IbLra9kVl0YN0n_HHgbHMCfWSHWUUFvhxgieKS0IHK_waAyvcBIVNxlYSQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIbI696ZfLeqvqW34PrAO2pEL98kq3sFpJqbqlmP8ALDw&oe=6AAD338C"}, {"file_name": "Image Sequence_006_0000.png", "id": "1522547975652914", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499310667_1522547978986247_2551104668608319938_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VIOqpsESVxIQ7kNvwFhtf-B&_nc_oc=Adpk9UMxHcJKTrwvjeYjv_dejoT9KK-5mq6r6TWgYpwwdFcDj1Jj6rSrJgyxVOld4eM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0vGZUlIji8qffCqQfXUmLwEXL8Y2WpZM0GnQHn2DR3Q&oe=6AAD4F05"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nomad Shooter", "keywords": ["archery", "bow", "sport", "arcade", "training"], "long_description": "# Nomad Shooter\n\nA VR archery challenge that rewards a steady hand, a clean release, and the satisfaction of a true shot. Step into the role of a steppe archer and put your skill to the test.\n\n**Earn Every Shot**\n\nThere are no shortcuts to the next trial. Earn the score you need to advance, learn from every miss, and come back with better timing and a steadier hand. The further you go, the more each shot demands: judgment, patience, and the nerve to release at the right moment.\n\n**Master the Bow**\n\nTrain at your own pace or go for a cleaner run. A master archer guides you, but only you can make the shot.\n\n**Breathe. Draw. Release.**", "short_description": "Draw the bow, make a clean release, and watch your arrow fly true. In Nomad Shooter, you become a steppe archer, training at your own pace and facing trials that demand greater focus with every shot."}]}, "developer_name": null, "developer_privacy_policy_url": "https://crocos.kz/politika-konfidenczialnosti-nomad-shooter", "developer_terms_of_service_url": null, "publisher_name": "CROCOS GAMES", "support_website_url": null, "website_url": "https://crocos.kz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "kk", "ru"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1337310002787955"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "2664969317296515"}, {"status": "PUBLISHED", "id": "2222002145224583"}]}, "baseline_offer": {"id": "2664969317296515"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1789022340, "status": "PUBLISHED", "id": "2664969317296515"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1377632848755670", "version": "0.7.13"}, "id": "2573987036390972", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "App
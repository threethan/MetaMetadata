835635", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491827973_2336409817168968_5607520796052531094_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sLFk-qgOh2IQ7kNvwHsWqO-&_nc_oc=AdoHhKkNvklG3gyUmlYFOAr2dx3twXNRd8rFH-ryHFog845kpAVdVjY08g3g4MPeCY8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI8XHWRLdpQQaOAivdhYJcNd77GhLS0A5P9U9ySBcaVRw&oe=6A9FFCCB"}, {"file_name": "Image Sequence_004_0003.png", "id": "28390955860505407", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/507843239_28390955863838740_8957250939890274140_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ga47MeDyfnEQ7kNvwELXrhw&_nc_oc=Ado0yIS8S2GrG56bcweawot5N-bX5AbiklxaoTCkDtFVjWj0dEu_53ErFKLIB99MFUw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI6gn5WB4kFUc96XPdrWaF6q5bPlGkJkQZjWNfUPQENtg&oe=6AA00816"}, {"file_name": "Image Sequence_005_0003.png", "id": "2143922083215439", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491829120_2143922086548772_4485103318723119630_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tnxe5dV1s84Q7kNvwG5jMDC&_nc_oc=Adom3UeF4BJYrBSik2wOqd2bmOsSI6b-cwCgM0XQZjbY9q2ZO4cjJw2-XRPJ1FG7UTo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4ZASTC9ia5JUECR8D3YqlXNo5iI_mVqigGvv_DiLhDA&oe=6AA026AE"}, {"file_name": "Image Sequence_008_0005.png", "id": "1045947618348351", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/673738609_1045947621681684_6875772398486868778_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jPD3UkHaLvMQ7kNvwFv8oex&_nc_oc=AdpSwb7V5zvfMNs3cmjWB2eRr9pshbb-82mfpL2O0Zgp0iLELXE40TwQOboh9YgeD7s&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJG1P84Ucc172X6HWhOa1_OB4bHeXroWxgiscx9fV3wxw&oe=6AA01A79"}, {"file_name": "Image Sequence_009_0000.png", "id": "1046028731616774", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491828583_1046028734950107_7424556717022828837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qQz33jqRGPoQ7kNvwFVjHpH&_nc_oc=AdpwDCES7mBF0GTqlahMFsG86B7_HgTte-z_vAkAbEEKP2sxQlQQF_4fXsaTFTtEEkg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtqda5uRgCgPsUm7UpkEu_0DbnwRvfUXxtVoZrCXZM4w&oe=6AA01E78"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nomad Shooter", "keywords": ["archery", "bow", "sport", "arcade", "training"], "long_description": "# Nomad Shooter\n\nA VR archery challenge that rewards a steady hand, a clean release, and the satisfaction of a true shot. Step into the role of a steppe archer and put your skill to the test.\n\n**Earn Every Shot**\n\nThere are no shortcuts to the next trial. Earn the score you need to advance, learn from every miss, and come back with better timing and a steadier hand. The further you go, the more each shot demands: judgment, patience, and the nerve to release at the right moment.\n\n**Master the Bow**\n\nTrain at your own pace or go for a cleaner run. A master archer guides you, but only you can make the shot.\n\n**Breathe. Draw. Release.**", "short_description": "Draw the bow, make a clean release, and watch your arrow fly true. In Nomad Shooter, you become a steppe archer, training at your own pace and facing trials that demand greater focus with every shot."}]}, "developer_name": null, "developer_privacy_policy_url": "https://crocos.kz/politika-konfidenczialnosti-nomad-shooter", "developer_terms_of_service_url": null, "publisher_name": "CROCOS GAMES", "support_website_url": null, "website_url": "https://crocos.kz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommende
835635", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491827973_2336409817168968_5607520796052531094_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Meds-14ciEQQ7kNvwEQMosL&_nc_oc=AdrYnT-5iwrF9N7IL1vF0eUSpp11-ZNknmG88g7XHd6A3QuSNRVS9PUQ73ArNuQRBy8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZDn1BqGYQDQsn0L0uRx_saBAKOfVYfkRDH2ePLy6t6A&oe=6A9732CB"}, {"file_name": "Image Sequence_004_0003.png", "id": "28390955860505407", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/507843239_28390955863838740_8957250939890274140_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ykvKOcc7gIQ7kNvwGPTfYv&_nc_oc=AdqOmqYPHHtcmQYZLMdvxk-6EnG3EibvuV-BhPKVCkznRUFUBibawqS06xL95cLmLVI&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCadEVT7tlhppg7diisKCsTwIVoXSpMtCEHYS7SoItSA&oe=6A973E16"}, {"file_name": "Image Sequence_005_0003.png", "id": "2143922083215439", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491829120_2143922086548772_4485103318723119630_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CWL-7Tkm5cgQ7kNvwFBI5aC&_nc_oc=AdoMG2t7lcDUaA3gPVerAUJGx56gyeDtpjjHxqsa6cNLmYoCORSyMj4NuWIWIO24RMw&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFHMdswY0PFVsWSohazkJwI2ZBZ2A3x9Hy-5IpTiBax3w&oe=6A97246E"}, {"file_name": "Image Sequence_008_0005.png", "id": "1045947618348351", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/673738609_1045947621681684_6875772398486868778_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uUESy2p1iB8Q7kNvwHgxmtm&_nc_oc=Adof2f9gl02InnAraB4CYdep5yvVc9129KVwJDCipEigGBr5gXe-pTRq9dq9xqEuahM&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMe4k-_UXiKgzXeJxLbXuL_SH16eEULa8DpJ165WnJcw&oe=6A975079"}, {"file_name": "Image Sequence_009_0000.png", "id": "1046028731616774", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491828583_1046028734950107_7424556717022828837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vtQwYATTugcQ7kNvwEzoxyB&_nc_oc=Adq_wgg_DLerATDKGbAH4lVeGqC9qDUsoNBwIqsXR_B4yfi1U09x1pnvj99bvaJD1C0&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHafpaeElts13XuptZd39cCwwPE84rsSvW5AwzxcWVR6w&oe=6A971C38"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nomad Shooter", "keywords": ["archery", "bow", "sport", "arcade", "training"], "long_description": "# Nomad Shooter\n\nA VR archery challenge that rewards a steady hand, a clean release, and the satisfaction of a true shot. Step into the role of a steppe archer and put your skill to the test.\n\n**Earn Every Shot**\n\nThere are no shortcuts to the next trial. Earn the score you need to advance, learn from every miss, and come back with better timing and a steadier hand. The further you go, the more each shot demands: judgment, patience, and the nerve to release at the right moment.\n\n**Master the Bow**\n\nTrain at your own pace or go for a cleaner run. A master archer guides you, but only you can make the shot.\n\n**Breathe. Draw. Release.**", "short_description": "Draw the bow, make a clean release, and watch your arrow fly true. In Nomad Shooter, you become a steppe archer, training at your own pace and facing trials that demand greater focus with every shot."}]}, "developer_name": null, "developer_privacy_policy_url": "https://crocos.kz/politika-konfidenczialnosti-nomad-shooter", "developer_terms_of_service_url": null, "publisher_name": "CROCOS GAMES", "support_website_url": null, "website_url": "https://crocos.kz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommende
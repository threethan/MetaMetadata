835635", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827973_2336409817168968_5607520796052531094_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Meds-14ciEQQ7kNvwFuzM7r&_nc_oc=AdrWgH9E6SROkXNOvBdCbkEXmT99ewvifqo0bDZtk5c6eFxiFIcHRb44JM-NuTs4YIs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbFv5iNeIfjVCSwHW3aB8XpRQpkDXIYB84VJQUG_NWmw&oe=6A999D8B"}, {"file_name": "Image Sequence_004_0003.png", "id": "28390955860505407", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/507843239_28390955863838740_8957250939890274140_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ykvKOcc7gIQ7kNvwGlpcSF&_nc_oc=AdqFQ-dA1bFiv4spk6F1uISLrgCIJWmCH0gg3rdqnuqYLwlnUvsJdfi3CGDIcHUrOlg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYnSXRESlVuYflgk8GhgxWL0Qu0S1dk_HHmQGsgk3n3w&oe=6A997096"}, {"file_name": "Image Sequence_005_0003.png", "id": "2143922083215439", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491829120_2143922086548772_4485103318723119630_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CWL-7Tkm5cgQ7kNvwEnufHC&_nc_oc=Adpb5g69BA1JCNk5aN8tzuhFctkeJa_0Ymmo5cx596BUJq_vttqH8VuoGXmJP3mkeHw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIgXsuDhJsPLxqRfkIB5aBJdiDoYWuaAIJrbwstEUyPbQ&oe=6A998F2E"}, {"file_name": "Image Sequence_008_0005.png", "id": "1045947618348351", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673738609_1045947621681684_6875772398486868778_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uUESy2p1iB8Q7kNvwGHQOPi&_nc_oc=Adp9Fv9XCNcGEnexzqye6gYE2AUG-HmQT-ZkNzUZyvA4OQO7lxFxS_syj0YWB6UiZM8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJH2jzObWtuM7iQsTY760_Uj7GT8x9ZZ-Khw1NwqGdZ1A&oe=6A9982F9"}, {"file_name": "Image Sequence_009_0000.png", "id": "1046028731616774", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828583_1046028734950107_7424556717022828837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vtQwYATTugcQ7kNvwEYJ1XA&_nc_oc=AdrRRT4TBbPo4YDG88xvMFxFc2n2KxiMH4ix9BberrtKNCkPduyu-cj180r1ip_YqE0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQeztjqmUB2VUo11TaPAdGZfvcBDu42jf6ZgnP5Ua7Fg&oe=6A9986F8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nomad Shooter", "keywords": ["archery", "bow", "sport", "arcade", "training"], "long_description": "# Nomad Shooter\n\nA VR archery challenge that rewards a steady hand, a clean release, and the satisfaction of a true shot. Step into the role of a steppe archer and put your skill to the test.\n\n**Earn Every Shot**\n\nThere are no shortcuts to the next trial. Earn the score you need to advance, learn from every miss, and come back with better timing and a steadier hand. The further you go, the more each shot demands: judgment, patience, and the nerve to release at the right moment.\n\n**Master the Bow**\n\nTrain at your own pace or go for a cleaner run. A master archer guides you, but only you can make the shot.\n\n**Breathe. Draw. Release.**", "short_description": "Draw the bow, make a clean release, and watch your arrow fly true. In Nomad Shooter, you become a steppe archer, training at your own pace and facing trials that demand greater focus with every shot."}]}, "developer_name": null, "developer_privacy_policy_url": "https://crocos.kz/politika-konfidenczialnosti-nomad-shooter", "developer_terms_of_service_url": null, "publisher_name": "CROCOS GAMES", "support_website_url": null, "website_url": "https://crocos.kz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommende
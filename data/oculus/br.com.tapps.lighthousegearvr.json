693655984_1784653482372890624_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ljBjn5Oa6u4Q7kNvwH33tnh&_nc_oc=AdrqBM4s_Lj6KS9UrOp7-cUzV-7p3nkZPU54txc13sTZTZKGc63KgtxbElj9oLkagLY&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wMBvhwXphMAkhljc74mT0_KMhC5R8cP_KYhY9-RNfcQ&oe=6A465D00"}, {"file_name": "migrated_image.png", "id": "154099512447868", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/11162743_112768562782203_9184848924693757952_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tdLyswxb0zMQ7kNvwGT-3A9&_nc_oc=Adper0rCEQ293pBzdnbGbH6hFoOjZQJ9mRfjqf25hBfEOAcqkvYaA-um-GzKM4sNCoM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8EAkKUUjnyr3spkPc5YUKf7ZxPP80-_SN0sAcPgXzGOQ&oe=6A466A5E"}, {"file_name": "migrated_image.png", "id": "167923727532468", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/11162771_1802746456682797_5805177328845717504_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qcZS_RDdPCcQ7kNvwEGzNEx&_nc_oc=Adovl1yiZNwIc613XSPJreZ51Qq4YzTyyEYO7FtYhysPNTw7OHyOTDXTnMEdQw7cW8Y&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_EGd4jLpPXnZM-EA5HUq5TwGOAz6XzKfz4VAirtvvXOg&oe=6A4669E8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Lighthouse", "keywords": ["Hidden", "Object", "Exploration", "Detective", "Mystery"], "long_description": "A lighthouse in the middle of the pacific, nowhere near land. Strange radio signals come from its location everyday at 18 hours.\nAs an agent specialized in special cases, enter this strange old lighthouse and try to find all the clues to what may be happening there.\n\nCLASSIC GAMEPLAY, NEW PERSPECTIVE\n\nEnjoy the addicting hidden object gameplay with a new and immersive VR twist that will make you feel like a real spy!\n\nEXPLORE LIKE A REAL DETECTIVE\n\nMove around realistic and highly interactive locations with a comfortable teleportation system, open every drawer and search every nook and cranny with your keen eye for clues and evidence.\n\nPLAY AND REPLAY\n\nRevisit levels you\u2019ve already completed to find different sets of items for a whole new investigation every time you play!\n\nBE THERE\n\nImmerse yourself in an environment rich in detail and atmosphere. Feel the loneliness of the lighthouse.", "short_description": "Travel to a lighthouse in the middle of nowhere to shed light on a haunting mystery in this VR hidden object game."}]}, "developer_name": null, "developer_privacy_policy_url": "http://pp.tappsgames.com.s3.amazonaws.com/GeneralPP.htm", "developer_terms_of_service_url": "http://tos.tappsgames.com.s3.amazonaws.com/GeneralTOS.htm", "publisher_name": "Tapps Games", "support_website_url": null, "website_url": "http://www.tappsgames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "CASUAL", "EXPLORATION", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3158443394427481"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "169408850320050"}, {"status": "PUBLISHED", "id": "1947844245506821"}, {"status": "PUBLISHED", "id": "1548175195239697"}]}, "baseline_offer": {"id": "1548175195239697"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1513274400, "status": "PUBLISHED", "id": "169408850320050"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1192189504229595", "version": "1.2"}, "id": "1972003026368575", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "prima
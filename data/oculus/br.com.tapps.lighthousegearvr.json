": "885922408505295", "locale": "en_US", "screenshots": [{"file_name": "migrated_image.png", "id": "564691334147656", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162718_142755829655275_5377498491398389760_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=So9y3KnCv5AQ7kNvwFpFn_e&_nc_oc=AdlAtx9duXxQFrH7Hg3NjXT_b8Ep5k4bpaVs64oAIB0xmF0eRh_YlWNbCs9XB181ckM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx3ayOK6y5ghTdq2fYoMkQcgmkiEwHSn17Y2OvpEw2-WA&oe=69B6A563"}, {"file_name": "migrated_image.png", "id": "892986294545896", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162717_1064874343648231_2093759431102693376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QG3DEthgxOYQ7kNvwHI68ES&_nc_oc=AdmWdTdtvlGNFY1P4GfX-nc195-UXOt2AuVS8kZ-SSAZQXTDuZSjIK76J0Q22WYaskg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx__a5a5oCgpypMWNitnZR2aK6eex3hbf9czuW-J7ANJQ&oe=69B6C154"}, {"file_name": "migrated_image.png", "id": "1541808035994239", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162683_104081693655984_1784653482372890624_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZrWqwo5S0LkQ7kNvwGTVEmb&_nc_oc=Adn2UZgjh4RQ0fsZCPdp4GgtM6shEecmoA0Vo84dgTI4YfRjfgrVdelILTyh47n76-M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwLemz5hoEgQfz4dJB3KHvwAhi8_RCjt_qqyD2ItIG1NQ&oe=69B6A980"}, {"file_name": "migrated_image.png", "id": "206865047083789", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162743_112768562782203_9184848924693757952_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pQmmQaUs7YgQ7kNvwEy97Lq&_nc_oc=AdnxDFAf-IfP2zp7_tJNyYUu9EcHkqG22Vz92SQYR5g3NhlRtikMh8p9i_qPKbCve6o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwRT-wyY0jRaGpupLhy77vtzStFZUXC7-lvWgKjVN25aQ&oe=69B6B6DE"}, {"file_name": "migrated_image.png", "id": "689000038530133", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162771_1802746456682797_5805177328845717504_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xXk44_8lAcwQ7kNvwHWI43H&_nc_oc=AdnUWptH-BfAnDibTu9JlP5ta3c1VZEhqh9rk748pM1V94eNzCWKd-Gkgs7XKSbqF5U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxYHLmFpwXGCLY8d5-UheRjEK_y5YEcJdAzE0ZkNKATbw&oe=69B6B668"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Lighthouse", "keywords": ["Hidden", "Object", "Exploration", "Detective", "Mystery"], "long_description": "A lighthouse in the middle of the pacific, nowhere near land. Strange radio signals come from its location everyday at 18 hours.\nAs an agent specialized in special cases, enter this strange old lighthouse and try to find all the clues to what may be happening there.\n\nCLASSIC GAMEPLAY, NEW PERSPECTIVE\n\nEnjoy the addicting hidden object gameplay with a new and immersive VR twist that will make you feel like a real spy!\n\nEXPLORE LIKE A REAL DETECTIVE\n\nMove around realistic and highly interactive locations with a comfortable teleportation system, open every drawer and search every nook and cranny with your keen eye for clues and evidence.\n\nPLAY AND REPLAY\n\nRevisit levels you\u2019ve already completed to find different sets of items for a whole new investigation every time you play!\n\nBE THERE\n\nImmerse yourself in an environment rich in detail and atmosphere. Feel the loneliness of the lighthouse.", "short_description": "Travel to a lighthouse in the middle of nowhere to shed light on a haunting mystery in this VR hidden object game."}]}, "developer_name": null, "developer_privacy_policy_url": "http://pp.tappsgames.com.s3.amazonaws.com/GeneralPP.htm", "developer_terms_of_service_url": "http://tos.tappsgames.com.s3.amazonaws.com/GeneralTOS.htm", "publisher_name": "Tapps Games", "support_website_url": null, "website_url": "http://www.tappsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "CASUAL
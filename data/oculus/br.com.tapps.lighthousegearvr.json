": "885922408505295", "locale": "en_US", "screenshots": [{"file_name": "migrated_image.png", "id": "564691334147656", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162718_142755829655275_5377498491398389760_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mf9zlYR3KCQQ7kNvwHLtle8&_nc_oc=AdmgOGoNuNCMYRkptpa8WyzpmUljNH9OrjexU3FFVa8B8eeq03XdwcIFNm0oQZwb1H4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxMBVhG3_iAnDXRlLom4AFYKa7ylj47ip3hA0Q-_qDasQ&oe=69B2B0E3"}, {"file_name": "migrated_image.png", "id": "892986294545896", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162717_1064874343648231_2093759431102693376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r3Q7tHBbhIIQ7kNvwFSxKZq&_nc_oc=AdnGu0zZ1k4emdafgxxIJ1K90tPssUGTyNFcoAOCBu2BgNagQph1HC5SMWlBQcKd6Sg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw4BGloXE-Wz6n7MTw7ejWmkQooslNC-Vyzbbjz-AfzuQ&oe=69B2CCD4"}, {"file_name": "migrated_image.png", "id": "1541808035994239", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162683_104081693655984_1784653482372890624_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p6VOG9nYwWUQ7kNvwFyDeuK&_nc_oc=Adnx0LmEd3wEOU2vTTWaVUI7gxDQgKDi4viAkoAcHNgbmocCWup37SADw9_la-BHS9g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxrlQbQBtEtLSYvbaAMt08n-Z1odUGk1vPhBaGSlN-Ftw&oe=69B2B500"}, {"file_name": "migrated_image.png", "id": "206865047083789", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162743_112768562782203_9184848924693757952_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MAkjlPBXaP4Q7kNvwHMwLH-&_nc_oc=AdmKr9jfuzWFS3NSwVYLwpR6yq1CQS865cJUFkvEvkQrUey0UoD0La2awZaJTKmQhag&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afwd7LBa9SA41KgH5vjPCw1eu-pfuQ8sp4pyrxsLc6lW5w&oe=69B2C25E"}, {"file_name": "migrated_image.png", "id": "689000038530133", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162771_1802746456682797_5805177328845717504_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4DI5tAlmYuoQ7kNvwHq7fzL&_nc_oc=AdlLB2qG1G8-i_wM8ZU1xKQ-TeKh2NI1M6o5aqXq0rcsg35GpG7_nBmLIEzdTcBEZ78&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afzu5K350gauZuYb8TIwTKn8BvNTTs7CJn-_19xGnnNZAw&oe=69B2C1E8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Lighthouse", "keywords": ["Hidden", "Object", "Exploration", "Detective", "Mystery"], "long_description": "A lighthouse in the middle of the pacific, nowhere near land. Strange radio signals come from its location everyday at 18 hours.\nAs an agent specialized in special cases, enter this strange old lighthouse and try to find all the clues to what may be happening there.\n\nCLASSIC GAMEPLAY, NEW PERSPECTIVE\n\nEnjoy the addicting hidden object gameplay with a new and immersive VR twist that will make you feel like a real spy!\n\nEXPLORE LIKE A REAL DETECTIVE\n\nMove around realistic and highly interactive locations with a comfortable teleportation system, open every drawer and search every nook and cranny with your keen eye for clues and evidence.\n\nPLAY AND REPLAY\n\nRevisit levels you\u2019ve already completed to find different sets of items for a whole new investigation every time you play!\n\nBE THERE\n\nImmerse yourself in an environment rich in detail and atmosphere. Feel the loneliness of the lighthouse.", "short_description": "Travel to a lighthouse in the middle of nowhere to shed light on a haunting mystery in this VR hidden object game."}]}, "developer_name": null, "developer_privacy_policy_url": "http://pp.tappsgames.com.s3.amazonaws.com/GeneralPP.htm", "developer_terms_of_service_url": "http://tos.tappsgames.com.s3.amazonaws.com/GeneralTOS.htm", "publisher_name": "Tapps Games", "support_website_url": null, "website_url": "http://www.tappsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "CASUAL", "EXPLORATION", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2717008538445657"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162707_2032244590337305_7944014172591751168_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P80nK9du8WYQ7kNvwGRrTcQ&_nc_oc=AdkdWAQx6lBXWbkv1Oed_m_8bdVe02plZzTAKtj5crZx8mfNbbUG4p9ByWxdXXgCXnE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfygR-XM8oisglmRucYwNFYhhLfzODTwpBqbLmrWur3Y6A&oe=69B2C816"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Lighthouse", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1504112400, "lastRevision": {"nodes": [{"id": "803473633153453", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1170319423083270", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID"}, "iarc_cert": {"id": "1715555108496038"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "migrated_image.png", "id": "889725311461267", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162707_2032244590337305_7944014172591751168_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P80nK9du8WYQ7kNvwGRrTcQ&_nc_oc=AdkdWAQx6lBXWbkv1Oed_m_8bdVe02plZzTAKtj5crZx8mfNbbUG4p9ByWxdXXgCXnE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyC2oh7LWdigZY5s2OTFEF8K75H7etBSBZGRLB9pHX_Hw&oe=69B2C816"}, {"file_name": "migrated_image.pn
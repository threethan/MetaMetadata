": "885922408505295", "locale": "en_US", "screenshots": [{"file_name": "migrated_image.png", "id": "564691334147656", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162718_142755829655275_5377498491398389760_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y7N7RljYN0kQ7kNvwHG8wMv&_nc_oc=Adp-xJyL6PtYi8o5wwCNfCoVwC2xZ67owSE60Wc0RUNMQsOhz1Wf8SLXiOpOj3FSvi4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afz1bIhEsY5mmQdux_1S41dDYTFtpWsDWYXER3rjpDdrgw&oe=69C13163"}, {"file_name": "migrated_image.png", "id": "892986294545896", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162717_1064874343648231_2093759431102693376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_NaEEBFm93QQ7kNvwF_bhbW&_nc_oc=AdqfuvvaFtJdZpXbCOMlRLRja_zkvnDgKfmLMftqqvzTdrwHEwbFR9aU9sUHZhhSWFQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzmFVwEN4-5r37v5GBTQ_F6Si7atV0xb0m_1lluf5au8A&oe=69C14D54"}, {"file_name": "migrated_image.png", "id": "1541808035994239", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162683_104081693655984_1784653482372890624_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6tQBnVYOtEwQ7kNvwFj2UJG&_nc_oc=AdqJQExvdOSD6EF7g--wTV5IJX-aNk0WRJx6DLfUxkevYYwDMqidaiZPZp5ASLtzp90&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzKJFYXkEnz3mz2Vb5bqLoJ4pXztlg5YnMpW5yPeNvojg&oe=69C13580"}, {"file_name": "migrated_image.png", "id": "206865047083789", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162743_112768562782203_9184848924693757952_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ccBZT5FAyY8Q7kNvwECHD-w&_nc_oc=AdquaZaKXl1ly6iTqPEVA2xLsnOljn_AT-im_Xpr5NBqOZA-b90_ZSUQ-QoUvtx4Pmw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzqdIdEbv2Wg_tNaPQ6j06uOy4-y-yzlejkzkRuCSD4XQ&oe=69C142DE"}, {"file_name": "migrated_image.png", "id": "689000038530133", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162771_1802746456682797_5805177328845717504_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AUoMRL-fFzsQ7kNvwFUsTwK&_nc_oc=AdoVhuSExR0PxRxndBP4zg56woZ3md92sLauXgeF853TyNDzxvNk8P-XAyRNGHmtdJI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afz7ANSrh_qqdgnc79qWN7YSlRULuv239mCq0AwHOmAkzw&oe=69C14268"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Lighthouse", "keywords": ["Hidden", "Object", "Exploration", "Detective", "Mystery"], "long_description": "A lighthouse in the middle of the pacific, nowhere near land. Strange radio signals come from its location everyday at 18 hours.\nAs an agent specialized in special cases, enter this strange old lighthouse and try to find all the clues to what may be happening there.\n\nCLASSIC GAMEPLAY, NEW PERSPECTIVE\n\nEnjoy the addicting hidden object gameplay with a new and immersive VR twist that will make you feel like a real spy!\n\nEXPLORE LIKE A REAL DETECTIVE\n\nMove around realistic and highly interactive locations with a comfortable teleportation system, open every drawer and search every nook and cranny with your keen eye for clues and evidence.\n\nPLAY AND REPLAY\n\nRevisit levels you\u2019ve already completed to find different sets of items for a whole new investigation every time you play!\n\nBE THERE\n\nImmerse yourself in an environment rich in detail and atmosphere. Feel the loneliness of the lighthouse.", "short_description": "Travel to a lighthouse in the middle of nowhere to shed light on a haunting mystery in this VR hidden object game."}]}, "developer_name": null, "developer_privacy_policy_url": "http://pp.tappsgames.com.s3.amazonaws.com/GeneralPP.htm", "developer_terms_of_service_url": "http://tos.tappsgames.com.s3.amazonaws.com/GeneralTOS.htm", "publisher_name": "Tapps Games", "support_website_url": null, "website_url": "http://www.tappsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "CASUAL", "EXPLORATION", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2717008538445657"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162707_2032244590337305_7944014172591751168_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0pbruijkb_cQ7kNvwHpwG4v&_nc_oc=AdrB_3uFm5QafxQsjTO2AmC6g91LpnK9Lnse_TLWwUTEHLlBalyHn1loTnsXTiSeQtY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afw-p-J0Fc_LeB9dl_r85oQWbIHwy99da5YJ3pzUgUKsnQ&oe=69C14896"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Lighthouse", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1504112400, "lastRevision": {"nodes": [{"id": "803473633153453", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1170319423083270", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID"}, "iarc_cert": {"id": "1715555108496038"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "migrated_image.png", "id": "889725311461267", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162707_2032244590337305_7944014172591751168_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0pbruijkb_cQ7kNvwHpwG4v&_nc_oc=AdrB_3uFm5QafxQsjTO2AmC6g91LpnK9Lnse_TLWwUTEHLlBalyHn1loTnsXTiSeQtY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwBRyIZ6TRfrIsUy-dGq94rfOLTUlJPxJe_f2S0CdiGMg&oe=69C14896"}, {"file_name": "migrated_image.pn
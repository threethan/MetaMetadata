": "885922408505295", "locale": "en_US", "screenshots": [{"file_name": "migrated_image.png", "id": "564691334147656", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162718_142755829655275_5377498491398389760_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jZNlqs7tGpYQ7kNvwGijmzV&_nc_oc=AdnCRPDMc1QSXOxUmRKiWBqv5Dd_r8tlulTcjs2wYeOmDu607qok26tnX_f62LMMRi4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzfsoLIcV6I1o0yi6-L2ekkp9ihMOSLCqn4Dp8KbMaw-A&oe=69AC1963"}, {"file_name": "migrated_image.png", "id": "892986294545896", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162717_1064874343648231_2093759431102693376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CalBFbWSAyIQ7kNvwEV0Xgk&_nc_oc=AdkNBSLSCjKPe9muOEsom9P_Nmz_dtrM481EJFB3cfLPpEzvhGdmYkqyDGiJqCuqpG8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy2o7G8kPEgd3fOVn8qlbf9iet2TKsCYsTDZRdJB0Rw9Q&oe=69AC3554"}, {"file_name": "migrated_image.png", "id": "1541808035994239", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162683_104081693655984_1784653482372890624_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gwy7vfTfOg0Q7kNvwGjZPnu&_nc_oc=Adng_7g8fM6NHR6vY_iaf73lcuXXEkW1q96Gp_aHdh9QgvouVvTbQS3X9mBrfJdhsAg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwzIwYR5iKOuA9cv3URqO6j39yvWn96V-OSdeIkn01REw&oe=69AC1D80"}, {"file_name": "migrated_image.png", "id": "206865047083789", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162743_112768562782203_9184848924693757952_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pGzbMfV56kwQ7kNvwGttHEl&_nc_oc=AdmYYhoOYdqK6eUo4wuXcoo1YyTRqshX8aZAAlkCjn2x89fws5a3SgjrZLBp_lL48b0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzX9sEOUGeUZQTGELzklAV6glKt9gXwenAryKdHmiLLbA&oe=69AC2ADE"}, {"file_name": "migrated_image.png", "id": "689000038530133", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162771_1802746456682797_5805177328845717504_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yLScCLolQooQ7kNvwGsEAD3&_nc_oc=AdnV8MvtNI0_SBPlyxZdCePIdKCGEuRaft3gPL19Nynlq_vkiljks_Ck77nd38EEctc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwRSZ5UyBkh4Sm7KsH9IRjM30H00PaDY-r0XDUcff8zHQ&oe=69AC2A68"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Lighthouse", "keywords": ["Hidden", "Object", "Exploration", "Detective", "Mystery"], "long_description": "A lighthouse in the middle of the pacific, nowhere near land. Strange radio signals come from its location everyday at 18 hours.\nAs an agent specialized in special cases, enter this strange old lighthouse and try to find all the clues to what may be happening there.\n\nCLASSIC GAMEPLAY, NEW PERSPECTIVE\n\nEnjoy the addicting hidden object gameplay with a new and immersive VR twist that will make you feel like a real spy!\n\nEXPLORE LIKE A REAL DETECTIVE\n\nMove around realistic and highly interactive locations with a comfortable teleportation system, open every drawer and search every nook and cranny with your keen eye for clues and evidence.\n\nPLAY AND REPLAY\n\nRevisit levels you\u2019ve already completed to find different sets of items for a whole new investigation every time you play!\n\nBE THERE\n\nImmerse yourself in an environment rich in detail and atmosphere. Feel the loneliness of the lighthouse.", "short_description": "Travel to a lighthouse in the middle of nowhere to shed light on a haunting mystery in this VR hidden object game."}]}, "developer_name": null, "developer_privacy_policy_url": "http://pp.tappsgames.com.s3.amazonaws.com/GeneralPP.htm", "developer_terms_of_service_url": "http://tos.tappsgames.com.s3.amazonaws.com/GeneralTOS.htm", "publisher_name": "Tapps Games", "support_website_url": null, "website_url": "http://www.tappsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "CASUAL", "EXPLORATION", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2717008538445657"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162707_2032244590337305_7944014172591751168_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I7YN7JsbKPQQ7kNvwHmbFqs&_nc_oc=AdlAN11gxyAS7fKyfH0mHTWOztLIRhe7NIeAGwFJSR6h4uOsOdqYzj6DZ68qaZTMh3I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyU_Z2xywZgMaVIWtRWSgcNme0MYu-C6JV1qpbwh_bM7Q&oe=69AC3096"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Lighthouse", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1504112400, "lastRevision": {"nodes": [{"id": "803473633153453", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1170319423083270", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID"}, "iarc_cert": {"id": "1715555108496038"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "migrated_image.png", "id": "889725311461267", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162707_2032244590337305_7944014172591751168_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I7YN7JsbKPQQ7kNvwHmbFqs&_nc_oc=AdlAN11gxyAS7fKyfH0mHTWOztLIRhe7NIeAGwFJSR6h4uOsOdqYzj6DZ68qaZTMh3I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxo-Hp_yD0tVkX-c58QjqpoFKD2jcVUJ3fgdOB1jtUKZA&oe=69AC3096"}, {"file_name": "migrated_image.pn
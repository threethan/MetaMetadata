6682797_5805177328845717504_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M_ZTVNI1cToQ7kNvwE46LTb&_nc_oc=Ado1uHM2ehUbyGvrRhJA7GSQvP3iyWPHgwBacBRPjTj0dds1ufcMapRqIdgCd0r8Q7s&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjXbc5neG0qornOMYUv6NjOKunLupkpojpjwIEMzV38g&oe=6A7DC8E8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Lighthouse", "keywords": ["Hidden", "Object", "Exploration", "Detective", "Mystery"], "long_description": "A lighthouse in the middle of the pacific, nowhere near land. Strange radio signals come from its location everyday at 18 hours.\nAs an agent specialized in special cases, enter this strange old lighthouse and try to find all the clues to what may be happening there.\n\nCLASSIC GAMEPLAY, NEW PERSPECTIVE\n\nEnjoy the addicting hidden object gameplay with a new and immersive VR twist that will make you feel like a real spy!\n\nEXPLORE LIKE A REAL DETECTIVE\n\nMove around realistic and highly interactive locations with a comfortable teleportation system, open every drawer and search every nook and cranny with your keen eye for clues and evidence.\n\nPLAY AND REPLAY\n\nRevisit levels you\u2019ve already completed to find different sets of items for a whole new investigation every time you play!\n\nBE THERE\n\nImmerse yourself in an environment rich in detail and atmosphere. Feel the loneliness of the lighthouse.", "short_description": "Travel to a lighthouse in the middle of nowhere to shed light on a haunting mystery in this VR hidden object game."}]}, "developer_name": null, "developer_privacy_policy_url": "http://pp.tappsgames.com.s3.amazonaws.com/GeneralPP.htm", "developer_terms_of_service_url": "http://tos.tappsgames.com.s3.amazonaws.com/GeneralTOS.htm", "publisher_name": "Tapps Games", "support_website_url": null, "website_url": "http://www.tappsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external
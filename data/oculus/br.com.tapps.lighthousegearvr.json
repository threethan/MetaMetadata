": "885922408505295", "locale": "en_US", "screenshots": [{"file_name": "migrated_image.png", "id": "564691334147656", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162718_142755829655275_5377498491398389760_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sb-8jMmh0DYQ7kNvwFTPoaT&_nc_oc=AdlnHwAR1HMdZJ8ObVbaQGnvvUzho55aE60v4ASNViLKb-GLdJaJBuoL7K3vyVgUzZM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz-OCLQqgsNGJQ-W7xJYswYfIcSckvLImJbhHCExgCLqw&oe=69AD6AE3"}, {"file_name": "migrated_image.png", "id": "892986294545896", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162717_1064874343648231_2093759431102693376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eHktXjyVyWcQ7kNvwGNkQkr&_nc_oc=AdlDTYoq-MRLUmHtpWLlFcmm5IatZrK0xTDIN2HnAilHjuBVM7afnK1PE35dzZ8oUX8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfztcR1HD6k2SZoDgSA47C1bv1WyIqUMq79Y3tbR741raA&oe=69AD86D4"}, {"file_name": "migrated_image.png", "id": "1541808035994239", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162683_104081693655984_1784653482372890624_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gwy7vfTfOg0Q7kNvwEnjAnD&_nc_oc=AdllE2gm4BvnTDlQ2CduFDVF8ruKvMDNhBGnjvMq-d0sPw7P95IfD7Xx9kvQ1KHq18g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzqdrMcsGVPjhnK8GGA9_CtH59x9yClhl-e6QMQpWcn9A&oe=69AD6F00"}, {"file_name": "migrated_image.png", "id": "206865047083789", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162743_112768562782203_9184848924693757952_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v_bMBLRpgdIQ7kNvwGch7Kq&_nc_oc=AdnxxXm2HwgKqXLVxERZ0pmaBxa1qBhmzgdHxT7iKQS0HuM_bcYjrdQQM98ZjwWXyZo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxLbQWld-kPIrRbiqtwWWKpGyt4OL5q9WKQjirBg6XsUA&oe=69AD7C5E"}, {"file_name": "migrated_image.png", "id": "689000038530133", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162771_1802746456682797_5805177328845717504_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TDmtXWHGlZsQ7kNvwHFKWWq&_nc_oc=AdnWrUKdqCEI_99ExO6Vwzj0RQg8a1K6Mx8yyDWG6C_qtnpKbhNGCpqDE4TsUCNT668&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwE93CC2Luhpd-IoU7djgRxAh3l5rDDBpoucmzyM3AegQ&oe=69AD7BE8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Lighthouse", "keywords": ["Hidden", "Object", "Exploration", "Detective", "Mystery"], "long_description": "A lighthouse in the middle of the pacific, nowhere near land. Strange radio signals come from its location everyday at 18 hours.\nAs an agent specialized in special cases, enter this strange old lighthouse and try to find all the clues to what may be happening there.\n\nCLASSIC GAMEPLAY, NEW PERSPECTIVE\n\nEnjoy the addicting hidden object gameplay with a new and immersive VR twist that will make you feel like a real spy!\n\nEXPLORE LIKE A REAL DETECTIVE\n\nMove around realistic and highly interactive locations with a comfortable teleportation system, open every drawer and search every nook and cranny with your keen eye for clues and evidence.\n\nPLAY AND REPLAY\n\nRevisit levels you\u2019ve already completed to find different sets of items for a whole new investigation every time you play!\n\nBE THERE\n\nImmerse yourself in an environment rich in detail and atmosphere. Feel the loneliness of the lighthouse.", "short_description": "Travel to a lighthouse in the middle of nowhere to shed light on a haunting mystery in this VR hidden object game."}]}, "developer_name": null, "developer_privacy_policy_url": "http://pp.tappsgames.com.s3.amazonaws.com/GeneralPP.htm", "developer_terms_of_service_url": "http://tos.tappsgames.com.s3.amazonaws.com/GeneralTOS.htm", "publisher_name": "Tapps Games", "support_website_url": null, "website_url": "http://www.tappsgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "CASUAL", "EXPLORATION", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2717008538445657"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162707_2032244590337305_7944014172591751168_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I7YN7JsbKPQQ7kNvwHP2IcN&_nc_oc=AdnzaXVPaU4GYIxjivsZTWHymmQo_U2dg4W5zwK06wAHRII79x7DjYYud2G-onXqGb0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxxgvJgyQF4Zs4OQNoH-vYxyFJ5kyw9oZM6YdtEUfYV6A&oe=69AD8216"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Lighthouse", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1504112400, "lastRevision": {"nodes": [{"id": "803473633153453", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1170319423083270", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID"}, "iarc_cert": {"id": "1715555108496038"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "migrated_image.png", "id": "889725311461267", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162707_2032244590337305_7944014172591751168_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I7YN7JsbKPQQ7kNvwHP2IcN&_nc_oc=AdnzaXVPaU4GYIxjivsZTWHymmQo_U2dg4W5zwK06wAHRII79x7DjYYud2G-onXqGb0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwdA_LRK-84hWs1BhtNfm2xCcH1FYnyKIfqwaJRfvMkRA&oe=69AD8216"}, {"file_name": "migrated_image.pn
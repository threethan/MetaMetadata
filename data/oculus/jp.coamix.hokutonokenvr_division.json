dn.com&oh=00_Afs0ilXJOo_wVlzzuzeYVklOh1XO5rAYaxtQ4YRa4WIM_A&oe=699C5B0C"}, {"file_name": "Screenshot_4.png", "id": "400688311652202", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/65397209_400688314985535_7148047987340424957_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QgBCnLeSRWgQ7kNvwHJk-fy&_nc_oc=AdmeO2mdozCfOhRZLsEaoifqiIrPjkxcSgt4AxT9N1ynMPYeJ5PnJ38pRrQq-08JmFc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvGRTGhtlkxnP7JSulGG3z2-xJuffdebRdDJFu7Jmqwbw&oe=699C492F"}, {"file_name": "jp.coamix.hokutonokenvr_IamKen_1207-20211207-105350.00_01_10_18.\u9759\u6b62\u753b003.png", "id": "191424216534987", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974883_191424219868320_7367404696555183682_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3wl8L0wlFXUQ7kNvwE60Crl&_nc_oc=Adnv6zRWxEX0-6ym6nReopbQcf4etnIEtFKL_CjL7DCJMG_bUSwsK7C84CZeO41ETvQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Aft-eJPSmgefszE993BDH4KmxaAvzjcspmX_KTqpIIwr3g&oe=699C5B84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_1.png", "id": "1302819253501925", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974820_1302819256835258_1514330594747332623_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gkp8h6dRUSUQ7kNvwHBRFUj&_nc_oc=Admpr4OiF5vok_2CuBQa-wG266m6L6BpuP1ooBidQiwjI5QoD-H1q5LLV05YbvkNOLo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvPBnMX9aIlTtF85uJIWtqgVhLFUx3xKYrk5if1uC0DKw&oe=699C5EDC"}, "display_name": "XR MANGA  FIST OF THE NORTHSTAR\u3010The First Edition\u3011Volume 1-6 Set", "keywords": [], "long_description": "The provision of this app will cease on or around 22 December 2024.\nYou can continue to enjoy the DLed apps as long as the programmes that make up the apps run.\nHowever, re-downloads, version upgrades and support services will cease with the end of the provision of this application.\n--------------------------\nThe immortal masterpiece \"Fist of the North Star\", which has enthusiastic fans all over the world, is now available as the first installment of the XR Manga series!\nYou can read \"Fist of the North Star\" like never before in a VR space that perfectly reproduces the world view.\nYou can also enjoy the rhythm game \"I am Kenshiro\" where you can become Kenshiro yourself, and \"VR Figure\" where you can play with Kenshiro as a VR figure.", "short_description": "The provision of this app will cease on or around 22 December 2024.\nYou can continue to enjoy the DLed apps as long as the programmes that make up the apps run.\nHowever, re-downloads, version upgrades and support services will cease with the end of the provision of this application.\n--------------------------\nThe immortal masterpiece \"Fist of the North Star\", "}, {"images": {"nodes": [{"file_name": "75348041_330350595345489_2972430672076785601_n.png", "id": "1509081983128548", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572928_1509081989795214_3681481982462915946_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OC3iJAGU9C4Q7kNvwF9VWkD&_nc_oc=AdmDW9bl4jZ8XJY-k26ee49yQnZ4oR6O9xCFpW2NZrvWKL75A1fqNCmsv3XD94e3acM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Aftk10gqD8wevaaY71tnI7Hy-Pu_NtcO-ytHjumqt5rN8Q&oe=699C46A8"}, {"file_name": "39003238_431943401930269_1684669882997248577_n.png", "id": "558969876753955", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036659_558969880087288_4588472742243128313_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c3wHfNE6UfIQ7kNvwE3t-Kv&_nc_oc=AdlFIjqnwQSG71wJFQTbB5Ok467iBuczzoVVu4886SKvJ2IoWwkhocvHZ3dkkUSOGWk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftKkwwk-RKUGqOhaVMin66O9cRnfEtnFTkvLV4GEUovvw&oe=699C51D3"}]}, "id": "609839834902362", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "XR\u30de\u30f3\u30ac \u5317\u6597\u306e\u62f3\u3010The First Edition\u30111-6\u5dfb
n.com&_nc_ss=7f20f&oh=00_Af_-iZEyeRMErku3VA-CDg0TGLE-rIyaGAC09Dmc4UqyLQ&oe=6A2D52CE"}, {"file_name": "12 2560x1440.png", "id": "275001360320221", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86594846_275001363653554_2284479870562544233_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E1ZhFd5JGDUQ7kNvwHQ2sfg&_nc_oc=Adq9zsPRl1uQnReCdS6xhIJF_JBX27gwXXhaAkFgRY9zfzQfhEIGbQhYQpgNw0YiBE0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-5vNgIhEq05NrXeUnUevGDtmSPkbxl_o4XDXk8UI1mEQ&oe=6A2D7113"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "10 2560x1440.png", "id": "1027376847734176", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75363514_1027376854400842_1408430033317615724_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-TcOe6TGivgQ7kNvwEZe4iA&_nc_oc=Adr_SA6j7zb4UUWLpfnJowYmHj7buhgzsq7zXPpDN-aN_FS1CadRiaoKSJD8ob0dRaQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-WwpZGGjgZqv8AgrXIWk6waHTUW7Ksd72LBytzhlU7OA&oe=6A2D6D60"}, "display_name": "Fire Safety Theory 101", "keywords": ["Fire", "Safety", "Training", "Learning"], "long_description": "This is a short experience where you can learn about the elements that form a fire, how to identify the type of fuel and which extinguishers should be used against each type of fire.\n\nNote: This course was developed and it's used in Australia. The classification of the classes of fire and the colour codes from the extinguisher's label used on this course follow the Australian requirements, which are different depending on the country.", "short_description": "This VR programme covers the theory on the components of what makes up a fire, classes of fire and what type of fire extinguisher to use on the particular classes of fire."}]}, "developer_name": "Carlos Melo, Daniel Jochem", "developer_privacy_policy_url": "https://www.xrjv-training.com/xrjv-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XRJV", "support_website_url":
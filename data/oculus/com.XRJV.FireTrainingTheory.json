n.com&_nc_ss=7f20f&oh=00_AQL9MU8jA4A8UNWGE0dQ72jLwc3klvHbwp09_3rZrjpAnA&oe=6ABBB4CE"}, {"file_name": "12 2560x1440.png", "id": "275001360320221", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86594846_275001363653554_2284479870562544233_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N94tWOOEhOIQ7kNvwHzNkxM&_nc_oc=AdpT7TspAlODEnmIOtnzaMg2u_LmFcE0zpZj34Ait0HCiQ--JL1KwgDTG_UZQ5-rgQs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIEh1DlQ1zggPZUdLWzQu5Cqx2P18pLtOPy2PEiM0MYcQ&oe=6ABBD313"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "10 2560x1440.png", "id": "1027376847734176", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75363514_1027376854400842_1408430033317615724_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z-DI0I-vaXcQ7kNvwGtcG3z&_nc_oc=AdptatE_Fp9f_9Y4gWDciXUzBcQ9r1Zv-llifb1-FwZcZUTxtyp6BgNiEIO4EyibZE0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjIZlBMFXgbEfM6B5Y3igEZ29-wDl8b9OwM6ReSg-2zg&oe=6ABBCF60"}, "display_name": "Fire Safety Theory 101", "keywords": ["Fire", "Safety", "Training", "Learning"], "long_description": "This is a short experience where you can learn about the elements that form a fire, how to identify the type of fuel and which extinguishers should be used against each type of fire.\n\nNote: This course was developed and it's used in Australia. The classification of the classes of fire and the colour codes from the extinguisher's label used on this course follow the Australian requirements, which are different depending on the country.", "short_description": "This VR programme covers the theory on the components of what makes up a fire, classes of fire and what type of fire extinguisher to use on the particular classes of fire."}]}, "developer_name": "Carlos Melo, Daniel Jochem", "developer_privacy_policy_url": "https://www.xrjv-training.com/xrjv-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XRJV", "support_website_url":
n.com&_nc_ss=7f20f&oh=00_AQCTy4BI8Gdz9LrYcJUtF4JB9z8NnTwCmlAxTHXOPC4A_g&oe=6A4F99CE"}, {"file_name": "12 2560x1440.png", "id": "275001360320221", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86594846_275001363653554_2284479870562544233_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ao6DniWsQsQ7kNvwElq__E&_nc_oc=AdqYSprJsg-m4Fq0aNSbn0G3-rjD3hC4PSlRWPvdNyBmZqe9E1IsV2LLrQddQH0fLEQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQChofwOBavu9268WdvtF5-WSS35hcEQxxdVNmLz9pCdxw&oe=6A4FB813"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "10 2560x1440.png", "id": "1027376847734176", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75363514_1027376854400842_1408430033317615724_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yf8VHoK-H4YQ7kNvwGGuG6n&_nc_oc=Ado-Q-tmuB3gHS4gbXg5UiNA9PfhZKrDyQ8HNVNBo3az-OYjTAmPqp80CWH4rin2zvU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBO6Z5kD07JcPi3Vw43zuAieRZnpdj_tzdm5CWNL48M3g&oe=6A4FB460"}, "display_name": "Fire Safety Theory 101", "keywords": ["Fire", "Safety", "Training", "Learning"], "long_description": "This is a short experience where you can learn about the elements that form a fire, how to identify the type of fuel and which extinguishers should be used against each type of fire.\n\nNote: This course was developed and it's used in Australia. The classification of the classes of fire and the colour codes from the extinguisher's label used on this course follow the Australian requirements, which are different depending on the country.", "short_description": "This VR programme covers the theory on the components of what makes up a fire, classes of fire and what type of fire extinguisher to use on the particular classes of fire."}]}, "developer_name": "Carlos Melo, Daniel Jochem", "developer_privacy_policy_url": "https://www.xrjv-training.com/xrjv-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XRJV", "support_website_url":
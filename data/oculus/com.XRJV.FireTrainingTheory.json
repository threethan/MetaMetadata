n.com&_nc_ss=7f20f&oh=00_AQQVGL24ci5V6C968gPCPaJYrB5nDLIC0g4Lkgi3Azefcg&oe=6AEF578E"}, {"file_name": "12 2560x1440.png", "id": "275001360320221", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86594846_275001363653554_2284479870562544233_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IBV1kb7O1KgQ7kNvwHBQ0Og&_nc_oc=Adr_n1gnne5_LlyeXi61tnYTxGZyEN5VyZ0jHQKuH-L_SD88iI_WARIEUzbkOOBPDdY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpGIGODSffn8ym1BOkLAfYVVPNuVxx6YGyyFZo75M1xg&oe=6AEF3D93"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "10 2560x1440.png", "id": "1027376847734176", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75363514_1027376854400842_1408430033317615724_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=flkR4WZbUwoQ7kNvwG0tut6&_nc_oc=AdrKjm5qnqn7Jkxe4eo6Udt5qQ1eQ4PCoMado8zk1nhiAyyx21yNonTm2gJK9vFi7yI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_RPtKwn9TdEpjMv1XXDUJXibficq83h0I2C2QoVfbTA&oe=6AEF39E0"}, "display_name": "Fire Safety Theory 101", "keywords": ["Fire", "Safety", "Training", "Learning"], "long_description": "This is a short experience where you can learn about the elements that form a fire, how to identify the type of fuel and which extinguishers should be used against each type of fire.\n\nNote: This course was developed and it's used in Australia. The classification of the classes of fire and the colour codes from the extinguisher's label used on this course follow the Australian requirements, which are different depending on the country.", "short_description": "This VR programme covers the theory on the components of what makes up a fire, classes of fire and what type of fire extinguisher to use on the particular classes of fire."}]}, "developer_name": "Carlos Melo, Daniel Jochem", "developer_privacy_policy_url": "https://www.xrjv-training.com/xrjv-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XRJV", "support_website_url":
n.com&_nc_ss=7a30f&oh=00_Af0wOb8l-c806EJZUpPiyGxiSnK50XiEu1w3bLht6wtFKg&oe=69DA444E"}, {"file_name": "12 2560x1440.png", "id": "275001360320221", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86594846_275001363653554_2284479870562544233_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l8FqAu4fUAcQ7kNvwHO1VJ1&_nc_oc=AdoIr6eZxYTIm8lhmF6NK-rPMPEsj6UlB9T9gBZgoGLaMKc2-khGZnDtLq-EaTHOMZY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3K70oqGSY5DtWNFa33O2dycTXLyjhC90AW-L0T7J3ZQA&oe=69DA2A53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "10 2560x1440.png", "id": "1027376847734176", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75363514_1027376854400842_1408430033317615724_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VbcsnPDjV9UQ7kNvwFF9xfM&_nc_oc=AdpjwRk4eiqqX4Wzikvste1ArUuzFPCPz7VF1nPk6Mi5X6swFw8Tn43enL7hMRtZZeA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3uGdFg_igfbtwt1RDXRaHJWDOyPSs-cUcwLMYZi9FtjA&oe=69DA5EE0"}, "display_name": "Fire Safety Theory 101", "keywords": ["Fire", "Safety", "Training", "Learning"], "long_description": "This is a short experience where you can learn about the elements that form a fire, how to identify the type of fuel and which extinguishers should be used against each type of fire.\n\nNote: This course was developed and it's used in Australia. The classification of the classes of fire and the colour codes from the extinguisher's label used on this course follow the Australian requirements, which are different depending on the country.", "short_description": "This VR programme covers the theory on the components of what makes up a fire, classes of fire and what type of fire extinguisher to use on the particular classes of fire."}]}, "developer_name": "Carlos Melo, Daniel Jochem", "developer_privacy_policy_url": "https://www.xrjv-training.com/xrjv-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XRJV", "support_website_url":
n.com&_nc_ss=7f20f&oh=00_Af6IB0wnkYVKJUBN9QYmNPF5PCyfX4VplV9YfhQhpZlxBQ&oe=69F9E84E"}, {"file_name": "12 2560x1440.png", "id": "275001360320221", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86594846_275001363653554_2284479870562544233_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UnbJLDxSclUQ7kNvwGLx7M-&_nc_oc=Adp2Fz4pOKnEtjVgB_oB0EeUF_BflmS1fWe7KkVJkUGFHAhD4z4SSznty0RoQpmtLmk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5obCA6Zo6zMIzhbClCT3NeSBbTrVQxdGRsMQdI0OqntA&oe=69FA0693"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "10 2560x1440.png", "id": "1027376847734176", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75363514_1027376854400842_1408430033317615724_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2XVag5zklMcQ7kNvwGnoWUd&_nc_oc=Adq7kELx_Q_sgU5cLWYU0bMCc5PTd5_QggRNMXLLXVk4oC9wfewyzDGZI0BlGk_-G90&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6eBxLtV8bAy4tI1944wLemzMe_diz1aTnUWeLdXIa7QQ&oe=69FA02E0"}, "display_name": "Fire Safety Theory 101", "keywords": ["Fire", "Safety", "Training", "Learning"], "long_description": "This is a short experience where you can learn about the elements that form a fire, how to identify the type of fuel and which extinguishers should be used against each type of fire.\n\nNote: This course was developed and it's used in Australia. The classification of the classes of fire and the colour codes from the extinguisher's label used on this course follow the Australian requirements, which are different depending on the country.", "short_description": "This VR programme covers the theory on the components of what makes up a fire, classes of fire and what type of fire extinguisher to use on the particular classes of fire."}]}, "developer_name": "Carlos Melo, Daniel Jochem", "developer_privacy_policy_url": "https://www.xrjv-training.com/xrjv-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XRJV", "support_website_url":
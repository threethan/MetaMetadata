n.com&_nc_ss=7f20f&oh=00_Af8zJT-JQzv-Bunw97HYxRQypSfLYx9IMLd6w5U-dYLU0A&oe=6A280CCE"}, {"file_name": "12 2560x1440.png", "id": "275001360320221", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86594846_275001363653554_2284479870562544233_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vfgy42EmuaIQ7kNvwFm8Yt-&_nc_oc=AdpJQ4tk4LH5EcCt0hi7d7Twvqbup16mWpTCUNJzuVRERCdlq8RE5IkOA_S09aHtAxs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-fIkayqNxyh8GsV-3fsujtxd25ARKILKkvfZgrvMT4A&oe=6A282B13"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "10 2560x1440.png", "id": "1027376847734176", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75363514_1027376854400842_1408430033317615724_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0RoanDi1RkYQ7kNvwFc77oa&_nc_oc=Adr9OtItH9gkY0L-Fbv91doWWqC7tBXUdGQzRfkE-_mO_r7gkAKclFzlwD0vUXlSenY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9CgXt6ebQQUpgvU-sBD_0breggpe4YwM_xMWZ48MR_Aw&oe=6A282760"}, "display_name": "Fire Safety Theory 101", "keywords": ["Fire", "Safety", "Training", "Learning"], "long_description": "This is a short experience where you can learn about the elements that form a fire, how to identify the type of fuel and which extinguishers should be used against each type of fire.\n\nNote: This course was developed and it's used in Australia. The classification of the classes of fire and the colour codes from the extinguisher's label used on this course follow the Australian requirements, which are different depending on the country.", "short_description": "This VR programme covers the theory on the components of what makes up a fire, classes of fire and what type of fire extinguisher to use on the particular classes of fire."}]}, "developer_name": "Carlos Melo, Daniel Jochem", "developer_privacy_policy_url": "https://www.xrjv-training.com/xrjv-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XRJV", "support_website_url":
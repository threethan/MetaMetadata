n.com&_nc_ss=7a30f&oh=00_Afw6ge6VvyhIvu3RkrPXijQoKX-O0TFeSITtZ940c14RuA&oe=69C67DCE"}, {"file_name": "12 2560x1440.png", "id": "275001360320221", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/86594846_275001363653554_2284479870562544233_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4l9ZIVY99o8Q7kNvwGZBMM7&_nc_oc=Adoidhsc7AmFuGc5uvYjQpnmcmAjBL0p5dRlDcKf_dYFkb5dzSYxdsK_MP-bHa3bWbQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzljZnU_05Z5RrUbmeLczWGYIlBK-KM14nSx2-xJabFWA&oe=69C663D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "10 2560x1440.png", "id": "1027376847734176", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75363514_1027376854400842_1408430033317615724_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3k8ORaBsZ_UQ7kNvwE1BqhZ&_nc_oc=Adqh5BOwjhBPrY1g0jUe-v71AEi8gVxUGUEixHqG338qPo638XJqbw76EG3zdAfU6Bg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxzer8hp8SxNLFXD8UQ5oGfmclU_Ur0Zhq_tHDGdOduHQ&oe=69C69860"}, "display_name": "Fire Safety Theory 101", "keywords": ["Fire", "Safety", "Training", "Learning"], "long_description": "This is a short experience where you can learn about the elements that form a fire, how to identify the type of fuel and which extinguishers should be used against each type of fire.\n\nNote: This course was developed and it's used in Australia. The classification of the classes of fire and the colour codes from the extinguisher's label used on this course follow the Australian requirements, which are different depending on the country.", "short_description": "This VR programme covers the theory on the components of what makes up a fire, classes of fire and what type of fire extinguisher to use on the particular classes of fire."}]}, "developer_name": "Carlos Melo, Daniel Jochem", "developer_privacy_policy_url": "https://www.xrjv-training.com/xrjv-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XRJV", "support_website_url":
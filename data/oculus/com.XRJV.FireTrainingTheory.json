n.com&_nc_ss=7a30f&oh=00_Af3knp6kP-VMHQnK_-nCH6243PIokULLYt6pgU40RF1lcA&oe=69E22D4E"}, {"file_name": "12 2560x1440.png", "id": "275001360320221", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/86594846_275001363653554_2284479870562544233_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FdYvVsiir1EQ7kNvwG6z-GI&_nc_oc=Adr4s2jjz7dTo1kF-pfthZdf67WYGfnO09iqFmkRBPmV92izAZSy0fmjiTbsOSJbC-o&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0vGqOWYSj7EA8NFU2WpNNmXqGAcAo-hDufI53fo1QpTQ&oe=69E24B93"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "10 2560x1440.png", "id": "1027376847734176", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75363514_1027376854400842_1408430033317615724_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ylLeGdkH-GgQ7kNvwHTy8YI&_nc_oc=AdpCplrRBb2HayM5K1xTQWwV2bA5GogYKlrHEMG6NKQp7ruv83_8yMiVNEXToD4F4AY&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1zEcgwp0b9sK9KYcd4vl-iLm8h1Ia3lZMjNj3hX8cq_w&oe=69E247E0"}, "display_name": "Fire Safety Theory 101", "keywords": ["Fire", "Safety", "Training", "Learning"], "long_description": "This is a short experience where you can learn about the elements that form a fire, how to identify the type of fuel and which extinguishers should be used against each type of fire.\n\nNote: This course was developed and it's used in Australia. The classification of the classes of fire and the colour codes from the extinguisher's label used on this course follow the Australian requirements, which are different depending on the country.", "short_description": "This VR programme covers the theory on the components of what makes up a fire, classes of fire and what type of fire extinguisher to use on the particular classes of fire."}]}, "developer_name": "Carlos Melo, Daniel Jochem", "developer_privacy_policy_url": "https://www.xrjv-training.com/xrjv-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XRJV", "support_website_url":
n.com&_nc_ss=7a30f&oh=00_AfyEmwvQgOcyKYMa32Hmq2iwgOyLLIQTwIBnhG263-58EA&oe=69C3DACE"}, {"file_name": "12 2560x1440.png", "id": "275001360320221", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/86594846_275001363653554_2284479870562544233_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rit795_62AcQ7kNvwG1YKdI&_nc_oc=AdpNfokELSqXOQHjkDK8Tc2MXeoaRhqoeiRRNCr83JsO-CQBOuqrJ1TDJ8tSa9Wr154&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzg5NAzqlzvqBglD_KbuIDMWwQISvZ8iXFOWD6H0vX-Ag&oe=69C3C0D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "10 2560x1440.png", "id": "1027376847734176", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75363514_1027376854400842_1408430033317615724_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TbBw1D4KVt8Q7kNvwHFbT3F&_nc_oc=Adp7NrsFkL3lAidDXoCDpv4yD96Zz8gCbdSTZXOMqUlulQ8xg_Va-TvnFG3mThauyCE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy3KHfFh_CQuzTbvscUEl6jHGmIQ-0KCqpxRzxaOLib_Q&oe=69C3BD20"}, "display_name": "Fire Safety Theory 101", "keywords": ["Fire", "Safety", "Training", "Learning"], "long_description": "This is a short experience where you can learn about the elements that form a fire, how to identify the type of fuel and which extinguishers should be used against each type of fire.\n\nNote: This course was developed and it's used in Australia. The classification of the classes of fire and the colour codes from the extinguisher's label used on this course follow the Australian requirements, which are different depending on the country.", "short_description": "This VR programme covers the theory on the components of what makes up a fire, classes of fire and what type of fire extinguisher to use on the particular classes of fire."}]}, "developer_name": "Carlos Melo, Daniel Jochem", "developer_privacy_policy_url": "https://www.xrjv-training.com/xrjv-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XRJV", "support_website_url":
n.com&_nc_ss=7f20f&oh=00_AQOhP5C5UeqYZOJeZjZu9Rvo9uhNlgG8v5nmUTVlcVoMSw&oe=6AC91C0E"}, {"file_name": "12 2560x1440.png", "id": "275001360320221", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/86594846_275001363653554_2284479870562544233_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XA_BUCyXE78Q7kNvwF2BNjc&_nc_oc=AdpoXhYpaMLlvptr3allVg0eflWtjGtEt3HPN3clIrsMD71Fw_J0VLycJ85jbLBkJCg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO528eLyhVt4cvu4ADdlwTD9LQ-lHDp6jo9RvSajrR4nA&oe=6AC90213"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "10 2560x1440.png", "id": "1027376847734176", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75363514_1027376854400842_1408430033317615724_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LCfOdOptbGQQ7kNvwH9jxfn&_nc_oc=Ado-H9vUEOxOy0Tkvbj1_nPJT_ZEMG5jwaOR5WupIJyp_i2dLB6Rb_e9JFgZfFfZMPo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMjh-nRNN4I58Wi4E627E452yYVL8a5DucRxO1tJD5u-Q&oe=6AC8FE60"}, "display_name": "Fire Safety Theory 101", "keywords": ["Fire", "Safety", "Training", "Learning"], "long_description": "This is a short experience where you can learn about the elements that form a fire, how to identify the type of fuel and which extinguishers should be used against each type of fire.\n\nNote: This course was developed and it's used in Australia. The classification of the classes of fire and the colour codes from the extinguisher's label used on this course follow the Australian requirements, which are different depending on the country.", "short_description": "This VR programme covers the theory on the components of what makes up a fire, classes of fire and what type of fire extinguisher to use on the particular classes of fire."}]}, "developer_name": "Carlos Melo, Daniel Jochem", "developer_privacy_policy_url": "https://www.xrjv-training.com/xrjv-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XRJV", "support_website_url":
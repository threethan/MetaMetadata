n.com&_nc_ss=7f20f&oh=00_AQMOLEm0SrwKZ0Wt8wsaTuj0qN2GgxmsQh2bSwvzDynyPQ&oe=6ACD108E"}, {"file_name": "12 2560x1440.png", "id": "275001360320221", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86594846_275001363653554_2284479870562544233_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LlxEz2_GtVoQ7kNvwFQmBB2&_nc_oc=AdoIUa1Zd0WaMAup5avcEdl6GTqJPguA2YdY-DCoCZ7ohah-SZkqZw_Kna00v4FFUF0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN7auk_IAQrqccMRoRYsCzgLHZLHzC5ZVU5p0QGXLLNCQ&oe=6ACCF693"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "10 2560x1440.png", "id": "1027376847734176", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75363514_1027376854400842_1408430033317615724_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nG7LBJaX9_cQ7kNvwGd4RZj&_nc_oc=AdoIFwcjwrHKZ9GgglwpmHjk-3_Ol9e6zQDQe-e-R1_39ie2MYBbm4RBiTPeOMEyA3A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOdrgZMb2xzPMrl-q4V3HsFvdvEZB3SW6P65PXGVXSpSQ&oe=6ACCF2E0"}, "display_name": "Fire Safety Theory 101", "keywords": ["Fire", "Safety", "Training", "Learning"], "long_description": "This is a short experience where you can learn about the elements that form a fire, how to identify the type of fuel and which extinguishers should be used against each type of fire.\n\nNote: This course was developed and it's used in Australia. The classification of the classes of fire and the colour codes from the extinguisher's label used on this course follow the Australian requirements, which are different depending on the country.", "short_description": "This VR programme covers the theory on the components of what makes up a fire, classes of fire and what type of fire extinguisher to use on the particular classes of fire."}]}, "developer_name": "Carlos Melo, Daniel Jochem", "developer_privacy_policy_url": "https://www.xrjv-training.com/xrjv-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XRJV", "support_website_url":
n.com&_nc_ss=7f20f&oh=00_Af17g2LJDeqo-uY2t2E0_UpGXh5G2SRmsIgpq70q111n3w&oe=69F5F3CE"}, {"file_name": "12 2560x1440.png", "id": "275001360320221", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/86594846_275001363653554_2284479870562544233_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FUM9qrJxdagQ7kNvwFuI-I2&_nc_oc=AdrvupaSHdqElEDs3kDE2kHBJIG2WxTmS-YGcDN_K8BHo0NgWJayAN2YR4RKNUFI2oQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1RiM5T0WQoLgnV-O1phuLw8u2nR3vfOdn0VwbJ4eCyAQ&oe=69F61213"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "10 2560x1440.png", "id": "1027376847734176", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75363514_1027376854400842_1408430033317615724_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UceOTfRZ-XcQ7kNvwEG5SqA&_nc_oc=AdqzGI1KIGBplqBGWruH5hgLacu0HVLkSotH80IDCtxI69WxWU6izOToSkqdeF-raZg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af295AtypM4xmUgOhK70G24-CDAPB8vJSIe4EBvNQOOw1w&oe=69F60E60"}, "display_name": "Fire Safety Theory 101", "keywords": ["Fire", "Safety", "Training", "Learning"], "long_description": "This is a short experience where you can learn about the elements that form a fire, how to identify the type of fuel and which extinguishers should be used against each type of fire.\n\nNote: This course was developed and it's used in Australia. The classification of the classes of fire and the colour codes from the extinguisher's label used on this course follow the Australian requirements, which are different depending on the country.", "short_description": "This VR programme covers the theory on the components of what makes up a fire, classes of fire and what type of fire extinguisher to use on the particular classes of fire."}]}, "developer_name": "Carlos Melo, Daniel Jochem", "developer_privacy_policy_url": "https://www.xrjv-training.com/xrjv-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XRJV", "support_website_url":
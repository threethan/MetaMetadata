n.com&_nc_ss=7f20f&oh=00_AQGgiy-EhSTo0cOr6R26c_JlGarwYWZe4y4SNzOIb6MDeQ&oe=6A73324E"}, {"file_name": "12 2560x1440.png", "id": "275001360320221", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86594846_275001363653554_2284479870562544233_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YraMgA6qrKwQ7kNvwELZWCe&_nc_oc=Adp-usqGLSqUvRnY_NkKxFDjAKnKCWOqKkGsI4hDW9nQQBdxuK9l1-KcbKJFKUET8_Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHo1BzkqC69yGm2VjrooGE6EghlWoajwuJ7X5Wg62GHLQ&oe=6A735093"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "10 2560x1440.png", "id": "1027376847734176", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75363514_1027376854400842_1408430033317615724_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2CtlFrrMy2wQ7kNvwGt3Bfl&_nc_oc=Adr4K0a6gLQZKCtVlWip8tnecscFccWcaWrdIznlBNDa8qj2ySktL5obNKfoAvcwV2w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgxFXD48dmN18PIDUKbWwqbwU99NUTlxKYs37k0P1d8w&oe=6A734CE0"}, "display_name": "Fire Safety Theory 101", "keywords": ["Fire", "Safety", "Training", "Learning"], "long_description": "This is a short experience where you can learn about the elements that form a fire, how to identify the type of fuel and which extinguishers should be used against each type of fire.\n\nNote: This course was developed and it's used in Australia. The classification of the classes of fire and the colour codes from the extinguisher's label used on this course follow the Australian requirements, which are different depending on the country.", "short_description": "This VR programme covers the theory on the components of what makes up a fire, classes of fire and what type of fire extinguisher to use on the particular classes of fire."}]}, "developer_name": "Carlos Melo, Daniel Jochem", "developer_privacy_policy_url": "https://www.xrjv-training.com/xrjv-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XRJV", "support_website_url":
n.com&_nc_ss=7f20f&oh=00_Af6-piJdJ-eujgXokiJUzrwhwAsEztA4Tj3qqm_ETWtrKw&oe=69FF2E4E"}, {"file_name": "12 2560x1440.png", "id": "275001360320221", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86594846_275001363653554_2284479870562544233_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ge2dbGFT7RgQ7kNvwFwfWz7&_nc_oc=AdpgD7hqIe0_X3mYTSAuWy2DgLQ7tiiZt1tQrX3jIa2XnZd59vJ3VwSGcJr92PdVKBs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7YyqQ_zNqP5h_aXDqYFz7RRXL7m3VAz4A_OWM5rDjbDA&oe=69FF4C93"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "10 2560x1440.png", "id": "1027376847734176", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75363514_1027376854400842_1408430033317615724_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CjHA4Sc5S2UQ7kNvwE2H4Ju&_nc_oc=AdqhDU2K0e7M9pFeGsk7wnG-LNx6N2RyszmjoTUrn3g9fdZ_9FILi2zgWQzpTCfomQ4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5RWFHryQ9Mo2BNDyh2onadIADAD3UlUuyZG1pU1yF0Bg&oe=69FF48E0"}, "display_name": "Fire Safety Theory 101", "keywords": ["Fire", "Safety", "Training", "Learning"], "long_description": "This is a short experience where you can learn about the elements that form a fire, how to identify the type of fuel and which extinguishers should be used against each type of fire.\n\nNote: This course was developed and it's used in Australia. The classification of the classes of fire and the colour codes from the extinguisher's label used on this course follow the Australian requirements, which are different depending on the country.", "short_description": "This VR programme covers the theory on the components of what makes up a fire, classes of fire and what type of fire extinguisher to use on the particular classes of fire."}]}, "developer_name": "Carlos Melo, Daniel Jochem", "developer_privacy_policy_url": "https://www.xrjv-training.com/xrjv-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XRJV", "support_website_url":
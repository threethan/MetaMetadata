n.com&_nc_ss=7f20f&oh=00_Af-4or7g5j9DQoZOJ0FVSRdTCmjcYkLe9cJwdvCAUuwdXA&oe=6A21754E"}, {"file_name": "12 2560x1440.png", "id": "275001360320221", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/86594846_275001363653554_2284479870562544233_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Euu_69l6XsMQ7kNvwEcvdUf&_nc_oc=AdoyFnV_-WsHRIKYBxV_DIUYuTbn3Ow7rSQpQuaaMEpSQdJi1p1a0SToG6492IPsVio&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_V_gC-IO67Dj-ZyMRRoibPrQoSAX3WSFF2k72MnmPKmg&oe=6A219393"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "10 2560x1440.png", "id": "1027376847734176", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75363514_1027376854400842_1408430033317615724_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i6C-Sg_ejr4Q7kNvwEA6iwq&_nc_oc=AdoDwUun__ojKnV9acsyp4wy5u57pN9P-yRLRp8XMuVnQPllw4RT4F6Eu-1pn-dHCto&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9n98aBmZTHji2qiWf9mEsuVN5upJ8KOkAvz-WHES5_Zw&oe=6A218FE0"}, "display_name": "Fire Safety Theory 101", "keywords": ["Fire", "Safety", "Training", "Learning"], "long_description": "This is a short experience where you can learn about the elements that form a fire, how to identify the type of fuel and which extinguishers should be used against each type of fire.\n\nNote: This course was developed and it's used in Australia. The classification of the classes of fire and the colour codes from the extinguisher's label used on this course follow the Australian requirements, which are different depending on the country.", "short_description": "This VR programme covers the theory on the components of what makes up a fire, classes of fire and what type of fire extinguisher to use on the particular classes of fire."}]}, "developer_name": "Carlos Melo, Daniel Jochem", "developer_privacy_policy_url": "https://www.xrjv-training.com/xrjv-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XRJV", "support_website_url":
n.com&_nc_ss=7f20f&oh=00_AQPj0BKHFIFqgKUCgn4YxKjd_Bc-wekGLT-rhHqWgnn3rA&oe=6AE341CE"}, {"file_name": "12 2560x1440.png", "id": "275001360320221", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86594846_275001363653554_2284479870562544233_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TJEdkrdSzlsQ7kNvwGJ5L9K&_nc_oc=Adry_t6A7lod18GnIxd56-ugIcm2_lMc3lzDa7-ZvbOrlrl9ahkQV_KkFEP0leTbibE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMto6aTgxQOW3jnYVUJMI6g6HHKe9GKy4xkxOAd3thZGQ&oe=6AE36013"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "10 2560x1440.png", "id": "1027376847734176", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75363514_1027376854400842_1408430033317615724_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XMAQN5RzAE8Q7kNvwHUOtOC&_nc_oc=AdpB7oZ0V-5fGFnLvYgXoMY8wBV2d2ozItyclTOp6YFOht32Jo9oA10-yCyAcyI-diA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMDJy0Sjr8Wl2-BexrFshBQtZ8SS4OSpsCRQCWnZl6gsA&oe=6AE35C60"}, "display_name": "Fire Safety Theory 101", "keywords": ["Fire", "Safety", "Training", "Learning"], "long_description": "This is a short experience where you can learn about the elements that form a fire, how to identify the type of fuel and which extinguishers should be used against each type of fire.\n\nNote: This course was developed and it's used in Australia. The classification of the classes of fire and the colour codes from the extinguisher's label used on this course follow the Australian requirements, which are different depending on the country.", "short_description": "This VR programme covers the theory on the components of what makes up a fire, classes of fire and what type of fire extinguisher to use on the particular classes of fire."}]}, "developer_name": "Carlos Melo, Daniel Jochem", "developer_privacy_policy_url": "https://www.xrjv-training.com/xrjv-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XRJV", "support_website_url":
n.com&_nc_ss=7f20f&oh=00_Af65mpQ6taED_RDXfqOgUNKh6iLQVccHsLFD_NmlOuDs_A&oe=6A0C5D4E"}, {"file_name": "12 2560x1440.png", "id": "275001360320221", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/86594846_275001363653554_2284479870562544233_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MkbdIqhkpGUQ7kNvwFtf66A&_nc_oc=Adqhv7nv6xQtT1HdJyTq7wwd9YyxiDaarCpn5WKaL89l4YOla_ML2LjjzAG3Dq8GxSg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6JGdjWBaN0rVt0lPP9_2l4lxKDPmnPPjaEt85lRNo_jg&oe=6A0C7B93"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "10 2560x1440.png", "id": "1027376847734176", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75363514_1027376854400842_1408430033317615724_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=US4jtgv64xIQ7kNvwF3orF9&_nc_oc=Adr0mH3_bj8apL4FUH8rEIoE-gWGBNSx_q8Ba0kNPgMFNXSuya0m5zYRUf2-AP9pSUc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6nR2c15fuEtVO9vH8LOW4GDhTNUMG670LsP4bofgOPNQ&oe=6A0C77E0"}, "display_name": "Fire Safety Theory 101", "keywords": ["Fire", "Safety", "Training", "Learning"], "long_description": "This is a short experience where you can learn about the elements that form a fire, how to identify the type of fuel and which extinguishers should be used against each type of fire.\n\nNote: This course was developed and it's used in Australia. The classification of the classes of fire and the colour codes from the extinguisher's label used on this course follow the Australian requirements, which are different depending on the country.", "short_description": "This VR programme covers the theory on the components of what makes up a fire, classes of fire and what type of fire extinguisher to use on the particular classes of fire."}]}, "developer_name": "Carlos Melo, Daniel Jochem", "developer_privacy_policy_url": "https://www.xrjv-training.com/xrjv-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XRJV", "support_website_url":
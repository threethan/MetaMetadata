n.com&_nc_ss=7f20f&oh=00_Af7r4qP5cy6agSNv7ErzJYaHBKUN3smYpHc96Hj-mc0Cvg&oe=6A14464E"}, {"file_name": "12 2560x1440.png", "id": "275001360320221", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86594846_275001363653554_2284479870562544233_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4IcuSYQvig0Q7kNvwG90-wl&_nc_oc=Adp3infL7IrBizhUelrrn-cPA4kaT3vH1v8ZDiGR1kUjK5889bmzSiN6in88N-mRajE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5eAGf-1xfK7qbNwHRX_nxi1C3zMEF7m49n4Q93wbBK1A&oe=6A146493"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "10 2560x1440.png", "id": "1027376847734176", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75363514_1027376854400842_1408430033317615724_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hfhnUAFehK4Q7kNvwFpi-T9&_nc_oc=Adpmle3ql2HeDfdTQEflKehJxQQ-oa53XuepgJ_Wkyg8Xd5Jf7UkWJrZccIlAO9XJB4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7R92oKhM_F5a12P5hCl7A4_cdDqZjQNzcerkOSWa_5vQ&oe=6A1460E0"}, "display_name": "Fire Safety Theory 101", "keywords": ["Fire", "Safety", "Training", "Learning"], "long_description": "This is a short experience where you can learn about the elements that form a fire, how to identify the type of fuel and which extinguishers should be used against each type of fire.\n\nNote: This course was developed and it's used in Australia. The classification of the classes of fire and the colour codes from the extinguisher's label used on this course follow the Australian requirements, which are different depending on the country.", "short_description": "This VR programme covers the theory on the components of what makes up a fire, classes of fire and what type of fire extinguisher to use on the particular classes of fire."}]}, "developer_name": "Carlos Melo, Daniel Jochem", "developer_privacy_policy_url": "https://www.xrjv-training.com/xrjv-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XRJV", "support_website_url":
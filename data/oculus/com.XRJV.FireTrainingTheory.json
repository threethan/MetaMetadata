n.com&_nc_ss=7f20f&oh=00_AQTnJiex5UrtFW2QnTa6I7dbhkQDv6NlrpqiMikajzo8XQ&oe=6AF0A90E"}, {"file_name": "12 2560x1440.png", "id": "275001360320221", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86594846_275001363653554_2284479870562544233_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IBV1kb7O1KgQ7kNvwFL2PoH&_nc_oc=AdrfTYvDfUEUZuLOJDWm3nu3zeAclWPo4sQilQ1rV0i0Jaw-kSGdK7lLjsU4o4828Uo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwo1Aj4A6hdarw9V1HF11xDQAxiEGkSo-QCnU5MZ2ZEg&oe=6AF08F13"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "10 2560x1440.png", "id": "1027376847734176", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75363514_1027376854400842_1408430033317615724_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=flkR4WZbUwoQ7kNvwG82-ln&_nc_oc=Adqq8MRKjxSTyFYHdm2eJcvlPwTX5b-k5nuhRbPeaebymovM3iiLg9BBN3hn8RHio8U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSeR1spEveEx0f6dv-fgwTGmZUL-VxDcseYroG_AhvIEg&oe=6AF08B60"}, "display_name": "Fire Safety Theory 101", "keywords": ["Fire", "Safety", "Training", "Learning"], "long_description": "This is a short experience where you can learn about the elements that form a fire, how to identify the type of fuel and which extinguishers should be used against each type of fire.\n\nNote: This course was developed and it's used in Australia. The classification of the classes of fire and the colour codes from the extinguisher's label used on this course follow the Australian requirements, which are different depending on the country.", "short_description": "This VR programme covers the theory on the components of what makes up a fire, classes of fire and what type of fire extinguisher to use on the particular classes of fire."}]}, "developer_name": "Carlos Melo, Daniel Jochem", "developer_privacy_policy_url": "https://www.xrjv-training.com/xrjv-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XRJV", "support_website_url":
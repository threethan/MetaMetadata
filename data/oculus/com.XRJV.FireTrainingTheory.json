n.com&_nc_ss=7f20f&oh=00_Af8b9N-ogKliBHolV7EHG3C_-Uyup8DxL8Be7cQcUZDJpg&oe=6A426ACE"}, {"file_name": "12 2560x1440.png", "id": "275001360320221", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86594846_275001363653554_2284479870562544233_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ayYYptI0OoQ7kNvwFIsHr2&_nc_oc=Adp-2So7L1po7aRTRWCcOsjPauv6x6s9VjxAx9ZvCOvmszyWlOCHXpLCw5y0zJmVfQw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-41VIFYpdn8IbAajBONCZa0vxvEK0VpHcmToiq9HAR5w&oe=6A428913"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "10 2560x1440.png", "id": "1027376847734176", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75363514_1027376854400842_1408430033317615724_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w7xXITOEFTgQ7kNvwEAgnpQ&_nc_oc=Adp5CXJsOAToqkVhCchMlvISkguI0QJk9vqp5IvukCZapHiwrTxGG7RTBeeX51tlL2s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9o6i9Z-rKaDJmT21fu_U2vh28Jybya-arUHR567KsEMA&oe=6A428560"}, "display_name": "Fire Safety Theory 101", "keywords": ["Fire", "Safety", "Training", "Learning"], "long_description": "This is a short experience where you can learn about the elements that form a fire, how to identify the type of fuel and which extinguishers should be used against each type of fire.\n\nNote: This course was developed and it's used in Australia. The classification of the classes of fire and the colour codes from the extinguisher's label used on this course follow the Australian requirements, which are different depending on the country.", "short_description": "This VR programme covers the theory on the components of what makes up a fire, classes of fire and what type of fire extinguisher to use on the particular classes of fire."}]}, "developer_name": "Carlos Melo, Daniel Jochem", "developer_privacy_policy_url": "https://www.xrjv-training.com/xrjv-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XRJV", "support_website_url":
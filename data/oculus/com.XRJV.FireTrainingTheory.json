n.com&_nc_ss=7f20f&oh=00_AQG7ljFKBrSm9ECyg3UWEvd9AtD2W8u0m_UWYXsKqIaBPA&oe=6A9427CE"}, {"file_name": "12 2560x1440.png", "id": "275001360320221", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/86594846_275001363653554_2284479870562544233_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bQYqpFeo5yIQ7kNvwFEF3OC&_nc_oc=AdqNN9oldReKELJL9sqTuFvn23BI6mE6Ao1Ij_tLfDuxzux-3ptbclL4QUe5habSLMo&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQENz9Vzzy_k5EwwdocZIi7zJScE_rYgLUbhE89mP651OQ&oe=6A940DD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "10 2560x1440.png", "id": "1027376847734176", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75363514_1027376854400842_1408430033317615724_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kfcpIln3uhMQ7kNvwH3T216&_nc_oc=AdrqyFNz6J-pibhU9D_6DE5cGnwDQw6k51B4YMxaQbuBM_O7TWOedFO5677UpTurmrA&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0I2diE0QjZJftSsRGPKe-kYSuo_w1YrUxu-IsUQ8HdQ&oe=6A940A20"}, "display_name": "Fire Safety Theory 101", "keywords": ["Fire", "Safety", "Training", "Learning"], "long_description": "This is a short experience where you can learn about the elements that form a fire, how to identify the type of fuel and which extinguishers should be used against each type of fire.\n\nNote: This course was developed and it's used in Australia. The classification of the classes of fire and the colour codes from the extinguisher's label used on this course follow the Australian requirements, which are different depending on the country.", "short_description": "This VR programme covers the theory on the components of what makes up a fire, classes of fire and what type of fire extinguisher to use on the particular classes of fire."}]}, "developer_name": "Carlos Melo, Daniel Jochem", "developer_privacy_policy_url": "https://www.xrjv-training.com/xrjv-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XRJV", "support_website_url":
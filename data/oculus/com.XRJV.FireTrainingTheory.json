n.com&_nc_ss=7a30f&oh=00_Af3KK1vYYVhEnvXgl54w3tA4ee_H5nogEiqoJ4tkfyzAqQ&oe=69D3ACCE"}, {"file_name": "12 2560x1440.png", "id": "275001360320221", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86594846_275001363653554_2284479870562544233_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=64q29n6ty98Q7kNvwFVr-Oa&_nc_oc=AdprHDTIZM7N8IbCM5bT-_os4zW_8D1SGcONi8DKZdPWVYVptxfKdEhXm7sGLVOUhEA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3d0fbOAyoe_lhfj_8jnzFc4ubjcLbhyrhiYa2cCo_f0Q&oe=69D392D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "10 2560x1440.png", "id": "1027376847734176", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75363514_1027376854400842_1408430033317615724_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O6RrNNOuSq8Q7kNvwF911rl&_nc_oc=AdrV_VK6a75Wl6NxhW8XxEggR6wi5QC4cEVnkWNjD4fer3j-8Lvv-lgcDP38YWkPT-g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2UELa7S00MrdKFy0BCvXADScW4_22J0rIgifYn8TVMmw&oe=69D3C760"}, "display_name": "Fire Safety Theory 101", "keywords": ["Fire", "Safety", "Training", "Learning"], "long_description": "This is a short experience where you can learn about the elements that form a fire, how to identify the type of fuel and which extinguishers should be used against each type of fire.\n\nNote: This course was developed and it's used in Australia. The classification of the classes of fire and the colour codes from the extinguisher's label used on this course follow the Australian requirements, which are different depending on the country.", "short_description": "This VR programme covers the theory on the components of what makes up a fire, classes of fire and what type of fire extinguisher to use on the particular classes of fire."}]}, "developer_name": "Carlos Melo, Daniel Jochem", "developer_privacy_policy_url": "https://www.xrjv-training.com/xrjv-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XRJV", "support_website_url":
n.com&_nc_ss=7f20f&oh=00_AQND-CD3pD0EC_zDsyb-u3haHwuiS-g9CY166oq7F0E7BQ&oe=6AE1F04E"}, {"file_name": "12 2560x1440.png", "id": "275001360320221", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86594846_275001363653554_2284479870562544233_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SwrTC0GZlTUQ7kNvwFB1Eea&_nc_oc=Adqdwhaawi8TGlj16zpZ44zirbFVkycArqDcyEIU-CigngCn8po--Wf-LAB8nIz5n3I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPkVz59uGxtTPWuY9WftGYOLuVWRW3-lK7kzOtOxYGh3Q&oe=6AE20E93"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "10 2560x1440.png", "id": "1027376847734176", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75363514_1027376854400842_1408430033317615724_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_EPIrkzn7s0Q7kNvwHmo6cJ&_nc_oc=AdpfegvvK1uNSq7DLsxf9WxK8F9F8yi8JxiOHqiohp5BuPZhJvURtMwcInmaJG9Ap1w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPK1cVyBMh9jioZuO-J-nkgD0qvyGlxKivhcUAZlvUtXQ&oe=6AE20AE0"}, "display_name": "Fire Safety Theory 101", "keywords": ["Fire", "Safety", "Training", "Learning"], "long_description": "This is a short experience where you can learn about the elements that form a fire, how to identify the type of fuel and which extinguishers should be used against each type of fire.\n\nNote: This course was developed and it's used in Australia. The classification of the classes of fire and the colour codes from the extinguisher's label used on this course follow the Australian requirements, which are different depending on the country.", "short_description": "This VR programme covers the theory on the components of what makes up a fire, classes of fire and what type of fire extinguisher to use on the particular classes of fire."}]}, "developer_name": "Carlos Melo, Daniel Jochem", "developer_privacy_policy_url": "https://www.xrjv-training.com/xrjv-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XRJV", "support_website_url":
n.com&_nc_ss=7a30f&oh=00_Af3OEMWlqPdD4GTUOSi9GE-GjO6QJn7sYAkJmeo74NgsZA&oe=69D7A14E"}, {"file_name": "12 2560x1440.png", "id": "275001360320221", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/86594846_275001363653554_2284479870562544233_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jpcCDbPhITMQ7kNvwHempAI&_nc_oc=Adpo2oSgOPz07R31vaX3Xj-_kH56DXXVd93zQRg6HcTBCSSs0CLY1ajMwBn0YSFqCIU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3rsPXWTLbh_R6u3bICj_FEax8D6C-iVHUq3btdwIlOaA&oe=69D78753"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "10 2560x1440.png", "id": "1027376847734176", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75363514_1027376854400842_1408430033317615724_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yuKiD8zmZLsQ7kNvwGat_6y&_nc_oc=AdrlqO5n3p6fFzZ9Fq47v35Y9eYWm3uKkIJsgkSK20dTTs4FG-gmbD-Zi8myAearNTk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1U7CsrSxqR0MxlOgbDmsY_nL45tT6pVActqEmBf_NDCw&oe=69D7BBE0"}, "display_name": "Fire Safety Theory 101", "keywords": ["Fire", "Safety", "Training", "Learning"], "long_description": "This is a short experience where you can learn about the elements that form a fire, how to identify the type of fuel and which extinguishers should be used against each type of fire.\n\nNote: This course was developed and it's used in Australia. The classification of the classes of fire and the colour codes from the extinguisher's label used on this course follow the Australian requirements, which are different depending on the country.", "short_description": "This VR programme covers the theory on the components of what makes up a fire, classes of fire and what type of fire extinguisher to use on the particular classes of fire."}]}, "developer_name": "Carlos Melo, Daniel Jochem", "developer_privacy_policy_url": "https://www.xrjv-training.com/xrjv-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XRJV", "support_website_url":
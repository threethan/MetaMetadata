n.com&_nc_ss=7a30f&oh=00_AfzxY6CjC69tbYg8XG5nKWrXY6ZD9seBurcWmutAadluBw&oe=69C52C4E"}, {"file_name": "12 2560x1440.png", "id": "275001360320221", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86594846_275001363653554_2284479870562544233_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rit795_62AcQ7kNvwFtcNoV&_nc_oc=AdrtZV1-mQDTrjOd6CSN3Ae-QsZvvcI1ihxMYVVhcPCK7Gi4TGLFbPlHU6neg3XltDc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx7e4W7Ld2-aS2aOmtGmxA4HBaZfZVe2gm1CDtj3FA6Hw&oe=69C51253"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "10 2560x1440.png", "id": "1027376847734176", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75363514_1027376854400842_1408430033317615724_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TbBw1D4KVt8Q7kNvwH5NZcq&_nc_oc=AdrsmoeQOnA7MafV-JfEh4n_imP9V_SryKLdlwGVSLrtNGNah-7wMJwIKfD6-ypneCc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyj71gRJxNbAEHccIeHzU8K0GoKucmFW8F_dH7jldJ6AA&oe=69C546E0"}, "display_name": "Fire Safety Theory 101", "keywords": ["Fire", "Safety", "Training", "Learning"], "long_description": "This is a short experience where you can learn about the elements that form a fire, how to identify the type of fuel and which extinguishers should be used against each type of fire.\n\nNote: This course was developed and it's used in Australia. The classification of the classes of fire and the colour codes from the extinguisher's label used on this course follow the Australian requirements, which are different depending on the country.", "short_description": "This VR programme covers the theory on the components of what makes up a fire, classes of fire and what type of fire extinguisher to use on the particular classes of fire."}]}, "developer_name": "Carlos Melo, Daniel Jochem", "developer_privacy_policy_url": "https://www.xrjv-training.com/xrjv-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XRJV", "support_website_url":
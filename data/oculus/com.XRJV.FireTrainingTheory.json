n.com&_nc_ss=7f20f&oh=00_Af-55wg4aOF7hi4lA9LgVXpwsc3zB5bPmd9A6jz8pTG3Vw&oe=6A3298CE"}, {"file_name": "12 2560x1440.png", "id": "275001360320221", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/86594846_275001363653554_2284479870562544233_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bd6PA8W6L34Q7kNvwGB6Jfq&_nc_oc=AdpPMaTN4T0dYq7nnU4p9N4ReCudPI1v6i6sy5cgX_3b2G7MRUAz6kTwJg4LQXFi5LM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81aQ2l5SMh8oB8Xx3nTUd5uqR2vQLEC72devg9dyF1Hw&oe=6A32B713"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "10 2560x1440.png", "id": "1027376847734176", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75363514_1027376854400842_1408430033317615724_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OWuvdRfTqXoQ7kNvwFQkFBq&_nc_oc=AdqU74raBd_CHIhoYMnVr_2qNMtaaeEb4HRFnP5_Yju8hcgc6R922os6-p4m7O5qvec&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9p4k3efS9-ci2JLxgL0gVDMGP3fvlVzW15Y1I2McC55Q&oe=6A32B360"}, "display_name": "Fire Safety Theory 101", "keywords": ["Fire", "Safety", "Training", "Learning"], "long_description": "This is a short experience where you can learn about the elements that form a fire, how to identify the type of fuel and which extinguishers should be used against each type of fire.\n\nNote: This course was developed and it's used in Australia. The classification of the classes of fire and the colour codes from the extinguisher's label used on this course follow the Australian requirements, which are different depending on the country.", "short_description": "This VR programme covers the theory on the components of what makes up a fire, classes of fire and what type of fire extinguisher to use on the particular classes of fire."}]}, "developer_name": "Carlos Melo, Daniel Jochem", "developer_privacy_policy_url": "https://www.xrjv-training.com/xrjv-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XRJV", "support_website_url":
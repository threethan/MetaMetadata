n.com&_nc_ss=7f20f&oh=00_AQKtSrdo-OJPA41_w1Irou85Bo04sQdPJVMnYbBLYJFt3Q&oe=6A996DCE"}, {"file_name": "12 2560x1440.png", "id": "275001360320221", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86594846_275001363653554_2284479870562544233_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EDw-aJ8lT5oQ7kNvwGEPsNO&_nc_oc=AdqEjtb_SghBPiiguwhg9Px06nR9D5KIjHsK6NouB_ZSq6-gMcyIP1TEI0R4aKn9GRQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJhZOJSig3G_6GUCw-N5uqRuz2ZMsBZSntYGQ6JfCceYg&oe=6A998C13"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "10 2560x1440.png", "id": "1027376847734176", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75363514_1027376854400842_1408430033317615724_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vNiBXRxnkw4Q7kNvwF0Rbz-&_nc_oc=Adog2C6ElwDY4GuOjSL_jRHoIFuy1p3WoRPz53_QVUeOiIW1KVEV0adVhMxuOHlyQoM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDBQb49qL5pQmoKOP0zy8Grrhle3JpTE71NPRYAzVtcA&oe=6A998860"}, "display_name": "Fire Safety Theory 101", "keywords": ["Fire", "Safety", "Training", "Learning"], "long_description": "This is a short experience where you can learn about the elements that form a fire, how to identify the type of fuel and which extinguishers should be used against each type of fire.\n\nNote: This course was developed and it's used in Australia. The classification of the classes of fire and the colour codes from the extinguisher's label used on this course follow the Australian requirements, which are different depending on the country.", "short_description": "This VR programme covers the theory on the components of what makes up a fire, classes of fire and what type of fire extinguisher to use on the particular classes of fire."}]}, "developer_name": "Carlos Melo, Daniel Jochem", "developer_privacy_policy_url": "https://www.xrjv-training.com/xrjv-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XRJV", "support_website_url":
1&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BE37sGkN73IQ7kNvwGJlVsq&_nc_oc=AdoIXKq330K52QwK5EZzolwsBIFBZPaOCGUg0ch8pOUO5HwYz6uAIZlKTDEkNQtw2EI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2e464Zx9nrHqwWoSPzt7SdLjFKg5CR1nc9R8E5-vde4A&oe=69E8DC7F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "capsule-2560-1440-v5.png", "id": "431320982143609", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982698_431320985476942_5789175747859072348_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7rWxkrHc_vcQ7kNvwF2WHrB&_nc_oc=AdqACX1D_MIaw3ZDxOajZt-nH-uJGgdhRrToqhWot1zuSv8c7AIkD33TYv46P-GMqn4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0iClA-x2xz933ROfQ_DcHve9pvjKxTdGrj59q_lxORow&oe=69E8B868"}, "display_name": "Superfly", "keywords": [], "long_description": "Superfly is an open-world action sandbox game where you play as a superhero who can switch between eight different movement modes. Discover new forms of locomotion as you experiment with pairs of movement modes and explore the city any way you would like. Use each mode\u2019s unique abilities to fight the army of robots invading the city.\n\nInteract with the tens of thousands of vehicles and dynamic objects that bring life to the city. Fight robotic bosses that have EMP and hacking powers to disable your abilities. Collect gears through exploration and defeating enemies in the Story Mode to unlock even more unique sidegrades for your powers. All objects and abilities are entirely based in the physics engine, leading to emergent gameplay limited only by your creativity.\n\nSuperfly is developed by Loco Motion Devs, check out our website to learn more about the team. Join our community on Discord: https://discord.gg/Ed3E9HP", "short_description": "Superfly is a virtual reality action game where you play as the superhero of your dreams. Mix and match eight unique movement modes to fly through a massive open-world city full of challenges for your movement and combat skills. "}]}, "developer_name": "Loco Motion Devs", "developer_privacy_policy_url": "https://superflyvrgame.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Loco Motion Devs", "support_website_url": "https://superflyvrgame.com/contact", "website_url": "https://superflyvrgame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1167477183996426"}}]}, "scheduled_offers": {"count": 11, "nodes": [{"status": "PUBLISHED", "id": "2085387702194456"}, {"status": "PUBLISHED", "id": "930065189528829"}, {"status": "PUBLISHED", "id": "1329026538911821"}, {"status": "PUBLISHED", "id": "874897231661065"}, {"status": "PUBLISHED", "id": "2357035494739872"}, {"status": "PUBLISHED", "id": "1318098892526956"}, {"status": "PUBLISHED", "id": "1226825852104815"}, {"status": "PUBLISHED", "id": "1329109895056912"}, {"status": "PUBLISHED", "id": "915088657444182"}, {"status": "PUBLISHED", "id": "411624722005440"}, {"status": "PUBLISHED", "id": "3267691093556164"}]}, "baseline_offer": {"id": "3267691093556164"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1776445200, "status": "PUBLISHED", "id": "2085387702194456"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24160664796855654", "version": "1.3.2"},
3akjelmXcQ7kNvwHmVxn-&_nc_oc=Adp0K3gNNFkZa_24wWQ767496xBFr_mc-l2aZGbiISjfvwNw_G2v9gIS8x8_BCRHeVM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRSnawoblaaNo8TzBgOODUI1FPpZlyYL2Kkm0UvK75NQ&oe=6AF09115"}, {"file_name": "Arquitecture.png", "id": "1553351126576627", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619668_1553351129909960_629592202932966666_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=juQod8AaWEkQ7kNvwF49ag3&_nc_oc=Adp2qdyuXsbb7xiYAWv-1jTWJBY-VJrinOZBprnqCL-ZwmXEZ6nDAa582YySC1KMMNM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsDslyYyRk3VpKww_Ea0bKx6drZqcFs4S6X_yQdwK8KA&oe=6AF0A725"}, {"file_name": "Tensiometro.png", "id": "36251387067840171", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623295_36251387111173500_6293926571928592602_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R9PKzfCI-fwQ7kNvwEed6vG&_nc_oc=AdqOz8y-faDCDNvkd9MBM8PJYCOLf23YmqGUFYJyLEtXvPArvRw5pNXwKgW0fBquWEU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQs0kODuTuJKjmjOuo1SXMc-q6o1gTbIvFUDNilVfHyzg&oe=6AF07FEF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AVCXR VHM Ingenier\u00eda", "keywords": [], "long_description": "A nivel de plataforma, el sistema se divide en aplicaciones pr\u00e1cticas para cada sector:\nEducaci\u00f3n: Entrenamiento interactivo de procesos industriales y laboratorios virtuales para llevar la pr\u00e1ctica al campo.\nSalud: Simuladores m\u00e9dicos interactivos que permiten practicar con equipos reales, como el uso del desfibrilador donde el usuario puede interactuar directamente con el equipo al \"agarrar las paletas\" y \"cargar\"\n, adem\u00e1s de incluir la toma de tensi\u00f3n. Tambi\u00e9n ofrece un espacio de realidad virtual para dise\u00f1ar y dotar espacios cl\u00ednicos a escala 1:1, evitando sobrecostos en la construcci\u00f3n.\nIndustria: Capacitaciones de mantenimiento en sitio y visualizaciones de renderizado a escala real para la toma de decisiones operativas y directivas.", "short_description": "AVCXR es una plataforma inmersiva de realidad mixta enfocada en revolucionar la capacitaci\u00f3n pr\u00e1ctica en los sectores de Educaci\u00f3n, Salud e Industria.\nEl impacto principal del proyecto es la democratizaci\u00f3n y descentralizaci\u00f3n del aprendizaje: mediante el uso de laboratorios remotos y m\u00f3dulos did\u00e1cticos inmersivos, AVCXR lleva oportunidades de educaci\u00f3n superior y entrenamiento en procesos industriales directamente a zonas rurales y comunidades vulnerables de dif\u00edcil acceso"}, {"images": {"nodes": [{"file_name": "AVCXR_MetaQuest.png", "id": "26575577285407797", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618284_26575577292074463_8179618092863187677_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JCDS4HLYGbYQ7kNvwG_efIw&_nc_oc=AdqUtAkEgtui1afqYx75jBzAVmd5g5G-VLN6Cpwv-XZQBDcrCCVO3nfLwnKGLHa63rg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdZGKCFN6btHDFLA5sXEWwbYfSCH2qpe7tZWG7X_XKUg&oe=6AF09C1E"}, {"file_name": "AVCXR_MetaQuest.png", "id": "3056063914782038", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499617850_3056063918115371_2202158384151631148_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jKlaoNCpTQYQ7kNvwHWN181&_nc_oc=AdoGRcWXjasUitDfgSH6ZFtnkJdWQU1TiHbCHinSoiyHH-RBdJ9a--20Hyd2lIC4aRU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6RMNRZx7g6rbXdNGMoEZb7pMZPG9TXNiVzwFz769HBw&oe=6AF0AC0F"}, {"file_name": "AVCXR_MetaQuest_portrait.png", "id": "2473565366496707", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499296057_2473565369830040_7720233636311648977_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sX01qm7nQ4IQ7kNvwFW2mFv&_nc_oc=Adq9m01Ru-dR5hn-xjNLcuFj1OXQIQ5LDJwg7AlOPKg9D_U2rvUF83vrScAbvaaq500&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscd
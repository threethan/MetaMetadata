aB3LPx5mcQ7kNvwFdUKW3&_nc_oc=AdqkZKMEf8X_7hD_NXXm8v7_cvgD8bplrwQOokCZ-i98wFLTwZMMGnamo6zRqsuMUY4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7v-jZdFqcK2COXuuZ-EIs1QRiKj1Z3ze8QcW1nniLZw&oe=6AAAB195"}, {"file_name": "Arquitecture.png", "id": "1553351126576627", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619668_1553351129909960_629592202932966666_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j0FFMw7hOYYQ7kNvwFi4XIK&_nc_oc=Adrv2qEpI2XwOxJhHMRwZ4rGs-ic97lqn3Bzn2fGJxW-uDulaIj1aA-XGtPtxOAUkuc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJBus22JqVEzNHcA2VGq0uXEm13ebPJEQLP-cxG-pd9PA&oe=6AAA8F65"}, {"file_name": "Tensiometro.png", "id": "36251387067840171", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623295_36251387111173500_6293926571928592602_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dUyEwn4yRbYQ7kNvwFykboP&_nc_oc=AdqE0SqroxcqZKhHxF1vYouxQUbZ9ppwdaQk7EcZ7WT01Aa_YStvgM0orsoqZoc9rgo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8UunwCgqRMxUwawbo_ptEgHcSOjPUfMG7scOW1O6CiQ&oe=6AAAA06F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AVCXR VHM Ingenier\u00eda", "keywords": [], "long_description": "A nivel de plataforma, el sistema se divide en aplicaciones pr\u00e1cticas para cada sector:\nEducaci\u00f3n: Entrenamiento interactivo de procesos industriales y laboratorios virtuales para llevar la pr\u00e1ctica al campo.\nSalud: Simuladores m\u00e9dicos interactivos que permiten practicar con equipos reales, como el uso del desfibrilador donde el usuario puede interactuar directamente con el equipo al \"agarrar las paletas\" y \"cargar\"\n, adem\u00e1s de incluir la toma de tensi\u00f3n. Tambi\u00e9n ofrece un espacio de realidad virtual para dise\u00f1ar y dotar espacios cl\u00ednicos a escala 1:1, evitando sobrecostos en la construcci\u00f3n.\nIndustria: Capacitaciones de mantenimiento en sitio y visualizaciones de renderizado a escala real para la toma de decisiones operativas y directivas.", "short_description": "AVCXR es una plataforma inmersiva de realidad mixta enfocada en revolucionar la capacitaci\u00f3n pr\u00e1ctica en los sectores de Educaci\u00f3n, Salud e Industria.\nEl impacto principal del proyecto es la democratizaci\u00f3n y descentralizaci\u00f3n del aprendizaje: mediante el uso de laboratorios remotos y m\u00f3dulos did\u00e1cticos inmersivos, AVCXR lleva oportunidades de educaci\u00f3n superior y entrenamiento en procesos industriales directamente a zonas rurales y comunidades vulnerables de dif\u00edcil acceso"}, {"images": {"nodes": [{"file_name": "AVCXR_MetaQuest.png", "id": "26575577285407797", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618284_26575577292074463_8179618092863187677_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Hw6HWsZtyQQ7kNvwHzHTO2&_nc_oc=AdrYlegh4OEfz8sfvt6DpWhcMLibiL1Jwh4GtBip1Y3L9bTHV7oBepDFOjIQrxI0iuQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIffIO-VPdZNtn3aFcZwMMi91EKygq_K5OwVts4g5eIXg&oe=6AAABC9E"}, {"file_name": "AVCXR_MetaQuest.png", "id": "3056063914782038", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617850_3056063918115371_2202158384151631148_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yI2Atg97gt4Q7kNvwGEKPpb&_nc_oc=Adop-NfiJ-SKTbhGZ6k8u-bWjwIgunRzFVhzzZOsCP9dymB7VBgdZswLyqq44ExHX_Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-knAM_RRYbzZYUomKC-nnEXi7ICJg2g-pqQBN-iBgpQ&oe=6AAA944F"}, {"file_name": "AVCXR_MetaQuest_portrait.png", "id": "2473565366496707", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499296057_2473565369830040_7720233636311648977_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cceYHjzQCVEQ7kNvwGwWpsV&_nc_oc=AdpggLPsf5aWRcXC6TWUAYdJP3jeyWelZ9nhyKzECgUXR3Nt5Ug2pfbyf8p462j8E0E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscd
l1piAjTJsQ7kNvwEOxpWE&_nc_oc=AdqiTgwKE4O2muVW4zSubZlO1jdFa52xorTAeZcccDkcpDO6GV-XfCEl4QwYAW9_wn0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQElhe1oILgcsym8TzWQmihmCHRkXwNVBQo5c3sjijqAhQ&oe=6A79B1D5"}, {"file_name": "Arquitecture.png", "id": "1553351126576627", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619668_1553351129909960_629592202932966666_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IgKuSkf7z-YQ7kNvwEIpEcc&_nc_oc=AdqWxXRNQOk-QYIFi8sQwus9v-qlYmkcgwA38_Q-AcRQbyAXLI6FogHW4R2QsgIlVW0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-T41NhCfw_xiu-I8dPTcwo9H_l8Ld7evIXqkQ6G97wg&oe=6A79C7E5"}, {"file_name": "Tensiometro.png", "id": "36251387067840171", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623295_36251387111173500_6293926571928592602_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f22f2xUo4N4Q7kNvwFgjSj2&_nc_oc=AdpoRc51XnpK3jdc8_MSFh1PATg2Z1zpKAN1CrcPUBJ_Qla7ZPFJCVLDYDmD2LbxuOI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGTuLUU7LaWOxTdha4ZPTt1fY_VZL2JO1XC7rM0mmy0KQ&oe=6A79D8EF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AVCXR VHM Ingenier\u00eda", "keywords": [], "long_description": "A nivel de plataforma, el sistema se divide en aplicaciones pr\u00e1cticas para cada sector:\nEducaci\u00f3n: Entrenamiento interactivo de procesos industriales y laboratorios virtuales para llevar la pr\u00e1ctica al campo.\nSalud: Simuladores m\u00e9dicos interactivos que permiten practicar con equipos reales, como el uso del desfibrilador donde el usuario puede interactuar directamente con el equipo al \"agarrar las paletas\" y \"cargar\"\n, adem\u00e1s de incluir la toma de tensi\u00f3n. Tambi\u00e9n ofrece un espacio de realidad virtual para dise\u00f1ar y dotar espacios cl\u00ednicos a escala 1:1, evitando sobrecostos en la construcci\u00f3n.\nIndustria: Capacitaciones de mantenimiento en sitio y visualizaciones de renderizado a escala real para la toma de decisiones operativas y directivas.", "short_description": "AVCXR es una plataforma inmersiva de realidad mixta enfocada en revolucionar la capacitaci\u00f3n pr\u00e1ctica en los sectores de Educaci\u00f3n, Salud e Industria.\nEl impacto principal del proyecto es la democratizaci\u00f3n y descentralizaci\u00f3n del aprendizaje: mediante el uso de laboratorios remotos y m\u00f3dulos did\u00e1cticos inmersivos, AVCXR lleva oportunidades de educaci\u00f3n superior y entrenamiento en procesos industriales directamente a zonas rurales y comunidades vulnerables de dif\u00edcil acceso"}, {"images": {"nodes": [{"file_name": "AVCXR_MetaQuest.png", "id": "26575577285407797", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618284_26575577292074463_8179618092863187677_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_rBJx0XqivcQ7kNvwHbDna8&_nc_oc=Adot2vky1UYdwHMFrYpzecbbUF5faHrcjAaEulmBsDri-IBD6BBnSIJwVuy8GRlNAk0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHbCHPB3v7ezgANCthbVcizsy_BmolqUj1YDV9ZUGeP9Q&oe=6A79BCDE"}, {"file_name": "AVCXR_MetaQuest.png", "id": "3056063914782038", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617850_3056063918115371_2202158384151631148_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_tuPluTeWw0Q7kNvwFHqGqJ&_nc_oc=AdpJJp9myeaEXHZdoeJj1rVbTo7rCeY0AjAcF_3htxV6L8_5_rzfhgEIIX8-4UELyr4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFsZ8qZw8Z8xKKTFaZySOhyVR1Z9XiSeG9vvRadEJ1jHA&oe=6A79CCCF"}, {"file_name": "AVCXR_MetaQuest_portrait.png", "id": "2473565366496707", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499296057_2473565369830040_7720233636311648977_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2jene3mMs8QQ7kNvwFQfalu&_nc_oc=Adqk1uhoNbvjzVl1udnBNQXLiI_zM7J__2ntJ7HoscXYnqb23qSWVLUMFpjUPvsD_sI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscd
9vISjO4rwQ7kNvwGkarNr&_nc_oc=AdqG0d-SiLDP9MiI2qDoKro9IB73PxiHwiTVMg7UxE68UYkKJkQXX0N_KCJjF-SR_LY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNXS46dDxc94LVev7ocoCDV0RkOSdDNHRcQiER0Wjpq1w&oe=6AE36215"}, {"file_name": "Arquitecture.png", "id": "1553351126576627", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499619668_1553351129909960_629592202932966666_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ovPIZOw9FtQQ7kNvwE2fZfu&_nc_oc=AdqHeiVDsDck8adPfQUOPHybcJtp3ljlHhUJh3Pw-uPse9ZQfRhWnqfpoQMJe0QCoSs&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQORx7HosVCHsNOpbK51TAhMcE7F6pMGOQr732zu8RqAzw&oe=6AE33FE5"}, {"file_name": "Tensiometro.png", "id": "36251387067840171", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499623295_36251387111173500_6293926571928592602_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XONaMPgtS1AQ7kNvwFyo-0y&_nc_oc=Ado7Ha8VWaDOWZIBA-XxhuIfYCddnOssa7dGDLfgG1JAg3SxNZ-joEltlbL8bSOQ_oU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNXZReHaDkH5iRySPhpen5anEl_xOqZwAhM_GJ7XDpUCQ&oe=6AE350EF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AVCXR VHM Ingenier\u00eda", "keywords": [], "long_description": "A nivel de plataforma, el sistema se divide en aplicaciones pr\u00e1cticas para cada sector:\nEducaci\u00f3n: Entrenamiento interactivo de procesos industriales y laboratorios virtuales para llevar la pr\u00e1ctica al campo.\nSalud: Simuladores m\u00e9dicos interactivos que permiten practicar con equipos reales, como el uso del desfibrilador donde el usuario puede interactuar directamente con el equipo al \"agarrar las paletas\" y \"cargar\"\n, adem\u00e1s de incluir la toma de tensi\u00f3n. Tambi\u00e9n ofrece un espacio de realidad virtual para dise\u00f1ar y dotar espacios cl\u00ednicos a escala 1:1, evitando sobrecostos en la construcci\u00f3n.\nIndustria: Capacitaciones de mantenimiento en sitio y visualizaciones de renderizado a escala real para la toma de decisiones operativas y directivas.", "short_description": "AVCXR es una plataforma inmersiva de realidad mixta enfocada en revolucionar la capacitaci\u00f3n pr\u00e1ctica en los sectores de Educaci\u00f3n, Salud e Industria.\nEl impacto principal del proyecto es la democratizaci\u00f3n y descentralizaci\u00f3n del aprendizaje: mediante el uso de laboratorios remotos y m\u00f3dulos did\u00e1cticos inmersivos, AVCXR lleva oportunidades de educaci\u00f3n superior y entrenamiento en procesos industriales directamente a zonas rurales y comunidades vulnerables de dif\u00edcil acceso"}, {"images": {"nodes": [{"file_name": "AVCXR_MetaQuest.png", "id": "26575577285407797", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499618284_26575577292074463_8179618092863187677_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dB4qV13GRKwQ7kNvwEIEML4&_nc_oc=Ado8B3aZfCn9Kta5V76hfMA_HCeiXU3qCLeXbDkMfKiC9_0d_HwM5BvXCoumKoTfYH8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO02Zq_Ky8rFjypVLzDLiT4W0SH-d5br-jgk23WnKwDLg&oe=6AE36D1E"}, {"file_name": "AVCXR_MetaQuest.png", "id": "3056063914782038", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499617850_3056063918115371_2202158384151631148_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8UgNzo9ZOMwQ7kNvwEavmDy&_nc_oc=AdqdKJMBKywbWytFEoZZp9Smle0dXoB0KEQIV5nh7Yg6hkcHLgU_NIC93clnY8B42yE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNk4qrFR6UmqdHT7kOziLyt4xjP0pS_tzG4itWZy_WcUA&oe=6AE344CF"}, {"file_name": "AVCXR_MetaQuest_portrait.png", "id": "2473565366496707", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499296057_2473565369830040_7720233636311648977_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zk5PsJgXyeUQ7kNvwF1v_Dn&_nc_oc=AdoGS9WDc_uvnVcgcbrJh-fqfkOEgxGpDDfjBY7o8eSe7q4mFEYU7o64yWBALLxNR90&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscd
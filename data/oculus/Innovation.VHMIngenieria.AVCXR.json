xMCKM8FDoQ7kNvwFP4P49&_nc_oc=Adr-dXl1zwmH1Np93qvRQi_4VyMTPrhOdd5uVWSW8Qnriw7P5zKAezfc0-q745DKSEs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLMX-0C8I5ZK2DFRZm78oox8950Yz_vjmMI4rts2kJAvA&oe=6AA6BD15"}, {"file_name": "Arquitecture.png", "id": "1553351126576627", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619668_1553351129909960_629592202932966666_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=63c9d5BCa8oQ7kNvwGBXyyV&_nc_oc=Adr1mcgnE5Ay4kYorDGlfKCJg80pYxunzeSm8qeuK7seMoqtJlAFWm4s3Dpjd73qkzs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQdwqtSjRdCm5yiBoJlO0TSMwmBEkK5XGJUfblLougrg&oe=6AA69AE5"}, {"file_name": "Tensiometro.png", "id": "36251387067840171", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623295_36251387111173500_6293926571928592602_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QIgfMqxg_BUQ7kNvwECypCI&_nc_oc=AdrigwvIjck_Yln04LP1gZWSQWMgLQe5m2bn0qqNFZEBiNCVZTGj07nKnGb3tJjqWTE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjzSQdZOOkzpeYj6BDWFNQK58zOF94mTFStTGbgdgpHQ&oe=6AA6ABEF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AVCXR VHM Ingenier\u00eda", "keywords": [], "long_description": "A nivel de plataforma, el sistema se divide en aplicaciones pr\u00e1cticas para cada sector:\nEducaci\u00f3n: Entrenamiento interactivo de procesos industriales y laboratorios virtuales para llevar la pr\u00e1ctica al campo.\nSalud: Simuladores m\u00e9dicos interactivos que permiten practicar con equipos reales, como el uso del desfibrilador donde el usuario puede interactuar directamente con el equipo al \"agarrar las paletas\" y \"cargar\"\n, adem\u00e1s de incluir la toma de tensi\u00f3n. Tambi\u00e9n ofrece un espacio de realidad virtual para dise\u00f1ar y dotar espacios cl\u00ednicos a escala 1:1, evitando sobrecostos en la construcci\u00f3n.\nIndustria: Capacitaciones de mantenimiento en sitio y visualizaciones de renderizado a escala real para la toma de decisiones operativas y directivas.", "short_description": "AVCXR es una plataforma inmersiva de realidad mixta enfocada en revolucionar la capacitaci\u00f3n pr\u00e1ctica en los sectores de Educaci\u00f3n, Salud e Industria.\nEl impacto principal del proyecto es la democratizaci\u00f3n y descentralizaci\u00f3n del aprendizaje: mediante el uso de laboratorios remotos y m\u00f3dulos did\u00e1cticos inmersivos, AVCXR lleva oportunidades de educaci\u00f3n superior y entrenamiento en procesos industriales directamente a zonas rurales y comunidades vulnerables de dif\u00edcil acceso"}, {"images": {"nodes": [{"file_name": "AVCXR_MetaQuest.png", "id": "26575577285407797", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618284_26575577292074463_8179618092863187677_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2hRveuWbmZMQ7kNvwGu2Fb7&_nc_oc=AdqZ0kYEv7zak-uPPng7M3eXWaB5cFVf7hO-9y71xMy8lL8WD3Yph52f-4zrdwHhRg8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIAS8JEtYlJq3fbhJtht-rSCpAeemKK62yZUYbDJSb0zw&oe=6AA6C81E"}, {"file_name": "AVCXR_MetaQuest.png", "id": "3056063914782038", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617850_3056063918115371_2202158384151631148_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ViiqMJ42YYQ7kNvwF-vrc6&_nc_oc=AdqZtXhdtmwitDkLMUuCAt91g9z2ePatHh7vVVtOeO9v8ZW6eLuZ5Im0xpR5uCU_xMM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIu3VpNSd_OzfpL9LpbwNCN1_BbDw784g55Ot3aaDpzCw&oe=6AA69FCF"}, {"file_name": "AVCXR_MetaQuest_portrait.png", "id": "2473565366496707", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499296057_2473565369830040_7720233636311648977_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wDKHRue4LhQQ7kNvwEvSziY&_nc_oc=AdoksOAtZd357emNjd7Bc8pCzXqiGwN9iZt7fSVrJnUB8nIlsyc4Z0OST-sEGuBquhE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscd
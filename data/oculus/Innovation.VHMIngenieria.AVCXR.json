3nYoMGYu0Q7kNvwFYRfnI&_nc_oc=Adp7n1L2Tj2Q2C3Cfv0NfCbl6O0EhprbAw_GD31bjSliM-D4rSHaM9h9yvRsBH9nI0U&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI8o1MmZX9RqGVuLnDsY9TqYSCMYH5aquTuoezkte7zsw&oe=6AA02595"}, {"file_name": "Arquitecture.png", "id": "1553351126576627", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499619668_1553351129909960_629592202932966666_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GWJAUZGfUu0Q7kNvwFWONGi&_nc_oc=AdobVSkfNngaXm2QARejI7XILaFevTCsJrY7D4i7_Ocj-f-UjDtT-9aSP9mGoGm3o48&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIIlCNGaeTfeA_-RjPtvJ5Y9M1LQenykT0uvrAB0EqlIA&oe=6AA00365"}, {"file_name": "Tensiometro.png", "id": "36251387067840171", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499623295_36251387111173500_6293926571928592602_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=325BaQH6lmoQ7kNvwGn05oF&_nc_oc=Adp5PI9KgcOHIfVWfcO-Nqza-u-gAuiLy2TTd_TfdFucQnB3QZIiBn-nBWvXGbm-k64&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0I7c6Gv8ifw41vumZPXwJqPhv7_072Ota_cWyv_CZzA&oe=6AA0146F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AVCXR VHM Ingenier\u00eda", "keywords": [], "long_description": "A nivel de plataforma, el sistema se divide en aplicaciones pr\u00e1cticas para cada sector:\nEducaci\u00f3n: Entrenamiento interactivo de procesos industriales y laboratorios virtuales para llevar la pr\u00e1ctica al campo.\nSalud: Simuladores m\u00e9dicos interactivos que permiten practicar con equipos reales, como el uso del desfibrilador donde el usuario puede interactuar directamente con el equipo al \"agarrar las paletas\" y \"cargar\"\n, adem\u00e1s de incluir la toma de tensi\u00f3n. Tambi\u00e9n ofrece un espacio de realidad virtual para dise\u00f1ar y dotar espacios cl\u00ednicos a escala 1:1, evitando sobrecostos en la construcci\u00f3n.\nIndustria: Capacitaciones de mantenimiento en sitio y visualizaciones de renderizado a escala real para la toma de decisiones operativas y directivas.", "short_description": "AVCXR es una plataforma inmersiva de realidad mixta enfocada en revolucionar la capacitaci\u00f3n pr\u00e1ctica en los sectores de Educaci\u00f3n, Salud e Industria.\nEl impacto principal del proyecto es la democratizaci\u00f3n y descentralizaci\u00f3n del aprendizaje: mediante el uso de laboratorios remotos y m\u00f3dulos did\u00e1cticos inmersivos, AVCXR lleva oportunidades de educaci\u00f3n superior y entrenamiento en procesos industriales directamente a zonas rurales y comunidades vulnerables de dif\u00edcil acceso"}, {"images": {"nodes": [{"file_name": "AVCXR_MetaQuest.png", "id": "26575577285407797", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499618284_26575577292074463_8179618092863187677_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kLt0uJ_1bDUQ7kNvwEkoaj1&_nc_oc=Adp3xVhrrWYus-wAZrvBH1_4aa1g_A93HX7Nr9ZYSoZpkcraNuiRqKPGOhVNzQ3Ow6Q&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIM5HWFmz9_BmUsu9umS2-z4rlZWByQ5MeT0JIlUuuYHg&oe=6A9FF85E"}, {"file_name": "AVCXR_MetaQuest.png", "id": "3056063914782038", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499617850_3056063918115371_2202158384151631148_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e0RzwiZLauAQ7kNvwFgTDpQ&_nc_oc=AdrWn6YZgI8q4nKS0Ol82enS7l0txXMAwr_Dr4Op1OCcOXLwq5kd52jSjTz0xNnpCpg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGEkcjFgPlO8TC7rh7BxvdSG-UhsX8umVRGRI39ekY7Q&oe=6AA0084F"}, {"file_name": "AVCXR_MetaQuest_portrait.png", "id": "2473565366496707", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499296057_2473565369830040_7720233636311648977_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j9sLdOqSxRAQ7kNvwH3c08R&_nc_oc=Adqkv4E-l94NUC1Ot0ADbqqr8Ou6v--l-VMQOBjrx9szY4TCy6SEM_JszuC5D9p8Zaw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscd
Yjbm23elUQ7kNvwGUW3_J&_nc_oc=Ado8k382UeT3mDN4fvFMM5XRdg59SBcgztj3kNj2DnArpPxY_eW4QAVaYA-uyErrbEc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZTWpCHwDO-jOVoPsoNXoD4AT8xVDWsMwV5sxILYzPVw&oe=6ACE4A15"}, {"file_name": "Arquitecture.png", "id": "1553351126576627", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619668_1553351129909960_629592202932966666_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gb3ywPT4XIMQ7kNvwHbtLoY&_nc_oc=Adpp6zYZ_8fOqkQULAa3QJAW4ZEXlhTAF71veAEmpcL3BaQ1MgDxdrzaVpYbEY8kSvU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPaRDFTTgLutmyZxjFcMbSPNYd6Cv7UXW_ciRHGqF7Qxw&oe=6ACE6025"}, {"file_name": "Tensiometro.png", "id": "36251387067840171", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623295_36251387111173500_6293926571928592602_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Ew5v3sR67YQ7kNvwFUXw22&_nc_oc=AdqN5OG8Uo3ToMzlkkysrXr9hNrAZfY3T_rW9wVqlll-eq7FUhdfjUxXBmO5gRK-ugc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOM7ae4W0eZSl2_1jTWSrvL73xpZItTGvfytUTCDxRz_A&oe=6ACE38EF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AVCXR VHM Ingenier\u00eda", "keywords": [], "long_description": "A nivel de plataforma, el sistema se divide en aplicaciones pr\u00e1cticas para cada sector:\nEducaci\u00f3n: Entrenamiento interactivo de procesos industriales y laboratorios virtuales para llevar la pr\u00e1ctica al campo.\nSalud: Simuladores m\u00e9dicos interactivos que permiten practicar con equipos reales, como el uso del desfibrilador donde el usuario puede interactuar directamente con el equipo al \"agarrar las paletas\" y \"cargar\"\n, adem\u00e1s de incluir la toma de tensi\u00f3n. Tambi\u00e9n ofrece un espacio de realidad virtual para dise\u00f1ar y dotar espacios cl\u00ednicos a escala 1:1, evitando sobrecostos en la construcci\u00f3n.\nIndustria: Capacitaciones de mantenimiento en sitio y visualizaciones de renderizado a escala real para la toma de decisiones operativas y directivas.", "short_description": "AVCXR es una plataforma inmersiva de realidad mixta enfocada en revolucionar la capacitaci\u00f3n pr\u00e1ctica en los sectores de Educaci\u00f3n, Salud e Industria.\nEl impacto principal del proyecto es la democratizaci\u00f3n y descentralizaci\u00f3n del aprendizaje: mediante el uso de laboratorios remotos y m\u00f3dulos did\u00e1cticos inmersivos, AVCXR lleva oportunidades de educaci\u00f3n superior y entrenamiento en procesos industriales directamente a zonas rurales y comunidades vulnerables de dif\u00edcil acceso"}, {"images": {"nodes": [{"file_name": "AVCXR_MetaQuest.png", "id": "26575577285407797", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618284_26575577292074463_8179618092863187677_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BOVRIYGQ12AQ7kNvwFjiXOv&_nc_oc=AdoG6tHdVu-QzbIzdGWUPepMTsYw_QyRDnCuhWc4VnQKEb9ONePeZTXlnB9gq4FG2x8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_hnppw3PZD89nY1eykZRBtJJrgcxgygxoAP8IEZE5yg&oe=6ACE551E"}, {"file_name": "AVCXR_MetaQuest.png", "id": "3056063914782038", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617850_3056063918115371_2202158384151631148_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MxpMVM9pKT8Q7kNvwECoFqE&_nc_oc=Adq3EG2WtyjqEpdRUsj5BZOnm51d6iwlJxzlDvtgYbK142GALnMcRbbxfcLh_tY3P1Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNiKFkAsySOnM4vlszY-XC67pzf52pssCH6ncfsbm9SVQ&oe=6ACE650F"}, {"file_name": "AVCXR_MetaQuest_portrait.png", "id": "2473565366496707", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499296057_2473565369830040_7720233636311648977_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=71PbIO5qykcQ7kNvwE7J-I3&_nc_oc=AdoR4B9t40BiIOMJczhCI_g-ZOU4P9z_OjLlCpfUm7rDug5bmR4CHqi4bEHqBtWVxTw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscd
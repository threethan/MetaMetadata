6jI8ipMfEQ7kNvwEEYXfI&_nc_oc=AdrxgCTrkshClrIjNvrDSxR00YaPfBrdiTHENCTnUkod9kM1dLy52T_S2cZSf6hAqt8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-zdF9KigEYve5j8MDc46Rkxq3Z3GC3Ye-IbgU54QV5aw&oe=6A3E9695"}, {"file_name": "Arquitecture.png", "id": "1553351126576627", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619668_1553351129909960_629592202932966666_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uFwjMnG8vjoQ7kNvwGVTYZP&_nc_oc=Ado4apaTkvJyzBH0Q-KIYROzBPXKg49w03wAnd8azfNOyAr-xMHIvkhHAwTxpyFGV1M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ERlTs05OSn0FBWR2altudMo_s50q0tW2PEuINY9qJLQ&oe=6A3EACA5"}, {"file_name": "Tensiometro.png", "id": "36251387067840171", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499623295_36251387111173500_6293926571928592602_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CgUbg1gs0MIQ7kNvwHX-SRn&_nc_oc=AdqpV8iRXCE_HYsbebBxD1vQu_vZbekE74do-ZWHfPsIq5zRTNPZfLaR5D4A-0WTCxE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-egxZeHOepHqq0ftpEf6cThuRbLlGZzRq81v6ftLJKRA&oe=6A3E856F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AVCXR VHM Ingenier\u00eda", "keywords": [], "long_description": "A nivel de plataforma, el sistema se divide en aplicaciones pr\u00e1cticas para cada sector:\nEducaci\u00f3n: Entrenamiento interactivo de procesos industriales y laboratorios virtuales para llevar la pr\u00e1ctica al campo.\nSalud: Simuladores m\u00e9dicos interactivos que permiten practicar con equipos reales, como el uso del desfibrilador donde el usuario puede interactuar directamente con el equipo al \"agarrar las paletas\" y \"cargar\"\n, adem\u00e1s de incluir la toma de tensi\u00f3n. Tambi\u00e9n ofrece un espacio de realidad virtual para dise\u00f1ar y dotar espacios cl\u00ednicos a escala 1:1, evitando sobrecostos en la construcci\u00f3n.\nIndustria: Capacitaciones de mantenimiento en sitio y visualizaciones de renderizado a escala real para la toma de decisiones operativas y directivas.", "short_description": "AVCXR es una plataforma inmersiva de realidad mixta enfocada en revolucionar la capacitaci\u00f3n pr\u00e1ctica en los sectores de Educaci\u00f3n, Salud e Industria.\nEl impacto principal del proyecto es la democratizaci\u00f3n y descentralizaci\u00f3n del aprendizaje: mediante el uso de laboratorios remotos y m\u00f3dulos did\u00e1cticos inmersivos, AVCXR lleva oportunidades de educaci\u00f3n superior y entrenamiento en procesos industriales directamente a zonas rurales y comunidades vulnerables de dif\u00edcil acceso"}, {"images": {"nodes": [{"file_name": "AVCXR_MetaQuest.png", "id": "26575577285407797", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618284_26575577292074463_8179618092863187677_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H9hbghpGhqsQ7kNvwHyLRQ3&_nc_oc=AdryXHElePKjxnwzsU4DAjVMSmZHThLETeVMuTpGAhaHrehGXGWRce5izPekIvGWN74&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_uXsSl-qd9q2Rofg9zr5bleo_OxL5Jxrzkl0SeATf6JA&oe=6A3EA19E"}, {"file_name": "AVCXR_MetaQuest.png", "id": "3056063914782038", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617850_3056063918115371_2202158384151631148_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YRm09jTmCecQ7kNvwHFozB6&_nc_oc=AdpUBkM3psfLv-xO8MamiFbGLl8uvx3dGeVwANdpxSa_6w6KHj5GQe20JI0_I6jg13I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9eZN_mElBeJOqyKtvAatN2nffmE-5QUbNKtfMpo5rayA&oe=6A3E794F"}, {"file_name": "AVCXR_MetaQuest_portrait.png", "id": "2473565366496707", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499296057_2473565369830040_7720233636311648977_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mSH29pXeneAQ7kNvwHJoePB&_nc_oc=AdpzC59J0vrTGWhvT6SQYvf2hQv_n39qXoT8tyW9-UamgCclR7JDB8uK8tiyIzVDM8k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscd
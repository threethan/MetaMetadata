2C5PRyQ58Q7kNvwEKpRXI&_nc_oc=AdpF4dc683DUAunmAgvGeLRyYAi9q3RkxHFtemxL0ijYbjm_DjusWlNIAPWBa_xk20s&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBrj43h3GiXw2-FqqQWc3xLZ-Mlx_UM8bKY5n4tnCr1iA&oe=6A68C695"}, {"file_name": "Arquitecture.png", "id": "1553351126576627", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619668_1553351129909960_629592202932966666_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KYv6f_9hqQMQ7kNvwEqYmDn&_nc_oc=AdoZ2CUWfqiIADwVYM9gsJ377IXMdQGRjLP_6hlKyUKhXw6DZTUjRh_MbJyhqD3M2-0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAB_YhfwnsQxT9c-edLx6EIcNiuI3QdUPfBDmT5DXtVYg&oe=6A68A465"}, {"file_name": "Tensiometro.png", "id": "36251387067840171", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623295_36251387111173500_6293926571928592602_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W-8zEj-BLDUQ7kNvwHvhHPB&_nc_oc=AdoptYjssti5i3go-HDTylOX8-BzJBI0qDC8vQtxi9l5ueS2URC8BD_hHAOmnB5lnZg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCeblYLJQDXq_z3tZoIsJTDCPAstFPLlH3TROdl3ffSpQ&oe=6A68B56F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AVCXR VHM Ingenier\u00eda", "keywords": [], "long_description": "A nivel de plataforma, el sistema se divide en aplicaciones pr\u00e1cticas para cada sector:\nEducaci\u00f3n: Entrenamiento interactivo de procesos industriales y laboratorios virtuales para llevar la pr\u00e1ctica al campo.\nSalud: Simuladores m\u00e9dicos interactivos que permiten practicar con equipos reales, como el uso del desfibrilador donde el usuario puede interactuar directamente con el equipo al \"agarrar las paletas\" y \"cargar\"\n, adem\u00e1s de incluir la toma de tensi\u00f3n. Tambi\u00e9n ofrece un espacio de realidad virtual para dise\u00f1ar y dotar espacios cl\u00ednicos a escala 1:1, evitando sobrecostos en la construcci\u00f3n.\nIndustria: Capacitaciones de mantenimiento en sitio y visualizaciones de renderizado a escala real para la toma de decisiones operativas y directivas.", "short_description": "AVCXR es una plataforma inmersiva de realidad mixta enfocada en revolucionar la capacitaci\u00f3n pr\u00e1ctica en los sectores de Educaci\u00f3n, Salud e Industria.\nEl impacto principal del proyecto es la democratizaci\u00f3n y descentralizaci\u00f3n del aprendizaje: mediante el uso de laboratorios remotos y m\u00f3dulos did\u00e1cticos inmersivos, AVCXR lleva oportunidades de educaci\u00f3n superior y entrenamiento en procesos industriales directamente a zonas rurales y comunidades vulnerables de dif\u00edcil acceso"}, {"images": {"nodes": [{"file_name": "AVCXR_MetaQuest.png", "id": "26575577285407797", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499618284_26575577292074463_8179618092863187677_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G_SztzOoXsYQ7kNvwEHdfEx&_nc_oc=AdoiVKd9DKZJ5OuYV2_DHpI_FPIGBald5HPpelbUd8yOXQZok4y4iZHOYBbnZy8U5Eo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBfkDLc6sVyYaK10byo0Ep1WakXvo4_SaUUrGq20p8z1A&oe=6A68995E"}, {"file_name": "AVCXR_MetaQuest.png", "id": "3056063914782038", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499617850_3056063918115371_2202158384151631148_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9zJzlRJHCOUQ7kNvwFLORhe&_nc_oc=AdpVRSDZusUReuTyHbfxizgK5W4Bsn0CJJwjWxLPhqUo4uZxtZvIY94PgWQ0gW7hg6g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDtMQWeLsjaKjUl5s-bU-DiNKdTDak8xxnxaYwYmgiILw&oe=6A68A94F"}, {"file_name": "AVCXR_MetaQuest_portrait.png", "id": "2473565366496707", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499296057_2473565369830040_7720233636311648977_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X3anI5xs-L8Q7kNvwFKx2tC&_nc_oc=AdoKyB3lKN3ZDqeMElkUCk17vDI-wdj5aJB-SxMzh0m8sMUZZc5DU8SCZKeILqVANI0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscd
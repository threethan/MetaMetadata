yI0Y4RZ4UQ7kNvwEB1-nB&_nc_oc=AdrfrfiIVyVPyb6lZkYr7FlsFbgNpmKotla8ikZglrGTUjT6KWoOCUvz9M38isIFnuk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNaZgQkVw98P31ovFDeBS3wFGaJWs8puoYFqwCH2qcog&oe=6AB7E095"}, {"file_name": "Arquitecture.png", "id": "1553351126576627", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619668_1553351129909960_629592202932966666_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4XiFSEiIa5kQ7kNvwE91d84&_nc_oc=AdqoCs41yZijgwQFzd3CwhWdcKYAbMIiVsFdToip7wU_MkstrCBPj-m1ynojFNtdS34&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvzxC96VefLQdiLUknM6akCZdljVZSjJb4l54wxACB9A&oe=6AB7BE65"}, {"file_name": "Tensiometro.png", "id": "36251387067840171", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623295_36251387111173500_6293926571928592602_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4OZxVMYqmnEQ7kNvwEquZyj&_nc_oc=AdoA0J9-lKRioV8XCbouGLqcqPUGvDQ-j6OfaBh3-_yBSn01veAB4Gl9nDkBacHl8ls&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIe-BqGjTkTdvcqh_S711nCrN1A8t40R2yUT6ARoNh2AQ&oe=6AB7CF6F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AVCXR VHM Ingenier\u00eda", "keywords": [], "long_description": "A nivel de plataforma, el sistema se divide en aplicaciones pr\u00e1cticas para cada sector:\nEducaci\u00f3n: Entrenamiento interactivo de procesos industriales y laboratorios virtuales para llevar la pr\u00e1ctica al campo.\nSalud: Simuladores m\u00e9dicos interactivos que permiten practicar con equipos reales, como el uso del desfibrilador donde el usuario puede interactuar directamente con el equipo al \"agarrar las paletas\" y \"cargar\"\n, adem\u00e1s de incluir la toma de tensi\u00f3n. Tambi\u00e9n ofrece un espacio de realidad virtual para dise\u00f1ar y dotar espacios cl\u00ednicos a escala 1:1, evitando sobrecostos en la construcci\u00f3n.\nIndustria: Capacitaciones de mantenimiento en sitio y visualizaciones de renderizado a escala real para la toma de decisiones operativas y directivas.", "short_description": "AVCXR es una plataforma inmersiva de realidad mixta enfocada en revolucionar la capacitaci\u00f3n pr\u00e1ctica en los sectores de Educaci\u00f3n, Salud e Industria.\nEl impacto principal del proyecto es la democratizaci\u00f3n y descentralizaci\u00f3n del aprendizaje: mediante el uso de laboratorios remotos y m\u00f3dulos did\u00e1cticos inmersivos, AVCXR lleva oportunidades de educaci\u00f3n superior y entrenamiento en procesos industriales directamente a zonas rurales y comunidades vulnerables de dif\u00edcil acceso"}, {"images": {"nodes": [{"file_name": "AVCXR_MetaQuest.png", "id": "26575577285407797", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618284_26575577292074463_8179618092863187677_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b0MAK-P3ttwQ7kNvwFe9Pox&_nc_oc=AdodcX1owfGUWwz3MJrjP3Dr7S7ARWKRqM_19GVRNpb3m0n_NvQO4pueXJX6Cd3U-mo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLpwhePY1z9b26O08oSIglMkILVJjUcJruvHb6K1P3GjA&oe=6AB7EB9E"}, {"file_name": "AVCXR_MetaQuest.png", "id": "3056063914782038", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617850_3056063918115371_2202158384151631148_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zy21H_aIFBkQ7kNvwGwjP0J&_nc_oc=AdqAIRd24UB8QrJuXtKTo7XSl_0FDevyI5hJnndKSdJWE6fOUaovRIcZGRtnj8hnO5Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMW2QS3n4ewcTgExynoCjbjaoqaKxcxCmrdneB5csKcQ&oe=6AB7C34F"}, {"file_name": "AVCXR_MetaQuest_portrait.png", "id": "2473565366496707", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499296057_2473565369830040_7720233636311648977_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a3ThLdfnJeYQ7kNvwF0mvzF&_nc_oc=AdpF_GXqUk4W-Br-kxXRffXO7fuw6BiFOzn7M7Qsa5739ttiaTIngIv9Zj7f7b4gc_w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscd
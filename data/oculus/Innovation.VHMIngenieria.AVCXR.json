z3KXAjrpUQ7kNvwEfGHUF&_nc_oc=Adp5MGOLP8AD9zCvWbUh7s_4KJXpXumr2nua51c1NHncggxxjzqVu8GWCYZWPD-84ig&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMX0nZY34fxhC57WpWCx9_QSFs786V1BSPEspzWrGtEyQ&oe=6AD39015"}, {"file_name": "Arquitecture.png", "id": "1553351126576627", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499619668_1553351129909960_629592202932966666_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nUrjKjqoH1EQ7kNvwHFXGyQ&_nc_oc=AdqUoMjq5Mvt_L9jURrZtUfyD15yzCM43Ctnj1SgkqKUZhxGDsPovcGbUdmcQL3Fa_0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMQ69tz8FzOzeXENSuitn6Qb51vO83skY1AucCxXxH6Ng&oe=6AD3A625"}, {"file_name": "Tensiometro.png", "id": "36251387067840171", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499623295_36251387111173500_6293926571928592602_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bx2fkpx4mOQQ7kNvwHX9bb1&_nc_oc=Adqf9w9uJr4X7y9VS9S7QtkZyYAoSQw42Xb8mXELOpZQpZEAaC0I1RrFhG-Xd2GQugs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4XhPkIenXV-hODAXD3W9NAC8a_R_9f9nlnOV9M27ZXA&oe=6AD3B72F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AVCXR VHM Ingenier\u00eda", "keywords": [], "long_description": "A nivel de plataforma, el sistema se divide en aplicaciones pr\u00e1cticas para cada sector:\nEducaci\u00f3n: Entrenamiento interactivo de procesos industriales y laboratorios virtuales para llevar la pr\u00e1ctica al campo.\nSalud: Simuladores m\u00e9dicos interactivos que permiten practicar con equipos reales, como el uso del desfibrilador donde el usuario puede interactuar directamente con el equipo al \"agarrar las paletas\" y \"cargar\"\n, adem\u00e1s de incluir la toma de tensi\u00f3n. Tambi\u00e9n ofrece un espacio de realidad virtual para dise\u00f1ar y dotar espacios cl\u00ednicos a escala 1:1, evitando sobrecostos en la construcci\u00f3n.\nIndustria: Capacitaciones de mantenimiento en sitio y visualizaciones de renderizado a escala real para la toma de decisiones operativas y directivas.", "short_description": "AVCXR es una plataforma inmersiva de realidad mixta enfocada en revolucionar la capacitaci\u00f3n pr\u00e1ctica en los sectores de Educaci\u00f3n, Salud e Industria.\nEl impacto principal del proyecto es la democratizaci\u00f3n y descentralizaci\u00f3n del aprendizaje: mediante el uso de laboratorios remotos y m\u00f3dulos did\u00e1cticos inmersivos, AVCXR lleva oportunidades de educaci\u00f3n superior y entrenamiento en procesos industriales directamente a zonas rurales y comunidades vulnerables de dif\u00edcil acceso"}, {"images": {"nodes": [{"file_name": "AVCXR_MetaQuest.png", "id": "26575577285407797", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499618284_26575577292074463_8179618092863187677_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2a4Hh1C5syYQ7kNvwFpGlhm&_nc_oc=Ado3_ahXYSvnpnF3adqWmqWgQKK_AB5WiMxSdprZr5_CbcfYAuAJQyku-5qx3fmeRag&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOvhV_uONueOAp38pV7Cj49u0gaP8MHQTk7VQdL3_7CTg&oe=6AD39B1E"}, {"file_name": "AVCXR_MetaQuest.png", "id": "3056063914782038", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499617850_3056063918115371_2202158384151631148_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rZ0v967tInIQ7kNvwGQBphy&_nc_oc=AdpJj4zLvxF-wbTjBwFon2Ymv8sq8NJPa9Y6Qi4s5bBmrepcWnRsX8fs4J__LYEILss&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdV8cCYb8EFWfwVMA5gTLnA9Aci51wxrSpxijreqxcYA&oe=6AD3AB0F"}, {"file_name": "AVCXR_MetaQuest_portrait.png", "id": "2473565366496707", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499296057_2473565369830040_7720233636311648977_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6og8CQOIab4Q7kNvwEHsDPU&_nc_oc=AdroJRVU7StB82m12L0ekrh2lvyjOK2A7YmlohG36GMVCBzQcC_q3mIe5WVX3XMDRIQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscd
yI0Y4RZ4UQ7kNvwGCQuiH&_nc_oc=AdpxTKeSK02n97dpAsY2Nbap3Xl0gjb4cNiqgvsNWRkJkUIyt8BpAvuAm7YWRzkIDwM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2ut9Gsxw6iXLrlJpGO69S02ZJBBxI3_QvCKNy7Wl2gA&oe=6AB53D95"}, {"file_name": "Arquitecture.png", "id": "1553351126576627", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619668_1553351129909960_629592202932966666_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8SPem-HqyrYQ7kNvwGn3EiE&_nc_oc=AdozQhsOqwQ9-hACJNqZeDXqQWreDox_CMXWDiC_kwNwr9036BmcRtWIOrQpOc3lay4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJcPmEfZoJ6VgVV5j8WqWtdKHYSDwC1tSbAdVIYkC91ug&oe=6AB51B65"}, {"file_name": "Tensiometro.png", "id": "36251387067840171", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623295_36251387111173500_6293926571928592602_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4OZxVMYqmnEQ7kNvwHlAJqq&_nc_oc=AdorWyJG80HwORVmox3KJjhePaGUYyPnvQ00rzUo6po1MlYTYSITxGypzG-2Kgiaho0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6eUA38AB51SxLwL8IpfcEEyZuL6x9tHAKE3TU2N9evw&oe=6AB52C6F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AVCXR VHM Ingenier\u00eda", "keywords": [], "long_description": "A nivel de plataforma, el sistema se divide en aplicaciones pr\u00e1cticas para cada sector:\nEducaci\u00f3n: Entrenamiento interactivo de procesos industriales y laboratorios virtuales para llevar la pr\u00e1ctica al campo.\nSalud: Simuladores m\u00e9dicos interactivos que permiten practicar con equipos reales, como el uso del desfibrilador donde el usuario puede interactuar directamente con el equipo al \"agarrar las paletas\" y \"cargar\"\n, adem\u00e1s de incluir la toma de tensi\u00f3n. Tambi\u00e9n ofrece un espacio de realidad virtual para dise\u00f1ar y dotar espacios cl\u00ednicos a escala 1:1, evitando sobrecostos en la construcci\u00f3n.\nIndustria: Capacitaciones de mantenimiento en sitio y visualizaciones de renderizado a escala real para la toma de decisiones operativas y directivas.", "short_description": "AVCXR es una plataforma inmersiva de realidad mixta enfocada en revolucionar la capacitaci\u00f3n pr\u00e1ctica en los sectores de Educaci\u00f3n, Salud e Industria.\nEl impacto principal del proyecto es la democratizaci\u00f3n y descentralizaci\u00f3n del aprendizaje: mediante el uso de laboratorios remotos y m\u00f3dulos did\u00e1cticos inmersivos, AVCXR lleva oportunidades de educaci\u00f3n superior y entrenamiento en procesos industriales directamente a zonas rurales y comunidades vulnerables de dif\u00edcil acceso"}, {"images": {"nodes": [{"file_name": "AVCXR_MetaQuest.png", "id": "26575577285407797", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618284_26575577292074463_8179618092863187677_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-W6XhYGLIxsQ7kNvwEGWYcF&_nc_oc=AdpaYI5QFa1bgye9067g9ebH9LlmI99DjvUSDhMbEh9lC5xcRt0w8rtLqFMNP0YvASY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3b6zUZ79JaxZXOifhTONx09tAmitVh7ipXJdTfFqkYw&oe=6AB5489E"}, {"file_name": "AVCXR_MetaQuest.png", "id": "3056063914782038", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617850_3056063918115371_2202158384151631148_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zy21H_aIFBkQ7kNvwGJRJON&_nc_oc=AdpmOIfN1w4kd4KcghyuogQW2hTiVr9i34kZzg_s5R_Dq3ywyQbmtNw4CjCYaQfbS34&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL3j9B4rfZj3EBcMZaPlZdCcO8CdgLKDQyZMl1Nali6Ng&oe=6AB5204F"}, {"file_name": "AVCXR_MetaQuest_portrait.png", "id": "2473565366496707", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499296057_2473565369830040_7720233636311648977_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BlaBZfGmrfcQ7kNvwHyuvLw&_nc_oc=AdpbCTHV_8Ped4Akvb4rePq_tc6d6MM-BWVNFogRVgAXwxX13OP933yItglzvdjHKo8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscd
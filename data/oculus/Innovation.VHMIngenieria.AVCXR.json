N3Ns3KCe0Q7kNvwGbmWJk&_nc_oc=Ado7VSxtU_L3B5xCn7sdVZr7zZsaecW2WsfkhsECfQ-SF2VnjROq9lFp-ASs8kPDdbo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIakUaRxXdhrHAhw62BoUbMXwoUIFfl4r6VjxGfBebRyw&oe=6ABBD515"}, {"file_name": "Arquitecture.png", "id": "1553351126576627", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619668_1553351129909960_629592202932966666_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xv0ZtMZJ_q0Q7kNvwEyCGHw&_nc_oc=AdrVsUQ2-JC1dJEqGAKaDgS4I-Cd3kojIkxyjvtRj7SQkpGG87TCkBaFhH4AdVyBK7Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_bN1pegDKAGL83RnTGNIhxtv6DSi_OlTPQf5o8olRPg&oe=6ABBB2E5"}, {"file_name": "Tensiometro.png", "id": "36251387067840171", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623295_36251387111173500_6293926571928592602_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_BgV0ZmQV1wQ7kNvwGtbnor&_nc_oc=Adrzwooq7kp39Pk_wPQh8Ro3ZBf5IMcY_-kQ0rl_vkFCw0GF2F47IrgmTzUsoC3qmQQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJa9WQXA2t0z1x3p6_rkv28A2QSQa3gCKnN1zcLECUy7g&oe=6ABBC3EF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AVCXR VHM Ingenier\u00eda", "keywords": [], "long_description": "A nivel de plataforma, el sistema se divide en aplicaciones pr\u00e1cticas para cada sector:\nEducaci\u00f3n: Entrenamiento interactivo de procesos industriales y laboratorios virtuales para llevar la pr\u00e1ctica al campo.\nSalud: Simuladores m\u00e9dicos interactivos que permiten practicar con equipos reales, como el uso del desfibrilador donde el usuario puede interactuar directamente con el equipo al \"agarrar las paletas\" y \"cargar\"\n, adem\u00e1s de incluir la toma de tensi\u00f3n. Tambi\u00e9n ofrece un espacio de realidad virtual para dise\u00f1ar y dotar espacios cl\u00ednicos a escala 1:1, evitando sobrecostos en la construcci\u00f3n.\nIndustria: Capacitaciones de mantenimiento en sitio y visualizaciones de renderizado a escala real para la toma de decisiones operativas y directivas.", "short_description": "AVCXR es una plataforma inmersiva de realidad mixta enfocada en revolucionar la capacitaci\u00f3n pr\u00e1ctica en los sectores de Educaci\u00f3n, Salud e Industria.\nEl impacto principal del proyecto es la democratizaci\u00f3n y descentralizaci\u00f3n del aprendizaje: mediante el uso de laboratorios remotos y m\u00f3dulos did\u00e1cticos inmersivos, AVCXR lleva oportunidades de educaci\u00f3n superior y entrenamiento en procesos industriales directamente a zonas rurales y comunidades vulnerables de dif\u00edcil acceso"}, {"images": {"nodes": [{"file_name": "AVCXR_MetaQuest.png", "id": "26575577285407797", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618284_26575577292074463_8179618092863187677_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eanDjRsFjdUQ7kNvwGsu2t8&_nc_oc=AdpgnKJf2dR9DfjzDjIzpxW1RRFM8yum24dT-04oMXNd5RENBqpa7bm6Q4X1ARWjKpQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZIepFQ4ZESwTSjvEExfs0b5MTl2U7TyUnUPMFnPEmaw&oe=6ABBE01E"}, {"file_name": "AVCXR_MetaQuest.png", "id": "3056063914782038", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617850_3056063918115371_2202158384151631148_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_YWSl9xQaZUQ7kNvwFz1a-H&_nc_oc=Adq3qj5PSz15T8VtN381UuC4Oysjh8dWmLDtVrghE7tiNoon7zsNAT0J0ZY37gwQeII&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJXXPE2A2AykvsFGJK_PV3HgKPMp4mFIiF2AKHbB-rOOQ&oe=6ABBB7CF"}, {"file_name": "AVCXR_MetaQuest_portrait.png", "id": "2473565366496707", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499296057_2473565369830040_7720233636311648977_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7BR1s9JPzvMQ7kNvwE_LVEA&_nc_oc=Adow1XooeixFM28aipoU0ADFpaEjjRbTvUIik-v5ojCvIYDUjJ9bppnVxn3Dnk-gLZM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscd
yI0Y4RZ4UQ7kNvwGrpwvq&_nc_oc=Adrv8grrwQMFBMCeY0IzqgGmvtZFcoLg155BS4Wi-_y87dycGcIH6bNF8ulvCmAgcEc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSy5FGeKSnhguMVuQ7V9IhqDH5mAqhYwFFczS2dxcxPA&oe=6AB68F15"}, {"file_name": "Arquitecture.png", "id": "1553351126576627", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619668_1553351129909960_629592202932966666_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4XiFSEiIa5kQ7kNvwEVa6XI&_nc_oc=AdqYutCKIDEmBAGl5dzTk5U-7O0-ZUhCnETJhe_F24eHZOYda0JB6I8aFDrN1CrfG10&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLhJJyfhWp2aXZPOqCFD95LleyUIrnh3mt5O_J_399Pog&oe=6AB66CE5"}, {"file_name": "Tensiometro.png", "id": "36251387067840171", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623295_36251387111173500_6293926571928592602_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4OZxVMYqmnEQ7kNvwFXDpHo&_nc_oc=Adr49aRHxwTSgLjZI7LjunqxG2q3akdqh7teGYh0_Ujfo2SOwqOOkzme7XjmWznlKLA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJpyDW4xp7nYc8-iWZvbLtGgpp7Om_2MRN4oguMK5I1_Q&oe=6AB67DEF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AVCXR VHM Ingenier\u00eda", "keywords": [], "long_description": "A nivel de plataforma, el sistema se divide en aplicaciones pr\u00e1cticas para cada sector:\nEducaci\u00f3n: Entrenamiento interactivo de procesos industriales y laboratorios virtuales para llevar la pr\u00e1ctica al campo.\nSalud: Simuladores m\u00e9dicos interactivos que permiten practicar con equipos reales, como el uso del desfibrilador donde el usuario puede interactuar directamente con el equipo al \"agarrar las paletas\" y \"cargar\"\n, adem\u00e1s de incluir la toma de tensi\u00f3n. Tambi\u00e9n ofrece un espacio de realidad virtual para dise\u00f1ar y dotar espacios cl\u00ednicos a escala 1:1, evitando sobrecostos en la construcci\u00f3n.\nIndustria: Capacitaciones de mantenimiento en sitio y visualizaciones de renderizado a escala real para la toma de decisiones operativas y directivas.", "short_description": "AVCXR es una plataforma inmersiva de realidad mixta enfocada en revolucionar la capacitaci\u00f3n pr\u00e1ctica en los sectores de Educaci\u00f3n, Salud e Industria.\nEl impacto principal del proyecto es la democratizaci\u00f3n y descentralizaci\u00f3n del aprendizaje: mediante el uso de laboratorios remotos y m\u00f3dulos did\u00e1cticos inmersivos, AVCXR lleva oportunidades de educaci\u00f3n superior y entrenamiento en procesos industriales directamente a zonas rurales y comunidades vulnerables de dif\u00edcil acceso"}, {"images": {"nodes": [{"file_name": "AVCXR_MetaQuest.png", "id": "26575577285407797", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499618284_26575577292074463_8179618092863187677_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-W6XhYGLIxsQ7kNvwEQi2QF&_nc_oc=AdrO8MJC15vZ8VpzmftFnNOpGUWui1NDHcX6GVxBmF80ZvuCUEL0QQ8_UgEf7eYWSxc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2O16lrkVJctdgDYEJ_fAM0BeKZ2eqr8ew_P9rOYKWSw&oe=6AB69A1E"}, {"file_name": "AVCXR_MetaQuest.png", "id": "3056063914782038", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499617850_3056063918115371_2202158384151631148_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zy21H_aIFBkQ7kNvwElpAXD&_nc_oc=Adrh032I1VJ3iHAXMPT-_qyD8zzEnO1aEihy3uO-uJbrwt1qXnz0_8IoKnC3DVhBbe8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWof8MNfd33VLS7s_cjTZCHvBnfr3kQYimEhazf7lUvg&oe=6AB671CF"}, {"file_name": "AVCXR_MetaQuest_portrait.png", "id": "2473565366496707", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499296057_2473565369830040_7720233636311648977_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BlaBZfGmrfcQ7kNvwGkzar_&_nc_oc=AdoPOWGkVlW-Y4m9iZICO7JeR8zWWdUld92Wegu-gNXEjnQxfA2wRp1YtsR5OYJMaU0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscd
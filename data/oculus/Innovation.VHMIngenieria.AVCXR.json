PqNiJhuFEQ7kNvwE-Esd_&_nc_oc=Adolqo9JoEympLsMnPTDavzEy0S2G-luMNrVs7jbg-1FXLCJZzOGg9NgABZ_M1mMvK4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfRgJt-Lx_y5pPdbv56W4D_ypw6gDHfOkrDK3vy289UA&oe=6AEF3F95"}, {"file_name": "Arquitecture.png", "id": "1553351126576627", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619668_1553351129909960_629592202932966666_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=juQod8AaWEkQ7kNvwFIljFL&_nc_oc=AdquvjmmmoKThkCzaxuRgfMirrNtkv_Q3OPpqpyOqiAgo8pdyxPI_fcgNrzlebaBD30&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKUsORG1UWaOzKfH-0wGEqby_4zTQVobcHdfkGwotsGw&oe=6AEF55A5"}, {"file_name": "Tensiometro.png", "id": "36251387067840171", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623295_36251387111173500_6293926571928592602_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y8HNZCo1ySYQ7kNvwEb1qzv&_nc_oc=AdpRX7Xf1ikyRVa8aXX1vHJ8b1GisMQoL1cAhAxHvtyhH76xH7H1p9ULO5YvqgeB_JE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSuTtPb8CDEP_X1R9bx7heN94Efc42OsopwTy5US6-TZg&oe=6AEF66AF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AVCXR VHM Ingenier\u00eda", "keywords": [], "long_description": "A nivel de plataforma, el sistema se divide en aplicaciones pr\u00e1cticas para cada sector:\nEducaci\u00f3n: Entrenamiento interactivo de procesos industriales y laboratorios virtuales para llevar la pr\u00e1ctica al campo.\nSalud: Simuladores m\u00e9dicos interactivos que permiten practicar con equipos reales, como el uso del desfibrilador donde el usuario puede interactuar directamente con el equipo al \"agarrar las paletas\" y \"cargar\"\n, adem\u00e1s de incluir la toma de tensi\u00f3n. Tambi\u00e9n ofrece un espacio de realidad virtual para dise\u00f1ar y dotar espacios cl\u00ednicos a escala 1:1, evitando sobrecostos en la construcci\u00f3n.\nIndustria: Capacitaciones de mantenimiento en sitio y visualizaciones de renderizado a escala real para la toma de decisiones operativas y directivas.", "short_description": "AVCXR es una plataforma inmersiva de realidad mixta enfocada en revolucionar la capacitaci\u00f3n pr\u00e1ctica en los sectores de Educaci\u00f3n, Salud e Industria.\nEl impacto principal del proyecto es la democratizaci\u00f3n y descentralizaci\u00f3n del aprendizaje: mediante el uso de laboratorios remotos y m\u00f3dulos did\u00e1cticos inmersivos, AVCXR lleva oportunidades de educaci\u00f3n superior y entrenamiento en procesos industriales directamente a zonas rurales y comunidades vulnerables de dif\u00edcil acceso"}, {"images": {"nodes": [{"file_name": "AVCXR_MetaQuest.png", "id": "26575577285407797", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618284_26575577292074463_8179618092863187677_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JCDS4HLYGbYQ7kNvwHZQghk&_nc_oc=Adrsq7v8oA272ISBUmcTkZl9VN4k3A1u2f8an5F1GnLkG8RF0FnmEzAL2ysSBv26oqQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9550BXd2cjIEsDyvWvO9s5XwQqM5Hrpox79SWu0Ubhw&oe=6AEF4A9E"}, {"file_name": "AVCXR_MetaQuest.png", "id": "3056063914782038", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617850_3056063918115371_2202158384151631148_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IeV5y0q353AQ7kNvwHWBTPf&_nc_oc=Adok0SCehUcqAOKaTMfSg5mLipOCwqxKukebqaGaeVRqWEm0q3pZKuztquHItlhqdm4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzInJtuL3ty5jC_SMaSTzLVrC1AOJlglZngtWcbGRz-g&oe=6AEF5A8F"}, {"file_name": "AVCXR_MetaQuest_portrait.png", "id": "2473565366496707", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499296057_2473565369830040_7720233636311648977_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sX01qm7nQ4IQ7kNvwFJe6WE&_nc_oc=AdowyJtglapv4jTCTxipfiuwoonNGvnIWKzaPatU4lqN3v1AvThDZAle1mXii-H5zY8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscd
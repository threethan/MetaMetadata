com/v/t64.5771-25/39035417_417868801395587_1696414666942182352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cdg_YaNkvxsQ7kNvwHuY6-f&_nc_oc=AdrvVAhbKSH9sv3v-HQ6cAlzTnRqD9DknX1Mkt9ATPYXzHMUR0M8UKahic_qXlumsmY&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_OvFi0y9XwdQuWJYwGuvGE2X8dvmXumUVABR86TRNg8g&oe=6A395832"}, {"file_name": "GunShot.png", "id": "1484185552249839", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974834_1484185555583172_8264876483161367463_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4iDb08nPnGkQ7kNvwGu9JhU&_nc_oc=AdpvkVO_Q8ErnxlNuLrgcG-d78wxDR-vJ3lxP9zL0S4Q_rkpWdjhdLw2TRSSmk8jO9E&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9FYMoGgwRavHpBiLC5-nv24o82-BRt5M46bCQYZCrXUw&oe=6A396121"}, {"file_name": "PunchRhythm.png", "id": "1109179657269921", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75462203_1109179660603254_5637594256277893857_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=49Oj6GIInPQQ7kNvwEHdZ7w&_nc_oc=AdqEaaZ4mvQH_m31k-Hsv8TOiP74j56XDLlpN-0WYnv9c1c4rDhvBA-ojZ5awhuitcc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6txcAZhLbWF2RvFR8e_sqUgfcb2DAnyjOl5DjUSe9Ag&oe=6A394718"}, {"file_name": "PracticeBreathing.png", "id": "587550747129538", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974635_587550750462871_1717998606930230757_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c-fCobT2stkQ7kNvwHhdwhi&_nc_oc=Adphjq-rf70vHcYveXPnsCOgeCotIS6-5nU3JAzVarsl6d6rqr5pnJ4vhs-nwCg-oK0&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9abJTIfAyqjw1TegKphjXJnCUFX25GRkTPyolSTKC9Bg&oe=6A3938E7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MUTT: Everything you want", "keywords": ["fitness", "rhythm", "sports", "free", "meditation"], "long_description": "Mutt is the best way to choose and play a variety of Content on one platform. \nWe have a wide range of games including sports, shooting, music, fitness, meditation, and more, and more will be added in the future. \nGet it on the Meta Store now to keep enjoying new experiences!\n\n{1303901187305557}\n# 1. Jelly Saber\n**\u201cExperience the thrill of slicing jelly with a light saber!\u201d**\n\n\nFeel the exhilarating sensation of slicing through jelly, battle against increasingly powerful waves and boss monsters, and survive the endless battles to be the last one standing.\n\n\n{573498865228346}\n# 2. Gunshot Game\n**\u201cDefeat enemies with a variety of firearms and survive the boss battle!\u201d**\n\nA thrilling experience of surviving to the end against oncoming enemies and powerful bosses. Utilize a variety of firearms to take down enemies and test the limits of your survival!\n\n\n{8754035691345594}\n# 3. Punch Rhythm\n**\u201cGet into the rhythm, enjoy the colorful combinations of your left and right hands!\u201d**\n\nFun tapping rhythm notes with interesting music! Think about the combinations of your left and right hands in the complex composition of long and single notes and ride the rhythm to the music. More music will be added in the future!\n\n\n\n{2008927669537690}\n# 4. Breathing Exercises\n**\u201cFind peace of mind with deep breathing in nature!\u201d** \n\nBreathing exercises to calm your mind and body against the backdrop of fresh nature's sights and sounds. A variety of options to calm your mind and visual and auditory effects to help you breathe. Start now for a unique experience that will lighten your heart.\n\n\n\n\n", "short_description": "All kinds of games for FREE. Sports, Shooting, Music, Fitness, Meditation, you name it, we have it."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sevenptone.com/mutt-privacy/", "developer_terms_of_service_url": null, "publisher_name": "Derick", "support_website_url": null, "website_url": "https://sevenptone.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326
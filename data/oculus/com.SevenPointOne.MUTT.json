dR27lIxwppsVDn1VHnGdAr40MZPPWlpLe4xBxj4Xuv2c6Ww0tM0YhJuwGhygitc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afuzng423gt0zPCbN9wnj9IuxEkMpjeL4CD_ggXWIHXG-Q&oe=69A05A8D"}, {"file_name": "gun3.png", "id": "3072587276248220", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618093_3072587279581553_8452235450443429166_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OV9xV9P9GhkQ7kNvwEAV167&_nc_oc=Adk5-Nqq4sSte8iUyZS3PBITcX7lCygL1IIo5RF6_bkdwNLBhqqQIz1CruidLsmcwIA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftm-FN6XzNMwcyz4RWr9OwPUNYQhdyrcGk26b1k_19gOg&oe=69A044CE"}, {"file_name": "bat3.png", "id": "837829559098468", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499314634_837829562431801_142342347843413544_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8cLh81atRZUQ7kNvwGuoYGU&_nc_oc=AdmcGh3xDcP3R6CYT014dgi3kdGn14tLuIkCCnAFsYVcjSHcGhN9yg6Eydn-3IPfEh4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvY3dgOPXXVaToPLtCZvnZvQ8bxDbBCZtHr2zTNesTl1Q&oe=69A0428C"}, {"file_name": "Lobby.png", "id": "2386860311811259", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618499_2386860315144592_4732509698311048844_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7JCsRCo8yeoQ7kNvwHJdCxx&_nc_oc=AdkuZjZeNQs7tsPGmxFfSUEy5t4wAt5apdO_RY4mD3lBSNeirq6GyIHfHTRBnlz1gUo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afuu1jdKJP1ctW_Q_ClrJLaoxjqLvBsv3LKMUzv78OxfQQ&oe=69A04F82"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape(2560x1440),\uc378\ub124\uc77c.png", "id": "1513545639731719", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619832_1513545643065052_6956812012207879288_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p8HQxoT_rqcQ7kNvwG6UyrA&_nc_oc=AdkPPWRO5XL9t6YEJVuLQu1pc_N2ZiYqJDnN-qgtG_UCld_HPmGitp8r9yxXTA6k98U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvWCGKsKB9hvDiLy-F5oZO45YjnMz3bSoELDVl0oM6j6A&oe=69A0261E"}, "display_name": "Calorie Hunters: XR Fitness Beat Combat", "keywords": ["rhythm", "fit", "beat", "combat", "boxing"], "long_description": "# Game or Workout? The answer is both!\nWe transform exercise from 'hard pain' into an unstoppable 'Enjoyable Healthy Addiction Experience'. Join the 'Calorie Hunters' journey now and start the most fun and effective diet routine! \n\n\u2800\n\n# \ud83c\udf1f The Perfect Blend of Fun and Fitness\n\u2800\n# 1. \u2694\ufe0f Hunt the Calories,  Not the Chore! (Calorie Monster Hunting System)\n\n**1) Intuitive Goal:** \n- Exercise expenditure is set as a hunting target called' Calorie Monsters,' providing an intuitive goal and strong motivation. \n- Every move you make\u2014punches, squats, and more\u2014becomes a powerful attack dealing damage to the monsters.\n\n**2) Achievement & Competition:**\n- After completing a challenge, experience the satisfaction of ranking up on the World Leaderboards as you compete against Hunters globally.\n\n\u2800\n# 2. \ud83e\udd2f Never Boring, Always Intense! (Random Weapon System)\n**1) All-in-One VR Rhythm Action Platform:**\n- Integrates the fun elements of various VR games into rhythm notes, including not just basic movements like Punch and Squat, but also Slash, Gun Shot, and Hit.\n---\n**2) Infinite Content:** \n- Our proprietary algorithm endlessly and randomly combines weapons and rhythm notes, creating fresh, dynamic workout routines every time.\n\n\u2800\n# 3. \ud83d\uddfa\ufe0f Future Updates Planned\n'Calorie Hunters' is committed to growing with its users and continuously delivering new fun.\n- New Stages with unique themes will be regularly added.\n- Various additional content is planned, including Boss Battles, Multiplayer, and Customization.\n", "short_description": "The Start of a Healthy Addiction\n\"Fitness is NOT Pain!\"\nHunt Your Fat with the Unstoppable VR Rhythm Action, 'Calorie Hunters'!\n\nThe VR fitness revolution that will make you shout, \"Just one more set!\".\n'Calorie Hunters' maximizes the fun of VR rhythm action to transform tedious, repetitive exercise into a 'Healthy Addiction'. By hunting monsters to the exciting music beat, you\u2019ll not only achieve your diet goals but also form a consistent exercise habit."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sevenptone.com/mutt-privacy/", "developer_terms_of_service_url": null, "publisher_name": "Derick", "support_website_url": null, "website_url": "https://sevenptone.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "de", "ja", "ko", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33569444959337671"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619685_1559353675120619_561145763113312566_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hNy3adi1pgoQ7kNvwGBYmrH&_nc_oc=Adkx0Ym1TkvgRiqKmGghenG8UwiHXxOIQlvkPWHhSSYHcDOtD4vKFdYaL20AmI_xx48&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsAt6YynjaQmSvE3xI7suUNeZod07tCeoNOq1umQpLg8A&oe=69A03918"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Calorie Hunters: XR Fitness Beat Combat", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}, {"topic_name": "Sports", "id": "2776542286000603"}], "release_
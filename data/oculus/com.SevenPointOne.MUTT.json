2.oculuscdn.com/v/t64.5771-25/499622334_1662831248297594_547601879803341137_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rjwqmy5iCdoQ7kNvwF8N59z&_nc_oc=Adp2BwsbNG5Z9wHwhtb8e4-IgxjEZSCYo4gorTH7Id7KGuCVkg8ErT9s6fRLrtJ8rcg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTklJP0VkS_2XgN1wtTbovVsrQwIcO3x8SSzbjWwG_vcw&oe=6B0856CB"}, {"file_name": "gun1.png", "id": "1701141757903683", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/613057330_1701141761237016_2057678754440633945_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oRnT6_0SwnwQ7kNvwGfOTkI&_nc_oc=AdrVpgzWHWXtL8HkAaXXmXqf4EEZzjZlYTeDsOndY8dPxBM7MwEtKHdtLT8MaTMX8v0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSK2OWNWu4Cy4xvLTkzs4azsmUAxeGbsOU1_jndT45yjQ&oe=6B085853"}, {"file_name": "lobby.png", "id": "844396791563245", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/604275479_844396794896578_4553122631057590950_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7NE6SYqIkUgQ7kNvwFZjoY7&_nc_oc=Ado8RvyFq6Z8pqTl5U4R2jgv0_4qaP-rYNDVzc4IsoS89YtoG6aquWQG0lstblgZgGc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJeQ8QsKjDNHPzFgZt0_V0C_zJQPmAY_uHqZxkKMSZwQ&oe=6B083EEF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape(2560x1440),\uc378\ub124\uc77c.png", "id": "1755566859091507", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499622188_1755566862424840_594230336198285518_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fM_mB6_rf6AQ7kNvwFtan_g&_nc_oc=AdqAaOVBz5gW-p3TXwGmKcrfBDiu1wLzzSypuX6Q-EEFYEWDgNTjya-UJ_Rs29MYgLw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMhyaRqbmEPaC6VganFSVwUdyhljYQkfqNQd4SEk_Y7A&oe=6B086A89"}, "display_name": "Calorie Hunters: XR Fitness Beat Combat", "keywords": ["rhythm", "beat", "combat", "boxing", "fitness"], "long_description": "# \"Just One More Set!\"\n\nEver had that \"just one more game\" urge \u2014 for your workout?\nPunch, slash, shoot to the beat. You'll be hitting play on the next track in no time.\n\nForget willpower.\nStep into 'Calorie Hunters' \u2014 the most enjoyable healthy addiction in VR rhythm action.\n\n\u2800\n\n# \ud83c\udf1f Where Fun Meets Real Fitness\n\u2800\n# 1. \u2694\ufe0f Hunt the Calories, Not the Chore!\n- Calories appear as Monsters \u2014 real prey, not abstract numbers.\n- Every punch, squat, slash, and shot lands a powerful blow.\n- Clear a round and climb the Global Leaderboards against Hunters worldwide\n\n\u2800\n# 2. \ud83e\udd2f Never Boring, Always Fresh!\n- All VR rhythm action fun \u2014 punch, slash, shoot, smash \u2014 in one session.\n- Our algorithm mixes weapons and notes randomly every time. No two routines alike.\n- Workout burnout? Not anymore\n\n\u2800\n# 3. \ud83c\udd95 NEW in This Update!\n- \ud83d\udc09 **Boss Battles** \u2014 A true challenger for Hunters who've outgrown ordinary prey. The Boss summons Rhythm Monsters \u2014 hunt them down to strike the Boss itself. Defeat it and claim your bounty.\n- \ud83e\udd1d **Supporter System** \u2014 Spend the Gold you earn hunting to build your own Supporter dance team. They'll cheer you on with adorable dance moves while your allies bring unique abilities and grow stronger with every rank-up. Who you hunt with is your new strategy.\n\n\u2800\n# 4. \ud83d\uddfa\ufe0f What's Coming Next\n'Calorie Hunters' grows with its players. This is just the beginning.\n- New themed stages added regularly.\n- Multiplayer and more co-op content on the way.\n- A deeper, richer 'one more set' is always waiting for you.", "short_description": "The Start of a Healthy Addiction\n\"Fitness is NOT Pain!\"\nHunt Your Fat with the Unstoppable VR Rhythm Action, 'Calorie Hunters'!\n\nThe VR fitness revolution that will make you shout, \"Just one more set!\".\n'Calorie Hunters' maximizes the fun of VR rhythm action to transform tedious, repetitive exercise into a 'Healthy Addiction'. By hunting monsters to the exciting music beat, you\u2019ll not only achieve your diet goals but also form a consistent exercise habit."}, {"images": {"nodes": [{"file_name": "CoverSquare(1440x1440),\uc378\ub124\uc77c\uc5d0 \ub4e4\uc5b4\uac00\ub294 \uc694\uc18c\ub97c \uc815\uc0ac\uac01\ud615\uc5d0 \ub9de\ucdb0\uc11c.png", "id": "1984082902291098", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499623534_1984082905624431_5653267256921169664_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QcyZwQb8sUsQ7kNvwF0cDU9&_nc_oc=AdqFPhtGuK9551bRFbfhPK6MHJp12tkBOB3pfVXfnuELKkQpvxMISrMTcnCIB22kJ8s&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdU_IdY2QTajikwtp8DAtXzF9MrYxfnvwVn-YHVUPDwA&oe=6B08493A"}, {"file_name": "Logo(Transparent).png", "id": "1771494364195456", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499619404_1771494370862122_7957116351418805276_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oawf2rAEMpIQ7kNvwERZpov&_nc_oc=AdqBIkB1QnAn_5GNtB4Bil5Cw4BSptchxxv2cZKCxYHKOXaYi11n16qiSSBUE2vXs2w&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRtCSv0p_oKE-npdsAniXwSvY2fyS1069a0cWo-OgZAg&oe=6B084514"}, {"file_name": "HeroCover(3000x900),\uc2a4\ud1a0\uc5b4\uc5d0\uc11c \uc5b4\ud50c \ub20c\ub7ec\uc11c \ub4e4\uc5b4\uac00\uba74 \ubcf4\uc774\ub294 \uc774\ubbf8\uc9c0.png", "id": "1613872473743039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/593839439_1613872477076372_6479563604376765610_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YX9EOdMjhM8Q7kNvwHGW4eA&_nc_oc=AdoSjQR0-I5q5QvdKi-NYE-FJQWQC1jObG4jyOLFVpuGBw92zaofc9Ns7QW5TW9LZ5I&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlIPKtSV3zlbtfZdgK8XZWTUOmN05K0JWXArLtd4RmRw&oe=6B084D19"}, {
{"data": {"node": {"__typename": "Application", "id": "27613669408248619", "organization": {"id": "823342273278216", "viewer_permissions": [], "application_groupings": {"nodes": [{"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "27613669408248619"}]}, "id": "477688571437605"}]}}, "firstRevision": {"nodes": [{"application": {"id": "27613669408248619", "release_date": 1733706420, "is_concept": false, "platform": "ANDROID_6DOF", "scheduled_offers": {"count": 1}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "35814746308140847"}, "id": "887977596757336"}]}}, "binary": null, "live_binary": null, "created_date": 1776130462, "id": "34965646139717539", "is_initial_release": false, "name_with_fallback": "v15", "pdp_metadata_with_fallback": {"version": 14, "application": {"is_concept": false, "latest_released_pdp_metadata": {"id": "35770797669202378"}, "release_status": "RELEASED", "id": "27613669408248619"}, "id": "35770797669202378", "release_status": "RELEASED", "status": "APPROVED"}, "release_date": null, "administration_status": "APPROVED", "is_first": false, "release_status": "RELEASED", "release_type": "SCHEDULED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "27613669408248619", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "579166184624305"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "CoverLandscape(2560x1440),\uc378\ub124\uc77c.png", "id": "35824301873852305", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499620860_35824301900518969_8677363824331430839_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q9QQZttSh94Q7kNvwGK9saB&_nc_oc=Adr-rHxkuCo3aFsZDxxWyVIrhS70MPcynmVjzncAewMrw4NsIbu-jFVjk0K6w_VZR2A&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6K4fez76TZIOT2MW8L0i-Z1qH1cxByJjU6iE_5LsGCtQ&oe=6A16FB30"}, {"file_name": "HeroCover(3000x900),\uc2a4\ud1a0\uc5b4\uc5d0\uc11c \uc5b4\ud50c \ub20c\ub7ec\uc11c \ub4e4\uc5b4\uac00\uba74 \ubcf4\uc774\ub294 \uc774\ubbf8\uc9c0.png", "id": "2020004012224205", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/595136811_2020004018890871_280394800797697319_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R5zLdufE7VIQ7kNvwGbHh-E&_nc_oc=AdrJlCsxhaSLzlUXjNrk3zAtGiNILNjoBblh_yJOlOnsK9xR0GDBvQ_YT1vV3p_Salc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af62XF4XcOpSJM84AWeBJeyk2t6YejEnyWUEKFl7s1zvWQ&oe=6A16E26D"}, {"file_name": "CoverSquare(1440x1440),\uc378\ub124\uc77c\uc5d0 \ub4e4\uc5b4\uac00\ub294 \uc694\uc18c\ub97c \uc815\uc0ac\uac01\ud615\uc5d0 \ub9de\ucdb0\uc11c.png", "id": "1387374113425660", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/596157734_1387374116758993_580513561534275019_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4wFEc_6Bls0Q7kNvwHlxcLn&_nc_oc=AdrDJf4c9_8ODQi6K3GRj2-_AszdO7dBNew_rV-SiaT6RSC1CGspIWjnZCyAgCyNNHE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6uz1amcfMwcppjEgObqBtI7FQd2RD-HXNDJ1ADEX6jAw&oe=6A16DF71"}, {"file_name": "CoverPortrait(1008x1440),\uc694\uc18c \uc138\ub85c\ubc84\uc804.png", "id": "1355972336579200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499623314_1355972339912533_3641251412926555238_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VJ2e3vsGYocQ7kNvwEshuJd&_nc_oc=AdqTkqx3Had_dYEtvRB8Zs3rzae1r_PPCrm96DI9VZ8VDGAAxBU_kdVZp3ZvBlPUMI0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6mlq1CTKAIPXKLw1uJO6yDgfG8L5ikBEVVRbBw8BPEZg&oe=6A16F633"}, {"file_name": "CoverSquare(1440x1440),\uc378\ub124\uc77c\uc5d0 \ub4e4\uc5b4\uac00\ub294 \uc694\uc18c\ub97c \uc815\uc0ac\uac01\ud615\uc5d0 \ub9de\ucdb0\uc11c.png", "id": "1167017562232314", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619751_1167017565565647_873207627378291330_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZL_0z0CGadgQ7kNvwHJBEtY&_nc_oc=Adp6p7ffEiY1UFMdeBSfFOYdL63zihxBTcVXvMPkqLNjANqVqUhvpOHZ2V14Mzlnruw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6dXObutldboZ_O1BBq2TuOgBF3TrcCEMc2dGt_ptvRpg&oe=6A16FB9D"}, {"file_name": "Logo(Transparent).png", "id": "820419500824861", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499623384_820419504158194_4049726735012804865_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zb5JZSPT-JUQ7kNvwFbeW-A&_nc_oc=AdqonC_yaghTg-meL6Gouyle5AbdlPCE2ptTW8n-97g0ev2cRa2gIgfV_sx_soMQkV0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4xCmpIIqhhq6Z4eV-c0JtIrK9bmoGBaFFcJuaymutHtw&oe=6A16EC37"}]}, "id": "938900332525430", "locale": "ko_KR", "screenshots": [{"file_name": "lobby.png", "id": "1694084821494788", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499623370_1694084824828121_8188048639442793948_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lND5r2fcTDwQ7kNvwEvDLEO&_nc_oc=AdpD-x7AnY6FD9aAxHRs6AYoQjaToV0iUNv_4m58o6qtNfVaB1pMsRoEsC5aC0GVZ1k&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4T1wzi8NAmefXKoZLoaKZb_wAUqw5YL09AUFuQGxinow&oe=6A16FFD4"}, {"file_name": "supporter2.png", "id": "27287240120900782", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499623601_27287240124234115_1941419494427239415_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AQIh2ibQGkkQ7kNvwHf3lwF&_nc_oc=AdrgXE5qNxLO7XFY4_NZ_s4GWU3lhyR1AFp5gv7Cw7KRF6ZHJcHMghuxDFwLyuJCrFI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7H5eQobVlsiFMZQHa5AyCPBGeji6DfX-P0LEqjFNN_Kg&oe=6A170B1B"}, {"file_name": "punch4.png", "id": "1325233936221035", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499623400_1325233939554368_5864324239707532116_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ZjCsd23r5gQ7kNvwH_Tr9y&_nc_oc=AdqBTmSK9TtVqMAm00ockhx_uqfBgjZed_GngyC3BSZMef-UjT_W_V8Wr8v9ZphBbxk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70TOoQSjbrcZ43KxTP9FROGz5K_xv1gT8P26attprj_A&oe=6A170A8F"}, {"file_name": "bat.png", "id": "1690530621954151", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/654867655_1690530625287484_6253866735436806573_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eT1TqpK1JysQ7kNvwEzYEHw&_nc_oc=AdrKU2wWkDuE7HpjRT3XfGr2Xa8q_SVepvP5Vod0SerOQFO3BEfoXaVdyGA2skjUyQc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af69BhME0vVICxA1u2Zy6V1J1lvb3mRv9xConB_wqMHd9w&oe=6A17145C"}, {"file_name": "gun1.png", "id": "2508994702886826", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499622285_2508994706220159_3422494880786317538_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HOR8MA1AM3IQ7kNvwH2iW80&_nc_oc=AdpOprshtZwkw8CXoGqHhC7L9NOMBoG4ZiFpDj-KrEZpUBUYV2TRzIuMBrsoqUrq2Qs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7jivw7QoNL7zmIZzFW1ApdoPF-D9WZcLjoFdw5CEtcwg&oe=6A16F0B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape(2560x1440),\uc11c\ube0c\uc378\ub124\uc77c.png", "id": "1502761621293953", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499623601_1502761624627286_3797892329347025278_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yjZt24H2mHEQ7kNvwFqa6mS&_nc_oc=AdrcDtX7HPludBxuhGmyi-prDkpAz80ZZujenSOvpNFqmmAae9Kz6ximUXKt55FpL-M&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7CGN6aFUPDFDE3xurflTPEsqQfpwK8wB1Ca5Y-oJgp6Q&oe=6A1712B9"}, "display_name": "\uce7c\ub85c\ub9ac \ud5cc\ud130\uc2a4: XR Fitness Beat Combat", "keywords": ["combat", "beat", "fit", "rhythm", "boxing"], "long_description": "# \"\ub531 \ud55c \uc138\ud2b8\ub9cc \ub354!\"\n\n\uac8c\uc784\uc744 \uba48\ucd94\uc9c0 \ubabb\ud558\ub358 \uadf8 \ub9c8\uc74c, \uc6b4\ub3d9\uc5d0\uc11c\ub3c4 \ub290\uaef4\ubcf8 \uc801 \uc788\uc73c\uc138\uc694?\n\ud380\uce58, \ubca0\uae30, \uc288\ud305 \u2014 \ube44\ud2b8\uc5d0 \ub9de\ucdb0 \uce7c\ub85c\ub9ac \ubaac\uc2a4\ud130\ub97c \uc0ac\ub0e5\ud558\ub2e4 \ubcf4\uba74,\n\ud55c \uace1\uc774 \ub05d\ub098\uae30\ub3c4 \uc804\uc5d0 \ub2e4\uc74c \uace1\uc744 \ub204\ub974\uace0 \uc788\uc2b5\ub2c8\ub2e4.\n\n\uc6b4\ub3d9\uc740 \ub354 \uc774\uc0c1 \uc758\uc9c0\uc758 \ubb38\uc81c\uac00 \uc544\ub2d9\ub2c8\ub2e4.\n'\uce7c\ub85c\ub9ac \ud5cc\ud130\uc2a4' \u2014 VR \ub9ac\ub4ec \uc561\uc158\uc774 \ub9cc\ub4e0, \uac00\uc7a5 \uc990\uac70\uc6b4 \uac74\uac15 \uc911\ub3c5\uc744 \ub290\uaef4\ubcf4\uc138\uc694!\n\n\u2800\n\n# \ud83c\udf1f \uce7c\ub85c\ub9ac \ud5cc\ud130\uc2a4\uc758 \ud2b9\ubcc4\ud568: \uc7ac\ubbf8\uc640 \uc6b4\ub3d9 \ud6a8\uacfc\uc758 \uc644\ubcbd\ud55c \uc870\ud654\n\u2800\n# 1. \u2694\ufe0f \uc6b4\ub3d9\uc744 \uc0ac\ub0e5\ud558\ub77c! (\uce7c\ub85c\ub9ac \ubaac\uc2a4\ud130 \ud5cc\ud305 \uc2dc\uc2a4\ud15c)\n\n**1) \uc9c1\uad00\uc801\uc778 \ubaa9\ud45c \u2014 \uce7c\ub85c\ub9ac\uac00 \ubaac\uc2a4\ud130\uac00 \ub41c\ub2e4**\n- \uc18c\ubaa8\ud574\uc57c \ud560 \uce7c\ub85c\ub9ac\uac00 \ub208\uc55e\uc758 '\ubaac\uc2a4\ud130'\ub85c \ub098\ud0c0\ub0a9\ub2c8\ub2e4. \ucd94\uc0c1\uc801\uc778 \uc22b\uc790\uac00 \uc544\ub2cc, \uc2e4\uc81c\ub85c \uc4f0\ub7ec\ub728\ub824\uc57c \ud560 \uc0ac\ub0e5\uac10.\n- \ud380\uce58, \uc2a4\ucffc\ud2b8, \ubca0\uae30, \uc288\ud305 \u2014 \ub2f9\uc2e0\uc758 \ubaa8\ub4e0 \ub3d9\uc791\uc774 \ubaac\uc2a4\ud130\uc5d0\uac8c \uaf42\ud788\ub294 \uc77c\uaca9\uc774 \ub429\ub2c8\ub2e4.\n\n**2) \ub05d\ub098\uba74 \uc2dc\uc791\ub418\ub294 \uacbd\uc7c1 \u2014 \uae00\ub85c\ubc8c \ub9ac\ub354\ubcf4\ub4dc**\n- \ud55c \ub77c\uc6b4\ub4dc\ub97c \ud074\ub9ac\uc5b4\ud558\ub294 \uc21c\uac04, \uc804 \uc138\uacc4 \ud5cc\ud130\ub4e4\uacfc\uc758 \uacbd\uc7c1\uc774 \uc2dc\uc791\ub429\ub2c8\ub2e4.\n- \uc790\uc2e0\uc758 \uae30\ub85d\uc774 \uc5b4\ub514\uae4c\uc9c0 \uc62c\ub77c\uac00\ub294\uc9c0 \uc9c1\uc811 \ud655\uc778\ud574\ubcf4\uc138\uc694.\n\n\u2800\n# 2. \ud83e\udd2f \uc808\ub300 \uc9c8\ub9ac\uc9c0 \uc54a\ub294\ub2e4! (\ub79c\ub364 \uc6e8\ud3f0 \uc2dc\uc2a4\ud15c)\n\n**1) VR \uc6b4\ub3d9 \uac8c\uc784\uc758 \ubaa8\ub4e0 \uc7ac\ubbf8, \ud55c \uacf3\uc5d0**\n- \ud380\uce58\ud558\ub294 \uac8c\uc784\uc774 \ub530\ub85c, \ubca0\ub294 \uac8c\uc784\uc774 \ub530\ub85c? \uc774\uc81c '\uce7c\ub85c\ub9ac \ud5cc\ud130\uc2a4' \ud558\ub098\uba74 \ub429\ub2c8\ub2e4.\n- \ud380\uce58, \uc2a4\ucffc\ud2b8, \uc2ac\ub798\uc2dc, \uc288\ud305, \ud0c0\uaca9 \u2014 VR \ub9ac\ub4ec \uc561\uc158\uc758 \ubaa8\ub4e0 \uc7ac\ubbf8\ub97c \ud55c \ud310\uc5d0 \ub2f4\uc558\uc2b5\ub2c8\ub2e4.\n\n**2) \ub9e4\ubc88 \uc0c8\ub86d\uac8c, \ubb34\ud55c\ud788 \uc870\ud569\ub418\ub294 \ucf58\ud150\uce20**\n- \uc790\uccb4 \uc54c\uace0\ub9ac\uc998\uc774 \ubb34\uae30\uc640 \ub9ac\ub4ec \ub178\ud2b8\ub97c \ub9e4\ubc88 \ubb34\uc791\uc704\ub85c \uc870\ud569\ud569\ub2c8\ub2e4.\n- \uc5b4\uc81c\uc758 \ub8e8\ud2f4\uacfc \uc624\ub298\uc758 \ub8e8\ud2f4\uc774 \ub2e4\ub974\uace0, \uc5b4\uc81c \ubabb \ubd24\ub358 \ubb34\uae30\ub97c \uc624\ub298 \ub9cc\ub098\uac8c \ub429\ub2c8\ub2e4.\n- \uc6b4\ub3d9 \uad8c\ud0dc\uae30? \uc774\uc81c \ub05d\uc785\ub2c8\ub2e4.\n\n\u2800\n\n# 3. NEW! \uc774\ubc88 \uc5c5\ub370\uc774\ud2b8\uc758 \uc0c8\ub85c\uc6b4 \uacbd\ud5d8\n\n**1) \ud83d\udc09 \uac70\ub300\ud55c \ubcf4\uc2a4, \uc815\uba74 \uc2b9\ubd80! (Boss Battles)**\n- \ud3c9\ubc94\ud55c \uc0ac\ub0e5\uc774 \uc2dc\uc2dc\ud574\uc9c4 \ud5cc\ud130\ub97c \uc704\ud55c, \uc9c4\uc9dc \uac15\uc801\uc774 \ub4f1\uc7a5\ud569\ub2c8\ub2e4.\n- \ud398\uc774\uc988\ubcc4 \ud328\ud134\uc744 \uc77d\uace0, \uc815\ud655\ud55c \ub3d9\uc791\uc73c\ub85c \uc57d\uc810\uc744 \ub178\ub9ac\ub294 \uc77c\ub300\uc77c \uacb0\uc804.\n- \uc77c\ubc18 \uc0ac\ub0e5\uacfc\ub294 \ucc28\uc6d0\uc774 \ub2e4\ub978 \uac15\ub3c4, \uadf8\ub9cc\ud07c \uc9dc\ub9bf\ud55c \ubcf4\uc0c1\uc774 \uae30\ub2e4\ub9bd\ub2c8\ub2e4.\n\n**2) \ud83e\udd1d \ud63c\uc790\uac00 \uc544\ub2cc \uc0ac\ub0e5! (Supporter System)**\n- \uc774\uc81c \uc0ac\ub0e5\uc5d0 \ud568\uaed8\ud560 \ub3d9\ub8cc, '\uc11c\ud3ec\ud130'\ub97c \ubaa8\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n- \uac01 \uc11c\ud3ec\ud130\ub294 \uace0\uc720 \ub2a5\ub825\uc73c\ub85c \ud5cc\ud130\ub97c \ubcf4\uc870\ud558\uba70, \uc2b9\uae09\uc744 \ud1b5\ud574 \ub354 \uac15\ub825\ud55c \ud30c\ud2b8\ub108\ub85c \uc131\uc7a5\ud569\ub2c8\ub2e4.\n- \ub204\uad6c\uc640 \ud568\uaed8 \uc0ac\ub0e5\ud558\ub290\ub0d0 \u2014 \uadf8\uac83\uc774 \uc0c8\ub85c\uc6b4 \uc804\ub7b5\uc774 \ub429\ub2c8\ub2e4.\n\n**3) \ud83d\udc8e \ub098\ub9cc\uc758 \ud5cc\ud130 \uc2a4\ud0c0\uc77c! (Customization)**\n- \ubb34\uae30 \uc678\ud615, \ucf54\uc2a4\ud2ac, \uc561\uc138\uc11c\ub9ac\ub85c \ub098\ub9cc\uc758 \ud5cc\ud130\ub97c \uc644\uc131\ud558\uc138\uc694.\n- \uc138\uc0c1\uc5d0 \uac19\uc740 \ud5cc\ud130\ub294 \ub2e8 \ud55c \uba85\ub3c4 \uc5c6\uc2b5\ub2c8\ub2e4.\n\n**4) \u2728 \ubaa8\ub4e0 \ub514\ud14c\uc77c\uc744 \ud55c \ub2e8\uacc4 \uc704\ub85c (Polishing)**\n- \uc774\ud399\ud2b8\uc758 \uc784\ud329\ud2b8, UI\uc758 \ubc18\uc751\uc131, \ubc38\ub7f0\uc2a4\uc758 \uc815\ubc00\ud568 \u2014 \uac8c\uc784 \uc804\ubc18\uc758 \ub514\ud14c\uc77c\uc744 \ud55c \ub2e8\uacc4 \ub2e4\ub4ec\uc5c8\uc2b5\ub2c8\ub2e4.\n- \ud55c \ubc88\uc758 \ud380\uce58, \ud55c \ubc88\uc758 \uc2ac\ub798\uc2dc\uac00 \uc774\uc804\ubcf4\ub2e4 \ub354 \uc9dc\ub9bf\ud558\uac8c \ub290\uaef4\uc9c8 \uac81\ub2c8\ub2e4.\n\n\u2800\n# 4. \ud83d\uddfa\ufe0f \uc55e\uc73c\ub85c \ub9cc\ub098\uc2e4 \ucf58\ud150\uce20\n\n'\uce7c\ub85c\ub9ac \ud5cc\ud130\uc2a4'\ub294 \uc720\uc800\uc640 \ud568\uaed8 \uc131\uc7a5\ud569\ub2c8\ub2e4. \uc9c0\uae08\uc774 \ub05d\uc774 \uc544\ub2cc, \uc2dc\uc791\uc785\ub2c8\ub2e4.\n- \ub3c5\ucc3d\uc801\uc778 \ud14c\ub9c8\uc758 \uc0c8\ub85c\uc6b4 \uc2a4\ud14c\uc774\uc9c0\uac00 \uc815\uae30\uc801\uc73c\ub85c \ucd94\uac00\ub429\ub2c8\ub2e4.\n- \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \ub4f1 \ub354 \ub9ce\uc740 \ud5cc\ud130\ub4e4\uacfc \ud568\uaed8\ud560 \ucf58\ud150\uce20\ub3c4 \ucc28\ub840\ub85c \uc900\ube44 \uc911\uc785\ub2c8\ub2e4.\n- \ub354 \uae4a\uace0, \ub354 \ub2e4\uc591\ud558\uace0, \ub354 \uc990\uac70\uc6b4 '\ud55c \uc138\ud2b8'\uac00, \uacc4\uc18d \uae30\ub2e4\ub9ac\uace0 \uc788\uc2b5\ub2c8\ub2e4.\n", "short_description": "\"\ub531 \ud55c \uc138\ud2b8\ub9cc \ub354!\"\n\n\uac74\uac15\ud55c \uc911\ub3c5\uc758 \uc2dc\uc791:  \uc6b4\ub3d9\uc740 \uace0\ud1b5\uc774 \uc544\ub2c8\ub2e4!\n\uba48\ucd9c \uc218 \uc5c6\ub294 VR \ub9ac\ub4ec \uc561\uc158, '\uce7c\ub85c\ub9ac \ud5cc\ud130\uc2a4'\ub85c \uc9c0\ubc29\uc744 \uc0ac\ub0e5\ud558\uc138\uc694!\n\n\n\"\ub531 \ud55c \uc138\ud2b8\ub9cc \ub354!\"\ub97c \uc678\uce58\uac8c \ub9cc\ub4dc\ub294 VR \ud53c\ud2b8\ub2c8\uc2a4 \ud601\uba85.\n\n'\uce7c\ub85c\ub9ac \ud5cc\ud130\uc2a4'\ub294 VR \ub9ac\ub4ec \uc561\uc158 \uac8c\uc784\uc758 \uc7ac\ubbf8\ub97c \uadf9\ub300\ud654\ud558\uc5ec \uc9c0\ub8e8\ud55c \ubc18\ubcf5 \uc6b4\ub3d9\uc744 '\uac74\uac15\ud55c \uc911\ub3c5(Healthy Addiction)'\uc73c\ub85c \ubc14\uafc9\ub2c8\ub2e4.\n\n\uc2e0\ub098\ub294 \uc74c\uc545 \ube44\ud2b8\uc5d0 \ub9de\ucdb0 \ubaac\uc2a4\ud130\ub97c \uc0ac\ub0e5\ud558\ub2e4 \ubcf4\uba74 , \uc5b4\ub290\uc0c8 \ub2e4\uc774\uc5b4\ud2b8 \ud6a8\uacfc\uc640 \uc6b4\ub3d9 \uc2b5\uad00\uae4c\uc9c0 \uc5bb\uac8c \ub420 \uac83\uc785\ub2c8\ub2e4."}, {"images": {"nodes": [{"file_name": "CoverPortrait(1008x1440),\uc694\uc18c \uc138\ub85c\ubc84\uc804.png", "id": "26844705651879897", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/604282317_26844705655213230_6896227353799658649_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5sjqHh4zCgEQ7kNvwH5TQ7S&_nc_oc=AdoKJcgqxOjposvM_g6TVw2vQo8IrMEtjJdmpQPBzT4c5JKzqb5PLUyUuwdq57myUME&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4AWsoWnpJcyXbvYpIMxektPSTuWtSuhruxmVvjcy6aNA&oe=6A16FE7D"}, {"file_name": "CoverSquare(1440x1440),\uc378\ub124\uc77c\uc5d0 \ub4e4\uc5b4\uac00\ub294 \uc694\uc18c\ub97c \uc815\uc0ac\uac01\ud615\uc5d0 \ub9de\ucdb0\uc11c.png", "id": "1675235406952121",
 "586238543866945", "locale": "en_US", "screenshots": [{"file_name": "Menu.png", "id": "2008978369576941", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982514_2008978372910274_3328683603074494857_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fmleH2XmLxoQ7kNvwHVvPLa&_nc_oc=Adlv5ns_-m37rkRz3_J94gHKG9EuxdWa3CsA-kfY-GaQJdf86eXNuLf7Tu11YFcIQK8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwriWkuBLiVpN4oDE_8gBZY2JrlI02hfEcAjCXriB0s2A&oe=69B00100"}, {"file_name": "JellySaber.png", "id": "417868798062254", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035417_417868801395587_1696414666942182352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ugVgsQPpmYQ7kNvwEb_7FR&_nc_oc=AdmRrr1pndvtK610tTcorFDsEwaPbSVibjmR7zEJPHR3Rht19dA2bCUhmXSUFWBD1-A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwFh6Hb6uuPoxXX-ITKzrAETAb7Hv9sQe-wQ6K27MfHqA&oe=69B003F2"}, {"file_name": "GunShot.png", "id": "1484185552249839", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974834_1484185555583172_8264876483161367463_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wGsAmBUBO80Q7kNvwEMOech&_nc_oc=Adnsdqm5Jm7ZgQvTXKBfoWHAUv2WUso7bU6PoXfpyrolJ8Y69XzhQkemTMK7P4EBhk8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzWt5YMCI1CkTnwssoDh44dvGoGQew0rfqiJ9GoHSE1tQ&oe=69B00CE1"}, {"file_name": "PunchRhythm.png", "id": "1109179657269921", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75462203_1109179660603254_5637594256277893857_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nLpHyf00lIkQ7kNvwFhYcEw&_nc_oc=Adkg_jlny0Ozhd3IRO1uVwVIf-PXmoLDiy4s0ynJXlM_HfRQb3FzVRjtwsBcGYDfXuM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzOfMzpRCLDp8n_GRmEZ-R_Y7YzZPAjZwgIWsGzdJN_PA&oe=69B02B18"}, {"file_name": "PracticeBreathing.png", "id": "587550747129538", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974635_587550750462871_1717998606930230757_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SQYwNZ8e8WEQ7kNvwEzjDec&_nc_oc=Adlli4ny8-5j1Bgx4HWUe_KhllN6ACQyknk9_UcB1k7Ro-TQpOhlxyqMLuQHb2Douhg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx_ZszXYzhQKVOJe96izOCQnr-UyL_MAwheAO8Gz8pxkQ&oe=69B01CE7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MUTT: Everything you want", "keywords": ["fitness", "rhythm", "sports", "free", "meditation"], "long_description": "Mutt is the best way to choose and play a variety of Content on one platform. \nWe have a wide range of games including sports, shooting, music, fitness, meditation, and more, and more will be added in the future. \nGet it on the Meta Store now to keep enjoying new experiences!\n\n{1303901187305557}\n# 1. Jelly Saber\n**\u201cExperience the thrill of slicing jelly with a light saber!\u201d**\n\n\nFeel the exhilarating sensation of slicing through jelly, battle against increasingly powerful waves and boss monsters, and survive the endless battles to be the last one standing.\n\n\n{573498865228346}\n# 2. Gunshot Game\n**\u201cDefeat enemies with a variety of firearms and survive the boss battle!\u201d**\n\nA thrilling experience of surviving to the end against oncoming enemies and powerful bosses. Utilize a variety of firearms to take down enemies and test the limits of your survival!\n\n\n{8754035691345594}\n# 3. Punch Rhythm\n**\u201cGet into the rhythm, enjoy the colorful combinations of your left and right hands!\u201d**\n\nFun tapping rhythm notes with interesting music! Think about the combinations of your left and right hands in the complex composition of long and single notes and ride the rhythm to the music. More music will be added in the future!\n\n\n\n{2008927669537690}\n# 4. Breathing Exercises\n**\u201cFind peace of mind with deep breathing in nature!\u201d** \n\nBreathing exercises to calm your mind and body against the backdrop of fresh nature's sights and sounds. A variety of options to calm your mind and visual and auditory effects to help you breathe. Start now for a unique experience that will lighten your heart.\n\n\n\n\n", "short_description": "All kinds of games for FREE. Sports, Shooting, Music, Fitness, Meditation, you name it, we have it."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sevenptone.com/mutt-privacy/", "developer_terms_of_service_url": null, "publisher_name": "Derick", "support_website_url": null, "website_url": "https://sevenptone.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "528142316460358"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27633874982894728"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "558182626805877"}]}, "baseline_offer": {"id": "558182626805877"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1733706420, "status": "PUBLISHED", "id": "558182626805877"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "33572522369029930", "version": "1.0"}, "id": "887977596757336", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27613669408248619", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "33572522369029930"}, "releas
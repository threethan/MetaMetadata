c_oc=AdkRNFfF7TCy9kn5o7caYkc5SMTXoAqNvMxcoQUO6UKKKnqblukk-oEawjuJeGGXC2M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsgNrgTqOS757sDxdgkedZ3dRW_MfCQoTuuYotYb4qpeg&oe=699C3A80"}, {"file_name": "JellySaber.png", "id": "417868798062254", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035417_417868801395587_1696414666942182352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-jaz2TKtWcoQ7kNvwE6QBzL&_nc_oc=AdklPWv5wHiQEpJw8KNC0EH5wi6qiqFPSExXRvjDK0YuxCFD5iHokLl_Dad3Y36AWkE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfswnzL01CXOyZjnzkp8p-qYH9y1aZX-oOxTD4GvCoihHw&oe=699C3D72"}, {"file_name": "GunShot.png", "id": "1484185552249839", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974834_1484185555583172_8264876483161367463_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d3OsCEld3KMQ7kNvwHlcE7U&_nc_oc=Admhp_LQiD6BP6FjiVczQcJG0toxvydwFQ7yGMV-loxE04LEYIpg8Ka57GFK63e0avE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aft4pWvakqyt2Fm_3qmktTR1HedlRZFiW7WEj-K0vTE-3A&oe=699C4661"}, {"file_name": "PunchRhythm.png", "id": "1109179657269921", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75462203_1109179660603254_5637594256277893857_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1_mZWf3tf88Q7kNvwHkpkrz&_nc_oc=AdlQx646e6pWywrbA-WVls_H-xvH7phOQESt0Dz-0SuQhR5vy13UeGjsuh04vL6p23Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afu5qzQRRctAo2p-24qUlhldB3cAmOu5lEAsv3HjtcYZ3w&oe=699C6498"}, {"file_name": "PracticeBreathing.png", "id": "587550747129538", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974635_587550750462871_1717998606930230757_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gzSveQIEPVAQ7kNvwH_vN3m&_nc_oc=AdmLZ05M81Fisfy6GHLtKlnywX2O3YYy-biXMMT0lw18eCq-1BOIwoV4vu6jqplde-I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftUlW9PZhRhhFo1Q6V44pF9qjvwYaI64_myLR4eAnyT-w&oe=699C5667"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MUTT: Everything you want", "keywords": ["fitness", "rhythm", "sports", "free", "meditation"], "long_description": "Mutt is the best way to choose and play a variety of Content on one platform. \nWe have a wide range of games including sports, shooting, music, fitness, meditation, and more, and more will be added in the future. \nGet it on the Meta Store now to keep enjoying new experiences!\n\n{1303901187305557}\n# 1. Jelly Saber\n**\u201cExperience the thrill of slicing jelly with a light saber!\u201d**\n\n\nFeel the exhilarating sensation of slicing through jelly, battle against increasingly powerful waves and boss monsters, and survive the endless battles to be the last one standing.\n\n\n{573498865228346}\n# 2. Gunshot Game\n**\u201cDefeat enemies with a variety of firearms and survive the boss battle!\u201d**\n\nA thrilling experience of surviving to the end against oncoming enemies and powerful bosses. Utilize a variety of firearms to take down enemies and test the limits of your survival!\n\n\n{8754035691345594}\n# 3. Punch Rhythm\n**\u201cGet into the rhythm, enjoy the colorful combinations of your left and right hands!\u201d**\n\nFun tapping rhythm notes with interesting music! Think about the combinations of your left and right hands in the complex composition of long and single notes and ride the rhythm to the music. More music will be added in the future!\n\n\n\n{2008927669537690}\n# 4. Breathing Exercises\n**\u201cFind peace of mind with deep breathing in nature!\u201d** \n\nBreathing exercises to calm your mind and body against the backdrop of fresh nature's sights and sounds. A variety of options to calm your mind and visual and auditory effects to help you breathe. Start now for a unique experience that will lighten your heart.\n\n\n\n\n", "short_description": "All kinds of games for FREE. Sports, Shooting, Music, Fitness, Meditation, you name it, we have it."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sevenptone.com/mutt-privacy/", "developer_terms_of_serv
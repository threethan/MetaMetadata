s89S8rXYRE91YzSpWfNvh0sRYAt8HmQ5pn-igH5nsgXFKd-hs6MCg6NtGdOm3Qw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Aft8tTLVqMXEfZToc_iy3VBbUKNW_bEKtbsxAFGKFux8_Q&oe=69A5A08D"}, {"file_name": "gun3.png", "id": "3072587276248220", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618093_3072587279581553_8452235450443429166_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GIe5vYarm8MQ7kNvwFVx9RQ&_nc_oc=Adll8eG1VnQyCKHa3gSTJ_soXu_WAGq5C-n_FOpoIhg3f4Gw1Ezd-laRXQI7xYY1J64&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfsYK94FqhKkFofWoup1NeJjch5EOx-GylcsofOAnd7kPg&oe=69A58ACE"}, {"file_name": "bat3.png", "id": "837829559098468", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499314634_837829562431801_142342347843413544_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VPfeHvaDApMQ7kNvwErY4Fi&_nc_oc=AdltsIE9GpwteIY2HSb5QuYrLj42HH2s4dQ6Y0ZDQXsPO_YuEtuJXE_rF3ChkVBaw_g&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AftHIHsi1sUpvR5jDGNawcA2leaeIXKZdvi78JrgN_s3pQ&oe=69A5888C"}, {"file_name": "Lobby.png", "id": "2386860311811259", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499618499_2386860315144592_4732509698311048844_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wjbfslOvzusQ7kNvwHAK30y&_nc_oc=AdkzY1qd4gUJypO40dRS9yYzI7aDHV4w4IsJ70p2Gw9jLDkHo1SaxTVliPjXU8BbXtY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfslnkGzqvIQbN5Rf4P_mnYxjEStHk7XtvwoK3CVlHx5IQ&oe=69A59582"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape(2560x1440),\uc378\ub124\uc77c.png", "id": "1513545639731719", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619832_1513545643065052_6956812012207879288_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MrmgufJ9b50Q7kNvwHN6Pm1&_nc_oc=AdndaTyFOoFFxM77oqFX5q__gx9jP8UdOKqI7HzfK8jHIjqz3TiCxaCb_MiWnN9yD18&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afst3MkSUfmCikd-3vTn4HJRrrVXyMUpFTUvKlcqjXy6Yg&oe=69A56C1E"}, "display_name": "Calorie Hunters: XR Fitness Beat Combat", "keywords": ["rhythm", "fit", "beat", "combat", "boxing"], "long_description": "# Game or Workout? The answer is both!\nWe transform exercise from 'hard pain' into an unstoppable 'Enjoyable Healthy Addiction Experience'. Join the 'Calorie Hunters' journey now and start the most fun and effective diet routine! \n\n\u2800\n\n# \ud83c\udf1f The Perfect Blend of Fun and Fitness\n\u2800\n# 1. \u2694\ufe0f Hunt the Calories,  Not the Chore! (Calorie Monster Hunting System)\n\n**1) Intuitive Goal:** \n- Exercise expenditure is set as a hunting target called' Calorie Monsters,' providing an intuitive goal and strong motivation. \n- Every move you make\u2014punches, squats, and more\u2014becomes a powerful attack dealing damage to the monsters.\n\n**2) Achievement & Competition:**\n- After completing a challenge, experience the satisfaction of ranking up on the World Leaderboards as you compete against Hunters globally.\n\n\u2800\n# 2. \ud83e\udd2f Never Boring, Always Intense! (Random Weapon System)\n**1) All-in-One VR Rhythm Action Platform:**\n- Integrates the fun elements of various VR games into rhythm notes, including not just basic movements like Punch and Squat, but also Slash, Gun Shot, and Hit.\n---\n**2) Infinite Content:** \n- Our proprietary algorithm endlessly and randomly combines weapons and rhythm notes, creating fresh, dynamic workout routines every time.\n\n\u2800\n# 3. \ud83d\uddfa\ufe0f Future Updates Planned\n'Calorie Hunters' is committed to growing with its users and continuously delivering new fun.\n- New Stages with unique themes will be regularly added.\n- Various additional content is planned, including Boss Battles, Multiplayer, and Customization.\n", "short_description": "The Start of a Healthy Addiction\n\"Fitness is NOT Pain!\"\nHunt Your Fat with the Unstoppable VR Rhythm Action, 'Calorie Hunters'!\n\nThe VR fitness revolution that will make you shout, \"Just one more set!\".\n'Calorie Hunters' maximizes the fun of VR rhythm action to transform tedious, repetitive exercise into a 'Healthy Addiction'. By hunting monsters to the exciting music beat, you\u2019ll not only achieve your diet goals but also form a consistent exercise habit."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sevenptone.com/mutt-privacy/", "developer_terms_of_service_url": null, "publisher_name": "Derick", "support_website_url": null, "website_url": "https://sevenptone.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "de", "ja", "ko", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33569444959337671"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619685_1559353675120619_561145763113312566_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ihgAVeFopUQ7kNvwF62OCY&_nc_oc=AdmiRFLvw2ImXul2fWch9-kpMZ_djPlG1SbQkomFFEXa9f5z9FUpJzo3h5uIN-ehtKE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfsbB1eFhBdEFpPuGOvkGLfgWFXQ5xBQlUuuYrHWD2K5Cw&oe=69A57F18"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Calorie Hunters: XR Fitness Beat Combat", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}, {"topic_name": "Sports", "id": "2776542286000603"}], "release_
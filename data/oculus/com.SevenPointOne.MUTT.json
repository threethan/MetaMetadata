3_6199134857996195084_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zkKpfC1ZjqMQ7kNvwH30eCP&_nc_oc=AdqX9ZbdqlIrcLkBU3q_eQ4OOfULiagMP94bI44-Nd2tV9hkOxbeJ_qC-pQ6XHRM78c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af359O18SgaC3xoS6T_nftkRkJOfEooOFOny_styd3tySw&oe=69F76897"}, {"file_name": "bat3.png", "id": "1939742573419298", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618252_1939742576752631_3680283499027809012_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aO7wiAcK8x4Q7kNvwFgyZrf&_nc_oc=AdpGQHGfpjFeo2F71cOZfOZu-EjUGP4lf6sGowl8tzDogYIOrNLOQ187fcvO_Tg18bY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2ieku5-2ofWPBpx-DyuqsKlUZUq0Z4AO3OAIP1GritPQ&oe=69F742AC"}, {"file_name": "Lobby.png", "id": "1640215737324424", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619159_1640215740657757_3461911139243951464_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vjM099rt1fsQ7kNvwHUtESz&_nc_oc=AdpdBZpvhzsWJ1ULLSPSoxLcqEnSGiwqa9_RCx9lo9BDB3kG_xLKhLsJ10nzH2cES-c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3QOG7td5L0vfny9alkcojngVpteqUeEkQFTeI92e3lYw&oe=69F74A86"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape(2560x1440),\uc378\ub124\uc77c.png", "id": "927464526289287", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619805_927464529622620_2532537465503294330_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e3vE1YQp_QUQ7kNvwECdGIB&_nc_oc=AdoMUIHN5s6Ry8wHY7CsNsoQA6BxNE0xjRuRnS8MVESYH4oXgLZXIvofCkV4e0GwuPU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0lLXLBHWnn90gEQt6l74fiGXt0vMQg8KZx8z80PIp2Kw&oe=69F73C01"}, "display_name": "\uce7c\ub85c\ub9ac \ud5cc\ud130\uc2a4: XR Fitness Beat Combat", "keywords": ["combat", "beat", "fit", "rhythm", "boxing"], "long_description": "# Game or Workout? \uc815\ub2f5\uc740 \ub458 \ub2e4\uc785\ub2c8\ub2e4! \n\uc6b4\ub3d9\uc744 '\ud798\ub4e0 \uace0\ud1b5'\uc774 \uc544\ub2cc, \uba48\ucd9c \uc218 \uc5c6\ub294 '\uc990\uac70\uc6b4 \uac74\uac15\ud55c \uc911\ub3c5 \uacbd\ud5d8'\uc73c\ub85c \ubc14\uafc9\ub2c8\ub2e4. \uc9c0\uae08 \ubc14\ub85c '\uce7c\ub85c\ub9ac \ud5cc\ud130\uc2a4'\uc758 \uc5ec\uc815\uc5d0 \ub3d9\ucc38\ud558\uc5ec, \uac00\uc7a5 \uc7ac\ubc0c\uace0 \ud6a8\uacfc\uc801\uc778 \ub2e4\uc774\uc5b4\ud2b8 \uc2b5\uad00\uc744 \uc2dc\uc791\ud558\uc138\uc694!\n\n\u2800\n\n# \ud83c\udf1f \uce7c\ub85c\ub9ac \ud5cc\ud130\uc2a4\uc758 \ud2b9\ubcc4\ud568: \uc7ac\ubbf8\uc640 \uc6b4\ub3d9 \ud6a8\uacfc\uc758 \uc644\ubcbd\ud55c \uc870\ud654\n\u2800\n# 1. \u2694\ufe0f Hunt the Calories, Not the Chore! (\uce7c\ub85c\ub9ac \ubaac\uc2a4\ud130 \ud5cc\ud305 \uc2dc\uc2a4\ud15c)\n\n**1) \uc9c1\uad00\uc801\uc778 \ubaa9\ud45c:** \n- \uc6b4\ub3d9 \uc18c\ubaa8\ub7c9\uc744 '\uce7c\ub85c\ub9ac \ubaac\uc2a4\ud130'\ub77c\ub294 \uc0ac\ub0e5 \ub300\uc0c1\uc73c\ub85c \uc124\uc815\ud558\uc5ec \uc9c1\uad00\uc801\uc778 \ubaa9\ud45c\ub97c \uc81c\uc2dc\ud558\uace0 \uac15\ub825\ud55c \ub3d9\uae30\ub97c \ubd80\uc5ec\ud569\ub2c8\ub2e4.\n- \ud380\uce58, \uc2a4\ucffc\ud2b8 \ub4f1 \ub2f9\uc2e0\uc758 \ubaa8\ub4e0 \ub3d9\uc791\uc774 \ubaac\uc2a4\ud130\uc5d0\uac8c \ub370\ubbf8\uc9c0\ub97c \uc785\ud788\ub294 \uac15\ub825\ud55c \uacf5\uaca9\uc774 \ub429\ub2c8\ub2e4.\n\n**2) \uc131\ucde8\uac10 & \uacbd\uc7c1:**\n- \ucc4c\ub9b0\uc9c0 \uc644\ub8cc \ud6c4, \uc804 \uc138\uacc4 \ud5cc\ud130\ub4e4\uacfc \uc810\uc218\ub97c \uacbd\uc7c1\ud558\uba70 \uc6d4\ub4dc \ub7ad\ud0b9\uc5d0 \uc774\ub984\uc744 \uc62c\ub9ac\ub294 \uc131\ucde8\uac10\uc744 \uacbd\ud5d8\ud558\uc138\uc694.\n\n\u2800\n# 2. \ud83e\udd2f Never Boring, Always Intense! (\ub79c\ub364 \ubb34\uae30 \uc2dc\uc2a4\ud15c)\n**1) \uc885\ud569 VR \ub9ac\ub4ec \uc561\uc158 \ud50c\ub7ab\ud3fc:**\n- \ud380\uce58, \uc2a4\ucffc\ud2b8 \uac19\uc740 \uae30\ubcf8 \ub3d9\uc791\uc740 \ubb3c\ub860, \uce7c \ubca0\uae30(Slash), \ucd1d\uc3d8\uae30(Gun Shot), \ud0c0\uaca9(Hit) \ub4f1 \ub2e4\uc591\ud55c VR \uac8c\uc784\uc758 \uc7ac\ubbf8 \uc694\uc18c\ub97c \ub9ac\ub4ec \ub178\ud2b8\ub85c \ud1b5\ud569\ud588\uc2b5\ub2c8\ub2e4.\n---\n**2) \ubb34\ud55c \ucf58\ud150\uce20:** \n- \uc790\uccb4 \uac1c\ubc1c \uc54c\uace0\ub9ac\uc998\uc774 \ubb34\uae30\uc640 \ub9ac\ub4ec \ub178\ud2b8\ub97c \uc26c\uc9c0 \uc54a\uace0 \ub79c\ub364\ud558\uac8c \uc870\ud569\ud558\uc5ec, \ub9e4\ubc88 \uc0c8\ub86d\uace0 \uc5ed\ub3d9\uc801\uc778 \uc6b4\ub3d9 \ub8e8\ud2f4\uc744 \uc0dd\uc131\ud569\ub2c8\ub2e4.\n\n\u2800\n# 3. \ud83d\uddfa\ufe0f \uc9c0\uc18d\uc801\uc778 \ud655\uc7a5 (\ud5a5\ud6c4 \uc5c5\ub370\uc774\ud2b8 \uc608\uc815)\n'\uce7c\ub85c\ub9ac \ud5cc\ud130\uc2a4'\ub294 \uc720\uc800\uc640 \ud568\uaed8 \uc131\uc7a5\ud558\uba70 \ub04a\uc784\uc5c6\uc774 \uc0c8\ub85c\uc6b4 \uc7ac\ubbf8\ub97c \uc81c\uacf5\ud560 \uac83\uc785\ub2c8\ub2e4.\n- \uace0\uc720\uc758 \ud14c\ub9c8\ub97c \uac00\uc9c4 \uc0c8\ub85c\uc6b4 \uc2a4\ud14c\uc774\uc9c0\uac00 \uc9c0\uc18d\uc801\uc73c\ub85c \ucd94\uac00\ub429\ub2c8\ub2e4.\n- \ubcf4\uc2a4 \uc804\ud22c, \uba40\ud2f0\ud50c\ub808\uc774, \uafb8\ubbf8\uae30 \ub4f1 \ub2e4\uc591\ud55c \ucd94\uac00 \ucf58\ud150\uce20\uac00 \uacc4\ud68d\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4.", "short_description": "\uac74\uac15\ud55c \uc911\ub3c5\uc758 \uc2dc\uc791:  \uc6b4\ub3d9\uc740 \uace0\ud1b5\uc774 \uc544\ub2c8\ub2e4!\n\uba48\ucd9c \uc218 \uc5c6\ub294 VR \ub9ac\ub4ec \uc561\uc158, '\uce7c\ub85c\ub9ac \ud5cc\ud130\uc2a4'\ub85c \uc9c0\ubc29\uc744 \uc0ac\ub0e5\ud558\uc138\uc694!\n\n\n\"\ub531 \ud55c \uc138\ud2b8\ub9cc \ub354!\"\ub97c \uc678\uce58\uac8c \ub9cc\ub4dc\ub294 VR \ud53c\ud2b8\ub2c8\uc2a4 \ud601\uba85.\n'\uce7c\ub85c\ub9ac \ud5cc\ud130\uc2a4'\ub294 VR \ub9ac\ub4ec \uc561\uc158 \uac8c\uc784\uc758 \uc7ac\ubbf8\ub97c \uadf9\ub300\ud654\ud558\uc5ec \uc9c0\ub8e8\ud55c \ubc18\ubcf5 \uc6b4\ub3d9\uc744 '\uac74\uac15\ud55c \uc911\ub3c5(Healthy Addiction)'\uc73c\ub85c \ubc14\uafc9\ub2c8\ub2e4.\n\uc2e0\ub098\ub294 \uc74c\uc545 \ube44\ud2b8\uc5d0 \ub9de\ucdb0 \ubaac\uc2a4\ud130\ub97c \uc0ac\ub0e5\ud558\ub2e4 \ubcf4\uba74 , \uc5b4\ub290\uc0c8 \ub2e4\uc774\uc5b4\ud2b8 \ud6a8\uacfc\uc640 \uc6b4\ub3d9 \uc2b5\uad00\uae4c\uc9c0 \uc5bb\uac8c \ub420 \uac83\uc785\ub2c8\ub2e4."}, {"images": {"nodes": [{"file_name": "CoverSquare(1440x1440),\uc378\ub124\uc77c\uc5d0 \ub4e4\uc5b4\uac00\ub294 \uc694\uc18c\ub97c \uc815\uc0ac\uac01\ud615\uc5d0 \ub9de\ucdb0\uc11c.png", "id": "1559353668453953", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619685_1559353675120619_561145763113312566_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ORMCqOfs5cQ7kNvwEMHWJC&_nc_oc=AdqigRQDi8wd3b9S9UGYsZ3guVMafDO1nWcG906H0Pf0e0RQjTt1CAvMc4JUlCnSX6Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3ffxcyrkOuhgFZFOfvi8eV7GvVyI66piLjZ7d0Ybep3g&oe=69F73C18"}, {"file_name": "HeroCover(3000x900),\uc2a4\ud1a0\uc5b4\uc5d0\uc11c \uc5b4\ud50c \ub20c\ub7ec\uc11c \ub4e4\uc5b4\uac00\uba74 \ubcf4\uc774\ub294 \uc774\ubbf8\uc9c0.png", "id": "1344269564121254", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499624983_1344269567454587_7897082315544632085_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b_Fo-6STnMYQ7kNvwHX8W_G&_nc_oc=AdoQj2ft0fCixFEN7WaCS-mBZ-G77DGbc3Y_-8p3TwLiKuvuL-VWHY8o_XygDcpu_wY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af06cRX2_SkYN1PX0wNZ3xR4-TFKGNxeh9zMTmLVpugDEQ&oe=69F7683B"}, {"file_name": "CoverPortrait(1008x1440),\uc694\uc18c \uc138\ub85c\ubc84\uc804.png", "id": "1263808342254390", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622276_1263808348921056_543666823004791702_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jRT1FW9ftUYQ7kNvwEDZeNq&_nc_oc=AdrR-_a-6c3dMy16Sng6mkLG1vrF_vv4fqFqQNOBs_6JHvAIqAdlm11LQYPlEfge2f0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3AtM5IycbQ2JqYeDXQbmh1JfJhqK2HEe6-PoclLq1Tuw&oe=69F754A6"}, {"file_name": "CoverLandscape(2560x1440),\uc378\ub124\uc77c.png", "id": "1239160361607411", "image_type": "APP_IMG_COVER
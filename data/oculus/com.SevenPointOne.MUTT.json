_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f32BJfO5whwQ7kNvwHqyM21&_nc_oc=AdrZmbhIqEdP26oOJ1PG5MZjGOmYeRSvehgmQ3v0jefrz36_fWj1NpYcJxa8kr3qt6U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBleeuDhnssgi793HIYFr0Z7XG6DpMHRpVLzeyEKhwlbg&oe=6A637FEF"}, {"file_name": "bat.png", "id": "1662831244964261", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622334_1662831248297594_547601879803341137_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OjIrLaXXER0Q7kNvwEnUnbc&_nc_oc=AdrM35gIXUDFlbRbtTyjlhmqHLG0DhX8ygbt2McC0ttsBK32DxsRj5mCYu_QfMrOWtM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAuacslFGxidUAmLx2HvQp1-2Lc4W2iDqfuXXH-JSqGww&oe=6A63530B"}, {"file_name": "gun1.png", "id": "1701141757903683", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/613057330_1701141761237016_2057678754440633945_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TO3BgX8P8RMQ7kNvwEwJK-h&_nc_oc=AdrAY6xrVO29PLFEqv8cmP3SsGDsDkmMPq2SamhnZ0zrST7YEjmnENqVjbxOjpRQ1f4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhRpjBgutLw32sDgZZD7jlS5rRTI_rGvvnhqtrnAbXiQ&oe=6A635493"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape(2560x1440),\uc11c\ube0c\uc378\ub124\uc77c.png", "id": "1693642975385127", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/654944867_1693642978718460_2608461543012234797_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TKFsM5OxrwcQ7kNvwG_5ulB&_nc_oc=Ado8pFCvtTK3WtD3iE1M6cHcN-uaaGKOMiS7eK-rfJQo7sGb-FHf6QVCPp6cW0BU46U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCoDBD5buIOwIFG-RwTEJKQc60BCTv5GL8QvCeqK2iNtg&oe=6A63630A"}, "display_name": "Calorie Hunters: XR Fitness Beat Combat", "keywords": ["rhythm", "beat", "combat", "boxing", "fitness"], "long_description": "# \"Just One More Set!\"\n\nEver had that \"just one more game\" urge \u2014 for your workout?\nPunch, slash, shoot to the beat. You'll be hitting play on the next track in no time.\n\nForget willpower.\nStep into 'Calorie Hunters' \u2014 the most enjoyable healthy addiction in VR rhythm action.\n\n\u2800\n\n# \ud83c\udf1f Where Fun Meets Real Fitness\n\u2800\n# 1. \u2694\ufe0f Hunt the Calories, Not the Chore!\n- Calories appear as Monsters \u2014 real prey, not abstract numbers.\n- Every punch, squat, slash, and shot lands a powerful blow.\n- Clear a round and climb the Global Leaderboards against Hunters worldwide\n\n\u2800\n# 2. \ud83e\udd2f Never Boring, Always Fresh!\n- All VR rhythm action fun \u2014 punch, slash, shoot, smash \u2014 in one session.\n- Our algorithm mixes weapons and notes randomly every time. No two routines alike.\n- Workout burnout? Not anymore\n\n\u2800\n# 3. \ud83c\udd95 NEW in This Update!\n- \ud83d\udc09 **Boss Battles** \u2014 A true challenger for Hunters who've outgrown ordinary prey. The Boss summons Rhythm Monsters \u2014 hunt them down to strike the Boss itself. Defeat it and claim your bounty.\n- \ud83e\udd1d **Supporter System** \u2014 Spend the Gold you earn hunting to build your own Supporter dance team. They'll cheer you on with adorable dance moves while your allies bring unique abilities and grow stronger with every rank-up. Who you hunt with is your new strategy.\n\n\u2800\n# 4. \ud83d\uddfa\ufe0f What's Coming Next\n'Calorie Hunters' grows with its players. This is just the beginning.\n- New themed stages added regularly.\n- Multiplayer and more co-op content on the way.\n- A deeper, richer 'one more set' is always waiting for you.", "short_description": "The Start of a Healthy Addiction\n\"Fitness is NOT Pain!\"\nHunt Your Fat with the Unstoppable VR Rhythm Action, 'Calorie Hunters'!\n\nThe VR fitness revolution that will make you shout, \"Just one more set!\".\n'Calorie Hunters' maximizes the fun of VR rhythm action to transform tedious, repetitive exercise into a 'Healthy Addiction'. By hunting monsters to the exciting music beat, you\u2019ll not only achieve your diet goals but also form a consistent exercise habit."}, {"images": {"nodes": [{"file_name": "CoverLandscape(2560x1440),\uc378\ub124\uc77c.png", "id": "35824301873852305", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620860_35824301900518969_8677363824331430839_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pFAiPt9rYxgQ7kNvwECFlpv&_nc_oc=AdrvyL9MZVNijTIoMCV91fzJx3pHK_rBv40fECzv7TZQaXiHI-YwTV8L-cLhpry6aE8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCiqWBpZ1bbe5XtE_xOofWGxrkpsM_dr7MTffSv74_tNQ&oe=6A637230"}, {"file_name": "HeroCover(3000x900),\uc2a4\ud1a0\uc5b4\uc5d0\uc11c \uc5b4\ud50c \ub20c\ub7ec\uc11c \ub4e4\uc5b4\uac00\uba74 \ubcf4\uc774\ub294 \uc774\ubbf8\uc9c0.png", "id": "2020004012224205", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/595136811_2020004018890871_280394800797697319_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XbUVJo1odL4Q7kNvwHqd3DW&_nc_oc=AdpSTUFPvP2HpqQMbhwizzES2hj9ehFJwVoZ5poPjCjKx4bXrOQLEn7lel6KgVuLRL4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBYArY8_2imevVXx0ZqDLulIBoCHAICfn0U35Y9-029JQ&oe=6A63596D"}, {"file_name": "CoverSquare(1440x1440),\uc378\ub124\uc77c\uc5d0 \ub4e4\uc5b4\uac00\ub294 \uc694\uc18c\ub97c \uc815\uc0ac\uac01\ud615\uc5d0 \ub9de\ucdb0\uc11c.png", "id": "1387374113425660", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/596157734_1387374116758993_580513561534275019_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_VZ3NWo29YkQ7kNvwHUeACw&_nc_oc=AdqidJG9MAGW8nZ4wRyFUTikK7_BlRHwioTTnrgwy0h6KzEQqnBEa7nPNCZqLb1kWBU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCTjHkGLudO17aXzJBf1TuWkAYRKRVs0tXVJtLlyHHcJQ&oe=6A635671"}, {"file_name": "CoverPortrait(1008x1440),\uc694\uc18c \uc138\ub85c\ubc84\uc804.png", "id": "1355972336579200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623314_
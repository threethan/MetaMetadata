cBN-a_JM-q9M-c0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHDcAFRd9joSNMsz4yMbj-wfisCg9uA1AK0jd4ypoKaA&oe=6AB2A54B"}, {"file_name": "gun1.png", "id": "1701141757903683", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/613057330_1701141761237016_2057678754440633945_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=chsZNNeMMyIQ7kNvwE_zpnQ&_nc_oc=Adr9pUsrUgmq63mu6Rbl_cVu-WaovHHilJIkvVElc67mc-K3DjFt3RdsoKoDJR0MuXo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLVgAkx-zOgHxPTHn1SmOGUy9rrntUeYI0s8Xjybk2gJQ&oe=6AB2A6D3"}, {"file_name": "lobby.png", "id": "844396791563245", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/604275479_844396794896578_4553122631057590950_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xo1PXt04vdcQ7kNvwGP1z2W&_nc_oc=Adqk-rq7SPI2Nt4K5GwSKckU4cKpSKpksNU4VKzTbo9VdWH1LmUXZuaoD3JfcClb7WY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI6ir6gd_6wYxVXqx6sTId0zTc2LIYKTXyem1DPjS7TMQ&oe=6AB28D6F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape(2560x1440),\uc378\ub124\uc77c.png", "id": "1755566859091507", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622188_1755566862424840_594230336198285518_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=irw1xFikJ1gQ7kNvwE1rtJW&_nc_oc=AdrKFvnrS9ljq3dN4itAKSfEe0tsSWlRm_t4UbHOlXT_WVc6beufyRkK1Y3HuOm81kA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJAazVZn6gOAu3JV2hr6901Oz4NuuPZDT0caANUYlJd5A&oe=6AB280C9"}, "display_name": "Calorie Hunters: XR Fitness Beat Combat", "keywords": ["rhythm", "beat", "combat", "boxing", "fitness"], "long_description": "# \"Just One More Set!\"\n\nEver had that \"just one more game\" urge \u2014 for your workout?\nPunch, slash, shoot to the beat. You'll be hitting play on the next track in no time.\n\nForget willpower.\nStep into 'Calorie Hunters' \u2014 the most enjoyable healthy addiction in VR rhythm action.\n\n\u2800\n\n# \ud83c\udf1f Where Fun Meets Real Fitness\n\u2800\n# 1. \u2694\ufe0f Hunt the Calories, Not the Chore!\n- Calories appear as Monsters \u2014 real prey, not abstract numbers.\n- Every punch, squat, slash, and shot lands a powerful blow.\n- Clear a round and climb the Global Leaderboards against Hunters worldwide\n\n\u2800\n# 2. \ud83e\udd2f Never Boring, Always Fresh!\n- All VR rhythm action fun \u2014 punch, slash, shoot, smash \u2014 in one session.\n- Our algorithm mixes weapons and notes randomly every time. No two routines alike.\n- Workout burnout? Not anymore\n\n\u2800\n# 3. \ud83c\udd95 NEW in This Update!\n- \ud83d\udc09 **Boss Battles** \u2014 A true challenger for Hunters who've outgrown ordinary prey. The Boss summons Rhythm Monsters \u2014 hunt them down to strike the Boss itself. Defeat it and claim your bounty.\n- \ud83e\udd1d **Supporter System** \u2014 Spend the Gold you earn hunting to build your own Supporter dance team. They'll cheer you on with adorable dance moves while your allies bring unique abilities and grow stronger with every rank-up. Who you hunt with is your new strategy.\n\n\u2800\n# 4. \ud83d\uddfa\ufe0f What's Coming Next\n'Calorie Hunters' grows with its players. This is just the beginning.\n- New themed stages added regularly.\n- Multiplayer and more co-op content on the way.\n- A deeper, richer 'one more set' is always waiting for you.", "short_description": "The Start of a Healthy Addiction\n\"Fitness is NOT Pain!\"\nHunt Your Fat with the Unstoppable VR Rhythm Action, 'Calorie Hunters'!\n\nThe VR fitness revolution that will make you shout, \"Just one more set!\".\n'Calorie Hunters' maximizes the fun of VR rhythm action to transform tedious, repetitive exercise into a 'Healthy Addiction'. By hunting monsters to the exciting music beat, you\u2019ll not only achieve your diet goals but also form a consistent exercise habit."}, {"images": {"nodes": [{"file_name": "CoverSquare(1440x1440),\uc378\ub124\uc77c\uc5d0 \ub4e4\uc5b4\uac00\ub294 \uc694\uc18c\ub97c \uc815\uc0ac\uac01\ud615\uc5d0 \ub9de\ucdb0\uc11c.png", "id": "1984082902291098", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499623534_1984082905624431_5653267256921169664_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DA-XVoCNLAwQ7kNvwEyZKGR&_nc_oc=AdoYHSZ3I_l-8-S8vb-fz6W3XiUgODdJYJOdcm6YysFqw525F2fMYZdfnyjD4L1feog&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYfqB1ToFGvsNSPQBbnW99CWTRq_S_26dpBvXzPx7HCw&oe=6AB297BA"}, {"file_name": "Logo(Transparent).png", "id": "1771494364195456", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619404_1771494370862122_7957116351418805276_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vcRL63MtL6gQ7kNvwE16LXW&_nc_oc=AdobvQCGDci4mZNF6pMkFwxW5C2PZPeJfPTwxBrsGV6jz6y2PZGBR9ucBsj8D5OK6mw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJwmYikP_VVw3nbDUPo2WyssHYqR0IzXtWLwm_ZAKbSEg&oe=6AB29394"}, {"file_name": "HeroCover(3000x900),\uc2a4\ud1a0\uc5b4\uc5d0\uc11c \uc5b4\ud50c \ub20c\ub7ec\uc11c \ub4e4\uc5b4\uac00\uba74 \ubcf4\uc774\ub294 \uc774\ubbf8\uc9c0.png", "id": "1613872473743039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/593839439_1613872477076372_6479563604376765610_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u0E7M5QLPsAQ7kNvwGy1--y&_nc_oc=Adrbe8QsZyiQyXG5aZZ6lLogMC7UjZWaMLLmCyil2O_0svsVs4X9BB5Dxv9Okdy9rLw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnRbcg6o-J6lFZJUl3_TAWOZPhRcmgn3k7ZLHDW7ZWvg&oe=6AB29B99"}, {"file_name": "CoverPortrait(1008x1440),\uc694\uc18c \uc138\ub85c\ubc84\uc804.png", "id": "1607601111040163", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620341_1607601114373496_6649803988780202206_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QdmqsqiF_2EQ7kNvwHH0O85&_nc_oc=AdqQUPkNox9-n_qAVs4zo4-iFbk3T_HBH3SvbVQ3QJfVp3P98UTmOS
5/39035417_417868801395587_1696414666942182352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cdg_YaNkvxsQ7kNvwE5wk5U&_nc_oc=Adr-MjiePXUSiPmPJ2X89WJSCn2hxoBiApck4dgwVDvJ9nDgSbpdhg9MZGeeMRMj-RU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Tfw8dfIfqW6ZNDjw4X1aEWFULSUW9KCBTosfCV902gw&oe=6A3AA9B2"}, {"file_name": "GunShot.png", "id": "1484185552249839", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974834_1484185555583172_8264876483161367463_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4iDb08nPnGkQ7kNvwFr0-qD&_nc_oc=AdrzzZXjD0ipK-1uN7jOhQ5PsFw7RNmKdLw1TZhRcpu_tgYnL0XaoFf34z1fDQmRY0I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_uMc84anjuIw1COcOqLV7ZORAHQAWf9fi8p4H-bry6Q&oe=6A3AB2A1"}, {"file_name": "PunchRhythm.png", "id": "1109179657269921", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75462203_1109179660603254_5637594256277893857_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ko4mBr183AEQ7kNvwHB2IrZ&_nc_oc=AdolMoGoV8u5xu6AwzgcCKu6GOY7_1XmkZE3aJ2HOCL7d--pNFry9SvONd8OgpvuDN4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-k8EZg3cp1nZlaeqBjpwliR2fV-0He3yiBa2b8vmRKOQ&oe=6A3A9898"}, {"file_name": "PracticeBreathing.png", "id": "587550747129538", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974635_587550750462871_1717998606930230757_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c-fCobT2stkQ7kNvwFwKDCi&_nc_oc=AdoNvF0cNgzNvsutV1ep6S1M5KCUKvqPqJHvXaGvbUdS3RIXRPY85TVlILHWlkKP8yw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8qdlEZwGkiaOluEBzBZFbVG67plkygZ5mUOiOAy0tdjg&oe=6A3A8A67"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MUTT: Everything you want", "keywords": ["fitness", "rhythm", "sports", "free", "meditation"], "long_description": "Mutt is the best way to choose and play a variety of Content on one platform. \nWe have a wide range of games including sports, shooting, music, fitness, meditation, and more, and more will be added in the future. \nGet it on the Meta Store now to keep enjoying new experiences!\n\n{1303901187305557}\n# 1. Jelly Saber\n**\u201cExperience the thrill of slicing jelly with a light saber!\u201d**\n\n\nFeel the exhilarating sensation of slicing through jelly, battle against increasingly powerful waves and boss monsters, and survive the endless battles to be the last one standing.\n\n\n{573498865228346}\n# 2. Gunshot Game\n**\u201cDefeat enemies with a variety of firearms and survive the boss battle!\u201d**\n\nA thrilling experience of surviving to the end against oncoming enemies and powerful bosses. Utilize a variety of firearms to take down enemies and test the limits of your survival!\n\n\n{8754035691345594}\n# 3. Punch Rhythm\n**\u201cGet into the rhythm, enjoy the colorful combinations of your left and right hands!\u201d**\n\nFun tapping rhythm notes with interesting music! Think about the combinations of your left and right hands in the complex composition of long and single notes and ride the rhythm to the music. More music will be added in the future!\n\n\n\n{2008927669537690}\n# 4. Breathing Exercises\n**\u201cFind peace of mind with deep breathing in nature!\u201d** \n\nBreathing exercises to calm your mind and body against the backdrop of fresh nature's sights and sounds. A variety of options to calm your mind and visual and auditory effects to help you breathe. Start now for a unique experience that will lighten your heart.\n\n\n\n\n", "short_description": "All kinds of games for FREE. Sports, Shooting, Music, Fitness, Meditation, you name it, we have it."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sevenptone.com/mutt-privacy/", "developer_terms_of_service_url": null, "publisher_name": "Derick", "support_website_url": null, "website_url": "https://sevenptone.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context
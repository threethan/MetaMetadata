74_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jXmW0vutBQcQ7kNvwHZI6Yx&_nc_oc=AdqlsW-PnU9bZgVbqat8-1cubw4hP-JxULk6yIgN12Kt5W9u1G_f5BlgSquMDEQl_xM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpHl0GlXtqsqertHmQa77Zx-xuGodu6ojoVio871KXNg&oe=6A858EAF"}, {"file_name": "bat.png", "id": "1662831244964261", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499622334_1662831248297594_547601879803341137_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b2MF52HAm2YQ7kNvwGL-FHz&_nc_oc=AdozEPKtbc7vryfnrHQt-8GlCR4BLaDZoF6SNTahsx1Et9VdFz1J8MhXiS2vYlT9C0w&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOMVWLoKm6BjEtURfyHKiTqIJ2ZFT18a7tm1AMEdNcsw&oe=6A859A0B"}, {"file_name": "gun1.png", "id": "1701141757903683", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/613057330_1701141761237016_2057678754440633945_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=22rIk_pF57gQ7kNvwFBKBIo&_nc_oc=AdpbKmnIOF5BLw9rryBVtzHFW0w0pDfnrWI8tFNPv5pyJ1x6FWj0N8P_JNMbPb5XsGI&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGKv1jihDV28WtJrM_HbWbDsTpPODqj2vWKjHQvoCEyBg&oe=6A859B93"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape(2560x1440),\uc11c\ube0c\uc378\ub124\uc77c.png", "id": "1693642975385127", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/654944867_1693642978718460_2608461543012234797_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nvbfNxq0wSkQ7kNvwGTMoqV&_nc_oc=AdqHWkEAhMyP-tD5H9ElcYBuSXQ0k6tob7mC-tLgRQAC_lQhsSajlDV9pAtJTnfQH0M&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFD4sDsk5dUikVgzmunrWfI0ebVo9-LHMxYyikeN7VbOg&oe=6A85AA0A"}, "display_name": "Calorie Hunters: XR Fitness Beat Combat", "keywords": ["rhythm", "beat", "combat", "boxing", "fitness"], "long_description": "# \"Just One More Set!\"\n\nEver had that \"just one more game\" urge \u2014 for your workout?\nPunch, slash, shoot to the beat. You'll be hitting play on the next track in no time.\n\nForget willpower.\nStep into 'Calorie Hunters' \u2014 the most enjoyable healthy addiction in VR rhythm action.\n\n\u2800\n\n# \ud83c\udf1f Where Fun Meets Real Fitness\n\u2800\n# 1. \u2694\ufe0f Hunt the Calories, Not the Chore!\n- Calories appear as Monsters \u2014 real prey, not abstract numbers.\n- Every punch, squat, slash, and shot lands a powerful blow.\n- Clear a round and climb the Global Leaderboards against Hunters worldwide\n\n\u2800\n# 2. \ud83e\udd2f Never Boring, Always Fresh!\n- All VR rhythm action fun \u2014 punch, slash, shoot, smash \u2014 in one session.\n- Our algorithm mixes weapons and notes randomly every time. No two routines alike.\n- Workout burnout? Not anymore\n\n\u2800\n# 3. \ud83c\udd95 NEW in This Update!\n- \ud83d\udc09 **Boss Battles** \u2014 A true challenger for Hunters who've outgrown ordinary prey. The Boss summons Rhythm Monsters \u2014 hunt them down to strike the Boss itself. Defeat it and claim your bounty.\n- \ud83e\udd1d **Supporter System** \u2014 Spend the Gold you earn hunting to build your own Supporter dance team. They'll cheer you on with adorable dance moves while your allies bring unique abilities and grow stronger with every rank-up. Who you hunt with is your new strategy.\n\n\u2800\n# 4. \ud83d\uddfa\ufe0f What's Coming Next\n'Calorie Hunters' grows with its players. This is just the beginning.\n- New themed stages added regularly.\n- Multiplayer and more co-op content on the way.\n- A deeper, richer 'one more set' is always waiting for you.", "short_description": "The Start of a Healthy Addiction\n\"Fitness is NOT Pain!\"\nHunt Your Fat with the Unstoppable VR Rhythm Action, 'Calorie Hunters'!\n\nThe VR fitness revolution that will make you shout, \"Just one more set!\".\n'Calorie Hunters' maximizes the fun of VR rhythm action to transform tedious, repetitive exercise into a 'Healthy Addiction'. By hunting monsters to the exciting music beat, you\u2019ll not only achieve your diet goals but also form a consistent exercise habit."}, {"images": {"nodes": [{"file_name": "CoverLandscape(2560x1440),\uc378\ub124\uc77c.png", "id": "35824301873852305", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499620860_35824301900518969_8677363824331430839_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gDn_baUKmf4Q7kNvwFbhLnG&_nc_oc=Ado5EBdyupNROqdVjuhjIyVuQBHUx4XGKoXJwlF4AM3kX09tVjs0L5Uo39UpFUeUKo8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEUusakKMyL3EWdBNWFOXNz9h7BemUNtaCFGRTV5XXLlQ&oe=6A8580F0"}, {"file_name": "HeroCover(3000x900),\uc2a4\ud1a0\uc5b4\uc5d0\uc11c \uc5b4\ud50c \ub20c\ub7ec\uc11c \ub4e4\uc5b4\uac00\uba74 \ubcf4\uc774\ub294 \uc774\ubbf8\uc9c0.png", "id": "2020004012224205", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/595136811_2020004018890871_280394800797697319_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3DS-7agG0ggQ7kNvwHbv_07&_nc_oc=Adraz_eKpYd7Ij4SOnDI-tn9dWG15Zdjr-46-6wt2qBniEM33h2YM8uhWAH0fdBBWWA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQECRe6aWR-IMXwqj-ZEcwy3z4urgc3QFrGBemulpjBNGQ&oe=6A85A06D"}, {"file_name": "CoverSquare(1440x1440),\uc378\ub124\uc77c\uc5d0 \ub4e4\uc5b4\uac00\ub294 \uc694\uc18c\ub97c \uc815\uc0ac\uac01\ud615\uc5d0 \ub9de\ucdb0\uc11c.png", "id": "1387374113425660", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/596157734_1387374116758993_580513561534275019_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S1XNRTNEAPoQ7kNvwEnn9Y6&_nc_oc=Adrw4b6ddUnOjayoDiHwKJ5nsHZj7Nv7bfqyaONqiQt-dwseSCUVSxtuWXYYfQ-6DoM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_RaU_3EW_LQDDPhwkIgL9AOimHdeGpfNzhnc3Vo2e8g&oe=6A859D71"}, {"file_name": "CoverPortrait(1008x1440),\uc694\uc18c \uc138\ub85c\ubc84\uc804.png", "id": "1355972336579200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/
01.00_06_25_27.Still020.png", "id": "1915041695713082", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499618442_1915041699046415_6060115573222419024_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xB3TVIkkNeMQ7kNvwEe5O7v&_nc_oc=AdqOHmH5zvW1czJcJw-SMw4uJrnsbD3-zJNnCAb_WZAmqnPCCd28ik9xcxkPs2BCiLc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2wn-l_2Jt6nE4fXlbSh5sH-vNIJL19V2h_GYOvv2Tidg&oe=69F3690D"}, {"file_name": "gun3.png", "id": "3072587276248220", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499618093_3072587279581553_8452235450443429166_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eUkExMY1Y0gQ7kNvwEegV7E&_nc_oc=AdryA7AurDoFyQaRTxb8t87WzxPBA6SzuExlBzOx2E0NYwcy_lPRwl-mfk8u545q_P8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3nwpXwQOG9TuRlR1mpy9vQOWux5o-7zePXVjuQh-sg4A&oe=69F3534E"}, {"file_name": "bat3.png", "id": "837829559098468", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499314634_837829562431801_142342347843413544_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v12eGQGpCh8Q7kNvwH8h5bG&_nc_oc=Adr6M-GvId0dNlRUgUrOEmBcrd13QKDLH20mOFGeuQolgu4pgQ7LGl8mLaQw4MmPvCg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0feD4Y0x-IHxJAoTcsTorILZhLertO0MxIsrqt8064GQ&oe=69F3510C"}, {"file_name": "Lobby.png", "id": "2386860311811259", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618499_2386860315144592_4732509698311048844_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=thl34utltX4Q7kNvwGT2QE1&_nc_oc=AdrMwmEGBIKBvUuvG86mo6zDms04f2_0IKjTDgJpy-RwAjbFLt0bp0go0ZMJbdb703M&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2EKvLfgMTdbqwYlwguTWpSqK8AYbJM-fBXcpAR6lEekA&oe=69F35E02"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape(2560x1440),\uc378\ub124\uc77c.png", "id": "1513545639731719", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499619832_1513545643065052_6956812012207879288_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gxw8ZrFqPlcQ7kNvwHPv9rk&_nc_oc=AdqcJAwztmJeb8_XH0jm2oo5dnsQfIW4NzilrCpPVCkJnBteITO9rR_iTedIMZoik7U&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0hryc9P6-eD2c-LZ7GC51suGlpEDF609ELeKMieY6XMA&oe=69F36CDE"}, "display_name": "Calorie Hunters: XR Fitness Beat Combat", "keywords": ["rhythm", "fit", "beat", "combat", "boxing"], "long_description": "# Game or Workout? The answer is both!\nWe transform exercise from 'hard pain' into an unstoppable 'Enjoyable Healthy Addiction Experience'. Join the 'Calorie Hunters' journey now and start the most fun and effective diet routine! \n\n\u2800\n\n# \ud83c\udf1f The Perfect Blend of Fun and Fitness\n\u2800\n# 1. \u2694\ufe0f Hunt the Calories,  Not the Chore! (Calorie Monster Hunting System)\n\n**1) Intuitive Goal:** \n- Exercise expenditure is set as a hunting target called' Calorie Monsters,' providing an intuitive goal and strong motivation. \n- Every move you make\u2014punches, squats, and more\u2014becomes a powerful attack dealing damage to the monsters.\n\n**2) Achievement & Competition:**\n- After completing a challenge, experience the satisfaction of ranking up on the World Leaderboards as you compete against Hunters globally.\n\n\u2800\n# 2. \ud83e\udd2f Never Boring, Always Intense! (Random Weapon System)\n**1) All-in-One VR Rhythm Action Platform:**\n- Integrates the fun elements of various VR games into rhythm notes, including not just basic movements like Punch and Squat, but also Slash, Gun Shot, and Hit.\n---\n**2) Infinite Content:** \n- Our proprietary algorithm endlessly and randomly combines weapons and rhythm notes, creating fresh, dynamic workout routines every time.\n\n\u2800\n# 3. \ud83d\uddfa\ufe0f Future Updates Planned\n'Calorie Hunters' is committed to growing with its users and continuously delivering new fun.\n- New Stages with unique themes will be regularly added.\n- Various additional content is planned, including Boss Battles, Multiplayer, and Customization.\n", "short_description": "The Start of a Healthy Addiction\n\"Fitness is NOT Pain!\"\nHunt Your Fat with the Unstoppable VR Rhythm Action, 'Calorie Hunters'!\n\nThe VR fitness revolution that will make you shout, \"Just one more set!\".\n'Calorie Hunters' maximizes the fun of VR rhythm action to transform tedious, repetitive exercise into a 'Healthy Addiction'. By hunting monsters to the exciting music beat, you\u2019ll not only achieve your diet goals but also form a consistent exercise habit."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sevenptone.com/mutt-privacy/", "developer_terms_of_service_url": null, "publisher_name": "Derick", "support_website_url": null, "website_url": "https://sevenptone.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "de", "ja", "ko", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33569444959337671"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619685_1559353675120619_561145763113312566_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mCfi3kjOkfgQ7kNvwFtBRGD&_nc_oc=AdpI4ybEiMaqsnjafL5Ts97jAfayDcsAhd_HRr1aXBxgjKX4Zj3Onh1tvk225Yf4ev8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af09zdpLTEjYIbiXZnx_om_ZMR1VPv5THSY7AE3Jog84FQ&oe=69F34798"}, "is_concept": false, "is_test": false, "is_trial_of
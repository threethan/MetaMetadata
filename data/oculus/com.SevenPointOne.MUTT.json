5/39035417_417868801395587_1696414666942182352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QxhCG2DEXWEQ7kNvwENrl-P&_nc_oc=AdqCmj0RCE5J8WZIFncxishUppL-sLhew8YmpdjNJehN-QMQnYVgypi2-0MCqlLiPwk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFcno5VL7o967vwm7POVjwfCI_J9UArXBROKp6xFd4flw&oe=6A8839F2"}, {"file_name": "GunShot.png", "id": "1484185552249839", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974834_1484185555583172_8264876483161367463_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sk4o_JoxGVwQ7kNvwH51r8f&_nc_oc=AdodBdVIM44hLN7PhSVn_xxkfXhd9rZ3I0WQpgpSCzStx92zPYXLjxh3O2ipfCkuVWs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFP0kE8O8x2CD19SObKqRZI8m_E_Lamy_KH4EMt3uhTHw&oe=6A8842E1"}, {"file_name": "PunchRhythm.png", "id": "1109179657269921", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75462203_1109179660603254_5637594256277893857_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rSXW_5ZJ3FQQ7kNvwFr-eyP&_nc_oc=Adof2LPczw8b7kITuLRCVzZmNGaZcABCP9iqc0kAAxs0HuLqLRHQ1KL-82ylps8G_jE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMJ5mRQ6ihRdye78e2gHqeofYOnrDNHESMhaJ9voSqUw&oe=6A8828D8"}, {"file_name": "PracticeBreathing.png", "id": "587550747129538", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974635_587550750462871_1717998606930230757_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=by_E3NjhTkoQ7kNvwEpE-gW&_nc_oc=AdrPsiPHHpq3KTMVZtDJJZ3VjGc5m0k7OsGChVT4KjDPvh2u2UUjpIG7wbD1DW9xc4w&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGB1bVac5Nj7vUIPH7wkbpjZqeqkj_BBoi9eYqNrQliEQ&oe=6A8852E7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MUTT: Everything you want", "keywords": ["fitness", "rhythm", "sports", "free", "meditation"], "long_description": "Mutt is the best way to choose and play a variety of Content on one platform. \nWe have a wide range of games including sports, shooting, music, fitness, meditation, and more, and more will be added in the future. \nGet it on the Meta Store now to keep enjoying new experiences!\n\n{1303901187305557}\n# 1. Jelly Saber\n**\u201cExperience the thrill of slicing jelly with a light saber!\u201d**\n\n\nFeel the exhilarating sensation of slicing through jelly, battle against increasingly powerful waves and boss monsters, and survive the endless battles to be the last one standing.\n\n\n{573498865228346}\n# 2. Gunshot Game\n**\u201cDefeat enemies with a variety of firearms and survive the boss battle!\u201d**\n\nA thrilling experience of surviving to the end against oncoming enemies and powerful bosses. Utilize a variety of firearms to take down enemies and test the limits of your survival!\n\n\n{8754035691345594}\n# 3. Punch Rhythm\n**\u201cGet into the rhythm, enjoy the colorful combinations of your left and right hands!\u201d**\n\nFun tapping rhythm notes with interesting music! Think about the combinations of your left and right hands in the complex composition of long and single notes and ride the rhythm to the music. More music will be added in the future!\n\n\n\n{2008927669537690}\n# 4. Breathing Exercises\n**\u201cFind peace of mind with deep breathing in nature!\u201d** \n\nBreathing exercises to calm your mind and body against the backdrop of fresh nature's sights and sounds. A variety of options to calm your mind and visual and auditory effects to help you breathe. Start now for a unique experience that will lighten your heart.\n\n\n\n\n", "short_description": "All kinds of games for FREE. Sports, Shooting, Music, Fitness, Meditation, you name it, we have it."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sevenptone.com/mutt-privacy/", "developer_terms_of_service_url": null, "publisher_name": "Derick", "support_website_url": null, "website_url": "https://sevenptone.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context
c_oc=Adle58azjB6EfIqV3Iks4ZD9s13hD2BPSpQzvkYEpGFzkYoba36LXS6AiMkDMTSSiM8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfssBLdPJ7zUKygpir6zrbC9TNpNOQ5qXYygZhbodSB7cw&oe=69A02F00"}, {"file_name": "JellySaber.png", "id": "417868798062254", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035417_417868801395587_1696414666942182352_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PSrRES-aAoUQ7kNvwEOmv-m&_nc_oc=AdlPdA5EptlKAWCbVv0Ebk9hppNgyFapyOwjrXzxBxtZs7nyvdT68EaAhG8-s__JQRo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsMakMCADW72RgomrgMozb0p3fWLo_9HGPP8NLsuShdxQ&oe=69A031F2"}, {"file_name": "GunShot.png", "id": "1484185552249839", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974834_1484185555583172_8264876483161367463_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_1ZPf31Ke0MQ7kNvwEHTrTH&_nc_oc=AdnZjBgJxoVBwMZXjbbJvz1VzmMZmvlLnqBnmNPL3sbXuFViGWraKcN7pG3zSkNORj4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsNqRTM5tJgFT82VXuv8IWSEN8ONAhPkJdt54xJLeHS4A&oe=69A03AE1"}, {"file_name": "PunchRhythm.png", "id": "1109179657269921", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75462203_1109179660603254_5637594256277893857_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uCZD6Uavcb8Q7kNvwE0eLPu&_nc_oc=AdlmINfja2VvqWLtyHc2Bi9QaZlPDhqGeK28PBeyVuEwNfwf2YEycjgxuWJQzx9DonQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvn50pbMoKRg04meAzmYwPX9yo74xpVtLOvAqEm5-wnow&oe=69A05918"}, {"file_name": "PracticeBreathing.png", "id": "587550747129538", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974635_587550750462871_1717998606930230757_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N8cWW4vQswEQ7kNvwEiSetr&_nc_oc=AdnuytGbmEHSC1L0peDye67L-ck0WSXib4SNnHoe15_-7LqG-fk5-FvNoCs2vDJUuLY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfujQhc24GhbT8MroL4X9SHVYe5wi8YN9JND2T0iPG0mIA&oe=69A04AE7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MUTT: Everything you want", "keywords": ["fitness", "rhythm", "sports", "free", "meditation"], "long_description": "Mutt is the best way to choose and play a variety of Content on one platform. \nWe have a wide range of games including sports, shooting, music, fitness, meditation, and more, and more will be added in the future. \nGet it on the Meta Store now to keep enjoying new experiences!\n\n{1303901187305557}\n# 1. Jelly Saber\n**\u201cExperience the thrill of slicing jelly with a light saber!\u201d**\n\n\nFeel the exhilarating sensation of slicing through jelly, battle against increasingly powerful waves and boss monsters, and survive the endless battles to be the last one standing.\n\n\n{573498865228346}\n# 2. Gunshot Game\n**\u201cDefeat enemies with a variety of firearms and survive the boss battle!\u201d**\n\nA thrilling experience of surviving to the end against oncoming enemies and powerful bosses. Utilize a variety of firearms to take down enemies and test the limits of your survival!\n\n\n{8754035691345594}\n# 3. Punch Rhythm\n**\u201cGet into the rhythm, enjoy the colorful combinations of your left and right hands!\u201d**\n\nFun tapping rhythm notes with interesting music! Think about the combinations of your left and right hands in the complex composition of long and single notes and ride the rhythm to the music. More music will be added in the future!\n\n\n\n{2008927669537690}\n# 4. Breathing Exercises\n**\u201cFind peace of mind with deep breathing in nature!\u201d** \n\nBreathing exercises to calm your mind and body against the backdrop of fresh nature's sights and sounds. A variety of options to calm your mind and visual and auditory effects to help you breathe. Start now for a unique experience that will lighten your heart.\n\n\n\n\n", "short_description": "All kinds of games for FREE. Sports, Shooting, Music, Fitness, Meditation, you name it, we have it."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sevenptone.com/mutt-privacy/", "developer_terms_of_serv
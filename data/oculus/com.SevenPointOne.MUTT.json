HKNK5J6E-WcKBs5TCOIk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXXf8OAptL5UcPuQa5IpBED6ZJZDkHGK9blc7xGpR56g&oe=6AAEB0CB"}, {"file_name": "gun1.png", "id": "1701141757903683", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/613057330_1701141761237016_2057678754440633945_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KRmccfKOnTkQ7kNvwGi-JmN&_nc_oc=Adp-UmMqhVBYechNfIivOjG5T5Wwjn3qW1K2NzmR4qo9aghApz6E44toPFeAWbzaqLY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKuyZlBO3U6FwYn07qKQ59NEhE8J-v0mUCKSjP2gXHO-w&oe=6AAEB253"}, {"file_name": "lobby.png", "id": "844396791563245", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/604275479_844396794896578_4553122631057590950_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w6_B467XUPoQ7kNvwEMXngo&_nc_oc=Ado9rEKgUziqPRmgGXus_6_cwCQWkGiwv7d7-IKKdZQwqsVDN7UiD_ucchYngYL6mE0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJFvoFKsariG26MonoXo1M8Dh-hgtAgMcgGuERo-rIT5A&oe=6AAE98EF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape(2560x1440),\uc378\ub124\uc77c.png", "id": "1755566859091507", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499622188_1755566862424840_594230336198285518_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iPcfKUW7oIEQ7kNvwEGseUb&_nc_oc=AdoFNjQGH6keigU5b7i-__rJ2wMIi7Eh9YLBx8PTyuNNKc2Fa-ww3WPzEEzMbHLPW3A&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKu0ttGEcJ2_f6D5x_eF2UznTkT3bY9hJwAP-3IZFlMg&oe=6AAE8C49"}, "display_name": "Calorie Hunters: XR Fitness Beat Combat", "keywords": ["rhythm", "beat", "combat", "boxing", "fitness"], "long_description": "# \"Just One More Set!\"\n\nEver had that \"just one more game\" urge \u2014 for your workout?\nPunch, slash, shoot to the beat. You'll be hitting play on the next track in no time.\n\nForget willpower.\nStep into 'Calorie Hunters' \u2014 the most enjoyable healthy addiction in VR rhythm action.\n\n\u2800\n\n# \ud83c\udf1f Where Fun Meets Real Fitness\n\u2800\n# 1. \u2694\ufe0f Hunt the Calories, Not the Chore!\n- Calories appear as Monsters \u2014 real prey, not abstract numbers.\n- Every punch, squat, slash, and shot lands a powerful blow.\n- Clear a round and climb the Global Leaderboards against Hunters worldwide\n\n\u2800\n# 2. \ud83e\udd2f Never Boring, Always Fresh!\n- All VR rhythm action fun \u2014 punch, slash, shoot, smash \u2014 in one session.\n- Our algorithm mixes weapons and notes randomly every time. No two routines alike.\n- Workout burnout? Not anymore\n\n\u2800\n# 3. \ud83c\udd95 NEW in This Update!\n- \ud83d\udc09 **Boss Battles** \u2014 A true challenger for Hunters who've outgrown ordinary prey. The Boss summons Rhythm Monsters \u2014 hunt them down to strike the Boss itself. Defeat it and claim your bounty.\n- \ud83e\udd1d **Supporter System** \u2014 Spend the Gold you earn hunting to build your own Supporter dance team. They'll cheer you on with adorable dance moves while your allies bring unique abilities and grow stronger with every rank-up. Who you hunt with is your new strategy.\n\n\u2800\n# 4. \ud83d\uddfa\ufe0f What's Coming Next\n'Calorie Hunters' grows with its players. This is just the beginning.\n- New themed stages added regularly.\n- Multiplayer and more co-op content on the way.\n- A deeper, richer 'one more set' is always waiting for you.", "short_description": "The Start of a Healthy Addiction\n\"Fitness is NOT Pain!\"\nHunt Your Fat with the Unstoppable VR Rhythm Action, 'Calorie Hunters'!\n\nThe VR fitness revolution that will make you shout, \"Just one more set!\".\n'Calorie Hunters' maximizes the fun of VR rhythm action to transform tedious, repetitive exercise into a 'Healthy Addiction'. By hunting monsters to the exciting music beat, you\u2019ll not only achieve your diet goals but also form a consistent exercise habit."}, {"images": {"nodes": [{"file_name": "CoverSquare(1440x1440),\uc378\ub124\uc77c\uc5d0 \ub4e4\uc5b4\uac00\ub294 \uc694\uc18c\ub97c \uc815\uc0ac\uac01\ud615\uc5d0 \ub9de\ucdb0\uc11c.png", "id": "1984082902291098", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499623534_1984082905624431_5653267256921169664_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ybu2aBOU5cwQ7kNvwEXnK14&_nc_oc=AdqE70l-3C5rsEjOslLMBEf4yi2ProWsu2u3dAzyWUP1KwSY8Z_RRX9iatUCaeuJmmI&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0SyJ69EWfiBSXsja1ikjgPjcGr4k_DWkOHBRzfu7v0A&oe=6AAEA33A"}, {"file_name": "Logo(Transparent).png", "id": "1771494364195456", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499619404_1771494370862122_7957116351418805276_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BsL64S9jd-8Q7kNvwGGfopq&_nc_oc=AdpOmUFhV_lvHythQNBbyt39QDem-eCWAiGqOM7nJkXG9QeqIO5mFZ4B_5Km3z16UWQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIK4TNxVsqHygBuQQAXRjCNVrxnTLwoBriBP0fW4uzf6Q&oe=6AAE9F14"}, {"file_name": "HeroCover(3000x900),\uc2a4\ud1a0\uc5b4\uc5d0\uc11c \uc5b4\ud50c \ub20c\ub7ec\uc11c \ub4e4\uc5b4\uac00\uba74 \ubcf4\uc774\ub294 \uc774\ubbf8\uc9c0.png", "id": "1613872473743039", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/593839439_1613872477076372_6479563604376765610_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LvYjW5EY-3EQ7kNvwECOEAv&_nc_oc=AdqZj0s2No5tV0g6oKjfRKNJg5oOs-0sHxp60AtkqZ1bmksGCQo7O1g1kicKWfeItqc&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ---IPBDcxSwgLDRo3U68UoIUiYK-lMVs4OjE_U4w6pQ&oe=6AAEA719"}, {"file_name": "CoverPortrait(1008x1440),\uc694\uc18c \uc138\ub85c\ubc84\uc804.png", "id": "1607601111040163", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499620341_1607601114373496_6649803988780202206_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TE7I2PY9g_8Q7kNvwFMd2S2&_nc_oc=AdoqQElHR9OzM-CjWeErvCAPTqDiA6TWSm2yKVQgZxhp2p
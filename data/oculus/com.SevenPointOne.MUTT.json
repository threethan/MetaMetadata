9374_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=87lRAtiUuN0Q7kNvwEVwxQS&_nc_oc=Adr4WbbbmVdl2gekjr7LhDYbCOR0ICQdYq0yIpmNQtJ_g20X8RxsaRK1SEmy8vTtB5Y&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9r1iYmLMS58NohZW7iZ9oR1E6funyUZH5wirh9k9_f5Q&oe=6A22E66F"}, {"file_name": "bat.png", "id": "1662831244964261", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499622334_1662831248297594_547601879803341137_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Um07TLzk26UQ7kNvwFGIWHM&_nc_oc=AdqqBDjU_CDybUDCtvG_Pw1yV5U7h1IM1eEF6l7TPJQf1y9O2tAvR2hH1nzSxUosbKY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-pVOPMHHNIiIKld8bLclI3oFwF3vWNYU0rOKPiJQJL-Q&oe=6A22F1CB"}, {"file_name": "gun1.png", "id": "1701141757903683", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/613057330_1701141761237016_2057678754440633945_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kP1zSfxUH5sQ7kNvwEaRzOn&_nc_oc=AdoZKW6BJJbhK1GaN-OA5vaU0kW4pigOzSJWf2g4jcuXMJd53O1m_1T8yAH1ZYXGvO8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8fzPsrj6qShxSPaGQonTDP5lWNffU1ATVnFJfhEb4nwg&oe=6A22F353"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape(2560x1440),\uc11c\ube0c\uc378\ub124\uc77c.png", "id": "1693642975385127", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/654944867_1693642978718460_2608461543012234797_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HHbGMp-LGecQ7kNvwEoKRRQ&_nc_oc=AdowGlUNNKK0DicJ_ZPtmqDYRzd2kPsXNGrbTKqvtGHKzVDRniZ6dIhnCsJMr8cERr4&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9pF3sctUyWYUWvnBcfLTNIFrgYETvdCfTXnLuuHt-WIw&oe=6A22C98A"}, "display_name": "Calorie Hunters: XR Fitness Beat Combat", "keywords": ["rhythm", "beat", "combat", "boxing", "fitness"], "long_description": "# \"Just One More Set!\"\n\nEver had that \"just one more game\" urge \u2014 for your workout?\nPunch, slash, shoot to the beat. You'll be hitting play on the next track in no time.\n\nForget willpower.\nStep into 'Calorie Hunters' \u2014 the most enjoyable healthy addiction in VR rhythm action.\n\n\u2800\n\n# \ud83c\udf1f Where Fun Meets Real Fitness\n\u2800\n# 1. \u2694\ufe0f Hunt the Calories, Not the Chore!\n- Calories appear as Monsters \u2014 real prey, not abstract numbers.\n- Every punch, squat, slash, and shot lands a powerful blow.\n- Clear a round and climb the Global Leaderboards against Hunters worldwide\n\n\u2800\n# 2. \ud83e\udd2f Never Boring, Always Fresh!\n- All VR rhythm action fun \u2014 punch, slash, shoot, smash \u2014 in one session.\n- Our algorithm mixes weapons and notes randomly every time. No two routines alike.\n- Workout burnout? Not anymore\n\n\u2800\n# 3. \ud83c\udd95 NEW in This Update!\n- \ud83d\udc09 **Boss Battles** \u2014 A true challenger for Hunters who've outgrown ordinary prey. The Boss summons Rhythm Monsters \u2014 hunt them down to strike the Boss itself. Defeat it and claim your bounty.\n- \ud83e\udd1d **Supporter System** \u2014 Spend the Gold you earn hunting to build your own Supporter dance team. They'll cheer you on with adorable dance moves while your allies bring unique abilities and grow stronger with every rank-up. Who you hunt with is your new strategy.\n\n\u2800\n# 4. \ud83d\uddfa\ufe0f What's Coming Next\n'Calorie Hunters' grows with its players. This is just the beginning.\n- New themed stages added regularly.\n- Multiplayer and more co-op content on the way.\n- A deeper, richer 'one more set' is always waiting for you.", "short_description": "The Start of a Healthy Addiction\n\"Fitness is NOT Pain!\"\nHunt Your Fat with the Unstoppable VR Rhythm Action, 'Calorie Hunters'!\n\nThe VR fitness revolution that will make you shout, \"Just one more set!\".\n'Calorie Hunters' maximizes the fun of VR rhythm action to transform tedious, repetitive exercise into a 'Healthy Addiction'. By hunting monsters to the exciting music beat, you\u2019ll not only achieve your diet goals but also form a consistent exercise habit."}, {"images": {"nodes": [{"file_name": "CoverLandscape(2560x1440),\uc378\ub124\uc77c.png", "id": "35824301873852305", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499620860_35824301900518969_8677363824331430839_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s2HXFPsYQbMQ7kNvwGYDirR&_nc_oc=Adr5FbL3rdsm8OPtRbVEbBOJAiYWecHwRi9Mez9kF_ht3dI3Oy6acPQfwkC-JyS8qNM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9xgshLFCAschZt-9WP5x0IxTA-tdcqR1Z7hSrZhl38sQ&oe=6A22D8B0"}, {"file_name": "HeroCover(3000x900),\uc2a4\ud1a0\uc5b4\uc5d0\uc11c \uc5b4\ud50c \ub20c\ub7ec\uc11c \ub4e4\uc5b4\uac00\uba74 \ubcf4\uc774\ub294 \uc774\ubbf8\uc9c0.png", "id": "2020004012224205", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/595136811_2020004018890871_280394800797697319_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FQ4kYQQL4SEQ7kNvwF4rY6I&_nc_oc=Adqs-Mlg9NK-lbjzKkvXkut1FhEbprUZF7IrmXvOUCdXWlsg0fq6BVb7F-kXZdThSSc&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81h5nI-GRXBxlErn7Q6ovMHYZXFdV70f8-mIYT44vXOg&oe=6A22F82D"}, {"file_name": "CoverSquare(1440x1440),\uc378\ub124\uc77c\uc5d0 \ub4e4\uc5b4\uac00\ub294 \uc694\uc18c\ub97c \uc815\uc0ac\uac01\ud615\uc5d0 \ub9de\ucdb0\uc11c.png", "id": "1387374113425660", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/596157734_1387374116758993_580513561534275019_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VSwQTxvp2FoQ7kNvwHnPJwr&_nc_oc=AdoL5Dm_iHuED6jN8dGk0gT1t_TWXXEOjF4VI4E-DKhUkWMhhiCGvUq1xsX9ZwXO4uQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af95ytqAnOOpcTtv5p51opdnzOGQHylwULkJJj2HyCJgRw&oe=6A22F531"}, {"file_name": "CoverPortrait(1008x1440),\uc694\uc18c \uc138\ub85c\ubc84\uc804.png", "id": "1355972336579200", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/
AQJGp7zP-3MTGagolqo2v3aVtMhBC_BS51SLaS4TJNiwgA&oe=6A9D551C"}, {"file_name": "gun1.png", "id": "2508994702886826", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622285_2508994706220159_3422494880786317538_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jqpJRioej84Q7kNvwEr-2Te&_nc_oc=AdpqxN2n_7JhWUmI79aW8Q7RDnmEtkwX7faf-R5Ecsi75kr-l6Vn_9tpX8KdFvaOH68&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjIvMd9oV8NqhEjl4-Vj2-FMng85enhiRmif9h8idO2w&oe=6A9D69B0"}, {"file_name": "supporter2.png", "id": "27287240120900782", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499623601_27287240124234115_1941419494427239415_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pl9qFwjRtaIQ7kNvwG-fphV&_nc_oc=Adr3DOXIjnyfppGbBlhQ8Y99Bb2XzwdVCEhpD4A9xB6Dkag5FT6NyDMSIGKzrVXBCYU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIb9VIrwEk3VKWcY-Vbx_QP56u1CP1UBz8tCt2bb2v2qw&oe=6A9D841B"}, {"file_name": "lobby.png", "id": "1694084821494788", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499623370_1694084824828121_8188048639442793948_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4N6LbJgVpdIQ7kNvwHLSeDP&_nc_oc=AdrZbHWasWID6G2RASfePde834K3563tCUu7gVtG8t-3iApxtbiySJOm7MACxa67GVg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKg_Gb3vnM-6SU92EJ80a5ET9NLMDXLe1ZxphtD9j0_Gg&oe=6A9D78D4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape(2560x1440),\uc378\ub124\uc77c.png", "id": "1737219774229226", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499620630_1737219777562559_6701988379604655389_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RJyOc7zqsUkQ7kNvwFsBY5v&_nc_oc=AdqdPxy8pMnq6Lru8ZfOOTZuL5-HQA1X4Ur3vhDPKtRhPfBU6p9j_3hvamkOemf2ozE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSwun8ZsjEO7ZiCBKmNB2d2aJFuT5dK0qwj2ANDqHnBw&oe=6A9D5E2F"}, "display_name": "\uce7c\ub85c\ub9ac \ud5cc\ud130\uc2a4: XR Fitness Beat Combat", "keywords": ["combat", "beat", "fit", "rhythm", "boxing"], "long_description": "# \"\ub531 \ud55c \uc138\ud2b8\ub9cc \ub354!\"\n\n\uac8c\uc784\uc744 \uba48\ucd94\uc9c0 \ubabb\ud558\ub358 \uadf8 \ub9c8\uc74c, \uc6b4\ub3d9\uc5d0\uc11c\ub3c4 \ub290\uaef4\ubcf8 \uc801 \uc788\uc73c\uc138\uc694?\n\ud380\uce58, \ubca0\uae30, \uc288\ud305 \u2014 \ube44\ud2b8\uc5d0 \ub9de\ucdb0 \uce7c\ub85c\ub9ac \ubaac\uc2a4\ud130\ub97c \uc0ac\ub0e5\ud558\ub2e4 \ubcf4\uba74,\n\ud55c \uace1\uc774 \ub05d\ub098\uae30\ub3c4 \uc804\uc5d0 \ub2e4\uc74c \uace1\uc744 \ub204\ub974\uace0 \uc788\uc2b5\ub2c8\ub2e4.\n\n\uc6b4\ub3d9\uc740 \ub354 \uc774\uc0c1 \uc758\uc9c0\uc758 \ubb38\uc81c\uac00 \uc544\ub2d9\ub2c8\ub2e4.\n'\uce7c\ub85c\ub9ac \ud5cc\ud130\uc2a4' \u2014 VR \ub9ac\ub4ec \uc561\uc158\uc774 \ub9cc\ub4e0, \uac00\uc7a5 \uc990\uac70\uc6b4 \uac74\uac15 \uc911\ub3c5\uc744 \ub290\uaef4\ubcf4\uc138\uc694!\n\n\u2800\n\n# \ud83c\udf1f \uce7c\ub85c\ub9ac \ud5cc\ud130\uc2a4\uc758 \ud2b9\ubcc4\ud568: \uc7ac\ubbf8\uc640 \uc6b4\ub3d9 \ud6a8\uacfc\uc758 \uc644\ubcbd\ud55c \uc870\ud654\n\u2800\n# 1. \u2694\ufe0f \uc6b4\ub3d9\uc744 \uc0ac\ub0e5\ud558\ub77c! (\uce7c\ub85c\ub9ac \ubaac\uc2a4\ud130 \ud5cc\ud305 \uc2dc\uc2a4\ud15c)\n\n**1) \uc9c1\uad00\uc801\uc778 \ubaa9\ud45c \u2014 \uce7c\ub85c\ub9ac\uac00 \ubaac\uc2a4\ud130\uac00 \ub41c\ub2e4**\n- \uc18c\ubaa8\ud574\uc57c \ud560 \uce7c\ub85c\ub9ac\uac00 \ub208\uc55e\uc758 '\ubaac\uc2a4\ud130'\ub85c \ub098\ud0c0\ub0a9\ub2c8\ub2e4. \ucd94\uc0c1\uc801\uc778 \uc22b\uc790\uac00 \uc544\ub2cc, \uc2e4\uc81c\ub85c \uc4f0\ub7ec\ub728\ub824\uc57c \ud560 \uc0ac\ub0e5\uac10.\n- \ud380\uce58, \uc2a4\ucffc\ud2b8, \ubca0\uae30, \uc288\ud305 \u2014 \ub2f9\uc2e0\uc758 \ubaa8\ub4e0 \ub3d9\uc791\uc774 \ubaac\uc2a4\ud130\uc5d0\uac8c \uaf42\ud788\ub294 \uc77c\uaca9\uc774 \ub429\ub2c8\ub2e4.\n\n**2) \ub05d\ub098\uba74 \uc2dc\uc791\ub418\ub294 \uacbd\uc7c1 \u2014 \uae00\ub85c\ubc8c \ub9ac\ub354\ubcf4\ub4dc**\n- \ud55c \ub77c\uc6b4\ub4dc\ub97c \ud074\ub9ac\uc5b4\ud558\ub294 \uc21c\uac04, \uc804 \uc138\uacc4 \ud5cc\ud130\ub4e4\uacfc\uc758 \uacbd\uc7c1\uc774 \uc2dc\uc791\ub429\ub2c8\ub2e4.\n- \uc790\uc2e0\uc758 \uae30\ub85d\uc774 \uc5b4\ub514\uae4c\uc9c0 \uc62c\ub77c\uac00\ub294\uc9c0 \uc9c1\uc811 \ud655\uc778\ud574\ubcf4\uc138\uc694.\n\n\u2800\n# 2. \ud83e\udd2f \uc808\ub300 \uc9c8\ub9ac\uc9c0 \uc54a\ub294\ub2e4! (\ub79c\ub364 \uc6e8\ud3f0 \uc2dc\uc2a4\ud15c)\n\n**1) VR \uc6b4\ub3d9 \uac8c\uc784\uc758 \ubaa8\ub4e0 \uc7ac\ubbf8\ub97c, \ud55c \uacf3\uc5d0!**\n- \ud380\uce58\ud558\ub294 \uac8c\uc784\uc774 \ub530\ub85c, \ubca0\ub294 \uac8c\uc784\uc774 \ub530\ub85c? \uc774\uc81c '\uce7c\ub85c\ub9ac \ud5cc\ud130\uc2a4' \ud558\ub098\uba74 \ub429\ub2c8\ub2e4.\n- \ud380\uce58, \uc2a4\ucffc\ud2b8, \uc2ac\ub798\uc2dc, \uc288\ud305, \ud0c0\uaca9 \u2014 VR \ub9ac\ub4ec \uc561\uc158\uc758 \ubaa8\ub4e0 \uc7ac\ubbf8\ub97c \ud55c \ud310\uc5d0 \ub2f4\uc558\uc2b5\ub2c8\ub2e4.\n\n**2) \ub9e4\ubc88 \uc0c8\ub86d\uac8c, \ubb34\ud55c\ud788 \uc870\ud569\ub418\ub294 \ucf58\ud150\uce20**\n- \uc790\uccb4 \uc54c\uace0\ub9ac\uc998\uc774 \ubb34\uae30\uc640 \ub9ac\ub4ec \ub178\ud2b8\ub97c \ub9e4\ubc88 \ubb34\uc791\uc704\ub85c \uc870\ud569\ud569\ub2c8\ub2e4.\n- \uc5b4\uc81c\uc758 \ub8e8\ud2f4\uacfc \uc624\ub298\uc758 \ub8e8\ud2f4\uc774 \ub2e4\ub974\uace0, \uc5b4\uc81c \ubabb \ubd24\ub358 \ubb34\uae30\ub97c \uc624\ub298 \ub9cc\ub098\uac8c \ub429\ub2c8\ub2e4.\n- \uc6b4\ub3d9 \uad8c\ud0dc\uae30? \uc774\uc81c \ub05d\uc785\ub2c8\ub2e4.\n\n\u2800\n\n# 3. NEW! \uc774\ubc88 \uc5c5\ub370\uc774\ud2b8\uc758 \uc0c8\ub85c\uc6b4 \uacbd\ud5d8\n\n**1) \ud83d\udc09 \uac70\ub300\ud55c \ubcf4\uc2a4\ub97c \ub9ac\ub4ec\uc73c\ub85c \uc4f0\ub7ec\ub728\ub824\ub77c! (Boss Battles)**\n- \ud3c9\ubc94\ud55c \uc0ac\ub0e5\uc774 \uc2dc\uc2dc\ud574\uc9c4 \ud5cc\ud130\ub97c \uc704\ud55c, \uc9c4\uc9dc \uac15\uc801\uc774 \ub4f1\uc7a5\ud569\ub2c8\ub2e4.\n- \ubcf4\uc2a4 \ubaac\uc2a4\ud130\ub294 \ub9ac\ub4ec \ubaac\uc2a4\ud130\ub97c \ub04a\uc784\uc5c6\uc774 \uc18c\ud658\ud569\ub2c8\ub2e4. \uadf8 \ub9ac\ub4ec \ubaac\uc2a4\ud130\ub4e4\uc744 \uc0ac\ub0e5\ud558\ub294 \uac83\uc774 \ubc14\ub85c \ubcf4\uc2a4\ub97c \uacf5\uaca9\ud558\ub294 \ubc29\ubc95!\n- \ubcf4\uc2a4\ub97c \ucc98\uce58\ud558\uba74 \uc18c\uc815\uc758 \ud604\uc0c1\uae08\uc774 \uc9c0\uae09\ub429\ub2c8\ub2e4. \ub540 \ud758\ub9b0 \ub9cc\ud07c \ub3cc\uc544\uc624\ub294, \uc9dc\ub9bf\ud55c \ubcf4\uc0c1.\n\n**2) \ud83e\udd1d \ud63c\uc790\uac00 \uc544\ub2cc \uc0ac\ub0e5! (Supporter System)**\n- \uc774\uc81c \uc0ac\ub0e5\uc5d0 \ud568\uaed8\ud560 \ub3d9\ub8cc, '\uc11c\ud3ec\ud130'\ub97c \ubaa8\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n- \uc0ac\ub0e5\uc73c\ub85c \uc5bb\uc740 \uace8\ub4dc\ub85c \ub098\ub9cc\uc758 \uc11c\ud3ec\ud130 \ub304\uc2a4\ud300\uc744 \uafb8\ub9ac\uc138\uc694. \uc11c\ud3ec\ud130\ub4e4\uc740 \uadc0\uc5ec\uc6b4 \ub304\uc2a4 \ud3ec\uc988\ub97c \ucd94\uba70 \ub2f9\uc2e0\uc758 \uc804\ud22c\ub97c \uc2e0\ub098\uac8c \uc751\uc6d0\ud569\ub2c8\ub2e4.\n- \uac01 \uc11c\ud3ec\ud130\ub294 \uace0\uc720 \ub2a5\ub825\uc73c\ub85c \ud5cc\ud130\ub97c \ubcf4\uc870\ud558\uba70, \uc2b9\uae09\uc744 \ud1b5\ud574 \ub354 \uac15\ub825\ud55c \ud30c\ud2b8\ub108\ub85c \uc131\uc7a5\ud569\ub2c8\ub2e4.\n\n**3) \u2728 \ubaa8\ub4e0 \ub514\ud14c\uc77c\uc744 \ud55c \ub2e8\uacc4 \uc704\ub85c (Polishing)**\n- \uc774\ud399\ud2b8\uc758 \uc784\ud329\ud2b8, UI\uc758 \ubc18\uc751\uc131, \ubc38\ub7f0\uc2a4\uc758 \uc815\ubc00\ud568 \u2014 \uac8c\uc784 \uc804\ubc18\uc758 \ub514\ud14c\uc77c\uc744 \ud55c \ub2e8\uacc4 \ub2e4\ub4ec\uc5c8\uc2b5\ub2c8\ub2e4.\n- \ud55c \ubc88\uc758 \ud380\uce58, \ud55c \ubc88\uc758 \uc2ac\ub798\uc2dc\uac00 \uc774\uc804\ubcf4\ub2e4 \ub354 \uc9dc\ub9bf\ud558\uac8c \ub290\uaef4\uc9c8 \uac81\ub2c8\ub2e4.\n\n\u2800\n# 4. \ud83d\uddfa\ufe0f \uc55e\uc73c\ub85c \ub9cc\ub098\uc2e4 \ucf58\ud150\uce20\n\n'\uce7c\ub85c\ub9ac \ud5cc\ud130\uc2a4'\ub294 \uc720\uc800\uc640 \ud568\uaed8 \uc131\uc7a5\ud569\ub2c8\ub2e4. \uc9c0\uae08\uc774 \ub05d\uc774 \uc544\ub2cc, \uc2dc\uc791\uc785\ub2c8\ub2e4.\n- \ub3c5\ucc3d\uc801\uc778 \ud14c\ub9c8\uc758 \uc0c8\ub85c\uc6b4 \uc2a4\ud14c\uc774\uc9c0\uac00 \uc815\uae30\uc801\uc73c\ub85c \ucd94\uac00\ub429\ub2c8\ub2e4.\n- \uba40\ud2f0\ud50c\ub808\uc774\uc5b4 \ub4f1 \ub354 \ub9ce\uc740 \ud5cc\ud130\ub4e4\uacfc \ud568\uaed8\ud560 \ucf58\ud150\uce20\ub3c4 \ucc28\ub840\ub85c \uc900\ube44 \uc911\uc785\ub2c8\ub2e4.\n- \ub354 \uae4a\uace0, \ub354 \ub2e4\uc591\ud558\uace0, \ub354 \uc990\uac70\uc6b4 '\ud55c \uc138\ud2b8'\uac00, \uacc4\uc18d \uae30\ub2e4\ub9ac\uace0 \uc788\uc2b5\ub2c8\ub2e4.\n", "short_description": "\"\ub531 \ud55c \uc138\ud2b8\ub9cc \ub354!\"\n\n\uac74\uac15\ud55c \uc911\ub3c5\uc758 \uc2dc\uc791:  \uc6b4\ub3d9\uc740 \uace0\ud1b5\uc774 \uc544\ub2c8\ub2e4!\n\uba48\ucd9c \uc218 \uc5c6\ub294 VR \ub9ac\ub4ec \uc561\uc158, '\uce7c\ub85c\ub9ac \ud5cc\ud130\uc2a4'\ub85c \uc9c0\ubc29\uc744 \uc0ac\ub0e5\ud558\uc138\uc694!\n\n\n\"\ub531 \ud55c \uc138\ud2b8\ub9cc \ub354!\"\ub97c \uc678\uce58\uac8c \ub9cc\ub4dc\ub294 VR \ud53c\ud2b8\ub2c8\uc2a4 \ud601\uba85.\n\n'\uce7c\ub85c\ub9ac \ud5cc\ud130\uc2a4'\ub294 VR \ub9ac\ub4ec \uc561\uc158 \uac8c\uc784\uc758 \uc7ac\ubbf8\ub97c \uadf9\ub300\ud654\ud558\uc5ec \uc9c0\ub8e8\ud55c \ubc18\ubcf5 \uc6b4\ub3d9\uc744 '\uac74\uac15\ud55c \uc911\ub3c5(Healthy Addiction)'\uc73c\ub85c \ubc14\uafc9\ub2c8\ub2e4.\n\n\uc2e0\ub098\ub294 \uc74c\uc545 \ube44\ud2b8\uc5d0 \ub9de\ucdb0 \ubaac\uc2a4\ud130\ub97c \uc0ac\ub0e5\ud558\ub2e4 \ubcf4\uba74 , \uc5b4\ub290\uc0c8 \ub2e4\uc774\uc5b4\ud2b8 \ud6a8\uacfc\uc640 \uc6b4\ub3d9 \uc2b5\uad00\uae4c\uc9c0 \uc5bb\uac8c \ub420 \uac83\uc785\ub2c8\ub2e4."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sevenptone.com/mutt-privacy/", "developer_terms_of_service_url": null, "publisher_name": "Derick", "support_website_url": null, "website_url": "https://sevenptone.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}], "external_subscription_ty
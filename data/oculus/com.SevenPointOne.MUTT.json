ve5agn6XhKlpPks0i1s-lk1VQ&oe=6AE4BB32"}, {"file_name": "GunShot.png", "id": "1484185552249839", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974834_1484185555583172_8264876483161367463_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_KCm7jFombIQ7kNvwGMeXE4&_nc_oc=AdrovYCbhDxA6vEVl2eWSBfT_lAIRhvuvKH0FvDs5U5TYlBjb-RcDKfZmqM7rq3H8kE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNBRSrcc_DbIpFDv869oc63fkQqAWaGA7YlAqD-_nS-9A&oe=6AE48BE1"}, {"file_name": "PunchRhythm.png", "id": "1109179657269921", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75462203_1109179660603254_5637594256277893857_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MxVPhpIfksoQ7kNvwF-0AbS&_nc_oc=AdrHiKtWjMhdCuuGUOx-0gZX9r13ClNIGS6o7oI1KVVrAruL1C0lzj4ObakTfgvevoM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjAc5BKiFb5qZWkY8OMC37aDDAolDydu8cjoaspoKyrw&oe=6AE4AA18"}, {"file_name": "PracticeBreathing.png", "id": "587550747129538", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974635_587550750462871_1717998606930230757_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aan7l_BM-9gQ7kNvwEJM2H-&_nc_oc=Adpb552ocoupGOYAxjoA5Mt5wweDAYSd2LOg5YmPI8htGTlvm6voFmJAjB-TV2ZFF_Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNbZt5Y5YzlVi-g0ewNWgNPfEqaTMm-LxhGORteAzqG3A&oe=6AE49BE7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MUTT: Everything you want", "keywords": ["fitness", "rhythm", "sports", "free", "meditation"], "long_description": "Mutt is the best way to choose and play a variety of Content on one platform. \nWe have a wide range of games including sports, shooting, music, fitness, meditation, and more, and more will be added in the future. \nGet it on the Meta Store now to keep enjoying new experiences!\n\n{1303901187305557}\n# 1. Jelly Saber\n**\u201cExperience the thrill of slicing jelly with a light saber!\u201d**\n\n\nFeel the exhilarating sensation of slicing through jelly, battle against increasingly powerful waves and boss monsters, and survive the endless battles to be the last one standing.\n\n\n{573498865228346}\n# 2. Gunshot Game\n**\u201cDefeat enemies with a variety of firearms and survive the boss battle!\u201d**\n\nA thrilling experience of surviving to the end against oncoming enemies and powerful bosses. Utilize a variety of firearms to take down enemies and test the limits of your survival!\n\n\n{8754035691345594}\n# 3. Punch Rhythm\n**\u201cGet into the rhythm, enjoy the colorful combinations of your left and right hands!\u201d**\n\nFun tapping rhythm notes with interesting music! Think about the combinations of your left and right hands in the complex composition of long and single notes and ride the rhythm to the music. More music will be added in the future!\n\n\n\n{2008927669537690}\n# 4. Breathing Exercises\n**\u201cFind peace of mind with deep breathing in nature!\u201d** \n\nBreathing exercises to calm your mind and body against the backdrop of fresh nature's sights and sounds. A variety of options to calm your mind and visual and auditory effects to help you breathe. Start now for a unique experience that will lighten your heart.\n\n\n\n\n", "short_description": "All kinds of games for FREE. Sports, Shooting, Music, Fitness, Meditation, you name it, we have it."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sevenptone.com/mutt-privacy/", "developer_terms_of_service_url": null, "publisher_name": "Derick", "support_website_url": null, "website_url": "https://sevenptone.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "528142316460358"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recom
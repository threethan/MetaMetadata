IPtEjNincamr6c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGLpoPPFXca6_1sojTrp-HdHdlUAQ3H0_k3iwmiyGrAQ&oe=6AFDC3EF"}, {"file_name": "screenshot_3_2560x1440.png", "id": "1379388537610188", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823259_1379388540943521_3575302720444223694_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ehjCbF8pjJcQ7kNvwGXYnqp&_nc_oc=AdoHTnJ-TVRWgcSBRrKf1SowIHX_gX9PdeEBSVSrhrXfRGpE2tRlTpG1d6WZK4ffBPA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5pN76cRO_wbTr-B290aTuzhzcCaC21kzo2Q_DiBfI8A&oe=6AFDB9AD"}, {"file_name": "screenshot_4_2560x1440.png", "id": "1085049744380652", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823310_1085049747713985_481020608597774228_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FhpQ-M_vANUQ7kNvwH6Thjr&_nc_oc=Adp4-bLoTcnDpA1ajACevlsgq0ymZ2QQNS2o_c055Pgnzuba9NAFRoHMjPdJsW7Jnk8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRR5NpmvugA0lRKK40T-w0_6GWkuYQxXHVJzbMUmFnRZA&oe=6AFDB3F5"}, {"file_name": "screenshot_5_2560x1440.png", "id": "4555095974769722", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823783_4555095981436388_753918378542554668_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CbVe6y-NjgIQ7kNvwFOLDdM&_nc_oc=AdrYO9bd1kKXdOUBVAjkjF_5a0SDsagY9H7Tm-Mkn5wlL-y0fTc605OBYG3TqZG4_DI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRa2aDF2ES5pTtNCcmTm2YrlN5uNVEoRW8VYBsxyWWtbg&oe=6AFDDB37"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "1408697941473602", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825305_1408697951473601_2648615594967875121_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IQuYypj9DroQ7kNvwH6VDhk&_nc_oc=Adq99Wd7aBYbwkNVv95_VQrnS52V7HdbBWcxMw_1ukWOUrGIMYBrjxk9ISH1bz8NkoQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMMiPU5k6xucf2het-QUzqbqHVrWIV_Z4YdG4ij3-F5Q&oe=6AFDD361"}, "display_name": "City Builder", "keywords": ["city", "builder", "building", "sandbox", "simulation"], "long_description": "An empty stretch of fenced grassland, rolling hills all round, and a build wheel. Everything else is up to you.\n\nROADS THAT BUILD THEMSELVES\nPick Road, hold the trigger and sweep the laser across the land. Every tile you cross becomes road, and the tiles work out for themselves whether they are a straight, a bend, a T or a crossroads. Add a crosswalk where people cross. Hold B to erase.\n\nHOMES, DOWNTOWN, PARKS\nTwelve homes from a cottage to a villa, seven downtown blocks and five skyscrapers up to thirty metres, plus trees, fences, planters, parasols, street lights, traffic lights and signs. Point where it goes and it turns to face the nearest road on its own. Place as many as you like, turn one by hand with A, pick anything back up with the trigger.\n\nCARS THAT DRIVE YOUR STREETS\nTwelve vehicles from a sedan to a fire truck. Point at a road, press the trigger, and the car pulls away and drives your city: straight on, turning at junctions, turning round at dead ends, keeping its distance and stopping for you.\n\nWATCH IT GROW\nThe watch on your wrist counts the people, buildings and cars. Cross a hundred people and it is a village; a thousand, a town; five thousand, a city; twenty thousand, a metropolis. Switch the sky to golden hour and walk your own streets.\n\nThree ready-made towns to start from or take apart, undo, and a city that saves itself. Walk, run or sprint across three hundred metres of land.\n\nSingle player. Standing or roomscale.", "short_description": "Your own open land, a round build wheel, and a whole city to raise with your hands. Sweep the laser to paint roads that join themselves up, drop homes and towers that turn to face the street, and put cars on the road that drive round everything you build. People move in as your city grows. Full size, and you walk it."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/citybuilder/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/citybuilder/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1332452936614236"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1332471139945749", "version": "1.0.0"}, "id": "1615960993205318", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1332452929947570", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1332471139945749"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1615960993205318"}]}, "change_log": "v1.0.0 - initial release.", "created_date": 1789951370, "id": "1332471139945749", "version": "1.0.0", "version_code": 4, "release_status": "RELEASED",
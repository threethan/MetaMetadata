2572903862684_1098629066312972239_n.png", "id": "1272061931207772", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619646_1272061937874438_2500758606005063603_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jd4ud_A_XjwQ7kNvwFQUc1v&_nc_oc=AdkijBwQMhOhLS8GXGRgrc_ELb3J5j7o_4Uz1YbSRgm5FrWE0crLdm83UolKLWWAwDs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsHZftkVLhB0rKO223Wr3vkUmH1gtEJHAbAxbTOK7tQEw&oe=699EF6C6"}, {"file_name": "499303745_771192975599273_2925509274316122328_n.png", "id": "2553893141632767", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307574_2553893144966100_1099956943292571486_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LFiIdZiaD58Q7kNvwGV1Wqq&_nc_oc=AdmXE7CNEYxEcWFRXEKD0gOBBlTgr5yMLIz75Wb_yjfZrsnF9nX2kERXz4ExSIrFRSM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aftz88jq9qqUddwOSf69VWfUcvS4WS29IAbubDR6lYJAOg&oe=699F04E7"}, {"file_name": "499617806_2563134857369512_8646765098608795994_n.png", "id": "760350869840961", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619588_760350873174294_2393252051292747123_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vpjXSPNoVVwQ7kNvwGIMLjk&_nc_oc=AdmOpNpOX2MafybMipg3-wvKYdZSMn987f7ACFmQfgbzY_B24RdqjEHK9gO6SMDm1mw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afur8MQsA-NTp3F083m_dEseiphBQxwGTmzqvbj7xqaHIQ&oe=699ED262"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Clock", "keywords": ["clock", "time", "stopwatch", "timer", "alarm"], "long_description": "### \u23f0 Quest Clock \u2014 Time Tools, Reimagined for VR\n\n**Quest Clock** is your lightweight, always-available time companion for the Meta Quest. Whether you're immersed in a game, watching a movie, or browsing the web, Quest Clock helps you **stay on track** without breaking your VR flow.\n\n#### \ud83d\udee0\ufe0f Features:\n- **Digital Clock** \u2013 Keep an eye on the time, always.\n- **Timer** \u2013 Count down while you cook, exercise, or meditate.\n- **Stopwatch** \u2013 Track durations with precision.\n- **Alarm** \u2013 Set reminders without leaving VR.\n\n#### \ud83e\uddca Minimal Footprint, Maximum Utility:\nAt under **700 KB**, Quest Clock is **ultra-efficient**, consuming almost no memory or performance \u2014 perfect for multitasking without a drain on system resources.\n\n#### \ud83e\ude9f Floating Panels for Seamless Multitasking:\nEach tool appears as a **separate panel**, so you can position your clock, timer, or stopwatch wherever you need them \u2014 even **while other apps are running**.\n\n> \ud83c\udfa5 Watching a movie?  \n> \ud83c\udfae In the middle of a game?  \n> \ud83d\udcbb Working in your browser?  \n>  \n> **Your time tools are always within reach.**\n\n#### \ud83d\udd0b Lightweight & Efficient:\nQuest Clock is designed to run with **minimal memory usage** and **low CPU consumption**, so it doesn't interfere with other apps. It\u2019s the perfect time companion without draining resources or affecting performance.\n\n#### \u2728 Multi-tasking, Simplified:\nQuest Clock is always available, allowing you to **track time** while focusing on your VR experience. It ensures you can multitask", "short_description": "Stay on time in VR with Quest Clock \u2014 a lightweight, multitasking-friendly clock app for Meta Quest. Includes a timer, stopwatch, digital clock, and alarm. Panels can float beside any app, so you can track time while gaming, watching videos, or browsing. Under 700 KB and ultra-efficient, it's the perfect time companion for your headset."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nparashuram.github.io/quest-clock/privacy.md", "developer_terms_of_service_url": null, "publisher_name": "Ram N", "support_website_url": null, "website_url": "https://nparashuram.github.io/quest-clock/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id
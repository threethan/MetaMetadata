20f&oh=00_AQFkv9V3z_vj1HvRm9nYqNTEuF4X1UnzJn0mCoTo4sLX1w&oe=6A8EEE58"}]}, "id": "885682933883478", "locale": "en_US", "screenshots": [{"file_name": "491830904_963008105878930_5609919356161729188_n.png", "id": "1068600215452464", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499296077_1068600218785797_1895999254932483446_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T72d7iRaijQQ7kNvwGeX0Qh&_nc_oc=AdrNqNnuAgbVOwgGtY8w5yJaQuP8Co-F8bwXWXuqev47duo0X60tJZ_Wj2SZoGdg1zk&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHTkkMegpSaWHigu2MTTvx_aTspTJvRxFEdpsv9PI2Plg&oe=6A8ED7D7"}, {"file_name": "499303745_754707867096135_5615368708002933664_n.png", "id": "2427580197616957", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499298137_2427580200950290_1002148497796793518_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GRBp8HZFbhwQ7kNvwEcw1t8&_nc_oc=AdpuUGurajVq0I8GivcPaeX_Pd0acHUOyhZo7J9ApUeHAmo8O-4_nGzBLQzDXuN73pY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEd73dpjBZR72mMarF9RIYQOZY3CyiOiR0B5AWnBrf_9w&oe=6A8EC5BD"}, {"file_name": "491831060_722572903862684_1098629066312972239_n.png", "id": "1272061931207772", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499619646_1272061937874438_2500758606005063603_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zDiTfHQ0oNsQ7kNvwGjcJtu&_nc_oc=AdqfEkuhVuAjbJGwZSL71_XHhvgzvSbwO7aOv3I0ahu2PHxA-I9hSYOpMGXzi4ocb6o&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8-ANbsIvtB99DsxbL0ELq_g5HOezv15AIfA2oaQC5tw&oe=6A8EE7C6"}, {"file_name": "499303745_771192975599273_2925509274316122328_n.png", "id": "2553893141632767", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499307574_2553893144966100_1099956943292571486_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9P9RbVxSVBoQ7kNvwFSIUa7&_nc_oc=Adou8aRaARIV04j25G2RajOuuvcg3CYYB8fF-BQpvRo82O8Nsdf7R9IEpbWVmXZ1K0U&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFTziFx5NcUEQNYQ_-JGRvpgjH0qnozSqJd5sPxIYKLHw&oe=6A8EBDA7"}, {"file_name": "499617806_2563134857369512_8646765098608795994_n.png", "id": "760350869840961", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499619588_760350873174294_2393252051292747123_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3lLit6_VslkQ7kNvwGTQ4hZ&_nc_oc=Adqo3ZX4QZNypjKKaDLI75E5LxQnETTMvhUHsDJat4dxnmooyZhVlnNpCJPf7GXjXig&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFneapJphkbm5bmCfY2h5fRQ9xxdoHATJnid51wlk9ayQ&oe=6A8EC362"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Clock", "keywords": ["clock", "time", "stopwatch", "timer", "alarm"], "long_description": "### \u23f0 Quest Clock \u2014 Time Tools, Reimagined for VR\n\n**Quest Clock** is your lightweight, always-available time companion for the Meta Quest. Whether you're immersed in a game, watching a movie, or browsing the web, Quest Clock helps you **stay on track** without breaking your VR flow.\n\n#### \ud83d\udee0\ufe0f Features:\n- **Digital Clock** \u2013 Keep an eye on the time, always.\n- **Timer** \u2013 Count down while you cook, exercise, or meditate.\n- **Stopwatch** \u2013 Track durations with precision.\n- **Alarm** \u2013 Set reminders without leaving VR.\n\n#### \ud83e\uddca Minimal Footprint, Maximum Utility:\nAt under **700 KB**, Quest Clock is **ultra-efficient**, consuming almost no memory or performance \u2014 perfect for multitasking without a drain on system resources.\n\n#### \ud83e\ude9f Floating Panels for Seamless Multitasking:\nEach tool appears as a **separate panel**, so you can position your clock, timer, or stopwatch wherever you need them \u2014 even **while other apps are running**.\n\n> \ud83c\udfa5 Watching a movie?  \n> \ud83c\udfae In the middle of a game?  \n> \ud83d\udcbb Working in your browser?  \n>  \n> **Your time tools are always within reach.**\n\n#### \ud83d\udd0b Lightweight & Efficient:\nQuest Clock is designed to run with **minimal memory usage** and **low CPU consumption**, so it doesn't interfere with other apps. It\u2019s the perfect time companion without draining resources or affecting performance.\n\n#### \u2728 Multi-tasking, Simplified:\nQuest Clock is always available, allowing you to **track time** while focusing on your VR experience. It ensures you can multitask", "short_description": "Stay on time in VR with Quest Clock \u2014 a lightweight, multitasking-friendly clock app for Meta Quest. Includes a timer, stopwatch, digital clock, and alarm. Panels can float beside any app, so you can track time while gaming, watching videos, or browsing. Under 700 KB and ultra-efficient, it's the perfect time companion for your headset."}]}, "developer_name": null, "developer_privacy_policy_url": "https://axe-demo.github.io/quest-clock/privacy.md", "developer_terms_of_service_url": null, "publisher_name": "Ram N", "support_website_url": null, "website_url": "https://axe-demo.github.io/quest-clock", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "HAND_TRACKING", "OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27277792451837389"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491822817_1677364672929807_139140377373119126_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ztBwxytupUQ7kNvwEOD
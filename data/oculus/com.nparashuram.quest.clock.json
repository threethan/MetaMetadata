03679_1482967746047924_205990676631703062_n.png", "id": "957810223097739", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310840_957810226431072_5023698484076326741_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=khhIUehDl6MQ7kNvwFPe-JE&_nc_oc=Adod72yLUhKCaHILzp-NObtPv5LiVQMy0SrxK3MyLAJ_5cKcbXEB0FBBS6Sxe9sspaA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMgVJYt8UzsdGh45tb67M_OnqZf4BFpFhZacU4fDshtw&oe=6B01DBD4"}]}, "id": "672938401871986", "locale": "en_US", "screenshots": [{"file_name": "491830904_963008105878930_5609919356161729188_n.png", "id": "1068600215452464", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499296077_1068600218785797_1895999254932483446_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7XHwLNFQIv0Q7kNvwFT1Do_&_nc_oc=AdriqwMaDV6hglmXFicGgxTUUtEtWfatuVSFQeodTUFh7zEnj0U1PyJwQMuO-oEmVhs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQy5_mKpCUgEHC5v29SkXzE9Fuo_sD6eqagOUc5Dduw1Q&oe=6B01C297"}, {"file_name": "499303745_754707867096135_5615368708002933664_n.png", "id": "2427580197616957", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499298137_2427580200950290_1002148497796793518_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sVqB_2unHWQQ7kNvwEUO_k_&_nc_oc=AdojBlhbtMIy9GaK2Qus3NCk8j-Z4_A-uKhrRzvptj1tyU-59PTb82UQhTaLZflddKo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSoCfgrRiNKYSua5_FSbk7FWqtVkwcj7AFyRg4xTgjqOw&oe=6B01E8BD"}, {"file_name": "491831060_722572903862684_1098629066312972239_n.png", "id": "1272061931207772", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619646_1272061937874438_2500758606005063603_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i8Vbcc7bhh4Q7kNvwH-tZ5Y&_nc_oc=AdreL8nvgTGPZ5NUlGDssiB_cPR7VYD7Zok_TKJwQd_LWqVv-PRFFP3GrMBefKhzen8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRppAFeu1gZsvnTJmCO8qXy8b7zxYCtXDTU7E9rTRYHNQ&oe=6B01D286"}, {"file_name": "499303745_771192975599273_2925509274316122328_n.png", "id": "2553893141632767", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307574_2553893144966100_1099956943292571486_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z_lNWN7J80QQ7kNvwFeC2YC&_nc_oc=AdrCql6yHwa8ZHkZTgdY8JtMkNX6vXTzpu7fdA_okL5Dro5vv0BbxoVSJIDaBbTvM-s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhA8UIZjrYofWTBGnzHyHUtt_PSm2wN8_aINjDJk8IWA&oe=6B01E0A7"}, {"file_name": "499617806_2563134857369512_8646765098608795994_n.png", "id": "760350869840961", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619588_760350873174294_2393252051292747123_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xtZL80psBPQQ7kNvwH-siEe&_nc_oc=Adqu-I2N8cD5UVfWYx3GvvK5XaKOflzoUYl2NR2eqs03oozd_W_0azk2YuczqdirAo8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTk3IN1tzaY2EZAoddph_fqpZwtfTtjjqKMQYUHdSqamQ&oe=6B01E662"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Clock", "keywords": ["clock", "time", "stopwatch", "timer", "alarm"], "long_description": "### \u23f0 Quest Clock \u2014 Time Tools, Reimagined for VR\n\n**Quest Clock** is your lightweight, always-available time companion for the Meta Quest. Whether you're immersed in a game, watching a movie, or browsing the web, Quest Clock helps you **stay on track** without breaking your VR flow.\n\n#### \ud83d\udee0\ufe0f Features:\n- **Digital Clock** \u2013 Keep an eye on the time, always.\n- **Timer** \u2013 Count down while you cook, exercise, or meditate.\n- **Stopwatch** \u2013 Track durations with precision.\n- **Alarm** \u2013 Set reminders without leaving VR.\n\n#### \ud83e\uddca Minimal Footprint, Maximum Utility:\nAt under **700 KB**, Quest Clock is **ultra-efficient**, consuming almost no memory or performance \u2014 perfect for multitasking without a drain on system resources.\n\n#### \ud83e\ude9f Floating Panels for Seamless Multitasking:\nEach tool appears as a **separate panel**, so you can position your clock, timer, or stopwatch wherever you need them \u2014 even **while other apps are running**.\n\n> \ud83c\udfa5 Watching a movie?  \n> \ud83c\udfae In the middle of a game?  \n> \ud83d\udcbb Working in your browser?  \n>  \n> **Your time tools are always within reach.**\n\n#### \ud83d\udd0b Lightweight & Efficient:\nQuest Clock is designed to run with **minimal memory usage** and **low CPU consumption**, so it doesn't interfere with other apps. It\u2019s the perfect time companion without draining resources or affecting performance.\n\n#### \u2728 Multi-tasking, Simplified:\nQuest Clock is always available, allowing you to **track time** while focusing on your VR experience. It ensures you can multitask", "short_description": "Stay on time in VR with Quest Clock \u2014 a lightweight, multitasking-friendly clock app for Meta Quest. Includes a timer, stopwatch, digital clock, and alarm. Panels can float beside any app, so you can track time while gaming, watching videos, or browsing. Under 700 KB and ultra-efficient, it's the perfect time companion for your headset."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nparashuram.github.io/quest-clock/privacy.md", "developer_terms_of_service_url": null, "publisher_name": "Ram N", "support_website_url": null, "website_url": "https://nparashuram.github.io/quest-clock/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
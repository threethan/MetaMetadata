03679_1482967746047924_205990676631703062_n.png", "id": "957810223097739", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499310840_957810226431072_5023698484076326741_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3grKsNhvbqsQ7kNvwH1jegs&_nc_oc=AdqtfEUnpI66ArPyPc_BnRxlMTqQ0SO3cTlnkCClcogfcuNMa6Zqd6EVe8QUNSqJ3n4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS0MUKWRzkLLGNvZ7I6gYufePAS2_rOKSIypGKOWItQ7w&oe=6B0DB954"}]}, "id": "672938401871986", "locale": "en_US", "screenshots": [{"file_name": "491830904_963008105878930_5609919356161729188_n.png", "id": "1068600215452464", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499296077_1068600218785797_1895999254932483446_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=89GWDJ1zFssQ7kNvwE_IV5c&_nc_oc=AdpikvoCS1Xt0VN0Um4AG-6xAt36Sa3TnYixLcb_gfq6kxQLYyc5tdNk_2Ral-EcTUw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRxjOB5IuPkxa4ornj24g7mhPLWtndjv1YE8OV7sPTTyA&oe=6B0DA017"}, {"file_name": "499303745_754707867096135_5615368708002933664_n.png", "id": "2427580197616957", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499298137_2427580200950290_1002148497796793518_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fUrdqgU6jFsQ7kNvwG_rzXQ&_nc_oc=AdpYbDLHA4LfEFZMjNvJIlAXZJsdZuqnzfTL2LFfx2tH7zSkST8e9P2M66qINCr4mq0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRBy2QATphNNtcCQa46ixtWTf2y4mBtI0RwDL9UC0cLdw&oe=6B0DC63D"}, {"file_name": "491831060_722572903862684_1098629066312972239_n.png", "id": "1272061931207772", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619646_1272061937874438_2500758606005063603_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lVaQq9DPolQQ7kNvwH8hwLb&_nc_oc=Adr56a34HL3dXe4of2dFCRTu37SydG-FtjJpfo8eyE4plssRha6NvUHRHaiwPOieD5U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTy0eR3X5OxVNJldD1EKwq4gz_xxpZ4U_OoRP41d7vdAg&oe=6B0DB006"}, {"file_name": "499303745_771192975599273_2925509274316122328_n.png", "id": "2553893141632767", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307574_2553893144966100_1099956943292571486_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zU090bCtwBEQ7kNvwF0wB1t&_nc_oc=Adr2ubglgLnadchLm0UDkVSEt8oBgGh5cLxrxHUq2UQSRZ6ChMs3EyEERbhJ__Tn9RQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRtQLBW8VQMTPfNQEAq3jHTmd1MrIpiU5aI8O9DOhqi9w&oe=6B0DBE27"}, {"file_name": "499617806_2563134857369512_8646765098608795994_n.png", "id": "760350869840961", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619588_760350873174294_2393252051292747123_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ifSFffor5-cQ7kNvwHPVtNh&_nc_oc=AdrzQTog7kySw7KbmVoRZ0allIfgA70EuEGj9dz0EkKnNG_igbCETZ_FdShg4TmH8tc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQfyYBektL4O-3v4FLly4LKDp_zWZEBbk6_7DF8BSAl5Q&oe=6B0DC3E2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Clock", "keywords": ["clock", "time", "stopwatch", "timer", "alarm"], "long_description": "### \u23f0 Quest Clock \u2014 Time Tools, Reimagined for VR\n\n**Quest Clock** is your lightweight, always-available time companion for the Meta Quest. Whether you're immersed in a game, watching a movie, or browsing the web, Quest Clock helps you **stay on track** without breaking your VR flow.\n\n#### \ud83d\udee0\ufe0f Features:\n- **Digital Clock** \u2013 Keep an eye on the time, always.\n- **Timer** \u2013 Count down while you cook, exercise, or meditate.\n- **Stopwatch** \u2013 Track durations with precision.\n- **Alarm** \u2013 Set reminders without leaving VR.\n\n#### \ud83e\uddca Minimal Footprint, Maximum Utility:\nAt under **700 KB**, Quest Clock is **ultra-efficient**, consuming almost no memory or performance \u2014 perfect for multitasking without a drain on system resources.\n\n#### \ud83e\ude9f Floating Panels for Seamless Multitasking:\nEach tool appears as a **separate panel**, so you can position your clock, timer, or stopwatch wherever you need them \u2014 even **while other apps are running**.\n\n> \ud83c\udfa5 Watching a movie?  \n> \ud83c\udfae In the middle of a game?  \n> \ud83d\udcbb Working in your browser?  \n>  \n> **Your time tools are always within reach.**\n\n#### \ud83d\udd0b Lightweight & Efficient:\nQuest Clock is designed to run with **minimal memory usage** and **low CPU consumption**, so it doesn't interfere with other apps. It\u2019s the perfect time companion without draining resources or affecting performance.\n\n#### \u2728 Multi-tasking, Simplified:\nQuest Clock is always available, allowing you to **track time** while focusing on your VR experience. It ensures you can multitask", "short_description": "Stay on time in VR with Quest Clock \u2014 a lightweight, multitasking-friendly clock app for Meta Quest. Includes a timer, stopwatch, digital clock, and alarm. Panels can float beside any app, so you can track time while gaming, watching videos, or browsing. Under 700 KB and ultra-efficient, it's the perfect time companion for your headset."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nparashuram.github.io/quest-clock/privacy.md", "developer_terms_of_service_url": null, "publisher_name": "Ram N", "support_website_url": null, "website_url": "https://nparashuram.github.io/quest-clock/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb":
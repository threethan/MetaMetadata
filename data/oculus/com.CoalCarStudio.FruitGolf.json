uscdn.com/v/t64.5771-25/499619145_969548309098439_6545510301441491458_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wuBPfCNgW18Q7kNvwFDY416&_nc_oc=AdoNt3QeOIaffwGVojlvhgo6e6NzwRmAlP7BXNg4Rjdnbc6OiNVlxoTVei4u_NN5G4I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af36DZLcA5sSfxz2hz2cfn5H_Bbm6Uzjvy0T6_HjNNGzaA&oe=69E39CFD"}, "display_name": "Fruit Golf", "keywords": ["family", "party", "multiplayer", "coop", "battle"], "long_description": "# APRIL EVENT!  Tee off at the Orchard Open \ud83c\udf4f \nCause chaos, sink putts, and earn the Green Master Avatar. **Only available during April\u2019s limited-time event!**\n\n# A Party Game Built on Pure Sabotage.\nTake turns surviving the course while your friends unleash sabotage; sharks, explosions, flying pigs, and total nonsense. Winning is optional. Ruining someone else\u2019s turn is mandatory.\n{1178795550894396}**Choose Carefully. Every Fruit Plays by Different Rules.** Every fruit bends the rules in its own way, with unique physics and quirks that can turn a simple putt into a power move\u2026 If you can master it! \n{871299389056939}\n# HOW TO PLAY:\n\n# MULTIPLE HEADSETS\nGo head-to-head in VR! Online or in-person, take turns golfing and sabotaging.\n\n# ONE HEADSET HOTSEAT\nOne headset, many saboteurs! Friends join FREE on phones (www.fruitgolf.com) to wreak havoc.\n\n# SOLO PRACTICE\nHone your swing, conquer challenges, and enjoy the hilarious physics of Fruit Golf! \n{2057401171694269}**Unlock the Drip. Flex the Chaos.** Crush challenges, unlock ridiculous gear, and make sure everyone knows you did it first.\n{861375006303270}**Weaponized Nonsense.** Sabotage every move with floppy sharks, ectoplasm, portals, mouse traps and more! If it causes chaos, it\u2019s fair game.\n{3524926690977542}**Golf Course or Battle Arena?** Fight it out in wildly themed spaces; underwater, in orbit, on the kitchen counter, then stack the deck with obstacles and turn it into pure mayhem!", "short_description": "A Game Built on Sabotage! One headset, many saboteurs! Mobile friends join for FREE (www.fruitgolf.com) to add to the chaos. \n\nAPRIL EVENT: Tee off at the Orchard Open \ud83c\udf4f Cause chaos, sink putts, and earn the Green Master Avatar. Only available during April\u2019s limited-time event.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fruitgolf.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Coal Car Studio", "support_website_url": "https://www.fruitgolf.com/contact-us", "website_url": "https://www.fruitgolf.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "26170944809242107"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619174_2400834177082868_8032748148184514501_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UCUd1BVFYC4Q7kNvwEjy_KM&_nc_oc=AdpJ2HmI8xQ98JXpNnh_PwzTiYjzuT3Sx0QCHYnVuajRYbZ0dX-PcLPcOBJH2j5z8eM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1jQq7zb0-ueD52gN6TDACsMDXDat0gZIES9pKP0-3t4g&oe=69E38804"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Fruit Golf", "platform": "ANDROID_6DOF", "contex
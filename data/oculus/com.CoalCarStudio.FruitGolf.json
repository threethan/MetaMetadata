oDjnwQ7kNvwFRdsdi&_nc_oc=AdoqoqlfKMZqZ6b7_Spgjd0BQe3TlOZGxp0jB2aL2mqTsz44he7ty9T634G9QQyNcBU&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShSwo7O0r1zl_7ixdxVzU_n8yUMIwaGeHhzYZjvkZo_w&oe=6AFF2F90"}, {"file_name": "Adobe Express - file (2).png", "id": "1069933685158158", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622276_1069933688491491_8467484657226179882_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nmylSibE5DEQ7kNvwGFAc3_&_nc_oc=AdqsTCSXgoc975XD8sYWVlP1yt8bhfcY4j702sADv-jaADXBG1GE42Y90iFHzIRwi4k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSz9hiaiw3BZqg1ktE1EDxr40HkEZ1bTSf5sPy_ppjRmw&oe=6AFEFE88"}, {"file_name": "Pirate 2 - Golfer + shark.png", "id": "1274993477981891", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618069_1274993481315224_8528695110052518896_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UpgLy8EWX-kQ7kNvwHRxqkx&_nc_oc=AdrP6ZgBkeYUv0SB3Qp8VeZ9iyK47MmPO3chKmxywp6kvZewDHvU5dGGepYnE8sE5wI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQzgLLa3Cq2GPFaGGGJAvQZ3etgcqGSN1nP1SDPvYAvg&oe=6AFF1102"}, {"file_name": "Adobe Express - file.png", "id": "4261575347491675", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499619697_4261575350825008_4656764706867764070_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sQecO3_cvioQ7kNvwEWEQn3&_nc_oc=AdrmcrNBrKNu44vwKb688uW5ZEjpgbJuu04dqUFTcMvOmrKIsU-QbuqKuj-BU6ENoys&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShd_P7cldKgdv1w8qOFrRVkNcWP9IKtzkeqZOqsCWHdA&oe=6AFF2463"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fruitgolf_splash_screen_psd_B.png", "id": "1541089814205533", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623585_1541089817538866_301293638521670236_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LqaP1bbGtwQQ7kNvwGnl3UV&_nc_oc=Ado4CY4IfrEKt4xhIHiII9OE_2m4T0SjiomFpJdQQUuGqtEBWfQwOTjvQaqKziIpQuE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTO5Ox40X6qoFRrasGFOTQhb41W_oMX5octi-2K-E1AwQ&oe=6AFF2B90"}, "display_name": "Fruit Golf", "keywords": ["family", "party", "multiplayer", "coop", "battle"], "long_description": "# A Party Game Built on Pure Sabotage.\nTake turns surviving the course while your friends unleash sabotage; sharks, explosions, flying pigs, and total nonsense. Winning is optional. Ruining someone else\u2019s turn is mandatory.\n{1178795550894396}\n**Choose Carefully. Every Fruit Plays by Different Rules.** Every fruit bends the rules in its own way, with unique physics and quirks that can turn a simple putt into a power move\u2026 If you can master it! \n{871299389056939}\n# HOW TO PLAY:\n\n# MULTIPLE HEADSETS\nGo head-to-head in VR! Online or in-person, take turns golfing and sabotaging.\n\n# ONE HEADSET HOTSEAT\nOne headset, many saboteurs! Friends join FREE on phones (www.fruitgolf.com) to wreak havoc.\n\n# SOLO PRACTICE\nHone your swing, conquer challenges, and enjoy the hilarious physics of Fruit Golf! \n{2057401171694269}**Unlock the Drip. Flex the Chaos.** Crush challenges, unlock ridiculous gear, and make sure everyone knows you did it first.\n{861375006303270}**Weaponized Nonsense.** Sabotage every move with floppy sharks, ectoplasm, portals, mouse traps and more! If it causes chaos, it\u2019s fair game.\n{3524926690977542}**Golf Course or Battle Arena?** Fight it out in wildly themed spaces; underwater, in orbit, on the kitchen counter, then stack the deck with obstacles and turn it into pure mayhem!", "short_description": "A Game Built on Sabotage! One headset, many saboteurs! Mobile friends join for FREE (www.fruitgolf.com) to add to the chaos. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fruitgolf.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Coal Car Studio", "support_website_url": 
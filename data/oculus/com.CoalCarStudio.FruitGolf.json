wY980Q7kNvwHAuN7l&_nc_oc=AdpA7nlVsllF_MoxGmY6UVoaRawnxJIW1Y-9mlHlV8PKBj25y1RVe9x81Vd1pMuWP2g&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYFQbCXahCS_kBfs0cUMiDK_FMcEBzOAdBWJDISq4ajA&oe=6B086A10"}, {"file_name": "Adobe Express - file (2).png", "id": "1069933685158158", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499622276_1069933688491491_8467484657226179882_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tY_kD3kqdjQQ7kNvwHdBsPn&_nc_oc=AdrQPGAxNskOT5nrc_INm7i8Dxa6jkZNCbOgOT0MLeog01yJDaVPXC8Oz9VmysURX8c&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMZ5-EsVW_Tn4Q_ipmyzHlZxDbqdsHwL3tz4gQenrNIA&oe=6B087148"}, {"file_name": "Pirate 2 - Golfer + shark.png", "id": "1274993477981891", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499618069_1274993481315224_8528695110052518896_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4I64H83vHJEQ7kNvwEDU1R6&_nc_oc=Adr7MsXGd5L2y-AdPmvrx1X3Ho4E57GJR6SyODrjoK2CoMYY-Nn_sz4n6ZR_zqaNadU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLxZI2c2peWhGiaadUdmfXaMhaeyMC9EgA-txiGZqbYQ&oe=6B084B82"}, {"file_name": "Adobe Express - file.png", "id": "4261575347491675", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/499619697_4261575350825008_4656764706867764070_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3bR_4fn9pw4Q7kNvwEwXYF2&_nc_oc=AdpVkVN-JR8BA3OMJo9nKKJTc8t7fu3FZhRwUS2R2X8Ut543rYESA52WppeEbECehmM&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQayxf5Dz_Xh3ziOvHK9Gtixqex1b0zqP73i9OMBp2aBg&oe=6B085EE3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fruitgolf_splash_screen_psd_B.png", "id": "1541089814205533", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499623585_1541089817538866_301293638521670236_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JVt6QSEs-UYQ7kNvwEcgkGQ&_nc_oc=Adpgch6LULNiyHKyFqCeOjYRk9h3oeCS7GiVEtQUPxUyL3RT5aKUZrp0Ns9xMBgEeec&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNBTSDyTvgMD7iJF6Dqpy1QJPOkhOSEyJu66DJgKRHpQ&oe=6B086610"}, "display_name": "Fruit Golf", "keywords": ["family", "party", "multiplayer", "coop", "battle"], "long_description": "# A Party Game Built on Pure Sabotage.\nTake turns surviving the course while your friends unleash sabotage; sharks, explosions, flying pigs, and total nonsense. Winning is optional. Ruining someone else\u2019s turn is mandatory.\n{1178795550894396}\n**Choose Carefully. Every Fruit Plays by Different Rules.** Every fruit bends the rules in its own way, with unique physics and quirks that can turn a simple putt into a power move\u2026 If you can master it! \n{871299389056939}\n# HOW TO PLAY:\n\n# MULTIPLE HEADSETS\nGo head-to-head in VR! Online or in-person, take turns golfing and sabotaging.\n\n# ONE HEADSET HOTSEAT\nOne headset, many saboteurs! Friends join FREE on phones (www.fruitgolf.com) to wreak havoc.\n\n# SOLO PRACTICE\nHone your swing, conquer challenges, and enjoy the hilarious physics of Fruit Golf! \n{2057401171694269}**Unlock the Drip. Flex the Chaos.** Crush challenges, unlock ridiculous gear, and make sure everyone knows you did it first.\n{861375006303270}**Weaponized Nonsense.** Sabotage every move with floppy sharks, ectoplasm, portals, mouse traps and more! If it causes chaos, it\u2019s fair game.\n{3524926690977542}**Golf Course or Battle Arena?** Fight it out in wildly themed spaces; underwater, in orbit, on the kitchen counter, then stack the deck with obstacles and turn it into pure mayhem!", "short_description": "A Game Built on Sabotage! One headset, many saboteurs! Mobile friends join for FREE (www.fruitgolf.com) to add to the chaos. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fruitgolf.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Coal Car Studio", "support_website_url": 
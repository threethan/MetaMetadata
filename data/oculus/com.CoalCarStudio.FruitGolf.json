qAQ&oe=6A637782"}, {"file_name": "Adobe Express - file (2).png", "id": "1069933685158158", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499622276_1069933688491491_8467484657226179882_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZYYb8oeoTHAQ7kNvwEOcpgZ&_nc_oc=Adp6L8c9msDjRwo2zjXhw-QizYeYmLrVwe6Nhn_jdB_y09Z2JiUHKrfyfHzzvwJr6Vo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAw8caHIPFQ8PdlqZiD53_lu21rrLxlTl0F8xIWdLG_3w&oe=6A636D88"}, {"file_name": "Pirate 2 - Golfer + shark.png", "id": "1274993477981891", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618069_1274993481315224_8528695110052518896_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rpRg6OH6afIQ7kNvwEfEw8z&_nc_oc=AdqdI_aJYHCBCXyI9ruqzcRAJcBhdmBAnnKS4yNM5XprW6USrJxOjJfHv1fMVu5bWF8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDkbeTmUtDcW30NTVv2-sqLCdKHU-IduwB-BsoKOdMlMg&oe=6A638002"}, {"file_name": "Adobe Express - file.png", "id": "4261575347491675", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619697_4261575350825008_4656764706867764070_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iUwEyHkzDHUQ7kNvwEqxtoi&_nc_oc=Adp7WM2EpQPhAnpbtlSzrcxlujI4KiOfuoJqB--NkSQbDT3Cyrn7eXx8eLIEKFWKlwY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCM-exzSF-oEEiqPsK9K1Qj5AGUJdngT-I-F79oLcBDxw&oe=6A635B23"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fruitgolf_splash_screen_psd_B.png", "id": "1541089814205533", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623585_1541089817538866_301293638521670236_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lZ0aY4aGU2EQ7kNvwFUjQdN&_nc_oc=AdoxfLIgpttnC-q4S-gTV8aQwqUC_Fivf5GGRYBykqjP7_oahvx35x2B0l0-NSLy_VI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAeBtyd1Pt8EIFq6rVml3xZL_235Br_nooPHEtEJr_k7w&oe=6A636250"}, "display_name": "Fruit Golf", "keywords": ["family", "party", "multiplayer", "coop", "battle"], "long_description": "# A Party Game Built on Pure Sabotage.\nTake turns surviving the course while your friends unleash sabotage; sharks, explosions, flying pigs, and total nonsense. Winning is optional. Ruining someone else\u2019s turn is mandatory.\n{1178795550894396}\n**Choose Carefully. Every Fruit Plays by Different Rules.** Every fruit bends the rules in its own way, with unique physics and quirks that can turn a simple putt into a power move\u2026 If you can master it! \n{871299389056939}\n# HOW TO PLAY:\n\n# MULTIPLE HEADSETS\nGo head-to-head in VR! Online or in-person, take turns golfing and sabotaging.\n\n# ONE HEADSET HOTSEAT\nOne headset, many saboteurs! Friends join FREE on phones (www.fruitgolf.com) to wreak havoc.\n\n# SOLO PRACTICE\nHone your swing, conquer challenges, and enjoy the hilarious physics of Fruit Golf! \n{2057401171694269}**Unlock the Drip. Flex the Chaos.** Crush challenges, unlock ridiculous gear, and make sure everyone knows you did it first.\n{861375006303270}**Weaponized Nonsense.** Sabotage every move with floppy sharks, ectoplasm, portals, mouse traps and more! If it causes chaos, it\u2019s fair game.\n{3524926690977542}**Golf Course or Battle Arena?** Fight it out in wildly themed spaces; underwater, in orbit, on the kitchen counter, then stack the deck with obstacles and turn it into pure mayhem!", "short_description": "A Game Built on Sabotage! One headset, many saboteurs! Mobile friends join for FREE (www.fruitgolf.com) to add to the chaos. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fruitgolf.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Coal Car Studio", "support_website_url": "https://www.fruitgolf.com/contact-us", "website_url": "https://www.fruitgolf.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "10237
jOkEYQ7kNvwEIo_7Q&_nc_oc=AdpnBaHWY4wRQ8OzIsnDteYufC1RiCd027T5ZcZBf0ayDSOSezA6_Fb34P-xH6yk3wA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTAunGHXBylLEvFv3tqxYED5_Dwe4XoQQKTWUM2kb3c2Q&oe=6B0C5E90"}, {"file_name": "Adobe Express - file (2).png", "id": "1069933685158158", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622276_1069933688491491_8467484657226179882_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a0wOXY6uImkQ7kNvwEy0nLw&_nc_oc=Adr8qZdSfZZBzv73U8jjARF3tkUKEjm9SU2kzn_wQgX7rrO3XHJ76fzsJRiTMDOTxlE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT4ZfeCC55_MnPKaV-jVVFY8S01MppI-v1ZZ--NGqg0nw&oe=6B0C65C8"}, {"file_name": "Pirate 2 - Golfer + shark.png", "id": "1274993477981891", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618069_1274993481315224_8528695110052518896_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G35ISfDXSY4Q7kNvwGYDLmU&_nc_oc=AdoGYzKxzpRU2DhoT8OpYjn71WBtwgoEoHN0q2tW-LtC0CkuFTv3hZTHNA9P9Qo66FE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRz1W0l8j1loO2VvR2Q_8KzNxCrK5-sw4pJQPNmv75HZg&oe=6B0C7842"}, {"file_name": "Adobe Express - file.png", "id": "4261575347491675", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619697_4261575350825008_4656764706867764070_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3_v-F1SWjK8Q7kNvwFAOnUw&_nc_oc=AdpDguiaTBaW8nRyZtGcIgbc1s-yPG7X10ttvpAWWXIA1Cvd3xggSxni06pANrgK0XI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ-VzI9Fs7td0wBmp6Dgv14El0k3-ddDQUYxlOLTB2u3g&oe=6B0C5363"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fruitgolf_splash_screen_psd_B.png", "id": "1541089814205533", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623585_1541089817538866_301293638521670236_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_IphEbJLKdcQ7kNvwEOXjh5&_nc_oc=Adot1uBeahdmQg4zBx_4GJDLO5ekVsfCm8kFjFh-35LwQKbaSYTQdxDuI8sGRmEZXl0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQeC88PSkjjqnirHiDkavw1XCENjL38fMXGkHJcbBQ_bA&oe=6B0C5A90"}, "display_name": "Fruit Golf", "keywords": ["family", "party", "multiplayer", "coop", "battle"], "long_description": "# A Party Game Built on Pure Sabotage.\nTake turns surviving the course while your friends unleash sabotage; sharks, explosions, flying pigs, and total nonsense. Winning is optional. Ruining someone else\u2019s turn is mandatory.\n{1178795550894396}\n**Choose Carefully. Every Fruit Plays by Different Rules.** Every fruit bends the rules in its own way, with unique physics and quirks that can turn a simple putt into a power move\u2026 If you can master it! \n{871299389056939}\n# HOW TO PLAY:\n\n# MULTIPLE HEADSETS\nGo head-to-head in VR! Online or in-person, take turns golfing and sabotaging.\n\n# ONE HEADSET HOTSEAT\nOne headset, many saboteurs! Friends join FREE on phones (www.fruitgolf.com) to wreak havoc.\n\n# SOLO PRACTICE\nHone your swing, conquer challenges, and enjoy the hilarious physics of Fruit Golf! \n{2057401171694269}**Unlock the Drip. Flex the Chaos.** Crush challenges, unlock ridiculous gear, and make sure everyone knows you did it first.\n{861375006303270}**Weaponized Nonsense.** Sabotage every move with floppy sharks, ectoplasm, portals, mouse traps and more! If it causes chaos, it\u2019s fair game.\n{3524926690977542}**Golf Course or Battle Arena?** Fight it out in wildly themed spaces; underwater, in orbit, on the kitchen counter, then stack the deck with obstacles and turn it into pure mayhem!", "short_description": "A Game Built on Sabotage! One headset, many saboteurs! Mobile friends join for FREE (www.fruitgolf.com) to add to the chaos. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fruitgolf.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Coal Car Studio", "support_website_url": 
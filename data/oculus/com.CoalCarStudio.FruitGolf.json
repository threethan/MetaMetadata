hc=hrQFFTTdozkQ7kNvwEXSrhC&_nc_oc=Adr89QKKShzMa6qwaJWho99BaEAlt9ySfoyJWPzdlqcCmULSVSBIviSO4N2XOL5n5lk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0W9yfkh9gNf_X0gBwfZcW_yO7sJl9rI_F7yXLrrOFSjQ&oe=69F0B910"}, {"file_name": "FG5.png", "id": "645327648525002", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619063_645327651858335_2294161870328465504_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-c8smafCTgoQ7kNvwFYch6g&_nc_oc=Adrqw3OZufamcrXhxU3Q8uLkUxnh9l_8pB_y0XSZ_4Wj3VG9Q9a57-XeYZs-juMrK7M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2v4AdbNXmk59DWUmYzxGZj_WuBYPr-bUDZsHsvgRNIkA&oe=69F09B5B"}, {"file_name": "FG4.png", "id": "1044876027257346", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618245_1044876030590679_4371021885450027485_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oZiAwhSndSYQ7kNvwFfSVZg&_nc_oc=Adrg6Z3EcVEa_iep06kktdUVQBHZJdiSkgDG__1GMsrKkCuiUXdr8osUndgOdUqa5K0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0jf38TfPkTCgL2nd4TZe-WAXdvMZXpPBNAoeQU4YANcg&oe=69F0A6E4"}, {"file_name": "FG3.png", "id": "713292034662358", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499295424_713292037995691_2313073172412145197_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Ha3O1Ntd8sQ7kNvwEJElHy&_nc_oc=AdquqSKXm3MTwFUVWZ3gTHPFQLKI0D8GOA3tpu4ssP6Bxxe9S-GzYxNBG34lU925CzU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2ShZ_OIZVFF_Q2sufBd-y9VIuJiFo2o-yLzTeFz27XEg&oe=69F0B357"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fruit Golf", "keywords": ["golf", "family", "party", "mobile", "crazy"], "long_description": "**Fruit Golf is currently in Early Access!**  We\u2019re just getting started! Follow our progress and check out the roadmap at www.fruitgolf.com/roadmap to see what juicy updates are coming next! \n---\nEver dreamt of putting a pineapple down a pirate ship while your friends go full sabotage with sharks and exploding barrels? Fruit Golf turns every swing into a chaotic, laugh-out-loud party in VR.\nIt\u2019s a game that the whole family will go bananas fore!\n{1035746104941681}\n{2182983618795384}\n**VR SHOWDOWN:** Go head-to-head in VR! Online or in-person, take turns golfing and sabotaging.\n---\n**THE GOLFING GATHERING:** One headset, many saboteurs! Friends join FREE on phones (www.fruitgolf.com) to wreak fruity havoc.\ud83d\ude08\n---\n**SOLO PRACTICE:** Hone your swing, conquer challenges, and enjoy the hilarious physics of Fruit Golf\n---\n{1221193462578863}\n**Pick Your Perfect Fruit!** Every fruit isn't just a ball, it's a strategy! Each has unique physics to master.\n{1430788861608346}\n**Unlocks & Customization!** Style your swing! Complete challenges to unlock gear and turn every round into a fruit-smashing fashion statement.\n{1309311774534866}\n{1840725370201823}\n**UNIQUE FRUIT PHYSICS!** \ud83c\udf4d Discover how each fruit plays.\n---\n\n**CREATIVE OBSTACLES!** \ud83e\udd88 Floppy Sharks, Dust Devils, Dynamite, Zombie Arms, Mouse Traps, and Many More!\n---\n\n**UNLIMITED FUN!** \ud83d\uddfa\ufe0f Themed courses where you can mix and match obstacles.\n{1254350492851750}\n\n\n", "short_description": "Have you ever dreamt of putting a pineapple down a pirate ship as your friends place sharks and explosive barrels in front of you in attempts to sabotage a perfect golf swing?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fruitgolf.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Coal Car Studio", "support_website_url": "https://www.fruitgolf.com/contact-us", "website_url": "https://www.fruitgolf.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "SPORTS"], "
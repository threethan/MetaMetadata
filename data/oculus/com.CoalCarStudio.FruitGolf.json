_nnAQ7kNvwGXe56k&_nc_oc=AdodBchoqs9vd_dAFkLMS6S5fV9EgA_rkuqza9GfT8nkEqrD_370pd4nMumGebyusu0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af08m6ZoiYlXMn9sBIudregnOREgr8BhsP2wqIx9whUZvw&oe=69D7AC90"}, {"file_name": "FG5.png", "id": "645327648525002", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499619063_645327651858335_2294161870328465504_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cwr-6ENKfOsQ7kNvwEY0AjP&_nc_oc=AdoXXzMIpqkqB6FvZVu1A-Oe8kA__rTdKFUA3lX1j5JpaB8rIvkMlJKa5LFAWKYxT1E&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0p3sMuyxxd5If3KYJuXF1yNVMh4burNiqJ_vCu_duDTQ&oe=69D78EDB"}, {"file_name": "FG4.png", "id": "1044876027257346", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499618245_1044876030590679_4371021885450027485_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0MnfyC-5ffkQ7kNvwGEgoVK&_nc_oc=AdreYQKbZl9sqiTnNhOrM3jxS3utI2asmCRGa-e4bfslQdYGM2B035D9xHUyVD0fGU8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3zr2lmWBzSKuGPvWVFj1d-UEV0CBRNuhinwmfcwsqWUA&oe=69D79A64"}, {"file_name": "FG3.png", "id": "713292034662358", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499295424_713292037995691_2313073172412145197_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8NdkgkIOHy8Q7kNvwFCVhVO&_nc_oc=Ado923wObi7UYUZ8ucbRkVAsqIJcaqjJOKyi3FxIMh6FG-V4z3R3ajodwi388zVmwSM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ZiL_dunes2QLjd6KP5x_uxFtjrFmzt8le_ZC_k7-vtg&oe=69D7A6D7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fruit Golf", "keywords": ["golf", "family", "party", "mobile", "crazy"], "long_description": "**Fruit Golf is currently in Early Access!**  We\u2019re just getting started! Follow our progress and check out the roadmap at www.fruitgolf.com/roadmap to see what juicy updates are coming next! \n---\nEver dreamt of putting a pineapple down a pirate ship while your friends go full sabotage with sharks and exploding barrels? Fruit Golf turns every swing into a chaotic, laugh-out-loud party in VR.\nIt\u2019s a game that the whole family will go bananas fore!\n{1035746104941681}\n{2182983618795384}\n**VR SHOWDOWN:** Go head-to-head in VR! Online or in-person, take turns golfing and sabotaging.\n---\n**THE GOLFING GATHERING:** One headset, many saboteurs! Friends join FREE on phones (www.fruitgolf.com) to wreak fruity havoc.\ud83d\ude08\n---\n**SOLO PRACTICE:** Hone your swing, conquer challenges, and enjoy the hilarious physics of Fruit Golf\n---\n{1221193462578863}\n**Pick Your Perfect Fruit!** Every fruit isn't just a ball, it's a strategy! Each has unique physics to master.\n{1430788861608346}\n**Unlocks & Customization!** Style your swing! Complete challenges to unlock gear and turn every round into a fruit-smashing fashion statement.\n{1309311774534866}\n{1840725370201823}\n**UNIQUE FRUIT PHYSICS!** \ud83c\udf4d Discover how each fruit plays.\n---\n\n**CREATIVE OBSTACLES!** \ud83e\udd88 Floppy Sharks, Dust Devils, Dynamite, Zombie Arms, Mouse Traps, and Many More!\n---\n\n**UNLIMITED FUN!** \ud83d\uddfa\ufe0f Themed courses where you can mix and match obstacles.\n{1254350492851750}\n\n\n", "short_description": "Have you ever dreamt of putting a pineapple down a pirate ship as your friends place sharks and explosive barrels in front of you in attempts to sabotage a perfect golf swing?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fruitgolf.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Coal Car Studio", "support_website_url": "https://www.fruitgolf.com/contact-us", "website_url": "https://www.fruitgolf.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "
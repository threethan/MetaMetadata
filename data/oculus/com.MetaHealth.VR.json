7375980307964413_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MMDcaZ0AppEQ7kNvwH5QhkM&_nc_oc=AdqqeMLD44egS7pbAQfKMvMmhSdxFTaLh7SS2VANta02rSl1MBt4bhPJamFLCsFVWCk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-dWLtlwDXIlraaVVkkfzFJ9LGgQcTCLdE1uzFLDoaJdg&oe=6A296697"}, {"file_name": "loginimage5 2.png", "id": "3159954997524540", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499620429_3159955000857873_6368218123290472290_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KHGcZoVuLygQ7kNvwEYO5m0&_nc_oc=AdqAS2NJL-0DlBUEwHF4VwInrv5XsCtzOo9xoB-i4e2AkRcXgstjIPFyBfAKOkgT7Yc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_fFeW79P7AOGMuWfthBjt4PpZ91OHvZeP7Ouw325WfRQ&oe=6A295946"}, {"file_name": "loginimage3 2.png", "id": "1746770073027214", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499620497_1746770076360547_1312580237750881977_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ym6qic7zyBMQ7kNvwHgwCQs&_nc_oc=AdohEREVqp0IBYm-YUdTAmZobvihVwifdqGr4iiP7-6os-jlK_QhRaTkM4NvZVMSItg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af94Imtg2NJcOljXYXC5wh1SfYEjJTIwE962Bqx_MyOeOw&oe=6A2958F3"}, {"file_name": "loginimage4 1.png", "id": "1344864184158916", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619113_1344864187492249_2137496741968173928_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PCTuwrQnf5kQ7kNvwFsPVi6&_nc_oc=AdpPpX3LaVho-0QXN3CUmLvZ26qU6mBA803kr4k2T-9WqRZtGWgdDmjOSwYklDVACSc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-MzHvIeIVeZjjgWrH0Kr1Iwbsr-UjOCs_B1K3lQY_HOQ&oe=6A298B5F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MetaHealth VR", "keywords": [], "long_description": "MetaHealth is an innovative virtual reality clinical simulation platform designed for training and assessing medical skills. The system combines an immersive VR application with a web-based educational management platform, allowing students and healthcare professionals to interact with virtual patients in a simulated environment that faithfully reproduces clinical practice. The web platform allows for the creation of medical cases for use in VR.\n\nIn the virtual environment, users conduct comprehensive consultations, from medical history taking to physical examinations with virtual instruments such as stethoscopes and otoscopes. Virtual patients respond dynamically to the professional's actions, creating an interactive and realistic experience. At the same time, the web platform allows for detailed configuration of clinical cases, with customization of symptoms, disease progression, additional tests, and evaluation criteria. Teachers and institutions can create learning paths, assign weights to different actions, and monitor student performance through automated reports.\n", "short_description": "MetaHealth is an innovative virtual reality clinical simulation platform designed for training and assessing medical skills. The system combines an immersive VR application with a web-based educational management platform, allowing students and healthcare professionals to interact with virtual patients in a simulated environment that faithfully reproduces clinical practice. The web platform allows for the creation of medical cases for use in VR."}, {"images": {"nodes": [{"file_name": "Group 34.png", "id": "1478594637095464", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619646_1478594640428797_198953657770161859_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HfOuc9FjLQUQ7kNvwGATliR&_nc_oc=AdqwrVkp9lS7x-5ALKDqJ7_JQRVs8NeMk_nASkcJGRk9zgwhsV4TAJ5F2vZHPsqDB4w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9sJJ_ZaMy0l5aqknkszgwcmy6RKrBKMjogS0APim_gfA&oe=6A2986D1"}, {"file_name": "Group 34 (1).png", "id": "1143638905491624", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619465_1143638908824957_2862711347232342322_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Gd8_DI86GsQ7kNvwFEU49B&_nc_oc=Adqz_HEhyHsKh65KcWVm_uoYUDrvkxmaOw5-fKoFPrSjyk0a_iYmlB6SOlDTgXudMLw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_A-X9SvykhyxIXfSG-TvYTIGr1DQYdSu_2pwVYYYimEg&oe=6A29684B"}]}, "id": "1611115696852627", "locale": "pt_BR", "screenshots": [{"file_name": "loginimage1 2.png", "id": "1289952576419030", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499292329_1289952583085696_3329826268479956252_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hfytJHM2dxsQ7kNvwHGy3Xr&_nc_oc=AdqWXK8G4AOC151SZDStEua9YV2ZZIcxHKVnu7cCNpd44wTqIgs60aOBnt3ycA-satE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-tAM1mDgm21Okyjji7kiXkSqrsK_8l70Vol9Dnf0L7A&oe=6A29590B"}, {"file_name": "loginimage2 2.png", "id": "751790477901137", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499292232_751790481234470_5521188047417205046_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CxKbDkQLNXcQ7kNvwFAAPx5&_nc_oc=AdqBa6KJauv-svbuhBlmXrpHCbbjGDDd3MyJ98urmhll2fYHe1IWTJXSB8qTM73wlGg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_RqIPhYPhTTFSf5PBi4NQ6n4BY2wcsPiUOZWDrCTVAEQ&oe=6A296716"}, {"file_name": "loginimage5 2.png", "id": "985112617280060", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618064_985112620613393_3385340934434943416_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4e-DWw0kX1oQ7kNvwHjmBuM&_nc_oc=AdpI4n8R1edDlZqZJOF5b6n6CqgtvmG6qZmQvazbhajk2XUq2L7Vj13XX8-0BBL1b-8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-737737vmdLSqiHlZud6PEFEW80Vyn1Rz9DhwK4Jq3jg&oe=6A298163"}, {"file_name": "loginimage3 2.png", "id": "1640445797080740", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499296027_1640445800414073_32437411889362056_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=78C3A47mRrkQ7kNvwG24F0D&_nc_oc=Adr0od-E0XBi_paiTj0jlV1PT1nxLOxlvgXVWWsH3xnMU-8LBod-SunG8ZPUxoBMO5c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_rV0DZTcIu3soZpHiiaA_NqC4TJQpE4aH6c0uqF7-Nzw&oe=6A297F7B"}, {"file_name": "loginimage4 1.png", "id": "1862934484419640", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618252_1862934487752973_1780305982521045491_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KD9LQKIWZNEQ7kNvwECWvlJ&_nc_oc=Adp2aBhbksucMMyY73dQzfY1LdlkxoUmOvw1JilolrHbArxEw3kCFdid0MsvrQ328z8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97z6OD0SL4CDWQkTAkELGTZ0L--azV5FM4UsOSjRgu-w&oe=6A295FA9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MetaHealth VR", "keywords": [], "long_description": "O MetaHealth \u00e9 uma plataforma inovadora de simula\u00e7\u00e3o cl\u00ednica em realidade virtual projetada para treinamento e avalia\u00e7\u00e3o de habilidades m\u00e9dicas. O sistema combina uma aplica\u00e7\u00e3o imersiva em VR com uma plataforma Web de gest\u00e3o educacional, permitindo que estudantes e profissionais de sa\u00fade interajam com pacientes virtuais em um ambiente simulado que reproduz fielmente a rotina cl\u00ednica. A plataforma web permite a cria\u00e7\u00e3o de casos m\u00e9dicos a serem utilizados em VR.\nNo ambiente virtual, os usu\u00e1rios realizam consultas completas, desde a anamnese at\u00e9 a execu\u00e7\u00e3o de exames f\u00edsicos com instrumentos virtuais, como estetosc\u00f3pio e otosc\u00f3pio. Os pacientes virtuais respondem de maneira din\u00e2mica \u00e0s condutas do profissional, criando uma experi\u00eancia interativa e realista. Paralelamente, a plataforma Web permite a configura\u00e7\u00e3o detalhada de casos cl\u00ednicos, com personaliza\u00e7\u00e3o de sintomas, evolu\u00e7\u00e3o da doen\u00e7a, exames complementares e crit\u00e9rios de avalia\u00e7\u00e3o. Professores e institui\u00e7\u00f5es podem criar trilhas de aprendizagem, definir pesos avaliativos para diferentes a\u00e7\u00f5es e acompanhar o desempenho dos alunos por meio de relat\u00f3rios automatizados.  \n", "short_description": "O MetaHealth \u00e9 uma plataforma inovadora de simula\u00e7\u00e3o cl\u00ednica em realidade virtual projetada para treinamento e avalia\u00e7\u00e3o de habilidades m\u00e9dicas. O sistema combina uma aplica\u00e7\u00e3o imersiva em VR com uma plataforma Web de gest\u00e3o educacional, permitindo que estudantes e profissionais de sa\u00fade interajam com pacientes virtuais em um ambiente simulado que reproduz fielmente a rotina cl\u00ednica. A plataforma web permite a cria\u00e7\u00e3o de casos m\u00e9dicos a serem utilizados em VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://app.metahealth.com.br/terms", "developer_terms_of_service_url": "https://app.metahealth.com.br/terms", "publisher_name": "MetaHealth Company", "support_website_url": null, "website_url": "https://www.metahealth.com.br/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26442319482044117"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "689145050325428"}]}, "baseline_offer": {"id": "689145050325428"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1776883680, "status": "PUBLISHED", "id": "689145050325428"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes":
.com&_nc_ss=7f20f&oh=00_AQG92xqDoRjPMlbTiOYBchpa2ZYma3fJAEoZ-sU1w6CH3Q&oe=6A883484"}]}, "id": "912831958264086", "locale": "en_US", "screenshots": [{"file_name": "Image6.png", "id": "1368471681745755", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491825563_1368471685079088_1063639015668741103_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hTgvCItAsmAQ7kNvwGhzAWf&_nc_oc=AdqUAh72jOjQ_IL1r5wkSZB4FONQ_BSLjcRVO4FrO7O4heQP2De8lt5-a9fBvk-4GFQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDxrbqQs-a5hFkCOlCHb0t_Kq6kmk6QzYXIWHbF6s5Ig&oe=6A8823EE"}, {"file_name": "Image5.png", "id": "1584489452752011", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491822307_1584489462752010_5438167053200796736_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5h7dOqoEA38Q7kNvwHSBvDJ&_nc_oc=AdqsFiwtnfZaLqASjxM5sG4o2GiyNAZQcohRJ3fygjRv_zWi65dbMqE8HZxKVifcgkE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4TmjqShNwF4oGWGUknmrJV69-HvNJztRjEdChQ1SPng&oe=6A885219"}, {"file_name": "image1.png", "id": "1200243745574174", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/593828091_1200243748907507_3022409620308799602_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sj6YEzykyiYQ7kNvwFALUaC&_nc_oc=AdqSdxtaxzJL1HXVK2GhO9lJn9Fw9Jwbt6dUYgPCqymvbfLF9E_i-TMl3wZe0_GL1rw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFXOxuy0yDXRA_mbmwdD-F_sq2vTkDqw9Cqm4u-RQnANA&oe=6A881D0F"}, {"file_name": "Image2.png", "id": "1068916002027943", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491820923_1068916008694609_2171202733350884856_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DaPyFwJNSvAQ7kNvwFNoYdL&_nc_oc=AdrFhf6llp4GaX_KmsnCwl1A4S4FAJ4F3w2zBAsYRMHNszqjujoS3VKx5JDXykDGIGc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-cyuLpqiWTfmbBrhyGdAA756dpvUix78PZMBnujk4BQ&oe=6A88544D"}, {"file_name": "Image4.png", "id": "1188972286283069", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491818860_1188972289616402_6991489702767110484_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=liJAVK9INOwQ7kNvwGeLR05&_nc_oc=Adq9uF22ZHVzvi0VIhFg7z1wgQAH-OpkWryst-0QOLQlmHRc38MqJLn_iCGw4MIFBOA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-S57enNA9qRcrIOY2QajkcrQanPFdkGKNH60hdNr32w&oe=6A882DA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1364261728327989", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491821568_1364261731661322_5304120469068471427_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uZQkY6h0-8QQ7kNvwHnCXfd&_nc_oc=Adp5hoNNDia4WGFhyiGLY3uc8nVJFC2efvn1lXJfwOHhb2vZXbB4n1ZG6FbpyqGOBYU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVlgUpa9kqeMG8uAY4-8Bm7K6_Amjq18q8JCKxXtDZ0Q&oe=6A88408C"}, "display_name": "Twisted Dark", "keywords": ["comic", "book", "horror", "experience", "story"], "long_description": "Over **1,000 comic pages**, more than **70 unique stories**, all with a twist ending.\n\n**Twisted Dark** is an immersive VR comic reading experience: a huge amount of story\ncontent delivered inside interactive 3D worlds. There are **three** modes to pick from:\n\n---\n\n## **TWISTED MODE (8 VOLUMES)**\nRead each volume inside its own custom 3D scene designed to pull you into the book\u2019s\natmosphere. Explore the environment and uncover hidden **Twisted Objects**. Find one\nand the world \u201cbreaks,\u201d shifting into its unsettling **Twisted** version.\n\n---\n\n{849371644768748}\n\n## **STORY MODE (3 ALTERNATIVE BOOKS)**\nPrefer a linear narrative? Switch to STORY MODE for a curated, chronological journey\nthrough the Twisted Dark universe with three alternative books: the stories of **Amy**,\n**Mike**, and **Candice**.\n\n---\n\n{876973751918680}\n\n## **PASSTHROUGH MODE**\nWant to stay grounded in your space? Use PASSTHROUGH to bring Twisted Dark into your\nreal environment while you read.\n\n---\n\n## **FEATURES**\n- First **8 Twisted Dark volumes** included (TWISTED MODE)\n- Hidden **Twisted Objects** that reveal the unsettling Twisted version of each scene\n- Story Mode with **3 alternative books**: Amy, Mike, and Candice in chronological order\n- **Passthrough Mode** for reading in your real space\n- **1,000+ pages** across the Twisted Dark collection.\n- Designed for **immersive, comfortable** comic reading in VR\n\n---\n\nIf you want an atmospheric, content-rich experience that blends reading with exploration and\ndiscovery, **Twisted Dark** delivers the definitive way.", "short_description": "Every volume hides something. Read all 8 Twisted Dark books in custom made environments from the stories, uncover Twisted Objects, and watch the world shift into its misterious Twisted version."}]}, "developer_name": "OceanRoot Productions", "developer_privacy_policy_url": "https://oceanrootproductions.com/twisteddark/privacy", "developer_terms_of_service_url": "https://oceanrootproductions.com/twisteddark/terms", "publisher_name": "OceanRoot Productions", "support_website_url": null, "website_url": "https://oceanrootproductions.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26242559858732990"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491820141_1946716075966349_8820269117718711267_n.png?stp=ds
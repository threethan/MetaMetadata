.com&_nc_ss=7f20f&oh=00_AQCr3XWnLbZF1jCmZORyVg3P3s5nRNMFM2bqlXEbH43RsA&oe=6A6382C4"}]}, "id": "912831958264086", "locale": "en_US", "screenshots": [{"file_name": "Image6.png", "id": "1368471681745755", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825563_1368471685079088_1063639015668741103_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5IW81pAvV1sQ7kNvwGggcRr&_nc_oc=AdrNRApotOJOts7uDNK67MD3R0P5vgtZYsg6jdgae2YS9cNcifS3NHrA2KLpsRutbVg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCgHHPe2KLmQFUSWruZ5CVV8aRTc9YY9LdB6YK_U127-A&oe=6A63722E"}, {"file_name": "Image5.png", "id": "1584489452752011", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822307_1584489462752010_5438167053200796736_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yfZerahPkSEQ7kNvwG_bZWf&_nc_oc=AdrfSlrKpbws3nc0DW0X_mZa9WCbIw3x5-0TnC5n1mcp6v47PJSt6bQztq4-r3vi01s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCcjFoI87itYWGzGEInvUTNRizcDwtRrMFjg-f0S27iWQ&oe=6A636819"}, {"file_name": "image1.png", "id": "1200243745574174", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/593828091_1200243748907507_3022409620308799602_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6lfdiv9AU6oQ7kNvwGyu9xS&_nc_oc=Adoic5FbCSr-Ap3YaJOTUktlFKA6NfcxQTI8Pg921jSu0M4T8-P5Dq8KHyJR2WQUL48&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAdWdCStOjYJAwt2JSX13wyklX78WpbhFSRYEwQN-tzVw&oe=6A636B4F"}, {"file_name": "Image2.png", "id": "1068916002027943", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820923_1068916008694609_2171202733350884856_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j8F2rewDLDkQ7kNvwEKfexy&_nc_oc=AdqeqGxvmomLrxq6qKQeTgA5Ni3YKWwl8yj9RGSGJo9Lqu8RzgivyULnH9FWM0uf7x8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAxbtKqagyGRpMxN-8Rwln7tOyiAXbeh5Oc8WvWozNjTA&oe=6A636A4D"}, {"file_name": "Image4.png", "id": "1188972286283069", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818860_1188972289616402_6991489702767110484_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O1T_wDV2eC8Q7kNvwH-LABS&_nc_oc=AdppPX48QYxSUySuSYRLbJ6F06LSn2ft4cT6e6q_AgFHQB1phplY6rt_nzciH7aOdeU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBa0iXjQeKfH2qEZ2wKFdHTjGDUGp4c0FEQtsKr5273zg&oe=6A637BE2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1364261728327989", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821568_1364261731661322_5304120469068471427_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7cyBI_GNBWMQ7kNvwHYLebl&_nc_oc=AdpEQSVXROsdukPF0Px4H-WxBjZ-2gA5v1rztbE9zXAeGoh6h2IvOZzHGbq5WKi52EQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDWjgVwb5qJe9iRCzC09_KQ8BG-PeVtprqLnXdPAXyv3g&oe=6A63568C"}, "display_name": "Twisted Dark", "keywords": ["comic", "book", "horror", "experience", "story"], "long_description": "Over **1,000 comic pages**, more than **70 unique stories**, all with a twist ending.\n\n**Twisted Dark** is an immersive VR comic reading experience: a huge amount of story\ncontent delivered inside interactive 3D worlds. There are **three** modes to pick from:\n\n---\n\n## **TWISTED MODE (8 VOLUMES)**\nRead each volume inside its own custom 3D scene designed to pull you into the book\u2019s\natmosphere. Explore the environment and uncover hidden **Twisted Objects**. Find one\nand the world \u201cbreaks,\u201d shifting into its unsettling **Twisted** version.\n\n---\n\n{849371644768748}\n\n## **STORY MODE (3 ALTERNATIVE BOOKS)**\nPrefer a linear narrative? Switch to STORY MODE for a curated, chronological journey\nthrough the Twisted Dark universe with three alternative books: the stories of **Amy**,\n**Mike**, and **Candice**.\n\n---\n\n{876973751918680}\n\n## **PASSTHROUGH MODE**\nWant to stay grounded in your space? Use PASSTHROUGH to bring Twisted Dark into your\nreal environment while you read.\n\n---\n\n## **FEATURES**\n- First **8 Twisted Dark volumes** included (TWISTED MODE)\n- Hidden **Twisted Objects** that reveal the unsettling Twisted version of each scene\n- Story Mode with **3 alternative books**: Amy, Mike, and Candice in chronological order\n- **Passthrough Mode** for reading in your real space\n- **1,000+ pages** across the Twisted Dark collection.\n- Designed for **immersive, comfortable** comic reading in VR\n\n---\n\nIf you want an atmospheric, content-rich experience that blends reading with exploration and\ndiscovery, **Twisted Dark** delivers the definitive way.", "short_description": "Every volume hides something. Read all 8 Twisted Dark books in custom made environments from the stories, uncover Twisted Objects, and watch the world shift into its misterious Twisted version."}]}, "developer_name": "OceanRoot Productions", "developer_privacy_policy_url": "https://oceanrootproductions.com/twisteddark/privacy", "developer_terms_of_service_url": "https://oceanrootproductions.com/twisteddark/terms", "publisher_name": "OceanRoot Productions", "support_website_url": null, "website_url": "https://oceanrootproductions.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26242559858732990"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820141_1946716075966349_8820269117718711267_n.png?stp=ds
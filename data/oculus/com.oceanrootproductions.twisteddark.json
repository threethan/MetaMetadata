681745755", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825563_1368471685079088_1063639015668741103_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oD8bifkVg9YQ7kNvwEWc0sg&_nc_oc=Adr_LQtHa9QdEIR_7BR57VHiAJlkTFlV9mE0Ydt9FrRESpKD5_PHn_r-lzFJhGJlp8I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2w-qTOZU0JOFBbhsMJfnLXx1CWPayEXT-97RiyVrR7Cg&oe=69F0BFAE"}, {"file_name": "Image5.png", "id": "1584489452752011", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822307_1584489462752010_5438167053200796736_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jsLX4YQLdSMQ7kNvwFHQMvq&_nc_oc=AdquHcNGBxBX-DKDF5WVpv-3tb8057xE-ghloF4SFeYzRNw6klOrvPHlH4cJjfP3Pq0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0d33KLoVlT8-6X4pJ2H4Nv4Dld1l42_AhWavyREJjjxg&oe=69F0B599"}, {"file_name": "image1.png", "id": "1200243745574174", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593828091_1200243748907507_3022409620308799602_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1mi72-zg0tQQ7kNvwHip8HS&_nc_oc=AdpkMwtP-F8-ebeErEiCBHm2e9HQCJpGgejacclfolW-USQXNzb3tOJV93PQM1X_g7U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0-yxY6__LuxkGUxs4Vf-FlFvFcXUXgls_nfEirk4m72A&oe=69F0B8CF"}, {"file_name": "Image2.png", "id": "1068916002027943", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820923_1068916008694609_2171202733350884856_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gRBubqoREpIQ7kNvwGqBJIJ&_nc_oc=AdrzWcI-TqRDCguWjOYBKOZyqEYEoZgeGv--tEyFGJX1by68Xgujt9glDpP_ergkE20&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1YS76zVIHjyjeySZ7N6LvxodBXXaimXyDnu__6jBIaeA&oe=69F0B7CD"}, {"file_name": "Image4.png", "id": "1188972286283069", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818860_1188972289616402_6991489702767110484_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Kf8W_vDLjIQ7kNvwFoVH4-&_nc_oc=Adr7yFr8JvxV36O2cKnayNTR_YdM3lB0s_uNfekGw99ADyBonLjYdyykHf79G2vBYsY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af27stuwP2eIbRv0yL-MGWAdFXXuaaz7YCEIGaAIb14vRQ&oe=69F0C962"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1364261728327989", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821568_1364261731661322_5304120469068471427_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KctcyazCbPsQ7kNvwGs-1kx&_nc_oc=AdqbuNbuxm__YiRJKCpBEn-cLdbgmI_x4docrVzStfnn9DsBpH0uFD-nA2ffKDzpWL0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2e4GbtMq1wRuWtDX8TT0srP5gVGQMtxB6ZBmEevXLB2g&oe=69F0A40C"}, "display_name": "Twisted Dark", "keywords": ["comic", "book", "horror", "experience", "story"], "long_description": "Over **1,000 comic pages**, more than **70 unique stories**, all with a twist ending.\n\n**Twisted Dark** is an immersive VR comic reading experience: a huge amount of story\ncontent delivered inside interactive 3D worlds. There are **three** modes to pick from:\n\n---\n\n## **TWISTED MODE (8 VOLUMES)**\nRead each volume inside its own custom 3D scene designed to pull you into the book\u2019s\natmosphere. Explore the environment and uncover hidden **Twisted Objects**. Find one\nand the world \u201cbreaks,\u201d shifting into its unsettling **Twisted** version.\n\n---\n\n{849371644768748}\n\n## **STORY MODE (3 ALTERNATIVE BOOKS)**\nPrefer a linear narrative? Switch to STORY MODE for a curated, chronological journey\nthrough the Twisted Dark universe with three alternative books: the stories of **Amy**,\n**Mike**, and **Candice**.\n\n---\n\n{876973751918680}\n\n## **PASSTHROUGH MODE**\nWant to stay grounded in your space? Use PASSTHROUGH to bring Twisted Dark into your\nreal environment while you read.\n\n---\n\n## **FEATURES**\n- First **8 Twisted Dark volumes** included (TWISTED MODE)\n- Hidden **Twisted Objects** that reveal the unsettling Twisted version of each scene\n- Story Mode with **3 alternative books**: Amy, Mike, and Candice in chronological order\n- **Passthrough Mode** for reading in your real space\n- **1,000+ pages** across the Twisted Dark collection.\n- Designed for **immersive, comfortable** comic reading in VR\n\n---\n\nIf you want an atmospheric, content-rich experience that blends reading with exploration and\ndiscovery, **Twisted Dark** delivers the definitive way.", "short_description": "Every volume hides something. Read all 8 Twisted Dark books in custom made environments from the stories, uncover Twisted Objects, and watch the world shift into its misterious Twisted version."}]}, "developer_name": "OceanRoot Productions", "developer_privacy_policy_url": "https://oceanrootproductions.com/twisteddark/privacy", "developer_terms_of_service_url": "https://oceanrootproductions.com/twisteddark/terms", "publisher_name": "OceanRoot Productions", "support_website_url": null, "website_url": "https://oceanrootproductions.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26242559858732990"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820141_1946716075966349_8820269117718711267_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V9r8NoEflrAQ7kNvwEDH9OJ&_nc_oc=AdoAjF54lVrzqysbR3OJmArIA5oVfM6_8n5-bkOx1EyGdTxkdmP7sGgXFKe8GZG20I0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1OQGgV8EnRGJEXP5QsDLbidwGZ25jK06AMn7YZQ5xL2w&oe=69F09CD2"
n_US", "screenshots": [{"file_name": "Image6.png", "id": "1368471681745755", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491825563_1368471685079088_1063639015668741103_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hcBwRNIlGKoQ7kNvwHYpkmm&_nc_oc=AdqScyr21Wc85xan3aHQ4Z29889O1TK96aHmNz7CBlqwK6bwQI0fqbrtTA9BeYuc64U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwtgHc9xVaXzn-DMwZNZeyp3nhydlSB6K5REHIV3OGE7g&oe=69CE78AE"}, {"file_name": "Image5.png", "id": "1584489452752011", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822307_1584489462752010_5438167053200796736_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nrE-IV5vtrIQ7kNvwFfdeh8&_nc_oc=AdrXv4eut53vwTqNvJ--HLplGITGSdJ80WL-KLTw9g-BEd2XmIcY0LeLohF46rSDJv4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxtkW6hcDJAelXwcMfRSNXWFDPh6Y9VMiizcvv8LCcKqQ&oe=69CE6E99"}, {"file_name": "image1.png", "id": "1200243745574174", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/593828091_1200243748907507_3022409620308799602_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4v5BMCWofT8Q7kNvwHSAXzz&_nc_oc=AdrfVhyXRiabJSwnOmYnOnBUZArsOnCvMk_GnlfmS7VPlQJ1NUiKe2oqKiVUoQm-958&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxY-Flz3yQVAqdyo-1pwpWU6Tas-9OoD7ln46F4QDFEBw&oe=69CE71CF"}, {"file_name": "Image2.png", "id": "1068916002027943", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820923_1068916008694609_2171202733350884856_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w5y-mWElxjkQ7kNvwE2XQxE&_nc_oc=AdrBwji3djH0lK7aJqHND9v3wqOTW2sx4CRSQNC8LZ2NRA4e-WeOTQJFt8LGI8jrol4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx0JeuJ5hOG3kV1VZ_0nL0zKg6VPjUfNxQUSRrJuhJcIw&oe=69CE70CD"}, {"file_name": "Image4.png", "id": "1188972286283069", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818860_1188972289616402_6991489702767110484_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pd16WmGAa3EQ7kNvwEA0pj6&_nc_oc=AdqViUaa_0zask8iKyIu6U8Uv0v7jUAXXgBkudhZPBrgyoXumuBRfdfoo16rcx9rA4I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwd4Ss7c0HaMATcaDC7SjAeYScM2Nyk_yzM7n7kGoIpGw&oe=69CE8262"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1364261728327989", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821568_1364261731661322_5304120469068471427_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6UmjheynI2cQ7kNvwHWWfVA&_nc_oc=AdplmrwbV1g7ZHnB0Sagh1tdggOafz_Wb4oz0p7iFF64v8_NIKntiJYxhznKDTqZ83Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyoEAYsyRflCA9nXW0HO8ENqurQ0BlkcWw2XSZoRC2IJw&oe=69CE5D0C"}, "display_name": "Twisted Dark", "keywords": ["comic", "book", "horror", "experience", "story"], "long_description": "Over **1,000 comic pages**, more than **70 unique stories**, all with a twist ending.\n\n**Twisted Dark** is an immersive VR comic reading experience: a huge amount of story\ncontent delivered inside interactive 3D worlds. There are **three** modes to pick from:\n\n---\n\n## **TWISTED MODE (8 VOLUMES)**\nRead each volume inside its own custom 3D scene designed to pull you into the book\u2019s\natmosphere. Explore the environment and uncover hidden **Twisted Objects**. Find one\nand the world \u201cbreaks,\u201d shifting into its unsettling **Twisted** version.\n\n---\n\n{849371644768748}\n\n## **STORY MODE (3 ALTERNATIVE BOOKS)**\nPrefer a linear narrative? Switch to STORY MODE for a curated, chronological journey\nthrough the Twisted Dark universe with three alternative books: the stories of **Amy**,\n**Mike**, and **Candice**.\n\n---\n\n{876973751918680}\n\n## **PASSTHROUGH MODE**\nWant to stay grounded in your space? Use PASSTHROUGH to bring Twisted Dark into your\nreal environment while you read.\n\n---\n\n## **FEATURES**\n- First **8 Twisted Dark volumes** included (TWISTED MODE)\n- Hidden **Twisted Objects** that reveal the unsettling Twisted version of each scene\n- Story Mode with **3 alternative books**: Amy, Mike, and Candice in chronological order\n- **Passthrough Mode** for reading in your real space\n- **1,000+ pages** across the Twisted Dark collection.\n- Designed for **immersive, comfortable** comic reading in VR\n\n---\n\nIf you want an atmospheric, content-rich experience that blends reading with exploration and\ndiscovery, **Twisted Dark** delivers the definitive way.", "short_description": "Every volume hides something. Read all 8 Twisted Dark books in custom made environments from the stories, uncover Twisted Objects, and watch the world shift into its misterious Twisted version."}]}, "developer_name": "OceanRoot Productions", "developer_privacy_policy_url": "https://oceanrootproductions.com/twisteddark/privacy", "developer_terms_of_service_url": "https://oceanrootproductions.com/twisteddark/terms", "publisher_name": "OceanRoot Productions", "support_website_url": null, "website_url": "https://oceanrootproductions.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26242559858732990"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820141_1946716075966349_8820269117718711267_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tYjdPpwVAVwQ7kNvwH7vQgT&_nc_oc=Adrr42M8PjMcLUxmuOttUdb1cvgmLL_0gkZ1
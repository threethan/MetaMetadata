10484_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2wzjBFKOQjsQ7kNvwHUDFkG&_nc_oc=AdqDwsTV4LoEv-Sxuf_N_CrYuY26MERpCR7h9En1Al1n-Syvtb9g2UpWZpPFvn7ga5o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBNGsRtRutXJj1JjtOOrNRQcYGUpc72W2hHdA9QvzmHg&oe=6B030162"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1364261728327989", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821568_1364261731661322_5304120469068471427_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FyeI8NloU0QQ7kNvwEPeKFG&_nc_oc=Adql1GUn-vW4OYydVRWL99WolPCgOhASSxA0Ro6KK3y5YFFa9ssF1vcv5NlwiS9s84g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-cvGrzRWx8Ie7r1SM2iTZUbileH5BhlMW6qWQ1f891g&oe=6B03144C"}, "display_name": "Twisted Dark", "keywords": ["comic", "book", "horror", "experience", "story"], "long_description": "Enter Twisted Dark, an immersive VR comic reading experience built around one core promise: a huge amount of story content delivered inside interactive 3D worlds.\n\nRead the complete 8-volume Twisted Dark collection in Twisted Mode. Each volume is presented in a custom 3D scene designed to pull you into the atmosphere of the book. Explore and interact with Twisted Objects hidden throughout the environment. Find them to trigger a chilling reveal: the scene \u201cbreaks,\u201d shifting into its creepy Twisted version.\n\nPrefer a linear narrative? Switch to Story Mode, a curated experience with three additional books, the stories of Amy, Mike, and Candice presented in chronological order for a clearer, character-driven journey through the Twisted Dark universe.\n\nWant to stay grounded in your space? Use Passthrough Mode and bring Twisted Dark into your real environment while you read.\n\nFeatures\n\nAll 8 Twisted Dark volumes included (Twisted Mode)\n\nUnique 3D scene per volume with special interactions\n\nTwisted Objects to discover uncover the unsettling Twisted version of each scene on the Twisted Mode\n\nStory Mode with 3 extra books: Amy, Mike, and Candice in chronological order\n\nPassthrough Mode for reading in your real space\n\nDesigned for immersive, comfortable comic reading in VR\n\nIf you want an atmospheric, content-rich experience that blends reading with exploration and discovery, Twisted Dark delivers the definitive way to enter the story.", "short_description": "Every volume hides something. Read all 8 Twisted Dark books in custom made environments from the stories, uncover Twisted Objects, and watch the world shift into its misterious Twisted version."}]}, "developer_name": "OceanRoot Productions", "developer_privacy_policy_url": "https://oceanrootproductions.com/twisteddark/privacy", "developer_terms_of_service_url": "https://oceanrootproductions.com/twisteddark/terms", "publisher_name": "OceanRoot Productions", "support_website_url": null, "website_url": "https://oceanrootproductions.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24369259772729684"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "27944756148447601"}, {"status": "CANCELLED", "id": "1810086843015696"}, {"status": "PUBLISHED", "id": "762217286933017"}]}, "baseline_offer": {"id": "762217286933017"}, "is_approved": true, "firstOffer": {"nodes": [{"star
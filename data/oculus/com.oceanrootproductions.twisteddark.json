/t64.5771-25/491818860_1188972289616402_6991489702767110484_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o9rODMXP82EQ7kNvwHc-ENT&_nc_oc=Adr4L70Dqwpd5TUnuwYYerMOqKRzPDyoUKfpPPrh2-cYP-V7k5gqAAxuGSFfQ0U3uog&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-UV6kAFVXtfSESZ28qSAYPzoJUqt-B-rh1DuiE6oT8xw&oe=6A467AE2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1364261728327989", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491821568_1364261731661322_5304120469068471427_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6isHCT4Rd54Q7kNvwHywExz&_nc_oc=AdqrUHNFyRdzY10re7gt2eqrMESnNmbPvix6PPWEd2_QXWVxfK2W_rguAfvfA3C0zy0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_N1-7ejTIZzNbF8lyjmts7C84mgLos5sxfhmHvLb8tgw&oe=6A468DCC"}, "display_name": "Twisted Dark", "keywords": ["comic", "book", "horror", "experience", "story"], "long_description": "Over **1,000 comic pages**, more than **70 unique stories**, all with a twist ending.\n\n**Twisted Dark** is an immersive VR comic reading experience: a huge amount of story\ncontent delivered inside interactive 3D worlds. There are **three** modes to pick from:\n\n---\n\n## **TWISTED MODE (8 VOLUMES)**\nRead each volume inside its own custom 3D scene designed to pull you into the book\u2019s\natmosphere. Explore the environment and uncover hidden **Twisted Objects**. Find one\nand the world \u201cbreaks,\u201d shifting into its unsettling **Twisted** version.\n\n---\n\n{849371644768748}\n\n## **STORY MODE (3 ALTERNATIVE BOOKS)**\nPrefer a linear narrative? Switch to STORY MODE for a curated, chronological journey\nthrough the Twisted Dark universe with three alternative books: the stories of **Amy**,\n**Mike**, and **Candice**.\n\n---\n\n{876973751918680}\n\n## **PASSTHROUGH MODE**\nWant to stay grounded in your space? Use PASSTHROUGH to bring Twisted Dark into your\nreal environment while you read.\n\n---\n\n## **FEATURES**\n- First **8 Twisted Dark volumes** included (TWISTED MODE)\n- Hidden **Twisted Objects** that reveal the unsettling Twisted version of each scene\n- Story Mode with **3 alternative books**: Amy, Mike, and Candice in chronological order\n- **Passthrough Mode** for reading in your real space\n- **1,000+ pages** across the Twisted Dark collection.\n- Designed for **immersive, comfortable** comic reading in VR\n\n---\n\nIf you want an atmospheric, content-rich experience that blends reading with exploration and\ndiscovery, **Twisted Dark** delivers the definitive way.", "short_description": "Every volume hides something. Read all 8 Twisted Dark books in custom made environments from the stories, uncover Twisted Objects, and watch the world shift into its misterious Twisted version."}]}, "developer_name": "OceanRoot Productions", "developer_privacy_policy_url": "https://oceanrootproductions.com/twisteddark/privacy", "developer_terms_of_service_url": "https://oceanrootproductions.com/twisteddark/terms", "publisher_name": "OceanRoot Productions", "support_website_url": null, "website_url": "https://oceanrootproductions.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26242559858732990"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491820141_1946716075966349_8820269117718711267_n.
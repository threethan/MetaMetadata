.com&_nc_ss=7f20f&oh=00_AQBO-kO4R5r3ugJeZJiuT7JEH_SP2roVc38TJ-V3I5l3kA&oe=6A5B6184"}]}, "id": "912831958264086", "locale": "en_US", "screenshots": [{"file_name": "Image6.png", "id": "1368471681745755", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491825563_1368471685079088_1063639015668741103_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KBvy-RFIg-UQ7kNvwGjjw-J&_nc_oc=AdqG39bnPLlUYfHj4Z-TO3s3tTt8Ps-_0eaDIDdzBvXR70pKYn9nIIdKfvdGnmqXiEA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBljrZRCIYECHCTgflZiHoggav-C8Isq1VXoTL-pxZyyw&oe=6A5B892E"}, {"file_name": "Image5.png", "id": "1584489452752011", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822307_1584489462752010_5438167053200796736_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KI7rWp91x0cQ7kNvwE69Eab&_nc_oc=AdpnnkMW_mVAWolV1Z7juuhbu8pksrEf7L3KG7vmasRIEm1lWHP6zCx-LpUJEYl6-s8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJs2bMDAbg1rtKJs6r8KbuL5yz4B8g7MRKEQiyQIjjjA&oe=6A5B7F19"}, {"file_name": "image1.png", "id": "1200243745574174", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/593828091_1200243748907507_3022409620308799602_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YQ32Bfs5BvMQ7kNvwF_K4Os&_nc_oc=AdpIOr4uhXSIIBvFdR5ALgBJ0TZiHhf_TfsiXJzGVM1KdjuDvGHmCQj3VqciTXvHMyk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAuZ5PqKNUj90E4Tym_xLwspEt83H7zAukfUuMe1wh70A&oe=6A5B824F"}, {"file_name": "Image2.png", "id": "1068916002027943", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820923_1068916008694609_2171202733350884856_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ze5ihkbwq5QQ7kNvwFsdCR8&_nc_oc=Adot-RShWdER_HKu0bnM74XYKUcRCKmQhq5JWo82VYEm8TTI7t1VWvG3zur6CF2uM7Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDNGa5jZnRvfHLLmC0ITFz9QXnIjKjlIrFbpNL5jLHcBQ&oe=6A5B814D"}, {"file_name": "Image4.png", "id": "1188972286283069", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491818860_1188972289616402_6991489702767110484_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nRAjLz4eE7UQ7kNvwHCxe0I&_nc_oc=AdoMKpJVFTaCur_Kw7nj8RDR-GLGkHh8MnLqUFuUbhzxXjJW9sqWn1mNPyheKlGXpDA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8bsr9k9vZI1gVmMrSWJtzRzCi5ByfNhep4yWuLJr1Qg&oe=6A5B92E2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "1364261728327989", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821568_1364261731661322_5304120469068471427_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h58PB6vqJ6EQ7kNvwGaDP6F&_nc_oc=AdrvkCJle_ccRYcjRszDA2Oz22S8SKleKCIryFGskARsM6iWnV-vWtfxMShXdNVkMG4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAt35LaTGICMxSV3Gc4VQP_0ueDFkfZ_xfUAnv2_vsNDg&oe=6A5B6D8C"}, "display_name": "Twisted Dark", "keywords": ["comic", "book", "horror", "experience", "story"], "long_description": "Over **1,000 comic pages**, more than **70 unique stories**, all with a twist ending.\n\n**Twisted Dark** is an immersive VR comic reading experience: a huge amount of story\ncontent delivered inside interactive 3D worlds. There are **three** modes to pick from:\n\n---\n\n## **TWISTED MODE (8 VOLUMES)**\nRead each volume inside its own custom 3D scene designed to pull you into the book\u2019s\natmosphere. Explore the environment and uncover hidden **Twisted Objects**. Find one\nand the world \u201cbreaks,\u201d shifting into its unsettling **Twisted** version.\n\n---\n\n{849371644768748}\n\n## **STORY MODE (3 ALTERNATIVE BOOKS)**\nPrefer a linear narrative? Switch to STORY MODE for a curated, chronological journey\nthrough the Twisted Dark universe with three alternative books: the stories of **Amy**,\n**Mike**, and **Candice**.\n\n---\n\n{876973751918680}\n\n## **PASSTHROUGH MODE**\nWant to stay grounded in your space? Use PASSTHROUGH to bring Twisted Dark into your\nreal environment while you read.\n\n---\n\n## **FEATURES**\n- First **8 Twisted Dark volumes** included (TWISTED MODE)\n- Hidden **Twisted Objects** that reveal the unsettling Twisted version of each scene\n- Story Mode with **3 alternative books**: Amy, Mike, and Candice in chronological order\n- **Passthrough Mode** for reading in your real space\n- **1,000+ pages** across the Twisted Dark collection.\n- Designed for **immersive, comfortable** comic reading in VR\n\n---\n\nIf you want an atmospheric, content-rich experience that blends reading with exploration and\ndiscovery, **Twisted Dark** delivers the definitive way.", "short_description": "Every volume hides something. Read all 8 Twisted Dark books in custom made environments from the stories, uncover Twisted Objects, and watch the world shift into its misterious Twisted version."}]}, "developer_name": "OceanRoot Productions", "developer_privacy_policy_url": "https://oceanrootproductions.com/twisteddark/privacy", "developer_terms_of_service_url": "https://oceanrootproductions.com/twisteddark/terms", "publisher_name": "OceanRoot Productions", "support_website_url": null, "website_url": "https://oceanrootproductions.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26242559858732990"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820141_1946716075966349_8820269117718711267_n.png?stp=ds
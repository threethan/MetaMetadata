0f&oh=00_AQVaW5aD1_VtMH0iJ22W6XC2RPGoAEp_I4Sn0plbLRF4mQ&oe=6B0EF4FA"}, {"file_name": "SmartCity.png", "id": "1127395041537761", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974594_1127395044871094_3674951848224373706_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mxOsGDe5BT0Q7kNvwGzLZGm&_nc_oc=AdrwRUy5Cx9y0wa59bCPEZiwAZ5oML696mUeln7NGSnJzHlFCh84WAfKZkjSEgS3U7c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUTXBK3_BhChG6NxDy5-IvGpR7A2LGOFMYFJgVmd5mgqA&oe=6B0F0D04"}, {"file_name": "SlideControls.png", "id": "933280611438440", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036628_933280614771773_7489312651977815592_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D9ADPydf0oEQ7kNvwF8LTGU&_nc_oc=Adpdaoswq8gfolqR1NkiJyzFy58pd3nwS2Tj01T8qspJ4JkZO8NRuc5AkzZbIrIC8So&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU9H_ZHCJ9MM5alnyIvniCuhSXHYEA57Yn-ElwFp2LAcg&oe=6B0F1249"}, {"file_name": "DataVisualization.png", "id": "473632957822227", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982644_473632961155560_4050351944845584581_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G7A6c_0YpisQ7kNvwHN3hwZ&_nc_oc=Adp7xecAIVyj6HpcaHjiXa8Pb88F__l_nTPcOWa9c-ezBE99fBI89b_u9EPhvGM4OI4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUJuechMQiaWzkGpxlN4YdgG2rmqV72p_uiklY-IwSCbA&oe=6B0EFEB9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Video.png", "id": "2557075024586240", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75443237_2557075027919573_2113441605653888610_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kMzvWjtWxSMQ7kNvwFL8r8h&_nc_oc=AdpGwASKk2J3aCStHMjaRbhFlm4cT0kN1SLvdWiX-c6ei7JuRbud3f0Ygoa1Ukc1C7o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXqZ_ckt54gvENN-3AmjYMWaaE7nvQedVDjhjj6P1YLTw&oe=6B0EF322"}, "display_name": "AfterNow Prez Beta", "keywords": [], "long_description": "AfterNow Prez offers the perfect combination of \"Zoom meets PowerPoint inside Virtual Reality.\" We have created a platform to compose and deliver immersive presentations using the power of AR and VR.\n\nIn sales meetings, AfterNow Prez can be used to add impact to your presentation. Helping you to better convey your products, services, and value proposition, in ways that your prospects and clients will remember. \n\nEducators and trainers can recreate that feeling of presence, even while hosting remote classes. Research has shown that immersive learning increases retention and engagement. This is because we have evolved to learn about our world through personal and embodied experiences. With mixed reality, you can bring the world to your students like never before.\n\nAfterNow Prez makes it easy for anyone to create 3D experiences. No coding experience required!", "short_description": "AfterNow Prez is a platform for live immersive presentations to be delivered remotely. It empowers executives, sales teams, trainers, and educators to present immersive content to their audience all around the world; resulting in increased engagement, comprehension, and retention."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.afternow.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "AfterNow", "support_website_url": null, "website_url": "https://www.afternow.io/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NEWS_AND_INFORMATION", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
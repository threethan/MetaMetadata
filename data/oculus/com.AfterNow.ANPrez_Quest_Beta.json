0f&oh=00_AQSbtSFmtJyqOT9jQ2CcLAl5SdWbu3OaIcYDqKtPfiYXCg&oe=6AFB2E7A"}, {"file_name": "SmartCity.png", "id": "1127395041537761", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974594_1127395044871094_3674951848224373706_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VCMbZCNvYhMQ7kNvwFNAzeZ&_nc_oc=Adoc5f642RFhc2hRzA7VzMoXlfcrEW_px7sG0wRPonSvu2ISw0xCv4mUTqan_-9Fvhc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShL8QrY30Jg0EGoDLE44Lb1uLQ0n7gat_oTD-H-5-8SQ&oe=6AFB4684"}, {"file_name": "SlideControls.png", "id": "933280611438440", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39036628_933280614771773_7489312651977815592_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bnfvOqkgCY0Q7kNvwED8dSd&_nc_oc=Adodh-gG9pzGuEHrniFwLQCuiXH6-kWqHTPLoqedtz7XJs1_4rbnSIa0Y9mIcKN--IE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMBK9lJy0CWapFqVLSUziEnPkrCCxPUBaXgh4JriBarA&oe=6AFB4BC9"}, {"file_name": "DataVisualization.png", "id": "473632957822227", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982644_473632961155560_4050351944845584581_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GeTe7PW_zmEQ7kNvwGO9vuB&_nc_oc=Adqv3fzB86b7X7xEC5FcRzOgjdnQeUz9SzcML3i4N4jn5Fo4GJp2evAeHALHEs_OCho&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRg6dHpz3pyBMHV6YNdnmYqXT20tAvaeOaZWdQFc9wXsA&oe=6AFB3839"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Video.png", "id": "2557075024586240", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75443237_2557075027919573_2113441605653888610_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RBLkDC0g4YoQ7kNvwH_yI9U&_nc_oc=Adrv8JFxqM1tLFNDxttrvCsK3wvoBOTukTnGDhcWRafkw1Z5VIDSWXhCnovoYFG_Xe8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMk7euz9haO1uDWKkpNXxEPRhQ_poYzPZhVveCv13oew&oe=6AFB2CA2"}, "display_name": "AfterNow Prez Beta", "keywords": [], "long_description": "AfterNow Prez offers the perfect combination of \"Zoom meets PowerPoint inside Virtual Reality.\" We have created a platform to compose and deliver immersive presentations using the power of AR and VR.\n\nIn sales meetings, AfterNow Prez can be used to add impact to your presentation. Helping you to better convey your products, services, and value proposition, in ways that your prospects and clients will remember. \n\nEducators and trainers can recreate that feeling of presence, even while hosting remote classes. Research has shown that immersive learning increases retention and engagement. This is because we have evolved to learn about our world through personal and embodied experiences. With mixed reality, you can bring the world to your students like never before.\n\nAfterNow Prez makes it easy for anyone to create 3D experiences. No coding experience required!", "short_description": "AfterNow Prez is a platform for live immersive presentations to be delivered remotely. It empowers executives, sales teams, trainers, and educators to present immersive content to their audience all around the world; resulting in increased engagement, comprehension, and retention."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.afternow.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "AfterNow", "support_website_url": null, "website_url": "https://www.afternow.io/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NEWS_AND_INFORMATION", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
0f&oh=00_AQRh2svrdf1Zm1XwjSAbYzmaSnzB9WBzhSoKF_EIdP3JJg&oe=6B05BA7A"}, {"file_name": "SmartCity.png", "id": "1127395041537761", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974594_1127395044871094_3674951848224373706_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=56HoM2_-WrkQ7kNvwEIVb_z&_nc_oc=AdrAwRGyOu0FJ0_w8qZTDRl_Hc5UQhU-rcZEMawNEGf_AM9kQuIfsolNgqgkC3vtFtY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcf64l8o3gMnBhE65d4abe3RNXeRP5ybyUgpimDZfuAA&oe=6B05D284"}, {"file_name": "SlideControls.png", "id": "933280611438440", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036628_933280614771773_7489312651977815592_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WBJzxLvHLMoQ7kNvwGCvXAQ&_nc_oc=AdolomN3La3jWmD24SDsAR_AAVDPK6VScaNBQ-K3zY83lFSQXyOMfK-T-0HPkudVAT4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQ7NkC3YXk3C6ozf4iqUY74cBov6B1Mb392d6d7_Am-A&oe=6B05D7C9"}, {"file_name": "DataVisualization.png", "id": "473632957822227", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982644_473632961155560_4050351944845584581_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ixqPeLKexTYQ7kNvwHA34uJ&_nc_oc=AdpteIWpn0PAS9bthsihTv9Lx928RXzjRwaRWiIsMMFBuSD6IVc0jP7_uB1-DSeeiRk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHG3JC43twt2s8URDpxOi_ZkdoEiPNu7XfTfBcKDJfJQ&oe=6B05C439"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Video.png", "id": "2557075024586240", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75443237_2557075027919573_2113441605653888610_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=deS3tBMHsTcQ7kNvwFVhgzh&_nc_oc=AdptH2QG4FnKfVeR4HnyHZvMf-ZpMlYHp2Q0ashayzDLrU3DfuJNCjIEPlT8A3jl85M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSeHq_nztR4vBRRn7WonawueZvBhImzVI2WAb5xak1kyQ&oe=6B05B8A2"}, "display_name": "AfterNow Prez Beta", "keywords": [], "long_description": "AfterNow Prez offers the perfect combination of \"Zoom meets PowerPoint inside Virtual Reality.\" We have created a platform to compose and deliver immersive presentations using the power of AR and VR.\n\nIn sales meetings, AfterNow Prez can be used to add impact to your presentation. Helping you to better convey your products, services, and value proposition, in ways that your prospects and clients will remember. \n\nEducators and trainers can recreate that feeling of presence, even while hosting remote classes. Research has shown that immersive learning increases retention and engagement. This is because we have evolved to learn about our world through personal and embodied experiences. With mixed reality, you can bring the world to your students like never before.\n\nAfterNow Prez makes it easy for anyone to create 3D experiences. No coding experience required!", "short_description": "AfterNow Prez is a platform for live immersive presentations to be delivered remotely. It empowers executives, sales teams, trainers, and educators to present immersive content to their audience all around the world; resulting in increased engagement, comprehension, and retention."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.afternow.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "AfterNow", "support_website_url": null, "website_url": "https://www.afternow.io/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NEWS_AND_INFORMATION", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
0f&oh=00_AQTc0D_65crd_l1gVwH62sZhU-Nf2PkuSaKvrqUgJhspaQ&oe=6B03177A"}, {"file_name": "SmartCity.png", "id": "1127395041537761", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974594_1127395044871094_3674951848224373706_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RMpnbCvHoSsQ7kNvwGliObg&_nc_oc=AdqMH7ZUDkqxXfK0Hs0dkt7YXiRX4hP2z6oM0GnX5ctf125LYO5eRrk2xSni7ka0IGg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmMQxLCZq75bttCGwPPXs1WaAw1oQNjS0_DCcbzWDokw&oe=6B032F84"}, {"file_name": "SlideControls.png", "id": "933280611438440", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036628_933280614771773_7489312651977815592_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nvpPy0X79TAQ7kNvwGmTaa2&_nc_oc=Adr8SfH0J2PctPcolradTNdF89pWxKJEna9eoAd-V3hy9xh8Ot8cpC-RzFeqXvLTy6k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDBVYZxSLObSiPI7f1BlNjaPT-T-0nzzMbwbtg9ePGsg&oe=6B0334C9"}, {"file_name": "DataVisualization.png", "id": "473632957822227", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982644_473632961155560_4050351944845584581_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WlIl4VjSSEEQ7kNvwEXZ86p&_nc_oc=Adp1wVrAzUVzTsUgds2OC5Pljl9r9kclDmp4mWwgLKu98Hjx9b4Omz0TADEiKWuG9WM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbNkAwpgW6KXRe04Mt19tFANOCiDllNiiiGuSTBnuBCQ&oe=6B032139"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Video.png", "id": "2557075024586240", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75443237_2557075027919573_2113441605653888610_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=deS3tBMHsTcQ7kNvwF2pbKY&_nc_oc=AdpedrFAbmB97-l8JVs4AF5ev0-YNjzEmwvozzfl8Yp9532EAcIZ7yySn1ShUZAUMsA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTs6E5cJgwU63f8kvoppy69MC3hzrzYlk9B8IKbInwucQ&oe=6B0315A2"}, "display_name": "AfterNow Prez Beta", "keywords": [], "long_description": "AfterNow Prez offers the perfect combination of \"Zoom meets PowerPoint inside Virtual Reality.\" We have created a platform to compose and deliver immersive presentations using the power of AR and VR.\n\nIn sales meetings, AfterNow Prez can be used to add impact to your presentation. Helping you to better convey your products, services, and value proposition, in ways that your prospects and clients will remember. \n\nEducators and trainers can recreate that feeling of presence, even while hosting remote classes. Research has shown that immersive learning increases retention and engagement. This is because we have evolved to learn about our world through personal and embodied experiences. With mixed reality, you can bring the world to your students like never before.\n\nAfterNow Prez makes it easy for anyone to create 3D experiences. No coding experience required!", "short_description": "AfterNow Prez is a platform for live immersive presentations to be delivered remotely. It empowers executives, sales teams, trainers, and educators to present immersive content to their audience all around the world; resulting in increased engagement, comprehension, and retention."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.afternow.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "AfterNow", "support_website_url": null, "website_url": "https://www.afternow.io/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NEWS_AND_INFORMATION", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
7a0a&_nc_ohc=d_EM9BIvCf4Q7kNvwEhpJal&_nc_oc=AdkTGa599J2N0JLNxd_CErT8OJzSbpDsen4GBZHBoPnIWabzHOJSr8EkSf34-gvYe5M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuEjeMnzriNOTtIH5LWSnYdGiT4GRGKQXPD8-YKtTgzzg&oe=69A83CC4"}, {"file_name": "SlideControls.png", "id": "933280611438440", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036628_933280614771773_7489312651977815592_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I4zrj0TnmZkQ7kNvwFd6hVg&_nc_oc=AdmfB3S0EvXZ5gZgwWgNlYsMaFCq59tGw8i2AS_p3snvAfG3EElKMwNemXbdW64FGw4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvcveC-lQTzq6TS-b8_htZrws1odQazIwATKz8uc-jJhA&oe=69A809C9"}, {"file_name": "DataVisualization.png", "id": "473632957822227", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982644_473632961155560_4050351944845584581_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BgBlGfY94fkQ7kNvwFmuOpx&_nc_oc=AdlyS6aGpoa8zAyKd1U-dD8Le0ZWDyXsqkM7zbB05c-1svM_wL8J7d_5fXapCzvj_8o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Aftlr56_34vGDxhDH0KJ5SAXG_BSrm3pwVwDIpYVnsVSng&oe=69A82E79"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Video.png", "id": "2557075024586240", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75443237_2557075027919573_2113441605653888610_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yfmKptNQDZkQ7kNvwF61gY2&_nc_oc=AdmBA4PoFoMcdBuqY8yfpkxPeSCV1WUwPAIpSkk0HeglGKW1_Q-N46o-_vjmK3zMR-4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afv0e5sLMUUEySxshe5bqGV7fV8hNzTYcyKb-IcPYfy8oQ&oe=69A822E2"}, "display_name": "AfterNow Prez Beta", "keywords": [], "long_description": "AfterNow Prez offers the perfect combination of \"Zoom meets PowerPoint inside Virtual Reality.\" We have created a platform to compose and deliver immersive presentations using the power of AR and VR.\n\nIn sales meetings, AfterNow Prez can be used to add impact to your presentation. Helping you to better convey your products, services, and value proposition, in ways that your prospects and clients will remember. \n\nEducators and trainers can recreate that feeling of presence, even while hosting remote classes. Research has shown that immersive learning increases retention and engagement. This is because we have evolved to learn about our world through personal and embodied experiences. With mixed reality, you can bring the world to your students like never before.\n\nAfterNow Prez makes it easy for anyone to create 3D experiences. No coding experience required!", "short_description": "AfterNow Prez is a platform for live immersive presentations to be delivered remotely. It empowers executives, sales teams, trainers, and educators to present immersive content to their audience all around the world; resulting in increased engagement, comprehension, and retention."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.afternow.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "AfterNow", "support_website_url": null, "website_url": "https://www.afternow.io/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NEWS_AND_INFORMATION", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "7658499104278507"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001711_8764548
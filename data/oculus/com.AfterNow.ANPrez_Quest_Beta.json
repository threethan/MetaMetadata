n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SQgr_0bQELYQ7kNvwH7i_62&_nc_oc=AdrjaEaGq5ZHtUJBx6qNQtFEQUsDN0i1m7sQ76lSHpL7marOWVN0BEn9zcJDc8ItXT0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Ei2XGNxk3mbEieiNJuu0qd899dHci2RPqQwTxJ7RCeg&oe=69D90444"}, {"file_name": "SlideControls.png", "id": "933280611438440", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036628_933280614771773_7489312651977815592_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J9RmySrV3e0Q7kNvwGjL7xs&_nc_oc=AdoGQUNBO0XAGd-Sf5-Bs64MWvh8UH4MYnPMJnHlCQT6AzVLNOnS2qO2Eqc-SqA232Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0CQh--ddx7fcdYYgf8bnkOmHLiSdqT2aKxnv5PzKC_2g&oe=69D90989"}, {"file_name": "DataVisualization.png", "id": "473632957822227", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982644_473632961155560_4050351944845584581_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qt7NGx0zJrgQ7kNvwHecEmx&_nc_oc=Ado7EOS4tblQ9jsWF0qGZlTjVi7dQVj-P3_S8LYAswxKXLpJMOqKH2W_7UlICOv4j0M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2NAo8zFyOD628mwtcC7UHxQol61AnVqTLK0GDZisW4ng&oe=69D8F5F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Video.png", "id": "2557075024586240", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75443237_2557075027919573_2113441605653888610_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_0A3zuNDrXoQ7kNvwEeAReN&_nc_oc=AdrGPZ_sgNOMC1Kdjr2uWdUN3e96U1l-N_05btnjqXkmwn_9OOQvXpc5GuzV4ozqSPY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2hgE74_8Xb-ZnKygoAJTYCXxg-Yc3vgrI31rvTDdsHvw&oe=69D8EA62"}, "display_name": "AfterNow Prez Beta", "keywords": [], "long_description": "AfterNow Prez offers the perfect combination of \"Zoom meets PowerPoint inside Virtual Reality.\" We have created a platform to compose and deliver immersive presentations using the power of AR and VR.\n\nIn sales meetings, AfterNow Prez can be used to add impact to your presentation. Helping you to better convey your products, services, and value proposition, in ways that your prospects and clients will remember. \n\nEducators and trainers can recreate that feeling of presence, even while hosting remote classes. Research has shown that immersive learning increases retention and engagement. This is because we have evolved to learn about our world through personal and embodied experiences. With mixed reality, you can bring the world to your students like never before.\n\nAfterNow Prez makes it easy for anyone to create 3D experiences. No coding experience required!", "short_description": "AfterNow Prez is a platform for live immersive presentations to be delivered remotely. It empowers executives, sales teams, trainers, and educators to present immersive content to their audience all around the world; resulting in increased engagement, comprehension, and retention."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.afternow.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "AfterNow", "support_website_url": null, "website_url": "https://www.afternow.io/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NEWS_AND_INFORMATION", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "7658499104278507"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent
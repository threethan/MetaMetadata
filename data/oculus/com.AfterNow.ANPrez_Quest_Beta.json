n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nC5ArSYcwl0Q7kNvwG1Rubu&_nc_oc=AdpggnD_neUIVy3w3R07B01xCNrQtYaVXy9U1hV2aktzBibsF-_8bf7u2sorQa4GhOY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMblvi3nvuCHHq-O8_MGgf3NgUDDZi-vIPXQEE2aNIpBQ&oe=6AC8F544"}, {"file_name": "SlideControls.png", "id": "933280611438440", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39036628_933280614771773_7489312651977815592_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wuI5C6CkGaEQ7kNvwHupC_j&_nc_oc=AdpNr6MYK7wFruKF4Lyz-zQMGQfWiXgO5TcHFD4lbFKQ-KxhKBBYEjDLM7dyC--DXOw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQyYE3lrY963QSS3f0tYd5CGeK0bxPhXOs75C7_G78Ww&oe=6AC8FA89"}, {"file_name": "DataVisualization.png", "id": "473632957822227", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982644_473632961155560_4050351944845584581_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ValLpDSd5HcQ7kNvwGQqkLV&_nc_oc=AdrmzC8KMwSf1uMpo6hfvOIxvizBMJy8KKnNy3weWgpmGDclptmxCdofiKPoe7b4X4s&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPUPzd4GN0UJhMKryqGiP4aKkLCn4qZOy7oh5v1X-lKsA&oe=6AC8E6F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Video.png", "id": "2557075024586240", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75443237_2557075027919573_2113441605653888610_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=76C1VC78NokQ7kNvwHib2Su&_nc_oc=AdrzAUPbreaC_ITySxtupIl-VB2RxKRVPhOTzuxg6p_r8XH54lDVavPApIPS7HD1mj4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN05cNyBUrXdv4fpA8Zsm1sbIbbhZcZRTlcnC1zK3uFSQ&oe=6AC913A2"}, "display_name": "AfterNow Prez Beta", "keywords": [], "long_description": "AfterNow Prez offers the perfect combination of \"Zoom meets PowerPoint inside Virtual Reality.\" We have created a platform to compose and deliver immersive presentations using the power of AR and VR.\n\nIn sales meetings, AfterNow Prez can be used to add impact to your presentation. Helping you to better convey your products, services, and value proposition, in ways that your prospects and clients will remember. \n\nEducators and trainers can recreate that feeling of presence, even while hosting remote classes. Research has shown that immersive learning increases retention and engagement. This is because we have evolved to learn about our world through personal and embodied experiences. With mixed reality, you can bring the world to your students like never before.\n\nAfterNow Prez makes it easy for anyone to create 3D experiences. No coding experience required!", "short_description": "AfterNow Prez is a platform for live immersive presentations to be delivered remotely. It empowers executives, sales teams, trainers, and educators to present immersive content to their audience all around the world; resulting in increased engagement, comprehension, and retention."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.afternow.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "AfterNow", "support_website_url": null, "website_url": "https://www.afternow.io/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NEWS_AND_INFORMATION", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "7658499104278507"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent
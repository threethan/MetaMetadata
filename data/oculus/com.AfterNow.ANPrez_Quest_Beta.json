67461276995_245250617993783372_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SUC-EbgmdMAQ7kNvwEgwl1S&_nc_oc=Adr8poxNWS3kPZ6hmzStdlHlYPrkY1BZ8q4YaQUE35TaiKSa6xgHE5CH4AHxmmhyqCo&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJOdGP53Jcx3nliMTAZLNrzuw1AY-Bljcm5c3v81zf08w&oe=6AA963CC"}, {"file_name": "screenshot_5.png", "id": "191331082776545", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974891_191331086109878_6510765715403447129_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bUDUhBcIbxsQ7kNvwEth_Ug&_nc_oc=AdrBQOMJoI6OdHteIIOhLKC_rh2CLCCdP-RM0VCamWKbnQg0NOd-R_YmeFqYiB69mdM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0QDZg2sPlGE8PSSlUmA-c0O7pNwYNQ5jdUw4FCDXMWg&oe=6AA94691"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Video.png", "id": "2557075024586240", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75443237_2557075027919573_2113441605653888610_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZzVciG2IrC4Q7kNvwHP56st&_nc_oc=AdofY1oAVklI6Pc5mQW4CWz2C-gahIEvKTvLCQedn2np33a9JS1u-cVssht6Zv6A8l0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLtPdP5jAOtQv9NWKiE3SWVKBLAawNYfKaSa8Ev_2_9Qw&oe=6AA93762"}, "display_name": "AfterNow Prez Beta", "keywords": [], "long_description": "AfterNow has created a platform to compose and deliver live immersive presentations remotely using virtual reality. Our technology,  empowers sales teams, trainers, and educators worldwide to present immersive content to their audience resulting in increased engagement, satisfaction, and retention.\n\nAfterNow Prez Remote offers the perfect combination of Zoom meets Powerpoint inside Virtual Reality.\n\nThe sales team uses AfterNow Prez Remote to better convey products, services, and value in ways their prospects and clients will remember. \n\nEducators and trainers can recreate the feeling of being in a class remotely with engaging and memorable content that students will understand and engage.\n", "short_description": "AfterNow Prez is a platform for live immersive presentations to be done remotely. It empowers executives, sales teams, trainers, and educators all around the world to present immersive content to their audience resulting in increased engagement, satisfaction, and retention.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.afternow.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "AfterNow", "support_website_url": null, "website_url": "https://www.afternow.io/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["EDUCATIONAL", "NEWS_AND_INFORMATION", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "635101891035587"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "824450294814145"}]}, "baseline_offer": {"id": "824450294814145"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1617208740, "status": "PUBLISHED", "id": "824450294814145"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5508805349247904", "version": "AN-Prez.QUEST.2.0"}, "id": "846667096187403", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"
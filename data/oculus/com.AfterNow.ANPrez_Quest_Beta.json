ly. It empowers executives, sales teams, trainers, and educators all around the world to present immersive content to their audience resulting in increased engagement, satisfaction, and retention.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.afternow.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "AfterNow", "support_website_url": null, "website_url": "https://www.afternow.io/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["EDUCATIONAL", "NEWS_AND_INFORMATION", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "635101891035587"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "824450294814145"}]}, "baseline_offer": {"id": "824450294814145"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1617208740, "status": "PUBLISHED", "id": "824450294814145"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5508805349247904", "version": "AN-Prez.QUEST.2.0"}, "id": "846667096187403", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3434684843326642", "is_concept": false, "latest_released_binary": {"__typename": "Andro
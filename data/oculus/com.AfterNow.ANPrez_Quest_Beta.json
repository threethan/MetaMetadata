73706_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J4JzqiCRzcAQ7kNvwHBbCGk&_nc_oc=Adp3qJ6uFGlUpwXdnAI5spKERaOgGlEB1-j07AwMqcFBBgBQq2NYxdD2UazvpXwtteU&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4bS-flF8KLidbh585QnGYd1jFjnEvUrhcCcdsANJBDtg&oe=6A11B4C4"}, {"file_name": "SlideControls.png", "id": "933280611438440", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39036628_933280614771773_7489312651977815592_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0h9E9GZVYIIQ7kNvwEsWCpS&_nc_oc=AdpIOw7JJ6drqRpbAd2RaYAqbEJRidcJY3j3K-qRTCXZMJNCvrvCKdU64YLirFxySyE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5bbJfe5ha7HwvQj1AxZ0ZsQIi-e2g7sLWKOlKBQrW2QA&oe=6A11BA09"}, {"file_name": "DataVisualization.png", "id": "473632957822227", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982644_473632961155560_4050351944845584581_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gGtP4BISUvEQ7kNvwGa_7bi&_nc_oc=Adq3xCQ1THPB6FTcjPVNdgdN4n8S4tTbHhZLHuAVfU_I9z5BEOXDEYn4H3L5FLO6c-4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4vmh1m9Qa8Ic77hx0Q4auLhO8fHbjJEzc5TvgjYmgxQg&oe=6A11A679"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Video.png", "id": "2557075024586240", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75443237_2557075027919573_2113441605653888610_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B97MZDW0xZwQ7kNvwGdJbzJ&_nc_oc=Adrj2Bf70zunr8xIVmxbVoolX3kOJ2vBGJyGbBJ7nz1ZqxbW1iqcli-fJoetgPXCNtM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-oBqrfYyAc0QJB7E3DFrZc9c_XT3Krp7UeuGzcBCwJA&oe=6A119AE2"}, "display_name": "AfterNow Prez Beta", "keywords": [], "long_description": "AfterNow Prez offers the perfect combination of \"Zoom meets PowerPoint inside Virtual Reality.\" We have created a platform to compose and deliver immersive presentations using the power of AR and VR.\n\nIn sales meetings, AfterNow Prez can be used to add impact to your presentation. Helping you to better convey your products, services, and value proposition, in ways that your prospects and clients will remember. \n\nEducators and trainers can recreate that feeling of presence, even while hosting remote classes. Research has shown that immersive learning increases retention and engagement. This is because we have evolved to learn about our world through personal and embodied experiences. With mixed reality, you can bring the world to your students like never before.\n\nAfterNow Prez makes it easy for anyone to create 3D experiences. No coding experience required!", "short_description": "AfterNow Prez is a platform for live immersive presentations to be delivered remotely. It empowers executives, sales teams, trainers, and educators to present immersive content to their audience all around the world; resulting in increased engagement, comprehension, and retention."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.afternow.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "AfterNow", "support_website_url": null, "website_url": "https://www.afternow.io/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NEWS_AND_INFORMATION", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "7658499104278507"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://
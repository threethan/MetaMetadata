n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E3ove0FaGCMQ7kNvwE4Vv99&_nc_oc=AdoLuZiCsfomj6LjtR0DdDTLbQCZ28ov6CTsO2Tc2ipQb5vuCQ4ymdBxIrIpOjmqZTM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_kn55a8s60feGTYLyqCoGTAtgg0BgVs0uu1PWO_fUz-w&oe=6A3FD944"}, {"file_name": "SlideControls.png", "id": "933280611438440", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036628_933280614771773_7489312651977815592_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7guUTqm8K_IQ7kNvwFEHwge&_nc_oc=AdqZmPcnOxk8ZyigKVOhg93lbzsszpUOEmX3_JXO1Nt81xiUZCH6QmuZerSa_o8HFoE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-VQdhOsR6EzywlcfVswcDfbESMbydQGlqx8SdJnT00tw&oe=6A3FDE89"}, {"file_name": "DataVisualization.png", "id": "473632957822227", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982644_473632961155560_4050351944845584581_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vI9jEkkc-4YQ7kNvwErFSFP&_nc_oc=Adp8LjLnFirRfuEv0J0qdgOwA-70lzwgT3hF6RiBnOCZpnCHJyttT6rtf-_pjxmhNrE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_xbDEhllng3rctC3rwFtUXsxnPcWWGSfi4oud6zk8HEg&oe=6A3FCAF9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Video.png", "id": "2557075024586240", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75443237_2557075027919573_2113441605653888610_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b4-Vl2G7yqcQ7kNvwGoRElA&_nc_oc=Adp0RVLMJ9NU4fqc02WtZ8wLIKin-dNFSPAy5tqYPuMANZ5PutoKJppmyFpOjsT4fTE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af847JBM3p0JyGtAeGeGI8jh9aKvolOupjPH3jOJSj8yKA&oe=6A3FBF62"}, "display_name": "AfterNow Prez Beta", "keywords": [], "long_description": "AfterNow Prez offers the perfect combination of \"Zoom meets PowerPoint inside Virtual Reality.\" We have created a platform to compose and deliver immersive presentations using the power of AR and VR.\n\nIn sales meetings, AfterNow Prez can be used to add impact to your presentation. Helping you to better convey your products, services, and value proposition, in ways that your prospects and clients will remember. \n\nEducators and trainers can recreate that feeling of presence, even while hosting remote classes. Research has shown that immersive learning increases retention and engagement. This is because we have evolved to learn about our world through personal and embodied experiences. With mixed reality, you can bring the world to your students like never before.\n\nAfterNow Prez makes it easy for anyone to create 3D experiences. No coding experience required!", "short_description": "AfterNow Prez is a platform for live immersive presentations to be delivered remotely. It empowers executives, sales teams, trainers, and educators to present immersive content to their audience all around the world; resulting in increased engagement, comprehension, and retention."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.afternow.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "AfterNow", "support_website_url": null, "website_url": "https://www.afternow.io/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NEWS_AND_INFORMATION", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "7658499104278507"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent
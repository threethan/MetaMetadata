n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lW6eEiFy7OEQ7kNvwG4KxGn&_nc_oc=AdoePC6yuRwgdg3wgr24joB7fPmTWbCgmpz_NdjIT5IKNa2uAED2gOaJ4cqJPDQCBFA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2lEohWBEs3jSJ8asOjgglY6-ccq0vEtjR_S4VLVpEGew&oe=69D3BE44"}, {"file_name": "SlideControls.png", "id": "933280611438440", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036628_933280614771773_7489312651977815592_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VGGaN6EQpfoQ7kNvwGSJAxD&_nc_oc=Adr8ojciAUqi2iJXx6_5rtosQUlRb6HFqTv3z15tWCBdGI8r74bEpQkKFSrAoo1uB_s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2GDhe7YiL1_G7S6KoYt4kq3qO9lFmFPL1MJ8x8yrfRyQ&oe=69D3C389"}, {"file_name": "DataVisualization.png", "id": "473632957822227", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982644_473632961155560_4050351944845584581_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F_jgKXAd9R4Q7kNvwGWdq5U&_nc_oc=Adpgp7Fk1qWjXKra12i6TB78iqQvEBeGWvn1ix07WRiumJUuXl6dQCoiOIxZ4WvU7uo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3N00Q4wDfmkpczuNjQNmnAMYdLufDpBvsxxTpqRfJkjA&oe=69D3AFF9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Video.png", "id": "2557075024586240", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75443237_2557075027919573_2113441605653888610_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=snXL8tlHn40Q7kNvwG4AflR&_nc_oc=AdpUwWTDfST36N6WAAWGanJhrLA0SR9lpJOssAjiKU7n4GrkANzQ-dITUz5W9xhdFKE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2375tWEAgfHkrSY7Mne685PmJ94LeoD4voQs_4gKHnkA&oe=69D3A462"}, "display_name": "AfterNow Prez Beta", "keywords": [], "long_description": "AfterNow Prez offers the perfect combination of \"Zoom meets PowerPoint inside Virtual Reality.\" We have created a platform to compose and deliver immersive presentations using the power of AR and VR.\n\nIn sales meetings, AfterNow Prez can be used to add impact to your presentation. Helping you to better convey your products, services, and value proposition, in ways that your prospects and clients will remember. \n\nEducators and trainers can recreate that feeling of presence, even while hosting remote classes. Research has shown that immersive learning increases retention and engagement. This is because we have evolved to learn about our world through personal and embodied experiences. With mixed reality, you can bring the world to your students like never before.\n\nAfterNow Prez makes it easy for anyone to create 3D experiences. No coding experience required!", "short_description": "AfterNow Prez is a platform for live immersive presentations to be delivered remotely. It empowers executives, sales teams, trainers, and educators to present immersive content to their audience all around the world; resulting in increased engagement, comprehension, and retention."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.afternow.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "AfterNow", "support_website_url": null, "website_url": "https://www.afternow.io/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NEWS_AND_INFORMATION", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "7658499104278507"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent
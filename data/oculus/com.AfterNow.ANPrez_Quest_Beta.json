5/75367592_433667461276995_245250617993783372_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X4iWWNIjS7QQ7kNvwHrerWi&_nc_oc=Adq2uiamY3SHcvaWNZLVpx6b9Ul4drV0cOfSna7Os9FmAVFnjgKqURqpiBE3FBYL2_4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHfL9DooSYjinQ3Pt-dhs1gCjmTggCvocm70xAMpXKL6g&oe=6A8D7C0C"}, {"file_name": "screenshot_5.png", "id": "191331082776545", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974891_191331086109878_6510765715403447129_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CIvpmm9p8PYQ7kNvwG_XZwX&_nc_oc=AdpdgU7csO4zYBUamr6IjuFzhM9-iG-2xAoj0_Eqtlp9DszM-1nMzRxSWqx18PuulWQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFUg-xV5SouHOo8l1fReZK74GGpSDGLOO3e85nRUkyMWw&oe=6A8D9711"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Video.png", "id": "2557075024586240", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75443237_2557075027919573_2113441605653888610_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=62Nl6CqYAK8Q7kNvwFNk5gx&_nc_oc=Adrm8B4Y1hBAFrpG7yDSdE9KiLK1MjBVFYJKQS6iocJm_kHB24rz_AJjowgvCnPXltM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHqwZwmEUo7Lv1v-YHP5kcmspePKcSW05_PFbyTN-pJjw&oe=6A8D87E2"}, "display_name": "AfterNow Prez Beta", "keywords": [], "long_description": "AfterNow has created a platform to compose and deliver live immersive presentations remotely using virtual reality. Our technology,  empowers sales teams, trainers, and educators worldwide to present immersive content to their audience resulting in increased engagement, satisfaction, and retention.\n\nAfterNow Prez Remote offers the perfect combination of Zoom meets Powerpoint inside Virtual Reality.\n\nThe sales team uses AfterNow Prez Remote to better convey products, services, and value in ways their prospects and clients will remember. \n\nEducators and trainers can recreate the feeling of being in a class remotely with engaging and memorable content that students will understand and engage.\n", "short_description": "AfterNow Prez is a platform for live immersive presentations to be done remotely. It empowers executives, sales teams, trainers, and educators all around the world to present immersive content to their audience resulting in increased engagement, satisfaction, and retention.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.afternow.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "AfterNow", "support_website_url": null, "website_url": "https://www.afternow.io/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["EDUCATIONAL", "NEWS_AND_INFORMATION", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "635101891035587"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "824450294814145"}]}, "baseline_offer": {"id": "824450294814145"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1617208740, "status": "PUBLISHED", "id": "824450294814145"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5508805349247904", "version": "AN-Prez.QUEST.2.0"}, "id": "846667096187403", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_
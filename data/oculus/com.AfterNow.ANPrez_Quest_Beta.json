0f&oh=00_AQS1SGdvnB_sPL_Pa8kbtbMTDzdJCmXLpbzxMfnc8PNoQQ&oe=6B09AEFA"}, {"file_name": "SmartCity.png", "id": "1127395041537761", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974594_1127395044871094_3674951848224373706_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n8WZldsizjEQ7kNvwEx1sKq&_nc_oc=Adpo1SeuHeQCQWl-cJC9P-89fGopTMhvpYc3rKnQc29eerK40dtqvjeIyXyGGDxH8qA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShnVz-GzRT0HbbgVD8h3nkXQLKpyGPVAJ3pC-m8gdyfg&oe=6B09C704"}, {"file_name": "SlideControls.png", "id": "933280611438440", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39036628_933280614771773_7489312651977815592_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H0sEIGg4mIEQ7kNvwHLUpzy&_nc_oc=AdqcDxpOg_n9gOYo_oVoKOJQbK6C0GSTD2jqXmATKdryFuvw2tgKRJtuWc4lpDXHmXI&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZwqrZfjb2ahWAhEbPOsY_8rURle4AwwEV2NCPTzD_OA&oe=6B09CC49"}, {"file_name": "DataVisualization.png", "id": "473632957822227", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38982644_473632961155560_4050351944845584581_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZVuEARDox-oQ7kNvwFsUfgE&_nc_oc=AdoOKZe3POyvcS4rwcaA2pjGI_1rDHyJHz_H5SbfNfoRnl0a_S9meGQKLWCmMdbhIsY&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRa_PZn-MHPodCKMZFDbrrUyrqS4AlwwYDJuaYCN1xgxQ&oe=6B09B8B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Video.png", "id": "2557075024586240", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75443237_2557075027919573_2113441605653888610_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZIJZfueLFAsQ7kNvwHPAaMP&_nc_oc=AdqYq9MVHSGpcjW8wjqU0eILLrf82szFV-TM8ckhMmXD6Z79GCn7YsIfrTEKu6ennfM&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUS8xmVC-yMNx3GFiTr0mqmFcjU5qYEHu0PIc9cYRUAQ&oe=6B09AD22"}, "display_name": "AfterNow Prez Beta", "keywords": [], "long_description": "AfterNow Prez offers the perfect combination of \"Zoom meets PowerPoint inside Virtual Reality.\" We have created a platform to compose and deliver immersive presentations using the power of AR and VR.\n\nIn sales meetings, AfterNow Prez can be used to add impact to your presentation. Helping you to better convey your products, services, and value proposition, in ways that your prospects and clients will remember. \n\nEducators and trainers can recreate that feeling of presence, even while hosting remote classes. Research has shown that immersive learning increases retention and engagement. This is because we have evolved to learn about our world through personal and embodied experiences. With mixed reality, you can bring the world to your students like never before.\n\nAfterNow Prez makes it easy for anyone to create 3D experiences. No coding experience required!", "short_description": "AfterNow Prez is a platform for live immersive presentations to be delivered remotely. It empowers executives, sales teams, trainers, and educators to present immersive content to their audience all around the world; resulting in increased engagement, comprehension, and retention."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.afternow.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "AfterNow", "support_website_url": null, "website_url": "https://www.afternow.io/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NEWS_AND_INFORMATION", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
qO1fjIKiRgSHhpOVgS9yZFuoncvB7M&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfuFXBns3W4knHuPwgLnNQNj8Ukym5yEACfMKOoqo-7dbw&oe=69A1A544"}, {"file_name": "SlideControls.png", "id": "933280611438440", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39036628_933280614771773_7489312651977815592_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P9JSQf3i9c4Q7kNvwHD8bVb&_nc_oc=AdmIUT02qQMm3XeuQt7muXFxXcC8D8oznZOjjOtfaRyVXYmyivGVd90qIZJiz75UE3w&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afu7By8_rnLrQTFqGOCXYlnjz-l7IGFrtEgsKrL4WbLZig&oe=69A1AA89"}, {"file_name": "DataVisualization.png", "id": "473632957822227", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38982644_473632961155560_4050351944845584581_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Aqp13vXo3AQ7kNvwFYMLEJ&_nc_oc=AdlKgjWzoWovpTWtGRqXvz5WTayyhnYcn0yenI72o48_GDMFfg6ZopB3Fs-8-eHjEK8&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfuH-KcZScXXtuMX0gjVrklYwvoMZxXmMQWM1dWYfr-9FA&oe=69A196F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Video.png", "id": "2557075024586240", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/75443237_2557075027919573_2113441605653888610_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m5GLak5AMWEQ7kNvwH-9aY5&_nc_oc=Adm251oAAucFTIqxorqiFYIArIxrK0nsxCQsTasZdrGrbEv34ZOM86JFiFVKNW_JNro&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftcVlOkFxo7x2N2WdeSwUO0Pvx5e3-a8ZgrHKE0yMqWFA&oe=69A18B62"}, "display_name": "AfterNow Prez Beta", "keywords": [], "long_description": "AfterNow Prez offers the perfect combination of \"Zoom meets PowerPoint inside Virtual Reality.\" We have created a platform to compose and deliver immersive presentations using the power of AR and VR.\n\nIn sales meetings, AfterNow Prez can be used to add impact to your presentation. Helping you to better convey your products, services, and value proposition, in ways that your prospects and clients will remember. \n\nEducators and trainers can recreate that feeling of presence, even while hosting remote classes. Research has shown that immersive learning increases retention and engagement. This is because we have evolved to learn about our world through personal and embodied experiences. With mixed reality, you can bring the world to your students like never before.\n\nAfterNow Prez makes it easy for anyone to create 3D experiences. No coding experience required!", "short_description": "AfterNow Prez is a platform for live immersive presentations to be delivered remotely. It empowers executives, sales teams, trainers, and educators to present immersive content to their audience all around the world; resulting in increased engagement, comprehension, and retention."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.afternow.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "AfterNow", "support_website_url": null, "website_url": "https://www.afternow.io/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NEWS_AND_INFORMATION", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "7658499104278507"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39001711_876454886506446_1974308151516123189_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eN6bpemZ1BcQ7kNvwG
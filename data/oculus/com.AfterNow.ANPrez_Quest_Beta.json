0f&oh=00_AQQL21_-D1j66zUDtw4n4K1kS8zy1PUHPDR2e57o-gtgXQ&oe=6B0DA37A"}, {"file_name": "SmartCity.png", "id": "1127395041537761", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974594_1127395044871094_3674951848224373706_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mxOsGDe5BT0Q7kNvwEQYMaG&_nc_oc=AdpTG3sFgOpQMxb0QwD2Cc10sC4NZXDhcSLSlRkpWnOMHs44lR34hLYltnQH8vbJ73c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRbvyMgyzWvKLVye8RsM5cGTakKlJWCx2hvwq26KaMlRQ&oe=6B0DBB84"}, {"file_name": "SlideControls.png", "id": "933280611438440", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036628_933280614771773_7489312651977815592_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D9ADPydf0oEQ7kNvwHL1Vb6&_nc_oc=Adqw8jpdxJGrSeIO7JpIJQT0FWbcwhMUnP5cBw6NV9FuSKDRS4uvGNWIJqBu3tEZzcA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS_jrgknGgTEnYxXA6hCMFaeYzqMl1JSEA3r1zhe3y96g&oe=6B0DC0C9"}, {"file_name": "DataVisualization.png", "id": "473632957822227", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982644_473632961155560_4050351944845584581_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G7A6c_0YpisQ7kNvwGb8Jr8&_nc_oc=AdpJbOWTLnyagWb8IL4kIVV_stXZteGFRat3q1CB0zOHsy4md1xx3bVb7vxc-OHmx_U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT2WUdA7dZPXSjx88cgAqohtl2C4A1LZ7BbQXJWJnBGwg&oe=6B0DAD39"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Video.png", "id": "2557075024586240", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75443237_2557075027919573_2113441605653888610_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UFOQ6vkT24QQ7kNvwGmlXsb&_nc_oc=AdprPrfY9s0TNqg3kdauYaJco-rIlpj1Mn7s485S2ffEJKxt6g3KU6YsliQm97lVylI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR-mPTdrZnrYpniufQGiSuO0wQXHwU2V70UdxL_Tsj6XA&oe=6B0DA1A2"}, "display_name": "AfterNow Prez Beta", "keywords": [], "long_description": "AfterNow Prez offers the perfect combination of \"Zoom meets PowerPoint inside Virtual Reality.\" We have created a platform to compose and deliver immersive presentations using the power of AR and VR.\n\nIn sales meetings, AfterNow Prez can be used to add impact to your presentation. Helping you to better convey your products, services, and value proposition, in ways that your prospects and clients will remember. \n\nEducators and trainers can recreate that feeling of presence, even while hosting remote classes. Research has shown that immersive learning increases retention and engagement. This is because we have evolved to learn about our world through personal and embodied experiences. With mixed reality, you can bring the world to your students like never before.\n\nAfterNow Prez makes it easy for anyone to create 3D experiences. No coding experience required!", "short_description": "AfterNow Prez is a platform for live immersive presentations to be delivered remotely. It empowers executives, sales teams, trainers, and educators to present immersive content to their audience all around the world; resulting in increased engagement, comprehension, and retention."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.afternow.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "AfterNow", "support_website_url": null, "website_url": "https://www.afternow.io/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NEWS_AND_INFORMATION", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_ap
7a0a&_nc_ohc=RIfkJrlRPQcQ7kNvwGW_vXy&_nc_oc=AdktMFjnWPaMLaaSyCSKImby3zRV23RLY9QBtJXBjz42EBecSFkY3S4bKHRAH3Oj1Zs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy4mvKqk43ZoS6eznSO0RFPnDuscsf1vBpv8k7XFpIQ0Q&oe=69B17744"}, {"file_name": "SlideControls.png", "id": "933280611438440", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036628_933280614771773_7489312651977815592_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lcVZPrx-vyAQ7kNvwGbid1g&_nc_oc=AdmKxIJipcDwo_78fM1FinrPAjUDVamSBo7z3h3z2gazjkVwoRIbNvi0FKz9KE2pRyQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwIwcWms8RiVYI9NST7JUOExXIEcYoO5ewcCzkSCu4iJA&oe=69B14449"}, {"file_name": "DataVisualization.png", "id": "473632957822227", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982644_473632961155560_4050351944845584581_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1FgxKf8kzt8Q7kNvwHPm34R&_nc_oc=AdlN4UouGgGBT9VKW6pwO-vnYGMz5XBgBoJzK9iS5LtPWC7cRQrti6s7yyRAwq02osY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx85pQvxufSEmuS6TLWUN9mEs6a9RI2QV9ZG0rPinWD5w&oe=69B168F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Video.png", "id": "2557075024586240", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75443237_2557075027919573_2113441605653888610_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vz8VATZ8TfcQ7kNvwEb5fDr&_nc_oc=Adm6bDQIxARn60C4fIsoz_tLy6CA0LTmcjHodkYJvHCzez0tRV0_49_LQSR1JsFTz3M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwK1hpBEV2UZL5qEvYy4woeKhjNvInUbv0CyIq2JLEIJg&oe=69B15D62"}, "display_name": "AfterNow Prez Beta", "keywords": [], "long_description": "AfterNow Prez offers the perfect combination of \"Zoom meets PowerPoint inside Virtual Reality.\" We have created a platform to compose and deliver immersive presentations using the power of AR and VR.\n\nIn sales meetings, AfterNow Prez can be used to add impact to your presentation. Helping you to better convey your products, services, and value proposition, in ways that your prospects and clients will remember. \n\nEducators and trainers can recreate that feeling of presence, even while hosting remote classes. Research has shown that immersive learning increases retention and engagement. This is because we have evolved to learn about our world through personal and embodied experiences. With mixed reality, you can bring the world to your students like never before.\n\nAfterNow Prez makes it easy for anyone to create 3D experiences. No coding experience required!", "short_description": "AfterNow Prez is a platform for live immersive presentations to be delivered remotely. It empowers executives, sales teams, trainers, and educators to present immersive content to their audience all around the world; resulting in increased engagement, comprehension, and retention."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.afternow.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "AfterNow", "support_website_url": null, "website_url": "https://www.afternow.io/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NEWS_AND_INFORMATION", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "7658499104278507"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001711_8764548
8FICFaplC2mYbjQ8JHZOcyOhKlIgOA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Afv1-KYqUawcbxhNSqvsTZ4K4AdFgpNaEbz-TPgub3Qh4w&oe=69A599C4"}, {"file_name": "SlideControls.png", "id": "933280611438440", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036628_933280614771773_7489312651977815592_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I4zrj0TnmZkQ7kNvwHy8ScR&_nc_oc=AdnSfDm-zfp-0jbjTSlplVXFFi38zf9FK9Dd036ZwsdTQeXg569jsK5scQ-7ifJMFDs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afsz8O9M-TJlOYdk-0jN5DnjPAnpWeDKAmlhyk37EKfeaw&oe=69A59F09"}, {"file_name": "DataVisualization.png", "id": "473632957822227", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982644_473632961155560_4050351944845584581_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BgBlGfY94fkQ7kNvwFziDCh&_nc_oc=AdkUput0Z-f-XG3E6NAbMselM_EZHlI0FPwwwnaQtzc9g23ki-uHoKBKM2X9b-sP4dg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Afu2ORPoqeZ2AEm8OtR7DV_lDMcXd8NiDZnKDqG19hNN-Q&oe=69A58B79"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Video.png", "id": "2557075024586240", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75443237_2557075027919573_2113441605653888610_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CvL7FzpMtbIQ7kNvwHJPtIS&_nc_oc=Adlip8mK5ap-hJYXEdyQ2Xe-UZ_UKOFctU_qnCObm4Ns5iJ3jWVhiUmww0iVPPZ58DQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfvXtMh42tdl8ZDsNW-u30q97fVu3uUM7xTDyd3HX6QaQw&oe=69A57FE2"}, "display_name": "AfterNow Prez Beta", "keywords": [], "long_description": "AfterNow Prez offers the perfect combination of \"Zoom meets PowerPoint inside Virtual Reality.\" We have created a platform to compose and deliver immersive presentations using the power of AR and VR.\n\nIn sales meetings, AfterNow Prez can be used to add impact to your presentation. Helping you to better convey your products, services, and value proposition, in ways that your prospects and clients will remember. \n\nEducators and trainers can recreate that feeling of presence, even while hosting remote classes. Research has shown that immersive learning increases retention and engagement. This is because we have evolved to learn about our world through personal and embodied experiences. With mixed reality, you can bring the world to your students like never before.\n\nAfterNow Prez makes it easy for anyone to create 3D experiences. No coding experience required!", "short_description": "AfterNow Prez is a platform for live immersive presentations to be delivered remotely. It empowers executives, sales teams, trainers, and educators to present immersive content to their audience all around the world; resulting in increased engagement, comprehension, and retention."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.afternow.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "AfterNow", "support_website_url": null, "website_url": "https://www.afternow.io/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NEWS_AND_INFORMATION", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "7658499104278507"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001711_876454886506446_1974308151516123189_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Njc8RUbnkwQ7kNvwE
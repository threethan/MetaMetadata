n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_OcD8kIkZncQ7kNvwF48g0_&_nc_oc=AdobQJX8PiruQsgNBGL5dZfaLhP-pLOR4U_sjEingjOIwOTX6zTIWZvF-6ikdzciU00&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM0GYGoVr91eI9wb5ZOGKVfPX50A22k3VhBv6EjRbGqZw&oe=6AE201C4"}, {"file_name": "SlideControls.png", "id": "933280611438440", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036628_933280614771773_7489312651977815592_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vaPeqsesw_QQ7kNvwEI9nfG&_nc_oc=AdoVbybbslaFBkxPv8Xjd3WKpT--uPgaR9clzmXs2Sz3u5Cm8QmQ5MC9eQAZFdZ-0IY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMw9_NQSLdk06dGPqfU7WkNAKEvQupUmH3SCdE_kj77yg&oe=6AE20709"}, {"file_name": "DataVisualization.png", "id": "473632957822227", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982644_473632961155560_4050351944845584581_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5RJ6EawWHa4Q7kNvwHY1p8I&_nc_oc=AdokD7wOf57JKjRCkyHWwW41jHVcc0Hex7eHbi4KXvjyP1jXgm6cR3VCdwfCakMNmBQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMVPRDpZUrxfUMF-LBNX187b8hUqzBxith_2nZY5m52oQ&oe=6AE1F379"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Video.png", "id": "2557075024586240", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75443237_2557075027919573_2113441605653888610_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=38oMjwuJdcsQ7kNvwF9teZx&_nc_oc=AdqXMMOWgdy6St6c4JfwO9eH03xHu7aEX01sOmC_dXVOjGg9vUXhkB1V7-A8iqtWe4Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPzXwDMKlabGxbXQxwtuZUlq9CjZ2aJhGJHgxJyiXSs0g&oe=6AE1E7E2"}, "display_name": "AfterNow Prez Beta", "keywords": [], "long_description": "AfterNow Prez offers the perfect combination of \"Zoom meets PowerPoint inside Virtual Reality.\" We have created a platform to compose and deliver immersive presentations using the power of AR and VR.\n\nIn sales meetings, AfterNow Prez can be used to add impact to your presentation. Helping you to better convey your products, services, and value proposition, in ways that your prospects and clients will remember. \n\nEducators and trainers can recreate that feeling of presence, even while hosting remote classes. Research has shown that immersive learning increases retention and engagement. This is because we have evolved to learn about our world through personal and embodied experiences. With mixed reality, you can bring the world to your students like never before.\n\nAfterNow Prez makes it easy for anyone to create 3D experiences. No coding experience required!", "short_description": "AfterNow Prez is a platform for live immersive presentations to be delivered remotely. It empowers executives, sales teams, trainers, and educators to present immersive content to their audience all around the world; resulting in increased engagement, comprehension, and retention."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.afternow.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "AfterNow", "support_website_url": null, "website_url": "https://www.afternow.io/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NEWS_AND_INFORMATION", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "7658499104278507"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent
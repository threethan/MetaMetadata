n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v_61Iblc9UEQ7kNvwFg82fv&_nc_oc=AdpL_XyxOwTsCXf4_sNzBzrcWC2X4hyW3G-O_Ob3yXeO0zuHbunrSNHS4MBn6mI__2g&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz7MpbR1oJ1kO9YK0q8le6bl8BHfUEWVDW_i5VIypXhdA&oe=69C7E0C4"}, {"file_name": "SlideControls.png", "id": "933280611438440", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39036628_933280614771773_7489312651977815592_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mixD_HV1VYsQ7kNvwH4qL0L&_nc_oc=AdrvaKLUP11t8Q3sJ3J1HNQfWx7B-1viDO83-gEFY952rdesVrQWAWmRfN7xRLC2FGg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyFPMkkfKCczmQPjwxDQRna9TpAeFSryC9wLBasKQCRog&oe=69C7E609"}, {"file_name": "DataVisualization.png", "id": "473632957822227", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982644_473632961155560_4050351944845584581_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R0K1rOoilggQ7kNvwFUf17V&_nc_oc=AdrrWQHJvqIvk3_BKtozLFRpOo1mJYJBefLXHT6D4nMRpu6mlferC1ll60WKVdWh6eA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwKsYqA4_WYvMy0KA2jr6-41BsM1cOo2VrXSNvXQ5jTiw&oe=69C7D279"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Video.png", "id": "2557075024586240", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75443237_2557075027919573_2113441605653888610_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qbv0irgRJYwQ7kNvwEFSEvq&_nc_oc=AdpPTYpHyoDPZ2q8cB9AIN1k0i83iyPvPA0GaxLc1CPogLjVF5UuypXvBqk6Owm_2m4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwETJV-sw92vSQxU9toaKOMnccI5lBk5KcT-tF_w639Ag&oe=69C7C6E2"}, "display_name": "AfterNow Prez Beta", "keywords": [], "long_description": "AfterNow Prez offers the perfect combination of \"Zoom meets PowerPoint inside Virtual Reality.\" We have created a platform to compose and deliver immersive presentations using the power of AR and VR.\n\nIn sales meetings, AfterNow Prez can be used to add impact to your presentation. Helping you to better convey your products, services, and value proposition, in ways that your prospects and clients will remember. \n\nEducators and trainers can recreate that feeling of presence, even while hosting remote classes. Research has shown that immersive learning increases retention and engagement. This is because we have evolved to learn about our world through personal and embodied experiences. With mixed reality, you can bring the world to your students like never before.\n\nAfterNow Prez makes it easy for anyone to create 3D experiences. No coding experience required!", "short_description": "AfterNow Prez is a platform for live immersive presentations to be delivered remotely. It empowers executives, sales teams, trainers, and educators to present immersive content to their audience all around the world; resulting in increased engagement, comprehension, and retention."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.afternow.io/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "AfterNow", "support_website_url": null, "website_url": "https://www.afternow.io/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NEWS_AND_INFORMATION", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "7658499104278507"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent
7&_nc_sid=6e7a0a&_nc_ohc=q03If6YnqSEQ7kNvwGgwq2-&_nc_oc=AdoqWNKBCDD1Bclcfh5UWox89Y6RasW4NpZPDEWMM7_9JGeAuZuKCYp0-5iPg15Bh7Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPn7jWujCw6mrxdil1CJL8ht-ZtfJ4-YSjZnHhzbeIgw&oe=6AFDC89C"}, {"file_name": "Untitled design (7).png", "id": "1662891644690680", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499298502_1662891648024013_6521369041827831831_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zs5Ju0BbRD8Q7kNvwG3Nv_z&_nc_oc=AdrtNjuoGUSH9TvrqVE42vDUmpJ3I5sPVSiHWm1x4yHE405gFqB-KcB6Vm5g-sMVDE0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAuk8fl1Y7d5UkEb5Dh9SUcJ1T6OGO52sxd99u349krA&oe=6AFDD056"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bike Rider - Republic Racing: Cycling", "keywords": ["cycle", "racing", "bike", "riding", "bmx"], "long_description": "Bike Rider \u2013 Republic Racing: Cycling Games is a simple, casual VR biking experience built for quick and comfortable play sessions. Hop on your virtual bike and ride through three different environments, each designed with small hurdles and light challenges so you stay engaged without feeling overwhelmed.\n\nRace through a calm countryside road, navigate compact city streets, and handle slight turns on a mountain-style trail. Each track offers basic level-based goals: stay on the path, dodge obstacles, and reach the finish line as smoothly and quickly as you can.\n\nThe game focuses on accessibility and ease of use, making it a solid choice for new VR players or anyone who just wants a relaxed cycling game without complex systems or upgrades.\n\n**Features:**\n\n* 3 unique environments: countryside, city, and mountain-style tracks\n* Small hurdles and obstacles for casual challenge\n* Level-based progression with simple finish-line goals\n* Easy controls, ideal for beginners and casual players\n* Comfort-friendly design focused on straightforward forward riding\n", "short_description": "Bike Rider \u2013 Republic Racing is a simple VR cycling game with three unique environments and level-based challenges. Hop on your bike and ride through countryside roads, busy city streets, and light mountain trails while dodging small hurdles along the way. With easy controls and straightforward goals, it\u2019s perfect for casual players and new VR users who just want to pedal, relax, and race to the finish line."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/torquegames/privacy-policy/meta-quest-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Torque Games", "support_website_url": null, "website_url": "https://sites.google.com/view/torquegames/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25325289130401176"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499300678_1416296127167604_2067985824992735403_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J8evycdaPvoQ7kNvwG_cUOK&_nc_oc=AdobtWMWoRmMmbM1bU3oXcpD4ooRbaZHBUUm8ShswtZRZnVPwui77897cHMBq8isPTA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXulmGIp1CDQu9ztS1vgyMSNZuosFxTo6z3p6cXeBhsQ&oe=6AFDAD6E"}, "is_concept": false, "is_test
9_4315465775177693_2480218532608502500_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vW4ZE5mVUMsQ7kNvwFIPWFf&_nc_oc=AdmWV3BcSGaTIifBhXGcx631sQR1pXC_siJYgePhg2k2Muj3Middcpmoy7WWaPrJRuQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyHIRzNaxGtHCrkU_GSgY78mO0UZx4xPg9JiKMNBs3nfw&oe=69B54902"}, {"file_name": "Screen2.png", "id": "190875099726001", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974497_190875103059334_7590394738483320488_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NswH9h3Y3NoQ7kNvwFucfZ0&_nc_oc=AdlN2ofqsADIBfhtnhjdkxQsiaFgibzHMgrpyiRLzxSxuAwFYegudLPaAGZR9J8tF3o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxyY4A-BSyCMDXefBTwsTc6YuaWD-dOIwDoftHYOjWyYQ&oe=69B56028"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailerprev.png", "id": "978077019671638", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982441_978077023004971_2328662040582874456_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nVEUTaHVEFQQ7kNvwF40iPb&_nc_oc=AdmZ7N-ZUJNG4Pg-jtaRu0tbPbkfWN9qxiq-OKDNFPXU6rU14P9fvZT3upJ7Yv8np6I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx2P6TFh7_6kCCuD1PZr8milfXw1EzolKrS5nmbDq0-aQ&oe=69B55EB6"}, "display_name": "DrumBeats VR", "keywords": [], "long_description": "DrumBeatsVR is a VR drumming music game. You can drum to songs to unleash your inner drummer! In DrumBeatsVR you can practice on different drum kits, including Metallica and The Rolling Stones and you can play in three different environments (more to be added later). \n\nEpic Scenes:\nDrum studio\nAntarctica\nOcean Floor\n\nDrum kits:\nBasic Rock Kit\nMetallica (sound and setup)\nThe Rolling Stones (sound and setup)\n\nFree play\nPlay on the drum kits and environments listed above however you like\n\nArcade\nPlay along with our custom made songs", "short_description": "DrumBeatsVR is a VR drumming music game. You can drum to songs to unleash your inner drummer! In DrumBeatsVR you can practice on d
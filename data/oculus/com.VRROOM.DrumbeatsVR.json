9_4315465775177693_2480218532608502500_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hwXqDKu6cEkQ7kNvwFsPC_9&_nc_oc=Adm6czW27TlHfnSBsJ3_0FJ9quZBmmO4gHsMJ89Xa__i9QWepxbFR-OXW22RfqD-bAc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwO2k9VYfCYoUTrF0Od2Du20gHAU_rf54UeYD8mifmYRg&oe=69BD3202"}, {"file_name": "Screen2.png", "id": "190875099726001", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974497_190875103059334_7590394738483320488_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QSqdAieMj5cQ7kNvwHaw61y&_nc_oc=AdnFbTfRFk4mRwGya2PPvCdEnOAN_cmeZVWxvYVXJ5pg_hZIKQroCpzyPHm_S5Mo59o&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwsU4k4KTOPSiQZrdFLiylYSbzn1zVm37DWwyF1Llea_Q&oe=69BD4928"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailerprev.png", "id": "978077019671638", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982441_978077023004971_2328662040582874456_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NEDkjsVbAMgQ7kNvwFiWaMX&_nc_oc=Adl6Hi1XT3j-bgW1Q7QamEWw8uXjIjHQ0pEwEhOcfN-yEZe0pOMEj42qfcNyW7yPVkY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwPsBPvPhi4gg2xpqqaOuggYQ2JxUmwehUWldAa3ZQIzA&oe=69BD47B6"}, "display_name": "DrumBeats VR", "keywords": [], "long_description": "DrumBeatsVR is a VR drumming music game. You can drum to songs to unleash your inner drummer! In DrumBeatsVR you can practice on different drum kits, including Metallica and The Rolling Stones and you can play in three different environments (more to be added later). \n\nEpic Scenes:\nDrum studio\nAntarctica\nOcean Floor\n\nDrum kits:\nBasic Rock Kit\nMetallica (sound and setup)\nThe Rolling Stones (sound and setup)\n\nFree play\nPlay on the drum kits and environments listed above however you like\n\nArcade\nPlay along with our custom made songs", "short_description": "DrumBeatsVR is a VR drumming music game. You can drum to songs to unleash your inner drummer! In DrumBeatsVR you can practice on d
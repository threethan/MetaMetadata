, "id": "499772449764049", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/86610704_499772453097382_14284482259460664_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V7LmSDpGo9sQ7kNvwHOtrV0&_nc_oc=Ado_CcnjTBHDNsgf-wNMx_kikKrQ5Qi09AnAh5HnV1DUvkkUo8rWcx8SSuldS3inASA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_pzwN7Tc-EQjAuwU-CjrbsVasFbRU_JeiR3CcO2LiwYw&oe=6A36966F"}, {"file_name": "Screen5.png", "id": "351784803306425", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974904_351784806639758_2658031322900797500_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nleMOo-6sLcQ7kNvwHywEIJ&_nc_oc=Adpf38F8gcK1Dnn-4oeyzoo2QQaMQHIzc7RXTYqd3VpKUuA9VI0GmnbAafDmSM7LDYw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Y_bahvUBcBQoVxhasjXFaOuyGNpBG7Ko4R7S_FcOqNA&oe=6A36A300"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "quest-update.png", "id": "9578478005544344", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031311_9578478015544343_4355011210598936222_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gjnLSxK4Ei0Q7kNvwGU1cdU&_nc_oc=AdqzL3h2gVMDchOnSIKxOgWLNARFBrm16adGvNqelm2SWoqXg3bI4GqQ7FNo2K7wxRI&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rBpSqLte87Nyw7PAOMfwIUTEq-B8rPIZYo1tn-XvSIQ&oe=6A3699ED"}, "display_name": "DrumBeats VR", "keywords": ["Drum", "Music", "Rhythm", "DrumBeats", "Festival"], "long_description": "DrumBeats VR is a drumming music game for VR. Play on iconic drumkits and play in epic scenes! \n\nYour driving rhythm makes you the heartbeat of every song you play. With a setlist of 21 tracks and more on the way, you can jam along to your favorite tunes and feel like a true member of the band.\n\nPlay in **epic** scenes that will transport you to otherworldly locations.\nFrom the comfort of your own home, you can play in a Studio, descend into Hell, explore the depths of the ocean floor, brave the frozen tundra of Antarctica, and even drum on the moon!\n\n\n# Scenes:\n- Haunted Asylum\n- Drum Studio\n- Antarctica\n- Hell\n- Bottom of the Ocean\n- The Moon\n- Synthwave\n\n# Drum kits:\n- Rock Kit (it's setup is fully customizable)\n- Lefty Rock Kit  (it's setup is fully customizable)\n- Metallica (sound and setup)\n- The Rolling Stones (sound and setup)\n\n\n# Game Modes:\n**Arcade**\n\nPlay along with our custom made songs\n\n\n**Free play**\n\nPlay on the drum kits and environments listed above however you like\n\n**Custom**\n\nYou can import custom songs into the game so you can expand the setlist with your own songs.", "short_description": "DrumBeats VR is a drumming music game for VR. Play on iconic drumkits and play in epic scenes! With your driving rhythm you become the backbone of every song you play. With a setlist of 21 songs and more on the way, you can play along to your favorite tunes and feel like you're part of the band.\n"}]}, "developer_name": "Marcel Eissens || VRROOM", "developer_privacy_policy_url": "https://drumbeatsvr.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "MESHm", "support_website_url": null, "website_url": "https://www.drumbeatsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32868726912773226"}, "review_messages": []}]}, "cover_square_image": {"u
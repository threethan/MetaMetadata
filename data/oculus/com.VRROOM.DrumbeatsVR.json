9_4315465775177693_2480218532608502500_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vW4ZE5mVUMsQ7kNvwG7UtgK&_nc_oc=AdkyRES5iOmaEVxqc8136Wwcq_MqPJ25di-GDWIDpDW7k_LcyUyxotT-GcEDm8AhNnM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyNKmh7ntEJyoZNjJFN7B3Bv-xUUrUIZ5rvIXsKk3DLlw&oe=69B3F782"}, {"file_name": "Screen2.png", "id": "190875099726001", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974497_190875103059334_7590394738483320488_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NswH9h3Y3NoQ7kNvwHZ4Wgg&_nc_oc=AdlCMKCui0F2vpHff1c7nA5mwJbLOPatU54y3POb1gBWz4-I7kbMWkMBnOh2TKjxARs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy5E1JY2dutj_l3aM5mvg6rkdLXKziHyDSeUrUikkHirw&oe=69B40EA8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailerprev.png", "id": "978077019671638", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982441_978077023004971_2328662040582874456_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nVEUTaHVEFQQ7kNvwETOjL2&_nc_oc=AdkzD0O6wX5QB7Xrf5Pp93SOC1jxfV9CLSsDbL-AdvVd8nCjB8XBeVc7DKkLIr_tBzc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxOb9-XTooTUft0RrbB6dDv3NxVi4ButTVgWB2b6xoa-A&oe=69B40D36"}, "display_name": "DrumBeats VR", "keywords": [], "long_description": "DrumBeatsVR is a VR drumming music game. You can drum to songs to unleash your inner drummer! In DrumBeatsVR you can practice on different drum kits, including Metallica and The Rolling Stones and you can play in three different environments (more to be added later). \n\nEpic Scenes:\nDrum studio\nAntarctica\nOcean Floor\n\nDrum kits:\nBasic Rock Kit\nMetallica (sound and setup)\nThe Rolling Stones (sound and setup)\n\nFree play\nPlay on the drum kits and environments listed above however you like\n\nArcade\nPlay along with our custom made songs", "short_description": "DrumBeatsVR is a VR drumming music game. You can drum to songs to unleash your inner drummer! In DrumBeatsVR you can practice on d
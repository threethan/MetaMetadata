: "499772449764049", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86610704_499772453097382_14284482259460664_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v5aejHiKL90Q7kNvwEOnAKm&_nc_oc=AdpqM5Q6QXU48injaS9lKVPIO1vVbkcgNMDtbpolG310ApepQ-tUS2z5z-fDBqAKkoY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-5XTGewDy7e085JlkN9WzGU2Rq8-CPS2Q0_SVyT9VlSA&oe=6A3A8AEF"}, {"file_name": "Screen5.png", "id": "351784803306425", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974904_351784806639758_2658031322900797500_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=53ryDB281zEQ7kNvwFUGSep&_nc_oc=AdqA7Ae3JJSvdeshbtYZ5kNib_N-uo10XhO-P7hvlXGllGwhEymP9dM2yP9PRPkIECA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af95JIsUk7ddHZNIFbtefkFZAVmM2S8YNk0XrThLgnXkSg&oe=6A3A9780"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "quest-update.png", "id": "9578478005544344", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031311_9578478015544343_4355011210598936222_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GgvZuUXPr78Q7kNvwF10b7n&_nc_oc=AdrXgMb8PMzNV_G35mIy3QOdL0CMBHQ1nQYfNEGr3s_0vjoiTvP9PZY8ded7S6iUU_E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9sgTq_biabsOsy2_g9ft5jiTd9zQ2C1FziROx2UyiQlQ&oe=6A3A8E6D"}, "display_name": "DrumBeats VR", "keywords": ["Drum", "Music", "Rhythm", "DrumBeats", "Festival"], "long_description": "DrumBeats VR is a drumming music game for VR. Play on iconic drumkits and play in epic scenes! \n\nYour driving rhythm makes you the heartbeat of every song you play. With a setlist of 21 tracks and more on the way, you can jam along to your favorite tunes and feel like a true member of the band.\n\nPlay in **epic** scenes that will transport you to otherworldly locations.\nFrom the comfort of your own home, you can play in a Studio, descend into Hell, explore the depths of the ocean floor, brave the frozen tundra of Antarctica, and even drum on the moon!\n\n\n# Scenes:\n- Haunted Asylum\n- Drum Studio\n- Antarctica\n- Hell\n- Bottom of the Ocean\n- The Moon\n- Synthwave\n\n# Drum kits:\n- Rock Kit (it's setup is fully customizable)\n- Lefty Rock Kit  (it's setup is fully customizable)\n- Metallica (sound and setup)\n- The Rolling Stones (sound and setup)\n\n\n# Game Modes:\n**Arcade**\n\nPlay along with our custom made songs\n\n\n**Free play**\n\nPlay on the drum kits and environments listed above however you like\n\n**Custom**\n\nYou can import custom songs into the game so you can expand the setlist with your own songs.", "short_description": "DrumBeats VR is a drumming music game for VR. Play on iconic drumkits and play in epic scenes! With your driving rhythm you become the backbone of every song you play. With a setlist of 21 songs and more on the way, you can play along to your favorite tunes and feel like you're part of the band.\n"}]}, "developer_name": "Marcel Eissens || VRROOM", "developer_privacy_policy_url": "https://drumbeatsvr.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "MESHm", "support_website_url": null, "website_url": "https://www.drumbeatsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32868726912773226"}, "review_messages": []}]}, "cover_square_image": {"uri": "ht
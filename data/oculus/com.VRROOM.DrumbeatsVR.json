9_4315465775177693_2480218532608502500_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RYg017X1zkMQ7kNvwGEXQrR&_nc_oc=AdmsMGioMR6ryAJ4tl7nyRS19p8SkZ_evov9wZdlt4LyJHS_T2PnCFCtTsUhXOocOCE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxFKJwgH39CpU1jr4ePx8pzENvb340OqluW3GvpcvJWxA&oe=69BFD502"}, {"file_name": "Screen2.png", "id": "190875099726001", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974497_190875103059334_7590394738483320488_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sf4_OfB7OF8Q7kNvwHj0HSp&_nc_oc=AdmIsVxQ-cPzDfIMsqbOSzMc7f8VGK7R2iJxiF0E522o9guLNGGJKJJ_MNRzOskdSd4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyrPoGI7e8Q3oP6BA_O0BZbcP2u9CLn7eOE6N--w2fnpw&oe=69BFEC28"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailerprev.png", "id": "978077019671638", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982441_978077023004971_2328662040582874456_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TzOBPQjx0uwQ7kNvwE88uBD&_nc_oc=Admi1llnk65Uhi1oeAjA3CK_KK4KR_zYCM0ZkBlfVpBzm19O0EgUQaSarvjFytDH9mw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwKlLw_Umyy9XnLjGjlEl815yad6h2mZbVv75OIyr_5BA&oe=69BFEAB6"}, "display_name": "DrumBeats VR", "keywords": [], "long_description": "DrumBeatsVR is a VR drumming music game. You can drum to songs to unleash your inner drummer! In DrumBeatsVR you can practice on different drum kits, including Metallica and The Rolling Stones and you can play in three different environments (more to be added later). \n\nEpic Scenes:\nDrum studio\nAntarctica\nOcean Floor\n\nDrum kits:\nBasic Rock Kit\nMetallica (sound and setup)\nThe Rolling Stones (sound and setup)\n\nFree play\nPlay on the drum kits and environments listed above however you like\n\nArcade\nPlay along with our custom made songs", "short_description": "DrumBeatsVR is a VR drumming music game. You can drum to songs to unleash your inner drummer! In DrumBeatsVR you can practice on d
9_4315465775177693_2480218532608502500_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RYg017X1zkMQ7kNvwGwAroN&_nc_oc=AdqGnWwActiahcGT6Td_A01svy9n2wihe6KTAg1D3ufYDrIAc1Pez4nbnJEtXJp5kQ8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afwc30L-8A8ES6MCZiCTnv-mYIPcZdjQ6HzE2a8n4zqikA&oe=69C12682"}, {"file_name": "Screen2.png", "id": "190875099726001", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974497_190875103059334_7590394738483320488_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sf4_OfB7OF8Q7kNvwHRoYBA&_nc_oc=AdpnC5ZszmKEkGXNzeIOm9-lzPq-Z7X5ar5UvMFKF1gq3d2jG3TpPyf8WgMrbR3gQwQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afx3BsG5YJd0QR0is-zSYgRb2msC8e3XegfXoQ8aypDlhA&oe=69C13DA8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailerprev.png", "id": "978077019671638", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982441_978077023004971_2328662040582874456_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TzOBPQjx0uwQ7kNvwE2URRl&_nc_oc=AdrKtzPObRQYV-mfnC6YUucTQAslbaat617mY5EF5o7_SPK0csoR6w81zDZrIjY2BPI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxiqBdCJ7mH4JCtv_BPebxgZTxD3IRwveKPQepeBxO-jw&oe=69C13C36"}, "display_name": "DrumBeats VR", "keywords": [], "long_description": "DrumBeatsVR is a VR drumming music game. You can drum to songs to unleash your inner drummer! In DrumBeatsVR you can practice on different drum kits, including Metallica and The Rolling Stones and you can play in three different environments (more to be added later). \n\nEpic Scenes:\nDrum studio\nAntarctica\nOcean Floor\n\nDrum kits:\nBasic Rock Kit\nMetallica (sound and setup)\nThe Rolling Stones (sound and setup)\n\nFree play\nPlay on the drum kits and environments listed above however you like\n\nArcade\nPlay along with our custom made songs", "short_description": "DrumBeatsVR is a VR drumming music game. You can drum to songs to unleash your inner drummer! In DrumBeatsVR you can practice on d
9_4315465775177693_2480218532608502500_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Y-vRs8bJaYQ7kNvwE4k6FB&_nc_oc=Adki-SrE6PHJfEl6Hx-JUJUgEeBr3yHaq2xvZceupoer-_khrT1dL2t2NXifCk44sO0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afu0Y8fIgFkYk9Jxl4CpjN_oWyKAf_DmBkAU1jmvDCN8QA&oe=69A96B82"}, {"file_name": "Screen2.png", "id": "190875099726001", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974497_190875103059334_7590394738483320488_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iZ_epPFU3pAQ7kNvwHn8pGU&_nc_oc=Adk8zVct6xWvTtwjrYROO8-FWNIh7U3xUGWbHnkmrQ9pD3t9DeJlI9ipWz7t8FsQm5M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsiDWhQhnKXS5YOlIrWTu0MsV7R1JyM77pBo66SqkRL4Q&oe=69A982A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailerprev.png", "id": "978077019671638", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982441_978077023004971_2328662040582874456_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FKpDVG4WaNIQ7kNvwHtG8hy&_nc_oc=AdnD0q0yLBqbeYgrR_TVOmNTytDLA9_zOqmPAnX6ToN12nEuHhia7IYjoiOtvGQbvzQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AftS8zjGrdcuqYJzULleD6gsVxgYgSoPL7ovi4t-1jmYNw&oe=69A98136"}, "display_name": "DrumBeats VR", "keywords": [], "long_description": "DrumBeatsVR is a VR drumming music game. You can drum to songs to unleash your inner drummer! In DrumBeatsVR you can practice on different drum kits, including Metallica and The Rolling Stones and you can play in three different environments (more to be added later). \n\nEpic Scenes:\nDrum studio\nAntarctica\nOcean Floor\n\nDrum kits:\nBasic Rock Kit\nMetallica (sound and setup)\nThe Rolling Stones (sound and setup)\n\nFree play\nPlay on the drum kits and environments listed above however you like\n\nArcade\nPlay along with our custom made songs", "short_description": "DrumBeatsVR is a VR drumming music game. You can drum to songs to unleash your inner drummer! In DrumBeatsVR you can practice on d
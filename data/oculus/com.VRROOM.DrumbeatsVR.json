9_4315465775177693_2480218532608502500_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UiJh37rcVD0Q7kNvwHCal3v&_nc_oc=AdnGUaBvqYyoJ10ATyCip7LIL1CKvgfOMgLiYcRePUjbsk32fDQnSmuJQTZmvnXyTn8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx0tar5Acc21vti6J0rFqCg4jgR0yn9uZyD9RT_A8OU4w&oe=69B69A82"}, {"file_name": "Screen2.png", "id": "190875099726001", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974497_190875103059334_7590394738483320488_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NswH9h3Y3NoQ7kNvwE7acIs&_nc_oc=AdkGcwGyznnmcoj8KUdiVciIO15QA-d3Cw-9lBrjDNsFCVQekrnQg2k2KukQvEl_TvY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwmkZwOuMhPwDT9n_8BKasC-uHI541BrMQo9PaKzDuUhQ&oe=69B6B1A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailerprev.png", "id": "978077019671638", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982441_978077023004971_2328662040582874456_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=avvJYs-3XJYQ7kNvwEtFC_7&_nc_oc=AdlCJIG0PI1eX9hr1EqzvWZzwU0r_WmOfmBumIbxMjS7G0PcvYfkKcy_ViEyhRna1Y0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz3hJZ5es4udZxILSagCzjL2QxkzsAga9dquFLVHWPfaQ&oe=69B6B036"}, "display_name": "DrumBeats VR", "keywords": [], "long_description": "DrumBeatsVR is a VR drumming music game. You can drum to songs to unleash your inner drummer! In DrumBeatsVR you can practice on different drum kits, including Metallica and The Rolling Stones and you can play in three different environments (more to be added later). \n\nEpic Scenes:\nDrum studio\nAntarctica\nOcean Floor\n\nDrum kits:\nBasic Rock Kit\nMetallica (sound and setup)\nThe Rolling Stones (sound and setup)\n\nFree play\nPlay on the drum kits and environments listed above however you like\n\nArcade\nPlay along with our custom made songs", "short_description": "DrumBeatsVR is a VR drumming music game. You can drum to songs to unleash your inner drummer! In DrumBeatsVR you can practice on d
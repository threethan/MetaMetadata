71cc-BA&oe=6B0C5A80"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Galateum_CoverLandscape.png", "id": "684438640283334", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974677_684438646950000_5562717609088558112_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UPxGMJNwRc8Q7kNvwE_pl5h&_nc_oc=AdqMlzKZpaJKaCadiM6IH3Fm38-27Bode3UAUm7ccuOAq-KiPbFjHvMQJkw9S6yVm5w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQq6fR-6W0PeTZXzYu2axeuoJo0qSuAtQba0aH6MLhILg&oe=6B0C5AB3"}, "display_name": "Galateum", "keywords": [], "long_description": "Immerse yourself in our unique FPS experience, combining cyberpunk aesthetics with the merciless conditions of a desert planet. Navigate neon-lit buildings and desolate vistas, outmoving and outplaying your opponents.\nCombat isn't just about force - it's about strategy and adaptation. Leverage the jet-pack to traverse the environment, using the map's entire verticality, while engaging in intense gun fights.\nYour cyberpunk survival odyssey starts here.\n\n", "short_description": "Dive into a unique FPS experience on a harsh desert planet. Challenge yourself and other players in exciting 3v3 team deathmatches.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bananasxr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Bananas XR GmbH", "support_website_url": null, "website_url": "http://www.bananasxr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app
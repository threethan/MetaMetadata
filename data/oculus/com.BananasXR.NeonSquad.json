oaMz1s1kvXSQbhihNqRMocptYwwhKpZMq6g-SIx3BDQ&oe=6A2D643A"}, {"file_name": "Screenshot 4_2560_1440.png", "id": "920856615987670", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75289916_920856619321003_1167628786352568211_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5lUI0Z4hw8kQ7kNvwGIVug3&_nc_oc=AdrALPiH3y_dwBuu2eSgwNXh8TIzuLDICrG8QpDKtVeU8YPHZW1hLkB7YurLLCwYCfk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-5EQlpHq8plXnfcz_NFcn9dz1J8bj5ZUNmrpoVMtnjIQ&oe=6A2D5798"}, {"file_name": "Screenshot 5_2560_1440.png", "id": "727856879468758", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974812_727856882802091_1641997799950234504_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tK5bMn41ZdgQ7kNvwE4mXdz&_nc_oc=AdoCMokDFJrk6YboIXXgJWmTnqb_X0S1imjJFELUOf8Lt5eo41cJy_R0bEzZSwc2ViM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_GUWqYFQC4gtoDdws57vY9xD9sSlEWUtAXdsm-aCyJtQ&oe=6A2D54C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Galateum_CoverLandscape.png", "id": "684438640283334", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974677_684438646950000_5562717609088558112_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DiSlGCoisroQ7kNvwE1l5Lg&_nc_oc=AdrkXMQqNTViZ7nSdxTiZ0j34yCLhuNNTVFJIHMQnIsqrB5043xpNOiOE2M68oG0id4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8AUKLTug6BBSCxpbBDz8kFFTSkq2ev4PnQ9sQpG3G9oQ&oe=6A2D54F3"}, "display_name": "Galateum", "keywords": [], "long_description": "Immerse yourself in our unique FPS experience, combining cyberpunk aesthetics with the merciless conditions of a desert planet. Navigate neon-lit buildings and desolate vistas, outmoving and outplaying your opponents.\nCombat isn't just about force - it's about strategy and adaptation. Leverage the jet-pack to traverse the environment, using the map's entire verticality, while engaging in intense gun fights.\nYour cyberpunk survival odyssey starts here.\n\n", "sho
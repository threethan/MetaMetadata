0V_czlB_0oiqMYDKqbyLWRTFkJ76fhhXtT8oG7QDm4A&oe=6AC500BA"}, {"file_name": "Screenshot 4_2560_1440.png", "id": "920856615987670", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75289916_920856619321003_1167628786352568211_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7wkLlAK_pkUQ7kNvwHIZVEi&_nc_oc=AdrZNKM9pxdnoR-brRgVnFSpmqVWvrT-7uenKWhm1pPM_YSlrHvgHJTnTC5UdQ3Qq1A&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNb-RZVON0b-MoAmhgRPtEcHYOcfw6RhMhzdYKSrgDUFQ&oe=6AC4F418"}, {"file_name": "Screenshot 5_2560_1440.png", "id": "727856879468758", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974812_727856882802091_1641997799950234504_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JW_SBv4STqQQ7kNvwFOTCYx&_nc_oc=AdpmzmzzSKOmBnaca-1y9pxbnKIbOYpwljn_t5kgq1nWnBKrpi7TYTD3GdCPL4K2_ls&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNPBJ3RIhWXpcbwP6-7_xWCGBUv_EzbTV3TuzOc3mFlrw&oe=6AC52980"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Galateum_CoverLandscape.png", "id": "684438640283334", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974677_684438646950000_5562717609088558112_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LRVu4HBa_AAQ7kNvwEGWlZ8&_nc_oc=Adr83F2EDOk6ynJKXsw5YRnU8bZNuq-X3DQYX-xVmKpEK_yypv5ZVdWNbPq3WdqS8NQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPUvY13qOQ0mpHZLCHG6kT1P-eZbBhV3d6Mp9-UdjY4_g&oe=6AC529B3"}, "display_name": "Galateum", "keywords": [], "long_description": "Immerse yourself in our unique FPS experience, combining cyberpunk aesthetics with the merciless conditions of a desert planet. Navigate neon-lit buildings and desolate vistas, outmoving and outplaying your opponents.\nCombat isn't just about force - it's about strategy and adaptation. Leverage the jet-pack to traverse the environment, using the map's entire verticality, while engaging in intense gun fights.\nYour cyberpunk survival odyssey starts here.\n\n", "sho
_TL1fcTulqX4Zpm-2si1a4EoMN9UgAq89i8f1Q2RZig&oe=6AF0823A"}, {"file_name": "Screenshot 4_2560_1440.png", "id": "920856615987670", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75289916_920856619321003_1167628786352568211_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uxKg1dv0Pq8Q7kNvwGahsOW&_nc_oc=AdrEulaOwZ76GHpmnRPZqEHPiIwqKGnD8eByMbAJI1x-n_xAxbxEUqnvcKlgjmHoBEc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIh5wpRPH4T5XGJGOY-5Y44p7ByVhmGs-t09NwYzNZzg&oe=6AF0ADD8"}, {"file_name": "Screenshot 5_2560_1440.png", "id": "727856879468758", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974812_727856882802091_1641997799950234504_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YKnzao6SCAEQ7kNvwFhzYwm&_nc_oc=AdpRgI97wwrBUB64oTj1Szlkie6Z4wGsmiNpy5Sj2y8-eGWzeIBIGMkmVxm5-9F5l3g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRhJ0dTdh5ONVqN4OJjM7vVspPNvDNAXaCEhv-yguUFg&oe=6AF0AB00"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Galateum_CoverLandscape.png", "id": "684438640283334", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974677_684438646950000_5562717609088558112_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XvaqVzzEK6QQ7kNvwFNF5Ek&_nc_oc=Adr0o6rX5o-a-Od6NpWfPeVOKXH5xwE2bIanuq2PFy6LYTovFxjnhwggwOTL0X0V6uc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQp6GG0x56w6KTyqgfvHg2Mpy5akr84qjB-trHLiiWsIA&oe=6AF0AB33"}, "display_name": "Galateum", "keywords": [], "long_description": "Immerse yourself in our unique FPS experience, combining cyberpunk aesthetics with the merciless conditions of a desert planet. Navigate neon-lit buildings and desolate vistas, outmoving and outplaying your opponents.\nCombat isn't just about force - it's about strategy and adaptation. Leverage the jet-pack to traverse the environment, using the map's entire verticality, while engaging in intense gun fights.\nYour cyberpunk survival odyssey starts here.\n\n", "sho
nc_ohc=e0eb7M-5YnEQ7kNvwHAGG_z&_nc_oc=AdoTGoY0BlWTfQpCDe55Oz0UsBME0otKg7q2iWESSvtX3MafdAzy3JwNbYLOl70gUyQ&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXCTDdeCzWUa7M4Szpww52F0MT6tzSKEgslkKWJNnIEA&oe=6A7DC073"}, "display_name": "Galateum", "keywords": [], "long_description": "Immerse yourself in our unique FPS experience, combining cyberpunk aesthetics with the merciless conditions of a desert planet. Navigate neon-lit buildings and desolate vistas, outmoving and outplaying your opponents.\nCombat isn't just about force - it's about strategy and adaptation. Leverage the jet-pack to traverse the environment, using the map's entire verticality, while engaging in intense gun fights.\nYour cyberpunk survival odyssey starts here.\n\n", "short_description": "Dive into a unique FPS experience on a harsh desert planet. Challenge yourself and other players in exciting 3v3 team deathmatches.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bananasxr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Bananas XR GmbH", "support_website_url": null, "website_url": "http://www.bananasxr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7355813357815677"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-2.oculuscdn.co
Kqm_HPd4sQ7kNvwHIlTvu&_nc_oc=Adqy-olGrJbTx2QmjNmYnNNtiriNhk4g0RKC8aHv-MWuUYGLCppZaCq7HLCPGkdvRP8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJsFiCdoGr4PooF9OkNRpeeVS7bLx_76rG_C2KIAnNGLA&oe=6AA2C139"}, {"file_name": "New Project (11).png", "id": "2297321664070962", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499311537_2297321667404295_2977565712547492284_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LnmnGUi_1JgQ7kNvwGu4Zpb&_nc_oc=Adq8hrZ9vjM6B7-uOXDpMZvdskXbg1Gjh6VqLJ3KmxvNE36wCW4lHj3ctrztGwHhWPU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILY6rEMCa8onZGn0WLw5NM2agSvQPwcupD2vXdzsIh4w&oe=6AA2B7A0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nightmare's Edge", "keywords": [], "long_description": "Nightmare\u2019s Edge is a virtual reality horror experience designed to immerse players in a world where fear is constant and safety is never guaranteed. From the moment you enter, the environment feels wrong. The air is heavy, the silence feels alive, and every sound makes you question whether you are truly alone. This is not a game that relies on cheap scares alone\u2014it is built on tension, atmosphere, and the feeling that something terrible is always just out of sight.\n\nIn Nightmare\u2019s Edge, movement is freedom, but also danger. As you explore the dark and unsettling environments, every step forward brings you closer to answers you may not want to find. Long corridors stretch into darkness, rooms feel abandoned yet watched, and familiar paths quickly become confusing. The world reacts to you, and the deeper you go, the more the nightmare seems to notice your presence.\n\nThe environments in Nightmare\u2019s Edge are crafted to make you feel small and vulnerable. Dim lighting, flickering shadows, and narrow spaces combine to create an overwhelming sense of unease. Sometimes the scariest moments come from what you cannot see. A distant sound, a sudden silence, or the feeling that something just moved behind you is enough to make your heart race. The game focuses on psychological fear, letting your imagination do most of the work.", "short_description": "Nightmare\u2019s Edge is a VR horror experience where every step forward pulls you deeper into the unknown. Explore dark, eerie environments filled with unsettling sounds and sudden moments of fear. Something is always watching, even when nothing seems there. How far will you go before the nightmare reaches you?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vR537ELPDoGMe73ldFSdqBPPhdI_BmPLX7EKrxcpKDWboSFYtlWXm3O2XwzFDTWpLvf_IxIohxWvVul/pub", "developer_terms_of_service_url": null, "publisher_name": "VR Motion Studios ", "support_website_url": null, "website_url": "https://docs.google.com/document/d/e/2PACX-1vR537ELPDoGMe73ldFSdqBPPhdI_BmPLX7EKrxcpKDWboSFYtlWXm3O2XwzFDTWpLvf_IxIohxWvVul/pub", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26034373389538011"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308010_2164826041025569_6405361559591775808_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fFDWZh6mVv8Q7kNvwGPSJie&_nc_oc=AdpcF1ysPJI02voC7BJl8OyYoJsPK0NetLfj0hkiDXKGo8_GV4V1dgpHDPSZLNUXDgo&_nc_zt=3&_nc_ht=scontent-iad3-2.
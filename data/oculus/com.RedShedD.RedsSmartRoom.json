d=6e7a0a&_nc_ohc=DRVmcv7MmW4Q7kNvwFHszJK&_nc_oc=AdqHrQUuvd0u3ymNzqhxHfbiv9jStDaHR_uyLYVOwo876O2Keqm0Ty3vnNU3NwO-k9k&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwy0zuz484urjMVTQTx_CP12y9R_yeeJH48uy2GzgKvfg&oe=69C13722"}, "display_name": "Red's Smart Room", "keywords": ["Dodge", "Sport", "Movement", "AI", "Room"], "long_description": "# You vs AI\n\nA rogue artificial intelligence has seized control of your room and identified you as a threat to be eliminated. \n\n**Your objective:** survive.\n\nThe AI deploys an escalating arsenal of hazards: lasers, autonomous cleaning robots, turrets, mines, explosive devices, surveillance systems, and more. The environment grows increasingly hostile as each new threat remains active.\n\nThis mixed reality experience integrates your physical surroundings into the gameplay. Survival requires genuine physical movement: ducking, jumping, climbing, and using real-world objects as improvised shields. The AI monitors your behavior patterns and adjusts its tactics to prevent stationary play.\n\nThroughout your struggle, the AI narrator accompanies you with mocking remarks and commentary on your performance.", "short_description": "An evil artificial intelligence takes over your room and tries to kill you. Dodge lasers, cleaning robots, and deadly tech to survive as long as possible."}]}, "developer_name": null, "developer_privacy_policy_url": "https://redssmartroom.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "RedShedDevelopment", "support_website_url": null, "website_url": "https://redssmartroom.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOV
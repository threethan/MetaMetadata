.png", "id": "1082761178082042", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825345_1082761181415375_4263051055003716631_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DmQ1PkJJEAkQ7kNvwGc3Usd&_nc_oc=Adrdv6NgmPOvzLY6Kz9x3GCm0lRY7LDLKfyTvTmohEeS6H39HMmkhgr9i8laKZsizrM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1iC4CuUxbQ6Ee9ntSrimJsWI9pCmRRvVLuoJhhzDZxw&oe=6AF35201"}]}, "id": "1406457075035858", "locale": "en_US", "screenshots": [{"file_name": "screen1.png", "id": "1607096660824504", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823259_1607096664157837_4506581207596689569_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0slE91cb-nsQ7kNvwFUOUPg&_nc_oc=AdprxoYXM4TQHcjsDyfs23fyI-sfTnclFFnFt4JCcdr-1_SJhEHWVboHuafpZEZU3e4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5Pa3b2SMwt4ScWVy9lt5vOXqbwJQyQU4dzB-tmWmyfg&oe=6AF34F37"}, {"file_name": "screen3.png", "id": "961201173706975", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827626_961201177040308_2862817787632553642_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0viZCyKmGYMQ7kNvwHSCL7-&_nc_oc=AdoAMCLexZl_IkjYja2GQg0ozZeFj6LIxidYiVrJxmMnU6aENIporXJhE2iDDnr8eos&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQAUikPLb00D8oQX68mA7d8HieV1vLE4j9nOQvPYhHAA&oe=6AF3361B"}, {"file_name": "screen4.png", "id": "2526374621189483", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823259_2526374624522816_5111169036707195682_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HpVObpGS5RwQ7kNvwHiJJU9&_nc_oc=AdpmKKA1kA6GmYF1Q8FzqK4NJDjRfLyzk5fLUUv_r8GBSHdt0wg-weVjEZaI_-1lcUw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSgINgjuU1DKP4yMtelMc5Z3QRnT2DeIDJfDyPtQQmgA&oe=6AF335B8"}, {"file_name": "screen2.png", "id": "945158541980294", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823940_945158545313627_5027864682832627822_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FuUTNPaPRKoQ7kNvwFlrlc_&_nc_oc=AdrgnIU2nLHFUuinRUu6g4B3zKkEE9ZKMDtbj8I1rZ918TsV75xbryuhpnqMi2vNR6c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTm7dso7wGFxLCG4BTxCIHS4e2G9cZf1GbtGtoPhlKbHw&oe=6AF32C1A"}, {"file_name": "screen5.png", "id": "3257035524490161", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823812_3257035527823494_580201830256346344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Wukq8y53L8Q7kNvwFM-SOl&_nc_oc=AdpVsu46_uZOTVgI9ioyrnNOvqAC6sPuqUFB1OfHMPE5Gy_mvEhFMwhPkPkCVcEzyfg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSibJUTrfJncUv3pIuh9yeQO8ffL-7yUPd2UrBsUeQwjQ&oe=6AF3478C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover.png", "id": "1622017082789688", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825415_1622017086123021_2012198275058661385_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dYQmE_pZYBQQ7kNvwHNVoLr&_nc_oc=AdrmhAiD7g5SQt7YLDIAiCtJaE-cE86SfCgdPMr0mgjaUq9XzIlwIpMVRxCSEo4ppEc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVJoIBkBJPdt9nk83RO8gnlRU_1RPuuJ_ewa1iPJZFeg&oe=6AF32F16"}, "display_name": "DeepWork Virtual Desktop", "keywords": [], "long_description": "A place to settle in and focus.\n\nDeepWork Virtual Desktop surrounds your seated workspace with detailed panoramic scenery, from a forest loft and an alpine lounge to a Bali villa, a coastal terrace, a cliff house and a city penthouse at night.\n\nMake it your space:\n\u2022 Choose six scenic environments or a simple black background.\n\u2022 Customize your 3D desk with seven finishes, including black, white, wood styles and frosted glass.\n\u2022 Adjust the viewing direction from the control panel.\n\u2022 Keep a supported physical keyboard visible through a passthrough cutout.\n\nUse compatible Meta system windows alongside your workspace. Browser and computer-display features are provided separately by Meta and depend on your headset software and setup; DeepWork Virtual Desktop does not include its own desktop streaming service.\n\nDesigned for seated use. The surroundings are static panoramic images: you can look around, but they are not walkable 3D rooms. Scenery does not include animated water or clouds.\n\nNo DeepWork account is required.", "short_description": "Make room for focus. Settle into six scenic panoramic environments, personalize your virtual desk, and keep your physical keyboard in view with supported keyboard passthrough. DeepWork Virtual Desktop gives your seated Quest workspace a change of scenery."}]}, "developer_name": null, "developer_privacy_policy_url": "https://aicat.pl/deepwork-space/privacy/", "developer_terms_of_service_url": null, "publisher_name": "JFK Design", "support_website_url": "https://aicat.pl/deepwork-space/#support", "website_url": "https://aicat.pl/deepwork-space/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1401211936406792"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823259_1578839780122281_5001975441127943173_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OxfQ7ur5PRQQ7kNvwFH0xTv&_nc_oc=AdreTN4T6mWsQ07TiSnrgs9BHbacl8aC-30kTO2HnqeKHHb6pqrT_aD5TE2c5AwYgYc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7XVPgoSQW-UmBaqYrJ1
ation that offers access to one of the most significant collections of contemporary Chinese art in a new, interactive format. Immerse yourself in 3D galleries, explore the works of outstanding artists, and take part in curated tours and virtual meetings.\n\nCreated at the intersection of technology and culture, DSLrooms reimagines the traditional museum model \u2014 offering not just viewing, but a living interaction with art."}]}, "developer_name": "DSLCollection", "developer_privacy_policy_url": "https://dslcollection.net/privacy", "developer_terms_of_service_url": null, "publisher_name": "DSLCollection", "support_website_url": null, "website_url": "https://dslcollection.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "9647150725380122"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2210379289422078"}]}, "baseline_offer": {"id": "2210379289422078"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1746569460, "status": "PUBLISHED", "id": "2210379289422078"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28928654460136460", "version": "1.51"}, "id": "1771513760378654", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes
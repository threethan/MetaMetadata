, "keywords": ["collection", "art", "gallery", "museum", "exhibition"], "long_description": "DSLrooms is the mobile application that offers access to one of the most significant collections of contemporary Chinese art in a new, interactive format.\nImmerse yourself in 3D galleries, explore the works of outstanding artists, and take part in curated tours and virtual meetings.\n\nCreated at the intersection of technology and culture, DSLrooms reimagines the traditional museum model \u2014 offering not just viewing, but a living interaction with art.", "short_description": "DSLrooms is the mobile application that offers access to one of the most significant collections of contemporary Chinese art in a new, interactive format. Immerse yourself in 3D galleries, explore the works of outstanding artists, and take part in curated tours and virtual meetings.\n\nCreated at the intersection of technology and culture, DSLrooms reimagines the traditional museum model \u2014 offering not just viewing, but a living interaction with art."}]}, "developer_name": "DSLCollection", "developer_privacy_policy_url": "https://dslcollection.net/privacy", "developer_terms_of_service_url": null, "publisher_name": "DSLCollection", "support_website_url": null, "website_url": "https://dslcollection.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER",
&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wv4ApobXLeYQ7kNvwG6KHe2&_nc_oc=AdrhJi4G0y858SeGoWc2lNBldS39kOORnx1pTrvpf4WT7o2c83j9HT33w-f_72FJkXA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWnyRjroEZ3JdxGI03kb4Y5ZOAraqbDI2tp77mzweGjHw&oe=6B0F20F2"}, {"file_name": "download-resizehood.com (6).png", "id": "955553429888448", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499299352_955553433221781_3986526267403509635_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WX7VLDBgKzwQ7kNvwHEJkHW&_nc_oc=Adrw-moM_AEDRkhpGA6GqkEetAcKQMm9uFLa18iflHdiufkVbjfjMUOSL26YWBow6ks&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW5aRbTUMBAlJEM4toNjCZ5hVV1OqwZHAQAdIN_diuQgg&oe=6B0F003F"}, {"file_name": "download-resizehood.com (6).png", "id": "1353153002445424", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499293856_1353153005778757_6855508589563155026_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sk_zfMXaQVUQ7kNvwFMCL2r&_nc_oc=AdrV98Xj8k_2-0Ax-zPbzNaZqDqsiQXG9gP3iWuAXgnZUix9GiMUdOQX2dLhbw0JUz8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWBaOk8rrMIS_v-_zHE1ajnK1Xg9AVgfmaDQ5QA_pXHwg&oe=6B0F1061"}, {"file_name": "download-resizehood.com (6).png", "id": "1220890279743778", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620516_1220890283077111_6263462003075522564_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RGdCVn2IphMQ7kNvwECUIiF&_nc_oc=AdrT0o7-LFGolXyIhFXthM4riQA8C0u3XjkHozLCu_D-n1emhIG4rQyPfkW4-CuM0vg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWddjG4U8A_HYtPjCXjNZ-kMr4gqOrTu6emKuSH4pq3Cw&oe=6B0F0668"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Archer Target VR", "keywords": ["Archer", "bow", "shoot", "target", "arrow"], "long_description": "Archer Target VR is a straightforward and engaging VR game where you use bows & arrows or guns to hit different types of targets. The game features:\n\nIdle Targets: These stationary targets are perfect for practicing your aim.\n\nHovering Targets: Moving targets that add an extra challenge as they float around you.\n\nTeleporting Targets: These targets appear and disappear, staying idle for five seconds before moving to a new location. You'll need quick reflexes and a bit of luck to hit them before they vanish.\n\n As a challenge, your goal is to destroy all targets before any of the targets respawn, but do not worry there is no winning or losing. The game is designed to be straightforward and simple. No matter your skill level, Archer Target VR provides an accessible and fun experience for everyone. Get ready to aim, shoot, and improve your archery skills in a dynamic virtual environment. \ud83c\udff9", "short_description": "in this game you'll use bows & arrows, or guns to hit various targets. The game includes idle (unmoving) targets, hovering targets, and teleporting targets that appear and disappear. Players must quickly aim and shoot the teleporting targets within five seconds before they vanish again. Test your precision and reflexes in this dynamic VR archery game! \ud83c\udfaf\ud83c\udff9"}]}, "developer_name": null, "developer_privacy_policy_url": "https://aeon2418.github.io/", "developer_terms_of_service_url": null, "publisher_name": "Aeon2418", "support_website_url": null, "website_url": "https://aeon2418.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTIN
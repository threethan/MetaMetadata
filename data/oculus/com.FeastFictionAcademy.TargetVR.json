&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9YYoLsfeb4UQ7kNvwEFsiPp&_nc_oc=AdqbrL1hWGgDmvUPzwJO7QeoT6APXsNa-2FQCRfnQhdVAXekPjnx9tlNZ2ZBruYFY-o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKn7ylWASpkn7Vd8YQDJ7k7rBYb2mS4QH0-xkNXBkqaA&oe=6B045CB2"}, {"file_name": "download-resizehood.com (6).png", "id": "955553429888448", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499299352_955553433221781_3986526267403509635_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dS0uvBVvG5MQ7kNvwFyQq8h&_nc_oc=Adpl55X059RajAUCuNexmdBj7XgmDBypCp1QiXCcr-BKyijiNYLHDh0XeacIbZRM8t8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfpuUSx7699kbi__nnBdpV2QSPqUgfX9ZiAlRe5v-QEg&oe=6B04743F"}, {"file_name": "download-resizehood.com (6).png", "id": "1353153002445424", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499293856_1353153005778757_6855508589563155026_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=42KVx7WqwRoQ7kNvwEDJ9Xq&_nc_oc=AdoIYswpzCRx9f1j3ivFeYuJjGuVjLMn3N3fmkDUGgwjb3kX8xKFYGJfZInPUPSCaPY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRifRee9FG66767A1sQiRC82phAaxJhMjoa4XxoX0lfSw&oe=6B048461"}, {"file_name": "download-resizehood.com (6).png", "id": "1220890279743778", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620516_1220890283077111_6263462003075522564_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hHC6kzQD-pAQ7kNvwHWNjI_&_nc_oc=AdqY2cXmPC0ImVpRtVqu_c_4MZHPXQKb5UL8Og-3Nl_5krIeSih9G6n7uRNiTX4ToaQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRa5acpNKq5OFcm1fk1t4gIpOo9rUGGFlsOo5kgPknIhw&oe=6B047A68"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Archer Target VR", "keywords": ["Archer", "bow", "shoot", "target", "arrow"], "long_description": "Archer Target VR is a straightforward and engaging VR game where you use bows & arrows or guns to hit different types of targets. The game features:\n\nIdle Targets: These stationary targets are perfect for practicing your aim.\n\nHovering Targets: Moving targets that add an extra challenge as they float around you.\n\nTeleporting Targets: These targets appear and disappear, staying idle for five seconds before moving to a new location. You'll need quick reflexes and a bit of luck to hit them before they vanish.\n\n As a challenge, your goal is to destroy all targets before any of the targets respawn, but do not worry there is no winning or losing. The game is designed to be straightforward and simple. No matter your skill level, Archer Target VR provides an accessible and fun experience for everyone. Get ready to aim, shoot, and improve your archery skills in a dynamic virtual environment. \ud83c\udff9", "short_description": "in this game you'll use bows & arrows, or guns to hit various targets. The game includes idle (unmoving) targets, hovering targets, and teleporting targets that appear and disappear. Players must quickly aim and shoot the teleporting targets within five seconds before they vanish again. Test your precision and reflexes in this dynamic VR archery game! \ud83c\udfaf\ud83c\udff9"}]}, "developer_name": null, "developer_privacy_policy_url": "https://aeon2418.github.io/", "developer_terms_of_service_url": null, "publisher_name": "Aeon2418", "support_website_url": null, "website_url": "https://aeon2418.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTIN
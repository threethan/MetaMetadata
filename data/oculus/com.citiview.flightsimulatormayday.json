ntent-iad3-1.oculuscdn.com/v/t64.5771-25/491821796_1412056743646271_3101824196909199092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YqfvSMDdD_UQ7kNvwFAo5Nn&_nc_oc=AdrFJ6aat8r2W6UeMgO-tsSGfWA-7NKqWicacGPamPaOXKhUSk-4qO_Pmq2ClkoV5D4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSy8xIaXlElFSTj1xGNhNr1h68ILtgI0c3sqWGm231RAQ&oe=6AF1FAE2"}, {"file_name": "screenshot_1.png", "id": "4593753070901228", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825257_4593753074234561_3520388831446356377_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xioSUzcZA9cQ7kNvwFYezHb&_nc_oc=AdpCEov5Le8kRGSbQPk34tuXrHeWmY4PFvphduAqLqztxmq-aQ2ejz_gt0TYCXjw4_0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAgthVbvB4Nq7L6v7yHMxGRG8KTNpeq-esK_WbOLr9Bg&oe=6AF1FF9A"}, {"file_name": "screenshot_5.png", "id": "3027102820970197", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827646_3027102830970196_6007355566865862337_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nuGOsZPZGZoQ7kNvwHUeHHZ&_nc_oc=Adqk8lTemwhtiQv55eJ0SKM_b1F4Se6RG56DHyYOgYShbqwsRYmBH0v5OGyfPqqU5zU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvCizZuJJgPCg1FbQBvcyH-ygPm-Q0MXMPzyxvRpSScg&oe=6AF1F869"}, {"file_name": "screenshot_4.png", "id": "1526586979503188", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824318_1526586982836521_9026023188420780684_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zkjtyfvp2YsQ7kNvwF9qsYN&_nc_oc=Adr04f414ps1usDnDz_utdMBiOLwGjllVTUv2rPD8pOE8HhyyKToXdgXXBcT6yCi-bA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBEEwkoq_G3WWQAdQx3qfLEbY-XKjjFbxA9pWjmo6rmQ&oe=6AF1F546"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "4131978420435938", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827585_4131978423769271_4453029100857687301_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TKSp2qKbqnEQ7kNvwEPmphF&_nc_oc=AdoH5uVK8eE7HoLv_xnmtlRk01awu_Q2t0AyY_Q7VGHU_UeRRM8lOfOFbIVUqEHksAM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-Y-QzL-QE39mw_sreCH_iweL3FpQaseVc-7uwilRBQQ&oe=6AF1EF2D"}, "display_name": "Flight Simulator Mayday", "keywords": ["flight", "simulator", "airplane", "helicopter", "pilot"], "long_description": "Flight Simulator Mayday puts you in the left seat when things go wrong.\n\n14 EMERGENCIES\nTotal power loss on final. An engine fire on the climb-out. A ditching at sea. A night blackout. A jammed landing gear and a belly landing. A hydraulic failure, a decompression at 35,000 ft, a storm landing in a crosswind. An autorotation in the helicopter. A flameout and a dead-stick landing in the fighter. Each one is scored, with a checklist card in the cockpit and a red handle to pull.\n\nA REAL GLASS COCKPIT\nA business jet with live flight displays, a moving map, an autopilot and a cabin you can walk through. When the power fails the screens really go dark, and the standby battery brings one back.\n\nWEATHER\nClear, overcast or storm: rain past the windows, distant lightning and a real crosswind that makes you crab onto the runway.\n\nFIRE CREWS\nDeclare a mayday and the airport fire trucks roll, chase you down the runway and pull up beside you.\n\nYOUR OWN HANGAR\nThree aircraft in your hangar. Paint them your way and power wash them clean, then choose one and fly.\n\nFREE FLIGHT AND MISSIONS\nFly the island with no failures at all, or switch on surprise failures and see what breaks. Landing challenges, ring courses, fighter missions and landmarks to discover.\n\nFLY TOGETHER ONLINE\nQuick Match or a private sky with a 4-digit code. Voice chat stays off until you turn it on.", "short_description": "Fly a private jet, a helicopter and a fighter - then something breaks. Both engines quit on final, the screens go dark, the landing gear jams, a storm closes in. Run the checklist, fly the aircraft and walk away. 14 emergencies, your own hangar, solo or online."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/flightsimulatormayday/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/flightsimulatormayday/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1264301456775827"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2296075511184795"}]}, "baseline_offer": {"id": "2296075511184795"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790872920, "status": "PUBLISHED", "id": "2296075511184795"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1292188763987096", "version": "1.0.1"}, "id": "3614661058686817", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1264301450109161", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1292188763987096"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3614661058686817"}]}, "change_log": "v1.0.1 - st
324", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499297181_820955237392657_4232155750967818709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b1PDMO9eCw4Q7kNvwHrok8D&_nc_oc=AdmZKaeME4v1cQV89Jvq9cfBPnCJsZeG_3y8S0p2iS52IRxVbRXktrtVbIjebLf2Fuc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxS85ApAzDP1s6ozy60JeWdg5dhGTC_svBMMk2u0NLYkw&oe=69AEAC36"}, {"file_name": "Main_1440p_11.08.2025_09-41-05 AM.png", "id": "2225766747897947", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491830812_2225766751231280_9047626277015030981_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pDY6fjCatPwQ7kNvwFQLWt2&_nc_oc=Adl4cOSaAiJusePz9ZVf94PunvVbBmXlXXNWbRXHAnDjgrfCvTbhUrvp8OMQo_R9Avw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzQZ-Q39l4fkH-2IVSMSKMOz3ACFOLyna7TcIJCvI3Wag&oe=69AEBF58"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Isles of Apes (DISCONTINUED)", "keywords": ["gorilla", "monkey", "ape", "tag"], "long_description": "Get ready to dive into an exciting new virtual reality experience with this fresh VR game that takes full advantage of the innovative Gorilla Tag locomotion system. Designed for players who love both adventure and physical engagement, this game lets you explore a variety of stunning, dynamic islands, each offering a unique and thrilling game mode. Whether you\u2019re leaping across platforms, tagging opponents, or working together to complete challenges, each island offers a new environment and gameplay style, ensuring that no two experiences are the same. Whether you\u2019re a competitive player, a cooperative gamer, or just looking for a fun, active way to spend time in VR, this game has something for everyone. The immersive nature of the Gorilla Tag locomotion keeps you moving and engaged, making each session feel fresh, fast-paced, and exciting. No matter where you go in the game, a new adventure awaits!", "short_description": "An fresh new VR game that uses the Gorilla Tag locomotion. Each island has a different game mode to provide a new experience no matter where you go!"}]}, "developer_name": "soggy hotdog", "developer_privacy_policy_url": "https://www.termsfeed.com/live/d9df8aec-3e25-4e9c-9cc6-91f9ece1ea22", "developer_terms_of_service_url": null, "publisher_name": "soggy hotdog", "support_website_url": null, "website_url": "https://sites.google.com/view/isles-of-apes/page", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "25799023436417202"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499312306_831482033105508_1502507753265041497_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dgpQZzvK3B4Q7kNvwF73m7n&_nc_oc=Adl7T2NVcPi4AhGXOOCO8w9snulYaYCKZxGDPmyA9farmnfpj7Hzhc1WL3eqIixk7_g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxJgnagsvipuDhC9Z93KmO9NZEtkYlRxHZGL6mdcHk9hw&oe=69AEA41C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Isles of Apes (DISCONTINUED)", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Plat
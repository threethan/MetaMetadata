dn.com&_nc_ss=7f20f&oh=00_Af6OdVYghcV9BBbafQpV7Mo9tI2N0pLiko8u4D7Z1JeUsw&oe=69FCA068"}, {"file_name": "Main_1440p_11.08.2025_09-38-26 AM.png", "id": "820955234059324", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499297181_820955237392657_4232155750967818709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BwnM_yK2aswQ7kNvwEgWCGs&_nc_oc=Adq8St-58zwSVK9oj5ptNoUZxmqTSZCcr3IEpuRikJFFAP_NimZQRB3JB4kBWqqxUPI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4j2s9BThwNftk_nD5nTMBaYUxluqhj-nVYBZf62Mtmtw&oe=69FCACF6"}, {"file_name": "Main_1440p_11.08.2025_09-41-05 AM.png", "id": "2225766747897947", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830812_2225766751231280_9047626277015030981_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K63iTUySFCMQ7kNvwEiEAqb&_nc_oc=Adq0SDPHfYRtHMJEPv5f_Xw06XR4PR_cSIHpiX84rk-uGUWKAlJzlKwVRtlfPsRTUvE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5UlgNbZKFohgyGd-uE2ZbNc7ei1KwGG7pJKjdPh50JbA&oe=69FC87D8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Isles of Apes (DISCONTINUED)", "keywords": ["gorilla", "monkey", "ape", "tag"], "long_description": "Get ready to dive into an exciting new virtual reality experience with this fresh VR game that takes full advantage of the innovative Gorilla Tag locomotion system. Designed for players who love both adventure and physical engagement, this game lets you explore a variety of stunning, dynamic islands, each offering a unique and thrilling game mode. Whether you\u2019re leaping across platforms, tagging opponents, or working together to complete challenges, each island offers a new environment and gameplay style, ensuring that no two experiences are the same. Whether you\u2019re a competitive player, a cooperative gamer, or just looking for a fun, active way to spend time in VR, this game has something for everyone. The immersive nature of the Gorilla Tag locomotion keeps you moving and engaged, making each session feel fresh, fast-paced, and exciting. No matter where you go in the game, a new adventure awaits!", "short_description": "An fresh new VR game that uses the Gorilla Tag locomotion. Each island has a different game mode to provide a new experience no matter where you go!"}]}, "developer_name": "soggy hotdog", "developer_privacy_policy_url": "https://www.termsfeed.com/live/d9df8aec-3e25-4e9c-9cc6-91f9ece1ea22", "developer_terms_of_service_url": null, "publisher_name": "soggy hotdog", "support_website_url": null, "website_url": "https://sites.google.com/view/isles-of-apes/page", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "25799023436417202"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312306_831482033105508_1502507753265041497_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GtsJXlI8ZBsQ7kNvwEbU4Ux&_nc_oc=Adpa7FdVnQaZaUZRX2X3CJhJbaM58jKMsDDhgtvJBc4oS0Jl53ilHftpu1QAT9nCKXU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4CLCypnf-eB3hP9XzKl2TMgEg4TftNcrNbMSJeGgGLOg&oe=69FCA4DC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Isles of Apes (DISCONTINUED)", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES"
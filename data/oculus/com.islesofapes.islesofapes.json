_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QdMcrHXaykUQ7kNvwETrXar&_nc_oc=AdqXgDA1mjwUttTpkV2-d66K6HMNjIildKeRyxNMIqU1FYE3ahSC1HpGh2ybfShRgTw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGToi5_vxDrnEZJdo7-rDepxep5oywiTpPR3FWcSrGbyw&oe=6A7880E3"}, {"file_name": "Main_1440p_04.05.2026_13-42-07.png", "id": "1713323913182059", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499308318_1713323916515392_6082376125452437775_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=prP0x1pBUNgQ7kNvwHNExMp&_nc_oc=Adr392m59HsLzxX36IjnqLKzSSPwivIxUTOSV65jrIMoju3gzNHChbG4MM21vm1tPp8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEtM83Q4qtcQ94F8A76J9l2zUpI5V3fifipPvvKNN7UCQ&oe=6A787818"}, {"file_name": "Main_1440p_04.05.2026_13-51-55.png", "id": "2428644694305898", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617847_2428644697639231_9080816209000126073_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OsmJoPnz2uUQ7kNvwGbzmNi&_nc_oc=Adpj9sWSDIEH62hT3QwAKiyma0Cadr__awXkr4UE1evBf1ZVDworn4YUhpkydegiOVs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQENP7IJ-pO34vB6GE2NwXSnf6lH-NjSlPK3BHHo2FO9Vw&oe=6A78681F"}, {"file_name": "Main_1440p_04.05.2026_13-45-46.png", "id": "4260640484153727", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618093_4260640487487060_2481590568225594940_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LXVjP7BhoEgQ7kNvwGG0UV1&_nc_oc=Adp6nGnoMO_ytZlO6jaymwl9I-r3gT27kZu-CZuL6IUpag5ZY64Y060Oe56ws-_Qj38&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEKsVTarqogoC45bCCdCFA2AXP09X72Ku2DQ8VSJxopNw&oe=6A7881C5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Isles of Apes", "keywords": ["gorilla", "monkey", "ape", "tag"], "long_description": "Get ready to dive into an exciting new virtual reality experience with this fresh VR game that takes full advantage of the innovative Gorilla Tag locomotion system. Designed for players who love both adventure and physical engagement, this game lets you explore a variety of stunning, dynamic islands, each offering a unique and thrilling game mode. Whether you\u2019re leaping across platforms, tagging opponents, or working together to complete challenges, each island offers a new environment and gameplay style, ensuring that no two experiences are the same. Whether you\u2019re a competitive player, a cooperative gamer, or just looking for a fun, active way to spend time in VR, this game has something for everyone. The immersive nature of the Gorilla Tag locomotion keeps you moving and engaged, making each session feel fresh, fast-paced, and exciting. No matter where you go in the game, a new adventure awaits!", "short_description": "Isles of Apes is a Gorilla Tag fan-game that takes place across multiple islands, each island has a different game mode or experience ensuring the player always has something to do!"}]}, "developer_name": "soggy hotdog", "developer_privacy_policy_url": "https://islesofapes.straw.page/", "developer_terms_of_service_url": null, "publisher_name": "soggy hotdog", "support_website_url": null, "website_url": "https://islesofapes.straw.page/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "26593949303591274"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-
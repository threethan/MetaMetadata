me": "Isles of Apes", "keywords": ["gorilla", "monkey", "ape", "tag"], "long_description": "Get ready to dive into an exciting new virtual reality experience with this fresh VR game that takes full advantage of the innovative Gorilla Tag locomotion system. Designed for players who love both adventure and physical engagement, this game lets you explore a variety of stunning, dynamic islands, each offering a unique and thrilling game mode. Whether you\u2019re leaping across platforms, tagging opponents, or working together to complete challenges, each island offers a new environment and gameplay style, ensuring that no two experiences are the same. Whether you\u2019re a competitive player, a cooperative gamer, or just looking for a fun, active way to spend time in VR, this game has something for everyone. The immersive nature of the Gorilla Tag locomotion keeps you moving and engaged, making each session feel fresh, fast-paced, and exciting. No matter where you go in the game, a new adventure awaits!", "short_description": "Isles of Apes is a Gorilla Tag fan-game that takes place across multiple islands, each island has a different game mode or experience ensuring the player always has something to do!"}]}, "developer_name": "soggy hotdog", "developer_privacy_policy_url": "https://islesofapes.straw.page/", "developer_terms_of_service_url": null, "publisher_name": "soggy hotdog", "support_website_url": null, "website_url": "https://islesofapes.straw.page/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_in
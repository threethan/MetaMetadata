8"}, {"file_name": "Main_1440p_11.08.2025_09-38-26 AM.png", "id": "820955234059324", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499297181_820955237392657_4232155750967818709_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YDrLn8swsD8Q7kNvwErMApF&_nc_oc=AdpG9dNgtcCAAlokZh8bSMl8ixriHq9HHAT52pjSqxoeSUJjGy7a8ijzKJdgIzveIOA&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGEbbIKwd7ydodWW5g-Oca_gYgolm7rIZA4ctovp9KzA&oe=6AFF12F6"}, {"file_name": "Main_1440p_11.08.2025_09-41-05 AM.png", "id": "2225766747897947", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830812_2225766751231280_9047626277015030981_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7NVu9dKf3roQ7kNvwEYitCm&_nc_oc=AdpyHIDKZ332vJ45m8CwfRrdCfLROPEsgKWnDKRLbkd3qEgB5eB1wxRN7Jjyi-4u-Lc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYEDCqjpyW2KrQgf3S_OJkuUPo2JHUEBW9er_Ca6Z11g&oe=6AFF2618"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Isles of Apes", "keywords": ["gorilla", "monkey", "ape", "tag"], "long_description": "Get ready to dive into an exciting new virtual reality experience with this fresh VR game that takes full advantage of the innovative Gorilla Tag locomotion system. Designed for players who love both adventure and physical engagement, this game lets you explore a variety of stunning, dynamic islands, each offering a unique and thrilling game mode. Whether you\u2019re leaping across platforms, tagging opponents, or working together to complete challenges, each island offers a new environment and gameplay style, ensuring that no two experiences are the same. Whether you\u2019re a competitive player, a cooperative gamer, or just looking for a fun, active way to spend time in VR, this game has something for everyone. The immersive nature of the Gorilla Tag locomotion keeps you moving and engaged, making each session feel fresh, fast-paced, and exciting. No matter where you go in the game, a new adventure awaits!", "short_description": "An fresh new VR game that uses the Gorilla Tag locomotion. Each island has a different game mode to provide a new experience no matter where you go!"}]}, "developer_name": "soggy hotdog", "developer_privacy_policy_url": "https://www.termsfeed.com/live/d9df8aec-3e25-4e9c-9cc6-91f9ece1ea22", "developer_terms_of_service_url": null, "publisher_name": "soggy hotdog", "support_website_url": null, "website_url": "https://sites.google.com/view/isles-of-apes/page", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "25121386834180869"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1944688122780333"}]}, "baseline_offer": {"id": "1944688122780333"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1763790300, "status": "PUBLISHED", "id": "1944688122780333"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28503568579295994", "version": "62"}, "id": "1221322793166243", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Ap
903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PujQOfrO29wQ7kNvwFXSjLf&_nc_oc=AdoQgPJ62G24is7fHhyUicdyCTLx1ZLmqbpSax_TorYoXLhFeybDVYwxCUae83TP9SY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPfAF3ir50RpngDiws7t-Eze7VMOE8f1jHMhbHsDhQH7w&oe=6ADF69DB"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B6zmbpwsYsUQ7kNvwHx0_zK&_nc_oc=AdrHFzTBPp2p89gMXB-KBctHpZUC10BNFqevWPORLoDiC_juXt8pzi_B2IVfAD5To-w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZgVMfJuLw7Z3DwIwm_svy6cDCz_Y-v6ylqsK4nlVOuQ&oe=6ADF5438"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ngS28lSaJQ8Q7kNvwE8gqPb&_nc_oc=AdoqW9hrlgSiVvJlT70lhD-i0O-ZNc3pKPbXbOq-Nc1kFi0t0uqRRjJPjr1DRxqmzjs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMWPajTfM6yA10tEFvOMqKSjngZlNJLbzqFksb_xDGMEA&oe=6ADF6232"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OsgvZyuzLq0Q7kNvwGdolga&_nc_oc=AdoJ1IoAFRCRltiyfbZ4TofBwJXqzv4RDyVv6-QgzUJgbIEofTJADgPOSbwTN7dDtRI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNVwYLJSmR5pMKV7S35ksAj_xd3aTuhq3fl69NXReD4ow&oe=6ADF78F3"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J2mwGrQrUhcQ7kNvwE2mYRH&_nc_oc=Adpup_P7khn37BnIt8_v8By9wIhAOTndzeJ342EPTYafj9Lxa0ubpsePuW7rgM9XmqE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO8el_tV72YRjaG4WWBdgVWy8v5FeoqUQIW3sp1ZbR89g&oe=6ADF7437"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
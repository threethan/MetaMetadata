903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sJ5vOQv5r10Q7kNvwEeqgPg&_nc_oc=Adr95U_tuU8SOnbaKeWiL5BYBmbXdB61INfL2O852wAjG6vGCE3s8X-PJcem30uYyxM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZdMgOkCaBIHXG7EnLjHVo9geEeVzb2kGQGYEzYRw1DA&oe=6A9ADBDB"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b5vk99YMGOkQ7kNvwHxuRAN&_nc_oc=AdqlCPWlxP-AdT8nyvpBwEQ_WUcLtMlCZglSPSVUiJkFizFFPLU6uTF3EW8BA_5HS4o&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJAFdT5TRa3RYBgGoFFMm-pAHy67et3m170ZWGj1_Es-w&oe=6A9AC638"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-yVE1uof0sEQ7kNvwHdVFg5&_nc_oc=AdqIKfiHfU6FoeHXpgF0qBEzNzAVgeuv5-FTvI58C7IvqOQZ2_YYbKqfcjo1VSMApzE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIdsIbIy5OCNGTSoy3oS3paK4awiCtCvSyU3FqxVg6hdg&oe=6A9AD432"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f6djy1-d34YQ7kNvwFTW69d&_nc_oc=AdqPpNYC-HI6J-xiahqw3UvU7yKtsTTjJtH-y7BWWO10F8laraMG7UmGdu-m2lq_vfE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdcqutqVTjcCfRO7TtAtLT_joXZzPZJaBJVD_i2n6xAw&oe=6A9AEAF3"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D3BE_5jS558Q7kNvwE26Z29&_nc_oc=Adq9hCuucFsT5ONsVYj78DhVDmd9FDGWaHq5ccCA1POEd0FHqBZPQq5bexL6fZs5gpA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKwSB16BjT6PPvTCFjFwkjbCGOX5QVEB63vSXU-7IlF6g&oe=6A9AE637"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
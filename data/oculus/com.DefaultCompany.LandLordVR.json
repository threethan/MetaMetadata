903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8VNRhumxaAMQ7kNvwH8GTXv&_nc_oc=Adr2F4D_ocViS4ibUmCI0TLEJYNf3fnoWb4vSWAWzrCI8WpLXCnH7rIBJUphnbM6p30&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCbKj14tzDlznLM40yOndbCM8Qn8hGZe3rUiw5UfKljnw&oe=6A5F885B"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=21-pkFPGHcsQ7kNvwFtPHag&_nc_oc=AdpIlhtvVujUsS2UQtkWDcDcle_7EH-g8gzhXZkoAkz8FHgl24TrcmyR1QID5FrWApw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCnZoWqwmcFHP7TqbPfJWDx1KtwC835it_pzWGg3ar1Ig&oe=6A5F72B8"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rrNTvE2edDUQ7kNvwG-J95y&_nc_oc=AdoQRvVf0FaXQa4Lj_yRwn6H3UKtkOSJvbPc_aPBXJLcBfimJXgw3VWcwPjx3Mkhd8g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDGndud_ZnHV2Rl0GYjZk0-s6fLOlYkwydkgCVIbxRjLg&oe=6A5F80B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CaND30CTz3EQ7kNvwHIVcqe&_nc_oc=AdpqplZsZBXug5VPM5psHqT0c7sJ6QT6mujaqK_ErArv4lqIqlA1LWP2-aMItZpSKqA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBH87rRvHS98yWVVGDzzznhGhJyPkifuV-IQ2ABcvSFLQ&oe=6A5F5F33"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BezEN1t6KhcQ7kNvwFB1OFi&_nc_oc=Adr6AIsEiOXzfq5ePedW5Hs1v3jmjJMT4-msGjqV2mOAbNVNWi6O3KeIKJYre6qwsOw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDv5OnI5OCPzUCCa8gfZnkJLG-pzYNPALvkM9VeA3ZDIQ&oe=6A5F5A77"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
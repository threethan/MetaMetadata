903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FG2IejDHCTkQ7kNvwF0PSpT&_nc_oc=AdqeIvtmcRRhnVXPgbXIbIW3kaZafBNivBl1fi2tiz2pANQLhEP6bWGZLbulU2q3u6s&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTo3yBeHcGW7XzRnZtFRA47egN5yadaEoLj5ywQB-eC9w&oe=6AF9C7DB"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Anx3SL5eruAQ7kNvwEBBvt3&_nc_oc=Adpt_Zj40ZezVoid2HFM38uDkiR2DrO8Ob76eglOIxA6Of3xKXDnzQqq3U8Y0ghFKdY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9lRwfOq03GXK0ADg3jIl6AQppBIJGvCUEvh6oqFAEKw&oe=6AF9EA78"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ylyce4wExpUQ7kNvwF3GXZ4&_nc_oc=Adq4Li9VRPcV_9B7XlQj-uV_dcfjEByxixL0lyM-i7A9oqkOVmednPIIuCwJu5YVKZ4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTt0_Pet5cWI8HTqZ1xmk-qwIvu6nzD39MbHMfMEyMqw&oe=6AF9C032"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EOzXpaPblgYQ7kNvwGX8Zoh&_nc_oc=Adq01mHkRFNj9HhRffu6baoff71LpJkJPW88o4mBro6-qw5W6hCj3Vb57u8QVMHUV2s&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTixVU-8yEwMKL7ICEHCGpXjo4tjmcRncwnGIlet3AJg&oe=6AF9D6F3"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kNFUaZPieogQ7kNvwGfyuMD&_nc_oc=AdppxDucZTVNc5wti4giO35xuXUpvlwk9vUCwkX_ZG-Te6VoRNsdyRbBmktV1Xy9G_Q&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTeQClDze0pcOSRSySlc__2gdgsZvcib9PvGqZIdNrHgw&oe=6AF9D237"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
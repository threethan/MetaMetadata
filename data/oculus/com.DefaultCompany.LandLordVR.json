903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iZx6ydlIAFwQ7kNvwH3qKu1&_nc_oc=AdrgaCsetkYievTbJjA1M4EmWW5F33Au0FqFGy9EbfPz9fG2qkpCAX_TI-ILMucGua0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8OmCB6Le6tbcU4nEoMnFRH6vC2QvvvQxc-L8tBY9uSZQ&oe=6A2434DB"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZWLuHkqIatsQ7kNvwGmZPh9&_nc_oc=AdqRONru__YvMB18XiQ-EZfe1_RQm5s-aRzQijaYjX9HciL75yEG7Bkdudhc0HmogGQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9JSJsBIddhBseLjvvVgp3V-PZXOWL_bPRBTsmu4ytFgQ&oe=6A241F38"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9UFnu5mrbpsQ7kNvwHN4-5p&_nc_oc=Adr8LHk3ieA3vdhkMsnmS_jv0KnXz5hl-aolizDZUidn9FYwpYNWTliGD87UdFsqjg8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9kpHiMcgUaNEk-DhDQ252qZCI1qu3-udomfXPkB8BegQ&oe=6A242D32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uWppsCfZMfcQ7kNvwHEHU05&_nc_oc=AdrBqoKROnZZ2PDrhLyzem-TYkanjaO1tYENgDWDsSVBSs7MDkWBl06PcN4gMszSvag&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bvaV7Tlk_lI9m6C80gfzyRrw5FtgPeLOgIbNzXpdXdw&oe=6A2443F3"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tk9VN-12g9YQ7kNvwG1hqmW&_nc_oc=AdqN0cfDz1S_YF0Ty3_2sAJpb792qsSA2FnXlkwDl3guHnLg1_3EjJ123uXNM5Ca9D8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_QYc2-QVNn0wHB7aSKWkSUTLtOpM6EQBWPeHp-f1TQwg&oe=6A243F37"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
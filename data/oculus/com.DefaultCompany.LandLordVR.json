903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4QNafYZ23nsQ7kNvwGIpGC0&_nc_oc=Adpo3D8saO4UCAnPjh8wjvFbIccpJl6Bh3H42bV_kflQni7Mx_kXnvfV3fb1K9UyOGQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6peFylibDnnTRRjVYN9hy7aufh4pZe_kmVhXVWdRkQQ&oe=6AEF3BDB"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EJu7IS8xLJcQ7kNvwE_q3Y1&_nc_oc=Adq4GkIjLsUbDL6u4yfj_b4ejfdkOuSafEyleV9_pK_9RzREW_x6DxIQDW8rF1IWPzg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGz0KJQBWj0R0fqQ_5vzwQwFKqMMQ7mspGHDXUsQkflA&oe=6AEF5E78"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f4bq5wZ-0AoQ7kNvwGhmnTa&_nc_oc=AdpdWBs2isPuGVFLvNNj37Q3EbF6fz7BPF4aBb-GC0K3IuuXkVum4SIz6izpXt7d-NQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7eLgHxhXhIJqk5Uz8AuaTX_B9fYl7ZM6WYfIAux84ww&oe=6AEF3432"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0PdjqKN1oAQ7kNvwGFWrLd&_nc_oc=AdpVQP42NNEPokVTFaK75staRrO7tNOXqz-eKFQ6MoVxG1H4sxgSyOE7HyXR0Y1EBII&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROCNbSJ6Ht9C_hZcpU0QBbP7l1H7qLQkUZqFxXO_5TZg&oe=6AEF4AF3"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cxwbbIyuQBIQ7kNvwGvtDcQ&_nc_oc=AdqHHfEpgk8OGNk4E0m7P0dLFpik-8b3tbWfnfK5uJFfTVh6XSphYTWSbfWfDe4mS_s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT62OCkzb5dnKfkOaAwwMNy-mYyCZFYCMkoawdVXqQvcA&oe=6AEF4637"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
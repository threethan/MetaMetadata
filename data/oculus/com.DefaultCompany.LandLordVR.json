903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hBxq45azqx0Q7kNvwH6CORv&_nc_oc=AdpgaWkbp1wMAM6GJoqlYHl7fnJ-Um1eA2O8wxSIBWz5z9qTac22gvLqM48MaAgQctM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJXLeKVAvSGumU6L-eDC_ib9VZa-No-6I5Lv_aRwUI3Qw&oe=6AA2C4DB"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fhQwNrasKWAQ7kNvwEht04C&_nc_oc=Adqq93QSQamsOLMlocoFm-FvinO_yL2r3kLAB0yWolub-UF4NM1kHybRn-UJEWhQ0F4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQID66letL0yC0eZRPXcrjHYGQr2NBSUt5F_OcB2lwIpgg&oe=6AA2AF38"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ppOaxFerg7oQ7kNvwGdXbDS&_nc_oc=AdrWjzlsbFrvrFhNPd0Kl_rWU7uWyjTRGX6Jn0SmcOUz6Ywb44HahGCSnzuFP-z_s3o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNHugxU8FiNiw2U8Iaee8sJz49DfJnP9cn3JOxsvCSUQ&oe=6AA2BD32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AWIWXi5XDrgQ7kNvwGjYzX5&_nc_oc=Ado3KFyQ2e233AB8uORprdsCu6Q44PWUzMOIrtCKdgppETTYYrU8T-0FvuEsgJXLM-k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL3mX6X-dpPhF_XGxLWlAsffDCp76L6_SHyUDd7MdYKYg&oe=6AA2D3F3"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aCk_Zd9tXeIQ7kNvwEas86A&_nc_oc=AdpzHZQvBVns7GyrKDTE49F3urfJA-Yl1d7tbEFSrolL1LZqu3ASeshWULgwXJ6uDDY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBcel64lTMOquaDr2kV1WTtA0ZznI_94rvh12Yh2TgCw&oe=6AA2CF37"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
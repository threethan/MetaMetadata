903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0henyx3K8IQQ7kNvwFOaZc0&_nc_oc=AdqOJBuOpje63aRqJT5GgjxAI1k2lQdznuE1e3rGQtH4lxkpBKuaAPSfDUQj74haJJQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0AYsSMPV7CBy9VQNhKDXpUUTIkXXS9jiFF9JhdqA0wsQ&oe=69E63E5B"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aeG2gLdR6gQQ7kNvwEZWfdr&_nc_oc=AdoRbSV5k_68EBjpehS-Bl7rg3i05Qlf_T--oBHAiOhAeEmHTTXE458pzGmVaKPSMpE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0tCabgVBuvW0kog7auxVYl8q7qWPR_XuRb4Ewqw7q7wQ&oe=69E628B8"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_adt_PF63BwQ7kNvwE5fsJX&_nc_oc=AdpMzJ_Cr0qh_sSTNsTY99vSlAsNIVmQIqXN6lPozUr4oSz-Ygliypvfx5yFoaa5PtY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3QI-sYSrt0h436q9qbHbN8XTcT-UZDDXFqBarLhLbZPA&oe=69E636B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fo4WqQTW8gAQ7kNvwGzBlEa&_nc_oc=Ado2VjyVNMPHSbtZ7yDg2pkgmDCzUpELD0rGloeFxaeloI9w0ToR-Cz6syCka_5xXQ0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1grjkKVi-sKcso9OQ-DTb1_wJ0ijQx8PzF2neHJ1_Ilg&oe=69E61533"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xh1U1GsPEX4Q7kNvwGS7QoU&_nc_oc=AdpRcpzgycvTKA5UqNdcXu2P3LgyqzNihazgqeGYHJR4uTdh9uKZUPWP5C-jU2oGHw4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af16tzSlDlNvrp_aU4h8JPWHPrwq3DRB-a4TUYSqY0i1CQ&oe=69E648B7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
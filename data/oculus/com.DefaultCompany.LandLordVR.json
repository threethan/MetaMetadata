903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rEP4jEkP-4kQ7kNvwEaPriB&_nc_oc=AdqBfojcUAd5aW-7W67vSNfMSK3D7pRcOKfwTmgzPhc5bTsYd-rmhpHhHmL3ZKp7EI0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5loFTvhHHctGU0Kx3sdsXGTfRoqKOfwmog0Zsl2NEIg&oe=6AE752DB"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nGzdD1uNYVMQ7kNvwF_yazi&_nc_oc=Adrk5EgxSkapMGVbO96-7KLnd_7P-HrmrjPyRouHsbIGCyiABCq58CpYjtMJO0RFHXM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQm3ucUDr6iHhIxRQ0lbgCf1fW2pFPwv1Hi9XiOSDTpKQ&oe=6AE73D38"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JM8C3WIjoZQQ7kNvwFMSKE0&_nc_oc=AdqtZt9PX7uX6edQ9DtTYgx4-NEJ4WABkXkS36sdFzcZbgChUnnn7CpgQTyPnRqLVhw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlMShQu-067D9y_jwMK5vHFGbkZ33ZhD2rTJaiClIH1Q&oe=6AE74B32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G0ga3Y421wAQ7kNvwG57yzW&_nc_oc=AdpQ433cRxTB4kGEGqx1rMvJbri6Sko0W9fCQhUGa5QTKXf7FFaJmdgDELmYQXmHV1g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSg2nxFwZNk9860Xv1P7CINZRaww_DoF8ADnbK-zakxsA&oe=6AE761F3"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nRiaVhxEpe4Q7kNvwHNLtNK&_nc_oc=AdrBMzTNwzjyMt-A8Gh13dpHBSIqEdf9PiZwwETZh-VvUOE4Lj6a0c84UFMz-sj0HUs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRk1j-fVgzn4D_1ZdbydmrrJPxV5YrxReWIGZD4pDXdUg&oe=6AE75D37"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
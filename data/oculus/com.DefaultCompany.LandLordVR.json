903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i5AJoVQlBnYQ7kNvwHTa9ub&_nc_oc=Adpel7rsHY1sSa0aD3LYLxnd2xKc8j_wDSgS0wKPyQK_k5p6DqeYMQmy722MKZkcu1g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1lohAELItF7hwdk4X014WT8uJSfY9hxTYkquBLcNjSgg&oe=69ECD5DB"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R2YaRgTD0BUQ7kNvwE2dKl-&_nc_oc=AdoJh-EUrgML_lEto9fHJ2VFaL702SiK8c5hBnKMrQGP406G0Uk4DzcJRbGMoMeiF0Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1O3G0KBIvkF2RR2McbFsGUW9HI50epAlWBNXUCPZXTow&oe=69ECC038"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vkfQrGMUffgQ7kNvwH6VCQ7&_nc_oc=Adqahi26K3ZEZB5fDAaxKuoEsDXSNmSjgmQerSWHK3OINqOTuyPidn2BaEEVsmquPLo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af14PHka7D1r_qFK8C_I_SXiaVLtkmq8CUbLdCNlwsU2UA&oe=69ECCE32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L1ztYu88ay8Q7kNvwGYpimT&_nc_oc=Adp2KgdNBdlUDnhCeAy4dqmEAucdNM6NbLxjfwtkMSUzgOFd1HMNwJXC-Qz5zqThZrw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0b5gEfcrC6gFAgNqefHsmgfPDkKx22ZLHzJHR6Z_MujA&oe=69ECACB3"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gMLfDH9UAO8Q7kNvwFb9vv1&_nc_oc=AdoJtVQdZFj5m2b90edvujZrAH-2RzkfdG2EJ8jIC52j94rwk2IqR21F7U_whmO3EQE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1jvxhzo8o38whc47m-z73H14HPpQpYPPpoUcL2drnNSQ&oe=69ECA7F7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
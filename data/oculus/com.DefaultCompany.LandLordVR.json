903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VVnrg5gCGN0Q7kNvwHfgE03&_nc_oc=AdrlZQQtzhe1yepYA-IOdzx6fZTpuNUmNg3mw6Oi_V1vJnWtcMoOLfJI_f2hMGw8o98&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_DmwRKzHhGEyiF1n5dAkMwLiq0QuY7iga2_kLtV_6LCQ&oe=6A47CD5B"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dp9HFboCJm0Q7kNvwHet82n&_nc_oc=AdobxKZtBw_ulkN4RRSttKPaUo0kGMjYNkjy2YhxAoN2_4Ef4t8pM21k_JCUpi25d3Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_M_dWO2jhCxnzaD7ALFYBLRrp09iPFrkW-o8xxQfywUg&oe=6A47B7B8"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-pHjFYUMwpYQ7kNvwHzFioB&_nc_oc=AdoZYM8E4PQHDKhJrxRTsBpaFyk9klDX4ii-KPdlPQk4I0ICKjh8fTOS1l8ct_Reqz8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-KE49KozSt8Z8Md1OmyiDUvY99G-18Fdz8zaDBsFQWBQ&oe=6A47C5B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=udQXQQSE8vwQ7kNvwGv-1X0&_nc_oc=AdpjiMODl8pEjepFTJhlpBAsD2K7wvUNB8DH5mzT0D0xrtq9xfqc3sMDUtFAWX6-w_I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-XxlZ1y3pxo5-3TPx2C1jHNP3DbfEm7MgotEEyE37NAg&oe=6A47DC73"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TE6kP5fOn2IQ7kNvwFPXb8_&_nc_oc=Adq2bL_PJBhdqCRvMNmNjL3xd01MDRXK4LBgl8_CyLZJV36HwG_MToa8W1nC4DNU8N8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8erCoBznaAnPDy8JtRcBCukgkPT9gMOfQejugpjQcCzA&oe=6A47D7B7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9sNZ48sg7IUQ7kNvwFerfb_&_nc_oc=AdoHzrcDPwk-Q8v2CngGCX-RdPbHT2rnPNI6RijgoPPBCLdTRS7cGgSqV8dtkH5TvSg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7v3tulRagS_HzKOcdCkScskiaoVzmL8UbNNAkgNZA9Gg&oe=69FDF95B"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M5YtIEgl1HwQ7kNvwGnm0dv&_nc_oc=AdpgBQo1E3LILi1RdI10amJgt3nKEaWUwoNY7JG0yu94b73t1t2VVD-eHPESJHVm73E&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4P8CRIqwFPsGJyjoGCXowLgRLXcuX1DZ3meZakV3tcSg&oe=69FDE3B8"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X9UtMpOj0HcQ7kNvwEw9dcC&_nc_oc=AdoIUJdwZWo4nywdEq8roTrk-_8QPOedbZsZktXv5djCgX8zaHZMDyniEAnrTtBoan0&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af41fCDT4aCKLvI52reO7HO8_4btESCbSt67L06Vjm2jcQ&oe=69FDF1B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g76DK3W4D-0Q7kNvwGDlKZM&_nc_oc=Adrb5RCe4oS3aZ6RaY7X6j1cqnFCMlhgyztzUvn7ugyHahOI9_XlqQLvaz0yGfgoqgs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4FMuVFlVOQYF_t7L1IRTLouqJGHPsz30GQ7yFnJjX6eA&oe=69FDD033"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Su5SLSpBQtcQ7kNvwEOAPXi&_nc_oc=Ado04UCv5_-Wgk9FWTSoC6NCUriBLPGNQVz6RpqO8ZS0EbnMh7XRBX8RbDhCu1SBp-w&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5If-QpQNphTp0lYK2Kssrswgzfm1Wd1TzcLEDe2USQZQ&oe=69FE03B7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4OgJ9IOGyf8Q7kNvwHPXQqa&_nc_oc=AdrXKuD03wm7Yxq_FPibqD5kvsfEW8yGmCtlZEzrS16uPJcBx67WKBLz6x4CqxOuyr0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af86TPv-5YBoxS8-Th510gX77Y2HJ1LSTvE1H_zPs5tXkg&oe=6A28295B"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yWOs22z7wmgQ7kNvwHJnnko&_nc_oc=Adojirpo4VAApJ3EyIBgquS485LiIO17YnYyiFk1shUObhARekWZyLLLhJywNQd4czM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Fezo9-wlUVpuGel17lwt_BV4CyRxawsuG1CMisoQInQ&oe=6A2813B8"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fcp2B_xNBDsQ7kNvwGEglcz&_nc_oc=AdqTqWc99zgIjJelksaQZ8SjEzmDSRUzFibqDqWkYsppYI0t_5nUYEgwJFuqgS_usN0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9K8Xb_7b1Lk_uEcqzBW-6M1Wyg7dADdGsorXTIP18jmA&oe=6A2821B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-O2VaamjYtwQ7kNvwHxWId0&_nc_oc=Adpnbexyq_U9iRaZyBEAg-2OS_oK5-5Wii5HLwHDuoSzMSwDRNufNHgivX7uQlTFy2o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-zPB-Nj6OYTgMGRPD-QKizMS5OGKe6eOLuJvoC04mgZA&oe=6A283873"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=giALNpN1sQEQ7kNvwGn0Hu0&_nc_oc=AdoQZcU7HCssg3_dUKu1EpxYLei2JSmeu678nyt5osa9sUUCud164K_-VSQ68AX1wWk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-WZJZhFHQuc7nvz0Q1XzO9z6BAoxg6Qk5i-7Lv5zxhtQ&oe=6A2833B7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
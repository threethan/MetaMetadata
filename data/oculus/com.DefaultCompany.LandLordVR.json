903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O_YrE5rUQwYQ7kNvwFXlocd&_nc_oc=AdoGVZtYZkNn4OtY8cED4xGqoru696RG2gbHnxDsJM16yK3siGEiFGF3yOXkFpr-IZw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO4hwpcsl9K7GgJVoyCoSV2KCG-svRTEx7GRLmW43fK3w&oe=6AC7AEDB"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wysl05HLHcoQ7kNvwEV0sYh&_nc_oc=AdoDJpTb7FtC-Nsh_VEGBzzR8ZP-_TdXFjKkkx6j5ysNSyPortNSDQFWlRWP9Wq--S4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6h5ZIOEYO_PaCYdXvxOQH2t7rfc62XV4LovaVnf5CkA&oe=6AC79938"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JMntJOMy8_gQ7kNvwFEqGEm&_nc_oc=AdpwvnfGuvBavMo3lomen_kQE0T0IP-EGzd6BMYykpCyY28XjmxCo_Ulbu6JPJ9DlyA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP4xqkzq-HCG3ZtQYM49kGMbmUurxSnafdD291TBU-dPw&oe=6AC7A732"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Erqr_2YdAJkQ7kNvwFCsmUb&_nc_oc=AdrA18x5eYLqWOWVnpqmNQCI5e_l5RRj9hm9wyBv6oiYQJ1DmwS4-4Xp4oARARfzxy4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_clK8Th7HKeQqShoZCAcFV-6zVWewxA8EUgx_hjj10w&oe=6AC7BDF3"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y1k3fJSEUoYQ7kNvwHV5HaC&_nc_oc=Adog9sW7KZ9Fv1_xEmZPlEXsbA895fRpr2lwljVdXh_Skoi2QqpP_JYRcvnPX8O2zpU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOwTqQoot17S3XNVsNZ8VI16LgWf3KHg6jk7j5EHxGjEw&oe=6AC7B937"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
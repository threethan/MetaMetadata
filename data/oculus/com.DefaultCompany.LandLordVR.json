903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wtBAdXG3eQgQ7kNvwFiVOR4&_nc_oc=Adosx8u_erMLXPq9lBJl9R_YMgCAJowQWtvqBMXB3O5aF9onuqahwRWINtTggpyZXfg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3tS4gAcx7oQBxdCn_0Mf_FzNOnb32h-dKtErBzHQx1dQ&oe=69E78FDB"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aeG2gLdR6gQQ7kNvwHlzSeu&_nc_oc=AdrmiJAclGu5VuEz9HVlfHxWyrAvj-bL_46gOYAMlkwc4OMXWNM2u0XuXn89pgm3moY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3o8hSYnHBKpEJXSfHrZ1Ks-qkUKsQ2Nibwpxcs2ttFTw&oe=69E77A38"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=swar9wbkDvUQ7kNvwEv1l0t&_nc_oc=AdqM_GIXHj4zyAmCmOoibbccnv5tFQ02c8umC3g9FEYYhB-Iqvr-_E7VtCCVBEOWNnQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0K_4gqLclZIDTtibSpvNzZ_a4Hy6bhOQsEDmiDyJ9WAg&oe=69E78832"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4muIV_wWHg4Q7kNvwHt4uCj&_nc_oc=AdpEfqy-jxo4VygKctXEhnk6Z9dXg0z592tv0pl4WzgMuQjbO7pzFD8IUy719QJasuc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1z2RpL2v4HjsXKL3iwCzyYb69niJ43aOxxQzPAovCU9w&oe=69E766B3"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xh1U1GsPEX4Q7kNvwE_WCLh&_nc_oc=Adqgz_hwNOoqLmwgUruLVK_x4g6xZyR5AJIGEKKVfZUQ5dGGJEvX8mcX4xE6eR-BZPM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1pwm7IHYft1ZtffoGEXtajUHB8zZkBiV19rUtMauNx9w&oe=69E761F7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
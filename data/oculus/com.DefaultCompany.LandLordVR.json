903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sJ5vOQv5r10Q7kNvwHFjlb2&_nc_oc=AdpYQAnOc42JeYM-fap3PL8yPZcduF8mcZKh_59oOjbHTIX_AwnNpbqS9czgfqvxLgM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUUrjDoMxMFw0tduCus3D4Yws2rZ7maoB3i8U1wW8h7g&oe=6A998A5B"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b5vk99YMGOkQ7kNvwGfyqcx&_nc_oc=AdqwuMFIL7n-t46iButVDUL1cn4R03g2DvSC7hWzklcTRxKxrpS9IWlYzutsG0RsMhg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKllXYu5zssLhx0Mrglgr1ZLyXXm74JCOYCSCMptjjUqg&oe=6A9974B8"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-yVE1uof0sEQ7kNvwFbhkxA&_nc_oc=AdpVX8h--pMHss5KqgzMcRGHPOlNKKcLAn4XiewnZ1DJCV7eaHBAd5rpoe98DEOVlzc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEiaMavhJhK74Nk4PTA3c8uSnDP1V-1pHQ3_5Ts8Bt8A&oe=6A9982B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f6djy1-d34YQ7kNvwF4ota8&_nc_oc=AdpScYRlOUbLoX81NUpQSeFL-JVY_vLHtQe1YDvC_V2sDhJn1cG8f2aZL_rDVpO8GF8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL98IvTE-URMGdQQi8WjnjXJ1mFmgW31iaimF1WJJqbkw&oe=6A999973"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iPCeZcmC7mAQ7kNvwFhjDA-&_nc_oc=AdqVhusFiZsZHWyhl-fKmjmFORfaZJk80InpkgMDsKF_mrGunhLqeexbwpGwJoxRV44&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJXPJeyBgr6QNwDtWHc9w6NajtrsalQuCoiaWwf7IoMJQ&oe=6A9994B7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
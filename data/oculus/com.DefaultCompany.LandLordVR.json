903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aloBDYMKmKkQ7kNvwGp5Va9&_nc_oc=AdpyMZ3Oj8z-kSfo_GQOt2xcdP51lJcGREawBvQrdF8c2wQZBTH4U6bmmvYxyvHoaUE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHj-FcFuupBgH60jWRHaIJFhN6jf0rgPlLnNHrlKOL_A&oe=6AA6B95B"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xpgctjZi9PIQ7kNvwEIBaBq&_nc_oc=Adotn0-f5Uy7VDhv4A2UAXZIYotbCRXX360izKPAIlBRG8VEN11rhy6zi_25zEJ4VbQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIVcw0sn9sijCePbTD3xoyLMsbbYXPOG9RLWdgwKZiqxQ&oe=6AA6A3B8"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DEi9OpZBuW0Q7kNvwHAURIJ&_nc_oc=Adp76n5PUSJwZQfxOHQjiljxOGT6WHudGa2tVSe7FgRLfbm_1u9hHvJ-V0Em27CGICc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKvKbUuNSmtPhRC32jTeoX1ZazIKVXvK4JhrGWA_QWCNg&oe=6AA6B1B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D_vA0Xd3L90Q7kNvwH6t7aQ&_nc_oc=Adp-BMVitWuk9X6T79iB5MnEyD-8BXuovdNuJu6bzg1RohdqHXn2pmTYTjt1QDZQVyc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKDivlYlFGmxSBtP4x83t4Mb-iujb-AhgPxRh0AGpcS7Q&oe=6AA69033"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LQeMgMHajQEQ7kNvwEmInkB&_nc_oc=AdrUWfqilBZDkJs2SK-OJLnr9aNq3xhPQY4bIhEe143Ab_GJgAvhFtHvwiaOWbkOzAI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLOYUPphDG27y8WSG3XQGmrsMaJ9a1m5n3BhI78rL7GQ&oe=6AA6C3B7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
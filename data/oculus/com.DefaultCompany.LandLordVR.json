903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qfbdCY6HWNsQ7kNvwGxtwPv&_nc_oc=AdpOuCqq3e6Z8yzafkvk52UFb0QjX9KswHJTQ4Ay0-pouv90f_E03Db_yVgQ0xCEqd8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD5Jbu2UchdzYihTr-FLBliLg5IAZMK0LqeyHAZQmPW3A&oe=6A4FB65B"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Z5QXA30lgAQ7kNvwFKyuI4&_nc_oc=AdpXSNiy8N_7oaQC0eMd8I7He1Z1mrqRHlFxI8YLI72NxmIin7oWFpasDFCs4ic275c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCnli0oArXNvSnNO_jiDQl9K5p65GqACk_l6DZN1JJspA&oe=6A4FA0B8"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xoB8xEl_chMQ7kNvwF_DYz-&_nc_oc=AdrqY7B-kkrNWiYJMtbQXwfTHzPAderHDF4bjrjMreV-E20OG5q2Y33hHNnrwHxumFs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBrgIj6TuKhYGT3Nw_J3Fy8SmFqGu5_ilHP3I_cxn9wcA&oe=6A4FAEB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5eYHpRklEYsQ7kNvwFxy1gi&_nc_oc=AdpBtySKDudrzlalLVImaXNKC1A7GyRq0-9UyMeoRvjoRGIP6ByZYfJmAky-jHtQ14c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBPfaVnoIZTltCoDi8MAwimPxMnjnme88eLzXV-wV1fSg&oe=6A4F8D33"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VWxVMw_E8woQ7kNvwFQLgyW&_nc_oc=AdpX64HR3Vfb7_upUPcapgbyKznW11TpyBBjW3sSsIoI7MFXJCNVpG03kSVHgkpzg6U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDMR4F5v9GS97vlEJ1d9nSig-zILEcU5eQ4w1D0gduSBQ&oe=6A4FC0B7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
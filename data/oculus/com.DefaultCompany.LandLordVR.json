903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NQX5kQMuINwQ7kNvwEToRKP&_nc_oc=AdqsQBOmASkjHgCd5wy4lYOSPwbE7T7xdrhwwplbAc5XUDhMPwtJtzo2PQiZQVdF0n0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGk5GF7G0C6ZPz-nefni0f4wKCzvc2kG30nO7B6sZRfSg&oe=6A7C511B"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cUFOpoeKrg4Q7kNvwEKA1nF&_nc_oc=AdqRyNcGI02Hsef3O8UWNlYbnjME-45sORMURZdM5l5Zj9s1AnsCXd9jAx5QDE4Vj6E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFaZzC98ekIy2aabQ5tbfxe6GKu8wpYFCVjkoVgIlwf7Q&oe=6A7C73B8"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hOx4reEzXwMQ7kNvwHk5W1y&_nc_oc=AdquWl8Jh3LRUnCoShyiROXRlIebAi04fT0poOKo2A1CiR7cwnvtX0CFnXl8-OVeZWg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGx9qci6aRHNQM-QHZXD7cVGDMXrl4Fp5QTSkmNj7S7yg&oe=6A7C4972"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x4Hl5Im-OgMQ7kNvwFjJXgX&_nc_oc=AdpQqAwcmtujEkTb4TrGelV8ZjTLAmhM1FLBZx9IlXVVeG4NjlOez1DaGwWfR42rrwQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdGVqL83Q5QYbOfhghHT0TtuYEQyuTZwv-OsbIIaPFFg&oe=6A7C6033"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aIQVlBobALAQ7kNvwFd--up&_nc_oc=Ado48_4k1tIdDHtlvOweYBxDMsYDh5hjUcMbnsV6QM2AVvekDrSZYtcyW89snkSPvLw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9adVTZ1h0BZGn-8w40mivB733azdUN_Ni0ysq6g9Mjg&oe=6A7C5B77"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
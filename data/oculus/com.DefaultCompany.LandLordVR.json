903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=47sBuffR5q4Q7kNvwGZAiYb&_nc_oc=AdpE1eQafL_jCyB1p6Hnz395fHOKUfmtDuqHFanhHZsEsPM8oxPPxN0TziEmWrapDlE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAzz_SQgdTy0wa--sgZsMvcFpNbqwV7Q-FsEMHi6tli8w&oe=6A58F0DB"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OElOJuKd7BUQ7kNvwGIEqd8&_nc_oc=AdqGP29lnTK3Ues4Ia5uPjN30AHnEeHIwVBo_bdUG6o3nWPCCNzUQzaxQqWL0itS0kI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCExXmCZ0o5Yq5DnNv0RyZYEMm-kecC_mtxuR6w8w84pA&oe=6A58DB38"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nIKW6hpCUM4Q7kNvwFmxJAj&_nc_oc=Adq1koe2KACW4cLHZlIcrgZSesbmMDt5shLq3xsCHzzf3fMzjTho3fOT6XiC2bdvB5E&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXxmG5go7duk8SfCa_WPaUxEHrtTyq9rYC-aSofAE0PQ&oe=6A58E932"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vkHU3SOiZi8Q7kNvwHPv8wF&_nc_oc=AdrcdKXATuq9iCeKjuI3HWgWQMxzVWUaLywoUn8uzFkXJwAlZIdxp-jGT1sc2K_CvRw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBdBaKdEpK9IYJRnxXn2uaVO4grJmUQht9AR27i_o6qDQ&oe=6A58C7B3"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=347Mc19rdZEQ7kNvwEEmCK1&_nc_oc=Adps2yjvqzMiUcn-IfvFtLJtDctp0Zu-s95k9Eo1Luqv4N3jMSJ96PqME8cEwqSRwfY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAchgxJ_GxAPUEf9vFDGSqfDzVtJV7ejPMGRPy4KeyWQg&oe=6A58C2F7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
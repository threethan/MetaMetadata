903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hGwASdaPcWkQ7kNvwEwYvq0&_nc_oc=Adocnu0yMSBRXPAlPhC098670ciMwDzasRh5MoRw5HJPHC6MtzasyNhss3SmgJLhFGA&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af56MAJFXgZY7FNKjOHi8amtzkarLSEP81IHWYmAHsnLPg&oe=6A106E5B"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0CFNVLHiPlEQ7kNvwE-zsaY&_nc_oc=AdqHzdO1JiY-KkrPEb6969cVt30I4DT_dVpvZp7w7k5SQK1ceFSMhHd5-10RZ5Q_H38&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af468c7L_EUiZ1e5y1T3LTZ9Lr5gXTm9qgtSFOsM_qXyFQ&oe=6A1058B8"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ikSjS3IduH0Q7kNvwHhVaWl&_nc_oc=Adp2QNLlz2wckNtasnXFEwyhevhBP_QQKoCKiJHneq-aOq7yMhjY_mSDkRPtUw-SpSw&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WDPbMx2XTHw-EyeivS4miEz32D0HnwyY2htizdoWeqA&oe=6A1066B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SDblShkJ_FkQ7kNvwFAOfYU&_nc_oc=AdruorWUqewBOuoFmnvNhgAVcN5CAmadx_vZmetYFeBwl0SKKXBkj1AS3IvSBEoL4Ec&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ilR9_rzuxpqcwSdJiysNezBb_ZEHA3HCA9ofm8KqqSg&oe=6A107D73"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E3T5Y_vLoMkQ7kNvwHwPZUJ&_nc_oc=AdpWo7JY5kXYQoIh_EnaFBFkTMF0QkbEo8bR5phCjpx8V4UoM8K0MLpGQNxSiP2Gm-0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4YLPYpGUB4CECZGCqVCItUuGBoLDZfYrJFkHw3HAYOlg&oe=6A1078B7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
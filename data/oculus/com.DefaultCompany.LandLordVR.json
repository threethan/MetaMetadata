903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EvC2OE1VBYQQ7kNvwFgavOf&_nc_oc=AdruLFSQRAe_PwWAXCVwRTv4B1i0rxb3r0NQbhmD6Ed0yJOcRMcsSDfnDuN9Za3rtK8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTt3QA2OhvYoDBa7b30g9Bs1kwpmtbTMxc8OA2t2kidrA&oe=6AF481DB"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pID1pHoq2_oQ7kNvwFuyF_y&_nc_oc=AdoX46e16YueeWLeNpMra4nNSRuHL2MjTstvw9oOvOhMxWzvKiEim7tQNG_2iPRvZZM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXOOVJ-NkSiRQwRh18ukb9btoJnL5xRUcIC8xdj3URaA&oe=6AF4A478"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4EhSI-4-BWAQ7kNvwHMqdqo&_nc_oc=AdodKevJWJ2bB1Tqj7kEPufNLL113Ad8VCEoTgr9vUglogUAjA63uUk3JfBzlp7fHOE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSi57hM_IBPOHOz_T_DuJnSMLekOyAeWaQJLfUTa4hBBw&oe=6AF47A32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MwmT-eTFnxgQ7kNvwGlzZkh&_nc_oc=AdoNGU43V5LdgxIeUBSTKRsiGMnwx1HkPFFyKQacwkna9IxCSUiZKSjbURx9gffzOlc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQuGDipGI5Q5_-XWo9entUA_PxXSF8LD9j76MHcYPfw8Q&oe=6AF490F3"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=doEsv_W9HQ0Q7kNvwG_ft96&_nc_oc=AdoNfewoHAmgrAHyFGCnVfEYufd1h2iIjmRQiP0TMLoPVKfoz54YHL0n_AhnN3c5Fmw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNLlx5Ny2ZxuahdfXcBnDJyR4rPDh8nxPWxsX340jhQQ&oe=6AF48C37"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DmS2y2_zp0MQ7kNvwH5TN3A&_nc_oc=AdrIQKfcvsP3MvsB3f8Nzk_yMF10p6bx35jw3becFCi_OEqXA0gpoHcKwE3zRcPrSYE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_cVAs3oiaF3unGW0z0thrAh0tLer09y6eTpA_ZGAcGkA&oe=6A3406DB"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PVqUl2ByxgQQ7kNvwFwsk35&_nc_oc=Ado-sR9KyuYXmlvWvtLfX0m10LHp5-bODRnP83mQ3yXxQyQNWJPxtuQ0JGv48iLfbuk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Bx4v-cbK-1a9M3Tc8V8yArQXudRcqDIJhcNITK9JCfw&oe=6A33F138"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=97eRq9KumIsQ7kNvwHJis9N&_nc_oc=AdoLJrXQXtM0NIxEbQ3E1GlYsR0F6wh0gLvWH8ilWC-dNeHcst1StC7r8-1Ig8foJjw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_d6KZrWekRW1IwLZqTzxGDY0RhBtDWcZW2UvFloasZww&oe=6A33FF32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CAxIyiPQVzcQ7kNvwGtQp3P&_nc_oc=AdoSm1QysUnbwDvq2f9bwojYR5t9Ko7M7dFA1Yi3PAlK91Cms_aPo-b1vrnDrdcXZek&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vx6Nq69c4VURhNgoP5ysrYGTrtppRfjXnekwIxP8_Gw&oe=6A3415F3"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4B1VJlIv6msQ7kNvwE0VExL&_nc_oc=AdqbcAxnbG-r-GtIDKwlov1T1j_Po3kbbs0ijsXyJog17hvBJzJTDoCStniRlgK-m7I&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_AOC3foSvy8Apa6_qRsHIHxKzXeXpbnUnCeXLo7GhOvw&oe=6A341137"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wa--rEofmyYQ7kNvwGV11ml&_nc_oc=AdpGObeP-pycqIeBI9WhxmqJ718CdDgjyZ8Rixe8isYrGPz17UnOkP6wHRmPnEMkrhE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN34-M7wrrmo3aapEcvtFMUw6pivseCZG6VumJbduF7xw&oe=6AC1175B"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EtpkrFpjGR8Q7kNvwFmPVpB&_nc_oc=AdoWt3z_VTCZQJ86jVjk9Nj-EgUmSd5rXR3N8_dolsyQzSVMOFzwe_LkJKGYX014DQ4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPrB_eKRPekFD8bEsUzWlC4uw-fuf1g9HYxgPPjd6hUKQ&oe=6AC101B8"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uRAQ9W4VdGoQ7kNvwF3vD8g&_nc_oc=AdpaDjPznlLdHHiyGRb6KaAySd5OOMnI2kN2_IoHAvdIt5sxTSClmyYOOmrdi4ito9c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJ5nqJ4_JrVi5_y7TBKEoMoPG3tzEl8OBeLetiQuSyvA&oe=6AC10FB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K7dp4mKSMvAQ7kNvwGmzC85&_nc_oc=AdonzEPfwkByy0uNBxpxgvLYRd9dlatakYvwLxRN-Wlkx3ZWRFCPPJYgfrW7ebkQTys&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOib799TdBZqqXbNc4HWcgzn2khe6y9sKOOl8HQgSKl9Q&oe=6AC12673"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=84qa0OtEOLcQ7kNvwGocaeE&_nc_oc=AdqXpAaVgQFDuczyxTppVe5U5WQI7O5wZ_KVLM6rTvYFLARYNyCvi7171b2euN08PcU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPnu-yW0HGDwmRvElAykv1D10XQri-RxmRgxcvJGJYbUw&oe=6AC121B7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
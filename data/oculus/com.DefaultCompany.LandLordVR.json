903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WSL4CNJJIKQQ7kNvwEnW8Yh&_nc_oc=AdrTIZxDt3XwWfl1kuuV6_3-VGdJjWbhevhdS7yJe13e0vetiz6pY-b6lLZPs19dhCg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyZIXJybqT51kl80oJ2hSnSlHXmn_f5nTrXc-sNAG_rIQ&oe=69C5109B"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IbCUEWMV4icQ7kNvwHACnAt&_nc_oc=Adp4x2M8ZeIUdtg3A2wPOtsowJOI6TI2awy2Xb9gp46EEZYMGi1vGXLloskqwP_7g3U&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfynrNtJII1IaHzyq9zcfZryZjDWOvVTgQY0gxSv0662Kg&oe=69C53338"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fHqLEm3uUtgQ7kNvwEITXgA&_nc_oc=AdrH9gmPRf39uPi8NfzStHGvRefj0gXNN3p_Ef6QC-OqMHmC12jMa7WaJscFarVJy-Q&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyjmtoSVS2OvN07MsJt3UQjTiK3h3HBV3Gj6ymaEAXdIg&oe=69C54132"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yC_jJcUV9wIQ7kNvwHtwXbl&_nc_oc=AdpRjdHsshh4w5sc2AMCaB6O7jdZqp_IT9YSsIKfzzBISh1QuTP-EvohNFT4tU3MZGk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxIujv6cnJz_oFIoUL8dINMUrkKUw_-HOuNaG5PT-01rw&oe=69C51FB3"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NfIA7k-XVcgQ7kNvwEElR7a&_nc_oc=AdpnuzG41eEMYxfYXJeQVW-YGCysGONGFqL-yFAYTyXoj928KN2HvdcWWtMJatV9INk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyzYIwz6KDMVpHWtaZ26yaY_c6a2Y1voaHxrbbmrPef2w&oe=69C51AF7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
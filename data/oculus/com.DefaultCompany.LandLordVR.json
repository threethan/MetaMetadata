903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N4Kxcgxr_CIQ7kNvwH7t9F7&_nc_oc=AdquD_TVVg0A4Uv1jKZ34-L-0IXBEsHixF5674YugxKsVRxEtbQd4QdrCZQqb5TrCEc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOrz5M7M57ttAdCsQ0NZOv4GWO3gWCPiXLbdzw48NZHqQ&oe=6ABFC5DB"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EtpkrFpjGR8Q7kNvwHRin-v&_nc_oc=AdrsmVEZ_XyiHTAaJI-E0PnMPemhh3N-cPwFD4EcVqZ9CedmIDqp_fQIXVMY8UwIY3Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-gN3-Pkn1oV9idy-GMhmQSMBHW7gbGkcPooRjiwoDZQ&oe=6ABFB038"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vA08vwaQ9MEQ7kNvwFBYKgG&_nc_oc=AdoYh6lloodcGffKXqwtLiRf1T5by6Qwx_ol9_zD7-WL6m8j3a03zBcA3v-f8kqnPWY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPIaSav0ahw6pgv8Ftce3Nq5UErU3nZ-ng5bhYxcVyRIA&oe=6ABFBE32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Plt-XxnwEJEQ7kNvwEEtiaD&_nc_oc=AdqTUASxrAK5pSAILplKhJNmN2JluC9siZ4oFysFEdm2P6YZnJ2ErvmvolweWxPzAqc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPhe2Lw5PkrqaiW5l0kGsDmc_8FumFN3AvaCb2qprs05g&oe=6ABFD4F3"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=84qa0OtEOLcQ7kNvwG6LDLB&_nc_oc=Adrzm9q4tyiHv1ohg3Ts7uNjyh2juh9JbZcH_yvOXpvOKbL0leljqqFUsdGD6LvmzhY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMrUWjUHLVvt9qg568f0E1tU-v1tbcEXQg0MmQzDVrUCw&oe=6ABFD037"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4QNafYZ23nsQ7kNvwHJT2HN&_nc_oc=Ado3yXhpyksdq8bh46h81U0yoqSWPsp_zVS1xGDqoViRCSt25FIf70FhKmynG_FKkTg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR96QEEnNwwuiFFkn6T1OqKRof85RSjdbpZ6KsfP1d9Sw&oe=6AEDEA5B"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e_AV_aOBTNMQ7kNvwGoFmdy&_nc_oc=AdoS-7g2VGquniJQIP0nXxUTxHaoVcdmzwF8AaK8Q_FtaX8GblohUj3u1SjIu8Jsg3Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThoVF5yQlfeLKc1z_ykEZ4Ss8s0j_5Qrw6SXNJmVQYZQ&oe=6AEE0CF8"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f4bq5wZ-0AoQ7kNvwGUUQCo&_nc_oc=AdrZAbXN-R3iMfUVqA8bWIBrVVGjiITrzf-fBsDRRk7N3XYPfpN5nu0BTreffb3XwhQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQLQu02LfIo0br_LvHiflmULrAuo7dvZVevftMNHKI6Q&oe=6AEDE2B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0PdjqKN1oAQ7kNvwE5gdLC&_nc_oc=AdrZJLvkXXY4OXquvQD5uGcfyceQasODmvwr8j_YDxNB513FJ7BG6-vmrXfAalPpeus&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhvU3QY_C5Hh-FfVqvaMMk_k5wSFDGgqK12CGbDOrz_g&oe=6AEDF973"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cxwbbIyuQBIQ7kNvwGjhL8i&_nc_oc=Adqq_QYgfMwD3G08ggrLeyep_BX-CkzKUTCWTaqZcBgEnVgkMt_eIqPP-PGLeQ_2QVU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvIJl_jxvBdkwRjHjYycC4Exu08om00wHQon4QCFh3IA&oe=6AEDF4B7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
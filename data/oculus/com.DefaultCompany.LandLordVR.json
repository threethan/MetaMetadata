903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=INQMEajx064Q7kNvwH6BHEP&_nc_oc=Adp54QbuNH5yJozPO09ijXrs4chUXvYXK-AmsF4sW9GPpwV8BN60LjmnRgDJWEMFVPw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDvKNv2q_Jhg04qIFl8Nt_n18mM401Za35MD4RDV3OL0w&oe=6A6DD09B"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jpHZNkxCrdcQ7kNvwGmC0Ap&_nc_oc=Adqn7jrSxLrtRRhM2caqnWrWyFVAjjxR3ipULhlp5lQfy41FhFnDQ79qsolGrRmUiKc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6FSVmNCDXYEy69-EsM55M_cejWCuP1fLXYvEp2TswbA&oe=6A6DF338"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UNc-DiDONYMQ7kNvwF4iMZ2&_nc_oc=Adou4zkGQv6eiae7G3WPB0HlRbC6S66eP8oYQ68YS97qL2oXvow3kp7_iqv_IqMiIuE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXYGeQGq8x3KmcEx6J8-sWsOQTCb7hPoeeh99cP6r5yw&oe=6A6E0132"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bmRnBd5blkMQ7kNvwG-ntB5&_nc_oc=Adq9ZIafI_XfqtQQTQw6TyyJMG-RYgcEIjl5r05Fcc0TSHBVTWSXQYgob4TaJEhTwgg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDQSA2L2S8UyKQtpq8jL9Y955vhtRDAo1aPp6PapVjZNw&oe=6A6DDFB3"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gnSZcnks6XQQ7kNvwGydnTm&_nc_oc=Adqrz21ZSqmVYIrgL3q-Fpstzp_0etKkYW39j10FcMpYtVBgl-aeta0dXw77hV4JPQQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBBoIQ2TC4e2esNsTRebI01hf1T8dqDvsQv_zrvt5Gjcg&oe=6A6DDAF7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
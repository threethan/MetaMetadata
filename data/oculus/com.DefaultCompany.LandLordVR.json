903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zuSGE9EBqKwQ7kNvwGjKXni&_nc_oc=Adp867Y3DivfkEuTVo10j39P9e8lP2Wss5sKGL2jin4fmh4taZsgFpDqdsF_SQQ_FJM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFlAKA5SzuxDz49xq0__YZUEfkyi744HSKP90X5Mmb8A&oe=6A661FDB"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cFa67Ugn-JcQ7kNvwFa5bLZ&_nc_oc=AdoIZVgg6261BQSwJoD4RWHUpME4yPvPDXC3WaR7XW1q62o919rBnx8meCD90mcMLVM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD0YBG2pgTPW66-H9QPLI3FMEFZ2bBZuWZqWuAhLncaXQ&oe=6A660A38"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qaxkt7d7zdgQ7kNvwHbjfOu&_nc_oc=AdoS3NvEq0LFbWEYlfpjOp0sTIRzx7VTPeu0UUjm5hpp3YuEaO0qQFdFdHdml9Bo_oc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBBRPeQm13OFcqbZmst7J9C29b7lXnMbzESpMxIg9T2A&oe=6A661832"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JqysThZwK8UQ7kNvwEgdIaw&_nc_oc=Adr5X-Ek5W88sJTBg9UyEn0ozB3P8tSEiDGpywgu91wEfod3gABZTp8deqA1JbdRkZ4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDpX6puPFPGnz4pv7WYIFYBsFBE_TVVJaSofIxneawaEA&oe=6A65F6B3"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JWAsbZORXSsQ7kNvwGlmeKy&_nc_oc=AdoUg1_drwhdUO0KmDo1HJTXc47rpOzfWiBNeOQ1azOjBDUBX2CqYlDkAhwXZ0-gO0c&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDrF1aJSAKpzrE-g6BJoeEHikFaSSZYvmS9ZSifwOlaCQ&oe=6A65F1F7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
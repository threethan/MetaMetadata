903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NAgnHoFdZ4wQ7kNvwFtV048&_nc_oc=Ado4EuiVPehFHLFkkLWmABKAOUG8C7Y8FRFQ597a8XlJxsXtp7pEygfPGhFm9TPOa1U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGd6-Jp8jFRAqXxAYTELoEesVtcIitn-tNG-GOtnwdJAw&oe=6A75F1DB"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bYodQQ1rc84Q7kNvwEb1kVP&_nc_oc=AdpN7lG1_X4wbTu5z739JvH37xUBbArgdNJL0LIEYfclVA7eG4D8YGTqMKWnAHycCbc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEU3kxbG-bFk5MOjOe8hoI3OmNrUaNhiU1dIiG0cZWu4g&oe=6A75DC38"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6D6f1G7PZr8Q7kNvwGzwfMW&_nc_oc=AdoQJHUemGqD9YyiSw1V6f77L8UrcTSDBfC3xnnQmj367RMd_v_6Spd3k_uvQaTMe7E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGO80MuvK9iKF-TtXAEQPeDJq1ZR0Qz1nzOLL6BMethDQ&oe=6A75EA32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FjG-MJcDO_wQ7kNvwGi2ZU8&_nc_oc=AdoAmSdMybfUwM9rJmRc3laCHYmBqc0fqIxxxJYPFjZLXYIEre76kTlt1vzA8T1hcO0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_eSNOxDJamcFcH0T1S_jEP9nPGzUaaFsJP8rverIGbA&oe=6A75C8B3"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_C7bhEje_iwQ7kNvwGeKaMO&_nc_oc=AdqrUYLyOaHHiCzj6aU8QjNbuWNjp0YrfYIGbo9_M_D9-kaP338P509sHfFeJD3GY58&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE00DMOcu-CuFEUVfdPseqXH0rNWnQg3bthXS5FhEx3qg&oe=6A75C3F7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
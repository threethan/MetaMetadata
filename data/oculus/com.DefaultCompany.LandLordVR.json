4848_520432903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ur-En30fKaIQ7kNvwFqEuax&_nc_oc=AdpdVN24ciYq5x3WwTf1cImZAzZ-fiysgFJSdFmRFMR4y4N6j9X0Y1v_bSvOv-75cU0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBPDVpS_9W26GqlgCj4XdHYBSrZAQZQVXD53jvM63B4A&oe=6A8D749B"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gSyf4qRrWnkQ7kNvwFGEstw&_nc_oc=Ado0TAMTyBBv6Dnl5wNB157v95HEatTTVl3BZzc53SBy-yCFp5VWtCUVkaxcwXLVejI&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHq_FJ0Xqwn-wPp3Fuf3bG003fVWwNuObL_et2rrVTOHg&oe=6A8D9738"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=noAj1y1TLhoQ7kNvwH_PxeX&_nc_oc=Adrn-oHzTfNMcfuoojJOxB58_j5OrQQFvYT-jcGWspWhTquRRXe0veVA4-TW23U992Q&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHS6XF1y5cXAJ5H6244zBlU_qlRV_Acj2v9Jh7NBsKCag&oe=6A8D6CF2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=STD_pTpKCGcQ7kNvwEJDSlu&_nc_oc=AdpbjBVjlUoU62ERQ2sQHEcAiBHA2cWFJ3_38IjJqAk8QA_L2m4rXHpSzlAuJOhv6pw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGMck7KkNvhJZyn6kDRIHwEGL1QV9DsVd7bREHMtyiUQg&oe=6A8D83B3"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZIkk9yTx9P0Q7kNvwHFTMR5&_nc_oc=AdqhrDgauC0dbJc9uCMILkbhxKHCREOq8L_SvY2f_sAVN-qiTTwJktwFS-5WJ8zjWDw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEqXqKjblRcGPApCP8zi307O0d4evAvfwvEhs1YnWV8Lw&oe=6A8D7EF7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid":
903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UXDBUUpZrxYQ7kNvwFWk7CD&_nc_oc=AdrvHf0OS4ieXAENF4zp2otcRooFpe5WB9KV4m-BE8ATzu-1iEhPQm7CYulor57J78g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJAOGUG4oPB4xP_pZnEX8T0j-AfZ3CG0Mm0VOle590lg&oe=6AAFF3DB"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UOg3vWViLX8Q7kNvwGHKuim&_nc_oc=AdrBleA9ES9oJ6KIOdDrDUDeWKn4x7juauE2JsWUNzCHJwWmGhSOhHX1Gd--RLvGH04&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjhZWpV1-e-7iXT504_-HhPrANBXv7cjN5FS4VSgAtMw&oe=6AAFDE38"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=834P0Eb4ySoQ7kNvwH_9luw&_nc_oc=AdrueCvC74NPJaL_OsXXTc0UhZFR2C8KeqXhe8molyD_v1eAhIlw8ViF7eHV74e3YcU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLRy-Ih7q2pfYEAdy_X_P_gr8WgpotO5xVdQCvui68lVw&oe=6AAFEC32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5V4aRUv4MCcQ7kNvwEDCoN1&_nc_oc=AdqtOYJv_c3-0NTOUZGYNq5fxexKz0vD8OvcWDEDlHDFj2sIfCJmf94LNwfXqTK2oQA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL3qHEmEWbDzS5j5_DfpG0bib8hos-vpTtP3oC6G2bUBQ&oe=6AB002F3"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wTTQTeQZ4SUQ7kNvwGrMwk8&_nc_oc=AdoFgdvmoFWLkmJqG6TgX7rf5KR75qil9kmkxYkRuvXS80laIcifv9z7A4g0wjyU6vs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_RW1DC6LwNxwtqrd9ukjNPns7U5MQqtwsyftdFKO_8Q&oe=6AAFFE37"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
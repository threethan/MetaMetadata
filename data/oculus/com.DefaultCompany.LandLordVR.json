903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uUt2ashAOs4Q7kNvwFeTxxG&_nc_oc=AdrMLoeU2IAbXXhCvYoFv5WVFEjVpQ3LsUIq0tSDBZqwPUOwG3VV67dV3bdPaxExfKk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af07_lCToafvQO9FQPbCDg5vF1zYZfH7Hd-PnW7gliRcAA&oe=69DA60DB"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RHbMDSPKhugQ7kNvwHz17OH&_nc_oc=AdpSS5cnHNutELnV9xWDt8opLBwPuDGdP2kRGihKuoa_RgqxxvVuHZWS7y9XAXpNS-k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1w7T2hXyXd3SmYb9-_QiT40yZP9_DklvLLyKusSbq9Gg&oe=69DA4B38"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R4i4053kCxUQ7kNvwEmdrY5&_nc_oc=AdpwLdSQVpN5R14qws1JWpmh6aVswJ8Df3hkJ5ZCTW_zJavG_Q0egOAWb7358bOqCBg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1v319lTSFASs_E4HCW9TzwrSrqqN8L378YGAaDN0dJeQ&oe=69DA5932"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uz2vCP4LqUEQ7kNvwHjWdJa&_nc_oc=AdrAQKJy8woJBIEeK6SJdpdOduFc3enIggPuFSQW5KixPXu3rV_iLZ2hVx1StGC9x3o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af21ru2twujeSmr1eDn7EiFKNz2vNkUZ3DZdjWi1a5oOtA&oe=69DA37B3"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=adno6DEK-8wQ7kNvwHE97-J&_nc_oc=Adq8tiEsMP17DOVbXd2HMKfGscfBHH74DGFcqqIL69OOqZoT_bBsNkEKQbpwXezp3_E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3hPvovp5mprYmzYr94OFoO5e7cNnwZ-0PTvjX6oIYRcw&oe=69DA32F7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
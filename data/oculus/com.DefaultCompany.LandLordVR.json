903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wtBAdXG3eQgQ7kNvwGlznNd&_nc_oc=Adq8BOiFmA5WdpQ2hFXp5Rdstj6hRYQ2f_fFkzUX28fJoYjek96IsU306-sXRquIu-k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3CSAuUYnTneYSBOl-sbZyyDkWv-tj0xQ6d9-Lesi-ckQ&oe=69EA32DB"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R2YaRgTD0BUQ7kNvwEiVpiI&_nc_oc=AdqYtp4TBUNLtGXTfGcMSQiuPrNj8wbKFxPwWa79y3D9kieRUyBYJSfKbKJNJJ-8-TI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2X0vIBANcc0N_-sC3mIfDTis2GLstdJhU4RfPrhdSEzg&oe=69EA1D38"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=swar9wbkDvUQ7kNvwF84wNF&_nc_oc=Adq84GiXu5UNBJtT0I0D1i3OU7vw3NfpqB5FLCaV3DTyYoiLutjyaxKa0M5PKBi1GCg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af20BaDRRAkUXAeKNqfv6N_ViHtbC3GBHWhHnDMppwohVw&oe=69EA2B32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4muIV_wWHg4Q7kNvwGtTKPh&_nc_oc=AdqHiI1tlodtaqLIg1wL1N9X6YkTdXywwoVD8orMRiPltzVRGtJ_p2Sztp-9_-hx1As&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1U0Ngi8Cih4ERDNvex3hwZvhJsARFFKv_P0bMnovcFqw&oe=69EA09B3"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2i2d2mV9aT8Q7kNvwEmXTQQ&_nc_oc=AdqPGQSIzWm2jnZB1Dgr-IAGpGmT_h4G1rUhxzIVv2XO6kPwcccgNX-_0TBC4hxTt84&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2iRvYOnco7hZqmc-Lpi2FDPnbSBw3uHALPnUopyiJG0w&oe=69EA04F7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
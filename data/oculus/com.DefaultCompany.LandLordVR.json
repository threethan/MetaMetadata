903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SUuLws3qrzAQ7kNvwG6RcEt&_nc_oc=AdoJ5JbrX6tvcc582A_hlNOX1057i32ofrKAbjoWcBcHmJl0P3kd2V01W5LkWV0IMG8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP9mG8JIQNZe4Ddg6FrEE0yosGEBiTR9LU7k0wIiXIjjg&oe=6ACBA35B"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kvWUAhJvLxYQ7kNvwFuVyZN&_nc_oc=Adp2Vg7rU4Ex7CRm4ZhMRaPwJgH4CDC-MxS-srlH4mf5VT0985BFTSh2NB5aUzF0Ah0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMj3n4SUQUYfdWpj-H4ZT75Bj5q9E1nAVXv7Fi2aXW2zg&oe=6ACB8DB8"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DlnQhje4qp4Q7kNvwHw4mz7&_nc_oc=AdrYWWfNtgaCz3paPXoznt7biIimQ7Un6QW2J88xjVO-3C_XvmvcTBaPIWsPRQzsWvA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNAu47vE3zvyL4LHU9jF8Tw6BbVyJIKcXruuoztufP_yA&oe=6ACB9BB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rzOqVh9tlGAQ7kNvwHLnocz&_nc_oc=Adr0ORcfc5UBmlD8cs6ehLQHb6bZZvybO6bJH7rKDvt3SBb3xOja1kfEciPizODjUmU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNHyT0jgdSSrT6DR6vl0OJJdFn6W8rgygcysu8elVi73A&oe=6ACBB273"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BNaIwLjcdFcQ7kNvwH0Sdlw&_nc_oc=AdpuLdltW3eM8-qrjxnOlE3PM527SJIYuHUZ12YsXCeFFij5ykAsnqIM5GdGCo_Zbu4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPY1_uuY5tLitUCYHccAL9hbgELpDqJ4l1tBoprSlROdQ&oe=6ACBADB7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
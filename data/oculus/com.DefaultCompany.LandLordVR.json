903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ewuu2lt_r2gQ7kNvwEu-gqC&_nc_oc=AdrPW5ouZoV5Wgjj9fAyeuOYdZ80_tgXhjgBmzn4uWg6N-WRLtYX6ZW5iLXz3vv9kCA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3_sre_9NZCbfaemaDs-y7wgkPp3eHVAVXhqvMTYr6WAg&oe=69DB7A1B"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FwHSCNd4WZAQ7kNvwGKifOP&_nc_oc=AdpwHYjKmeQkzvjZI34UgD_Nj6aGsJWeChJ7kEhjOV5hOcVt7r040PNnrRmqPM5JmrI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1DM7ESLr7iQLaYXBYeTaJepsDnbWF3WBXiT1-clSnJsg&oe=69DB9CB8"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zjA3FDM-D_cQ7kNvwFRv9-f&_nc_oc=Ado_44ELcNFYJDGwhIPaA_CjK4aXGJsO80Eu70GgPLTi-w7Hj1dQhBiEcsBEQzVOork&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3DXaxxqH4Jp-VM_ShhQtRRC38aC6ylsP0HQCjo6By_8g&oe=69DBAAB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gc1Y8yay0RgQ7kNvwGt8Mtv&_nc_oc=AdoExMHo1FfdhSoB5o3BTIjqlzX57yv3OerMCx3v1f3sl9RkxDFVFak6wg0atfc5Nzk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1l0fTJXXopeMcuFTMbZqHMGYzjJFTulnFN04KKcqW9hw&oe=69DB8933"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=adno6DEK-8wQ7kNvwE8lztv&_nc_oc=Adpy6hCyEontKVW_PgS8hNVrm3YcnfQverbsfIkuUpE1QYtCnuQNe-z8DJLMOLxob-U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Ix1_SNjOB1Q4xfPR0silcc9ykclf1eGV5mYjlvIXMbg&oe=69DB8477"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
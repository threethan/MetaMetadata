903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NQX5kQMuINwQ7kNvwGTc2ND&_nc_oc=Adq5UNhFtX9o7tVuN52cfeIhY2pB-U5B3SV0ejhuu_pQ1yr7sGbOEO6Ha851lc1eWpA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHl4Wt9kZaIP7vNHa3k7AFhgy4GPaPQZxwUBr3vFW_TuA&oe=6A79E65B"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cUFOpoeKrg4Q7kNvwEH-zcU&_nc_oc=AdoJtmCYsFd49iaCaEHd3ZzNCGkps7q9WIgzQNJzUcKJS9SFRTlM2P9c8nlPU5uIvM8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFpj3JKyVtkez93l9tTokNSc2dL3xr-ImPSU3brO56qRw&oe=6A79D0B8"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hOx4reEzXwMQ7kNvwHfk16T&_nc_oc=AdqIGyMipZdwutBlKEyXMohCxXefuYtVSYgei6cp1TC1Xhn3phHKXgTGsTAN6N7wDT8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSjp8X07hWLVGMBcEKRb_t7bdvD30vFCfA6B7J8gHZyA&oe=6A79DEB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x4Hl5Im-OgMQ7kNvwHy4Ckv&_nc_oc=Adp31AAgJmIl-uEt2HhKrAdHgFVwWoxVqERPACYrDMvnHIzd_cN1CGfrD7D1mdRtH0k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7-_B3W43qngHpBBq3nmVqe3gk7jFmLqOuZSw2gpfVvw&oe=6A79BD33"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MJsaR5CydPIQ7kNvwEqjRHV&_nc_oc=AdpaZYI1wEd-6sOrxr9ZDfyfr67Zc2tJyBQh2CQpVxHkPAaqFpos3IuNCMlZB9550ig&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVQd8-PsR-kvOmiiPYuJ3zSMhB9fPCxEMP6KLejsW6Xg&oe=6A79B877"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
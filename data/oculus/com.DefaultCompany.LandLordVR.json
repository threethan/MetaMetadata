903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fO8PvNIHls8Q7kNvwHEYOiE&_nc_oc=AdoU70pGcTvD2IADRUZ-p8j5U-irCw_6vGgMb4NSMN-0JyT5urf4oF6sFbhMB0mLKv0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyZh1uykYejlgUqpfFmyqySNkdmav1xVcVO6Riy1A4p-Q&oe=69CA8EDB"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=osZ-ai5j55oQ7kNvwH4bsWs&_nc_oc=AdrIWnExHdJ9VKMpInml4ZC_C7Ff4WGXr4Ec8Hhc2Jmo6gUqYN3TY01qStpQe3ciSv4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz_V4yo5wxDrn0TqMotWob9gYFs8uytYzBh1bEU-v_gyw&oe=69CA7938"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XtwzaP4l2A0Q7kNvwHliAZh&_nc_oc=AdpxYWUQZVkkynjctuFcY5jULb8iVHlmHgVhMgTaDqO2leNtbTgMe26r4l2eYyrsTt4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwbHYiR5s1BgSsLzb5tMVWliSx333CzVVdTBo95n5mlTw&oe=69CA8732"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pd7L94RTFRAQ7kNvwGXPPhg&_nc_oc=AdoU3s-YYFZfKLLijK8uIv03yJsipSNCJ5EfEUxSsm6aFXqFDtYhLAwKg18CrE0PWmY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzso45YCH-5h15f6Vfv36IQqb0-NVmnDzs4BhbDATRJ1g&oe=69CA65B3"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rkLOG0GfDzUQ7kNvwEEf49G&_nc_oc=AdprPBhSaLAT3ruYhB8ONmnlecR63eFc9KS28MZ9hS3Y4_JICKPmZpXAV2-EFNWu-_c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxeFdCnjS3Ix8jqMH2GXfoSEXAhqrG3kFQ_w5QNmDL10Q&oe=69CA60F7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qfbdCY6HWNsQ7kNvwGr297C&_nc_oc=AdrnsZ_9f14fstB_hvnSJk5v4QBFWX5Si7hWAIG63WtUG4ZMSftj8QhgeHhl4mRcKDM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBLhPgEmUIgE-0D-2IwQ3NJr5f3ALM-pPD7XZECJEsJDw&oe=6A5107DB"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KE44lY16vGYQ7kNvwEUimtj&_nc_oc=AdqFvkVXHqHq3__Zpb_jHETZcDxKyD8_bEbcRVsBfOkRJofQB7GUXPRxfkga3QU69Xo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAnidarf5V05B2ONEN2uNZ7F8MUx9Zf9h6QcfyLejZTFQ&oe=6A50F238"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xoB8xEl_chMQ7kNvwG3BBt-&_nc_oc=Adq73yHN5ye7kdgBG10JWIKNpVHmr67TQeLtf2SQ2OEVBkzeGRchH2dTYEsrbb-h_Yw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBGVmlqmkzsR-pOiOcsEeOh4lVZkp54c79Bhm6rMCUkWQ&oe=6A510032"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5eYHpRklEYsQ7kNvwHFNDEW&_nc_oc=Adq43IpF6cP4UoIPTnoOtwoLQ3_0_33esw98O83oUD6sOrtiiPmQAVZFiQV7cvvJOiw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQASnjUNALyuQJTc6EBNNguOAJZr9IjGQ-9Jv_JS62XRSA&oe=6A5116F3"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VWxVMw_E8woQ7kNvwGaVpZ6&_nc_oc=Adpd8E_8d3u4-hUD3xyYnQgtxO8s52fR0vHpCeGE1nTWR-7bdrCp8e52fnAwfuJLBtM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCcHHA0qfwk1yaoM9Ycsyi0CqQ0LZonp_y7B2PTf41pfw&oe=6A511237"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
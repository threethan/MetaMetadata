4848_520432903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ur-En30fKaIQ7kNvwFzhyo8&_nc_oc=AdrDhEEEFGDNiGny489x5SNNVAz5zKMdogm56WY7CYJFUT4xUnLXipW4sSjxyKnprMI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGOnSBSPJsRGqdvd3HO7ff-0oDxVawvhgXgqCpvg1UajQ&oe=6A8EC61B"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gSyf4qRrWnkQ7kNvwHAmFHi&_nc_oc=Adp5jqnXoTDTE-Q7T1qE7zFoEIrkE_EtVZio1BcvxvFtv5odcDJeBYgGO3I6xstwpUU&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEzwVMwEKuAiVm_ioZtWLOQ7nHWsrw7x58Z5fIJVDkxAQ&oe=6A8EE8B8"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=noAj1y1TLhoQ7kNvwEiE6sV&_nc_oc=AdoaqgM1AllT2wPjl11QQwy2Ahitp-D5m2op3hciPFUn7ngndIQ3OArDexdsGpk6er4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH1rq2zvjl-vpe_7jiZBjR_WsWuK5G7SFKmAGdorjuS3Q&oe=6A8EF6B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=STD_pTpKCGcQ7kNvwGbimcH&_nc_oc=AdrAURO1lvccJoxPvuf_mLN7tXuDfkD7OShQQVGMiD_3ntkvhnjQoZfu6mbt_7fUkXI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFwRtgJAC4Sz4wzWYkf1yy_rld7rVXMqPRpzxMKEzvKnQ&oe=6A8ED533"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=COGJEviHWp0Q7kNvwGH6kZm&_nc_oc=Ado7ftEAvhLdzjFLPiDP-C_W-ocHrwXmw1A7kI4Op8q1jV6AIiISgzYvwHhetaGNYsc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG2vBIfZ7nk2Nz30aZ0UkP0DOZYMyOKe-PgJ383xOXRZw&oe=6A8ED077"}, "is_concept": false, "is_test": false, "is_trial_offer_valid":
903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xkb81ouJ58sQ7kNvwFyO0CB&_nc_oc=Adr41OU1EdgZnA0NO9Kqm0AvS0BlF7BYrCFDyxoWeR-bD28Fw__0q__VXYWR8rBIauk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBxbKp0OhPkSP1LNZGxgAF2Q4Du7D12ukqqqcm_sntKSg&oe=6A637CDB"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dWwOhoGtzP0Q7kNvwH5phRs&_nc_oc=AdqEcypJur_5ny99LIL31Ao1l0Maf6izc5zZc1DvXTBSmmJdQLME3DODqHNkAEUAyIc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDra3y3aXYkpq3WmP3yu9Y0DcrNWQyce5h1wpyxDeuLrg&oe=6A636738"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qCveJHlPkSsQ7kNvwGWRO3_&_nc_oc=Adq23nh96q5Kb-28l-8MW7kVVHUK-5VAlAiDlgi6ar--5z-3n0OLk7JQn-BqtXKHThY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCRvfT6M0o1wH_E2uT1oy9mo1FieF2zTnqTm2PGPZlK-w&oe=6A637532"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tyu1xCXZ-ZoQ7kNvwHnaj_V&_nc_oc=AdrAL52-R7fOYEu8odGbn-m4gPM08VHU3bxusZuWImTCzjHJPq6S5NLO24Vean-iRro&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCexdwRz8AaYNj-nOckpJtZzpWrgFRc61u_shlQeBOKvg&oe=6A6353B3"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JWAsbZORXSsQ7kNvwFVDC3m&_nc_oc=AdrNBpJhzRxsmtbr8NAxCa9eJwn91u-nt_9OE9qUv85vVZTfOWYukmlMQrWgh_UBWto&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB1wPHGUibn1ruHeugfX0mZzqLZDfjkti3bSDwHs_Fypw&oe=6A638737"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K85SoDrv74MQ7kNvwEoER7i&_nc_oc=AdpvsgnuN2FCrhEw3SL3BIr8n5bKE3S64A0I3ZEWqaaX5GyllL_d-PtlSBbKM_puGsE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEjwt-rjtY1Anfk4b02HBoas6fetHsgdgrrpflRE7iixg&oe=6A734EDB"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wz44947vbUgQ7kNvwFtIjez&_nc_oc=AdpREsRLWKh3bYTSVqQOaVMnEotfaay83XLA4ShVH4uRcc774mAKvHYj3eSJaAU5xRQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGt0at_9yn9wxnQVbJRAILWimb4T1Bn43Qh9C7lLhh78A&oe=6A733938"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HojmoBFdP8UQ7kNvwHZASVn&_nc_oc=AdrlVlS30iFGFCPXxiqlVM3eXl8Xf2hsQknUzSs-aiSmpPRZXeEqFKbMnbdAo3QcM5Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEK5GOJJz_Ufdu2EcjzXvd_ZeX-WinLTnh2RefGzt-T2w&oe=6A734732"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zv2k1BPYXcYQ7kNvwG0uiMg&_nc_oc=AdqOxIhKzYaGJBmng-H4pu01n5XrnTsrKr02nLQThCgykfWAFmJsxg-_fKy4qsKZbOM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4fBAnF4eBVtOigcIv5hA9E1qWGRyaUXJlDQQ6SH0SeQ&oe=6A7325B3"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_C7bhEje_iwQ7kNvwF_5XfF&_nc_oc=AdoQi6jMqONqe0lLkPjEPeiBADSw_ZAbWf1syucu2PSr4vQbxUJiS9wz7epp1GltJi4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5sUshJ3k7jZPWhAZGGziO0fT13Lm6bvw1jZooIFBatA&oe=6A7320F7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
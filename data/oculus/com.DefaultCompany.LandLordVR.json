903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iZx6ydlIAFwQ7kNvwEAVBKS&_nc_oc=AdpvrHjb2ce5HBBXiIk5xfBqKamoGS8-E6lSjsP9RkW9ZL_rtZfJCeiIEm1dCrCOZow&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8M9vMjLkO_WLKedpa7z8bZ_1V36odF8VuAWppBoVXmSQ&oe=6A25865B"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yWOs22z7wmgQ7kNvwH1gc3O&_nc_oc=AdrUrFS2B9BZreGPoBONqh66nWIFz4TLeGm5vTB2OW4uTXkicUU8ebCc62wiifbWzKs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8F5e_lr43H1OWV_t81jtZWVPrTGq-1eoaJzu_3OjzJDg&oe=6A2570B8"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9UFnu5mrbpsQ7kNvwFaUFJL&_nc_oc=AdpVc2UjP7UA1g7bcaRRmAUROzbJ2x6pnk3iLfw6PuDWu682HAHnY-g0mbzojY7qHAc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9df80baxYwI_fhtfdtpT_0g8j3g_1KEmBqaZ3HeVdstw&oe=6A257EB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uWppsCfZMfcQ7kNvwGZyBbW&_nc_oc=Adp-R8Yg34b2mafg8cXLr06G6WjOgTgXpWOBaD0Lhhrg9X_Xq0qM-WjDCDji4py9jB0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_LhT8x2g3K2Bg1jfZ8OHh5TygnZcexvInyG3x_-nKDXw&oe=6A259573"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tk9VN-12g9YQ7kNvwFc-a3B&_nc_oc=Adq4K7DIEvqXBItcnZirlNWa3XBbOsYUlDxThg7pTXzEJaoN9RIdhvgCmdwEOjE_D5I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XzhBVocXDfmpyognHotGJYUgfenhbuV6A2FReHtj_BA&oe=6A2590B7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5SNlg3gmnA8Q7kNvwGo5s7v&_nc_oc=Adpc1wwubTp7C_W5PygGCNWH-iqXaZSPz4ENLyx8R2wlDIoPfdoR4Dj5keGhwiBuH0o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAryPwx6BiBs2oMA9hzxrPsnjTwS09hynXy1Ai3GOgdGA&oe=6A6CB75B"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jpHZNkxCrdcQ7kNvwFN4Rmf&_nc_oc=AdrnpMghHzRDCAZ5Kicd7tBoDOUwdGLbXGiozTqLKozvC2xhVzn0ATYrZ04Q0hFh1YA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAK7qUZMK8omXeebLO7Wm-HJQxtHIM-acne81_gt5EMOA&oe=6A6CA1B8"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DLG7GZXmewUQ7kNvwH5STBS&_nc_oc=AdorvymAvpX0LJaFFpZ6tnZW7GlMF4fDrtFEHVpJQniaguSP81DBvSVvNYjiaAE3dmU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZ6UC8JqJgSn6XEZSuiezQxglJ9z_1ao5yvQkJhMso0w&oe=6A6CAFB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uIzUhh6jiloQ7kNvwFXHFDa&_nc_oc=AdpFWmg60i1AzOran_-y3vnTDnJ9ZaemWuIgmYw1hPYfly1IQxHmpi2e_boP4E4urdc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBeE3EgE7weW8ptSJqvczw8JmuoW8TLTmzZJsStdOA0AA&oe=6A6C8E33"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gnSZcnks6XQQ7kNvwE2KLWP&_nc_oc=Ado87gwrD0UKFQ-crSnADoK2b6u2LseOQOQwXB5me_vDrGRvDjaO7hR1noMKjxF3jEc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCK8s9obBx4kVvz9j8YkQ6o5j0m2gN-7wtDIEOmlcPWkw&oe=6A6CC1B7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wa--rEofmyYQ7kNvwHCfNg-&_nc_oc=Adqa_OPopORbtPi1ZAl5hhRFqpUddYmNqvL8-wa5gngSV4MzD6-szKb7AU8ONZl_hco&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNPRnviwafWtIwPj3mg8XOa3CQOdHCowwBZArBj0O9oeg&oe=6AC3BA5B"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OCIG_Unr8mIQ7kNvwG7HKo5&_nc_oc=AdqWiurUYemjRFoTybyXc5tkiByolqQyD9zMkxTRAB3T_ufXdxckaqS44EYykY4zfqE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMiFhYamUsx64L0FR01ltdP1DCo0dlNg5rakVGz-fW4UQ&oe=6AC3A4B8"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uRAQ9W4VdGoQ7kNvwGdaC9G&_nc_oc=AdqqmeH_IXHkNu80_ImTQNpx2UT5KmXzSuOAAtXCq5thWpVD8HszDoBCI9qY6z6PaM4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3SIgsroMTu2W09HrAvpqy2PPX8rrshUtzM5pc-Qgq8w&oe=6AC3B2B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K7dp4mKSMvAQ7kNvwE23uRk&_nc_oc=Adp6S2gPS5rtntatWgylHsxJoZRgeU0clbfbgr_bxuDl4m1LadIUQfTrKiQWfKZ4ToE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZBDaG6kM1IcbzkFBUdIrh4Cu6QJvV5Gi7Gktj4fDBSg&oe=6AC3C973"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aV9Z2yaJvOoQ7kNvwF8MTDx&_nc_oc=AdqGd-9wKSxOg46QOEOUSckUa5UiyfGGUibp-tg3IShV-rCeNoJdekqxzUYF71Y7jd8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN-p982AfL87ulGcV0o9M9QrVQ4xe8t8WV8wdjStFiO9A&oe=6AC3C4B7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
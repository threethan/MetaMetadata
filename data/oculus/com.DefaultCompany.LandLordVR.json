903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wtBAdXG3eQgQ7kNvwFe3Cin&_nc_oc=AdoBtSK0Fg8B7SOboF4WPcJ6BwWdkjuGcekN7hURkzLtT_zN5N29JAQKoRXoO3XqK6U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af07RWQLVizI-9NMps9cYPWnugNfdQiYhk7_zlGcRUvByg&oe=69E8A91B"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aeG2gLdR6gQQ7kNvwHHQsqe&_nc_oc=AdpvAf1GDUIFfveBOwgrZbtBBI6JRU7v7B4-i5JtK3NGAFLkPrNuYGUA6JY6CdIk5hU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3B3ptzmqN-w14A3-jwmIFmtSB7qIuBNrXU8_rZy2XzVQ&oe=69E8CBB8"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=swar9wbkDvUQ7kNvwGq1_ZD&_nc_oc=Adrf9nTVJWjTxySvNr7cU4517AH-zMkVSiJ0yMTos1zrkHEIApXssB1UyILKKsRsu2o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2M-knxPVpMR-APJkpqzyzjQEUYEFK98SccaULLEYcX7A&oe=69E8D9B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4muIV_wWHg4Q7kNvwFshJ9m&_nc_oc=Adq1zkc2Cb91ssg7Y8KJmNCW8nKNk4wukTwkEbGYMJ8xLi6Ke5yFEUr6ztXpCgJnCqw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0uh0qVTN4kQV1TiXeHBC5DYq9F8bHVz0cZAC56Dsb8mA&oe=69E8B833"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2i2d2mV9aT8Q7kNvwEYJe_8&_nc_oc=Adq0GmR6HJ_dsPhY4BhhE0bFJldVFBvzQpFUh49HzH18ACFHlANUAPvFEm-LW3YaQhg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0-9VNWrLpdsip6boxYrNmT0YbWuJ4roOS8FPROZI0EQQ&oe=69E8B377"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
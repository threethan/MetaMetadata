903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qIuDi42zxOIQ7kNvwFPXt50&_nc_oc=Adr35h7yiINllGPrJfffQXpcKe45XdUHgbGanNpYbbzo_gbFH_X1jVqDmsUfDm62duk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_xmH_ZXA4vwL_Lc5IOJsDmLD6QujspvATHwRU00bp72w&oe=6A2D6F5B"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1qJq8AwynKgQ7kNvwEKp5do&_nc_oc=AdrBTBsuKHVBDgz3hf4W4-W7orXqQDv3nfZm7mhLKB_JGYPoIrwELbME2SWrgDa_Kfk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_t2aF_HztnOYf30y_v10O7DRlHgurCki38RWxqgxECA&oe=6A2D59B8"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=olh7774NAycQ7kNvwHpt8hi&_nc_oc=AdrujFfIUiy8lRk8KvnGuPn868QKEWbwUZEcP6xXzFvgHIv5Hv6F2d55Wl6jiJFfYIg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YZGO0JhKVYRbQkFQqi5XQ6W1fbmgUVxGk0yv4maUsLw&oe=6A2D67B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3YrEXxU9v3oQ7kNvwE6uW-p&_nc_oc=AdoWGtwIAS_Xc8jx0g7xnlckI4inEgWkiyCmbL-303-vrDr_TTg5R5btbVy2Y57WNjE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wSMsggLBUp6ExCILiAU-goSURwkzL6GXeICn7QhNTtg&oe=6A2D4633"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LvukLHSV5RYQ7kNvwFGtAyq&_nc_oc=AdqIOc-iyOJ4y00Z6RJ2EkGfLZNO3bRsPtCqAn7GdvcSPZRQSBX7IxX0soub4eIQY3E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_gZ5rEq4hApZg3muEye4w7vqlZg3QrC6lnj7dQHZ2NDg&oe=6A2D79B7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
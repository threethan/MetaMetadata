903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zhWhHC1CAakQ7kNvwEqUOlN&_nc_oc=AdrfLqxmaZHYwC3y6N_Q2_BHtiOCA_vgLvr8i-53U8-4kIw3ELd-tIGHLWVHUIGo1PY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4P3bW1n59GmROMSS11UnP4oouIbdTjfmEsMzG5v7Bo4Q&oe=6A0B285B"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ABPW8RKvJXUQ7kNvwGtz95L&_nc_oc=AdqeIV5Y7xWrSxiz2BnNAHGb5VzGpW5tlyDDijonSleF4Axf3KxMiRE_rJBvOp1prMg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7LZ5EM1VYDCn3lojVAn6xXyQvPupNy7z3cdaBmyf1w4A&oe=6A0B12B8"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GyeSwsil73cQ7kNvwGkE4g0&_nc_oc=AdrG3sM7vOPTLFmT93GQ5ZFDRwL30cC6o-ks5LcAs3i9EEdoJU3T85ooYxosAiU4gIo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6yVh87oOMLTLudJ4-PmxwDLyfiRgbbAbTbleJ8ZBKrKw&oe=6A0B20B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jqdRwbhfW1QQ7kNvwEuY-MK&_nc_oc=Ado-MXz3PxU5-pYdhXHjo4nJOn1o4siRJ_gRQ6anj1Mm9eGtbJEM5bFSsnANWd6Z79Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7tOdV85nAFCJtiW4yn2lUw_E-BnBu4QJy5RwlH45LNhQ&oe=6A0B3773"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tw2dTPeDYcgQ7kNvwH0-MvU&_nc_oc=AdrYAuDV7lDiIvwb4cR84AOfZujQGUnGuKVF7y6Vc204pEq_CQwoJdjAA6O2y3-CKvk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5OA3uD_Hit5W6IR3f92iK08onny7j7gKNJg_AXgHhAhg&oe=6A0B32B7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
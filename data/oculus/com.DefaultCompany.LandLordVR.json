903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zhWhHC1CAakQ7kNvwFqn_mB&_nc_oc=AdpZGsC9UC68eaWC_espLve3i8iPnm5v4QL1gnaSMVZDnZYvcD8Qa8X2a3HCM_PZE-o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WdVCqvte7yNqnGhBGU4KrWFu2VoWnP5DVWU3lT6D_Gw&oe=6A0DCB5B"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0CFNVLHiPlEQ7kNvwF4FVdq&_nc_oc=AdrFtF4A3AC78Y2zSEjp9TvgvzoxV_5tT_DhdPW8YtGyWS52R3X_e2sMn5NzdnltTWs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6rZ58anTBGX0bftNm_P0f-CTpGzP3Tcik_fs6lf6IHgQ&oe=6A0DB5B8"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GyeSwsil73cQ7kNvwF2TJrB&_nc_oc=AdoRspbWq9YslOYOu2MFeOcEipnxU1q8DMjZ3pITk5LECXj0RsQmglUqShNryCmluHY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4CXrQTgJdpl1I1eFC1xnzn7J8v828ktlJ3NhTqRn3J7Q&oe=6A0DC3B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jqdRwbhfW1QQ7kNvwEpuZ36&_nc_oc=AdqbRwO_pR6Eodnu6mIjX0Mo8bGtBgBHbwi87999a04-W0l6rZk3IzY8cmcHcfYpV-0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7X75OfJd7OUlAIdaA8us84rVk4tc1fSs3zo8oYM6LYlg&oe=6A0DA233"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n-_Pzcge3j0Q7kNvwFZt8nq&_nc_oc=AdqqGEF2sajMNifR0LKcYT5Q4dCUKnVWoXCfRYhejfF7eOS2ok-x7XYKf5_q1uF1iis&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vJu0OE-1LcG222h0ZI3QMOLy1TiUF_BlrJSwZp9l5Og&oe=6A0DD5B7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
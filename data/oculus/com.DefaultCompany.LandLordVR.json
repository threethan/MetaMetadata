903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_spVw6RVblAQ7kNvwGGIguK&_nc_oc=Ado4k3w8ftt3JKqoqvayXarwaKZ-F9F3T8eCELbNhYgkpTv2lPS6SwMpSuf77DOWHqU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-U_50xfJ2vwuYDCaKAWcTPpt55i8B3-hKSeJpg_uFbQ&oe=6A05E25B"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pBJEU8E_x2EQ7kNvwE0mDwP&_nc_oc=Adqbrr6WKEmdpnmM1PsUCEaDNInqWDPwc4MGNZXpqlVDi8AGNHIPXkkCtx3H8grmwQw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4IhK4Zxyai6URw9C0K4yJr9Is8rJI_tPtXsI2LC_657A&oe=6A05CCB8"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X6ODC4605uwQ7kNvwEu6qJX&_nc_oc=AdpMzOCL_HeF4rcSBfMTcltYh0ItdJMV1vDMP1t5umIwZnSdW0rQYqxbYLqZR36Ovho&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6tGFjYIGZqvdk6y8dzGm-WyxTV4gYmkld_Doc_n_s_Ig&oe=6A05DAB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cCm-Tpnb8UUQ7kNvwEjBN6q&_nc_oc=AdpwikQm6T0yElL9Q8U-YE2hoBq01ia8YsQEgb4I34W_vyJ3yopOyPbd0Z-63ZfwADY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7vnfc1cwL_nuiP7d8V5ek97shGK3LluYyopqsdoYFMlA&oe=6A05F173"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9tvu2_y8waQQ7kNvwFfmLMt&_nc_oc=AdqwLx5IFf0ldViRv8jN_Yll3PVCm1bUNwlSvPnoj70QZFvlLkvQ4HMuAixi-mAX2do&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5apTJ7utPHnO70-J02AMrbVIsr4DAhi1Mg3jYTZsX5Yg&oe=6A05ECB7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
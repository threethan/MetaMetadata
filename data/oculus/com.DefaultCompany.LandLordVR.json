903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ZSWGN5ySGoQ7kNvwHSkXig&_nc_oc=AdpjyfPwx4F-qH-o-pXuBAnkTMgOLFS3xao06hZxtBAXL9jL7d60wpa7JFk2humMKgw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af30sZWdAqkUXBnh3xgggcmzQWYH3v_Tg7xLB9DqMCjkxw&oe=69EF78DB"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bkpI106it1YQ7kNvwExtH1s&_nc_oc=AdrBVkcsma0BHvjoe0dvUDwEVr2AvxM-aaAXEgea7SlR2ch_k1bur1NnH-zQx0UM_aA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1FaulTgurFek7oIZD2PQrVreS2trDmDeNs-zGI_a0EQg&oe=69EF6338"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8WCYH8isoR0Q7kNvwGcmS4v&_nc_oc=AdpALdpZ0y5VXXya5DD0ejz1FPA1imKUxGYbFMooh4Knz7LdK4BOUmUYKuS1kXhEg0w&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0YFTqSMByk_fdBEJG-R0VntxapDjDLxsQCUzrdi1BguA&oe=69EF7132"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v_jH6NNh4CwQ7kNvwGBvgxJ&_nc_oc=AdqLT2wRgCBYAMgLnx9kBgkar39U-iTrjUy2KPYhxGVZk9anmuHfgNagCwCjm6D8jeA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2koZzkns26fhs7braqN137LoxafQ3QsfeaURN3-Qwdog&oe=69EF4FB3"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gMLfDH9UAO8Q7kNvwHahPnf&_nc_oc=Ado9dVGCfqMG55jZEE6BnFXT0L6HZ_hhGTkwqn0wTz0CtAnJwUvwWcAca1_CCxfgSMU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1ag0gQn73Z9wzXVKUytEwJ7q6qyFSw9ljCXYGvh69a1Q&oe=69EF4AF7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qfbdCY6HWNsQ7kNvwHDOv6V&_nc_oc=Adpt29AmbO-RlqjNfImWTbnJ52bCoiwFL6G9Obkg5VTBrrZCMfIut4G7CfuDcQ9mAPE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDmMmt32hTV7CMFRvxCZ3upnKC430rzyJhm9fu1HL7c5Q&oe=6A4E64DB"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Z5QXA30lgAQ7kNvwG4_Nxs&_nc_oc=AdrvpmIHq2HLjcdaaEBJt5t9hXKOG5Uqb0l7niNSnurpR1FnJKbMzwmzbLyhrxDbQ6c&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQApK_ywZucnj_SwNg8cII4JhVP25w9lCJ49KhNpJ3Cn_A&oe=6A4E4F38"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xoB8xEl_chMQ7kNvwERURgM&_nc_oc=AdoUG-lQveTOLbkrTmNAlSA_1gbM1sL13PZnDNytffhiuYfIZhqfRdfoRa7I_Te8Y4I&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC9xq2z6RgXFIqeDA5FjGonGBv28E9IQqHshwsY50DYZw&oe=6A4E5D32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5eYHpRklEYsQ7kNvwHIeWC5&_nc_oc=AdrOlATINVboBILkwtSnDf5SwWjWi3_KeS3FJFUDJHauAIYZi612nlntMdJMzZ3mRKU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwTNjJ4aKgBbeIKmMtgkQhbk-VAcH5rjh5pAjgfQaEKg&oe=6A4E3BB3"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eSxhmuvhqKQQ7kNvwHyj0XH&_nc_oc=Ado23FGAgkCPkq8yzTjvo5BDiRh4NbA-JbDPHncsXqig3So6Lgq-jukTdJt_lWpwIa0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCyp6tN-PHKBJpoaec0xMVY7a6S0MO4U6uINVvZNFz_Lw&oe=6A4E6F37"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=24kpit0f_DkQ7kNvwG8xIk8&_nc_oc=Adqw7A_3UrZmWbEsGnN4x63ccVxf2dI8ZLz8XcFBgskAKkJHeYIx0VbRK2aPTPqGbSg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6bE-m7DHLQl6AbBDahiAFPMs5zxLu7GZQU9TPl1KZHsg&oe=6A01EDDB"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eIfAff9gpGEQ7kNvwE8WWK5&_nc_oc=Ado1dmLOwAUMCCZ38EyMEFZsGdH9ifJO4aP-6yYoaQEZYcywmwNZwA0h6PAaz3e3L2E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af63O0fLaxaibVn4HSLk1dZ267IeilymJ03GiqTLchLv-g&oe=6A01D838"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mkoQ6RaxTT4Q7kNvwFcTWSs&_nc_oc=AdqG-DBJzEB0x2ZYxp6STHyGlsj-BxFhzyi98Q0KVF_AOuMM132kvl7rBT9ckmikda0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WEywoeyFJHIgvvB4vMaEbzKfYUcL5S5EwGQFqgpWb7w&oe=6A01E632"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a5idAQj3_FkQ7kNvwG2cC6C&_nc_oc=Adr519Gi5JSamc0J8tHbWynUDLZXnH_4jDZOpPtw-z1gO7ISFjxm70KpAmyA5oQsZKk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5LXCS9fMdUDweryVstG46AxFEyd2xnmDVlSvIIP0gZyg&oe=6A01C4B3"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nGFWYwh4Ri0Q7kNvwGriBq9&_nc_oc=Adp34TPvChpykH0m16rey3GJw_Bnyqdc0JOp39c1DrB9KyDBcb2gJnHbHNX67S5c3M4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6rk-pSAKUzlbnOadBgh2WNnszYoq1Eew4iEcWPBrHYtg&oe=6A01BFF7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
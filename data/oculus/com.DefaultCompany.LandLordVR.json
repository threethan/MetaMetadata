903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=24kpit0f_DkQ7kNvwGZj_ax&_nc_oc=Adrd8VY578-iH-DhiPjBOyxC-PMtbZKFFdeTOYzaMMLE9k7wUXjPrARZcdVBJke_KSU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af685pc2uZzv1sFvUBn8ag1B6YHaf3A_JUArcBoAXca2nw&oe=69FF4ADB"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M5YtIEgl1HwQ7kNvwHd8oH7&_nc_oc=Adou4FXuvlxQDPZfQWF0ju_elAlGG04zpDPoPZlITklpzjgRgKg558vRRD4AzCmtisU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6oMMaj81s9vrpr8i0DkDzCfyhSt3HPjDFhSUD8HDy5jw&oe=69FF3538"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mkoQ6RaxTT4Q7kNvwG4UwYp&_nc_oc=Adqo-5EEn4W8OmIVlGjKHElWx8gXzhehH1YS9yKvmb3Cpijp-1aLHqVlI_42fsEFEF8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5p6Id5b2quThT2D05Ma1wzk1YjbCjRj7W_leKkBDlYMQ&oe=69FF4332"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a5idAQj3_FkQ7kNvwGZL9_2&_nc_oc=Adqawt4a6hxGuvnJ4NnLe3TvDmhQjx55jT5iz9nxSbcuTu6UoftW1nHK3Nz0ZGC1EFc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5C8qOa5mKZGNvKYSErrRJMXY0i98uu6jveYjGmnLekWA&oe=69FF21B3"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Su5SLSpBQtcQ7kNvwGxZxJN&_nc_oc=AdoO9Dcs7tFfqnFEpeaiysJqLEXONwqa0fMEQbahDRoxfzXovAN6EGWrMLY3WQwEI4k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6VthgkDwi66ltsVT-KGX3sRReuc94U2Nas0QlegkGRfA&oe=69FF1CF7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
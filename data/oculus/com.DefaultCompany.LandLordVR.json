903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NAgnHoFdZ4wQ7kNvwHe2NCp&_nc_oc=AdrhJrh6AL_V0J5AfEX9ehv7tbrNv_4Yaae83xRBQX6oRF34x5WIprlxdj4kNg35TYE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWsgPtFaSN4hhKBRxizG506NcwTirs8Cass-UVwz_rng&oe=6A7894DB"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bYodQQ1rc84Q7kNvwFFcs6X&_nc_oc=AdrncvT2ej4SCsrY8rXhLrLxzMqWQmAWt0tVBr0E-5Z4ToAQOo8sGUdHTs4AjXuU3KY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjyP4j1PFER_Kb_hvMD26bup0jJV-soHct_AIvL8NWVQ&oe=6A787F38"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6D6f1G7PZr8Q7kNvwH9pYgh&_nc_oc=Adp_3qNXFqckBm9ql8ucu_o4kV8L0fSt2_BbUJiEVoZLTAiwGbuVybUVkboGm7eXnPw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQ8JaN5voa20EaZ5eMmp0XRjAWXt_scGRTN6sNzd4mfQ&oe=6A788D32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FjG-MJcDO_wQ7kNvwFwcim7&_nc_oc=AdrPowA_JLGD-v-fxGh8BkW88R_zsccxbB5oqxMDwXDccEW9UevWdIn7AgySS1A9XcQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPPOVCxUtYlPd1GhVx3k6RVZqluDPzq1h2vyOJZ69RmQ&oe=6A786BB3"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MJsaR5CydPIQ7kNvwGUzcD3&_nc_oc=AdpPjramNdmZ5Wc5JsyrFO-79kWvhQZUJc4-SpkpEAtrWJ_ggCwnKxqMN09LmoeM_YE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmb2YJVy9uiKnP7fjc8Gtl_C2SzeqSSbLuu5EtdxaE5w&oe=6A7866F7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VVnrg5gCGN0Q7kNvwEVWNYL&_nc_oc=AdqmRKAzSdaLThxiMwb0yEeSOLUa8qma_X7jScCValu7Wi6lyZF-7zbK5PsSPPed-X0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAvGZBrZaV2NlxDC1d_sp9aYiDSYt-GzQj13BpPFQBlCg&oe=6A491EDB"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AkBS5YseLvsQ7kNvwFEDuhH&_nc_oc=AdpoweGyvD0TkLpBe_IvOBCO8b492iNsGIeYsOv3jodUKjAG-xcJK8a2p3yzMmF-sq4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDcuTzIcdeMa4f_-6IV0kn5HTcg1Nn2Mqqc1WrXGUnMog&oe=6A490938"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-pHjFYUMwpYQ7kNvwH5HDSd&_nc_oc=Adq6Xx5zXzGVBGh7MQhmJepSyTjT-p38jdq3U3gy6NhMmfAvrphVoIEDberngYflmns&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAWDIYXBBGlE2KVetbVWn0sTt1jq7EpyUQXe8XztKdfeg&oe=6A491732"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=udQXQQSE8vwQ7kNvwGYXg1T&_nc_oc=AdrQr-6LOi6YKFI4WDp7Veen2yE4PJU3vt0T_TD_Ebgs-wwtxJYcy9-TzK8z_XC-PT8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCVXq_mSdKxyWP2vVqkJk_7xb_bg1Qxezr0g3g9NSR5mA&oe=6A492DF3"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TE6kP5fOn2IQ7kNvwFJlSam&_nc_oc=Adr1RtVWqs2ihT4NWmzpX2g_Xayy6JsWsasLNDnu76JRxfl2n1V0ss3RpgMwj74w6C8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA9jN9QoIExosNg8RNaXgd8xuGGU0arcxxRcinFsMLa0A&oe=6A492937"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rEP4jEkP-4kQ7kNvwFcKeI9&_nc_oc=AdpO1b0Ri8XLOLrIf5N0IPqyJDStZCz-2pOCxE6296UDh1rwYml8kGh5GhEbK6rf1Ik&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMpbUYY7C_1F26xDDNY6ha0MTY9eY_bCbJJygZfzjQAMQ&oe=6AE6015B"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X-kIjd06V8cQ7kNvwExxeV4&_nc_oc=Adq_E-EI4ucsFcKpAAW27Bd7RPBLIfqFgxM47u2OZtIAOeWAosk1aXAtes42s6WQxXs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOfNtqwma49H8ICvaxu914NCcG8ZGDjomS6KhuMBDlcbg&oe=6AE5EBB8"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JM8C3WIjoZQQ7kNvwFce9wC&_nc_oc=AdoafMqnUqhjjI1db_yz8_VQ9kxqm6g36Q1NntuKX4wmCORB6qIcUe33qLIkolgos1Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMCaLaViIJt4Jie0JzPzcVEFw9m75cDeYMzXQUafV8wlQ&oe=6AE5F9B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G0ga3Y421wAQ7kNvwH3oAzD&_nc_oc=Adpzhq7BFdHPegPfTqvKsxrG_CN6Sc6WNSaHpcqjw1W1WcQhyxjH6lnK1ylhq_JT3eA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNnWlXQ-NbUVjA3gPfbEz7nt3IbPkn7cghNWtFk1ErQ7w&oe=6AE61073"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nRiaVhxEpe4Q7kNvwEtcZ8e&_nc_oc=AdoNDtB5-2eQE5XBi_HfrVCgeeYT4Ur9ei8NK-0_xnvaqhnoL7ICITRsiNQbaxexlUE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPMXxPtMY_4ATgAqP0gpkFWAD-fMPAMO5bWwB5cRHMFVg&oe=6AE60BB7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
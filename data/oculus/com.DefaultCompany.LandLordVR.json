903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-8MH9Qd7LgYQ7kNvwHJ9QY0&_nc_oc=AdpK5qJD17dxwO1yFKereLJG2K61iI-tC2vn8-QYebWJrZ8dpTvmDdU-sVgSjLLbwGI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6XnxntO0s8JHrAa4abA0Tu8h0PGqKhqB_e00dM7v1n4w&oe=6A13115B"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RwzrZFzpGtAQ7kNvwGsL3P8&_nc_oc=AdpsEUgcFp1-qQGC-wK0r0IZYCBz2IA0X7RhOMVYJpNss55fO1rzA9yjmNxVxwMAY-I&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5TWh3Lgw5qFS11fZUfg9-oktmoEv5pyH7BFPJ9FIEIKw&oe=6A12FBB8"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=erpSeRoMcZkQ7kNvwHIMHhc&_nc_oc=AdrLrpVfzBlCMYNuCU0jNwTJ9j2frbPP688nbKqIymR27Yv8fOd_jy7L5EHgV0Eo0Ng&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7qVkCQFsZ7BBQ69-uhJcZ-qP_wSqIKNm7TxEUmiKDYHQ&oe=6A1309B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Y_YKeEAveUQ7kNvwFM09na&_nc_oc=AdqHR4C3O2Bq2pjggGYUU1DOa4G69UhJfiSoH1ks-MNWBaUJMBYs3Bc6vxOW5_Q4W5M&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55mX4A6zVWk26IFgWdReXRnKPwqZkgP__wB0GnHK66vg&oe=6A132073"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E3T5Y_vLoMkQ7kNvwGra9BQ&_nc_oc=AdoYp-h7fjRq9aUo1QkZTsQFAFWrUCO-bSMElc5vle10IH1-5Jaof05aD26RJarcKAA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54RO-heYbqJWAehP6bvHTvqJqvzjtaMijqqPCCTZ5oQQ&oe=6A131BB7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
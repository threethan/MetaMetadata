903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rEP4jEkP-4kQ7kNvwGsR_AC&_nc_oc=AdqYl07fKicZUcZQ8U8iqWi5X_jmdpxtGUdSjZ-JNAT7I3a9MzXETEV1sETJZwgswTs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMRXiPna-wLBcayxtyJMJ2VjSAjeSI1661oRItkr0tWrA&oe=6AE4AFDB"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X-kIjd06V8cQ7kNvwF7NS5z&_nc_oc=AdoXC8awisTQyxxYA3goGbKIvZYkhIk6u-JXuFaj8L1lBydWJ8V_i8IfX-Ok1mCHtAY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7_W8oID4n-iYF79m3znaZdSvcrUvggRjQ6MCIlx1_Qg&oe=6AE49A38"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JM8C3WIjoZQQ7kNvwGP1r7q&_nc_oc=AdqF3ZRtRLKN9cpQe_LRzBPNwu6fwTRtSZXHRc3GdFGvSibD__JsJ5_Skv9I25VLu9w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMo84N0SvcL-oVdV1dYF_tvWCKg_LDS3tFqPm3ics95oQ&oe=6AE4A832"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G0ga3Y421wAQ7kNvwF1S79e&_nc_oc=AdovZScGePLrHrMW3l2Ba4yAy4G8m56M7GuU5BmmfvRKj1JkQuzKTqxH7PXOvTXuGLw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdrKQNDiV6IXn1Hn1nKXkuj7wV70RN_uICqgJdx43DIw&oe=6AE4BEF3"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sqjchlwQIooQ7kNvwHaPERu&_nc_oc=AdpnwUAmGJHr2xVCfUMT_2lizuajWy1J7ftnKpM5aVhWEBhkPsdBvpuukYFJXckDzSs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO8gVD7xjngn1sN5RIEsmZthPcVLh2GL2UbxgKOwIO1qQ&oe=6AE4BA37"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L84jFmkodBoQ7kNvwHiHdHx&_nc_oc=AdqTaivERTL3aqbQrA2fLtUEUNTJDeOpnJWlQSXyDZlFpIfl0wguFlrNHuCTHyJsm7Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2o9HTiHJ4pex5BYoNRNYPcmEGAzmXaU2115dYjoDexoA&oe=69D277DB"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m9MV0j0u8uYQ7kNvwH6poho&_nc_oc=AdrBb_4O0wpiWhfke9160bYcJbMUEALYqzXImo-3UvAQH83Rg_n7X-rs6p7IQUv7KxM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ZdyECml4BPkA7AAfZXsHmkniSIptXRU3cJEiRNJaIEw&oe=69D26238"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q6IucgoJ1IYQ7kNvwHRtdud&_nc_oc=AdrhbblMSLbggZ9iknGsuqAkfA40ICeYKpgpiXjAG8Q_jwFpb5El_d4FARzFfUy9F1E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3WITDVMawKxr8ztWRJ4njWkkhCq6XZ5QVDsOsBOtdygA&oe=69D27032"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L65CR5p1-FIQ7kNvwEl5bL5&_nc_oc=Ado6jdhMIB9e1w8i_H13Idkf--HbcHmEiu212BCZJgTUKEivu3Wd9_7njZngT5k910U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2wvone8HpjT4CfjTT-R5t5tHjz2ypgwLR8ulyVnnxuYw&oe=69D24EB3"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-pX6K_R8H7MQ7kNvwHqlx_B&_nc_oc=Adr1RxBib0bQZdJjLS3g0ycm2Vtpo8vwr33dZ3TaLpvE9jIOxL5_xTeFH5gst5qb_XA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Lrcg-pTzo_rCPGHngeZM9x48IxXlYlSFPUan0HM89QQ&oe=69D249F7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
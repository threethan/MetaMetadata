903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N4Kxcgxr_CIQ7kNvwGpczM9&_nc_oc=AdpIJ3ny_c1Vbn1mRgvqld3Z0FccvU7Lx4Onrd24ZfszG_GDiwiTVUuWxG5Htq7igr4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIaLRrxIgkOVlHC9u2ePADZKNefXaYwmFCn0AJWTVK6tg&oe=6ABD22DB"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A-WdYdbHaTQQ7kNvwHi-Xaq&_nc_oc=AdpBzTykoYHrrKqgiYfXwTP8Xj_dx9sCxjTUECFtRViD6OstcY1f8eg4kC_L--vHfBM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWcR-Ym_4wIRkOuAJuWdH5YjegJBncQy6YbOMQJraVBQ&oe=6ABD0D38"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vA08vwaQ9MEQ7kNvwGZO41v&_nc_oc=Adr8BkYsxmeFQ7cezQoQ27yY3AvihzxsFfhFpBwp8B1OsEUa1-5BmZkefM4GL9mqS80&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNe56M2kMOBKZcqRa-nGLhEOfc__C0NTTcN6761Cvd5g&oe=6ABD1B32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Plt-XxnwEJEQ7kNvwGzFz3z&_nc_oc=Ado8pD1V7nd4Owkn7tm8fiIDtg5uYDpqumpjQOV-Qe4_j8VAlqbiioxUSiUT70k-mO8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKgKHQHmm8iBv3V_9QV2pJ3pDlsZnTxcvfsCegG7N9umw&oe=6ABD31F3"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IIiQK6C0Nl8Q7kNvwHTvB8n&_nc_oc=AdrOiaV3UqWTW4sFSs9rT7r4u2zRVFbolH5K6rIge4yWQ7RjqUc1KVQUtQ5zEUGeEmE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLiPr4OQPXhu-Ac_urVYgFoz03p8kxsaAfVCQrwgtbVdQ&oe=6ABD2D37"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
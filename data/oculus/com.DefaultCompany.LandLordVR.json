903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D9LoLNswfKAQ7kNvwEUEV0P&_nc_oc=AdpjvreJ57Wd0ORA-1L1Q9Gt2ymJXTQk0mrcsmt7nrQ_erq-EFMJIAGs7qmnc5hX-D4&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGL8HLv3XfWcGWS8J9VizYVL-FxWSeTvxxGgj5dIMmnkg&oe=6A91691B"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BXt4IguYHY4Q7kNvwFpKTWO&_nc_oc=Ado9AClS4tJ9fbe-xu3pejHdB7KBRxcgivNGZne5rJZWBmmgBL8rsEU-GbMH-oiyHK8&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHSX3xPtwnvQ3cI2m3hb5_ldnrFFogl9coaFIPqRPdE_w&oe=6A918BB8"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NHXhQbUbApYQ7kNvwGtpzOm&_nc_oc=AdqC56BHHsVdza6ZMuIcNGrDbRfU6XuYK20ccG_dNnVKtc_6O1o6RdN_mzMxogGZ9zU&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgUYWdpmQkxgV44py1BvTVPHHqCF4b0BGTUqph1K_DIw&oe=6A916172"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CgoPiLI0b78Q7kNvwFB3IUc&_nc_oc=AdoBCwygsEYnm6I77LrHl7kzKV0Xp9eFEdCRurKxMMoQNsCOjbkS6Lm5E6v_aJllvS4&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtPQA_xE7ko7Tn_NngJaZtBgQK9JspuuW22JbwFeh21g&oe=6A917833"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=COGJEviHWp0Q7kNvwHm9Uam&_nc_oc=AdpywzfWy12cm5agfZ3H6lpAi6iK31792JAFgrvj6e-8n0Wt-lGZgsexlD8f8_P818Q&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHwnjPC93_QBRyw2Q6pGzZ9npgEi2JaVMZelwZVfsprMw&oe=6A917377"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
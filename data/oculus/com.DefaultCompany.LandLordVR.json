903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sJ5vOQv5r10Q7kNvwHCNKQy&_nc_oc=AdrYg1scnCc85VRzzq-vxXqA6dg7BdpqU1ZuUIENtv66-T5oGD8gHhWEoM4L-wzt-eY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIbyer_e-uoOPaNeDt_8LjdSA8zCPSIZScT4h85z_XN5A&oe=6A9C2D5B"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6K53hdsjqYAQ7kNvwHdRXX9&_nc_oc=AdrmiWr4fVGCkSB1LfBHD2uyhhGLQSjV2RaQwFPLnAtO3fzHRJOys-9SzWEEyd2-Xi0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4I2_f0G5c-gqrXc5akHKlTQ49O8ExMknSGtMu6yQDuQ&oe=6A9C17B8"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-yVE1uof0sEQ7kNvwEXwCYX&_nc_oc=AdqVzN64w6N_s8UOycvNpq7lkTvY6Z8rzuo_LSJkUFeglCyQx-HQ3zpSymEOGPaZjTw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUk2KajbLrURcHRKkM5R1vZ9PeySrHlsP_sj9ktiGcBQ&oe=6A9C25B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f6djy1-d34YQ7kNvwFfc5Gg&_nc_oc=AdoObaF890nu6wahCZI_AQm37NfP7WJBO4Dewj3pI2NMpqHHdrqiFYF75htClN1N9f8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZyy6OZWNHSFC4ISwTszyvI47IojBBbgDxQ6aGcjYlJA&oe=6A9C3C73"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D3BE_5jS558Q7kNvwEydG4a&_nc_oc=Adp8sKauDPtSKO4tHUWUcVEbXyqGLbmofo6TPLUr160mjPiXCjmL9Vl2jz0pCEU61DY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfFBEEZfELjEUSCiHBmJebPQ36EUuhMsxVl-LdVEEtYw&oe=6A9C37B7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
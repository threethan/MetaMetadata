903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vEq9c5YfGZMQ7kNvwFknJOD&_nc_oc=AdoCHe6HuMEGDWHBXRbV2vPTYiYvjfiYULouq_9ldujLEdYML2m8hhltnajzasAdjqw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ41gC4qnJRGkkQI8lBvDVGC6qbfqQkqWrE3JZP8ZZmDQ&oe=6AB68B5B"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LPCrpWZZF0QQ7kNvwHeNttd&_nc_oc=AdqlU1I_0lztNHLhyw07afSCMusa3_YPhJCCLEld4RZUADpj0TixFJdlvaZFwrXBQJo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_6eU822polQ5SXBiyNFCGG_YR5onqss7m9yDNrztyhA&oe=6AB675B8"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CGv5RxOmS4sQ7kNvwFh0OPZ&_nc_oc=Adrftbbca1NNBGzPgiQ4P7Upxupx7WfC6FceV-q9pMhzd35EFhBEckos-_sZewE_w5o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbcT8xnf6RapAza0jY6jt8lOvuq5oA6zA-i7HF7cY8Bg&oe=6AB683B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j1K-8LGDhZ4Q7kNvwE65oM2&_nc_oc=AdojTrhdF7tq4mwMOtyZkYBuDywuQQY29lGo868Oi9tw37tiHzdTKUk-_UF9pArDH5o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYyu5ZgcNscx6p6l0ZcvYujq8gfh6YxRJLu3Z9_GyG-A&oe=6AB69A73"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wOcAm69F9uAQ7kNvwFd4xpT&_nc_oc=AdpVus_HNXGFkFfq2fnpZa-Xh40xRKIWIynbxOWb5M6mG4APwg4gVWyEw46sYtE-qMY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLVXFf3RZbti81N5F9uDHdjgKwqgeXZdnjH6KgorbXtIw&oe=6AB695B7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
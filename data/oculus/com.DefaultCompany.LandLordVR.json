903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i5AJoVQlBnYQ7kNvwH9fY45&_nc_oc=AdpWac6VcMCoGI6dPiiRZbUGzEVcnen87u27bWQS7R1s-TeH-HqFG3VtLMfeCOLbAlw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3_VHk-IoHIITvf1Vs3euWN90F828TE4TQYrftC-hTBCQ&oe=69EB845B"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R2YaRgTD0BUQ7kNvwE0K41Z&_nc_oc=AdqJ4xwOEKa8O45L9ptM9K9E45bew6rCVxVluRNlMqlas0DXMV-4_pW3yldVM0OpcDs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2j_aA1UcQGbf4a7CVNZbd0cAVczxkrqrxCwKuuKUmBUg&oe=69EB6EB8"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vkfQrGMUffgQ7kNvwElmI8I&_nc_oc=AdrUSYNhXJd4fmq-bltifW7lcWtg3KX7iIDt1iSyVbGCj-ommKWiIT-gODWPPj8R4W4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0r13UeeIJqPlbxyIOukJhwuifj6zECqZYN3S13BkoPmQ&oe=69EB7CB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L1ztYu88ay8Q7kNvwG6ksCe&_nc_oc=AdoDVjgPJUtlDHOH7U38pp14qWUSAn70pvWkYFRULBy7DYZsM2v0obFb9_kq9gQb554&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3jES-GUd9Y8JPejNPHVT_RXxMkCf0g8iX-su11UFmdrg&oe=69EB5B33"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2i2d2mV9aT8Q7kNvwHracoB&_nc_oc=AdpC-M79Nz3dzWRWYSITU13pPlqYcx141OkOyA7pnCVEJNqg58lceYAZSu_-S5rwQUs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3FbqLv0YeiSFCBU3FUfLv0uOVyxiID_odOP0Xs0IV01w&oe=69EB5677"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-8MH9Qd7LgYQ7kNvwGRHl7w&_nc_oc=AdrMcaFQv-YRNtTBOtj--7lKjzsB9m1jJdQhnMwSsrTcFUATbR-uZGP_FMGR_uLioqU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7flEGKPdovmVj2jGsCMk9N-7xAi76vqm9VH0yr_INCow&oe=6A1462DB"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RwzrZFzpGtAQ7kNvwFMwJ-t&_nc_oc=Adq0dRQyMCkfbv0AZ7bKoZbyYv9pv3h4hd6XH11EkRVy3J3b3PdMMvtjwol7uSRC6TI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7QQOZlN1BZllQ2HwwEsc2mzwc6N8y0slLNPp7z-XI_XQ&oe=6A144D38"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=erpSeRoMcZkQ7kNvwGAkleq&_nc_oc=AdodYOZcdvH4zlfFs_4F-bJtq_ZTBHfbFXjFZM2_D5GPSVG_vdIdYfbRnhvx7CD4bPY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5aKqJJa-qOLU-MW9rALA5l1m7xVX9qYCjAl0JaNmtcvQ&oe=6A145B32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Y_YKeEAveUQ7kNvwEzBNEQ&_nc_oc=AdrvsObVwxBnjnylOY8c2XRhySBeoPPdW56kRwkYtIrhHxkpqAxhJK0ezuEUkt9LPBE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4fXOsmrmUujybdX3lIjQG46L8fxqNf7PlNJypXlAkdhA&oe=6A1471F3"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0vaxAaeDSgQQ7kNvwEQKjzA&_nc_oc=Adpc7gtZTH4F0Vnhwn5Dk_QGcZXlUboz08ud9l7wDYyo7q9-02Q3cuqzBW84XcDie0w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5j0lHNqbPNfheAG2pA6fUrNMXUngjMCO8S3cFCCWdlDw&oe=6A146D37"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
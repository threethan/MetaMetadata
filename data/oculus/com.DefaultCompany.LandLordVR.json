903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=24kpit0f_DkQ7kNvwFsGt5S&_nc_oc=AdpOTjV46E-dVAje2XO51RgfSb1mqsL-93d83ZDfDDFE3v8HQfLsb9bBZbDZF8yFUOA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6cx2fRW4vEhe5q3iQVWiJIK_GEOVraMHIg6w8PmJzX3w&oe=6A009C5B"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M5YtIEgl1HwQ7kNvwGOTvMo&_nc_oc=AdqeazXWvu8g2-QQzFsgkfdIovUUjYFuPua-DStq7o5fofW65MQWq9RUm-warvK9U-Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6njvBvyAfBqhwrIuXjtP5xtkt8zlhgj2MgxA68MpdqNA&oe=6A0086B8"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mkoQ6RaxTT4Q7kNvwErbCRO&_nc_oc=AdqWBkBDfQIFbVK7YyiXLKgxTmf1-PWuTDPX626xqQNlYhSi4a_DwI1zUownlSWb4Jk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4PjO2Xvq5YxjlYdAVH46zAyTlU6XXbGsgDS__M_yI82w&oe=6A0094B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a5idAQj3_FkQ7kNvwG6Qjf9&_nc_oc=Adq4N8pEcIFlp-bNSALETIdF9Xz8nD57vDEEnHju3ofLdw2ZpNFHqVMZbyqiswNvYpQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6yfyo9NF12I9B8KUi67jRkVPvsZpzvGLpyw1esUkoDYQ&oe=6A007333"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nGFWYwh4Ri0Q7kNvwGawu5C&_nc_oc=AdoIfkuhjmP54B0xX7S2I4j8t7KJ2uqYFxTw1w2xdQ1KgFn5YRzMsTn1X3TN4YZgMcw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6kzeUxh2bW5abS9pAN3mOOm7vJHJCNczrkE-Nx_iP3zQ&oe=6A00A6B7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
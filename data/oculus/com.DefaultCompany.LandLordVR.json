903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vEq9c5YfGZMQ7kNvwH-Rwlc&_nc_oc=AdpxGzTMoRvFjlym1wzfwGwuD0FdDUdlMjGaLx4XQXGyFXcnCC5EibxaMhiFIqfDmWE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFPdcJFLTklQqV5kFZquaAR57WFji23588oNxxBK8p2w&oe=6AB539DB"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LPCrpWZZF0QQ7kNvwEG32_U&_nc_oc=AdpXXFvDT5L9hMUEaH6olLbpM91kMDFyzHjbOmaq-qIbhsx0GbzQv3zSAR-BkKqmJ2I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJAj1ZfHiYXtqtRbNKkU2OPYghqV_mjuvtAAd-HqMww6g&oe=6AB52438"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CGv5RxOmS4sQ7kNvwGgftNw&_nc_oc=AdqCPCcId_y78P8194eZKA3Ek36S5vy3pz5UExnq6BLEquFgv_1ORYsSkYPaWhimOts&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJqoWuX0Ibp5Ecu_r7drDcRCvK-ALjBRWTvTSklNIA_Aw&oe=6AB53232"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j1K-8LGDhZ4Q7kNvwHfqGKb&_nc_oc=Adp_iG-mw2RokbN1yeSIWkufSGu3rWKkfvi9QsJMZPeNOYOPwAhXqbRl6UMH4Yl-Mnk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDegWhyF0b_68c2NPRtugpp5urBKikZo51P3Q17gXPpg&oe=6AB548F3"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QpReN2d3PpUQ7kNvwHciN7i&_nc_oc=AdogFT5AyPhCHS6WJ6Y15yHPIrRkf5Y6SfYcdMqhCtYpkK-FaSI83zeJ7btLg1DrIMw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIK6v-_6M0IAoXv_10Wj5ln5QMADS8YO1sOML9KajW-IQ&oe=6AB54437"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wu7J9OcBfRgQ7kNvwFk6B9X&_nc_oc=Adrwy-sk-xqNGKQqMvYYg3AhXo7ntJKzVx6yIvcygW_oSncKgNKMl69HgGjgkYO8mr0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3UQNdgVFIipOuDwR0EKGwN6x8cqqA2YurZWrpmYlZzFg&oe=69D51ADB"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JIrWD4aI5uQQ7kNvwGAVE8F&_nc_oc=Ado5HMlDK6cJ8n2gqiLPhxCnAl7BjasX18K93z5wWtX_CAAjqp0YGFf5inDW7SDJX-Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3GfUbhn6trtxA6UTtFm2ypN4eqJozk6W3ebrlTIkiOJw&oe=69D50538"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iYLEQtQkvC0Q7kNvwHTtL1T&_nc_oc=AdrnfsGhMufmPBcJBwvbPewv06Bxy-NPGkhcU0ec3af_-Q4ix8bH9ajyZ7kt8fv4UmQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3TOpOP8B_4LDZloW5piN-LCwxC1k6XdgUw9DvgD4hwEQ&oe=69D51332"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VXJqsJ9_iEwQ7kNvwFHX2t6&_nc_oc=AdqgDtnTId9_AqkCYJ3CjQ2WtbLDq-I6HQlQr4H3jvxHnBmVjgPPAeOUdilV8lEHjyQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af179t9DtQTPuOmWU4aDLwbc-Z4i3MJ8Ck0q0THf_RAQ9A&oe=69D4F1B3"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YbsFJstL91kQ7kNvwHMz6HJ&_nc_oc=AdqsaQguQUHHnycIH_nO2deMQwc6Ie8b9S5wB-OsLe3pUkLN8HgN_wQKeZ4Mc1rFBxA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3rgWP1yiysd-CG58zoeoRkyeLmvsMH28i9f48IzgnHAA&oe=69D4ECF7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b6GIsK1O16gQ7kNvwEx5Y42&_nc_oc=Adqw6KCmQ66eOExAvO_kBTOqIJSoV-fGhxih6jAU-3eTInvLv6wrz8fWxIJWCt3UdIU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyegektcU5SQVu-VI9TmDxvToqLTOiXNi15ThUT_HQAKg&oe=69CD31DB"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YbnWAjVZff4Q7kNvwGuELmz&_nc_oc=AdpgYNVdIi5ELr11lFKH0wh68gd23NEmtSAW0S89CBWoN3y8xOJzAOHwgl7fXK4i2W8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyF9PCdu2fRrql6Q7Zbaq8PrHNifjiqVtntF1i-EOaN3Q&oe=69CD1C38"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xdJPUXWPRDoQ7kNvwFhfqkv&_nc_oc=AdpwS66jAUqy8rkJKrlTX-WEe19xrvtSvQohoraGBDHXcozQNjxDmWMCOnpm1cCBqFY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz2eHk5g5csOOA8iWKTRo5jOwkvOFfW6prt4cqZqSwv7Q&oe=69CD2A32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y1qQwvEyIy4Q7kNvwEM8-qX&_nc_oc=AdoGkLLwd9A0iFfxdUUlDkw9sgCmGtL5_uxn3DlGZvKkrlSSY6LAuPhGR1NIqDLZxO0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxNJSafyQ0jsadxJaCqxwcQG92Jf_cyUGYxjZ-Dk0JF-A&oe=69CD08B3"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0QaBSTlR66AQ7kNvwGM3bZE&_nc_oc=AdojQ2BunW_wKquvWd2R_vVwfj5mAGaffHkrV4rCAnuVq5J3_it1PRb4ri99XlgUdDM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzUCUk9iFPKYzQitfh4o6QjVu1MjetMsujxnKp-AgfK5A&oe=69CD03F7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
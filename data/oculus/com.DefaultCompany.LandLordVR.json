903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kh0TnJOzsz4Q7kNvwHbKtNM&_nc_oc=Adq84HXn67UR8SH0RWmVKcFBog9pIcGcTnzVtBWADJ5ZJP4571Kbr3S-3quQkAWT0eY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-NlyZ5YFNf3duWIcm1fkRfYsjFA_EN-T6gJkAbDpRlg&oe=6A1D9D5B"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I17bkURA_H0Q7kNvwFpu_M1&_nc_oc=AdpNFG94c5t1j1Ms0os9GK16773Nv8sssglXfy4hy_Z4Ge3nMcg0Kxx6lHcdhsr1Ryg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74ev9TY8yOuCalck60wUHhhtPdBGHTBROYVnqktLPJpQ&oe=6A1D87B8"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HkMeUXPtEOwQ7kNvwH9FKcX&_nc_oc=AdocGv7TARYj0zwlguJiYXT3hi9Q0pVJ4KoHiwnZvmdRR9TilgZTcwweDKbuNeB65G0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4qNK35eDTM522RjAcmCTyIqIUSwEDXTyz_QMsqsuIJzQ&oe=6A1D95B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h0HWNPV2ZQ8Q7kNvwGyC9vv&_nc_oc=AdqP6Z5O__9p4mcuXkYdeQJFehT0sTlxNusJgCSjU8zx7gU0fhHKjKB9ciis3s3D_5o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wCgNpt_xgiz-gF16f8UWB_YiGLs4S199vCSADMtI5fA&oe=6A1DAC73"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ov7ILf6KSm0Q7kNvwHmvjWr&_nc_oc=Ador6oOpLmvA4pxUqYW6wJXfBxkJEKELSixdXsXccCd75xDiOCHPpW_pYQyZ6fRYMTg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7jeUDl6AofMZf1lViHwP4ocJ-XzLHT8r83wlouArxvNw&oe=6A1DA7B7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wxrhfaZyjyEQ7kNvwFtqKEF&_nc_oc=AdoD9bcE98fgHG9_XrnQY4V_X2GMrAR8vzcQ07HfmI2zyyYwdo055dMFScS3LiiiYEs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8f6LLNJvsOQCUcZrbDE6nMgvC1VvPLK0mJnfujQLHEyA&oe=6A43D8DB"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DvGkJpru-pwQ7kNvwGGQ5kK&_nc_oc=Adpxv9LPO2iyWXKSyQLqpS5K2vkOTmApkdqiOWaGu1G7dIR7tULlqd_GQol3cel2YcE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_GaxpG10F4YnA36JSTtdAdghP2sQajO29ALKOZbrFDMg&oe=6A43C338"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y1vt3hi-VjgQ7kNvwEB2ZXm&_nc_oc=AdqTKqEh_HLsDL6MCrQANr5L3rsf3Y3TsOPnPWEC_RKKEdFMU2uXU5kxO-r0247Fu18&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8sHQueCB42AesQDNaU1q8aHRXkkfYbsc9-PylcMT7JcA&oe=6A43D132"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=phoI20bnZYsQ7kNvwE8ls-B&_nc_oc=AdouuahJwG_eqsH4Rq-8bIIpVAHGoDIZmtLvbyv3UZUykFEP-DZxBX4j50LyjERwhSw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9OjFUzuY5P5CBBNRDoQlq8l0S5JLyt0nlddn-gj52r-w&oe=6A43E7F3"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uhXR6CgBgBwQ7kNvwEN-z3B&_nc_oc=Adq-bS5emnp-WVp5Xt-Jbj_WfongGvZqfe0yh-v4Gxvlc4rFCkQWZ2PQhHE0Cn0zIOE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_nKgSuHPXI6n41TNxj07hRfqarV2fi-O4pO3m9kbC7IA&oe=6A43E337"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4QNafYZ23nsQ7kNvwHUs5cn&_nc_oc=Ado5QLpNbqWhegAHG02JX88wgD3-f5scJWlfnoXJtXXGm9CHBxdbHKwlJkI8qf56mEc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbxvZSwakrAETfdEs9GHQVO8Pz6MQLVh9nCmyNMgXrNA&oe=6AEC98DB"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e_AV_aOBTNMQ7kNvwGsoW9n&_nc_oc=AdrD-PkJnbgYe9gbGoVpeTS-ZpwH1eu9xDjd786TVHHXGjCsxTHHrrCB5R6Ex9518ZM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSeM0zx1HAgcFiy1grmLET_agYz-C-4cakCKlhsYe67Dw&oe=6AECBB78"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f4bq5wZ-0AoQ7kNvwG6Z2Hb&_nc_oc=AdqJGxKRTh1UuEFGDdKDfBWTs5zwsO2VVC3E9iOVvG-fOVX1WtcHbNd8jtORD8k-cuM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-_cTEB1ROQoauwoF5X3SbsGsqxUpmmevzu3upgQftYA&oe=6AEC9132"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0PdjqKN1oAQ7kNvwHewv_p&_nc_oc=AdqI6-gl8mbCTnp2DXCHFdFuUUKzGg129-EW5umxrIafDm7wpg9UcVKgsU_6Mvyt0l0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRC7aZiYCONmvJZeASRUoUD8xe7PxDkFOslFf9WiB3wUw&oe=6AECA7F3"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=krcu3Fp05wEQ7kNvwFf80_n&_nc_oc=AdqFZZIOQYpbKqr0obJJH-0wKTDv-Co_KleRmoIVnmK8Cxi_UIbElnxk0zu6hpBOpUo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSz7sNqPUNDJe1g9uIIXdpOOghR43MG6JJl7yU3SsvEjg&oe=6AECA337"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
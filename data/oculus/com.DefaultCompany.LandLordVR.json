903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bBb9q_k6QKAQ7kNvwFc0Yf0&_nc_oc=AdodaiHFIPG0ghRGcVNgEAz-YeePGp8fiaspbizRLp1H-oeuWJhqnqfa15p6jXg4nxI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-eSN0FaOlqv9o64JhVZEQ4DvZbAso3WCl-RkmLB-_fCA&oe=6A2EC0DB"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1qJq8AwynKgQ7kNvwHhAgfl&_nc_oc=AdqAuoGkEUOlBAXdDFHH322Y2mRryhH1GZ6_aq5zP_EXEJ0a8HGkQj5bDWG7XyF8cmA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_exaQX1HD6RAzqbcTGuk56qpHqEGzdA1lXVk6Ji6Z_Qg&oe=6A2EAB38"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qnur5xrUIFwQ7kNvwHnaeFr&_nc_oc=Adrk8rfw9_dVLj-XdGBU2XuiijcuDSiil9iViXtHT64C8WmfJKpdhqtwCzB1d1tVYjU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9kg6PjlhuZQlh4yvXT5yh1RC-SYREFpm9CYYoaRZqUgw&oe=6A2EB932"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fpyiyyli1mYQ7kNvwG5J3Fr&_nc_oc=AdqFEN6u4EgFjzg3-MGblgphLNXl0SCgNaxflJCL_e8SBcdta6xB5qWFLHGEMLxhIws&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-PeJtf-DlBtjmrcPUJxbPfn_UykuNEQ9dYMJmwXrQT8A&oe=6A2ECFF3"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LvukLHSV5RYQ7kNvwGdck40&_nc_oc=AdoEeg395hQdsv4QmDQ2my3yxLHGTN9wT0aFn-7BT5kJlCkdmqGyTtfq4OfJrirup_c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_aap6i6pplVFlRiVw1RJ07s-5RaKWytTuz2OIHVmmwXA&oe=6A2ECB37"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
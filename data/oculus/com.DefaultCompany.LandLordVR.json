903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CdZp0FYn1fMQ7kNvwE25snt&_nc_oc=AdpLqhCwbCf6Q7ZDPMPwtH0AxhoFuHyD_LwojONow9Hyb1d_jtmT6iWDB2WgQWELgyI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-sm586fyIJVFnK5HhTGKRfDuFODDWP_DTevM4cJbatww&oe=6A3FE45B"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Qg3TL85HOoQ7kNvwF5j_iI&_nc_oc=AdqnwfnKx82ardbXbErar1mz6bCWXsaq5eJbVuAsFOicfLgwMPuBho4623-DsoYE_IU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MJoWuhJ7F7LL9fzlRP6U14Z_kMF9oCkLNFcmb-Cg1bw&oe=6A3FCEB8"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sIJS4ayIj9oQ7kNvwGEgzkP&_nc_oc=AdrMDEPrtXac0bff_jQlSyZhJHpMNDLxdJPcVgVw_FFC6Im41d0BwthHZDaewug5jQM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-n6v26IrjSuFGBdPjyzLVhB5Fl1uD1vbMfcfrR4Hm7Ag&oe=6A3FDCB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tm1Xfa7K3joQ7kNvwG7QBS_&_nc_oc=Adry-HDh1M4v5l1J14DvIiSj3RCkmE_JCdKytPMBp9DNwZ9QaLvmzwQ6g1qT5jbDwgg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9bs70MKE4Lagk5R5z2GTFjpEcgBcZ8ssfCYGu79tSLA&oe=6A3FF373"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TTl9BuZXUbIQ7kNvwFZZdGK&_nc_oc=Adoc-d9q3zFHdd3sPBGq0zdPRyPd_IqtAW970G8yPB70xziS07ZmEjZ8Lq9ZwqwPJyE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af94iA0lx421iHKRhVDAAUPrLm5AAT8dlzf33hHKgMsJHA&oe=6A3FEEB7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
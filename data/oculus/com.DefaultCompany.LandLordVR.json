4848_520432903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3nxAYQmv1aEQ7kNvwEmRO2a&_nc_oc=Ado7hxS1dpw4gDup0jOGh-U_rOKtnoL4O8B_4BhppvTDq28XFkbIUrN3yS9TrBHrYhY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBcrP_5Isa-Iw5cODvswNlSEd07x8Ib1ghU5j3HoUDKQ&oe=6A858B9B"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D1RBbmy1xhQQ7kNvwHHRTxt&_nc_oc=AdqVLLQfPR8_HX8-n-jcqYhiz-dijJaz_RLWf9kWBZAuePO3wPZVRpRXFmdlxRSZyxI&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGckb7ablSKdKhwCu-sgzHGE7EK0ARGGTC7sVnRJF5w1A&oe=6A85AE38"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6GW9MuW53foQ7kNvwH0Pfzd&_nc_oc=AdpileZT8gnjO-1cnS9324BBJeca6CKFG5_EfGXgHNOCSzPsQ09S4RgPj3IBGQc0ZE0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4BIWt95dJBhUprTuBapVIejoSdQWZr5CSyijfeej78A&oe=6A8583F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gpDWoRtrJA4Q7kNvwFGHT6R&_nc_oc=Adrhq0xlxSEmjYWPXCIkUR9gVy-O69xTeG4CoXOrEX7ymkXAt50iwAhWPDrEdyEsO9Q&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDGNPZfH_HqkWL0EzS6NZDCNudsFQJ5atAahBs3qqM2Q&oe=6A859AB3"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zrT2veAhD1QQ7kNvwEarDHv&_nc_oc=AdqbqW_MbaPByyJ7cJontMnJ9Kq-Ut0GL4icGm03CtggFzgy_2q0_F_-XSTDBquUZ74&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGaosmWKDZXEMommo-fx5MyvrZApaunw71oa1bATZlcvA&oe=6A8595F7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid":
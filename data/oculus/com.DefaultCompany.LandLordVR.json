903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hzMRN2e0casQ7kNvwGk18d3&_nc_oc=AdpE4pLPJ7XtYbA_7u61cfwdJDWBr41r35wt1-ubk7KpyCFvXXt9DI7GsPGsKEXYZTg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6OdR1WGXeCOi7a8BvyOQrwliAOCkgnTiR9WaXZLHpGA&oe=6A8AD19B"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yH1zEvJ1alAQ7kNvwFots_8&_nc_oc=Adqkcg2hUHBJ9qJqsVw4wikLYohASJfDj51ZfxJMOv95c6MpuG8AFKxlSUd2OAcfT9Q&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGlbRBi1RZz_FpE9PrkKZANRjxT9pMDeNU51EvztPyImg&oe=6A8AF438"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NN4enjqmyaEQ7kNvwGnq-8X&_nc_oc=AdqKxZeGXsma_AkL19oRZYOmCG8CyZE1S3UTBfMqnsk7rFXY1mXqyv9o6mTk03iC8VI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_TyEdgufSehD-3Q6Azyd4B_LSVdfiiC1K-FhnjR3tcw&oe=6A8AC9F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qFoutq6X5iwQ7kNvwGJktrx&_nc_oc=AdqF7it0ed8ErHINI4KrNzxsZhjo5_-dtFwQGZvXcYxcOUSgb0MlVxvbty-LpG74crg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHqGiCwyAwF_usDACrBfqdTz9Q8jbh-q5a3M79dVSn6Fg&oe=6A8AE0B3"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZIkk9yTx9P0Q7kNvwGII_51&_nc_oc=Adqy4NwjDm7hn8VFv4OLQPA-U1pDsMzxZDFs3KCYKlnlB3fX7-gjM9I54pGNOm_td9c&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFi7Bhchd5bFPxHAm6tO3DMfUm8JhiWeQE0ymqoaLWOw&oe=6A8ADBF7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
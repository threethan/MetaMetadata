903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ykZOZuzeV2AQ7kNvwHZ-TYh&_nc_oc=AdpYxeMIZwaXIshhySFJ3V8_xaiOWKkaZ6V_JHqO7CjbrnGNclYXy2g3aZeuwK58GjU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5nuYII7vsBZ4obY4ip0tHiMMhZxnF9DPGTeY88tB8Rw&oe=6AB3E85B"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LPCrpWZZF0QQ7kNvwEqsRXN&_nc_oc=AdrNW5-NljZxTO_ByBChT49p4B-VXwvUiZS12R9EcP8hJsfw-1UAgUzRHljW3BjGL5Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUzrVXbA-UnAbwhYZb2x04Mb4D-ov9c-Zsvtj3hELGHA&oe=6AB3D2B8"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=co6hfw48I3AQ7kNvwGIlvHn&_nc_oc=AdoolTHqPoJ45-tRMRPKPRSdy7HL4AmVp9DcJyDzHkAltl0K1DBqWOeqWbK-obS_RI4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJf832JfS0tHcWxJOfg6Bw4jPYK4XZejBq_eMS_3uojPQ&oe=6AB3E0B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iBOGxy_PmGAQ7kNvwHsXhrf&_nc_oc=AdrvK22r8XnZHdyYIB4c8l96jF0m890jOdp_fyzgcF0j7Xffyr7vAeASaLNAPCYWrss&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK7rml8i1XaOz7yBYLrmmV4ay6Ae_iKIuzo_-1oY6t4-w&oe=6AB3F773"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QpReN2d3PpUQ7kNvwH9Pl4w&_nc_oc=AdokVlo81KVzvWLyJdGqiX5jcWLp2IVvR0yTJXiclMm53GhEze_CUkt7mZTsHKlN6Gw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLGimevhs99GASR_vyg5HK7i7WMDlUO_RtZ21YBv8EALA&oe=6AB3F2B7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
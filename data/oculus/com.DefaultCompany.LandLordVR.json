903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_9Haxju8OHQQ7kNvwFvez6z&_nc_oc=AdpAuQQ36bYl9zWmOGMEN8Rm46USqth1QM9ZJOJIIyc1hjXLvIH-AGUulIXF0kT23CE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHs7inVgecaTmb-qmoUM3zxvDm4E7W0_Gn-pHYZF1QQOQ&oe=6A80459B"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GyGke1HfEe8Q7kNvwEJ-BDW&_nc_oc=Ado_53jmwNN-nMi-a6hZxkhhwEWGDhEvMeNjhCj2kIVoYSnv1jjV72QK-idjg6CE8ww&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWfyGVmqGBr2xSUQtUBX_XjGPAio7nffiAOiybLZk8Qg&oe=6A806838"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=et4aVoZZ9usQ7kNvwHckbYk&_nc_oc=Ado6n75895OFJZ3LDyvv-NEbHOIs_r08QvzftOyMgNf0hzPXAMBY2nVuXJ7xV_24GAg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBk5M6Syu882-2QGpB6J__kEVsAot1Oq4dkEOCO8opNw&oe=6A803DF2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jie-8xLGCC4Q7kNvwExo84h&_nc_oc=AdoeLHYu9D6_oz3WpbJXInQdGmB2joJp9Y5-z9SGYKetAdrUAyUv7EGrzJibMtXdI70&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHjRkvvBcFfl2p0i20nt-c4Aj-nPKW1OErazcCqmY9vjg&oe=6A8054B3"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kn5c9ZCfWvoQ7kNvwFCuf9I&_nc_oc=AdoqRI2uFclU5msM1d75yjn3uEXDssQYsyM5qgAXsAFaFlNYluboXMlDan-94-qNIhI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHhGiVQOgJOditdEhudBXIl7-bUo5wUcz5K97waUb0Ecw&oe=6A804FF7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
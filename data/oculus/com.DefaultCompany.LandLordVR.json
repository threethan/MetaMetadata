903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D9LoLNswfKAQ7kNvwFDvo3M&_nc_oc=AdqufFhU7irONZNk55OVvvw8dpqhG73qznpaEM0KMSmmZRplDBH_Twt1ppyue-nU_3k&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvY3PdX6ZabwYdxOJox2VmKl55ETD8jA0pmwkxOMRFNg&oe=6A92BA9B"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BXt4IguYHY4Q7kNvwG5NVJ9&_nc_oc=Adp7Igxf7Emo_P4_rQjpuRNOViAITVdDUIlwo2jKYwZGxYd4qrrE-LWAjtql_f0zEDs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGMBdIVXil37ZeS71fyMTEWrCUgi50bzPgIYeB6OUXSdQ&oe=6A92DD38"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NHXhQbUbApYQ7kNvwGGcsFC&_nc_oc=Adr9CxuGd4CW8WaFeytfwNUzuhbVXY3YPKtPwRZopTwAB5YcD3TKjgqKzl6Tv-cWJbg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGPYDHgH-ITJQ7sNezXYEp2lh3wqdAlerbMJg4pxrPWUw&oe=6A92B2F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CgoPiLI0b78Q7kNvwFHj3WE&_nc_oc=Adpj2MC-eO_rzamBhC6uaiWsn9dWlE4HMwRxQ7I0GoYLZv5CDNV958g8_q1YUxifnpk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFohLwHVBsETjSc48gR7-ECWGm_3icYO_clFTESEXkZSw&oe=6A92C9B3"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LiRuyKCC6J8Q7kNvwErd6Yu&_nc_oc=AdogCN9GUc8tjLtt3vXZqGx-W4fV6KnR_vLmc2GA8VWPJ0RxpjZZjKEUIW8ftGkgqN4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExWUM5K0Wx8LsvdHd9kKAg325G9foOIhtKa8tVrc5gVg&oe=6A92C4F7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
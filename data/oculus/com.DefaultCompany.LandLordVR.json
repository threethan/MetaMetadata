903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3nxAYQmv1aEQ7kNvwHo5CdS&_nc_oc=AdqtkVcgiAxgXjB-2UGVbJYGnGUPMSqmKC5u4bC7ZXz3yBoR7RWCcekfUir57JtPR4U&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEm5P1A80hQYmqs6tiIucwWbOFZIAkb2GK7QkVy2hdzwg&oe=6A86DD1B"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D1RBbmy1xhQQ7kNvwHoUk3-&_nc_oc=AdotFnvzEksAX8mh4A0YLCdrGz5-QPWvdhnbq5jRCm1vvnVP42uVYQWwhKFp5HKguSs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEPSrcH9-5jzQQBjpfoZpFWHOr8s5bmQcN81uAWEUNx2w&oe=6A86FFB8"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6GW9MuW53foQ7kNvwGXgHdp&_nc_oc=AdqN5rVw0zkxCUuK5SEFlu2IXpJ7zEzNf6VGK8w_U_Wv_RjCbjzt0J4XWwcHWtSVn1M&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBvBmzO3lAikYfVQ9gWBQ90f2ngyS3yCGxvx6bRhbpTQ&oe=6A86D572"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gpDWoRtrJA4Q7kNvwGWouae&_nc_oc=AdrGFimMmzy6NjJmzoJc8W9JtdUjyD-3_prWLEClL9jNdrk0rSokVa-QvqHJfCyrA5E&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH1Xb7ZXvGAjOagPaXvv8b8tHWQKLLbdT5Vc-wH4yImjQ&oe=6A86EC33"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zoEUglsRF2gQ7kNvwGEt7Lu&_nc_oc=AdqAknkzo18Ybm3vZXYGlVax1LbkbVkx8KIythxLYBQbl9GE8Fdpa3zhUHGDHJXaxno&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH1DrxEnuk-UF91O4dkYq_jrSFn03XZns_eXMfToNGXxA&oe=6A86E777"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
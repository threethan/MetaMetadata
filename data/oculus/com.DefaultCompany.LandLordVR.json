903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SUuLws3qrzAQ7kNvwEovQaA&_nc_oc=AdqBh7y2cr-TuSczwoqZi6Tk8_BzrHHimspOCkwE7fG7YwKR2N37xnKXiUW8f4rXnHY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOsxmysiARgUNe5A30jRwFGQFACn64QOSYwbNxUmhCPJQ&oe=6ACA51DB"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wysl05HLHcoQ7kNvwFovP9R&_nc_oc=AdpG4CUUqSRZvekKDcwkK8pRnPE0WA_gyA9yKu9hJuPlrlP9KnW_3pSv-1nxTVJhDuo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPKSLcUR574KFhz-CJw6b5qtMPCD8PFW8PYr5k8eBubdQ&oe=6ACA7478"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DlnQhje4qp4Q7kNvwHD7caf&_nc_oc=AdrhY1DPxaQfqSFSzXdqtSinixwHpGD9hDj5ZFuTNFi8jqB8V6WzXEcWEZHnAOUOjXI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOzkY8j39c5Y6_72SNESCO7rzjf0Krd51EUryIYI6YGeQ&oe=6ACA4A32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rzOqVh9tlGAQ7kNvwGwtaSW&_nc_oc=AdqEMRw6fqAZR26_Y016FGSMDUpb2Q5i0WswD1OioSJw6Agyfib2bNb45xypqzGxvfo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMLoIgmq4n4cFBgrUpnXlLH1lQjvp7KDvN4Ge8N44AAeA&oe=6ACA60F3"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BNaIwLjcdFcQ7kNvwEz8p0Z&_nc_oc=Adq7tZi-j73ZMV_aI1WeNZvykAwtxH7nZQhK_JtxQj3SOnC0OanS5-ZBVNtqnsja4gQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNt_IF5sGVdzjQesRVFQ-3_oUxdOwwYOd0ijH-HgpY7qg&oe=6ACA5C37"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
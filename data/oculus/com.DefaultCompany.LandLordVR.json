903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dnl1CoQk5scQ7kNvwGeU8ww&_nc_oc=AdoaZ86erEyL1L9-QY9stXzMb_V4DOLNlvjDEoN597mUwSfe2hL70Z0dsn5T5i9_1ac&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0PeGBP94ZRuYkBMjswGRdBrCk-WKMxCZHXfQUmQlyOnw&oe=69F4BEDB"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h092M3ToGgUQ7kNvwGXEZ0F&_nc_oc=Adrch6H5ot2MV9kdbl1nrwBcqZ18ZvFavgbZvGyM4SMOP3LSzM7KLoRjyQpThZ7XY1s&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af31TnhGm1pTJunkZ9G7DowcDUfVW43f-_yg4LfahI9ncg&oe=69F4A938"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3gV20fBg19YQ7kNvwE5lLH1&_nc_oc=AdpCyoQ5RQQxI6cgzHP_27Gz7ptj22AiIFxnYMdVsSE1jKDin2ps1S-8dF8Dyb9N9Fg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1XGeXXl07aouSYjh511KNRkJW8w_s-PKGEk5FC1BdQOA&oe=69F4B732"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uR8f-jaXEXoQ7kNvwElvLCt&_nc_oc=AdrIxcLxOVn3D-5w7t8lwLPU6JRf-upvbtysKTeV6SWfngg3yG6jfU9Us08kntQ9mmo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1tdRF-_ZDAqHcTYzjWr1zytiE1B0iEV3OoANsh7AOP-g&oe=69F495B3"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-OC_DJ8IwUkQ7kNvwEWWc2K&_nc_oc=Adpiqgzs0f2BcQFAJL6V9jj_nYyA4nD4lh57me6pzk3JotNKCqsh6Iu5sOFLwMtqM28&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0WGsXZVIRh_-2pPUlFIEu5-V14PC9DjKD5X03M5V7l9A&oe=69F4C937"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
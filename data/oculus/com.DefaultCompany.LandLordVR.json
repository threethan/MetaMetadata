903977695_5403651866457485699_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dnl1CoQk5scQ7kNvwHqanT3&_nc_oc=AdpmTS2TR9isNJKmKBPEmn0I1z5sS_Gssdxzxuw2XcvxXGg9mAw-Rj1TSgFxSsw3k98&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2A2CGRGp8Gubi5Z8_Ux9Xpca6acNOwUY3MnABMEMGtBg&oe=69F6105B"}, {"file_name": "screenshot4.png", "id": "2055572611505355", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974758_2055572614838688_5132970913086984899_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iFTjob8FPIQQ7kNvwFqbFCc&_nc_oc=Adp6ihaw5oN6sGmrbl1Wc_b3feB1xFmYySy6bWOkJ4tzqzXFVeDH4M8f1RTUB2edyTE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1LfxxSKLKKLfkZU22gO6xCQu8ZYRExpxHENflky3e5DA&oe=69F5FAB8"}, {"file_name": "screenshot3.png", "id": "524869889885932", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75348036_524869893219265_2755694553727091406_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3gV20fBg19YQ7kNvwFWW5qh&_nc_oc=AdpROHvurT6zMB0JRdAMIk8HFg1TSk77DditsIgSgREohFMowxlQ1snxrm3LsmMQdME&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1GJDZlXcl3cYaBfWfbedMrAzL2Py53ziANJP3xAK2_vQ&oe=69F608B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeFinal.png", "id": "518092164233473", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974778_518092167566806_3107660341605513768_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uR8f-jaXEXoQ7kNvwHYGnIZ&_nc_oc=AdrXiVN-GPPdBZYytzOlU4nkUq7M3rprJHBLNw-DYCzNJcnOvKL9RSrljfz6ulzaJ_s&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1hFuBiEctQFWwn6A7EF2fy4gHlsFqC-Qv1egx6ILf-7A&oe=69F5E733"}, "display_name": "Land Lord VR: Evil Awakens", "keywords": [], "long_description": "Zombie Survival: Fitness Meets the Apocalypse!\n\nPrepare to fight for your life and survival! In this action-packed survival game, you don\u2019t just face waves of zombies\u2014you work out while you do it. Battle through relentless hordes, build barricades using tools, and push your limits in each fight. The longer you survive, the tougher the zombies get, and the fitter you\u2019ll become!\n\nFree Demo Map: Get a taste of the apocalypse with the first map\u2014completely free to play.\nPaid Maps: Unlock new, challenging maps, each with its own unique mechanic and fitness-focused combat scenarios.\n\nAre you ready to fight\u2014and get fit\u2014while surviving the ultimate zombie nightmare?", "short_description": "Zombie survival game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suntzuworkshop.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Suntzu workshop", "support_website_url": null, "website_url": "https://www.suntzuworkshop.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8750269325018851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974889_8459488700737159_2853963445254897674_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-OC_DJ8IwUkQ7kNvwHRJEoX&_nc_oc=Adoa94ZK2uBjj-n74wZ44y0kPeeqmBmWdmQ1Orz6kjKd5pnTYYjTEdhc0s8S-4kw9H0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3RvJeVKODWZB1EQQVNfjFG7EKqOxwKSWEHkFelsNSSUA&oe=69F61AB7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
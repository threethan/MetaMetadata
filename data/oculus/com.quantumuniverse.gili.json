nc_sid=6e7a0a&_nc_ohc=MwVhBMXEVKEQ7kNvwEr8APU&_nc_oc=AdoQ4rBCp0lbZwcf15x456FEByDg7cl12hjS7n2uE8uFqvKrO1w00-Tvhxw5sk_eYXU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStC4PskWXehU1oE2LxVraoaUN4fnXE04QmIjDFz4XRmg&oe=6AF4A3AD"}, {"file_name": "2 (1).png", "id": "2100771640508146", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619485_2100771643841479_4813643192745516883_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f1wjIXTGq4IQ7kNvwF726v9&_nc_oc=AdqKvEELg_dIZIIPPAIk43Y4Pc9Iw97IGT59wRgne94ZeF0HiM0Z77nDEHFKYo9aCSQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5tVFkAWMXAtWpD1lqXbJ68vA5_RPAY6P1kW-qgOOHqQ&oe=6AF4A068"}, {"file_name": "6.png", "id": "891881563610770", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619672_891881566944103_8841292866626229859_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K8AuA81Z6DMQ7kNvwEp0v0f&_nc_oc=Adpd9esheW7VOLyxD_6-dsgk9cru-Eg3St-7q05jv4gUW2LaSAfKadYT2bQH3gOB7Sk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLejKvfiSk1ReWd-yD-EQIpzhO6hMJoSFwiwFhDLg-rg&oe=6AF49A15"}, {"file_name": "3.png", "id": "2064334757808515", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620817_2064334761141848_4877881492427811941_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HyCfWMnxoIsQ7kNvwFmqjS4&_nc_oc=Adrg6jLZzXKIOw8csadNz6ZvyUHgATd3O22_XQYdlsoJ6iljW5C7SbrT6tCLzlD6zw8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbQMjdYr8WlHe0w5mTiExInyHW5oXR5227L23gGZbGxA&oe=6AF4923F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GILI_Cover_Art_Landscape.png", "id": "917676407473077", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620817_917676410806410_582430709251488660_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gvp20PPra5YQ7kNvwFcCE8E&_nc_oc=AdoZTl4HIJaP-Msl20g5724cL6zqCvUpXTyCAOP8eoFcMTc_x_SlIYAQ1jPUUM4E8TU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpYWMk0VPKFujen_hK1NjYyXBUI9lxUB-A_zCgIW90OQ&oe=6AF46E6C"}, "display_name": "GILI", "keywords": ["social", "ocean", "adventure", "pet", "animal"], "long_description": "Welcome to Gili Island \u2014 a bright, living ocean made for exploring with friends.\n\nBy day, dive the reef to hunt and gather. By night, gather at the campfire to cook what you caught, feed your growing partners, and hatch new eggs. Every creature you raise bonds with you over time \u2014 and once it's grown, you can climb onto its back and ride across the sea.\n\nRAISE & BOND\nHatch partners from eggs and raise them through cooking. Feed, pet, and spend time together to deepen your bond \u2014 reach the top and your Best Partner's patterns light up with a bioluminescent glow.\n\nRIDE & EXPLORE\nGrow a partner to level 5, saddle up, and ride the reef. Bring friends along on multi-rider mounts and head into deeper, richer waters together.\n\nCOLLECT\nSeven partner classes and countless species await. Fill your Aquadex, earn medals, and climb the global ranks.\n\nPLAY TOGETHER\nReal-time proximity voice, fist-bump friending, co-op rescues, and shared campfires. Friends can even pet your partner to help it grow faster \u2014 because everything here is better together.\n\nFree to play. Dive in, raise your bond, and explore the ocean with friends.", "short_description": "Dive into a bright ocean world on Gili Island. Hatch sea-creature partners from eggs, raise them through campfire cooking, and ride on their backs across the reef. Explore, hunt, and collect with friends \u2014 a warm, freeform social VR adventure, best enjoyed together."}]}, "developer_name": "QU", "developer_privacy_policy_url": "https://www.gilivr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "QU", "support_website_url": null, "website_url": "https://www.gilivr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"},
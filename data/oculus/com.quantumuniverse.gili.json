KSQC6Go3566Lwg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5xSo4M2EgK70lCfFJ3EOSvI3roZIqVHXMQLn7wq3I_Q&oe=6B0841B0"}, {"file_name": "SH_4.png", "id": "2245147929614239", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/499619059_2245147932947572_402728903087453754_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s3uedUMm3YQQ7kNvwGzsPHZ&_nc_oc=AdqlJdWIQzaTgp5bFSo5u_F38F4l4xvjSGMl1Zlzk0lxbaDUcpaW07t-HzvuvNg4Tb8&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgUUeTPMsYOZv_KKvfGCNocgBuJLsxHnQwjQ4lbBXB4Q&oe=6B084AC4"}, {"file_name": "SH_5.png", "id": "995213616874358", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/499628456_995213620207691_4722429280337355731_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=afZU_KIJtnMQ7kNvwH_FlHi&_nc_oc=AdpsuuEu9LlWWphx8A33KgRVv_FO8fcI-InFEIKTtnqkmOJ3yuJ_EZD_E_vBRtdL6us&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtnWq9FFW8tMPJIAoTVpXLNmcTTc3s4Ig9ispwGqIRSA&oe=6B087369"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TRAILER_Thumbnail.png", "id": "1444351064308301", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499619059_1444351067641634_3228325142610928111_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=coMRM7ym3dUQ7kNvwFZ3kyo&_nc_oc=AdqGRX6lsswGcMtrFfe651AWi0ovmO35k6O1A-KIjgFNNRrtrLRwV_W_uVXr-Hj77Rw&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSp4XqrYmO5IHiC25CIVh57n58igtm-qofnL_J3zUuJtw&oe=6B084453"}, "display_name": "GILI", "keywords": ["social", "ocean", "adventure", "pet", "animal"], "long_description": "Welcome to Gili Island, a warm and living ocean world you explore together with friends, raising sea-creature partners of your own.\n\n\n# One ocean, day and night\nDays favor the hunt, nights favor the fire \u2014 ride the rhythm and grow faster.{2346085652597506}\n\n# Hatch your very own Partner \nA tiny new friend, ready to grow with you.{4548024612098720}\n\n# Level up, saddle up, ride out  \nExplore the ocean \u2014 alone or with friends.{1288549213830354}\n\n# Stack sand blocks. Share the fire. Fist-bump  \nBetter together.{944726784641442}\n\n\nMeet other divers: https://discord.gg/aqsxE2Dr2B", "short_description": "Dive into a bright ocean world on Gili Island. Hatch sea-creature partners from eggs, raise them through campfire cooking, and ride on their backs across the reef. Explore, hunt, and collect with friends \u2014 a warm, freeform social VR adventure, best enjoyed together."}]}, "developer_name": "QU", "developer_privacy_policy_url": "https://www.gilivr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "QU", "support_website_url": null, "website_url": "https://www.gilivr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1594628512436073"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499620666_2208117800060579_328447828643403795_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ejsLRMgFPbUQ7kNvwEsmhoC&_nc_oc=Adot2SQAGnVp3zla_wlEytSWxgiPR9m39uxMsUinsulcUE6RIHSga_zQg_ZU4ZMDyoU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_
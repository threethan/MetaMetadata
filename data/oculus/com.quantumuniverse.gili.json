EpbuWNccXbogyltODhzyq4VXH5T_paXs0cigASbV2igSpUU55j6qgijWaY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6uFmNEk8BGpknsJ3qGIbZSYOf6ZOXBhShVArF_5xwLg&oe=6AB3CAC9"}, {"file_name": "SH_4.png", "id": "2245147929614239", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619059_2245147932947572_402728903087453754_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E7k_oAfZH5QQ7kNvwHWWP_b&_nc_oc=Adry0txXbjlD_ImcwEy-ljasubBGH5cNOOx6dbCxTOnOXOIExPLzwK-Bf0ZrxcaBjmE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFgZdyA1BATVxsoHFhKoA0wUC1qbnTzg39ARPzeCqZEw&oe=6AB3EAC4"}, {"file_name": "SH_5.png", "id": "995213616874358", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499628456_995213620207691_4722429280337355731_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mjhmdkgXmlMQ7kNvwEw7qJZ&_nc_oc=AdoEEN4XkK9KytSK7Hh0WOyNauit1tAaALk-nYIlT3wLeTg8APjqnsD7jr35eKFcVyM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKva82D_eFvH1SiUGUqjsBGsyRYfRTnw2iKaHACCQfZOg&oe=6AB3DB29"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u110a\u1165\u11b7\u1102\u1166\u110b\u1175\u11af.png", "id": "1650511916494768", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622916_1650511919828101_526897810981559735_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4I0KwTqulb8Q7kNvwHy5YnA&_nc_oc=Adom-OaN_4LybLS6DHCMd3ufc3QuH4FmGRBJubfoqxD8XKnItXL8EBKE-B1lEPc-q8M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRGoAqTOa5jWHl8vdYRPnsMXAlP2_UemqJd0UqIM4W-Q&oe=6AB3E571"}, "display_name": "GILI", "keywords": ["social", "ocean", "adventure", "pet", "animal"], "long_description": "Welcome to Gili Island, a warm and living ocean world you explore together with friends, raising sea-creature partners of your own.\n\n\n# One ocean, day and night\nDays favor the hunt, nights favor the fire \u2014 ride the rhythm and grow faster.{1050655941073658}\n\n# Hatch your very own Partner \nA tiny new friend, ready to grow with you.{4548024612098720}\n\n# Level up, saddle up, ride out  \nExplore the ocean \u2014 alone or with friends.{1288549213830354}\n\n# Stack sand blocks. Share the fire. Fist-bump  \nBetter together.{944726784641442}\n\n\nMeet other divers: https://discord.gg/aqsxE2Dr2B", "short_description": "Dive into a bright ocean world on Gili Island. Hatch sea-creature partners from eggs, raise them through campfire cooking, and ride on their backs across the reef. Explore, hunt, and collect with friends \u2014 a warm, freeform social VR adventure, best enjoyed together."}]}, "developer_name": "QU", "developer_privacy_policy_url": "https://www.gilivr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "QU", "support_website_url": null, "website_url": "https://www.gilivr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1534449725120619"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619374_1628665378677892_2671456001851563237_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dafl1kaqRV0Q7kNvwFeF84h&_nc_oc=AdrdpceHuLKUjyDp_dWrc3ODtU4dIyRCgmEsCVImasrgrmKWlcgq5yZa-uG3_Q0tMuI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQISm_oyQjVe69ZYX2dsBfgtMEEoD
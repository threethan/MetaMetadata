KKBq80Yg6Mwk4A09sw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFKBJeOI0cN62xWCHlQp05eveb9A39NsOsdCf9slLXFYA&oe=6A90396D"}, {"file_name": "2 (1).png", "id": "2100771640508146", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619485_2100771643841479_4813643192745516883_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3s3yuEhX_vQQ7kNvwFzTQj7&_nc_oc=Adoy1NPIEy3w8JR0VNC1Aa6tpW3gjsEVVROGh4upVnaXMKJvUv7wNXq5d-gY2i71e_s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGFOacWdKKXsidnLbpYIryhZGA1PQg_okrd2J9XI9nzUg&oe=6A903628"}, {"file_name": "6.png", "id": "891881563610770", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619672_891881566944103_8841292866626229859_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FV4OUAcGAWEQ7kNvwHZMpQ6&_nc_oc=AdoHclOtWmX3eCbnZ98c1B3ldEFqdBCf_DORpyPuogcZEsOuKqWyWXbpLLw7aJoPO7U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHWM2Jv9gre1MCLoaBc5MryBL5r6jsVl3AapwXd_ZiJXA&oe=6A902FD5"}, {"file_name": "3.png", "id": "2064334757808515", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620817_2064334761141848_4877881492427811941_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LK7C_ZH_f5YQ7kNvwGnE06z&_nc_oc=AdrZmh5KubNU4tXuBi1T4vZ28hn0HsY_MlutWrR0ZeZ0kJqqRvLGdQQlFtYTR0W4GrA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGorxRfXFZUlwTZ20Wp-t-oJEbGuT8_0KKDb1_GsclRJw&oe=6A9027FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GILI_Cover_Art_Landscape.png", "id": "917676407473077", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620817_917676410806410_582430709251488660_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WbkQrXW_cV0Q7kNvwHyvQjs&_nc_oc=Adr428f-Wj5yZ7tHBL9zEJx4JeVzOjskSjcDFu5ziAaBKhXEeiaocs_ExRlGc7-oCE8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGOjdX7739ocZiZS1kP5Wa_ekf1XIP1ELKBtGXR53zNBg&oe=6A903C6C"}, "display_name": "GILI", "keywords": ["social", "ocean", "adventure", "pet", "animal"], "long_description": "Welcome to Gili Island \u2014 a bright, living ocean made for exploring with friends.\n\nBy day, dive the reef to hunt and gather. By night, gather at the campfire to cook what you caught, feed your growing partners, and hatch new eggs. Every creature you raise bonds with you over time \u2014 and once it's grown, you can climb onto its back and ride across the sea.\n\nRAISE & BOND\nHatch partners from eggs and raise them through cooking. Feed, pet, and spend time together to deepen your bond \u2014 reach the top and your Best Partner's patterns light up with a bioluminescent glow.\n\nRIDE & EXPLORE\nGrow a partner to level 5, saddle up, and ride the reef. Bring friends along on multi-rider mounts and head into deeper, richer waters together.\n\nCOLLECT\nSeven partner classes and countless species await. Fill your Aquadex, earn medals, and climb the global ranks.\n\nPLAY TOGETHER\nReal-time proximity voice, fist-bump friending, co-op rescues, and shared campfires. Friends can even pet your partner to help it grow faster \u2014 because everything here is better together.\n\nFree to play. Dive in, raise your bond, and explore the ocean with friends.", "short_description": "Dive into a bright ocean world on Gili Island. Hatch sea-creature partners from eggs, raise them through campfire cooking, and ride on their backs across the reef. Explore, hunt, and collect with friends \u2014 a warm, freeform social VR adventure, best enjoyed together."}]}, "developer_name": "QU", "developer_privacy_policy_url": "https://www.gilivr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "QU", "support_website_url": null, "website_url": "https://www.gilivr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"},
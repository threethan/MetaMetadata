546_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k8Zg_mENsBgQ7kNvwF6jE1c&_nc_oc=AdoPUWuORVQwdUucltwTvCCpBoqyiCx7LUSBpjviSBFltVbXFd8xeYwj3cV-DFldv2o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZTQFlDdnFKEWLMQcK45DChkIHUm-cj4-YvPZKKYeTvg&oe=6ACD16AD"}, {"file_name": "2 (1).png", "id": "2100771640508146", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619485_2100771643841479_4813643192745516883_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_2y_4GTPoqwQ7kNvwHz9RFc&_nc_oc=Adon_nz-sctyXJ8_ZmbDwkYF5wjNHkTF8hA7bBcvKNzk6cY4hzHWhOdZE-R4qxqTrGg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOF0Y9RsCBgJgIilJbUUGgasHxRq1J074E22LHCPWruqw&oe=6ACD1368"}, {"file_name": "6.png", "id": "891881563610770", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619672_891881566944103_8841292866626229859_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VEHffMWNLDwQ7kNvwHInUEe&_nc_oc=AdpzmU-HpL66-835SsP7Z2a6tf5BQovEoBiVWUDltN0FCrBeXVM5dqh1iNthr9iE5uk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO5OlH2wLRug_8NXhJDiaPYj4H1YIQyvDn48KLs9vPssA&oe=6ACD0D15"}, {"file_name": "3.png", "id": "2064334757808515", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620817_2064334761141848_4877881492427811941_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rEBzbpGMf8cQ7kNvwFGBGeS&_nc_oc=Ado0BmdC6S4s-lhjlFUejx-_FUDwig-5I30najvICFqG7hlBrBMLPRTFoB_W_B3zsb4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPCqBh02koAsmfu4TJjUcat_Z4NBpc0rkh5C2TQS8Cwuw&oe=6ACD053F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GILI_Cover_Art_Landscape.png", "id": "917676407473077", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620817_917676410806410_582430709251488660_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ujGxMv04HCMQ7kNvwGfV_qi&_nc_oc=AdozeJ2OeJ8AqJt5Gd-D96hS6LBY5_0FrSWjfRdIh5_BHmSW6guHgUzTNPO1XI3720Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPAJDOFtsyzGbo33eX6SBMio-jQdLI393gE4PDPCS3yWA&oe=6ACD19AC"}, "display_name": "GILI", "keywords": ["social", "ocean", "adventure", "pet", "animal"], "long_description": "Welcome to Gili Island \u2014 a bright, living ocean made for exploring with friends.\n\nBy day, dive the reef to hunt and gather. By night, gather at the campfire to cook what you caught, feed your growing partners, and hatch new eggs. Every creature you raise bonds with you over time \u2014 and once it's grown, you can climb onto its back and ride across the sea.\n\nRAISE & BOND\nHatch partners from eggs and raise them through cooking. Feed, pet, and spend time together to deepen your bond \u2014 reach the top and your Best Partner's patterns light up with a bioluminescent glow.\n\nRIDE & EXPLORE\nGrow a partner to level 5, saddle up, and ride the reef. Bring friends along on multi-rider mounts and head into deeper, richer waters together.\n\nCOLLECT\nSeven partner classes and countless species await. Fill your Aquadex, earn medals, and climb the global ranks.\n\nPLAY TOGETHER\nReal-time proximity voice, fist-bump friending, co-op rescues, and shared campfires. Friends can even pet your partner to help it grow faster \u2014 because everything here is better together.\n\nFree to play. Dive in, raise your bond, and explore the ocean with friends.", "short_description": "Dive into a bright ocean world on Gili Island. Hatch sea-creature partners from eggs, raise them through campfire cooking, and ride on their backs across the reef. Explore, hunt, and collect with friends \u2014 a warm, freeform social VR adventure, best enjoyed together."}]}, "developer_name": "QU", "developer_privacy_policy_url": "https://www.gilivr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "QU", "support_website_url": null, "website_url": "https://www.gilivr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534"
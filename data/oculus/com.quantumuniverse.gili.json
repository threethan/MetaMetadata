546_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S1CKSOY59zwQ7kNvwETnH84&_nc_oc=AdqI6qcUE3qBNNcIvz9-76eiOwQXhQZWLl4brn-ncmQm9ZVx57LFW1sEfDggDfeYw0Y&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNYwbjo3Fz8Td2YYL1r_RBUThPo81cP9lgSRKU0u0Nc9Q&oe=6AD0D2ED"}, {"file_name": "2 (1).png", "id": "2100771640508146", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499619485_2100771643841479_4813643192745516883_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xxknK1U9RQ0Q7kNvwFPc-Db&_nc_oc=AdpowghD_NtXoFFaIx472GRmGLKJNE-7mjRTINX_lkMng2hpp6IvCpsdD9jEtSfHaPU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN-vNsyvKfe80Ur4U-rU_90VyUVL2NFvn9m-S6R0iv0MQ&oe=6AD0CFA8"}, {"file_name": "6.png", "id": "891881563610770", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499619672_891881566944103_8841292866626229859_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hgW4WefeE8oQ7kNvwG_0rF3&_nc_oc=AdpIdyZdubyZMx-ATxGpcn6vSs45lA9NR89boevRaaRRHOFyYcTG199wHaExnXmymSM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOn-8pBefkGHl5mEmTP100byLAOQRt3tjvhhMf9V5-ttw&oe=6AD10195"}, {"file_name": "3.png", "id": "2064334757808515", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499620817_2064334761141848_4877881492427811941_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ffDgz4E4ZQ4Q7kNvwEJfgaj&_nc_oc=AdoBDhZ-GenUyWN_F_8Sr88I0YaCzJcRJU8EiRwbcTDJARCsymkQLwn-IlGQ7ugTBHA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNYtx4LT5CUyjd_BVpwUuC-afir-ewqoWNYB4BF-PCFNg&oe=6AD0F9BF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GILI_Cover_Art_Landscape.png", "id": "917676407473077", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499620817_917676410806410_582430709251488660_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vx2Nu7YmfDAQ7kNvwH7_ska&_nc_oc=AdoEkMwGYi25eiyH8Ty1s_94SOzJ8YEjVlCp_LqL58QxVg7M7JP2n7DKXxkfHdrrcto&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOtsCNab0FC1hCGdZm5r8AYt4nGq5WM3zw8e7EXklbs9w&oe=6AD0D5EC"}, "display_name": "GILI", "keywords": ["social", "ocean", "adventure", "pet", "animal"], "long_description": "Welcome to Gili Island \u2014 a bright, living ocean made for exploring with friends.\n\nBy day, dive the reef to hunt and gather. By night, gather at the campfire to cook what you caught, feed your growing partners, and hatch new eggs. Every creature you raise bonds with you over time \u2014 and once it's grown, you can climb onto its back and ride across the sea.\n\nRAISE & BOND\nHatch partners from eggs and raise them through cooking. Feed, pet, and spend time together to deepen your bond \u2014 reach the top and your Best Partner's patterns light up with a bioluminescent glow.\n\nRIDE & EXPLORE\nGrow a partner to level 5, saddle up, and ride the reef. Bring friends along on multi-rider mounts and head into deeper, richer waters together.\n\nCOLLECT\nSeven partner classes and countless species await. Fill your Aquadex, earn medals, and climb the global ranks.\n\nPLAY TOGETHER\nReal-time proximity voice, fist-bump friending, co-op rescues, and shared campfires. Friends can even pet your partner to help it grow faster \u2014 because everything here is better together.\n\nFree to play. Dive in, raise your bond, and explore the ocean with friends.", "short_description": "Dive into a bright ocean world on Gili Island. Hatch sea-creature partners from eggs, raise them through campfire cooking, and ride on their backs across the reef. Explore, hunt, and collect with friends \u2014 a warm, freeform social VR adventure, best enjoyed together."}]}, "developer_name": "QU", "developer_privacy_policy_url": "https://www.gilivr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "QU", "support_website_url": null, "website_url": "https://www.gilivr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534"
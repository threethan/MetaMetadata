546_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k8Zg_mENsBgQ7kNvwE1NCJV&_nc_oc=Ado-IP_uNgkCElLfUqIoU1sF6LuIKqjU0KYSkbzvEMM_ZuZaB5ZzwhMPQkeyWksEHGE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMWbjn5cWtAiS9LiA4q5tdortgECgTG2KYUAU9Z2BU1sQ&oe=6ACB8CED"}, {"file_name": "2 (1).png", "id": "2100771640508146", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619485_2100771643841479_4813643192745516883_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_2y_4GTPoqwQ7kNvwEjlbee&_nc_oc=AdqCBcDbdtYIzV2qpkFdM7qKXLLWfhclAKOWFH-QOzhS7Cp_9lApLWTlBt9kTHgPb48&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_mYvPWgth_8Jhniw2bFGMz7763sspeZ_-0EJIEth1Uw&oe=6ACBC1E8"}, {"file_name": "6.png", "id": "891881563610770", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619672_891881566944103_8841292866626229859_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VEHffMWNLDwQ7kNvwFPVP3f&_nc_oc=AdpI_5LiU4fIqrQNRej0rvYVHyGx_M7RvWwnchtORZr-jMhAusf_m9ObfHPjhkXaDIQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNe3Apgyc9xgcQC3_gUWXfV1kV3D8u7EmaCt6rFuatzsg&oe=6ACBBB95"}, {"file_name": "3.png", "id": "2064334757808515", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620817_2064334761141848_4877881492427811941_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RMkhL5fgFpAQ7kNvwFY1eGt&_nc_oc=AdqPi_2MMcIBJEQTQ5kUvC7DRsY7ynVwyjEoPFulFmwmi8Pk35UZlsec9VoNgKBLkmc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIPJjB2nXwRJYWi23r-IqWqR2k_2nIxni0YO-SEmAqbw&oe=6ACBB3BF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GILI_Cover_Art_Landscape.png", "id": "917676407473077", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620817_917676410806410_582430709251488660_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hCbhhBhkUKMQ7kNvwF5HIGI&_nc_oc=AdqJTc_X8Aj3it8gcAl_DXda91DQFgJVz6VF6FaUOTCTEY5lNNohV_HAMyBMGkQBnDU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJg5Wqq6yIY7EpN8Pls-DHNgdYy-34JrcpmPrA-Wga_A&oe=6ACB8FEC"}, "display_name": "GILI", "keywords": ["social", "ocean", "adventure", "pet", "animal"], "long_description": "Welcome to Gili Island \u2014 a bright, living ocean made for exploring with friends.\n\nBy day, dive the reef to hunt and gather. By night, gather at the campfire to cook what you caught, feed your growing partners, and hatch new eggs. Every creature you raise bonds with you over time \u2014 and once it's grown, you can climb onto its back and ride across the sea.\n\nRAISE & BOND\nHatch partners from eggs and raise them through cooking. Feed, pet, and spend time together to deepen your bond \u2014 reach the top and your Best Partner's patterns light up with a bioluminescent glow.\n\nRIDE & EXPLORE\nGrow a partner to level 5, saddle up, and ride the reef. Bring friends along on multi-rider mounts and head into deeper, richer waters together.\n\nCOLLECT\nSeven partner classes and countless species await. Fill your Aquadex, earn medals, and climb the global ranks.\n\nPLAY TOGETHER\nReal-time proximity voice, fist-bump friending, co-op rescues, and shared campfires. Friends can even pet your partner to help it grow faster \u2014 because everything here is better together.\n\nFree to play. Dive in, raise your bond, and explore the ocean with friends.", "short_description": "Dive into a bright ocean world on Gili Island. Hatch sea-creature partners from eggs, raise them through campfire cooking, and ride on their backs across the reef. Explore, hunt, and collect with friends \u2014 a warm, freeform social VR adventure, best enjoyed together."}]}, "developer_name": "QU", "developer_privacy_policy_url": "https://www.gilivr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "QU", "support_website_url": null, "website_url": "https://www.gilivr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534"
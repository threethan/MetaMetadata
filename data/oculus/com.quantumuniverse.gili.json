546_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S1CKSOY59zwQ7kNvwGtrK9e&_nc_oc=Adqw5_IS12FRmcmfm5shZe679wQX7k0JKRl79iQvVrNxL3tUDGSnQ-cUEd5N1IrluTE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOikr4Wpnc8Cw99vJpt2_RYvG_OhOOcTFXkz6V41X28lA&oe=6ACF816D"}, {"file_name": "2 (1).png", "id": "2100771640508146", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619485_2100771643841479_4813643192745516883_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xxknK1U9RQ0Q7kNvwELPtzK&_nc_oc=AdpKVp_AA72a4gAiZiCc0myK52KbptpNmuVpmPeOSnJzJs0Qm5VT_3bbwtSv7QTaby8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOPJck1IyEJuG2l204JQiX1f3GrusV10B1trvD5FwTvyw&oe=6ACFB668"}, {"file_name": "6.png", "id": "891881563610770", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619672_891881566944103_8841292866626229859_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hgW4WefeE8oQ7kNvwF1P55X&_nc_oc=Ado1OGFgjKPqyRkVCRlUFRSH-ZURHs_Tcf8Yhn5jdSWekQyt-WqSL_rmW6FvfFWF8F4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQODTBQTlzRq7L3fHXpTbRCOwqYUZ8qDnsm5qz-bU_vl3g&oe=6ACFB015"}, {"file_name": "3.png", "id": "2064334757808515", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620817_2064334761141848_4877881492427811941_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rEBzbpGMf8cQ7kNvwGRWIBO&_nc_oc=AdqnMjJed2P7q_rRTpAXsoukFaiIfcIKBdMs9GXR6R4Ot2qWnn7hHj5qNHt3gT29fnI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPMPmqPPLYcPyQENDcYZQFHplpxPTHa-DZKnox80ui6SA&oe=6ACFA83F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GILI_Cover_Art_Landscape.png", "id": "917676407473077", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620817_917676410806410_582430709251488660_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ujGxMv04HCMQ7kNvwGVQIXP&_nc_oc=Adp3Zz1_MGG0s3lOhGw3m52TdlJlqnI3Kftm_eCJk0tolOg0NRH1m3A9_IzPnF15FLg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPOaSBRxYRflK1C2b-AV9uDZHWl5uPGgVhFpmxNnOhhbw&oe=6ACF846C"}, "display_name": "GILI", "keywords": ["social", "ocean", "adventure", "pet", "animal"], "long_description": "Welcome to Gili Island \u2014 a bright, living ocean made for exploring with friends.\n\nBy day, dive the reef to hunt and gather. By night, gather at the campfire to cook what you caught, feed your growing partners, and hatch new eggs. Every creature you raise bonds with you over time \u2014 and once it's grown, you can climb onto its back and ride across the sea.\n\nRAISE & BOND\nHatch partners from eggs and raise them through cooking. Feed, pet, and spend time together to deepen your bond \u2014 reach the top and your Best Partner's patterns light up with a bioluminescent glow.\n\nRIDE & EXPLORE\nGrow a partner to level 5, saddle up, and ride the reef. Bring friends along on multi-rider mounts and head into deeper, richer waters together.\n\nCOLLECT\nSeven partner classes and countless species await. Fill your Aquadex, earn medals, and climb the global ranks.\n\nPLAY TOGETHER\nReal-time proximity voice, fist-bump friending, co-op rescues, and shared campfires. Friends can even pet your partner to help it grow faster \u2014 because everything here is better together.\n\nFree to play. Dive in, raise your bond, and explore the ocean with friends.", "short_description": "Dive into a bright ocean world on Gili Island. Hatch sea-creature partners from eggs, raise them through campfire cooking, and ride on their backs across the reef. Explore, hunt, and collect with friends \u2014 a warm, freeform social VR adventure, best enjoyed together."}]}, "developer_name": "QU", "developer_privacy_policy_url": "https://www.gilivr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "QU", "support_website_url": null, "website_url": "https://www.gilivr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534"
=1-7&_nc_sid=6e7a0a&_nc_ohc=MwVhBMXEVKEQ7kNvwFhs0tu&_nc_oc=Adp8GxjvXW6LTqNtj01RbQ0Q9KMvNNRmYOl0N1CxJZrlDIWKSuX8yu5hvnLINrAD7UU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrLSPXEVijve0wfPavLSmJT7g4T-vuLZx0m_QYJOGVjw&oe=6AF3522D"}, {"file_name": "2 (1).png", "id": "2100771640508146", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619485_2100771643841479_4813643192745516883_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f1wjIXTGq4IQ7kNvwFJsFqL&_nc_oc=Adq_9V8zEIrDb7_UUqENISs8hjkPrfPLrP_CPIxMf88MBJEtQ_jtYJhrJvKsVkGtmSI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYlOBdsgXAqmytAreTiCEZyNqpcNAVUXgiSUn55U07xw&oe=6AF34EE8"}, {"file_name": "6.png", "id": "891881563610770", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619672_891881566944103_8841292866626229859_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K8AuA81Z6DMQ7kNvwFVKRV8&_nc_oc=Ado1e6_TWzBvCjzfSgU6teAA3lXRklVBsZnefzsOgS-2YuEAleNZ5tkrQvAwg2_hw0U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTX3JRVHQQxI-BZZO7k2zPHX8YSZoLH9SyJGwSPO5cYBg&oe=6AF34895"}, {"file_name": "3.png", "id": "2064334757808515", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620817_2064334761141848_4877881492427811941_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pN7N-aVXnvAQ7kNvwGY2daR&_nc_oc=AdqQ6IpnD1nXD7-0d4GiBobXQ2iVD8qyb2ND4GJpWq9jDLmhP2k7_HI9uMsi6CVU9-M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR60Wsi-9C65TEWiHXJgLAy2EahjPa292Baad7AvcMCPQ&oe=6AF340BF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GILI_Cover_Art_Landscape.png", "id": "917676407473077", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620817_917676410806410_582430709251488660_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H4ieYCcfg_EQ7kNvwGZfR1n&_nc_oc=AdrJxVdPka66rl6gcxXh_xVpAwQHJkidU7M4a4oKN8WPbtgwZRvAhOm80kyEcq7NCKA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGrlbreQAOArF5xNxC9rZinz1NCAPPn1MhsjPmnB6_iA&oe=6AF3552C"}, "display_name": "GILI", "keywords": ["social", "ocean", "adventure", "pet", "animal"], "long_description": "Welcome to Gili Island \u2014 a bright, living ocean made for exploring with friends.\n\nBy day, dive the reef to hunt and gather. By night, gather at the campfire to cook what you caught, feed your growing partners, and hatch new eggs. Every creature you raise bonds with you over time \u2014 and once it's grown, you can climb onto its back and ride across the sea.\n\nRAISE & BOND\nHatch partners from eggs and raise them through cooking. Feed, pet, and spend time together to deepen your bond \u2014 reach the top and your Best Partner's patterns light up with a bioluminescent glow.\n\nRIDE & EXPLORE\nGrow a partner to level 5, saddle up, and ride the reef. Bring friends along on multi-rider mounts and head into deeper, richer waters together.\n\nCOLLECT\nSeven partner classes and countless species await. Fill your Aquadex, earn medals, and climb the global ranks.\n\nPLAY TOGETHER\nReal-time proximity voice, fist-bump friending, co-op rescues, and shared campfires. Friends can even pet your partner to help it grow faster \u2014 because everything here is better together.\n\nFree to play. Dive in, raise your bond, and explore the ocean with friends.", "short_description": "Dive into a bright ocean world on Gili Island. Hatch sea-creature partners from eggs, raise them through campfire cooking, and ride on their backs across the reef. Explore, hunt, and collect with friends \u2014 a warm, freeform social VR adventure, best enjoyed together."}]}, "developer_name": "QU", "developer_privacy_policy_url": "https://www.gilivr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "QU", "support_website_url": null, "website_url": "https://www.gilivr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1476549980910594"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1058811040396730"}]}, "baseline_offer": {"id": "1058811040396730"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1787212800, "status": "PUBLISHED", "id": "1058811040396730"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1582179433680981", "version": "0.1.7+858"}, "id": "1573754527670796", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1476549977577261", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1582179433680981"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1573754527670796"}]}, "change_log": "Krakteuth awakens! The Deep Hole goes deeper, and a giant octopus waits at the bottom.\n\n- New boss: Krakteuth. Open its temple door deep in the Deep Hole and take it down with friends.\n- Krakteuth is now a partner with its own skill, Ink Jet. Win its egg in battle, or get the new Krakteuth Bundle: Krakteuth Egg + Parrot Set + 7000 Pearls.\n- Shiny partners are here! Look for rare colors in the wild.\n- New wild partner: Chico, a little shark in the lagoon by the village. Skill: Cling Bite.\n- New Buddy system: help new divers and earn Pearls and Buddy outfits. New players get a step-by-step guide and a 750 Shell welcome gift.\n- Daily quests remade: 33 quests, and each one only needs to be done once.\n- Halloween has ended. Leftover Candy has been turned into Shells (1 Candy = 10 Shells).\n- Also: giant jellyfish in the Deep Hole, new weapons, the Ossmos Egg, Uncle Steve's Blue Hat, and many fixes and improvements.", "created_date": 1793859596, "id": "1582179433680981", "version": "0.1.7+858", "version_code": 858, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1476549977577261", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1582179433680981"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1793859341, "id": "1582176430347948", "version": "0.1.7+857", "version_code": 857, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1476549977577261", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1582179433680981"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1793859026, "id": "1582172337015024", "version": "0.1.7+856", "version_code": 856, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": 
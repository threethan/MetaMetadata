2064334761141848_4877881492427811941_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n6m9p779NF8Q7kNvwGTvD8e&_nc_oc=Adp1lCGm0q-c20yw6KrV5X5aWDygdK2E431wQg17c_gKfCKmI1Yn8Omggbxe-kg7j6k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYMLFYJsaff2_oEZ2bJk95lf8wyFNBVNuo7TpO9_F0Tw&oe=6B09AA3F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GILI_Cover_Art_Landscape.png", "id": "917676407473077", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620817_917676410806410_582430709251488660_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jjR3FQmALZUQ7kNvwGxCIML&_nc_oc=AdodGq3NSFwvNrEbiwpmBZyffwqhajsx5m6mDACmuTLrndvnIFvL3A0OseuPNh0MYXA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-OU56of33k1RpIjUtDajYAIOs3AfPF4UdN1Qs9b-fww&oe=6B09BEAC"}, "display_name": "GILI", "keywords": ["social", "ocean", "adventure", "pet", "animal"], "long_description": "Welcome to Gili Island \u2014 a bright, living ocean made for exploring with friends.\n\nBy day, dive the reef to hunt and gather. By night, gather at the campfire to cook what you caught, feed your growing partners, and hatch new eggs. Every creature you raise bonds with you over time \u2014 and once it's grown, you can climb onto its back and ride across the sea.\n\nRAISE & BOND\nHatch partners from eggs and raise them through cooking. Feed, pet, and spend time together to deepen your bond \u2014 reach the top and your Best Partner's patterns light up with a bioluminescent glow.\n\nRIDE & EXPLORE\nGrow a partner to level 5, saddle up, and ride the reef. Bring friends along on multi-rider mounts and head into deeper, richer waters together.\n\nCOLLECT\nSeven partner classes and countless species await. Fill your Aquadex, earn medals, and climb the global ranks.\n\nPLAY TOGETHER\nReal-time proximity voice, fist-bump friending, co-op rescues, and shared campfires. Friends can even pet your partner to help it grow faster \u2014 because everything here is better together.\n\nFree to play. Dive in, raise your bond, and explore the ocean with friends.", "short_description": "Dive into a bright ocean world on Gili Island. Hatch sea-creature partners from eggs, raise them through campfire cooking, and ride on their backs across the reef. Explore, hunt, and collect with friends \u2014 a warm, freeform social VR adventure, best enjoyed together."}]}, "developer_name": "QU", "developer_privacy_policy_url": "https://www.gilivr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "QU", "support_website_url": null, "website_url": "https://www.gilivr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1476549980910594"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1058811040396730"}]}, "baseline_offer": {"id": "1058811040396730"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1787212800, "status": "PUBLISHED", "id": "1058811040396730"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1595599502338974", "version": "0.1.9+889"}, "id": "1573754527670796", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typenam
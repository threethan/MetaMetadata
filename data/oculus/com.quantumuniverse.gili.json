546_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S1CKSOY59zwQ7kNvwEt1cHL&_nc_oc=Adp2nSOi6NLRmwVwd7iMzYmfmWcOPmeL5Dq91wHlz3iVEjNv8UY3tyCDmrj_vVIslEI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNIysPyOuHdFFKyqhMiP6Skn5jySvmrMau_cje68Suw3Q&oe=6AD2246D"}, {"file_name": "2 (1).png", "id": "2100771640508146", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619485_2100771643841479_4813643192745516883_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xxknK1U9RQ0Q7kNvwEC0zG2&_nc_oc=AdrebCz6qO8rnlTpSCzKwR61_hMs4vUIDRo-GfGZh7161eFkyFTJCaVW14N73WAh9Gk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO5uc8hyWCrLjQkp0VBkSQZjE_Pucz2BC1a5eCc85p8aQ&oe=6AD25968"}, {"file_name": "6.png", "id": "891881563610770", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619672_891881566944103_8841292866626229859_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PoElKgHd5uoQ7kNvwGE6FK5&_nc_oc=Adr1UpqWSoLR-eCAn2Cjaqep8VBT0eyq9iyogvzzVAa838rb2zpQxSA1xSWPvQPJD4U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPQ7oeUUKAsD1Oqcua8_V_IWYDoPEKCkM9vXIjPQ8dGTQ&oe=6AD25315"}, {"file_name": "3.png", "id": "2064334757808515", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620817_2064334761141848_4877881492427811941_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ffDgz4E4ZQ4Q7kNvwGEcrlp&_nc_oc=AdqwGsMEB6IoLKepRL6qWCYPU1toEXqPZ_gK1-j8K4QSuv2tozrO6KEpTk3bowuDoVQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNRqSgUj5UYXVwioDQt-zotqQFmm99N81g219Ja3NDJEQ&oe=6AD24B3F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GILI_Cover_Art_Landscape.png", "id": "917676407473077", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620817_917676410806410_582430709251488660_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vx2Nu7YmfDAQ7kNvwE5yZpR&_nc_oc=AdpZVxaxqs9DHXf_JteQAWFe9i-zkU76SUcYZ6l03DqMavt6VnJGYmbRReuOnp8Qwqw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNyrdar2w8tuDtSVgcNntMQ4RnqKhaMe2enEPN2UrxKsw&oe=6AD2276C"}, "display_name": "GILI", "keywords": ["social", "ocean", "adventure", "pet", "animal"], "long_description": "Welcome to Gili Island \u2014 a bright, living ocean made for exploring with friends.\n\nBy day, dive the reef to hunt and gather. By night, gather at the campfire to cook what you caught, feed your growing partners, and hatch new eggs. Every creature you raise bonds with you over time \u2014 and once it's grown, you can climb onto its back and ride across the sea.\n\nRAISE & BOND\nHatch partners from eggs and raise them through cooking. Feed, pet, and spend time together to deepen your bond \u2014 reach the top and your Best Partner's patterns light up with a bioluminescent glow.\n\nRIDE & EXPLORE\nGrow a partner to level 5, saddle up, and ride the reef. Bring friends along on multi-rider mounts and head into deeper, richer waters together.\n\nCOLLECT\nSeven partner classes and countless species await. Fill your Aquadex, earn medals, and climb the global ranks.\n\nPLAY TOGETHER\nReal-time proximity voice, fist-bump friending, co-op rescues, and shared campfires. Friends can even pet your partner to help it grow faster \u2014 because everything here is better together.\n\nFree to play. Dive in, raise your bond, and explore the ocean with friends.", "short_description": "Dive into a bright ocean world on Gili Island. Hatch sea-creature partners from eggs, raise them through campfire cooking, and ride on their backs across the reef. Explore, hunt, and collect with friends \u2014 a warm, freeform social VR adventure, best enjoyed together."}]}, "developer_name": "QU", "developer_privacy_policy_url": "https://www.gilivr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "QU", "support_website_url": null, "website_url": "https://www.gilivr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534"
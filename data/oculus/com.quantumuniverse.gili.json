tvxRh3Qajp2jIZphTzHwZ0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQV1_3Ue_ZP4znJmPZc_V519CuGTR1qiTJnhExXwkWEw&oe=6AE75544"}, {"file_name": "SH_5.png", "id": "995213616874358", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499628456_995213620207691_4722429280337355731_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WKS07XS1blUQ7kNvwHXcoZP&_nc_oc=AdpW3jaauepFRoLyx_uTwBWbIunSxbt2MQw9G-JjtMYLqhg5fvdSGGc987JSE5iim6o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSP_SumcD99R2o7-97Z07jgmgiwIbDDmMZsheJe-mzUQQ&oe=6AE745A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u110a\u1165\u11b7\u1102\u1166\u110b\u1175\u11af (2).png", "id": "1918780102417272", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620341_1918780105750605_2101913115231150428_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-0aPKS_f2SEQ7kNvwGSNOEX&_nc_oc=AdpIaUnAnLZF5tAEbposPCHL-kp7BrqPmRxETcTsrASQuEsjh04Sp8Lymr2HV_YmbfM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFjGIHsUIMkTa-o_H0zwBqps0TI-5Df9AyF1hb2q6mWQ&oe=6AE7589B"}, "display_name": "GILI", "keywords": ["social", "ocean", "adventure", "pet", "animal"], "long_description": "Welcome to Gili Island, a warm and living ocean world you explore together with friends, raising sea-creature partners of your own.\n\n\n# One ocean, day and night\nDays favor the hunt, nights favor the fire \u2014 ride the rhythm and grow faster.{1050655941073658}\n\n# Hatch your very own Partner \nA tiny new friend, ready to grow with you.{4548024612098720}\n\n# Level up, saddle up, ride out  \nExplore the ocean \u2014 alone or with friends.{1288549213830354}\n\n# Stack sand blocks. Share the fire. Fist-bump  \nBetter together.{944726784641442}\n\n\nMeet other divers: https://discord.gg/aqsxE2Dr2B", "short_description": "Dive into a bright ocean world on Gili Island. Hatch sea-creature partners from eggs, raise them through campfire cooking, and ride on their backs across the reef. Explore, hunt, and collect with friends \u2014 a warm, freeform social VR adventure, best enjoyed together."}]}, "developer_name": "QU", "developer_privacy_policy_url": "https://www.gilivr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "QU", "support_website_url": null, "website_url": "https://www.gilivr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1560044909227767"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619059_1079116718327798_2573714728632772625_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3-9Q1FquuykQ7kNvwHpPOLc&_nc_oc=AdrQmlzrBbXRw0EoGVIzhmi6W_AUbZJqomAGdjmvNuia5tJMynMbQmzMB8ghb91O4YM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRiOuxNEV9TZX_EXfOElP2-zcLjP3xWsW0X9Oq25GAI8A&oe=6AE74D23"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GILI", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Hangout", "id": "1023770785722696"}, {"topic_name": "Platformer", "id": "528142316460358"}]
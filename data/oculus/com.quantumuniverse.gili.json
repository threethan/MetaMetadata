546_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZNxF5BxNhPIQ7kNvwGb-T1q&_nc_oc=AdqmefyLrXXfsPruAqBzaSALBiL3yo83GpSSyErqB9pFDCcUwyz4Nb3N_3cs6kBp1bA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN9k9HNi5PcxL0LhGRRsoAPHiRg73tRa4ZPUf2A5lT2GQ&oe=6AD3AE2D"}, {"file_name": "2 (1).png", "id": "2100771640508146", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499619485_2100771643841479_4813643192745516883_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nhordmRGfWEQ7kNvwHhqMtL&_nc_oc=Adr98DOcEowWghh9T3jXxaC44zoqI_ITYx7mZMD1A8XjlRhIkmiMI3T_xXrAWiOxUPI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7-FuN9CG3yK6riB1VRIBYLtr65fjgcNlZCs9OA00Vbg&oe=6AD3AAE8"}, {"file_name": "6.png", "id": "891881563610770", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499619672_891881566944103_8841292866626229859_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PoElKgHd5uoQ7kNvwHaVCjh&_nc_oc=Adon6d9Pm4ZbP1DSSDWOLrejI2i1B3oPWM7B_4vR-Nqkea9NMqyPfIdHE6JqGy2tFgE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMWAUj7PpQIOtlP3S9aE1mi5KTFrIQWzMidnICoNIF-1Q&oe=6AD3A495"}, {"file_name": "3.png", "id": "2064334757808515", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499620817_2064334761141848_4877881492427811941_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ffDgz4E4ZQ4Q7kNvwExbn32&_nc_oc=Ado8VIrHF5Ch-6ZTDQ9qG0lyS5SJAI_sbmOZwmKlzioPMuzWWSlqUDrDl493lN_njhs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNLgCo3nw8fMUYHLRdd3cBKOuMj45onFufQfk8mEYZmOA&oe=6AD39CBF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GILI_Cover_Art_Landscape.png", "id": "917676407473077", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499620817_917676410806410_582430709251488660_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vx2Nu7YmfDAQ7kNvwH9KXT9&_nc_oc=AdosnDmS9M9xsm-MI3TK0MTBY1K1ciqLpZDI-AyyJeH2NSLuFr4z8YsdRrA_oFHtbpQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOu8bVpwHybzw_PCW2hAkunfb0iK7mwlrXndf8HfJe-Ag&oe=6AD3B12C"}, "display_name": "GILI", "keywords": ["social", "ocean", "adventure", "pet", "animal"], "long_description": "Welcome to Gili Island \u2014 a bright, living ocean made for exploring with friends.\n\nBy day, dive the reef to hunt and gather. By night, gather at the campfire to cook what you caught, feed your growing partners, and hatch new eggs. Every creature you raise bonds with you over time \u2014 and once it's grown, you can climb onto its back and ride across the sea.\n\nRAISE & BOND\nHatch partners from eggs and raise them through cooking. Feed, pet, and spend time together to deepen your bond \u2014 reach the top and your Best Partner's patterns light up with a bioluminescent glow.\n\nRIDE & EXPLORE\nGrow a partner to level 5, saddle up, and ride the reef. Bring friends along on multi-rider mounts and head into deeper, richer waters together.\n\nCOLLECT\nSeven partner classes and countless species await. Fill your Aquadex, earn medals, and climb the global ranks.\n\nPLAY TOGETHER\nReal-time proximity voice, fist-bump friending, co-op rescues, and shared campfires. Friends can even pet your partner to help it grow faster \u2014 because everything here is better together.\n\nFree to play. Dive in, raise your bond, and explore the ocean with friends.", "short_description": "Dive into a bright ocean world on Gili Island. Hatch sea-creature partners from eggs, raise them through campfire cooking, and ride on their backs across the reef. Explore, hunt, and collect with friends \u2014 a warm, freeform social VR adventure, best enjoyed together."}]}, "developer_name": "QU", "developer_privacy_policy_url": "https://www.gilivr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "QU", "support_website_url": null, "website_url": "https://www.gilivr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534"
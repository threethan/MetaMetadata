&_nc_ss=7f20f&oh=00_AQRLk4-Gtth6rRaL-CoZCRejNt8PH2hgSwr8lpxEqBMo6A&oe=6B0058B0"}, {"file_name": "SH_4.png", "id": "2245147929614239", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619059_2245147932947572_402728903087453754_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=90qyThDiVpwQ7kNvwFYkijk&_nc_oc=Adr_7TMpummFOmUUl5T2QweMMugoHTdGRhfXxzQPdUT7kZnRaAivFVXGA20op0vm6JQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSA1YnNUv_0MhXQY9SbpG9lNV6-vxUKOnY9AB_Rx_67kQ&oe=6B0061C4"}, {"file_name": "SH_5.png", "id": "995213616874358", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499628456_995213620207691_4722429280337355731_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h15AcYyVq9MQ7kNvwFAf_be&_nc_oc=Adp_tGQIJyuokW8q1BV3_XUGCEDorHRIFUAwZCVRex61Plt1RUQvpCtQxoXtgzU8s9Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0awi1_ydzoRxzHJ91hA0_f2uro7obYDJTwRMk6qlRkg&oe=6B005229"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TRAILER_Thumbnail.png", "id": "1444351064308301", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619059_1444351067641634_3228325142610928111_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mCd4E1AWcU8Q7kNvwFItKZT&_nc_oc=AdopyWoF-kljKpsYUIILsS1qtpZZtdh9P0CypX17h3UkA7_XP5qaKjARIJHR1bLkOF4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXxHonPcnV3U_MZ3s-9PSbTPUbJArHEmXH4ICn46TMVw&oe=6B005B53"}, "display_name": "GILI", "keywords": ["social", "ocean", "adventure", "pet", "animal"], "long_description": "Welcome to Gili Island, a warm and living ocean world you explore together with friends, raising sea-creature partners of your own.\n\n\n# One ocean, day and night\nDays favor the hunt, nights favor the fire \u2014 ride the rhythm and grow faster.{2346085652597506}\n\n# Hatch your very own Partner \nA tiny new friend, ready to grow with you.{4548024612098720}\n\n# Level up, saddle up, ride out  \nExplore the ocean \u2014 alone or with friends.{1288549213830354}\n\n# Stack sand blocks. Share the fire. Fist-bump  \nBetter together.{944726784641442}\n\n\nMeet other divers: https://discord.gg/aqsxE2Dr2B", "short_description": "Dive into a bright ocean world on Gili Island. Hatch sea-creature partners from eggs, raise them through campfire cooking, and ride on their backs across the reef. Explore, hunt, and collect with friends \u2014 a warm, freeform social VR adventure, best enjoyed together."}]}, "developer_name": "QU", "developer_privacy_policy_url": "https://www.gilivr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "QU", "support_website_url": null, "website_url": "https://www.gilivr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1590782699487321"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620666_2208117800060579_328447828643403795_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iGmBklNO9TcQ7kNvwGJB9W7&_nc_oc=AdqqR9--0bjn7qZmFZGErjDCHKVP65XzKKfZj0E4Xejq2W-yeUr7So3l8MmfxRSrAR4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSN3-QldoVsJOcts91epdHqHoBCrn1j1U6rUBsosfJk-Q&oe=6B005D02"}
546_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k8Zg_mENsBgQ7kNvwGO9PPy&_nc_oc=AdqMWxFNMNWLweo-5Oeh-yNPmsFbcarzLuZ3n-RQlepi1wEfx-kRw6E7j9ul-he4SrU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMyDXZ84JgqAt6fn773ApWCIEHWE3U5U9L60yOMcx4u0w&oe=6ACE682D"}, {"file_name": "2 (1).png", "id": "2100771640508146", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619485_2100771643841479_4813643192745516883_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_2y_4GTPoqwQ7kNvwGWOLCD&_nc_oc=Ado3_YamXjNFisWdWQxNhzh5q89Om2uF_5se6FXYsQYHZ9i7SlJn6Op3b8Pg8uov5Ng&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMd1HhTk4DBO6Por9g3SjT3pvAAHiRSvarbMAJi6HedOQ&oe=6ACE64E8"}, {"file_name": "6.png", "id": "891881563610770", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619672_891881566944103_8841292866626229859_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hgW4WefeE8oQ7kNvwHjaMhT&_nc_oc=AdrheqH0tq5iFl_fxZmq7b6Vcwy0zQGM0GvXZLhoileXxQeuJwDeVlOK9yZ0ADwYyfQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMW8GtbZq-EKig1Ld4yH8t6vPrlYO-Dn5cPsrYTCisq3A&oe=6ACE5E95"}, {"file_name": "3.png", "id": "2064334757808515", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620817_2064334761141848_4877881492427811941_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rEBzbpGMf8cQ7kNvwHGlsF3&_nc_oc=AdqrF3MFexePvJ4uje3V5EYoRa5FXSxIfLywzJb6T1--OvxHXpaJpolsyGPxbH-0tSY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMO0Lv2PmazmiiBhRC7x-wU83u-jkKQskdhjfmMnP61ow&oe=6ACE56BF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GILI_Cover_Art_Landscape.png", "id": "917676407473077", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620817_917676410806410_582430709251488660_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ujGxMv04HCMQ7kNvwE32B8m&_nc_oc=Adrh7gT6lIJvMdjrG4SlVMglRy-lGg4Tf3KR-xXXQ8WLRn8fHpv5A5DVp4DJCacO4rI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2Udu3QHbPbGmQGhy-gwWjYDQ8DBY74h7yuBbhGAwaPw&oe=6ACE6B2C"}, "display_name": "GILI", "keywords": ["social", "ocean", "adventure", "pet", "animal"], "long_description": "Welcome to Gili Island \u2014 a bright, living ocean made for exploring with friends.\n\nBy day, dive the reef to hunt and gather. By night, gather at the campfire to cook what you caught, feed your growing partners, and hatch new eggs. Every creature you raise bonds with you over time \u2014 and once it's grown, you can climb onto its back and ride across the sea.\n\nRAISE & BOND\nHatch partners from eggs and raise them through cooking. Feed, pet, and spend time together to deepen your bond \u2014 reach the top and your Best Partner's patterns light up with a bioluminescent glow.\n\nRIDE & EXPLORE\nGrow a partner to level 5, saddle up, and ride the reef. Bring friends along on multi-rider mounts and head into deeper, richer waters together.\n\nCOLLECT\nSeven partner classes and countless species await. Fill your Aquadex, earn medals, and climb the global ranks.\n\nPLAY TOGETHER\nReal-time proximity voice, fist-bump friending, co-op rescues, and shared campfires. Friends can even pet your partner to help it grow faster \u2014 because everything here is better together.\n\nFree to play. Dive in, raise your bond, and explore the ocean with friends.", "short_description": "Dive into a bright ocean world on Gili Island. Hatch sea-creature partners from eggs, raise them through campfire cooking, and ride on their backs across the reef. Explore, hunt, and collect with friends \u2014 a warm, freeform social VR adventure, best enjoyed together."}]}, "developer_name": "QU", "developer_privacy_policy_url": "https://www.gilivr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "QU", "support_website_url": null, "website_url": "https://www.gilivr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534"
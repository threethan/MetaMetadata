atest_released_binary": {"__typename": "AndroidBinary", "id": "1575157477716510"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1793265475, "id": "1575217481043843", "version": "0.1.7+834", "version_code": 834, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1476549977577261", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1575157477716510"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1793263436, "id": "1575195041046087", "version": "0.1.7+833", "version_code": 833, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1476549977577261", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1575157477716510"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1793262199, "id": "1575181294380795", "version": "0.1.7+832", "version_code": 832, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1476549977577261", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1575157477716510"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1573754527670796"}]}, "change_log": "Palaton has arrived! A giant clawed boss now lurks under the raft.\n\n- New wild boss: Palaton. Fish from the raft with the new Palaton Fishing Rod and it may rise - fight it together with friends.\n- Palaton is now a partner! Palaton Eggs are in the Egg Shop, with its own skill, Palaton Punch.\n- Palaton Fishing Rod: use it to catch Palaton (unlocks after the basic rod).\n- Hunting eggs: one hit is now enough to join the egg roll, and anyone within 150 m of the fight counts.\n- Partners now jump into fights alongside you, even when you aren't riding them.\n- Party kicks are now decided by a vote.\n- Richer controller vibration across the game.\n- New title screen.\n- Balance: Delfi oxygen rings and Limulith Iron Shell adjusted.\n- Uncle Steve's Red Hat is leaving the shop soon.\n- Fixed falling under the floor after using the Meta button or switching apps.\n- Bundle outfits now equip every piece at once.\n- Map now covers the whole sea.\n- Removed daily quests that couldn't be completed.", "created_date": 1793260158, "id": "1575157477716510", "version": "0.1.6+830", "version_code": 830, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
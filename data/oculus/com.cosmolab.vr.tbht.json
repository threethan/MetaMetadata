82723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a-HR3p1nYuQQ7kNvwEvWzB3&_nc_oc=Adk24X7LYqz1AvrljsjUkkxdFuOvxxklC03iGJobwJk15kP9GEV3AFd2_Tr8K09Ogs0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxdV2_9WrWEFms0oamy5tFq83WOZjFzkONPn9SJD8Qr2g&oe=69B15D05"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=641RI5tyqcYQ7kNvwHKrwmF&_nc_oc=AdmBzuct5Cnuce5NezRFSyqo-5Q3w6o3X3BoOU-nvDCo0buYJhJMDqkgESQYWODXbDU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxsIDdJ5to0x957OLZWKdLOUF4YKbO1Dp8fUWqbJ8_Oxw&oe=69B156CD"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I5f4ckG_CdgQ7kNvwFDaccq&_nc_oc=Adm0Hmw00Q-Qs9xYi877K5wWecczxY2LcMWMyAOaoKdA4MtqBN3tYqkzOUL6iI2CWJM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzAtIMHh1Srh0N3QP9k2Q2K-L_lGkJjIz_2eRL3rYSKFA&oe=69B15821"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=22NpaUTtoV8Q7kNvwGsMyLs&_nc_oc=AdnNuoIpPVFI4QuuhR50sQ70y1uj6uuKGjEFpgtxioMEPnFUlOo2q6s7S_Sb9gjF2kw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwRqC3lh72XxOmSaSBB4Y0-kh57xpPrbiVEqZDRLNPn5w&oe=69B171B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xiGmCn2V_nMQ7kNvwEnMDvX&_nc_oc=AdlZ9HRphH-_CMW73OrhkRgt-9FohUvhoMlqNYx29RloTH-deP6tgCvGXyH7_0viLUs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyQF97GIWAdaN6lktdYtkkgxWHUHeUc_lEieyGgMD7f8A&oe=69B162E4"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "re
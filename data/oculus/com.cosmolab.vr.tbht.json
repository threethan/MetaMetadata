/scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N5FcIAmWDmEQ7kNvwFOJ2dp&_nc_oc=AdoAw6oaRHUgJbagrBySueVEpaNDR4XRPGSEiYTiEVX5UDGQ6AUp-7XFLX8tOtcMAgs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af10byxSfKDD9icPfYg1_bvHi3YWAh-5MAd0ubEGFD1imw&oe=69E61905"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xX7Bu_vkmvUQ7kNvwGSArhh&_nc_oc=AdquM25lJLYT7KM-aV7fK2HUmWKSBvCSy0UtJBWFgjlYBHCeH448QYXcgwyXB8jlsc4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2vZR9joi2QH3533x42ScmgaweXenqJpRtLXRz9CHReYg&oe=69E612CD"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kki5Pib8T58Q7kNvwEpfePf&_nc_oc=AdoQg3_XKPJ6zgmR7Pb7n8Q1p9_67i9lL_DoHer07zIoJ32pr3MPdErDQzUyzX0r6yY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af08fAcvu0gDpcKn29SduCiLxTKhH9jlvkT0l648ZcAgvg&oe=69E61421"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V5vLjWcjWmQQ7kNvwHJMI9V&_nc_oc=AdrgsXLOw5fpAITeX0--NY9iErXqIdsoSH8MhbpCzuU_y1MA2VOpvkT1MO6TRNdvf_g&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1UyG1indLvKkTC6dGlmPnDB40LocGZkSuFycqLSbMTVQ&oe=69E62DB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ujAKpl3tDKQQ7kNvwH1NE-m&_nc_oc=Ado6umr6-TYf1ngs5Nb1RadMtpheRw5j1VBBr9tVtjZWAIPIqv0EpSA4aNqFuu1S1y4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0wW1ujSxr4d7qx2EcUQyQcMW5FWzyw9Pp8cWXecSCtbQ&oe=69E61EE4"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
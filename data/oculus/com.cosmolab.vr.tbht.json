/scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZWLCXmBqYv0Q7kNvwE_7eyq&_nc_oc=AdpIavbPtJriNsRsctYVFw9IF5iGoxFtyqcuDNtOTMvUAEBdttOTmhe9O7NumSODjFM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQId-wK-YIG5jOVj5r_jgYHjjyOVlGrXrwy37WQymsA5Fw&oe=6AB69E45"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iuhz1iKgIroQ7kNvwEiMZ5n&_nc_oc=AdrdldQaIg273hwTjgJll29gHX5k3QKgDN8FdV6guWJ9UI_A3P4TtlxyLl-87QIzofU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLRdLVBgUDswJwSs6J-CTPF0iKqJdaHQpMNKbM_EfbgVg&oe=6AB6980D"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Q3lWQEPVd0Q7kNvwHOl9ki&_nc_oc=AdqR04KwScdKZIDQy5gsnmXVFinXTz_XhtvoQ3ckC0bnWJ2v71iYn9kZ1f4FNG58_48&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKngU6IkaaRcKUuWIw4WsrCFR03kZgWXrexeP-h77GLPA&oe=6AB69961"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fFfC0SYHHH4Q7kNvwHb-R81&_nc_oc=AdoXfSnMb5w7XVCPeBHKLsoQUUjqUwvandi4fRySghmXpJqdrHQ9zc72Ocz_TT9lrtc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8amQhnzT8rDgjCZ_WQlWf5S1n5eHlhOLz2kZTLGHADA&oe=6AB67AB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a3lmONseIi0Q7kNvwG4Cokw&_nc_oc=AdpMatVp3P0NKKCJ8A3p4U46n4iJmDf6qEPM9bAHWGG5lam19HcNK-qFZlk2Hkc6SnU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ00XizKAj-QxHdua1VLQecyVlV6_A3zIda1WTnau65WA&oe=6AB66BE4"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
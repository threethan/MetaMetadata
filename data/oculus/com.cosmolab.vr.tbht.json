/scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q8185jiT-VcQ7kNvwEJWX5k&_nc_oc=AdpOoFBfujmyoHYkqcdI0fvpZ2bgMsMPKxVsvRTWMc6MWUN_ThqJJFAPNYxPBS6GvL8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3y1_KUGs0Lyh51oqsKhjC_icrP6rhH2EO9u3AZbpc3HA&oe=69E22485"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tCsDUHvjtZMQ7kNvwF9aVyq&_nc_oc=Adoa9xGR7eMwpl9BsclL8gWOVfby3GIo9RdWu5YlFRHPPpd5D9jgwQbyV1bfVL3y5q0&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1de_0csmLmWk0fU4KqpHr6jUEw21Ul4Iynvugo0lOk_Q&oe=69E21E4D"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eo1mCxgCK24Q7kNvwGsx7pW&_nc_oc=AdpxfjZopKsTQWBHldBc9WXAMxaZ88Zmp-5DHQ1XvZocpfRPMU72AAOTaPY9kAdOQOo&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0uCZiZbmDV1lARPvakixU4vbVGugPpdSumIQ4XEJnNRQ&oe=69E21FA1"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uvTtszoUtF8Q7kNvwHCcnxT&_nc_oc=AdrkRc60L0A3UdjYIYa4puYVvIbD-Lw3X75wbkl7Rw12J61aA-Z2hXjCdqth8pJ1LPY&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3h45nDWo-6M8PzsBPwlONtbiewOeB4YBwETXKzzSB0Yg&oe=69E23932"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sk0Wj0b5CtoQ7kNvwGBg3zC&_nc_oc=AdoK6D1wLJQgJgFn_XVCKesZvCucubwfJvB-7Raq8T-ssQskcgrHzBKHdF-qrV30TOc&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af35MuCjgGBPd3Aanltyt6MLIKG9B_muDb4oK_dEaF6Fwg&oe=69E22A64"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
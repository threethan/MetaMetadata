wF0pMEt&_nc_oc=Adm2gvyL30t5EmbaTREyhD1GtEnUPLcgHdV0ygtNqjUzcvQej2to22GVRycLuWxDsgM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftyiljVhGHXBgkW27iB_4OIl2gmkqXtVe7f9VgtLKCBfg&oe=69A2DC85"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cHqMnaPWpm4Q7kNvwEEeDc1&_nc_oc=Adm9R59Pen2suMGqWpoG2tsI2j2ejNgFcrXMlhWgVOz0_pXsA7Cxsj9fe7_VD2-M6us&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs4pdSRWq1xZgjTyUgODznG_v0IX5F6TlcOfBpGlDuIoA&oe=69A2D64D"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g1tSHHB8FGIQ7kNvwEKEBkT&_nc_oc=AdnBSCiUZs3oJqKclWOYqtpUIULI4AxS8br5Rdcq8f0CEoYJK0u0ol5iI82ueQguNmE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afszxqlx2rWleX6g9_5uJhhO9s6uB_6TOoVkmvJRdjM7Ng&oe=69A2D7A1"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RnuW8i1i1OsQ7kNvwF0bKyD&_nc_oc=AdlA4q5cTdMCeXtJTRQkMymsquazX8sKahYgURMenw0noREzC4OgUnb02bkh9BisjoM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvrMWuEDlJmXzLC5JJD8xbStgR6whmp5sxP5eKVmC2EAg&oe=69A2F132"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ADd7YS5RswQ7kNvwHYE6Yb&_nc_oc=AdlWlNFM7oFRFMY7t-z91QxywQEf2A6bZtUnltQhQ_3uYiI1oVHH1DQX8hwDr5Rkfvw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuqTdEecwhae8txBUSRBI4WNVHkxosBtOkLovhaR2QAGg&oe=69A2E264"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices":
wGsPEuI&_nc_oc=Adk0Y7uDmmmrT4aEMLhVeCaKIF4NuxCJIAaoD68LLzDj3ybIdTaDXJ3ZB_vyVQQZOsc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfsCCf-Desk2j95HBTR9nhyfUkTPXW3R6PlvrkRzWLnaIA&oe=69A57F85"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cHqMnaPWpm4Q7kNvwFfk1aT&_nc_oc=Adlx_ht789jIEcSGgicACDCgyd08RRMIzXXRIhJLxIexadnjhev4NMW0SRxK5oio4IA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfuaqREH0DGSVkzQEwLvU8I3QP1VPqbtvHKQe8wVjWhVFg&oe=69A5794D"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zW1mvCXFtbkQ7kNvwEFcDYS&_nc_oc=Adn0aHRfmPv_90PuLTlWK2fe0YrvEVFHFpCmUIjK81UOVj_rd7NWWNr4gcFdWmSjAWo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Aft3hvKS9ZW7KzSPkfnTpNl_7Ato3qQo0DF3VdjK5EmCSQ&oe=69A57AA1"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RnuW8i1i1OsQ7kNvwGJHP2t&_nc_oc=AdkO608Yjkd5GTzTSvyADr1qPPPAgTx-joVdd85k_KSb5cm2-iOBJvH5FmgVF90as64&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afu5PDhZ8dphIE7Al5hYHLAyeah9dX109wDpkzztn8ZE4g&oe=69A59432"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ADd7YS5RswQ7kNvwFGbSr5&_nc_oc=AdlrKLP1h_eUR6ru3gbGeCbM-6Ak89S1mncG4dm9Dg1rAAU_0_vxQQ2W8GkyUu1Id0s&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Afvceswf2TZIOK2bk5HWcolbNweUNYZPcf3YW6fsIpi9yA&oe=69A58564"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices":
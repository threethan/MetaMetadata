/scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6X1Zy6DeJ1AQ7kNvwEEZgbe&_nc_oc=AdrQG3wnvVZ9vOOWZWBwsLwWJtpXzhTqISJsIxzBrMc7IZ4j1bV9VShPa35flR7xUbQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxJMVOp5bpsykmAyhjKWM3XYl3DiySJf2z1CSUqNXSgBA&oe=69CFAF85"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hb-7RSJZzAEQ7kNvwEL2YZi&_nc_oc=Ado1B3gONk04QI27BYuYt-PSNWhsO0h98VaAUty9GaTABsev58EosUBAahrbMEv6iYs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwkHg4qT4DfvcAOXcyvjLsgyg6zH0PSsHcxQpSd6p1IkA&oe=69CFA94D"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N7EoX6Qboi8Q7kNvwGwfBqK&_nc_oc=AdpyR3Kwh5zwPrA0PPYWmYXXSmq6B-vN7b5V4JQg4V68C9_6vKGVc1v8gZe2gGG387o&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxkBaoC4rwAWwJsoBkNmuOhK-PgsPrWKVDFgN8XPsGmsg&oe=69CFAAA1"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U1Tx0XluA8EQ7kNvwEXy6Kr&_nc_oc=AdqFOUOXfBhrWOTXz9sc77-K_04Gn7zVB82C84EQaPaOMIxteMM9io98swIX0jzIKMc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfydqBBu2_y7HpxJJfopJdd1U-_LMZ5adFklvLixzt4fIw&oe=69CFC432"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pCVy6xCbQPgQ7kNvwEngXg_&_nc_oc=Ado4_6CbJYbpV9QqljUUwWbVlzVqUX53bHh45CPzNl5JUtUy5nPCBBjyeXaJAOqZtT0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzS4B0GVNFQvPw-30rVPLMR30zp2ac0GrqrySYh5X8Uzw&oe=69CFB564"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
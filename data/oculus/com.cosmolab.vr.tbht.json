/scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PL3AID3_9psQ7kNvwEiwKiu&_nc_oc=AdqQjqj3a5utVoILV0kdUQhR6GkrkjJiXuglQTmF_KxKdPHORiU2quWoR2mFa8DJMwo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8VHFmQeAqWKR3zO_mee53th2ivPauVpi8sRIO2-ZrPZQ&oe=6A3176C5"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CC72_d-VdD4Q7kNvwGYo83a&_nc_oc=Adpzb0OlWTsdelUu60lcow5u0uODu_14bSNZoma9fNmYodysFZS0fY1cZAtFR8meqJc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_fQ3-ScrlQ8ClGQ4IULnEmae3f9I0RBOTrSNja1NNAhw&oe=6A31708D"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HgCoIHpeogAQ7kNvwFrupNf&_nc_oc=Ado0Fb-WwbGUP5BdUk8IdwXjUY9iDwxyLxT-SsGLclHm4oNMZz2FTOz28qNz2ZY-zAU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-vTCWaDOBq33eII4ie6J0Atf_PD9qEuM9Mpbb6zeSj8g&oe=6A3171E1"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IsLPbgQ1CTAQ7kNvwEGaQE9&_nc_oc=AdoYw0Td2mbkJ2rsiJfPRndS3jeYdwIlA6BEv-PezBh9jhvEDtjqwPspV-kcToXzz3Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8K-kCNVgOoNQ2b0K1AiZLcF1MeKWb5jN1iKMVegix3qQ&oe=6A315332"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ve_ci7JB340Q7kNvwFnpmYi&_nc_oc=Adr6HSe1wU0UsxYTmlDXhuDZpYIOYFhi9xdtNraQ12PsbHj5-SdB9Zs0zQ0skw2tsX4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af816onZf7H8l2EduMx5oSBdLCwDSzuiAGgXwVcKW28mdw&oe=6A314464"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
/scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kzGHqE5yEwsQ7kNvwEG7xWU&_nc_oc=AdpGLtMKIacZYCphGcbnvkvC0fen1rlT44ND_elelqD3k5qbJTqGLvTSNwA-YwvDpOk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af429-S8lYHpT-C3zrjuG2b9lPwN4hxNiC2QegAc4e7u2g&oe=6A16E085"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ihtHWcMn1KgQ7kNvwFOc9Eh&_nc_oc=AdrUWg6FvK2BC61dwBbhJ35FEk_tOnRY-8CSp2zh8y0aiyNvF64f1UDRfHa04apgIko&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6cWYyiQbS2nCUGoivkUzFqM3qHHow5KRAobdhOkEGjvw&oe=6A16DA4D"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2PIR6nrF7rgQ7kNvwFGF0ir&_nc_oc=AdrIPEfSVoPnFlWYkmfkhWppvhY3XCcault09k1xaJOxP1Hq7A152swmxWp-8XDzSo0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6oAnQD48y-NigJdpd9yMMFh0i7QvUZPGl5zr1p2QANXQ&oe=6A16DBA1"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OMLn8H9TmhIQ7kNvwHP6mLE&_nc_oc=AdoDQgcYZINE9ApfVcRVM2x1--pLaRR3siOtK_BIlRlI0X6v5Pdc_TXerP-f_guqhd8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af504C5GJF0nkoy0IO6yFth0Z2QQ8enkl-IEKQV0sRNIEQ&oe=6A16F532"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iZME7g-xiCQQ7kNvwHGfO3T&_nc_oc=Adpez8yGjsdikxzwHQr4ebmgVkYIj3OXUFizJrmHIBPzI2GF0TX08nd5jm6vFX0TGiI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7S8Bq84gPpG40hI051qUskDAsdviBUbIsw1qSDRbiHuA&oe=6A16E664"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
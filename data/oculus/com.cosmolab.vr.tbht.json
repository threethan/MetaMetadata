/scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f6-LK9aHjv8Q7kNvwEM__44&_nc_oc=AdqmUiHZ8EXpo5iYZI_suw7iGyew4ax5gcL37cg5Oe801duCPSK47Dke92lDwbexmAQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQORPzcHS0Xpzb8aaVIVW9JXTKMdxpFoPLwQSEPGkHWsww&oe=6ADCD9C5"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YMrzWqY1fSoQ7kNvwG3rjcP&_nc_oc=Adrb7d4i7X1W4xbTJ3YojhgZe5QU-pMoJmNNtKVrLmzAPoELEJjKz2Wuy_tbbr8lI8k&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPNWldyiDlxxAIPSKWn7A2Sgbsr9nw2u4EKRm2S-GliLA&oe=6ADCD38D"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KeQUZeQJ_VcQ7kNvwFgR5pv&_nc_oc=AdosLk0tsYtYRal4ZnSDQ9KZvU9sbA3Yvx_p-4SIRA6VfUyt7ATAEdkyx22VXCODbwM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPR09kO8-ThctBesspkXKVy3-biPxKxFjvIIgChS0oDnA&oe=6ADCD4E1"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ic2L0JvhwnMQ7kNvwHyk4lx&_nc_oc=AdrIdmiiHJNY7XKrRyQv3AKgM6YoSh6sPLe7Zlnc1yNMaEUo_RLtjdMGdNGiOqwOXoQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOhQrSDlXGV79m7QqIeOvy8WcLnpUg8eqFoKIIfERiU1g&oe=6ADCB632"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tO8HxZjr_4QQ7kNvwEDrkuN&_nc_oc=AdrMq1Bx8Efrvd9QpRRPuFh36xMv0FGo1m61EkaRDlfcP7h30SLXLJYuBd2KOqAC04M&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOnLX_taROiswgeQdwU9_o9SB7EIKvgAtyl177NPN0gjQ&oe=6ADCA764"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
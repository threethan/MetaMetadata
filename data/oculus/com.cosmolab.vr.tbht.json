82723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XZAxsKT2iscQ7kNvwHZFehF&_nc_oc=AdnIToOryhe4FiXxC3b_h0uKusa9t6jcjearRv1eoPVoT-kcQyftt9ZfDDeQL_O0Hc4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsiE9y_Bzg7j0mJoqySRxQ7pDvq5PXUj00f3kWU0-MaDg&oe=69A82285"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AocpCNTgdUwQ7kNvwHFwoLm&_nc_oc=AdnXKxl8FpzTI9KNBmNHractlJNFNUTOsqt-cNxuxDLho3zxHz529dEKt4_7LXDyGDo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuJH8cZrq9uDcqqEBQYi-PMC9MnjWiyNo4_g2_-gt1idw&oe=69A81C4D"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B8ZYrmeNbHQQ7kNvwFEfT37&_nc_oc=Adm-CHAUI-6dsvIQe3T2oj9pfcDcGEXUkV4yidoE0n7VwVXo-VjpQa4NQD_cZambLAI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afu0z8d-26eH2UIWyWxIPvW0GVuv8hlW8QzjC4N4mV22eA&oe=69A81DA1"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MbBs86FzVWEQ7kNvwH0_DPu&_nc_oc=Adn1wG5xVdBYIhGIsRfIBkUQnw9cNXDtJeoD7L5m5sUBsaJm0CIysWhJ7Zrg1IaK9dU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afv2j-CZ4E8kkVG46zu-57WIxEbNgPUD1s64EFCvLjl6EA&oe=69A83732"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PWLyt6pV0eUQ7kNvwEj8Ipx&_nc_oc=AdnSLyztmiNvZEaI9QzKlfSGCaRLpkFoue6JlgirdDk4nug6BK86s6K-UZlTCHq8kLw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsaanmqLPRuSOxaXxyavSH9RG9h1wWxWFd6hgAV_8MAXw&oe=69A82864"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "re
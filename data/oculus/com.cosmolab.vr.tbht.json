/scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N5FcIAmWDmEQ7kNvwGowCex&_nc_oc=Adq3l7iajuyXPtmzXdlP5pxL_toFw0_s7OGZWc1B447bQiW28Dop7dNtL_gdTMvcbTc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0devMoVIIr6J50gx5PaTkz5_NgHEb38kGHpL1fTzjooQ&oe=69E76A85"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xX7Bu_vkmvUQ7kNvwGso2uv&_nc_oc=AdolwOYiLMKjQ2bFe2clTaKrZgrtmkCV7GXRG4Jo-qr7ErY_osoSQhMio15SbIBKFIg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2-1qrQXsUOXG57KC3C-B1zZZYogbUqJeyDp3yBwSolwQ&oe=69E7644D"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mGzFlCqWzooQ7kNvwFE8rBs&_nc_oc=Adp4DfMIQ0h132rO47X7I5XnVj3g9umPw61QiUwaNYsaqYgjkh8z6r4tQnzV4MiQiqc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3jK5LYC08xUBP1Uo70fbjXJRhpz4SdCOZ4oOo-qOBnKQ&oe=69E765A1"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V5vLjWcjWmQQ7kNvwGUMFxl&_nc_oc=Adp1SYAY-tTXkfjwWSUBGMr0sG6NBXCb5X5ffPNZH5xlFxBUK_4JA8QGbRG4X441yv0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2aZIYW4AC4cPPumiwgcyPnrzIwZxaO74hGDdPeE0RmIQ&oe=69E77F32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ujAKpl3tDKQQ7kNvwFWWOqk&_nc_oc=Adosn36MZJuJas-S_qdQHI_9piJCFXPdYOPRFqopyfp9-xIYr3L_m4Cou5IkO2qGDls&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2DPEWJko3sab1eGv--D1fTZw8Z5Wr2K02NPsfE2C_NQA&oe=69E77064"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
82723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QZfo7yhGNVkQ7kNvwFUJ9mN&_nc_oc=AdlFjriyLM_ls7O3ZOJL2PyKyvYU3Rgb3JKIqgBZlefDfxEEODE_vzEMu1MIpw6hic4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy3y6Sh7K5_hbAQGv6SJKeWIo7sJJ9UWNdx6FG-zS81cA&oe=69BE8C05"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-eDG7FfkeMEQ7kNvwGz69R-&_nc_oc=AdmhKBVRnQ7QiT3TIqO1K9p0PIc5umogH1EvWgT7PkftFccq4yBFGSvuFRAJTzKEyt8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxa2fhG8BvmnuYASrp_k0hrhwIx0IPRHF9hsW1ILCM88Q&oe=69BE85CD"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GgjE6TQTGfIQ7kNvwHrK614&_nc_oc=AdmSQ3Gbi-wATmlzvaWQ8QQ5wIhZx6aQhels0EEWFQ8Nl46dag2OJznBJUflzyBrj7M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyLXt7FvU1vN2OxYdocUnfooxf-BfXw2VUWvRWxXuYxXA&oe=69BE8721"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zkpnx9nbflMQ7kNvwFjTC2O&_nc_oc=AdkyuF04wSquGHktXKjdZEaBKI6KgDBZsd03-yUPb_KdurFUVG10Is-XqjHk28RJwp8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwjD2hexbJYBvITvhjAlo_AO4r0CEPGjQ-KFw-CA-sLBA&oe=69BEA0B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RcbZS8PQvIUQ7kNvwHpajlX&_nc_oc=Admu2kHxESbNBy-cdmFM8pje9x_xvMiKZM91x7rF5GP9mnM9jCv85fnHQJFnacdMmwQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzYxCZyXQI5FRs00K_su8Lz3rmVcCoksbUqp22fLtqtgA&oe=69BE91E4"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "re
/scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KpKtcXuZ4c4Q7kNvwEgB2yd&_nc_oc=Ado8_uRp1WosaMqGm_ouu6SVThqao54HqhdqCgC_bdInr1RxM0Dd6dTGuMWRU12msxA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7SKqeKTxdfLZ-W4My9TWxEWsdZRRL4mQULa3LN0Vuz1w&oe=6A12EC05"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YvuTSRmOt8QQ7kNvwE0Z67-&_nc_oc=Adq0iNdw9PRINaTD_ghwKhTWqrdnZGa_PnQgIdHcRaIORgzGlgZ7_hi041_-yQsrklg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7oeVVlHD3SugTEcebK9a-teY11u3LYAFr5uV6cxYCM_g&oe=6A131E0D"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uQrcbONZlK0Q7kNvwFDjuFm&_nc_oc=Adrid24ku3Gv03EFBIeEQJdpC7e6KkNEUGVtFfWrlLco4aH2SVhUg8biZt-r4rfVnas&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5UN0-pklBTZLrxHlJ7AYvy5H2owVcEhNWHDvT_5WS7MA&oe=6A131F61"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h_R-Q6nWlQ0Q7kNvwFVmgxy&_nc_oc=AdrLIR6binZcmUj_HB3QhJMoUrEQe6HCY19bRmtSq6xKkSrA6-WgtTaNESJ8lcjdTcc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6enWgNObXG-dyRQZ7c_5aWZ9yB-Y3uxONySSKNiEVi4Q&oe=6A1300B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EHYSoi3zI98Q7kNvwE2tbyY&_nc_oc=AdpFXaGEW5f9dfrzlCsK9pOUOOSw-Q3YYl8lqtq0bA8xxcA-31DWIeCaGF9YHoyLAuo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af45eeLR1Glrb0Ebu9VvtZcb8_y6vZuq5-lBTMMzj5U83g&oe=6A12F1E4"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
/scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KBlQnLKzm0kQ7kNvwEn305p&_nc_oc=Adog90UmElp3CwcKK__IfTH-BBbDC-2bOJBr-G64MolBCW3wWhWNeCQQCHdOtqYkYEI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_YDzn3Sr4ZBjaX0z2dC17W5czyq6hVKyc_bAxHz7y_g&oe=6A3EA5C5"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y2d4QExHJy8Q7kNvwEEcEDp&_nc_oc=AdpyCowcTqrDshsl8VSylz7KB-e_Uj3kgXfhdh9HvqvmTYWnbmCgF1i8-ey--wb8iYA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-zZFqHROvNzjPXXR2SMPcwfAQGeZEqMIoYd1LQ7tp-vA&oe=6A3E9F8D"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P-s-y3k48I8Q7kNvwHVs0X8&_nc_oc=AdrXL7_512qCiD7efFjDsixyMhzvgpU3Ms340fmBBGMTEqL-REQmAfHo_rXmN0eSCYc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9QcHld4FMIauw-BAv6pGXtdKJi7ws4zj0SN5G68bAvRQ&oe=6A3EA0E1"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yUYLgteaUr0Q7kNvwERoorO&_nc_oc=Ado-2mLd9qpxOOyyh3ZEzpwtQaDapu_ExL9zhADeY3r21rq6ubeJTDomuPPw-zXTnSM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9RARFUzPA052VkFsUfmojZ7gpeKzzt2CLtCDUO_0CrsA&oe=6A3E8232"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kI1sm37WCoAQ7kNvwEkGhrK&_nc_oc=Ado0Gq0yQrr1vGRBj9mEpNRsd1FoopvUR9QuEenx4uB4h7qxtX15xQ9soe7jLQKRBcs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8QzE2JfrzFtXrx3Bk1SFyd8o_rKPJhwyg4Yn8VbW1JnQ&oe=6A3EABA4"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
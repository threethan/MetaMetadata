/scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qNdlmuASHfwQ7kNvwEtmEbI&_nc_oc=AdrRIfApe3GLy3Xe2WzqCtgCyd8LjiDOIICyyhD3VkRPo53yl6GJviErG6MuMlKzGWQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1Gmyft9uhzjjxp7iv6fXNCVC5K7YF1viF94q-O8LYIw&oe=6A3C02C5"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y2d4QExHJy8Q7kNvwHSEdil&_nc_oc=AdrODK0iorXY6LLwruwxzC6qzqCeKWi-bmSehNH2F2BrVGUUxQrxkb9whnUdQvrvQgU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8V9pikpxL3eF71CB528G0_VsGD6SJpKTSDAZDtUKVKaA&oe=6A3BFC8D"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RQODZ8ctHTYQ7kNvwEnwARF&_nc_oc=AdoFBBn73j-xmXSkRryg4H50WyTj9GrfFclmrtIesCKJMLT5SzgGJxNaO7HR2f1sdMc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8fo0licgtQVskIzYoBiZzuzhORyShlfX3bcCecqnv1lg&oe=6A3BFDE1"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gKJAo57Y51IQ7kNvwE9xHJo&_nc_oc=AdoGveKw_3Hty_ZcChrw4-UOyqog_uFJQpPNK7hyeKLHrR6EAxtfU_b6mRHUuxRUp5I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9aRyivb69nOISU6HBh1rZjQPyjGReWMHJDm6dzD-MQ0A&oe=6A3BDF32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HbgMyX0d8o4Q7kNvwELnv3V&_nc_oc=AdoIA8PxB9r7VUkghS3s1KKmkrzSrU1Jt5NDTl7FfKN7Joo-QTL7qWR4gGwCFhmdYQo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9D8ClxI2Yh3SWzotciM-1rrKgwt5ZL1uPABGTfNxpObw&oe=6A3BD064"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
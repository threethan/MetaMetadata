/scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zLozVPDcnX8Q7kNvwE_M21k&_nc_oc=AdoRQNcO-_j5TXW-fM2UIGTXeVQgBrqFconljSYHnyzRIRXjatVIsePSkJCEPPtKCvw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzsH6OzDWLbh4DU8xde5BjYVGDJvhRc7TsHzFs7xGYNMQ&oe=69C52385"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BShPJSNE0Q4Q7kNvwGMkubs&_nc_oc=AdoHezoPZ4jvWrmg_ug19RwVr5yOI1K26RRsFn9vfoCkStln-QfccopC9BVPC4tpCQs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzyWsPLF7CnsrjBfM_fDewL9ZwUwWpLtxEwh84meyVAeg&oe=69C51D4D"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qLgSRZZUymwQ7kNvwGt73DS&_nc_oc=AdrDZCIf69hWQaVoEKtxgXBUNx8C4_jQDfLbHTU9bSsZJUO2ws1ILpxpqpKkODCSGYg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwDFAQ5yLs6l8jjH0sj2fQ3gMARXf0mSCZrURgRuqdamw&oe=69C51EA1"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GcR7URbZjxYQ7kNvwHN80nh&_nc_oc=Adrw1B-YcbX7VakF-GHzkGzFDDOpUSDiiPFU1aB3DwMloOoLUj22QGKxoqP6ZceGO0Y&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy4ML3C_Q0AWt8H1J3_UGfZ8rhvnmx_MwOYgkJ--4-Ybw&oe=69C53832"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p87WL6vNRMoQ7kNvwEYWGnw&_nc_oc=Adr5DfceNsHTlF0W_YwyLk6WCCuDyp6WbXQsX8OcfxPBVORkHQSAz_TEAqcr9wbnmFE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx6LNgWhee23l87lTjvqt3KU1XxXpFlIabSgeyB94nUKw&oe=69C52964"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
/scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sj8UApDpiXwQ7kNvwFFqAXw&_nc_oc=Adow_7ZV3eqrtN2-D9kK-J8C6Mb3Nb8W6Q_ze_jwELMz3XtPObIvMSDNoM5zu_OMUz8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5CNuUA6nlab0aLFQhP3G08zTYj39NPZ0EzL4StohetrQ&oe=69FF2585"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c76SfaHMCugQ7kNvwHHe2zj&_nc_oc=AdqJr1iEmvGq6pX9K9augILkrqvrsxCEUHK6fYawhFHVSQNYtm0fUBUu-IHnqevE7Vc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60SBfj8GVY8HP7p6rslwuS_hZEERde9bIdKdRE7wEPBw&oe=69FF1F4D"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f-IFVnaMK_4Q7kNvwFMCOy9&_nc_oc=AdpbzU5sQZbXHOGIksqy0QofdUpPyzBHx_yo05dW1Yxky3H8hFzoU_WzhGwshJF-ct0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7CnIWwl5I6ekxtxW-rvgO9UAW2zKbtWzvO8s92wpW0eA&oe=69FF20A1"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oy-Jzf8kQpcQ7kNvwH9807-&_nc_oc=AdoPxEqSiVfzghRkmG88_zagDc1Fb7Q5b0f1oSWPkZZhbQyHoNNX91OSIBTK-feAprI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af56nAc3l86AzXiU2UtxqhORMozw1J-3ls7Kh-Pt7xUaCQ&oe=69FF3A32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6KtKIRacs98Q7kNvwFZRrXY&_nc_oc=AdoE1o1m4GWAbtBBtv8LSHjYIWcMIIf-QEVAbaytk22XRgU8terOEUKuXFX9oJnwCaU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Mrn_GXpMrhmUhWuLIBcTQCdf4OhlLtQ23c_w5haUCLw&oe=69FF2B64"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
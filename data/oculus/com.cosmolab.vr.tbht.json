/scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bOdOyLsp-YgQ7kNvwEm1sm5&_nc_oc=AdrmVvaxKQSpu3iicFLbNtYeBXZLu0IIJgDgT_IqWrZAKYD3RaWYS5PsAGUXO0E92Iw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL3shdIU12A4b4nIhfS8Y_BHHvl1a4Qqli9W6sOMkj5ig&oe=6ABBE445"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Ex-tDK-XmYQ7kNvwGPyZmO&_nc_oc=Adrp8pMyeCMxv7fvUKFbBNbiDeG23cH5AX4f_ufV9A0ff0ot01NVnPoOh1xfEplhbe4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZyiMgDRIDEsY0kIKY0Jg9S6oUAVz6zTSA7b1bylFwNQ&oe=6ABBDE0D"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jd52XvZwzrwQ7kNvwFB5bu7&_nc_oc=Adpvzb96ZTDgB_HE1v7uA2uSEIFFFKHfpwBSNjm1ENFp-FqEIsEm6MjxGUD5MudRbqM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdL8YkjbWGpbCtV39YZcxl3-hmFxjNENxlcSNenDpD9g&oe=6ABBDF61"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Dxw3-V8NyMQ7kNvwFfRK8W&_nc_oc=Adp8OLLQseKW6rCwaRN0aam1niaKe5pi0t3HkvKtMTqavar-9o8vH5L2QIzN2hk2DsQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKvkXV27bqlwj_Ty3VinUYtNtBLrf6ekPRDEW6mEJXKvw&oe=6ABBC0B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yEwEzSZClYIQ7kNvwEXwixC&_nc_oc=Adpxwpsy8Rtrq3XaFaVxwquBx0PTd_zMV5UY9Ru1IhHymgciPINPd5wIlvM0uO21Jh8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSLnXUZxdQEQlVBntzJwn2Cawq2qKl8QinWbg5WIGTiw&oe=6ABBB1E4"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
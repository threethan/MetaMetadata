/scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VgT-O8C5c8IQ7kNvwF6lBJv&_nc_oc=AdqNqVezo_-VqAy2hVpeUpjEjAoph0eoOo7KVPhES_eldaU0Q1w8lzsWI9Mo9W9ciow&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-J8q0kpDCfFuv5TB_1ouTIfRJHa-doCDcQSvzYHB8xhA&oe=6A450505"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tL0zl-kzM0UQ7kNvwHPYN7V&_nc_oc=AdrwddsY9ghb6ZUWtSYjy-UD9Nj_6X7NSaGvyrEw6JViKjPNaAmcZEP8FRejUVgJ_pU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_S9Cs50RzTlfds70NLzYNfdZygz6PQ5V9eYwvV48H6UQ&oe=6A45370D"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rbz0odoM7UkQ7kNvwEiX8hQ&_nc_oc=Adq8WQPRfrpGIh2uStv5z5L5vGrT9m_u5NV5tyOzOCJQ8nZtNbaAAGvZafmKotgfITk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af984j_bLMnRReft_Ye_UgcfNJO2xjxrq-kcB5ruYDNheg&oe=6A453861"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z7Yu2MaQh4AQ7kNvwEuIEz3&_nc_oc=AdpL4nhO6vSuTAkkvMrjvMMZahEDhzvXCE5oCEXDCAWM_O457a1klqNeOXxjIize7U4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_pH7gEMeKEwBE51f4HcdidDQ7-ieGo2VL-8mYxnXG1LQ&oe=6A4519B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=06JL84nV5SkQ7kNvwFDXKWc&_nc_oc=AdrlkLCtTCfNaFOZNu9aa96k0iEYzqJ-O1p1qOZPdtIQgdAtuXLVV97um90Wwon_5bc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Awpy7gN_QonS-sExyLloeV2VRFTYOxaV2p16RfyasCQ&oe=6A450AE4"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
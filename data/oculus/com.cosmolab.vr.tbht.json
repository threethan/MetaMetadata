/scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6X1Zy6DeJ1AQ7kNvwGy_fEz&_nc_oc=AdqzHuPaCvYTd_3pRcJn9DtuLGVCc44Ehbs8Ju_BUp4P9Oab3IKz6ziH3jCIFG4XgA0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwZY-nXez6zRVm5R6OGA1k48gWIrMCeOL7nbKNl_9kLjA&oe=69D10105"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hb-7RSJZzAEQ7kNvwE2ol3r&_nc_oc=Adpi5v5hSSfL28xLZNVtnrtG_-vsGZWYFDAqEJS0N5dTZI2350yc0nBqb0SgcKoF7uk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzeHj3wQJcOQSGcvtw330C3OFXXLwhzaRDRfk-AvRwNwQ&oe=69D0FACD"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N7EoX6Qboi8Q7kNvwFgrLI6&_nc_oc=AdqvNfG7UFMrl3WIMqOtt9nHX6R4z6TJOLp7F4LPmFZNwvHhTxwso5rEhjNm7kPwJrM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwN_f4HYl-uN5NPiLkfwKUAgqPk_shdxNIzpKGl6TN4VA&oe=69D0FC21"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U1Tx0XluA8EQ7kNvwEf5vaW&_nc_oc=AdpsogaThgYhgMD0nmNA7BIubaoMeVr4hAlj45XkWjgZbnnvNMaU1IBDzDigHb0y_KA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx_oxM1iEIifexUb93MDU5D3_C1XnFaUJQ6TDMT0kbuOg&oe=69D115B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pCVy6xCbQPgQ7kNvwGk6iFz&_nc_oc=AdoHoU4XnOE4I8cxYqUGHMDg-tiuocHD8avkcwLWvDBYJZ1sdoCqe9ExtYhI43_yjCg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx871i-LuvY4XlTDDWD-Efu_r7C2iZV-eiD2DC-Aq7HOQ&oe=69D106E4"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
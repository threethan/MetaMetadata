/scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_PPKrgILjGEQ7kNvwHR4ZOC&_nc_oc=Adp6lb_hV3xzjdcUiMLHSzIV0Nv0L6p1tIyuOOSKTrWNrXlkpHntfCLr4WVjKjGcrMo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2D2nyk6kExL_RlEIagcegg_IiaGqpBvH7gvIGFxHUxmw&oe=69D25285"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RXliNUqE1VYQ7kNvwHGD6Dx&_nc_oc=AdqSF3_67sYfYmHkjXUw8Gb534chbKm_6C8U68dm9r0VHyYytcba2r623Awwm5HnRI4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af18Ak1oMSpe_51wMNfJgna6aikdDtRr8l6-Bg4FYuit7w&oe=69D24C4D"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N7EoX6Qboi8Q7kNvwG-OeVT&_nc_oc=AdoPkzQuuGAYJqerMPq13U3S4DyczGq3GHMN-aMzokOdf7Jqc4KeCnZoaaXIZeEEih0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af33njJ3AabCHjTPJV-BLoRM4Yby7b0m8UM40_uaf_JByA&oe=69D24DA1"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qbrrusNhiaIQ7kNvwF-FsSz&_nc_oc=AdrwA047jz62tfW0UtLdoMm3uqGsfpSUN28oDq220RLSi-coZ3utqHbU6nna3U-xb28&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2eK6uN2c0qJPTqbzH9ARJgaP19qNppCUA0yslLXyZ4zA&oe=69D26732"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sk-z4N-bvYcQ7kNvwHp2lYo&_nc_oc=Adrz-5VpG8c9g8jV_WLwypJkrcQz-pW_3unW1iGLSS-d2aAUQqiW9XMIcVz3QmG7Qes&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0hFq-n0seE-t4oQJ9sbwYLIZIcXLTZunKxKBSXKWbJXg&oe=69D25864"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
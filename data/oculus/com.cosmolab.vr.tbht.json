/scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uMGAsAdlk14Q7kNvwG6VLbt&_nc_oc=AdoFbGMG_cQmKaP9H7j3gpbARpan9l1zEKtzbKI0T1I_4SskA9EYU_cVseRU6Z_0pco&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2AjPxf3j5Fd2ABZVgKiPCAuwrN4I0wbftd5N302qY2rg&oe=69F73C85"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cLMBtqTnj_AQ7kNvwG8Zy3n&_nc_oc=AdrMIGBS_LRQrr5ksbi1x4NiwojLxJ6s52lkqOs-0LmgadxHBhNZoOvPXWIrMyR3Ecg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1a2jo-D5Mvz520qgcGThV9bmG99a0xcxrTNiFYuAHbRQ&oe=69F76E8D"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ocn5v6BbxbUQ7kNvwFxaWyH&_nc_oc=AdqzOVMh-BHUxld0yBFewyg5ILcAXk-tU1FMeC0EjHzEDCMG_SSIDePsnIbxT3y09B8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2eO0Svmr2cQ2rNk3SrrDmPaWX-r-jcRDUidpLvsVcAOQ&oe=69F737A1"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bGgkZuUS-AYQ7kNvwE4-FMQ&_nc_oc=AdrLPj0ozz61n3DDBPNi-CSg_VxjWlwk7WQG_e-gppyn6bqSlaNUDx62fSGLz6KXUxY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3wwmMoNhjWr4GB8KX2eLv0ZvNwiQgJOd3FXiEqSXfdAQ&oe=69F75132"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6BMa66i8S-YQ7kNvwGwOO4k&_nc_oc=Adrt166G2j06JnX6gBQElmbv2CxBeeMXZJ75zamAOeOCkb0Mr_5zWo2zigeIIUVfWcA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1w4_X74TTbVBmQiMSdD_e77cy5Izf4JXjgPXDd9Tq6pQ&oe=69F74264"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
/scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C_fixqepZ54Q7kNvwGOXeMg&_nc_oc=AdrO5nVeqo_nXhhSYwqMthIqCuu9Rh3-sb3tcO6W2-ToeH4bt0CC2Qg7vR-rwZMMvbw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGWLMbrvFO-xCOR1SKRUr7XWvhDOODOh-5dqlFguzdBRA&oe=6A75CC85"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y5wz6Ihw1j4Q7kNvwGnLfID&_nc_oc=Ado1jvmQnbTUPTwy2wl5Efcft8VZ3JBTkiTeKl-fnUScSM9Vz2y-FAqg-wCKEFgNzU4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEudy3MxNBx5eoinZgVgFcmwIdhBI9U2H__r6T3wCHnfw&oe=6A75C64D"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TSsOrpu4rugQ7kNvwFfNZZ6&_nc_oc=Adowidi2VhqpZXj0eynu9vIiKQrc8p4PfuC5T3HyneaFNfWWKZoizpKp_rk7KJa4EY8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDUos5VbppFpU0PknjhjEaBBqRu2OvyUVrVGhvOplYdQ&oe=6A75C7A1"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lgzy5c5nangQ7kNvwHr0z5Y&_nc_oc=AdpFlM8UDqUYTXffx6rVY3GvVnySc_ooA0c3JhkDTnyTy9SFU3V0lCZIa1ZFsFnkIeY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGGapU-LS-arxRTRhirqxgT_Q_dQ69E_7UbcWlbthytCA&oe=6A75E132"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PhaCiIXa6I4Q7kNvwGYO8q8&_nc_oc=AdoxW9bnaJilCTSH5M8YiYCKNacnvvd-7Q0Ca1S1s4FCtmsAzzM3xWPqTkVHesq8l1M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEFekoLgVSLXY0lG7eEIBodn9G5Pmxdt81S6eaR7XtQzw&oe=6A75D264"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
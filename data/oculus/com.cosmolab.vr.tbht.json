/scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GKTMQEfgnZ4Q7kNvwE4TPNV&_nc_oc=AdrEkVHaTZs6CAZewQWul-2vhoflMmrbo91HPCsJp7DvfS0oPhZFwUE9nj-t63odZuU&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGB1UsxT6fa_qa69hRCm5CAWzF19gjlLn5hlRWzhHJihQ&oe=6A917C05"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Os65Dg8S-qkQ7kNvwGO2Ucl&_nc_oc=AdoN5iPn5UVAuMgRZR0dLmjEmJAI_aZOJEk_H1n4ugWCVn1DR6ucX8AXQOVQLF7IBfg&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFTIAafbSs0Q5fQJjJpnXjUugMZxQcXaZ4J7olj4FYJAQ&oe=6A9175CD"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IQrf7jwYjxIQ7kNvwHBXmEF&_nc_oc=AdoaKx-5xzc_8W7NUp0PgukjsISOJLBqLgyr_TdBVNHBErabUlRdFlzDGPAQZyZ1Bn8&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRCZOBwGIeUL9xJTy1u09hIXVDkReNtlZC6mqW0sfnzg&oe=6A917721"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wKNMMJUly2EQ7kNvwExiSsC&_nc_oc=Adr9QF1bYLo6OpVN5hfVrMqqr82ReS76CsAxKG1gCnJBjxRoV5JWd2mtu7g3hHSwwHE&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGz_WDz6eR0wdJiU5i45jsz2nawQIxOeRsXjyBg7X4slQ&oe=6A9190B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wUAgLKhJHYAQ7kNvwGPcOeQ&_nc_oc=AdpXE_K6raDploGCrso8GrJ7OV26k-qEdGcCtQtGpAyOxj-aCbizDYQ06rC618Uw9J8&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHlAeQsX3QEH4mwg8Mv-bnafLMObev_IEm8mPJhqBvI_A&oe=6A9181E4"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
/scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=trejL3meY44Q7kNvwFPwtRs&_nc_oc=AdqrB1Eas6Q95yaA2ZLzyYmJP1r2F5J-HtUuPHYRwpzEVpGXYLfMbLfytwQ7ouvFIKY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Gs6SbrTEpi8YbnBi_xD1W4XDhFO10Iq6fwwFsfTs35Q&oe=69DA3B85"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PDwcWe7iBZwQ7kNvwHkq4P6&_nc_oc=AdrmVGylPHImMdHyQhI9LTq8mJFbx2CxvqIO_ovY3pSXo7IRcFGvopdlDx3OVEqt6VM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2VCTj4x20NVCgvR7V5AzYEHrDfUqf0QG2YWcI64JxqpQ&oe=69DA354D"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=94YOobA7tK4Q7kNvwG1-6lc&_nc_oc=AdqOsfLQlCgmtwp3DKK_v1Le8-dLIkrFek7ytO843aAP8BTnfmOfZqIYdjw2V8SW4U4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2EP0gMcx7Ty6vMSgOD8BfoeUa1CAwu17RNWDc_2YnF9Q&oe=69DA36A1"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XAP83tEMlrwQ7kNvwHPYm0e&_nc_oc=AdpkB5hQAyJy_AEosotYK9Tz0C1LixfFr28YfJtdjai315a-un-n8Pj2l4xJoDzVuEA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af32SNbUEfFujzd8L6ij2KEYzpvVzJt8W0IHVY2UOtjAmg&oe=69DA5032"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mnC2gOmduwoQ7kNvwG8ubsf&_nc_oc=AdoUiCRdTd5CNDojvUfbuzsyoMGy3idYdzcBbSI2Pn_zTA9_wnDapANJHsCes7D3f3E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Gra034ur3OsS7TT2KVLuGvHRKcvLzfE2bTsY63HKu8g&oe=69DA4164"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
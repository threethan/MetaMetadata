/scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nauQ4gMqmoIQ7kNvwHhEmY9&_nc_oc=Adr0luYsedGIvaZvNc9o0UCuBIxdZIBDxE2qbVaxaau4axKrEkhF6LksILmzJO3Lh7A&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_A928sUVwNcxkEuj-eCyvn1SWzIotQDXw4C0vhO0F7Q&oe=6AC7C1C5"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6glimoRQq9IQ7kNvwGmpu9F&_nc_oc=AdpCaAbjaIXD5j4t_ptqM-bjct4qSl9l1yZaJH7MQt7k2zid8vNwKtBhtcbf08qoDjo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZC45qjnpgq0b3R1wUMXzqM7FN5QcDMsYWt4wfW0G7nA&oe=6AC7BB8D"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lZ5sP4bjchIQ7kNvwGzE0ls&_nc_oc=AdpvZ--p3Fzuuan1qRkJtx5HTcANGLn4tTJldLHwzWHEUykyAES7RAaRoOWRC2yAMPk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNblDYMppGzC5a00Ufiq1zOouF4YcLx6m53NVa4gKOrvQ&oe=6AC7BCE1"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EjxkUSmAh7wQ7kNvwHFIfrd&_nc_oc=AdoVj4oP0MC46BblYi7Dr3ECBjMb3Aa2AM7Z7EQLbsOGicqmisQ_bNUqOxZDAudw2x4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNS-V9DLQCNyqB1i5aoF0uDu-kzwuVYkEdw5ESDIEZVBA&oe=6AC79E32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=83yPOLgoboIQ7kNvwEor2SP&_nc_oc=Adqi-CCX3dsvZKT95tVHM5EKOODfNNVTqAkoLHDqeVCiakw1EnUkoXHrM1-y2idIceI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMUKlodAEisiMtxvA-k37cAnLCLgRMHpLo6YWARnUVqYQ&oe=6AC7C7A4"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
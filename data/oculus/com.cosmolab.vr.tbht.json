/scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gBdKKDbUHccQ7kNvwE6GvJ3&_nc_oc=AdreYuBBGecjpzcESv79mrhgvak4dTJbb8gdHo6_zYr_r_4xOgu7opxfwdCjlUQwkjo&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7fiiQRuybGXivDyPJdzbpu3cfVLsO3wk_iwuVmriZG1w&oe=6A104905"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YvuTSRmOt8QQ7kNvwEchPkQ&_nc_oc=Adrx16kEcfpTnuI5oRt4cOW3DHqH453osPJ1GecSTowUzuqMcaqY7C5OTqLD0YrPpz8&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5jkf9wVXa63FN_T0Um0F6kG0cPyAv2gK2BzURXLc1rmg&oe=6A107B0D"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xo2Xdtu9X-wQ7kNvwEntM0d&_nc_oc=AdrB2PoHbO_IQ0snG4nA4_97a81PHhjYLW821bFTz1GD_n_dfHkMamD-WM64AOujhJs&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4IFdCji5I4CvbZfNh0haDs9eD0tKHFrkCAHZUAK9mruQ&oe=6A107C61"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AN-cu6DMO3YQ7kNvwFK0UVz&_nc_oc=AdqCxqKPtCk2F0i2eiBSNYVRur2Oq3VSTifDXkLcmcdsP16QaRrfoLy-IA7cm6XelzA&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6tY3fCEdOuw__y8bTmZfz4J420vPxSpXC0BFDYs7s3Wg&oe=6A105DB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ev2zLTwgploQ7kNvwHUOsZh&_nc_oc=AdrLEDcYnOEhTJMZbe5qPuWmP83iTzfwHIAHCs698adlN5MrzohNGvPcfisx7A4wHuA&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5XAFOPHZ0Zij_iPc7V6mPQfAyXkPhD6-w-ODcK6ewD3w&oe=6A104EE4"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
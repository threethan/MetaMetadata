/scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O6Dl9dm43U0Q7kNvwF5AOSM&_nc_oc=Adp40Cfne5k7TxDLJ_frruyx3SMBlmUnlb68U9Jrga1J8EM5fA2-gpp2TIXCdlrVpI8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGd-CgzkpqUAZHS5cKPX3BMB5pLmEEr_8Sfg1T0TYzbxA&oe=6A805885"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k80FPOypRXcQ7kNvwFKm9O5&_nc_oc=Adqn85cx1JV0RpkJcXH2ekfYeNld0v3UhNzJ1HYvMulWPluI6LYOmnMMeojtzX_QSi0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEzy447PDlvbeLJV_Wm2rlvJkczjHN7HcJDIf5Fx1jywA&oe=6A80524D"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t9-y4DXvf8EQ7kNvwENegHG&_nc_oc=Adp1dXo9cf4l-VMq6PdY1MFurKeFEvcvKbpWmHI45rag07O4guPKN3U7yiKfOCZXGEs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9h7_oOGr8Gwxxm5svdrh-rgz482kyAFijpJtkfOS_Dg&oe=6A8053A1"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HJVnRVNNpXQQ7kNvwEcPP0y&_nc_oc=Adp2PxScpTmGCuqdbp5QSb_3e4umqYY1eck5o7bE_yV2UkHEgKaW21g-fAAisdCba5o&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdxIF3YjngX8TWJBqYYUN_O3BwIvilIBAx_uwi3SA4kw&oe=6A806D32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=StOqKAqhYSYQ7kNvwEUybat&_nc_oc=Adr671_QfypkSvPV_7sQ5oCThnnQTn-30qdYHStbmQ_BqDLgr6A625pi9D0POg99Q44&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE736KZfPvHh5WrymFcTMr4bO8yycbOV15MAI5IsVaAig&oe=6A805E64"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
/scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ncpau34U304Q7kNvwE1P3lV&_nc_oc=Adr3V0lENOYNSP-uiDqogu0JdtiRjyY4g7Wkq3VsZEyOyNUSjTGjkw8V-uWunacTDZI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3N57bGT4HOclbPYWYW4OWqQc-nplvK4se2u4i8otdxeg&oe=69D79885"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-cg35oWwS-gQ7kNvwFT1Tw-&_nc_oc=AdoKHv8MMqiX3V88Re16K4NisAPs3PKGxMtaCWSwamLUL-m7qRr0VRgTULm05-HDCrI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0oLoVyGILe9yC8e49L6oNCh20COvAfj-jY03Eih2DEog&oe=69D7924D"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=94YOobA7tK4Q7kNvwGbONg3&_nc_oc=AdqKZPECZDrLyqL9ZXMC2yI4_AvOA6zLheOhFN1pdSg7gRMReA0f5U193y5VIePQscY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1PXeYqx-3T0dyjmvJXq2SxXr3daCMzKDSHyLK9N2Ve_g&oe=69D793A1"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e3_DSYmE8HsQ7kNvwH_Ktio&_nc_oc=AdrpBGzjp0T-cyB5h-CVU6Sklyoe25dz_cmegx1JF5VpiC_pk8tfh9Ng6MEoR6rbtIE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af30h2l0fCojcRn6-wVwmRW5NP2CB9qeppZ8-rVWUKVQ3w&oe=69D7AD32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=URODD1WVOKMQ7kNvwGCXMRE&_nc_oc=AdodBwFxHpWtIFz31NkjUP5f8FTiChWcZ_zhRzIjjgq5b36bA0mruzWIJf68IYDMXiY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af21qjpf1aw0C3SQ23dkYXcIEz0_3Sh43F7yrGIT9ag3sg&oe=69D79E64"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
82723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IjUvwZkXFhUQ7kNvwEfHp0X&_nc_oc=AdnP3JD_GmON8KO3lCzbwAhnoZwXjuaqzJHyQK206KzNbmfd35SzVi4I_fy3nQe0u84&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxGcLz-ZQRZlb90kVHUvewHkI_bsXntHGnOBo95ytyVXw&oe=69AC1705"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o8zxI67UspsQ7kNvwEysLKZ&_nc_oc=Adl9GHa0QKGCFFuanhrZboAu9Fj09EjEqlAg-Z8MU5DB2mDw3LUIcuAGHg08zLDp7x4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwvQGIKtgN1Y4viJ3LsCSHr-jQVdaYukV238-Qpr_m6-Q&oe=69AC10CD"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wIFsrHL4FmYQ7kNvwFq8Qqz&_nc_oc=AdkDPqvA6f7eY9S2jJGrCCBbK_T6zoZrEdY3TUBvE6yLT1IlEk2sQ-t2dOfa54wkrNA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz8ZCm9N2ky8_Bsla7DO-zFImBj4wtaGlANrXUCHoGmFQ&oe=69AC1221"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cg5nznQNt7oQ7kNvwGfUVRO&_nc_oc=AdnuUMaf1mPrGsl3DYSjb_3XzD78u37Qnx0x0xHRuLPcSaCJS6ev4NECum8bm071rn4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwIwiZym1bhPHXB4Y5faMBuzD0JXri8lUeSjciHn-U3Sw&oe=69AC2BB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8pcBKJ7f79sQ7kNvwGp2XBx&_nc_oc=AdlQynSnhOr52ChJ81trc4NDcjddhssEiCGdDA9KaTyR7Ne3FLj5UYjwjWbYWQ4yRAw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz1Fwl0uzqPZasZteH182fZMt8MNBbWWWb1UnJqDCUTlQ&oe=69AC1CE4"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "re
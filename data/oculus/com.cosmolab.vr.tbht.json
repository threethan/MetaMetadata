/scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4nlcTT7LPJcQ7kNvwF8xa_5&_nc_oc=Ado7NUf0Ze8TATO4ulVi5VRjBYl0RXF2Sy8YLvo0XNDsyUccsYAm0Kuc5zx0wtCYflM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAjFmp2StHAv0_mTGIljZ0sVRLCm0tmuZEi7tgPzQ8VKA&oe=6A65FA85"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XM6qLxtRnf4Q7kNvwELq-jj&_nc_oc=AdrX2hgQuF3NP44xvGXOMOTJj1p-0OHjHljIiMdhApWSvKDLXT4fgdIdfQJgetVyohk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCFkJFrmvNwP1qp_6AtxCPEtS8mJC-6rDLQ1wsawBZCdQ&oe=6A65F44D"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yxblx2VjrgYQ7kNvwEDFSUX&_nc_oc=AdpnweWgmgnJ5kawAA8J07z4Ga-A8GXUrOSxpFms_DYZfLkXaBdjn0eeQkHdI32QD4c&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAzRe9uIMvfFYadPCm1NxfZHOxwn4KrUD-qmHhIEhn4Wg&oe=6A65F5A1"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jtnd06cSJ0wQ7kNvwELUdOn&_nc_oc=Adr5E5GngYKkeENJORmIz4lM-6Cm5VNcUV4MGkEhZwRYIsEk_JPnE1gjlehEcfUEdak&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA5leyuB7VBCT8NCA0y6j6_opydYC_ln4j63ggmVP9_gA&oe=6A660F32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SsviN1bBy0AQ7kNvwFbQ1uN&_nc_oc=AdqoIujd5k8aymlzZtgenEVge19Ce_MdMlSaKpkzbrNkax8-Qe06ZJ3F9bZHfANpGOE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCrFbeC51qRuRwZyi1lDizHzVLXmqM-wkZj82vr6wUo5A&oe=6A660064"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
/scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zLozVPDcnX8Q7kNvwHaympe&_nc_oc=AdqQxItBadjHI128zfQwvgmKhbSzSeAQAgYOJ-gQ0TiOmvz_psWge6slQ6T0Y0eMNUA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxbX_8hPEoJCCLHu5XSpc-dpMXV8mR6zW1c-fgSixlSoQ&oe=69C3D205"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BShPJSNE0Q4Q7kNvwEiFcI3&_nc_oc=Adr575TRhvha0iHEEj5pFitWwGmY0Qba1xiYrOGmYoL9oO_FDSjOhnZAttkynkEvMr8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzrktf5i9DHWKq7cun-9SC-luIKG3bc3YHSSXb99Bx75Q&oe=69C3CBCD"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qLgSRZZUymwQ7kNvwHqM1u2&_nc_oc=Ado6z9wWkFtI9TCl7veO-icnbBeQHVaj7h3k-HF9sXSq0PyBB8YsnLYtkPSMwPywdvY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwYcxFifXa8U3KxmqRificZ2j9Em6fLZRGtUOWCTLQVbQ&oe=69C3CD21"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GcR7URbZjxYQ7kNvwHUOPn3&_nc_oc=AdoYZBDLEbs4s_6ExeKRYBzi9738q353B4ykuoYNBDbs4e7B0KvymvQUHQ2dcfDkUmE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzHUWKqfSkcVCPvdoxnVdbjo5kgIBnFF6wEjHrA4J7zbg&oe=69C3E6B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p87WL6vNRMoQ7kNvwEBwWrO&_nc_oc=AdoioH8CXi7TnfFTOTvI41pgS_oR_Jj8L5Rida-Nqxl3p6UVRkHPD8Ee8sTg7q3Oql8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxE9Qf4qts_3JzlCVXp3PKdqK50LDdkgRDH5uZneomdcw&oe=69C3D7E4"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
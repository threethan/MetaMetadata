/scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=54itpMln1agQ7kNvwFQDZbI&_nc_oc=AdoaJ623PaSgLGXg9gz_a9f2ZoicfDlWAArI025EDYgL96uLpKntihacjb68Ncy4I_w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6QquZXUOJnx8N7ARCyVjAKTUG0oCGm4E60C8VpvI6iVw&oe=6A1DB045"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nlg269AcoiMQ7kNvwEynkyd&_nc_oc=AdpxSEerkzP28chN6ohZNlnoxC7BsELJbcmpi6sYwjSVZiG0OGqeCOuusOBm80yedpw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af46xQl7vMgT5eIMJgyOARxZCoWEVMkdCj8Wae8nYUxOaA&oe=6A1DAA0D"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vlrRnxFRBiEQ7kNvwFdydY7&_nc_oc=AdrdKzj1X-BTZPTFTCimX0prs0trfrww5o3U4-rfwpkG6uRXaZYOJ8eWrn5XsY4zHZA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6w2FNHqLYRD20ZqfO3W7-xL6Pe7wCVth6XR37JqbXUGg&oe=6A1DAB61"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S2Kj_yA9BBMQ7kNvwF91lSI&_nc_oc=AdoZvA4TxbQQi5HmQTNXGqLuEufnG9xuBI_uqScJ-W9Q6Il7Z9qYLPKPWQPEUPvc5Gw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4rB6lfifIQBZIL3f0DNgc8NOGBWKUv3it7ykTfghDL7g&oe=6A1D8CB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5y70SkkZQb4Q7kNvwHrt2kY&_nc_oc=Adq_MKumOIUd0aFjjrIplwElW7ehXrUzHX8MCU0oj4PZW7T2vdjbsAthiNv1hUKbNtI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af527V78n2OrKbA10nJ9G0Bxo1ADMikqd3s0dxzEZfZaoQ&oe=6A1D7DE4"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
/scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=upJNdfEueEEQ7kNvwHXBu9S&_nc_oc=AdqI9gl1LOJy_qvXBXud1XkkEEV26t1cCN2whzE1xEmbaL1pwhBdQBRXRDwoFl234oE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP8el_aoxbmMYk12FkkVzGe6xiv8AFQWoewo9dGmBiN_g&oe=6AE1E785"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FpnkPQ0fUBUQ7kNvwHb_pou&_nc_oc=Adoqpg-fNvEm9s-VDsDvnq5qMG2ASgM6CGx6S4_qn1TwAZr62en42q1CuG1HyJ_Yc-I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN2sFLGCiOx3uMVH5-4wDm-SDjnDNBw6dc3o15cA7Rl3w&oe=6AE2198D"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0JPL9AVFPX8Q7kNvwFVgVb5&_nc_oc=AdqL6bmgoxgspjr6LNwAezJEvv2AsXEmQzCdCWJ5yp3bYCmYvOZyCxxg8rkKJPmrFig&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMH2hjc_aD9rauiC7YIxlYxEShICXnK95jfXXcx3A3xSQ&oe=6AE21AE1"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d33tEgeYXBMQ7kNvwFPrDbZ&_nc_oc=Adpmlv1DjqCDxMdLUZyjxIMj3vzKduQYoxbbqEkrToIaWarZmgV3Q8tCSPgZuyW0Gv4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZkFGdQaMM0_O9i9Qt4QQmhxjZjnbBlTmkNLJZgvZI-w&oe=6AE1FC32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a0aOTo1hTrYQ7kNvwEORTPn&_nc_oc=Adq6KMr1rkZcLuRN-TrhNUt4kT8FLkYIVegpK0uCNZoTAiNgtGQxCLSot_bVGqLAnxw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgdTCBbsROUlxm66kAslgrSnM0-eBaW522DG23GAuiMQ&oe=6AE1ED64"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
/scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1-8H7m_Ec0sQ7kNvwEpJ6Ws&_nc_oc=Adr9RmT2unPPcVBrTjZYYajArl2cNc1Yd7DkS5llfesiaMkV0ClMBKufKXSGE5Fp61g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErPH9IqCsuE1Jcn9UFDYfluorZ4TKBrPoWSz7QtPHeBg&oe=6A708685"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bPZx40Ra9ooQ7kNvwGY-3ob&_nc_oc=Adr0Br2FPAJ5TAbT4eZgrDKV8t8792kXYrq5bbUr-54oeqyEEKhcTo-WzLjRcgmLWiU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG2hruKDzKnVvrxZDb83JG59_o0uEE_5iFIIUCMMsrVqA&oe=6A70804D"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XIQNzs1zcEoQ7kNvwHWOVXm&_nc_oc=AdpgxEerLSf-yYyFHBfMBPSLkEsw-JVhKVaGnCZ2hDlIWC47tjtoHSCPUsyM5ObePyk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGyDORPq6SGjShZkXCa8AYr_wSyeE2Oc8xSKuwy3eNrjw&oe=6A7081A1"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D-ENpnumt5MQ7kNvwF4LP8T&_nc_oc=Adq37dvdm-35Q1oqIXRQPRxtB9DEXzkKMf5WJHwy0mhayedgber-k_B9RD_umj7LQ1Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwtHErhIgxTMAMqtWU0pE8-9Qyibi3Nn9MOJ1wmZF51Q&oe=6A709B32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ryDmrDUxRB0Q7kNvwH60UXw&_nc_oc=Adpp-KhVE-otZM2DYp01_LbXirpePoiRdyhZoE8V8WkD1PzQZBFbuNT_xGZeMXZxVLM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFEtWa-jnJcqTVq3AMAvu_HEqw4pUoaBTWDGddhJXJcmw&oe=6A708C64"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
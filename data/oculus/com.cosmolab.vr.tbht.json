/scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cJ7MCsxy6PoQ7kNvwFR5QYi&_nc_oc=Adr-aytcGRLSEtMtLKTp0Aw2AlRrV2PhvZqgPTVRdXVsy-aJPUvpUB4htCeZaNVPlko&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Hg2jyae6mqEcgu3GpmB0nImYs8YSTpLmVCnLcLL8pqA&oe=6A380E45"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NzEC0Dvc_IEQ7kNvwHOYif9&_nc_oc=Adrwuk6iLKBL0c7af-Lzxu22e2hsb4OAfV6FRWwZ7q1jaMYhJZ1AN8etUbheiYh0YDU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ywVp09NxsqmPCUZrLatHHO6tc_y-g2twqC6t_tuHkPQ&oe=6A38080D"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ue3xtlmJY4cQ7kNvwFQT-Wq&_nc_oc=AdpT5RpNxMgQZiF3m_nYpIvLlNwM0jX1Fr_QxETsU6wKLe3SV1Yiupixt8MvUfzan5Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9MyJL5CdNU-fQm0dJg1WNmhYmrrwKo8tqAK6R00c3XHQ&oe=6A380961"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tibNj1zBpJkQ7kNvwGWVDVI&_nc_oc=Ado5hyD4BXYg9K9LFrdGAyWweWXmTvz-OHcCAinkSQ6eYoc_0bdlt93J0rkAcS-RSNQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-8wVDxZ2EUo7yfLiSNP6LgRQKGocF8BMQ5c12lHkADgA&oe=6A37EAB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HbgMyX0d8o4Q7kNvwHnPdoj&_nc_oc=AdqUQU3CZen0A_Y9fKzHJWpYMAie20nSmQsl57RKKqYjNK0WsKCVjQAo2Sta7oCfIgc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Ma6IL4p2TYFuknytSwT0NLYmacGIHbYU_nkU5suSn_Q&oe=6A381424"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
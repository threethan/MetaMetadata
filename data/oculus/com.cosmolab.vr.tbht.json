82723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DSRXknDId00Q7kNvwFU5nLt&_nc_oc=AdkYmNbGegpLZpFayG1LgzwEmE0lCElcRzDVFM0vdsOijck47DrnhBEBiOfOcMyA8_8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxMZiSU7WfRGz9pJpkK6hbh1XYm8a0Rc7De6F0Hn6e3QA&oe=69B40005"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DhZLOMmLdb0Q7kNvwEqx3Ig&_nc_oc=AdmTYsd29RAXUs6hf8WeAt0jn3Moek5vPqzv5JLj7vAD9ZXR5v552FJ2pZfwzXVwGbs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwfQg226BFI0XzlgU2yiVmCFyb6-wAkmrcnuK7ui2Wseg&oe=69B3F9CD"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qc3-ObAQxUgQ7kNvwFvHbzo&_nc_oc=AdmNqxWzsQQAawXJzCEb5J5Ed1l0Lu6PLOV7k-5VroaU1aRWVH-rianYqIKkITA-jks&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afzw9kHTJ90Qee2Hn2jHr0GfwPmFQ2RyrnrV48A67IVfuQ&oe=69B3FB21"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t2DjhAmtIOMQ7kNvwGdYFT5&_nc_oc=AdngJkCVEqKZpAITc_lb6Wr9HslvdErfvnuTMbua7Dh-lj_WU0AYqZ-zfiNXH8EODrY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx3l1WxTZWXsbjwflUC6mrgrxSPoG_0QUr_sYPwmxLE2w&oe=69B414B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h6g2dNfO-hkQ7kNvwH76uoL&_nc_oc=AdlOqpdh6m6TNLsHcurfVcj1AoDGvNJiQbjk2xkXkQE_LJNYcBikMnXGJczgATB9E_g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyXunWQLOWnewezRYQ1Z4xQ5upLgsYWPoP2dDtbprPHtg&oe=69B405E4"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "re
: "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wJI6aOPkHzwQ7kNvwFbbXs-&_nc_oc=AdrY7Sstk5BVsVyKJ8r_Ujnln63NpAze2x11ldp_ObOhahzK9PAJ1rYykEWDlSpR09I&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgod-h7wkayGz8691Gqk5a3Yde19S8tC3WoA1BEl2veQ&oe=6A859E85"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g2yRQfZOy5oQ7kNvwGFhTeB&_nc_oc=Adpj6sF9EsJhaHIUMvWF9-0CyhU-UxI_G4hb3VaH3zhgi1s3udNBAESsTPAxqOa8HeM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4UvCSkteZzCeniAEf25kzstdLIST0j-vsA0jaArauIA&oe=6A85984D"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fJ4hMSLF6asQ7kNvwFsWwfF&_nc_oc=AdpgP4L3sGjw32hqfaUcVWtvjCSptziA95PzXjJn8FfaAtqih5t7TKvBuMvg08i71Dk&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSppoLikrV-3IeWHcNNXE9QM6AiiHEW_qBrvU2iFgMZA&oe=6A8599A1"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A_QksPhG42AQ7kNvwFiBMoB&_nc_oc=AdofPSCghQTcbuFStm-j1s0k2ARg6yihgRoL4-6ZW0sgZ4CQWfqSNQ3PbqKuYp4oFEU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJKnofLWP144TIy11JgwUKbtTh2nAq2e8dUATCf5QnoQ&oe=6A857AF2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0n3T4bueq0kQ7kNvwEVSwG7&_nc_oc=AdqiAmoSX0ynOmvovP26RsmtHKe4fVeWgD1yEN4ln0GNZ_fwnNpHzoy1rI0W5MT3Btk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGm47d2XQDMV4zlQ3PgfP58esCrbuav1Lszwx1bUFNluA&oe=6A85A464"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_
/scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sIHnaj_MynIQ7kNvwFvDy-W&_nc_oc=AdqhYw_B_wgGalLwaZWXeVN2DVffMfzVooXLHWMba0-7X2xIQ70wMYoNpX182_FC9v4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBsNs7GJKuX2TDlWjvgOCmS2IwsgtujDvVf4XA0QmFLew&oe=6A69EF05"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zt180JHS6ZoQ7kNvwHC4X5m&_nc_oc=Ado3ic5X3F8lMPyudgVIlPx6ucNVFE5PraDiFv2KgqaEBdZZEHjkwPSAkHvC5sMwFM8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC3uv1j40ETBEDpZeI-OQQn8J5YhDexaYS4qtyR4S-4BQ&oe=6A69E8CD"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BlvRegRfJ3wQ7kNvwG4JoYe&_nc_oc=AdpriWNfk_VCli26d0aMNsDWRyB6AfNxinzA1sU2hkBiumSDkf752AyJfTJz-4dL66Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDB31HLGqCkwZn1mw8L2OBYNQ_6d4o7l0MUBGrw17J6lg&oe=6A69EA21"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S3H5QHS3rZwQ7kNvwFCnB7N&_nc_oc=AdpY1bjFRlK2cLvEN-Ztjyr5Ap6UBtLgvJsLUYOGXOmBu0auCX3on0zo8FwaIqKqiCU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBW5bYs-UJl5e8cOUIBjESVon_xlifpnLC9k4ay7QYZrQ&oe=6A6A03B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ioLkN4v9LCIQ7kNvwEGKi0J&_nc_oc=AdraoFxOmxAVxZMPd1bNxgIlyj1xz859lXc2nfv_wJtCggf9_w9fmlJPMGA2GKdfxiI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDWVc9kRMNu1xNjbk7rFLLc7BdEHmKL3wBH1o_8Hk03YA&oe=6A69F4E4"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
/scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y3ROBYpUhZEQ7kNvwGLFCB3&_nc_oc=AdqAddXpZQChIZC_kfr4jjlg7Y05T3eiWN5s36pXflyVi17mLicyWXC4UBTvyeZuDXU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLv_-Trj4MytF8z1GehYOJY9UJdGq5QEigF_KMcFtl33g&oe=6A999D45"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=05GvMgZqlQUQ7kNvwHkQEmm&_nc_oc=Adp2qs96RfKG9HZWyI13YswnNSiqmJF1LYJX29zU9N8LxY4N1rY8ZudgYrQrFaVPGuE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZaZYh5TSrEbEKGh9mb_k-VhvDheMS5z6mqqGrfeDFuQ&oe=6A99970D"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HEKIAG7OPw4Q7kNvwEGvzL4&_nc_oc=AdqGgCqWhIKEI4Zusz5VA_UMTlh4FHpWXD_ANNUsnojaPtvvoD4Ae5mVSNBPzQO_AYE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLGAwGtVdNdn1TcMOoVGnKhbVU7GVvINZ_zW7eyZbq6hw&oe=6A999861"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rdMt9apIqxMQ7kNvwE3UM58&_nc_oc=AdpZn2WDnmZF4F7wTboaz77mGxI3Fm6bD_CGP7xV9X7L5uH_6UNsO0fYhcAtvtOGIQI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2LGw6ZcPSu-meg0P9Pd2t8AcXCWc2Nlg2GjqNfgRuxw&oe=6A9979B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-DjUv9x0DVMQ7kNvwFQ3Ee9&_nc_oc=Adob39ls-2AitlNVtfjveukWREGr_piAwGENp8oKuUmGn1V7AhVQYlaxGwy7FM2Q4yo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHRZTRSYQ98PgeLmb_qZ52Vjwk-7C4OuKOVmkPMS4uxw&oe=6A99A324"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
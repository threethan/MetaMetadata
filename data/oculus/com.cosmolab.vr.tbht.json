/scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nqreCwFOPqkQ7kNvwEY3sUw&_nc_oc=AdoZUprN4n8pCZ0Fof2NuU5aZspghb_Lty2gxuGQYl9mYCgzdZvX8B7tc_FOL0mDhnY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCxKukLRBiudX1asvu8h_MRIsitT6a0d60F5g55tTa8w&oe=6AF1F1C5"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WROtpRpwMyIQ7kNvwFFKS0c&_nc_oc=Adqg3bpkUhpd-gbhH7RCTERMm5UdNYmzuqHXxsadJUxG8CdeMG1cGPeR34xHgrEsb2U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpsjH0eWSyEDeHvqs9IQqV7iwBmt0aZ69uLqAgGms9rg&oe=6AF1EB8D"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZeJNvWJdNp0Q7kNvwEFYe48&_nc_oc=AdpN_8WtXoxaoDw7CkYCXClkUKsOKV3NDd9ThoG1Mfq0LOAocosu2IfLhNNkZFpzp9g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMswQnyOyCk3NcdRs9owlhgmp_lHOWfDpkWiFxG7fDgg&oe=6AF1ECE1"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dDlrR1MIQ5wQ7kNvwFf4Kkb&_nc_oc=Ado1EmBRGWM0BIbJKSGHX6HRP-zvV0p8-91OSDjBL2SLteflqagzQsu1p-Gbx__VhDo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSc9SfXf3BRDJ750AuLxnsg5tnkGeIR36K0R6ZffhP8zw&oe=6AF20672"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pmDPtQzFII4Q7kNvwEzYDFS&_nc_oc=AdqZ0gwL0iyEvbzEwiTHQ-BlaGP50VOPTJQtRWJ18QgC1Vsfuy0PeEDNqDIEugKnicU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwNZxg9SkjkumhhqLx5H9-cBYkVti1rHWAcIq2Lhnvig&oe=6AF1F7A4"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
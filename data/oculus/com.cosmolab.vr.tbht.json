/scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VgT-O8C5c8IQ7kNvwHGDkTv&_nc_oc=AdoOLj-qmpe8Ad3cU6KicOCW6nbT4AZKtgCAM1YfLnUBgiBe3jdT8a2BDQZ7t_pGa5U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9f4nq2AZHYipmvPtD_XPM-cqypjcy8WCI4XGNQifO3Mw&oe=6A47E045"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tEG47UsWOK0Q7kNvwHQpSoA&_nc_oc=AdoNhEunlM68yPFAp6hrKpCVyVpw4GkDpPMlj3xPXMaZ22vEe_WqJa7ecWQ0nBO4we8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zekSBF-sHDYquI1Vm69ec47AyAa5OFPh_6HHtBm0iqg&oe=6A47DA0D"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nBPk0KckqIMQ7kNvwGJvsqW&_nc_oc=Adrht157zNH2ArOmOBeM0UQd6QE-5AxT-iq6sSxBD7eTTiMeoFpmx_z2fKvWshRidJQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-4UDq9cevn62ZwSgDb_tSmkR-tp-Bwxr-wufeOuC0Uiw&oe=6A47DB61"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z7Yu2MaQh4AQ7kNvwGz5Pqy&_nc_oc=Ados2LQ2U5okHmWFVBHIF_mkpUMD-LW3t6Iojy5sdVuGQqyle8uk8kBlgd5qxvmidIk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9drk0Rm3CbCSe3__H_mG3_EYD1d3RJnSeF9UGr2TLPPg&oe=6A47BCB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sgcd_TyZaXsQ7kNvwHC7jQv&_nc_oc=AdqgAVj7KvED-0MFSbr2WG5aTidk9P8y6uoHe4qi39GZFP9VtlzB3ToRUWGgw1ghVa8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_KbggxkVGh0QdMMNglwVOHdpnXr6BKn59NtyQ7mrDD3Q&oe=6A47ADE4"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
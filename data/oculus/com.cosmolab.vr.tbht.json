/scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kzGHqE5yEwsQ7kNvwGhjBH9&_nc_oc=Adp8dY-q8j0mNsYkJ3xd4TP3rrw000Q14qH0lB3nmpKYmlJ-bwRHXRPvVXnpx-TnMUg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4u4ZvUAKhk4HXzGZhaAwNtnFfl-a0B9VgIBYwCmOqzcg&oe=6A15C745"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ihtHWcMn1KgQ7kNvwEqKZXg&_nc_oc=AdrG2DuoG24y4jJx8KVDedSCDJxNzRHBeyQpUYly5wIjZJ71Vu20WAi4xFXAGXiJnjo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WMrT5EV6h6Gatv4Obi9flv6kIhENoXgrCGNeZStik8w&oe=6A15C10D"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uQrcbONZlK0Q7kNvwE6GWRq&_nc_oc=AdqRWAR5TJYtmjfnME2MQ_HQpeu073LLOP8ytrXV25DWuJJ555KUQStzZlW2MsLOyyI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7SU816vV6EdfIXbg3e2dx2ygpHXKrWozdsOoUDbgMOsQ&oe=6A15C261"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OMLn8H9TmhIQ7kNvwG3p4Mv&_nc_oc=AdpAaRwiX8cP9Gpm4a1asOM8gDq92hY9rPIFgseO9KYN5ubYp8c5bdWhfquFvo5DJbU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68Pk1mhDs9zf5sU51zthHdjLkAXmnWZgmhRWefPhzXbw&oe=6A15A3B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iZME7g-xiCQQ7kNvwGL725N&_nc_oc=Adr07lPfGbDI98rDvNoStS2sshqJ9QTplpes_dUlc8tHTEnaYR96pCeoU8pOMv6HcSg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4NWcXtUSop96FyY-X57V0oa6iEbo0EyjwB-NnMiMmYqg&oe=6A1594E4"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
/scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TqNwh15Y8j4Q7kNvwGf-dUc&_nc_oc=AdoWSwFTn_-RcGo0nNwLjVja3IX7Py4Drr5OU5hrhNdkkXNLJfc8G6YV0DSf9HbedZo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA7A1A__t0T18Vm1lRTh7vImZtpqL_kIIzmgxNVq-XJyA&oe=6A50E285"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F8uTWb4M2fYQ7kNvwEG4PmW&_nc_oc=Ado_VglgoxEvShn24xFf6Zo1KiuNxe1_g9jwojCMoDxSeWnZgNVUPdulvW4MqrUwJLc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBGLTIEa83MUCDYSddTmO4gu8BOLofxyzagpobSU_1S2g&oe=6A51148D"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7W8nJVWfsVUQ7kNvwE_kig8&_nc_oc=AdpZdUHw85Gl7Ir43zzi91ONeCtCYKDYuRz9SrJhHyX9TdPmPvG8GI_vyyGOHRT8oxo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8Zq9mn-DZTzC-bpOLImXh9rQ9C18WO9H7tTebmdCpqA&oe=6A5115E1"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2wjLMZCiDpsQ7kNvwHpmSf7&_nc_oc=AdouV9wiEXD07Ez88eV8Pm9FopnddS_aBNFaVy-VFzgEmanOKD76JsEdL68y9CPAkGw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDF9zbmPHCQATwIeRzyqoUG7YlNYg6IzWXKdMooHTgtZw&oe=6A50F732"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JhMNWm-sQMMQ7kNvwF5ozBn&_nc_oc=AdpM7SIq0IW9Ohgv6XlDEOpSFlmilCcdlYWQtCc2mXFLi2Nu5x077jC7jyOwK9IE5og&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDj1FSSLIXS9uUA05jKYYVXO2sVDiigoCu76L8ybxc_ZQ&oe=6A50E864"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
/scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2pVm89_mA5cQ7kNvwFt3lsO&_nc_oc=Adpj2n0b1bEKd72UrDOHs2HeBiroi8Z49C_Pwsy1kC-n-nikU4ZtlJg7_J-7U04z6lE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6HgG7JW5HoEBGcEK1U1oPKaY34Wv0qZY3LQqJw2gL-Lw&oe=6A1AD505"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y_dwa1YENJ8Q7kNvwHOoKw5&_nc_oc=AdpEOXXPnl30nZ2i1ciOueWu5jOlwUwq_cY-OWNu8euYLC2Xqfqh09wNKrSKYgAaZkQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af75EhAoqNxwZXY2RLLDTJyCZPCAD3lGqgFSNJW8bXINuw&oe=6A1B070D"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vlrRnxFRBiEQ7kNvwHIX44C&_nc_oc=AdrntwjYyalqLh7nbXs5bIVCcMK1audI_9AVsulNSMjUEvLWKHauf_y5cx_ou4Bbh4U&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af72UfLFSrveR5uUIMItHf2goKgAwLmKU8eHr_88h8FrZg&oe=6A1B0861"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uZ4C63Dm9lEQ7kNvwG_1fuJ&_nc_oc=AdqZiVGikJGn0wx2Irg302QPn2pQmlSWU39e_21Lt4NlpCX2kQgza9ARnlvR9K2FHD0&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7w60ja_LRTm7qHvN3JQ9IrU8HIOYD1JugNUntvJ_rFog&oe=6A1AE9B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nf6rlaw6VPYQ7kNvwFxDwBj&_nc_oc=AdoLRwjN-AeYix65uRGFwpigffdI-xY8gRVt2y_VYcUrTixrwGHY-ryTIEcrqNnVDcs&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JE80ONiIEseIgHiidXUXLBB3N_9bgVCPrz1ym7ogbQQ&oe=6A1ADAE4"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
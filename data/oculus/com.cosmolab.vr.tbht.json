/scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b18tRkT2sIEQ7kNvwF6WzYF&_nc_oc=AdqrnM_xD_-EuIwljIWl1u4eWYnnh0tP2YrbES0aII3T0VM3k6kwmsD1ObdYtKbGdGs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3O6O7_ohyBDIWZwYbqYUG7yO6lj2hpQKu96Lx1OSDk9Q&oe=69DF8185"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4zGPEvYk104Q7kNvwEMvFNy&_nc_oc=Adr-vsLhAwtEzRFCneMLOejd9wwkzU0uzJQA5gRq1yhab_BgIOnZohTaW0-XzgkrWn4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Pr4R6ucnzvGUwkUQD_j9OnTkFuo8QIyj0AcQz55Fqrg&oe=69DF7B4D"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eo1mCxgCK24Q7kNvwGiBSil&_nc_oc=AdrbgV5YyAt3mUL1xlVWd85LDFMvBIaR5kUFHNRfqbGQm2Yo1PGq52Um2KgMo6a0Ddw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2NYmuSr2RB8ba9t-4OoDDYEXAzpUGHEX8LwC9fMSiZtA&oe=69DF7CA1"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1MROwZZuZH4Q7kNvwEUPXz6&_nc_oc=AdqB79f4DPeikd3i_OBxcj7uMx6MpX66MlJzQzZDTDAVdRbLWW1jZdUOquSb-Xi4r1g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3J2RIFpt60ResKEmdyABpN1ZQh63aAtfoGMXkqaH5fEQ&oe=69DF9632"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Q3XTFk5mi8Q7kNvwGB9rnf&_nc_oc=AdoHibhpGgDp-Ed6essmAr7V7Km3gQAyyUxKKm0vxgJoPe6JQPr0eOI1mO1f-5cEVHw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2HTWZVR84HK1z_Gd_sWnc3B_DulipWa0qBgqaGM9PvfQ&oe=69DF8764"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
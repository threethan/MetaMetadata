ttps://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ip7wfHPnJYAQ7kNvwHeV7Gr&_nc_oc=AdrvWeXTeWvpyw33_4vwbNOx7s_SElg4Kh459KbsKPcGzFzFOOv4LWmagLzEWU1H22E&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIm0xQuJx3RSf5Zlf-kTkdqGe4ptwcWBwQM3Du2ThRW0Q&oe=6AA3F105"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Qf2qTcWoo0Q7kNvwFWHUi3&_nc_oc=Adq_vvTBQtdwnZjAlpJhElYxgd8IqUN3wmNuNrb9zlqNwrVRn7QF0gFPYfq5ujnyP5o&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5VLSYLEMfcs7tzWbhpYHHPeiUFW2WRuitcxGLCE19Pg&oe=6AA4230D"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZjaLaFMwWz0Q7kNvwHfgtid&_nc_oc=AdpbWeRDaa4iCebhW5Y6S5nQCMWomApo9Kqt4khSn6B-3rG-Evx4BDjRVQW_neE8jE0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLBc6n7PyTQdrnkn52c5uIsc3svWEJ4CZ8UKVf7wuXIkg&oe=6AA3EC21"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=85rXfsnm0nUQ7kNvwHwkAjI&_nc_oc=AdodFX3QEv8Z_jdBKHGnEBF1wvx9yTOMO_r1dUyGXIdQvaYz6ZIgn_KeqDvYAFZfgo8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpDKtkRCIkg-34JvbYttHf9_Vur-55lQBL2lA8yLuD5w&oe=6AA405B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4vB_34CroLkQ7kNvwF0mFDR&_nc_oc=AdrIV7Mlc2-UIEQRVCGua3fmqDxtFxukCW4kBBctHUq7h0rP2Mx7sITcO8xUz49Qj_I&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQID4CM77Ae0t4wNqZdRnnF_lfKaXmwxu9ZFSusQIqp9Lw&oe=6AA3F6E4"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
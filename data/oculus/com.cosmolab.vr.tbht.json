/scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nbqAExht9wUQ7kNvwFo_6TZ&_nc_oc=AdrWP6GTJbea425yT9pF7j_8hNmcS0e9rR2z3f4tURTy0xSPqCrscTkZk4Ui1wJVd24&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_o_c57BYcmOwh7by37JAm8HPIgyDwdHE8iaTE2UaWwMg&oe=6A426205"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v8jiQ4nYF6AQ7kNvwFUpUX3&_nc_oc=AdoUsrVtQNGTZMBVe7h9ATQohsC-9mB_rPuPXDvH2PibFFP3qNw4rRiZqhY9yji5khU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-8D3To1bHvkdN7UBYwTa40LZdWAtFWO8f-LI7ym4Q6Zg&oe=6A42940D"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rbz0odoM7UkQ7kNvwGKbHFO&_nc_oc=Adp0BCLrWHEYjICj6mKtX_90WRoiqVtcWhNQbJ_mO6TUJg94XWvlK1CEbyWBWsmYzuE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_uxwdLhOigkVzDVlw1FeU1GN4vaA0ERusprQWiFpec1A&oe=6A429561"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SJ6nrBqj-OYQ7kNvwH1S8OH&_nc_oc=AdrYksUNJC3yzEb1v5adxb2uSFKcy5o-suwpdKWTyOdMUyop6jXINZhi1scC4j5oSzw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8XVncWC3o_u6O5uLtepcaAudQ1i5Kcy7hJx-oOe3RQCw&oe=6A4276B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_pAE26XgVTIQ7kNvwFZtrof&_nc_oc=AdqCGeNXW3tV99z6V07igRjqPEzHmESrEi8A2kDEK_sxPWoxgptXIktVF7qTo5WZRxs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9KbWYcpsgmp22jSHrU2XquOfoYcIjhdaGEMKxcxqm9Zw&oe=6A4267E4"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
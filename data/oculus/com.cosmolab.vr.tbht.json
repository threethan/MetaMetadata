82723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kjjs8_qDErEQ7kNvwGBJ2v7&_nc_oc=AdlmoBOeys5FxuBbGKmubrRbqnHsf2HKYW_-2T3mlI1rRGMhXkzNwBHlugQtq23pUfs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzi8vFGljaJBTVXta6wi1eVCpbKz6a22b1FoypQBQp4rA&oe=69B6A305"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Daw3sRWzaRkQ7kNvwGgba1r&_nc_oc=Adkgb7jTQtHISXXP-GNh7m4xKP_lq-kDIM59eWtkvy5puAEJyNFN1wWGUfZBYPgnuLY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxdF_Qj7OtLMJL0hK8zpiWFoG4z0DC1QEGNSLPyLvkQIw&oe=69B69CCD"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qc3-ObAQxUgQ7kNvwHxPRrY&_nc_oc=Adlgvndmq6q948ZjJs02notrw7_6PJZeTX_dvQ-NkkeeVD77AzN5QvJHwNZcHjdEHzQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw6_AAGWRSC2Um4f_O5qapxQ94TM4QDzhtuu9wlDuGhTg&oe=69B69E21"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z8XQ4M9ui2AQ7kNvwGuOyB9&_nc_oc=Adnjhp0kErLzzsgXAKHQANgbpegSrQGMDO_cSAkqmjHgpMy5xhR2_7o75MvWfc7Xir8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxEAArDtC9fP36Xgp5ocClP6HPODe9M5MLwRJkaSofqFQ&oe=69B6B7B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v4YfGbW9Vw4Q7kNvwHYG8rZ&_nc_oc=Adk9jnVjSwGZ8JLBaa1j0AYzmDwmASH6XuV2SNm25rj1NdtDzIJlg8FSqSzZA-Lecio&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx60JCylKK1POdpFqNY0M0jBPHjnb1-YovPs_UUl2l1JA&oe=69B6A8E4"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "re
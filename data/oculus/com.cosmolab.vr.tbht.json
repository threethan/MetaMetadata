culuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zW1mvCXFtbkQ7kNvwGfl8xE&_nc_oc=AdkmIKai57epbuq43_MCBIeRaHdG44EeZPQHLdtWIPqdJMCz-EsxrnMvk5iYnvPUChU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuyL7yM2soUuJAF4e9iFCBzFIGSFXXJ57c-aBjd_iXwQQ&oe=69A6CC21"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MbBs86FzVWEQ7kNvwH5iu0Q&_nc_oc=AdkhpaZSw5hAoRn2Z9H03sDe_aaIPIT5PBHBS7bbb6ONAm6Yl-eYRsXyFi2_vSEBqE4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv9DzPPCcj8VFgcz4HPcGNgIrnvvehGDAVnhDDfANp3IA&oe=69A6E5B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "marketing_size2560x1440.png", "id": "1784117029067712", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75416841_1784117032401045_3678780063830164221_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UtOYOHdkHJgQ7kNvwF47r59&_nc_oc=AdmkphGRltQgRZ6DbuLw8GH7zYw-0LO5edRJ_pW13eVd0DAu40FwwiNqEryjeBV1K_I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfudvstaF4nY29hhffXaChIfOLtmII79uHP4TlT7pp3jYw&oe=69A6EFE4"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9431446566906836"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "897039879987045"}, {"status": "PUBLISHED", "id": "23982779144693380"}, {"status": "PUBLISHED", "id": "1161774855685442"}, {"status": "PUBLISHED", "id": "1331879174632721"}, {"status": "PUBLISHED", "id": "1274844387088806"}, {"status": "PUBLISHED", "id": "974462981414267"}]}, "baseline_offer": {"id": "1331879174632721"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773421200, "status": "PUBLISHED", "id": "897039879987045"}]}, "liveChanne
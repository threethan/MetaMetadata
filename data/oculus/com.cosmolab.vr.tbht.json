/scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ObgYtPOj1QsQ7kNvwEyf-yS&_nc_oc=Adq6C1tkWR94exbsj4fYEaiTywHoqpijSEcru2M7YQs_WZHMCIagMygzSx-VIg02WnM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPbq3Hp1s7dcT-NVO6jb5uvMHkN_fCNtOoR2A6QIBF2gw&oe=6ACBB645"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5TTTRnOo8zsQ7kNvwFmLGPx&_nc_oc=Adr_yiTZoIFpSjAek9o5nrwDpKAu89JAo514YqD4iSeQ33Lq1_yeZaCLxcbLfhBw7JU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNaxLa8IOL9gkbisN7MfjKvcNvYjlzTb5tk8UxHirq6OQ&oe=6ACBB00D"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=REhUctWSQD4Q7kNvwE7Fhhp&_nc_oc=AdqjxoerOff75xBa3SXXsCK5ThDudPUcqYXWrAXFX59dV29ptye-hJZxTtatwkJCweM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOcFecCvzeDFamYKeVvXwS7Ry4N_q2npXpS2hKTJTw8_w&oe=6ACBB161"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zO9Tw7cyEsAQ7kNvwEkIHu3&_nc_oc=AdoCYQs5r7NUxGpbAfWoUrXdxFJnxilPdEDTE8QpZ6DLzeoJxALU3YP_sTdcSXihsTg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPx57BdIyzDO8BBpmTQzTyUhv-I0otRDsndH8T6Xirycg&oe=6ACB92B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yRcsowF4W34Q7kNvwEhpWYd&_nc_oc=Adr3rTakU9cjXAXc33ToyN6xdIKGu97W03I5k9rQ5wJUfN7KD2GmK7_vDN8vtMAP5gQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOexoqbvkD1Ds2DjKWe0AFYmOMB-qnx4HEoV4d13_Y5Yw&oe=6ACBBC24"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
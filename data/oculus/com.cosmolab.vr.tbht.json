/scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O6Dl9dm43U0Q7kNvwGWGDUU&_nc_oc=AdrLkASZZRry05Xl7_GQ4XLMPnn08c433A4gZ6NmTKM6qXi7jWznzItkWxXPIs1AKhU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAR6IpRs-meEx7tCycmJdcDifE96NeuJCnm9oKJuBvcA&oe=6A81AA05"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k80FPOypRXcQ7kNvwHf0byb&_nc_oc=AdqwJH-l7URtKJObS1YUfLs-4S6RWwkkZZC3rZdKIs4VeTM0gSnUh2a3bdV0rzdSarY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGP4-xPU_ADu73jowEx1o_A0aEZVV2m76go1154tqN6dQ&oe=6A81A3CD"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9bwzjINma8cQ7kNvwFh31tr&_nc_oc=AdqT1fLbx1SXmlI-xAdcMPn4Es1F0Rhtoh4riPDwrXyDViH-Wi7O8cmAfFW7vll6mMM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNzizEk_sR4PBuMHTVypVk_NU6DElzOfnzXeRbthTMiw&oe=6A81A521"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HJVnRVNNpXQQ7kNvwGPE-o2&_nc_oc=AdoGkT1uoQKmHReuu0qHPgz8xZzODA_X1Nbg8bOh5sItbDwb_3NaGT5vp05d9bYFfDg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhxd8nCgNtdqhapBY_BhuzG4o-2ScBVe7H4PuQGQ4VJQ&oe=6A81BEB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=StOqKAqhYSYQ7kNvwHf4_L-&_nc_oc=AdoMcZ3y90KUVjXQACoetVJVCJfNOv2WMS0cFhxAd3JfNgETQfD_wFcFa5c8xQtoi5Y&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHrlVzvXEHGaxDa4jH9JlZ-Ss99mJG3YJMob8Re8EZwkw&oe=6A81AFE4"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
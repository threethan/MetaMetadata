/scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sIHnaj_MynIQ7kNvwGHqVTE&_nc_oc=Adrkui65UTxgYMs3uiHMEjRTDhuLdyyaUoj7uTeUI8uSqDsiFa-B0_jFyh8byXwPJl4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBCNAWoo1VC7Fy96s0CW0WvE7r8fag0r_Mc5qrPKcJBBw&oe=6A6B4085"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zt180JHS6ZoQ7kNvwHt8WPM&_nc_oc=AdqKVygbIf0mgkAfuzLyy6spc_VoNqZ_Rf6R_wxqCNclzXRJJL9OVUMOtz8_1ly6sd0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQARptQKsZYVwiydT1RRgTOpgO5SBac4le5KtvV5kdz97g&oe=6A6B3A4D"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BlvRegRfJ3wQ7kNvwEg7CAC&_nc_oc=AdoaIWj0GAdIizh7aKYz0FI3ik37FWVJ5eA2DVZTGR54C1XJGjo7Gyw_4mx19EsZT8M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCgP1B4uk-I9zILwfbtwYm9iRpA4upAdoisrTLa10pnHw&oe=6A6B3BA1"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S3H5QHS3rZwQ7kNvwEXbkwg&_nc_oc=AdrpVLgETxKL1Qy57xH9jyzAZDOyY4viL1m-T6PkF6tuKboNOBks6VZ_cjRXkbre5wE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDMUoG7O86YeZg7K9LO56_ItBOPCkeNdCMpxiBqGkf9Mg&oe=6A6B5532"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ioLkN4v9LCIQ7kNvwHBvU2Q&_nc_oc=AdoBVHu7sN7p5osLn5t-WwVSXTb36Xyyqgxm1UxSi2K6pU1DTyGz3EN5SytXT2sj_-8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDqDK4-od_AgB2L74ewPuXzBKyEBBn1gQE9n0rkGOozOA&oe=6A6B4664"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
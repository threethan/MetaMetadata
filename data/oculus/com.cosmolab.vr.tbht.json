/scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lsa0O1zlrRwQ7kNvwFnWQTD&_nc_oc=Adp7G7o_qjjxgEtmQWRtgfzvgjLN0SnL-Pojj6VukbzmTW-J931Bt8B0Zj1k9L1C-tk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEedbkHybyKK9Oq4BgAJz3rK00OJXaFy-qpwKmNwg0BxA&oe=6A7F0705"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IL0puHmveYsQ7kNvwEh4s5q&_nc_oc=AdoIwHTkhOJghmFkmoYr1TqWCr4uiGmgVU6KOwF_98CF3hJJx15YYMSplN-CiWR7_Y8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFok1fgNX9SsW3Cgo3SHOYfxZxgBGdG4BZsPYFU-sX6fg&oe=6A7F00CD"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t9-y4DXvf8EQ7kNvwFD7tTW&_nc_oc=AdrXoroFHUJSorocepbmVEUSDmOAch85J1WI-hw87Lhqf9Y8l3dRkoIdZ16kDfxguYo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqOmWhWdfg02JnmtZJjggWVmkiDo1Bu9uSGdsGZ7hWyA&oe=6A7F0221"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t_F9zYv4_K8Q7kNvwEZIoEO&_nc_oc=Ado05HjCY5w3-JXlZ-XXeXkeH8G0ERq8l1Fmu273ytQT9k2wcTzBUHjVe7njw-Xq2xA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSX9QqoCWcyCB4G99VZnDGkhx9ggwbmzGySFKGPjW2TQ&oe=6A7F1BB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FrUOEBaGsLoQ7kNvwHYNeum&_nc_oc=Adrm1oMPmsUnm3UOkxoXdkBl7gkzYGRgkS_XyXT2Ry0SCjgBfmfFflDn8RNN43mwfYM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEUQcVNlWM-5oLj0MYEX2Q20OJNHraAoTq2f8mY84tJFQ&oe=6A7F0CE4"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
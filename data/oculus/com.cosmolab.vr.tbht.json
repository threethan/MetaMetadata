/scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0PnWY1zd5oQQ7kNvwH5CQar&_nc_oc=AdqAucIf5m9kLluzCGAhqdHWuPW4wsUCkOn7GBPe5sGdRSd0B1PvL1G3l4I7FnuyLZ0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMR5xmM-q7iySwyJ2gf63T34wpWr8JErPgOoANW2x87Wg&oe=6AC3CD45"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PGcDQnOXdFcQ7kNvwEUKL2_&_nc_oc=AdrN-2M_9vKJMGgzZkGiglMNjFfvI5ehydJrTI4dkZhevBJMpVUOZ8DemEbMXjxIPAs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMy94aXV_UGY5gijE_33ERAjsiiCYWmhVtjFyjir8RXYA&oe=6AC3C70D"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dlofNU34ESYQ7kNvwFNxZNu&_nc_oc=AdqyeSIZGZEH15nTeRGU8iduige3sb9J37nPxJSxQkMPqjvBiOao0Uq6JjxV7AaAUps&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN4E4iSqVEbK5rT8KHj5pr6L7hICRaWwUOSCc4YeqyWCQ&oe=6AC3C861"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3FXTlWqa5MkQ7kNvwFgv-QW&_nc_oc=AdpkCg4EUo75xFEfyOgzu4AZ4Ol2ni0e8WkaxTCfr6LalWEHizWawvsi4556tWXYWlU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMYOUVbEnMDLroTc3Cg2W6z6W9NTS0owMvmfS8zFqopcQ&oe=6AC3A9B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CCqfhugw3-AQ7kNvwGpFDE5&_nc_oc=Adp1s8XUUT5SVKMatGCtxrEudWJD4bUxzbbBJxIn_4-ypoQl6-OP-Sy00qysWSnmn3U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNrl6aa76ke5hKWPTJ3DxRV2dIxavHWKqpxzxT-T7Z3Qw&oe=6AC3D324"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
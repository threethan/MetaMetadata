ttps://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KpKtcXuZ4c4Q7kNvwHx5NdA&_nc_oc=AdrW9EB2aKXxf9OHYRyu4dM3UZpV5quWHvrxrD9cVXvgk1coEhLlKn7kV1N_GZ4HwDs&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-JrDk2vJ6huYF0EAnI6qpl6K8RD92vWIAgLIuqIbskQ&oe=6A119A85"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YvuTSRmOt8QQ7kNvwE3Bovr&_nc_oc=AdoX1NJRLGSgRwXezZb4YCUGYfwAXFqSrT5yI6sxtyh1xq9-rrRY3JCGh2wR8VkIQA8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6cuEdixa9OfyKjdon1ur3QLtKWAY0WnkcGPjgFW9JMeA&oe=6A11CC8D"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xo2Xdtu9X-wQ7kNvwHt9Cmr&_nc_oc=AdoDws9M-d2gIwDNO2cGVXTUjnzBa_IR4M5tvaujNh_xFBYuQ3yLX6_N4Dmzwyulvso&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7jS3aCrYCQsM8dXVV-3qPa9WrBE5nAipJgFaS7U-XKSQ&oe=6A11CDE1"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h_R-Q6nWlQ0Q7kNvwFlmLur&_nc_oc=AdpRKuUCpTr9RBCqNZY-K15I_sIi93y-t03EMChPsx1pa1V00TzIj-VKr62tHl-XjIg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7LWI4faaUVEoSOPr4ENOEc7ZPOFWG05wF3AIsuju2b-g&oe=6A11AF32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EHYSoi3zI98Q7kNvwEm7hQj&_nc_oc=Adr2_ilLES1iNubbj0teJmMQ16U3lf9hUfc3B8GnrY1m_S_CXHcNaFbIkeOBdHuK12Q&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af574nEmrTPEB4DBIpF6JEI9NJzivHzSv7gG5nSpIXU7GQ&oe=6A11A064"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
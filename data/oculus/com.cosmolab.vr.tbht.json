/scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EHKwLh3ItLkQ7kNvwEUEUIh&_nc_oc=Adou9-J0VO8LVoa7-R4-rFF4DQaEZe3-mcPWI5TZZZ6rp_TcvdzLUJwjS_slZnd5GQA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2kZg7SSQaES8XTt7QVaraKCi2SxzRjX_UfgV3-Z67feQ&oe=69EB5F05"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ir735qwMw-YQ7kNvwGOn_a3&_nc_oc=AdqmNXzG6WFy8GRb1WaSOuHNbE_45vkNafZZQFgBHOgPXtWVy54riC3T6OIcF41xfw8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1A4-kzO2A7UOScT1j7f3mFDBMtD7ylynU-S9_chgrxBw&oe=69EB58CD"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1UoLj_G14-wQ7kNvwFTL7AJ&_nc_oc=AdpBeRA_Jo8XN02oZt0iXUk0ai2qgreCZ1gTPABS11NZ63wRiE9JDj_s3_dFBy9eX8c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af16Kz_DZRIHXIBe2iR9732JOBJZayBpTQzrRADNhFb7ew&oe=69EB5A21"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8hqfoF-IV1EQ7kNvwHaIodP&_nc_oc=AdqF08sVfZTGePhfdEYHawBtD5DLjZ9G6YqKB_2Bs38RTnxd2gJsgEpBnZcSv1O-zZo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1RIbmxA4n8uu5XdNO_t_yMWLmQh-hztnUt09gohmAZPA&oe=69EB73B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dofBHYzRqKUQ7kNvwGb8HZR&_nc_oc=Adow2R_WnMqMQ_ZpM4140oNbsr9SfE1mrBNF7721AVxwW0jt6VIH9d1rNcD7vS21ieM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2H0UdSG5cewJopuIyaqcv6we8LH8XIOLpa9VFGVO6h5w&oe=69EB64E4"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
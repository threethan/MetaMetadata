/scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PvGowzFqDHkQ7kNvwE-HvXr&_nc_oc=AdqR1N8N2adCQ0FGJD97W6N2M04SK9fAij8eq0R0weaylEI08rqCeWlzzApx9rhsI-k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9eIMYPXdBP8r1cyQQP7Tv_nWLKN1IZCM5GHtZHoi9K-A&oe=6A259945"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c9dY-xgPZEsQ7kNvwHAq3cN&_nc_oc=AdoW9Eu4sIhBIUC9XxP7elFfi7RMEVpRWR-7U_ooWn7PBkAlwsNB7yH3s488h6K-NGU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_r0zd4aap_KTWmbhLtaFBUflOhzZcbVflg6oFdQrK_A&oe=6A25930D"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ctn__wLAUS4Q7kNvwEGwUm3&_nc_oc=Ado1jW1jMEsMcrIekkFPo2_LaCpAr-GLmwn6vZPktaIyUf6RFaKolBesvGKYxY4BXYY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Ekic4BA1eV6qZ02zUZiKESd0kgpBjWJP_7rPeJjVGXw&oe=6A259461"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4sE7YrpotyQQ7kNvwHsJyV-&_nc_oc=AdrkBcAG9DdIP-_BlUDpeJioYbGLrDd9qVWIIzzWQmZcBcmSa71wb_4k7fbIq7ERPf8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_y0X6bKp_I_6L6i8VTN9RWg4JBohJcyng4E00DrohWFg&oe=6A2575B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MSQQ1Rr6C0IQ7kNvwFYzQtK&_nc_oc=Adri3Z084knlC0PUPFxgpc1H8Sd4pb02R_rdntWZ4qcAqF0iILNZwYW9rMpJWaNNLPw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9X1nL0vRrRh3TmbCV-Fc9u8-Ha2Tb-RJl4FKHDQbUHkw&oe=6A259F24"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
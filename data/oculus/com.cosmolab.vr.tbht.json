/scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gBdKKDbUHccQ7kNvwFPB_xc&_nc_oc=Adppj6Ot3mwoqUs56r7b65JnlVijSMuzARsUjFmjQEielzu9AOamKfWySplDrgpBdSA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6fmmQ79bWH1qyW7qN0PuXXryxGqJ_IuW7otYBHyGlKog&oe=6A0DA605"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AJINO7wrWQUQ7kNvwG56ObM&_nc_oc=Adpw2HP3CRpkQwp8WyrMZXyuIsNx6HvYGBxSDDBBH2ozurLVRsnv4th5kEEQiot_XdE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7yCNKFVsjIEjxn_8jO-0ay8U_tmA7EBzZ0iYtTL3OR5w&oe=6A0D9FCD"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XdrKBet9YgEQ7kNvwGhyDXB&_nc_oc=AdoSD0IAMJ-cYaIhy3QcSnKaKYwdbKRZAM_IQTs4gy0taduGnmjjIDuW-HETIGUQU24&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xUcKX7Xk4Bx0STIO1eqxOsxraPfNosuxbsSsGDwF-LQ&oe=6A0DA121"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AN-cu6DMO3YQ7kNvwGOXXTN&_nc_oc=Adoi_SJVIubK9QLHqn_YWcJxKoqJduDxYLuuLMp8O7KMG6cg1Unt1SvEiZ4dCzo7Ynw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af78wu68KNDVzKQe-le-fcBSfDtd6p1z2okvrDwb5mTngA&oe=6A0DBAB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ev2zLTwgploQ7kNvwHzczFh&_nc_oc=Adpn8S7VDf2XBPKpPGuWYaGg_Dd1YZXFCeWpqJZccC0LVYyO8FQ2_8tpXoMXWxGa9FU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7nYAfhdjDM_iEI_6XFHBLPJyY1Gr2Ge4VEwo4OJDJATg&oe=6A0DABE4"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
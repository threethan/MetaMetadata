: "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t1_JjXzbYBsQ7kNvwFBTC_8&_nc_oc=AdpQNPHCc4NxfOJlJ7FyJp3uwN1XbQxgISUckVqk7z0xRxDQsYazHBM1rdxtxOLl3ns&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHP8-0QJfNRMv2qUuECkFEcHIKoZgfxEN_ODPTfpJb7ZA&oe=6A8D8785"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PGiG0tY36REQ7kNvwE16knO&_nc_oc=AdrLL6zDaWz5cFnPLUYvB_yCibhZfP_cUdVfBJb-xtx8A7pmy2akPoQWn1-KPj4bMkw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFEbGmmrCPkpqf3JBe5cKNaNVCq5ctQje5TAZpHgu-fXw&oe=6A8D814D"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=43PGPNkpVBkQ7kNvwEvoDuH&_nc_oc=AdrBLeTIumQz3JiwBCH28YleNyqNCUmzmePpAJMSwZPAehVCALp_pnFjzyOVAvym7bg&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHuNaE-1iBuQccgoSlzbRQe3J7HVF8HHbQuS-4asxqIsA&oe=6A8D82A1"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lmN9LFtc_fYQ7kNvwE9nUKo&_nc_oc=Adqhjs4j4LDHRK30S-lrNxIJt7ZvWx9FdJ3Qc7bh_bw7lWTFbtCPk3aCnE-lxUpUyWI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEcUUY2amMP27j4maAsyTy3JqO7ti3ZetdFV2CghnM6tw&oe=6A8D9C32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QlPR8AWnX-UQ7kNvwGZJ243&_nc_oc=AdqOW4Y8A1B9GLQnJgvLDVRNormj8ejPd3X5l1PmMyoGslV5xFCUTZH3TWqBa7gSZkY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFPAJ1U1viadqcAl1vW9ggcOJtna40oTb3I-UzDSoGqnw&oe=6A8D8D64"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_
/scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aepXW1XrpM4Q7kNvwHoF9fI&_nc_oc=AdonGEO8IFXWwrFXCV3YwJ_lmvDsTm2DmqX6QI1kPj2OhcofR9x_zVO6AbGM6NG6Ddg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKiI2Da-RWaLPfWuDX3RflVrdvmbaX6bet4LnRY5VVPzQ&oe=6AABDA05"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y4-LKE4Oi3YQ7kNvwHn2b59&_nc_oc=AdqujLolqYj-W7S--Cp1d1jXFM9a8orrcGoRa0hRKR35O4pAOWYDk0i25u1mLdXrVZQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSzMrF27kHMMDZVmb3R5VRyvjc8tW-ZhAc-yZJmkH-3Q&oe=6AAC0C0D"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SmMrA2YgR8oQ7kNvwEruPoF&_nc_oc=Adr93ik93zENxjZ5gaqz1A61MXbIHg9GDlM0v-VdxC4G2kbOA85nyOqFYemZm0wsKXg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3IXEvvuqkd6UjQHOhxOmtiyj_CdsFlXdzqFHSPFLRKw&oe=6AAC0D61"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ykCOKKGGimkQ7kNvwFcZsq7&_nc_oc=Adpxo4k76TC8pvEqgMbsWloyRx3NQ-rLFh5-Xgg_bb05yVjbbNxl5fJ_EEk7VUEEwRI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5-gWc4dpqqvoReBFwKfdUOLjZnfiaVxR_TRhEeAGoSg&oe=6AABEEB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IUSyI36L_hgQ7kNvwG9SZb8&_nc_oc=Ado-q1Fei_y7m_UJQojZb9Yp_GPLyRggrEqsMYoY5Q8XJNwJzsNqm8hNIoAOmpJPVvU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJFkr_xyLghWy5o_Yx2Wr3jzr6qtPsK4M5WvprfQ5VbKg&oe=6AABDFE4"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
/scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ymt1uUz5LCoQ7kNvwGgHw1x&_nc_oc=AdrfiZTclk7H1sqVWVMEbw9gxEnP-J7ou3W8Y0JZ8z3DvZcBt3i5wdZO1tsWlxnpW_s&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmnoAW4tHyy3JYQ7y3suOClNuZu8LulXAtrNrMsa8beg&oe=6AECABC5"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b5f7Quk2RHQQ7kNvwGOYYPi&_nc_oc=AdqNM_8NnWTMPzRKcZ2xqMRp-Eg9APeDph_mWFOy0Eo5cklxu1JpPgQuWWCuzmENCsI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvyL7cCFfJqLU9WCaAsCbBfFHrc5B87BKlXxspkLZtCA&oe=6AECA58D"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2lSheXIw6lsQ7kNvwGB5-m5&_nc_oc=AdosxV0IICzopA1H4wJLgSz-u37quY2zSKbsmm6puU-kZfTCtA1m2ISmxywZ_lh7YI0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKvztyM_Nzga7gqDZqE7A6jWDqz-PRoXRMPiRILp0Nmg&oe=6AECA6E1"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xPBiNWjGooAQ7kNvwEYHOjb&_nc_oc=Adqz4iHg80MXEoj3aID33e1oCIubYDTh-3s2NX8aI4ExXrJ-ko6UqrRooClh1rU46Ds&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1Mh1q8mbUWwdWp33sG9xsYiquHjbFL6eXJCMUZsMIHg&oe=6AEC8832"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1UKniRrl6EkQ7kNvwFa_Qjf&_nc_oc=Adq2lSVZU95ZLIfn-LnEJ3flQD8q2CcjBiy8tEWoxQTKblJ_haai70pmPc6yL-a0AJo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTT_VZMnAHVSO70xi8R2YeMJwNVIQ0OqrVv1MJgY93VyQ&oe=6AECB1A4"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
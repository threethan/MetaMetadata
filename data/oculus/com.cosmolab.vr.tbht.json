/scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ObgYtPOj1QsQ7kNvwHeyuwx&_nc_oc=AdpyGtLrbcdjXgHjFbo6T_4UzMVx1lhUrCVMoYD9GYoroovilZgZZ-fjH-EOIdkf3vE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNG0gFcNIGocnJBRj_oXtTP2NgNjvpm9_j3vxzQheZ45w&oe=6ACE5945"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BonOtFyQmrUQ7kNvwH1neLE&_nc_oc=AdqryvwoWWSfNPauABWHJHE0QH2bZT9OsCUd9ucZvrKZfTaF24dSXr57XaVKq49HZjA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPAbMZqjOBVtUYRTiQyF2pH52wfZwXz5bLXepK7DO2Hkw&oe=6ACE530D"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8BrobMH8YNwQ7kNvwFpASdf&_nc_oc=AdqtcqiPCDGoeikXb3k0XseuduhN6oFCSLAGLvy6PiylRfSJ1XmPKqkXTi-2ni2hGHQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMS2B5gE6KxGgF-R2h1v-xZq5snNBvVC8i-gptVZQWxxA&oe=6ACE5461"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zO9Tw7cyEsAQ7kNvwEp-dn0&_nc_oc=AdqcTaIbZC5h_KvZLBEU2v3lmIaybpwgI_Q_sLaxSEi6KFMFzk7K5WOWhR8GjBBA8bw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOLg7vFmHc1xkmfbsAZYlJ2yddOG-_3SAGmeXFfUG3jVw&oe=6ACE35B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rTe_w52WC5gQ7kNvwE7OmJ-&_nc_oc=AdoaUgMZ5ChpFQMTgiPLeSaZ8h0aVshIAGo1_5w2Kyxo0FAweKGUaj8H7OhlTXU5Zjg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPL9_Yrkt0N0TfKxcQMm_9uJ7gn_maBT6AOysb1UEvS3A&oe=6ACE5F24"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
ttps://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uSmimutIC8sQ7kNvwGwGnkG&_nc_oc=Adq_aAYZzV3xnF0vNMsTWgZZ6yZmUmfzDxf7DdWBRdfN4Gwpg2QOE4fgtsAqpCO1YHw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKyW6589mALeWKtxwPTwn14Wr57Y0VdC0cvc7k5HEcWRA&oe=6AA93705"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jYqLOezLgWMQ7kNvwEEOfHj&_nc_oc=AdrrYQVnYCUb_AKNhFDuhq5Fc85OERZ9LbvA6gbLmut5gl-nunHnklrMRHliznpKEWY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBefQv9c8z1VcT5qiNB1Skz5mDy95iGt7_Y-8-4hsZAg&oe=6AA9690D"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SmMrA2YgR8oQ7kNvwGRhL14&_nc_oc=Adq8vdbDliVcmA8ADI0f0AFzcVWn9uRGKZRB3Y1LGVs7CPslcikBTZEvm5o0Ae_1qSI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKoaMEFlBVzDncCekHpRarULzGgsGTjMpltS_MBu788ZA&oe=6AA96A61"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TNhsUGrAPWoQ7kNvwF0mkPi&_nc_oc=Adol50h51fjOeAO2B5PTH93vHTYm0MO59Mj5a7zRS5JlcpoOPneajS_pxdrCJRJSGYA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ03QrToLVecuNTvmsOaX8_0Mz-jaAmA7UFyQuY0gVlaw&oe=6AA94BB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RM7v5-XqTaYQ7kNvwHOW2mU&_nc_oc=AdpAwSr2CIOnBc8kzv1E2-u7iODjEE2n90HbWoFnYK4Po-XFF2ele1SlxbH2aucA20A&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJL8nRm5fFan_YfJl-Q2Q2FF8DlIGaNFLqaxEsj9STPOA&oe=6AA93CE4"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
/scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nbqAExht9wUQ7kNvwHx3uKi&_nc_oc=AdoWNrY98tLp6zeNZD2RuYsOemhScb3-P3gV3CyhCIAU5gSD1AEjgwQtH1DkWSqaVz8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-IAHhLL5ERm2siY4Z30DECrbD5fQYA69YtqDkPk2Y2sw&oe=6A43EBC5"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tL0zl-kzM0UQ7kNvwGfB1Rm&_nc_oc=AdqxbSOoC3JZchQvFsBdbXmhV_ANH5-SBH3MOWNVd47z33SZ1YgcRQHbq0hHDbRrDB0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_EhyfxyTxxtDKLfDw1QfQ1NrMfvMj_vqdaNfwzKcQN9A&oe=6A43E58D"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rbz0odoM7UkQ7kNvwE7ypm6&_nc_oc=Adqy6_bQPqnF2nmQxIdNhQjfRAjvfZgUH_iXyjyNxY0b1sCjzEYlpBaig3LR8k-1GKE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9iNKq6BCA0GGa389kMfp_WJQVwLTTs1_jN34eIgAeFJQ&oe=6A43E6E1"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SJ6nrBqj-OYQ7kNvwE61v7O&_nc_oc=AdrxHcw1eBnUdJulReAwXGOK4KTe3UpJpq1NhvSIp5oQ93oBEh7yCIrjnlKJQrkTE7E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9rPfsDOtDRT2emIWC8B1980xNUrUVRfNfIh-kIpUczAw&oe=6A43C832"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=06JL84nV5SkQ7kNvwFpe9o5&_nc_oc=AdogmbHKtc10DloMQBT9JL6U85eNsbDlqGoDH1YyyuBNoyE0vN5yzoKSRNTPgpyraqc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8yBWTkDYOnv0UPqGCiqVKL4hVcQ99v52PmT2CA-abYtA&oe=6A43B964"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
/scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LqUcQ3olQJgQ7kNvwHRMPOX&_nc_oc=Adp8dZN08eVM5Ad_tD7UqG3jwYmsb--YGNa4_8CXgFCflasJ-76odIHhZ5PC7LcXgEE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6nYkrxvy1gmBIyDfNoblCDmb3KmMacVoE4BoiltqsjFw&oe=69FB3105"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XgoOLlbRcvwQ7kNvwF1JM5J&_nc_oc=Adp_McZ4yKWkkQL_aVhzleNPUsvMJVA1mOfKVwpCeYc3-dMba7dYrjT9A8hazFqhxEM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7AjjQkp0vC3B5aOCRx0bC2OdNBQ2HZO1PDjRQUZVn6ng&oe=69FB2ACD"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A06Eu3PP7-0Q7kNvwG6pfub&_nc_oc=AdoHZ3a4MRymydfsT8sNOE3osNC59xWfiW8Rfit7qPsd27fn1mpd2npDKgjpWrTdRi8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Fa5DwQx445IkpMzmtLkJN-oS3bNZMtuJxyVeW97J1Pg&oe=69FB2C21"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TBB5ZZExxlYQ7kNvwHUNzs2&_nc_oc=AdqhljkLA2fbaWWyI6ZiXIYTKLRG-OxxRndbi3bXEVFcV0F0v9tcGvc0S0sC5zFWCe8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4bqm82-NgQvX8f-rMig5Wm3ZgdjUj2LQoj1Js51Kl_vg&oe=69FB45B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r6maj6pDRO4Q7kNvwEEpkX9&_nc_oc=AdquIlpCQnxZM7TLLgFw4h5LGjkrbc6hfCvc78y1njLhMJnim2k3zk6Y_-qyOPDwJCk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af45swdOPgTAeR1dh1cdzAW_nEouUJ7zrYXSWp__ZSwANQ&oe=69FB36E4"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
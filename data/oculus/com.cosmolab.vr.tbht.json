/scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VqypSIUtcbwQ7kNvwHUYMKF&_nc_oc=Adr8hZ1aU8mhNt6reRt3ttJgOnnfADz5KUXXkuEyYOdTcKQZQu8jFSZ0kf8q5FU30BE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmZrvZjm0fFCkWY8oOdwtjN9tXoBrHzKlbuzVyMeY_vA&oe=6AB90905"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iuhz1iKgIroQ7kNvwFi668l&_nc_oc=Adqw0BkPcvoFlUhjvCY9UMhKdxk11nqQFRHe6rdJEn_7qcMIKej-oxAK_h-Z_ZQknI0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3XwflsdKsLaJPbOSl0AEg4l5vln_jIwLRtWCaYwp05g&oe=6AB93B0D"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jd52XvZwzrwQ7kNvwGzUKGc&_nc_oc=Ado9q9wSe3ur3L52unGK3x7gbi7YIOkEMNJYvilVRkOmhd9-bpeKnY4AQucEoRG4Q7w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKj05kbF9ZLkLf5loeI5zABcVaDHJbKPeOezSxE0Ocpbg&oe=6AB93C61"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pE_lpKt20QQQ7kNvwHFmH9-&_nc_oc=AdpnXposgGB7SGf9GcnikedRXtELblylkY9fyURMUu2_5LEtvfUGNujYxDKh5ogmLCI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQISOrbwQq0lJrdjxMEDIzxW4wGrGfOlw5y21Xdecmbuag&oe=6AB91DB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a3lmONseIi0Q7kNvwF92RTm&_nc_oc=AdoCHF5aKQ3lYHwPwlxqTJdLZI4ZC1Mr2ZS9SMTxTY94l4wmEVSivvxc7PKa8AXhhJs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpkVHwIsiY2IpiGBG92gU9d-qEvqNXlhXeiLIhZiCFdg&oe=6AB90EE4"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
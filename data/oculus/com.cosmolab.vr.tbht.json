/scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ip7wfHPnJYAQ7kNvwHO840j&_nc_oc=AdqT1GuL9O5wK9kpJj5nige6IOmWAw7pOV0dCL0V6sWVJSvsEvGycyxz36bln-2uPXc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIRdGTNgJNBCw42PLowr-1CicPwZ5TaWKexBhDayHCrFQ&oe=6AA54285"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Qf2qTcWoo0Q7kNvwF9zzgd&_nc_oc=Adq_wfq33Ho2vZ8cJRLb_AQ7ojIGNfxWjP5srwgV2YST4wSVMeZNZrgmnh-z1mlpWvk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9-h4wIesj0p2Q9boEAJN8D1F1uEG3n9W2BXR6-k6rZg&oe=6AA5748D"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LNI-UZ3TOfcQ7kNvwEZH4zg&_nc_oc=AdqxuPNmaOkGJpnNJ1peE_qooQf_a_j0WS4HtLECXJGReoi5HOWk6ThxsGPfkBbysUE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSPbkrrIu0KXnKokB1vCcS3M5uldV3atKEUpsQmRQxMQ&oe=6AA575E1"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=85rXfsnm0nUQ7kNvwFD42TR&_nc_oc=AdoWnfJURpCGqEZahH0yPSrmEGrYmcU09qN3WJpPHif1CSnHwp9qqC0hkEFrJMi-t00&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBZDNUu52WHAFFRYsvwBc_rzX1P9scE6GxizGCedZsLA&oe=6AA55732"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4vB_34CroLkQ7kNvwHs8pWz&_nc_oc=Adouto1PPDez9d-C5LHiUdBFJZ4P9TzngLj0yEtyUP0k76HDmTNb1VOK9Bi_fqeIiY8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLtkOQlvgxTOnFVn4rmeKE1I639Z5hgbitJin31BDA6VQ&oe=6AA54864"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
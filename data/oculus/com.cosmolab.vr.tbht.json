/scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4nlcTT7LPJcQ7kNvwHi3maj&_nc_oc=AdqdRIQd_VEzss6KrKL7l7ZDa7RuTS073sht7IYzIdk0vV2qtcFGqr8m5lr_Nr7a8hs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC9kwFvfkw0DcpHQq_BMT9zZMcsKeBhOHvHajb-DZ8oVA&oe=6A674C05"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XM6qLxtRnf4Q7kNvwE7qWhp&_nc_oc=AdrowRdXkPIRVOVUK6DtkkgHynu_xetsCgXILBg_eJrPBTfA2P_CnkV1MSuLG0nUmxA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmjWDNmFEgDQG3YP6mG8GxSW2GPKV2KFAodOz7aABtJA&oe=6A6745CD"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yxblx2VjrgYQ7kNvwHypRB_&_nc_oc=AdoZ3C0jESFUzMgOyyEhnBf19qwSTdmi0b_AH3cK91pSe-fq49CU5_64fi3IsSe71-o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDmXN0Zdp-NGC8ob3yeIW5sA2kH_7UmqU5tSjsaMr-HDg&oe=6A674721"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jtnd06cSJ0wQ7kNvwE3xezg&_nc_oc=AdqWZ5yUrmfmF3TDbbz7D9EkkA94Ti6juF7P5rzKkGYKa0uiKUfKfOq6BYLBQeYasvo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZFZdU6Cn6W_SdyyIgKGVMO4KEhTRBsRXYXfABy8DkrA&oe=6A6760B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SsviN1bBy0AQ7kNvwFsjNze&_nc_oc=Ado-sYKcnioYGqk-CMW2cjpFGRBlC9B1LfoHvR3ANKWicPXJw09MumLAzYU6tSp0nsA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCGsvvRqitfgUkVeLguK0vTIvgv4rKU2mppMj-r3t_NQQ&oe=6A6751E4"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
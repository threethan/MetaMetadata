/scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iSk_SNcnSk8Q7kNvwECSHzr&_nc_oc=Adr2T_pC0-f2Fqpof7ma9aYcoJeRlx5GvbBw_VmV0h24KI0uce_EBv8w9umPZfndbCI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6nSNSiKbuCSWCHBzFXV9sjbM8VOA9AhR9yrYqDeX5NQw&oe=6A046B85"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OEkkbAqoUo0Q7kNvwFQDivL&_nc_oc=AdoxQYQ68VswN1JLnHsBcLZeo1YtFSVqpYEu16obfKkbYKkOY8YXnarUCSTDQDkik7k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6EwgFmUIhiL12Vmc84IZG8qJ3NgkZwUQw75lvgAW57RA&oe=6A04654D"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FdnjmddmrzUQ7kNvwEuQozy&_nc_oc=AdpYmuZceH4AOOoM71A3oVMRAq4qdddQdpb699dbW8aN_w5IAXwoCQW-7V_guyazLh8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_UOh-Zg1ra3VENiT6IfSIEtHKNTY--Rk0vCR_XulCTA&oe=6A0466A1"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c6C3yqTTF-4Q7kNvwG5PLBe&_nc_oc=AdqnKSldIoOo9cO5sNA2QsOn773LfZPNwU94lkN-eXpWqs_8YOFjBOH8f3sG6zvCBJ0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5hEgOGE7uGwI8UwOpTussy2lpnQ-fHN5gazxa-FO9MIQ&oe=6A048032"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UhsB6DveA8IQ7kNvwGbtWae&_nc_oc=Adr9ppl3K99P_sq1hMTYqYpv-Xnc_i6UonviFyihaoHI_Xw7-tPaWC47NSJ0i0ap3hY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ZYmANBFj_e4BLJRiFlthTwZ-kvRKCDgT4QV0yhnxf6Q&oe=6A047164"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
wFZb2XJ&_nc_oc=AdmUHO9evBH5JF2AFilAP_psaLmscPt0mPKciclzAV61QJCBywulTM4U8q22FQvyyy4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvRREinhMKO4TgK2-5goszPoXFsgDuLMJBq204pt7nGvw&oe=699C4505"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e8Q2hD5fKJkQ7kNvwGJ8O07&_nc_oc=Adk1_7LfQEGNxxq7Z1-pt30k6pycJUBV7GDY-UlLP89el2tQCiJ2qNeuoLXvw0oxb_Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftAsOes--iBb_jd_DmQVVoVSvMGSpxLSF8ze5zcLKSGvg&oe=699C3ECD"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p4-5W5kpPbEQ7kNvwGZ3AFP&_nc_oc=AdkjDQScM6wA5YA7GhgTb4awkLZ2U1wFPfF4Wh9EuIBpXm0BcnEJTCPK7izwAFQPzi0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afueq67E0SKt7k8sEocV2ssHyEZqVvipLm213KZGFZZfsA&oe=699C4021"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cKF_z7EOQa4Q7kNvwE0Wed6&_nc_oc=AdnBR9VmNAjgNX1bI3dmXuSBf6gzf8IpyUBIwim-kgtRwfiKomMx-r-VQ71hpufShDo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftJ4dR1d0TvsNdIkWuArkSZsKqZgMVhSspwLtnrveQjVw&oe=699C59B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AFE_Hf2hDPcQ7kNvwG2WY-2&_nc_oc=AdkR0hvnyZsGUlugpYUB3-Ibd3y-qqK3xExCz-eEqjOQi9MR09B2tqysIubFxuCkYJA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfveSfKRdE0iu9o27x6yw74YJY-T2VmADEHjDr2cBHns7w&oe=699C4AE4"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices":
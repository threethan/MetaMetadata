/scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hst8V21Nsy0Q7kNvwGi6cSB&_nc_oc=AdplkYyMfR2U5LHu1V1VpWswk-Kb4S7eTKa-f43r9KBarUv7C44YrH_aHn0zM-94jwE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDL8aLdO4-hqCnbw5y12iJsl14FYttbUGBiMheabo43VQ&oe=6A562885"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b54Ktua2_dcQ7kNvwFrV722&_nc_oc=AdpUv_DODHyjx46VzlW_4GiAeK11_jlEbeC0f3kohxFc3ImCuqF_pQL9SGAGdvpRk2I&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAlnKSkE-WW4Js087B4uRavfk-rrgl5ruGsU1TCzjLpDg&oe=6A56224D"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HjjB7IehshIQ7kNvwH8U9em&_nc_oc=Adr8Wl9c1666KXaTEHcOiIbWYUOrPFPbANwyI1z8xKSrXnNwBlhShWDPiknXT2oosBI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBQI9SRXWvV_sFxQ2ZVjNvhHGmMgTgI4RkfEMTdmTCfMQ&oe=6A5623A1"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DaKOm_p47cIQ7kNvwHIzx1C&_nc_oc=AdofFWo344D6dY-j_0_TDCCnN_iQ6ga4AR5BbZtK64lQqKxO6pPBthRBq2FIG1cDbLk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUCFsYPrTo7DKWOq_SVFVulSOoSXu_sO0eIycH4ki8sQ&oe=6A563D32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=La8SuwuKpNoQ7kNvwHjf0k6&_nc_oc=AdqwnjnkgPuGY_pkdWfIQAogRnT8r9f20KS5Z22Gs7WR369kz5GKvPPRldR28ezEhDU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB17j-IG6Ra11_ZbysYTijxOjvJ6_mDLQkYeCJovc7rQg&oe=6A562E64"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
/scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Mpi9otUmRUQ7kNvwGVVVEU&_nc_oc=Adqh2E4JqvId8oo3TxDvj_dTRojB3LpoU4ibnuuWLLvmt5NVQZByLsasPWDAkKQqtBs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLC_OqVYZNY1YSB54pTcrpoj1ihPfVMe1Y8HrmLb7rx6g&oe=6A9FFC85"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1SOODQ_OjIcQ7kNvwECnDNo&_nc_oc=Adrd0F5aLqu490B0Lm0otqLgUXasjIAHVdcq41kcf4lqbPPwrHT7cMHmFSJ6p0Fd1bk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVoLmt8HxjbkUAzpLztYGX0f20U5YWwAryDT6l5fqdpA&oe=6AA02E8D"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UN7oSAF5VyAQ7kNvwH6cBHH&_nc_oc=AdpY83rs-gjvuKoUdk7Fmi_8YTtaxivzJ5cBLezGOADMHnQOaGaIMDmbZq5zIfegXJE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJsJO1WYCpbN5a1_8tiQKZ1sUMr4w6SfU8gr3-ObjWiKw&oe=6AA02FE1"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ySldolLOBR8Q7kNvwGY0fTt&_nc_oc=AdpL5Ly9OmUHsFmsPt6MxEgh_s2qu3JSY7SyEu_VVnjIXGn0InJ5GI6mkD-LTQ9vpVw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIH4fGMExhZR2dVbvdMP-u-2SpINZFb0UyLUE4xJo5Ew&oe=6AA01132"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X-QGZqkvFEEQ7kNvwH2y9fn&_nc_oc=AdoV3mv1iwBk9VrtJJ6iDOkwjdatQIQ_tRo_3SPxBNCleTjXm0VbV6qyF9mrfHuN7XI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKel6LuMIAtrD7-uiIy_AtY6BJ5XySwWNjqy-ua7FB89w&oe=6AA00264"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
/scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UcPECd0KhCEQ7kNvwGmq68G&_nc_oc=AdpsZdR03gMqGop_lgr_lRuFEPRJQGmo3pwEx4VpiebthK4skAudxFlleCVN9w4P_xI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Iz5CAgN9tzZ1kONQh2pZ-eRRleqmYGoV5t__sl8_kqQ&oe=6A302545"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CC72_d-VdD4Q7kNvwHbkcYY&_nc_oc=AdpFlrF1dZqQF8ExCME8_mbacjZtytXLLTkp5v-THCNxcuJiU13Fi-AFphSREWZEtN8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_C4jzq89Oa7h8ifubslGYGQeybQyA0F3ra27g7GIiHOw&oe=6A301F0D"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HgCoIHpeogAQ7kNvwHr7M4q&_nc_oc=Adq1usiB0V17snZz6KtnxRoc_9m3VtBzq3lXEXyYNb7TigmChTgFAr1u8ikpyHWw7H8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9GROxeXlgLyZFiHaNO-QNOpHyx8J1DSFBD0Mzi-aEPbg&oe=6A302061"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HkUL5D8ym7gQ7kNvwFis4v7&_nc_oc=AdoJ0KLWuFZ3Dw4bLNWw261KGUFCru4SED_s7wZCW6E59TW1jzsRfyfthufw_v_yzkY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_xmVStIlJOmkTKrreesWEGblB_VpowUiR2tGOUCABLkQ&oe=6A3001B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ve_ci7JB340Q7kNvwGmerLO&_nc_oc=AdqwOVuNCBB4OajYxNnrc5-4kHvPDhfZQKNRjdXwygpBLkdxOcHkSqDOOErZhVQ2v8A&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-KKB9JesfeY4QqNQmt9w5goLZ20MsBSs5lSClRNo1HA&oe=6A2FF2E4"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
wGwIpIQ&_nc_oc=AdmlBF654aBh1Xc7qjn_UqJgeCijgzNhm9QaPzp3g0-5G4AniTblrRRoygXbWWv2fOI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvE9FkayD51N_cugKYFvJdhZvh6NW6s1TEgiWn1jMQeGg&oe=699D9685"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e8Q2hD5fKJkQ7kNvwGdBqFr&_nc_oc=Adk2ANHhaS6cDU-9fls-JXdm9pNt5LJ94a0yQ9fcLcac2pON0aI08KyUWM0qxdlzMY0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvsgCY-zK97p67U0eRtw9LXwny3bw7LYQhNQM6Mzz5DhA&oe=699D904D"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p4-5W5kpPbEQ7kNvwEwitoi&_nc_oc=AdnvSsBUFJB6NFMV7bwN7agKqjfWLtVPQoke1CPCBu6tBh1RaGq8KbUXH_q6RH9qFRc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuQMsuav6zLMxa97AHJqmS7AgcXPwlq0zj1DQSjs-xWwQ&oe=699D91A1"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cKF_z7EOQa4Q7kNvwHJ9rmq&_nc_oc=AdllIV6PmqcjYffZx4PFgpjoAFzhX31SFGdURdyeqsyu5vtqdrs0cB5lqLd-t8NPszU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsdAqfAJT1md8fVCleMEhafiYnwkqmYCrBoWLW_KHErAw&oe=699DAB32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AFE_Hf2hDPcQ7kNvwGLGJqY&_nc_oc=Adm38sDUcRKsnxprfPUt5570KdcxVWSZQN46rSc6OOA2VUDBWAcrn0ofb0MnM7GsO10&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afts3v8e5hsehT8aM7_55_YEASrzOg1PyE1ZPh22p2JFEQ&oe=699D9C64"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices":
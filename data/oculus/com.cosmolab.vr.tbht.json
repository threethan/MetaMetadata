wFIsOrM&_nc_oc=AdlSR5EKXTO2w-BqEfoayaJL6wXmFI7khsyos7vnOExFHwayzIpbZ0dYTSVCMJSSziM&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Aft2uRX5Wk0SJ4P_3XY6iKIWjC1Tm2fkcJnLXUBh-eKUhQ&oe=69A18B05"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oRPraitNXhwQ7kNvwGTZ-ri&_nc_oc=Adnr-JwlcwdWYeysLz5OIFwegTGbf6vmuWAlGeXoDV42mOipwc0s6OvsMH0yJzubwNE&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfsJIR2mB4-7pbquh_LXZhvKktOzT_Mu3Eth-1bPKQkR1A&oe=69A184CD"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g1tSHHB8FGIQ7kNvwEsnmIw&_nc_oc=Adnb1ZOccfi4nFfNGklb2D6qCOeh4jkDeYqv0o3zKdW9akdTp1AO5uJ3cMPkRTwtldY&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Afs9YgZ7M_bOf8lBseiUFXXmHKNJVD0h8elfiw17Yrlh3Q&oe=69A18621"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1qcngm_25NQQ7kNvwF6ZlIb&_nc_oc=AdlaHPnfmWguhXfSVyiWg_mLZv8BROUx_DxWLNTjzxZud3C0NTIOwYo3Umc-YryfTYo&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Aft7n-e7GqJItokzMcS1VIcWcGuE1_vd1rTpheDG-WRcjw&oe=69A19FB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u5Vy1j8V2J4Q7kNvwF58V7v&_nc_oc=AdlL3C-90NZCuBQCj63nkdSF1O4AVlYAMBxhWMq73RezoqInonMPgFR89E_0yBpL8LY&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfsUnzz0_0vWPjn4xPRE8bCqby9zEMyvGRJjplep9VfQEw&oe=69A190E4"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices":
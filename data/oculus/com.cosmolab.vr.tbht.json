/scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gBdKKDbUHccQ7kNvwGK3_wH&_nc_oc=Adr7B5zssb6bREgVDREkvXXk2DHWuExSoBq4leQbW-tqwUfbsKdHvUig4KS6O43AUK0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7T2Q1DCMOf3q5wiMwXGFjKQ9nrdpiN-Vcf4JQOIK-siA&oe=6A0EF785"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AJINO7wrWQUQ7kNvwGf6Htz&_nc_oc=AdrmAJz5-ehoQO3_4Wav0oLS7t7R3SIfdhC3RuMByEKIK3mdcTlqwLPS1_gyEOZTb98&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af52lI7YolsUXv7XXVCg1QRCnq5T4Kv-JodruPbcM7Yxig&oe=6A0F298D"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xo2Xdtu9X-wQ7kNvwFVK2uf&_nc_oc=AdoSrnNtORS39C906e7TYDF8XeUovLW1bVvjdPbe9VZgHZtJ38jLujEkUDbhVe1S9ns&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6SohQt0YHiYCbT9i0ijUNZq550MkXMCC0TykfebbZiwg&oe=6A0F2AE1"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AN-cu6DMO3YQ7kNvwG8xA98&_nc_oc=AdrhsbwRRjak0M-LvaQqPK_orw2zWxNw_fbEtSxBtt6IB4c40eKE4WDcqsD4auTVFrc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5limi3zQpH4l_DdihCFIvRFIv-82PEOsey-sjUt-8U6Q&oe=6A0F0C32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ev2zLTwgploQ7kNvwEt5BAw&_nc_oc=AdqDCedD1bKHloeJOkUOCwdkGe_VYUvK3P4FMZctwltILr7u8Dvn8l5opBtw1Mg19Wg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-xL5Nn_JuCswr43rAxXRqPy1n9EzgqXpNNfEb97frvQ&oe=6A0EFD64"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
/scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b18tRkT2sIEQ7kNvwEc-ZyN&_nc_oc=Adrzn8XELHvvH6RtwiAaQhK8dDnXCJzyOHM5fxH-mUck7RgwsRcVcPEME5reccgutIY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af19SNDmXH_25jVEkSeoqGaZnJdlQe_PFGmlvhaxZrljrw&oe=69E0D305"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4zGPEvYk104Q7kNvwH8GOOv&_nc_oc=Ado18CSYGfAwTLhkAedMceZVR8nPzdO9WIrGeRxSMMgbuvJ7nGiKmqU55828VbkjB6w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2aNDiu-nNprOu4AylpXvhVG3ls1wJxZoB0Wlv_MWMvsQ&oe=69E0CCCD"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eo1mCxgCK24Q7kNvwHkJAmT&_nc_oc=AdpBPAMYxVRoZhEUXF1W65zPVISccJ3DT26xobglFTKVYu7sdEj_ZwUH_kMwLkDTQ54&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3oYHCZexQ9MJmz192eMF23OrUMoYx4_3TKMW0KCttS-Q&oe=69E0CE21"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1MROwZZuZH4Q7kNvwFlN0aK&_nc_oc=Adoo09_NFd8H-ZCa8W2ibqLztIcGzrDexwHbj_zbqiOuCj5nZE_4TXRg60U5j3Qhz0I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3RzerBw6UvvHAL8xjtuEhfyKYGnbwMN7mIhbP5IZZ7WQ&oe=69E0E7B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Q3XTFk5mi8Q7kNvwHJ4MBJ&_nc_oc=AdqGKYxzR92_TUWvvGSPdYA7UsSBHUojSy9vNwskxZ-M0uZcy3PhmLIZC_DK2CLhMns&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2foEWKj0uK-DWqIJfULddCvWcPO69SJCH3X0G3Bcwl0g&oe=69E0D8E4"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
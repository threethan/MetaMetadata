ttps://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SHyrzzhxnd4Q7kNvwFtAH3j&_nc_oc=Adqt34Bz5zvy2qazdxhPaILIcwC2GLNTc7Ph8zl60oR-jbwV6l_DnQttbNYTxAnNFsk&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af946px-iEOhGmCnIpcfuTkdF7L0eP5dg1IALt7mMYyU9g&oe=6A22F645"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cX4XbN_otm4Q7kNvwFb4Wot&_nc_oc=Adruqb8RQ_01F0kHz9cSUvqzT2YK8KHTKHiQQFQrrOe5vyArimwJgINW1fNO-8QJnMk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-knuGC9ayeQMcUGoT9EVjAlBq0MlOZITCw2LmWlKATHg&oe=6A22F00D"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ctn__wLAUS4Q7kNvwESZpfU&_nc_oc=AdrNRmUzmuNrkRdg5AE_49va7t7-ZDUw5vhv7Prh5Z_3eMjhLslEJ0szeFzEmO18lZQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83Aq5DwTcKUgIS5I7Ll5_Pqf63Ro8vB3ABnjx2HTQjpQ&oe=6A22F161"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_QJUSqBF6noQ7kNvwF_tST6&_nc_oc=Adq_J9ouicbFMxE59zPCYYwdr8UfHQGSVrhdhfsP7qfi4W0IfMT9uyS1iQ8LRpgFtbA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9rml0ZhDQG8a-s1nIu2K7tO0YXtg3T-uosjLpPAo-jlg&oe=6A22D2B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2YUX0HN7lA4Q7kNvwFjeofs&_nc_oc=AdpB_5TPlE8zC22ph6f-NUEdCcpIQxTxnuSjGHZyQFBzo-otMgv85rNBxrmyCO_bwsc&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-vJeLncx3Q-OCFKwKrS4nuVuW-XawbJ-QosIsSzO4hdw&oe=6A22FC24"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
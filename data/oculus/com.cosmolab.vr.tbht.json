/scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1JlccdsYR58Q7kNvwGF1nqI&_nc_oc=Adpku9QVBF_iKVD1ni1uFnr-gegoKuzm8QpS2HH9jas1QKRcNmkIC5OEe5tRqUviL9c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ilk9-jszBBFVjUTvHCpJzN9pdPp370WTGqf3ie_E_vg&oe=6A070E85"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NkIaMAK1L9oQ7kNvwGWUQSF&_nc_oc=AdpaJH8wXdMptzHmVoepw4JNju5JBzR9tAb0FO9CVHaBZfgWUPUOrvIGmuUZIBrZWWM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4SBMtOHKzlbJ3gV-DE1Y8v-sXtQvWdT67QttRl3aPTag&oe=6A07408D"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uJfwN0THQ28Q7kNvwHTJQCa&_nc_oc=AdoQawKlzfed-WAwY2L0-Yn-QkAcbkSgsNDIEd5j-KNXHwFchd4eoIWrIJMa4KNUB8U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af41x0o2Mi2mWT6wCcIVUNjAmqUky6aMbhd2o-1CIx93lw&oe=6A0741E1"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zdTJsFWUNDQQ7kNvwG0q8Fh&_nc_oc=AdqXS6HqOjVXsfy88_iqqDAUL55cpfi-Qs1h71xeVv24ojRCNaz6KCfYn2B3WdAyVNc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Wg9TX8-laJN1lCdcPUy8jqaUT_XfxL-y4-wWX0TkYZA&oe=6A072332"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V4xgwaqFPOAQ7kNvwGm8dft&_nc_oc=AdrXs-nP_ulJdXl2HubOtFU5srZzv6lqh3az-zdu7HixqxaVju65g2Zg6MuRPW6jGuY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Cwut5fAiH69cVsltm6SWprre6UdrLkHgCNBfm2weSIw&oe=6A071464"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
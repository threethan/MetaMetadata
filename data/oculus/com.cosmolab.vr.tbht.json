: "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t1_JjXzbYBsQ7kNvwHQCeSl&_nc_oc=AdoiVRhQHIoJ2H7BYv60O1sKlNJGpn6l0U8kHS2h6CpwI_NwZ9-Urds8kbl63O3oD6U&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQSaX4aVKGUU67JYBnF-ZNfeSIoBd1Sm_aSlv3qaxfFg&oe=6A8ED905"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PGiG0tY36REQ7kNvwEBD-e3&_nc_oc=AdrO_1axkVgERFlgQn97UWWEVbIG8onUHMVQLKfqiYmtHSg3bfEUt1QuPYVZrhX4dDg&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGkrk56DxeBC9MGmCuEAlkV346RPML7s0aLje5OJ5wZpQ&oe=6A8ED2CD"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=43PGPNkpVBkQ7kNvwE7wySP&_nc_oc=AdqepTfDBTg2yiUR_6dYNK0ysxJe2knhlzoYhtOSXesAB3N8cj8lEH5AbRrXWnkr_CA&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFe97J5VB5OVAUip9BYtQK20k9lqs_T8A5zqHEDns9L9Q&oe=6A8ED421"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lmN9LFtc_fYQ7kNvwFnT9ul&_nc_oc=AdqMOJ0a5Iyq-MUDhUMUTvO02gEI85NdZkwadyPdkGmWtPMoKz9f4_MgJCLB5QQvIbM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHYKQ2QmIxzk_7eUpozpw6u976cMM-R8In4_kA9XWbf7w&oe=6A8EEDB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QlPR8AWnX-UQ7kNvwFTKH6J&_nc_oc=AdoLLOfOu6RSqK5E8uuZvbvfOb2_NNob8nhlXKnHWOPNweuzwvSRcB1GCth0ElwMSBY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDFWtB7-aMqp8OLEYkPIRiI1D8SXxoyRymB1pWzX01uw&oe=6A8EDEE4"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_
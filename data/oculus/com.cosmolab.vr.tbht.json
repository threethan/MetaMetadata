/scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FHvI4dz33u8Q7kNvwEC-9Zl&_nc_oc=AdoQOLDosNwFbc6QyZa85G1g1gShopf29S-13ImLoWYGyyD6ra96I_UIrk95yA0v0AI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCx7rk1OKz-7_DOmhaepLeylYLK01amnkb1uXoKSvUhjw&oe=6A60B485"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wjiOYzc_MWAQ7kNvwEir63v&_nc_oc=AdpOazuQvmimgSShaskCe0sdBUB6nw2Njj6fqGakVmVE-6PvFDleT73cwqzWUEpQUik&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCvSnXHyDZ7QeSyToSXL4VZMfAQfv4X9Lw9e1QYzVvEIQ&oe=6A60AE4D"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F4zkzT1QAbUQ7kNvwGialB-&_nc_oc=Adpw0q8DIAytL_06pv1PzFM6PFJuyocYO-riJCH3MWsykx-tHBrBamZvkTp3OujoRgk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA8CiqYBMOl7UmF1DN4xXAYDOl4FnHNmkDElx8E2pddgA&oe=6A60AFA1"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q0I4lcpDeKkQ7kNvwH0eT8T&_nc_oc=AdoXfSj0T6g5g8gbLWQRnK0NDtj9lgRcvpffKjsaCYR_f7PGxbKz5nFf1z2EXHBuweA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAevlgSW0rRQNzGZqWqUoXQg_U3PaQhMgKfA-nM63I7Rg&oe=6A60C932"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Np2SPvqFmvoQ7kNvwFPuewz&_nc_oc=AdrthwSdLH6yGzEA5xnwFxnqoYh_khoGC6Nho2-ERsvmeuZPUsDrDgFuUKNFjlMtyTI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCsYMLmzuQgtkvzheCf_LJ-FR14zaZ0xGliwP1lOe8OFw&oe=6A60BA64"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
/scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6X1Zy6DeJ1AQ7kNvwHpmUh7&_nc_oc=Ado9zyxqVOB0lCvSEUBwoiXpDpBj1Mo_IzQ8DbBkBbmcrR15bYfSMGEaov8NNTvHIbg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfylY5M9loem38JKZB8GRo88Te8xYMiaD0X9bKKJHKPXTw&oe=69CE5E05"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hb-7RSJZzAEQ7kNvwF2JScU&_nc_oc=Adp2g7ys3Bop2ZKs6GNdGqoZHH1hmd5BOEm9bJc--XMwx0rgEYn964H5GrDkD-AStVM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxczpJZu4LYFYA4gqiOMzEGK84UV1eM8W_hvebz97e8YQ&oe=69CE57CD"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9SCPQ6y-RRcQ7kNvwFboIEN&_nc_oc=Adog5LW6ZRzNqdpZ7OPxjgmmRBvkmT10zjoh4g1Y3rCRhtsk7a-9woJUugOv-eOPp0s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyf6zG0hW7yGsY1gJ9rEPTTybscZqNk384tkMZqcyQFWA&oe=69CE5921"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U1Tx0XluA8EQ7kNvwEmB3ZS&_nc_oc=AdrcmIN2loUMmh_9RoGz149yQ-FxbqZLM9_GCAHFNIk1w8Xv9nOv5PmFyP3mluZO9kk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwoV8_gbjeHqUeNkGdvhXoZDvo1xOeKZDhmO9yOfhbQXw&oe=69CE72B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pCVy6xCbQPgQ7kNvwGvOJUc&_nc_oc=AdpMq693ewAz5EN5FeYXIqtZpv1u8u0M3cM0A-WKsNTrwfaPwJKGfESsXYxKuCO2Y5U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz0Rufx9v9NFVZyG01mYrWZdVtl7vN8Pd8Im0ak8gXmCQ&oe=69CE63E4"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
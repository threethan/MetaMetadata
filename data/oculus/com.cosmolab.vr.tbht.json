/scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iwqf3DAeXYwQ7kNvwGVHoa0&_nc_oc=AdoAdLEPvhwFun6nuidxOfGCRzqmX05Lc5DIwh-cR0Y-380cBgMbvVAVdtyWUCCtB-4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFUmAuNzr2YHU9zFD0R7hcxnffu2IJrbZ_QGIHU3uJlnw&oe=6A7B1285"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L0m95zLjte0Q7kNvwEnUWzT&_nc_oc=AdqcPjzMlct3P0VmRZ_-kkpwpKpCE-Yk8-d6LDHMB34kGMOTJt7Vbx8aksOBsay9yxk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8keZncRVzB9XdjyqqyMt5BPBZwp59DbmAnDay4u6sRQ&oe=6A7B0C4D"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rji0yWhLcugQ7kNvwHvdKOx&_nc_oc=Adptj2vhrm--S-SD_dvwlPnzsWtTvOiAymAq7zSw6vr4eieUunq_dZBO4DwYXItrjEY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVA1wrek6PAmd5-minTfyhUTWbPAeC0ucVXPUmhidtJA&oe=6A7B0DA1"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KQEd0n-8zE4Q7kNvwGB4PGC&_nc_oc=Adq1-5LM9psvKHXZmGVkNIyfz08mnvLK9YauPCGhzw-A5LKJ1-x8DeYszzv921HG2BM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0-hLhsqhjkdiOdW2Ah9ESb4A6NTBIVWEOgIEb6nPJiA&oe=6A7B2732"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CdvIcia6Fy0Q7kNvwHsDz3T&_nc_oc=AdrNZXASL7QE0K0aSsHlhKjjhm1Ue6IqlTdijxyxKTVpSQl9cDD2fEMyua49WKkv9bo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGtW-x5_2fDXAoayQxtsa26hjhA2RWIR2UthejuuhICag&oe=6A7B1864"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
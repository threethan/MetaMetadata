/scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zl1TXjtr-5EQ7kNvwF1H1tI&_nc_oc=Adq1OlNyXMg-M4bOJJD4krzXEmN7Gcj2STqvmxjD-kEQcz7C08bDba5hiUy34pOPXdQ&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHCs4gZFb5nDC41F0arqNdszLPw3tgtDEEpqylClOBz6Q&oe=6A941F05"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V66daU7rCNYQ7kNvwGxjw-k&_nc_oc=AdpdkPXYOvPYhBenL0e_9idQ9pg3Tbtw8Quy0Nn5mYEuP-Zg6IsvNzcxyaHahToe0ZI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEyc2IcTxuGNzJV3PFhUbPFr4-K-BXso41nlmOxz5xOUw&oe=6A9418CD"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IQrf7jwYjxIQ7kNvwGT8k7R&_nc_oc=Adp49qFOamhl1waTkV5QrYXgt2w-af6lh_ekCNdr6Ek6b8EjbKxTezMezY4Ta1WYtxA&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFChaPw7lEBarXn67HLWgRcZmofO6NGHNkijl6UMIg22Q&oe=6A941A21"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=brdkgEQ6C3oQ7kNvwFztwdB&_nc_oc=AdqoRpO_DAaXD561d4BZD5-9kcw-HCv6tXR-ZIn9f7HH0SDSk-g-uXzJJD4eODGe-vs&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFDURYtJIpJgJe4Y24JLRX4Mxzk48oB65DTA5QqIFxqLw&oe=6A93FB72"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tCGjxcB3Ma8Q7kNvwF0qXCn&_nc_oc=AdqaM9dxc3Q-9F79XqUrwYeoZtaQgRuEomjWcv26gMC6PqimtBbK-Qh8sEEAzhX4GOM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4PEJoKBoozegMlyd9-iYdkqnpb1wF6AHbEkAIG0f3uQ&oe=6A9424E4"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
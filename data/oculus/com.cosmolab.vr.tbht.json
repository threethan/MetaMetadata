/scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TqNwh15Y8j4Q7kNvwH9t_Ip&_nc_oc=AdpqDjBQAiIMZI3M6mQm0gGCwvc6E6oWE4g2ulVjP3MJuWWPmP2CWYDGUwQ8zYdSZNY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCWe7Arwr8HU3iQz4GG55AiE9Br7m8UkKqFHNbk4-ETEg&oe=6A538585"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F8uTWb4M2fYQ7kNvwGiq7pW&_nc_oc=Adp6tw7PUgDxxS1k-Ko2r4RCo4KnEkmFL5MiJ-14w_KKgR8uPOtvY7eB_NqZsBVM2i8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDaj1sf1DByVIB6OkzoZNo7murkN-SuR0bP7ow_iyvtEQ&oe=6A537F4D"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g-3L6FG3gqYQ7kNvwGcJJG8&_nc_oc=AdpcQNZRCBvP2kKr6T1-7FUjZLG1GWPRxTLLgjBrh0UswZate20RcPzmMWX73lt-yxo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA6KWIvDFIEb5sA3JZYSVgj_oUG0Vvl2axHPS2dJcanWQ&oe=6A5380A1"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2wjLMZCiDpsQ7kNvwHuzmY1&_nc_oc=AdpAo5Txr7Fg8e1L-ysmg3C61EdMEZrILVZoZt2wyIe8bQhU-9WrHo9wteeZPmKQM08&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCD8NzVZSJzQirx-A9xcPl7RbSJ2zYXzJUXHPHiPO_GEw&oe=6A539A32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JhMNWm-sQMMQ7kNvwFvgNnZ&_nc_oc=AdrxJdU1G-QFxOvSfGGOFTqkI7-r_tmQ-TUudUlIs-bmSv_h_eiHhsrZipITQgJcWk8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAyCxPxlU3corEgWkDuFtk5XdMfDuZblAQsq4fmgrmbMg&oe=6A538B64"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
/scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1-8H7m_Ec0sQ7kNvwEKXToT&_nc_oc=AdoXhrsCy1e3PLqmzZcyap-H8oi6POBVZoRNIty6gad_0vzZhfQYu9tK58VQbamJcLg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGruz5pqKeBnW_s2u5UiACdVtDbQhNdxDq3Z-JWA9GN4Q&oe=6A732985"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bPZx40Ra9ooQ7kNvwGhZ_uQ&_nc_oc=Ado41MsB5rM5P_ZBsWhfo-ssHG3OmnAyOKEAsh8ErFaFLj5D8FYMU--EfcDp2LMbKNU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE7_AjtmTCxETvRo-_KEFdu4Cv-p8RgdVOgbUUOYoyw3Q&oe=6A73234D"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4n8U0zOzADUQ7kNvwG0HNc4&_nc_oc=Adq2nAj8HwfSfmG4rb6wshKji7JgWMU6BngwXRAw3Dp53H8ZNJOym4lEzwtsGzVwtWs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEgqFf0frr4g_540Gw72AYRSGyxpzOWJfeTg1yVXeENRA&oe=6A7324A1"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D-ENpnumt5MQ7kNvwGBhumk&_nc_oc=AdolAOszYS16_wCD9_nmOIm50gabmNI-3RiwyhRJJx4zcFA0Jvm3wc1XJi_oE42X3jk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG0LEXfplZZ1YnP3hULJtOAgBZ1LlP_qJ6qDuZIP-KA7Q&oe=6A733E32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ryDmrDUxRB0Q7kNvwF6jqRi&_nc_oc=AdrXN1bZLhLWRLocT2XYerLEvWFHT9llHFxV53ezpUnC1WkpZZ3_F7FT2plycrlT-_s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4hCfuWhGAU3vrNBgaUzmnmcWkJhYjvvx9bsdpPbazaw&oe=6A732F64"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
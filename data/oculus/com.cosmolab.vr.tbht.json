/scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ymt1uUz5LCoQ7kNvwHRDvIW&_nc_oc=AdoEmXfZQ89nnREjK7RvAhgPVz4H7knuGeJDZRT46JHS7gbUrbw1x___eaFwA1aCIUI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgoIXbQzU2sdxtFuSX2LkyASJT1N2ilaeny7u2GysAkA&oe=6AEDFD45"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oif--e_fXiUQ7kNvwHFby0Y&_nc_oc=AdoiIDQP3RvD8YvyVisrzjRrnEX_MtG5t0lPLgmqGmZ_J5pzGk1aJMFKhGzidbNYuZw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSo6ebxnmtivhf1_A1j2zd3YDOp_c_AKCOlEgIp02RmOA&oe=6AEDF70D"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2lSheXIw6lsQ7kNvwHWduQp&_nc_oc=Adq66e1b-WxKpDA6sIR-7vTSla3974ITbS9iLyfI6izJ4BZJV864H1bfda2hdJOFGd0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSR1WQ7lr5Ssl-GD5Mzzx9S6UlLJQMN824DFggeIwcZVQ&oe=6AEDF861"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xPBiNWjGooAQ7kNvwGZn0jL&_nc_oc=Adp5ozOnIDE8PSj_uNNzvEDuqyeXbxUekH7AzVxZg0KTsFC6EBqBFVSsKXNU2ikh7tI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_MzaYp3PjKWnRL7vAXUinyE9Lhx8WuZAvwSzj7G9xdA&oe=6AEDD9B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Obmk8AVsq1MQ7kNvwFo1_AF&_nc_oc=AdqBT4FXUlbZzXnOWp9sPQ_RcUxdgE4u9xUKS-83bZDS7PAcLNPJJXLXIjp_l4ELP58&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBlqtiEDxNOtlJ-LD1vwpweXwsJv0updPqR-y0nC2A4g&oe=6AEE0324"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
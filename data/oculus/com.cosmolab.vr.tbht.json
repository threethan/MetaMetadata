/scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1oCRznGaT3MQ7kNvwGfvOiU&_nc_oc=AdrP6QDtFjXnEQV2QVyPL9ERMr9cXyrkW-qepeR0mETKQgJt_rIMe7-L-ue0cykAe2M&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af47AsOHI_ZMXTQWPA9yebGrgNruPd31_N3c_L6AFUTvQg&oe=6A09B185"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sYfbSE3OnCcQ7kNvwHdJp16&_nc_oc=AdqP4vFHKgRNnbpZ4Q2qR8aTZEKiStlb4NFBDoNim9rnjlWcDlekFgfQyxozYjh3pBw&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6j1PHkApthRzxisfuQsw-JPgn0bop71tDRCoA4X_6QUg&oe=6A09E38D"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uJfwN0THQ28Q7kNvwFL8Ykv&_nc_oc=Adruz57Zg5xaCWLPafqZevlOYLWrKeK2ivbj0kIArr4ypuXAjflKaI9-SUsq9yv_r9E&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Gvylw--dAMm4kt3gmIPsSsSR8Eq6AmVY_BzmILKucBg&oe=6A09E4E1"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CO2l3ayCDF4Q7kNvwGEmVUz&_nc_oc=AdpUCqH-aH-s3QF0Rh1HTNxrRA1Cti1-Bcv8SJ7C7_aoCTR4Mee8gqdn8X3BXyQB0v0&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7M5g0RQKP6dcRT913gbtlEnofeJ5xU1aj68emIpACbzw&oe=6A09C632"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dAIKtfoLRfgQ7kNvwF4snuf&_nc_oc=AdryHFap4HuNIwFwO4ZJb9e09J9H9_hhCn9Jzan3xHbeCwUuqRR8XFT9q0Q_w_EzWHo&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4wUEqxdDEFIp6VAhGUM77anaVr4TkTDrREoxcbK8pgAg&oe=6A09B764"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
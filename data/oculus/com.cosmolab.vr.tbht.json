/scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y3ROBYpUhZEQ7kNvwGX1K6K&_nc_oc=Adr0iLPtl5fVDrj3cgVkWripdNqOH9Et4Ujog3a2TadY4D-NQqOtU0L67SnokFEzrm0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJlUMRj7oJlaGoGySNZi2bXV8WQP0kHe5rYOYcVbV--xA&oe=6A9AEEC5"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xMBqZJjasAsQ7kNvwGHi8YU&_nc_oc=Adpo-hiphe22U4GxVbHjhxgVEParxvxOKFUMCrdqg-C_9QDIE1Sl5qTvjzcVL4WwsSI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8hGoXkuqYsNqNKMm7_aRSGo5yIeDgdjcymasKsV22Ag&oe=6A9AE88D"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HEKIAG7OPw4Q7kNvwFS-w5p&_nc_oc=AdoLoAcRQdVnfCyJyXj-H9neQE4Auz6C6Fq4CfY23xHh8JwcPMjbIF6vCxUR7vxwc38&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVzI1_6X5KrsUQDLljFCr-maFKG1WtlCabqStvP9RmcA&oe=6A9AE9E1"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rdMt9apIqxMQ7kNvwFJ7ssJ&_nc_oc=AdrPP3ierd63-DwUsEN1RGW7FLbNFhxiWZPOsFxduXSe20SVLndpmjYfl5nT72SxlEo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJH-2wjSkqCPdx6yGk5ZyKzD3Jk6j3iuPC_Fch2wCf2QQ&oe=6A9ACB32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ine9I_aR3gMQ7kNvwFx0sEQ&_nc_oc=AdqM5aifz9zCRh9Se_l5yLtrX2WKwhSgtNIOb_mzYyq1AtGDB2UDPeqgx10hIAFKSpk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIv5thlpxnmNBud7IWxYawITZCnhOT8b_TR1ITSURTZ2w&oe=6A9AF4A4"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
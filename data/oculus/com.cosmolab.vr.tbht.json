/scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E47ztweV4q0Q7kNvwF1iccH&_nc_oc=AdooIqG_c_Nr2kosEXkOTMuXlJmnuOqlm5r41FqxbLFMn4Qlt8WTu2cW15fv_wnJwzA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxUMMZxOxS9FIsBBu6SSThl1cjZeSiD9I4kGBP-_MWG7w&oe=69C67505"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FOSpWU1-0sUQ7kNvwEfEDlt&_nc_oc=AdqtLgdXzk9toH_uRkLunl4FpHj_q9lOyaDNtjpfQ4ItLCn-GWZcnFig31tFXWv-KDQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyp_aP-Z4FVM7yk9OyD87jMQd76w8N9KgGv9lzUs2FRcA&oe=69C66ECD"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qLgSRZZUymwQ7kNvwF-EHpr&_nc_oc=AdrhU6Om3r7fIy1D_tT2dzOCWnoEdp5GdeNxOiOJxhzRLSCFLc06Kp0E_qsrRZihl0A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwCaZMZESBc0cNjJprvtITCI3pDtsutQ6aROngc8jBJ0Q&oe=69C67021"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pALLhK_2We4Q7kNvwHrldZs&_nc_oc=Adp7yAfDiAKAIzjVH0UVcYvNCS9zSdkoE-qYvzm5JvLmbsSRrYYsahXPTOhpnLGTY4Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy-UmvbD9oJT4049Gx8KcQENRJcJq9JQY0edx6u7NA6UQ&oe=69C689B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CvV07dA1P7gQ7kNvwGbk1iU&_nc_oc=AdrS0VD9zjepvXUgJWhnA2b5y-Bini82zXMr0b_wh60f-lX-NiGtEX5817Gfwv1QqcI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxBPZxIVIAYwEsePjDKVy9avwGGjF7EBj1SWkkxtSItdA&oe=69C67AE4"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
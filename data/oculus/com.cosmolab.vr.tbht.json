/scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=54itpMln1agQ7kNvwHlcWab&_nc_oc=AdoN1deS02qB_GxGwQ2nXZ32eZ9Ngsfz4gCb5BmStY5oQiCbeSHkIMRACKUUGMqeet8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6BDK5xlK89ebx6gsSSQI2buM6JNHMhWTMIhMtS7rckDw&oe=6A1EC985"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nlg269AcoiMQ7kNvwF2hR33&_nc_oc=AdrIu7d-4muI_ODaLTSM5ZjJRnWDsnvea4qjdqMpRD37NxtMAg4kWtwI0OejqgvGpWY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6uh4h6DLjvCj3G3i9nOCWfDcEZiwXfJeG5dGjI-mIEGQ&oe=6A1EFB8D"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hFfZG5H-A7MQ7kNvwHVJ1iT&_nc_oc=AdpqAmXI-61eiZV5Y8ulltIiCs6qXLbZfJZg8tENHHSGznm_XmgvquUKGcdBg2S018U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Q7e3_Ki6xBcI9UeOfJPx12ZndnM-DXMbnV1xyINndjA&oe=6A1EFCE1"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S2Kj_yA9BBMQ7kNvwHDgOEs&_nc_oc=Adr7xCwXp5twuBlvitHV5JtvVRE4izNbNEjAULLs47MDRLnFbcd2_V_jeEatH6daDeM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5y9aQHY3v6kC0QlZ2MHX7eSUyZyRAUNRskkDjE4QJtdQ&oe=6A1EDE32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5y70SkkZQb4Q7kNvwEtXgxH&_nc_oc=AdpC9TAZasNrKyXQf2N5TWjcNo-5FIYhdADol73Bgr_9BenDOcKYB0kmGLaRDi3Eh3g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7mMCWNZI0fgs4kLtuwK08ufgHF-RiWdOK8YwTlNbsxLQ&oe=6A1ECF64"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
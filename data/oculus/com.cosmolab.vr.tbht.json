/scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lsa0O1zlrRwQ7kNvwHHoMty&_nc_oc=Adryl8cncA7mCRhZfEz5lH6GZKx83EX5Z8ohc-DpdfAgWUPLlZ1R5kh0HQSV07yBsqw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFXiQXhVXbyJd5Szlzs94ZGMLUEAhihROXlyeKGimWNRA&oe=6A7C6405"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IL0puHmveYsQ7kNvwHODzrQ&_nc_oc=AdpkFQKBHNMDWhOSoRROi5oh71RXBmydROA3zX_18gMjwajlSx5k31EZ7x9tCRcva5Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGiYZ9kXBj6AGhyDvK7_g4Dlgw83vO-npa-pvHLXCBrQA&oe=6A7C5DCD"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rji0yWhLcugQ7kNvwHsvAfv&_nc_oc=AdpPBE8aT0Z8WbOTljEuBr8-RpTx7KEsPLFH-mYEhoGMCyXZcZpKEuY_d5pOUczGEMc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFinT3FR8L4iTZPiVZFTnPY_u9cpWd7ev2KKT7GS0Vp2A&oe=6A7C5F21"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t_F9zYv4_K8Q7kNvwHPsV9b&_nc_oc=AdpQm6nkGSZcd4ICleFsgRbxuWeyr6Ajh4j4H0jG2CZFXiA7TFtmApiZrtt53VpJySE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFysmwdAPQD-iei7huWOQSJAU0ACG2imR1zCL5e_DCH9A&oe=6A7C78B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FrUOEBaGsLoQ7kNvwHsNnUK&_nc_oc=Adp6l3LoFu2Vp5cHpJk3lSq217qr3PaS8oFw_beNbB2eiSeYxuKWh1W48hCyGq5Or0I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMOiY0mopNjIABidgznuQSH9uKXlCQneb5UjYLNuBTFA&oe=6A7C69E4"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
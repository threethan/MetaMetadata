/scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0PnWY1zd5oQQ7kNvwHi4ouR&_nc_oc=AdpNwGxeq_aDdk1s8iQFrpIqXxu3JL-mul7hW1PTNK4to_PuZ6ovc-xVPGW2YAc5JfA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNH7TZhRl8q9SzBXUD1FjdiwTDPtOQYRwIcrefJco1rzA&oe=6AC51EC5"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PGcDQnOXdFcQ7kNvwEe8uCh&_nc_oc=AdppK1iKSzkStIxIlDPQEEGQo2FJ-V0FaTniehhJ4hz0NYzd4ch4wNKE0lj2ffIL2JY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJ56lwPV9crtKyW_Vt739Fpj61mPJOOrNbRgJG_tvFIA&oe=6AC5188D"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lZ5sP4bjchIQ7kNvwE1T9Qn&_nc_oc=AdowfDYXpqPZOumX23zhOci3cMdAHMKl50yX01lm44Dk_vYw1moD1JeJ4Ny9nYi0DXs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPt51yfMqwuB7CKOJ3BHPHcx-EVegpIcsRFGV_JUgMJlA&oe=6AC519E1"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3FXTlWqa5MkQ7kNvwHhmGzK&_nc_oc=AdpjuWf0yetqhw_MKY3RhOsEqLDqkQiELk1iGqD2nr7AN9mfoLt2LXTEtO2feXLfYzo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPe3y_KE93PW5ar8AAd8lb0EORvzJOdnDnXs1UWzT_vAQ&oe=6AC4FB32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CCqfhugw3-AQ7kNvwHwfuim&_nc_oc=AdppX4DbsfB5Vl04up3CSg0rWGm_vfOqHxRdkIoiw3A8LCyj_Oz-IcvhiWkQWwpEvqo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4n0litbIC1MFwJAAQgGLbj5py8lW1uRQ9SOUuqNw2qg&oe=6AC524A4"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
/scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HjLakxnlZXMQ7kNvwEwbosH&_nc_oc=AdpeU8kCuEHIHz69XbxSlzcXl7Gv0879QY4R6fJNGrb80iYo5IQrC7hux6zCLv6juCI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzJi308ejYz6xk15u5TIOpSPQoXPPqaU154dRF8Kos9Mw&oe=69CBBB05"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WBlVpjEOjAsQ7kNvwERvSUp&_nc_oc=Adq0lo37C4yGpMNTOlY1iUEVhPlIGqQmTJ6gunJ_n-4MtkuiKogwKpkXkrxruKsRFXY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwCAv-RZI8sYB0FvZsPQmGZ_TaTvOOBQddhBRFm0wFmbA&oe=69CBB4CD"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9SCPQ6y-RRcQ7kNvwG1HX0s&_nc_oc=Adput_yuQup1OQZ4_4hZ-HNSyXwbe0p_t9QQAg3nhKGuNqWbhfdKmLtal8nH_R19noU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw4HbwNcU5ZJjWRGK99TUufbmoiE8sw5dMNrk_wMHaA_A&oe=69CBB621"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4cRzXCo_QokQ7kNvwF3JrIP&_nc_oc=AdpPLMoqyrubFCkCBDlC4_tV8WEbP9YOzza_SPLE7zKvRi12GoOwTEBoNJqsf2HiIG8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx7RjtJbBQ9gw31l3af_4OZGjEwJoJkIgDNd7KOZ7H_sA&oe=69CBCFB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mPZbB6loYeIQ7kNvwFrKe5_&_nc_oc=AdqnspdViXHNmxvyAM5_1hxB-6N9RWBV5pkcZnEVoKKlLpN8BKlJPNidFvk_B645ofI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxyZqhxWdmGu3sGE4E9zKsCuMOYq4_xDaPPZM1M4wKkKQ&oe=69CBC0E4"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
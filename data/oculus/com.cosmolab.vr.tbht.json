/scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=54itpMln1agQ7kNvwExIxks&_nc_oc=AdopSxo8ikYzG-ZFvic6v8WUm4_Nr8jrYZM6NRZc1uBlkVkX4Y4yX8zGhPu1Bm5_kgc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xH6X4MkISUXjbp7YVLYByRR2fVkQvQ0lt8xvUychOgA&oe=6A201B05"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cX4XbN_otm4Q7kNvwGfuobc&_nc_oc=AdqujnJzUunszB5rxgNG1TFlUdEbUzphmb-6T4f0z7mz_WU4ztn40Ou7uTtZPQa35XI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6x6PIc3M1C_I18NftSqahfYryPiWfPVPoSNIKs4p5KNw&oe=6A204D0D"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hFfZG5H-A7MQ7kNvwGDY6lM&_nc_oc=Adqo1EWPOobF7uJj0SfF4jR2G6q4XSthuPfJX1KnekwocU_IKpapK6wYbeq-xmpWe2I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Ge8lh-MKYugbK9Iv5OKdWkP-UQDXDytPtk_MFL0zVbA&oe=6A201621"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S2Kj_yA9BBMQ7kNvwGtfqeD&_nc_oc=Adp_x5TYH-K1rG-E_MPQGOs415WwW3I-JYm1DTHuFWrHGkVwpw3ImF74yY6GJ7N7Stc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af41LPYnLOdqwhmMV6_f2zl4GupreQyKnfa3m1dv87ZufQ&oe=6A202FB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5y70SkkZQb4Q7kNvwG6pbvT&_nc_oc=AdrCbBCgwdggbmSSqRmCpVA_Yqcjx2s7gxwrQ4K0CekABeIga-B4FRnUe71nU17F7W8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6NgbNsigk52WwviLcKarkZbDmwUQlKSGONndYeofq0XA&oe=6A2020E4"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
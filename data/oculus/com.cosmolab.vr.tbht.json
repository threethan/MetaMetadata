/scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_PPKrgILjGEQ7kNvwGi-F7e&_nc_oc=AdrquJ-yRRj6PTxz8SIDlWm8l0-BuB-OwF89m-LBWX2shsBGOnOwSaXuqqYX4hyWWmM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3grAL0BhF6mK4mKs7APSnZ1Fppyg2vyBjwP646NVVJOg&oe=69D4F585"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RXliNUqE1VYQ7kNvwGMQmoQ&_nc_oc=Ado3DEBnJfZRt67jelU1MBCvMlb6FAWHfzwQv9NBz3OVGH9nUaCf0CchPvIuFpz2TLo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3jHVBbqPbB4Rhg7E7hDMjfuMwMsOcYSfxnzTFtenwZSw&oe=69D4EF4D"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oAZ9VCzAKMUQ7kNvwF80Egi&_nc_oc=Adq4RldpgECND1LjczuBOZl0CI1SkTIjP9QQExSx0MJfHAQkOE67VBKyKbffgZ310BQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1FMihRE0XCMx632EtO8zwR9Pa5HedmJQHlxk54tJyeqw&oe=69D4F0A1"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qbrrusNhiaIQ7kNvwFxHb55&_nc_oc=Adp8yOwpYvfGU8WjS7u9Q0hJYEAVHIO5UAd6D2Gpggxv32uU5_9xtcat8vXr_ud61S8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1OxOiHRMXnaZ-XsCu1s05gu_-rJ3Wl4QgS5BtrH0gqzg&oe=69D50A32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sk-z4N-bvYcQ7kNvwH8JanY&_nc_oc=AdqsNUXYmRegrn8HVIt9RVj98lAkR-G6XPTYjQdTsUHnphcocqrOwhbcVoGOyU1BbsU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0CV5v2nbt2m28gOz_yaZvFjN8Ms_WZVgp4Vy7iWY7Kzw&oe=69D4FB64"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
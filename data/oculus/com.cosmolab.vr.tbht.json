/scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1-8H7m_Ec0sQ7kNvwFtSVgi&_nc_oc=AdorDniPBkg3qJEoUevMiGCGZ8f1nHqTYAlFalPK-vm8cqsojmrEcN8HOLVhA0zDjYY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQERhr1ZVqAShLCFEHLsKIXdtVb9SxwQ-7RWs5dl_gxtaQ&oe=6A71D805"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bPZx40Ra9ooQ7kNvwHFpgHe&_nc_oc=Adrb7Q4yOh8B_Y5M53RcDkKOnsQ29jiu2B2dSCCjH3qIfbl8FUKiIald7sC4Md3qlyU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_o1KbZNRo3ntulYPcAAXBu1XDJ8zGHDqtHR05kDiIhQ&oe=6A71D1CD"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4n8U0zOzADUQ7kNvwFnliXT&_nc_oc=AdpBCDGoUorNeTHUWNOEir852GMUoVoUiisBx8mB_AnV0bP39g2CoBlZ559nhb2k23w&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmpk66HBzjQMt_2g8CSozPXW6PfipZ_Ep3eD84YwhdzA&oe=6A71D321"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D-ENpnumt5MQ7kNvwEjgC_s&_nc_oc=AdrE6NNBbTHcDejRe02MRaFHPVM8st-Ye2sLKHBqWwRpWWWn_BDf8UMlos8NrH6IGMM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEwdP2QvW5s6Bs-j06_pmMpfjp_EgNGpbJKW2cccGLNxw&oe=6A71ECB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ryDmrDUxRB0Q7kNvwHw8YPX&_nc_oc=AdoXkSKec-u7JyOyxwtf6A99UI0v6CbVvSjciXqZV4Nu7GOLtFVvJgsR_slc0_KZpxE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGq0dlknMA4RNm2OgXcweiDirWWPpFakrcrbE7cn5AWFw&oe=6A71DDE4"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
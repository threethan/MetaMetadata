25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IjUvwZkXFhUQ7kNvwFshuFk&_nc_oc=AdkllW30d3j_kv2hX9T_j3lRAcIWm6C7PbwerGp9Bg_gSevKq6tfd_79pZOLk-ZYDIQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfwVcxUr1vqfiZsO6ueywoi7xECRVoZ-ZnuUPpOz2UuaVw&oe=69AAC585"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o8zxI67UspsQ7kNvwHMwWU4&_nc_oc=AdmyIwuPivYeje7bo4aPFs6shZ7UzBoKgiHSSz_jXaEY2a9J_gU7EB_vxHEEKkInTdI&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxRDUuOdLnavhFXQ4xIBIp0BEnxVgz60Lm98ruLe07wSQ&oe=69AABF4D"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B8ZYrmeNbHQQ7kNvwF5FqP1&_nc_oc=Adk4gsRnbf24LHjGw_mlqeFpDAOCm65otzrK_oVsykQ7cakBGkWlYeW1eWioRhEoIEs&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfxN2ANHFr57mKG0GpnDYPDk8wXaktwTEhSbJcoHYlj2eQ&oe=69AAC0A1"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cg5nznQNt7oQ7kNvwF61kbW&_nc_oc=Adkylfi-SwG0JRfzmBK28NowvU7g8Hb8sFBeI2A7AfxS3azjPOid9IJ_F5fJtl8OA4o&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_Afx1AuEI1iT1a4-GgM8V11J8ZkdRPN4dyEIgw3w55LyIrA&oe=69AADA32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8pcBKJ7f79sQ7kNvwEfCbug&_nc_oc=AdmsSVThvvXqPmIFjURgAOq18SgDB4FuHqn3SeVh0VgZQzqSVTHa_fwn84qP3zB8uUs&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfwlXJxX-pWnlnxVlUdjJokmpL6uz9JwMnwyjhrlQz1hPg&oe=69AACB64"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVE
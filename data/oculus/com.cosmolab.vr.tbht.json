82723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kjjs8_qDErEQ7kNvwHXcDl4&_nc_oc=Adl2SF2nZc0lESoT-eXR2REn1Kon36hKFDOZhZdfBGHsoEg_Zhka94RCBaBO5kWsOEo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwjTboupgvJfwCPQYs0cOZ7H6b0JEEYTQQOF96Q6bIYtQ&oe=69B94605"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Daw3sRWzaRkQ7kNvwFn4SE9&_nc_oc=Adl4c6V7Wd7-WvHlCaAV5B0IbSAg3LInhRAThQ64cie2TVy-z8uREsS6bk6Rs7CFac0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxUbl9cubuKgyFhOn4NakJzRSYd0zprWhgeak5xMZz36A&oe=69B93FCD"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uOPKkj_h12UQ7kNvwFxV-GC&_nc_oc=Adk5wx4N-NmsVnwj48At0iN6Q-q6qLKsgHLLxJxZNNqnK7wiapujxxuqRN4C9ry0DmQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyoG6Gai0Y48ejHUqWGxL2dk9WdYgnUDpytTRaIY9KPrg&oe=69B94121"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z8XQ4M9ui2AQ7kNvwEaWTI9&_nc_oc=AdmcTIk_biDocgEN8uobvGILE4KmLDAT6L3omcVCZAtm2gqOYLlaOPMp_MdB_cbB83k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyXdpwntpuF21ggFO2e0MfDmyRponz0scrA87tFjAzagg&oe=69B95AB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v4YfGbW9Vw4Q7kNvwHcHXrJ&_nc_oc=AdlvnKVVtiV6k1m4WGSCOwFG2zfdxQtveFDhEUumXusOi1KiYirJb3vXrAk4rLcvhxg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxwO4_9KxUv_J-FkB7GLT_GRG9WJbIsvenNJDd0OAZICg&oe=69B94BE4"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "re
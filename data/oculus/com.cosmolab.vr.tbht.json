/scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H04u9bnJbF0Q7kNvwE7h74f&_nc_oc=Adqv8KEJ2XUf_B5-Bbzv1BTFeMzDqkwSXhsbwxEuBBgmZq5VA3pma0XMWdCNpVpVoz0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBJMgwh3_f3uxdFbuv2fOnf9PDbsaEZ0Zr1VnP5kGNbw&oe=6AB15845"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y4iaWNL-wyEQ7kNvwEC3bA3&_nc_oc=AdpRXmagfw2miJRyBebAGcPE6RhyMdKa-ycXJhY46dtjFYlxkmQpo4man4EzpTVs0Y0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKrg4j0YCl9zfCYqJzzpPyE3L87ubAZ-0E-K201eE3Ahw&oe=6AB1520D"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c6-yNnDskiEQ7kNvwFBhbkM&_nc_oc=AdpqHWgnBR437qtofepk_pt6HQXPiHvLils6ZawyZXrTJNCSnrgDIZdVtW8ipW2PUI0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLr2fI-cN9xMBkK2fQ1tbYEbPvu3rAOitBM0ATcqjTb9w&oe=6AB15361"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RjLNiQy5GSAQ7kNvwH3cr9n&_nc_oc=AdpHQf8a1KHI1KH1oTnDZ4K7oj-SxsN3l4aA3ckWZr4Rpn-CfvYbfZXmix5SauERMXo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8FjPXneBYEbomDQFHIuA8np9C9f6s5TmMqoKr5-rQZw&oe=6AB134B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lohdWeO6F34Q7kNvwHhWPzj&_nc_oc=AdrDOoSu-nbh5NgGnMk3j0oidU8OXd7oBW50VvUS03qkVvbgBml9Quvvul-pGuk93zk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKvFvcsxYRQ1X1pBtuVKmFP_V8B4gZ3DkH52wpTSXER9g&oe=6AB125E4"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
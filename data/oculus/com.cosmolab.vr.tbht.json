/scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6hcLHLtCl7MQ7kNvwEgAyVA&_nc_oc=Adq09FrWZPYk6WSFdwu_IqC8uKuTsUr-A16sb_e_h5R6OQeNxE0HFB4CncbPLxcMSz0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEIdgtO4Oj_TjhANhsYyIwW12jFNHtVh4RaS1kg4fvCoA&oe=6A8AE485"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7JjIq4djGVwQ7kNvwHekqBa&_nc_oc=Adox1NAX4KsngfSW9uoa0J-Jz4JNN8R3Ewe__tia_6CXCFvUjSwLgAljB_4xFemvFRY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSWOnZ5cBCMjhA2rw-6s_QUptEX99RlMbnHH1bFW-Tfw&oe=6A8ADE4D"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5vKtUtosNe0Q7kNvwEQ9RJF&_nc_oc=Ado0schq4jwcBm3e_mY4v6auVnLNhzvJRybmetcQrKEECSe2Q7Q2HpcXP1SmV1TeMSQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFTk6iyFyKmXwwN3Zlm_2zNzxDU43Uk4TqyrpOb61_g6A&oe=6A8ADFA1"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9VlzhsC3oisQ7kNvwGJNDgu&_nc_oc=AdofTopgDrVI3Dc947TU4PHyVVruyhGIquH6Og2QbjkELDBW-aEAEeZhOU9nL6p1VI8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3MbtPa1B3gawWC5RIVP88cruIBj2QRf2fRPNXFbuKaA&oe=6A8AF932"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uurMa2FMkjcQ7kNvwEuwmBb&_nc_oc=Adr3lsLF2NA4V4h0kjWiLr183nugYF4ZcCtlWuAYeb6Z4ugdrO_0icmuXO3oRxWraNY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEy28X4RjOYTJ3-ErRzgZZLhcdisZnmb3enU34p4m_OHw&oe=6A8AEA64"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
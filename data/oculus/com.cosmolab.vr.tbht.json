/scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982723_1108972894107503_1148109438202255693_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hst8V21Nsy0Q7kNvwHJvM3K&_nc_oc=AdqnMS0Meb7luCjOJtNvRWVxE8e2VkKkZJJ4dsBBrhCpQeGYyeFkrefoupm1C15i7_g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAaWwOrGaVwfX9PgtXmxYPN7FBuvF-4zI53bmfhX3ckQw&oe=6A54D705"}, {"file_name": "re3.png", "id": "1294026398449347", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39001710_1294026401782680_5383332081522884949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b54Ktua2_dcQ7kNvwE58uZh&_nc_oc=AdoUwzMD-eS7ZVJfn20tYIvahjmDX4efy1IlGY3EZ0n82pB5XUhfkdQ32bktTfyzshM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBlz-ojEWOLY2_9n2GAuSWg4KNAPhb_b2bVA05FI_imFQ&oe=6A55090D"}, {"file_name": "re1.png", "id": "875024478037596", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031563_875024481370929_5294554871245837895_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g-3L6FG3gqYQ7kNvwGv7ikM&_nc_oc=AdqM9ft8pWoRyPcFCqMAqoPB7Aw-V_it3xYb-3XE4IzgQ-oPhcqVDf9PhJJprvJVgHo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA1cODolIfCOHMeWew5eaLNA5eYVfD6tdzQgaVuMq01Tw&oe=6A54D221"}, {"file_name": "re2.png", "id": "1105050690848128", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974882_1105050694181461_7698732000340151139_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DaKOm_p47cIQ7kNvwEuAjaP&_nc_oc=Adpv0nLrp7yqgvcVACF5KHhqXH80lhnXi3CTXRwVvr78iaxyP3SwULbQnbPA7ve2t6w&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAvE_v521E1y-V4uKBbFcrnl7nP_htQGsH-0V222dndTw&oe=6A54EBB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "1981686229021396", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391959_1981686232354729_2164348935367775170_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=La8SuwuKpNoQ7kNvwGdRQlT&_nc_oc=Adoo_LU1Ov3mn-Ks5kKBZ96r7LiA-WDz65WOeXtSOORQcYIwhDoJ609vUar6WFUDf6w&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQByNFkkYKb1JCTHwsF5aSNGFoFwUSUqNcvaQRUkgy9N6Q&oe=6A54DCE4"}, "display_name": "Heart Beat Hero", "keywords": ["rhythm", "sports", "beat", "rollercoaster", "health"], "long_description": "HEART BEAT HERO's main features are as follows:\n1. When an object comes close to you in time with the beat of the music, you can hit it. It's similar to tennis, baseball, and table tennis in sports.\n\n2. Provides various sports tools:\n\nYou can enjoy realistic and fantastic exercises using boxing, archery, ribbon gymnastics, nunchuck, table tennis, musical instrument drums, magic wands, guns, swords and shields.\n\n3. Endless world stages\nExperience augmented reality by riding roller coasters, cruise ships, and airplanes in the backgrounds of various places in the world, festivals, space, or amusement parks.\n\nIt also includes a rough measurement function for burned calories proportional to the movement of your hands and feet to help those on a diet.\n\n\n{1519005248803452}\n{4156201407985299}\n{763369785994234}\n{1082351903589810}", "short_description": "HEART BEAT HERO is a game that aims to provide a different kind of fantastic fun and sports activities while traveling through spaces around the world. Enjoy music, exercise, and have fun with the rhythm.\n"}]}, "developer_name": "COSMOLAB", "developer_privacy_policy_url": "https://sites.google.com/view/heartbeathero-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "COSMOLAB", "support_website_url": null, "website_url": "https://sites.google.com/view/heartbeathero", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
S-970Dugag8-tnLXv5Jhyqr3PYQXnaKBz4H-Mg&oe=699C4337"}, {"file_name": "Game_Custom..._15.01.2025_20-32-37.png", "id": "475145178729103", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391784_475145182062436_862919831143675164_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R9ADBm8_4tEQ7kNvwFYKpQn&_nc_oc=Adl9_lniwF-LoxeU4lzq3zy1Tm4jJmH0y5VJnamwOA4eVh3qu0FpW0ZSXBzBsmN5zQg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftUGOzA3AcDRxj3HreRWuo7SwvF6my2MPq4H0G3eRiAaQ&oe=699C4D12"}, {"file_name": "Game_Custom..._15.01.2025_20-32-53.png", "id": "629313416158379", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391791_629313419491712_6764765756323544716_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n5016JG2_0AQ7kNvwE7UR6P&_nc_oc=AdlRHS2XNAj4tSQ__tut44yYPlbHAlKEG69fJ0J87KMVGZAXBelr0wfrJdc8I8HWxCU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsFJuyRLNKdOHte6xrZUP76IsqAjbvqtznTFeO-x2PDjQ&oe=699C4A14"}, {"file_name": "Game_Custom..._15.01.2025_20-33-05.png", "id": "620641200362359", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391787_620641203695692_1569235066887439397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Z-oteD3JK4Q7kNvwGEP4a4&_nc_oc=AdkiDX-dyjqDaU9Ig9GGhca0HHD1ZXbC2R5DmhtFChIMFEVC2krLev95QzJ8wtSKSuY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvjRmAzN0W_GjUkQ0La440zZooPZv-BwrCtKz8GSniGJQ&oe=699C36B7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tamarin Lava Escapists VR", "keywords": ["Fun", "Multiplayer", "Free", "Parkour", "Sports"], "long_description": "Tamarin Lava Escapists is an exciting VR game where you play as a tamarin trying to escape rising lava. The game uses gorilla-style locomotion, so you\u2019ll swing, climb, and leap your way through dangerous terrain.\n\nThe world is vibrant and full of challenges, from tricky jumps to intense multiplayer competitions. Every level keeps you on edge as the lava closes in. It\u2019s fast-paced, fun, and really 
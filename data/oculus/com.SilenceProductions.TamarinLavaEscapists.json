a9U2ireHDdPfIeu31U8yx3q7LEbZxbVga7-apg&oe=69A2DAB7"}, {"file_name": "Game_Custom..._15.01.2025_20-32-37.png", "id": "475145178729103", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391784_475145182062436_862919831143675164_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D6fGSZsw644Q7kNvwEy6c2_&_nc_oc=AdknYfGdRwxG-iWyI7XhohfGuqjHQcs-O3GNh4lSncUVXScRe_8D7_v6ap3zIXRZh9A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aftew6zCatFIJ5WZ0hGode0EaufBmOwjDpgHNJDvxTTgBQ&oe=69A2E492"}, {"file_name": "Game_Custom..._15.01.2025_20-32-53.png", "id": "629313416158379", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391791_629313419491712_6764765756323544716_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8rznNS6KBxAQ7kNvwHwXnNH&_nc_oc=AdnyzK94SmYRtWj_L7w88Mo2WZ0L2-Oc10FAhtkx4-fhgF_-Bqw6a1Iu7QgOnWhT_58&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsLwpZXqAhmJ0q79Nn15sbsIFdKxnhACVtgZmXTw5B47Q&oe=69A2E194"}, {"file_name": "Game_Custom..._15.01.2025_20-33-05.png", "id": "620641200362359", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391787_620641203695692_1569235066887439397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=avA-3MIfvDcQ7kNvwEsiZe1&_nc_oc=AdkMa4Fdx3ACJuu_MBsqSxtQGY262D13dtVielx9Q99wL1Fw2kn4whZ8-Cs6kgPqr7E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuCG3pOgJ2KJKCGzyKJyxmXYVPUckC-BsX-k9yuHC3-4Q&oe=69A2CE37"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tamarin Lava Escapists VR", "keywords": ["Fun", "Multiplayer", "Free", "Parkour", "Sports"], "long_description": "Tamarin Lava Escapists is an exciting VR game where you play as a tamarin trying to escape rising lava. The game uses gorilla-style locomotion, so you\u2019ll swing, climb, and leap your way through dangerous terrain.\n\nThe world is vibrant and full of challenges, from tricky jumps to intense multiplayer competitions. Every level keeps you on edge as the lava closes in. It\u2019s fast-paced, fun, and really 
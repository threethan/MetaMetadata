jR_RTku6yM75AbanmeJosmhAR3U8hZNO9Ag1cun9pmYR0c_eC5rin6fk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afzf9fsRf9y6pTjDgO4gA0m0NpCS4InVedHm3jDBbi8bDg&oe=69B94437"}, {"file_name": "Game_Custom..._15.01.2025_20-32-37.png", "id": "475145178729103", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391784_475145182062436_862919831143675164_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o16-7LtvHvMQ7kNvwFnqYo8&_nc_oc=AdloYSQ186GOriEnsTuU5aH5xWCgLb3wUUi0fJ-9k3uuK-iyd5H311cl_XnJU1W7Tmw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzFPrrcqXK_2Oblk_GZfFHh2zntIaF6DD5MGB1tD7Yytw&oe=69B94E12"}, {"file_name": "Game_Custom..._15.01.2025_20-32-53.png", "id": "629313416158379", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391791_629313419491712_6764765756323544716_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1AnRLW-vHGoQ7kNvwHoUFPP&_nc_oc=Adl-q7oSrfnjFEs4GoZEqToLK0Mc0CYBDVUQpR2cQhgiGTh6disMPVTlOf5q9TbrI8k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afxa5DaWUEc6Ym4AMRUdr57iMwhGOx2uxt3WY3D0spJ6pw&oe=69B94B14"}, {"file_name": "Game_Custom..._15.01.2025_20-33-05.png", "id": "620641200362359", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391787_620641203695692_1569235066887439397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UmY6PpV_wvkQ7kNvwFnNlFP&_nc_oc=AdlPSMo6JZkDvnVSyBwAK2wGxhVyKsLzA9oDUowLgM6XaC_899LW_v6K__3JjLoHUBw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfywwJe-z-So_u2xJjWLBrshQxPXPfxHciDxx6GW6K0CyA&oe=69B937B7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tamarin Lava Escapists VR", "keywords": ["Fun", "Multiplayer", "Free", "Parkour", "Sports"], "long_description": "Tamarin Lava Escapists is an exciting VR game where you play as a tamarin trying to escape rising lava. The game uses gorilla-style locomotion, so you\u2019ll swing, climb, and leap your way through dangerous terrain.\n\nThe world is vibrant and full of challenges, from tricky jumps to intense multiplayer competitions. Every level keeps you on edge as the lava closes in. It\u2019s fast-paced, fun, and really tests your skills. If you\u2019re up for a challenge and love action-packed VR, this game is for you!", "short_description": "Tamarin Lava Escapists: Dive into a thrilling VR experience where you, as a nimble tamarin, must master gorilla-style locomotion to escape rising lava. Leap, swing, and climb your way to safety in this heart-pounding adventure!"}]}, "developer_name": "SilenceProductions", "developer_privacy_policy_url": "https://sites.google.com/view/tamarin-lava-rush/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SilenceProductions", "support_website_url": null, "website_url": "https://sites.google.com/view/tamarin-lava-rush/start", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8779216282201057"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8872960116160006", "version": "24"}, "id": "1614953829115681", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isApp
zVtUmDCoztWvEk8mTN5pikb5x8XyCHFuTd60Uw&oe=69984EB7"}, {"file_name": "Game_Custom..._15.01.2025_20-32-37.png", "id": "475145178729103", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391784_475145182062436_862919831143675164_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K7uKNOxtlckQ7kNvwGVHe7h&_nc_oc=Adl5RSm7SJtrGjFF5yyIbokcn0E74Ba0GF65gyq5NwMUqRE_FR21jyWZRaZimls8s1Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftUTSD84iWKpfbZTWZ3qCR0SBnmPPQIBKdQIAlg5CYS0g&oe=69985892"}, {"file_name": "Game_Custom..._15.01.2025_20-32-53.png", "id": "629313416158379", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391791_629313419491712_6764765756323544716_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ASDv8X__7MQ7kNvwE_VcHg&_nc_oc=Adm9wf7ET3ofp8-OCF6sWctnMrHckrQ1xrbZSZR1sDBc0-9I4v3pjwNkvetwtn7tQMo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Aft9ueUqkox7Xng21VP00acBCMtLMlAlE6AzFH6Qx4OQoQ&oe=69985594"}, {"file_name": "Game_Custom..._15.01.2025_20-33-05.png", "id": "620641200362359", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391787_620641203695692_1569235066887439397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3W0h-bNYwBsQ7kNvwFWFTyD&_nc_oc=AdlmCIoAD1CX9eXuv5Eaix9JFZ6WI2VwKi-zz0Y3bOvNfGGtLHx90z7Z2soCbWcjjcg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfuKrWCR1neY1c2MR8JMddAGuOgQDUND7ycfu8hPulMnVQ&oe=69984237"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tamarin Lava Escapists VR", "keywords": ["Fun", "Multiplayer", "Free", "Parkour", "Sports"], "long_description": "Tamarin Lava Escapists is an exciting VR game where you play as a tamarin trying to escape rising lava. The game uses gorilla-style locomotion, so you\u2019ll swing, climb, and leap your way through dangerous terrain.\n\nThe world is vibrant and full of challenges, from tricky jumps to intense multiplayer competitions. Every level keeps you on edge as the lava closes in. It\u2019s fast-paced, fun, and really 
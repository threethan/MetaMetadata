nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvkQ5G8Wg_kAIJG024Su25_MhAH7eA1c8kqnFesZ15snw&oe=69A2C66E"}, {"file_name": "Portal.png", "id": "1027773605899127", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392005_1027773609232460_2024107700067943840_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TwH_d9T0bo8Q7kNvwGQZORp&_nc_oc=Adnqk3GBK6xHPBSPIqEX0w8ccTHvcU7qu8uR_3hBz0SzkXJDPoVKG0QRiPoDO3UqY64&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsCuuOnqHZK-lHG0spSit9hn9uHUL6LepGVTu0vyk2hAA&oe=69A2EBD0"}, {"file_name": "TrogreFight.png", "id": "553378541133333", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393997_553378544466666_6453986818650303130_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8y2bAqmJjKMQ7kNvwGxqGr0&_nc_oc=AdkzsXCL3o9C8C8Q7JzQAyekLa2yKShPrNFk6D0igxpQAuEVUpWqo6M_S0f8VcN6wmY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftsUWsoqXcpZRDVq0J6-um08G_coub7OWtcgZKUqiquiQ&oe=69A2FB9F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Tide_Of_Corruption 1440p.png", "id": "1827136234737794", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392005_1827136238071127_6005246994362487329_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LrEpUOaUvtIQ7kNvwFRAe-x&_nc_oc=AdnmsjWxdxbhNegIiM_wpivU3khZTipmOEkL5HAd6rISQwniEzcCCKnJVue3u_4iOzM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuW6-HpViitUYAgc3c_9Fkf7YtaMUgd7nM1YN-z2oLRBA&oe=69A2CFE7"}, "display_name": "Ilysia", "keywords": ["MMORPG", "MMO", "Adventure", "Multiplayer", "RPG"], "long_description": "**Aenor\u2026 once a thriving island, lost to ash and ruin.**\nThe fire elementals, led by the enraged Guardian Bal\u2019Ramos, rose without warning, consuming all in their path. The skies darkened, the land split, and despite the efforts of brave heroes, hope burned away with the flames.\n\nBut not all was lost. A handful of survivors fled, their hearts heavy with loss yet fueled by fragile determination. Through storm and peril, they sought refuge and found it here, in Lavea\u2014a second chance.\n\nWith the kindness of its people and the resilience of their own, the survivors begin anew. But rebuilding comes at a price, for darkness is never truly vanquished. Whispers of ancient power stir beneath the surface, and as new threats rise, so too must new heroes\u2014blade in hand, bow drawn, and spell woven\u2014 to stand against the coming storm and shape the fate of these lands.\n\n**A New World Awaits**\nThe story continues in **Ilysia**, a **VR MMORPG** set in the newly discovered land of Lavea. Picking up after the fall of Aenor, the survivors now strive to reestablish themselves\u2014but new dangers rise to challenge them.\n\n**Venture forth alone or with allies** as you embark on quests, grow in level,  hone your skills, learn new trades, and tackle dangerous challenges as you gain power in an ever-evolving online world. Whether you seek glory in combat, riches through crafting, or the thrill of exploration, your journey is yours to forge.\n\nJoin us in **Early Access** and help shape the future of this evolving world.\n\n\n", "short_description": "Venture forth alone or with allies in a classic high fantasy VR MMORPG as you embark on quests, grow in power, hone your skills, learn new trades, and tackle dangerous challenges as you gain power in the ever-evolving online world of Ilysia!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ilysiavr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Team 21 Studio, Inc", "support_website_url": null, "website_url": "https://ilysiavr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MO
vwG5xh-n&_nc_oc=Adn8amnViGtBOg5ikO-r37uWxK7sIBnqNmNp-CUZBcmMvKhCvFeWhWnqqVY0GY0wXYs&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfwcoL-tD2KfiJKf54Q7PrBSKKfUySq-VU91b-d0mA15GA&oe=69AAE7AE"}, {"file_name": "Portal.png", "id": "1027773605899127", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/473392005_1027773609232460_2024107700067943840_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t2Uebyb0YroQ7kNvwHWXI1Y&_nc_oc=AdlcRiRBuStTQTcHJBeHljJIjFpUckXHMcxexaD3PeM46jrD0VxVxUOB7beNXahUyL4&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_Afz3yqnvEqkhDgo0l_a4Ah6E-01O-8dAbQEU8L_Gv3KzyA&oe=69AAD4D0"}, {"file_name": "TrogreFight.png", "id": "553378541133333", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473393997_553378544466666_6453986818650303130_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vv_uXmNFRw8Q7kNvwH7Ru8l&_nc_oc=AdkSdGX6cD_FHsuEBeX9MiEQFk82qOrtLSzGnEBmjSTrMnuQup5DD5h8aiy4C5IosBc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_Afytn7Yv09mW0SsKh38woc_uVth4FL5Z2hX8ghgABhsktg&oe=69AAE49F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Tide_Of_Corruption 1440p.png", "id": "1827136234737794", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473392005_1827136238071127_6005246994362487329_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iE96WwG8bVgQ7kNvwGf4qHr&_nc_oc=AdnMoqsz3vGk4C9lY6g3E77sVMh0SpdRA8-G2lK-ZbXjXcWwruWwhokTop-Ggol4yJg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzDCvTQWD7N2bwfn7TdANFUGlBWsAHgfFnKgweFcM8dNA&oe=69AAB8E7"}, "display_name": "Ilysia", "keywords": ["MMORPG", "MMO", "Adventure", "Multiplayer", "RPG"], "long_description": "**Aenor\u2026 once a thriving island, lost to ash and ruin.**\nThe fire elementals, led by the enraged Guardian Bal\u2019Ramos, rose without warning, consuming all in their path. The skies darkened, the land split, and despite the efforts of brave heroes, hope burned away with the flames.\n\nBut not all was lost. A handful of survivors fled, their hearts heavy with loss yet fueled by fragile determination. Through storm and peril, they sought refuge and found it here, in Lavea\u2014a second chance.\n\nWith the kindness of its people and the resilience of their own, the survivors begin anew. But rebuilding comes at a price, for darkness is never truly vanquished. Whispers of ancient power stir beneath the surface, and as new threats rise, so too must new heroes\u2014blade in hand, bow drawn, and spell woven\u2014 to stand against the coming storm and shape the fate of these lands.\n\n**A New World Awaits**\nThe story continues in **Ilysia**, a **VR MMORPG** set in the newly discovered land of Lavea. Picking up after the fall of Aenor, the survivors now strive to reestablish themselves\u2014but new dangers rise to challenge them.\n\n**Venture forth alone or with allies** as you embark on quests, grow in level,  hone your skills, learn new trades, and tackle dangerous challenges as you gain power in an ever-evolving online world. Whether you seek glory in combat, riches through crafting, or the thrill of exploration, your journey is yours to forge.\n\nJoin us in **Early Access** and help shape the future of this evolving world.\n\n\n", "short_description": "Venture forth alone or with allies in a classic high fantasy VR MMORPG as you embark on quests, grow in power, hone your skills, learn new trades, and tackle dangerous challenges as you gain power in the ever-evolving online world of Ilysia!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ilysiavr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Team 21 Studio, Inc", "support_website_url": null, "website_url": "https://ilysiavr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "821934236779161"}], "external_su
video_trailer_thumbnail": {"file_name": "Tide_Of_Corruption 1440p.png", "id": "1827136234737794", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473392005_1827136238071127_6005246994362487329_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X4cjxLGnWI8Q7kNvwEaWbQw&_nc_oc=AdqskSjvu-ridJAIFYvFWrz2FjWjX9lqgMTDQuCGSUiZB1SuXah-tBtdoaCw8RRfXIg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8gFiIy-bIK2xsF83gzefRDbor_EJ0F9je_T5TTBYVFHg&oe=6A22E9A7"}, "display_name": "Ilysia", "keywords": ["MMORPG", "MMO", "Adventure", "Multiplayer", "RPG"], "long_description": "**Aenor\u2026 once a thriving island, lost to ash and ruin.**\nThe fire elementals, led by the enraged Guardian Bal\u2019Ramos, rose without warning, consuming all in their path. The skies darkened, the land split, and despite the efforts of brave heroes, hope burned away with the flames.\n\nBut not all was lost. A handful of survivors fled, their hearts heavy with loss yet fueled by fragile determination. Through storm and peril, they sought refuge and found it here, in Lavea\u2014a second chance.\n\nWith the kindness of its people and the resilience of their own, the survivors begin anew. But rebuilding comes at a price, for darkness is never truly vanquished. Whispers of ancient power stir beneath the surface, and as new threats rise, so too must new heroes\u2014blade in hand, bow drawn, and spell woven\u2014 to stand against the coming storm and shape the fate of these lands.\n\n**A New World Awaits**\nThe story continues in **Ilysia**, a **VR MMORPG** set in the newly discovered land of Lavea. Picking up after the fall of Aenor, the survivors now strive to reestablish themselves\u2014but new dangers rise to challenge them.\n\n**Venture forth alone or with allies** as you embark on quests, grow in level,  hone your skills, learn new trades, and tackle dangerous challenges as you gain power in an ever-evolving online world. Whether you seek glory in combat, riches through crafting, or the thrill of exploration, your journey is yours to forge.\n\nJoin us in **Early Access** and help shape the future of this evolving world.\n\n\n", "short_description": "Venture forth alone or with allies in a classic high fantasy VR MMORPG as you embark on quests, grow in power, hone your skills, learn new trades, and tackle dangerous challenges as you gain power in the ever-evolving online world of Ilysia!"}, {"images": {"nodes": []}, "id": "1171121204938353", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ilysia", "keywords": [], "long_description": "Ilysia\u2122 \u306f\u3001Team 21 Studio Inc. \u306b\u3088\u3063\u3066\u4eee\u60f3\u73fe\u5b9f (VR) \u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u5411\u3051\u306b\u958b\u767a\u3055\u308c\u3066\u3044\u308b\u5927\u898f\u6a21\u30de\u30eb\u30c1\u30d7\u30ec\u30a4\u30e4\u30fc \u30aa\u30f3\u30e9\u30a4\u30f3 \u30ed\u30fc\u30eb\u30d7\u30ec\u30a4\u30f3\u30b0 \u30b2\u30fc\u30e0 (MMORPG) \u3067\u3059\u3002", "short_description": "\u521d\u3081\u3066\u306e\u672c\u683c\u7684\u306aVRMMORPG\u3092\u4f53\u9a13\u3057\u3066\u304f\u3060\u3055\u3044"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ilysiavr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Team 21 Studio, Inc", "support_website_url": null, "website_url": "https://ilysiavr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STA
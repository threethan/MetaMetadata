t=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nn-RkFYTYQwQ7kNvwH6bu3a&_nc_oc=AdpRm2kvcZOuvkwBS3HKWRQoQIe_lI2VqTBNVdiJ94Bt0vmiWrr6hrepPtLbKtWLqYI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSXX1sK5hwdIh0mcNVXYCM1OxItt60POhakN66SKkQV8Q&oe=6B0B206E"}, {"file_name": "Portal.png", "id": "1027773605899127", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392005_1027773609232460_2024107700067943840_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vZ4q600Kz0YQ7kNvwH-uhs0&_nc_oc=Adqvq0l-5eeHeC8PAkdvq5aEtw1QvQ1HxrZRoiliFbQCtR__4FWa4azNIvUMzW-fCYE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSf-cX03lZRvrved1a-8gia799p96LCqM7jqKjiBEImDw&oe=6B0B0D90"}, {"file_name": "TrogreFight.png", "id": "553378541133333", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393997_553378544466666_6453986818650303130_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sNhs5_oa5-IQ7kNvwHvY9Zz&_nc_oc=AdqBnQd58cUeeO89pWqsmgMosUZMCp4ew92pNqTkG56SCSWGUlaSND8zWKRDtIzn-Lo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSjWGQreOkJbaZVtiSGdJKTK8cYP3uutRCB6mynoYs72Q&oe=6B0B1D5F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Tide_Of_Corruption 1440p.png", "id": "1827136234737794", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392005_1827136238071127_6005246994362487329_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=79quEqF-pvAQ7kNvwFTbSfS&_nc_oc=AdopBDQsb-OWVUEK1PnzlV-Pkyugtro8iNB6OBTg9fAr-RjKcKX2o0jWBP04pewD57A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRz_EFozTdNfh9Fjr9mdEe3BBqWg1cCCKiURgV94IrAuQ&oe=6B0B29E7"}, "display_name": "Ilysia", "keywords": ["MMORPG", "MMO", "Adventure", "Multiplayer", "RPG"], "long_description": "**Aenor\u2026 once a thriving island, lost to ash and ruin.**\nThe fire elementals, led by the enraged Guardian Bal\u2019Ramos, rose without warning, consuming all in their path. The skies darkened, the land split, and despite the efforts of brave heroes, hope burned away with the flames.\n\nBut not all was lost. A handful of survivors fled, their hearts heavy with loss yet fueled by fragile determination. Through storm and peril, they sought refuge and found it here, in Lavea\u2014a second chance.\n\nWith the kindness of its people and the resilience of their own, the survivors begin anew. But rebuilding comes at a price, for darkness is never truly vanquished. Whispers of ancient power stir beneath the surface, and as new threats rise, so too must new heroes\u2014blade in hand, bow drawn, and spell woven\u2014 to stand against the coming storm and shape the fate of these lands.\n\n**A New World Awaits**\nThe story continues in **Ilysia**, a **VR MMORPG** set in the newly discovered land of Lavea. Picking up after the fall of Aenor, the survivors now strive to reestablish themselves\u2014but new dangers rise to challenge them.\n\n**Venture forth alone or with allies** as you embark on quests, grow in level,  hone your skills, learn new trades, and tackle dangerous challenges as you gain power in an ever-evolving online world. Whether you seek glory in combat, riches through crafting, or the thrill of exploration, your journey is yours to forge.\n\nJoin us in **Early Access** and help shape the future of this evolving world.\n\n\n", "short_description": "Venture forth alone or with allies in a classic high fantasy VR MMORPG as you embark on quests, grow in power, hone your skills, learn new trades, and tackle dangerous challenges as you gain power in the ever-evolving online world of Ilysia!"}, {"images": {"nodes": []}, "id": "1668402785021887", "locale": "ko_KR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ilysia", "keywords": [], "long_description": "Ilysia\u2122\ub294 Team 21 Studio Inc.\uc5d0\uc11c \uac00\uc0c1 \ud604\uc2e4(VR) \ud50c\ub7ab\ud3fc\uc6a9
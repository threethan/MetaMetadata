t=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wpJ09A_cCEMQ7kNvwHxUqll&_nc_oc=AdoadqqouI2XMnXmnnQoyn5lsTvnLNnCdmrV7070j6os8ZO5K82QgCDKA649b6Ao1cs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQp9_YukdsAd0OZYzWsdQQvvZ1rrU4LgMoflpASu4rbqw&oe=6AFB162E"}, {"file_name": "Portal.png", "id": "1027773605899127", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473392005_1027773609232460_2024107700067943840_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7p6oj0BNGnsQ7kNvwEua2Ew&_nc_oc=Adqi9VKfTeog4aA7zG3cSpfkolDF90EyDU-BP0rTDXueDObx8RHzvnLxLRhnG92wclw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8u01bqetgTFxdFKuDrjzwt5BU9A3_HamPAD1_gWmRBQ&oe=6AFB3B90"}, {"file_name": "TrogreFight.png", "id": "553378541133333", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473393997_553378544466666_6453986818650303130_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3WtUKrBXIZ8Q7kNvwFmju6R&_nc_oc=AdqbFfVJLV46MO788kIyc5GvbQE0buAHNgrZ6WZbRNEmjTOoDk3PfRimQsah6eiFlkk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqzAVjqrOHC5toiq9rF6VXsR-zxqsjIu0L33uI3aUfIQ&oe=6AFB4B5F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Tide_Of_Corruption 1440p.png", "id": "1827136234737794", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473392005_1827136238071127_6005246994362487329_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eg-8Ylj2-UAQ7kNvwHWjIVU&_nc_oc=AdoHEsxtRTHI6PxsIEwFGnWQ-b45P4SCzfd4d70VHiPBcdKvJ1yz4SQJMyRs-wxcU9Q&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-DmCTwwbrawga-ab5uR0U8xYosH1mFSHTMY4L62VWRg&oe=6AFB1FA7"}, "display_name": "Ilysia", "keywords": ["MMORPG", "MMO", "Adventure", "Multiplayer", "RPG"], "long_description": "**Aenor\u2026 once a thriving island, lost to ash and ruin.**\nThe fire elementals, led by the enraged Guardian Bal\u2019Ramos, rose without warning, consuming all in their path. The skies darkened, the land split, and despite the efforts of brave heroes, hope burned away with the flames.\n\nBut not all was lost. A handful of survivors fled, their hearts heavy with loss yet fueled by fragile determination. Through storm and peril, they sought refuge and found it here, in Lavea\u2014a second chance.\n\nWith the kindness of its people and the resilience of their own, the survivors begin anew. But rebuilding comes at a price, for darkness is never truly vanquished. Whispers of ancient power stir beneath the surface, and as new threats rise, so too must new heroes\u2014blade in hand, bow drawn, and spell woven\u2014 to stand against the coming storm and shape the fate of these lands.\n\n**A New World Awaits**\nThe story continues in **Ilysia**, a **VR MMORPG** set in the newly discovered land of Lavea. Picking up after the fall of Aenor, the survivors now strive to reestablish themselves\u2014but new dangers rise to challenge them.\n\n**Venture forth alone or with allies** as you embark on quests, grow in level,  hone your skills, learn new trades, and tackle dangerous challenges as you gain power in an ever-evolving online world. Whether you seek glory in combat, riches through crafting, or the thrill of exploration, your journey is yours to forge.\n\nJoin us in **Early Access** and help shape the future of this evolving world.\n\n\n", "short_description": "Venture forth alone or with allies in a classic high fantasy VR MMORPG as you embark on quests, grow in power, hone your skills, learn new trades, and tackle dangerous challenges as you gain power in the ever-evolving online world of Ilysia!"}, {"images": {"nodes": []}, "id": "1668402785021887", "locale": "ko_KR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ilysia", "keywords": [], "long_description": "Ilysia\u2122\ub294 Team 21 Studio Inc.\uc5d0\uc11c \uac00\uc0c1 \ud604\uc2e4(VR) \ud50c\ub7ab\ud3fc\uc6a9
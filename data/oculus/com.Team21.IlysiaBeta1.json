t=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xvT73U2p3rIQ7kNvwG9e9JM&_nc_oc=AdqCQYs5sDSjxZDJ87cRsiN9OU1k3m04stmry37jGa2HdT4UGeD-5pU3pDJTFOqJ3AI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5xCUZ-d7W8IRslftUvOA8kDKzMnouKLn2BsB0F27qEA&oe=6AFDB92E"}, {"file_name": "Portal.png", "id": "1027773605899127", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392005_1027773609232460_2024107700067943840_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=snkR_ox8RYgQ7kNvwFv9EaC&_nc_oc=Adqvum9DghhpYq7Iwo7cLmuhbxkr8_2RpDkCdsmBQvthWW41b152We202jFu8pDlIBk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSnLXNeRaBTtAeAoDfO2Qx1ySj9Cl-oln7cbfGeBW8QGw&oe=6AFDDE90"}, {"file_name": "TrogreFight.png", "id": "553378541133333", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393997_553378544466666_6453986818650303130_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3WtUKrBXIZ8Q7kNvwExb2at&_nc_oc=AdpXnBirKBOv0bDhsFJUFHhCA9z37Q616YbGPxL5fslQlDtt7VUjz1_H_laq5ZE1ML8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRi87NYjDY5e__KigYEyc2vRrisSgbkYu_3Hg1pPsJpsA&oe=6AFDB61F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Tide_Of_Corruption 1440p.png", "id": "1827136234737794", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392005_1827136238071127_6005246994362487329_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eg-8Ylj2-UAQ7kNvwFl4LOY&_nc_oc=AdoCBy7t19Rxj9wrG6g5Wy8DDRt0RBwKYxwGcJ0s29ogObUNYSzyhx3tQ1bhkd9G0EM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAL8z7JvNMn-omRgnEVuk0-ASK06oQH8xCq0zvDFqJWw&oe=6AFDC2A7"}, "display_name": "Ilysia", "keywords": ["MMORPG", "MMO", "Adventure", "Multiplayer", "RPG"], "long_description": "**Aenor\u2026 once a thriving island, lost to ash and ruin.**\nThe fire elementals, led by the enraged Guardian Bal\u2019Ramos, rose without warning, consuming all in their path. The skies darkened, the land split, and despite the efforts of brave heroes, hope burned away with the flames.\n\nBut not all was lost. A handful of survivors fled, their hearts heavy with loss yet fueled by fragile determination. Through storm and peril, they sought refuge and found it here, in Lavea\u2014a second chance.\n\nWith the kindness of its people and the resilience of their own, the survivors begin anew. But rebuilding comes at a price, for darkness is never truly vanquished. Whispers of ancient power stir beneath the surface, and as new threats rise, so too must new heroes\u2014blade in hand, bow drawn, and spell woven\u2014 to stand against the coming storm and shape the fate of these lands.\n\n**A New World Awaits**\nThe story continues in **Ilysia**, a **VR MMORPG** set in the newly discovered land of Lavea. Picking up after the fall of Aenor, the survivors now strive to reestablish themselves\u2014but new dangers rise to challenge them.\n\n**Venture forth alone or with allies** as you embark on quests, grow in level,  hone your skills, learn new trades, and tackle dangerous challenges as you gain power in an ever-evolving online world. Whether you seek glory in combat, riches through crafting, or the thrill of exploration, your journey is yours to forge.\n\nJoin us in **Early Access** and help shape the future of this evolving world.\n\n\n", "short_description": "Venture forth alone or with allies in a classic high fantasy VR MMORPG as you embark on quests, grow in power, hone your skills, learn new trades, and tackle dangerous challenges as you gain power in the ever-evolving online world of Ilysia!"}, {"images": {"nodes": []}, "id": "1668402785021887", "locale": "ko_KR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ilysia", "keywords": [], "long_description": "Ilysia\u2122\ub294 Team 21 Studio Inc.\uc5d0\uc11c \uac00\uc0c1 \ud604\uc2e4(VR) \ud50c\ub7ab\ud3fc\uc6a9
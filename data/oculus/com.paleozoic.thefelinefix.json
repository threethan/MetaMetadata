}, {"file_name": "Render1.png", "id": "1658310578465026", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823259_1658310581798359_8575749907328681695_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VyYMVcosqxYQ7kNvwHcZRS-&_nc_oc=AdqKcnbckpydkhehkBhJv2bz3BsF4xjJS23rsxvolFAY4wJYXpHvBdvmoJszgTEdSYo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBTSkTsrY6NmksWUgrReiHfUSjyCd0fZF5K7E2e9VZXw&oe=6AFDBC24"}, {"file_name": "Render5.png", "id": "1526297525087780", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823286_1526297528421113_5709963515349434364_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cRBpg7gRruoQ7kNvwH2qwCt&_nc_oc=AdoCBeCCMQDEwS8FwymLl75L_g-M9oS_DUCUNEFFTBPjq6IRsUOA9kfCFtIoskthP8E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4sQO6L0B_LQ-hrOxE8qRPPY9qC7xYuJ8CSqAu5w-hUg&oe=6AFDB3CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumb-trailer-meta-updated.png", "id": "1504894064108808", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821674_1504894067442141_7161420984443460778_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DjIrsgrDtokQ7kNvwFFEcT1&_nc_oc=AdotO-8JxNgY637H-jShdLjHwPqtZdj5XnVjnj1FIzqiBIKQftSlYwHIdqZhIo2FyWA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXRXAdwjyVOSOSu286V6-CGi5Nn0an8yzORvzQv1G7Mw&oe=6AFDBFAA"}, "display_name": "Dark Ride: The Feline Fix", "keywords": [], "long_description": "Dark Ride: The Feline Fix is a small, self-contained VR experience set inside an atmospheric potion shop. It\u2019s a relaxed scavenger hunt where you interact with objects, search for ingredients, and piece together a cure for a curious village-wide transformation.\n\nIt\u2019s great for families and encourages relaxed exploration and hands-on discovery. The cozy, detailed shop is made for players of all ages to poke around at their own pace, encouraging curiosity and shared moments. With gentle progression and tactile interactions, it\u2019s the kind of game that invites everyone to play together.\n\nWhether you're new to VR, want to get your kids involved, or just looking for something low-key, The Feline Fix offers a calm space to explore and experiment.", "short_description": "The Feline Fix is the first cozy adventure in the Dark Ride universe. Step into a magical potion shop tucked within the park and help reverse a curious curse that has turned an entire village into cats! \n\nIt\u2019s a relaxing scavenger hunt filled with charm, curiosity, and feline mischief."}]}, "developer_name": null, "developer_privacy_policy_url": "https://presskit.paleozoic.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Paleozoic", "support_website_url": null, "website_url": "http://paleozoic.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32928456630086115"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821796_834003299131655_5507773504898000044_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JiUO2ds3saIQ7kNvwGfrqEg&_nc_oc=Adpwr-LlFAluAuDFUHoRWQE-tYpZDnDO3WKlZNlFeuC1FVrF1w_8BbADgVgGgz_-a3A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss
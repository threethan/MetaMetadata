&oe=6AAE861B"}, {"file_name": "FF_03.png", "id": "674164555744161", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491823930_674164562410827_3020584129887541114_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hBxfCtsxOcQQ7kNvwEA_ntC&_nc_oc=AdrFz8rWI8jTrLz8nFJHJX0IH_42fPrZtw7JRmcZ1tKO2MktRWROEqd6bpE6rbk-BXY&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKDd2s-jX1udmsKRZKTQ0n2JDwxrbQPtmThL0ZjyxX6AQ&oe=6AAEA5BF"}, {"file_name": "FF_04.png", "id": "789178917319518", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491825575_789178920652851_8124900447737097706_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DPyz-LK9P0IQ7kNvwErzhnW&_nc_oc=AdoU0SC47-Gz5CzWlcyqb12vHttgU41sA6bc6M7dOpjvSY15AWO2n6mU2Xw66QhJQdE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITe7kPt7nd99K12b-BUbykf3Md6hwcJVyKRpgrIjCAUg&oe=6AAE81BD"}, {"file_name": "FF_05.png", "id": "1175629674468417", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491821702_1175629677801750_1149555054139307933_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KmWHunZQ--AQ7kNvwGLpYlc&_nc_oc=Adr7K3FBEMoGUNXzzBWDM9gRx-SjSkLXIQThbx92F5bkPmGLKd3rEDO_9x6UcoPdoiE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLiZO-HK8eKNaXnQKxGGNngAafbAtpQbT7Zuazfz4_iIA&oe=6AAE992E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FF_Trailer_thumb_00765.png", "id": "24620049241012219", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491825563_24620049254345551_3519292868688768884_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QbNbzwg4NokQ7kNvwGT8s_C&_nc_oc=AdpKB0HLEov4o-UUzZSgw2fL-DYlAc7nERhzcbXRRzznpibgGEc7hCBShsSyzaVZ4yk&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIkIrEEyNgNNmBP6W6jbdQm_nU0dZsM9aP-7YHGo3g7CQ&oe=6AAE7E60"}, "display_name": "Dark Ride: The Feline Fix", "keywords": [], "long_description": "Dark Ride: The Feline Fix is a small, self-contained VR experience set inside an atmospheric potion shop. It\u2019s a relaxed scavenger hunt where you interact with objects, search for ingredients, and piece together a cure for a curious village-wide transformation.\n\nIt\u2019s great for families and encourages relaxed exploration and hands-on discovery. The cozy, detailed shop is made for players of all ages to poke around at their own pace, encouraging curiosity and shared moments. With gentle progression and tactile interactions, it\u2019s the kind of game that invites everyone to play together.\n\nWhether you're new to VR, want to get your kids involved, or just looking for something low-key, The Feline Fix offers a calm space to explore and experiment.", "short_description": "The Feline Fix is the first cozy adventure in the Dark Ride universe. Step into a magical potion shop tucked within the park and help reverse a curious curse that has turned an entire village into cats! \n\nIt\u2019s a relaxing scavenger hunt filled with charm, curiosity, and feline mischief."}]}, "developer_name": null, "developer_privacy_policy_url": "https://presskit.paleozoic.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Paleozoic", "support_website_url": null, "website_url": "http://paleozoic.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32644000025198445"}}]}, "scheduled_offers": {"count": 2, "nodes
}, {"file_name": "Render1.png", "id": "1658310578465026", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823259_1658310581798359_8575749907328681695_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nMbswpnCTlgQ7kNvwEuoqmA&_nc_oc=AdrmxdfPidSZ4_2TPelaKJoOdztiXRd_KcAjO59oF44Ds_EI474e3l5HlXF-mO0WqYc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQaL9L1MNyxRj6qhGWbc36zTe7BfAtv9zHF-vDY3ANc9Q&oe=6AFB1924"}, {"file_name": "Render5.png", "id": "1526297525087780", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823286_1526297528421113_5709963515349434364_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cRBpg7gRruoQ7kNvwFD54Q-&_nc_oc=AdqkeKwDq3aDXd6nhobxKSbTfAkg4Uv8TOAOtlnhobVuGMLkbYyUFAIut781eR_rKSc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKfKypO_LpBWdADwUu-zWuHsVcgCQc_idAbygmpQW-qw&oe=6AFB490D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumb-trailer-meta-updated.png", "id": "1504894064108808", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491821674_1504894067442141_7161420984443460778_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DjIrsgrDtokQ7kNvwFS2lGR&_nc_oc=AdpP37po9lpuqLW_yOrLOMCEi7KPWhEedMwsAf6nDkAUB__ZZBM0fW-WAoJkNnX9Axs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRheozaimVLQ7O53IZ7Ptb8aBTGIRuge-V3bfSdVxj_Zw&oe=6AFB1CAA"}, "display_name": "Dark Ride: The Feline Fix", "keywords": [], "long_description": "Dark Ride: The Feline Fix is a small, self-contained VR experience set inside an atmospheric potion shop. It\u2019s a relaxed scavenger hunt where you interact with objects, search for ingredients, and piece together a cure for a curious village-wide transformation.\n\nIt\u2019s great for families and encourages relaxed exploration and hands-on discovery. The cozy, detailed shop is made for players of all ages to poke around at their own pace, encouraging curiosity and shared moments. With gentle progression and tactile interactions, it\u2019s the kind of game that invites everyone to play together.\n\nWhether you're new to VR, want to get your kids involved, or just looking for something low-key, The Feline Fix offers a calm space to explore and experiment.", "short_description": "The Feline Fix is the first cozy adventure in the Dark Ride universe. Step into a magical potion shop tucked within the park and help reverse a curious curse that has turned an entire village into cats! \n\nIt\u2019s a relaxing scavenger hunt filled with charm, curiosity, and feline mischief."}]}, "developer_name": null, "developer_privacy_policy_url": "https://presskit.paleozoic.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Paleozoic", "support_website_url": null, "website_url": "http://paleozoic.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32928456630086115"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491821796_834003299131655_5507773504898000044_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JiUO2ds3saIQ7kNvwFmlPWH&_nc_oc=AdoPqmwenXW7F2WMJ2HQmAZPT5jiGeHqzvlitVv1yhViOVyvUFHVogMJIlS4FtHhPlY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss
c_ohc=-rWm78uwCJUQ7kNvwGsl_7c&_nc_oc=AdrjlN3JI3fsdRm6LfXie9MFu41riTyiMPFf_ZRwbfX9Vq761_RcXAPjpMj9L_s-fj0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJu7z5n0K9cBa1kJOD6OmFuhcsPrEXsOXZcla8R8AHTWg&oe=6AB3E824"}, {"file_name": "Render5.png", "id": "1526297525087780", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823286_1526297528421113_5709963515349434364_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4tRZWG0mTlIQ7kNvwE6A1Iy&_nc_oc=Adoit-riba2Cfhova1o9TbtsCRyM4m8DhxGJQUtqgE3ZwgnMRl-hesR0veHjiBdeSQY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKN9pohY2JcMCCdhbtDGtUu_Y8uW80jYeG5h9OMG_L2gg&oe=6AB3DFCD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumb-trailer-meta-updated.png", "id": "1504894064108808", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821674_1504894067442141_7161420984443460778_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ga4LPLbVr6sQ7kNvwHiEbCd&_nc_oc=Adp8haxlKrlyCZyVIvdTM52UrLjrENrtkAyx0Pm6wzGsPcqnB8P5ZySx6IRrY-TVB-Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSVNpCjvvsKv9ekS4iJVv0g4A_ASDU5uZTDLOR0ZQxJg&oe=6AB3EBAA"}, "display_name": "Dark Ride: The Feline Fix", "keywords": [], "long_description": "Dark Ride: The Feline Fix is a small, self-contained VR experience set inside an atmospheric potion shop. It\u2019s a relaxed scavenger hunt where you interact with objects, search for ingredients, and piece together a cure for a curious village-wide transformation.\n\nIt\u2019s great for families and encourages relaxed exploration and hands-on discovery. The cozy, detailed shop is made for players of all ages to poke around at their own pace, encouraging curiosity and shared moments. With gentle progression and tactile interactions, it\u2019s the kind of game that invites everyone to play together.\n\nWhether you're new to VR, want to get your kids involved, or just looking for something low-key, The Feline Fix offers a calm space to explore and experiment.", "short_description": "The Feline Fix is the first cozy adventure in the Dark Ride universe. Step into a magical potion shop tucked within the park and help reverse a curious curse that has turned an entire village into cats! \n\nIt\u2019s a relaxing scavenger hunt filled with charm, curiosity, and feline mischief."}]}, "developer_name": null, "developer_privacy_policy_url": "https://presskit.paleozoic.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Paleozoic", "support_website_url": null, "website_url": "http://paleozoic.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32928456630086115"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821796_834003299131655_5507773504898000044_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g-qxPKxYl8IQ7kNvwHnZ8UR&_nc_oc=AdojELKX7z0KUFfftoPbyqFXg0uxnjJ0vb0CGJ98jI1ePWkMiAo-wo4o8z4NOAABY4A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJThEekoDxEaN2ebdp10X2if13Z1C9fGZmq49fNembaQg&oe=6AB3D873"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Dark Ride: The Feline Fix", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics":
30_674164562410827_3020584129887541114_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hUnKdvGrn_cQ7kNvwEXxjjK&_nc_oc=AdopDpblXapNxCoUmBSshvNM4Ft59zosQB2mrST0UZDNuV0sp_D22jnEDEozBA-3fDQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD0TtYlidsshTKc1Xy47omWT5Bw_m1HCbA5xj3VM0vzMg&oe=6A4A73BF"}, {"file_name": "FF_04.png", "id": "789178917319518", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491825575_789178920652851_8124900447737097706_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x_95d3DDJecQ7kNvwG_WdTS&_nc_oc=Adq-4io_0YMjWremukH7N6ef0jo4-edkuGQuZiffVW_MmHppnbvz5_-fcOvxDlwjBXw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAQgJyokDCyqhUoRTjXRB6HXdVjgkwN4unlJ-DwsnPIyg&oe=6A4A87FD"}, {"file_name": "FF_05.png", "id": "1175629674468417", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821702_1175629677801750_1149555054139307933_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AjEWVEuaW6cQ7kNvwFxL1Gt&_nc_oc=AdrDR9uuk45uS7JCz9WY20w6YDUfSE3RBrU6ctuceewljbyjYVsH0DgNsOBrSQTj-tE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAoNFNeE8KwRGqJXswFkkrUYBqrWWDVtwwYMi8QSpSM4A&oe=6A4A672E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FF_Trailer_thumb_00765.png", "id": "24620049241012219", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825563_24620049254345551_3519292868688768884_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SNAWqywPlAgQ7kNvwHnjnPt&_nc_oc=AdpeGChk5jsf5coj-D9--BaWCjHg8wPTD5kvSx-tXSg7G-i6TRiQxTXh34mWvz3m5XU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDoJLw_lwJYDHWc5EXP7P6LnsreznnPOx2lWlhVDVU_Tg&oe=6A4A84A0"}, "display_name": "Dark Ride: The Feline Fix", "keywords": [], "long_description": "Dark Ride: The Feline Fix is a small, self-contained VR experience set inside an atmospheric potion shop. It\u2019s a relaxed scavenger hunt where you interact with objects, search for ingredients, and piece together a cure for a curious village-wide transformation.\n\nIt\u2019s great for families and encourages relaxed exploration and hands-on discovery. The cozy, detailed shop is made for players of all ages to poke around at their own pace, encouraging curiosity and shared moments. With gentle progression and tactile interactions, it\u2019s the kind of game that invites everyone to play together.\n\nWhether you're new to VR, want to get your kids involved, or just looking for something low-key, The Feline Fix offers a calm space to explore and experiment.", "short_description": "The Feline Fix is the first cozy adventure in the Dark Ride universe. Step into a magical potion shop tucked within the park and help reverse a curious curse that has turned an entire village into cats! \n\nIt\u2019s a relaxing scavenger hunt filled with charm, curiosity, and feline mischief."}]}, "developer_name": null, "developer_privacy_policy_url": "https://presskit.paleozoic.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Paleozoic", "support_website_url": null, "website_url": "http://paleozoic.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32644000025198445"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1596413214684846"}, {"status": "PUBLISHED", "id": "837114208951007"}]}, "baseline_offer": {"id": "83
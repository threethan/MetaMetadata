c_ohc=HDRP7qbbptIQ7kNvwEFrRh1&_nc_oc=AdqNqhXQgIJUWs7z8DdcZbc9_dPZ3i7Oz1Gr9P7MtC5G8fFrPlxhQC3PqYEj_SdWIn8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPWHzIrEFoF-OwWv9QiQMvZVG_Zt6hgXeCCDUMQ9MW6FA&oe=6AD0E924"}, {"file_name": "Render5.png", "id": "1526297525087780", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823286_1526297528421113_5709963515349434364_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HkGTnjhqC5IQ7kNvwF5qIPK&_nc_oc=Adpr_92y-Xag8W_p2h_avo7JYKTBF2Rcl7z5VxiOVNIRKrO4rzNYhRlmhhC3_QkfDgU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM26DVxvj1NB-ojHNXw3TnZjYG6VS2Vdiyn5YuXpGl0Lw&oe=6AD0E0CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumb-trailer-meta-updated.png", "id": "1504894064108808", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491821674_1504894067442141_7161420984443460778_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FnDVblTzFLcQ7kNvwFBVlKp&_nc_oc=AdpohchcwumgGafCGxO_J6xevzAh68LzuwZwXJsB-vXEAXEo67KcM67RY6LDV4-f5bw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPj82-rrkoFuKcFkJWFEQ3wc6uApWn4hdANWvoODN2A6A&oe=6AD0ECAA"}, "display_name": "Dark Ride: The Feline Fix", "keywords": [], "long_description": "Dark Ride: The Feline Fix is a small, self-contained VR experience set inside an atmospheric potion shop. It\u2019s a relaxed scavenger hunt where you interact with objects, search for ingredients, and piece together a cure for a curious village-wide transformation.\n\nIt\u2019s great for families and encourages relaxed exploration and hands-on discovery. The cozy, detailed shop is made for players of all ages to poke around at their own pace, encouraging curiosity and shared moments. With gentle progression and tactile interactions, it\u2019s the kind of game that invites everyone to play together.\n\nWhether you're new to VR, want to get your kids involved, or just looking for something low-key, The Feline Fix offers a calm space to explore and experiment.", "short_description": "The Feline Fix is the first cozy adventure in the Dark Ride universe. Step into a magical potion shop tucked within the park and help reverse a curious curse that has turned an entire village into cats! \n\nIt\u2019s a relaxing scavenger hunt filled with charm, curiosity, and feline mischief."}]}, "developer_name": null, "developer_privacy_policy_url": "https://presskit.paleozoic.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Paleozoic", "support_website_url": null, "website_url": "http://paleozoic.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32928456630086115"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491821796_834003299131655_5507773504898000044_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Y_Vy0cDEssQ7kNvwHtagW7&_nc_oc=AdpzpeNyD5SF-dmz73Mpq9D0bUw-vC0AVYqsiNfsMLvX8k_P-wCkYoKSV5B0_QKx1xg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPn75xgFMkbcqNzHjM0_YTaHhvsQukLCOGy7nzl2W1ZMw&oe=6AD0D973"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Dark Ride: The Feline Fix", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics":
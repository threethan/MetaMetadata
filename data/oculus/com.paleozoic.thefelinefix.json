}, {"file_name": "Render1.png", "id": "1658310578465026", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491823259_1658310581798359_8575749907328681695_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VyYMVcosqxYQ7kNvwGrQxoT&_nc_oc=AdpGojYN8kxY7NiYB65FWsbL4j_QBRdoIXUIsxVnGRZUnhJ1tozZv2duNobRfKf9OGY&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2Zoijx4l_fjwTp-aTU9lIBPQ-oiykoyEEChkiFjLdOQ&oe=6AFF0DA4"}, {"file_name": "Render5.png", "id": "1526297525087780", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823286_1526297528421113_5709963515349434364_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2pJNcSC4B_wQ7kNvwEObbUj&_nc_oc=Adp4y1n45TQksMknRrFtPgZI0Uzcgym6M451paXgV7wzbcEeBdF3tZ5m-JsTubsRS3Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQE58_fjrkbhuMhXqG3zzGaoPIR45PpRXS8Fx__ATkB6g&oe=6AFF054D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumb-trailer-meta-updated.png", "id": "1504894064108808", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821674_1504894067442141_7161420984443460778_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TCee-H4IMOMQ7kNvwHDk7j4&_nc_oc=AdqRT2q_fye7Sbykv6zX5O_s3wu8iFVH3NAnK9fCBkbCd3WKZH-48dqHrrNgp6PvSVI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoBiekPf2m_GmVf8w47iTkpDwEnknGz6QjCrAhRIrVJA&oe=6AFF112A"}, "display_name": "Dark Ride: The Feline Fix", "keywords": [], "long_description": "Dark Ride: The Feline Fix is a small, self-contained VR experience set inside an atmospheric potion shop. It\u2019s a relaxed scavenger hunt where you interact with objects, search for ingredients, and piece together a cure for a curious village-wide transformation.\n\nIt\u2019s great for families and encourages relaxed exploration and hands-on discovery. The cozy, detailed shop is made for players of all ages to poke around at their own pace, encouraging curiosity and shared moments. With gentle progression and tactile interactions, it\u2019s the kind of game that invites everyone to play together.\n\nWhether you're new to VR, want to get your kids involved, or just looking for something low-key, The Feline Fix offers a calm space to explore and experiment.", "short_description": "The Feline Fix is the first cozy adventure in the Dark Ride universe. Step into a magical potion shop tucked within the park and help reverse a curious curse that has turned an entire village into cats! \n\nIt\u2019s a relaxing scavenger hunt filled with charm, curiosity, and feline mischief."}]}, "developer_name": null, "developer_privacy_policy_url": "https://presskit.paleozoic.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Paleozoic", "support_website_url": null, "website_url": "http://paleozoic.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32928456630086115"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821796_834003299131655_5507773504898000044_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a5qhosbvVO4Q7kNvwFpWw5R&_nc_oc=AdpSbW0T7O4GK24OgpKMzvfLfNKog7HhsDU26HgeovFHi-xyjuZH4SQErV8UdR5qh2U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss
ttps://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/595119480_1098028129289933_294949350657951788_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nv55bZs4G1kQ7kNvwEuN0Fk&_nc_oc=Adrc1gvjLDRBnytkm7GSlOwMV92bY6DOyqmOZcs5BWTZ7OsSawuEJ2-WlHrwC82nT_I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrhv9c9Jq6uqWtsYYSCuCun3AOjJx_e61H5TE8jCdMFQ&oe=6AEB4203"}, {"file_name": "screenshot_2_2560x1440.png", "id": "1393047396363371", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604360590_1393047399696704_8597693260695399463_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QztaMcOgX_YQ7kNvwHJIGID&_nc_oc=Adp_JEfCZkUAHQXoPIb9XyyyTdf2zolLRnmmKlgTZEzagwOa2HPzpEX4lLVN2khSBcg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS30Hii2OeSmShSRNJsWmO8pjg2GvMUCKyfifsZjkVolQ&oe=6AEB3128"}, {"file_name": "screenshot_1_2560x1440.png", "id": "1741692120453023", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/595119480_1741692123786356_6617097243213404065_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-duOBfM816AQ7kNvwEY-CE5&_nc_oc=Adrp1S3MIxYK9Quemha4HmnxDCRs2_qCPdmckstScAnAfgmJxk40BlUA19uYOO71XjI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREmOqeXHTOCUft1nQBcDp0JyaEy23EaH8H8nPhs9OTYg&oe=6AEB2E04"}, {"file_name": "screenshot_3_2560x1440.png", "id": "1560311371941872", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/673645340_1560311375275205_3909121907427628318_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a_lrV17TNZYQ7kNvwHzRf-P&_nc_oc=AdpQZQYedJQYsW3at1E3AgxMXJMaB9Bjxqhx5Aqe8-RXcDd7gH4mXqB9Ouab1fsPDzI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSclknoGSEhkzCyer-8JyzM3C4dFeHbqkrrvr-djmD2iQ&oe=6AEB5BB9"}, {"file_name": "screenshot_4_2560x1440.png", "id": "2540610559734387", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830576_2540610563067720_5281925024615917734_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IywrB73JZLAQ7kNvwFByNxE&_nc_oc=AdomxD9vMqfCmwKkiJVd0YSFoVWmLDZnFpORcmt1juuYZV_MRBW9kq5VTzo1T4FgwLI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQspx1EJiS4LBxAfHfbap6wPXgMRhc5gf4moX4ND61jbw&oe=6AEB4DC7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "1600964954668398", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673531334_1600964958001731_1479177217088999868_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0oB5N0jU1_MQ7kNvwGKgnjN&_nc_oc=AdrOhif3gohMRCpk4-kdB2pHLCWuny6sGEg5bHqTC9h6XsJVe7EA0LlzvPIxBqymZWg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT44gr_bPolXEo1DUCOGk_9iyKUpNViwwD05KKFEa2e8Q&oe=6AEB4903"}, "display_name": "Art Studio 2", "keywords": ["art", "painting", "paint", "canvas", "graffiti"], "long_description": "A calm painting studio for Meta Quest - and this time the view is yours to choose.\n\nEIGHT VIEWS, ONE CONSOLE\nA brushed steel console on the balcony, two arrow pads. Touch one and the world beyond the rail changes: a Miami sunset, a sky on fire, a secluded beach, sunrise over the sea, Venice at dusk, a city skyline, a night lagoon, a neon harbour. Not a picture swap - every view carries its own light, so the sun moves across your floor and at night the studio lamps take over. Paint by the late sun, switch to midnight, keep painting.\n\nPAINT FOR REAL\nDip a brush in a blob of paint, a tube or the palette, press it to the canvas and paint. No buttons, no menus. Press harder for a wider stroke, dip into another colour and the two mix, rinse in the jar or wipe it on the rag.\n\nFIVE EASELS, FIVE BRUSHES\nTwo in the window light, a big canvas and another in the gallery room, and a plein-air easel on the balcony facing your view. Twelve artist colours at each, brushes from a fine detail tip to a 40 mm flat.\n\nSPRAY PAINT\nEight cans on a cart by the balcony door. Close for a sharp line, back off for a soft fog.\n\nKEEP WHAT YOU MAKE\nEvery canvas saves itself. Touch SAVE on the easel tray and the painting goes to your headset gallery, ready to share to your phone. Press Y for a photo of whatever you are looking at.\n\nOil paintings on the walls, a worktable of tubes and brushes, a vintage radio playing jazz, and the sea through the door.\n\nDeveloped and published by Citiview Studios.", "short_description": "The painting studio from Art Studio, with the view in your hands. Step onto the balcony, touch the arrows on the steel console, and the world outside the glass changes - a Miami sunset, a sky on fire, a quiet beach at first light, Venice, a city at dusk, a night lagoon, a neon harbour. The light in the studio changes with it. Five easels, twelve colours, five brushes and eight spray cans, and everything you paint saves itself."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/artstudio2/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/artstudio2/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1334730716386458"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491831299_1960790841265752_8937121371023047074_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N30ESVFgL3sQ7kNvwFW91mU&_nc_oc=AdoMkNKRA
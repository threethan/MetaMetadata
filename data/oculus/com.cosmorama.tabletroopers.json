cketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XLiWQHxom0UQ7kNvwGxHjFI&_nc_oc=Adrn_zK88U2Qiqt9zci7plSSnekpueGowgDfO_YtHxk0T2MEid2pDnIj2TSVkR01joY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5GADj6O4-IXt9YzukZ0UR2SLgsMi3O5aI5ZDXkdXctg&oe=6AFF164A"}, {"file_name": "Screenshot 5-Final.png", "id": "2718600405006564", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473394054_2718600411673230_7133968939023540462_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bre0h8HdwcwQ7kNvwGfNrmY&_nc_oc=AdotJzUtwj0-EZ0Mx5Tu6rl9rmVfN9G4a2TaM-1uB_l4fUZq8n_-7Q8mSD5hM33HEjY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT23glTIpTSDVVBmrpGP37bm2cNkeetuf5VeC7zjUcJBg&oe=6AFF371C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerTitle.png", "id": "1179341110591709", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/473391991_1179341113925042_2958718812083555142_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nNMMWJkZqXwQ7kNvwEwe6Ti&_nc_oc=Adqzl9h_HuQaTDkhl4RhlcUR-n9VbQBfal5yKMpLQI2mVau0JUuRwdWZTJpMFo4f3Ag&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNDTM0u56g79C15VrPv6jNW6yIn1Ok2lUx3V5SIwN8nQ&oe=6AFF0646"}, "display_name": "Table Troopers", "keywords": [], "long_description": "**Table Troopers** transforms your space into a tactical battlefield with mixed reality, blending physical and virtual worlds. Command quirky characters using intuitive hand-tracking or controllers in turn-based combat on destructible battlefields. Strategize with friends locally or virtually, and master physics-based weapons where wind, angles, and the environment affect every shot. Enjoy hilarious mishaps, epic victories, and unpredictable outcomes with a wild arsenal of gadgets. Perfect for social gatherings, it offers strategic depth and accessibility for all players\u2014casual or competitive. \n\n# Key Features:\n- **Mixed Reality**: A dynamic battlefield merges your room with the virtual world.\n- **Controls**: Hand-tracking or controllers for natural interaction.\n- **Tactical Combat**: Turn-based strategy with physics-driven chaos and destructible environments.\n- **Multiplayer**: Play with friends in-person or online.\n- **Fun Moments**: Laugh-out-loud mishaps and epic wins.\n- **Depth**: Resource management and tactical planning.", "short_description": "Table Troopers is a mixed reality multiplayer game that transforms your table into a battleground, combining turn-based tactical depth with hands-on physics based action."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.cosmorama.com/privacy-policy-3/", "developer_terms_of_service_url": null, "publisher_name": "COSMORAMA", "support_website_url": null, "website_url": "https://www.cosmorama.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "9605495966155165"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "2154734448762586"}, {"status": "PUBLISHED", "id": "1072663145734771"}, {"status": "PUBLISHED", "id": "995427363238761"}, {"status": "PUBLISHED", "id": "1761371005245855"}, {"status": "CANCELLED", "id": "4459163434361029"}, {"status": "PUBLISHED", "id": "870517512490139"}, {"status": "PUBLISHED"
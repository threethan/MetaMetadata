and tactical planning.", "short_description": "Table Troopers is a mixed reality multiplayer game that transforms your table into a battleground, combining turn-based tactical depth with hands-on physics based action."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.cosmorama.com/privacy-policy-3/", "developer_terms_of_service_url": null, "publisher_name": "COSMORAMA", "support_website_url": null, "website_url": "https://www.cosmorama.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "9605495966155165"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "2154734448762586"}, {"status": "PUBLISHED", "id": "1072663145734771"}, {"status": "PUBLISHED", "id": "995427363238761"}, {"status": "PUBLISHED", "id": "1761371005245855"}, {"status": "CANCELLED", "id": "4459163434361029"}, {"status": "PUBLISHED", "id": "870517512490139"}, {"status": "PUBLISHED", "id": "2056932298405589"}, {"status": "PUBLISHED", "id": "1341406733644235"}, {"status": "PUBLISHED", "id": "761621543242415"}, {"status": "PUBLISHED", "id": "764780432861997"}]}, "baseline_offer": {"id": "764780432861997"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "2154734448762586"}]}, "liveChannel
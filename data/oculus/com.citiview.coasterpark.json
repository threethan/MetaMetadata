358142241462", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499624069_1139358145574795_8328668420658455468_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N9808E3qKZUQ7kNvwGqwPAW&_nc_oc=Adp-_Gye7knKoyhWUNv43NrwPe42GFL29QDIAA5hBVkKbAYiRDNPR9DWNpC-96LbBsw&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSveDbiijJjDu29rm7WfCTZwxGpBIMn6vTGb7GsBM1SEw&oe=6AFF1C07"}, {"file_name": "screenshot_4_2560x1440.png", "id": "1119407203764168", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620403_1119407207097501_5213777367254568264_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=70GYvQxj75EQ7kNvwEd3kOF&_nc_oc=AdrFh_Ojs2zwwMOdwhqQYG6DQDAB2rQ6AUxX-u-WHBIkwzOE1epVl9thBjAiBz8uXbM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKjZUOppvIYhM5Zxi65yx2uZl9sBhzSIP5W6_xjmrHPQ&oe=6AFF1EE5"}, {"file_name": "screenshot_5_2560x1440.png", "id": "1999169717243226", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/593776279_1999169720576559_7384827178036950513_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=99m46b1mdRUQ7kNvwEpW2nW&_nc_oc=AdqhtRsxwTWe4HtmLrCTPJiIr_Upk86V7zmXWbXkqWmtrzD9meVwh0sncLO_K2yuAPE&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgvSWU_DsiMRbp3zyvfBgv8WEslyopzKM1tlRj5WdJ8g&oe=6AFF162C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "2425403517988154", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619602_2425403521321487_1447666613901003395_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=POcdCWecZfkQ7kNvwF9xTTm&_nc_oc=AdqpVKgK4IktelRpGoRoPPWTGBGG422UjAV86QBd8a3n2vmGD3_a4THAH_1PWweivYk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjgsIsWnxXVRMWKk78oSZjiPu-7XKGMCI8FDzfb_j_Iw&oe=6AFF0715"}, "display_name": "Rollercoaster Build It", "keywords": ["rollercoaster", "coaster", "tycoon", "themepark", "builder"], "long_description": "Rollercoaster Build It puts a whole theme park in your hands.\n\nBUILD\nOpen the round build store and buy track piece by piece: straights, turns, wide turns, S-curves, hills, climbing turns and a full loop. Point at the end of your track and the next piece snaps into place. Flip a piece to turn the other way or take a hill back down. Supports appear under raised track automatically.\n\nRIDE\nPut coaster cars on your track, step into one and go. The train follows every rail you laid, crawling over the hilltops and racing through the dips and loops. Close the circuit and it keeps looping until you get off. Prefer a gentler ride? Switch on level horizon in the menu.\n\nRUN YOUR PARK\nLay paths and queue lines, build a station, and set up food stalls, drink stands, toilets, benches, trees and flowers. Guests walk in through the gate, wander your paths, buy snacks and cheer as your coaster goes by. Every ticket and snack adds to your budget.\n\n- 40 things to build: track, scenery, paths and rides\n- Ride what you build, loops included\n- A 120 by 120 metre park to fill\n- Your park, cars and money save automatically\n- Music all the way through\n\nEarly Access: more rides, track styles and park items are on the way.", "short_description": "Build your own theme park in VR, then ride it. Snap steel roller coaster track together into hills, turns and loops, put cars on it and climb in for the ride. Lay paths and queue lines, set up food and drink stalls, trees and benches, and watch guests fill your park and cheer as your coaster roars past. Your park saves automatically."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-rollercoasterbuildit.pages.dev/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-rollercoasterbuildit.pages.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "com
nt-sea5-1.oculuscdn.com/v/t64.5771-25/491830576_4315962415288173_7657643342570002024_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PuKeevVHAqMQ7kNvwG-4LMi&_nc_oc=Adq0gnjw4x2y92ms03Hy2MvIy7DgQdDSTs0KHiinygKzCtvlmRQu4aWqtc9h4KjLuVA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTt-hWNC4THcqVxMhge73ARwxyBzhf0yUNwF3kwdqL1uw&oe=6AFF33F6"}, {"file_name": "screenshot_3_2560x1440.png", "id": "1139358142241462", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499624069_1139358145574795_8328668420658455468_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N9808E3qKZUQ7kNvwGqwPAW&_nc_oc=Adp-_Gye7knKoyhWUNv43NrwPe42GFL29QDIAA5hBVkKbAYiRDNPR9DWNpC-96LbBsw&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSveDbiijJjDu29rm7WfCTZwxGpBIMn6vTGb7GsBM1SEw&oe=6AFF1C07"}, {"file_name": "screenshot_4_2560x1440.png", "id": "1119407203764168", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620403_1119407207097501_5213777367254568264_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=70GYvQxj75EQ7kNvwEd3kOF&_nc_oc=AdrFh_Ojs2zwwMOdwhqQYG6DQDAB2rQ6AUxX-u-WHBIkwzOE1epVl9thBjAiBz8uXbM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKjZUOppvIYhM5Zxi65yx2uZl9sBhzSIP5W6_xjmrHPQ&oe=6AFF1EE5"}, {"file_name": "screenshot_5_2560x1440.png", "id": "1999169717243226", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/593776279_1999169720576559_7384827178036950513_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=99m46b1mdRUQ7kNvwEpW2nW&_nc_oc=AdqhtRsxwTWe4HtmLrCTPJiIr_Upk86V7zmXWbXkqWmtrzD9meVwh0sncLO_K2yuAPE&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgvSWU_DsiMRbp3zyvfBgv8WEslyopzKM1tlRj5WdJ8g&oe=6AFF162C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "2425403517988154", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619602_2425403521321487_1447666613901003395_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=POcdCWecZfkQ7kNvwF9xTTm&_nc_oc=AdqpVKgK4IktelRpGoRoPPWTGBGG422UjAV86QBd8a3n2vmGD3_a4THAH_1PWweivYk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjgsIsWnxXVRMWKk78oSZjiPu-7XKGMCI8FDzfb_j_Iw&oe=6AFF0715"}, "display_name": "Rollercoaster Build It", "keywords": ["rollercoaster", "coaster", "tycoon", "themepark", "builder"], "long_description": "Rollercoaster Build It puts a whole theme park in your hands.\n\nBUILD\nOpen the round build store and buy track piece by piece: straights, turns, wide turns, S-curves, hills, climbing turns and a full loop. Point at the end of your track and the next piece snaps into place. Flip a piece to turn the other way or take a hill back down. Supports appear under raised track automatically.\n\nRIDE\nPut coaster cars on your track, step into one and go. The train follows every rail you laid, crawling over the hilltops and racing through the dips and loops. Close the circuit and it keeps looping until you get off. Prefer a gentler ride? Switch on level horizon in the menu.\n\nRUN YOUR PARK\nLay paths and queue lines, build a station, and set up food stalls, drink stands, toilets, benches, trees and flowers. Guests walk in through the gate, wander your paths, buy snacks and cheer as your coaster goes by. Every ticket and snack adds to your budget.\n\n- 40 things to build: track, scenery, paths and rides\n- Ride what you build, loops included\n- A 120 by 120 metre park to fill\n- Your park, cars and money save automatically\n- Music all the way through\n\nEarly Access: more rides, track styles and park items are on the way.", "short_description": "Build your own theme park in VR, then ride it. Snap steel roller coaster track together into hills, turns and loops, put cars on it and climb in for the ride. Lay paths and queue lines, set up food and drink stalls, trees and benches, and watch guests fill your park and cheer as your coaster roars past. Your park saves automatically."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-rollercoasterbuildit.pages.dev/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-rollercoasterbuildit.pages.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1240953762443930"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491831569_968623509595315_6220061797570577315_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AQC0TUo5fzUQ7kNvwGcRuY8&_nc_oc=Adpk_s_dDKmEpEXWQsYJhYu4WH9O01OrpuQ1_K4cuOHlaIRlqNVvNnUusGGkv5bCUnA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPLiMgrZ9F_ct9Eoo_9I5QWIGvGsGuVnT-E6XlhdemAw&oe=6AFF0362"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Rollercoaster Build It", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sandbox", "id": "1990104051447093"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1789650000, "lastRevision": {"nodes": [{"id": "1240953772443929", "release
-iad3-2.oculuscdn.com/v/t64.5771-25/499620403_1119407207097501_5213777367254568264_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=USJMg8hGdTgQ7kNvwFn2UM4&_nc_oc=AdrcwTG3YtIdVSYYURfXAzS8aXvV2UNsvPHUiZi7CeP5e_QI7KXJixv76R-AXqC7xuw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTEmw325Bicp5JCaMo2CHG20Yab3f4iIZ5gg-LwSq7Tlg&oe=6AF1EFE5"}, {"file_name": "screenshot_5_2560x1440.png", "id": "1999169717243226", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593776279_1999169720576559_7384827178036950513_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u1lPXG414_kQ7kNvwEjAMRg&_nc_oc=AdojocjBECkJrGA0hRfYMcBeuHYpPC54ISafCE2YPKkaaLweoKPUExsg8PSW1a6CsXg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGkz6m7nULd6s1VffN8TDM_XUrbBUp-NT-2KfGotIwKA&oe=6AF1E72C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "2425403517988154", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619602_2425403521321487_1447666613901003395_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mhOn4BOW6I8Q7kNvwGpOlBb&_nc_oc=AdrTZ1wUkyEDU4JKvWM4p6XUCqqjMSZXxHVuSbfNd8ZT4ZXd8w-UVIhx3sW2LMkqJcY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqXLSAMN0-YTEZF9lVYxBRkGtrc_osaCRzLs4B6SBKdw&oe=6AF1D815"}, "display_name": "Rollercoaster Build It", "keywords": ["rollercoaster", "coaster", "tycoon", "themepark", "builder"], "long_description": "Rollercoaster Build It puts a whole theme park in your hands.\n\nBUILD\nOpen the round build store and buy track piece by piece: straights, turns, wide turns, S-curves, hills, climbing turns and a full loop. Point at the end of your track and the next piece snaps into place. Flip a piece to turn the other way or take a hill back down. Supports appear under raised track automatically.\n\nRIDE\nPut coaster cars on your track, step into one and go. The train follows every rail you laid, crawling over the hilltops and racing through the dips and loops. Close the circuit and it keeps looping until you get off. Prefer a gentler ride? Switch on level horizon in the menu.\n\nRUN YOUR PARK\nLay paths and queue lines, build a station, and set up food stalls, drink stands, toilets, benches, trees and flowers. Guests walk in through the gate, wander your paths, buy snacks and cheer as your coaster goes by. Every ticket and snack adds to your budget.\n\n- 40 things to build: track, scenery, paths and rides\n- Ride what you build, loops included\n- A 120 by 120 metre park to fill\n- Your park, cars and money save automatically\n- Music all the way through\n\nEarly Access: more rides, track styles and park items are on the way.", "short_description": "Build your own theme park in VR, then ride it. Snap steel roller coaster track together into hills, turns and loops, put cars on it and climb in for the ride. Lay paths and queue lines, set up food and drink stalls, trees and benches, and watch guests fill your park and cheer as your coaster roars past. Your park saves automatically."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-rollercoasterbuildit.pages.dev/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-rollercoasterbuildit.pages.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_
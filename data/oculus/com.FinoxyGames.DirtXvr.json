6O4k9RWIGLCT6MbBStnC0EWcriU7p-KJEkjhNWXn2faLA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFaD-U5UcaUJg7AFVUuD3T52VAp_4O0iXpKf4i3-mHVw&oe=6AFC6A82"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DirtX VR", "keywords": ["Motocross", "OffRoad", "Motorcycle", "Racing", "DirtBike"], "long_description": "# DirtX VR \u2013 Extreme Off-Road Dirt Bike Racing\n\nGet ready for the ultimate **VR dirt bike racing adventure** with DirtX VR! Ride powerful off-road motorcycles, race through challenging motocross tracks, perform incredible bike stunts, and test your riding skills across wild environments. From high-speed dirt bike racing to extreme downhill rides and impossible challenges, every track delivers a new test of speed, balance, precision, and control.\n\n## \ud83c\udfc1 Extreme Motocross Racing\nExperience exciting motocross racing as you ride through rugged trails, challenging tracks, sharp turns, and demanding terrain. Push your dirt bike to the limit, improve your riding skills, and master every course in an immersive virtual reality motorcycle racing experience.\n\n## \ud83c\udfcd\ufe0f Multiple Game Modes\nChoose your favorite challenge and discover different ways to ride:\n\n- **Motocross Racing:** Race across off-road tracks and master challenging courses.\n- **Stunt Riding:** Perform daring jumps, control your bike in the air, and take on exciting stunt challenges.\n- **Impossible Challenges:** Test your balance, precision, and riding skills on difficult tracks designed to challenge even experienced riders.\n- **Downhill Racing:** Ride down steep slopes, navigate rugged terrain, and race through thrilling downhill courses.\n- **Straight Road Riding:** Accelerate along straight tracks, maintain control at high speeds, and enjoy fast-paced motorcycle action.\n- **Multiplayer Racing:** Compete against other player", "short_description": "Race, stunt, and ride wild in DirtX VR, an immersive off-road dirt bike racing game! Master motocross tracks, insane stunts, impossible challenges, downhill racing, straight-road rides, and multiplayer battles across forest trails, snowy mountains, deserts, and indoor motocross arenas. Experience extreme motorcycle racing, thrilling bike jumps, and high-speed off-road adventures in VR!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/fionxygames/meta-quest-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Fionxy Games", "support_website_url": null, "website_url": "https://sites.google.com/view/fionxygames/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1604656701347584"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499313058_969525662876347_8440200151845180614_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0qX-XLe2EfMQ7kNvwHqwFby&_nc_oc=Ado3wvdZEa75_P-SblalHofkm4JNoJ79DNZ01FmLDkRTsVkyCunbM-nZ-rBox0ZVmLE&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWsJPsspP5W8zBCc0NNw6RYLGLw_9vKB5m2loHP87Ktw&oe=6AFC622B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "DirtX VR", "platform": "ANDROID_6DOF", "context_category": {"context_categor
luscdn.com&_nc_ss=7f30f&oh=00_AQQ91KAxU9ULGB6sy0LX-svYTMPz8WTc1ukBBRQkV08ISQ&oe=6B0B15AB"}, {"file_name": "08_wave6b_2560x1440.png", "id": "2383089475854088", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499312338_2383089479187421_4551018561927977153_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qnHWL7KU148Q7kNvwEwQhPi&_nc_oc=AdqhW4AtO4Ek_RKruPXY1S4Ea0t4J7F5IO8nWBu7fqO8ZRoce8aKI6CsVe11WlCBrVc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQRnHx0Ukf8H5aGqtJeVGKKDAQ6msHMxl0oxrTvxafdrA&oe=6B0B4542"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "1323480469854580", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499314648_1323480473187913_4094287173362459685_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JnkNBljLHWoQ7kNvwH-selB&_nc_oc=Adp-NPeSRmCHX3PNOlpPcDT2Ip_UY0xBq4a7_jRzBK8w3_gnNioqzv9KIV1r_0XYbq4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTx2_jaa_JGs1Iygd5PlckrdcizOxSkEHPDBH3UsqGuEA&oe=6B0B36D5"}, "display_name": "Comet Wardens", "keywords": ["shooter", "arcade", "tabletop", "space", "hologram"], "long_description": "Comet Wardens is a space shooter on a holo-table. A glowing space station floats at waist height in front of you, raider gates ring the rim, and your little neon ship darts between them.\n\nFly with the left stick, point your right hand at the table to aim and pull the trigger to fire from your ship's nose. Your first round starts with a practice drone and a controls card, so you learn it in seconds.\n\nTwo arenas:\n- Halo Station: eight raider gates, scouts, spinners, prisms and mantas, and a mothership rising over the table's edge.\n- Shard Belt: drifting rocks that stop shots and ships, lurkers clinging to them, meteors, and the Rock Hauler.\n\nTwo ships:\n- Lancer: quick, with long shots and a comet dash that rams raiders.\n- Bulwark: slow and tough. Hold the trigger for a charged spread; raise a shield bubble over your wingmen.\n\nYou never fly alone. Three computer wingmen fly the other seats, and if you are shot down you drift as a beacon until a wingman flies through it to bring you back. Comet charms give rapid fire, repair kits patch the station, and stars reward every station you save, kept for each arena.\n\nGrab the table to move, turn or resize it. Turn round it with the right stick (smooth, snap, or turn the table itself). Play standing or seated. No internet needed.\n\nFree. No ads, nothing to buy.", "short_description": "A glowing space station floats on a table in front of you, and raiders are coming for it. Fly your neon ship with the left stick, aim with your hand and hold the station for ten waves with three computer wingmen. Two arenas, two ships, two bosses. Free, no ads."}]}, "developer_name": "Guidry Games", "developer_privacy_policy_url": "https://guidrygames.com/privacy.html#quest", "developer_terms_of_service_url": "https://guidrygames.com/terms.html", "publisher_name": "Guidry Games", "support_website_url": "https://guidrygames.com/support.html", "website_url": "https://guidrygames.com/games.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29721927544080381"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "181
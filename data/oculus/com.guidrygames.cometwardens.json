108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4DLjByw_tyQQ7kNvwHM1kxo&_nc_oc=AdpDutcApJcT9nsm8riZASDiRyoBIgininOf0E85FI6Uz9GbxVqO5GYcp3TTxAmMi8c&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTBrDk2cYZQPk5CqOOE7NZPHOs8KHS4PXY5_3dr113tXA&oe=6B0B1E4F"}, {"file_name": "07_revive_2560x1440.png", "id": "1119269480995742", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499299745_1119269484329075_4271670561896466806_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oMfhwL0Bi6QQ7kNvwEg0vkr&_nc_oc=AdpBfU5w8hWLh3foIub4WwmLr_PXTJXPs765opVIeLXS3rOMKoADrdR8tJIjwvBlz8w&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ91KAxU9ULGB6sy0LX-svYTMPz8WTc1ukBBRQkV08ISQ&oe=6B0B15AB"}, {"file_name": "08_wave6b_2560x1440.png", "id": "2383089475854088", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499312338_2383089479187421_4551018561927977153_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qnHWL7KU148Q7kNvwEwQhPi&_nc_oc=AdqhW4AtO4Ek_RKruPXY1S4Ea0t4J7F5IO8nWBu7fqO8ZRoce8aKI6CsVe11WlCBrVc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQRnHx0Ukf8H5aGqtJeVGKKDAQ6msHMxl0oxrTvxafdrA&oe=6B0B4542"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "1323480469854580", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499314648_1323480473187913_4094287173362459685_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JnkNBljLHWoQ7kNvwH-selB&_nc_oc=Adp-NPeSRmCHX3PNOlpPcDT2Ip_UY0xBq4a7_jRzBK8w3_gnNioqzv9KIV1r_0XYbq4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTx2_jaa_JGs1Iygd5PlckrdcizOxSkEHPDBH3UsqGuEA&oe=6B0B36D5"}, "display_name": "Comet Wardens", "keywords": ["shooter", "arcade", "tabletop", "space", "hologram"], "long_description": "Comet Wardens is a space shooter on a holo-table. A glowing space station floats at waist height in front of you, raider gates ring the rim, and your little neon ship darts between them.\n\nFly with the left stick, point your right hand at the table to aim and pull the trigger to fire from your ship's nose. Your first round starts with a practice drone and a controls card, so you learn it in seconds.\n\nTwo arenas:\n- Halo Station: eight raider gates, scouts, spinners, prisms and mantas, and a mothership rising over the table's edge.\n- Shard Belt: drifting rocks that stop shots and ships, lurkers clinging to them, meteors, and the Rock Hauler.\n\nTwo ships:\n- Lancer: quick, with long shots and a comet dash that rams raiders.\n- Bulwark: slow and tough. Hold the trigger for a charged spread; raise a shield bubble over your wingmen.\n\nYou never fly alone. Three computer wingmen fly the other seats, and if you are shot down you drift as a beacon until a wingman flies through it to bring you back. Comet charms give rapid fire, repair kits patch the station, and stars reward every station you save, kept for each arena.\n\nGrab the table to move, turn or resize it. Turn round it with the right stick (smooth, snap, or turn the table itself). Play standing or seated. No internet needed.\n\nFree. No ads, nothing to buy.", "short_description": "A glowing space station floats on a table in front of you, and raiders are coming for it. Fly your neon ship with the left stick, aim with your hand and hold the station for ten waves with three computer wingmen. Two arenas, two ships, two bosses. Free, no ads."}]}, "developer_name": "Guidry Games", "developer_privacy_policy_url": "https://guidrygames.com/privacy.html#quest", "developer_terms_of_service_url": "https://guidrygames.com/terms.html", "publisher_name": "Guidry Games", "support_website_url": "https://guidrygames.com/support.html", "website_url": "https://guidrygames.com/games.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GA
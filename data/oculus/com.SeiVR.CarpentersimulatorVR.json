, "id": "1707433490667530", "locale": "en_US", "screenshots": [{"file_name": "5.png", "id": "1009538851326040", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499620476_1009538854659373_792012922816785500_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9dTfeJ3340wQ7kNvwGcQuXT&_nc_oc=Adr8sefBvIjPnFJt5OjEpC3BHw88L4oCagHhdVfEVKuQAlqm6moGMZmosRMRb44dl1Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af16yuNCUUEuNkHpybHLYSyRV83k6wMC40eaZuXY63zvjQ&oe=69DE42CC"}, {"file_name": "6.png", "id": "1399136164614663", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618930_1399136167947996_8653883982299444757_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HfapdqMHqhwQ7kNvwFdqSYW&_nc_oc=AdolbXiYQl7IohHa6Fi4jR4lCaoLf1Trm2qUBsgVnPxwamhRXT9zwocQVGFvhSrRnKM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1TI1yT3Yq4NFPN7L-d4tlX2iOeMdgcJ7Y_RUirarzhIA&oe=69DE4F5E"}, {"file_name": "2.png", "id": "2612581769107453", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618274_2612581772440786_6520813707633238542_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tjyXbWjMk6gQ7kNvwH6eEQf&_nc_oc=AdrsX2tsSNt5Y0fxSjAQO2LZW4Rhh73lYwOD1BRX-4NMi5tOYXOHvl-0OJTS651FIgE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af22EYk976ysTtRVKuRXnW5OVsQ7aHOHg4XmEyJIliUqDQ&oe=69DE4CB1"}, {"file_name": "3.png", "id": "623349030778908", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618089_623349034112241_9121807948883346742_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JYeJOPGovsAQ7kNvwGycuhj&_nc_oc=AdoceAWLOSZIehSGgU2IcCb61fy9Vz-g9U83AB97XSLGqwz2j_8QAPN3qlrMq1xsX7s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3lJ1tTlWItv9kTOljYt7TS_aIobpGYy6z3kVuxdxtwPw&oe=69DE3934"}, {"file_name": "4.png", "id": "1253627109441996", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618464_1253627112775329_6269737204804707692_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M1dRAax5Dd8Q7kNvwFa-ANv&_nc_oc=Adp0_F_7ltwI4r2r8_CYhy4sK6lm-3NRvO9a9dxoGQC2Z33QIDEaKF6QgiZeMHtogWA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Okzcpe1HD0ZqMWcH0L9gk-y7CJ1jdlVKREaB6Txo1SQ&oe=69DE482E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1635499240460081", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619631_1635499243793414_34979520282232832_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=achauuuMwqQQ7kNvwF9WD6Y&_nc_oc=AdpEkcAeKJ_0p4-E1ddoesk9et9bTxv4bYaR-s1oRTscFy0zF-nV_JVwq2YDtmLNjYI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af35mqwcOofK7k_SojWn-MvP-2UXh-3ha1v9MFwjVlSRpw&oe=69DE20C1"}, "display_name": "Carpenter Simulator VR", "keywords": ["woodworkingvr", "carpentersimulatorvr", "furnitureassembly", "blueprintbuilder", "vrworkshop"], "long_description": "Try free and feel the tools. Build real furniture from blueprints\u2014measure, cut, drill and screw each piece into place with clear on-piece guides.\n\nCarpenter Simulator VR brings hands-on woodworking to virtual reality. Start with raw planks, follow simple plans, and assemble step by step. The controls are straightforward, the flow is smooth, and every action feels tactile and satisfying\u2014perfect for short sessions or relaxed build nights.\n\n\u2022 Follow blueprints from start to finish\n\u2022 Use familiar tools: Hammers, screws\n\u2022 Clear snap/placement guides for accurate builds\n\u2022 Short, relaxing builds\u2014easy to pick up, hard to put down\n\n\ud83d\udee0\ufe0f Resolved an issue preventing stamina from recovering after level reload.\n\u26a1 Optimized performance for a smoother gameplay experience.\nHey everyone!\n\nThis update is all about making the game smoother and easier to jump into. We\u2019ve fixed a bunch of annoying bugs to improve overall performance, so things should feel better while you play.\n\nWe also added a quick intro/tutorial at the start to help you get the hang of everything faster\u2014especially if you're new.\n\nIf you run into any issues or have ideas to make the game more fun, feel free to drop us your feedback. We\u2019re always listening and working to improve the experience!\n\nThanks for playing \u2764\ufe0f", "short_description": "Try free: build real furniture in VR. Follow blueprints\u2014measure, cut, drill and screw\u2014fast, tactile, oddly satisfying."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/seivr/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jone Sei", "support_website_url": null, "website_url": "https://sites.google.com/view/seivr/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26567626826190402"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822818_1181787683713744_2557403714749755129_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TQKD4aF-rIkQ7kNvwFXYv2a&_nc_oc=AdqcoSsyJp4Nw9V9bkhMJv4Ot_AIiV1qU5SWQ6UDfOCRMvgXCWsXRHwm1obF47QP_bg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af09Rs8TfIgSoa5I0ZnXzHIfWyBjJdeZEvBScZQXKzEcuQ&oe=69DE413A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Carpenter Simulator VR", "platform": "ANDROID_6DOF", "context_category": {"context_cat
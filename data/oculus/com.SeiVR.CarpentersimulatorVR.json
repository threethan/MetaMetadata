MBoprjGlTxcZ4TnD0uWwRsoM9XjS6ZfxMyimaOnfMZmgVO2MIUqY2_ok&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu91gs9_LkrIZOZah57nD1enkoODSbnIzTgDK_E6cqT3g&oe=69A2E016"}, {"file_name": "s4.png", "id": "1396091854719255", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393338_1396091861385921_3525921990377182430_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b_t19I_JFLIQ7kNvwHUJoFb&_nc_oc=Adn9kfXbUVvKaoCldKiwsHQK7cWFG_IG7MMArxG5y8X_2CIrol2WailqZe3GvUnVsio&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuopG2-T3kKLVvuikGdeNUtlyEXxHQCW1M6OdaJjvOhZw&oe=69A2CAAB"}, {"file_name": "s2.png", "id": "1134018684852214", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392161_1134018688185547_3373782723112850264_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_qaxNQNHm-sQ7kNvwFHDsMs&_nc_oc=AdltmNhMeX1j0rtwIf4RGUARrQwHtrLBm-ygg-adWDrfRSJ1wgz_idboPBdFmAld96Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsDOeHNbQmqaw5SMcojvl-EXbeaO4091R4SvFafTVP4Dw&oe=69A2F345"}, {"file_name": "s1.png", "id": "1117528370164324", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393713_1117528373497657_2336605798937990977_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zKC0CL7x3YoQ7kNvwG65fgh&_nc_oc=AdnZ-hXYrEWSapoo6v9TV_sYxgdwne49aCGTgFK2EOwXV-sAS6i0Msgzp2UM_Keb6O0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfviQ0L0cYrSNS_ExPHVkg2sF1pm2UyzdbN8PQ0_ytMZSA&oe=69A2C823"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Carpenter Simulator VR", "keywords": ["VRCarpentry", "WoodworkingGame", "CraftingSimulator", "FurnitureAssembly", "VirtualWorkshop"], "long_description": "Apprentice Carpenter brings the art of woodworking to life in virtual reality. Using realistic tools like hammers, screwdrivers, and saws, players must assemble wooden furniture based on provided blueprints within a set time limit.\n\nEach completed piece earns points, and players can seamlessly move on to new challenges, refining their skills with each project.\n\nKey Features:\n\n\ud83d\udee0\ufe0f Realistic woodworking tools and physics.\n\n\ud83e\ude91 Multiple furniture models to assemble.\n\n\u23f1\ufe0f Time-based challenges to test your speed and accuracy.\n\n\ud83c\udf10 Seamless, continuous gameplay environment.\n\n\ud83c\udfae Perfect for VR enthusiasts and crafting lovers alike.", "short_description": "Step into the role of an apprentice carpenter in this immersive VR game. Assemble wooden furniture accurately and quickly to prove your craftsmanship in a dynamic woodworking shop."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/seivr/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jone Sei", "support_website_url": null, "website_url": "https://sites.google.com/view/seivr/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9339242429455443"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "1857611981552996"}, {"status": "PUBLISHED", "id": "4189423757974185"}, {"status": "PUBLISHED", "id": "828311693432723"}, {"status": "PUBLISHED", "id": "2540412966314424"}, {"status": "PUBLISHED", "id": "792223953596307"}, {"status": "PUBLISHED", "id": "1733613890678922"}, {"status": "PUBLISHED", "id": "796800583019183"}, {"status": "PUBLISHED", "id": "651832290524265"}]}, "baseline_offer": {"id": "792223953596307"}, "is
, "id": "1707433490667530", "locale": "en_US", "screenshots": [{"file_name": "5.png", "id": "1009538851326040", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499620476_1009538854659373_792012922816785500_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xVpH6ygRNIoQ7kNvwEEgnxk&_nc_oc=AdrzbKBEVCpVy8QiRXmoNyT_m0_NMmUpV4Filq3eBjZ-Apfe5xdy9EqNzfic_2tpX_A&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDvAZ8motqVxV9GTQZg5gimWEexwbTjXQCQ9dqIK9MKQw&oe=6A58DE4C"}, {"file_name": "6.png", "id": "1399136164614663", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499618930_1399136167947996_8653883982299444757_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n9_NUtIhCU0Q7kNvwFTC7zw&_nc_oc=AdrL4SIb3XSQD1YJ9FWJlgE5ox1-Jk_63fvQ6ognwhhEyTDsmho8AIPb8f_fATrvrI8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBy6pfX_LuU7hhxwaHYsOG84S2GbFWsjlXtgzl7IXHxDw&oe=6A58EADE"}, {"file_name": "2.png", "id": "2612581769107453", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499618274_2612581772440786_6520813707633238542_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h0ssPPVMm98Q7kNvwHsxbvf&_nc_oc=AdpOSyajILNVG5N_pov_U84WeG-PgvhNVrhzrwZtYfUti6HsqlRaMRjbwWAnfyN2TRg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBDgGwAgszYacsYHRvRpuY3qAGhHRFl7bqNPSWj6CyMFQ&oe=6A58E831"}, {"file_name": "3.png", "id": "623349030778908", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499618089_623349034112241_9121807948883346742_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qR-teYaDRxIQ7kNvwF8KhBj&_nc_oc=Adq3fIJjPE-XOHmhGYC8xzZVfW0VVFfd--FboiSHCiFt9wk3_aL-_Fnl48y9qeuSJQw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA6AUJNx7XsNLpW1ZiGDxyH3RX9hayrDZI74FiD-8U15Q&oe=6A58D4B4"}, {"file_name": "4.png", "id": "1253627109441996", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499618464_1253627112775329_6269737204804707692_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fJOGyNiQDggQ7kNvwGGF-_U&_nc_oc=AdpgBPmulNMfc629yYuZ7sJCKTWBq3_dwZ4GVx_Iai_MNsLqbl-Sx7horgMvApaDILY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAadWZW2vT9LIe8VRemOQRi8pQKb1vIY7A2wrza5l_YVQ&oe=6A58E3AE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1635499240460081", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499619631_1635499243793414_34979520282232832_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JyG-fzRDjMwQ7kNvwGfgJk-&_nc_oc=AdregS0SZZOltDt7y6S73lLoFOPT9NoJKZxHTV7joMm-r76uqngg6vCNns5HYl3BBQU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC2e3nQUAhhfZ6p93fvCx1dL0l1iGqtDEBSgLMP475zuA&oe=6A58F481"}, "display_name": "Carpenter Simulator VR", "keywords": ["woodworkingvr", "carpentersimulatorvr", "furnitureassembly", "blueprintbuilder", "vrworkshop"], "long_description": "Try free and feel the tools. Build real furniture from blueprints\u2014measure, cut, drill and screw each piece into place with clear on-piece guides.\n\nCarpenter Simulator VR brings hands-on woodworking to virtual reality. Start with raw planks, follow simple plans, and assemble step by step. The controls are straightforward, the flow is smooth, and every action feels tactile and satisfying\u2014perfect for short sessions or relaxed build nights.\n\n\u2022 Follow blueprints from start to finish\n\u2022 Use familiar tools: Hammers, screws\n\u2022 Clear snap/placement guides for accurate builds\n\u2022 Short, relaxing builds\u2014easy to pick up, hard to put down\n\n\ud83d\udee0\ufe0f Resolved an issue preventing stamina from recovering after level reload.\n\u26a1 Optimized performance for a smoother gameplay experience.\nHey everyone!\n\nThis update is all about making the game smoother and easier to jump into. We\u2019ve fixed a bunch of annoying bugs to improve overall performance, so things should feel better while you play.\n\nWe also added a quick intro/tutorial at the start to help you get the hang of everything faster\u2014especially if you're new.\n\nIf you run into any issues or have ideas to make the game more fun, feel free to drop us your feedback. We\u2019re always listening and working to improve the experience!\n\nThanks for playing \u2764\ufe0f", "short_description": "Try free: build real furniture in VR. Follow blueprints\u2014measure, cut, drill and screw\u2014fast, tactile, oddly satisfying."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/seivr/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jone Sei", "support_website_url": null, "website_url": "https://sites.google.com/view/seivr/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26567626826190402"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491822818_1181787683713744_2557403714749755129_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RrzpmRFnsaAQ7kNvwFnuK-o&_nc_oc=Adpa6qiBI1tfCaEchhBnnfSL4JDsuRHP4OLSXILeqKsgsXlTRFclCvSTzNNAyARHTwU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBDEn4cGZdgELt5b6pjIUaNgkewh9tN1c6Cr1QceDJe0A&oe=6A58DCBA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Carpenter Simulator VR", "platform": "ANDROID_6DOF", "context_category": {"context_cat
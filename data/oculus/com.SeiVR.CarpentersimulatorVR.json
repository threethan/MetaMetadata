, "id": "1707433490667530", "locale": "en_US", "screenshots": [{"file_name": "5.png", "id": "1009538851326040", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620476_1009538854659373_792012922816785500_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4zGsxbDuZ0QQ7kNvwGFElk2&_nc_oc=AdpqrS5S5h9BXH16sC3X1UOUxgsfx0OvHklG_ZFfvjG2MQhQqY7ueAlXX-K9MrMpWnw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5W6SXG1ehx5nGCG0cJ9KhRMDqD0rjw5RxsQkAuS_wrdg&oe=6A202DCC"}, {"file_name": "6.png", "id": "1399136164614663", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618930_1399136167947996_8653883982299444757_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ENP2gDcJ7X0Q7kNvwEs-6_J&_nc_oc=AdrefFrY5gBJ4FYtrBkCS9qM4Gbu7StXY22q6zrJFox_qEapZhHsouM_DHFvrgg2GSI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7E9-m2zSg5iVzJbX4kGK7jcY0drog8BgRb_g1ouHfEtg&oe=6A203A5E"}, {"file_name": "2.png", "id": "2612581769107453", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618274_2612581772440786_6520813707633238542_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PmGKCldFHG0Q7kNvwG2VEa5&_nc_oc=AdoIhZty0LWkCqZJ41RKjTsvhH7fwom8hYemEDlubMFv932-dEKbXnnwxyE06VNONIE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ihlbknSKxswIeN-yQR2PkK2Y48XQXtU6TIjyBwwa8pQ&oe=6A2037B1"}, {"file_name": "3.png", "id": "623349030778908", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618089_623349034112241_9121807948883346742_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hl1VPaY6VsEQ7kNvwHQU2B-&_nc_oc=AdpsDVX8qBQpsSUNkNlXDY_jDSodEu7kLrUNYXaY5kcJ1p7boxpJX_fuzsItAKdrkT0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5yQO6kyqjxa1QR4Lmc3tIv0u6hTJ9LEk2dwQRO4o4u3w&oe=6A202434"}, {"file_name": "4.png", "id": "1253627109441996", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618464_1253627112775329_6269737204804707692_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9TC23kxPjsgQ7kNvwG_F9mB&_nc_oc=AdpAcWORxF7Dd6Owezz9juBmNTv6tM8xGpVCKgrKVSffLIo6VH1_AgbFyNXhjmcTH4A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4XsnlGrGxeCRvc3qu4frFGKIKF_SpiVD8SUU8ulCL8UQ&oe=6A20332E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1635499240460081", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619631_1635499243793414_34979520282232832_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-iGh-jMxSQgQ7kNvwGeNsRb&_nc_oc=AdqjuyFoYtu0lErDsA9srcN6PdYFdWg4C4TE8ZRD1oCYGtVEZwlqIC87yXpNegwwtBI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7EfHyvJ4L79DOxQ7il9ECCMdF-BaJNzvHEO7WyKw1hTw&oe=6A204401"}, "display_name": "Carpenter Simulator VR", "keywords": ["woodworkingvr", "carpentersimulatorvr", "furnitureassembly", "blueprintbuilder", "vrworkshop"], "long_description": "Try free and feel the tools. Build real furniture from blueprints\u2014measure, cut, drill and screw each piece into place with clear on-piece guides.\n\nCarpenter Simulator VR brings hands-on woodworking to virtual reality. Start with raw planks, follow simple plans, and assemble step by step. The controls are straightforward, the flow is smooth, and every action feels tactile and satisfying\u2014perfect for short sessions or relaxed build nights.\n\n\u2022 Follow blueprints from start to finish\n\u2022 Use familiar tools: Hammers, screws\n\u2022 Clear snap/placement guides for accurate builds\n\u2022 Short, relaxing builds\u2014easy to pick up, hard to put down\n\n\ud83d\udee0\ufe0f Resolved an issue preventing stamina from recovering after level reload.\n\u26a1 Optimized performance for a smoother gameplay experience.\nHey everyone!\n\nThis update is all about making the game smoother and easier to jump into. We\u2019ve fixed a bunch of annoying bugs to improve overall performance, so things should feel better while you play.\n\nWe also added a quick intro/tutorial at the start to help you get the hang of everything faster\u2014especially if you're new.\n\nIf you run into any issues or have ideas to make the game more fun, feel free to drop us your feedback. We\u2019re always listening and working to improve the experience!\n\nThanks for playing \u2764\ufe0f", "short_description": "Try free: build real furniture in VR. Follow blueprints\u2014measure, cut, drill and screw\u2014fast, tactile, oddly satisfying."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/seivr/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jone Sei", "support_website_url": null, "website_url": "https://sites.google.com/view/seivr/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26567626826190402"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822818_1181787683713744_2557403714749755129_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K4P5fWkzXhAQ7kNvwFQKAVi&_nc_oc=AdrM1djcanSAFc3FvtwSvC2IyaHdCU4njjsf0-sDqOubQN-mzYO7Dbw637unMisexUk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5V7-GJ-ErKNFaWpHQf76BwzRyo84kC8_QLHpIw2iPXhA&oe=6A202C3A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Carpenter Simulator VR", "platform": "ANDROID_6DOF", "context_category": {"context_cat
, "id": "1707433490667530", "locale": "en_US", "screenshots": [{"file_name": "5.png", "id": "1009538851326040", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620476_1009538854659373_792012922816785500_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OSs-nWvPPY0Q7kNvwHd08xF&_nc_oc=Adrwwcfw_hr6q2yp9WoTmlcxcDCTTeaayE3RZuZ42S7Tvp65d-zhNlhqLN7nCCbkxYM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8LYrwAMfKK7KIDefSz3jhI5VZfYocMT0U-tWieTcfPIA&oe=6A3BDD4C"}, {"file_name": "6.png", "id": "1399136164614663", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618930_1399136167947996_8653883982299444757_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-LrhfBr-SckQ7kNvwHwepoc&_nc_oc=AdoQycfzPMZ3E-DW63-ycn_woqeveCkopVYdy5RlaAhHgYIn-B9btXaf66eFGoBJ754&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_p56WGWLG8BpZfem0KiL_nFTnK-iC0uRADg7BvgVjv0A&oe=6A3BE9DE"}, {"file_name": "2.png", "id": "2612581769107453", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618274_2612581772440786_6520813707633238542_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QTl-eh3hvTMQ7kNvwHfSKfe&_nc_oc=AdrO-9nnFYbCO_svrVexsd54LDCRZtvdTBoNhmbObc73oh814wt-KUYH2CnRpnW5HMA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-jd_ag132V8bZxXD3xGEnM8nH6Gf1jSe5OtyDrNpcaVg&oe=6A3BE731"}, {"file_name": "3.png", "id": "623349030778908", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618089_623349034112241_9121807948883346742_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w9Pe5FgkosEQ7kNvwHMv6eh&_nc_oc=AdpRa9FNUI0oDi_Q7hTa0OntaIaxpptAcjrRvC-6bAyVhVsPai4yz1mlfz_uVRs546Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_XuVwKi2j_EBtUZHsSNs6OgryhUGC4sYwX6issPUjibw&oe=6A3BD3B4"}, {"file_name": "4.png", "id": "1253627109441996", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618464_1253627112775329_6269737204804707692_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1tCnXCLXZSoQ7kNvwEyV9Bj&_nc_oc=AdqSOfqnCrc6bdoYQKH3m0hvxEiAXtATkxJMYkF6bwJe8FTg8mizU0hTHWNGQ72hgSo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8iE12l9JhcKjnjPiTWt4PJU40gu_XQgnm_ldKIf0xPGA&oe=6A3BE2AE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1635499240460081", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619631_1635499243793414_34979520282232832_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cu6QHjBzuFwQ7kNvwEPXsMQ&_nc_oc=AdrVtFoiar0fkfjCphmgDNOjQ3fpdSE7st41CYjsQQLiBFzkloippsE0B4J1TE3ABA8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-GJempWBW5yW1jOKRka3xj_8i0oUtB3zxBepDKYM867w&oe=6A3BF381"}, "display_name": "Carpenter Simulator VR", "keywords": ["woodworkingvr", "carpentersimulatorvr", "furnitureassembly", "blueprintbuilder", "vrworkshop"], "long_description": "Try free and feel the tools. Build real furniture from blueprints\u2014measure, cut, drill and screw each piece into place with clear on-piece guides.\n\nCarpenter Simulator VR brings hands-on woodworking to virtual reality. Start with raw planks, follow simple plans, and assemble step by step. The controls are straightforward, the flow is smooth, and every action feels tactile and satisfying\u2014perfect for short sessions or relaxed build nights.\n\n\u2022 Follow blueprints from start to finish\n\u2022 Use familiar tools: Hammers, screws\n\u2022 Clear snap/placement guides for accurate builds\n\u2022 Short, relaxing builds\u2014easy to pick up, hard to put down\n\n\ud83d\udee0\ufe0f Resolved an issue preventing stamina from recovering after level reload.\n\u26a1 Optimized performance for a smoother gameplay experience.\nHey everyone!\n\nThis update is all about making the game smoother and easier to jump into. We\u2019ve fixed a bunch of annoying bugs to improve overall performance, so things should feel better while you play.\n\nWe also added a quick intro/tutorial at the start to help you get the hang of everything faster\u2014especially if you're new.\n\nIf you run into any issues or have ideas to make the game more fun, feel free to drop us your feedback. We\u2019re always listening and working to improve the experience!\n\nThanks for playing \u2764\ufe0f", "short_description": "Try free: build real furniture in VR. Follow blueprints\u2014measure, cut, drill and screw\u2014fast, tactile, oddly satisfying."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/seivr/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jone Sei", "support_website_url": null, "website_url": "https://sites.google.com/view/seivr/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26567626826190402"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822818_1181787683713744_2557403714749755129_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ryv452PMAo4Q7kNvwGZ3rHP&_nc_oc=Adpwxhu-T1boS8iP1rrro8ciYfLIGRFThCP6cMwWw6plt1_cdPbwB5f2aDWAdKn59-0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8sdNV5aLk85FDXG5R8dJxVsLPKoas73DTLmtgk69-YTQ&oe=6A3BDBBA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Carpenter Simulator VR", "platform": "ANDROID_6DOF", "context_category": {"context_cat
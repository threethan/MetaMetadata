990977_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V0aK9saV0mYQ7kNvwHT1tUo&_nc_oc=AdpW-0WA02WSBYGDYC_bM0ZIpa1qoRl-9jnfhl-KXRBkX1y-iyCAwOF9MU0QAe--1G4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHVLwShytgwv5QjovAh7hCEeNBTd10bHKVztaOr38_ouQ&oe=6A7741E3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Carpenter Simulator VR", "keywords": ["VRCarpentry", "WoodworkingGame", "CraftingSimulator", "FurnitureAssembly", "VirtualWorkshop"], "long_description": "Apprentice Carpenter brings the art of woodworking to life in virtual reality. Using realistic tools like hammers, screwdrivers, and saws, players must assemble wooden furniture based on provided blueprints within a set time limit.\n\nEach completed piece earns points, and players can seamlessly move on to new challenges, refining their skills with each project.\n\nKey Features:\n\n\ud83d\udee0\ufe0f Realistic woodworking tools and physics.\n\n\ud83e\ude91 Multiple furniture models to assemble.\n\n\u23f1\ufe0f Time-based challenges to test your speed and accuracy.\n\n\ud83c\udf10 Seamless, continuous gameplay environment.\n\n\ud83c\udfae Perfect for VR enthusiasts and crafting lovers alike.", "short_description": "Step into the role of an apprentice carpenter in this immersive VR game. Assemble wooden furniture accurately and quickly to prove your craftsmanship in a dynamic woodworking shop."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/seivr/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jone Sei", "support_website_url": null, "website_url": "https://sites.google.com/view/seivr/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_R
j2lqVl891NZXmFKQo6FXQuLWtb4Om7wS4KCeZciNM376PUvuTgIyYzHg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs7ZdtFY9TEtIjby8Sno8z6D7MgC5MvOztI6wDJTvM2PQ&oe=699D9A16"}, {"file_name": "s4.png", "id": "1396091854719255", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393338_1396091861385921_3525921990377182430_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fIV6UIzOiIoQ7kNvwF4SdZy&_nc_oc=Adl0PpctV5aDGADlvV0vUhMNiUvOZlvseRJM6M51pGKG8oSJCJr10SyXr9e6rg84KZE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvC8jwiZ7h8hdU5aoAysByCzfCtlVMwD7JvuPPFJOqrNQ&oe=699D84AB"}, {"file_name": "s2.png", "id": "1134018684852214", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392161_1134018688185547_3373782723112850264_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gH9EluaBrcMQ7kNvwEZcKNk&_nc_oc=AdnSHIJXZlr2UK81atwgLSxmJpIDYQ0XUwNAX07njf-J5-Mkz1XjP9aCc2QuaUeIFGU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuXaDt8K-sqJ60EMG8XWkxpk4CWFpRFqm4l2Lv7_NCLnQ&oe=699DAD45"}, {"file_name": "s1.png", "id": "1117528370164324", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393713_1117528373497657_2336605798937990977_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QrSrC8QZPMQQ7kNvwFQ8DjH&_nc_oc=Adk058c-ghRNVUAH44qp0y4Xf5mMIt4-U3PH3xVa1HiuOdRcIDfB_EzmS_KBit09d1w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuMW-ZA701JOCeS1Cw8-I9u-TVfyhFgKAQP6wbUAxJeCA&oe=699D8223"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Carpenter Simulator VR", "keywords": ["VRCarpentry", "WoodworkingGame", "CraftingSimulator", "FurnitureAssembly", "VirtualWorkshop"], "long_description": "Apprentice Carpenter brings the art of woodworking to life in virtual reality. Using realistic tools like hammers, screwdrivers, and saws, players must assemble wooden furniture based on provided blueprints within a set time limit.\n\nEach completed piece earns points, and players can seamlessly move on to new challenges, refining their skills with each project.\n\nKey Features:\n\n\ud83d\udee0\ufe0f Realistic woodworking tools and physics.\n\n\ud83e\ude91 Multiple furniture models to assemble.\n\n\u23f1\ufe0f Time-based challenges to test your speed and accuracy.\n\n\ud83c\udf10 Seamless, continuous gameplay environment.\n\n\ud83c\udfae Perfect for VR enthusiasts and crafting lovers alike.", "short_description": "Step into the role of an apprentice carpenter in this immersive VR game. Assemble wooden furniture accurately and quickly to prove your craftsmanship in a dynamic woodworking shop."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/seivr/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jone Sei", "support_website_url": null, "website_url": "https://sites.google.com/view/seivr/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9339242429455443"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "1857611981552996"}, {"status": "PUBLISHED", "id": "4189423757974185"}, {"status": "PUBLISHED", "id": "828311693432723"}, {"status": "PUBLISHED", "id": "2540412966314424"}, {"status": "PUBLISHED", "id": "792223953596307"}, {"status": "PUBLISHED", "id": "1733613890678922"}, {"status": "PUBLISHED", "id": "796800583019183"}, {"status": "PUBLISHED", "id": "651832290524265"}]}, "baseline_offer": {"id": "792223953596307"}, "is
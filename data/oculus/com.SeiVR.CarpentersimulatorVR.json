cZTKi4Oio7zo9Q8UoLAbKF4etQ&oe=6A92B175"}, {"file_name": "Screenshot_2560x1440_20260805_231846.png", "id": "2441308409668703", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619751_2441308413002036_8973959924207462142_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a4-P1y4HwsMQ7kNvwH0JM8Y&_nc_oc=AdrxzBHHw4HyBTzfEaRcLT70T4U86rcHpvGQSIf8IGuc1oAjcW14UZx2HWWyn2EpxxI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnc5l5dhVRz3Y1l3u4J800fRlrUnn94RMyIvGDFfG_kw&oe=6A92B4F1"}, {"file_name": "Screenshot_2560x1440_20260805_231916.png", "id": "1323660456632929", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499620860_1323660459966262_7515582810112910856_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q-ZONvZCLvgQ7kNvwF5eTa3&_nc_oc=AdrXsudeNuWQYJcBG287SZnZYzwpO78gTO53Lfc_avmLpaY1mwC4eBCVXx_WFZ5l9Vs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFuArSlPmNIWAt0-6H3t4kPsUutbXT8MQbPhiwYr4NGuQ&oe=6A92BD98"}, {"file_name": "Screenshot_2560x1440_20260805_232159.png", "id": "1071370041984373", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619685_1071370045317706_1329610137611093865_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vLIQbXKJBZgQ7kNvwHFrm49&_nc_oc=AdqmaBUCf9cS1gL_ClXDz--ly51m_hPvkE8gTdlUQ19eccy8uMSsFjFDllB1HpaaMLE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQENbQcg42-UHe6iDjHocNrXvAXSCUjcj06qE1E36r_P3Q&oe=6A92C77B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "lanscape.png", "id": "1004753375939968", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491831569_1004753379273301_5410354648797592328_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=owztBSv8j4AQ7kNvwE-CxZc&_nc_oc=AdrmiNjWMU4Yh3RT5ndBWHFvc87WJ3k0BjABjVX45xBvsBbJvKghp57MHvq0y2U9-Eo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyrlbyfzfWvWxvtbSnbl3OkY0aYs0YJgOG4hyJSTgiXQ&oe=6A92E47E"}, "display_name": "Carpenter Simulator VR", "keywords": ["woodworkingvr", "carpentersimulatorvr", "furnitureassembly", "blueprintbuilder", "vrworkshop"], "long_description": "Try free and feel the tools. Build real furniture from blueprints\u2014measure, cut, drill and screw each piece into place with clear on-piece guides.\n\nCarpenter Simulator VR brings hands-on woodworking to virtual reality. Start with raw planks, follow simple plans, and assemble step by step. The controls are straightforward, the flow is smooth, and every action feels tactile and satisfying\u2014perfect for short sessions or relaxed build nights.\n\n\u2022 Follow blueprints from start to finish\n\u2022 Use familiar tools: Hammers, screws\n\u2022 Clear snap/placement guides for accurate builds\n\u2022 Short, relaxing builds\u2014easy to pick up, hard to put down\n\nUpdate v0.6 - Improved Onboarding, Mechanics & Gameplay Experience\n\nWhat\u2019s New & Fixed:\n\nNew Interactive Tutorial: Added clear, step-by-step guidance at the start to help you get hands-on experience with the basic crafting and building mechanics right away.\n\nCrafting & Building Adjustments: Fixed and smoothed out the initial crafting process so building your very first item is intuitive and rewarding, not frustrating.\n\nGameplay Flow & Progression: Rebalanced early-game \n\nWe\u2019ve been closely listening to all your feedback! We understand that the initial experience had a steep learning curve and a few confusing mechanics. In this update, we\u2019ve implemented major improvements based directly on what you\u2019ve told us:\n", "short_description": "Try free: build real furniture in VR. Follow blueprints\u2014measure, cut, drill and screw\u2014fast, tactile, oddly satisfying."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/seivr/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jone Sei", "support_website_url": null, "website_url": "https://sites.google.com/view/seivr/games", "category": null, "comfort_rating": "COMFORTABLE_FOR
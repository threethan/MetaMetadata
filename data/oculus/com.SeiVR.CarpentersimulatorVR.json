, "id": "1707433490667530", "locale": "en_US", "screenshots": [{"file_name": "5.png", "id": "1009538851326040", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499620476_1009538854659373_792012922816785500_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oZYYG2qzWMAQ7kNvwEpOhE6&_nc_oc=AdoIEAz1iKpn5-b4v7aYRjMXZ2ByDXeYU08tFN5lK9ZH1-8iLIS-7wAB-n15HlV4ZH8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qkw60RHaKZ-d-Hva4qPrppfKzLylBeh4S0C-_NbzbXQ&oe=6A1AE7CC"}, {"file_name": "6.png", "id": "1399136164614663", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499618930_1399136167947996_8653883982299444757_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_iehLaDM5gUQ7kNvwGOM-oV&_nc_oc=Adq6rWFhgmZtFVTirdRNEytrHzqDMIOZ_k4bKGnC7q_BHeW5DVKEtTMVdOYKFthlg4w&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4OdePxrUuz0Th1bY6aXhNQGwd0QHRSWh-eFVRf-muTcA&oe=6A1AF45E"}, {"file_name": "2.png", "id": "2612581769107453", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499618274_2612581772440786_6520813707633238542_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dlYelpIh9VcQ7kNvwHMkAdK&_nc_oc=AdoLItupB1kbDgqFM7DpU-kMtwRe0R0Slr8Xdhemb02ZbOl0BDXdHd5oFc9CViJ8mdA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4cBYRBso-11QKkVCnnxO8Pqg-Uy9IaEriMKeNlRhQMHw&oe=6A1AF1B1"}, {"file_name": "3.png", "id": "623349030778908", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499618089_623349034112241_9121807948883346742_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NW5n0t0iMkwQ7kNvwH-j35B&_nc_oc=AdrPTI0uIayu_Dw3p2QpsXDDCcklCm3Q_xnBsleA9QANHuPR6797j-l_vSa6bI7lm9k&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7HTplyouIe5e40qNPo9_J6-XO6HmtrXxmo0ne_okdTNw&oe=6A1ADE34"}, {"file_name": "4.png", "id": "1253627109441996", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499618464_1253627112775329_6269737204804707692_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KTBtiXzVp90Q7kNvwH-65os&_nc_oc=AdoiarC_7Jbe9vY_3m2oVevSndr6SmbvnfvCRCdmA0bKL3kX0AKZGvUo_RUuikgL99g&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_Mod2fw3fv9v5or9THkwqnrKol_dUMhUHUKeqDCNpsA&oe=6A1AED2E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1635499240460081", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499619631_1635499243793414_34979520282232832_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gz7okdsVO2gQ7kNvwEKJeHN&_nc_oc=AdoqU6n6j47Bkcy9BCQfIt8Zvj7nC3NzrO6GIuLZYBHuKv9rRwVve2k7Y658LTFUee4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4HdsKKPjSIB-_rGBX8UaEVnW-MGl3J--nRZyw-KUcy8g&oe=6A1AFE01"}, "display_name": "Carpenter Simulator VR", "keywords": ["woodworkingvr", "carpentersimulatorvr", "furnitureassembly", "blueprintbuilder", "vrworkshop"], "long_description": "Try free and feel the tools. Build real furniture from blueprints\u2014measure, cut, drill and screw each piece into place with clear on-piece guides.\n\nCarpenter Simulator VR brings hands-on woodworking to virtual reality. Start with raw planks, follow simple plans, and assemble step by step. The controls are straightforward, the flow is smooth, and every action feels tactile and satisfying\u2014perfect for short sessions or relaxed build nights.\n\n\u2022 Follow blueprints from start to finish\n\u2022 Use familiar tools: Hammers, screws\n\u2022 Clear snap/placement guides for accurate builds\n\u2022 Short, relaxing builds\u2014easy to pick up, hard to put down\n\n\ud83d\udee0\ufe0f Resolved an issue preventing stamina from recovering after level reload.\n\u26a1 Optimized performance for a smoother gameplay experience.\nHey everyone!\n\nThis update is all about making the game smoother and easier to jump into. We\u2019ve fixed a bunch of annoying bugs to improve overall performance, so things should feel better while you play.\n\nWe also added a quick intro/tutorial at the start to help you get the hang of everything faster\u2014especially if you're new.\n\nIf you run into any issues or have ideas to make the game more fun, feel free to drop us your feedback. We\u2019re always listening and working to improve the experience!\n\nThanks for playing \u2764\ufe0f", "short_description": "Try free: build real furniture in VR. Follow blueprints\u2014measure, cut, drill and screw\u2014fast, tactile, oddly satisfying."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/seivr/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jone Sei", "support_website_url": null, "website_url": "https://sites.google.com/view/seivr/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26567626826190402"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491822818_1181787683713744_2557403714749755129_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N4sspFF-RuMQ7kNvwHlRAdW&_nc_oc=AdoTmd5tIC5M5KN1wnehwrMmtt8rkxEYlLHtnciM98teTWKH4cPiBswJSQgmu38ZAA8&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4CEkAd8x4oQU0O3jjrP0eqC9jdqZ0q1Vf7ug2z82o-sw&oe=6A1AE63A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Carpenter Simulator VR", "platform": "ANDROID_6DOF", "context_category": {"context_cat
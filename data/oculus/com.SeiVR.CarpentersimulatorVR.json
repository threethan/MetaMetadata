cawqu8bULlatENH7XVd3n-SbDDrzvyc96BLRq63Znhi6EFu73KKv4XAM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AftSpbr9XRM4tQMzABHPdZzZ1q-53VqoetHfSqUmzokLOQ&oe=69A58316"}, {"file_name": "s4.png", "id": "1396091854719255", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393338_1396091861385921_3525921990377182430_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b_t19I_JFLIQ7kNvwGFAXiT&_nc_oc=AdnBDj-Kvh3gwMxlpkLR_UFEggTnbPpjAVGB7nOwDKloizuUg7hjW-6crZzZR1p4yKs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfsEVaYf1YA7F_St7lnZGciLblZjXD06sjK6Cz5SbbUCpA&oe=69A56DAB"}, {"file_name": "s2.png", "id": "1134018684852214", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392161_1134018688185547_3373782723112850264_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NZE3ynWqQdoQ7kNvwE1k96y&_nc_oc=AdkejFHW4iiSqmOmP3bw84ZmQpMvEcTuaB19fPM7ILIltMpqvvsoF9UMyiWnU8ERULc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afs97q2WvlQlyeGqGDcnU9yRdUm7ElGSQ8flC0Nm5LP4cw&oe=69A59645"}, {"file_name": "s1.png", "id": "1117528370164324", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393713_1117528373497657_2336605798937990977_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zKC0CL7x3YoQ7kNvwGoyR1n&_nc_oc=Adk1Ex_La4yOo_uLPtwB5odaOMHsJe38iB2m9Cb9lIkYu58Sbqnb84fDcwpAChq3q3A&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afvk47Pr7O4YYqenFji29MhTR3YN3fF1Ch1C9raZTmfg7Q&oe=69A56B23"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Carpenter Simulator VR", "keywords": ["VRCarpentry", "WoodworkingGame", "CraftingSimulator", "FurnitureAssembly", "VirtualWorkshop"], "long_description": "Apprentice Carpenter brings the art of woodworking to life in virtual reality. Using realistic tools like hammers, screwdrivers, and saws, players must assemble wooden furniture based on provided blueprints within a set time limit.\n\nEach completed piece earns points, and players can seamlessly move on to new challenges, refining their skills with each project.\n\nKey Features:\n\n\ud83d\udee0\ufe0f Realistic woodworking tools and physics.\n\n\ud83e\ude91 Multiple furniture models to assemble.\n\n\u23f1\ufe0f Time-based challenges to test your speed and accuracy.\n\n\ud83c\udf10 Seamless, continuous gameplay environment.\n\n\ud83c\udfae Perfect for VR enthusiasts and crafting lovers alike.", "short_description": "Step into the role of an apprentice carpenter in this immersive VR game. Assemble wooden furniture accurately and quickly to prove your craftsmanship in a dynamic woodworking shop."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/seivr/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jone Sei", "support_website_url": null, "website_url": "https://sites.google.com/view/seivr/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9339242429455443"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "1857611981552996"}, {"status": "PUBLISHED", "id": "4189423757974185"}, {"status": "PUBLISHED", "id": "828311693432723"}, {"status": "PUBLISHED", "id": "2540412966314424"}, {"status": "PUBLISHED", "id": "792223953596307"}, {"status": "PUBLISHED", "id": "1733613890678922"}, {"status": "PUBLISHED", "id": "796800583019183"}, {"status": "PUBLISHED", "id": "651832290524265"}]}, "baseline_offer": {"id": "792223953596307"}, "is
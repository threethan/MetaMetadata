7a30f&oh=00_Af1Rn15zViENYTIgMUkGyFmsIouuXJ193WWPq2v00UD-gg&oe=69DA5245"}, {"file_name": "s1.png", "id": "1117528370164324", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393713_1117528373497657_2336605798937990977_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R__FsxopNC8Q7kNvwGb_eLG&_nc_oc=AdqQ3JCpOKCCRxf4Oa1uLvi96Yw1S62My9reoimonU05HDXZmnOqlhLt2mqgFpSSJpM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1qv6FChUMQQrHB1kU1_jx48l8jZxEnLogQaoNDHtKrNQ&oe=69DA5F63"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Carpenter Simulator VR", "keywords": ["VRCarpentry", "WoodworkingGame", "CraftingSimulator", "FurnitureAssembly", "VirtualWorkshop"], "long_description": "Apprentice Carpenter brings the art of woodworking to life in virtual reality. Using realistic tools like hammers, screwdrivers, and saws, players must assemble wooden furniture based on provided blueprints within a set time limit.\n\nEach completed piece earns points, and players can seamlessly move on to new challenges, refining their skills with each project.\n\nKey Features:\n\n\ud83d\udee0\ufe0f Realistic woodworking tools and physics.\n\n\ud83e\ude91 Multiple furniture models to assemble.\n\n\u23f1\ufe0f Time-based challenges to test your speed and accuracy.\n\n\ud83c\udf10 Seamless, continuous gameplay environment.\n\n\ud83c\udfae Perfect for VR enthusiasts and crafting lovers alike.", "short_description": "Step into the role of an apprentice carpenter in this immersive VR game. Assemble wooden furniture accurately and quickly to prove your craftsmanship in a dynamic woodworking shop."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/seivr/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jone Sei", "support_website_url": null, "website_url": "https://sites.google.com/view/seivr/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_cate
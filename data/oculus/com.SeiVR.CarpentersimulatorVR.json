, "id": "1707433490667530", "locale": "en_US", "screenshots": [{"file_name": "5.png", "id": "1009538851326040", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499620476_1009538854659373_792012922816785500_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A4FhWdKjKxwQ7kNvwEe7psN&_nc_oc=AdqWqo5gUHjic48qFxEwvL2OJI_sjSAP1d9eW2KWwSluUV_Ytv0GmClJJ_ENDmo1Mn4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af37SkpZZAJYFeqyYDfZVzx9pjE12hYT61MvOjjTjhRuVA&oe=69F35ACC"}, {"file_name": "6.png", "id": "1399136164614663", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618930_1399136167947996_8653883982299444757_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7QoSqmnF9oAQ7kNvwEEm9nS&_nc_oc=Adqtok9sI7mit_uxS9YPYrUc6dxSssv9hj8P133EpOr814fTj6KP8yf1puB7dzoDASI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af03QSWXM_7xjek8_KNe0HytOnrWDXavaJ-42SUM1I1Z4Q&oe=69F3675E"}, {"file_name": "2.png", "id": "2612581769107453", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618274_2612581772440786_6520813707633238542_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mDvLe_MA_iAQ7kNvwEFfHw-&_nc_oc=AdqizAjTvlC5RF9bEDAgk7rqDlaIAUXR7vpaHJJVuo0SSAEos4It2reMmbdozTzb2PQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1IOCZSa5iHBQrEySwOIAdL6hqj35JXUuv87Rnflg947g&oe=69F364B1"}, {"file_name": "3.png", "id": "623349030778908", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499618089_623349034112241_9121807948883346742_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W_j_Cxr2708Q7kNvwGSAN-4&_nc_oc=AdpLvQ7FcxUx93FB9l25Z78NrG33LG-CN0kVUrLUtNR5S2JsEovuHOSxtBtXFeX1HuM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af29wvEWhl_lC4-xlNA2TowoOB5RHjWdzOZYq3rT7lyE8Q&oe=69F35134"}, {"file_name": "4.png", "id": "1253627109441996", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618464_1253627112775329_6269737204804707692_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-6b6evSSe7oQ7kNvwG8xFFu&_nc_oc=AdoPKNboWSS8byAbPYN1P1su_A5DAYohA45upwUUCAq_qNFSvg2tQ1qjk_0VxoQEe78&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1eQELPQywU_n8-r5eTwZxZNAMtVEcl6P2NRv2T1T3Xrw&oe=69F3602E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1635499240460081", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499619631_1635499243793414_34979520282232832_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-CrknptBBLkQ7kNvwHXsAP7&_nc_oc=AdpzBxrrkqiZJLcTc_LJnqpQKu8R7bxjjSJsLanIwIx1r3GfclAqjfOFH39124vBUes&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2-a2eR8hErE7nuWM2Xi0bj2MK5uqXlLcfaaOw67ds87w&oe=69F37101"}, "display_name": "Carpenter Simulator VR", "keywords": ["woodworkingvr", "carpentersimulatorvr", "furnitureassembly", "blueprintbuilder", "vrworkshop"], "long_description": "Try free and feel the tools. Build real furniture from blueprints\u2014measure, cut, drill and screw each piece into place with clear on-piece guides.\n\nCarpenter Simulator VR brings hands-on woodworking to virtual reality. Start with raw planks, follow simple plans, and assemble step by step. The controls are straightforward, the flow is smooth, and every action feels tactile and satisfying\u2014perfect for short sessions or relaxed build nights.\n\n\u2022 Follow blueprints from start to finish\n\u2022 Use familiar tools: Hammers, screws\n\u2022 Clear snap/placement guides for accurate builds\n\u2022 Short, relaxing builds\u2014easy to pick up, hard to put down\n\n\ud83d\udee0\ufe0f Resolved an issue preventing stamina from recovering after level reload.\n\u26a1 Optimized performance for a smoother gameplay experience.\nHey everyone!\n\nThis update is all about making the game smoother and easier to jump into. We\u2019ve fixed a bunch of annoying bugs to improve overall performance, so things should feel better while you play.\n\nWe also added a quick intro/tutorial at the start to help you get the hang of everything faster\u2014especially if you're new.\n\nIf you run into any issues or have ideas to make the game more fun, feel free to drop us your feedback. We\u2019re always listening and working to improve the experience!\n\nThanks for playing \u2764\ufe0f", "short_description": "Try free: build real furniture in VR. Follow blueprints\u2014measure, cut, drill and screw\u2014fast, tactile, oddly satisfying."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/seivr/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jone Sei", "support_website_url": null, "website_url": "https://sites.google.com/view/seivr/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26567626826190402"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491822818_1181787683713744_2557403714749755129_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OBUQBlY2Gz0Q7kNvwFa7k9y&_nc_oc=Adpc3618KnPu7EU9d5FKAtyawvw030OeBdJ2RZvy4ts4Lej8w4E2KXCc_ag_UPeJ1Xs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1CNGF1ExAv_VDxD9oGRFcm7DZjs6zJyWZSbIBThvIO2g&oe=69F3593A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Carpenter Simulator VR", "platform": "ANDROID_6DOF", "context_category": {"context_cat
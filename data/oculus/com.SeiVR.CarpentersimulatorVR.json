BCUwTXkL9zlyVQ8L3n4PkQDKampbqDgo_Lg&oe=69DA44B4"}, {"file_name": "4.png", "id": "1253627109441996", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618464_1253627112775329_6269737204804707692_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qe9d-oYt6WcQ7kNvwGzepzo&_nc_oc=AdpH8Vp4Pl4EqrpM6QqQa4Lu7Hsi0BsIyv_jIIS14BUrH_lZmPoBWT2Llt7NXRRAkRI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2rWCB91R-G-ao7m98I5ghc7qQvY5uwcPQRAQLLoHKROQ&oe=69DA53AE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1635499240460081", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619631_1635499243793414_34979520282232832_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-14taS5Fn2oQ7kNvwFw_uZt&_nc_oc=AdqIEA80Ge0uxawx1WL59IYZ3MHQZl2iB5h_wVZybtYwryM7XcOYMdMd6uukVY2ssm4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3wz7IvNxP_8r_qec1RRRl63mUN6eMdDX9U9jEqico5JA&oe=69DA2C41"}, "display_name": "Carpenter Simulator VR", "keywords": ["woodworkingvr", "carpentersimulatorvr", "furnitureassembly", "blueprintbuilder", "vrworkshop"], "long_description": "Try free and feel the tools. Build real furniture from blueprints\u2014measure, cut, drill and screw each piece into place with clear on-piece guides.\n\nCarpenter Simulator VR brings hands-on woodworking to virtual reality. Start with raw planks, follow simple plans, and assemble step by step. The controls are straightforward, the flow is smooth, and every action feels tactile and satisfying\u2014perfect for short sessions or relaxed build nights.\n\n\u2022 Follow blueprints from start to finish\n\u2022 Use familiar tools: Hammers, screws\n\u2022 Clear snap/placement guides for accurate builds\n\u2022 Short, relaxing builds\u2014easy to pick up, hard to put down\n\n\ud83d\udee0\ufe0f Resolved an issue preventing stamina from recovering after level reload.\n\u26a1 Optimized performance for a smoother gameplay experience.\nHey everyone!\n\nThis update is all about making the game smoother and easier to jump into. We\u2019ve fixed a bunch of annoying bugs to improve overall performance, so things should feel better while you play.\n\nWe also added a quick intro/tutorial at the start to help you get the hang of everything faster\u2014especially if you're new.\n\nIf you run into any issues or have ideas to make the game more fun, feel free to drop us your feedback. We\u2019re always listening and working to improve the experience!\n\nThanks for playing \u2764\ufe0f", "short_description": "Try free: build real furniture in VR. Follow blueprints\u2014measure, cut, drill and screw\u2014fast, tactile, oddly satisfying."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/seivr/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jone Sei", "support_website_url": null, "website_url": "https://sites.google.com/view/seivr/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "377978390272490"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26557558107197274"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822818_1181787683713744_2557403714749755129_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oyI2XN3nDWIQ7kNvwGEMriq&_nc_oc=AdoncPYCgdvFhmMA3C7T9QrpDvGFF5tvQM2h6N4nmOXhh8lNtGCtlB34E3klxzGbHC8&_nc_z
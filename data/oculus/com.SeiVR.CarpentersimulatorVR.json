https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620817_1776165553393755_1410842161785866861_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HsHoDm6PKUAQ7kNvwE54ucL&_nc_oc=AdpBalvEHGbXjbwOX-oFUHDJM60Xm8-lcf_EoTR3sqaFJcSaipOLue7RBq-PhNwlrxc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCXIxdFttHGJ7Yy1SI4SYypC-JLnh9Aix8826eU8ys4Q&oe=6B09C8F5"}, {"file_name": "Screenshot_2560x1440_20260805_231846.png", "id": "2441308409668703", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619751_2441308413002036_8973959924207462142_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_tfPfjqfnx4Q7kNvwHF2jCU&_nc_oc=Adp-UJ7FdqqYRKcpUeqV1azh7Ug2JEJVkA3oxyxWHpcW-TkMQ2fMU7SGlWAI2NLBQic&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHI5VhgrgPLMyaVDb7KJcNplxAkUYMq0a0oebJmyY9OQ&oe=6B09CC71"}, {"file_name": "Screenshot_2560x1440_20260805_231916.png", "id": "1323660456632929", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620860_1323660459966262_7515582810112910856_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IToSPqpP-lIQ7kNvwHMr-HP&_nc_oc=Ado0kCBgaFuU7YwsuyRQ-MdQsMSf7CW73680rJA-jRUKslKN3Ngje9NDQzFuXPU7kr8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwFfmKzhwQoz8XXrXBP6hjt--K50jPHpak0zdyHM5E5w&oe=6B099CD8"}, {"file_name": "Screenshot_2560x1440_20260805_232159.png", "id": "1071370041984373", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619685_1071370045317706_1329610137611093865_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UhyvUE3yquYQ7kNvwGnzyrJ&_nc_oc=AdoSxDlZEoza6ol1r5tvcWjsbdIH-z1ew0SA_UwjqDpRtZv0CeE5vmVtOQR1_M93fhU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUYuO_C1zcVLlsmdv8C5PvSfegQ1oQFJ9ljRgFTj9vDQ&oe=6B09A6BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "lanscape.png", "id": "1004753375939968", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491831569_1004753379273301_5410354648797592328_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bPjeFaawecoQ7kNvwGGR3ns&_nc_oc=Adq4maAGK1ftoYtDJkOHsYVAR0xCDvZB1MxnF7Jcy6xLfL8EfRO4piBaBhn5Cm58NHk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRi_IKm0wloMPDVPo3_aTgOSYE0KfRCacAfHTrdyNrqlQ&oe=6B09C3BE"}, "display_name": "Carpenter Simulator VR", "keywords": ["woodworkingvr", "carpentersimulatorvr", "furnitureassembly", "blueprintbuilder", "vrworkshop"], "long_description": "Try free and feel the tools. Build real furniture from blueprints\u2014measure, cut, drill and screw each piece into place with clear on-piece guides.\n\nCarpenter Simulator VR brings hands-on woodworking to virtual reality. Start with raw planks, follow simple plans, and assemble step by step. The controls are straightforward, the flow is smooth, and every action feels tactile and satisfying\u2014perfect for short sessions or relaxed build nights.\n\n\u2022 Follow blueprints from start to finish\n\u2022 Use familiar tools: Hammers, screws\n\u2022 Clear snap/placement guides for accurate builds\n\u2022 Short, relaxing builds\u2014easy to pick up, hard to put down\n\nUpdate v0.6 - Improved Onboarding, Mechanics & Gameplay Experience\n\nWhat\u2019s New & Fixed:\n\nNew Interactive Tutorial: Added clear, step-by-step guidance at the start to help you get hands-on experience with the basic crafting and building mechanics right away.\n\nCrafting & Building Adjustments: Fixed and smoothed out the initial crafting process so building your very first item is intuitive and rewarding, not frustrating.\n\nGameplay Flow & Progression: Rebalanced early-game \n\nWe\u2019ve been closely listening to all your feedback! We understand that the initial experience had a steep learning curve and a few confusing mechanics. In this update, we\u2019ve implemented major improvements based directly on what you\u2019ve told us:\n", "short_d
, "id": "1707433490667530", "locale": "en_US", "screenshots": [{"file_name": "5.png", "id": "1009538851326040", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499620476_1009538854659373_792012922816785500_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oZYYG2qzWMAQ7kNvwH7mr-r&_nc_oc=AdrlN5E2cyYJ13Rr_mPNzL99j-_dLPHVbxuMB5fSjXO-wvQqQHsEpx0iwMd0VJyvKIs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7WQ6P6IVJ6fUaw42qclCnlyvL4GONFCqp9WJHxaZxYDg&oe=6A1D8ACC"}, {"file_name": "6.png", "id": "1399136164614663", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618930_1399136167947996_8653883982299444757_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QjlWmg6332oQ7kNvwFfag-w&_nc_oc=Adr8kswI4_K8B-0cChVremXU9EYCyH5aaYBIx9CfaXqau8hiETthI1116SCHBXh8coY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7fCFBdLXzxQOXNzScjItG3UQ7Ajv4PT91lG9PeZP6rnw&oe=6A1D975E"}, {"file_name": "2.png", "id": "2612581769107453", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618274_2612581772440786_6520813707633238542_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cxqwn8YTvAMQ7kNvwEGhLI1&_nc_oc=AdruayvRbqWtb-o2kU4_JfzypjisqIPl8QWfoZnvf_1LZmmocSBuOf_jfDUYDAV-IUM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6BkmiEy_AZ8SFvyRItot0AcX1qGVKuCkQJDuy7bP9NzQ&oe=6A1D94B1"}, {"file_name": "3.png", "id": "623349030778908", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618089_623349034112241_9121807948883346742_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CnnGKIyO-sgQ7kNvwGss393&_nc_oc=Adoq6_7LyR-DPvU39CCduU8aKe2rUiRIgEoJ0Nkx7iuJq0am214LzvUKwqBf030J1N4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7of7GxEFvB8taAuIOL21gcSU8iWjEiT9tupVcZFG_d-A&oe=6A1D8134"}, {"file_name": "4.png", "id": "1253627109441996", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618464_1253627112775329_6269737204804707692_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fQb1y8K3SNQQ7kNvwH7e-P_&_nc_oc=AdpX-rEsdE7caZPhOU_8e_b3wbwlJyl-psIecd9YQKQJF-83_6Y1gjVdkIoQB9p1uN8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5JMfhcQd-0Us45QmkyIiGBh1-25do-3Fkoss7CAmJ80A&oe=6A1D902E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1635499240460081", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619631_1635499243793414_34979520282232832_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-iGh-jMxSQgQ7kNvwFn3XW2&_nc_oc=AdprgEMFpVO75168RYxh4UvcUO2leHMpA0koVvHFiztXhJ3v6uvke5G_Ykt7kumFq9w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6nmB2kVJdNzNFxRhqnZTw5Ehc_yHYV-tKuEtghZjG9fQ&oe=6A1DA101"}, "display_name": "Carpenter Simulator VR", "keywords": ["woodworkingvr", "carpentersimulatorvr", "furnitureassembly", "blueprintbuilder", "vrworkshop"], "long_description": "Try free and feel the tools. Build real furniture from blueprints\u2014measure, cut, drill and screw each piece into place with clear on-piece guides.\n\nCarpenter Simulator VR brings hands-on woodworking to virtual reality. Start with raw planks, follow simple plans, and assemble step by step. The controls are straightforward, the flow is smooth, and every action feels tactile and satisfying\u2014perfect for short sessions or relaxed build nights.\n\n\u2022 Follow blueprints from start to finish\n\u2022 Use familiar tools: Hammers, screws\n\u2022 Clear snap/placement guides for accurate builds\n\u2022 Short, relaxing builds\u2014easy to pick up, hard to put down\n\n\ud83d\udee0\ufe0f Resolved an issue preventing stamina from recovering after level reload.\n\u26a1 Optimized performance for a smoother gameplay experience.\nHey everyone!\n\nThis update is all about making the game smoother and easier to jump into. We\u2019ve fixed a bunch of annoying bugs to improve overall performance, so things should feel better while you play.\n\nWe also added a quick intro/tutorial at the start to help you get the hang of everything faster\u2014especially if you're new.\n\nIf you run into any issues or have ideas to make the game more fun, feel free to drop us your feedback. We\u2019re always listening and working to improve the experience!\n\nThanks for playing \u2764\ufe0f", "short_description": "Try free: build real furniture in VR. Follow blueprints\u2014measure, cut, drill and screw\u2014fast, tactile, oddly satisfying."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/seivr/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jone Sei", "support_website_url": null, "website_url": "https://sites.google.com/view/seivr/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26567626826190402"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822818_1181787683713744_2557403714749755129_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N4sspFF-RuMQ7kNvwG0U4ld&_nc_oc=AdrmPzVeToyfNL4EHvvlYu15n5GQOvXxL5JdMh4xm4za0kn1caaYCOfUIhza6YqRkSU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af69R7_Dn6CCx93NHYOt_9BPMCtyKCTsRdxEOSlf4sVRMg&oe=6A1D893A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Carpenter Simulator VR", "platform": "ANDROID_6DOF", "context_category": {"context_cat
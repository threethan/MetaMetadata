om/v/t64.5771-25/499618464_1253627112775329_6269737204804707692_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eyopsf51LVQQ7kNvwFSWpB4&_nc_oc=Adp1yX8VCFf1uV5-Zi3j3eAI_bsVhd38TRQLatdcbVljrdWAQfvnBDc7rmdJmIvtkVI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELLVPQlz-caSSqWOhZrzjpSxpRJrVlas2mvMVvI11ELQ&oe=6A7B2AAE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1635499240460081", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619631_1635499243793414_34979520282232832_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Cl_Mb2h0kAQ7kNvwHzl_Sk&_nc_oc=AdqSiuETpsXao3wL4AWRnOxxsRS_JFJe-b_TjvQQWaL2l7RHXAMYfRwva8TphzeQaVs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHfG1mZ6_bzP7tbOyM5uwvj_yUv3133ymC__LZIrzouQA&oe=6A7B3B81"}, "display_name": "Carpenter Simulator VR", "keywords": ["woodworkingvr", "carpentersimulatorvr", "furnitureassembly", "blueprintbuilder", "vrworkshop"], "long_description": "Try free and feel the tools. Build real furniture from blueprints\u2014measure, cut, drill and screw each piece into place with clear on-piece guides.\n\nCarpenter Simulator VR brings hands-on woodworking to virtual reality. Start with raw planks, follow simple plans, and assemble step by step. The controls are straightforward, the flow is smooth, and every action feels tactile and satisfying\u2014perfect for short sessions or relaxed build nights.\n\n\u2022 Follow blueprints from start to finish\n\u2022 Use familiar tools: Hammers, screws\n\u2022 Clear snap/placement guides for accurate builds\n\u2022 Short, relaxing builds\u2014easy to pick up, hard to put down\n\n\ud83d\udee0\ufe0f Resolved an issue preventing stamina from recovering after level reload.\n\u26a1 Optimized performance for a smoother gameplay experience.\nHey everyone!\n\nThis update is all about making the game smoother and easier to jump into. We\u2019ve fixed a bunch of annoying bugs to improve overall performance, so things should feel better while you play.\n\nWe also added a quick intro/tutorial at the start to help you get the hang of everything faster\u2014especially if you're new.\n\nIf you run into any issues or have ideas to make the game more fun, feel free to drop us your feedback. We\u2019re always listening and working to improve the experience!\n\nThanks for playing \u2764\ufe0f", "short_description": "Try free: build real furniture in VR. Follow blueprints\u2014measure, cut, drill and screw\u2014fast, tactile, oddly satisfying."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/seivr/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jone Sei", "support_website_url": null, "website_url": "https://sites.google.com/view/seivr/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26567626826190402"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822818_1181787683713744_2557403714749755129_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vPyi9_Or1WIQ7kNvwHM3ldn&_nc_oc=Adp7NzsvMQ_hXU8kfE1CyuK-B-7YS_O2-C-GajmPx51nXPjtkVnBqvC5kum_qglTXns&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGEOCW4lmkIQF2IyYuvjoG4tF_TO38w0q093CzC_OXOCw&oe=6A7B23BA"}, "is_concept": false, "is_test": false, "is_trial_
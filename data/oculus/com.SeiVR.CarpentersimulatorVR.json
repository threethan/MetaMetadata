75253_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wgb21wXw2yMQ7kNvwFfNOHS&_nc_oc=AdqFGgCALbMVu7xTVUMGIY0sQfIAIbXIsGeyDWWN5pP9zyUqklWiGA01q0e6ISGa2wE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWKprBkF9mjd2TvtCnmKNz61Eu1zyo7oIRiJRkNWyHKxA&oe=6B104DFC"}, {"file_name": "CarpenterSimulatorVR_Screenshot_05_2560x1440.png", "id": "2063591974356364", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908839696_2063591977689697_1511492200861590757_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T3xhSFQ5O6cQ7kNvwFPa3em&_nc_oc=AdrF56MEOEUKNhWgIQmpOLs_NM6_yaUj6YgXtF6uDUCeSUfBLN4rDxqb0SD1l9Hw6TQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUrrtLO7TDvHH1nrRLeqqyRLikT0SZRBOctrM7wJzFXDA&oe=6B103845"}, {"file_name": "CarpenterSimulatorVR_Screenshot_02_2560x1440.png", "id": "2147675309190142", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/908839691_2147675312523475_9177631955507279614_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pijf4beWx6AQ7kNvwH2fCmT&_nc_oc=Adq7ZjGVd9vPivldWWy5PHb2nWdXMfFF1yjzP63DgVxIebdoiSkxvNKqz7vu1l1N3r8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUSXq2HBxJ7992UBGrFBIQdqPa_Hjio8OMy1RftnmB3Aw&oe=6B105D55"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CarpenterSimulatorVR_Cover_Landscape_2560x1440.png", "id": "1680312743454795", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/908839656_1680312746788128_7397349387782510965_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dKa0VOSUynIQ7kNvwE3roC8&_nc_oc=Adru8l7x8yAx5hD3aAzQCyQHiow0unrbZjJbBSnI7vb5adY4GxT0h3X1_cOKE2v0CQY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXpvzWc6mIZlyh1t9T_s3C1oeBLoUn4TdyPeXFJWUGK3w&oe=6B103473"}, "display_name": "Carpenter Simulator VR", "keywords": ["woodworking", "workshop", "cozy", "crafting", "sandbox"], "long_description": "Grab your apron and step into a sunlit, **100% hands-on VR woodworking studio**! Whether you want to relax to soothing woodshop ASMR or engineer rock-solid custom furniture from raw timber, **Carpenter Simulator VR** puts authentic craft tools directly in your hands.\n\n{29585022714515688}\n\n- **Saw & Clamp:** Lock planks in the vise and pull your **Ryoba Saw** to slice real 3D timber in half.\n- **Hammer & Pry:** Drive nails in 4 tactile strikes to weld joints solid\u2014or pry mistakes right back out with the hammer claw!\n- **Sand, Spray & Stamp:** Polish rough wood grain smooth, paint with **24 spray colors**, and apply **12 custom stamps**.\n\n{1155821210164047}\n\nNo flat menus! Flip metal toggle switches, pull the lamp cord for **3 lighting moods**, grab nails straight from jars, and **slam the Brass Bell** to submit builds.\n\n{41157857567134815}\n\n- **Blueprint Campaign (10 Levels + Tutorial):** Craft Japanese-inspired joinery furniture\u2014or flip **Cozy Mode** ON for zero timers.\n- **Free Sandbox & Commissions:** Build freely with **8 timber shapes** & **7 wood grains**, pass the shaking **Physics Stress Test** across **8 client orders**, and fill your **Polaroid Gallery**.\n- **Workshop Arcade:** Unwind with *Rhythm Peg Hammer*, *Vortex Disc Toss*, and *Balance Tower Stack*.\n\n**VR Comfort Ready:** Play **seated or standing** with Distance Grab, Auto-Snap Assist, Vignette Turn, and spatial ASMR audio.", "short_description": "Grab your pull saw, hammer, and spray can\u2014your cozy VR woodshop is open! Physically saw timber in half, clamp planks in a vise, drive or pry out nails, sand rough grain smooth, and customize builds with 24 paint colors and 12 artisan stamps. Master 10 blueprint furniture levels, fulfill relaxed client commissions, stress-test wild creations in Free Sandbox, or unwind with 3 workshop minigames. Play seated or standing with tactile haptics and soothing 3D ASMR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://
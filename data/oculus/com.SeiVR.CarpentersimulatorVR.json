, "id": "1707433490667530", "locale": "en_US", "screenshots": [{"file_name": "5.png", "id": "1009538851326040", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620476_1009538854659373_792012922816785500_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9mmMmbtxDsEQ7kNvwFlqaMg&_nc_oc=AdpoRHzqnY6xcdDrr9HGPpMdLhjouGSvtC5XlirWWBrXY5JtHUuddd7MVfTwSEQRAkw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af24F6HYR4pmzXb8n9YOL8wLcQDLoYWIJdFgGVtfC0xqnA&oe=69E388CC"}, {"file_name": "6.png", "id": "1399136164614663", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618930_1399136167947996_8653883982299444757_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QjQLCOKB0DsQ7kNvwETq6aL&_nc_oc=AdqsZPDE6i4YGYEMEVVe9A14Zqly4En0r03d4qb9qIxBgzb_ZR103pVaoIFyqPA-04E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1h9CCq_4_2vyRl52_oHBeJMwFIx0ViS3aIcKO4xops4Q&oe=69E3955E"}, {"file_name": "2.png", "id": "2612581769107453", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618274_2612581772440786_6520813707633238542_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PM1JoA7wRQ0Q7kNvwG2W1Od&_nc_oc=AdpRKFIoG8LB54u9s2Rgz2PuChVnyn2_KFVH4P-0wO7HhO-NXHyzCgiN2BTEasR2sSI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3XL_rUBnv8yDcYym_nu9_Ko8iq9ggZtfGT1B2qv1iLjQ&oe=69E392B1"}, {"file_name": "3.png", "id": "623349030778908", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618089_623349034112241_9121807948883346742_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IHHfcziJDogQ7kNvwFeTG1k&_nc_oc=Ado1uWDK-cJG9gB0z5uIlGc6FiAphEgcH9Uy86G7Kgr2ipmqKQ8oBEq17diFFZ36K50&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2sKYwO52-LgdMsprSNlLRsyvwh2YhaaH6GL_WG0GqAXw&oe=69E37F34"}, {"file_name": "4.png", "id": "1253627109441996", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618464_1253627112775329_6269737204804707692_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CCWrLx7vbgMQ7kNvwH3vY8F&_nc_oc=Adp6IIfkWDbvloYn_O4-SYUrMEZVfmMleeo6s9AIoJ33jQPqjaM04ZBddF9j73eJJY0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3q46Zvi3nVAFbzS3l3cudCcxtci29u3qLw8QlwPdjoyw&oe=69E38E2E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1635499240460081", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619631_1635499243793414_34979520282232832_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cOot3gtkgWMQ7kNvwFriUal&_nc_oc=Adq96m8_kMI3rYlL6WdczbEwXfjbNYtTj3UeEGyuXGcOJWhtEZcH9BhCknCJvJ2OvXM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2LMcafeyMOpysg8sqdyvzCI6jeyp3CoFNJvN7lfQRq0g&oe=69E366C1"}, "display_name": "Carpenter Simulator VR", "keywords": ["woodworkingvr", "carpentersimulatorvr", "furnitureassembly", "blueprintbuilder", "vrworkshop"], "long_description": "Try free and feel the tools. Build real furniture from blueprints\u2014measure, cut, drill and screw each piece into place with clear on-piece guides.\n\nCarpenter Simulator VR brings hands-on woodworking to virtual reality. Start with raw planks, follow simple plans, and assemble step by step. The controls are straightforward, the flow is smooth, and every action feels tactile and satisfying\u2014perfect for short sessions or relaxed build nights.\n\n\u2022 Follow blueprints from start to finish\n\u2022 Use familiar tools: Hammers, screws\n\u2022 Clear snap/placement guides for accurate builds\n\u2022 Short, relaxing builds\u2014easy to pick up, hard to put down\n\n\ud83d\udee0\ufe0f Resolved an issue preventing stamina from recovering after level reload.\n\u26a1 Optimized performance for a smoother gameplay experience.\nHey everyone!\n\nThis update is all about making the game smoother and easier to jump into. We\u2019ve fixed a bunch of annoying bugs to improve overall performance, so things should feel better while you play.\n\nWe also added a quick intro/tutorial at the start to help you get the hang of everything faster\u2014especially if you're new.\n\nIf you run into any issues or have ideas to make the game more fun, feel free to drop us your feedback. We\u2019re always listening and working to improve the experience!\n\nThanks for playing \u2764\ufe0f", "short_description": "Try free: build real furniture in VR. Follow blueprints\u2014measure, cut, drill and screw\u2014fast, tactile, oddly satisfying."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/seivr/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jone Sei", "support_website_url": null, "website_url": "https://sites.google.com/view/seivr/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26567626826190402"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822818_1181787683713744_2557403714749755129_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5kAdaK9eBXoQ7kNvwGQkA-X&_nc_oc=AdpcKqu-9GFaMzujmxNqN8o7pVia-JLB2gevetUiAYGA_aspwUm3Tllk-9Lz2yHUanY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0F-vKKZzjd6v84NHojLyj__qQY8xab6U9crj00jlyNkA&oe=69E3873A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Carpenter Simulator VR", "platform": "ANDROID_6DOF", "context_category": {"context_cat
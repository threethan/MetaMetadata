oDt2p2bbPWAwhnkFOz8gO07JKg&oe=6AA16A35"}, {"file_name": "Screenshot_2560x1440_20260805_231846.png", "id": "2441308409668703", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499619751_2441308413002036_8973959924207462142_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nIWBBk-SmTgQ7kNvwFrNAGJ&_nc_oc=AdqJn4TniLY8_dZm_ISbo8w6SqnuNyWNJO0ZqtBDhj2sSCFJwxi-oJlFr5oi-5TEXf8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLBVal7NgsI6xRxZYSndCd8iDuADlMJ8HsQ5hUsp0VF6w&oe=6AA16DB1"}, {"file_name": "Screenshot_2560x1440_20260805_231916.png", "id": "1323660456632929", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499620860_1323660459966262_7515582810112910856_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hNA89w7F0oIQ7kNvwHfzL9z&_nc_oc=Adqq0XURSgJShRcTViQMrodIHRX4Cd41aR9QUT6cDWTBdpRVQYpenMVHe7RUgeFUicQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJj_wSStWS2gFjQoh4IeUnyIUNaHY2z36HmE5gQ-ytaEQ&oe=6AA17658"}, {"file_name": "Screenshot_2560x1440_20260805_232159.png", "id": "1071370041984373", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499619685_1071370045317706_1329610137611093865_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KTr19c2cj_QQ7kNvwH7A9fs&_nc_oc=AdqXJee9B5EA3gItHjkONARSPebty36pyyHS5nKj5-WXAYgZ_vPiQf63W5RkSEMTkRQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWTpRCjWja32DcF2OnMW20CAuY9k25eUS1r9jBkP1QNg&oe=6AA1803B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "lanscape.png", "id": "1004753375939968", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491831569_1004753379273301_5410354648797592328_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=21WSm3iFi1YQ7kNvwGSPHIH&_nc_oc=AdorDs0E8Wzw7RQ-aQQFt64uYcRs8Z2nfVy0Q50IRGm9tpdIBdNtc36O_CfDMwPTYKU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKcjuiXGteTfuWEhI2Av-4qRlAOhzCp_27Kha29wze0_g&oe=6AA164FE"}, "display_name": "Carpenter Simulator VR", "keywords": ["woodworkingvr", "carpentersimulatorvr", "furnitureassembly", "blueprintbuilder", "vrworkshop"], "long_description": "Try free and feel the tools. Build real furniture from blueprints\u2014measure, cut, drill and screw each piece into place with clear on-piece guides.\n\nCarpenter Simulator VR brings hands-on woodworking to virtual reality. Start with raw planks, follow simple plans, and assemble step by step. The controls are straightforward, the flow is smooth, and every action feels tactile and satisfying\u2014perfect for short sessions or relaxed build nights.\n\n\u2022 Follow blueprints from start to finish\n\u2022 Use familiar tools: Hammers, screws\n\u2022 Clear snap/placement guides for accurate builds\n\u2022 Short, relaxing builds\u2014easy to pick up, hard to put down\n\nUpdate v0.6 - Improved Onboarding, Mechanics & Gameplay Experience\n\nWhat\u2019s New & Fixed:\n\nNew Interactive Tutorial: Added clear, step-by-step guidance at the start to help you get hands-on experience with the basic crafting and building mechanics right away.\n\nCrafting & Building Adjustments: Fixed and smoothed out the initial crafting process so building your very first item is intuitive and rewarding, not frustrating.\n\nGameplay Flow & Progression: Rebalanced early-game \n\nWe\u2019ve been closely listening to all your feedback! We understand that the initial experience had a steep learning curve and a few confusing mechanics. In this update, we\u2019ve implemented major improvements based directly on what you\u2019ve told us:\n", "short_description": "Try free: build real furniture in VR. Follow blueprints\u2014measure, cut, drill and screw\u2014fast, tactile, oddly satisfying."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/seivr/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jone Sei", "support_website_url": null, "website_url": "https://sites.google.com/view/seivr/games", "category": null, "comfort_rating": "COMFORTABLE_FOR
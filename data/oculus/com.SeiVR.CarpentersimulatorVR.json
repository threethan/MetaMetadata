UHvehuX8e2CdDj-fw7EsVnASH4YjyzCro5K0c1EbDbNdzZcmn6_pKVj0&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afu0mZY3W7akEoEJ05NPK3ubvzvg5HS2dD7G5oHAnewZ9A&oe=69A18E96"}, {"file_name": "s4.png", "id": "1396091854719255", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/473393338_1396091861385921_3525921990377182430_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k1H_uYxTMGwQ7kNvwE2KMyS&_nc_oc=AdlNd8iRlBTqDjq4g44ww48kRiAiqfxPTH6F1Zyg4y3JKuo_3085JOv89N5B8pmIcuY&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfvflrLE-8UFKtyI6z8tbtOA9AjOaP25_ihiYmDq9AhY3g&oe=69A1792B"}, {"file_name": "s2.png", "id": "1134018684852214", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/473392161_1134018688185547_3373782723112850264_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_qaxNQNHm-sQ7kNvwGmk_GW&_nc_oc=AdnYNkd7_4uaoV101GfjtzuiQ1JY7YnEWh0lRtqC9L-A4wKJqORLeTXbgs7PQC3aoBA&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Afsp1BsQcq9VcU43wRacdxrWJiQnv2MzCLcnftIIQ2lPMA&oe=69A1A1C5"}, {"file_name": "s1.png", "id": "1117528370164324", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/473393713_1117528373497657_2336605798937990977_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4XFBJl6H2tQQ7kNvwHPY1fz&_nc_oc=AdlyZkGWPSPaDRJjDY2lhAhZHPuFDM4HaID0q1o3VzKM17G7bfsi5pBWfCiE8J2c6_4&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfsqUlcCn-U2Jy1laQ2qQdyN_S18CEkc95OchgvsAPAbvg&oe=69A176A3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Carpenter Simulator VR", "keywords": ["VRCarpentry", "WoodworkingGame", "CraftingSimulator", "FurnitureAssembly", "VirtualWorkshop"], "long_description": "Apprentice Carpenter brings the art of woodworking to life in virtual reality. Using realistic tools like hammers, screwdrivers, and saws, players must assemble wooden furniture based on provided blueprints within a set time limit.\n\nEach completed piece earns points, and players can seamlessly move on to new challenges, refining their skills with each project.\n\nKey Features:\n\n\ud83d\udee0\ufe0f Realistic woodworking tools and physics.\n\n\ud83e\ude91 Multiple furniture models to assemble.\n\n\u23f1\ufe0f Time-based challenges to test your speed and accuracy.\n\n\ud83c\udf10 Seamless, continuous gameplay environment.\n\n\ud83c\udfae Perfect for VR enthusiasts and crafting lovers alike.", "short_description": "Step into the role of an apprentice carpenter in this immersive VR game. Assemble wooden furniture accurately and quickly to prove your craftsmanship in a dynamic woodworking shop."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/seivr/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jone Sei", "support_website_url": null, "website_url": "https://sites.google.com/view/seivr/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9339242429455443"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "1857611981552996"}, {"status": "PUBLISHED", "id": "4189423757974185"}, {"status": "PUBLISHED", "id": "828311693432723"}, {"status": "PUBLISHED", "id": "2540412966314424"}, {"status": "PUBLISHED", "id": "792223953596307"}, {"status": "PUBLISHED", "id": "1733613890678922"}, {"status": "PUBLISHED", "id": "796800583019183"}, {"status": "PUBLISHED", "id": "651832290524265"}]}, "baseline_offer": {"id": "792223953596307"}, "is
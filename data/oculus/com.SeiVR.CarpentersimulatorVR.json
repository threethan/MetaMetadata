, "id": "1707433490667530", "locale": "en_US", "screenshots": [{"file_name": "5.png", "id": "1009538851326040", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499620476_1009538854659373_792012922816785500_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A4FhWdKjKxwQ7kNvwEBgaNO&_nc_oc=Adrxc0dLx95Wm_laqyDGXq7kIFTyMr3s5W0NnfZYhTijLecrf3rNXn3X6-SHyWfI6zU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0kC7s5jSlvpNlxrLo2t5GncCZhITV68qwS1Pv_NFxaxA&oe=69F4AC4C"}, {"file_name": "6.png", "id": "1399136164614663", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618930_1399136167947996_8653883982299444757_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wcgdCbyQATsQ7kNvwHh3sKc&_nc_oc=AdoYk8MC6_O2EchG5-azSuNuiw57JnS3KC4nuBHpb_cvrZ0oXQohHYG3NHseHVYXU64&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3kQwE7LmiTZigv9vwYsPRm8O2LdgaxE6rTuhQ_6Eixzg&oe=69F4B8DE"}, {"file_name": "2.png", "id": "2612581769107453", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618274_2612581772440786_6520813707633238542_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Rna-HP4XFgQ7kNvwE8k-1H&_nc_oc=AdqmBimCjGMm63zlz2h6nY7_TYMlBDAZUC0GD7NJq4oXU-wvqgQQt45cavt-v6NkMzw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1-ig-laye1bXD0WJame6EttrChjWlRk5l-JXhmP6M5oQ&oe=69F4B631"}, {"file_name": "3.png", "id": "623349030778908", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499618089_623349034112241_9121807948883346742_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9BufEr2LnDwQ7kNvwEDerRq&_nc_oc=AdpA3838AiH1IR3ucsKCXPUsuFzdtCHQl8BUxo37TXRISBMjNZ5LOjQsA242m-gvfkw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2v-5iwrQEv-9ClOf7b6C9eBY9w46OaL8GpZWJdrcugug&oe=69F4A2B4"}, {"file_name": "4.png", "id": "1253627109441996", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618464_1253627112775329_6269737204804707692_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xHZ4ydMkoQAQ7kNvwFk9_5e&_nc_oc=AdpqQIJHKloYMs3vwiUrOZpAO-7BIbXgZ_warj8MJCPWMnJCRw6CXtI38Lzh9_OMeU8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2H746pp21JsS4dFq4Un_hUlL4SnaNKLgLFj61LEJlkTQ&oe=69F4B1AE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1635499240460081", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499619631_1635499243793414_34979520282232832_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-CrknptBBLkQ7kNvwHQDfz6&_nc_oc=AdrWlLOAfMtUN5szaGWg5I9z9lhZdDcvZGusLDEPXKNZG74Eu8a2j45bjv4Q9CIorrc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2SrAAAakha2P7WWsKcVjb6E-awviLHy45-VvLaV6NeKA&oe=69F4C281"}, "display_name": "Carpenter Simulator VR", "keywords": ["woodworkingvr", "carpentersimulatorvr", "furnitureassembly", "blueprintbuilder", "vrworkshop"], "long_description": "Try free and feel the tools. Build real furniture from blueprints\u2014measure, cut, drill and screw each piece into place with clear on-piece guides.\n\nCarpenter Simulator VR brings hands-on woodworking to virtual reality. Start with raw planks, follow simple plans, and assemble step by step. The controls are straightforward, the flow is smooth, and every action feels tactile and satisfying\u2014perfect for short sessions or relaxed build nights.\n\n\u2022 Follow blueprints from start to finish\n\u2022 Use familiar tools: Hammers, screws\n\u2022 Clear snap/placement guides for accurate builds\n\u2022 Short, relaxing builds\u2014easy to pick up, hard to put down\n\n\ud83d\udee0\ufe0f Resolved an issue preventing stamina from recovering after level reload.\n\u26a1 Optimized performance for a smoother gameplay experience.\nHey everyone!\n\nThis update is all about making the game smoother and easier to jump into. We\u2019ve fixed a bunch of annoying bugs to improve overall performance, so things should feel better while you play.\n\nWe also added a quick intro/tutorial at the start to help you get the hang of everything faster\u2014especially if you're new.\n\nIf you run into any issues or have ideas to make the game more fun, feel free to drop us your feedback. We\u2019re always listening and working to improve the experience!\n\nThanks for playing \u2764\ufe0f", "short_description": "Try free: build real furniture in VR. Follow blueprints\u2014measure, cut, drill and screw\u2014fast, tactile, oddly satisfying."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/seivr/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jone Sei", "support_website_url": null, "website_url": "https://sites.google.com/view/seivr/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26567626826190402"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491822818_1181787683713744_2557403714749755129_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OBUQBlY2Gz0Q7kNvwFeBDxH&_nc_oc=AdqyK7_0tQQ76CpMIcQGHn8sajYmn87ystf3z8txVacfQl_NcOWgxtj_4Emxk56Yfv4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3RoYJJrVP4QKKpMHtZaemciGLhMR0ChmVbojkV_-OBaA&oe=69F4AABA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Carpenter Simulator VR", "platform": "ANDROID_6DOF", "context_category": {"context_cat
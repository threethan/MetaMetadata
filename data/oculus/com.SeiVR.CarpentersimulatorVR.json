PgbSJ4c_V2LFIo9A5dPd6t4EhYdL9lle7V39Cg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_WuuQsEUW8GyPjkVH_8YE0ZWmKOzzq95dtMTGI4mjcw&oe=6AD3BB75"}, {"file_name": "Screenshot_2560x1440_20260805_231846.png", "id": "2441308409668703", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499619751_2441308413002036_8973959924207462142_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DqcHpezMbRMQ7kNvwFzPe2M&_nc_oc=Adrz7NzaFcrzB5cdGGo1QYSHaP8ziOc-4tVCdRfwt6HaCKS7BWJV9WB3SXMRwLV0IJE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFg9iWpazgnMazayDjlPKjVS-7Qz3WMM1KlvcDG113wQ&oe=6AD386B1"}, {"file_name": "Screenshot_2560x1440_20260805_231916.png", "id": "1323660456632929", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499620860_1323660459966262_7515582810112910856_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LLsKB53_1NQQ7kNvwGmeDct&_nc_oc=AdrostoaELfpSQW0tcwau3o_T7UA8VAWPWv5uqoT9PmBeWDlMYsF-0MTmzqyJjrcDPg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNgHb5vI15D1nxw-c1jCILTAHrEMHwz1Ly0J0xetKpDKQ&oe=6AD38F58"}, {"file_name": "Screenshot_2560x1440_20260805_232159.png", "id": "1071370041984373", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499619685_1071370045317706_1329610137611093865_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqzH9kwjO6sQ7kNvwGs6Wy9&_nc_oc=Adp5ql4BUuoSA7r7epXG4dvzdI6VzGEwCT6mdkKXrmX55OOzovSXKBkURhvX8LNViFE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPGrwyPLRk1PsjavioYS3QDR0B-0jtyl-fjIF1w5sxW7g&oe=6AD3993B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "lanscape.png", "id": "1004753375939968", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491831569_1004753379273301_5410354648797592328_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xitt_Kz4FmsQ7kNvwHSndfk&_nc_oc=AdrMcZtjJ_KQ3WHtJQajpJAodUeAqJsgPWtZIQFy1dHhLwNtggat0oUbGEjuMOMfQAo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQiAzVVhToU7nNG2JcCMfNhHGXNJsVvfMK46bFKh8cNg&oe=6AD3B63E"}, "display_name": "Carpenter Simulator VR", "keywords": ["woodworkingvr", "carpentersimulatorvr", "furnitureassembly", "blueprintbuilder", "vrworkshop"], "long_description": "Try free and feel the tools. Build real furniture from blueprints\u2014measure, cut, drill and screw each piece into place with clear on-piece guides.\n\nCarpenter Simulator VR brings hands-on woodworking to virtual reality. Start with raw planks, follow simple plans, and assemble step by step. The controls are straightforward, the flow is smooth, and every action feels tactile and satisfying\u2014perfect for short sessions or relaxed build nights.\n\n\u2022 Follow blueprints from start to finish\n\u2022 Use familiar tools: Hammers, screws\n\u2022 Clear snap/placement guides for accurate builds\n\u2022 Short, relaxing builds\u2014easy to pick up, hard to put down\n\nUpdate v0.6 - Improved Onboarding, Mechanics & Gameplay Experience\n\nWhat\u2019s New & Fixed:\n\nNew Interactive Tutorial: Added clear, step-by-step guidance at the start to help you get hands-on experience with the basic crafting and building mechanics right away.\n\nCrafting & Building Adjustments: Fixed and smoothed out the initial crafting process so building your very first item is intuitive and rewarding, not frustrating.\n\nGameplay Flow & Progression: Rebalanced early-game \n\nWe\u2019ve been closely listening to all your feedback! We understand that the initial experience had a steep learning curve and a few confusing mechanics. In this update, we\u2019ve implemented major improvements based directly on what you\u2019ve told us:\n", "short_description": "Try free: build real furniture in VR. Follow blueprints\u2014measure, cut, drill and screw\u2014fast, tactile, oddly satisfying."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/seivr/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jone Sei", "support_website_
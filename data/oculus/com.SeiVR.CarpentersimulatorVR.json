75253_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wgb21wXw2yMQ7kNvwHYIRwf&_nc_oc=AdrGSqbwAXWILFiThI0-IxGxS7qUlCqVQ01g4nAYizhqWotai3CzP9Sn5IUgPtWGjBY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTAiCrT5l4x-eD52XrHG9sBDcanzFNPUE6b1vkucTPjdA&oe=6B0DAAFC"}, {"file_name": "CarpenterSimulatorVR_Screenshot_05_2560x1440.png", "id": "2063591974356364", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/908839696_2063591977689697_1511492200861590757_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-N_dDaBQVl8Q7kNvwH3fF8w&_nc_oc=AdoI_O6T1C4t3iGQ2twYxD2lcwbIEAwwboclTl_GxtW6Hfw1gpTiV3bS7ryJ0FUDY_4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS3q02qGof0EhJsNC4HhpX7AlQtXoU6t_TVzjjfA1WQVA&oe=6B0DCD85"}, {"file_name": "CarpenterSimulatorVR_Screenshot_02_2560x1440.png", "id": "2147675309190142", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/908839691_2147675312523475_9177631955507279614_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2on88GPe5soQ7kNvwFZOg-0&_nc_oc=Adrl-uZkGN6k546Rlu11fmPZUaTQp2eu2epHtHHhV1oRZRdnpurOWON32naqo1zO-7E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQZDqwjGbHRuujZrD-L70hz6YHGdCbdniFtjaT7z7P8-Q&oe=6B0DBA55"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CarpenterSimulatorVR_Cover_Landscape_2560x1440.png", "id": "1680312743454795", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/908839656_1680312746788128_7397349387782510965_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zsoc4HuIFYEQ7kNvwECY-3J&_nc_oc=AdqTGwEgR_BtTwCHBCq6wQEZMw1d_mV1uaf0-Z2e2koWB19JYtYQiau1GqiHcB-1Ewo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS9SQgzDQUT4__-0n6TTQRfI8vgSnfoc3Ks-HDxlPFzJA&oe=6B0DC9B3"}, "display_name": "Carpenter Simulator VR", "keywords": ["woodworking", "workshop", "cozy", "crafting", "sandbox"], "long_description": "Grab your apron and step into a sunlit, **100% hands-on VR woodworking studio**! Whether you want to relax to soothing woodshop ASMR or engineer rock-solid custom furniture from raw timber, **Carpenter Simulator VR** puts authentic craft tools directly in your hands.\n\n{29585022714515688}\n\n- **Saw & Clamp:** Lock planks in the vise and pull your **Ryoba Saw** to slice real 3D timber in half.\n- **Hammer & Pry:** Drive nails in 4 tactile strikes to weld joints solid\u2014or pry mistakes right back out with the hammer claw!\n- **Sand, Spray & Stamp:** Polish rough wood grain smooth, paint with **24 spray colors**, and apply **12 custom stamps**.\n\n{1155821210164047}\n\nNo flat menus! Flip metal toggle switches, pull the lamp cord for **3 lighting moods**, grab nails straight from jars, and **slam the Brass Bell** to submit builds.\n\n{41157857567134815}\n\n- **Blueprint Campaign (10 Levels + Tutorial):** Craft Japanese-inspired joinery furniture\u2014or flip **Cozy Mode** ON for zero timers.\n- **Free Sandbox & Commissions:** Build freely with **8 timber shapes** & **7 wood grains**, pass the shaking **Physics Stress Test** across **8 client orders**, and fill your **Polaroid Gallery**.\n- **Workshop Arcade:** Unwind with *Rhythm Peg Hammer*, *Vortex Disc Toss*, and *Balance Tower Stack*.\n\n**VR Comfort Ready:** Play **seated or standing** with Distance Grab, Auto-Snap Assist, Vignette Turn, and spatial ASMR audio.", "short_description": "Grab your pull saw, hammer, and spray can\u2014your cozy VR woodshop is open! Physically saw timber in half, clamp planks in a vise, drive or pry out nails, sand rough grain smooth, and customize builds with 24 paint colors and 12 artisan stamps. Master 10 blueprint furniture levels, fulfill relaxed client commissions, stress-test wild creations in Free Sandbox, or unwind with 3 workshop minigames. Play seated or standing with tactile haptics and soothing 3D ASMR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://
, "id": "1707433490667530", "locale": "en_US", "screenshots": [{"file_name": "5.png", "id": "1009538851326040", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620476_1009538854659373_792012922816785500_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=20hMu0hm4VIQ7kNvwGOkAN2&_nc_oc=AdruXIq9Kl0HfnM8Fy0RxE2MyfdQas2jfzsrjb8vptaCdhYogPIX4CIoTYB51NiLYBc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_yQq8MSM4oPVqcwg2GUoJ9N0YRTd1_G7_8wh5V2aSBg&oe=6A6218CC"}, {"file_name": "6.png", "id": "1399136164614663", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618930_1399136167947996_8653883982299444757_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2aCJtY8TxWUQ7kNvwE9TZzu&_nc_oc=AdqL00GveZbjNVn6axTgYd8S7yBaGyHCIwl16U54hr26tb8Ln_051o_YSX5X4XSjJjo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCwumzuIbxUnlKZbRN-wkR0Dy6K5_mDapNAde__nco3zQ&oe=6A62255E"}, {"file_name": "2.png", "id": "2612581769107453", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618274_2612581772440786_6520813707633238542_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mvf6ec_hH-gQ7kNvwHtCpAp&_nc_oc=Adpq2dN-IgFSEgTPoz1swictScD4GHydJbGKHRW-l8PxF75zsRzn2W_Z6wsJhrelFDE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAsvdipgPaC4uIa8tkbFRgRR4QIbFSezrkViv5Nu4hNsQ&oe=6A6222B1"}, {"file_name": "3.png", "id": "623349030778908", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618089_623349034112241_9121807948883346742_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZMAZZbJo0gwQ7kNvwGnsbtE&_nc_oc=AdpFT12KjirRsupiPRFpWxtporGHgNYXPm2wkkqDKqb926N3mB5RtBG1Ci5foo3nSM8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBe9KzRGcTahHtbb-0eISH1VUBN-T6ci_94UDsEx7b_4g&oe=6A620F34"}, {"file_name": "4.png", "id": "1253627109441996", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618464_1253627112775329_6269737204804707692_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1oab0avwdvMQ7kNvwEroiSp&_nc_oc=AdqcXBnntKUa9HxE6XdINJa6klRvdORbxUb-S72PcuI7Tz1TM8U72wH5coo2T-mFry8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDSnyx_x_XrkSBJXInzyULRk_5UU47MMw0C-JGR-_y3Lg&oe=6A621E2E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1635499240460081", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619631_1635499243793414_34979520282232832_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6epG-j5jnvoQ7kNvwExSxtY&_nc_oc=AdrqHgPCgwgflZx4SjXZzlQiQxd83JOciHiCn4Y-iS0XAjQ0tcm1Cwb700pW0LhSais&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9jpHbxc1P4UNc6I7_x0R_lF_Qc32p7p0oPz4D3d3eKg&oe=6A622F01"}, "display_name": "Carpenter Simulator VR", "keywords": ["woodworkingvr", "carpentersimulatorvr", "furnitureassembly", "blueprintbuilder", "vrworkshop"], "long_description": "Try free and feel the tools. Build real furniture from blueprints\u2014measure, cut, drill and screw each piece into place with clear on-piece guides.\n\nCarpenter Simulator VR brings hands-on woodworking to virtual reality. Start with raw planks, follow simple plans, and assemble step by step. The controls are straightforward, the flow is smooth, and every action feels tactile and satisfying\u2014perfect for short sessions or relaxed build nights.\n\n\u2022 Follow blueprints from start to finish\n\u2022 Use familiar tools: Hammers, screws\n\u2022 Clear snap/placement guides for accurate builds\n\u2022 Short, relaxing builds\u2014easy to pick up, hard to put down\n\n\ud83d\udee0\ufe0f Resolved an issue preventing stamina from recovering after level reload.\n\u26a1 Optimized performance for a smoother gameplay experience.\nHey everyone!\n\nThis update is all about making the game smoother and easier to jump into. We\u2019ve fixed a bunch of annoying bugs to improve overall performance, so things should feel better while you play.\n\nWe also added a quick intro/tutorial at the start to help you get the hang of everything faster\u2014especially if you're new.\n\nIf you run into any issues or have ideas to make the game more fun, feel free to drop us your feedback. We\u2019re always listening and working to improve the experience!\n\nThanks for playing \u2764\ufe0f", "short_description": "Try free: build real furniture in VR. Follow blueprints\u2014measure, cut, drill and screw\u2014fast, tactile, oddly satisfying."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/seivr/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jone Sei", "support_website_url": null, "website_url": "https://sites.google.com/view/seivr/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26567626826190402"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822818_1181787683713744_2557403714749755129_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LsN4ktrv6_gQ7kNvwHfPoeD&_nc_oc=AdpFoOT0QaM2YfkWM_u4dnw0rVnZ7Bmt-AG_CTXiYcWxDo4-EwJxL3CvHGSqOpYtI5c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBB4hSy_7bCeMcvp9Zndfw658NZWZb57s9j4320BK8aDA&oe=6A62173A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Carpenter Simulator VR", "platform": "ANDROID_6DOF", "context_category": {"context_cat
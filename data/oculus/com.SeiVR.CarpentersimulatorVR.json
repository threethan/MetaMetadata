, "id": "1707433490667530", "locale": "en_US", "screenshots": [{"file_name": "5.png", "id": "1009538851326040", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499620476_1009538854659373_792012922816785500_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0lVcQV88WeUQ7kNvwEYt1mF&_nc_oc=AdqYKd7Xl3G7QA2k8gvzHKijjHVWNa3GBxvaeAbxFEhDDDX1J7erB6FymUfnekSTL8Y&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5N5zAW_GZnZnCTN0E_0rcgRijl8Sg9dCMH8agWW_Reyw&oe=6A09C44C"}, {"file_name": "6.png", "id": "1399136164614663", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499618930_1399136167947996_8653883982299444757_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z3a6RQVFM-QQ7kNvwFSE7hh&_nc_oc=AdqAFhpE105l-NcO1BHjj7Udwgu8SLk7A9pOmbPEIo7WM4JsmH0dj5T8C8bOE7ncXUY&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6KFeSvhVl5HvspSUWBQTJ7Om0KMq8cdn1FijINTFQ9Hg&oe=6A09D0DE"}, {"file_name": "2.png", "id": "2612581769107453", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499618274_2612581772440786_6520813707633238542_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GRPc2_Rg-JAQ7kNvwEro8F6&_nc_oc=Adr1TNx8GS86TND5eqzN7i4L7iTKWJNJBzgKY8Xa7L9OCpqyYUB1ab2Y-j5QlRZNoKE&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af63xXRdtwcPCMzj35A1S3EbP8BwwifQtXIMLOAa7nDlgg&oe=6A09CE31"}, {"file_name": "3.png", "id": "623349030778908", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499618089_623349034112241_9121807948883346742_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9mmpXdWZVvoQ7kNvwEvfiMH&_nc_oc=AdqpICpHTwzt69dT4pagoA9djPMOwMiGJc4GAwdbJ040OBxCWfGnfsBFP4VpkoFlxPk&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4h3yINW4oC5kBGvhiulpn1YfnqexKkp-Hy60PR-lJxWg&oe=6A09BAB4"}, {"file_name": "4.png", "id": "1253627109441996", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499618464_1253627112775329_6269737204804707692_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0HbzuyBZ8gkQ7kNvwEv0bc_&_nc_oc=Adp2-wGtDY7JGJ94CeCZlBqIKOIdVcvLBwpld012s1f1U0vzCYjH7W-YHCNquqrGpC8&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Tfd5aheqxg34OnG8Qk8dMwE1BiF6HODSk_y66q4i55A&oe=6A09C9AE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1635499240460081", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499619631_1635499243793414_34979520282232832_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4wtyuJgRXe4Q7kNvwHBOUKF&_nc_oc=AdpdE5Uzdlppu0Wp3aEbD6gDy1bbvSUvp8Jzyivqtk5marChgl25O2Rp92Ic_8odZpA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6UySI544Er80F9QUK29Y3SKFhppNrX0E_JF0vT0c_Kvg&oe=6A09DA81"}, "display_name": "Carpenter Simulator VR", "keywords": ["woodworkingvr", "carpentersimulatorvr", "furnitureassembly", "blueprintbuilder", "vrworkshop"], "long_description": "Try free and feel the tools. Build real furniture from blueprints\u2014measure, cut, drill and screw each piece into place with clear on-piece guides.\n\nCarpenter Simulator VR brings hands-on woodworking to virtual reality. Start with raw planks, follow simple plans, and assemble step by step. The controls are straightforward, the flow is smooth, and every action feels tactile and satisfying\u2014perfect for short sessions or relaxed build nights.\n\n\u2022 Follow blueprints from start to finish\n\u2022 Use familiar tools: Hammers, screws\n\u2022 Clear snap/placement guides for accurate builds\n\u2022 Short, relaxing builds\u2014easy to pick up, hard to put down\n\n\ud83d\udee0\ufe0f Resolved an issue preventing stamina from recovering after level reload.\n\u26a1 Optimized performance for a smoother gameplay experience.\nHey everyone!\n\nThis update is all about making the game smoother and easier to jump into. We\u2019ve fixed a bunch of annoying bugs to improve overall performance, so things should feel better while you play.\n\nWe also added a quick intro/tutorial at the start to help you get the hang of everything faster\u2014especially if you're new.\n\nIf you run into any issues or have ideas to make the game more fun, feel free to drop us your feedback. We\u2019re always listening and working to improve the experience!\n\nThanks for playing \u2764\ufe0f", "short_description": "Try free: build real furniture in VR. Follow blueprints\u2014measure, cut, drill and screw\u2014fast, tactile, oddly satisfying."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/seivr/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jone Sei", "support_website_url": null, "website_url": "https://sites.google.com/view/seivr/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26567626826190402"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/491822818_1181787683713744_2557403714749755129_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DM9d6n4OkEAQ7kNvwERPW5m&_nc_oc=AdrwCOONTe4J6anuoR_Fkf1VZ4z3Kd3Tv6c-ON4qzxDGhmzwPcEbPgUcXh3M9i0mY3E&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6rHXJtyNlaW2rZ_KlWnOuz2SHTmA2fDmoWlVe6AoO1vQ&oe=6A09C2BA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Carpenter Simulator VR", "platform": "ANDROID_6DOF", "context_category": {"context_cat
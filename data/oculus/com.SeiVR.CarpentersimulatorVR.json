zU-GahiPrrlPuv6j84eDmpl3_hX42299-89Gl4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMmUb7rrFZLUhZ3AbQ7EsG7juWgmZ8NZtEwe5K-9mJ06Q&oe=6ACE3D35"}, {"file_name": "Screenshot_2560x1440_20260805_231846.png", "id": "2441308409668703", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619751_2441308413002036_8973959924207462142_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u40vU9xldAYQ7kNvwE4sPiW&_nc_oc=AdqmJhMhUimr9xkPFy4rPBiorgJ9XP7x6hGhzUTIgGrWi1FPeLVU_xVAWqkY7lSZ-IM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPQELYmTEdINvZTda3x4jja1GCWedebG-71dV3zeC50pQ&oe=6ACE40B1"}, {"file_name": "Screenshot_2560x1440_20260805_231916.png", "id": "1323660456632929", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620860_1323660459966262_7515582810112910856_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cK9psdWtyyoQ7kNvwFhVTE2&_nc_oc=AdrJioHoqnt6jl31rePMJ2DAEtRJ76bxc0M3F-rh7XaUBgjjdAY4QnaiG1_d9MAVFIw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN88Fkg6mbL9b92TMTp6RVfq9sELlAymGzBW_ZcKq0STw&oe=6ACE4958"}, {"file_name": "Screenshot_2560x1440_20260805_232159.png", "id": "1071370041984373", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619685_1071370045317706_1329610137611093865_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_L5SOsI-InQQ7kNvwFEGoOH&_nc_oc=Adplgk64Cx-J5FaVCW5Fzt81YhwsFLKxqtfzvqhQFjQQ7pEjxoG-ILb8a4VYlmItHW0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOcaRCJFqzf2jm_qvFuVoP9Zk3816o6RyMdO3e0xGojIQ&oe=6ACE533B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "lanscape.png", "id": "1004753375939968", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831569_1004753379273301_5410354648797592328_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v8Pp_CeZaR8Q7kNvwF78xWD&_nc_oc=AdoCRd9VlUoFrmDYkAiY1uDmGgndNjn75WJ8E7PNc8ELL063NT44I87MYnrLDwG_xcI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP9UV4XkEfhhyKxS7L8xCWfzsW0GzmrIMj-e1zS6SnedQ&oe=6ACE37FE"}, "display_name": "Carpenter Simulator VR", "keywords": ["woodworkingvr", "carpentersimulatorvr", "furnitureassembly", "blueprintbuilder", "vrworkshop"], "long_description": "Try free and feel the tools. Build real furniture from blueprints\u2014measure, cut, drill and screw each piece into place with clear on-piece guides.\n\nCarpenter Simulator VR brings hands-on woodworking to virtual reality. Start with raw planks, follow simple plans, and assemble step by step. The controls are straightforward, the flow is smooth, and every action feels tactile and satisfying\u2014perfect for short sessions or relaxed build nights.\n\n\u2022 Follow blueprints from start to finish\n\u2022 Use familiar tools: Hammers, screws\n\u2022 Clear snap/placement guides for accurate builds\n\u2022 Short, relaxing builds\u2014easy to pick up, hard to put down\n\nUpdate v0.6 - Improved Onboarding, Mechanics & Gameplay Experience\n\nWhat\u2019s New & Fixed:\n\nNew Interactive Tutorial: Added clear, step-by-step guidance at the start to help you get hands-on experience with the basic crafting and building mechanics right away.\n\nCrafting & Building Adjustments: Fixed and smoothed out the initial crafting process so building your very first item is intuitive and rewarding, not frustrating.\n\nGameplay Flow & Progression: Rebalanced early-game \n\nWe\u2019ve been closely listening to all your feedback! We understand that the initial experience had a steep learning curve and a few confusing mechanics. In this update, we\u2019ve implemented major improvements based directly on what you\u2019ve told us:\n", "short_description": "Try free: build real furniture in VR. Follow blueprints\u2014measure, cut, drill and screw\u2014fast, tactile, oddly satisfying."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/seivr/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jone Sei", "support_website_
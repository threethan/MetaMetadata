vwHfFD6z&_nc_oc=AdpYQca0sR-5g-Q4PPp9EiqxjZ7cxISj3ev1X9mFg-1C1YZ0ANU4A-Z9x3a8xvtUdBY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1hBOryAN0wVBQNRPReCq2J0GE-ogYjrfyuPdfSU-Bhvg&oe=69F0D113"}, {"file_name": "11.png", "id": "202399036020094", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031388_202399039353427_6680448244751197845_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7X1rNxJO47gQ7kNvwGgmtuD&_nc_oc=Adr0chZ6_OvY56VC8TSNMdbb93RzBFcmNzDsCFLZJOJcW8tUInp8XexVT5G4G-vVGwA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3U6xbdFtqLBsPrrG8Kx4injY4NzLmZT8rsK67yDcNa8g&oe=69F0C6F8"}, {"file_name": "3.png", "id": "869881297890515", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001727_869881301223848_4956483551034422676_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1QWdXliiGJ8Q7kNvwHHSG1-&_nc_oc=Ado-GYdkedl5R_UVgGt2kUlR8lucvl67tmOoSKFU8UxT3FU6sRg0AC2Q6XDRRPjus6g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3ZyPoVEZgWAeyI4Y9tBqQ2otJZH6ugBJiJfGKT2pB_Ng&oe=69F09D5D"}, {"file_name": "5.png", "id": "1029913311618453", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75280177_1029913314951786_1716028478303834469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZIWo7vj1PDAQ7kNvwG9jYP8&_nc_oc=AdojJ4gITefqr_KbWnqbHolG3I63LPlFgQ7QWes0hbH12FkZB4QDR2Vg5T_egwxTBCI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1TeQIAujmXcGHD_HsWnvMYGoUX28tAaM7UFekYttzFYA&oe=69F09FA4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mini Games", "keywords": ["mini", "games", "puzzle", "casual", "table"], "long_description": "A collection of seated mini games including:\n\nRail Targets: Hit the targets, while riding in a rail carriage.\n\nPiece Puzzle: Connect the pieces of an object to complete the puzzle.\n\nUnblock The Road: Slide the blocks to connect the road.\n\nMinesweeper: Find all the mines and clear the grid.\n\nShell Game: Pick which cup the ball is in, after the cups have been moved around.\n\nKlondike Solitaire: The classic game of Klondike using playing cards.\n\nPyramid Solitaire: The classic card game where you have to find pairs that add up to 13.\n\nSpider Solitaire: A popular variation of solitaire with the option to play with either 1 suit or 2 suits, for increased difficulty.\n\nJigsaw Puzzle: Choose a picture and complete the puzzle.\n\nChess: The classic game of chess.\n\nCheckers: The classic game of checkers.\n\nWhack A Mole: Hit as many moles as you can, as fast as you can.\n\nWire Loop Game: Move the hoop along the wire, within the time limit.\n\nShooting Gallery: Get as many points as you can, by shooting the objects.\n\nMarble Solitaire: Complete the game by removing all the balls, but one, from the board.\n\nCarnival Rail: Throw baseballs and hoops at the carnival style targets, while riding in a rail carriage.", "short_description": "A collection of seated mini games:\n\nRail Targets: Hit the targets riding a carriage.\nPiece Puzzle: Connect the pieces.\nUnblock The Road: Slide the blocks.\nMinesweeper\nShell Game: Which cup is the ball in?\nKlondike Solitaire\nPyramid Solitaire\nSpider Solitaire\nJigsaw Puzzle: Complete the puzzle.\nChess\nCheckers\nWhack A Mole\nWire Loop Game: Move the hoop along the wire.\nShooting Gallery: Get as many points as you can.\nMarble Solitaire\nCarnival Rail: Throw baseballs and hoops, riding in a carriage."}]}, "developer_name": null, "developer_privacy_policy_url": "http://mobilefusionapps.com/privacypolicyvr.html", "developer_terms_of_service_url": null, "publisher_name": "MobileFusion Apps LTD", "support_website_url": null, "website_url": "http://mobilefusionapps.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED
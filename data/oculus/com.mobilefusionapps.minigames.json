 pieces of an object to complete the puzzle.\n\nUnblock The Road: Slide the blocks to connect the road, so the car can make it home.\n\nMinesweeper: Find all the mines and clear the grid.\n\nShell Game: Pick which cup the ball is in, after the cups have been moved around.\n\nSolitaire: The classic game of Klondike using playing cards.\n\nWhack A Mole: Hit as many moles as you can, as fast as you can, before the time runs out."}]}, "developer_name": null, "developer_privacy_policy_url": "http://mobilefusionapps.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "MobileFusion Apps LTD", "support_website_url": null, "website_url": "http://mobilefusionapps.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "518686136142527"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "520219059303519"}, {"status": "PUBLISHED", "id": "599067727869278"}, {"status": "PUBLISHED", "id": "199867409631155"}, {"status": "PUBLISHED", "id": "657920288520889"}, {"status": "PUBLISHED", "id": "692878865570162"}]}, "baseline_offer": {"id": "199867409631155"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1643831220, "status": "PUBLISHED", "id": "520219059303519"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6507548542694494", "v
-25/38974756_2857566914403195_2320342036998572960_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RTxyap1tsEEQ7kNvwH6OJhm&_nc_oc=AdpRNP_OZq7kIjHNcviaXzcqtNK0mL6XikWUUVcCeG5oKFCvOBHzEbUh_Wb3qAh4hoc&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJW5mFHmcwEUOfloPpabMt4wbCzDNuqzGd57BY2DU1QQ&oe=6A7DA953"}, {"file_name": "11.png", "id": "202399036020094", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031388_202399039353427_6680448244751197845_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VKVIG4JI1oQQ7kNvwEObI-l&_nc_oc=AdpuK7QZ4iMT0bdnczir4A4M5QF499KRZiB_vlG4Ik_SV1DUz4ao59DCSp1BZvSvEvk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHTQGfxaHrWxi9zhSkTbW_f6hM9oMxY5nBOxoNuvWB-KQ&oe=6A7D9F38"}, {"file_name": "3.png", "id": "869881297890515", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39001727_869881301223848_4956483551034422676_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ajaXsr3Y7jQQ7kNvwHl0yRk&_nc_oc=Adp0WfuOe-kcZVLRXcEL0wB69Q-bxRWgxSifO5eX7iaj4YjSl0VAKliCYfVBKDNuzHE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4x8CIBPUwmPTRZw38wqAgl1mY6ExZwFJpzMi95PW-zg&oe=6A7DADDD"}, {"file_name": "5.png", "id": "1029913311618453", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75280177_1029913314951786_1716028478303834469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JuU2xDk58o4Q7kNvwEKyIOl&_nc_oc=AdoI3P_SMNRGr4r8QiGgcvA5476Ut_EyBl2E1nLmQ4Mi9xzKalcmxKJ3G6K84D9G_Zw&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH-boTWh_uM-ZBW5YX3ai37GxMFDNAcrmXzLOGjIYY24A&oe=6A7DB024"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mini Games", "keywords": ["mini", "games", "puzzle", "casual", "table"], "long_description": "A collection of seated mini games including:\n\nRail Targets: Hit the targets, while riding in a rail carriage.\n\nPiece Puzzle: Connect the pieces of an object to complete the puzzle.\n\nUnblock The Road: Slide the blocks to connect the road.\n\nMinesweeper: Find all the mines and clear the grid.\n\nShell Game: Pick which cup the ball is in, after the cups have been moved around.\n\nKlondike Solitaire: The classic game of Klondike using playing cards.\n\nPyramid Solitaire: The classic card game where you have to find pairs that add up to 13.\n\nSpider Solitaire: A popular variation of solitaire with the option to play with either 1 suit or 2 suits, for increased difficulty.\n\nJigsaw Puzzle: Choose a picture and complete the puzzle.\n\nChess: The classic game of chess.\n\nCheckers: The classic game of checkers.\n\nWhack A Mole: Hit as many moles as you can, as fast as you can.\n\nWire Loop Game: Move the hoop along the wire, within the time limit.\n\nShooting Gallery: Get as many points as you can, by shooting the objects.\n\nMarble Solitaire: Complete the game by removing all the balls, but one, from the board.\n\nCarnival Rail: Throw baseballs and hoops at the carnival style targets, while riding in a rail carriage.", "short_description": "A collection of seated mini games:\n\nRail Targets: Hit the targets riding a carriage.\nPiece Puzzle: Connect the pieces.\nUnblock The Road: Slide the blocks.\nMinesweeper\nShell Game: Which cup is the ball in?\nKlondike Solitaire\nPyramid Solitaire\nSpider Solitaire\nJigsaw Puzzle: Complete the puzzle.\nChess\nCheckers\nWhack A Mole\nWire Loop Game: Move the hoop along the wire.\nShooting Gallery: Get as many points as you can.\nMarble Solitaire\nCarnival Rail: Throw baseballs and hoops, riding in a carriage."}]}, "developer_name": null, "developer_privacy_policy_url": "http://mobilefusionapps.com/privacypolicyvr.html", "developer_terms_of_service_url": null, "publisher_name": "MobileFusion Apps LTD", "support_website_url": null, "website_url": "http://mobilefusionapps.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": 
-25/38974756_2857566914403195_2320342036998572960_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WVm3512qrl0Q7kNvwHy0_3g&_nc_oc=AdooZ0Xi7NNfR4g02bfwvEtD_lX7SK3YmHVWpXv5Pv3YrkibZYWPWYcv59Pi5pDIGAQ&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7o25x8ta3_oG7fCxjj_EHUYQ4dy5UjMPWdy2xUY_mPMA&oe=6A11C693"}, {"file_name": "11.png", "id": "202399036020094", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031388_202399039353427_6680448244751197845_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Efd35QI3pzQQ7kNvwGOk2Wb&_nc_oc=AdrIN8dxEw5MYhMqXcBHYDWThfi54okKVV6IE19JyznRT2n8TUGZ7BUqFahokMVnEhY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4zbaf6QUs0gwsH7sVQXLXCALsd-DD4DnCisXk6_qjiHg&oe=6A11BC78"}, {"file_name": "3.png", "id": "869881297890515", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39001727_869881301223848_4956483551034422676_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kpznHANtfh4Q7kNvwEOgKAg&_nc_oc=AdrRWHjv9J6CXSOIRq0GMgrmKIcS0g48YAIYUmDrEcUv7GovKGah8o0_1ZzC7r1bUoA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5YiZVK48QyPdcesQwTJaao7NuPWqQGXhiXnxEZ7Wg-Aw&oe=6A11CB1D"}, {"file_name": "5.png", "id": "1029913311618453", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75280177_1029913314951786_1716028478303834469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qCTtmjbgTZ8Q7kNvwGFj65h&_nc_oc=AdozsxCWkDio63eazWDnyuuccQyG_ZRvOZNv7f0G_mMkMHcE-vuHyiMo98CW1JtMMSY&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70WQnFEcoZMMa_f4FApmLkUpEfRfBsXdcoNGE6H-etcQ&oe=6A11CD64"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mini Games", "keywords": ["mini", "games", "puzzle", "casual", "table"], "long_description": "A collection of seated mini games including:\n\nRail Targets: Hit the targets, while riding in a rail carriage.\n\nPiece Puzzle: Connect the pieces of an object to complete the puzzle.\n\nUnblock The Road: Slide the blocks to connect the road.\n\nMinesweeper: Find all the mines and clear the grid.\n\nShell Game: Pick which cup the ball is in, after the cups have been moved around.\n\nKlondike Solitaire: The classic game of Klondike using playing cards.\n\nPyramid Solitaire: The classic card game where you have to find pairs that add up to 13.\n\nSpider Solitaire: A popular variation of solitaire with the option to play with either 1 suit or 2 suits, for increased difficulty.\n\nJigsaw Puzzle: Choose a picture and complete the puzzle.\n\nChess: The classic game of chess.\n\nCheckers: The classic game of checkers.\n\nWhack A Mole: Hit as many moles as you can, as fast as you can.\n\nWire Loop Game: Move the hoop along the wire, within the time limit.\n\nShooting Gallery: Get as many points as you can, by shooting the objects.\n\nMarble Solitaire: Complete the game by removing all the balls, but one, from the board.\n\nCarnival Rail: Throw baseballs and hoops at the carnival style targets, while riding in a rail carriage.", "short_description": "A collection of seated mini games:\n\nRail Targets: Hit the targets riding a carriage.\nPiece Puzzle: Connect the pieces.\nUnblock The Road: Slide the blocks.\nMinesweeper\nShell Game: Which cup is the ball in?\nKlondike Solitaire\nPyramid Solitaire\nSpider Solitaire\nJigsaw Puzzle: Complete the puzzle.\nChess\nCheckers\nWhack A Mole\nWire Loop Game: Move the hoop along the wire.\nShooting Gallery: Get as many points as you can.\nMarble Solitaire\nCarnival Rail: Throw baseballs and hoops, riding in a carriage."}]}, "developer_name": null, "developer_privacy_policy_url": "http://mobilefusionapps.com/privacypolicyvr.html", "developer_terms_of_service_url": null, "publisher_name": "MobileFusion Apps LTD", "support_website_url": null, "website_url": "http://mobilefusionapps.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": 
56_2857566914403195_2320342036998572960_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OdN6AAX-ndoQ7kNvwHL6hqX&_nc_oc=AdrF2ql4WCKIFvpG_hsvHVyS6ZcXBHernihfSDOrOZNzV7PJJ_mxv1n5ubdlPzVepdE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjUxLOwJnr8TurqQdUCmKmesDQtoTu4YVTSarGqUM07g&oe=6AB29D93"}, {"file_name": "11.png", "id": "202399036020094", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031388_202399039353427_6680448244751197845_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zCWXBwoVuFoQ7kNvwEpr4rA&_nc_oc=AdoIj9-x77WbgRaTx2o11UOcCl_bKGZR7JCZS3RXuifVtjz2O2ZIBJLQ-z5uH2m1icc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMd0kIHMRCbEOynE8NelijXZHhxdIyeiDDBFCA8gLj2g&oe=6AB29378"}, {"file_name": "3.png", "id": "869881297890515", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001727_869881301223848_4956483551034422676_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MzwtLJc_dNcQ7kNvwEYFrWA&_nc_oc=AdonObNqchDUInIQgbcYEO2tdZhpsAH7SKCursV92r6UlTTac0TZljhukF9WE_LCyKw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDjKvxuvx9IEAAID--WOTelUIMi_Yle4_FXr3fpQWYTQ&oe=6AB2A21D"}, {"file_name": "5.png", "id": "1029913311618453", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75280177_1029913314951786_1716028478303834469_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GfLkgDK6M2YQ7kNvwE0zNt2&_nc_oc=AdqKG-Wvwd86kQ6-wd6GcJoK0WsXXDj-dlUVKlEZ-pQWmV0AVKTw7s1uX7VpaV9og5Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHC1885L_36CkU0VB4gBYKQnUvTZqehwoBo8oO9cx3yA&oe=6AB2A464"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mini Games", "keywords": ["mini", "games", "puzzle", "casual", "table"], "long_description": "A collection of seated mini games including:\n\nRail Targets: Hit the targets, while riding in a rail carriage.\n\nPiece Puzzle: Connect the pieces of an object to complete the puzzle.\n\nUnblock The Road: Slide the blocks to connect the road.\n\nMinesweeper: Find all the mines and clear the grid.\n\nShell Game: Pick which cup the ball is in, after the cups have been moved around.\n\nKlondike Solitaire: The classic game of Klondike using playing cards.\n\nPyramid Solitaire: The classic card game where you have to find pairs that add up to 13.\n\nSpider Solitaire: A popular variation of solitaire with the option to play with either 1 suit or 2 suits, for increased difficulty.\n\nJigsaw Puzzle: Choose a picture and complete the puzzle.\n\nChess: The classic game of chess.\n\nCheckers: The classic game of checkers.\n\nWhack A Mole: Hit as many moles as you can, as fast as you can.\n\nWire Loop Game: Move the hoop along the wire, within the time limit.\n\nShooting Gallery: Get as many points as you can, by shooting the objects.\n\nMarble Solitaire: Complete the game by removing all the balls, but one, from the board.\n\nCarnival Rail: Throw baseballs and hoops at the carnival style targets, while riding in a rail carriage.", "short_description": "A collection of seated mini games:\n\nRail Targets: Hit the targets riding a carriage.\nPiece Puzzle: Connect the pieces.\nUnblock The Road: Slide the blocks.\nMinesweeper\nShell Game: Which cup is the ball in?\nKlondike Solitaire\nPyramid Solitaire\nSpider Solitaire\nJigsaw Puzzle: Complete the puzzle.\nChess\nCheckers\nWhack A Mole\nWire Loop Game: Move the hoop along the wire.\nShooting Gallery: Get as many points as you can.\nMarble Solitaire\nCarnival Rail: Throw baseballs and hoops, riding in a carriage."}]}, "developer_name": null, "developer_privacy_policy_url": "http://mobilefusionapps.com/privacypolicyvr.html", "developer_terms_of_service_url": null, "publisher_name": "MobileFusion Apps LTD", "support_website_url": null, "website_url": "http://mobilefusionapps.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "159
dn.com&_nc_ss=7f20f&oh=00_AQM1ndjzAMHKEbKW8gNdrYGeBr8jvZgHVzUlm2MjfnPt5g&oe=6AD240A4"}, {"file_name": "Capture_edited (1).png", "id": "427214126874811", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57569431_427214130208144_967778776060103751_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9WQ_Zc3aoEoQ7kNvwFjohI8&_nc_oc=AdpsAQyx3gFHGtgLV15CMq4RYLVzl9YhUtQbIhWL7dND0GXspAkenD5_9yEVWN4HK1g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP2EPn6Qx91jY3CSN2VHqpCnESP6emELPljSjxglIhA9g&oe=6AD22C2C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Capture_edited (1).png", "id": "1430360644293759", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57575365_1430360647627092_7049532717827065397_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YH1-zmb0BFwQ7kNvwFgGEvj&_nc_oc=AdpK3PNe1Q3M3PSwidrt8u1M8_PkSacx3ZRojuDwgxJMpJowfft1sASp7mbwsH6Xwuk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNSx7uEiOkMIMmGRcD9d5qKni1-xe6tnlhOIeSXKZLIWA&oe=6AD258FB"}, "display_name": "colorbreathingVR", "keywords": [], "long_description": "Discover the power of mindful breathing with colorbreathingVR, a cutting-edge virtual reality app designed to help you manage your emotions and enhance mindfulness. This innovative experience allows you to visualize your breath in vivid colors, creating a unique and immersive way to achieve emotional balance.\n\nWith colorbreathingVR, you can select a color that represents a positive emotion you want to cultivate, such as calm, happiness, or confidence. You can also choose a color that symbolizes the negative emotion you are currently experiencing, such as stress, sadness, or anxiety. As you breathe in, visualize drawing in the positive color and emotion, filling your mind and body with positivity. As you exhale, imagine releasing the negative color and emotion, letting go of tension and negativity.\n\nDesigned for individuals who seek better emotional control and mindfulness practice, colorbreathingVR offers a serene and engaging environment to help you feel more relaxed and centered. Whether you are new to mindfulness or looking to deepen your practice, this app provides a simple yet powerful tool to enhance your emotional well-being.\n\nExperience the benefits of guided breathing exercises combined with the visual impact of color therapy. Let colorbreathingVR be your companion on the journey to emotional regulation, relaxation, and inner peace. Embrace the colors of your breath and transform your emotional landscape today.", "short_description": "colorbreathingVR helps you control your emotions through mindful breathing. Visualize your breath in colors: choose a color for a positive emotion to inhale and another for a negative emotion to exhale. This VR experience guides you to breathe in positivity and release negativity, promoting relaxation and emotional balance. Ideal for those seeking better emotional control and mindfulness."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.colorbreathingvr.com/general-5", "developer_terms_of_service_url": null, "publisher_name": "colorbreathingvr LLC", "support_website_url": null, "website_url": "https://www.colorbreathingvr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7786183148100786"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "4829218
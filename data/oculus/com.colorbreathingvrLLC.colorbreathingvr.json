scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312468_1469677834999663_5171603467281452126_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EF7UGbzpN2sQ7kNvwEPhJ6_&_nc_oc=AdoZkvihiv0VzIVCdqlfXVDPMDU50mp25fo7yWjoGiywEROqEHTsG8JGIQ0iNhVp_oU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMfcz3f0XbY6iIA3McjBx0jfJCCfvMG36AQAfRSoYR_Mw&oe=6AD23176"}, {"file_name": "05_somewhere_quiet.png", "id": "1537337871527398", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314657_1537337874860731_489949129672241419_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dFxBiQhVMycQ7kNvwFqL3ES&_nc_oc=AdqyFtjPoywYqB1bWE2nyhqmOj6UiDA6wWrk38Zn1FEX4963MILKFLsy4AfrNv3RQZs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMGZ9FfhS4xs3FJxrxj9PNyMcW1hLaykGlHakNasRREzQ&oe=6AD2508F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "1612002120435777", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499294643_1612002123769110_9129356685182271585_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f1rnszv6AvMQ7kNvwGEQumK&_nc_oc=AdpN82xZHEWdA_1evCXpn7bjuBnFt95lauHq7veCccb4OonOrnj8bXZa5Bi6bjC48gI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOCmJaoOht_59tr7M-l30_w9UvDp_gstjANwSXQuFpQ9A&oe=6AD2318E"}, "display_name": "Color Breathing VR - Relaxation and Mindfulness Meditation through Breathwork", "keywords": ["mindfulness", "sleep", "calm", "stress", "relax"], "long_description": "Slow down, breathe, and give yourself a few quiet minutes.\n\nColor Breathing is a simple VR relaxation experience built around breathwork, meditation, mindfulness, and immersive visual guidance. A calm space to focus on your breathing and reset.\n\nUse Color Breathing when you want to:\n\nUnwind after a long day\nDe-stress and clear your head\nPractice guided breathing\nMeditate without distractions\nTake a quiet break from games, work, or everyday stress\nBuild a relaxing wind-down routine\n\nThe experience is designed to be easy to start, even if you have never meditated before. Put on your headset, follow the visual breathing rhythm, and take a few minutes away from everything else.\n\nWhether you think of it as meditation, breathwork, mindfulness, or simply a peaceful VR escape, Color Breathing gives you a simple way to slow down, breathe, and relax.", "short_description": "Unwind in immersive VR with simple guided breathing, calming visuals, and short meditation sessions designed to help you relax, de-stress, and reset in just a few minutes."}]}, "developer_name": "Iwashima Technologies LLC", "developer_privacy_policy_url": "https://www.colorbreathingvr.com/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Iwashima Technologies LLC", "support_website_url": null, "website_url": "https://www.colorbreathingvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28521857227440075"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/786297305_1573393034587437_428784827325112537_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RbkHf1OyHDMQ7kNvwG6qkD8&_nc_oc=Adq_0Rt_ObEPcNpHGjWuqASuIcPP1qlgs2Ip1zXMrd0giCrp84I5hXLokBIclRIWwmQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOIW3Y4DsZTEbivX4X-bsfpaV8ZzBMtFi7NEv_q0jfU4A&oe=6AD2
uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/908842191_1210047254681742_6662932761162976105_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NDhj8m5QivcQ7kNvwFSLKYO&_nc_oc=Adr6ImaynoVokkSkeE8uX5CKCoq9O93NKe4hvP-puUcpEWerFRjTwV6mAALWVb40OsI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTMbCMWa_zg2sCr2FDsfVRZBUg6kF1akim2v8plc1stFg&oe=6B0DA7CB"}, {"file_name": "05-celebration-unlocks-2560x1440.png", "id": "2510339779456855", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/908842260_2510339782790188_8420613282220473896_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M67R0RNMBI0Q7kNvwGadC_g&_nc_oc=AdqQBDBK75mE92a1SVp4BZ2Ef10LFpsdxFWtEFzF3BIe6kH4T6qafVW03IQH4sUMaAI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQo__6JEfKX8pqOnkloAwUNiieCIhZlu9f65fLzSu_FSA&oe=6B0DB6DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-gameplay-2560x1440.png", "id": "1474223714644369", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/908842225_1474223717977702_1297726110625296972_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LMjxfdykMBgQ7kNvwGa0Gsa&_nc_oc=AdpwssV4cWUzkTiXQjxAYaXsUwFOGqvzLUdnoHx6vmX2GqU09X5S5a1FLiZ3VwdH0-o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRuOGJI3US95lgtnEfg-8-98U6YA02bOCA_7LhvvJUdMA&oe=6B0DCE91"}, "display_name": "Dr Snipes Hockey VR", "keywords": [], "long_description": "Take your next shift in Dr Snipes Hockey VR. Carry the puck through traffic, make a pass, and aim a shot from ice level. Hold the stick with both hands, release or snap your shot, set up a one-timer, and try to beat the goalie.\n\nPlay solo DSHL hockey in exhibition games, seasons, and cups. Practice shooting, passing, skating, defensive stick work, and goalie skills in guided activities. The Mini Games collection mixes hockey challenges with a playful side: bank Trick Shots through a growing tour of scenes, break targets in China Shop, and tackle other arcade events.\n\nDr Snipes and the rink crew bring personality to the game, from commentary and celebrations to occasional surprises on the ice. Ringette is a separate extra match mode with its own commentary when you want a different challenge.\n\nThe game is built around hockey first: puck control, scoring, saving, and the little moments between shifts.", "short_description": "Step onto the ice in first-person VR hockey. Handle the puck, pass, defend, and shoot with two-handed controls in DSHL games, play goalie, and take on practice drills and playful Trick Shot challenges. Ringette is included as an extra mode."}]}, "developer_name": null, "developer_privacy_policy_url": "https://athnexa.com/privacy-policy-dr-snipes-hockey-vr/", "developer_terms_of_service_url": null, "publisher_name": "SquawkyBird", "support_website_url": "https://athnexa.com/dr-snipes-hockey-vr/", "website_url": "https://athnexa.com/dr-snipes-hockey-vr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29223881517238388"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/908842200_1082721158151366_7167687576060776752_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RIyTO8I4O-IQ7kNvwE2HMT2&_nc_oc=AdqlaVrZfdBDzRqb4gQ89to
dn.com/v/t64.5771-25/473394159_992169352883748_5285415940096378648_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Hhb-6IjIPMQ7kNvwHOwb8g&_nc_oc=Adp5GFEXt3qPlfvBZvAUC1pGXDNNgRw1TvIM7A0WmiqKdGmFfSLRqiQqQ2A2CBCtFZE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1invGC4Npa9vNBPkGMwemVgYpIKWH9E1o1AC0jiNLjhw&oe=69EF8560"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeMetaUpdated.png", "id": "1834648750641456", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473402206_1834648753974789_1007839813703125572_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pJMItg7FPN4Q7kNvwEbw3jF&_nc_oc=Adrw9sTA_uYy8DvRHm9kRWv6f_NFKREvMdrxqBIuG7Vl6Y48lCyFz8vnqvKGUs2D8R0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0xOOb5I9w80fKStxWQLTfGQasjsVY2aoFJxwlt1XczEw&oe=69EF73E7"}, "display_name": "Silent Operative Demo", "keywords": ["demo", "silent", "operative", "free", "shooter"], "long_description": "Elite Secret Agent Experience: Immerse yourself in thrilling VR stealth-action gameplay.\n\nHigh-Stakes Missions: Navigate through intense missions using weapons, gadgets, and strategic skills.\n\nIntense Combat and Stealth: Engage in firefights, execute silent takedowns, and employ advanced espionage techniques.\n\nStrategic Planning and Execution: Plan your approach, assess enemy patrols, and exploit environmental opportunities.\n\nStunning Visuals and Immersive Gameplay: Experience stunning visuals and immersive gameplay.\n\nAre you ready to become the ultimate secret agent?", "short_description": "The Silent Operative Demo thrusts players into the shoes of a secret agent, where they must utilize a versatile arsenal of weapons and gadgets to navigate through dynamic and challenging missions.\n"}]}, "developer_name": "Nic Schubert", "developer_privacy_policy_url": "https://tonicgamesaustralia.com/SilentOperativeDemo-privacypolicy.html", "developer_terms_of_service_url": "https://tonicgamesaustralia.com/SilentOpera
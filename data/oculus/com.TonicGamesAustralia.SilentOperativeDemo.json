T7xHEtLGgxp0Z50-O1s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsoeeDRAUn6xSspIVerDwgcPtHODMa5XnvvabCfzy30ag&oe=69A6CAA0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeMetaUpdated.png", "id": "1834648750641456", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473402206_1834648753974789_1007839813703125572_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zX1LlCOeDZwQ7kNvwHAlI4t&_nc_oc=Adm2NaBFuDzC_J9HnwwAeVoDwnCiZwdudv4ROKgv67PD5WVunqXtxIi8F9sMxUxFTQ0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfujXFE3jeA3fOy4jyGTDd24RYvGCBDxe_L3tlQfmjAqew&oe=69A6F167"}, "display_name": "Silent Operative Demo", "keywords": ["demo", "silent", "operative", "free", "shooter"], "long_description": "Elite Secret Agent Experience: Immerse yourself in thrilling VR stealth-action gameplay.\n\nHigh-Stakes Missions: Navigate through intense missions using weapons, gadgets, and strategic skills.\n\nIntense Combat and Stealth: Engage in firefights, execute silent takedowns, and employ advanced espionage techniques.\n\nStrategic Planning and Execution: Plan your approach, assess enemy patrols, and exploit environmental opportunities.\n\nStunning Visuals and Immersive Gameplay: Experience stunning visuals and immersive gameplay.\n\nAre you ready to become the ultimate secret agent?", "short_description": "The Silent Operative Demo thrusts players into the shoes of a secret agent, where they must utilize a versatile arsenal of weapons and gadgets to navigate through dynamic and challenging missions.\n"}]}, "developer_name": "Nic Schubert", "developer_privacy_policy_url": "https://tonicgamesaustralia.com/SilentOperativeDemo-privacypolicy.html", "developer_terms_of_service_url": "https://tonicgamesaustralia.com/SilentOperativeDemo-termsandconditions.html", "publisher_name": "Tonic Games Australia", "support_website_url": null, "website_url": "https://tonicgamesaustralia.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "co
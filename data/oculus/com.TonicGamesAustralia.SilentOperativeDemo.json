dn.com/v/t64.5771-25/473394159_992169352883748_5285415940096378648_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WWguamJXluIQ7kNvwE_UpBW&_nc_oc=AdqApFe3xyq94Ef47_stn9jgEx0vDDQjZoceW33-FP2oNeAYGJYVGmwtxzF0QlbxH80&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZ8U3poPUrJyHladDnQ_h6xKUmYh8k_j-5vcwVC97m7w&oe=6ABBDDE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeMetaUpdated.png", "id": "1834648750641456", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473402206_1834648753974789_1007839813703125572_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cpg9Rxjg_e0Q7kNvwEWKTs0&_nc_oc=AdrWoeINyUWpv__KzvyAI4-ggm9Je0n4CCGZvrJ-jCSIPxssPjktRJwqmOossWBHOUs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJG668RcNzBAcGezVNJX90h-MrQ9oOzj9WiQM16LcPtzQ&oe=6ABBCC67"}, "display_name": "Silent Operative Demo", "keywords": ["demo", "silent", "operative", "free", "shooter"], "long_description": "Elite Secret Agent Experience: Immerse yourself in thrilling VR stealth-action gameplay.\n\nHigh-Stakes Missions: Navigate through intense missions using weapons, gadgets, and strategic skills.\n\nIntense Combat and Stealth: Engage in firefights, execute silent takedowns, and employ advanced espionage techniques.\n\nStrategic Planning and Execution: Plan your approach, assess enemy patrols, and exploit environmental opportunities.\n\nStunning Visuals and Immersive Gameplay: Experience stunning visuals and immersive gameplay.\n\nAre you ready to become the ultimate secret agent?", "short_description": "The Silent Operative Demo thrusts players into the shoes of a secret agent, where they must utilize a versatile arsenal of weapons and gadgets to navigate through dynamic and challenging missions.\n"}]}, "developer_name": "Nic Schubert", "developer_privacy_policy_url": "https://tonicgamesaustralia.com/SilentOperativeDemo-privacypolicy.html", "developer_terms_of_service_url": "https://tonicgamesaustralia.com/SilentOpera
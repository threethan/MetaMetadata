378648_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LpyREepv2sIQ7kNvwG5duVM&_nc_oc=AdkqDIcFX9HUB93tD71sV5Pq0Ziyhmj_KVa46rOq37wdJQMwV0ZZLCQ_2wHcJGU4Uos&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvvTOEEol0U06uoY_VvBpvYqpJhVXQUP1ntacQPE81kBw&oe=69A96DA0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeMetaUpdated.png", "id": "1834648750641456", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473402206_1834648753974789_1007839813703125572_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SYrR2XKUrhEQ7kNvwG1ghT-&_nc_oc=AdkuCjgXjAPmdy8Eiw-P-VkcB8jqAvM3LJ2Wvl4_oAW2Hq22kch04SCfPXc3qfVuPjM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AftFQZn6HdRHVwO9iW61PLNwZt-rWNTRUQKeLVc79CLMpw&oe=69A99467"}, "display_name": "Silent Operative Demo", "keywords": ["demo", "silent", "operative", "free", "shooter"], "long_description": "Elite Secret Agent Experience: Immerse yourself in thrilling VR stealth-action gameplay.\n\nHigh-Stakes Missions: Navigate through intense missions using weapons, gadgets, and strategic skills.\n\nIntense Combat and Stealth: Engage in firefights, execute silent takedowns, and employ advanced espionage techniques.\n\nStrategic Planning and Execution: Plan your approach, assess enemy patrols, and exploit environmental opportunities.\n\nStunning Visuals and Immersive Gameplay: Experience stunning visuals and immersive gameplay.\n\nAre you ready to become the ultimate secret agent?", "short_description": "The Silent Operative Demo thrusts players into the shoes of a secret agent, where they must utilize a versatile arsenal of weapons and gadgets to navigate through dynamic and challenging missions.\n"}]}, "developer_name": "Nic Schubert", "developer_privacy_policy_url": "https://tonicgamesaustralia.com/SilentOperativeDemo-privacypolicy.html", "developer_terms_of_service_url": "https://tonicgamesaustralia.com/SilentOperativeDemo-termsandconditions.html", "publisher_name": "Tonic Games Au
192_1769466694774172_8837029768878469303_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aj3fWyI5f1AQ7kNvwGNrIJL&_nc_oc=AdqbqAgCOKdKXvYAeSAq0XYEav2yUJyMh71jdjaD6sfg182VsaQq45EIRbIRRXBCJSM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-3GNosUlu3rvbp28y2nz4Rwi90er6qYaAceVbBjUWLw&oe=6AFC6781"}, {"file_name": "screenshot_1.png", "id": "1648053246945793", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499620414_1648053250279126_4048155141077306472_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-jSPC2L8wqIQ7kNvwHbH-5x&_nc_oc=AdrdW74OOC-qoCLOMPf58nJTKe_oAdB0Mk2eCQtcYd9go87m2dz_eYcMKS9g2X59IUY&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIMeB2jNyu5hnOhgaax5dh8iVXEMZMmUR2ATHgyUC3LA&oe=6AFC606F"}, {"file_name": "screenshot_3.png", "id": "1843782993305532", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499628456_1843782996638865_4905557601111236817_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zXAVSI7WI3kQ7kNvwEgmQ6t&_nc_oc=AdqDoUWEB1fnhbmvwwrZXsJNUAW7_dvHwEKfGniC0QAwEhFntiL1BQ-18I4JqaQjJig&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHpW55wXZ9N9rXve_2r8UwJyu89Wp4Y9XjfdBfkxXNlA&oe=6AFC7098"}, {"file_name": "screenshot_4.png", "id": "1926465011664842", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/593727470_1926465014998175_103146496200635232_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TIjBgH_Hnb4Q7kNvwEEbG3I&_nc_oc=Adpkkkj2xdTrTsn9I7_f8Z-d5M026o89VZZ7jLgVr6jgCpbnyB-tD1mthP4t5RtgiJQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtaT3SZaGvnQtaS4GCsbbDTkF5kV_WsTCjN14QpDSW2w&oe=6AFC7693"}, {"file_name": "screenshot_5.png", "id": "2062819447725996", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/793173952_2062819451059329_1611003275032680935_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JThxJOzC0skQ7kNvwE2BXuo&_nc_oc=AdpX6OX1mRtLzL7ZLv2BKXezPFfBLuzdlpogY07FiITfusIzQ9p1yW3Ycb4uFHkoLEY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrxXnoxVt_Q1eVv54VpIGCCJXdqRnBdOIhPt8Kgz6J6g&oe=6AFC7041"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1421333472795997", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499627527_1421333476129330_18915893068604533_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VsHuwHP71YsQ7kNvwGE5KOP&_nc_oc=AdpbOKtLBUqcfjC6NPzrlLW7FvoiXynlLmfHKzStx4KZsgQdW1bxQ5ptdvdLneF4goY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbHV1MJ8LXzoKPi23yi4J_Um6MTbqyer6rOjaM8MbXeA&oe=6AFC7A28"}, "display_name": "Tattoo Shop Simulator", "keywords": ["tattoo", "simulator", "ink", "art", "parlor"], "long_description": "Your chair. Your needles. Your reputation.\n\nREAL TATTOOING, LINE BY LINE\nGrab the stencil from the thermal printer and press it onto your customer's forearm - the purple transfer appears right where you put it. Dip the rotary pen in black and trace it. The machine buzzes to life the moment the needle touches skin. A light touch draws a fine line, a firm press lays a bold one, and pushing too deep makes your customer wince.\n\nPACK THE COLOUR\nSwitch to the coil machine, dip it in each ink the design calls for and fill it in. Wipe away the excess with a paper towel and see your work come through clean and bright.\n\nCUSTOMERS WITH THEIR OWN ORDERS\nNine different customers walk in with a design picked from your flash wall. They chat while you work, react when it hurts, and look down at the finished piece before they pay. Lining, colour packing, colour match, clean edges and a gentle hand all count - and great work earns big tips and a photo on your Wall of Fame.\n\nBUILD YOUR SHOP\nEach day brings new customers and new designs to master. Your money and reputation are saved between sessions.\n\nSANDBOX\nNo orders, no score, unlimited ink. Pick any customer and any design, print the stencil or stamp the finished tattoo straight on, laser it off and start again.\n\nA PARLOUR WITH ATMOSPHERE\nExposed brick, a red neon sign over a wall of classic flash, a leather waiting sofa, warm Edison bulbs and a cobbled street at night outside the window - with your own shop radio playing.", "short_description": "Run your own tattoo parlour in VR. Customers walk in off a neon-lit street, sit in your chair and lay their arm on the rest. Press the stencil on, line it with a buzzing rotary pen, pack the colour with a coil machine, wipe it clean and watch them react. Or ink anything you like in Sandbox."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/tattooshopsimulator/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/tattooshopsimulator/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1387157264480809"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2177586273163621"}]}, "baseline_offer": {"id": "2177586273163621"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792020360, "status": "PUBLISHED", "id": "2177586273163621"}]}, "liveChannel": {"nodes": [{"l